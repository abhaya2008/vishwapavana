[{"id": 7006384000, "chapter_id": 26384, "verse_number": "२-४१-१", "content_sanskrit": "वैशम्पायन उवाच\nजामदग्न्ये गते रामे तौ यादवकुलोद्वहौ ।\nगोमन्तशिखरे रम्ये चेरतुः कामरूपिणौ ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006384001, "chapter_id": 26384, "verse_number": "२-४१-२", "content_sanskrit": "वनमालाकुलोरस्कौ नीलपीताम्बरावुभौ ।\nनीलश्वेतवपुष्मन्तौ गगनस्थाविवाम्बुदौ ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006384002, "chapter_id": 26384, "verse_number": "२-४१-३", "content_sanskrit": "तौ शैलधातुदिग्धाङ्गौ युवानौ शिखरे स्थितौ ।\nचेरतुस्तत्र कान्तेषु वनेषु रतिलालसौ ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006384003, "chapter_id": 26384, "verse_number": "२-४१-४", "content_sanskrit": "उदयन्तं निरीक्षन्तौ शशिनं ज्योतिषां वरम् ।\nउदयास्तमने चैव ग्रहाणां धरणीधरे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006384004, "chapter_id": 26384, "verse_number": "२-४१-५", "content_sanskrit": "अथ संकर्षणः श्रीमान् विना कृष्णेन वीर्यवान् ।\nचचार तस्य शिखरे नगस्य नगसंनिभः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006384005, "chapter_id": 26384, "verse_number": "२-४१-६", "content_sanskrit": "प्रफुल्लस्य कदम्बस्य सुच्छाये निषसाद ह ।\nवायुना मन्दगन्धेन वीज्यमानः सुखेन वै ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006384006, "chapter_id": 26384, "verse_number": "२-४१-७", "content_sanskrit": "तस्य तेनानिलौघेन सेव्यमानस्य तत्र वै ।\nमद्यसंस्पर्जो गन्धः संस्पृशन् घ्राणमागतः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006384007, "chapter_id": 26384, "verse_number": "२-४१-८", "content_sanskrit": "तृष्णा चैनं विवेशाशु वारुणीप्रभवा तदा ।\nशुशोष च मुखं तस्य मत्तस्येवापरेऽहनि ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006384008, "chapter_id": 26384, "verse_number": "२-४१-९", "content_sanskrit": "स्मारितः स पुरावृत्तममृतप्राशनं विभुः ।\nतृषितो मदिरान्वेषी ततस्तं तरुमैक्षत ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006384009, "chapter_id": 26384, "verse_number": "२-४१-१०", "content_sanskrit": "तस्य प्रावृषि फुल्लस्य यदम्भो जलजोज्झितम् ।\nतत्कोटरस्थं मदिरा संजायत मनोहरा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006384010, "chapter_id": 26384, "verse_number": "२-४१-११", "content_sanskrit": "तां तु तृष्णाभिभूतात्मा पिबन्नार्त इवासकृत् ।\nमोहाच्च चलिताकारः समजायत स प्रभुः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006384011, "chapter_id": 26384, "verse_number": "२-४१-१२", "content_sanskrit": "तस्य मत्तस्य वदनं किंचिच्चलितलोचनम् ।\nघूर्णिताकारमभवच्छरत्कालेन्दुसप्रभम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006384012, "chapter_id": 26384, "verse_number": "२-४१-१३", "content_sanskrit": "कदम्बकोटरे जाता नाम्ना कादम्बरीति सा ।\nरूपिणी वारुणी तत्र देवानाममृतारणी ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006384013, "chapter_id": 26384, "verse_number": "२-४१-१४", "content_sanskrit": "कादम्बरीमदकलं विदित्वा कृष्णपूर्वजम् ।\nतिस्रस्त्रिदशनार्यस्तमुपतस्थुः प्रियंवदाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006384014, "chapter_id": 26384, "verse_number": "२-४१-१५", "content_sanskrit": "मदिरा रूपिणी भूत्वा कान्तिश्च शशिनः प्रिया ।\nश्रीश्च देवी वरिष्ठा स्त्री स्वयमेवाम्बुजध्वजा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006384015, "chapter_id": 26384, "verse_number": "२-४१-१६", "content_sanskrit": "साञ्जलिप्रग्रहा देवी रौहिणेयमुपस्थिता ।\nवारुण्या सहितं वाक्यमुवाच मदविक्लवम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006384016, "chapter_id": 26384, "verse_number": "२-४१-१७", "content_sanskrit": "बलं जयस्व दैत्यानां बलदेव दिवीश्वर ।\nअहं ते दयिता कान्ता वारुणी समुपस्थिता ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006384017, "chapter_id": 26384, "verse_number": "२-४१-१८", "content_sanskrit": "त्वामेवान्तर्हितं श्रुत्वा शाश्वतं वडवामुखे ।\nक्षीणपुण्येव वसुधां पर्येमि विमलानन ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006384018, "chapter_id": 26384, "verse_number": "२-४१-१९", "content_sanskrit": "पुष्पचक्रानुलिप्तेषु केसरेषूषितं मया ।\nअतिमुक्तेषु चाक्षोभ्य पुष्पस्तबकवत्सु च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006384019, "chapter_id": 26384, "verse_number": "२-४१-२०", "content_sanskrit": "अहं कदम्बमालीना मेघकाले मुखप्रिया ।\nतृषितं मार्गमाणा त्वां स्वेन रूपेण छादिता ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006384020, "chapter_id": 26384, "verse_number": "२-४१-२१", "content_sanskrit": "सास्मि पूर्णेन योगेन यथैवामृतमन्थने ।\nसमीपं प्रेषिता पित्रा वरुणेन तवानघ ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006384021, "chapter_id": 26384, "verse_number": "२-४१-२२", "content_sanskrit": "सा यथैवार्णवगता तथैव वडवामुखे ।\nत्वयोपभोक्तुमिच्छामि सम्मतस्त्वं हि मे गुरुः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006384022, "chapter_id": 26384, "verse_number": "२-४१-२३", "content_sanskrit": "न त्वानन्तं परित्यक्ष्ये भर्त्सितापि त्वयानघ ।\nनाहं त्वया विना लोकानुत्सहे देव सेवितुम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006384023, "chapter_id": 26384, "verse_number": "२-४१-२४", "content_sanskrit": "आदिपद्मं च पद्माङ्कं दिव्यं श्रवणभूषणम् ।\nकौशेयानि च नीलानि समुद्रार्हाणि बिभ्रती ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006384024, "chapter_id": 26384, "verse_number": "२-४१-२५", "content_sanskrit": "मदिरानन्तरं कान्तिः संकर्षणमुपस्थिता ।\nमदेनागलितश्रोणी किंचिदाघूणितेक्षणा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006384025, "chapter_id": 26384, "verse_number": "२-४१-२६", "content_sanskrit": "प्रोवाच प्रणयात् कान्तिर्बद्धाञ्जलिपुटा सती ।\nजयपूर्वेण योगेन सस्मितं वाक्यमर्थवत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006384026, "chapter_id": 26384, "verse_number": "२-४१-२७", "content_sanskrit": "अहं चन्द्रादपि गुरुं सहस्रशिरसं प्रभुम् ।\nस्वैर्गुणैरनुरक्ता त्वां यथैव मदिरा तथा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006384027, "chapter_id": 26384, "verse_number": "२-४१-२८", "content_sanskrit": "श्रीश्च पद्मालया देवी निधेया वैष्णवोरसि ।\nरौहिणेयोरसि शुभा मालेवामलतां गता ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006384028, "chapter_id": 26384, "verse_number": "२-४१-२९", "content_sanskrit": "सा मालाममलां गृह्य बलस्योरसि दंशिता ।\nपद्मास्या पद्महस्ता वै संकर्षणमथाब्रवीत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006384029, "chapter_id": 26384, "verse_number": "२-४१-३०", "content_sanskrit": "राम रामाभिरामस्त्वं वारुण्या समलंकृतः ।\nकान्त्या मया च देवेश संगतश्चन्द्रमा यथा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006384030, "chapter_id": 26384, "verse_number": "२-४१-३१", "content_sanskrit": "इयं च सा मया मौलिः प्रोद्धता वरुणालयात् ।\nमूर्ध्नि शीर्षसहस्रस्य या ते भानुरिवाबभौ ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006384031, "chapter_id": 26384, "verse_number": "२-४१-३२", "content_sanskrit": "जातरूपमयं चैकं कुण्डलं वज्रभूषितम् ।\nआदिपद्मं च पद्माक्षं दिव्यश्रवणभूषणम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006384032, "chapter_id": 26384, "verse_number": "२-४१-३३", "content_sanskrit": "कौशेयानि च नीलानि समुद्रार्हाणि भावतः ।\nहारं च पीनतरलं समुद्राभ्यन्तरोऽषितम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006384033, "chapter_id": 26384, "verse_number": "२-४१-३४", "content_sanskrit": "देवेमां प्रतिगृह्णीष्व पौराणी भूषणक्रियाम् ।\nसमयस्ते महाबाहो भूषणानामलंक्रिया ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006384034, "chapter_id": 26384, "verse_number": "२-४१-३५", "content_sanskrit": "संगृह्य तमलंकारं ताश्च तिस्रः सुरस्त्रियः ।\nशुशुभे बलदेवो हि शारदेन्दुसमप्रभः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006384035, "chapter_id": 26384, "verse_number": "२-४१-३६", "content_sanskrit": "स समागम्य कृष्णेन जलजाम्भोदवर्चसा ।\nमुदं परमिकां लेभे ग्रहयुक्तः शशी यथा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006384036, "chapter_id": 26384, "verse_number": "२-४१-३७", "content_sanskrit": "ताभ्यामुभाभ्यां संलापे वर्तमाने गृहे यथा ।\nवैनतेयस्ततोऽध्वानमतिचक्राम वेगतः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006384037, "chapter_id": 26384, "verse_number": "२-४१-३८", "content_sanskrit": "संग्राममुक्तस्तेजस्वी दैत्यप्रहरणाङ्कितः ।\nदेवतानां जयश्लाघी दिव्यस्रगनुलेपनः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006384038, "chapter_id": 26384, "verse_number": "२-४१-३९", "content_sanskrit": "सुप्तस्य शयने दिव्ये क्षीरोदे वरुणालये ।\nविष्णोः किरीटं दैत्येन हृतं वैरोचनेन वै ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006384039, "chapter_id": 26384, "verse_number": "२-४१-४०", "content_sanskrit": "तदर्थस्तेन संग्रामः कृतो गुर्वर्थमोजसा ।\nकिरीटार्थे समुद्रस्य मध्ये दैत्यगणैः सह ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006384040, "chapter_id": 26384, "verse_number": "२-४१-४१", "content_sanskrit": "मोक्षयित्वा किरीटं तु वैष्णवं पततां वरः ।\nव्यत्यक्रमत वेगेन गगनं देवतालयम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006384041, "chapter_id": 26384, "verse_number": "२-४१-४२", "content_sanskrit": "स ददर्श गुरुं शैले विष्णुं कार्यान्तरागतम् ।\nतेन क्रीडावलम्बेन किरीटेन विराजता ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006384042, "chapter_id": 26384, "verse_number": "२-४१-४३", "content_sanskrit": "स दृष्ट्वा मानुषं विष्णुं शैलराजशिरोगतम् ।\nप्रकाशचेष्टानिर्मुक्तं विमौलिमिव मानुषम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006384043, "chapter_id": 26384, "verse_number": "२-४१-४४", "content_sanskrit": "अभिज्ञस्तस्य भावानां गरुत्मान् पततां वरः ।\nचिक्षेप खं गतो मौलिं विष्णोः शिरसि हृष्टवत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006384044, "chapter_id": 26384, "verse_number": "२-४१-४५", "content_sanskrit": "उपेन्द्रमूर्ध्नि सा मौलिरपिनद्धा इवापतत् ।\nशिरसः स्थाननिर्युक्ता कृष्णं चैवान्वशोभयत् ।\nयथैव मेरुशिखरे भानुर्मध्यंदिने यथा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006384045, "chapter_id": 26384, "verse_number": "२-४१-४६", "content_sanskrit": "वैनतेयप्रयोगेण विदित्वा मौलिमागताम् ।\nकृष्णः प्रहृष्टवदनो रामं वचनमब्रवीत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006384046, "chapter_id": 26384, "verse_number": "२-४१-४७", "content_sanskrit": "त्वरते खलु कार्यार्थो देवतानां न संशयः ।\nयथेयमावयोः शैले संग्रामरचना कृता ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006384047, "chapter_id": 26384, "verse_number": "२-४१-४८", "content_sanskrit": "वैरोचनेन 'सुप्तस्य' मम मौलिर्महोदधौ ।\nशक्रस्य सदृशं रूपं दिव्यमास्थाय सागरात् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006384048, "chapter_id": 26384, "verse_number": "२-४१-४९", "content_sanskrit": "ग्राहरूपेण यो नीत आनीतोऽसौ गरुत्मता ।\nममाहिशयनान्मौलिर्हृत्वा क्षिप्तो गरुत्मता ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006384049, "chapter_id": 26384, "verse_number": "२-४१-५०", "content_sanskrit": "सुव्यक्तं संनिकृष्टः स जरासंधो नराधिपः ।\nलक्ष्यन्ते हि ध्वजाग्राणि रथानां वातरंहसाम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006384050, "chapter_id": 26384, "verse_number": "२-४१-५१", "content_sanskrit": "एतानि विजिगीषूणां शशिकल्पानि भूभृताम् ।\nछत्राण्यार्य विराजन्ते दंशितानि मितानि च ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006384051, "chapter_id": 26384, "verse_number": "२-४१-५२", "content_sanskrit": "अहो नृपरथोदग्रा विमलाश्छत्रपङ्क्तयः ।\nअभिवर्तन्ति नः शुभ्रा यथा खे हंसपङ्क्तयः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006384052, "chapter_id": 26384, "verse_number": "२-४१-५३", "content_sanskrit": "अहो द्यौर्विमलाभानां शस्त्राणां विमलानना ।\nप्रभा भास्करभामिश्रा चरन्तीव दिशो दृश ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006384053, "chapter_id": 26384, "verse_number": "२-४१-५४", "content_sanskrit": "एतानि नूनं समरे पार्थिवैरायुधानि च ।\nक्षिप्तानि विनशिष्यन्ति मयि सर्वाणि संयुगे ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006384054, "chapter_id": 26384, "verse_number": "२-४१-५५", "content_sanskrit": "काले खलु नृपः प्राप्तो जरासंधो महीपतिः ।\nआवयोर्युद्धनिकषः प्रथमः समरातिथिः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006384055, "chapter_id": 26384, "verse_number": "२-४१-५६", "content_sanskrit": "आर्य तिष्ठाव सहितौ न खल्वानागते नृपे ।\nयुद्धारम्भः प्रयोक्तव्यो बलं तावद् विमृश्यताम्॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006384056, "chapter_id": 26384, "verse_number": "२-४१-५७", "content_sanskrit": "एवमुक्त्वा ततः कृष्णः स्वस्थः संग्रामलालसः ।\nजरासंधवधं प्रेप्सुश्चकार बलदर्शनम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006384057, "chapter_id": 26384, "verse_number": "२-४१-५८", "content_sanskrit": "वीक्षमाणश्च तान्सर्वान् नृपान् यदुवरोऽव्ययः ।\nआत्मानमात्मनोवाच यत्पूर्वं दिवि मन्त्रितम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006384058, "chapter_id": 26384, "verse_number": "२-४१-५९", "content_sanskrit": "इमे ते पृथिवीपालाः पार्थिवे वर्त्मनि स्थिताः ।\nये विनाशं गमिष्यन्ति शास्त्रदृष्टेन कर्मणा ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006384059, "chapter_id": 26384, "verse_number": "२-४१-६०", "content_sanskrit": "प्रोक्षितान्खल्विमान् मन्ये मृत्युना नृपसत्तमान् ।\nस्वर्गगामीनि चाप्येषां वपुंषि प्रचकाशिरे ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006384060, "chapter_id": 26384, "verse_number": "२-४१-६१", "content_sanskrit": "स्थाने भारपरिश्रान्ता वसुधेयं दिवं गता ।\nएषां नृपतिसिंहानां बलौघैरभिपीडिता ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006384061, "chapter_id": 26384, "verse_number": "२-४१-६२", "content_sanskrit": "अल्पेन खलु कालेन विविक्तं पृथिवीतलम् ।\nभविष्यति नरेन्द्रौघैराकीर्णं च नभस्तलम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]