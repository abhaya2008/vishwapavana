[{"id": 2095957, "chapter_id": 3048, "verse_number": "१३-१७८-१", "content_sanskrit": "युधिष्ठिर उवाच।\nइमे वै मानवा लोके भृशं मांसेषु गृद्धिनः।\nविसृज्य विविधान्भक्ष्यान्महारक्षोगणा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2095958, "chapter_id": 3048, "verse_number": "१३-१७८-२", "content_sanskrit": "अपूपान्विविधाकाराञ्शाकानि विविधानि च।\nपादपान्रससंयुक्तान्न चेच्छन्ति यथाऽऽमिषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2095959, "chapter_id": 3048, "verse_number": "१३-१७८-३", "content_sanskrit": "तत्र मे बुद्धिरत्रेव विषये परिमुह्यते।\nन मन्ये रसतः किञ्चिन्मांसतोऽस्तीति किञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2095960, "chapter_id": 3048, "verse_number": "१३-१७८-४", "content_sanskrit": "तदिच्छामि गुणाञ्श्रोतुं मांसस्याभक्षणे प्रभो।\nभक्षणे चैव ये दोषास्तांश्चैव पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2095961, "chapter_id": 3048, "verse_number": "१३-१७८-५", "content_sanskrit": "सर्वसत्त्वेन धर्मज्ञ यथावदिह धर्मतः।\nकिं वा भक्ष्यमभक्ष्यं वा सर्वमेतद्वदस्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2095962, "chapter_id": 3048, "verse_number": "१३-१७८-६", "content_sanskrit": "यथैतद्यादृशं चैव गुणा ये चास्य वर्जने।\nदोषा भक्षयतो येऽपि तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2095963, "chapter_id": 3048, "verse_number": "१३-१७८-७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2095964, "chapter_id": 3048, "verse_number": "१३-१७८-७", "content_sanskrit": "सर्वमेतन्महाबाहो यथा वदसि भारत।\nन मांसात्परमं किञ्चिद्रसतो विद्यते भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2095965, "chapter_id": 3048, "verse_number": "१३-१७८-८", "content_sanskrit": "क्षतक्षीणाभितप्तानां ग्राम्यधर्मरतात्मनाम्।\nअध्वना कर्शितानां च न मांसाद्विद्यते परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2095966, "chapter_id": 3048, "verse_number": "१३-१७८-९", "content_sanskrit": "सद्यो वर्धयति प्राणान्पुष्टिमग्र्यां दधाति च।\n`नाशो भक्षणदोषः स्याद्दानमेव सदा मतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2095967, "chapter_id": 3048, "verse_number": "१३-१७८-१०", "content_sanskrit": "क्षुधितानां द्विजानां च सर्वेषां चापि जीवितम्।\nदत्त्वा भवति पूतात्मा श्रद्धया लोभवर्जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2095968, "chapter_id": 3048, "verse_number": "१३-१७८-११", "content_sanskrit": "शिक्षयन्ति न याचन्ते दर्शयन्ति स्वमूर्तिभिः।\nअवस्थेयमदानस्य मा भूदेवं भवानिति।\nदानाद्यः सुशुचिर्मांसं पुनर्नैव च भक्षयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2095969, "chapter_id": 3048, "verse_number": "१३-१७८-१२", "content_sanskrit": "न भक्ष्योऽभ्याधिकः कश्चिन्मांसादस्ति परंतप।\nविवर्जने तु बहवो गुणाः कौरवनन्दन।\nये भवन्ति मनुष्याणां तान्मे निगदतः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2095970, "chapter_id": 3048, "verse_number": "१३-१७८-१३", "content_sanskrit": "स्वमांसं परमांसेन यो वर्धयितुमिच्छति।\nनास्ति क्षुद्रतरस्तस्मात्स नृशंसतरो नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2095971, "chapter_id": 3048, "verse_number": "१३-१७८-१४", "content_sanskrit": "न हि प्राणात्प्रियतरं लोके किञ्चन विद्यते।\nतस्माद्दयां नरः कुर्याद्यथाऽऽत्मनि तथा परे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2095972, "chapter_id": 3048, "verse_number": "१३-१७८-१५", "content_sanskrit": "शुक्राच्च तात सम्भूतिर्मांसस्येह न संशयः।\nभक्षणे तु महान्दोषो मलेन स हि कल्प्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2095973, "chapter_id": 3048, "verse_number": "१३-१७८-१६", "content_sanskrit": "`अहिंसालक्षणो धर्म इति वेदविदो विदुः।\nयदहिंस्रं भवेत्कर्म तत्कुर्यादात्मविन्नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2095974, "chapter_id": 3048, "verse_number": "१३-१७८-१७", "content_sanskrit": "पितृदैवतयज्ञेषु प्रोक्षितं हविरुच्यते।\nविधिना वेददृष्टेन तद्भुक्त्वेह न दुष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2095975, "chapter_id": 3048, "verse_number": "१३-१७८-१८", "content_sanskrit": "यज्ञार्थे पशवः सृष्टा इत्यपि श्रूयते श्रुतिः।\nअतोऽन्यथा प्रवृत्तानां राक्षसो विधिरुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2095976, "chapter_id": 3048, "verse_number": "१३-१७८-१९", "content_sanskrit": "क्षत्रियाणां तु यो दृष्टो विधिस्तमपि मे शृणु।\nवीर्येणोपार्जितं मांसं यथा भुञ्जन्न दुष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2095977, "chapter_id": 3048, "verse_number": "१३-१७८-२०", "content_sanskrit": "आरण्याः सर्वदैवत्याः सर्वशः प्रोक्षिता मृगाः।\nअगस्त्येन पुरा राजन्मृगया येन पूज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2095978, "chapter_id": 3048, "verse_number": "१३-१७८-२१", "content_sanskrit": "`रक्षणार्थाय भूतानां हिंस्रान्हन्यान्मृगान्पुनः।\nनात्मानमपरित्यज्य मृगया नाम विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2095979, "chapter_id": 3048, "verse_number": "१३-१७८-२२", "content_sanskrit": "समतामुपसङ्गम्य रूपं हन्यान्न वा नृप।\nअतो राजर्षयः सर्वे मृगयां यान्ति भारत।\nन हि लिप्यन्ति पापेन न चैतत्पातकं भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2095980, "chapter_id": 3048, "verse_number": "१३-१७८-२३", "content_sanskrit": "न ह्यतः सदृशं किञ्चिदिह लोके परत्र च।\nयत्सर्वेष्विह भूतेषु दया कौरवन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2095981, "chapter_id": 3048, "verse_number": "१३-१७८-२४", "content_sanskrit": "न भयं विद्यते जातु नरस्येह दयावतः।\nदयावतामिमे लोकाः परे चापि तपस्विनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2095982, "chapter_id": 3048, "verse_number": "१३-१७८-२५", "content_sanskrit": "अभयं सर्वभूतेभ्यो यो ददाति दयापरः।\nअभयं तस्य भूतानि ददतीत्यनुशुश्रुम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2095983, "chapter_id": 3048, "verse_number": "१३-१७८-२६", "content_sanskrit": "क्षतं च स्खलितं चैव पतितं क्लिन्नमाहतम्।\nसर्वभूतानि रक्षन्ति समेषु विषमेषु च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2095984, "chapter_id": 3048, "verse_number": "१३-१७८-२७", "content_sanskrit": "नैनं व्यालमृगा घ्नन्ति न पिशाचा न राक्षसाः।\nमुच्यते भयकालेषु मोक्षयेद्यो भये परान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2095985, "chapter_id": 3048, "verse_number": "१३-१७८-२८", "content_sanskrit": "प्राणदानात्परं दानं न भूतं न भविष्यति।\nन ह्यात्मनः प्रियतरं किञ्चिदस्तीह निश्चितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2095986, "chapter_id": 3048, "verse_number": "१३-१७८-२९", "content_sanskrit": "अनिष्टं सर्वभूतानां मरणं नाम भारत।\nमृत्युकाले हि भूतानां सद्यो जायति वेपथुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2095987, "chapter_id": 3048, "verse_number": "१३-१७८-३०", "content_sanskrit": "व्याधिजन्मजरादुःखैर्नित्यं संसारसागरे।\nजन्तवः परिवर्तन्ते मरणादुद्विजन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2095988, "chapter_id": 3048, "verse_number": "१३-१७८-३१", "content_sanskrit": "गर्भवासेषु पच्यन्ते क्षाराम्लकटुकै रसैः।\nमूत्रस्वेदपुरीषाणां परुषैर्भृशदारुणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2095989, "chapter_id": 3048, "verse_number": "१३-१७८-३२", "content_sanskrit": "जाताश्चाप्यवशास्तत्र च्छिद्यमानाः पुनःपुनः।\nहन्यमानाश्च दृश्यन्ते विवशा मांसगृद्धिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2095990, "chapter_id": 3048, "verse_number": "१३-१७८-३३", "content_sanskrit": "कुम्भीपाके च पच्यन्ते तां तां योनिमुपागताः।\nआक्रम्य मार्यमाणाश्च त्रास्यन्त्यन्ये पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2095991, "chapter_id": 3048, "verse_number": "१३-१७८-३४", "content_sanskrit": "नात्मनोऽस्ति प्रियतरः पृथिवीमनुसृत्य ह।\nतस्मात्प्राणिषु सर्वेषु दयावानात्मवान्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2095992, "chapter_id": 3048, "verse_number": "१३-१७८-३५", "content_sanskrit": "सर्वमांसानि यो राजन्यावज्जीवं न भक्षयेत्।\nआश्वासं विपुलं स्थानं प्राप्नुयान्नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2095993, "chapter_id": 3048, "verse_number": "१३-१७८-३६", "content_sanskrit": "ये भक्षयन्ति मांसानि भूतानां जीवितैषिणाम्।\nभक्ष्यन्ते तेऽपि भूतैस्तैरिति मे नास्ति संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2095994, "chapter_id": 3048, "verse_number": "१३-१७८-३७", "content_sanskrit": "मां स भक्षयते यस्माद्भक्षयिष्ये तमप्यहम्।\nएतन्मांसस्य मांसत्वमनुबुद्ध्यस्व भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2095995, "chapter_id": 3048, "verse_number": "१३-१७८-३८", "content_sanskrit": "घातको वध्यते नित्यं तथा बध्येत बन्धकः।\nआक्रोष्टा क्रुध्यते राजन्द्वेष्टा द्वेष्यत्वमाप्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2095996, "chapter_id": 3048, "verse_number": "१३-१७८-३९", "content_sanskrit": "येनयेन शरीरेण यद्यत्कर्म करोति यः।\nतेनतेन शरीरेण तत्तत्फलमुपाश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2095997, "chapter_id": 3048, "verse_number": "१३-१७८-४०", "content_sanskrit": "अहिंसा परमो धर्मस्तथाऽहिंसा परो दमः।\nअहिंसा परमं दानमहिंसा परमं तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2095998, "chapter_id": 3048, "verse_number": "१३-१७८-४१", "content_sanskrit": "अहिंसा परमं मिमहिंसा परमं सुखम्॥\nसर्वयज्ञेषु वा दानं सर्वतीर्थेषु वा प्लुतम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2095999, "chapter_id": 3048, "verse_number": "१३-१७८-४२", "content_sanskrit": "सर्वदानफलं वाऽपि नैतत्तुल्यमहिंसया॥\nअहिंसस्य तपोऽक्षय्यमहिंस्रो जयते सदा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2096000, "chapter_id": 3048, "verse_number": "१३-१७८-४३", "content_sanskrit": "अहिंस्रः सर्वभूतानां यथा माता यथा पिता॥\nएतत्फलमहिंसायां भूयश्च कुरुपुङ्गव।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2096001, "chapter_id": 3048, "verse_number": "१३-१७८-४४", "content_sanskrit": "न हि शक्या गुणा वक्तुमपि वर्षशतैरपि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2096002, "chapter_id": 3048, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि अष्टसप्तत्यधिकशततमोऽध्यायः॥ १७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]