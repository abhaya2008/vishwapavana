[{"id": 7004800000, "chapter_id": 24800, "verse_number": "६-२६२-१", "content_sanskrit": "पार्वत्युवाच ।\nध्यानयोगमहं प्राप्य ज्ञानयोगमवाप्नुयाम् ।\nतथा कुरुष्व देवेश यथाहममरी भव ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004800001, "chapter_id": 24800, "verse_number": "६-२६२-२", "content_sanskrit": "ईश्वर उवाच ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004800002, "chapter_id": 24800, "verse_number": "६-२६२-३", "content_sanskrit": "प्रत्युक्तोऽयं मंत्रराजो द्वादशाक्षरसंज्ञितः ।\nजप्तव्यः सुकुमारांगि वेदसारः सनातनः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004800003, "chapter_id": 24800, "verse_number": "६-२६२-४", "content_sanskrit": "प्रणवः सर्ववेदाद्यः सर्वब्रह्मांडयाजकः ।\nप्रथमः सर्वकार्येषु सर्वसिद्धिप्रदायकः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004800004, "chapter_id": 24800, "verse_number": "६-२६२-५", "content_sanskrit": "सितवर्णो मधुच्छंदा ऋषिर्ब्रह्मा तु देवता ।\nपरमात्मा तु गायत्री नियोगः सर्वकर्मसु ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004800005, "chapter_id": 24800, "verse_number": "६-२६२-६", "content_sanskrit": "एतद्ब्रह्ममयं बीजं विश्वमत्र समन्वितम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004800006, "chapter_id": 24800, "verse_number": "६-२६२-७", "content_sanskrit": "वेदवेदांग तत्त्वाख्यं सदसदूपमव्ययम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004800007, "chapter_id": 24800, "verse_number": "६-२६२-८", "content_sanskrit": "नकारः पीतवर्णस्तु जलबीजः सनातनः ।\nबीजं पृथ्वी मनश्छन्दो विषहा विनियोगतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004800008, "chapter_id": 24800, "verse_number": "६-२६२-९", "content_sanskrit": "मोकारः पृथिवी बीजो विश्वामित्रसमन्वितः ।\nरक्तवर्णो महातेजा धनदो विनियोजितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004800009, "chapter_id": 24800, "verse_number": "६-२६२-१०", "content_sanskrit": "भकारः पंचवर्णस्तु जलबीजः सनातनः ।\nमरीचिना समायुक्तः पूजितः सर्वभोगदः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004800010, "chapter_id": 24800, "verse_number": "६-२६२-११", "content_sanskrit": "गकारो हेमरक्ताभो भरद्वाजसमन्वितः ।\nवायुबीजो विनिर्योगं कुर्वतामादिभोगदः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004800011, "chapter_id": 24800, "verse_number": "६-२६२-१२", "content_sanskrit": "वकारः कुन्दधवलो व्योमबीजो महाबलः ।\nऋषिमंत्रिपुरस्कृत्य योजितो मोक्षदायकः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004800012, "chapter_id": 24800, "verse_number": "६-२६२-१३", "content_sanskrit": "तकारो विद्युद्विकारः सोमबीजं महत्स्मृतम् ।\nअंगिरावर्द्धमूलं च वर्जितं कर्मका मिकम् १ ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004800013, "chapter_id": 24800, "verse_number": "६-२६२-१४", "content_sanskrit": "वाकारो धूम्रवर्णश्च सूर्यबीजं मनोजवम् ।\nपुलस्त्यर्षिसमायुक्तं नियुक्तं सर्वसौख्यदम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004800014, "chapter_id": 24800, "verse_number": "६-२६२-१५", "content_sanskrit": "सुकारश्चाक्षरो नित्यं जपाकुसुम भास्वरः ।\nमनो बीजं दुर्विषह्यं पुलहाश्रितमर्थिदम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004800015, "chapter_id": 24800, "verse_number": "६-२६२-१६", "content_sanskrit": "देकाराक्षरकं बीजं हंसरूपं च कर्बुरम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004800016, "chapter_id": 24800, "verse_number": "६-२६२-१७", "content_sanskrit": "सिद्धिबीजं महासत्त्वं क्रतौ क्रतुनियोजितम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004800017, "chapter_id": 24800, "verse_number": "६-२६२-१८", "content_sanskrit": "वाकारो निर्मलो नित्यं यजमानस्तु बीजभृत् ।\nप्रचेताश्रियमाश्रेयं मोक्षे मोक्षप्रदायकम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004800018, "chapter_id": 24800, "verse_number": "६-२६२-१९", "content_sanskrit": "यकारस्य महाबीजं पिंगवर्णश्च खेचरी ।\nभूचरी च महासिद्धिः सर्वदा भूविचिन्तनम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004800019, "chapter_id": 24800, "verse_number": "६-२६२-२०", "content_sanskrit": "भृगुयन्त्रे समाश्रांतिनियोगे सर्वकर्मकृत् ।\nगायत्रीछंद एतेषां देहन्यासक्रमो भवेत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004800020, "chapter_id": 24800, "verse_number": "६-२६२-२१", "content_sanskrit": "ओंकारं सर्वदा न्यस्यन्नकारं पादयोर्द्वयोः ।\nमोकारं गुह्यदेशे तु भकारं नाभिपंकजे ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004800021, "chapter_id": 24800, "verse_number": "६-२६२-२२", "content_sanskrit": "गकारं हृदये न्यस्य वकारः कण्ठ मध्यगः ।\nतेकारं दक्षिणे हस्ते वाकारो वामहस्तगः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004800022, "chapter_id": 24800, "verse_number": "६-२६२-२३", "content_sanskrit": "सुकारं मुखजिह्वायां देकारः कर्णयोर्द्वयोः ।\nवाकारश्चक्षुषोर्द्वन्द्वे यकारं मस्तके न्यसेत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004800023, "chapter_id": 24800, "verse_number": "६-२६२-२४", "content_sanskrit": "लिंगमुद्रा योनिमुद्रा धेनुमुद्रा तथा त्रयम् ।\nसकलं कृतमेतद्धि मंत्ररूपे बिजाक्षरम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004800024, "chapter_id": 24800, "verse_number": "६-२६२-२५", "content_sanskrit": "योजयेत्प्रत्यहं देवि न स पापैः प्रलिप्यते ।\nएतद्द्वादशलिंगारं कूर्मस्थं द्वादशाक्षरम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004800025, "chapter_id": 24800, "verse_number": "६-२६२-२६", "content_sanskrit": "शालग्रामशिलाश्चैव द्वादशैव हि पूजिताः ।\nताभिः सहाकरैरेभिः प्रत्यक्षैः सह संसदि ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004800026, "chapter_id": 24800, "verse_number": "६-२६२-२७", "content_sanskrit": "यथावर्णमनुध्यानैर्मुनिबीजसमन्वितैः ।\nविनियोगेन सहितैश्छन्दोभिः समलंकृतैः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004800027, "chapter_id": 24800, "verse_number": "६-२६२-२८", "content_sanskrit": "ध्यानैजपैः पूजितैश्च भक्तानां मुनिसत्तम ।\nमोक्षो भवति बन्धेभ्यः कर्मजेभ्यो न संशयः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004800028, "chapter_id": 24800, "verse_number": "६-२६२-२९", "content_sanskrit": "अयं हि ध्यानकर्माख्यो योगो दुष्प्राप्य एव हि ।\nध्यानयोगं पुनर्वच्मि शृणुष्वैकाग्रमानसा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004800029, "chapter_id": 24800, "verse_number": "६-२६२-३०", "content_sanskrit": "ध्यानयोगेन पापानां क्षयो भवति नान्यथा ।\nजपध्यानमयो योगः कर्मयोगो न संशयः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004800030, "chapter_id": 24800, "verse_number": "६-२६२-३१", "content_sanskrit": "शब्दब्रह्मसमुद्भूतो वेदेन द्वादशाक्षरः ।\nध्यानेन सर्वमाप्नोति ध्यानेनाप्नोति शुद्धताम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004800031, "chapter_id": 24800, "verse_number": "६-२६२-३२", "content_sanskrit": "ध्यानेन परमं ब्रह्म मूर्त्तौ योगस्तु ध्यानजः ।\nसावलम्बो ध्यानयोगो यन्नारायणदर्शनम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004800032, "chapter_id": 24800, "verse_number": "६-२६२-३३", "content_sanskrit": "द्वितीयो निखिलालम्बो ज्ञानयोगेन कीर्तितः ।\nअरूपमप्रमेयं यत्सर्वकायं महः सदा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004800033, "chapter_id": 24800, "verse_number": "६-२६२-३४", "content_sanskrit": "तडित्कोटिसमप्रख्यं सदोदितमखंडितम् ।\nनिष्कलं सकलं वापि निरंजनमयं वियत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004800034, "chapter_id": 24800, "verse_number": "६-२६२-३५", "content_sanskrit": "तत्स्वरूपं भोगरूपं तुर्यातीतमनोपमम् ।\nविभ्रांतकरणं मूर्तं प्रकृतिस्थं च शाश्वतम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004800035, "chapter_id": 24800, "verse_number": "६-२६२-३६", "content_sanskrit": "दृश्यादृश्यमजं चैव वैराजं सततोज्ज्वलम् ।\nबहुलं सर्वजं धर्म्यं निर्विकल्पमनीश्वरम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004800036, "chapter_id": 24800, "verse_number": "६-२६२-३७", "content_sanskrit": "अगोत्रं वरणं वापि ब्रह्मांडशतकारणम् ।\nनिरीहं निर्ममं बुद्धिशून्यरूपं च निर्मलम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004800037, "chapter_id": 24800, "verse_number": "६-२६२-३८", "content_sanskrit": "तदीशरूपं निर्देहं निर्द्वंद्वं साक्षिमात्रकम् ।\nशुद्धस्फटिकसंकाशं ध्यातृध्येयविवर्जितम् ।\nनोपमेयमगाधं त्वं स्वीकुरुष्व स्वतेजसा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004800038, "chapter_id": 24800, "verse_number": "६-२६२-३९", "content_sanskrit": "पार्वत्युवाच ।\nतत्कथं प्राप्यते सम्यग्ज्ञानं योगिस्वरूपिणम् ।\nनारायणममूर्तं च स्थानं तस्य वद प्रभो ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004800039, "chapter_id": 24800, "verse_number": "६-२६२-४०", "content_sanskrit": "ईश्वर उवाच ।\nशिरः प्रधानं गात्रेषु शिरसा धार्यते महान् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004800040, "chapter_id": 24800, "verse_number": "६-२६२-४१", "content_sanskrit": "शिरसा पूजितो देवः पूजितं सकलं जगत् ।\nशिरसा धार्यते योगः शिरसा ध्रियते बलम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004800041, "chapter_id": 24800, "verse_number": "६-२६२-४२", "content_sanskrit": "शिरसा ध्रियते तेजो जीवितं शिरसि स्थितम् ।\nसूर्यः शिरो ह्यमूर्त्तस्य मूर्तस्यापि तथैव च ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004800042, "chapter_id": 24800, "verse_number": "६-२६२-४३", "content_sanskrit": "उरस्तु पृथिवीलोकः पादश्चैव रसातलम् ।\nअयं ब्रह्मांडरूपे च मूर्त्तामूर्त्तस्वरूपतः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004800043, "chapter_id": 24800, "verse_number": "६-२६२-४४", "content_sanskrit": "विष्णुरेव ब्रह्मरूपो ज्ञानयोगाश्रयः स्वयम् ।\nसृजते सर्वभूतानि पालयत्यपि सर्वशः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004800044, "chapter_id": 24800, "verse_number": "६-२६२-४५", "content_sanskrit": "विनाशयति सर्वं हि सर्वदेवमयो ह्ययम् ।\nसर्वमासेष्वाधिपत्यं यस्य विष्णोः सनातनम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004800045, "chapter_id": 24800, "verse_number": "६-२६२-४६", "content_sanskrit": "तस्मात्सर्वेषु मासेषु सर्वेषु दिवसेष्वपि ।\nसर्वेषु यामकालेषु संस्मरन्मुच्यते हरिम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004800046, "chapter_id": 24800, "verse_number": "६-२६२-४७", "content_sanskrit": "चातुर्मास्ये विशेषेण ध्यानमात्रात्प्रमुच्यते ।\nअमूर्त्तसेवनं गंगातीर्थध्यानाद्वरं परम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004800047, "chapter_id": 24800, "verse_number": "६-२६२-४८", "content_sanskrit": "सर्वदानोत्तरं चैव चातुर्मास्ये न संशयः ।\nसर्वमासकृतं पापं चातुर्मास्ये शुभाशुभम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004800048, "chapter_id": 24800, "verse_number": "६-२६२-४९", "content_sanskrit": "अक्षय्यं तद्भवेद्देवि नात्र कार्या विचारणा ।\nतस्मात्सर्वप्रयत्नेन ज्ञानयोगो बहूत्तमः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004800049, "chapter_id": 24800, "verse_number": "६-२६२-५०", "content_sanskrit": "सेवितो विष्णुरूपेण ब्रह्ममोक्षप्रदायकः ।\nशृणुष्वावहिता भूत्वा मूर्त्तामूर्ते स्थितिं शुभे ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004800050, "chapter_id": 24800, "verse_number": "६-२६२-५१", "content_sanskrit": "न कथ्येयं यस्य कस्य सुतस्याप्य परस्य च ।\nअदांतायाथ दुष्टाय चलचित्ताय दांभिके ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004800051, "chapter_id": 24800, "verse_number": "६-२६२-५२", "content_sanskrit": "स्ववाक्च्युताय निंद्याय न वाच्या योगजा कथा ।\nनित्यभक्ताय दांताय शमादि गुणिने तथा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004800052, "chapter_id": 24800, "verse_number": "६-२६२-५३", "content_sanskrit": "विष्णुभक्ताय दातव्या शूद्रायापि द्विजन्मने ।\nअभक्तायाप्यशुचये ब्रह्मस्थानं न कथ्यते ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004800053, "chapter_id": 24800, "verse_number": "६-२६२-५४", "content_sanskrit": "मद्भक्त्या योगसिद्धिं त्वं गृहाणाशु तपोधने ।\nअभूतं ज्ञानगम्यं तं विद्धि नारायणं परम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004800054, "chapter_id": 24800, "verse_number": "६-२६२-५५", "content_sanskrit": "नादरूपेण शिरसि तिष्ठंतं सर्वदेहिनाम् ।\nस एव जीवशिरसि वर्त्तते सूर्यबिंबवत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004800055, "chapter_id": 24800, "verse_number": "६-२६२-५६", "content_sanskrit": "सदोदितः सूक्ष्मरूपो मूर्त्तो मूर्त्या प्रणीयते ।\nअभ्यासेन सदा देवि प्राप्यते परमात्मकः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004800056, "chapter_id": 24800, "verse_number": "६-२६२-५७", "content_sanskrit": "शरीरे सकला देवा योगिनो निवसंति हि ।\nकर्णे तु दक्षिणे नद्यो निवसंति तथाऽपराः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004800057, "chapter_id": 24800, "verse_number": "६-२६२-५८", "content_sanskrit": "हृदये चेश्वरः शंभुर्नाभौ ब्रह्मा सनातनः ।\nपृथ्वी पादतलाग्रे जलं सर्वगतं तथा ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004800058, "chapter_id": 24800, "verse_number": "६-२६२-५९", "content_sanskrit": "तेजो वायुस्तथाऽकाशं विद्यते भालमध्यतः ।\nहस्ते च पंच तीर्थानि दक्षिणे नात्र संशयः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004800059, "chapter_id": 24800, "verse_number": "६-२६२-६०", "content_sanskrit": "सूर्यो यद्दक्षिणं नेत्रं चन्द्रो वाममुदाहृतम् ।\nभौमश्चैव बुधश्चैव नासिके द्वे उदाहृते ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004800060, "chapter_id": 24800, "verse_number": "६-२६२-६१", "content_sanskrit": "गुरुश्च दक्षिणे कर्णे वामकर्णे तथा भृगुः ।\nमुखे शनैश्चरः प्रोक्तो गुदे राहुः प्रकीर्तितः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004800061, "chapter_id": 24800, "verse_number": "६-२६२-६२", "content_sanskrit": "केतुरिंद्रियगः प्रोक्तो ग्रहाः सर्वे शरीरगाः ।\nयोगिनो देहमासाद्य भुवनानि चतुर्दश ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004800062, "chapter_id": 24800, "verse_number": "६-२६२-६३", "content_sanskrit": "प्रवर्त्तंते सदा देवि तस्माद्योगं सदाभ्यसेत् ।\nचातुर्मास्ये विशेषेण योगी पापं निकृन्तति ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004800063, "chapter_id": 24800, "verse_number": "६-२६२-६४", "content_sanskrit": "मुहूर्त्तमपि यो योगी मस्तके धारयेन्मनः ।\nकर्णै पिधाय पापेभ्यो मुच्यतेऽसौ न संशयः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004800064, "chapter_id": 24800, "verse_number": "६-२६२-६५", "content_sanskrit": "अंतरं नैव पश्यामि विष्णोर्योगपरस्य वा ।\nएकोऽपि योगी यद्गेहे ग्रासमात्रं भुनक्ति च ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004800065, "chapter_id": 24800, "verse_number": "६-२६२-६६", "content_sanskrit": "कुलानि त्रीणि सोऽवश्यं तारयेदात्मना सह ।\nयदि विप्रो भवेद्योगी सोऽवश्यं दर्शनादपि ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004800066, "chapter_id": 24800, "verse_number": "६-२६२-६७", "content_sanskrit": "सर्वेषां प्राणिनां देवि पापराशि निषूदकः ।\nसक्रियो ब्रह्मनिरतः सच्छूद्रो योगभाग्यदि ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004800067, "chapter_id": 24800, "verse_number": "६-२६२-६८", "content_sanskrit": "भवेत्सद्गुरुभक्तो वा सोऽप्यमूर्त्तफलं लभेत् ।\nयो योगी नियताहारः परब्रह्म समाधिमान् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004800068, "chapter_id": 24800, "verse_number": "६-२६२-६९", "content_sanskrit": "चातुर्मास्ये विशेषेण हरौ स लयभाग्भवेत् ।\nयथा सिद्धकरस्पर्शाल्लोहं भवति कांचनम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004800069, "chapter_id": 24800, "verse_number": "६-२६२-७०", "content_sanskrit": "तथा मूर्त्तं हरिप्रीत्या मनुष्यो लयमाव्रजेत् ।\nयथा मार्गजलं गंगापतितं त्रिदशैरपि ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004800070, "chapter_id": 24800, "verse_number": "६-२६२-७१", "content_sanskrit": "सेवितं सर्वफलदं तथा योगी विमुक्तिदः ।\nयथा गोमयमात्रेण वह्निर्दीप्यति सर्वदा ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004800071, "chapter_id": 24800, "verse_number": "६-२६२-७२", "content_sanskrit": "देवतानां मुखं तद्धि कीर्त्यते याज्ञिकैः सदा ।\nएवं योगी सदाऽभ्यासाज्जायते मोक्षभाजनम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004800072, "chapter_id": 24800, "verse_number": "६-२६२-७३", "content_sanskrit": "योगोऽयं सेव्यते देवि ज्ञानासिद्धिप्रदः सदा ।\nसनकादिभिराचार्यैर्मुमुक्षुभिरधीश्वरैः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004800073, "chapter_id": 24800, "verse_number": "६-२६२-७४", "content_sanskrit": "प्रथमं ज्ञानसंपत्तिर्जायते योगिनां सदा ।\nतेषां गृहीतमात्रस्तु योगी भवति पार्वति ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004800074, "chapter_id": 24800, "verse_number": "६-२६२-७५", "content_sanskrit": "ततस्तु सिद्धयस्तस्य त्वणिमाद्याः पुरोगताः ।\nभवन्ति तत्रापि मनो न दद्याद्योगिनां वरः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004800075, "chapter_id": 24800, "verse_number": "६-२६२-७६", "content_sanskrit": "सर्वदानक्रतुभवं पुण्यं भवति योगतः ।\nयोगात्सकलकामाप्तिर्न योगाद्भुवि प्राप्यते ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004800076, "chapter_id": 24800, "verse_number": "६-२६२-७७", "content_sanskrit": "योगान्न हृदयग्रंथिर्न योगान्ममता रिपुः ।\nन योगसिद्धस्य मनो हर्त्तुं केनापि शक्यते ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004800077, "chapter_id": 24800, "verse_number": "६-२६२-७८", "content_sanskrit": "स एव विमलो योगी यच्चित्तं शिरसि स्थितम् ।\nस्थिरीभूतव्यथं नित्यं दशमद्वारसंपुटे ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004800078, "chapter_id": 24800, "verse_number": "६-२६२-७९", "content_sanskrit": "कणौं पिधाय मर्त्यस्य नादरूपं विचिन्वतः ।\nतदेव प्रणवस्याग्रं तदेव ब्रह्म शाश्वतम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004800079, "chapter_id": 24800, "verse_number": "६-२६२-८०", "content_sanskrit": "तदेवानंतरूपाख्यं तदेवामृतमुत्तमम् ।\nघ्राणवायौ प्रघोषोऽयं जठराग्नेर्महत्पदम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004800080, "chapter_id": 24800, "verse_number": "६-२६२-८१", "content_sanskrit": "पंचभूतं निवासं यज्ज्ञानरूपमिदं पदम् ।\nपदं प्राप्य विमुक्तिः स्याज्जन्मसंसारबंधनात् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004800081, "chapter_id": 24800, "verse_number": "६-२६२-८२", "content_sanskrit": "यदाप्तिर्दुलभा लोके योगसिद्धिप्रदायिका ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004800082, "chapter_id": 24800, "verse_number": "६-२६२-८३", "content_sanskrit": "एवं ब्रह्ममयं विभाति सकलं विश्वं चरं स्थावरं विज्ञानाख्यमिदं पदं स भगवान्विष्णुः स्वयं व्यापकः ।\nज्ञात्वा तं शिरसि स्थितं बहुवरं योगेश्वराणां परं प्राणी मुंचति सर्पवज्जगतिजां निर्मोकमायाकृतिम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004800083, "chapter_id": 24800, "verse_number": "६-२६२-८४", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीति साहरस्र्यां संहितायां षष्ठे नागरखण्डे हाटकेश्वरक्षेत्रमाहात्म्ये शेषशाय्युपाख्याने ब्रह्मनारदसंवादे चातुर्मास्यमाहात्म्ये ज्ञानयोगकथनं नाम द्विषष्ट्युत्तरद्विशततमोऽध्यायः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}]