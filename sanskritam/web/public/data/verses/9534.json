[{"id": 5000534000, "chapter_id": 9534, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे सप्तविंशत्यधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000534001, "chapter_id": 9534, "verse_number": "६-१२७-१", "content_sanskrit": "श्रुत्वा तु परमानन्दं भरतः सत्यविक्रमः।\nहृष्टमाज्ञापयामास शत्रुघ्नं परवीरहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000534002, "chapter_id": 9534, "verse_number": "६-१२७-२", "content_sanskrit": "दैवतानि च सर्वाणि चैत्यानि नगरस्य च।\nसुगन्धमाल्यैर्वादित्रैरर्चन्तु शुचयो नराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000534003, "chapter_id": 9534, "verse_number": "६-१२७-३", "content_sanskrit": "सूताः स्तुतिपुराणज्ञाः सर्वे वैतालिकास्तथा।\nसर्वे वादित्रकुशला गणिकाश्चैव सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000534004, "chapter_id": 9534, "verse_number": "६-१२७-४", "content_sanskrit": "राजदारास्तथामात्याः सैन्याः सेनाङ्गनागणाः।\nब्राह्मणाश्च सराजन्याः श्रेणीमुख्यास्तथा गणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000534005, "chapter_id": 9534, "verse_number": "६-१२७-५", "content_sanskrit": "अभिनिर्यान्तु रामस्य द्रष्टुं शशिनिभं मुखम्।\nभरतस्य वचः श्रुत्वा शत्रुघ्नः परवीरहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000534006, "chapter_id": 9534, "verse_number": "६-१२७-६", "content_sanskrit": "विष्टीरनेकसाहस्रीश्चोदयामास भागशः।\nसमीकुरुत निम्नानि विषमाणि समानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000534007, "chapter_id": 9534, "verse_number": "६-१२७-७", "content_sanskrit": "स्थानानि च निरस्यन्तां नन्दिग्रामादितः परम्।\nसिञ्चन्तु पृथिवीं कृत्स्नां हिमशीतेन वारिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000534008, "chapter_id": 9534, "verse_number": "६-१२७-८", "content_sanskrit": "ततोऽभ्यवकिरन्त्वन्ये लाजैः पुष्पैश्च सर्वतः।\nसमुच्छ्रितपताकास्तु रथ्याः पुरवरोत्तमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000534009, "chapter_id": 9534, "verse_number": "६-१२७-९", "content_sanskrit": "शोभयन्तु च वेश्मानि सूर्यस्योदयनं प्रति।\nस्रग्दाममुक्तपुष्पैश्च सुवर्णैः पञ्चवर्णकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000534010, "chapter_id": 9534, "verse_number": "६-१२७-१०", "content_sanskrit": "राजमार्गमसम्बाधं किरन्तु शतशो नराः।\nततस्तच्छासनं श्रुत्वा शत्रुघ्नस्य मुदान्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000534011, "chapter_id": 9534, "verse_number": "६-१२७-११", "content_sanskrit": "धृष्टिर्जयन्तो विजयः सिद्धार्थश्चार्थसाधकः।\nअशोको मन्त्रपालश्च सुमन्त्रश्चापि निर्ययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000534012, "chapter_id": 9534, "verse_number": "६-१२७-१२", "content_sanskrit": "मत्तैर्नागसहस्रैश्च सध्वजैः सुविभूषितैः।\nअपरे हेमकक्षाभिः सगजाभिः करेणुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000534013, "chapter_id": 9534, "verse_number": "६-१२७-१३", "content_sanskrit": "निर्ययुस्तुरगाक्रान्ता रथैश्च सुमहारथाः।\nशक्त्यृष्टिपाशहस्तानां सध्वजानां पताकिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000534014, "chapter_id": 9534, "verse_number": "६-१२७-१४", "content_sanskrit": "तुरगाणां सहस्रैश्च मुख्यैर्मुख्यतरान्वितैः।\nपदातीनां सहस्रैश्च वीराः परिवृता ययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000534015, "chapter_id": 9534, "verse_number": "६-१२७-१५", "content_sanskrit": "ततो यानान्युपारूढाः सर्वा दशरथस्त्रियः।\nकौसल्यां प्रमुखे कृत्वा सुमित्रां चापि निर्ययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000534016, "chapter_id": 9534, "verse_number": "६-१२७-१६", "content_sanskrit": "कैकेय्या सहिताः सर्वा नन्दिग्राममुपागमन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000534017, "chapter_id": 9534, "verse_number": "६-१२७-१७", "content_sanskrit": "द्विजातिमुख्यैर्धर्मात्मा श्रेणीमुख्यैः सनैगमैः।\nमाल्यमोदकहस्तैश्च मन्त्रिभिर्भरतो वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000534018, "chapter_id": 9534, "verse_number": "६-१२७-१८", "content_sanskrit": "शङ्खभेरीनिनादैश्च बन्दिभिश्चाभिनन्दितः।\nआर्यपादौ गृहीत्वा तु शिरसा धर्मकोविदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000534019, "chapter_id": 9534, "verse_number": "६-१२७-१९", "content_sanskrit": "पाण्डुरं छत्रमादाय शुक्लमाल्योपशोभितम्।\nशुक्ले च वालव्यजने राजार्हे हेमभूषिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000534020, "chapter_id": 9534, "verse_number": "६-१२७-२०", "content_sanskrit": "उपवासकृशो दीनश्चीरकृष्णाजिनाम्बरः।\nभ्रातुरागमनं श्रुत्वा तत्पूर्वं हर्षमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000534021, "chapter_id": 9534, "verse_number": "६-१२७-२१", "content_sanskrit": "प्रत्युद्ययौ यदा रामं महात्मा सचिवैः सह।\nअश्वानां खुरशब्दैश्च रथनेमिस्वनेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000534022, "chapter_id": 9534, "verse_number": "६-१२७-२२", "content_sanskrit": "शङ्खदुन्दुभिनादेन संचचालेव मेदिनी।\nगजानां बृंहितैश्चापि शङ्खदुन्दुभिनिःस्वनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000534023, "chapter_id": 9534, "verse_number": "६-१२७-२३", "content_sanskrit": "कृत्स्नं तु नगरं तत् तु नन्दिग्राममुपागमत्।\nसमीक्ष्य भरतो वाक्यमुवाच पवनात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000534024, "chapter_id": 9534, "verse_number": "६-१२७-२४", "content_sanskrit": "कच्चिन्न खलु कापेयी सेव्यते चलचित्तता।\nनहि पश्यामि काकुत्स्थं राममार्यं परंतपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000534025, "chapter_id": 9534, "verse_number": "६-१२७-२५", "content_sanskrit": "कच्चिन्न चानुदृश्यन्ते कपयः कामरूपिणः।\nअथैवमुक्ते वचने हनूमानिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000534026, "chapter_id": 9534, "verse_number": "६-१२७-२६", "content_sanskrit": "अर्थ्यं विज्ञापयन्नेव भरतं सत्यविक्रमम्।\nसदाफलान् कुसुमितान् वृक्षान् प्राप्य मधुस्रवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000534027, "chapter_id": 9534, "verse_number": "६-१२७-२७", "content_sanskrit": "भरद्वाजप्रसादेन मत्तभ्रमरनादितान्।\nतस्य चैव वरो दत्तो वासवेन परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000534028, "chapter_id": 9534, "verse_number": "६-१२७-२८", "content_sanskrit": "ससैन्यस्य तदातिथ्यं कृतं सर्वगुणान्वितम्।\nनिःस्वनः श्रूयते भीमः प्रहृष्टानां वनौकसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000534029, "chapter_id": 9534, "verse_number": "६-१२७-२९", "content_sanskrit": "मन्ये वानरसेना सा नदीं तरति गोमतीम्।\nरजोवर्षं समुद्भूतं पश्य सालवनं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000534030, "chapter_id": 9534, "verse_number": "६-१२७-३०", "content_sanskrit": "मन्ये सालवनं रम्यं लोलयन्ति प्लवंगमाः।\nतदेतद् दृश्यते दूराद् विमानं चन्द्रसंनिभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000534031, "chapter_id": 9534, "verse_number": "६-१२७-३१", "content_sanskrit": "विमानं पुष्पकं दिव्यं मनसा ब्रह्मनिर्मितम्।\nरावणं बान्धवैः सार्धं हत्वा लब्धं महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000534032, "chapter_id": 9534, "verse_number": "६-१२७-३२", "content_sanskrit": "तरुणादित्यसंकाशं विमानं रामवाहनम्।\nधनदस्य प्रसादेन दिव्यमेतन्मनोजवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000534033, "chapter_id": 9534, "verse_number": "६-१२७-३३", "content_sanskrit": "एतस्मिन् भ्रातरौ वीरौ वैदेह्या सह राघवौ।\nसुग्रीवश्च महातेजा राक्षसश्च विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000534034, "chapter_id": 9534, "verse_number": "६-१२७-३४", "content_sanskrit": "ततो हर्षसमुद्भूतो निःस्वनो दिवमस्पृशत्।\nस्त्रीबालयुववृद्धानां रामोऽयमिति कीर्तिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000534035, "chapter_id": 9534, "verse_number": "६-१२७-३५", "content_sanskrit": "रथकुञ्जरवाजिभ्यस्तेऽवतीर्य महीं गताः।\nददृशुस्तं विमानस्थं नराः सोममिवाम्बरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000534036, "chapter_id": 9534, "verse_number": "६-१२७-३६", "content_sanskrit": "प्राञ्जलिर्भरतो भूत्वा प्रहृष्टो राघवोन्मुखः।\nयथार्थेनार्घ्यपाद्याद्यैस्ततो राममपूजयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000534037, "chapter_id": 9534, "verse_number": "६-१२७-३७", "content_sanskrit": "मनसा ब्रह्मणा सृष्टे विमाने भरताग्रजः।\nरराज पृथुदीर्घाक्षो वज्रपाणिरिवामरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000534038, "chapter_id": 9534, "verse_number": "६-१२७-३८", "content_sanskrit": "ततो विमानाग्रगतं भरतो भ्रातरं तदा।\nववन्दे प्रणतो रामं मेरुस्थमिव भास्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000534039, "chapter_id": 9534, "verse_number": "६-१२७-३९", "content_sanskrit": "ततो रामाभ्यनुज्ञातं तद् विमानमनुत्तमम्।\nहंसयुक्तं महावेगं निपपात महीतलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000534040, "chapter_id": 9534, "verse_number": "६-१२७-४०", "content_sanskrit": "आरोपितो विमानं तद् भरतः सत्यविक्रमः।\nराममासाद्य मुदितः पुनरेवाभ्यवादयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000534041, "chapter_id": 9534, "verse_number": "६-१२७-४१", "content_sanskrit": "तं समुत्थाय काकुत्स्थश्चिरस्याक्षिपथं गतम्।\nअङ्के भरतमारोप्य मुदितः परिषस्वजे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000534042, "chapter_id": 9534, "verse_number": "६-१२७-४२", "content_sanskrit": "ततो लक्ष्मणमासाद्य वैदेहीं च परंतपः।\nअथाभ्यवादयत् प्रीतो भरतो नाम चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000534043, "chapter_id": 9534, "verse_number": "६-१२७-४३", "content_sanskrit": "सुग्रीवं केकयीपुत्रो जाम्बवन्तमथाङ्गदम्।\nमैन्दं च द्विविदं नीलमृषभं चैव सस्वजे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000534044, "chapter_id": 9534, "verse_number": "६-१२७-४४", "content_sanskrit": "सुषेणं च नलं चैव गवाक्षं गन्धमादनम्।\nशरभं पनसं चैव परितः परिषस्वजे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000534045, "chapter_id": 9534, "verse_number": "६-१२७-४५", "content_sanskrit": "ते कृत्वा मानुषं रूपं वानराः कामरूपिणः।\nकुशलं पर्यपृच्छंस्ते प्रहृष्टा भरतं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000534046, "chapter_id": 9534, "verse_number": "६-१२७-४६", "content_sanskrit": "अथाब्रवीद् राजपुत्रः सुग्रीवं वानरर्षभम्।\nपरिष्वज्य महातेजा भरतो धर्मिणां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000534047, "chapter_id": 9534, "verse_number": "६-१२७-४७", "content_sanskrit": "त्वमस्माकं चतुर्णां वै भ्राता सुग्रीव पञ्चमः।\nसौहृदाज्जायते मित्रमपकारोऽरिलक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000534048, "chapter_id": 9534, "verse_number": "६-१२७-४८", "content_sanskrit": "विभीषणं च भरतः सान्त्ववाक्यमथाब्रवीत्।\nदिष्ट्या त्वया सहायेन कृतं कर्म सुदुष्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000534049, "chapter_id": 9534, "verse_number": "६-१२७-४९", "content_sanskrit": "शत्रुघ्नश्च तदा राममभिवाद्य सलक्ष्मणम्।\nसीतायाश्चरणौ वीरो विनयादभ्यवादयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000534050, "chapter_id": 9534, "verse_number": "६-१२७-५०", "content_sanskrit": "रामो मातरमासाद्य विवर्णां शोककर्शिताम्।\nजग्राह प्रणतः पादौ मनो मातुः प्रहर्षयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000534051, "chapter_id": 9534, "verse_number": "६-१२७-५१", "content_sanskrit": "अभिवाद्य सुमित्रां च कैकेयीं च यशस्विनीम्।\nस मातॄश्च ततः सर्वाः पुरोहितमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000534052, "chapter_id": 9534, "verse_number": "६-१२७-५२", "content_sanskrit": "स्वागतं ते महाबाहो कौसल्यानन्दवर्धन।\nइति प्राञ्जलयः सर्वे नागरा राममब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000534053, "chapter_id": 9534, "verse_number": "६-१२७-५३", "content_sanskrit": "तान्यञ्जलिसहस्राणि प्रगृहीतानि नागरैः।\nव्याकोशानीव पद्मानि ददर्श भरताग्रजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000534054, "chapter_id": 9534, "verse_number": "६-१२७-५४", "content_sanskrit": "पादुके ते तु रामस्य गृहीत्वा भरतः स्वयम्।\nचरणाभ्यां नरेन्द्रस्य योजयामास धर्मवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000534055, "chapter_id": 9534, "verse_number": "६-१२७-५५", "content_sanskrit": "अब्रवीच्च तदा रामं भरतः स कृताञ्जलिः।\nएतत् ते सकलं राज्यं न्यासं निर्यातितं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000534056, "chapter_id": 9534, "verse_number": "६-१२७-५६", "content_sanskrit": "अद्य जन्म कृतार्थं मे संवृत्तश्च मनोरथः।\nयत् त्वां पश्यामि राजानमयोध्यां पुनरागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000534057, "chapter_id": 9534, "verse_number": "६-१२७-५७", "content_sanskrit": "अवेक्षतां भवान् कोशं कोष्ठागारं गृहं बलम्।\nभवतस्तेजसा सर्वं कृतं दशगुणं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000534058, "chapter_id": 9534, "verse_number": "६-१२७-५८", "content_sanskrit": "तथा ब्रुवाणं भरतं दृष्ट्वा तं भ्रातृवत्सलम्।\nमुमुचुर्वानरा बाष्पं राक्षसश्च विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000534059, "chapter_id": 9534, "verse_number": "६-१२७-५९", "content_sanskrit": "ततः प्रहर्षाद् भरतमङ्कमारोप्य राघवः।\nययौ तेन विमानेन ससैन्यो भरताश्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000534060, "chapter_id": 9534, "verse_number": "६-१२७-६०", "content_sanskrit": "भरताश्रममासाद्य ससैन्यो राघवस्तदा।\nअवतीर्य विमानाग्रादवतस्थे महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000534061, "chapter_id": 9534, "verse_number": "६-१२७-६१", "content_sanskrit": "अब्रवीत् तु तदा रामस्तद् विमानमनुत्तमम्।\nवह वैश्रवणं देवमनुजानामि गम्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000534062, "chapter_id": 9534, "verse_number": "६-१२७-६२", "content_sanskrit": "ततो रामाभ्यनुज्ञातं तद् विमानमनुत्तमम्।\nउत्तरां दिशमुद्दिश्य जगाम धनदालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000534063, "chapter_id": 9534, "verse_number": "६-१२७-६३", "content_sanskrit": "विमानं पुष्पकं दिव्यं संगृहीतं तु रक्षसा।\nअगमद् धनदं वेगाद् रामवाक्यप्रचोदितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000534064, "chapter_id": 9534, "verse_number": "६-१२७-६४", "content_sanskrit": "पुरोहितस्यात्मसखस्य राघवो\nबृहस्पतेः शक्र इवामराधिपः।\nनिपीड्य पादौ पृथगासने शुभे\nसहैव तेनोपविवेश वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000534065, "chapter_id": 9534, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे सप्तविंशत्यधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]