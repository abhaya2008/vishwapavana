[{"id": 7002002000, "chapter_id": 22002, "verse_number": "४७-१", "content_sanskrit": "भगवानुवाच ।\nशालग्रामादिचक्राङ्कपूजाः सिद्ध्यैवदामि ते ।\nत्रिविधास्याद्धरेः पूजा काम्याकाम्योभयात्मिका ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002002001, "chapter_id": 22002, "verse_number": "४७-२", "content_sanskrit": "मीनादीनान्त पञ्चानां काम्याथो वोभयात्मिका ।\nवराहस्प नृसिंहस्य वामनस्य चमुक्तये ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002002002, "chapter_id": 22002, "verse_number": "४७-३", "content_sanskrit": "चक्रादीनां त्रयाणान्तु शालग्रामार्च्चनं श्रृणु ।\nउत्तमा निष्फला पूजा कनिष्ठा सफलार्चना ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002002003, "chapter_id": 22002, "verse_number": "४७-४", "content_sanskrit": "मध्यमा मूर्त्तिपूजा स्याच्चक्राव्जे चतुरस्रके ।\nप्रणवं हृदि विन्यस्य षडङ्गङ्करदेहयोः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002002004, "chapter_id": 22002, "verse_number": "४७-५", "content_sanskrit": "कृतमुद्रात्रयश्चक्राद् बहिः पूर्वे गुरुं यजेत् ।\nआप्ये गणं वायवे च धातारं नैरृते यजेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002002005, "chapter_id": 22002, "verse_number": "४७-६", "content_sanskrit": "विधातारञ्च कर्त्तारं हर्त्तारं दक्षसौम्ययोः ।\nविष्वकसेनं यजेदीशे आग्नेये क्षेत्रपालकम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002002006, "chapter_id": 22002, "verse_number": "४७-७", "content_sanskrit": "ऋगादिवेदान् प्रागादौ आधारानन्तकं भुवम् ।\nपीठं पद्मं चार्क वन्द्रवह्व्याख्यं मण्डलत्रयम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002002007, "chapter_id": 22002, "verse_number": "४७-८", "content_sanskrit": "आसनं द्वादशार्णेन तत्र स्थाप्य शिलां यजेत् ।\nव्यस्तेन च समस्तेन स्वबीजेन यजेत् क्रमात् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002002008, "chapter_id": 22002, "verse_number": "४७-९", "content_sanskrit": "पूर्वादावथ वेदाद्यैर्गायत्रीभ्यां जितादिना ।\nप्रणवेनार्च्चयेत् पञ्चान्मुद्रास्तिस्रः प्रदर्शयेत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002002009, "chapter_id": 22002, "verse_number": "४७-१०", "content_sanskrit": "विष्वक्सेनस्य चक्रस्य क्षेत्रपालस्य दर्शयेत् ।\nशालग्रामस्य प्रथमा पूजाथो निष्फलोच्यते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002002010, "chapter_id": 22002, "verse_number": "४७-११", "content_sanskrit": "पूर्ववत् षोडशारञ्च सपद्मं मण्डलं लिखेत् ।\nशङ्खचक्रगदाखड्गैर्गुर्वाद्यं पूर्वंवद्यजेत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002002011, "chapter_id": 22002, "verse_number": "४७-१२", "content_sanskrit": "पूर्वे सौम्ये धनुर्बाणान् वेदाद्यैरासनं ददेत् ।\nशिलां न्यसेद् द्वादशार्णैस्तृतीयं पूजनं श्रृणु ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002002012, "chapter_id": 22002, "verse_number": "४७-१३", "content_sanskrit": "अष्टारमब्जं विलिखेत् गुर्वाद्यं पूर्ववद्यजेत् ।\nअष्टर्णेनासनं दत्त्वा तेनैव च शिलां न्यसेत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002002013, "chapter_id": 22002, "verse_number": "४७-१४", "content_sanskrit": "पूजयेद्दशधा तेन गायत्रीभ्यां जितं तथा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]