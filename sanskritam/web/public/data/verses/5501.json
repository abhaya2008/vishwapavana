[{"id": 2210443, "chapter_id": 5501, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2210444, "chapter_id": 5501, "verse_number": "१", "content_sanskrit": "धर्मागतेन त्यागेन भगवान् सर्वमस्ति चेत् ।\nएतन्मे सर्वमाचक्ष्व कुशलो ह्यसि भाषितुम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2210445, "chapter_id": 5501, "verse_number": "२", "content_sanskrit": "तस्योञ्छवृत्तेर्यद् वृत्तं सक्तुदानं महाफलम् ।\nकथितं मे महद् ब्रह्मन् तथ्यमेतदसंशयम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2210446, "chapter_id": 5501, "verse_number": "३", "content_sanskrit": "कथं हि सर्वयज्ञेषु निश्चयः परमो भवेत् ।\nएतदर्हसि मे वक्तुं निखिलेन द्विजर्षभ ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2210447, "chapter_id": 5501, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2210448, "chapter_id": 5501, "verse_number": "४", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nअगस्त्यस्य महायज्ञे पुरा वृत्तमरिन्दम ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2210449, "chapter_id": 5501, "verse_number": "५", "content_sanskrit": "पुराऽगस्त्यो महातेजा दीक्षां द्वादशवार्षिकीम् ।\nप्रविवेश महाराज सर्वभूतहिते रतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2210450, "chapter_id": 5501, "verse_number": "६", "content_sanskrit": "तत्राग्निकल्पा होतारश्चासन् सर्वे महात्मनः ।\nमूलाहारा निराहाराश्चाश्मकुट्टा मरीचिपाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2210451, "chapter_id": 5501, "verse_number": "७", "content_sanskrit": "परिपुष्टिका वैघसिकाः प्रसङ्ख्यानास्तथैव च ।\nयतयो भिक्षवश्चात्र बभूवुः पर्यवस्थिताः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2210452, "chapter_id": 5501, "verse_number": "८", "content_sanskrit": "सर्वे प्रत्यक्षधर्माणो जितक्रोधा जितेन्द्रियाः ।\nदमे स्थिताश्च सर्वे ते दम्भमोहविवर्जिताः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2210453, "chapter_id": 5501, "verse_number": "९", "content_sanskrit": "वृद्धैः शुद्धैस्तथा नित्यमिन्द्रियैश्चाप्यवाहिताः ।\nउपासते स्म तं यज्ञं भुञ्जानास्ते महर्षयः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2210454, "chapter_id": 5501, "verse_number": "१०", "content_sanskrit": "यथाशक्त्या भगवता तदन्नं समुपार्जितम् ।\nतस्मिन् सत्रे तु यत् किञ्चित् अयोग्यं तत्र नाभवत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2210455, "chapter_id": 5501, "verse_number": "११", "content_sanskrit": "यथा ह्यनेकैर्मुनिभिर्बहवः क्रतवः कृताः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2210456, "chapter_id": 5501, "verse_number": "१२", "content_sanskrit": "एवंविधे त्वगस्त्यस्य वर्तमाने महाध्वरे ।\nन ववर्ष सहस्राक्षः तदा भरतसत्तम ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2210457, "chapter_id": 5501, "verse_number": "१३", "content_sanskrit": "ततः कर्मान्तरे राजन्नगस्त्यस्य महात्मनः ।\nकथेयमभिनिर्वृत्ता मुनीनां भावितात्मनाम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2210458, "chapter_id": 5501, "verse_number": "", "content_sanskrit": "मुनयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2210459, "chapter_id": 5501, "verse_number": "१४", "content_sanskrit": "अगस्त्यो यजमानोऽयं ददात्यन्नं विमत्सरः ।\nन च वर्षति पर्जन्यः कथमन्नं भविष्यति ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2210460, "chapter_id": 5501, "verse_number": "१५", "content_sanskrit": "सत्रं चेदं महद्विप्रा मुनेर्द्वादशवार्षिकम् ।\nन हि वर्षति देवश्च वर्षाण्येतानि द्वादश ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2210461, "chapter_id": 5501, "verse_number": "१६", "content_sanskrit": "एतद् भवन्तः सञ्चिन्त्य महर्षेरत्र धीमतः ।\nअगस्त्यस्यातितपसः कर्तुमर्हन्त्यनुग्रहम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2210462, "chapter_id": 5501, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2210463, "chapter_id": 5501, "verse_number": "१७", "content_sanskrit": "इत्येवमुक्ते वचने ततोऽगस्त्यः प्रतापवान् ।\nप्रोवाचेदं वचो वाग्मी प्रसाद्य शिरसा मुनीन् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2210464, "chapter_id": 5501, "verse_number": "", "content_sanskrit": "अगस्त्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2210465, "chapter_id": 5501, "verse_number": "१८", "content_sanskrit": "यदि द्वादश वर्षाणि न वर्षिष्यति वासवः ।\nचिन्तायज्ञं करिष्यामि विधिरेष सनातनः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2210466, "chapter_id": 5501, "verse_number": "१९", "content_sanskrit": "यदि द्वादश वर्षाणि न च वर्षति वासवः ।\nस्पर्शयज्ञं करिष्यामि विधिरेष सनातनः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2210467, "chapter_id": 5501, "verse_number": "२०", "content_sanskrit": "यदि द्वादश वर्षाणि न च वर्षति वासवः ।\nव्यायामेनाहरिष्यामि यज्ञानेतान् यतव्रतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2210468, "chapter_id": 5501, "verse_number": "२१", "content_sanskrit": "बीजयज्ञो मयाऽयं भो बहुवर्षसमाचितः ।\nबीजैः कृतैः करिष्ये च नात्र विघ्नो भविष्यति ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2210469, "chapter_id": 5501, "verse_number": "२२", "content_sanskrit": "नेदं शक्यं वृथा कर्तुं मम सत्रं कथञ्चन ।\nन वर्षिष्यति वा देवो न वा देवो भविष्यति ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2210470, "chapter_id": 5501, "verse_number": "२३", "content_sanskrit": "अथवाऽभ्यर्थनामिन्द्रः कुर्यान्न त्विह कामतः ।\nस्वयमिन्द्रो भविष्यामि जीवयिष्यामि च प्रजाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2210471, "chapter_id": 5501, "verse_number": "२४", "content_sanskrit": "यो यदाहारदानश्च स तथैव भविष्यति ।\nविशेषं चैव कर्तास्मि पुनः पुनरतीव हि ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2210472, "chapter_id": 5501, "verse_number": "२५", "content_sanskrit": "अद्येह स्वर्णमभ्येतु यच्चान्यद् वसु दुर्लभम् ।\nत्रिषु लोकेषु यच्चास्ति तदिहागच्छतु स्वयम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2210473, "chapter_id": 5501, "verse_number": "२६", "content_sanskrit": "दिवि चाप्सरसां सङ्घाः सगन्धर्वाः सकिन्नराः ।\nविश्वावसुश्च ये चान्ये ते च युष्मानुपासताम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2210474, "chapter_id": 5501, "verse_number": "२७", "content_sanskrit": "उत्तरेभ्यः कुरुभ्यश्च यत् किञ्चिद् वसु विद्यते ।\nसर्वं तदिह यज्ञे मे स्वयमेवोपतिष्ठताम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2210475, "chapter_id": 5501, "verse_number": "२८", "content_sanskrit": "स्वर्गः स्वर्गसदश्चैव धर्मश्च स्वयमेव मे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2210476, "chapter_id": 5501, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2210477, "chapter_id": 5501, "verse_number": "२९", "content_sanskrit": "इत्युक्ते सर्वमेवैतद् अभवत् तस्य धीमतः ।\nतस्य दीप्ताग्निमहसः त्वगस्त्यास्यातितेजसा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2210478, "chapter_id": 5501, "verse_number": "३०", "content_sanskrit": "ततस्ते मुनयो दृष्ट्वा मुनेस्तस्य तपो बलम् ।\nविस्मिता वचनं प्राहुरिदं सर्वे महार्थवत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2210479, "chapter_id": 5501, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2210480, "chapter_id": 5501, "verse_number": "३१", "content_sanskrit": "प्रीताः स्म तववाक्येन न त्विच्छामस्तपोधन ।\nस्वैरेव यज्ञैस्तुष्टाः स्म न्यायेनेच्छामहे वयम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2210481, "chapter_id": 5501, "verse_number": "", "content_sanskrit": "यज्ञदीक्षास्तथा होमान् यच्चान्यन्मृगयामहे ।\n(तन्नोऽस्तु स्वर्गदैर्यज्ञैर्नान्यतो मृगयामहे ॥३२॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2210482, "chapter_id": 5501, "verse_number": "३३", "content_sanskrit": "न्यायेनोपार्जिताहाराः स्वकर्मनिरता वयम् ।\nदेवांश्च ब्रह्मचर्येण न्यायेन प्रार्थयामहे ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2210483, "chapter_id": 5501, "verse_number": "३४", "content_sanskrit": "न्यायेन रञ्जिताः काले गृहेभ्यो निःसृता वयम् ।\nदृष्टैश्च विधिवद् द्वारैस्तपस्तप्स्यामहे वयम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2210484, "chapter_id": 5501, "verse_number": "३५", "content_sanskrit": "भवतः सम्यगेषा हि बुद्धिर्हिंसाविवर्जिता ।\nएतामहिंसां यज्ञेषु ब्रूयास्त्वं सततं विभो ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2210485, "chapter_id": 5501, "verse_number": "३६", "content_sanskrit": "प्रीतास्ततो भविष्यामो वयं द्विजवरोत्तम ।\nविसर्जिताः समाप्तौ च सत्रादस्माद् व्रजेमहि ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2210486, "chapter_id": 5501, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2210487, "chapter_id": 5501, "verse_number": "३७", "content_sanskrit": "तथा कथयतामेवं देवराजः पुरन्दरः ।\nववर्ष सुमहातेजा दृष्ट्वा तस्य तपोबलम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2210488, "chapter_id": 5501, "verse_number": "३८", "content_sanskrit": "असमाप्तौ च यज्ञस्य तस्यामितपराक्रमः ।\nनिकामवर्षी देवेन्द्रो बभूव जनमेजय ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2210489, "chapter_id": 5501, "verse_number": "३९", "content_sanskrit": "प्रसादयामास च तमगस्त्यं त्रिदशेश्वरः ।\nस्वयमभ्येत्य राजर्षे पुरस्कृत्य बृहस्पतिम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2210490, "chapter_id": 5501, "verse_number": "४०", "content_sanskrit": "ततो यज्ञसमाप्तौ तान् विससर्ज महामुनीन् ।\nअगस्त्यः परमप्रीतः पूजयित्वा यथाविधि ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2210491, "chapter_id": 5501, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अगस्त्ययज्ञप्रशंसनं नाम पञ्चनवतितमोऽध्यायः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]