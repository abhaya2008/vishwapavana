[{"id": 7006511000, "chapter_id": 26511, "verse_number": "३-५०-१", "content_sanskrit": "वैशम्पायन उवाच पुलोमा तु महादैत्यस्तिमिराकारगह्वरम् ।\nआरुरोहायसं घोरं रथं पररथारुजम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006511001, "chapter_id": 26511, "verse_number": "३-५०-२", "content_sanskrit": "उत्कीर्णपर्वताकारं लोहजालान्तरान्तरम् ।\nनेमिघोषेण महता क्षुभ्यन्तमिव सागरम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006511002, "chapter_id": 26511, "verse_number": "३-५०-३", "content_sanskrit": "गदापरिघनिस्त्रिंशैः सतोमरपरश्वधैः ।\nशक्तिमुद्गरसंकीर्णं सतोयमिव तोयदम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006511003, "chapter_id": 26511, "verse_number": "३-५०-४", "content_sanskrit": "रथमुष्ट्रसहस्रेण संयुक्तं वायुवेगिना ।\nपुलोमाऽऽरुह्य युद्धाय प्रस्थितो युद्धदुर्मदः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006511004, "chapter_id": 26511, "verse_number": "३-५०-५", "content_sanskrit": "षष्टी रथसहस्राणि पुलोमानं महारथम् ।\nअन्वयुः सूर्यवर्णानि प्रदीप्तानीव तेजसा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006511005, "chapter_id": 26511, "verse_number": "३-५०-६", "content_sanskrit": "खड्गध्वजेन महता तप्तकाञ्चनवर्चसा ।\nभ्राजते रथमध्यस्थः पर्वतस्य इवांशुमान् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006511006, "chapter_id": 26511, "verse_number": "३-५०-७", "content_sanskrit": "सुचारुचामीकरपट्टनद्धां महागदां कालनिभां महाबलः ।\nप्रगृह्य बभ्राज स शत्रुमध्ये कार्ष्णायसीं केतुरिवास्थितोर्व्याम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006511007, "chapter_id": 26511, "verse_number": "३-५०-८", "content_sanskrit": "हयग्रीवस्तु बलवान् हयग्रीवैर्महासुरैः ।\nवृतः शतसहस्रेण रथानां रथिसत्तमः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006511008, "chapter_id": 26511, "verse_number": "३-५०-९", "content_sanskrit": "धराधरनिभाकारं सपत्नानीकमर्दनम् ।\nस्यन्दनं भीममास्थाय युद्धायाभिमुखः स्थितः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006511009, "chapter_id": 26511, "verse_number": "३-५०-१०", "content_sanskrit": "श्वेतशैलप्रतीकाशः श्वेतकुण्डलभूषणः ।\nशुशुभे रथमध्यस्थः श्वेतशृङ्ग इवाचलः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006511010, "chapter_id": 26511, "verse_number": "३-५०-११", "content_sanskrit": "महता सप्तशीर्षेण शोभितो नागकेतुना ।\nवैदूर्यमणिचित्रेण प्रवालाङ्कुरशोभिना ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006511011, "chapter_id": 26511, "verse_number": "३-५०-१२", "content_sanskrit": "अमितबलपराक्रमाकृतीनां वररथिनामनुजग्मुरूर्जितानाम् ।\nअसुरगणशतानि गच्छमानं त्रिदशगणा इव वासवं प्रयान्तम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006511012, "chapter_id": 26511, "verse_number": "३-५०-१३", "content_sanskrit": "प्रह्रादस्तु महाप्राज्ञः सर्वशास्त्रविशारदः ।\nसर्वमायाधरः श्रीमान् यष्टा क्रतुशतैरपि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006511013, "chapter_id": 26511, "verse_number": "३-५०-१४", "content_sanskrit": "समनह्यत तेजस्वी पावकार्चिःसमप्रभः ।\nरथानीकेन महता दुर्दिनाम्भोदनादिना ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006511014, "chapter_id": 26511, "verse_number": "३-५०-१५", "content_sanskrit": "शूरेणामितवीर्येण हेमकुण्डलधारिणा ।\nवृतो दैत्यसहस्रेण देवैरिव पितामहः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006511015, "chapter_id": 26511, "verse_number": "३-५०-१६", "content_sanskrit": "स्ववीर्यादग्रणीर्दृप्तो मत्तवारणविक्रमः ।\nसुरसैन्यस्य सर्वस्य प्रतिक्षोभ इव स्थितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006511016, "chapter_id": 26511, "verse_number": "३-५०-१७", "content_sanskrit": "स्ववीर्येणोदधेस्तुल्यः प्रदीप्ताग्निरिव ज्वलन् ।\nतेजसा भास्कराकारः क्षमया पृथिवीसमः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006511017, "chapter_id": 26511, "verse_number": "३-५०-१८", "content_sanskrit": "तालध्वजेन दीप्तेन रथेनातिविराजता ।\nतं यान्तमनुयान्ति स्म दानवाः शतसंघशः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006511018, "chapter_id": 26511, "verse_number": "३-५०-१९", "content_sanskrit": "सर्वे हिरण्यकवचाः सर्वे रत्नविभूषिताः ।\nदिव्याङ्गरागाभरणाः समरेष्वनिवर्तिनः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006511019, "chapter_id": 26511, "verse_number": "३-५०-२०", "content_sanskrit": "जाम्बूनदविचित्राङ्गा वैदूर्यविकृताङ्गदाः ।\nदिव्यस्यन्दनमध्यस्थाः खस्था इव महाग्रहाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006511020, "chapter_id": 26511, "verse_number": "३-५०-२१", "content_sanskrit": "आचारवांश्चैव जितेन्द्रियश्च धर्मे रतः सत्यपरोऽनसूयः ।\nस्थितोऽग्नितोयाम्बुदवायुकल्पो रूपी यथा सर्वहरः कृतान्तः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006511021, "chapter_id": 26511, "verse_number": "३-५०-२२", "content_sanskrit": "शम्बरस्तु महामायो रथयूथपयूथपः ।\nआरुरोह रथं दिव्यं सर्वयुद्धविशारदः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006511022, "chapter_id": 26511, "verse_number": "३-५०-२३", "content_sanskrit": "लोहिताक्षो महाबाहुः प्रतप्तोत्तमकुण्डलः ।\nजीमूतघनसंकाशो श्यियस्रगनुलेपनः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006511023, "chapter_id": 26511, "verse_number": "३-५०-२४", "content_sanskrit": "विद्युज्ज्योतिर्निकाशेन मुकुटेनार्कवर्चसा ।\nमणिरत्नविचित्रेण वैदूर्यवरशोभिना ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006511024, "chapter_id": 26511, "verse_number": "३-५०-२५", "content_sanskrit": "तपनीयेन महता कवचेन विराजता ।\nसंध्याभ्रेणेव संच्छन्नः श्रीमानस्तशिलोच्चयः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006511025, "chapter_id": 26511, "verse_number": "३-५०-२६", "content_sanskrit": "त्रिंशच्छतसहस्राणि दैत्यानां चित्रयोधिनाम् ।\nबलिनां कालकल्पानामन्वयु शम्बरं तदा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006511026, "chapter_id": 26511, "verse_number": "३-५०-२७", "content_sanskrit": "युक्तं हयसहस्रेण शुक्लवर्णेन राजता ।\nक्रौञ्चध्वजेन दीप्तेन रथेनाहवशोभिना ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006511027, "chapter_id": 26511, "verse_number": "३-५०-२८", "content_sanskrit": "व्यासक्तवैदूर्यसुवर्णजालं नानाविहङ्गैरपि भक्तिचित्रम् ।\nविद्युत्प्रभं भीमरवं सुवेगं रथं समारुह्य रराज दैत्यः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]