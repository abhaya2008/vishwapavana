[
  {
    "id": 16755001,
    "chapter_id": 6155,
    "verse_number": "7.1",
    "content_sanskrit": "श्रीभगवानुवाच —",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "base_unit_id": "BG_C07_V01"
  },
  {
    "id": 16755002,
    "chapter_id": 6155,
    "verse_number": "7.2",
    "content_sanskrit": "ज्ञानं तेऽहं सविज्ञानमिदं वक्ष्याम्यशेषतः ।\nयज्ज्ञात्वा नेह भूयोऽन्यज्ज्ञातव्यमवशिष्यते ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "base_unit_id": "BG_C07_V02"
  },
  {
    "id": 16755003,
    "chapter_id": 6155,
    "verse_number": "7.3",
    "content_sanskrit": "मनुष्याणां सहस्रेषु कश्चिद्यतति सिद्धये ।\nयततामपि सिद्धानां कश्चिन्मां वेत्ति तत्त्वतः ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "base_unit_id": "BG_C07_V03"
  },
  {
    "id": 16755004,
    "chapter_id": 6155,
    "verse_number": "7.4",
    "content_sanskrit": "भूमिरापोऽनलो वायुः खं मनो बुद्धिरेव च ।\nअहङ्कार इतीयं मे भिन्ना प्रकृतिरष्टधा ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "base_unit_id": "BG_C07_V04"
  },
  {
    "id": 16755005,
    "chapter_id": 6155,
    "verse_number": "7.5",
    "content_sanskrit": "अपरेयमितस्त्वन्यां प्रकृतिं विद्धि मे पराम् ।\nजीवभूतां महाबाहो ययेदं धार्यते जगत् ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "base_unit_id": "BG_C07_V05"
  },
  {
    "id": 16755006,
    "chapter_id": 6155,
    "verse_number": "7.6",
    "content_sanskrit": "एतद्योनीनि भूतानि सर्वाणीत्युपधारय ।\nअहं कृत्स्नस्य जगतः प्रभवः प्रलयस्तथा ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "base_unit_id": "BG_C07_V06"
  },
  {
    "id": 16755007,
    "chapter_id": 6155,
    "verse_number": "7.7",
    "content_sanskrit": "मत्तः परतरं नान्यत्किञ्चिदस्ति धनञ्जय ।\nमयि सर्वमिदं प्रोतं सूत्रे मणिगणा इव ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "base_unit_id": "BG_C07_V07"
  },
  {
    "id": 16755008,
    "chapter_id": 6155,
    "verse_number": "7.8",
    "content_sanskrit": "रसोऽहमप्सु कौन्तेय प्रभास्मि शशिसूर्ययोः ।\nप्रणवः सर्ववेदेषु शब्दः खे पौरुषं नृषु ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "base_unit_id": "BG_C07_V08"
  },
  {
    "id": 16755009,
    "chapter_id": 6155,
    "verse_number": "7.9",
    "content_sanskrit": "पुण्यो गन्धः पृथिव्यां च\nतेजश्चास्मि विभावसौ ।\nजीवनं सर्वभूतेषु\nतपश्चास्मि तपस्विषु ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "base_unit_id": "BG_C07_V09"
  },
  {
    "id": 16755010,
    "chapter_id": 6155,
    "verse_number": "7.10",
    "content_sanskrit": "बीजं मां सर्वभूतानां विद्धि पार्थ सनातनम् ।\nबुद्धिर्बुद्धिमतामस्मि तेजस्तेजस्विनामहम् ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "base_unit_id": "BG_C07_V10"
  },
  {
    "id": 16755011,
    "chapter_id": 6155,
    "verse_number": "7.11",
    "content_sanskrit": "बलं बलवतां चाहं कामरागविवर्जितम् ।\nधर्माविरुद्धो भूतेषु कामोऽस्मि भरतर्षभ ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "base_unit_id": "BG_C07_V11"
  },
  {
    "id": 16755012,
    "chapter_id": 6155,
    "verse_number": "7.12",
    "content_sanskrit": "ये चैव सात्त्विका भावा राजसास्तमसाश्च ये ।\nमत्त एवेति तान्विद्धि न त्वहं तेषु ते मयि ॥ १२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "base_unit_id": "BG_C07_V12"
  },
  {
    "id": 16755013,
    "chapter_id": 6155,
    "verse_number": "7.13",
    "content_sanskrit": "त्रिभिर्गुणमयैर्भावैरेभिः सर्वमिदं जगत् ।\nमोहितं नाभिजानाति मामेभ्यः परमव्ययम् ॥ १३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "base_unit_id": "BG_C07_V13"
  },
  {
    "id": 16755014,
    "chapter_id": 6155,
    "verse_number": "7.14",
    "content_sanskrit": "दैवी ह्येषा गुणमयी मम माया दुरत्यया ।\nमामेव ये प्रपद्यन्ते मायामेतां तरन्ति ते ॥ १४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "base_unit_id": "BG_C07_V14"
  },
  {
    "id": 16755015,
    "chapter_id": 6155,
    "verse_number": "7.15",
    "content_sanskrit": "न मां दुष्कृतिनो मूढाः प्रपद्यन्ते नराधमाः ।\nमाययापहृतज्ञाना आसुरं भावमाश्रिताः ॥ १५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "base_unit_id": "BG_C07_V15"
  },
  {
    "id": 16755016,
    "chapter_id": 6155,
    "verse_number": "7.16",
    "content_sanskrit": "चतुर्विधा भजन्ते मां जनाः सुकृतिनोऽर्जुन ।\nआर्तो जिज्ञासुरर्थार्थी ज्ञानी च भरतर्षभ ॥ १६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "base_unit_id": "BG_C07_V16"
  },
  {
    "id": 16755017,
    "chapter_id": 6155,
    "verse_number": "7.17",
    "content_sanskrit": "तेषां ज्ञानी नित्ययुक्त एकभक्तिर्विशिष्यते ।\nप्रियो हि ज्ञानिनोऽत्यर्थमहं स च मम प्रियः ॥ १७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "base_unit_id": "BG_C07_V17"
  },
  {
    "id": 16755018,
    "chapter_id": 6155,
    "verse_number": "7.18",
    "content_sanskrit": "उदाराः सर्व एवैते\nज्ञानी त्वात्मैव मे मतम् ।\nआस्थितः स हि युक्तात्मा\nमामेवानुत्तमां गतिम् ॥ १८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "base_unit_id": "BG_C07_V18"
  },
  {
    "id": 16755019,
    "chapter_id": 6155,
    "verse_number": "7.19",
    "content_sanskrit": "बहूनां जन्मनामन्ते ज्ञानवान्मां प्रपद्यते ।\nवासुदेवः सर्वमिति स महात्मा सुदुर्लभः ॥ १९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "base_unit_id": "BG_C07_V19"
  },
  {
    "id": 16755020,
    "chapter_id": 6155,
    "verse_number": "7.20",
    "content_sanskrit": "कामैस्तैस्तैर्हृतज्ञानाः प्रपद्यन्तेऽन्यदेवताः ।\nतं तं नियममास्थाय प्रकृत्या नियताः स्वया ॥ २० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "base_unit_id": "BG_C07_V20"
  },
  {
    "id": 16755021,
    "chapter_id": 6155,
    "verse_number": "7.21",
    "content_sanskrit": "यो यो यां यां तनुं भक्तः श्रद्धयार्चितुमिच्छति ।\nतस्य तस्याचलां श्रद्धां तामेव विदधाम्यहम् ॥ २१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "base_unit_id": "BG_C07_V21"
  },
  {
    "id": 16755022,
    "chapter_id": 6155,
    "verse_number": "7.22",
    "content_sanskrit": "स तया श्रद्धया युक्तस्तस्या राधनमीहते ।\nलभते च ततः कामान्मयैव विहितान्हि तान् ॥ २२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "base_unit_id": "BG_C07_V22"
  },
  {
    "id": 16755023,
    "chapter_id": 6155,
    "verse_number": "7.23",
    "content_sanskrit": "अन्तवत्तु फलं तेषां\nतद्भवत्यल्पमेधसाम् ।\nदेवान्देवयजो यान्ति\nमद्भक्ता यान्ति मामपि ॥ २३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "base_unit_id": "BG_C07_V23"
  },
  {
    "id": 16755024,
    "chapter_id": 6155,
    "verse_number": "7.24",
    "content_sanskrit": "अव्यक्तं व्यक्तिमापन्नं मन्यन्ते मामबुद्धयः ।\nपरं भावमजानन्तो ममाव्ययमनुत्तमम् ॥ २४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "base_unit_id": "BG_C07_V24"
  },
  {
    "id": 16755025,
    "chapter_id": 6155,
    "verse_number": "7.25",
    "content_sanskrit": "नाहं प्रकाशः सर्वस्य योगमायासमावृतः ।\nमूढोऽयं नाभिजानाति लोको मामजमव्ययम् ॥ २५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "base_unit_id": "BG_C07_V25"
  },
  {
    "id": 16755026,
    "chapter_id": 6155,
    "verse_number": "7.26",
    "content_sanskrit": "वेदाहं समतीतानि वर्तमानानि चार्जुन ।\nभविष्याणि च भूतानि मां तु वेद न कश्चन ॥ २६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "base_unit_id": "BG_C07_V26"
  },
  {
    "id": 16755027,
    "chapter_id": 6155,
    "verse_number": "7.27",
    "content_sanskrit": "इच्छाद्वेषसमुत्थेन द्वन्द्वमोहेन भारत ।\nसर्वभूतानि संमोहं सर्गे यान्ति परन्तप ॥ २७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "base_unit_id": "BG_C07_V27"
  },
  {
    "id": 16755028,
    "chapter_id": 6155,
    "verse_number": "7.28",
    "content_sanskrit": "येषां त्वन्तगतं पापं\nजनानां पुण्यकर्मणाम् ।\nते द्वन्द्वमोहनिर्मुक्ता\nभजन्ते मां दृढव्रताः ॥ २८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "base_unit_id": "BG_C07_V28"
  },
  {
    "id": 16755029,
    "chapter_id": 6155,
    "verse_number": "7.29",
    "content_sanskrit": "जरामरणमोक्षाय मामाश्रित्य यतन्ति ये ।\nते ब्रह्म तद्विदुः कृत्स्नमध्यात्मं कर्म चाखिलम् ॥ २९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "base_unit_id": "BG_C07_V29"
  },
  {
    "id": 16755030,
    "chapter_id": 6155,
    "verse_number": "7.30",
    "content_sanskrit": "साधिभूताधिदैवं मां साधियज्ञं च ये विदुः ।\nप्रयाणकालेऽपि च मां ते विदुर्युक्तचेतसः ॥ ३० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "base_unit_id": "BG_C07_V30"
  }
]