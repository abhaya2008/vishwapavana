[{"id": 5000076000, "chapter_id": 9076, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे षट्सप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000076001, "chapter_id": 9076, "verse_number": "१-७६-१", "content_sanskrit": "श्रुत्वा तु जामदग्न्यस्य वाक्यं दाशरथिस्तदा।\nगौरवाद्यन्त्रितकथः पितू राममथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000076002, "chapter_id": 9076, "verse_number": "१-७६-२", "content_sanskrit": "कृतवानसि यत् कर्म श्रुतवानस्मि भार्गव।\nअनुरुध्यामहे ब्रह्मन् पितुरानृण्यमास्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000076003, "chapter_id": 9076, "verse_number": "१-७६-३", "content_sanskrit": "वीर्यहीनमिवाशक्तं क्षत्रधर्मेण भार्गव।\nअवजानासि मे तेजः पश्य मेऽद्य पराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000076004, "chapter_id": 9076, "verse_number": "१-७६-४", "content_sanskrit": "इत्युक्त्वा राघवः क्रुद्धो भार्गवस्य वरायुधम्।\nशरं च प्रतिजग्राह हस्ताल्लघुपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000076005, "chapter_id": 9076, "verse_number": "१-७६-५", "content_sanskrit": "आरोप्य स धनू रामः शरं सज्यं चकार ह।\nजामदग्न्यं ततो रामं रामः क्रुद्धोऽब्रवीदिदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000076006, "chapter_id": 9076, "verse_number": "१-७६-६", "content_sanskrit": "ब्राह्मणोऽसीति पूज्यो मे विश्वामित्रकृतेन च।\nतस्माच्छक्तो न ते राम मोक्तुं प्राणहरं शरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000076007, "chapter_id": 9076, "verse_number": "१-७६-७", "content_sanskrit": "इमां वा त्वद‍्गतिं राम तपोबलसमर्जितान्।\nलोकानप्रतिमान् वापि हनिष्यामीति मे मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000076008, "chapter_id": 9076, "verse_number": "१-७६-८", "content_sanskrit": "न ह्ययं वैष्णवो दिव्यः शरः परपुरंजयः।\nमोघः पतति वीर्येण बलदर्पविनाशनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000076009, "chapter_id": 9076, "verse_number": "१-७६-९", "content_sanskrit": "वरायुधधरं रामं द्रष्टुं सर्षिगणाः सुराः।\nपितामहं पुरस्कृत्य समेतास्तत्र सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000076010, "chapter_id": 9076, "verse_number": "१-७६-१०", "content_sanskrit": "गन्धर्वाप्सरसश्चैव सिद्धचारणकिन्नराः।\nयक्षराक्षसनागाश्च तद् द्रष्टुं महदद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000076011, "chapter_id": 9076, "verse_number": "१-७६-११", "content_sanskrit": "जडीकृते तदा लोके रामे वरधनुर्धरे।\nनिर्वीर्यो जामदग्न्योऽसौ रामो राममुदैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000076012, "chapter_id": 9076, "verse_number": "१-७६-१२", "content_sanskrit": "तेजोभिर्गतवीर्यत्वाज्जामदग्न्यो जडीकृतः।\nरामं कमलपत्राक्षं मन्दं मन्दमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000076013, "chapter_id": 9076, "verse_number": "१-७६-१३", "content_sanskrit": "काश्यपाय मया दत्ता यदा पूर्वं वसुंधरा।\nविषये मे न वस्तव्यमिति मां काश्यपोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000076014, "chapter_id": 9076, "verse_number": "१-७६-१४", "content_sanskrit": "सोऽहं गुरुवचः कुर्वन् पृथिव्यां न वसे निशाम्।\nतदाप्रभृति काकुत्स्थ कृता मे काश्यपस्य ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000076015, "chapter_id": 9076, "verse_number": "१-७६-१५", "content_sanskrit": "तामिमां मद‍्गतिं वीर हन्तुं नार्हसि राघव।\nमनोजवं गमिष्यामि महेन्द्रं पर्वतोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000076016, "chapter_id": 9076, "verse_number": "१-७६-१६", "content_sanskrit": "लोकास्त्वप्रतिमा राम निर्जितास्तपसा मया।\nजहि ताञ्छरमुख्येन मा भूत् कालस्य पर्ययः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000076017, "chapter_id": 9076, "verse_number": "१-७६-१७", "content_sanskrit": "अक्षय्यं मधुहन्तारं जानामि त्वां सुरेश्वरम्।\nधनुषोऽस्य परामर्शात् स्वस्ति तेऽस्तु परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000076018, "chapter_id": 9076, "verse_number": "१-७६-१८", "content_sanskrit": "एते सुरगणाः सर्वे निरीक्षन्ते समागताः।\nत्वामप्रतिमकर्माणमप्रतिद्वन्द्वमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000076019, "chapter_id": 9076, "verse_number": "१-७६-१९", "content_sanskrit": "न चेयं मम काकुत्स्थ व्रीडा भवितुमर्हति।\nत्वया त्रैलोक्यनाथेन यदहं विमुखीकृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000076020, "chapter_id": 9076, "verse_number": "१-७६-२०", "content_sanskrit": "शरमप्रतिमं राम मोक्तुमर्हसि सुव्रत।\nशरमोक्षे गमिष्यामि महेन्द्रं पर्वतोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000076021, "chapter_id": 9076, "verse_number": "१-७६-२१", "content_sanskrit": "तथा ब्रुवति रामे तु जामदग्न्ये प्रतापवान्।\nरामो दाशरथिः श्रीमांश्चिक्षेप शरमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000076022, "chapter_id": 9076, "verse_number": "१-७६-२२", "content_sanskrit": "स हतान् दृश्य रामेण स्वाँल्लोकांस्तपसार्जितान्।\nजामदग्न्यो जगामाशु महेन्द्रं पर्वतोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000076023, "chapter_id": 9076, "verse_number": "१-७६-२३", "content_sanskrit": "ततो वितिमिराः सर्वा दिशश्चोपदिशस्तथा।\nसुराः सर्षिगणा रामं प्रशशंसुरुदायुधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000076024, "chapter_id": 9076, "verse_number": "१-७६-२४", "content_sanskrit": "रामं दाशरथिं रामो जामदग्न्यः प्रपूजितः।\nततः प्रदक्षिणीकृत्य जगामात्मगतिं प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000076025, "chapter_id": 9076, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे षट्सप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]