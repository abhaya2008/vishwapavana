[{"id": 2037464, "chapter_id": 1808, "verse_number": "५-५३-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2037465, "chapter_id": 1808, "verse_number": "५-५३-१", "content_sanskrit": "यथैव पाण्डवाः सर्वे पराक्रान्ता जिगीषवः।\nतथौभिसरास्तेषां त्यक्तात्मानो जये धृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2037466, "chapter_id": 1808, "verse_number": "५-५३-२", "content_sanskrit": "......हि पराक्रान्तानाचक्षीथाः परान्मम।\nपाञ्चालान्केकयान्मत्स्यान्मागधान्वत्सभूमिपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2037467, "chapter_id": 1808, "verse_number": "५-५३-३", "content_sanskrit": "यश्च सेन्द्रानिमाँल्लोकानिच्छन्कुर्याद्वशे बली।\nस स्रष्टा जगतः कृष्णः पाण्डवानां जये धृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2037468, "chapter_id": 1808, "verse_number": "५-५३-४", "content_sanskrit": "समस्तामर्जुनाद्विद्यां सात्यकिः क्षिप्रमाप्तवान्।\nशैनेयः समरे स्थाता बीजवत्प्रवपञ्शरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2037469, "chapter_id": 1808, "verse_number": "५-५३-५", "content_sanskrit": "धृष्टद्युम्नश्च पाञ्चाल्यः क्रूरकर्मा महारथः ।\nमामकेषु रणं कर्ता बलेषु परमास्त्रवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2037470, "chapter_id": 1808, "verse_number": "५-५३-६", "content_sanskrit": "युधिष्ठिरस्य च क्रोधादर्जुनस्य च विक्रमात्।\nमयाभ्यां भीमसेनाच्च भयं मे तात जायते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2037471, "chapter_id": 1808, "verse_number": "५-५३-७", "content_sanskrit": "अमानुषं मनुष्येन्द्रैर्जालं विततमन्तरा ।\nन मे सैन्यास्तरिष्यन्ति ततः क्रोशामि सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2037472, "chapter_id": 1808, "verse_number": "५-५३-८", "content_sanskrit": "दर्शनीयो मनस्वी च लक्ष्मीवान्ब्रह्मवर्चसी।\nमेधावी सुकृतप्रज्ञो धर्मात्मा पाण्डुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2037473, "chapter_id": 1808, "verse_number": "५-५३-९", "content_sanskrit": "मित्रामात्यैः सुसंपन्नः संपन्नो युद्धयोजकैः ।\nभ्रातृभिः श्वशुरैर्वीरैरुपपन्नो महारथैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2037474, "chapter_id": 1808, "verse_number": "५-५३-१०", "content_sanskrit": "धृत्या च पुरुषव्याघ्रो नैभृत्येन च पाण्डवः।\nअनुशंसो वदान्यश्च हीमान्सत्यपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2037475, "chapter_id": 1808, "verse_number": "५-५३-११", "content_sanskrit": "बहुश्रुतः कृतात्मा च वृद्धसेवी जितेन्द्रियः ।\nतं सर्वगुणसंपन्नं समिद्धमिव पावकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2037476, "chapter_id": 1808, "verse_number": "५-५३-१२", "content_sanskrit": "तपन्तमभि को मन्दः पतिष्यति पतङ्गवत्।\nपाण्डवाग्निमनावार्यं मुमूर्षुर्नष्टचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2037477, "chapter_id": 1808, "verse_number": "५-५३-१३", "content_sanskrit": "तनुरुच्चः शिखी राजा मिथ्योपचरितो मया।\nमन्दानां मम पुत्राणां युद्धेनान्तं करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2037478, "chapter_id": 1808, "verse_number": "५-५३-१४", "content_sanskrit": "तैरयुद्धं साधु मन्ये कुरवस्तन्निबोधत।\nयुद्धे विनाशः कृत्स्नस्य कुलस्य भविता ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2037479, "chapter_id": 1808, "verse_number": "५-५३-१५", "content_sanskrit": "एषा मे परमा बुद्धिर्यया शाम्यति मे मनः ।\nयदि त्वयुद्धमिष्टं वो वयं शान्त्यै यतामहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2037480, "chapter_id": 1808, "verse_number": "५-५३-१६", "content_sanskrit": "न तु नः क्लिश्यमानानामुपेक्षेत युधिष्ठिरः।\nजुगुप्सति ह्यधर्मेण मामेवोद्दिश्य कारणम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2037481, "chapter_id": 1808, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि यानसन्धिपर्वणि त्रिपञ्चाशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]