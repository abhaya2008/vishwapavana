[{"id": 50014624, "chapter_id": 11538, "verse_number": "1", "content_sanskrit": "राजोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50014625, "chapter_id": 11538, "verse_number": "2", "content_sanskrit": "भगवन् श्रोतुमिच्छामि हरेरद्भुतकर्मणः। अवतारकथामन्यां१ मायामत्स्यविडम्बनाम्॥ ८/२३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50014626, "chapter_id": 11538, "verse_number": "3", "content_sanskrit": "यदर्थमदधाद् रूपं मात्स्यं लोकजुगुप्सितम्। तमःप्रकृति दुर्मर्षं कर्मग्रस्त इवेश्वरः॥ ८/२३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50014627, "chapter_id": 11538, "verse_number": "4", "content_sanskrit": "एतन्नो भगवन् सर्वं यथावद् वक्तुमर्हसि। उत्तमश्लोकचरितं सर्वलोकसुखावहम्॥ ८/२३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50014628, "chapter_id": 11538, "verse_number": "5", "content_sanskrit": "सूत उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50014629, "chapter_id": 11538, "verse_number": "6", "content_sanskrit": "इत्युक्तो विष्णुरातेन भगवान् बादरायणिः। उवाच चरितं विष्णोर्मत्स्यरूपेण यत् कृतम्॥ ८/२३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50014630, "chapter_id": 11538, "verse_number": "7", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50014631, "chapter_id": 11538, "verse_number": "8", "content_sanskrit": "गोविप्रसुरसाधूनां छन्दसामपि चेश्वरः। रक्षामिच्छंस्तनूर्धत्ते धर्मस्यार्थस्य चैव हि॥ ८/२३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50014632, "chapter_id": 11538, "verse_number": "9", "content_sanskrit": "उच्चावचेषु भूतेषु चरन् वायुरिवेश्वरः। नोच्चावचत्वं भजते निर्गुणत्वाद् धियो गुणैः॥ ८/२३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50014633, "chapter_id": 11538, "verse_number": "10", "content_sanskrit": "आसीदतीतकल्पान्ते ब्राह्मो नैमित्तिको लयः। समुद्रोपप्लुतास्तत्र लोका भूरादयोऽनघ॥ ८/२३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50014634, "chapter_id": 11538, "verse_number": "11", "content_sanskrit": "कालेनागतनिद्रस्य धातुः शिशयिषोर्जले। मुखतो निःसृतान् वेदान् हयग्रीवोऽन्तिकेऽहरत्॥ ८/२३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50014635, "chapter_id": 11538, "verse_number": "12", "content_sanskrit": "ज्ञात्वा तद् दानवेन्द्रस्य हयग्रीवस्य चेष्टितम्। दधार शफरीरूपं भगवान् हरिरीश्वरः॥ ८/२३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50014636, "chapter_id": 11538, "verse_number": "13", "content_sanskrit": "तत्र राजऋषिः कश्चिन्नाम्ना सत्यव्रतो महान्। नारायणपरोऽतप्यत् तपस्तत्सलिलाशये॥ ८/२३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50014637, "chapter_id": 11538, "verse_number": "14", "content_sanskrit": "योऽसावस्मिन् महाकल्पे तनयः स विवस्वतः। श्राद्धदेव इति ख्यातो मनुत्वे हरिणाऽर्पितः॥ ८/२३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50014638, "chapter_id": 11538, "verse_number": "15", "content_sanskrit": "एकदा कृतमालायां कुर्वतो जलतर्पणम्। तस्याञ्जल्युदके काचित् शफर्येकाऽभ्यपद्यत॥ ८/२३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50014639, "chapter_id": 11538, "verse_number": "16", "content_sanskrit": "सत्यव्रतोऽञ्जलिगतां सह तोयेन भारत। उत्ससर्ज नदीतोये शफरीं द्रमिळेश्वरः॥ ८/२३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50014640, "chapter_id": 11538, "verse_number": "17", "content_sanskrit": "तमाह साऽतिकरुणं महाकारुणिकं नृपम्। यादोभ्यो ज्ञातिघातिभ्यो दीनां मां दीनवत्सल। कथं विसृजसे राजन् भीतामस्मिन् सरिज्जले॥ ८/२३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50014641, "chapter_id": 11538, "verse_number": "18", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50014642, "chapter_id": 11538, "verse_number": "19", "content_sanskrit": "तमात्मनोऽनुग्रहार्थं प्रीत्या मत्स्यवपुर्धरम्। अजानन् रक्षणार्थाय शफार्याः स मनो दधे॥ ८/२३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50014643, "chapter_id": 11538, "verse_number": "20", "content_sanskrit": "तस्या दीनतरं वाक्यमाश्रुत्य स महीपतिः। कलशाप्सु निधायैनां दयाळुर्निन्य आश्रमम्॥ ८/२३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50014644, "chapter_id": 11538, "verse_number": "21", "content_sanskrit": "सा तु तत्रैकरात्रेण वर्द्धमाना कमण्डलौ। अलब्धात्मावकाशं वा इदमाह महीपतिम्॥ ८/२३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50014645, "chapter_id": 11538, "verse_number": "22", "content_sanskrit": "नाहं कमण्डलावस्मिन् कृच्छ्रं वस्तुं नृपोत्सहे। कल्पयौकः सुविपुलं यत्राहं निवसे सुखम्॥ ८/२३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50014646, "chapter_id": 11538, "verse_number": "23", "content_sanskrit": "स एनां तत आदाय न्यधादौदञ्चनोदके। तत्र क्षिप्ता मुहूर्तेन हस्तत्रयमवर्धत॥ ८/२३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50014647, "chapter_id": 11538, "verse_number": "24", "content_sanskrit": "मीन उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50014648, "chapter_id": 11538, "verse_number": "25", "content_sanskrit": "न म एतदलं राजन् सुखं वस्तुमुदञ्चनम्। पृथु देहि पदं मह्यं यत् त्वाऽहं शरणं गता॥ ८/२३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50014649, "chapter_id": 11538, "verse_number": "26", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50014650, "chapter_id": 11538, "verse_number": "27", "content_sanskrit": "तत आदाय सा राज्ञा क्षिप्ता राजन् सरोवरे। तदावृत्यात्मना सर्वं महामीनोऽभ्यवर्द्धत॥ ८/२३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50014651, "chapter_id": 11538, "verse_number": "28", "content_sanskrit": "मीन उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50014652, "chapter_id": 11538, "verse_number": "29", "content_sanskrit": "नैतन् मे स्वस्तये राजन्नुदकं सलिलौकसः। निधेहि राजन् योगेन ह्वदे मामविदासिनि॥ ८/२३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50014653, "chapter_id": 11538, "verse_number": "30", "content_sanskrit": "इत्युक्तः सोऽनयन्मत्स्यं तत्र तत्राविदासिनि। जलाशयेऽसम्मितं तं समुद्रे प्राक्षिपज्झषम्॥ ८/२३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50014654, "chapter_id": 11538, "verse_number": "31", "content_sanskrit": "क्षिप्यमाणस्तमाहेदमिह मां मकरादयः। अदन्त्यतिबला वीर मां नेहोत्स्रष्टुमर्हसि॥ ८/२३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50014655, "chapter_id": 11538, "verse_number": "32", "content_sanskrit": "एवं विमोहितस्तेन वदता वल्गुभारतीम्। तमाह को भवानस्मान् मत्स्यरूपेण मोहयन्॥ ८/२३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50014656, "chapter_id": 11538, "verse_number": "33", "content_sanskrit": "नैवंवीर्यो जलचरो दृष्टोऽस्माभिः श्रुतोऽपि वा। यो भवान् योजनशतमह्नाय व्यानशे सरः॥ ८/२३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50014657, "chapter_id": 11538, "verse_number": "34", "content_sanskrit": "नूनं त्वं भगवान् साक्षाद् हरिर्नारायणोऽव्ययः। अनुग्रहाय भूतानां धत्से रूपं जलौकसाम्॥ ८/२३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50014658, "chapter_id": 11538, "verse_number": "35", "content_sanskrit": "नमस्ते पुरुषश्रेष्ठ स्थित्युत्पत्यप्ययेश्वर। भक्तानां नः प्रपन्नानां मुख्यो ह्यात्मा गतिर्विभो॥ ८/२३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50014659, "chapter_id": 11538, "verse_number": "36", "content_sanskrit": "सर्वे लीलावतारास्ते भूतानां भूतिहेतवे। ज्ञातुमिच्छाम्यदो रूपं यदर्थं भवता धृतम्॥ ८/२३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50014660, "chapter_id": 11538, "verse_number": "37", "content_sanskrit": "न तेऽरविन्दाक्ष पदोपसर्पणं मुधा भवेत् सर्वसुहृत्प्रियात्मनः। यथेतरेषां पृथगात्मनां सतामदीदृशो यद् वपुरद्भुतं हि नः॥ ८/२३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50014661, "chapter_id": 11538, "verse_number": "38", "content_sanskrit": "इति ब्रुवाणं नृपतिं जगत्पतिः सत्यव्रतं मत्स्यवपुर्युगक्षये। विहर्तुकामः प्रळयार्णवेऽब्रवीच्चिकार्षितं कान्तजनप्रियः प्रभुः॥ ८/२३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50014662, "chapter_id": 11538, "verse_number": "39", "content_sanskrit": "श्रीभगवानुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50014663, "chapter_id": 11538, "verse_number": "40", "content_sanskrit": "सप्तमेऽद्यतनादूर्ध्वमहन्येतदरिन्दम। निमङ्क्ष्यत्यप्ययाम्भोधौ त्रैलोक्यं भूर्भुवादिकम्॥ ८/२३/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50014664, "chapter_id": 11538, "verse_number": "41", "content_sanskrit": "त्रिलोक्यां लीयमानायां संवर्ताम्भसि वै तदा। उपस्थास्यति नौः काचिद् विशाला त्वां मयेरिता॥ ८/२३/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50014665, "chapter_id": 11538, "verse_number": "42", "content_sanskrit": "त्वमादायौषधीः सर्वा बीजान्युच्चावचानि च। सप्तर्षिभिः परिवृतः सर्वसत्वोपबृंहितः॥ ८/२३/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50014666, "chapter_id": 11538, "verse_number": "43", "content_sanskrit": "आरुह्य बृहतीं नावं विचरिष्यस्यविक्ल्बः। एकार्णवे निरालोके ऋषीणामेव वर्चसा॥ ८/२३/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50014667, "chapter_id": 11538, "verse_number": "44", "content_sanskrit": "दोधूयमानां तां नावं समीरेण बलीयसा। उपस्थितस्य मे शृङ्गे निबध्नीहि महाहिना॥ ८/२३/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50014668, "chapter_id": 11538, "verse_number": "45", "content_sanskrit": "अहं त्वामृषिभिः साकं सहनावमुदन्वति। विकर्षन् विचरिष्यामि यावद् ब्राह्मी निशा प्रभो॥ ८/२३/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50014669, "chapter_id": 11538, "verse_number": "46", "content_sanskrit": "मदीयं महिमानं च परं ब्रह्मेति शब्दितम्। वेत्स्यस्यनुगृहीतं मे सम्प्रश्नैर्विवृतं हृदि॥ ८/२३/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50014670, "chapter_id": 11538, "verse_number": "47", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50014671, "chapter_id": 11538, "verse_number": "48", "content_sanskrit": "इत्थमादिश्य राजानं हरिरन्तरधीयत। सोऽन्ववैक्षत तं कालं हृषीकेशो यमादिशत्॥ ८/२३/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 50014672, "chapter_id": 11538, "verse_number": "49", "content_sanskrit": "आस्तीर्य दर्भान् प्राक्कूलान् राजर्षिः प्रागुदङ्मुखः। निषसाद हरेः पादौ चिन्तयन् मत्स्यरूपिणः॥ ८/२३/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 50014673, "chapter_id": 11538, "verse_number": "50", "content_sanskrit": "ततः समुद्र उद्वेलः सर्वतः प्लावयन् महीम्। वर्धमानो महामेघैर्वर्षद्भिः समदृश्यत॥ ८/२३/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 50014674, "chapter_id": 11538, "verse_number": "51", "content_sanskrit": "ध्यायन् भगवदादेशं ददृशे नावमागताम्। तामारुरोह विप्रेन्द्रैरादायौषधिवीरुधः॥ ८/२३/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 50014675, "chapter_id": 11538, "verse_number": "52", "content_sanskrit": "तमूचुर्मुनयः प्रीताः राजन् ध्यायस्व केशवम्। स वै नः सङ्कटादस्मादविनाशं विधास्यति॥ ८/२३/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 50014676, "chapter_id": 11538, "verse_number": "53", "content_sanskrit": "सोऽनुध्यातस्तदा राज्ञा प्रादुरासीन्महार्णवे। एकशृङ्गधरो मत्स्यो हैमो नियुतयोजनः॥ ८/२३/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 50014677, "chapter_id": 11538, "verse_number": "54", "content_sanskrit": "निबध्य नावं तच्छृङ्गे यथोक्तो हरिणा पुरा। वरत्रेणाहिना तुष्टस्तुष्टाव मधुसूदनम्॥ ८/२३/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 50014678, "chapter_id": 11538, "verse_number": "55", "content_sanskrit": "राजोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 50014679, "chapter_id": 11538, "verse_number": "56", "content_sanskrit": "अनाद्यविद्योपहतात्मसंविदस्तन्मूलसंसारपरिभ्रमातुराः। यदृच्छयेहोपसृता यमाप्नुयुर्विमुक्तिदो नः परमो गुरुर्भवान्॥ ८/२३/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 50014680, "chapter_id": 11538, "verse_number": "57", "content_sanskrit": "जनोऽबुधोऽयं निजकर्मबन्धनः सुखेच्छया कर्म समीहितेऽसुखम्। यत्सेवया तां विधुनोत्यसन्मतिं ग्रन्धिं स भिन्द्याद् हृदये स नो गुरुः॥ ८/२३/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 50014681, "chapter_id": 11538, "verse_number": "58", "content_sanskrit": "यत्सेवयाऽग्नेरिव रुद्ररोदनं पुमान् विजह्यान्मलमात्मनस्तमः। भजेत वर्णं निजमेष सोऽव्ययो भूयात् स ईशः परमो गुरोर्गुरुः॥ ८/२३/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 50014682, "chapter_id": 11538, "verse_number": "59", "content_sanskrit": "न यत्प्रसादायुतभागलेशमन्ये च देवा गुरवो जनाः स्वयम्। कर्तुं समेताः प्रभवन्ति पुंसस्तमीश्वरं त्वां शरणं प्रपद्ये॥ ८/२३/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 50014683, "chapter_id": 11538, "verse_number": "60", "content_sanskrit": "सचक्षुरन्धस्य यथाऽग्रणीः कृतस्तथा जनस्याविदुषो बुधो गुरुः। त्वमर्थदृक् सर्वदृशां समीक्षणो वृतो गुरुर्नः सुगतिं बुभुत्सताम्॥ ८/२३/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 50014684, "chapter_id": 11538, "verse_number": "61", "content_sanskrit": "जनो जनस्यादिशतेऽसतीं गतिं यया प्रपद्येत दुरत्ययं तमः। त्वमव्ययं ज्ञानममोघमञ्जसा प्रपद्यते येन जनो निजं पदम्॥ ८/२३/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 50014685, "chapter_id": 11538, "verse_number": "62", "content_sanskrit": "त्वं सर्वलोकस्य सुहृत् प्रियेश्वरो ह्यात्मा गुरुर्ज्ञानमभीष्टसिद्धिः। तथापि लोको न भवन्तमन्धधीर्जानाति सन्तं हृदि बद्धकामः॥ ८/२३/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 50014686, "chapter_id": 11538, "verse_number": "63", "content_sanskrit": "तं त्वामहं देववरं वरेण्यं प्रपद्य ईशं प्रतिबोधनाय। छिन्ध्यर्थदीपैर्भगवन् वचोभिर्ग्रन्थिं हृदय्यां विवृणु स्वमोकः॥ ८/२३/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 50014687, "chapter_id": 11538, "verse_number": "64", "content_sanskrit": "इत्युक्तवन्तं नृपतिं भगवानादिपूरुषः। मत्स्यरूपी महाम्भोधौ विहरंस्तत्वमब्रवीत्॥ ८/२३/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 50014688, "chapter_id": 11538, "verse_number": "65", "content_sanskrit": "पुराणसंहितां दिव्यां साङ्ख्ययोगक्रियावतीम्। सत्यव्रतस्य राजर्षेरात्मगुह्यमशेषतः॥ ८/२३/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 50014689, "chapter_id": 11538, "verse_number": "66", "content_sanskrit": "अश्रौषीद् ऋषिभिः साकमात्मतत्वमसंशयम्। नाव्यासीनो भगवता प्रोक्तं ब्रह्म सनातनम्॥ ८/२३/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 50014690, "chapter_id": 11538, "verse_number": "67", "content_sanskrit": "अतीते प्रळयापाय उत्थिताय च वेधसे। हत्वाऽसुरं हयग्रीवं वेदान् प्रत्याहरद् हरिः॥ ८/२३/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 50014691, "chapter_id": 11538, "verse_number": "68", "content_sanskrit": "स तु सत्यव्रतो राजा ज्ञानविज्ञानसंयुतः। विष्णोः प्रसादात् कल्पेऽस्मिन्नासीद् वैवस्वतो मनुः॥ ८/२३/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 50014692, "chapter_id": 11538, "verse_number": "69", "content_sanskrit": "सत्यव्रतस्य राजर्षेर्मायामत्स्यस्य शार्ङ्गिणः। संवादं महदाख्यानं श्रुत्वा मुच्येत किल्बिषात्॥ ८/२३/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 50014693, "chapter_id": 11538, "verse_number": "70", "content_sanskrit": "अवतारं हरेर्योऽमुं कार्तयेदन्वहं नरः। सङ्कल्पा अस्य सिद्ध्यन्ति प्रयाति च परां गतिम्॥ ८/२३/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 50014694, "chapter_id": 11538, "verse_number": "71", "content_sanskrit": "प्रळयपयसि धातुः सुप्तशक्तेर्मुखेभ्यः श्रुतिगणमपनीतं प्रत्युपादत्त हत्वा। दितिजमकथयच्च ब्रह्म सत्यव्रताय तमजमखिलहेतुं जिह्ममीनं नतोऽस्मि॥ ८/२३/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 50014695, "chapter_id": 11538, "verse_number": "72", "content_sanskrit": "इति श्रीमद्भागवते महापुराणे वैयासक्यामष्टादशसाहस्र्यां पारमहंस्यां संहितायामष्टमस्कन्धे त्रयोविंशोऽध्यायः समाप्तश्चाष्टमस्कन्धः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]