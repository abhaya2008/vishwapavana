[{"id": 2138906, "chapter_id": 4007, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2138907, "chapter_id": 4007, "verse_number": "१", "content_sanskrit": "एवं विराटनगरे वसन्तः सत्यविक्रमाः ।\nअत ऊर्ध्वं नरव्याघ्राः किमकुर्वत पाण्डवाः\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2138908, "chapter_id": 4007, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2138909, "chapter_id": 4007, "verse_number": "२", "content_sanskrit": "एवं ते न्यवसंस्तत्र प्रच्छन्नाः कुरुनन्दनाः ।\nआराधयन्तो राजानं यदकुर्वत तच्छृणु\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2138910, "chapter_id": 4007, "verse_number": "३", "content_sanskrit": "तृणबिन्दुप्रसादाच्च धर्मस्य च महात्मनः ।\nअज्ञातवासमेवं ते विराटनगरेऽवसन्\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2138911, "chapter_id": 4007, "verse_number": "४", "content_sanskrit": "युधिष्ठिरः सभास्तारः सभ्यानामभवत् प्रियः ।\nतथैव च विराटस्य सपुत्रस्य विशाम्पते\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2138912, "chapter_id": 4007, "verse_number": "५", "content_sanskrit": "स ह्यक्षहृदयज्ञस्तान् क्रीडयामास पाण्डवः ।\nअक्षवत्यां यथाकामं सूत्रबद्धानिव द्विजान्\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2138913, "chapter_id": 4007, "verse_number": "६", "content_sanskrit": "अज्ञातं च विराटस्य विजित्य वसु धर्मराट् ।\nभ्रातृभ्यः पुरुषव्याघ्रो यथेष्टं सम्प्रयच्छति\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2138914, "chapter_id": 4007, "verse_number": "७", "content_sanskrit": "भीमसेनोऽपि मांसानि भक्ष्याणि विविधानि च ।\nअतिसृष्टानि मात्स्येन विक्रीणन्निव भ्रातृषु\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2138915, "chapter_id": 4007, "verse_number": "८", "content_sanskrit": "वासांसि परिजीर्णानि लब्धान्यन्तःपुरेऽर्जुनः ।\nविक्रीणन् नाम सर्वेभ्यः पाण्डवेभ्यः प्रयच्छति\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2138916, "chapter_id": 4007, "verse_number": "९", "content_sanskrit": "बीभत्सुरपि गीतेन सूनृतेन च पाण्डवः ।\nविराटं तोषयामास सर्वाश्चान्तःपुरे स्त्रियः\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2138917, "chapter_id": 4007, "verse_number": "१०", "content_sanskrit": "अश्वैर्विनीतैर्जवनैस्तत्र तत्र समागतैः ।\nतोषयामास नकुलो राजानं राजसत्तम\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2138918, "chapter_id": 4007, "verse_number": "११", "content_sanskrit": "नकुलोऽपि धनं लब्ध्वा कृते कर्मणि वाजिनाम् ।\nतुष्टे तस्मिन् नरपतौ पाण्डवेभ्यः प्रयच्छति\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2138919, "chapter_id": 4007, "verse_number": "१२", "content_sanskrit": "विनीतान् ऋषभान् दृष्ट्वा सहदेवेन भावितान् ।\nस तु हृष्टश्च सम्प्रादात् तदा राजा धनं बहु\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2138920, "chapter_id": 4007, "verse_number": "१३", "content_sanskrit": "सहदेवो गवां नित्यं कृते मङ्गलकर्मणि ।\nअध्यक्षत्वाच्च यल्लेभे राज्ञः कल्याणकार्यवान्\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2138921, "chapter_id": 4007, "verse_number": "१४", "content_sanskrit": "सहदेवोपि गोपानां वेषमास्थाय पाण्डवः ।\nदधि क्षीरं घृतं चैव पाण्डवेभ्यः प्रयच्छति\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2138922, "chapter_id": 4007, "verse_number": "१५", "content_sanskrit": "कृष्णाऽपि सर्वान् भ्रातॄंस्तान् निरीक्षन्ती तपस्विनी ।\nयथा पुनरविज्ञाता तथा चरति भामिनी\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2138923, "chapter_id": 4007, "verse_number": "१६", "content_sanskrit": "एवं सञ्छादयन्तस्ते तदाऽन्योन्यं महारथाः ।\nप्रेक्षमाणास्तदा कृष्णामूषुश्छन्ना नराधिप\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2138924, "chapter_id": 4007, "verse_number": "१७", "content_sanskrit": "विराटनगरे चेरुः पुनर्गर्भेधिता इव ।\nसशङ्का धार्तराष्ट्रस्य भयात् पाण्डुसुतास्तदा\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2138925, "chapter_id": 4007, "verse_number": "१८", "content_sanskrit": "अथ मासे चतुर्थे तु शङ्करस्य महोत्सवः ।\nआसीत् समृद्धो मत्स्येषु पुरुषाणां सुसम्मतः\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2138926, "chapter_id": 4007, "verse_number": "१९", "content_sanskrit": "तत्र मल्लाः समापेतुर्दिग्भ्यो राजन् महाबलाः\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2138927, "chapter_id": 4007, "verse_number": "२०", "content_sanskrit": "महाकाया महावीर्याः कालकेया इवासुराः ।\nवीर्यवन्तो बलोदग्रा राज्ञा समभिपूजिताः\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2138928, "chapter_id": 4007, "verse_number": "२१", "content_sanskrit": "सिंहस्कन्धकटिग्रीवाः स्ववदाता मनस्विनः ।\nअसकृल्लब्धलज्जास्ते रङ्गे पार्थिवसन्निधौ\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2138929, "chapter_id": 4007, "verse_number": "२२", "content_sanskrit": "तेषामेको महानासीत् सर्वमल्लान् समाह्वयत् ।\nव्यावल्गमानो ददृशे गर्जितोद्गतिभिः स्थितः\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2138930, "chapter_id": 4007, "verse_number": "२३", "content_sanskrit": "वित्रस्तमनसः सर्वे मल्लास्ते हतचेतसः ।\nअवाङ्मुखाश्च भीताश्च मल्लाश्चान्ये विचेतसः\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2138931, "chapter_id": 4007, "verse_number": "२४", "content_sanskrit": "अणुत्वमपरे चैव वाञ्छन्तीव प्रविह्वलाः ।\nगां प्रवेष्टुमिवेच्छन्ति खं गन्तुमिव चोत्थिताः\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2138932, "chapter_id": 4007, "verse_number": "२५", "content_sanskrit": "त्रस्ताः शान्ता विषण्णाश्च निःशब्दा विह्वलेक्षणाः ।\nविराटराजमल्लास्ते भग्नचित्ता हतप्रभाः\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2138933, "chapter_id": 4007, "verse_number": "२६", "content_sanskrit": "मल्लेन्द्रनिहताः सर्वे न किञ्चित् प्रवदन्ति ते ।\nमल्ल उद्वीक्ष्य तान् मल्लान् त्रस्तान् वाक्यमुवाच ह\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2138934, "chapter_id": 4007, "verse_number": "२७", "content_sanskrit": "आगतं मल्लराजं मां कृत्स्ने पृथिविमण्डले ।\nसिंहव्याघ्रगजैः सार्धं क्रीडन्तं विद्धि भूपते\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2138935, "chapter_id": 4007, "verse_number": "२८", "content_sanskrit": "मल्लेन्द्रस्य वचः श्रुत्वा बलदर्पसमन्वितम् ।\nविराटो वीक्ष्य तान् मल्लान् त्रस्तान् वाक्यमुवाच ह\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2138936, "chapter_id": 4007, "verse_number": "२९", "content_sanskrit": "अनेन सह मल्लेन को योद्धुं शक्तिमान् नरः\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2138937, "chapter_id": 4007, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2138938, "chapter_id": 4007, "verse_number": "३०", "content_sanskrit": "ततो युधिष्ठिरोऽवादीत् श्रुत्वा मत्स्यपतेर्वचः\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2138939, "chapter_id": 4007, "verse_number": "३१", "content_sanskrit": "अस्ति मल्लो महाराज मया दृष्टो युधिष्ठिरे ।\nअनेन सह मल्लेन योद्धुं शक्नोति भूपते\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2138940, "chapter_id": 4007, "verse_number": "३२", "content_sanskrit": "योऽसौ मल्लो मया दृष्टः पूर्वं यौधिष्ठिरे बले ।\nसोऽयं मल्लो वसत्येष राजंस्तव महानसे\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2138941, "chapter_id": 4007, "verse_number": "३३", "content_sanskrit": "युधिष्ठिरवचः श्रुत्वा व्यक्तमाहेति पार्थिवः ।\nसोऽप्यथाहूयतां क्षिप्रं योद्धुं मल्लेन संसदि\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2138942, "chapter_id": 4007, "verse_number": "३४", "content_sanskrit": "भीमसेनो विराटेन आहूतश्चोदितस्तथा ।\nयोद्धुं ततोऽब्रवीद् वाक्यं योद्धुं शक्नोमि भूपते\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2138943, "chapter_id": 4007, "verse_number": "३५", "content_sanskrit": "नरेन्द्र ते प्रभावेन श्रिया शक्त्या च शासनात् ।\nअनेन सह मल्लेन योद्धुं राजेन्द्र शक्नुयाम्\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2138944, "chapter_id": 4007, "verse_number": "३६", "content_sanskrit": "युधिष्ठिरकृतश्रेया विश्रमश्च विशाम्पते ।\nमहादेवस्य भक्त्या च तं मल्लं पातयाम्यहम्\t ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2138945, "chapter_id": 4007, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2138946, "chapter_id": 4007, "verse_number": "३७", "content_sanskrit": "चोदितो भीमसेनस्तु मल्लमाहूय मण्डले ।\nयोद्धुं व्यवस्थितो वीरो रेणुं सम्मृज्य हस्तयोः\t ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2138947, "chapter_id": 4007, "verse_number": "३८", "content_sanskrit": "अथ सूदेन तं मल्लं योधयामास पार्थिवः\t ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2138948, "chapter_id": 4007, "verse_number": "३९", "content_sanskrit": "नोद्यमानस्ततो भीमो दुःखेनेवाकरोत् पदम् ।\nन हि शक्नोमि विवृतं प्रत्याख्यातुं नराधिपम्\t ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2138949, "chapter_id": 4007, "verse_number": "४०", "content_sanskrit": "ततः स पुरुषव्याघ्रः शार्दूलशिथिलं चरन् ।\nप्रविवेश महारङ्गं विराटमभिहर्षयन्\t ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2138950, "chapter_id": 4007, "verse_number": "४१", "content_sanskrit": "बद्धकक्षोऽथ कौन्तेयः ततस्तान् हर्षयन् जनान् ।\nतत्र तं वृत्रसङ्काशं भीमो मल्लं समाह्वयत्\t ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2138951, "chapter_id": 4007, "verse_number": "४२", "content_sanskrit": "कक्षे मल्लं गृहीत्वा तु ननाद भुवि सिंहवत्\t ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2138952, "chapter_id": 4007, "verse_number": "४३", "content_sanskrit": "तावुभौ सुमहोत्साहावुभौ भीमपराक्रमौ ।\nमत्ताविव महाकायौ वारणौ सन्निपेततुः\t ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2138953, "chapter_id": 4007, "verse_number": "४४", "content_sanskrit": "ततस्तौ नरशार्दूलौ बाहुयुद्धं समीयतुः ।\nवीरौ परमसंहृष्टावन्योन्यजयकाङ्क्षिणौ\t ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2138954, "chapter_id": 4007, "verse_number": "४५", "content_sanskrit": "आसीत् सुभीमः सम्पातो वज्रपर्वतयोरिव ।\nउभौ परमसंहृष्टौ बलेनातिबलावुभौ\t ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2138955, "chapter_id": 4007, "verse_number": "४६", "content_sanskrit": "अन्योन्यस्यान्तरं प्रेप्सू परस्परजयेषिणौ ।\nउभौ परमसंहृष्टौ मत्ताविव महागजौ\t ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2138956, "chapter_id": 4007, "verse_number": "४७", "content_sanskrit": "कृतप्रतिकृतैश्चित्रैर्बाहुभिश्च सुसङ्कटैः ।\nसन्निपातावधूतैश्च प्रमाथोन्मन्थनैस्तथा\t ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2138957, "chapter_id": 4007, "verse_number": "४८", "content_sanskrit": "क्षेपणैर्मुष्टिभिश्चैव वराहोद्धतनिस्वनैः ।\nतलैर्वज्रनिपातैश्च प्रसृष्टाभिस्तथैव च\t ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2138958, "chapter_id": 4007, "verse_number": "४९", "content_sanskrit": "शलाकहस्तपातैश्च पादोद्धूतैश्च दारुणैः ।\nजानुभिश्चश्मनिर्घोषैः शिरोभिश्चावघट्टनैः\t ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2138959, "chapter_id": 4007, "verse_number": "५०", "content_sanskrit": "तद्युद्धमभवद् घोरमशस्त्रं बाहुतेजसा ।\nबलप्राणेन शूराणां समाजोत्सवसन्निधौ\t ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2138960, "chapter_id": 4007, "verse_number": "५१", "content_sanskrit": "अरज्यत जनः सर्वः सोत्कृष्टनिनदोत्थितः ।\nबलिनोः संयुगे राजन् वृत्रवासवयोरिव\t ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2138961, "chapter_id": 4007, "verse_number": "५२", "content_sanskrit": "प्रकर्षणाकर्षणयोरभ्याकर्षविकर्षणैः ।\nआकर्षतुरथान्योन्यं जानुभिश्चापि जघ्नतुः\t ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2138962, "chapter_id": 4007, "verse_number": "५३", "content_sanskrit": "ततः शब्देन महता भर्त्सयन्तौ परस्परम् ।\nव्यूढोरस्कौ दीर्घभुजौ नियुद्धकुशलावुभौ\t ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2138963, "chapter_id": 4007, "verse_number": "५४", "content_sanskrit": "बाहुभिः समसज्जेतामायसैः परिघैरिव\t ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2138964, "chapter_id": 4007, "verse_number": "५५", "content_sanskrit": "उत्पपाताथ भीमस्तु मल्लं कक्षे गृहीतवान् ।\nपार्श्वं निगृह्य हस्तेन पातयामास मल्लकम्\t ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2138965, "chapter_id": 4007, "verse_number": "५६", "content_sanskrit": "चकर्ष दोर्भ्यामुत्पाट्य भीमो मल्लममित्रहा\t ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2138966, "chapter_id": 4007, "verse_number": "५७", "content_sanskrit": "विनदन्तमभिक्रोधात् शार्दूल इव दारुणः ।\nतमुद्यम्य महाबाहुर्भ्रामयामास पाण्डवः\t ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2138967, "chapter_id": 4007, "verse_number": "५८", "content_sanskrit": "ततो मल्लाश्च मत्स्याश्च विस्मयं चक्रिरे भृशम्\t ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2138968, "chapter_id": 4007, "verse_number": "५९", "content_sanskrit": "भ्रामयित्वा शतगुणं गतसत्वमचेतनम् ।\nप्रत्यपिङ्क्षन् महाबाहुर्मल्लं भुवि वृकोदरः\t ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2138969, "chapter_id": 4007, "verse_number": "६०", "content_sanskrit": "तस्मिन् विनिहते मल्ले वज्रिणेव महाचले ।\nविराटः परमं हर्षमगच्छत् सह बन्धुभिः\t ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2138970, "chapter_id": 4007, "verse_number": "६१", "content_sanskrit": "प्रहर्षात् प्रददौ वित्तं बहु राजा महामनाः ।\nवललाय महारङ्गे यथा वैश्रवणस्तथा\t ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2138971, "chapter_id": 4007, "verse_number": "६२", "content_sanskrit": "एवं स सुबहून् मल्लान् पुरुषांश्च महाबलान् ।\nविनिघ्नन् मत्स्यराजस्य प्रीतिमावहदुत्तमाम्\t ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2138972, "chapter_id": 4007, "verse_number": "६३", "content_sanskrit": "यदाऽस्य तुल्यः पुरुषो न कश्चित् तत्र दृश्यते ।\nततो व्याघ्रैश्च सिंहैश्च द्विरदैश्चाप्ययुध्यत\t ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2138973, "chapter_id": 4007, "verse_number": "६४", "content_sanskrit": "विराटेन तु दत्तानि चित्राणि विविधानि च ।\nस्थितेभ्यः पुरुषेभ्यश्च दत्त्वा द्रव्याणि जग्मिवान्\t ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2138974, "chapter_id": 4007, "verse_number": "६५", "content_sanskrit": "पुनरन्तःपुरगतः स्त्रीणां मध्ये वृकोदरः ।\nयुध्यते स्म विराटस्य गजैः सिंहैर्महाबलैः\t ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2138975, "chapter_id": 4007, "verse_number": "६६", "content_sanskrit": "बीभत्सुरपि गीतेन नृत्तेनापि च पाण्डवः ।\nविराटं तोषयामास सर्वाश्चान्तःपुरस्त्रियः\t ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2138976, "chapter_id": 4007, "verse_number": "६७", "content_sanskrit": "अश्वैर्विनीतैर्जवनैस्तत्र तत्र समागतैः ।\nतोषयामास नकुलो विराटं राजसत्तम\t ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2138977, "chapter_id": 4007, "verse_number": "६८", "content_sanskrit": "तस्मै देयं ददौ राजा बहु द्रव्यं शुभं मुदा\t ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2138978, "chapter_id": 4007, "verse_number": "६९", "content_sanskrit": "विनीतत्वं गवां दृष्ट्वा सहदेवं च तुष्टवान् ।\nतस्मिन् काले नृपः प्रादात् तस्य प्रीतो धनं बहु\t ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2138979, "chapter_id": 4007, "verse_number": "७०", "content_sanskrit": "द्रौपदी प्रेक्ष्य तान् सर्वान् क्लिश्यमानान् महारथान् ।\nनातिप्रीतमना राजन् निःश्वासपरमाऽभवत्\t ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2138980, "chapter_id": 4007, "verse_number": "७१", "content_sanskrit": "एवं ते न्यवसंस्तत्र प्रच्छन्नाः पुरुषर्षभाः ।\nकर्माणि तानि कुर्वाणा विराटनृपतेस्तदा\t ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2138981, "chapter_id": 4007, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि पञ्चदशोऽध्यायः ॥१५॥\nवैराटपर्वणि पञ्चदशोऽध्यायः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2138982, "chapter_id": 4007, "verse_number": "", "content_sanskrit": "॥ समाप्तं वैराटपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2138983, "chapter_id": 4007, "verse_number": "", "content_sanskrit": "* * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]