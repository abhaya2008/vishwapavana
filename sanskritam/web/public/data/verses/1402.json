[{"id": 2019318, "chapter_id": 1402, "verse_number": "३-४०-०x", "content_sanskrit": "देवदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2019319, "chapter_id": 1402, "verse_number": "३-४०-१", "content_sanskrit": "नरस्त्वं पूर्वदेहे वै नारायणसहायवान्।\nबदर्यां तप्तवानुग्रं तपो वर्षायुतान्बहून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2019320, "chapter_id": 1402, "verse_number": "३-४०-२", "content_sanskrit": "त्वयि वा परमं तेजो विष्णौ वा पुरुषोत्तमे।\nयुवाभ्यां पुरुषाग्र्याभ्यां तेजसा धार्यते जगत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2019321, "chapter_id": 1402, "verse_number": "३-४०-३", "content_sanskrit": "शक्राभिषेके सुमहद्धनुर्जलदनिःस्वनम्।\nप्रगृह्य दानवाः शस्तास्त्वया कृष्णेन च प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2019322, "chapter_id": 1402, "verse_number": "३-४०-४", "content_sanskrit": "तदेतदेव गाण्डीवं तव पार्थ करोचितम्।\nभायामास्थाय तद्ग्रस्तं मया पुरुषसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2019323, "chapter_id": 1402, "verse_number": "३-४०-५", "content_sanskrit": "तूणौ चाप्यक्षयौ भूयस्तव पार्थ करोचितौ।\nभविष्यति शरीरं च नीरुजं कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2019324, "chapter_id": 1402, "verse_number": "३-४०-६", "content_sanskrit": "प्रीतिमानस्मि वै पार्थ भवान्सत्यपराक्रमः।\nगृहाण वरमस्मत्तः काङ्क्षितं यन्नरर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2019325, "chapter_id": 1402, "verse_number": "३-४०-७", "content_sanskrit": "न त्वया सदृशः कश्चित्पुमान्मर्त्येषु भारत।\nदिवि वा वर्तते त्रं त्वत्प्रधानमरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2019326, "chapter_id": 1402, "verse_number": "३-४०-८x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2019327, "chapter_id": 1402, "verse_number": "३-४०-८", "content_sanskrit": "वरं ददासि चेन्मह्यं कामं प्रीत्या वृषध्वज।\nकामये दिव्यामस्त्रं तद्धोरं पाशुपतं प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2019328, "chapter_id": 1402, "verse_number": "३-४०-९", "content_sanskrit": "यत्तद्ब्रह्मशिरो नाम रौद्रं भीमपराक्रमम्।\nयुगान्ते दारुणे प्राप्ते कृत्स्नं संहरते जगत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2019329, "chapter_id": 1402, "verse_number": "३-४०-१०", "content_sanskrit": "[कर्णभीष्मकृपद्रोणैर्भविता तु महाहवः।\nत्वत्प्रसादान्महादेव जयेयं तान्यथा युधि ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2019330, "chapter_id": 1402, "verse_number": "३-४०-११", "content_sanskrit": "जयेयं येन संग्रामे दानवान्राक्षसांस्तथा।\nराज्ञश्चैव पिशाचांश्च गन्धर्वानथपन्नगान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2019331, "chapter_id": 1402, "verse_number": "३-४०-१२", "content_sanskrit": "यस्मिञ्शूलसहस्राणि गदाश्चोग्रप्रदर्शनाः।\nशराश्चाशीविषाकाराः संभवन्त्यनुमन्त्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2019332, "chapter_id": 1402, "verse_number": "३-४०-१३", "content_sanskrit": "युध्येयं येन भीष्मेण द्रोणेन च कृपेण च।\nसूतपुत्रेण च रणे नित्यं कटुकभाषिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2019333, "chapter_id": 1402, "verse_number": "३-४०-१४", "content_sanskrit": "एष मे प्रथमः कामो भगवन्भगनेत्रहन्।\nत्वत्प्रसादाद्विनिर्बृत्तः समर्थः स्यामहं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2019334, "chapter_id": 1402, "verse_number": "३०-११-१५x", "content_sanskrit": "भव उवाच। a", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2019335, "chapter_id": 1402, "verse_number": "३-४०-१५", "content_sanskrit": "ददामि तेऽस्त्रं दयितमहं पाशुपतं विभो।\nसमर्थो धारणे मोक्षे संहारेऽपि च पाण्डव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2019336, "chapter_id": 1402, "verse_number": "३-४०-१६", "content_sanskrit": "न तद्वेद महेन्द्रोपि न यमो न च यक्षराट्।\nवरुणोप्यथवा वायुः कुतो वेत्स्यन्ति मानवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2019337, "chapter_id": 1402, "verse_number": "३-४०-१७", "content_sanskrit": "न त्वया सहसा पार्थ मोक्तव्यं पुरुषे क्वचित्।\nजगद्विनिर्दहेत्सर्वमल्पतेजसि पातितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2019338, "chapter_id": 1402, "verse_number": "३-४०-१८", "content_sanskrit": "अबध्यो नाम नास्त्यस्य त्रैलोक्ये सचराचरे।\nमनसा चक्षुषा वाचा धनुषा च निपात्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2019339, "chapter_id": 1402, "verse_number": "३-४०-१९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2019340, "chapter_id": 1402, "verse_number": "३-४०-१९", "content_sanskrit": "तच्छ्रुत्वा त्वरितः पार्थः शुचिर्भूत्वा समाहितः।\nउपसंगृह्य विश्वेशमधीष्वेत्यथ सोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2019341, "chapter_id": 1402, "verse_number": "३-४०-२०", "content_sanskrit": "ततस्त्वध्यापयामास सरहस्यनिवर्तनम्।\nतदस्त्रं पाण्डवश्रेष्ठं मूर्तिमन्तमिवान्तकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2019342, "chapter_id": 1402, "verse_number": "३-४०-२१", "content_sanskrit": "उपतस्थे महात्मानं यथा त्र्यक्षमुमापतिम्।\nप्रतिजग्राह तच्चापि प्रीतिमानर्जुनस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2019343, "chapter_id": 1402, "verse_number": "३-४०-२२", "content_sanskrit": "ततश्चचाल पृथिवी सपर्वतवनद्रुमा।\nससागरवनोद्देशा सग्रामनगराकरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2019344, "chapter_id": 1402, "verse_number": "३-४०-२३", "content_sanskrit": "शङ्खदुन्दुभिघोषाश्च भेरीणां च सहस्रशः।\nतस्मिनमुहूर्ते संप्राप्ते निर्घातश्च महानभूत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2019345, "chapter_id": 1402, "verse_number": "३-४०-२४", "content_sanskrit": "अथास्त्रं जाज्वलद्धोरं पाण्डवस्यामितौजसः।\nमूर्तिमद्विष्ठितं पार्श्वे ददृशुर्देवदानवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2019346, "chapter_id": 1402, "verse_number": "३-४०-२५", "content_sanskrit": "स्पृष्टस्य त्र्यम्बकेणाथ फल्गुनस्यामितौजसः।\nयत्किं गच्छेत्यनुज्ञातस्त्र्यम्बकेण तदाऽर्जुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2019347, "chapter_id": 1402, "verse_number": "३-४०-२६", "content_sanskrit": "स्वर्गं गच्छेत्यनुज्ञातस्त्र्यम्बकेण तदाऽर्जुनः।\nप्रणम्य शिरसा राजन्प्राञ्जलिर्भवमैक्षत ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2019348, "chapter_id": 1402, "verse_number": "३-४०-२७", "content_sanskrit": "ततः प्रभुस्त्रिदिवनिवासिनां वसी\nमहामतिर्गिरिश उमापतिः शिवः।\nधनुर्महद्दितिजपिशाचसूदनं\nददौ भवः पुरुषवराय गाण्डिवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2019349, "chapter_id": 1402, "verse_number": "३-४०-२८", "content_sanskrit": "ततः शुभं गिरिवरमीश्वरस्तदा\nसहोमयाऽसिततटसानुकन्दरम्।\nविहाय तं पतगमहर्षिसेवितं\nजगाम स्वं पुरुषवरस्य पश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2019350, "chapter_id": 1402, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि कैरातपर्वणि चत्वारिंशोऽध्यायः ॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]