[{"id": 50024120, "chapter_id": 11832, "verse_number": "1", "content_sanskrit": "॥ मधुच्छन्दा वैश्वामित्रः। अग्निः। गायत्री॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024121, "chapter_id": 11832, "verse_number": "2", "content_sanskrit": "अ॒ग्निमी॑ळे पु॒रोहि॑तं य॒ज्ञस्य॑ दे॒वमृ॒त्विज॑म्। होता॑रं रत्न॒धात॑मम्॥ १/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024122, "chapter_id": 11832, "verse_number": "3", "content_sanskrit": "॥ आद्यसूक्ततात्पर्यम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024123, "chapter_id": 11832, "verse_number": "4", "content_sanskrit": "॥ आद्यसूक्तार्थः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024124, "chapter_id": 11832, "verse_number": "5", "content_sanskrit": "अ॒ग्निः पूर्वे॑भि॒रृषि॑भि॒रीड्यो॒ नूत॑नैरु॒त। स दे॒वाँ एह व॑क्षति॥ १/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024125, "chapter_id": 11832, "verse_number": "6", "content_sanskrit": "अ॒ग्निना॑ र॒यिम॑श्नव॒त्पोष॑मे॒व दि॒वेदि॑वे। य॒शसं॑ वी॒रव॑त्तमम्॥ १/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024126, "chapter_id": 11832, "verse_number": "7", "content_sanskrit": "अग्ने॒ यं य॒ज्ञम॑ध्व॒रं वि॒श्वतः॑ परि॒भूरसि॑। स इद्दे॒वेषु॑ गच्छति॥ १/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024127, "chapter_id": 11832, "verse_number": "8", "content_sanskrit": "अ॒ग्निर्होता॑ क॒विक्र॑तुः स॒त्यश्चि॒त्रश्र॑वस्तमः। दे॒वो दे॒वेभि॒रा ग॑मत्॥ १/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50024128, "chapter_id": 11832, "verse_number": "9", "content_sanskrit": "यद॒ङ्ग दा॒शुषे॒ त्वमग्ने॑ भ॒द्रं क॑रि॒ष्यसि॑। तवेत्तत्स॒त्यम॑ङ्गिरः॥ १/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50024129, "chapter_id": 11832, "verse_number": "10", "content_sanskrit": "उप॑ त्वाग्ने दि॒वेदि॑वे॒ दोषा॑वस्तर्धि॒या व॒यम्। नः॑ नमो॒ भर॑न्त॒ एम॑सि॥ १/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50024130, "chapter_id": 11832, "verse_number": "11", "content_sanskrit": "राज॑न्तमध्व॒राणां॑ गो॒पामृ॒तस्य॒ दीदि॑विम्। वर्ध॑मानं॒ स्वे दमे॑॥ १/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50024131, "chapter_id": 11832, "verse_number": "12", "content_sanskrit": "स न॑ः पि॒तेव॑ सू॒नवेऽग्ने॑ सूपाय॒नो भ॑व। सच॑स्वा नः स्व॒स्तये॑॥ १/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50024132, "chapter_id": 11832, "verse_number": "13", "content_sanskrit": "॥ ऋषिच्छन्दोदैवतादिविचारः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50024133, "chapter_id": 11832, "verse_number": "14", "content_sanskrit": "॥ ऋषिविचारः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50024134, "chapter_id": 11832, "verse_number": "15", "content_sanskrit": "॥ छन्दोविचारः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50024135, "chapter_id": 11832, "verse_number": "16", "content_sanskrit": "॥ देवताविचारः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50024136, "chapter_id": 11832, "verse_number": "17", "content_sanskrit": "॥ अत्र प्रमाणानि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50024137, "chapter_id": 11832, "verse_number": "18", "content_sanskrit": "॥ विष्णोरेव सर्वोत्कृष्टत्वे प्रमाणानि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50024138, "chapter_id": 11832, "verse_number": "19", "content_sanskrit": "॥ व्याख्यानप्रकारशिक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50024139, "chapter_id": 11832, "verse_number": "20", "content_sanskrit": "॥ ऋष्यादिविचारोपसंहारः, इत्थम्भावान्तरं च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50024140, "chapter_id": 11832, "verse_number": "21", "content_sanskrit": "॥ आद्यर्क्शतस्य देवता, अवान्तरर्षिश्च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]