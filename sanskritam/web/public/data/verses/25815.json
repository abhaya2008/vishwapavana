[{"id": 7005815000, "chapter_id": 25815, "verse_number": "२८९-१", "content_sanskrit": "महाभूतघटमहादानविधिवर्णनम् ।\nमत्स्य उवाच ।\nअथातः संप्रवक्ष्यामि महादानमनुत्तमम् ।\nमहाभूतघटं नाम महापातकनाशनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005815001, "chapter_id": 25815, "verse_number": "२८९-२", "content_sanskrit": "पुण्यां तिथिमथासाद्य कृत्वा ब्राह्मणवाचनम् ।\nऋत्विग्मण्डपसम्भार भूषणाच्छादनादिकम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005815002, "chapter_id": 25815, "verse_number": "२८९-३", "content_sanskrit": "तुला पुरुषवत् कुर्यात् लोकेशावाहनादिकम् ।\nकारयेत्काञ्चनं कुम्भं महारत्नाचितं बुधः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005815003, "chapter_id": 25815, "verse_number": "२८९-४", "content_sanskrit": "प्रादेशादंगुलशतं यावत् कुर्यात् प्रमाणतः ।\nक्षीराज्यपूरितं तद्वत् कल्पवृक्षसमन्वितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005815004, "chapter_id": 25815, "verse_number": "२८९-५", "content_sanskrit": "पद्मासनगतांस्तत्र ब्रह्मविष्णुमहेश्वरान् ।\nलोकपालान् महेन्द्रांश्च स्वस्ववाहनमास्थितान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005815005, "chapter_id": 25815, "verse_number": "२८९-६", "content_sanskrit": "वराहेणोद्धृतां तद्वत् कुर्यात् पृथ्वीं सपङ्कजाम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005815006, "chapter_id": 25815, "verse_number": "२८९-७", "content_sanskrit": "वरुणंचासनगतं काञ्चनं मकरोपरि ।\nहुताशनं मेषगतं वायुं कृष्णमृगासनम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005815007, "chapter_id": 25815, "verse_number": "२८९-८", "content_sanskrit": "तथा कोशाधिपं कुर्यात् मूषिकस्थं विनायकम् ।\nविन्यस्यघटमध्येतान् वेदपञ्चकसंयुतान् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005815008, "chapter_id": 25815, "verse_number": "२८९-९", "content_sanskrit": "ऋग्वेदस्याक्षसूत्रं स्याद्यजुर्वेदस्य पङ्कजम् ।\nसामवेदस्य वीणास्याद्वेणुं दक्षिणतो न्यसेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005815009, "chapter_id": 25815, "verse_number": "२८९-१०", "content_sanskrit": "अथर्ववेदस्य पुनः स्रुक्स्रुचौ कमलङ्करे ।\nपुराणवेदो वरदः साक्षसूत्र कमण्डलुः ।\nपरितः सर्वधान्यानि चामरासन-दर्पणम् ।\nपादुकोपानहच्छत्रं दीपिका भूषणानि च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005815010, "chapter_id": 25815, "verse_number": "२८९-११", "content_sanskrit": "शय्याञ्च जलकुम्भांश्च पञ्चवर्णं वितानकम् ।\nस्नात्वाधिवासनान्ते तु मन्त्रमेतमुदीरयेत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005815011, "chapter_id": 25815, "verse_number": "२८९-१२", "content_sanskrit": "नमो वः सर्वदेवानामाधारेभ्यश्चराचरे ।\nमहाभूताधिदेवेभ्यः शान्तिरस्तु शिवं मम ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005815012, "chapter_id": 25815, "verse_number": "२८९-१३", "content_sanskrit": "यस्मान्नकिञ्चिदप्यस्ति महाभूतैर्विना कृतम् ।\nब्रह्माण्डे सर्वभूतेषु तस्माच्छ्रीरक्षयास्तु मे ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005815013, "chapter_id": 25815, "verse_number": "२८९-१४", "content_sanskrit": "इत्युच्चार्य महाभूतघटं यो विनिवेदयेत् ।\nसर्वपापविनिर्मुक्तः स याति परमाङ्गतिम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005815014, "chapter_id": 25815, "verse_number": "२८९-१५", "content_sanskrit": "विमानेनार्कवर्णेन पितृबन्धुसमन्वितः ।\nस्तूयमानो वरस्त्रीभिः पदमभ्येति वैष्णवम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005815015, "chapter_id": 25815, "verse_number": "२८९-१६", "content_sanskrit": "षोड़शैतानि यः कुर्यात् महादानानि मानवः ।\nन तस्य पुनरावृत्तिरिह लोकेऽभिजायते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005815016, "chapter_id": 25815, "verse_number": "२८९-१७", "content_sanskrit": "इह पठति य इत्थं वासुदेवस्य पार्श्वे ससुतपितृकलत्रः संश्रृणोतीह सम्यक् ।\nमुररिपुभवने वै मन्दिरे वार्कलक्ष्म्या त्वमरपुरवधूभिर्मोदते सोऽपि नित्यम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]