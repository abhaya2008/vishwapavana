[{"id": 7000850000, "chapter_id": 20850, "verse_number": "६-१९३-१", "content_sanskrit": "पार्वत्युवाच ।\nदेवदेव महादेव सर्वज्ञ सकलार्थद ।\nकृपां मयि परां कृत्वा यत्पृच्छे तद्वदस्व मे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000850001, "chapter_id": 20850, "verse_number": "६-१९३-२", "content_sanskrit": "श्रुतं च गीतामाहात्म्यं बह्वाश्चर्यकथायुतम् ।\nतेन मे भक्तिरुत्पन्ना श्रोतुं कृष्णकथां पराम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000850002, "chapter_id": 20850, "verse_number": "६-१९३-३", "content_sanskrit": "पुराणेषु तु सर्वेषु श्रीमद्भागवतं परम् ।\nयत्र प्रतिपदं कृष्णो गीयते बहुधर्षिभिः ।\nतन्माहात्म्यं यथातत्वं सेतिहासं वदाधुना ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000850003, "chapter_id": 20850, "verse_number": "६-१९३-४", "content_sanskrit": "ईश्वर उवाच ।\nनैमिषे सूतमासीनमभिवाद्य महामतिम् ।\nकथामृतरसास्वादकुशलः शौनकोऽब्रवीत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000850004, "chapter_id": 20850, "verse_number": "६-१९३-५", "content_sanskrit": "शौनक उवाच ।\nअज्ञानध्वांतविध्वंसि कोटिजन्माघनाशनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000850005, "chapter_id": 20850, "verse_number": "६-१९३-६", "content_sanskrit": "श्रीमद्भागवताख्यानं सूताख्याहि रसायनम् ।\nभक्तिज्ञानविरागाढ्यो विवेको वर्द्धते कथम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000850006, "chapter_id": 20850, "verse_number": "६-१९३-७", "content_sanskrit": "माहामोहनिरासश्च वैष्णवैः क्रियते कथम् ।\nइह घोरे कलौप्रायो जीवश्चासुरतां गतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000850007, "chapter_id": 20850, "verse_number": "६-१९३-८", "content_sanskrit": "क्लेशाक्रांतस्य तस्याथ शोधने किं रसायनम् ।\nश्रेयसां यद्भवेच्छ्रेयः पावनानां च पावनम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000850008, "chapter_id": 20850, "verse_number": "६-१९३-९", "content_sanskrit": "कृष्णप्रीतिकरं यच्च साधनं तद्वदाधुना ।\nचिंतामणिं लोकसुखं सुरेंद्रास्पदसंपदम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000850009, "chapter_id": 20850, "verse_number": "६-१९३-१०", "content_sanskrit": "प्रयच्छति गुरुः प्रीतो वैकुंठं चातिदुर्लभम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000850010, "chapter_id": 20850, "verse_number": "६-१९३-११", "content_sanskrit": "सूत उवाच ।\nप्रीतोऽहं ते द्विजश्रेष्ठाः कथयिष्ये यथाश्रुतम् ।\nसारात्सारतरं यच्च संसारभयनाशनम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000850011, "chapter_id": 20850, "verse_number": "६-१९३-१२", "content_sanskrit": "भक्तिप्रवर्द्धकं यच्च कृष्णसंतुष्टिहेतुकम् ।\nतन्मे कथयतः साधो सावधानतया शृणु ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000850012, "chapter_id": 20850, "verse_number": "६-१९३-१३", "content_sanskrit": "कालव्यालमुखालीढ जगत्त्राणविधायकम् ।\nश्रीमद्भागवतं शास्त्रं कलौ कृष्णेन भाषितम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000850013, "chapter_id": 20850, "verse_number": "६-१९३-१४", "content_sanskrit": "एतस्मादपरं किंचिन्मनः शुद्धिकरं नहि ।\nजन्मांतरकृतैः पुण्यैर्लभ्यते साधुभिस्तु तत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000850014, "chapter_id": 20850, "verse_number": "६-१९३-१५", "content_sanskrit": "राज्ञः परीक्षितो मोक्षं ज्ञात्वा कमलसंभवः ।\nतोलयामास शास्त्राणि पुराणानि महांति च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000850015, "chapter_id": 20850, "verse_number": "६-१९३-१६", "content_sanskrit": "श्रीमद्भागवतं तत्र गरीयो भुवि संगतम् ।\nश्रीमद्भागवती वार्ता सुराणामपि दुर्लभा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000850016, "chapter_id": 20850, "verse_number": "६-१९३-१७", "content_sanskrit": "इति संचित्य बहुशो मुनयः साधवोऽमलाः ।\nमेनिरे भगवद्रूपं श्रीमद्भागवतं क्षितौ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000850017, "chapter_id": 20850, "verse_number": "६-१९३-१८", "content_sanskrit": "पठनाच्छ्रवणाद्यस्य नरो याति हरेः पदम् ।\nवर्षेण श्रवणं तस्य बहुसौख्यप्रदायकम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000850018, "chapter_id": 20850, "verse_number": "६-१९३-१९", "content_sanskrit": "मासेन भक्तिराभास्यं लभते द्विजसत्तम ।\nसप्ताहेन श्रुतं चैतत्सर्वथा मुक्तिदायकम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000850019, "chapter_id": 20850, "verse_number": "६-१९३-२०", "content_sanskrit": "किं बहूक्तेन वै साधो श्रीमद्भागवताऽमृतम् ।\nनित्यं सद्भिः प्रपातव्यं कृष्णलीलाप्रकाशकम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000850020, "chapter_id": 20850, "verse_number": "६-१९३-२१", "content_sanskrit": "सनकाद्यैः पुरा प्रोक्तं नारदाय दयापरैः ।\nब्रह्मणः श्रुतपूर्वाय सप्ताहश्रवणे विधिः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000850021, "chapter_id": 20850, "verse_number": "६-१९३-२२", "content_sanskrit": "शौनक उवाच ।\nपितुर्लब्ध्वा वरं ज्ञानं श्रीमद्भागवताभिधम् ।\nनारदो लोकतत्वज्ञः सर्वदा ह्यटते महीम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000850022, "chapter_id": 20850, "verse_number": "६-१९३-२३", "content_sanskrit": "कुत्र तैः संगमो जातो नारदस्य महात्मभिः ।\nश्रुतो देवर्षिणा यत्र सप्ताहश्रवणे विधिः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000850023, "chapter_id": 20850, "verse_number": "६-१९३-२४", "content_sanskrit": "सूत उवाच ।\nअत्र ते वर्णयिष्यामि भक्तियुक्तं कथानकम् ।\nयत्पुरा ब्रह्मरातेन मह्यं प्रोक्तं दयालुना ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000850024, "chapter_id": 20850, "verse_number": "६-१९३-२५", "content_sanskrit": "एकदा तु विशालायामुपविष्टमधोमुखम् ।\nनारदं सनकाद्यास्ते ददृशुर्दीनमानसम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000850025, "chapter_id": 20850, "verse_number": "६-१९३-२६", "content_sanskrit": "तं दृष्ट्वा चिंतयानं तु देवर्षिर्भ्रातरं स्वकम् ।\nपप्रच्छुर्विस्मयाविष्टा मुनयस्तत्वचिंतकाः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000850026, "chapter_id": 20850, "verse_number": "६-१९३-२७", "content_sanskrit": "कुमारा ऊचुः ।\nकिं त्वं चिंतयसे ब्रह्मन्नतिदीन इवातुरः ।\nतवेत्थं मुक्तिसंगस्य नोचितं वद कारणम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000850027, "chapter_id": 20850, "verse_number": "६-१९३-२८", "content_sanskrit": "नारद उवाच ।\nअहं पृथ्व्यां समायातो ज्ञात्वा सर्वोत्तमोत्तमाम् ।\nतीर्थैर्नानाविधैर्युक्तां पुण्यदैः पुण्यरूपिणीम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000850028, "chapter_id": 20850, "verse_number": "६-१९३-२९", "content_sanskrit": "पुष्करे च प्रयागे च काश्यां गोदावरीतटे ।\nहरिक्षेत्रे कुरुक्षेत्रे श्रीरंगे सेतुबंधने ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000850029, "chapter_id": 20850, "verse_number": "६-१९३-३०", "content_sanskrit": "एतेष्वन्येषु तीर्थेषु भ्रममाण इतस्ततः ।\nनापश्यं कुत्रचिच्छर्म मनः संतोषकारकम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000850030, "chapter_id": 20850, "verse_number": "६-१९३-३१", "content_sanskrit": "कलिना धर्ममित्रेण धरेयं बाधिताऽधुना ।\nसत्यं शौचं दया दानं नास्ति कुत्रापि भूतले ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000850031, "chapter_id": 20850, "verse_number": "६-१९३-३२", "content_sanskrit": "उदरंभरिणो लोका वराकाः कूटसाक्षिणः ।\nमंदाः सुमंदमतयो महापाखंडसंश्रयाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000850032, "chapter_id": 20850, "verse_number": "६-१९३-३३", "content_sanskrit": "स्त्रीप्रधानगृहस्थाश्च वर्णिनो व्रतवर्जिताः ।\nवानप्रस्थाः पुरावासा न्यासिनो भोगतत्परा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000850033, "chapter_id": 20850, "verse_number": "६-१९३-३४", "content_sanskrit": "कन्याविक्रयिणो लोभात्कृषिकर्मपरायणाः ।\nभ्रष्टाचारा दंभिनश्च स्वेच्छाचारनिदर्शिनः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000850034, "chapter_id": 20850, "verse_number": "६-१९३-३५", "content_sanskrit": "आश्रमा यवनै रुद्धास्तीर्थानि सरितो ह्रदाः ।\nदेवतायतनान्यत्र दुष्टैरुच्छेदितानि च ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000850035, "chapter_id": 20850, "verse_number": "६-१९३-३६", "content_sanskrit": "योगी सिद्धोऽथवा ज्ञानी सत्क्रियोऽत्र न दृश्यते ।\nकलिदावानलेनाद्य साधनं भस्मतां गतम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000850036, "chapter_id": 20850, "verse_number": "६-१९३-३७", "content_sanskrit": "अट्टशूला जनपदाः शिवशूला द्विजातयः ।\nकामिन्यः केशशूलिन्यो दृश्यंते भुवि सर्वतः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000850037, "chapter_id": 20850, "verse_number": "६-१९३-३८", "content_sanskrit": "एकदाहमनुप्राप्तो यमुनायास्तटं शुभम् ।\nदृष्टं वृंदावनं तत्र यत्र लीला हरेरभूत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000850038, "chapter_id": 20850, "verse_number": "६-१९३-३९", "content_sanskrit": "तत्र यच्चाद्भुतं दृष्टं श्रूयतां तन्मुनीश्वराः ।\nएका तु तरुणी तत्र निषण्णाखिन्नमानसा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000850039, "chapter_id": 20850, "verse_number": "६-१९३-४०", "content_sanskrit": "द्वौ वृद्धौ पतितौ पार्श्वे निःश्वसंतावचेतनौ ।\nशुश्रूषंती प्रबोधंती रुदती च तयोः पुरः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000850040, "chapter_id": 20850, "verse_number": "६-१९३-४१", "content_sanskrit": "दृष्टा दिशो निरीक्षंती रक्षितारमिवात्मनः ।\nवीज्यमाना बहुस्त्रीभिर्बोध्यमाना मुहुर्महुः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000850041, "chapter_id": 20850, "verse_number": "६-१९३-४२", "content_sanskrit": "दृष्ट्वा दूराद्गतश्चाऽहं कौतुकेन तदंतिकम् ।\nमां दृष्ट्वोत्थाय सा बाला वचनं चेदमब्रवीत् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000850042, "chapter_id": 20850, "verse_number": "६-१९३-४३", "content_sanskrit": "बालोवाच ।\nभो साधोऽत्र क्षणं तिष्ठ मम चिंतामपाकुरु ।\nपुंसां च दर्शनं भद्र सर्वाघौघनिवारणम् ।\nपुण्येन प्राक्तनेनैव दर्शनं तव जायते ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000850043, "chapter_id": 20850, "verse_number": "६-१९३-४४", "content_sanskrit": "अतो मे मानसं दुःखं च्छेत्तुमर्हसि मानद ।\nनारद उवाच ।\nएवमुक्तस्तया चाहं कृपया स्निग्धमानसः ।\nअपृच्छंतां वरारोहां कौतुकेन समाकुलः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000850044, "chapter_id": 20850, "verse_number": "६-१९३-४५", "content_sanskrit": "का त्वमेतौ च कौ भद्रे काश्चेमाः पद्मलोचनाः ।\nआख्याहि मत्पुरः सर्वं तव दुःखस्य कारणम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000850045, "chapter_id": 20850, "verse_number": "६-१९३-४६", "content_sanskrit": "इति पृष्टा मया सा तु बाला दुःखितमानसा ।\nप्रोवाच निखिलं दुःखमात्मनो दुःखकारणम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000850046, "chapter_id": 20850, "verse_number": "६-१९३-४७", "content_sanskrit": "बालोवाच ।\nअहं भक्तिरिति ख्याता एतौ मे तनयौ वरौ ।\nज्ञानवैराग्यनामानौ कालयोगेन जर्जरौ ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000850047, "chapter_id": 20850, "verse_number": "६-१९३-४८", "content_sanskrit": "गंगाद्याः सरितश्चेमा मम सेवार्थमागताः ।\nएताभिः सेविता नित्यं सत्कारेणापि नारद ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000850048, "chapter_id": 20850, "verse_number": "६-१९३-४९", "content_sanskrit": "न च श्रेयो लभे किंचित्क्षीणाऽहं सर्वतो मुने ।\nममपूर्वं तु वृत्तातं शृणु ब्राह्मणसत्तम ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000850049, "chapter_id": 20850, "verse_number": "६-१९३-५०", "content_sanskrit": "येनाऽहं दुःखिता जाता न लभे शर्म कुत्रचित् ।\nउत्पन्ना द्रविडे चाहं कर्णाटे वृद्धिमागता ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000850050, "chapter_id": 20850, "verse_number": "६-१९३-५१", "content_sanskrit": "स्थिता किंचिन्महाराष्ट्रे गुर्जरे जीर्णतां गता ।\nतत्र घोरकलेर्योगात्पाखंडैः खंडितांगका ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000850051, "chapter_id": 20850, "verse_number": "६-१९३-५२", "content_sanskrit": "दुर्बलाहं चिरं जाता पुत्राभ्यां सह मंदताम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000850052, "chapter_id": 20850, "verse_number": "६-१९३-५३", "content_sanskrit": "वृंदावनमिदं प्राप्ता दैवयोगेन नारद ।\nजाता हं तु पुनर्बाला नवीनेव सुरूपिणी ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000850053, "chapter_id": 20850, "verse_number": "६-१९३-५४", "content_sanskrit": "इमौ तु शयितावत्र सुतौ मे क्लिष्टमानसौ ।\nअतिवृद्धौ परित्यज्य गंतुं नाहं क्षमाधुना ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000850054, "chapter_id": 20850, "verse_number": "६-१९३-५५", "content_sanskrit": "अहं बाला कथं जाता सुतौ मे जरठौ कुतः ।\nत्रयाणामेकभावानां वैपरीत्यं कुतोऽभवत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000850055, "chapter_id": 20850, "verse_number": "६-१९३-५६", "content_sanskrit": "घटते जरठा माता बालकौ तनयाविति ।\nअतः शोचामि चात्मानं विस्मयाविष्टमानसा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000850056, "chapter_id": 20850, "verse_number": "६-१९३-५७", "content_sanskrit": "यदि त्वं वेत्सि धर्मज्ञ कृपालो दीनपालक ।\nवद सर्वं यथातत्वं कारणं चात्र यद्भवेत् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000850057, "chapter_id": 20850, "verse_number": "६-१९३-५८", "content_sanskrit": "एवं पृष्टस्तया चाहं क्षणं चैव विमृश्य तु ।\nअवोचं भक्तिमाभाष्य क्लिष्टां कालेन भूयसा ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000850058, "chapter_id": 20850, "verse_number": "६-१९३-५९", "content_sanskrit": "ज्ञानेनाहं प्रपश्यामि वृत्तं सर्वं तवानघे ।\nमा विषादं कुरु प्राज्ञे हरिः शं ते करिष्यति ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000850059, "chapter_id": 20850, "verse_number": "६-१९३-६०", "content_sanskrit": "सर्वसत्वहरो बाले युगोऽयं दारुणः कलि ।\nलुप्तोऽनेन सदाऽचारो योगमार्गस्तपांसि च ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000850060, "chapter_id": 20850, "verse_number": "६-१९३-६१", "content_sanskrit": "जनाश्चाघा सुरायंते शाठ्यदुष्कृतकारिणः ।\nसंतो ह्यस्मिन्सुदुःखार्ता असंतो हृष्टमानसाः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000850061, "chapter_id": 20850, "verse_number": "६-१९३-६२", "content_sanskrit": "दृश्यते धीरचित्तस्तु पंडितोऽपि न कोऽपि च ।\nअस्पृश्य नवलोक्येयं दुष्टभाराकुलाधरा ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000850062, "chapter_id": 20850, "verse_number": "६-१९३-६३", "content_sanskrit": "अन्वब्दं क्रमतो जातो मंगलं हीयतेऽन्वहम् ।\nन त्वां तव सुतौ चेमौ कोऽपि पश्यति भामिनि ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000850063, "chapter_id": 20850, "verse_number": "६-१९३-६४", "content_sanskrit": "यूयं तु रागबहुलैस्त्यक्ता जर्जरतां गताः ।\nवृंदावनस्य संयोगाद्बालात्वमभवः पुनः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000850064, "chapter_id": 20850, "verse_number": "६-१९३-६५", "content_sanskrit": "धन्यं वृंदावनं चेदं भक्तिर्यत्राभवन्नवा ।\nअत्रेमौ ग्राहकाभावान्नवीनत्वं न चागतौ ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000850065, "chapter_id": 20850, "verse_number": "६-१९३-६६", "content_sanskrit": "किंचिदात्मसुखेनेह प्रसुप्ताविति लक्ष्यते ।\nभक्तिरुवाच ।\nकथं परिक्षिता राज्ञा स्थापितोद्य शुचिः कलि ।\nदयापरेण हरिणा ह्यधर्मः किमुपेक्षितः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000850066, "chapter_id": 20850, "verse_number": "६-१९३-६७", "content_sanskrit": "एनं मे संशयं छिंधि त्वद्वाचा सुखितास्म्यहम् ।\nतस्या वचः समाकर्ण्य भूयोऽहमवदं द्विजाः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000850067, "chapter_id": 20850, "verse_number": "६-१९३-६८", "content_sanskrit": "यदि पृष्टस्त्वया बाले प्रेमतः श्रवणं कुरु ।\nयदा मुकुंदो भगवान्क्ष्मां त्यक्त्वा स्वपदं गतः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000850068, "chapter_id": 20850, "verse_number": "६-१९३-६९", "content_sanskrit": "कलिस्तद्दिनमारभ्य प्रवृत्तः सत्यबाधकः ।\nदृष्टो दिग्विजये राज्ञा दीनवच्छरणं गतः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000850069, "chapter_id": 20850, "verse_number": "६-१९३-७०", "content_sanskrit": "न हतोऽस्य गुणद्रष्टा सर्वसाधारणं त्विदम् ।\nयत्फलं तपसा नैति न योगे न समाधिना ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000850070, "chapter_id": 20850, "verse_number": "६-१९३-७१", "content_sanskrit": "तत्फलं लभते धीमान्कलौ केशवकीर्तनात् ।\nएतादृशं कलिं दृष्ट्वा सारात्सारफलप्रदम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000850071, "chapter_id": 20850, "verse_number": "६-१९३-७२", "content_sanskrit": "विष्णुरातः स्थापितवान्कलिजानां हिताय च ।\nकुकर्माचरणात्सारः सर्वतो निर्गतोऽधुना ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000850072, "chapter_id": 20850, "verse_number": "६-१९३-७३", "content_sanskrit": "पदार्थाः संस्थिता भूमौ बीजहीनास्तुषा यथा ।\nविप्रैर्भागवतीवार्त्ता गेहे गेहे जने जने ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000850073, "chapter_id": 20850, "verse_number": "६-१९३-७४", "content_sanskrit": "कारिता धनलोभेन कथासारस्ततो गतः ।\nअत्युग्रभूरिकर्माणो नास्तिका दांभिका जनाः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000850074, "chapter_id": 20850, "verse_number": "६-१९३-७५", "content_sanskrit": "तिष्ठंति सर्वतीर्थेषु तीर्थसारस्ततो गतः ।\nकामक्रोधमहालोभतृष्णाव्याकुलचेतसः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000850075, "chapter_id": 20850, "verse_number": "६-१९३-७६", "content_sanskrit": "समारभंते कर्माणि कर्मसारस्ततो गतः ।\nमनसश्चाजयाल्लोभाद्दंभात्पाखंडसंश्रयात् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000850076, "chapter_id": 20850, "verse_number": "६-१९३-७७", "content_sanskrit": "शास्त्रानभ्यसनाच्चैव ध्यानयोगफलं गतम् ।\nपंडितास्ते कलत्रेषु रमंते महिषा इव ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000850077, "chapter_id": 20850, "verse_number": "६-१९३-७८", "content_sanskrit": "पुत्रोत्पादनदक्षाश्च न दक्षा मुक्तिसाधने ।\nन हि वैष्णवता कुत्र संप्रदायपुरःसराः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000850078, "chapter_id": 20850, "verse_number": "६-१९३-७९", "content_sanskrit": "देवनिंदापराः सर्वे साधुनिंदापरायणाः ।\nअयं तु युगधर्मोऽस्ति दीयते कस्य दूषणम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000850079, "chapter_id": 20850, "verse_number": "६-१९३-८०", "content_sanskrit": "अतस्त्वं पुंडरीकाक्षं स्मृत्वा सौख्यमवाप्स्यसि ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000850080, "chapter_id": 20850, "verse_number": "६-१९३-८१", "content_sanskrit": "एवं मयोक्तं वचनं श्रुत्वा सा विस्मयं गता ।\nउवाच वचनं भूयो मां प्रशस्य द्विजोत्तमाः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000850081, "chapter_id": 20850, "verse_number": "६-१९३-८२", "content_sanskrit": "भक्तिरुवाच ।\nदेवर्षे त्वं तु धन्योऽसि मद्भाग्येन समागतः ।\nसाधूनां दर्शनं लोके सर्वसिद्धिप्रदायकम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000850082, "chapter_id": 20850, "verse_number": "६-१९३-८३", "content_sanskrit": "सुखोपायो यथा मे स्यात्तथादिश मुनेऽधुना ।\nसर्वज्ञस्य तव ब्रह्मन्न साध्यं किमपीह वै ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000850083, "chapter_id": 20850, "verse_number": "६-१९३-८४", "content_sanskrit": "अजयदजितमायां यस्य कायाधवस्ते वचनरचनमेकं केवलं चाकलय्य ।\nध्रुवपदमुपयातो यत्कृपातो ध्रुवो वै तमहमरणभूतं ब्रह्मपुत्रं नतास्मि ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}]