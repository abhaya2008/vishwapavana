[{"id": 2207062, "chapter_id": 5414, "verse_number": "", "content_sanskrit": "संवर्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2207063, "chapter_id": 5414, "verse_number": "१", "content_sanskrit": "मेरौ हिमवतः पृष्ठे मुञ्जवान् नाम पर्वतः ।\nतप्यते तत्र भगवान् तपो नित्यमुमापतिः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2207064, "chapter_id": 5414, "verse_number": "२", "content_sanskrit": "वनस्पतीनां मूलेषु शृङ्गेषु शिखरेषु च ।\nगुहासु शैलराजस्य यथाकामं यथासुखम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2207065, "chapter_id": 5414, "verse_number": "३", "content_sanskrit": "उमासहायो भगवान् यत्र नित्यं महेश्वरः ।\nआस्ते शूली महातेजा नानाभूतसमावृतः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2207066, "chapter_id": 5414, "verse_number": "४", "content_sanskrit": "तत्र रुद्राश्च साध्याश्च विश्वे च वसवस्तथा ।\nयमश्च वरुणश्चैव कुबेरश्च सहानुगः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2207067, "chapter_id": 5414, "verse_number": "५", "content_sanskrit": "भूतानि च पिशाचाश्च नासत्यावपि चाश्विनौ ।\nगन्धर्वाप्सरसश्चैव यक्षा देवर्षयस्तथा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2207068, "chapter_id": 5414, "verse_number": "६", "content_sanskrit": "आदित्या मरुतश्चैव यातुधानाश्च सर्वशः ।\nउपासते महात्मानं बहुरूपमुमापतिम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2207069, "chapter_id": 5414, "verse_number": "७", "content_sanskrit": "रमते भगवांस्तत्र कुबेरानुचरैः सह ।\nविकृतैर्विकृताकारैः क्रीडद्भिः पृथिवीपते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2207070, "chapter_id": 5414, "verse_number": "८", "content_sanskrit": "श्रिया ज्वलन् दृश्यते वै बालादित्यसमद्युतिः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2207071, "chapter_id": 5414, "verse_number": "९", "content_sanskrit": "न रूपं दृश्यते तस्य संस्थानं वा कथञ्चन ।\nनिर्देष्टुं प्राणिभिः कैश्चित् प्राकृतैर्मांसलोचनैः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2207072, "chapter_id": 5414, "verse_number": "१०", "content_sanskrit": "नोष्णं न शिशिरं तत्र न वायुर्न च भास्करः ।\nन जरा क्षुत्पिपासे वा न मृत्युर्न भयं नृप\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2207073, "chapter_id": 5414, "verse_number": "११", "content_sanskrit": "तस्य शैलस्य पार्श्वेषु सर्वेषु जयतां वर ।\nधातवो जातरूपस्य रश्मयः सवितुर्यथा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2207074, "chapter_id": 5414, "verse_number": "१२", "content_sanskrit": "रक्ष्यन्ते ते कुबेरस्य सहायैरुद्यतायुधैः ।\nचिकीर्षद्भिः प्रियं राजन् कुबेरस्य महात्मनः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2207075, "chapter_id": 5414, "verse_number": "१३", "content_sanskrit": "तत्र गत्वा त्वमन्वास्य महायोगेश्वरं शिवम् ।\nकुरु प्रणामं राजर्षे भक्त्या परमया युतः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2207076, "chapter_id": 5414, "verse_number": "१४", "content_sanskrit": "तस्मै भगवते कृत्वा नमः शर्वाय वेधसे ।\nएभिस्तं नामभिर्देवं सर्वविद्याधरं स्तुहि\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2207077, "chapter_id": 5414, "verse_number": "१५", "content_sanskrit": "रुद्राय शितिकण्ठाय सुरूपाय सुवर्चसे ।\nकपर्दिने करालाय हर्यक्षवरदाय च\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2207078, "chapter_id": 5414, "verse_number": "१६", "content_sanskrit": "त्र्यक्ष्णे पूष्णो दन्तभिदे वामनाय शिवाय च ।\nयाम्यायाव्यक्तकेशाय शर्वाणीशङ्करस्य च\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2207079, "chapter_id": 5414, "verse_number": "१७", "content_sanskrit": "क्षेम्याय हरिनेत्राय स्थाणवे पुरुषाय च ।\nहरिकेशाय मुण्डाय क्रोधायोत्तरणाय च\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2207080, "chapter_id": 5414, "verse_number": "१८", "content_sanskrit": "भास्वराय सुतीर्थाय देवदेवाय रंहसे ।\nउष्णीषिणे सुवक्त्राय सहस्राक्षाय मीढुषे\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2207081, "chapter_id": 5414, "verse_number": "१९", "content_sanskrit": "गिरिशाय प्रशान्ताय यतये चीरवाससे ।\nबिल्वदण्डाय सिद्धाय सर्वदण्डधराय च\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2207082, "chapter_id": 5414, "verse_number": "२०", "content_sanskrit": "मृगव्याधाय महते धन्विने च भवाय च ।\nपराय सौम्यवक्त्राय स्रुवहस्ताय वर्षिणे\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2207083, "chapter_id": 5414, "verse_number": "२१", "content_sanskrit": "हिरण्यबाहवे राजन् उग्राय पतये दिशाम् ।\nपशूनां पतये चैव भूतानां पतये नमः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2207084, "chapter_id": 5414, "verse_number": "२२", "content_sanskrit": "वृषाय मातृभक्ताय सेनान्यै मध्यमाय च\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2207085, "chapter_id": 5414, "verse_number": "२३", "content_sanskrit": "अभिवक्त्राय पतये सर्वदेवमयाय च ।\nअजाय कृष्णनेत्राय विरूपाक्षाय चैव ह\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2207086, "chapter_id": 5414, "verse_number": "२४", "content_sanskrit": "तीक्ष्णदंष्ट्राय तीक्ष्णाय वैश्वानरमुखाय च ।\nमहाद्युतेरनङ्गस्य सर्वकायप्रमाथिने\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2207087, "chapter_id": 5414, "verse_number": "२५", "content_sanskrit": "तदा रुद्राधिपतये पृथवे कृत्तिवाससे ।\nकपालमालिने नित्यं सुवर्णमकुटाय च\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2207088, "chapter_id": 5414, "verse_number": "२६", "content_sanskrit": "महादेवाय कृष्णाय त्र्यम्बकायानघाय च\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2207089, "chapter_id": 5414, "verse_number": "२७", "content_sanskrit": "क्रोधनायानृशंसाय मृत्यवे बाहुशालिने ।\nदण्डिने दृप्ततपसे तथैवाक्रूरकर्मणे\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2207090, "chapter_id": 5414, "verse_number": "२८", "content_sanskrit": "सहस्रशिरसे चैव सहस्रचरणाय च ।\nविरूपाय सुरूपाय बहुरूपाय दंष्ट्रिणे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2207091, "chapter_id": 5414, "verse_number": "२९", "content_sanskrit": "पिनाकिनं महादेवं महाभोगिनमव्ययम् ।\nत्रिशूलपाणिं वरदं त्र्यम्बकं भुवनेश्वरम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2207092, "chapter_id": 5414, "verse_number": "३०", "content_sanskrit": "त्रिपुरघ्नं त्रिनयनं त्रिलोकेशं महौजसम् ।\nप्रभवं सर्वभूतानां धातारं धरणीधरम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2207093, "chapter_id": 5414, "verse_number": "३१", "content_sanskrit": "ईशानं शङ्करं सर्वं शिवं विश्वेश्वरं भवम् ।\nउमापतिं पशुपतिं विश्वरूपं महेश्वरम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2207094, "chapter_id": 5414, "verse_number": "३२", "content_sanskrit": "विरूपाक्षं दशभुजं विष्यन्दं गोवृषध्वजम् ।\nउग्रं स्थाणुं शिवं घोरं शर्वं गौरीशमीश्वरम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2207095, "chapter_id": 5414, "verse_number": "३३", "content_sanskrit": "शितिकण्ठमजं शुभ्रं पृथुं पृथुहरं शिवम् ।\nविश्वरूपं विरूपाक्षं बहुरूपमुमापतिम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2207096, "chapter_id": 5414, "verse_number": "३४", "content_sanskrit": "प्रणम्य शिरसा देवमनङ्गाङ्गहरं हरम् ।\nशरण्यं शरणं यामि महादेवं चतुर्मुखम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2207097, "chapter_id": 5414, "verse_number": "३५", "content_sanskrit": "विरोचमानं वपुषा दिव्याभरणभूषितम् ।\nअनाद्यन्तमजं शम्भुं सर्वव्यापिनमीश्वरम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2207098, "chapter_id": 5414, "verse_number": "३६", "content_sanskrit": "निस्त्रैगुण्यं निरुद्वेगं निर्मलं निधिमोजसम् ।\nप्रणम्य प्राञ्जलिः शर्वं प्रयामि शरणं हरम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2207099, "chapter_id": 5414, "verse_number": "३७", "content_sanskrit": "सम्मान्यं निश्चलं नित्यम् अकारणमलेपनम् ।\nअध्यात्मवेदमासाद्य व्रजामि शरणं मुहुः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2207100, "chapter_id": 5414, "verse_number": "३८", "content_sanskrit": "यस्य नित्यं विदुः स्थानं मोक्षम् अध्यात्मचिन्तकाः ।\nयोगिनस्तत्वमार्गस्थाः कैवल्यं पदमक्षरम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2207101, "chapter_id": 5414, "verse_number": "३९", "content_sanskrit": "यं विदुः सङ्गनिर्मुक्ताः सामान्यं समदर्शिनः ।\nतं प्रपद्ये जगद्योनिम् अयोनिं निर्गुणात्मकम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2207102, "chapter_id": 5414, "verse_number": "४०", "content_sanskrit": "असृजद् यस्तु भूरादीन् सप्त लोकान् सनातनान् ।\nस्थितः सत्योपरि स्थाणुं तं प्रपद्ये सनातनम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2207103, "chapter_id": 5414, "verse_number": "४१", "content_sanskrit": "भक्तानां सुलभं तं हि दुर्लभं दूरपातिनाम् ।\nअदूरस्थममुं देवं प्रकृतेः परतः स्थितम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2207104, "chapter_id": 5414, "verse_number": "४२", "content_sanskrit": "नमामि सर्वलोकस्थं व्रजामि शरणं शिवम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2207105, "chapter_id": 5414, "verse_number": "४३", "content_sanskrit": "एवं कृत्वा नमस्तस्मै महादेवाय शम्भवे ।\nमहात्मने क्षितिपते तत् सुवर्णमवाप्स्यसि\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2207106, "chapter_id": 5414, "verse_number": "४४", "content_sanskrit": "लभन्ते गाणपत्यं च तदेकाग्रा हि मानवाः ।\nकिं पुनः स्वर्णभाण्डानि तस्मात् त्वं गच्छ मा चिरम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2207107, "chapter_id": 5414, "verse_number": "४५", "content_sanskrit": "महत्तरं हि ते लाभं हस्त्यश्वोष्ट्रादिभिः सह ।\nसुवर्णमाहरिष्यन्तः तत्र गच्छन्तु ते नराः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2207108, "chapter_id": 5414, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2207109, "chapter_id": 5414, "verse_number": "४६", "content_sanskrit": "इत्युक्तस्तु वचस्तस्य चक्रे कारन्धमात्मजः ।\nगङ्गाधरं नमस्कृत्य लब्धवान् धनमुत्तमम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2207110, "chapter_id": 5414, "verse_number": "४७", "content_sanskrit": "कुबेर इव तत् प्राप्य महादेवप्रसादतः ।\nततोऽतिमानुषं सर्वं चक्रे यज्ञस्य संविधिम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2207111, "chapter_id": 5414, "verse_number": "४८", "content_sanskrit": "सौवर्णानि च भाण्डानि सञ्चक्रुस्तस्य शिल्पिनः ।\nशालाश्च सर्वसम्भारान् कृतो संवर्तशासनात्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2207112, "chapter_id": 5414, "verse_number": "४९", "content_sanskrit": "बृहस्पतिस्तु तां श्रुत्वा मरुत्तस्य महीपतेः ।\nसमृद्धिमिति देवेभ्यः सन्तापमकरोद् भृशम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2207113, "chapter_id": 5414, "verse_number": "५०", "content_sanskrit": "सन्तप्यमानो वैवर्ण्यं कृशत्वं चागमत् परम् ।\nभविष्यति हि मे शत्रुः संवर्तो वसुमानिति\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2207114, "chapter_id": 5414, "verse_number": "५१", "content_sanskrit": "तं श्रुत्वा भृशसन्तप्तं देवराजो बृहस्पतिम् ।\nअभिगम्यामरवृतः प्रोवाचेदं वचस्तदा\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2207115, "chapter_id": 5414, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्याम् आश्वमेधिकपर्वणि मरुत्तस्य वित्तानयनं नाम अष्टमोऽध्यायः ॥८॥\nअश्वमेधपर्वणि अष्टमोऽध्यायः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]