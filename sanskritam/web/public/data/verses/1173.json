[{"id": 2008914, "chapter_id": 1173, "verse_number": "१-१७४-०x", "content_sanskrit": "कुन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2008915, "chapter_id": 1173, "verse_number": "१-१७४-१", "content_sanskrit": "कुतोमूलमिदं दुःखं ज्ञातुमिच्छामि तत्त्वतः।\nविदित्वाप्यपकर्षेयं शक्यं चेदपकर्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2008916, "chapter_id": 1173, "verse_number": "१-१७४-२x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2008917, "chapter_id": 1173, "verse_number": "१-१७४-२", "content_sanskrit": "उपपन्नं सतामेतद्यद्ब्रवीपि तपोधने।\nन तु दुःखमिदं शक्यं मानुषेण व्यपोहितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2008918, "chapter_id": 1173, "verse_number": "१-१७४-३", "content_sanskrit": "तथापि तत्त्वमाख्यास्ये दुःखस्यैतस्य संभवम्।\nशक्यं वा यदि वाऽशक्यं शृणु भद्रे यथातथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2008919, "chapter_id": 1173, "verse_number": "१-१७४-४", "content_sanskrit": "समीपे नगरस्यास्य वको वसति राक्षसः।\nइतो गव्यूतिमात्रे।ञस्ति यमुनागह्वरे गुहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2008920, "chapter_id": 1173, "verse_number": "१-१७४-५", "content_sanskrit": "तस्यां घोरः स वसति जिघांसुः पुरुषादकः।\nबकाभिधानो दुष्टात्मा राक्षसानां कुलाधमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2008921, "chapter_id": 1173, "verse_number": "१-१७४-६", "content_sanskrit": "ईशो जनपदस्यास्य पुरस्य च महाबलः।\nपुष्टो मानुषमांसेन दुर्बुद्धिः पुरुषादकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2008922, "chapter_id": 1173, "verse_number": "१-१७४-७", "content_sanskrit": "प्रबलः कामरूपी च राक्षसस्तु महाबलः।\nतेनोपसृष्टा नगरी वर्षमद्य त्रयोदशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2008923, "chapter_id": 1173, "verse_number": "१-१७४-८", "content_sanskrit": "तत्कृते परचक्राच्च भूतेभ्यश्च न नो भयम्।\nपुरुषादेन रौद्रेण भक्ष्यमाणा दुरात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2008924, "chapter_id": 1173, "verse_number": "१-१७४-९", "content_sanskrit": "अनाथा नगरी नाथं त्रातारं नाधिगच्छति।\nगुहायां च वसंस्तत्र बाधते सततं जनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2008925, "chapter_id": 1173, "verse_number": "१-१७४-१०", "content_sanskrit": "स्त्रियो बालांश्च वृद्धांश्च यूनश्चापि दुरात्मवान्।\nअत्र मन्त्रैश्च होमैश्च भोजनैश्च स राक्षसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2008926, "chapter_id": 1173, "verse_number": "१-१७४-११", "content_sanskrit": "ईडितो द्विजमुख्यैश्च पूजितश्च दुरात्मवान्।\nयदा च सकलानेवं प्रसूदयति राक्षसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2008927, "chapter_id": 1173, "verse_number": "१-१७४-१२", "content_sanskrit": "अथैनं ब्राह्मणाः सर्वे समये समयोजयन्।\nमा स्म कामाद्वधी रक्षो दास्यामस्ते सदा वयं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2008928, "chapter_id": 1173, "verse_number": "१-१७४-१३", "content_sanskrit": "पर्यायेण यथाकाममिह मांसोदनं प्रभो।\nअन्नं मांससमायुक्तं तिलचूर्णसमन्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2008929, "chapter_id": 1173, "verse_number": "१-१७४-१४", "content_sanskrit": "सर्पिषा च समायुक्तं व्यञ्जनैश्च समन्वितम्।\nसूपांस्त्रीन्सतिलान्पिण्डाँल्लाजापूपसुरासवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2008930, "chapter_id": 1173, "verse_number": "१-१७४-१५", "content_sanskrit": "शृताशृतान्पानकुम्भान्स्थूलमांसं शृताशृतम्।\nवनमाहिषवाराहभाल्लूकं च शृताशृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2008931, "chapter_id": 1173, "verse_number": "१-१७४-१६", "content_sanskrit": "सर्पिःकुम्भांश्च विविधान्दधिकुम्भांस्तथा बहून्।\nसद्यःसिद्धसमायुक्तं तिलचूर्णैः समाकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2008932, "chapter_id": 1173, "verse_number": "१-१७४-१७", "content_sanskrit": "कुलाच्च पुरुषं चैकं बलीवर्दौ च कालकौ।\nप्राप्स्यसि त्वमसंक्रुद्धो रक्षोभागं प्रकल्पितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2008933, "chapter_id": 1173, "verse_number": "१-१७४-१८", "content_sanskrit": "तिष्ठेह समयेऽस्माकमित्ययाचन्त तं द्विजाः।\nबाढमित्येव तद्रक्षस्तद्वचः प्रत्यगृह्णत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2008934, "chapter_id": 1173, "verse_number": "१-१७४-१९", "content_sanskrit": "परचक्राटवीकेभ्यो रक्षणं स करोति च।\nतस्मिन्भागे सुनिर्दिष्टे स्थितः स समये बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2008935, "chapter_id": 1173, "verse_number": "१-१७४-२०", "content_sanskrit": "एकैकं चैव पुरुषं संप्रयच्छन्ति वेतनम्।\nस वारो बहुभिर्वर्षैर्भवत्यसुकरो नरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2008936, "chapter_id": 1173, "verse_number": "१-१७४-२१", "content_sanskrit": "तद्विमोक्षाय ये केचिद्यतन्ते पुरुषाः क्वचित्।\nसपुत्रदारांस्तान्हत्वा तद्रक्षो भक्षयत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2008937, "chapter_id": 1173, "verse_number": "१-१७४-२२", "content_sanskrit": "वेत्रकीयगृहे राजा नायं नयमिहास्थितः।\nउपायं तं न कुरुते यत्नादपि स मन्दधीः।\nअनामयं जनस्यास्य येन स्यादद्य शाश्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2008938, "chapter_id": 1173, "verse_number": "१-१७४-२३", "content_sanskrit": "एतदर्हा वचं नूनं वसामो दुर्बलस्य ये।\nविषये नित्यवास्तव्याः कुराजानमुपाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2008939, "chapter_id": 1173, "verse_number": "१-१७४-२४", "content_sanskrit": "ब्राह्मणाः कस्य वक्तव्याः कस्य वाच्छन्दचारिणः।\nगुणैरेते हि वत्स्यन्ति कामगाः पक्षिणो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2008940, "chapter_id": 1173, "verse_number": "१-१७४-२५", "content_sanskrit": "राजानं प्रथमं विन्देत्ततो भार्यां ततो धनम्।\nराजन्यसति लोकेऽस्मिन्कुतो भार्या कुतो धनम्।\nवयस्य संचयेनास्य ज्ञातीन्पुत्रांश्च तारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2008941, "chapter_id": 1173, "verse_number": "१-१७४-२६", "content_sanskrit": "विपीरतं मया चेदं त्रयं सर्वमुपार्जितम्।\nतदिमामापदं प्राप्य भृशं तप्यामहे वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2008942, "chapter_id": 1173, "verse_number": "१-१७४-२७", "content_sanskrit": "सोऽयमस्माननुप्राप्तो वारः कुलविनाशनः।\nभोजनं पुरुषश्चैकः प्रदेयं वेतनं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2008943, "chapter_id": 1173, "verse_number": "१-१७४-२८", "content_sanskrit": "न च मे विद्यते वित्तं संक्रेतुं पुरुषं क्वचित्।\nसुहृज्जनं प्रदातुं च न शक्ष्यामि कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2008944, "chapter_id": 1173, "verse_number": "१-१७४-२९", "content_sanskrit": "गतिं चान्यां न पश्यामि तस्मान्मोक्षाय रक्षसः।\nसोऽहं दुःखार्णवे मग्नो महत्यसुकरे भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2008945, "chapter_id": 1173, "verse_number": "१-१७४-३०", "content_sanskrit": "सहैवैतैर्गमिष्यामि बान्धवैरद्य राक्षसम्।\nततो नः सहितान्क्षुद्रः सर्वानेवोपभोक्ष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2008946, "chapter_id": 1173, "verse_number": "१-१७४-३१", "content_sanskrit": "दुःखमूलमिदं भद्रे मयोक्तं प्रश्नतोऽनघे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2008947, "chapter_id": 1173, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिप्रवणि बकवधपर्वणि चतुःसप्तत्यधिकशततमोऽध्यायः॥ १७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]