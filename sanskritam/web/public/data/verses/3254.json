[{"id": 2104471, "chapter_id": 3254, "verse_number": "१४-११०-१", "content_sanskrit": "युधिष्ठिर उवाच।\nसमुच्चयं च धर्माणां भोज्याभोज्यं तथैव च।\nश्रुतं मया त्वत्प्रसादादापद्धर्मं ब्रवीहि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2104472, "chapter_id": 3254, "verse_number": "१४-११०-२x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2104473, "chapter_id": 3254, "verse_number": "१४-११०-२", "content_sanskrit": "दुर्भिक्षे राष्ट्रसंबाधेऽप्याशौचे मृतसूतके।\nधर्मकालेऽध्वनि तथा नियमो येन लुप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2104474, "chapter_id": 3254, "verse_number": "१४-११०-३", "content_sanskrit": "दूराध्वगमनात्खिन्नो द्विजालाभेऽथ शूद्रतः।\nअकृतन्नं तु यत्किंचिद्गृह्णीयादात्मवृत्तये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2104475, "chapter_id": 3254, "verse_number": "१४-११०-४", "content_sanskrit": "आतुरो दुःखितो वाऽपि तथाऽऽर्तो वा बुभुक्षितः।\nभुञ्जन्नविधिना विप्रः प्रायश्चित्तीयते न च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2104476, "chapter_id": 3254, "verse_number": "१४-११०-५", "content_sanskrit": "निमन्त्रितस्तु यो विप्रो विदिवद्धव्यकव्ययोः।\nमांसादीन्यपि भुञ्जानः प्रायश्चित्तीयते न च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2104477, "chapter_id": 3254, "verse_number": "१४-११०-६", "content_sanskrit": "अष्टौ तान्यव्रतघ्नानि आपो मूलं घृतं पयः।\nहविर्ब्राह्मणकाम्या च गुरोर्वचनमौषधम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2104478, "chapter_id": 3254, "verse_number": "१४-११०-७", "content_sanskrit": "अशक्तो विधिवत्कर्तुं प्रायश्चित्तानि यो नरः।\nविदुषां वचनेनापि दानेनापि विशुद्ध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2104479, "chapter_id": 3254, "verse_number": "१४-११०-८", "content_sanskrit": "अनृतावृतुकाले वा दिवा रात्रौ तथाऽपि वा।\nप्रोषितस्तु स्त्रियं गच्छेत्प्रायश्चित्तीयते न च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2104480, "chapter_id": 3254, "verse_number": "१४-११०-९x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2104481, "chapter_id": 3254, "verse_number": "१४-११०-९", "content_sanskrit": "प्रशस्याः कीदृशा विप्रा निन्द्याश्चापि सुरेश्वर।\nअष्टकायाश्च कः कालस्तन्मे कथय सुव्रत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2104482, "chapter_id": 3254, "verse_number": "१४-११०-१०x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2104483, "chapter_id": 3254, "verse_number": "१४-११०-१०", "content_sanskrit": "सत्यसन्धं द्विजं दृष्ट्वा स्थानाद्वेपति भास्करः।\nएष मे मण्डलं भित्त्वा याति ब्रह्म सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2104484, "chapter_id": 3254, "verse_number": "१४-११०-११", "content_sanskrit": "कुलीनः कर्मकृद्वैद्यस्तथा चाप्यानृशंस्यवान्।\nश्रीमानृजउः सत्यवादी पात्रं सर्व इमे द्विजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2104485, "chapter_id": 3254, "verse_number": "१४-११०-१२", "content_sanskrit": "एते चाग्रासनस्थास्ते भुञ्जानाः प्रथमं द्विजाः।\nतस्यां पङ्क्त्यां तु ये वान्ये तान्पुनत्येव दर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2104486, "chapter_id": 3254, "verse_number": "१४-११०-१३", "content_sanskrit": "मद्भक्ता ये द्विजश्रेष्ठा मद्भक्ता मत्परायणाः।\nतान्पङ्क्तिपावनान्विद्धि पूज्यांश्चैव विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2104487, "chapter_id": 3254, "verse_number": "१४-११०-१४", "content_sanskrit": "निन्द्याञ्शृणु द्विजान्राजन्नपि वा वेदपारगान्।\nब्राह्मणच्छद्मना लोके चरतः पापकारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2104488, "chapter_id": 3254, "verse_number": "१४-११०-१५", "content_sanskrit": "अनग्निरनधीयानः प्रतिग्रहरुचिस्तु यः।\nयतस्ततस्तु भुञ्जानस्तं विद्याद्ब्रह्मदूषकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2104489, "chapter_id": 3254, "verse_number": "१४-११०-१६", "content_sanskrit": "मृतसूतकपुष्टाङ्गो यश्च शूद्रान्नभुग्द्विजः।\nअहं चापि न जानामि गतिं तस्य नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2104490, "chapter_id": 3254, "verse_number": "१४-११०-१७", "content_sanskrit": "शूद्रान्नरसपुष्टाङ्गोऽप्यधीयानो हि नित्यशः।\nजपतो जुह्वतो वाऽपि गतिरूर्ध्वं न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2104491, "chapter_id": 3254, "verse_number": "१४-११०-१८", "content_sanskrit": "आहिताग्निश्च यो विप्रः शूद्रान्नान्न निवर्तते।\nपञ्च तस्य प्रणश्यन्ति आत्मा ब्रह्म त्रयोऽग्नयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2104492, "chapter_id": 3254, "verse_number": "१४-११०-१९", "content_sanskrit": "शूद्रप्रेषणकर्तुश्च ब्राह्मणस्य विशेषतः।\nभूमावन्नं प्रदातव्यं श्वसृगालसमो हि सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2104493, "chapter_id": 3254, "verse_number": "१४-११०-२०", "content_sanskrit": "प्रेतभूतं तु यः शूद्रं ब्राह्ममो ज्ञानदुर्बलः॥\nअनुगच्छेन्नीयमानं त्रिरात्रमशुचिर्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2104494, "chapter_id": 3254, "verse_number": "१४-११०-२१", "content_sanskrit": "त्रिरात्रे तु ततः पूर्णे नदीं गत्वा समुद्रगाम्।\nप्राणायामशतं कृत्वा घृतं प्राश्य विशुद्ध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2104495, "chapter_id": 3254, "verse_number": "१४-११०-२२", "content_sanskrit": "अनाथं ब्राह्मणं प्रेतं ये वहन्ति द्विजोत्तमाः।\nपदेपदेऽश्वमेधस्य फलं ते प्राप्नुवन्ति हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2104496, "chapter_id": 3254, "verse_number": "१४-११०-२३", "content_sanskrit": "न तेषामशुभं किंचित्पापं वा शुभकर्मणाम्।\nजलावगाहनादेव सद्यः शौचं विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2104497, "chapter_id": 3254, "verse_number": "१४-११०-२४", "content_sanskrit": "शूद्रवेश्मनि विप्रेणि क्षीरं वा यदि वा दधि।\nनिवृत्तेन न भोक्तव्यं विद्धि शूद्रान्नमेव तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2104498, "chapter_id": 3254, "verse_number": "१४-११०-२५", "content_sanskrit": "विप्राणां भोक्तुकामानामत्यन्तं चान्नकाङ्क्षिणाम्।\nयो विघ्नं कुरुते मर्त्यस्ततो नान्योस्ति पापकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2104499, "chapter_id": 3254, "verse_number": "१४-११०-२६", "content_sanskrit": "सर्वे च वेदाः सहषङ्भिरङ्गैः\nसाङ्ख्यं पुराणं च कुले च जन्म।\nनैतानि सर्वाणि गतिर्भवन्ति\nशीलव्यपेतस्य नृप द्विजस्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2104500, "chapter_id": 3254, "verse_number": "१४-११०-२७", "content_sanskrit": "ग्रहोपरागे विषुवेऽयनान्ते\nपित्र्ये मघासु स्वसुते च जाते।\nगयेषु पिण्डेषु च पाण्डुपुत्र\nदत्तं भवेन्निष्कसहस्रतुल्यम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2104501, "chapter_id": 3254, "verse_number": "१४-११०-२८", "content_sanskrit": "वैशाखमासस्य तु या तृतीयाऽ-\nनवद्याऽसौ कार्तिकशुक्लपक्षे।\nनभस्यमासस्य च कृष्णपक्षे\nत्रयोदशी पञ्चदशी न माघे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2104502, "chapter_id": 3254, "verse_number": "१४-११०-२९", "content_sanskrit": "उपप्लवे चन्द्रमसो रवेश्च\nश्राद्धस्य कालो ह्ययनद्वये च।\nपानीयमप्यत्रि तिलैर्विमिश्रं\nदद्यात्पितृभ्यः प्रयतो मनुष्यः।\nश्राद्धं कृतं तेन समासहस्रं\nरहस्यमेतत्पितरो वदन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2104503, "chapter_id": 3254, "verse_number": "१४-११०-३०", "content_sanskrit": "यस्त्वेकपङ्क्त्यां विषमं ददाति\nस्नेहाद्भयाद्वा यदि वाऽर्थहेतोः।\nक्रूरं दुराचारमनात्मवन्तं\nब्रह्मघ्नमेनं कवयो वदन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2104504, "chapter_id": 3254, "verse_number": "१४-११०-३१", "content_sanskrit": "धनानि येषां विपुलानि सन्ति\nनित्यं रमन्ते परलोकमूढाः।\nतेषामयं शत्रुवरघ्नलोको\nनान्यत्सुखं देहसुखे रतानाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2104505, "chapter_id": 3254, "verse_number": "१४-११०-३२", "content_sanskrit": "ये चैव मुक्तास्तपसि प्रयुक्ताः\nस्वाध्यायशीला जरयन्ति देहम्।\nजितेन्द्रिया भूतहिते निविष्ट-\nस्तेषामसौ चापि परश्च लोकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2104506, "chapter_id": 3254, "verse_number": "१४-११०-३३", "content_sanskrit": "ये चैव विद्यां न तपो न दानं\nन चापि मूढाः प्रजने यतन्ते।\nन चापि गच्छन्ति सुखानि भोगां-\nस्तेषामयंक चापि परश्च नास्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2104507, "chapter_id": 3254, "verse_number": "१४-११०-३४x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2104508, "chapter_id": 3254, "verse_number": "१४-११०-३४", "content_sanskrit": "नारायण पुराणेश लोकावास नमोस्तु ते।\nश्रोतुमिच्छामि कार्त्स्न्येन धर्मसारसमुच्चयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2104509, "chapter_id": 3254, "verse_number": "१४-११०-३५x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2104510, "chapter_id": 3254, "verse_number": "१४-११०-३५", "content_sanskrit": "धर्मसारं महाप्राज्ञि मनुना प्रोक्तमादितः।\nप्रवक्ष्यामि मनुप्रोक्तं पौराणां श्रुतिसंहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2104511, "chapter_id": 3254, "verse_number": "१४-११०-३६", "content_sanskrit": "अग्निचित्कपिला सत्री राजा भिक्षुर्महोदधिः।\nदृष्टमात्रात्पुनत्येते तस्मात्पश्येत तान्सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2104512, "chapter_id": 3254, "verse_number": "१४-११०-३७", "content_sanskrit": "गौरकस्यैव दातव्या न बहूनां युधिष्ठिर।\nसा गौर्विक्रयमापन्ना दहत्यासप्तमं कुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2104513, "chapter_id": 3254, "verse_number": "१४-११०-३८", "content_sanskrit": "बहूनां न प्रदातव्या गौर्वस्त्रं शयनं स्त्रियः।\nतादृग्भूतं तु तद्दानं दातारं नोपतिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2104514, "chapter_id": 3254, "verse_number": "१४-११०-३९", "content_sanskrit": "आक्रम्य ब्राह्मणैर्भुक्तमनार्याणां च वेश्मनि।\nगोभिश्च पुण्यं तत्तेषां राजसूयाद्विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2104515, "chapter_id": 3254, "verse_number": "१४-११०-४०", "content_sanskrit": "मा ददात्विति यो ब्रूयाद्ब्राह्मणेषु च गोषु च।\nतिर्यग्योनिशतं गत्वा चण्डालेषूपजायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2104516, "chapter_id": 3254, "verse_number": "१४-११०-४१", "content_sanskrit": "ब्राह्मणस्वं च यद्दैवं दरिद्रस्यैव यद्धनम्।\nगुरोश्चापि हृतं राजन्स्वर्गस्थानपि पातयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2104517, "chapter_id": 3254, "verse_number": "१४-११०-४२", "content_sanskrit": "धर्मं जिज्ञासमानानां प्रमाणं परमं श्रुतिः।\nद्वितायं धर्मशास्त्राणि तृतीयं लोकसंग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2104518, "chapter_id": 3254, "verse_number": "१४-११०-४३", "content_sanskrit": "आसमुद्राच्च यत्पूर्वादासमुद्राच्च पश्चिमात्।\nहिमाद्रिविन्ध्ययोर्मध्यमार्यावर्तं प्रचक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2104519, "chapter_id": 3254, "verse_number": "१४-११०-४४", "content_sanskrit": "सरावतीदृषद्वत्योर्देवनद्योर्यदन्तरम्।\nतद्देवनिर्मितं देशं ब्रह्मवर्तं प्रचक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2104520, "chapter_id": 3254, "verse_number": "१४-११०-४५", "content_sanskrit": "यस्मिन्देशे य आचारः पारंपर्यक्रमागतः।\nवर्णानां सान्तरालानां स सदाचार उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2104521, "chapter_id": 3254, "verse_number": "१४-११०-४६", "content_sanskrit": "कुरुक्षेत्रं च मत्स्याश्च पाञ्चालाः शूरसेनयः।\nएते ब्रह्मर्षिदेशास्तु ब्रह्मावर्तादनन्तराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2104522, "chapter_id": 3254, "verse_number": "१४-११०-४७", "content_sanskrit": "एतद्देशप्रसूतस्य सकाशादग्रजन्मनः।\nस्वं चारित्रं च गृह्णीयुः पृथिव्यां सर्वमानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2104523, "chapter_id": 3254, "verse_number": "१४-११०-४८", "content_sanskrit": "हिमवद्विन्ध्ययोर्मध्यं यत्प्राग्विशसनादपि।\nप्रत्यगेव प्रयागात्तु मध्यदेशः प्रकीर्तितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2104524, "chapter_id": 3254, "verse_number": "१४-११०-४९", "content_sanskrit": "कृष्णसारस्तु चरति मृगो यत्र स्वभावतः।\nस ज्ञेयो याज्ञिको देशो म्लेच्छदेशस्ततः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2104525, "chapter_id": 3254, "verse_number": "१४-११०-५०", "content_sanskrit": "एतान्विज्ञाय देशांस्तु संश्रयेरन्द्विजातयः।\nशूद्रस्तु यस्मिन्कस्मिन्वा निवसेद्वृत्तिकर्शितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2104526, "chapter_id": 3254, "verse_number": "१४-११०-५१", "content_sanskrit": "आचारः प्रथमो धर्मो ह्यहिंसा सत्यमेव च।\nदानं चैव यथाशक्ति नियमाश्च यमैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2104527, "chapter_id": 3254, "verse_number": "१४-११०-५२", "content_sanskrit": "वैदिकैः कर्मभिः पुण्यैर्निषेकादिर्द्विजन्मनाम्।\nकार्यः शरीरसंस्कारः पावनः प्रेत्य चेह च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2104528, "chapter_id": 3254, "verse_number": "१४-११०-५३", "content_sanskrit": "गर्भहोमैर्जातकर्मनामचौलोपनायनैः।\nस्वाध्यायैस्तद्व्रतैश्चैव विवाहस्नातकव्रतैः।\nमहायज्ञैश्च यज्ञैश्च ब्राह्मीयं क्रियते तनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2104529, "chapter_id": 3254, "verse_number": "१४-११०-५४", "content_sanskrit": "धर्मोर्थौ यदि न स्यातां शुश्रुषा वाऽपि तद्विधा।\nविद्या तस्मिन्नवप्तव्या शुभं बीजमिवोषरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2104530, "chapter_id": 3254, "verse_number": "१४-११०-५५", "content_sanskrit": "लौकिकं वैदिकं वाऽपि तथाऽऽध्यात्मिकमेव वा।\nयस्माज्ज्ञानमिदं प्राप्तं तं पूर्वमभिवादयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2104531, "chapter_id": 3254, "verse_number": "१४-११०-५६", "content_sanskrit": "सव्येन सव्यं संगृह्य दक्षिणेन तु दक्षिणम्।\nन कुर्यादेकहस्तेन गुरोः पादाभिवादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2104532, "chapter_id": 3254, "verse_number": "१४-११०-५७", "content_sanskrit": "निषेकादीनि कर्माणि यः करोति यथाविधि।\nअध्यापयति चैवेनं स विप्रो गुरुरुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2104533, "chapter_id": 3254, "verse_number": "१४-११०-५८", "content_sanskrit": "कृत्वोपनयनं वेदान्योध्यापयति नित्यशः।\nसकल्पान्सरहस्यांश्च स चोपाध्याय उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2104534, "chapter_id": 3254, "verse_number": "१४-११०-५९", "content_sanskrit": "साङ्गांश्च वेदानध्याप्य शिक्षयित्वा व्रतानि च।\nविवृणोति च मन्त्रार्थानाचार्यः सोभिधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2104535, "chapter_id": 3254, "verse_number": "१४-११०-६०", "content_sanskrit": "उपाध्यायाद्दशाचार्य आचार्याणां शतं पिता।\nपितुः शतगुणं माता गौरवेणातिरिच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2104536, "chapter_id": 3254, "verse_number": "१४-११०-६१", "content_sanskrit": "एतेषामपि सर्वेषां गरीयान्ज्ञानदो गुरुः।\nगुरोः परतरं किंचिन्न भूतं न भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2104537, "chapter_id": 3254, "verse_number": "१४-११०-६२", "content_sanskrit": "तस्मात्तेषां वशे तिष्ठिच्छुश्रूषापरमो भवेत्।\nअवमानाद्धि तेषां तु नरकं स्यान्न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2104538, "chapter_id": 3254, "verse_number": "१४-११०-६३", "content_sanskrit": "हीनाङ्गानतिरिक्ताङ्गान्विद्याहीनान्वयोधिकान्।\nरूपद्रविणहीनांश्च जातिहीनांस्च नाक्षिपेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2104539, "chapter_id": 3254, "verse_number": "१४-११०-६४", "content_sanskrit": "शपता यत्कृतं पुण्यं शप्यमानं तु गच्छति।\nशप्यमानस्य यत्पापं शपन्तमनुगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2104540, "chapter_id": 3254, "verse_number": "१४-११०-६५", "content_sanskrit": "नास्तिक्यं वेदनिन्दां च देवतानां च कुत्सनम्।\nद्वेषं डंभं च मानं च क्रोधं तैक्ष्ण्यं विवर्जयेत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2104541, "chapter_id": 3254, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि वैष्णवधर्मपर्वणि दशाधिकशततमोऽध्यायः॥ ११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]