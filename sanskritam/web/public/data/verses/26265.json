[{"id": 7006265000, "chapter_id": 26265, "verse_number": "३-१९-१", "content_sanskrit": "अगस्त्य उवाच चक्रराजरथेन्द्रस्य याःपर्वणि समाश्रिताः ।\nदेवता प्रकटाभिख्यास्तासामाख्यां निवेदय ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006265001, "chapter_id": 26265, "verse_number": "३-१९-२", "content_sanskrit": "संख्याश्च तासामखिला वर्णभेदांश्च शोभनान् ।\nआयुधानि च दिव्यानि कथयस्व हयानन ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006265002, "chapter_id": 26265, "verse_number": "३-१९-३", "content_sanskrit": "हयग्रीव उवाच नवमं पर्व दीप्तस्य रथस्य समुपस्थिताः ।\nतश प्रोक्ता सिद्धिदेव्यस्तासां नामानि मच्छृणु ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006265003, "chapter_id": 26265, "verse_number": "३-१९-४", "content_sanskrit": "अणिमा महिमाचैव लघिमा गरिमा तथा ।\nईशिता वशिता चैव प्राप्तिः सिद्धिश्च सप्तमी ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006265004, "chapter_id": 26265, "verse_number": "३-१९-५", "content_sanskrit": "प्राकाम्यमुक्तिसिद्धिश्च सर्वकामाभिधापरा ।\nएतादेव्यश्चतुर्बाह्व्यो जपाकुसुमसंनिभाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006265005, "chapter_id": 26265, "verse_number": "३-१९-६", "content_sanskrit": "चिन्तामणिकपालं च त्रिशूलं सिद्धिकज्जलम् ।\nदधाना दयया पूर्णा योगिभिश्च निषेविताः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006265006, "chapter_id": 26265, "verse_number": "३-१९-७", "content_sanskrit": "तत्र पूर्वार्द्धभागे च ब्रह्माद्या अष्ट शक्तयः ।\nब्राह्मी माहेश्वरी चैव कौमारी वैष्मवी तथा ।\nवाराही चैव मांहेन्द्री चामुण्डा चैव सप्तमी ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006265007, "chapter_id": 26265, "verse_number": "३-१९-८", "content_sanskrit": "महालक्ष्मीरष्टमी च द्विभुजाः शोणविग्रहाः ।\nकपालमुत्पलं चैव बिभ्राणा रक्तवाससः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006265008, "chapter_id": 26265, "verse_number": "३-१९-९", "content_sanskrit": "अथ वान्य प्रकारेण केचिद्ध्यानं पचक्षते ।\nब्रह्मादिसदृशाकारा ब्रह्मादिसदृशायुधाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006265009, "chapter_id": 26265, "verse_number": "३-१९-१०", "content_sanskrit": "ब्रह्मादीनां परं चिह्नं धारयन्त्यः प्रकीर्तिताः ।\nतासामूर्ध्वस्थानगतां मुद्रा देव्यो महत्तराः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006265010, "chapter_id": 26265, "verse_number": "३-१९-११", "content_sanskrit": "मुद्राविरचनायुक्तैर्हस्तैः कमलकान्तिभिः ।\nदाडिमीपुष्पसङ्काशाः पीतांबरमनोहराः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006265011, "chapter_id": 26265, "verse_number": "३-१९-१२", "content_sanskrit": "चतुर्भुजा भुजद्वन्द्वधृतचर्मकृपाणकाः ।\nमदरक्तविलोलाक्ष्यस्तासां नामानि मच्छृणु ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006265012, "chapter_id": 26265, "verse_number": "३-१९-१३", "content_sanskrit": "सर्वसंक्षोभिणी चैव सर्वविद्राविणी तथा ।\nसर्वाकर्षणकृन्मुद्रा तथा सर्ववशङ्करी ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006265013, "chapter_id": 26265, "verse_number": "३-१९-१४", "content_sanskrit": "सर्वोन्मादनमुद्रा च यष्टिः सर्वमहाङ्कुशा ।\nसर्वखेचरिका मुद्रा सर्वबीजा तथापरा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006265014, "chapter_id": 26265, "verse_number": "३-१९-१५", "content_sanskrit": "सर्वयोनिश्च नवमी तथा सर्वत्रिशण्डिका ।\nसिद्धिब्राहयादिमुद्रास्ता एताः प्रकटशक्तयः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006265015, "chapter_id": 26265, "verse_number": "३-१९-१६", "content_sanskrit": "भण्डासुरस्य संहारं कर्तुं रक्तरथे स्थिताः ।\nया गुप्ताख्याः पूर्वमुक्तास्तासां नामानि मच्छृणु ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006265016, "chapter_id": 26265, "verse_number": "३-१९-१७", "content_sanskrit": "कामाकर्षणिका चैव बुद्ध्याकर्षणिका कला ।\nअहङ्काराकर्षिणी च शब्दाकर्षणिका कला ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006265017, "chapter_id": 26265, "verse_number": "३-१९-१८", "content_sanskrit": "स्पर्शाकर्षणिका नित्या रूपाकर्षणिका कला ।\nरसाकर्षणिका नित्या गन्धाकर्षणिका कला ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006265018, "chapter_id": 26265, "verse_number": "३-१९-१९", "content_sanskrit": "चित्ताकर्षणिका नित्या धैर्याकर्षणिका कला ।\nस्मृत्या कर्षणिका नित्या नामाकर्णणिका कला ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006265019, "chapter_id": 26265, "verse_number": "३-१९-२०", "content_sanskrit": "बीजाकर्षणिका नित्या चात्मकर्षणिका कला ।\nअमृताकर्षणी नित्या शरीराकर्षिणी कला ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006265020, "chapter_id": 26265, "verse_number": "३-१९-२१", "content_sanskrit": "एताः षोडश शीतांशुकलारूपाश्च शक्तयः ।\nअष्टमं पर्व सम्प्राप्ता गुप्ता नाम्ना प्रकीर्तिताः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006265021, "chapter_id": 26265, "verse_number": "३-१९-२२", "content_sanskrit": "विद्रुमद्रुमसङ्काशा मन्दस्मित मनोहराः ।\nचतुर्भुजास्त्रिनेत्राश्च चन्द्रार्कमुकुजोज्ज्वलाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006265022, "chapter_id": 26265, "verse_number": "३-१९-२३", "content_sanskrit": "चापबाणौ चर्मखड्गौ दधाना दिव्यकान्तयः ।\nभण्डासुरवधार्थाय प्रवृत्ताः कुम्भसम्भव ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006265023, "chapter_id": 26265, "verse_number": "३-१९-२४", "content_sanskrit": "सायन्तनज्वलद्दीपप्रख्यचक्ररथस्य तु ।\nसप्तमे पर्वणि कृतावासा गुप्ततराभिधाः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006265024, "chapter_id": 26265, "verse_number": "३-१९-२५", "content_sanskrit": "अनङ्गमदनानङ्गमदनातुरया सह ।\nअनङ्गलेखा चानङ्गवेगानङ्गाङ्कुशापि च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006265025, "chapter_id": 26265, "verse_number": "३-१९-२६", "content_sanskrit": "अनङ्गमालिग्यपरा एता देव्यो जपात्विषः ।\nइक्षुचापं पुष्पशरान्पुष्पकन्दुकमुत्पलम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006265026, "chapter_id": 26265, "verse_number": "३-१९-२७", "content_sanskrit": "बिभ्रत्योऽदभ्रविक्रान्तिशालिन्यो ललिताज्ञया ।\nभण्डासुरमभिक्रुद्धाः प्रज्वलन्त्य इव स्थिताः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006265027, "chapter_id": 26265, "verse_number": "३-१९-२८", "content_sanskrit": "अथ चक्ररथेन्द्रस्य षष्ठं पर्व समाश्रिताः ।\nसर्वसंक्षोभिणीमुख्याः सम्प्रदायाख्यया युताः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006265028, "chapter_id": 26265, "verse_number": "३-१९-२९", "content_sanskrit": "वेणीकृतकचस्तोमाः सिंदूरतिलकोज्ज्वलाः ।\nअतितीव्रस्वभावाश्च कालानलसमत्विषः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006265029, "chapter_id": 26265, "verse_number": "३-१९-३०", "content_sanskrit": "वह्निबाणं वह्निचापं वह्निरूपमसिं तथा ।\nवह्निचक्राख्याफलकं दधाना दीप्तविग्रहाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006265030, "chapter_id": 26265, "verse_number": "३-१९-३१", "content_sanskrit": "असुरेन्द्रं प्रति क्रुद्धाः कामभस्मसमुद्भवाः ।\nआज्ञाशक्तय एवैता ललिताया महौजसः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006265031, "chapter_id": 26265, "verse_number": "३-१९-३२", "content_sanskrit": "सर्वसंक्षोभिणी चैव सर्वविद्राविणी तथा ।\nसर्वाकर्षणिका शक्तिः सर्वाह्लादिनिका तथा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006265032, "chapter_id": 26265, "verse_number": "३-१९-३३", "content_sanskrit": "सर्वसंमोहिनीशक्तिः सर्वस्तम्भनशक्तिका ।\nसर्वजृंभणशक्तिश्च सर्वोन्मादनशक्तिका ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006265033, "chapter_id": 26265, "verse_number": "३-१९-३४", "content_sanskrit": "सर्वार्थसाधिका शक्तिः सर्वसम्पत्तिपूरणी ।\nसर्वमन्त्रमयी शक्तिः सर्वद्वन्द्वक्षयङ्करी ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006265034, "chapter_id": 26265, "verse_number": "३-१९-३५", "content_sanskrit": "एवं तु सम्प्रदायानां नामानि कथितानि वै ।\nअथ पञ्चमपर्वस्थाः कुलोत्तीर्णा इति स्मृताः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006265035, "chapter_id": 26265, "verse_number": "३-१९-३६", "content_sanskrit": "ताश्च सप्तटिकसङ्काशाः परशुं पाशमेव च ।\nगदां घण्टां मणिं चैव दधाना दीप्तविग्रहाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006265036, "chapter_id": 26265, "verse_number": "३-१९-३७", "content_sanskrit": "देवद्विषमति क्रुद्धा भ्रुकुटीकुटिलाननाः ।\nएतासामपि नामानि समाकर्मय कुम्भज ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006265037, "chapter_id": 26265, "verse_number": "३-१९-३८", "content_sanskrit": "सर्वसिद्धिप्रदा देवी सर्वसम्पत्प्रदा तथा ।\nसर्वप्रियङ्करी देवी सर्वमङ्गलकारिणी ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006265038, "chapter_id": 26265, "verse_number": "३-१९-३९", "content_sanskrit": "सर्वकामप्रदा देवी सर्वदुःखविमोचिनी ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006265039, "chapter_id": 26265, "verse_number": "३-१९-४०", "content_sanskrit": "सर्वमृत्युप्रशमिनी सर्वविघ्ननिवारिणी ।\nसर्वाङ्गसुन्दरी देवी सर्वसौभाग्यदायिनी ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006265040, "chapter_id": 26265, "verse_number": "३-१९-४१", "content_sanskrit": "दशैन्ताः कथिता देव्यो दयया पूरिताशयाः ।\nचक्रे तुरीयपर्वस्था मुक्ताहारसमत्विषः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006265041, "chapter_id": 26265, "verse_number": "३-१९-४२", "content_sanskrit": "निगर्भयोगिनीनाम्ना प्रथिता दश कीर्तिताः ।\nसर्वज्ञा सर्वशक्तिश्च सर्वैश्वर्यप्रदा तथा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006265042, "chapter_id": 26265, "verse_number": "३-१९-४३", "content_sanskrit": "सर्वज्ञानमयी देवी सर्वव्याधिविनाशिनी ।\nसर्वाधारस्वरूपा च सर्वपापहरा तथा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006265043, "chapter_id": 26265, "verse_number": "३-१९-४४", "content_sanskrit": "सर्वानन्दमयी देवी सर्वरक्षास्वरूपिणी ।\nदशमी देवताज्ञेया सर्वेष्सितफलप्रदा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006265044, "chapter_id": 26265, "verse_number": "३-१९-४५", "content_sanskrit": "एताश्चतुर्भुजा ज्ञेया वज्रं शक्तिं च तोमरम् ।\nचक्रं चैवाभिबिभ्राणा भण्डासुरवधोद्यताः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006265045, "chapter_id": 26265, "verse_number": "३-१९-४६", "content_sanskrit": "अथ चक्ररथेन्द्रस्य तृतीयं पर्वसंश्रिताः ।\nरहस्ययोगिनीनाम्ना प्रख्याता वागधीश्वराः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006265046, "chapter_id": 26265, "verse_number": "३-१९-४७", "content_sanskrit": "रक्ताशोकप्रसूनाभाबाणकार्मुकपाणयः ।\nकवचच्छन्नसर्वाङ्गयो वीणापुस्तकशोभिताः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006265047, "chapter_id": 26265, "verse_number": "३-१९-४८", "content_sanskrit": "वशिनी चैव कामेशी भोगिनी विमला तथा ।\nअरुणाच जविन्याख्या सर्वेशी कौलिनी तथा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006265048, "chapter_id": 26265, "verse_number": "३-१९-४९", "content_sanskrit": "अष्टावेताः स्मृता देव्यो दैत्यसंहारहेतवः ।\nअथ चक्ररथेन्द्रस्य द्वितीयं पर्वसंश्रिताः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006265049, "chapter_id": 26265, "verse_number": "३-१९-५०", "content_sanskrit": "चापबाणौ पानपात्रं मातुरुङ्गं कृपाणिकाम् ।\nतिस्रस्त्रिपीठनिलया अष्टबाहुसमन्विताः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006265050, "chapter_id": 26265, "verse_number": "३-१९-५१", "content_sanskrit": "पलकं नागपाशं च घण्टां चैव महाध्वनिम् ।\nविभ्राणा मदिरामत्ता अतिगुप्तरहस्यकाः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006265051, "chapter_id": 26265, "verse_number": "३-१९-५२", "content_sanskrit": "कामेशी चैव वज्रेशी भगमालिन्यथापरा ।\nतिस्र एताः स्मृता देव्यो भण्डे कोपसमन्विताः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006265052, "chapter_id": 26265, "verse_number": "३-१९-५३", "content_sanskrit": "ललितासममाहात्म्या ललितासमतेजसः ।\nएतास्तु नित्यं श्रीदेव्या अन्तरङ्गाः प्रकीर्तिताः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006265053, "chapter_id": 26265, "verse_number": "३-१९-५४", "content_sanskrit": "अथानन्दमहापीठे रथमध्यमपर्वणि ।\nपरितो रचितावासाः प्रोक्ताः पञ्चदशाक्षराः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006265054, "chapter_id": 26265, "verse_number": "३-१९-५५", "content_sanskrit": "तिथिनित्याः कालरूपा विश्वं व्याप्यैव संस्थिताः ।\nभण्डासुरादिदैत्येषु प्रक्षुब्धभ्रुकुटीतटाः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006265055, "chapter_id": 26265, "verse_number": "३-१९-५६", "content_sanskrit": "देवीसमनिजाकारा देवीसमनिजायुधाः ।\nजगतामुपकाराय वर्तमाना युगेयुगे ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006265056, "chapter_id": 26265, "verse_number": "३-१९-५७", "content_sanskrit": "तासां नामानि मत्तस्त्वमवधारयकुम्भज ।\nकामेशी भगमाला च नित्यक्लिन्ना तथैव च ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006265057, "chapter_id": 26265, "verse_number": "३-१९-५८", "content_sanskrit": "भेरुण्डा वह्निवासिन्यो महावज्रेश्वरी तथा ।\nदती च त्वरिता देवी नवमी कुलसुन्दरी ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006265058, "chapter_id": 26265, "verse_number": "३-१९-५९", "content_sanskrit": "नित्या नीलपताका च विजया सर्वमङ्गला ।\nज्वालामालिनिकाचित्रे दश पञ्च च कीर्तिताः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006265059, "chapter_id": 26265, "verse_number": "३-१९-६०", "content_sanskrit": "एताभिः सहिता देवी सदा सेवैकबुद्धिभिः ।\nदुष्टं भण्डासुरं जेतुं निर्ययौ परमेश्वरी ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006265060, "chapter_id": 26265, "verse_number": "३-१९-६१", "content_sanskrit": "मन्त्रिनाथा महाचक्रे गीतिं चक्रे रथोत्तमे ।\nसप्तपर्वाणि चोक्तानि तत्र देव्याश्च ताः शृणु ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006265061, "chapter_id": 26265, "verse_number": "३-१९-६२", "content_sanskrit": "गेयचक्ररथे पर्वमध्यपीढनिकेतना ।\nसंगीतयोगिनी प्रोक्ता श्रीदेव्या अतिवल्लभा ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006265062, "chapter_id": 26265, "verse_number": "३-१९-६३", "content_sanskrit": "तदेव प्रथमं पर्व मन्त्रिण्यास्तु निवासभूः ।\nअथ द्वितीयपर्वस्था गेयचक्रे रथोत्तमे ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006265063, "chapter_id": 26265, "verse_number": "३-१९-६४", "content_sanskrit": "रतिः प्रीतिर्मनोजा च वीणाकार्मुकपाणयः ।\nतमालश्यामलाकारा दानवोन्मूलनक्षमाः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006265064, "chapter_id": 26265, "verse_number": "३-१९-६५", "content_sanskrit": "तृतीयपर्वसंरूढा मनोभूबाणदेवता ।\nद्राविणी शोषिणी चैव बन्धिनी मोहिनी तथा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006265065, "chapter_id": 26265, "verse_number": "३-१९-६६", "content_sanskrit": "उन्मादिनीति पञ्चैता दीप्तकार्मुकपाणयः ।\nतत्र पर्वण्यधस्तात्तु वर्तमाना महौजसः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006265066, "chapter_id": 26265, "verse_number": "३-१९-६७", "content_sanskrit": "कामराजश्च कन्दर्पौं मन्मथो मकरध्वजः ।\nमनोभवः पञ्चमः स्यादेते त्रैलोक्यमोहनाः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006265067, "chapter_id": 26265, "verse_number": "३-१९-६८", "content_sanskrit": "कस्तूरीतिलकोल्लासिभालामुक्ताविराजिताः ।\nकवचच्छन्नसर्वाङ्गाः पलाशप्रसवत्विषः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006265068, "chapter_id": 26265, "verse_number": "३-१९-६९", "content_sanskrit": "पञ्चकामा इमे प्रोक्ता भण्डासुरवधार्थिनः ।\nजेयचक्ररथेन्द्रस्य चतुर्थं पर्व संश्रिताः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006265069, "chapter_id": 26265, "verse_number": "३-१९-७०", "content_sanskrit": "ब्रह्मीमुख्यास्तु पूर्वोक्ताश्चण्डिका त्वष्टमी परा ।\nतत्र पर्वण्यधस्ताच्च लक्ष्मीश्चैव सरस्वती ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006265070, "chapter_id": 26265, "verse_number": "३-१९-७१", "content_sanskrit": "रतिः प्रीतिः कीर्तिशान्ती पुष्टिस्तुष्टिश्च शक्तयः ।\nएताश्चक्रोधरक्ताक्ष्यो दैत्यं हन्तुं महाबलम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006265071, "chapter_id": 26265, "verse_number": "३-१९-७२", "content_sanskrit": "कुन्तचक्रधराः प्रोक्ताः कुमार्यः कुंभसंभव ।\nपञ्चमं पर्व संप्राप्ता वामाद्याः षोडशापराः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006265072, "chapter_id": 26265, "verse_number": "३-१९-७३", "content_sanskrit": "गीतिं चक्रू रथेन्द्रस्य तासां नामानि मच्छृणु ।\nवामा ज्येष्टा च रौद्री च शान्तिः श्रद्धा सरस्वती ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006265073, "chapter_id": 26265, "verse_number": "३-१९-७४", "content_sanskrit": "श्रीभूशाक्तिश्च लक्ष्मीश्च सृष्टिश्चैव तु मोहिनी ।\nतथा प्रमाथिनी चाश्वसिनी वीचिस्तथैव च ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006265074, "chapter_id": 26265, "verse_number": "३-१९-७५", "content_sanskrit": "विद्युन्मालिन्यथ सुरानन्दाथो नागबुद्धिका ।\nएतास्तु कुरविन्दाभा जगत्क्षोभणलंपटाः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006265075, "chapter_id": 26265, "verse_number": "३-१९-७६", "content_sanskrit": "महासरसमन्नाहमादधानाः पदेपदे ।\nवज्रकङ्कटसंछन्ना अट्टहासोज्ज्वलाः परे ।\nवज्रदण्डौ शतघ्नीं च संबिभ्राणा भुशुण्डिकाः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006265076, "chapter_id": 26265, "verse_number": "३-१९-७७", "content_sanskrit": "अथ गीतिरथेन्द्रस्य षष्ठं पर्व समाश्रिताः ।\nअसिताङ्गप्रभृतयो भैरवाः शस्त्रभीषणाः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006265077, "chapter_id": 26265, "verse_number": "३-१९-७८", "content_sanskrit": "त्रिशिखं पानपात्रं च बिभ्राणा नीलवर्चसः ।\nअसिताङ्गो रुरुश्चण्डः क्रोध उन्मत्तभैरवः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006265078, "chapter_id": 26265, "verse_number": "३-१९-७९", "content_sanskrit": "कपाली भीषणश्चैव संहारश्चाष्ट भैरवाः ।\nअथ गीतिरथेन्द्रस्य सप्तमं पर्व संश्रिताः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006265079, "chapter_id": 26265, "verse_number": "३-१९-८०", "content_sanskrit": "मातङ्गी सिद्धलक्ष्मीश्च महामातङ्गिकापि च ।\nमहती सिद्धलक्ष्मीश्च शोणा बाणधनुर्धराः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006265080, "chapter_id": 26265, "verse_number": "३-१९-८१", "content_sanskrit": "तस्यैव पर्वणोऽधस्ताद्गणपः क्षेत्रपस्तथा ।\nदुर्गांबा बटुकश्चेंव सर्वे ते शस्त्रपाणयः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006265081, "chapter_id": 26265, "verse_number": "३-१९-८२", "content_sanskrit": "तत्रैव पर्वणोऽधस्ताल्लक्ष्मीश्चैव सरस्वती ।\nशङ्खः पद्मो निधिश्चैव ते सर्वे शस्त्रपाणयः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006265082, "chapter_id": 26265, "verse_number": "३-१९-८३", "content_sanskrit": "लोकद्विषं प्रति क्रुद्धा भण्डं चण्डपराक्रमम् ।\nशक्रादयश्च विष्म्वन्ता दश दिक्चक्रनायकाः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006265083, "chapter_id": 26265, "verse_number": "३-१९-८४", "content_sanskrit": "शक्तिरूपास्तत्र पर्वण्यधस्तात्कृतसंश्रयाः ।\nवज्रे शक्तिं कालदण्डमकिं पाशं ध्वजं तथा ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006265084, "chapter_id": 26265, "verse_number": "३-१९-८५", "content_sanskrit": "गदां त्रिशूलं दर्भास्त्रं वज्रं च दधतस्त्वमी ।\nसेवन्ते मन्त्रिनाथां तां नित्यं भक्तिसमन्विताः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006265085, "chapter_id": 26265, "verse_number": "३-१९-८६", "content_sanskrit": "भण्डासुरान्दुर्दुरूढान्निहन्तुं विश्वकण्टकान् ।\nमन्त्रिनाथाश्रयद्वारा ललिताज्ञापनोत्सुकाः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006265086, "chapter_id": 26265, "verse_number": "३-१९-८७", "content_sanskrit": "गीतिचक्ररथोपान्ते दिक्पालाः संश्रयं ददुः ।\nसर्वेषां चैव देवानां मन्त्रिणी द्वारतः कृता ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006265087, "chapter_id": 26265, "verse_number": "३-१९-८८", "content_sanskrit": "विज्ञापना महादेव्याः कार्यसिद्धिं प्रयच्छति ।\nराक्षी विज्ञापना चेति प्रधानद्वारतः कृता ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006265088, "chapter_id": 26265, "verse_number": "३-१९-८९", "content_sanskrit": "यथा खलु फलप्राप्तिः सेवकानां हि जायते ।\nअन्यथा कथमेतेषां सामर्थ्यं ज्वलितौजसः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006265089, "chapter_id": 26265, "verse_number": "३-१९-९०", "content_sanskrit": "अपधृष्यप्रभावायाः श्रीदेव्या उपसर्पणे ।\nसा हि संगीतविद्येति श्रीदेव्या अतिवल्लभा ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006265090, "chapter_id": 26265, "verse_number": "३-१९-९१", "content_sanskrit": "नातिलङ्घति च क्वापि तदुक्तं कार्यसिद्धिषु ।\nश्रीदेव्याःशक्तिसाम्राज्ये सर्वकर्माणि मन्त्रिणी ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006265091, "chapter_id": 26265, "verse_number": "३-१९-९२", "content_sanskrit": "अकर्त्तुमन्यथा कर्तुं कर्तुं चैव प्रगल्भते ।\nतस्मात्सर्वेऽपि दिक्पालाः श्रीदेव्या जयकाङ्क्षिणः ।\nतस्याः प्रधानभूतायाः सेवामेव वितन्वते ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006265092, "chapter_id": 26265, "verse_number": "३-१९-९३", "content_sanskrit": "इति श्रीललितादेव्याश्चक्रराजरथोत्तमे ।\nपर्वस्थितानां देवीनां नामानि कथितान्यलम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006265093, "chapter_id": 26265, "verse_number": "३-१९-९४", "content_sanskrit": "भण्डासुरस्य संहारे तस्या दिव्यायुधान्यपि ।\nप्रोक्तानि गेयचक्रस्य पर्वदेव्याश्च कीर्तिताः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006265094, "chapter_id": 26265, "verse_number": "३-१९-९५", "content_sanskrit": "इमानि सर्वदेवीनां नामान्याकर्णयन्ति ये ।\nसर्वपापविनिर्मुक्तास्ते स्युर्विजयिनो नराः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}]