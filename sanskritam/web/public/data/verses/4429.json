[{"id": 2158329, "chapter_id": 4429, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2158330, "chapter_id": 4429, "verse_number": "१", "content_sanskrit": "पद्मव्यहो महाराज आचार्येण रणे कृतः ।\nतत्र पद्मोपमाः सर्वे राजानः स्म निवेशिताः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2158331, "chapter_id": 4429, "verse_number": "२", "content_sanskrit": "केसराणि च पद्मस्य सुकुमाराणि भारत ।\nकुमारा राजलोकस्य निक्षिप्ताः केसरोपमाः\nकर्णिकास्थो महाराज तस्य दुर्योधनोऽभवत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2158332, "chapter_id": 4429, "verse_number": "३", "content_sanskrit": "कर्णदुःशासनकृपैर्वृतो राजा महारथैः ।\nदेवराजोपमः श्रीमान् श्वेतच्छत्राभिसंवृतः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2158333, "chapter_id": 4429, "verse_number": "४", "content_sanskrit": "चामरव्यजनोत्क्षेपैः समुद्यन्निव भास्करः ।\nप्रमुखे तस्य शूरस्य द्रोणोऽवस्थितसायकः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2158334, "chapter_id": 4429, "verse_number": "५", "content_sanskrit": "सिन्धुराजस्तथाऽतिष्ठद् गिरिर्मेरुरिवाचलः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2158335, "chapter_id": 4429, "verse_number": "६", "content_sanskrit": "सिन्धुराजस्य पार्श्वस्था अश्वत्थामपुरोगमाः ।\nसुतास्तव महाराज त्रिंशत् त्रिदशविक्रमाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2158336, "chapter_id": 4429, "verse_number": "७", "content_sanskrit": "शकुनिः कृतवर्मा च शल्यो भूरिश्रवाः शलः ।\nपार्श्वतः सिन्धुराजस्य व्यराजन्त महारथाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2158337, "chapter_id": 4429, "verse_number": "८", "content_sanskrit": "सङ्घाता राजपुत्राणां सर्वेषामभवंस्तदा ।\nकृताभिसमयाश्चासन् सुवर्णकवचध्वजाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2158338, "chapter_id": 4429, "verse_number": "९", "content_sanskrit": "रक्ताम्बरधराः सर्वे सर्वे कनकभूषणाः ।\nसर्वे रक्तपताकाश्च सर्वे कनकमालिनः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2158339, "chapter_id": 4429, "verse_number": "१०", "content_sanskrit": "चन्दनागरुदिग्धाङ्गाः स्रग्विणः सूक्ष्मवाससः ।\nसहिताः पर्यधावन्त कार्ष्णिं प्रति युयुत्सवः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2158340, "chapter_id": 4429, "verse_number": "११", "content_sanskrit": "तेषां दशसहस्राणि बभूवू रथधन्विनाम् ।\nपौत्रं तव पुरस्कृत्य लक्षणं प्रियदर्शनम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2158341, "chapter_id": 4429, "verse_number": "१२", "content_sanskrit": "अन्योन्यसमदुःखास्ते अन्योन्यसमसाहसाः ।\nअन्योन्यमन्ववर्तन्त अन्योन्यकृतनिश्रमाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2158342, "chapter_id": 4429, "verse_number": "१३", "content_sanskrit": "तदनीकमनाधृष्यं भारद्वाजेन रक्षितम् ।\nपार्थाः समभ्यधावन्त भीमसेनपुरोगमाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2158343, "chapter_id": 4429, "verse_number": "१४", "content_sanskrit": "सात्यकिः सात्वतश्चैव धृष्टद्युम्नश्च पार्षतः ।\nकुन्तिभोजश्च विक्रान्तो द्रुपदश्च महारथः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2158344, "chapter_id": 4429, "verse_number": "१५", "content_sanskrit": "दुर्जयः क्षत्रधर्मा च बृहत्क्षत्रश्च वीर्यवान् ।\nचेदिपो धृष्टकेतुश्च माद्रीपुत्रौ घटोत्कचः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2158345, "chapter_id": 4429, "verse_number": "१६", "content_sanskrit": "युधामन्युश्च पाञ्चाल्यः शिखण्डी चापराजितः ।\nउत्तमौजाश्च दुर्धर्षो विराटश्च महारथः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2158346, "chapter_id": 4429, "verse_number": "१७", "content_sanskrit": "द्रौपदेयाश्च दुर्धर्षाः शैशुपालिश्च वीर्यवान् ।\nकेकयाश्च महावीर्याः सृञ्जयाश्च सहस्रशः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2158347, "chapter_id": 4429, "verse_number": "१८", "content_sanskrit": "एते चान्ये च बहवः सगणाः युद्धदुर्मदाः ।\nसहसा स्माभ्यवर्तन्त भारद्वाजयुयुत्सवः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2158348, "chapter_id": 4429, "verse_number": "१९", "content_sanskrit": "समीपे वर्तमानांस्तान् भारद्वाजोऽपि वीर्यवान् ।\nअसम्भ्रान्तः शरौघेण महता प्रत्यवारयत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2158349, "chapter_id": 4429, "verse_number": "२०", "content_sanskrit": "महौघः सलिलस्येव गिरिमासाद्य दुर्भिदम् ।\nतं तु ते नाभ्यवर्तन्त वेलामिव जलाशयाः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2158350, "chapter_id": 4429, "verse_number": "२१", "content_sanskrit": "पीड्यमानाः शरैस्तीक्ष्णैर्द्रोणचापविनिःसृतैः ।\nनाशक्नुवन् मुखे स्थातुं भारद्वाजस्य पाण्डवाः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2158351, "chapter_id": 4429, "verse_number": "२२", "content_sanskrit": "तदद्भुतमपश्याम द्रोणस्य भुजयोर्बलम् ।\nयदेनं नाभ्यवर्तन्त पाञ्चालाः पाण्डवैः सह\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2158352, "chapter_id": 4429, "verse_number": "२३", "content_sanskrit": "तमायान्तमभिक्रुद्धो द्रोणं दृष्ट्वा युधिष्ठिरः ।\nबहुधा चिन्तयामास द्रोणस्य प्रतिवारणम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2158353, "chapter_id": 4429, "verse_number": "२४", "content_sanskrit": "अशक्यं तु तदाऽन्येन भेत्तुं मत्वा युधिष्ठिरः ।\nअविषँह्यं गुरुं भारं सौभद्रे समवासृजत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2158354, "chapter_id": 4429, "verse_number": "२५", "content_sanskrit": "वासुदेवादनवमं फल्गुनाच्चामितौजसम् ।\nअब्रवीत् परवीरघ्नमभिमन्युमिदं वचः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2158355, "chapter_id": 4429, "verse_number": "२६", "content_sanskrit": "एत्य नो नार्जुनो गर्हेद् यथा तात तथा कुरु ।\nद्रोणानीकस्य न वयं विद्मो भेदं कथञ्चन\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2158356, "chapter_id": 4429, "verse_number": "२७", "content_sanskrit": "त्वं वाऽर्जुनो वा कृष्णो वा भिन्द्यात् प्रद्युम्न एव वा ।\nद्रोणानीकं महाबाहो पञ्चमोऽन्यो न विद्यते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2158357, "chapter_id": 4429, "verse_number": "२८", "content_sanskrit": "अभिमन्यो वरं तात याचे त्वां दातुमर्हसि ।\nपितृभ्यो मातुलेभ्यश्च सैन्येभ्यश्चैव भारत\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2158358, "chapter_id": 4429, "verse_number": "२९", "content_sanskrit": "धनञ्जयो हि नस्तात गर्हयेदेत्य संयुगात् ।\nक्षिप्रमस्त्रं समादाय द्रोणानीकं विशातय\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2158359, "chapter_id": 4429, "verse_number": "", "content_sanskrit": "अभिमन्युः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2158360, "chapter_id": 4429, "verse_number": "३०", "content_sanskrit": "द्रोणस्य दृढमव्यग्रमनीकप्रवरं महत् ।\nपितॄणां सिद्धिमन्विच्छन्नवगाहे भिनद्मि च\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2158361, "chapter_id": 4429, "verse_number": "३१", "content_sanskrit": "उपदिष्टो हि मे पित्रा योगोऽनीकस्य भेदने ।\nनोत्सहे प्रतिनिर्गन्तुमहं कस्याञ्चिदापदि\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2158362, "chapter_id": 4429, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2158363, "chapter_id": 4429, "verse_number": "३२", "content_sanskrit": "भिन्धि व्यूहं युधिश्रेष्ठ द्वारं सञ्जनयस्व नः ।\nवयं त्वाऽनुगमिष्यामो येन त्वं पुत्र यास्यसि\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2158364, "chapter_id": 4429, "verse_number": "३३", "content_sanskrit": "धनञ्जयस्य प्रतिमं त्वा यान्तं तात संयुगे ।\nप्रणिधायाग्रतः सर्वे अनुयास्याम पृष्ठतः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2158365, "chapter_id": 4429, "verse_number": "३४", "content_sanskrit": "धनञ्जयसम द्वन्द्वयुद्धे यान्तं हि संयुगे ।\nप्रणिधायानुयास्यामो रक्षन्तः सर्वतोमुखाः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2158366, "chapter_id": 4429, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2158367, "chapter_id": 4429, "verse_number": "३५", "content_sanskrit": "अहं त्वामनुयास्यामि धृष्टद्युम्नश्च सात्यकिः ।\nपाञ्चालाः केकया मत्स्याः तथा सर्वे प्रभद्रकाः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2158368, "chapter_id": 4429, "verse_number": "३६", "content_sanskrit": "सकृद्भिन्नं त्वया व्यूहं तत्र तत्र त्वया सह ।\nवयं प्रध्वंसयिष्यामो निघ्नमानाः परान् वरान्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2158369, "chapter_id": 4429, "verse_number": "", "content_sanskrit": "अभिमन्युः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2158370, "chapter_id": 4429, "verse_number": "३७", "content_sanskrit": "अहमेकः प्रवेक्ष्यामि द्रोणानीकं सुदुर्भिदम् ।\nपतङ्ग इव सङ्क्रुद्धो ज्वलन्तं जातवेदसम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2158371, "chapter_id": 4429, "verse_number": "३८", "content_sanskrit": "तत् कर्माद्य करिष्यामि हितं यद् वंशयोर्द्वयोः ।\nमातुलस्य च या प्रीतिः भविष्यति पितुश्च मे\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2158372, "chapter_id": 4429, "verse_number": "३९", "content_sanskrit": "शिशुनैकेन संग्रामे द्विषत्सैन्यानि वै मया ।\nअद्य द्रक्ष्यन्ति राजानः काल्यमानानि सङ्घशः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2158373, "chapter_id": 4429, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2158374, "chapter_id": 4429, "verse_number": "४०", "content_sanskrit": "एवं ते भाषमाणस्य बलं सौभद्र वर्धताम् ।\nयस्त्वमुत्सहसे भेत्तुं द्रोणानीकं सुदुर्भिदम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2158375, "chapter_id": 4429, "verse_number": "४१", "content_sanskrit": "रक्षितं पुरुषव्याघ्रैर्महेष्वासैर्महारथैः ।\nसाध्यरुद्रमरुत्कल्पैर्वस्वग्न्यादित्यविक्रमैः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2158376, "chapter_id": 4429, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2158377, "chapter_id": 4429, "verse_number": "४२", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा स यन्तारमचोदयत् ।\nसुमित्राश्वान् रणे क्षिप्रं द्रोणानीकाय चोदय\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2158378, "chapter_id": 4429, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां द्रोणपर्वणि चतुस्त्रिंशोऽध्यायः ॥ ३४ ॥\nअभिमन्युवधपर्वणि तृतीयोऽध्यायः ॥ ३ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]