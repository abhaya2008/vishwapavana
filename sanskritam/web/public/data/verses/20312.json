[{"id": 7000312000, "chapter_id": 20312, "verse_number": "१-६६-१", "content_sanskrit": "व्यास उवाच ।\nभ्रातरं निहतं दृष्ट्वा कालेयो नाम दानवः ।\nचित्ररथं प्रदुद्राव धृत्वा बाणं सकार्मुकम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000312001, "chapter_id": 20312, "verse_number": "१-६६-२", "content_sanskrit": "दृष्ट्वासुरं विधावंतं कालमृत्युसमप्रभम् ।\nअरौत्सीत्तं महावीर्यो जयंतः पाकशासनिः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000312002, "chapter_id": 20312, "verse_number": "१-६६-३", "content_sanskrit": "अब्रवीच्च महातेजा दैतेयं सुरसत्तमः ।\nतथ्यं धर्माभिसंयुक्तं लोकद्वयहितं ध्रुवम्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000312003, "chapter_id": 20312, "verse_number": "१-६६-४", "content_sanskrit": "शस्त्राभिघातदुःखार्तं कश्मलं चान्यसंयुतम् ।\nप्रभग्नं च निरस्तं च यो हंति स च बालिशः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000312004, "chapter_id": 20312, "verse_number": "१-६६-५", "content_sanskrit": "सुचिरं रौरवं भुक्त्वा तस्य दासो भवेच्चिरम् ।\nतस्मान्मामुं प्रयुध्यस्व युद्धधर्मस्थितो भव॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000312005, "chapter_id": 20312, "verse_number": "१-६६-६", "content_sanskrit": "जयंतमब्रवीद्वाक्यं कालेयः क्रोधमूर्च्छितः ।\nनिहत्य भ्रातृहंतारमथ त्वांहन्मि सांप्रतम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000312006, "chapter_id": 20312, "verse_number": "१-६६-७", "content_sanskrit": "ततस्तं चासुरश्रेष्ठं कालानलसमप्रभम् ।\nजयंतो निशितैर्बाणैर्जघान सुरसत्तमः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000312007, "chapter_id": 20312, "verse_number": "१-६६-८", "content_sanskrit": "निचकर्त्त शरान्सोपि त्रिभिर्विव्याध चासुरः ।\nयथावृष्टिगणं प्राप्य नदी गैरिकवाहिनी॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000312008, "chapter_id": 20312, "verse_number": "१-६६-९", "content_sanskrit": "तथा तौ च महावीर्यौ न क्षीणौ न च कातरौ ।\nन शर्म परिलेभाते परस्परजयैषिणौ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000312009, "chapter_id": 20312, "verse_number": "१-६६-१०", "content_sanskrit": "अथ तस्य च दैत्यस्य धनुश्चिच्छेद चेषुणा ।\nयंतारं पंचभिर्बाणैः पातयामास भूतले॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000312010, "chapter_id": 20312, "verse_number": "१-६६-११", "content_sanskrit": "अष्टाभिर्निशितैर्बाणैश्चतुरोश्वानपातयात् ।\nशक्तिं संगृह्य भूमिष्ठः कुमारं च जघान ह॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000312011, "chapter_id": 20312, "verse_number": "१-६६-१२", "content_sanskrit": "गदया पीडितं साश्वं सवरूथं सकूबरम् ।\nपातयित्वा धरण्यां च सिंहनादं ननाद ह॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000312012, "chapter_id": 20312, "verse_number": "१-६६-१३", "content_sanskrit": "लाघवात्स धरां गत्वा गदापाणिरुपस्थितः ।\nवज्रपाताद्यथा शब्दो लोकानां दुःसहो भवेत्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000312013, "chapter_id": 20312, "verse_number": "१-६६-१४", "content_sanskrit": "तथा तयोर्गदापाते शब्दः स्यात्तु मुहुर्मुहुः ।\nएवं तयोर्गदायुद्धं यावदब्दचतुष्टयम्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000312014, "chapter_id": 20312, "verse_number": "१-६६-१५", "content_sanskrit": "प्रभग्ने ते गदे खस्थौ खड्गचर्मधरावुभौ ।\nतदा पदातिनोर्युद्धमद्भुतं लोमहर्षणं॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000312015, "chapter_id": 20312, "verse_number": "१-६६-१६", "content_sanskrit": "दृष्ट्वा च विस्मयं जग्मुर्देवासुरमहोरगाः ।\nखड्गपातैर्मुहूर्तांते तयोश्छिन्ने तु वर्मणी॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000312016, "chapter_id": 20312, "verse_number": "१-६६-१७", "content_sanskrit": "अभवत्खड्गयुद्धं च तयोर्युद्धातिशीलिनोः ।\nदधार चिकुरे तस्य जयंतो भीमविक्रमः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000312017, "chapter_id": 20312, "verse_number": "१-६६-१८", "content_sanskrit": "शिरश्छित्वास्य खड्गेन पातयामास भूतले ।\nततस्तु जयशब्देन देवाः सर्वे ननंदिरे॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000312018, "chapter_id": 20312, "verse_number": "१-६६-१९", "content_sanskrit": "प्रभग्ना दैत्यसंघाश्च दिशः सर्वाः प्रदुद्रुवुः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]