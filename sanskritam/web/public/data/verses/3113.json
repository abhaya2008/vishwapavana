[{"id": 2098715, "chapter_id": 3113, "verse_number": "१३-२४३-१", "content_sanskrit": "उमोवाच।\nदेवदेव नमस्तेऽस्तु कालसूदन शङ्कर।\nलोकेषु विविधा धर्मास्त्वत्प्रसादान्मया श्रुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2098716, "chapter_id": 3113, "verse_number": "१३-२४३-२", "content_sanskrit": "विशिष्टं सर्वधर्मेभ्यः शाश्वतं ध्रुवमव्ययम्।\nश्रुतुमिच्छाम्यहं सर्वमत्र मुह्यति मे मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2098717, "chapter_id": 3113, "verse_number": "१३-२४३-३", "content_sanskrit": "केचिन्मोक्षं प्रशंसन्ति केचिद्यज्ञफलं द्विजाः।\nवानप्रस्थं पुनः केचिद्गार्हस्थ्यं केचिदाश्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2098718, "chapter_id": 3113, "verse_number": "१३-२४३-४", "content_sanskrit": "राजधर्माश्रयं केचित्केचित्स्वाध्यायमेव च।\nब्रह्मचर्याश्रमं केचित्केचिद्वाक्संयमाश्रयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2098719, "chapter_id": 3113, "verse_number": "१३-२४३-५", "content_sanskrit": "मातरं पितरं केचित्सेवमाना दिवं गताः।\nअहिंसया परः स्वर्गे सत्येन च महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2098720, "chapter_id": 3113, "verse_number": "१३-२४३-६", "content_sanskrit": "आहवेऽभिमुखाः केचिन्निहतास्त्रिदिवं गताः।\nकेचिदुञ्छवृत्ते सिद्धाः स्वर्गमार्गं समाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2098721, "chapter_id": 3113, "verse_number": "१३-२४३-७", "content_sanskrit": "आर्जवेनापरे युक्ता महतां पूजते रताः।\nऋजवो नाकपृष्ठे तु शुद्धात्मानः प्रतिष्ठिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2098722, "chapter_id": 3113, "verse_number": "१३-२४३-८", "content_sanskrit": "एवं बहुविधैर्लोके धर्मद्वारैः सुसंवृतैः।\nममापि मतिराविद्धा मेघलेखेव वायुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2098723, "chapter_id": 3113, "verse_number": "१३-२४३-९", "content_sanskrit": "एतस्मिन्संशयस्थाने संशयच्छेदकारि यत्।\nवचनं ब्रूहि देवेश निश्चयज्ञानसंज्ञितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2098724, "chapter_id": 3113, "verse_number": "१३-२४३-१०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2098725, "chapter_id": 3113, "verse_number": "१३-२४३-१०", "content_sanskrit": "एवं पृष्टः स्वया देव्या महादेवः पिनाकधृक्।\nप्रोवाच मधुरं वाक्यं सूक्ष्ममध्यात्मसंश्रितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2098726, "chapter_id": 3113, "verse_number": "१३-२४३-११x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2098727, "chapter_id": 3113, "verse_number": "१३-२४३-११", "content_sanskrit": "न्यायतस्त्वं महाभागे श्रोतुकामाऽसि निश्चयम्।\nएतदेव विशिष्टं ते यत्त्वं पृच्छसि मां प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2098728, "chapter_id": 3113, "verse_number": "१३-२४३-१२", "content_sanskrit": "सर्वत्र विहितो धर्मः स्वर्गलोकफलाश्रितः।\nबहुद्वारस्य धर्मस्य नेहास्ति विफलाः क्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2098729, "chapter_id": 3113, "verse_number": "१३-२४३-१३", "content_sanskrit": "यस्मिन्यस्मिंश्च विषये योयो याति विनिश्चयम्।\nतं तमेवाभिजानाति नान्यं धर्मं शुचिस्मिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2098730, "chapter_id": 3113, "verse_number": "१३-२४३-१४", "content_sanskrit": "शृणु देवि समासेन मोक्षद्वारसमनुत्तमम्।\nएतद्धि सर्वधर्माणां विशिष्टं शुभमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2098731, "chapter_id": 3113, "verse_number": "१३-२४३-१५", "content_sanskrit": "नास्ति मोक्षात्परं देवि मोक्ष एव परा गतिः।\nसुखमात्यन्तिकं श्रेष्ठमनिवृत्तं च तद्विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2098732, "chapter_id": 3113, "verse_number": "१३-२४३-१६", "content_sanskrit": "नात्र देवि जरा मृत्युः शोको वा दुःखमेव वा।\nअनुत्तममचिन्त्यं च तद्देवि परमं सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2098733, "chapter_id": 3113, "verse_number": "१३-२४३-१७", "content_sanskrit": "ज्ञानानामुत्तमं ज्ञानं मोक्षज्ञानं विदुर्बुधाः।\nऋषिभिर्देवसङ्घैश्च प्रोच्यते परमं पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2098734, "chapter_id": 3113, "verse_number": "१३-२४३-१८", "content_sanskrit": "नित्यमक्षरमक्षोभ्यमजेयं शाश्वतं शिवम्।\nविशन्ति तत्पदं प्राज्ञाः स्पृहणीयं सुरोत्तमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2098735, "chapter_id": 3113, "verse_number": "१३-२४३-१९", "content_sanskrit": "दुःखादिश्च दुरन्तश्च संसारोयं प्रकीर्तितः।\nशोकव्याधिजरादोषैर्मरणेन च संयुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2098736, "chapter_id": 3113, "verse_number": "१३-२४३-२०", "content_sanskrit": "यथा ज्योतिर्गणा व्योम्नि विवर्तन्ते पुनःपुनः।\nतस्य मोक्षस्य मार्गोऽयं श्रुयतां शुभलक्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2098737, "chapter_id": 3113, "verse_number": "१३-२४३-२१", "content_sanskrit": "ब्रह्मादिस्थावरान्तश्च संसारो यः प्रकीर्तितः।\nसंसारे प्राणिनः सर्वे निवर्तन्ते यथा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2098738, "chapter_id": 3113, "verse_number": "१३-२४३-२२", "content_sanskrit": "तत्र संसारचक्रस्य मोक्षो ज्ञानेन दृश्यते।\nअध्यात्मतत्वविज्ञानं ज्ञानमित्यभिधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2098739, "chapter_id": 3113, "verse_number": "१३-२४३-२३", "content_sanskrit": "ज्ञानस्य ग्रहणोपायमाचारं ज्ञानिनस्तथा।\nयथावत्सम्प्रवक्ष्यामि तत्त्वमेकमनाः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2098740, "chapter_id": 3113, "verse_number": "१३-२४३-२४", "content_sanskrit": "ब्राह्मणः क्षत्रियो वाऽपि भूत्वा पूर्वं गृहे स्थितः।\nआनृण्यं सर्वतः प्राप्य ततस्तान्संत्यजेद्गृहान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2098741, "chapter_id": 3113, "verse_number": "१३-२४३-२५", "content_sanskrit": "ततः संत्यज्य गार्हस्थ्यं निश्चितो वनमाश्रयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2098742, "chapter_id": 3113, "verse_number": "१३-२४३-२६", "content_sanskrit": "वने गुरुं समाज्ञाय दीक्षितो विधिपूर्वकम्।\nदीक्षां प्राप्य यथान्यायं स्ववृत्तं परिपालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2098743, "chapter_id": 3113, "verse_number": "१३-२४३-२७", "content_sanskrit": "गृह्णीयादप्युपाध्यायान्मोक्षज्ञानमनिन्दितः।\nद्विविधं च पुनर्मोक्षं साङ्ख्ययोगमिति स्मृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2098744, "chapter_id": 3113, "verse_number": "१३-२४३-२८", "content_sanskrit": "पञ्चविंशतिविज्ञानं साङ्ख्यमित्यभिधीयते।\nऐश्वर्यं देवसारूप्यं योगशास्त्रस्य निर्णयः।\nतयोरन्यतरं ज्ञानं शृणुयाच्छिष्यतां गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2098745, "chapter_id": 3113, "verse_number": "१३-२४३-२९", "content_sanskrit": "नाकालो नाप्यकाषायी नाप्यसंवत्सरोषितः।\nनासाङ्ख्ययोगो नाश्राद्धं गुरुणा स्नेहपूर्वकम्।\nसमः शीतोष्णहर्षादीन्विषहेत स वै मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2098746, "chapter_id": 3113, "verse_number": "१३-२४३-३०", "content_sanskrit": "अमृष्यः क्षुत्पिपासाभ्यामुचितेभ्यो निवर्तयेत्।\nत्यजेत्सङ्कल्पजान्ग्रन्थीन्सदा ध्यानपरो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2098747, "chapter_id": 3113, "verse_number": "१३-२४३-३१", "content_sanskrit": "कुण्डिकाचमसं शिक्यं छत्रं यष्टिमुपानहौ।\nचेलमित्येव नैतेषु स्थापयेत्साम्यमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2098748, "chapter_id": 3113, "verse_number": "१३-२४३-३२", "content_sanskrit": "गुरोः पूर्वं समुत्तिष्ठेज्जघन्यं तस्य संविशेत्।\nनैवाविज्ञाप्य भर्तारमावश्यकमपि व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2098749, "chapter_id": 3113, "verse_number": "१३-२४३-३३", "content_sanskrit": "द्विरह्नि स्नानशाटेन संध्ययोरभिषेचनम्।\nएककालाशनं चास् विहितं यतिभिः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2098750, "chapter_id": 3113, "verse_number": "१३-२४३-३४", "content_sanskrit": "भैक्षं सर्वत्र गृह्णीयाच्चिन्तयेत्सततं निशि।\nकारणे चापि सम्प्राप्ते न ज्ञाप्येत कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2098751, "chapter_id": 3113, "verse_number": "१३-२४३-३५", "content_sanskrit": "ब्रह्मिचर्यं वने वासं शौचमिन्द्रियसंयमः।\nदया च सर्वभूतेषु तस्य धर्मः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2098752, "chapter_id": 3113, "verse_number": "१३-२४३-३६", "content_sanskrit": "विमुक्तः सर्वपापेभ्यो लघ्वाहारो जितेन्द्रियः।\nआत्मयुक्तः परां बुद्धिं लभते पापनाशिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2098753, "chapter_id": 3113, "verse_number": "१३-२४३-३७", "content_sanskrit": "यदा भावं न कुरुते सर्वभूतेषु पापकम्।\nकर्मणा मनसा वाचा ब्र्हम सम्पद्यते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2098754, "chapter_id": 3113, "verse_number": "१३-२४३-३८", "content_sanskrit": "अनिष्ठुरोऽनहङ्कारो निर्द्वन्द्वो वीतमत्सरः।\nवीतशोकभयाबाधं पदं प्राप्नोत्यनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2098755, "chapter_id": 3113, "verse_number": "१३-२४३-३९", "content_sanskrit": "तुल्यनिन्दास्तुतिर्मौनी समलोष्टाश्मकाञ्चनः।\nसमः शत्रौ च मित्रे च निर्वाणमधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2098756, "chapter_id": 3113, "verse_number": "१३-२४३-४०", "content_sanskrit": "एवं युक्तसमाचारस्तत्परोऽध्यात्मचिन्तकः।\nज्ञानाभ्यासेन तेनैव प्राप्नोति परमां गतिम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2098757, "chapter_id": 3113, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि त्रिचत्वारिंशदधिकद्विशततमोऽध्यायः॥ २४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]