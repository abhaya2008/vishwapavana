[{"id": 7006519000, "chapter_id": 26519, "verse_number": "३-५८-१", "content_sanskrit": "रणाजेः एकचक्रस्य सार्द्धं, मृगव्याधस्य बलासुरेण, अजैकपादस्य राहोः, सुधूम्राक्षस्य केशीदैत्येन सार्द्धं युद्धस्य वर्णनम् वैशम्पायन उवाच तत्रैव तु महायुद्धे रणाजिर्देवसत्तमः ।\nयुध्यते सह दैत्येन एकचक्रेण धीमता ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006519001, "chapter_id": 26519, "verse_number": "३-५८-२", "content_sanskrit": "प्रच्छाद्य रथपन्थानमुत्क्रोशंश्च महाबलः ।\nएकचक्रस्य सैन्यं तच्छरवर्षैरवाकिरत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006519002, "chapter_id": 26519, "verse_number": "३-५८-३", "content_sanskrit": "महासुरा महावीर्या महापट्टिशयोधिनः ।\nशूलानि च भुशुण्डीश्च क्षिपन्ति स्म महारणे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006519003, "chapter_id": 26519, "verse_number": "३-५८-४", "content_sanskrit": "तच्छूलवर्षं सुमहद्गदाशक्तिसमाकुलम् ।\nअविशद् दितिजैर्मुक्तं दुर्निवार्यं चराचरैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006519004, "chapter_id": 26519, "verse_number": "३-५८-५", "content_sanskrit": "अन्योन्यमभिवर्तन्ते देवासुरगणा युधि ।\nमहाद्रिशिखराकारा वीर्यवन्तो महाबलाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006519005, "chapter_id": 26519, "verse_number": "३-५८-६", "content_sanskrit": "तुरङ्गमाणां तु शतं युक्तं तस्य महारथे ।\nमहासुरवरस्येव हिरण्यकशिपोर्युधि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006519006, "chapter_id": 26519, "verse_number": "३-५८-७", "content_sanskrit": "तेषां चरणपातेन चक्रनेमिस्वनेन च ।\nतथा बाणनिपातैश्च हता वै शतशः सुराः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006519007, "chapter_id": 26519, "verse_number": "३-५८-८", "content_sanskrit": "ततः स लघुभिश्चित्रैः शरैः संनतपर्वभिः ।\nसायुधानच्छिनत्क्रुद्धः शतशोऽथ सहस्रशः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006519008, "chapter_id": 26519, "verse_number": "३-५८-९", "content_sanskrit": "वध्यमानाः शरैस्तीक्ष्णै रथद्विरदवाजिनः ।\nगमिताः प्रक्षयं केचित् त्रिदशैर्दानवा रणे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006519009, "chapter_id": 26519, "verse_number": "३-५८-१०", "content_sanskrit": "ततः प्रमीयमाणास्तानुपप्रेक्ष्य दितेः सुताः ।\nत्यक्त्वा प्राणान् न्यवर्तन्त प्रगृहीतवरायुधाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006519010, "chapter_id": 26519, "verse_number": "३-५८-११", "content_sanskrit": "ते दिशो विदिशश्चैव प्रतियुद्धप्रहारिणः ।\nअभ्यघ्नन् निशितैः शस्त्रैर्देवान्दितिसुता रणे ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006519011, "chapter_id": 26519, "verse_number": "३-५८-१२", "content_sanskrit": "रणाजिर्ज्वलितं घोरं परमं तिग्मतेजसम् ।\nमुमोचास्त्रं महाबाहुर्मथनं नाम संयुगे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006519012, "chapter_id": 26519, "verse_number": "३-५८-१३", "content_sanskrit": "ततः शस्त्राणि शूलानि निशितानि सहस्रशः ।\nअस्त्रवीर्येण महता दितिजः सम्प्रचिच्छिदे ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006519013, "chapter_id": 26519, "verse_number": "३-५८-१४", "content_sanskrit": "छित्त्वा शूलेन तान् सर्वानेकचक्रो महासुरः ।\nअभ्यविध्वत तं साध्यं दशभिर्निशितैः शरैः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006519014, "chapter_id": 26519, "verse_number": "३-५८-१५", "content_sanskrit": "अस्त्रवेगं निहत्यैवं सोऽस्त्रैस्तस्यानुसैनिकान् ।\nज्वलितैरपरैः शीघ्रैस्तानविध्यत् सहस्रशः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006519015, "chapter_id": 26519, "verse_number": "३-५८-१६", "content_sanskrit": "तेषां छिन्नानि गात्राणि विसृजन्ति स्म शोणितम् ।\nप्रावृषीवास्त्रवृष्टीनि शृङ्गाणि धरणीभृताम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006519016, "chapter_id": 26519, "verse_number": "३-५८-१७", "content_sanskrit": "इन्द्राशनिसमस्पशैर्निपतद्भिरजिह्मगैः ।\nदितिजैर्बध्यमानास्ते वित्रेसुः सुरसत्तमाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006519017, "chapter_id": 26519, "verse_number": "३-५८-१८", "content_sanskrit": "एकचक्रो रथे तिष्ठन्नपश्यद् गजयूथपान् ।\nवराभरणनिर्ह्रादान् समुद्रस्वननिःस्वनान् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006519018, "chapter_id": 26519, "verse_number": "३-५८-१९", "content_sanskrit": "मत्तान् सुविहितान् दृप्तान् महामात्रैरधिष्ठितान् ।\nकुलीनान् वीर्यसम्पन्नान् प्रतिद्विरदघातिनः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006519019, "chapter_id": 26519, "verse_number": "३-५८-२०", "content_sanskrit": "शिक्षितान् गजशिक्षायामैरावतसमान् युधि ।\nन्यहनत् सुरसैन्यस्य गजान् गज इवासुरः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006519020, "chapter_id": 26519, "verse_number": "३-५८-२१", "content_sanskrit": "विक्षरन्तो महानागान् भीमवेगांस्त्रिधा मदम् ।\nमेघस्तनितनिर्घोषान् महाद्रीनिव चोत्थितान् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006519021, "chapter_id": 26519, "verse_number": "३-५८-२२", "content_sanskrit": "सहस्रसम्मितान् दिव्याञ्जाम्बूनदपरिष्कृतान् ।\nसुवर्णजालैर्विततांस्तरुणादित्यवर्चसः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006519022, "chapter_id": 26519, "verse_number": "३-५८-२३", "content_sanskrit": "एकचक्रो गदापाणिर्बलवान् गदिनां वरः ।\nउत्सारयामास गजान् महाभ्राणीव मारुतः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006519023, "chapter_id": 26519, "verse_number": "३-५८-२४", "content_sanskrit": "निहत्य गदया सर्वांस्तान् गजान् गजमर्दनः ।\nभूयोऽश्वसंघान् स बली निरैक्षत महासुरः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006519024, "chapter_id": 26519, "verse_number": "३-५८-२५", "content_sanskrit": "शुकवर्णानृष्यवर्णान् मयूरसदृशांस्तथा ।\nपारावतसवर्णांश्च हंसवर्णांस्तथैव च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006519025, "chapter_id": 26519, "verse_number": "३-५८-२६", "content_sanskrit": "मल्लिकाक्षान् विरूपाक्षान् क्रौञ्चवर्णान् मनोजवान् ।\nअश्वसैन्यं महाबाहुस्तदप्रतिमपौरुषः ।\nनिषूदयामास बली गदया भीमविक्रमः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006519026, "chapter_id": 26519, "verse_number": "३-५८-२७", "content_sanskrit": "रणाजिर्व्यस्य समरे सर्वान् दृष्ट्वा सुरद्विषः ।\nअजिन्त्यविक्रमः श्रीमान् स युद्धाद् विरराम ह ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006519027, "chapter_id": 26519, "verse_number": "३-५८-२८", "content_sanskrit": "गदायुद्धेषु कुशलो रथेन रथयूथपः ।\nनष्टसैन्यो महाबाहुः प्रस्थितः शक्रसंनिधौ ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006519028, "chapter_id": 26519, "verse_number": "३-५८-२९", "content_sanskrit": "त्रिंशच्छतसहस्राणि रथानां विनिहत्य सः ।\nरणेऽतिष्ठत दैत्येन्द्रो विधूम इव पावकः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006519029, "chapter_id": 26519, "verse_number": "३-५८-३०", "content_sanskrit": "तस्मिन्तेव तु संग्रामे बलो दृप्तो महासुरः ।\nमृगव्याधं महात्मानं योधयत्यजितं रणे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006519030, "chapter_id": 26519, "verse_number": "३-५८-३१", "content_sanskrit": "मृगव्याधस्य रुद्रस्य महापारिषदास्तथा ।\nसमुत्पेतुर्बलं दृष्ट्वा हुताग्निसमतेजसः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006519031, "chapter_id": 26519, "verse_number": "३-५८-३२", "content_sanskrit": "गजैर्मत्तै रथैर्दिव्यैर्वाजिभिश्च महाजवैः ।\nअस्त्रैश्च निशितैर्बाणैः शरैश्चानलसंनिभैः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006519032, "chapter_id": 26519, "verse_number": "३-५८-३३", "content_sanskrit": "ददृशुस्ते ततो वीरा दीप्यमानं महासुरम् ।\nरश्मिवन्तमिवोद्यन्तं सुतेजोरश्मिमालिनम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006519033, "chapter_id": 26519, "verse_number": "३-५८-३४", "content_sanskrit": "संग्रामस्थं महावेगं महासत्त्वं महाबलम् ।\nमहामतिं महोत्साहं महाकायं महारथम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006519034, "chapter_id": 26519, "verse_number": "३-५८-३५", "content_sanskrit": "समीक्ष्य तं महायोधं दिक्षु सर्वास्ववस्थितम् ।\nततः प्रहरणैर्घोरैरभिपेतुः समन्ततः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006519035, "chapter_id": 26519, "verse_number": "३-५८-३६", "content_sanskrit": "तस्य सर्वायसास्तीक्ष्णाः शराः पीतमुखाः शिताः ।\nशिरस्यद्रिप्रतीकाशे मृगव्याधेन पातिताः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006519036, "chapter_id": 26519, "verse_number": "३-५८-३७", "content_sanskrit": "तैश्च सप्तभिराविष्टः शरैः शिरसि चार्पितैः ।\nउत्पपात तदा व्योम्नि दिशो दश विनादयन् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006519037, "chapter_id": 26519, "verse_number": "३-५८-३८", "content_sanskrit": "ततस्तं त्रिदशो वीरः सरथः सज्जकार्मुकः ।\nअनुवव्राज संहृष्टः खे तदा स महाबलः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006519038, "chapter_id": 26519, "verse_number": "३-५८-३९", "content_sanskrit": "असुरं छादयामास तं व्योम्नि शरवृष्टिभिः ।\nवृष्टिमानिव जीमूतो निदाघान्ते धराधरम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006519039, "chapter_id": 26519, "verse_number": "३-५८-४०", "content_sanskrit": "अर्द्यमानस्ततस्तेन मृगव्याधेन दानवः ।\nचकार निनदं घोरमम्बरे जलदो यथा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006519040, "chapter_id": 26519, "verse_number": "३-५८-४१", "content_sanskrit": "स दूरं सहसोत्पत्य मृगव्याधरथं प्रति ।\nनिपपात महावेगः पक्षवातैर्गिरिर्यथा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006519041, "chapter_id": 26519, "verse_number": "३-५८-४२", "content_sanskrit": "बभञ्ज च ततो दैत्यो भग्नेषाकूबरं रथम् ।\nमृगव्याधः परित्यज्य स्थितो भूमौ महाबलः॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006519042, "chapter_id": 26519, "verse_number": "३-५८-४३", "content_sanskrit": "विरथं प्रेक्ष्य रुद्रं तु तस्य पारिषदाः शुभाः ।\nउत्थिता घोररक्ताक्षा व्योम्नि मुद्गरपाणयः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006519043, "chapter_id": 26519, "verse_number": "३-५८-४४", "content_sanskrit": "स तैः सहसोत्थाय वेष्टितो विमलेऽम्परे ।\nभीमेर्भ्रूकः परशुभिर्यथा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006519044, "chapter_id": 26519, "verse_number": "३-५८-४५", "content_sanskrit": "तेषां वेगवतां वेगं निहत्य स महारथः ।\nनिपपात पुनर्भूमौ सुपर्णसमविक्रमः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006519045, "chapter_id": 26519, "verse_number": "३-५८-४६", "content_sanskrit": "स शालवृक्षमुत्पाट्य महाशासं महाबलः ।\nसर्वान् पारिषदान्संणये सूदयामास दानवः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006519046, "chapter_id": 26519, "verse_number": "३-५८-४७", "content_sanskrit": "स तैर्विक्षतदेहस्तु रुधिरौघपरिप्लुतः ।\nशुशुभे दानवश्रेष्ठो बालसूर्य इवोदितः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006519047, "chapter_id": 26519, "verse_number": "३-५८-४८", "content_sanskrit": "अथोत्पाट्य गिरेः शृङ्गं समृगव्यालपादपम् ।\nजघान तान् पारिषदान् समरे दानवेश्वरः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006519048, "chapter_id": 26519, "verse_number": "३-५८-४९", "content_sanskrit": "ततस्तेपु च भग्नेषु महापारिवदेतु वै ।\nबलं तदवशेषं तु नाशयामास वीर्यवान् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006519049, "chapter_id": 26519, "verse_number": "३-५८-५०", "content_sanskrit": "अल्पैरश्वादगणैर्नागान् योधान्योधे रथान्रथैः ।\nदानवः स्त्वयामास युगान्तेऽन्तकवत्प्रजाः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006519050, "chapter_id": 26519, "verse_number": "३-५८-५१", "content_sanskrit": "हतैरश्वैश्च नागैश्च भग्नाक्षैश्च महारथैः ।\nत्रिदशैश्चाभवद् भूमी रुद्धमार्गा समन्ततः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006519051, "chapter_id": 26519, "verse_number": "३-५८-५२", "content_sanskrit": "एवं बलः स दैत्येन्द्रो मृगव्याधश्च वीर्यवान् ।\nयुधि प्रवृद्धौ बलिनौ प्रभिन्नाविव वारणौ ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006519052, "chapter_id": 26519, "verse_number": "३-५८-५३", "content_sanskrit": "वैशम्पायन उवाच तत्रैव युध्यते रुद्रो द्वितीयो राहुणा सह ।\nविश्रुतस्त्रिषु लोकेषु क्रोधात्मा ह्यज एकपात् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006519053, "chapter_id": 26519, "verse_number": "३-५८-५४", "content_sanskrit": "तत् यथा सुमहद् युद्धं तुमुलं लोमहर्षणम् ।\nआसीत्प्रतिभयं रौद्रं वीराणां जयमिच्छताम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006519054, "chapter_id": 26519, "verse_number": "३-५८-५५", "content_sanskrit": "देवदानवदेहैस्तु दुस्तरा केशशाद्वला ।\nशरीरसंघातवहा प्रसृता लोहितापगा ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006519055, "chapter_id": 26519, "verse_number": "३-५८-५६", "content_sanskrit": "आजघानाथ संक्रुद्धो रुद्रो रौद्राकृतिः प्रभुः ।\nराहुं शतमुखं युद्धे शत्रुसैन्यनिवारणम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006519056, "chapter_id": 26519, "verse_number": "३-५८-५७", "content_sanskrit": "तस्य काञ्चनचित्राङ्गं रथं साश्वं ससारथिम् ।\nजघान समरे श्रीमान् क्रुद्धो दैत्यस्य सायकैः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006519057, "chapter_id": 26519, "verse_number": "३-५८-५८", "content_sanskrit": "तस्य पारिषदस्त्वेकः शरशक्त्या महाबलः ।\nबिभेद समरे हृष्टो दानवं तं स्तनान्तरे ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006519058, "chapter_id": 26519, "verse_number": "३-५८-५९", "content_sanskrit": "स भिन्नगात्रो रुद्रेण तथा पारिषदैरपि ।\nरुद्रस्य रथमायान्तं स राहुर्दानवोत्तमः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006519059, "chapter_id": 26519, "verse_number": "३-५८-६०", "content_sanskrit": "प्रममाथ तलेनाशु सहसा क्रोधमूर्च्छितः ।\nभिन्नगात्रं शरैस्तीक्ष्णैर्मेरुं सूर्य इवांशुभिः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006519060, "chapter_id": 26519, "verse_number": "३-५८-६१", "content_sanskrit": "हतैर्दानवमुख्यैस्तु रुद्रेणामिततेजसा ।\nरुद्रपारिषदान् सर्वान् निजघान महासुरः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006519061, "chapter_id": 26519, "verse_number": "३-५८-६२", "content_sanskrit": "सृजन्तं शरवर्षाणि दानवं घोरदर्शनम् ।\nबिभेद समरे रुद्रो बाणैः संनतपर्वभिः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006519062, "chapter_id": 26519, "verse_number": "३-५८-६३", "content_sanskrit": "वर्तमाने महाघोरे संग्रामे लोमहर्षणे ।\nरुधिरौघा महावेगा महानद्यः प्रसुस्रवुः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006519063, "chapter_id": 26519, "verse_number": "३-५८-६४", "content_sanskrit": "दानवं समरे रुद्रो नीलाञ्जनचयोपमम् ।\nनिर्बिभेद शरैस्तीक्ष्णैर्मेरुं सूर्य इवांशुभिः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006519064, "chapter_id": 26519, "verse_number": "३-५८-६५", "content_sanskrit": "हतैर्दानवमुख्यैश्च शक्तिशूलपरश्वधैः ।\nपतितैः पर्वताभैश्च दानवैः कामरूपिभिः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006519065, "chapter_id": 26519, "verse_number": "३-५८-६६", "content_sanskrit": "वर्तमाने महाघोरे संग्रामे लोमहर्षणे ।\nविरेजुस्ते तदा दैत्याः पुष्पिता इव किंशुकाः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006519066, "chapter_id": 26519, "verse_number": "३-५८-६७", "content_sanskrit": "महाभेरीमृदङ्गानां पणवानां च निःस्वनः ।\nशङ्खवेणुस्वनोन्मिश्रः सम्बभूवाद्भुतोपमः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006519067, "chapter_id": 26519, "verse_number": "३-५८-६८", "content_sanskrit": "हतानां स्वनतां तत्र दैत्यानां चापि निःस्वनः ।\nदेवानां च तथा तत्र शुश्रुवे दारुणो महान् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006519068, "chapter_id": 26519, "verse_number": "३-५८-६९", "content_sanskrit": "तुरङ्गमखुरोत्कीर्णं रथनेमिसमुत्थितम् ।\nरुरोध मार्गं योधानां चक्षूंषि च धरारजः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006519069, "chapter_id": 26519, "verse_number": "३-५८-७०", "content_sanskrit": "शस्त्रपुष्पोपहारा सा तत्रासीद् युद्धमेदिनी ।\nदुर्दर्शा दुर्विगाह्या च मांसशोणितकर्दमा ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006519070, "chapter_id": 26519, "verse_number": "३-५८-७१", "content_sanskrit": "भग्नैः खड्गैर्गदाभिश्च शक्तितोमरपट्टिशैः ।\nअपविद्धैश्च भग्नैश्च रथैः सांग्रामिकैर्हतैः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006519071, "chapter_id": 26519, "verse_number": "३-५८-७२", "content_sanskrit": "निहतैः कुञ्जरैर्मत्तैस्तथा त्रिदशदानवैः ।\nचक्राक्षयुगशस्त्रैश्च भग्नैरवनिपातितैः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006519072, "chapter_id": 26519, "verse_number": "३-५८-७३", "content_sanskrit": "बभूवायोधनं घोरं पिशिताशनसंकुलम् ।\nउत्पेतुश्च कबन्धानि दिक्षु सर्वासु संयुगे ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006519073, "chapter_id": 26519, "verse_number": "३-५८-७४", "content_sanskrit": "अन्योन्यबद्धवैराणां दैत्यानां जयगृद्धिनाम् ।\nसम्प्रहारस्तथा युद्धे वर्ततेऽतिभयंकरः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006519074, "chapter_id": 26519, "verse_number": "३-५८-७५", "content_sanskrit": "सैन्यानां सम्प्रयुद्धानां शूराणामनिवर्तिनाम् ।\nअजस्य चैकपादस्य राहोश्चैव महात्मनः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006519075, "chapter_id": 26519, "verse_number": "३-५८-७६", "content_sanskrit": "तेषां तु तत्र पततां क्रुद्धानाशतिनिःस्वनः ।\nउद्वर्त इव भूतानां समुद्राणां तु शुश्रुवे ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006519076, "chapter_id": 26519, "verse_number": "३-५८-७७", "content_sanskrit": "तत्रैकस्तु सुधूम्राक्षः श्रीमान् रुद्रो मुनीश्वरः ।\nबिभेद केशिनं शक्त्या गदापरिघशूलभृत् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006519077, "chapter_id": 26519, "verse_number": "३-५८-७८", "content_sanskrit": "नानाप्रहरणा घोरा भीमाक्षा भीमविक्रमाः ।\nनिष्पेतू रुद्रदयिता महापारिषदास्तथा ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006519078, "chapter_id": 26519, "verse_number": "३-५८-७९", "content_sanskrit": "रथमास्थाय च श्रीमांस्तप्तकाञ्चनकुण्डलः ।\nदानवैः संवृतः केशी युध्यते युद्धदुर्जयैः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006519079, "chapter_id": 26519, "verse_number": "३-५८-८०", "content_sanskrit": "तस्य संग्रामशौण्डस्य संग्रामेषु युयुत्सतः ।\nनिपेतुरुग्रवीर्यस्य ज्वाला हि प्रसृता मुखात् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006519080, "chapter_id": 26519, "verse_number": "३-५८-८१", "content_sanskrit": "स तु सिंहर्षभस्कन्धः शार्दूलसमविक्रमः ।\nमहाजलदसंकाशो मृदङ्गध्वनिनिःस्वनः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006519081, "chapter_id": 26519, "verse_number": "३-५८-८२", "content_sanskrit": "तस्य निष्पतमानस्य दानवैः संवृतस्य च ।\nबभूव सुमहानादः क्षोभयंस्त्रिदिवं यथा ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006519082, "chapter_id": 26519, "verse_number": "३-५८-८३", "content_sanskrit": "तेन शब्देन वित्रस्ता त्रिदशानां महाचमूः ।\nद्रुमशैलप्रहरणा योद्धुमेवाभ्यवर्तत ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006519083, "chapter_id": 26519, "verse_number": "३-५८-८४", "content_sanskrit": "तेषां च देवदैत्यानां युयुत्सूनां परस्परम् ।\nसंनिपातः सुतुमुलो रौद्रो लोकभयावहः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006519084, "chapter_id": 26519, "verse_number": "३-५८-८५", "content_sanskrit": "तेषां युद्धं महाघोरं संजज्ञे लोमहर्षणम् ।\nदेवदानवसंघानां प्राणांस्त्यक्त्वा महाहवे ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006519085, "chapter_id": 26519, "verse_number": "३-५८-८६", "content_sanskrit": "सर्वे ह्यतिबलाः शूरा सर्वे पर्वतसंनिभाः ।\nसर्वे सर्वास्त्रविद्वांसः सर्वे सर्वायुधोद्यताः ।\nत्रिदशा दानवाश्चैव परस्परजिघांसवः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006519086, "chapter_id": 26519, "verse_number": "३-५८-८७", "content_sanskrit": "तेषां वै नदतां शब्दः संयुगे मेघनिःस्वनः ।\nशुश्रुवेऽतिमहाघोरश्चरस्थावरकम्पनः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006519087, "chapter_id": 26519, "verse_number": "३-५८-८८", "content_sanskrit": "रेणुश्चारुणसंकाशो भीमः स समपद्यत ।\nउद्भूतो देवदैत्यौघैः संरुरोध दिशो दश ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006519088, "chapter_id": 26519, "verse_number": "३-५८-८९", "content_sanskrit": "अन्योन्यं रजसा तेन कौशेयारुणपाण्डुना ।\nसंवृता बहुरूपेण ददृशुर्न च किंचन ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006519089, "chapter_id": 26519, "verse_number": "३-५८-९०", "content_sanskrit": "न ध्वजो न पताकाश्च न वर्म तुरगोऽपि वा ।\nआयुधं स्यन्दनो वापि दृश्यते नैव सारथिः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006519090, "chapter_id": 26519, "verse_number": "३-५८-९१", "content_sanskrit": "स शब्दस्तुमुलस्तेषामन्योन्यमभिधावताम् ।\nश्रूयते तुमुलः शब्दो न रूपाणि चकाशिरे ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006519091, "chapter_id": 26519, "verse_number": "३-५८-९२", "content_sanskrit": "दानवास्तत्र संक्रुद्धा दानवानेव जघ्निरे ।\nत्रिदशास्त्रिदशाश्चैव निजघ्नुस्तुमुले तदा ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006519092, "chapter_id": 26519, "verse_number": "३-५८-९३", "content_sanskrit": "ते परांश्च विनिघ्नन्तः स्वांश्च युद्धे महासुरान् ।\nरुधिरार्द्रा तथा चक्रुर्मेदिनीमसुराः सुराः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006519093, "chapter_id": 26519, "verse_number": "३-५८-९४", "content_sanskrit": "ततस्तु रुधिरौघेण संसिक्तमुदितं रजः ।\nशरीरशतसंकीर्णं बभूव धरणीतलम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006519094, "chapter_id": 26519, "verse_number": "३-५८-९५", "content_sanskrit": "शूलशक्तिगदाखड्गपरिघप्रासतोमरैः ।\nत्रिदशा दानवाश्चैव जघ्नुरन्योन्यमाहवे ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006519095, "chapter_id": 26519, "verse_number": "३-५८-९६", "content_sanskrit": "बाहुभिः परिघाकारैर्निघ्नतः परिघैस्तथा ।\nरुद्रपारिषदान् सर्वान् सूदयन्ति स्म दानवाः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006519096, "chapter_id": 26519, "verse_number": "३-५८-९७", "content_sanskrit": "रुद्रपारिषदाश्चैव महाद्रुममहाश्मभिः ।\nव्यदारयन्नतिक्रम्य शस्त्रैश्चादित्यसंनिभैः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006519097, "chapter_id": 26519, "verse_number": "३-५८-९८", "content_sanskrit": "एतस्मिन्नन्तरे क्रुद्धः केशी दानवसत्तमः ।\nसंग्रामामर्षघोरः सन् स्वान्यनीकानि हर्षयन् ।\nतेषां परमसंक्रुद्धो वज्रमस्त्रमुदीरयत् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7006519098, "chapter_id": 26519, "verse_number": "३-५८-९९", "content_sanskrit": "वज्रेणास्त्रेण दिव्येन शस्त्रेण च महात्मना ।\nमहापारिषदाः सर्वे निहता युधि दुर्जयाः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7006519099, "chapter_id": 26519, "verse_number": "३-५८-१००", "content_sanskrit": "वज्रास्त्रपीडिता भ्रान्ता रुद्रपारिषदा युधि ।\nविप्रकीर्णद्रुमाः पेतुः शैला वज्रहता इव ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7006519100, "chapter_id": 26519, "verse_number": "३-५८-१०१", "content_sanskrit": "एवं सुतुमुलं युद्धमभवल्लोमहर्षणम् ।\nकेशिनः सह रुद्रेण तदद्भुतमिवाभवत् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}]