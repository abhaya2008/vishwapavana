[{"id": 7003265000, "chapter_id": 23265, "verse_number": "१-६८-१", "content_sanskrit": "सूत उवाच  ।\nयदोर्वंशं प्रवक्ष्यामि ज्येष्ठस्योत्तमतेजसः  ।\nसंक्षेपेणानुपूर्व्याच्च गदतो मे निबोधत ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003265001, "chapter_id": 23265, "verse_number": "१-६८-२", "content_sanskrit": "यदोः पुत्रा बभूबुर्हि पञ्च देव सुतोपमाः  ।\nसहस्रजित्सुतो ज्येष्ठः क्रोष्टुर्नीलोजको लघुः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003265002, "chapter_id": 23265, "verse_number": "१-६८-३", "content_sanskrit": "सहस्रजित्सुतस्तद्वच्छतजिन्नाम पार्थिवः  ।\nसुताः शतजितः ख्यातास्त्रयः परमकीर्तयः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003265003, "chapter_id": 23265, "verse_number": "१-६८-४", "content_sanskrit": "हैहयश्च हयश्चैव राजा वेणुहयश्च यः  ।\nहैहयस्य तु दायादो धर्म इत्यभिविश्रुतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003265004, "chapter_id": 23265, "verse_number": "१-६८-५", "content_sanskrit": "तस्य पुत्रोभवद्विप्रा धर्म नेत्र इति श्रुतः  ।\nधर्मनेत्रस्य कीर्तिस्तु संजयस्तस्य चात्मजः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003265005, "chapter_id": 23265, "verse_number": "१-६८-६", "content_sanskrit": "सञ्जयस्य तु दायादो महिष्मान्नाम धार्मिकः  ।\nआसीन्माहिष्मतः पुत्रो भद्रश्रेण्यः प्रतापवान् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003265006, "chapter_id": 23265, "verse_number": "१-६८-७", "content_sanskrit": "भद्रश्रेण्यस्य दायादो दुर्दमो नाम पार्थिवः  ।\nदुर्दमस्य सुतो धीमान्धनको नाम विश्रुतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003265007, "chapter_id": 23265, "verse_number": "१-६८-८", "content_sanskrit": "धनकस्य तु दायादाश्चत्वारो लोकसंमताः  ।\nकृतवीर्यः कृताग्निश्च कृतवर्मा तथैव च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003265008, "chapter_id": 23265, "verse_number": "१-६८-९", "content_sanskrit": "कृतौजाश्च चतुर्थोभूत्कार्तवीर्यस्ततोर्जुनः  ।\nजज्ञे बाहुसहस्रेण सप्तद्वीपेश्वरोत्तमः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003265009, "chapter_id": 23265, "verse_number": "१-६८-१०", "content_sanskrit": "तस्य रामस्तदा त्वासीन्मृत्युर्नारायणात्मकः  ।\nतस्य पुत्रशतान्यासन्पंच तत्र महारथाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003265010, "chapter_id": 23265, "verse_number": "१-६८-११", "content_sanskrit": "कृतास्त्रा बलिनः शूरा धर्मात्मानो मनस्विनः  ।\nशूरश्च शूरसेनश्च धृष्टः कृष्णस्तथैव च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003265011, "chapter_id": 23265, "verse_number": "१-६८-१२", "content_sanskrit": "जयध्वजश्च राजासीदावन्तीनां विशां पतिः  ।\nजयध्वजस्य पुत्रोभूत्तालजंघो महाबलः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003265012, "chapter_id": 23265, "verse_number": "१-६८-१३", "content_sanskrit": "शतं पुत्रास्तु तस्येह तालजंघाः प्रकीर्तिताः  ।\nतेषां ज्येष्ठो महावीर्यो वीतिहोत्रोऽभवन्नृपः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003265013, "chapter_id": 23265, "verse_number": "१-६८-१४", "content_sanskrit": "वृषप्रभृतयश्चान्ये तत्सुताः पुण्यकर्मणः  ।\nवृषो वंशकरस्तेषां तस्य पुत्रोभवन्मधुः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003265014, "chapter_id": 23265, "verse_number": "१-६८-१५", "content_sanskrit": "मधोः पुत्रशतं चासीद्वृष्णिस्तस्य तु वंशभाक्  ।\nवृष्णेस्तु वृष्णयः सर्वे माधोर्वै माधवाः स्मृताः  ।\nयादवा यदुवंशेन निरुच्यन्ते तु हैहयाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003265015, "chapter_id": 23265, "verse_number": "१-६८-१६", "content_sanskrit": "तेषां पञ्च गणा ह्येते हैहयानां महात्मनाम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003265016, "chapter_id": 23265, "verse_number": "१-६८-१७", "content_sanskrit": "वीतिहोत्राश्च हर्याता भोजाश्चावन्तयस्तथा  ।\nशूरसेनास्तु विख्यातास्तालजंघास्तथैव च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003265017, "chapter_id": 23265, "verse_number": "१-६८-१८", "content_sanskrit": "शूरश्च शूरसेनश्च वृषः कृष्णस्तथैव च  ।\nजयध्वजः पंचमस्तु विख्याता हैहयोत्तमाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003265018, "chapter_id": 23265, "verse_number": "१-६८-१९", "content_sanskrit": "शूरश्च शूरवीरश्च शूरसेनस्य चानघाः  ।\nशूरसेना इति ख्याता देशास्तेषां महात्मनाम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003265019, "chapter_id": 23265, "verse_number": "१-६८-२०", "content_sanskrit": "वीतिहोत्रसुतश्चापि विश्रुतोऽनर्त इत्युत  ।\nदुर्जयः कृष्णपुत्रस्तु बभूवामित्रकर्शनः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003265020, "chapter_id": 23265, "verse_number": "१-६८-२१", "content_sanskrit": "क्रोष्टुश्च श्रृणु राजर्षे वंशमुत्तमपौरुषम्  ।\nयस्यान्वये तु संभूतो विष्णुर्विष्णुकुलोद्वहः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003265021, "chapter_id": 23265, "verse_number": "१-६८-२२", "content_sanskrit": "क्रोष्टोरेकोऽभवत्पुत्रो वृजिनीवान्महायशाः  ।\nतस्य पुत्रोभवत्स्वाती कुशंकुस्तत्सुतोभवत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003265022, "chapter_id": 23265, "verse_number": "१-६८-२३", "content_sanskrit": "अथ प्रसूतिमिच्छन्वै कुशंकुः सुमहाबलः  ।\nमहाक्रतुभिरीजेसौ विविधैराप्तदक्षिणैः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003265023, "chapter_id": 23265, "verse_number": "१-६८-२४", "content_sanskrit": "जज्ञे चित्ररथस्तस्य पुत्रः कर्मभिरन्वितः  ।\nअथ चैत्ररथो वीरो यज्वा विपुलदक्षिमः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003265024, "chapter_id": 23265, "verse_number": "१-६८-२५", "content_sanskrit": "शशबिंदुस्तु वै राजा अन्वयाद्व्रतमुत्तमम्  ।\nचक्रवर्ती महासत्त्वो महावीर्यो बहुप्रजाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003265025, "chapter_id": 23265, "verse_number": "१-६८-२६", "content_sanskrit": "शशबिंदोस्तु पुत्राणां सहस्राणामभूच्छतम्  ।\nशंसंति तस्य पुत्राणामनंतकमनुत्तमम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003265026, "chapter_id": 23265, "verse_number": "१-६८-२७", "content_sanskrit": "अनंतकात्सुतो यज्ञो यज्ञस्य तनयो धृतिः  ।\nउशनास्तस्य तनयः संप्राप्य तु महीमिमाम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003265027, "chapter_id": 23265, "verse_number": "१-६८-२८", "content_sanskrit": "आजहाराश्वमेधानां शतमुत्तमधार्मिकः  ।\nस्मृतश्चोशनसः पुत्रः सितेषुर्नाम पार्थिवः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003265028, "chapter_id": 23265, "verse_number": "१-६८-२९", "content_sanskrit": "मरुतस्तस्य तनयो राजर्षिर्वंशवर्धनः  ।\nवीरः कंबलबर्हिस्तु मरुस्तस्यात्मजः स्मृतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003265029, "chapter_id": 23265, "verse_number": "१-६८-३०", "content_sanskrit": "पुत्रस्तु रुक्मकवचो विद्वान्कंबलबर्हिषः  ।\nनिहत्य रुक्मकवचो रीरान्कवचिनो रणे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003265030, "chapter_id": 23265, "verse_number": "१-६८-३१", "content_sanskrit": "धन्विनो विशितैर्बाणैरवाप श्रियमुत्तमाम्  ।\nअश्वमेधे तु धर्मात्मा ऋत्विग्भ्यः पृथिवीं ददौ ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003265031, "chapter_id": 23265, "verse_number": "१-६८-३२", "content_sanskrit": "जज्ञे तु रुक्मकवचात्परावृत्परवीरहा  ।\nजज्ञिरे पंच पुत्रास्तु महासत्त्वाः परावृतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003265032, "chapter_id": 23265, "verse_number": "१-६८-३३", "content_sanskrit": "रुक्मेषुः पृथुरुक्मश्च ज्यामघः परिघं हरिः  ।\nपरिघं च हरिं चैव विदेहेषु पिता न्यसत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003265033, "chapter_id": 23265, "verse_number": "१-६८-३४", "content_sanskrit": "रुक्मेषुरभवद्राजा पृथुरुक्मस्तदाश्रयात्  ।\nतैस्तु प्रव्राजितो राजा ज्यामघोऽवसदाश्रमे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003265034, "chapter_id": 23265, "verse_number": "१-६८-३५", "content_sanskrit": "प्रशांतः स वनस्थोपि ब्राह्मणैरेव बोधितः  ।\nजगाम धनुरादाय देशमन्यं ध्वजी रथी ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003265035, "chapter_id": 23265, "verse_number": "१-६८-३६", "content_sanskrit": "नर्मदातीरमेकाकी केवलं भार्यया युतः  ।\nऋक्षवंतं गिरं गत्वा त्यक्तमन्यैरुवास सः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003265036, "chapter_id": 23265, "verse_number": "१-६८-३७", "content_sanskrit": "ज्यामघस्याभवद्भार्या शैब्या शीलवती सती  ।\nसा चैव तपसोग्रेण शैब्या वै संप्रसूयत ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003265037, "chapter_id": 23265, "verse_number": "१-६८-३८", "content_sanskrit": "सुतं विदर्भ सुभगा वयःपरिणता सती  ।\nराजपुत्रसुतायां तु विद्वांसौ क्रथकैशिकौ ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003265038, "chapter_id": 23265, "verse_number": "१-६८-३९", "content_sanskrit": "पुत्रौ विदर्भराजस्य शूरौ रणविशारदौ  ।\nरोमपादस्तृतीयश्च बभ्रुस्तस्यात्मजः स्मृतः ॥३९।।॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003265039, "chapter_id": 23265, "verse_number": "१-६८-४०", "content_sanskrit": "सुधृतिस्तनयस्तस्य विद्वान्परमधार्मिकः  ।\nकौशिकस्तनयस्तस्मात्तस्माच्चैद्यान्वयः स्मृतः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003265040, "chapter_id": 23265, "verse_number": "१-६८-४१", "content_sanskrit": "क्रथो विदर्भस्य सुतः कुंतिस्तस्यात्मजोऽभवत्  ।\nकुंतेर्वतस्ततो जज्ञे रणधृष्टः प्रतापवान् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003265041, "chapter_id": 23265, "verse_number": "१-६८-४२", "content_sanskrit": "रणधृष्टस्य च सुतो निधृतिः परवीरहा  ।\nदशार्हो नैधृतो नाम्ना महारिगणसूदनः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003265042, "chapter_id": 23265, "verse_number": "१-६८-४३", "content_sanskrit": "दर्शार्हस्य सुतो व्याप्तो जीमूत इति तत्सुतः  ।\nजीमूतपुत्रो विकृतिस्तस्य भीमरथः सुतः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003265043, "chapter_id": 23265, "verse_number": "१-६८-४४", "content_sanskrit": "अथ भीमरथस्यासीत्पुत्रो नवरथः किल  ।\nदानधर्मरतो नित्यं सत्यशीलपरायणः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003265044, "chapter_id": 23265, "verse_number": "१-६८-४५", "content_sanskrit": "तस्य चासीद्दृढरथः शकुनिस्तस्य चात्मजः  ।\nतस्मात्करंभः संभूतो देवरातोऽभवत्ततः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003265045, "chapter_id": 23265, "verse_number": "१-६८-४६", "content_sanskrit": "देवरातादभूद्राजा देवरातिर्महायशाः  ।\nदेवगर्भोपमो जज्ञे यो देवक्षत्रनामकः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003265046, "chapter_id": 23265, "verse_number": "१-६८-४७", "content_sanskrit": "देवक्षत्रसुतः श्रीमान् मधुर्नाम महायशाः  ।\nमधूनां वंशकृद्राजा मधोस्तु कुरुवंशकः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003265047, "chapter_id": 23265, "verse_number": "१-६८-४८", "content_sanskrit": "कुरुवंशादनुस्तस्मात्पुरुत्वात्पुरुषोत्तमः  ।\nअंशुर्जज्ञे च वैदर्भ्यां भद्रवत्यां पुरुत्वतः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003265048, "chapter_id": 23265, "verse_number": "१-६८-४९", "content_sanskrit": "ऐक्ष्वाकीमवहच्चांशुः सत्त्वस्तस्मादजायत  ।\nसत्त्वात्सर्वगुणोपेतः सात्त्वतः कुलवर्धनः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003265049, "chapter_id": 23265, "verse_number": "१-६८-५०", "content_sanskrit": "ज्यामघस्य मया प्रोक्ता सृष्टिर्वै विस्तरेण वः  ।\nयः पठेच्छृणुयाद्वापि निसृष्टिंज्यामघस्य तु ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003265050, "chapter_id": 23265, "verse_number": "१-६८-५१", "content_sanskrit": "प्रजीवत्येति वै स्वर्गं राज्यं सौख्यं च विंदति ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]