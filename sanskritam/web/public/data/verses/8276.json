[{"id": 900003064, "chapter_id": 8276, "verse_number": "10.1", "content_sanskrit": "भूय एव महाबाहो शृणु मे परमं वचः । यत्तेऽहं प्रीयमाणाय वक्ष्यामि हितकाम्यया ।। १ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900003065, "chapter_id": 8276, "verse_number": "10.2", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900003066, "chapter_id": 8276, "verse_number": "10.3", "content_sanskrit": "न मे विदुस्सुरगणाः प्रभवं न महर्षयः । अहमादिर्हि देवानां महर्षीणां च सर्वशः ।। २ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900003067, "chapter_id": 8276, "verse_number": "10.4", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900003068, "chapter_id": 8276, "verse_number": "10.5", "content_sanskrit": "यो मामजमनादिं च वेत्ति लोकमहेश्वरम् । असम्मूढः स मर्त्येषु सर्वपापैः प्रमुच्यते ।। ३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900003069, "chapter_id": 8276, "verse_number": "10.6", "content_sanskrit": "बुद्धिर्ज्ञानमसम्मोहः क्षमा सत्यं दमः शमः । सुखं दुःखं भवोऽभावो भयं चाभयमेव च ।। ४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900003070, "chapter_id": 8276, "verse_number": "10.7", "content_sanskrit": "अहिंसा समता तुष्टिस्तपो दानं यशोऽयशः । भवन्ति भावा भूतानां मत्त एव पृथग्विधाः ।। ५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900003071, "chapter_id": 8276, "verse_number": "10.8", "content_sanskrit": "महर्षयः सप्त पूर्वे चत्वारो मनवस्तथा । मद्भावा मानसा जाता येषां लोक इमाः प्रजाः ।। ६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900003072, "chapter_id": 8276, "verse_number": "10.9", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900003073, "chapter_id": 8276, "verse_number": "10.10", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900003074, "chapter_id": 8276, "verse_number": "10.11", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900003075, "chapter_id": 8276, "verse_number": "10.12", "content_sanskrit": "एतां विभूतिं योगं च मम यो वेत्ति तत्त्वतः । सोऽविकम्पेन योगेन युज्यते नात्र संशयः ।। ७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900003076, "chapter_id": 8276, "verse_number": "10.13", "content_sanskrit": "अहं सर्वस्य प्रभवो मत्तः सर्वं प्रवर्तते । इति मत्वा भजन्ते मां बुधा भावसमन्विताः ।। ८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900003077, "chapter_id": 8276, "verse_number": "10.14", "content_sanskrit": "मच्चित्ता मद्गतप्राणा बोधयन्तः परस्परम् । कथयन्तश्च मां नित्यं तुष्यन्ति च रमन्ति च ।। ९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900003078, "chapter_id": 8276, "verse_number": "10.15", "content_sanskrit": "तेषां सततयुक्तानां भजतां प्रीतिपूर्वकम् । ददामि बुद्धियोगं तं येन मामुपयान्ति ते ।। १० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900003079, "chapter_id": 8276, "verse_number": "10.16", "content_sanskrit": "तेषामेवानुकम्पार्थमहमज्ञानजं तमः । नाशयाम्यात्मभावस्थो ज्ञानदीपेन भास्वता ।। ११ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900003080, "chapter_id": 8276, "verse_number": "10.17", "content_sanskrit": "परं ब्रह्म परं धाम पवित्रं परमं भवान् । पुरुषं शाश्वतं दिव्यमादिदेवमजं विभुम् ।। १२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900003081, "chapter_id": 8276, "verse_number": "10.18", "content_sanskrit": "आहुस्त्वामृषयः सर्वे देवर्षिर्नारदस्तथा । असितो देवलो व्यासः स्वयं चैव ब्रवीषि मे ।। १३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900003082, "chapter_id": 8276, "verse_number": "10.19", "content_sanskrit": "सर्वमेतदृतं मन्ये यन्मां वदसि केशव । न हि ते भगवन् व्यक्तिं विदुर्देवा न दानवाः।। १४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900003083, "chapter_id": 8276, "verse_number": "10.20", "content_sanskrit": "स्वयमेवाऽत्मनाऽऽत्मानं वेत्थ त्वं पुरुषोत्तम । भूतभावन भूतेश देवदेव जगत्पते ।। १५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900003084, "chapter_id": 8276, "verse_number": "10.21", "content_sanskrit": "वक्तुमर्हस्यशेषेण दिव्या ह्यात्मविभूतयः । याभिर्विभूतिभिर्लोकानिमांस्त्वं व्याप्य तिष्ठसि ।। १६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900003085, "chapter_id": 8276, "verse_number": "10.22", "content_sanskrit": "कथं विद्यामहं योगिंस्त्वां सदा परिचिन्तयन् । केषु केषु च भावेषु चिन्त्योऽसि भगवन् मया ।। १७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900003086, "chapter_id": 8276, "verse_number": "10.23", "content_sanskrit": "विस्तरेणाऽत्मनो योगं विभूतिं च जनार्दन । भूयः कथय तृप्तिर्हि शृण्वतो नास्ति मेऽमृतम् ।। १८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900003087, "chapter_id": 8276, "verse_number": "10.24", "content_sanskrit": "हन्त ते कथयिष्यामि दिव्या ह्यात्मविभूतयः । प्राधान्यतः कुरुश्रेष्ठ नास्त्यन्तो विस्तरस्य मे ।। १९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900003088, "chapter_id": 8276, "verse_number": "10.25", "content_sanskrit": "अहमात्मा गुडाकेश सर्वभूताशयस्थितः । अहमादिश्च मध्यं च भूतानामन्त एव च ।। २० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900003089, "chapter_id": 8276, "verse_number": "10.26", "content_sanskrit": "आदित्यानामहं विष्णुर्ज्योतिषां रविरंशुमान् । मरीचिर्मरुतामस्मि नक्षत्राणामहं शशी ।। २१ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900003090, "chapter_id": 8276, "verse_number": "10.27", "content_sanskrit": "वेदानां सामवेदोऽस्मि देवानामस्मि वासवः । इन्द्रियाणां मनश्चास्मि भूतानामस्मि चेतना ।। २२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900003091, "chapter_id": 8276, "verse_number": "10.28", "content_sanskrit": "रुद्राणां शङ्करश्चास्मि वित्तेशो यक्षरक्षसाम् । वसूनां पावकश्चास्मि मेरुः शिखरिणामहम् ।। २३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900003092, "chapter_id": 8276, "verse_number": "10.29", "content_sanskrit": "पुरोधसां च मुख्यं मां विद्धि पार्थ बृहस्पतिम् । सेनानीनामहं स्कन्दः सरसामस्मि सागरः ।। २४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900003093, "chapter_id": 8276, "verse_number": "10.30", "content_sanskrit": "महर्षीणां भृगुरहं गिरामस्म्येकमक्षरम् । यज्ञानां जपयज्ञोऽस्मि स्थावराणां हिमालयः ।। २५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900003094, "chapter_id": 8276, "verse_number": "10.31", "content_sanskrit": "अश्वत्थः सर्ववृक्षाणां देवर्षीणां च नारदः । गन्धर्वाणां चित्ररथः सिद्धानां कपिलो मुनिः ।। २६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900003095, "chapter_id": 8276, "verse_number": "10.32", "content_sanskrit": "उच्चैःश्रवसमश्वानां विद्धि माममृतोद्भवम् । ऐरावतं गजेन्द्राणां नराणां च नराधिपम् ।। २७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 900003096, "chapter_id": 8276, "verse_number": "10.33", "content_sanskrit": "आयुधानामहं वज्रं धेनूनामस्मि कामधुक् । प्रजनश्चास्मि कन्दर्पः सर्पाणामस्मि वासुकिः ।। २८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 900003097, "chapter_id": 8276, "verse_number": "10.34", "content_sanskrit": "अनन्तश्चास्मि नागानां वरुणो यादसामहम् । पितॄणामर्यमा चास्मि यमः संयमतामहम् ।। २९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 900003098, "chapter_id": 8276, "verse_number": "10.35", "content_sanskrit": "प्रह्लादश्चास्मि दैत्यानां कालः कलयतामहम् । मृगाणां च मृगेन्द्रोऽहं वैनतेयश्च पक्षिणाम् ।। ३० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 900003099, "chapter_id": 8276, "verse_number": "10.36", "content_sanskrit": "पवनः पवतामस्मि रामः शस्त्रभृतामहम् । झषाणां मकरश्चास्मि स्रोतसामस्मि जाह्नवी ।। ३१ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 900003100, "chapter_id": 8276, "verse_number": "10.37", "content_sanskrit": "सर्गाणामादिरन्तश्च मध्यं चैवाहमर्जुन । अध्यात्मविद्या विद्यानां वादः प्रवदतामहम् ।। ३२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 900003101, "chapter_id": 8276, "verse_number": "10.38", "content_sanskrit": "अक्षराणामकारोऽस्मि द्वन्द्वः सामासिकस्य च । अहमेवाक्षयः कालो धाताऽहं विश्वतोमुखः ।। ३३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 900003102, "chapter_id": 8276, "verse_number": "10.39", "content_sanskrit": "मृत्युः सर्वहरश्चाहमुद्भवश्च भविष्यताम् । कीर्तिः श्रीर्वाक्च नारीणां स्मृतिर्मेधा धृतिः क्षमा ।। ३४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 900003103, "chapter_id": 8276, "verse_number": "10.40", "content_sanskrit": "बृहत्साम तथा साम्नां गायत्री छन्दसामहम् । मासानां मार्गशीर्षोऽहम् ऋतूनां कुसुमाकरः ।। ३५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 900003104, "chapter_id": 8276, "verse_number": "10.41", "content_sanskrit": "द्यूतं छलयतामस्मि तेजस्तेजस्विनामहम् । जयोऽस्मि व्यवसायोऽस्मि सत्त्वं सत्त्ववतामहम् ।। ३६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 900003105, "chapter_id": 8276, "verse_number": "10.42", "content_sanskrit": "वृष्णीनां वासुदेवोऽस्मि पाण्डवानां धनञ्जयः । मुनीनामप्यहं व्यासः कवीनामुशना कविः ।। ३७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 900003106, "chapter_id": 8276, "verse_number": "10.43", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 900003107, "chapter_id": 8276, "verse_number": "10.44", "content_sanskrit": "दण्डो दमयतामस्मि नीतिरस्मि जिगीषताम् । मौनं चैवास्मि गुह्यानां ज्ञानं ज्ञानवतामहम् ।। ३८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 900003108, "chapter_id": 8276, "verse_number": "10.45", "content_sanskrit": "यच्चापि सर्वभूतानां बीजं तदहमर्जुन । न तदस्ति विना यत् स्यान्मया भूतं चराचरम् ।। ३९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 900003109, "chapter_id": 8276, "verse_number": "10.46", "content_sanskrit": "नान्तोऽस्ति मम दिव्यानां विभूतीनां परन्तप । एष तूद्देशतः प्रोक्तो विभूतेर्विस्तरो मया ।। ४० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 900003110, "chapter_id": 8276, "verse_number": "10.47", "content_sanskrit": "यद्यद्विभूतिमत्सत्त्वं श्रीमदूर्जितमेव वा । तत्तदेवावगच्छ त्वं मम तेजोंशसम्भवम् ।। ४१ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 900003111, "chapter_id": 8276, "verse_number": "10.48", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 900003112, "chapter_id": 8276, "verse_number": "10.49", "content_sanskrit": "अथवा बहुनैतेन किं ज्ञातेन तवार्जुन । विष्टभ्याहमिदं कृत्स्नमेकांशेन स्थितो जगत् ।। ४२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 900003113, "chapter_id": 8276, "verse_number": "10.50", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]