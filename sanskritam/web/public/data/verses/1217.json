[{"id": 2010703, "chapter_id": 1217, "verse_number": "१-२१८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2010704, "chapter_id": 1217, "verse_number": "१-२१८-१", "content_sanskrit": "सौमदत्तेर्वचः श्रुत्वा कर्णो वैकर्तनो वृषा।\nउवाच वचनं काले कालज्ञः सर्वकर्मणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2010705, "chapter_id": 1217, "verse_number": "१-२१८-२", "content_sanskrit": "नीतिपूर्वमिदं सर्वमुक्तं वचनमर्थवत्।\nवचनं नाभ्यसूयामि श्रूयतां यद्वचस्त्विति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2010706, "chapter_id": 1217, "verse_number": "१-२१८-३", "content_sanskrit": "द्वैधीभावो न गन्तव्यः सर्वकर्मसु मानवैः।\nद्विधाभूतेन मनसा अन्यत्कर्म न सिध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2010707, "chapter_id": 1217, "verse_number": "१-२१८-४", "content_sanskrit": "संप्रयाणासनाभ्यां तु कर्शनेन तथैव च।\nनैतच्छक्यं पुरं हर्तुमाक्रन्दश्चाप्यशोभनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2010708, "chapter_id": 1217, "verse_number": "१-२१८-५", "content_sanskrit": "अवमर्दनकालोऽत्र मतश्चिन्तयतो मम।\nयावन्नो वृष्णयः पार्ष्णिं न गृह्णन्तिरणप्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2010709, "chapter_id": 1217, "verse_number": "१-२१८-६", "content_sanskrit": "भवन्तश्च तथा हृष्टाः स्वबाहुबलशालिनः।\nप्राकारमवमृद्रन्तु परिघाः पूरयन्त्वपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2010710, "chapter_id": 1217, "verse_number": "१-२१८-७", "content_sanskrit": "प्रस्रावयन्तु सलिलं क्रियतां विषमं समम्।\nतृणकाष्ठेन महता खातमस्य प्रपूर्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2010711, "chapter_id": 1217, "verse_number": "१-२१८-८", "content_sanskrit": "घुष्यतां राजमार्गेषु परेषां यो हनिष्यति।\nनागमश्वं पदातिं वा दानमानं स लप्स्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2010712, "chapter_id": 1217, "verse_number": "१-२१८-९", "content_sanskrit": "नागे दशसहस्राणि पञ्च चाश्वपदातिषु।\nरथे वै द्विगुणं नागाद्वसु दास्यन्ति पार्थिवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2010713, "chapter_id": 1217, "verse_number": "१-२१८-१०", "content_sanskrit": "यश्च कामसुखे सक्तो बालश्च स्थविरश्च यः।\nअयुद्धमनसो ये च ते तु तिष्ठन्तु भीरवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2010714, "chapter_id": 1217, "verse_number": "१-२१८-११", "content_sanskrit": "प्रदरश्च न दातव्यो न गन्तव्यमचोदितैः।\nयशो रक्षत भद्रं वो जेष्यामो वै रिपून्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2010715, "chapter_id": 1217, "verse_number": "१-२१८-१२", "content_sanskrit": "अनुलोमाश्च नो वाताः सततं मृगपक्षिणः।\nअग्नयश्च विराजन्ते शस्त्राणि कवचानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2010716, "chapter_id": 1217, "verse_number": "१-२१८-१३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2010717, "chapter_id": 1217, "verse_number": "१-२१८-१३", "content_sanskrit": "ततः कर्णवचः श्रुत्वा धार्तराष्ट्रप्रियैषिणः।\nनिर्ययुः पृथिवीपालाश्चालयन्तः परान्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2010718, "chapter_id": 1217, "verse_number": "१-२१८-१४", "content_sanskrit": "न हि तेषां मनःसक्तिरिन्द्रियार्थेषु सर्वशः।\nयथा परिरपुघ्नानां प्रसभं युद्ध एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2010719, "chapter_id": 1217, "verse_number": "१-२१८-१५", "content_sanskrit": "वैकर्तनपुरोव्रातः सैन्धवोर्मिमहास्वनः।\nदुःशासनमहामत्स्यो दुर्योधनमहाग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2010720, "chapter_id": 1217, "verse_number": "१-२१८-१६", "content_sanskrit": "स राजसागरो भीमो भीमघोषप्रदर्शनः।\nअभिदुद्राव वेगेन पुरं तदपसव्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2010721, "chapter_id": 1217, "verse_number": "१-२१८-१७", "content_sanskrit": "तदनीकमनाधृष्यं शस्त्राग्निव्यालदीपितम्।\nसमुत्कम्पितमाज्ञाय चुक्रुशुर्द्रुपदात्मजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2010722, "chapter_id": 1217, "verse_number": "१-२१८-१८", "content_sanskrit": "ते मेघसमनिर्घोषैर्बलिनः स्यन्दनोत्तमैः।\nनिर्ययुर्नगरद्वारात्त्रासयन्तः परान्र", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2010723, "chapter_id": 1217, "verse_number": "१-२१८-१९", "content_sanskrit": "धृष्टद्युम्नः शिखण्डी च सुमित्रः प्रियदर्शनः।\nचित्रकेतुः सुकेतुश्च ध्वजकेतुश्च वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2010724, "chapter_id": 1217, "verse_number": "१-२१८-२०", "content_sanskrit": "पुत्रा द्रुपदराजस्य बलवन्तो जयैषिणः।\nद्रुपदस्य महावीर्यः पाण्डरोष्णीषकेतनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2010725, "chapter_id": 1217, "verse_number": "१-२१८-२१", "content_sanskrit": "पाण्डरव्यजनच्छत्रः पाण्डरध्वजवाहनः।\nस पुत्रगणमध्यस्थः शुशुभे राजसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2010726, "chapter_id": 1217, "verse_number": "१-२१८-२२", "content_sanskrit": "चन्द्रमा ज्योतिषां मध्ये पौर्णमास्यामिवोदितः।\nअथोद्धूतपताकाग्रमजिह्मगतिमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2010727, "chapter_id": 1217, "verse_number": "१-२१८-२३", "content_sanskrit": "द्रुपदानीकमायान्तं कुरुसैन्यमभिद्रवत्।\nतयोरुभयतो जज्ञे तेषां तु तुमुलः स्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2010728, "chapter_id": 1217, "verse_number": "१-२१८-२४", "content_sanskrit": "बलयोः संप्रसरतोः सरितां स्रोतसोरिव।\nप्रकीर्णरथनागाश्वैस्तान्यनीकानि सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2010729, "chapter_id": 1217, "verse_number": "१-२१८-२५", "content_sanskrit": "ज्योतींषईव प्रकीर्णानि सर्वतः प्रचकाशिरे।\nउत्कृष्टभेरीनिनदे संप्रवृत्ते महारवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2010730, "chapter_id": 1217, "verse_number": "१-२१८-२६", "content_sanskrit": "अमर्षिता महात्मानः पाण्डवा निर्ययुस्ततः।\nरथांश्च मेघनिर्घोषान्युक्तान्परमवाजिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2010731, "chapter_id": 1217, "verse_number": "१-२१८-२७", "content_sanskrit": "धून्वन्तो ध्वजिनः शुभ्रानास्थाय भरतर्षभाः।\nततः पाण्डुसुतान्दृष्ट्वा रथस्थानात्तकार्मुकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2010732, "chapter_id": 1217, "verse_number": "१-२१८-२८", "content_sanskrit": "नृपाणामभवत्कम्पो वेपथुर्हृदयेषु च।\nनिर्यातेष्वथ पार्थेषु द्रोपदं तद्बलं रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2010733, "chapter_id": 1217, "verse_number": "१-२१८-२९", "content_sanskrit": "आविशत्परमो हर्षः प्रमोदश्च जयं प्रति।\nसुमुहूर्तं व्यतिकरः सैन्यानामभवद्भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2010734, "chapter_id": 1217, "verse_number": "१-२१८-३०", "content_sanskrit": "ततो द्वन्द्वमयुध्यन्त मृत्युं कृत्वा पुरस्कृतम्।\nजघ्नतुः समरे तस्मिन्सुमित्रप्रियदर्शनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2010735, "chapter_id": 1217, "verse_number": "१-२१८-३१", "content_sanskrit": "जयद्रथश्च कर्णश्च पश्यतः सव्यसाचिनः।\nअर्जुनः प्रेक्ष्य निहतौ सौमित्रप्रियदर्शनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2010736, "chapter_id": 1217, "verse_number": "१-२१८-३२", "content_sanskrit": "जयद्रथसुतं तत्र जघान पितुरन्तिके।\nवृषसेनादवरजं सुदामानं धनंजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2010737, "chapter_id": 1217, "verse_number": "१-२१८-३३", "content_sanskrit": "कर्णपुत्रं महेष्वासं रथनीडादपातयत्।\nतौ सुतौ निहतौ दृष्ट्वा राजसिंहौ तरस्विनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2010738, "chapter_id": 1217, "verse_number": "१-२१८-३४", "content_sanskrit": "नामृष्येतां महाबाहू प्रहारमिव सद्गजौ।\nतौ जग्मतुरसंभ्रान्तौ फल्गुनस्य रथंप्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2010739, "chapter_id": 1217, "verse_number": "१-२१८-३५", "content_sanskrit": "प्रतिमुक्ततलत्राणौ शपमानौ परस्परम्।\nसन्निपातस्तयोरासीदतिघोरो महामृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2010740, "chapter_id": 1217, "verse_number": "१-२१८-३६", "content_sanskrit": "वृत्रशम्बरयोः सङ्क्ये वज्रिणेव महारणे।\nत्रीनश्वाञ्जघ्नतुस्तस्य फल्गुनस्य नर्षभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2010741, "chapter_id": 1217, "verse_number": "१-२१८-३७", "content_sanskrit": "ततः किलिकिलाशब्दः कुरूणामभवत्तदा।\nतान्हयान्निहतान्दृष्ट्वा भीमसेनः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2010742, "chapter_id": 1217, "verse_number": "१-२१८-३८", "content_sanskrit": "निमेषान्तरमात्रेण रथमश्वैरयोजयत्।\nउपयातं रथं दृष्ट्वा दुर्योधनपुरःसरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2010743, "chapter_id": 1217, "verse_number": "१-२१८-३९", "content_sanskrit": "सौबलः सौमदत्तिश्च समेयातां परन्तपौ।\nतैः पञ्चभिरदीनात्मा भीमसेनो महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2010744, "chapter_id": 1217, "verse_number": "१-२१८-४०", "content_sanskrit": "अयुध्यत तदा वीरैरिन्द्रियार्थैरिवेश्वरः।\nतैर्निरुद्धो न संत्रासं जगाम समितिंजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2010745, "chapter_id": 1217, "verse_number": "१-२१८-४१", "content_sanskrit": "पञ्चभिर्द्विरदैर्मत्तैर्निरुद्ध इव केसरी।\nतस्यैते युगपत्पञ्च पञ्चभिर्निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2010746, "chapter_id": 1217, "verse_number": "१-२१८-४२", "content_sanskrit": "सारथिं वाजिनश्चैव निन्युर्वैवस्वतक्षयम्।\nहताश्वात्स्यन्दनश्रेष्ठादवरुह्य महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2010747, "chapter_id": 1217, "verse_number": "१-२१८-४३", "content_sanskrit": "चचार विविधान्मार्गानसिमुद्यम्य पाण्डवः।\nअश्वस्कन्धेषु चक्रेषु युगेष्वीषासु चैव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2010748, "chapter_id": 1217, "verse_number": "१-२१८-४४", "content_sanskrit": "व्यचरत्पातयञ्शत्रून्सुपर्ण इव भोगिनः।\nविधनुष्कं विकवचं विरथं च समीक्ष्य तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2010749, "chapter_id": 1217, "verse_number": "१-२१८-४५", "content_sanskrit": "अभिपेतुर्नव्याघ्रा अर्जुनप्रमुखा रथाः।\nधृष्टद्युम्नः शिखण्डी च यमौ च युधि दुर्जयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2010750, "chapter_id": 1217, "verse_number": "१-२१८-४६", "content_sanskrit": "तस्मिन्महारथे युद्धे प्रवृत्ते शरवृष्टिभिः।\nरथध्वजपताकाश्च सवर्मन्तरधीयत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2010751, "chapter_id": 1217, "verse_number": "१-२१८-४७", "content_sanskrit": "तत्प्रवृत्तं चिरं कालं युद्धं सममिवाभवत्।\nरथेन तान्महाबाहुरर्जुनो व्यधमत्पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2010752, "chapter_id": 1217, "verse_number": "१-२१८-४८", "content_sanskrit": "तमापतन्तं दृष्ट्वेव महाबाहुर्धनुर्धरः।\nकर्णोऽस्त्रविदुषां श्रेष्ठो वारयामास सायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2010753, "chapter_id": 1217, "verse_number": "१-२१८-४९", "content_sanskrit": "स तेनाभिहतः पार्थो वासविर्वज्रसन्निभान्।\nत्रीञ्शरान्संदधे क्रुद्धो वधात्क्रुद्धस्य पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2010754, "chapter_id": 1217, "verse_number": "१-२१८-५०", "content_sanskrit": "तैः शरैराहतं कर्णं ध्वजयष्टिमुपाश्रितम्।\nअपोवाह रथाच्चाशु सूतः परपुरंजयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2010755, "chapter_id": 1217, "verse_number": "१-२१८-५१", "content_sanskrit": "ततः पराजिते कर्णे धार्तराष्ट्रान्महाभयम्।\nविवेश समुदग्रांश्च पाण्डवान्प्रसमीक्ष्य तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2010756, "chapter_id": 1217, "verse_number": "१-२१८-५२", "content_sanskrit": "तत्प्रकम्पितमत्यर्थं तद्दृष्ट्वा सौबलो बलम्।\nगिरा मधुरया चापि समाश्वासयतासकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2010757, "chapter_id": 1217, "verse_number": "१-२१८-५३", "content_sanskrit": "धार्तराष्ट्रैस्ततः सर्वैर्दुर्योधनपुरःसरैः।\nधृतं तत्पुनरेवासीद्बलं पार्थप्रपीडितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2010758, "chapter_id": 1217, "verse_number": "१-२१८-५४", "content_sanskrit": "ततो दुर्योधनं दृष्ट्वा भीमो भीमपराक्रमः।\nअक्रुध्यत्स महाबाहुरगारं जातुषं स्मरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2010759, "chapter_id": 1217, "verse_number": "१-२१८-५५", "content_sanskrit": "ततः संग्रामशिरसि ददर्श विपुलद्रुमम्।\nआयामभूतं तिष्ठन्तं स्कन्धपञ्चाशदुन्नतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2010760, "chapter_id": 1217, "verse_number": "१-२१८-५६", "content_sanskrit": "महास्कन्धं महोत्सेधं शक्रध्वजमिवोच्छ्रितम्।\nतमुत्पाठ्य च पाणिभ्यामुद्यम्य चरणावपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2010761, "chapter_id": 1217, "verse_number": "१-२१८-५७", "content_sanskrit": "अभिपेदे परान्सङ्ख्ये वज्रपाणिरिवासुरान्।\nभीमसेनभयार्तानि फल्गुनाभिहतानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2010762, "chapter_id": 1217, "verse_number": "१-२१८-५८", "content_sanskrit": "न शेकुस्तान्यनीकानि धार्तराष्ट्राण्युदीक्षितुम्।\nतानि संभ्रान्तयोधानि श्रान्तवाजिगजानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2010763, "chapter_id": 1217, "verse_number": "१-२१८-५९", "content_sanskrit": "दिशः प्राकालयद्भीमो दिवीवाभ्राणि मारुतः।\nतान्निवृत्तान्निरानन्दान्नरवारणवाजिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2010764, "chapter_id": 1217, "verse_number": "१-२१८-६०", "content_sanskrit": "नानुसस्रुर्न चाजघ्नुर्नोचुः किंचिच्च दारुणम्।\nस्वमेव शिबिरं जग्मुः क्षत्रियाः शरविक्षताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2010765, "chapter_id": 1217, "verse_number": "१-२१८-६१", "content_sanskrit": "परेऽप्यभिययुर्हृष्टाः पुरं पौरसुखावहाः।\nमुहूर्तमभवद्युद्धं तेषां वै पाण्डवैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2010766, "chapter_id": 1217, "verse_number": "१-२१८-६२", "content_sanskrit": "यावत्तद्युद्धमभवन्महद्देवासुरोपमम्।\nतावदेवाभवच्छान्तं निवृत्ता वै महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2010767, "chapter_id": 1217, "verse_number": "१-२१८-६३", "content_sanskrit": "सुव्रतं चक्रिरे सर्वे सुवृतामब्रुवन्वधूम्।\nकृतार्थं द्रुपदं चोचुर्धृष्टद्युम्नं च पार्षतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2010768, "chapter_id": 1217, "verse_number": "१-२१८-६४", "content_sanskrit": "शकुनिः सिन्धुराजश्च कर्णदुर्योधनावपि।\nतेषां तदाभवद्दुःखं हृदि वाचा तु नाब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2010769, "chapter_id": 1217, "verse_number": "१-२१८-६५", "content_sanskrit": "ततः प्रयाता राजानः सर्व एव यथागतम्।\nधार्तराष्ट्रा हि ते सर्वे गता नागपुरं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2010770, "chapter_id": 1217, "verse_number": "१-२१८-६६", "content_sanskrit": "प्रागेव पूर्निरोधात्तु पाण्डवैरश्वसादिनः।\nप्रेषिता गच्छतारिष्टानस्मानाख्यात शौरये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2010771, "chapter_id": 1217, "verse_number": "१-२१८-६७", "content_sanskrit": "तेऽचिरेणैव कालेन संप्राप्ता यादवीं पुरीम्।\nऊचुः संकर्षणोपेन्द्रौ वचनं वचनक्षमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2010772, "chapter_id": 1217, "verse_number": "१-२१८-६८", "content_sanskrit": "कुशलं पाण्डवाः सर्वानाहुः स्मान्धकवृष्णयः।\nआत्मनश्चाहतानाहुर्विमुक्ताञ्जातुषाद्गृहात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2010773, "chapter_id": 1217, "verse_number": "१-२१८-६९", "content_sanskrit": "समाजे द्रौपदीं लब्धामाहू राजीवलोचनाम्।\nआत्मनः सदृशीं सर्वैः शीलवृत्तसमाधिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2010774, "chapter_id": 1217, "verse_number": "१-२१८-७०", "content_sanskrit": "तच्छ्रुत्वा वचनं कृष्णस्तानुवाचोत्तरं वचः।\nसर्वमेतदहं जाने वधात्तस्य तु रक्षसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2010775, "chapter_id": 1217, "verse_number": "१-२१८-७१", "content_sanskrit": "तत उद्योजयामास माधवश्चतुरङ्गिणीम्।\nसेनामुपानयत्तूर्णं पाञ्चालनगरीं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2010776, "chapter_id": 1217, "verse_number": "१-२१८-७२", "content_sanskrit": "ततः संकर्षणश्चैव केशवश्च महाबलः।\nयादवैः सह सर्वैश्च पाण्डवानभिजग्मतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2010777, "chapter_id": 1217, "verse_number": "१-२१८-७३", "content_sanskrit": "पितृष्वसारं संपूज्य नत्वा चैव तु यादवीम्।\nद्रौपदीं भूषणैः शुभ्रैर्भूषयित्वा यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2010778, "chapter_id": 1217, "verse_number": "१-२१८-७४", "content_sanskrit": "पाण्डवान्हर्षयित्वा तु पूजयामासतुश्च तान्।\nन्यायतः पूजितौ राज्ञा द्रुपदेन महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2010779, "chapter_id": 1217, "verse_number": "१-२१८-७५", "content_sanskrit": "यादवाः पूजिताः सर्वे पाण्डवैश्च महात्मभिः।\nरेमिरे पाण्डवैः सार्धं ते पाञ्चालपुरे तदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2010780, "chapter_id": 1217, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्माहाभारते आदिपर्वणि विदुरागमनराज्यलाभपर्वणि अष्टादशाधिकद्विशततमोऽध्यायः॥ २१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]