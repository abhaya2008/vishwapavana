[{"id": 7003355000, "chapter_id": 23355, "verse_number": "२-५०-१", "content_sanskrit": "ऋषय ऊचुः    ।\nनिग्रहः कथितस्तेन शिववक्त्रेण शूलिना ।\nकृतापरांधिनां तं तु वक्तुमर्हसि सुव्रत ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003355001, "chapter_id": 23355, "verse_number": "२-५०-२", "content_sanskrit": "त्वया नविदिनं नास्ति लौकिकं वैदिकं तथा ।\nश्रौतं स्मार्तं महाभाग रोमहर्षण सुव्रत ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003355002, "chapter_id": 23355, "verse_number": "२-५०-३", "content_sanskrit": "सूत उवाच  ।\nपुरा भृगुसुतेनोक्तो हिरण्याक्षाय सुव्रताः ।\nनिग्रहोऽघोरशिष्येण शुक्रेणाक्षयतेजसा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003355003, "chapter_id": 23355, "verse_number": "२-५०-४", "content_sanskrit": "तस्य प्रसादद्दैत्येंद्रो हिरण्याक्षः प्रतापवान् ।\nत्रैलोक्यमखिलं जित्वा सदेवासुरमानुषम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003355004, "chapter_id": 23355, "verse_number": "२-५०-५", "content_sanskrit": "उत्पाद्य पुत्रं गणपं चांधकं चारुविक्रमम् ।\nरराज लोके देवेन वराहेण निषूदितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003355005, "chapter_id": 23355, "verse_number": "२-५०-६", "content_sanskrit": "स्त्रीबाधां बालबाधां च गवामपि विशेषतः ।\nकुर्वतो नास्ति विजयो मार्गेणानेन भूतले ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003355006, "chapter_id": 23355, "verse_number": "२-५०-७", "content_sanskrit": "तेन दैत्येन सा देवी धरा नीता रसातलम् ।\nतेनाघोरेण देवेन निष्फलो निग्रहः कृतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003355007, "chapter_id": 23355, "verse_number": "२-५०-८", "content_sanskrit": "संवत्सर सहस्रांते वराहेण च सूदितः ।\nतस्मादघोरसिद्ध्यर्थं ब्राह्मणान्नैव बाधयेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003355008, "chapter_id": 23355, "verse_number": "२-५०-९", "content_sanskrit": "स्त्रीणामपि विशेषेण गवामपि न कारयेत् ।\nगुह्याद्गुह्यतमंगोप्यमतिगुह्यं वदामि वः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003355009, "chapter_id": 23355, "verse_number": "२-५०-१०", "content_sanskrit": "आततायिनमुद्दिश्य कर्तव्यं नृपसत्तमैः ।\nब्राह्मणेभ्यो न कर्तव्यं स्वराष्ट्रेशस्य वा पुनः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003355010, "chapter_id": 23355, "verse_number": "२-५०-११", "content_sanskrit": "अतीवदुर्जये प्राप्ते बले सर्वे निषूदिते ।\nअधर्मयुद्धे संप्राप्ते कुर्याद्विधिमनुत्तमम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003355011, "chapter_id": 23355, "verse_number": "२-५०-१२", "content_sanskrit": "अघृणेनैव कर्तव्यो ह्यघृणेनैव कारयेत् ।\nकृतमात्रे न संदेहो निग्रहः संप्रजायते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003355012, "chapter_id": 23355, "verse_number": "२-५०-१३", "content_sanskrit": "लक्षमात्रं पुमाञ्जप्त्वा अघोरं घोररूपिणम् ।\nदशांशं विधिना हुत्वा तिलेन द्विजसत्तमाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003355013, "chapter_id": 23355, "verse_number": "२-५०-१४", "content_sanskrit": "संपूज्य लक्षपुष्पेण सितेन विधिपूर्वकम् ।\nबाणलिंगेऽथवा वह्नौ दक्षिणामूर्तिमाश्रितः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003355014, "chapter_id": 23355, "verse_number": "२-५०-१५", "content_sanskrit": "सिद्धमंत्रोऽन्यता नास्ति द्रष्टा सिद्ध्यादयः पुनः ।\nसिद्धमंत्रः स्वयं कुर्यात्प्रेतस्थाने विशेषतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003355015, "chapter_id": 23355, "verse_number": "२-५०-१६", "content_sanskrit": "मातृस्थानेऽपि वा विद्वान्वेदवेदांगपारगः ।\nकेवलं मंत्रसिद्धो वा ब्राह्मणः शिवभावितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003355016, "chapter_id": 23355, "verse_number": "२-५०-१७", "content_sanskrit": "कुर्याद्विधिमिमं धीमानात्मनोऽर्थं नृपस्य वा ।\nसूलाष्टकं न्यसेद्विद्वान्पूर्वादीशानकांतकम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003355017, "chapter_id": 23355, "verse_number": "२-५०-१८", "content_sanskrit": "त्रिशिखं च त्रिशूलं च चतुर्विशाच्छिकाग्रतः ।\nअघोरविग्रहं कृत्वा संकलीकृतविग्रहः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003355018, "chapter_id": 23355, "verse_number": "२-५०-१९", "content_sanskrit": "सर्वनाशकरं ध्यात्वा सर्वकर्माणि कारयेत् ।\nकालाग्निकोटिसंकाशं स्वदेहमपि भावयेत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003355019, "chapter_id": 23355, "verse_number": "२-५०-२०", "content_sanskrit": "शूलं कपालं पाशं च दंडं चैव शरासनम् ।\nबाणं डमरुकं खड्गमष्टायुधमनुक्रमात् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003355020, "chapter_id": 23355, "verse_number": "२-५०-२१", "content_sanskrit": "अष्टहस्तश्च वरदो नीलकंठो दिगंबरः ।\nपंचतत्त्वसमारूढो ह्यर्धचंद्रधरः प्रभुः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003355021, "chapter_id": 23355, "verse_number": "२-५०-२२", "content_sanskrit": "दंष्ट्राकरालवदनो रौद्रदृष्टिर्भयंकरः ।\nहुंफट्कारमहाशब्दशब्दिताखिलदिङ्मुखः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003355022, "chapter_id": 23355, "verse_number": "२-५०-२३", "content_sanskrit": "त्रिनेत्रं नागपाशेन सुबद्धमुकुटं स्वयम् ।\nसर्वाभरणसंपन्नं प्रेतभस्मावगुंठितम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003355023, "chapter_id": 23355, "verse_number": "२-५०-२४", "content_sanskrit": "भूतैः प्रेतैः पिशाचैश्च डाकिनीभिश्च राक्षसैः ।\nसंवृतं गजकृत्त्वा च सर्पभूषणभूषितम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003355024, "chapter_id": 23355, "verse_number": "२-५०-२५", "content_sanskrit": "वृश्चिकाभरणं देवं नीलनीरदनिस्वनम् ।\nनीलांजनाद्रिसंकाशं सिंहचर्मोत्तरीयकम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003355025, "chapter_id": 23355, "verse_number": "२-५०-२६", "content_sanskrit": "ध्यायेदेवमघोरेशं घोरघोरतरं शिवम् ।\nषट्त्रिंशदुक्तमात्राभिः प्राणायामेन सुव्रताः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003355026, "chapter_id": 23355, "verse_number": "२-५०-२७", "content_sanskrit": "महामुद्रासमायुक्तः सर्वकर्माणि कारयेत् ।\nसिद्धमंत्रश्चिताग्नौ वा प्रेतस्थाने यथाविधि ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003355027, "chapter_id": 23355, "verse_number": "२-५०-२८", "content_sanskrit": "स्थापयेन्मध्यदेशे तु ऐंद्रे याम्ये च वारुणे ।\nकौबेर्यां विदिवत्कृत्वा होमकुंडानि शास्त्रतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003355028, "chapter_id": 23355, "verse_number": "२-५०-२९", "content_sanskrit": "आचार्यो मध्यकुंडे तु साधकाश्च दिशासु वै ।\nपरिस्तीर्य विलोमेन पूर्ववच्छूलसंभृतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003355029, "chapter_id": 23355, "verse_number": "२-५०-३०", "content_sanskrit": "कालाग्निपीठमध्यस्थः स्वयं शिष्यैश्च तादृशैः ।\nध्यात्वा घोरमघोरेशं द्वात्रिंशाक्षरसंयुतम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003355030, "chapter_id": 23355, "verse_number": "२-५०-३१", "content_sanskrit": "विभीतकेन वै कृत्वा द्वादशांगुलमानतः ।\nपीठे न्यस्य नृपेंद्रस्य शत्रुमंगारकेण तु ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003355031, "chapter_id": 23355, "verse_number": "२-५०-३२", "content_sanskrit": "कुंडस्याधः खनेच्छत्रुं ब्राह्मणः क्रोधमूर्च्छितः ।\nअधोमुखोर्ध्वपादं तु सर्वकुंडेषु यत्नतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003355032, "chapter_id": 23355, "verse_number": "२-५०-३३", "content_sanskrit": "श्मशानांगारमानीय तुषेण सह दाहयेत् ।\nतत्राग्निं स्थापयेत्तूष्णीं ब्रह्मचर्यपरायणः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003355033, "chapter_id": 23355, "verse_number": "२-५०-३४", "content_sanskrit": "मायूरास्त्रेण नाभ्यां तु ज्वलनं दीपयेत्ततः ।\nकंचुकं तुषसंयुक्तैः कार्पासास्थिसमन्वितैः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003355034, "chapter_id": 23355, "verse_number": "२-५०-३५", "content_sanskrit": "रक्तवस्त्रसमं मिश्रैर्होमद्रव्यैर्विशेषतः ।\nहस्तयंत्रोद्भवैस्तैलैः सह होमं तु कारयेत् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003355035, "chapter_id": 23355, "verse_number": "२-५०-३६", "content_sanskrit": "अष्टोत्तरसहस्रं तु होमयेदनुपूर्वशः ।\nकृष्णपक्षे चतुर्दश्यां समारभ्य यथाक्रमम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003355036, "chapter_id": 23355, "verse_number": "२-५०-३७", "content_sanskrit": "अष्टम्यंतं तथांगारमंडलस्थानवर्जितः ।\nएवं कृते नृपेंद्रस्य शत्रवः कुलजैः सह ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003355037, "chapter_id": 23355, "verse_number": "२-५०-३८", "content_sanskrit": "सर्वदुःखसमोपेताः प्रयांति यमसादनम् ।\nमंत्रेणानेन चादाय नृकपाले नखं तथा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003355038, "chapter_id": 23355, "verse_number": "२-५०-३९", "content_sanskrit": "केशं नृणां तथांगारं तुषं कंचुकमेव च ।\nचीरच्छटां राजधूलीं गृहसंमार्जनस्य वा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003355039, "chapter_id": 23355, "verse_number": "२-५०-४०", "content_sanskrit": "विषसर्पस्य दंतानि वृषदंतानि यानि तु ।\nगवां चैव क्रमेणैव व्याघ्रदंतनखानि च ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003355040, "chapter_id": 23355, "verse_number": "२-५०-४१", "content_sanskrit": "तथा कृष्णमृगाणां च बिडालस्य च पूर्ववत् ।\nनकुलस्य च दंतानि वराहस्य विशेषतः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003355041, "chapter_id": 23355, "verse_number": "२-५०-४२", "content_sanskrit": "दंष्ट्राणि साधयित्वा तु मंत्रेणानेन सुव्रताः ।\nजपेदष्टोत्तरशतं मंत्रं चाघोरमुत्तमम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003355042, "chapter_id": 23355, "verse_number": "२-५०-४३", "content_sanskrit": "तत्कपालं नखं क्षेत्रे गृहे वा नगरेऽपि वा ।\nप्रेतस्थानेऽपि वा राष्ट्रे मृतवस्त्रेण वेष्टयेत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003355043, "chapter_id": 23355, "verse_number": "२-५०-४४", "content_sanskrit": "शत्रोरष्टमाराशौ वा परिविष्टे दिवाकरे ।\nसोमे वा परिविष्टे तु मंत्रेणानेन सुव्रताः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003355044, "chapter_id": 23355, "verse_number": "२-५०-४५", "content_sanskrit": "स्थाननाशो भवेत्तस्य शत्रोर्नाशश्च जायते ।\nशत्रुं राज्ञः समालिख्य गमने समवस्थिते ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003355045, "chapter_id": 23355, "verse_number": "२-५०-४६", "content_sanskrit": "भूतले दर्पणप्रख्ये वितानोपरि शोभिते ।\nचतुस्तोरणसंयुक्ते दर्भमालासमावृते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003355046, "chapter_id": 23355, "verse_number": "२-५०-४७", "content_sanskrit": "वेदाध्ययनसंपन्ने राष्ट्रे वृद्धिप्रकाशके ।\nदक्षिणेन तु पादेन मूर्ध्नि संताडयेत्स्वयम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003355047, "chapter_id": 23355, "verse_number": "२-५०-४८", "content_sanskrit": "एवं कृते नृपेंद्रस्य शत्रुनाशो भविष्यति ।\nस्वाराष्ट्रपतिमुद्दिश्य यः कुर्यादाभिचारिकम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003355048, "chapter_id": 23355, "verse_number": "२-५०-४९", "content_sanskrit": "स आत्मानं निहत्यैव स्वकुलं नाशयेत्कुधीः ।\nतस्मात्स्वराष्ट्रगांप्तारं नृपतिं पालयेत्सदा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003355049, "chapter_id": 23355, "verse_number": "२-५०-५०", "content_sanskrit": "मंत्रैषधिक्रियाद्यैश्च सर्वयत्नेन सर्वदा ।\nएतद्रहस्यं कथितं न देयं यस्य कस्यचित् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]