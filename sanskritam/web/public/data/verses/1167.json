[{"id": 2008650, "chapter_id": 1167, "verse_number": "१-१६८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2008651, "chapter_id": 1167, "verse_number": "१-१६८-१", "content_sanskrit": "युधिष्ठिरवचः श्रुत्वा कुन्तीमङ्गेऽधिरोप्य सा।\nभीमार्जुनान्तरगता यमाभ्यां च पुरस्कृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2008652, "chapter_id": 1167, "verse_number": "१-१६८-२", "content_sanskrit": "तिर्यग्युधिष्ठिरे याति हिडिम्बा भीमगामिनी।\nशालिहोत्रसरो रम्यमाससाद जलार्थिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2008653, "chapter_id": 1167, "verse_number": "१-१६८-३", "content_sanskrit": "वनस्पतितलं गत्वा परिमृज्य गृहं यथा।\nपाण्डवानां च वासं सा कृत्वा पर्णमयं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2008654, "chapter_id": 1167, "verse_number": "१-१६८-४", "content_sanskrit": "आत्मनश्च तथा कुन्त्या एकोद्देशे चकार सा।\nपाण्डवास्तु ततः स्नात्वा शुद्धाः सन्ध्यामुपास्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2008655, "chapter_id": 1167, "verse_number": "१-१६८-५", "content_sanskrit": "तृषिताः क्षुत्पिपासार्ता जलमात्रेण वर्तयन्।\nशालिहोत्रस्ततो ज्ञात्वा क्षुधार्तान्पाण्डवांस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2008656, "chapter_id": 1167, "verse_number": "१-१६८-६", "content_sanskrit": "मनसा चिन्तयामास पानीयं भोजनं महत्।\nततस्ते पाण्डवाः सर्वे विश्रान्ताः पृथया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2008657, "chapter_id": 1167, "verse_number": "१-१६८-७", "content_sanskrit": "यथा जतुगृहे वृत्तं राक्षसेन कृतं च यत्।\nकृत्वा कथा बहुविधाः कथान्ते पाण्डुनन्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2008658, "chapter_id": 1167, "verse_number": "१-१६८-८", "content_sanskrit": "कुन्ती राजसुता वाक्यं भीमसेनमथाब्रवीत्।\nयथा पाण्डुस्तथा मान्यस्तव ज्येष्ठो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2008659, "chapter_id": 1167, "verse_number": "१-१६८-९", "content_sanskrit": "अहं धर्मविदाऽनेन मान्या गुरुतरा तव।\nतस्मात्पाण्डुहितार्थं मे युवराज हितं कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2008660, "chapter_id": 1167, "verse_number": "१-१६८-१०", "content_sanskrit": "निकृता धार्तराष्ट्रेण पापेनाकृतबुद्धिना।\nदुष्कृतस्य प्रतीकारं न पश्यामि वृकोदर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2008661, "chapter_id": 1167, "verse_number": "१-१६८-११", "content_sanskrit": "तस्मात्कतिपयाहेन योगक्षेमं भविष्यति।\nक्षेमं दुर्गमिमं वासं वत्स्याम हि यथा वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2008662, "chapter_id": 1167, "verse_number": "१-१६८-१२", "content_sanskrit": "इदमन्यन्महदुःखं धर्मकृच्छ्रं वृकोदर।\nदृष्ट्वैव त्वां महाप्राज्ञ अनङ्गाभिप्रचोदिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2008663, "chapter_id": 1167, "verse_number": "१-१६८-१३", "content_sanskrit": "युधिष्ठिरं च मां चैव वरयामास धर्मतः।\nधर्मार्थं देहि पुत्रं त्वं स नः श्रेयः करिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2008664, "chapter_id": 1167, "verse_number": "१-१६८-१४", "content_sanskrit": "प्रतिवाक्यं तु नेच्छामि आवयोर्वचनं कुरु।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2008665, "chapter_id": 1167, "verse_number": "१-१६८-१४x", "content_sanskrit": "वैशम्पायन उवाच।\nतथेति तत्प्रतिज्ञाय भीमसेनोऽब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2008666, "chapter_id": 1167, "verse_number": "१-१६८-१५", "content_sanskrit": "शासनं ते करिष्यामि वेदशासनमित्यपि।\nसमक्षं भ्रातृमध्ये तु तां चोवाच स राक्षसीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2008667, "chapter_id": 1167, "verse_number": "१-१६८-१६", "content_sanskrit": "शृणु राक्षसि सत्येन समयं ते वदाम्यहम्।\nयावत्कालेन भवति पुत्रस्योत्पादनं शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2008668, "chapter_id": 1167, "verse_number": "१-१६८-१७", "content_sanskrit": "तावत्कालं चरिष्यामि त्वया सह सुमध्यमे।\nविशेषतो मत्सकाशे मा प्रकाशय नीचताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2008669, "chapter_id": 1167, "verse_number": "१-१६८-१८", "content_sanskrit": "उत्तमस्त्रीगुणोपेता भजेथा वरवर्णिनि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2008670, "chapter_id": 1167, "verse_number": "१-१६८-१८x", "content_sanskrit": "वैशम्पायन उवाच।\nसा तथेति प्रतिज्ञाय हिडिम्बा राक्षसी तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2008671, "chapter_id": 1167, "verse_number": "१-१६८-१९", "content_sanskrit": "गताऽहनि निवेशेषु भोज्यं राजार्हमानयत्।\nसा कदाचिद्विहारार्थं हिडिम्बा कामरूपिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2008672, "chapter_id": 1167, "verse_number": "१-१६८-२०", "content_sanskrit": "भीमसेनमुपादाय ऊर्ध्वमाचक्रमं तदा।\nशैलशृङ्गेषु रम्येषु देवतायतनेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2008673, "chapter_id": 1167, "verse_number": "१-१६८-२१", "content_sanskrit": "मृगपक्षिविघृष्टेषु रमणीयेषु सर्वेषु।\nकृत्वा सा परमं रूपं सर्वाभरणभूषिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2008674, "chapter_id": 1167, "verse_number": "१-१६८-२२", "content_sanskrit": "संजल्पन्ती सुमधुरं रमयामास पाण्डवम्।\nतथैव वनदुर्गेषु पर्वतद्रुमसानुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2008675, "chapter_id": 1167, "verse_number": "१-१६८-२३", "content_sanskrit": "सरस्तु रमणीयेषु पद्मोत्पलवनेषु च।\nनदीद्वीपप्रदेशेषु वैडूर्यसिकतेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2008676, "chapter_id": 1167, "verse_number": "१-१६८-२४", "content_sanskrit": "देवारण्येषु पुण्येषु तथा पर्वतसानुषु।\nसुतीर्थवनतोयासु तथा गिरिनदीषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2008677, "chapter_id": 1167, "verse_number": "१-१६८-२५", "content_sanskrit": "सागरस्य प्रदेशेषु भणिहेमयुतेषु च।\nगुह्यकानां निवासेषु कुलपर्वतसानुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2008678, "chapter_id": 1167, "verse_number": "१-१६८-२६", "content_sanskrit": "सर्वर्तुफलवृक्षेषु मानसेषु वनेषु च।\nबिभ्रती परमं रूपं रमयामास पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2008679, "chapter_id": 1167, "verse_number": "१-१६८-२७", "content_sanskrit": "यथा सुमोदते स्वर्गे सुकृत्यप्सरसा सह।\nसुतरां परमप्रीतस्तथा रेमे महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2008680, "chapter_id": 1167, "verse_number": "१-१६८-२८", "content_sanskrit": "शुभं हि जघनं तस्याः सवर्णमणिमेखलम्।\nन ततर्प तदा मृद्गन्भीमसेनो मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2008681, "chapter_id": 1167, "verse_number": "१-१६८-२९", "content_sanskrit": "रमयन्ती ततो भीमं तत्रतत्र मनोजवा।\nसा रेमे तेन संहर्षात्तृप्यन्ती च मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2008682, "chapter_id": 1167, "verse_number": "१-१६८-३०", "content_sanskrit": "अहस्सु रमयन्ती सा निशाकालेषु पाण्डवम्।\nआनीय वै स्वके गेहे दर्शयामास मातरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2008683, "chapter_id": 1167, "verse_number": "१-१६८-३१", "content_sanskrit": "भ्रातृभिः सहितो नित्यं स्वपते पाण्डवस्तथा।\nकुन्त्याः परिचरन्ती सा तस्याः पार्श्वेवसन्निशां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2008684, "chapter_id": 1167, "verse_number": "१-१६८-३२", "content_sanskrit": "कामांश्च मुखवासादीनानयिष्यति भोजनम्।\nतस्यां रात्र्यां व्यतीतायामाजगाम महाव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2008685, "chapter_id": 1167, "verse_number": "१-१६८-३३", "content_sanskrit": "पाराशर्यो महाप्राज्ञो दिव्यदर्शी महातपाः।\nतेऽभिवाद्य महात्मानं कृष्णद्वैपायनं शुभम्।\nतस्थुः प्राञ्जलयः सर्वे सस्नुषा चैव माधवी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2008686, "chapter_id": 1167, "verse_number": "१-१६८-३४x", "content_sanskrit": "श्रीव्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2008687, "chapter_id": 1167, "verse_number": "१-१६८-३४", "content_sanskrit": "मयेदं मनसा पूर्वं विदितं भरतर्षभाः।\nयथा स्थितैरधर्मेण धार्तराष्ट्रौर्विवासिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2008688, "chapter_id": 1167, "verse_number": "१-१६८-३५", "content_sanskrit": "तद्विदित्वाऽस्मि संप्राप्तश्चिकीर्ष्वै परं हितम्।\nन विषादो हि वः कार्यः सर्वमेतत्सुखाय वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2008689, "chapter_id": 1167, "verse_number": "१-१६८-३६", "content_sanskrit": "सुहृद्वियोजनं कर्म पुराकृतमरिन्दमाः।\nतस्य सिद्धिरियं प्राप्ता मा शोचत परन्तपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2008690, "chapter_id": 1167, "verse_number": "१-१६८-३७", "content_sanskrit": "समाप्ते दुष्कृते चैव यूयं ते वै न संशयः।\nस्वराष्ट्रे विहरिष्यन्तो भविष्यथ सबान्धवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2008691, "chapter_id": 1167, "verse_number": "१-१६८-३८", "content_sanskrit": "दीनतो बालतश्चैव स्नेहं कुर्वन्ति बान्धवाः।\nतस्मादभ्यधिकः स्नेहो युष्मासु मम संप्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2008692, "chapter_id": 1167, "verse_number": "१-१६८-३९", "content_sanskrit": "स्नेहपूर्वं चिकीर्षामि हितं यत्तन्निबोधत।\nवसतेह प्रतिच्छन्ना ममागमनकाङ्क्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2008693, "chapter_id": 1167, "verse_number": "१-१६८-४०", "content_sanskrit": "एतद्वै शालिहोत्रस्य तपसा निर्मितं सरः।\nरमणीयमिदं तोयं क्षुत्पिपासाश्रमापहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2008694, "chapter_id": 1167, "verse_number": "१-१६८-४१", "content_sanskrit": "कार्यार्थिनस्तु षण्मासान्विहरध्वं यथासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2008695, "chapter_id": 1167, "verse_number": "१-१६८-४२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2008696, "chapter_id": 1167, "verse_number": "१-१६८-४२", "content_sanskrit": "एवं स तान्समाश्वास्य व्यासः पार्थानरिन्दमान्।\nस्नेहाच्च संपरिष्वज्य कुन्तीमाश्वासयत्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2008697, "chapter_id": 1167, "verse_number": "१-१६८-४३", "content_sanskrit": "स्नुषे मा रोद मा रोदेत्येवं व्यासोऽब्रवीद्वचः।\nजीवपुत्रे सुतस्तेऽयं धर्मनित्यो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2008698, "chapter_id": 1167, "verse_number": "१-१६८-४४", "content_sanskrit": "पृथिव्यां पार्थइवान्सर्वान्प्रशासिष्यति धर्मराट्।\nधर्मेण जित्वा पृथिवीमखिलां धर्मकृद्वशी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2008699, "chapter_id": 1167, "verse_number": "१-१६८-४५", "content_sanskrit": "स्थापयित्वा वशे सर्वां सपर्वतवनां शुभाम्।\nभीमसेनार्जुनबलाद्भोक्ष्यत्ययमसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2008700, "chapter_id": 1167, "verse_number": "१-१६८-४६", "content_sanskrit": "पुत्रास्तव च माद्र्याश्च पञ्चैते लोकविश्रुताः।\nस्वराष्ट्रे विहरिष्यन्ति सुखं सुमनसस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2008701, "chapter_id": 1167, "verse_number": "१-१६८-४७", "content_sanskrit": "यक्ष्यन्ति च नरव्याघ्रा विजित्य पृथिवीमिमाम्।\nराजसूयाश्वमेधाद्यैः क्रतुभिर्भूरिदक्षिणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2008702, "chapter_id": 1167, "verse_number": "१-१६८-४८", "content_sanskrit": "अनुगृह्य सुहृद्वर्गं धनेन च सुखेन च।\nपितृपैतामहं राज्यमहारिष्यन्ति ते सुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2008703, "chapter_id": 1167, "verse_number": "१-१६८-४९", "content_sanskrit": "स्नुषा कमलपत्राक्षी नाम्ना कमलपालिका।\nवशवर्तिनी तु भीमस्य पुत्रमेषा जनिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2008704, "chapter_id": 1167, "verse_number": "१-१६८-५०", "content_sanskrit": "तेन पुत्रेण कृच्छ्रेषु भविष्यथ च तारिताः।\nइह मासं प्रतीक्षध्वमागमिष्याम्यहं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2008705, "chapter_id": 1167, "verse_number": "१-१६८-५१", "content_sanskrit": "देशकालौ विदित्वैवं यास्यध्वं परमां मुदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2008706, "chapter_id": 1167, "verse_number": "१-१६८-५२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2008707, "chapter_id": 1167, "verse_number": "१-१६८-५२", "content_sanskrit": "स तैः प्राञ्जलिभिः सर्वैस्तथेत्युक्तो जनाधिप।\nजगाम भगवान्व्यासो यथागतमृषिः प्रभुः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2008708, "chapter_id": 1167, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि हिडिम्बवधपर्वणि अष्टषष्ट्यधिकशततमोऽध्यायः॥ १६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]