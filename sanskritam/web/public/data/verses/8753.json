[{"id": 900009647, "chapter_id": 8753, "verse_number": "5.1", "content_sanskrit": "यद्यज्ञानं मनोवृत्तिप्रतिबन्धकमेव न", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900009648, "chapter_id": 8753, "verse_number": "5.2", "content_sanskrit": "परोक्षज्ञानजनकं श्रवणं केन हेतुना", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900009649, "chapter_id": 8753, "verse_number": "5.3", "content_sanskrit": "हर्यनुग्रह एवैभ्यस्सर्वेभ्यो बलवत्तरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900009650, "chapter_id": 8753, "verse_number": "5.4", "content_sanskrit": "उत्क्रान्तिमार्गगम्याप्तिभोगरूपं फलं सताम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900009651, "chapter_id": 8753, "verse_number": "5.5", "content_sanskrit": "ज्ञानेनैव च नास्तित्वं कस्य विश्वस्य जायते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900009652, "chapter_id": 8753, "verse_number": "5.6", "content_sanskrit": "ततो वैकुण्ठमगमद्भास्वरं तमसः परम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900009653, "chapter_id": 8753, "verse_number": "5.7", "content_sanskrit": "असुरान् दमयन्नुग्रान् सुरान् शान्तांस्तथोन्नयन्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900009654, "chapter_id": 8753, "verse_number": "5.8", "content_sanskrit": "यज्ञेन यज्ञमयजन्तेति वेदवचस्यपि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900009655, "chapter_id": 8753, "verse_number": "5.9", "content_sanskrit": "गुरोः शिष्यस्य पान्थस्य काकस्य च पशोरपि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900009656, "chapter_id": 8753, "verse_number": "5.10", "content_sanskrit": "यदि सांसारिकद्वैतमिव मुक्तौ द्विता भवेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900009657, "chapter_id": 8753, "verse_number": "5.11", "content_sanskrit": "न यत्र माया किमुतापर इत्यखिलेशितुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900009658, "chapter_id": 8753, "verse_number": "5.12", "content_sanskrit": "पशुपक्ष्यादिरूपेण जीवा एव पृथक् स्थिताः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900009659, "chapter_id": 8753, "verse_number": "5.13", "content_sanskrit": "अमुक्तागम्यभूर्या हि सा साक्षान्मुक्तिरेव हि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900009660, "chapter_id": 8753, "verse_number": "5.14", "content_sanskrit": "पक्वो वातापिदेहोऽपि भिक्षोश्शाकादिरूपतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900009661, "chapter_id": 8753, "verse_number": "5.15", "content_sanskrit": "ऐक्यं च निर्गुणत्वं च न श्रौतं नापि युक्तिमत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900009662, "chapter_id": 8753, "verse_number": "5.16", "content_sanskrit": "द्वितीयाद्वै भयमिति सदृशाद्भीतिरुच्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900009663, "chapter_id": 8753, "verse_number": "5.17", "content_sanskrit": "स्वाखण्डवादखड्गेन मृतमृत्यै न मे कृतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900009664, "chapter_id": 8753, "verse_number": "5.18", "content_sanskrit": "षष्ठेऽष्टकेऽन्तिमाध्यायद्वयमारभ्य सप्तमे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900009665, "chapter_id": 8753, "verse_number": "5.19", "content_sanskrit": "अतोऽग्नावाहितं चक्रं स्वार्चिषा पुण्यदायिना", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900009666, "chapter_id": 8753, "verse_number": "5.20", "content_sanskrit": "अतो वेदेन वेदान्तवचनेन च मानितम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900009667, "chapter_id": 8753, "verse_number": "5.21", "content_sanskrit": "हनुमद्भीमसंज्ञौ द्वौ प्रसिद्धौ विष्णुकिङ्करौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900009668, "chapter_id": 8753, "verse_number": "5.22", "content_sanskrit": "यतो मध्वो मातरिश्वा गुहासन्तं मथायति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900009669, "chapter_id": 8753, "verse_number": "5.23", "content_sanskrit": "यस्यर्चो मध्वनामाङ्काश्श्लोकानेकादशागृणन्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900009670, "chapter_id": 8753, "verse_number": "5.24", "content_sanskrit": "हितं न जानाम्यहितं न जाने नाकर्तुमीशो न च कर्तुमीशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900009671, "chapter_id": 8753, "verse_number": "5.25", "content_sanskrit": "कर्मणो यदि तत्कर्म स्वानिष्टं कुरुते कुतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900009672, "chapter_id": 8753, "verse_number": "5.26", "content_sanskrit": "नापि तत्प्रेरको ब्रह्मा नेशो नेन्द्रोऽपरे कृतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900009673, "chapter_id": 8753, "verse_number": "5.27", "content_sanskrit": "ज्ञानं मानं नेति वाक्यं व्याहतं स्याद्विचारणे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900009674, "chapter_id": 8753, "verse_number": "5.28", "content_sanskrit": "यदि स्मृतेर्न मानत्वं न स्यात्तर्ह्यनुभूतिषु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900009675, "chapter_id": 8753, "verse_number": "5.29", "content_sanskrit": "आनन्दश्रुतितो ब्रह्मानन्दरूपं यदीष्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900009676, "chapter_id": 8753, "verse_number": "5.30", "content_sanskrit": "जरतीभिः कारुरहमश्वो वोढेति वाक्त्रयम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900009677, "chapter_id": 8753, "verse_number": "5.31", "content_sanskrit": "वित्तै रिक्तोऽपि जात्युच्चो नात्यल्पमुपसर्पति । सुक्षीणर्क्षेशरक्षा स्यादर्कोदर्कश्रियैव हि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900009678, "chapter_id": 8753, "verse_number": "5.32", "content_sanskrit": "न शास्त्राभिज्ञाना न च नियमयुक्ता न यमिनो न मन्त्रानुष्ठानव्रतचरणचित्ता अपि वयम् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 900009679, "chapter_id": 8753, "verse_number": "5.33", "content_sanskrit": "आचार्यः पवनोऽस्माकमाचार्याणी च भारती । देवो नारायणः श्रीशो देवी मङ्गलदेवता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 900009680, "chapter_id": 8753, "verse_number": "5.34", "content_sanskrit": "वादिराजाख्ययतिना साधिता युक्तिमल्लिका मुक्तिसौरभसर्वस्वमित्थं सत्सु न्यवेदयत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]