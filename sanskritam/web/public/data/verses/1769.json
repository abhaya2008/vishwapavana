[{"id": 2035559, "chapter_id": 1769, "verse_number": "५-१४-०x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2035560, "chapter_id": 1769, "verse_number": "५-१४-१", "content_sanskrit": "अथैनां रूपिणी साध्वीमुपातिष्ठदुपश्रुतिः।\nतां वयोरूपसंपन्नां दृष्ट्वा देवीमुपस्थिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2035561, "chapter_id": 1769, "verse_number": "५-१४-२", "content_sanskrit": "इन्द्राणी संप्रहृष्टात्मा संपूज्यैनामथाब्रवीत्।\nइच्छामि त्वामहं ज्ञातुं का त्वं ब्रूहि वरानने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2035562, "chapter_id": 1769, "verse_number": "५-१४-३x", "content_sanskrit": "उपश्रुतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2035563, "chapter_id": 1769, "verse_number": "५-१४-३", "content_sanskrit": "उपश्रुतिरहं देवि तवान्तिकमुपागता।\nदर्शनं चैव संप्राप्ता तव सत्येन भामिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2035564, "chapter_id": 1769, "verse_number": "५-१४-४", "content_sanskrit": "पतिव्रता च युक्ता च यमेन नियमेन च।\nदर्शयिष्यामि ते शक्रं देवं वृत्रनिषूदनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2035565, "chapter_id": 1769, "verse_number": "५-१४-५", "content_sanskrit": "क्षिप्रमन्वेहि भद्रं ते द्रक्ष्यसे सुरसत्तमम्।\nततस्तां प्रस्थितां देवीमिन्द्राणी सा समन्वगात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2035566, "chapter_id": 1769, "verse_number": "५-१४-६", "content_sanskrit": "देवारण्यान्यतिक्रम्य पर्वतांश्च बहूंस्ततः ।\nहिमवन्तमतिक्रम्य उत्तरं पार्श्वमागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2035567, "chapter_id": 1769, "verse_number": "५-१४-७", "content_sanskrit": "समुद्रं च समासाद्य बहुयोजनविस्तृतम्।\nआससाद महाद्वीपं नानाद्रुमलतावृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2035568, "chapter_id": 1769, "verse_number": "५-१४-८", "content_sanskrit": "तत्रापश्यत्सरो दिव्यं नानाशकुनिभिर्वृतम्।\nशतयोजनविस्तीर्णं तावदेवायतं शुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2035569, "chapter_id": 1769, "verse_number": "५-१४-९", "content_sanskrit": "तत्र दिव्यानि पद्मानि पञ्चवर्णानि भारत ।\nषट्पदैरुपगीतानि प्रफुल्लानि सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2035570, "chapter_id": 1769, "verse_number": "५-१४-१०", "content_sanskrit": "सरसस्तस्य मध्ये तु पद्मिनी महती शुभा ।\nगौरेणोन्नतनालेन पद्मेन महता वृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2035571, "chapter_id": 1769, "verse_number": "५-१४-११", "content_sanskrit": "पद्मस्य भित्त्वा नालं च विवेश सहिता तया।\nबिसतन्तुप्रविष्टं च तत्रापश्यच्छतक्रतुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2035572, "chapter_id": 1769, "verse_number": "५-१४-१२", "content_sanskrit": "तं दृष्ट्वा च सुसूक्ष्मेण रूपेणावस्थितं प्रभुम् ।\nसूक्ष्मरूपधरा देवी बभूवोपश्रुतिश्च सा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2035573, "chapter_id": 1769, "verse_number": "५-१४-१३", "content_sanskrit": "इन्द्रं तुष्टाव चेन्द्राणी विश्रुतैः पूर्वकर्मभिः।\nस्तूयमानस्ततो देवः शचीमाह पुरन्दरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2035574, "chapter_id": 1769, "verse_number": "५-१४-१४", "content_sanskrit": "किमर्थमसि संप्राप्ता विज्ञातश्च कथं त्वहम्।\nततः सा कथयामास नहुषस्य विचेष्टितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2035575, "chapter_id": 1769, "verse_number": "५-१४-१५", "content_sanskrit": "इन्द्रत्वं त्रिषु लोकेषु प्राप्य वीर्यसमन्वितः ।\nदर्पाविष्टश्च दुष्टात्मा मामुवाच शतक्रतो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2035576, "chapter_id": 1769, "verse_number": "५-१४-१६", "content_sanskrit": "उपतिष्ठेति स क्रूरः कालं च कृतवान्मम ।\nयदि न त्रास्यसि विभो करिष्यति स मां वशे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2035577, "chapter_id": 1769, "verse_number": "५-१४-१७", "content_sanskrit": "एतेन चाहं संप्राप्ता द्रुतं शक्र तवान्तिकम्।\nजहि रौद्रं महाबाहो नहुषं पापनिश्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2035578, "chapter_id": 1769, "verse_number": "५-१४-१८", "content_sanskrit": "प्रकाशयस्व चात्मानं दैत्यदानवसूदन।\nतेजः समाप्नुहि विभो देवराज्यं प्रशाधि च ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2035579, "chapter_id": 1769, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि सेनोद्योगपर्वणि चतुर्दशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]