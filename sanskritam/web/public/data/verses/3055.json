[{"id": 2096161, "chapter_id": 3055, "verse_number": "१३-१८५-१", "content_sanskrit": "युधिष्ठिर उवाच।\nस्त्रीणां हि समुदाचारं सर्वधर्मविदांवर।\nश्रोतुमिच्छाम्यहं त्वत्तस्तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096162, "chapter_id": 3055, "verse_number": "१३-१८५-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096163, "chapter_id": 3055, "verse_number": "१३-१८५-२", "content_sanskrit": "सर्वज्ञां सर्वतत्त्वज्ञां देवलोके मनस्विनीम्।\nकैकेयी सुमना नाम शाण्डिलीं पर्यपृच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096164, "chapter_id": 3055, "verse_number": "१३-१८५-३", "content_sanskrit": "केन वृत्तेन कल्याणि समाचारेण केन वा।\nविधूय सर्वपापानि देवलोकं त्वमागता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096165, "chapter_id": 3055, "verse_number": "१३-१८५-४", "content_sanskrit": "हुताशनशिखेव त्वं ज्वलमाना स्वतेजसा।\nसुता ताराधिपस्येव प्रभया दिवमागता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096166, "chapter_id": 3055, "verse_number": "१३-१८५-५", "content_sanskrit": "अरजांसि च वस्त्राणि धारयन्ती गतक्लमा।\nविमानस्था शुभा भासि सहस्रगुणमोजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096167, "chapter_id": 3055, "verse_number": "१३-१८५-६", "content_sanskrit": "न त्वमल्पेन तपसा दानेन नियमेन वा।\nइमं लोकमनुप्राप्ता त्वं हि तत्त्वं वदस्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096168, "chapter_id": 3055, "verse_number": "१३-१८५-७", "content_sanskrit": "इति पृष्टा सुमनया मधुरं चारुहासिनी।\nशाण्डिली निभृतं वाक्यं सुमनामिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096169, "chapter_id": 3055, "verse_number": "१३-१८५-८", "content_sanskrit": "नाहं काषायवसना नापि वल्कलधारिणी।\nन च मुण्डा च जटिला भूत्वा देवत्वमागता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096170, "chapter_id": 3055, "verse_number": "१३-१८५-९", "content_sanskrit": "अहितानि च वाक्यानि सर्वाणि परुषाणि च।\nअप्रमत्ता च भर्तारं कदाचिन्नाहमब्रवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2096171, "chapter_id": 3055, "verse_number": "१३-१८५-१०", "content_sanskrit": "देवतानां पितॄणां च ब्राह्मणानां च पूजने।\nअप्रमत्ता सदा युक्ता श्वश्रूश्वशुरवर्तिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2096172, "chapter_id": 3055, "verse_number": "१३-१८५-११", "content_sanskrit": "पैशुन्ये न प्रवर्तामि न ममैतन्मनो गतम्।\nअद्वारि न च तिष्ठामि चिरं न कथयामि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2096173, "chapter_id": 3055, "verse_number": "१३-१८५-१२", "content_sanskrit": "असद्वा हसितं किञ्चिदहितं वाऽपि कर्मणा।\nरहस्यमरहस्यं वा न प्रवर्तामि सर्वथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2096174, "chapter_id": 3055, "verse_number": "१३-१८५-१३", "content_sanskrit": "कार्यार्थे निर्गतं चापि भर्तारं गृहमागतम्।\nआसनेनोपसंयोज्य पूजयामि समाहिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2096175, "chapter_id": 3055, "verse_number": "१३-१८५-१४", "content_sanskrit": "यदन्नं नाभिजानाति यद्भोज्यं नाभिनन्दति।\nभक्ष्यं वा यदि वा लेह्यं तत्सर्वं वर्जयाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2096176, "chapter_id": 3055, "verse_number": "१३-१८५-१५", "content_sanskrit": "कुटुंबार्थे समानीतं यत्किञ्चित्कार्यमेव तु।\nपुनरुत्थाय तत्सर्वं कारयामि करोमि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2096177, "chapter_id": 3055, "verse_number": "१३-१८५-१६", "content_sanskrit": "अग्निसंरक्षणपरा गृहशुद्धिं च कारये।\nकुमारान्पालये नित्यं कुमारीं परिशिक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2096178, "chapter_id": 3055, "verse_number": "१३-१८५-१७", "content_sanskrit": "आत्मप्रियाणि हित्वाऽपि गर्भसंरक्षणे रता।\nबालानां वर्जये नित्यं शापं कोपं प्रतापनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2096179, "chapter_id": 3055, "verse_number": "१३-१८५-१८", "content_sanskrit": "अविक्षिप्तानि धान्यानि नान्नविक्षेपणं गृहे।\nरक्तवत्स्पृहये गेहे गावः सयवसोदकाः।\nसमुद्गम्य च शुद्धाऽहं भिक्षां दद्यां द्विजातिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2096180, "chapter_id": 3055, "verse_number": "१३-१८५-१९", "content_sanskrit": "प्रवासं यदि मे याति भर्ता कार्येण केनचित्।\nमङ्गलैर्बहुभिर्युक्ता भवामि नियता तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2096181, "chapter_id": 3055, "verse_number": "१३-१८५-२०", "content_sanskrit": "अञ्जनं रोचनां चैव स्नानं माल्यानुलेपनम्।\nप्रसाधनं च निष्क्रान्ते नामिनन्दामि भर्तरि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2096182, "chapter_id": 3055, "verse_number": "१३-१८५-२१", "content_sanskrit": "नोत्थापयामि भर्तारं सुखं सुप्तमहं सदा।\nआतुरेष्वपि कार्येषु तेन तुष्यति मे मनः।\nनोत्थापये सुखं सुप्तं ह्यातुरं पालये पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2096183, "chapter_id": 3055, "verse_number": "१३-१८५-२२", "content_sanskrit": "नायासयामि भर्तारं कुटुम्बार्थेऽपि सर्वदा।\nगुप्तगुह्या सदा चास्मि सुसंमृष्टनिवेशना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2096184, "chapter_id": 3055, "verse_number": "१३-१८५-२३", "content_sanskrit": "इमं धर्मपथं नारी पालयन्ती समाहिता।\nअरुन्धतीव नारीणीस्वर्गलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2096185, "chapter_id": 3055, "verse_number": "१३-१८५-२४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2096186, "chapter_id": 3055, "verse_number": "१३-१८५-२४", "content_sanskrit": "एतदाख्याय सा देवी सुमनायै तपस्विनी।\nपतिधर्मं महाभागा जगामादर्शनं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2096187, "chapter_id": 3055, "verse_number": "१३-१८५-२५", "content_sanskrit": "यश्चेदं पाण्डवाख्यानं पठेत्पर्वणि पर्वणि।\nस देवलोकं सम्प्राप्य नन्दने स सुखी वसेत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2096188, "chapter_id": 3055, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि पञ्चाशीत्यधिकशततमोऽध्यायः॥ १८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]