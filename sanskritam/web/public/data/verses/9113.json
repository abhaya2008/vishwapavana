[{"id": 5000113000, "chapter_id": 9113, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे षड्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000113001, "chapter_id": 9113, "verse_number": "२-३६-१", "content_sanskrit": "ततः सुमन्त्रमैक्ष्वाकः पीडितोऽत्र प्रतिज्ञया।\nसबाष्पमतिनिःश्वस्य जगादेदं पुनर्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000113002, "chapter_id": 9113, "verse_number": "२-३६-२", "content_sanskrit": "सूत रत्नसुसम्पूर्णा चतुर्विधबला चमूः।\nराघवस्यानुयात्रार्थं क्षिप्रं प्रतिविधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000113003, "chapter_id": 9113, "verse_number": "२-३६-३", "content_sanskrit": "रूपाजीवाश्च वादिन्यो वणिजश्च महाधनाः।\nशोभयन्तु कुमारस्य वाहिनीः सुप्रसारिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000113004, "chapter_id": 9113, "verse_number": "२-३६-४", "content_sanskrit": "ये चैनमुपजीवन्ति रमते यैश्च वीर्यतः।\nतेषां बहुविधं दत्त्वा तानप्यत्र नियोजय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000113005, "chapter_id": 9113, "verse_number": "२-३६-५", "content_sanskrit": "आयुधानि च मुख्यानि नागराः शकटानि च।\nअनुगच्छन्तु काकुत्स्थं व्याधाश्चारण्यकोविदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000113006, "chapter_id": 9113, "verse_number": "२-३६-६", "content_sanskrit": "निघ्नन् मृगान् कुञ्जरांश्च पिबंश्चारण्यकं मधु।\nनदीश्च विविधाः पश्यन् न राज्यं संस्मरिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000113007, "chapter_id": 9113, "verse_number": "२-३६-७", "content_sanskrit": "धान्यकोशश्च यः कश्चिद् धनकोशश्च मामकः।\nतौ राममनुगच्छेतां वसन्तं निर्जने वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000113008, "chapter_id": 9113, "verse_number": "२-३६-८", "content_sanskrit": "यजन् पुण्येषु देशेषु विसृजंश्चाप्तदक्षिणाः।\nऋषिभिश्चापि संगम्य प्रवत्स्यति सुखं वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000113009, "chapter_id": 9113, "verse_number": "२-३६-९", "content_sanskrit": "भरतश्च महाबाहुरयोध्यां पालयिष्यति।\nसर्वकामैः पुनः श्रीमान् रामः संसाध्यतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000113010, "chapter_id": 9113, "verse_number": "२-३६-१०", "content_sanskrit": "एवं ब्रुवति काकुत्स्थे कैकेय्या भयमागतम्।\nमुखं चाप्यगमच्छोषं स्वरश्चापि व्यरुध्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000113011, "chapter_id": 9113, "verse_number": "२-३६-११", "content_sanskrit": "सा विषण्णा च संत्रस्ता मुखेन परिशुष्यता।\nराजानमेवाभिमुखी कैकेयी वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000113012, "chapter_id": 9113, "verse_number": "२-३६-१२", "content_sanskrit": "राज्यं गतधनं साधो पीतमण्डां सुरामिव।\nनिरास्वाद्यतमं शून्यं भरतो नाभिपत्स्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000113013, "chapter_id": 9113, "verse_number": "२-३६-१३", "content_sanskrit": "कैकेय्यां मुक्तलज्जायां वदन्त्यामतिदारुणम्।\nराजा दशरथो वाक्यमुवाचायतलोचनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000113014, "chapter_id": 9113, "verse_number": "२-३६-१४", "content_sanskrit": "वहन्तं किं तुदसि मां नियुज्य धुरि माहिते।\nअनार्ये कृत्यमारब्धं किं न पूर्वमुपारुधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000113015, "chapter_id": 9113, "verse_number": "२-३६-१५", "content_sanskrit": "तस्यैतत् क्रोधसंयुक्तमुक्तं श्रुत्वा वराङ्गना।\nकैकेयी द्विगुणं क्रुद्धा राजानमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000113016, "chapter_id": 9113, "verse_number": "२-३६-१६", "content_sanskrit": "तवैव वंशे सगरो ज्येष्ठपुत्रमुपारुधत्।\nअसमञ्ज इति ख्यातं तथायं गन्तुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000113017, "chapter_id": 9113, "verse_number": "२-३६-१७", "content_sanskrit": "एवमुक्तो धिगित्येव राजा दशरथोऽब्रवीत्।\nव्रीडितश्च जनः सर्वः सा च तन्नावबुध्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000113018, "chapter_id": 9113, "verse_number": "२-३६-१८", "content_sanskrit": "तत्र वृद्धो महामात्रः सिद्धार्थो नाम नामतः।\nशुचिर्बहुमतो राज्ञः कैकेयीमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000113019, "chapter_id": 9113, "verse_number": "२-३६-१९", "content_sanskrit": "असमञ्जो गृहीत्वा तु क्रीडतः पथि दारकान्।\nसरय्वां प्रक्षिपन्नप्सु रमते तेन दुर्मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000113020, "chapter_id": 9113, "verse_number": "२-३६-२०", "content_sanskrit": "तं दृष्ट्वा नागराः सर्वे क्रुद्धा राजानमब्रुवन्।\nअसमञ्जं वृणीष्वैकमस्मान् वा राष्ट्रवर्धन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000113021, "chapter_id": 9113, "verse_number": "२-३६-२१", "content_sanskrit": "तानुवाच ततो राजा किंनिमित्तमिदं भयम्।\nताश्चापि राज्ञा सम्पृष्टा वाक्यं प्रकृतयोऽब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000113022, "chapter_id": 9113, "verse_number": "२-३६-२२", "content_sanskrit": "क्रीडतस्त्वेष नः पुत्रान् बालानुद्‍भ्रान्तचेतसः।\nसरय्वां प्रक्षिपन्मौर्ख्यादतुलां प्रीतिमश्नुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000113023, "chapter_id": 9113, "verse_number": "२-३६-२३", "content_sanskrit": "स तासां वचनं श्रुत्वा प्रकृतीनां नराधिपः।\nतं तत्याजाहितं पुत्रं तासां प्रियचिकीर्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000113024, "chapter_id": 9113, "verse_number": "२-३६-२४", "content_sanskrit": "तं यानं शीघ्रमारोप्य सभार्यं सपरिच्छदम्।\nयावज्जीवं विवास्योऽयमिति तानन्वशात् पिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000113025, "chapter_id": 9113, "verse_number": "२-३६-२५", "content_sanskrit": "स फालपिटकं गृह्य गिरिदुर्गाण्यलोकयत्।\nदिशः सर्वास्त्वनुचरन् स यथा पापकर्मकृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000113026, "chapter_id": 9113, "verse_number": "२-३६-२६", "content_sanskrit": "इत्येनमत्यजद् राजा सगरो वै सुधार्मिकः।\nरामः किमकरोत् पापं येनैवमुपरुध्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000113027, "chapter_id": 9113, "verse_number": "२-३६-२७", "content_sanskrit": "नहि कंचन पश्यामो राघवस्यागुणं वयम्।\nदुर्लभो ह्यस्य निरयः शशाङ्कस्येव कल्मषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000113028, "chapter_id": 9113, "verse_number": "२-३६-२८", "content_sanskrit": "अथवा देवि त्वं कंचिद् दोषं पश्यसि राघवे।\nतमद्य ब्रूहि तत्त्वेन तदा रामो विवास्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000113029, "chapter_id": 9113, "verse_number": "२-३६-२९", "content_sanskrit": "अदुष्टस्य हि संत्यागः सत्पथे निरतस्य च।\nनिर्दहेदपि शक्रस्य द्युतिं धर्मविरोधवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000113030, "chapter_id": 9113, "verse_number": "२-३६-३०", "content_sanskrit": "तदलं देवि रामस्य श्रिया विहतया त्वया।\nलोकतोऽपि हि ते रक्ष्यः परिवादः शुभानने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000113031, "chapter_id": 9113, "verse_number": "२-३६-३१", "content_sanskrit": "श्रुत्वा तु सिद्धार्थवचो राजा श्रान्ततरस्वरः।\nशोकोपहतया वाचा कैकेयीमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000113032, "chapter_id": 9113, "verse_number": "२-३६-३२", "content_sanskrit": "एतद्वचो नेच्छसि पापरूपे\nहितं न जानासि ममात्मनोऽथवा।\nआस्थाय मार्गं कृपणं कुचेष्टा\nचेष्टा हि ते साधुपथादपेता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000113033, "chapter_id": 9113, "verse_number": "२-३६-३३", "content_sanskrit": "अनुव्रजिष्याम्यहमद्य रामं\nराज्यं परित्यज्य सुखं धनं च।\nसर्वे च राज्ञा भरतेन च त्वं\nयथासुखं भुङ्क्ष्व चिराय राज्यम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000113034, "chapter_id": 9113, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे षड्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]