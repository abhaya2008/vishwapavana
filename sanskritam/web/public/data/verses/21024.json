[{"id": 7001024000, "chapter_id": 21024, "verse_number": "५-६-१", "content_sanskrit": "कदाचिच्छकटाधस्ताच्छयानो मधुसूदनः ।\nचिक्षेप चरणावूद्ध्व स्तन्यार्थी प्ररुरोद च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001024001, "chapter_id": 21024, "verse_number": "५-६-२", "content_sanskrit": "तस्य पादप्रहारेणा शकटं परिवर्त्तितम् ।\nविध्वस्तकुम्भभाणडं बै विपरीतं पपात च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001024002, "chapter_id": 21024, "verse_number": "५-६-३", "content_sanskrit": "ततो हाहाकृतं सर्व्वो गोपगोपीजनो द्रिज!\nआजगामाथ ददृशे बालमुत्तानशायिनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001024003, "chapter_id": 21024, "verse_number": "५-६-४", "content_sanskrit": "गोपाः केनेति केनेदं शकटं पखिर्त्तितम् ।\nतत्रैवं बालकाश्वोचुर्बालेनानेन पातितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001024004, "chapter_id": 21024, "verse_number": "५-६-५", "content_sanskrit": "रुदता दृष्टमस्माभिः पादविक्षेपताड़ितम् ।\nशकटं परिवृत्तं वै नैतदन्यस्य चोष्टितम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001024005, "chapter_id": 21024, "verse_number": "५-६-६", "content_sanskrit": "ततः पुनरतीवासन् गोपा विस्मितचेतसः ।\nनन्दगोपोऽपि जग्राह बालमत्यन्तविस्मितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001024006, "chapter_id": 21024, "verse_number": "५-६-७", "content_sanskrit": "यशोदा शकटारूढ़भग्रभाण्डकपालिकाः ।\nशकटं चार्च्चयामास दधि-पुष्प-फलाक्षतैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001024007, "chapter_id": 21024, "verse_number": "५-६-८", "content_sanskrit": "गर्गश्व गोकुले तत्र वसुदेवप्रणोदितः ।\nप्रच्छन्न एव गोपानां संस्काराकरोत् तयोः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001024008, "chapter_id": 21024, "verse_number": "५-६-९", "content_sanskrit": "ज्येष्ठञ्च राममित्याह कृष्णञ्चवै तथापरम् ।\nगर्गो मतिमतां श्रेष्ठो नाम कुर्व्वन् महामतिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001024009, "chapter_id": 21024, "verse_number": "५-६-१०", "content_sanskrit": "स्वल्पेनैव हि कालेन रिङ्गिणौ तौ तदा ब्रजे ।\nघृष्टजानुकरौ तौ हि बभूवतुरुभावपि ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001024010, "chapter_id": 21024, "verse_number": "५-६-११", "content_sanskrit": "करीषभस्मदिग्धाङ्गौ भ्रममाणावितस्ततः ।\nन निवारायितु शेके यशोदा न च रोहिणी ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001024011, "chapter_id": 21024, "verse_number": "५-६-१२", "content_sanskrit": "गोवांटमध्ये क्रीड़न्तौ वत्सवाटगतौ पुनः ।\nतदहर्जातगोवतूसपुच्छाकर्षणतत्परौ ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001024012, "chapter_id": 21024, "verse_number": "५-६-१३", "content_sanskrit": "यदा यशोदा तौ बालावेकस्थानचरावुभौ ।\nशशाकि नो वाररितु क्रीड़न्तावतिचञ्चलौ ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001024013, "chapter_id": 21024, "verse_number": "५-६-१४", "content_sanskrit": "यशोदा यष्टिमादाय कोपेनानुगता च तम् ।\nकृष्णां कमलपत्राक्षं तर्ज्जयन्ती रुषा तदा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001024014, "chapter_id": 21024, "verse_number": "५-६-१५", "content_sanskrit": "दाम्रा बद्धा तदा मध्ये निबध्याथ उदूखले ।\nकृष्णमक्लिष्टकर्म्माणमाह चेदममर्षिता ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001024015, "chapter_id": 21024, "verse_number": "५-६-१६", "content_sanskrit": "यदि शक्रोषि गच्छ त्वमतिचञ्चलचेष्टित!\nइत्युक्त्वा च निजं कर्म्म सा चकार कुटुम्बिनी ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001024016, "chapter_id": 21024, "verse_number": "५-६-१७", "content_sanskrit": "व्यग्रायामथ तस्यां स कर्षमाण उदूखलम् ।\nयमलार्ज्जुनमध्येन जगाम कमलेक्षणः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001024017, "chapter_id": 21024, "verse_number": "५-६-१८", "content_sanskrit": "कर्षता वृक्षयोर्मध्ये तिर्य्यगूगतमुदूखलम् ।\nभग्रावुत्तुङ्गशाखाग्रो तेन तौ यमलार्ज्जुनौ ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001024018, "chapter_id": 21024, "verse_number": "५-६-१९", "content_sanskrit": "ततः कटकटाशब्दं समाकर्ण्य च कातरः ।\nआजगाम ब्रजजनो ददृशे च महाद्र मौ ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001024019, "chapter_id": 21024, "verse_number": "५-६-२०", "content_sanskrit": "भग्रस्कन्धौ निपतितौ भग्रशाखौ महीतले ।\nनवोदूगताल्पदन्तांशु-सितहासञ्च बालकम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001024020, "chapter_id": 21024, "verse_number": "५-६-२१", "content_sanskrit": "तयोर्मध्यगतं बद्धं दाम्रा गाढ़ तथोदरे ।\nततश्व दामोदरतां स ययौ दामबन्धनात् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001024021, "chapter_id": 21024, "verse_number": "५-६-२२", "content_sanskrit": "गोपबृद्धास्ततः सर्व्वे नन्दगोपपुरोगमाः ।\nमन्त्रयामासुरुद्रिग्रा महोत्पातातिभीरवः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001024022, "chapter_id": 21024, "verse_number": "५-६-२३", "content_sanskrit": "स्थानेनेह न नः कार्य्यं गच्छामोऽन्यन्महावनम् ।\nउत्पाता बहवो ह्यत्र दृश्यन्ते नाशहेतवः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001024023, "chapter_id": 21024, "verse_number": "५-६-२४", "content_sanskrit": "पूतनाया विनाशश्व शकटस्य विपर्य्ययः ।\nविना वातादि-दोषेण द्रु मयोः पतनं तथा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001024024, "chapter_id": 21024, "verse_number": "५-६-२५", "content_sanskrit": "वृन्दावनमितः स्थानात् तस्माद् गच्छाम मा चिरम् ।\nयावद्भौममहोत्पात-दोषो नाभिभवेदू व्रजम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001024025, "chapter_id": 21024, "verse_number": "५-६-२६", "content_sanskrit": "इति कृत्वा मतिं सर्व्वे गमने ते व्रजौकसः ।\nऊचुः स्वं स्वं कुलं शीघ्रं गम्यतां मा विलम्बयताम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001024026, "chapter_id": 21024, "verse_number": "५-६-२७", "content_sanskrit": "ततः क्षणेनः प्रययु शकटैर्गोधनैस्तथा ।\nयूथशो वतूसबालांश्व कालयन्तो व्रजौकसः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001024027, "chapter_id": 21024, "verse_number": "५-६-२८", "content_sanskrit": "द्रव्यावयवनिद्धूतं क्षणामात्रेण तत् तथा ।\nकाक-काकी-समाकीर्णां व्रजस्थानमभूदू द्रिज ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001024028, "chapter_id": 21024, "verse_number": "५-६-२९", "content_sanskrit": "वृन्दावनं भगवता कृष्णोनाक्लिष्टकर्म्मणा ।\nशुभेन मनसा ध्यातं गबां वृद्धिमभीप्सता ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001024029, "chapter_id": 21024, "verse_number": "५-६-३०", "content_sanskrit": "ततस्तत्रातिरूक्षेऽपि घर्म्मकाले द्रिजोत्तम!\nप्रावृटूकाल इवोद्भूतं नवं शस्यं समन्ततः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001024030, "chapter_id": 21024, "verse_number": "५-६-३१", "content_sanskrit": "स समावासितः सर्व्वो व्रजो वृन्दावने ततः ।\nखकटोवाचटपर्य्यन्तश्वन्द्रार्द्धाकारसंस्थितिः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001024031, "chapter_id": 21024, "verse_number": "५-६-३२", "content_sanskrit": "वत्सपालौ च संवृत्तौ राम-दामोदरौ ततः\nएकस्थानस्थितौ गोष्ठे चेरतुर्बाललीलया ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001024032, "chapter_id": 21024, "verse_number": "५-६-३३", "content_sanskrit": "बर्हिपत्रकृतापीड़ौ वन्यपुष्पावतंसकौ ।\nगोपवेणुकृतातोद्य-पत्रवाद्यकृतस्वनौ ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001024033, "chapter_id": 21024, "verse_number": "५-६-३४", "content_sanskrit": "काकपक्षधरौ बालौ कुमाराविव पावकी ।\nहसन्तौ च रमन्तौ च चेरतुस्तै महाबलौ ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001024034, "chapter_id": 21024, "verse_number": "५-६-३५", "content_sanskrit": "क्वचिद्धसन्तावन्योन्यं क्रीड़मानौ तथापरैः ।\nगोपपुत्रैः समं वत्सांश्वारयन्तौ विचेरतुः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001024035, "chapter_id": 21024, "verse_number": "५-६-३६", "content_sanskrit": "कालेन गच्छता तौ तु सप्तवर्षौ महाव्रजे ।\nसर्व्वस्य जगतः पालौ वत्सपालौ बभूवतुः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001024036, "chapter_id": 21024, "verse_number": "५-६-३७", "content_sanskrit": "प्रावृटूकालस्ततोऽतीव मेघौघस्थगिताम्बरः ।\nबभूव वारिधाराभिरैक्यं कुर्व्वन् दिशामिव ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001024037, "chapter_id": 21024, "verse_number": "५-६-३८", "content_sanskrit": "प्ररूढ़नवशस्याञया शक्रगोपाचिता मही ।\nतदा मारकतीवासीत् पद्मरागविभूषिता ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001024038, "chapter_id": 21024, "verse_number": "५-६-३९", "content_sanskrit": "जग्मुरुन्मार्गवाहानि निम्रगाम्भांसि सर्व्वतः ।\nमनांसि दुव्विनीतानां प्राप्य लक्ष्मीं नवामिव ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001024039, "chapter_id": 21024, "verse_number": "५-६-४०", "content_sanskrit": "न रेजेऽन्तरितश्वन्द्रो निर्म्मलो मलिनैर्घनैः ।\nसद्राक्यवादो मूर्खाणां प्रगलूभाभिरिवोक्तिभिः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001024040, "chapter_id": 21024, "verse_number": "५-६-४१", "content_sanskrit": "निगु णोनापि चापेन शक्रस्य गगने पदम् ।\nअवाप्यताविवेकस्य नृपस्येव परिग्रहे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001024041, "chapter_id": 21024, "verse_number": "५-६-४२", "content_sanskrit": "मेघपृष्ठे बलाकानां रराज विमला ततिः ।\nदुर्वृत्ते वृत्त्चेष्टेव कुलीनस्यातिशोभना ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001024042, "chapter_id": 21024, "verse_number": "५-६-४३", "content_sanskrit": "न बबन्धाम्बरे स्थैर्य्य विद्यु दत्यन्तचञ्चला ।\nमैत्रीव प्रवरे पुंसि दुर्ज्जनेन प्रयोजिता ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001024043, "chapter_id": 21024, "verse_number": "५-६-४४", "content_sanskrit": "मार्गा बभूवुरस्पष्टा नवशस्यचयावृताः ।\nअर्थान्तरमनुप्राप्ताः प्रजड़ानामिवोक्तयः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001024044, "chapter_id": 21024, "verse_number": "५-६-४५", "content_sanskrit": "उन्मत्तशिखिसारङ्ग तस्मिन् काले महावने ।\nकृष्ण-रामौ मुदा युक्तौ गोपालैश्चैरतुः सह ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001024045, "chapter_id": 21024, "verse_number": "५-६-४६", "content_sanskrit": "क्वचिदू गोपैः समं रम्यं गेयनृत्यरतावुभौ ।\nचेरतुः क्कचिदत्यर्थं शीतवृक्षतलाश्रयौ ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001024046, "chapter_id": 21024, "verse_number": "५-६-४७", "content_sanskrit": "क्वचित् कदम्बस्रक्-चित्रौ मयूरस्त्रग्धरौ क्वचित् ।\nविचित्रौ क्वचिदास्येतां विविधैर्गिरिधातुभिः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001024047, "chapter_id": 21024, "verse_number": "५-६-४८", "content_sanskrit": "पर्णशय्यासु संसुप्तौ क्वचिन्नद्रान्तरैषिणौ ।\nक्वचिद् गर्ज्जति जीमूते हाहाकारखादृतौ ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001024048, "chapter_id": 21024, "verse_number": "५-६-४९", "content_sanskrit": "गायतामन्यगोपानां प्रशंसापरमौ क्वचित् ।\nमयूरकेकानुगतौ गोपवेषुप्रवादकौ ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001024049, "chapter_id": 21024, "verse_number": "५-६-५०", "content_sanskrit": "इति नानाविधैर्भावैरुत्तमप्रीतिसंयुतौ ।\nक्रीड़ासक्तौ वने तस्मिन् चेरतुः प्रीतमानसौ ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001024050, "chapter_id": 21024, "verse_number": "५-६-५१", "content_sanskrit": "विकाले तु समं गोभिर्गोपवृन्दसमन्बितौ ।\nआजग्मतुः कृष्ण-बलौ गोपवेशधरावुभौ ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001024051, "chapter_id": 21024, "verse_number": "५-६-५२", "content_sanskrit": "विकाले च यथाजोष व्रजमत्य महाबलौ ।\nगोपैः समानैः सहितौ चिक्रीड़ातेऽमराविव ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]