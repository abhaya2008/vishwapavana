[{"id": 5000552000, "chapter_id": 9552, "verse_number": "७-१७-१", "content_sanskrit": "अथ राजन्महाबाहुर्विचरन्स महीतले ।\nहिमवद्वनमासाद्य परिचक्राम रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000552001, "chapter_id": 9552, "verse_number": "७-१७-२", "content_sanskrit": "तत्रापश्यत्स वै कन्यां कृष्णाजिनजटाधराम् ।\nआर्षेण विधिना युक्तां दीप्यन्तीं देवतामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000552002, "chapter_id": 9552, "verse_number": "७-१७-३", "content_sanskrit": "स दृष्ट्वा रूपसम्पन्नां कन्यां तां सुमहाव्रताम् ।\nकाममोहपरीतात्मा पप्रच्छ प्रहसन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000552003, "chapter_id": 9552, "verse_number": "७-१७-४", "content_sanskrit": "किमिदं वर्तसे भद्रे विरुद्धं यौवनस्य ते ।\nनहि युक्ता तवैतस्य रूपस्यैव प्रति\nक्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000552004, "chapter_id": 9552, "verse_number": "७-१७-५", "content_sanskrit": "रूपं ते ऽनुपमं भीरु कामोन्मादकरं नृणाम् ।\nन युक्तं तपसि स्थातुं निर्गतो ह्येष निर्णयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000552005, "chapter_id": 9552, "verse_number": "७-१७-६", "content_sanskrit": "कस्यासि किमिदं भद्रे कश्च भर्ता वरानने ।\nयेन सम्भुज्यसे भीरु स नरः पुण्यभाग्भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000552006, "chapter_id": 9552, "verse_number": "७-१७-७", "content_sanskrit": "पृच्छतः शंस मे सर्वं कस्य हेतोः परिश्रमः ।\nएवमुक्ता तु सा कन्या रावणेन यशस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000552007, "chapter_id": 9552, "verse_number": "७-१७-८", "content_sanskrit": "अब्रवीद्विधिवत्कृत्वा तस्यातिथ्यं तपोधना ।\nकुशध्वजो मम पिता ब्रह्मर्षिरमितप्रभः ।\nबृहस्पतिसुतः श्रीमान्बुद्ध्या तुल्यो बृहस्पतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000552008, "chapter_id": 9552, "verse_number": "७-१७-९", "content_sanskrit": "तस्याहं कुर्वतो नित्यं वेदाभ्यासं महात्मनः ।\nसम्भूय वाङ्मयी कन्या नाम्ना वेदवती स्मृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000552009, "chapter_id": 9552, "verse_number": "७-१७-१०", "content_sanskrit": "ततो देवाः सगन्धर्वा यक्षराक्षसपन्नगाः ।\nते ऽपि गत्वा हि पितरं वरणं रोचयन्ति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000552010, "chapter_id": 9552, "verse_number": "७-१७-११", "content_sanskrit": "न च मां स पिता तेभ्यो दत्तवान्राक्षसर्षभ ।\nकारणं तद्वदिष्यामि निशाचर निशामय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000552011, "chapter_id": 9552, "verse_number": "७-१७-१२", "content_sanskrit": "पितुस्तु मम जामाता विष्णुः किल सुरेश्वरः ।\nअभिप्रेतस्त्रिलोकेशस्तस्मान्नान्यस्य मे पिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000552012, "chapter_id": 9552, "verse_number": "७-१७-१३", "content_sanskrit": "दातुमिच्छति तस्मै तु तच्छ्रुत्वा बलदर्पितः ।\nदम्भुर्नाम ततो राजा दैत्यानां कुपितो ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000552013, "chapter_id": 9552, "verse_number": "७-१७-१४", "content_sanskrit": "तेन रात्रौ शयानो मे पिता पापेन हिंसितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000552014, "chapter_id": 9552, "verse_number": "७-१७-१५", "content_sanskrit": "ततो मे जननी दीना तच्छरीरं पितुर्मम ।\nपरिष्वज्य महाभागा प्रविष्टा हव्यवाहनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000552015, "chapter_id": 9552, "verse_number": "७-१७-१६", "content_sanskrit": "ततो मनोरथं सत्यं पितुर्नारायणं प्रति ।\nकरोमीति तमेवाहं हृदयेन समुद्वहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000552016, "chapter_id": 9552, "verse_number": "७-१७-१७", "content_sanskrit": "इति प्रतिज्ञामारुह्य चरामि विपुलं तपः ।\nएतत्ते सर्वमाख्यातं मया राक्षसपुङ्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000552017, "chapter_id": 9552, "verse_number": "७-१७-१८", "content_sanskrit": "नारायणो मम पतिर्न त्वन्यः पुरुषोत्तमात् ।\nआश्रये नियमं घोरं नारायणपरीप्सया ।\nविज्ञातस्त्वं हि मे राजन्गच्छ पौलस्त्यनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000552018, "chapter_id": 9552, "verse_number": "७-१७-१९", "content_sanskrit": "जानामि तपसा सर्वं त्रैलोक्ये यद्धि वर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000552019, "chapter_id": 9552, "verse_number": "७-१७-२०", "content_sanskrit": "सो ऽब्रवीद्रावणो भूयस्तां कन्यां सुमहाव्रताम् ।\nअवरुह्य विमानाग्रात्कन्दर्पशरपीडितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000552020, "chapter_id": 9552, "verse_number": "७-१७-२१", "content_sanskrit": "अवलिप्ता ऽसि सुश्रोणि यस्यास्ते मतिरीदृशी ।\nवृद्धानां मृगशावाक्षि भ्राजते पुण्यसञ्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000552021, "chapter_id": 9552, "verse_number": "७-१७-२२", "content_sanskrit": "त्वं सर्वंगुणसम्पन्ना नार्हसे वक्तुमीदृशम् ।\nत्रैलोक्यसुन्दरी भीरु यौवनं ते निवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000552022, "chapter_id": 9552, "verse_number": "७-१७-२३", "content_sanskrit": "अहं लङ्कापतिर्भद्रे दशग्रीव इति श्रुतः ।\nतस्य मे भव भार्या त्वं भुङ्क्ष्व भोगान्यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000552023, "chapter_id": 9552, "verse_number": "७-१७-२४", "content_sanskrit": "कश्च तावदसौ यं त्वं विष्णुरित्यभिभाषसे ।\nवीर्येण तपसा चैव भोगेन च बलेन च ॥\nन मया स समो भद्रे यं त्वं कामयसे ऽङ्गने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000552024, "chapter_id": 9552, "verse_number": "७-१७-२५", "content_sanskrit": "इत्युक्तवति तस्मिंस्तु वेदवत्यथ सा ऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000552025, "chapter_id": 9552, "verse_number": "७-१७-२६", "content_sanskrit": "ैव भोगेन च बलेन च ॥\nमा मैवमिति सा कन्या तमुवाच निशाचरम् ।\nत्रैलोक्याधिपति विष्णुं सर्वलोकनमस्कृतम् ।\nत्वदृते राक्षसेन्द्रान्यः को ऽवमन्येत बुद्धिमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000552026, "chapter_id": 9552, "verse_number": "७-१७-२७", "content_sanskrit": "एवमुक्तस्तया तत्र वेदवत्या निशाचरः ।\nमूर्धजेषु तदा कन्यां कराग्रेण परामृशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000552027, "chapter_id": 9552, "verse_number": "७-१७-२८", "content_sanskrit": "ततो वेदवती क्रुद्धा केशान्हस्तेन सा ऽच्छिनत् ।\nअसिर्भूत्वा करस्तस्याः केशांश्छिन्नांस्तदा ऽकरोत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000552028, "chapter_id": 9552, "verse_number": "७-१७-२९", "content_sanskrit": "सा ज्वलन्तीव रोषेण दहन्तीव निशाचरम् ।\nउवाचाग्निं समाधाय मरणाय कृतत्वरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000552029, "chapter_id": 9552, "verse_number": "७-१७-३०", "content_sanskrit": "धर्षितायास्त्वयानार्य न मे जीवितमिष्यते ।\nरक्षस्तस्मात्प्रवेक्ष्यामि पश्यतस्ते हुताशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000552030, "chapter_id": 9552, "verse_number": "७-१७-३१", "content_sanskrit": "यस्मात्तु धर्षिता चाहं त्वया पापात्मना वने ।\nतस्मात्तव वधार्थं हि समुत्पत्स्ये ह्यहं पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000552031, "chapter_id": 9552, "verse_number": "७-१७-३२", "content_sanskrit": "न हि शक्यं स्त्रिया हन्तुं पुरुषः पापनिश्चः ।\nशापे त्वयि मयोत्सृष्टे तपसश्च व्ययो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000552032, "chapter_id": 9552, "verse_number": "७-१७-३३", "content_sanskrit": "यदि त्वस्ति मया किञ्चित्कृतं दत्तं हुतं तथा ।\nतस्मात्त्वयोनिजा साध्वी भवेयं धर्मिणः सुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000552033, "chapter_id": 9552, "verse_number": "७-१७-३४", "content_sanskrit": "एवमुक्त्वा प्रविष्टा सा ज्वलितं जातवेदसम् ।\nपपात च दिवो दिव्या पुष्पवृष्टिः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000552034, "chapter_id": 9552, "verse_number": "७-१७-३५", "content_sanskrit": "पुनरेव समुद्भूता पद्मे पद्मसमप्रभा ।\nतस्मादपि पुनः प्राप्ता पूर्ववत्तेन रक्षसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000552035, "chapter_id": 9552, "verse_number": "७-१७-३६", "content_sanskrit": "कन्यां कमलगर्भाभां प्रगृह्य स्वगृहं ययौ ।\nप्रगृह्य रावणस्त्वेतां दर्शयामास मन्त्रिणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000552036, "chapter_id": 9552, "verse_number": "७-१७-३७", "content_sanskrit": "लक्षणज्ञो निरीक्ष्यैव रावणं चैवमब्रवीत् ।\nगृहस्थैषां हि सुश्रोणी त्वद्वधायैव दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000552037, "chapter_id": 9552, "verse_number": "७-१७-३८", "content_sanskrit": "एतच्छ्रुत्वा ऽर्णवे राम तां प्रचिक्षेप रावणः ।\nसा चैव क्षितिमासाद्य यज्ञायतनमध्यगा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000552038, "chapter_id": 9552, "verse_number": "७-१७-३९", "content_sanskrit": "राज्ञो हलमुखोत्कृष्टा पुनरप्युत्थिता सती ।\nसैषा जनकराजस्य प्रसूता तनया प्रभो ।\nतव भार्या महाबाहो विष्णुस्त्वं हि सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000552039, "chapter_id": 9552, "verse_number": "७-१७-४०", "content_sanskrit": "पूर्वं क्रोधाहितः शत्रुर्यया ऽसौ निहतस्तथा ।\nउपाश्रयित्वा शैलभस्तव वीर्यममानुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000552040, "chapter_id": 9552, "verse_number": "७-१७-४१", "content_sanskrit": "एवमेषा महाभागा मर्त्येषूत्पत्स्यते पुनः ।\nक्षेत्रे हलमुखोत्कृष्टे वेद्यामग्निशिखोपमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000552041, "chapter_id": 9552, "verse_number": "७-१७-४२", "content_sanskrit": "एषा वेदवती नाम पूर्वमासीत्कृते युगे ।\nत्रेतायुगमनुप्राप्य वधार्थं तस्य रक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000552042, "chapter_id": 9552, "verse_number": "७-१७-४३", "content_sanskrit": "उत्पन्ना मैथिलकुले जनकस्य महात्मनः ।\nसीतोत्पन्ना तु सीतेति मानुषैः पुनरुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000552043, "chapter_id": 9552, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे सप्तदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]