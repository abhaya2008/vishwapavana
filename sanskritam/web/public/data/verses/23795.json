[{"id": 7003795000, "chapter_id": 23795, "verse_number": "२-२-३९-१", "content_sanskrit": "मुनय ऊचुः ।\nमुने त्वत्तः श्रुतं सम्यङ्माहात्म्यं जगदीशितुः ।\nनिर्माल्यप्रभृतीनां च यथावदनुपूर्वशः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003795001, "chapter_id": 23795, "verse_number": "२-२-३९-२", "content_sanskrit": "श्रोतुमिच्छामहे ब्रह्मन्यात्रां तरफलानि वै ।\nशृण्वतां तत्त्वतो ब्रूहि यथोद्देशः कृतः पुरा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003795002, "chapter_id": 23795, "verse_number": "२-२-३९-३", "content_sanskrit": "जैमिनिरुवाच ।\nसर्वथा वर्त्तते लोकहिताय पुरुषोत्तमः ।\nनानागुणविकासैश्च नानारूपविचेष्टितैः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003795003, "chapter_id": 23795, "verse_number": "२-२-३९-४", "content_sanskrit": "नानारूपविलासेन नानात्मा च जगन्मयः ।\nअहंकारं विना कर्मफलं नो द्विजसत्तमाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003795004, "chapter_id": 23795, "verse_number": "२-२-३९-५", "content_sanskrit": "अहंकारेण बध्यन्ते कारागारे भवाभिधे ।\nबुद्ध्यहंकारयुक्तस्तु यत्कर्मारभते नरः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003795005, "chapter_id": 23795, "verse_number": "२-२-३९-६", "content_sanskrit": "तस्य सद्गुणमाप्नोति फलं शुभमथापरम् ।\nबुद्धिस्तु त्रिविधा तेषां गुणभेदेन भाविता ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003795006, "chapter_id": 23795, "verse_number": "२-२-३९-७", "content_sanskrit": "तत्र ये सात्त्विकाः संतः फलावाप्तिपराङ्मुखाः ।\nभगवत्प्रीतये कर्म कुर्वते ते मुमुक्षवः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003795007, "chapter_id": 23795, "verse_number": "२-२-३९-८", "content_sanskrit": "परस्य स्पर्द्धया कीर्त्यै फलमुद्दिश्य वा पुनः ।\nबहुवित्तव्ययायासै राजसं कर्म तन्वते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003795008, "chapter_id": 23795, "verse_number": "२-२-३९-९", "content_sanskrit": "गतानुगतिका ये च दृष्टार्थैकपरायणाः ।\nप्रसंगात्फलमिच्छंतस्तामसं कर्म कुर्वते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003795009, "chapter_id": 23795, "verse_number": "२-२-३९-१०", "content_sanskrit": "सात्त्विकानां जगन्नाथः सर्वदा सर्वभावनः ।\nध्यातो दृष्टः स्मृतो वापि मुक्तिदाता न संशयः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003795010, "chapter_id": 23795, "verse_number": "२-२-३९-११", "content_sanskrit": "राजसास्तामसा ये वै मूढात्मानः फलैषिणः ।\nउत्सवादिकृतं कर्म मन्यंते फलदायि ते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003795011, "chapter_id": 23795, "verse_number": "२-२-३९-१२", "content_sanskrit": "संभूय बहवो विप्रा आरभंतेऽल्पकं विधिम् ।\nबहुलायासदुःखं यत्कर्म तेषां फलप्रदम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003795012, "chapter_id": 23795, "verse_number": "२-२-३९-१३", "content_sanskrit": "तेषामुद्धरणार्थाय विश्वासाय दुरात्मनाम् ।\nयात्रा नानाविधा विप्रा वर्षे वर्षे प्रवर्तयेत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003795013, "chapter_id": 23795, "verse_number": "२-२-३९-१४", "content_sanskrit": "जन्मस्नानं महावेद्या उत्सवश्च प्रकीर्तितः ।\nमहायात्राद्वयं पुंसां कीर्तनात्पापनाशनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003795014, "chapter_id": 23795, "verse_number": "२-२-३९-१५", "content_sanskrit": "दर्शनं दक्षिणामूर्तेस्तथा च शयनोत्सवः ।\nसर्वपापहरश्चैषामुत्सवो दक्षिणायने ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003795015, "chapter_id": 23795, "verse_number": "२-२-३९-१६", "content_sanskrit": "अतः परं प्रवक्ष्यामि पार्श्वस्य परिवर्तनम् ।\nशयितस्य जगद्भर्तुः परिवर्तयितुर्युगम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003795016, "chapter_id": 23795, "verse_number": "२-२-३९-१७", "content_sanskrit": "नभस्य विमले पक्षे संप्राप्ते हरिवासरे ।\nविष्णोः स्वापगृहद्वारि शनैर्गत्वा प्रविश्य च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003795017, "chapter_id": 23795, "verse_number": "२-२-३९-१८", "content_sanskrit": "नमस्कृत्वा जगन्नाथं पर्यंके शयितं मुदा ।\nअवच्छाद्य शनैर्गत्वा पूजयेदुपचारकैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003795018, "chapter_id": 23795, "verse_number": "२-२-३९-१९", "content_sanskrit": "प्रणम्य भक्त्या तत्पादौ गुह्योपनिषदैः स्तुवन् ।\nमन्त्रं चेमं पठन्देवं स्वापयेदुत्तरामुखम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003795019, "chapter_id": 23795, "verse_number": "२-२-३९-२०", "content_sanskrit": "देवदेव जगन्नाथ कल्पानां परिवर्तक ।\nपरिवृत्तमिदं सर्वं येन स्थावरजंगमम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003795020, "chapter_id": 23795, "verse_number": "२-२-३९-२१", "content_sanskrit": "यदिच्छाचेष्टितैरेव जाग्रत्स्वप्नसुषुप्तिभिः ।\nजगद्धिताय सुप्तोऽसि पार्श्वेन परिवर्त्तय ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003795021, "chapter_id": 23795, "verse_number": "२-२-३९-२२", "content_sanskrit": "परिवर्त्तनकालोऽयं जगतः पालनाय ते ।\nतवाज्ञयाऽयं शक्रोऽपि ध्वजे तिष्ठन्समुत्सुकः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003795022, "chapter_id": 23795, "verse_number": "२-२-३९-२३", "content_sanskrit": "द्रष्टुं त्वत्पादकमलं विमुचञ्जलदैर्जलम् ।\nमहीतलं प्लावयति प्रजापालनहेतुकम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003795023, "chapter_id": 23795, "verse_number": "२-२-३९-२४", "content_sanskrit": "इति संप्रार्थ्य देवेशं वीप्सया तोषयेत्ततः ।\nव्यजनैश्चामरैश्चैव वीजयेदनुकल्पकृत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003795024, "chapter_id": 23795, "verse_number": "२-२-३९-२५", "content_sanskrit": "सुगन्धचन्दनैरस्य सर्वांगं परिलेपयेत् ।\nस्वादूनिक्षुविकारांश्च विकृतैः पायसैस्तथा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003795025, "chapter_id": 23795, "verse_number": "२-२-३९-२६", "content_sanskrit": "यावकानि च हृद्यानि फलानि विविधानि वै ।\nस्वादूपदंशानन्यांश्च घृतपूपान्सपायसान् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003795026, "chapter_id": 23795, "verse_number": "२-२-३९-२७", "content_sanskrit": "पक्वतांबूल पत्राणि सोपस्काराणि च द्विजाः ।\nशय्यागृहद्वारि विभोः शनैर्भक्त्या निवेदयेत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003795027, "chapter_id": 23795, "verse_number": "२-२-३९-२८", "content_sanskrit": "तस्मिन्दिने हरे रूपं भवेद्यदि महाफलम् ।\nदेवमुद्दिश्य यः कुर्यात्सर्वमक्षयतां व्रजेत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003795028, "chapter_id": 23795, "verse_number": "२-२-३९-२९", "content_sanskrit": "स्नानं दानं जपो होमस्तपो जागरणं तथा ।\nउपवासश्च नियमो व्रतांते द्विजतर्पणम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003795029, "chapter_id": 23795, "verse_number": "२-२-३९-३०", "content_sanskrit": "सांगं व्रतमिदं कृत्वा विष्णुलोकमवाप्नुयात् ।\nयं यं कामयते चित्ते तं तमाप्नोत्यसंशयम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003795030, "chapter_id": 23795, "verse_number": "२-२-३९-३१", "content_sanskrit": "अयं वः कथितो विप्राः पार्श्वपर्यायणोत्सवः ।\nअनायासेन लोकानामक्षयः सुखदायकः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003795031, "chapter_id": 23795, "verse_number": "२-२-३९-३२", "content_sanskrit": "अतः परं वै शृणुत उत्थापनमहोत्सवम् ।\nपूजयित्वा जगन्नाथं कौमुद्याख्ये महोत्सवे ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003795032, "chapter_id": 23795, "verse_number": "२-२-३९-३३", "content_sanskrit": "अक्षक्रीडादिभिः पुष्पवस्त्रमाल्यानुलेपनैः ।\nततोस्मिन्पौर्णमास्यायां रात्रावुत्सवसंयुतम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003795033, "chapter_id": 23795, "verse_number": "२-२-३९-३४", "content_sanskrit": "नारिकेलादिभिर्द्रव्यैः पिष्टकैरर्चयेद्धरिम् ।\nततः प्रभाते संकल्प्य कार्त्तिके व्रतमुत्तमम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003795034, "chapter_id": 23795, "verse_number": "२-२-३९-३५", "content_sanskrit": "व्रतेन तेनैव नयेद्यावदेकादशी सिता ।\nतस्यामुत्थापयेद्देवं सुसुप्तं जगदीश्वरम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003795035, "chapter_id": 23795, "verse_number": "२-२-३९-३६", "content_sanskrit": "पूर्ववत्पूजयित्वा तु निशामध्ये जगद्गुरुम् ।\nउत्थापयेदिमं मंत्रमाह्वयञ्छनकैर्मुदा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003795036, "chapter_id": 23795, "verse_number": "२-२-३९-३७", "content_sanskrit": "उत्तिष्ठ देवदेवेश तेजोराशे जगत्पते ।\nवीक्षस्व सकलं देव प्रसुप्तं तव मायया ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003795037, "chapter_id": 23795, "verse_number": "२-२-३९-३८", "content_sanskrit": "प्रफुल्लपुंडरीकश्रीहारिणा नयनेन वै ।\nत्वया दृष्टं जगदिदं पावित्र्यं परमेष्यति ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003795038, "chapter_id": 23795, "verse_number": "२-२-३९-३९", "content_sanskrit": "श्रौतस्मार्त्ताः क्रियाः सर्वाः प्रवर्तंते ततो ध्रुवम् ।\nइत्युत्थाप्य जगन्नाथं वेणुवीणादिकस्वनैः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003795039, "chapter_id": 23795, "verse_number": "२-२-३९-४०", "content_sanskrit": "बंदिमागधसूतानां स्तुतिभिर्मंगलस्वनैः ।\nशंखकाहालमुरजवादनैर्नृत्यगीतकैः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003795040, "chapter_id": 23795, "verse_number": "२-२-३९-४१", "content_sanskrit": "जयशब्दैस्तथा स्तोत्रैर्नयंत्तं नृत्यमण्डपम् ।\nसुगन्धतैलेनाभ्यज्य स्नापयेत्पुरुषोत्तमम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003795041, "chapter_id": 23795, "verse_number": "२-२-३९-४२", "content_sanskrit": "पञ्चामृतैर्नारिकेलरसैः फलरसैस्तथा ।\nसुगन्धामलकेनाथ यवकल्केन लेपयेत् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003795042, "chapter_id": 23795, "verse_number": "२-२-३९-४३", "content_sanskrit": "घर्षयेत्तुलसीचूर्णैर्लेपयेद्गन्धचन्दनैः ।\nपुष्पाधिवासितैस्तोयैस्तथा कर्पूरवासितैः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003795043, "chapter_id": 23795, "verse_number": "२-२-३९-४४", "content_sanskrit": "कुशोदकै रत्नतोयैस्तथा गंधोदकैस्तथा ।\nस्नाप्यमानं तथा देवं ये पश्यंति मुदान्विताः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003795044, "chapter_id": 23795, "verse_number": "२-२-३९-४५", "content_sanskrit": "क्षालयन्ति दृढं पंकं बहुजन्मोपपादितम् ।\nततः श्रीजगदीशस्य क्रोडे संवासयेद्द्विजाः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003795045, "chapter_id": 23795, "verse_number": "२-२-३९-४६", "content_sanskrit": "आपादान्मूर्धपर्यंतं सर्वागं परिलेपयेत् ।\nकुंकुमागुरुकस्तूरीकर्पूरैश्चंदनान्वितैः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003795046, "chapter_id": 23795, "verse_number": "२-२-३९-४७", "content_sanskrit": "पाटलोदकसंपिष्टैः कालागुरुरसाप्लुतैः ।\nदत्त्वा च मालतीमाला चन्द्रचूर्णेन संयुताम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003795047, "chapter_id": 23795, "verse_number": "२-२-३९-४८", "content_sanskrit": "महोपचारैः संपूज्य विष्णुं नीराजयेत्ततः ।\nकृतांजलिपुटो भूत्वा प्रार्थयेत्परया मुदा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003795048, "chapter_id": 23795, "verse_number": "२-२-३९-४९", "content_sanskrit": "चराचरमिदं सर्वं त्वदेकशरणं विभो ।\nअनुग्रहामृतालोकैः पावयस्व जगद्गुरो ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003795049, "chapter_id": 23795, "verse_number": "२-२-३९-५०", "content_sanskrit": "नृत्यगीतैः प्रेक्षणकै रात्रिशेषं समापयेत् ।\nशयनादुत्थितं देवं यः पश्यति गदाधरम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003795050, "chapter_id": 23795, "verse_number": "२-२-३९-५१", "content_sanskrit": "निद्रां मोहमयीं भित्त्वा ज्योतिः शांतं व्रजंति ते ।\nसर्वान्कामानवाप्नोति यान्यान्कामयते हृदि ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003795051, "chapter_id": 23795, "verse_number": "२-२-३९-५२", "content_sanskrit": "अश्वमेधसहस्रस्य फलं साग्रं लभेत वै ।\nकपिलालंकृताधेनुकोटिदानफलं तथा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003795052, "chapter_id": 23795, "verse_number": "२-२-३९-५३", "content_sanskrit": "पुण्यं चाप्नोति परमं सर्वतीर्थाभिषेकजम् ।\nकार्त्तिक्यां पारणं कुर्याच्चातुर्मास्यव्रतस्य वै ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003795053, "chapter_id": 23795, "verse_number": "२-२-३९-५४", "content_sanskrit": "दामोदरस्य प्रतिमां स्वर्णनिष्केण निर्मिताम् ।\nयथाशक्तिकृतां वापि शालग्रामशिलास्थिताम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003795054, "chapter_id": 23795, "verse_number": "२-२-३९-५५", "content_sanskrit": "चक्रमूर्तिं भगवतः पूजयेत्प्रयतात्मवान् ।\nरचयेन्मण्डपं शुभ्रमेकदेशं गृहस्य वा ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003795055, "chapter_id": 23795, "verse_number": "२-२-३९-५६", "content_sanskrit": "अलंकुर्यात्पुष्पदामचामरैः सवितानकैः ।\nभूमिभित्तीः सुधालेपैः स्तंभैश्चित्रदुकूलकैः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003795056, "chapter_id": 23795, "verse_number": "२-२-३९-५७", "content_sanskrit": "कालागुरूणां धूपैश्च धूपयेत्तद्गृहं शुभम् ।\nतन्मध्ये मण्डलं कुर्यात्स्वस्तिकं वर्णकैः शुभैः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003795057, "chapter_id": 23795, "verse_number": "२-२-३९-५८", "content_sanskrit": "तदन्तः स्थापयेत्खट्वां करिदन्तमयीं शुभाम् ।\nपट्टतूलीं तदुपरि वासयेत्पुरुषोत्तमम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003795058, "chapter_id": 23795, "verse_number": "२-२-३९-५९", "content_sanskrit": "दामोदराकृतिं शंखपद्मपाणिं चतुर्भुजम् ।\nलक्ष्मीमालिंग्य पद्मस्थां क्रोडस्थां वामपाणिना ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003795059, "chapter_id": 23795, "verse_number": "२-२-३९-६०", "content_sanskrit": "भक्तेभ्यो दातुमुद्यंतं वरं दक्षिणपाणिना ।\nसुनासं सुललाटं च सुनेत्रं सुश्रुतिद्वयम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003795060, "chapter_id": 23795, "verse_number": "२-२-३९-६१", "content_sanskrit": "विशालवक्षसं देवं सर्वलावण्यसंयुतम् ।\nसर्वालंकाररुचिरं दिव्यपीतनिचोलिनम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003795061, "chapter_id": 23795, "verse_number": "२-२-३९-६२", "content_sanskrit": "लक्ष्मीं पद्मकरां वापि तांबूलं ददतीं तथा ।\nपञ्चामृतैः स्नापयित्वा वासोयुग्मेन वेष्टयेत् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003795062, "chapter_id": 23795, "verse_number": "२-२-३९-६३", "content_sanskrit": "पूजयेदुपचारैस्तं यथाविभवविस्तरैः ।\nताम्रदीपान्मृन्मयान्वा ज्वालयेद्गव्यसर्पिषा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003795063, "chapter_id": 23795, "verse_number": "२-२-३९-६४", "content_sanskrit": "तैलेन वा शतं दीपवृक्षांश्चैव प्रदापयेत् ।\nब्रह्माणं नारदादींश्च देवर्षींस्तत्र पूजयेत् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003795064, "chapter_id": 23795, "verse_number": "२-२-३९-६५", "content_sanskrit": "दामोदरस्वरूपान्वै ब्राह्मणानपि पूजयेत् ।\nवस्त्रयुग्मैर्माल्यगन्धैर्भक्ष्यभोज्यफलैस्तथा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003795065, "chapter_id": 23795, "verse_number": "२-२-३९-६६", "content_sanskrit": "तीर्थराजाभिषेकांगं पूजाकर्म यथोचितम् ।\nदामोदरस्य तेनैव विधिनेहार्चनं भवेत् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003795066, "chapter_id": 23795, "verse_number": "२-२-३९-६७", "content_sanskrit": "तद्विष्णोरिति मन्त्रेण ब्रह्मादीनपि पूजयेत् ।\nवेणुवीणादिकैर्गीतैः पुराणपठनेन च ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003795067, "chapter_id": 23795, "verse_number": "२-२-३९-६८", "content_sanskrit": "महोत्सवं प्रकुर्वीत ततो जागरणेन च ।\nततः प्रभाते विमलेऽग्निकार्यं च समाचरेत् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003795068, "chapter_id": 23795, "verse_number": "२-२-३९-६९", "content_sanskrit": "अष्टाक्षरेण मंत्रेण समिदाज्यचरूनपि ।\nलाजान्मधुसमिन्मिश्राञ्जुहुयाच्च ततः श्रिये ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003795069, "chapter_id": 23795, "verse_number": "२-२-३९-७०", "content_sanskrit": "सूक्तेनाष्टोत्तरशतं ब्रह्मादीनां तदन्ततः ।\nअष्टाहुतीर्वै जुहुयात्क्रमादेकैकशस्तिलैः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003795070, "chapter_id": 23795, "verse_number": "२-२-३९-७१", "content_sanskrit": "ब्रह्माणं नारदं दक्षं वसिष्ठं गौतमं तथा ।\nसनत्कुमारमत्रिं च भरद्वाजं च कश्यपम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003795071, "chapter_id": 23795, "verse_number": "२-२-३९-७२", "content_sanskrit": "दुर्वाससमगस्त्यं च महादेवं ततः परम् ।\nविख्याता वैष्णवा ह्येते विष्णुरूपा न संशयः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003795072, "chapter_id": 23795, "verse_number": "२-२-३९-७३", "content_sanskrit": "एतान्संपूजयन्विप्रान्विष्णुः प्रीणाति तत्क्षणात् ।\nहोमांते प्राशनं कृत्वा दद्यादाचार्यदक्षिणाम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003795073, "chapter_id": 23795, "verse_number": "२-२-३९-७४", "content_sanskrit": "सुवर्णभूषितां धेनुं वस्त्रं धान्यं च भक्तितः ।\nप्रीतये वासुदेवस्य भोजयेद्द्विजपुंगवान् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003795074, "chapter_id": 23795, "verse_number": "२-२-३९-७५", "content_sanskrit": "सर्वोपचारसहितं दद्याद्दामोदरं ततः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003795075, "chapter_id": 23795, "verse_number": "२-२-३९-७६", "content_sanskrit": "ॐ दामोदर जगन्नाथ त्वन्मयं विश्वमेव हि ।\nत्वदाधारमिदं सर्वं त्वं धर्मः सर्वभावनः॥  ।\nत्वत्प्रसादाद्व्रतं चीर्णं सुसंपूर्णं तदस्तु मे ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003795076, "chapter_id": 23795, "verse_number": "२-२-३९-७७", "content_sanskrit": "दामोदरः प्रदाता च गृहीता च वृषध्वजः ।\nप्रदीयते जगन्नाथः प्रीयतां मे जगद्गुरुः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003795077, "chapter_id": 23795, "verse_number": "२-२-३९-७८", "content_sanskrit": "इति मंत्रं जपन्दद्यादाचार्याय सुरोत्तमम् ।\nसमाप्य पूजयेद्भक्त्या स्तूयात्तं च प्रसादयेत् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003795078, "chapter_id": 23795, "verse_number": "२-२-३९-७९", "content_sanskrit": "आचार्ये परितुष्टे तु तुष्टो भवति माधवः ।\nतत्तद्द्रव्याणि च ततो दद्याद्विप्रेभ्य एव हि ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003795079, "chapter_id": 23795, "verse_number": "२-२-३९-८०", "content_sanskrit": "ततः स्वयं वै भुंजीत इष्टैः शिष्टैः स्वबंधुभिः ।\nचातुर्मास्यव्रतं चेदं प्रतिष्ठाप्य विधानतः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003795080, "chapter_id": 23795, "verse_number": "२-२-३९-८१", "content_sanskrit": "यथोक्तफलसंपन्नो विष्णुलोकमवाप्नुयात् ।\nश्रुतिस्मृतिपुराणेषु नातः परतरं व्रतम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003795081, "chapter_id": 23795, "verse_number": "२-२-३९-८२", "content_sanskrit": "येनानुष्ठितमात्रेण कृतकृत्यो भवेन्नरः ।\nविष्णोः प्रीतिकरं यादृङ्न तथान्यद्व्रतं द्विजाः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003795082, "chapter_id": 23795, "verse_number": "२-२-३९-८३", "content_sanskrit": "तिलपात्रसहस्रैस्तु गवां चैवायुतायुतैः ।\nकृष्णाजिनशतेनापि कन्यानामयुतेन च ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003795083, "chapter_id": 23795, "verse_number": "२-२-३९-८४", "content_sanskrit": "दत्त्वा यत्फलमाप्नोति कृत्वैतद्व्रतमुत्तमम् ।\nसार्द्धत्रिकोटितीर्थानामभिषेकफलं तथा ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003795084, "chapter_id": 23795, "verse_number": "२-२-३९-८५", "content_sanskrit": "प्राप्नोति तत्फलं विप्रा यं यं कामयते नरः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003795085, "chapter_id": 23795, "verse_number": "२-२-३९-८६", "content_sanskrit": "इति श्री स्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे पुरुषोत्तमक्षेत्रमाहात्म्ये चातुर्मास्यव्रतविधिर्नामैकोनचत्वारिंशोऽध्यायः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}]