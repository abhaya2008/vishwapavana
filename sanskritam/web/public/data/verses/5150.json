[{"id": 2194994, "chapter_id": 5150, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2194995, "chapter_id": 5150, "verse_number": "१", "content_sanskrit": "शमो बहुविधाकारः सूक्ष्म उक्तः पितामह ।\nन तु मे हृदये शान्तिरस्ति कृत्वेदमीदृशम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2194996, "chapter_id": 5150, "verse_number": "२", "content_sanskrit": "अस्मिन्नर्थे बहुविधा शान्तिरुक्ता त्वयाऽनघ ।\nस्वकृतस्य न शान्तिः स्याच्छमाद् बहुविधादपि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2194997, "chapter_id": 5150, "verse_number": "३", "content_sanskrit": "शराचितशरीरं हि तीव्रव्रणमुदीक्ष्य च ।\nशर्म नोपलभे वीर दुष्कृतान्येव चिन्तयन्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2194998, "chapter_id": 5150, "verse_number": "४", "content_sanskrit": "रुधिरेणावसिक्ताङ्गं प्रस्रवन्तं यथाऽचलम् ।\nत्वां दृष्ट्वा पुरुषव्याघ्र सीदे वर्षास्विवाम्बुजम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2194999, "chapter_id": 5150, "verse_number": "५", "content_sanskrit": "इतः कष्टतरं किं नु मत्कृते यत् पितामहः ।\nइमामवस्थां गमितः प्रत्यमित्रै रणाजिरे ।\nतथैवान्ये नृपतयः सहपुत्राः सबान्धवाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2195000, "chapter_id": 5150, "verse_number": "६", "content_sanskrit": "वयं हि धार्तराष्ट्राश्च कालमन्युवशानुगाः ।\nकृत्वा च निन्दितं कर्म प्राप्स्यामः कां गतिं पुनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2195001, "chapter_id": 5150, "verse_number": "७", "content_sanskrit": "अहं तव ह्यन्तकरः सुहृद्वधकरस्तथा ।\nन शान्तिमधिगच्छामि पश्यंस्त्वां दुःखितं क्षितौ\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2195002, "chapter_id": 5150, "verse_number": "८", "content_sanskrit": "दुर्योधनो हि समरे सहसैन्यः सहानुजः ।\nनिहतः क्षत्रधर्मेऽस्मिन् दुरात्मा कुलपांसनः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2195003, "chapter_id": 5150, "verse_number": "९", "content_sanskrit": "न स पश्यति दुष्टात्मा त्वामद्य पतितं क्षितौ ।\nअतः श्रेयो मृतं मन्ये नेह जीवितमात्मनः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2195004, "chapter_id": 5150, "verse_number": "१०", "content_sanskrit": "अहं हि समरे वीर गमितः शत्रुभिः क्षयम् ।\nअभविष्यं यदि पुरा सह भ्रातृभिरच्युत \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2195005, "chapter_id": 5150, "verse_number": "११", "content_sanskrit": "न त्वामेवं सुदुःखार्तमद्राक्षं सायकार्दितम् ।\nनूनं हि पापकर्माणो धात्रा सृष्टाः वयं नृप\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2195006, "chapter_id": 5150, "verse_number": "१२", "content_sanskrit": "अन्यस्मिन्नपि लोके हि यथा मुच्येम किल्बिषात् ।\nतथा प्रशाधि मां राजन् मम चेदिच्छसि प्रियम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2195007, "chapter_id": 5150, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2195008, "chapter_id": 5150, "verse_number": "१३", "content_sanskrit": "परतन्त्रं कथं हेतुमात्मानमनुपश्यसि ।\nकर्मण्यस्मिन् महाभाग सूक्ष्मं ह्येतदतीन्द्रियम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2195009, "chapter_id": 5150, "verse_number": "१४", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nसंवादं मृत्युगौतम्योः काललुब्धकपन्नगैः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2195010, "chapter_id": 5150, "verse_number": "१५", "content_sanskrit": "गौतमी नाम कौन्तेय स्थविरा शमसंयुता ।\nसर्पेण दष्टं स्वं पुत्रमपश्यद् गतचेतनम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2195011, "chapter_id": 5150, "verse_number": "१६", "content_sanskrit": "अथ तं स्नायुपाशेन बद्ध्वा सर्पममर्षितः ।\nलुब्धकोऽर्जुनको नाम गौतम्याः समुपानयत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2195012, "chapter_id": 5150, "verse_number": "१७", "content_sanskrit": "तां चाब्रवीदयं ते स पुत्रहा पन्नगाधमः ।\nब्रूहि क्षिप्रं महाभागे वध्यतां केन हेतुना\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2195013, "chapter_id": 5150, "verse_number": "१८", "content_sanskrit": "अग्नौ प्रक्षिप्यतामेष च्छिद्यतां खण्डशो यथा ।\nन ह्ययं बालहा पापश्चिरं जीवितुमर्हति\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2195014, "chapter_id": 5150, "verse_number": "", "content_sanskrit": "गौतमी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2195015, "chapter_id": 5150, "verse_number": "१९", "content_sanskrit": "विसृजैनमबुद्धिस्त्वं न वध्योऽर्जुनक त्वया ।\nको ह्यात्मानं गुरुं कुर्यात् प्राप्तव्ये सति चिन्तयन्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2195016, "chapter_id": 5150, "verse_number": "२०", "content_sanskrit": "प्लवन्ते धर्मलघवो लोकेऽम्भसि यथा प्लवाः ।\nमज्जन्ति पापगुरवः शस्त्रं स्कन्नमिवोदके\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2195017, "chapter_id": 5150, "verse_number": "२१", "content_sanskrit": "न चामृत्युर्भविता वै हतेऽस्मिन्\nको वात्ययः स्यादहतेऽस्मिन् जनस्य ।\nअस्योत्सङ्गे प्राणमुक्तस्य जन्तोः\nमृत्योर्लोकं को नु गच्छेदनन्तः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2195018, "chapter_id": 5150, "verse_number": "", "content_sanskrit": "लुब्धकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2195019, "chapter_id": 5150, "verse_number": "२२", "content_sanskrit": "जानाम्येवं नेह गुणागुणज्ञाः\nसर्वेर्तियुक्ता गुरवो वै भवन्ति ।\nस्वस्थस्यैते तूपदेशा भवन्ति\nतस्मात् क्षुद्रं सर्पमेनं हनिष्ये \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2195020, "chapter_id": 5150, "verse_number": "२३", "content_sanskrit": "समीप्सन्तः कालयोगं त्यजन्ति\nसद्यः शुचं त्वर्थविदस्त्यजन्ति ।\nश्रेयःक्षयः शोचतां नित्यशो हि\nतस्मात्त्याज्यं जहि शोकं हतेऽस्मिन् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2195021, "chapter_id": 5150, "verse_number": "", "content_sanskrit": "गौतमी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2195022, "chapter_id": 5150, "verse_number": "२४", "content_sanskrit": "न चैवार्तिर्विद्यतेऽस्मद्विधानां\nधर्मारामः सततं सज्जनो हि ।\nनित्यायस्तो बालजनो न चान्यो\nधर्मो ह्येष प्रभवाम्यस्य नाहम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2195023, "chapter_id": 5150, "verse_number": "२५", "content_sanskrit": "न ब्राह्मणानां कोपोऽस्ति कुतः कोपाच्च यातना ।\nमार्दवात् क्षम्यतां साधो मुच्यतामेष पन्नगः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2195024, "chapter_id": 5150, "verse_number": "", "content_sanskrit": "लुब्धकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2195025, "chapter_id": 5150, "verse_number": "२६", "content_sanskrit": "हित्वा लाभं श्रेय एवाव्ययं स्यात्\nसद्योलाभो बलवद्भिः प्रशस्तः ।\nकालाल्लाभो यस्तु सद्यो भवेत\nहते श्रेयः कुत्सिते त्वीदृशे स्यात् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2195026, "chapter_id": 5150, "verse_number": "", "content_sanskrit": "गौतमी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2195027, "chapter_id": 5150, "verse_number": "२७", "content_sanskrit": "काऽर्थप्राप्तिर्गृह्य शत्रुं निहत्य\nका वा शान्तिः प्राप्य शत्रुं नमुक्त्वा ।\nकस्मात्सौम्य भुजगे न क्षमेयं\nमोक्षं वा किं कारणं नास्य कुर्याम् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2195028, "chapter_id": 5150, "verse_number": "", "content_sanskrit": "लुब्धकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2195029, "chapter_id": 5150, "verse_number": "२८", "content_sanskrit": "अस्मादेकस्माद् बहवो रक्षितव्या\nनैको बहुभ्यो गौतमि रक्षितव्यः ।\nकृतागसं धर्मविदस्त्यजन्ति\nसरीसृपं पापमिमं जहि त्वम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2195030, "chapter_id": 5150, "verse_number": "", "content_sanskrit": "गौतमी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2195031, "chapter_id": 5150, "verse_number": "२९", "content_sanskrit": "नास्मिन् हते पन्नगे पुत्रको मे\nसम्प्राप्स्यते लुब्धक जीवितं वै ।\nगुणं चान्यं नास्य वधे प्रपश्ये\nतस्मात् सर्पं लुब्धक मुञ्च चैनम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2195032, "chapter_id": 5150, "verse_number": "", "content_sanskrit": "लुब्धकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2195033, "chapter_id": 5150, "verse_number": "३०", "content_sanskrit": "वृत्रं हत्वा देवराट् स्वर्गभाग् वै\nयज्ञं हत्वा भागमवाप चैव ।\nशूली देवो देववृत्तं कुरु त्वं\nतस्मात् सर्पं जहि मा भूद् विशङ्का \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2195034, "chapter_id": 5150, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2195035, "chapter_id": 5150, "verse_number": "३१", "content_sanskrit": "असकृत् प्रोच्यमानापि गौतमी भुजगं प्रति ।\nलुब्धकेन महाभागा पापे नैवाकरोन्मतिम् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2195036, "chapter_id": 5150, "verse_number": "३२", "content_sanskrit": "ईषदुच्छ्वसमानस्तु कृच्छ्रात् संस्तभ्य पन्नगः ।\nउत्ससर्ज गिरं मन्दां मानुषीं पाशपीडितः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2195037, "chapter_id": 5150, "verse_number": "३३", "content_sanskrit": "को न्वर्जुनक दोषोऽत्र विद्यते मम बालके ।\nअस्वतन्त्रं हि मां मृत्युर्विवशं समचूचुदत् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2195038, "chapter_id": 5150, "verse_number": "३४", "content_sanskrit": "तस्याहं वचनाद् दष्टो न कोपेन न काम्यया ।\nन तत्र किल्बिषं लुब्ध विद्यते मम बालिश \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2195039, "chapter_id": 5150, "verse_number": "", "content_sanskrit": "लुब्धकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2195040, "chapter_id": 5150, "verse_number": "३५", "content_sanskrit": "यद्यन्यवशगेनेदं कृतं ते पन्नगाशुभम् ।\nकारणं वै त्वमप्यत्र तस्मात् त्वमपि किल्बिषी \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2195041, "chapter_id": 5150, "verse_number": "३६", "content_sanskrit": "मृत्पात्रस्य क्रियायां हि दण्डचक्रादयो यथा ।\nकारणत्वे प्रकल्प्यन्ते तथा त्वमपि पन्नग \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2195042, "chapter_id": 5150, "verse_number": "३७", "content_sanskrit": "किल्बिषी चापि मे वध्यः किल्बिषी चासि पन्नग ।\nआत्मानं कारणं ह्यत्र समाख्यासि भुजङ्गम\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2195043, "chapter_id": 5150, "verse_number": "", "content_sanskrit": "सर्पः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2195044, "chapter_id": 5150, "verse_number": "३८", "content_sanskrit": "सर्व एते ह्यस्ववशा दण्डचक्रादयो यथा ।\nतथाहमपि तस्मान्मे नैष हेतुर्मतस्तव \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2195045, "chapter_id": 5150, "verse_number": "३९", "content_sanskrit": "अथ वा मतमेतत् ते तेऽप्यन्योन्यप्रयोजकाः ।\nकार्यकारणसन्देहो भवत्यन्योन्यचोदनात् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2195046, "chapter_id": 5150, "verse_number": "४०", "content_sanskrit": "एवं सति न दोषो मे नास्मि वध्यो न किल्बिषी ।\nकिल्बिषं मन्यसे हि त्वं वध्यमेवं प्रभाषसे \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2195047, "chapter_id": 5150, "verse_number": "", "content_sanskrit": "लुब्धकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2195048, "chapter_id": 5150, "verse_number": "४१", "content_sanskrit": "कारणं यदि न स्याद्वै न कर्ता स्यास्त्वमप्युत ।\nविनाशे कारणं त्वं च तस्माद् वध्योऽसि मे मतः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2195049, "chapter_id": 5150, "verse_number": "४२", "content_sanskrit": "असत्यविकृते कार्ये नेह पन्नग लिप्यते ।\nतस्मात्त्वं नात्र हेतुः स्याद् वध्यः किं बहु भाषसे \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2195050, "chapter_id": 5150, "verse_number": "४३", "content_sanskrit": "कार्याभावे क्रिया न स्यात्सत्यसत्यपि कारणे ।\nसमे त्वमत्र हेतौ मे वाच्यो हेतुर्विशेषतः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2195051, "chapter_id": 5150, "verse_number": "", "content_sanskrit": "सर्पः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2195052, "chapter_id": 5150, "verse_number": "४४", "content_sanskrit": "यद्यहं कारणत्वेन मतो लुब्धक तत्त्वतः ।\nअन्यः प्रयोक्ता स्यादत्र किल्बिषी जन्तुनाशने \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2195053, "chapter_id": 5150, "verse_number": "", "content_sanskrit": "लुब्धकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2195054, "chapter_id": 5150, "verse_number": "४५", "content_sanskrit": "वध्यस्त्वं मम दुर्बुद्धे बालघाती नृशंसकृत् ।\nभाषसे किं पुनस्त्वं तु वध्यः सन् पन्नगाधम \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2195055, "chapter_id": 5150, "verse_number": "", "content_sanskrit": "सर्पः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2195056, "chapter_id": 5150, "verse_number": "४६", "content_sanskrit": "यथा हवींषि जुह्वाना अग्नौ वै लुब्धकर्त्विजः ।\nन फलं प्राप्नुवन्त्यत्र फलयोगात् तथा ह्यहम् \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2195057, "chapter_id": 5150, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2195058, "chapter_id": 5150, "verse_number": "४७", "content_sanskrit": "तथा ब्रुवति तस्मिंस्तु पन्नगे मृत्युचोदिते ।\nआजगाम ततो मृत्युः पन्नगं चाब्रवीदिदम् \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2195059, "chapter_id": 5150, "verse_number": "४८", "content_sanskrit": "कालेनाहं प्रणुदितः पन्नग त्वामचूचुदम् ।\nविनाशहेतुर्नास्य त्वमहं वा प्राणिनः शिशोः \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2195060, "chapter_id": 5150, "verse_number": "४९", "content_sanskrit": "यथा वायुर्बलोपेतो विकर्षति जलप्रदान् ।\nतद्वज्जलदवच्चाहं कालस्याहं वशानुगः \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2195061, "chapter_id": 5150, "verse_number": "५०", "content_sanskrit": "सात्त्विका राजसाश्चैव तामसाश्चैव केचन ।\nभावाः कालात्मकाः सर्वे प्रवर्तन्ते हि जन्तुषु \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2195062, "chapter_id": 5150, "verse_number": "५१", "content_sanskrit": "जङ्गमाः स्थावराश्चैव दिवि वा यदि वा भुवि ।\nसर्वे कालात्मकाः सर्प कालात्मकमिदं जगत् \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2195063, "chapter_id": 5150, "verse_number": "५२", "content_sanskrit": "प्रवृत्तयश्च या लोके तथैव च निवृत्तयः ।\nतासां प्रकृतयो याश्च सर्वं कालात्मकं स्मृतम् \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2195064, "chapter_id": 5150, "verse_number": "५३", "content_sanskrit": "आदित्यश्चन्द्रमा विष्णुरापो वायुः शतक्रतुः ।\nअग्निः खं पृथिवी मित्र ओषध्यो मरुतो दिशः \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2195065, "chapter_id": 5150, "verse_number": "५४", "content_sanskrit": "सरितः सागराश्चैव भावाभावौ च पन्नग ।\nसर्वे कालेन सृज्यन्ते ह्रियन्ते च तथा पुनः \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2195066, "chapter_id": 5150, "verse_number": "५५", "content_sanskrit": "एवं ज्ञात्वा कथं मां त्वं सदोषं सर्प मन्यसे ।\nअथ चैवङ्गते दोषो मयि त्वमपि दोषवान् \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2195067, "chapter_id": 5150, "verse_number": "", "content_sanskrit": "सर्पः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2195068, "chapter_id": 5150, "verse_number": "५६", "content_sanskrit": "निर्दोषं दोषवन्तं वा न त्वा मृत्यो ब्रवीम्यहम् ।\nत्वयाहं चोदित इति ब्रवीम्येतावदेव तु \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2195069, "chapter_id": 5150, "verse_number": "५७", "content_sanskrit": "यदि काले तु दोषोऽस्ति यदि तत्रापि नेष्यते ।\nदोषो नैव परीक्ष्यो मे न ह्यत्राधिकृता वयम् \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2195070, "chapter_id": 5150, "verse_number": "५८", "content_sanskrit": "निर्मोक्षस्त्वस्य दोषस्य मया कार्यो यथा तथा ।\nमृत्यो विदोषः स्यामेव यथा तन्मे प्रयोजनम् \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2195071, "chapter_id": 5150, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2195072, "chapter_id": 5150, "verse_number": "५९", "content_sanskrit": "सर्पोऽथार्जुनकं प्राह श्रुतं ते मृत्युभाषितम् ।\nनानागसं मां पाशेन सन्तापयितुमर्हसि\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2195073, "chapter_id": 5150, "verse_number": "", "content_sanskrit": "लुब्धकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2195074, "chapter_id": 5150, "verse_number": "६०", "content_sanskrit": "मृत्योः श्रुतं मे वचनं तव चैव भुजङ्गम ।\nनैव तावद् विदोषत्वं भवति त्वयि पन्नग\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2195075, "chapter_id": 5150, "verse_number": "६१", "content_sanskrit": "मृत्युस्त्वं चैव हेतुर्हि जन्तोरस्य विनाशने ।\nउभयं कारणं मन्ये न कारणमकारणम्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2195076, "chapter_id": 5150, "verse_number": "६२", "content_sanskrit": "मृत्युं त्वधिगमिष्यामि ध्रुवं दुःखकरं सताम् ।\nत्वां चैवाहं वधिष्यामि पापं पापस्य कारणम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2195077, "chapter_id": 5150, "verse_number": "", "content_sanskrit": "मृत्युः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2195078, "chapter_id": 5150, "verse_number": "६३", "content_sanskrit": "विवशौ कालवशगावावां तद्दिष्टकारिणौ ।\nनावां दोषेण मन्तव्यौ यदि सम्यक् प्रपश्यसि\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2195079, "chapter_id": 5150, "verse_number": "", "content_sanskrit": "लुब्धकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2195080, "chapter_id": 5150, "verse_number": "६४", "content_sanskrit": "युवामुभौ कालवशौ यदि वै मृत्युपन्नगौ ।\nहर्षक्रोधौ कथं स्यातामेतदिच्छामि वेदितुम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2195081, "chapter_id": 5150, "verse_number": "", "content_sanskrit": "मृत्युः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2195082, "chapter_id": 5150, "verse_number": "६५", "content_sanskrit": "याः काश्चिदिह चेष्टाः स्युः सर्वाः कालवशानुगाः ।\nपूर्वमेवैतदुक्तं हि मया लुब्धक कालतः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2195083, "chapter_id": 5150, "verse_number": "६६", "content_sanskrit": "तस्मादुभौ कालवशावावां तद्दिष्टकारिणौ ।\nनावां दोषेण मन्तव्यौ त्वया लुब्धक कर्हिचित्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2195084, "chapter_id": 5150, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2195085, "chapter_id": 5150, "verse_number": "६७", "content_sanskrit": "अथोपगम्य कालस्तु तस्मिन् धर्मार्थसंशये ।\nअब्रवीत् पन्नगं मृत्युं लुब्धमर्जुनकं च तम्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2195086, "chapter_id": 5150, "verse_number": "", "content_sanskrit": "कालः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2195087, "chapter_id": 5150, "verse_number": "६८", "content_sanskrit": "नैवाहं नाप्ययं मृत्युर्नायं लुब्धक पन्नगः ।\nकिल्बिषी जन्तुमरणे न वयं हि प्रयोजकाः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2195088, "chapter_id": 5150, "verse_number": "६९", "content_sanskrit": "अकरोद् यदयं कर्म तन्नोऽर्जुनक चोदकम् ।\nप्रणाशहेतुर्नान्योऽस्य वध्यतेऽयं स्वकर्मणा\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2195089, "chapter_id": 5150, "verse_number": "७०", "content_sanskrit": "यदनेन कृतं कर्म तेनायं निधनं गतः ।\nविनाशहेतुः कर्मास्य सर्वे कर्मवशा वयम्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2195090, "chapter_id": 5150, "verse_number": "७१", "content_sanskrit": "कर्मदायादवाँल्लोकः कर्मसम्बन्धलक्षणः ।\nकर्माणि चोदयन्तीह यथान्योन्यं तथा वयम्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2195091, "chapter_id": 5150, "verse_number": "७२", "content_sanskrit": "यथा मृत्पिण्डतः कर्ता कुरुते यद्यदिच्छति ।\nएवमात्मकृतं कर्म मानवः प्रतिपद्यते\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2195092, "chapter_id": 5150, "verse_number": "७३", "content_sanskrit": "यथा छायातपौ नित्यं सुसम्बद्धौ निरन्तरम् ।\nतथा कर्म च कर्ता च सम्बद्धावात्मकर्मभिः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2195093, "chapter_id": 5150, "verse_number": "७४", "content_sanskrit": "एवं नाहं न वै मृत्युर्न सर्पो न तथा भवान् ।\nन चेयं ब्राह्मणी वृद्धा शिशुरेवात्र कारणम्\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2195094, "chapter_id": 5150, "verse_number": "७५", "content_sanskrit": "तस्मिंस्तथा ब्रुवाणे तु ब्राह्मणी गौतमी नृप ।\nस्वकर्मप्रत्ययाँल्लोकान् मत्वाऽर्जुनकमब्रवीत्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2195095, "chapter_id": 5150, "verse_number": "७६", "content_sanskrit": "नैव कालो न भुजगो न मृत्युरिह कारणम् ।\nस्वकर्मभिरयं बालः कालेन निधनं गतः\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2195096, "chapter_id": 5150, "verse_number": "७७", "content_sanskrit": "मया च तत्कृतं कर्म येनायं मे सुतो हतः ।\nयातु कालस्तथा मृत्युर्मुञ्चार्जुनक पन्नगम्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2195097, "chapter_id": 5150, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2195098, "chapter_id": 5150, "verse_number": "७८", "content_sanskrit": "ततो यथागतं जग्मुर्मृत्युः कालोऽथ पन्नगः ।\nअभूद् विरोषोऽर्जुनको विशोका चैव गौतमी\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2195099, "chapter_id": 5150, "verse_number": "७९", "content_sanskrit": "एतच्छ्रुत्वा शमं गच्छ मा भूश्चिन्तापरो नृप ।\nस्वकर्मप्रत्ययाँल्लोकांस्त्रीन् विद्धि मनुजर्षभ\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2195100, "chapter_id": 5150, "verse_number": "८०", "content_sanskrit": "न तु त्वया कृतं पार्थ नापि दुर्योधनेन वै ।\nकालेन तत्कृतं विद्धि विहता येन पार्थिवाः\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2195101, "chapter_id": 5150, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2195102, "chapter_id": 5150, "verse_number": "८१", "content_sanskrit": "इत्येतद्वचनं श्रुत्वा बभूव विगतज्वरः ।\nयुधिष्ठिरो महातेजाः पप्रच्छेदं स्वधर्मवित्\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2195103, "chapter_id": 5150, "verse_number": "", "content_sanskrit": "॥ इति श्रीमहाभारते आनुशासनिकपर्वणि प्रथमोऽध्यायः ॥१॥\nदानधर्मपर्वणि प्रथमोऽध्यायः ॥१॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}]