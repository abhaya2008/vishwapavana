[{"id": 7005562000, "chapter_id": 25562, "verse_number": "३५-१", "content_sanskrit": "ययात्युपाख्यानम् ।\nशौनक उवाच ।\nएवं स नाहुषो राजा ययातिः पुत्रमीप्सितम् ।\nराज्येऽभिषिच्य मुदितो वानप्रस्थोऽभवन्मुनिः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005562001, "chapter_id": 25562, "verse_number": "३५-२", "content_sanskrit": "उषित्वा वनवासं स ब्राह्मणैः सह संश्रितः ।\nफलमूलाशनोदान्तो यथा स्वर्गमितो गतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005562002, "chapter_id": 25562, "verse_number": "३५-३", "content_sanskrit": "स गतः स्वर्गवासन्तु न्यवसन् मुदितः सुखी ।\nकालस्य नातिमहतः पुनः शक्रेण पातितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005562003, "chapter_id": 25562, "verse_number": "३५-४", "content_sanskrit": "विवशः प्रच्युतः स्वर्गादप्राप्तो मेदिनी तलम् ।\nस्थितश्चासीदन्तरीक्षे स तदेति श्रुतं मया ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005562004, "chapter_id": 25562, "verse_number": "३५-५", "content_sanskrit": "तत एव पुनश्चापि गतः स्वर्गमिति श्रुतिः ।\nराज्ञा वसुमता सार्द्धमष्टकेन च वीर्य्यवान् ।\nप्रतर्दनेन शिबिना समेत्य किल संसदि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005562005, "chapter_id": 25562, "verse_number": "३५-६", "content_sanskrit": "शतानीक उवाच ।\nकर्मणा केन स दिवं पुनः प्राप्तो महीपतिः ।\nकथमिन्द्रेण भगवन्! पातितो मेदिनीतले ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005562006, "chapter_id": 25562, "verse_number": "३५-७", "content_sanskrit": "सर्वमेदशेषेण श्रोतुमिच्छामि तत्वतः ।\nकथ्यमानं त्वया विप्र! देवर्षिगणसन्निधौ ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005562007, "chapter_id": 25562, "verse_number": "३५-८", "content_sanskrit": "देवराजसमोह्यासीद्ययातिः पृथिवीपतिः ।\nवर्द्धनः कुरुवंशस्य विभावसुसमद्युतिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005562008, "chapter_id": 25562, "verse_number": "३५-९", "content_sanskrit": "तस्य विस्तीर्ण यशसः सत्यकीर्तेर्महात्मनः ।\nश्रोतुमिच्छामि देवेश! दिवि चेह च सर्वशः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005562009, "chapter_id": 25562, "verse_number": "३५-१०", "content_sanskrit": "शौनक उवाच ।\nहन्त ते कथयिष्यामि ययातेरुत्तमां कथाम् ।\nदिवि चेह च पुण्यार्थां सर्वपापप्रणाशिनीम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005562010, "chapter_id": 25562, "verse_number": "३५-११", "content_sanskrit": "ययाति र्नाहुषो राजा पूर्वं पुत्रं कनीयसम् ।\nराज्येऽभिषिच्य मुदितः प्रवव्राज वनं तदा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005562011, "chapter_id": 25562, "verse_number": "३५-१२", "content_sanskrit": "अन्तेषु स विनिक्षिप्य पुत्रान् यदु पुरोगमान् ।\nफलमूलाशनो राजा वनेऽसौ न्यवसच्चिरम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005562012, "chapter_id": 25562, "verse_number": "३५-१३", "content_sanskrit": "स जितात्मा जितक्रोध स्तर्पयन् पितृदेवताः ।\nअग्नींश्च विधिवज्जुह्वन् वानप्रस्थ विधानतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005562013, "chapter_id": 25562, "verse_number": "३५-१४", "content_sanskrit": "अतिथीन् पूजयन्नित्यं वन्येन हविषा विभुः ।\nशिलोञ्छवृत्तिमास्थाय शेषान्न कृतभोजनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005562014, "chapter_id": 25562, "verse_number": "३५-१५", "content_sanskrit": "पूर्णं सहस्रं वर्षाणामेवं वृत्तिरभून्नृपः ।\nअम्बुभक्षः स चाब्दास्त्रीनासीन्नियतवाङ्मनाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005562015, "chapter_id": 25562, "verse_number": "३५-१६", "content_sanskrit": "ततस्तु वायुभक्षोऽभूत्सम्वत्सरमतन्द्रितः ।\nपञ्चाग्निमध्ये च तपस्तेपे सम्वत्सरं पुनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005562016, "chapter_id": 25562, "verse_number": "३५-१७", "content_sanskrit": "एक पादस्थितश्चासीत् षण्मासाननिलाशनः ।\nपुण्यकीर्तिस्ततः स्वर्गं जगामावृत्यरोदसी ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]