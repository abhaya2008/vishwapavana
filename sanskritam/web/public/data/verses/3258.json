[{"id": 2104755, "chapter_id": 3258, "verse_number": "१४-११४-१", "content_sanskrit": "युधिष्ठिर उवाच।\nएवं संवत्सरं पूर्णमेकभुक्तेन यः क्षिपेत्।\nतस्य पुण्यफलं यद्वै तन्ममाचक्ष्व केशव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2104756, "chapter_id": 3258, "verse_number": "१४-११४-२x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2104757, "chapter_id": 3258, "verse_number": "१४-११४-२", "content_sanskrit": "शृणु पाण्डव तत्त्वं मे वचनं पुण्यमुत्तमम्।\nयदकृत्वाऽथवा कृत्वा नरः पापैः प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2104758, "chapter_id": 3258, "verse_number": "१४-११४-३", "content_sanskrit": "एकभुक्तेन वर्तेत नरः संवत्सरं तु यः।\nब्रह्मचारी जितक्रोधो ह्यधश्शायी जितेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2104759, "chapter_id": 3258, "verse_number": "१४-११४-४", "content_sanskrit": "शुचिश्चि स्नानतो व्यग्रः सत्यवागनसूयकः।\nअर्चन्नेव तु मां नित्यं मद्गतेनान्तरात्मना।\nसन्ध्ययोस्तु जपेन्नित्यं मद्गायत्रीं समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2104760, "chapter_id": 3258, "verse_number": "१४-११४-५", "content_sanskrit": "नमो ब्रह्मण्यदेवायेत्यसकृन्मां प्रणम्य च।\nविप्रमग्रासने कृत्वा यावकं भैत्रमेव वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2104761, "chapter_id": 3258, "verse_number": "१४-११४-६", "content_sanskrit": "भुक्त्वा तु वाग्यतो भूमावाचान्तस्य द्विजन्मनः।\nनमोऽस्तु वासुदेवायेत्युक्त्वा तु चरणौ स्पृशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2104762, "chapter_id": 3258, "verse_number": "१४-११४-७", "content_sanskrit": "मासेमासे समाप्ते तु भोजयित्वा द्विजाञ्शुचीन्।\nसंवत्सरे ततः पूर्णे दद्यात्तु व्रतदक्षिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2104763, "chapter_id": 3258, "verse_number": "१४-११४-८", "content_sanskrit": "नवनीतमयीं गां वा तिलधेनुमथापि वा।\nविप्रहस्तच्युतैस्तोयैः सहिरण्यैः समुक्षितः।\nतस्य पुण्यफलं राजन्कथ्यमानं मया शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2104764, "chapter_id": 3258, "verse_number": "१४-११४-९", "content_sanskrit": "दशजन्मकृतं पापं ज्ञानतोऽज्ञानतोपि वा।\nतद्विनश्यति तस्याशु नात्र कार्या विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2104765, "chapter_id": 3258, "verse_number": "१४-११४-१०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2104766, "chapter_id": 3258, "verse_number": "१४-११४-१०", "content_sanskrit": "सर्वेषामुपवासानां यच्छ्रेयः सुमहत्फलम्।\nयच्च निःश्रेयसं लोके तद्भवान्वक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2104767, "chapter_id": 3258, "verse_number": "१४-११४-११x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2104768, "chapter_id": 3258, "verse_number": "१४-११४-११", "content_sanskrit": "शृणु राजन्यथापूर्वं मयाऽभीष्टं तु मोदते।\nतथा ते कथयिष्यामि मद्भक्ताय युधिषठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2104769, "chapter_id": 3258, "verse_number": "१४-११४-१२", "content_sanskrit": "यस्तु भक्त्या शुचिर्भूत्वा पञ्चम्यां मे नराधिप।\nउपवासव्रतं कुर्यात्त्रिकालं चार्चयंस्तु माम्।\nसर्वक्रतुफलं लब्ध्वा मम लोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2104770, "chapter_id": 3258, "verse_number": "१४-११४-१३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2104771, "chapter_id": 3258, "verse_number": "१४-११४-१३", "content_sanskrit": "भगवन्देवदेवेश पञ्चमी नाम का तव।\nतामहं श्रोतुमिच्छामि कथयस्व ममानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2104772, "chapter_id": 3258, "verse_number": "१४-११४-१४x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2104773, "chapter_id": 3258, "verse_number": "१४-११४-१४", "content_sanskrit": "पर्वद्वयं च द्वादश्यां श्रवणं च नराधिप।\nमत्पञ्चमीति विख्यातां मत्प्रिया च विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2104774, "chapter_id": 3258, "verse_number": "१४-११४-१५", "content_sanskrit": "तस्मात्तु ब्राह्मणश्रेष्ठैर्मन्निवेशितबुद्धिभिः।\nउपवासस्तु कर्तव्यो मत्प्रियार्तं विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2104775, "chapter_id": 3258, "verse_number": "१४-११४-१६", "content_sanskrit": "द्वादश्यामेव वा कुर्यादुपवासमशक्नुवन्।\nतेनाहं परमां प्रीति यास्यामि नरपुङ्गव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2104776, "chapter_id": 3258, "verse_number": "१४-११४-१७", "content_sanskrit": "अहोरात्रेण द्वादश्यां मार्गशीर्षेण केशवम्।\nउपोष्य पूजयेद्यो मां सोऽस्वमेधफलं लभेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2104777, "chapter_id": 3258, "verse_number": "१४-११४-१८", "content_sanskrit": "द्वादश्यां पुष्यमासे तु नाम्ना नारायणं तु माम्।\nउपोष्य पूजयेद्यो मां वाजिमेधफलं लभेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2104778, "chapter_id": 3258, "verse_number": "१४-११४-१९", "content_sanskrit": "द्वादश्यां माघमासे तु मामुपोष्य तु माधवम्।\nपूजयेद्यः समाप्नोति राजसूयफलं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2104779, "chapter_id": 3258, "verse_number": "१४-११४-२०", "content_sanskrit": "द्वादश्यां फाल्गुने मासि गोविन्दाख्यमुपोष्य माम्॥\nपूजयेद्यः समाप्नोति ह्यतिरात्रफलं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2104780, "chapter_id": 3258, "verse_number": "१४-११४-२१", "content_sanskrit": "द्वादश्यां मासि चैत्रे तु मां विष्णुं समुपोष्य यः।\nपूजयंस्तदवाप्नोति पौण्डरीकस्य यत्फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2104781, "chapter_id": 3258, "verse_number": "१४-११४-२२", "content_sanskrit": "द्वादश्यां मासि वैशाखे मधुसूदनसंज्ञितम्।\nउपोष्य पूजयेद्यो मां सोग्निष्टोमस्य पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2104782, "chapter_id": 3258, "verse_number": "१४-११४-२३", "content_sanskrit": "द्वादश्यां ज्येष्ठमासे तु मामुपोष्य त्रिविक्रमम्।\nअर्ययेद्यः समाप्नोति गवां मेधफलं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2104783, "chapter_id": 3258, "verse_number": "१४-११४-२४", "content_sanskrit": "आषाढे वामनाख्यं मां द्वादश्यां समुपोष्य यः।\nनरमेधस्य स फलं प्राप्नोति भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2104784, "chapter_id": 3258, "verse_number": "१४-११४-२५", "content_sanskrit": "द्वादश्यां श्रावणे मासि श्रीधराख्यमुपोष्य माम्।\nपूजयेद्य समाप्नोति पञ्चयज्ञफलं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2104785, "chapter_id": 3258, "verse_number": "१४-११४-२६", "content_sanskrit": "मासे भाद्रपदे यो मां हृषीकेशाख्यमर्चयेत्।\nउपोष्य स समाप्नोति सौत्रामणिफलं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2104786, "chapter_id": 3258, "verse_number": "१४-११४-२७", "content_sanskrit": "द्वादश्यामाश्वयुङ्मासे पद्मनाभमुपोष्य माम्।\nअर्चयेद्यः समाप्नोति गोसहस्रफलं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2104787, "chapter_id": 3258, "verse_number": "१४-११४-२८", "content_sanskrit": "द्वादश्यां कार्तिके मासि मां दामोदरसंज्ञितम्।\nउपोष्य पूजयेद्यस्तु सर्वक्रतुफलं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2104788, "chapter_id": 3258, "verse_number": "१४-११४-२९", "content_sanskrit": "केवलेनोपवासेन द्वादश्यां पाण्डुनन्दन।\nयत्फलं पूर्वमुद्दिष्टं तस्यार्धं लभते नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2104789, "chapter_id": 3258, "verse_number": "१४-११४-३०", "content_sanskrit": "श्रावणेऽप्येवमेवं मामर्चयेद्भक्तिमान्नरः।\nमम सालोक्यमाप्नोति नात्र कार्या विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2104790, "chapter_id": 3258, "verse_number": "१४-११४-३१", "content_sanskrit": "मासेमासे समभ्यर्च्य क्रमशो मामतन्द्रितः।\nपूर्मे संवत्सरे कुर्यात्पुनः संवत्सरं तु माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2104791, "chapter_id": 3258, "verse_number": "१४-११४-३२", "content_sanskrit": "अविघ्नमर्चयानस्तु यो मद्भक्तो मत्परायणः।\nअविघ्नमर्चयानस्तु मम सायुज्यमाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2104792, "chapter_id": 3258, "verse_number": "१४-११४-३३", "content_sanskrit": "अर्चयेत्प्रीतिमान्यो मां द्वादस्यां वेदसंहिताम्।\nस पूर्वोक्तफलं राजँल्लभते नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2104793, "chapter_id": 3258, "verse_number": "१४-११४-३४", "content_sanskrit": "गन्धं पुष्पं फलं तोयं पत्रं वा मूलमेव वा।\nद्वादश्यां मम यो दद्यात्तत्समो नास्ति मत्प्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2104794, "chapter_id": 3258, "verse_number": "१४-११४-३५", "content_sanskrit": "एतेन विधिना सर्वे देवाः शक्रपुरोगमाः।\nमद्भक्ता नरशार्दूल स्वर्गलोकं तु भुञ्जते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2104795, "chapter_id": 3258, "verse_number": "१४-११४-३६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2104796, "chapter_id": 3258, "verse_number": "१४-११४-३६", "content_sanskrit": "एवं वदति देवेशे केशवे पाडुनन्दनः।\nकृताञ्जलिः स्तोत्रमिदं भक्त्तया धर्मात्मजोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2104797, "chapter_id": 3258, "verse_number": "१४-११४-३७", "content_sanskrit": "सर्वलोकेश देवेश हृषीकेशक नमोस्तु ते।\nसहस्रशिरसे नित्यं सहस्राक्ष नमोस्तु ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2104798, "chapter_id": 3258, "verse_number": "१४-११४-३८", "content_sanskrit": "त्रयीमय त्रयीनाथ त्रयीस्तुत नमोनमः।\nयज्ञात्मन्यज्ञसंभूत यज्ञनाथ नमोनमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2104799, "chapter_id": 3258, "verse_number": "१४-११४-३९", "content_sanskrit": "चतुर्मूर्ते चतुर्बाहो चतुर्व्यूह नमोनमः।\nलोकात्मँल्लोककृन्नाथ लोकावास नमोनमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2104800, "chapter_id": 3258, "verse_number": "१४-११४-४०", "content_sanskrit": "सृष्टिसंहारकर्त्रे तु नरसिंह नमोनमः।\nभक्तप्रिय नमस्तेऽस्तु कृष्ण नाथ नमोनमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2104801, "chapter_id": 3258, "verse_number": "१४-११४-४१", "content_sanskrit": "लोकप्रिय नमस्तेऽस्तु भक्तवत्सल ते नमः।\nब्रह्मवास नमस्तेऽस्तु ब्रह्मनाथ नमोनमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2104802, "chapter_id": 3258, "verse_number": "१४-११४-४२", "content_sanskrit": "रुद्ररूप नमस्तेऽस्तु रुद्रकर्मिरताय ते।\nपञ्चयज्ञ नमस्तेऽस्तु सर्वयज्ञ नमोनमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2104803, "chapter_id": 3258, "verse_number": "१४-११४-४३", "content_sanskrit": "कृष्णप्रिय नमस्तेऽस्तु कृष्णनाथ नमोनमः।\nयोगिप्रिय नमस्तेऽस्तु योगिनाथ नमोनमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2104804, "chapter_id": 3258, "verse_number": "१४-११४-४४", "content_sanskrit": "हयवक्त्र नमस्तेऽस्तु चक्रपाणे नमोनमः।\nपञ्चभूत नमस्तेऽस्तु पञ्चायुध नमोनमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2104805, "chapter_id": 3258, "verse_number": "१४-११४-४५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2104806, "chapter_id": 3258, "verse_number": "१४-११४-४५", "content_sanskrit": "भक्तिगद्गदया वाचा स्तुवत्येवं युधिष्ठिरे।\nगृहीत्वा केशवो हस्ते प्रीतात्मा तं न्यवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2104807, "chapter_id": 3258, "verse_number": "१४-११४-४६", "content_sanskrit": "निवार्य च पुनर्वाचा भक्तिनम्रं युधिष्ठिरम्।\nवक्तुमेव नरश्रेषठ धर्मपूत्रं प्रचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2104808, "chapter_id": 3258, "verse_number": "१४-११४-४७x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2104809, "chapter_id": 3258, "verse_number": "१४-११४-४७", "content_sanskrit": "अन्यवत्किमिदं राजन्मां स्तौषि नरपुङ्गव।\nतिष्ठ पृच्छ यथापूर्वं धर्मपूत्र युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2104810, "chapter_id": 3258, "verse_number": "१४-११४-४८x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2104811, "chapter_id": 3258, "verse_number": "१४-११४-४८", "content_sanskrit": "भगवंस्त्वत्प्रसादात्तु धर्मं स्मृत्वा पुनःपुनः।\nन शान्तिरस्ति मे देव नृत्यतीव च मे मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2104812, "chapter_id": 3258, "verse_number": "१४-११४-४९", "content_sanskrit": "इदं च धर्मसंपन्नं वक्तुमर्हसि माधव।\nकृष्णपक्षेषु द्वादश्यामर्चनीयः कथं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2104813, "chapter_id": 3258, "verse_number": "१४-११४-५०x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2104814, "chapter_id": 3258, "verse_number": "१४-११४-५०", "content_sanskrit": "शृणु राजन्यथापूर्वं तत्सर्वं कथयामि ते।\nपरमं कृष्णद्वादश्यामर्चनायां फलं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2104815, "chapter_id": 3258, "verse_number": "१४-११४-५१", "content_sanskrit": "एकादश्यामुपोष्याथ द्वादश्यामर्चयेत्तु माम्।\nविप्रानपि यथालाभं पूजयेद्भक्तिमान्नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2104816, "chapter_id": 3258, "verse_number": "१४-११४-५२", "content_sanskrit": "स गच्छेद्दक्षिणामूर्तिं मां वा नात्र विचारणा।\nचन्द्रसालोक्यमथवा ग्रहनक्षत्रपूजितः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2104817, "chapter_id": 3258, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि वैष्णवधर्मपर्वणि चतुर्दशाधिकशततमोऽध्यायः॥ ११४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]