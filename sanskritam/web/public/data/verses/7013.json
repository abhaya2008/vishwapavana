[
  {
    "id": 20132105,
    "chapter_id": 7013,
    "verse_number": "33.1",
    "content_sanskrit": "अथ त्रयस्त्रिंशो ऽध्यायः",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20132106,
    "chapter_id": 7013,
    "verse_number": "33.2",
    "content_sanskrit": "गुणात् प्रवर्तते गानं दोषं चैव निरस्यते । तस्माद्यत्नेन विज्ञेयौ गुणदोषौ समासतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20132107,
    "chapter_id": 7013,
    "verse_number": "33.3",
    "content_sanskrit": "गाता प्रत्यग्रवयाः स्निग्धो मधुरस्वरोपचितकण्ठः । लयतालकलापातप्रमाणयोगेषु तत्त्वज्ञः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20132108,
    "chapter_id": 7013,
    "verse_number": "33.4",
    "content_sanskrit": "रूपगुणकान्तियुक्ता माधुर्योपेतसत्वसम्पन्नाः । पेशलमधुरस्निग्धानुनादिसमरक्त गुरुकण्ठाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20132109,
    "chapter_id": 7013,
    "verse_number": "33.5",
    "content_sanskrit": "(शुभ)",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20132110,
    "chapter_id": 7013,
    "verse_number": "33.6",
    "content_sanskrit": "सुविहितगमकविधायिन्यो ऽक्षोभ्यास् ताललयकुशलाः । आतोद्यार्पितकरणा विज्ञेया गायिकाः श्यामाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20132111,
    "chapter_id": 7013,
    "verse_number": "33.7",
    "content_sanskrit": "प्रायेण तु स्वभावात् स्त्रीणां गानं नृणां च पाठ्यविधिः । स्त्रीणां स्वभावमधुरः कण्ठो नृणां बलित्वं च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20132112,
    "chapter_id": 7013,
    "verse_number": "33.8",
    "content_sanskrit": "यत्र स्त्रीणां पाठ्यं गुणैर्नराणां च गानमधुरत्वम् । ज्ञेयो ऽलङ्कारो ऽसौ न हि स्वभावो ह्ययं तेषाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20132113,
    "chapter_id": 7013,
    "verse_number": "33.9",
    "content_sanskrit": "सुनिविष्टपाणिलययतियोगज्ञौसुमधुरलघुहस्तौ । गातृगुणैश्चोपेताववहितमनसौ सुसङ्गीतौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20132114,
    "chapter_id": 7013,
    "verse_number": "33.10",
    "content_sanskrit": "स्फुटरचितचित्रकरणौ गीतश्रवणाचलौप्रवीणौ च । चित्रादिवाद्यकुशलौवीणाभ्यां वादकौ भवतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20132115,
    "chapter_id": 7013,
    "verse_number": "33.11",
    "content_sanskrit": "बलवानवहितबुद्धिर्गीतलयज्ञस्तथासुसङ्गीतः । श्रावकमधुरस्निग्धो दृढपाणिर्वंशवादको ज्ञेयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20132116,
    "chapter_id": 7013,
    "verse_number": "33.12",
    "content_sanskrit": "अविचलितमविच्छन्नं वर्णालङ्कारबोधकंमधुरम् । स्निग्धं दोषविहीनं वेणोरेवं स्मृतं वाद्यम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20132117,
    "chapter_id": 7013,
    "verse_number": "33.13",
    "content_sanskrit": "ज्ञानविज्ञानकरणवचनप्रयोगसिद्धिनिष्पादनानि षडाचार्यगुणा इति ।\nतत्र ज्ञानं शास्त्रावबोधः ।\nयथा च क्रियासम्पादनं विज्ञानम् ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20132118,
    "chapter_id": 7013,
    "verse_number": "33.14",
    "content_sanskrit": "श्रावणो ऽथ घनः स्निग्धो मधुरोह्यवधानवान् । त्रिस्थानशोभीत्येवं तु षट् कण्ठस्य गुणा मताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20132119,
    "chapter_id": 7013,
    "verse_number": "33.15",
    "content_sanskrit": "उदात्तं श्रूयते यस्मात्तस्माच्छ्रावण उच्यते । श्रावणः सुस्वरो यस्मादच्छिन्नः स घनो मतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20132120,
    "chapter_id": 7013,
    "verse_number": "33.16",
    "content_sanskrit": "अरूक्षध्वनिसंयुक्तः स्निग्धस्तज्ज्ञैः प्रकीर्तितः । मनःप्रह्लादनकरः स वै मधुर उच्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20132121,
    "chapter_id": 7013,
    "verse_number": "33.17",
    "content_sanskrit": "स्वरे ऽधिके च हीने च ह्यविरक्तो विधानवान् शिरःकण्ठेष्वभिहितंत्रिस्थानमधुरस्वरः । त्रिस्थानशोभीत्येवं तु स हि तज्ज्ञैरुदाहृतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20132122,
    "chapter_id": 7013,
    "verse_number": "33.18",
    "content_sanskrit": "कपिलो ह्यवस्थितश्चैव तथा सन्दष्ट एव च । काकी च तुम्बकी चैव पञ्च दोषा भवन्ति हि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20132123,
    "chapter_id": 7013,
    "verse_number": "33.19",
    "content_sanskrit": "वैस्वर्यं च भवेद्यत्र तथा स्याद् घर्घरायितम् । कपिलः स तु विज्ञेयः श्लेष्मकण्ठस्तथैव च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20132124,
    "chapter_id": 7013,
    "verse_number": "33.20",
    "content_sanskrit": "ऊनताऽधिकता चापि स्वराणां यत्र दृश्यते । रूक्षदोषहतश्चैव ज्ञेयः स त्वव्यवस्थितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20132125,
    "chapter_id": 7013,
    "verse_number": "33.21",
    "content_sanskrit": "दण्डप्रयोगात् सन्दष्टस्त्वाचार्यैः परिकीर्तितः । यो न विस्तरति स्थाने स्वरमुच्चारणागतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20132126,
    "chapter_id": 7013,
    "verse_number": "33.22",
    "content_sanskrit": "अन्ये तु",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20132127,
    "chapter_id": 7013,
    "verse_number": "33.23",
    "content_sanskrit": "समप्रहरणे चैव जविनौ विशदौ तथा जितश्रमौ विकृष्टौ च मधुरौ स्वेदवर्जितौ । तथा बृयन्नखौ चैव ज्ञेयौ हस्तस्य वै गुणाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20132128,
    "chapter_id": 7013,
    "verse_number": "33.24",
    "content_sanskrit": "इति",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20132129,
    "chapter_id": 7013,
    "verse_number": "33.25",
    "content_sanskrit": "एते गुणाश्च दोषाश्च तत्त्वतः कथितो मया । अत ऊर्ध्वं प्रवक्ष्यामि ह्यवनद्धविधिं पुनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20132130,
    "chapter_id": 7013,
    "verse_number": "33.26",
    "content_sanskrit": "इति भरतीये नाट्यशास्त्रे गुणदोषविचारो नामाध्यायस्त्रयस्त्रिंशः",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  }
]