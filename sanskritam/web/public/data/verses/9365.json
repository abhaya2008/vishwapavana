[{"id": 5000365000, "chapter_id": 9365, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे षड्विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000365001, "chapter_id": 9365, "verse_number": "५-२६-१", "content_sanskrit": "प्रसक्ताश्रुमुखी त्वेवं ब्रुवती जनकात्मजा।\nअधोगतमुखी बाला विलप्तुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000365002, "chapter_id": 9365, "verse_number": "५-२६-२", "content_sanskrit": "उन्मत्तेव प्रमत्तेव भ्रान्तचित्तेव शोचती।\nउपावृत्ता किशोरीव विचेष्टन्ती महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000365003, "chapter_id": 9365, "verse_number": "५-२६-३", "content_sanskrit": "राघवस्य प्रमत्तस्य रक्षसा कामरूपिणा।\nरावणेन प्रमथ्याहमानीता क्रोशती बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000365004, "chapter_id": 9365, "verse_number": "५-२६-४", "content_sanskrit": "राक्षसीवशमापन्ना भर्त्स्यमाना च दारुणम्।\nचिन्तयन्ती सुदुःखार्ता नाहं जीवितुमुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000365005, "chapter_id": 9365, "verse_number": "५-२६-५", "content_sanskrit": "नहि मे जीवितेनार्थो नैवार्थैर्न च भूषणैः।\nवसन्त्या राक्षसीमध्ये विना रामं महारथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000365006, "chapter_id": 9365, "verse_number": "५-२६-६", "content_sanskrit": "अश्मसारमिदं नूनमथवाप्यजरामरम्।\nहृदयं मम येनेदं न दुःखेन विशीर्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000365007, "chapter_id": 9365, "verse_number": "५-२६-७", "content_sanskrit": "धिङ्मामनार्यामसतीं याहं तेन विना कृता।\nमुहूर्तमपि जीवामि जीवितं पापजीविका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000365008, "chapter_id": 9365, "verse_number": "५-२६-८", "content_sanskrit": "चरणेनापि सव्येन न स्पृशेयं निशाचरम्।\nरावणं किं पुनरहं कामयेयं विगर्हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000365009, "chapter_id": 9365, "verse_number": "५-२६-९", "content_sanskrit": "प्रत्याख्यानं न जानाति नात्मानं नात्मनः कुलम्।\nयो नृशंसस्वभावेन मां प्रार्थयितुमिच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000365010, "chapter_id": 9365, "verse_number": "५-२६-१०", "content_sanskrit": "छिन्ना भिन्ना प्रभिन्ना वा दीप्ता वाग्नौ प्रदीपिता।\nरावणं नोपतिष्ठेयं किं प्रलापेन वश्चिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000365011, "chapter_id": 9365, "verse_number": "५-२६-११", "content_sanskrit": "ख्यातः प्राज्ञः कृतज्ञश्च सानुक्रोशश्च राघवः।\nसद‍्वृत्तो निरनुक्रोशः शङ्के मद्भाग्यसंक्षयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000365012, "chapter_id": 9365, "verse_number": "५-२६-१२", "content_sanskrit": "राक्षसानां जनस्थाने सहस्राणि चतुर्दश।\nएकेनैव निरस्तानि स मां किं नाभिपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000365013, "chapter_id": 9365, "verse_number": "५-२६-१३", "content_sanskrit": "निरुद्धा रावणेनाहमल्पवीर्येण रक्षसा।\nसमर्थः खलु मे भर्ता रावणं हन्तुमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000365014, "chapter_id": 9365, "verse_number": "५-२६-१४", "content_sanskrit": "विराधो दण्डकारण्ये येन राक्षसपुंगवः।\nरणे रामेण निहतः स मां किं नाभिपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000365015, "chapter_id": 9365, "verse_number": "५-२६-१५", "content_sanskrit": "कामं मध्ये समुद्रस्य लङ्केयं दुष्प्रधर्षणा।\nन तु राघवबाणानां गतिरोधो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000365016, "chapter_id": 9365, "verse_number": "५-२६-१६", "content_sanskrit": "किं नु तत् कारणं येन रामो दृढपराक्रमः।\nरक्षसापहृतां भार्यामिष्टां यो नाभिपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000365017, "chapter_id": 9365, "verse_number": "५-२६-१७", "content_sanskrit": "इहस्थां मां न जानीते शङ्के लक्ष्मणपूर्वजः।\nजानन्नपि स तेजस्वी धर्षणां मर्षयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000365018, "chapter_id": 9365, "verse_number": "५-२६-१८", "content_sanskrit": "हृतेति मां योऽधिगत्य राघवाय निवेदयेत्।\nगृध्रराजोऽपि स रणे रावणेन निपातितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000365019, "chapter_id": 9365, "verse_number": "५-२६-१९", "content_sanskrit": "कृतं कर्म महत् तेन मां तथाभ्यवपद्यता।\nतिष्ठता रावणवधे वृद्धेनापि जटायुषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000365020, "chapter_id": 9365, "verse_number": "५-२६-२०", "content_sanskrit": "यदि मामिह जानीयाद् वर्तमानां हि राघवः।\nअद्य बाणैरभिक्रुद्धः कुर्याल्लोकमराक्षसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000365021, "chapter_id": 9365, "verse_number": "५-२६-२१", "content_sanskrit": "निर्दहेच्च पुरीं लङ्कां निर्दहेच्च महोदधिम्।\nरावणस्य च नीचस्य कीर्तिं नाम च नाशयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000365022, "chapter_id": 9365, "verse_number": "५-२६-२२", "content_sanskrit": "ततो निहतनाथानां राक्षसीनां गृहे गृहे।\nयथाहमेवं रुदती तथा भूयो न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000365023, "chapter_id": 9365, "verse_number": "५-२६-२३", "content_sanskrit": "अन्विष्य रक्षसां लङ्कां कुर्याद् रामः सलक्ष्मणः।\nनहि ताभ्यां रिपुर्दृष्टो मुहूर्तमपि जीवति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000365024, "chapter_id": 9365, "verse_number": "५-२६-२४", "content_sanskrit": "चिताधूमाकुलपथा गृध्रमण्डलमण्डिता।\nअचिरेणैव कालेन श्मशानसदृशी भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000365025, "chapter_id": 9365, "verse_number": "५-२६-२५", "content_sanskrit": "अचिरेणैव कालेन प्राप्स्याम्येनं मनोरथम्।\nदुष्प्रस्थानोऽयमाभाति सर्वेषां वो विपर्ययः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000365026, "chapter_id": 9365, "verse_number": "५-२६-२६", "content_sanskrit": "यादृशानि तु दृश्यन्ते लङ्कायामशुभानि तु।\nअचिरेणैव कालेन भविष्यति हतप्रभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000365027, "chapter_id": 9365, "verse_number": "५-२६-२७", "content_sanskrit": "नूनं लङ्का हते पापे रावणे राक्षसाधिपे।\nशोषमेष्यति दुर्धर्षा प्रमदा विधवा यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000365028, "chapter_id": 9365, "verse_number": "५-२६-२८", "content_sanskrit": "पुण्योत्सवसमृद्धा च नष्टभर्त्री सराक्षसा।\nभविष्यति पुरी लङ्का नष्टभर्त्री यथांगना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000365029, "chapter_id": 9365, "verse_number": "५-२६-२९", "content_sanskrit": "नूनं राक्षसकन्यानां रुदतीनां गृहे गृहे।\nश्रोष्यामि नचिरादेव दुःखार्तानामिह ध्वनिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000365030, "chapter_id": 9365, "verse_number": "५-२६-३०", "content_sanskrit": "सान्धकारा हतद्योता हतराक्षसपुंगवा।\nभविष्यति पुरी लङ्का निर्दग्धा रामसायकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000365031, "chapter_id": 9365, "verse_number": "५-२६-३१", "content_sanskrit": "यदि नाम स शूरो मां रामो रक्तान्तलोचनः।\nजानीयाद् वर्तमानां यां राक्षसस्य निवेशने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000365032, "chapter_id": 9365, "verse_number": "५-२६-३२", "content_sanskrit": "अनेन तु नृशंसेन रावणेनाधमेन मे।\nसमयो यस्तु निर्दिष्टस्तस्य कालोऽयमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000365033, "chapter_id": 9365, "verse_number": "५-२६-३३", "content_sanskrit": "स च मे विहितो मृत्युरस्मिन् दुष्टेन वर्तते।\nअकार्यं ये न जानन्ति नैर्ऋताः पापकारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000365034, "chapter_id": 9365, "verse_number": "५-२६-३४", "content_sanskrit": "अधर्मात् तु महोत्पातो भविष्यति हि साम्प्रतम्।\nनैते धर्मं विजानन्ति राक्षसाः पिशिताशनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000365035, "chapter_id": 9365, "verse_number": "५-२६-३५", "content_sanskrit": "ध्रुवं मां प्रातराशार्थं राक्षसः कल्पयिष्यति।\nसाहं कथं करिष्यामि तं विना प्रियदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000365036, "chapter_id": 9365, "verse_number": "५-२६-३६", "content_sanskrit": "रामं रक्तान्तनयनमपश्यन्ती सुदुःखिता।\nक्षिप्रं वैवस्वतं देवं पश्येयं पतिना विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000365037, "chapter_id": 9365, "verse_number": "५-२६-३७", "content_sanskrit": "नाजानाज्जीवतीं रामः स मां भरतपूर्वजः।\nजानन्तौ तु न कुर्यातां नोर्व्यां हि परिमार्गणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000365038, "chapter_id": 9365, "verse_number": "५-२६-३८", "content_sanskrit": "नूनं ममैव शोकेन स वीरो लक्ष्मणाग्रजः।\nदेवलोकमितो यातस्त्यक्त्वा देहं महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000365039, "chapter_id": 9365, "verse_number": "५-२६-३९", "content_sanskrit": "धन्या देवाः सगन्धर्वाः सिद्धाश्च परमर्षयः।\nमम पश्यन्ति ये वीरं रामं राजीवलोचनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000365040, "chapter_id": 9365, "verse_number": "५-२६-४०", "content_sanskrit": "अथवा नहि तस्यार्थो धर्मकामस्य धीमतः।\nमया रामस्य राजर्षेर्भार्यया परमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000365041, "chapter_id": 9365, "verse_number": "५-२६-४१", "content_sanskrit": "दृश्यमाने भवेत् प्रीतिः सौहृदं नास्त्यदृश्यतः।\nनाशयन्ति कृतघ्नास्तु न रामो नाशयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000365042, "chapter_id": 9365, "verse_number": "५-२६-४२", "content_sanskrit": "किं वा मय्यगुणाः केचित् किं वा भाग्यक्षयो हि मे।\nया हि सीता वरार्हेण हीना रामेण भामिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000365043, "chapter_id": 9365, "verse_number": "५-२६-४३", "content_sanskrit": "श्रेयो मे जीवितान्मर्तुं विहीनाया महात्मना।\nरामादक्लिष्टचारित्राच्छूराच्छत्रुनिबर्हणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000365044, "chapter_id": 9365, "verse_number": "५-२६-४४", "content_sanskrit": "अथवा न्यस्तशस्त्रौ तौ वने मूलफलाशनौ।\nभ्रातरौ हि नरश्रेष्ठौ चरन्तौ वनगोचरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000365045, "chapter_id": 9365, "verse_number": "५-२६-४५", "content_sanskrit": "अथवा राक्षसेन्द्रेण रावणेन दुरात्मना।\nछद्मना घातितौ शूरौ भ्रातरौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000365046, "chapter_id": 9365, "verse_number": "५-२६-४६", "content_sanskrit": "साहमेवंविधे काले मर्तुमिच्छामि सर्वतः।\nन च मे विहितो मृत्युरस्मिन् दुःखेऽतिवर्तति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000365047, "chapter_id": 9365, "verse_number": "५-२६-४७", "content_sanskrit": "धन्याः खलु महात्मानो मुनयः सत्यसम्मताः।\nजितात्मानो महाभागा येषां न स्तः प्रियाप्रिये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000365048, "chapter_id": 9365, "verse_number": "५-२६-४८", "content_sanskrit": "प्रियान्न सम्भवेद् दुःखमप्रियादधिकं भवेत्।\nताभ्यां हि ते वियुज्यन्ते नमस्तेषां महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000365049, "chapter_id": 9365, "verse_number": "५-२६-४९", "content_sanskrit": "साहं त्यक्ता प्रियेणैव रामेण विदितात्मना।\nप्राणांस्त्यक्ष्यामि पापस्य रावणस्य गता वशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000365050, "chapter_id": 9365, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे षड्विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]