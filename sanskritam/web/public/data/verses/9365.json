[{"id": 40021724, "chapter_id": 9365, "verse_number": "1", "content_sanskrit": "ततो रजन्यां व्युष्टायां लक्ष्मणो दीनचेतनः । सुमन्त्रमब्रवीद्वाक्यं मुखेन परिशुष्यता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40021725, "chapter_id": 9365, "verse_number": "2", "content_sanskrit": "सारथे तुरगाञ्छीघ्रं योजयस्व रथोत्तमे । स्वास्तीर्णं राजभवनात्सीतायाश्चासनं कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40021726, "chapter_id": 9365, "verse_number": "3", "content_sanskrit": "सीता हि राजवचनादाश्रमं पुण्यकर्मणाम् । मया नेया महर्षीणां श्रीघ्रमानीयतां रथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40021727, "chapter_id": 9365, "verse_number": "4", "content_sanskrit": "सुमन्त्रस्तु तथेत्युक्त्वा युक्तं परमवाजिभिः । रथं सुरुचिरप्रख्यं स्वास्तीर्णं सुखशय्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40021728, "chapter_id": 9365, "verse_number": "5", "content_sanskrit": "आनीयोवाच सौमित्रिं मित्राणां मानवर्धनम् । रथो ऽयं समनुप्राप्तो यत्कार्यं क्रियतां प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40021729, "chapter_id": 9365, "verse_number": "6", "content_sanskrit": "एवमुक्तः सुमन्त्रेण राजवेश्मनि लक्ष्मणः । प्रविश्य सीतामासाद्य व्याजहार नरर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40021730, "chapter_id": 9365, "verse_number": "7", "content_sanskrit": "त्वया किलैष नृपतिर्वरं वै याचितः प्रभुः । नृपेण च प्रतिज्ञातमाज्ञप्तश्चाश्रमं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40021731, "chapter_id": 9365, "verse_number": "8", "content_sanskrit": "गङ्गीतीरे मया देवि ऋषीणामाश्रमाञ्छुभान् । शीघ्रं गत्वा तु वैदेहि शासनात्पार्थिवस्य नः । अरण्ये मुनिभिर्जुष्टे अपनेया भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40021732, "chapter_id": 9365, "verse_number": "9", "content_sanskrit": "एवमुक्ता तु वैदेही लक्ष्मणेन महात्मना । प्रहर्षमतुलं लेभे गमनं चाप्यरोचयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40021733, "chapter_id": 9365, "verse_number": "10", "content_sanskrit": "वासांसि च महार्हाणि रत्नानि विविधानि च । गृहीत्वा तानि वैदेही गमनायोपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40021734, "chapter_id": 9365, "verse_number": "11", "content_sanskrit": "इमानि मुनिपत्नीनां दास्याम्याभरणान्हम् । वस्त्राणि च महार्हाणि धनानि विविधानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40021735, "chapter_id": 9365, "verse_number": "12", "content_sanskrit": "सौमित्रिस्तु तथेत्युक्त्वा रथमारोप्य मैथिलीम् । प्रययौ शीघ्रतुरगै रामस्याज्ञामनुस्मरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40021736, "chapter_id": 9365, "verse_number": "13", "content_sanskrit": "अब्रवीच्च तदा सीता लक्ष्मणं लक्ष्मिवर्धनम् । अशुभानि बहून्येव पश्यामि रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40021737, "chapter_id": 9365, "verse_number": "14", "content_sanskrit": "नयनं मे स्फुरत्यद्य गात्रोत्कम्पश्च जायते । हृदयं चैव सौमित्रे अस्वस्थमिव लक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40021738, "chapter_id": 9365, "verse_number": "15", "content_sanskrit": "औत्सुक्यं परमं चापि अधृतिश्च परा मम । शून्यामेव च पश्यामि पृथिवीं पृथुलोचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40021739, "chapter_id": 9365, "verse_number": "16", "content_sanskrit": "अपि स्वस्ति भवेत्तस्य भ्रातुस्ते भ्रातृवत्सल । श्वश्रूणां चैव मे वीर सर्वासामविशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40021740, "chapter_id": 9365, "verse_number": "17", "content_sanskrit": "पुरे जनपदे चैव कुशलं प्राणिनामपि । इत्यञ्जलिकृता सीता देवता अभ्ययाचत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40021741, "chapter_id": 9365, "verse_number": "18", "content_sanskrit": "लक्ष्मणो ऽर्थं ततः श्रुत्वा शिरसा वन्द्य मैथिलीम् । शिवमित्यब्रवीद्धृष्टो हृदयेन विशुष्यता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40021742, "chapter_id": 9365, "verse_number": "19", "content_sanskrit": "ततो वासमुपागम्य गोमतीतीर आश्रमे । प्रभाते पुनरुत्थाय सौमित्रिः सूतमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40021743, "chapter_id": 9365, "verse_number": "20", "content_sanskrit": "योजयस्व रथं शीघ्रमद्य भागीरथीजलम् । शिरसा धारयिष्यामि त्र्यम्बकः पर्वते यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40021744, "chapter_id": 9365, "verse_number": "21", "content_sanskrit": "सो ऽश्वान् रज्वाथ चतुरो रथे युङ्क्त्वा मनोजवान् । आरोहस्वेति वैदेहीं सूतः प्राञ्जलिरब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40021745, "chapter_id": 9365, "verse_number": "22", "content_sanskrit": "सा तु सूतस्य वचनादारुरोह रथोत्तमम् । सीता सौमित्रिणा सार्धं सुमन्त्रेण च धीमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40021746, "chapter_id": 9365, "verse_number": "23", "content_sanskrit": "आससाद विशालाक्षी गङ्गां पापविनाशिनीम् । अथार्धदिवसं गत्वा भागीरथ्या जलाशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40021747, "chapter_id": 9365, "verse_number": "24", "content_sanskrit": "निरीक्ष्य लक्ष्मणो दीनः प्ररुरोद महास्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40021748, "chapter_id": 9365, "verse_number": "25", "content_sanskrit": "सीता तु परमायत्ता दृष्ट्वा लक्ष्मणमातुरम् । उवाच वाक्यं धर्मज्ञा किमिदं रुद्यते त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40021749, "chapter_id": 9365, "verse_number": "26", "content_sanskrit": "जाह्नवीतीरमासाद्य चिराभिलषितं मम । हर्षकाले किमर्थं मां विषादयसि लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40021750, "chapter_id": 9365, "verse_number": "27", "content_sanskrit": "नित्यं त्वं रामपार्श्वेषु वर्तसे पुरुषर्षभ । कच्चिद्विनाकृतस्तेन द्विरात्रं शोकमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40021751, "chapter_id": 9365, "verse_number": "28", "content_sanskrit": "ममापि दयितो रामो जीवितादपि लक्ष्मण । न चाहमेवं शोचामि मैवं त्वं बालिशो भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40021752, "chapter_id": 9365, "verse_number": "29", "content_sanskrit": "तारयस्व च मां गङ्गां दर्शयस्व च तापसान् । ततो मुनिभ्यो दास्यामि वांसास्याभरणानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40021753, "chapter_id": 9365, "verse_number": "30", "content_sanskrit": "ततः कृत्वा महर्षीणां यथार्हमभिवादनम् । तत्र चैकां निशामुष्य यास्यामस्तां पुरीं पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40021754, "chapter_id": 9365, "verse_number": "31", "content_sanskrit": "ममापि पद्मपत्राक्षं सिंहोरस्कं कृशोदरम् । त्वरते हि मनो द्रष्टुं रामं रमयतां वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40021755, "chapter_id": 9365, "verse_number": "32", "content_sanskrit": "तस्यास्तद्वचनं श्रुत्वा प्रमृज्य नयने शुभे । नाविकानाह्वयामास लक्ष्मणः परवीरहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40021756, "chapter_id": 9365, "verse_number": "33", "content_sanskrit": "इयं च सज्जा नौश्चेति दाशाः प्राञ्जलयो ऽब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40021757, "chapter_id": 9365, "verse_number": "34", "content_sanskrit": "तितीर्षुर्लक्ष्मणो गङ्गां शुभां नावमुपारुहत् । गङ्गां सन्तारयामास लक्ष्मणस्तां समाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]