[{"id": 2178087, "chapter_id": 4764, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2178088, "chapter_id": 4764, "verse_number": "१", "content_sanskrit": "विदुरस्य तु तद्वाक्यं निशम्य कुरुसत्तमः ।\nपुत्रशोकाभिसन्तप्तः पपात भुवि मूर्च्छितः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2178089, "chapter_id": 4764, "verse_number": "२", "content_sanskrit": "तं तथा पतितं भूमौ निःसञ्ज्ञं प्रेक्ष्य बान्धवाः ।\nकृष्णद्वैपायनश्चैव क्षत्ता च विदुरस्तथा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2178090, "chapter_id": 4764, "verse_number": "३", "content_sanskrit": "सञ्जयः सुहृदश्चान्ये तथा ये चास्य सम्मताः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2178091, "chapter_id": 4764, "verse_number": "४", "content_sanskrit": "जलेन सुखशीतेन तालवृन्तैश्च भारत ।\nपस्पृशुः शनकैर्गात्रं वीजमानाश्च यत्नतः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2178092, "chapter_id": 4764, "verse_number": "५", "content_sanskrit": "अन्वासत चिरं कालं धृतराष्ट्रं तथाविधम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2178093, "chapter_id": 4764, "verse_number": "६", "content_sanskrit": "अथ दीर्घस्य कालस्य लब्धसञ्ज्ञो महीपतिः ।\nविललाप चिरं कालं पुत्रार्तिभिरभिप्लुतः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2178094, "chapter_id": 4764, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2178095, "chapter_id": 4764, "verse_number": "७", "content_sanskrit": "धिगस्तु खलु मानुष्यं मानुष्ये च परिग्रहम् ।\nयतो मूलानि दुःखानि सम्भवन्ति पुनः पुनः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2178096, "chapter_id": 4764, "verse_number": "८", "content_sanskrit": "मित्रनाशेऽर्थनाशे च ज्ञातिसम्बन्धिनामपि ।\nप्राप्यते सुमहद्दुःखं विषाग्निप्रतिमं विभो\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2178097, "chapter_id": 4764, "verse_number": "९", "content_sanskrit": "येन दह्यन्ति गात्राणि ये न प्रज्ञा विनश्यति ।\nयेनाभिभूतः पुरुषो मरणं बहुमन्यते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2178098, "chapter_id": 4764, "verse_number": "१०", "content_sanskrit": "तदिदं व्यसनं प्राप्तं मया भाग्यविपर्ययात् ।\nतच्चैवाहं करिष्यामि अद्यैव द्विजसत्तम\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2178099, "chapter_id": 4764, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2178100, "chapter_id": 4764, "verse_number": "११", "content_sanskrit": "इत्युक्त्वा च महात्मानं पितरं ब्रह्मवित्तमम् ।\nधृतराष्ट्रोऽभवन्मूढः शोकं च परमं गतः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2178101, "chapter_id": 4764, "verse_number": "१२", "content_sanskrit": "अभूच्च तूष्णीं राजाऽसौ ध्यायमानो महीपतिः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2178102, "chapter_id": 4764, "verse_number": "१३", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा कृष्णद्वैपायनः प्रभुः ।\nपुत्रशोकाभिसन्तप्तं पुत्रं वचनमब्रवीत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2178103, "chapter_id": 4764, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2178104, "chapter_id": 4764, "verse_number": "१४", "content_sanskrit": "धृतराष्ट्र महाबाहो शृणु वक्ष्यामि पुत्रक\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2178105, "chapter_id": 4764, "verse_number": "१५", "content_sanskrit": "श्रुतवानसि मेधावी धर्मार्थकुशलः प्रभो ।\nन तेऽस्त्यविदितं किञ्चिद् वेदितव्यं परन्तप\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2178106, "chapter_id": 4764, "verse_number": "१६", "content_sanskrit": "अनित्यतां हि भूतानां विजानासि न संशयः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2178107, "chapter_id": 4764, "verse_number": "१७", "content_sanskrit": "अध्रुवे जीवलोकेऽस्मिन् स्थाने वा शाश्वते सति ।\nजीविते मरणान्ते च कस्माच्छोचसि पुत्रक\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2178108, "chapter_id": 4764, "verse_number": "१८", "content_sanskrit": "प्रत्यक्षस्तव राजेन्द्र वैरस्यास्य समुद्भवः ।\nपुत्रं ते कारणं कृत्वा कालयोगेन निर्मितः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2178109, "chapter_id": 4764, "verse_number": "१९", "content_sanskrit": "अवश्यं भवितव्ये च कुरूणां सङ्क्षये नृप ।\nकस्माच्छोचसि तान् शूरान् गतान् परमिकां गतिम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2178110, "chapter_id": 4764, "verse_number": "२०", "content_sanskrit": "जानता च महाबाहो विदुरेण महात्मना ।\nयतितं सर्वयत्नेन शमं प्रति नरेश्वर\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2178111, "chapter_id": 4764, "verse_number": "२१", "content_sanskrit": "न च दैवकृतो मार्गः शक्यो भूतेन केनचित् ।\nघटताऽपि चिरं कालं नियन्तुमिति मे मतिः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2178112, "chapter_id": 4764, "verse_number": "२२", "content_sanskrit": "दैवतानां हि यत् कार्यं मया प्रत्यक्षतः श्रुतम् ।\nतत् तेऽहं सम्प्रवक्ष्यामि कथं स्थैर्यं भवेत् तव\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2178113, "chapter_id": 4764, "verse_number": "२३", "content_sanskrit": "पुराऽहं स्वेच्छया यातः सभामैन्द्रीं जितक्लमः ।\nअपश्यं तत्र च सदा समवेतान् दिवौकसः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2178114, "chapter_id": 4764, "verse_number": "२४", "content_sanskrit": "नारदप्रमुखांश्चापि सर्वान् देवर्षिसत्तमान्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2178115, "chapter_id": 4764, "verse_number": "२५", "content_sanskrit": "तत्रापि च मया दृष्टा पृथिवी पृथिवीपते ।\nकार्यार्थमुपसम्पन्ना देवतानां समीपतः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2178116, "chapter_id": 4764, "verse_number": "२६", "content_sanskrit": "उपागम्य तदा धात्री देवानाह समागतान्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2178117, "chapter_id": 4764, "verse_number": "", "content_sanskrit": "पृथिवी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2178118, "chapter_id": 4764, "verse_number": "२७", "content_sanskrit": "यत् कार्यं मम युष्माभिर्ब्रह्मणः सदने तदा ।\nप्रतिज्ञातं महाभागाः तच्छीघ्रं संविधीयताम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2178119, "chapter_id": 4764, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2178120, "chapter_id": 4764, "verse_number": "२८", "content_sanskrit": "तस्यास्तद्वचनं श्रुत्वा विष्णुर्लोकनमस्कृतः ।\nउवाच प्रहसन् वाक्यं प्रभुस्तां देवसंसदि\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2178121, "chapter_id": 4764, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2178122, "chapter_id": 4764, "verse_number": "२९", "content_sanskrit": "धृतराष्ट्रस्य पुत्राणां यस्तु ज्येष्ठः शतस्य वै ।\nदुर्योधन इति ख्यातः स ते कार्यं करिष्यति\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2178123, "chapter_id": 4764, "verse_number": "३०", "content_sanskrit": "तं च प्राप्य महीपालं कृतकृत्या भविष्यसि\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2178124, "chapter_id": 4764, "verse_number": "३१", "content_sanskrit": "तस्यार्थे पृथिवीपालाः कुरुक्षेत्रं समागताः ।\nअन्योन्यं घातयिष्यन्ति दृढैः शस्त्रैः प्रहारिणः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2178125, "chapter_id": 4764, "verse_number": "३२", "content_sanskrit": "ततस्ते भविता देवि भारस्य युधि नाशनम् ।\nगच्छ शीघ्रं स्वकं स्थानं लोकान् धारय शोभने\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2178126, "chapter_id": 4764, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2178127, "chapter_id": 4764, "verse_number": "३३", "content_sanskrit": "स एष ते सुतो राजन् कालः संहारकारणात् ।\nकलेरंशः समुत्पन्नो गान्धार्या जठरे नृप\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2178128, "chapter_id": 4764, "verse_number": "३४", "content_sanskrit": "अमर्षी बलवान् शूरः क्रोधनो दुष्प्रसाधनः ।\nदैवयोगात् समुत्पन्ना भ्रातरस्तस्य तादृशाः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2178129, "chapter_id": 4764, "verse_number": "३५", "content_sanskrit": "शकुनिर्मातुलश्चैव कर्णश्च परमः सखा ।\nसमुत्पन्ना विनाशार्थं पृथिव्यां सहिता नृपाः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2178130, "chapter_id": 4764, "verse_number": "३६", "content_sanskrit": "एतमर्थं महाबाहो नारदो वेद तत्वतः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2178131, "chapter_id": 4764, "verse_number": "३७", "content_sanskrit": "आत्मापराधात् पुत्रास्ते विनष्टाः पृथिवीपते ।\nमा तान् शोचस्व राजेन्द्र न हि शोकेऽस्ति कारणम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2178132, "chapter_id": 4764, "verse_number": "३८", "content_sanskrit": "न हि ते पाण्डवाः स्वल्पम् अपराध्यन्ति ते नृप ।\nपुत्रास्तव दुरात्मानो यैरियं घातिता मही\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2178133, "chapter_id": 4764, "verse_number": "३९", "content_sanskrit": "नारदेन समाख्यातं पूर्वमेव न संशयः ।\nयुधिष्ठिरस्य समितौ राजसूये निवेदितम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2178134, "chapter_id": 4764, "verse_number": "४०", "content_sanskrit": "पाण्डवाः कौरवाश्चैव समासाद्य परस्परम् ।\nन भविष्यन्ति राजेन्द्र यत् ते कृत्यं तदाचर\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2178135, "chapter_id": 4764, "verse_number": "४१", "content_sanskrit": "नारदस्य वचः श्रुत्वा तथाऽकुर्वत पाण्डवाः ।\nएतत् ते सर्वमाख्यातं देवगुह्यं सनातनम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2178136, "chapter_id": 4764, "verse_number": "४२", "content_sanskrit": "कथं ते शोकनाशः स्यात् प्राणेषु च दया प्रभो ।\nस्नेहश्च पाण्डुपुत्रेषु ज्ञात्वा दैवकृतं विधिम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2178137, "chapter_id": 4764, "verse_number": "४३", "content_sanskrit": "एष चार्थो महाराज पूर्वमेव मया श्रुतः ।\nकथितो धर्मराजस्य राजसूये कुरूत्तम\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2178138, "chapter_id": 4764, "verse_number": "४४", "content_sanskrit": "यतितं धर्मपुत्रेण मया गुह्ये निवेदिते ।\nअविग्रहे कौरवाणां दैवं तु बलवत्तरम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2178139, "chapter_id": 4764, "verse_number": "४५", "content_sanskrit": "अनतिक्रमणीयो हि विधी राजन् कथञ्चन ।\nकृतान्तस्य हि भूतेन चरेण स्थावरेण च\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2178140, "chapter_id": 4764, "verse_number": "४६", "content_sanskrit": "भवान् धर्मपरो यत्र बुद्धिश्रेष्ठश्च भारत ।\nमुह्यते प्राणिनां ज्ञात्वा गतिमागतिमेव च\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2178141, "chapter_id": 4764, "verse_number": "४७", "content_sanskrit": "त्वां तु शोकेन सन्तप्तं मुह्यमानमचेतनम् ।\nज्ञात्वा युधिष्ठिरो राजा प्राणानपि परित्यजेत्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2178142, "chapter_id": 4764, "verse_number": "४८", "content_sanskrit": "कृपालुर्नित्यशो वीरः तिर्यग्योनिगतेष्वपि ।\nस कथं त्वयि राजेन्द्र कृपां वै न करिष्यति\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2178143, "chapter_id": 4764, "verse_number": "४९", "content_sanskrit": "मम चैव नियोगेन विधेश्चाप्यनिवर्तनात् ।\nपाण्डवानां च कारुण्यात् प्राणान् धारय भारत\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2178144, "chapter_id": 4764, "verse_number": "५०", "content_sanskrit": "एवं ते वर्तमानस्य लोके कीर्तिर्भविष्यति ।\nधर्मश्च सुमहांस्तात तप्तस्य तपसश्चिरात्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2178145, "chapter_id": 4764, "verse_number": "५१", "content_sanskrit": "पुत्रशोकं समुत्पन्नं हुताशं ज्वलितं यथा ।\nप्रज्ञाम्भस्मा महाराज निर्वापय सदा सता\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2178146, "chapter_id": 4764, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2178147, "chapter_id": 4764, "verse_number": "५२", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं व्यासस्यामिततेजसः ।\nमुहूर्तं समनुध्याय धृतराष्ट्रोऽभ्यभाषत\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2178148, "chapter_id": 4764, "verse_number": "५३", "content_sanskrit": "महता शोकजालेन प्रणुन्नोऽस्मि द्विजोत्तम ।\nनात्मानमवबुद्ध्यामि मुह्यमानो मुहुर्मुहुः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2178149, "chapter_id": 4764, "verse_number": "५४", "content_sanskrit": "इदं तु वचनं श्रुत्वा तव दैवनियोगजम् ।\nधारयिष्याम्यहं प्राणान् यतिष्ये च न शोचितुम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2178150, "chapter_id": 4764, "verse_number": "५५", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं व्यासः सत्यवतीसुतः ।\nधृतराष्ट्रस्य राजेन्द्र तत्रैवान्तरधीयत\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2178151, "chapter_id": 4764, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां स्त्रीपर्वणि\nधृतराष्ट्रविशोके अष्टमोऽध्यायः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2178152, "chapter_id": 4764, "verse_number": "", "content_sanskrit": "जलप्रदानपर्वणि अष्टमोऽध्यायः ॥८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]