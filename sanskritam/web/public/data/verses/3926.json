[{"id": 2135135, "chapter_id": 3926, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2135136, "chapter_id": 3926, "verse_number": "१", "content_sanskrit": "एवमुक्त्वा परिष्वज्य दैत्यास्तं राजकुञ्जरम् ।\nसमाश्वास्य च दुर्धर्षं पुत्रवद् दानवर्षभाः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2135137, "chapter_id": 3926, "verse_number": "२", "content_sanskrit": "स्थिरां कृत्वा बुद्धिमस्य प्रियाण्युक्त्वा च भारत।\nगम्यतामित्यनुज्ञाय जयमाप्नुहि चेत्यथ \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2135138, "chapter_id": 3926, "verse_number": "३", "content_sanskrit": "तैर्विसृष्टं महाबाहुं कृत्या सैवानयत् पुनः ।\nतमेव देशं यत्रासौ तदा प्रायमुपेयिवान् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2135139, "chapter_id": 3926, "verse_number": "४", "content_sanskrit": "प्रतिनिक्षिप्य तं वीरं कृत्या समभिपूज्य च ।\nअनुज्ञाता च राज्ञा सा तथैवान्तरधीयत \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2135140, "chapter_id": 3926, "verse_number": "५", "content_sanskrit": "गतायामथ तस्यां तु राजा दुर्योधनस्तदा ।\nस्वप्नभूतमिदं सर्वमचिन्तयत भारत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2135141, "chapter_id": 3926, "verse_number": "६", "content_sanskrit": "विजेष्यामि रणे पाण्डूनिति चास्याभवन्मतिः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2135142, "chapter_id": 3926, "verse_number": "७", "content_sanskrit": "संस्मृत्य तानि वाक्यानि दानवोक्तानि दुर्मतिः ।\nकर्णं संशप्तकांश्चैव पार्थस्यामित्रघातिनः ।\nअमन्यत वधे युक्तान् समर्थांश्च सुयोधनः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2135143, "chapter_id": 3926, "verse_number": "८", "content_sanskrit": "एवमाशा दृढा तस्य धार्तराष्ट्रस्य दुर्मतेः ।\nविनिर्जये पाण्डवानामभवद् भरतर्षभ \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2135144, "chapter_id": 3926, "verse_number": "९", "content_sanskrit": "कर्णोऽप्याविष्टचित्तात्मा नरकस्यान्तरात्मना ।\nअर्जुनस्य वधे क्रूरां करोति स्म तदा मतिम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2135145, "chapter_id": 3926, "verse_number": "१०", "content_sanskrit": "संशप्तकाश्च ते वीरा राक्षसाविष्टचेतसः ।\nरजस्तमोभ्यामाक्रान्ताः फल्गुनस्य वधैषिणः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2135146, "chapter_id": 3926, "verse_number": "११", "content_sanskrit": "भीष्मद्रोणकृपाद्याश्च दानवाक्रान्तचेतसः ।\nन तथा पाण्डुपुत्राणां स्नेहवन्तो विशाम्पते \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2135147, "chapter_id": 3926, "verse_number": "१२", "content_sanskrit": "न चाचचक्षे कस्मैचिदेतद् राजा सुयोधनः ।\nकृत्ययाऽऽनाय्यकथितं यदस्य निशि दानवैः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2135148, "chapter_id": 3926, "verse_number": "१३", "content_sanskrit": "दुर्योधनं निशान्ते च कर्णो वैकर्तनोऽव्रवीत् ।\nस्मयन्निवाञ्जलिं कृत्वा पार्थिवं हेतुमद्वचः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2135149, "chapter_id": 3926, "verse_number": "१४", "content_sanskrit": "न मृतो जयते शत्रून् जीवन् भद्राणि पश्यति ।\nमृतस्य भद्राणि कुतः कौरवेय कुतो जयः ।\nन कालोऽद्य विषादस्य भयस्य मरणस्य वा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2135150, "chapter_id": 3926, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2135151, "chapter_id": 3926, "verse_number": "१५", "content_sanskrit": "परिष्वज्याब्रवीच्चैनं भुजाभ्यां स महाबलः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2135152, "chapter_id": 3926, "verse_number": "१६", "content_sanskrit": "उत्तिष्ठ राजन् किं शेषे कस्माच्छोचसि शत्रुहन् ।\nशत्रून् प्रताप्य वीर्येण स कथं मृत्युमिच्छसि \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2135153, "chapter_id": 3926, "verse_number": "१७", "content_sanskrit": "अथवा ते भयं जातं दृष्ट्वाऽर्जुनपराक्रमम् ।\nसत्यं ते प्रतिजानामि वधिष्यामि रणेऽर्जुनम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2135154, "chapter_id": 3926, "verse_number": "१८", "content_sanskrit": "गते त्रयोदशे वर्षे सत्येनायुधमालभे ।\nआनयिष्याम्यहं पार्थान् वशं तव जनाधिप \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2135155, "chapter_id": 3926, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2135156, "chapter_id": 3926, "verse_number": "१९", "content_sanskrit": "एवमुक्तस्तु कर्णेन दैत्यानां वचनात् तथा ।\nप्रणिपातेन चाप्येषामुदतिष्ठत् सुयोधनः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2135157, "chapter_id": 3926, "verse_number": "२०", "content_sanskrit": "दैत्यानां तद्वचः श्रुत्वा हृदि कृत्वा स्थिरां मतिम् ।\nततो मनुजशार्दूलो योजयामास वाहिनीम् ।\nरथनागाश्वकलिलां पदातिजनसङ्कुलाम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2135158, "chapter_id": 3926, "verse_number": "२१", "content_sanskrit": "गङ्गौघप्रतिमा राजन् सा प्रयाता महाचमूः ।\nश्वेतच्छत्रैः पताकाभिश्चामरैश्च सुपाण्डरैः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2135159, "chapter_id": 3926, "verse_number": "२२", "content_sanskrit": "रथैर्नागैः पदातैश्च शुशुभेऽतीव सङ्कुला \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2135160, "chapter_id": 3926, "verse_number": "२३", "content_sanskrit": "व्यपेताभ्रघने काले द्यौरिव व्याप्तशारदी ।\nहंसपङ्क्तिसमाकीर्णा भ्रमत् सारसशोभिता \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2135161, "chapter_id": 3926, "verse_number": "२४", "content_sanskrit": "जयाशीर्भिर्द्विजेन्द्रैः स स्तूयमानोऽधिराजवत् ।\nगृह्णन्नञ्जलिमालाश्च धार्तराष्ट्रो जनाधिपः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2135162, "chapter_id": 3926, "verse_number": "२५", "content_sanskrit": "सुयोधनो ययावग्रे श्रिया परमया ज्वलन् ।\nकर्णेन सार्धं राजेन्द्र सौबलेन च देविना \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2135163, "chapter_id": 3926, "verse_number": "२६", "content_sanskrit": "दुःशासनादयश्चास्य भ्रातरः सर्व एव ते ।\nभूरिश्रवाः सोमदत्तो महाराजश्च बाह्लिकः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2135164, "chapter_id": 3926, "verse_number": "२७", "content_sanskrit": "रथैर्नानाविधाकारैर्हयैर्गजवरैस्तथा ।\nप्रयान्तं नृपसिंहं तमनुजग्मुः कुरूद्वहाः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2135165, "chapter_id": 3926, "verse_number": "२८", "content_sanskrit": "प्रत्युद्गताश्च कुरुभिर्नागरैर्ब्राह्मणैरपि ।\nकालेनाल्पेन राजेन्द्र स्वपुरं विविशुस्तदा \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2135166, "chapter_id": 3926, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि त्रिचत्वारिंशदधिकद्विशततमोऽध्यायः ॥२४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2135167, "chapter_id": 3926, "verse_number": "", "content_sanskrit": "प्रायोप्रवेशपर्वणि दुर्योधनपुरप्रवेशे अष्टमोऽध्यायः ॥८॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]