[{"id": 2035459, "chapter_id": 1766, "verse_number": "५-११-०x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2035460, "chapter_id": 1766, "verse_number": "५-११-१", "content_sanskrit": "ऋषयोऽथाब्रुवन्सर्वे देवाश्च त्रिदिवेश्वराः।\nअयं वै नहुपः श्रीमान्देवराज्येऽभिषिच्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2035461, "chapter_id": 1766, "verse_number": "५-११-२", "content_sanskrit": "तेजस्वी च यशस्वी च धार्मिकश्चैव नित्यदा।\nते गत्वा त्वब्रुवन्सर्वे राजा नो भव पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2035462, "chapter_id": 1766, "verse_number": "५-११-३", "content_sanskrit": "स तानुवाच नहुषो देवानृपिगणांस्तथा ।\nपितृभिः सहितान्राजन्परिप्सन्हितमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2035463, "chapter_id": 1766, "verse_number": "५-११-४", "content_sanskrit": "दुर्बलोऽहं न मे शक्तिर्भवतां परिपालने।\nबलवाञ्ज्ञायतां कश्चिद्बलं शक्रे हि नित्यदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2035464, "chapter_id": 1766, "verse_number": "५-११-५", "content_sanskrit": "तमब्रुवन्पुनः सर्वे देवा ऋषिपुरोगमाः ।\nअस्माकं तपसा युक्तः पाहि राज्यं त्रिविष्टपे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2035465, "chapter_id": 1766, "verse_number": "५-११-६", "content_sanskrit": "परस्परभयं घोरमस्माकं हि न संशयः ।\nअभिषिच्यस्व राजेन्द्र भव राजा त्रिविष्टपे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2035466, "chapter_id": 1766, "verse_number": "५-११-७", "content_sanskrit": "देवदानवयक्षाणामृषीणां रक्षसां तथा।\nपितृगन्धर्वभूतानां चक्षुर्विषयवर्तिनाम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2035467, "chapter_id": 1766, "verse_number": "५-११-८", "content_sanskrit": "तेज आदास्यसे पश्यन्बलवांश्च भविष्यसि।\nधर्मं पुरस्कृत्य सदा सरवलोकाधिपो भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2035468, "chapter_id": 1766, "verse_number": "५-११-९", "content_sanskrit": "ब्रह्मर्षीश्चापि देवांश्च गोपायस्व त्रिविष्टपे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2035469, "chapter_id": 1766, "verse_number": "५-११-९x", "content_sanskrit": "शल्य उवाच।\nअभिषिक्तः स राजेन्द्र ततो राजा त्रिविष्टपे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2035470, "chapter_id": 1766, "verse_number": "५-११-१०", "content_sanskrit": "धर्मं पुरस्कृत्य तदा सर्वलोकाधिपोऽभवत्।\nसुदुर्लभं वरं लब्ध्वा प्राप्य राज्यं त्रिविष्टपे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2035471, "chapter_id": 1766, "verse_number": "५-११-११", "content_sanskrit": "धर्मात्मा सततं भूत्वा कामात्मा समपद्यत।\nदेवोद्यानेषु सर्वेषु नन्दनोपवनेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2035472, "chapter_id": 1766, "verse_number": "५-११-१२", "content_sanskrit": "कैलासे हिमवत्पृष्ठे मन्दरे श्वेतपर्वते।\nसह्ये महेन्द्रे मलये समुद्रेषु सरित्सु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2035473, "chapter_id": 1766, "verse_number": "५-११-१३", "content_sanskrit": "अप्सरोभिः परिवृतो देवकन्यासमावृतः ।\nनहुषो देवराजोऽथ क्रीडन्बहुविधं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2035474, "chapter_id": 1766, "verse_number": "५-११-१४", "content_sanskrit": "श्रृण्वन्दिव्या बहुविधाः कथाः श्रुतिमनोहराः ।\nवादित्राणि च सर्वाणि गीतं च मधुरस्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2035475, "chapter_id": 1766, "verse_number": "५-११-१५", "content_sanskrit": "विश्वावसुर्नारदश्च गन्धर्वाप्सरसां गणाः।\nऋतवः षट्च देवेन्द्रं मूर्तिमन्त उपस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2035476, "chapter_id": 1766, "verse_number": "५-११-१६", "content_sanskrit": "मारुतः सुरभिर्वाति मनोज्ञः सत्वशीतलः ।\nएवं विक्रीडतस्तस्य नहुषस्य दुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2035477, "chapter_id": 1766, "verse_number": "५-११-१७", "content_sanskrit": "संप्राप्ता दर्शनं देवी शक्रस्य महिषी प्रिया।\nस तां संदृश्य दुष्टात्मा प्राह सर्वान्सभासदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2035478, "chapter_id": 1766, "verse_number": "५-११-१८", "content_sanskrit": "इन्द्रस्य महिषी देवी कस्मान्मां नोपतिष्ठति।\nअहमिन्द्रोऽस्मि देवानां लोकानां च तथेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2035479, "chapter_id": 1766, "verse_number": "५-११-१९", "content_sanskrit": "आगच्छतु शची मह्यं क्षिप्रमद्य निवेशनम् ।\nतच्छ्रुत्वा दुर्मना देवी बृहस्पतिमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2035480, "chapter_id": 1766, "verse_number": "५-११-२०", "content_sanskrit": "रक्ष मां नहुषाद्ब्रह्मंस्त्वामस्मि शरणं गता।\nसर्वलक्षणसंपन्नां ब्रह्मंस्त्वं मां प्रभाषसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2035481, "chapter_id": 1766, "verse_number": "५-११-२१", "content_sanskrit": "देवराजस्य दयितामत्यन्तं सुखभागिनीम्।\nअवैधव्येन युक्तां चाप्येकपत्नीं पतिव्रदाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2035482, "chapter_id": 1766, "verse_number": "५-११-२२", "content_sanskrit": "उक्तवानसि मां पूर्वमृतां तां कुरु वै गिरम्।\nनोक्तपूर्वं च भगवन्मृषा ते किंचिदीश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2035483, "chapter_id": 1766, "verse_number": "५-११-२३", "content_sanskrit": "तस्मादेतद्भवेत्सत्यं त्वयोक्तं द्विजसत्तम।\nबृहस्पतिरथोवाच इन्द्राणीं भयमोहिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2035484, "chapter_id": 1766, "verse_number": "५-११-२४", "content_sanskrit": "यदुक्तासि मया देवि सत्यं तद्भविता ध्रुवम् ।\nद्रक्ष्यसे देवराजं तमिन्द्रं शीघ्रमिहागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2035485, "chapter_id": 1766, "verse_number": "५-११-२५", "content_sanskrit": "न भेतव्यं च नहुषात्सत्यमेतद्ब्रवीमि ते।\nसमानयिष्ये शक्रेण नचिराद्भवतीमहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2035486, "chapter_id": 1766, "verse_number": "५-११-२६", "content_sanskrit": "अथ शुश्राव नहुष इन्द्राणीं शरणीं गताम्।\nबृहस्पतेरङ्गिरसश्रुक्रोध स नृपस्तदा ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2035487, "chapter_id": 1766, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि सेनोद्योगपर्वणि एकादशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]