[{"id": 5000077000, "chapter_id": 9077, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे सप्तसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000077001, "chapter_id": 9077, "verse_number": "१-७७-१", "content_sanskrit": "गते रामे प्रशान्तात्मा रामो दाशरथिर्धनुः।\nवरुणायाप्रमेयाय ददौ हस्ते महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000077002, "chapter_id": 9077, "verse_number": "१-७७-२", "content_sanskrit": "अभिवाद्य ततो रामो वसिष्ठप्रमुखानृषीन्।\nपितरं विकलं दृष्ट्वा प्रोवाच रघुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000077003, "chapter_id": 9077, "verse_number": "१-७७-३", "content_sanskrit": "जामदग्न्यो गतो रामः प्रयातु चतुरंगिणी।\nअयोध्याभिमुखी सेना त्वया नाथेन पालिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000077004, "chapter_id": 9077, "verse_number": "१-७७-४", "content_sanskrit": "रामस्य वचनं श्रुत्वा राजा दशरथः सुतम्।\nबाहुभ्यां सम्परिष्वज्य मूर्ध्न्युपाघ्राय राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000077005, "chapter_id": 9077, "verse_number": "१-७७-५", "content_sanskrit": "गतो राम इति श्रुत्वा हृष्टः प्रमुदितो नृपः।\nपुनर्जातं तदा मेने पुत्रमात्मानमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000077006, "chapter_id": 9077, "verse_number": "१-७७-६", "content_sanskrit": "चोदयामास तां सेनां जगामाशु ततः पुरीम्।\nपताकाध्वजिनीं रम्यां तूर्योद‍्घुष्टनिनादिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000077007, "chapter_id": 9077, "verse_number": "१-७७-७", "content_sanskrit": "सिक्तराजपथारम्यां प्रकीर्णकुसुमोत्कराम्।\nराजप्रवेशसुमुखैः पौरैर्मङ्गलपाणिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000077008, "chapter_id": 9077, "verse_number": "१-७७-८", "content_sanskrit": "सम्पूर्णां प्राविशद् राजा जनौघैः समलंकृताम्।\nपौरैः प्रत्युद‍्गतो दूरं द्विजैश्च पुरवासिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000077009, "chapter_id": 9077, "verse_number": "१-७७-९", "content_sanskrit": "पुत्रैरनुगतः श्रीमान् श्रीमद्भिश्च महायशाः।\nप्रविवेश गृहं राजा हिमवत्सदृशं प्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000077010, "chapter_id": 9077, "verse_number": "१-७७-१०", "content_sanskrit": "ननन्द स्वजनै राजा गृहे कामैः सुपूजितः।\nकौसल्या च सुमित्रा च कैकेयी च सुमध्यमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000077011, "chapter_id": 9077, "verse_number": "१-७७-११", "content_sanskrit": "वधूप्रतिग्रहे युक्ता याश्चान्या राजयोषितः।\nततः सीतां महाभागामूर्मिलां च यशस्विनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000077012, "chapter_id": 9077, "verse_number": "१-७७-१२", "content_sanskrit": "कुशध्वजसुते चोभे जगृहुर्नृपयोषितः।\nमंगलालापनैर्होमैः शोभिताः क्षौमवाससः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000077013, "chapter_id": 9077, "verse_number": "१-७७-१३", "content_sanskrit": "देवतायतनान्याशु सर्वास्ताः प्रत्यपूजयन्।\nअभिवाद्याभिवाद्यांश्च सर्वा राजसुतास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000077014, "chapter_id": 9077, "verse_number": "१-७७-१४", "content_sanskrit": "रेमिरे मुदिताः सर्वा भर्तृभिर्मुदिता रहः।\nकृतदाराः कृतास्त्राश्च सधनाः ससुहृज्जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000077015, "chapter_id": 9077, "verse_number": "१-७७-१५", "content_sanskrit": "शुश्रूषमाणाः पितरं वर्तयन्ति नरर्षभाः।\nकस्यचित्त्वथ कालस्य राजा दशरथः सुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000077016, "chapter_id": 9077, "verse_number": "१-७७-१६", "content_sanskrit": "भरतं कैकयीपुत्रमब्रवीद् रघुनन्दनः।\nअयं केकयराजस्य पुत्रो वसति पुत्रक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000077017, "chapter_id": 9077, "verse_number": "१-७७-१७", "content_sanskrit": "त्वां नेतुमागतो वीरो युधाजिन्मातुलस्तव।\nश्रुत्वा दशरथस्यैतद् भरतः कैकयीसुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000077018, "chapter_id": 9077, "verse_number": "१-७७-१८", "content_sanskrit": "गमनायाभिचक्राम शत्रुघ्नसहितस्तदा।\nआपृच्छ्य पितरं शूरो रामं चाक्लिष्टकारिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000077019, "chapter_id": 9077, "verse_number": "१-७७-१९", "content_sanskrit": "मातॄश्चापि नरश्रेष्ठः शत्रुघ्नसहितो ययौ।\nयुधाजित् प्राप्य भरतं सशत्रुघ्नं प्रहर्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000077020, "chapter_id": 9077, "verse_number": "१-७७-२०", "content_sanskrit": "स्वपुरं प्राविशद् वीरः पिता तस्य तुतोष ह।\nगते च भरते रामो लक्ष्मणश्च महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000077021, "chapter_id": 9077, "verse_number": "१-७७-२१", "content_sanskrit": "पितरं देवसंकाशं पूजयामासतुस्तदा।\nपितुराज्ञां पुरस्कृत्य पौरकार्याणि सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000077022, "chapter_id": 9077, "verse_number": "१-७७-२२", "content_sanskrit": "चकार रामः सर्वाणि प्रियाणि च हितानि च।\nमातृभ्यो मातृकार्याणि कृत्वा परमयन्त्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000077023, "chapter_id": 9077, "verse_number": "१-७७-२३", "content_sanskrit": "गुरूणां गुरुकार्याणि काले कालेऽन्ववैक्षत।\nएवं दशरथः प्रीतो ब्राह्मणा नैगमास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000077024, "chapter_id": 9077, "verse_number": "१-७७-२४", "content_sanskrit": "रामस्य शीलवृत्तेन सर्वे विषयवासिनः।\nतेषामतियशा लोके रामः सत्यपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000077025, "chapter_id": 9077, "verse_number": "१-७७-२५", "content_sanskrit": "स्वयंभूरिव भूतानां बभूव गुणवत्तरः।\nरामश्च सीतया सार्धं विजहार बहूनृतून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000077026, "chapter_id": 9077, "verse_number": "१-७७-२६", "content_sanskrit": "मनस्वी तद‍्गतमनास्तस्या हृदि समर्पितः।\nप्रिया तु सीता रामस्य दाराः पितृकृता इति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000077027, "chapter_id": 9077, "verse_number": "१-७७-२७", "content_sanskrit": "गुणाद्रूपगुणाच्चापि प्रीतिर्भूयोऽभिवर्धते।\nतस्याश्च भर्ता द्विगुणं हृदये परिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000077028, "chapter_id": 9077, "verse_number": "१-७७-२८", "content_sanskrit": "अन्तर्गतमपि व्यक्तमाख्याति हृदयं हृदा।\nतस्य भूयो विशेषेण मैथिली जनकात्मजा।\nदेवताभिः समा रूपे सीता श्रीरिव रूपिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000077029, "chapter_id": 9077, "verse_number": "१-७७-२९", "content_sanskrit": "तया स राजर्षिसुतोऽभिकामया।\nसमेयिवानुत्तमराजकन्यया।\nअतीव रामः शुशुभे मुदान्वितो\nविभुः श्रिया विष्णुरिवामरेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000077030, "chapter_id": 9077, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे सप्तसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]