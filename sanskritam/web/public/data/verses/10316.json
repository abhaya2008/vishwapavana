[{"id": 6000316000, "chapter_id": 10316, "verse_number": null, "content_sanskrit": "पञ्चदशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000316001, "chapter_id": 10316, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.001.m4a", "display_order": 2}, {"id": 6000316002, "chapter_id": 10316, "verse_number": "११-१५-१", "content_sanskrit": "जितेन्द्रियस्य युक्तस्य जितश्वासस्य योगिनः।\nमयि धारयतश्चेत उपतिष्ठन्ति सिद्धयः॥ ११/१५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.002.m4a", "display_order": 3, "topics": [{"text": "अणिमाद्यष्टादशसिद्धिवर्णनम्", "range": "१–३६"}]}, {"id": 6000316003, "chapter_id": 10316, "verse_number": null, "content_sanskrit": "उद्धव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.003.m4a", "display_order": 4}, {"id": 6000316004, "chapter_id": 10316, "verse_number": "११-१५-२", "content_sanskrit": "कया धारणया का स्वित् कथं वा सिद्धिरच्युत।\nकति वा सिद्धयो ब्रूहि योगिनां सिद्धिदो भवान्॥ ११/१५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.004.m4a", "display_order": 5}, {"id": 6000316005, "chapter_id": 10316, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.005.m4a", "display_order": 6}, {"id": 6000316006, "chapter_id": 10316, "verse_number": "११-१५-३", "content_sanskrit": "सिद्धयोऽष्टादश प्रोक्ता धारणायोगपारगैः।\nतासामष्टौ मत्प्रधाना ता एव गुणहेतवः॥ ११/१५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.006.m4a", "display_order": 7}, {"id": 6000316007, "chapter_id": 10316, "verse_number": "११-१५-४", "content_sanskrit": "अणिमा महिमा मूर्तेर्लघिमा प्राप्तिरिन्द्रियैः।\nप्राकाश्यं श्रुतदृष्टेषु शक्तिप्रेरणमीशिता॥ ११/१५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.007.m4a", "display_order": 8}, {"id": 6000316008, "chapter_id": 10316, "verse_number": "११-१५-५", "content_sanskrit": "गुणेष्वसङ्गो वशिता यत्कामस्तदवाप्स्यति।\nएता मे सिद्धयः सौम्याष्टावौत्पत्तिका मताः॥ ११/१५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.008.m4a", "display_order": 9}, {"id": 6000316009, "chapter_id": 10316, "verse_number": "११-१५-६", "content_sanskrit": "अनूर्मिमत्त्वं देहेऽस्मिन् दूरश्रवणदर्शनम्।\nमनोजवः कामरूपं परकायप्रवेशनम्॥ ११/१५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.009.m4a", "display_order": 10}, {"id": 6000316010, "chapter_id": 10316, "verse_number": "११-१५-७", "content_sanskrit": "स्वच्छन्दमृत्युर्देवानां सहक्रीडानुदर्शनम्।\nयथासङ्कल्पसंसिद्धिराज्ञाऽप्रतिहतागतिः॥ ११/१५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.010.m4a", "display_order": 11}, {"id": 6000316011, "chapter_id": 10316, "verse_number": "११-१५-८", "content_sanskrit": "त्रिकालज्ञत्वमद्वन्द्वं परचित्ताद्यभिज्ञता।\nअग्न्यर्काम्बुविषादीनां प्रतिस्तम्भोऽपराजयः॥ ११/१५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.011.m4a", "display_order": 12}, {"id": 6000316012, "chapter_id": 10316, "verse_number": "११-१५-९", "content_sanskrit": "एताश्चोद्देशतः प्रोक्ता योगधारणसिद्धयः।\nयया धारणया या स्याद् यथा वा स्यान्निबोध मे॥ ११/१५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.012.m4a", "display_order": 13}, {"id": 6000316013, "chapter_id": 10316, "verse_number": "११-१५-१०", "content_sanskrit": "भूतसूक्ष्मात्मनि मयि तन्मात्रं धारयन् मनः।\nअणिमानमवाप्नोति तन्मात्रोपासको मम॥ ११/१५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.013.m4a", "display_order": 14}, {"id": 6000316014, "chapter_id": 10316, "verse_number": "११-१५-११", "content_sanskrit": "महत्यात्मन् मयि परे यथासंस्थं मनो दधत्।\nमहिमानमवाप्नोति भूतानां च पृथक्पृथक्॥ ११/१५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.014.m4a", "display_order": 15}, {"id": 6000316015, "chapter_id": 10316, "verse_number": "११-१५-१२", "content_sanskrit": "परमाणुमये चित्तं भूतानां मयि रञ्जयन्।\nकालसूक्ष्मात्मके योगी लघिमानमवाप्नुयात्॥ ११/१५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.015.m4a", "display_order": 16}, {"id": 6000316016, "chapter_id": 10316, "verse_number": "११-१५-१३", "content_sanskrit": "धारयन् मय्यहन्तत्वे मनो वैकारिकेऽखिलम्।\nसर्वेन्द्रियाणामात्मत्वं प्राप्तिं प्राप्नोति मन्मनाः॥ ११/१५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.016.m4a", "display_order": 17}, {"id": 6000316017, "chapter_id": 10316, "verse_number": "११-१५-१४", "content_sanskrit": "महत्यात्मनि यः सूत्रे धारयन् मयि मानसम्।\nप्राकाश्यं पारमेष्ठ्यं मे विन्दतेऽव्यक्तजन्मनः॥ ११/१५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.017.m4a", "display_order": 18}, {"id": 6000316018, "chapter_id": 10316, "verse_number": "११-१५-१५", "content_sanskrit": "विष्णौ चाधीश्वरे चित्तं धारयन् कालविग्रहे।\nस ईशित्वमवाप्नोति क्षेत्रक्षेत्रज्ञचोदनम्॥ ११/१५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.018.m4a", "display_order": 19}, {"id": 6000316019, "chapter_id": 10316, "verse_number": "११-१५-१६", "content_sanskrit": "नारायणे तुरीयाख्ये भगवच्छब्दशब्दिते।\nमनो मय्यादधद्योगी मद्धर्मो वशितामियात्॥ ११/१५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.019.m4a", "display_order": 20}, {"id": 6000316020, "chapter_id": 10316, "verse_number": "११-१५-१७", "content_sanskrit": "निर्गुणे ब्रह्मणि मयि धारयन् विशदं मनः।\nपरमानन्दमाप्नोति यत्र कामोऽवसीयते॥ ११/१५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.020.m4a", "display_order": 21}, {"id": 6000316021, "chapter_id": 10316, "verse_number": "११-१५-१८", "content_sanskrit": "श्वेतद्वीपपतौ चित्तं शुद्धे धर्ममये मयि।\nधारयन् श्वेततां याति षडूर्मिरहितोऽमरः॥ ११/१५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.021.m4a", "display_order": 22}, {"id": 6000316022, "chapter_id": 10316, "verse_number": "११-१५-१९", "content_sanskrit": "मय्याकाशात्मनि प्राणे मनसा घोषमुद्वहन्।\nतत्रोपलब्धाभूतानां हंसो वाचः शृणोत्यसौ॥ ११/१५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.022.m4a", "display_order": 23}, {"id": 6000316023, "chapter_id": 10316, "verse_number": "११-१५-२०", "content_sanskrit": "चक्षुस्त्वष्टरि संयोज्य त्वष्टारमपि चक्षुषि।\nमां तत्र मनसा ध्यायन् विश्वं पश्यति सूक्ष्मदृक्॥ ११/१५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.023.m4a", "display_order": 24}, {"id": 6000316024, "chapter_id": 10316, "verse_number": "११-१५-२१", "content_sanskrit": "मनो मनसि संयोज्य देहं तदनु वायुना।\nमद्धारणानुभावेन तत्रात्मा यत्र वै मनः॥ ११/१५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.024.m4a", "display_order": 25}, {"id": 6000316025, "chapter_id": 10316, "verse_number": "११-१५-२२", "content_sanskrit": "यदा मन उपादाय यद्यद् रूपं बुभूषति।\nतत्तद् भजेन्मनोरूपं मद्योगबलमाश्रितः॥ ११/१५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.025.m4a", "display_order": 26}, {"id": 6000316026, "chapter_id": 10316, "verse_number": "११-१५-२३", "content_sanskrit": "परकायं विशन् सिद्ध आत्मानं तत्र भावयेत्।\nपिण्डं हित्वा विशेत् प्राणो वायुभूतः षडङ्घ्रिवत्॥ ११/१५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.026.m4a", "display_order": 27}, {"id": 6000316027, "chapter_id": 10316, "verse_number": "११-१५-२४", "content_sanskrit": "पार्ष्ण्याऽऽपीड्य गुदं प्राणं हृदुरःकण्ठमूर्धसु।\nआरोप्य ब्रह्मरन्ध्रेण ब्रह्म नीत्वोत्सृजेत् तनुम्॥ ११/१५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.027.m4a", "display_order": 28}, {"id": 6000316028, "chapter_id": 10316, "verse_number": "११-१५-२५", "content_sanskrit": "विहरिष्यन् सुराक्रीडे मत्स्थं सत्त्वं विभावयेत्।\nविमानेनोपतिष्ठन्ति सत्त्ववृत्तिं सुरस्‍त्रियः॥ ११/१५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.028.m4a", "display_order": 29}, {"id": 6000316029, "chapter_id": 10316, "verse_number": "११-१५-२६", "content_sanskrit": "यथा सङ्कल्पयेद् बुद्ध्या यथा वा मत्परः पुमान्।\nमयि सत्ये मनो युञ्जन् तथा तत् समुपाश्नुते॥ ११/१५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.029.m4a", "display_order": 30}, {"id": 6000316030, "chapter_id": 10316, "verse_number": "११-१५-२७", "content_sanskrit": "यो वै मद्भावमापन्न ईशितुर्वशितुः पुमान्।\nन कुतश्चन हन्येत तस्य चाऽज्ञा यथा मम॥ ११/१५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.030.m4a", "display_order": 31}, {"id": 6000316031, "chapter_id": 10316, "verse_number": "११-१५-२८", "content_sanskrit": "मद्भक्त्या शुद्धसत्त्वस्य योगिनो धारणाविदः।\nतस्य त्रैकालिकी बुद्धिर्जन्ममृत्यूपबृंहिता॥ ११/१५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.031.m4a", "display_order": 32}, {"id": 6000316032, "chapter_id": 10316, "verse_number": "११-१५-२९", "content_sanskrit": "अग्न्यादिभिर्न हन्येत मुनेर्योगमयं वपुः।\nमद्योगश्रान्तचित्तस्य यादसामुदकैर्यथा॥ ११/१५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.032.m4a", "display_order": 33}, {"id": 6000316033, "chapter_id": 10316, "verse_number": "११-१५-३०", "content_sanskrit": "मद्विभूतीरभिध्यायन् श्रीवत्सास्‍त्रविभूषिताः।\nध्वजातपत्रव्यजनैः स भवेदपराजितः॥ ११/१५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.033.m4a", "display_order": 34}, {"id": 6000316034, "chapter_id": 10316, "verse_number": "११-१५-३१", "content_sanskrit": "उपासकस्य मामेवं योगधारणया पुनः।\nसिद्धयः पूर्वकथिता उपतिष्ठन्त्यशेषतः॥ ११/१५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.034.m4a", "display_order": 35}, {"id": 6000316035, "chapter_id": 10316, "verse_number": "११-१५-३२", "content_sanskrit": "जितेन्द्रियस्य दान्तस्य जितश्वासात्मनो मुनेः।\nमद्धारणां धारयतः का नु सिद्धिः सुदुर्लभा॥ ११/१५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.035.m4a", "display_order": 36}, {"id": 6000316036, "chapter_id": 10316, "verse_number": "११-१५-३३", "content_sanskrit": "अन्तरायान् वदन्त्येतान् युञ्जतो योगमुत्तमम्।\nमया सम्पद्यमानस्य कालक्षपणहेतवः॥ ११/१५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.036.m4a", "display_order": 37}, {"id": 6000316037, "chapter_id": 10316, "verse_number": "११-१५-३४", "content_sanskrit": "जन्मौषधितपोमन्त्रैर्यावतीरिह सिद्धयः।\nयोगेनाप्नोति ताः सर्वा यैर्यैर्योगगतिं व्रजेत्॥ ११/१५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.037.m4a", "display_order": 38}, {"id": 6000316038, "chapter_id": 10316, "verse_number": "११-१५-३५", "content_sanskrit": "सर्वासामपि सिद्धीनां हेतुः पतिरहं प्रभुः।\nअहं योगस्य साङ्ख्यस्य धर्मस्य ब्रह्मवादिनाम्॥ ११/१५/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.038.m4a", "display_order": 39}, {"id": 6000316039, "chapter_id": 10316, "verse_number": "११-१५-३६", "content_sanskrit": "अहमात्माऽन्तरो बाह्योऽनावृतः सर्वदेहिनाम्।\nयथा भूतानि भूतेषु बहिरन्तस्त्वहं तथा॥ ११/१५/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_015/BhP_11.015.039.m4a", "display_order": 40}, {"id": 6000316040, "chapter_id": 10316, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे पञ्चदशाध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]