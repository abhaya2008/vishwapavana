[{"id": 2204762, "chapter_id": 5364, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2204763, "chapter_id": 5364, "verse_number": "१", "content_sanskrit": "भगवंस्ते कथं तत्र दण्ड्यन्ते नरकेषु वै ।\nकति ते निरया घोराः कीदृशास्ते महेश्वर\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2204764, "chapter_id": 5364, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2204765, "chapter_id": 5364, "verse_number": "२", "content_sanskrit": "शृणु भामिनि तत्सर्वं पञ्चैते नरकाह्वयाः ।\nभूमेरधस्ताद् विहिता घोरा दुष्कृतकर्मणाम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2204766, "chapter_id": 5364, "verse_number": "३", "content_sanskrit": "प्रथमं रौरवं नाम शतयोजनमायतम् ।\nतावत्प्रमाणं विस्तीर्णं तामसं पापपीडितम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2204767, "chapter_id": 5364, "verse_number": "४", "content_sanskrit": "भृशं दुर्गन्धि परुषं कृमिभिर्दारुणैर्युतम् ।\nअतिघोरमनिर्देश्यं प्रतिकूलं ततस्ततः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2204768, "chapter_id": 5364, "verse_number": "५", "content_sanskrit": "ते चिरं तत्र तिष्ठन्ति न तत्र शयनासने ।\nकृमिभिर्भक्ष्यमाणाश्च विस्रगन्धसमायुताः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2204769, "chapter_id": 5364, "verse_number": "६", "content_sanskrit": "एवंप्रमाणमुद्विग्ना यान्ति तिष्ठन्ति तत्र ते ।\nयातनाभ्यो दशगुणं नरके दुःखमिष्यते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2204770, "chapter_id": 5364, "verse_number": "७", "content_sanskrit": "तत्र चात्यन्तिकं दुःखमिति विद्धि शुभेक्षणे ।\nक्रोशन्तश्च रुदन्तश्च वेदनास्तत्र भुञ्जते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2204771, "chapter_id": 5364, "verse_number": "८", "content_sanskrit": "भ्रमन्ति दुःखमोक्षार्थं त्राता कश्चिन्न विद्यते ।\nदुःखस्यान्तरमात्रं तु द्वारं वा न च लभ्यते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2204772, "chapter_id": 5364, "verse_number": "९", "content_sanskrit": "महारौरवसञ्ज्ञं तु द्वितीयं नरकं प्रिये ।\nतस्माद् द्विगुणितं विद्धि माने दुःखे च रौरवात्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2204773, "chapter_id": 5364, "verse_number": "१०", "content_sanskrit": "तृतीयं नरकं तत्र कण्टकावनसञ्ज्ञितम् ।\nततो द्विगुणितं तच्च पूर्वाभ्यां दुःखमानयोः ।\nमहापातकसंयुक्ता घोरास्तस्मिन् विशन्ति हि\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2204774, "chapter_id": 5364, "verse_number": "११", "content_sanskrit": "अग्निकुण्डमिति ख्यातं चतुर्थं नरकं प्रिये ।\nएतद् द्विगुणितं तस्माद् यथानिष्टसुखं तथा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2204775, "chapter_id": 5364, "verse_number": "१२", "content_sanskrit": "तत्र दुःखं हि सुमहदमानुषमिति स्मृतम् ।\nभुञ्जते तत्रतत्रैव दुःखं दुष्कृतकारिणः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2204776, "chapter_id": 5364, "verse_number": "१३", "content_sanskrit": "पञ्चकष्टमिति ख्यातं पञ्चमं नरकं प्रिये ।\nतत्र दुःखमनिर्देश्यं महाघोरं यथातथम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2204777, "chapter_id": 5364, "verse_number": "१४", "content_sanskrit": "पञ्चेन्द्रियैरसह्यत्वात् पञ्चकष्टमिति स्मृतम् ।\nभुञ्जते तत्रतत्रैव दुःखं दुष्कृतकारिणः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2204778, "chapter_id": 5364, "verse_number": "१५", "content_sanskrit": "अमानुषार्हं तद् दुःखं महाभूतैस्तु भुञ्जते ।\nअतिघोरं चिरं कृत्वा महाभूतानि यान्ति तम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2204779, "chapter_id": 5364, "verse_number": "१६", "content_sanskrit": "पञ्चकष्टेन हि समं नास्ति दुःखं तथाविधम् ।\nदुःखस्यान्तमिति प्राहुः पञ्चकष्टं सदा प्रिये\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2204780, "chapter_id": 5364, "verse_number": "१७", "content_sanskrit": "एवं ते तेषु तिष्ठन्ति प्राणिनो दुःखभोगिनः ।\nअन्ये च नरकाः सन्ति अवीचिप्रमुखाः प्रिये\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2204781, "chapter_id": 5364, "verse_number": "१८", "content_sanskrit": "क्रोशन्तश्च रुदन्तश्च वेदनार्ता भृशातुराः ।\nकेचिद् भ्रमन्ति वेष्टन्ते केचिद् धावन्ति चातुराः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2204782, "chapter_id": 5364, "verse_number": "१९", "content_sanskrit": "आधावन्तो निवार्यन्ते शूलहस्तैर्यतस्ततः ।\nरुजार्दितास्तृषायुक्ताः प्राणिनः पापकारिणः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2204783, "chapter_id": 5364, "verse_number": "२०", "content_sanskrit": "क्रोशन्तश्च नदन्तश्च न मुच्यन्ते कथञ्चन ।\nक्रिमिभिर्भक्ष्यमाणाश्च वेदनार्तास्तृषान्विताः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2204784, "chapter_id": 5364, "verse_number": "२१", "content_sanskrit": "संस्मरन्तः स्वकं पापं कृतमात्मापराधजम् ।\nशोचन्तस्तत्र तिष्ठन्ति यावत् पापक्षयं प्रिये ।\nएवं भुक्त्वा तु नरकं मुच्यन्ते पापसङ्क्षयात्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2204785, "chapter_id": 5364, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2204786, "chapter_id": 5364, "verse_number": "२२", "content_sanskrit": "भगवन् कतिकालं ते तिष्ठन्ति नरकेषु वै ।\nएतद् वेदितुमिच्छामि तन्मे ब्रूहि महेश्वर\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2204787, "chapter_id": 5364, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2204788, "chapter_id": 5364, "verse_number": "२३", "content_sanskrit": "शतं सहस्रं वर्षाणामादिं कृत्वा हि जन्तवः ।\nतिष्ठन्ति नरकावासाः प्रळयान्तमिति स्थितिः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2204789, "chapter_id": 5364, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2204790, "chapter_id": 5364, "verse_number": "२४", "content_sanskrit": "भगवंस्तेषु के कुत्र तिष्ठन्तीति वद प्रभो\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2204791, "chapter_id": 5364, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2204792, "chapter_id": 5364, "verse_number": "२५", "content_sanskrit": "रौरवे शतसाहस्रं वर्षाणामिति संस्थितिः ।\nमानुषघ्नाः कृतघ्नाश्च तथैवानृतवादिनः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2204793, "chapter_id": 5364, "verse_number": "२६", "content_sanskrit": "जारचोराश्च नारी च सर्वतश्चापचारिणी ।\nउत्कोचकाश्च पिशुना वर्णसम्भेदकारकाः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2204794, "chapter_id": 5364, "verse_number": "२७", "content_sanskrit": "तादृशाः परिपच्यन्ते रौरवे नरके नराः ।\nदेशघ्नाश्चैव राजघ्नाः पितृमातृविघातिनः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2204795, "chapter_id": 5364, "verse_number": "२८", "content_sanskrit": "राजा चान्यायतः शास्ता साक्षित्वेऽनृतवादिनः ।\nबहुघ्नाश्च कुलघ्नाश्च भ्रूणघ्ना गुरुघातिनः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2204796, "chapter_id": 5364, "verse_number": "२९", "content_sanskrit": "विश्वस्तघातकाश्चैवमात्मघ्नाः कोपकारणात् ।\nपतिघ्न्यः प्रमदा मोहाद् यज्ञविघ्नकराश्च ये\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2204797, "chapter_id": 5364, "verse_number": "३०", "content_sanskrit": "द्वितीये द्विगुणं कालं पच्यन्ते तादृशा नराः ।\nमहापातकयुक्तास्तु तृतीये दुःखमाप्नुयुः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2204798, "chapter_id": 5364, "verse_number": "३१", "content_sanskrit": "एतावन्मानुषसहं परमन्येषु लक्ष्यते\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2204799, "chapter_id": 5364, "verse_number": "३२", "content_sanskrit": "यक्षा विद्याधराश्चैव काद्रवेयाश्च किन्नराः ।\nगन्धर्वा भूतसङ्घाश्च तेषां पापयुता भृशम् ।\nचतुर्थे परिपच्यन्ते यावद् युगविपर्ययः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2204800, "chapter_id": 5364, "verse_number": "३३", "content_sanskrit": "सहन्तस्तादृशं घोरं पञ्चकष्टे च यादृशम् ।\nतादृग्विधस्य दुःखस्य अयोग्यान् विद्धि मानुषान्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2204801, "chapter_id": 5364, "verse_number": "३४", "content_sanskrit": "एवं ते नरकान् भुक्त्वा तत्र क्षपितकल्मषाः ।\nनरकेभ्यो विमुक्ताश्च जायन्ते कृमिजातिषु\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2204802, "chapter_id": 5364, "verse_number": "३५", "content_sanskrit": "उद्भेदजेषु वा केचित् तत्रापि क्षीणकल्मषाः ।\nपुनरेव प्रजायन्ते मृगपक्षिषु शोभने ।\nमृगपक्षिषु तद्भुक्त्वा लभन्ते मानुषं पदम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2204803, "chapter_id": 5364, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2204804, "chapter_id": 5364, "verse_number": "३६", "content_sanskrit": "नानाजातिषु केनैव जायन्ते पापकारिणः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2204805, "chapter_id": 5364, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2204806, "chapter_id": 5364, "verse_number": "३७", "content_sanskrit": "तदहं ते प्रवक्ष्यामि यत्त्वमिच्छसि शोभने ।\nसर्वथाऽऽत्मा कर्मवशान्नानाजातिषु दृश्यते\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2204807, "chapter_id": 5364, "verse_number": "३८", "content_sanskrit": "यश्च मांसप्रियो नित्यं काकगृध्नान् स संस्पृशेत् ।\nसुरापः सततं मर्त्यः सूकरत्वं व्रजेद् ध्रुवम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2204808, "chapter_id": 5364, "verse_number": "३९", "content_sanskrit": "अभक्ष्यभक्षणो मर्त्यः काकजातिषु संस्पृशेत् ।\nपरोद्वेगकरो नित्यं व्यालजातिषु जायते ।\nआत्मघ्नो यो नरः कोपात् प्रेतजातिसु तिष्ठति\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2204809, "chapter_id": 5364, "verse_number": "४०", "content_sanskrit": "पैशुन्यात् परिवादाच्च कुक्कुटत्वं समश्नुयात् ।\nनास्तिकश्चैव यो मूर्खो मृगजातिं स गच्छति\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2204810, "chapter_id": 5364, "verse_number": "४१", "content_sanskrit": "हिंसाविहारस्तु नरः कृमिकीटेषु जायते ।\nअत्र मानयुतो नित्यं प्रेत्य गर्दभतां व्रजेत्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2204811, "chapter_id": 5364, "verse_number": "४२", "content_sanskrit": "असत्यं परुषं वाक्यं यो वदेद् मत्स्यतां व्रजेत् ।\nअगम्यागमनाच्चैव परदाराभिमर्शनात् ।\nमूषिकत्वं व्रजेन्मर्त्यो नास्ति तत्र विचारणा\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2204812, "chapter_id": 5364, "verse_number": "४३", "content_sanskrit": "कृतघ्नो मित्रघाती च सृगालवृकजातिषु ।\nगुरुघ्नः मित्रघाती च स्थावरेष्ववतिष्ठति\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2204813, "chapter_id": 5364, "verse_number": "४४", "content_sanskrit": "वाचिकैः पक्षिमृगतां मानसैरन्यजातिताम् ।\nशरीरजैः कर्मदोषैर्याति स्थावरतां नरः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2204814, "chapter_id": 5364, "verse_number": "४५", "content_sanskrit": "एवमाद्यशुभं कृत्वा नरा निरयमाश्रिताः ।\nतांस्तान्भावान् प्रपद्यन्ते स्वकृतस्यैव कारणात्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2204815, "chapter_id": 5364, "verse_number": "४६", "content_sanskrit": "एवं जातिषु निर्दग्धाः प्राणिनः पापकारिणः ।\nकथञ्चित् पुनरुत्पद्य लभन्ते मानुषं पदम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2204816, "chapter_id": 5364, "verse_number": "४७", "content_sanskrit": "बहुकृत्वोऽति(ग्नि)सन्तप्तं लोहं शुचितमं तथा ।\nबहुदुःखाभिसन्तप्तस्तथाऽऽत्मा शुद्ध्यते मलात् ।\nतस्मात् सुदुर्लभं चेति विद्धि जन्म सुमानुषम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2204817, "chapter_id": 5364, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nअनुशासनपर्वणि दानधर्मे पञ्चनरकवर्णनं नानायोनिप्रवेशकथनं नाम पञ्चदशोत्तरशततमोऽध्यायः ॥११५॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]