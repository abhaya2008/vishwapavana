[{"id": 7000649000, "chapter_id": 20649, "verse_number": "५-१०८-१", "content_sanskrit": "श्रीराम उवाच ।\nभस्मोत्पत्तिं महाभाग भस्ममाहात्म्यमेव च ।\nभस्मसंधारणे पुण्यं भस्मदाने च तद्वद ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000649001, "chapter_id": 20649, "verse_number": "५-१०८-२", "content_sanskrit": "शंभुरुवाच ।\nभस्मोत्पत्तिं प्रवक्ष्यामि सर्वपापप्रणाशिनीम् ।\nस्मरणात्कीर्तनाद्राम तां शृणुष्व नराधिप ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000649002, "chapter_id": 20649, "verse_number": "५-१०८-३", "content_sanskrit": "य एकः शाश्वतो देवो ब्रह्मवंद्यः सदाशिवः ।\nत्रिलोचनो गुणाधारो गुणातीतोऽक्षरोव्ययः ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000649003, "chapter_id": 20649, "verse_number": "५-१०८-४", "content_sanskrit": "सिसृक्षा तस्य जाताथ वीक्ष्यात्मस्थं गुणत्रयम् ।\nवेदत्रयमिदं ज्ञेयं गुणत्रयमिदं हि यत् ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000649004, "chapter_id": 20649, "verse_number": "५-१०८-५", "content_sanskrit": "पृथक्कृत्वात्मनस्तात तत्रस्थानं विभज्य च ।\nदक्षिणांगेसृजत्पुत्रं ब्रह्माणं वामतो हरिम् ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000649005, "chapter_id": 20649, "verse_number": "५-१०८-६", "content_sanskrit": "पृष्ठदेशे महेशानं त्रीन्पुत्रानसृजद्विभुः ।\nजातमात्रास्त्रयो देवा ब्रह्मविष्णुमहेश्वराः ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000649006, "chapter_id": 20649, "verse_number": "५-१०८-७", "content_sanskrit": "इदमूचुर्वचः स्पष्टं को भवान्के वयंत्विति ।\nतानाह च शिवः पुत्रान्यूयं पुत्रा अहं पिता ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000649007, "chapter_id": 20649, "verse_number": "५-१०८-८", "content_sanskrit": "इदं गुणत्रयं पुत्रा भजध्वं कर्महेतुकम् ।\nपुत्रा ऊचुः ।\nकं वा गुणं को भजतां कियंतं कालमीश्वर ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000649008, "chapter_id": 20649, "verse_number": "५-१०८-९", "content_sanskrit": "कथं गुणनिवृत्तिश्च भवेदेतद्वदस्व नः ।\nशिव उवाच ।\nयावज्ज्ञानं हि भवतां यावदायुरथापि वा ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000649009, "chapter_id": 20649, "verse_number": "५-१०८-१०", "content_sanskrit": "धारणं तावदेवस्यादेकैकस्य गुणस्य च ।\nसत्वं ब्रह्मा रजोविष्णुर्भजेन्महेश्वरस्तमः ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000649010, "chapter_id": 20649, "verse_number": "५-१०८-११", "content_sanskrit": "इत्युक्तमात्रे देवेशे ब्रह्मा सत्वमथाग्रहीत् ।\nन च चालयितुं शक्तो धारणे किमु शक्तिमान् ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000649011, "chapter_id": 20649, "verse_number": "५-१०८-१२", "content_sanskrit": "तं गुणं तु तिरस्कृत्य रजोगुणमथाग्रहीत् ।\nन च चालयितुं शक्तो जग्राहाथ तमोगुणम् ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000649012, "chapter_id": 20649, "verse_number": "५-१०८-१३", "content_sanskrit": "न च चालयितुं शक्तो निपपात रुरोद च ।\nविष्णुश्च वामहस्तेन रजोगुणमधारयत् ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000649013, "chapter_id": 20649, "verse_number": "५-१०८-१४", "content_sanskrit": "अंगुलीभ्यां महेशोऽपि तमोगुणमधारयत् ।\nसत्वमेकोंगुलीभ्यां च सत्वं विष्णुमथादधात् ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000649014, "chapter_id": 20649, "verse_number": "५-१०८-१५", "content_sanskrit": "ब्रह्माणं पादपीठे च दधार च ननर्त च ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000649015, "chapter_id": 20649, "verse_number": "५-१०८-१६", "content_sanskrit": "नृत्यंतमत्यंतविलासरूपं गोक्षीररूपं तरुणं त्रिनेत्रम् ।\nसर्वं दधानं कृतकौतुकं शिवं समीक्ष्य पुत्रान्वरदो बभाषे ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000649016, "chapter_id": 20649, "verse_number": "५-१०८-१७", "content_sanskrit": "शिव उवाच ।\nप्रीतोऽस्मि तव पुत्राहं वरं वृणु यथेप्सितम् ।\nअथाह पितरं पुत्रो वरमेनं ददस्व मे ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000649017, "chapter_id": 20649, "verse_number": "५-१०८-१८", "content_sanskrit": "मामुद्दिश्य कृता पूजा तव पूजा भवेच्छिव ।\nतिष्ठेर्मयि सदा त्वं च त्वमेवाहं च वाव्ययः ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000649018, "chapter_id": 20649, "verse_number": "५-१०८-१९", "content_sanskrit": "शिव उवाच ।\nएवमेतन्महाभाग भविष्यति न संशयः ।\nरक्तगौराविमौ पुत्रौ ब्रह्मविष्णू ममैव तु ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000649019, "chapter_id": 20649, "verse_number": "५-१०८-२०", "content_sanskrit": "बाहुमूलस्थरोमौ च ममाकारौ तथानघौ ।\nअथ ब्रह्माणमाहेदं भजत्वेकं गुणं भवान् ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000649020, "chapter_id": 20649, "verse_number": "५-१०८-२१", "content_sanskrit": "ब्रह्मोवाच ।\nत्वन्निर्दिष्टं गुणमहं धर्तुं शक्तो न हीश्वर ।\nधारयिष्ये रजो देव सत्वं भजतु वै हरिः ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000649021, "chapter_id": 20649, "verse_number": "५-१०८-२२", "content_sanskrit": "अवशिष्टं गुणं चायमीश्वरो धारयिष्यति ।\nशंभुरुवाच ।\nगुणानादायते देवा नशेकुर्नित्यधारणम् ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000649022, "chapter_id": 20649, "verse_number": "५-१०८-२३", "content_sanskrit": "कर्तुं भरणशक्त्यर्थं शिवमित्यवदत्पुनः ।\nगुणान्वयं सर्वकालं न च धारयितुं क्षमाः ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000649023, "chapter_id": 20649, "verse_number": "५-१०८-२४", "content_sanskrit": "दीयतां भगवञ्छक्तिर्यदि भोस्त्वं वरप्रदः ।\nअथ तद्वचनं श्रुत्वा शिवो वाक्यमभाषत ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000649024, "chapter_id": 20649, "verse_number": "५-१०८-२५", "content_sanskrit": "शिव उवाच ।\nविद्याशक्तिः समस्तानां शक्तिरित्यभिधीयते ।\nगुणत्रयाश्रया विद्या अविद्या च तदाश्रया ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000649025, "chapter_id": 20649, "verse_number": "५-१०८-२६", "content_sanskrit": "गुणत्रयं च दग्ध्वैव तत्सारं धर्तुमर्हथ ।\nयच्च किंचिद्भवेत्तत्र भवद्भिर्ध्रियतां हि तत् ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000649026, "chapter_id": 20649, "verse_number": "५-१०८-२७", "content_sanskrit": "अथाहुस्तत्सुता वाक्यं न दाहो ज्वलनं विना ।\nशिवः प्राह महेशस्य लोचने वह्निरस्ति वै ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000649027, "chapter_id": 20649, "verse_number": "५-१०८-२८", "content_sanskrit": "गुणत्रयमिदं धेनुर्विद्या स्याद्गोमयं शुभम् ।\nमूत्रं चोपनिषत्प्रोक्तं कुर्याद्भस्म ततः परम् ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000649028, "chapter_id": 20649, "verse_number": "५-१०८-२९", "content_sanskrit": "वत्सास्तु स्मृतयो यस्यास्तत्संभूतं तु गोमयम् ।\nआगाव इति मंत्रेण धेनुं तत्राभिमंत्रयेत् ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000649029, "chapter_id": 20649, "verse_number": "५-१०८-३०", "content_sanskrit": "गावो गावो गाव इति प्राशयेत्तु तृणं जलम् ।\nउपोष्य च चतुर्द्दश्यां शुक्ले कृष्णेऽथवा व्रती ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000649030, "chapter_id": 20649, "verse_number": "५-१०८-३१", "content_sanskrit": "परेद्युः प्रातरुत्थाय शुचिर्भूत्वा समाहितः ।\nकृतस्नानो धौतवस्त्रो गोमयार्थं व्रजेत्तु गाम् ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000649031, "chapter_id": 20649, "verse_number": "५-१०८-३२", "content_sanskrit": "उत्थाप्य तां प्रयत्नेन गायत्र्या मूत्रमाहरेत् ।\nसौवर्णे राजते ताम्रे धारयेन्मृन्मये घटे ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000649032, "chapter_id": 20649, "verse_number": "५-१०८-३३", "content_sanskrit": "पौष्करे वा पलाशे वा पात्रे गोशृंग एव वा ।\nआदधीत हि गोमूत्रं गंधद्वारेति गोमयम् ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000649033, "chapter_id": 20649, "verse_number": "५-१०८-३४", "content_sanskrit": "अभूमिपातं गृह्णीयात्पात्रे पूर्वोदितेऽधिके ।\nगोमयं शोधयेद्विद्वाञ्छ्रीर्मे भजतु मंत्रतः ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000649034, "chapter_id": 20649, "verse_number": "५-१०८-३५", "content_sanskrit": "अलक्ष्मीर्मयीति मंत्रेण गोमयस्यापमार्जनम् ।\nसं त्वा सिंचामि मंत्रेण गोमूत्रं गोमये क्षिपेत् ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000649035, "chapter_id": 20649, "verse_number": "५-१०८-३६", "content_sanskrit": "पंचानां त्वेति मंत्रेण पिंडांश्चैव चतुर्द्दश ।\nकुर्यात्संशोष्य किरणैस्तरणेराहरेत्तु तान् ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000649036, "chapter_id": 20649, "verse_number": "५-१०८-३७", "content_sanskrit": "निदध्यादथ पूर्वोक्तपात्रे गोमयपिंडकान् ।\nस्वगृह्योक्तविधानेन प्रतिष्ठाप्याग्निमिंधयेत् ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000649037, "chapter_id": 20649, "verse_number": "५-१०८-३८", "content_sanskrit": "पिंडान्विनिक्षिपेत्तत्तदर्णदेवाय पिंडकान् ।\nआघारावाज्यभागौ च प्रक्षिप्य द्वौ हुनेत्सुधीः ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000649038, "chapter_id": 20649, "verse_number": "५-१०८-३९", "content_sanskrit": "ततो निधनपतये त्रयोदशजयादयः ।\nहोतव्याः पंचब्रह्माणि नमो हिरण्यबाहवे ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000649039, "chapter_id": 20649, "verse_number": "५-१०८-४०", "content_sanskrit": "इति सर्वाहुतीर्हुत्वा चतुर्थ्यंतैस्तु मंत्रकैः ।\nततः शर्वाय रुद्राय यस्य वैकंकतीति च ॥४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000649040, "chapter_id": 20649, "verse_number": "५-१०८-४१", "content_sanskrit": "एतैस्तु जुहुयाद्विद्वाननाज्ञातत्रयं तथा ।\nव्याहृतीरथ हुत्वा तु ततः स्विष्टकृतं हुनेत् ॥४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000649041, "chapter_id": 20649, "verse_number": "५-१०८-४२", "content_sanskrit": "इध्मशेषं तु निर्वर्त्य पूर्णपात्रोदकं ततः ।\nपूर्णमासांतयजुषा जलेनान्येन बृंहयेत् ॥४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000649042, "chapter_id": 20649, "verse_number": "५-१०८-४३", "content_sanskrit": "ब्राह्मणेष्वमृतमिति तज्जलं शिरसि क्षिपेत् ।\nप्राच्यामिति दिशां लिंगैर्दिक्षु तोयं विनिक्षिपेत् ॥४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000649043, "chapter_id": 20649, "verse_number": "५-१०८-४४", "content_sanskrit": "ब्रह्मणे दक्षिणां दत्वा शांते पुलकमाहरेत् ।\nआहरिष्यामि देवानां सर्वेषां कर्मगुप्तये ॥४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000649044, "chapter_id": 20649, "verse_number": "५-१०८-४५", "content_sanskrit": "जातवेदसमेने त्वां पुलाकं च्छादयाद्य मे ।\nमंत्रेणानेन तं वह्निं पुलाके छादयेदथ ॥४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000649045, "chapter_id": 20649, "verse_number": "५-१०८-४६", "content_sanskrit": "त्रिदिनं ज्वलनस्थित्यै छादनं पुलकैः स्मृतम् ।\nब्राह्मणान्भोजयेद्भक्त्या स्वयं भुंजीत वाग्यतः ॥४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000649046, "chapter_id": 20649, "verse_number": "५-१०८-४७", "content_sanskrit": "भस्माधिकमभीप्संस्तु ह्यधिकं गोमयं हरेत् ।\nदिनत्रयेण यदि वा एकस्मिन्दिवसे बहु ॥४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000649047, "chapter_id": 20649, "verse_number": "५-१०८-४८", "content_sanskrit": "तृतीये वा चतुर्थे वा प्रातःस्नात्वा सितांबरः ।\nशुक्लयज्ञोपवीती च शुक्लमाल्यानुलेपनः ॥४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000649048, "chapter_id": 20649, "verse_number": "५-१०८-४९", "content_sanskrit": "शुक्लदंतो भस्मदिग्धो मंत्रेणानेन मंत्रवित् ।\nतद्वेति चोच्चारयित्वा भस्मसत्यं न संत्यजेत् ॥४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000649049, "chapter_id": 20649, "verse_number": "५-१०८-५०", "content_sanskrit": "तत आवाहनमुखा उपचारास्तु षोडश ।\nकर्तव्या हुतदानेन ततोऽग्निमुपसंहरेत् ॥५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000649050, "chapter_id": 20649, "verse_number": "५-१०८-५१", "content_sanskrit": "अग्ने भस्मेति मंत्रेण गृह्णीयाद्भस्म चोद्भवम् ।\nअग्निरस्मीति मंत्रेण प्रमृज्य च ततः परम् ॥५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000649051, "chapter_id": 20649, "verse_number": "५-१०८-५२", "content_sanskrit": "संयोज्य गंगासलिलैः कपिलापयसाथवा ।\nचंद्रं कुंकुमकाश्मीरमुशीरं चंदनं तथा ॥५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000649052, "chapter_id": 20649, "verse_number": "५-१०८-५३", "content_sanskrit": "अगुरुद्वितयं चैव चूर्णयित्वा तु सूक्ष्मतः ।\nक्षिपेद्भस्मनि तच्चूर्णमोमिति ब्रह्ममंत्रतः ॥५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000649053, "chapter_id": 20649, "verse_number": "५-१०८-५४", "content_sanskrit": "ततः पयः सेचने च गदितः कपिला मनुः ।\nअमृतं देवि ते क्षीरं पवित्रमिह वर्द्धितम् ॥५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000649054, "chapter_id": 20649, "verse_number": "५-१०८-५५", "content_sanskrit": "तवप्रसादान्मुच्यंते मनुजाः सर्वपाप्मनः ।\nप्रणवेनावहेद्विद्वान्भस्मनो वटकानथ ॥५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000649055, "chapter_id": 20649, "verse_number": "५-१०८-५६", "content_sanskrit": "अणोरणीयानिति हि मंत्रेण तु विचक्षणम् ।\nशंभुरुवाच ।\nइत्थं तु भस्मसंपाद्य शुष्कमादाय मंत्रवित् ॥५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000649056, "chapter_id": 20649, "verse_number": "५-१०८-५७", "content_sanskrit": "प्रणवेन विमृज्याथ सप्तप्रणवमंत्रितम् ।\nईशानेन शिरोदेशं मुखं तत्पुरुषेण च ॥५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000649057, "chapter_id": 20649, "verse_number": "५-१०८-५८", "content_sanskrit": "उरोदेशमघोरेण गुह्यं वामेन मंत्रयेत् ।\nसद्योजातेन वै पादौ सर्वांगं प्रणवेन तु ॥५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000649058, "chapter_id": 20649, "verse_number": "५-१०८-५९", "content_sanskrit": "तत उद्धूल्य सर्वांगमापादतलमस्तकम् ।\nतत आचम्य वसनं धौतं श्वेतं प्रधारयेत् ॥५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000649059, "chapter_id": 20649, "verse_number": "५-१०८-६०", "content_sanskrit": "पुनराचम्य कर्म स्वं कर्तुमर्हति सर्वतः ।\nततो भस्मसमादाय प्रमृज्य प्रणवेन तु ॥६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000649060, "chapter_id": 20649, "verse_number": "५-१०८-६१", "content_sanskrit": "त्रिनेत्रं त्रिगुणाधारं त्रयाणां जनकं विभुम् ।\nस्मरन्नमः शिवायेति ललाटे तु त्रिपुंड्रकम् ॥६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000649061, "chapter_id": 20649, "verse_number": "५-१०८-६२", "content_sanskrit": "नमः शिवाभ्यामित्युक्त्वा बाह्वोर्वापि त्रिपुंड्रकम् ।\nअघोराय नम इति उभाभ्यां च प्रकोष्ठयोः ॥६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000649062, "chapter_id": 20649, "verse_number": "५-१०८-६३", "content_sanskrit": "भीमायेति ततः पृष्ठे शिरोधि पश्चिमे तथा ।\nनीलकंठाय शिरसि क्षिपेत्सर्वात्मने नमः ॥६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000649063, "chapter_id": 20649, "verse_number": "५-१०८-६४", "content_sanskrit": "प्रक्षाल्याथ ततो हस्तौ कर्मानुष्ठानमाचरेत् ।\nशिव उवाच ।\nयूयमेवं प्रकारेण भस्म कृत्वा प्रघृष्य च ॥६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000649064, "chapter_id": 20649, "verse_number": "५-१०८-६५", "content_sanskrit": "गुणान्धारयितुं शक्तास्ततः स्रक्ष्यथ वै प्रजाः ।\nशंभुरुवाच ।\nइत्थं शिवोदिता देवा ब्रह्मविष्णुमहेश्वराः ॥६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000649065, "chapter_id": 20649, "verse_number": "५-१०८-६६", "content_sanskrit": "तथा कृत्वा च विधिना हमहमिकया तदा ।\nअन्योन्यबोधनाशक्ताः प्रणम्य शिवमूचिरे ॥६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000649066, "chapter_id": 20649, "verse_number": "५-१०८-६७", "content_sanskrit": "कं गुणं धारयेत्को वा शिवः प्राह सुतानथ ।\nकर्मशक्तिं तथा ज्ञानं मुखरेण्वैव नश्यति ॥६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000649067, "chapter_id": 20649, "verse_number": "५-१०८-६८", "content_sanskrit": "अल्पायुर्दृश्यते ब्रह्मा मनुभिश्चास्य जीवितम् ।\nयोऽहं ब्रह्मांडमालाभिर्भूषितो ब्रह्मगोपनम् ॥६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000649068, "chapter_id": 20649, "verse_number": "५-१०८-६९", "content_sanskrit": "रजोगुणमवष्टभ्य न च जानासि मां तदा ।\nब्रह्माधिकबलो विष्णुरायुषि ब्रह्मणोऽधिकः ॥६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000649069, "chapter_id": 20649, "verse_number": "५-१०८-७०", "content_sanskrit": "ब्रह्मांडमालाभरणे महेशस्य ममैव तु ।\nचतुर्निःश्वासमात्रेण विष्णोरायुरुदाहृतम् ॥७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000649070, "chapter_id": 20649, "verse_number": "५-१०८-७१", "content_sanskrit": "ब्रह्मणोऽधिकसत्वत्वात्सत्वमालंबतां हरिः ।\nजानाति सर्वकालं मां क्वचिदेव न विस्मरेत् ॥७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000649071, "chapter_id": 20649, "verse_number": "५-१०८-७२", "content_sanskrit": "सात्विकैकैव पूजास्य राजसी तामसी न तु ।\nशांतं शिवं सत्वगुणं रजवक्त्रावमानतः ॥७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000649072, "chapter_id": 20649, "verse_number": "५-१०८-७३", "content_sanskrit": "नभोनीलं तथा चैव गुणं शंभुस्तथाभजत् ।\nसत्वं रजस्तमश्चापि दधार च पुरा किल ॥७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000649073, "chapter_id": 20649, "verse_number": "५-१०८-७४", "content_sanskrit": "अतोऽस्य विविधा पूजा शंकरस्य विधीयते ।\nरजश्च तमसायुक्तं दारुणं परिकीर्तितम् ॥७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000649074, "chapter_id": 20649, "verse_number": "५-१०८-७५", "content_sanskrit": "दारुणापि ततः पूजा शंकरे गतिदा मता ।\nरजश्च तमसायुक्तमलं शास्त्रप्रवर्तकम् ॥७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000649075, "chapter_id": 20649, "verse_number": "५-१०८-७६", "content_sanskrit": "विच्छिन्नापि ततः पूजा शंकरे फलदा मता ।\nतमश्च सत्वसंयुक्तं मिश्रकं च प्रवर्तकम् ॥७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000649076, "chapter_id": 20649, "verse_number": "५-१०८-७७", "content_sanskrit": "मिश्रपूजा विफलदा शंकरे लोकशंकरे ।\nयादृशं तादृशं वापि नियमेनार्चनं विभोः ॥७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000649077, "chapter_id": 20649, "verse_number": "५-१०८-७८", "content_sanskrit": "शंकरस्याशुफलदं यादृशस्यापि देहिनः ।\nशंभुरुवाच ।\nएतत्संक्षेपतः प्रोक्तं विधानं भस्मनोऽनघ ॥७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000649078, "chapter_id": 20649, "verse_number": "५-१०८-७९", "content_sanskrit": "वक्तृश्रोतृजनानां च समस्ताघविनाशनम् ॥७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}]