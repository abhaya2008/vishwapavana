[{"id": 2212514, "chapter_id": 5527, "verse_number": "१", "content_sanskrit": "स राजा सुमहातेजा वृद्धः कुरुकुलोद्वहः ।\nनापश्यत तदा किञ्चिद् अप्रियं कुरुनन्दनात्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2212515, "chapter_id": 5527, "verse_number": "२", "content_sanskrit": "वर्तमानेषु सद्वृत्तिं पाण्डवेषु महात्मसु ।\nप्रीतिमानभवद् राजा धृतराष्ट्रोऽम्बिकासुतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2212516, "chapter_id": 5527, "verse_number": "३", "content_sanskrit": "सौबलेयी च गान्धारी पुत्रशोकमपास्य तम् ।\nसदैव प्रीतिमत्यासीत् पाण्डवेषु निजेष्विव\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2212517, "chapter_id": 5527, "verse_number": "४", "content_sanskrit": "प्रियाण्येव तु कौरव्यो नाप्रियाणि कुरूद्वहः ।\nवैचित्रवीर्ये नृपतौ समाचरत सर्वदा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2212518, "chapter_id": 5527, "verse_number": "५", "content_sanskrit": "यद्यद् ब्रूते च किञ्चित् स धृतराष्ट्रो नराधिपः ।\nगुरु वा लघु वा कार्यं गान्धारी वा यशस्विनी\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2212519, "chapter_id": 5527, "verse_number": "६", "content_sanskrit": "तत् स राजा नरव्याघ्रः पाण्डवानां धुरन्धरः ।\nपूजयित्वा वचस्तत्तद् अकार्षीत् परवीरहा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2212520, "chapter_id": 5527, "verse_number": "७", "content_sanskrit": "तेन तस्याभवत् प्रीतो वृत्तेन स नराधिपः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2212521, "chapter_id": 5527, "verse_number": "८", "content_sanskrit": "अन्वतप्यत संस्मृत्य पुत्रं मन्दमचेतसम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2212522, "chapter_id": 5527, "verse_number": "९", "content_sanskrit": "सदा च प्रातरुत्थाय कृतजप्यः शुचिर्नृपः ।\nआशास्ते पाण्डुपुत्राणां समरेष्वपराजयम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2212523, "chapter_id": 5527, "verse_number": "१०", "content_sanskrit": "ब्राह्मणान् याचयित्वा च हुत्वा चैव हुताशनम् ।\nआयूंषि पाण्डुपुत्राणामनुशास्ते स कौरवः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2212524, "chapter_id": 5527, "verse_number": "", "content_sanskrit": "स तां प्रीतिं परामाप स्वप्नेभ्यः स महीपतिः ।\n(यां प्रीतिं पाण्डुपुत्रेभ्यः समवाप महीपतिः\t॥११॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2212525, "chapter_id": 5527, "verse_number": "१२", "content_sanskrit": "ब्राह्मणानां च वृद्धानां क्षत्रियाणां च भारत ।\nतथा विट्शूद्रसङ्घानामभवत् पाण्डवः प्रियः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2212526, "chapter_id": 5527, "verse_number": "१३", "content_sanskrit": "यच्च किञ्चित् पुरा पापं धृतराष्ट्रसुतैः कृतम् ।\nअकृत्वा हृदि तद् राजा तं नृपं सोऽन्ववर्तत\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2212527, "chapter_id": 5527, "verse_number": "१४", "content_sanskrit": "यश्च कश्च नरः किञ्चिदप्रियं ह्यम्बिकासुते ।\nकुरुते द्वेष्यतामेति स कौन्तेयस्य धीमतः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2212528, "chapter_id": 5527, "verse_number": "१५", "content_sanskrit": "न राज्ञो धृतराष्ट्रस्य न च दुर्योधनस्य च ।\nअरोचद् दुष्कृतं किञ्चिद् युधिष्ठिरभयान्नरः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2212529, "chapter_id": 5527, "verse_number": "१६", "content_sanskrit": "तुष्टोऽभूद् धृतराष्ट्रश्च गान्धारी च महायशाः ।\nअजातशत्रोर्वृत्तेन न तु भीमस्य पार्थिवः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2212530, "chapter_id": 5527, "verse_number": "१७", "content_sanskrit": "अन्ववर्तन्त भीमोऽपि तिष्ठन्तं धर्मजं नृपम् ।\nधृतराष्ट्रं स सम्प्रेक्ष्य सदा भवति दुर्मनाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2212531, "chapter_id": 5527, "verse_number": "१८", "content_sanskrit": "राजानमनुगच्छंस्तु धर्मपुत्रं महामतिम् ।\nअन्ववर्तत सक्रोधो हृदयेन पराङ्मुखः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2212532, "chapter_id": 5527, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्रमवासिकपर्वणि तृतीयोऽध्यायः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2212533, "chapter_id": 5527, "verse_number": "", "content_sanskrit": "आश्रमवासपर्वणि तृतीयोऽध्यायः ॥३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]