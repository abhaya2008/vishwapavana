[{"id": 2018675, "chapter_id": 1391, "verse_number": "३-२९-०x", "content_sanskrit": "`वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2018676, "chapter_id": 1391, "verse_number": "३-२९-१", "content_sanskrit": "द्रौपद्या वचनं श्रुत्वा श्लक्ष्णाक्षरपदं शुभम्।\nउवाच द्रौपदीं राजा स्मयमानो युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2018677, "chapter_id": 1391, "verse_number": "३-२९-२", "content_sanskrit": "कारणे भवती क्रुद्धा धार्तराष्ट्रस्य दुर्मतेः।\nयेन क्रोधं महाप्रज्ञे बहुधा बहुमन्यसे।\nक्रोधमूलं हरं शत्रुं कारणैः शृणु तं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2018678, "chapter_id": 1391, "verse_number": "३-२९-३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2018679, "chapter_id": 1391, "verse_number": "३-२९-३", "content_sanskrit": "क्रोधो हन्ता मनुष्याणां क्रोधो भावयिता पुनः।\nइति विद्धि महाप्रात्रे क्रोधमूलौ भवाभवौ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2018680, "chapter_id": 1391, "verse_number": "३-२९-४", "content_sanskrit": "यो हि संहरते क्रोधं भावस्तस्य सुशोभने।\n`यो न संहरते क्रोधं तस्याभावो भवत्युत।\nअभावकारणं तस्मात्क्रोधो भवति शोभने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2018681, "chapter_id": 1391, "verse_number": "३-२९-५", "content_sanskrit": "यः पुनः पुरुषः क्रोधं नित्यं विसृजते शुभे।\nतस्याभावाय भवति क्रोधः परमदारुणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2018682, "chapter_id": 1391, "verse_number": "३-२९-६", "content_sanskrit": "क्रोधमूलो विनाशो हि प्रजानामिह दृश्यते।\nतत्कथं मादृशः क्रोधमुत्सृजेल्लोकनाशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2018683, "chapter_id": 1391, "verse_number": "३-२९-७", "content_sanskrit": "क्रुद्धः पापं नरः कुर्यात्क्रुद्धो हन्याद्गुरूनपि।\nक्रुद्धः परुषया वाचा श्रेयसोऽप्यवमन्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2018684, "chapter_id": 1391, "verse_number": "३-२९-८", "content_sanskrit": "वाच्यावाच्ये हि कुपितो न प्रजानाति कर्हिचित्।\nनाकार्यमस्ति क्रुद्धस्य नावाच्यं विद्यते तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2018685, "chapter_id": 1391, "verse_number": "३-२९-९", "content_sanskrit": "हिंस्यात्क्रोधादवध्यांस्तु वध्यान्संपूजयीत च।\nआत्मानमपि च क्रुद्धः प्रेषयेद्यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2018686, "chapter_id": 1391, "verse_number": "३-२९-१०", "content_sanskrit": "एतान्दोषान्प्रपश्यद्भिर्जितः क्रोधो मनीषिभिः।\nइच्छद्भिः परमं श्रेय इह चामुत्र चोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2018687, "chapter_id": 1391, "verse_number": "३-२९-११", "content_sanskrit": "तं क्रोधं वर्जितं धीरैः कथमस्मद्विधश्ररेत्।\nएतद्द्रौपदि संस्मृत्यन मे मन्युः प्रवर्धते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2018688, "chapter_id": 1391, "verse_number": "३-२९-१२", "content_sanskrit": "आत्मानं च परांश्चैव त्रायते महतो भयात्।\nक्रुध्यन्तमप्रतिक्रुध्यन्दूयोरेष चिकित्सकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2018689, "chapter_id": 1391, "verse_number": "३-२९-१३", "content_sanskrit": "मूढो यदि क्लिश्यमानः क्रुध्यतेऽशक्तिमान्नरः।\nबलीयसां मनुष्याणां त्यजत्यात्मानमन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2018690, "chapter_id": 1391, "verse_number": "३-२९-१४", "content_sanskrit": "तस्यात्मानं संत्यजतो लोका नश्यन्त्यनात्मनः।\nतस्माद्द्रौपद्यशक्तस् मन्योर्नियमनं स्मृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2018691, "chapter_id": 1391, "verse_number": "३-२९-१५", "content_sanskrit": "विद्वांस्तथैव यः शक्तः क्लिश्यमानः प्रकुप्यति।\nस नाशयित्वा द्वेष्टारं परलोके न नन्दति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2018692, "chapter_id": 1391, "verse_number": "३-२९-१६", "content_sanskrit": "तस्माद्बलवता चैव दुर्बलेन च नित्यदा।\nक्षन्तव्यं पुरुषेणाहुरापत्स्वपि विजानता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2018693, "chapter_id": 1391, "verse_number": "३-२९-१७", "content_sanskrit": "मन्योर्हि विजयं कृष्णे प्रशंसन्तीह साधवः।\nक्षमावतो जयो नित्यं साधोरिह सतां मतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2018694, "chapter_id": 1391, "verse_number": "३-२९-१८", "content_sanskrit": "सत्यंचानृततः श्रेयो नृशंसाच्चानृशंसता।\nतमेवं बहुदोषं त क्रोधं सद्भिर्विवर्जितम्।\nमादृशो विसृजेत्तस्मात्सर्वलोकविनाशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2018695, "chapter_id": 1391, "verse_number": "३-२९-१९", "content_sanskrit": "तेजस्वीति यमाहुर्वै पण्डिता दीर्गदर्शिनः।\nन क्रोधोऽभ्यन्तरस्तस् भवतीति विनिश्चेतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2018696, "chapter_id": 1391, "verse_number": "३-२९-२०", "content_sanskrit": "वस्तु क्रोधं समुत्पन्नं प्रज्ञया परिबाधते।\nतेजस्विनं तं विदुषो मन्यन्ते तत्त्वदर्शिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2018697, "chapter_id": 1391, "verse_number": "३-२९-२१", "content_sanskrit": "क्रुद्धो हि कार्यं सुश्रोणि न यथावत्प्रपश्यति।\nनाकार्यं न च मर्यादां नरः क्रुद्धोऽनुपश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2018698, "chapter_id": 1391, "verse_number": "३-२९-२२", "content_sanskrit": "हन्त्यवध्यानपि क्रुद्धो गुरून्रूक्षैस्तुदत्यपि।\nतस्मात्तेजसि कर्तव्ये क्रोधो दूरात्प्रतिष्ठितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2018699, "chapter_id": 1391, "verse_number": "३-२९-२३", "content_sanskrit": "दाक्ष्यं ह्यमर्षः शौर्यं च शीघ्रत्वमिति तेजसः।\nगुणाः क्रोधाभिभूतेन न शक्याः प्राप्तुमञ्जसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2018700, "chapter_id": 1391, "verse_number": "३-२९-२४", "content_sanskrit": "क्रोधं त्यक्त्वा तु पुरुषः सम्यक्तेजोऽभिपद्यते।\nकालयुक्तं महाप्राज्ञैः क्रुद्धैस्तेजः सुदुर्लभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2018701, "chapter_id": 1391, "verse_number": "३-२९-२५", "content_sanskrit": "क्रोधस्त्वपण्डितैः शश्वत्तेज इत्यभिनिश्चितम्।\nरजस्तु लोकनाशाय विहितं मानुषान्प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2018702, "chapter_id": 1391, "verse_number": "३-२९-२६", "content_sanskrit": "तस्माच्छश्वत्त्यजेत्क्रोधं पुरुषः सम्यगाचरन्।\nश्रेयान्स्वधर्मानपगो न क्रुद्ध इति निश्चितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2018703, "chapter_id": 1391, "verse_number": "३-२९-२७", "content_sanskrit": "यदि सर्वमबुद्धीनामतिक्रान्तमचेतसाम्।\nअतिक्रमो मद्विधस्य कथं स्वित्स्यादनिन्दिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2018704, "chapter_id": 1391, "verse_number": "३-२९-२८", "content_sanskrit": "यदि न स्युर्मानुषेषु क्षमिणः पृथिवीसमाः।\nन स्यात्सन्धिर्मनुष्याणां क्रोधमूलो हि विग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2018705, "chapter_id": 1391, "verse_number": "३-२९-२९", "content_sanskrit": "अभिषक्तो ह्यभिषजेदाहन्याद्गुरुणा हतः।\nएवं विनाशो भूतानाममधर्मः प्रथितो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2018706, "chapter_id": 1391, "verse_number": "३-२९-३०", "content_sanskrit": "आक्रुष्ट पुरुषः सर्वं प्रत्याक्रोशेदनन्तरम्।\nप्रतिहन्याद्धतश्चैव तथा हिंस्याच्च हिंसितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2018707, "chapter_id": 1391, "verse_number": "३-२९-३१", "content_sanskrit": "हन्युर्हि पितरः पुत्रान्पुत्राश्चापि तथा पितॄन्।\nहन्युश्च पतयो भार्याः पतीन्भार्यास्तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2018708, "chapter_id": 1391, "verse_number": "३-२९-३२", "content_sanskrit": "एवं संकुपिते लोके जन्म कृष्णो न विद्यते।\nप्रजानां सन्धिमूलं हि जन्म विद्धिशुभानने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2018709, "chapter_id": 1391, "verse_number": "३-२९-३३", "content_sanskrit": "ताः क्षीयेरन्प्रजाः सर्वाः क्षिप्रं द्रौपदि तादृशाः।\nतस्मान्मन्युर्विनाशाय प्रजानामभवाय च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2018710, "chapter_id": 1391, "verse_number": "३-२९-३४", "content_sanskrit": "यस्मात्तु लोके दृश्यन्ते क्षमिणः पृथिवीसमाः।\nतस्माज्जन्म च भूतानां भवश्च प्रतिपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2018711, "chapter_id": 1391, "verse_number": "३-२९-३५", "content_sanskrit": "क्षन्तव्यं पुरुषेणेह सर्वापत्सु सुशोभने।\nक्षमावतो हि भूतानां जन्म चैव प्रकीर्तितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2018712, "chapter_id": 1391, "verse_number": "३-२९-३६", "content_sanskrit": "आक्रुष्टस्ताडितः क्रुद्धः क्षमते यो बवीयसा।\nयश्च नित्यं जितक्रोधो विद्वानुत्तमपूरुषः।\nप्रभाववानपि नरस्तस्य लोकाः सनातनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2018713, "chapter_id": 1391, "verse_number": "३-२९-३७", "content_sanskrit": "क्रोधनस्त्वल्पविज्ञानः प्रेत्य चेह च नश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2018714, "chapter_id": 1391, "verse_number": "३-२९-३८", "content_sanskrit": "अत्राप्युदाहरन्तीमा गाथा नित्यं क्षमावताम्।\nगीताः क्षमावतां कृष्णे काश्यपेन महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2018715, "chapter_id": 1391, "verse_number": "३-२९-३९", "content_sanskrit": "क्षमा धर्मः क्षमा यज्ञः क्षमा वेदाः क्षमा श्रुतम्।\nयस्तमेवं विजानाति स सर्वं क्षन्तुर्महति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2018716, "chapter_id": 1391, "verse_number": "३-२९-४०", "content_sanskrit": "क्षमा ब्रह्म क्षमा सत्यं क्षमा भूतं च भावि च।\nक्षमा तपः क्षमा शौचं क्षमयेदं धृतं जगत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2018717, "chapter_id": 1391, "verse_number": "३-२९-४१", "content_sanskrit": "अति यज्ञविदां लोकान्क्षमिणः प्राप्नुवन्ति च।\nअति ब्रह्मविदां लोकानति चापि तपस्विनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2018718, "chapter_id": 1391, "verse_number": "३-२९-४२", "content_sanskrit": "अन्ये वै यजुषां लोकाः कर्मिणामपरे तथा।\nक्षमावतां ब्रह्मलोके लोकाः परमपूजिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2018719, "chapter_id": 1391, "verse_number": "३-२९-४३", "content_sanskrit": "क्षमा तेजस्विनां तेजः क्षमा ब्रह्म तपस्विनाम्।\nक्षमा सत्यं सत्यवतां क्षमा यज्ञः क्षमा शभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2018720, "chapter_id": 1391, "verse_number": "३-२९-४४", "content_sanskrit": "तां क्षमां तादृशीं कृष्णे कथमस्मद्विधस्त्यजेत्।\nयत्रब्रह्म च सत्यं च यज्ञा लोकाश्च धिष्ठिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2018721, "chapter_id": 1391, "verse_number": "३-२९-४५", "content_sanskrit": "`इज्यन्ते यज्वनां लोकाः क्षमिणामपरे तथा।\nक्षन्तव्यमेव सततं पुरुषेण विजानता।\nयदा हि क्षमते सर्वं ब्रह्म संपद्यते तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2018722, "chapter_id": 1391, "verse_number": "३-२९-४६", "content_sanskrit": "क्षमावतामयं लोकः परश्चैव क्षमावताम्।\nइह सन्मानमृच्छन्ति परत्र च परा गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2018723, "chapter_id": 1391, "verse_number": "३-२९-४७", "content_sanskrit": "येषां मन्युर्मनुष्याणां क्षमयाऽभिहतः सदा।\nतेषां परतरे लोकास्तस्मात्क्षान्तिः परा मता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2018724, "chapter_id": 1391, "verse_number": "३-२९-४८", "content_sanskrit": "इति गीताः काश्यपेन गाथानित्यं क्षमावताम्।\nश्रुत्वा गाथाः क्षमायास्त्वं तुष्यद्रौपदि मा क्रुधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2018725, "chapter_id": 1391, "verse_number": "३-२९-४९", "content_sanskrit": "पितामहः शान्तनवः रशमं संपूजयिष्यति।\nकृष्णश्च देवकीपुत्रः शमं संपूजयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2018726, "chapter_id": 1391, "verse_number": "३-२९-५०", "content_sanskrit": "आचार्यो विदुरः क्षत्ता शममेव वदिष्यतः।\nकृपश्च संजयश्चैव शममेव वदिष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2018727, "chapter_id": 1391, "verse_number": "३-२९-५१", "content_sanskrit": "सोमदत्तो युयुत्सुश्च द्रोणपुत्रस्तथैव च।\nपितामहश्च नो व्यासः शमं वदति नित्यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2018728, "chapter_id": 1391, "verse_number": "३-२९-५२", "content_sanskrit": "एतैर्हि राजा नियतं चोद्यमानः शमं प्रति।\nराज्यं दातेति मे बुद्धिर्न चेल्लोभान्नशिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2018729, "chapter_id": 1391, "verse_number": "३-२९-५३", "content_sanskrit": "कालोऽयं दारुणः प्राप्तो भरतानामभूतये।\nनिश्चितं मे सदैवैतत्पुरस्तादपि भामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2018730, "chapter_id": 1391, "verse_number": "३-२९-५४", "content_sanskrit": "सुयोधनो नार्हतीति क्षमा मामेव विन्दति।\nअर्हस्तत्राहमित्येवं तस्मान्मां विन्दते क्षमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2018731, "chapter_id": 1391, "verse_number": "३-२९-५५", "content_sanskrit": "एतदात्मवतां वृत्तमेष धर्मः सनातनः।\nक्षमा चैवानृशंस्यं च तत्कर्ताऽस्म्यहमञ्जसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2018732, "chapter_id": 1391, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि अर्जुनाभिगमनपर्वणि एकोनत्रिंशोऽध्यायः ॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]