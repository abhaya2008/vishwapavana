[{"id": 2156561, "chapter_id": 4395, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2156562, "chapter_id": 4395, "verse_number": "१", "content_sanskrit": "ततस्ते पार्थिवाः सर्वे जग्मुः स्वानालयान् पुनः ।\nतूष्णीम्भूते महाराजे भीष्मे शन्तनुनन्दने\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2156563, "chapter_id": 4395, "verse_number": "२", "content_sanskrit": "श्रुत्वा तु निहतं भीष्मं राधेयः पुरुषर्षभः ।\nईषदागतसन्त्रासस्त्वरयोपजगाम ह\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2156564, "chapter_id": 4395, "verse_number": "३", "content_sanskrit": "स ददर्श महात्मानं शरतल्पगतं तदा ।\nजन्मशय्यागतं वीरं कार्त्तिकेयमिव प्रभुम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2156565, "chapter_id": 4395, "verse_number": "४", "content_sanskrit": "निमीलिताक्षं तं वीरं साश्रुकण्ठस्तदा वृषः ।\nअभ्येत्य पादयोस्तस्य निपपात महाद्युतिः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2156566, "chapter_id": 4395, "verse_number": "५", "content_sanskrit": "राधेयोऽहं कुरुश्रेष्ठ नित्यं चाक्षिगतस्तव ।\nद्वेष्योऽत्यन्तमनागाः सन्निति चैनमुवाच ह\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2156567, "chapter_id": 4395, "verse_number": "६", "content_sanskrit": "तच्छ्रुत्वा कुरुवृद्धः स शरैः संवृत्तलोचनः ।\nशनैरुद्वीक्ष्य सस्नेहमिदं वचनमब्रवीत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2156568, "chapter_id": 4395, "verse_number": "७", "content_sanskrit": "एह्येहि मे विप्रतीप स्पर्धसे त्वं मया सह ।\nरहितं धिष्ण्यमालोक्य समुत्सार्य च रक्षिणः ।\nपितेव पुत्रं गाङ्गेयः परिष्वज्यैकबाहुना\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2156569, "chapter_id": 4395, "verse_number": "८", "content_sanskrit": "यदि मां नाभिगच्छेथा न ते श्रेयो भवेद् ध्रुवम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2156570, "chapter_id": 4395, "verse_number": "९", "content_sanskrit": "कौन्तेयस्त्वं न राधेयो विदितो नारदान्मम ।\nकृष्णद्वैपायनाच्चैव केशवाच्च न संशयः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2156571, "chapter_id": 4395, "verse_number": "१०", "content_sanskrit": "न च द्वेषोऽस्ति मे तात त्वयि सत्यं ब्रवीमि ते ।\nतेजोवधनिमित्तं तु परुषाण्यहमुक्तवान् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2156572, "chapter_id": 4395, "verse_number": "११", "content_sanskrit": "अकस्मात् पाण्डवान् हि त्वं द्विषसीति मतिर्मम ।\nयेनासि बहुशो रूक्षं चोदितः सूर्यनन्दन\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2156573, "chapter_id": 4395, "verse_number": "१२", "content_sanskrit": "जानामि समरे वीर्यं शत्रुभिर्दुःसहं तव ।\nब्रह्मण्यतां च शौर्यं च दाने च परमां गतिम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2156574, "chapter_id": 4395, "verse_number": "१३", "content_sanskrit": "न त्वया सदृशः कश्चित्पुरुषेष्वमरोपम ।\nकुलभेदं च मत्वाहं सदा परुषमुक्तवान् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2156575, "chapter_id": 4395, "verse_number": "१४", "content_sanskrit": "इष्वस्ते भारसन्धाने लाघवेऽस्त्रबले तथा ।\nसदृशः फल्गुनेनासि कृष्णेन च महात्मना\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2156576, "chapter_id": 4395, "verse_number": "१५", "content_sanskrit": "कर्ण काशिपुरं गत्वा त्वयैकेन धनुष्मता ।\nतस्यार्थे कुरुराजस्य राजानो मृदिता युधि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2156577, "chapter_id": 4395, "verse_number": "१६", "content_sanskrit": "तथा च बलवान् राजा जरासन्धो दुरासदः ।\nसमरे समरश्लाघी त्वया न सदृशोऽभवत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2156578, "chapter_id": 4395, "verse_number": "१७", "content_sanskrit": "ब्रह्मण्यः सत्यवादी च तेजसाऽर्क इवापरः ।\nदेवगर्भोऽजितः सङ्खे मनुष्यैरधिको भुवि\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2156579, "chapter_id": 4395, "verse_number": "१८", "content_sanskrit": "व्यपनीतोऽद्य मन्युर्मे यस्त्वां प्रति पुरा कृतः ।\nदैवं पुरुषकारेण न शक्यमतिवर्तितुम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2156580, "chapter_id": 4395, "verse_number": "१९", "content_sanskrit": "सोदर्याः पाण्डवा वीरा भ्रातरस्तेऽरिसूदन ।\nसङ्गच्छ तैर्महाबाहो मम चेदिच्छसि प्रियम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2156581, "chapter_id": 4395, "verse_number": "२०", "content_sanskrit": "मया भवतु निर्वृत्तं वैरमादित्यनन्दन ।\nपृथिव्यां सर्वराजानो भवन्त्वद्य निरामयाः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2156582, "chapter_id": 4395, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2156583, "chapter_id": 4395, "verse_number": "२१", "content_sanskrit": "जानाम्यहं महाप्राज्ञ सर्वमेतन्न संशयः ।\nयथा वदसि दुर्धर्ष कौन्तेयोऽहं न सूतजः ।\nवसुदेवसुतो यद्वत् पाण्डवाय दृढव्रतः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2156584, "chapter_id": 4395, "verse_number": "२२", "content_sanskrit": "अवकीर्णस्त्वहं कुन्त्या सूतेन च विवर्धितः ।\nभुक्त्वा दुर्योधनैश्वर्यं न मिथ्या कर्तुमुत्सहे\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2156585, "chapter_id": 4395, "verse_number": "२३", "content_sanskrit": "वसु चैव शरीरं च यदुदारं तथा यशः ।\nसर्वं दुर्योधनस्यार्थे त्यक्तं मे भूरिदक्षिण \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2156586, "chapter_id": 4395, "verse_number": "२४", "content_sanskrit": "मा चैतद् व्याधिमरणं क्षत्रं स्यादिति कौरव ।\nकोपिताः पाण्डवा नित्यं मयाऽऽश्रित्य सुयोधनम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2156587, "chapter_id": 4395, "verse_number": "२५", "content_sanskrit": "अवश्यभावी वै योऽर्थो न स शक्यो निवर्तितुम् ।\nदैवं पुरुषकारेण को निवर्तितुमुत्सहेत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2156588, "chapter_id": 4395, "verse_number": "२६", "content_sanskrit": "पृथिवीक्षयशंसीनि निमित्तानि पितामह ।\nभवद्भिरुपलब्धानि कथितानि च संसदि\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2156589, "chapter_id": 4395, "verse_number": "२७", "content_sanskrit": "पाण्डवा वासुदेवश्च विदिता मम सर्वशः ।\nअजेयाः पुरुषैरन्यैरिति तांश्चोत्सहामहे\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2156590, "chapter_id": 4395, "verse_number": "२८", "content_sanskrit": "विजयिष्ये रणे पाण्डूनिति मे निश्चितं मनः ।\nन चेच्छक्यमवस्रष्टुं वैरमेतत् सुदारुणम् ।\nधनञ्जयेन योत्स्येऽहं स्वधर्मप्रीतमानसः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2156591, "chapter_id": 4395, "verse_number": "२९", "content_sanskrit": "अनुजानीष्व मां तात युद्धे प्रीतमनाः सदा ।\nअनुज्ञातस्त्वया वीर युध्येयमिति मे मतिः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2156592, "chapter_id": 4395, "verse_number": "३०", "content_sanskrit": "दुरुक्तं विप्रतीपं वा संरम्भाच्चापलात् तथा ।\nयन्मयापकृतं किञ्चित् तदनुक्षन्तुमर्हसि\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2156593, "chapter_id": 4395, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2156594, "chapter_id": 4395, "verse_number": "३१", "content_sanskrit": "न चेच्छक्यमथोत्स्रष्टुं वैरमेतत्सुदारुणम् ।\nअनुजानामि कर्ण त्वां युध्यस्व स्वर्गकाम्यया\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2156595, "chapter_id": 4395, "verse_number": "३२", "content_sanskrit": "विमन्युर्गतसंरम्भः कुरु कर्म नृपस्य हि ।\nयथाशक्ति यथोत्साहं सतां वृत्तेषु वृत्तवान् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2156596, "chapter_id": 4395, "verse_number": "३३", "content_sanskrit": "अहं त्वामनुजानामि यदिच्छसि तदाप्नुहि ।\nक्षत्रधर्मजिताँल्लोकान् सम्प्राप्स्यसि न संशयः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2156597, "chapter_id": 4395, "verse_number": "३४", "content_sanskrit": "युध्यस्व निरहङ्कारो बलवीर्यव्यपाश्रयः ।\nधर्मो हि युद्धाच्छ्रेयोऽन्यत्क्षत्रियस्य न विद्यते\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2156598, "chapter_id": 4395, "verse_number": "३५", "content_sanskrit": "प्रशमे हि कृतो यत्नः सुचिरात्सुचिरं मया ।\nन चैव शकितः कर्तुं यतो धर्मस्ततो जयः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2156599, "chapter_id": 4395, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2156600, "chapter_id": 4395, "verse_number": "३६", "content_sanskrit": "एवं ब्रुवन्तं गाङ्गेयमभिवाद्य प्रसाद्य च ।\nराधेयो रथमारुह्य प्रायात् तव सुतं प्रति\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2156601, "chapter_id": 4395, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां भीष्मपर्वणि एकोनविंशाधिकशततमोऽध्यायः ॥११९॥\nभीष्मवधपर्वणि एकोनाशीतितमोऽध्यायः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2156602, "chapter_id": 4395, "verse_number": "", "content_sanskrit": "॥ समाप्तं भीष्मपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2156603, "chapter_id": 4395, "verse_number": "", "content_sanskrit": "॥श्रीमध्वेशार्पणमस्तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]