[{"id": 5000469000, "chapter_id": 9469, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे द्विषष्टितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000469001, "chapter_id": 9469, "verse_number": "६-६२-१", "content_sanskrit": "स तु राक्षसशार्दूलो निद्रामदसमाकुलः।\nराजमार्गं श्रिया जुष्टं ययौ विपुलविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000469002, "chapter_id": 9469, "verse_number": "६-६२-२", "content_sanskrit": "राक्षसानां सहस्रैश्च वृतः परमदुर्जयः।\nगृहेभ्यः पुष्पवर्षेण कीर्यमाणस्तदा ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000469003, "chapter_id": 9469, "verse_number": "६-६२-३", "content_sanskrit": "स हेमजालविततं भानुभास्वरदर्शनम्।\nददर्श विपुलं रम्यं राक्षसेन्द्रनिवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000469004, "chapter_id": 9469, "verse_number": "६-६२-४", "content_sanskrit": "स तत्तदा सूर्य इवाभ्रजालं\nप्रविश्य रक्षोधिपतेर्निवेशनम्।\nददर्श दूरेऽग्रजमासनस्थं\nस्वयंभुवं शक्र इवासनस्थम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000469005, "chapter_id": 9469, "verse_number": "६-६२-५", "content_sanskrit": "भ्रातुः स भवनं गच्छन् रक्षोगणसमन्वितः।\nकुम्भकर्णः पदन्यासैरकम्पयत मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000469006, "chapter_id": 9469, "verse_number": "६-६२-६", "content_sanskrit": "सोऽभिगम्य गृहं भ्रातुः कक्ष्यामभिविगाह्य च।\nददर्शोद्विग्नमासीनं विमाने पुष्पके गुरुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000469007, "chapter_id": 9469, "verse_number": "६-६२-७", "content_sanskrit": "अथ दृष्ट्वा दशग्रीवः कुम्भकर्णमुपस्थितम्।\nतूर्णमुत्थाय संहृष्टः संनिकर्षमुपानयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000469008, "chapter_id": 9469, "verse_number": "६-६२-८", "content_sanskrit": "अथासीनस्य पर्यङ्के कुम्भकर्णो महाबलः।\nभ्रातुर्ववन्दे चरणौ किं कृत्यमिति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000469009, "chapter_id": 9469, "verse_number": "६-६२-९", "content_sanskrit": "उत्पत्य चैनं मुदितो रावणः परिषस्वजे।\nस भ्रात्रा सम्परिष्वक्तो यथावच्चाभिनन्दितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000469010, "chapter_id": 9469, "verse_number": "६-६२-१०", "content_sanskrit": "कुम्भकर्णः शुभं दिव्यं प्रतिपेदे वरासनम्।\nस तदासनमाश्रित्य कुम्भकर्णो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000469011, "chapter_id": 9469, "verse_number": "६-६२-११", "content_sanskrit": "संरक्तनयनः क्रोधाद् रावणं वाक्यमब्रवीत्।\nकिमर्थमहमादृत्य त्वया राजन् प्रबोधितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000469012, "chapter_id": 9469, "verse_number": "६-६२-१२", "content_sanskrit": "शंस कस्माद् भयं तेऽत्र को वा प्रेतो भविष्यति।\nभ्रातरं रावणः क्रुद्धं कुम्भकर्णमवस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000469013, "chapter_id": 9469, "verse_number": "६-६२-१३", "content_sanskrit": "रोषेण परिवृत्ताभ्यां नेत्राभ्यां वाक्यमब्रवीत्।\nअद्य ते सुमहान् कालः शयानस्य महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000469014, "chapter_id": 9469, "verse_number": "६-६२-१४", "content_sanskrit": "सुषुप्तस्त्वं न जानीषे मम रामकृतं भयम्।\nएष दाशरथिः श्रीमान् सुग्रीवसहितो बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000469015, "chapter_id": 9469, "verse_number": "६-६२-१५", "content_sanskrit": "समुद्रं लङ्घयित्वा तु मूलं नः परिकृन्तति।\nहन्त पश्यस्व लङ्कायां वनान्युपवनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000469016, "chapter_id": 9469, "verse_number": "६-६२-१६", "content_sanskrit": "सेतुना सुखमागत्य वानरैकार्णवं कृतम्।\nये राक्षसा मुख्यतमा हतास्ते वानरैर्युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000469017, "chapter_id": 9469, "verse_number": "६-६२-१७", "content_sanskrit": "वानराणां क्षयं युद्धे न पश्यामि कथंचन।\nन चापि वानरा युद्धे जितपूर्वाः कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000469018, "chapter_id": 9469, "verse_number": "६-६२-१८", "content_sanskrit": "तदेतद् भयमुत्पन्नं त्रायस्वेह महाबल।\nनाशय त्वमिमानद्य तदर्थं बोधितो भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000469019, "chapter_id": 9469, "verse_number": "६-६२-१९", "content_sanskrit": "सर्वक्षपितकोशं च स त्वमभ्युपपद्य माम्।\nत्रायस्वेमां पुरीं लङ्कां बालवृद्धावशेषिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000469020, "chapter_id": 9469, "verse_number": "६-६२-२०", "content_sanskrit": "भ्रातुरर्थे महाबाहो कुरु कर्म सुदुष्करम्।\nमयैवं नोक्तपूर्वो हि भ्राता कश्चित् परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000469021, "chapter_id": 9469, "verse_number": "६-६२-२१", "content_sanskrit": "त्वय्यस्ति मम च स्नेहः परा सम्भावना च मे।\nदेवासुरेषु युद्धेषु बहुशो राक्षसर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000469022, "chapter_id": 9469, "verse_number": "६-६२-२२", "content_sanskrit": "त्वया देवाः प्रतिव्यूह्य निर्जिताश्चासुरा युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000469023, "chapter_id": 9469, "verse_number": "६-६२-२३", "content_sanskrit": "तदेतत् सर्वमातिष्ठ वीर्यं भीमपराक्रम।\nनहि ते सर्वभूतेषु दृश्यते सदृशो बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000469024, "chapter_id": 9469, "verse_number": "६-६२-२४", "content_sanskrit": "कुरुष्व मे प्रियहितमेतदुत्तमं\nयथाप्रियं प्रियरण बान्धवप्रिय।\nस्वतेजसा व्यथय सपत्नवाहिनीं\nशरद्घनं पवन इवोद्यतो महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000469025, "chapter_id": 9469, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे द्विषष्टितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]