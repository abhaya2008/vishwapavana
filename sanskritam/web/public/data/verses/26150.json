[{"id": 7006150000, "chapter_id": 26150, "verse_number": "१-२-११-१", "content_sanskrit": "सूत उवाच ।\nएवमेव निसर्गो वै वर्षाणां भारते शुभे ।\nदृष्टः परमतत्त्वज्ञैर्भूयः किं वर्णयामि वः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006150001, "chapter_id": 26150, "verse_number": "१-२-११-२", "content_sanskrit": "ऋषिरुवाच ।\nयदिदं भारतं वर्षं यस्मिन्स्वायंभुवादयः ।\nचतुर्दशैते मनवः प्रजासर्गेऽभवन्पुनः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006150002, "chapter_id": 26150, "verse_number": "१-२-११-३", "content_sanskrit": "एतद्वेदितुमिच्छामस्तन्नो निगद सत्त्मः ।\nएतच्छ्रुतवचस्तेषामब्रवीद्रोमहर्षणः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006150003, "chapter_id": 26150, "verse_number": "१-२-११-४", "content_sanskrit": "अत्र वो वर्णयिष्यामि वर्षेऽस्मिन् भारते प्रजाः ।\nइदं तु मध्यमं चित्रं शुभाशुभफलोदयम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006150004, "chapter_id": 26150, "verse_number": "१-२-११-५", "content_sanskrit": "उत्तरं यत्ममुद्रस्य हिमवद्दक्षिणं च यत् ।\nवर्षं तद्भारतं नाम यत्रेयं भारती प्रजा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006150005, "chapter_id": 26150, "verse_number": "१-२-११-६", "content_sanskrit": "भरणाच्च प्रजानां वै मनुर्भरत उच्यते ।\nनिरुक्तवचनाच्चैवं वर्षं तद्भारतं स्मृतम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006150006, "chapter_id": 26150, "verse_number": "१-२-११-७", "content_sanskrit": "इतः स्वर्गश्च मोक्षश्च मध्यश्चांतश्च गम्यते ।\nन खल्वन्यत्र मर्त्यानां भूमौ कर्म विधीयते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006150007, "chapter_id": 26150, "verse_number": "१-२-११-८", "content_sanskrit": "भारतस्यास्य वर्षस्य नव भेदान्निबोधत ।\nसमुद्रातरिता ज्ञेयास्ते त्वगम्याः परस्परम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006150008, "chapter_id": 26150, "verse_number": "१-२-११-९", "content_sanskrit": "इंद्रद्वीपः कशेरूमांस्ताम्रवर्णो गभस्तिमान् ।\nनागद्वीपस्तथा सौम्यो गांधर्वस्त्वथ वारुणः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006150009, "chapter_id": 26150, "verse_number": "१-२-११-१०", "content_sanskrit": "अयं तु नवमस्तेषां द्वीपः सागरसंवृतः ।\nयोजनानां सहस्रे तु द्वीपोऽयं दक्षिणोत्तरात् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006150010, "chapter_id": 26150, "verse_number": "१-२-११-११", "content_sanskrit": "आयतो ह्याकुमार्य्या वै चागंगाप्रभवाच्च वै ।\nतिर्यगुत्तरविस्तीर्मः सहस्राणि नवैव तु ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006150011, "chapter_id": 26150, "verse_number": "१-२-११-१२", "content_sanskrit": "द्वीपो ह्युपनिविष्टोऽयं म्लेच्छैरंतेषु सर्वशः ।\nपूर्वे किराता ह्यस्यांते पश्चिमे यवनाः स्मृताः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006150012, "chapter_id": 26150, "verse_number": "१-२-११-१३", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्या मध्ये शूद्राश्च भागशः ।\nइज्यायुधवणिज्याभिर्वर्त्तयंतो व्यवस्थिताः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006150013, "chapter_id": 26150, "verse_number": "१-२-११-१४", "content_sanskrit": "तेषां संव्यवहारोऽत्र वर्त्तते वै परस्परम् ।\nधर्मार्थकामसंयुक्तो वर्णानां तु स्वकर्मसु ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006150014, "chapter_id": 26150, "verse_number": "१-२-११-१५", "content_sanskrit": "संकल्पः पंचमानां च ह्याश्रमाणां यथाविधि ।\nइह स्वर्गापवर्गार्थं प्रवृत्तिर्येषु मानुषी ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006150015, "chapter_id": 26150, "verse_number": "१-२-११-१६", "content_sanskrit": "यस्त्वयं नवमो द्वीपस्तिर्यगायाम उच्यते ।\nकृत्स्नं जयति यो ह्येनं सम्राडित्यभिधीयते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006150016, "chapter_id": 26150, "verse_number": "१-२-११-१७", "content_sanskrit": "अयं लोकस्तु वै सम्राडंतरिक्षं विराट् स्मृतम् ।\nस्वराडसौ स्मृतो लौकः पुनर्वक्ष्यामि विस्तरात् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006150017, "chapter_id": 26150, "verse_number": "१-२-११-१८", "content_sanskrit": "सप्तैवास्मिन्सुपर्वाणो विश्रुताः कुल पर्वताः ।\nमहेंद्रो मलयः सह्यः शुक्तिमानृक्षपर्वतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006150018, "chapter_id": 26150, "verse_number": "१-२-११-१९", "content_sanskrit": "विंध्यश्च पारियात्रश्च सप्तैते कुलपर्वताः ।\nतेषां सहस्रश्चान्ये पर्व तास्तु समीपगाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006150019, "chapter_id": 26150, "verse_number": "१-२-११-२०", "content_sanskrit": "अविज्ञाताः सारवंतो विपुलाश्चित्रसानवः ।\nसंदरः पर्वतश्रेष्ठो वैहारो दुर्दुरस्तथा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006150020, "chapter_id": 26150, "verse_number": "१-२-११-२१", "content_sanskrit": "कोलाहलः ससुरसो मैनाको वैद्युतस्तथा ।\nवातंधमो नागगिरिस्तथा पाण्डुरपर्वतः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006150021, "chapter_id": 26150, "verse_number": "१-२-११-२२", "content_sanskrit": "तुंगप्रस्थः कृष्णगिरिर्गोधनो गिरिरेव च ।\nपुष्पगिर्युज्जयंतौ च शैलो रैवतकस्तथा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006150022, "chapter_id": 26150, "verse_number": "१-२-११-२३", "content_sanskrit": "श्रीपर्वतश्चित्रकूटः कूटशैलो गिरिस्तथा ।\nअन्ये तेभ्योऽपरिज्ञाता ह्रस्वाः स्वलपोपजी विनः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006150023, "chapter_id": 26150, "verse_number": "१-२-११-२४", "content_sanskrit": "तैर्विमिश्रा जनपदा आर्या म्लेच्छाश्च भागशः ।\nपीयंते यैरिमा नद्यो गंगा सिंधु सरस्वती ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006150024, "chapter_id": 26150, "verse_number": "१-२-११-२५", "content_sanskrit": "शतद्रुश्चंद्र भागा च यमुना सरयूस्तथा ।\nइरावती वितस्ता च विपाशा देविका कुहूः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006150025, "chapter_id": 26150, "verse_number": "१-२-११-२६", "content_sanskrit": "गोमती धूतपापा च बुद्बुदा च दृषद्वती ।\nकौशकी त्रिदिवा चैव निष्ठीवी गेडकी तथा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006150026, "chapter_id": 26150, "verse_number": "१-२-११-२७", "content_sanskrit": "चक्षुर्लोहित इत्येता हिमवत्पादनिस्सृताः ।\nवेदस्मृतिर्वेदवती वृत्रघ्नी सिंधु रेव च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006150027, "chapter_id": 26150, "verse_number": "१-२-११-२८", "content_sanskrit": "वर्णाशा नंदना चैव सदानीरा महानदी ।\nपाशा चर्मण्वतीनूपा विदिशा वेत्रवत्यपि ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006150028, "chapter_id": 26150, "verse_number": "१-२-११-२९", "content_sanskrit": "क्षिप्रा ह्यवंति च तथा पारियात्राश्रयाः स्मृताः ।\nशोणो महानदश्चैव नर्म्मदा सुरसा क्रिया ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006150029, "chapter_id": 26150, "verse_number": "१-२-११-३०", "content_sanskrit": "मंदाकिनी दशार्णा च चित्रकूटा तथैव च ।\nतमसा पिप्पला श्येना करमोदा पिशाचिका ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006150030, "chapter_id": 26150, "verse_number": "१-२-११-३१", "content_sanskrit": "चित्रोपला विशाला च बंजुला वास्तुवाहिनी ।\nसनेरुजा शुक्तिमती मंकुती त्रिदिवा क्रतुः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006150031, "chapter_id": 26150, "verse_number": "१-२-११-३२", "content_sanskrit": "ऋक्षवत्संप्रसूतास्ता नद्यो मणिजलाः शिवाः ।\nतापी पयोष्णी निर्विंध्या सृपा च निषधा नदी ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006150032, "chapter_id": 26150, "verse_number": "१-२-११-३३", "content_sanskrit": "वेणी वैतरणी चैव क्षिप्रा वाला कुमुद्वती ।\nतोया चैव महागौरी दुर्गा वान्नशिला तथा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006150033, "chapter_id": 26150, "verse_number": "१-२-११-३४", "content_sanskrit": "विंध्यपादप्रसूतास्ता नद्यः पुण्यजलाः शुभाः ।\nगोदावरी भीमरथी कृष्णवेणाथ बंजुला ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006150034, "chapter_id": 26150, "verse_number": "१-२-११-३५", "content_sanskrit": "तुंगभद्रा सुप्रयोगा बाह्या कावेर्यथापि च ।\nदक्षिणप्रवहा नद्यः सह्य पादाद्विनिःस्मृताः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006150035, "chapter_id": 26150, "verse_number": "१-२-११-३६", "content_sanskrit": "कृतमाला ताम्रपर्णी पुष्पजात्युत्पलावती ।\nनद्योऽभिजाता मलयात्सर्वाः शीतजलाः शुभाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006150036, "chapter_id": 26150, "verse_number": "१-२-११-३७", "content_sanskrit": "त्रिसामा ऋषिकुल्या च बंजुला त्रिदिवाबला ।\nलांगूलिनी वंशधरा महेंद्रतनयाः स्मृताः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006150037, "chapter_id": 26150, "verse_number": "१-२-११-३८", "content_sanskrit": "ऋषिकुल्या कुमारी च मंदगा मंदगामिनी ।\nकृपा पलाशिनी चैव शुक्तिमत्प्रभवाः स्मृताः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006150038, "chapter_id": 26150, "verse_number": "१-२-११-३९", "content_sanskrit": "तास्तु नद्यः सरस्वत्यः सर्वा गंगाः समुद्रगाः ।\nविश्वस्य मातरः सर्वा जगत्पापहराः स्मृताः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006150039, "chapter_id": 26150, "verse_number": "१-२-११-४०", "content_sanskrit": "तासां नद्युपनद्योऽन्याः शतशोऽथ सहस्रशः ।\nतास्विमे कुरुपांचालाः शाल्वा माद्रेयजांगलाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006150040, "chapter_id": 26150, "verse_number": "१-२-११-४१", "content_sanskrit": "शूरसेना भद्रकारा बोधाः सहपटच्चराः ।\nमत्स्याः कुशल्याः सौशल्याः कुंतलाः काशिकोशलाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006150041, "chapter_id": 26150, "verse_number": "१-२-११-४२", "content_sanskrit": "गोधा भद्राः करिंगाश्च मागधाश्चोत्कलैः सह ।\nमध्यदेश्या जनपदाः प्रायशस्त्त्र कीर्त्तिताः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006150042, "chapter_id": 26150, "verse_number": "१-२-११-४३", "content_sanskrit": "सह्यस्य चौत्तरांतेषु यत्र गोदावरी नदी ।\nपृथिव्यामपि कृत्स्नायां स प्रदेशो मनोरमः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006150043, "chapter_id": 26150, "verse_number": "१-२-११-४४", "content_sanskrit": "तत्र गोवर्धनं नाम पुरं रामेण निर्मितम् ।\nरामप्रियाथ स्वर्गीया वृक्ष दिव्यास्त थौषधीः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006150044, "chapter_id": 26150, "verse_number": "१-२-११-४५", "content_sanskrit": "भरद्वाजेन मुनिना तत्प्रियार्थेऽवरोपिताः ।\nअतः पुर्वरोद्देशस्तेन जज्ञे मनोरमः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006150045, "chapter_id": 26150, "verse_number": "१-२-११-४६", "content_sanskrit": "बाह्लीका वाटधानाश्च आभीरा कालतोयकाः ।\nअपरांताश्च मुह्माश्च पाञ्चलाश्चर्ममंडलाः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006150046, "chapter_id": 26150, "verse_number": "१-२-११-४७", "content_sanskrit": "गांधारा यवनाश्चैव सिंधुसौवीरमण्डलाः ।\nचीनाश्चैव तुषाराश्च पल्लवा गिरिगह्वराः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006150047, "chapter_id": 26150, "verse_number": "१-२-११-४८", "content_sanskrit": "शाका भद्राः कुलिंदाश्च पारदा विन्ध्यचूलिकाः ।\nअभीषाहा उलूताश्च केकया दशामालिकाः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006150048, "chapter_id": 26150, "verse_number": "१-२-११-४९", "content_sanskrit": "ब्राह्मणाः क्षत्रियाश्चैव वैश्यशूद्रकुलानि तु ।\nकांवोजा दरदाश्चैव बर्बरा अंगलौहिकाः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006150049, "chapter_id": 26150, "verse_number": "१-२-११-५०", "content_sanskrit": "अत्रयः सभरद्वाजाः प्रस्थलाश्च दशेरकाः ।\nअंगवंगा श्चोलभद्राः किरातानां च जातयः ।\nतोमरा हंसभंगाश्च काश्मीरास्तंगणास्तथा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006150050, "chapter_id": 26150, "verse_number": "१-२-११-५१", "content_sanskrit": "झिल्लिकाश्चाहुकाश्चैव हूणदर्वास्तथैव च ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006150051, "chapter_id": 26150, "verse_number": "१-२-११-५२", "content_sanskrit": "अंध्रवाका मुद्गरका अंतर्गिरिबहिर्गिराः ।\nततः प्लवंगवो ज्ञेया मलदा मलवर्तिकाः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006150052, "chapter_id": 26150, "verse_number": "१-२-११-५३", "content_sanskrit": "समंतराः प्रावृषेया भार्गवा गोपपार्थिवाः ।\nप्राग्ज्योतिषाश्च पुंड्राश्च विदेहास्ताम्रलिप्तकाः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006150053, "chapter_id": 26150, "verse_number": "१-२-११-५४", "content_sanskrit": "मल्ला मगधगोनर्दाः प्राच्यां जनपदाः स्मृताः ।\nअथापरे जनपदा दक्षिणापथवासिनः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006150054, "chapter_id": 26150, "verse_number": "१-२-११-५५", "content_sanskrit": "पंड्याश्च केरलाश्चैव चोलाः कुल्यास्तथैव च ।\nसेतुका मूषिकाश्चैव क्षपणा वनवासिकाः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006150055, "chapter_id": 26150, "verse_number": "१-२-११-५६", "content_sanskrit": "माहराष्ट्रा महिषिकाः कलिंगश्चैव सर्वशः ।\nआभीराश्च सहैषीका आटव्या सारवास्तथा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006150056, "chapter_id": 26150, "verse_number": "१-२-११-५७", "content_sanskrit": "पुलिंदा विंध्यमौलीया वैदर्भा दंडकैः सह ।\nपौरिका मौलिकाश्चैव ्श्मका भोगवर्द्धिनाः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006150057, "chapter_id": 26150, "verse_number": "१-२-११-५८", "content_sanskrit": "कोंकणाः कंतलाश्चांध्राः कुलिन्दाङ्गारमारिषाः ।\nदाङिणाश्चैव ये देशा अपरांस्तान्निबोधत ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006150058, "chapter_id": 26150, "verse_number": "१-२-११-५९", "content_sanskrit": "सूर्य्यारकाः कलिवना दुर्गालाः कुन्तरौः सहः ।\nपौलेयाश्च किराताश्च रूपकास्तापकैः सह ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006150059, "chapter_id": 26150, "verse_number": "१-२-११-६०", "content_sanskrit": "तथा करीतयश्चैव सर्वे चैव करंधराः ।\nनासिकाश्चैव ये चान्ये ये चैवांतरनर्मदाः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006150060, "chapter_id": 26150, "verse_number": "१-२-११-६१", "content_sanskrit": "सहकच्छाः समाहेयाः सह सारस्वतैरपि ।\nकच्छिपाश्च सुराष्ट्राश्च आनर्ताश्चर्बुदैः सह ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006150061, "chapter_id": 26150, "verse_number": "१-२-११-६२", "content_sanskrit": "इत्येते अपरांताश्च श्रृणुध्वं विंध्यवासिनः ।\nमलदाश्च करूथाश्च मेकलाश्चैत्कलैः सह ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006150062, "chapter_id": 26150, "verse_number": "१-२-११-६३", "content_sanskrit": "उत्तमानां दशार्णाश्च भोजाः किष्किंधकैः सह ।\nतोशलाः कोशलाश्चैव त्रैपुरा वैदिशास्तथा ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006150063, "chapter_id": 26150, "verse_number": "१-२-११-६४", "content_sanskrit": "तुहुण्डा बर्बराश्चैव षट्पुरा नैषधैः सह ।\nअनूपास्तुंडिकेराश्च वीतिहोत्रा ह्यवंतयः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006150064, "chapter_id": 26150, "verse_number": "१-२-११-६५", "content_sanskrit": "एते जनपदाः सर्वे विंध्यपृष्ठनिवासिनः ।\nअतो देशान्प्रवक्ष्यामि पर्वताश्रयिणश्च ये ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006150065, "chapter_id": 26150, "verse_number": "१-२-११-६६", "content_sanskrit": "निहीरा हंसमार्गाश्च कुपथास्तंगणाः शकाः ।\nअपप्राव रणाश्चैव ऊर्णा दर्वाः सहूहुकाः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006150066, "chapter_id": 26150, "verse_number": "१-२-११-६७", "content_sanskrit": "त्रिगर्त्ता मंडलाश्चैव किरातास्तामरैः सह ।\nचत्वारि भारते वर्षे युगानि ऋषयोऽब्रुवन् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006150067, "chapter_id": 26150, "verse_number": "१-२-११-६८", "content_sanskrit": "कृतं त्रेतायुगं चैव द्वापरं तिष्यमेव च ।\nतेषां निसर्गं वक्ष्यामि उपरिष्टादशेषतः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]