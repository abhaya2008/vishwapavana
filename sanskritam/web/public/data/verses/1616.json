[{"id": 2028425, "chapter_id": 1616, "verse_number": "३-२५४-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2028426, "chapter_id": 1616, "verse_number": "३-२५४-१", "content_sanskrit": "एवं गतेषु पार्थेषु वने तस्मिन्महात्मसु।\nधार्तराष्ट्रा महेष्वासाः किमकुर्वत सत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2028427, "chapter_id": 1616, "verse_number": "३-२५४-२", "content_sanskrit": "कर्णो वैकर्तनश्चैव शकुनिश्च महाबलः।\nभीष्मद्रोणकृपाश्चैव तन्मे शंसितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2028428, "chapter_id": 1616, "verse_number": "३-२५४-३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2028429, "chapter_id": 1616, "verse_number": "३-२५४-३", "content_sanskrit": "एवं गतेषु पार्थेषु विसृष्टे च सुयोधने।\nआगते हास्तिनपुरं मोक्षिते पाण्डुनन्दनैः।\nभीष्मोऽब्रवीन्महाराज धार्तराष्ट्रमिदं वच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2028430, "chapter_id": 1616, "verse_number": "३-२५४-४", "content_sanskrit": "उक्तं तात मया पूर्वं गच्छतस्ते तपोवनम्।\nवचनं ते न रुचितं मम तन्न कृतं च ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2028431, "chapter_id": 1616, "verse_number": "३-२५४-५", "content_sanskrit": "ततः प्राप्तं त्वया वीर ग्रहणं शत्रुभिर्बलात्।\nमोक्षितश्चासि धर्मज्ञैः पाण्डवैर्न च लज्जसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2028432, "chapter_id": 1616, "verse_number": "३-२५४-६", "content_sanskrit": "प्रत्यक्षं तव गान्धारे ससैन्यस् विशांपते।\nसूतपुत्रोऽपयाद्भीतो गन्धर्वाणां तदा रणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2028433, "chapter_id": 1616, "verse_number": "३-२५४-७", "content_sanskrit": "क्रोशतस्तव राजेन्द्र ससैन्यस्य नृपात्मज।\n`व्यपायात्पृष्ठतस्तस्मात्प्रेक्षमाणः पुनःपुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2028434, "chapter_id": 1616, "verse_number": "३-२५४-८", "content_sanskrit": "दृष्टस्ते विक्रमश्चैव पाण्डवानां महात्मनाम्।\nकर्णस्य च महाबाहो सूतपुत्रस्य दुर्मते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2028435, "chapter_id": 1616, "verse_number": "३-२५४-९", "content_sanskrit": "न चापि पादभाक्कर्णः पाण्डवानां महात्मनाम्।\nधनुर्वेदे च शौर्ये च धर्मे वा धर्मवत्सल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2028436, "chapter_id": 1616, "verse_number": "३-२५४-१०", "content_sanskrit": "तस्मादहं क्षमं मन्ये पाण्डवैस्तैर्महात्मभिः।\nरसन्धिं सन्धिविदांश्रेष्ठ कुलस्यास्य विवृद्धये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2028437, "chapter_id": 1616, "verse_number": "३-२५४-११", "content_sanskrit": "एवमुक्तश्च भीष्मेण धार्तराष्ट्रो जनेश्वरः।\nप्रहस्य सहसा राजन्विप्रतस्थे ससौबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2028438, "chapter_id": 1616, "verse_number": "३-२५४-१२", "content_sanskrit": "तं तु प्रस्थितमाज्ञाय कर्णदुःशासनादयः।\nअनुजग्मुर्महेष्वासा धार्तराष्ट्रं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2028439, "chapter_id": 1616, "verse_number": "३-२५४-१३", "content_sanskrit": "तांस्तु संप्रस्थितान्दृष्ट्वा भीष्मः कुरुपितामहः।\nलज्जया व्रीडितो राजञ्जगाम स्वं निवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2028440, "chapter_id": 1616, "verse_number": "३-२५४-१४", "content_sanskrit": "गते भीष्मे महाराज धार्तराष्ट्रो जनेश्वरः।\nपुनरागम्य तं देशममन्त्रयत मन्त्रिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2028441, "chapter_id": 1616, "verse_number": "३-२५४-१५", "content_sanskrit": "किमस्माकं भवेच्छ्रेयः किं कार्यमवशिष्यते।\nकथं च सुकृतं तत्स्यान्मन्त्रयामास भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2028442, "chapter_id": 1616, "verse_number": "३-२५४-१६x", "content_sanskrit": "[*कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2028443, "chapter_id": 1616, "verse_number": "३-२५४-१६", "content_sanskrit": "दुर्योधन निबोधेदं यत्त्वां वक्ष्यामि कौरव।\nभीष्मोस्मान्निन्दति सदा पाण्डवांश्च प्रशंसति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2028444, "chapter_id": 1616, "verse_number": "३-२५४-१७", "content_sanskrit": "त्वद्वेषाच्च महाबाहो मामपि द्वेष्टुमर्हति।\nविगर्हते च मां नित्यं त्वत्समीपे नरेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2028445, "chapter_id": 1616, "verse_number": "३-२५४-१८", "content_sanskrit": "सोऽहं भीष्मवचस्तद्वै न मृष्यामीह भारत।\nत्वत्समं यदुक्तं च भीष्मेणामित्रकर्शन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2028446, "chapter_id": 1616, "verse_number": "३-२५४-१९", "content_sanskrit": "पाण्डवानां यशो राजंस्तव निन्दां च भारत।\nअनुजानीहि मां राजन्सभृत्यबलवाहनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2028447, "chapter_id": 1616, "verse_number": "३-२५४-२०", "content_sanskrit": "जेष्यामि पृथिवीं राजन्सशैलवनकाननाम्।\nजिता च पाण्डवैर्भूमिश्चतुर्भिर्बलशालिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2028448, "chapter_id": 1616, "verse_number": "३-२५४-२१", "content_sanskrit": "तामहं ते विजेष्यामि एक एव न संशयः।\nसंपश्यतु सुदुर्बुद्धिर्भीष्मः कुरुकुलाधमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2028449, "chapter_id": 1616, "verse_number": "३-२५४-२२", "content_sanskrit": "अनिन्द्यं निन्दते यो हि अप्रशंस्यं प्रशंसति।\nस पश्यतु बलं मेऽद्य आत्मानं तु विगर्हतु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2028450, "chapter_id": 1616, "verse_number": "३-२५४-२३", "content_sanskrit": "अनुजानीहि मां राजन्ध्रुवो हि विजयस्तव।\nप्रतिजानामि ते सत्यं राजन्नायुधमालभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2028451, "chapter_id": 1616, "verse_number": "३-२५४-२४", "content_sanskrit": "तच्छ्रुत्वा तु वचो राजन्कर्णस्य भरतर्षभ।\nप्रीत्या परमया युक्तः कर्णमाह नराधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2028452, "chapter_id": 1616, "verse_number": "३-२५४-२५", "content_sanskrit": "धन्योस्म्यनुगृहीतोस्मि यस्य मे त्वं महाबलः।\nहितेषु वर्तसे नित्यं सफलंजन्म चाद्य मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2028453, "chapter_id": 1616, "verse_number": "३-२५४-२६", "content_sanskrit": "यदा च मन्यसे वीर सर्वशत्रुनिबर्हणम्।\nतदा निर्गच्छ भद्रं ते ह्यनुशाधि च मामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2028454, "chapter_id": 1616, "verse_number": "३-२५४-२७", "content_sanskrit": "एवमुक्तस्तदा कर्णो धार्तराष्ट्रेण धीमता।\nसर्वमज्ञापयामास प्रायात्रिकमरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2028455, "chapter_id": 1616, "verse_number": "३-२५४-२८", "content_sanskrit": "प्रययौ च महेष्वासो नक्षत्रे शुभदैवते।\nशुभेतिथौ मुहूर्ते च पुज्यमानो द्विजातिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2028456, "chapter_id": 1616, "verse_number": "३-२५४-२९", "content_sanskrit": "मङ्गलैश्च शुभैः स्नातो वाग्भिश्चापि प्रपूजितः।\nनादयन्रथघोषेण त्रैलोक्यं सचराचरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2028457, "chapter_id": 1616, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि घोषयात्रापर्वणि चतुःपञ्चासदधिकद्विशततमोऽध्यायः ॥ २५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]