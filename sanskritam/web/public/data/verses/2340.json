[{"id": 2062952, "chapter_id": 2340, "verse_number": "८-६१-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2062953, "chapter_id": 2340, "verse_number": "८-६१-१", "content_sanskrit": "तेषां प्रवृत्ते सङ्ग्रामे विपुले शोणितोदके।\nरराज लोहितेनोर्वी संसिक्ता बहुधा भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2062954, "chapter_id": 2340, "verse_number": "८-६१-२", "content_sanskrit": "ततो रजसि संशान्ते प्रकाशः सर्वतोऽभवत्।\nएतस्मिन्नन्तरे पार्थं कृष्णो वचनमब्रवीत्।\nदर्शयन्निव कौन्तेयं धर्मराजं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2062955, "chapter_id": 2340, "verse_number": "८-६१-३", "content_sanskrit": "एष पाण्डव ते भ्राता धार्तराष्ट्रैर्महाबलैः।\nजिघांसुभिर्महेष्वासैः शीघ्रं पार्थोऽनुसार्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2062956, "chapter_id": 2340, "verse_number": "८-६१-४", "content_sanskrit": "तमन्वगेव पाञ्चालाश्चेदिमात्स्याश्च भारत।\nअनुयान्ति महात्मानं परीप्सन्तो महाजवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2062957, "chapter_id": 2340, "verse_number": "८-६१-५", "content_sanskrit": "एष दुर्योधनः पार्थ गजानीकेन दंशितः।\nराजा सर्वस्य लोकस्य राजानमनुधावति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2062958, "chapter_id": 2340, "verse_number": "८-६१-६", "content_sanskrit": "जिघांसुः पुरुषव्याघ्रं भ्रातृभिः सहितो बली।\nआशीविषसमस्पर्शैः सर्वायुधविशारदैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2062959, "chapter_id": 2340, "verse_number": "८-६१-७", "content_sanskrit": "नदद्भिः सिंहनादांश्च धमद्भिश्चापि वारिजान्।\nबलवद्भिर्महेष्वासैर्विधून्वानैर्धनूंषि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2062960, "chapter_id": 2340, "verse_number": "८-६१-८", "content_sanskrit": "एते जिघृक्षवो यान्ति द्विपाश्वरथपत्तयः।\nयुधिष्ठिरं धार्तराष्ट्रो रत्नोत्तममिवार्थिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2062961, "chapter_id": 2340, "verse_number": "८-६१-९", "content_sanskrit": "पश्य सात्वतभीमाभ्यां निरुद्धा विष्ठिताः पुनः।\nजिहीर्षवोऽमृतं दैत्याः शक्राग्निभ्यामिवाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2062962, "chapter_id": 2340, "verse_number": "८-६१-१०", "content_sanskrit": "एते बहुत्वात्त्वरिताः पुनर्गच्छन्ति पाण्डवम्।\nसमुद्रमिव वार्योघाः प्रावृट्काले महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2062963, "chapter_id": 2340, "verse_number": "८-६१-११", "content_sanskrit": "मृत्योर्मुखगतं मन्ये कुन्तीपुत्रं युधिष्ठिरम्।\nहुतमग्नौ च कौन्तेयं दुर्योधनवशं गतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2062964, "chapter_id": 2340, "verse_number": "८-६१-१२", "content_sanskrit": "यथायुक्तमनीकं हि धार्तराष्ट्रस्य पाण्डव।\nनास्य शक्रोऽपि मुच्येत सम्प्राप्तो बाणगोचरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2062965, "chapter_id": 2340, "verse_number": "८-६१-१३", "content_sanskrit": "दुर्योधनस्य वीरस्य शरौघाञ्शीघ्रमस्यतः।\nसङ्क्रुद्धस्यान्तकस्येव को वेगं संसहेद्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2062966, "chapter_id": 2340, "verse_number": "८-६१-१४", "content_sanskrit": "रसतस्तस्य वीरस्य द्रौणेः शारद्वतस्य च।\nकर्णस्य चेषुवेगो वै पर्वतानपि शातयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2062967, "chapter_id": 2340, "verse_number": "८-६१-१५", "content_sanskrit": "कर्णेन च कृतो राजा विमुखोऽद्य तु दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2062968, "chapter_id": 2340, "verse_number": "८-६१-१६", "content_sanskrit": "बलवाँल्लुघुहस्तश्च कृती युद्धविशारदः।\nराधेयः पाण्डवश्रेष्ठं शक्तः पीडयितुं रणे।\nसहितो धृतराष्ट्रस्य पुत्रैः शूरैर्महाबलैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2062969, "chapter_id": 2340, "verse_number": "८-६१-१७", "content_sanskrit": "तस्यैभिर्युध्यमानस्य सङ्ग्रामे शंसितात्मनः।\nअन्यैरपि च पार्थस्य कृतं कर्म महारथैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2062970, "chapter_id": 2340, "verse_number": "८-६१-१८", "content_sanskrit": "उपवासकृशो राजा भृशं भरतसत्तमः।\nब्राह्मो बले स्थितो ह्येष न क्षात्रे हि बले विभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2062971, "chapter_id": 2340, "verse_number": "८-६१-१९", "content_sanskrit": "कर्णेन चाभियुक्तोऽयं भूपतिः शत्रुतापनः।\nसंशयं समनुप्राप्तः पाण्डवो वै युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2062972, "chapter_id": 2340, "verse_number": "८-६१-२०", "content_sanskrit": "न जीवति महाराजो मन्ये पार्थ युधिष्ठिरः।\nयद्भीमसेनः सहते सिंहनादममर्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2062973, "chapter_id": 2340, "verse_number": "८-६१-२१", "content_sanskrit": "नर्दतां धार्तराष्ट्राणां पुनःपुनररिन्दमः।\nधमतां च महाशङ्खान्सङ्ग्रामे जितकाशिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2062974, "chapter_id": 2340, "verse_number": "८-६१-२२", "content_sanskrit": "युधिष्ठिरं पाण्डवेयं हतेति भरतर्षभ।\nसञ्चोदयत्यसौ कर्णो धार्तराष्ट्रान्महाबलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2062975, "chapter_id": 2340, "verse_number": "८-६१-२३", "content_sanskrit": "स्थूणाकर्णास्त्रजालेन पार्थ पाशुपतेन च।\nप्रच्छादयन्ति राजानमनुयान्ति महारथाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2062976, "chapter_id": 2340, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे एकषष्टितमोऽध्यायः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]