[{"id": 2205851, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2205852, "chapter_id": 5386, "verse_number": "१", "content_sanskrit": "अनपत्याः स्त्रियो देवि जायन्ते केन कर्मणा ।\nएतदिच्छामि विज्ञातुं तत्त्वेनाम्बुजलोचने\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2205853, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2205854, "chapter_id": 5386, "verse_number": "२", "content_sanskrit": "या नारी कुरुतेऽनिष्टमपत्यानां विशेषतः ।\nतिरश्चामृतुकालेषु नारीणामुत्सवेषु च\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2205855, "chapter_id": 5386, "verse_number": "३", "content_sanskrit": "सा गत्वा नरकं नारी तिर्यग्योनिषु जायते ।\nतिर्यग्योनिप्रसूताऽपि स्वमपत्यं न पश्यति\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2205856, "chapter_id": 5386, "verse_number": "४", "content_sanskrit": "दासभावे च साऽवन्यां मानुष्यं पुनरागता ।\nएतत् ते सर्वमाख्यातं किं भूयः श्रोतुमिच्छसि\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2205857, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2205858, "chapter_id": 5386, "verse_number": "५", "content_sanskrit": "ब्राह्मणी क्षत्रिया वैश्या या चान्यापि महाकुला ।\nकेन कर्मविपाकेन दासीत्वमुपगच्छति\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2205859, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2205860, "chapter_id": 5386, "verse_number": "६", "content_sanskrit": "दासीत्वस्य परो नास्ति दासत्वेऽपि तथैव च ।\nतथापि ते प्रवक्ष्यामि श्रूयतां गुरुपुङ्गव\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2205861, "chapter_id": 5386, "verse_number": "७", "content_sanskrit": "प्राप्नुवन्ति स्म दोषेण पुरा दुश्चरितैः स्त्रियः ।\nमद्यपानरता नारी सदा च्छिद्रगवेषिणी\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2205862, "chapter_id": 5386, "verse_number": "८", "content_sanskrit": "सुवर्णमणिमुक्ताश्च वस्त्राण्याभरणानि च ।\nपरेषां हरणं कृत्वा या तुष्टिमुपगच्छति\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2205863, "chapter_id": 5386, "verse_number": "९", "content_sanskrit": "सा मृता नरकं याति तिर्यग्योनीश्च गच्छति ।\nतत्रापकारं कुर्वन्तीं महादेव प्रसूतिभिः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2205864, "chapter_id": 5386, "verse_number": "१०", "content_sanskrit": "मोहयत्यात्मनाऽऽत्मानं परद्रव्यापहारिणी ।\nअथ मानुषतामेति कदाचित् कालपर्ययात्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2205865, "chapter_id": 5386, "verse_number": "११", "content_sanskrit": "ब्रह्मक्षत्रे प्रसूताऽपि दासीत्वमुपगच्छति ।\nतस्या न तुष्यति स्वामी कृतैः कर्मशतैरपि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2205866, "chapter_id": 5386, "verse_number": "१२", "content_sanskrit": "नित्यं मृष्टगृहा चैव भयोद्विग्नमनाः सदा ।\nन निर्वृतिमवाप्नोति सततं दुःखभागिनी\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2205867, "chapter_id": 5386, "verse_number": "१३", "content_sanskrit": "अजस्रं कर्मणा चैव प्रसवोपचरेण च ।\nमोक्षयत्यात्मनाऽऽत्मानं परद्रव्यापहारिणी\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2205868, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2205869, "chapter_id": 5386, "verse_number": "१४", "content_sanskrit": "दासयोनिप्रसूतानां सौख्यमुत्पद्यते कथम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2205870, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2205871, "chapter_id": 5386, "verse_number": "१५", "content_sanskrit": "सुवर्णमणिमुक्ताश्च वस्त्राण्याभरणानि च ।\nभोगभूता विशिष्टा ये गन्धमाल्यादयः शुभाः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2205872, "chapter_id": 5386, "verse_number": "१६", "content_sanskrit": "रतिरागविधिज्ञैश्च सततं वशवर्तिनी ।\nरूपानुरूपैः पुरुषैः रमते शयने शुभे\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2205873, "chapter_id": 5386, "verse_number": "१७", "content_sanskrit": "अथवा सा भवेद् भार्या राज्ञो राजोपमस्य वा ।\nएतत् ते सर्वमाख्यातं किं भूयः श्रोतुमिच्छसि\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2205874, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2205875, "chapter_id": 5386, "verse_number": "१८", "content_sanskrit": "उत्पन्नाश्चान्त्यदेशेषु यवनादिषु योषितः ।\nकेन कर्मविपाकेन दासीत्वं यान्ति सुन्दरि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2205876, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2205877, "chapter_id": 5386, "verse_number": "१९", "content_sanskrit": "उच्छिष्टाहारबहुळाः सततं शौचवर्जिताः ।\nभिक्षां ददति चाज्ञानां कुर्वन्ति बलिकर्म च\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2205878, "chapter_id": 5386, "verse_number": "२०", "content_sanskrit": "मद्यपाने प्रसक्ताश्च परस्वहरणेषु च ।\nएतैस्तु कर्मभिर्नार्यो जायन्ते निरयालयाः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2205879, "chapter_id": 5386, "verse_number": "२१", "content_sanskrit": "यदि मानुषतां प्राप्ताः कदाचित् कर्मणः क्षयात् ।\nनानाविधेषु म्लेच्छेषु जन्म तासां विधीयते\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2205880, "chapter_id": 5386, "verse_number": "२२", "content_sanskrit": "ताः स्वदेशाच्च्युता नार्यः परदेशमुपागताः ।\nदासीत्वमुपपद्यन्ते चोदिताः कर्मभिः स्वकैः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2205881, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "रुद्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2205882, "chapter_id": 5386, "verse_number": "२३", "content_sanskrit": "एतेष्वेव च म्लेच्छेषु कर्मणा केन शोभने ।\nकुलीनाश्च समृद्धाश्च जायन्ते प्रमदोत्तमाः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2205883, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2205884, "chapter_id": 5386, "verse_number": "२४", "content_sanskrit": "या नारी विपुळं भोगं ब्राह्मणेभ्यः प्रयच्छति ।\nआसनं शयनं यानं भोजनोपस्करं तथा\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2205885, "chapter_id": 5386, "verse_number": "२५", "content_sanskrit": "रत्नानि मणिमुक्ताश्च वस्त्राण्याभरणानि च ।\nगाः सुवर्णं च रूप्यं च मधुराणां रजस्वला\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2205886, "chapter_id": 5386, "verse_number": "२६", "content_sanskrit": "क्रोधाविष्टा च या दद्यात् शोचन्तं वापि दुःखिता ।\nएवंविधानां दानानां फलं म्लेच्छेषु भोज्यते\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2205887, "chapter_id": 5386, "verse_number": "२७", "content_sanskrit": "साशिका जायते चात्र महाकुलसमुद्भवा ।\nकोगीधनेशं(?) प्राप्नोति भर्तारं स्ववशानुगम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2205888, "chapter_id": 5386, "verse_number": "२८", "content_sanskrit": "म्लेच्छानां तु भवेद् राज्ञो भार्या राजोपमस्य वा ।\nएतत् ते सर्वमाख्यातं किम्भूयः श्रोतुमिच्छसि\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2205889, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2205890, "chapter_id": 5386, "verse_number": "२९", "content_sanskrit": "केन कर्मविपाकेन वेश्या स्त्री जायते पुमान्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2205891, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2205892, "chapter_id": 5386, "verse_number": "३०", "content_sanskrit": "चिरं सार्थंशया नारी चिन्तयन्ती बहून् नरान् ।\nयुज्यते कालधर्मेण वेश्यास्त्री सोपपद्यते\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2205893, "chapter_id": 5386, "verse_number": "३१", "content_sanskrit": "वेश्या तु निवसन्ती या स्वेप्सितं प्राप्य वेतनम् ।\nसुरूपेपि विरूपे च सुभगे दुर्भगे तथा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2205894, "chapter_id": 5386, "verse_number": "३२", "content_sanskrit": "समृद्धे च दरिद्रे च दुष्कुले च कुलान्विते ।\nयौवनस्थे च वृद्धे च वस्तव्याऽऽगन्तुकेषु च\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2205895, "chapter_id": 5386, "verse_number": "३३", "content_sanskrit": "समोपचारा सर्वत्र सर्वेषां वशवर्तिनी ।\nएवं शीलसमाचारा देवलोके महीयते\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2205896, "chapter_id": 5386, "verse_number": "३४", "content_sanskrit": "सुकृतेनात्मनः पूता चन्द्रवद् भाति निर्मला ।\nयदि चेन्मानुषे लोके कदाचिदुपपद्यते\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2205897, "chapter_id": 5386, "verse_number": "३५", "content_sanskrit": "रूपवान् सुभगश्चैव समृद्धो जायते पुमान् ।\nएतत् ते सर्वमाख्यातं किं भूयः श्रोतुमिच्छसि\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2205898, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "रुद्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2205899, "chapter_id": 5386, "verse_number": "३६", "content_sanskrit": "राजकापगकारीषु(?) लम्बिकासु नदीषु च ।\nडाकिनीषु वरारोहे जायन्ते योषितः कथम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2205900, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "पार्वती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2205901, "chapter_id": 5386, "verse_number": "३७", "content_sanskrit": "मद्यपानरता नारी पैशुन्यकलहप्रदा ।\nन शुश्रूषति भर्तारं गृहेषु गृहदेवताः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2205902, "chapter_id": 5386, "verse_number": "३८", "content_sanskrit": "न सम्मार्ष्टि गृहं चैव न करोत्यनुलेपनम् ।\nन करोति बलिं भिक्षां न ददाति कदाचन\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2205903, "chapter_id": 5386, "verse_number": "३९", "content_sanskrit": "न दद्यादतिथिभ्यश्च नृशंसा शंसवर्जिता ।\nप्रतिकूला च या भर्तुः भृत्यवर्गेषु निर्घृणा\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2205904, "chapter_id": 5386, "verse_number": "४०", "content_sanskrit": "आत्मनः पोषिका नित्यं संविभागविवर्जिता ।\nएवंशीलसमाचारा सा नारी नरकं व्रजेत्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2205905, "chapter_id": 5386, "verse_number": "४१", "content_sanskrit": "यदि चेन्मानुषे लोके कदाचिदुपजायते ।\nपापयोनिषु जायेत दैवपित्र्यविवर्जिता\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2205906, "chapter_id": 5386, "verse_number": "४२", "content_sanskrit": "राजकापगकारीषु लम्बिकासु नदीषु च ।\nडाकिनीषु च सर्वासु जन्म तस्या विधीयते\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2205907, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "रुद्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2205908, "chapter_id": 5386, "verse_number": "४३", "content_sanskrit": "व्याधी वा गुरुमातङ्गी चण्डाली मांसिकापि वा ।\nजायन्ते कर्मणा केन स्त्रियः स्त्रीजनपूजिते\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2205909, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2205910, "chapter_id": 5386, "verse_number": "४४", "content_sanskrit": "या नारी पतिमुत्सृज्य अन्यस्मिन् कुरुते मनः ।\nपत्यौका विगतस्नेहा अन्येषु रमतेऽशुभा\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2205911, "chapter_id": 5386, "verse_number": "४५", "content_sanskrit": "राजस्नेहानुरागेण भर्तारं द्वेष्टि या स्वकम् ।\nपतिं वैकलयोगैर्वा विषैर्वा मूलकर्मणा\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2205912, "chapter_id": 5386, "verse_number": "४६", "content_sanskrit": "निष्णाता मृत्युभिश्चैतैरायुधैर्वापि पातयेत् ।\nएवंकृतिस्तु या घोरा नारी नरकनिर्भया\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2205913, "chapter_id": 5386, "verse_number": "४७", "content_sanskrit": "अगाधमप्लवं घोरं नरकं याति सा मृता ।\nयदि चेन्मानुषे लोके जायते कर्मणः क्षयात्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2205914, "chapter_id": 5386, "verse_number": "४८", "content_sanskrit": "व्याधी वा गुरुमातङ्गी चण्डाली मांसिकासु च ।\nयोनिष्वेवं प्रकारासु जन्म तस्या विधीयते\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2205915, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2205916, "chapter_id": 5386, "verse_number": "४९", "content_sanskrit": "भर्तुरेव सुतानां च भ्रातॄणामथवा पुनः ।\nवधं बन्धं च पश्यन्ति कर्मणा केन योषितः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2205917, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2205918, "chapter_id": 5386, "verse_number": "५०", "content_sanskrit": "विनापराधात् तिर्यक्षु रण्डा संयम्य निर्घृणा ।\nप्रहारव्यथितं कुर्यान्नारी नरकनिर्भया\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2205919, "chapter_id": 5386, "verse_number": "५१", "content_sanskrit": "हन्यमानं तथाऽन्यैस्तं दृष्ट्वा चैवाभिनन्दति ।\nनरकेषु चिरं स्थित्वा तिर्यग्योनित्वमृच्छति\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2205920, "chapter_id": 5386, "verse_number": "५२", "content_sanskrit": "वधबन्धप्रहारांश्च तिर्यक्त्वे च लभेत च ।\nयदि चेन्मानुषे लोके कदाचिदुपजायते\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2205921, "chapter_id": 5386, "verse_number": "५३", "content_sanskrit": "वधं बन्धं च भ्रातॄणां भर्तुश्चैव सुतस्य च ।\nमातुः पितुश्च पश्यन्ति पुरा दुश्चरितस्त्रियः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2205922, "chapter_id": 5386, "verse_number": "५४", "content_sanskrit": "तन्निमित्तो मनस्तापो अग्निदाहसमश्चिरम् ।\nकर्मणः स्वस्य पापस्य विपाको भुज्यते भुवि\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2205923, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2205924, "chapter_id": 5386, "verse_number": "५५", "content_sanskrit": "अल्पायुषः स्त्रियो देवि जायन्ते केन कर्मणा ।\nव्याधिभिश्चैव क्लिश्यन्ते श्रोतुमिच्छामि तत्त्वतः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2205925, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2205926, "chapter_id": 5386, "verse_number": "५६", "content_sanskrit": "सर्वभूतानि या नारी सततं हन्ति निर्दया ।\nसाधुघ्नी वा कृतघ्नी वा नारी नरकनिर्भया\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2205927, "chapter_id": 5386, "verse_number": "५७", "content_sanskrit": "विषदा गरदा चैव सततं साहसप्रिया ।\nगर्भान्निपातयेच्चापि परस्त्रीणामथात्मनः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2205928, "chapter_id": 5386, "verse_number": "५८", "content_sanskrit": "अधर्मे रमते चापि पापबुद्धिसमन्विता ।\nनरके सा चिरं स्थित्वा तिर्यग्योनिषु जायते\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2205929, "chapter_id": 5386, "verse_number": "५९", "content_sanskrit": "तिर्यग्योनौ च सा देव यत्र यत्रोपजायते ।\nतत्र तत्र न सन्देहो जातमात्रा वियुज्यते\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2205930, "chapter_id": 5386, "verse_number": "६०", "content_sanskrit": "यदि चेन्मानुषे लोके कदाचिदुपपद्यते ।\nगर्भे मृत्युमवाप्नोति बाल्ये वाऽप्यथ यौवने\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2205931, "chapter_id": 5386, "verse_number": "६१", "content_sanskrit": "व्यतीते यौवने वापि कालधर्मेण युज्यते ।\nव्याधिभिश्चैव बहुभिः पुरादुश्चरितैश्चिरम्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2205932, "chapter_id": 5386, "verse_number": "६२", "content_sanskrit": "शयनासनभोगेषु निर्वृतिं सा न विन्दति ।\nवेदनार्ता विपद्येत किं भूयः श्रोतुमिच्छसि\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2205933, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "रुद्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2205934, "chapter_id": 5386, "verse_number": "६३", "content_sanskrit": "केन कर्मविपाकेन क्लिश्यन्ते कुलजाः स्त्रियः ।\nकुभोजनाः कुचेलाश्च दीनाः कृपणजीविकाः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2205935, "chapter_id": 5386, "verse_number": "६४", "content_sanskrit": "प्राप्नुवन्ति च निर्वेदं दुःखिताः प्रव्रजन्ति च ।\nप्रायोपवेशनं चैव रज्जूमग्निप्रवेशनम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2205936, "chapter_id": 5386, "verse_number": "६५", "content_sanskrit": "मरुप्रपतनं चैव काङ्क्षन्ते केन कर्मणा ।\nएतदिच्छामि विज्ञातुं ब्रूहि मे वरवर्णिनि\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2205937, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2205938, "chapter_id": 5386, "verse_number": "६६", "content_sanskrit": "कूटका पटिका नारी सत्यार्जवविवर्जिता ।\nधर्मविद्वेषिणी नित्यं दानव्याघातकारिका\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2205939, "chapter_id": 5386, "verse_number": "६७", "content_sanskrit": "व्रतोपवासहीना च दैवपैत्रविवर्जिता ।\nउच्छिन्दकं याचितकं न्यासं निक्षेपमेव च\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2205940, "chapter_id": 5386, "verse_number": "६८", "content_sanskrit": "शक्तिद्वयाद्(?) वा शाठ्याद् वा लोभान्मोहात् तथापि वा ।\nयाचमाना स्वकं द्रव्यं न तद् दापयतीह सा\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2205941, "chapter_id": 5386, "verse_number": "६९", "content_sanskrit": "अनेन कर्मणा नारी जायते नरकालया ।\nयदि चेन्मानुषे लोके कदाचिदुपपद्यते\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2205942, "chapter_id": 5386, "verse_number": "७०", "content_sanskrit": "क्षीणद्रव्ये तथा नारी सम्भूताऽथ महाकुले ।\nप्राप्नोत्यपि च भर्तारं दरिद्रं क्लेशभागिनम्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2205943, "chapter_id": 5386, "verse_number": "७१", "content_sanskrit": "एवं दरिद्रतां प्राप्य क्लिश्यते हि कुलाङ्गना ।\nक्रन्दना च कुचेला च कुलकर्मासमाश्रिता\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2205944, "chapter_id": 5386, "verse_number": "७२", "content_sanskrit": "परेषां गृहमासाद्य परपिण्डोपजीविका ।\nप्राप्नोति क्लेशमखिलं क्षपन्ती शीलमात्मनः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2205945, "chapter_id": 5386, "verse_number": "७३", "content_sanskrit": "अशौचदासभावेन परच्छन्दानुवर्तिनी ।\nमातापितृवियोगेन भर्तुश्च मरणेन च\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2205946, "chapter_id": 5386, "verse_number": "७४", "content_sanskrit": "दारिद्र्येण च क्लिश्यन्ती अपत्यमरणेन च ।\nदौर्भाग्यवधबन्धेन ईर्ष्याक्रोधवशेन च\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2205947, "chapter_id": 5386, "verse_number": "७५", "content_sanskrit": "दुःखैरिहैव चान्यैश्च यदा निर्वेदमागता ।\nतदा प्रव्रजिता नारी प्रविशेद्वा हुताशनम्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2205948, "chapter_id": 5386, "verse_number": "७६", "content_sanskrit": "कुर्यात् प्रायोपवेशं वा मरुप्रपतनं तथा ।\nरज्जूं वाप्यथ गृह्णाति मृत्युं वाऽन्यं समाश्रयेत्\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2205949, "chapter_id": 5386, "verse_number": "७७", "content_sanskrit": "एवमेतान्यवाप्यन्ते दुःखान्यमरनन्दन\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2205950, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "ईश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2205951, "chapter_id": 5386, "verse_number": "७८", "content_sanskrit": "नारीणां देहवैकल्यं कर्मणा केन जायते ।\nसर्वमर्हसि मे वक्तुं सर्वदेवनमस्कृते\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2205952, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2205953, "chapter_id": 5386, "verse_number": "७९", "content_sanskrit": "या वदत्यनृतं नारी सत्यार्जवविवर्जिता ।\nमानस्तब्धाऽवनाश्चैव भर्तारं चावमन्यते\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2205954, "chapter_id": 5386, "verse_number": "८०", "content_sanskrit": "पतिमभ्यागतं दृष्ट्वा ब्राह्मणं श्वशुरं तथा ।\nन समभ्येति या नारी प्रददाति न चासनम्\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2205955, "chapter_id": 5386, "verse_number": "८१", "content_sanskrit": "सुखोपविष्टा तूष्णींश्च रूपयौवनगर्विता ।\nभर्त्रा चापि विरुद्ध्येत नित्यमप्रियवादिनी\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2205956, "chapter_id": 5386, "verse_number": "८२", "content_sanskrit": "यदा सुरविरुद्धा च सततं कलहप्रिया ।\nएवंशीलसमाचारा क्षिप्रं नरकमाव्रजेत्\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2205957, "chapter_id": 5386, "verse_number": "८३", "content_sanskrit": "यदि चेन्मानुषे लोके कदाचिदुपपद्यते ।\nदेहवैकल्यमाप्नोति रण्डा षण्डापि वा भवेत्\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2205958, "chapter_id": 5386, "verse_number": "८४", "content_sanskrit": "जडान्धबधिरा मूका एकपक्षहतापि वा ।\nकराळदन्ती लम्बोष्ठी चला वाऽव्यक्तभाषिणी\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2205959, "chapter_id": 5386, "verse_number": "८५", "content_sanskrit": "विकलाङ्गा विरूपा च कुब्जा च विकलानना ।\nअथवा नासिकोष्ठस्य दीने(?) च्छेदनमाप्नुयात्\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2205960, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2205961, "chapter_id": 5386, "verse_number": "८६", "content_sanskrit": "अलङ्कारमहं स्त्रीणां श्रोतुमिच्छामि शोभने ।\nउत्सवे व्यसने च स्याद् येन नित्यमलङ्कृता\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2205962, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2205963, "chapter_id": 5386, "verse_number": "८७", "content_sanskrit": "सुवर्णमणिमुक्ताश्च वस्त्राण्याभरणानि च ।\nआनीयमेतद् भवति भगवन् स्त्रीजनस्य तु\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2205964, "chapter_id": 5386, "verse_number": "८८", "content_sanskrit": "विभूषणं रक्षणीयं चोरेभ्यः सर्वतो भयात् ।\nभूषणानां तु सर्वेषां शृणु भूषणमुत्तमम्\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2205965, "chapter_id": 5386, "verse_number": "८९", "content_sanskrit": "व्रतं च भूषणं स्त्रीणां सुशीलश्च विभूषणम् ।\nवृद्धो विरूपो बीभत्सो निर्धनो विगुणस्तथा\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2205966, "chapter_id": 5386, "verse_number": "९०", "content_sanskrit": "निर्गुणस्तु तथैव स्यात् स्त्रीणां भूषणमुत्तमम् ।\nवैधव्यसदृशं दुःखं स्त्रीणां चैव न विद्यते\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2205967, "chapter_id": 5386, "verse_number": "९१", "content_sanskrit": "रत्नं गन्धश्च पुष्पं च सौख्यं बहुविधं तथा ।\nभर्त्रा वै विप्रयुक्तानां स्त्रीणां तज्जायते विषम्\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2205968, "chapter_id": 5386, "verse_number": "९२", "content_sanskrit": "मददर्पमनायासं रूपं वर्णं वपुः शुभम् ।\nनित्यं दासजनस्येक्षा धैर्यमप्रतियोषिताम्\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2205969, "chapter_id": 5386, "verse_number": "९३", "content_sanskrit": "तासां पुत्रेषु पौत्रेषु मातुळभ्रातृगौरवम् ।\nतथैव प्रत्ययस्नेहो वैधव्येन प्रणश्यति\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2205970, "chapter_id": 5386, "verse_number": "९४", "content_sanskrit": "संयोगे सहवासे च बन्धुवर्गसुहृज्जने ।\nप्रीतिः शिथिलतां याति विस्रम्भः प्रणयस्तथा\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2205971, "chapter_id": 5386, "verse_number": "९५", "content_sanskrit": "एवमादिषु दुःखेषु खिद्यन्ते विधवाः स्त्रियः ।\nनान्यद् दुःखतरं स्त्रीणां वैधव्येन समं भवेत् \t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2205972, "chapter_id": 5386, "verse_number": "९६", "content_sanskrit": "यदि कोटीधना नारी पुत्रैश्च बहुभिर्युता ।\nभर्त्रा वै विप्रयुक्ताया जीवितं मरणं स्मृतम्\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2205973, "chapter_id": 5386, "verse_number": "९७", "content_sanskrit": "गन्धमाल्यैरलङ्कारैर्वस्त्राभरणभूषणैः ।\nमहद्भिर्वापि रत्नौघैः विधवा किं करिष्यति\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2205974, "chapter_id": 5386, "verse_number": "९८", "content_sanskrit": "व्यपेतमण्डनस्नाना पुष्पभूषणवर्जिता ।\nश्रियं सखीनां पश्यन्ती जीवलोके मृतोपमा\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2205975, "chapter_id": 5386, "verse_number": "९९", "content_sanskrit": "नातन्त्री वाद्यते वीणा नाचक्रो वर्तते रथः ।\nनापतिः सुखमेधेत नारी बन्धुशतैरपि\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2205976, "chapter_id": 5386, "verse_number": "१००", "content_sanskrit": "नहि स्वच्छन्दतो द्रव्यं गृहं मातृकपैतृकम् ।\nउपभोक्तुं स्त्रियोऽर्हन्ति दातुं वाप्यथ कस्यचित्\t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2205977, "chapter_id": 5386, "verse_number": "१०१", "content_sanskrit": "स्वच्छन्दभोग्यं नारीणां भर्तुरेव धनं भवेत् ।\nद्रव्यं वा यदि वा धान्यम् ऋणं वापि च यद्भवेत्\t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2205978, "chapter_id": 5386, "verse_number": "१०२", "content_sanskrit": "मितं ददाति हि पिता मितं माता मितं सुताः ।\nअमितस्य च दातारं का पतिं नाभिनन्दति\t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2205979, "chapter_id": 5386, "verse_number": "१०३", "content_sanskrit": "तस्माद् भर्तृविहीनानां श्रेयान् मृत्युर्न जीवितम् ।\nएवमेते मया प्रोक्ताः स्त्रीधर्मास्त्रिदशेश्वर\t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2205980, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2205981, "chapter_id": 5386, "verse_number": "१०४", "content_sanskrit": "एवं वदन्तीं रुद्राणीं लज्जाभावसमन्विताम् ।\nतोषयामास देवेशो वाचा सञ्जनयन् प्रियम्\t॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2205982, "chapter_id": 5386, "verse_number": "१०५", "content_sanskrit": "ऋषयो देवगन्धर्वाः ससुराश्च सराक्षसाः ।\nदेवताप्रमदाश्चापि देवनद्यश्च सङ्गताः\t॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2205983, "chapter_id": 5386, "verse_number": "१०६", "content_sanskrit": "प्रणम्य शिरसा देवीं स्तुतिभिश्चभितुष्टुवुः ।\nपूजयामासुरपरे देवदेवं मुदा युताः\t॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2205984, "chapter_id": 5386, "verse_number": "१९७", "content_sanskrit": "अपारविस्मयान्यूचुस्तमर्थमभिचिन्त्य च ।\nसंहृष्टमनसः सर्वे संवादं चिन्तयन् मुहुः\t॥१९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2205985, "chapter_id": 5386, "verse_number": "१०८", "content_sanskrit": "तत्र तस्मिन् क्षणे देवो देवीं वचनमब्रवीत्\t॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2205986, "chapter_id": 5386, "verse_number": "१०९", "content_sanskrit": "शृणु कल्याणि मद्वाक्यं यदिदं तु त्वया मया ।\nकृतं संवादमभवत् त्रैलोक्यं तद् भविष्यति\t॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2205987, "chapter_id": 5386, "verse_number": "११०", "content_sanskrit": "ख्यातं पुण्यं पवित्रं च भविता च न संशयः ।\nय इदं श्रावयेद् विप्रान् संवादं चावयोः प्रिये\t॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2205988, "chapter_id": 5386, "verse_number": "१११", "content_sanskrit": "शुचिर्भूत्वा नरः प्राप्य(?) यज्ञस्य फलमाप्नुयात् ।\nयत्नतः शृणुयान्नित्यं धर्मं तद्गतमानसः\t॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2205989, "chapter_id": 5386, "verse_number": "११२", "content_sanskrit": "श्रवणादेव तेषां तु महद् धर्मफलं लभेत् ।\nकथयेच्छृणुयाद् वापि यत्किञ्चिन्नित्यमैहिकम् ।\nस भवेत् मत्प्रियो देवि तं स्मरामि दिने दिने\t॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2205990, "chapter_id": 5386, "verse_number": "११३", "content_sanskrit": "य इदं पठते नित्यं संवादं चावयोः शुभम् ।\nकीर्तिमायुष्यमारोग्यं परत्रेह च विन्दति\t॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 2205991, "chapter_id": 5386, "verse_number": "११४", "content_sanskrit": "श्रुत्वा चैव प्रयोक्ता तु कथं स न भवेन्महान् ।\nइत्युक्त्वा स तु देवेशः प्रतिगृह्य गिरेः सुताम्\t॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 2205992, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 2205993, "chapter_id": 5386, "verse_number": "११५", "content_sanskrit": "एतावदुक्त्वा देवर्षिर्नारदो विरराम ह ।\nतदद्य निखिलं सर्वं कथितं ते युधिष्ठिर\t॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 2205994, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 2205995, "chapter_id": 5386, "verse_number": "११६", "content_sanskrit": "धर्मराजस्तु तच्छ्रुत्वा भ्रातृभिर्मुदितोऽभवत् ।\nतत्सर्वं निखिलं चोक्तं तवेह जनमेजय\t॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 2205996, "chapter_id": 5386, "verse_number": "११७", "content_sanskrit": "शूद्रजात्यां प्रसूतस्य जिह्वाग्रे यस्य तिष्ठति ।\nशान्तिपर्वचतुर्थाभिः शूद्रः सम्पद्यते द्विजः\t॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 2205997, "chapter_id": 5386, "verse_number": "११८", "content_sanskrit": "वेदानामितिहासस्य सोपवेदाङ्गपारगः ।\nस हि मान्यश्च पूज्यश्च यथा विप्रः षडङ्गवित्\t॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 2205998, "chapter_id": 5386, "verse_number": "११९", "content_sanskrit": "धर्मेण शृणुयाद् यो हि पूज्यः शूद्रोऽपि शीलवान् ।\nअक्षयं लभते धर्मं शूद्रः शीलगुणान्वितः\t॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 2205999, "chapter_id": 5386, "verse_number": "१२०", "content_sanskrit": "शान्तिपर्वाधियानस्य श्रूयतां तस्य या गतिः ।\nकोटीशतसहस्रस्य वर्षाणां दिवि तिष्ठति\t॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 2206000, "chapter_id": 5386, "verse_number": "१२१", "content_sanskrit": "यदि चेन्मानुषे लोके कदाचिदुपपद्यते ।\nज्ञानविज्ञानसम्पन्ना भारतज्ञो भविष्यति ।\nतस्मात् सर्वेषु लोकेषु न भारतसमा श्रुतिः\t॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 2206001, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 2206002, "chapter_id": 5386, "verse_number": "१२२", "content_sanskrit": "इमे हि विप्राः सततं वेदाध्ययनतत्पराः ।\nकिन्नु वेदश्रुतिः पुण्या भारतं वा महाद्विज\t॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 2206003, "chapter_id": 5386, "verse_number": "१२३", "content_sanskrit": "ऊनतुल्याधिकत्वं वा वेदानां भारतस्य वा ।\nएतदिच्छामि विज्ञातुं भगवन् वक्तुमर्हसि\t॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}, {"id": 2206004, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 154}, {"id": 2206005, "chapter_id": 5386, "verse_number": "१२४", "content_sanskrit": "किं वा त्वं मन्यसे राजन् देवेभ्यो भारतं हविः ।\nभारतं पञ्चमो वेद इतिहास इति श्रुतिः\t॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 155}, {"id": 2206006, "chapter_id": 5386, "verse_number": "१२५", "content_sanskrit": "अनुग्रहार्थं वर्णानां व्यासेनामिततेजसा ।\nज्ञानमुत्पादितं ह्येतत् सर्वज्ञेनोत्तमं भुवि\t॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 156}, {"id": 2206007, "chapter_id": 5386, "verse_number": "१२६", "content_sanskrit": "ज्ञात्वा तु सर्वधर्मांश्च ज्ञास्यते निश्चितां मतिम् ।\nसर्ववर्णा गमिष्यन्ति तत्र मे नास्ति संशयः\t॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 157}, {"id": 2206008, "chapter_id": 5386, "verse_number": "१२७", "content_sanskrit": "सर्वे हि चैकतो वेदा भारतं चैकमेकतः ।\nपुरा देवैश्च दैत्यैश्च समेतैस्तुलया धृतम्\t॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 158}, {"id": 2206009, "chapter_id": 5386, "verse_number": "१२८", "content_sanskrit": "सरहस्यैस्तु विस्तीर्णैरतीतानागतैस्तथा ।\nयस्माच्छ्रुतिजनैरन्यैर्व्यासात्मगुणविस्तरैः\t॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 159}, {"id": 2206010, "chapter_id": 5386, "verse_number": "१२९", "content_sanskrit": "अतीत्य चतुरो वेदान् गुरुं जानीहि भारतम् ।\nतस्मात् त्रिष्वपि लोकेषु महाभारतमुच्यते\t॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 160}, {"id": 2206011, "chapter_id": 5386, "verse_number": "१३०", "content_sanskrit": "साङ्गोपाङ्गेषु वेदेषु शास्त्रेषु विविधेषु च ।\nप्रदृश्यमानेष्वस्तीह न भारतसमा श्रुतिः\t॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 161}, {"id": 2206012, "chapter_id": 5386, "verse_number": "१३१", "content_sanskrit": "सदेवयक्षगन्धर्वैः सकिन्नरमहोरगैः ।\nत्रैलोक्ये न तदप्यस्ति भारते यन्न विद्यते\t॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 162}, {"id": 2206013, "chapter_id": 5386, "verse_number": "१३२", "content_sanskrit": "श्रुतीनामाकरो ह्येष रत्नानामिव सागरः ।\nज्ञानानां परमं ह्येतत् पवित्रं शौचमुत्तमम्\t॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 163}, {"id": 2206014, "chapter_id": 5386, "verse_number": "१३३", "content_sanskrit": "यां यां श्रुतिं प्रार्थयते मनसा कृतनिश्चयः ।\nप्रविश्य भारतं राजन् तां तां श्रुतिमवाप्नुयात्\t॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 164}, {"id": 2206015, "chapter_id": 5386, "verse_number": "१३४", "content_sanskrit": "अबुद्धिशोधनं ह्येतद् बुधानां बुद्धिवर्धनम् ।\nशान्तिपर्व विशेषेण क्षीराद् घृतमिवोद्धृतम्\t॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 165}, {"id": 2206016, "chapter_id": 5386, "verse_number": "१३५", "content_sanskrit": "पर्वणां तस्य सर्वेषां सारभूतं प्रकीर्तितम्\t॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 166}, {"id": 2206017, "chapter_id": 5386, "verse_number": "१३६", "content_sanskrit": "एतत् ते कथितं सर्वं परिपृष्टं तु यत् त्वया\t॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 167}, {"id": 2206018, "chapter_id": 5386, "verse_number": "१३७", "content_sanskrit": "श्रद्दधानो नरो यस्तु संवादं पुण्यवर्धनम् ।\nसमाहितमना नित्यं शृणुयाद् श्रावयेत वा\t॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 168}, {"id": 2206019, "chapter_id": 5386, "verse_number": "१३८", "content_sanskrit": "नान्धो न बधिरो रोगी नोन्मत्तश्चैव जायते ।\nभारतं यो न जानाति सोऽन्धः पापो नरो भुवि\t॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 169}, {"id": 2206020, "chapter_id": 5386, "verse_number": "१३९", "content_sanskrit": "सर्वभूतहितो नित्यं देशिकः सर्वकर्मणाम् ।\nवेदोऽयं गुणकृद् राजन् सर्वपापप्रणाशनः\t॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 170}, {"id": 2206021, "chapter_id": 5386, "verse_number": "१४०", "content_sanskrit": "यानि कान्यपि शास्त्राणि करिष्यन्ते कृतानि वा ।\nवेदश्रेष्ठं महच्चेदं सत्यं सत्यं वदाम्यहम्\t॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 171}, {"id": 2206022, "chapter_id": 5386, "verse_number": "१४१", "content_sanskrit": "नाश्रुताय प्रदातव्यं न सुतायाहिताय वा ।\nनाश्रुताय प्रदातव्यं न चानदिष्टकारिणे\t॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 172}, {"id": 2206023, "chapter_id": 5386, "verse_number": "१४२", "content_sanskrit": "इदं ज्येष्ठाय पुत्राय इदं शिष्याय चार्थिने ।\nएतदर्थं च शुश्रूषां करोत्वविमना इव\t॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 173}, {"id": 2206024, "chapter_id": 5386, "verse_number": "१४३", "content_sanskrit": "श्रद्दधानस्तु यश्चेदं शृणुयाच्छ्रावयेत वा ।\nविमुक्तः सर्वपापेभ्यः सर्वं स्वगृहवद् व्रजेत्\t॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 174}, {"id": 2206025, "chapter_id": 5386, "verse_number": "१४४", "content_sanskrit": "पारणं सर्ववेदानां सर्वतीर्थावगाहनम् ।\nयश्चेदं शृणुयान्नित्यं सममेतन्न संशयः\t॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 175}, {"id": 2206026, "chapter_id": 5386, "verse_number": "१४५", "content_sanskrit": "सुवर्णदानं गोदानं भूमिदानं ददाति च ।\nपठेदिमं च यो नित्यं समावेतौ नृपोत्तम\t॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 176}, {"id": 2206027, "chapter_id": 5386, "verse_number": "१४६", "content_sanskrit": "श्रद्धेयमेतत् परमं सम्भाव्यं च नरैः सदा ।\nप्रयत्नेन गृहीतव्यमिदं शास्त्रमनुत्तमम्\t॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 177}, {"id": 2206028, "chapter_id": 5386, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nअनुशासनपर्वणि दानधर्मे उमामहेश्वरसंवादे महाभारतप्रशंसानाम सप्तत्रिंशत्युत्तरद्विशततमोऽध्यायः ॥१३७॥\n॥ इत्युमामहेश्वरयोः संवादः समाप्तः ॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 178}]