[{"id": 900009225, "chapter_id": 8734, "verse_number": "24.1", "content_sanskrit": "आख्यातार्थस्त्वधःसन्तपनादिरूपधात्वर्थानुकूलव्यापार एव..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900009226, "chapter_id": 8734, "verse_number": "24.2", "content_sanskrit": "मणौ तु– आख्यातस्य कृतिरेवार्थो न तु व्यापारः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900009227, "chapter_id": 8734, "verse_number": "24.3", "content_sanskrit": "रत्नकोशकारस्तु– धात्वर्थोऽधःसन्तपनादिव्यापारः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900009228, "chapter_id": 8734, "verse_number": "24.4", "content_sanskrit": "प्रभाकरास्तु– फलानुकूलोऽधः सन्तपनादिरूपव्यापारो धात्वर्थः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900009229, "chapter_id": 8734, "verse_number": "24.5", "content_sanskrit": "एवं कर्तृकर्मणी अपि लकारवाच्ये", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900009230, "chapter_id": 8734, "verse_number": "24.6", "content_sanskrit": "एतेन कर्तृकर्मत्वे एवाख्यातस्य शक्ये न तु तद्धर्मिणौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900009231, "chapter_id": 8734, "verse_number": "24.7", "content_sanskrit": "एवं विकत्त्यादिरूपफलजनकोऽधःसन्तपनादिव्यापार एव..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900009232, "chapter_id": 8734, "verse_number": "24.8", "content_sanskrit": "एवं प्रजयतीत्यादौ प्रादिनोपसर्गेण ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}]