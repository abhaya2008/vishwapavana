[{"id": 2207312, "chapter_id": 5420, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2207313, "chapter_id": 5420, "verse_number": "१", "content_sanskrit": "एवं बहुविधैर्वाक्यैर्मुनिभिस्तैस्तपोधनैः ।\nसमाश्वस्तस्तु राजर्षिर्हतबन्धुर्युधिष्ठिरः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2207314, "chapter_id": 5420, "verse_number": "२", "content_sanskrit": "सोऽनुनीतो भगवता विष्टरश्रवसा स्वयम् ।\nद्वैपायनेन कृष्णेन देवस्थानेन चैव हि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2207315, "chapter_id": 5420, "verse_number": "३", "content_sanskrit": "नारदेनाथ भीमेन नकुलेन च पार्थिव ।\nकृष्णाया सहदेवेन विजयेन च धीमता\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2207316, "chapter_id": 5420, "verse_number": "४", "content_sanskrit": "अन्यैश्च पुरुषव्याघ्रैर्ब्राह्मणैः शास्त्रदृष्टिभिः ।\nव्यजहाच्छोकजं दुःखं सन्तापं चैव मानसम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2207317, "chapter_id": 5420, "verse_number": "५", "content_sanskrit": "अर्चयामास देवांश्च ब्राह्मणांश्च युधिष्ठिरः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2207318, "chapter_id": 5420, "verse_number": "६", "content_sanskrit": "कृत्वा च प्रेतकार्याणि सर्वेषां कुरुनन्दनः ।\nअन्वशासत धर्मात्मा पृथिवीं सागराम्बराम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2207319, "chapter_id": 5420, "verse_number": "७", "content_sanskrit": "प्रशान्तचेताः कौरव्यः स्वराज्यं प्राप्य केवलम् ।\nव्यासं च नारदं चैव तांश्चान्यानब्रवीन्नृपः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2207320, "chapter_id": 5420, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2207321, "chapter_id": 5420, "verse_number": "८", "content_sanskrit": "आश्वासितोऽहं प्राग्वृद्धैर्भवद्भिर्मुनिपुङ्गवैः ।\nन स्तोकमपि नः किञ्चिद् व्यलीकमिह विद्यते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2207322, "chapter_id": 5420, "verse_number": "९", "content_sanskrit": "अर्थश्च सुमहान् प्राप्तो येन यक्ष्यामि देवताः ।\nपुरस्कृत्येह भवतः समानेष्याम्यतो मखम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2207323, "chapter_id": 5420, "verse_number": "१०", "content_sanskrit": "हिमवन्तं त्वया गुप्ता गमिष्यामः पितामह ।\nबह्वाश्चर्यो हि देशः स श्रूयते द्विजसत्तम\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2207324, "chapter_id": 5420, "verse_number": "११", "content_sanskrit": "तथा भगवता चित्रं कल्याणं बहु भाषितम् ।\nदेवर्षिणा नारदेन देवस्थानेन चैव ह\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2207325, "chapter_id": 5420, "verse_number": "१२", "content_sanskrit": "नाभागधेयः पुरुषः कश्चिदेवंविधान् गुरून् ।\nलभते व्यसनं प्राप्य सुहृदः साधुसम्मतान्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2207326, "chapter_id": 5420, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2207327, "chapter_id": 5420, "verse_number": "१३", "content_sanskrit": "एवमुक्तास्तु ते राज्ञा सर्व एव महर्षयः ।\nअभ्यनुज्ञाप्य राजानं तथोभौ कृष्णफल्गुनौ\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2207328, "chapter_id": 5420, "verse_number": "१४", "content_sanskrit": "पश्यतामेव सर्वेषां तत्रैवादर्शनं ययुः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2207329, "chapter_id": 5420, "verse_number": "१५", "content_sanskrit": "ततो धर्मसुतो राजा तत्रैवोपाविशत् प्रभुः ।\nएवं नातिमहान् कालः स तेषामत्यवर्तत\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2207330, "chapter_id": 5420, "verse_number": "१६", "content_sanskrit": "कुर्वतां शौचकर्माणि भीष्मस्य निधने तथा ।\nमहादानानि विप्रेभ्यो ददतामौर्ध्वदैहिकम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2207331, "chapter_id": 5420, "verse_number": "१७", "content_sanskrit": "भीष्मकर्णपुरोगाणां कुरूणां कुरुनन्दन ।\nसहितो धृतराष्ट्रेण स ददावौर्ध्वदैहिकम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2207332, "chapter_id": 5420, "verse_number": "१८", "content_sanskrit": "ततो दत्त्वा बहु धनं विप्रेभ्यः पाण्डुनन्दनः ।\nधृतराष्ट्रं पुरस्कृत्य विवेश गजसाह्वयम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2207333, "chapter_id": 5420, "verse_number": "१९", "content_sanskrit": "स समाश्वास्य पितरं प्रज्ञाचक्षुषमीश्वरम् ।\nअन्वशासत धर्मात्मा पृथिवीं भ्रातृभिः सह\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2207334, "chapter_id": 5420, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि\nधर्मराजपुरप्रवेशो नाम चतुर्दशोऽध्यायः ॥१४॥\nअश्वमेधपर्वणि चतुर्दशोऽध्यायः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]