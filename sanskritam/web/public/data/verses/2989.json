[{"id": 2093256, "chapter_id": 2989, "verse_number": "१३-११९-१", "content_sanskrit": "`युधिष्ठिर उवाच।\nसुरभ्यास्तु तदा देव्याः कीर्तिर्लक्ष्मीः सरस्वती।\nमेधा च प्रवरा देवी याश्चतस्रोऽभिविश्रुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2093257, "chapter_id": 2989, "verse_number": "१३-११९-२", "content_sanskrit": "पृथग्गोभ्यः किमेताः स्युरुताहो गोषु संश्रिताः।\nदेवाः के वाऽऽश्रिता गोषु तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2093258, "chapter_id": 2989, "verse_number": "१३-११९-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2093259, "chapter_id": 2989, "verse_number": "१३-११९-३", "content_sanskrit": "यं देवं संश्रिता गावस्तं देवं देवसंज्ञितम्।\nयद्यद्देवाश्रितं दैवं तत्तद्दैवं द्विजा विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2093260, "chapter_id": 2989, "verse_number": "१३-११९-४", "content_sanskrit": "सर्वेषामेव देवानां पूर्वं किल समुद्भवे।\nअमृतार्थे सुरपतिः सुरभिं समुपस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2093261, "chapter_id": 2989, "verse_number": "१३-११९-५x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2093262, "chapter_id": 2989, "verse_number": "१३-११९-५", "content_sanskrit": "इच्छेयममृतं दत्तं त्वया देवि रसाधिकम्।\nत्वत्प्रसादाच्छिवं मह्यममरत्वं भवेदिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2093263, "chapter_id": 2989, "verse_number": "१३-११९-६x", "content_sanskrit": "सुरभिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2093264, "chapter_id": 2989, "verse_number": "१३-११९-६", "content_sanskrit": "वत्सो भूत्वा सुपरते पिबस्व प्रस्रवं मम।\nततोऽमरत्वमपि तस्थानमैन्द्रमवाप्स्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2093265, "chapter_id": 2989, "verse_number": "१३-११९-७", "content_sanskrit": "न च ते वृत्रहन्युद्धे व्यथाऽरिभ्यो भविष्यति।\nबलार्थमात्मनः शक्र प्रस्रवं पिब मे विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2093266, "chapter_id": 2989, "verse_number": "१३-११९-८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2093267, "chapter_id": 2989, "verse_number": "१३-११९-८", "content_sanskrit": "ततोऽपिबत्स्नं तस्याः सुरभ्याः सुरसत्तमः।\nअमरत्वं सुरूपत्वं बलं चापदनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2093268, "chapter_id": 2989, "verse_number": "१३-११९-९", "content_sanskrit": "पुरंदरोऽमृतं पीत्वा प्रहृष्टः समुपस्थितः।\nपुत्रोऽहं तव भद्रं ते ब्रूहि किं करवाणि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2093269, "chapter_id": 2989, "verse_number": "१३-११९-१०x", "content_sanskrit": "सुरभिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2093270, "chapter_id": 2989, "verse_number": "१३-११९-१०", "content_sanskrit": "कृतं पुत्र त्वया सर्वमुपयाहि त्रिविष्टपम्।\nपालयस्व सुरान्सर्वाञ्जहि ये सुरशत्रवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2093271, "chapter_id": 2989, "verse_number": "१३-११९-११", "content_sanskrit": "न च गोब्राह्मणेऽवज्ञा कार्या ते शान्तिमिच्छता।\nगोब्राह्मणस्य निश्वासः शोषयेदपि देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2093272, "chapter_id": 2989, "verse_number": "१३-११९-१२", "content_sanskrit": "गोब्राह्मणप्रियो नित्यं स्वस्तिशब्दमुदाहरन्।\nपृथिव्यामन्तरिक्षे च नाकपृष्ठे च विक्रमेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2093273, "chapter_id": 2989, "verse_number": "१३-११९-१३", "content_sanskrit": "यच्च तेऽन्यद्भवेत्कृत्यं तन्मे ब्रूयाः समासतः।\nतत्ते सर्वं करिष्यामि सत्येनैतद्ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2093274, "chapter_id": 2989, "verse_number": "१३-११९-१४x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2093275, "chapter_id": 2989, "verse_number": "१३-११९-१४", "content_sanskrit": "इच्छेयं गोषु नियतं वस्तुं देवि ब्रवीमि ते।\nएभिः सुरगणैः सार्धं ममानुग्रहमाचर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2093276, "chapter_id": 2989, "verse_number": "१३-११९-१५x", "content_sanskrit": "सुरभिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2093277, "chapter_id": 2989, "verse_number": "१३-११९-१५", "content_sanskrit": "गवां शरीरं प्रत्यक्षमेतत्कौशिक लक्ष्ये।\nयो यत्रोत्सहते वस्तुं स तत्र वसतां सुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2093278, "chapter_id": 2989, "verse_number": "१३-११९-१६", "content_sanskrit": "सर्वं पवित्रं परमं गवां गात्रं सुपूजितम्।\nतथा कुरुष्व भद्रं ते यथा त्वं शक्र मन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2093279, "chapter_id": 2989, "verse_number": "१३-११९-१७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2093280, "chapter_id": 2989, "verse_number": "१३-११९-१७", "content_sanskrit": "तस्यास्तद्वचनं श्रुत्वा सुरभ्याः सुरसत्तमः।\nसह सर्वैः सुरगणैरभजत्सौरभीं प्रजाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2093281, "chapter_id": 2989, "verse_number": "१३-११९-१८", "content_sanskrit": "शृङ्गे वक्त्रे च जिह्वायां देवराजः समाविशत्।\nसर्वच्छिद्रेषु पवनः पादेषु मरुतां गणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2093282, "chapter_id": 2989, "verse_number": "१३-११९-१९", "content_sanskrit": "ककुदं सर्वगो रुद्रः कुक्षौ चैव हुताशनः।\nसरस्वती स्तनेष्वग्र्या श्रीः पुरीषे जगत्प्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2093283, "chapter_id": 2989, "verse_number": "१३-११९-२०", "content_sanskrit": "मूत्रे कीर्तिश्च गङ्गा च मेधा पयसि शाश्वती।\nवक्त्रे सोमश्च वै देवो हृदये भगवान्यमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2093284, "chapter_id": 2989, "verse_number": "१३-११९-२१", "content_sanskrit": "धर्मः पुच्छे क्रिया लोम्नि भास्करश्चक्षुषी श्रितः।\nसिद्धाः सन्धिषु सिद्धिश्च तपस्तेजश्च चेष्टने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2093285, "chapter_id": 2989, "verse_number": "१३-११९-२२", "content_sanskrit": "एवं सर्वे सुरगणा नियता गात्रवर्त्मसु।\nमहती देवता गावो ब्राह्मणैः परिसंस्कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2093286, "chapter_id": 2989, "verse_number": "१३-११९-२३", "content_sanskrit": "गामाश्रयन्ति सहिता देवा हि प्रभविष्णवः।\nकिमासां सर्वभावेन विदध्याद्भगवान्प्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2093287, "chapter_id": 2989, "verse_number": "१३-११९-२४", "content_sanskrit": "भवांश्च परया भक्त्या पूजयस्व नरेश्वर।\nगावस्तु परमं लोके पवित्रं पावनं हविः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2093288, "chapter_id": 2989, "verse_number": "१३-११९-२५", "content_sanskrit": "निपात्य भक्षितः स्वर्गाद्भार्गवः फेनपः किल।\nस च प्राणान्पुनर्लब्ध्वा ततो गोलोकमाश्रितः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2093289, "chapter_id": 2989, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकोनविंशत्यधिकशततमोऽध्यायः॥ ११९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]