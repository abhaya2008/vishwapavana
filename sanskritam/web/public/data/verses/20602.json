[{"id": 7000602000, "chapter_id": 20602, "verse_number": "५-६१-१", "content_sanskrit": "शत्रुघ्न उवाच ।\nजानासि किं महामंत्रिन्को बालो हयमाहरत् ।\nयेन मे क्षपितं सर्वं बलं वारिधिसन्निभम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000602001, "chapter_id": 20602, "verse_number": "५-६१-२", "content_sanskrit": "सुमतिरुवाच ।\nस्वामिन्नयं मुनिश्रेष्ठ वाल्मीकेराश्रमो महान् ।\nक्षत्त्रियाणामत्र वासो नास्त्येव परतापन॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000602002, "chapter_id": 20602, "verse_number": "५-६१-३", "content_sanskrit": "इंद्रो भविष्यति परममर्षी हयमाहरत् ।\nपुरारिर्वान्यथा वाहं तव कः समुपाहरेत्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000602003, "chapter_id": 20602, "verse_number": "५-६१-४", "content_sanskrit": "कालजिद्येन नाशं वै प्राप्तः परमदारुणः ।\nतं प्रति श्रीमहाराज गंता कः पुष्कलान्यतः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000602004, "chapter_id": 20602, "verse_number": "५-६१-५", "content_sanskrit": "त्वं च वीरैर्भटैः सर्वैराजभिः परिवारितः ।\nतत्र गच्छस्व सैन्येन महता शत्रुकृंतन॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000602005, "chapter_id": 20602, "verse_number": "५-६१-६", "content_sanskrit": "गत्वा स जीवितं वीरं बद्ध्वा तु कुतुकार्थिने ।\nदर्शयिष्यामि रामाय मतं मे त्विदमादृतम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000602006, "chapter_id": 20602, "verse_number": "५-६१-७", "content_sanskrit": "इति वाक्यं समाकर्ण्य वीरान्सर्वान्समादिशत् ।\nसैन्येन महता यात यूयमायामि पृष्ठतः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000602007, "chapter_id": 20602, "verse_number": "५-६१-८", "content_sanskrit": "निर्दिष्टास्ते क्षणाद्वीरा जग्मुर्यत्र लवो बली ।\nधनुर्विस्फारयंस्तत्र सुदृढं गुणपूरितम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000602008, "chapter_id": 20602, "verse_number": "५-६१-९", "content_sanskrit": "आयातं तन्महद्दृष्ट्वा बलं वीरप्रपूरितम् ।\nन किंचिन्मनसा बिभ्येलवेन बलशालिना॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000602009, "chapter_id": 20602, "verse_number": "५-६१-१०", "content_sanskrit": "लवः सिंह इवोत्तस्थौ मृगान्मत्वाऽखिलान्भटान् ।\nधनुर्विस्फारयन्रोषाच्छरान्मुंचन्सहस्रशः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000602010, "chapter_id": 20602, "verse_number": "५-६१-११", "content_sanskrit": "ते शरैः पीड्यमानास्तु महारोषेण पूरिताः ।\nवीरं बालं मन्यमानाः संमुखं प्राद्रवंस्तदा॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000602011, "chapter_id": 20602, "verse_number": "५-६१-१२", "content_sanskrit": "वीरान्सहस्रशो दृष्ट्वा भ्रमिभिः पर्यवस्थितान् ।\nलवो जवेन संधाय शरान्रोषप्रपूरितः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000602012, "chapter_id": 20602, "verse_number": "५-६१-१३", "content_sanskrit": "भ्रमिराद्या सहस्रेण द्वितीयायुतसंख्यया ।\nतृतीयायुतयुग्मेन तुरीयायुतपंचभिः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000602013, "chapter_id": 20602, "verse_number": "५-६१-१४", "content_sanskrit": "पंचमी लक्षयोधानां षष्ठी योधायुताधिकैः ।\nसप्तमी लक्षयुग्मेन सप्तभिर्भ्रमिभिर्वृतः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000602014, "chapter_id": 20602, "verse_number": "५-६१-१५", "content_sanskrit": "मध्ये लवो भ्रमिव्याप्तः स चरन्वह्निवत्तदा ।\nदाहयामास सर्वान्वै सैनिकान्भ्रमिकारकान्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000602015, "chapter_id": 20602, "verse_number": "५-६१-१६", "content_sanskrit": "काचित्खङ्गैः शरैः काचित्काचित्प्रासैश्च कुंतलैः ।\nपट्टिशैः परिघैः सर्वा भ्रमिर्भग्ना महात्मना॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000602016, "chapter_id": 20602, "verse_number": "५-६१-१७", "content_sanskrit": "सप्तभिर्भ्रमिभिर्मुक्तो रराज स कुशानुजः ।\nमेघवृंदविनिर्मुक्तः शशीव शरदागमे॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000602017, "chapter_id": 20602, "verse_number": "५-६१-१८", "content_sanskrit": "प्राहरत्सर्वथा योधान्भिंदन्गजकरान्बहून् ।\nछिंदञ्छिरांसि वीराणां चक्रभ्रूणि महांति च॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000602018, "chapter_id": 20602, "verse_number": "५-६१-१९", "content_sanskrit": "अनेके पतिता वीरा लवबाणप्रपीडिताः ।\nमुमुहुः समरेऽथान्ये नष्टा अन्ये सुकातराः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000602019, "chapter_id": 20602, "verse_number": "५-६१-२०", "content_sanskrit": "पलायनपरं सैन्यं लवबाणप्रपीडितम् ।\nवीक्ष्य वीरो रणे योद्धुं प्रायात्पुष्कलसंज्ञकः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000602020, "chapter_id": 20602, "verse_number": "५-६१-२१", "content_sanskrit": "तिष्ठतिष्ठेति च वदन्रोषपूरितलोचनः ।\nरथे सुहयशोभाढ्ये तिष्ठन्प्रायाल्लवं बली॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000602021, "chapter_id": 20602, "verse_number": "५-६१-२२", "content_sanskrit": "स लवं प्रत्युवाचाथ पुष्कलः परमास्त्रवित् ।\nतिष्ठ दत्ते मया संख्ये रथे सुहयशोभिते॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000602022, "chapter_id": 20602, "verse_number": "५-६१-२३", "content_sanskrit": "पदातिना त्वया युद्धं करोमि किमथाहवे ।\nतस्मात्तिष्ठ रथे पश्चाद्युद्ध्येऽहं भवता सह ।\nएतद्वाक्यं निशम्यासौ लवः पुष्कलमब्रवीत्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000602023, "chapter_id": 20602, "verse_number": "५-६१-२४", "content_sanskrit": "त्वया दत्ते रथे स्थित्वा युद्धं कुर्यामहं रणे ।\nतदा मे पापमेव स्याज्जयः संदिग्ध एव हि॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000602024, "chapter_id": 20602, "verse_number": "५-६१-२५", "content_sanskrit": "न वयं ब्राह्मणा वीर प्रतिग्रहपरायणाः ।\nवयं तु क्षत्रिया नित्यं दानकर्मक्रियारताः॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000602025, "chapter_id": 20602, "verse_number": "५-६१-२६", "content_sanskrit": "इदानीं त्वद्रथं कोपाद्भनज्मि प्रत्यहं भवान् ।\nपादचारी भवत्येव पश्चाद्युद्धं करिष्यति॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000602026, "chapter_id": 20602, "verse_number": "५-६१-२७", "content_sanskrit": "पुष्कलो वाक्यमाकर्ण्य धर्मधैर्यसमन्वितम् ।\nविसिस्माय चिरं चित्ते धनुः सज्यमथाकरोत्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000602027, "chapter_id": 20602, "verse_number": "५-६१-२८", "content_sanskrit": "तमात्तधनुषं दृष्ट्वा लवः कोपसमन्वितः ।\nचापं चिच्छेद पाणिस्थं शरसंधानमाचरन्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000602028, "chapter_id": 20602, "verse_number": "५-६१-२९", "content_sanskrit": "स यावत्स गुणं चापं कुरुते तावदुद्धतः ।\nरथभंगं चकारास्य समरे प्रहसन्बली॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000602029, "chapter_id": 20602, "verse_number": "५-६१-३०", "content_sanskrit": "भग्नं रथं स्वकं वीक्ष्य धनुश्छिन्नं महात्मना ।\nमहावीरं मन्यमानः पदातिः प्राद्रवद्रणे॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000602030, "chapter_id": 20602, "verse_number": "५-६१-३१", "content_sanskrit": "उभौ धनुर्धरौ वीरावुभावपि शरोद्धतौ ।\nउभौ क्षतजविप्लुष्टौ छिन्नसन्नाहितावुभौ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000602031, "chapter_id": 20602, "verse_number": "५-६१-३२", "content_sanskrit": "परस्परं बाणघातविशीर्णावपुलक्षितौ ।\nजयाकांक्षां प्रकुर्वंतौ परस्परवधैषिणौ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000602032, "chapter_id": 20602, "verse_number": "५-६१-३३", "content_sanskrit": "जयंतकार्तिकेयौ वा पुरारिः पुरभिद्यथा ।\nएवं परस्परं युद्धं प्रकुर्वाणौ रणांगणे॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000602033, "chapter_id": 20602, "verse_number": "५-६१-३४", "content_sanskrit": "पुष्कलः प्रत्युवाचाथ बालं शूरशिरोमणे ।\nत्वादृशो न मया दृष्टः कश्चिद्वीरशिरोमणिः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000602034, "chapter_id": 20602, "verse_number": "५-६१-३५", "content_sanskrit": "शिरस्ते पातयाम्यद्य बाणैः शितसुपर्वभिः ।\nमा पलायस्व समरे प्राणान्रक्षस्व संयतः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000602035, "chapter_id": 20602, "verse_number": "५-६१-३६", "content_sanskrit": "एवमुक्त्वा लवं वीरं चकार शरपंजरे ।\nपुष्कलस्य शरा भूमौ नभसि व्याप्य संस्थिताः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000602036, "chapter_id": 20602, "verse_number": "५-६१-३७", "content_sanskrit": "शरपंजरमध्यस्थो लवः पुष्कलमब्रवीत् ।\nमहत्कर्म कृतं वीर यन्मां बाणैरपीडयत्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000602037, "chapter_id": 20602, "verse_number": "५-६१-३८", "content_sanskrit": "इत्युक्त्वा बाणसंघातं प्रच्छिद्य वचनं पुनः ।\nजगाद पुष्कलं वीरः शरसंधानकोविदः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000602038, "chapter_id": 20602, "verse_number": "५-६१-३९", "content_sanskrit": "पालयात्मानमाजिस्थं मच्छराघातपीडितः ।\nपतिष्यसि महीपृष्ठे रुधिरेण परिप्लुतः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000602039, "chapter_id": 20602, "verse_number": "५-६१-४०", "content_sanskrit": "एवमुक्तं समाकर्ण्य पुष्कलः कोपसंयुतः ।\nरणे संयोधयामास लवं वीरं महाबलम्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000602040, "chapter_id": 20602, "verse_number": "५-६१-४१", "content_sanskrit": "लवः प्रकुपितो बाणं तीक्ष्णं वैरिविदारणम् ।\nजग्राह लवतः कोशादाशीविषमिव क्रुधा॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000602041, "chapter_id": 20602, "verse_number": "५-६१-४२", "content_sanskrit": "जाज्वल्यमानः सशरश्चापमुक्तो लवस्य च ।\nहृदयं भेत्तुमुद्युक्तश्छिन्नो भारतिनाशु सः॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000602042, "chapter_id": 20602, "verse_number": "५-६१-४३", "content_sanskrit": "छिन्ने भारतिना संख्ये शरेण प्राणहारिणा ।\nअत्यंतं कुपितो घोरं शरमन्यं समाददे॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000602043, "chapter_id": 20602, "verse_number": "५-६१-४४", "content_sanskrit": "आकर्णाकृष्टचापेन स मुक्तो निशितः शरः ।\nबिभेद हृदयं तस्य पुष्कलस्य महारणे॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000602044, "chapter_id": 20602, "verse_number": "५-६१-४५", "content_sanskrit": "भिन्नो वक्षसि वीरेण सायकेनाशुगामिना ।\nपपात धरणीपृष्ठे महाशूरशिरोमणिः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000602045, "chapter_id": 20602, "verse_number": "५-६१-४६", "content_sanskrit": "पतितं तं समालोक्य पुष्कलं पवनात्मजः ।\nगृहीत्वा राघवभ्रात्रे ददौ मूर्च्छासमन्वितम्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000602046, "chapter_id": 20602, "verse_number": "५-६१-४७", "content_sanskrit": "मूर्च्छितं तं समालोक्य शोकविह्वलमानसः ।\nहनूमंतं लवं हंतुं निदिदेश क्रुधान्वितः॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000602047, "chapter_id": 20602, "verse_number": "५-६१-४८", "content_sanskrit": "हनूमान्क्रोधसंप्लुष्टो लवं संख्ये महाबलम् ।\nविजेतुं तरसा प्रागाद्वृक्षमुद्यम्य शाल्मलिम्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000602048, "chapter_id": 20602, "verse_number": "५-६१-४९", "content_sanskrit": "वृक्षेण हतवान्मूर्ध्नि लवस्य हनुमान्बली ।\nतमापतंतं तरसा चिच्छेद शतधा लवः॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000602049, "chapter_id": 20602, "verse_number": "५-६१-५०", "content_sanskrit": "छिन्ने नगे पुनः कोपाद्वृक्षानुत्पाट्य मूलतः ।\nताडयामास हृदये मस्तके च महाबलः॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000602050, "chapter_id": 20602, "verse_number": "५-६१-५१", "content_sanskrit": "यान्यान्वृक्षान्समाहृत्याताडयत्पवनात्मजः ।\nतांस्तांश्चिच्छेद तरसा बलवान्नतपर्वभिः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000602051, "chapter_id": 20602, "verse_number": "५-६१-५२", "content_sanskrit": "तदा शिलाः समुत्पाट्य गंडशैलोपमाः कपिः ।\nपातयामास शिरसि क्षिप्रवेगेन मारुतिः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000602052, "chapter_id": 20602, "verse_number": "५-६१-५३", "content_sanskrit": "स आहतः शिलासंघैः संख्ये कोदंडमुन्नयन् ।\nबाणैस्ताश्चूर्णयामास यंत्रिकाभिर्यथा कणाः॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000602053, "chapter_id": 20602, "verse_number": "५-६१-५४", "content_sanskrit": "तदात्यंतं प्रकुपितो मारुतिः पुच्छवेष्टनम् ।\nचकार समरोपांते लवस्य बलिनः कृती॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000602054, "chapter_id": 20602, "verse_number": "५-६१-५५", "content_sanskrit": "स्वं पुच्छेन समाविद्धं वीक्ष्य स्वांबां हृदि स्मरन् ।\nमुष्टिना ताडयामास लांगूलं मारुतेर्बली॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000602055, "chapter_id": 20602, "verse_number": "५-६१-५६", "content_sanskrit": "तन्मुष्टिघातव्यथितो मारुतिस्तममूमुचत् ।\nस मुक्तः पुच्छतो युद्धे शरान्मुंचन्नभूद्बली॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000602056, "chapter_id": 20602, "verse_number": "५-६१-५७", "content_sanskrit": "दुर्वारशरघातेन संपीडिततनुः कपिः ।\nबाणवर्षं मन्यमानो दुःसहं समरे बहु॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000602057, "chapter_id": 20602, "verse_number": "५-६१-५८", "content_sanskrit": "किंकर्तव्यमितोऽस्माभिः पलाय्य यदि गम्यते ।\nतदा मे स्वामिनो लज्जा ताडयेद्बालकोऽत्र माम्॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000602058, "chapter_id": 20602, "verse_number": "५-६१-५९", "content_sanskrit": "ब्रह्मदत्तवरत्वात्तु मूर्च्छा न मरणं नहि ।\nदुःसहा बाणपीडात्र किं कर्तव्यं मयाधुना॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000602059, "chapter_id": 20602, "verse_number": "५-६१-६०", "content_sanskrit": "शत्रुघ्नः समरे गत्वा जयं प्राप्नोतु बालकात् ।\nअहं तावज्जयाकांक्षी शये कपटमूर्च्छया॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000602060, "chapter_id": 20602, "verse_number": "५-६१-६१", "content_sanskrit": "इत्येवं मानसे कृत्वा पपात रणमंडले ।\nपश्यतां सर्ववीराणां कपटेन विमूर्च्छितः॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000602061, "chapter_id": 20602, "verse_number": "५-६१-६२", "content_sanskrit": "तं मूर्च्छितं समाज्ञाय हनूमंतं महाबलम् ।\nजघान सर्वान्नृपतीञ्छरमोक्षविचक्षणः॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]