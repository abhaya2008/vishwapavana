[
  {
    "id": 16711001,
    "chapter_id": 6111,
    "verse_number": "1.1",
    "content_sanskrit": "ब्रह्मा देवानां प्रथमः सम्बभूव विश्वस्य कर्ता भुवनस्य गोप्ता ।\nस ब्रह्मविद्यां सर्वविद्याप्रतिष्ठामथर्वाय ज्येष्ठपुत्राय प्राह ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "base_unit_id": "MD_C01_S01_V01"
  },
  {
    "id": 16711002,
    "chapter_id": 6111,
    "verse_number": "1.2",
    "content_sanskrit": "अथर्वणे यां प्रवदेत ब्रह्माऽथर्वा तां पुरोवाचाङ्गिरे ब्रह्मविद्याम् ।\nस भारद्वाजाय सत्यवहाय प्राह भारद्वाजोऽङ्गिरसे परावराम् ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "base_unit_id": "MD_C01_S01_V02"
  },
  {
    "id": 16711003,
    "chapter_id": 6111,
    "verse_number": "1.3",
    "content_sanskrit": "शौनको ह वै महाशालोऽङ्गिरसं विधिवदुपसन्नः पप्रच्छ ।\nकस्मिन्नु भगवो विज्ञाते सर्वमिदं विज्ञातं भवतीति ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "base_unit_id": "MD_C01_S01_V03"
  },
  {
    "id": 16711004,
    "chapter_id": 6111,
    "verse_number": "1.4",
    "content_sanskrit": "तस्मै स होवाच । द्वे विद्ये वेदितव्ये इति ह स्म यद्ब्रह्मविदो वदन्ति परा चैवापरा च ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "base_unit_id": "MD_C01_S01_V04"
  },
  {
    "id": 16711005,
    "chapter_id": 6111,
    "verse_number": "1.5",
    "content_sanskrit": "तत्रापरा, ऋग्वेदो यजुर्वेदः सामवेदोऽथर्ववेदः शिक्षा कल्पो व्याकरणं निरुक्तं छन्दो ज्योतिषमिति । अथ परा यया तदक्षरमधिगम्यते ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "base_unit_id": "MD_C01_S01_V05"
  },
  {
    "id": 16711006,
    "chapter_id": 6111,
    "verse_number": "1.6",
    "content_sanskrit": "यत्तदद्रेश्यमग्राह्यमगोत्रमवर्णमचक्षुःश्रोत्रं तदपाणिपादम् ।\nनित्यं विभुं सर्वगतं सुसूक्ष्मं तदव्ययं यद्भूतयोनिं परिपश्यन्ति धीराः ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "base_unit_id": "MD_C01_S01_V06"
  },
  {
    "id": 16711007,
    "chapter_id": 6111,
    "verse_number": "1.7",
    "content_sanskrit": "यथोर्णनाभिः सृजते गृह्णते च यथा पृथिव्यामोषधयः सम्भवन्ति ।\nयथा सतः पुरुषात्केशलोमानि तथाक्षरात्सम्भवतीह विश्वम् ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "base_unit_id": "MD_C01_S01_V07"
  },
  {
    "id": 16711008,
    "chapter_id": 6111,
    "verse_number": "1.8",
    "content_sanskrit": "तपसा चीयते ब्रह्म ततोऽन्नमभिजायते ।\nअन्नात्प्राणो मनः सत्यं लोकाः कर्मसु चामृतम् ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "base_unit_id": "MD_C01_S01_V08"
  },
  {
    "id": 16711009,
    "chapter_id": 6111,
    "verse_number": "1.9",
    "content_sanskrit": "यः सर्वज्ञः सर्वविद्यस्य ज्ञानमयं तपः ।\nतस्मादेतद्ब्रह्म नाम रूपमन्नं च जायते ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "base_unit_id": "MD_C01_S01_V09"
  },
  {
    "id": 16711010,
    "chapter_id": 6111,
    "verse_number": "1.10",
    "content_sanskrit": "तदेतत्सत्यं मन्त्रेषु कर्माणि कवयो यान्यपश्यंस्तानि त्रेतायां बहुधा सन्ततानि ।\nतान्याचरथ नियतं सत्यकामा एष वः पन्थाः सुकृतस्य लोके ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "base_unit_id": "MD_C01_S02_V01"
  },
  {
    "id": 16711011,
    "chapter_id": 6111,
    "verse_number": "1.11",
    "content_sanskrit": "यदा लेलायते ह्यर्चिः समिद्धे हव्यवाहने ।\nतदाज्यभागावन्तरेणाहुतीः प्रतिपादयेत् ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "base_unit_id": "MD_C01_S02_V02"
  },
  {
    "id": 16711012,
    "chapter_id": 6111,
    "verse_number": "1.12",
    "content_sanskrit": "यस्याग्निहोत्रमदर्शमपौर्णमासमचातुर्मास्यमनाग्रयणमतिथिवर्जितं च ।\nअहुतमवैश्वदेवमविधिना हुतमासप्तमांस्तस्य लोकान्हिनस्ति ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "base_unit_id": "MD_C01_S02_V03"
  },
  {
    "id": 16711013,
    "chapter_id": 6111,
    "verse_number": "1.13",
    "content_sanskrit": "काली कराली च मनोजवा च सुलोहिता या च सुधूम्रवर्णा ।\nस्फुलिङ्गिनी विश्वरुची च देवी लेलायमाना इति सप्त जिह्वाः ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "base_unit_id": "MD_C01_S02_V04"
  },
  {
    "id": 16711014,
    "chapter_id": 6111,
    "verse_number": "1.14",
    "content_sanskrit": "एतेषु यश्चरते भ्राजमानेषु यथाकालं चाहुतयो ह्याददायन् ।\nतं नयन्त्येताः सूर्यस्य रश्मयो यत्र देवानां पतिरेकोऽधिवासः ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "base_unit_id": "MD_C01_S02_V05"
  },
  {
    "id": 16711015,
    "chapter_id": 6111,
    "verse_number": "1.15",
    "content_sanskrit": "एह्येहीति तमाहुतयः सुवर्चसः सूर्यस्य रश्मिभिर्यजमानं वहन्ति ।\nप्रियां वाचमभिवदन्त्योऽर्चयन्त्य एष वः पुण्यः सुकृतो ब्रह्मलोकः ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "base_unit_id": "MD_C01_S02_V06"
  },
  {
    "id": 16711016,
    "chapter_id": 6111,
    "verse_number": "1.16",
    "content_sanskrit": "प्लवा ह्येते अदृढा यज्ञरूपा अष्टादशोक्तमवरं येषु कर्म ।\nएतच्छ्रेयो येऽभिनन्दन्ति मूढा जरामृत्युं ते पुनरेवापि यन्ति ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "base_unit_id": "MD_C01_S02_V07"
  },
  {
    "id": 16711017,
    "chapter_id": 6111,
    "verse_number": "1.17",
    "content_sanskrit": "अविद्यायामन्तरे वर्तमानाः स्वयं धीराः पण्डितंमन्यमानाः ।\nजङ्घन्यमानाः परियन्ति मूढा अन्धेनैव नीयमाना यथान्धाः ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "base_unit_id": "MD_C01_S02_V08"
  },
  {
    "id": 16711018,
    "chapter_id": 6111,
    "verse_number": "1.18",
    "content_sanskrit": "अविद्यायां बहुधा वर्तमाना वयं कृतार्था इत्यभिमन्यन्ति बालाः ।\nयत्कर्मिणो न प्रवेदयन्ति रागात्तेनातुराः क्षीणलोकाश्च्यवन्ते ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "base_unit_id": "MD_C01_S02_V09"
  },
  {
    "id": 16711019,
    "chapter_id": 6111,
    "verse_number": "1.19",
    "content_sanskrit": "इष्टापूर्तं मन्यमाना वरिष्ठं नान्यच्छ्रेयो वेदयन्ते प्रमूढाः ।\nनाकस्य पृष्ठे ते सुकृतेऽनुभूत्वेमं लोकं हीनतरं वा विशन्ति ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "base_unit_id": "MD_C01_S02_V10"
  },
  {
    "id": 16711020,
    "chapter_id": 6111,
    "verse_number": "1.20",
    "content_sanskrit": "तपःश्रद्धे ये ह्युपवसन्त्यरण्ये शान्ता विद्वांसो भैक्षचर्यां चरन्तः ।\nसूर्यद्वारेण ते विरजाः प्रयान्ति यत्रामृतः स पुरुषो ह्यव्ययात्मा ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "base_unit_id": "MD_C01_S02_V11"
  },
  {
    "id": 16711021,
    "chapter_id": 6111,
    "verse_number": "1.21",
    "content_sanskrit": "परीक्ष्य लोकान्कर्मचितान्ब्राह्मणो निर्वेदमायान्नास्त्यकृतः कृतेन ।\nतद्विज्ञानार्थं स गुरुमेवाभिगच्छेत्समित्पाणिः श्रोत्रियं ब्रह्मनिष्ठम् ॥ १२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "base_unit_id": "MD_C01_S02_V12"
  },
  {
    "id": 16711022,
    "chapter_id": 6111,
    "verse_number": "1.22",
    "content_sanskrit": "तस्मै स विद्वानुपसन्नाय सम्यक्प्रशान्तचित्ताय शमान्विताय ।\nयेनाक्षरं पुरुषं वेद सत्यं प्रोवाच तां तत्त्वतो ब्रह्मविद्याम् ॥ १३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "base_unit_id": "MD_C01_S02_V13"
  }
]