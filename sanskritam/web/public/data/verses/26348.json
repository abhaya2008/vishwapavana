[{"id": 7006348000, "chapter_id": 26348, "verse_number": "२-३-१", "content_sanskrit": "वैशम्पायन उवाच\nआर्यास्तवं प्रवक्ष्यामि यथोक्तमृषिभिः पुरा ।\nनारायणीं नमस्यामि देवीं त्रिभुवनेश्वरीम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006348001, "chapter_id": 26348, "verse_number": "२-३-२", "content_sanskrit": "त्वं हि सिद्धिर्धृतिः कीर्तिः श्रीर्विद्या संनतिर्मतिः ।\nसंध्या रात्रिः प्रभा निद्रा कालरात्रिस्तथैव च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006348002, "chapter_id": 26348, "verse_number": "२-३-३", "content_sanskrit": "आर्या कात्यायनी देवी कौशिकी ब्रह्मचारिणी ।\nजननी सिद्धसेनस्य उग्रचारी महाबला ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006348003, "chapter_id": 26348, "verse_number": "२-३-४", "content_sanskrit": "जया च विजया चैव पुष्टिस्तुष्टिः क्षमा दया ।\nज्येष्ठा यमस्य भगिनी नीलकौशेयवासिनी ॥ ४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006348004, "chapter_id": 26348, "verse_number": "२-३-५", "content_sanskrit": "बहुरूपा विरूपा च अनेकविधिचारिणी ।\nविरूपाक्षी विशालाक्षी भक्तानां परिरक्षिणी ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006348005, "chapter_id": 26348, "verse_number": "२-३-६", "content_sanskrit": "पर्वताग्रेषु घोरेषु नदीषु च गुहासु च ।\nवासस्ते च महादेवि वनेषूपवनेषु च ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006348006, "chapter_id": 26348, "verse_number": "२-३-७", "content_sanskrit": "शबरैर्बर्बरैश्चैव पुलिन्दैश्च सुपूजिता ।\nमयूरपिच्छध्वजिनी लोकान् क्रमसि सर्वशः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006348007, "chapter_id": 26348, "verse_number": "२-३-८", "content_sanskrit": "कुकुटैश्छागलैर्मेषैः सिंहैर्व्याघ्रैः समाकुला ।\nघण्टानिनादबहुला विन्ध्यवासिन्यभिश्रुता ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006348008, "chapter_id": 26348, "verse_number": "२-३-९", "content_sanskrit": "त्रिशूलपट्टिशधरा सूर्यचन्द्रपताकिनी ।\nनवमी कृष्णपक्षस्य शुक्लस्यैकादशी तथा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006348009, "chapter_id": 26348, "verse_number": "२-३-१०", "content_sanskrit": "भगिनी बलदेवस्य रजनी कलहप्रिया ।\nआवासः सर्वभूतानां निष्ठा च परमा गतिः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006348010, "chapter_id": 26348, "verse_number": "२-३-११", "content_sanskrit": "नन्दगोपसुता चैव देवानां विजयावहा ।\nचीरवासाः सुवासाश्च रौद्री संध्याचरी निशा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006348011, "chapter_id": 26348, "verse_number": "२-३-१२", "content_sanskrit": "प्रकीर्णकेशी मृत्युश्च सुरामांसबलिप्रिया ।\nलक्ष्मीरलक्ष्मीरूपेण दानवानां वधाय च ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006348012, "chapter_id": 26348, "verse_number": "२-३-१३", "content_sanskrit": "सावित्री चापि देवानां माता भूतगणस्य च ।\nकन्यानां ब्रह्मचर्यं त्वं सौभाग्यं प्रमदासु च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006348013, "chapter_id": 26348, "verse_number": "२-३-१४", "content_sanskrit": "अन्तर्वेदी च यज्ञानामृत्विजां चैव दक्षिणा ।\nकर्षकाणां च सीतेति भूतानां धरणीति च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006348014, "chapter_id": 26348, "verse_number": "२-३-१५", "content_sanskrit": "सिद्धिः सांयात्रिकाणां तु वेला त्वं सागरस्य च ।\nयक्षाणां प्रथमा यक्षी नागानां सुरसेति च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006348015, "chapter_id": 26348, "verse_number": "२-३-१६", "content_sanskrit": "ब्रह्मवादिन्यथो दीक्षा शोभा च परमा तथा ।\nज्योतिषां त्वं प्रभा देवि नक्षत्राणां च रोहिणी ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006348016, "chapter_id": 26348, "verse_number": "२-३-१७", "content_sanskrit": "राजद्वारेषु तीर्थेषु नदीनां सङ्गमेषु च ।\nपूर्णा च पूर्णिमा चन्द्रे कृत्तिवासा इति स्मृता ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006348017, "chapter_id": 26348, "verse_number": "२-३-१८", "content_sanskrit": "सरस्वती च वाल्मीके स्मृतिर्द्वैपायने तथा ।\nऋषीणां धर्मबुद्धिस्तु देवानां मानसी तथा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006348018, "chapter_id": 26348, "verse_number": "२-३-१९", "content_sanskrit": "सुरा देवी तु भूतेषु स्तूयसे त्वं स्वकर्मभिः ।\nइन्द्रस्य चारुदृष्टिस्त्वं सहस्रनयनेति च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006348019, "chapter_id": 26348, "verse_number": "२-३-२०", "content_sanskrit": "तापसानां च देवी त्वमरणी चाग्निहोत्रिणाम्।\nक्षुधा च सर्वभूतानां तृप्तिस्त्वं दैवतेषु च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006348020, "chapter_id": 26348, "verse_number": "२-३-२१", "content_sanskrit": "स्वाहा तृप्तिर्धृतिर्मेधा वसूनां त्वं वसूमती ।\nआशा त्वं मानुषाणां च पुष्टिश्च कृतकर्मणाम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006348021, "chapter_id": 26348, "verse_number": "२-३-२२", "content_sanskrit": "दिशश्च विदिशश्चैव तथा ह्यग्निशिखा प्रभा ।\nशकुनी पूतना त्वं च रेवती च सुदारुणा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006348022, "chapter_id": 26348, "verse_number": "२-३-२३", "content_sanskrit": "निद्रापि सर्वभूतानां मोहिनी क्षत्रिया तथा ।\nविद्यानां ब्रह्मविद्या त्वमोङ्कारोऽथ वषट् तथा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006348023, "chapter_id": 26348, "verse_number": "२-३-२४", "content_sanskrit": "नारीणां पार्वतीं च त्वां पौराणीमृषयो विदुः ।\nअरुन्धती च साध्वीनां प्रजापतिवचो यथा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006348024, "chapter_id": 26348, "verse_number": "२-३-२५", "content_sanskrit": "पर्यायनामभिर्दिव्यैरिन्द्राणी चेति विश्रुता ।\nत्वया व्याप्तमिदं सर्वं जगत् स्थावरजङ्गमम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006348025, "chapter_id": 26348, "verse_number": "२-३-२६", "content_sanskrit": "संग्रामेषु च सर्वेषु अग्निप्रज्वलितेषु च।\nनदीतीरेषु चौरेषु कान्तारेषु भयेषु च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006348026, "chapter_id": 26348, "verse_number": "२-३-२७", "content_sanskrit": "प्रवासे राजबन्धे च शत्रूणां च प्रमर्दने।\nप्रणात्ययेषु सर्वेषु त्वं हि रक्षा न संशयः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006348027, "chapter_id": 26348, "verse_number": "२-३-२८", "content_sanskrit": "त्वयि मे हदयं देवि त्वयि चित्तं मनस्त्वयि ।\nरक्ष मां सर्वपापेभ्यः प्रसादं कर्तुमर्हसि ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006348028, "chapter_id": 26348, "verse_number": "२-३-२९", "content_sanskrit": "इमं यः सुस्तवं दिव्यमिति व्यासप्रकल्पितम् ।\nयः पठेत् प्रातरुत्थाय शुचिः प्रयतमानसः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006348029, "chapter_id": 26348, "verse_number": "२-३-३०", "content_sanskrit": "त्रिभिर्मासैः काङ्क्षितं च फलं वै सम्प्रयच्छसि ।\nषड्भिर्मासैर्वरिष्ठं तु वरमेकं प्रयच्छसि ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006348030, "chapter_id": 26348, "verse_number": "२-३-३१", "content_sanskrit": "अर्चिता तु त्रिभिर्मासैर्दिव्यं चक्षुः प्रयच्छसि ।\nसंवत्सरेण सिद्धिं तु यथाकामं प्रयच्छसि ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006348031, "chapter_id": 26348, "verse_number": "२-३-३२", "content_sanskrit": "सत्यं ब्रह्म च दिव्यं च द्वैपायनवचो यथा ।\nनृणां बन्धं वधं घोरं पुत्रनाशं धनक्षयम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006348032, "chapter_id": 26348, "verse_number": "२-३-३३", "content_sanskrit": "व्याधिमृत्युभयं चैव पूजिता शमयिष्यसि ।\nभविष्यसि महाभागे वरदा कामरूपिणी ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006348033, "chapter_id": 26348, "verse_number": "२-३-३४", "content_sanskrit": "मोहयित्वा च तं कंसमेका त्वं भोक्ष्यसे जगत् ।\nअहमप्यात्मनो वृत्तिं विधास्ये गोषु गोपवत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006348034, "chapter_id": 26348, "verse_number": "२-३-३५", "content_sanskrit": "समृद्ध्यर्थमहं चैव करिष्ये कंसगोपताम् ।\nएवं तां स समादिश्य गतोऽन्तर्धानमीश्वरः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006348035, "chapter_id": 26348, "verse_number": "२-३-३६", "content_sanskrit": "सा चापि तं नमस्कृत्य तथास्त्विति च निश्चिता ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006348036, "chapter_id": 26348, "verse_number": "२-३-३७", "content_sanskrit": "यश्चैतत् पठते स्तोत्रं शृणुयाद् वाप्यभीक्ष्णशः ।\nसर्वार्थसिद्धिं लभते नरो नास्त्यत्र संशयः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]