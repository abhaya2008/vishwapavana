[{"id": 2138324, "chapter_id": 3996, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2138325, "chapter_id": 3996, "verse_number": "१", "content_sanskrit": "किंकर्ता किंसमाचारो नकुलोऽयं भविष्यति ।\nसुकुमारश्च शूरश्च दर्शनीयः सुखैधितः\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2138326, "chapter_id": 3996, "verse_number": "२", "content_sanskrit": "अदुःखार्हश्च बालश्च लालितश्चापि नित्यशः ।\nसोऽयमार्तश्च शान्तश्च किं नु रोचयिता त्विह\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2138327, "chapter_id": 3996, "verse_number": "", "content_sanskrit": "नकुलः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2138328, "chapter_id": 3996, "verse_number": "३", "content_sanskrit": "अश्वाध्यक्षो भविष्यामि विराटस्येति मे मतिः ।\nदामग्रन्थीति नाम्नाऽहं कर्मैतत् सुप्रियं मम\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2138329, "chapter_id": 3996, "verse_number": "४", "content_sanskrit": "दामग्रन्थी परिज्ञाता कुशलो दामकर्मणि\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2138330, "chapter_id": 3996, "verse_number": "५", "content_sanskrit": "कुशलोस्म्यश्वशिक्षायां तथैवाश्वचिकित्सिते ।\nअश्वान् परिभविष्यन्ति वडवा जातु न क्वचित् ।\nप्रियाश्च सततं मेऽश्वाः कुरुराज यथा तव\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2138331, "chapter_id": 3996, "verse_number": "६", "content_sanskrit": "न मां परिहरिष्यन्ति किशोरा वडवास्तथा ।\nन दुष्टाश्च भविष्यन्ति पृष्ठे धुरि च मद्गताः\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2138332, "chapter_id": 3996, "verse_number": "७", "content_sanskrit": "प्रेक्षन्ते ये च मां केचिद् विराटनगरे जनाः ।\nतेभ्यं एवं प्रवक्ष्यामि विचरिष्याम्यहं सुखम्\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2138333, "chapter_id": 3996, "verse_number": "८", "content_sanskrit": "नकुलेनैवमुक्तस्तु धर्मराजोऽब्रवीद् वचः\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2138334, "chapter_id": 3996, "verse_number": "९", "content_sanskrit": "बृहस्पतिसमो बुद्ध्या नये चोशनसा समः ।\nमन्त्रैर्नानाविधैर्नीतः पथ्यैः सुपरिनिष्ठितः\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2138335, "chapter_id": 3996, "verse_number": "१०", "content_sanskrit": "सुप्रणीतैः सुमार्गस्थो राजतन्त्रमपालयत्\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2138336, "chapter_id": 3996, "verse_number": "११", "content_sanskrit": "तथा सज्वलितं किञ्चिद् ददृशुस्तद्विदो जनाः ।\nसुनीतिमायी सुशूरश्च सर्वमन्त्रविशारदः\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2138337, "chapter_id": 3996, "verse_number": "१२", "content_sanskrit": "अधिकं मातुरस्माकं कुन्त्याः प्रियतरः सदा ।\nसहदेव कथं कर्म तस्य राष्ट्रे करिष्यसि\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2138338, "chapter_id": 3996, "verse_number": "१३", "content_sanskrit": "किं वा त्वं तात कुर्वाणः प्रच्छन्नो विचरिष्यसि\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2138339, "chapter_id": 3996, "verse_number": "", "content_sanskrit": "सहदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2138340, "chapter_id": 3996, "verse_number": "१४", "content_sanskrit": "गोसङ्ख्याता भविष्यामि विराटस्येति रोचये\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2138341, "chapter_id": 3996, "verse_number": "१५", "content_sanskrit": "प्रतिमोक्ता च दोग्धा च सङ्ख्यानकुशलो गवाम् ।\nतन्त्रीपालेति मे नाम स्वयं प्रोक्तं भविष्यति\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2138342, "chapter_id": 3996, "verse_number": "१६", "content_sanskrit": "अरोगा बहुलाः पुष्टाः क्षीरवत्यो बहुप्रजाः ।\nनिष्पन्नसत्त्वाः सुभृता व्यपेतज्वरकिल्बिषाः\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2138343, "chapter_id": 3996, "verse_number": "१७", "content_sanskrit": "नष्टचोरभया नित्यं व्याधिव्याघ्रविवर्जिताः ।\nगावश्च सुसुखा राजन् निरुद्विग्ना निरामयाः\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2138344, "chapter_id": 3996, "verse_number": "१८", "content_sanskrit": "भविष्यन्ति मया गुप्ता विराटपशवो नृप ।\nनिपुणश्च चरिष्यामि प्रीतिरत्र परा हि मे\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2138345, "chapter_id": 3996, "verse_number": "१९", "content_sanskrit": "अहं हि भवतो गोषु प्रकृतः सततं पुरा ।\nतत्र मे कौशलं सर्वम् अवबुद्धं विशाम्पते\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2138346, "chapter_id": 3996, "verse_number": "२०", "content_sanskrit": "रक्षणं चरितं चैव गवां मङ्गललक्षणम् ।\nतत्सर्वं मे सुविदितम् अन्यच्चापि महीपते\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2138347, "chapter_id": 3996, "verse_number": "२१", "content_sanskrit": "वृषभानपि जानामि राजन् पूजितलक्षणान् ।\nयेषां मूत्रमुपाघ्राय अपि वन्ध्या प्रसूयते\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2138348, "chapter_id": 3996, "verse_number": "२२", "content_sanskrit": "सोऽहमेवं चरिष्यामि प्रीतिरत्र परा हि मे ।\nन च मां वेत्स्यति परः तत्ते रोचतु पार्थिव\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2138349, "chapter_id": 3996, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2138350, "chapter_id": 3996, "verse_number": "२३", "content_sanskrit": "केनात्र कर्मणा कृष्णा द्रौपदी विचरिष्यति ।\nन हि किञ्चन जानाति कर्म कर्तुं यथा स्त्रियः\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2138351, "chapter_id": 3996, "verse_number": "२४", "content_sanskrit": "माल्यान् गन्धानलङ्कारान् वस्त्राणि विविधानि च ।\nएतान्येवाभिजानाति यतो जाता च भामिनी\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2138352, "chapter_id": 3996, "verse_number": "२५", "content_sanskrit": "इयं तु नः प्रिया भार्या प्राणेभ्योऽपि गरीयसी ।\nमातेव परिपाल्या च पूज्या ज्येष्ठा स्वसेव च\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2138353, "chapter_id": 3996, "verse_number": "२६", "content_sanskrit": "सुकुमारी सुशीला च राजपुत्री यशस्विनी ।\nकथं वत्स्यति कल्याणी विराटनगरे सती\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2138354, "chapter_id": 3996, "verse_number": "", "content_sanskrit": "द्रौपदी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2138355, "chapter_id": 3996, "verse_number": "२७", "content_sanskrit": "अहं वत्स्यामि राजेन्द्र निर्वृतो भव पार्थिव ।\nयथा मे मत्कृते शोको न भवेन्नृप तच्छृणु\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2138356, "chapter_id": 3996, "verse_number": "२८", "content_sanskrit": "यथा तु मां न जानन्ति तत्करिष्याम्यहं विभो ।\nछन्ना वत्स्याम्यहं यन्मां न विज्ञास्यन्ति केचन\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2138357, "chapter_id": 3996, "verse_number": "२९", "content_sanskrit": "वृत्तं तच्च समाख्यास्ये शमाप्नुहि विशाम्पते ।\nसैरन्ध्रीजातिसम्पन्ना नाम्नाऽहं व्रतचारिणी\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2138358, "chapter_id": 3996, "verse_number": "३०", "content_sanskrit": "सैरन्ध्र्यो रक्षिताः स्त्रीणां भुजिष्याः सन्ति भारत ।\nएकपत्न्यः स्त्रियश्चैता इति लोकस्य निश्चयः\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2138359, "chapter_id": 3996, "verse_number": "३१", "content_sanskrit": "साऽहं ब्रुवाणा सैरन्ध्री कुशला केशकर्मणि ।\nनाऽहं तव भविष्यामि दुर्भरा राजवेश्मनि\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2138360, "chapter_id": 3996, "verse_number": "३२", "content_sanskrit": "कृता चैव सदा रक्षा व्रतेनैव नराधिप ।\nसुदेष्णां प्रत्युपस्थास्ये राजभार्यां यशस्विनीम्\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2138361, "chapter_id": 3996, "verse_number": "३३", "content_sanskrit": "सा रक्षिष्यति मां प्राप्तां मा ते भूद्दुःखमीदृशम् ।\nअनुगुप्ता चरिष्यामि यन्मां त्वमनुपृच्छसि\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2138362, "chapter_id": 3996, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2138363, "chapter_id": 3996, "verse_number": "३४", "content_sanskrit": "यथा न दुर्हृदः पापा भवन्ति सुखिनः पुनः ।\nकुर्यास्तथा त्वं कल्याणि लक्षयेयुर्न वर्णतः\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2138364, "chapter_id": 3996, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां विराटपर्वणि चतुर्थोऽध्यायः ॥४॥\nवैराटपर्वणि चतुर्थोऽध्यायः ॥४॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]