[{"id": 7004333000, "chapter_id": 24333, "verse_number": "५-३-२७-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nनारदस्य वचः श्रुत्वा राज्ञी वचनमब्रवीत् ।\nप्रसादं कुरु विप्रेन्द्र गृह्ण दानं यथेप्सितम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004333001, "chapter_id": 24333, "verse_number": "५-३-२७-२", "content_sanskrit": "सुवर्णमणिरत्नानि वस्त्राणि विविधानि च ।\nतत्ते दारयामि विप्रेन्द्र यच्चान्यदपि दुर्लभम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004333002, "chapter_id": 24333, "verse_number": "५-३-२७-३", "content_sanskrit": "राज्ञ्यास्तु वचनं श्रुत्वा नारदो वाक्यमब्रवीत् ।\nअन्येषां दीयतां भद्रे ये द्विजाः क्षीणवृत्तयः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004333003, "chapter_id": 24333, "verse_number": "५-३-२७-४", "content_sanskrit": "वयं तु सर्वसम्पन्ना भक्तिग्राह्याः सदैव हि ।\nइत्युक्ता सा तदा राज्ञी वेदवेदाङ्गपारगान्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004333004, "chapter_id": 24333, "verse_number": "५-३-२७-५", "content_sanskrit": "आहूय ब्राह्मणान्निःस्वान्दातुं समुपचक्रमे ।\nयत्किंचिन्नारदेनोक्तं दानसौभाग्यवर्धनम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004333005, "chapter_id": 24333, "verse_number": "५-३-२७-६", "content_sanskrit": "तेन दानेन मे नित्यं प्रीयेतां हरिशङ्करौ ।\nततो राज्ञी च सा प्राह नारदं मुनिपुंगवम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004333006, "chapter_id": 24333, "verse_number": "५-३-२७-७", "content_sanskrit": "राज्ञ्युवाच ।\nदानं दत्तं त्वयोक्तं यद्भर्तृकर्मपरं हि तत् ।\nआजन्मजन्म मे भर्ता भवेद्बाणो द्विजोत्तम॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004333007, "chapter_id": 24333, "verse_number": "५-३-२७-८", "content_sanskrit": "नान्यो हि दैवतं तात मुक्त्वा बाणं द्विजोत्तम ।\nतेन सत्येन मे भर्ता जीवेच्च शरदां शतम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004333008, "chapter_id": 24333, "verse_number": "५-३-२७-९", "content_sanskrit": "नान्यो धर्मो भवेत्स्त्रीणां दैवतं हि पतिर्यथा ।\nतथापि तव वाक्येन दानं दत्तं यथाविधि॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004333009, "chapter_id": 24333, "verse_number": "५-३-२७-१०", "content_sanskrit": "स्वकं कर्म करिष्यामो भर्तारं प्रति मानद ।\nब्रह्मर्षे गच्छ चेदानीं त्वमाशीर्वादः प्रदीयताम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004333010, "chapter_id": 24333, "verse_number": "५-३-२७-११", "content_sanskrit": "तथेति तामनुज्ञाप्य नारदो नृपसत्तम ।\nसर्वासां मानसं हृत्वा अन्यतः कृतमानसः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004333011, "chapter_id": 24333, "verse_number": "५-३-२७-१२", "content_sanskrit": "जगामादर्शनं विप्रः पूज्यमानस्तु खेचरैः ।\nततो गतमनस्कास्ता भर्तारं प्रति भारत॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004333012, "chapter_id": 24333, "verse_number": "५-३-२७-१३", "content_sanskrit": "विवर्णा निष्प्रभा जाता नारदेन विमोहिताः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]