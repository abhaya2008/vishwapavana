[{"id": 40023102, "chapter_id": 9423, "verse_number": "1", "content_sanskrit": "शृणु राजन्महासत्व यदर्थमहमागतः । पितामहेन देवेन प्रेषितो ऽस्मि महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40023103, "chapter_id": 9423, "verse_number": "2", "content_sanskrit": "तवाहं पूर्वसद्भावे पुत्रः परपुरञ्जय । मायासम्भावितो वीर कालः सर्वसमाहरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40023104, "chapter_id": 9423, "verse_number": "3", "content_sanskrit": "पितामहश्च भगवानाह लोकपतिः प्रभुः । समयस्ते कृतः सौम्य लोकान्सम्परिरक्षितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40023105, "chapter_id": 9423, "verse_number": "4", "content_sanskrit": "सङ्क्षिप्य हि पुरा लोकान्मायया स्वयमेव हि । महार्णवे शयानो ऽप्सु मां त्वं पूर्वमजीजनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40023106, "chapter_id": 9423, "verse_number": "5", "content_sanskrit": "भोगवन्तं ततो नागमनन्तमुदकेशयम् । मायया जनयित्वा त्वं द्वौ च सत्त्वौ महाबलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40023107, "chapter_id": 9423, "verse_number": "6", "content_sanskrit": "मधुं च कैटभं चैव ययोरस्थिचयैर्वृता । इयं पर्वतसम्बाधा मेदिनी चाभवन्मही ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40023108, "chapter_id": 9423, "verse_number": "7", "content_sanskrit": "पद्मे दिव्ये ऽर्कसङ्काशे नाभ्यामुत्पाद्य मामपि । प्राजापत्यं त्वया कर्म मयि सर्वं निवेशितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40023109, "chapter_id": 9423, "verse_number": "8", "content_sanskrit": "सो ऽहं सन्न्यस्तभारो हि त्वामुपासे जगत्पतिम् । रक्षां विधत्स्व भूतेषु मम तेजस्करो भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40023110, "chapter_id": 9423, "verse_number": "9", "content_sanskrit": "ततस्त्वमपि दुर्धर्षात्तस्माद्भावात्सनातनात् । रक्षार्थं सर्वभूतानां विष्णुत्वमुपजग्मिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40023111, "chapter_id": 9423, "verse_number": "10", "content_sanskrit": "अदित्यां वीर्यवान्पुत्रो भ्रातऽणां वीर्यवर्धनः । समुत्पन्नेषु कृत्येषु तेषां साह्याय कल्पसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40023112, "chapter_id": 9423, "verse_number": "11", "content_sanskrit": "स त्वं वित्रास्यमानासु प्रजासु जगतां वर । रावणस्य वधाकाङ्क्षी मानुषेषु मनो ऽदधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40023113, "chapter_id": 9423, "verse_number": "12", "content_sanskrit": "दश वर्षसहस्राणि दश वर्षशतानि च । कृत्वा वासस्य नियतिं स्वयमेवात्मना पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40023114, "chapter_id": 9423, "verse_number": "13", "content_sanskrit": "स त्वं मनोमयः पुत्रः पूर्णायुर्मानुषेष्विह । कालो ऽयं ते नरश्रेष्ठ समीपमुपवर्तितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40023115, "chapter_id": 9423, "verse_number": "14", "content_sanskrit": "यदि भूयो महाराज प्रजा इच्छस्युपासितुम् । वस वा वीर भद्रं त एवमाह पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40023116, "chapter_id": 9423, "verse_number": "15", "content_sanskrit": "अथ वा विजिगीषा ते सुरलोकाय राघव । सनाथा विष्णुना देवा भवन्तु विगतज्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40023117, "chapter_id": 9423, "verse_number": "16", "content_sanskrit": "श्रुत्वा पितामहेनोक्तं वाक्यं कालसमीरितम् । राघवः प्रहसन्वाक्यं सर्वसंहारमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40023118, "chapter_id": 9423, "verse_number": "17", "content_sanskrit": "श्रुत्वा मे देवदेवस्य वाक्यं परममद्भुतम् । प्रीतिर्हि महती जाता तवागमनसम्भवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40023119, "chapter_id": 9423, "verse_number": "18", "content_sanskrit": "त्रयाणामपि लोकानां कार्यार्थं मम सम्भवः । भद्रं ते ऽस्तु गमिष्यामि यत एवाहमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40023120, "chapter_id": 9423, "verse_number": "19", "content_sanskrit": "हद्गतो ह्यसि सम्प्राप्तो न मे तत्र विचारणा । मया हि सर्वकृत्येषु देवानां वशवर्तिनाम् । स्थातव्यं सर्वसंहार यथा ह्याह पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]