[{"id": 5000423000, "chapter_id": 9423, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे षोडशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000423001, "chapter_id": 9423, "verse_number": "६-१६-१", "content_sanskrit": "सुनिविष्टं हितं वाक्यमुक्तवन्तं विभीषणम्।\nअब्रवीत् परुषं वाक्यं रावणः कालचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000423002, "chapter_id": 9423, "verse_number": "६-१६-२", "content_sanskrit": "वसेत् सह सपत्नेन क्रुद्धेनाशीविषेण च।\nन तु मित्रप्रवादेन संवसेच्छत्रुसेविना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000423003, "chapter_id": 9423, "verse_number": "६-१६-३", "content_sanskrit": "जानामि शीलं ज्ञातीनां सर्वलोकेषु राक्षस।\nहृष्यन्ति व्यसनेष्वेते ज्ञातीनां ज्ञातयः सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000423004, "chapter_id": 9423, "verse_number": "६-१६-४", "content_sanskrit": "प्रधानं साधकं वैद्यं धर्मशीलं च राक्षस।\nज्ञातयोऽप्यवमन्यन्ते शूरं परिभवन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000423005, "chapter_id": 9423, "verse_number": "६-१६-५", "content_sanskrit": "नित्यमन्योन्यसंहृष्टा व्यसनेष्वाततायिनः।\nप्रच्छन्नहृदया घोरा ज्ञातयस्तु भयावहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000423006, "chapter_id": 9423, "verse_number": "६-१६-६", "content_sanskrit": "श्रूयन्ते हस्तिभिर्गीताः श्लोकाः पद्मवने पुरा।\nपाशहस्तान् नरान् दृष्ट्वा शृणुष्व गदतो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000423007, "chapter_id": 9423, "verse_number": "६-१६-७", "content_sanskrit": "नाग्निर्नान्यानि शस्त्राणि न नः पाशा भयावहाः।\nघोराः स्वार्थप्रयुक्तास्तु ज्ञातयो नो भयावहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000423008, "chapter_id": 9423, "verse_number": "६-१६-८", "content_sanskrit": "उपायमेते वक्ष्यन्ति ग्रहणे नात्र संशयः।\nकृत्स्नाद् भयाज्ज्ञातिभयं कुकष्टं विहितं च नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000423009, "chapter_id": 9423, "verse_number": "६-१६-९", "content_sanskrit": "विद्यते गोषु सम्पन्नं विद्यते ज्ञातितो भयम्।\nविद्यते स्त्रीषु चापल्यं विद्यते ब्राह्मणे तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000423010, "chapter_id": 9423, "verse_number": "६-१६-१०", "content_sanskrit": "ततो नेष्टमिदं सौम्य यदहं लोकसत्कृतः।\nऐश्वर्यमभिजातश्च रिपूणां मूर्ध्नि च स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000423011, "chapter_id": 9423, "verse_number": "६-१६-११", "content_sanskrit": "यथा पुष्करपत्रेषु पतितास्तोयबिन्दवः।\nन श्लेषमभिगच्छन्ति तथानार्येषु सौहृदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000423012, "chapter_id": 9423, "verse_number": "६-१६-१२", "content_sanskrit": "यथा शरदि मेघानां सिञ्चतामपि गर्जताम्।\nन भवत्यम्बुसंक्लेदस्तथानार्येषु सौहृदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000423013, "chapter_id": 9423, "verse_number": "६-१६-१३", "content_sanskrit": "यथा मधुकरस्तर्षाद् रसं विन्दन्न तिष्ठति।\nतथा त्वमपि तत्रैव तथानार्येषु सौहृदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000423014, "chapter_id": 9423, "verse_number": "६-१६-१४", "content_sanskrit": "यथा मधुकरस्तर्षात् काशपुष्पं पिबन्नपि।\nरसमत्र न विन्देत तथानार्येषु सौहृदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000423015, "chapter_id": 9423, "verse_number": "६-१६-१५", "content_sanskrit": "यथा पूर्वं गजः स्नात्वा गृह्य हस्तेन वै रजः।\nदूषयत्यात्मनो देहं तथानार्येषु सौहृदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000423016, "chapter_id": 9423, "verse_number": "६-१६-१६", "content_sanskrit": "योऽन्यस्त्वेवंविधं ब्रूयाद् वाक्यमेतन्निशाचर।\nअस्मिन् मुहूर्ते न भवेत् त्वां तु धिक् कुलपांसन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000423017, "chapter_id": 9423, "verse_number": "६-१६-१७", "content_sanskrit": "इत्युक्तः परुषं वाक्यं न्यायवादी विभीषणः।\nउत्पपात गदापाणिश्चतुर्भिः सह राक्षसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000423018, "chapter_id": 9423, "verse_number": "६-१६-१८", "content_sanskrit": "अब्रवीच्च तदा वाक्यं जातक्रोधो विभीषणः।\nअन्तरिक्षगतः श्रीमान् भ्राता वै राक्षसाधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000423019, "chapter_id": 9423, "verse_number": "६-१६-१९", "content_sanskrit": "स त्वं भ्रान्तोऽसि मे राजन् ब्रूहि मां यद् यदिच्छसि।\nज्येष्ठो मान्यः पितृसमो न च धर्मपथे स्थितः।\nइदं हि परुषं वाक्यं न क्षमाम्यग्रजस्य ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000423020, "chapter_id": 9423, "verse_number": "६-१६-२०", "content_sanskrit": "सुनीतं हितकामेन वाक्यमुक्तं दशानन।\nन गृह्णन्त्यकृतात्मानः कालस्य वशमागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000423021, "chapter_id": 9423, "verse_number": "६-१६-२१", "content_sanskrit": "सुलभाः पुरुषा राजन् सततं प्रियवादिनः।\nअप्रियस्य च पथ्यस्य वक्ता श्रोता च दुर्लभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000423022, "chapter_id": 9423, "verse_number": "६-१६-२२", "content_sanskrit": "बद्धं कालस्य पाशेन सर्वभूतापहारिणः।\nन नश्यन्तमुपेक्षे त्वां प्रदीप्तं शरणं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000423023, "chapter_id": 9423, "verse_number": "६-१६-२३", "content_sanskrit": "दीप्तपावकसंकाशैः शितैः काञ्चनभूषणैः।\nन त्वामिच्छाम्यहं द्रष्टुं रामेण निहतं शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000423024, "chapter_id": 9423, "verse_number": "६-१६-२४", "content_sanskrit": "शूराश्च बलवन्तश्च कृतास्त्राश्च नरा रणे।\nकालाभिपन्नाः सीदन्ति यथा वालुकसेतवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000423025, "chapter_id": 9423, "verse_number": "६-१६-२५", "content_sanskrit": "तन्मर्षयतु यच्चोक्तं गुरुत्वाद्धितमिच्छता।\nआत्मानं सर्वथा रक्ष पुरीं चेमां सराक्षसाम्।\nस्वस्ति तेऽस्तु गमिष्यामि सुखी भव मया विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000423026, "chapter_id": 9423, "verse_number": "६-१६-२६", "content_sanskrit": "निवार्यमाणस्य मया हितैषिणा\nन रोचते ते वचनं निशाचर।\nपरान्तकाले हि गतायुषो नरा\nहितं न गृह्णन्ति सुहृद्भिरीरितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000423027, "chapter_id": 9423, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे षोडशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]