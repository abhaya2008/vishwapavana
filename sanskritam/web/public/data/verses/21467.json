[{"id": 7001467000, "chapter_id": 21467, "verse_number": "७-२-५-१", "content_sanskrit": "उपमन्युरुवाच ।\nविग्रहं देवदेवस्य विश्वमेतच्चराचरम् ।\nतदेवं न विजानंति पशवः पाशगौरवात्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001467001, "chapter_id": 21467, "verse_number": "७-२-५-२", "content_sanskrit": "तमेकमेव बहुधा वदंति यदुनंदन ।\nअजानन्तः परं भावमविकल्पं महर्षयः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001467002, "chapter_id": 21467, "verse_number": "७-२-५-३", "content_sanskrit": "अपरं ब्रह्मरूपं च परं ब्रह्मात्मकं तथा ।\nकेचिदाहुर्महादेवमनादिनिधनं परम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001467003, "chapter_id": 21467, "verse_number": "७-२-५-४", "content_sanskrit": "भूतेंद्रियांतःकरणप्रधानविषयात्मकम् ।\nअपरं ब्रह्म निर्दिष्टं परं ब्रह्म चिदात्मकम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001467004, "chapter_id": 21467, "verse_number": "७-२-५-५", "content_sanskrit": "बृहत्त्वाद्बृहणत्वाद्वा ब्रह्म चेत्यभिधीयते ।\nउभे ते ब्रह्मणो रूपे ब्रह्मणो ऽधिपतेः प्रभोः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001467005, "chapter_id": 21467, "verse_number": "७-२-५-६", "content_sanskrit": "विद्या ऽविद्यास्वरूपीति कैश्चिदीशो निगद्यते ।\nविद्यां तु चेतनां प्राहुस्तथाविद्यामचेतनाम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001467006, "chapter_id": 21467, "verse_number": "७-२-५-७", "content_sanskrit": "विद्या ऽविद्यात्मकं चैव विश्वं विश्वगुरोर्विभोः ।\nरूपमेव न संदेहो विश्वं तस्य वशे यतः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001467007, "chapter_id": 21467, "verse_number": "७-२-५-८", "content_sanskrit": "भ्रांतिर्विद्या परा चेति शार्वं रूपं परं विदुः ।\nअयथाबुद्धिरर्थेषु बहुधा भ्रांतिरुच्यते॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001467008, "chapter_id": 21467, "verse_number": "७-२-५-९", "content_sanskrit": "यथार्थाकारसंवित्तिर्विद्येति परिकीर्त्यते ।\nविकल्परहितं तत्त्वं परमित्यभिधीयते॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001467009, "chapter_id": 21467, "verse_number": "७-२-५-१०", "content_sanskrit": "वैपरीत्यादसच्छब्दः कथ्यते वेदवादिभिः ।\nतयोः पतित्वात्तु शिवः सदसत्पतिरुच्यते॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001467010, "chapter_id": 21467, "verse_number": "७-२-५-११", "content_sanskrit": "क्षराक्षरात्मकं प्राहुः क्षराक्षरपरं परे ।\nक्षरस्सर्वाणि भूतानि कूटस्थो ऽक्षर उच्यते॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001467011, "chapter_id": 21467, "verse_number": "७-२-५-१२", "content_sanskrit": "उभे ते परमेशस्य रूपे तस्य वशे यतः ।\nतयोः परः शिवः शांतः क्षराक्षरापरस्स्मृतः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001467012, "chapter_id": 21467, "verse_number": "७-२-५-१३", "content_sanskrit": "समष्टिव्यष्ठिरूपं च समष्टिव्यष्टिकारणम् ।\nवदंति मुनयः केचिच्छिवं परमकारणम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001467013, "chapter_id": 21467, "verse_number": "७-२-५-१४", "content_sanskrit": "समष्टिमाहुरव्यक्तं व्यष्टिं व्यक्तं तथैव च ।\nते रूपे परमेशस्य तदिच्छायाः प्रवर्तनात्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001467014, "chapter_id": 21467, "verse_number": "७-२-५-१५", "content_sanskrit": "तयोः कारणभावेन शिवं परमकारणम् ।\nकारणार्थविदः प्राहुः समष्टिव्यष्टिकारणम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001467015, "chapter_id": 21467, "verse_number": "७-२-५-१६", "content_sanskrit": "जातिव्यक्तिस्वरूपीति कथ्यते कैश्चिदीश्वरः ।\nया पिंडेप्यनुवर्तेत सा जातिरिति कथ्यते॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001467016, "chapter_id": 21467, "verse_number": "७-२-५-१७", "content_sanskrit": "व्यक्तिर्व्यावृत्तिरूपं तं पिण्डजातेः समाश्रयम् ।\nजातयो व्यक्तयश्चैव तदाज्ञापरिपालिताः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001467017, "chapter_id": 21467, "verse_number": "७-२-५-१८", "content_sanskrit": "यतस्ततो महादेवो जातिव्यक्तिवपुः स्मृतः ।\nप्रधानपुरुषव्यक्तकालात्मा कथ्यते शिवः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001467018, "chapter_id": 21467, "verse_number": "७-२-५-१९", "content_sanskrit": "प्रधानं प्रकृतिं प्राहुःक्षेत्रज्ञं पुरुषं तथा ।\nत्रयोविंशतितत्त्वानि व्यक्तमाहुर्मनीषिणः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001467019, "chapter_id": 21467, "verse_number": "७-२-५-२०", "content_sanskrit": "कालः कार्यप्रपञ्चस्य परिणामैककारणम् ।\nएषामीशो ऽधिपो धाता प्रवर्तकनिवर्तकः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001467020, "chapter_id": 21467, "verse_number": "७-२-५-२१", "content_sanskrit": "आविर्भावतिरोभावहेतुरेकः स्वराडजः ।\nतस्मात्प्रधानपुरुषव्यक्तकालस्वरूपवान्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001467021, "chapter_id": 21467, "verse_number": "७-२-५-२२", "content_sanskrit": "हेतुर्नेताधिपस्तेषां धाता चोक्ता महेश्वरः ।\nविराड्ढिरण्यगर्भात्मा कैश्चिदीशो निगद्यते॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001467022, "chapter_id": 21467, "verse_number": "७-२-५-२३", "content_sanskrit": "हिरण्यगर्भो लोकानां हेतुर्विश्वात्मको विराट् ।\nअंतर्यामी परश्चेति कथ्यते कविभिश्शिवः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001467023, "chapter_id": 21467, "verse_number": "७-२-५-२४", "content_sanskrit": "प्राज्ञस्तैजसविश्वात्मेत्यपरे संप्रचक्षते ।\nतुरीयमपरे प्राहुः सौम्यमेव परे विदुः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001467024, "chapter_id": 21467, "verse_number": "७-२-५-२५", "content_sanskrit": "माता मानं च मेयं च मतिं चाहुरथापरे ।\nकर्ता क्रिया च कार्यं च करणं कारणं परे॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001467025, "chapter_id": 21467, "verse_number": "७-२-५-२६", "content_sanskrit": "जाग्रत्स्वप्नसुषुप्त्यात्मेत्यपरे संप्रचक्षते ।\nतुरीयमपरे प्राहुस्तुर्यातीतमितीतरे॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001467026, "chapter_id": 21467, "verse_number": "७-२-५-२७", "content_sanskrit": "तमाहुर्विगुणं केचिद्गुणवन्तं परे विदुः ।\nकेचित्संसारिणं प्राहुस्तमसंसारिणं परे॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001467027, "chapter_id": 21467, "verse_number": "७-२-५-२८", "content_sanskrit": "स्वतंत्रमपरे प्राहुरस्वतंत्रं परे विदुः ।\nघोरमित्यपरे प्राहुः सौम्यमेव परे विदुः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001467028, "chapter_id": 21467, "verse_number": "७-२-५-२९", "content_sanskrit": "रागवंतं परे प्राहुर्वीतरागं तथा परे ।\nनिष्क्रियं च परे प्राहुः सक्रियं चेतरे जनाः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001467029, "chapter_id": 21467, "verse_number": "७-२-५-३०", "content_sanskrit": "निरिंद्रियं परे प्राहुः सेंद्रियं च तथापरे ।\nध्रुवमित्यपरे प्राहुस्तमध्रुवामितीरते॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001467030, "chapter_id": 21467, "verse_number": "७-२-५-३१", "content_sanskrit": "अरूपं केचिदाहुर्वै रूपवंतं परे विदुः ।\nअदृश्यमपरे प्राहुर्दृश्यमित्यपरे विदुः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001467031, "chapter_id": 21467, "verse_number": "७-२-५-३२", "content_sanskrit": "वाच्यमित्यपरे प्राहुरवाच्यमिति चापरे ।\nशब्दात्मकं परे प्राहुश्शब्दातीतमथापरे॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001467032, "chapter_id": 21467, "verse_number": "७-२-५-३३", "content_sanskrit": "केचिच्चिन्तामयं प्राहुश्चिन्तया रहितं परे ।\nज्ञानात्मकं परे प्राहुर्विज्ञानमिति चापरे॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001467033, "chapter_id": 21467, "verse_number": "७-२-५-३४", "content_sanskrit": "केचिच्ज्ञेयमिति प्राहुरज्ञेयमिति केचन ।\nपरमेके तमेवाहुरपरं च तथा परे॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001467034, "chapter_id": 21467, "verse_number": "७-२-५-३५", "content_sanskrit": "एवं विकल्प्यमानं तु याथात्म्यं परमेष्ठिनः ।\nनाध्यवस्यंति मुनयो नानाप्रत्ययकारणात्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001467035, "chapter_id": 21467, "verse_number": "७-२-५-३६", "content_sanskrit": "ये पुनस्सर्वभावेन प्रपन्नाः परमेश्वरम् ।\nते हि जानंत्ययत्नेन शिवं परमकारणम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001467036, "chapter_id": 21467, "verse_number": "७-२-५-३७", "content_sanskrit": "यावत्पशुर्नैव पश्यत्यनीशं १ पुराणं भुवनस्येशितारम् ।\nतावद्दुःखे वर्तते बद्धपाशः संसारे ऽस्मिञ्चक्रनेमिक्रमेण॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001467037, "chapter_id": 21467, "verse_number": "७-२-५-३८", "content_sanskrit": "यदा २ पश्यः पश्यते रुक्मवर्णं कर्तारमीशं पुरुषं ब्रह्मयोनिम् ।\nतदाविद्वान्पुण्यपापे विधूय निरंजनः परममुपैति साम्यम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]