[{"id": 7000932000, "chapter_id": 20932, "verse_number": "७-२०-१", "content_sanskrit": "व्यास उवाच ।\nविष्णुपूजाफलं विप्र संक्षेपात्कथितं मया ।\nइदानीं वच्मि दानानि निशामय समाहितः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000932001, "chapter_id": 20932, "verse_number": "७-२०-२", "content_sanskrit": "दानं तपो द्वयोर्मध्ये दानमेकं परं स्मृतम् ।\nतपसा पापमित्युक्तं न पापो दानकर्मणि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000932002, "chapter_id": 20932, "verse_number": "७-२०-३", "content_sanskrit": "तपः कृतयुगे श्रेष्ठं त्रेतायां ध्यानमेव च ।\nसपर्या द्वापरे श्रेष्ठा दानं श्रेष्ठं कलौ युगे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000932003, "chapter_id": 20932, "verse_number": "७-२०-४", "content_sanskrit": "तस्मात्कलियुगे दानं प्रीतये कमलापतेः ।\nकर्तव्यं सततं प्राज्ञैरिच्छद्भिः परमं पदम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000932004, "chapter_id": 20932, "verse_number": "७-२०-५", "content_sanskrit": "कलया कलया चन्द्र कलां संवर्द्धते तथा ।\nदानस्य सा गतिः प्रोक्ता तपसश्च मनीषिभिः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000932005, "chapter_id": 20932, "verse_number": "७-२०-६", "content_sanskrit": "पलादपि द्विजश्रेष्ठ कर्तव्यो वित्तसंग्रहः ।\nसंचितं तु धनं प्राज्ञो दानकर्मणि संक्षिपेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000932006, "chapter_id": 20932, "verse_number": "७-२०-७", "content_sanskrit": "धने स्थितोपि यो मर्त्यो नाश्नाति न ददाति यः ।\nदरिद्र सः च विज्ञेयो दानभोगविवर्जितः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000932007, "chapter_id": 20932, "verse_number": "७-२०-८", "content_sanskrit": "वित्तं केन सहायाति याति तेन तु को द्विज ।\nआयाति तत्पुरा दत्तमिह पंचत्वमागते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000932008, "chapter_id": 20932, "verse_number": "७-२०-९", "content_sanskrit": "दत्वा दत्वा सदा दानं मानवा ये दरिद्रति ।\nन ते दरिद्रा विज्ञेयाः परलोके महेश्वराः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000932009, "chapter_id": 20932, "verse_number": "७-२०-१०", "content_sanskrit": "धनं रक्षंति कार्पण्याद्ये ते ज्ञेयाः सुदुःखिताः ।\nअंते त्यक्त्वा च तत्सर्वं निराशा यांति जैमिने ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000932010, "chapter_id": 20932, "verse_number": "७-२०-११", "content_sanskrit": "परलोके द्विजश्रेष्ठः साधुसद्बलवर्जितः ।\nनिर्द्धने बंधुहीने च नादत्तमुपतिष्ठते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000932011, "chapter_id": 20932, "verse_number": "७-२०-१२", "content_sanskrit": "स्तोकं स्तोकं च विप्रेन्द्र भक्तिश्रद्धासमन्वितः ।\nनित्यं देयानि दानानि वैष्णवैर्निजभक्तितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000932012, "chapter_id": 20932, "verse_number": "७-२०-१३", "content_sanskrit": "सर्वेषामेव दानानामन्नदानं द्विजोत्तम ।\nजलदानं च तत्वज्ञैरतिश्रेष्ठं प्रकीर्तितम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000932013, "chapter_id": 20932, "verse_number": "७-२०-१४", "content_sanskrit": "विनान्नेन न तिष्ठंति प्राणा देहेषु देहिनाम् ।\nअन्नदः प्राणदो ज्ञेयः प्राणदः सकलप्रदः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000932014, "chapter_id": 20932, "verse_number": "७-२०-१५", "content_sanskrit": "तस्मात्समस्तदानानामन्नदो लभते फलम् ।\nअन्नदानसमं दानं जलदानं च जैमिने ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000932015, "chapter_id": 20932, "verse_number": "७-२०-१६", "content_sanskrit": "विना तोयेन नान्नं स्यादतस्तोयं प्रदीयते ।\nक्षुधा तृषापि विप्रेन्द्र द्वे तुल्ये तु प्रकीर्तिते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000932016, "chapter_id": 20932, "verse_number": "७-२०-१७", "content_sanskrit": "तस्माद्दत्वा च तोयं च श्रेष्ठं प्रोक्तं मनीषिभिः ।\nजीवनं जीवनं नॄणां जीवनं न च जीवनम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000932017, "chapter_id": 20932, "verse_number": "७-२०-१८", "content_sanskrit": "अतो जीवनरक्षार्थं जीवनं प्राज्ञ उत्सृजेत् ।\nअन्नं तोयं च विप्रेन्द्र दत्तं येन महीतले ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000932018, "chapter_id": 20932, "verse_number": "७-२०-१९", "content_sanskrit": "तेन सर्वाणि दानानि कृतानि नात्र संशयः ।\nअन्नदानस्य माहात्म्यं जलदानस्य वै शृणु ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000932019, "chapter_id": 20932, "verse_number": "७-२०-२०", "content_sanskrit": "बभूव हास्तिनपुरे कुबेर इव वित्तवान् ।\nतस्मिन्नेव पुरे वेश्या बभूव सुरसुंदरी ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000932020, "chapter_id": 20932, "verse_number": "७-२०-२१", "content_sanskrit": "ख्याता रतिविदग्धेति सर्वलक्षणसंयुता ।\nतत्र क्षेमंकरी नाम ब्राह्मणी श्रेष्ठवंशजा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000932021, "chapter_id": 20932, "verse_number": "७-२०-२२", "content_sanskrit": "समस्तगुणसम्पन्ना विधवासीद्द्विजात्मजा ।\nसा ब्राह्मणी द्विजश्रेष्ठ जारानुरक्तमानसा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000932022, "chapter_id": 20932, "verse_number": "७-२०-२३", "content_sanskrit": "निषिद्धं कर्म कुर्वंती त्यक्त्वा यात्यविवेकताम् ।\nतया संनिहिता विप्र वेश्यापि ब्राह्मणी च सा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000932023, "chapter_id": 20932, "verse_number": "७-२०-२४", "content_sanskrit": "चकार सख्यं स्नेहेन वेश्यावृत्तिमुपेत्य सा ।\nसा वेश्या ब्राह्मणी चापि द्वेऽप्येकत्र दिने दिने ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000932024, "chapter_id": 20932, "verse_number": "७-२०-२५", "content_sanskrit": "पापानि चक्रतुः प्रीत्या असंख्यातानि जैमिने ।\nततो रतिविदग्धा सा वृद्धभावमुपागता ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000932025, "chapter_id": 20932, "verse_number": "७-२०-२६", "content_sanskrit": "ब्राह्मणी चापि विप्रेन्द्र दुःशीलात्यंतपापिनी ।\nकदाचिद्वारमुख्या सा जरंती तां निजां सखीम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000932026, "chapter_id": 20932, "verse_number": "७-२०-२७", "content_sanskrit": "प्राहेति विस्मिता विप्र वचनं विनयान्विता ।\nरतिविदग्धोवाच ।\nसखि त्वया सहानेकं दारुणं पातकं कृतम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000932027, "chapter_id": 20932, "verse_number": "७-२०-२८", "content_sanskrit": "अद्यापि पातके दृष्टिर्महती वर्तते मम ।\nसौन्दर्यं च बलं चैव सर्वं मे जरया हृतम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000932028, "chapter_id": 20932, "verse_number": "७-२०-२९", "content_sanskrit": "इत्थमस्वास्थ्यकृन्नित्यमाशां त्यक्तुं न शक्यते ।\nस्थावरं सुमहत्प्राप्तं कृतपातकया मया ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000932029, "chapter_id": 20932, "verse_number": "७-२०-३०", "content_sanskrit": "समागतमिवैतर्हि समीक्ष्य मरणं गतम् ।\nउपार्जितेन पापेन यानि वित्तानि वै मया ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000932030, "chapter_id": 20932, "verse_number": "७-२०-३१", "content_sanskrit": "रक्षिष्यंत्यनपत्यायां मृतायां मयि तानि के ।\nतस्मात्सर्वाणि वित्तानि अन्यायोपार्जितानि च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000932031, "chapter_id": 20932, "verse_number": "७-२०-३२", "content_sanskrit": "दातुमिच्छामि विप्रेभ्यो यदि त्वं मन्यसे सखि ।\nब्राह्मण्युवाच ।\nमया यावन्ति वित्तानि पश्येति संचितानि च ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000932032, "chapter_id": 20932, "verse_number": "७-२०-३३", "content_sanskrit": "असत्पात्रेषु दत्तानि तानि सर्वाणि नित्यशः ।\nतस्मादहं धनैर्हीना किं दास्यामि द्विजातये ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000932033, "chapter_id": 20932, "verse_number": "७-२०-३४", "content_sanskrit": "अस्ति चेद्यदि वित्तं ते दानमाशु तदा कुरु ।\nतस्या एवं वचः श्रुत्वा सा वेश्यात्यंतहर्षिता ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000932034, "chapter_id": 20932, "verse_number": "७-२०-३५", "content_sanskrit": "वित्तेन सकलेनैव अन्नदानं चकार ह ।\nहरिशर्मा च विप्रेन्द्रो धनवानतिभक्तितः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000932035, "chapter_id": 20932, "verse_number": "७-२०-३६", "content_sanskrit": "पूजयामास सततं भगवंतं जनार्दनम् ।\nजितेन्द्रियो जितक्रोधो हिंसादम्भविवर्जितः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000932036, "chapter_id": 20932, "verse_number": "७-२०-३७", "content_sanskrit": "प्रीतये कमलाभर्तुः स तेपे सुमहत्तपः ।\nगंधपुष्पैश्च बलिभिर्घृतधूपैः प्रदीपकैः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000932037, "chapter_id": 20932, "verse_number": "७-२०-३८", "content_sanskrit": "पूजयामास देवेशं नित्यमेव जनार्दनम् ।\nधनवानपि विप्रोऽसौ वित्तस्य क्षयशंकितः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000932038, "chapter_id": 20932, "verse_number": "७-२०-३९", "content_sanskrit": "पिपीलिकामूषिकाश्च तथान्येऽपि च जंतवः ।\nकृपणस्य द्विजश्रेष्ठ गृहे नित्यं बुभुक्षिताः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000932039, "chapter_id": 20932, "verse_number": "७-२०-४०", "content_sanskrit": "उपार्जितं धनं सर्वं स्वयमेव दिनेदिने ।\nबुभुजे ब्राह्मणश्रेष्ठ दानकर्मविवर्जितः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000932040, "chapter_id": 20932, "verse_number": "७-२०-४१", "content_sanskrit": "सुहृदां ब्राह्मणानां च बांधवानां कदापि सः ।\nचकार न च संभाषामर्थप्रार्थनशंकया ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000932041, "chapter_id": 20932, "verse_number": "७-२०-४२", "content_sanskrit": "विगणय्य स्ववित्तानि सुबहूनि निजालये ।\nमत्वा श्रेष्ठमिवात्मानं मोदतेऽसौ द्विजोत्तम ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000932042, "chapter_id": 20932, "verse_number": "७-२०-४३", "content_sanskrit": "कदाचित्प्राप्तकालोऽसौ ब्राह्मणोऽत्यंतवित्तवान् ।\nगणिका ब्राह्मणी सा च एककाले मृता द्विज ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000932043, "chapter_id": 20932, "verse_number": "७-२०-४४", "content_sanskrit": "अथ दूताः समायातास्तान्नेतुमतिभीषणाः ।\nधर्मराजस्य देवस्य पाशमुद्गरपाणयः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000932044, "chapter_id": 20932, "verse_number": "७-२०-४५", "content_sanskrit": "ते च चण्डादयो दूतास्तान्समादाय जैमिने ।\nययुर्धर्मपुरं सद्यो दुर्गमेन पथा ततः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000932045, "chapter_id": 20932, "verse_number": "७-२०-४६", "content_sanskrit": "चण्ड उवाच ।\nआनीतो हरिशर्मा च वेश्या च ब्राह्मणी च सा ।\nतवाज्ञया जीवितेश पश्यैतान्पुरतः स्थितान् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000932046, "chapter_id": 20932, "verse_number": "७-२०-४७", "content_sanskrit": "तान्समालोक्य जीवेशः प्रहस्य द्विजसत्तम ।\nचित्रगुप्तमिति प्राह सर्वकार्यविचक्षणम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000932047, "chapter_id": 20932, "verse_number": "७-२०-४८", "content_sanskrit": "यम उवाच ।\nएतेषां सर्वकार्याणि शुभदान्यशुभानि च ।\nमूलाद्विचारय प्राज्ञ चित्रगुप्त महामते ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000932048, "chapter_id": 20932, "verse_number": "७-२०-४९", "content_sanskrit": "यमादेशात्ततस्तेषां चित्रगुप्तो विचक्षणः ।\nसर्वं विचारयामास शुभकर्माशुभं तथा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000932049, "chapter_id": 20932, "verse_number": "७-२०-५०", "content_sanskrit": "चित्रगुप्त उवाच ।\nदेवाकर्णय वक्ष्यामि पुण्यं च पातकं तथा ।\nइयं वेश्या ब्राह्मणी च हरिशर्मा चकार यत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000932050, "chapter_id": 20932, "verse_number": "७-२०-५१", "content_sanskrit": "एषा रतिविदग्धाख्या गणिकाति दुराशया ।\nचकार यानि पापानि वक्तुं तानि न शक्यते ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000932051, "chapter_id": 20932, "verse_number": "७-२०-५२", "content_sanskrit": "अन्यायोपार्जितैर्वित्तैरखिलैरेव सूर्यज ।\nअन्नदानं चकारेयं गणिका गतयौवना ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000932052, "chapter_id": 20932, "verse_number": "७-२०-५३", "content_sanskrit": "अन्नदानप्रभावेण यातनागृहवासदैः ।\nत्यक्तेयं पातकैः सर्वैः कोटिजन्मार्जितैरपि ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000932053, "chapter_id": 20932, "verse_number": "७-२०-५४", "content_sanskrit": "अन्नदानं महाराज ये कुर्वंति जनाः क्षितौ ।\nते पापिनोऽपि गच्छंति तद्विष्णोः परमं पदम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000932054, "chapter_id": 20932, "verse_number": "७-२०-५५", "content_sanskrit": "यावन्त्यन्नानि यच्छंति मानवाः क्षितिमण्डले ।\nतावंत्यो ब्रह्महत्याश्च तस्य नश्यंत्यसंशयः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000932055, "chapter_id": 20932, "verse_number": "७-२०-५६", "content_sanskrit": "अन्नानि यच्छतां त्यक्त्वा शरीराणि च पातकम् ।\nगृह्णतामेव पात्राणि सहसा याति सूर्यज ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000932056, "chapter_id": 20932, "verse_number": "७-२०-५७", "content_sanskrit": "तस्मात्पापिनामन्नानि न गृह्णंति विचक्षणाः ।\nमोहाद्गृह्णंति ये मूढास्त एव पापभागिनः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000932057, "chapter_id": 20932, "verse_number": "७-२०-५८", "content_sanskrit": "शुभकर्माशुभं वापि वेश्यायाः कथितं प्रभो ।\nब्राह्मण्याः शृणु कर्माणि शुभानि चाशुभानि च ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000932058, "chapter_id": 20932, "verse_number": "७-२०-५९", "content_sanskrit": "इयं क्षेमंकरी नाम ब्राह्मणी शुद्धवंशजा ।\nभद्रकीर्तिप्रिया सर्वं चकार दुरितं प्रभो ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000932059, "chapter_id": 20932, "verse_number": "७-२०-६०", "content_sanskrit": "त्यक्त्वा निजाश्रमाचारं निजयौवनगर्विता ।\nबभूवात्यंतपापिष्ठा जारसंगमलोलुपा ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000932060, "chapter_id": 20932, "verse_number": "७-२०-६१", "content_sanskrit": "कदाचिच्छैशवे राजन्खेलंती शिशुभिः सह ।\nरथ्यायां खननं चक्रे चतुष्कोणसमन्वितम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000932061, "chapter_id": 20932, "verse_number": "७-२०-६२", "content_sanskrit": "तस्मिन्नेव दिने मेघ उदकानि ववर्ष च ।\nपूरितं तज्जलैः खातं तया विनिर्मितं प्रभो ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000932062, "chapter_id": 20932, "verse_number": "७-२०-६३", "content_sanskrit": "ततो मध्याह्नसमये गौरेकस्तृषितो नृप ।\nअपिबत्तत्र पानीयं तापितस्तपनातपैः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000932063, "chapter_id": 20932, "verse_number": "७-२०-६४", "content_sanskrit": "तेनैव सर्वपापानि विनष्टानि महांति वै ।\nतस्याः सूर्यसुत प्राज्ञ जलदानप्रभावतः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000932064, "chapter_id": 20932, "verse_number": "७-२०-६५", "content_sanskrit": "विमुक्ताः सकलैः पापैर्व्रजेन्नारायणालयम् ।\nकृतपापा हि देवेश ब्राह्मणीयं दुराशया ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000932065, "chapter_id": 20932, "verse_number": "७-२०-६६", "content_sanskrit": "विमुक्ता सकलैः पापैर्जलदानप्रभावतः ।\nअयं विप्रो महाभक्तो देवदेवस्य चक्रिणः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000932066, "chapter_id": 20932, "verse_number": "७-२०-६७", "content_sanskrit": "ततोऽस्योपरि जीवेश प्रभुरेकोऽच्युतः स्मृतः ।\nव्यास उवाच ।\nचित्रगुप्तस्य तद्वाक्यं समाकर्ण्य स दंडभृत् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000932067, "chapter_id": 20932, "verse_number": "७-२०-६८", "content_sanskrit": "तां वेश्यां ब्राह्मणीं चापि ववंदे ब्राह्मणं च तम् ।\nदिव्यैः सुवर्णालंकारैर्वस्त्रैर्नानाविधैस्तथा ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000932068, "chapter_id": 20932, "verse_number": "७-२०-६९", "content_sanskrit": "तेषां पूजां यमः श्रुत्वा कुटुंबिनां च जैमिने ।\nउवाच प्रहसन्वाक्यं सुप्रीतो मृदुलाक्षरम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000932069, "chapter_id": 20932, "verse_number": "७-२०-७०", "content_sanskrit": "यम उवाच ।\nयूयं सर्वे महात्मानो विनष्टाखिलपातकाः ।\nसमस्तसुखदं स्थानं गच्छत श्रीपतेः प्रभोः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000932070, "chapter_id": 20932, "verse_number": "७-२०-७१", "content_sanskrit": "तानारोप्य ततो दिव्ये यमः कांचननिर्मिते ।\nराजहंसयुते स्थाने प्रेषयामास चक्रिणः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000932071, "chapter_id": 20932, "verse_number": "७-२०-७२", "content_sanskrit": "ततो दिव्यरथारूढाः सर्वाभरणभूषिताः ।\nपुरं भगवतो जग्मुस्ते सर्वे गतपातकाः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000932072, "chapter_id": 20932, "verse_number": "७-२०-७३", "content_sanskrit": "गणिका ब्राह्मणी सा च विनष्टाखिलकल्मषा ।\nसान्निध्यं प्राप्य देवस्य तस्थौ विप्र चिरं सुखम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000932073, "chapter_id": 20932, "verse_number": "७-२०-७४", "content_sanskrit": "हरिशर्माणमालोक्य समायांतं जनार्द्दनः ।\nददौ वरासनं तस्मै स्नेहात्कनकनिर्मितम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000932074, "chapter_id": 20932, "verse_number": "७-२०-७५", "content_sanskrit": "पाद्यार्घ्याचमनीयैश्च तमभ्यर्च द्विजोत्तमम् ।\nवरासनोपविष्टं च पप्रच्छेति मुदा हरिः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000932075, "chapter_id": 20932, "verse_number": "७-२०-७६", "content_sanskrit": "श्रीभगवानुवाच ।\nद्विजन्म कुशलं ब्रूहि मद्भक्तप्रवरोऽसि यत् ।\nचिरं मे मंदिरं तिष्ठ सर्वोपद्रववर्जिते ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000932076, "chapter_id": 20932, "verse_number": "७-२०-७७", "content_sanskrit": "ब्राह्मण उवाच ।\nत्वां स्मृत्वापीक्षितो देव लभते कुशलं प्रभो ।\nत्वत्सान्निध्यं मया प्राप्तं कुशलं किमतः परम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000932077, "chapter_id": 20932, "verse_number": "७-२०-७८", "content_sanskrit": "व्यास उवाच ।\nएतस्य वचनं श्रुत्वा भगवान्प्रणयोदितम् ।\nदत्तवान्निजसारूप्यं प्रीतस्तस्मै द्विजन्मने ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000932078, "chapter_id": 20932, "verse_number": "७-२०-७९", "content_sanskrit": "ददौ तस्मै सुखं सर्वं दुर्ल्लभं कमलापतिः ।\nआहारमात्रं न ददौ तत्कार्पण्यं स्मरन्प्रभुः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000932079, "chapter_id": 20932, "verse_number": "७-२०-८०", "content_sanskrit": "दिनद्वयांतरे विप्रो निराहारः क्षुधाकुलः ।\nप्रोवाच विष्णुं देवेशं विनयावनतः स्थितः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000932080, "chapter_id": 20932, "verse_number": "७-२०-८१", "content_sanskrit": "ब्राह्मण उवाच ।\nप्रभोप्राप्तंतवस्थानमनेकतपसांफलैः ।\nअत्रापि क्षुधया नित्यं विफलोऽस्मि कथं प्रभो ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000932081, "chapter_id": 20932, "verse_number": "७-२०-८२", "content_sanskrit": "देवकन्या गणैर्दिव्यैः संप्राप्तनवयौवनैः ।\nश्वेतचामरवातेन मंचेष्वपि निवीजितः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000932082, "chapter_id": 20932, "verse_number": "७-२०-८३", "content_sanskrit": "सुगंधानां प्रसूनानां महास्रग्भिरलंकृतः ।\nचंदनैर्लिप्तसर्वांगो राजश्रेष्ठ इव प्रभो ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000932083, "chapter_id": 20932, "verse_number": "७-२०-८४", "content_sanskrit": "चार्वङ्गीभिः कामिनीभिर्नित्यं मत्पुरतः प्रभो ।\nगीतेन नृत्यते चापि नारायण तवाज्ञया ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000932084, "chapter_id": 20932, "verse_number": "७-२०-८५", "content_sanskrit": "वासवाद्याः सुराः सर्वे रजांसि मम पादयोः ।\nशिरः किरीटशोभीनि नित्यमेव वहंति वै ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000932085, "chapter_id": 20932, "verse_number": "७-२०-८६", "content_sanskrit": "देवदेवर्षयश्चापि मुनयश्च जगत्पते ।\nस्तुवंति मां स्तवैर्नित्यं किंकरा इव सर्वदा ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000932086, "chapter_id": 20932, "verse_number": "७-२०-८७", "content_sanskrit": "चतुर्बाहुरहं श्यामः शङ्खचक्रगदाब्जभृत् ।\nप्रफुल्लपुण्डरीकाक्षः पीतवासाः सुकुण्डलः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000932087, "chapter_id": 20932, "verse_number": "७-२०-८८", "content_sanskrit": "स्वर्णयज्ञोपवीती च किरीटी कुण्डली तथा ।\nदृश्ये त्वमिव देवाद्यैर्द्वितीयो गरुडध्वजः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000932088, "chapter_id": 20932, "verse_number": "७-२०-८९", "content_sanskrit": "सुखान्येतानि दत्तानि दुर्ल्लभानि त्वया प्रभो ।\nददासि कथमाहारं न मह्यं परमेश्वर ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000932089, "chapter_id": 20932, "verse_number": "७-२०-९०", "content_sanskrit": "क्षुधाग्निना च सुमहच्छरीरं मम दह्यते ।\nयथैव ज्वलितो वृक्षः कोटरस्थेन वह्निना ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000932090, "chapter_id": 20932, "verse_number": "७-२०-९१", "content_sanskrit": "सुखमेतत्त्वया दत्तं हरे मह्यं न रोचते ।\nप्रज्वलज्जठराग्नौ तु विह्वलाङ्गाय केशव ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000932091, "chapter_id": 20932, "verse_number": "७-२०-९२", "content_sanskrit": "कर्मणा मनसा वाचा त्वां विना जगदीश्वरम् ।\nन पूजितो मया कश्चिद्देवदेव गणार्चितः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000932092, "chapter_id": 20932, "verse_number": "७-२०-९३", "content_sanskrit": "स्वप्नेनापि जगन्नाथ तस्य भक्तिः कृता नहि ।\nआहारं केन दोषेण ददासि नहि मे प्रभो ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000932093, "chapter_id": 20932, "verse_number": "७-२०-९४", "content_sanskrit": "व्यास उवाच ।\nअथासौ भगवान्विष्णुः कौतुकी समुवाच तम् ।\nगच्छ ब्राह्मण भद्रं ते ब्रह्माणं प्रति सत्वरम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000932094, "chapter_id": 20932, "verse_number": "७-२०-९५", "content_sanskrit": "इति श्रुत्वा वचो विप्रः शीघ्रं ब्रह्माणमाययौ ।\nब्रह्मा तं प्रति प्रोवाच कार्पण्यं तस्य दर्शयन् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000932095, "chapter_id": 20932, "verse_number": "७-२०-९६", "content_sanskrit": "ब्रह्मोवाच ।\nदुःखादुपार्जितं कर्म दीयते यन्न भूसुरे ।\nस्वयं न भुंजते तच्च नष्टमेव न संशयः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000932096, "chapter_id": 20932, "verse_number": "७-२०-९७", "content_sanskrit": "कारणं तव दुःखस्य सर्वमेव मयोदितम् ।\nगच्छ ब्राह्मण भद्रं ते निःसंदेहोयमागतः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000932097, "chapter_id": 20932, "verse_number": "७-२०-९८", "content_sanskrit": "ब्राह्मण उवाच ।\nनिजकर्मविपाकोऽयं त्वत्प्रसादाच्छ्रुतोऽखिलः ।\nइदानीं ब्रूहि दानानि कानि देयानि मानवैः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000932098, "chapter_id": 20932, "verse_number": "७-२०-९९", "content_sanskrit": "ब्रह्मोवाच ।\nबहूनि संति दानानि तानि वक्तुं न शक्यते ।\nसंक्षेपात्कथ्यते विप्र निशामय समाहितः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000932099, "chapter_id": 20932, "verse_number": "७-२०-१००", "content_sanskrit": "भूमिदानं द्विजश्रेष्ठ सर्वदानोत्तमोत्तमम् ।\nकृतं पुण्यात्मना येन स ज्ञेयः सर्वदानकृत् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000932100, "chapter_id": 20932, "verse_number": "७-२०-१०१", "content_sanskrit": "गोचर्ममात्रं भूमिं यो ददाति द्विजसत्तम ।\nस गच्छेत्परमं स्थानं विमुक्तः सर्वपातकैः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000932101, "chapter_id": 20932, "verse_number": "७-२०-१०२", "content_sanskrit": "भूमिं सस्यसमेतां यो दरिद्राय द्विजातये ।\nददाति ब्राह्मणश्रेष्ठ तस्य पुण्यं निशामय ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000932102, "chapter_id": 20932, "verse_number": "७-२०-१०३", "content_sanskrit": "सर्वपापविनिर्मुक्तो नारायणपुरं व्रजेत् ।\nतत्र भुंक्ते सुखं सर्वं यावदिंद्राश्चतुर्दश ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000932103, "chapter_id": 20932, "verse_number": "७-२०-१०४", "content_sanskrit": "भूयो भूमिं समासाद्य सार्वभौमो नृपो भवेत् ।\nचिरं भुक्त्वा महीं कृत्स्नां नरो नारायणो भवेत् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000932104, "chapter_id": 20932, "verse_number": "७-२०-१०५", "content_sanskrit": "यस्माद्भूमिर्द्विजैर्ग्राह्या त्यक्त्वा दानशतान्यपि ।\nभूमिदो भूमिनेता च द्वावपि स्वर्गगामिनौ ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000932105, "chapter_id": 20932, "verse_number": "७-२०-१०६", "content_sanskrit": "मंदबुर्द्धिर्द्विजो यस्तु भूमिदानं परित्यजेत् ।\nप्रतिजन्मनि विप्रेन्द्र स भवेदतिदुःखितः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000932106, "chapter_id": 20932, "verse_number": "७-२०-१०७", "content_sanskrit": "अन्येभ्योऽपि समादाय भूमिदानं य आचरेत् ।\nतस्य विष्णुरति प्रीतो ददाति परमं पदम् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000932107, "chapter_id": 20932, "verse_number": "७-२०-१०८", "content_sanskrit": "ग्रामं यच्छति यो विप्र दरिद्राय द्विजातये ।\nदापयत्यपि वा तस्य पुण्यं वापि निशामय ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000932108, "chapter_id": 20932, "verse_number": "७-२०-१०९", "content_sanskrit": "यावंतो रेणवो भूमौ यावंतो वृष्टिबिंदवः ।\nमन्वंतराणि तावंति विष्णुलोके वसेत्सुधीः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000932109, "chapter_id": 20932, "verse_number": "७-२०-११०", "content_sanskrit": "धेनुं पयस्विनीं यस्तु सवत्सां यच्छति द्विज ।\nतस्य ब्रवीम्यहं पुण्यमाकर्णय महात्मनः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000932110, "chapter_id": 20932, "verse_number": "७-२०-१११", "content_sanskrit": "सप्तद्वीपां महीं दत्वा ससस्यां यत्फलं लभेत् ।\nतत्फलं लभते मर्त्यो धेनुं यच्छन्द्विजातये ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7000932111, "chapter_id": 20932, "verse_number": "७-२०-११२", "content_sanskrit": "ददाति वृषभं यस्तु ब्राह्मणाय कुटुंबिने ।\nविमुक्तः पातकै रुद्रै रुद्रलोकं स गच्छति ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7000932112, "chapter_id": 20932, "verse_number": "७-२०-११३", "content_sanskrit": "तस्य यावंति रोमाणि शरीरे वृषभस्य च ।\nतावत्कल्पसहस्राणि रुद्रेण सह मोदते ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7000932113, "chapter_id": 20932, "verse_number": "७-२०-११४", "content_sanskrit": "यस्तु वेदविदे धेनुं दद्यादुभयतोमुखीम् ।\nन तस्य पुनरावृत्ती रुद्रलोकात्कदाचन ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7000932114, "chapter_id": 20932, "verse_number": "७-२०-११५", "content_sanskrit": "वृषं तिलसमायुक्तं कृष्णं यस्तु प्रयच्छति ।\nस रुद्रभवने तिष्ठेद्द्विजेन्द्र तिलसंख्यया ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7000932115, "chapter_id": 20932, "verse_number": "७-२०-११६", "content_sanskrit": "तिलप्रमाणमपि च स्वर्णं दद्याद्द्विजातये ।\nस याति विष्णुभवनं कुलकोटिसमन्वितः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7000932116, "chapter_id": 20932, "verse_number": "७-२०-११७", "content_sanskrit": "यो भक्त्या रजतं यच्छेद्दरिद्राय द्विजातये ।\nचंद्रलोकं समासाद्य सुधापानं करोति सः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7000932117, "chapter_id": 20932, "verse_number": "७-२०-११८", "content_sanskrit": "हीरकं मौक्तिकं चापि प्रवालं च मणिं तथा ।\nयो ददाति द्विजश्रेष्ठ शक्रलोकं स गच्छति ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7000932118, "chapter_id": 20932, "verse_number": "७-२०-११९", "content_sanskrit": "अश्वदानं द्विजश्रेष्ठ यः करोति महाशयः ।\nगन्धर्वराजराजत्वं स प्राप्नोति न संशयः ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7000932119, "chapter_id": 20932, "verse_number": "७-२०-१२०", "content_sanskrit": "ददाति वारणं यस्तु युवानं दोषवर्जितम् ।\nदेवराज्ये विभागी स भवेदिन्द्र इव द्विज ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7000932120, "chapter_id": 20932, "verse_number": "७-२०-१२१", "content_sanskrit": "नरदोलां च यो दद्याद्ब्राह्मणाय सदक्षिणाम् ।\nसोऽपीन्द्रपदमासाद्य वसेत्कल्पचतुष्टयम् ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7000932121, "chapter_id": 20932, "verse_number": "७-२०-१२२", "content_sanskrit": "शालिग्रामशिलादानं यो ददाति द्विजातये ।\nतस्य पुण्यं प्रवक्ष्यामि समासेन शृणु द्विज ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7000932122, "chapter_id": 20932, "verse_number": "७-२०-१२३", "content_sanskrit": "सप्तद्वीपां महीं दत्वा सशैलवनकाननाम् ।\nयत्फलं तच्च लभते शालग्रामशिलाप्रदः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7000932123, "chapter_id": 20932, "verse_number": "७-२०-१२४", "content_sanskrit": "तुलापुरुषदानेन यत्फलं प्राप्यते नरैः ।\nशालग्रामशिलां यच्छंस्तस्मात्कोटिगुणं लभेत् ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7000932124, "chapter_id": 20932, "verse_number": "७-२०-१२५", "content_sanskrit": "शालग्रामशिला येन प्रदत्ता द्विजसत्तम ।\nनूनं तेन प्रदत्तानि भुवनानि चतुर्दश ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7000932125, "chapter_id": 20932, "verse_number": "७-२०-१२६", "content_sanskrit": "तुलापुरुषदानं यः प्रकरोति नरोत्तम ।\nदिवि दिव्यांबरधरश्चिरं स च महीपतिः ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7000932126, "chapter_id": 20932, "verse_number": "७-२०-१२७", "content_sanskrit": "जननीजठरे भूयस्तस्य जन्म न विद्यते ।\nददाति यस्तु वै कन्यां सालंकारां नरोत्तमः ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7000932127, "chapter_id": 20932, "verse_number": "७-२०-१२८", "content_sanskrit": "स गच्छेद्विष्णुभवनं पुनरावृत्तिवर्जितः ।\nयः कन्याविक्रयं मूढो मोहात्प्रकुरुते नरः ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7000932128, "chapter_id": 20932, "verse_number": "७-२०-१२९", "content_sanskrit": "स गच्छेन्नरकं घोरं पुरीषह्रदसंज्ञकम् ।\nविक्रीतायाश्च कन्याया यः पुत्रो जायते द्विज ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7000932129, "chapter_id": 20932, "verse_number": "७-२०-१३०", "content_sanskrit": "स चांडाल इव ज्ञेयः सर्वधर्मबहिष्कृतः ।\nकन्याविक्रयिणः पुंसो मुखं पश्येन्न शास्त्रवित् ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7000932130, "chapter_id": 20932, "verse_number": "७-२०-१३१", "content_sanskrit": "पश्येदज्ञानतो वापि कुर्याद्भास्करदर्शनम् ।\nयत्किंचित्क्रियते कर्म कन्याविक्रयिणः पुरः ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7000932131, "chapter_id": 20932, "verse_number": "७-२०-१३२", "content_sanskrit": "शुभं तत्सकलं कर्म गच्छेद्विफलतां द्विज ।\nकन्याविक्रयिणो नास्ति नरकान्निष्कृतिः पुनः ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7000932132, "chapter_id": 20932, "verse_number": "७-२०-१३३", "content_sanskrit": "कन्यादानकृतो नास्ति स्वर्गादागमनं पुनः ।\nबहुनात्र किमुक्तेन संक्षेपेण ब्रवीमि ते ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7000932133, "chapter_id": 20932, "verse_number": "७-२०-१३४", "content_sanskrit": "हीरकक्षितिकन्यानां फलं स्याच्च शताधिकम् ।\nउपानहं चातपत्रं यस्तु यच्छति भूतले ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7000932134, "chapter_id": 20932, "verse_number": "७-२०-१३५", "content_sanskrit": "शृणु तस्य तु वै पुण्यं संक्षेपेण ब्रवीमि ते ।\nइह वर्षशतं जीवेत्सर्वसंपत्समन्वितः ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7000932135, "chapter_id": 20932, "verse_number": "७-२०-१३६", "content_sanskrit": "मृतः शक्रपुरं प्राप्य शतकल्पचतुष्टयम् ।\nददाति नूतनं वस्त्रं स याति परमां गतिम् ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7000932136, "chapter_id": 20932, "verse_number": "७-२०-१३७", "content_sanskrit": "वस्त्रं पुरातनं यच्छेद्धेनुं च रजतीं तथा ।\nकन्यां रजस्वलां यस्तु स सदा नरकं व्रजेत् ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7000932137, "chapter_id": 20932, "verse_number": "७-२०-१३८", "content_sanskrit": "फलदो मानवो विप्र गच्छति त्रिदशालयम् ।\nभुंक्ते कल्पसहस्राणि फलं तत्रामृतोपमम् ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7000932138, "chapter_id": 20932, "verse_number": "७-२०-१३९", "content_sanskrit": "शाकप्रदो याति विप्र शंभोर्भगवतः पदम् ।\nतत्र कल्पद्वयं भुंक्ते पायसं दुर्ल्लभं सुरैः ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7000932139, "chapter_id": 20932, "verse_number": "७-२०-१४०", "content_sanskrit": "दुग्धदो दधिदश्चैव घृतदस्तक्रदस्तथा ।\nप्राप्नोति वै सुधापानं पुरो भगवतो हरेः ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7000932140, "chapter_id": 20932, "verse_number": "७-२०-१४१", "content_sanskrit": "पुष्पदो मनुजो विप्र गन्धदश्च सुरालयम् ।\nतिष्ठेद्युगसहस्राणि पुष्पगन्धविभूषितः ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7000932141, "chapter_id": 20932, "verse_number": "७-२०-१४२", "content_sanskrit": "शय्यादानं द्विजश्रेष्ठ यः करोति द्विजोत्तम ।\nस ब्रह्मलोकमागत्य पर्यंकशयनश्चिरम् ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7000932142, "chapter_id": 20932, "verse_number": "७-२०-१४३", "content_sanskrit": "दीपदः पीठदश्चैव सर्वपापविवर्जितः ।\nदिव्यसिंहासनस्थश्च जलदीपावलीवृतः ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7000932143, "chapter_id": 20932, "verse_number": "७-२०-१४४", "content_sanskrit": "तांबूलदो नरो राजन्भुवि भुंक्तेऽखिलं शुभम् ।\nदिवि देवाङ्गनाक्रोडे सुप्तस्तांबूलमत्ति वै ॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7000932144, "chapter_id": 20932, "verse_number": "७-२०-१४५", "content_sanskrit": "विद्यादानं द्विजश्रेष्ठ यः करोति नरोत्तम ।\nसंप्राप्य संनिधिं विष्णोस्तिष्ठेद्युगशतद्वयम् ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7000932145, "chapter_id": 20932, "verse_number": "७-२०-१४६", "content_sanskrit": "ततो ज्ञानं समासाद्य तत्रैव द्विजसत्तम ।\nप्राप्नोति दुर्ल्लभं मोक्षं प्रसादात्कमलापतेः ॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7000932146, "chapter_id": 20932, "verse_number": "७-२०-१४७", "content_sanskrit": "अनाथं ब्राह्मणं यस्तु पाठयत्यतिदुःखितम् ।\nस याति विष्णुभवनं पुनरावृत्तिदुर्ल्लभम् ॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7000932147, "chapter_id": 20932, "verse_number": "७-२०-१४८", "content_sanskrit": "कुलीनोऽपि द्विजश्रेष्ठो न भाति विद्यया विना ।\nतस्माद्दिवजं पाठयंतः प्रयांति परमं पदम् ॥१४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 7000932148, "chapter_id": 20932, "verse_number": "७-२०-१४९", "content_sanskrit": "भुवि प्रत्यक्षदेवोऽपि ब्राह्मणो देवताश्रयः ।\nसर्ववर्णगुरुर्नैव विद्याहीनो विराजते ॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 7000932149, "chapter_id": 20932, "verse_number": "७-२०-१५०", "content_sanskrit": "संसारे यानि दानानि संति हेमादिकानि च ।\nतानि तेन प्रदत्तानि ब्राह्मणो येन पाठितः ॥१५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 7000932150, "chapter_id": 20932, "verse_number": "७-२०-१५१", "content_sanskrit": "कुर्यात्पुस्तकदानं यो नरो भक्तिसमन्वितः ।\nतस्य पुण्यं द्विजश्रेष्ठ संक्षेपात्ते वदाम्यहम् ॥१५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 7000932151, "chapter_id": 20932, "verse_number": "७-२०-१५२", "content_sanskrit": "तत्राक्षराणि यावंति पत्रे पत्रे च पुस्तके ।\nप्रत्यक्षरे लभेत्पुण्यं कपिलाकोटिदानजम् ॥१५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 7000932152, "chapter_id": 20932, "verse_number": "७-२०-१५३", "content_sanskrit": "यावद्दिनं पुस्तकं तत्प्रपठंति द्विजातयः ।\nतावन्मन्वंतरं तिष्ठेद्वैकुंठे पुस्तकप्रदः ॥१५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}, {"id": 7000932153, "chapter_id": 20932, "verse_number": "७-२०-१५४", "content_sanskrit": "एवमादीन्यनेकानि संति दानानि भूसुर ।\nसम्यग्वक्तुं जगत्यस्मिन्कः शक्तो द्विशतैरपि ॥१५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 154}, {"id": 7000932154, "chapter_id": 20932, "verse_number": "७-२०-१५५", "content_sanskrit": "ब्रह्महत्यादि पापानि क्रियंते यानि मानवैः ।\nहन्यंते तानि पापानि तस्माद्दानं समाचरेत् ॥१५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 155}, {"id": 7000932155, "chapter_id": 20932, "verse_number": "७-२०-१५६", "content_sanskrit": "आत्मपुण्येन यद्दानं दीयते च त्रिभिर्जनैः ।\nयावद्द्रव्यं फलं तस्मात्तस्य दानस्य लभ्यते ॥१५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 156}, {"id": 7000932156, "chapter_id": 20932, "verse_number": "७-२०-१५७", "content_sanskrit": "प्रीतये कमलाभर्तुर्यद्दानं दीयते जनैः ।\nतस्यकोटिगुणं पुण्यं लभते नात्र संशयः ॥१५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 157}, {"id": 7000932157, "chapter_id": 20932, "verse_number": "७-२०-१५८", "content_sanskrit": "तस्मान्नारायणप्रीतिहेतवे मतिमान्नरः ।\nदानं समाचरेद्विप्र भक्तिकर्मसमन्वितः ॥१५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 158}, {"id": 7000932158, "chapter_id": 20932, "verse_number": "७-२०-१५९", "content_sanskrit": "तपसोऽपि परं दानं निरुक्तं तत्वदर्शिभिः ।\nअतो यत्नादपि प्राज्ञो दानकर्मसमाचरेत् ॥१५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 159}, {"id": 7000932159, "chapter_id": 20932, "verse_number": "७-२०-१६०", "content_sanskrit": "दानं तपो द्वे अपि यः प्रकरोति नरोत्तमः ।\nतस्य तुल्यो जगत्यस्मिन्विद्यते न हि भूसुर ॥१६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 160}]