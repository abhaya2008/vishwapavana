[{"id": 2004076, "chapter_id": 1078, "verse_number": "१-७९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2004077, "chapter_id": 1078, "verse_number": "१-७९-१", "content_sanskrit": "पौरवेणाथ वयसा ययातिर्नहुषात्मजः।\nरूपयौवनसंपन्नः कुमारः समपद्यत।\nप्रीतियुक्तो नृपश्रेष्ठश्चरा विषयान्प्रियान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2004078, "chapter_id": 1078, "verse_number": "१-७९-२", "content_sanskrit": "यथाकामं यथोत्साहं यथाकालं यथासुखम्।\nधर्माविरुद्धं राजेन्द्रो यथा भवति सोऽन्वभूत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2004079, "chapter_id": 1078, "verse_number": "१-७९-३", "content_sanskrit": "देवानतर्पयद्यज्ञैः श्राद्धैस्तद्वित्पितॄनपि।\nदीनाननुग्रहैरिष्टैः कामैश्च द्विजसत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2004080, "chapter_id": 1078, "verse_number": "१-७९-४", "content_sanskrit": "अतिथीनन्नपानैश्च विशश्च परिपालनैः।\nआनृशंस्येन शूद्रांश्च दस्यून्सन्निग्रहेण च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2004081, "chapter_id": 1078, "verse_number": "१-७९-५", "content_sanskrit": "धर्मेण च प्रजाः सर्वा यथावदनुरञ्जयन्।\nययातिः पालयामास साक्षादिन्द्र इवापरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2004082, "chapter_id": 1078, "verse_number": "१-७९-६", "content_sanskrit": "स राजा सिंहविक्रान्तो युवा विषयगोचरः।\nअविरोधेन धर्मस्य चचार सुखमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2004083, "chapter_id": 1078, "verse_number": "१-७९-७", "content_sanskrit": "स संप्राप्य शुभान्कामांस्तृप्तः खिन्नश्च पार्थिवः।\nकालं वर्षसहस्रान्तं सस्मार मनुजाधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2004084, "chapter_id": 1078, "verse_number": "१-७९-८", "content_sanskrit": "परिसंख्याय कालज्ञः कलाः काष्ठाश्च वीर्यवान्।\nयौवनं प्राप्य राजर्षिः सहस्रपरिवत्सरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2004085, "chapter_id": 1078, "verse_number": "१-७९-९", "content_sanskrit": "विश्वाच्या सहितो रेमे व्यभ्राजन्नन्दने वने।\nअलकायां स कालं तु मेरुशृङ्गे तथोत्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2004086, "chapter_id": 1078, "verse_number": "१-७९-१०", "content_sanskrit": "यदा स पश्यते कालं धर्मात्मा तं महीपतिः।\nपूर्णं मत्वा ततः कालं पूरुं पुत्रमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2004087, "chapter_id": 1078, "verse_number": "१-७९-११", "content_sanskrit": "यथाकामं यथोत्साहं यथाकालमरिन्दम।\nसेविता विषयाः पुत्र यौवनेन मया तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2004088, "chapter_id": 1078, "verse_number": "१-७९-१२", "content_sanskrit": "न जातु कामः कामानामुपभोगेन शाम्यति।\nहविषा कृष्णवर्त्मेव भूय एवाभिवर्धते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2004089, "chapter_id": 1078, "verse_number": "१-७९-१३", "content_sanskrit": "यत्पृथिव्यां व्रीहियवं हिरण्यं पशवः स्त्रियः।\nएकस्यापि न पर्याप्तं तस्मान्नृष्णां परित्यजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2004090, "chapter_id": 1078, "verse_number": "१-७९-१४", "content_sanskrit": "या दुस्त्यजा दुर्मतिभिर्या न जीर्यति जीर्यतः।\nयोऽसौ प्राणान्तिको रोगस्तांतृष्णां त्यजतः सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2004091, "chapter_id": 1078, "verse_number": "१-७९-१५", "content_sanskrit": "पूर्णं वर्षसहस्रं मे विषयासक्तचेतसः।\nतथाप्यनुदिनं तृष्णा ममैतेष्वभिजायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2004092, "chapter_id": 1078, "verse_number": "१-७९-१६", "content_sanskrit": "तस्मादेनामहं त्यक्त्वा ब्रह्मण्याधाय मानसम्।\nनिर्द्वन्द्वो निर्ममो भूत्वा चरिष्यामि मृगैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2004093, "chapter_id": 1078, "verse_number": "१-७९-१७", "content_sanskrit": "पूरो प्रीतोऽस्मि भद्रं ते गृहाणेदं स्वयौवनम्।\nराज्यं चेदं गृहाण त्वं यावदिच्छसि यौवनम्।\nतावद्दीर्घायुषा भुङ्ख त्वं हि मे प्रियकृत्सुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2004094, "chapter_id": 1078, "verse_number": "१-७९-१८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2004095, "chapter_id": 1078, "verse_number": "१-७९-१८", "content_sanskrit": "प्रतिपेदे जरां राजा ययातिर्नाहुषस्तदा।\nयौवनं प्रतिपेदे च पूरुः स्वं पुनरात्मवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2004096, "chapter_id": 1078, "verse_number": "१-७९-१९", "content_sanskrit": "अभिषेक्तुकामं नृपतिं पूरुं पुत्रं कनीयसम्।\nब्राह्मणप्रमुखा वर्णा इदं वचनमब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2004097, "chapter_id": 1078, "verse_number": "१-७९-२०", "content_sanskrit": "कथं शुक्रस्य नप्तारं देवयान्याः सुतं प्रभो।\nज्येष्ठं यदुमतिक्रम्य राज्यं पूरोः प्रयच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2004098, "chapter_id": 1078, "verse_number": "१-७९-२१", "content_sanskrit": "यदुर्ज्येष्ठस्तव सुतो जातस्तमनु तुर्वसुः।\nशर्मिष्ठायाः सुतो द्रुह्युस्ततोऽनुः पूरुरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2004099, "chapter_id": 1078, "verse_number": "१-७९-२२", "content_sanskrit": "कथं ज्येष्ठानतिक्रम्य कनीयान्राज्यमर्हति।\nएतत्संबोधयामस्त्वां धर्मं त्वं प्रतिपालय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2004100, "chapter_id": 1078, "verse_number": "१-७९-२३x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2004101, "chapter_id": 1078, "verse_number": "१-७९-२३", "content_sanskrit": "ब्राह्मणप्रमुखा वर्णाः सर्वे शृण्वन्तु मे वचः।\nज्येष्ठं प्रति यथा राज्यं न देयं मे कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2004102, "chapter_id": 1078, "verse_number": "१-७९-२४", "content_sanskrit": "मम ज्येष्ठेन यदुना नियोगो नानुपालितः।\nप्रतिकूलः पितुर्यश्च न स पुत्रः सतां मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2004103, "chapter_id": 1078, "verse_number": "१-७९-२५", "content_sanskrit": "मातापित्रोर्वचनकृद्धितः पथ्यश्च यः सुतः।\nस पुत्रः पुत्रवद्यश्च वर्तते पितृमातृषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2004104, "chapter_id": 1078, "verse_number": "१-७९-२६", "content_sanskrit": "पुदिति नरकस्याख्या दुःखं च नरकं विदुः।\nपुतस्त्राणात्ततः पुत्त्रमिहेच्छन्ति परत्र च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2004105, "chapter_id": 1078, "verse_number": "१-७९-२७", "content_sanskrit": "आत्मनः सदृशः पुत्रः पितृदेवर्षिपूजने।\nयो बहूनां गुणकरः स पुत्रो ज्येष्ठ उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2004106, "chapter_id": 1078, "verse_number": "१-७९-२८", "content_sanskrit": "मूकोऽन्धो बधिरः श्वित्री स्वधर्मं नानुतिष्ठति।\nचोरः किल्बिषिकः पुत्रो ज्येष्ठो न ज्येष्ठ उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2004107, "chapter_id": 1078, "verse_number": "१-७९-२९", "content_sanskrit": "ज्येष्ठांशहारी गुणकृदिह लोके परत्र च।\nश्रेयान्पुत्रो गुणोपेतः स पुत्रो नेतरो वृथा।\nवदन्ति धर्मं धर्मज्ञाः पितॄणां पुत्रकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2004108, "chapter_id": 1078, "verse_number": "१-७९-३०", "content_sanskrit": "वेदोक्तं संभवं मह्यमनेन हृदयोद्भवम्।\nतस्य जातमिदं कृत्स्नमात्मा पुत्र इति श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2004109, "chapter_id": 1078, "verse_number": "१-७९-३१", "content_sanskrit": "यदुनाऽहमवज्ञातस्तथा तुर्वसुनापि च।\nद्रुह्युना चानुना चैव मय्यवज्ञ कृता भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2004110, "chapter_id": 1078, "verse_number": "१-७९-३२", "content_sanskrit": "पूरुणा तु कृतं वाक्यं मानितं च विशेषतः।\nकनीयान्मम दायादो धृता येन जरा मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2004111, "chapter_id": 1078, "verse_number": "१-७९-३३", "content_sanskrit": "मम कामः स च कृतः पूरुणा मित्ररूपिणा।\nशुक्रेण च वरोदत्तः काव्येनोशनसा स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2004112, "chapter_id": 1078, "verse_number": "१-७९-३४", "content_sanskrit": "पुत्रो यस्त्वाऽनुवर्तेत स राजा पृथिवीपतिः।\nयो वानुवर्ती पुत्राणां स पुत्रो दायभाग्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2004113, "chapter_id": 1078, "verse_number": "१-७९-३५", "content_sanskrit": "भवतोऽनुनयाम्येवं पूरू राज्येऽभिषिच्यताम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2004114, "chapter_id": 1078, "verse_number": "१-७९-३६x", "content_sanskrit": "प्रकृतय ऊचुः।\nयः पुत्रो गुणसंपन्नो मातापित्रोर्हितः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2004115, "chapter_id": 1078, "verse_number": "१-७९-३६", "content_sanskrit": "सर्वमर्हति कल्याणं कनीयानपि सत्तमः।\nवेद धमार्थशास्त्रेषु मुनिभिः कथितं पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2004116, "chapter_id": 1078, "verse_number": "१-७९-३७", "content_sanskrit": "अर्हः पूरुरिदं राज्यं यः सुतः प्रियकृत्तव।\nवरदानेन शुक्रस्य न शक्यं वक्तुमुत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2004117, "chapter_id": 1078, "verse_number": "१-७९-३८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2004118, "chapter_id": 1078, "verse_number": "१-७९-३८", "content_sanskrit": "पौरजानपदैस्तुष्टैरित्युक्तो नाहुषस्तदा।\nअभ्यषिञ्चत्ततः पूरुं राज्ये स्वे सुतमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2004119, "chapter_id": 1078, "verse_number": "१-७९-३९", "content_sanskrit": "यदुं च तुर्वसुं चोभौ द्रुह्युं चैव सहानुजम्।\nअन्तेषु स विनिक्षिप्य नाहुषः स्वात्मजान्सुतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2004120, "chapter_id": 1078, "verse_number": "१-७९-४०", "content_sanskrit": "दत्त्वा च पूरवे राज्यं वनवासाय दीक्षितः।\nपुरात्स निर्ययौ राजा ब्राह्मणैस्तापसैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2004121, "chapter_id": 1078, "verse_number": "१-७९-४१", "content_sanskrit": "देवयान्या च सहितः शर्मिष्ठया च भारत।\nअकरोत्स वने राजा सभार्यस्तप उत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2004122, "chapter_id": 1078, "verse_number": "१-७९-४२", "content_sanskrit": "यदोस्तु यादवा जातास्तुर्वसोर्यवनाः स्मृताः।\nद्रुह्योः सुतास्तु वै भोजा अनोस्तु म्लेच्छजातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2004123, "chapter_id": 1078, "verse_number": "१-७९-४३", "content_sanskrit": "पूरोस्तु पौरवो वंशो यत्र जातोऽसि पार्थिव।\nइदं वर्षसहस्राणि राज्यं कारयितुं वशी॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2004124, "chapter_id": 1078, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि ऊनाशीतितमोऽध्यायः॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]