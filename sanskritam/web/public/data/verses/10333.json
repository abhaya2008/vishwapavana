[{"id": 6000333000, "chapter_id": 10333, "verse_number": null, "content_sanskrit": "भगवद्बादरायणप्रणीतं श्रीमद्भागवतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000333001, "chapter_id": 10333, "verse_number": null, "content_sanskrit": "अथ प्रथमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 6000333002, "chapter_id": 10333, "verse_number": null, "content_sanskrit": "श्री शुक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.001.m4a", "display_order": 3}, {"id": 6000333003, "chapter_id": 10333, "verse_number": "१२-१-१", "content_sanskrit": "योऽन्त्यो रिपुञ्जयो नाम भविष्यो बारुहद्रथः।\nतस्यामात्यस्तु मुनिको हत्वा स्वामिनमात्मजम्॥ १२/१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.002.m4a", "display_order": 4, "topics": [{"text": "शुकाचार्येण परीक्षितं प्रति भगवतः स्वलोकगमनस्य ततो वसुदेवादीनां स्वस्वमूलरूपप्राप्तेश्च कथनम्", "range": "१–४३"}]}, {"id": 6000333004, "chapter_id": 10333, "verse_number": "१२-१-२", "content_sanskrit": "प्रद्योतसञ्ज्ञं राजानं कर्ता यत् पालकः सुतः।\nविशाखयूपस्तत्पुत्रो भविता चाजकस्ततः॥ १२/१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.003.m4a", "display_order": 5}, {"id": 6000333005, "chapter_id": 10333, "verse_number": "१२-१-३", "content_sanskrit": "नन्दिवर्धस्तु तत्पुत्रः पञ्चप्रद्योतना इमे।\nअष्टत्रिंशोत्तरशतं भोक्ष्यन्ति पृथिवीमिमाम्॥ १२/१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.004.m4a", "display_order": 6}, {"id": 6000333006, "chapter_id": 10333, "verse_number": "१२-१-४", "content_sanskrit": "शिशुनागस्ततो भाव्यः काकवर्णस्तु तत्सुतः।\nक्षेमधर्मा तस्य सुतः क्षेत्रज्ञः क्षेमधर्मजः॥ १२/१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.005.m4a", "display_order": 7}, {"id": 6000333007, "chapter_id": 10333, "verse_number": "१२-१-५", "content_sanskrit": "विधिसारः सुतस्तस्याजातशत्रुर्भविष्यति।\nदर्भकस्तत्सुतो भाव्यो दर्भकस्याजयस्ततः॥ १२/१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.006.m4a", "display_order": 8}, {"id": 6000333008, "chapter_id": 10333, "verse_number": "१२-१-६", "content_sanskrit": "नन्दिवर्धन आजेयो महानन्दिश्च तत्सुतः।\nशैशुनागा दशैते वै षष्ट्युत्तरशतत्रयम्॥ १२/१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.007.m4a", "display_order": 9}, {"id": 6000333009, "chapter_id": 10333, "verse_number": "१२-१-७", "content_sanskrit": "समा भोक्ष्यन्ति पृथिवीं कुरुश्रेष्ठ कलौ नृपाः।\nमहानन्दिसुतो राजन् शूद्रागर्भोद्भवो बली॥ १२/१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.008.m4a", "display_order": 10}, {"id": 6000333010, "chapter_id": 10333, "verse_number": "१२-१-८", "content_sanskrit": "महापद्मापतिः कश्चित् कुलक्षत्रविनाशकृत्।\nततो नृपा भविष्यन्ति शूद्रप्राया अधार्मिकाः॥ १२/१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.009.m4a", "display_order": 11}, {"id": 6000333011, "chapter_id": 10333, "verse_number": "१२-१-९", "content_sanskrit": "स एकच्छत्रां पृथिवीमनुल्लङ्घितशासनः।\nशासिष्यति महापद्मो द्वितीय इव भार्गवः॥ १२/१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.010.m4a", "display_order": 12}, {"id": 6000333012, "chapter_id": 10333, "verse_number": "१२-१-१०", "content_sanskrit": "तस्य चाष्टौ भविष्यन्ति सुमालिप्रमुखाः सुताः।\nय इमां पृथिवीं राजन् भोक्ष्यन्ति स्म शतं समाः॥ १२/१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.011.m4a", "display_order": 13}, {"id": 6000333013, "chapter_id": 10333, "verse_number": "१२-१-११", "content_sanskrit": "नवनन्दान् द्विजः कश्चित् प्रपन्नानुद्धरिष्यति।\nतेषामभावे जगतीं मौर्या भोक्ष्यन्ति वै कलौ॥ १२/१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.012.m4a", "display_order": 14}, {"id": 6000333014, "chapter_id": 10333, "verse_number": "१२-१-१२", "content_sanskrit": "स एव चन्द्रगुप्तं वै द्विजो राज्येऽभिषेक्ष्यति।\nतत्सुतो वारिराजस्तु ततश्चाशोकवर्धनः॥ १२/१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.013.m4a", "display_order": 15}, {"id": 6000333015, "chapter_id": 10333, "verse_number": "१२-१-१३", "content_sanskrit": "सुयशा भविता यस्य सङ्गतः सुयशःसुतः।\nशालिशूकस्ततस्तस्य सोमशर्मा भविष्यति॥ १२/१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.014.m4a", "display_order": 16}, {"id": 6000333016, "chapter_id": 10333, "verse_number": "१२-१-१४", "content_sanskrit": "शतधन्वा ततस्तस्य भविता तु बृहद्रथः।\nमौर्या ह्येते नव नृपाः सप्तत्रिंशच्छतोत्तरम्॥ १२/१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.015.m4a", "display_order": 17}, {"id": 6000333017, "chapter_id": 10333, "verse_number": "१२-१-१५", "content_sanskrit": "समा भोक्ष्यन्ति पृथिवीं कलौ कुरुकुलोद्वह।\nहत्वा बृहद्रथं मौर्यं तस्य सेनापतिः कलौ॥ १२/१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.016.m4a", "display_order": 18}, {"id": 6000333018, "chapter_id": 10333, "verse_number": "१२-१-१६", "content_sanskrit": "पुष्पमित्रस्तु शुङ्गाह्वः स्वयं राज्यं करिष्यति।\nअग्निमित्रस्ततस्तस्मात् सुज्येष्ठो भविता ततः॥ १२/१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.017.m4a", "display_order": 19}, {"id": 6000333019, "chapter_id": 10333, "verse_number": "१२-१-१७", "content_sanskrit": "वसुमित्रो भद्रकश्च पुलिन्दो भविता ततः।\nततो घोषः सुतस्तस्माद् वज्रमित्रो भविष्यति॥ १२/१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.018.m4a", "display_order": 20}, {"id": 6000333020, "chapter_id": 10333, "verse_number": "१२-१-१८", "content_sanskrit": "ततो भागवतस्तस्माद् देवहूतिः कुरूद्वह।\nशुङ्गा दशैते भोक्ष्यन्ति भूमिं वर्षशताधिकम्॥ १२/१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.019.m4a", "display_order": 21}, {"id": 6000333021, "chapter_id": 10333, "verse_number": "१२-१-१९", "content_sanskrit": "ततः कण्वानियं भूमिर्यास्यत्यल्पगुणान्नृपान्।\nशुङ्गं हत्वा देवहूतिं कण्वोऽमात्यस्तु कामिनम्॥ १२/१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.020.m4a", "display_order": 22}, {"id": 6000333022, "chapter_id": 10333, "verse_number": "१२-१-२०", "content_sanskrit": "स्वयं करिष्यते राज्यं वसुदेवो महामतिः।\nतस्य पुत्रस्तु भूमित्रस्ततो नारायणः सुतः॥ १२/१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.021.m4a", "display_order": 23}, {"id": 6000333023, "chapter_id": 10333, "verse_number": "१२-१-२१", "content_sanskrit": "सुशर्माख्योऽस्य नृपतिः कण्वानां भविता ततः।\nकाण्वायना इमे भूमिं चत्वारिंशच्च पञ्च च॥ १२/१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.022.m4a", "display_order": 24}, {"id": 6000333024, "chapter_id": 10333, "verse_number": "१२-१-२२", "content_sanskrit": "शतानि त्रीणि भोक्ष्यन्ति वर्षाणां च कलौ युगे।\nहत्वा कण्वं सुशर्माणं तद्भृत्यो वृषलो बली॥ १२/१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.023.m4a", "display_order": 25}, {"id": 6000333025, "chapter_id": 10333, "verse_number": "१२-१-२३", "content_sanskrit": "गां भोक्ष्यत्यान्ध्रजातीयः कञ्चित्कालमसत्तमः।\nकृष्णनामा च तद्भ्राता भविता पृथिवीपतिः॥ १२/१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.024.m4a", "display_order": 26}, {"id": 6000333026, "chapter_id": 10333, "verse_number": "१२-१-२४", "content_sanskrit": "श्रीशान्तकर्णस्तत्पुत्रः पौर्णमासस्तु तत्सुतः।\nलम्बोदरस्तु तत्पुत्रस्तस्माच्छिबिलको नृप॥ १२/१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.025.m4a", "display_order": 27}, {"id": 6000333027, "chapter_id": 10333, "verse_number": "१२-१-२५", "content_sanskrit": "मेघस्वातिः शिबिलकाद्दृढमानस्तु तस्य च।\nअनिष्टकर्मा हालेयस्तलङ्कस्तस्य चात्मजः॥ १२/१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.026.m4a", "display_order": 28}, {"id": 6000333028, "chapter_id": 10333, "verse_number": "१२-१-२६", "content_sanskrit": "पुरीषसेरुस्तत्पुत्रस्ततो राजा सुनन्दनः।\nचकोरो दृढकायोऽस्य शिवख्यातिररिन्दमः॥ १२/१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.027.m4a", "display_order": 29}, {"id": 6000333029, "chapter_id": 10333, "verse_number": "१२-१-२७", "content_sanskrit": "तस्यापि गोमतीपुत्रः पुरीमान् भविता ततः।\nशिवशिराः शिवस्कन्दो जयश्रीस्तत्सुतस्ततः॥ १२/१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.028.m4a", "display_order": 30}, {"id": 6000333030, "chapter_id": 10333, "verse_number": "१२-१-२८", "content_sanskrit": "विजयस्तत्सुतो भाव्यश्चन्द्रबीजः सुलोमधीः।\nएते त्रिंशन्नृपतयश्चत्वार्यष्टशतानि च॥ १२/१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.029.m4a", "display_order": 31}, {"id": 6000333031, "chapter_id": 10333, "verse_number": "१२-१-२९", "content_sanskrit": "षट्पञ्चाशच्च पृथिवीं भोक्ष्यन्ति कुरुनन्दन। सप्ताभीरा आन्ध्रभृत्या दश गर्दभिनो नृपाः।\nकङ्काः षोडशभूपाला भविष्यन्त्यतिलोलुपाः॥ १२/१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.030.m4a", "display_order": 32}, {"id": 6000333032, "chapter_id": 10333, "verse_number": "१२-१-३०", "content_sanskrit": "ततोऽष्टौ यवना भाव्याश्चतुर्दश तुरुष्कराः।\nत्रयोदशसुरुण्डाश्च मौना एकादशैव तु॥ १२/१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.031.m4a", "display_order": 33}, {"id": 6000333033, "chapter_id": 10333, "verse_number": "१२-१-३१", "content_sanskrit": "एते भोक्ष्यन्ति पृथिवीं दशवर्षशतानि च।\nनवाधिकां च नवतिं मौना एकादश क्षितिम्॥ १२/१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.032.m4a", "display_order": 34}, {"id": 6000333034, "chapter_id": 10333, "verse_number": "१२-१-३२", "content_sanskrit": "भोक्ष्यन्त्यब्दशतान्यङ्ग त्रीणि वै संस्थिते कुले।\nकिलकिलायां नृपतयो भूतवंशोपवङ्गरैः॥ १२/१/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.033.m4a", "display_order": 35}, {"id": 6000333035, "chapter_id": 10333, "verse_number": "१२-१-३३", "content_sanskrit": "शिशुनन्दिश्च तद्भ्राता यशोनन्दिः प्रवीरकः।\nयुक्ता एते वर्षशतं भविष्यन्त्यधिकानि षट्॥ १२/१/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.034.m4a", "display_order": 36}, {"id": 6000333036, "chapter_id": 10333, "verse_number": "१२-१-३४", "content_sanskrit": "तेषां त्रयोदश सुता भवितारोऽथ बाह्लिकाः।\nपुष्पमित्रोऽथ राजन्यो दुर्मित्रोऽस्य तथैव च॥ १२/१/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.035.m4a", "display_order": 37}, {"id": 6000333037, "chapter_id": 10333, "verse_number": "१२-१-३५", "content_sanskrit": "एककाला इमे भूपाः सप्तान्ध्राः सप्त कोसलाः।\nवैदूरपतयो भाव्या नैषधास्तत एव हि॥ १२/१/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.036.m4a", "display_order": 38}, {"id": 6000333038, "chapter_id": 10333, "verse_number": "१२-१-३६", "content_sanskrit": "नैषधानां तु भविता विश्वस्फूर्जिः पुरञ्जयः।\nकरिष्यत्यवरान् वर्णान् पुलिन्दयदुमद्रकान्॥ १२/१/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.037.m4a", "display_order": 39}, {"id": 6000333039, "chapter_id": 10333, "verse_number": "१२-१-३७", "content_sanskrit": "प्रजाश्च ब्रह्मभूयिष्ठाः स्थापयिष्यति दुर्मतिः।\nवीर्यवान् क्षत्रमुत्साद्य पद्मवत्यां स वै पुरि॥ १२/१/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.038.m4a", "display_order": 40}, {"id": 6000333040, "chapter_id": 10333, "verse_number": "१२-१-३८", "content_sanskrit": "अनुगङ्गमाप्रयागं गुप्तां भोक्ष्यति मेदिनीम्।\nसौराष्ट्रावन्त्याभीराश्च शूद्राश्चार्बुदमालवाः॥ १२/१/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.039.m4a", "display_order": 41}, {"id": 6000333041, "chapter_id": 10333, "verse_number": "१२-१-३९", "content_sanskrit": "व्रात्या द्विजा भविष्यन्ति शूद्रप्राया जनाधिपाः।\nसिन्धोस्तटं चन्द्रभागां काञ्चीं काश्मीरमण्डलम्॥ १२/१/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.040.m4a", "display_order": 42}, {"id": 6000333042, "chapter_id": 10333, "verse_number": "१२-१-४०", "content_sanskrit": "भोक्ष्यन्ति शूद्रा व्रात्याश्च म्लेञ्छा अब्रह्मवर्चसः।\nतुल्यकाला इमे राजन् म्लेञ्छप्रायाश्च भूभृतः॥ १२/१/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.041.m4a", "display_order": 43}, {"id": 6000333043, "chapter_id": 10333, "verse_number": "१२-१-४१", "content_sanskrit": "एतेऽधर्मानृतपराः फल्गुदास्तीव्रमन्यवः।\nस्त्रीबालगोद्विजघ्नाश्च परदारधनादृताः॥ १२/१/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.042.m4a", "display_order": 44}, {"id": 6000333044, "chapter_id": 10333, "verse_number": "१२-१-४२", "content_sanskrit": "उदितास्तमितप्रायाः अल्पसत्त्वाल्पकायुषः।\nअसंस्कृताः क्रियाहीना रजसा तमसा वृताः॥ १२/१/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.043.m4a", "display_order": 45}, {"id": 6000333045, "chapter_id": 10333, "verse_number": "१२-१-४३", "content_sanskrit": "प्रजास्ते भक्षयिष्यन्ति म्लेच्छा राजन्यरूपिणः।\nतन्नाथास्ते जनपदास्तच्छीलाचारवादिनः॥ १२/१/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_001/BhP_12.001.044.m4a", "display_order": 46}, {"id": 6000333046, "chapter_id": 10333, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां द्वादशस्कन्धे प्रथमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]