[{"id": 7004529000, "chapter_id": 24529, "verse_number": "५-३-२२३-१", "content_sanskrit": "मार्कण्डेय उवाच ।\nततः क्रोशान्तरे पार्थ वासवं तीर्थमुत्तमम् ।\nवसुभिः स्थापितं तत्र स्थित्वा वै द्वादशाब्दकम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004529001, "chapter_id": 24529, "verse_number": "५-३-२२३-२", "content_sanskrit": "धरो ध्रुवश्च सोमश्च आपश्चैवानिलोऽनलः ।\nप्रत्यूषश्च प्रभासश्च वसवोऽष्टाविमे पुरा॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004529002, "chapter_id": 24529, "verse_number": "५-३-२२३-३", "content_sanskrit": "पितृशापपरिक्लिष्टा गर्भवासाय भारत ।\nनार्मदं तीर्थमासाद्य तपश्चक्रुर्यतेन्द्रियाः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004529003, "chapter_id": 24529, "verse_number": "५-३-२२३-४", "content_sanskrit": "आराधयन्तः परमं भवानीपतिमव्यम् ।\nद्वादशाब्दानि राजेन्द्र ततस्तुष्टो महेश्वरः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004529004, "chapter_id": 24529, "verse_number": "५-३-२२३-५", "content_sanskrit": "प्रत्यक्षः प्रददौ तेभ्यस्त्वभीष्टं वरमुत्तमम् ।\nततः स्वनाम्ना संस्थाप्य वसवस्तं महेश्वरम् ।\nजग्मुराकाशमाविश्य प्रसन्ने सति शङ्करे॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004529005, "chapter_id": 24529, "verse_number": "५-३-२२३-६", "content_sanskrit": "ततः प्रभृति विख्यातं तीर्थं तद्वासवाह्वयम् ।\nतस्मिंस्तीर्थे महाराज यो भक्त्या पूजयेच्छिवम् ।\nयथालब्धोपहारैश्च दीपं दद्यात्प्रयत्नतः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004529006, "chapter_id": 24529, "verse_number": "५-३-२२३-७", "content_sanskrit": "शुक्लपक्षे तदाष्टम्यां प्रत्यहं वापि शक्तितः ।\nअष्टौ वर्षसहस्राणि स वसेच्छिवसंनिधौ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004529007, "chapter_id": 24529, "verse_number": "५-३-२२३-८", "content_sanskrit": "ततः शिवालयं याति गर्भवासं न पश्यति ।\nपुष्पैर्वा पल्लवैर्वापि फलैर्धान्यैस्तथापि वा॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004529008, "chapter_id": 24529, "verse_number": "५-३-२२३-९", "content_sanskrit": "पूजयेद्देवमीशानं स दैन्यं नाप्नुयात्क्वचित् ।\nसर्वशोकविनिर्मुक्तः स्वर्गलोके महीयते॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004529009, "chapter_id": 24529, "verse_number": "५-३-२२३-१०", "content_sanskrit": "एकाहमपि कौन्तेय यो वसेद्वासवेश्वरे ।\nपापराशिं विनिर्धूय भानुवद्दिवि मोदते॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004529010, "chapter_id": 24529, "verse_number": "५-३-२२३-११", "content_sanskrit": "विप्रांश्च भोजयेद्भक्त्या दद्याद्वासांसि दक्षिणाम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]