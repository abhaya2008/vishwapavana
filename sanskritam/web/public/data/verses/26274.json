[{"id": 7006274000, "chapter_id": 26274, "verse_number": "३-२८-१", "content_sanskrit": "रणेभग्नं महादैत्यं भण्डदैत्यः सहोदरम् ।\nसेनानां कदनं श्रुत्वा सन्तप्तो बहुचिन्तया ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006274001, "chapter_id": 26274, "verse_number": "३-२८-२", "content_sanskrit": "उभावपि समेतौ तौ युक्तौ सर्वैश्चसैनिकैः ।\nप्रेषयामास युद्धाय भण्डदैत्यः सहोदरौ ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006274002, "chapter_id": 26274, "verse_number": "३-२८-३", "content_sanskrit": "तावुभौ परमक्रुद्धौ भण्डदैत्येन देशितौ ।\nविषङ्गश्च विशुक्रश्च महोद्यम मवापनुः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006274003, "chapter_id": 26274, "verse_number": "३-२८-४", "content_sanskrit": "कनिष्ठसहितं तत्र युवराजं महाबलम् ।\nविशुक्रमनुवव्राज सेना त्रैलोक्यकम्पिनी ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006274004, "chapter_id": 26274, "verse_number": "३-२८-५", "content_sanskrit": "अक्षौहिणीचतुःशत्या सेनानामावृतश्च सः ।\nयुवराजः प्रववृधे प्रतापेन महीयसा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006274005, "chapter_id": 26274, "verse_number": "३-२८-६", "content_sanskrit": "उलूकजित्प्रभृतयो भागिनेया दशोद्धताः ।\nभण्डस्य च भगिन्यान्तु धूमिन्यां जातयोनयः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006274006, "chapter_id": 26274, "verse_number": "३-२८-७", "content_sanskrit": "कृतास्त्रशिक्षा भण्डेन मातुलेन महीयसा ।\nविक्रमेण वलन्तस्ते सेनानाथाः प्रतस्थिरे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006274007, "chapter_id": 26274, "verse_number": "३-२८-८", "content_sanskrit": "प्रोद्गतैश्चापनिर्घोषैर्घोषयन्तो दिशो दश ।\nद्वयोर्मातुलयोः प्रीतिं भागिनेया वितेनिरे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006274008, "chapter_id": 26274, "verse_number": "३-२८-९", "content_sanskrit": "आरूढयानाः प्रत्येकगाढाहङ्कारशालिनः ।\nआकृष्टगुरुधन्वानो विशुक्रमनुवव्रजुः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006274009, "chapter_id": 26274, "verse_number": "३-२८-१०", "content_sanskrit": "यौवराज्यप्रभाचिह्नच्छत्रचामरशोभितः ।\nआरूढवारणः प्राप विशुक्रो युद्धमेदिनीम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006274010, "chapter_id": 26274, "verse_number": "३-२८-११", "content_sanskrit": "ततः कलकलारावकारिण्या सेनया वृतः ।\nविशुक्रः पटु दध्वान सिंहनादं भयङ्करम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006274011, "chapter_id": 26274, "verse_number": "३-२८-१२", "content_sanskrit": "तत्क्षोभात्क्षुभितस्वान्ताः शक्तयः संभ्रमोद्धताः ।\nअग्निप्राकारवलयान्निर्जगमुर्बद्धपङ्कयः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006274012, "chapter_id": 26274, "verse_number": "३-२८-१३", "content_sanskrit": "तडिन्मयमिवाकाशं कुर्वन्त्यः स्वस्वरोचिषा ।\nरक्ताम्वुजावृतमिव व्योमचक्रं रणोन्मुखाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006274013, "chapter_id": 26274, "verse_number": "३-२८-१४", "content_sanskrit": "अथ भण्डकनीयांसावागतौ युद्धदुर्मदौ ।\nनिशम्य युगपद्योद्धं मन्त्रिणीदण्डनायके ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006274014, "chapter_id": 26274, "verse_number": "३-२८-१५", "content_sanskrit": "किरिचकं ज्ञेयचक्रमारूढे रथशेखरम् ।\nधृतातपत्रवलये चामराभ्यां च वीजिते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006274015, "chapter_id": 26274, "verse_number": "३-२८-१६", "content_sanskrit": "अप्सरोभिः प्रनृत्ताभिर्गीयमानमहोदये ।\nनिर्जगमतू रणं कर्तुमुभाभ्यां ललिताज्ञया ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006274016, "chapter_id": 26274, "verse_number": "३-२८-१७", "content_sanskrit": "श्रीचक्ररथराजस्य रक्षणार्थं निवेशिते ।\nशताक्षौहिणिकां सेनां वर्जयित्वास्त्रभीषणम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006274017, "chapter_id": 26274, "verse_number": "३-२८-१८", "content_sanskrit": "अन्यत्सर्वं चमुजालं निर्जगाम रणोन्मुखी ।\nपुरतः प्राचलद्दण्डनाथा रथनिषेदुषी ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006274018, "chapter_id": 26274, "verse_number": "३-२८-१९", "content_sanskrit": "एकयैव कराङ्गुल्या घूर्णयन्ती हलायुधम् ।\nमुसलं चान्यहस्तेन भ्रामयन्ती मुहुर्मुहुः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006274019, "chapter_id": 26274, "verse_number": "३-२८-२०", "content_sanskrit": "तरलेन्दुकलाचूडास्फुरत्पोत्रमुखाम्बुजा ।\nपुरः प्रहर्त्री समरे सर्वदा विक्रमोद्धता ।\nअस्या अनुप्रचलिता गेयचक्ररथस्थिता ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006274020, "chapter_id": 26274, "verse_number": "३-२८-२१", "content_sanskrit": "धनुषो ध्वनिना विश्वं पूरयन्ती महोद्धता ।\nवेणीकृतकचन्यस्तविलसच्चन्द्रपल्लवा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006274021, "chapter_id": 26274, "verse_number": "३-२८-२२", "content_sanskrit": "स्फुरत्त्रितयनेत्रेण सिन्दूरतिलकत्विषा ।\nपाणिना पद्मरम्येण मणिकङ्कणचारुणा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006274022, "chapter_id": 26274, "verse_number": "३-२८-२३", "content_sanskrit": "तूणीरमुखतः कृष्टं भ्रामयन्ती शिलीमुखम् ।\nजय वर्धस्ववर्धस्वेत्यतिहर्षसमाकुले ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006274023, "chapter_id": 26274, "verse_number": "३-२८-२४", "content_sanskrit": "नृत्यद्भिर्दिव्यमुनिभिर्वर्द्धिताशीर्वचोऽमृतैः ।\nगेयचक्ररथेन्द्रस्य चक्रनेमिविघट्टनैः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006274024, "chapter_id": 26274, "verse_number": "३-२८-२५", "content_sanskrit": "दारयन्ती क्षितितलं दैत्यानां हृदयैः सह ।\nलोकातिशायिता विश्वमनोमोहनकारिणा ।\nगीतिबन्धेनामरीभिर्बह्वीभिर्गीतवैभवा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006274025, "chapter_id": 26274, "verse_number": "३-२८-२६", "content_sanskrit": "अक्षौहिणीसहस्राणामष्टकं समरोद्धतम् ।\nकर्षती कल्पविश्लेषनिर्मर्यादाब्धिसंनिभम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006274026, "chapter_id": 26274, "verse_number": "३-२८-२७", "content_sanskrit": "तस्याः शक्तिचमूचक्रे काश्चित्कनकरोचिषः ।\nकाश्चिद्दाडिमसंकाशाः काश्चिज्जीमूतरोचिषः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006274027, "chapter_id": 26274, "verse_number": "३-२८-२८", "content_sanskrit": "अन्याः सिंदूररुचयः पराः पाटलपाटलाः ।\nकाचाद्रिकाम्बराः काश्चित्पराः श्यामलकोमलाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006274028, "chapter_id": 26274, "verse_number": "३-२८-२९", "content_sanskrit": "अन्यास्तु हीरकप्रख्याः परा गारुत्मतोपमाः ।\nविरुद्धैः पञ्चभिर्बाणैर्मिश्रितैः शतकोटिभिः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006274029, "chapter_id": 26274, "verse_number": "३-२८-३०", "content_sanskrit": "व्यञ्जयन्त्यो देहरुचं कतिचिद्विविधायुधाः ।\nअसंख्याः शक्तयश्चेलुर्दण्डिन्यास्सैनिके तथा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006274030, "chapter_id": 26274, "verse_number": "३-२८-३१", "content_sanskrit": "तथैव सैन्यसन्नाहो मन्त्रिण्याः कुम्भसम्भव ।\nयथा भूषणवेषादि यथा प्रभावलक्षणम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006274031, "chapter_id": 26274, "verse_number": "३-२८-३२", "content_sanskrit": "यथा सद्गुणशालित्वं यथा चाश्रितलक्षणम् ।\nयथा दैत्यौघसंहारो यथा सर्वैश्च पूजिता ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006274032, "chapter_id": 26274, "verse_number": "३-२८-३३", "content_sanskrit": "यथा शक्तिर्महाराज्ञ्या देडिन्यश्च तथाखिलम् ।\nविशेषस्तु परं तस्याः साचिव्ये तत्करे स्थितम् ।\nमहाराज्ञीवितीर्णं तदाज्ञामुद्राङ्गुलीयकम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006274033, "chapter_id": 26274, "verse_number": "३-२८-३४", "content_sanskrit": "इत्थं प्रचलिते सैन्ये मन्त्रिणीदण्डनाथयोः ।\nतद्भारभङ्गुरा भूमिर्देलालीलामलंबत ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006274034, "chapter_id": 26274, "verse_number": "३-२८-३५", "content_sanskrit": "ततः प्रववृते युद्धं तुमुलं रोमहर्षणम् ।\nउद्धूतधूलिजंबालीभूतसप्तार्णवीजलम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006274035, "chapter_id": 26274, "verse_number": "३-२८-३६", "content_sanskrit": "हयस्थैर्हयसादिन्यो रथस्थै रथसंस्थिताः ।\nआधोरणैर्हस्तिपकाः खड्गैः पद्गाश्च सङ्गताः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006274036, "chapter_id": 26274, "verse_number": "३-२८-३७", "content_sanskrit": "दण्डनाथाविषङ्गेण समयुध्यन्त सङ्गरे ।\nविशुक्रेण समं श्यामा विकृष्टमणिकार्मुका ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006274037, "chapter_id": 26274, "verse_number": "३-२८-३८", "content_sanskrit": "अश्वरूढा चकारोच्चैः सहोलूकजिता रणम् ।\nसम्पदीशाच जग्राह पुरुषेण युयुत्सया ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006274038, "chapter_id": 26274, "verse_number": "३-२८-३९", "content_sanskrit": "विषेण नकुली देवी समाह्वास्त युयुत्सया ।\nकुन्तिषेणेन समरं महामाया तदाकरोत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006274039, "chapter_id": 26274, "verse_number": "३-२८-४०", "content_sanskrit": "मलदेन समं चक्रे युद्धमुन्मत्तभैरवी ।\nलघुश्यामा चकारोच्चैः कुशूरेण समं रणम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006274040, "chapter_id": 26274, "verse_number": "३-२८-४१", "content_sanskrit": "स्वप्नेशी मङ्गलाख्येन दैत्येन्द्रेण रणंव्यधात् ।\nवाग्वादिनी तु जघटे द्रुघणेन समं रणे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006274041, "chapter_id": 26274, "verse_number": "३-२८-४२", "content_sanskrit": "कोलाटेन च दुष्टेन चण्डकाल्यकरोद्रणम् ।\nअक्षौहिणीभिर्दैत्यानां शताक्षौहिणिकास्तथा ।\nमहान्तं समरे चक्रुरन्योन्यं क्रोधमूर्छिताः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006274042, "chapter_id": 26274, "verse_number": "३-२८-४३", "content_sanskrit": "प्रवर्तमाने समरे विशुक्रो दुष्टदानवः ।\nवर्धमानां शक्तिचमूं हीयमानां निजां चमूम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006274043, "chapter_id": 26274, "verse_number": "३-२८-४४", "content_sanskrit": "अवलोक्य रुषाविष्टः स कृष्टगुरुकार्मुकः ।\nशक्तिसैन्ये समस्तेऽपि तृषास्त्रं प्रमुमोच ह ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006274044, "chapter_id": 26274, "verse_number": "३-२८-४५", "content_sanskrit": "तेन दावानलज्वालादीप्तेन मथितं बलम् ।\nतृतीये युद्धदिवसे याममात्रं गते रवौ ।\nविशुक्रमुक्ततर्षास्त्रव्याकुलाः शक्तयोऽवन् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006274045, "chapter_id": 26274, "verse_number": "३-२८-४६", "content_sanskrit": "क्षोभयन्निन्द्रियग्रामं तालुमूलं विशोषयन् ।\nरूक्षयन्कर्णकुहरमङ्गदौर्वल्यमाहवन् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006274046, "chapter_id": 26274, "verse_number": "३-२८-४७", "content_sanskrit": "पातयन्पृथिवीपृष्ठे देहं विस्रंसितायुधम् ।\nआविर्बभूव शक्तीनामतितीव्रस्तृषाज्वरः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006274047, "chapter_id": 26274, "verse_number": "३-२८-४८", "content_sanskrit": "युद्धेष्वनुद्यमकृता सर्वोत्साहविरोधिना ।\nतर्षेण तेन क्वथितं शक्तिसैन्यं विलोक्यसा ।\nमन्त्रिणी सह पोत्रिण्या भृशं चिन्तामवाप ह ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006274048, "chapter_id": 26274, "verse_number": "३-२८-४९", "content_sanskrit": "उवाच तां दण्डनाथामत्याहितविशङ्किनीम् ।\nरथस्थिता रथगता तत्प्रती कारकर्मणे ।\nसखि पोत्रिणि दुष्टस्य तर्षास्त्रमिदमागतम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006274049, "chapter_id": 26274, "verse_number": "३-२८-५०", "content_sanskrit": "शिथिलीकुरुते सैन्यमस्माकं हा विधेः क्रमः ।\nविशुष्कतालुमूलानां विभ्रष्टायुधतेजसाम् ।\nशक्तीनां मण्डलेनात्र समरे समुपेक्षितम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006274050, "chapter_id": 26274, "verse_number": "३-२८-५१", "content_sanskrit": "न कापि कुरुते युद्धं न धारयति चायुधम् ।\nविशुष्कतालुमूलत्वा द्वक्तुमप्यालि न क्षमाः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006274051, "chapter_id": 26274, "verse_number": "३-२८-५२", "content_sanskrit": "ईदृशीन्नो गतिं श्रुत्वा किं वक्ष्यति महेश्वरी ।\nकृता चापकृतिर्दैत्यैरुपायः प्रविचिन्त्यताम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006274052, "chapter_id": 26274, "verse_number": "३-२८-५३", "content_sanskrit": "सर्वत्र द्व्यष्टसाहस्राक्षौहिण्यमत्र पोत्रिणि ।\nएकापि शक्तिर्नैवास्ति या तर्षेण न पीडिता ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006274053, "chapter_id": 26274, "verse_number": "३-२८-५४", "content_sanskrit": "अत्रैवावसरे दृष्ट्वा मुक्तशस्त्रां पताकिनीम् ।\nरन्ध्रप्रहारिणो हन्त बाणैर्निघ्नन्ति दानवाः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006274054, "chapter_id": 26274, "verse_number": "३-२८-५५", "content_sanskrit": "अत्रोपायस्त्वया कार्यो मया च समरोद्यमे ।\nत्वदीयरथपर्वस्थो योऽस्ति शीतमहार्णवः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006274055, "chapter_id": 26274, "verse_number": "३-२८-५६", "content_sanskrit": "तमादिश समस्तानां शक्तीनां तर्षनुत्तये ।\nनाल्पैः पानीयपानाद्यैरेतासां तर्षसंक्षयः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006274056, "chapter_id": 26274, "verse_number": "३-२८-५७", "content_sanskrit": "स एव मदिरासिंधुः शक्त्यौघं तर्पयिष्यति ।\nतमादिश महात्मानं समरोत्साहकारिणम् ।\nसर्वतर्षप्रशमनं महाबलविवर्धनम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006274057, "chapter_id": 26274, "verse_number": "३-२८-५८", "content_sanskrit": "इत्युक्ते दण्डनाथा सा सदुपायेन हर्षिता ।\nआजुहाव सुधासिंधुमाज्ञां चक्रेश्वरी रणे ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006274058, "chapter_id": 26274, "verse_number": "३-२८-५९", "content_sanskrit": "स मदालसरक्ताक्षो हेमाभः स्रग्विभूषितः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006274059, "chapter_id": 26274, "verse_number": "३-२८-६०", "content_sanskrit": "प्रणम्य दण्डनाथां तां तदाज्ञापरिपारकः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006274060, "chapter_id": 26274, "verse_number": "३-२८-६१", "content_sanskrit": "आत्मानं बहुधा कृत्वा तरुणादित्यपाटलम् ।\nक्वचित्तापिच्छवच्छ्यामं क्वचिच्च धवलद्युतिम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006274061, "chapter_id": 26274, "verse_number": "३-२८-६२", "content_sanskrit": "कोटिशो मधुराधारा करिहस्तसमाकृतीः ।\nववर्ष सिंधुराजोऽयं वायुना बहुलीकृतः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006274062, "chapter_id": 26274, "verse_number": "३-२८-६३", "content_sanskrit": "पुष्कलावर्तकाद्यैस्तु कलपक्षयबलाहकैः ।\nनिषिच्यमानो मध्येऽब्धिः शक्तिसैन्ये पपात ह ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006274063, "chapter_id": 26274, "verse_number": "३-२८-६४", "content_sanskrit": "यद्गन्धाघ्राममात्रेण मृत उत्तिष्ठते स्फुटम् ।\nदुर्बलः प्रबलश्च स्यात्तद्ववर्ष सुरांबुधिः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006274064, "chapter_id": 26274, "verse_number": "३-२८-६५", "content_sanskrit": "परार्द्धसंख्यातीतास्ता मधुधारापरंपराः ।\nप्रपिबन्त्यः पिपासार्तैर्मुखैः शक्तय उत्थिताः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006274065, "chapter_id": 26274, "verse_number": "३-२८-६६", "content_sanskrit": "यथा सा मदिरासिंधुवृष्टिर्दैत्येषु नो पतेत् ।\nतथा सैन्यस्य परितो महाप्राकारमण्डलम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006274066, "chapter_id": 26274, "verse_number": "३-२८-६७", "content_sanskrit": "लघुहस्ततया मुक्तैः शरजातैः सहस्रशः ।\nचकार विस्मयकरी कदंबवनवासिनी ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006274067, "chapter_id": 26274, "verse_number": "३-२८-६८", "content_sanskrit": "कर्मणा तेन सर्वेऽपि विस्मिता मरुतोऽभवन् ।\nअथ ताः शक्तयो भूरि पिबन्ति स्म रणान्तरे ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006274068, "chapter_id": 26274, "verse_number": "३-२८-६९", "content_sanskrit": "विविधा मदिराधारा बलोत्साहविवर्धनीः ।\nयस्या यस्या मनःप्रीती रुचिः स्वादो यथायथा ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006274069, "chapter_id": 26274, "verse_number": "३-२८-७०", "content_sanskrit": "तृतीये युद्धदिवसे प्रहरद्वितयावधि ।\nसंततं मध्यधाराभिः प्रववर्ष सुरांबुधिः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006274070, "chapter_id": 26274, "verse_number": "३-२८-७१", "content_sanskrit": "गौडी पैष्टी च माध्वी च वरा कादंबरी तथा ।\nहैताली लाङ्गलेया च तालजातास्तथा सुराः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006274071, "chapter_id": 26274, "verse_number": "३-२८-७२", "content_sanskrit": "कल्पवृक्षोद्भवा दिव्या नानादेशसमुद्भवाः ।\nसुस्वादुसौरभाद्याश्च शुभगन्धसुखप्रदाः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006274072, "chapter_id": 26274, "verse_number": "३-२८-७३", "content_sanskrit": "बकुलप्रसवामोदा ध्वनन्त्यो बुद्बुदोज्ज्वलाः ।\nकटुकाश्च कषायाश्च मधुरास्तिक्ततास्पृशः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006274073, "chapter_id": 26274, "verse_number": "३-२८-७४", "content_sanskrit": "बहुवर्मसमाविष्टाश्छेदिनीः पिच्छलास्तथा ।\nईषदम्लाश्च कट्वम्ला मधुराम्लास्तथा पराः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006274074, "chapter_id": 26274, "verse_number": "३-२८-७५", "content_sanskrit": "शस्त्रक्षतरुगाहन्त्री चास्थिसंधानदायिनी ।\nरणभ्रमहरा शीता लघ्व्यस्तद्वत्कवोष्ठकाः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006274075, "chapter_id": 26274, "verse_number": "३-२८-७६", "content_sanskrit": "संतापहारिणीश्चैव वारुणीस्ता जयप्रदाः ।\nनानाविधाः सुराधारा ववर्ष मदिरार्णवः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006274076, "chapter_id": 26274, "verse_number": "३-२८-७७", "content_sanskrit": "अविच्छिन्नं याममात्रमेकैका तत्र योगिनी ।\nऐरावतकर प्रख्यां सुराधारां मुदा पपौ ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006274077, "chapter_id": 26274, "verse_number": "३-२८-७८", "content_sanskrit": "उत्तानं वदनं कृत्वा विलोलरसनाश्चलम् ।\nशक्तयः प्रपपुः सीधु मुदा मीलितलोचनाः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006274078, "chapter_id": 26274, "verse_number": "३-२८-७९", "content_sanskrit": "इत्थं बहुविधं माध्वीधारापातैः सुधांबुधिः ।\nआगतस्तर्पयित्वा तु दिव्यरूपं समास्थितः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006274079, "chapter_id": 26274, "verse_number": "३-२८-८०", "content_sanskrit": "पुनर्गत्वा दण्डनाथां प्रणम्य स सुरांबुधिः ।\nस्निग्धगंभीरघोषेण वाक्यं चेदमुवाच ताम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006274080, "chapter_id": 26274, "verse_number": "३-२८-८१", "content_sanskrit": "देवि पश्य महाराज्ञि दण्डमण्डलनायिके ।\nमया संतर्पिता मुग्धरूपा शक्तिवरूथिनी ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006274081, "chapter_id": 26274, "verse_number": "३-२८-८२", "content_sanskrit": "काश्चिन्नृत्यन्ति गायन्त्यो कलक्वणितमेखलाः ।\nनृत्यन्तीनां पुरः काश्चित्करतालं वितन्वते ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006274082, "chapter_id": 26274, "verse_number": "३-२८-८३", "content_sanskrit": "काश्चिद्धसंति व्यावल्गद्वल्गुवक्षोजमण्डलाः ।\nपतन्त्यन्योन्यमङ्गेषु काश्चिदानन्दमन्थराः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006274083, "chapter_id": 26274, "verse_number": "३-२८-८४", "content_sanskrit": "काश्चिद्वल्गन्ति च श्रोणिविगलन्मेखलांबराः ।\nकाश्चिदुत्थाय संनद्धा घूर्णयन्ति निरायुधाः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006274084, "chapter_id": 26274, "verse_number": "३-२८-८५", "content_sanskrit": "इत्थं निर्दिश्यमानास्ताः शक्ती मैरेय सिंधुनां ।\nअवलोक्य भृशं तुष्टा दण्डिनी तमुवाच ह ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006274085, "chapter_id": 26274, "verse_number": "३-२८-८६", "content_sanskrit": "परितुष्टास्मि मद्याब्धे त्वया साह्यमनुष्ठितम् ।\nदेवकार्यमिद किञ्च निर्विघ्नितमिदं कृतम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006274086, "chapter_id": 26274, "verse_number": "३-२८-८७", "content_sanskrit": "अतः परं मत्प्रसादाद्द्वापरे याज्ञिकैर्मखे ।\nसोमपानवदत्यन्तमुपयोज्यो भविष्यसि ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006274087, "chapter_id": 26274, "verse_number": "३-२८-८८", "content_sanskrit": "मन्त्रेण पूतं त्वां यागे पास्यन्त्यखिलदेवताः ।\nयागेषु मन्त्रपूतेन पीतेन भवता जनाः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006274088, "chapter_id": 26274, "verse_number": "३-२८-८९", "content_sanskrit": "सिद्धिमृद्धिं बलं स्वर्गमपवर्गं च बिभ्रतु ।\nमहेश्वरी महादेवो बलदेवश्च भार्गवः ।\nदत्तात्रेयो विधिर्विष्णुस्त्वां पास्यन्ति महाजनाः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006274089, "chapter_id": 26274, "verse_number": "३-२८-९०", "content_sanskrit": "यागे समर्चितस्त्वं तु सर्वसिद्धिं प्रदास्यसि ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006274090, "chapter_id": 26274, "verse_number": "३-२८-९१", "content_sanskrit": "इत्थं वरप्रदानेन तोषयित्वा सुरांबुधिम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006274091, "chapter_id": 26274, "verse_number": "३-२८-९२", "content_sanskrit": "मन्त्रिणीं त्वरयामास पुनर्युद्धाय दण्डिनी ।\nपुनः प्रववृते युद्धं शक्तीनां दानवैः सह ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006274092, "chapter_id": 26274, "verse_number": "३-२८-९३", "content_sanskrit": "मुदाट्टहासनिर्भिन्नदिगष्टकधरा धरम् ।\nप्रत्यग्रमदिरामत्ताः पाटलीकृतलोचनाः ।\nशक्तयो दैत्यचक्रेषु न्यपतन्नेकहेलया ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006274093, "chapter_id": 26274, "verse_number": "३-२८-९४", "content_sanskrit": "द्वयेन द्वयमारेजे शक्तीनां समदश्रियाम् ।\nमदरागेण चक्षूंषि दैत्यरक्तेन शस्त्रिका ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006274094, "chapter_id": 26274, "verse_number": "३-२८-९५", "content_sanskrit": "तथा बभूव तुमुलं युद्धं शक्तिसुरद्विषाम् ।\nयथा मृत्युरवित्रस्तः प्रजाः संहरते स्वयम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006274095, "chapter_id": 26274, "verse_number": "३-२८-९६", "content_sanskrit": "संस्खलत्पदविन्यासा मदेनारक्तदृष्टयः ।\nस्खलदक्षरसंदर्भवीरभाषा रणोद्धताः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006274096, "chapter_id": 26274, "verse_number": "३-२८-९७", "content_sanskrit": "कदंबगोलकाकारा दृष्टसर्वाङ्गदृष्टयः ।\nयुवराजस्य सैन्यानि शक्त्यः समानाशयन् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006274097, "chapter_id": 26274, "verse_number": "३-२८-९८", "content_sanskrit": "अक्षौहिणीशतं तत्र दण्डिनी सा व्यदारयत् ।\nअक्षौहिणीसार्द्धशत नाशयामास मन्त्रिणी ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7006274098, "chapter_id": 26274, "verse_number": "३-२८-९९", "content_sanskrit": "अश्वारूढाप्रभृतयो मदारुणविलोचनाः ।\nअक्षौहिणीसार्धशतं नित्युरन्तकमन्दिरम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7006274099, "chapter_id": 26274, "verse_number": "३-२८-१००", "content_sanskrit": "अङ्कुशेनातितीक्ष्णेन तुरगा रोहिणी रणे ।\nउलूकजितमुन्मथ्य परलोकातिथिं व्यधात् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7006274100, "chapter_id": 26274, "verse_number": "३-२८-१०१", "content_sanskrit": "सम्पत्करीप्रभृतयः शक्तिदण्डाधिनायिकाः ।\nपरुषेण मुखान्यन्यान्यवरुद्धाव्यदारयन् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7006274101, "chapter_id": 26274, "verse_number": "३-२८-१०२", "content_sanskrit": "अस्तं गते सवितरि ध्वस्तसर्वबलं ततः ।\nविशुक्रं योधयामास श्यामला कोपशालिनी ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7006274102, "chapter_id": 26274, "verse_number": "३-२८-१०३", "content_sanskrit": "अस्त्रप्रत्य स्त्रमोक्षेण भीषणेन दिवौकसाम् ।\nमहता रणकृत्येन योधयामास मन्त्रिणी ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7006274103, "chapter_id": 26274, "verse_number": "३-२८-१०४", "content_sanskrit": "आयुधानि सुतीक्ष्णानि विशुक्रस्य महौजसः ।\nक्रमशः खण्डयन्ती सा केतनं रथसारथिम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7006274104, "chapter_id": 26274, "verse_number": "३-२८-१०५", "content_sanskrit": "धनुर्गुणं धनुर्दण्डं खण्डयन्ती शिलीमुखैः ।\nअस्त्रेण ब्रह्मशिरसा ज्वलत्पावकरोचिषा ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7006274105, "chapter_id": 26274, "verse_number": "३-२८-१०६", "content_sanskrit": "विशुक्रं मर्दयामास सोऽपतच्छूर्णविग्रहः ।\nविषङ्गं च महादैत्यं दण्डनाथा मदोद्धता ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7006274106, "chapter_id": 26274, "verse_number": "३-२८-१०७", "content_sanskrit": "योधयामास चण्डन मुसलेन विनिघ्नती ।\nसचापि दुष्टो दनुजः कालदण्डनिभां गदाम् ।\nउद्यम्य बाहुना युद्धं चकाराशेषभीषणम् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7006274107, "chapter_id": 26274, "verse_number": "३-२८-१०८", "content_sanskrit": "अन्योन्यमङ्गं मृद्नन्तौ गदायुद्धप्रवर्तिनौ ।\nचण्डाट्टहासमुखरौ परिभ्रमणकारिणौ ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7006274108, "chapter_id": 26274, "verse_number": "३-२८-१०९", "content_sanskrit": "कुर्वाणौ विविधांश्चारान्घूर्णन्तौ तूर्मवेष्टिनौ ।\nअन्योन्यदण्डहननैर्मोहयन्तौ मुहुर्मुहुः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7006274109, "chapter_id": 26274, "verse_number": "३-२८-११०", "content_sanskrit": "अन्योन्यप्रहृतौ रन्ध्रमीक्षमाणौ महोद्धतौ ।\nमहामुसलदण्डाग्रघट्टनक्षोभितांबरौ ।\nअयुध्येतां दुराधर्षौं दण्डिनीदैत्यशेखरौ ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7006274110, "chapter_id": 26274, "verse_number": "३-२८-१११", "content_sanskrit": "अथार्द्धरात्रिसमयपर्यन्तं कृतसंगरा ।\nसंक्रुद्धा हन्तुमारेभे विषङ्गं दण्डनायिका ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7006274111, "chapter_id": 26274, "verse_number": "३-२८-११२", "content_sanskrit": "तं मूर्धनि निमग्नेन हलेनाकृष्य वैरिणम् ।\nकठोरं ताडनं चक्रे मुसलेनाथ पोत्रिणी ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7006274112, "chapter_id": 26274, "verse_number": "३-२८-११३", "content_sanskrit": "ततो मुसलघातेन त्यक्तप्राणो महासुरः ।\nचूर्णितेन शताङ्गेन समं भूतलमाश्रयत् ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}]