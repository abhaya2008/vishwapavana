[{"id": 2159388, "chapter_id": 4461, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2159389, "chapter_id": 4461, "verse_number": "१", "content_sanskrit": "वैन्यं पृथुं च राजानं मृतं सृञ्जय शुश्रम ।\nयमभ्यषिञ्चन् सम्मन्त्र्य राजसूये महर्षयः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2159390, "chapter_id": 4461, "verse_number": "२", "content_sanskrit": "अयं नः प्रथयिष्येत सर्वानित्यभवत् पृथुः ।\nक्षतान्नस्त्रास्यते नित्यम् इति च क्षत्रियोऽभवत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2159391, "chapter_id": 4461, "verse_number": "३", "content_sanskrit": "पृथुं वैन्यं प्रजा दृष्ट्वा रक्ताः स्मेति यदब्रुवन् ।\nततो राजेति नामास्य अनुरागादजायत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2159392, "chapter_id": 4461, "verse_number": "४", "content_sanskrit": "अकृष्टपच्या पृथिवी ह्यासीद् वैन्यस्य कामधुक् ।\nसर्वाः कामदुघा गावः पुटके पुटके मधु\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2159393, "chapter_id": 4461, "verse_number": "५", "content_sanskrit": "आसन् हिरण्मया वृक्षाः सुखस्पर्शाः सुगन्धिनः ।\nतेषां चीराणि संवीताः प्रजास्तेष्वेव शेरते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2159394, "chapter_id": 4461, "verse_number": "६", "content_sanskrit": "फलान्यमृतकल्पानि मूलानि च मधूनि च ।\nतेषामासीत् तदाऽऽहारो निराहारोऽपि नाभवत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2159395, "chapter_id": 4461, "verse_number": "७", "content_sanskrit": "अरोगाः सर्वसिद्धार्था मनुष्या अकुतोभयाः ।\nनिवसन्ति यथाकामं वृक्षेषु च गृहेषु च\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2159396, "chapter_id": 4461, "verse_number": "८", "content_sanskrit": "प्रविभागो न राष्ट्राणां पुराणामभवत् तदा ।\nयथासुखं यथारम्यं तथैव मुदिताः प्रजाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2159397, "chapter_id": 4461, "verse_number": "९", "content_sanskrit": "तस्य संस्तम्भयन्नापः समुद्रमभियास्यतः ।\nपर्वताश्चावलीयन्त ध्वजभङ्गश्च नाभवत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2159398, "chapter_id": 4461, "verse_number": "१०", "content_sanskrit": "तं वनस्पतयः शैलाः देवासुरनरोरगाः ।\nसप्तर्षयः पुण्यजना गन्धर्वाप्सरसोऽपि च\nपितरश्च सुखासीनमभिगम्येदमब्रुवन्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2159399, "chapter_id": 4461, "verse_number": "११", "content_sanskrit": "सम्राडसि क्षत्रियोऽसि राजा गोप्ताऽसि पाहि नः ।\nदेह्यस्मभ्यं महाराज प्रभुः सन्नीप्सितान् वरान्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2159400, "chapter_id": 4461, "verse_number": "१२", "content_sanskrit": "यैर्वयं शाश्वतं तृप्ता वर्तयिष्यामहे सुखम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2159401, "chapter_id": 4461, "verse_number": "१३", "content_sanskrit": "विज्ञापितः प्रजाभिस्तु प्रजानां हितकाम्यया ।\nतथेत्युक्त्वा धनुर्गृह्य वसुधामाद्रवद् बली\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2159402, "chapter_id": 4461, "verse_number": "१४", "content_sanskrit": "ततो वैन्यभयाद् राजन् गौर्भूत्वा प्राद्रवन्मही ।\nतां पृथुर्धनुरादाय द्रवन्तीमन्वसारयत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2159403, "chapter_id": 4461, "verse_number": "१५", "content_sanskrit": "सा लोकान् ब्रह्मलोकादीन् गत्वा वैन्यभयार्दिता ।\nसा ददर्शाग्रतो वैन्यं कार्मुकोद्यतपाणिनम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2159404, "chapter_id": 4461, "verse_number": "१६", "content_sanskrit": "ज्वलद्भिर्विशिखैर्बाणैर्दीप्ततेजःसमद्युतिम् ।\nमहायोगं महात्मानं दुर्धर्षममरैरपि\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2159405, "chapter_id": 4461, "verse_number": "१७", "content_sanskrit": "अलभन्ती परित्राणं वैन्यमेवान्वपद्यत ।\nकृताञ्जलिपुटा राजन् पूज्यं लोकैस्त्रिभिस्तदा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2159406, "chapter_id": 4461, "verse_number": "१८", "content_sanskrit": "उवाच चैनं नाधर्म्यं स्त्रीवधं कर्तुमर्हसि ।\nकथं धारयिता चासि प्रजा राजन् मया विना\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2159407, "chapter_id": 4461, "verse_number": "", "content_sanskrit": "पृथुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2159408, "chapter_id": 4461, "verse_number": "", "content_sanskrit": "एकस्यार्थाय यो हन्याद् आत्मनो वा परस्य वा ।\nएकं प्राणान् बहून् वाऽपि प्राणिनां नास्ति पातकम् १९", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2159409, "chapter_id": 4461, "verse_number": "२०", "content_sanskrit": "यस्मिंस्तु निहते भद्रे बहवः सुखमेधते ।\nयस्मिन् हते सुखं नास्ति पातकं सोपभुज्यते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2159410, "chapter_id": 4461, "verse_number": "२१", "content_sanskrit": "सोऽहं पालनिमित्तत्वाद् वधिष्यामि वसुन्धरे ।\nयदि चेद् वचनादद्य न करिष्यसि मे प्रियम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2159411, "chapter_id": 4461, "verse_number": "२२", "content_sanskrit": "त्वां निहत्य तु बाणेन मच्छासनपराङ्मुखीम् ।\nआत्मानं प्रथयित्वाऽहं प्रजा धारयिता स्वयम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2159412, "chapter_id": 4461, "verse_number": "२३", "content_sanskrit": "सुखं वचनमास्थाय मम धर्मभृतां वरे ।\nसञ्जीवय प्रजा नित्यं शक्ता ह्यसि वसुन्धरे\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2159413, "chapter_id": 4461, "verse_number": "२४", "content_sanskrit": "दुहितृत्वं च मे गच्छ एवमेतन्महाशरम् ।\nनियच्छेयं त्वदर्थाय उद्यतं घोरदर्शनम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2159414, "chapter_id": 4461, "verse_number": "", "content_sanskrit": "भूमिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2159415, "chapter_id": 4461, "verse_number": "२५", "content_sanskrit": "सर्वमेतन्महाराज विधास्यामि परन्तप ।\nवत्सं त्वं पश्य राजन् वै क्षरेयं येन वत्सला\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2159416, "chapter_id": 4461, "verse_number": "२६", "content_sanskrit": "समां च कुरु सर्वत्र मां वै धर्मभृतां वर ।\nयथा विष्यन्दमानं वै क्षीरं सर्वत्र भावये\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2159417, "chapter_id": 4461, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2159418, "chapter_id": 4461, "verse_number": "२७", "content_sanskrit": "तत उत्सारयामास शिलाजालानि सर्वशः ।\nपृथुर्वैन्यस्तदा राजा तेन शैला विवर्धिताः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2159419, "chapter_id": 4461, "verse_number": "२८", "content_sanskrit": "न हि पूर्वनिसर्गे वै विषमे वसुधातळे ।\nप्रविभागः पुराणां वा ग्रामाणां वा महीपते\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2159420, "chapter_id": 4461, "verse_number": "२९", "content_sanskrit": "न सस्यानि न गोरक्ष्यं न कृषिर्न वणिक्पथः ।\nवैन्यात् प्रभृति राजेन्द्र सर्वस्यैतस्य सम्भवः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2159421, "chapter_id": 4461, "verse_number": "३०", "content_sanskrit": "यत्र यत्र च साम्यं तु भूमावासीत् किलानघ ।\nतत्र तत्र प्रजास्तात निवासमभिरोचयन्\nकृच्छ्रेणैव महाराज इत्येवमनुशुश्रुम\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2159422, "chapter_id": 4461, "verse_number": "३१", "content_sanskrit": "तथेत्युक्त्वा पुनर्वैन्यो गृहीत्वाऽऽजगवं धनुः ।\nशरांश्चाप्रतिमान् घोरांश्चिन्तयित्वाऽब्रवीन्महीम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2159423, "chapter_id": 4461, "verse_number": "३२", "content_sanskrit": "एह्येहि वसुधे क्षिप्रं क्षरैभ्यः काङ्क्षितं पयः ।\nमच्छासनातिगां वै त्वां प्रमथिष्याम्यहं शरैः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2159424, "chapter_id": 4461, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2159425, "chapter_id": 4461, "verse_number": "", "content_sanskrit": "तथोक्ता साऽत्मनः श्रेयः चिन्तयित्वाऽब्रवीत् पृथुम्।३३।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2159426, "chapter_id": 4461, "verse_number": "३४", "content_sanskrit": "वत्सं पात्राणि दोग्धॄंश्च क्षीराणि च समादिश ।\nततो दास्याम्यहं भद्र सर्वं यस्य यथेप्सितम्\nदुहितृत्वे च मां वीर सङ्कल्पयितुमर्हसि\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2159427, "chapter_id": 4461, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2159428, "chapter_id": 4461, "verse_number": "३५", "content_sanskrit": "तथेत्युक्त्वा पृथुः सर्वं विधानमकरोद् वशी ।\nततो भूतनिकायास्ते वसुधां दुदुहुस्तदा\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2159429, "chapter_id": 4461, "verse_number": "", "content_sanskrit": "तां वनस्पतयः पूर्वमुपतस्थुर्दुधुक्षवः ।\nसाऽतिष्ठद् वत्सला वत्सं दोग्धॄन् पात्राणि चेच्छती ।३६।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2159430, "chapter_id": 4461, "verse_number": "३७", "content_sanskrit": "वत्सोऽभूत् पुष्पितः सालः प्लक्षो दोग्धा द्विजद्रुमः ।\nछिन्नप्ररोहणं दुग्धं पात्रमौदुम्बरं शुभम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2159431, "chapter_id": 4461, "verse_number": "३८", "content_sanskrit": "उदयः पर्वतो वत्सो मेरुर्दोग्धा महागिरिः ।\nरत्नान्योषधयो दुग्धं पात्रमश्ममयं तथा\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2159432, "chapter_id": 4461, "verse_number": "३९", "content_sanskrit": "देवानां वत्स इन्द्रोऽभूत् पात्रं दारुमयं तथा ।\nदोग्धा च सविता देवो दुग्धमूर्जस्करं प्रियम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2159433, "chapter_id": 4461, "verse_number": "४०", "content_sanskrit": "असुरा दुदुहुर्मायामयःपात्रे तु तामथ ।\nदोग्धा द्विमूर्धा तु तदा वत्सश्चासीद् विरोचनः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2159434, "chapter_id": 4461, "verse_number": "४१", "content_sanskrit": "कृषिं च सस्यं च नरा दुदुहुर्धरणीतळे ।\nस्वायम्भुवो मनुर्वत्सः तेषां दोग्धाऽभवत् पृथुः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2159435, "chapter_id": 4461, "verse_number": "४२", "content_sanskrit": "अलाबुपात्रेषु विषं नागैर्दुग्धा वसुन्धरा ।\nधृतराष्ट्रोऽभवद् दोग्धा तेषां वत्सस्तु तक्षकः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2159436, "chapter_id": 4461, "verse_number": "४३", "content_sanskrit": "सप्तर्षिभिर्ब्रह्म दुग्धं तपश्चाक्लिष्टकर्मभिः ।\nदोग्धा बृहस्पतिः पात्रं छन्दो वत्सस्तु सोमराट्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2159437, "chapter_id": 4461, "verse_number": "४४", "content_sanskrit": "अन्तर्धानं चामपात्रे दुग्धं पुण्यजनैर्विराट् ।\nदोग्धा वैश्रवणस्तेषां वत्स आसीत् कुबेरकः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2159438, "chapter_id": 4461, "verse_number": "४५", "content_sanskrit": "पुण्यगन्धं पद्मपात्रे गन्धर्वाप्सरसोऽदुहन् ।\nवत्सश्चित्ररथस्तेषां दोग्धा वसुरपि प्रभुः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2159439, "chapter_id": 4461, "verse_number": "४६", "content_sanskrit": "स्वधां रजतपात्रेषु दुदुहुः पितरः स्म ताम् ।\nवत्सोऽत्र वत्सरस्तेषां यमो दोग्धा तथाऽन्तकः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2159440, "chapter_id": 4461, "verse_number": "४७", "content_sanskrit": "एवं निकायैस्तैर्दुग्धा पयांसीष्टानि सा विराट् ।\nयैर्वर्तयन्ति ते ह्यद्य पात्रैर्वत्साश्च नित्यशः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2159441, "chapter_id": 4461, "verse_number": "४८", "content_sanskrit": "स यज्ञैर्विविधैरिष्ट्वा पृथुर्वैन्यः प्रतापवान् ।\nसन्तर्पयित्वा भूतानि सर्वकामैर्मनःप्रियैः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2159442, "chapter_id": 4461, "verse_number": "४९", "content_sanskrit": "हैरण्यानकरोद् राजा ये केचित् पार्थिवा भुवि ।\nतान् ब्राह्मणेभ्यः प्रायच्छद् अश्वमेधे महामखे\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2159443, "chapter_id": 4461, "verse_number": "५०", "content_sanskrit": "स षष्टिं गोसहस्राणि षष्टिं नागशतानि च ।\nसौवर्णानकरोद् राजा ब्राह्मणेभ्यश्च तान् ददौ\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2159444, "chapter_id": 4461, "verse_number": "५१", "content_sanskrit": "य इमां पृथिवीं सर्वां मणिरत्नविभूषिताम् ।\nकृत्वा हिरण्मयीं राजा ब्राह्मणेभ्यो ह्यमंसत\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2159445, "chapter_id": 4461, "verse_number": "", "content_sanskrit": "स चेन्ममार सृञ्जय चतुर्भद्रतरस्त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2159446, "chapter_id": 4461, "verse_number": "५२", "content_sanskrit": "पुत्रात् पुण्यतमस्तुभ्यं मा पुत्रमनुतप्यथाः ।\nअयज्वानमदक्षिण्यमधिचैत्येत्युदाहरत्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2159447, "chapter_id": 4461, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि षट्षष्टितमोऽध्यायः ॥ ६६ ॥\nअभिमन्युवधपर्वणि पञ्चत्रिंशोऽध्यायः ॥ ३५ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]