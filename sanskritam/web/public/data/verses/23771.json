[{"id": 7003771000, "chapter_id": 23771, "verse_number": "२-२-१५-१", "content_sanskrit": "जैमिनिरुवाच ।\nततस्ते प्रस्थिता विप्रा नीलकण्ठांतिकं मुदा ।\nप्रपूज्य तं महादेवं श्रीदुर्गां प्रणिपत्य च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003771001, "chapter_id": 23771, "verse_number": "२-२-१५-२", "content_sanskrit": "विमुच्य स्यंदनवरं पादचाराः सहानुगाः ।\nआरोढुं नीलभूमिध्रं प्रयाताः संयतेद्रियाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003771002, "chapter_id": 23771, "verse_number": "२-२-१५-३", "content_sanskrit": "नानाद्रुमलताकीर्णं नानापक्षिगणाकुलम् ।\nशिलाविषमसंरोधमभितः परिवेषकम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003771003, "chapter_id": 23771, "verse_number": "२-२-१५-४", "content_sanskrit": "भ्रमद्भ्रमरसंभूतभ्रमकृद्गंडशैलकम् ।\nदक्षिणांभोधिकल्लोलजलावृतनितंबकम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003771004, "chapter_id": 23771, "verse_number": "२-२-१५-५", "content_sanskrit": "अप्रतर्क्यं सदा मर्त्यैर्दुष्प्रवेश्यं महोरगैः ।\nमत्तमातंगकघटाबृंहितैर्भीषणांतरम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003771005, "chapter_id": 23771, "verse_number": "२-२-१५-६", "content_sanskrit": "श्वापदैश्चिरसंवासैः शस्त्राघातमवेदिभिः ।\nनिर्भयैः परितः कीर्णं मृगयूथैरनेकशः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003771006, "chapter_id": 23771, "verse_number": "२-२-१५-७", "content_sanskrit": "प्रवेष्टुकामा न प्रापुर्यदा ते मार्गमंतरम् ।\nतदा नारदसंसर्गाद्विदित्वा तु गिरेः शिरः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003771007, "chapter_id": 23771, "verse_number": "२-२-१५-८", "content_sanskrit": "आसेदुर्यत्र वसति कृष्णागुरुतरोरधः ।\nसर्वापद्भयसंहर्ता दिव्यसिंहवपुर्विभुः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003771008, "chapter_id": 23771, "verse_number": "२-२-१५-९", "content_sanskrit": "यं दृष्ट्वा ब्रह्महत्याया लीयन्ते कोटयो नृणाम् ।\nव्यात्तास्यं भीमदशनमापिंगलसटाकुलम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003771009, "chapter_id": 23771, "verse_number": "२-२-१५-१०", "content_sanskrit": "उग्रं त्रिनेत्रं दैत्यस्य स्वोरावुत्तानशायिनः ।\nवक्षःस्थलं दारयंतं नखरैर्वज्रदारुणैः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003771010, "chapter_id": 23771, "verse_number": "२-२-१५-११", "content_sanskrit": "अरुणाभं लसज्जिह्वं साट्टहासमुखं विभुम् ।\nशंखचक्रलसद्बाहुं किरीटमुकुटोज्ज्वलम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003771011, "chapter_id": 23771, "verse_number": "२-२-१५-१२", "content_sanskrit": "नेत्रोच्छलद्वह्निकणसंत्रासितदिगन्तरम् ।\nप्रचंडाघातभूम्यंतप्रविष्टपदपंकजम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003771012, "chapter_id": 23771, "verse_number": "२-२-१५-१३", "content_sanskrit": "तमादिमृर्तिं ते दृष्ट्वा नारदाग्रे तदा हरिम् ।\nनिर्भया ददृशुर्दूरात्प्रणेमुर्विगतज्वराः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003771013, "chapter_id": 23771, "verse_number": "२-२-१५-१४", "content_sanskrit": "इन्द्रद्युम्नोऽपि तं दृष्ट्वा नारदोक्तौ विशस्वसे ।\nभाविकार्ये प्रत्ययवानिदमाह महामुनिम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003771014, "chapter_id": 23771, "verse_number": "२-२-१५-१५", "content_sanskrit": "महर्षे कृतकृत्योऽस्मि त्वं हि ज्ञाननिधिः परम् ।\nदुराराध्यो नृसिहोऽयं दर्शनेऽपि भयावहः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003771015, "chapter_id": 23771, "verse_number": "२-२-१५-१६", "content_sanskrit": "भवादृशैः सुसेव्योयं मादृशैर्दूरतोऽपि सः ।\nदर्शनात्कृतकृत्योऽस्मि संलीनाशेषपातकः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003771016, "chapter_id": 23771, "verse_number": "२-२-१५-१७", "content_sanskrit": "त्वत्सन्निधानादेवात्र तिष्ठामो निर्भया मुने ।\nअत्युग्र मूर्तिर्भगवान्स्वल्पवीर्यैर्नरैः कथम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003771017, "chapter_id": 23771, "verse_number": "२-२-१५-१८", "content_sanskrit": "आराध्यते दैत्यराजं त्रिलोकेशं विदारयन् ।\nयस्य नीलमयी मूर्तिः कृपासिंधोः स्थिता तु वै ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003771018, "chapter_id": 23771, "verse_number": "२-२-१५-१९", "content_sanskrit": "कस्मिन्स्थले मुनिश्रेष्ठ दर्शनाद्या विमुक्तिदा ।\nतन्मे दर्शय विप्रेंद्र यन्मे मुक्तिप्रदं मतम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003771019, "chapter_id": 23771, "verse_number": "२-२-१५-२०", "content_sanskrit": "इत्युक्तो नारदस्तस्मै दर्शयामास पावनम् ।\nस्थानं यत्र स्थितो देवः स्वर्णसैकत संवृतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003771020, "chapter_id": 23771, "verse_number": "२-२-१५-२१", "content_sanskrit": "पश्यैतं योजनायामं योजनद्वयमुच्छ्रितम् ।\nकल्पांतस्थायिनं भूप न्यग्रोधं मुक्तिदं नृणाम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003771021, "chapter_id": 23771, "verse_number": "२-२-१५-२२", "content_sanskrit": "छायायाः क्रमणाद्यस्य मुच्यते पापकंचुकात् ।\nअस्य मूले नरः प्राणांस्त्यजन्मुक्तिमवाप्नुयात् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003771022, "chapter_id": 23771, "verse_number": "२-२-१५-२३", "content_sanskrit": "न्यग्रोधरूपं दृष्ट्वापि नारायणमकल्मषम् ।\nनिष्पापो जायते मर्त्यः किमुत पूजयन्स्तुवन् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003771023, "chapter_id": 23771, "verse_number": "२-२-१५-२४", "content_sanskrit": "अस्य मूलात्प्रतीच्यां हि नृसिंहस्योत्तरे नृप ।\nअतिष्ठन्माधवो यत्र चतुर्मूर्तिधरो विभुः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003771024, "chapter_id": 23771, "verse_number": "२-२-१५-२५", "content_sanskrit": "अनुग्रहीतुं त्वामेव पुनरत्रोद्भविष्यति ।\nश्वेतद्वीपे यथा विष्णुर्भोगभूमौ निजालयः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003771025, "chapter_id": 23771, "verse_number": "२-२-१५-२६", "content_sanskrit": "जंबूद्वीपे कर्मभूमौ निजं स्थानमिदं स्मृतम् ।\nस्वस्यैवातिरहस्यत्वान्न प्रकाशोस्य संमतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003771026, "chapter_id": 23771, "verse_number": "२-२-१५-२७", "content_sanskrit": "मोक्षाधिकारी जानाति स्थलमेतन्महीपते ।\nअविश्वासपदं नृणां दुष्कृतां हि विशेषतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003771027, "chapter_id": 23771, "verse_number": "२-२-१५-२८", "content_sanskrit": "अत्र याऽन्या प्रतिकृतिः पौरैर्विष्णोः प्रतिष्ठिता ।\nसापि मुक्तिप्रदा भूप किं पुनः सा स्वयंभुवा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003771028, "chapter_id": 23771, "verse_number": "२-२-१५-२९", "content_sanskrit": "अंतर्द्धानतिरोधाने सुनिमित्ते जगत्प्रभोः ।\nअनुग्रहार्थं साधूनां जायते च युगेयुगे ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003771029, "chapter_id": 23771, "verse_number": "२-२-१५-३०", "content_sanskrit": "नानावतारैर्भगवान्मत्स्यकूर्मादिकैर्नृप ।\nनिमित्तनाशे च तिरोदधाति परमेश्वरः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003771030, "chapter_id": 23771, "verse_number": "२-२-१५-३१", "content_sanskrit": "निर्निमित्तं स्थितो नित्यमिह कारुण्यसागरः ।\nश्वेतद्वीपाद्यथा विष्णुरन्यत्रावतरेत्प्रभुः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003771031, "chapter_id": 23771, "verse_number": "२-२-१५-३२", "content_sanskrit": "अत्र स्थितोऽपि स द्वारकाकांचीपुष्करादिषु ।\nप्रकाशं याति कृपया तरुमूलप्ररोहवत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003771032, "chapter_id": 23771, "verse_number": "२-२-१५-३३", "content_sanskrit": "नानातीर्थेषु देशेषु क्षेत्रेष्वायतनेषु च ।\nअंशावतारास्तस्यैव मा भूत्ते संशयो नृप ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003771033, "chapter_id": 23771, "verse_number": "२-२-१५-३४", "content_sanskrit": "क्षणं न त्यजतीशानः क्षेत्रं क्षेत्रमिव स्वकम् ।\nत्वदुपज्ञस्तु भूपाल प्रकाशोऽन्यो भविष्यति ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003771034, "chapter_id": 23771, "verse_number": "२-२-१५-३५", "content_sanskrit": "इति संदर्शितं स्थानं नारदेन महात्मना ।\nसाष्टांगपातं भूमौ तदिंद्रद्युम्नो ननाम ह ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003771035, "chapter_id": 23771, "verse_number": "२-२-१५-३६", "content_sanskrit": "मन्वानस्तु स्थितं देवं प्रकाशमिव तुष्टुवे ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003771036, "chapter_id": 23771, "verse_number": "२-२-१५-३७", "content_sanskrit": "इंद्रद्युम्न उवाच ।\nदेवदेव जगन्नाथ प्रणतार्तिविनाशन ।\nत्राहि मां पुंडरीकाक्ष पतितं भवसागरे ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003771037, "chapter_id": 23771, "verse_number": "२-२-१५-३८", "content_sanskrit": "त्वमेक एव दुःखौघध्वंसकः परमेश्वर ।\nक्षुद्राः क्षुद्रान्हि सेवंते सुखलेशस्य लिप्सया ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003771038, "chapter_id": 23771, "verse_number": "२-२-१५-३९", "content_sanskrit": "अनादित्रिविधौघस्य राशेः स्वस्य महांहसः ।\nदुरुच्छेद्यस्य सततं पूर्यमाणस्य जन्मनः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003771039, "chapter_id": 23771, "verse_number": "२-२-१५-४०", "content_sanskrit": "किं पुनर्भक्तिभावेन साक्षान्मुक्तिप्रदं नृणाम् ।\nकर्माधीनं तु ये मूढा वदंति त्वां क्रृपानिधिम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003771040, "chapter_id": 23771, "verse_number": "२-२-१५-४१", "content_sanskrit": "ते न जानंति भगवन्कर्मैवं प्रेरितं त्वया ।\nअजामिलेन विप्रेण त्यक्त्वा वर्णाश्रमोदितम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003771041, "chapter_id": 23771, "verse_number": "२-२-१५-४२", "content_sanskrit": "किं न पापं कृतं स्वामिन्सोऽपि त्वन्नामकीर्तनात् ।\nमुक्तोऽभूत्स्मरणादेव पाशहस्तैर्विमोचितः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003771042, "chapter_id": 23771, "verse_number": "२-२-१५-४३", "content_sanskrit": "सर्वेऽप्युपाया देवेश कीर्तितास्तव दर्शने ।\nत्वयि दृष्टे हि भिद्यंते संशया हृदि संस्थिताः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003771043, "chapter_id": 23771, "verse_number": "२-२-१५-४४", "content_sanskrit": "निःसंशयो भवेत्सद्यः पापपुण्यक्षयो धुवम् ।\nत्वमेव शरणं दीनमनुगृह्णीष्व मां विभो ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003771044, "chapter_id": 23771, "verse_number": "२-२-१५-४५", "content_sanskrit": "निश्चितानि त्वया देव गर्भस्थस्य च यानि मे ।\nतैरेव मे जनिर्जातु याचे त्वां केवलं त्विदम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003771045, "chapter_id": 23771, "verse_number": "२-२-१५-४६", "content_sanskrit": "तिरश्चो मुक्तिदा मूर्तिः स्थिता ते याऽत्र तां पुनः ।\nअनेन चक्षुषा पश्यामीश नान्यत्प्रयोजनम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003771046, "chapter_id": 23771, "verse_number": "२-२-१५-४७", "content_sanskrit": "कृतांजलिपुटो राजा स्तुत्वैवं मधुसूदनम् ।\nपुनर्ननाम धरणीपृष्ठे साश्रुविलोचनः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003771047, "chapter_id": 23771, "verse_number": "२-२-१५-४८", "content_sanskrit": "ततोंऽतरिक्षगा वाणी सामसुस्वरभाषिणी ।\nउच्चचार नभोमध्ये इन्द्रद्युम्नस्य शृण्वतः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003771048, "chapter_id": 23771, "verse_number": "२-२-१५-४९", "content_sanskrit": "मा चिंतां व्रज भूपाल व्रजिष्ये त्वदृशोः पथम् ।\nपैतामहं वचः प्राह नारदो यत्कुरुष्व तत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003771049, "chapter_id": 23771, "verse_number": "२-२-१५-५०", "content_sanskrit": "तच्छ्रुत्वा दिव्यवचनं नारदस्य च भाषितम् ।\nश्रद्दधे वाजिमेधाय भगवत्प्रीतिकारकः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003771050, "chapter_id": 23771, "verse_number": "२-२-१५-५१", "content_sanskrit": "नारदं च पुनः प्राह हर्षगद्गदया गिरा ।\nमुने त्वया यदादिष्टं चतुर्मुखनिदेशतः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003771051, "chapter_id": 23771, "verse_number": "२-२-१५-५२", "content_sanskrit": "अशरीरा त्वियं वाणी अनुजज्ञे तदेव हि ।\nपितामहो जगन्नाथो भेदो वै नाऽनयोः क्वचित् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003771052, "chapter_id": 23771, "verse_number": "२-२-१५-५३", "content_sanskrit": "पद्मयोनेः सुतस्त्वं हि वचस्ते भगवद्वचः ।\nतत्कर्तव्यं प्रयत्नेन यच्छ्रेयौपपादकम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003771053, "chapter_id": 23771, "verse_number": "२-२-१५-५४", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे पुरुषोत्तमक्षेत्रमाहात्म्ये जैमिनिऋषिसंवादे पंचदशोऽध्यायः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]