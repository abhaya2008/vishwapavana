[{"id": 900003917, "chapter_id": 8311, "verse_number": "7.1", "content_sanskrit": "समः प्रियः सुहृद् ब्रह्मन् भूतानां भगवान् स्वयम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900003918, "chapter_id": 8311, "verse_number": "7.2", "content_sanskrit": "भ्रातर्येवं विनिहते हरिणा क्रोडमूर्तिना", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900003919, "chapter_id": 8311, "verse_number": "7.3", "content_sanskrit": "हिरण्यकशिपू राजन्नजेयमजरामरम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900003920, "chapter_id": 8311, "verse_number": "7.4", "content_sanskrit": "एवं वृतः शतधृतिः हिरण्यकशिपोरथ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900003921, "chapter_id": 8311, "verse_number": "7.5", "content_sanskrit": "पौरोहित्याय भगवान् वृतः काव्यः किलासुरैः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900003922, "chapter_id": 8311, "verse_number": "7.6", "content_sanskrit": "हन्तार्भका मे शृणुत वचो वः सर्वतः शिवम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900003923, "chapter_id": 8311, "verse_number": "7.7", "content_sanskrit": "एवं दैत्यसुतैः पृष्टो महाभागवतोऽसुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900003924, "chapter_id": 8311, "verse_number": "7.8", "content_sanskrit": "अथ दैत्यसुताः सर्वे श्रुत्वा तदनुवर्णितम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900003925, "chapter_id": 8311, "verse_number": "7.9", "con