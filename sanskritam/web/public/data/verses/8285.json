[{"id": 900003452, "chapter_id": 8285, "verse_number": "19.1", "content_sanskrit": "उपोद्घातः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900003453, "chapter_id": 8285, "verse_number": "19.2", "content_sanskrit": "धर्मक्षेत्रे कुरुक्षेत्रे समवेता युयुत्सवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900003454, "chapter_id": 8285, "verse_number": "19.3", "content_sanskrit": "तं तथा कृपयाविष्टं अश्रुपूर्णाकुलेक्षणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900003455, "chapter_id": 8285, "verse_number": "19.4", "content_sanskrit": "ज्यायसी चेत्कर्मणस्ते मता बुद्धिर्जनार्दन", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900003456, "chapter_id": 8285, "verse_number": "19.5", "content_sanskrit": "इमं विवस्वते योगं प्रोक्तवानहमव्ययम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900003457, "chapter_id": 8285, "verse_number": "19.6", "content_sanskrit": "सन्न्यासं कर्मणां कृष्ण पुनर्योगं च शंससि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900003458, "chapter_id": 8285, "verse_number": "19.7", "content_sanskrit": "अनाश्रितः कर्मफलं कार्यं कर्म करोति यः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900003459, "chapter_id": 8285, "verse_number": "19.8", "content_sanskrit": "मय्यासक्तमनाः पार्थ योगं युञ्जन्मदाश्रयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900003460, "chapter_id": 8285, "verse_number": "19.9", "content_sanskrit": "किं तद्ब्रह्म किमध्यात्मं कि कर्म पुरुषोत्तम", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900003461, "chapter_id": 8285, "verse_number": "19.10", "content_sanskrit": "इदं तु ते गुह्यतमं प्रवक्ष्याम्यनसूयवे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900003462, "chapter_id": 8285, "verse_number": "19.11", "content_sanskrit": "भूय एव महाबाहो श‍ृणु मे परमं वचः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900003463, "chapter_id": 8285, "verse_number": "19.12", "content_sanskrit": "मदनुग्रहाय परमं गुह्यमध्यात्मसंज्ञितम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900003464, "chapter_id": 8285, "verse_number": "19.13", "content_sanskrit": "एवं सततयुक्ता ये भक्तास्त्वां पर्युपासते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900003465, "chapter_id": 8285, "verse_number": "19.14", "content_sanskrit": "प्रकृतिं पुरुषं चैव क्षेत्रं क्षेत्रज्ञमेव च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900003466, "chapter_id": 8285, "verse_number": "19.15", "content_sanskrit": "परं भूयः प्रवक्ष्यामि ज्ञानानां ज्ञानमुत्तमम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900003467, "chapter_id": 8285, "verse_number": "19.16", "content_sanskrit": "ऊर्ध्वमूलमधःशाखमश्वत्थं प्राहुरव्ययम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900003468, "chapter_id": 8285, "verse_number": "19.17", "content_sanskrit": "अभयं सत्त्वसंशुद्धिर्ज्ञानयोगव्यवस्थितिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900003469, "chapter_id": 8285, "verse_number": "19.18", "content_sanskrit": "ये शास्त्रविधिमुत्सृज्य यजन्ते श्रद्धयान्विताः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900003470, "chapter_id": 8285, "verse_number": "19.19", "content_sanskrit": "संन्यासस्य महाबाहो तत्त्वमिच्छामि वेदितुम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]