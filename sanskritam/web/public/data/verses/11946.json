[{"id": 50024927, "chapter_id": 11946, "verse_number": "1", "content_sanskrit": "प्रसिद्धं च व्याकरणनिरुक्तादीनां सिद्धमात्रे प्रामाण्यं सर्ववादिनाम्। तदनङ्गीकारे च सर्वशाब्दव्यवहारासिद्धिः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024928, "chapter_id": 11946, "verse_number": "2", "content_sanskrit": "॥ एवं सिद्धरूपे विष्णौ सम्भावितस्य वेदस्य तात्पर्यस्य वचनेन दृढीकरणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024929, "chapter_id": 11946, "verse_number": "3", "content_sanskrit": "उक्तं च नारदीये- “सर्वज्ञं सर्वकर्तारं नारायणमनामयम्। सर्वोत्तमं ज्ञापयन्ति महातात्पर्यमत्र हि। सर्वेषामपि वेदानामितिहासपुराणयोः। प्रमाणानां च सर्वेषां तदर्थं चान्यदुच्यते॥” इति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024930, "chapter_id": 11946, "verse_number": "4", "content_sanskrit": "॥ अभेदे तात्पर्यनिरासः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024931, "chapter_id": 11946, "verse_number": "5", "content_sanskrit": "॥ अभेदवाक्यानां समबलप्रमाणविरुद्धत्वप्रतिपादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024932, "chapter_id": 11946, "verse_number": "6", "content_sanskrit": "नच जीवेश्वराभेद एव तात्पर्यमागमस्य। तत्र प्रमाणाभावात्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]