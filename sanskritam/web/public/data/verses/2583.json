[{"id": 2074912, "chapter_id": 2583, "verse_number": "१२-८८-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2074913, "chapter_id": 2583, "verse_number": "१२-८८-१", "content_sanskrit": "यदा राजा समर्थोऽपि कोशार्थी स्यान्महामते।\nकथं प्रवर्तेत करस्तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2074914, "chapter_id": 2583, "verse_number": "१२-८८-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2074915, "chapter_id": 2583, "verse_number": "१२-८८-२", "content_sanskrit": "यथादेशं यथाकालं यथाबुद्धि यथाबलम्।\nअनुशिष्यात्प्रजा राजा धर्मार्थी तद्धिते रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2074916, "chapter_id": 2583, "verse_number": "१२-८८-३", "content_sanskrit": "यथा तासां च मन्येत श्रेय आत्मन एव च।\nतथा धर्माणि सर्वाणि राजा राष्ट्रेषु वर्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2074917, "chapter_id": 2583, "verse_number": "१२-८८-४", "content_sanskrit": "मधुदोहं दुहेद्राष्ट्रं भ्रमरान्न प्रपातयेत्।\nवत्सापेक्षी दुहेच्चैव स्तनांश्च न विकुट्टयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2074918, "chapter_id": 2583, "verse_number": "१२-८८-५", "content_sanskrit": "जलौकावत्पिबेद्राष्ट्रं मृदुनैव नराधिपः।\nव्याघ्रीव च हरेत्पुत्रान्संदशेन्न च पीडयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2074919, "chapter_id": 2583, "verse_number": "१२-८८-६", "content_sanskrit": "यथा शल्यकवानाखुः पदं धूनयते सदा।\nअतीक्ष्णेनाभ्युपायेन तथा राष्ट्रं समापिबेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2074920, "chapter_id": 2583, "verse_number": "१२-८८-७", "content_sanskrit": "अल्पेनाल्पेन देयेन वर्धमानं प्रदापयेत्।\nततो भूयस्ततो भूयः क्रमवृद्धिं समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2074921, "chapter_id": 2583, "verse_number": "१२-८८-८", "content_sanskrit": "दमयन्निव दम्यानि शश्वद्भारं विवर्धयेत्।\nमृदुपूर्वं प्रयत्नेन पाशानभ्यवहारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2074922, "chapter_id": 2583, "verse_number": "१२-८८-९", "content_sanskrit": "सकृत्पाशावकीर्णास्ते न भविष्यन्ति दुर्दमाः।\nउचितेनैव भोक्तव्यास्ते भविष्यन्त्ययत्नतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2074923, "chapter_id": 2583, "verse_number": "१२-८८-१०", "content_sanskrit": "तस्मात्सर्वसमारम्भो दुर्लभः पुरुषं प्रति।\nयथा मुख्यान्सान्त्वयित्वा भोक्तव्या इतरे जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2074924, "chapter_id": 2583, "verse_number": "१२-८८-११", "content_sanskrit": "ततस्तान्भेदयित्वा तु परस्परविवक्षितान्।\nभुञ्जीत सान्त्वयंश्चैव यथासुखमयत्नतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2074925, "chapter_id": 2583, "verse_number": "१२-८८-१२", "content_sanskrit": "न चास्थाने न चाकाले करांस्तेभ्यो निपातयेत्।\nआनुपूर्व्येण सान्त्वेन यथाकालं यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2074926, "chapter_id": 2583, "verse_number": "१२-८८-१३", "content_sanskrit": "उपायान्प्रब्रवीम्येतान्न मे माया विवक्षिता।\nअनुपायेन दमयन्प्रकोपयति वाजिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2074927, "chapter_id": 2583, "verse_number": "१२-८८-१४", "content_sanskrit": "पानागारनिवोशाश्च वेश्याः प्रापणिकास्तथा।\nकुशीलवाः सकितवा ये चान्ये केचिदीदृशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2074928, "chapter_id": 2583, "verse_number": "१२-८८-१५", "content_sanskrit": "नियम्याः सर्व एवैते ये राष्ट्रस्योपघातकाः।\nएते राष्ट्रेऽभितिष्ठन्तो बाधन्ते भद्रिकाः प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2074929, "chapter_id": 2583, "verse_number": "१२-८८-१६", "content_sanskrit": "न केनचिद्याचितव्यः कश्चित्किंचिदनापदि।\nइति व्यवस्था भूतानां पुरस्तान्मनुना कृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2074930, "chapter_id": 2583, "verse_number": "१२-८८-१७", "content_sanskrit": "सर्वे तथाऽनुजीवेयुर्न कुर्युः कर्म चेदिह।\nसर्व एव इमे लोका न भवेयुरसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2074931, "chapter_id": 2583, "verse_number": "१२-८८-१८", "content_sanskrit": "प्रभुर्नियमने राजा य एतान्न नियच्छति।\nभुङ्क्ते स तस्य पापस्य चतुर्भागमिति श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2074932, "chapter_id": 2583, "verse_number": "१२-८८-१९", "content_sanskrit": "भोक्ता तस्य तु पापस्य सुकृतस्य यथातथा।\nनियन्तव्याः सदा राज्ञा पापा ये स्युर्नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2074933, "chapter_id": 2583, "verse_number": "१२-८८-२०", "content_sanskrit": "कृतपापस्त्वसौ राजा य एतान्न नियच्छति।\nतथा कृतस्य धर्मस्य चतुर्भागमुपाश्नुते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2074934, "chapter_id": 2583, "verse_number": "१२-८८-२१", "content_sanskrit": "स्थानान्येतानि संयम्य प्रसङ्गो भूतिनाशनः।\nकामे प्रसक्तः पुरुषः किमकार्यं विवर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2074935, "chapter_id": 2583, "verse_number": "१२-८८-२२", "content_sanskrit": "मद्यमांसपरस्वानि तथा दारधनानि च।\nआहरेद्रागवशगस्तथा शास्त्रं प्रदर्शयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2074936, "chapter_id": 2583, "verse_number": "१२-८८-२३", "content_sanskrit": "आपद्येव तु याचन्ते येषां नास्ति परिग्रहः।\nदातव्यं धर्मतस्तेभ्यस्त्वनुक्रोशाद्भयान्न तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2074937, "chapter_id": 2583, "verse_number": "१२-८८-२४", "content_sanskrit": "मा ते राष्ट्रे याचनका भवेयुर्मा च दस्यवः।\nउपादातार एवैते नैते भूतस्य भावकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2074938, "chapter_id": 2583, "verse_number": "१२-८८-२५", "content_sanskrit": "ये भूतान्यनुगृह्णन्ति वर्धयन्ति च ये प्रजाः।\nतेते राष्ट्रेषु वर्तन्तां मा भूतानां प्रबाधकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2074939, "chapter_id": 2583, "verse_number": "१२-८८-२६", "content_sanskrit": "दण्ड्यास्ते च महाराज धनादानप्रयोजकाः।\nप्रयोगं कारयेथास्ते यथा दद्युः करांस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2074940, "chapter_id": 2583, "verse_number": "१२-८८-२७", "content_sanskrit": "कृषिगोरक्ष्यवाणिज्यं यच्चान्यत्किंचिदीदृशम्।\nपुरुषैः कारयेत्कर्म बहुभिः कर्मभेदतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2074941, "chapter_id": 2583, "verse_number": "१२-८८-२८", "content_sanskrit": "नरश्चेत्कृषिगोरक्ष्यं वाणिज्यं चाप्यनुष्ठितः।\nसंशयं लभते किंचित्तेन राजा विगर्ह्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2074942, "chapter_id": 2583, "verse_number": "१२-८८-२९", "content_sanskrit": "धनिनः पूजयेन्नित्यं पानाच्छादनभोजनैः।\nवक्तव्याश्चानुगृह्णीध्वं प्रजाः सह मयेति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2074943, "chapter_id": 2583, "verse_number": "१२-८८-३०", "content_sanskrit": "अङ्गमेतन्महद्राज्ये धनिनो नाम भारत।\nककुदं सर्वभूतानां धनस्थो नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2074944, "chapter_id": 2583, "verse_number": "१२-८८-३१", "content_sanskrit": "प्राज्ञः शूरो धनस्थश्च स्वामी धार्मिक एव च।\nतपस्वी सत्यवादी च बुद्धिमांश्चापि रक्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2074945, "chapter_id": 2583, "verse_number": "१२-८८-३२", "content_sanskrit": "तस्मात्सर्वेषु भूतेषु प्रीतिमान्भव पार्थिव।\nसत्यमार्जवमक्रोधमानृशंस्यं च पालय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2074946, "chapter_id": 2583, "verse_number": "१२-८८-३३", "content_sanskrit": "एवं दण्डं च कोशं च मित्रं भूमिं च लप्स्यसि।\nसत्यार्जवपरो राजन्मित्रकोशबलान्वितः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2074947, "chapter_id": 2583, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि अष्टाशीतितमोऽध्यायः॥ ८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]