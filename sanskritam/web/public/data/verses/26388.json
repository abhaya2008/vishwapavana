[{"id": 7006388000, "chapter_id": 26388, "verse_number": "२-४५-१", "content_sanskrit": "वैशम्पायन उवाच\nतौ तु स्वल्पेन कालेन दमघोषेण संगतौ ।\nअथाध्वविधिना तौ तु पञ्चरात्रोषितौ पथि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006388001, "chapter_id": 26388, "verse_number": "२-४५-२", "content_sanskrit": "दमघोषेण संगम्य एकरात्रोषिताविव ।\nजग्मतुः सहितौ वीरौ मुदा परमया युतौ ।\nनगरीं मथुरां प्राप्तौ वसुदेवसुतावुभौ ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006388002, "chapter_id": 26388, "verse_number": "२-४५-३", "content_sanskrit": "ततः प्रत्युद्गताः सर्वे यादवा यदुनन्दनौ ।\nसबला हृष्टमनस उग्रसेनपुरोगमाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006388003, "chapter_id": 26388, "verse_number": "२-४५-४", "content_sanskrit": "श्रेण्यः प्रकृतयश्चैव मन्त्रिणश्च यथोचिताः ।\nसबालवृद्धा सा चैव पुरी समभिवर्तत ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006388004, "chapter_id": 26388, "verse_number": "२-४५-५", "content_sanskrit": "नन्दितूर्याण्यवाद्यन्त स्तूयेतां पुरुषर्षभौ ।\nरथ्यां पताकामालिन्यो भासन्ति स्म समन्ततः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006388005, "chapter_id": 26388, "verse_number": "२-४५-६", "content_sanskrit": "हृष्टा प्रमुदिता सर्वा पुरी परमशोभिता ।\nभ्रात्रोस्तयोरागमने यथैवेन्द्रमहे तथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006388006, "chapter_id": 26388, "verse_number": "२-४५-७", "content_sanskrit": "मुदितास्तत्र गायन्ति राजमार्गेषु गायकाः ।\nस्तवाशीर्बहुला गाथा यादवानां प्रियंकराः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006388007, "chapter_id": 26388, "verse_number": "२-४५-८", "content_sanskrit": "गोविन्दरामौ सम्प्राप्तौ भ्रातरौ लोकविश्रुतौ ।\nस्वे पुरे निर्भयाः सर्वे क्रीडध्वं यादवाः सुखम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006388008, "chapter_id": 26388, "verse_number": "२-४५-९", "content_sanskrit": "न तत्र कश्चिद् दीनो वा मलिनो वा विचेतनः ।\nमथुरायामभूत् कश्चिद् रामकृष्णसमागमे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006388009, "chapter_id": 26388, "verse_number": "२-४५-१०", "content_sanskrit": "वयांसि साधुवाक्यानि प्रहृष्टा गोहयद्विपाः ।\nनरनारीगणाश्चैव भेजिरे मानसं सुखम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006388010, "chapter_id": 26388, "verse_number": "२-४५-११", "content_sanskrit": "शिवाश्च प्रववुर्वाता विरजस्का दिशो दश ।\nदैवतान्यपि सर्वाणि हृष्यन्त्यायतनेष्वथ ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006388011, "chapter_id": 26388, "verse_number": "२-४५-१२", "content_sanskrit": "यानि लिङ्गानि लोकस्य वृत्तानीह कृते युगे ।\nतानि सर्वाण्यदृश्यन्त तयोरागमने तदा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006388012, "chapter_id": 26388, "verse_number": "२-४५-१३", "content_sanskrit": "ततः काले शिवे पुण्ये स्यन्दनेनारिमर्दनौ ।\nहरियुक्तेन तौ वीरौ प्रविष्टौ मथुरां पुरीम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006388013, "chapter_id": 26388, "verse_number": "२-४५-१४", "content_sanskrit": "प्रविशन्तं पुरीं रम्यां गोविन्दं राममेव च ।\nअनुजग्मुर्यदुगणाः शक्रं देवगणा इव ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006388014, "chapter_id": 26388, "verse_number": "२-४५-१५", "content_sanskrit": "वसुदेवस्य भवनं पितुस्तौ यदुनन्दनौ ।\nप्रविष्टौ हृष्टवदनौ चन्द्रादित्याविवाचलम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006388015, "chapter_id": 26388, "verse_number": "२-४५-१६", "content_sanskrit": "तत्रायुधानि संन्यस्य गृहे स्वे स्वैरचारिणौ ।\nमुमुदाते यदुवरौ वसुदेवसुतावुभौ ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006388016, "chapter_id": 26388, "verse_number": "२-४५-१७", "content_sanskrit": "ततस्तु वसुदेवस्य पादौ समभिपीड्य च ।\nतत्रोग्रसेनं राजानमन्यांश्च यदुपुङ्गवान् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006388017, "chapter_id": 26388, "verse_number": "२-४५-१८", "content_sanskrit": "यथान्यायं पूजयित्वा तौ सर्वैश्चाभिनन्दितौ ।\nजग्मतुर्हृष्टमनसौ मातुरेव निवेशनम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006388018, "chapter_id": 26388, "verse_number": "२-४५-१९", "content_sanskrit": "एवं तावेकनिर्माणौ मथुरायां शुभाननौ ।\nउग्रसेनानुगौ भूत्वा कंचित्कालं मुमोदतुः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]