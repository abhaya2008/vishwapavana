[{"id": 900001117, "chapter_id": 8214, "verse_number": "3.1", "content_sanskrit": "अथ हैनं भार्गवो वैदर्भिः पप्रच्छ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900001118, "chapter_id": 8214, "verse_number": "3.2", "content_sanskrit": "तस्मै स होवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900001119, "chapter_id": 8214, "verse_number": "3.3", "content_sanskrit": "तान् वरिष्ठः प्राण उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900001120, "chapter_id": 8214, "verse_number": "3.4", "content_sanskrit": "तद् यथा मधुमक्षिका मधुकरराजानमुत्क्रामन्तं सर्वा एवोत्क्रमन्ते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900001121, "chapter_id": 8214, "verse_number": "3.5", "content_sanskrit": "अरा इव रथनाभौ प्राणे सर्वं प्रतिष्ठितम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900001122, "chapter_id": 8214, "verse_number": "3.6", "content_sanskrit": "इन्द्रस्त्वं प्राण तेजसा रुद्रोऽसि परिरक्षिता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900001123, "chapter_id": 8214, "verse_number": "3.7", "content_sanskrit": "या ते तनूर्वाचि प्रतिष्ठिता या श्रोत्रे या च चक्षुषि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}]