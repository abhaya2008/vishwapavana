[{"id": 2152296, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2152297, "chapter_id": 4309, "verse_number": "१", "content_sanskrit": "ततो धनञ्जयं दृष्ट्वा बाणगाण्डीवधारिणम् ।\nपुनरेव महानादं व्यसृजन्त महारथाः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2152298, "chapter_id": 4309, "verse_number": "२", "content_sanskrit": "पाण्डवाः सोमकाश्चैव ये चैषामनुयायिनः ।\nदध्मुश्च मुदिताः शङ्खान् वीराः सागरसम्भवान् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2152299, "chapter_id": 4309, "verse_number": "३", "content_sanskrit": "ततो भेर्यश्च पेश्यश्च क्रकचा गोविषाणिकाः ।\nसहसैवाभ्यहन्यन्त ततः शब्दो महानभूत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2152300, "chapter_id": 4309, "verse_number": "४", "content_sanskrit": "अथ देवाः सगन्धर्वाः पितरश्च जनेश्वर ।\nसिद्धचारणसङ्घाश्च समीयुस्ते दिदृक्षया\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2152301, "chapter_id": 4309, "verse_number": "५", "content_sanskrit": "ऋषयश्च महाभागाः पुरस्कृत्य शतक्रतुम् ।\nसमीयुस्तत्र सहिता द्रष्टुं तद्वैशसं महत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2152302, "chapter_id": 4309, "verse_number": "६", "content_sanskrit": "प्रबोधितः स तु तदा विष्णुना विश्वमूर्तिना ।\nअविनाशिस्वरूपं च दृष्ट्वा तत्त्वेन फल्गुनः ।\nकृष्णं चेमं जगद्रूपं ज्ञात्वा युद्धोद्यतोऽभवत् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2152303, "chapter_id": 4309, "verse_number": "७", "content_sanskrit": "ततो युधिष्ठिरो दृष्ट्वा युद्धाय सुसमुद्यते ।\nते सेने सागरप्रख्ये मुहुः प्रचलिते नृप\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2152304, "chapter_id": 4309, "verse_number": "८", "content_sanskrit": "विमुच्य कवचं वीरो निक्षिप्य च वरायुधम् ।\nअवरुह्य रथात् तूर्णं पद्भ्यामेव कृताञ्जलिः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2152305, "chapter_id": 4309, "verse_number": "९", "content_sanskrit": "पितामहमभिप्रेक्ष्य धर्मराजो युधिष्ठिरः ।\nवाग्यतः प्रययौ येन प्राङ्मुखो रिपुवाहिनीम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2152306, "chapter_id": 4309, "verse_number": "१०", "content_sanskrit": "तं प्रयान्तमभिप्रेक्ष्य कुन्तीपुत्रो धनञ्जयः ।\nअवतीर्य रथात् तूर्णं भ्रातृभिः सहितोऽन्वयात्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2152307, "chapter_id": 4309, "verse_number": "११", "content_sanskrit": "वासुदेवश्च भगवान् पृष्ठतोऽनुजगाम ह ।\nयथामुख्याश्च राजानस्तमन्वाजग्मुरुत्सुकाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2152308, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2152309, "chapter_id": 4309, "verse_number": "१२", "content_sanskrit": "किं ते व्यवसितं राजन् यदस्मानपहाय वै ।\nपद्भ्यामेव प्रयातोऽसि प्राङ्मुखो रिपुवाहिनीम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2152310, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "भीमसेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2152311, "chapter_id": 4309, "verse_number": "१३", "content_sanskrit": "क्व गमिष्यसि राजेन्द्र निक्षिप्तकवचायुधः ।\nदंसितेष्वरिसैन्येषु भ्रातॄनुत्सृज्य पार्थिव\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2152312, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "नकुलः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2152313, "chapter_id": 4309, "verse_number": "१४", "content_sanskrit": "एवं गते त्वयि ज्येष्ठे मम भ्रातरि भारत ।\nभीर्मे दुनोति हृदयं ब्रूहि गन्ता भवान् क्व नु\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2152314, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "सहदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2152315, "chapter_id": 4309, "verse_number": "१५", "content_sanskrit": "अस्मिन् रणसमूहे वै वर्तमाने महाभये ।\nयोद्धव्ये क्व नु गन्तासि शत्रूनभिमुखो नृप\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2152316, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2152317, "chapter_id": 4309, "verse_number": "१६", "content_sanskrit": "एवमाभाष्यमाणोऽपि भ्रातृभिः कुरुनन्दन ।\nनोवाच वाग्यतः किञ्चिद् गच्छत्येव युधिष्ठिरः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2152318, "chapter_id": 4309, "verse_number": "१७", "content_sanskrit": "तानुवाच महाप्राज्ञो वासुदेवो महामनाः ।\nअभिप्रायोऽस्य विज्ञातो मयेति प्रहसन्निव\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2152319, "chapter_id": 4309, "verse_number": "१८", "content_sanskrit": "एष भीष्मं तथा द्रोणं गौतमं शल्यमेव च ।\nअनुमान्य गुरून् सर्वान् योत्स्यते पार्थिवोऽरिभिः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2152320, "chapter_id": 4309, "verse_number": "१९", "content_sanskrit": "श्रूयते हि पुराकल्पे गुरूनननुमान्य यः ।\nयुध्यते स भवेद् व्यक्तमपध्यातो महत्तरैः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2152321, "chapter_id": 4309, "verse_number": "२०", "content_sanskrit": "अनुमान्य यथाशास्त्रं यस्तु युध्येन्महत्तरैः ।\nध्रुवस्तस्य जयो युद्धे भवेदिति मतिर्मम\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2152322, "chapter_id": 4309, "verse_number": "२१", "content_sanskrit": "एवं ब्रुवति कृष्णे तु धार्तराष्ट्रचमूं प्रति ।\nहाहाकारो महानासीन्निःशब्दास्त्वपरेऽभवन् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2152323, "chapter_id": 4309, "verse_number": "२२", "content_sanskrit": "दृष्ट्वा युधिष्ठिरं दूराद् धार्तराष्ट्रस्य सैनिकाः ।\nमिथः सङ्कथयाञ्चक्रुर्नेशोऽस्ति कुलपांसनः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2152324, "chapter_id": 4309, "verse_number": "२३", "content_sanskrit": "व्यक्तं भीत इवाभ्येति राजासौ भीष्ममन्तिकात् ।\nयुधिष्ठिरः ससोदर्यः शरणार्थं प्रयाचकः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2152325, "chapter_id": 4309, "verse_number": "२४", "content_sanskrit": "धनञ्जये कथं नाथे पाण्डवे च वृकोदरे ।\nनकुले सहदेवे च भीतोऽभ्येति च पाण्डवः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2152326, "chapter_id": 4309, "verse_number": "२५", "content_sanskrit": "न नूनं क्षत्रियकुले जातः सम्प्रथिते भुवि ।\nयथास्य हृदयं भीतमल्पसत्त्वस्य संयुगे\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2152327, "chapter_id": 4309, "verse_number": "२६", "content_sanskrit": "ततस्ते क्षत्रियाः सर्वे प्रशंसन्ति स्म कौरवान् ।\nहृष्टाः सुमनसो भूत्वा चेलानि दुधुवुः पृथक्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2152328, "chapter_id": 4309, "verse_number": "२७", "content_sanskrit": "व्यनिन्दन्त ततः सर्वे योधास्तत्र विशाम्पते ।\nयुधिष्ठिरं ससोदर्यं सहितं केशवेन ह\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2152329, "chapter_id": 4309, "verse_number": "२८", "content_sanskrit": "ततस्तत्कौरवं सैन्यं धिक्कृत्वा तु युधिष्ठिरम् ।\nनिःशब्दमभवत् तूर्णं पुनरेव विशाम्पते\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2152330, "chapter_id": 4309, "verse_number": "२९", "content_sanskrit": "किं नु वक्ष्यति राजाऽसौ किं भीष्मः प्रतिवक्ष्यति ।\nकिं भीमः समरश्लाघी किं नु कृष्णार्जुनाविति\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2152331, "chapter_id": 4309, "verse_number": "३०", "content_sanskrit": "विवक्षितं किमस्येति संशयः सुमहानभूत् ।\nउभयोः सेनयो राजन् युधिष्ठिरकृते तदा\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2152332, "chapter_id": 4309, "verse_number": "३१", "content_sanskrit": "स विगाह्य चमूं शत्रोः शरशक्तिसमाकुलाम् ।\nभीष्ममेवाभ्ययात् तूर्णं भ्रातृभिः परिवारितः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2152333, "chapter_id": 4309, "verse_number": "३२", "content_sanskrit": "तमुवाच ततः पादौ कराभ्यां पीड्य पाण्डवः ।\nभीष्मं शान्तनवं राजा युद्धाय समुपस्थितम् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2152334, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2152335, "chapter_id": 4309, "verse_number": "३३", "content_sanskrit": "आमन्त्रये त्वां दुर्धर्ष योत्स्ये तात त्वया सह ।\nअनुजानीहि मां तात आशिषश्च प्रयोजय\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2152336, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2152337, "chapter_id": 4309, "verse_number": "३४", "content_sanskrit": "यद्येवं नाभिगच्छेथा युधि मां पृथिवीपते ।\nशपेयं त्वां महाराज पराभावाय भारत\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2152338, "chapter_id": 4309, "verse_number": "३५", "content_sanskrit": "प्रीतोऽस्मि पुत्र युध्यस्व जयमाप्नुहि पाण्डव ।\nयत्तेऽभिलषितं चान्यत् तदवाप्नुहि संयुगे\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2152339, "chapter_id": 4309, "verse_number": "३६", "content_sanskrit": "व्रियतां च वरः पार्थ किमस्मत्तोऽभिकाङ्क्षसि ।\nएवं गते महाराज न तवास्ति पराजयः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2152340, "chapter_id": 4309, "verse_number": "३७", "content_sanskrit": "अर्थस्य पुरुषो दासो दासस्त्वर्थो न कस्यचित् ।\nइति सत्यं महाराज बद्धोऽस्म्यर्थेन कौरवैः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2152341, "chapter_id": 4309, "verse_number": "३८", "content_sanskrit": "अतस्त्वां क्लीबवद् वाक्यं ब्रवीमि कुरुनन्दन ।\nहृतोऽस्म्यर्थेन कौरव्य युद्धादन्यत् किमिच्छसि\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2152342, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2152343, "chapter_id": 4309, "verse_number": "३९", "content_sanskrit": "मन्त्रयस्व महाप्राज्ञ हितैषी मम नित्यशः ।\nयुध्यस्व कौरवस्यार्थे ममैष सततं वरः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2152344, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2152345, "chapter_id": 4309, "verse_number": "४०", "content_sanskrit": "राजन् किमत्र साह्यं ते करोमि कुरुनन्दन ।\nकामं योत्स्ये परस्यार्थे ब्रूहि यत्ते विवक्षितम् \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2152346, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2152347, "chapter_id": 4309, "verse_number": "४१", "content_sanskrit": "कथं जयेयं सङ्ग्रामे भवन्तमपराजितम् ।\nएतन्मे मन्त्रय हितं यदि श्रेयः प्रपश्यसि\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2152348, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2152349, "chapter_id": 4309, "verse_number": "४२", "content_sanskrit": "न तं पश्यामि कौन्तेय यो मां युध्यन्तमाहवे ।\nविजयेत पुमान् कश्चिदपि साक्षाच्छतक्रतुः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2152350, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2152351, "chapter_id": 4309, "verse_number": "४३", "content_sanskrit": "हन्त पृच्छामि तस्मात्त्वां पितामह नमोऽस्तु ते ।\nजयोपायं ब्रवीहि त्वमात्मनः समरे परैः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2152352, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2152353, "chapter_id": 4309, "verse_number": "४४", "content_sanskrit": "न शत्रुं तात पश्यामि समरे यो जयेत माम् ।\nन तावन्मृत्युकालो मे पुनरागमनं कुरु\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2152354, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2152355, "chapter_id": 4309, "verse_number": "४५", "content_sanskrit": "ततो युधिष्ठिरो वाक्यं भीष्मस्य कुरुनन्दन ।\nशिरसा प्रतिजग्राह भूयस्तमभिवाद्य च\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2152356, "chapter_id": 4309, "verse_number": "४६", "content_sanskrit": "प्रायात् पुनर्महाबाहुराचार्यस्य रथं प्रति ।\nपश्यतां सर्वसैन्यानां मध्येन भ्रातृभिः सह\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2152357, "chapter_id": 4309, "verse_number": "४७", "content_sanskrit": "स द्रोणमभिवाद्याथ कृत्वा चैव प्रदक्षिणम् ।\nउवाच वाचा दुर्धर्षमात्मनिश्रेयसं वचः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2152358, "chapter_id": 4309, "verse_number": "४८", "content_sanskrit": "आमन्त्रये त्वां भगवन् योत्स्ये विगतकल्मषः ।\nजयेयं च रिपून् सर्वाननुज्ञातस्त्वया द्विज\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2152359, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "द्रोणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2152360, "chapter_id": 4309, "verse_number": "४९", "content_sanskrit": "यदि मां नाभिगच्छेथा युद्धाय कृतनिश्चयः ।\nशपेयं त्वां महाराज पराभावाय सर्वशः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2152361, "chapter_id": 4309, "verse_number": "५०", "content_sanskrit": "तद् युधिष्ठिर तुष्टोऽस्मि पूजितश्च त्वयानघ ।\nअनुजानामि युध्यस्व विजयं समवाप्नुहि\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2152362, "chapter_id": 4309, "verse_number": "५१", "content_sanskrit": "करवाणि च ते कामं ब्रूहि यत्तेऽभिकाङ्क्षितम् ।\nएवं गते महाराज युद्धादन्यत् किमिच्छसि\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2152363, "chapter_id": 4309, "verse_number": "५२", "content_sanskrit": "अर्थस्य पुरुषो दासो दासस्त्वर्थो न कस्यचित् ।\nइति सत्यं महाराज बद्धोऽस्म्यर्थेन कौरवैः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2152364, "chapter_id": 4309, "verse_number": "५३", "content_sanskrit": "अतस्त्वां क्लीबवद् ब्रूमो युद्धादन्यत् किमिच्छसि ।\nयोत्स्यामि कौरवस्यार्थे तवाशास्यो जयो मया\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2152365, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "युधिष्ठिर उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2152366, "chapter_id": 4309, "verse_number": "५४", "content_sanskrit": "जयमाशास्स्व मे ब्रह्मन्मन्त्रयस्व च मद्धितम् ।\nयुध्यस्व कौरवस्यार्थे वर एष वृतो मया\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2152367, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "द्रोणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2152368, "chapter_id": 4309, "verse_number": "५५", "content_sanskrit": "ध्रुवस्ते विजयो राजन् यस्य मन्त्री हरिस्तव ।\nअहं च त्वाभिजानामि रणे शत्रून् विजेष्यसि\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2152369, "chapter_id": 4309, "verse_number": "५६", "content_sanskrit": "यतो धर्मस्ततः कृष्णो यतः कृष्णस्ततो जयः ।\nयुध्यस्व गच्छ कौन्तेय पृच्छ मां किं ब्रवीमि ते\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2152370, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2152371, "chapter_id": 4309, "verse_number": "५७", "content_sanskrit": "पृच्छामि त्वां द्विजश्रेष्ठ शृणु मे यद्विवक्षितम् ।\nकथं जयेयं सङ्ग्रामे भवन्तमपराजितम् \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2152372, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "द्रोणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2152373, "chapter_id": 4309, "verse_number": "५८", "content_sanskrit": "न तेऽस्ति विजयस्तावद् यावद् युध्याम्यहं रणे ।\nममाशु निधने राजन् यतस्व सह सोदरैः \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2152374, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2152375, "chapter_id": 4309, "verse_number": "५९", "content_sanskrit": "हन्त तस्मान्महाबाहो वधोपायं वदात्मनः ।\nआचार्य प्रणिपत्यैष पृच्छामि त्वां नमोऽस्तु ते\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2152376, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "द्रोणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2152377, "chapter_id": 4309, "verse_number": "६०", "content_sanskrit": "न शत्रुं तात पश्यामि यो मां हन्याद्रणे स्थितम् ।\nयुध्यमानं सुसंरब्धं शरवर्षौघवर्षिणम् \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2152378, "chapter_id": 4309, "verse_number": "६१", "content_sanskrit": "ऋते प्रायगतं राजन्न्यस्तशस्त्रमचेतनम् ।\nहन्यान्मां युधि योधानां सत्यमेतद् ब्रवीमि ते\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2152379, "chapter_id": 4309, "verse_number": "६२", "content_sanskrit": "शस्त्रं चाहं रणे जह्यां श्रुत्वा सुमहदप्रियम् ।\nश्रद्धेयं वाक्यात् परुषादेतत्सत्यं ब्रवीमि ते\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2152380, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2152381, "chapter_id": 4309, "verse_number": "६३", "content_sanskrit": "एतच्छ्रुत्वा महाराज भारद्वाजस्य धीमतः ।\nअनुमान्य तमाचार्यं प्रायाच्छारद्वतं प्रति\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2152382, "chapter_id": 4309, "verse_number": "६४", "content_sanskrit": "सोऽभिवाद्य कृपं राजा कृत्वा चापि प्रदक्षिणम् ।\nउवाच दुर्धर्षतमं वाक्यं वाक्यविशारदः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2152383, "chapter_id": 4309, "verse_number": "६५", "content_sanskrit": "अनुमानये त्वां योत्स्यामि गुरो विगतकल्मषः ।\nजयेयं च रिपून् सर्वाननुज्ञातस्त्वयानघ\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2152384, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "कृपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2152385, "chapter_id": 4309, "verse_number": "६६", "content_sanskrit": "यदि मां नाभिगच्छेथा युद्धाय कृतनिश्चयः ।\nशपेयं त्वां महाराज पराभावाय सर्वशः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2152386, "chapter_id": 4309, "verse_number": "६७", "content_sanskrit": "अर्थस्य पुरुषो दासो दासस्त्वर्थो न कस्य चित् ।\nइति सत्यं महाराज बद्धोऽस्म्यर्थेन कौरवैः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2152387, "chapter_id": 4309, "verse_number": "६८", "content_sanskrit": "तेषामर्थे महाराज योद्धव्यमिति मे मतिः ।\nअतस्त्वां क्लीबवद् ब्रूमि युद्धादन्यत् किमिच्छसि\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2152388, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2152389, "chapter_id": 4309, "verse_number": "६९", "content_sanskrit": "हन्त पृच्छामि ते तस्मादाचार्य शृणु मे वचः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2152390, "chapter_id": 4309, "verse_number": "७०", "content_sanskrit": "इत्युक्त्वा व्यथितो राजा नोवाच गतचेतनः ।\nतं गौतमः प्रत्युवाच विज्ञायास्य विवक्षितम् ।\nअवध्योऽहं महीपाल युध्यस्व जयमाप्नुहि\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2152391, "chapter_id": 4309, "verse_number": "७१", "content_sanskrit": "प्रीतस्त्वभिगमेनाहं जयं तव नराधिप ।\nआशासिष्ये सदोत्थाय सत्यमेतद् ब्रवीमि ते\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2152392, "chapter_id": 4309, "verse_number": "७२", "content_sanskrit": "एतच्छ्रुत्वा महाराज गौतमस्य वचस्तदा ।\nअनुमान्य कृपं राजा प्रययौ येन मद्रराट्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2152393, "chapter_id": 4309, "verse_number": "७३", "content_sanskrit": "स शल्यमभिवाद्याथ कृत्वा चाभिप्रदक्षिणम् ।\nउवाच राजा दुर्धर्षमात्मनिश्रेयसं वचः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2152394, "chapter_id": 4309, "verse_number": "७४", "content_sanskrit": "अनुमानये त्वां योत्स्यामि गुरो विगतकल्मषः ।\nजयेयं च महाराज अनुज्ञातस्त्वया रिपून् \t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2152395, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2152396, "chapter_id": 4309, "verse_number": "७५", "content_sanskrit": "यदि मां नाभिगच्छेथा युद्धाय कृतनिश्चयः ।\nशपेयं त्वां महाराज पराभावाय वै रणे\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2152397, "chapter_id": 4309, "verse_number": "७६", "content_sanskrit": "तुष्टोऽस्मि पूजितश्चास्मि यत्काङ्क्षसि तदस्तु ते ।\nअनुजानामि चैव त्वां युध्यस्व जयमाप्नुहि\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2152398, "chapter_id": 4309, "verse_number": "७७", "content_sanskrit": "ब्रूहि चैव परं वीर केनार्थः किं ददामि ते ।\nएवं गते महाराज युद्धादन्यत्किमिच्छसि\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2152399, "chapter_id": 4309, "verse_number": "७८", "content_sanskrit": "अर्थस्य पुरुषो दासो दासस्त्वर्थो न कस्य चित् ।\nइति सत्यं महाराज बद्धोऽस्म्यर्थेन कौरवैः\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2152400, "chapter_id": 4309, "verse_number": "७९", "content_sanskrit": "करिष्यामि हि ते कामं भागिनेय यथेप्सितम् ।\nब्रवीम्यतः क्लीबवत्त्वां युद्धादन्यत्किमिच्छसि\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2152401, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2152402, "chapter_id": 4309, "verse_number": "८०", "content_sanskrit": "मन्त्रयस्व महाराज नित्यं मद्धितमुत्तमम् ।\nकामं युध्य परस्यार्थे वरमेतद् वृणोम्यहम् \t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2152403, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2152404, "chapter_id": 4309, "verse_number": "८१", "content_sanskrit": "ब्रूहि किमत्र साह्यं ते करोमि नृपसत्तम ।\nकामं योत्स्ये परस्यार्थे वृतोऽस्म्यर्थेन कौरवैः\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2152405, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2152406, "chapter_id": 4309, "verse_number": "८२", "content_sanskrit": "स एव मे वरः सत्य उद्योगे यस्त्वया कृतः ।\nसूतपुत्रस्य सङ्ग्रामे कार्यस्तेजोवधस्त्वया\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2152407, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2152408, "chapter_id": 4309, "verse_number": "८३", "content_sanskrit": "सम्पत्स्यत्येष ते कामः कुन्तीपुत्र यथेप्सितः ।\nगच्छ युध्यस्व विस्रब्धं प्रतिजाने जयं तव\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2152409, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2152410, "chapter_id": 4309, "verse_number": "८४", "content_sanskrit": "अनुमान्याथ कौन्तेयो मातुलं मद्रकेश्वरम् ।\nनिर्जगाम महासैन्याद् भ्रातृभिः परिवारितः\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2152411, "chapter_id": 4309, "verse_number": "८५", "content_sanskrit": "वासुदेवस्तु राधेयमाहवेऽभिजगाम वै ।\nतत एनमुवाचेदं पाण्डवार्थे गदाग्रजः\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2152412, "chapter_id": 4309, "verse_number": "८६", "content_sanskrit": "श्रुतं मे कर्ण भीष्मस्य द्वेषात् किल न योत्स्यसि ।\nअस्मान्वरय राधेय यावद् भीष्मो न हन्यते\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2152413, "chapter_id": 4309, "verse_number": "८७", "content_sanskrit": "हते तु भीष्मे राधेय पुनरेष्यसि संयुगे ।\nधार्तराष्ट्रस्य साहाय्यं यदि पश्यसि चेत्समम् \t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2152414, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2152415, "chapter_id": 4309, "verse_number": "८८", "content_sanskrit": "न विप्रियं करिष्यामि धार्तराष्ट्रस्य केशव ।\nत्यक्तप्राणं हि मां विद्धि दुर्योधनहितैषिणम् \t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2152416, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2152417, "chapter_id": 4309, "verse_number": "८९", "content_sanskrit": "तच्छ्रुत्वा वचनं कृष्णः संन्यवर्तत भारत ।\nयुधिष्ठिरपुरोगैश्च पाण्डवैः सह सङ्गतः\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2152418, "chapter_id": 4309, "verse_number": "९०", "content_sanskrit": "अथ सैन्यस्य मध्ये तु प्राक्रोशत् पाण्डवाग्रजः ।\nयोऽस्मान् वृणोति तदहं वरये साह्यकारणात्\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2152419, "chapter_id": 4309, "verse_number": "९१", "content_sanskrit": "अथ तान् समभिप्रेक्ष्य युयुत्सुरिदमब्रवीत् ।\nप्रीतात्मा धर्मराजानं कुन्तीपुत्रं युधिष्ठिरम् \t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2152420, "chapter_id": 4309, "verse_number": "९२", "content_sanskrit": "अहं योत्स्यामि मिषतः संयुगे धार्तराष्ट्रजान् ।\nयुष्मदर्थे महाराज यदि मां वृणुषेऽनघ\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2152421, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2152422, "chapter_id": 4309, "verse_number": "९३", "content_sanskrit": "एह्येहि सर्वे योत्स्यामस्तव भ्रातॄनपण्डितान् ।\nयुयुत्सो वासुदेवश्च वयं च ब्रूम सर्वशः\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2152423, "chapter_id": 4309, "verse_number": "९४", "content_sanskrit": "वृणोमि त्वां महाबाहो युध्यस्व मम कारणात् ।\nत्वयि पिण्डश्च तन्तुश्च धृतराष्ट्रस्य दृश्यते\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2152424, "chapter_id": 4309, "verse_number": "९५", "content_sanskrit": "भजस्वास्मान् राजपुत्र भजमानान् महाद्युते ।\nन भविष्यति दुर्बुद्धिर्धार्तराष्ट्रोऽत्यमर्षणः\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2152425, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2152426, "chapter_id": 4309, "verse_number": "९६", "content_sanskrit": "ततो युयुत्सुः कौरव्यः परित्यज्य सुतांस्तव ।\nजगाम पाण्डुपुत्राणां सेनां विश्राव्य दुन्दुभिम् \t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2152427, "chapter_id": 4309, "verse_number": "९७", "content_sanskrit": "ततो युधिष्ठिरो राजा सम्प्रहृष्टः सहानुजैः ।\nजग्राह कवचं भूयो दीप्तिमत् कनकोज्ज्वलम् \t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2152428, "chapter_id": 4309, "verse_number": "९८", "content_sanskrit": "प्रत्यपद्यन्त ते सर्वे रथान् स्वान् पुरुषर्षभाः ।\nततो व्यूहं यथापूर्वं प्रत्यव्यूहन्त ते पुनः\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2152429, "chapter_id": 4309, "verse_number": "९९", "content_sanskrit": "अवादयन्दुन्दुभींश्च शतशश्चैव पुष्करान् ।\nसिंहनादांश्च विविधान् विनेदुः पुरुषर्षभाः\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2152430, "chapter_id": 4309, "verse_number": "१००", "content_sanskrit": "रथस्थान्पुरुषव्याघ्रान्पाण्डवान्प्रेक्ष्य पार्थिवाः ।\nधृष्टद्युम्नादयः सर्वे पुनर्जहृषिरे मुदा\t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2152431, "chapter_id": 4309, "verse_number": "१०१", "content_sanskrit": "गौरवं पाण्डुपुत्राणां मान्यान्मानयतां च तान् ।\nदृष्ट्वा महीक्षितस्तत्र पूजयाञ्चक्रिरे भृशम् \t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2152432, "chapter_id": 4309, "verse_number": "१०२", "content_sanskrit": "सौहृदं च कृपां चैव प्राप्तकालं महात्मनाम् ।\nदयां च ज्ञातिषु परां कथयाञ्चक्रिरे नृपाः\t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2152433, "chapter_id": 4309, "verse_number": "१०३", "content_sanskrit": "साधुसाध्विति सर्वत्र निश्चेरुः स्तुतिसंहिताः ।\nवाचः पुण्याः कीर्तिमतां मनोहृदयहर्षिणीः\t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2152434, "chapter_id": 4309, "verse_number": "१०४", "content_sanskrit": "म्लेच्छाश्चार्याश्च ये तत्र ददृशुः शुश्रुवुस्तदा ।\nवृत्तं तत्पाण्डुपुत्राणां रुरुदुस्ते सगद्गदाः\t॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2152435, "chapter_id": 4309, "verse_number": "१०५", "content_sanskrit": "ततो जघ्नुर्महाभेरीः शतशश्चैव पुष्करान् ।\nशङ्खांश्च गोक्षीरनिभान्दध्मुर्हृष्टा मनस्विनः\t॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 2152436, "chapter_id": 4309, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते भीष्मपर्वणि एकचत्वारिंशोऽध्यायः ॥४१॥\n॥ भीमवधपर्वणि प्रथमोऽध्यायः ॥१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}]