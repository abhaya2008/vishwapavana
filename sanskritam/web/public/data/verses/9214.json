[{"id": 5000214000, "chapter_id": 9214, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे अष्टादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000214001, "chapter_id": 9214, "verse_number": "३-१८-१", "content_sanskrit": "तां तु शूर्पणखां रामः कामपाशावपाशिताम्।\nस्वेच्छया श्लक्ष्णया वाचा स्मितपूर्वमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000214002, "chapter_id": 9214, "verse_number": "३-१८-२", "content_sanskrit": "कृतदारोऽस्मि भवति भार्येयं दयिता मम।\nत्वद्विधानां तु नारीणां सुदुःखा ससपत्नता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000214003, "chapter_id": 9214, "verse_number": "३-१८-३", "content_sanskrit": "अनुजस्त्वेष मे भ्राता शीलवान् प्रियदर्शनः।\nश्रीमानकृतदारश्च लक्ष्मणो नाम वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000214004, "chapter_id": 9214, "verse_number": "३-१८-४", "content_sanskrit": "अपूर्वी भार्यया चार्थी तरुणः प्रियदर्शनः।\nअनुरूपश्च ते भर्ता रूपस्यास्य भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000214005, "chapter_id": 9214, "verse_number": "३-१८-५", "content_sanskrit": "एनं भज विशालाक्षि भर्तारं भ्रातरं मम।\nअसपत्ना वरारोहे मेरुमर्कप्रभा यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000214006, "chapter_id": 9214, "verse_number": "३-१८-६", "content_sanskrit": "इति रामेण सा प्रोक्ता राक्षसी काममोहिता।\nविसृज्य रामं सहसा ततो लक्ष्मणमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000214007, "chapter_id": 9214, "verse_number": "३-१८-७", "content_sanskrit": "अस्य रूपस्य ते युक्ता भार्याहं वरवर्णिनी।\nमया सह सुखं सर्वान् दण्डकान् विचरिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000214008, "chapter_id": 9214, "verse_number": "३-१८-८", "content_sanskrit": "एवमुक्तस्तु सौमित्री राक्षस्या वाक्यकोविदः।\nततः शूर्पनखीं स्मित्वा लक्ष्मणो युक्तमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000214009, "chapter_id": 9214, "verse_number": "३-१८-९", "content_sanskrit": "कथं दासस्य मे दासी भार्या भवितुमिच्छसि।\nसोऽहमार्येण परवान् भ्रात्रा कमलवर्णिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000214010, "chapter_id": 9214, "verse_number": "३-१८-१०", "content_sanskrit": "समृद्धार्थस्य सिद्धार्था मुदितामलवर्णिनी।\nआर्यस्य त्वं विशालाक्षि भार्या भव यवीयसी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000214011, "chapter_id": 9214, "verse_number": "३-१८-११", "content_sanskrit": "एतां विरूपामसतीं करालां निर्णतोदरीम्।\nभार्यां वृद्धां परित्यज्य त्वामेवैष भजिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000214012, "chapter_id": 9214, "verse_number": "३-१८-१२", "content_sanskrit": "को हि रूपमिदं श्रेष्ठं संत्यज्य वरवर्णिनि।\nमानुषीषु वरारोहे कुर्याद् भावं विचक्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000214013, "chapter_id": 9214, "verse_number": "३-१८-१३", "content_sanskrit": "इति सा लक्ष्मणेनोक्ता कराला निर्णतोदरी।\nमन्यते तद्वचः सत्यं परिहासाविचक्षणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000214014, "chapter_id": 9214, "verse_number": "३-१८-१४", "content_sanskrit": "सा रामं पर्णशालायामुपविष्टं परंतपम्।\nसीतया सह दुर्धर्षमब्रवीत् काममोहिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000214015, "chapter_id": 9214, "verse_number": "३-१८-१५", "content_sanskrit": "इमां विरूपामसतीं करालां निर्णतोदरीम्।\nवृद्धां भार्यामवष्टभ्य न मां त्वं बहु मन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000214016, "chapter_id": 9214, "verse_number": "३-१८-१६", "content_sanskrit": "अद्येमां भक्षयिष्यामि पश्यतस्तव मानुषीम्।\nत्वया सह चरिष्यामि निःसपत्ना यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000214017, "chapter_id": 9214, "verse_number": "३-१८-१७", "content_sanskrit": "इत्युक्त्वा मृगशावाक्षीमलातसदृशेक्षणा।\nअभ्यगच्छत् सुसंक्रुद्धा महोल्का रोहिणीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000214018, "chapter_id": 9214, "verse_number": "३-१८-१८", "content_sanskrit": "तां मृत्युपाशप्रतिमामापतन्तीं महाबलः।\nविगृह्य रामः कुपितस्ततो लक्ष्मणमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000214019, "chapter_id": 9214, "verse_number": "३-१८-१९", "content_sanskrit": "क्रूरैरनार्यैः सौमित्रे परिहासः कथंचन।\nन कार्यः पश्य वैदेहीं कथंचित् सौम्य जीवतीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000214020, "chapter_id": 9214, "verse_number": "३-१८-२०", "content_sanskrit": "इमां विरूपामसतीमतिमत्तां महोदरीम्।\nराक्षसीं पुरुषव्याघ्र विरूपयितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000214021, "chapter_id": 9214, "verse_number": "३-१८-२१", "content_sanskrit": "इत्युक्तो लक्ष्मणस्तस्याः क्रुद्धो रामस्य पश्यतः।\nउद‍्धृत्य खड्गं चिच्छेद कर्णनासे महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000214022, "chapter_id": 9214, "verse_number": "३-१८-२२", "content_sanskrit": "निकृत्तकर्णनासा तु विस्वरं सा विनद्य च।\nयथागतं प्रदुद्राव घोरा शूर्पणखा वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000214023, "chapter_id": 9214, "verse_number": "३-१८-२३", "content_sanskrit": "सा विरूपा महाघोरा राक्षसी शोणितोक्षिता।\nननाद विविधान् नादान् यथा प्रावृषि तोयदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000214024, "chapter_id": 9214, "verse_number": "३-१८-२४", "content_sanskrit": "सा विक्षरन्ती रुधिरं बहुधा घोरदर्शना।\nप्रगृह्य बाहू गर्जन्ती प्रविवेश महावनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000214025, "chapter_id": 9214, "verse_number": "३-१८-२५", "content_sanskrit": "ततस्तु सा राक्षससङ्घसंवृतं\nखरं जनस्थानगतं विरूपिता।\nउपेत्य तं भ्रातरमुग्रतेजसं\nपपात भूमौ गगनाद् यथाशनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000214026, "chapter_id": 9214, "verse_number": "३-१८-२६", "content_sanskrit": "ततः सभार्यं भयमोहमूर्च्छिता\nसलक्ष्मणं राघवमागतं वनम्।\nविरूपणं चात्मनि शोणितोक्षिता\nशशंस सर्वं भगिनी खरस्य सा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000214027, "chapter_id": 9214, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे अष्टादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]