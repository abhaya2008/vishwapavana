": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40015036, "chapter_id": 9214, "verse_number": "8", "content_sanskrit": "एषांवानरमुख्यानांकेशूराःकेमहाबलाः । केपूर्वमभिवर्तन्तेमहोत्साहास्समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40015037, "chapter_id": 9214, "verse_number": "9", "content_sanskrit": "केषांशृणोतिसुग्रीवःकेवायूथपयूथपाः । सारणाचक्ष्वतत्त्वेनकेप्रधानाःप्लवङ्गमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40015038, "chapter_id": 9214, "verse_number": "10", "content_sanskrit": "सारणोराक्षसेन्द्रस्यवचनंपरिपृच्छतः । आचचक्षेऽथमुख्यज्ञोमुख्यांस्तांस्तुवनौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40015039, "chapter_id": 9214, "verse_number": "11", "content_sanskrit": "एषयोऽभिमुखोलङ्कांनर्दंस्तिष्ठतिवानरः । यूथपानांसहस्राणांशतेनपरिवारितः ॥ यस्यघोषेणमहतासप्राकारासतोरणा । लङ्काप्रवेपतेसर्वासशैलवनकानना ॥ सर्वशाखामृगेन्द्रस्यसुग्रीवस्यमहात्मनः । बलाग्रेतिष्ठतेवीरोनीलोनामैषयूथपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40015040, "chapter_id": 9214, "verse_number": "12", "content_sanskrit": "एषयोऽभिमुखोलङ्कांनर्दंस्तिष्ठतिवानरः । यूथपानांसहस्राणांशतेनपरिवारितः ॥ यस्यघोषेणमहतासप्राकारासतोरणा । लङ्काप्रवेपतेसर्वासशैलवनकानना ॥ सर्वशाखामृगेन्द्रस्यसुग्रीवस्यमहात्मनः । बलाग्रेतिष्ठतेवीरोनीलोनामैषयूथपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40015041, "chapter_id": 9214, "verse_number": "13", "content_sanskrit": "एषयोऽभिमुखोलङ्कांनर्दंस्तिष्ठतिवानरः । यूथपानांसहस्राणांशतेनपरिवारितः ॥ यस्यघोषेणमहतासप्राकारासतोरणा । लङ्काप्रवेपतेसर्वासशैलवनकानना ॥ सर्वशाखामृगेन्द्