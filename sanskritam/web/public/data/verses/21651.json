[{"id": 7001651000, "chapter_id": 21651, "verse_number": "१-३७-१", "content_sanskrit": "सनक उवाच ।\nभूयः श्रृणुष्व विप्रेंद्र माहात्म्यं कमलापतेः ।\nकस्य नो जायते प्रीतिः श्रोतुं हरिकथामृतम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001651001, "chapter_id": 21651, "verse_number": "१-३७-२", "content_sanskrit": "नराणां विषयान्धानां ममताकुलचेतसाम् ।\nएकमेव हरेर्नाम सर्वपापप्रणाशनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001651002, "chapter_id": 21651, "verse_number": "१-३७-३", "content_sanskrit": "सकृद्वा न नमेद्यस्तु विष्णुं पापहरं नृणाम् ।\nश्वपचं तं विजानीयात्कदाचिन्नालपेञ्च तम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001651003, "chapter_id": 21651, "verse_number": "१-३७-४", "content_sanskrit": "हरिपूजाविहीनं तु यस्य वेश्म द्विजोत्तम ।\nश्मशानसदृशं तद्धि कदाचिदपि नो विशेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001651004, "chapter_id": 21651, "verse_number": "१-३७-५", "content_sanskrit": "हरिपूजाविहीनाश्च वेदविद्वेषिणस्तथा ।\nगोद्विजद्वेषनिरता राक्षसाः परिकीर्त्तिताः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001651005, "chapter_id": 21651, "verse_number": "१-३७-६", "content_sanskrit": "यो वा को वापि विप्रेन्द्र विप्रद्वेषपरायणः ।\nसमर्चयति गोविंदं तत्पूजा विफला भवेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001651006, "chapter_id": 21651, "verse_number": "१-३७-७", "content_sanskrit": "अन्यश्रेयोविनाशार्थं येऽर्चयंति जनार्दनम् ।\nसा पूजैव महाभाग पूजकानाशु हंति वै ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001651007, "chapter_id": 21651, "verse_number": "१-३७-८", "content_sanskrit": "हरिपूजाकरो यस्तु यदि पापं समाचरेत् ।\nतमेव विष्णुद्वेष्टारं प्राहुस्तत्त्वार्त्थकोविदाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001651008, "chapter_id": 21651, "verse_number": "१-३७-९", "content_sanskrit": "ये विष्णुनिरताः संति लोकानुग्रहतत्पराः ।\nधर्मकार्यरताः शश्वद्विष्णुरुपास्तु ते मताः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001651009, "chapter_id": 21651, "verse_number": "१-३७-१०", "content_sanskrit": "कोटिजन्मार्दजितैः पुण्यैर्विष्णुभक्तिः प्रजायते ।\nदृढभक्तिमतां विष्णौ पापबुद्धिः कथं भवेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001651010, "chapter_id": 21651, "verse_number": "१-३७-११", "content_sanskrit": "जन्मकोट्यर्जितं पापं विष्णुपूजारतात्मनाम् ।\nक्षयं याति क्षणादेव तेषां स्यात्पापधीः कथम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001651011, "chapter_id": 21651, "verse_number": "१-३७-१२", "content_sanskrit": "विष्णुभक्तिविहीना ये चंडालाः परिकीर्तिताः ।\nचंडाला अपि वै श्रेष्ठा हरिभक्तिपरायणाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001651012, "chapter_id": 21651, "verse_number": "१-३७-१३", "content_sanskrit": "नराणां विषयांधानां सर्वदुःखविनाशिनी ।\nहरिसेवेति विख्याता भुक्तिमुक्तिप्रदायिनी ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001651013, "chapter_id": 21651, "verse_number": "१-३७-१४", "content_sanskrit": "संगात्स्नेहाद्भयाल्लोभादज्ञानाद्वापि यो नरः ।\nविष्णोरुपासनं कुर्यात्सोऽक्षयं सुखमश्नुते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001651014, "chapter_id": 21651, "verse_number": "१-३७-१५", "content_sanskrit": "हरिपादोदकं यस्तु कणमात्रं पिबेदपि ।\nस स्नातः सर्वतीर्थेषु विष्णोः प्रियतरो भवेत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001651015, "chapter_id": 21651, "verse_number": "१-३७-१६", "content_sanskrit": "अकालमृत्युशमनं सर्वव्याधिविनाशनम् ।\nसर्वदुःखोपशमनं हरिपोदोदक स्मृतम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001651016, "chapter_id": 21651, "verse_number": "१-३७-१७", "content_sanskrit": "नारायणं परं धाम ज्योतिषां ज्योतिरुत्तमम् ।\nये प्रपन्ना महात्मानस्तेषां मुक्तिर्हि शाश्वती ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001651017, "chapter_id": 21651, "verse_number": "१-३७-१८", "content_sanskrit": "अत्राप्युदाहरंतीममितिहासं पुरातनम् ।\nपठतां श्रृण्वतां चैव सर्वपापप्रणाशनम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001651018, "chapter_id": 21651, "verse_number": "१-३७-१९", "content_sanskrit": "आसीत्पुरा कृतयुगे गुलिको नाम लुब्धकः ।\nपरदारपरद्रव्यहरणे सततोद्यतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001651019, "chapter_id": 21651, "verse_number": "१-३७-२०", "content_sanskrit": "&nbsp;परनिंदापरो नित्यं जन्तूपद्रवकृत्तथा ।\nहतवान्ब्राह्मणान् गाश्च शतशोऽथ सहस्रशः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001651020, "chapter_id": 21651, "verse_number": "१-३७-२१", "content_sanskrit": "देवस्वहरणे नित्यं परस्वहरणे तथा ।\nउद्युक्तः सर्वदा विप्र कीनाशानामधीश्वरः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001651021, "chapter_id": 21651, "verse_number": "१-३७-२२", "content_sanskrit": "तेन पापान्यनेकानि कृतानि सुमहांति च ।\nन तेषां शक्यते वक्तुं संख्या वत्सरकोटिभिः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001651022, "chapter_id": 21651, "verse_number": "१-३७-२३", "content_sanskrit": "स कदाचिन्महापापो जंतृनामन्तकोपमः ।\nसौवीरराज्ञो नगरं सर्वैश्वर्यसमन्वितम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001651023, "chapter_id": 21651, "verse_number": "१-३७-२४", "content_sanskrit": "योषिद्धिर्भूषितार्भिश्च सरोभिनिर्मलोदकैः ।\nअलंकृतं विपणिभिर्ययो देवपुरोपमम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001651024, "chapter_id": 21651, "verse_number": "१-३७-२५", "content_sanskrit": "तस्योपवनमध्यस्थं रम्यं केशवमंदिरम् ।\nछदितं हेमकलशैर्दृष्ट्वा व्याधो मुदं ययौ ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001651025, "chapter_id": 21651, "verse_number": "१-३७-२६", "content_sanskrit": "हराम्यत्र सुवर्णानि बहूनीति विनिश्चितम् ।\nजगामाभ्यंतरं तस्य कीनाशश्चौर्यलोलुपः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001651026, "chapter_id": 21651, "verse_number": "१-३७-२७", "content_sanskrit": "तत्रापश्यद्द्विजवरं शांतं तत्त्वार्थकोविदम् ।\nपरिचर्यापरं विष्णोरुत्तंकं तपसां निधिम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001651027, "chapter_id": 21651, "verse_number": "१-३७-२८", "content_sanskrit": "एकाकिनं दयासुं च निस्पृहं ध्यानलोलुपम् ।\nचौर्यान्तरायकर्तारं तं दृष्ट्वा लुब्धको मुने ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001651028, "chapter_id": 21651, "verse_number": "१-३७-२९", "content_sanskrit": "द्रव्यजातं तु देवस्य हर्तुकामोऽतिसाहसी ।\nउत्तंकं हंतुमारेभे विधृतासिर्मदोद्धतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001651029, "chapter_id": 21651, "verse_number": "१-३७-३०", "content_sanskrit": "पादेनाक्रम्य तद्वक्षो जटाः संगृह्य पाणिना ।\nहंतुं कृतमतिं व्याधमुत्तंकः प्रेक्ष्य चाब्रवीत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001651030, "chapter_id": 21651, "verse_number": "१-३७-३१", "content_sanskrit": "उत्तंक उवाच ।\nभो भो साधो वृथा मां त्वं हनिष्यसि निरागसम् ।\nमया किमपराद्धं ते तद्वदस्व महामत्ते ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001651031, "chapter_id": 21651, "verse_number": "१-३७-३२", "content_sanskrit": "कृतापराधिनां लोके शक्ताः शिक्षां प्रकुर्वते ।\nनहि सौम्य वृथा घ्नंति सज्जना अपि पापिनः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001651032, "chapter_id": 21651, "verse_number": "१-३७-३३", "content_sanskrit": "विरोधिष्वपि मूर्खेषु निरीक्ष्यावस्थितान् गुणान् ।\nविरोधं नहि कुर्वंति सज्जनाः शांतचेतसः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001651033, "chapter_id": 21651, "verse_number": "१-३७-३४", "content_sanskrit": "बहुधा बोध्यमानोऽपि यो नरः क्षमयान्वितः ।\nतमुत्तमं नरं प्राहुर्विष्णोः प्रियतरं सदा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001651034, "chapter_id": 21651, "verse_number": "१-३७-३५", "content_sanskrit": "सुजनो न याति वैरं परहितबुद्धिर्वनाशकालेऽपि ।\nछेदेऽपि चंदनतरुः सुरभयति मुखं कुठारस्य ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001651035, "chapter_id": 21651, "verse_number": "१-३७-३६", "content_sanskrit": "अहो विधिः सुबलवान्बा धते बहुधा जनान् ।\nसर्वसंगविहीनोऽपि बाध्यते हि दुरात्मना ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001651036, "chapter_id": 21651, "verse_number": "१-३७-३७", "content_sanskrit": "अहो निष्कारणं लोके बाधंते बहुधा जनान् ।\nसर्वसंगविहीनोऽपि बाध्यते पिशुनैर्जनैः ।\nतत्रापि साधून्बाधंते न समानान्कदाचन ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001651037, "chapter_id": 21651, "verse_number": "१-३७-३८", "content_sanskrit": "मृगमीनसज्जनानां तृणजलसंतोषविहितवृत्तानाम् ।\nलुब्धकधीवरपिशुना निष्कारणवैरिणो जगति ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001651038, "chapter_id": 21651, "verse_number": "१-३७-३९", "content_sanskrit": "अहो बलवती माया मोहयत्यखिलं जगत् ।\nपुत्रमित्रकलत्रार्थं सर्वं दुःखेन योजयेत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001651039, "chapter_id": 21651, "verse_number": "१-३७-४०", "content_sanskrit": "परद्रव्यापहारेण कलत्रं पोषितं त्वया ।\nअंते तत्सर्वमुत्सृज्य एक एव प्रयति वै ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001651040, "chapter_id": 21651, "verse_number": "१-३७-४१", "content_sanskrit": "मम माता मम पिता मम भार्या ममात्मजाः ।\nममेदमिति जंतूनां ममता बाधते वृथा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001651041, "chapter_id": 21651, "verse_number": "१-३७-४२", "content_sanskrit": "यावदर्जयति द्रव्यं बांधवास्तावदेव हि ।\nधर्माधर्मौ सहैवास्तामिहामुत्र न चापरः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001651042, "chapter_id": 21651, "verse_number": "१-३७-४३", "content_sanskrit": "धर्माधर्मार्जितैर्द्रव्यैः पोषिता येन ये नराः ।\nमृतमग्निमुखे हुत्वा घृतान्नं भुंजते हि ते ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001651043, "chapter_id": 21651, "verse_number": "१-३७-४४", "content_sanskrit": "गच्छंतं परलोकं च नरं तु ह्यनुतिष्टतः ।\nधर्माधर्मौ न च धनं न पुत्रा न च बांधवाः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001651044, "chapter_id": 21651, "verse_number": "१-३७-४५", "content_sanskrit": "कामः समृद्धिमायाति नराणां पापकर्मिणाम् ।\nकामः संक्षयमायाति नराणां पुण्यकर्मणाम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001651045, "chapter_id": 21651, "verse_number": "१-३७-४६", "content_sanskrit": "वृथैव व्याकुला लोका धनादानां सदार्जने ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001651046, "chapter_id": 21651, "verse_number": "१-३७-४७", "content_sanskrit": "यद्भावि तद्भवत्येव यदभाव्यं न तद्भवेत् ।\nइति निश्चितबुद्धीनां न चिंता बाधते क्वचित् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001651047, "chapter_id": 21651, "verse_number": "१-३७-४८", "content_sanskrit": "देवाधीनमिदं सर्वं जगत्स्थावरजंगमम् ।\nतस्माज्जन्म च मृत्युं च दैवं जानाति नापरः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001651048, "chapter_id": 21651, "verse_number": "१-३७-४९", "content_sanskrit": "यत्र कुत्र स्थितस्यापि यद्भाव्यं तद्भवेद् ध्रुवम् ।\nलोकस्तु तत्र विज्ञाय वृथायासं करोति हि ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001651049, "chapter_id": 21651, "verse_number": "१-३७-५०", "content_sanskrit": "अहो दुःखं मनुष्याणां ममताकुलचेतसाम् ।\nमहापापानि कृत्वापि परान्पुष्यांति यत्नतः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001651050, "chapter_id": 21651, "verse_number": "१-३७-५१", "content_sanskrit": "अर्जितं च धनं सर्वं भुंजते बांधवाः सदा ।\nस्वयमेकतमो मूढस्तत्पापफलमश्नुते ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001651051, "chapter_id": 21651, "verse_number": "१-३७-५२", "content_sanskrit": "इति ब्रवाणं तमृषिं विमुच्य भयविह्वलः ।\nगुलिकः प्रांजलिः प्राह क्षमस्वेति पुनः पुनः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001651052, "chapter_id": 21651, "verse_number": "१-३७-५३", "content_sanskrit": "सत्संगस्य प्रभावेण हरिसन्निधिमात्रतः ।\nगतपापो लुबग्दकश्च ह्यनुतापीदमब्रवीत् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001651053, "chapter_id": 21651, "verse_number": "१-३७-५४", "content_sanskrit": "मया कृता नि पापानि महांति सुबहूनि च ।\nतानि सर्वाणि नष्टानि विप्रेंद्र तव दर्शनात् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001651054, "chapter_id": 21651, "verse_number": "१-३७-५५", "content_sanskrit": "अहोऽहं पापधीर्नित्यं महापापमुपाचरम् ।\nकथं मे निष्कृति र्भूयो यामि कं शरणं विभोः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001651055, "chapter_id": 21651, "verse_number": "१-३७-५६", "content_sanskrit": "पूर्वजन्मार्जितैः पापैर्लुब्धकत्वमवाप्तवान् ।\nअत्रापि पापजालानि कृत्वा कां गतिमाप्नुयाम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001651056, "chapter_id": 21651, "verse_number": "१-३७-५७", "content_sanskrit": "अहो ममायुः क्षयमेति शीघ्रं पापान्यनेकानि समर्ज्जितानि ।\nप्रातिक्रिया नैव कृता मयैषां गतिश्च का स्यान्ममजन्म किं वा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001651057, "chapter_id": 21651, "verse_number": "१-३७-५८", "content_sanskrit": "अहो विधिः पापशता कुलं मां किं सृष्टवान्पापतरं च शश्वत् ।\nकथं च यत्पापफलं हि भोक्ष्ये कियत्सु जन्मस्वहमुग्रकर्मा ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001651058, "chapter_id": 21651, "verse_number": "१-३७-५९", "content_sanskrit": "एवं विनिंदन्नात्मानमात्मना लुब्धकस्तदा ।\nअंतस्तापाग्निसंतप्तः सद्यः पंचत्वमागतः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001651059, "chapter_id": 21651, "verse_number": "१-३७-६०", "content_sanskrit": "उत्तंकः पतितं प्रेक्ष्य लुबग्धकं तं दयापरः ।\nविष्णुपादोदकेनैवमभ्यषिंचन्महामतिः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001651060, "chapter_id": 21651, "verse_number": "१-३७-६१", "content_sanskrit": "हरिपादोदकस्पर्शाल्लुब्धको गतकल्मषः ।\nदिव्यं विमानमारुह्य मुनिमेतदथाब्रवीत् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001651061, "chapter_id": 21651, "verse_number": "१-३७-६२", "content_sanskrit": "गुलिक उवाच ।\nउत्तंक मुनिशार्दूल गुरुस्त्वं मम सुव्रत ।\nविमुक्तस्त्वत्प्रसादेन महापातककंचुकात् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001651062, "chapter_id": 21651, "verse_number": "१-३७-६३", "content_sanskrit": "गतस्त्वदुपदेशान्मे संतापो मुनिपुंगव ।\nतथैव सर्वपापानि विनष्टान्यतिवेगतः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001651063, "chapter_id": 21651, "verse_number": "१-३७-६४", "content_sanskrit": "हरिपादोदकं यस्मान्मयि त्वं सिक्तवान्मुने ।\nप्रापितोऽस्मि त्वया तस्मात्तद्विष्णोः परमं पदम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001651064, "chapter_id": 21651, "verse_number": "१-३७-६५", "content_sanskrit": "त्वयाहं तारितो विप्र पापादस्माच्छरीरतः ।\nतस्मान्नतोऽस्मि ते विद्वन्मत्कृतं तत्क्षमस्व च ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001651065, "chapter_id": 21651, "verse_number": "१-३७-६६", "content_sanskrit": "इत्युक्त्वा देवकुसुमैर्मुनिश्रेष्टं समाकिरम् ।\nप्रदक्षिणात्रयं कृत्वा नमस्कारं चकार सः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001651066, "chapter_id": 21651, "verse_number": "१-३७-६७", "content_sanskrit": "ततो विमानमारुह्य सर्वकामसमन्वितम् ।\nअप्सरोगणसंकीर्णः प्रपेदे हरिमंदिरम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001651067, "chapter_id": 21651, "verse_number": "१-३७-६८", "content_sanskrit": "एतद्दृष्ट्वा विस्मितोऽसौ ह्युत्तंकस्तपसांनिधिः ।\nशिरस्यंजलिमाधाय तुष्टाव कमलापतिम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001651068, "chapter_id": 21651, "verse_number": "१-३७-६९", "content_sanskrit": "तेन स्तुतो महाविष्णुर्दत्तवान्वरमत्तमम् ।\nवरेण तेनोक्तंकोऽपि प्रपेदे परमं पदम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]