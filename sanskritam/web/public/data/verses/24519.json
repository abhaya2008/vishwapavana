[{"id": 7004519000, "chapter_id": 24519, "verse_number": "५-३-२१३-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nपुनरन्यत्प्रवक्ष्यामि देवस्य चरितं महत् ।\nश्रुतमात्रेण येनैव सर्वपापैः प्रमुच्यते॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004519001, "chapter_id": 24519, "verse_number": "५-३-२१३-२", "content_sanskrit": "अबालो बालरूपेण ग्रामण्यैर्बालकैः सह ।\nआमलैः क्रीडते शम्भुस्तत्ते वक्ष्यामि भारत॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004519002, "chapter_id": 24519, "verse_number": "५-३-२१३-३", "content_sanskrit": "सर्वैस्तैरामलाः क्षिप्ता ये ते देवेन पाण्डव ।\nआनीतास्तत्क्षणादेव ततः पश्चात्क्षिपेद्धरः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004519003, "chapter_id": 24519, "verse_number": "५-३-२१३-४", "content_sanskrit": "यावद्गत्वा दिशो दिग्भ्य आगच्छन्ति पृथक्पृथक् ।\nतावत्तमामलं भूतं पश्यन्ति परमेश्वरम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004519004, "chapter_id": 24519, "verse_number": "५-३-२१३-५", "content_sanskrit": "तृतीये चैव यत्कर्म देवदेवस्य धीमतः ।\nस्थानानां परमं स्थानमामलेश्वरमुत्तमम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004519005, "chapter_id": 24519, "verse_number": "५-३-२१३-६", "content_sanskrit": "तेन पूजितमात्रेण प्राप्यते परमं पदम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]