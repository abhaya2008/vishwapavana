[{"id": 2006280, "chapter_id": 1125, "verse_number": "१-१२६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2006281, "chapter_id": 1125, "verse_number": "१-१२६-१", "content_sanskrit": "अथ पारसवीं कन्यां देवकस्य महीपतेः।\nरूपयौवनसंपन्नां स सुश्रावापगासुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2006282, "chapter_id": 1125, "verse_number": "१-१२६-२", "content_sanskrit": "ततस्तु वरयित्वा तामानीय भरतर्षभः।\nविवाहं कारयामास विदुरस्य महामतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2006283, "chapter_id": 1125, "verse_number": "१-१२६-३", "content_sanskrit": "तस्यां चोत्पादयामास विदुरः कुरुनन्दन।\nपुत्रान्विनयसंपन्नानात्मनः सदृशान्गुणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2006284, "chapter_id": 1125, "verse_number": "१-१२६-४", "content_sanskrit": "ततः पुत्रशतं जज्ञे गान्धार्या जनमेजय।\nधृतराष्ट्रस्य वैश्यायामेकश्चापि शतात्परः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2006285, "chapter_id": 1125, "verse_number": "१-१२६-५", "content_sanskrit": "पाण्डोः कृन्त्यां च माद्र्यां च पुत्राः पञ्च महारथाः।\nदेवेभ्यः समपद्यन्त सन्तानाय कुलस्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2006286, "chapter_id": 1125, "verse_number": "१-१२६-६x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2006287, "chapter_id": 1125, "verse_number": "१-१२६-६", "content_sanskrit": "कथं पुत्रशतं जज्ञे गान्धार्यां द्विजसत्तम।\nकियता चैव कालेन तेषामायुश्च किं परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2006288, "chapter_id": 1125, "verse_number": "१-१२६-७", "content_sanskrit": "कथं चैकः स वैश्यायां धृतराष्ट्रसुतोऽभवत्।\nकथं च सदृशीं भार्यां गान्धारीं धर्मचारिणीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2006289, "chapter_id": 1125, "verse_number": "१-१२६-८", "content_sanskrit": "आनुकूल्ये वर्तमानां धृतराष्ट्रोऽत्यवर्तत।\nकथं च शप्तस्य सतः पाण्डोस्तेन महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2006290, "chapter_id": 1125, "verse_number": "१-१२६-९", "content_sanskrit": "समुत्पन्ना दैवतेभ्यः पुत्राः पञ्च महारथाः।\nएतद्विद्वन्यथान्यायं विस्तरेण तपोधन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2006291, "chapter_id": 1125, "verse_number": "१-१२६-१०", "content_sanskrit": "कथयस्व न मे तृप्तिः कथ्यमानेषु बन्धुषु।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2006292, "chapter_id": 1125, "verse_number": "१-१२६-१०x", "content_sanskrit": "वैशम्पायन उवाच।\nऋषिं बुभुक्षितं श्रान्तं द्वैपायनमुपस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2006293, "chapter_id": 1125, "verse_number": "१-१२६-११", "content_sanskrit": "तोषयामास गान्धारी व्यासस्तस्यै वरं ददौ।\nसा वव्रे सदृशं भर्तुः पुत्राणां शतमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2006294, "chapter_id": 1125, "verse_number": "१-१२६-१२", "content_sanskrit": "ततः कालेन सा गर्भमगृह्णाज्ज्ञानचक्षुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2006295, "chapter_id": 1125, "verse_number": "१-१२६-१३", "content_sanskrit": "गान्धार्यामाहिते गर्भे पाण्डुरम्बालिकासुतः।\nअगच्छत्परमं दुःखमपत्यार्थमरिन्दम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2006296, "chapter_id": 1125, "verse_number": "१-१२६-१४", "content_sanskrit": "गर्भिण्यामथ गान्धार्यां पाण्डुः परमदुःखितः।\nमृगाभिशापादात्मानं शोचन्नुपरतक्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2006297, "chapter_id": 1125, "verse_number": "१-१२६-१५", "content_sanskrit": "स गत्वा तपसा सिद्धिं विश्वामित्रो यथा भुवि।\nदेहान्यासे कृतमना इदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2006298, "chapter_id": 1125, "verse_number": "१-१२६-१६x", "content_sanskrit": "पाण्डुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2006299, "chapter_id": 1125, "verse_number": "१-१२६-१६", "content_sanskrit": "चतुर्भिर्ऋणवानित्थं जायते मनुजो भुवि।\nपितृदेवमनुष्याणामृषीणामथ भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2006300, "chapter_id": 1125, "verse_number": "१-१२६-१७", "content_sanskrit": "एतेभ्यस्तु यथाकालं यो न मुच्येत धर्मवित्।\nन तस्य लोकाः सन्तीति तता लोकविदो विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2006301, "chapter_id": 1125, "verse_number": "१-१२६-१८", "content_sanskrit": "यज्ञेन देवान्प्रीणाति स्वाध्यायात्तपसा ऋषीन्।\nपुत्रैः श्राद्धैरपि पितॄनानृशंस्येन मानवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2006302, "chapter_id": 1125, "verse_number": "१-१२६-१९", "content_sanskrit": "ऋषिदेवमनुष्याणामृणान्मुक्तोऽस्मि धर्मतः।\nपितॄणां तु न मुक्तोऽस्मि तच्च तेभ्यो विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2006303, "chapter_id": 1125, "verse_number": "१-१२६-२०", "content_sanskrit": "देहनाशे भवेन्नाशः पितॄणामेष निश्चयः।\nइतरेषां त्रयाणां तु नाशे ह्यात्मा विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2006304, "chapter_id": 1125, "verse_number": "१-१२६-२१", "content_sanskrit": "इह तस्मात्प्रजालाभे प्रयतन्ते द्विजोत्तमाः।\nयथैवाहं पितुः क्षेत्रे सृष्टस्तेन महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2006305, "chapter_id": 1125, "verse_number": "१-१२६-२२", "content_sanskrit": "तथैवास्मिन्मम क्षेत्रे कथं सृज्येत वै प्रजा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2006306, "chapter_id": 1125, "verse_number": "१-१२६-२२x", "content_sanskrit": "वैशम्पायन उवाच।\nस समानीय कुन्तीं च माद्रीं च भरतर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2006307, "chapter_id": 1125, "verse_number": "१-१२६-२३", "content_sanskrit": "आचष्ट पुत्रलाभस्य व्युष्टिं सर्वक्रियाधिकाम्।\nउत्तमादवराः पुंसः काङ्क्षन्तो पुत्रमापदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2006308, "chapter_id": 1125, "verse_number": "१-१२६-२४", "content_sanskrit": "अपत्यं धर्मफलदं श्रेष्ठादिच्छन्ति साधवः।\nअनुनीय तु ते सम्यङ्महाब्राह्मणसंसदि।\nब्राह्मणं गुणवन्तं हि चिन्तयामास धर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2006309, "chapter_id": 1125, "verse_number": "१-१२६-२५", "content_sanskrit": "सोऽब्रवीद्विजने कुन्तीं धर्मपत्नीं यशस्विनीम्।\nअपत्योत्पादने यत्नमापदि त्वं समर्थय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2006310, "chapter_id": 1125, "verse_number": "१-१२६-२६", "content_sanskrit": "अपत्यं नाम लोकेषु प्रतिष्ठा धर्मसंहिता।\nइति कुन्ति विदुर्धीराः शाश्वतं धर्मवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2006311, "chapter_id": 1125, "verse_number": "१-१२६-२७", "content_sanskrit": "इष्टं दत्तं तपस्तप्तं नियमश्च स्वनुष्ठितः।\nसर्वमेवानपत्यस्य न पावनमिहोच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2006312, "chapter_id": 1125, "verse_number": "१-१२६-२८", "content_sanskrit": "सोऽहमेवं विदित्वैतत्प्रपश्यामि शुचिस्मिते।\nअनपत्यः शुभाँल्लोकान्नप्राप्स्यामीति चिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2006313, "chapter_id": 1125, "verse_number": "१-१२६-२९", "content_sanskrit": "अनपत्यो हि मरणं कामये नैव जीवितम्।\nमृगाभिशापं जानासि विजने मम केवलम्।\nनृशंसकर्मणा कृत्स्नं यथा ह्युपहतं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2006314, "chapter_id": 1125, "verse_number": "१-१२६-३०", "content_sanskrit": "इमे वै बन्धुदायादाः षट् पुत्रा धर्मदर्शने।\nषडेवाबन्धुदायादाः पुत्रास्ताञ्छृणु मे पृथे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2006315, "chapter_id": 1125, "verse_number": "१-१२६-३१", "content_sanskrit": "स्वयंजातः प्रणीतश्च परिक्रीतश्च यः सुतः।\nपौनर्भवश्च कानीनः स्वैरिण्यां यश्च जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2006316, "chapter_id": 1125, "verse_number": "१-१२६-३२", "content_sanskrit": "दत्तः क्रीतः कृत्रिमश्च उपगच्छेत्स्वयं च यः।\nसहोढो ज्ञातिरेताश्च हीनयोनिधृतश्च यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2006317, "chapter_id": 1125, "verse_number": "१-१२६-३३", "content_sanskrit": "पूर्वपूर्वतमाभावं मत्त्वा लिप्सेत वै सुतम्।\nउत्तमाद्देवरात्पुंसः काङ्क्षन्ते पुत्रमापदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2006318, "chapter_id": 1125, "verse_number": "१-१२६-३४", "content_sanskrit": "अपत्यं धर्मफलदं श्रेष्ठं विन्दन्ति मानवाः।\nआत्मशुक्रादपि पृथे मनुः स्वायंभुवोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2006319, "chapter_id": 1125, "verse_number": "१-१२६-३५", "content_sanskrit": "तस्मात्प्रहेष्याम्यद्य त्वां हीनः प्रजननात्स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2006320, "chapter_id": 1125, "verse_number": "१-१२६-३६", "content_sanskrit": "सदृशाच्छ्रेयसो वा त्वं विद्ध्यपत्यं यशस्विनि।\nशृणु कुन्ति कथामेतां शारदण्डायिनीं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2006321, "chapter_id": 1125, "verse_number": "१-१२६-३७", "content_sanskrit": "या हि ते भगिनी साध्वी श्रुतसेना यशस्विनी।\nअवाह तां तु कैकेयः शारदाण्डायनिर्महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2006322, "chapter_id": 1125, "verse_number": "१-१२६-३८", "content_sanskrit": "सा वीरपत्नी गुरुणा नियुक्ता पुत्रजन्मनि।\nपुष्पेण प्रयता स्नाता निशि कुन्ति चतुष्पथे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2006323, "chapter_id": 1125, "verse_number": "१-१२६-३९", "content_sanskrit": "वरयित्वा द्विजं सिद्धं हुत्वा पुंसवनेऽनलम्।\nकर्मण्यवसिते तस्मिन्सा तेनैव सहावसत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2006324, "chapter_id": 1125, "verse_number": "१-१२६-४०", "content_sanskrit": "तत्र त्रीञ्जनयामास दुर्जयादीन्महारथान्।\nतथा त्वमपि कल्याणि ब्राह्मणात्तपसाधिकात्।\nमन्नियोगाद्यत क्षिप्रमपत्योत्पादनं प्रति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2006325, "chapter_id": 1125, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि षड्विंशत्यधिकशततमोऽध्यायः॥ १२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]