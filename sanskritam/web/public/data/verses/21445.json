[{"id": 7001445000, "chapter_id": 21445, "verse_number": "७-१-१८-१", "content_sanskrit": "ऋषय ऊचुः ।\nदेवी दक्षस्य तनया त्यक्त्वा दाक्षायणी तनुम् ।\nकथं हिमवतः पुत्री मेनायामभवत्पुरा॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001445001, "chapter_id": 21445, "verse_number": "७-१-१८-२", "content_sanskrit": "कथं च निन्दितो रुद्रो दक्षेण च महात्मना ।\nनिमित्तमपि किं तत्र येन स्यान्निंदितो भवः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001445002, "chapter_id": 21445, "verse_number": "७-१-१८-३", "content_sanskrit": "उत्पन्नश्च कथं दक्षो अभिशापाद्भवस्य तु ।\nचाक्षुषस्यांतरे पूर्वं मनोः प्रब्रूहि मारुत॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001445003, "chapter_id": 21445, "verse_number": "७-१-१८-४", "content_sanskrit": "वायुरुवाव ।\nशृण्वंतु कथयिष्यामि दक्षस्य लघुचेतसः ।\nवृत्तं पापात्प्रमादाच्च विश्वामरविदूषणम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001445004, "chapter_id": 21445, "verse_number": "७-१-१८-५", "content_sanskrit": "पुरा सुरासुराः सर्वे सिद्धाश्च परमर्षयः ।\nकदाचिद्द्रष्टुमीशानं हिमवच्छिखरं ययुः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001445005, "chapter_id": 21445, "verse_number": "७-१-१८-६", "content_sanskrit": "तदा देवश्च देवी च दिव्यासनगतावुभौ ।\nदर्शनं ददतुस्तेषां देवादीनां द्विजोत्तमाः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001445006, "chapter_id": 21445, "verse_number": "७-१-१८-७", "content_sanskrit": "तदानीमेव दक्षो ऽपि गतस्तत्र सहामरैः ।\nजामातरं हरं द्रष्टुं द्रष्टुं चात्मसुतां सतीम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001445007, "chapter_id": 21445, "verse_number": "७-१-१८-८", "content_sanskrit": "तदात्मगौरवाद्देवो देव्या दक्षे समागते ।\nदेवादिभ्यो विशेषेण न कदाचिदभूत्स्मृतिः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001445008, "chapter_id": 21445, "verse_number": "७-१-१८-९", "content_sanskrit": "तस्य तस्याः परं भावमज्ञातुश्चापि केवलम् ।\nपुत्रीत्येवं विमूढस्य तस्यां वैरमजायत॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001445009, "chapter_id": 21445, "verse_number": "७-१-१८-१०", "content_sanskrit": "ततस्तेनैव वैरेण विधिना च प्रचोदितः ।\nनाजुवाह भवं दक्षो दीक्षितस्तामपि द्विषन्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001445010, "chapter_id": 21445, "verse_number": "७-१-१८-११", "content_sanskrit": "अन्याञ्१ आमातरस्सर्वानाहूय स यथाक्रमम् ।\nशतशः पुष्कलामर्चाञ्चकार च पृथक्पृथक्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001445011, "chapter_id": 21445, "verse_number": "७-१-१८-१२", "content_sanskrit": "तथा तान्संगताञ्छ्रुत्वा नारदस्य मुखात्तदा ।\nययौ रुद्राय रुद्राणी विज्ञाप्य भवनं पितुः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001445012, "chapter_id": 21445, "verse_number": "७-१-१८-१३", "content_sanskrit": "अथ संनिहितं दिव्यं विमानं विश्वतोमुखम् ।\nलक्षणाढ्यं सुखारोहमतिमात्रमनोहरम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001445013, "chapter_id": 21445, "verse_number": "७-१-१८-१४", "content_sanskrit": "तप्तजांबूनदप्रख्यं चित्ररत्नपरिष्कृतम् ।\nमुक्तामयवितानाग्न्यं स्रग्दामसमलंकृतम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001445014, "chapter_id": 21445, "verse_number": "७-१-१८-१५", "content_sanskrit": "तप्तकंचननिर्व्यूहं रत्नस्तंभशतावृतम् ।\nवज्रकल्पितसोपानं विद्रुमस्तंभतोरणम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001445015, "chapter_id": 21445, "verse_number": "७-१-१८-१६", "content_sanskrit": "पुष्पपट्टपरिस्तीर्णं चित्ररत्नमहासनम् ।\nवज्रजालकिरच्छिद्रमच्छिद्रमणिकुट्टिमम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001445016, "chapter_id": 21445, "verse_number": "७-१-१८-१७", "content_sanskrit": "मणिदंडमनोज्ञेन महावृषभलक्ष्मणा ।\nअलंकृतपुरोभागमब्भ्रशुब्भ्रेण केतुना॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001445017, "chapter_id": 21445, "verse_number": "७-१-१८-१८", "content_sanskrit": "रत्नकंचुकगुप्तांगैश्चित्रवेत्रकपाणिभिः ।\nअधिष्ठितमहाद्वारमप्रधृष्यैर्गुणेश्वरैः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001445018, "chapter_id": 21445, "verse_number": "७-१-१८-१९", "content_sanskrit": "मृदंगतालगीतादिवेणुवीणाविशारदैः ।\nविदग्धवेषभाषैश्च बहुभिः स्त्रीजनैर्वृतम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001445019, "chapter_id": 21445, "verse_number": "७-१-१८-२०", "content_sanskrit": "आरुरोह महादेवी सह प्रियसखीजनैः ।\nचामारव्यञ्जनं तस्या वज्रदंडमनोहरे॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001445020, "chapter_id": 21445, "verse_number": "७-१-१८-२१", "content_sanskrit": "गृहीत्वा रुद्रकन्ये द्वे विवीजतुरुभे शुभे ।\nतदाचामरयोर्मध्ये देव्या वदनमाबभौ॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001445021, "chapter_id": 21445, "verse_number": "७-१-१८-२२", "content_sanskrit": "अन्योन्यं युध्यतोर्मध्ये हंसयोरिव पंकजम् ।\nछत्रं शशिनिभं तस्याश्चूडोपरि सुमालिनी॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001445022, "chapter_id": 21445, "verse_number": "७-१-१८-२३", "content_sanskrit": "धृतमुक्तापरिक्षिप्तं बभार प्रेमनिर्भरा ।\nतच्छत्रमुज्ज्वलं देव्या रुरुचे वदनोपरि॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001445023, "chapter_id": 21445, "verse_number": "७-१-१८-२४", "content_sanskrit": "उपर्यमृतभांडस्य मंडलं शशिनो यथा ।\nअथ चाग्रे समासीना सुस्मितास्या शुभावती॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001445024, "chapter_id": 21445, "verse_number": "७-१-१८-२५", "content_sanskrit": "अक्षद्यूतविनोदेन रमयामास वै सतीम् ।\nसुयशाः पादुके देव्याश्शुभे रत्नपरिष्कृते॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001445025, "chapter_id": 21445, "verse_number": "७-१-१८-२६", "content_sanskrit": "स्तनयोरंतरे कृत्वा तदा देवीमसेवतः ।\nअन्या कांचनचार्वंगी दीप्तं जग्राह दर्पणम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001445026, "chapter_id": 21445, "verse_number": "७-१-१८-२७", "content_sanskrit": "अपरा तालवृन्तं च परा तांबूलपेटिकाम् ।\nकाचित्क्रीडाशुकं चारु करे ऽकुरुत भामिनी॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001445027, "chapter_id": 21445, "verse_number": "७-१-१८-२८", "content_sanskrit": "काचित्तु सुमनोज्ञानि पुष्पाणि सुरभीणि च ।\nकाचिदाभरणाधारं बभार कमलेक्षणा॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001445028, "chapter_id": 21445, "verse_number": "७-१-१८-२९", "content_sanskrit": "काचिच्च पुनरालेपं सुप्रसूतं शुभांजनम् ।\nअन्याश्च सदृशास्तास्ता यथास्वमुचितक्रियाः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001445029, "chapter_id": 21445, "verse_number": "७-१-१८-३०", "content_sanskrit": "आवृत्त्या तां महादेवीमसेवंत समंततः ।\nअतीव शुशुभे तासामंतरे परमेश्वरी॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001445030, "chapter_id": 21445, "verse_number": "७-१-१८-३१", "content_sanskrit": "तारापरिषदो मध्ये चंद्रलेखेव शारदी ।\nततः शंखसमुत्थस्य नादस्य समनंतरम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001445031, "chapter_id": 21445, "verse_number": "७-१-१८-३२", "content_sanskrit": "प्रास्थानिको महानादः पटहः समताड्यत ।\nततो मधुरवाद्यानि सह तालोद्यतैस्स्वनैः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001445032, "chapter_id": 21445, "verse_number": "७-१-१८-३३", "content_sanskrit": "अनाहतानि सन्नेदुः काहलानां शतानि च ।\nसायुधानां गणेशानां महेशसमतेजसाम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001445033, "chapter_id": 21445, "verse_number": "७-१-१८-३४", "content_sanskrit": "सहस्राणि शतान्यष्टौ तदानीं पुरतो ययुः ।\nतेषां मध्ये वृषारूढो गजारूढो यथा गुरुः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001445034, "chapter_id": 21445, "verse_number": "७-१-१८-३५", "content_sanskrit": "जगाम गणपः श्रीमान् सोमनंदीश्वरार्चितः ।\nदेवदुंदुभयो नेदुर्दिवि दिव्यसुखा घनाः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001445035, "chapter_id": 21445, "verse_number": "७-१-१८-३६", "content_sanskrit": "ननृतुर्मुनयस्सर्वे मुमुदुः सिद्धयोगिनः ।\nससृजुः पुष्पवृष्टिं च वितानोपरि वारिदाः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001445036, "chapter_id": 21445, "verse_number": "७-१-१८-३७", "content_sanskrit": "तदा देवगणैश्चान्यैः पथि सर्वत्र संगता ।\nक्षणादिव पितुर्गेहं प्रविवेश महेश्वरी॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001445037, "chapter_id": 21445, "verse_number": "७-१-१८-३८", "content_sanskrit": "तां दृष्ट्वा कुपितो दक्षश्चात्मनः क्षयकारणात् ।\nतस्या यवीयसीभ्यो ऽपि चक्रे पूजाम सत्कृताम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001445038, "chapter_id": 21445, "verse_number": "७-१-१८-३९", "content_sanskrit": "तदा शशिमुखी देवी पितरं सदसि स्थितम् ।\nअंबिका युक्तमव्यग्रमुवाचाकृपणं वचः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001445039, "chapter_id": 21445, "verse_number": "७-१-१८-४०", "content_sanskrit": "देव्युवाच ।\nब्रह्मादयः पिशाचांता यस्याज्ञावशवर्तिनः ।\nस देवस्सांप्रतं तात विधिना नार्चितः किल॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001445040, "chapter_id": 21445, "verse_number": "७-१-१८-४१", "content_sanskrit": "तदास्तां मम ज्यायस्याः पुत्र्याः पूजां किमीदृशीम् ।\nअसत्कृतामवज्ञाय कृतवानसि गर्हितम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001445041, "chapter_id": 21445, "verse_number": "७-१-१८-४२", "content_sanskrit": "एवमुक्तो ऽब्रवीदेनां दक्षः क्रोधादमर्षितः ।\nत्वत्तः श्रेष्ठा विशिष्टाश्च पूज्या बालाः सुता मम॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001445042, "chapter_id": 21445, "verse_number": "७-१-१८-४३", "content_sanskrit": "तासां तु ये च भर्तारस्ते मे बहुमता मुदा ।\nगुनैश्चाप्यधिकास्सर्वैर्भर्तुस्ते त्र्यंबकादपि॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001445043, "chapter_id": 21445, "verse_number": "७-१-१८-४४", "content_sanskrit": "स्तब्धात्मा तामसश्शर्वस्त्वमिमं समुपाश्रिता ।\nतेन त्वामवमन्ये ऽहं प्रतिकूलो हि मे भवः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001445044, "chapter_id": 21445, "verse_number": "७-१-१८-४५", "content_sanskrit": "तथोक्ता पितरं दक्षं क्रुद्धा देवी तमब्रवीत् ।\nशृण्वतामेव सर्वेषां ये यज्ञसदसि स्थिताः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001445045, "chapter_id": 21445, "verse_number": "७-१-१८-४६", "content_sanskrit": "अकस्मान्मम भर्तारमजाताशेषदूषणम् ।\nवाचा दूषयसे दक्ष साक्षाल्लोकमहेश्वरम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001445046, "chapter_id": 21445, "verse_number": "७-१-१८-४७", "content_sanskrit": "विद्याचौरो गुरुद्रोही वेदेश्वरविदूषकः ।\nत एते बहुपाप्मानस्सर्वे दंड्या इति श्रुतिः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001445047, "chapter_id": 21445, "verse_number": "७-१-१८-४८", "content_sanskrit": "तस्मादत्युत्कटस्यास्य पापस्य सदृशो भृशम् ।\nसहसा दारुणो दंडस्तव दैवाद्भविष्यति॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001445048, "chapter_id": 21445, "verse_number": "७-१-१८-४९", "content_sanskrit": "त्वया न पूजितो यस्माद्देवदेवस्त्रियंबकः ।\nतस्मात्तव कुलं दुष्टं नष्टमित्यवधारय॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001445049, "chapter_id": 21445, "verse_number": "७-१-१८-५०", "content_sanskrit": "इत्युक्त्वा पितरं रुष्टा सती संत्यक्तसाध्वसा ।\nतदीयां च तनुं त्यक्त्वा हिमवंतं ययौ गिरिम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001445050, "chapter_id": 21445, "verse_number": "७-१-१८-५१", "content_sanskrit": "स पर्वतपरः श्रीमांल्लब्धपुण्यफलोदयः ।\nतदर्थमेव कृतवान् सुचिरं दुश्चरं तपः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001445051, "chapter_id": 21445, "verse_number": "७-१-१८-५२", "content_sanskrit": "तस्मात्तमनुगृह्णाति भूधरेश्वरमीश्वरी ।\nस्वेच्छया पितरं चक्रे स्वात्मनो योगमायया॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001445052, "chapter_id": 21445, "verse_number": "७-१-१८-५३", "content_sanskrit": "यदा गता सती दक्षं विनिंद्य भयविह्वला ।\nतदा तिरोहिता मंत्रा विहतश्च ततो ऽध्वरः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001445053, "chapter_id": 21445, "verse_number": "७-१-१८-५४", "content_sanskrit": "तदुपश्रुत्य गमनं देव्यास्त्रिपुरुमर्दनः ।\nदक्षाय च ऋषिभ्यश्च चुकोप च शशाप तान्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001445054, "chapter_id": 21445, "verse_number": "७-१-१८-५५", "content_sanskrit": "यस्मादवमता दक्षमत्कृते ऽनागसा सती ।\nपूजिताश्चेतराः सर्वाः स्वसुता भर्तृभिः सह॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001445055, "chapter_id": 21445, "verse_number": "७-१-१८-५६", "content_sanskrit": "वैवस्वते ऽंतरे तस्मात्तव जामातरस्त्वमी ।\nउत्पत्स्यंते समं सर्वे ब्रह्मयज्ञेष्वयोनिजाः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001445056, "chapter_id": 21445, "verse_number": "७-१-१८-५७", "content_sanskrit": "भविता मानुषो राजा चाक्षुषस्य त्वमन्वये ।\nप्राचीनबर्हिषः पौत्रः पुत्रश्चापि प्रचेतसः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001445057, "chapter_id": 21445, "verse_number": "७-१-१८-५८", "content_sanskrit": "अहं तत्रापि ते विघ्नमाचरिष्यामि दुर्मते ।\nधर्मार्थकामयुक्तेषु कर्मस्वपि पुनः पुनः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001445058, "chapter_id": 21445, "verse_number": "७-१-१८-५९", "content_sanskrit": "तेनैवं व्याहृतो दक्षो रुद्रेणामिततेजसा ।\nस्वायंभुवीं तनुं त्यक्त्वा पपात भुवि दुःखितः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001445059, "chapter_id": 21445, "verse_number": "७-१-१८-६०", "content_sanskrit": "ततः प्राचेतसो दक्षो जज्ञे वै चाक्षुषे ऽन्तरे ।\nप्राचीनबर्हिषः पौत्रः पुत्रश्चैव प्रचेतसाम्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001445060, "chapter_id": 21445, "verse_number": "७-१-१८-६१", "content_sanskrit": "भृग्वादयो ऽपि जाता वै मनोर्वैवस्वतस्य तु ।\nअंतरे ब्रह्मणो यज्ञे वारुणीं बिभ्रतस्तनुम्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001445061, "chapter_id": 21445, "verse_number": "७-१-१८-६२", "content_sanskrit": "तदा दक्षस्य धर्मार्थं यज्ञे तस्य दुरात्मनः ।\nमहेशः कृतवान्विघ्नं मना ववस्वते सति॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]