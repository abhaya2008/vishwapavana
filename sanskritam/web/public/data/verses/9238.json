[{"id": 40015962, "chapter_id": 9238, "verse_number": "1", "content_sanskrit": "अथोवाचमहातेजाहरिराजोमहाबलः । किमियंव्यथितासेनामूढवातेवनौर्जले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40015963, "chapter_id": 9238, "verse_number": "2", "content_sanskrit": "सुग्रीवस्यवचश्श्रुत्वावालिपुत्रोऽङ्गदोऽब्रवीत् । नत्वंपश्यसिरामंचलक्ष्मणंचमहारथम् ॥ शरजालचितौवीरावुभौदशरथात्मजौ । शरतल्पेमहात्मानौशयानौरुधिरोक्षितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40015964, "chapter_id": 9238, "verse_number": "3", "content_sanskrit": "सुग्रीवस्यवचश्श्रुत्वावालिपुत्रोऽङ्गदोऽब्रवीत् । नत्वंपश्यसिरामंचलक्ष्मणंचमहारथम् ॥ शरजालचितौवीरावुभौदशरथात्मजौ । शरतल्पेमहात्मानौशयानौरुधिरोक्षितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40015965, "chapter_id": 9238, "verse_number": "4", "content_sanskrit": "अथाब्रवीद्वानरेन्द्रस्सुग्रीवःपुत्रमङ्गदम् । नानिमित्तमिदंमन्येभवितव्यंभयेनतु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40015966, "chapter_id": 9238, "verse_number": "5", "content_sanskrit": "विषण्णवदनाह्येतेत्यक्तप्रहरणादिशः । प्रपलायन्तिहरयस्त्रासादुत्फुल्ललोचनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40015967, "chapter_id": 9238, "verse_number": "6", "content_sanskrit": "अन्योन्यस्यनलज्जन्तेनिरीक्षन्तिपृष्ठतः । विप्रकर्षन्तिचान्योन्यंपतितंलङ्घयन्तिच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40015968, "chapter_id": 9238, "verse_number": "7", "content_sanskrit": "एतस्मिन्नन्तरेवीरोगदापाणिर्विभीषणः । सुग्रीवंवर्धयामासराघवंचनिरैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40015969, "chapter_id": 9238, "verse_number": "8", "content_sanskrit": "विभीषणंचसुग्रीवोदृष्टवावानरभीषणम् । ऋक्षराजंमहात्मानंसमीपस्थमुवाचह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40015970, "chapter_id": 9238, "verse_number": "9", "content_sanskrit": "विभीषणोऽयंसम्प्राप्तोयंदृष्टवावानरर्षभाः । विद्रवन्तिपरितत्रसरावणात्मजशङ्कया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40015971, "chapter_id": 9238, "verse_number": "10", "content_sanskrit": "शीघ्रमेतान् सुसन्त्रस्तान्बहुधाविप्रधावितान् । पर्यवस्थापयाख्याहिविभीषणमुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40015972, "chapter_id": 9238, "verse_number": "11", "content_sanskrit": "सुग्रीवेणैवमुक्तस्तुजाम्बवानृक्षपार्थिवः । वानरान्सान्त्वयामाससन्निरुध्यप्रधानतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40015973, "chapter_id": 9238, "verse_number": "12", "content_sanskrit": "तेनिवृत्ताःपुनःसर्वेवानरास्त्यक्तसम्भ्रमाः । ऋक्षराजवचश्श्रुत्वातंचदृष्टवाविभीषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40015974, "chapter_id": 9238, "verse_number": "13", "content_sanskrit": "विभीषणस्तुरामस्यदृष्टवागात्रंशरैश्चितम् । लक्ष्मणस्यचधर्मात्माबभूवव्यथितस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40015975, "chapter_id": 9238, "verse_number": "14", "content_sanskrit": "जलक्लिन्नेनहस्तेनतयोर्नेत्रेप्रमृज्यच । शोकसम्पीडितमनारुरोदविललापच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40015976, "chapter_id": 9238, "verse_number": "15", "content_sanskrit": "इमौतौसत्त्वसम्पन्नौविक्रान्तौप्रियसम्युगौ । इमामवस्थांगमितौराक्षसैःकूटयोधिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40015977, "chapter_id": 9238, "verse_number": "16", "content_sanskrit": "भ्रातुःपुत्रेणमेतेनदुष्पुत्रेणदुरात्मना । राक्षस्याजिह्मयाबुध्याचालितावृजुविक्रमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40015978, "chapter_id": 9238, "verse_number": "17", "content_sanskrit": "शरैरिमावलंविद्धौरुधिरेणसमुक्षितौ । वसुधायामिमौसुप्तौदृश्येतेशल्यकाविव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40015979, "chapter_id": 9238, "verse_number": "18", "content_sanskrit": "ययोर्वीर्यमुपाश्रित्यप्रतिष्ठाकाङ्क्षितामया । तावुभौदेहनाशायप्रसुप्तौपुरुषर्षभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40015980, "chapter_id": 9238, "verse_number": "19", "content_sanskrit": "जीवन्नद्यविपन्नोऽस्मिनष्टराज्यमनोरथः । प्राप्तप्रतिज्ञश्चरिपुःसकामोरावणःकृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40015981, "chapter_id": 9238, "verse_number": "20", "content_sanskrit": "एवंविलपमानंतंपरिष्वज्यविभीषणम् । सुग्रीवःसत्त्वसम्पन्नोहरिराजोऽब्रवीदिदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40015982, "chapter_id": 9238, "verse_number": "21", "content_sanskrit": "राज्यंप्राप्स्यसिधर्मज्ञ लङ्कायांनात्रसंशयः । रावणस्सहपुत्रेणस्वकामंनेहलप्स्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40015983, "chapter_id": 9238, "verse_number": "22", "content_sanskrit": "नरुजापीडितावेतावुभौराघवलक्ष्मणौ । त्यक्त्वामोहंवधिष्येतेसगणंरावणंरणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40015984, "chapter_id": 9238, "verse_number": "23", "content_sanskrit": "तमेवंसान्त्वयित्वातुसमाश्वास्यचराक्षसम् । सुषेणंश्वशुरंपार्श्वेसुग्रीवस्तमुवाचह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40015985, "chapter_id": 9238, "verse_number": "24", "content_sanskrit": "सहशूरैर्हरिगणैर्लब्धसंज्ञावरिन्दमौ । गच्छत्वंभ्रातरंगृह्यकिष्किन्धांरामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40015986, "chapter_id": 9238, "verse_number": "25", "content_sanskrit": "अहंतुरावणंहत्वासपुत्रंसहबान्धवम् । मैथिलीमानयिष्यामिशक्रोनष्टामिवश्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40015987, "chapter_id": 9238, "verse_number": "26", "content_sanskrit": "श्रुत्वैतद्वानरेन्द्रस्यसुषेणोवाक्यमब्रवीत् । दैवासुरंमहद्युद्धमनुभूतंसुदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40015988, "chapter_id": 9238, "verse_number": "27", "content_sanskrit": "तदास्मदानवाशरसम्स्पर्शकोविदाः । निजघ्नुश्शस्त्रविदुषश्चादयन्तोमुहुर्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40015989, "chapter_id": 9238, "verse_number": "28", "content_sanskrit": "तानार्तान्नष्टसंज्ञांश्चगतासूंश्चबृहस्पतिः । विद्याभिर्मन्त्रयुक्ताभिरोषधीभिश्चिकित्सति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40015990, "chapter_id": 9238, "verse_number": "29", "content_sanskrit": "तान्यौषधान्यानयितुंक्षीरोदंयान्तुसागरम् । जवेनवानराःशीघ्रंसम्पातिपनसादयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40015991, "chapter_id": 9238, "verse_number": "30", "content_sanskrit": "हरयस्तुविजानन्तिपार्वतीस्तामहौषधीः । सञ्जीवकरणींदिव्यांविशल्यांदेवनिर्मिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40015992, "chapter_id": 9238, "verse_number": "31", "content_sanskrit": "चन्द्रश्चनामद्रोणश्चक्षीरोदेसागरोत्तमे । अमृतंयत्रमथितंतत्रतेपरमौषधी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40015993, "chapter_id": 9238, "verse_number": "32", "content_sanskrit": "तौतत्रविहितेदेवैःपर्वतौमहोदधौ । अयंवायुसुतोराजन् हनूमांस्तत्रगच्छतु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40015994, "chapter_id": 9238, "verse_number": "33", "content_sanskrit": "एतस्मिन्नन्तरेवायुर्मेगांश्चापिसविद्युतः । पर्यस्यसागरेतोयंकम्पयननिवमेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40015995, "chapter_id": 9238, "verse_number": "34", "content_sanskrit": "महतापक्षवातेनसर्ववदीपमहाद्रुमाः । निपेतुर्भग्नविटपाःसलिलेलवणाम्भसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40015996, "chapter_id": 9238, "verse_number": "35", "content_sanskrit": "अभवन् पन्नगास्त्रस्ताभोगिनस्तत्रवासिनः । शीघ्रंसर्वाणियादांसिजग्मुश्चलवणार्णवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40015997, "chapter_id": 9238, "verse_number": "36", "content_sanskrit": "ततोमुहूर्तार्गरुडंवैनतेयंमहाबलम् । वानराददृशुःसर्वेज्वलन्तमिवपावकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40015998, "chapter_id": 9238, "verse_number": "37", "content_sanskrit": "तमागतमभिप्रेक्ष्यनागास्तेसम्प्रदुद्रुवुः । यैस्तौसत्पुरुषौबद्धौशरभूतैर्महाबलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40015999, "chapter_id": 9238, "verse_number": "38", "content_sanskrit": "ततस्सुपर्णःकाकुत्स्थौस्पृष्टवाप्रत्यभिनदनितः । विममर्शचपाणिभ्यांमुखेचन्द्रसमप्रभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40016000, "chapter_id": 9238, "verse_number": "39", "content_sanskrit": "वैनतेयेनसम्स्पृष्टास्तयोःसम्रुरुहुर्व्रणाः । सुवर्णेचतनूस्निग्धेतयोराशुबभूवतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40016001, "chapter_id": 9238, "verse_number": "40", "content_sanskrit": "तेजोवीर्यंबलंचौजउत्साहश्चमहागुणाः । प्रदर्शनंचबुद्धिश्चस्मृतिश्चद्विगुणंतयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40016002, "chapter_id": 9238, "verse_number": "41", "content_sanskrit": "तावुत्थाप्यमहातेजागरुडोवासवोपमौ । उभौतौसस्वजेहृष्टोरामश्चैनमुवाचह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40016003, "chapter_id": 9238, "verse_number": "42", "content_sanskrit": "भवत्प्रसादाद् व्यसनंरावणिप्रभवंमहत् । आवामिहव्यतिक्रान्तौपूर्ववद् बलिनौकृतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40016004, "chapter_id": 9238, "verse_number": "43", "content_sanskrit": "यथातातंदशरथंयथाऽजंचपितामहम् । तथाभवन्तमासाद्यहृदयंमेप्रसीदति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40016005, "chapter_id": 9238, "verse_number": "44", "content_sanskrit": "कोभवान्रूपसम्पन्नोदिव्यस्रगनुलेपनः । वसानोविरजेवस्त्रदिव्याभरणभूषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40016006, "chapter_id": 9238, "verse_number": "45", "content_sanskrit": "तमुवाचमहातेजावैनतेयोमहाबलः । पतत्त्रिराजःप्रीतात्माहर्षपर्याकुलेक्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40016007, "chapter_id": 9238, "verse_number": "46", "content_sanskrit": "अहंसखातेकाकुत्स्थ प्रियःप्राणोबहिश्चरः । गरुत्मानिहसम्प्राप्तोयुवयोःसाह्यकारणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40016008, "chapter_id": 9238, "verse_number": "47", "content_sanskrit": "असुरावामहावीर्यावानरावामहाबलाः । सुराश्चापिसगन्ध्वर्वाःपुरस्कृत्यशतक्रतुम् ॥ नेमंमोक्षयितुंशक्ताश्शरबन्धंसुदारुणम् । मायाबलादिन्द्रजितानिर्मितंक्रूरकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 40016009, "chapter_id": 9238, "verse_number": "48", "content_sanskrit": "असुरावामहावीर्यावानरावामहाबलाः । सुराश्चापिसगन्ध्वर्वाःपुरस्कृत्यशतक्रतुम् ॥ नेमंमोक्षयितुंशक्ताश्शरबन्धंसुदारुणम् । मायाबलादिन्द्रजितानिर्मितंक्रूरकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 40016010, "chapter_id": 9238, "verse_number": "49", "content_sanskrit": "एतेनागाःकाद्रवेयास्तीक्ष्णदंष्ट्राविषोल्बणाः । रक्षोमायाप्रभावेणशराभूत्वास्त्वदाश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 40016011, "chapter_id": 9238, "verse_number": "50", "content_sanskrit": "सभाग्यश्चासिधर्मज्ञ राम सत्यपराक्रम । लक्ष्मणेनसहभ्रात्रासमरेरिपुघातिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 40016012, "chapter_id": 9238, "verse_number": "51", "content_sanskrit": "इमंश्रुत्वातुवृत्तान्तंत्वरमाणोऽहमागतः । सहसायुवयोःस्नेहात्सखित्वमनुपालयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 40016013, "chapter_id": 9238, "verse_number": "52", "content_sanskrit": "मोक्षितौचमहाघोरादस्मात्सायकबन्धनात् । अप्रमादश्चकर्तव्योयुवाभ्यांनित्यमेवच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 40016014, "chapter_id": 9238, "verse_number": "53", "content_sanskrit": "प्रकृत्याराक्षसाःसर्वेसङ्ग्रामेकूटयोधिनः । शूराणांशुद्धभावानांभवतामरार्जवंबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 40016015, "chapter_id": 9238, "verse_number": "54", "content_sanskrit": "तन्नविश्वसनीयंवोराक्षसानांरणाजिरे । एतेनैवोपमानेननित्यंजिह्माहिराक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 40016016, "chapter_id": 9238, "verse_number": "55", "content_sanskrit": "एवमुक्त्वातदारामंसुपर्णस्सुमहाबलः । परिष्वज्यचसुहृत्स्निग्धमाप्रष्टुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 40016017, "chapter_id": 9238, "verse_number": "56", "content_sanskrit": "सखे राघव धर्मज्ञ रिपूणामपिवत्सल । अभ्यनुज्ञातुमिच्छामिगमिष्यामियथामतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 40016018, "chapter_id": 9238, "verse_number": "57", "content_sanskrit": "नचकौतूहलंकार्यंसखित्वंप्रतिराघव । कृतकर्मारणेवीर सखित्वंप्रतिवेत्स्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 40016019, "chapter_id": 9238, "verse_number": "58", "content_sanskrit": "बालवृद्धावशेषांतुकृत्वालङ्कांशरोर्मिभिः । रावणंचरिपुंहत्वासीतांत्वंसमुलप्स्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 40016020, "chapter_id": 9238, "verse_number": "59", "content_sanskrit": "इत्येवमुक्त्वावचनंसुपर्णश्शीघ्रविक्रमः । रामंचविरुजंकृत्वामध्येतेषांवनौकसाम् ॥ प्रदक्षिणंततःकृत्वापरिष्वज्यचवीर्यवान् । जगामाकाशमाविश्यसुपर्णःपवनोयथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 40016021, "chapter_id": 9238, "verse_number": "60", "content_sanskrit": "इत्येवमुक्त्वावचनंसुपर्णश्शीघ्रविक्रमः । रामंचविरुजंकृत्वामध्येतेषांवनौकसाम् ॥ प्रदक्षिणंततःकृत्वापरिष्वज्यचवीर्यवान् । जगामाकाशमाविश्यसुपर्णःपवनोयथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 40016022, "chapter_id": 9238, "verse_number": "61", "content_sanskrit": "विरुजौराघवौदृष्टवाततोवानरयूथपाः । सिंहनादांस्तदानेदुर्लङ्गूलंन्दुधुवुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 40016023, "chapter_id": 9238, "verse_number": "62", "content_sanskrit": "ततोभेरीस्समाजघ्नुर्मृदङ्गांश्चाप्यनादयन् । दध्मुश्शङ्खान्सम्प्रहृष्टाःक्षेवलन्त्यपियथापुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 40016024, "chapter_id": 9238, "verse_number": "63", "content_sanskrit": "आस्फोट्याःस्पोट्यविक्रान्ताःवानराःनगयोधिनः । द्रुमानुत्पट्यविविधांस्तस्थुश्शतसहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 40016025, "chapter_id": 9238, "verse_number": "64", "content_sanskrit": "विसृजन्तोमहानादांस्त्रासयन्तोनिशाचरान् । लङ्काद्वाराण्युपाजग्मुर्युद्धकामाःप्लवङ्गमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 40016026, "chapter_id": 9238, "verse_number": "65", "content_sanskrit": "तेषांसुखीमस्तुमुलोनिनादोबभूवशाखामृगयूथपानाम् । क्षयेनिदाघस्ययथाघनानांनादस्सुभीमोनदतांनिशीथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]