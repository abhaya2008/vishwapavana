[{"id": 5000238000, "chapter_id": 9238, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे द्विचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000238001, "chapter_id": 9238, "verse_number": "३-४२-१", "content_sanskrit": "एवमुक्त्वा तु परुषं मारीचो रावणं ततः।\nगच्छावेत्यब्रवीद् दीनो भयाद् रात्रिंचरप्रभोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000238002, "chapter_id": 9238, "verse_number": "३-४२-२", "content_sanskrit": "दृष्टश्चाहं पुनस्तेन शरचापासिधारिणा।\nमद्वधोद्यतशस्त्रेण निहतं जीवितं च मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000238003, "chapter_id": 9238, "verse_number": "३-४२-३", "content_sanskrit": "नहि रामं पराक्रम्य जीवन् प्रतिनिवर्तते।\nवर्तते प्रतिरूपोऽसौ यमदण्डहतस्य ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000238004, "chapter_id": 9238, "verse_number": "३-४२-४", "content_sanskrit": "किं नु कर्तुं मया शक्यमेवं त्वयि दुरात्मनि।\nएष गच्छाम्यहं तात स्वस्ति तेऽस्तु निशाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000238005, "chapter_id": 9238, "verse_number": "३-४२-५", "content_sanskrit": "प्रहृष्टस्त्वभवत् तेन वचनेन स राक्षसः।\nपरिष्वज्य सुसंश्लिष्टमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000238006, "chapter_id": 9238, "verse_number": "३-४२-६", "content_sanskrit": "एतच्छौटीर्ययुक्तं ते मच्छन्दवशवर्तिनः।\nइदानीमसि मारीचः पूर्वमन्यो हि राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000238007, "chapter_id": 9238, "verse_number": "३-४२-७", "content_sanskrit": "आरुह्यतामयं शीघ्रं खगो रत्नविभूषितः।\nमया सह रथो युक्तः पिशाचवदनैः खरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000238008, "chapter_id": 9238, "verse_number": "३-४२-८", "content_sanskrit": "प्रलोभयित्वा वैदेहीं यथेष्टं गन्तुमर्हसि।\nतां शून्ये प्रसभं सीतामानयिष्यामि मैथिलीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000238009, "chapter_id": 9238, "verse_number": "३-४२-९", "content_sanskrit": "ततस्तथेत्युवाचैनं रावणं ताटकासुतः।\nततो रावणमारीचौ विमानमिव तं रथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000238010, "chapter_id": 9238, "verse_number": "३-४२-१०", "content_sanskrit": "आरुह्याययतुः शीघ्रं तस्मादाश्रममण्डलात्।\nतथैव तत्र पश्यन्तौ पत्तनानि वनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000238011, "chapter_id": 9238, "verse_number": "३-४२-११", "content_sanskrit": "गिरींश्च सरितः सर्वा राष्ट्राणि नगराणि च।\nसमेत्य दण्डकारण्यं राघवस्याश्रमं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000238012, "chapter_id": 9238, "verse_number": "३-४२-१२", "content_sanskrit": "ददर्श सहमारीचो रावणो राक्षसाधिपः।\nअवतीर्य रथात् तस्मात् ततः काञ्चनभूषणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000238013, "chapter_id": 9238, "verse_number": "३-४२-१३", "content_sanskrit": "हस्ते गृहीत्वा मारीचं रावणो वाक्यमब्रवीत्।\nएतद् रामाश्रमपदं दृश्यते कदलीवृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000238014, "chapter_id": 9238, "verse_number": "३-४२-१४", "content_sanskrit": "क्रियतां तत् सखे शीघ्रं यदर्थं वयमागताः।\nस रावणवचः श्रुत्वा मारीचो राक्षसस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000238015, "chapter_id": 9238, "verse_number": "३-४२-१५", "content_sanskrit": "मृगो भूत्वाऽऽश्रमद्वारि रामस्य विचचार ह।\nस तु रूपं समास्थाय महदद्भुतदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000238016, "chapter_id": 9238, "verse_number": "३-४२-१६", "content_sanskrit": "मणिप्रवरशृङ्गाग्रः सितासितमुखाकृतिः।\nरक्तपद्मोत्पलमुख इन्द्रनीलोत्पलश्रवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000238017, "chapter_id": 9238, "verse_number": "३-४२-१७", "content_sanskrit": "किंचिदभ्युन्नतग्रीव इन्द्रनीलनिभोदरः।\nमधूकनिभपार्श्वश्च कञ्जकिञ्जल्कसंनिभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000238018, "chapter_id": 9238, "verse_number": "३-४२-१८", "content_sanskrit": "वैदूर्यसंकाशखुरस्तनुजङ्घः सुसंहतः।\nइन्द्रायुधसवर्णेन पुच्छेनोर्ध्वं विराजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000238019, "chapter_id": 9238, "verse_number": "३-४२-१९", "content_sanskrit": "मनोहरस्निग्धवर्णो रत्नैर्नानाविधैर्वृतः।\nक्षणेन राक्षसो जातो मृगः परमशोभनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000238020, "chapter_id": 9238, "verse_number": "३-४२-२०", "content_sanskrit": "वनं प्रज्वलयन् रम्यं रामाश्रमपदं च तत्।\nमनोहरं दर्शनीयं रूपं कृत्वा स राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000238021, "chapter_id": 9238, "verse_number": "३-४२-२१", "content_sanskrit": "प्रलोभनार्थं वैदेह्या नानाधातुविचित्रितम्।\nविचरन् गच्छते सम्यक् शाद्वलानि समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000238022, "chapter_id": 9238, "verse_number": "३-४२-२२", "content_sanskrit": "रौप्यैर्बिन्दुशतैश्चित्रं भूत्वा च प्रियदर्शनः।\nविटपीनां किसलयान् भक्षयन् विचचार ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000238023, "chapter_id": 9238, "verse_number": "३-४२-२३", "content_sanskrit": "कदलीगृहकं गत्वा कर्णिकारानितस्ततः।\nसमाश्रयन् मन्दगतिं सीतासंदर्शनं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000238024, "chapter_id": 9238, "verse_number": "३-४२-२४", "content_sanskrit": "राजीवचित्रपृष्ठः स विरराज महामृगः।\nरामाश्रमपदाभ्याशे विचचार यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000238025, "chapter_id": 9238, "verse_number": "३-४२-२५", "content_sanskrit": "पुनर्गत्वा निवृत्तश्च विचचार मृगोत्तमः।\nगत्वा मुहूर्तं त्वरया पुनः प्रतिनिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000238026, "chapter_id": 9238, "verse_number": "३-४२-२६", "content_sanskrit": "विक्रीडंश्च क्वचिद् भूमौ पुनरेव निषीदति।\nआश्रमद्वारमागम्य मृगयूथानि गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000238027, "chapter_id": 9238, "verse_number": "३-४२-२७", "content_sanskrit": "मृगयूथैरनुगतः पुनरेव निवर्तते।\nसीतादर्शनमाकांक्षन् राक्षसो मृगतां गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000238028, "chapter_id": 9238, "verse_number": "३-४२-२८", "content_sanskrit": "परिभ्रमति चित्राणि मण्डलानि विनिष्पतन्।\nसमुद्वीक्ष्य च सर्वे तं मृगा येऽन्ये वनेचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000238029, "chapter_id": 9238, "verse_number": "३-४२-२९", "content_sanskrit": "उपगम्य समाघ्राय विद्रवन्ति दिशो दश।\nराक्षसः सोऽपि तान् वन्यान् मृगान् मृगवधे रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000238030, "chapter_id": 9238, "verse_number": "३-४२-३०", "content_sanskrit": "प्रच्छादनार्थं भावस्य न भक्षयति संस्पृशन्।\nतस्मिन् नेव ततः काले वैदेही शुभलोचना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000238031, "chapter_id": 9238, "verse_number": "३-४२-३१", "content_sanskrit": "कुसुमापचये व्यग्रा पादपानत्यवर्तत।\nकर्णिकारानशोकांश्च चूतांश्च मदिरेक्षणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000238032, "chapter_id": 9238, "verse_number": "३-४२-३२", "content_sanskrit": "कुसुमान्यपचिन्वन्ती चचार रुचिरानना।\nअनर्हा वनवासस्य सा तं रत्नमयं मृगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000238033, "chapter_id": 9238, "verse_number": "३-४२-३३", "content_sanskrit": "मुक्तामणिविचित्राङ्गं ददर्श परमाङ्गना।\nतं वै रुचिरदन्तोष्ठं रूप्यधातुतनूरुहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000238034, "chapter_id": 9238, "verse_number": "३-४२-३४", "content_sanskrit": "विस्मयोत्फुल्लनयना सस्नेहं समुदैक्षत।\nस च तां रामदयितां पश्यन् मायामयो मृगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000238035, "chapter_id": 9238, "verse_number": "३-४२-३५", "content_sanskrit": "विचचार ततस्तत्र दीपयन्निव तद् वनम्।\nअदृष्टपूर्वं दृष्ट्वा तं नानारत्नमयं मृगम्।\nविस्मयं परमं सीता जगाम जनकात्मजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000238036, "chapter_id": 9238, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्येअरण्यकाण्डे द्विचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]