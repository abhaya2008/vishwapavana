[{"id": 2209598, "chapter_id": 5481, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2209599, "chapter_id": 5481, "verse_number": "१", "content_sanskrit": "प्राग्ज्योतिषमथाभ्येत्य व्यचरत् स हयोत्तमः ।\nभगदत्तात्मजस्तत्र निर्ययौ रणकर्कशः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2209600, "chapter_id": 5481, "verse_number": "२", "content_sanskrit": "सहयं पाण्डुपुत्रं तं विषयान्तमुपागतम् ।\nयुयुधे भरतश्रेष्ठ वज्रदत्तो महीपतिः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2209601, "chapter_id": 5481, "verse_number": "३", "content_sanskrit": "सोऽभिनिर्याय नगराद् भगदत्तसुतो नृपः ।\nअश्वमायान्तमुन्मथ्य नगराभिमुखो ययौ ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2209602, "chapter_id": 5481, "verse_number": "४", "content_sanskrit": "तमालक्ष्य महाबाहुः कुरूणामृषभस्तदा ।\nगाण्डीवं विक्षिपंस्तूर्णं सहसा समुपाद्रवत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2209603, "chapter_id": 5481, "verse_number": "५", "content_sanskrit": "ततो गाण्डीवनिर्मुक्तैरिषुभिर्मोहितो नृपः ।\nहयमुत्सृज्य तं वीरः ततः पार्थमुपाद्रवत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2209604, "chapter_id": 5481, "verse_number": "६", "content_sanskrit": "पुनः प्रविश्य नगरं दंसितस्तु नृपोत्तमः ।\nआरुह्य नागप्रवरं निर्ययौ योद्धुकाङ्क्षया ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2209605, "chapter_id": 5481, "verse_number": "७", "content_sanskrit": "पाण्डुरेणातपत्रेण ध्रियमाणेन मूर्धनि ।\nदोधूयमानेन तदा चामरेण महारथः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2209606, "chapter_id": 5481, "verse_number": "८", "content_sanskrit": "ततः पार्थं समासाद्य पाण्डवानां महारथम् ।\nआहूतवान् हि कौरव्यं बाल्यान्मोहाच्च संयुगे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2209607, "chapter_id": 5481, "verse_number": "९", "content_sanskrit": "स वारणं नगप्रख्यं प्रभिन्नकरटामुखम् ।\nप्रेषयामास सङ्क्रुद्धस्ततः श्वेतहयं प्रति ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2209608, "chapter_id": 5481, "verse_number": "१०", "content_sanskrit": "विक्षरन्तं यथा मेघं परवारणवारणम् ।\nशस्त्रवत् कल्पितं सङ्खे त्रिसाहं युद्धदुर्मदम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2209609, "chapter_id": 5481, "verse_number": "११", "content_sanskrit": "प्रचोद्यमानः स गजस्तेन राज्ञा महाबलः ।\nतदाऽङ्कुशेन विबभावुत्पतिष्यन्निवाम्बरम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2209610, "chapter_id": 5481, "verse_number": "१२", "content_sanskrit": "तमापतन्तं सम्प्रेक्ष्य क्रुद्धो राजन् धनञ्जयः ।\nभूमिष्ठो वारणगतं योधयामास भारत ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2209611, "chapter_id": 5481, "verse_number": "१३", "content_sanskrit": "वज्रदत्तस्तु सङ्क्रुद्धो मुमोचाशु धनञ्जये ।\nतोमरानग्निसङ्काशान् शलभानिव वेगितान् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2209612, "chapter_id": 5481, "verse_number": "१४", "content_sanskrit": "अर्जुनस्तानसम्प्राप्तान् गाण्डीवप्रेषितैः शरैः ।\nद्विधा त्रिधा च चिच्छेद ख एव खगमैस्तदा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2209613, "chapter_id": 5481, "verse_number": "१५", "content_sanskrit": "स तान् दृष्ट्वा तदा छिन्नान् तोमरान् भगदत्तजः ।\nइषूनसक्तांस्त्वरितः प्राहिणोत् पाण्डवं प्रति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2209614, "chapter_id": 5481, "verse_number": "१६", "content_sanskrit": "ततोऽर्जुनस्तूर्णतरं रुग्मपुङ्खानजिह्मगान् ।\nप्रेषयामास सङ्क्रुद्धो भगदत्तात्मजं प्रति ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2209615, "chapter_id": 5481, "verse_number": "१७", "content_sanskrit": "स तैर्विद्धो महातेजा वज्रदत्तो महाहवे ।\nभृशं हतः पपातोर्व्यां न त्वेनमजहात् स्मृतिः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2209616, "chapter_id": 5481, "verse_number": "१८", "content_sanskrit": "ततः स पुनरारुह्य वारणप्रवरं रणे ।\nअव्यग्रं प्रेषयामास जयार्थी विजयं प्रति ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2209617, "chapter_id": 5481, "verse_number": "१९", "content_sanskrit": "तस्मै बाणांस्ततो जिष्णुर्निर्मुक्ताशीविषोपमान् ।\nप्रेषयामास सङ्क्रुद्धो ज्वलितानिव पावकान् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2209618, "chapter_id": 5481, "verse_number": "२०", "content_sanskrit": "स तैर्विद्धो महाभागो विस्रवन् रुधिरं बभौ ।\nहिमवानिव शैलेन्द्रो बहुप्रस्रवणस्तदा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2209619, "chapter_id": 5481, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अश्वसञ्चरणो नाम पञ्चसप्ततितमोऽध्यायः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]