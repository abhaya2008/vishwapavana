[{"id": 6000123000, "chapter_id": 10123, "verse_number": null, "content_sanskrit": "अथ चतुर्थाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000123001, "chapter_id": 10123, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.001.m4a", "display_order": 2}, {"id": 6000123002, "chapter_id": 10123, "verse_number": "६-४-१", "content_sanskrit": "देवासुरनृणां सर्गो नागानां मृगपक्षिणाम्।\nसामासिकस्त्वया प्रोक्तो यस्तु स्वायम्भुवेऽन्तरे॥ ६/४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.002.m4a", "display_order": 3, "topics": [{"text": "दशानां प्रचेतसां मारिषानाम्न्या कन्यया विवाहः", "range": "१–१६"}]}, {"id": 6000123003, "chapter_id": 10123, "verse_number": "६-४-२", "content_sanskrit": "तस्यैव व्यासमिच्छामि श्रोतुं ते भगवन् यथा।\nअनुसर्गं यथा शक्त्या ससर्ज भगवान् परः॥ ६/४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.003.m4a", "display_order": 4}, {"id": 6000123004, "chapter_id": 10123, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.004.m4a", "display_order": 5}, {"id": 6000123005, "chapter_id": 10123, "verse_number": "६-४-३", "content_sanskrit": "इति सम्प्रश्नमाकर्ण्य राजर्षेर्बादरायणिः।\nप्रतिनन्द्य महायोगी जगाद मुनिसत्तमाः॥ ६/४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.005.m4a", "display_order": 6}, {"id": 6000123006, "chapter_id": 10123, "verse_number": null, "content_sanskrit": "ऋषिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.006.m4a", "display_order": 7}, {"id": 6000123007, "chapter_id": 10123, "verse_number": "६-४-४", "content_sanskrit": "यदा प्रचेतसः पुत्रा दश प्राचीनबर्हिषः।\nअन्तस्समुद्रादुन्मग्ना ददृशुर्गां द्रुमैर्वृताम्॥ ६/४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.007.m4a", "display_order": 8}, {"id": 6000123008, "chapter_id": 10123, "verse_number": "६-४-५", "content_sanskrit": "द्रुमेभ्यः क्रुध्यमानास्ते तपोदीपितमन्यवः।\nमुखतो वायुमग्निं च ससृजुस्तद्दिधक्षया॥ ६/४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.008.m4a", "display_order": 9}, {"id": 6000123009, "chapter_id": 10123, "verse_number": "६-४-६", "content_sanskrit": "ताभ्यां निर्दह्यमानांस्तानुपलभ्य कुरूद्वह।\nराजोवाच महान् सोमो मन्युं प्रशमयन्निव॥ ६/४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.009.m4a", "display_order": 10}, {"id": 6000123010, "chapter_id": 10123, "verse_number": "६-४-७", "content_sanskrit": "मा द्रुमेभ्यो महाभागा दीनेभ्यो द्रोग्धुमर्हथ।\nविवर्धयिषवो यूयं प्रजानां पतयः स्मृताः॥ ६/४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.010.m4a", "display_order": 11}, {"id": 6000123011, "chapter_id": 10123, "verse_number": "६-४-८", "content_sanskrit": "आदौ प्रजापतिपतिर्भगवान् हरिरव्ययः।\nवनस्पतीनोषधीश्च ससर्जोर्जमिषं विभुः॥ ६/४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.011.m4a", "display_order": 12}, {"id": 6000123012, "chapter_id": 10123, "verse_number": "६-४-९", "content_sanskrit": "अन्नं चराणामचरा, ह्यपादः पादचारिणाम्।\nअहस्ता हस्तयुक्तानां, द्विपदां च चतुष्पदः॥ ६/४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.012.m4a", "display_order": 13}, {"id": 6000123013, "chapter_id": 10123, "verse_number": "६-४-१०", "content_sanskrit": "यूयं च पित्राऽन्वादिष्टा देवदेवेन चानघाः।\nप्रजासर्गाय हि कथं वृक्षान् निर्दग्धुमर्हथ॥ ६/४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.013.m4a", "display_order": 14}, {"id": 6000123014, "chapter_id": 10123, "verse_number": "६-४-११", "content_sanskrit": "आतिष्ठत सतां मार्गं कोपं यच्छत दीपितम्।\nपित्रा पितामहेनापि जुष्टं वः प्रपितामहैः॥ ६/४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.014.m4a", "display_order": 15}, {"id": 6000123015, "chapter_id": 10123, "verse_number": "६-४-१२", "content_sanskrit": "तोकानां पितरौ बन्धू, दृशः पक्ष्म, स्‍त्रियः पतिः।\nनृपः प्रजानां, भिक्षूणां गृह्यज्ञानां बुधः सुहृत्॥ ६/४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.015.m4a", "display_order": 16}, {"id": 6000123016, "chapter_id": 10123, "verse_number": "६-४-१३", "content_sanskrit": "अन्तर्देहेषु भूतानाम् आत्माऽऽस्ते हरिरीश्वरः।\nसर्वं तद्धिष्ण्यमीक्षध्वमेवं वस्तोषितो ह्यसौ॥ ६/४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.016.m4a", "display_order": 17}, {"id": 6000123017, "chapter_id": 10123, "verse_number": "६-४-१४", "content_sanskrit": "यः समुत्पतितं देह आकाशान्मन्युमुल्बणम्।\nआत्मजिज्ञासया यच्छेत् स गुणानतिवर्तते॥ ६/४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.017.m4a", "display_order": 18}, {"id": 6000123018, "chapter_id": 10123, "verse_number": "६-४-१५", "content_sanskrit": "अलं दग्धैद्रुमैर्दीनैः शेषाणां शिवमस्तु वः।\nवार्क्षी ह्येषा वरा कन्या पत्नीत्वे प्रतिगृह्यताम्॥ ६/४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.018.m4a", "display_order": 19}, {"id": 6000123019, "chapter_id": 10123, "verse_number": "६-४-१६", "content_sanskrit": "इत्यामन्त्र्य वरारोहां कन्यामाप्सरसीं नृप।\nसोमो राजा ययौ दत्त्वा ते धर्मेणोपयेमिरे॥ ६/४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.019.m4a", "display_order": 20}, {"id": 6000123020, "chapter_id": 10123, "verse_number": "६-४-१७", "content_sanskrit": "तेभ्यस्तस्यामभूद् राजन् दक्षः प्राचेतसः किल।\nयस्य प्रजाविसर्गेण लोका आपूरितास्‍त्रयः॥ ६/४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.020.m4a", "display_order": 21, "topics": [{"text": "तेषां तस्यां दक्षनामकपुत्रोत्पत्तिः", "range": "१७–१९"}]}, {"id": 6000123021, "chapter_id": 10123, "verse_number": "६-४-१८", "content_sanskrit": "यथा ससर्ज भूतानि दक्षो दुहितृवत्सलः।\nरेतसा मनसा चैव तन्ममावहितः शृृणु॥ ६/४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.021.m4a", "display_order": 22}, {"id": 6000123022, "chapter_id": 10123, "verse_number": "६-४-१९", "content_sanskrit": "मनसैवासृजत् पूर्वं प्रजापतिरिमाः प्रजाः।\nदेवासुरमनुष्यादीन् नभःस्थलजलौकसः॥ ६/४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.022.m4a", "display_order": 23}, {"id": 6000123023, "chapter_id": 10123, "verse_number": "६-४-२०", "content_sanskrit": "तमबृंहितमालोक्य प्रजासर्गं प्रजापतिः।\nविन्ध्यपादानुपव्रज्य सोऽचरद् दुश्चरं तपः॥ ६/४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.023.m4a", "display_order": 24, "topics": [{"text": "दक्षकृतहंसगुह्याख्यस्तुत्या तुष्टस्य भगवतो नारायणेन दक्षस्य पञ्चजनप्रभापतिपुत्र्या असिक्न्या विवाहं कृत्वा प्रजाः सृज इत्यादेशः", "range": "२०–५४"}]}, {"id": 6000123024, "chapter_id": 10123, "verse_number": "६-४-२१", "content_sanskrit": "तत्राघमर्षणं नाम तीर्थं पापहरं परम्।\nउपस्पृश्यानुसवनं तपसाऽतोषयद्धरिम्॥ ६/४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.024.m4a", "display_order": 25}, {"id": 6000123025, "chapter_id": 10123, "verse_number": "६-४-२२", "content_sanskrit": "अस्तौषीद् हंसगुह्येन भगवन्तमधोक्षजम्।\nतुभ्यं तदभिधास्यामि कस्यातुष्यद्यतो हरिः॥ ६/४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.025.m4a", "display_order": 26}, {"id": 6000123026, "chapter_id": 10123, "verse_number": null, "content_sanskrit": "प्रजापतिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.026.m4a", "display_order": 27}, {"id": 6000123027, "chapter_id": 10123, "verse_number": "६-४-२३", "content_sanskrit": "नमः परायावितथानुभूतये गुणत्रयाभासनिमित्तबन्धवे।\nअदृष्टधाम्ने गुणतत्त्वबुद्धिभिर्निवृत्तमानावधये स्वयम्भुवे॥ ६/४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.027.m4a", "display_order": 28}, {"id": 6000123028, "chapter_id": 10123, "verse_number": "६-४-२४", "content_sanskrit": "न यस्य सख्यं पुरुषो वेत्ति सख्युः सखा वसन् संवसतः पुरेऽस्मिन्।\nगुणो यथा गुणिनोऽव्यक्तदृष्टिस्तस्मै महेशाय नमस्करोमि॥ ६/४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.028.m4a", "display_order": 29}, {"id": 6000123029, "chapter_id": 10123, "verse_number": "६-४-२५", "content_sanskrit": "देहोऽसवोऽक्षा मनवो भूतमात्रा नात्मानमन्यं च विदुः परं यत्।\nसर्वं पुमान् वेद गुणांश्च तज्ज्ञो न वेद सर्वज्ञमनन्तमीडे॥ ६/४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.029.m4a", "display_order": 30}, {"id": 6000123030, "chapter_id": 10123, "verse_number": "६-४-२६", "content_sanskrit": "यदोपरामो मनसो नामरूपरूपस्य दृष्टिस्मृतिसंप्रमोषात्।\nय ईयते केवलया स्वसंस्थया हंसाय तस्मै शुचिसद्मने नमः॥ ६/४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.030.m4a", "display_order": 31}, {"id": 6000123031, "chapter_id": 10123, "verse_number": "६-४-२७", "content_sanskrit": "मनीषिणोऽन्तर्हृदि सन्निवेशितं स्वशक्तिभिर्नवभिश्च त्रिवृद्भिः।\nवह्निं यथा दारुणि पाञ्चदश्यं मनीषया निष्कृषन्तीह गूढम्॥ ६/४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.031.m4a", "display_order": 32}, {"id": 6000123032, "chapter_id": 10123, "verse_number": "६-४-२८", "content_sanskrit": "स वै ममाशेषविशेषमायानिषेधनिर्वाणसुखानुभूतिः।\nस सर्वनामा स च विश्वरूपः प्रसीदतामनिरुक्तात्मशक्तिः॥ ६/४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.032.m4a", "display_order": 33}, {"id": 6000123033, "chapter_id": 10123, "verse_number": "६-४-२९", "content_sanskrit": "यद्यन्निरुक्तं वचसा निरूपितं धियाऽक्षभिर्वा मनसा वोत यस्य।\nमा भूत् स्वरूपं गुणरूपबृंहितं स वै गुणापायनिसर्गलक्षणः॥ ६/४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.033.m4a", "display_order": 34}, {"id": 6000123034, "chapter_id": 10123, "verse_number": "६-४-३०", "content_sanskrit": "यस्मिन् यतो येन च यस्य यस्मै यं यो यथा कुरुते कार्यते वा।\nपरावरेषां परमं प्राक् स्वसिद्धं तद् ब्रह्म तद्धेतुरनन्यदेकम्॥ ६/४/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.034.m4a", "display_order": 35}, {"id": 6000123035, "chapter_id": 10123, "verse_number": "६-४-३१", "content_sanskrit": "यच्छक्तयो वदतां वादिनां वै विवादसंवादभुवो भवन्ति।\nकुर्वन्ति तेषां मुहुरात्ममोहं तस्मै नमोऽनन्तगुणाय भूम्ने॥ ६/४/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.035.m4a", "display_order": 36}, {"id": 6000123036, "chapter_id": 10123, "verse_number": "६-४-३२", "content_sanskrit": "अस्तीति नास्तीति च वस्तुनिष्ठयोरेकस्थयोर्भिन्नविरुद्धधर्मयोः।\nअपेक्षितं किञ्चन सांख्ययोगयोः समं परं ह्यनुकूलं बृहत् तत्॥ ६/४/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.036.m4a", "display_order": 37}, {"id": 6000123037, "chapter_id": 10123, "verse_number": "६-४-३३", "content_sanskrit": "योऽनुग्रहार्थं भजतां पादमूलम् अनामरूपो भगवाननन्तः।\nनामानि रूपाणि च जन्मकर्मभिर्भेजे स मह्यं परमः प्रसीदताम्॥ ६/४/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.037.m4a", "display_order": 38}, {"id": 6000123038, "chapter_id": 10123, "verse_number": "६-४-३४", "content_sanskrit": "यः प्राकृतैर्ज्ञानपथैर्जनानां यथाशयं देहगतो विभाति।\nयथाऽनिलः पार्थिवमाश्रितो गुणं स ईश्वरो मे कुरुतान्मनोरथम्॥ ६/४/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.038.m4a", "display_order": 39}, {"id": 6000123039, "chapter_id": 10123, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.039.m4a", "display_order": 40}, {"id": 6000123040, "chapter_id": 10123, "verse_number": "६-४-३५", "content_sanskrit": "इति स्तवैः संस्तुवतः स तस्मिन्नघमर्षणे।\nप्रादुरासीत् कुरुश्रेष्ठ भगवान् भक्तवत्सलः॥ ६/४/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.040.m4a", "display_order": 41}, {"id": 6000123041, "chapter_id": 10123, "verse_number": "६-४-३६", "content_sanskrit": "कृतपादः सुपर्णांसे प्रलम्बाष्टमहाभुजः।\nशङ्खचक्रासिचर्मेषुधनुःपाशगदाधरः॥ ६/४/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.041.m4a", "display_order": 42}, {"id": 6000123042, "chapter_id": 10123, "verse_number": "६-४-३७", "content_sanskrit": "पीतवासा घनश्यामः प्रसन्नवदनेक्षणः।\nवनमालानिवीताङ्गो लसच्छ्रीवत्सकौस्तुभः॥ ६/४/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.042.m4a", "display_order": 43}, {"id": 6000123043, "chapter_id": 10123, "verse_number": "६-४-३८", "content_sanskrit": "महाकिरीटकटकस्फुरन्मकरकुण्डलः।\nकाञ्च्यङ्गुलीयवलयनूपुराङ्गदभूषितः॥ ६/४/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.043.m4a", "display_order": 44}, {"id": 6000123044, "chapter_id": 10123, "verse_number": "६-४-३९", "content_sanskrit": "त्रैलोक्यमोहनं रूपं बिभ्रत् त्रिभुवनेश्वरः।\nवृतो नारदनन्दाद्यैः पार्षदैः सुरयूथपैः॥ ६/४/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.044.m4a", "display_order": 45}, {"id": 6000123045, "chapter_id": 10123, "verse_number": "६-४-४०", "content_sanskrit": "स्तूयमानोऽनुगायद्भिः सिद्धगन्धर्वचारणैः। रूपं तन्महदाश्चर्यं विलक्ष्यागतसाध्वसः।\nननाम दण्डवद् भूमौ प्रहृष्टात्मा प्रजापतिः॥ ६/४/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.045.m4a", "display_order": 46}, {"id": 6000123046, "chapter_id": 10123, "verse_number": "६-४-४१", "content_sanskrit": "न किञ्चनोदीरयितुमशकत् तीव्रया मुदा।\nआपूरितमनोद्वारो ह्रदिन्य इव निर्झरैः॥ ६/४/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.046.m4a", "display_order": 47}, {"id": 6000123047, "chapter_id": 10123, "verse_number": "६-४-४२", "content_sanskrit": "तं तथाऽवनतं भक्तं प्रजाकामं प्रजापतिम्।\nचित्तज्ञः सर्वभूतानामिदमाह जनार्दनः॥ ६/४/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.047.m4a", "display_order": 48}, {"id": 6000123048, "chapter_id": 10123, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.048.m4a", "display_order": 49}, {"id": 6000123049, "chapter_id": 10123, "verse_number": "६-४-४३", "content_sanskrit": "प्राचेतस महाभाग संसिद्धस्तपसा भवान्।\nयच्छ्रद्धया मत्परया मयि भावं परं गतः॥ ६/४/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.049.m4a", "display_order": 50}, {"id": 6000123050, "chapter_id": 10123, "verse_number": "६-४-४४", "content_sanskrit": "प्रीतोऽहं ते प्रजानाथ यत्ते स्याद्बृंहणं तपः।\nममैष कामो भूतानां यद् भूयासुर्विभूतयः॥ ६/४/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.050.m4a", "display_order": 51}, {"id": 6000123051, "chapter_id": 10123, "verse_number": "६-४-४५", "content_sanskrit": "ब्रह्मा भवो भवन्तश्च मनवो विबुधेश्वराः।\nविभूतयो मम ह्येता भूतानां भूतिहेतवः॥ ६/४/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.051.m4a", "display_order": 52}, {"id": 6000123052, "chapter_id": 10123, "verse_number": "६-४-४६", "content_sanskrit": "तपो मे हृदयं साक्षात् तनुर्विद्या क्रियाऽऽकृतिः।\nअङ्गानि क्रतवो जाता धर्म आत्माऽसवः सुराः॥ ६/४/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.052.m4a", "display_order": 53}, {"id": 6000123053, "chapter_id": 10123, "verse_number": "६-४-४७", "content_sanskrit": "अहमेवेदमासाग्रे नान्यत् किञ्चान्तरं बहिः।\nसंज्ञानमात्रमव्यक्तं प्रसुप्तमिव विश्वतः॥ ६/४/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.053.m4a", "display_order": 54}, {"id": 6000123054, "chapter_id": 10123, "verse_number": "६-४-४८", "content_sanskrit": "मय्यनन्तगुणेऽनन्ते गुणतोऽनन्तविग्रहे।\nयदासीत् तत एवाद्यः स्वयम्भूः समभूदजः॥ ६/४/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.054.m4a", "display_order": 55}, {"id": 6000123055, "chapter_id": 10123, "verse_number": "६-४-४९", "content_sanskrit": "स वै यदा महादेवो मम वीर्योपबृंहितः।\nमेनेऽकल्पमिवात्मानमुद्यतः सर्गकर्मणि॥ ६/४/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.055.m4a", "display_order": 56}, {"id": 6000123056, "chapter_id": 10123, "verse_number": "६-४-५०", "content_sanskrit": "अथ मेऽभिहितो देवस्तपोऽतप्यत दारुणम्।\nनव विश्वसृजो युष्मान् येनादावसृजद् विभुः॥ ६/४/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.056.m4a", "display_order": 57}, {"id": 6000123057, "chapter_id": 10123, "verse_number": "६-४-५१", "content_sanskrit": "एषा पञ्चजनस्याङ्ग दुहिता वै प्रजापतेः।\nअसिक्नी नाम पत्नीत्वे प्रजेश प्रतिगृह्यताम्॥ ६/४/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.057.m4a", "display_order": 58}, {"id": 6000123058, "chapter_id": 10123, "verse_number": "६-४-५२", "content_sanskrit": "मिथुनव्यवायधर्मस्त्वं प्रजासर्गमिमं पुनः।\nमिथुनव्यवायधर्मिण्यां भूरिशो भावयिष्यसि॥ ६/४/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.058.m4a", "display_order": 59}, {"id": 6000123059, "chapter_id": 10123, "verse_number": "६-४-५३", "content_sanskrit": "त्वत्तोऽधस्तात् प्रजाः सर्वा मिथुनीभूय मायया।\nमदीयया भविष्यन्ति हरिष्यन्ति च मे बलिम्॥ ६/४/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.059.m4a", "display_order": 60}, {"id": 6000123060, "chapter_id": 10123, "verse_number": "६-४-५४", "content_sanskrit": "इत्युक्त्वा मिषतस्तस्य भगवान् विश्वभावनः।\nस्वप्नोपलब्धार्थ इव तत्रैवान्तर्दधे हरिः॥ ६/४/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_004/BhP_06.004.060.m4a", "display_order": 61}, {"id": 6000123061, "chapter_id": 10123, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां षष्ठस्कन्धे चतुर्थाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]