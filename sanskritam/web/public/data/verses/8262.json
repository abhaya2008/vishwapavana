[{"id": 900002301, "chapter_id": 8262, "verse_number": "7.1", "content_sanskrit": "॥यो ह वै ज्येष्ठं च श्रेष्ठं च वेद ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900002302, "chapter_id": 8262, "verse_number": "7.2", "content_sanskrit": "अथ ह प्राणा अहं श्रेयसि व्यूदिरेऽहं श्रेयानस्म्यहं श्रेयानस्मीति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900002303, "chapter_id": 8262, "verse_number": "7.3", "content_sanskrit": "स होवाच किं मेऽन्नं भविष्यतीति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900002304, "chapter_id": 8262, "verse_number": "7.4", "content_sanskrit": "स होवाच किं मे वासो भविष्यतीत्याप इति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900002305, "chapter_id": 8262, "verse_number": "7.5", "content_sanskrit": "तद्धैतत् सत्यकामो जाबालो गोश्रुतये वैयाघ्रपद्यायोक्त्वोवाच ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900002306, "chapter_id": 8262, "verse_number": "7.6", "content_sanskrit": "अथ यदि महज्जिगमिषेदमावास्यायां दीक्षित्वा ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900002307, "chapter_id": 8262, "verse_number": "7.7", "content_sanskrit": "अथ प्रतिसृप्याजलौ मन्थमाधाय जपत्यमो..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900002308, "chapter_id": 8262, "verse_number": "7.8", "content_sanskrit": "श्वेतकेतुर्ह आरुणेयः पञ्चालानां समितिमेयाय ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900002309, "chapter_id": 8262, "verse_number": "7.9", "content_sanskrit": "तद्य इत्थं विदुर्ये चेमे अरण्ये श्रद्धा तप इत्युपासते ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900002310, "chapter_id": 8262, "verse_number": "7.10", "content_sanskrit": "प्राचीनशाल औपमन्यवः सत्ययज्ञः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900002311, "chapter_id": 8262, "verse_number": "7.11", "content_sanskrit": "औपमन्यव कं त्वमात्मानमुपास्स इति दिवमेव ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900002312, "chapter_id": 8262, "verse_number": "7.12", "content_sanskrit": "अथ होवाच सत्ययज्ञं पौलुषिं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900002313, "chapter_id": 8262, "verse_number": "7.13", "content_sanskrit": "अथ होवाचेन्द्रद्युम्नं भाल्लवेयं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900002314, "chapter_id": 8262, "verse_number": "7.14", "content_sanskrit": "अथ होवाच जनं शार्कराक्ष्यं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900002315, "chapter_id": 8262, "verse_number": "7.15", "content_sanskrit": "अथ होवाच बुडिलमाश्वतराश्विं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900002316, "chapter_id": 8262, "verse_number": "7.16", "content_sanskrit": "अथ होवाचोद्दालकमारुणिं गौतम ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900002317, "chapter_id": 8262, "verse_number": "7.17", "content_sanskrit": "तान् होवाचैते वै खलु यूयं पृथगिवेममात्मानं वैश्वानरं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900002318, "chapter_id": 8262, "verse_number": "7.18", "content_sanskrit": "अथ यां द्वितीयां जुहुयात् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900002319, "chapter_id": 8262, "verse_number": "7.19", "content_sanskrit": "अथ यां तृतीयां जुहुयात् तां जुहुयादपानाय स्वाहेति अपानस्तृप्यति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900002320, "chapter_id": 8262, "verse_number": "7.20", "content_sanskrit": "अथ यां चतुर्थीं जुहुयात् तां जुहुयात् समानाय स्वाहेति समानस्तृप्यति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900002321, "chapter_id": 8262, "verse_number": "7.21", "content_sanskrit": "अथ यां पञ्चमीं जुहुयात् तां जुहुयादुदानाय स्वाहेति उदानस्तृप्यति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900002322, "chapter_id": 8262, "verse_number": "7.22", "content_sanskrit": "स य इदमविद्वानग्निहोत्रं जुहोति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]