[{"id": 2104331, "chapter_id": 3251, "verse_number": "१४-१०७-१", "content_sanskrit": "युधिष्ठिर उवाच।\nइदं मे तत्वतो देव वक्तुमर्हस्यशेषतः।\nहिंसामकृत्वा यो मर्त्यो ब्रह्महत्यामवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2104332, "chapter_id": 3251, "verse_number": "१४-१०७-२x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2104333, "chapter_id": 3251, "verse_number": "१४-१०७-२", "content_sanskrit": "ब्राह्मणं स्वयमाहूय भिक्षार्थं वृत्तिकर्शितम्।\nब्रूयान्नास्तीति यः पश्चात्तमाहुर्ब्रह्मघातकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2104334, "chapter_id": 3251, "verse_number": "१४-१०७-३", "content_sanskrit": "मध्यस्थस्येह विप्रस्य योऽनूचानस्य भारत।\nवृत्तिं हरति दुर्बुद्धइस्तमाहुर्ब्रह्मघातकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2104335, "chapter_id": 3251, "verse_number": "१४-१०७-४", "content_sanskrit": "आश्रमे वाऽऽलये वाऽपि ग्रामे वा नगरेऽपि वा।\nअग्निं यः प्रक्षिपेत्क्रुद्धस्तमाहुर्ब्रह्मघातकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2104336, "chapter_id": 3251, "verse_number": "१४-१०७-५", "content_sanskrit": "गोकुलस्य तृषार्तस्य जलान्ते वसुधाधिप।\nउत्पादयति यो विघ्नं तमाहुर्ब्रह्मघातकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2104337, "chapter_id": 3251, "verse_number": "१४-१०७-६", "content_sanskrit": "यः प्रवृत्तां श्रुतिं सम्यक्छास्त्रं वा मुनिभिः कृतम्।\nदूषयत्यनभिज्ञाय तमाहुर्ब्रह्मघातकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2104338, "chapter_id": 3251, "verse_number": "१४-१०७-७", "content_sanskrit": "चक्षुषा वाऽपि हीनस्य पङ्गोर्वाऽपि जडस्य वा।\nहरेद्वै यस्तु सर्वस्वं तमाहुर्ब्रह्मघातकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2104339, "chapter_id": 3251, "verse_number": "१४-१०७-८", "content_sanskrit": "गुरुं त्वंकृत्यं हुंकृत्य अतिक्रम्य च शासनम्।\nवर्तते यस्तु मूढात्मा तमाहुर्ब्रह्मघातकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2104340, "chapter_id": 3251, "verse_number": "१४-१०७-९", "content_sanskrit": "क्रोधाद्वा यदि वा द्वेषादाक्रुष्टस्तर्जितोपि वा।\nऋतौ स्त्रियं वा नोपेयात्तमाहुर्ब्रह्मघातकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2104341, "chapter_id": 3251, "verse_number": "१४-१०७-१०", "content_sanskrit": "यावत्सारो भवेद्दीनस्तन्नाशे यस्य दुःस्थितिः।\nतत्सर्वस्वं हरेद्यो वै तमाहुर्ब्रह्मघातकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2104342, "chapter_id": 3251, "verse_number": "१४-१०७-११x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2104343, "chapter_id": 3251, "verse_number": "१४-१०७-११", "content_sanskrit": "सप्वेषामपि दानानां यत्तु दानं विशिष्यते।\nअभोज्यान्नाश्च ये विप्रास्तान्ब्रवीहि सुरोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2104344, "chapter_id": 3251, "verse_number": "१४-१०७-१२x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2104345, "chapter_id": 3251, "verse_number": "१४-१०७-१२", "content_sanskrit": "अन्नमेव प्रशंसन्ति देवा ब्रह्मपुरस्सराः।\nअन्नेन सदृशं दानं न भूतं न भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2104346, "chapter_id": 3251, "verse_number": "१४-१०७-१३", "content_sanskrit": "अन्नमूर्जस्करं लोके ह्यन्नात्प्राणाः प्रतिष्ठिताः।\nअबोज्यान्नान्मया राजन्वक्ष्यमाणान्निबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2104347, "chapter_id": 3251, "verse_number": "१४-१०७-१४", "content_sanskrit": "दीक्षितस्य कदर्यस्य क्रुद्धस्य निकृतस्य च।\nअभिशप्तस्य षण्डस्य पाकभेदकरस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2104348, "chapter_id": 3251, "verse_number": "१४-१०७-१५", "content_sanskrit": "चिकित्सकस्य दूतस्य तथा चोच्छिष्टभोजिनः।\nउग्रान्नं सूतकान्नं च शूद्रोच्छेषणमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2104349, "chapter_id": 3251, "verse_number": "१४-१०७-१६", "content_sanskrit": "द्विषदन्नं न भोक्तव्यं पतितान्नं च यच्छ्रुतम्।\nतथा च पिशुनस्यान्नं यज्ञविक्रयिणस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2104350, "chapter_id": 3251, "verse_number": "१४-१०७-१७", "content_sanskrit": "शैलूषं तन्तुवायान्नं कृतघ्नस्यान्नमेव च।\nअंबष्ठकनिषादानां रङ्गावतरकस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2104351, "chapter_id": 3251, "verse_number": "१४-१०७-१८", "content_sanskrit": "सुवर्णकर्तुर्वैणस्यि शस्त्रविक्रयिणस्तथा।\nसूताना शौण्डिकानां च वैद्यस्य रजकस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2104352, "chapter_id": 3251, "verse_number": "१४-१०७-१९", "content_sanskrit": "स्त्रीजितस्य नृशंसस्य तथा माहिषिकस्य च।\nअनिर्दशानां प्रेतानां गणिकानां तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2104353, "chapter_id": 3251, "verse_number": "१४-१०७-२०", "content_sanskrit": "बन्दिनो द्यूतकर्तुश्च तथा द्यूतविदामपि।\nपरिवित्तस्य यच्चान्नं परिवेत्तुस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2104354, "chapter_id": 3251, "verse_number": "१४-१०७-२१", "content_sanskrit": "यश्चाग्रदिधिषुर्विप्रो दिधिषूपपिस्तथा।\nतयोरप्युभयोरन्नं राज्ञां चापि विवर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2104355, "chapter_id": 3251, "verse_number": "१४-१०७-२२", "content_sanskrit": "राजान्नं तेज आदत्ते शूद्रान्नं ब्रह्मवर्चसम्।\nआयुः सुवर्णकारान्नं यशश्चार्मावकृन्तिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2104356, "chapter_id": 3251, "verse_number": "१४-१०७-२३", "content_sanskrit": "गणान्नं गणिकान्नं च लोकेभ्यः परिकीर्तितम्।\nपूयं चिकित्सकस्यान्नं शुक्लं तु वृषलीपतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2104357, "chapter_id": 3251, "verse_number": "१४-१०७-२४", "content_sanskrit": "विष्ठा वार्धुषिकस्यान्नं तस्मात्तत्परिवर्जयेत्।\nतेषां त्वगस्थिरोमाणि भुङ्क्ते योऽन्नं तु भक्षयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2104358, "chapter_id": 3251, "verse_number": "१४-१०७-२५", "content_sanskrit": "अमात्यान्नमथैतेषां भुक्त्वा तु त्रियहं क्षिपेत्।\nमत्या भुक्त्वा सकृद्वाऽपि प्राजापत्यं चरेद्द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2104359, "chapter_id": 3251, "verse_number": "१४-१०७-२६", "content_sanskrit": "दानानां च फलं यद्वै शृणु पाण्डव तत्वतः।\nजलदस्तृप्तिमाप्नोति सुखमक्षयमन्नदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2104360, "chapter_id": 3251, "verse_number": "१४-१०७-२७", "content_sanskrit": "तिलदश्च प्रजामिष्टां दीपदश्चक्षुरुत्तमम्।\nभूमदो भूमिमाप्नोति दीर्घमायुर्हिरण्यदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2104361, "chapter_id": 3251, "verse_number": "१४-१०७-२८", "content_sanskrit": "गृहदोऽग्र्याणि वेश्मानि रूप्यदो रूपमुत्तमम्।\nवासोदश्चन्द्रसालोक्यमश्विसालोक्यमश्वदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2104362, "chapter_id": 3251, "verse_number": "१४-१०७-२९", "content_sanskrit": "अनडुद्दः श्रियं जुष्टां गोदो गोलोकमश्नुते।\nयानशय्याप्रदो भार्यामैश्वर्यमभयप्रदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2104363, "chapter_id": 3251, "verse_number": "१४-१०७-३०", "content_sanskrit": "धान्यदः शाश्वतं सौख्यं ब्रह्मदो ब्रह्मसाम्यताम्।\nसर्वेषामेव दानानां ब्रह्मदानं विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2104364, "chapter_id": 3251, "verse_number": "१४-१०७-३१", "content_sanskrit": "हिरण्यभूगवाश्वाजवस्त्रशय्यासनादिषु।\nयोर्चितः प्रतिगृह्णाति दद्यादुचितमेव च।\nतावुभौ गच्छतः स्वर्गं नरकं च विपर्यये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2104365, "chapter_id": 3251, "verse_number": "१४-१०७-३२", "content_sanskrit": "अनृतं न वदेद्विद्वांस्तपस्तप्त्वा न विस्मयेत्।\nनार्तोप्यभिभवेद्विप्रान्न दत्त्वा परिकीर्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2104366, "chapter_id": 3251, "verse_number": "१४-१०७-३३", "content_sanskrit": "यज्ञोऽनृतेन क्षरति तपः क्षरति विस्मयात्।\nआयुर्विप्रावमानेन दानं तु परिकीर्तनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2104367, "chapter_id": 3251, "verse_number": "१४-१०७-३४", "content_sanskrit": "एकः प्रजायते जन्तुरेक एव प्रमीयते।\nअकोऽनुभुङ्क्ते सुकृतमेकश्चाप्नोति दुष्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2104368, "chapter_id": 3251, "verse_number": "१४-१०७-३५", "content_sanskrit": "मृतं शरीरमुत्सृज्य काष्ठलोष्टसमं क्षितौ।\nविमुखा बान्धवा यान्ति धर्मस्तमनुवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2104369, "chapter_id": 3251, "verse_number": "१४-१०७-३६", "content_sanskrit": "अनागतानि कार्याणि कर्तुं गणयते मनः।\nशरीरकं समुद्दिश्य स्मयते नूनमन्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2104370, "chapter_id": 3251, "verse_number": "१४-१०७-३७", "content_sanskrit": "तस्माद्धर्मसहासस्तु धर्मं संचिनुयात्सदा।\nधर्मेण हि सहायेन तमस्तरति दुस्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2104371, "chapter_id": 3251, "verse_number": "१४-१०७-३८", "content_sanskrit": "येषां तटाकानि बहूदकानि\nसभाश्च कूपाश्च शुभाः प्रपाश्च।\nअन्नप्रदानं मधुरा च वाणी\nयमस्य ते निर्विषया भवन्ति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2104372, "chapter_id": 3251, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि वैष्णवधर्मपर्वणि सप्ताधिकशततमोऽध्यायः॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]