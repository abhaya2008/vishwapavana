[{"id": 2034944, "chapter_id": 1754, "verse_number": "४-७७-०x", "content_sanskrit": "विराट उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2034945, "chapter_id": 1754, "verse_number": "४-७७-१", "content_sanskrit": "यच्च वक्ष्याम्यहं तेऽद्य मा शङ्केथा युधिष्ठिर।\nइदं सनगरं राष्ट्रं सजनं सवधूजनम्।\nयुष्यभ्यं संप्रदास्यामि भोक्ष्याम्युच्छिष्टमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2034946, "chapter_id": 1754, "verse_number": "४-७७-२", "content_sanskrit": "अहं वद्धश्चिरं राजन्भुक्तभोगश्चिरं सुखम्।\nराज्यं दत्त्वा तु युष्मभ्यं प्रव्रजिष्यामि काननम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2034947, "chapter_id": 1754, "verse_number": "४-७७-३", "content_sanskrit": "उत्तरां प्रतिगृह्णातु सव्यसाची धनंजयः ।\nअयं ह्यौपयिको भर्ता तस्याः पुरुषसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2034948, "chapter_id": 1754, "verse_number": "४-७७-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2034949, "chapter_id": 1754, "verse_number": "४-७७-४", "content_sanskrit": "एवमुक्तो धर्मराजः पार्थपैक्षद्वनंजयम्।\nईक्षितं चार्जुनो ज्ञात्वा मात्स्यं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2034950, "chapter_id": 1754, "verse_number": "४-७७-५", "content_sanskrit": "वयं वनान्तरात्प्राप्ता न ते राज्यं गृहामहे।\nकिंतु दुर्योधनादीनां राज्ञां राज्यं गृहामहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2034951, "chapter_id": 1754, "verse_number": "४-७७-६", "content_sanskrit": "प्रतिगृह्णाम्यहं राजन्स्रुषं दुहितरं तव।\nयुक्तो ह्यावां हि संबन्धो मात्स्यभारतवंशयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2034952, "chapter_id": 1754, "verse_number": "४-७७-७x", "content_sanskrit": "विराट उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2034953, "chapter_id": 1754, "verse_number": "४-७७-७", "content_sanskrit": "किमर्थं पाण्डवश्रेष्ठ भार्यां दुहितरं मम।\nप्रतिग्रहीतुं नेमां त्वं मया दत्तमिहेच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2034954, "chapter_id": 1754, "verse_number": "४-७७-८x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2034955, "chapter_id": 1754, "verse_number": "४-७७-८", "content_sanskrit": "अन्तःपुरेऽहमुषितः सदा पश्यन्सुतां तव।\nसहस्यं च प्रकाशं च विश्वस्ता पितृवन्मयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2034956, "chapter_id": 1754, "verse_number": "४-७७-९", "content_sanskrit": "प्रियो बहुमतश्चाहं नर्तने गीतवादिते।\nआचार्यवच्च मां नित्यं मन्यते दुहिता तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2034957, "chapter_id": 1754, "verse_number": "४-७७-१०", "content_sanskrit": "वयस्यया तया राजन्सह संवत्सरोषितः ।\nअतिशङ्का ततोऽस्थाने तव लोकस्य च प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2034958, "chapter_id": 1754, "verse_number": "४-७७-११", "content_sanskrit": "तस्मादामन्त्रये त्वाऽद्य पुत्रार्थं मे विशांपते।\nसुद्धं जितेन्द्रियं मन्ये तस्याः शुद्धिः कृता मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2034959, "chapter_id": 1754, "verse_number": "४-७७-१२", "content_sanskrit": "स्नुषायां दुहितुर्वापि पुत्रे चात्मनि वा पुनः ।\nअतिशङ्कां न पश्यामि तेन शुद्धिर्भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2034960, "chapter_id": 1754, "verse_number": "४-७७-१३", "content_sanskrit": "अभिषङ्गादहं भीतो मिथ्याचारात्परंतप ।\nस्रुषार्थमुत्तरां राजन्प्रतिगृह्णामि ते सुताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2034961, "chapter_id": 1754, "verse_number": "४-७७-१४", "content_sanskrit": "स्वस्त्रीयो वासुदेवस्य साक्षाद्देवसुतो यथा।\nदयितश्चक्रहस्तस्य बलवानस्त्रकोविदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2034962, "chapter_id": 1754, "verse_number": "४-७७-१५", "content_sanskrit": "अभिमन्युर्गहाबाहुः पुत्रो मम विशांपते ।\nजामाता तव युक्तो वै भर्ता च दुहितुस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2034963, "chapter_id": 1754, "verse_number": "४-७७-१६x", "content_sanskrit": "विराट उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2034964, "chapter_id": 1754, "verse_number": "४-७७-१६", "content_sanskrit": "उपपन्नं कुरुश्रेष्ठे कुन्तीपुत्रे धनंजये।\nसदैव धर्मनित्यश्च ज्ञातज्ञानश्च पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2034965, "chapter_id": 1754, "verse_number": "४-७७-१७", "content_sanskrit": "यत्कृत्यं मन्यसे पार्थ क्रियतां तदनन्तरम्।\nसर्वे कामाः समृद्धा मे संबन्धी यस्य मेऽर्जुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2034966, "chapter_id": 1754, "verse_number": "४-७७-१८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2034967, "chapter_id": 1754, "verse_number": "४-७७-१८", "content_sanskrit": "एवं ब्रुवति राजेन्द्रे कुन्तीपुत्रो युधिष्ठिरः।\nअन्वजानत संबन्धं समये कृष्णमात्स्ययोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2034968, "chapter_id": 1754, "verse_number": "४-७७-१९", "content_sanskrit": "दूतान्सर्वेषु मित्रेषु वासुदेवे च भारत।\nप्रेषयामास कौन्तेयो विराटश्च महीपतिः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2034969, "chapter_id": 1754, "verse_number": "४-७७-२०", "content_sanskrit": "प्रतिगृह्य स्नुषार्थं वै दर्शयन्व्रतमात्मनः ।\nशीलशौचसमाचारं लोकस्यावेद्य फल्गुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2034970, "chapter_id": 1754, "verse_number": "४-७७-२१", "content_sanskrit": "लोके विख्याप्य माहात्म्यं यशश्च स परंतपः ।\nकृतार्थः शुचिरव्यग्रस्तुष्टिमानभवत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2034971, "chapter_id": 1754, "verse_number": "४-७७-२२x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2034972, "chapter_id": 1754, "verse_number": "४-७७-२२", "content_sanskrit": "राजन्प्रीतोस्मि भद्रं ते सखा मेऽसि परन्तप।\nसुखमध्युषिताः सर्वे अज्ञातास्त्वयि पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2034973, "chapter_id": 1754, "verse_number": "४-७७-२३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2034974, "chapter_id": 1754, "verse_number": "४-७७-२३", "content_sanskrit": "विराटनगरे राजा धर्मात्मा संशितव्रतः ।\nपूजितश्चाभिषिक्तश्च रत्नैश्च शतशोर्चितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2034975, "chapter_id": 1754, "verse_number": "४-७७-२४", "content_sanskrit": "तथा ब्रुवन्तं प्रसमीक्ष्य राजा\nपरं प्रहृष्टः स्वजनेन तेन।\nस्नेहात्परिष्वज्य नृपो भुजाभ्यां\nददौ महार्थं कुरुपाण्डवानाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2034976, "chapter_id": 1754, "verse_number": "४-७७-२५", "content_sanskrit": "युद्धात्प्रयाताः कुरवो हि मार्गे\nसमेत्य सर्वे हितमेव तत्र।\nआचार्यपुत्रः शकुनिश्च राजा\nदुर्योधनः सूतपुत्रश्च कर्णः।\nसंमन्त्र्य राजन्सहिताः समर्थाः\nसमादिशन्दूतमथो समग्राः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2034977, "chapter_id": 1754, "verse_number": "४-७७-२६", "content_sanskrit": "युधिष्ठिरश्चापि सुसंग्रहृष्टो\nदुर्योधनाद्दूतमपश्यदागतम्।\nस चाब्रवीद्धर्मराजं समेत्य\nयुधिष्ठिरं पाण्डवमुग्रवीर्यम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2034978, "chapter_id": 1754, "verse_number": "४-७७-२७", "content_sanskrit": "धनञ्जयेनासि पुनर्वनाय\nप्रव्राजितः समये तिष्ठ पार्थः।\nत्रयोदशे ह्येव किरीटमाली\nसंवत्सरे पाण्डवेयोऽद्य दृष्टः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2034979, "chapter_id": 1754, "verse_number": "४-७७-२८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2034980, "chapter_id": 1754, "verse_number": "४-७७-२८", "content_sanskrit": "ततोऽब्रवीद्धर्मसुतः प्रहस्य\nक्षिप्रं गत्वा ब्रूहि सुयोधनं तम्।\nपितामहः शान्तनवो ब्रवीतु\nपूर्णो न पूर्णोऽद्य त्रयोदशो नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2034981, "chapter_id": 1754, "verse_number": "४-७७-२९", "content_sanskrit": "संवत्सरात्ते तु धनञ्जयेन\nविष्फारितं गाण्डिवमाजिमध्ये।\nपूर्णो न पूर्णो न इति ब्रवीतु\nयदस्य सत्यं मम तत्प्रमाणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2034982, "chapter_id": 1754, "verse_number": "४-७७-३०", "content_sanskrit": "तेनैवमुक्तः स निवृत्य दूतो\nदुर्योधनं प्राप्य शशंस तत्त्वम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2034983, "chapter_id": 1754, "verse_number": "४-७७-३१", "content_sanskrit": "समेत्य दूतेन स राजपुत्रो\nदुर्योधनो मन्त्रयामास तत्र।\nभीष्मेण कर्णेन कृपेण चैव\nद्रोणेन भूरिश्रवसा च सार्धम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2034984, "chapter_id": 1754, "verse_number": "४-७७-३२", "content_sanskrit": "संमन्त्र्य रात्रौ बहुभिः सुहृद्भि-\nर्भीष्मोऽब्रवीद्धार्तराष्ट्रं महात्मा ।\nतीर्णप्रतिज्ञेन धनंजयेन\nविष्फारितं गाण्डिवमाजिमध्ये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2034985, "chapter_id": 1754, "verse_number": "४-७७-३३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2034986, "chapter_id": 1754, "verse_number": "४-७७-३३", "content_sanskrit": "नेच्छन्त्यसत्येन सुरेन्द्रलोकं\nपाण्डोः सुता ब्रह्मणश्चापि लोकम्।\nतथ्यं च ते पथ्यमहं ब्रवीमि\nस्वर्ग्यं यशस्यं परलोकपथ्यम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2034987, "chapter_id": 1754, "verse_number": "४-७७-३४", "content_sanskrit": "कुन्तीसुतैस्त्वं समुपैहि सन्धिं\nभुङ्क्ष्व स्वराज्यं सह पाण्डवेयैः।\nयुध्यस्व नोचेत्स्थिरबुद्धिराजौ\nकुन्तीसुतैर्यद्यपि राज्यमिच्छेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2034988, "chapter_id": 1754, "verse_number": "४-७७-३५", "content_sanskrit": "आन्तं न शक्यं कपटेन भोक्तुं\nराज्यं परेषां महतां बलीनाम्।\nजित्वा शत्रून्भुङ्क्ष्व राज्यं समग्रं\nहतो भवान्भोक्ष्यति वज्रिलोकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2034989, "chapter_id": 1754, "verse_number": "४-७७-३६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2034990, "chapter_id": 1754, "verse_number": "४-७७-३६", "content_sanskrit": "ततः स भागीरथिसूनुवाक्यं\nनिशम्य गान्धारितनूद्भवो नृपः।\nउवाच भीष्मं प्रमुखे च पित्रो-\nर्महीं न दद्यामणुमात्रिकामपि।\nनिहन्मि पाण्डूदरसंभवान्वा\nहतोस्मि तैर्वा सुरलोकमेमि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2034991, "chapter_id": 1754, "verse_number": "४-७७-३७", "content_sanskrit": "ते धार्तराष्ट्राः समयं निशम्य\nतीर्णप्रतिज्ञस्य धनंजयस्य\nसंचिन्त्य सर्वे सहिताः सुहृद्भिः\nसपार्थिवाः स्वानि गृहाणि जग्मुः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2034992, "chapter_id": 1754, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि वैवाहिकपर्वणि सप्तसप्ततितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]