[{"id": 2213287, "chapter_id": 5554, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2213288, "chapter_id": 5554, "verse_number": "१", "content_sanskrit": "ततस्ते पाण्डवा दूराद् अवतीर्य पदातयः ।\nअभिजग्मुर्नरपतेराश्रमं विनयान्विताः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2213289, "chapter_id": 5554, "verse_number": "२", "content_sanskrit": "स च सेनाजनः सर्वो ये च राष्ट्रनिवासिनः ।\nस्त्रियश्च कुरुमुख्यानां पद्भिरेवान्वयुस्तदा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2213290, "chapter_id": 5554, "verse_number": "३", "content_sanskrit": "तत्राश्रममुपाजग्मुर्धृतराष्ट्रस्य पाण्डवाः ।\nशून्यं मृगगणाकीर्णं कदळीवनशोभितम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2213291, "chapter_id": 5554, "verse_number": "४", "content_sanskrit": "ततस्तत्र समाजग्मुस्तापसा विविधव्रताः ।\nपाण्डवानागतान् द्रष्टुं कौतूहलसमन्विताः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2213292, "chapter_id": 5554, "verse_number": "५", "content_sanskrit": "तानपृच्छत् ततो राजा क्वासौ कौरववंशभृत् ।\nपिता ज्येष्ठो गतोऽस्माकमिति बाष्पपरिप्लुतः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2213293, "chapter_id": 5554, "verse_number": "६", "content_sanskrit": "तमूचुस्ते ततो वाक्यं यमुनामवगाहितुम् ।\nपुष्पाणामुदकुम्भस्य चार्थे गत इति प्रभो\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2213294, "chapter_id": 5554, "verse_number": "७", "content_sanskrit": "तैराख्यातेन मार्गेण ततस्ते प्रययुस्तदा ।\nददृशुश्चाविदूरे तान् सर्वानथ पदातयः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2213295, "chapter_id": 5554, "verse_number": "८", "content_sanskrit": "ततस्ते सत्वरा जग्मुः पितुर्दर्शनकाङ्क्षिणः ।\nसहदेवस्तु वेगेन प्राधावद्यत्र सा पृथा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2213296, "chapter_id": 5554, "verse_number": "९", "content_sanskrit": "सस्वरं प्रारुदद् धीमान् मातुः पादावुपस्पृशन् ।\nसा तु बाष्पाकुलमुखी तं ददर्श प्रियं सुतम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2213297, "chapter_id": 5554, "verse_number": "१०", "content_sanskrit": "बाहुभ्यां सम्परिष्वज्य समुन्नाम्य च भारत ।\nगान्धार्याः कथयामास सहदेवमुपस्थितम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2213298, "chapter_id": 5554, "verse_number": "११", "content_sanskrit": "अनन्तरं च राजानं भीमसेनमथार्जुनम् ।\nनकुलं च पृथा दृष्ट्वा त्वरमाणोपचक्रमे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2213299, "chapter_id": 5554, "verse_number": "", "content_sanskrit": "(सा ह्यग्रे गच्छति तयोर्दम्पत्योर्हतपुत्रयोः ।\nकर्षन्ती तौ ततस्ते तां दृष्ट्वैव न्यपतन् भुवि\t॥१२॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2213300, "chapter_id": 5554, "verse_number": "१३", "content_sanskrit": "तयोस्तु पादयो राजन् न्यपतन् हतपुत्रयोः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2213301, "chapter_id": 5554, "verse_number": "१४", "content_sanskrit": "तान् राजा स्वरयोगेन स्पर्शेन च महामनाः ।\nप्रत्यभिज्ञाय मेधावी समाश्वासयत प्रभुः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2213302, "chapter_id": 5554, "verse_number": "१५", "content_sanskrit": "ततस्ते बाष्पमुत्सृज्य गान्धारीसहितं नृपम् ।\nउपतस्थुर्महात्मानो मातरं च यथाविधि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2213303, "chapter_id": 5554, "verse_number": "१६", "content_sanskrit": "सर्वेषां तोयकलशान् जगृहुस्ते स्वयं तथा ।\nपाण्डवा लब्धसञ्ज्ञास्ते मात्रा चाश्वासिता भृशम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2213304, "chapter_id": 5554, "verse_number": "१७", "content_sanskrit": "ततो नार्यो नृसिंहानां स च योधजनस्तथा ।\nपौरजानपदाश्चैव ददृशुस्तं नराधिपम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2213305, "chapter_id": 5554, "verse_number": "१८", "content_sanskrit": "निवेदयामास ततो जनं तं गोत्रनामतः ।\nयुधिष्ठिरो नरपतिः स चैनान् प्रत्यपूजयत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2213306, "chapter_id": 5554, "verse_number": "१९", "content_sanskrit": "स तैः परिवृतो मेने हर्षबाष्पाविलेक्षणः ।\nराजाऽऽत्मानं गृहगतं पुरेव गजसाह्वये\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2213307, "chapter_id": 5554, "verse_number": "२०", "content_sanskrit": "अभिवादितो वधूभिश्च कृष्णाद्याभिः स पार्थिवः ।\nगान्धारीसहितो धीमान् कुन्त्या च प्रत्यनन्दत\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2213308, "chapter_id": 5554, "verse_number": "२१", "content_sanskrit": "ततस्त्वाश्रममागच्छत् सिद्धचारणसेवितम् ।\nदिदृक्षुभिः समाकीर्णं नभस्तारागणैरिव\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2213309, "chapter_id": 5554, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्रमवासिकपर्वणि पाण्डवधृतराष्ट्रदर्शनं नाम त्रिंशोऽध्यायः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2213310, "chapter_id": 5554, "verse_number": "", "content_sanskrit": "आश्रमवासपर्वणि त्रिंशोऽध्यायः ॥३०॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]