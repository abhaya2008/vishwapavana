[{"id": 2068581, "chapter_id": 2439, "verse_number": "९-५७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2068582, "chapter_id": 2439, "verse_number": "९-५७-१", "content_sanskrit": "ततो वाग्युद्धमभवत्तुमुलं जनमेजय।\nयत्र दुःखान्वितो राजा धृतराष्ट्रोऽब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2068583, "chapter_id": 2439, "verse_number": "९-५७-२", "content_sanskrit": "धिगस्तु खलु मानुष्यं यस्य निष्ठेयमीदृशी।\nएकादशचमूभर्ता यत्र पुत्रो ममानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2068584, "chapter_id": 2439, "verse_number": "९-५७-३", "content_sanskrit": "आज्ञाप्य सर्वान्नृपतीन्भुक्त्वा चेमां वसुन्धराम्।\nगदामादाय चैकाकी पदातिः प्रस्थितो रणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2068585, "chapter_id": 2439, "verse_number": "९-५७-४", "content_sanskrit": "भूत्वा हि जगतो नाथो ह्यनाथ इव मे सुतः।\nगदामुद्यम्य यो याति किमन्यद्भागधेयतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2068586, "chapter_id": 2439, "verse_number": "९-५७-५", "content_sanskrit": "अहो दुःखं महत्प्राप्तं पुत्रेण मम स़ञ्जय।\nएवमुक्त्वा स दुःखार्तो विरराम जनाधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2068587, "chapter_id": 2439, "verse_number": "९-५७-६x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2068588, "chapter_id": 2439, "verse_number": "९-५७-६", "content_sanskrit": "स मेघनिनदो हर्षान्निनदन्निव गोवृषः।\nआजुहाव तदा पार्थं युद्धाय युधि वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2068589, "chapter_id": 2439, "verse_number": "९-५७-७", "content_sanskrit": "भीममाह्वयमाने तु कुरुराजे महात्मनि।\nप्रादुरासन्सुघोराणि रूपाणि विविधान्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2068590, "chapter_id": 2439, "verse_number": "९-५७-८", "content_sanskrit": "ववुर्वाताः सनिर्घाताः पांसुवर्षं पपात च।\nबभूवुश्च दिशः सर्वास्तिमिरेण समावृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2068591, "chapter_id": 2439, "verse_number": "९-५७-९", "content_sanskrit": "महास्वनाः सुनिर्वातास्तुमुला रोमहर्षणाः।\nपेतुस्तथोल्काः शतशः स्फोटयन्त्यो नभस्तलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2068592, "chapter_id": 2439, "verse_number": "९-५७-१०", "content_sanskrit": "राहुश्चाग्रसदादित्यमपर्वणि विशाम्पते।\nचकम्पे च महाकम्पं पृथिवी सवनद्रुमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2068593, "chapter_id": 2439, "verse_number": "९-५७-११", "content_sanskrit": "रूक्षाश्च वाताः प्रववुर्नीचैः शर्करकर्षिणः।\nगिरीणां शिखराण्येव न्यपतन्त महीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2068594, "chapter_id": 2439, "verse_number": "९-५७-१२", "content_sanskrit": "मृगा बहुविधाकाराः सम्पतन्ति दीशो दश।\nदीप्ताः शिवाश्चाप्यनदन्घोररूपाः सुदारुणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2068595, "chapter_id": 2439, "verse_number": "९-५७-१३", "content_sanskrit": "निर्घाताश्च महाघोरा बभूवू रोमहर्षणाः।\nदीप्तायां दिशि राजेन्द्र मृगाश्चाशुभवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2068596, "chapter_id": 2439, "verse_number": "९-५७-१४", "content_sanskrit": "उदपानगताश्चापो व्यवर्धन्त समन्ततः।\nअशरीरा महानादाः श्रूयन्ते स्म भयानकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2068597, "chapter_id": 2439, "verse_number": "९-५७-१५", "content_sanskrit": "एवमादीनि दृष्ट्वा स निमित्तानि वृकोदरः।\nउवाच भ्रातरं ज्येष्ठं धर्मराजं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2068598, "chapter_id": 2439, "verse_number": "९-५७-१६", "content_sanskrit": "एष शक्यो मया जेतुं मन्दात्मा च सुयोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2068599, "chapter_id": 2439, "verse_number": "९-५७-१७", "content_sanskrit": "अद्य क्रोधं विमोक्ष्यामि निगूढं हृदयेशयम्।\nसुयोधने कौरवेन्द्रे खाण्डवेऽग्निमिवार्जुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2068600, "chapter_id": 2439, "verse_number": "९-५७-१८", "content_sanskrit": "शल्यमद्योद्धरिष्यामि तव पाण्डव हृच्छयम्।\nनिहत्य गदया पापमिमं कुरुकुलान्तकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2068601, "chapter_id": 2439, "verse_number": "९-५७-१९", "content_sanskrit": "अद्य कीर्तिमयीं मालां प्रतिमोक्ष्याम्यहं त्वयि।\nहत्वेमं पापकर्माणं गदया रणमूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2068602, "chapter_id": 2439, "verse_number": "९-५७-२०", "content_sanskrit": "अद्योरुगदया राजन्भेत्ताऽस्मि समरेऽनया।\nनायं प्रवेष्टा नगरं पुनर्वारणसाह्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2068603, "chapter_id": 2439, "verse_number": "९-५७-२१", "content_sanskrit": "सर्पोत्सर्गस्य शयने विषदानस्य भोजने।\nप्रमाणकोट्यां पातस्य दाहस्य जतुवेश्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2068604, "chapter_id": 2439, "verse_number": "९-५७-२२", "content_sanskrit": "सभायामवहासस्य सर्वस्वहरणस्य च।\nवर्षमज्ञातवासस्य वनवासस्य चानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2068605, "chapter_id": 2439, "verse_number": "९-५७-२३", "content_sanskrit": "अद्यान्तमेषां दुःखानां गन्ताऽहं भरतर्षभ।\nएकाह्ना विनिहत्येमं भविष्याम्यात्मनोऽनृणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2068606, "chapter_id": 2439, "verse_number": "९-५७-२४", "content_sanskrit": "अद्यायुर्धार्तराष्ट्रस्य दुर्मतेरकृतात्मनः।\nसमाप्तं भरतश्रेष्ठ मातापित्रोश्च दर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2068607, "chapter_id": 2439, "verse_number": "९-५७-२५", "content_sanskrit": "अद्य सौख्यं तु राजेन्द्र कुरुराजस्य दुर्मतेः।\nसमाप्तं च महाराज नारीणां दर्शनं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2068608, "chapter_id": 2439, "verse_number": "९-५७-२६", "content_sanskrit": "अद्यायं कुरुराजस्य शन्तनोः कुलपांसनः।\nप्राणाञ्श्रियं च राज्यं च त्यक्त्वा शेष्यति भूतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2068609, "chapter_id": 2439, "verse_number": "९-५७-२७", "content_sanskrit": "राजा च धृतराष्ट्रोऽद्य श्रुत्वा पुत्रं निपातितम्।\nस्मरिष्यत्यशुभं कर्म यत्तच्छकुनिबुद्धिजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2068610, "chapter_id": 2439, "verse_number": "९-५७-२८", "content_sanskrit": "इत्युक्त्वा राजशार्दूल गदामादाय वीर्यवान्।\nअभ्यतिष्ठत युद्धाय शक्रो वृत्रमिवाह्वयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2068611, "chapter_id": 2439, "verse_number": "९-५७-२९", "content_sanskrit": "तमुद्यतगदं दृष्ट्वा कैलासमिव शृङ्गिणम्।\nभीमसेनः पुनः क्रुद्धो दुर्योधनमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2068612, "chapter_id": 2439, "verse_number": "९-५७-३०", "content_sanskrit": "राज्ञश्च धृतराष्ट्रस्य तथा त्वमपि चात्मनः।\nस्मर तद्दुष्कृतं कर्म यद्वृत्तं वारणावते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2068613, "chapter_id": 2439, "verse_number": "९-५७-३१", "content_sanskrit": "द्रौपदी च परिक्लिष्टा सभामध्ये रजस्वला।\nद्यूते च वञ्चितो राजा यत्त्वया सौबलेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2068614, "chapter_id": 2439, "verse_number": "९-५७-३२", "content_sanskrit": "वने दुःखं च यत्प्राप्तमस्माभिस्त्वत्कृतं महत्।\nविराटनगरे चैव योन्यन्तरगतैरिव।\nतत्सर्वं पातयाम्यद्य दिष्ट्या दृष्टोऽसि दुर्मते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2068615, "chapter_id": 2439, "verse_number": "९-५७-३३", "content_sanskrit": "त्वत्कृतेऽसौ हतः शेते शरतल्पे पितामहः।\nगाङ्गेयो रथिनां श्रेष्ठो रथिना याज्ञसेनिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2068616, "chapter_id": 2439, "verse_number": "९-५७-३४", "content_sanskrit": "हतो द्रोणश्च कर्णश्च तथा शल्यः प्रतापवान्।\nवैराग्नेरादिकर्तासौ शकुनिः सौबलो हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2068617, "chapter_id": 2439, "verse_number": "९-५७-३५", "content_sanskrit": "प्रातिकामी तथा पापो द्रौपद्याः क्लेशकृद्धतः।\nभ्रातरस्ते हताः सर्वे शूरा विक्रान्तयोधिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2068618, "chapter_id": 2439, "verse_number": "९-५७-३६", "content_sanskrit": "एते चान्ये च बहवो निहतास्त्वत्कृते नृपाः।\nत्वामद्य निहनिष्यामि गदया नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2068619, "chapter_id": 2439, "verse_number": "९-५७-३७", "content_sanskrit": "इत्येवमुच्चै राजानं भाषमाणं वृकोदरम्।\nउवाच गतभी राजन्पुत्रस्ते सत्यविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2068620, "chapter_id": 2439, "verse_number": "९-५७-३८", "content_sanskrit": "किं कत्थनेन बहुना युध्यस्वेह वृकोदर।\nअद्य तेऽहं विनेष्यामि युद्धश्रद्धां कुलाधम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2068621, "chapter_id": 2439, "verse_number": "९-५७-३९", "content_sanskrit": "इति दुर्यार्धेनोऽक्षुद्रस्त्वया क्षुद्रबलेन वै।\nशक्यस्रासयितुं वाचा न चान्यः प्राकृतो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2068622, "chapter_id": 2439, "verse_number": "९-५७-४०", "content_sanskrit": "चिरकालेप्सितं दिष्ट्या हृदयस्थमिदं मम।\nत्वया सह गदायुद्धं त्रिदशैरुपपादितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2068623, "chapter_id": 2439, "verse_number": "९-५७-४१", "content_sanskrit": "किं वाचा बहुनोक्तेन कत्थितेन च दुर्मते।\nवाणी सङ्कोच्यतामेषा कर्मणा मा चिरं कृथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2068624, "chapter_id": 2439, "verse_number": "९-५७-४२", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा सर्व एवाभ्यपूजयन्।\nराजानः सोमकाश्चैव ये तत्रासन्समागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2068625, "chapter_id": 2439, "verse_number": "९-५७-४३", "content_sanskrit": "ततः सम्पूजितः सर्वैः सम्प्रहृष्टतनूरुहः।\nभूयो धीरां मतिं चक्रे युद्धाय कुरुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2068626, "chapter_id": 2439, "verse_number": "९-५७-४४", "content_sanskrit": "तं मत्तमिव मातङ्गं तलशब्दैर्नराधिपाः।\nभूयः संहर्षयांचक्रुर्दुर्योधनममर्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2068627, "chapter_id": 2439, "verse_number": "९-५७-४५", "content_sanskrit": "तं महात्मा महात्मानं गदामुद्यम्य पाण्डवः।\nअभिदुद्राव वेगेन धार्तराष्ट्रं वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2068628, "chapter_id": 2439, "verse_number": "९-५७-४६", "content_sanskrit": "बृंहन्ति कुञ्चरास्तत्र हया हेषन्ति चासकृत्।\nशस्त्राणि चाप्यदीप्यन्त पाण्डवानां जयैषिणां ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2068629, "chapter_id": 2439, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि कदायुद्धपर्वणि सप्तपञ्चाशत्तमोऽध्यायः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]