[{"id": 5000492000, "chapter_id": 9492, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे पञ्चाशीतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000492001, "chapter_id": 9492, "verse_number": "६-८५-१", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा राघवः शोककर्शितः।\nनोपधारयते व्यक्तं यदुक्तं तेन रक्षसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000492002, "chapter_id": 9492, "verse_number": "६-८५-२", "content_sanskrit": "ततो धैर्यमवष्टभ्य रामः परपुरंजयः।\nविभीषणमुपासीनमुवाच कपिसंनिधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000492003, "chapter_id": 9492, "verse_number": "६-८५-३", "content_sanskrit": "नैर्ऋताधिपते वाक्यं यदुक्तं ते विभीषण।\nभूयस्तच्छ्रोतुमिच्छामि ब्रूहि यत्ते विवक्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000492004, "chapter_id": 9492, "verse_number": "६-८५-४", "content_sanskrit": "राघवस्य वचः श्रुत्वा वाक्यं वाक्यविशारदः।\nयत् तत् पुनरिदं वाक्यं बभाषेऽथ विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000492005, "chapter_id": 9492, "verse_number": "६-८५-५", "content_sanskrit": "यथाऽऽज्ञप्तं महाबाहो त्वया गुल्मनिवेशनम्।\nतत् तथानुष्ठितं वीर त्वद्वाक्यसमनन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000492006, "chapter_id": 9492, "verse_number": "६-८५-६", "content_sanskrit": "तान्यनीकानि सर्वाणि विभक्तानि समन्ततः।\nविन्यस्ता यूथपाश्चैव यथान्यायं विभागशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000492007, "chapter_id": 9492, "verse_number": "६-८५-७", "content_sanskrit": "भूयस्तु मम विज्ञाप्यं तच्छृणुष्व महाप्रभो।\nत्वय्यकारणसंतप्ते संतप्तहृदया वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000492008, "chapter_id": 9492, "verse_number": "६-८५-८", "content_sanskrit": "त्यज राजन्निमं शोकं मिथ्या संतापमागतम्।\nयदियं त्यज्यतां चिन्ता शत्रुहर्षविवर्धिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000492009, "chapter_id": 9492, "verse_number": "६-८५-९", "content_sanskrit": "उद्यमः क्रियतां वीर हर्षः समुपसेव्यताम्।\nप्राप्तव्या यदि ते सीता हन्तव्याश्च निशाचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000492010, "chapter_id": 9492, "verse_number": "६-८५-१०", "content_sanskrit": "रघुनन्दन वक्ष्यामि श्रूयतां मे हितं वचः।\nसाध्वयं यातु सौमित्रिर्बलेन महता वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000492011, "chapter_id": 9492, "verse_number": "६-८५-११", "content_sanskrit": "निकुम्भिलायां सम्प्राप्तं हन्तुं रावणिमाहवे।\nधनुर्मण्डलनिर्मुक्तैराशीविषविषोपमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000492012, "chapter_id": 9492, "verse_number": "६-८५-१२", "content_sanskrit": "शरैर्हन्तुं महेष्वासो रावणिं समितिंजयः।\nतेन वीरेण तपसा वरदानात् स्वयंभुवः।\nअस्त्रं ब्रह्मशिरः प्राप्तं कामगाश्च तुरङ्गमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000492013, "chapter_id": 9492, "verse_number": "६-८५-१३", "content_sanskrit": "स एष किल सैन्येन प्राप्तः किल निकुम्भिलाम्।\nयद्युत्तिष्ठेत् कृतं कर्म हतान् सर्वांश्च विद्धि नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000492014, "chapter_id": 9492, "verse_number": "६-८५-१४", "content_sanskrit": "निकुम्भिलामसम्प्राप्तमकृताग्निं च यो रिपुः।\nत्वामाततायिनं हन्यादिन्द्रशत्रो स ते वधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000492015, "chapter_id": 9492, "verse_number": "६-८५-१५", "content_sanskrit": "वरो दत्तो महाबाहो सर्वलोकेश्वरेण वै।\nइत्येवं विहितो राजन् वधस्तस्यैष धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000492016, "chapter_id": 9492, "verse_number": "६-८५-१६", "content_sanskrit": "वधायेन्द्रजितो राम संदिशस्व महाबलम्।\nहते तस्मिन् हतं विद्धि रावणं ससुहृद‍्गणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000492017, "chapter_id": 9492, "verse_number": "६-८५-१७", "content_sanskrit": "विभीषणवचः श्रुत्वा रामो वाक्यमथाब्रवीत्।\nजानामि तस्य रौद्रस्य मायां सत्यपराक्रम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000492018, "chapter_id": 9492, "verse_number": "६-८५-१८", "content_sanskrit": "स हि ब्रह्मास्त्रवित् प्राज्ञो महामायो महाबलः।\nकरोत्यसंज्ञान् संग्रामे देवान् सवरुणानपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000492019, "chapter_id": 9492, "verse_number": "६-८५-१९", "content_sanskrit": "तस्यान्तरिक्षे चरतः सरथस्य महायशः।\nन गतिर्ज्ञायते वीर सूर्यस्येवाभ्रसम्प्लवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000492020, "chapter_id": 9492, "verse_number": "६-८५-२०", "content_sanskrit": "राघवस्तु रिपोर्ज्ञात्वा मायावीर्यं दुरात्मनः।\nलक्ष्मणं कीर्तिसम्पन्नमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000492021, "chapter_id": 9492, "verse_number": "६-८५-२१", "content_sanskrit": "यद् वानरेन्द्रस्य बलं तेन सर्वेण संवृतः।\nहनूमत्प्रमुखैश्चैव यूथपैः सह लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000492022, "chapter_id": 9492, "verse_number": "६-८५-२२", "content_sanskrit": "जाम्बवेनर्क्षपतिना सह सैन्येन संवृतः।\nजहि तं राक्षससुतं मायाबलसमन्वितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000492023, "chapter_id": 9492, "verse_number": "६-८५-२३", "content_sanskrit": "अयं त्वां सचिवैः सार्धं महात्मा रजनीचरः।\nअभिज्ञस्तस्य मायानां पृष्ठतोऽनुगमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000492024, "chapter_id": 9492, "verse_number": "६-८५-२४", "content_sanskrit": "राघवस्य वचः श्रुत्वा लक्ष्मणः सविभीषणः।\nजग्राह कार्मुकश्रेष्ठमन्यद् भीमपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000492025, "chapter_id": 9492, "verse_number": "६-८५-२५", "content_sanskrit": "संनद्धः कवची खड्गी सशरी वामचापभृत्।\nरामपादावुपस्पृश्य हृष्टः सौमित्रिरब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000492026, "chapter_id": 9492, "verse_number": "६-८५-२६", "content_sanskrit": "अद्य मत्कार्मुकोन्मुक्ताः शरा निर्भिद्य रावणिम्।\nलङ्कामभिपतिष्यन्ति हंसाः पुष्करिणीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000492027, "chapter_id": 9492, "verse_number": "६-८५-२७", "content_sanskrit": "अद्यैव तस्य रौद्रस्य शरीरं मामकाः शराः।\nविधमिष्यन्ति भित्त्वा तं महाचापगुणच्युताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000492028, "chapter_id": 9492, "verse_number": "६-८५-२८", "content_sanskrit": "एवमुक्त्वा तु वचनं द्युतिमान् भ्रातुरग्रतः।\nस रावणिवधाकांक्षी लक्ष्मणस्त्वरितं ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000492029, "chapter_id": 9492, "verse_number": "६-८५-२९", "content_sanskrit": "सोऽभिवाद्य गुरोः पादौ कृत्वा चापि प्रदक्षिणम्।\nनिकुम्भिलामभिययौ चैत्यं रावणिपालितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000492030, "chapter_id": 9492, "verse_number": "६-८५-३०", "content_sanskrit": "विभीषणेन सहितो राजपुत्रः प्रतापवान्।\nकृतस्वस्त्ययनो भ्रात्रा लक्ष्मणस्त्वरितो ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000492031, "chapter_id": 9492, "verse_number": "६-८५-३१", "content_sanskrit": "वानराणां सहस्रैस्तु हनूमान् बहुभिर्वृतः।\nविभीषणश्च सामात्यो लक्ष्मणं त्वरितं ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000492032, "chapter_id": 9492, "verse_number": "६-८५-३२", "content_sanskrit": "महता हरिसैन्येन सवेगमभिसंवृतः।\nऋक्षराजबलं चैव ददर्श पथि विष्ठितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000492033, "chapter_id": 9492, "verse_number": "६-८५-३३", "content_sanskrit": "स गत्वा दूरमध्वानं सौमित्रिर्मित्रनन्दनः।\nराक्षसेन्द्रबलं दूरादपश्यद् व्यूहमाश्रितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000492034, "chapter_id": 9492, "verse_number": "६-८५-३४", "content_sanskrit": "स सम्प्राप्य धनुष्पाणिर्मायायोगमरिंदमः।\nतस्थौ ब्रह्मविधानेन विजेतुं रघुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000492035, "chapter_id": 9492, "verse_number": "६-८५-३५", "content_sanskrit": "विभीषणेन सहितो राजपुत्रः प्रतापवान्।\nअङ्गदेन च वीरेण तथानिलसुतेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000492036, "chapter_id": 9492, "verse_number": "६-८५-३६", "content_sanskrit": "विविधममलशस्त्रभास्वरं तद्\nध्वजगहनं गहनं महारथैश्च।\nप्रतिभयतममप्रमेयवेगं\nतिमिरमिव द्विषतां बलं विवेश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000492037, "chapter_id": 9492, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे पञ्चाशीतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]