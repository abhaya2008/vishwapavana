[{"id": 2032823, "chapter_id": 1709, "verse_number": "४-३२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2032824, "chapter_id": 1709, "verse_number": "४-३२-१", "content_sanskrit": "ततः शारद्वतो वाक्यमित्युवाच कृतस्तदा।\nयुक्तं प्राप्तं च वृद्धेन पाण्डवान्प्रति भापितम् ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2032825, "chapter_id": 1709, "verse_number": "४-३२-२", "content_sanskrit": "धर्मार्थसहितं श्लक्ष्णं सर्वं सत्यं सहेतुकम्।\nतत्रानुरूपं भीष्मस्य ममापि वचनं शृणु ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2032826, "chapter_id": 1709, "verse_number": "४-३२-३", "content_sanskrit": "तेषां चैव गतिस्तत्र र्निवासश्चानुचिन्त्यताम् ।\nनीतिर्विधीयतां तत्र सांप्रतं या हिता भवेत् ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2032827, "chapter_id": 1709, "verse_number": "४-३२-४", "content_sanskrit": "नावज्ञेयो रिपुस्तात प्राकृतोऽपि बुभूषता।\nकिं पुनः पाण्डवाः शूरा विद्वांसो बलिनस्तथा ॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2032828, "chapter_id": 1709, "verse_number": "४-३२-५", "content_sanskrit": "तस्मात्सत्रं प्रविष्टेषु पाण्डवेषु महात्मसु ।\nगूढभावेषु छन्नेषु काले चोदयमागते ॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2032829, "chapter_id": 1709, "verse_number": "४-३२-६", "content_sanskrit": "स्वराष्ट्रे परराष्ट्रे च ज्ञातव्यं बलमात्मनः ।\nउदयः पाण्डवानां च प्राप्तकालो न संशयः ॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2032830, "chapter_id": 1709, "verse_number": "४-३२-७", "content_sanskrit": "निवृत्तसमयाः पार्था महात्मानो महाबलाः ।\nमहोत्साहा भविष्यन्ति पाण्डवा ह्यमितौजसः ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2032831, "chapter_id": 1709, "verse_number": "४-३२-८", "content_sanskrit": "तस्माद्बलं च कोशं च नातिश्चापि विधीयताम्।\nयथा कालोदये प्राप्ते सम्यक् तैः संदधामहे ॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2032832, "chapter_id": 1709, "verse_number": "४-३२-९", "content_sanskrit": "यत्र यन्मन्यसे श्रेयो बुध्यस्व बलमात्मनः ।\nनियतं सर्वमित्रेषु बलवत्स्वबलेषु च ॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2032833, "chapter_id": 1709, "verse_number": "४-३२-१०", "content_sanskrit": "सारं फल्गु बलं ज्ञात्वा मध्यस्थं चापि भारत ।\nस्वराष्ट्रपरराष्ट्रेषु ज्ञातव्यं बलमात्मनः ॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2032834, "chapter_id": 1709, "verse_number": "४-३२-११", "content_sanskrit": "अप्रहृशष्टं प्राहृष्टं वा संदधाम तथा परैः ।\nसाम्ना दानेन भेदेन दण्डेन बलिकर्मणा ॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2032835, "chapter_id": 1709, "verse_number": "४-३२-१२", "content_sanskrit": "न्यायेनाक्रम्य च परान्बलाच्चानम्य दुर्बलान् ।\nसान्त्वयित्वा च मित्राणि बलं चाभाष्यतां सुखम् ॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2032836, "chapter_id": 1709, "verse_number": "४-३२-१३", "content_sanskrit": "स्वकोशबलसंवृद्धः सम्यक्सिद्धिमवाप्स्यसि ।\nयोत्स्यसे चापि बलिभिररिभिः प्रत्युपस्थितैः।\nअन्यैस्त्वं पाण्डवैर्वाऽपि हीनैः स्वबलवाहनैः ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2032837, "chapter_id": 1709, "verse_number": "४-३२-१४", "content_sanskrit": "एवं सर्वं विनिश्चित्य व्यवहर्तासि न्यायतः।\nयथाकालं मनुष्येन्द्र चिरं सुखमवाप्स्यसि ॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2032838, "chapter_id": 1709, "verse_number": "४-३२-१५", "content_sanskrit": "भीष्माद्रोणकृपैरुक्ते कर्णदुःशासनादिभिः।\nततो दुर्योधनो वाक्यं श्रुत्वा तेषां महात्मनाम् ।\nमुहूर्तमनुसंचिन्त्य सचिवानिदमब्रवीत् ॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2032839, "chapter_id": 1709, "verse_number": "४-३२-१६", "content_sanskrit": "श्रुतमेतन्मया पूर्वं कथासु जनसंसदि।\nधीराणां शास्त्रविदुषां प्राज्ञानां मतिनिश्चये ।\nकृतिनां सारफल्गुत्वे जानामि नयचक्षुषा ॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2032840, "chapter_id": 1709, "verse_number": "४-३२-१७", "content_sanskrit": "सत्वे बाहुबले धैर्ये प्राणे शारीरसंभवे।\nसांप्रतं मानुषे लोके सदैत्यनरराक्षसे ॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2032841, "chapter_id": 1709, "verse_number": "४-३२-१८", "content_sanskrit": "चत्वारस्तु नरव्याघ्रा बले शक्रोपमा भुवि।\nउत्तमाः प्राणिनां तेषां नास्ति कश्चिद्बले ममः ॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2032842, "chapter_id": 1709, "verse_number": "४-३२-१९", "content_sanskrit": "बलदेवश्च भीमश्च मद्रराजश्च वीर्यवान् ।\nचतुर्थः कीचकस्तेषां पञ्चमं नानुशुश्रुमः ॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2032843, "chapter_id": 1709, "verse_number": "४-३२-२०", "content_sanskrit": "अन्योन्यानन्तरबलाः परस्परजयैपिणः।\nबाहूयुद्धमभीप्सन्तो नित्यं संरब्धमानसाः ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2032844, "chapter_id": 1709, "verse_number": "४-३२-२१", "content_sanskrit": "तेनाहमवगच्छामि प्रत्ययेन वृकोदरम्।\nमनस्यभिनिविष्टं मे व्यक्तं जीवन्ति पाण्डवाः ॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2032845, "chapter_id": 1709, "verse_number": "४-३२-२२", "content_sanskrit": "तत्राहं कीचकं मन्ये भीमसेनेन मारितम्।\nसैरन्ध्रीं द्रौपदीं मन्ये नात्र कार्या विचारणा ॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2032846, "chapter_id": 1709, "verse_number": "४-३२-२३", "content_sanskrit": "शङ्के कृष्णानिमित्तं तु भीमसेनेन कीचकः।\nगन्धर्वव्यपदेशेन हतो निशि महाबलः ॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2032847, "chapter_id": 1709, "verse_number": "४-३२-२४", "content_sanskrit": "को हि शक्तः परो भीमात्कीचकं हन्तुमोजसा ।\nशस्त्रं विना बाहुबलात्तथा सर्वाङ्गचूर्णने ॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2032848, "chapter_id": 1709, "verse_number": "४-३२-२५", "content_sanskrit": "मर्दितुं वा तथा तीव्रं चर्ममांसास्थिचूर्णनम् ।\nरूपमन्यत्समास्थाय भीमस्यैतद्विचेष्टितम् ॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2032849, "chapter_id": 1709, "verse_number": "४-३२-२६", "content_sanskrit": "ध्रुवं कृष्णानिमित्तं तु भीमसेनेन सूतजाः ।\nगन्धर्वव्यपदेशेन हता निशि न संशयः ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2032850, "chapter_id": 1709, "verse_number": "४-३२-२७", "content_sanskrit": "पितामहेन ये चोक्ता देशस्य च जनस्य च।\nगुणास्ते मत्स्यराष्ट्रेषु बहुशोऽपि मया श्रुताः ॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2032851, "chapter_id": 1709, "verse_number": "४-३२-२८", "content_sanskrit": "विराटनगरे मन्ये पाण्डवाश्छन्नचारिणः।\nनिवसन्ति पुरे रम्ये तत्र यात्रा विधीयताम् ॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2032852, "chapter_id": 1709, "verse_number": "४-३२-२९", "content_sanskrit": "मत्स्यराष्ट्रं गमिष्यामो ग्रहीष्यामश्च गोधनम्।\nगृहीते गोधने नूनं तेऽपि योत्स्यन्ति पाण्डवाः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2032853, "chapter_id": 1709, "verse_number": "४-३२-३०", "content_sanskrit": "अपूर्णे समये चापि यदि पश्येम पाण्डवान्।\nद्वादशान्यानि वर्षाणि प्रवेक्ष्यन्ति पुनर्वनम् ॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2032854, "chapter_id": 1709, "verse_number": "४-३२-३१", "content_sanskrit": "तस्मादन्यतरेणापि लाभोऽस्माकं भविष्यति।\nकोशवृद्धिरिहास्माकं शत्रूणां निधनं भवेत् ॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2032855, "chapter_id": 1709, "verse_number": "४-३२-३२", "content_sanskrit": "कथं सुयोधनं गच्छेद्युधिष्ठिरभृतः पुरा।\nएतच्चापि वदत्येष मात्स्यः परिभवान्मयि ॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2032856, "chapter_id": 1709, "verse_number": "४-३२-३३", "content_sanskrit": "तस्मात्कर्तव्यमेतद्वै तत्र यात्रा विधीयताम्।\nएतत्सुनीतं मन्येऽहं सर्वेषां यदि रोचते ॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2032857, "chapter_id": 1709, "verse_number": "४-३२-३४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2032858, "chapter_id": 1709, "verse_number": "४-३२-३४", "content_sanskrit": "ततो राजा त्रिगर्तानां सुशर्मा रथयूथपः।\nपूर्वमाभाष्य कर्णेन तथा दुःशासनेन च।\nप्राप्तकालमिदं वाक्यमुवाच त्वरितो बली ॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2032859, "chapter_id": 1709, "verse_number": "४-३२-३५", "content_sanskrit": "असकृन्निकृतः पूर्वं मात्स्यसाल्वेयकेकयैः ।\nसूतेनैव च मात्स्यस्य कीचकेन पुनः पुनः ॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2032860, "chapter_id": 1709, "verse_number": "४-३२-३६", "content_sanskrit": "बाधितो बन्धुभिः सार्धं बलाद्बलवता विभो।\nस कर्णमभिवीक्ष्याथ दुर्योधनमभाषत ॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2032861, "chapter_id": 1709, "verse_number": "४-३२-३७", "content_sanskrit": "राष्ट्रं ममासकृद्राजन्राज्ञा मात्स्येन बाधितम् ॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2032862, "chapter_id": 1709, "verse_number": "४-३२-३८", "content_sanskrit": "प्रणेता कीचकस्तस्य बलोत्सिक्तोऽभवन्पुरा।\nअमर्षी दुर्जयो जेता प्रख्यातबलपौरुषः ।\nस हतस्तत्र गन्धर्वैः पापकर्मा नृशंसकृत् ॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2032863, "chapter_id": 1709, "verse_number": "४-३२-३९", "content_sanskrit": "तस्मिन्विनिहते राजन्हीनदर्पो निराश्रयः।\nभविष्यति निरुत्साहो विराट इति मे मतिः ॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2032864, "chapter_id": 1709, "verse_number": "४-३२-४०", "content_sanskrit": "तत्र यात्रा मम मता यदि ते रोचतेऽनघ।\nकौरवाणां च सर्वेषां कर्णस्य च महात्मनः ॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2032865, "chapter_id": 1709, "verse_number": "४-३२-४१", "content_sanskrit": "एतत्कार्यमहं मन्ये परमात्ययिकं महत्।\nराष्ट्रं तस्याभियास्यामो धनधान्यसमाकुलम् ॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2032866, "chapter_id": 1709, "verse_number": "४-३२-४२", "content_sanskrit": "आददामोऽस्य रत्नानि विविधानि वसूनि च।\nग्रामान्राष्ट्राणि वा तस्य हरिष्यामो विभागशः ॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2032867, "chapter_id": 1709, "verse_number": "४-३२-४३", "content_sanskrit": "अथवा गोसहस्राणि बहूनि शुभदर्शन।\nविविधानि हरिष्यामः प्रतीपीड्य पुरं बलात् ॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2032868, "chapter_id": 1709, "verse_number": "४-३२-४४", "content_sanskrit": "कौरवैः सह संगमय त्रिगर्तैश्च विशांपते।\nगास्तस्यापहरिष्यामः सह सर्वैर्महारथैः ॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2032869, "chapter_id": 1709, "verse_number": "४-३२-४५", "content_sanskrit": "सन्धिं वा तेन कृत्वा तु निबध्नीमोऽस्य पौरुषम्।\nहत्वा चास्य चमूं कृत्स्नां वशमेवानयामहे ॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2032870, "chapter_id": 1709, "verse_number": "४-३२-४६", "content_sanskrit": "तं वशे न्यायतः कृत्वा सुखं वत्स्यामहे वयम्।\nभवतां बलवृद्धिश्च भविष्यति न संशयः ॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2032871, "chapter_id": 1709, "verse_number": "४-३२-४७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2032872, "chapter_id": 1709, "verse_number": "४-३२-४७", "content_sanskrit": "तच्छ्रुत्वा वचनं तस्य कर्णो राजानमब्रवीत् ॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2032873, "chapter_id": 1709, "verse_number": "४-३२-४८", "content_sanskrit": "सूक्तं सुशर्मणा वाक्यं प्राप्तकालमिदं वचः।\nतस्मात्क्षिप्रं विनिर्यामो योजयित्वा वरूथिनीं ॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2032874, "chapter_id": 1709, "verse_number": "४-३२-४९", "content_sanskrit": "यदेतत्तेऽभिरुचितं मम चैतद्धि रोचते।\nप्रविभज्य च सैन्यानि यथा वा मन्यते भवान् ॥ ४९ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2032875, "chapter_id": 1709, "verse_number": "४-३२-५०", "content_sanskrit": "प्रज्ञावान्कुलवृद्धश्च सर्वेषां नः पितामहः।\nआचार्यश्च कृपो विद्वाञ्शकुनिश्चापि सौबलः ॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2032876, "chapter_id": 1709, "verse_number": "४-३२-५१", "content_sanskrit": "मन्यन्ते ते यथा सर्वे तथा यात्रा विधीयताम्।\nसंमन्त्र्य चाशु गच्छामः साधनार्थं महीपते ॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2032877, "chapter_id": 1709, "verse_number": "४-३२-५२", "content_sanskrit": "किंनु नः पाण्डवैः कार्यं हीनार्थबलपौरुषैः।\nअत्यन्तं हि प्रनष्टास्ते प्राप्ता वाऽपि यमक्षयम् ॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2032878, "chapter_id": 1709, "verse_number": "४-३२-५३", "content_sanskrit": "तद्भवांश्चतुरङ्गेण बलेन महता वृतः।\nविराटनगरं यातु सर्वसैन्येन भारत।\nआदास्यामोऽथ गास्तस्य विविधानि वसूनि च ॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2032879, "chapter_id": 1709, "verse_number": "४-३२-५४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2032880, "chapter_id": 1709, "verse_number": "४-३२-५४", "content_sanskrit": "ततो दुर्योधनो राजा वचः श्रुत्वा तु तस्य तत्।\nवैकर्तनस्य कर्णस्य क्षिप्रमाज्ञापयत्स्वयम्।\nशासने नित्ययुक्तं तु दुःशासनमनन्तरम् ॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2032881, "chapter_id": 1709, "verse_number": "४-३२-५५x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2032882, "chapter_id": 1709, "verse_number": "४-३२-५५", "content_sanskrit": "सह वृद्धैस्तु संमन्त्र्य क्षिप्रं योजय वाहिनीम्।\nयथोद्देशं तु गच्छामः सहिताः सर्वकौरवैः ॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2032883, "chapter_id": 1709, "verse_number": "४-३२-५६", "content_sanskrit": "सुशर्मा तु यथोद्दिष्टं देशं यातु महारथः।\nत्रिगर्तैः सहितः सर्वैः प्रख्यातबलपौरुषैः।\nप्रागेव हि सुसंयत्तो विराटनगरं प्रति ॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2032884, "chapter_id": 1709, "verse_number": "४-३२-५७", "content_sanskrit": "जघन्यतो वयं तत्र यास्यामो दिवसान्तरे।\nविषयं मत्स्यराजस्य सुसमृद्धं सुसंहितम् ॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2032885, "chapter_id": 1709, "verse_number": "४-३२-५८", "content_sanskrit": "सुशर्मणा गृहीते तु मत्स्यराजस्य गोधने।\nविराटः सैन्यमादाय त्रिगर्तैः सह योत्स्यति ॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2032886, "chapter_id": 1709, "verse_number": "४-३२-५९", "content_sanskrit": "अपरं दिवसं गास्तु तत्र गृह्णन्तु कौरवाः।\nगवार्थे पाण्डवास्तत्र योत्स्यन्ति कुरुभिः सह ॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2032887, "chapter_id": 1709, "verse_number": "४-३२-६०", "content_sanskrit": "तथा गत्वा यथोद्देशं विराटनगरान्तिके।\nक्षिप्रं गोष्ठं समासाद्य गृह्णन्तु विपुलं धनम् ॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2032888, "chapter_id": 1709, "verse_number": "४-३२-६१", "content_sanskrit": "गवां शतसहस्राणि श्रीमन्ति गुणवन्ति च।\nवयमस्य निगृह्णीमो द्विधा कृत्वा च वाहिनीम् ॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2032889, "chapter_id": 1709, "verse_number": "४-३२-६२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2032890, "chapter_id": 1709, "verse_number": "४-३२-६२", "content_sanskrit": "ते स्म गत्वा यथोद्दिष्टं देशं मत्स्यमहीपतेः।\nसंनद्धा रथिनः सर्वे सपताका बलोत्कटाः।\nप्रतिवैरं चिकीर्षन्तो गोषु गृद्धा महाबलाः ॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2032891, "chapter_id": 1709, "verse_number": "४-३२-६३", "content_sanskrit": "आदत्त गाः सुशर्माऽथ कृष्णपक्षस्य चाष्टमीम् ॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2032892, "chapter_id": 1709, "verse_number": "४-३२-६४", "content_sanskrit": "अपरे दिवसे सर्वे राजन्संभूय कौरवाः।\nनवम्यां ते न्यगृह्णन्त गोकुलानि सहस्रशः।\nकौरवास्तु महावीर्या मत्स्यानां विषयान्तरे ॥ ६४ ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2032893, "chapter_id": 1709, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि द्वात्रिंशोऽध्यायः ॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]