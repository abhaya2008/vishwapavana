[{"id": 6000141000, "chapter_id": 10141, "verse_number": null, "content_sanskrit": "अथ तृतीयाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "वरं दातुमागतं ब्रह्माणं प्रति हिरण्यकशिपुना वरयाचनं", "range": null}]}, {"id": 6000141001, "chapter_id": 10141, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.001.m4a", "display_order": 2}, {"id": 6000141002, "chapter_id": 10141, "verse_number": "७-३-१", "content_sanskrit": "हिरण्यकशिपू राजन्नजेयमजरामरम्।\nआत्मानमप्रतिद्वन्द्वमेकराजं व्यधित्सत॥ ७/३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.002.m4a", "display_order": 3, "topics": [{"text": "हिरण्यकशिपुना ब्रह्माणमुद्दिश्य तपश्चरणम्", "range": "१–१५"}]}, {"id": 6000141003, "chapter_id": 10141, "verse_number": "७-३-२", "content_sanskrit": "स तेपे मन्दरद्रोण्यां तपः परमदारुणम्।\nऊर्ध्वबाहुर्नभोदृष्टिः पादाङ्गुष्ठाश्रितावनिः॥ ७/३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.003.m4a", "display_order": 4}, {"id": 6000141004, "chapter_id": 10141, "verse_number": "७-३-३", "content_sanskrit": "जटादीधितिभी रेजे संवर्तार्क इवांशुभिः।\nतस्मिंस्तपस्तप्यमाने देवाः स्थानानि भेजिरे॥ ७/३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.004.m4a", "display_order": 5}, {"id": 6000141005, "chapter_id": 10141, "verse_number": "७-३-४", "content_sanskrit": "तस्य मूर्ध्नः समुद्भूतः सधूम्रोऽग्निस्तपोमयः।\nतिर्यगूर्ध्वमधोलोकानतपद् विष्वगीरितः॥ ७/३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.005.m4a", "display_order": 6}, {"id": 6000141006, "chapter_id": 10141, "verse_number": "७-३-५", "content_sanskrit": "चुक्षुभुर्नद्युदन्वन्तः सद्वीपाद्रिश्चचाल भूः।\nनिपेतुः सग्रहास्तारा जज्वलुश्च दिशो दश॥ ७/३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.006.m4a", "display_order": 7}, {"id": 6000141007, "chapter_id": 10141, "verse_number": "७-३-६", "content_sanskrit": "तेन तप्ता दिवं त्यक्त्वा ब्रह्मलोकं ययुः सुराः।\nधात्रे विज्ञापयामासुर्देवदेव जगत्पते॥ ७/३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.007.m4a", "display_order": 8}, {"id": 6000141008, "chapter_id": 10141, "verse_number": "७-३-७", "content_sanskrit": "दैत्येन्द्रतपसा तप्ता दिवि स्थातुं न शक्नुमः।\nतस्य चोपशमं ब्रह्मन् विधेहि यदि मन्यसे॥ ७/३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.008.m4a", "display_order": 9}, {"id": 6000141009, "chapter_id": 10141, "verse_number": "७-३-८", "content_sanskrit": "लोका न यावन्नङ्क्षयन्ति बलिहारास्तव प्रभो।\nतस्यायं किल सङ्कल्पश्चरतो दुश्चरं तपः॥ ७/३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.009.m4a", "display_order": 10}, {"id": 6000141010, "chapter_id": 10141, "verse_number": null, "content_sanskrit": "श्रूयतां किं न विदितं तवापि विनिवेद्यते।\nसृष्ट्वा चराचरमिदं तपोयोगसमाधिना॥ ७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.010.m4a", "display_order": 11}, {"id": 6000141011, "chapter_id": 10141, "verse_number": "७-३-९", "content_sanskrit": "अध्यास्ते सर्वधिष्ण्येभ्यः परमेष्ठी निजासनम्॥ ७/३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.011.m4a", "display_order": 12}, {"id": 6000141012, "chapter_id": 10141, "verse_number": "७-३-१०", "content_sanskrit": "तदहं वर्धमानेन तपोयज्ञसमाधिना।\nकालात्मनोश्च नित्यत्वात् साधयिष्ये तथाऽऽत्मनः॥ ७/३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.012.m4a", "display_order": 13}, {"id": 6000141013, "chapter_id": 10141, "verse_number": "७-३-११", "content_sanskrit": "अन्यथेदं विधास्येऽहमयथापूर्वमोजसा।\nकिमन्यैः कालनिर्धूतैः कल्पान्तैर्वैष्णवादिभिः॥ ७/३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.013.m4a", "display_order": 14}, {"id": 6000141014, "chapter_id": 10141, "verse_number": "७-३-१२", "content_sanskrit": "इति शुश्रुम निर्बन्धं तपः परममास्थितः।\nविधत्स्वानन्तरं युक्तं स्वयं त्रिभुवनेश्वर॥ ७/३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.014.m4a", "display_order": 15}, {"id": 6000141015, "chapter_id": 10141, "verse_number": "७-३-१३", "content_sanskrit": "तवासनं हि जगतां पारमेष्ठ्यं जगत्पते।\nभवाय श्रेयसे भूत्यै क्षेमाय विजयाय च॥ ७/३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.015.m4a", "display_order": 16}, {"id": 6000141016, "chapter_id": 10141, "verse_number": "७-३-१४", "content_sanskrit": "इति विज्ञापितो देवैर्भगवानात्मभूर्नृप।\nपरीतो भृगुदक्षाद्यैर्ययौ दैत्येश्वराश्रमम्॥ ७/३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.016.m4a", "display_order": 17}, {"id": 6000141017, "chapter_id": 10141, "verse_number": "७-३-१५", "content_sanskrit": "तं ददर्श प्रतिच्छन्नं वल्मीकतृणकीचकैः।\nपिपीलिकाभिराकीर्णं मेदस्त्वङ्मांसशोणितम्॥ ७/३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.017.m4a", "display_order": 18}, {"id": 6000141018, "chapter_id": 10141, "verse_number": "७-३-१६", "content_sanskrit": "तपन्तं तपसा लोकान् यथा भाविततं रविम्।\nविलक्ष्य विस्मितः प्राह हसंस्तं हंसवाहनः॥ ७/३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.018.m4a", "display_order": 19, "topics": [{"text": "ब्रह्मणा वरदानं च", "range": "१५–३८"}]}, {"id": 6000141019, "chapter_id": 10141, "verse_number": null, "content_sanskrit": "ब्रह्मोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.019.m4a", "display_order": 20}, {"id": 6000141020, "chapter_id": 10141, "verse_number": "७-३-१७", "content_sanskrit": "उत्तिष्ठोत्तिष्ठ भद्रं ते तपः सिद्धोऽसि काश्यप।\nवरदोऽहमनुप्राप्तो व्रियतामीप्सितो वरः॥ ७/३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.020.m4a", "display_order": 21}, {"id": 6000141021, "chapter_id": 10141, "verse_number": "७-३-१८", "content_sanskrit": "अद्राक्षमहमेतत् ते हृत्सारं महदद्भुतम्।\nदंशभक्षितदेहस्य प्राणा ह्यस्थिषु शेरते॥ ७/३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.021.m4a", "display_order": 22}, {"id": 6000141022, "chapter_id": 10141, "verse_number": "७-३-१९", "content_sanskrit": "नैतत् पूर्वर्षयश्चक्रुर्न करिष्यन्ति चापरे।\nनिरम्बुर्धारयेत् प्राणान् को वै दिव्यसमाः शतम्॥ ७/३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.022.m4a", "display_order": 23}, {"id": 6000141023, "chapter_id": 10141, "verse_number": "७-३-२०", "content_sanskrit": "व्यवसायेन तेऽनेन दुष्करेणामनस्विभिः।\nतपोनिष्ठेन भवता जितोऽहं दितिनन्दन॥ ७/३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.023.m4a", "display_order": 24}, {"id": 6000141024, "chapter_id": 10141, "verse_number": "७-३-२१", "content_sanskrit": "ततस्त आशिषः सर्वा ददाम्यसुरपुङ्गव।\nमर्त्यस्य ते ह्यमर्त्यस्य दर्शनं न च निष्फलम्॥ ७/३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.024.m4a", "display_order": 25}, {"id": 6000141025, "chapter_id": 10141, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.025.m4a", "display_order": 26}, {"id": 6000141026, "chapter_id": 10141, "verse_number": "७-३-२२", "content_sanskrit": "इत्युक्त्वाऽऽदिभवो देवो भक्षिताङ्गं पिपीलिकैः।\nकमण्डलुजलेनौक्षद् दिव्येनामोघराधसा॥ ७/३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.026.m4a", "display_order": 27}, {"id": 6000141027, "chapter_id": 10141, "verse_number": "७-३-२३", "content_sanskrit": "स तत्कीचकवल्मीकात् सहओजोबलान्वितः। सर्वावयवसम्पन्नो वज्रसंहननो युवा।\nउत्थितस्तप्तहेमाभो विभावसुरिवैधसः॥ ७/३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.027.m4a", "display_order": 28}, {"id": 6000141028, "chapter_id": 10141, "verse_number": "७-३-२४", "content_sanskrit": "स निरीक्ष्याम्बरे देवं हंसवाहनमास्थितम्।\nननाम शिरसा भूमौ तद्दर्शनमहोत्सवः॥ ७/३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.028.m4a", "display_order": 29}, {"id": 6000141029, "chapter_id": 10141, "verse_number": "७-३-२५", "content_sanskrit": "उत्थाय प्राञ्जलिः प्रह्व ईक्षमाणो दृशा विभुम्।\nहर्षाश्रुपुलकोद्भेदो गिरा गद्गदयाऽगृणत्॥ ७/३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.029.m4a", "display_order": 30}, {"id": 6000141030, "chapter_id": 10141, "verse_number": null, "content_sanskrit": "हिरण्यकशिपुरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.030.m4a", "display_order": 31}, {"id": 6000141031, "chapter_id": 10141, "verse_number": "७-३-२६", "content_sanskrit": "कल्पान्ते कालसृष्टेन योऽन्धेन तमसाऽऽवृतम्।\nअभिव्यनग् जगदिदं स्वयंज्योतिः स्वरोचिषा॥ ७/३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.031.m4a", "display_order": 32}, {"id": 6000141032, "chapter_id": 10141, "verse_number": "७-३-२७", "content_sanskrit": "आत्मना त्रिवृता चेदं सृजत्यवति लुम्पति।\nरजःसत्त्वतमोधाम्ने पराय महते नमः॥ ७/३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.032.m4a", "display_order": 33}, {"id": 6000141033, "chapter_id": 10141, "verse_number": "७-३-२८", "content_sanskrit": "नम आद्याय बीजाय ज्ञानविज्ञानमूर्तये।\nप्राणेन्द्रियमनोबुद्धिविकारैर्व्यक्तिमीयुषे॥ ७/३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.033.m4a", "display_order": 34}, {"id": 6000141034, "chapter_id": 10141, "verse_number": "७-३-२९", "content_sanskrit": "त्वमीशिषे जगतस्तस्थुषश्च प्राणेन मुख्येन पतिः प्रजानाम्।\nचित्तस्य चित्तिर्मनइन्द्रियाणां पतिर्महाभूतगुणाशयेशः॥ ७/३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.034.m4a", "display_order": 35}, {"id": 6000141035, "chapter_id": 10141, "verse_number": "७-३-३०", "content_sanskrit": "त्वं सप्ततन्तून् वितनोषि तन्वा त्रय्या चतुर्होत्रकविद्यया च।\nत्वमेक आत्माऽऽत्मवतामनादिरनन्तपारः कविरव्ययात्मा॥ ७/३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.035.m4a", "display_order": 36}, {"id": 6000141036, "chapter_id": 10141, "verse_number": "७-३-३१", "content_sanskrit": "त्वमेव कालोऽनिमिषो जनानामायुर्लवाद्यावयवैः क्षिणोषि।\nकूटस्थ आत्मा परमेष्ठ्यजो महान् त्वं जीवलोकस्य च जीव आत्मा॥ ७/३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.036.m4a", "display_order": 37}, {"id": 6000141037, "chapter_id": 10141, "verse_number": "७-३-३२", "content_sanskrit": "त्वत्तः परं नापरमप्यनेजदेजच्च किञ्चिद् व्यतिरिक्तमस्ति।\nविद्याकलास्ते तनवश्च सर्वा हिरण्यगर्भोऽसि बृहत् त्रिपृष्ठः॥ ७/३/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.037.m4a", "display_order": 38}, {"id": 6000141038, "chapter_id": 10141, "verse_number": "७-३-३३", "content_sanskrit": "व्यक्तं विभो स्थूलमिदं शरीरं येनेन्द्रियप्राणमनोगुणांस्त्वम्।\nभुङ्क्ते स्थितो धामनि पारमेष्ठ्ये अव्यक्त आत्मा पुरुषः पुराणः॥ ७/३/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.038.m4a", "display_order": 39}, {"id": 6000141039, "chapter_id": 10141, "verse_number": "७-३-३४", "content_sanskrit": "अनन्ताव्यक्तरूपेण येनेदमखिलं ततम्।\nचिदचिच्छक्तियुक्ताय तस्मै भगवते नमः॥ ७/३/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.039.m4a", "display_order": 40}, {"id": 6000141040, "chapter_id": 10141, "verse_number": "७-३-३५", "content_sanskrit": "यदि दास्यस्यभिमतान् वरान् मे वरदोत्तम।\nभूतेभ्यस्त्वद्विसृष्टेभ्यो मृत्युर्मा भून्मम प्रभो॥ ७/३/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.040.m4a", "display_order": 41}, {"id": 6000141041, "chapter_id": 10141, "verse_number": "७-३-३६", "content_sanskrit": "नान्तर्बहिर्दिवा नक्तमन्यस्मादपि चायुधैः।\nन भूमौ नाम्बरे मृत्युर्न नरैर्न मृगैरपि॥ ७/३/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.041.m4a", "display_order": 42}, {"id": 6000141042, "chapter_id": 10141, "verse_number": "७-३-३७", "content_sanskrit": "व्यसुभिर्वासुमद्भिर्वा सुरासुरमहोरगैः।\nअप्रतिद्वन्द्वता युद्धे ऐकपत्यं च देहिनाम्॥ ७/३/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.042.m4a", "display_order": 43}, {"id": 6000141043, "chapter_id": 10141, "verse_number": "७-३-३८", "content_sanskrit": "सर्वेषां लोकपालानां महिमानं तथाऽऽत्मनः।\nतपोयोगप्रभावेन यो न रिष्यति कर्हिचित्॥ ७/३/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_003/BhP_07.003.043.m4a", "display_order": 44}, {"id": 6000141044, "chapter_id": 10141, "verse_number": null, "content_sanskrit": "इति श्रीमद्भागवते वैयासिक्यां संहितायां सप्तमस्कन्धे तृतीयाध्यायः।\n॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]