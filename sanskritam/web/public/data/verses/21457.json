[{"id": 7001457000, "chapter_id": 21457, "verse_number": "७-१-३०-१", "content_sanskrit": "ऋषय ऊचुः ।\nचरितानि विचित्राणि गृह्याणि गहनानि च ।\nदुर्विज्ञेयानि देवैश्च मोहयंति मनांसि नः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001457001, "chapter_id": 21457, "verse_number": "७-१-३०-२", "content_sanskrit": "शिवयोस्तत्त्वसम्बन्धे न दोष उपलभ्यते ।\nचरितैः प्राकृतो भावस्तयोरपि विभाव्यते॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001457002, "chapter_id": 21457, "verse_number": "७-१-३०-३", "content_sanskrit": "ब्रह्मादयो ऽपि लोकानां सृष्टिस्थित्यन्तहेतवः ।\nनिग्रहानुग्रहौ प्राप्य शिवस्य वशवर्तिनः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001457003, "chapter_id": 21457, "verse_number": "७-१-३०-४", "content_sanskrit": "शिवः पुनर्न कस्यापि निग्रहानुग्रहास्पदम् ।\nअतो ऽनायत्तमैश्वर्यं तस्यैवेति विनिश्चितम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001457004, "chapter_id": 21457, "verse_number": "७-१-३०-५", "content_sanskrit": "यद्येवमीदृशैश्वर्यं तत्तु स्वातन्त्र्यलक्षणम् ।\nस्वभावसिद्धं चैतस्य मूर्तिमत्तास्पदं भवेत्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001457005, "chapter_id": 21457, "verse_number": "७-१-३०-६", "content_sanskrit": "न मूर्तिश्च स्वतंत्रस्य घटते मूलहेतुना ।\nमूर्तेरपि च कार्यत्वात्तत्सिद्धिः स्यादहैतुकी॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001457006, "chapter_id": 21457, "verse_number": "७-१-३०-७", "content_sanskrit": "सर्वत्र परमो भावो ऽपरमश्चान्य उच्यते ।\nपरमापरमौ भावौ कथमेकत्र संगतौ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001457007, "chapter_id": 21457, "verse_number": "७-१-३०-८", "content_sanskrit": "निष्फलो हि स्वभावो ऽस्य परमः परमात्मनः ।\nस एव सकलः कस्मात्स्वभावो ह्यविपर्ययः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001457008, "chapter_id": 21457, "verse_number": "७-१-३०-९", "content_sanskrit": "स्वभावो विपरीतश्चेत्स्वतंत्रः स्वेच्छया यदि ।\nन करोति किमीशानो नित्यानित्यविपर्ययम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001457009, "chapter_id": 21457, "verse_number": "७-१-३०-१०", "content_sanskrit": "मूर्तात्मा सकलः कश्चित्स चान्यो निष्फलः शिवः ।\nशिवेनाधिष्ठितश्चेति सर्वत्र लघु कथ्यते॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001457010, "chapter_id": 21457, "verse_number": "७-१-३०-११", "content_sanskrit": "मूर्त्यात्मैव तदा मूर्तिः शिवस्यास्य भवेदिति ।\nतस्य मूर्तौ मूर्तिमतोः पारतंत्र्यं हि निश्चितम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001457011, "chapter_id": 21457, "verse_number": "७-१-३०-१२", "content_sanskrit": "अन्यथा निरपेक्षेण मूर्तिः स्वीक्रियते कथम् ।\nमूर्तिस्वीकरणं तस्मान्मूर्तौ साध्यफलेप्सया॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001457012, "chapter_id": 21457, "verse_number": "७-१-३०-१३", "content_sanskrit": "न हि स्वेच्छाशरीरत्वं स्वातंत्र्यायोपपद्यते ।\nस्वेच्छैव तादृशी पुंसां यस्मात्कर्मानुसारिणी॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001457013, "chapter_id": 21457, "verse_number": "७-१-३०-१४", "content_sanskrit": "स्वीकर्तुं स्वेच्छया देहं हातुं च प्रभवन्त्युत ।\nब्रह्मादयः पिशाचांताः किं ते कर्मातिवर्तिनः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001457014, "chapter_id": 21457, "verse_number": "७-१-३०-१५", "content_sanskrit": "इच्छया देहनिर्माणमिन्द्रजालोपमं विदुः ।\nअणिमादिगुणैश्वर्यवशीकारानतिक्रमात्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001457015, "chapter_id": 21457, "verse_number": "७-१-३०-१६", "content_sanskrit": "विश्वरूपं दधद्विष्णुर्दधीचेन महर्षिणा ।\nयुध्यता समुपालब्धस्तद्रूपं दधता स्वयम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001457016, "chapter_id": 21457, "verse_number": "७-१-३०-१७", "content_sanskrit": "सर्वस्मादधिकस्यापि शिवस्य परमात्मनः ।\nशरीरवत्तयान्यात्मसाधर्म्यं प्रतिभाति नः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001457017, "chapter_id": 21457, "verse_number": "७-१-३०-१८", "content_sanskrit": "सर्वानुग्राहकं प्राहुश्शिवं परमकारणम् ।\nस निर्गृह्णाति देवानां सर्वानुग्राहकः कथम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001457018, "chapter_id": 21457, "verse_number": "७-१-३०-१९", "content_sanskrit": "चिच्छेद बहुशो देवो ब्रह्मणः पञ्चमं शिरः ।\nशिवनिन्दां प्रकुर्वंतं पुत्रेति कुमतेर्हठात्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001457019, "chapter_id": 21457, "verse_number": "७-१-३०-२०", "content_sanskrit": "विष्णोरपि नृसिंहस्य रभसा शरभाकृतिः ।\nबिभेद पद्भ्यामाक्रम्य हृदयं नखरैः खरैः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001457020, "chapter_id": 21457, "verse_number": "७-१-३०-२१", "content_sanskrit": "देवस्त्रीषु च देवेषु दक्षस्याध्वरकारणात् ।\nवीरेण वीरभद्रेण न हि कश्चिददण्डितः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001457021, "chapter_id": 21457, "verse_number": "७-१-३०-२२", "content_sanskrit": "पुरत्रयं च सस्त्रीकं सदैत्यं सह बालकैः ।\nक्षणेनैकेन देवेन नेत्राग्नेरिंधनीकृतम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001457022, "chapter_id": 21457, "verse_number": "७-१-३०-२३", "content_sanskrit": "प्रजानां रतिहेतुश्च कामो रतिपतिस्स्वयम् ।\nक्रोशतामेव देवानां हुतो नेत्रहुताशने॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001457023, "chapter_id": 21457, "verse_number": "७-१-३०-२४", "content_sanskrit": "गावश्च कश्चिद्दुग्धौघं स्रवन्त्यो मूर्ध्नि खेचराः ।\nसरुषा प्रेक्ष्य देवेन तत्क्षणे भस्मसात्कृतः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001457024, "chapter_id": 21457, "verse_number": "७-१-३०-२५", "content_sanskrit": "जलंधरासुरो दीर्णश्चक्रीकृत्य जलं पदा ।\nबद्ध्वानंतेन यो विष्णुं चिक्षेप शतयोजनम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001457025, "chapter_id": 21457, "verse_number": "७-१-३०-२६", "content_sanskrit": "तमेव जलसंधायी शूलेनैव जघान सः ।\nतच्चक्रं तपसा लब्ध्वा लब्धवीर्यो हरिस्सदा॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001457026, "chapter_id": 21457, "verse_number": "७-१-३०-२७", "content_sanskrit": "जिघांसतां सुरारीणां कुलं निर्घृणचेतसाम् ।\nत्रिशूलेनान्धकस्योरः शिखिनैवोपतापितम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001457027, "chapter_id": 21457, "verse_number": "७-१-३०-२८", "content_sanskrit": "कण्ठात्कालांगनां सृष्ट्वा दारको ऽपि निपातितः ।\nकौशिकीं जनयित्वा तु गौर्यास्त्वक्कोशगोचराम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001457028, "chapter_id": 21457, "verse_number": "७-१-३०-२९", "content_sanskrit": "शुंभस्सह निशुंभेन प्रापितो मरणं रणे ।\nश्रुतं च महदाख्यानं स्कान्दे स्कन्दसमाश्रयम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001457029, "chapter_id": 21457, "verse_number": "७-१-३०-३०", "content_sanskrit": "वधार्थे तारकाख्यस्य दैत्येन्द्रस्येन्द्रविद्विषः ।\nब्रह्मणाभ्यर्थितो देवो मन्दरान्तःपुरं गतः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001457030, "chapter_id": 21457, "verse_number": "७-१-३०-३१", "content_sanskrit": "विहृत्य सुचिरं देव्या विहारा ऽतिप्रसङ्गतः ।\nरसां रसातलं नीतामिव कृत्वाभिधां ततः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001457031, "chapter_id": 21457, "verse_number": "७-१-३०-३२", "content_sanskrit": "देवीं च वंचयंस्तस्यां स्ववीर्यमतिदुर्वहम् ।\nअविसृज्य विसृज्याग्नौ हविः पूतमिवामृतम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001457032, "chapter_id": 21457, "verse_number": "७-१-३०-३३", "content_sanskrit": "गंगादिष्वपि निक्षिप्य वह्निद्वारा तदंशतः ।\nतत्समाहृत्य शनकैस्तोकंस्तोकमितस्ततः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001457033, "chapter_id": 21457, "verse_number": "७-१-३०-३४", "content_sanskrit": "स्वाहया कृत्तिकारूपात्स्वभर्त्रा रममाणया ।\nसुवर्णीभूतया न्यस्तं मेरौ शरवणे क्वचित्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001457034, "chapter_id": 21457, "verse_number": "७-१-३०-३५", "content_sanskrit": "संदीपयित्वा कालेन तस्य भासा दिशो दश ।\nरञ्जयित्वा गिरीन्सर्वान्कांचनीकृत्य मेरुणा॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001457035, "chapter_id": 21457, "verse_number": "७-१-३०-३६", "content_sanskrit": "ततश्चिरेण कालेन संजाते तत्र तेजसि ।\nकुमारे सुकुमारांगे कुमाराणां निदर्शने॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001457036, "chapter_id": 21457, "verse_number": "७-१-३०-३७", "content_sanskrit": "तच्छैशवं स्वरूपं च तस्य दृष्ट्वा मनोहरम् ।\nसह देवसुरैर्लोकैर्विस्मिते च विमोहिते॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001457037, "chapter_id": 21457, "verse_number": "७-१-३०-३८", "content_sanskrit": "देवो ऽपि स्वयमायातः पुत्रदर्शनलालसः ।\nसह देव्यांकमारोप्य ततो ऽस्य स्मेरमाननम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001457038, "chapter_id": 21457, "verse_number": "७-१-३०-३९", "content_sanskrit": "पीतामृतमिव स्नेहविवशेनान्तरात्मना ।\nदेवेष्वपि च पश्यत्सु वीतरागैस्तपस्विभिः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001457039, "chapter_id": 21457, "verse_number": "७-१-३०-४०", "content_sanskrit": "स्वस्य वक्षःस्थले स्वैरं नर्तयित्वा कुमारकम् ।\nअनुभूय च तत्क्रीडां संभाव्य च परस्परम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001457040, "chapter_id": 21457, "verse_number": "७-१-३०-४१", "content_sanskrit": "स्तन्यमाज्ञापयन्देव्याः पाययित्वामृतोपमम् ।\nतवावतारो जगतां हितायेत्यनुशास्य च॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001457041, "chapter_id": 21457, "verse_number": "७-१-३०-४२", "content_sanskrit": "स्वयन्देवश्च देवी च न तृप्तिमुपजग्मतुः ।\nततः शक्रेण संधाय बिभ्यता तारकासुरात्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001457042, "chapter_id": 21457, "verse_number": "७-१-३०-४३", "content_sanskrit": "कारयित्वाभिषेकं च सेनापत्ये दिवौकसाम् ।\nपुत्रमन्तरतः कृत्वा देवेन त्रिपुरद्विषा॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001457043, "chapter_id": 21457, "verse_number": "७-१-३०-४४", "content_sanskrit": "स्वयमंतर्हितेनैव स्कन्दमिन्द्रादिरक्षितम् ।\nतच्छक्त्या क्रौञ्चभेदिन्या युधि कालाग्निकल्पया॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001457044, "chapter_id": 21457, "verse_number": "७-१-३०-४५", "content_sanskrit": "छेदितं तारकस्यापि शिरश्शक्रभिया सह ।\nस्तुतिं चक्रुर्विशेषेण हरिधातृमुखाः सुराः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001457045, "chapter_id": 21457, "verse_number": "७-१-३०-४६", "content_sanskrit": "तथा रक्षोधिपः साक्षाद्रावणो बलगर्वितः ।\nउद्धरन्स्वभुजैर्दीर्घैः कैलासं गिरिमात्मनः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001457046, "chapter_id": 21457, "verse_number": "७-१-३०-४७", "content_sanskrit": "तदागो ऽसहमानस्य देवदेवस्य शूलिनः ।\nपदांगुष्ठपरिस्पन्दान्ममज्ज मृदितो भुवि॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001457047, "chapter_id": 21457, "verse_number": "७-१-३०-४८", "content_sanskrit": "बटोः केनचिदर्थेन स्वाश्रितस्य गतायुषः ।\nत्वरयागत्य देवेन पादांतं गमितोन्तकः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001457048, "chapter_id": 21457, "verse_number": "७-१-३०-४९", "content_sanskrit": "स्ववाहनमविज्ञाय वृषेन्द्रं वडवानलः ।\nसगलग्रहमानीतस्ततो ऽस्त्येकोदकं जगत्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001457049, "chapter_id": 21457, "verse_number": "७-१-३०-५०", "content_sanskrit": "अलोकविदितैस्तैस्तैर्वृत्तैरानन्दसुन्दरैः ।\nअंगहारस्वसेनेदमसकृच्चालितं जगत्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001457050, "chapter_id": 21457, "verse_number": "७-१-३०-५१", "content_sanskrit": "शान्त एव सदा सर्वमनुगृह्णाति चेच्छिवः ।\nसर्वाणि पूरयेदेव कथं शक्तेन मोचयेत्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001457051, "chapter_id": 21457, "verse_number": "७-१-३०-५२", "content_sanskrit": "अनादिकर्म वैचित्र्यमपि नात्र नियामकम् ।\nकारणं खलु कर्मापि भवेदीश्वरकारितम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001457052, "chapter_id": 21457, "verse_number": "७-१-३०-५३", "content_sanskrit": "किमत्र बहुनोक्तेन नास्तिक्यं हेतुकारकम् ।\nयथा ह्याशु निवर्तेत तथा कथय मारुत॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]