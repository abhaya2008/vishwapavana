[{"id": 2115088, "chapter_id": 3476, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2115089, "chapter_id": 3476, "verse_number": "१", "content_sanskrit": "भीमसेनस्तु तं दृष्ट्वा राक्षसं प्रहसन्निव ।\nभगिनीं प्रति सङ्क्रुद्धमिदं वचनमब्रवीत् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2115090, "chapter_id": 3476, "verse_number": "२", "content_sanskrit": "किं ते प्रियं हिडिम्बैतैः सुखसुप्तैः प्रबोधितैः ।\nमामासादय दुर्बुद्धे तरसा त्वं नराशन \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2115091, "chapter_id": 3476, "verse_number": "३", "content_sanskrit": "मय्येव प्रहरैहि त्वं न स्त्रियं हन्तुमर्हसि ।\nविशेषतो नापकृते परेणापकृते सति \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2115092, "chapter_id": 3476, "verse_number": "४", "content_sanskrit": "न हीयं स्ववशा बाला मां तु कामयतेऽद्य वै ।\nचोदितैषा ह्यनङ्गेन शरीरान्तरचारिणा \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2115093, "chapter_id": 3476, "verse_number": "५", "content_sanskrit": "भगिनी तव दुर्बुद्धे राक्षसानां यशोहर ।\nत्वन्नियोगेन चायाता रूपं मम निरीक्ष्य च \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2115094, "chapter_id": 3476, "verse_number": "६", "content_sanskrit": "कामयत्येवमवशा नैषा दूषयते कुलम् ।\nअनङ्गेन कृते दोषे नेमां त्वमिह राक्षस \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2115095, "chapter_id": 3476, "verse_number": "७", "content_sanskrit": "मयि तिष्ठति दुष्टात्मन् भगिनीं हन्तुमर्हसि ।\nसमागच्छ मया सार्धमेकेनैको नराशन \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2115096, "chapter_id": 3476, "verse_number": "८", "content_sanskrit": "अहमेव तु नेष्यामि त्वामद्य यमसादनम् ।\nअद्य ते तळनिष्पिष्टं शिरो राक्षस दीर्यते \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2115097, "chapter_id": 3476, "verse_number": "९", "content_sanskrit": "कुञ्जरस्येव निष्पिष्टं सिंहेनैव बलीयसा ।\nअद्य गात्राणि गृध्राश्च वला गोमायवस्तथा \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2115098, "chapter_id": 3476, "verse_number": "१०", "content_sanskrit": "कर्षन्तु भुवि संहृष्टा निहतस्य मया मृघे ।\nक्षणेनाद्य करिष्यामि वनं निहतकण्टकम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2115099, "chapter_id": 3476, "verse_number": "११", "content_sanskrit": "पुरस्ताद् दूषितं नित्यं त्वया भक्षयता नरान् ।\nअद्य त्वां भगिनी पापं कृष्यमाणं मया भुवि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2115100, "chapter_id": 3476, "verse_number": "१२", "content_sanskrit": "द्रक्ष्यत्यद्रिप्रतीकाशं सिंहेनेव महाद्विपम् ।\nनिराबाधं त्वयि हते मया राक्षसपांसन ।\nवनमेतच्चरिष्यन्ति पुरुषा वनचारिणः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2115101, "chapter_id": 3476, "verse_number": "", "content_sanskrit": "राक्षसः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2115102, "chapter_id": 3476, "verse_number": "१३", "content_sanskrit": "गर्जितेन भृशं किं ते कत्थनेन च मानव ।\nकृत्वा तु कर्मणा सर्वं कत्थेथा मा चिरं कृथाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2115103, "chapter_id": 3476, "verse_number": "१४", "content_sanskrit": "बलिनं मन्यसे यस्मादात्मानं सपराक्रमम् ।\nज्ञास्यस्यद्य समागम्य मयाऽऽत्मानं बलाधिकम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2115104, "chapter_id": 3476, "verse_number": "१५", "content_sanskrit": "नेमांस्तावद्धनिष्यामि स्वपन्त्वेते यथासुखम् ।\nएष त्वामेव दुर्बुद्धे हनिष्येऽप्रियवादिनम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2115105, "chapter_id": 3476, "verse_number": "१६", "content_sanskrit": "पीत्वा तवासृग्गात्रेभ्यस्ततः पश्चादिमानपि ।\nहनिष्यामि ततः क्षुद्रामिमां विप्रियकारिणीम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2115106, "chapter_id": 3476, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2115107, "chapter_id": 3476, "verse_number": "१७", "content_sanskrit": "एवमुक्त्वा महाबाहुः सन्नद्धः पुरुषादकः ।\nअभ्यधावत् सुसङ्क्रुद्धो भीमसेनमरिन्दमम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2115108, "chapter_id": 3476, "verse_number": "१८", "content_sanskrit": "तस्याभिपततस्तूर्णं भीमो भीमपराक्रमः ।\nवेगेन प्रसृतं बाहुं निजग्राह हसन्निव \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2115109, "chapter_id": 3476, "verse_number": "१९", "content_sanskrit": "निगृह्य तं बलाद् भीमो विस्फुरन्तं चकर्ष ह ।\nतस्माद् देशाद् धनूंष्यष्टौ सिंहः क्षुद्रमृगं यथा \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2115110, "chapter_id": 3476, "verse_number": "२०", "content_sanskrit": "तदा स राक्षसः क्रुद्धः पाण्डवेन बलाद् हृतः ।\nभीमसेनं समालिङ्ग्य व्यनदद् भैरवं स्वनम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2115111, "chapter_id": 3476, "verse_number": "२१", "content_sanskrit": "पुनर्भीमो बलादेव विचकर्ष महाबलः ।\nमा शब्दः सुखसुप्तानां भ्रातॄणां मे भवेदिति \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2115112, "chapter_id": 3476, "verse_number": "२२", "content_sanskrit": "अन्योन्यं वै समालिङ्ग्य विचकर्षतुरोजसा ।\nराक्षसो भीमसेनश्च विक्रमं चक्रतुः परम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2115113, "chapter_id": 3476, "verse_number": "२३", "content_sanskrit": "बभञ्जतुर्महावृक्षान् लताश्च विचकर्षतुः ।\nप्रमत्ताविव सङ्क्रुद्धौ मातङ्गौ षष्टिहायनौ \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2115114, "chapter_id": 3476, "verse_number": "२४", "content_sanskrit": "पादपानुद्वहन्तौ तावूरुवेगेन वेगितौ ।\nस्फोटयन्तौ लताजालान्यूरुभ्यां प्राप्य सर्वशः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2115115, "chapter_id": 3476, "verse_number": "२५", "content_sanskrit": "वित्रासयन्तौ शब्देन सर्वतो मृगपक्षिणः ।\nबलेन बलिनौ मत्तावन्योन्यवधकाङ्क्षिणौ \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2115116, "chapter_id": 3476, "verse_number": "२६", "content_sanskrit": "भीमराक्षसयोर्युद्धं तदाऽवर्तत दारुणम् ।\nऊरुबाहुपरिक्लेशात् कर्षतोरितरेतरम् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2115117, "chapter_id": 3476, "verse_number": "२७", "content_sanskrit": "उत्कर्षणं विकर्षणमपकर्षणमेव च ।\nततः शब्देन महता गर्जन्तौ तौ परस्परम् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2115118, "chapter_id": 3476, "verse_number": "२८", "content_sanskrit": "पाषाणसङ्घट्टनिभैः प्रहारैरभिजघ्नतुः ।\nअन्योन्यं तौ समालिङ्ग्य विकर्षन्तौ परस्परम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2115119, "chapter_id": 3476, "verse_number": "२९", "content_sanskrit": "तयोः शब्देन महता विबुद्धास्ते नरर्षभाः ।\nसह मात्राऽथ ददृशुर्हिडिम्बीमग्रतः स्थिताम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2115120, "chapter_id": 3476, "verse_number": "१५५", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nपञ्चपञ्चाशदधिकशततमोऽध्यायः ॥१५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2115121, "chapter_id": 3476, "verse_number": "३", "content_sanskrit": "॥ इति हिडिम्बवधपर्वणि तृतीयोऽध्यायः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2115122, "chapter_id": 3476, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]