[{"id": 7004888000, "chapter_id": 24888, "verse_number": "७-१-७१-१", "content_sanskrit": "ततो गच्छेन्महादेवि लिंगं तत्रैव संस्थितम् ।\nदक्षिणे वरुणेशस्य धनुषां त्रितये स्थितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004888001, "chapter_id": 24888, "verse_number": "७-१-७१-२", "content_sanskrit": "भार्यया वरुणस्यैव उषा नाम्न्या वरानने ।\nकृत्वा तपो महाघोरं भर्तृदुःखपरीतया ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004888002, "chapter_id": 24888, "verse_number": "७-१-७१-३", "content_sanskrit": "स्थापितं तु महल्लिंगं सर्वसिद्धिप्रदायकम् ।\nउषेश्वरेति विख्यातं सर्वसिद्धिप्रपूजितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004888003, "chapter_id": 24888, "verse_number": "७-१-७१-४", "content_sanskrit": "यस्तत्पूजयते भक्त्या लिंगं पापप्रणाशनम् ।\nमहापापौघयुक्तोऽपि स गच्छेत्परमां गतिम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004888004, "chapter_id": 24888, "verse_number": "७-१-७१-५", "content_sanskrit": "स्त्रीणां सौभाग्यफलदं दुःखदौर्भाग्यना शनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004888005, "chapter_id": 24888, "verse_number": "७-१-७१-६", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्य उषेश्वरमाहात्म्यवर्णनं नामैकसप्ततितमोऽध्यायः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]