[{"id": 5000342000, "chapter_id": 9342, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे तृतीयः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000342001, "chapter_id": 9342, "verse_number": "५-३-१", "content_sanskrit": "स लम्बशिखरे लम्बे लम्बतोयदसंनिभे।\nसत्त्वमास्थाय मेधावी हनुमान् मारुतात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000342002, "chapter_id": 9342, "verse_number": "५-३-२", "content_sanskrit": "निशि लंकां महासत्त्वो विवेश कपिकुञ्जरः।\nरम्यकाननतोयाढ्यां पुरीं रावणपालिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000342003, "chapter_id": 9342, "verse_number": "५-३-३", "content_sanskrit": "शारदाम्बुधरप्रख्यैर्भवनैरुपशोभिताम्।\nसागरोपमनिर्घोषां सागरानिलसेविताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000342004, "chapter_id": 9342, "verse_number": "५-३-४", "content_sanskrit": "सुपुष्टबलसम्पुष्टां यथैव विटपावतीम्।\nचारुतोरणनिर्यूहां पाण्डुरद्वारतोरणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000342005, "chapter_id": 9342, "verse_number": "५-३-५", "content_sanskrit": "भुजगाचरितां गुप्तां शुभां भोगवतीमिव।\nतां सविद्युद‍्घनाकीर्णां ज्योतिर्गणनिषेविताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000342006, "chapter_id": 9342, "verse_number": "५-३-६", "content_sanskrit": "चण्डमारुतनिर्ह्रादां यथा चाप्यमरावतीम्।\nशातकुम्भेन महता प्राकारेणाभिसंवृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000342007, "chapter_id": 9342, "verse_number": "५-३-७", "content_sanskrit": "किङ्किणीजालघोषाभिः पताकाभिरलंकृताम्।\nआसाद्य सहसा हृष्टः प्राकारमभिपेदिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000342008, "chapter_id": 9342, "verse_number": "५-३-८", "content_sanskrit": "विस्मयाविष्टहृदयः पुरीमालोक्य सर्वतः।\nजाम्बूनदमयैर्द्वारैर्वैदूर्यकृतवेदिकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000342009, "chapter_id": 9342, "verse_number": "५-३-९", "content_sanskrit": "वज्रस्फटिकमुक्ताभिर्मणिकुट्टिमभूषितैः।\nतप्तहाटकनिर्यूहै राजतामलपाण्डुरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000342010, "chapter_id": 9342, "verse_number": "५-३-१०", "content_sanskrit": "वैदूर्यकृतसोपानैः स्फाटिकान्तरपांसुभिः।\nचारुसंजवनोपेतैः खमिवोत्पतितैः शुभैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000342011, "chapter_id": 9342, "verse_number": "५-३-११", "content_sanskrit": "क्रौञ्चबर्हिणसंघुष्टै राजहंसनिषेवितैः।\nतूर्याभरणनिर्घोषैः सर्वतः परिनादिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000342012, "chapter_id": 9342, "verse_number": "५-३-१२", "content_sanskrit": "वस्वोकसारप्रतिमां समीक्ष्य नगरीं ततः।\nखमिवोत्पतितां लंकां जहर्ष हनुमान् कपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000342013, "chapter_id": 9342, "verse_number": "५-३-१३", "content_sanskrit": "तां समीक्ष्य पुरीं लंकां राक्षसाधिपतेः शुभाम्।\nअनुत्तमामृद्धिमतीं चिन्तयामास वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000342014, "chapter_id": 9342, "verse_number": "५-३-१४", "content_sanskrit": "नेयमन्येन नगरी शक्या धर्षयितुं बलात्।\nरक्षिता रावणबलैरुद्यतायुधपाणिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000342015, "chapter_id": 9342, "verse_number": "५-३-१५", "content_sanskrit": "कुमुदाङ्गदयोर्वापि सुषेणस्य महाकपेः।\nप्रसिद्धेयं भवेद् भूमिर्मैन्दद्विविदयोरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000342016, "chapter_id": 9342, "verse_number": "५-३-१६", "content_sanskrit": "विवस्वतस्तनूजस्य हरेश्च कुशपर्वणः।\nऋक्षस्य कपिमुख्यस्य मम चैव गतिर्भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000342017, "chapter_id": 9342, "verse_number": "५-३-१७", "content_sanskrit": "समीक्ष्य च महाबाहो राघवस्य पराक्रमम्।\nलक्ष्मणस्य च विक्रान्तमभवत् प्रीतिमान् कपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000342018, "chapter_id": 9342, "verse_number": "५-३-१८", "content_sanskrit": "तां रत्नवसनोपेतां गोष्ठागारावतंसिकाम्।\nयन्त्रागारस्तनीमृद्धां प्रमदामिव भूषिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000342019, "chapter_id": 9342, "verse_number": "५-३-१९", "content_sanskrit": "तां नष्टतिमिरां दीपैर्भास्वरैश्च महाग्रहैः।\nनगरीं राक्षसेन्द्रस्य स ददर्श महाकपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000342020, "chapter_id": 9342, "verse_number": "५-३-२०", "content_sanskrit": "अथ सा हरिशार्दूलं प्रविशन्तं महाकपिम्।\nनगरी स्वेन रूपेण ददर्श पवनात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000342021, "chapter_id": 9342, "verse_number": "५-३-२१", "content_sanskrit": "सा तं हरिवरं दृष्ट्वा लंका रावणपालिता।\nस्वयमेवोत्थिता तत्र विकृताननदर्शना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000342022, "chapter_id": 9342, "verse_number": "५-३-२२", "content_sanskrit": "पुरस्तात् तस्य वीरस्य वायुसूनोरतिष्ठत।\nमुञ्चमाना महानादमब्रवीत् पवनात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000342023, "chapter_id": 9342, "verse_number": "५-३-२३", "content_sanskrit": "कस्त्वं केन च कार्येण इह प्राप्तो वनालय।\nकथयस्वेह यत् तत्त्वं यावत् प्राणा धरन्ति ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000342024, "chapter_id": 9342, "verse_number": "५-३-२४", "content_sanskrit": "न शक्यं खल्वियं लंका प्रवेष्टुं वानर त्वया।\nरक्षिता रावणबलैरभिगुप्ता समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000342025, "chapter_id": 9342, "verse_number": "५-३-२५", "content_sanskrit": "अथ तामब्रवीद् वीरो हनुमानग्रतः स्थिताम्।\nकथयिष्यामि तत् तत्त्वं यन्मां त्वं परिपृच्छसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000342026, "chapter_id": 9342, "verse_number": "५-३-२६", "content_sanskrit": "का त्वं विरूपनयना पुरद्वारेऽवतिष्ठसे।\nकिमर्थं चापि मां क्रोधान्निर्भर्त्सयसि दारुणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000342027, "chapter_id": 9342, "verse_number": "५-३-२७", "content_sanskrit": "हनुमद्वचनं श्रुत्वा लंका सा कामरूपिणी।\nउवाच वचनं क्रुद्धा परुषं पवनात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000342028, "chapter_id": 9342, "verse_number": "५-३-२८", "content_sanskrit": "अहं राक्षसराजस्य रावणस्य महात्मनः।\nआज्ञाप्रतीक्षा दुर्धर्षा रक्षामि नगरीमिमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000342029, "chapter_id": 9342, "verse_number": "५-३-२९", "content_sanskrit": "न शक्यं मामवज्ञाय प्रवेष्टुं नगरीमिमाम्।\nअद्य प्राणैः परित्यक्तः स्वप्स्यसे निहतो मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000342030, "chapter_id": 9342, "verse_number": "५-३-३०", "content_sanskrit": "अहं हि नगरी लंका स्वयमेव प्लवङ्गम।\nसर्वतः परिरक्षामि अतस्ते कथितं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000342031, "chapter_id": 9342, "verse_number": "५-३-३१", "content_sanskrit": "लंकाया वचनं श्रुत्वा हनुमान् मारुतात्मजः।\nयत्नवान् स हरिश्रेष्ठः स्थितः शैल इवापरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000342032, "chapter_id": 9342, "verse_number": "५-३-३२", "content_sanskrit": "स तां स्त्रीरूपविकृतां दृष्ट्वा वानरपुङ्गवः।\nआबभाषेऽथ मेधावी सत्त्ववान् प्लवगर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000342033, "chapter_id": 9342, "verse_number": "५-३-३३", "content_sanskrit": "द्रक्ष्यामि नगरीं लंकां साट्टप्राकारतोरणाम्।\nइत्यर्थमिह सम्प्राप्तः परं कौतूहलं हि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000342034, "chapter_id": 9342, "verse_number": "५-३-३४", "content_sanskrit": "वनान्युपवनानीह लंकायाः काननानि च।\nसर्वतो गृहमुख्यानि द्रष्टुमागमनं हि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000342035, "chapter_id": 9342, "verse_number": "५-३-३५", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा लंका सा कामरूपिणी।\nभूय एव पुनर्वाक्यं बभाषे परुषाक्षरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000342036, "chapter_id": 9342, "verse_number": "५-३-३६", "content_sanskrit": "मामनिर्जित्य दुर्बुद्धे राक्षसेश्वरपालिताम्।\nन शक्यं ह्यद्य ते द्रष्टुं पुरीयं वानराधम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000342037, "chapter_id": 9342, "verse_number": "५-३-३७", "content_sanskrit": "ततः स हरिशार्दूलस्तामुवाच निशाचरीम्।\nदृष्ट्वा पुरीमिमां भद्रे पुनर्यास्ये यथागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000342038, "chapter_id": 9342, "verse_number": "५-३-३८", "content_sanskrit": "ततः कृत्वा महानादं सा वै लंका भयंकरम्।\nतलेन वानरश्रेष्ठं ताडयामास वेगिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000342039, "chapter_id": 9342, "verse_number": "५-३-३९", "content_sanskrit": "ततः स हरिशार्दूलो लंकया ताडितो भृशम्।\nननाद सुमहानादं वीर्यवान् मारुतात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000342040, "chapter_id": 9342, "verse_number": "५-३-४०", "content_sanskrit": "ततः संवर्तयामास वामहस्तस्य सोऽङ्गुलीः।\nमुष्टिनाभिजघानैनां हनुमान् क्रोधर्मूच्छितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000342041, "chapter_id": 9342, "verse_number": "५-३-४१", "content_sanskrit": "स्त्री चेति मन्यमानेन नातिक्रोधः स्वयं कृतः।\nसा तु तेन प्रहारेण विह्वलाङ्गी निशाचरी।\nपपात सहसा भूमौ विकृताननदर्शना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000342042, "chapter_id": 9342, "verse_number": "५-३-४२", "content_sanskrit": "ततस्तु हनुमान् वीरस्तां दृष्ट्वा विनिपातिताम्।\nकृपां चकार तेजस्वी मन्यमानः स्त्रियं च ताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000342043, "chapter_id": 9342, "verse_number": "५-३-४३", "content_sanskrit": "ततो वै भृशमुद्विग्ना लंका सा गद‍्गदाक्षरम्।\nउवाचागर्वितं वाक्यं हनुमन्तं प्लवङ्गमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000342044, "chapter_id": 9342, "verse_number": "५-३-४४", "content_sanskrit": "प्रसीद सुमहाबाहो त्रायस्व हरिसत्तम।\nसमये सौम्य तिष्ठन्ति सत्त्ववन्तो महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000342045, "chapter_id": 9342, "verse_number": "५-३-४५", "content_sanskrit": "अहं तु नगरी लंका स्वयमेव प्लवङ्गम।\nनिर्जिताहं त्वया वीर विक्रमेण महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000342046, "chapter_id": 9342, "verse_number": "५-३-४६", "content_sanskrit": "इदं च तथ्यं शृणु मे ब्रुवन्त्या वै हरीश्वर।\nस्वयं स्वयम्भुवा दत्तं वरदानं यथा मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000342047, "chapter_id": 9342, "verse_number": "५-३-४७", "content_sanskrit": "यदा त्वां वानरः कश्चिद् विक्रमाद् वशमानयेत्।\nतदा त्वया हि विज्ञेयं रक्षसां भयमागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000342048, "chapter_id": 9342, "verse_number": "५-३-४८", "content_sanskrit": "स हि मे समयः सौम्य प्राप्तोऽद्य तव दर्शनात्।\nस्वयम्भूविहितः सत्यो न तस्यास्ति व्यतिक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000342049, "chapter_id": 9342, "verse_number": "५-३-४९", "content_sanskrit": "सीतानिमित्तं राज्ञस्तु रावणस्य दुरात्मनः।\nरक्षसां चैव सर्वेषां विनाशः समुपागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000342050, "chapter_id": 9342, "verse_number": "५-३-५०", "content_sanskrit": "तत् प्रविश्य हरिश्रेष्ठ पुरीं रावणपालिताम्।\nविधत्स्व सर्वकार्याणि यानि यानीह वाञ्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000342051, "chapter_id": 9342, "verse_number": "५-३-५१", "content_sanskrit": "प्रविश्य शापोपहतां हरीश्वर\nपुरीं शुभां राक्षसमुख्यपालिताम्।\nयदृच्छया त्वं जनकात्मजां सतीं\nविमार्ग सर्वत्र गतो यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000342052, "chapter_id": 9342, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे तृतीयः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]