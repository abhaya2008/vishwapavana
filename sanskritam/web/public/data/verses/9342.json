[{"id": 40020763, "chapter_id": 9342, "verse_number": "1", "content_sanskrit": "ततो जित्वा दशग्रीवो यमं त्रिदशपुङ्गवम् । रावणस्तु रणश्लाघी स्वसहायान्ददर्श ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40020764, "chapter_id": 9342, "verse_number": "2", "content_sanskrit": "ततो रुधिरसिक्ताङ्गं प्रहारैर्जर्जरीकृतम् । रावणं राक्षसा दृष्ट्वा ह्यष्टवत् समुपागमन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40020765, "chapter_id": 9342, "verse_number": "3", "content_sanskrit": "जयेन वर्धयित्वा च मारीचप्रमुखास्ततः । पुष्पकं भेजिरे सर्वे सान्त्विता रावणेन तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40020766, "chapter_id": 9342, "verse_number": "4", "content_sanskrit": "ततो रसातलं गच्छन् प्रविष्टः पयसां निधिम् । दैत्योरगगणाध्युष्टं वरुणेन सुरक्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40020767, "chapter_id": 9342, "verse_number": "5", "content_sanskrit": "स तु भोगवतीं गत्वा पुरीं वासुकिपालिताम् । कृत्वा नागान्वशे हृष्टो ययौ मणिमयीं पुरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40020768, "chapter_id": 9342, "verse_number": "6", "content_sanskrit": "निवातकवचास्तत्र दैत्या लब्धवरा वसन् । राक्षसान्तान्समागम्य युद्धाय समुपाह्वयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40020769, "chapter_id": 9342, "verse_number": "7", "content_sanskrit": "ते तु सर्वे सुविक्रान्ता दैतेया बलशालिनः । नानाप्रहरणास्तत्र प्रहृष्टा युद्धदुर्मदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40020770, "chapter_id": 9342, "verse_number": "8", "content_sanskrit": "शूलैस्त्रिशूलैः कुलिशैः पट्टिशासिपरश्वधैः । अन्योन्यं बिभिदुः क्रुद्धा राक्षसा दानवास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40020771, "chapter_id": 9342, "verse_number": "9", "content_sanskrit": "तेषां तु युध्यमानानां साग्रः संवत्सरो गतः । न चान्यतरयोस्तत्र विजयो वा क्षयो ऽपि वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40020772, "chapter_id": 9342, "verse_number": "10", "content_sanskrit": "ततः पितामहस्तत्र त्रैलोक्यगतिरव्ययः । आजगाम द्रुतं देवो विमानवरमास्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40020773, "chapter_id": 9342, "verse_number": "11", "content_sanskrit": "निवातकवचानां तु निवार्य रणकर्म तत् । वृद्धः पितामहो वाक्यमुवाच विदितार्थवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40020774, "chapter_id": 9342, "verse_number": "12", "content_sanskrit": "नह्ययं रावणो युद्धे शक्यो जेतुं सुरासुरैः । न भवन्तः क्षयं नेतुमपि सामरदानवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40020775, "chapter_id": 9342, "verse_number": "13", "content_sanskrit": "राक्षसस्य सखित्वं च भवद्भिः सह रोचते । अविभक्ताश्च सर्वार्थाः सुहृदां नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40020776, "chapter_id": 9342, "verse_number": "14", "content_sanskrit": "ततो ऽग्निसाक्षिकं सख्यं कृतवांस्तत्र रावणः । निवातकवचैः सार्धं प्रीतिमानभवत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40020777, "chapter_id": 9342, "verse_number": "15", "content_sanskrit": "अर्थतस्तैर्यथान्यायं संवत्सरमथोषितः । स्वपुरान्निर्विशेषं च प्रियं प्राप्तो दशाननः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40020778, "chapter_id": 9342, "verse_number": "16", "content_sanskrit": "ततोपधार्य मायानां शतमेकं समाप्तवान् । सलिलेन्द्रपुरान्वेषी भ्रमति स्म रसातलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40020779, "chapter_id": 9342, "verse_number": "17", "content_sanskrit": "ततो ऽश्मनगरं नाम कालकेयैरधिष्ठितम् । गत्वा तु कालकेयांश्च हत्वा तत्र बलोत्कटान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40020780, "chapter_id": 9342, "verse_number": "18", "content_sanskrit": "शूर्पणख्याश्च भर्तारमसिना प्राच्छिनत्तदा । श्यालं च बलवन्तं च विद्युज्जिह्वं बलोत्कटम् । जिह्वया संलिहन्तं च राक्षसं समरे तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40020781, "chapter_id": 9342, "verse_number": "19", "content_sanskrit": "तं विजित्य मुहूर्तेन जघ्ने दैत्यांश्चतुःशतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40020782, "chapter_id": 9342, "verse_number": "20", "content_sanskrit": "ततः पाण्डुरमेघाभं कैलासमिव भास्वरम् । वरुणस्यालयं दिव्यमपश्यद्राक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40020783, "chapter_id": 9342, "verse_number": "21", "content_sanskrit": "क्षरन्तीं च पयस्तत्र सुरभिं गामवस्थिताम् । यस्याः पयोभिनिष्यन्दात्क्षीरोदो नाम सागरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40020784, "chapter_id": 9342, "verse_number": "22", "content_sanskrit": "ददर्श रावणस्तत्र गोवृषेन्द्रवरारणिम् । यस्माच्चन्द्रः प्रभवति शीतरश्मिर्निशाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40020785, "chapter_id": 9342, "verse_number": "23", "content_sanskrit": "यं समाश्रित्य जीवन्ति फेनपाः परमर्षयः । अमृतं यत्र चोत्पन्नं स्वधा च स्वधभोजिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40020786, "chapter_id": 9342, "verse_number": "24", "content_sanskrit": "यां ब्रुवन्ति नरा लोके सुरभिं नाम नामतः । प्रदक्षिणं तु तां कृत्वा रावणः परमाद्भुताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40020787, "chapter_id": 9342, "verse_number": "25", "content_sanskrit": "प्रविवेश महाघोरं गुप्तं बहुविधैर्बलैः । ततो धाराशताकीर्णं शारदाभ्रनिभं तदा । नित्यप्रहृष्टं ददृशे वरुणस्य गृहोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40020788, "chapter_id": 9342, "verse_number": "26", "content_sanskrit": "ततो हत्वा बलाध्यक्षान्समरे तैश्च ताडितः । अब्रवीच्च ततो योधान्राजा शीघ्रं निवेद्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40020789, "chapter_id": 9342, "verse_number": "27", "content_sanskrit": "युद्धार्थी रावणः प्राप्तस्तस्य युद्धं प्रदीयताम् । वद वा न भयं ते ऽस्ति निर्जितो ऽस्मीति साञ्जलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40020790, "chapter_id": 9342, "verse_number": "28", "content_sanskrit": "एतस्मिन्नन्तरे क्रुद्धा वरुणस्य महात्मनः । पुत्राः पौत्राश्च निष्क्रामन्गौश्च पुष्कर एव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40020791, "chapter_id": 9342, "verse_number": "29", "content_sanskrit": "ते तु वीर्यगुणोपेता बलैः परिवृताः स्वकैः । युङ्क्त्वा रथान्कामगमानुद्यद्भास्वरवर्चसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40020792, "chapter_id": 9342, "verse_number": "30", "content_sanskrit": "ततो युद्धं समभवद्दारुणं रोमहर्षणम् । सलिलेन्द्रस्य पुत्राणां रावणस्य च धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40020793, "chapter_id": 9342, "verse_number": "31", "content_sanskrit": "अमात्यैश्च महावीर्यैर्दशग्रीवस्य रक्षसः । वारुणं तद्बलं कृत्स्नं क्षणेन विनिपातितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40020794, "chapter_id": 9342, "verse_number": "32", "content_sanskrit": "समीक्ष्य स्वबलं सङ्ख्ये वरुणस्य सुतास्तदा । अर्दिताः शरजालेन निवृत्ता रणकर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40020795, "chapter_id": 9342, "verse_number": "33", "content_sanskrit": "महीतलगतास्ते तु रावणं दृश्य पुष्पके । आकाशमाशु विविशुः स्यन्दनैः शीघ्रगामिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40020796, "chapter_id": 9342, "verse_number": "34", "content_sanskrit": "महादासीत्ततस्तेषां तुल्यं स्थानमवाप्य तत् । आकाशयुद्धं तुमुलं देवदानवयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40020797, "chapter_id": 9342, "verse_number": "35", "content_sanskrit": "ततस्ते रावणं युद्धे शरैः पावकसन्निभैः । विमुखीकृत्य सन्तुष्टा विनेदुर्विविधान्रवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40020798, "chapter_id": 9342, "verse_number": "36", "content_sanskrit": "ततो महोदरः क्रुद्धो राजानं दृश्य धर्षितम् । त्यक्त्वा मृत्युभयं वीरो युद्धकाङ्क्षी व्यलोकयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40020799, "chapter_id": 9342, "verse_number": "37", "content_sanskrit": "तेन ते दारुणा युद्धे कामगाः पवनोपमाः । महोदरेण गदया हता वै प्रययुः क्षितिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40020800, "chapter_id": 9342, "verse_number": "38", "content_sanskrit": "तेषां वरुणपुत्राणां हत्वा योधान्हयाञ्छतान् । मुमोचाशु महानादं विरथान्प्रेक्ष्य तान्स्थितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40020801, "chapter_id": 9342, "verse_number": "39", "content_sanskrit": "ते तु तेषां रथाः साश्वाः सह सारथिभिर्हतैः । महोदरेण निहताः पतिताः पृथिवीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40020802, "chapter_id": 9342, "verse_number": "40", "content_sanskrit": "ते तु त्यक्त्वा रथान्पुत्रा वरुणस्य महात्मनः । आकाशे विष्ठिताः शूराः स्वप्रभावान्न विव्यथुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40020803, "chapter_id": 9342, "verse_number": "41", "content_sanskrit": "धनूंषि कृत्वा सज्जानि विनिर्भिद्य महोदरम् । रावणं समरे क्रुद्धाः सहिताः समभिद्रवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40020804, "chapter_id": 9342, "verse_number": "42", "content_sanskrit": "सायकैश्चापविभ्रष्टैर्वज्रकल्पैः सुदारुणैः । दारयन्ति स्म सङ्क्रुद्धा मेघा इव महागिरिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40020805, "chapter_id": 9342, "verse_number": "43", "content_sanskrit": "ततः क्रुद्धो दशग्रीवः कालाग्निरिव निर्गतः । शरवर्षैर्महाघोरैस्तेषां मर्मस्वताडयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40020806, "chapter_id": 9342, "verse_number": "44", "content_sanskrit": "ततस्तेनैव सहसा सीदन्ति स्म पदातयः । मुसलानि विचित्राणि ततो भल्लशतानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40020807, "chapter_id": 9342, "verse_number": "45", "content_sanskrit": "पट्टिशांश्चैव शक्तीश्च शतघ्नीस्तोमरांस्तथा । पातयामास दुर्धर्षस्तेषामुपरि विष्ठितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40020808, "chapter_id": 9342, "verse_number": "46", "content_sanskrit": "अपविद्धास्तु ते वीरा विनिष्पेतुः पदातयः । महापङ्कमिवासाद्य कुञ्जराष्षष्टिहायनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40020809, "chapter_id": 9342, "verse_number": "47", "content_sanskrit": "सीदमानान्सुतान्दृष्ट्वा विह्वलान्सुमहौजसः । ननाद रावणो हर्षान्महानम्बुधरो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 40020810, "chapter_id": 9342, "verse_number": "48", "content_sanskrit": "ततो रक्षो महानादान्मुक्त्वा हन्ति स्म वारुणान् । नानाप्रहरणोपेतैर्धारापातैरिवाम्बुदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 40020811, "chapter_id": 9342, "verse_number": "49", "content_sanskrit": "ततस्ते विमुखाः सर्वे पतिता धरणीतले । रणात्स्वपुरुषैः शीघ्रं गृहाण्येव प्रवेशिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 40020812, "chapter_id": 9342, "verse_number": "50", "content_sanskrit": "तानब्रवीत्ततो रक्षो वरुणाय निवेद्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 40020813, "chapter_id": 9342, "verse_number": "51", "content_sanskrit": "रावणं त्वब्रवीन्मन्त्री प्रहस्तो (प्रहसो) नाम वारुणः । गतः खलु महाराजो ब्रह्मलोकं जलेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 40020814, "chapter_id": 9342, "verse_number": "52", "content_sanskrit": "गान्धर्वं वरुणः श्रोतुं यं त्वमाह्वयसे युधि । तत्किं तव वृथा वीर परिश्रम्य गते नृपे । ये तु सन्निहिता वीराः कुमारास्ते पराजिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 40020815, "chapter_id": 9342, "verse_number": "53", "content_sanskrit": "राक्षसेन्द्रस्तु तच्छ्रुत्वा नाम विश्राव्य चात्मनः । हर्षान्नादं विमुञ्चन्वै निष्क्रान्तो वरुणालयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 40020816, "chapter_id": 9342, "verse_number": "54", "content_sanskrit": "आगतस्तु पथा येन तेनैव विनिवृत्य सः । लङ्कामभिमुखो रक्षो नभस्तलगतो ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]