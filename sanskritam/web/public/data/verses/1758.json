[{"id": 2035099, "chapter_id": 1758, "verse_number": "५-३-०x", "content_sanskrit": "सात्यकिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2035100, "chapter_id": 1758, "verse_number": "५-३-१", "content_sanskrit": "यादृशः पुरुषस्यात्मा तादृशं संप्रभाषते।\nयथारूपोऽन्तरात्मा ते तथारूपं प्रभाषते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2035101, "chapter_id": 1758, "verse_number": "५-३-२", "content_sanskrit": "सन्ति वै पुरुषाः शूराः सन्ति कापुरुषास्तथा।\nउभावेतौ दृढौ पक्षौ दृश्येते पुरुषान्प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2035102, "chapter_id": 1758, "verse_number": "५-३-३", "content_sanskrit": "एकस्मिन्नेव जायेते कुले क्लीबमहाबलौ ।\nफलाफलवती शाखे यथैकस्मिन्वनस्पतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2035103, "chapter_id": 1758, "verse_number": "५-३-४", "content_sanskrit": "नाभ्यसूयामि ते वाक्यं ब्रुवतो लाङ्गलध्वज।\nये तु शृण्वन्ति ते वाक्यं तानसूयामि माधव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2035104, "chapter_id": 1758, "verse_number": "५-३-५", "content_sanskrit": "कथं हि धर्मराजस्य दोषमल्पमपि ब्रुवन्।\nलभते परिषन्मध्ये व्याहर्तुमकुतोभयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2035105, "chapter_id": 1758, "verse_number": "५-३-६", "content_sanskrit": "समाहूय महात्मानं जितवन्तोऽक्षकोविदाः।\nअनक्षज्ञं यथाऽश्रद्धं तेषु धर्मजयः कुतः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2035106, "chapter_id": 1758, "verse_number": "५-३-७", "content_sanskrit": "यदि कुन्तीसुतं गेहे क्रीडन्तं भ्रातृभिः सह ।\nअभिगम्य जयेयुस्ते तत्तेषां धर्मतो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2035107, "chapter_id": 1758, "verse_number": "५-३-८", "content_sanskrit": "समाहूय तु राजानं क्षत्रधर्मरतं सदा।\nनिकृत्या जितवन्तस्ते किं नु तेषां परं शुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2035108, "chapter_id": 1758, "verse_number": "५-३-९", "content_sanskrit": "कथं प्रणिपतेच्चायमिह कृत्वा पणं परम्।\nवनवासाद्विमुक्तरतु प्राप्तः पैतामहं पदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2035109, "chapter_id": 1758, "verse_number": "५-३-१०", "content_sanskrit": "यद्ययं परवित्तानि कामयेत युधिष्ठिरः।\nएवमप्ययमत्यन्तं परान्नार्हति याचितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2035110, "chapter_id": 1758, "verse_number": "५-३-११", "content_sanskrit": "कथं च धर्मयुक्तास्ते न च राज्यं जिहीर्षवः।\nनिवृत्तवनवासांस्तान्य आहुर्विदिता इति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2035111, "chapter_id": 1758, "verse_number": "५-३-१२", "content_sanskrit": "अनुनीता हि भीष्मेण द्रोणेन विदुरेण च।\nन व्यवस्यन्ति पाण्डूनां प्रदातुं पैतृकं वसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2035112, "chapter_id": 1758, "verse_number": "५-३-१३", "content_sanskrit": "अहं तु ताञ्छितैर्बाणैरनुनीय रणे बलात्।\nपादयोः पातयिष्यामि कौन्तेयस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2035113, "chapter_id": 1758, "verse_number": "५-३-१४", "content_sanskrit": "अथ ते न व्यवस्यन्ति प्रणिपाताय धीमतः।\nगमिष्यन्ति सहामात्या यमस्य सदनं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2035114, "chapter_id": 1758, "verse_number": "५-३-१५", "content_sanskrit": "न हि ते युयुधानस्य संरब्धस्य युयुत्सतः।\nवेगं समर्थाः संसोद्धुं वज्रस्येव महीधराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2035115, "chapter_id": 1758, "verse_number": "५-३-१६", "content_sanskrit": "को हि गाण्डीवधन्वानं कश्च चक्रायुधं युधि ।\nमां चापि विषहेत्क्रुद्धं कश्च भीमं दुरासदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2035116, "chapter_id": 1758, "verse_number": "५-३-१७", "content_sanskrit": "यमौ च दृढधन्वानौ यमकल्पौ महाद्युती।\nविराटद्रुपदौ वीरौ यमकालोपमद्युती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2035117, "chapter_id": 1758, "verse_number": "५-३-१८", "content_sanskrit": "को जिजीविषुरासादेद्धृष्टद्युम्नं च पार्षतम्।\nपञ्चैतान्पाण्डवेयांस्तु द्रौपद्याः कीर्तिवर्धनान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2035118, "chapter_id": 1758, "verse_number": "५-३-१९", "content_sanskrit": "समप्रमाणान्पाण्डूनां समवीर्यान्मदोत्कटान् ।\nसौभद्रं च महेष्वासममरैरपि दुःसहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2035119, "chapter_id": 1758, "verse_number": "५-३-२०", "content_sanskrit": "गदप्रद्युम्नसाम्बांश्च कालसूर्यानलोपमान्।\nते वयं धृतराष्ट्रस्य पुत्रं शकुनिना सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2035120, "chapter_id": 1758, "verse_number": "५-३-२१", "content_sanskrit": "कर्णं चैव निहत्याजावभिषेक्ष्याम पाण्डवम् ।\nनाधर्मो विद्यते कश्चिच्छत्रून्हत्वाऽऽततायिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2035121, "chapter_id": 1758, "verse_number": "५-३-२२", "content_sanskrit": "अधर्म्यमयशस्यं च शात्रवाणां प्रयाचनम्।\nहृद्भतस्तस्य यः कामस्तं कुरुध्वमतन्द्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2035122, "chapter_id": 1758, "verse_number": "५-३-२३", "content_sanskrit": "धार्तराष्ट्रो ह्ययुद्धेन न राज्यं दातुमिच्छति।\nअद्य पाण्डुसुतो राज्यं लभतां वा युधिष्ठिरः।\nनिहता वा रणे सर्वे स्वप्स्यन्ति वसुधातले ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2035123, "chapter_id": 1758, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि सेनोद्योगपर्वणि तृतीयोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]