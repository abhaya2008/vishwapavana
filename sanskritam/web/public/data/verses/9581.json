[{"id": 5000581000, "chapter_id": 9581, "verse_number": "७-४६-१", "content_sanskrit": "ततो रजन्यां व्युष्टायां लक्ष्मणो दीनचेतनः ।\nसुमन्त्रमब्रवीद्वाक्यं मुखेन परिशुष्यता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000581001, "chapter_id": 9581, "verse_number": "७-४६-२", "content_sanskrit": "सारथे तुरगाञ्छीघ्रं योजयस्व रथोत्तमे ।\nस्वास्तीर्णं राजभवनात्सीतायाश्चासनं कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000581002, "chapter_id": 9581, "verse_number": "७-४६-३", "content_sanskrit": "सीता हि राजवचनादाश्रमं पुण्यकर्मणाम् ।\nमया नेया महर्षीणां श्रीघ्रमानीयतां रथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000581003, "chapter_id": 9581, "verse_number": "७-४६-४", "content_sanskrit": "सुमन्त्रस्तु तथेत्युक्त्वा युक्तं परमवाजिभिः ।\nरथं सुरुचिरप्रख्यं स्वास्तीर्णं सुखशय्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000581004, "chapter_id": 9581, "verse_number": "७-४६-५", "content_sanskrit": "आनीयोवाच सौमित्रिं मित्राणां मानवर्धनम् ।\nरथो ऽयं समनुप्राप्तो यत्कार्यं क्रियतां प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000581005, "chapter_id": 9581, "verse_number": "७-४६-६", "content_sanskrit": "एवमुक्तः सुमन्त्रेण राजवेश्मनि लक्ष्मणः ।\nप्रविश्य सीतामासाद्य व्याजहार नरर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000581006, "chapter_id": 9581, "verse_number": "७-४६-७", "content_sanskrit": "त्वया किलैष नृपतिर्वरं वै याचितः प्रभुः ।\nनृपेण च प्रतिज्ञातमाज्ञप्तश्चाश्रमं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000581007, "chapter_id": 9581, "verse_number": "७-४६-८", "content_sanskrit": "गङ्गीतीरे मया देवि ऋषीणामाश्रमाञ्छुभान् ।\nशीघ्रं गत्वा तु वैदेहि शासनात्पार्थिवस्य नः ।\nअरण्ये मुनिभिर्जुष्टे अपनेया भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000581008, "chapter_id": 9581, "verse_number": "७-४६-९", "content_sanskrit": "एवमुक्ता तु वैदेही लक्ष्मणेन महात्मना ।\nप्रहर्षमतुलं लेभे गमनं चाप्यरोचयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000581009, "chapter_id": 9581, "verse_number": "७-४६-१०", "content_sanskrit": "वासांसि च महार्हाणि रत्नानि विविधानि च ।\nगृहीत्वा तानि वैदेही गमनायोपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000581010, "chapter_id": 9581, "verse_number": "७-४६-११", "content_sanskrit": "इमानि मुनिपत्नीनां दास्याम्याभरणान्हम् ।\nवस्त्राणि च महार्हाणि धनानि विविधानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000581011, "chapter_id": 9581, "verse_number": "७-४६-१२", "content_sanskrit": "सौमित्रिस्तु तथेत्युक्त्वा रथमारोप्य मैथिलीम् ।\nप्रययौ शीघ्रतुरगै रामस्याज्ञामनुस्मरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000581012, "chapter_id": 9581, "verse_number": "७-४६-१३", "content_sanskrit": "अब्रवीच्च तदा सीता लक्ष्मणं लक्ष्मिवर्धनम् ।\nअशुभानि बहून्येव पश्यामि रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000581013, "chapter_id": 9581, "verse_number": "७-४६-१४", "content_sanskrit": "नयनं मे स्फुरत्यद्य गात्रोत्कम्पश्च जायते ।\nहृदयं चैव सौमित्रे अस्वस्थमिव लक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000581014, "chapter_id": 9581, "verse_number": "७-४६-१५", "content_sanskrit": "औत्सुक्यं परमं चापि अधृतिश्च परा मम ।\nशून्यामेव च पश्यामि पृथिवीं पृथुलोचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000581015, "chapter_id": 9581, "verse_number": "७-४६-१६", "content_sanskrit": "अपि स्वस्ति भवेत्तस्य भ्रातुस्ते भ्रातृवत्सल ।\nश्वश्रूणां चैव मे वीर सर्वासामविशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000581016, "chapter_id": 9581, "verse_number": "७-४६-१७", "content_sanskrit": "पुरे जनपदे चैव कुशलं प्राणिनामपि ।\nइत्यञ्जलिकृता सीता देवता अभ्ययाचत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000581017, "chapter_id": 9581, "verse_number": "७-४६-१८", "content_sanskrit": "लक्ष्मणो ऽर्थं ततः श्रुत्वा शिरसा वन्द्य मैथिलीम् ।\nशिवमित्यब्रवीद्धृष्टो हृदयेन विशुष्यता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000581018, "chapter_id": 9581, "verse_number": "७-४६-१९", "content_sanskrit": "ततो वासमुपागम्य गोमतीतीर आश्रमे ।\nप्रभाते पुनरुत्थाय सौमित्रिः सूतमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000581019, "chapter_id": 9581, "verse_number": "७-४६-२०", "content_sanskrit": "योजयस्व रथं शीघ्रमद्य भागीरथीजलम् ।\nशिरसा धारयिष्यामि त्र्यम्बकः पर्वते यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000581020, "chapter_id": 9581, "verse_number": "७-४६-२१", "content_sanskrit": "सो ऽश्वान् रज्वाथ चतुरो रथे युङ्क्त्वा मनोजवान् ।\nआरोहस्वेति वैदेहीं सूतः प्राञ्जलिरब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000581021, "chapter_id": 9581, "verse_number": "७-४६-२२", "content_sanskrit": "सा तु सूतस्य वचनादारुरोह रथोत्तमम् ।\nसीता सौमित्रिणा सार्धं सुमन्त्रेण च धीमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000581022, "chapter_id": 9581, "verse_number": "७-४६-२३", "content_sanskrit": "आससाद विशालाक्षी गङ्गां पापविनाशिनीम् ।\nअथार्धदिवसं गत्वा भागीरथ्या जलाशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000581023, "chapter_id": 9581, "verse_number": "७-४६-२४", "content_sanskrit": "निरीक्ष्य लक्ष्मणो दीनः प्ररुरोद महास्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000581024, "chapter_id": 9581, "verse_number": "७-४६-२५", "content_sanskrit": "सीता तु परमायत्ता दृष्ट्वा लक्ष्मणमातुरम् ।\nउवाच वाक्यं धर्मज्ञा किमिदं रुद्यते त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000581025, "chapter_id": 9581, "verse_number": "७-४६-२६", "content_sanskrit": "जाह्नवीतीरमासाद्य चिराभिलषितं मम ।\nहर्षकाले किमर्थं मां विषादयसि लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000581026, "chapter_id": 9581, "verse_number": "७-४६-२७", "content_sanskrit": "नित्यं त्वं रामपार्श्वेषु वर्तसे पुरुषर्षभ ।\nकच्चिद्विनाकृतस्तेन द्विरात्रं शोकमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000581027, "chapter_id": 9581, "verse_number": "७-४६-२८", "content_sanskrit": "ममापि दयितो रामो जीवितादपि लक्ष्मण ।\nन चाहमेवं शोचामि मैवं त्वं बालिशो भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000581028, "chapter_id": 9581, "verse_number": "७-४६-२९", "content_sanskrit": "तारयस्व च मां गङ्गां दर्शयस्व च तापसान् ।\nततो मुनिभ्यो दास्यामि वांसास्याभरणानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000581029, "chapter_id": 9581, "verse_number": "७-४६-३०", "content_sanskrit": "ततः कृत्वा महर्षीणां यथार्हमभिवादनम् ।\nतत्र चैकां निशामुष्य यास्यामस्तां पुरीं पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000581030, "chapter_id": 9581, "verse_number": "७-४६-३१", "content_sanskrit": "ममापि पद्मपत्राक्षं सिंहोरस्कं कृशोदरम् ।\nत्वरते हि मनो द्रष्टुं रामं रमयतां वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000581031, "chapter_id": 9581, "verse_number": "७-४६-३२", "content_sanskrit": "तस्यास्तद्वचनं श्रुत्वा प्रमृज्य नयने शुभे ।\nनाविकानाह्वयामास लक्ष्मणः परवीरहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000581032, "chapter_id": 9581, "verse_number": "७-४६-३३", "content_sanskrit": "इयं च सज्जा नौश्चेति दाशाः प्राञ्जलयो ऽब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000581033, "chapter_id": 9581, "verse_number": "७-४६-३४", "content_sanskrit": "तितीर्षुर्लक्ष्मणो गङ्गां शुभां नावमुपारुहत् ।\nगङ्गां सन्तारयामास लक्ष्मणस्तां समाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000581034, "chapter_id": 9581, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे षट्चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]