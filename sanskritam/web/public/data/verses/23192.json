[{"id": 7003192000, "chapter_id": 23192, "verse_number": "४-१२८-१", "content_sanskrit": "अथाष्टाविंशत्यधिकशततमोऽध्यायः ।\nनारायण उवाच ।\nश्रीकृष्णश्च समाह्वानं गोपांश्चापि चकार सः ।\nभाण्डीरे वटमूले च तत्र स्वयमुवास ह ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003192001, "chapter_id": 23192, "verse_number": "४-१२८-२", "content_sanskrit": "पुराऽन्नं च ददौ तस्मै यत्रैव ब्राह्मणीगणः ।\nउवास राधिका देवी वामपार्श्वे हरेरपि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003192002, "chapter_id": 23192, "verse_number": "४-१२८-३", "content_sanskrit": "दक्षिणे नन्दगोपश्च यशोदासहितस्तथा ।\nतद्दक्षिणो वृषभानस्तद्वामे सा कलावती ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003192003, "chapter_id": 23192, "verse_number": "४-१२८-४", "content_sanskrit": "अन्ये गोपाश्च गोप्यश्च बान्धवाः सुहृदस्तथा ।\nतानुवाच स गोविन्दो यथार्थ्यं समयोचितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003192004, "chapter_id": 23192, "verse_number": "४-१२८-५", "content_sanskrit": "श्रीभगवानुवाच ।\nशृणु नन्द प्रवक्ष्यामि सांप्रतं समयोचितम् ।\nसत्यं च परमार्थं च परलोकसुखावहम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003192005, "chapter_id": 23192, "verse_number": "४-१२८-६", "content_sanskrit": "आब्रह्मस्तम्बपर्यन्तं भ्रमं सर्वं निशामय ।\nविद्युद्दीप्तिर्जले रेषा यथा तोयस्य बुद्बुदम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003192006, "chapter_id": 23192, "verse_number": "४-१२८-७", "content_sanskrit": "मथुरायां सर्वमुक्तं नावशेषं च किंचन ।\nयशोदां बोधयामास राधिका कदलीवने ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003192007, "chapter_id": 23192, "verse_number": "४-१२८-८", "content_sanskrit": "तदेव सत्यं परमं भ्रमध्वान्तप्रदीपकम् ।\nविहाय मिथ्यामायां च स्मर तत्परमं पदम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003192008, "chapter_id": 23192, "verse_number": "४-१२८-९", "content_sanskrit": "जन्ममृत्युजराव्याधिहरं हर्षकरं परम् ।\nशोकसंतापहरणं कर्ममूलनिकृन्तनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003192009, "chapter_id": 23192, "verse_number": "४-१२८-१०", "content_sanskrit": "मामेव परमं ब्रह्म भगवन्तं सनातनम् ।\nध्यायंध्यायं पुत्रबुद्धिं त्यक्त्वा लभ परंपदम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003192010, "chapter_id": 23192, "verse_number": "४-१२८-११", "content_sanskrit": "गोलोकं गच्छ शीघ्रं त्वं सार्धं गोकुलवासिभिः ।\nआरात्कलेरागमनं कर्ममूलनिकृन्तनम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003192011, "chapter_id": 23192, "verse_number": "४-१२८-१२", "content_sanskrit": "स्त्रीपुंसोर्नियमो नास्ति जातीनां च तथैव च ।\nविप्रेसन्ध्यादिकंनास्ति चिह्नं यज्ञोपवीतकम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003192012, "chapter_id": 23192, "verse_number": "४-१२८-१३", "content_sanskrit": "यज्ञसूत्रं च तिलकं शेषं लुप्तं सुनिश्चितम् ।\nदिवाव्यवायनिरतं विरतं धर्मकर्मणि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003192013, "chapter_id": 23192, "verse_number": "४-१२८-१४", "content_sanskrit": "यज्ञानां च व्रतानां च तपसां लुप्तमेव च ।\nकेदारकन्याशापेनधर्मो नास्त्येव केवलम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003192014, "chapter_id": 23192, "verse_number": "४-१२८-१५", "content_sanskrit": "स्वच्छन्दगामिनीस्त्रीर्णा पतिश्च सततं वशे ।\nताडयेत्सततंतं च भर्त्सयेच्छ दिवानिशम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003192015, "chapter_id": 23192, "verse_number": "४-१२८-१६", "content_sanskrit": "प्राधान्यं स्त्रीकुटुम्बानां स्त्रीणां च सततं व्रज ।\nस्वामीचभक्तस्तासां च पराभूतो निरन्तरम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003192016, "chapter_id": 23192, "verse_number": "४-१२८-१७", "content_sanskrit": "कलौ च योषितः सर्वा जारसेवासु तत्पराः ।\nशतपुत्रसमः स्नेहस्तासां जारे भविष्यति ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003192017, "chapter_id": 23192, "verse_number": "४-१२८-१८", "content_sanskrit": "ददाति तस्मै भक्ष्यं च यथा भृत्याय कोपतः ।\nसस्मिता सकटाक्षा साऽमृतदृष्ट्या निरन्तरम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003192018, "chapter_id": 23192, "verse_number": "४-१२८-१९", "content_sanskrit": "जारं पश्यति कामेन विषदृष्ट्या पतिं सदा ।\nसततं गौरवं तासां स्नेहं च जारबान्धवे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003192019, "chapter_id": 23192, "verse_number": "४-१२८-२०", "content_sanskrit": "पत्यौ करप्रहारं च नित्यं नित्यं करोति च ।\nमिष्टान्नं श्रद्धया भक्त्या जाराय प्रददाति  ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003192020, "chapter_id": 23192, "verse_number": "४-१२८-२१", "content_sanskrit": "वेषयुक्ता च सततं जारसेवनतत्परा ।\nप्राणा बन्धुर्गतिश्चाऽऽत्मा कलौ जारश्चयौषिता ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003192021, "chapter_id": 23192, "verse_number": "४-१२८-२२", "content_sanskrit": "लुप्ता चातिथिसेवा च प्रलुप्तं विष्णुसेवनम् ।\nपितृणामर्चनं चैव देवानां च तथैव च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003192022, "chapter_id": 23192, "verse_number": "४-१२८-२३", "content_sanskrit": "विष्णुवैष्णवयोर्द्वेषी सततं च नरो भवेत् ।\nवाममन्त्रोपासकाश्च चतुर्वर्णाश्च तत्पराः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003192023, "chapter_id": 23192, "verse_number": "४-१२८-२४", "content_sanskrit": "शालग्रामं च तुलसीं कुशं गङ्गोदकं तथा ।\nनस्पृशेन्मानवो धूर्तो म्लेच्छाचाररतः सदा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003192024, "chapter_id": 23192, "verse_number": "४-१२८-२५", "content_sanskrit": "कारणं कारणानां च सर्वेषां सर्वबीजकम् ।\nसुखदं मोक्षदं शश्वद्दातारं सर्वसंपदाम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003192025, "chapter_id": 23192, "verse_number": "४-१२८-२६", "content_sanskrit": "त्यक्त्वा मां परया भक्त्या क्षुद्रसंपत्प्रदायिनम् ।\nवेदनिघ्नं वाममन्त्रं जपेद्विप्रश्च मायया ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003192026, "chapter_id": 23192, "verse_number": "४-१२८-२७", "content_sanskrit": "सनातनी विष्णुमाया वञ्चितं तं करिष्यति ।\nममाऽऽज्ञयाभगवती जगतां च दुरत्यया ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003192027, "chapter_id": 23192, "verse_number": "४-१२८-२८", "content_sanskrit": "कलेर्दशसहस्राणि मदर्चा भुवि तिष्ठति ।\nतदर्धानि च वर्षाणि गङ्गा भुवनपावनी ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003192028, "chapter_id": 23192, "verse_number": "४-१२८-२९", "content_sanskrit": "तुलसी विष्णुभक्ताश्च यावद्गङ्गा च कीर्तनम् ।\nपुराणानि च स्वल्पानि तावदेव महीतले ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003192029, "chapter_id": 23192, "verse_number": "४-१२८-३०", "content_sanskrit": "मम चोत्कीर्तनं नास्ति एतदन्ते कलौ व्रज ।\nएकवर्णा भविष्यन्तिकिराता बलिनःशठाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003192030, "chapter_id": 23192, "verse_number": "४-१२८-३१", "content_sanskrit": "पित्रोः सेवा गुरोः सेवा सेवा च देवविप्रयोः ।\nविवर्जिता नराः सर्वे चातिथीनां तथैव च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003192031, "chapter_id": 23192, "verse_number": "४-१२८-३२", "content_sanskrit": "सस्यहीना भवेत्पृथ्वी साऽनावृष्ट्या निरन्तरम् ।\nफलहीनोऽपि वृक्षश्च जलहीना सरित्तथा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003192032, "chapter_id": 23192, "verse_number": "४-१२८-३३", "content_sanskrit": "वेदहीनो ब्राह्मणश्च बलहीनश्च भूपतिः ।\nजातिहीनाजनाःसर्वे म्लेच्छोभूपोभविष्यति ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003192033, "chapter_id": 23192, "verse_number": "४-१२८-३४", "content_sanskrit": "भृत्यवत्ताडयेत्तातं पुत्रः शिष्यस्तथा गुरुम् ।\nकान्तं च ताडयेत्कान्ता लुब्धकुक्कुटवद्गृही ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003192034, "chapter_id": 23192, "verse_number": "४-१२८-३५", "content_sanskrit": "नश्यन्ति सकला लोकाः कलौ शेषे च पापिनः ।\nसूर्याणामातपात्केचिज्जलौघेनापि केचन ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003192035, "chapter_id": 23192, "verse_number": "४-१२८-३६", "content_sanskrit": "हे गोपेन्द्र प्रतिकलौ न नश्यति वसुंधरा ।\nपुनःसृष्टौ भवेत्सत्यं सत्यबीजं निरन्तरम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003192036, "chapter_id": 23192, "verse_number": "४-१२८-३७", "content_sanskrit": "एतस्मिन्नन्तरे विप्र रथमेव मनोहरम् ।\nचतुर्योजनविस्तीर्णमूर्ध्वे च पञ्चयोजनम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003192037, "chapter_id": 23192, "verse_number": "४-१२८-३८", "content_sanskrit": "शुद्धस्फटिकसंकाशं रत्नेन्द्रसारनिर्मितम् ।\nअम्लानपारिजातानां मालाजालविराजितम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003192038, "chapter_id": 23192, "verse_number": "४-१२८-३९", "content_sanskrit": "मणीनां कौस्तुभानां च भूषणेन विभूषितम् ।\nअमूल्यरत्नकलशं हीरहारविलम्बितम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003192039, "chapter_id": 23192, "verse_number": "४-१२८-४०", "content_sanskrit": "मनोहरैः परिष्वक्तं सहस्रकोटिमन्दिरैः ।\nसहस्रद्वयचक्रं च सहस्रद्वयघोटकम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003192040, "chapter_id": 23192, "verse_number": "४-१२८-४१", "content_sanskrit": "सूक्ष्मवस्त्राच्छादितं च गोपीकोटीभिरावृतम् ।\nगोलोकादागतं तूर्णं ददृशुः सहसा व्रजे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003192041, "chapter_id": 23192, "verse_number": "४-१२८-४२", "content_sanskrit": "कृष्णाज्ञया तमारुह्य ययुर्गोलोकमुत्तमम् ।\nराधा कलावती देवीधन्या चायोनिसंभवा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003192042, "chapter_id": 23192, "verse_number": "४-१२८-४३", "content_sanskrit": "गोलोकाद गता गोप्यश्चायोनिसंभवाश्च ताः ।\nश्रुतिपत्न्यश्च ताः सर्वाः स्वशरीरेण नारद ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003192043, "chapter_id": 23192, "verse_number": "४-१२८-४४", "content_sanskrit": "सर्वे त्यक्त्वा शरीराणि नश्वराणि सुनिश्चितम् ।\nगोलोकं च ययौ राधा सार्घं गोकुलवासिभिः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003192044, "chapter_id": 23192, "verse_number": "४-१२८-४५", "content_sanskrit": "ददर्श विरजातीर्र नानारत्नविभूषितम् ।\nतदुत्तीर्य ययौ विप्र शतशृङ्गं च पर्वतम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003192045, "chapter_id": 23192, "verse_number": "४-१२८-४६", "content_sanskrit": "नानामणिगणाकीर्णं रासमण्डलमण्डितम् ।\nततो ययौ कियद्दूरं पुण्यं वृन्दावनं वनम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003192046, "chapter_id": 23192, "verse_number": "४-१२८-४७", "content_sanskrit": "सा ददर्शाक्षयवटमूर्ध्वे त्रिशतयोजनम् ।\nशतयोजनविस्तीर्णं शाखाकोटिसमावृतम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003192047, "chapter_id": 23192, "verse_number": "४-१२८-४८", "content_sanskrit": "रक्तवर्णैः फलौघैश्च स्थूलैरपि विभूषितम् ।\nगोपीकोटिसहस्रैश्च सार्धं वृन्दा मनोहरा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003192048, "chapter_id": 23192, "verse_number": "४-१२८-४९", "content_sanskrit": "अनुव्रजं सादरं च सस्मिता सा समाययौ ।\nअवरुङ्य रथात्तूर्णं राधां सा प्रणनाम च ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003192049, "chapter_id": 23192, "verse_number": "४-१२८-५०", "content_sanskrit": "रासेश्वरीं तां संभाष्य प्रविवेश स्वमालयम् ।\nरत्नसिंहासने रम्ये हीरहारसमन्विते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003192050, "chapter_id": 23192, "verse_number": "४-१२८-५१", "content_sanskrit": "वृन्दा तां वासयामास पादसेवनतत्परा ।\nसप्तभिश्च सखीभिश्च सेवितां श्वेतचामरैः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003192051, "chapter_id": 23192, "verse_number": "४-१२८-५२", "content_sanskrit": "आययुर्गोपिकाः सर्वा द्रष्टुं तां परमेश्वरीम् ।\nनन्दादिकं प्रकल्प्यैतद्राधा वासं पृथकपृथक् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003192052, "chapter_id": 23192, "verse_number": "४-१२८-५३", "content_sanskrit": "परमानन्दरूपा सा परमानन्दपूर्वकम् ।\nस्ववेश्मनि महारम्ये प्रतस्थे गोपिका सह ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]