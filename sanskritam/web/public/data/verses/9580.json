[{"id": 5000580000, "chapter_id": 9580, "verse_number": "७-४५-१", "content_sanskrit": "तेषां समुपविष्टानां सर्वेषां दीनचेतसाम् ।\nउवाच वाक्यं काकुत्स्थो मुखेन परिशुष्यता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000580001, "chapter_id": 9580, "verse_number": "७-४५-२", "content_sanskrit": "सर्वे शृणुत भद्रं वो मा कुरुध्वं मनो ऽन्यथा ।\nपौराणां मम सीतायां यादृशी वर्तते कथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000580002, "chapter_id": 9580, "verse_number": "७-४५-३", "content_sanskrit": "पौरापवादः सुमहांस्तथा जनपदस्य च ।\nवर्तते मयि बीभत्सा सा मे मर्माणि कृन्तति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000580003, "chapter_id": 9580, "verse_number": "७-४५-४", "content_sanskrit": "अहं किल कुले जात इक्ष्वाकूणां महात्मनाम् ।\nसीता ऽपि सत्कुले जाता जनकानां महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000580004, "chapter_id": 9580, "verse_number": "७-४५-५", "content_sanskrit": "जानासि त्वं यथा सौम्य दण्डके विजने वने ।\nरावणेन हृता सीता स च विध्वंसितो मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000580005, "chapter_id": 9580, "verse_number": "७-४५-६", "content_sanskrit": "तत्र मे बुद्धिरुत्पन्ना जनकस्य सुतां प्रति ।\nअत्रोषितामिमां सीतामानयेयं कथं पुरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000580006, "chapter_id": 9580, "verse_number": "७-४५-७", "content_sanskrit": "प्रत्ययार्थं ततः सीता विवेश ज्वलनं तदा ।\nप्रत्यक्षं तव सौमित्रे देवानां हव्यवाहनः ।\nअपापां मैथिलीमाह वायुश्चाकाशगोचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000580007, "chapter_id": 9580, "verse_number": "७-४५-८", "content_sanskrit": "चन्द्रादित्यौ च शंसेते सुराणां सन्निधौ पुरा ।\nऋषीणां चैव सर्वेषामपापां जनकात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000580008, "chapter_id": 9580, "verse_number": "७-४५-९", "content_sanskrit": "एवं शुद्धसमाचारा देवगन्धर्वसन्निधौ ।\nलङ्काद्वीपे महेन्द्रेण मम हस्ते निवेशिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000580009, "chapter_id": 9580, "verse_number": "७-४५-१०", "content_sanskrit": "अन्तरात्मा च मे वेत्ति सीतां शुद्धां यशस्विनीम् ।\nततो गृहीत्वा वैदेहीमयोध्यामहमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000580010, "chapter_id": 9580, "verse_number": "७-४५-११", "content_sanskrit": "अयं तु मे महान्वादः शोकश्च हृदि वर्तते ।\nपौरापवादः सुमहांस्तथा जनपदस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000580011, "chapter_id": 9580, "verse_number": "७-४५-१२", "content_sanskrit": "अकीर्तिर्यस्य गीयेत लोके भूतस्य कस्यचित् ।\nपतत्येवाधमाँल्लोकान्यावच्छब्दः प्रकीर्त्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000580012, "chapter_id": 9580, "verse_number": "७-४५-१३", "content_sanskrit": "अकीर्तिर्निन्द्यते देवैः कीर्तिर्लोकेषु पूज्यते ।\nकीर्त्यर्थं तु समारम्भः सर्वेषां सुमहात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000580013, "chapter_id": 9580, "verse_number": "७-४५-१४", "content_sanskrit": "अप्यहं जीवितं जह्यां युष्मान्वा पुरुषर्षभाः ।\nअपवादभयाद्भीतः किं पुनर्जनकात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000580014, "chapter_id": 9580, "verse_number": "७-४५-१५", "content_sanskrit": "तस्माद्भवन्तः पश्यन्तु पतितं शोकसागरे ।\nनहि पश्याम्यहं भूतं किञ्चिद्दुःखमतो ऽधिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000580015, "chapter_id": 9580, "verse_number": "७-४५-१६", "content_sanskrit": "श्वस्त्वं प्रभाते सौमित्रे सुमन्त्राधिष्ठितं रथम् ।\nआरुह्य सीतामारोप्य विषयान्ते समुत्सृज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000580016, "chapter_id": 9580, "verse_number": "७-४५-१७", "content_sanskrit": "गङ्गायास्तु परे पारे वाल्मीकेस्तु महात्मनः ।\nआश्रमो दिव्यसङ्काशस्तमसातीरमाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000580017, "chapter_id": 9580, "verse_number": "७-४५-१८", "content_sanskrit": "तत्रैनां विजने देशे विसृज्य रघुनन्दन ।\nशीघ्रमागच्छ भद्रं ते कुरुष्व वचनं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000580018, "chapter_id": 9580, "verse_number": "७-४५-१९", "content_sanskrit": "न चास्मिन् प्रतिवक्तव्यः सीतां प्रति कथञ्चन ।\nतस्मात्त्वं गच्छ सौमित्रे नात्र कार्या विचारणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000580019, "chapter_id": 9580, "verse_number": "७-४५-२०", "content_sanskrit": "अप्रीतिर्हि परा मह्यं त्वयेतत्प्रतिवारिते ।\nशापिता हि मया यूयं भुजाभ्यां जीवितेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000580020, "chapter_id": 9580, "verse_number": "७-४५-२१", "content_sanskrit": "ये मां वाक्यान्तरे ब्रूयुरनुनेतुं कथञ्चन ।\nअहिता नाम ते नित्यं मदभीष्टविघातनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000580021, "chapter_id": 9580, "verse_number": "७-४५-२२", "content_sanskrit": "मानयन्तु भवन्तो मां यदि मच्छासने स्थिताः ।\nइतो ऽद्य नीयतां सीता कुरुष्व वचनं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000580022, "chapter_id": 9580, "verse_number": "७-४५-२३", "content_sanskrit": "पूर्वमुक्तो ऽहमनया गङ्गातीरे ऽहमाश्रमान् ।\nपश्येयमिति तस्याश्च कामः संवर्त्यतामयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000580023, "chapter_id": 9580, "verse_number": "७-४५-२४", "content_sanskrit": "एवमुक्त्वा तु काकुत्स्थो बाष्पेण पिहिताननः ।\nप्रविवेश स धर्मात्मा भ्रातृभिः परिवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000580024, "chapter_id": 9580, "verse_number": "७-४५-२५", "content_sanskrit": "शोकसंलग्नहृदयो निशश्वास यथा द्विपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000580025, "chapter_id": 9580, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे पञ्चचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]