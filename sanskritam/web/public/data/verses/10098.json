[{"id": 6000098000, "chapter_id": 10098, "verse_number": null, "content_sanskrit": "अथ तृतीयाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "भगवतो नाभिभार्यायां मेरुदेव्याम् ऋषभनाम्ना प्रादुर्भावः", "range": "१८–२१"}]}, {"id": 6000098001, "chapter_id": 10098, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_003/BhP_05.003.001.m4a", "display_order": 2}, {"id": 6000098002, "chapter_id": 10098, "verse_number": "५-३-१", "content_sanskrit": "नाभिरपत्यकामोऽप्रजया मेरुदेव्या भगवन्तं यज्ञपुरुषमवहितात्माऽयजत॥ ५/३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_003/BhP_05.003.002.m4a", "display_order": 3, "topics": [{"text": "अनपत्येन आग्नीध्रपुत्रनाभिराजेन अपत्यकामनया भगवन्तमुद्दिश्य यजनम्", "range": "१–१७"}]}, {"id": 6000098003, "chapter_id": 10098, "verse_number": "५-३-२", "content_sanskrit": "तस्य ह वाव श्रद्धया शुद्धभावेन यजतः प्रवर्ग्येषु प्रचरत्सु द्रव्यदेशकालमन्त्रर्त्विग्दक्षिणा-विधानयोगोपपत्त्या दुरधिगमोऽपि भगवान् भागवतवत्सलतया सुप्रीत आत्मानमपराजितं निजजनाभिप्रायार्थविधित्सया गृहीतहृदयो हृदयङ्गमं मनोनयनानन्दनाभिरामावयवमाविश्चकार॥ ५/३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_003/BhP_05.003.003.m4a", "display_order": 4}, {"id": 6000098004, "chapter_id": 10098, "verse_number": "५-३-३", "content_sanskrit": "अथ हतमाविष्कृतभुजयुगलद्वयं हिरण्मयं पुरुषविशेषं कपिशकौशेयाम्बरधरमुरसि विलसच्छ्री-वत्सललामं दरवरवनरुहवनमालास्फूर्जामृतमणिगणप्रवरादिभिरुपलक्षितम् स्फुटकिरणप्रवर-मणिमयमुकुटकिरीटकुण्डलकटककटिसूत्रहारकेयूरनूपुराद्यङ्गभूषणविभूषितम् ऋत्विक्सदस्य- गृहपतयोऽधना इवोत्तमं धनमुपलभ्य सबहुमानमर्हणेनावनतशीर्षाण उपतस्थुः॥ ५/३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_003/BhP_05.003.004.m4a", "display_order": 5}, {"id": 6000098005, "chapter_id": 10098, "verse_number": "५-३-४", "content_sanskrit": "‘अर्हसि मुहुरर्हत्तमार्हणमस्माकं अनुपथानां नमो नम इत्येतावदेव सदुपशिक्षितं कोऽर्हति पुमान्प्रकृतिगुणव्यतिरेकमतिरनीश ईश्वरस्य प्रकृतिपुरुषयोः परस्यार्वाक्तनमतिर्नामरूपा-कृतिभिर्निरूपणं सकलजननिकायवृजिननिरसनशिवतमप्रवरगुणगणैकदेशकथनादृते॥ ५/३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_003/BhP_05.003.005.m4a", "display_order": 6}, {"id": 6000098006, "chapter_id": 10098, "verse_number": "५-३-५", "content_sanskrit": "परिजनानुरागविरचितस्तवलवसंशब्दसलिलकिसलयतुलसीदूर्वाङ्कुरैरपि सम्भृतया सपर्यया किल परम परितुष्यसि॥ ५/३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_003/BhP_05.003.006.m4a", "display_order": 7}, {"id": 6000098007, "chapter_id": 10098, "verse_number": "५-३-६", "content_sanskrit": "अथानयाऽपि भगवत इज्ययोरुसम्भारभरया न समुचितमर्थमिहोपलभामहे आत्मत एव अनुसवनमञ्जसाऽव्यतिरेकेणानुबोभूयमानाशेषपुरुषार्थस्वरूपस्य, किन्तु नाथ आशिष आशासानानामेतदभिसंराधनमात्रं भवितुमर्हति॥ ५/३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_003/BhP_05.003.007.m4a", "display_order": 8}, {"id": 6000098008, "chapter_id": 10098, "verse_number": "५-३-७", "content_sanskrit": "तद्यथा बालिशानां स्वयमात्मनः श्रेयः परमविदुषां परमपुरुष प्रबलतरकरुणया स्वमहिमानं चापवर्गाख्यमुपकल्पयिष्यन्स्वयत्नोपचित एवेतरवदिहोपलक्षितः॥ ५/३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_003/BhP_05.003.008.m4a", "display_order": 9}, {"id": 6000098009, "chapter_id": 10098, "verse_number": "५-३-८", "content_sanskrit": "अथार्हयामः परं ह्यर्हत्तम यर्हि बर्हिषि राजर्षेर्वरदर्षभो भगवान् निजपुरुषेक्षणविषय आसीत्॥ ५/३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_003/BhP_05.003.009.m4a", "display_order": 10}, {"id": 6000098010, "chapter_id": 10098, "verse_number": "५-३-९", "content_sanskrit": "असङ्गनिशितज्ञानानलविधूताशेषमलानां भगवत्स्वभावानां आत्मारामाणां मुनीनामनवरत-परिगणितगुणगण परममङ्गलायतनकथनोऽसि॥ ५/३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_003/BhP_05.003.010.m4a", "display_order": 11}, {"id": 6000098011, "chapter_id": 10098, "verse_number": "५-३-१०", "content_sanskrit": "अथ कथञ्चित्स्खलनक्षुत्पतनजृम्भणदुःखस्थानादिषु विवशानां नः श्रीमच्चरणारविन्दस्मरणाय ज्वरमरणदशायामपि सकलकश्मलनिरसनानि तव गुणकृतनामधेयानि वचनगोचराणि भवन्तु॥ ५/३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_003/BhP_05.003.011.m4a", "display_order": 12}, {"id": 6000098012, "chapter_id": 10098, "verse_number": "५-३-११", "content_sanskrit": "किञ्चायं राजर्षिरपत्यकामः प्रजां भवादृशीमाशासन ईश्वरमाशिषां स्वर्गापवर्गयोरपि भगवन्त-मुपधावति प्रजायामर्थप्रत्ययो धनदमिवाधनः, फलीकरणं को वा ईहते अपराजित अपराजितया माययाऽनवसितपदध्यानव्यावृतमतिःविषमविषयावृतप्रकृतिरनुपासितमहच्चरणः॥ ५/३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_003/BhP_05.003.012.m4a", "display_order": 13}, {"id": 6000098013, "chapter_id": 10098, "verse_number": "५-३-१२", "content_sanskrit": "यदु ह वाव पुनरदभ्रकर्तरिह समाहूतः तदर्थधियां मन्दानां नस्तद्देवहेलनं देवार्हसि साम्येन सर्वात्मना प्रतिवोढुमविदुषाम्’॥ ५/३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_003/BhP_05.003.013.m4a", "display_order": 14}, {"id": 6000098014, "chapter_id": 10098, "verse_number": "५-३-१३", "content_sanskrit": "इति निगदेनाभिष्टूयमानो भगवाननिमिषर्षभो वर्षधराभिवन्दितचरणः सदयमिदमाह॥ ५/३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_003/BhP_05.003.014.m4a", "display_order": 15}, {"id": 6000098015, "chapter_id": 10098, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_003/BhP_05.003.015.m4a", "display_order": 16}, {"id": 6000098016, "chapter_id": 10098, "verse_number": "५-३-१४–१६", "content_sanskrit": "‘अहो बताहमृषयो भवद्भिरवितथगीर्भिर्वरमसुलभमभियाचितो यदमुष्य आत्मजो मया सदृशो भूयादिति, ममाहमेवाभिरूपः, कैवल्याद् अथापि ब्रह्मवादो न मृषा भवितुमर्हति ममैव हि मुखं यद्द्विजदेवकुलम्।\nतत आग्नीध्रीये क्षेत्रेऽहं कलयाऽवतरिष्यामि आत्मतुल्यमनुपलभमानः’ इति निशामयन्त्या मेरुदेव्याः पतिं समभिधायान्तर्दधे भगवान्॥ ५/३/१४-१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_003/BhP_05.003.016.m4a", "display_order": 17}, {"id": 6000098017, "chapter_id": 10098, "verse_number": "५-३-१७", "content_sanskrit": "बर्हिषि तस्मिन् एवं विष्णुरात भगवन्परमर्षिभिः प्रसादितो नाभेः प्रियचिकीर्षया तदवरोधजने मेरुदेव्यां च धर्मान् दर्शयितुकामो वातरशनानां श्रमणानाम् ऋषीणामूर्ध्वमन्थिनां शुक्लया तनुवा अवततार॥ ५/३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_003/BhP_05.003.017.m4a", "display_order": 18}, {"id": 6000098018, "chapter_id": 10098, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां पञ्चमस्कन्धे तृतीयाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]