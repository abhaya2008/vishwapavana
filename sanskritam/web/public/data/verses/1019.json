[{"id": 2001352, "chapter_id": 1019, "verse_number": "१-२०-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001353, "chapter_id": 1019, "verse_number": "१-२०-१", "content_sanskrit": "एतत्ते कथितं सर्वममृतं मथितं यथा।\nयत्र सोऽश्वः समुत्पन्नः श्रीमानतुलविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001354, "chapter_id": 1019, "verse_number": "१-२०-२", "content_sanskrit": "तं निशाम्य तदा कद्रूर्विनतामिदमब्रवीत्।\nउच्चैःश्रवा हि किंवर्णो भद्रे प्रब्रूहि मा चिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001355, "chapter_id": 1019, "verse_number": "१-२०-३x", "content_sanskrit": "विनतोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001356, "chapter_id": 1019, "verse_number": "१-२०-३", "content_sanskrit": "श्वेत एवाश्वराजोऽयं किं वा त्वं मन्यसे शुभे।\nब्रूहि वर्णं त्वमप्यस्य ततोऽत्र विपणावहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001357, "chapter_id": 1019, "verse_number": "१-२०-४x", "content_sanskrit": "कद्रूरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001358, "chapter_id": 1019, "verse_number": "१-२०-४", "content_sanskrit": "कृष्णवालमहं मन्ये हयमेनं शुचिस्मिते।\nएहि सार्धं मया दीव्य दासीभावाय भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001359, "chapter_id": 1019, "verse_number": "१-२०-५x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001360, "chapter_id": 1019, "verse_number": "१-२०-५", "content_sanskrit": "एवं ते समयं कृत्वा दासीभावाय वै मिथः।\nजग्मतुः स्वगृहानेव श्वो द्रक्ष्याव इति स्म ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001361, "chapter_id": 1019, "verse_number": "१-२०-६", "content_sanskrit": "ततः पुत्रसहस्रं तु कद्रूर्जिह्यं चिकीर्षती।\nआज्ञापयामास तदा वाला भूत्वाऽञ्जनप्रभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001362, "chapter_id": 1019, "verse_number": "१-२०-७", "content_sanskrit": "आविशध्वं हयं क्षिप्रं दासी न स्यामहं यथा।\nनावपद्यन्त ये वाक्यं ताञ्शशाप भुजंगमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001363, "chapter_id": 1019, "verse_number": "१-२०-८", "content_sanskrit": "सर्पसत्रे वर्तमाने पावको वः प्रधक्ष्यति।\nजनमेजयस्य राजर्षेः पाण्डवेयस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001364, "chapter_id": 1019, "verse_number": "१-२०-९", "content_sanskrit": "शापमेनं तु शुश्राव स्वयमेव पितामहः।\nअतिक्रूरं समुत्सृष्टं कद्र्वा दैवादतीव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2001365, "chapter_id": 1019, "verse_number": "१-२०-१०", "content_sanskrit": "सार्धं देवगणैः सर्वैर्वाचं तामन्वमोदत।\nबहुत्वं प्रेक्ष्य सर्पाणां प्रजानां हितकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2001366, "chapter_id": 1019, "verse_number": "१-२०-११", "content_sanskrit": "तिग्मवीर्यविषा ह्येते दन्दशूका महाबलाः।\nतेषां तीक्ष्णविषत्वाद्धि प्रजानां च हिताय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2001367, "chapter_id": 1019, "verse_number": "१-२०-१२", "content_sanskrit": "युक्तं मात्रा कृतं तेषां परपीडोपसर्पिणाम्।\nअन्येषामपि सत्त्वानां नित्यं दोषपरास्तु ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2001368, "chapter_id": 1019, "verse_number": "१-२०-१३", "content_sanskrit": "तेषां प्राणान्तिको दण्डो दैवेन विनिपात्यते।\nएवं संभाष्य देवस्तु पूज्य कद्रूं च तां तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2001369, "chapter_id": 1019, "verse_number": "१-२०-१४", "content_sanskrit": "आहूय कश्यपं देव इदं वचनमब्रवीत्।\nयदेते दन्दशूकाश्च सर्पा जातास्त्वयानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2001370, "chapter_id": 1019, "verse_number": "१-२०-१५", "content_sanskrit": "विषोल्बणा महाभोगा मात्रा शप्ताः परंतप।\nतत्र मन्युस्त्वया तात न कर्तव्यः कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2001371, "chapter_id": 1019, "verse_number": "१-२०-१६", "content_sanskrit": "दृष्टं पुरातनं ह्येतद्यज्ञे सर्पविनाशनम्।\nइत्युक्त्वा सृष्टिकृद्देवस्तं प्रसाद्य प्रजापतिम्।\nप्रादाद्विषहरीं विद्यां कश्यपाय महात्मने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2001372, "chapter_id": 1019, "verse_number": "१-२०-१७", "content_sanskrit": "एवं शप्तेषु नागेषु कद्र्वातु द्विजसत्तम।\nअद्विग्नः शापतस्तस्याः कद्रूं कर्कोटकोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2001373, "chapter_id": 1019, "verse_number": "१-२०-१८", "content_sanskrit": "मातरं परमप्रीतस्तथा भुजगसत्तमः।\nआविश्य वाजिनं मुख्यं बालो भूत्वाञ्जनप्रभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2001374, "chapter_id": 1019, "verse_number": "१-२०-१९", "content_sanskrit": "दर्शयिष्यामि तत्राहमात्मानं काममाश्वस।\nएवमस्त्विति सा पुत्रं प्रत्युवाच यशस्विनी॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2001375, "chapter_id": 1019, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकर्पणि विंशोऽध्यायः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]