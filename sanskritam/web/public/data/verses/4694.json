[{"id": 2173642, "chapter_id": 4694, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2173643, "chapter_id": 4694, "verse_number": "१", "content_sanskrit": "तस्मिंस्तु निहते साल्वे शूरे समितिशोभने ।\nतवाभज्यद्बलं वेगाद् वातेनेव महाद्रुमः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2173644, "chapter_id": 4694, "verse_number": "२", "content_sanskrit": "तत् प्रभग्नं बलं दृष्ट्वा कृतवर्मा महारथः ।\nदधार समरे शूरः शत्रुसेनां महाबलः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2173645, "chapter_id": 4694, "verse_number": "३", "content_sanskrit": "सन्निवृत्तास्तु ते वीरा दृष्ट्वा सात्त्वतमाहवे ।\nशैलोपमं स्थितं राजन् विकिरन्तं शरान् युधि\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2173646, "chapter_id": 4694, "verse_number": "४", "content_sanskrit": "ततः प्रववृते युद्धं कुरूणां पाण्डवैः सह ।\nनिवृत्तानां महाराज मृत्युं कृत्वा निवर्तनम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2173647, "chapter_id": 4694, "verse_number": "५", "content_sanskrit": "तत्राश्चर्यमभूद्युद्धं सात्वतस्य परैः सह ।\nयदेको वारयामास पाण्डुसेनां दुरासदाम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2173648, "chapter_id": 4694, "verse_number": "६", "content_sanskrit": "तेषामन्योन्यसुहृदां कृते कर्मणि दुष्करे ।\nसिंहनादः प्रहृष्टानां दिविस्पृक् सुमहानभूत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2173649, "chapter_id": 4694, "verse_number": "७", "content_sanskrit": "तेन शब्देन वित्रस्तान् पाञ्चालान् भरतर्षभ ।\nशिनेर्नप्ता महाबाहुरन्वपद्यत सात्यकिः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2173650, "chapter_id": 4694, "verse_number": "८", "content_sanskrit": "स समासाद्य राजानं क्षेमधूर्तिं महाबलम् ।\nसप्तभिर्निशितैर्बाणैरनयद् यमसादनम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2173651, "chapter_id": 4694, "verse_number": "९", "content_sanskrit": "तमायान्तं महाबाहुं प्रवर्षन्तं शरान् बहून् ।\nजवेनाभ्यपतद्धीमान् हार्दिकः शिनिपुङ्गवम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2173652, "chapter_id": 4694, "verse_number": "१०", "content_sanskrit": "तौ सिंहाविव नर्दन्तौ धन्विनौ रथिनां वरौ ।\nअन्योन्यमभ्यधावेतां शस्त्रप्रवरधारिणौ\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2173653, "chapter_id": 4694, "verse_number": "११", "content_sanskrit": "पाण्डवाः सह पाञ्चालैर्योधाश्चान्ये नृपोत्तम ।\nप्रेक्षकाः समपद्यन्त तयोर्घोरे समागमे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2173654, "chapter_id": 4694, "verse_number": "१२", "content_sanskrit": "नाराचैर्वत्सदन्तैश्च वृष्ण्यन्धकमहारथौ ।\nअभिजघ्नतुरन्योन्यं प्रहृष्टाविव कुञ्जरौ\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2173655, "chapter_id": 4694, "verse_number": "१३", "content_sanskrit": "चरन्तौ विविधान् मार्गान् हार्दिक्यशिनिपुङ्गवौ ।\nमुहुरन्तर्दधाते तौ बाणवृष्ट्या परस्परम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2173656, "chapter_id": 4694, "verse_number": "१४", "content_sanskrit": "चापवेगबलोद्धूतान् मार्गणान् वृष्णिसिंहयोः ।\nआकाशे समपश्याम पतङ्गानिव शीघ्रगान्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2173657, "chapter_id": 4694, "verse_number": "१५", "content_sanskrit": "तमेकं सत्यकर्माणमासाद्य हृदिकात्मजः ।\nअविध्यन्निशितैर्बाणैश्चतुर्भिश्चतुरो हयान्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2173658, "chapter_id": 4694, "verse_number": "१६", "content_sanskrit": "स दीर्घबाहुः सङ्क्रुद्धस्तोत्रार्दित इव द्विपः ।\nअष्टाभिः कृतवर्माणमविध्यत् परमेषुभिः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2173659, "chapter_id": 4694, "verse_number": "१७", "content_sanskrit": "ततः पूर्णायतोत्सृष्टैः कृतवर्मा शिलीमुखैः ।\nसात्यकिं त्रिभिराहत्य धनुरेकेन चिच्छिदे\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2173660, "chapter_id": 4694, "verse_number": "१८", "content_sanskrit": "निकृत्तं तद्धनुःश्रेष्ठमपास्य शिनिपुङ्गवः ।\nअन्यदादत्त वेगेन शैनेयः सशरं धनुः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2173661, "chapter_id": 4694, "verse_number": "१९", "content_sanskrit": "तदादाय धनुःश्रेष्ठं वरिष्ठं सर्वधन्विनाम् ।\nआरोप्य च महावीर्यो महाबुद्धिर्महाबलः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2173662, "chapter_id": 4694, "verse_number": "२०", "content_sanskrit": "अमृष्यमाणो धनुषः छेदनं कृतवर्मणः ।\nकुपितोऽतिरथः शीघ्रं कृतवर्माणमभ्ययात्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2173663, "chapter_id": 4694, "verse_number": "२१", "content_sanskrit": "ततः स दशभिर्बाणैर्निशितैः नतपर्वभिः ।\nजघान चाश्वान् सूतं च ध्वजं च कृतवर्मणः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2173664, "chapter_id": 4694, "verse_number": "२२", "content_sanskrit": "ततो राजन् महेष्वासः कृतवर्मा महारथः ।\nहताश्वसूतं सम्प्रेक्ष्य रथं हेमपरिष्कृतम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2173665, "chapter_id": 4694, "verse_number": "२३", "content_sanskrit": "रोषेण महताऽऽविष्टः शूलमुद्यम्य मारिष ।\nचिक्षेप भुजवेगेन जिघांसुः शिनिपुङ्गवम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2173666, "chapter_id": 4694, "verse_number": "२४", "content_sanskrit": "तच्छूलं सात्वतोऽप्याजौ निर्भिद्य निशितैः शरैः ।\nचूर्णितं पातयामास मोहयन्निव माधवः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2173667, "chapter_id": 4694, "verse_number": "२५", "content_sanskrit": "ततोऽपरेण भल्लेन हृद्येनं समताडयत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2173668, "chapter_id": 4694, "verse_number": "२६", "content_sanskrit": "स युद्धे युयुधानेन हताश्वो हतसारथिः ।\nकृतवर्मा कृतास्त्रेण धरणीमन्वपद्यत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2173669, "chapter_id": 4694, "verse_number": "२७", "content_sanskrit": "तस्मिन् सात्यकिना वीरे द्वैरथे विरथीकृते ।\nसमपद्यत सर्वेषां सैन्यानां सुमहद्भयम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2173670, "chapter_id": 4694, "verse_number": "२८", "content_sanskrit": "पुत्रस्य तव चात्यर्थं विषादः समपद्यत\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2173671, "chapter_id": 4694, "verse_number": "२९", "content_sanskrit": "हतसूते हताश्वे च विरथे कृतवर्मणि ।\nहताश्वं च समालक्ष्य हतसूतमरिन्दमम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2173672, "chapter_id": 4694, "verse_number": "३०", "content_sanskrit": "अभ्यधावत् कृपो राजन् जिघांसुः शिनिपुङ्गवम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2173673, "chapter_id": 4694, "verse_number": "३१", "content_sanskrit": "तमारोप्य रथोपस्थे मिषतां सर्वधन्विनाम् ।\nअपोवाह महाराज तूर्णमायोधनादपि\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2173674, "chapter_id": 4694, "verse_number": "३२", "content_sanskrit": "शैनेयेऽधिष्ठिते राजन् विरथे कृतवर्मणि ।\nदुर्योधनबलं सर्वं पुनरासीत् पराङ्मुखम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2173675, "chapter_id": 4694, "verse_number": "३३", "content_sanskrit": "तत् परे नान्वबुध्यन्त सैन्ये च रजसा वृते ।\nतावद् विप्रद्रुतं राजन् दुर्योधनमृते नृप\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2173676, "chapter_id": 4694, "verse_number": "३४", "content_sanskrit": "दुर्योधनस्तु सम्प्रेक्ष्य भग्नं स्वबलमन्तिकात् ।\nजवेनाभ्यपतत् तूर्णं सर्वांश्चैको न्यवारयत्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2173677, "chapter_id": 4694, "verse_number": "३५", "content_sanskrit": "पाण्डवान् समरे क्रुद्धो धृष्टद्युम्नं च पार्षतम् ।\nशिखण्डिनं द्रौपदेयान् पाञ्चालानां च ये गणाः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2173678, "chapter_id": 4694, "verse_number": "३६", "content_sanskrit": "केकयान् सोमकांश्चैव योधयामास मारिष\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2173679, "chapter_id": 4694, "verse_number": "३७", "content_sanskrit": "असम्भ्रमं दुराधर्षः शितैरस्त्रैरवाकिरत् ।\nअतिष्ठदाहवे यत्तः पुत्रस्तव महाबलः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2173680, "chapter_id": 4694, "verse_number": "३८", "content_sanskrit": "यथा यज्ञे महानग्निर्मन्त्रपूतः प्रकाशते\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2173681, "chapter_id": 4694, "verse_number": "३९", "content_sanskrit": "तं परे नात्यवर्तन्त मर्त्या मृत्युमिवाहवे ।\nअथान्यं रथमास्थाय हार्दिक्यः समवर्तत\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2173682, "chapter_id": 4694, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशल्यपर्वणि एकविंशोऽध्यायः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2173683, "chapter_id": 4694, "verse_number": "२१", "content_sanskrit": "शल्यवधपर्वणि एकविंशोऽध्यायः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]