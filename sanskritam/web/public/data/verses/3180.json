[{"id": 2101228, "chapter_id": 3180, "verse_number": "१४-३६-१", "content_sanskrit": "अर्जुन उवाच।\nब्रह्म यत्परमं ज्ञेयं तन्मे व्याख्यातुमर्हसि।\nभतो हि प्रसादेन सूक्ष्मे मे रमते मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101229, "chapter_id": 3180, "verse_number": "१४-३६-२x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101230, "chapter_id": 3180, "verse_number": "१४-३६-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nसंवादं मोक्षसंयुक्तं शिष्यस्य गुरुणा सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101231, "chapter_id": 3180, "verse_number": "१४-३६-३", "content_sanskrit": "कश्चिद्ब्राह्मणमासीनमाचार्यं संशितव्रतम्।\nशिष्यः पप्रच्छ मेधावी किंस्विच्छ्रेयः परंतप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101232, "chapter_id": 3180, "verse_number": "१४-३६-४", "content_sanskrit": "भगवन्तं प्रपन्नोऽहं निःश्रेयसपराणः।\nयाचे त्वां शिरसा विप्र यद्ब्रूयां ब्रूहि तन्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101233, "chapter_id": 3180, "verse_number": "१४-३६-५", "content_sanskrit": "तमेवंवादिनं पार्थ शिष्यं गुरुरुवाच ह।\nकथयस्व प्रवक्ष्यामि यत्र ते संशयो द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101234, "chapter_id": 3180, "verse_number": "१४-३६-६", "content_sanskrit": "इत्युक्तः स कुरुश्रेष्ठ गुरुणा गुरुवत्सलः।\nप्राञ्जलिः परिपप्रच्छ यत्तच्छृणु महामते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101235, "chapter_id": 3180, "verse_number": "१४-३६-७x", "content_sanskrit": "शिष्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101236, "chapter_id": 3180, "verse_number": "१४-३६-७", "content_sanskrit": "कुतश्चाहं कुतश्च त्वं तत्सत्यं ब्रूहि यत्परम्।\nकुतो जातानि भूतानि स्थावराणि चराणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2101237, "chapter_id": 3180, "verse_number": "१४-३६-८", "content_sanskrit": "केन जीवन्ति भूतानि तेषामायुश्च किं परम्।\nकिं सत्यं किं तपो विप्र के गुणाः सद्भिरीरिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2101238, "chapter_id": 3180, "verse_number": "१४-३६-९", "content_sanskrit": "के पन्थानः शिवाश्च स्युः किं सुखं कि च दुष्कृतम्।\nएतान्मे भगवन्प्रश्नान्याथातथ्येन सुव्रत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2101239, "chapter_id": 3180, "verse_number": "१४-३६-१०", "content_sanskrit": "वक्तुमर्हसि विप्रर्षे यथावदिह तत्त्वतः।\nत्वदन्यः कश्च न प्रश्नानेतान्वक्तुमिहार्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2101240, "chapter_id": 3180, "verse_number": "१४-३६-११", "content_sanskrit": "ब्रूहि धर्मविदां श्रेष्ठ परं कौतूहलं मम।\nमोक्षधर्मार्थकुशलो भवाँल्लोकषु गीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2101241, "chapter_id": 3180, "verse_number": "१४-३६-१२", "content_sanskrit": "सर्वसंशयसंच्छेत्ता त्वदन्यो न च विद्यते।\nसंसारभीरवश्चैव मोक्षकामास्तथा वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2101242, "chapter_id": 3180, "verse_number": "१४-३६-१३x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2101243, "chapter_id": 3180, "verse_number": "१४-३६-१३", "content_sanskrit": "तस्मै सम्प्रतिपन्नाय यथावत्परिपृच्छते।\nशिष्याय गुणयुक्ताय शान्ताय गुरुवर्तिने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2101244, "chapter_id": 3180, "verse_number": "१४-३६-१४", "content_sanskrit": "छायाभूताय दान्ताय यतते ब्रह्माचारिणे।\nतान्प्रश्नानब्रवीत्पार्थ मेधावी स धृतव्रतः।\nगुरुः कुरुकुलश्रेष्ठ सम्यक्सर्वानरिंदम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2101245, "chapter_id": 3180, "verse_number": "१४-३६-१५x", "content_sanskrit": "गुरुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2101246, "chapter_id": 3180, "verse_number": "१४-३६-१५", "content_sanskrit": "ब्रह्मणोक्तमिदं धर्ममृषिप्रवरसेवितम्।\nवेदविद्यासमावाप्तं तत्त्वभूतार्थभावनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2101247, "chapter_id": 3180, "verse_number": "१४-३६-१६", "content_sanskrit": "ज्ञानं त्वेव परं विद्यः संन्यासं तप उत्तमम्।\nयस्तु वेद निराबाधं ज्ञानतत्त्वं विनिश्चयात्।\nसर्वबूतस्थमात्मानं स सर्वगतिरिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2101248, "chapter_id": 3180, "verse_number": "१४-३६-१७", "content_sanskrit": "ये विद्वान्सहसंवासं विवासं चैव पश्यति।\nतथैवैकत्वनानात्वे स दुःखात्परिमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2101249, "chapter_id": 3180, "verse_number": "१४-३६-१८", "content_sanskrit": "यो न कामयते किञ्चिन्न किञ्चिदभिमन्यते।\nइह लोकस्थ एवैष ब्रह्मभूयाय कल्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2101250, "chapter_id": 3180, "verse_number": "१४-३६-१९", "content_sanskrit": "प्रधानगुणतत्त्वज्ञः सर्वभूतविधानवित्।\nनिर्ममो निरहङ्कारो मुच्यते नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2101251, "chapter_id": 3180, "verse_number": "१४-३६-२०", "content_sanskrit": "अव्यक्तबीजप्रभवो बुद्धिस्कन्धमयो महान्।\nमहाहङ्कारविटप इन्द्रियाङ्कुरकोटरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2101252, "chapter_id": 3180, "verse_number": "१४-३६-२१", "content_sanskrit": "महाभूतविशेषश्च विशेषप्रतिशाखवान्।\nसदापर्णः सदापुष्पः शुभाशुभफलोदयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2101253, "chapter_id": 3180, "verse_number": "१४-३६-२२", "content_sanskrit": "आजीवः सर्वभूतानां ब्रह्मबीजः सनातनः।\nएतज्ज्ञात्वा च तत्त्वानि ज्ञानेन परमासिना।\nछित्त्वा चामरतां प्राप्य जहाति मृत्युजन्मनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2101254, "chapter_id": 3180, "verse_number": "१४-३६-२३", "content_sanskrit": "भूतभव्यभविष्यादिधर्मकामार्थनिश्चयम्।\nसिद्धसङ्घपरिज्ञातं पुराकल्पं सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2101255, "chapter_id": 3180, "verse_number": "१४-३६-२४", "content_sanskrit": "प्रवक्ष्येऽहं महाप्राज्ञ पदमुत्तममद्य ते।\nबुद्ध्वा यदिहं संसिद्धा भवन्तीह मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2101256, "chapter_id": 3180, "verse_number": "१४-३६-२५", "content_sanskrit": "उपगम्यर्षयः पूर्वं जिज्ञासन्तः परस्परम्।\nप्रजापतिभरद्वाजौ गौतमो भार्गवस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2101257, "chapter_id": 3180, "verse_number": "१४-३६-२६", "content_sanskrit": "वसिष्ठः कश्यपश्चैव विश्वामित्रोऽत्रिरेव च।\nमार्गान्सर्वान्परिक्रम्य परिश्रान्तः स्वकर्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2101258, "chapter_id": 3180, "verse_number": "१४-३६-२७", "content_sanskrit": "ऋषिमाङ्गिरसं वृद्धं पुरस्कृत्य तु ते द्विजाः।\nददृशुर्ब्रह्मभवने ब्रह्माणं वीतकल्मषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2101259, "chapter_id": 3180, "verse_number": "१४-३६-२८", "content_sanskrit": "तं प्रणम्य महात्मानं सुखासीनं महर्षयः।\nपप्रच्छुर्विनयोपेता नैःश्रेयसमिदं परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2101260, "chapter_id": 3180, "verse_number": "१४-३६-२९", "content_sanskrit": "कथं कर्म कृतं साधु कथं मुच्येत किल्बिषात्।\nके नो मार्गाः शिवाश्च स्युः किं सत्यं किं च दुष्कृतं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2101261, "chapter_id": 3180, "verse_number": "१४-३६-३०", "content_sanskrit": "कौ चोभौ कर्मणां मार्गौ प्राप्नुयुर्दक्षिणोत्तरौ।\nनिरयं चापवर्गं च भूतानां प्रभवाप्ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2101262, "chapter_id": 3180, "verse_number": "१४-३६-३१", "content_sanskrit": "इत्युक्तः स मुनिश्रेष्ठैर्यदाह प्रपितामहः।\nतत्तेऽहं सम्प्रवक्ष्यामि शृणु शिष्य यथागमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2101263, "chapter_id": 3180, "verse_number": "१४-३६-३२x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2101264, "chapter_id": 3180, "verse_number": "१४-३६-३२", "content_sanskrit": "सत्याद्भूतानि जातानि स्थावराणि चराणि च।\nतपसा तानि जीवन्ति जीवितं तद्धि सुव्रतम्।\nस्वां योनिं पुनरागम्य वर्तते स्वेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2101265, "chapter_id": 3180, "verse_number": "१४-३६-३३", "content_sanskrit": "सत्यं हि गुणसंयुक्तं नियतं पञ्चलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2101266, "chapter_id": 3180, "verse_number": "१४-३६-३४", "content_sanskrit": "ब्रह्म सत्यं तपः सत्यं सत्यं चैव प्रजापतिः।\nसत्याद्भूतानि जातानि सत्यं भूतमयं जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2101267, "chapter_id": 3180, "verse_number": "१४-३६-३५", "content_sanskrit": "तस्मात्सत्याश्रया विप्रा नित्यं योगपरायणाः।\nअतीक्रोधसंतापा नियता धर्मसेतवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2101268, "chapter_id": 3180, "verse_number": "१४-३६-३६", "content_sanskrit": "अन्योन्यनियतान्वैद्यान्धर्मसेतुप्रवर्तकान्।\nतानहं सम्प्रवक्ष्यामि शाश्वताँल्लोकभावनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2101269, "chapter_id": 3180, "verse_number": "१४-३६-३७", "content_sanskrit": "चातुर्विद्यं तथा वर्णांश्चातुराश्रमिकान्पृथक्।\nधर्ममेकं चतुष्पादं नित्यमाहुर्मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2101270, "chapter_id": 3180, "verse_number": "१४-३६-३८", "content_sanskrit": "पन्थानं वः प्रवक्ष्यामि शिवं क्षेमकरं द्विजाः।\nनियतं ब्रह्मभावाय यातं पूर्वं मनीषिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2101271, "chapter_id": 3180, "verse_number": "१४-३६-३९", "content_sanskrit": "गदन्तस्तु ममाद्येह पन्थानं दुर्विदं परैः।\nनिबोधत महाभागा निखिलेन परं पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2101272, "chapter_id": 3180, "verse_number": "१४-३६-४०", "content_sanskrit": "ब्रह्मचर्यमिहैवाहुराश्रमं प्रथमं पदम्।\nगार्हस्थ्यं तु द्वितीयं स्याद्वानप्रस्थमतः परम्।\nततः परं तु विज्ञेयमध्यात्मं परमं पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2101273, "chapter_id": 3180, "verse_number": "१४-३६-४१", "content_sanskrit": "ज्योतिराकाशमादित्यो वायुरिन्द्रः प्रजापतिः।\nनोपैति यावदध्यात्मं तावदेतान्न पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2101274, "chapter_id": 3180, "verse_number": "१४-३६-४२", "content_sanskrit": "तस्योपायं प्रवक्ष्यामि पुरस्तात्तं निबोधत।\nफलमूलानिलभुजां मुनीनां वसतां वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2101275, "chapter_id": 3180, "verse_number": "१४-३६-४३", "content_sanskrit": "वानप्रस्थं द्विजातीनां त्रयाणामुपदिश्यते।\nसर्वेषामेव वर्णानां गृहस्थोऽयं विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2101276, "chapter_id": 3180, "verse_number": "१४-३६-४४", "content_sanskrit": "श्रद्धालक्षणमित्येकं धर्मं धीराः प्रचक्षते।\n`नैष्ठिकोऽथ यतिर्वाऽपि विरक्तो ब्रह्मदर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2101277, "chapter_id": 3180, "verse_number": "१४-३६-४५", "content_sanskrit": "इत्येवं देवयाना वः पन्थानः परिकीर्तिताः।\nसद्भिरध्यासिता धीरैः कर्मभिर्धर्मसेतवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2101278, "chapter_id": 3180, "verse_number": "१४-३६-४६", "content_sanskrit": "एतेषां पृथगध्यास्ते यो धर्मं संशितव्रतः।\nकालात्पश्यति भूतानां सदैव प्रभवाप्ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2101279, "chapter_id": 3180, "verse_number": "१४-३६-४७", "content_sanskrit": "अतस्तत्त्वानि वक्ष्यामि याथातथ्येन हेतुना।\nविषयस्थानि सर्वाणि वर्तमानानि भागशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2101280, "chapter_id": 3180, "verse_number": "१४-३६-४८", "content_sanskrit": "महानात्मा तथाऽव्यक्तमहंकारस्तथैव च।\nइन्द्रियाणि दशैकं च महाभूतानि पञ्च च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2101281, "chapter_id": 3180, "verse_number": "१४-३६-४९", "content_sanskrit": "विशेषाः पञ्चभूतानामित्येषा वैदिकी श्रुतिः।\nचतुर्विंशतिरेषा वस्तत्वानां परिकीर्तिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2101282, "chapter_id": 3180, "verse_number": "१४-३६-५०", "content_sanskrit": "तत्वानामथ यो वेद सर्वेषां प्रभवाप्ययौ।\nस धीरः सर्वभूतेषु न मोऽहमधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2101283, "chapter_id": 3180, "verse_number": "१४-३६-५१", "content_sanskrit": "तत्त्वानि यो वेदयते यथातथं\nगुणांश्च सर्वानखिलाश्च देवताः।\nविधूतपाप्मा प्रविमुच्य बन्धनं\nस सर्वलोकानमलान्समश्नुते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2101284, "chapter_id": 3180, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि षट्त्रिंशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]