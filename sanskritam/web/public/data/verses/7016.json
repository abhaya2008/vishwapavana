[
  {
    "id": 20132227,
    "chapter_id": 7016,
    "verse_number": "37.1",
    "content_sanskrit": "अथ सप्तत्रिंशो ऽध्यायः",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20132228,
    "chapter_id": 7016,
    "verse_number": "37.2",
    "content_sanskrit": "कस्यचित्त्वथ कालस्य नहुषो नाम पार्थिवः । प्राप्तवान् देवराज्यं हि नयबुद्धिपराक्रमः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20132229,
    "chapter_id": 7016,
    "verse_number": "37.3",
    "content_sanskrit": "प्रशशास तदा राज्यं देवैर्व्युष्टिमवाप्नुवन् । गान्धर्वं चैव नाट्यं च दृष्ट्वा चिन्तामुपागमत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20132230,
    "chapter_id": 7016,
    "verse_number": "37.4",
    "content_sanskrit": "स चिन्तयित्वा मनसा कथमेष गृहे मम । नाट्यप्रयोगो हि भवेदिति सादर एव सन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20132231,
    "chapter_id": 7016,
    "verse_number": "37.5",
    "content_sanskrit": "कृताञ्जलिः प्रयोगार्थं प्रोक्तवांस्तु सुरान् नृपः । अप्सरोभिरिदं सार्धं नाट्यं भवतु मे गृहे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20132232,
    "chapter_id": 7016,
    "verse_number": "37.6",
    "content_sanskrit": "प्रत्युक्तश्च ततो देवैर्बृहस्पतिपुरोगमैः । दिव्याङ्गनानां नैवेह मानुषैः सह सङ्गतिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20132233,
    "chapter_id": 7016,
    "verse_number": "37.7",
    "content_sanskrit": "हितं पथ्यं च वक्तव्यो भवान् स्वर्गाधिपो हि यत् । आचार्यास्तत्र गच्छन्तु गत्वा कुर्वन्तु ते प्रियम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20132234,
    "chapter_id": 7016,
    "verse_number": "37.8",
    "content_sanskrit": "प्रोक्तवांस्तु ततो मां तु नृपतिः स कृताञ्जलिः । इदमिच्छामि भगवन् नाट्यमुर्व्यां प्रतिष्ठितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20132235,
    "chapter_id": 7016,
    "verse_number": "37.9",
    "content_sanskrit": "पूर्वमाचार्यकं चैव भवताऽभिहितं श्रुतम् । व्यक्तभावात्विदं लब्धं त्वत्सकाशाद् द्विजोत्तम ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20132236,
    "chapter_id": 7016,
    "verse_number": "37.10",
    "content_sanskrit": "पितामहगृहे ऽस्माकं तदन्तःपुरे जने । पितामहक्रियायुक्त मुर्वश्यां सम्प्रवर्तितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20132237,
    "chapter_id": 7016,
    "verse_number": "37.11",
    "content_sanskrit": "तस्याः प्रणाशशोकेन उन्मादोपरते नृपे । विपन्ने ऽन्तःपुरजने पुनर्नाशमुपागतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20132238,
    "chapter_id": 7016,
    "verse_number": "37.12",
    "content_sanskrit": "प्रकाशमेतदिच्छामो भूयस्तत् संप्रयोजितम् । तिथियज्ञक्रियास्वेतद् यथा स्यान् मङ्गलैः शुभैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20132239,
    "chapter_id": 7016,
    "verse_number": "37.13",
    "content_sanskrit": "तस्मिन् मम गृहे बद्धं नानाप्रकृतिसंश्रयम् । स्त्रीणां ललितविन्यासैर्यतो नः प्रथयिष्यति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20132240,
    "chapter_id": 7016,
    "verse_number": "37.14",
    "content_sanskrit": "तथाऽस्त्विति मया प्रोक्तो नहुषः पार्थिवस्तदा । सुताश्चाहूय सम्प्रोक्ता सामपूर्वं सुरैः सह ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20132241,
    "chapter_id": 7016,
    "verse_number": "37.15",
    "content_sanskrit": "अयं हि नहुषो राजा याचते नः कृताञ्जलिः । गम्यतां सहितैर्भूमिं प्रयोक्तुं नाट्यमेव च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20132242,
    "chapter_id": 7016,
    "verse_number": "37.16",
    "content_sanskrit": "करिष्यमश्च शापान्तमस्मिन् सम्यक् प्रयोजिते । ब्राह्मणानां नृपाणां च भविष्यथ न कुत्सिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20132243,
    "chapter_id": 7016,
    "verse_number": "37.17",
    "content_sanskrit": "तत्र गत्वा प्रयुज्यन्तां प्रयोगान् वसुधातले । न शक्यं चान्यथा कर्तुं वचनं पार्थिवस्य हि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20132244,
    "chapter_id": 7016,
    "verse_number": "37.18",
    "content_sanskrit": "अस्माकं चैव सर्वेषां नहुषस्य महात्मनः । आत्मोपदेशसिद्धं हि नाट्यं प्रोक्तं स्वयंभुवा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20132245,
    "chapter_id": 7016,
    "verse_number": "37.19",
    "content_sanskrit": "शेषमुत्तरतन्त्रेण कोहलस्तु करिष्यति । प्रयोगः कारिकाश्चैव निरुक्तानि तथैव च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20132246,
    "chapter_id": 7016,
    "verse_number": "37.20",
    "content_sanskrit": "अप्सरोभिरिदं सार्धं क्रीडनीयकहेतुकम् । अधिष्ठितं मया स्वर्गे स्वातिना नारदेन च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20132247,
    "chapter_id": 7016,
    "verse_number": "37.21",
    "content_sanskrit": "ततश्च वसुधां गत्वा नहुषस्य गृहे द्विजाः । स्त्रीणां प्रयोगं बहुधा बद्धवन्तो यथाक्रमम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20132248,
    "chapter_id": 7016,
    "verse_number": "37.22",
    "content_sanskrit": "अत्रोपभोगतस्ते तु मानुषीषु मामात्मजाः । बद्धवन्तो ऽधिकस्नेहं तासु तद् द्विजसत्तमाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20132249,
    "chapter_id": 7016,
    "verse_number": "37.23",
    "content_sanskrit": "पुत्रानुत्पाद्य वध्वा च प्रयोगं च यथाक्रमम् । ब्रह्मणा समनुज्ञाताः प्राप्ताः स्वर्गं पुनः सुताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20132250,
    "chapter_id": 7016,
    "verse_number": "37.24",
    "content_sanskrit": "एवमुर्वीतले नाट्यं शिष्यैः समवतारितम् । भरतानां च वंशो ऽयं भविष्यं च प्रवर्तितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20132251,
    "chapter_id": 7016,
    "verse_number": "37.25",
    "content_sanskrit": "कोहलादिभिरेवं तु वत्सशाण्डिल्यधूर्तितैः । मत्यधर्मक्रियायुक्तैः कश्चित्कालमवस्थितैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20132252,
    "chapter_id": 7016,
    "verse_number": "37.26",
    "content_sanskrit": "एतच्छात्रं प्रणीतं हि नाराणां बुद्धिवर्धनम् । त्रैलोक्यस्य क्रियोपेतं सर्वशास्त्रनिदर्शनम् । मङ्गल्यं ललितं चैव ब्रह्मणो वदनोद्भवम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20132253,
    "chapter_id": 7016,
    "verse_number": "37.27",
    "content_sanskrit": "य इदं श्रुणुयान् नित्यं प्रोक्तं चेदं स्वयम्भुवा । कुर्यात् प्रयोगं यश्चैवमथवाऽधीतवान् नरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20132254,
    "chapter_id": 7016,
    "verse_number": "37.28",
    "content_sanskrit": "या गतिर्वेदविदुषां या गतिर्यज्ञकारिणाम् । या गतिर्दानशीलानां तां गतिं प्राप्नुयाद्धि सः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20132255,
    "chapter_id": 7016,
    "verse_number": "37.29",
    "content_sanskrit": "दानधर्मेषु सर्वेषु कीर्त्यते तु महत् फलम् । प्रेक्षणीयप्रदानं हि सर्वदानेषु शस्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20132256,
    "chapter_id": 7016,
    "verse_number": "37.30",
    "content_sanskrit": "न तथा गन्धमाल्येन देवास्तुष्यन्ति पूजिताः । यथा नाट्यप्रयोगस्थैर्नित्यं तुष्यन्ति मङ्गलैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20132257,
    "chapter_id": 7016,
    "verse_number": "37.31",
    "content_sanskrit": "गान्धर्वं चेह नाट्यं च यः सम्यक् परिपालयेत् । स ईश्वरगणेशानां लभते सद्गतिं पराम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20132258,
    "chapter_id": 7016,
    "verse_number": "37.32",
    "content_sanskrit": "एवं नाट्यप्रयोगे बहुविधिविहितं कर्मशास्त्रं प्रणीतम् नोक्तं यच्चात्र लोकादनुकृतिकरणात् संविभाव्यं तु तज्ज्ञैः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20132259,
    "chapter_id": 7016,
    "verse_number": "37.33",
    "content_sanskrit": "किं चान्यत् सम्प्रपूर्णा भवतु वसुमती नष्टदुर्भिक्षरोगा । शान्तिर्गोब्राह्मणानां भवतु नरपतिः पातु पृथ्वीं समग्राम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20132260,
    "chapter_id": 7016,
    "verse_number": "37.34",
    "content_sanskrit": "इति भरतीये नाट्यशास्त्रे गुह्यतत्त्वकथनाध्यायः सप्तत्रिंशः",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20132261,
    "chapter_id": 7016,
    "verse_number": "37.35",
    "content_sanskrit": "नाट्यशास्त्रम् संपूर्णम्",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  }
]