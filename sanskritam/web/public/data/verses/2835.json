[{"id": 2086293, "chapter_id": 2835, "verse_number": "१२-३४०-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2086294, "chapter_id": 2835, "verse_number": "१२-३४०-१", "content_sanskrit": "गिरिशृङ्गं समारुह्य सुतो व्यासस्य भारत।\nसमे देशे विविक्ते स निःशलाक उपाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2086295, "chapter_id": 2835, "verse_number": "१२-३४०-२", "content_sanskrit": "धारयामास चात्मानं यथाशास्त्रं यथाविधि।\nपादप्रभृतिगात्रेषु क्रमेण क्रमयोगवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2086296, "chapter_id": 2835, "verse_number": "१२-३४०-३", "content_sanskrit": "ततः स प्राङ्भुखो विद्वानादित्ये नाचिरोदिते।\nपाणिपादं समाधाय विनीतवदुपाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2086297, "chapter_id": 2835, "verse_number": "१२-३४०-४", "content_sanskrit": "न तत्र पक्षिसंपातो न शब्दो नापि दर्शनम्।\nयत्र वैयासकिर्धीमान्योक्तुं समुपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2086298, "chapter_id": 2835, "verse_number": "१२-३४०-५", "content_sanskrit": "स ददर्श तदाऽऽत्मानं सर्वसङ्गविनिःसृतम्।\nप्रजहास ततो हासं शुकः संप्रेक्ष्य तत्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2086299, "chapter_id": 2835, "verse_number": "१२-३४०-६", "content_sanskrit": "स पुनर्योगमास्थाय मोक्षमार्गोपलब्धये।\nमहायोगेश्वरो भूत्वा सोऽत्यक्रामद्विहायसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2086300, "chapter_id": 2835, "verse_number": "१२-३४०-७", "content_sanskrit": "ततः प्रदक्षिणं कृत्वा देवर्षि नारदं ततः।\nनिवेदयामास च तं स्वं योगं परमर्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2086301, "chapter_id": 2835, "verse_number": "१२-३४०-८x", "content_sanskrit": "शुक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2086302, "chapter_id": 2835, "verse_number": "१२-३४०-८", "content_sanskrit": "दृष्टो मार्गः प्रवृत्तोस्मि स्वस्ति तेऽस्तु तपोधन।\nत्वत्प्रसादाद्गमिष्यामि गतिमिष्टां महाद्युते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2086303, "chapter_id": 2835, "verse_number": "१२-३४०-९", "content_sanskrit": "नारदेनाभ्यनुज्ञातः शुको द्वैपायनात्मजः।\nअभिवाद्य पुनर्योगमास्थायाकाशमाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2086304, "chapter_id": 2835, "verse_number": "१२-३४०-१०", "content_sanskrit": "कैलासपृष्ठादुत्पत्य स पपात दिवं तदा।\nअन्तरिक्षचरः श्रीमान्व्यासपुत्रः सुनिश्चितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2086305, "chapter_id": 2835, "verse_number": "१२-३४०-११", "content_sanskrit": "तमुद्यन्तं द्विजश्रेष्ठं वैनतेयसमद्युतिम्।\nददृशुः सर्वभूतानि मनोऽमारुतरंहसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2086306, "chapter_id": 2835, "verse_number": "१२-३४०-१२", "content_sanskrit": "व्यवसायेन लोकांस्त्रीन्सर्वान्सोऽथ विचिन्तयन्।\nआस्थितो दिव्यमध्वानं पावकार्कसमप्रभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2086307, "chapter_id": 2835, "verse_number": "१२-३४०-१३", "content_sanskrit": "तमेकमनसं यान्तमव्यग्रमकुतोभयम्।\nददृशुः सर्वभूतानि जङ्गमानीतराणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2086308, "chapter_id": 2835, "verse_number": "१२-३४०-१४", "content_sanskrit": "यथाशक्ति यथान्यायं पूजयांचक्रिरे तदा।\nपुष्पवर्षेश्च दिव्यैस्तमलंचक्रुर्दिवौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2086309, "chapter_id": 2835, "verse_number": "१२-३४०-१५", "content_sanskrit": "तं दृष्ट्वा विस्मिताः सर्वे गन्धर्वाप्सरसां गणाः।\nऋषयश्चैव संसिद्धाः परं विस्मयमागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2086310, "chapter_id": 2835, "verse_number": "१२-३४०-१६", "content_sanskrit": "अन्तरिक्षगतः कोऽयं तपसा सिद्धिमागतः।\nअधः कायोर्ध्ववक्रश्च नेत्रैः समतिवाह्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2086311, "chapter_id": 2835, "verse_number": "१२-३४०-१७", "content_sanskrit": "ततः परमधर्मात्मा त्रिषु लोकेषु विश्रुतः।\nभास्करं समुदीक्षन्स प्राङ्भुखो वाग्यतोऽगमत्।\nशब्देनाकाशमखिलं पूरयन्निव सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2086312, "chapter_id": 2835, "verse_number": "१२-३४०-१८", "content_sanskrit": "तमापतन्तं सहसा दृष्ट्वा सर्वाप्सरोगणाः।\nसंभ्रान्तमनसो राजन्नासन्परमविस्मिताः।\nपञ्चचूडाप्रभृतयो भृशमुत्फुल्ललोचनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2086313, "chapter_id": 2835, "verse_number": "१२-३४०-१९", "content_sanskrit": "दैवतं कतमं ह्येतदुत्तमां गतिमास्थितम्।\nसुनिश्चितमिहायाति विमुक्तमिव निःस्पृहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2086314, "chapter_id": 2835, "verse_number": "१२-३४०-२०", "content_sanskrit": "ततः समभिचक्राम मलयं नाम पर्वतम्।\nउर्वशी पूर्वचित्तिश्च यं नित्यमुपसेवतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2086315, "chapter_id": 2835, "verse_number": "१२-३४०-२१", "content_sanskrit": "तस्य ब्रह्मर्षिपुत्रस्य विस्मयं ययतुः परम्।\nअहो बुद्धिसमाधानं वेदाभ्यासरते द्विजे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2086316, "chapter_id": 2835, "verse_number": "१२-३४०-२२", "content_sanskrit": "अचिरेणैव कालेन नभश्चरति चन्द्रवत्।\nपितृशुश्रूषया बुद्धिं संप्राप्तोऽयमनुत्तमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2086317, "chapter_id": 2835, "verse_number": "१२-३४०-२३", "content_sanskrit": "पितृभक्तो दृढतपाः पितुः सुदयितः सुतः।\nअनन्यमनसा तेन कथं पित्रा विसर्जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2086318, "chapter_id": 2835, "verse_number": "१२-३४०-२४", "content_sanskrit": "उर्वश्या वचनं श्रुत्वा शुकः परमधर्मवित्।\nउदैक्षत दिशः सर्वा वचने गतमानसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2086319, "chapter_id": 2835, "verse_number": "१२-३४०-२५", "content_sanskrit": "सोऽन्तरिक्षं महीं चैव सशैलवनकाननाम्।\nविलोकयामास तदा सरांसि सरितस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2086320, "chapter_id": 2835, "verse_number": "१२-३४०-२६", "content_sanskrit": "ततो द्वैपायनसुतं बहुमानात्समन्ततः।\nकृताञ्जलिपुटाः सर्वा निरीक्षन्ते स्म देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2086321, "chapter_id": 2835, "verse_number": "१२-३४०-२७", "content_sanskrit": "अब्रवीत्तास्तदा वाक्यं शुकः परमधर्मवित्।\nपिता यद्यनुगच्छेन्मां क्रोशमान शुकेति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2086322, "chapter_id": 2835, "verse_number": "१२-३४०-२८", "content_sanskrit": "तस्य प्रतिवचो देयं सर्वैरेव समाहितैः।\nएतन्मे स्नेहनः सर्वे वचनं कर्तुमर्हथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2086323, "chapter_id": 2835, "verse_number": "१२-३४०-२९", "content_sanskrit": "शुकस्य वचन श्रुत्वा दिशः सजलकाननाः।\nसमुद्राः सरितः शैलाः प्रत्यूचुस्तं समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2086324, "chapter_id": 2835, "verse_number": "१२-३४०-३०", "content_sanskrit": "यथा ज्ञापयसे विप्र बाढमेवं भविष्यति।\nऋषेर्व्याहरतो वाक्यं प्रतिवक्ष्यामहे वयम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2086325, "chapter_id": 2835, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि चत्वारिंशदधिकत्रिशततमोऽध्यायः॥ ३४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]