[{"id": 50024622, "chapter_id": 11869, "verse_number": "1", "content_sanskrit": "॥ कण्वो घौरः। मरुतः। गायत्री ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024623, "chapter_id": 11869, "verse_number": "2", "content_sanskrit": "कद्ध॑ नू॒नं क॑धप्रियः पि॒ता पु॒त्रं न हस्त॑योः। द॒धि॒ध्वे वृ॑क्तबर्हिषः॥ ३८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024624, "chapter_id": 11869, "verse_number": "3", "content_sanskrit": "क्व॑ नू॒नं कद्वो॒ अर्थं॒ गन्ता॑ दि॒वो न पृ॑थि॒व्याः। क्व॑ वो॒ गावो॒ न र॑ण्यन्ति॥ ३८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024625, "chapter_id": 11869, "verse_number": "4", "content_sanskrit": "क्व॑ वः सु॒म्ना नव्यां॑सि॒ मरु॑त॒ः क्व॑ सुवि॒ता। क्वो॒३॒॑ विश्वा॑नि॒ सौभ॑गा॥ ३८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024626, "chapter_id": 11869, "verse_number": "5", "content_sanskrit": "यद्यू॒यं पृ॑श्निमातरो॒ मर्ता॑स॒ः स्यात॑न। स्तो॒ता वो॑ अ॒मृत॑ः स्यात्॥ ३८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024627, "chapter_id": 11869, "verse_number": "6", "content_sanskrit": "मा वो॑ मृ॒गो न यव॑से जरि॒ता भू॒दजो॑ष्यः। प॒था य॒मस्य॑ गा॒दुप॑॥ ३८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024628, "chapter_id": 11869, "verse_number": "7", "content_sanskrit": "मो षु ण॒ः परा॑परा॒ निरृ॑तिर्दु॒र्हणा॑ वधीत्। प॒दी॒ष्ट तृष्ण॑या स॒ह॥ ३८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024629, "chapter_id": 11869, "verse_number": "8", "content_sanskrit": "स॒त्यं त्वे॒षा अम॑वन्तो॒ धन्व॑ञ्चि॒दा रु॒द्रिया॑सः। मिहं॑ कृण्वन्त्यवा॒ताम्॥ ३८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50024630, "chapter_id": 11869, "verse_number": "9", "content_sanskrit": "वा॒श्रेव॑ वि॒द्युन्मि॑माति व॒त्सं न मा॒ता सि॑षक्ति। यदे॑षां वृ॒ष्टिरस॑र्जि॥ ३८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50024631, "chapter_id": 11869, "verse_number": "10", "content_sanskrit": "दिवा॑ चि॒त्तम॑ः कृण्वन्ति प॒र्जन्ये॑नोदवा॒हेन॑। यत्पृ॑थि॒वीं व्यु॒न्दन्ति॑॥ ३८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50024632, "chapter_id": 11869, "verse_number": "11", "content_sanskrit": "अध॑ स्व॒नान्म॒रुतां॒ विश्व॒मा सद्म॒ पार्थि॑वम्। अरे॑जन्त॒ प्र मानु॑षाः॥ ३८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50024633, "chapter_id": 11869, "verse_number": "12", "content_sanskrit": "मरु॑तो वीळुपा॒णिभि॑श्चि॒त्रा रोध॑स्वती॒रनु॑। या॒तेमखि॑द्रयामभिः॥ ३८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50024634, "chapter_id": 11869, "verse_number": "13", "content_sanskrit": "स्थि॒रा व॑ः सन्तु ने॒मयो॒ रथा॒ अश्वा॑स एषाम्। सुसं॑स्कृता अ॒भीश॑वः॥ ३८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50024635, "chapter_id": 11869, "verse_number": "14", "content_sanskrit": "अच्छा॑ वदा॒ तना॑ गि॒रा ज॒रायै॒ ब्रह्म॑ण॒स्पति॑म्। अ॒ग्निं मि॒त्रं न द॑र्श॒तम्॥ ३८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50024636, "chapter_id": 11869, "verse_number": "15", "content_sanskrit": "मि॒मी॒हि श्लोक॑मा॒स्ये॑ प॒र्जन्य॑ इव ततनः। गाय॑ गाय॒त्रमु॒क्थ्य॑म्॥ ३८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50024637, "chapter_id": 11869, "verse_number": "16", "content_sanskrit": "वन्द॑स्व॒ मारु॑तं ग॒णं त्वे॒षं प॑न॒स्युम॒र्किण॑म्। अ॒स्मे वृ॒द्धा अ॑सन्नि॒ह॥ ३८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]