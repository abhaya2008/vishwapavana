[{"id": 7006391000, "chapter_id": 26391, "verse_number": "२-४८-१", "content_sanskrit": "वैशम्पायन उवाच\nते कृष्णमागतं दृष्ट्वा वैनतेयसहाच्युतम् ।\nबभूवुश्चिन्तयाविष्टाः सर्वे नृपतिसत्तमाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006391001, "chapter_id": 26391, "verse_number": "२-४८-२", "content_sanskrit": "ते समेत्य सभां राजन् राजानो भीमविक्रमाः ।\nमन्त्राय मन्त्रकुशला नीतिशास्त्रार्थवित्तमाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006391002, "chapter_id": 26391, "verse_number": "२-४८-३", "content_sanskrit": "भीष्मकस्य सभां गत्वा रम्यां हेमपरिष्कृताम् ।\nसिंहासनेषु चित्रेषु विचित्रास्तरणेषु च ।\nनिषेदुस्ते नृपवरा देवा देवसभामिव ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006391003, "chapter_id": 26391, "verse_number": "२-४८-४", "content_sanskrit": "तेषां मध्ये महाबाहुर्जरासंधो महाबलः ।\nवभाषे स महातेजा देवान् देवेश्वरो यथा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006391004, "chapter_id": 26391, "verse_number": "२-४८-५", "content_sanskrit": "जरासंध उवाच\nश्रूयतां भो नृपश्रेष्ठा भीष्मकश्च महामतिः ।\nकथ्यमानं मया बुद्ध्या वचनं वदतां वराः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006391005, "chapter_id": 26391, "verse_number": "२-४८-६", "content_sanskrit": "योऽसौ कृष्ण इति ख्यातो वसुदेवसुतो बली ।\nवैनतेयसहायेन सम्प्राप्तः कुण्डिनं त्विह ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006391006, "chapter_id": 26391, "verse_number": "२-४८-७", "content_sanskrit": "कन्याहेतोर्महातेजा यादवैरभिसंवृतः ।\nअवश्यं कुरुते यत्नं कन्यावाप्तिर्यथा भवेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006391007, "chapter_id": 26391, "verse_number": "२-४८-८", "content_sanskrit": "यदत्र कारणं कार्यं सुनयोपेतमृद्धितम् ।\nकुरुध्वं नृपशार्दूला विनिश्चित्य बलाबलम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006391008, "chapter_id": 26391, "verse_number": "२-४८-९", "content_sanskrit": "पदातिनौ महावीर्यौ वसुदेवसुतावुभौ ।\nवैनतेयं विना तस्मिन् गोमन्ते पर्वतोत्तमे ।\nकृतवन्तौ महाघोरं भवद्भिर्विदितं हि तत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006391009, "chapter_id": 26391, "verse_number": "२-४८-१०", "content_sanskrit": "वृष्णिभिर्यादवैश्चैव भोजान्धकमहारथैः ।\nसमेत्य युद्धमानस्य कीदृशो विग्रहो भवेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006391010, "chapter_id": 26391, "verse_number": "२-४८-११", "content_sanskrit": "कन्यार्थे यततानेन गरुडस्थेन विष्णुना ।\nकः स्थास्यति रणे तस्मिन्नपि शक्रः सुरैः सह ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006391011, "chapter_id": 26391, "verse_number": "२-४८-१२", "content_sanskrit": "यदा चास्मै नापि सुता कदाचित् सम्प्रदीयते ।\nततो ह्ययं बलादेनां नेतुं शक्तः सुरैः सह ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006391012, "chapter_id": 26391, "verse_number": "२-४८-१३", "content_sanskrit": "पुरा एकार्णवे घोरे श्रूयते मेदिनी त्वियम् ।\nपातालतलसम्मग्ना विष्णुना प्रभविष्णुना ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006391013, "chapter_id": 26391, "verse_number": "२-४८-१४", "content_sanskrit": "वाराहं रूपमास्थाय उद्धृता जगदादिना ।\nहिरण्याक्षश्च दैत्येन्द्रो वराहेण निपातितः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006391014, "chapter_id": 26391, "verse_number": "२-४८-१५", "content_sanskrit": "हिरण्यकशिपुश्चैव महाबलपराक्रमः ।\nअवध्योऽमरदैत्यानामृषिगन्धर्वकिन्नरैः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006391015, "chapter_id": 26391, "verse_number": "२-४८-१६", "content_sanskrit": "यक्षराक्षसनागानां नाकाशे नावनिस्थले ।\nन चाभ्यन्तररात्र्यह्नोर्न शुष्केणार्द्रकेण च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006391016, "chapter_id": 26391, "verse_number": "२-४८-१७", "content_sanskrit": "अवध्यस्त्रिषु लोकेषु दैत्येन्द्रस्त्वपराजितः ।\nनरसिंहेन रूपेण निहतो विष्णुना पुरा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006391017, "chapter_id": 26391, "verse_number": "२-४८-१८", "content_sanskrit": "वामनेन तु रूपेण कश्यपस्यात्मजो बली ।\nअदित्या गर्भसम्भूतो बलिर्बद्धोऽसुरोत्तमः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006391018, "chapter_id": 26391, "verse_number": "२-४८-१९", "content_sanskrit": "सत्यरज्जुमयैः पाशैः कृतः पातालसंश्रयः ।\nकार्तवीर्यो महावीर्यः सहस्रभुजविग्रहः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006391019, "chapter_id": 26391, "verse_number": "२-४८-२०", "content_sanskrit": "दत्तात्रेयप्रसादेन मत्तो राज्यमदेन च ।\nजामदग्न्यो महातेजा रेणुकागर्भसंभवः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006391020, "chapter_id": 26391, "verse_number": "२-४८-२१", "content_sanskrit": "त्रेताद्वापरयोः संधौ रामः शस्त्रभृतां वरः ।\nपर्शुना(पशुना?) वज्रकल्पेन सप्तद्वीपेश्वरो नृपः ।\nविष्णुना निहतो भूयः छद्मरूपेण हैहयः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006391021, "chapter_id": 26391, "verse_number": "२-४८-२२", "content_sanskrit": "इक्ष्वाकुकुलसम्भूतो रामो दाशरथिः पुरा ।\nत्रिलोकविजयं वीरं रावणं संन्यपातयत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006391022, "chapter_id": 26391, "verse_number": "२-४८-२३", "content_sanskrit": "पुरा कृतूयुगे विष्णुः संग्रामे तारकामये ।\nषोडशार्द्धभुजो भूत्वा गरुडस्थो हि वीर्यवान् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006391023, "chapter_id": 26391, "verse_number": "२-४८-२४", "content_sanskrit": "निजघानासुरान् युद्धे वरदानेन गर्वितान् ।\nकालनेमिश्च दैतेयो देवानां च भयप्रदः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006391024, "chapter_id": 26391, "verse_number": "२-४८-२५", "content_sanskrit": "सहस्रकिरणाभेन चक्रेण निहतो युधि ।\nमहायोगबलेनाजौ विश्वरूपेण विष्णुना ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006391025, "chapter_id": 26391, "verse_number": "२-४८-२६", "content_sanskrit": "अनेन प्राप्तकालास्ते निहता बहवोऽसुराः ।\nवने वनचरा दैत्या महाबलपराक्रमाः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006391026, "chapter_id": 26391, "verse_number": "२-४८-२७", "content_sanskrit": "निहता बालभावेन प्रलम्बारिष्टधेनुकाः ।\nशकुनीं केशिनं चैव यमलार्जुनकावपि ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006391027, "chapter_id": 26391, "verse_number": "२-४८-२८", "content_sanskrit": "नागं कुवलयापीडं चाणूरं मुष्टिकं तथा ।\nकंसं च बलिनां श्रेष्ठं सगणं देवकीसुतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006391028, "chapter_id": 26391, "verse_number": "२-४८-२९", "content_sanskrit": "न्यहनद् गोपवेषेण क्रीडमानो हि केशवः ।\nएवमादीनि दिव्यानि छद्मरूपाणि चक्रिणा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006391029, "chapter_id": 26391, "verse_number": "२-४८-३०", "content_sanskrit": "कृतानि दिव्यरूपाणि विष्णुना प्रभविष्णुना ।\nतेनाहं वः प्रवक्ष्यामि भवतां हितकाम्यया ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006391030, "chapter_id": 26391, "verse_number": "२-४८-३१", "content_sanskrit": "तं मन्ये केशवं विष्णुं सुराद्यमसुरान्तकम् ।\nनारायणं जगद्योनिं पुराणं पुरुषं ध्रुवम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006391031, "chapter_id": 26391, "verse_number": "२-४८-३२", "content_sanskrit": "स्रष्टारं सर्वभूतानां व्यक्ताव्यक्तं सनातनम् ।\nअधृष्यं सर्वलोकानां सर्वलोकनमस्कृतम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006391032, "chapter_id": 26391, "verse_number": "२-४८-३३", "content_sanskrit": "अनादिमध्यनिधनं क्षरमक्षरमव्ययम् ।\nस्वयम्भुवमजं स्थाणुमजेयं सचराचरैः ॥ ३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006391033, "chapter_id": 26391, "verse_number": "२-४८-३४", "content_sanskrit": "त्रिविक्रमं त्रिलोकेशं त्रिदशेन्द्रारिनाशनम् ।\nइति मे निश्चिता बुद्धिर्जातोऽयं मथुरामधि ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006391034, "chapter_id": 26391, "verse_number": "२-४८-३५", "content_sanskrit": "कुले महति वै राज्ञां विपुले चक्रवर्तिनाम् ।\nकथमन्यस्य मर्त्यस्य गरुडो वाहनं भवेत् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006391035, "chapter_id": 26391, "verse_number": "२-४८-३६", "content_sanskrit": "विशेषेण तु कन्यार्थे विक्रमस्थे जनार्दने ।\nकः स्थास्यति पुमानद्य गरुडस्याग्रतो बली ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006391036, "chapter_id": 26391, "verse_number": "२-४८-३७", "content_sanskrit": "स्वयंवरकृतेनासौ विष्णुः स्वयमिहागतः ।\nविष्णोरागमने चैव महान् दोषः प्रकीर्तितः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006391037, "chapter_id": 26391, "verse_number": "२-४८-३८", "content_sanskrit": "भवद्भिरनुचिन्त्येदं क्रियतां यदनन्तरम् ।\nवैशम्पायन उवाच\nएवं विब्रुवमाणे तु मगधानां जनेश्वरे ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006391038, "chapter_id": 26391, "verse_number": "२-४८-३९", "content_sanskrit": "सुनीथ उवाच\nसम्यगाह महाबाहुर्मगधाधिपतिर्नृपः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006391039, "chapter_id": 26391, "verse_number": "२-४८-४०", "content_sanskrit": "समक्षं नरदेवानां यथावृत्तं महाहवे ।\nगोमन्ते रामकृष्णाभ्यां कृतं कर्म सुदुष्करम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006391040, "chapter_id": 26391, "verse_number": "२-४८-४१", "content_sanskrit": "गजाश्वरथसम्बाधा पत्तिध्वजसमाकुला ।\nनिर्दग्धा महती सेना चक्रलाङ्गलवह्निना ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006391041, "chapter_id": 26391, "verse_number": "२-४८-४२", "content_sanskrit": "तेनायं मागधः श्रीमाननागतमचिन्तयत् ।\nब्रुवते राजसेनायामनुस्मृत्य सुदारुणम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006391042, "chapter_id": 26391, "verse_number": "२-४८-४३", "content_sanskrit": "पदात्योर्युध्यतोस्तत्र बलकेशवयोर्युधि ।\nदुर्निवार्यतरो घोरो ह्यभवद् वाहिनीक्षयः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006391043, "chapter_id": 26391, "verse_number": "२-४८-४४", "content_sanskrit": "विदितं वः सुपर्णस्य स्वागतस्य नृपोत्तमाः ।\nपक्षवेगानिलोद्धूता बभ्रमुर्गगनेचराः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006391044, "chapter_id": 26391, "verse_number": "२-४८-४५", "content_sanskrit": "समुद्राः क्षुभिताः सर्वे चचालाद्रिर्मही मुहुः ।\nवयं सर्वे सुसंत्रस्ताः किमुत्पातेति विक्लवाः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006391045, "chapter_id": 26391, "verse_number": "२-४८-४६", "content_sanskrit": "यदा संनह्य युध्येत आरूढः केशवः खगम् ।\nकथमस्मद्विधः शक्तः प्रतिस्थातुं रणाजिरे ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006391046, "chapter_id": 26391, "verse_number": "२-४८-४७", "content_sanskrit": "राज्ञां स्वयंवरो नाम सुमहान् हर्षवर्धनः ।\nकृतो नरवरैराद्यैर्यशोधर्मस्य वै विधिः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006391047, "chapter_id": 26391, "verse_number": "२-४८-४८", "content_sanskrit": "इदं तु कुण्डिनगरमासाद्य मनुजेश्वराः ।\nपुनरेवैष्यते क्षिप्रं महापुरुषविग्रहम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006391048, "chapter_id": 26391, "verse_number": "२-४८-४९", "content_sanskrit": "यदि सा वरयेदन्यं राज्ञां मध्ये नृपात्मजा ।\nकृष्णस्य भुजयोर्वीर्यं कः पुमान् प्रसहिष्यति ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006391049, "chapter_id": 26391, "verse_number": "२-४८-५०", "content_sanskrit": "विज्ञापितमिदं दोषं स्वयंवरमहोत्सवे ।\nतदर्थमागतः कृष्णो वयं चैव नराधिपाः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006391050, "chapter_id": 26391, "verse_number": "२-४८-५१", "content_sanskrit": "कृष्णस्यागमनं चैव नृपाणामतिगर्हितम् ।\nकन्याहेतोर्नरेन्द्राणां यथा वदति मागधः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]