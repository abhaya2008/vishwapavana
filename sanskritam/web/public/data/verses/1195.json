[{"id": 2009871, "chapter_id": 1195, "verse_number": "१-१९६-०x", "content_sanskrit": "और्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2009872, "chapter_id": 1195, "verse_number": "१-१९६-१", "content_sanskrit": "उक्तवानस्मि यां क्रोधात्प्रतिज्ञां पितरस्तदा।\nसर्वलोकविनाशाय न सा मे वितथा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2009873, "chapter_id": 1195, "verse_number": "१-१९६-२", "content_sanskrit": "वृथारोषप्रतिज्ञो वै नाहं जीवितुमुत्सहे।\nअनिस्तीर्णो हि मां रोषो दहेदग्निरिवारणिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2009874, "chapter_id": 1195, "verse_number": "१-१९६-३", "content_sanskrit": "यो हि कारणतः क्रोधं संजातं क्षन्तुमर्हति।\nनालं स मनुजः सम्यक् त्रिवर्गं परिरक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2009875, "chapter_id": 1195, "verse_number": "१-१९६-४", "content_sanskrit": "अशिष्टानां नियन्ता हि शिष्टानां परिरक्षिता।\nस्थाने रोषः प्रयुक्तः स्यान्नृपैः सर्वजिगीषुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2009876, "chapter_id": 1195, "verse_number": "१-१९६-५", "content_sanskrit": "अश्रौषमहमूरुस्थो गर्भशय्यागतस्तदा।\nआरावं मातृवर्गस्य भृगूणां क्षत्रियैर्वधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2009877, "chapter_id": 1195, "verse_number": "१-१९६-६", "content_sanskrit": "सामरैर्हि यदा लोके भृगूणां क्षत्रियाधमैः।\nआगर्भोत्सादनं क्षान्तं तदा मां मन्युराविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2009878, "chapter_id": 1195, "verse_number": "१-१९६-७", "content_sanskrit": "प्रकीर्णकेशाः किल मे मातरः पितरस्तथा।\nभयात्सर्वेषु लोकेषु नाधिजग्मुः परायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2009879, "chapter_id": 1195, "verse_number": "१-१९६-८", "content_sanskrit": "तान्भृगूणां यदा दारान्कश्चिन्नाभ्युपपद्यत।\nमाता तदा दधारेयमूरुणैकेन मां शुभा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2009880, "chapter_id": 1195, "verse_number": "१-१९६-९", "content_sanskrit": "प्रतिषेद्धा हि पापस्य यदा लोकेषु विद्यते।\nतदा सर्वेषु लोकेषु पापकृन्नोपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2009881, "chapter_id": 1195, "verse_number": "१-१९६-१०", "content_sanskrit": "यदा तु प्रतिषेद्धारं पापो न लभते क्वचित्।\nतिष्ठन्ति बहवो लोकास्तदा पापेषु कर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2009882, "chapter_id": 1195, "verse_number": "१-१९६-११", "content_sanskrit": "जानन्नपि च यः पापं शक्तिमान्न नियच्छति।\nईशः सन्सोऽपि तेनैव कर्मणा संप्रयुज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2009883, "chapter_id": 1195, "verse_number": "१-१९६-१२", "content_sanskrit": "राजभिश्चेश्वरैश्चैव यदि वै पितरो मम।\nशक्तैर्न शकितास्त्रातुमिष्टं मत्वेह जीवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2009884, "chapter_id": 1195, "verse_number": "१-१९६-१३", "content_sanskrit": "अत एषामहं क्रुद्धो लोकानामीश्वरो ह्यहम्।\nभवतां च वचो नालमहं समभिवर्तितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2009885, "chapter_id": 1195, "verse_number": "१-१९६-१४", "content_sanskrit": "ममापि चेद्भवेदेवमीश्वरस्य सतो महत्।\nउपेक्षमाणस्य पुनर्लोकानां किल्बिषाद्भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2009886, "chapter_id": 1195, "verse_number": "१-१९६-१५", "content_sanskrit": "यश्चायं मन्युजो मेऽग्निर्लोकानादातुमिच्छति।\nदहेदेष च मामेव निगृहीतः स्वतेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2009887, "chapter_id": 1195, "verse_number": "१-१९६-१६", "content_sanskrit": "भवतां च विजानामि सर्वलोकहितेप्सुताम्।\nतस्माद्विधद्ध्वं यच्छ्रेयो लोकानां मम चेश्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2009888, "chapter_id": 1195, "verse_number": "१-१९६-१७x", "content_sanskrit": "पितर ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2009889, "chapter_id": 1195, "verse_number": "१-१९६-१७", "content_sanskrit": "य एष मन्युजस्तेऽग्निर्लोकानादातुमिच्छति।\nअप्सु तं मुञ्च भद्रं ते लोका ह्यप्सु प्रतिष्ठिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2009890, "chapter_id": 1195, "verse_number": "१-१९६-१८", "content_sanskrit": "आपोमयाः सर्वरसाः सर्वमापोमयं जगत्।\nतस्मादप्सु विमुञ्चेमं क्रोधाग्निं द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2009891, "chapter_id": 1195, "verse_number": "१-१९६-१९", "content_sanskrit": "अयं तिष्ठतु ते विप्र यदीच्छसि महोदधौ।\nमन्युजोऽग्निर्दहन्नापो लोका ह्यापोमयाः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2009892, "chapter_id": 1195, "verse_number": "१-१९६-२०", "content_sanskrit": "एवं प्रतिज्ञा सत्येयं तवानघ भविष्यति।\nन चैवं सामरा लोका गमिष्यन्ति पराभवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2009893, "chapter_id": 1195, "verse_number": "१-१९६-२१x", "content_sanskrit": "वसिष्ठ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2009894, "chapter_id": 1195, "verse_number": "१-१९६-२१", "content_sanskrit": "ततस्तं क्रोधजं तात और्वोऽग्निं वरुणालये।\nउत्ससर्ज स चैवाप उपयुङ्क्ते महोदधौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2009895, "chapter_id": 1195, "verse_number": "१-१९६-२२", "content_sanskrit": "महद्धयशिरो भूत्वा यत्तद्वेदविदो विदुः।\nतमग्निमुद्हिरद्वक्त्रात्पिबत्यापो महोदधौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2009896, "chapter_id": 1195, "verse_number": "१-१९६-२३", "content_sanskrit": "तस्मात्त्वमपि भद्रं ते न लोकान्हन्तुमर्हसि।\nपराशरं पराँल्लोकाञ्जानञ्ज्ञानवतां वर॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2009897, "chapter_id": 1195, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि चैत्ररथपर्वणि षण्णवत्यधिकशततमोऽध्यायः॥ १९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]