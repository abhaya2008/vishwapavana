[{"id": 5000564000, "chapter_id": 9564, "verse_number": "७-२९-१", "content_sanskrit": "ततस्तमसि सञ्जाते सर्वे ते देवराक्षसाः ।\nअयुद्ध्यन्त बलोन्मत्ताः सूदयन्तः परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000564001, "chapter_id": 9564, "verse_number": "७-२९-२", "content_sanskrit": "ततस्तु देवसैन्येन राक्षसानां बृहद्बलम् ।\nदशांशं स्थापितं युद्धे शेषं नीतं यमक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000564002, "chapter_id": 9564, "verse_number": "७-२९-३", "content_sanskrit": "तस्मिंस्तु तामसे युद्धे सर्वे ते देवराक्षसाः ।\nअन्योन्यं नाभ्यजानन्त युध्यमानाः परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000564003, "chapter_id": 9564, "verse_number": "७-२९-४", "content_sanskrit": "इन्द्रश्च रावणश्चैव रावणिश्च महाबलः ।\nतस्मिंस्तमोजालवृते मोहमीयुर्न ते त्रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000564004, "chapter_id": 9564, "verse_number": "७-२९-५", "content_sanskrit": "स तु दृष्ट्वा बलं सर्वं रावणो निहतं क्षणात् ।\nक्रोधमभ्यगमत्तीव्रं महानादं च मुक्तवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000564005, "chapter_id": 9564, "verse_number": "७-२९-६", "content_sanskrit": "क्रोधात्सूतं च दुर्धर्षः स्यन्दनस्थमुवाच ह ।\nपरसैन्यस्य मध्येन यावदन्तो नयस्व माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000564006, "chapter_id": 9564, "verse_number": "७-२९-७", "content_sanskrit": "अद्यैतान् त्रिदशान्सर्वान्विक्रमैः समरे स्वयम् ।\nनानाशस्त्रैर्महाघोरैर्नयामि यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000564007, "chapter_id": 9564, "verse_number": "७-२९-८", "content_sanskrit": "अहमिन्द्रं वधिष्यामि धनदं वरुणं यमम् ।\nत्रिदशान्विनिहत्याथ स्वयं स्थास्याम्यथोपरि ।\nविषादो न च कर्तव्यः शीघ्रं वाहय मे रथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000564008, "chapter_id": 9564, "verse_number": "७-२९-९", "content_sanskrit": "द्विः खलु त्वां ब्रवीम्यद्य यावदन्तो नयस्व माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000564009, "chapter_id": 9564, "verse_number": "७-२९-१०", "content_sanskrit": "अयं स नन्दनोद्देशो यत्र वर्तामहे वयम् ।\nनय मामद्य तत्र त्वमुदयो यत्र पर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000564010, "chapter_id": 9564, "verse_number": "७-२९-११", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा तुरगान्स मनोजवान् ।\nआदिदेशाथ शत्रणां मध्येनैव च सारथिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000564011, "chapter_id": 9564, "verse_number": "७-२९-१२", "content_sanskrit": "तस्य तं निश्चयं ज्ञात्वा शक्रो देवेश्वरस्तदा ।\nरथस्थः समरस्थस्तान्देवान्वाक्यमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000564012, "chapter_id": 9564, "verse_number": "७-२९-१३", "content_sanskrit": "सुराः शृणुत मद्वाक्यं यत्तावन्मम रोचते ।\nजीवन्नेव दशग्रीवः साधु रक्षो निगृह्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000564013, "chapter_id": 9564, "verse_number": "७-२९-१४", "content_sanskrit": "एष ह्यतिबलः सैन्यै रथेन पवनौजसा ।\nगमिष्यति प्रवृद्धोर्मिः समुद्र इव पर्वणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000564014, "chapter_id": 9564, "verse_number": "७-२९-१५", "content_sanskrit": "नह्येष हन्तुं शक्यो ऽद्य वरदानात्सुनिर्भयः ।\nतद्ग्रहीष्यामहे रक्षो यत्ता भवत संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000564015, "chapter_id": 9564, "verse_number": "७-२९-१६", "content_sanskrit": "यथा बलौ निरुद्धे च त्रैलोक्यं भुज्यते मया ।\nएवमेतस्य पापस्य निरोधो मम रोचते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000564016, "chapter_id": 9564, "verse_number": "७-२९-१७", "content_sanskrit": "ततो ऽन्यं देशमास्थाय शक्रः सन्त्यज्य रावणम् ।\nअयुध्यत महाराज राक्षसांस्त्रासयन्रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000564017, "chapter_id": 9564, "verse_number": "७-२९-१८", "content_sanskrit": "उत्तरेण दशग्रीवः प्रविवेशानिवर्तकः ।\nदक्षिणेन तु पार्श्वेन प्रविवेश शतक्रतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000564018, "chapter_id": 9564, "verse_number": "७-२९-१९", "content_sanskrit": "ततः स योजनशतं प्रविष्टो राक्षसाधिपः ।\nदेवतानां बलं सर्वं शरवर्षैरवाकिरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000564019, "chapter_id": 9564, "verse_number": "७-२९-२०", "content_sanskrit": "ततः शक्रो निरीक्ष्याथ प्रनष्टं तु स्वकं बलम् ।\nन्यवर्तयदसम्भ्रान्तः समावृत्य दशाननम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000564020, "chapter_id": 9564, "verse_number": "७-२९-२१", "content_sanskrit": "एतस्मिन्नन्तरे नादो मुक्तो दानवराक्षसैः ।\nहा हताः स्म इति ग्रस्तं दृष्ट्वा शक्रेण रावणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000564021, "chapter_id": 9564, "verse_number": "७-२९-२२", "content_sanskrit": "ततो रथं समास्थाय रावणिः क्रोधमूर्च्छितः ।\nतत्सैन्यमतिसङ्क्रुद्धः प्रविवेश सुदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000564022, "chapter_id": 9564, "verse_number": "७-२९-२३", "content_sanskrit": "तां प्रविश्य महामायां प्राप्तां गोपतिना पुरा ।\nप्रविवेश सुसंरब्धस्तत्सैन्यं समभिद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000564023, "chapter_id": 9564, "verse_number": "७-२९-२४", "content_sanskrit": "स सर्वा देवतास्त्यक्त्वा शक्रमेवाभ्यधावत ।\nमहेन्द्रश्च महातेजा नापश्यच्च सुतं रिपोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000564024, "chapter_id": 9564, "verse_number": "७-२९-२५", "content_sanskrit": "विमुक्तकवचस्तत्र वध्यमानो ऽपि रावणिः ।\nत्रिदशैः सुमहावीर्यैर्न चकार च किञ्चन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000564025, "chapter_id": 9564, "verse_number": "७-२९-२६", "content_sanskrit": "स मातलिं समायान्तं ताडयित्वा शरोत्तमैः ।\nमहेन्द्रं बाणवर्षेण भूय एवाभ्यवाकिरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000564026, "chapter_id": 9564, "verse_number": "७-२९-२७", "content_sanskrit": "ततस्त्यक्त्वा रथं शक्रो विससर्ज च सारथिम् ।\nऐरावतं समारुह्य मृगयामास रावणिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000564027, "chapter_id": 9564, "verse_number": "७-२९-२८", "content_sanskrit": "स तत्र मायाबलवानदृश्यो ऽथान्तरिक्षगः ।\nइन्द्रं मायापरिक्षिप्तं कृत्वा स प्राद्रवच्छरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000564028, "chapter_id": 9564, "verse_number": "७-२९-२९", "content_sanskrit": "स तं यदा परिश्रान्तमिन्द्रं जज्ञे ऽथ रावणिः ।\nतदैनं मायया बद्ध्वा स्वसैन्यमभितो ऽनयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000564029, "chapter_id": 9564, "verse_number": "७-२९-३०", "content_sanskrit": "तं तु दृष्ट्वा बलात्तेन नीयमानं महारणात् ।\nमहेन्द्रममराः सर्वे किं नु स्यादित्यचिन्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000564030, "chapter_id": 9564, "verse_number": "७-२९-३१", "content_sanskrit": "दृश्यते न स मायावी शक्रजित्समितिञ्जयः ।\nविद्यावानपि येनेन्द्रो मायया नीयते बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000564031, "chapter_id": 9564, "verse_number": "७-२९-३२", "content_sanskrit": "एतस्मिन्नन्तरे क्रुद्धाः सर्वे सुरगणास्तदा ।\nरावणं विमुखीकृत्य शरवर्षैरवाकिरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000564032, "chapter_id": 9564, "verse_number": "७-२९-३३", "content_sanskrit": "रावणस्तु समासाद्य आदित्यांश्च वसूंस्तदा ।\nन शशाक स सङ्ग्रामे योद्धुं शत्रुभिरर्दितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000564033, "chapter_id": 9564, "verse_number": "७-२९-३४", "content_sanskrit": "स तं दृष्ट्वा परिम्लानं प्रहारैर्जर्जरीकृतम् ।\nरावणिः पितरं युद्धे दर्शनस्थो ऽब्रवीदिदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000564034, "chapter_id": 9564, "verse_number": "७-२९-३५", "content_sanskrit": "आगच्छ तात गच्छामो रणकर्म निवर्तताम् ।\nजितं नो विदितं ते ऽस्तु स्वस्थो भव गतज्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000564035, "chapter_id": 9564, "verse_number": "७-२९-३६", "content_sanskrit": "अयं हि सुरसैन्यस्य त्रैलोक्यस्य च यः प्रभुः ।\nस गृहीतो दैवबलाद्भग्नदर्पाः सुराः कृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000564036, "chapter_id": 9564, "verse_number": "७-२९-३७", "content_sanskrit": "यथेष्टं भुङ्क्ष्व लोकांस्त्रीन्निगृह्यारातिमोजसा ।\nवृथा किं ते श्रमेणेह युद्धमद्य तु निष्फलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000564037, "chapter_id": 9564, "verse_number": "७-२९-३८", "content_sanskrit": "ततस्ते दैवतगणा निवृत्ता रणकर्मणः ।\nतच्छ्रुत्वा रावणेर्वाक्यं स्वस्थचेताः बभूव ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000564038, "chapter_id": 9564, "verse_number": "७-२९-३९", "content_sanskrit": "अथ स रणविगतज्वरः प्रभुर्विजयमवाप्य निशाचराधिपः ।\nस्वभवनमभितो जगाम हृष्टः स्वसुतमवाप्य च वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000564039, "chapter_id": 9564, "verse_number": "७-२९-४०", "content_sanskrit": "अतिबलसदृशैः पराक्रमैस्तैर्मम कुलमानविवर्धनं कृतम् ।\nयदयमतुल्यबलस्त्वयाद्य वै त्रिदशपतिस्त्रिदशाश्च निर्जिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000564040, "chapter_id": 9564, "verse_number": "७-२९-४१", "content_sanskrit": "नय रथमधिरोप्य वासवं नगरमितो व्रज सेनया वृतस्त्वम् ।\nअहमपि तव गच्छतो द्रुतं सह सचिवैरनुयामि पृष्ठतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000564041, "chapter_id": 9564, "verse_number": "७-२९-४२", "content_sanskrit": "अथ स बलवृतः सवाहनस्त्रिदशपतिं परिगृह्य रावणिः ।\nस्वभवनमभिगम्य वीर्यवान्कृतसमरान्विससर्ज राक्षसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000564042, "chapter_id": 9564, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे एकोनत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]