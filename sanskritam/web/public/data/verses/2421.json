[{"id": 2067581, "chapter_id": 2421, "verse_number": "९-३९-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2067582, "chapter_id": 2421, "verse_number": "९-३९-१", "content_sanskrit": "सप्तसारस्वतं कस्मात्कश्च मङ्कणको मुनिः।\nकथं सिद्धः स भगवान्कश्चास्य नियमोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2067583, "chapter_id": 2421, "verse_number": "९-३९-२", "content_sanskrit": "कस्य वंशे समुत्पन्नः किं चाधीतं द्विजोत्तम।\nएतन्मे सर्वमाचक्ष्व यथातत्त्वं महामुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2067584, "chapter_id": 2421, "verse_number": "९-३९-३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2067585, "chapter_id": 2421, "verse_number": "९-३९-३", "content_sanskrit": "सप्तनद्यः सरस्वत्या याभिर्व्याप्तमिदं जगत्।\nआहूता बलवद्भिर्हि तत्रतत्र सरस्वती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2067586, "chapter_id": 2421, "verse_number": "९-३९-४", "content_sanskrit": "सुप्रभा काञ्चनाक्षी च विशाला च मनोरमा।\nसरस्वती चौघवती सुरेणुर्विमलोदका॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2067587, "chapter_id": 2421, "verse_number": "९-३९-५", "content_sanskrit": "पितामहस्य महतो वर्तमाने महामखे।\nवितते यज्ञवाटे च संसिद्धेषु द्विजातिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2067588, "chapter_id": 2421, "verse_number": "९-३९-६", "content_sanskrit": "पुण्याहघोषैर्विमलैर्वेदानां निनदैस्तथा।\nदेवेषु चैव व्यग्रेषु तस्मिन्यज्ञविधौ तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2067589, "chapter_id": 2421, "verse_number": "९-३९-७", "content_sanskrit": "तत्र चैव महाराज दीक्षिते प्रपितामहे।\nयजतस्तस्य सत्रेण सर्वकामसमृद्विना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2067590, "chapter_id": 2421, "verse_number": "९-३९-८", "content_sanskrit": "मनसा चिन्तिता ह्यर्था धर्मार्थकुशलैस्तदा।\nउपतिष्ठन्ति राजेन्द्र द्विजातींस्तत्रतत्र ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2067591, "chapter_id": 2421, "verse_number": "९-३९-९", "content_sanskrit": "जगुश्च तत्र गन्धर्वा ननृतुश्चाप्सरोगणाः।\nवादित्राणि च दिव्यानि वादयामासुरञ्जसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2067592, "chapter_id": 2421, "verse_number": "९-३९-१०", "content_sanskrit": "तस्य यज्ञस्य सम्पत्त्या तुतुषुर्देवतागणाः।\nविस्मयं परमं जग्मुः किमु मानुषयोनयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2067593, "chapter_id": 2421, "verse_number": "९-३९-११", "content_sanskrit": "वर्तमाने यथा यज्ञे पुष्करस्थे पितामहे।\nअब्रुवन्नृषयो राजन्नायं यज्ञो महागुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2067594, "chapter_id": 2421, "verse_number": "९-३९-१२", "content_sanskrit": "न दृश्यते सरिच्छ्रेष्ठा यस्मादिह सरस्वती।\nतच्छ्रुत्वा भगवान्प्रीतः सस्माराथ सरस्वतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2067595, "chapter_id": 2421, "verse_number": "९-३९-१३", "content_sanskrit": "पितामहेन यजता आहूता पुष्करेषु वै।\nसुप्रभा नाम राजेन्द्र नाम्ना तत्र सरस्वती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2067596, "chapter_id": 2421, "verse_number": "९-३९-१४", "content_sanskrit": "तां दृष्ट्वा मुनयस्तुष्टास्त्वरायुक्तां सरस्वतीम्।\nपितामहं मानयन्तीं क्रतुं ते बहुमेनिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2067597, "chapter_id": 2421, "verse_number": "९-३९-१५", "content_sanskrit": "एवमेषा सरिच्छ्रेष्ठा पुष्करेषु सरस्वती।\nपितामहार्थं सम्भूता तुष्ट्यर्थं च मनीषिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2067598, "chapter_id": 2421, "verse_number": "९-३९-१६", "content_sanskrit": "नैमिषे मुनयो राजन्समागम्य समासते।\nतत्र चित्राः कथा ह्यासन्वेदं प्रति जनेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2067599, "chapter_id": 2421, "verse_number": "९-३९-१७", "content_sanskrit": "यत्र ते मुनयो ह्यासन्नानास्वाध्यायवेदिनः।\nते समागम्य मुनयः सस्मारुर्वै सरस्वतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2067600, "chapter_id": 2421, "verse_number": "९-३९-१८", "content_sanskrit": "सा तु ध्याता महाराज मुनिभिः सत्रयाजिभिः।\nसमागतानां राजेन्द्र साहाय्यार्थं महात्मनाम्।\nआजगाम महाभागा तत्र पुण्या सरस्वती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2067601, "chapter_id": 2421, "verse_number": "९-३९-१९", "content_sanskrit": "नैमिषे काञ्चनाक्षी तु मुनीनां सत्रायाजिxxxम्।\nआगता सरितां श्रेष्ठा तत्र भारत पूजित॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2067602, "chapter_id": 2421, "verse_number": "९-३९-२०", "content_sanskrit": "गयस्य यजमानस्य गयेष्वेव महाक्रतुम्।\nआहूता सरितां श्रेष्ठा गययज्ञे सरस्वती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2067603, "chapter_id": 2421, "verse_number": "९-३९-२१", "content_sanskrit": "गयस्य यजमानस्य गयेष्वेव महाक्रतुम्।\nविशालां तु गयस्याहुर्ऋषयः संशितव्रता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2067604, "chapter_id": 2421, "verse_number": "९-३९-२२", "content_sanskrit": "सरित्सा हिमवत्पार्श्वात्प्रस्रुता शीघ्रगामिनी।\nऔद्दालकेस्तथा यज्ञे यजतस्तस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2067605, "chapter_id": 2421, "verse_number": "९-३९-२३", "content_sanskrit": "समेते सर्वतः स्फीते मुनीनां मण्डले तदा।\nउत्तरे कोसलाभागे पुण्ये राजन्महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2067606, "chapter_id": 2421, "verse_number": "९-३९-२४", "content_sanskrit": "औद्दालकेन यजता पूर्वं ध्याता सरस्वती।\nआजगाम सरिच्छेष्ठा तं देशं मुनिकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2067607, "chapter_id": 2421, "verse_number": "९-३९-२५", "content_sanskrit": "पूज्यमाना मुनिगणैर्वल्कलाजिनसंवृतैः।\nमनोहरेति विख्याता सा हि तैर्मनसा वृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2067608, "chapter_id": 2421, "verse_number": "९-३९-२६", "content_sanskrit": "[सुरणुऋषभे द्वीपे पुण्ये राजर्षिसेविते।]\nकुरोश्च यजमानस्य कुरुक्षेत्रे महात्मनः।\nआजगाम महाभागा सरिच्छ्रेष्ठा सरस्वती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2067609, "chapter_id": 2421, "verse_number": "९-३९-२७", "content_sanskrit": "ओघवत्यपि राजेन्द्र वसिष्ठेन महात्मना।\nसमाहूता कुरुक्षेत्रे दिव्यतोया सरस्वती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2067610, "chapter_id": 2421, "verse_number": "९-३९-२८", "content_sanskrit": "दक्षेण यजता चापि गङ्गाद्वारे सरस्वती।\nसुवेणिरिति विख्याता प्रस्रुता शीघ्रगामिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2067611, "chapter_id": 2421, "verse_number": "९-३९-२९", "content_sanskrit": "विमलोदा भगवती ब्रह्मणा यजता पुनः।\nसमाहूता ययौ तत्र पुण्ये हैमवते गिरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2067612, "chapter_id": 2421, "verse_number": "९-३९-३०", "content_sanskrit": "एकीभूतास्ततस्तास्तु तस्मिंस्तीर्थे समागताः।\nसप्तसारस्वतं तीर्थं ततस्तु प्रथितं भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2067613, "chapter_id": 2421, "verse_number": "९-३९-३१", "content_sanskrit": "इति सप्तसरस्वत्यो नामतः परिकीर्तिताः।\nसप्तसारस्वतं चैव तीर्थं पुण्यं तथा स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2067614, "chapter_id": 2421, "verse_number": "९-३९-३२", "content_sanskrit": "शृणु मङ्कणकस्यापि कौमारब्रह्मचारिणः।\nआपगामवगाढस्य राजन्प्रक्रीडितं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2067615, "chapter_id": 2421, "verse_number": "९-३९-३३", "content_sanskrit": "दृष्ट्वा यदृच्छया तत्र स्त्रियमम्भसि भारत।\nस्नायन्तीं रुचिरापाङ्गीं दिग्वाससमनिन्दिताम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2067616, "chapter_id": 2421, "verse_number": "९-३९-३४", "content_sanskrit": "सरस्वत्यां महाराज चस्कन्दे वीर्यमम्भसि॥\nतद्रेतः स तु जग्राह कलशे वै महातपाः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2067617, "chapter_id": 2421, "verse_number": "९-३९-३५", "content_sanskrit": "`ऋषिः परमधर्मात्मा तदा पुरुषसत्तम॥\nसप्तधा प्रविभागं तु कलशस्थं जगाम ह।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2067618, "chapter_id": 2421, "verse_number": "९-३९-३६", "content_sanskrit": "तत्रर्षयः सप्त जाता जज्ञिरे मरुतां गणाः॥\nवायुवेगो वायुबलो वायुहा वायुमण्डलः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2067619, "chapter_id": 2421, "verse_number": "९-३९-३७", "content_sanskrit": "वायुज्वालो वायुरेता वायुचक्रश्च वीर्यवान्।\nमहर्षेश्चरितं यादृक् त्रिषु लोकेषु विश्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2067620, "chapter_id": 2421, "verse_number": "९-३९-३८", "content_sanskrit": "पुरा मङ्कणकः सिद्भः कुशाग्रेणेति नः श्रुतम्।\nक्षतः किल करे राजंस्तस्य शाकरसोऽस्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2067621, "chapter_id": 2421, "verse_number": "९-३९-३९", "content_sanskrit": "स वै शाकरसं दृष्ट्वा हर्षाविष्टः प्रनृत्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2067622, "chapter_id": 2421, "verse_number": "९-३९-४०", "content_sanskrit": "ततस्तस्मिन्प्रनृत्ते वै स्थावरं जङ्गमं च यत्।\nप्रनृत्तमुभयं वीर सेजसा तस्य मोहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2067623, "chapter_id": 2421, "verse_number": "९-३९-४१", "content_sanskrit": "ब्रह्मादिभिः सुरै राजन्नृषिभिश्च तपोधनैः।\nविज्ञप्तो वै महादेव ऋषेरर्थे नराधिप।\nनायं नृत्येद्यथा देव तथा त्वं कर्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2067624, "chapter_id": 2421, "verse_number": "९-३९-४२", "content_sanskrit": "ततो देवो मुनिं दृष्ट्वा हर्षाविष्टमतीव ह।\nसुगणां हितकामार्थं महादेवोऽभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2067625, "chapter_id": 2421, "verse_number": "९-३९-४३", "content_sanskrit": "भोभो ब्राह्मण धर्मज्ञ किमर्थं नृत्यते भवान्।\nहर्षस्थानं किमर्थं च तवेदमधिकं मुने।\nतपस्विनो धर्मपथे स्थितस्य द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2067626, "chapter_id": 2421, "verse_number": "९-३९-४४x", "content_sanskrit": "ऋषिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2067627, "chapter_id": 2421, "verse_number": "९-३९-४४", "content_sanskrit": "किं न पश्यसि मे ब्रह्मन्कराच्छाकरसं स्रुतम्।\nयं दृष्ट्वा सम्प्रनृत्तो वै हर्षेण महता विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2067628, "chapter_id": 2421, "verse_number": "९-३९-४५", "content_sanskrit": "तं प्रहस्याब्रवीद्देवो मुनिं रागेण मोहितम्।\nअहं न विस्मयं विप्र गच्छामीति प्रपश्य माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2067629, "chapter_id": 2421, "verse_number": "९-३९-४६", "content_sanskrit": "एवमुक्त्वा मुनिश्रेष्ठं महादेवेन धीमता।\nअङ्गुल्यग्रेण राजेन्द्रस्वाङ्गुष्ठस्ताडितोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2067630, "chapter_id": 2421, "verse_number": "९-३९-४७", "content_sanskrit": "ततो भस्म क्षताद्राजन्निर्गतं हिमसन्निभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2067631, "chapter_id": 2421, "verse_number": "९-३९-४८", "content_sanskrit": "तद्दृष्ट्वा व्रीडितो राजन्स मुनिः पादयोर्गतः।\nमेने देवं महादेवमिदं चोवाच विस्मितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2067632, "chapter_id": 2421, "verse_number": "९-३९-४९", "content_sanskrit": "नान्यं देवादहं मन्ये रुद्रात्परतरं महत्।\nसुरासुरस्य जगतो गतिस्त्वमसि शूलधृक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2067633, "chapter_id": 2421, "verse_number": "९-३९-५०", "content_sanskrit": "त्वया सृष्टमिदं विश्वं वदन्तीह मनीषिणः।\nत्वामेव सर्वं विशति पुनरेव युगक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2067634, "chapter_id": 2421, "verse_number": "९-३९-५१", "content_sanskrit": "देवैरपि न शक्यस्त्वं परिज्ञातुं कुतो मया।\nत्वयि सर्वे स्म दृश्यन्ते भावा ये जगति स्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2067635, "chapter_id": 2421, "verse_number": "९-३९-५२", "content_sanskrit": "त्वामुपासन्त वरदं देवा ब्रह्मादयोऽनघ।\nसर्वस्त्वमसि देवानां कर्ता कारयिता च ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2067636, "chapter_id": 2421, "verse_number": "९-३९-५३", "content_sanskrit": "त्वत्प्रसादात्सुराः सर्वे मोदन्तीहाकुतोभयाः।\n`त्वं प्रभुः परमैश्वर्यादधिकं भासि शङ्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2067637, "chapter_id": 2421, "verse_number": "९-३९-५४", "content_sanskrit": "त्वयि ब्रह्मा च विष्णुश्च लोकान्सन्धाय तिष्ठतः।\nत्वन्मूलं च जगत्सर्वं भूतस्थावरजङ्गमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2067638, "chapter_id": 2421, "verse_number": "९-३९-५५", "content_sanskrit": "स्वर्गं च परमं स्थानं नृणामभ्युदयार्थिनाम्।\nददासि च प्रसन्नस्त्वं भक्तानां परमेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2067639, "chapter_id": 2421, "verse_number": "९-३९-५६", "content_sanskrit": "अनावृत्तिपदं नॄणां नित्यं निश्रेयसार्थिनाम्।\nददासि कर्मिणां कर्म भावयन्ध्यानयोगतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2067640, "chapter_id": 2421, "verse_number": "९-३९-५७", "content_sanskrit": "न वृथाऽस्ति महादेव प्रसादस्ते महेश्वर।\nयस्मात्त्वयोपकरणात्करोमि कमलेक्षण॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2067641, "chapter_id": 2421, "verse_number": "९-३९-५८", "content_sanskrit": "प्रपद्ये शरणं शंभुं सर्वदा सर्वतः स्थितम्।\nकर्मणा मनसा वाचा तमेवाभिभजाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2067642, "chapter_id": 2421, "verse_number": "९-३९-५९x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2067643, "chapter_id": 2421, "verse_number": "९-३९-५९", "content_sanskrit": "एवं स्तुत्वा महादेवं स ऋषिः प्रणतोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2067644, "chapter_id": 2421, "verse_number": "९-३९-६०", "content_sanskrit": "यदिदं चापलं देव कृतमेतत्स्मयादिकम्।\nततः प्रसादयमि त्वां तपो मे न क्षरेदिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2067645, "chapter_id": 2421, "verse_number": "९-३९-६१", "content_sanskrit": "ततो देवः प्रीतमनास्तमृषिं पुनरब्रवीत्।\nतपस्ते वर्धतां विप्र मत्प्रसादात्सहस्रधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2067646, "chapter_id": 2421, "verse_number": "९-३९-६२", "content_sanskrit": "आश्रमे चेह वत्स्यामि त्वया सार्धमहं सदा।\nसप्तसारस्वते चास्मिन्यो मामर्चिष्यते नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2067647, "chapter_id": 2421, "verse_number": "९-३९-६३", "content_sanskrit": "न तस्य दुर्लभं किञ्चिद्धवितेह परत्र वा।\nसारस्वतं च ते लोकं गमिष्यन्ति न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2067648, "chapter_id": 2421, "verse_number": "९-३९-६४", "content_sanskrit": "एतन्मङ्कणकस्यापि चरितं भूरितेजसः।\nस हि पुत्रः सुकन्यायामुत्पन्नो मातरिश्वना॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2067649, "chapter_id": 2421, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि ह्रदप्रवेशपर्वणि एकोनचत्वारिंशोऽध्यायः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]