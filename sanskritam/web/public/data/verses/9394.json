[{"id": 5000394000, "chapter_id": 9394, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे पञ्चपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000394001, "chapter_id": 9394, "verse_number": "५-५५-१", "content_sanskrit": "संदीप्यमानां वित्रस्तां त्रस्तरक्षोगणां पुरीम्।\nअवेक्ष्य हनुमाँल्लङ्कां चिन्तयामास वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000394002, "chapter_id": 9394, "verse_number": "५-५५-२", "content_sanskrit": "तस्याभूत् सुमहांस्त्रासः कुत्सा चात्मन्यजायत।\nलङ्कां प्रदहता कर्म किंस्वित् कृतमिदं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000394003, "chapter_id": 9394, "verse_number": "५-५५-३", "content_sanskrit": "धन्याः खलु महात्मानो ये बुद‍्ध्या कोपमुत्थितम्।\nनिरुन्धन्ति महात्मानो दीप्तमग्निमिवाम्भसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000394004, "chapter_id": 9394, "verse_number": "५-५५-४", "content_sanskrit": "क्रुद्धः पापं न कुर्यात् कः क्रुद्धो हन्याद् गुरूनपि।\nक्रुद्धः परुषया वाचा नरः साधूनधिक्षिपेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000394005, "chapter_id": 9394, "verse_number": "५-५५-५", "content_sanskrit": "वाच्यावाच्यं प्रकुपितो न विजानाति कर्हिचित्।\nनाकार्यमस्ति क्रुद्धस्य नावाच्यं विद्यते क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000394006, "chapter_id": 9394, "verse_number": "५-५५-६", "content_sanskrit": "यः समुत्पतितं क्रोधं क्षमयैव निरस्यति।\nयथोरगस्त्वचं जीर्णां स वै पुरुष उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000394007, "chapter_id": 9394, "verse_number": "५-५५-७", "content_sanskrit": "धिगस्तु मां सुदुर्बुद्धिं निर्लज्जं पापकृत्तमम्।\nअचिन्तयित्वा तां सीतामग्निदं स्वामिघातकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000394008, "chapter_id": 9394, "verse_number": "५-५५-८", "content_sanskrit": "यदि दग्धा त्वियं सर्वा नूनमार्यापि जानकी।\nदग्धा तेन मया भर्तुर्हतं कार्यमजानता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000394009, "chapter_id": 9394, "verse_number": "५-५५-९", "content_sanskrit": "यदर्थमयमारम्भस्तत्कार्यमवसादितम्।\nमया हि दहता लङ्कां न सीता परिरक्षिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000394010, "chapter_id": 9394, "verse_number": "५-५५-१०", "content_sanskrit": "ईषत्कार्यमिदं कार्यं कृतमासीन्न संशयः।\nतस्य क्रोधाभिभूतेन मया मूलक्षयः कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000394011, "chapter_id": 9394, "verse_number": "५-५५-११", "content_sanskrit": "विनष्टा जानकी व्यक्तं न ह्यदग्धः प्रदृश्यते।\nलङ्कायाः कश्चिदुद्देशः सर्वा भस्मीकृता पुरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000394012, "chapter_id": 9394, "verse_number": "५-५५-१२", "content_sanskrit": "यदि तद्विहतं कार्यं मया प्रज्ञाविपर्ययात्।\nइहैव प्राणसंन्यासो ममापि ह्यद्य रोचते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000394013, "chapter_id": 9394, "verse_number": "५-५५-१३", "content_sanskrit": "किमग्नौ निपताम्यद्य आहोस्विद् वडवामुखे।\nशरीरमिह सत्त्वानां दद्मि सागरवासिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000394014, "chapter_id": 9394, "verse_number": "५-५५-१४", "content_sanskrit": "कथं नु जीवता शक्यो मया द्रष्टुं हरीश्वरः।\nतौ वा पुरुषशार्दूलौ कार्यसर्वस्वघातिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000394015, "chapter_id": 9394, "verse_number": "५-५५-१५", "content_sanskrit": "मया खलु तदेवेदं रोषदोषात् प्रदर्शितम्।\nप्रथितं त्रिषु लोकेषु कपित्वमनवस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000394016, "chapter_id": 9394, "verse_number": "५-५५-१६", "content_sanskrit": "धिगस्तु राजसं भावमनीशमनवस्थितम्।\nईश्वरेणापि यद् रागान्मया सीता न रक्षिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000394017, "chapter_id": 9394, "verse_number": "५-५५-१७", "content_sanskrit": "विनष्टायां तु सीतायां तावुभौ विनशिष्यतः।\nतयोर्विनाशे सुग्रीवः सबन्धुर्विनशिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000394018, "chapter_id": 9394, "verse_number": "५-५५-१८", "content_sanskrit": "एतदेव वचः श्रुत्वा भरतो भ्रातृवत्सलः।\nधर्मात्मा सहशत्रुघ्नः कथं शक्ष्यति जीवितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000394019, "chapter_id": 9394, "verse_number": "५-५५-१९", "content_sanskrit": "इक्ष्वाकुवंशे धर्मिष्ठे गते नाशमसंशयम्।\nभविष्यन्ति प्रजाः सर्वाः शोकसंतापपीडिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000394020, "chapter_id": 9394, "verse_number": "५-५५-२०", "content_sanskrit": "तदहं भाग्यरहितो लुप्तधर्मार्थसंग्रहः।\nरोषदोषपरीतात्मा व्यक्तं लोकविनाशनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000394021, "chapter_id": 9394, "verse_number": "५-५५-२१", "content_sanskrit": "इति चिन्तयतस्तस्य निमित्तान्युपपेदिरे।\nपूर्वमप्युपलब्धानि साक्षात् पुनरचिन्तयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000394022, "chapter_id": 9394, "verse_number": "५-५५-२२", "content_sanskrit": "अथ वा चारुसर्वाङ्गी रक्षिता स्वेन तेजसा।\nन नशिष्यति कल्याणी नाग्निरग्नौ प्रवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000394023, "chapter_id": 9394, "verse_number": "५-५५-२३", "content_sanskrit": "नहि धर्मात्मनस्तस्य भार्याममिततेजसः।\nस्वचरित्राभिगुप्तां तां स्प्रष्टुमर्हति पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000394024, "chapter_id": 9394, "verse_number": "५-५५-२४", "content_sanskrit": "नूनं रामप्रभावेण वैदेह्याः सुकृतेन च।\nयन्मां दहनकर्मायं नादहद्धव्यवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000394025, "chapter_id": 9394, "verse_number": "५-५५-२५", "content_sanskrit": "त्रयाणां भरतादीनां भ्रातॄणां देवता च या।\nरामस्य च मनःकान्ता सा कथं विनशिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000394026, "chapter_id": 9394, "verse_number": "५-५५-२६", "content_sanskrit": "यद् वा दहनकर्मायं सर्वत्र प्रभुरव्ययः।\nन मे दहति लाङ्गूलं कथमार्यां प्रधक्ष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000394027, "chapter_id": 9394, "verse_number": "५-५५-२७", "content_sanskrit": "पुनश्चाचिन्तयत् तत्र हनूमान् विस्मितस्तदा।\nहिरण्यनाभस्य गिरेर्जलमध्ये प्रदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000394028, "chapter_id": 9394, "verse_number": "५-५५-२८", "content_sanskrit": "तपसा सत्यवाक्येन अनन्यत्वाच्च भर्तरि।\nअसौ विनिर्दहेदग्निं न तामग्निः प्रधक्ष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000394029, "chapter_id": 9394, "verse_number": "५-५५-२९", "content_sanskrit": "स तथा चिन्तयंस्तत्र देव्या धर्मपरिग्रहम्।\nशुश्राव हनुमांस्तत्र चारणानां महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000394030, "chapter_id": 9394, "verse_number": "५-५५-३०", "content_sanskrit": "अहो खलु कृतं कर्म दुर्विगाहं हनूमता।\nअग्निं विसृजता तीक्ष्णं भीमं राक्षससद्मनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000394031, "chapter_id": 9394, "verse_number": "५-५५-३१", "content_sanskrit": "प्रपलायितरक्षःस्त्रीबालवृद्धसमाकुला।\nजनकोलाहलाध्माता क्रन्दन्तीवाद्रिकन्दरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000394032, "chapter_id": 9394, "verse_number": "५-५५-३२", "content_sanskrit": "दग्धेयं नगरी लङ्का साट्टप्राकारतोरणा।\nजानकी न च दग्धेति विस्मयोऽद्भुत एव नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000394033, "chapter_id": 9394, "verse_number": "५-५५-३३", "content_sanskrit": "इति शुश्राव हनुमान् वाचं ताममृतोपमाम्।\nबभूव चास्य मनसो हर्षस्तत्कालसम्भवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000394034, "chapter_id": 9394, "verse_number": "५-५५-३४", "content_sanskrit": "स निमित्तैश्च दृष्टार्थैः कारणैश्च महागुणैः।\nऋषिवाक्यैश्च हनुमानभवत् प्रीतमानसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000394035, "chapter_id": 9394, "verse_number": "५-५५-३५", "content_sanskrit": "ततः कपिः प्राप्तमनोरथार्थ-\nस्तामक्षतां राजसुतां विदित्वा।\nप्रत्यक्षतस्तां पुनरेव दृष्ट्वा\nप्रतिप्रयाणाय मतिं चकार ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000394036, "chapter_id": 9394, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे पञ्चपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]