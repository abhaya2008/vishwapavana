[{"id": 40022428, "chapter_id": 9394, "verse_number": "1", "content_sanskrit": "नारदस्य तु तद्वाक्यं श्रुत्वा ऽमृतमयं तदा । प्रहर्षमतुलं लेभे लक्ष्मणं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40022429, "chapter_id": 9394, "verse_number": "2", "content_sanskrit": "गच्छ सौम्य द्विजश्रेष्ठं समाश्वासय सुव्रतम् । बालस्य तु शरीरं तत्तैलद्रोण्यां निधापय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40022430, "chapter_id": 9394, "verse_number": "3", "content_sanskrit": "गन्धैश्च परमोदारैस्तैलैश्चापि सुगन्धिभिः । यथा न क्षीयते बालस्तथा सौम्य विधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40022431, "chapter_id": 9394, "verse_number": "4", "content_sanskrit": "यथा शरीरो बालस्य गुप्तः सन् शिष्टकर्मणः । विपत्तिः परिभेदो वा न भवेच्च तथा कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40022432, "chapter_id": 9394, "verse_number": "5", "content_sanskrit": "एवमादिश्य काकुत्स्थो लक्ष्मणं शुभलक्षणम् । मनसा पुष्पकं दध्यावागच्छेति महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40022433, "chapter_id": 9394, "verse_number": "6", "content_sanskrit": "इङ्गितं स तु विज्ञाय पुष्पको हेमभूषितः । आजगाम मुहूर्तेन समीपे राघवस्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40022434, "chapter_id": 9394, "verse_number": "7", "content_sanskrit": "सो ऽब्रवीत्प्रणतो भूत्वा अयमस्मि नराधिप । वश्यस्तव महाबाहो किङ्करः समुपस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40022435, "chapter_id": 9394, "verse_number": "8", "content_sanskrit": "भाषितं रुचिरं श्रुत्वा पुष्पकस्य नराधिपः । अभिवाद्य महर्षींस्तान् विमानं सो ऽध्यरोहत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40022436, "chapter_id": 9394, "verse_number": "9", "content_sanskrit": "धनुर्गृहीत्वा तूणी च खड्गं च रुचिरप्रभम् । निक्षिप्य नगरे वीरौ सौमित्रिभरतावुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40022437, "chapter_id": 9394, "verse_number": "10", "content_sanskrit": "प्रायात्प्रतीचीं हरितं विचिन्वंश्च ततस्ततः । उत्तरामगमच्छ्रीमान्दिशं हिमवता वृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40022438, "chapter_id": 9394, "verse_number": "11", "content_sanskrit": "अपश्यमानस्तत्रापि स्वल्पमप्यथ दुष्कृतम् । पूर्वामपि दिशं सर्वामथो ऽपश्यन्नराधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40022439, "chapter_id": 9394, "verse_number": "12", "content_sanskrit": "प्रविशुद्धसमाचारामादर्शतलनिर्मलाम् । पुष्पकस्थो महाबाहुस्तदापश्यन्नराधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40022440, "chapter_id": 9394, "verse_number": "13", "content_sanskrit": "दक्षिणां दिशमाक्रामत्ततो राजर्षिनन्दनः । शैवलस्योत्तरे पार्श्वे ददर्श सुमहत्सरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40022441, "chapter_id": 9394, "verse_number": "14", "content_sanskrit": "तस्मिन्सरसि तप्यन्तं तापसं सुमहत्तपः । ददर्श राघवः श्रीमाँल्लम्बमानमधोमुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40022442, "chapter_id": 9394, "verse_number": "15", "content_sanskrit": "राघवस्तमुपागम्य तप्यन्तं तप उत्तमम् । उवाच स तदा वाक्यं धन्यस्त्वमसि सुव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40022443, "chapter_id": 9394, "verse_number": "16", "content_sanskrit": "कस्यां योन्यां तपोवृद्ध वर्तसे दृढविक्रम । कौतूहलात्त्वां पृच्छामि रामो दाशरथिर्ह्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40022444, "chapter_id": 9394, "verse_number": "17", "content_sanskrit": "को ऽर्थो मनीषितस्तुभ्यं स्वर्गलाभः परो ऽथवा । वराश्रयो यदर्थं त्वं तपस्यसि सुदुष्करम् । यमाश्रित्य तपस्तप्तं श्रोतुमिच्छामि तापस ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40022445, "chapter_id": 9394, "verse_number": "18", "content_sanskrit": "ब्राह्मणो वा ऽसि भद्रं ते क्षत्रियो वा ऽसि दुर्जयः । वैश्यस्तृतीयवर्णो वा शूद्रो वा सत्यवाग्भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40022446, "chapter_id": 9394, "verse_number": "19", "content_sanskrit": "इत्येवमुक्तः स नराधिपेन ह्यवाक्छिरा दाशरथाय तस्मै । उवाच जातिं नृपपुङ्गवाय यत्कारणे चैव तपःप्रयत्नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]