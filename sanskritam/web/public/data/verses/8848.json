[{"id": 40001891, "chapter_id": 8848, "verse_number": "1", "content_sanskrit": "तत: प्रभाते विमले कृतकर्मा नराधिप:। विश्वामित्रं महात्मानं आजुहाव सराघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40001892, "chapter_id": 8848, "verse_number": "2", "content_sanskrit": "तमर्चयित्वा धर्मात्मा शास्त्रदृष्टेन कर्मणा। राघवौ च महात्मानौ तदा वाक्यमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40001893, "chapter_id": 8848, "verse_number": "3", "content_sanskrit": "भगवन् स्वागतं तेऽस्तु किं करोमि तवानघ। भवानाज्ञापयतु मामाज्ञाप्यो भवता ह्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40001894, "chapter_id": 8848, "verse_number": "4", "content_sanskrit": "एवमुक्तस्स धर्मात्मा जनकेन महात्मना। प्रत्युवाच मुनिर्वीरं वाक्यं वाक्यविशारद: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40001895, "chapter_id": 8848, "verse_number": "5", "content_sanskrit": "पुत्रौ दशरथस्येमौ क्षत्रियौ लोकविश्रुतौ। द्रुष्टुकामौ धनु श्श्रेष्ठं यदेतत्वयि तिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40001896, "chapter_id": 8848, "verse_number": "6", "content_sanskrit": "एतद्दर्शय भद्रं ते कृतकामौ नृपात्मजौ। दर्शनादस्य धनुषो यथेष्टं प्रतियास्यत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40001897, "chapter_id": 8848, "verse_number": "7", "content_sanskrit": "एवमुक्तस्तु जनक: प्रत्युवाच महामुनिम्। श्रूयतामस्य धनुषो यदर्थमिह तिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40001898, "chapter_id": 8848, "verse_number": "8", "content_sanskrit": "देवरात इति ख्यातो निमेष्षष्ठो महीपति:। न्यासोऽयं तस्य भगवन् हस्ते दत्तो महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40001899, "chapter_id": 8848, "verse_number": "9", "content_sanskrit": "दक्षयज्ञवधे पूर्वं धनुरायम्य वीर्यवान्। रुद्रस्तु त्रिदशान् रोषात्सलीलमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40001900, "chapter_id": 8848, "verse_number": "10", "content_sanskrit": "यस्माद्भागार्थिनो भागान्नाकल्पयत मे सुरा:। वराङ्गाणि महार्हाणि धनुषा शातयामि व: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40001901, "chapter_id": 8848, "verse_number": "11", "content_sanskrit": "ततो विमनसस्सर्वे देवा वै मुनिपुङ्गव। प्रसादयन्ति देवेशं तेषां प्रीतोऽभवद्भव: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40001902, "chapter_id": 8848, "verse_number": "12", "content_sanskrit": "प्रीतियुक्तस्स सर्वेषां ददौ तेषां महात्मनाम्। तदेतद्देवदेवस्य धनूरत्नं महात्मन:। न्यासभूतं तदा न्यस्तमस्माकं पूर्व के विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40001903, "chapter_id": 8848, "verse_number": "13", "content_sanskrit": "अथ मे कृषत: क्षेत्रं लाङ्गूलादुत्थिता मया। क्षेत्रं शोधयता लब्धा नाम्ना सीतेति विश्रुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40001904, "chapter_id": 8848, "verse_number": "14", "content_sanskrit": "भूतलादुत्थिता सा तु व्यवर्धत ममात्मजा। वीर्यशुल्केति मे कन्या स्थापितेयमयोनिजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40001905, "chapter_id": 8848, "verse_number": "15", "content_sanskrit": "भूतलादुत्थितां तां तु वर्धमानां ममात्मजाम्। वरयामासुरागम्य राजानो मुनिपुंगव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40001906, "chapter_id": 8848, "verse_number": "16", "content_sanskrit": "तेषां वरयतां कन्यां सर्वेषां पृथिवीक्षिताम्। वीर्यशुल्केति भगवन् न ददामि सुतामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40001907, "chapter_id": 8848, "verse_number": "17", "content_sanskrit": "ततस्सर्वे नृपतय स्समेत्य मुनिपुंगव। मिथिलामभ्युपागम्य वीर्यजिज्ञासवस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40001908, "chapter_id": 8848, "verse_number": "18", "content_sanskrit": "तेषां जिज्ञासमानानां वीर्यं धनुरुपाहृतम्। न शेकुर्ग्रहणे तस्य धनुषस्तोलनेऽपि वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40001909, "chapter_id": 8848, "verse_number": "19", "content_sanskrit": "तेषां वीर्यवतां वीर्यमल्पं ज्ञात्वा महामुने । प्रत्याख्याता नृपतयस्तन्निबोध तपोधन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40001910, "chapter_id": 8848, "verse_number": "20", "content_sanskrit": "तत: परमकोपेन राजानो नृपपुङ्गव। न्यरुंधन्मिथिलां सर्वे वीर्यसंदेहमागता: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40001911, "chapter_id": 8848, "verse_number": "21", "content_sanskrit": "आत्मानमवधूतं ते विज्ञाय नृपपुङ्गवा:। रोषेण महताऽऽविष्टा: पीडयन्मिथिलां पुरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40001912, "chapter_id": 8848, "verse_number": "22", "content_sanskrit": "ततस्संवत्सरे पूर्णे क्षयं यातानि सर्वश:। साधनानि मुनिश्रेष्ठ ततोऽहं भृशदु:खित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40001913, "chapter_id": 8848, "verse_number": "23", "content_sanskrit": "ततो देवगणान् सर्वान् तपसाऽहं प्रसादयम्। ददुश्च परमप्रीता श्चतुरङ्गबलं सुरा: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40001914, "chapter_id": 8848, "verse_number": "24", "content_sanskrit": "ततो भग्ना नृपतयो हन्यमाना दिशो ययु:। अवीर्या वीर्यसन्दिग्धा स्सामात्या: पापकर्मण: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40001915, "chapter_id": 8848, "verse_number": "25", "content_sanskrit": "तदेतन्मुनिशार्दूल धनु: परमभास्वरम्। रामलक्ष्मणयोश्चापि दर्शयिष्यामि सुव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40001916, "chapter_id": 8848, "verse_number": "26", "content_sanskrit": "यद्यस्य धनुषो राम: कुर्यादारोपणं मुने। सुतामयोनिजां सीतां दद्यां दाशरथेरहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]