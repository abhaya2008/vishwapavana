[{"id": 7004072000, "chapter_id": 24072, "verse_number": "४-२१-१", "content_sanskrit": "ध्रुव उवाच ।\nनमो हिरण्यगर्भाय सर्वसृष्टिविधायिने ।\nहिरण्यरेतसे तुभ्यं सुहिरण्यप्रदायिने ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004072001, "chapter_id": 24072, "verse_number": "४-२१-२", "content_sanskrit": "नमो हरस्वरूपाय भूतसंहारकारिणे ।\nमहाभूतात्मभूताय भूतानां पतये नमः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004072002, "chapter_id": 24072, "verse_number": "४-२१-३", "content_sanskrit": "नमः स्थितिकृते तुभ्यं विष्णवे प्रभविष्णवे ।\nतृष्णाहराय कृष्णाय महाभार सहिष्णवे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004072003, "chapter_id": 24072, "verse_number": "४-२१-४", "content_sanskrit": "नमो दैत्यमहारण्य दाववह्निस्वरूपिणे ।\nदैत्यद्रुमकुठाराय नमस्ते शार्ङ्गपाणये ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004072004, "chapter_id": 24072, "verse_number": "४-२१-५", "content_sanskrit": "नमः कौमोदकीव्यग्र कराग्राय गदाधर ।\nमहादनुजनाशाय नमो नंदकधारिणे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004072005, "chapter_id": 24072, "verse_number": "४-२१-६", "content_sanskrit": "नमः श्रीपतये तुभ्यं नमश्चक्रधराय च ।\nधराधराय वाराह रूपिणे परमात्मने ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004072006, "chapter_id": 24072, "verse_number": "४-२१-७", "content_sanskrit": "नमः कमलहस्ताय कमलावल्लभाय ते ।\nनमो मत्स्यादिरूपाय नमः कौस्तुभवक्षसे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004072007, "chapter_id": 24072, "verse_number": "४-२१-८", "content_sanskrit": "नमो वेदांतवेद्याय नमः श्रीवत्सधारिणे ।\nनमो गुणस्वरूपाय गुणिने गुणवर्जिते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004072008, "chapter_id": 24072, "verse_number": "४-२१-९", "content_sanskrit": "नमस्ते पद्मनाभाय पांचजन्यधराय च ।\nवासुदेव नमस्तुभ्यं देवकीनंदनाय च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004072009, "chapter_id": 24072, "verse_number": "४-२१-१०", "content_sanskrit": "प्रद्युम्नाय नमस्तुभ्यमनिरुद्धाय ते नमः ।\nनमः कंसविनाशाय नमश्चाणूरमर्दिने ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004072010, "chapter_id": 24072, "verse_number": "४-२१-११", "content_sanskrit": "दामोदरहृषीकेश गोर्विदाच्युतमाधव ।\nउपेंद्रकैटभाऽराते मधुहंतरधोक्षज ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004072011, "chapter_id": 24072, "verse_number": "४-२१-१२", "content_sanskrit": "नारायणाय नरकहारिणे पापहारिणे ।\nवामनाय नमस्तुभ्यं हरये शौरये नमः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004072012, "chapter_id": 24072, "verse_number": "४-२१-१३", "content_sanskrit": "अनंताय नमस्तुभ्यमनंतशयनाय च ।\nरुक्मिणीपतये तुभ्यं रुक्मिप्रमथनाय च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004072013, "chapter_id": 24072, "verse_number": "४-२१-१४", "content_sanskrit": "चैद्यहंत्रे नमस्तुभ्यं दानवारेसुरारये ।\nमुकुंदपरमानंद नंदगोपप्रियाय च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004072014, "chapter_id": 24072, "verse_number": "४-२१-१५", "content_sanskrit": "नमस्ते पुंडरीकाक्ष दनुजेंद्र निषूदिने ।\nनमो गोपालरूपाय वेणुवादनकारिणे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004072015, "chapter_id": 24072, "verse_number": "४-२१-१६", "content_sanskrit": "गोपीप्रियाय केशिघ्ने गोवर्धनधराय च ।\nरामाय रघुनाथाय राघवाय नमोनमः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004072016, "chapter_id": 24072, "verse_number": "४-२१-१७", "content_sanskrit": "रावणारे नमस्तुभ्यं विभीषणशरण्यद ।\nअजाय जयरूपाय रणांगणविचक्षण ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004072017, "chapter_id": 24072, "verse_number": "४-२१-१८", "content_sanskrit": "क्षणादि कालरूपाय नानारूपाय शार्ङ्गिणे ।\nगदिने चक्रिणे तुभ्यं दैत्यचक्रविमर्दिने ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004072018, "chapter_id": 24072, "verse_number": "४-२१-१९", "content_sanskrit": "बलाय बलभद्राय बलारातिप्रियाय च ।\nबलियज्ञप्रमथन नमो भक्तवरप्रद ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004072019, "chapter_id": 24072, "verse_number": "४-२१-२०", "content_sanskrit": "हिरण्यकशिपोर्वक्षो विदारण रणप्रिय ।\nनमो ब्रह्मण्यदेवाय गोब्राह्मणहिताय च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004072020, "chapter_id": 24072, "verse_number": "४-२१-२१", "content_sanskrit": "नमस्ते धर्मरूपाय नमः सत्त्वगुणाय च ।\nनमः सहस्रशिरसे पुरुषाय पराय च ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004072021, "chapter_id": 24072, "verse_number": "४-२१-२२", "content_sanskrit": "सहस्राक्ष सहस्रांघ्रे सहस्रकिरणाय च ।\nसहस्रमूर्ते श्रीकांत नमस्ते यज्ञपूरुष ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004072022, "chapter_id": 24072, "verse_number": "४-२१-२३", "content_sanskrit": "वेदवेद्यस्वरूपाय नमो वेदप्रियाय च ।\nवेदाय वेदगदिने सदाचाराध्वगामिने ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004072023, "chapter_id": 24072, "verse_number": "४-२१-२४", "content_sanskrit": "वैकुंठाय नमस्तुभ्यं नमो वैकुंठवासिने ।\nविष्टरश्रवसे तुभ्यं नमो गरुडगामिने ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004072024, "chapter_id": 24072, "verse_number": "४-२१-२५", "content_sanskrit": "विष्वक्सेन नमस्तुभ्यं जगन्मय जनार्दन ।\nत्रिविक्रमाय सत्याय नमः सत्यप्रियाय च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004072025, "chapter_id": 24072, "verse_number": "४-२१-२६", "content_sanskrit": "केशवाय नमस्तुभ्यं मायिने ब्रह्मागायिने ।\nतपोरूपाय तपसां नमस्ते फलदायिने ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004072026, "chapter_id": 24072, "verse_number": "४-२१-२७", "content_sanskrit": "स्तुत्याय स्तुतिरूपाय भक्तस्तुतिरताय च ।\nनमस्ते श्रुतिरूपाय श्रुत्याचार प्रियाय च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004072027, "chapter_id": 24072, "verse_number": "४-२१-२८", "content_sanskrit": "अंडजाय नमस्तुभ्यं स्वेदजाय नमोस्तु ते ।\nजरायुज स्वरूपाय नम उद्भिज्जरूपिणे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004072028, "chapter_id": 24072, "verse_number": "४-२१-२९", "content_sanskrit": "देवानामिंद्ररूपोसि ग्रहाणामसि भानुमान् ।\nलोकानां सत्यलोकोऽसि सिंधूनां क्षीरसागरः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004072029, "chapter_id": 24072, "verse_number": "४-२१-३०", "content_sanskrit": "सुरापगाऽसि सरितां सरसां मानसं सरः ।\nहिमवानसि शैलानां धेनूनां कामधुग्भवान् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004072030, "chapter_id": 24072, "verse_number": "४-२१-३१", "content_sanskrit": "धातूनां हाटकमसि स्फटिकश्चोपलेष्वसि ।\nनीलोत्पलं प्रसूनेषु वृक्षेषु तुलसी भवान् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004072031, "chapter_id": 24072, "verse_number": "४-२१-३२", "content_sanskrit": "सर्वपूज्यशिलानां वै शालग्राम शिला भवान् ।\nमुक्तिक्षेत्रेषु काशी त्वं प्रयागस्तीर्थपंक्तिषु ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004072032, "chapter_id": 24072, "verse_number": "४-२१-३३", "content_sanskrit": "वर्णेषु श्वेतवर्णोऽसि द्विपदां ब्राह्मणो भवान् ।\nगरुडोस्यंडजेष्वीश व्यवहारेषु वाग्भवान् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004072033, "chapter_id": 24072, "verse_number": "४-२१-३४", "content_sanskrit": "वेदेषूपनिषद्रूपा मंत्राणां प्रणवोह्यसि ।\nअक्षराणामकारोसि यज्वनां सोमरूपधृक् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004072034, "chapter_id": 24072, "verse_number": "४-२१-३५", "content_sanskrit": "प्रतापिनामग्निरसि क्षमाऽसि त्वं क्षमावताम् ।\nदातॄणामसि पर्जन्यः पवित्राणां परोह्यसि ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004072035, "chapter_id": 24072, "verse_number": "४-२१-३६", "content_sanskrit": "चापोसि सर्वशस्त्राणां वातो वेगवतामसि ।\nमनोसींद्रियवर्गेषु निर्भयाणां करोह्यसि ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004072036, "chapter_id": 24072, "verse_number": "४-२१-३७", "content_sanskrit": "व्योमव्याप्तिमतां त्वं वै परमात्माऽसि चात्मनाम् ।\nसंध्योपास्तिर्भवान्देव सर्वनित्येषु कर्मसु ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004072037, "chapter_id": 24072, "verse_number": "४-२१-३८", "content_sanskrit": "क्रतूनामश्वमेधोसि दानानामभयं भवान् ।\nलाभानां पुत्रलाभोसि वसंतस्त्वमृतुष्वहो ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004072038, "chapter_id": 24072, "verse_number": "४-२१-३९", "content_sanskrit": "युगानां प्रथमोसि त्वं तिथीनां त्वं कुहूर्ह्यसि ।\nपुष्योसि नक्षत्रगणे संक्रमः सर्वपर्वसु ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004072039, "chapter_id": 24072, "verse_number": "४-२१-४०", "content_sanskrit": "योगेषु व्यतिपातस्त्वं तृणेषु हि कुशो भवान् ।\nउद्यमानां हि सर्वेषां निर्वाणं त्वमसि प्रभो ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004072040, "chapter_id": 24072, "verse_number": "४-२१-४१", "content_sanskrit": "सर्वासामिह बुद्धीनां धर्मबुद्धिर्भवानज ।\nअश्वत्थः सर्ववृक्षेषु सोमवल्ली लतासु च ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004072041, "chapter_id": 24072, "verse_number": "४-२१-४२", "content_sanskrit": "प्राणायामोसि सर्वेपु साधनेषु शुचिष्वहो ।\nसर्वदः सर्वलिंगेषु श्रीमान्विश्वेश्वरो भवान् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004072042, "chapter_id": 24072, "verse_number": "४-२१-४३", "content_sanskrit": "मित्राणां हि कलत्रं त्वं धर्मस्त्वं सर्वबंधुषु ।\nत्वत्तो नान्यज्जगत्यस्मिन्नारायण चराचरे ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004072043, "chapter_id": 24072, "verse_number": "४-२१-४४", "content_sanskrit": "त्वमेव माता त्वं तातस्त्वं सुतस्त्वं महाधनम् ।\nत्वमेव सौख्यसंपत्तिस्त्वमायुर्जीवनेश्वरः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004072044, "chapter_id": 24072, "verse_number": "४-२१-४५", "content_sanskrit": "सा कथा यत्र ते नाम तन्मनो यत्त्वदर्पितम् ।\nतत्कर्म यत्त्वदर्थं वै तत्तपो यद्भवत्स्मृतिः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004072045, "chapter_id": 24072, "verse_number": "४-२१-४६", "content_sanskrit": "तद्धनं धनिनां शुद्धं यत्त्वदर्थे व्ययीकृतम् ।\nस एव सकलः कालो यस्मिञ्जिष्णो त्वमर्च्यसे ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004072046, "chapter_id": 24072, "verse_number": "४-२१-४७", "content_sanskrit": "तावच्च जीवितं श्रेयो यावत्त्वं हृदि वर्तसे ।\nरोगाः प्रशममायांति त्वत्पादोदक सेवनात् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004072047, "chapter_id": 24072, "verse_number": "४-२१-४८", "content_sanskrit": "महापापानि गोविंद बहुजन्मार्जितान्यपि ।\nसद्यो विलयमायांति वासुदेवेति कीर्तनात् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004072048, "chapter_id": 24072, "verse_number": "४-२१-४९", "content_sanskrit": "अहो पुंसां महामोहस्त्वहो पुंसां प्रमादता ।\nवासुदेवमनादृत्य यदन्यत्र कृतश्रमाः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004072049, "chapter_id": 24072, "verse_number": "४-२१-५०", "content_sanskrit": "इदमेव हि मांगल्यमिदमेव धनार्जनम् ।\nजीवितस्य फलं चैतद्यद्दामोदरकीर्तनम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004072050, "chapter_id": 24072, "verse_number": "४-२१-५१", "content_sanskrit": "अधोक्षजात्परोधर्मो नार्थो नारायणात्परः ।\nन कामः केशवादन्यो नापवर्गो हरिं विना ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004072051, "chapter_id": 24072, "verse_number": "४-२१-५२", "content_sanskrit": "इयमेव परा हानिरुपसर्गो यमेवहि ।\nअभाग्यं परमं चैतद्वासुदेवं न यत्स्मरेत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004072052, "chapter_id": 24072, "verse_number": "४-२१-५३", "content_sanskrit": "हरेराराधनं पुंसां किं किं न कुरुते बत ।\nपुत्रमित्रकलत्रार्थ राज्यस्वर्गापवर्गदम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004072053, "chapter_id": 24072, "verse_number": "४-२१-५४", "content_sanskrit": "हरत्यघं ध्वंसयति व्याधीनाधीन्नियच्छति ।\nधर्मं विवर्धयेत्क्षिप्रं प्रयच्छति मनोरथम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004072054, "chapter_id": 24072, "verse_number": "४-२१-५५", "content_sanskrit": "भगवच्चरणद्वंद्वं निर्द्द्वंद्व ध्यानमुत्तमम् ।\nपापिनापि प्रसंगेन विहितं स्वहितं परम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004072055, "chapter_id": 24072, "verse_number": "४-२१-५६", "content_sanskrit": "पापिनां यानि पापानि महोपपदभांज्यपि ।\nसुलीनध्यानसंपन्नो नामोच्चारो हरेर्हरेत् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004072056, "chapter_id": 24072, "verse_number": "४-२१-५७", "content_sanskrit": "प्रमादादपि संस्पृष्टो यथाऽनलकणो दहेत् ।\nतथौष्ठपुटसंस्पृष्ट हरिनाम हरेदघम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004072057, "chapter_id": 24072, "verse_number": "४-२१-५८", "content_sanskrit": "नितांतं कमलाकांते शांतचित्तं विधाय यः ।\nसंशीलयेत्क्षणं नूनं कमला तत्र निश्चला ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004072058, "chapter_id": 24072, "verse_number": "४-२१-५९", "content_sanskrit": "अयमेव परोधर्मस्त्विदमेव परं तपः ।\nइदमेव परं तीर्थं विष्णुपादांबु यत्पिबेत ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004072059, "chapter_id": 24072, "verse_number": "४-२१-६०", "content_sanskrit": "तवोपहारं भक्त्याय सेवते यजपूरुष ।\nसेवितस्तेन नियतं पुरोडाशो महाधिया ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004072060, "chapter_id": 24072, "verse_number": "४-२१-६१", "content_sanskrit": "स चैवावभृथस्नातः स च गंगाजलाप्लुतः ।\nविष्णुपादोदकं कृत्वा शंखे यः स्नाति मानवः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004072061, "chapter_id": 24072, "verse_number": "४-२१-६२", "content_sanskrit": "शालग्राम शिला येन पूजिता तुलसी दलैः ।\nस पारिजातमालाभिः पूज्यते सुरसद्मनि ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004072062, "chapter_id": 24072, "verse_number": "४-२१-६३", "content_sanskrit": "ब्राह्मणः क्षत्रियो वैश्यः शूद्रो वा यदि वेतरः ।\nविष्णुभक्ति समायुक्तो ज्ञेयः सर्वोत्तमश्च सः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004072063, "chapter_id": 24072, "verse_number": "४-२१-६४", "content_sanskrit": "शंखचक्रांकिततनुः शिरसां मंजरीधरः ।\nगोपीचंदनलिप्तांगो दृष्टश्चेत्तदघं कुतः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004072064, "chapter_id": 24072, "verse_number": "४-२१-६५", "content_sanskrit": "प्रत्यहं द्वादशशिलाः शालग्रामस्य योऽर्चयेत् ।\nद्वारवत्याः शिलायुक्तः स वैकुंठे महीयते ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004072065, "chapter_id": 24072, "verse_number": "४-२१-६६", "content_sanskrit": "तुलसी यस्य भवने प्रत्यहं परिपूज्यते ।\nतद्गृहं नोपसर्पंति कदाचिद्यमकिंकराः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004072066, "chapter_id": 24072, "verse_number": "४-२१-६७", "content_sanskrit": "हरिनामाक्षरमुखं भाले गोपीमृदांकितम् ।\nतुलसीमालितोरस्कं स्पृशेयुर्नयमानुगाः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004072067, "chapter_id": 24072, "verse_number": "४-२१-६८", "content_sanskrit": "गोपीमृत्तुलसी शंखः शालग्रामः सचक्रकः ।\nगृहेपि यस्य पंचैते तस्य पापभयं कुत ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004072068, "chapter_id": 24072, "verse_number": "४-२१-६९", "content_sanskrit": "ये मुहूर्ताः क्षणा ये च या काष्ठा ये निमेषकाः ।\nऋते विष्णुस्मृतेर्यातास्तेषु मुष्टो यमेन सः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004072069, "chapter_id": 24072, "verse_number": "४-२१-७०", "content_sanskrit": "क्व द्वयक्षरं हरेर्नाम स्फुलिंगसदृशं ज्वलेत ।\nमहती पातकानां च राशिस्तूलोपमा क्व च ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004072070, "chapter_id": 24072, "verse_number": "४-२१-७१", "content_sanskrit": "गोविंद परमानंदं मुकुंदं मधुसूदनम ।\nत्यक्त्वान्यं नैव जानामि न भजामि स्मरामि न ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004072071, "chapter_id": 24072, "verse_number": "४-२१-७२", "content_sanskrit": "न नमामि न च स्तौमि न पश्यामीह चक्षुषा ।\nन स्पृशामि न वायामि गायामि न न हरिं विना ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004072072, "chapter_id": 24072, "verse_number": "४-२१-७३", "content_sanskrit": "जले स्थले च पातालेप्यनिले चानलेऽचले ।\nविद्याधरासुरसुरे किं नरे वानरे नरे ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004072073, "chapter_id": 24072, "verse_number": "४-२१-७४", "content_sanskrit": "तृणेस्त्रैणे च पाषाणे तरुगुल्मलतासु च ।\nसर्वत्र श्यामलतनुं वीक्षे श्रीवत्सवक्षसम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004072074, "chapter_id": 24072, "verse_number": "४-२१-७५", "content_sanskrit": "सर्वेषां हृदयावासः साक्षात्साक्षी त्वमेव हि ।\nबहिरंतर्विना त्वां तु नह्यन्यं वेद्मि सर्वगम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004072075, "chapter_id": 24072, "verse_number": "४-२१-७६", "content_sanskrit": "इत्युक्त्वा विररामासौ शिवशर्मन्ध्रुवस्तदा ।\nदेवोपि भगवान्विष्णुस्तमुवाच प्रसन्नदृक् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004072076, "chapter_id": 24072, "verse_number": "४-२१-७७", "content_sanskrit": "श्रीभगवानुवाच ।\nअपि बाल विशालाक्ष ध्रुव ध्रुवमतेऽनघ ।\nपरिज्ञातो मया सम्यक्तवहृत्स्थो मनोरथः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004072077, "chapter_id": 24072, "verse_number": "४-२१-७८", "content_sanskrit": "अन्नाद्भवंति भूतानि वृष्टेरन्नसमुद्भवः ।\nतद्वृष्टेः कारणं सूर्यः सूर्याधारो ध्रुवैधि भोः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004072078, "chapter_id": 24072, "verse_number": "४-२१-७९", "content_sanskrit": "ज्योतिश्चक्रस्य सर्वस्य ग्रहर्क्षादेः समंततः ।\nगगने भ्रमतो नित्यं त्वमाधारो भविष्यसि ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004072079, "chapter_id": 24072, "verse_number": "४-२१-८०", "content_sanskrit": "मेढीभूतस्तु वै सर्वान्वायुपाशैर्नियंत्रितान् ।\nआकल्पं तत्पदं तिष्ठ भ्रामयञ्ज्योतिषांगणान् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004072080, "chapter_id": 24072, "verse_number": "४-२१-८१", "content_sanskrit": "आराध्य श्री महादेवं पुरापदमिदं मया ।\nआसादियत्तदेतत्ते तपसा प्रतिपादितम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004072081, "chapter_id": 24072, "verse_number": "४-२१-८२", "content_sanskrit": "केचिच्चतुर्युगं यावत्केचिन्मन्वंतरं ध्रुव ।\nतिष्ठंति त्वं तु वै कल्पं पदमेतत्प्रशास्यसि ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004072082, "chapter_id": 24072, "verse_number": "४-२१-८३", "content_sanskrit": "मनुनापि न यत्प्रापि किमन्यैर्मानवैर्ध्रुव ।\nतत्पदं विहितं त्वत्साच्छक्राद्यैरपि दुर्लभम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004072083, "chapter_id": 24072, "verse_number": "४-२१-८४", "content_sanskrit": "अन्यान्वरान्प्रयच्छामि स्तवेनानेन तोषितः ।\nसुनीतिरपि ते माता त्वत्समीपे चरिष्यति ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004072084, "chapter_id": 24072, "verse_number": "४-२१-८५", "content_sanskrit": "इदं स्तोत्रवरं यस्तु पठिष्यति समाहितः ।\nत्रिसंध्यं मनुजस्तस्य पापं यास्यति संक्षयम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004072085, "chapter_id": 24072, "verse_number": "४-२१-८६", "content_sanskrit": "न तस्य सदनं लक्ष्मीः परित्यक्ष्यत्यसंशयम् ।\nन जनन्या वियोगश्च न बंधुकलहोदयः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004072086, "chapter_id": 24072, "verse_number": "४-२१-८७", "content_sanskrit": "ध्रुवस्तुतिरियं पुण्या महापातकनाशिनी ।\nब्रह्महापि विशुद्ध्येत का कथेतर पापिनाम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004072087, "chapter_id": 24072, "verse_number": "४-२१-८८", "content_sanskrit": "महापुण्यस्य जननी महासंपत्तिदायिनी ।\nमहोपसर्गशमनी महाव्याधिविनाशिनी ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004072088, "chapter_id": 24072, "verse_number": "४-२१-८९", "content_sanskrit": "यस्याऽस्तिपरमा भक्तिर्मयि निर्मलचेतसः ।\nध्रुवस्तुतिरियं तेन जप्या मत्प्रीतिकारिणी ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004072089, "chapter_id": 24072, "verse_number": "४-२१-९०", "content_sanskrit": "समस्त तीर्थस्नानेन यत्फलं लभते नरः ।\nतत्फलं सम्यगाप्नोति जपन्स्तुत्यानया मुदा ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004072090, "chapter_id": 24072, "verse_number": "४-२१-९१", "content_sanskrit": "संति स्तोत्राण्यनेकानि मम प्रीतिकराणि च ।\nध्रुवस्तुतेर्न चैतस्याः कलामर्हंति षोडशीम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004072091, "chapter_id": 24072, "verse_number": "४-२१-९२", "content_sanskrit": "श्रुत्वापीमां स्तुतिं मर्त्यः श्रद्धया परया मुदा ।\nपातकैर्मुच्यते सद्यो महत्पुण्यमवाप्नुयात् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004072092, "chapter_id": 24072, "verse_number": "४-२१-९३", "content_sanskrit": "अपुत्रः पुत्रमाप्नोति निर्धनो धनमाप्नुयात् ।\nअभक्तो भक्तिमाप्नोति कीर्तनाच्च ध्रुवस्तुतेः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004072093, "chapter_id": 24072, "verse_number": "४-२१-९४", "content_sanskrit": "दत्त्वा दानान्यनेकानि कृत्वा नाना व्रतानि च ।\nयथालाभानवाप्नोति तथा स्तुत्याऽनया नरः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004072094, "chapter_id": 24072, "verse_number": "४-२१-९५", "content_sanskrit": "त्यक्त्वा सर्वाणि कार्याणि त्यक्त्वा जप्यान्यनेकशः ।\nध्रुवस्तुतिरियं जप्या सर्वकामप्रदायिनी ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004072095, "chapter_id": 24072, "verse_number": "४-२१-९६", "content_sanskrit": "श्रीभगवानुवाच ।\nध्रुवावधेहि वक्ष्यामि हितं तव महामते ।\nयेन ते निश्चलं सम्यक्पदमेतद्भविष्यति ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004072096, "chapter_id": 24072, "verse_number": "४-२१-९७", "content_sanskrit": "अहं जिगमिषुस्त्वासं पुरीं वाराणसीं शुभाम् ।\nसाक्षाद्विश्वेश्वरो यत्र तिष्ठते मोक्षकारणम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004072097, "chapter_id": 24072, "verse_number": "४-२१-९८", "content_sanskrit": "विपन्नानां च जंतूनां यत्र विश्वेश्वरः स्वयम् ।\nकर्णे जापं प्रकुरुते कर्मनिर्मूलन क्षमम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004072098, "chapter_id": 24072, "verse_number": "४-२१-९९", "content_sanskrit": "अस्य संसारदुःखस्य सर्वोपद्रवदायिनः ।\nउपाय एक एवास्ति काशिकानंदभूमिका ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004072099, "chapter_id": 24072, "verse_number": "४-२१-१००", "content_sanskrit": "इदं रम्यमिदं नेति बीजं दुःखमहातरोः ।\nतस्मिन्काश्यग्निना दग्धे दुःखस्यावसरः कुतः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004072100, "chapter_id": 24072, "verse_number": "४-२१-१०१", "content_sanskrit": "प्राप्य संप्राप्यते येन न भूयो येन शोच्यते ।\nपरायानिर्वृतेः स्थानं यत्तदानंदकाननम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004072101, "chapter_id": 24072, "verse_number": "४-२१-१०२", "content_sanskrit": "अमृतायनमुत्सृज्य पुरुषोन्यत्र यो वसेत् ।\nआनंदकाननं शंभोः कुतस्तस्य सुखोदयः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004072102, "chapter_id": 24072, "verse_number": "४-२१-१०३", "content_sanskrit": "वरं शरावहस्तस्य चांडालागारवीथिषु ।\nभिक्षार्थमटनं काश्यां राज्यं नान्यत्र नीरिषु ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004072103, "chapter_id": 24072, "verse_number": "४-२१-१०४", "content_sanskrit": "वैकुंठनगरात्काशीं नित्यं विश्वेशमर्चितुम् ।\nअहमायामि नियमाज्जगदर्च्यं तदर्चिताम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004072104, "chapter_id": 24072, "verse_number": "४-२१-१०५", "content_sanskrit": "मयि या परमा शक्तिस्त्रिलोक्या रक्षणक्षमा ।\nतत्र हेतुर्महेशानः स सुदर्शनचक्रदः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004072105, "chapter_id": 24072, "verse_number": "४-२१-१०६", "content_sanskrit": "पुरा जालंधरं दैत्यं ममापि परिकंपनम् ।\nपादांगुष्ठाग्ररेखोत्थं चक्रं सृष्ट्वा हरोऽहरत् ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004072106, "chapter_id": 24072, "verse_number": "४-२१-१०७", "content_sanskrit": "तच्च चक्रं मया लब्धं नेत्रपद्मार्चनाद्विभोः ।\nएतत्सुदर्शनाख्यं वै दैत्यचक्रप्रमर्दनम् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004072107, "chapter_id": 24072, "verse_number": "४-२१-१०८", "content_sanskrit": "तन्मया तव रक्षार्थं भूतविद्रावणं परम् ।\nतावत्प्रणुन्नं पुरतस्ततश्चाहमिहागतः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004072108, "chapter_id": 24072, "verse_number": "४-२१-१०९", "content_sanskrit": "काशीमिदानीं यास्यामि विश्वेश्वर विलोकने ।\nअद्य यात्राऽस्ति महती कार्तिक्यां बहुपुण्यदा ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004072109, "chapter_id": 24072, "verse_number": "४-२१-११०", "content_sanskrit": "कार्तिकस्य चतुर्दश्यां विश्वेशं यो विलोकयेत् ।\nस्नात्वा चोत्तरवाहिन्यां न तस्य पुनरागतिः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004072110, "chapter_id": 24072, "verse_number": "४-२१-१११", "content_sanskrit": "इत्युक्त्वा तार्क्ष्यमारोप्य ध्रुवमानंदमेदुरम् ।\nक्षणाद्वाराणसीं प्राप हरिः स्मरहरोषिताम् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004072111, "chapter_id": 24072, "verse_number": "४-२१-११२", "content_sanskrit": "पंचक्रोश्याश्च सीमानं प्राप्य देवो जनार्दनः ।\nवैनतेयादवारुह्य करे धृत्वा ध्रुवं ततः ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004072112, "chapter_id": 24072, "verse_number": "४-२१-११३", "content_sanskrit": "मणिकर्ण्यां परिस्नाय विश्वेशमभिपूज्य च ।\nध्रुवं बभाषे भगवान्हितं तस्य चिकीर्षयन् ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004072113, "chapter_id": 24072, "verse_number": "४-२१-११४", "content_sanskrit": "लिंगं स्थापय यत्नेन क्षेत्रेऽत्रैवाविमुक्तके ।\nत्रैलोक्यस्थापनं पुण्यं यथा भवति तेऽक्षयम् ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004072114, "chapter_id": 24072, "verse_number": "४-२१-११५", "content_sanskrit": "नियुतं यत्परिस्थाप्य लिंगानि फलमाप्यते ।\nअन्यत्र तदिहैकेन लिंगेन परिलभ्यते ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004072115, "chapter_id": 24072, "verse_number": "४-२१-११६", "content_sanskrit": "कालेन भंगमापन्नं जीर्णोद्धारं करोति यः ।\nइह तस्य फलस्यांतः प्रलयेपि न जायते ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004072116, "chapter_id": 24072, "verse_number": "४-२१-११७", "content_sanskrit": "वित्तशाठ्यं परित्यज्य प्रासादं योऽत्र कारयेत् ।\nतेन दत्तो भवेत्सर्वो मेरुर्नियुतयोजनः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7004072117, "chapter_id": 24072, "verse_number": "४-२१-११८", "content_sanskrit": "कूपवापीतडागानि शक्त्या योऽत्र तु कारयेत् ।\nअन्यत्र करणात्तस्य पुण्यं कोटिगुणाधिकम् ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7004072118, "chapter_id": 24072, "verse_number": "४-२१-११९", "content_sanskrit": "इज्यार्थमत्र यः कुर्यात्सुरम्यां पुष्पवाटिकाम् ।\nपुष्पेपुष्पे फलं तस्य सुवर्णकुसुमाधिकम् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7004072119, "chapter_id": 24072, "verse_number": "४-२१-१२०", "content_sanskrit": "अत्र ब्रह्मपुरीं कृत्वा यो विप्रेभ्यः प्रयच्छति ।\nवर्षाशनेन संयुक्तां तस्य पुण्यफलं शृणु ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7004072120, "chapter_id": 24072, "verse_number": "४-२१-१२१", "content_sanskrit": "क्षीयंते सलिलान्यब्धेर्भौमाश्च त्रसरेणवः ।\nक्षयो न तस्य पुण्यस्य शिवलोके समासतः ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7004072121, "chapter_id": 24072, "verse_number": "४-२१-१२२", "content_sanskrit": "मठानपि तपस्विभ्यः कारयित्वाऽत्र योर्पयेत् ।\nजीवनोपायसंयुक्तान्सोपि पूर्वफलाश्रयः ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7004072122, "chapter_id": 24072, "verse_number": "४-२१-१२३", "content_sanskrit": "कृत्वा महांति पुण्यानि योऽत्र विश्वेश्वरेऽर्पयेत् ।\nन तस्य पुनरावृरत्ति घोरे संसारसागरे ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7004072123, "chapter_id": 24072, "verse_number": "४-२१-१२४", "content_sanskrit": "अनंत इति वादोयं मयिलोकेऽत्र गीयते ।\nपरं काशी गुणानां हि मयाप्यंतो न लभ्यते ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7004072124, "chapter_id": 24072, "verse_number": "४-२१-१२५", "content_sanskrit": "तस्मात्प्रयत्नतः काश्यां धुव श्रेयः समाश्रयेत् ।\nकाशी श्रेयः फलं पुंसामक्षया योपजायते ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7004072125, "chapter_id": 24072, "verse_number": "४-२१-१२६", "content_sanskrit": "गणावूचतुः ।\nध्रुवमित्युपदिश्याथ जगाम गरुडध्वजः ।\nध्रुवोपि लिंगं संस्थाप्य वैद्यनाथसमीपतः ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7004072126, "chapter_id": 24072, "verse_number": "४-२१-१२७", "content_sanskrit": "प्रासादं सुमहत्क्रृत्वा कृत्वा कुंडं तदग्रतः ।\nविश्वेश्वरं समभ्यर्च्य कृतकृत्यो गृहं ययौ ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7004072127, "chapter_id": 24072, "verse_number": "४-२१-१२८", "content_sanskrit": "ध्रुवेश्वरं समभ्यर्च्य ध्रुवकुंडे कृतोदकः ।\nध्रुवलोकमवाप्नोति नरो भोगसमन्वितः ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7004072128, "chapter_id": 24072, "verse_number": "४-२१-१२९", "content_sanskrit": "ध्रुवस्य परमाख्यानं यः पठेत्पाठयेदपि ।\nस विष्णुलोकमासाद्य जायते विष्णुवल्लभः ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7004072129, "chapter_id": 24072, "verse_number": "४-२१-१३०", "content_sanskrit": "नरो ध्रुवस्य चरितं प्रसंगेन स्मरन्नपि ।\nन पापैरभिभूयेत महत्पुण्यमवाप्नुयात् ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7004072130, "chapter_id": 24072, "verse_number": "४-२१-१३१", "content_sanskrit": "डति श्रीस्कांदे महापुराण एकाशीतिसाहस्यां संहितायां चतुर्थे काशीखंडे पूर्वार्द्धे ध्रुवस्तुतिर्नामैकविंशतितमोऽध्यायः ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}]