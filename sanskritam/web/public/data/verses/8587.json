[{"id": 900007752, "chapter_id": 8587, "verse_number": "168.1", "content_sanskrit": "ॐ आत्मेति तूपगच्छन्ति ग्राहयन्ति च ॐ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900007753, "chapter_id": 8587, "verse_number": "168.2", "content_sanskrit": "आत्मा ब्रह्म महान्स्तारः परमेशः शुचिश्रवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900007754, "chapter_id": 8587, "verse_number": "168.3", "content_sanskrit": "तस्मादुपास्यो विष्णुरिति ज्ञातव्यः सज्जनैः सदा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900007755, "chapter_id": 8587, "verse_number": "168.4", "content_sanskrit": "आदानार्थत्वतश्चायमात्मशब्दः पतिं वदेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900007756, "chapter_id": 8587, "verse_number": "168.5", "content_sanskrit": "स्वामी मे विष्णुरित्येव नित्यदोपास्यमञ्जसा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900007757, "chapter_id": 8587, "verse_number": "168.6", "content_sanskrit": "स्वामी विष्णुरिति ध्यानं विशेषणविशेष्यतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]