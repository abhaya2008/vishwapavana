[{"id": 2199895, "chapter_id": 5253, "verse_number": "१", "content_sanskrit": "जानन् यो गामपहरेद् विक्रीयाद्वाऽर्थकारणात् ।\nएतद् विज्ञातुमिच्छामि का नु तस्य गतिर्भवेत्\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2199896, "chapter_id": 5253, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2199897, "chapter_id": 5253, "verse_number": "२", "content_sanskrit": "भक्षार्थं विक्रयार्थं वा येऽपहारं हि कुर्वते ।\nदानार्थं वा ब्राह्मणाय तत्रेदं श्रूयतां फलम्\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2199898, "chapter_id": 5253, "verse_number": "३", "content_sanskrit": "विक्रयार्थं हि यो हिंस्याद् भक्षयेद्वा निरङ्कुशः ।\nघातयानं हि पुरुषं येऽनुमन्येयुरर्थिनः\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2199899, "chapter_id": 5253, "verse_number": "४", "content_sanskrit": "घातकः खादको वापि तथा यश्चानुमन्यते ।\nयावन्ति तस्या लोमानि तावद् वर्षाणि मज्जति\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2199900, "chapter_id": 5253, "verse_number": "५", "content_sanskrit": "ये दोषा यादृशाश्चैव द्विजयज्ञोपघातके ।\nविक्रये चापहारे च ते दोषा वै स्मृताः प्रभो\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2199901, "chapter_id": 5253, "verse_number": "६", "content_sanskrit": "अपहृत्य तु यो गां वै ब्राह्मणाय प्रयच्छति ।\nयावद्दाने फलं तस्यास्तावन्निरयमृच्छति\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2199902, "chapter_id": 5253, "verse_number": "७", "content_sanskrit": "सुवर्णं दक्षिणामाहुर्गोप्रदाने महाद्युते ।\nसुवर्णं परमं ह्युक्तं दक्षिणार्थमसंशयम्\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2199903, "chapter_id": 5253, "verse_number": "८", "content_sanskrit": "गोप्रदानं तारयते सप्त पूर्वांस्तथा परान् ।\nसुवर्णं दक्षिणां दत्त्वा तावद् द्विगुणमुच्यते\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2199904, "chapter_id": 5253, "verse_number": "९", "content_sanskrit": "सुवर्णं परमं दानं सुवर्णं दक्षिणा परा ।\nसुवर्णं पावनं शक्र पावनानां परं स्मृतम्\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2199905, "chapter_id": 5253, "verse_number": "१०", "content_sanskrit": "कुलानां पावनं प्राहुर्जातरूपं शतक्रतो ।\nएषा मे दक्षिणा प्रोक्ता समासेन महाद्युते\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2199906, "chapter_id": 5253, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2199907, "chapter_id": 5253, "verse_number": "११", "content_sanskrit": "एतत्पितामहेनोक्तमिन्द्राय भरतर्षभ ।\nइन्द्रो दशरथायाह रामायाह पिता तथा\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2199908, "chapter_id": 5253, "verse_number": "१२", "content_sanskrit": "राघवोऽपि प्रियभ्रात्रे लक्ष्मणाय यशस्विने ।\nऋषिभ्यो लक्ष्मणेनोक्तमरण्ये वसता विभो\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2199909, "chapter_id": 5253, "verse_number": "१३", "content_sanskrit": "पारम्पर्यागतं चेदमृषयः संशितव्रताः ।\nदुर्धरं धारयामासू राजानश्चैव धार्मिकाः ।\nउपाध्यायेन गदितं मम चेदं युधिष्ठिर\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2199910, "chapter_id": 5253, "verse_number": "१४", "content_sanskrit": "य इदं ब्राह्मणो नित्यं वदेद् ब्राह्मणसंसदि ।\nयज्ञेषु गोप्रदानेषु द्वयोरपि समागमे\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2199911, "chapter_id": 5253, "verse_number": "१५", "content_sanskrit": "तस्य लोकाः किलाक्षय्या दैवतैः सह नित्यदा ।\nइति ब्रह्मा स भगवानुवाच परमेश्वरः\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2199912, "chapter_id": 5253, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे ब्रह्मेन्द्रसंवादे गोदानप्रशंसानाम चतुरधिकशततमोऽध्यायः ॥१०४॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]