[{"id": 2029089, "chapter_id": 1635, "verse_number": "३-२७३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2029090, "chapter_id": 1635, "verse_number": "३-२७३-१", "content_sanskrit": "जयद्रथस्तु संप्रेक्ष्यभ्रातरावुद्यतायुधौ।\nप्रादावत्तूर्णमव्यग्रो जीवितेप्सुः सुदुःखितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2029091, "chapter_id": 1635, "verse_number": "३-२७३-२", "content_sanskrit": "`लताभिः संवृते कक्षे किरीटं रत्नभास्वरम्।\nअपविध्यप्रधावन्तं निलीयन्तं वनान्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2029092, "chapter_id": 1635, "verse_number": "३-२७३-३", "content_sanskrit": "भीमसेनस्तु तं कक्षे लीयमानं भयाकुलम्।\nमार्गमाणोऽवतीर्याशु रथाद्रत्नविभूपितात्।\nअभिद्रुत्य निजग्राहकेशपक्षे ह्यमर्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2029093, "chapter_id": 1635, "verse_number": "३-२७३-४", "content_sanskrit": "समुद्यम्य च तं भीमो निष्पिपेप महीतले।\nगले गृहीत्वाराजानं पातयामास चैव ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2029094, "chapter_id": 1635, "verse_number": "३-२७३-५", "content_sanskrit": "पुनः स जीवमानस्य तस्योत्पतितुमिच्छतः।\nपदा मूर्ध्नि महाबाहुः प्राहरद्विलपिष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2029095, "chapter_id": 1635, "verse_number": "३-२७३-६", "content_sanskrit": "तस्य जानू ददौ भमो जघ्ने चैनमरत्निना।\nस मोहमगमद्राजा प्रहारवरपीडितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2029096, "chapter_id": 1635, "verse_number": "३-२७३-७", "content_sanskrit": "सरोषं भीमसेनं तु वारयामास फल्गुनः।\nदुःशलायाः कृतेराजा यत्त्वामाहेति कौरव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2029097, "chapter_id": 1635, "verse_number": "३-२७३-८x", "content_sanskrit": "भीम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2029098, "chapter_id": 1635, "verse_number": "३-२७३-८", "content_sanskrit": "नायं पापसमाचारो मत्तो जीवितुमर्हति।\nकृष्णायास्तदनर्हायाः परिक्लेष्टा नराधमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2029099, "chapter_id": 1635, "verse_number": "३-२७३-९", "content_sanskrit": "किंनु शक्यं मया कर्तुं यद्राजा सततं घृणी।\nत्वं च बालिशया बुद्ध्या सदैवास्मान्प्रबाधसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2029100, "chapter_id": 1635, "verse_number": "३-२७३-१०", "content_sanskrit": "एवमुक्त्वा सटास्तस्य पञ्चचक्रे वृकोदरः।\nअर्धचन्द्रेण वाणेन किंचिदब्रुवतस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2029101, "chapter_id": 1635, "verse_number": "३-२७३-११", "content_sanskrit": "विकल्पयित्वा राजानं ततः प्राह वृकोदरः।\nजीवितुं चेच्छसे मूढ हेतुं मे गदतः शृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2029102, "chapter_id": 1635, "verse_number": "३-२७३-१२", "content_sanskrit": "दासोस्मीति त्वया वाच्यं संसत्सु च सभासु च।\nएवं चेज्जीवितं दद्यामेष युद्धजितो विधिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2029103, "chapter_id": 1635, "verse_number": "३-२७३-१३", "content_sanskrit": "एवमस्त्विति तं राजा कृच्छ्रमाणो जयद्रथः।\nप्रोवाच पुरुषव्याघ्रं भीममाहवशोभिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2029104, "chapter_id": 1635, "verse_number": "३-२७३-१४", "content_sanskrit": "तत एनं विचेष्टन्तं वद्ध्वा पार्थो वृकोदरः।\nरथमारोपयामास विसंज्ञं पांसुकुण्ठितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2029105, "chapter_id": 1635, "verse_number": "३-२७३-१५", "content_sanskrit": "ततस्तं रथमास्थाय भीमः पार्तानुगस्तदा।\nअग्र्यमाश्रममध्यस्थामभ्यगच्छद्युधिष्ठिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2029106, "chapter_id": 1635, "verse_number": "३-२७३-१६", "content_sanskrit": "दर्शयामास भीमस्तु तदवस्थं जयद्रथम्।\nतं राजा प्राहसद्दृष्ट्वा मुच्यतामिति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2029107, "chapter_id": 1635, "verse_number": "३-२७३-१७", "content_sanskrit": "राजानं चाब्रवीद्भीमो द्रौपद्यै कथयेति वै।\nदासभावं गतो ह्येष पाण्डूनां पापचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2029108, "chapter_id": 1635, "verse_number": "३-२७३-१८", "content_sanskrit": "तमुवाच च ततो ज्येष्ठो भ्राता सप्रणयं वचः।\nमुञ्चेममधमाचारं प्रमाणा यदि ते वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2029109, "chapter_id": 1635, "verse_number": "३-२७३-१९", "content_sanskrit": "द्रौपदी चाब्रवीद्भीममभिप्रेक्ष्य युधिष्ठिरम्।\nदासोऽयंमुच्यतां रात्रस्त्वयापञ्चशिखः कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2029110, "chapter_id": 1635, "verse_number": "३-२७३-२०", "content_sanskrit": "`एवमुक्तः स भीमस्तु भ्रात्रा चैव च कृष्णया।\nमुमोच तं महापापं जयद्रथमचेतनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2029111, "chapter_id": 1635, "verse_number": "३-२७३-२१", "content_sanskrit": "स मुक्तोऽभ्येत्यराजानमभिवाद्य युधिष्ठिरम्।\nववन्दे विह्वलोराजातांश्च वृद्धान्मुनींस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2029112, "chapter_id": 1635, "verse_number": "३-२७३-२२", "content_sanskrit": "तमुवाच धृणी राजा धर्मपुत्रो युधिष्ठिरः।\nतथाजयद्रथं दृष्ट्वा गृहीतं सव्यसाचिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2029113, "chapter_id": 1635, "verse_number": "३-२७३-२३", "content_sanskrit": "अदासो गच्छ मुक्तोसि मैवं कार्षीः पुनः क्वचित्।\nस्त्रीकामुक धिगस्तु त्वां क्षुद्रः क्षत्रसहायवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2029114, "chapter_id": 1635, "verse_number": "३-२७३-२४", "content_sanskrit": "एवंविधं हि क कुर्यात्त्वदनयः पुरुषाधमः।\n`कर्म धर्मविरुद्धं वै लोकदुष्टं च दुर्मते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2029115, "chapter_id": 1635, "verse_number": "३-२७३-२५", "content_sanskrit": "गतसत्त्वमिव ज्ञात्वा कर्तारमशुभस्य तम्।\nसंप्रेक्ष्यभरतश्रेष्ठः कृपां चक्रे नराधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2029116, "chapter_id": 1635, "verse_number": "३-२७३-२६", "content_sanskrit": "धर्मे ते वर्धतां वुद्धिर्मा चाधर्मे मनः कृथाः।\nसाश्च साथपादातः स्वस्ति गच्छ जयद्रथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2029117, "chapter_id": 1635, "verse_number": "३-२७३-२७", "content_sanskrit": "एवमुक्तस्तु सव्रीजं तूष्णीं किंचिदवाङ्युखः।\nजगाम राजा दुःखार्तो गङ्गाद्वाराय भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2029118, "chapter_id": 1635, "verse_number": "३-२७३-२८", "content_sanskrit": "स देवं शरणं गत्वा विरूपाक्षमुमापतिम्।\nतपश्चचार विपुलं तस्य प्रीतो वृषध्वजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2029119, "chapter_id": 1635, "verse_number": "३-२७३-२९", "content_sanskrit": "बलिं स्वयं प्रत्यगृह्णात्प्रीयमाणस्त्रिलोचनः।\nवरं चास्मै ददौ देवः स जग्राह च तच्छृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2029120, "chapter_id": 1635, "verse_number": "३-२७३-३०", "content_sanskrit": "समस्तान्सरथान्पञ्चजयेयं युधि पाण्डवान्।\nइति राजाऽब्रवीद्देवं नेति देवस्तमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2029121, "chapter_id": 1635, "verse_number": "३-२७३-३१", "content_sanskrit": "अजय्यांश्चाप्यवध्यांश्च वारयिष्यसि तान्युधि।\nऋतेऽर्जुनं महाबाहुं नरं नाम सुरेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2029122, "chapter_id": 1635, "verse_number": "३-२७३-३२", "content_sanskrit": "बदर्यां तप्ततपसं नारायणसहायकम्।\nअजितं सर्वलोकानां देवैरपि दुरासदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2029123, "chapter_id": 1635, "verse_number": "३-२७३-३३", "content_sanskrit": "मया दत्तं पाशुपतं दिव्यमप्रतिमं शरम्।\nअवाप लोकपालेभ्यो वज्रादीन्स महाशरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2029124, "chapter_id": 1635, "verse_number": "३-२७३-३४", "content_sanskrit": "देवदेवो ह्यनन्तात्मा विष्णुः सुरगुरुः प्रभुः।\nप्रधानपुरुषोऽव्यक्तोविश्वात्माविश्वमूर्तिमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2029125, "chapter_id": 1635, "verse_number": "३-२७३-३५", "content_sanskrit": "युगान्तकाले संप्राप्ते कालाग्निर्दहते जगत्।\nसपर्वतार्णवद्वीपं सशैलवनकाननम्।\nनिर्दहन्नागलोकांश्चपातालतलचारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2029126, "chapter_id": 1635, "verse_number": "३-२७३-३६", "content_sanskrit": "अथान्तरिक्षे सुमहन्नानावर्णाः पयोधराः।\nघोरस्वरा विनदिनस्तटिन्मालावलम्बिनः।\nसमुत्तिष्ठन्दिशः सर्वाविवर्षन्तः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2029127, "chapter_id": 1635, "verse_number": "३-२७३-३७", "content_sanskrit": "ततोऽग्नीं शमयामासुः संवर्ताग्निनियामकाः।\nअक्षमात्रैश्च धाराभिस्तिष्ठन्त्यापूर्य सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2029128, "chapter_id": 1635, "verse_number": "३-२७३-३८", "content_sanskrit": "एकार्णवे तदातस्मिन्नुपशान्तचराचरे।\nनष्टचन्द्रार्कपवने ग्रहनक्षत्रवर्जिते।\nचतुर्युगसहस्रान्ते सलिलेनाप्लुता मही ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2029129, "chapter_id": 1635, "verse_number": "३-२७३-३९", "content_sanskrit": "ततो नारायणाख्यस्तु सहस्राक्षः सहस्रपात्।\nसहस्रशीर्पा पुरुषः स्वप्नुकामस्त्वतीन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2029130, "chapter_id": 1635, "verse_number": "३-२७३-४०", "content_sanskrit": "फणासहस्रविकटं शेषं पर्यङ्कभोगिनम्।\nसहस्रमिव तिग्मांशुसंघातममितद्युतिम्।\nकुन्देन्दुहारगोक्षीरमृणालकुमुदप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2029131, "chapter_id": 1635, "verse_number": "३-२७३-४१", "content_sanskrit": "तत्रासौ भगवान्देवः स्वपञ्जलनिधौ तदा।\nनैशेन तमसा व्याप्तां स्वां रात्रिंकुरुते विभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2029132, "chapter_id": 1635, "verse_number": "३-२७३-४२", "content_sanskrit": "सत्वोद्रेकात्प्रबुद्धस्तु शून्यं लोकमपश्यत।\nइमं चोदाहरन्त्यत्रश्लोकं नारायणं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2029133, "chapter_id": 1635, "verse_number": "३-२७३-४३", "content_sanskrit": "आपो नारास्तत्तनव इत्यपां नाम शुश्रुमः।\nअयनं तेन चैवास्ते तेन नारायणः स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2029134, "chapter_id": 1635, "verse_number": "३-२७३-४४", "content_sanskrit": "प्रध्यानसमकालं तुप्रजाहेतोः सनातनः।\nध्यातमात्रे तु भगवन्नाभ्यां पद्मः समुत्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2029135, "chapter_id": 1635, "verse_number": "३-२७३-४५", "content_sanskrit": "ततश्चतुर्मुखो ब्रह्मा नाभिपद्माद्विनिःसृतः।\nतत्रोपविष्टः सहसा ब्रह्मा लोकपितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2029136, "chapter_id": 1635, "verse_number": "३-२७३-४६", "content_sanskrit": "शून्यं दृष्ट्वा जगत्कृत्स्नं मानसानात्मनः समान्।\nततो मरीचिप्रमुखान्महर्षीनसृजन्नव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2029137, "chapter_id": 1635, "verse_number": "३-२७३-४७", "content_sanskrit": "तेऽसृजन्सर्वभूतानि त्रसानि स्थावराणि च।\nयक्षराक्षसभूतानि पिशाचोरगमानुषान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2029138, "chapter_id": 1635, "verse_number": "३-२७३-४८", "content_sanskrit": "सृजते ब्रह्ममूर्तिस्तु रक्षते पौरुषी तनुः।\nरौद्री भावेन शमयेत्तिस्रोऽवस्थाः प्रजापतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2029139, "chapter_id": 1635, "verse_number": "३-२७३-४९", "content_sanskrit": "न श्रुतं ते सिन्धुपते विष्णोरद्भुतकर्मणः।\nकथ्यमानानि मुनिभिर्ब्राह्मणैर्वेदपारगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2029140, "chapter_id": 1635, "verse_number": "३-२७३-५०", "content_sanskrit": "जलेन समनुप्राप्ते सर्वतः पृथिवीतले।\nतदा चैकार्णवे तस्मिननेकाकाशे प्रभुश्चरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2029141, "chapter_id": 1635, "verse_number": "३-२७३-५१", "content_sanskrit": "निशायामिव खद्योतः प्रावृट्काले समन्ततः।\nप्रतिष्ठानाय पृथिवीं मार्गमाणस्तदाऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2029142, "chapter_id": 1635, "verse_number": "३-२७३-५२", "content_sanskrit": "जले निमग्नां गां दृष्ट्वाचोद्धर्तुं मनसेच्छति।\nकिंनु रूपमहं कृत्वासलिलादुद्धरे महीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2029143, "chapter_id": 1635, "verse_number": "३-२७३-५३", "content_sanskrit": "एवं संचिन्त्य मनसा दृष्ट्वा दिव्येन चक्षुषा।\nजलक्रीडाभिरुचितं वाराहं रूपमस्मरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2029144, "chapter_id": 1635, "verse_number": "३-२७३-५४", "content_sanskrit": "कृत्वा वराहवपुपं वाङ्मयं वेदसंमितम्।\nदशयोजनविस्तीर्णमायतं शतयोजनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2029145, "chapter_id": 1635, "verse_number": "३-२७३-५५", "content_sanskrit": "महापर्वतवर्ष्माभं तीक्ष्णदंष्ट्रंप्रदीप्तिमत्।\nमहामेघौघनिर्घोपं नीलजीमूतसन्निभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2029146, "chapter_id": 1635, "verse_number": "३-२७३-५६", "content_sanskrit": "भूत्वा यज्ञवराहो वै अपः संप्राविशत्प्रभुः।\nदंष्ट्रेणैकेन चोद्धृत्यस्वे स्थाने न्यविशन्महीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2029147, "chapter_id": 1635, "verse_number": "३-२७३-५७", "content_sanskrit": "पुनरेव महाबाहुरपूर्वां तनुमाश्रितः।\nनरस्य कृत्वाऽर्धतनुं सिंहस्यार्धतनुं प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2029148, "chapter_id": 1635, "verse_number": "३-२७३-५८", "content_sanskrit": "दैत्येन्द्रस्य सभां गत्वापाणिं संस्पृश्यपाणिना।\nदैत्यानामादिपुरुषः सुरारिर्दितिनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2029149, "chapter_id": 1635, "verse_number": "३-२७३-५९", "content_sanskrit": "दृष्ट्वा चापूर्ववपुषं क्रोधात्संरक्तलोचनः।\nशूलोद्यतकरः स्रग्वी हिरण्यकशिपुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2029150, "chapter_id": 1635, "verse_number": "३-२७३-६०", "content_sanskrit": "मेघस्तनितनिर्घोषो नीलाभ्रचयसन्निभः।\nदेवारिर्दितिजो वीरो नृसिंहं समुपाद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2029151, "chapter_id": 1635, "verse_number": "३-२७३-६१", "content_sanskrit": "समुत्पत्य ततस्तीक्ष्णैर्मृगेन्द्रेण बलीयसा।\nनारसिंहेन वपुषादारितः करजैर्भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2029152, "chapter_id": 1635, "verse_number": "३-२७३-६२", "content_sanskrit": "एवं निहत्य भगवान्दैत्येनद्रं रिपुघातिनम्।\nभूयोऽन्यः पुण्डरीकाक्षः प्रभुर्लोकहिताय च।\nकश्यपस्यात्मजः श्रीमानदित्या गर्भधारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2029153, "chapter_id": 1635, "verse_number": "३-२७३-६३", "content_sanskrit": "पूर्णे वर्षसहस्रे तु प्रसूत भर्गमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2029154, "chapter_id": 1635, "verse_number": "३-२७३-६४", "content_sanskrit": "दुर्दिनाम्भोदसदृशो दीप्ताक्षो वामनाकृतिः।\nदण्डी कमण्डलुधरः श्रीवत्सोरसि भूषितः।\nजटी यज्ञोपवीती च भगवान्बालरूपधृक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2029155, "chapter_id": 1635, "verse_number": "३-२७३-६५", "content_sanskrit": "यज्ञवाटं गतः श्रीमान्दानवेन्द्रस्य वै तदा।\nबृहस्पतिसहायोऽसौ प्रविष्टो बलिनो मखे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2029156, "chapter_id": 1635, "verse_number": "३-२७३-६६", "content_sanskrit": "तं दृष्ट्वावामनतनुं प्रहृष्टो बलिरब्रवीत्।\nप्रीतोस्मि दर्शने विप्र ब्रूहि त्वं किं ददानिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2029157, "chapter_id": 1635, "verse_number": "३-२७३-६७", "content_sanskrit": "एवमुक्तस्तु बलिना वामनः प्रत्युवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2029158, "chapter_id": 1635, "verse_number": "३-२७३-६८", "content_sanskrit": "स्वस्तीत्युक्त्वा बलिं देवः स्मयमानोऽभ्यभाषत।\nमेदिनीं दानवपते देहि मे विक्रमत्रयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2029159, "chapter_id": 1635, "verse_number": "३-२७३-६९", "content_sanskrit": "बलिर्ददौ प्रसन्नात्मा विप्रायामिततेजसे।\nततो दिव्याद्भुततमं रूपं विक्रमतोहरेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2029160, "chapter_id": 1635, "verse_number": "३-२७३-७०", "content_sanskrit": "विक्रमैस्त्रिभिरक्षोभ्यो जहाराशु स मेदिनीम्।\nददौ शक्राय च महीं विष्णुर्देवः सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2029161, "chapter_id": 1635, "verse_number": "३-२७३-७१", "content_sanskrit": "एष ते वामनो नाम प्रादुर्भावः प्रकीर्तितः।\nतेन देवाः प्रादुरासन्वैष्णवं चोच्यते जगत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2029162, "chapter_id": 1635, "verse_number": "३-२७३-७२", "content_sanskrit": "असतां निग्रहार्थाय धर्मसंरक्षणाय च।\nअवतीर्णो मनुष्याणामजायत यदुक्षये।\nयं देवंविदुषोगान्ति तस्य कर्माणि सैन्दव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2029163, "chapter_id": 1635, "verse_number": "३-२७३-७३", "content_sanskrit": "अनाद्यन्तमजं देवं प्रभुंलोकनमस्कृतम्।\nयं देवं विदुषोगान्तितस् कर्माणि सैन्धव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2029164, "chapter_id": 1635, "verse_number": "३-२७३-७४", "content_sanskrit": "यमाहुरजितंकृष्णं शङ्खचक्रगदाधरम्।\nश्रीवत्सधारिणं देवं पीतकौशेयवाससम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2029165, "chapter_id": 1635, "verse_number": "३-२७३-७५", "content_sanskrit": "प्रधानं सोऽस्त्रविदुषां तेन कृष्णन रक्ष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2029166, "chapter_id": 1635, "verse_number": "३-२७३-७६", "content_sanskrit": "सहायः पुण्डरीकाक्षः श्रीमानतुलविक्रमः।\nसमानस्यन्दने पार्थमास्थाय परवीरहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2029167, "chapter_id": 1635, "verse_number": "३-२७३-७७", "content_sanskrit": "न शक्यते तेन जेतुं त्रिदशैरपि दुःसहः।\nकः पुनर्मानुषो भावो रणे पार्थं विजेष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2029168, "chapter_id": 1635, "verse_number": "३-२७३-७८", "content_sanskrit": "तमेकं वर्जयित्वातु सर्वंयौधिष्ठिरं बलम्।\nचतुरः पाण्डवात्राजन्दिनैकं जेप्यसे रिपून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2029169, "chapter_id": 1635, "verse_number": "३-२७३-७९", "content_sanskrit": "`तस्मात्त्वंपार्थरहितान्पाण्डवान्वारयिष्यसि।\nएतद्धि पुरुषव्याघ्र मया दत्तो वरस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2029170, "chapter_id": 1635, "verse_number": "३-२७३-८०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2029171, "chapter_id": 1635, "verse_number": "३-२७३-८०", "content_sanskrit": "इत्येवमुक्त्वा नृपतिं सर्वपापहरो हरः।\nउमापतिः पशुपतिर्यज्ञहा त्रिपुरार्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2029172, "chapter_id": 1635, "verse_number": "३-२७३-८१", "content_sanskrit": "वामनैर्विकटैः कुब्जैरुग्रश्रवणदर्शनैः।\nवृतः पारिषदैर्घोरैर्नानाप्रहरणोद्यतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2029173, "chapter_id": 1635, "verse_number": "३-२७३-८२", "content_sanskrit": "त्र्यम्बको राजशार्दूल भगनेत्रनिपातनः।\nउमासहायो भगवांस्तत्रैवान्तरधीयत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2029174, "chapter_id": 1635, "verse_number": "३-२७३-८३", "content_sanskrit": "एवमुक्तस्तु नृपतिः स्वमेव भवनं ययौ।\nपाण्डवाश्च वने तस्मिन्न्यवसन्काम्यके तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2029175, "chapter_id": 1635, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि यजद्रथविमोक्षणपर्वणि त्रिसप्तत्यधिकद्विशततमोऽध्यायः ॥ २७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}]