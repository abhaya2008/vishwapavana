[{"id": 2018162, "chapter_id": 1375, "verse_number": "३-१३-०x", "content_sanskrit": "वासदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2018163, "chapter_id": 1375, "verse_number": "३-१३-१", "content_sanskrit": "नैतत्कृच्छ्रमनुप्राप्तो भवान्स्याद्वसुधाधिप।\nयद्यहं द्वारकायां स्यां राजन्सन्निहितः पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2018164, "chapter_id": 1375, "verse_number": "३-१३-२", "content_sanskrit": "आगच्छेयमहं द्यूतमनाहूतोऽपि कौरवैः।\nआम्बिकेयेन दुर्धर्ष राज्ञा दुर्योधनेन च।\nवारयेयमहं द्यूतं बहून्दोपान्प्रदर्शयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2018165, "chapter_id": 1375, "verse_number": "३-१३-३", "content_sanskrit": "भीष्मद्रोणौ समानाय्य कृपं बाह्लीकमेव च।\nवैचित्रवीर्यं राजानमलं द्यूतेन कौरव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2018166, "chapter_id": 1375, "verse_number": "३-१३-४", "content_sanskrit": "पुत्राणां तव राजेन्द्र त्वन्निमित्तमिति प्रभो।\nतत्राचक्षमहं दोषान्यैर्भवान्व्यतिरोपितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2018167, "chapter_id": 1375, "verse_number": "३-१३-५", "content_sanskrit": "वीरसेनसुतो यैस्तु राज्यात्प्रभ्रंशितः पुरा।\nअतर्कितविनाशश्च देवनेन विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2018168, "chapter_id": 1375, "verse_number": "३-१३-६", "content_sanskrit": "सातत्यं च प्रसङ्गस्य वर्णयेयं यथातथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2018169, "chapter_id": 1375, "verse_number": "३-१३-७", "content_sanskrit": "स्त्रियोऽक्षा मृगया पानमेतत्कामसमुत्थितम्।\nदुःखं चतुष्टय प्रोक्तं यैर्नरो भ्रश्यते श्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2018170, "chapter_id": 1375, "verse_number": "३-१३-८", "content_sanskrit": "तत्रसर्वत्रवक्तव्यं मन्यन्ते शास्त्रकोविदाः।\nविशेषतश्च वक्तव्यं द्यूते पश्यन्ति तद्विदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2018171, "chapter_id": 1375, "verse_number": "३-१३-९", "content_sanskrit": "एकाहाद्द्रव्यनाशोऽत्र ध्रुवं व्यसनमेव च।\nअभुक्तनाशश्चार्थानां वाक्पारुष्यं च केवलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2018172, "chapter_id": 1375, "verse_number": "३-१३-१०", "content_sanskrit": "एतच्चान्यच्च कौरव्य प्रसङ्गिकटुकोदयम्।\nद्यूते ब्रूयां महाबाहो समासाद्याम्बिकासुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2018173, "chapter_id": 1375, "verse_number": "३-१३-११", "content_sanskrit": "एवमुक्तो यदि मया गृह्णीयाद्वचनं मम।\nअनामयं स्याद्धर्मश्च कुरूणां कुरुवर्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2018174, "chapter_id": 1375, "verse_number": "३-१३-१२", "content_sanskrit": "न चेत्स मम राजेन्द्र गृह्णीयान्मधुरं वचः।\nपथ्यं च भरतश्रेष्ठ निगृह्णीयां बलेन तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2018175, "chapter_id": 1375, "verse_number": "३-१३-१३", "content_sanskrit": "अथैनमविनीतेन सुहृदो नाम दुर्हृदः।\nसभासदोऽनुवर्तेरंस्तांश्च इन्यां दुरोदरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2018176, "chapter_id": 1375, "verse_number": "३-१३-१४", "content_sanskrit": "असान्निध्यं तु कौरव्य ममानर्तेष्वभूत्तदा।\nयेनेदं व्यसनं प्राज्ञा भवन्तो द्यूतकारितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2018177, "chapter_id": 1375, "verse_number": "३-१३-१५", "content_sanskrit": "सोहमेत्य कुरुश्रेष्ठ द्वारकां पाण्डुनन्दन।\nअश्रौषं त्वां व्यसनिनं युयुधानाद्यथातथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2018178, "chapter_id": 1375, "verse_number": "३-१३-१६", "content_sanskrit": "श्रुत्वैव चाहं राजेन्द्र परमोद्विग्रमानसः।\nतूर्णमभ्यागतोस्मित्वां द्रष्टुकामो विशंपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2018179, "chapter_id": 1375, "verse_number": "३-१३-१७", "content_sanskrit": "अहो कृच्छ्रमनुप्राप्ताः सर्वे स्म भरतर्षभ।\nसोऽहं त्वां व्यसने मग्नं पश्यामि सह सोदरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2018180, "chapter_id": 1375, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणइ अर्जुनाभिगमनपर्वणि त्रयोदशोऽध्यायः ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]