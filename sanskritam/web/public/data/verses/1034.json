[{"id": 2001825, "chapter_id": 1034, "verse_number": "१-३५-०x", "content_sanskrit": "शौनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001826, "chapter_id": 1034, "verse_number": "१-३५-१", "content_sanskrit": "भुजङ्गमानां शापस्य मात्रा चैव सुतेन च।\nविनतायास्त्वया प्रोक्तं कारणं सूतनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001827, "chapter_id": 1034, "verse_number": "१-३५-२", "content_sanskrit": "वरप्रदानं भर्त्रा च कद्रूविनतयोस्तथा।\nनामनी चैव ते प्रोक्ते पक्षिणोर्वैनतेययोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001828, "chapter_id": 1034, "verse_number": "१-३५-३", "content_sanskrit": "पन्नगानां तु नामानि न कीतर्यसि सूतज।\nप्राधान्येनापि नामानि श्रोतुमिच्छामहे वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001829, "chapter_id": 1034, "verse_number": "१-३५-४x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001830, "chapter_id": 1034, "verse_number": "१-३५-४", "content_sanskrit": "बहुत्वान्नामधेयानि पन्नगानां तपोधन।\nन कीर्तयिष्ये सर्वेषां प्राधान्येन तु मे शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001831, "chapter_id": 1034, "verse_number": "१-३५-५", "content_sanskrit": "शेषः प्रथमतो जातो वासुकिस्तदनन्तरम्।\nऐरावतस्तक्षकश्च कर्कोटकधनञ्जयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001832, "chapter_id": 1034, "verse_number": "१-३५-६", "content_sanskrit": "कालियो मणिनागश्च नागश्चापूरणस्तथा।\nनागस्तथा पिञ्जरक एलापत्रोऽथ वामनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001833, "chapter_id": 1034, "verse_number": "१-३५-७", "content_sanskrit": "नीलानीलौ तथा नागौ कल्माषशबलौ तथा।\nआर्यकश्चोग्रकश्चैव नागः कलशपोतकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001834, "chapter_id": 1034, "verse_number": "१-३५-८", "content_sanskrit": "सुमनाख्यो दधिमुखस्तथा विमलपिण्डकः।\nआप्तः कोटरकश्चैव शङ्खो वालिशिखस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001835, "chapter_id": 1034, "verse_number": "१-३५-९", "content_sanskrit": "निष्टानको हेमगुहो नहुषः पिङ्गलस्तथा।\nबाह्यकर्णो हस्तिपदस्तथा मुद्गरपिण्डकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001836, "chapter_id": 1034, "verse_number": "१-३५-१०", "content_sanskrit": "कम्बलाश्वतरौ चापि नागः कालीयकस्तथा।\nवृत्तसंवर्तकौ नागौ द्वौ च पद्माविति श्रुतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001837, "chapter_id": 1034, "verse_number": "१-३५-११", "content_sanskrit": "नागः शङ्खमुखश्चैव तथा कूष्माण्डकोऽपरः।\nक्षेमकश्च तथा नागो नागः पिण्डारकस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2001838, "chapter_id": 1034, "verse_number": "१-३५-१२", "content_sanskrit": "करवीरः पुष्पदंष्ट्रो बिल्वको बिल्वपाण्डुरः।\nमूषकादः शङ्खशिराः पूर्णभद्रो हरिद्रकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2001839, "chapter_id": 1034, "verse_number": "१-३५-१३", "content_sanskrit": "अपराजितो ज्योतिकश्च पन्नगः श्रीवहस्तथा।\nकौरव्यो धृतराष्ट्रश्च शङ्खपिण्डश्च वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2001840, "chapter_id": 1034, "verse_number": "१-३५-१४", "content_sanskrit": "विरजाश्च सुबाहुश्च शालिपिण्डश्च वीर्यवान्।\nहस्तिपिण्डः पिठरकः सुमुखः कौणपाशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2001841, "chapter_id": 1034, "verse_number": "१-३५-१५", "content_sanskrit": "कुठऱः कुञ्जरश्चैव तथा नागः प्रभाकरः।\nकुमुदः कुमुदाक्षश्च तित्तिरिर्हलिकस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2001842, "chapter_id": 1034, "verse_number": "१-३५-१६", "content_sanskrit": "कर्दमश्च महानागो नागश्च बहुमूलकः।\nकर्कराकर्करौ नागौ कुण्डोदरमहोदरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2001843, "chapter_id": 1034, "verse_number": "१-३५-१७", "content_sanskrit": "एते प्राधान्यतो नागाः कीर्तिता द्विजसत्तम।\nबहुत्वान्नामधेयानामितरे नानुकीर्तिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2001844, "chapter_id": 1034, "verse_number": "१-३५-१८", "content_sanskrit": "एतेषां प्रसवो यश्च प्रसवस्य च संततिः।\nअसङ्ख्येयेति मत्त्वा तान्न ब्रवीमि तपोधन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2001845, "chapter_id": 1034, "verse_number": "१-३५-१९", "content_sanskrit": "बहूनीह सहस्राणि प्रयुतान्यर्बुदानि च।\nअशक्यान्येव सङ्ख्यातुं पन्नगानां तपोधन॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2001846, "chapter_id": 1034, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि पञ्चत्रिंशोऽध्यायः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]