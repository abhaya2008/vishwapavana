[{"id": 2063956, "chapter_id": 2360, "verse_number": "८-८१-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2063957, "chapter_id": 2360, "verse_number": "८-८१-१", "content_sanskrit": "श्रुत्वा तु रथनिर्घोषं सिंहनादं च संयुगे।\nअर्जुनः प्राह गोविन्दं शीघ्रं वाहय वाजिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2063958, "chapter_id": 2360, "verse_number": "८-८१-२", "content_sanskrit": "अर्जुनस्य वचः श्रुत्वा गोविन्दोऽर्जुनमब्रवीत्।\nएष गच्छामि सुक्षिप्रं यत्र भीमो व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2063959, "chapter_id": 2360, "verse_number": "८-८१-३", "content_sanskrit": "तं यान्तमश्वा हिमशङ्खवर्णाः\nसुवर्णमुक्तामणिजालनद्धाः।\nजम्भं जिघांसुं प्रगृहीतवज्रं\nहया यथा तत्र यथा वहंस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2063960, "chapter_id": 2360, "verse_number": "८-८१-४", "content_sanskrit": "रथाश्वमातङ्गपदातिसङ्घा\nबाणस्वनैर्नेमिखुरस्वनैश्च।\nसन्नादयन्तो वसुधां दिशश्च\nक्रुद्धा नृसिंहा जयमभ्युदीयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2063961, "chapter_id": 2360, "verse_number": "८-८१-५", "content_sanskrit": "तेषां च पार्थस्य च मारिषासी--\nद्देहासुपापक्षपणं सुयुद्धम्।\nत्रैलोक्यहेतोरसुरैर्यथासी--\nद्देवस्य विष्णोर्जयतां वरस्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2063962, "chapter_id": 2360, "verse_number": "८-८१-६", "content_sanskrit": "तैरस्तमुच्चावचमायुधं त--\nदेकः प्रचिच्छेद किरीटमाली।\nक्षुरार्धचन्द्रैर्निशितैश्च भल्लैः\nशिरांसि तेषां बहुधा च बाहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2063963, "chapter_id": 2360, "verse_number": "८-८१-७", "content_sanskrit": "छत्राणि वालव्यजनानि केतू--\nनश्वान्रथान्पत्तिगणान्द्विपांश्च।\nते पेतुरुर्व्यां बहुधा विकृत्ता\nवातप्रणुन्नानि यथा वनानि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2063964, "chapter_id": 2360, "verse_number": "८-८१-८", "content_sanskrit": "सुवर्णजालावनता महागजाः\nसवैजयन्तीध्वजयोधकल्पिताः।\nसुवर्णपुङ्घैरिषुभिः समाचिता--\nशकाशिरे प्रज्वलिता यथाचलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2063965, "chapter_id": 2360, "verse_number": "८-८१-९", "content_sanskrit": "विदार्य नागाश्वरथान्धञ्जयः\nशरोत्तमैर्वासववज्रसन्निभैः।\nद्रुतं ययौ कर्णजिघांसया तथा\nयथा मरुत्वान्बलभेदने पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2063966, "chapter_id": 2360, "verse_number": "८-८१-१०", "content_sanskrit": "ततः स पुरुषव्याघ्रस्तव सैन्यमरिन्दमः।\nप्रविवेश महाबाहुर्मकरः सागरं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2063967, "chapter_id": 2360, "verse_number": "८-८१-११", "content_sanskrit": "तं हृष्टास्तावका राजन्रथपत्तिसमन्विताः।\nगजाश्वसादिबहुलाः पाण्डवं समुपाद्रवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2063968, "chapter_id": 2360, "verse_number": "८-८१-१२", "content_sanskrit": "तेषामापततां पार्थमारावः सुमहानभूत्।\nसागरस्येव क्षुब्धस्य यथा स्यात्सलिलस्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2063969, "chapter_id": 2360, "verse_number": "८-८१-१३", "content_sanskrit": "ते तु तं पुरुषव्याघ्रं व्याघ्रा इव महारथाः।\nअभ्यद्रवन्त सङ्ग्रामे त्यक्त्वा प्राणकृतं भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2063970, "chapter_id": 2360, "verse_number": "८-८१-१४", "content_sanskrit": "तेषामापततां तत्र शरवर्षाणि मुञ्चताम्।\nअर्जुनो व्यधमत्सैन्यं महावातो घनानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2063971, "chapter_id": 2360, "verse_number": "८-८१-१५", "content_sanskrit": "तेऽर्जुनं सहिता भूत्वा रथवंशैः ग्रहारिणः।\nअभियाय महेष्वासा विव्यधुर्निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2063972, "chapter_id": 2360, "verse_number": "८-८१-१६", "content_sanskrit": "ततोऽर्जुनः सहस्राणि रथवारणवाजिनाम्।\nप्रेषयामास विशिखैर्यमस्य सदनं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2063973, "chapter_id": 2360, "verse_number": "८-८१-१७", "content_sanskrit": "ते वध्यमानाः समरे पार्थचापच्युतैः शरैः।\nतत्रतत्र स्म लीयन्ते भये जाते महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2063974, "chapter_id": 2360, "verse_number": "८-८१-१८", "content_sanskrit": "तेषां चतुःशतान्वीरान्यतमानान्महारथान्।\nअर्जुनो निशितैर्बाणैरनयद्यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2063975, "chapter_id": 2360, "verse_number": "८-८१-१९", "content_sanskrit": "ते वध्यमानाः समरे नानालिङ्गैः शितैः शरैः।\nअर्जुनं समभित्यज्य दुद्रुवुर्वै दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2063976, "chapter_id": 2360, "verse_number": "८-८१-२०", "content_sanskrit": "तेषां शब्दो महानासीद्द्रवतां वाहिनीमुखे।\nमेघौघस्येव भद्रं ते गिरिमासाद्य दीर्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2063977, "chapter_id": 2360, "verse_number": "८-८१-२१", "content_sanskrit": "तां तु सेनां भृशं विद्ध्वा द्रावयित्वाऽर्जुनः शरैः।\nप्रायादभिमुखः पार्थः सूतानीकं हि मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2063978, "chapter_id": 2360, "verse_number": "८-८१-२२", "content_sanskrit": "तस्य शब्दो महानासीत्परानभिमुखस्य वै।\nगरुडस्येव पततः पन्नगार्थे यथा पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2063979, "chapter_id": 2360, "verse_number": "८-८१-२३", "content_sanskrit": "तं तु शब्दमभिश्रुत्य भीमसेनो महाबलः।\nबभूव परमप्रीतः पार्थदर्शनलालसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2063980, "chapter_id": 2360, "verse_number": "८-८१-२४", "content_sanskrit": "श्रुत्वैव पार्थमायान्तं भीमसेनः प्रतापवान्।\nत्यक्त्वा प्राणान्महाराज सेनां तव ममर्द ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2063981, "chapter_id": 2360, "verse_number": "८-८१-२५", "content_sanskrit": "स वायुवीर्यप्रतिमो वायुवेगसमो जवे।\nवायुवद्व्यचरद्भीमो वायुपुत्रः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2063982, "chapter_id": 2360, "verse_number": "८-८१-२६", "content_sanskrit": "तेनाद्यमाना राजेन्द्र सेना तव विशाम्पते।\nव्यभ्रश्यत महाराज भिन्ना नौरिव सागरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2063983, "chapter_id": 2360, "verse_number": "८-८१-२७", "content_sanskrit": "तां तु सेनां तदा भीमो दर्शयन्पाणिलाघवम्।\nशरैरवचकर्तोग्रैः प्रेपयिष्यन्यमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2063984, "chapter_id": 2360, "verse_number": "८-८१-२८", "content_sanskrit": "तत्र भारत भीमस्य बलं दृष्ट्वातिमानुषम्।\nव्यत्रस्यन्त रणे योधाः कालस्येव युगक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2063985, "chapter_id": 2360, "verse_number": "८-८१-२९", "content_sanskrit": "तथाऽर्दितान्भीमबलान्भीमसेनेन भारत।\nदृष्ट्वा दुर्योधनो राजा इदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2063986, "chapter_id": 2360, "verse_number": "८-८१-३०", "content_sanskrit": "सैनिकांश्च महेष्वासान्योधांश्च भरतर्षभ।\nसमादिशन्रणे सर्वान्हत भीममिति स्म ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2063987, "chapter_id": 2360, "verse_number": "८-८१-३१", "content_sanskrit": "तस्मिन्हते हतं मन्ये पाण्डुसैन्यमशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2063988, "chapter_id": 2360, "verse_number": "८-८१-३२", "content_sanskrit": "प्रतिगृह्य च तामाज्ञां तव पुत्रस्य पार्थिवाः।\nभीमं प्रच्छादयामासुः शरवर्षैः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2063989, "chapter_id": 2360, "verse_number": "८-८१-३३", "content_sanskrit": "गजाश्च बहुला राजन्नराश्च जयगृद्धिनः।\nरथे स्थिताश्च राजेन्द्र परिवव्रुर्वृकोदरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2063990, "chapter_id": 2360, "verse_number": "८-८१-३४", "content_sanskrit": "स तैः परिवृतः शूरैः शूरो राजन्समन्ततः।\nशुशुभे भरतश्रेष्ठो नक्षत्रैरिव चन्द्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2063991, "chapter_id": 2360, "verse_number": "८-८१-३५", "content_sanskrit": "परिवेषी यथा सोमः परिपूर्णो विराजते।\nस रराज तथा सङ्ख्ये दर्शनीयो नरोत्तमः।\nनिर्विशेषो महाराज विजयेनैव संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2063992, "chapter_id": 2360, "verse_number": "८-८१-३६", "content_sanskrit": "तस्य ते पार्थिवाः सर्वे शरवृष्टिं समासृजन्।\nक्रोधरक्तेक्षणाः शूरा हन्तुकामा वृकोदरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2063993, "chapter_id": 2360, "verse_number": "८-८१-३७", "content_sanskrit": "तां विदार्य महासेनां शरैः सन्नतपर्वभिः।\nनिश्चक्राम रणाद्भीमो मत्स्यो जालादिवाम्भसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2063994, "chapter_id": 2360, "verse_number": "८-८१-३८", "content_sanskrit": "हत्वा दशसहस्राणि गजानामनिवर्तिनाम्।\nनृणां शतसहस्रे द्वे द्वे शते चैव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2063995, "chapter_id": 2360, "verse_number": "८-८१-३९", "content_sanskrit": "पञ्च चाश्वसहस्राणि रथानां शतमेव च।\nहत्वा प्रास्यन्दयद्भीमो नदीं शोणितवाहिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2063996, "chapter_id": 2360, "verse_number": "८-८१-४०", "content_sanskrit": "शोणितोदां रथावर्तां हस्तिग्राहसमाकुलाम्।\nनरमीनाश्वनक्रान्तां केशशैवलशाद्वलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2063997, "chapter_id": 2360, "verse_number": "८-८१-४१", "content_sanskrit": "सञ्छिन्नभुजनागेन्द्रां बहुरत्नापहारिणीम्।\nऊरुग्राहां मज्जपङ्कां शीर्षोपलसमावृताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2063998, "chapter_id": 2360, "verse_number": "८-८१-४२", "content_sanskrit": "धनुःकाशां शरावापां गदापरिघकेतनाम्।\nहंसछत्रध्वजोपेतामुष्णीषवरफेनिलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2063999, "chapter_id": 2360, "verse_number": "८-८१-४३", "content_sanskrit": "हारपद्माकरां चैव भूमिरेणूर्मिमालिनीम्।\nआर्यवृत्तवतीं सङ्ख्ये सुतरां भीरुदुस्तराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2064000, "chapter_id": 2360, "verse_number": "८-८१-४४", "content_sanskrit": "योधग्राहवतीं सङ्ख्ये वहन्तीं पितृसादनम्।\nक्षणेन पुरुषव्याघ्रः प्रावर्तयत निम्नगाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2064001, "chapter_id": 2360, "verse_number": "८-८१-४५", "content_sanskrit": "यथा वैतरणीमुग्रां दुस्तरामकृतात्मभिः।\nतथा दुस्तरणीं घोरां भीरूणां भयवर्धनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2064002, "chapter_id": 2360, "verse_number": "८-८१-४६", "content_sanskrit": "यतोयतः पाण्डवेयः प्रविष्टो रथसत्तमः।\nततस्ततः प्रापतन्वै योधाः शतसहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2064003, "chapter_id": 2360, "verse_number": "८-८१-४७", "content_sanskrit": "एवं दृष्ट्वा कृतं कर्म भीमसेनेन संयुगे।\nदुर्योधनो महाराज शकुनिं वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2064004, "chapter_id": 2360, "verse_number": "८-८१-४८", "content_sanskrit": "जहि मातुल सङ्ग्रामे भीमसेनं महाबलम्।\nअस्मिञ्जिते जितं मन्ये पाण्डवेयं महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2064005, "chapter_id": 2360, "verse_number": "८-८१-४९", "content_sanskrit": "ततः प्रायान्महाराज सौबलेयः प्रतापवान्।\nरणाय महते युक्तो भ्रातृभिः परिवारितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2064006, "chapter_id": 2360, "verse_number": "८-८१-५०", "content_sanskrit": "स समासाद्य सङ्ग्रामे भीमं भीमपराक्रमम्।\nवारयामास तं वीरो वेलेव मकरालयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2064007, "chapter_id": 2360, "verse_number": "८-८१-५१", "content_sanskrit": "सन्न्यवर्तत तं भीमो वार्यमाणः शितैः शरैः।\nशकुनिस्तस्य राजेन्द्र वामपार्श्वे स्तनान्तरे।\nप्रेषयामास नाराचान्रुक्मपुङ्खाञ्शिलाशितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2064008, "chapter_id": 2360, "verse_number": "८-८१-५२", "content_sanskrit": "वर्म भित्त्वा तु ते घोराः पाण्डवस्य महात्मनः।\nन्यम़ञ्जन्त महाराज कङ्कबर्हिणवाससः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2064009, "chapter_id": 2360, "verse_number": "८-८१-५३", "content_sanskrit": "सोऽतिविद्धो रणे भीमः शरं रुक्मविभूषितम्।\nप्रेषयामास स रुषा सौबलं प्रति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2064010, "chapter_id": 2360, "verse_number": "८-८१-५४", "content_sanskrit": "तमायान्तं शरं घोरं शकुनिः शत्रुतापनः।\nचिच्छेद सप्तधा राजन्कृतहस्तो महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2064011, "chapter_id": 2360, "verse_number": "८-८१-५५", "content_sanskrit": "तस्मिन्निपतिते भूमौ भीमः क्रुद्धो विशाम्पते।\nधनुश्छिच्छेद भल्लेन सौबलस्य हसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2064012, "chapter_id": 2360, "verse_number": "८-८१-५६", "content_sanskrit": "तदपास्य धनुश्छिन्नं सौबलेयः प्रतापवान्।\nअन्यदादाय वेगेन धनुर्भल्लांश्च षोडश।\nतैस्तस्य तु महाराज भल्लैः सन्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2064013, "chapter_id": 2360, "verse_number": "८-८१-५७", "content_sanskrit": "द्वाभ्यां स सारथिं ह्यार्च्छद्भीमं सप्तभिरेव च।\nध्वजमेकेन चिच्छेद द्वाभ्यां छत्रं विशाम्पते।\nचतुर्भिश्चतुरो वाहान्विव्याध सुबलात्मजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2064014, "chapter_id": 2360, "verse_number": "८-८१-५८", "content_sanskrit": "ततः क्रुद्धो महाराज भीमसेनः प्रतापवान्।\nशक्तिं चिक्षेप समरे रुक्मदण्डामयस्मयीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2064015, "chapter_id": 2360, "verse_number": "८-८१-५९", "content_sanskrit": "सा भीमभुजनिर्मुक्ता नागजिह्वेन चञ्चला।\nनिपपात रणे तूर्णं सौबलस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2064016, "chapter_id": 2360, "verse_number": "८-८१-६०", "content_sanskrit": "ततस्तामेव संगृह्य शक्तिं कनकभूषणाम्।\nभीमसेनाय चिक्षेप क्रुद्धरूपो विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2064017, "chapter_id": 2360, "verse_number": "८-८१-६१", "content_sanskrit": "सा निर्भिद्य भुजं सव्यं पाण्डवस्य महात्मनः।\nनिपपात तदा भूमौ यथा विद्युन्नभश्च्युता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2064018, "chapter_id": 2360, "verse_number": "८-८१-६२", "content_sanskrit": "अथोत्क्रुष्टं महाराज धार्तराष्ट्रैः समन्ततः।\nन तु तं ममृषे भीमः सिंहनादं तरस्विनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2064019, "chapter_id": 2360, "verse_number": "८-८१-६३", "content_sanskrit": "अन्यद्गृह्य धनुः सज्यं त्वरमाणो महाबलः।\nमुहूर्तादिव राजेन्द्र च्छादयामास सायकैः।\nसौबलस्य बलं सङ्ख्ये त्यक्त्वा नादं महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2064020, "chapter_id": 2360, "verse_number": "८-८१-६४", "content_sanskrit": "तस्याश्वांश्चतुरो हत्वा सूतं चैव विशाम्पते।\nध्वजं चिच्छेद भल्लेन त्वरमाणः पराक्रमी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2064021, "chapter_id": 2360, "verse_number": "८-८१-६५", "content_sanskrit": "हताश्वं रथमुत्सृज्य त्वरमाणो नरोत्तमः।\nतस्थौ विस्फारयंश्चापं क्रोधरक्तेक्षणः श्वसन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2064022, "chapter_id": 2360, "verse_number": "८-८१-६६", "content_sanskrit": "शरैश्च बहुधा राजन्भीममार्च्छत्समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2064023, "chapter_id": 2360, "verse_number": "८-८१-६७", "content_sanskrit": "प्रतिहत्य तु वेगेन भीमसेनः प्रतापवान्।\nधनुश्चिच्छेद सङ्क्रुद्धो विव्याध च शितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2064024, "chapter_id": 2360, "verse_number": "८-८१-६८", "content_sanskrit": "सोऽतिविद्धो बलवता शत्रुणा शत्रुकर्शनः।\nनिपपात तदा भूमौ किञ्चित्प्राणो नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2064025, "chapter_id": 2360, "verse_number": "८-८१-६९", "content_sanskrit": "ततस्तं विह्वलं ज्ञात्वा पुत्रस्तव विशाम्पते।\nअपोवाह रथेनाजौ भीमसेनस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2064026, "chapter_id": 2360, "verse_number": "८-८१-७०", "content_sanskrit": "शकुनिं विह्वलं दृष्ट्वा धार्तराष्ट्राः पराङ्मुखाः।\nप्रदुद्रुवुर्दिशो भीता भीमसेनभयात्प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2064027, "chapter_id": 2360, "verse_number": "८-८१-७१", "content_sanskrit": "सौबले निर्जिते राजन्भीमसेनेन धन्विना।\nभयेन महताऽऽविष्टः पुत्रो दुर्योधनस्तव।\nअपायाज्जवनैरश्वैः सापेक्षो मातुलं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2064028, "chapter_id": 2360, "verse_number": "८-८१-७२", "content_sanskrit": "पराङ्मुखं तु राजानं दृष्ट्वा सैन्यानि भारत।\nविप्रजग्मुः समुत्सृज्य द्वैरथानि समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2064029, "chapter_id": 2360, "verse_number": "८-८१-७३", "content_sanskrit": "तान्दृष्ट्वा विद्रुतान्सर्वान्धार्तराष्ट्रान्पराङ्मुखान्।\nजवेनाभ्यापतद्भीमः किरञ्शरशतान्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2064030, "chapter_id": 2360, "verse_number": "८-८१-७४", "content_sanskrit": "ते वध्यमाना भीमेन धार्तराष्ट्राः पराङ्मुखाः।\nकर्णमासाद्य समरे स्थिता राजन्समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2064031, "chapter_id": 2360, "verse_number": "८-८१-७५", "content_sanskrit": "स हि तेषां महावीर्यो द्वीपोऽभूत्सुमहाबलः।\nभिन्ननौका यथा राजन्द्वीपमासाद्य निर्वृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2064032, "chapter_id": 2360, "verse_number": "८-८१-७६", "content_sanskrit": "भवन्ति पुरुषव्याघ्र नाविकाः कालपर्यये।\nतथा कर्णं समासाद्य तावकाः पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2064033, "chapter_id": 2360, "verse_number": "८-८१-७७", "content_sanskrit": "समाश्वस्ताः स्थिता राजन्सम्प्रहृष्टाः परस्परम्।\nसमाजग्मुश्च युद्धाय मृत्युं कृत्वा निवर्तनम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2064034, "chapter_id": 2360, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे एकाशीतितमोऽध्यायः॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}]