[{"id": 2023968, "chapter_id": 1513, "verse_number": "३-१५१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2023969, "chapter_id": 1513, "verse_number": "३-१५१-१", "content_sanskrit": "एवमुक्तो महाबाहुर्भीमसेनः प्रतापवान्।\nप्रणिपत्य ततः प्रीत्या भ्रातरं हृष्टमानसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2023970, "chapter_id": 1513, "verse_number": "३-१५१-२", "content_sanskrit": "उवाच श्लक्ष्णया वाचा हनूमन्तं कपीश्वरम्।\nमत्तो धन्यतरो नास्ति यदार्यं दृष्टवानहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2023971, "chapter_id": 1513, "verse_number": "३-१५१-३", "content_sanskrit": "अनुग्रहो मे सुमहांस्तृप्तिश्च तव दर्शनात्।\nएतत्तु कृतमिच्छामि त्वयाऽऽर्येण प्रियं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2023972, "chapter_id": 1513, "verse_number": "३-१५१-४", "content_sanskrit": "यत्त्वेतदासीत्प्लवतः सागरं मकरालयम्।\nरूपमप्रतिमं वीर तदिच्छामि नीरीक्षितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2023973, "chapter_id": 1513, "verse_number": "३-१५१-५", "content_sanskrit": "एवं तुष्टो मभिष्यामि श्रद्धास्यामि च ते वचः।\nएवमुक्तः स तेजस्वी प्रहस्य हरिरब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2023974, "chapter_id": 1513, "verse_number": "३-१५१-६", "content_sanskrit": "न तच्छक्यं त्वया द्रष्टुं रूपं नान्येन केनचित्।\nकालावस्था तदा ह्यन्या वर्तते सा न सांप्रतम्।\n`ततोऽद्य दुष्करं द्रष्टुं मम रूपं नरोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2023975, "chapter_id": 1513, "verse_number": "३-१५१-७", "content_sanskrit": "अन्यः कृतयुगे कालश्रेतायां द्वापरे परः।\nअयं प्रध्वंसनः कालो नाद्य तद्रूपमस्ति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2023976, "chapter_id": 1513, "verse_number": "३-१५१-८", "content_sanskrit": "भूमिर्नद्यो नगाः शैलाः सिद्धा देवा महर्षयः।\nकालं समनुवर्तन्ते यथा भावा युगेयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2023977, "chapter_id": 1513, "verse_number": "३-१५१-९", "content_sanskrit": "`कालंकालं समासाद्य नराणां नरपुङ्गव।\nबलवर्ष्मप्रभावा हि प्रहीयन्त्युद्भवन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2023978, "chapter_id": 1513, "verse_number": "३-१५१-१०", "content_sanskrit": "तदलं बत तद्रूपं द्रष्टुं कुरुकुलोद्वह।\nयुगं समनुवर्तामि कालो हि दुरतिक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2023979, "chapter_id": 1513, "verse_number": "३-१५१-११x", "content_sanskrit": "भीम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2023980, "chapter_id": 1513, "verse_number": "३-१५१-११", "content_sanskrit": "युगसङ्ख्यां समाचक्ष्व आचारं च युगेयुगे।\nधर्मकामार्थभावांश्च कर्मवीर्ये भवाभवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2023981, "chapter_id": 1513, "verse_number": "३-१५१-२x", "content_sanskrit": "हनूमानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2023982, "chapter_id": 1513, "verse_number": "३-१५१-१२", "content_sanskrit": "कृतं नाम युगं श्रेष्ठं यत्रधर्मः सनातनः।\nकृतमेव न कर्तव्यं तस्मिन्काले युगोत्तमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2023983, "chapter_id": 1513, "verse_number": "३-१५१-१३", "content_sanskrit": "न तत्र धर्माः सीदन्ति क्षीयन्ते न च वै प्रजाः।\nततः कृतयुगं नाम कालेन गुणतां गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2023984, "chapter_id": 1513, "verse_number": "३-१५१-१४", "content_sanskrit": "देवदानवगन्धर्वयक्षराक्षसपन्नगाः।\nनासन्कृतयुगे तात तदा न क्रयविक्रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2023985, "chapter_id": 1513, "verse_number": "३-१५१-१५", "content_sanskrit": "न सामऋग्यजुर्वर्णाः क्रिया नासीच्च मानवी।\nअभिध्याय फलं तत्र धर्मः संन्यास एव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2023986, "chapter_id": 1513, "verse_number": "३-१५१-१६", "content_sanskrit": "न तस्मिन्युगसंसर्गे व्याधयो नेन्द्रियक्षयः।\nनासूया नापि रुदितं न दर्पो नापि वैकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2023987, "chapter_id": 1513, "verse_number": "३-१५१-१७", "content_sanskrit": "न विग्रहः कुतस्तन्द्री न द्वेषो न च पैशुनम्।\nन भयं नापि संतापो न चेर्ष्या न च मत्सरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2023988, "chapter_id": 1513, "verse_number": "३-१५१-१८", "content_sanskrit": "ततः परमकं ब्रह्म सा गतिर्योगिनां परा।\nआत्मा च सर्वभूतानां शुक्लो नारायणस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2023989, "chapter_id": 1513, "verse_number": "३-१५१-१९", "content_sanskrit": "ब्राह्मणआः क्षत्रिया वैश्याः शूद्राश्च कृतलक्षणाः।\nकृते युगे समभवन्स्वकर्मनिरताः प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2023990, "chapter_id": 1513, "verse_number": "३-१५१-२०", "content_sanskrit": "समाश्रयं समाचारं समज्ञानं च केवलम्।\nतदा हि समकर्माणो वर्णा धर्मानवाप्नुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2023991, "chapter_id": 1513, "verse_number": "३-१५१-२१", "content_sanskrit": "एकदेवसदायुक्ता एकमन्त्रविधिक्रियाः।\nपृथग्धर्मास्त्वेकवेदा धर्ममेकमनुव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2023992, "chapter_id": 1513, "verse_number": "३-१५१-२२", "content_sanskrit": "चातुराश्रम्ययुक्तेन कर्मणा कालयोगिना।\nअकामफलसंयोगात्प्राप्नुवन्ति परां गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2023993, "chapter_id": 1513, "verse_number": "३-१५१-२३", "content_sanskrit": "आत्मयोगसमायुक्तो धर्मोऽयं कृतलक्षणः।\nकृते युगे चतुष्पादश्चातुर्वर्ण्यस्य शाश्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2023994, "chapter_id": 1513, "verse_number": "३-१५१-२४", "content_sanskrit": "`कामः कामयमानेषु ब्राह्मणेषु तिरोहितः।\nएतत्कृतयुगं नाम त्रैगुण्यपरिवर्जितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2023995, "chapter_id": 1513, "verse_number": "३-१५१-२५", "content_sanskrit": "त्रेतामपि निबोध त्वं यस्मन्सत्रं प्रवर्तते।\nपादेन ह्रसते धर्मो रक्ततां याति चाच्युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2023996, "chapter_id": 1513, "verse_number": "३-१५१-२६", "content_sanskrit": "सत्यप्रवृत्ताश्च नराः क्रिया धर्मपरायणाः।\nततो यज्ञाः प्रवर्तन्ते धर्माश्चविविधाः क्रियाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2023997, "chapter_id": 1513, "verse_number": "३-१५१-२७", "content_sanskrit": "त्रेतायां भावसंकल्पाः क्रियादानफलोपगाः।\nप्रचलन्ति न वै धर्मात्तपोदानपरायणाः।\nस्वधर्मस्थाः क्रियावन्तो नरास्त्रेतायुगेऽभवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2023998, "chapter_id": 1513, "verse_number": "३-१५१-२८", "content_sanskrit": "द्वापरे च युगे धर्मो द्विभागो नः प्रवर्तते।\nविष्णुर्वै पीततां याति चतुर्धा वेद एव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2023999, "chapter_id": 1513, "verse_number": "३-१५१-२९", "content_sanskrit": "ततोऽन्ये च चतुर्वेदास्त्रिवेदाश्च तथा परे।\nद्विवेदाश्चैकवेदाश्चाप्यनृचश्च तथा परे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2024000, "chapter_id": 1513, "verse_number": "३-१५१-३०", "content_sanskrit": "एवं शास्त्रेषु भिननेषु बहुधा नीयते क्रिया।\nतपोदानप्रवृत्ता च राजसी भवति प्रजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2024001, "chapter_id": 1513, "verse_number": "३-१५१-३१", "content_sanskrit": "एकवेदस्य चाज्ञानाद्वेदास्ते बहवः कृताः।\nसत्यस्य चेह विभ्रंशात्सत्ये कश्चिदवस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2024002, "chapter_id": 1513, "verse_number": "३-१५१-३२", "content_sanskrit": "सत्यात्प्रच्यवमानानां व्याघयो बहवोऽभवन्।\nकामाश्चोपद्रवाश्चैव तदा वै दैवकारिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2024003, "chapter_id": 1513, "verse_number": "३-१५१-३३", "content_sanskrit": "यैरर्द्यभानाः सुभृशं तपस्तप्यन्ति मानवाः।\nकामकामाः स्वर्गकामा यज्ञांस्तन्वन्ति चापरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2024004, "chapter_id": 1513, "verse_number": "३-१५१-३४", "content_sanskrit": "एवं द्वापरमासाद्य प्रजाः क्षीयन्त्यधर्मतः।\nपादेनैकेन कौन्तेय धर्मः कलियुगे स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2024005, "chapter_id": 1513, "verse_number": "३-१५१-३५", "content_sanskrit": "तामसं युगमासाद्य कृष्णो भवति केशवः।\nवेदाचाराः प्रशाम्यन्ति धर्मयज्ञक्रियास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2024006, "chapter_id": 1513, "verse_number": "३-१५१-३६", "content_sanskrit": "ईतयो व्याधयस्तन्द्री दोषाः क्रोधादयस्तथा।\nउपद्रवाः प्रवर्तन्ते आधयो व्याधयस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2024007, "chapter_id": 1513, "verse_number": "३-१५१-३७", "content_sanskrit": "युगेष्वावर्तमानेषु धर्मो व्यावर्तते पुनः।\nधर्मे व्यावर्तमाने तु लोको व्यावर्तते पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2024008, "chapter_id": 1513, "verse_number": "३-१५१-३८", "content_sanskrit": "लोके क्षीणे क्षयं यानति भावा लोकप्रवर्तकाः।\nयुगक्षयकृता धर्माः प्रार्थनानि विकुर्वते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2024009, "chapter_id": 1513, "verse_number": "३-१५१-३९", "content_sanskrit": "एतत्कलियुगं नाम अचिराद्यत्प्रवर्तते।\nयुगानुवर्तनं त्वेतत्कुर्वन्ति चिरजीविनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2024010, "chapter_id": 1513, "verse_number": "३-१५१-४०", "content_sanskrit": "यच्च ते मत्परिज्ञाने कौतूहलमरिंदम।\nअनर्थकेषु को भावः पुरुषस्य विजानतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2024011, "chapter_id": 1513, "verse_number": "३-१५१-४१", "content_sanskrit": "एतत्ते सर्वमाख्यातं यन्मां त्वं परिपृच्छसि।\nयुगसङ्ख्यां महाबाहो स्वस्ति प्राप्नुहि गम्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2024012, "chapter_id": 1513, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्तयात्रापर्वणि एकपञ्चाशदधिकशततमोऽध्यायः ॥ १५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]