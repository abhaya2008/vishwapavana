[{"id": 2194715, "chapter_id": 5134, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2194716, "chapter_id": 5134, "verse_number": "१", "content_sanskrit": "बहवः पुरुषा ब्रह्मन्नुताहो एक एव तु ।\nको ह्यत्र पुरुषः श्रेष्ठः को वा योनिरिहोच्यते\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2194717, "chapter_id": 5134, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2194718, "chapter_id": 5134, "verse_number": "२", "content_sanskrit": "बहवः पुरुषा लोके साङ्ख्ययोगविचारिणाम् ।\nनैतदिच्छन्ति पुरुषमेकं कुरुकुलोद्वह \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2194719, "chapter_id": 5134, "verse_number": "३", "content_sanskrit": "बहूनां पुरुषाणां च यथैका योनिरुच्यते ।\nतथा तं पुरुषं विश्वं व्याख्यास्यामि गुणाधिकम्\t ॥ ३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2194720, "chapter_id": 5134, "verse_number": "४", "content_sanskrit": "नमस्कृत्वा तु गुरवे व्यासायामिततेजसे ।\nतपोयुक्ताय दान्ताय वन्द्याय परमर्षये\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2194721, "chapter_id": 5134, "verse_number": "५", "content_sanskrit": "इदं पुरुषसूक्तं हि सर्ववेदेषु पार्थिव ।\nऋतं सत्यं च विख्यातमृषिसिंहेन चिन्तितम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2194722, "chapter_id": 5134, "verse_number": "६", "content_sanskrit": "उत्सर्गेणापवादेन ऋषिभिः कपिलादिभिः ।\nअध्यात्मचिन्तामाश्रित्य शास्त्राण्युक्तानि भारत\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2194723, "chapter_id": 5134, "verse_number": "७", "content_sanskrit": "समासतस्तु यद्व्यासः पुरुषैकत्वमुक्तवान् ।\nतत्तेऽहं सम्प्रवक्ष्यामि प्रसादादमितौजसः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2194724, "chapter_id": 5134, "verse_number": "८", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nब्रह्मणा सह संवादं त्र्यम्बकस्य विशां पते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2194725, "chapter_id": 5134, "verse_number": "९", "content_sanskrit": "क्षीरोदस्य समुद्रस्य मध्ये हाटकसप्रभः ।\nवैजयन्त इति ख्यातः पर्वतप्रवरो नृप\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2194726, "chapter_id": 5134, "verse_number": "१०", "content_sanskrit": "तत्राध्यात्मगतिं देव एकाकी प्रविचिन्तयन् ।\nवैराजसदने नित्यं वैजयन्तं निषेवते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2194727, "chapter_id": 5134, "verse_number": "११", "content_sanskrit": "अथ तत्रासतस्तस्य चतुर्वक्त्रस्य धीमतः ।\nललाटप्रभवः पुत्रः शिव आगाद्यदृच्छया॥\nआकाशेनैव योगीशः पुरा त्रिनयनः प्रभुः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2194728, "chapter_id": 5134, "verse_number": "१२", "content_sanskrit": "ततः खान्निपपाताशु धरणीधरमूर्धनि ।\nअग्रतश्चाभवत् प्रीतो ववन्दे चापि पादयोः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2194729, "chapter_id": 5134, "verse_number": "१३", "content_sanskrit": "तं पादयोर्निपतितं दृष्ट्वा सव्येन पाणिना ।\nउत्थापयामास तदा प्रभुरेकः प्रजापतिः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2194730, "chapter_id": 5134, "verse_number": "", "content_sanskrit": "उवाच चैनं भगवांश्चिरस्यागतमात्मजम् ।\nस्वागतं ते महाबाहो दिष्ट्या प्राप्तोऽसि मेऽन्तिकम्\t॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2194731, "chapter_id": 5134, "verse_number": "१५", "content_sanskrit": "कच्चित्ते कुशलं पुत्र स्वाध्यायतपसोः सदा ।\nनित्यमुग्रतपास्त्वं हि ततः पृच्छामि ते पुनः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2194732, "chapter_id": 5134, "verse_number": "", "content_sanskrit": "रुद्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2194733, "chapter_id": 5134, "verse_number": "१६", "content_sanskrit": "त्वत्प्रसादेन भगवन् स्वाध्यायतपसोर्मम ।\nकुशलं चाव्ययं चैव सर्वस्य जगतस्तथा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2194734, "chapter_id": 5134, "verse_number": "१७", "content_sanskrit": "चिरदृष्टो हि भगवान्वैराजसदने मया ।\nततोऽहं पर्वतं प्राप्तस्त्विमं त्वत्पादसेवितम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2194735, "chapter_id": 5134, "verse_number": "१८", "content_sanskrit": "कौतूहलं चापि हि मे एकान्तगमनेन ते ।\nनैतत् कारणमल्पं हि भविष्यति पितामह\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2194736, "chapter_id": 5134, "verse_number": "१९", "content_sanskrit": "किं नु तत् सदनं श्रेष्ठं क्षुत्पिपासाविवर्जितम् ।\nसुरासुरैरध्युषितमृषिभिश्चामितप्रभैः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2194737, "chapter_id": 5134, "verse_number": "२०", "content_sanskrit": "गन्धर्वैरप्सरोभिश्च सततं सन्निषेवितम् ।\nउत्सृज्येमं गिरिवरमेकाकी प्राप्तवानसि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2194738, "chapter_id": 5134, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2194739, "chapter_id": 5134, "verse_number": "२१", "content_sanskrit": "वैजयन्तो गिरिवरः सततं सेव्यते मया ।\nअत्रैकाग्रेण मनसा पुरुषश्चिन्त्यते विराट्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2194740, "chapter_id": 5134, "verse_number": "", "content_sanskrit": "रुद्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2194741, "chapter_id": 5134, "verse_number": "२२", "content_sanskrit": "बहवः पुरुषा ब्रह्मंस्त्वया सृष्टाः स्वयम्भुवा ।\nसृज्यन्ते चापरे ब्रह्मन् स चैकः पुरुषो विराट्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2194742, "chapter_id": 5134, "verse_number": "२३", "content_sanskrit": "को ह्यसौ चिन्त्यते ब्रह्मंस्त्वया वै पुरुषोत्तमः ।\nएतन्मे संशयं ब्रूहि महत् कौतूहलं हि मे\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2194743, "chapter_id": 5134, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2194744, "chapter_id": 5134, "verse_number": "२४", "content_sanskrit": "बहवः पुरुषाः पुत्र ये त्वया समुदाहृताः ।\nएवमेतदतिक्रान्तं द्रष्टव्यं नैवमित्यपि ।\nआधारं तु प्रवक्ष्यामि एतस्य पुरुषस्य ते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2194745, "chapter_id": 5134, "verse_number": "२५", "content_sanskrit": "बहूनां पुरुषाणां स यथैका योनिरुच्यते ।\nतथा तं पुरुषं विश्वं परमं सुमहत्तमम् ।\nनिर्गुणं निर्गुणा भूत्वा प्रविशन्ति सनातनम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2194746, "chapter_id": 5134, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे त्र्यशीत्युत्तरशततमोऽध्यायः ॥१८३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]