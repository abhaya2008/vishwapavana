[{"id": 2212461, "chapter_id": 5525, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2212462, "chapter_id": 5525, "verse_number": "१", "content_sanskrit": "राज्यं प्राप्य नरव्याघ्राः पितृपैतामहं महत् ।\nकथमासन् महाराजे धृतराष्ट्रे महात्मनि\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2212463, "chapter_id": 5525, "verse_number": "२", "content_sanskrit": "स हि राजा हतामात्यो हतपुत्रो निराश्रयः ।\nकथमासीद् गतैश्वर्यो गान्धारी च यशस्विनी\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2212464, "chapter_id": 5525, "verse_number": "३", "content_sanskrit": "कियन्तं चैव कालं ते पितरो मम पूर्वकाः ।\nस्थिता राज्ये महात्मानः तन्मे व्याख्यातुमर्हसि\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2212465, "chapter_id": 5525, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2212466, "chapter_id": 5525, "verse_number": "४", "content_sanskrit": "प्राप्य राज्यं महात्मानः पाण्डवा हतशत्रवः ।\nधृतराष्ट्रं पुरस्कृत्य पृथिवीं पर्यपालयन्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2212467, "chapter_id": 5525, "verse_number": "५", "content_sanskrit": "धृतराष्ट्रमुपातिष्ठद् विदुरः सञ्जयस्तथा ।\nयुयुत्सुश्चैव मेधावी वेश्यापुत्रः स कौरवः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2212468, "chapter_id": 5525, "verse_number": "६", "content_sanskrit": "पाण्डवाः सर्वकार्येषु पृच्छन्ति स्म च तं नृपम् ।\nचक्रुस्तेनाभ्यनुज्ञाता वर्षाणि दश पञ्च च\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2212469, "chapter_id": 5525, "verse_number": "७", "content_sanskrit": "सदाऽभिगम्य ते वीराः पर्युपासत तं नृपम् ।\nपादाभिवन्दनं कृत्वा युधिष्ठिरमते स्थिताः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2212470, "chapter_id": 5525, "verse_number": "८", "content_sanskrit": "तेन ते मूर्ध्नि चाघ्राताः सर्वकार्याणि चक्रिरे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2212471, "chapter_id": 5525, "verse_number": "९", "content_sanskrit": "कुन्ती भोजसुता चैव गान्धारीमन्ववर्तत ।\nद्रौपदी च सुभद्रा च याश्चान्याः पाण्डवस्त्रियः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2212472, "chapter_id": 5525, "verse_number": "१०", "content_sanskrit": "समां वृत्तमवर्तन्त तयोः श्वश्व्रोर्यथाविधि\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2212473, "chapter_id": 5525, "verse_number": "११", "content_sanskrit": "शयनानि महार्हाणि वासांस्याभरणानि च ।\nसर्वाणि भक्ष्यभोज्यानि विविधानि च सर्वशः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2212474, "chapter_id": 5525, "verse_number": "१२", "content_sanskrit": "युधिष्ठिरो महाराजो धृतराष्ट्रे ह्युपानयत् ।\nतथैव कुन्ती गान्धार्यां गुरुवृत्तिमवर्तत\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2212475, "chapter_id": 5525, "verse_number": "१३", "content_sanskrit": "विदुरः सञ्जयश्चैव युयुत्सुश्चैव कौरव ।\nउपासन्ति स्म तं वृद्धं हतपुत्रं नराधिपम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2212476, "chapter_id": 5525, "verse_number": "१४", "content_sanskrit": "स्यालो द्रोणस्य यश्चैको दयितो ब्राह्मणो महान् ।\nस च तस्मिन् महेष्वासः कृपः समभवत् तदा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2212477, "chapter_id": 5525, "verse_number": "१५", "content_sanskrit": "व्यासश्च भगवान् नित्यं वासं चक्रे नृपेण ह ।\nकथां कुर्वन् पुराणर्षिर्देवर्षिर्नृपरक्षसाम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2212478, "chapter_id": 5525, "verse_number": "१६", "content_sanskrit": "धर्मयुक्तानि कार्याणि व्यवहारान्वितानि च ।\nधृतराष्ट्राभ्यनुज्ञातो विदुरस्तान्यकारयत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2212479, "chapter_id": 5525, "verse_number": "१७", "content_sanskrit": "कामतो हि प्रियाण्यस्य कार्याणि सुगुरूण्यपि ।\nप्राप्यन्तेऽर्थैः सुलघुभिः प्रभावाद् विदुरस्य वै\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2212480, "chapter_id": 5525, "verse_number": "१८", "content_sanskrit": "अकरोद् बन्धमोक्षांश्च वध्यानां मोक्षणं तथा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2212481, "chapter_id": 5525, "verse_number": "१९", "content_sanskrit": "न च धर्मात्मजो राजा कदाचित् किञ्चिदब्रवीत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2212482, "chapter_id": 5525, "verse_number": "२०", "content_sanskrit": "विहारयात्रासु पुनः कुरुराजो युधिष्ठिरः ।\nसर्वान् कामानुपस्थाप्य धृतराष्ट्रे न्यवेदयत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2212483, "chapter_id": 5525, "verse_number": "२१", "content_sanskrit": "आरालिकाः सूपकारा रागषाडविकास्तथा ।\nउपातिष्ठन्त राजानं धृतराष्ट्रं यथापुरम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2212484, "chapter_id": 5525, "verse_number": "२२", "content_sanskrit": "वासांसि सुमहार्हाणि माल्यानि विविधानि च ।\nउपजह्रुर्यथाकालं धृतराष्ट्रस्य पाण्डवाः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2212485, "chapter_id": 5525, "verse_number": "२३", "content_sanskrit": "मैरेयकाणि मांसानि पानकानि लघूनि च ।\nचित्रान् भक्ष्यविकारांश्च चक्रुरस्य यथापुरम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2212486, "chapter_id": 5525, "verse_number": "२४", "content_sanskrit": "ये चापि पृथिवीपालाः समाजग्मुः समन्ततः ।\nउपातिष्ठन्त ते सर्वे कौरवेन्द्रं यथापुरम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2212487, "chapter_id": 5525, "verse_number": "", "content_sanskrit": "कुन्ती च द्रौपदी चैव सात्वती चैव भामिनी ।\n(उलूपी नागकन्या च देवी चित्राङ्गदा तथा\t॥२५॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2212488, "chapter_id": 5525, "verse_number": "", "content_sanskrit": "धृष्टकेतोश्च भगिनी जरासन्धश्च चात्मजा ।\n(एताश्चान्याश्च बह्व्यो वै योषितः पुरुषर्षभ\t॥२६॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2212489, "chapter_id": 5525, "verse_number": "२७", "content_sanskrit": "किङ्कराः स्मोपतिष्ठन्ति सर्वाः ताः सुबलात्मजाम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2212490, "chapter_id": 5525, "verse_number": "२८", "content_sanskrit": "यथा पुत्रवियुक्तोऽयं न किञ्चिद्दुःखमाप्नुयात् ।\nइति राजाऽन्वशासद् भ्रातॄन् नित्यमेव युधिष्ठिरः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2212491, "chapter_id": 5525, "verse_number": "२९", "content_sanskrit": "एतत् ते धर्मराजस्य श्रुत्वा वचनमर्थवत् ।\nसविशेषमवर्तन्त भीममेकं विना तदा\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2212492, "chapter_id": 5525, "verse_number": "३०", "content_sanskrit": "न हि तत् तस्य वीरस्य हृदयादपगच्छति ।\nधृतराष्ट्रस्य यद् वृत्तं दुर्बुद्धेर्द्यूतमण्डले\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2212493, "chapter_id": 5525, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्रमवासिकपर्वणि\nधृतराष्ट्रशिश्रूषणं नाम प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2212494, "chapter_id": 5525, "verse_number": "", "content_sanskrit": "आश्रमवासपर्वणि प्रथमोऽध्यायः ॥१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]