[{"id": 7002683000, "chapter_id": 22683, "verse_number": "७-२६-१", "content_sanskrit": "सूत उवाच ।\nश्रावणे मासि संप्राप्ते देहलीं च महीपतिः ।\nनागोत्सवाय प्रययौ सदैव कलहप्रियः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002683001, "chapter_id": 22683, "verse_number": "७-२६-२", "content_sanskrit": "दृष्ट्वा नागोत्सवं तत्र गीतनृत्यसमन्वितम् ।\nमहीराजं नमस्कृत्य वचनं प्राह नम्रधीः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002683002, "chapter_id": 22683, "verse_number": "७-२६-३", "content_sanskrit": "राजन्महावतीग्रामे कीर्तिसागरमध्यगे ।\nवामनोत्सवमत्यं तं यवव्रीहिसमन्वितः ।\nपश्य त्वं तत्र गत्वा च ममैव वचनं कुरु ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002683003, "chapter_id": 22683, "verse_number": "७-२६-४", "content_sanskrit": "इति श्रुत्वा महीराजो धुंधुकारेण संयुतः ।\nसप्तलक्षबलैर्युक्तश्चामुण्डेन समन्वितः ।\nप्राप्तः शिरीषविपिने तत्र वासमकारयत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002683004, "chapter_id": 22683, "verse_number": "७-२६-५", "content_sanskrit": "महीपतिस्तु नृपतिं नत्वा वै चन्द्रवंशिनम् ।\nउवाच वचनं दुःखी धूर्तो मायाविशारदः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002683005, "chapter_id": 22683, "verse_number": "७-२६-६", "content_sanskrit": "राजन्प्राप्तो महीराजो युद्धार्थी त्वामुपस्थितः ।\nचन्द्रावलीं च तनयां ब्रह्मानंदं तवात्मजम् ।\nदिव्यलिंगं स संपूज्य बलात्काराद्ग्रहीष्यति ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002683006, "chapter_id": 22683, "verse_number": "७-२६-७", "content_sanskrit": "तस्मात्त्वं स्वबलैः सार्द्धं मया सह महामते ।\nछद्मना तं पराजित्य नगरेऽस्मिन्सुखी भव ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002683007, "chapter_id": 22683, "verse_number": "७-२६-८", "content_sanskrit": "इति श्रुत्वा दैव वशो राजा परिमलो बली ।\nचतुर्लक्षबलैस्सार्द्धं निशीथे च समागतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002683008, "chapter_id": 22683, "verse_number": "७-२६-९", "content_sanskrit": "शयितान्क्षत्रियाञ्छूरान्हत्वा पंचसहस्रकान् ।\nशतघ्नीं रोषणीं चक्रे बहुशूरविनाशिनीम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002683009, "chapter_id": 22683, "verse_number": "७-२६-१०", "content_sanskrit": "तदोत्थाय महीराजः कटिमाबध्य संभ्रमात् ।\nवैरिणं परमं मत्वा महद्युद्धमचीकरत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002683010, "chapter_id": 22683, "verse_number": "७-२६-११", "content_sanskrit": "युद्ध्यंत्योः सेनयो स्तत्र मलना पुत्रगृद्धिनी ।\nशारदामादराद्गत्वा पूजयामास भक्तितः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002683011, "chapter_id": 22683, "verse_number": "७-२६-१२", "content_sanskrit": "देविदेवि महादेवि सर्वदुःखविनाशिनि ।\nहर मे सकलां बाधां कृष्णांशं बोधयाशु च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002683012, "chapter_id": 22683, "verse_number": "७-२६-१३", "content_sanskrit": "जप्त्वायुतमिमं मंत्रं हुत्वा तर्पणमार्जने ।\nकृत्वा सुष्वाप तद्वेश्मस्तदा तुष्टा स्वयं शिवा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002683013, "chapter_id": 22683, "verse_number": "७-२६-१४", "content_sanskrit": "मलने महती बाधा क्षयं यास्यति मा शुचः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002683014, "chapter_id": 22683, "verse_number": "७-२६-१५", "content_sanskrit": "इत्युक्त्वा शारदा देवी कृष्णांशं प्रति चागमत् ।\nपुत्र ते जननी भूमिर्महीराजेन पीडिता ।\nक्षयं यास्यति शीघ्रं च तस्मात्त्वं तां समुद्धर ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002683015, "chapter_id": 22683, "verse_number": "७-२६-१६", "content_sanskrit": "इति श्रुत्वा वचो देव्यास्स वीरो विस्मयान्वितः ।\nदेवकीं प्रति संप्राप्तः कथयामास कारणम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002683016, "chapter_id": 22683, "verse_number": "७-२६-१७", "content_sanskrit": "सा तु श्रुत्वा वचो घोरं स्वर्णवत्या समन्विता ।\nरुरोद भृशमुद्विग्ना विलप्य बहुधा सती ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002683017, "chapter_id": 22683, "verse_number": "७-२६-१८", "content_sanskrit": "कृष्णांशस्तु तदा दुःखी देवसिंहमुवाच ह ।\nकिं कर्तव्यं मया वीर देह्याज्ञां दारुणे भये ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002683018, "chapter_id": 22683, "verse_number": "७-२६-१९", "content_sanskrit": "तच्छ्रुत्वा तेन सहितो लक्षणेन समन्वितः ।\nययौ दिग्विजयार्थेन व्याजेन च महावतीम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002683019, "chapter_id": 22683, "verse_number": "७-२६-२०", "content_sanskrit": "तालनो भीमसेनांशः सेनापतिरुदारधीः ।\nसप्तलक्षबलैस्सार्द्धं विनाह्लादेन संययौ ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002683020, "chapter_id": 22683, "verse_number": "७-२६-२१", "content_sanskrit": "कल्पक्ष्रेत्रमुपागम्य योगिनस्ते तदाभवन् ।\nसेनां निवेशयामास विपिने तत्र दारुणे ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002683021, "chapter_id": 22683, "verse_number": "७-२६-२२", "content_sanskrit": "कृष्णांशस्तालनो देवो लक्षणो बलवत्तरः ।\nगृहीत्वा लास्यवस्तूनि युद्धभूमिमुपागमन् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002683022, "chapter_id": 22683, "verse_number": "७-२६-२३", "content_sanskrit": "सप्ताहं च तयोर्युद्धं जातं मृत्युविवर्द्धनम् ।\nसप्तमेऽहनि ते वीरास्संप्राप्ता रणमूर्द्धनि ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002683023, "chapter_id": 22683, "verse_number": "७-२६-२४", "content_sanskrit": "तस्मिन्दिने महाभाग महद्युद्धमवर्तत ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002683024, "chapter_id": 22683, "verse_number": "७-२६-२५", "content_sanskrit": "दृष्ट्वा पराजितं सैन्यं राजा परिमलो बली ।\nरथस्थश्चापमादाय महीराजमुपाययौ ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002683025, "chapter_id": 22683, "verse_number": "७-२६-२६", "content_sanskrit": "यादवश्च गजारूढस्तदा चंद्रावलीपतिः ।\nधुन्धुकारं समाहूय धनुर्युद्धमचीकरत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002683026, "chapter_id": 22683, "verse_number": "७-२६-२७", "content_sanskrit": "हरिनागरमारुह्य ब्रह्मानंदो महाबल ।\nतारकं शत्रुमाहूय धनुर्युद्धं चकार ह ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002683027, "chapter_id": 22683, "verse_number": "७-२६-२८", "content_sanskrit": "मर्दनं राजपुत्रं च रणजिद्ग जसंस्थितः ।\nस्वशरैस्ताडयामास तत्सुतं च जघान ह ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002683028, "chapter_id": 22683, "verse_number": "७-२६-२९", "content_sanskrit": "रूपणो वै सरदनं हयारूढो जगाम ह ।\nआभीरीतनयो जातो मदनो नाम वै बली ।\nनृहरं राजपुत्रं च शंखांशश्च जगाम ह ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002683029, "chapter_id": 22683, "verse_number": "७-२६-३०", "content_sanskrit": "तेषु संग्राममेतेषु चामुण्डोऽयुतसैन्यपः ।\nमहीपतेश्च वचनं मत्वा नगरमाययौ ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002683030, "chapter_id": 22683, "verse_number": "७-२६-३१", "content_sanskrit": "ददर्श नगरीं रम्यां चतुर्वर्णसमन्विताम् ।\nधनधान्ययुतां वीरो देवीभक्तिपरायणः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002683031, "chapter_id": 22683, "verse_number": "७-२६-३२", "content_sanskrit": "महीपतिस्तु वै धूर्तो दुर्गद्वारि समागतः ।\nचामुंडेन युतः पापी राजगेहमुपाययौ ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002683032, "chapter_id": 22683, "verse_number": "७-२६-३३", "content_sanskrit": "मलना भ्रातरं दृष्ट्वा वचनं प्राह दुःखिता ।\nभाद्रकृष्णाष्टमी चाद्य यवव्रीहि गृहे स्थितम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002683033, "chapter_id": 22683, "verse_number": "७-२६-३४", "content_sanskrit": "न प्राप्तं जल संस्थाने सुपुण्ये कीर्तिसागरे ।\nमहीराजो महापापी वामनोत्सवमागतः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002683034, "chapter_id": 22683, "verse_number": "७-२६-३५", "content_sanskrit": "विनाह्लादं च कृष्णांशं महद्दुःखमुपागतम् ।\nइत्युक्तस्य विहस्याह ब्राह्मणोऽयं महाबली ।\nकान्यकुब्जात्समायातः कृष्णांशेन प्रयोजितः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002683035, "chapter_id": 22683, "verse_number": "७-२६-३६", "content_sanskrit": "देवीदत्तश्च नाम्नाऽयं स ते कार्यं करिष्यति ।\nश्रुत्वा चंद्रावली देवी सर्वभूषणसंयुता ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002683036, "chapter_id": 22683, "verse_number": "७-२६-३७", "content_sanskrit": "कामाग्निपीडितं विप्रं चामुंडं च ददर्श ह ।\nमातरं प्रति चागम्य वचनं प्राह निर्भरम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002683037, "chapter_id": 22683, "verse_number": "७-२६-३८", "content_sanskrit": "धूर्तोऽयं ब्राह्मणो मातर्निश्चयं मां हरिष्यति ।\nकोऽयं वीरो न जानामि कथं यामि पतिव्रता ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002683038, "chapter_id": 22683, "verse_number": "७-२६-३९", "content_sanskrit": "इति श्रुत्वा वचस्तस्या लज्जितस्स महीपतिः ।\nचामुंडेन युतः प्राप्तो यत्राभूत्स महारणः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002683039, "chapter_id": 22683, "verse_number": "७-२६-४०", "content_sanskrit": "एतस्मिन्नंतरे ते वै ब्रह्माद्यास्तैः पराजिताः ।\nत्यक्त्वा युद्धं गृहं प्राप्तास्त्रिलक्षबलसंयुताः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002683040, "chapter_id": 22683, "verse_number": "७-२६-४१", "content_sanskrit": "कपाटं सुदृढं कृत्वा महाचिंतामुपाययुः ।\nमहीराजस्तु बलवान्महीपत्यनुमोदितः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002683041, "chapter_id": 22683, "verse_number": "७-२६-४२", "content_sanskrit": "प्रमदावनमागत्य षष्टिलक्षबलान्वितः ।\nजुगोप तत्र बलवान्माननोत्सवहेतवे ।\nतालनाद्याश्च चत्वारः शिरीषाख्यपुरं ययुः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002683042, "chapter_id": 22683, "verse_number": "७-२६-४३", "content_sanskrit": "स्थलीभूतं च तं ग्रामं दृष्ट्वा ते विस्मयान्विताः ।\nप्रययुस्ते सुखभ्रष्टा ददृशुर्हिमदं मुनिम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002683043, "chapter_id": 22683, "verse_number": "७-२६-४४", "content_sanskrit": "प्रणम्योचुः शुचाविष्टा बलखा निर्मुने बली ।\nक्व गतः समरश्लाघी स च कुनागरैर्युतः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002683044, "chapter_id": 22683, "verse_number": "७-२६-४५", "content_sanskrit": "श्रुत्वाह हिमदो योगी महीराजेन नाशितः ।\nछद्मना बलखानिश्च तस्येयं सुन्दरी चिता ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002683045, "chapter_id": 22683, "verse_number": "७-२६-४६", "content_sanskrit": "इति श्रुत्वा वचो घोरं कृष्णांशः शोकतत्परः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002683046, "chapter_id": 22683, "verse_number": "७-२६-४७", "content_sanskrit": "विललाप भृशं तत्र हा बन्धो धर्मजांशक ।\nत्वदृते भूतले वासो ममातीव भयंकरः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002683047, "chapter_id": 22683, "verse_number": "७-२६-४८", "content_sanskrit": "दर्शनं देहि मे क्षिप्रं नो चेत्प्राणांस्त्यजाम्यहम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002683048, "chapter_id": 22683, "verse_number": "७-२६-४९", "content_sanskrit": "इत्युक्तः स तु तद्भ्राता बलखानिः पिशाचगः ।\nसपत्नीकस्समायातो रोदनं कृतवान्बहु ।\nकथित्वा सर्ववृत्तान्तं यथाजातं स्ववैशसम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002683049, "chapter_id": 22683, "verse_number": "७-२६-५०", "content_sanskrit": "दिव्यं विमानमारुह्य गतो नाकं मनोरमम् ।\nयुधिष्ठिरे तस्य कला बलखानेर्लयं गता ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002683050, "chapter_id": 22683, "verse_number": "७-२६-५१", "content_sanskrit": "तदा दुःखी स कृष्णांशः कृत्वा भ्रातुस्तिलांजलिम् ।\nमहावतीं समागत्य राजगेहमुपाययौ ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002683051, "chapter_id": 22683, "verse_number": "७-२६-५२", "content_sanskrit": "वेणुशब्देन कृष्णांशो ननर्त जनमोहनः ।\nवीणाप्रवाद्यं च जगौ तालनो योगिरूपधृक ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002683052, "chapter_id": 22683, "verse_number": "७-२६-५३", "content_sanskrit": "मृदंगध्वनिना देवो लक्षणः कांस्यवाद्यकः ।\nसुस्वरं च जगौ तत्र श्रुत्वा राजा विमोहितः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002683053, "chapter_id": 22683, "verse_number": "७-२६-५४", "content_sanskrit": "तदा तु मलना राज्ञी दृष्ट्वा तद्वामनोत्सवम् ।\nरुदित्वा वचनं प्राह क्व गतो मे प्रियंकरः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002683054, "chapter_id": 22683, "verse_number": "७-२६-५५", "content_sanskrit": "कृष्णांशो बन्धुसहितस्त्यक्त्वा मां मन्दभागिनीम् ।\nत्वया विरहितो देशो महीराजेन लुंठितः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002683055, "chapter_id": 22683, "verse_number": "७-२६-५६", "content_sanskrit": "इत्युक्तां मलनां दृष्ट्वा कृष्णांशः स्नेह कातरः ।\nवचनं प्राह नम्रात्मा देवि त्वं वचनं कुरु ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002683056, "chapter_id": 22683, "verse_number": "७-२६-५७", "content_sanskrit": "योगिनश्च वयं राज्ञि सर्वयुद्धविशारदाः ।\nतवेदं सकलं कार्यं कृत्वा यामो हि नैमिषम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002683057, "chapter_id": 22683, "verse_number": "७-२६-५८", "content_sanskrit": "ये यवव्रीहयश्चैव तव सद्मनि संस्थिताः ।\nगृहीत्वा योषितस्सर्वा गच्छन्तु सागरान्तिकम् ।\nवयं तु योगसैन्येन तव रक्षां च कुर्महे ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002683058, "chapter_id": 22683, "verse_number": "७-२६-५९", "content_sanskrit": "इति श्रुत्वा वचस्तस्य तत्सुता च पतिव्रता ।\nमातरं वचनं प्राह कृष्णांशोऽयं न नर्तकः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002683059, "chapter_id": 22683, "verse_number": "७-२६-६०", "content_sanskrit": "पुण्डरीकनिभे नेत्रे श्यामांगं तस्य सुन्दरम् ।\nकृष्णांशेन विना मातः को रक्षार्थं क्षमो भुवि ।\nदुर्जयश्च महीराजः कृष्णांशेन विनिर्जितः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002683060, "chapter_id": 22683, "verse_number": "७-२६-६१", "content_sanskrit": "इति तद्वचनं श्रुत्वा मलना प्रेमविह्वला ।\nयववीहयो निष्कास्य योषितां स्थापिताः करे ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002683061, "chapter_id": 22683, "verse_number": "७-२६-६२", "content_sanskrit": "जगुस्ता योषितस्सर्वाः कृष्णांशचरितं शुभम् ।\nलक्षणः शीघ्रमागम्य योगिवेषान्स्वसैनिकान् ।\nसज्जीकृत्य स्थितस्तत्र तालनाद्यैः सुरक्षितः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002683062, "chapter_id": 22683, "verse_number": "७-२६-६३", "content_sanskrit": "कीर्तिसागरमागम्य ते वीरा बल दर्पिताः ।\nरुरुधुः सर्वतो नारीर्दोलायुतमितस्थिताः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002683063, "chapter_id": 22683, "verse_number": "७-२६-६४", "content_sanskrit": "महीपतिस्तु कुलहा ज्ञात्वा कृष्णांशमागतम् ।\nचंद्रवंशिनमागम्य सपुत्रश्च रुरोद ह ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002683064, "chapter_id": 22683, "verse_number": "७-२६-६५", "content_sanskrit": "योगिभिस्तैर्महाराज लुंठिताः सर्वयोषितः ।\nमलना संहृता तत्र तथा चंद्रावली सुता ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002683065, "chapter_id": 22683, "verse_number": "७-२६-६६", "content_sanskrit": "महीराजस्य ते सैन्या योगिवेषास्समागताः ।\nतारकाय सुतां प्रादान्महीराजाय मत्स्वसाम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002683066, "chapter_id": 22683, "verse_number": "७-२६-६७", "content_sanskrit": "इति श्रुत्वा वचो घोरं ब्रह्मानन्दो महाबलः ।\nलक्षसैन्यान्वितस्तत्र ययौ रोषसमन्वितः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002683067, "chapter_id": 22683, "verse_number": "७-२६-६८", "content_sanskrit": "महीराजस्तु कलही सैन्यायुतमहात्मजः ।\nरक्षितः कामसेनेन तथा रणजिता ययौ ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002683068, "chapter_id": 22683, "verse_number": "७-२६-६९", "content_sanskrit": "तयोश्चासीन्महयुद्धं सेनयोरुभयोर्भुवि ।\nतालनो योगिवेषश्च ब्रह्मानंदमुपाययौ ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002683069, "chapter_id": 22683, "verse_number": "७-२६-७०", "content_sanskrit": "लक्षणश्चाभयं शूरं देवसिंहो महीपतिम् ।\nजित्वा बद्ध्वा च मुदितौ कामसेनस्समागतः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002683070, "chapter_id": 22683, "verse_number": "७-२६-७१", "content_sanskrit": "लक्षणः कामसेनं च देवो रणजितं तदा ।\nबद्ध्वा तत्र स्थितौ वीरौ शत्रूसैन्यक्षयंकरौ ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002683071, "chapter_id": 22683, "verse_number": "७-२६-७२", "content_sanskrit": "एतस्मिन्नंतरे ब्रह्मा बद्ध्वा वै तालनं बली ।\nलक्षणान्तमुपागम्य धनुर्युद्धमचीकरत् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002683072, "chapter_id": 22683, "verse_number": "७-२६-७३", "content_sanskrit": "लक्षणं छिन्नधन्वानं पुनर्बद्ध्वा महाबलः ।\nदेवसिंहमुपागम्य मूर्छितं तं चकार ह ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002683073, "chapter_id": 22683, "verse_number": "७-२६-७४", "content_sanskrit": "हाहाभूते योगिसैन्ये प्रद्रुते सर्वतो दिशम् ।\nकृष्णांशो योषितस्सर्वा वचनं प्राह नम्रधीः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002683074, "chapter_id": 22683, "verse_number": "७-२६-७५", "content_sanskrit": "ब्रह्मानन्दोऽयमायातो मम सैन्य क्षयंकरः ।\nतस्माद्यूयं मया सार्द्धं गच्छाशु च तं प्रति ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7002683075, "chapter_id": 22683, "verse_number": "७-२६-७६", "content_sanskrit": "इत्युक्त्वा तास्समादाय ब्रह्मानन्दमुपाययौ ।\nतयोश्चासीन्महद्युद्धं नरनारायणां शयोः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7002683076, "chapter_id": 22683, "verse_number": "७-२६-७७", "content_sanskrit": "कृष्णांशस्तत्र बलवान्नभोमार्गेण तं प्रति ।\nरथस्थं च समागम्य मोहयामास सोऽसिना ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7002683077, "chapter_id": 22683, "verse_number": "७-२६-७८", "content_sanskrit": "तदा तु मूर्छिते तस्मिन्मोचयित्वा च ता मुदा ।\nयोगी सैन्यान्वितो युद्धात्पलायनपरोऽभवत् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7002683078, "chapter_id": 22683, "verse_number": "७-२६-७९", "content_sanskrit": "पराजिते योगिसैन्ये ब्रह्मानंदो महाबलः ।\nयोषितस्ताः समादाय स्वगेहाय दधौ मनः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7002683079, "chapter_id": 22683, "verse_number": "७-२६-८०", "content_sanskrit": "महीराजस्तु संप्राप्तो महीपत्यनुमोदितः ।\nरुरोध सर्वतो नारीः शिवदत्तवरो बली ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7002683080, "chapter_id": 22683, "verse_number": "७-२६-८१", "content_sanskrit": "नृहरश्चाभयं शूरं मर्दनश्चैव रूपणम् ।\nमदनं वै सरदनो ब्रह्मानंदं च तारकः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7002683081, "chapter_id": 22683, "verse_number": "७-२६-८२", "content_sanskrit": "चामुण्डः कामसेनं च धनुर्युद्धमचीकरत् ।\nतदाभयो महावीरो धुन्वंतं नृहरं रिपुम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7002683082, "chapter_id": 22683, "verse_number": "७-२६-८३", "content_sanskrit": "छित्त्वा धनुस्तमागत्य खड्गयुद्धमचीकरत् ।\nनृहरः खड्गरहितोऽभवद्युद्धपराङ्मुखः ।\nतमाह वचनं क्रुद्धोऽभयो युद्धार्थमुद्यतः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7002683083, "chapter_id": 22683, "verse_number": "७-२६-८४", "content_sanskrit": "भवान्वै मातृष्वस्रीयो महीराजस्य चात्मजः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7002683084, "chapter_id": 22683, "verse_number": "७-२६-८५", "content_sanskrit": "क्षत्रियाणां परं धर्मं कथं संहर्तुमिच्छति ।\nइति श्रुत्वा तु नृहरो गृहीत्वा परिघं रुषा ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7002683085, "chapter_id": 22683, "verse_number": "७-२६-८६", "content_sanskrit": "जघान तं च शिरसि स हतः स्वर्गमाययौ ।\nस च वै कृतवर्मांशो विलीनः कृतवर्मणि ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7002683086, "chapter_id": 22683, "verse_number": "७-२६-८७", "content_sanskrit": "मदनं गोपजातं च हत्वा सरदनो बली ।\nजयशब्दं चकारोच्चैर्पुनर्हत्वा रिपोर्बलम् ।\nउत्तरांशश्च स ज्ञेयो मदनश्चोत्तरे लयः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7002683087, "chapter_id": 22683, "verse_number": "७-२६-८८", "content_sanskrit": "रूपणश्च समागत्य मूर्छयित्वा च मर्दनम् ।\nपुनस्सरदनं प्राप्य खड्गयुद्धं चकार ह ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7002683088, "chapter_id": 22683, "verse_number": "७-२६-८९", "content_sanskrit": "ब्रह्मानंदश्च बलवान्स बद्ध्वा तारकं रुषा ।\nमहीराजान्तमागम्य धनुर्युद्धं चकार ह ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7002683089, "chapter_id": 22683, "verse_number": "७-२६-९०", "content_sanskrit": "नृहरं रणजित्प्राप्य स्वभल्लेन तदा रुषा ।\nजघान समरश्लाघी महीराजसुतं शुभम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7002683090, "chapter_id": 22683, "verse_number": "७-२६-९१", "content_sanskrit": "स वै दुश्शासनांशश्च मृतस्तस्मिन्समागतः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7002683091, "chapter_id": 22683, "verse_number": "७-२६-९२", "content_sanskrit": "निहते नृहरे बंधौ मर्दनः क्रोधतत्परः ।\nस्वशरैस्ताडयामास सात्यकेरंशमुत्तमम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7002683092, "chapter_id": 22683, "verse_number": "७-२६-९३", "content_sanskrit": "छित्त्वा तान्रणजिच्छूरस्स वै परिमलोद्भवः ।\nस्वभल्लेन शिरः कायान्मर्दनस्य स चाहरत् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7002683093, "chapter_id": 22683, "verse_number": "७-२६-९४", "content_sanskrit": "मृतेऽस्मिन्मर्दने वीरे तदा सरदनो बली ।\nताडयामास तं वीरं स्वभल्लेनैव वक्षसि ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7002683094, "chapter_id": 22683, "verse_number": "७-२६-९५", "content_sanskrit": "महत्कष्टमुपागम्य रणजिन्मलनोद्भवः ।\nस्वखङ्गेन शिरः कायादपाहरत वैरिणः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7002683095, "chapter_id": 22683, "verse_number": "७-२६-९६", "content_sanskrit": "त्रिबंधौ निहते युद्धे तारकः क्रोधमूर्छितः ।\nरथस्थश्च रथस्थं च ताडयामास वै शरैः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7002683096, "chapter_id": 22683, "verse_number": "७-२६-९७", "content_sanskrit": "छित्त्वा बाणं च रणजित्तथैव च रिपोर्द्धनुः ।\nत्रिशरैस्ताडयामास कर्णांशं तारकं हृदि ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7002683097, "chapter_id": 22683, "verse_number": "७-२६-९८", "content_sanskrit": "अमर्षवशमापन्नो यथा दंडैर्भुजंगमः ।\nध्यात्वा च शंकरं देवं विषधौतं शरं पुनः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7002683098, "chapter_id": 22683, "verse_number": "७-२६-९९", "content_sanskrit": "संधाय तर्जयित्वा च शत्रुकंठमताडयत् ।\nतेन बाणेन रणजित्त्यक्त्वा देहं दिवं गतः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7002683099, "chapter_id": 22683, "verse_number": "७-२६-१००", "content_sanskrit": "हते तस्मिन्महावीर्ये ब्रह्मानंदश्च दुःखितः ।\nमहीराजभयाद्ब्रह्मा पुरस्कृस्य च योषितः ।\nसंध्याकाले तु संप्राप्ते भाद्रकृष्णाष्टमीदिने ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7002683100, "chapter_id": 22683, "verse_number": "७-२६-१०१", "content_sanskrit": "कपाटं सुदृढं कृत्वा सैन्यैः षष्टिसहस्रकैः ।\nसार्द्धं गेहमुपागम्य शारदां शरणं ययौ ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7002683101, "chapter_id": 22683, "verse_number": "७-२६-१०२", "content_sanskrit": "महीराजस्तु बलवान्पुत्रशोकेन दुःखितः ।\nसंकल्पं कृतवान्घोरं शृण्वतां सर्वभूभृताम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7002683102, "chapter_id": 22683, "verse_number": "७-२६-१०३", "content_sanskrit": "शिरीषाख्यपुरं रम्यं यथा शून्यं मया कृतम् ।\nतथा महावती सर्वा ब्रह्मानंदादिभिस्सह ।\nक्षयं यास्यंति मद्बाणैः सर्वे ते चंद्रवंशिनः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7002683103, "chapter_id": 22683, "verse_number": "७-२६-१०४", "content_sanskrit": "इत्युक्त्वा धुंधुकारं वै चाह्वयामास भूपतिः ।\nपंचलक्षबलैस्सार्द्धं शीघ्रमागम्यतां प्रिय ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7002683104, "chapter_id": 22683, "verse_number": "७-२६-१०५", "content_sanskrit": "इति श्रुत्वा धुंधुकारो गत्वा शीघ्रं च देहलीम् ।\nउषित्वा सप्त दिवसान्युद्धभूमिमुपागमत् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7002683105, "chapter_id": 22683, "verse_number": "७-२६-१०६", "content_sanskrit": "तदाष्टलक्षसहितो महीराजो महाबलः ।\nतारकेण च संयुक्तो युद्धाय समुपाययौ ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}]