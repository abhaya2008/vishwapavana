[{"id": 7000358000, "chapter_id": 20358, "verse_number": "२-३०-१", "content_sanskrit": "ऋषय ऊचुः ।\nयोऽसौ वेनस्त्वयाख्यातः पापाचारेण वर्तितः ।\nतस्य पापस्य का वृत्तिः किं फलं प्राप्तवान्द्विज॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000358001, "chapter_id": 20358, "verse_number": "२-३०-२", "content_sanskrit": "चरित्रं तस्य वेनस्य समाख्याहि यथा पुरा ।\nविस्तरेण विदां श्रेष्ठ त्वं न एतन्महामते॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000358002, "chapter_id": 20358, "verse_number": "२-३०-३", "content_sanskrit": "सूत उवाच ।\nचरित्रं तस्य वेनस्य वैन्यस्यापि महात्मनः ।\nप्रवक्ष्यामि सुपुण्यं च यथान्यायं श्रुतं पुरा॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000358003, "chapter_id": 20358, "verse_number": "२-३०-४", "content_sanskrit": "जाते पुत्रे महाभागस्तस्मिन्पृथौ महात्मनि ।\nविमलत्वं गतो राजा धर्मत्वं गतवान्पुनः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000358004, "chapter_id": 20358, "verse_number": "२-३०-५", "content_sanskrit": "महापापानि सर्वाणि अर्जितानि नराधमैः ।\nतीर्थसंगप्रसंगेन तेषां पापं प्रयाति च॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000358005, "chapter_id": 20358, "verse_number": "२-३०-६", "content_sanskrit": "सतां संगात्प्रजायेत पुण्यमेव न संशयः ।\nपापानां तु प्रसंगेन पापमेव प्रजायते॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000358006, "chapter_id": 20358, "verse_number": "२-३०-७", "content_sanskrit": "संभाषाद्दर्शनात्स्पर्शादासनाद्भोजनात्किल ।\nपापिनां संगमाच्चैव किल्बिषं परिसंचरेत्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000358007, "chapter_id": 20358, "verse_number": "२-३०-८", "content_sanskrit": "तथा पुण्यात्मकानां च पुण्यमेव प्रसंचरेत् ।\nमहातीर्थप्रसंगेन पापाः शुध्यंति नान्यथा॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000358008, "chapter_id": 20358, "verse_number": "२-३०-९", "content_sanskrit": "पुण्यां गतिं प्रयान्त्येते निर्द्धूताशेष कल्मषाः ।\nऋषय ऊचुः ।\nतत्कथं यांति ते पापाः परां सिद्धिं द्विजोत्तम॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000358009, "chapter_id": 20358, "verse_number": "२-३०-१०", "content_sanskrit": "तन्नो विस्तरतो ब्रूहि श्रोतुं श्रद्धा प्रवर्तते॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000358010, "chapter_id": 20358, "verse_number": "२-३०-११", "content_sanskrit": "सूत उवाच ।\nलुब्धकाश्च महापापाः संजाता दासधीवराः ।\nरेवा च यमुना गंगास्तासामंभसि संस्थिताः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000358011, "chapter_id": 20358, "verse_number": "२-३०-१२", "content_sanskrit": "ज्ञानतोऽज्ञानतः स्नात्वा संक्रीडंति च वै जले ।\nमहानद्याः प्रसंगेन ते यांति परमां गतिम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000358012, "chapter_id": 20358, "verse_number": "२-३०-१३", "content_sanskrit": "दासत्वं पापसंघातं परित्यज्य व्रजंति ते ।\nपुण्यतोयप्रसंगाच्च ह्याप्लुताः सर्व एव ते॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000358013, "chapter_id": 20358, "verse_number": "२-३०-१४", "content_sanskrit": "महानद्याः प्रसंगाच्च अन्यासां नैव सत्तमाः ।\nमहापुण्यजनस्यापि पापं नश्यति पापिनाम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000358014, "chapter_id": 20358, "verse_number": "२-३०-१५", "content_sanskrit": "प्रसंगाद्दर्शनात्स्पर्शान्नात्र कार्या विचारणा ।\nअत्रार्थे श्रूयते विप्रा इतिहासोऽघनाशनः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000358015, "chapter_id": 20358, "verse_number": "२-३०-१६", "content_sanskrit": "तं वो अद्य प्रवक्ष्यामि बहुपुण्यप्रदायकम् ।\nकश्चिदस्ति मृगव्याधः सुलोभाख्यो महावने॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000358016, "chapter_id": 20358, "verse_number": "२-३०-१७", "content_sanskrit": "श्वभिर्वागुरिजालैश्च धनुर्बाणैस्तथैव च ।\nमृगान्घातयते नित्यं पिशितास्वादलंपटः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000358017, "chapter_id": 20358, "verse_number": "२-३०-१८", "content_sanskrit": "एकदा तु सुदुष्टात्मा बाणपाणिर्धनुर्धरः ।\nश्वभिः परिवृतो दुर्गं वनं विंध्यस्य वै गतः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000358018, "chapter_id": 20358, "verse_number": "२-३०-१९", "content_sanskrit": "मृगान्रुरून्वराहांश्च भीतान्सूदितवान्बहून् ।\nरेवातीरं समासाद्य कश्चिच्छफरघातकः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000358019, "chapter_id": 20358, "verse_number": "२-३०-२०", "content_sanskrit": "शफरान्सूदयित्वा स निर्जगाम बहिर्जलात् ।\nमृगव्याधस्य लोभस्य भयत्रस्ता ततो मृगी॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000358020, "chapter_id": 20358, "verse_number": "२-३०-२१", "content_sanskrit": "जीवत्राणपरा सार्ता भीता चलितचेतना ।\nत्वरमाणा पलायंती रेवातीरं समाश्रिता॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000358021, "chapter_id": 20358, "verse_number": "२-३०-२२", "content_sanskrit": "श्वभिश्च चालिता सा तु बाणघातक्षतातुरा ।\nश्वसनस्यापि वेगेन सुलभो मृगघातकः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000358022, "chapter_id": 20358, "verse_number": "२-३०-२३", "content_sanskrit": "पृष्ठ एव समायाति पुरतो याति सा मृगी ।\nदृष्टवांस्तां शफरहा बाणपाणिः समुद्यतः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000358023, "chapter_id": 20358, "verse_number": "२-३०-२४", "content_sanskrit": "धनुरानम्य वेगेन अनुरुध्य च तां मृगीम् ।\nतावल्लुब्धक लोभाख्यः श्वभिः सार्द्धं समागतः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000358024, "chapter_id": 20358, "verse_number": "२-३०-२५", "content_sanskrit": "न हंतव्या मदीयेयं मृगयां मे समागता ।\nतस्य वाक्यं समाकर्ण्य मीनहा मांसलंपटः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000358025, "chapter_id": 20358, "verse_number": "२-३०-२६", "content_sanskrit": "बाणं मुमोच दुष्टात्मा तामुद्दिश्य महाबलः ।\nनिहता मृगलुब्धेन बाणेन निशितेन च॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000358026, "chapter_id": 20358, "verse_number": "२-३०-२७", "content_sanskrit": "प्रमृता सा मृगी तत्र बाणाभ्यां पापचेतसोः ।\nश्वभिर्दंतैः समाक्रांता त्वरमाणा पपात सा॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000358027, "chapter_id": 20358, "verse_number": "२-३०-२८", "content_sanskrit": "शिखराच्च ह्रदे पुण्ये रेवायाः पापनाशने ।\nश्वानश्च त्वरमाणास्ते पतिता विमले ह्रदे॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000358028, "chapter_id": 20358, "verse_number": "२-३०-२९", "content_sanskrit": "मृगव्याधो वदत्येव धीवरं क्रोधमूर्च्छितः ।\nमदीयेयं मृगी दुष्ट कस्माद्बाणैर्हता त्वया॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000358029, "chapter_id": 20358, "verse_number": "२-३०-३०", "content_sanskrit": "तमुवाच पुनः सोऽपि मीनहा मृगघातकम् ।\nमदीयेयं न संदेहो अवलिप्त प्रभाषसे॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000358030, "chapter_id": 20358, "verse_number": "२-३०-३१", "content_sanskrit": "युध्यमानौ ततस्तौ तु द्वावेतौ तु परस्परम् ।\nक्रोधलोभान्महाभागौ पतितौ विमले जले॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000358031, "chapter_id": 20358, "verse_number": "२-३०-३२", "content_sanskrit": "तस्मिन्काले महापर्व वर्तते गतिदायकम् ।\nअमावास्या समायोगं महापुण्यफलप्रदम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000358032, "chapter_id": 20358, "verse_number": "२-३०-३३", "content_sanskrit": "वेलायां पतिताः सर्वे पर्वणस्तस्य सत्तम ।\nजपध्यानविहीनास्ते भावसत्यविवर्जिताः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000358033, "chapter_id": 20358, "verse_number": "२-३०-३४", "content_sanskrit": "तीर्थस्नानप्रसंगेन मृगी श्वा च स लुब्धकः ।\nसर्वपापविनिर्मुक्तास्ते गताः परमां गतिम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000358034, "chapter_id": 20358, "verse_number": "२-३०-३५", "content_sanskrit": "तीर्थानां च प्रभावेण सतां संगाद्द्विजोत्तमाः ।\nनाशयेत्पापिनां पापं दहेदग्निरिवेंधनम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000358035, "chapter_id": 20358, "verse_number": "२-३०-३६", "content_sanskrit": "सूत उवाच ।\nतेषामेवं हि संसर्गादृषीणां च महात्मनाम् ।\nसंभाषाद्दर्शनान्नष्टं स्पर्शाच्चैव नृपस्य च॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000358036, "chapter_id": 20358, "verse_number": "२-३०-३७", "content_sanskrit": "वेनस्य कल्मषं नष्टं सतां संगात्पुरा किल ।\nअत्युग्रपुण्यसंसर्गात्पापं नश्यति पापिनाम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000358037, "chapter_id": 20358, "verse_number": "२-३०-३८", "content_sanskrit": "अत्युग्रपापिनां संगात्पापमेव प्रसंचरेत् ।\nमातामहस्य दोषेण संलिप्तो वेन एव सः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000358038, "chapter_id": 20358, "verse_number": "२-३०-३९", "content_sanskrit": "ऋषय ऊचुः ।\nमातामहस्य को दोषस्तं नो विस्तरतो वद ।\nस मृत्युः स च वै कालः स यमो धर्म एव च॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000358039, "chapter_id": 20358, "verse_number": "२-३०-४०", "content_sanskrit": "न हिंसको हि कस्यापि पदे तस्मिन्प्रतिष्ठितः ।\nचराचराश्च ये लोकाः स्वकर्मवशवर्तिनः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000358040, "chapter_id": 20358, "verse_number": "२-३०-४१", "content_sanskrit": "जीवंति च म्रियंते च भुंजंत्येवं स्वकर्मभिः ।\nपापाः पश्यंति तं घोरं तेषां कर्मविपाकतः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000358041, "chapter_id": 20358, "verse_number": "२-३०-४२", "content_sanskrit": "निरयेषु च सर्वेषु कर्मणैवं सुपुण्यवान् ।\nयोजयेत्ताडयेत्सूत यम एष दिनेदिने॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000358042, "chapter_id": 20358, "verse_number": "२-३०-४३", "content_sanskrit": "सर्वेष्वेव सुपुण्येषु कर्मस्वेवं सपुण्यवान् ।\nयोजयत्येव धर्मात्मा तस्य दोषो न दृश्यते॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000358043, "chapter_id": 20358, "verse_number": "२-३०-४४", "content_sanskrit": "स मृत्योः केन दोषेण पापी वेनस्त्वजायत ।\nसूत उवाच ।\nस मृत्युः शासको नित्यं पापानां दुष्टचेतसाम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000358044, "chapter_id": 20358, "verse_number": "२-३०-४५", "content_sanskrit": "वर्तते कालरूपेण तेषां कर्म विमृश्यति ।\nदुष्कृतं कर्म यस्यापि कर्मणा तेन घातयेत्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000358045, "chapter_id": 20358, "verse_number": "२-३०-४६", "content_sanskrit": "तस्य पापं विदित्वाऽसौ नयत्येवं हि तं यमः ।\nसुकृतात्मा लभेत्स्वर्गं कर्मणा सुकृतेन वै॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000358046, "chapter_id": 20358, "verse_number": "२-३०-४७", "content_sanskrit": "योजयत्येष तान्सर्वान्मृत्युरेव सुदूतकैः ।\nमहता सौख्यभावेन गीतमंगलकारिणा॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000358047, "chapter_id": 20358, "verse_number": "२-३०-४८", "content_sanskrit": "दानभोगादिभिश्चैव योजयेच्च कृतात्मकान् ।\nपीडाभिर्विविधाभिश्च क्लेशैः काष्ठैश्च दारुणैः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000358048, "chapter_id": 20358, "verse_number": "२-३०-४९", "content_sanskrit": "त्रासयेत्ताडयेद्विप्रान्स क्रोधो मृत्युरेव तान् ।\nकर्मण्येवं हि तस्यापि व्यापारः परिवर्तते॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000358049, "chapter_id": 20358, "verse_number": "२-३०-५०", "content_sanskrit": "मृत्योश्चापि महाभाग लोभात्पुण्यात्प्रजायते ।\nसुनीथा नाम वै कन्या संजातैषा महात्मनः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000358050, "chapter_id": 20358, "verse_number": "२-३०-५१", "content_sanskrit": "पितुःकर्म विमृश्यैव क्रीडमाना सदैव सा ।\nप्रजानां शास्ति कर्तारं पुण्यपापनिरीक्षणम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000358051, "chapter_id": 20358, "verse_number": "२-३०-५२", "content_sanskrit": "सा तु कन्या महाभागा सुनीथा नाम तस्य सा ।\nरममाणा वनं प्राप्ता सखीभिः परिवारिता॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000358052, "chapter_id": 20358, "verse_number": "२-३०-५३", "content_sanskrit": "तत्रापश्यन्महाभागं गंधर्वतनयं वरम् ।\nगीतकोलाहलस्यापि सुशंखं नाम सा तदा॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000358053, "chapter_id": 20358, "verse_number": "२-३०-५४", "content_sanskrit": "ददर्श चारुसर्वांगं तप्यंतं सुमहत्तपः ।\nगीतविद्यासु सिद्ध्यर्थं ध्यायमानं सरस्वतीम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000358054, "chapter_id": 20358, "verse_number": "२-३०-५५", "content_sanskrit": "तस्योपघातमेवासौ सा चकार दिने दिने ।\nसुशंखः क्षमते नित्यं गच्छगच्छेति सोऽब्रवीत्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000358055, "chapter_id": 20358, "verse_number": "२-३०-५६", "content_sanskrit": "प्रेषिता नैव गच्छेत्सा विघ्नमेव समाचरेत् ।\nतेनाप्युक्ता सा हि क्रुद्धा ताडयत्तपसि स्थितम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000358056, "chapter_id": 20358, "verse_number": "२-३०-५७", "content_sanskrit": "तामुवाच ततः क्रुद्धः सुशंखः क्रोधमूर्च्छितः ।\nदुष्टे पापसमाचारे कस्माद्विघ्नस्त्वया कृतः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000358057, "chapter_id": 20358, "verse_number": "२-३०-५८", "content_sanskrit": "ताडनात्ताडनं दुष्टे न कुर्वंति महाजनाः ।\nआक्रुष्टा नैव कुप्यंति इति धर्मस्य संस्थितिः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000358058, "chapter_id": 20358, "verse_number": "२-३०-५९", "content_sanskrit": "त्वयाहं घातितः पापे निर्दोषस्तपसान्वितः ।\nएवमुक्त्वा स धर्मात्मा सुनीथां पापचारिणीम्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000358059, "chapter_id": 20358, "verse_number": "२-३०-६०", "content_sanskrit": "विरराम महाक्रोधाज्ज्ञात्वा नारीं निवर्तितः ।\nततः सा पापमोहाद्वा बाल्याद्वा तमिहैव च॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000358060, "chapter_id": 20358, "verse_number": "२-३०-६१", "content_sanskrit": "समुवाच महात्मानं सुशंखं तपसि स्थितम् ।\nत्रैलोक्यवासिनां तातो ममैव परिघातकः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000358061, "chapter_id": 20358, "verse_number": "२-३०-६२", "content_sanskrit": "असतो घातयेन्नित्यं सत्यान्स परिपालयेत् ।\nनैव दोषो भवेत्तस्य महापुण्येन वर्तयेत्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000358062, "chapter_id": 20358, "verse_number": "२-३०-६३", "content_sanskrit": "एवमुक्त्वा गता सा तु पितरं वाक्यमब्रवीत् ।\nमया हि ताडितस्तात गंधर्वतनयो वने॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000358063, "chapter_id": 20358, "verse_number": "२-३०-६४", "content_sanskrit": "तपस्तपन्सदैकांते कामक्रोधविवर्जितः ।\nस मामुवाच धर्मात्मा क्रोधरागसमन्वितः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000358064, "chapter_id": 20358, "verse_number": "२-३०-६५", "content_sanskrit": "ताडयेन्नैव ताडंतं क्रोशंतं नैव क्रोशयेत् ।\nइत्युवाच स मां तात तन्मे त्वं कारणं वद॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000358065, "chapter_id": 20358, "verse_number": "२-३०-६६", "content_sanskrit": "एवमुक्तः स वै मृत्युः सुनीथां द्विजसत्तमाः ।\nकिंचिन्नोवाच धर्मात्मा प्रश्नप्रत्युत्तरं ततः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000358066, "chapter_id": 20358, "verse_number": "२-३०-६७", "content_sanskrit": "वनं प्राप्ता पुनः सा हि सुशंखो यत्र संस्थितः ।\nकराघातैस्ततो दौष्ट्याद्घातितस्तपतां वरः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000358067, "chapter_id": 20358, "verse_number": "२-३०-६८", "content_sanskrit": "सुशंखस्ताडितो विप्रा मृत्योश्चैव हि कन्यया ।\nततः क्रुद्धो महातेजाः शशाप तनुमध्यमाम्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000358068, "chapter_id": 20358, "verse_number": "२-३०-६९", "content_sanskrit": "निर्दोषो हि यतो दुष्टे त्वयैव परिताडितः ।\nअहमत्र वने संस्थस्तस्माच्छापं ददाम्यहम्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000358069, "chapter_id": 20358, "verse_number": "२-३०-७०", "content_sanskrit": "गार्हस्थ्यं च समास्थाय सह भर्त्रा यदा शृणु ।\nपापाचारमयः पुत्रो देवब्राह्मणनिंदकः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000358070, "chapter_id": 20358, "verse_number": "२-३०-७१", "content_sanskrit": "सर्वपापरतो दुष्टे तव गर्भे भविष्यति ।\nएवं शप्त्वा गतः सोपि तप एव समाश्रितः॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000358071, "chapter_id": 20358, "verse_number": "२-३०-७२", "content_sanskrit": "गते तस्मिन्महाभागे सा सुनीथा गृहं गता ।\nसमाचष्ट महात्मानं पितरं तप्तमानसा॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000358072, "chapter_id": 20358, "verse_number": "२-३०-७३", "content_sanskrit": "यथा शप्ता तदा तेन गंधर्वतनयेन सा ।\nतत्सर्वं संश्रुतं तेन मृत्युना परिभाषितम्॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000358073, "chapter_id": 20358, "verse_number": "२-३०-७४", "content_sanskrit": "कस्मात्कृतस्त्वयाघातस्तपति दोषवर्जिते ।\nयुक्तं नैव कृतं पुत्रि सत्यस्यैव हि ताडनम्॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000358074, "chapter_id": 20358, "verse_number": "२-३०-७५", "content_sanskrit": "एवमाभाष्य धर्मात्मा मृत्युः परमदुःखितः ।\nबभूव स हि तत्तस्यादिष्टमेवं विचिंतयन्॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000358075, "chapter_id": 20358, "verse_number": "२-३०-७६", "content_sanskrit": "सूत उवाच ।\nअत्रिपुत्रो महातेजा अंगो नाम प्रतापवान् ।\nएकदा तु गतो विप्रा नंदनं प्रति स द्विजः॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000358076, "chapter_id": 20358, "verse_number": "२-३०-७७", "content_sanskrit": "तत्र दृष्ट्वा देवराजं तमिंद्रं पाकशासनम् ।\nअप्सरसां गणैर्युक्तं गंधर्वैः किन्नरैस्तथा॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000358077, "chapter_id": 20358, "verse_number": "२-३०-७८", "content_sanskrit": "गीयमानं गीतगैश्च सुस्वरैः सप्तकैस्तथा ।\nवीज्यमानं सुगंधैश्च व्यजनैः सर्व एव सः॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000358078, "chapter_id": 20358, "verse_number": "२-३०-७९", "content_sanskrit": "योषिद्भी रूपयुक्ताभिश्चामरैर्हंसगामिभिः ।\nछत्रेण हंसवर्णेन चंद्रबिंबानुकारिणा॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000358079, "chapter_id": 20358, "verse_number": "२-३०-८०", "content_sanskrit": "राजमानं सहस्राक्षं सर्वाभरणभूषितम् ।\nकामक्रीडागतं देवं दृष्टवानमितौजसम्॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000358080, "chapter_id": 20358, "verse_number": "२-३०-८१", "content_sanskrit": "तस्य पार्श्वे महाभागां पौलोमीं चारुमंगलाम् ।\nरूपेण तेजसा चैव तपसा च यशस्विनीम्॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000358081, "chapter_id": 20358, "verse_number": "२-३०-८२", "content_sanskrit": "सौभाग्येन विराजंतीं पातिव्रत्येन तां सतीम् ।\nतया सह सहस्राक्षः स रेमे नंदने वने॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000358082, "chapter_id": 20358, "verse_number": "२-३०-८३", "content_sanskrit": "तस्य लीलां समालोक्य अंगश्चैव द्विजोत्तमः ।\nधन्यो वै देवराजोऽयमीदृशैः परिवारितः॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000358083, "chapter_id": 20358, "verse_number": "२-३०-८४", "content_sanskrit": "अहोऽस्य तपसो वीर्यं येन प्राप्तं महत्पदम् ।\nयदा ममेदृशः पुत्रः सर्वलोकप्रधारकः॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000358084, "chapter_id": 20358, "verse_number": "२-३०-८५", "content_sanskrit": "भवेत्तदा महत्सौख्यं प्राप्स्यामीह न संशयः ।\nइति चिंतापरो भूत्वा त्वरमाणो गृहागतः॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}]