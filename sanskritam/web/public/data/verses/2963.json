[{"id": 2092253, "chapter_id": 2963, "verse_number": "१३-९३-१", "content_sanskrit": "युधिष्ठिर उवाच।\nआरामाणां तटाकानां यत्फलं कुरुपुङ्गव।\nतदहं श्रोतुमिच्छामि त्वत्तोऽद्य भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2092254, "chapter_id": 2963, "verse_number": "१३-९३-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2092255, "chapter_id": 2963, "verse_number": "१३-९३-२", "content_sanskrit": "सुप्रदर्शा बलवती चित्रा धातुविभूषिता।\nउपेता सर्वभूतैश्च श्रेष्ठा भूमिरिहोच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2092256, "chapter_id": 2963, "verse_number": "१३-९३-३", "content_sanskrit": "तस्याः क्षेत्रविशेषाश्च तटाकानां च बन्धनम्।\nऔदकानि च सर्वाणि प्रवक्ष्याम्यनुपूर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2092257, "chapter_id": 2963, "verse_number": "१३-९३-४", "content_sanskrit": "तटाकानां च वक्ष्यामि कृतानां चापि ये गुणाः।\nत्रिषु लोकेषु सर्वत्र पूजनीयस्तटाकवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2092258, "chapter_id": 2963, "verse_number": "१३-९३-५", "content_sanskrit": "अथवा मित्रसदनं मैत्रं मित्रविवर्धनम्।\nकीर्तिसंजननं श्रेष्ठं तटाकानां निवेशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2092259, "chapter_id": 2963, "verse_number": "१३-९३-६", "content_sanskrit": "धर्मस्यार्थस्य कामस्य फलमाहुर्मनीषिणः।\nतटाकसुकृतं देशे क्षेत्रमेकं महाश्रयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2092260, "chapter_id": 2963, "verse_number": "१३-९३-७", "content_sanskrit": "चतुर्विधानां भूतानां तटाकमुपलक्षयेत्।\nतटाकानि च सर्वाणि दिशन्ति श्रियमुत्तमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2092261, "chapter_id": 2963, "verse_number": "१३-९३-८", "content_sanskrit": "देवा मनुष्यगन्धर्वाः पितरोरगराक्षसाः।\nस्थावराणि च भूतानि संश्रयन्ति जलाशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2092262, "chapter_id": 2963, "verse_number": "१३-९३-९", "content_sanskrit": "तस्मात्तांस्ते प्रवक्ष्यामि तटाके ये गुणाः स्मृताः।\nया च तत्र फलावाप्तिर्ऋषिभिः समुदाहृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2092263, "chapter_id": 2963, "verse_number": "१३-९३-१०", "content_sanskrit": "वर्षाकाले तटाके तु सलिलं यस्य तिष्ठति।\nअग्निहोत्रफलं तस्य फलमाहुर्मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2092264, "chapter_id": 2963, "verse_number": "१३-९३-११", "content_sanskrit": "शरत्काले तु सलिलं तटाके यस्य तिष्ठति।\nगोसहस्रस्य स प्रेत्य लभते फलमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2092265, "chapter_id": 2963, "verse_number": "१३-९३-१२", "content_sanskrit": "हेमन्तकाले सलिलं तटाके यस्य तिष्ठति।\nस वै बहुसुवर्णस्य यज्ञस्य लभते फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2092266, "chapter_id": 2963, "verse_number": "१३-९३-१३", "content_sanskrit": "यस्य वै शैशिरे काले तटाके सलिलं भवेत्।\nतस्याग्निष्टोमयज्ञस्य फलमाहुर्मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2092267, "chapter_id": 2963, "verse_number": "१३-९३-१४", "content_sanskrit": "तटाकं सुकृतं यस्य वसन्ते तु महाश्रयम्।\nअतिरात्रस्य यज्ञस्य फलं स समुपाश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2092268, "chapter_id": 2963, "verse_number": "१३-९३-१५", "content_sanskrit": "निदाघकाले पानीयं तटाके यस्य तिष्ठति।\nवाजिमेधफलं तस्य फलं वै मुनयो विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2092269, "chapter_id": 2963, "verse_number": "१३-९३-१६", "content_sanskrit": "स कुलं तारयेत्सर्वं यस्य खाते जलाशये।\nगावः पिबन्ति सलिलं साधवश्च नराः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2092270, "chapter_id": 2963, "verse_number": "१३-९३-१७", "content_sanskrit": "तटाके यस्य गावस्तु पिबन्ति तृषिता जलम्।\nमृगपक्षिमनुष्याश्च सोऽश्वमेधफलं लभेत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2092271, "chapter_id": 2963, "verse_number": "१३-९३-१८", "content_sanskrit": "यत्पिबन्ति जलं तत्र स्नायन्ते विश्रमन्ति च।\nतटाके यस्य तत्सर्वं प्रेत्यानन्त्याय कल्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2092272, "chapter_id": 2963, "verse_number": "१३-९३-१९", "content_sanskrit": "दुर्लभं सलिलं तात विशेषेण परत्र वै।\nपानीयस्य प्रदानेन प्रीतिर्भवति शाश्वती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2092273, "chapter_id": 2963, "verse_number": "१३-९३-२०", "content_sanskrit": "तिलान्ददत पानीयं दीपान्ददत जागृत।\nज्ञातिभिः सह मोदध्वमेतत्प्रेत्य सुदुर्लभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2092274, "chapter_id": 2963, "verse_number": "१३-९३-२१", "content_sanskrit": "सर्वदानैर्गुरुतरं सर्वदानैर्विशिष्यते।\nपानीयं नरशार्दूल तस्माद्दातव्यमेव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2092275, "chapter_id": 2963, "verse_number": "१३-९३-२२", "content_sanskrit": "एवमेतत्तटाकस्य कीर्तितं फलमुत्तमम्।\nअत ऊर्ध्वं प्रवक्ष्यामि वृक्षाणामवरोपणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2092276, "chapter_id": 2963, "verse_number": "१३-९३-२३", "content_sanskrit": "स्थावराणां च भूतानां जातयः षट् प्रकीर्तिताः।\nवृक्षगुल्मलतावल्ल्यस्त्वक्सारास्तृणजातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2092277, "chapter_id": 2963, "verse_number": "१३-९३-२४", "content_sanskrit": "एता जात्यस्तु वृक्षाणां तेषां रोपे गुणास्त्विमे।\nकीर्तिश्च मानुषे लोके प्रेत्य चैव फलं शुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2092278, "chapter_id": 2963, "verse_number": "१३-९३-२५", "content_sanskrit": "लभते नाम लोके च पितृभिश्च महीयते।\nदेवलोके गतस्यापि नाम तस्य न नश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2092279, "chapter_id": 2963, "verse_number": "१३-९३-२६", "content_sanskrit": "अतीतानागते चोभे पितृवंशं च भारत।\nतारयेद्वृक्षरोपी च तस्माद्वृक्षांश्च रोपयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2092280, "chapter_id": 2963, "verse_number": "१३-९३-२७", "content_sanskrit": "तस्य पुत्रा भवन्त्येते पादपा नात्र संशयः।\nपरलोकगतः स्वर्गं लोकांश्चाप्नोति सोऽव्ययान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2092281, "chapter_id": 2963, "verse_number": "१३-९३-२८", "content_sanskrit": "पुष्णैः सुरगणान्वृक्षाः फलैश्चापि तथा पितॄन्।\nधायया चातिथिं तात पूजयन्ति महीरुहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2092282, "chapter_id": 2963, "verse_number": "१३-९३-२९", "content_sanskrit": "किन्नरोरगरक्षांसि देवगन्धर्वमानवाः।\nतथा ऋषिगणाश्चैव संश्रयन्ति महीरुहान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2092283, "chapter_id": 2963, "verse_number": "१३-९३-३०", "content_sanskrit": "पुष्पिताः फलवन्तश्च तर्पयन्तीह मानवान्।\nवृक्षदं पुत्रवद्वृक्षास्तारयन्ति परत्र तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2092284, "chapter_id": 2963, "verse_number": "१३-९३-३१", "content_sanskrit": "तस्मात्तटाके सद्वृक्षा रोप्याः श्रेयोर्थिना सदा।\nपुत्रवत्परिपाल्याश्च पुत्रास्ते धर्मतः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2092285, "chapter_id": 2963, "verse_number": "१३-९३-३२", "content_sanskrit": "तटाककृद्वृक्षरोपी इष्टयज्ञश्च यो द्विजः।\nएते स्वर्गे महीयन्ते ये चान्ये सत्यवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2092286, "chapter_id": 2963, "verse_number": "१३-९३-३३", "content_sanskrit": "तस्मात्तटाकं कुर्वीत आरामांश्चैव रोपयेत्।\nयजेच्च विविधैर्यज्ञैः सत्यं च सततं वदेत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2092287, "chapter_id": 2963, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि त्रिनवतितमोऽध्यायः॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]