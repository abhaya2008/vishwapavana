[{"id": 7000351000, "chapter_id": 20351, "verse_number": "२-२३-१", "content_sanskrit": "ऋषय ऊचुः ।\nविचित्रेयं कथा पुण्या धन्या यशोविधायिनी ।\nसर्वपापहरा प्रोक्ता भवता वदतां वर॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000351001, "chapter_id": 20351, "verse_number": "२-२३-२", "content_sanskrit": "सृष्टिसंबंधमेतन्नस्तद्भवान्वक्तुमर्हति ।\nपूर्वमेव यथासृष्टिर्विस्तरात्सूतनंदन॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000351002, "chapter_id": 20351, "verse_number": "२-२३-३", "content_sanskrit": "सूत उवाच ।\nविस्तरेण प्रवक्ष्यामि सृष्टिसंहारकारणम् ।\nश्रुतमात्रेण यस्यापि नरः सर्वज्ञतां व्रजेत्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000351003, "chapter_id": 20351, "verse_number": "२-२३-४", "content_sanskrit": "हिरण्यकश्यपेनापि व्यापितं भुवनत्रयम् ।\nतपसाराध्य प्रबह्माणं वरं प्राप्तं सुदुर्लभम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000351004, "chapter_id": 20351, "verse_number": "२-२३-५", "content_sanskrit": "तस्माद्देवान्महाभागादमरत्वं तथैव च ।\nदेवांल्लोकान्स संव्याप्य प्रभुत्वं स्वयमर्जितम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000351005, "chapter_id": 20351, "verse_number": "२-२३-६", "content_sanskrit": "ततो देवाः सगंधर्वा मुनयो वेदपारगाः ।\nनागाश्च किन्नराः सिद्धा यक्षाश्चैव तथापरे॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000351006, "chapter_id": 20351, "verse_number": "२-२३-७", "content_sanskrit": "ब्रह्माणं तु पुरस्कृत्य जग्मुर्नारायणं प्रभुम् ।\nक्षीरसागरसंसुप्तं योगनिद्रां गतं प्रभुम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000351007, "chapter_id": 20351, "verse_number": "२-२३-८", "content_sanskrit": "तं संबोध्य महास्तोत्रैर्देवाः प्रांजलयस्तथा ।\nसंबुद्धे सति देवेशे वृत्तं तस्य दुरात्मनः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000351008, "chapter_id": 20351, "verse_number": "२-२३-९", "content_sanskrit": "आचचक्षुर्महाप्राज्ञ समाकर्ण्य जगत्पतिः ।\nनृसिंहरूपमास्थाय हिरण्यकशिपुं व्यहन्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000351009, "chapter_id": 20351, "verse_number": "२-२३-१०", "content_sanskrit": "पुनर्वाराहरूपेण हिरण्याक्षो महाबलः ।\nउद्धृता वसुधा पुण्या असुरो घातितस्तदा॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000351010, "chapter_id": 20351, "verse_number": "२-२३-११", "content_sanskrit": "अन्यांश्चघातयामास दानवान्घोरदर्शनान् ।\nएवं चैतेषु नष्टेषु दानवेषु महत्सु च॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000351011, "chapter_id": 20351, "verse_number": "२-२३-१२", "content_sanskrit": "अन्येषु तेषु नष्टेषु दितिपुत्रेषु वै तदा ।\nपुनः स्थानेषु प्राप्तेषु देवेषु च महत्सु च॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000351012, "chapter_id": 20351, "verse_number": "२-२३-१३", "content_sanskrit": "यज्ञेष्वेव प्रवृत्तेषु सर्वेषु धर्मकर्मसु ।\nसुस्थेषु सर्वलोकेषु सा दितिर्दुःखपीडिता॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000351013, "chapter_id": 20351, "verse_number": "२-२३-१४", "content_sanskrit": "पुत्रशोकेन संतप्ता हाहाभूता विचेतना ।\nभर्तारं सूर्यसंकाशं तपस्तेजः समन्वितम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000351014, "chapter_id": 20351, "verse_number": "२-२३-१५", "content_sanskrit": "दातारं च महात्मानं भर्तारं कश्यपं तदा ।\nभक्त्या प्रणम्य विप्रेन्द्र तमुवाच महामतिम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000351015, "chapter_id": 20351, "verse_number": "२-२३-१६", "content_sanskrit": "भगवन्नष्टपुत्राहं कृता देवेन चक्रिणा ।\nदैतेया दानवाः सर्वे देवैश्चैव निपातिताः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000351016, "chapter_id": 20351, "verse_number": "२-२३-१७", "content_sanskrit": "पुत्रशोकानलेनाहं संतप्ता मुनिसत्तम ।\nममानंदकरं पुत्रं सर्वतेजोहरं विभो॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000351017, "chapter_id": 20351, "verse_number": "२-२३-१८", "content_sanskrit": "सुबलं चारुसर्वांगं देवराजसमप्रभम् ।\nबुद्धिमंतं सुसर्वज्ञं ज्ञातारं सर्वपंडितम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000351018, "chapter_id": 20351, "verse_number": "२-२३-१९", "content_sanskrit": "तपस्तेजः समायुक्तं सबलं चारुलक्षणम् ।\nब्रह्मण्यं ज्ञानवेत्तारं देवब्राह्मणपूजकम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000351019, "chapter_id": 20351, "verse_number": "२-२३-२०", "content_sanskrit": "जेतारं सर्वलोकानां ममानंदकरं द्विज ।\nसर्वलक्षणसंपन्नं पुत्रं मे देहि त्वं विभो॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000351020, "chapter_id": 20351, "verse_number": "२-२३-२१", "content_sanskrit": "एवमाकर्ण्य वै तस्याः कश्यपो वाक्यमुत्तमम् ।\nकृपाविष्टमनास्तुष्टो दुःखिताया द्विजोत्तम॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000351021, "chapter_id": 20351, "verse_number": "२-२३-२२", "content_sanskrit": "तामुवाच महाभाग कृपणां दीनमानसाम् ।\nतस्याः शिरसि संन्यस्य स्वहस्तं भावतत्परः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000351022, "chapter_id": 20351, "verse_number": "२-२३-२३", "content_sanskrit": "भविष्यति महाभागे यादृशो वांछितः सुतः ।\nएवमुक्त्वा जगामासौ मेरुं गिरिवरोत्तमम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000351023, "chapter_id": 20351, "verse_number": "२-२३-२४", "content_sanskrit": "तपस्तेपे निरालंबः साधयन्परमव्रतः ।\nएतस्मिन्नंतरे सा तु दधार गर्भमुत्तमम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000351024, "chapter_id": 20351, "verse_number": "२-२३-२५", "content_sanskrit": "सा दितिः सर्वधर्मज्ञा चारुकर्मा मनस्विनी ।\nशतवर्षप्रमाणं सा शुचि स्वांता बभूव ह॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000351025, "chapter_id": 20351, "verse_number": "२-२३-२६", "content_sanskrit": "तया वै जनितः पुत्रो ब्रह्मतेजः समन्वितः ।\nअथ कश्यप आयातो हर्षेण महतान्वितः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000351026, "chapter_id": 20351, "verse_number": "२-२३-२७", "content_sanskrit": "चकार नाम मेधावी तस्य पुत्रस्य सत्तमः ।\nबलमित्यब्रवीत्पुत्रं नामतः सदृशो महान्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000351027, "chapter_id": 20351, "verse_number": "२-२३-२८", "content_sanskrit": "एवं नाम चकाराथ व्रतबंधं चकार सः ।\nप्राह पुत्र महाभाग ब्रह्मचर्यं प्रसाधय॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000351028, "chapter_id": 20351, "verse_number": "२-२३-२९", "content_sanskrit": "एवमेवं करिष्यामि तव वाक्यं द्विजोत्तम ।\nवेदस्याध्ययनं कुर्यां ब्रह्मचर्येण सत्तम॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000351029, "chapter_id": 20351, "verse_number": "२-२३-३०", "content_sanskrit": "एवं वर्षशतं साग्रं गतं तस्य तपस्यतः ।\nमातुः समक्षमायातस्तपस्तेजः समन्वितः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000351030, "chapter_id": 20351, "verse_number": "२-२३-३१", "content_sanskrit": "तपोवीर्यमयं दिव्यं ब्रह्मचर्यं महात्मनः ।\nदितिः पश्यति पुत्रस्य हर्षेण महतान्विता॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000351031, "chapter_id": 20351, "verse_number": "२-२३-३२", "content_sanskrit": "तमुवाच महात्मानं बलं पुत्रं तपस्विनम् ।\nमेधाविनं महात्मानं प्रज्ञाज्ञानविशारदम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000351032, "chapter_id": 20351, "verse_number": "२-२३-३३", "content_sanskrit": "त्वयि जीवति मेधाविन्प्रजीवंति सुता मम ।\nहिरण्यकशिपाद्यास्ते ये हताश्चक्रपाणिना॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000351033, "chapter_id": 20351, "verse_number": "२-२३-३४", "content_sanskrit": "वैरं साधय मे वत्स जहि देवान्रिपून्रणे ।\nसा दनुस्तमुवाचेदं बलं पुत्रं महाबलम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000351034, "chapter_id": 20351, "verse_number": "२-२३-३५", "content_sanskrit": "आदाविंद्रं हि देवेंद्रं द्रुतं सूदय पुत्रक ।\nपश्चाद्देवा निपात्यंतां ततो गरुडवाहनः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000351035, "chapter_id": 20351, "verse_number": "२-२३-३६", "content_sanskrit": "तयोराकर्ण्य सा देवी अदितिः पतिदेवता ।\nदुःखेन महताविष्टा पुत्रमिंद्रमभाषत॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000351036, "chapter_id": 20351, "verse_number": "२-२३-३७", "content_sanskrit": "दितिपुत्रो महाकायो वर्द्धते ब्रह्मतेजसा ।\nदेवानां हि वधार्थाय तपस्तेपे निरंजने॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000351037, "chapter_id": 20351, "verse_number": "२-२३-३८", "content_sanskrit": "एवं जानीहि देवेश यदि क्षेममिहेच्छसि ।\nएवमाकर्ण्य तद्वाक्यं स मातुः पाकशासनः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000351038, "chapter_id": 20351, "verse_number": "२-२३-३९", "content_sanskrit": "चिंतामवाप दुःखेन महतीं देवराट्तदा ।\nमहाभयेन संत्रस्तश्चिंतयामास वै ततः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000351039, "chapter_id": 20351, "verse_number": "२-२३-४०", "content_sanskrit": "कथमेनं हनिष्यामि देवधर्मविदूषकम् ।\nइति निश्चित्य देवेशो बलस्य निधनं प्रति॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000351040, "chapter_id": 20351, "verse_number": "२-२३-४१", "content_sanskrit": "एकदा हि बलः सोपि संध्यार्थं सिंधुमाश्रितः ।\nकृष्णाजिनेन दिव्येन दंडकाष्ठेन राजितः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000351041, "chapter_id": 20351, "verse_number": "२-२३-४२", "content_sanskrit": "अमलेनापि पुण्येन ब्रह्मचर्येण तेन सः ।\nसागरस्योपकंठे तं संध्यासनमुपागतम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000351042, "chapter_id": 20351, "verse_number": "२-२३-४३", "content_sanskrit": "जपमानं सुशांतं तं ददृशे पाकशासनः ।\nवज्रेण तेन दिव्येन ताडितो दितिनंदनः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000351043, "chapter_id": 20351, "verse_number": "२-२३-४४", "content_sanskrit": "बलं निपतितं दृष्ट्वा गतसत्वं गतं भुवि ।\nहर्षेण महताविष्टो देवराण्मुमुदे तदा॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000351044, "chapter_id": 20351, "verse_number": "२-२३-४५", "content_sanskrit": "एवं निपात्य तं दैत्यं दितिनंदनमेव च ।\nराज्यं चकार धर्मात्मा सुखेन पाकशासनः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]