[{"id": 2106000, "chapter_id": 3296, "verse_number": "१६-२५-१", "content_sanskrit": "वैशम्पायन उवाच।\nआज्ञापयामास ततः सेनां भरतसत्तमः।\nअर्जुनप्रमुखैर्गुप्तां लोकपालोपमैर्नरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2106001, "chapter_id": 3296, "verse_number": "१६-२५-२", "content_sanskrit": "योगोयोग इति प्रीत्या ततः शब्दो महानभूत्।\nक्रोशतां सादिनां तत्र युज्यतां युज्यतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2106002, "chapter_id": 3296, "verse_number": "१६-२५-३", "content_sanskrit": "केचिद्यानैर्नरा जग्मुः केचिदश्वैर्महाजवैः।\nकाञ्चनैश्च रथैः केचिज्ज्वलितज्वलनोपमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2106003, "chapter_id": 3296, "verse_number": "१६-२५-४", "content_sanskrit": "गजेन्द्रैश्च तथैवान्ये केचिदुष्ट्रैर्नराधिप।\nपदातयस्तथैवान्ये नखरप्रासयोधिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2106004, "chapter_id": 3296, "verse_number": "१६-२५-५", "content_sanskrit": "पौरजानपदाश्चैव यानैर्बहुविधैस्तथा।\nअन्वयुः कुरुराजानं धृतराष्ट्रं दिदक्षवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2106005, "chapter_id": 3296, "verse_number": "१६-२५-६", "content_sanskrit": "स चापि राजवचनादाचार्यो गौतमः कृपः।\nसेनामादाय सेनानीः प्रययावाश्रमं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2106006, "chapter_id": 3296, "verse_number": "१६-२५-७", "content_sanskrit": "ततो द्विजैः परिवृतः कुरुराजो युधिष्ठिरः।\nसंस्तूयमानो बहुभिः सूतमागधबन्दिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2106007, "chapter_id": 3296, "verse_number": "१६-२५-८", "content_sanskrit": "पाण्डुरेणातपत्रेण ध्रियमाणेन मूर्धनि।\nरतानीकेन महता निर्जगाम कुरूद्वहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2106008, "chapter_id": 3296, "verse_number": "१६-२५-९", "content_sanskrit": "गजैश्चाचलसंकाशैर्भीमकर्मा वृकोदरः।\nसज्जयन्त्रायुधोपेतैः प्रययौ पवनात्मजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2106009, "chapter_id": 3296, "verse_number": "१६-२५-१०", "content_sanskrit": "माद्रीपुत्रावपि तथा हयारोहौ सुसंवृतौ।\nजग्मतुः शीघ्रगमनौ सन्नद्धकवचध्वजौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2106010, "chapter_id": 3296, "verse_number": "१६-२५-११", "content_sanskrit": "अर्जुनश्च महातेजा रथेनादित्यवर्चसा।\nवशी श्वेतैर्हयैर्युक्तैर्दिव्येनान्वगमन्नृपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2106011, "chapter_id": 3296, "verse_number": "१६-२५-१२", "content_sanskrit": "द्रौपदीप्रमुखाश्चापि स्त्रीसङ्घाः शिबिकागताः।\nस्त्र्यध्यक्षगुप्ताः प्रययुर्विसृजन्तोऽमितं वसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2106012, "chapter_id": 3296, "verse_number": "१६-२५-१३", "content_sanskrit": "समृद्धरथहस्त्यश्वं वेणुवीणानुनादितम्।\nशुशुभे पाण्डवं सैन्यं तत्तदा भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2106013, "chapter_id": 3296, "verse_number": "१६-२५-१४", "content_sanskrit": "नदीतीरेषु रम्येषु सरःसु च विशाम्पते।\nवासान्कृत्वा क्रमेणाथ जग्मुस्ते कुरुपुङ्गवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2106014, "chapter_id": 3296, "verse_number": "१६-२५-१५", "content_sanskrit": "युयुत्सुश्च महातेजा धौम्यश्चैवि पुरोहितः।\nयुधिष्ठिरस्य वचनात्पुरगुप्तिं प्रचक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2106015, "chapter_id": 3296, "verse_number": "१६-२५-१६", "content_sanskrit": "ततो युधिष्ठिरो राजा कुरुक्षेत्रमवातरत्।\nक्रमोणोत्तीर्य यमुनां नदीं परमपाविनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2106016, "chapter_id": 3296, "verse_number": "१६-२५-१७", "content_sanskrit": "स ददर्शाश्रमं दूराद्राजर्षेस्तस्य धीमतः।\nशतयूपस्य कौरव्य धृतराष्ट्रस्य चैव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2106017, "chapter_id": 3296, "verse_number": "१६-२५-१८", "content_sanskrit": "ततः प्रमुदितः सर्वो जनस्तद्वनमञ्जसा।\nविवेश सुमहानादैरापूर्य भरतर्षभ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2106018, "chapter_id": 3296, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमिवासिकपर्वणि आश्रमिवासपर्वणि पञ्चविंशोऽध्यायः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]