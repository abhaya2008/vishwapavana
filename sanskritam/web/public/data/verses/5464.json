[{"id": 2208974, "chapter_id": 5464, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2208975, "chapter_id": 5464, "verse_number": "१", "content_sanskrit": "स मित्रसहमासाद्य त्वभिज्ञानमयाचत ।\nतस्मै ददावभिज्ञानं स चेक्ष्वाकुवरस्तदा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2208976, "chapter_id": 5464, "verse_number": "", "content_sanskrit": "सौदासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2208977, "chapter_id": 5464, "verse_number": "२", "content_sanskrit": "न चैवेषा गतिः क्षेम्या न चान्या विद्यते गतिः ।\nएतन्मे तत्त्वमाज्ञाय प्रयच्छ मणिकुण्डले ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2208978, "chapter_id": 5464, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2208979, "chapter_id": 5464, "verse_number": "३", "content_sanskrit": "इत्युक्तस्तामुदङ्कस्तु भर्तुर्वाक्यमथाब्रवीत् ।\nश्रुत्वा तु सा ततः प्रादात् तस्मै ते मणिकुण्डले ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2208980, "chapter_id": 5464, "verse_number": "४", "content_sanskrit": "अवाप्य कुण्डले ते तु राजानं पुनरब्रवीत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2208981, "chapter_id": 5464, "verse_number": "", "content_sanskrit": "उदङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2208982, "chapter_id": 5464, "verse_number": "५", "content_sanskrit": "किमेतद् गुह्यवचनं श्रोतुमिच्छामि ते वचः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2208983, "chapter_id": 5464, "verse_number": "", "content_sanskrit": "सौदासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2208984, "chapter_id": 5464, "verse_number": "६", "content_sanskrit": "प्रजातिसर्गाद् विप्रान् वै क्षत्रियाः पूजयन्ति ह ।\nविप्रेभ्यश्चापि बहवो दोषाः प्रादुर्भवन्ति नः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2208985, "chapter_id": 5464, "verse_number": "७", "content_sanskrit": "सोऽहं द्विजेभ्यः प्रणतो विप्राद् दोषमवाप्तवान् ।\nगतिमन्यां न पश्यामि मदयन्तीसहायवान् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2208986, "chapter_id": 5464, "verse_number": "८", "content_sanskrit": "न चान्यामपि पश्यामि गतिं गतिमतां वर ।\nस्वर्गद्वारस्य गमने स्थाने चेह द्विजोत्तम ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2208987, "chapter_id": 5464, "verse_number": "९", "content_sanskrit": "न हि राज्ञा विशेषेण विरुद्धेन द्विजातिभिः ।\nशक्यं त्रिलोके संस्थातुं प्रेत्य वा सुखमेधितुम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2208988, "chapter_id": 5464, "verse_number": "१०", "content_sanskrit": "तदिष्टेन मयैवैते दत्ते स्वे मणिकुण्डले ।\nयः कृतस्तेऽद्य समयः सफलं तं कुरुष्व मे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2208989, "chapter_id": 5464, "verse_number": "", "content_sanskrit": "उदङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2208990, "chapter_id": 5464, "verse_number": "११", "content_sanskrit": "राजंस्तथैव कर्तास्मि पुनरेष्यामि ते वशम् ।\nप्रश्नं च कञ्चित् प्रष्टुं त्वां व्यवसिष्ये परन्तप ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2208991, "chapter_id": 5464, "verse_number": "", "content_sanskrit": "सौदासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2208992, "chapter_id": 5464, "verse_number": "१२", "content_sanskrit": "ब्रूहि विप्र यथाकामं प्रतिवक्तास्मि ते वचः ।\nछेत्तास्मि संशयं तेऽहं न मेऽत्रास्ति विचारणा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2208993, "chapter_id": 5464, "verse_number": "", "content_sanskrit": "उदङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2208994, "chapter_id": 5464, "verse_number": "१३", "content_sanskrit": "प्राहुर्वाक्सङ्गमं मित्रं धर्मनैपुण्यदर्शिनः ।\nमित्रेषु यश्च विषमः स्तेन इत्येव तं विदुः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2208995, "chapter_id": 5464, "verse_number": "१४", "content_sanskrit": "स भवान् मित्रतामद्य सम्प्राप्तो मम पार्थिव ।\nस मे बुद्धिं प्रयच्छ त्वं युक्तां बुद्धिमतां वर ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2208996, "chapter_id": 5464, "verse_number": "१५", "content_sanskrit": "अवाप्तार्थोऽहमद्यास्मि भवांश्च पुरुषादकः ।\nभवत्सकाशमागन्तुं क्षमं मम न वेति वै ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2208997, "chapter_id": 5464, "verse_number": "", "content_sanskrit": "सौदासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2208998, "chapter_id": 5464, "verse_number": "१६", "content_sanskrit": "समश्चेदिह वक्तव्यं मया द्विजवरोत्तम ।\nमत्समीपं द्विजश्रेष्ठ नागन्तव्यं कथञ्चन ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2208999, "chapter_id": 5464, "verse_number": "१७", "content_sanskrit": "तवैव तु प्रपश्यामि श्रेयो भृगुकुलोद्वह ।\nआगच्छतो हि ते विप्र भवेन्मृत्युरसंशयः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2209000, "chapter_id": 5464, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2209001, "chapter_id": 5464, "verse_number": "१८", "content_sanskrit": "इत्युक्तः स तदा राज्ञा क्षमं बुद्धिसमाहितम् ।\nसमनुज्ञाप्य राजानमहल्यां प्रति जग्मिवान् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2209002, "chapter_id": 5464, "verse_number": "१९", "content_sanskrit": "गृहीत्वा कुण्डले दिव्ये गुरुपत्न्याः प्रियङ्करः ।\nजवेन महता प्रायाद् गौतमस्याश्रमं प्रति ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2209003, "chapter_id": 5464, "verse_number": "२०", "content_sanskrit": "यथा तथा रक्षणं च मदयन्त्याऽभिभाषितम् ।\nतथा ते कुण्डले बद्ध्वा तदा कृष्णाजिनेन तत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2209004, "chapter_id": 5464, "verse_number": "२१", "content_sanskrit": "स कस्मिंश्चित् क्षुधाऽऽविष्टः फलभारावनामितम् ।\nबिल्वं ददर्श तस्मिंश्चाप्यारुरोह क्षुधाऽन्वितः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2209005, "chapter_id": 5464, "verse_number": "२२", "content_sanskrit": "शाखास्वासज्य तस्यैव कृष्णाजिनमरिन्दम ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2209006, "chapter_id": 5464, "verse_number": "२३", "content_sanskrit": "यस्मिंस्ते कुण्डले बद्धे तदा द्विजवरेण वै ।\nविशीर्णबन्धने तस्मिन् गते कृष्णाजिने महीम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2209007, "chapter_id": 5464, "verse_number": "२४", "content_sanskrit": "अपश्यद् भुजगः कश्चित् ते तत्र मणिकुण्डले ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2209008, "chapter_id": 5464, "verse_number": "२५", "content_sanskrit": "ऐरावतकुलोद्भूतः शीघ्रो भूत्वा तदा स वै ।\nविगृह्यास्येन वल्मीकं विवेशाथ सकुण्डलः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2209009, "chapter_id": 5464, "verse_number": "२६", "content_sanskrit": "ह्रियमाणे स दृष्ट्वा तु कुण्डले पन्नगेन तु ।\nपपात वृक्षात् सोद्वेगो दुःखात् परमकोपनः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2209010, "chapter_id": 5464, "verse_number": "२७", "content_sanskrit": "स दण्डकाष्ठमादाय वल्मीकं न्यखनन् तदा ।\nअहानि त्रिंशदव्यग्रः पञ्च चान्यानि भारत ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2209011, "chapter_id": 5464, "verse_number": "२८", "content_sanskrit": "क्रोधामर्षाभितप्ताङ्गस्ततो वै द्विजसत्तमः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2209012, "chapter_id": 5464, "verse_number": "२९", "content_sanskrit": "तस्य वेगमसह्यं तमसहन्ती वसुन्धरा ।\nदण्डकाष्ठाभिनुन्नाङ्गी चचाल भृशमातुरा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2209013, "chapter_id": 5464, "verse_number": "३०", "content_sanskrit": "ततः खनत एवास्य विप्रर्षेर्धरणीतळम् ।\nनागलोकस्य पन्थानं कामयानस्य निश्चयात् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2209014, "chapter_id": 5464, "verse_number": "३१", "content_sanskrit": "रथेन हरियुक्तेन तं देशमभिजग्मिवान् ।\nवज्रपाणिर्महातेजा ददर्शाथ द्विजोत्तमम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2209015, "chapter_id": 5464, "verse_number": "३२", "content_sanskrit": "स तत्र ब्राह्मणो भूत्वा तस्य दुःखेन दुःखितः ।\nउदङ्कमब्रवीत् तात नैतच्छक्यं त्वयेति वै ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2209016, "chapter_id": 5464, "verse_number": "३३", "content_sanskrit": "इतोऽस्ति नागलोको वै योजनानि सहस्रशः ।\nन दण्डकाष्ठसाध्यं च मन्ये कार्यमिदं तव ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2209017, "chapter_id": 5464, "verse_number": "", "content_sanskrit": "उदङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2209018, "chapter_id": 5464, "verse_number": "३४", "content_sanskrit": "नागलोकाद् यदि ब्रह्मन् न शक्ये कुण्डले मया ।\nप्राप्तुं प्राणान् विमोक्ष्यामि पश्यतस्ते द्विजोत्तम ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2209019, "chapter_id": 5464, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2209020, "chapter_id": 5464, "verse_number": "३५", "content_sanskrit": "यदा स नाशकत् तस्य निश्चयं कर्तुमन्यथा ।\nवज्रपाणिस्तदा दण्डं वज्रास्त्रेण युयोज ह ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2209021, "chapter_id": 5464, "verse_number": "३६", "content_sanskrit": "ततो वज्रप्रहारैस्तैर्दार्यमाणा वसुन्धरा ।\nनागलोकस्य पन्थानमकरोज्जनमेजय ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2209022, "chapter_id": 5464, "verse_number": "३७", "content_sanskrit": "स तेन मार्गेण तदा नागलोकं विवेश ह ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2209023, "chapter_id": 5464, "verse_number": "३८", "content_sanskrit": "ददर्श नागलोकं च योजनानि सहस्रशः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2209024, "chapter_id": 5464, "verse_number": "३९", "content_sanskrit": "प्राकारनिचयैर्दिव्यैर्मणिमुक्ताद्यलङ्कृतैः ।\nउपपन्नं महाभाग शातकुम्भमयैस्तथा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2209025, "chapter_id": 5464, "verse_number": "४०", "content_sanskrit": "वापीः स्फटिकसोपाना नदीश्च विमलोदकाः ।\nददर्श वृक्षांश्च बहून् नानाद्विजगणायुतान् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2209026, "chapter_id": 5464, "verse_number": "४१", "content_sanskrit": "नागलोकस्य विवरं स ददर्श भृगूद्वहः ।\nपञ्चयोजनविस्तारमायतं शतयोजनम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2209027, "chapter_id": 5464, "verse_number": "४२", "content_sanskrit": "नागलोकमुदङ्कस्तु प्रेक्ष्य दीनोऽभवत् तदा ।\nनिराशश्चाभवत् तत्र कुण्डलाहरणे ततः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2209028, "chapter_id": 5464, "verse_number": "४३", "content_sanskrit": "तत्र प्रोवाच तुरगस्तं कृष्णश्वेतवालधिः ।\nताम्रास्यनेत्रः कौरव्य प्रज्वलन्निव तेजसा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2209029, "chapter_id": 5464, "verse_number": "", "content_sanskrit": "अश्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2209030, "chapter_id": 5464, "verse_number": "४४", "content_sanskrit": "धम ह्यपानमेतन्मे ततस्त्वं विप्र लप्स्यसे ।\nऐरावतसुतेनेह तवानीते हि कुण्डले ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2209031, "chapter_id": 5464, "verse_number": "४५", "content_sanskrit": "मा जुगुप्सां कृथाः पुत्र त्वमत्रार्थे कथञ्चन ।\nआसेवितस्त्वयैतद्धि गौतमस्याश्रमे तदा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2209032, "chapter_id": 5464, "verse_number": "", "content_sanskrit": "उदङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2209033, "chapter_id": 5464, "verse_number": "४६", "content_sanskrit": "कथं भवन्तं जानीयामुपाध्यायाश्रमं प्रति ।\nतन्मया चीर्णपूर्वं च श्रोतुमिच्छामि तत्त्वतः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2209034, "chapter_id": 5464, "verse_number": "", "content_sanskrit": "अश्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2209035, "chapter_id": 5464, "verse_number": "४७", "content_sanskrit": "गुरोर्गुरुं मां जानीहि ज्वलितं जातवेदसम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2209036, "chapter_id": 5464, "verse_number": "४८", "content_sanskrit": "त्वया ह्यहं सदा वत्स गुरोरर्थे तपोधन ।\nसततं पूजितो विप्र शुचिना भृगुसत्तम ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2209037, "chapter_id": 5464, "verse_number": "४९", "content_sanskrit": "ततः श्रेयो विधास्यामि तवैव कुरु मा चिरम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2209038, "chapter_id": 5464, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2209039, "chapter_id": 5464, "verse_number": "५०", "content_sanskrit": "इत्युक्तः स तथाऽकार्षीद् उदङ्कश्चित्रभानुना ।\nघृतार्चिः प्रीतिमांश्चापि प्रजज्वाल दिधक्षया ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2209040, "chapter_id": 5464, "verse_number": "५१", "content_sanskrit": "ततोऽस्य रोमकूपेभ्यो ध्यायमानस्य भारत ।\nघनः प्रादुरभूद् धूमो नागलोकभयावहः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2209041, "chapter_id": 5464, "verse_number": "५२", "content_sanskrit": "तेन धूमेन सहसा वर्धमानेन भारत ।\nनागलोके महाराज न प्राज्ञायत किञ्चन ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2209042, "chapter_id": 5464, "verse_number": "५३", "content_sanskrit": "हाहाकृतमभूत् सर्वमैरावतनिवेशनम् ।\nवासुकिप्रमुखानां च नागानां जनमेजय ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2209043, "chapter_id": 5464, "verse_number": "५४", "content_sanskrit": "न प्राकाशन्त वेश्मानि धूमरुद्धानि सर्वशः ।\nनीहारसंवृतानीव वनानि गिरयस्तदा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2209044, "chapter_id": 5464, "verse_number": "५५", "content_sanskrit": "ते धूमरक्तनयना वह्नितेजोभितापिताः ।\nआजग्मुर्निश्चयं ज्ञातुं भार्गवस्यातितेजसः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2209045, "chapter_id": 5464, "verse_number": "५६", "content_sanskrit": "श्रुत्वा तु निश्चयं तस्य महर्षेस्तिग्मतेजसः ।\nसम्भ्रान्तमनसः सर्वे पूजां चक्रुर्यथाविधि ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2209046, "chapter_id": 5464, "verse_number": "५७", "content_sanskrit": "सर्वे प्राञ्जलयो नागा बालवृद्धपुरोगमाः ।\nशिरोभिः प्रणिपत्योचुः प्रसीद भगवन्निति ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2209047, "chapter_id": 5464, "verse_number": "५८", "content_sanskrit": "प्रसाद्य ब्राह्मणं ते तु पाद्यमर्घ्यं निवेद्य च ।\nप्रायच्छत् कुण्डले दिव्ये पन्नगाः परमार्चिते ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2209048, "chapter_id": 5464, "verse_number": "५९", "content_sanskrit": "ततः स पूजितो नागैः तदोदङ्कः प्रतापवान् ।\nअग्निं प्रदक्षिणं कृत्वा जगाम गुरुसद्म तत् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2209049, "chapter_id": 5464, "verse_number": "६०", "content_sanskrit": "स गत्वा त्वरितो राजन् गौतमस्य निवेशनम् ।\nप्रायच्छत् कुण्डले दिव्ये गुरुपत्न्यास्तदाऽनघ ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2209050, "chapter_id": 5464, "verse_number": "६१", "content_sanskrit": "एवं लोकद्वयं तेन विप्रेण जनमेजय ।\nपरिक्रम्याहृते दिव्ये ततस्ते मणिकुण्डले ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2209051, "chapter_id": 5464, "verse_number": "६२", "content_sanskrit": "एवंप्रभावः स मुनिरुदङ्को भरतर्षभ ।\nपरेण तपसा युक्तो यन्मां त्वं परिपृच्छसि ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2209052, "chapter_id": 5464, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि उदङ्कोपाख्याने कुण्डलाहरणप्रकारकथनं नाम अष्टपञ्चाशोऽध्यायः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2209053, "chapter_id": 5464, "verse_number": "", "content_sanskrit": "॥ उदङ्कोपाख्यानं समाप्तम् ॥(??)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]