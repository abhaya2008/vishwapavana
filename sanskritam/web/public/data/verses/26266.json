[{"id": 7006266000, "chapter_id": 26266, "verse_number": "३-२०-१", "content_sanskrit": "हयग्रीव उवाच किरिचक्ररथेन्द्रस्य पञ्चपर्वसमाश्रिताः ।\nदेवताश्च शृणु प्राज्ञ नाम यच्छृण्वतां जयः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006266001, "chapter_id": 26266, "verse_number": "३-२०-२", "content_sanskrit": "प्रथमं पर्वबिन्द्वाख्यं संप्राप्ता दण्डनायिका ।\nसा तत्र जगदुद्दण्डकण्टकव्रातघस्मरी ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006266002, "chapter_id": 26266, "verse_number": "३-२०-३", "content_sanskrit": "नानाविधाभिर्ज्वालाभिर्नर्तयन्ती जयश्रियम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006266003, "chapter_id": 26266, "verse_number": "३-२०-४", "content_sanskrit": "उद्दण्डपोत्रनिर्घातनिर्भिन्नोद्धतदानवाः ।\nदंष्ट्राबालमृगाङ्कांशुविभावनविभावरी ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006266004, "chapter_id": 26266, "verse_number": "३-२०-५", "content_sanskrit": "प्रावृषेण्यपयोवाहव्यूहनीलवपुर्ल्लता ।\nकिरिचक्ररथेन्द्रस्य सालङ्कारायते सदा ।\nपोत्रिणी पुत्रिताशेषविश्वावर्तकदंबिका ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006266005, "chapter_id": 26266, "verse_number": "३-२०-६", "content_sanskrit": "तस्यैव रथनाभस्य द्वितीयं पर्व संश्रिताः ।\nजृंभिनी मोहिनी चैव स्तंभिनी तिस्र एव हि ।\nउत्फुल्लदाडिमीप्रख्यं सर्वदानवमर्दनाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006266006, "chapter_id": 26266, "verse_number": "३-२०-७", "content_sanskrit": "मुसलं च हलं हालापात्रं मणिगणर्पितम् ।\nज्वलन्माणिक्यवलयैर्बि भ्राणाः पाणिपल्लवैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006266007, "chapter_id": 26266, "verse_number": "३-२०-८", "content_sanskrit": "अतितीक्ष्णकरालाक्ष्यो ज्वालाभिर्दैत्यसैनिकान् ।\nदहन्त्य इव निःशङ्कं सेवन्ते सूकराननाम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006266008, "chapter_id": 26266, "verse_number": "३-२०-९", "content_sanskrit": "किरिचक्ररथेन्द्रस्य तृतीयं पर्व संश्रिताः ।\nअन्धिन्याद्याः पञ्च देव्यो देवीयन्त्रकृतास्पदाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006266009, "chapter_id": 26266, "verse_number": "३-२०-१०", "content_sanskrit": "कठोरेणाट्टहासेन भिन्दन्त्यो भुवनत्रयम् ।\nज्वाला इव तु कल्पग्नेरङ्गनावेषमाश्रिताः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006266010, "chapter_id": 26266, "verse_number": "३-२०-११", "content_sanskrit": "भण्डासुरस्य सर्वेषां सैन्यानां रुधिरप्लुतिम् ।\nलिलिक्षमाणा जिह्वाभिर्लेलिहानाभिरुज्ज्वलाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006266011, "chapter_id": 26266, "verse_number": "३-२०-१२", "content_sanskrit": "सेवन्तें सततं दण्डनाथामुद्दण्डविक्रमाम् ।\nकिरिचक्ररथेन्द्रस्य चतुर्थं पर्व संश्रिताः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006266012, "chapter_id": 26266, "verse_number": "३-२०-१३", "content_sanskrit": "ब्रह्माद्याः पञ्चमीवर्ज्या अष्टमीरवर्जिता अपि ।\nषडेव देव्यः षट्चक्रज्वलज्ज्वालाकलेवराः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006266013, "chapter_id": 26266, "verse_number": "३-२०-१४", "content_sanskrit": "महता विक्रमौघेण विबन्त्य इव दानवान् ।\nआज्ञया दण्डनाथायास्तं प्रदेशमुपासते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006266014, "chapter_id": 26266, "verse_number": "३-२०-१५", "content_sanskrit": "तस्यैव पर्वणोऽधस्तात्त्वरिताः स्थानमाश्रिताः ।\nयक्षिणी शङ्खिनी चैव लाकिनी हाकिनी तथा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006266015, "chapter_id": 26266, "verse_number": "३-२०-१६", "content_sanskrit": "शाकिनी डाकिनी चैव तासामैक्यस्वरूपिणी ।\nहाकिनी सप्तमीत्येताश्चण्डदोर्दण्डविक्रमाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006266016, "chapter_id": 26266, "verse_number": "३-२०-१७", "content_sanskrit": "पिबन्त्य इव भूतानि पिबन्त्य इव मेदिनीम् ।\nत्वचं रक्तं तथा मांसं मेदोऽस्थि च विरोधिनाम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006266017, "chapter_id": 26266, "verse_number": "३-२०-१८", "content_sanskrit": "मज्जानमथ शुक्रं च पिबन्तयो विकटाननाः ।\nनिष्ठुरैः सिंहनादैश्च पूरयन्त्यो दिशो दश ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006266018, "chapter_id": 26266, "verse_number": "३-२०-१९", "content_sanskrit": "धातुनाथा इति प्रोक्ता अणिमाद्यष्टसिद्धिदाः ।\nमोहने मारणे चैव स्तंभने ताडने तथा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006266019, "chapter_id": 26266, "verse_number": "३-२०-२०", "content_sanskrit": "भक्षणे दुष्टदैत्यानामामूलं च निकृन्तने ।\nपण्डिताः खण्डिताशेषविपदो भक्तिशालिषु ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006266020, "chapter_id": 26266, "verse_number": "३-२०-२१", "content_sanskrit": "धातुनाथा इतिप्रोक्ताः सर्वधातुषु संस्थिताः ।\nसप्तापि वारिधीनूर्मिमालासंचुंबितांबरान् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006266021, "chapter_id": 26266, "verse_number": "३-२०-२२", "content_sanskrit": "क्षणर्धेनैव निष्पातुं निष्पन्नबहुसाहसाः ।\nशकटा कारदन्ताश्च भयङ्करविलोचनाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006266022, "chapter_id": 26266, "verse_number": "३-२०-२३", "content_sanskrit": "स्वस्वामिनीद्रोहकृतां स्वकीयसमयद्रुहाम् ।\nवैदिकद्रोहणादेव द्रोहिणां वीरवैरिणाम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006266023, "chapter_id": 26266, "verse_number": "३-२०-२४", "content_sanskrit": "यज्ञद्रोहकृतां दुष्टदैत्यानां भक्षणे समाः ।\nनित्यमेव च सेवन्ते पोत्रिणीं दण्डनायिकाम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006266024, "chapter_id": 26266, "verse_number": "३-२०-२५", "content_sanskrit": "तस्यैव पर्वणः पार्श्वे द्वितीये दिव्यमन्दिरे ।\nक्रोधिनी स्तंभिनी ख्याते वर्तेते देवते उभे ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006266025, "chapter_id": 26266, "verse_number": "३-२०-२६", "content_sanskrit": "चामरे वीजयन्त्यौ च लोलकङ्कणदोर्लते ।\nदेवद्विषां चमूरक्तहालापानमहोद्धते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006266026, "chapter_id": 26266, "verse_number": "३-२०-२७", "content_sanskrit": "सदा विघूर्णमानाक्ष्यौ सदा प्रहसितानने ।\nअथ तस्य रथेन्द्रस्य किरिचक्राश्रितस्य च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006266027, "chapter_id": 26266, "verse_number": "३-२०-२८", "content_sanskrit": "पार्श्वद्वयकृतावासमायुधद्वन्द्वमुत्तमम् ।\nहलं च मुसलं चैव देवतारूपमास्थितम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006266028, "chapter_id": 26266, "verse_number": "३-२०-२९", "content_sanskrit": "स्वकीयमुकुटस्थाने स्वकीयायुधविग्रहम् ।\nआबिभ्राणं जग षिघस्मरं विबुधैः स्मृतम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006266029, "chapter_id": 26266, "verse_number": "३-२०-३०", "content_sanskrit": "एतदायुधयुग्मेन ललिता दडनायिका ।\nखण्डयिष्यति संग्रामं विषङ्गं नामदानहम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006266030, "chapter_id": 26266, "verse_number": "३-२०-३१", "content_sanskrit": "तस्यैव पर्वणो दण्डनाथाया अग्रसीमनि ।\nवर्त्तमानो महाभीमः सिंहो नादैर्ध्वनन्नभः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006266031, "chapter_id": 26266, "verse_number": "३-२०-३२", "content_sanskrit": "दंष्ट्राकटकटात्कार बधिरीकृतदिङ्मुखः ।\nचण्डोच्चण्ड इति ख्यातश्चतुर्हस्तस्त्रिलोचनः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006266032, "chapter_id": 26266, "verse_number": "३-२०-३३", "content_sanskrit": "शूलखड्गप्रेतपाशान्दधानो दीप्तविग्रहः ।\nसदा संसेवते देवीं पश्यन्नेव हि पोत्रिणीम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006266033, "chapter_id": 26266, "verse_number": "३-२०-३४", "content_sanskrit": "किरिचक्ररथेन्द्रस्य षष्टं पर्व समाश्रिताः ।\nवार्त्ताल्याद्या अष्ट देव्यो दिक्ष्वष्टासूपविश्रुताः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006266034, "chapter_id": 26266, "verse_number": "३-२०-३५", "content_sanskrit": "अष्टपर्वतनिष्पातघोरनिर्घातनिःस्वनाः ।\nअष्टनागस्फुरद्भूषा अनष्टबलतेजसः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006266035, "chapter_id": 26266, "verse_number": "३-२०-३६", "content_sanskrit": "प्रकृष्टदोष्प्रकाण्डोष्महुतदानवकोटयः ।\nसेवन्ते ललितां देव्यो दण्डनाथामहर्निशम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006266036, "chapter_id": 26266, "verse_number": "३-२०-३७", "content_sanskrit": "तासामाख्याश्च विख्याताः समाकर्णय कुंभज ।\nवार्ताली चैव वाराहीसा वाराहमुखी परा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006266037, "chapter_id": 26266, "verse_number": "३-२०-३८", "content_sanskrit": "अन्धिनी रोधिनी चैव जृंभिणी चैव मोहिनी ।\nस्तंभिनीति रिपुक्षोभस्तंभनोच्चाटनक्षमाः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006266038, "chapter_id": 26266, "verse_number": "३-२०-३९", "content_sanskrit": "तासां च पर्वणो वामभागे सततसंस्थितिः ।\nदण्डनाथोपवाह्यस्तु कासरो धूसराकृतिः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006266039, "chapter_id": 26266, "verse_number": "३-२०-४०", "content_sanskrit": "अर्धक्रोशायतः शृङ्गद्वितये क्रोशविग्रहः ।\nखड्गवन्निष्ठुरैर्लोमजातैः संवृतविग्रहः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006266040, "chapter_id": 26266, "verse_number": "३-२०-४१", "content_sanskrit": "कालदण्डवदुच्चण्डबालकाण्डभयङ्करः ।\nनीलाञ्जनाचलप्रख्यो विकटोन्नतरुष्टभूः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006266041, "chapter_id": 26266, "verse_number": "३-२०-४२", "content_sanskrit": "महानीलगिरिश्रेष्ठगरिष्ठस्कन्धमण्डलः ।\nप्रभूतोष्मलनिश्वासप्रसराकंपितांबुधिः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006266042, "chapter_id": 26266, "verse_number": "३-२०-४३", "content_sanskrit": "घर्घरध्वनिना कालमहिषं विहसन्निव ।\nवर्त्तते खुरविक्षिप्तपुष्कलावर्तवारिदः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006266043, "chapter_id": 26266, "verse_number": "३-२०-४४", "content_sanskrit": "तस्यैव पर्वणोऽधस्ताच्चित्रस्थानकृतालयाः ।\nइन्द्रादयोऽनेकभेदा दिशामष्टकदेवताः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006266044, "chapter_id": 26266, "verse_number": "३-२०-४५", "content_sanskrit": "ललितायां कार्यसिद्धिं विज्ञापयितुमागताः ।\nइन्द्रश्चाप्सरसश्चैव स चतुष्षष्टिकोटयः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006266045, "chapter_id": 26266, "verse_number": "३-२०-४६", "content_sanskrit": "सिद्ध अग्निश्च साध्याश्च विश्वेदेवास्तथापरे ।\nविश्वकर्मा मयश्चैव मातरश्च बलोन्नताः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006266046, "chapter_id": 26266, "verse_number": "३-२०-४७", "content_sanskrit": "रुद्राश्च परिचाराश्च रुद्राश्चैव पिशाचकाः ।\nक्रन्दञ्चिरक्षसां नाथा राक्षसा बहवस्तथा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006266047, "chapter_id": 26266, "verse_number": "३-२०-४८", "content_sanskrit": "मित्राश्च तत्र गन्धर्वाः सदा गानविशारदाः ।\nविश्वावसुप्रभृतयो विख्यातास्तत्पुरोगमाः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006266048, "chapter_id": 26266, "verse_number": "३-२०-४९", "content_sanskrit": "तथा भूतगणाश्चान्ये वरुणो वासवः परे ।\nविद्याधराः किन्नराश्च मारुतेश्वर एव च ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006266049, "chapter_id": 26266, "verse_number": "३-२०-५०", "content_sanskrit": "तथा चित्ररथश्चैव रथकारक कारकाः ।\nतुंबुरुर्नारदो यक्षः सोमोयक्षेश्वरस्तथा ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006266050, "chapter_id": 26266, "verse_number": "३-२०-५१", "content_sanskrit": "देवैश्च भगवांस्तत्र गोविन्दः कमलापतिः ।\nईशानश्च जगच्चक्रभक्षकः शूलभीषणः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006266051, "chapter_id": 26266, "verse_number": "३-२०-५२", "content_sanskrit": "ब्रह्मा चैवाश्विनीपुत्रो वैद्यविद्याविशारदौ ।\nधन्वन्तरिश्च भगवानथान्ये गणनायकाः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006266052, "chapter_id": 26266, "verse_number": "३-२०-५३", "content_sanskrit": "कटकाण्डगलद्दान संतर्पितमधुव्रताः ।\nअनन्तो वासुकिस्तक्षः कर्केटः पद्म एव च ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006266053, "chapter_id": 26266, "verse_number": "३-२०-५४", "content_sanskrit": "महापद्मः शङ्खपालो गुलिकः सुबलस्तथा ।\nएते नागेश्वराश्चैव नागकोटिभिरावृताः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006266054, "chapter_id": 26266, "verse_number": "३-२०-५५", "content_sanskrit": "एवंप्रकारा बहवो देवतास्तत्र जाग्रति ।\nपूर्वादिदिशमारभ्य परितः कृतमन्दिराः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006266055, "chapter_id": 26266, "verse_number": "३-२०-५६", "content_sanskrit": "तत्रैव देवताश्चक्रे चक्राकारा मरुद्दिशः ।\nआश्रित्य किल वर्तन्ते तदधिष्ठातृदेवताः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006266056, "chapter_id": 26266, "verse_number": "३-२०-५७", "content_sanskrit": "जृंभिणी स्तंभिनी चैव मोहिनी तिस्र एव च ।\nतस्यैव पर्वणः प्रान्ते किरिचक्रस्य भास्वतः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006266057, "chapter_id": 26266, "verse_number": "३-२०-५८", "content_sanskrit": "कपालं च गदां बिभ्रदूर्ध्वकेशो महावपुः ।\nपातालतलजंबालबहुला कारकालिमा ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006266058, "chapter_id": 26266, "verse_number": "३-२०-५९", "content_sanskrit": "अट्टहासमहावज्रदीर्णब्रह्माण्डमण्डलः ।\nभिन्दन्डमरुकध्वानै रोदसीकन्दरोदरम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006266059, "chapter_id": 26266, "verse_number": "३-२०-६०", "content_sanskrit": "फूत्कारीत्रिपुरायुक्तं फणिपाशं करे वहन् ।\nक्षेत्रपालः सदा भाति सेवमानः किटीश्वरीम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006266060, "chapter_id": 26266, "verse_number": "३-२०-६१", "content_sanskrit": "तस्यैव च समीपस्थस्तस्या वाहनकेसरी ।\nयमा रुह्य प्रववृते भण्टासुरबधैषिणी ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006266061, "chapter_id": 26266, "verse_number": "३-२०-६२", "content_sanskrit": "प्रागुक्तमेव देवेशीवाहसिंहस्य लक्षण्म् ।\nतस्यैव पर्वणोऽधस्ताद्दण्डनाथासमत्विषः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006266062, "chapter_id": 26266, "verse_number": "३-२०-६३", "content_sanskrit": "दण्डिनीसदृशाशेषभूषणायुधमण्डिताः ।\nशम्याः क्रोडाननाश्चन्द्ररेखोत्तंसितकुन्तलाः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006266063, "chapter_id": 26266, "verse_number": "३-२०-६४", "content_sanskrit": "हलं च मुसलं हस्ते घूर्णयन्त्यो मुहुर्मुहुः ।\nललिताद्रोहिणां श्यामाद्रोहिणां स्वामिनीद्रुहाम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006266064, "chapter_id": 26266, "verse_number": "३-२०-६५", "content_sanskrit": "रक्तस्रोतोभिरुत्कूलैः पूरयन्त्यः कपालकम् ।\nनिजभक्तद्रोहकृता मन्त्रमालाविभूषणाः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006266065, "chapter_id": 26266, "verse_number": "३-२०-६६", "content_sanskrit": "स्वगोष्ठीसमायाक्षेपकारिणां मुण्डमण्डलैः ।\nअखण्डरक्तविच्छर्दैर्बिभ्रत्यो वक्षसि क्रजः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006266066, "chapter_id": 26266, "verse_number": "३-२०-६७", "content_sanskrit": "सहस्रं देवताः प्रोक्ताः सेवमानाः किटीश्वरीम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006266067, "chapter_id": 26266, "verse_number": "३-२०-६८", "content_sanskrit": "तासां नामानि सर्वासां दण्डिन्याः कुंभसंभव ।\nसहस्रनामाध्याये तु वक्ष्यन्ते नाधुना पुनः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006266068, "chapter_id": 26266, "verse_number": "३-२०-६९", "content_sanskrit": "अथ तासां देवतानां कोलास्यानां समीपतः ।\nवाहनं कृष्णसारङ्गो दण्डिन्याः समये स्थितः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006266069, "chapter_id": 26266, "verse_number": "३-२०-७०", "content_sanskrit": "क्रोशार्धार्द्धायतः शृङ्गे तदर्धार्धायतो मुखे ।\nक्रोशप्रमाणापादश्च सदा चोद्धृतवालधिः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006266070, "chapter_id": 26266, "verse_number": "३-२०-७१", "content_sanskrit": "उदरे धवलच्छायो हुङ्कारेण महीयसा ।\nहसन्मारुतवाहस्य हरिणस्य पराक्रमम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006266071, "chapter_id": 26266, "verse_number": "३-२०-७२", "content_sanskrit": "तस्यैव पर्वणो देशे वर्त्तते वाहनोत्तमम् ।\nकिरिचक्ररथेन्द्रस्य स्थितस्तत्रैव पर्वणि ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006266072, "chapter_id": 26266, "verse_number": "३-२०-७३", "content_sanskrit": "वर्त्तते मदिरासिंधुर्देवतारूपमास्थिता ।\nमाणिक्यगिरिवच्छोणं हस्ते पिशितपिण्डकम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006266073, "chapter_id": 26266, "verse_number": "३-२०-७४", "content_sanskrit": "दधाना घूर्णमा नाक्षी हेमांभोजस्रगावृता ।\nमदशक्त्या समाश्लिष्टा धृतरक्तसरोजया ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006266074, "chapter_id": 26266, "verse_number": "३-२०-७५", "content_sanskrit": "यदायदा भण्डदैत्यः संग्रामे संप्रवर्तते ।\nयुद्धस्वेद मनुप्राप्ताः शक्तयः स्युः पिपासिताः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006266075, "chapter_id": 26266, "verse_number": "३-२०-७६", "content_sanskrit": "तदातदा सुरासिंधुरात्मानं बहुधा क्षिपन् ।\nरणे खेदं देवतानामञ्जसापाकरिष्यति ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006266076, "chapter_id": 26266, "verse_number": "३-२०-७७", "content_sanskrit": "तदप्यद्भुतमे वर्षे भविष्यति न संशयः ।\nतदा श्रोष्यसि संग्रामे कथ्यमानं मया मुदा ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006266077, "chapter_id": 26266, "verse_number": "३-२०-७८", "content_sanskrit": "तस्यैव पर्वणोऽधस्तादष्टदिक्ष्वघ एव हि ।\nउपर्यपि कृतावासा हेतुकाद्या दश स्मृताः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006266078, "chapter_id": 26266, "verse_number": "३-२०-७९", "content_sanskrit": "महान्तो भैरवश्रेष्ठाः ख्याता विपुलविक्रमाः ।\nउद्दीप्तायुत तेजोभिर्द्दिवा दीपितभानवः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006266079, "chapter_id": 26266, "verse_number": "३-२०-८०", "content_sanskrit": "कल्पान्तकाले दण्डिन्या आज्ञया विश्वघस्मराः ।\nअत्युदग्रप्रकृतयो रददष्टौष्ठसंपुटाः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006266080, "chapter_id": 26266, "verse_number": "३-२०-८१", "content_sanskrit": "त्रिशूलाग्रविनिर्भिन्नमहावारिदमण्डलाः ।\nहेतुकस्त्रिपुरारिश्च तृतीयश्चाग्निभैरवः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006266081, "chapter_id": 26266, "verse_number": "३-२०-८२", "content_sanskrit": "यमजिह्वैकपादौ च तथा कालकरालकौ ।\nभीमरूपो हाटकेशस्तथैवाचलनामवान् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006266082, "chapter_id": 26266, "verse_number": "३-२०-८३", "content_sanskrit": "एते दशैव विख्याता दशकोटिभटान्विताः ।\nतस्यैव किरिचक्रस्य वर्तन्ते पर्वसीमनि ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006266083, "chapter_id": 26266, "verse_number": "३-२०-८४", "content_sanskrit": "एवं हि दण्डनाथायाः किरिचक्रस्य देवताः ।\nजृंभिण्याद्यचलेन्द्रान्ताः प्रोक्तास्त्रैलोक्यपावनाः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006266084, "chapter_id": 26266, "verse_number": "३-२०-८५", "content_sanskrit": "तत्रत्यैर्देवतावृन्दैर्बहवस्तत्र संगरे ।\nदानवा मारयिष्यन्ते पास्यन्ते रक्तवृष्टयः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006266085, "chapter_id": 26266, "verse_number": "३-२०-८६", "content_sanskrit": "इत्थं बहुविधत्राणं पर्वस्थैर्देवतागणैः ।\nकिरिचक्रं दण्डनेत्र्या रथरत्नं चचाल ह ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006266086, "chapter_id": 26266, "verse_number": "३-२०-८७", "content_sanskrit": "चक्रराजरथो यत्र तत्र गेयरथोत्तमः ।\nयत्र गेयरथस्तत्र किरिचक्ररथोत्तमः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006266087, "chapter_id": 26266, "verse_number": "३-२०-८८", "content_sanskrit": "एतद्रथ त्रयं तत्र त्रैलोक्यमिव जङ्गमम् ।\nशक्तिसेनासहस्रस्यान्तश्चचार तदा शुभम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006266088, "chapter_id": 26266, "verse_number": "३-२०-८९", "content_sanskrit": "मेरुमन्दरविन्ध्यानां समवाय इवाभवत् ।\nमहाघोषः प्रववृते शक्तीनां सैन्यमण्डले ।\nचचाल वसुधा सर्वा तच्चक्ररवदारिता ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006266089, "chapter_id": 26266, "verse_number": "३-२०-९०", "content_sanskrit": "ललिता चक्रराजाख्या रथनाथस्य कीर्तिताः ।\nषट्सारथय उद्दण्डपाशग्रहणकोविदाः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006266090, "chapter_id": 26266, "verse_number": "३-२०-९१", "content_sanskrit": "यत्र गेयरथस्तत्र किरिचक्ररथोत्तमम् ।\nइति देवी प्रथमतस्तथा त्रिपुरभैरवी ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006266091, "chapter_id": 26266, "verse_number": "३-२०-९२", "content_sanskrit": "संहारभैरवश्चान्यो रक्तयोगिनिवल्लभः ।\nसारसः पञ्चमश्चैव चामुण्डा च तथा परा ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006266092, "chapter_id": 26266, "verse_number": "३-२०-९३", "content_sanskrit": "एतासु देवतास्तत्र रथसारथयः स्मृताः ।\nगेयच क्ररथेन्द्रस्य सारथिस्तु हसंतिका ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006266093, "chapter_id": 26266, "verse_number": "३-२०-९४", "content_sanskrit": "किरिचक्ररथेन्द्रस्य स्तंभिनी सारथिः स्मृता ।\nदशयोजनमुन्नम्रो ललितारथपुङ्गवः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006266094, "chapter_id": 26266, "verse_number": "३-२०-९५", "content_sanskrit": "सप्तयोजनमुच्छ्रायो गीतसक्ररथोत्तमः ।\nषड्योजनसमुन्नम्रो किरिचक्ररथो मुने ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006266095, "chapter_id": 26266, "verse_number": "३-२०-९६", "content_sanskrit": "महामुक्तातपत्रं तु दशयोजनविस्तृतम् ।\nवर्तते ललितेशान्या रथ एव न चान्यतः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006266096, "chapter_id": 26266, "verse_number": "३-२०-९७", "content_sanskrit": "तदेव शक्तिसाम्राज्यसूचकं परिकीर्तितम् ।\nसामान्यमातपत्रं तु तथद्वन्द्वेपि वर्तते ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006266097, "chapter_id": 26266, "verse_number": "३-२०-९८", "content_sanskrit": "अथ सा ललितेशानी सर्वशक्तिमहेश्वरी ।\nमहासाम्राज्यपदवीमारूढा परमेश्वरी ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7006266098, "chapter_id": 26266, "verse_number": "३-२०-९९", "content_sanskrit": "चचाल भण्डदेत्यस्य क्षयसिद्ध्यभिकाङ्क्षिणी ।\nशब्दायन्ते दिशः सर्वाः कंपते च वसुंधरा ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7006266099, "chapter_id": 26266, "verse_number": "३-२०-१००", "content_sanskrit": "क्षुभ्यन्ति सर्वभूतानि ललितेशाविनिर्गमे ।\nदेवदुन्दुभयो नेदुर्निपेतुः पुष्पवृष्टयः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7006266100, "chapter_id": 26266, "verse_number": "३-२०-१०१", "content_sanskrit": "विश्वावसुप्रभृतयो गन्धर्वाः सुरगायकाः ।\nतुम्बुरुर्नारदश्चैव साक्षादेव सरस्वती ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7006266101, "chapter_id": 26266, "verse_number": "३-२०-१०२", "content_sanskrit": "जयमङ्गल पद्यानि पठन्तः पटुगीतिभिः ।\nहर्षसंफुल्लवदनाः स्फुरत्पुलकभूषणाः ।\nमुहुर्जयजयेत्येवं स्तुवाना ललितेश्वरीम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7006266102, "chapter_id": 26266, "verse_number": "३-२०-१०३", "content_sanskrit": "हर्षेणाढ्या मदोन्मत्ताः प्रनृत्यन्तः पदेपदे ।\nसप्तर्षयो वशिष्ठाद्या ऋग्यजुः सामरूपिभिः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7006266103, "chapter_id": 26266, "verse_number": "३-२०-१०४", "content_sanskrit": "अथर्वरूपैर्मन्त्रैश्च वर्धयन्तो जयश्रियम् ।\nहविषेव महावह्निशिखामत्यन्तपाविनीम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7006266104, "chapter_id": 26266, "verse_number": "३-२०-१०५", "content_sanskrit": "आशीर्वादेन महता वर्धयामासुरुत्तमाः ।\nतैः स्तूयमाना ललिता राजमाना रथोत्तमे ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7006266105, "chapter_id": 26266, "verse_number": "३-२०-१०६", "content_sanskrit": "भण्डासुरं विनिर्जेतुमुद्दण्डैः सह सैनिकैः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}]