[{"id": 7000781000, "chapter_id": 20781, "verse_number": "६-१२४-१", "content_sanskrit": "ईश्वर उवाच ।\nप्रबोधिन्याश्च माहात्म्यं पापघ्नं पुण्यवर्द्धनम् ।\nमुक्तिदं तत्वबुद्धीनां शृणुष्व सुरसत्तम॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000781001, "chapter_id": 20781, "verse_number": "६-१२४-२", "content_sanskrit": "तावद्गर्जति सेनानि गंगा भागीरथी क्षितौ ।\nयावन्नायाति पापघ्नी कार्तिके हरिबोधिनी॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000781002, "chapter_id": 20781, "verse_number": "६-१२४-३", "content_sanskrit": "तावद्गच्छंति तीर्थानि आसमुद्र सरांसि च ।\nयावत्प्रबोधिनी विष्णोस्तिथिर्नायाति कार्तिके॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000781003, "chapter_id": 20781, "verse_number": "६-१२४-४", "content_sanskrit": "अश्वमेधसहस्राणि राजसूयशतानि च ।\nएकेनैवोपवासेन प्रबोधिन्यां यथाऽभवत्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000781004, "chapter_id": 20781, "verse_number": "६-१२४-५", "content_sanskrit": "दुर्लभं चैव दुष्प्राप्यं त्रैलोक्ये सचराचरे ।\nतदपि प्रार्थितं विप्र ददाति प्रतिबोधिनी॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000781005, "chapter_id": 20781, "verse_number": "६-१२४-६", "content_sanskrit": "ऐश्वर्यं संसृतिं ज्ञानं राज्यं च सुखसंपदम् ।\nददात्युपोषिता विप्र हेलया हरिबोधिनी॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000781006, "chapter_id": 20781, "verse_number": "६-१२४-७", "content_sanskrit": "मेरुमंदरतुल्यानि पापान्युपार्जितानि च ।\nएकेनैवोपवासेन दहते हरिबोधिनी॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000781007, "chapter_id": 20781, "verse_number": "६-१२४-८", "content_sanskrit": "उपवासं प्रबोधिन्यां यः करोति स्वभावतः ।\nविधिना नरशार्दूल यथोक्तं लभते फलम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000781008, "chapter_id": 20781, "verse_number": "६-१२४-९", "content_sanskrit": "पूर्वजन्मसहस्रेषु पापं यत्समुपार्जितम् ।\nजागरेण प्रबोधिन्यां दह्यते तूलराशिवत्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000781009, "chapter_id": 20781, "verse_number": "६-१२४-१०", "content_sanskrit": "शृणु षण्मुख वक्ष्यामि जागरस्य च लक्षणम् ।\nयस्य विज्ञानमात्रेण दुर्लभो न जनार्दनः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000781010, "chapter_id": 20781, "verse_number": "६-१२४-११", "content_sanskrit": "गीतं वाद्यं च नृत्यं च पुराणपठनं तथा ।\nधूपं दीपं च नैवेद्यं पुष्पं गंधानुलेपनम्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000781011, "chapter_id": 20781, "verse_number": "६-१२४-१२", "content_sanskrit": "फलमर्घ्यं च श्रद्धा च दानमिंद्रियसंयमम् ।\nसत्यान्वितं विनिद्रं च मुदायुक्तं क्रियान्वितम्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000781012, "chapter_id": 20781, "verse_number": "६-१२४-१३", "content_sanskrit": "साश्चर्चं चैव सोत्साहमालस्यादिविवर्जितम् ।\nप्रदक्षिणादिसंयुक्तं नमस्कारपुरःसरम्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000781013, "chapter_id": 20781, "verse_number": "६-१२४-१४", "content_sanskrit": "नीराजनसमायुक्तमनिर्विण्णेन चेतसा ।\nयामे यामे महाभाग कुर्वन्नीराजनं हरेः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000781014, "chapter_id": 20781, "verse_number": "६-१२४-१५", "content_sanskrit": "एतैर्गुणैः समायुक्तं कुर्याज्जागरणं विभोः ।\nएकाग्रमानसो यस्तु न पुनर्जायते भुवि॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000781015, "chapter_id": 20781, "verse_number": "६-१२४-१६", "content_sanskrit": "य एवं कुरुते भक्त्या वित्तशाठ्यविवर्जितैः ।\nजागरं वासरे विष्णोर्नीयते परमां गतिम्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000781016, "chapter_id": 20781, "verse_number": "६-१२४-१७", "content_sanskrit": "पुरुषसूक्तेन यो नित्यं कार्तिके अर्चयेद्धरिम् ।\nवर्षकोटिसहस्राणि पूजितस्तेन केशवः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000781017, "chapter_id": 20781, "verse_number": "६-१२४-१८", "content_sanskrit": "यथोक्तेन विधानेन पंचरात्रोदितेन वै ।\nकार्तिके त्वर्चयेन्नित्यं मुक्तिभागी भवेन्नरः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000781018, "chapter_id": 20781, "verse_number": "६-१२४-१९", "content_sanskrit": "नमोनारायणायेति कार्तिके योऽर्चयेद्धरिम् ।\nस मुक्तो नारकैर्दुःखैः पदं गच्छत्यनामयम्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000781019, "chapter_id": 20781, "verse_number": "६-१२४-२०", "content_sanskrit": "हरेर्नामसहस्रं च गजराजस्य मोक्षणम् ।\nकार्तिके पठते यस्तु पुनर्जन्म न विंदति॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000781020, "chapter_id": 20781, "verse_number": "६-१२४-२१", "content_sanskrit": "युगकोटिसहस्राणि मन्वंतरशतानि च ।\nद्वादश्यां कार्तिके मासि जागरी वसते दिवि॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000781021, "chapter_id": 20781, "verse_number": "६-१२४-२२", "content_sanskrit": "कुले तस्य च संजाताः शतशोऽथ सहस्रशः ।\nप्राप्नुवंति पदं विष्णोस्तस्मात्कुर्वीत जागरम्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000781022, "chapter_id": 20781, "verse_number": "६-१२४-२३", "content_sanskrit": "कार्तिके पश्चिमे यामे स्तवं गानं करोति यः ।\nश्वेतद्वीपे तु वसते पितृभिः सह भामिनि॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000781023, "chapter_id": 20781, "verse_number": "६-१२४-२४", "content_sanskrit": "नैवेद्यदानं हरये कार्तिके दिनसंक्षये ।\nयुगानि वसते स्वर्गे तावंति मुनिसत्तमाः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000781024, "chapter_id": 20781, "verse_number": "६-१२४-२५", "content_sanskrit": "अक्षयं मुनिशार्दूल मालतीकमलार्चनम् ।\nअर्चयेद्देवदेवेशं स याति परमं पदम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000781025, "chapter_id": 20781, "verse_number": "६-१२४-२६", "content_sanskrit": "कार्तिके शुक्लपक्षे तु कृत्वा ह्येकादशीं नरः ।\nप्रातर्दत्त्वा शुभान्कुंभान्स याति मम मंदिरम्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000781026, "chapter_id": 20781, "verse_number": "६-१२४-२७", "content_sanskrit": "कार्त्तिकेय उवाच ।\nभगवन्नुच्यतां पुण्यं व्रतानां परमं व्रतम् ।\nकर्तव्यं कार्तिके मासि भवता भीष्मपंचकम्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000781027, "chapter_id": 20781, "verse_number": "६-१२४-२८", "content_sanskrit": "विधानं तस्य च फलं तथैव सुरसत्तम ।\nकथयस्व प्रसादान्मे मुनीनां च पितामह॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000781028, "chapter_id": 20781, "verse_number": "६-१२४-२९", "content_sanskrit": "ईश्वर उवाच ।\nप्रवक्ष्यामि महापुण्यं व्रतं विधिमतां वरः ।\nभीष्मेणैतद्यतः प्राप्तं व्रतं पंचदिनात्मकम्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000781029, "chapter_id": 20781, "verse_number": "६-१२४-३०", "content_sanskrit": "सकाशाद्वासुदेवस्य तेनोक्तं भीष्मपंचकम् ।\nव्रतस्यास्य गुणान्वक्तुं कः शक्तः केशवादृते॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000781030, "chapter_id": 20781, "verse_number": "६-१२४-३१", "content_sanskrit": "कार्त्तिके शुक्लपक्षे तु शृणु धर्मं पुरातनम् ।\nवसिष्ठभृगुगर्गाद्यैश्चीर्णं कृतयुगादिषु॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000781031, "chapter_id": 20781, "verse_number": "६-१२४-३२", "content_sanskrit": "अंबरीषेण भोगाद्यैश्चीर्णं त्रेतायुगादिषु ।\nब्राह्मणैर्ब्रह्मचर्येण जपहोमक्रियादिभिः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000781032, "chapter_id": 20781, "verse_number": "६-१२४-३३", "content_sanskrit": "क्षत्रियैश्च तथा वैश्यैः सत्यशौचपरायणैः ।\nदुष्करं सत्यहीनानामशक्यं बालचेतसाम्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000781033, "chapter_id": 20781, "verse_number": "६-१२४-३४", "content_sanskrit": "दुष्करं भीष्ममित्याहुर्न शक्यं प्राकृतैर्नरैः ।\nयस्तत्करोति विप्रेंद्र तेन सर्वं कृतं भवेत्॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000781034, "chapter_id": 20781, "verse_number": "६-१२४-३५", "content_sanskrit": "व्रतं चैतन्महापुण्यं महापातकनाशनम् ।\nअतो नरैः प्रयत्नेन कर्त्तव्यं भीष्मपंचकम्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000781035, "chapter_id": 20781, "verse_number": "६-१२४-३६", "content_sanskrit": "कार्तिकस्यामलेपक्षे स्नात्वा सम्यग्विधानतः ।\nएकादश्यां तु गृह्णीयाद्व्रतं पंचदिनात्मकम्॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000781036, "chapter_id": 20781, "verse_number": "६-१२४-३७", "content_sanskrit": "प्रातः स्नात्वा विशेषेण मध्याह्ने च तथा व्रती ।\nनद्यां निर्झरगर्ते वा समालभ्य च गोमयम्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000781037, "chapter_id": 20781, "verse_number": "६-१२४-३८", "content_sanskrit": "यवव्रीहितिलैः सम्यक्पितॄन्संतर्पयेत्क्रमात् ।\nस्नात्वा मौनं नरः कृत्वा धौतवासा दृढव्रतः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000781038, "chapter_id": 20781, "verse_number": "६-१२४-३९", "content_sanskrit": "भीष्मायोदकदानं च अर्घ्यं चैव प्रयत्नतः ।\nपूजा भीष्मस्य कर्त्तव्या दानं दद्यात्प्रयत्नतः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000781039, "chapter_id": 20781, "verse_number": "६-१२४-४०", "content_sanskrit": "पंचरत्नं विशेषेण दत्त्वा विप्राय यत्नतः ।\nवासुदेवोऽपि संपूज्यो लक्ष्मीयुक्तः सदा प्रभुः॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000781040, "chapter_id": 20781, "verse_number": "६-१२४-४१", "content_sanskrit": "पंचके पूजयित्वा तु कोटिकल्पानि तुष्यति ।\nयत्किंचित्क्रियते सर्वं पंचधातुप्रकल्पयेत्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000781041, "chapter_id": 20781, "verse_number": "६-१२४-४२", "content_sanskrit": "संवत्सरव्रतानां च लभते सकलं फलम् ।\nकृत्वा तूदकदानं तु तथार्घ्यस्य च दापनम्॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000781042, "chapter_id": 20781, "verse_number": "६-१२४-४३", "content_sanskrit": "मंत्रेणानेन यः कुर्यान्मुक्तिभागी भवेन्नरः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000781043, "chapter_id": 20781, "verse_number": "६-१२४-४४", "content_sanskrit": "वैयाघ्रपादगोत्राय सांकृते प्रवराय च ।\nअपुत्राय ददाम्येतदुदकं भीष्मवर्मणे॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000781044, "chapter_id": 20781, "verse_number": "६-१२४-४५", "content_sanskrit": "वसूनामवताराय शंतनोरात्मजाय च ।\nअर्घ्यं ददामि भीष्माय आजन्मब्रह्मचारिणे॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000781045, "chapter_id": 20781, "verse_number": "६-१२४-४६", "content_sanskrit": "अनेन विधिना यस्तु पंचकं तु समापयेत् ।\nअश्वमेधसमं पुण्यं प्राप्नोत्यत्र न संशयः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000781046, "chapter_id": 20781, "verse_number": "६-१२४-४७", "content_sanskrit": "पंचाहमपि कर्तव्यं नियमं च प्रयत्नतः ।\nनियमेन विना पुत्र न भाव्यं व्रतकर्मणा॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000781047, "chapter_id": 20781, "verse_number": "६-१२४-४८", "content_sanskrit": "उत्तरायणहीनाय भीष्माय प्रददौ हरिः ।\nउत्तरायणहीनोऽपि शुद्धिं लग्नं विना शुभाः॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000781048, "chapter_id": 20781, "verse_number": "६-१२४-४९", "content_sanskrit": "ततः संपूजयेद्देवं सर्वपापहरं हरिम् ।\nअनंतरं प्रयत्नेन कर्तव्यं भीष्मपंचकम्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000781049, "chapter_id": 20781, "verse_number": "६-१२४-५०", "content_sanskrit": "स्नापयेत जलैर्भक्त्या मधुक्षीरघृतेन च ।\nतथैव पंचगव्येन गंधचंदनवारिणा॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000781050, "chapter_id": 20781, "verse_number": "६-१२४-५१", "content_sanskrit": "चंदनेन सुगंधेन कुंकुमेनाथ केशवम् ।\nकर्पूरोशीरमिश्रेण लेपयेद्गरुडध्वजम्॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000781051, "chapter_id": 20781, "verse_number": "६-१२४-५२", "content_sanskrit": "अर्चयेद्रुचिरैः पुष्पैर्गंधधूपसमन्वितैः ।\nगुग्गुलुं घृतंसंयुक्तं दहेत्कृष्णाय भक्तिमान्॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000781052, "chapter_id": 20781, "verse_number": "६-१२४-५३", "content_sanskrit": "दीपकं तु दिवारात्रौ दद्यात्पंचदिनादिषु ।\nनैवेद्यं देवदेवस्य परमान्नं निवेदयेत्॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000781053, "chapter_id": 20781, "verse_number": "६-१२४-५४", "content_sanskrit": "एवमभ्यर्चयेद्देवं संस्मृत्य च प्रणम्य च ।\nॐ नमो वासुदेवाय जपेदष्टोत्तरं शतम्॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000781054, "chapter_id": 20781, "verse_number": "६-१२४-५५", "content_sanskrit": "जुहुयाच्च घृताभ्यक्तैस्तिलव्रीहियवादिभिः ।\nषडक्षरेण मंत्रेण स्वाहाकारान्वितेन च॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000781055, "chapter_id": 20781, "verse_number": "६-१२४-५६", "content_sanskrit": "उपास्य पश्चिमां संध्यां प्रणम्य गरुडध्वजम् ।\nजपित्वा पूर्ववन्मंत्रं क्षितिशायी भवेद्व्रती॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000781056, "chapter_id": 20781, "verse_number": "६-१२४-५७", "content_sanskrit": "सर्वमेतद्विधानं तु कार्यं पंचदिनानि तु ।\nविशेषोऽत्र व्रते ह्यस्मिन्यदन्यूनं शृणुष्व तत्॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000781057, "chapter_id": 20781, "verse_number": "६-१२४-५८", "content_sanskrit": "प्रथमेऽह्नि हरेः पादौ पूजयेत्कमलैर्व्रती ।\nद्वितीये बिल्वपत्रेण जानुदेशं समर्चयेत्॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000781058, "chapter_id": 20781, "verse_number": "६-१२४-५९", "content_sanskrit": "ततोनुपूजयेच्छीर्षं मालत्या चक्रपाणिनः ।\nकार्तिक्यां देवदेवस्य भक्त्या तद्गतमानसः॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000781059, "chapter_id": 20781, "verse_number": "६-१२४-६०", "content_sanskrit": "अर्चित्वा तं हृषीकेशमेकादश्यां समासतः ।\nनिष्प्राश्य गोमयं सम्यगेकादश्यामुपावसेत्॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000781060, "chapter_id": 20781, "verse_number": "६-१२४-६१", "content_sanskrit": "गोमूत्रं मंत्रवद्भूमौ द्वादश्यां प्राशयेद्व्रती ।\nक्षीरं चैव त्रयोदश्यां चतुर्दश्यां तथा दधि॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000781061, "chapter_id": 20781, "verse_number": "६-१२४-६२", "content_sanskrit": "संप्राश्य कायशुद्ध्यर्थं लंघयित्वा चतुर्दिनम् ।\nपंचमे दिवसे स्नात्वा विधिवत्पूज्य केशवम्॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000781062, "chapter_id": 20781, "verse_number": "६-१२४-६३", "content_sanskrit": "भोजयेद्ब्राह्मणान्भक्त्या तेभ्यो दद्याच्च दक्षिणाम् ।\nपापबुद्धिं परित्यज्य ब्रह्मचर्येण धीमता॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000781063, "chapter_id": 20781, "verse_number": "६-१२४-६४", "content_sanskrit": "मद्यं मांसं परित्यज्य मैथुनं पापकारिणम् ।\nशाकाहारेण मुन्यन्नैः कृष्णार्चनपरो नरः॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000781064, "chapter_id": 20781, "verse_number": "६-१२४-६५", "content_sanskrit": "ततो नक्तं समाश्नीयात्पंचगव्यपुरः सरम् ।\nएवं सम्यक्समाप्तस्य यथोक्तं फलमाप्नुयात्॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000781065, "chapter_id": 20781, "verse_number": "६-१२४-६६", "content_sanskrit": "मद्यपो यत्पिबेन्मद्यं जन्मनो मरणांतिकम् ।\nएतद्भीष्मव्रतं कृत्वा प्राप्नोति परमं पदम्॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000781066, "chapter_id": 20781, "verse_number": "६-१२४-६७", "content_sanskrit": "स्त्रीभिर्ब्राह्मणवाक्येन कर्तव्यं धर्मवर्द्धनम् ।\nविधवाभिश्च कर्तव्यं मोक्षसौख्याभिवृद्धये॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000781067, "chapter_id": 20781, "verse_number": "६-१२४-६८", "content_sanskrit": "सर्वकामसमृद्ध्यर्थं पुण्यार्थमपि पावके ।\nनित्यस्नाने तथा दाने ये कार्तिकमुपासते॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000781068, "chapter_id": 20781, "verse_number": "६-१२४-६९", "content_sanskrit": "वैश्वदेवश्च कर्तव्यो विष्णुध्यानपरायणैः ।\nआरोग्य पुत्रदो वत्स महापातकनाशनः॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000781069, "chapter_id": 20781, "verse_number": "६-१२४-७०", "content_sanskrit": "तीर्थेषु कार्तिकं कुर्यात्सर्वयत्नेन षण्मुख ।\nसंवत्सरव्रतानां तु समाप्तिः कार्तिके मता॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000781070, "chapter_id": 20781, "verse_number": "६-१२४-७१", "content_sanskrit": "पापस्य प्रतिमा कार्या रौद्रवस्त्राति भीषणा ।\nखड्गहस्ता विनिष्क्रांता लोहदंष्ट्राकरालिनी॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000781071, "chapter_id": 20781, "verse_number": "६-१२४-७२", "content_sanskrit": "तिलप्रस्थोपरि स्थाप्या कृष्णवस्त्राभिवेष्टिता ।\nरक्तपुष्पकृतापीडा ज्वलत्कांचनकुंडला॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000781072, "chapter_id": 20781, "verse_number": "६-१२४-७३", "content_sanskrit": "संपूज्य परया भक्त्या धर्मराजस्य नामभिः ।\nइममुच्चारयेन्मंत्रं गृहीतकुसुमांजलिः॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000781073, "chapter_id": 20781, "verse_number": "६-१२४-७४", "content_sanskrit": "यदन्यजन्मनि कृतमिह जन्मनि वा पुनः ।\nपापं प्रशममायातु तव पादप्रसादतः॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000781074, "chapter_id": 20781, "verse_number": "६-१२४-७५", "content_sanskrit": "एवं संपूज्य विधिवत्प्रतिमां तां च कांचनीम् ।\nकृत्वा पूजां यथाशक्त्या विप्राणां वेदवादिनाम्॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000781075, "chapter_id": 20781, "verse_number": "६-१२४-७६", "content_sanskrit": "प्रीतये देवदेवस्य कृष्णस्याक्लिष्टकर्मणः ।\nब्राह्मणाय प्रदातव्यं धर्मो मे प्रीयतामिति॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000781076, "chapter_id": 20781, "verse_number": "६-१२४-७७", "content_sanskrit": "वाचकाय प्रदातव्या यथाशक्त्या च दक्षिणा ।\nदद्याद्धिरण्यं गाश्चैव कृष्णो मे प्रीयतामिति॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000781077, "chapter_id": 20781, "verse_number": "६-१२४-७८", "content_sanskrit": "कृतकृत्य स्थितो भूत्वा विरक्तः संयतो भवेत् ।\nअन्येषामपि दातव्यं स्वशक्त्या दानमुत्तमम्॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000781078, "chapter_id": 20781, "verse_number": "६-१२४-७९", "content_sanskrit": "शांतचित्तो निरपराधः परं पदमवाप्नुयात् ।\nनीलोत्पलदलश्यामश्चतुर्दंष्ट्रश्चतुर्भुजः॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000781079, "chapter_id": 20781, "verse_number": "६-१२४-८०", "content_sanskrit": "अष्टपादैकनयनः शंकुकर्णः खरस्वनः ।\nजडी द्विजिह्वस्ताम्राक्षो मृगराजतनुच्छदः॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000781080, "chapter_id": 20781, "verse_number": "६-१२४-८१", "content_sanskrit": "चिंतनीयो महादेवो यस्य रूपं न विद्यते ।\nइदं भीष्मेण कथितं शरतल्पगतेन मे॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000781081, "chapter_id": 20781, "verse_number": "६-१२४-८२", "content_sanskrit": "तदेतत्ते मयाख्यातं दुष्करं भीष्मपंचकं ।\nधन्यं पुण्यं पापहरं युधिष्ठिर महाव्रतम् ।\nयत्कृत्वा ब्रह्महा गोघ्नः सर्वपापैः प्रमुच्यते॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000781082, "chapter_id": 20781, "verse_number": "६-१२४-८३", "content_sanskrit": "यद्भीष्मपंचकमिति प्रथितं पृथिव्यामेकादशीप्रभृतिपंचदशी निरुद्धम् ।\nउक्तं न भोजनपरस्य तदा निषेधस्तस्मिन्व्रते शुभफलं प्रददाति विष्णुः॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000781083, "chapter_id": 20781, "verse_number": "६-१२४-८४", "content_sanskrit": "सूत उवाच ।\nएतत्सर्वाधिकं पुण्यं दुर्लभं भुवने कृतम् ।\nइदं गुह्यं मयाख्यातं शास्त्रसारसमुच्चयम्॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000781084, "chapter_id": 20781, "verse_number": "६-१२४-८५", "content_sanskrit": "सुराणां गोपितं सर्वमतिगुह्यं च मोक्षदम् ।\nश्रुत्वा चैकपदे देवि अगम्यागमने रताः॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000781085, "chapter_id": 20781, "verse_number": "६-१२४-८६", "content_sanskrit": "कन्याविक्री स्वसाविक्री ह्युभयं तु विमोचयेत् ।\nमोक्षदं च इदं शास्त्रं प्रकाशं नेतरे जने॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000781086, "chapter_id": 20781, "verse_number": "६-१२४-८७", "content_sanskrit": "श्रुत्वा चैकपदे यस्तु मोक्षं गच्छति मानवः ।\nगोपनीयं प्रयत्नेन ये चापि त्यागिनो नराः॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000781087, "chapter_id": 20781, "verse_number": "६-१२४-८८", "content_sanskrit": "न तेषां कथ्यते पुण्यं सत्यं सत्यं च षण्मुख ।\nइत्येतत्सर्वमाख्यातं कार्तिकस्य तु यत्फलम्॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000781088, "chapter_id": 20781, "verse_number": "६-१२४-८९", "content_sanskrit": "श्रीविष्णुरुवाच ।\nकथितं देवदेवेन पुत्राय हितकाम्यया ।\nपितुस्तद्वाक्यमाकर्ण्य षण्मुखो हर्षनिर्भरः॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000781089, "chapter_id": 20781, "verse_number": "६-१२४-९०", "content_sanskrit": "ऊचुः प्रांजलयः सर्वे तं देवं जगदायुषम् ।\nकृतकृत्या वयं जाताः श्रुत्वा कार्तिकजं फलम्॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000781090, "chapter_id": 20781, "verse_number": "६-१२४-९१", "content_sanskrit": "अपरं नास्ति श्रोतव्यं प्राप्तं मे जन्मनः फलम् ।\nमाहात्म्यमेतदाकर्ण्य पूजयेद्यस्तु पाठकम्॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000781091, "chapter_id": 20781, "verse_number": "६-१२४-९२", "content_sanskrit": "गोभूहिरण्यवस्त्रैश्च विष्णुतुल्यो यतो हि सः ।\nवाचके पूजिते यस्माद्विष्णुर्भवति पूजितः॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000781092, "chapter_id": 20781, "verse_number": "६-१२४-९३", "content_sanskrit": "तथा तं पूजयेन्नित्यं यदीच्छेत्सफलं शुभम् ।\nधर्मशास्त्रं पुराणं च वेदविद्यादिकं च यत्॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000781093, "chapter_id": 20781, "verse_number": "६-१२४-९४", "content_sanskrit": "पुस्तकं वाचकायैव दातव्यं धर्ममिच्छता ।\nपुराणविद्या दातारो ह्यनंतफलभोजिनः॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000781094, "chapter_id": 20781, "verse_number": "६-१२४-९५", "content_sanskrit": "यः पठेत इदं भक्त्या श्रुत्वा चैवावधारयेत् ।\nमुच्यते सर्वपापेभ्यो विष्णुलोकं स गच्छति॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000781095, "chapter_id": 20781, "verse_number": "६-१२४-९६", "content_sanskrit": "धनं धान्यं यशः पुत्रानायुरारोग्यमेव च ।\nमाहात्म्यश्रवणादेव लभ्यते च न संशयः॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}]