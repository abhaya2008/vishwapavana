[{"id": 2075182, "chapter_id": 2590, "verse_number": "१२-९५-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2075183, "chapter_id": 2590, "verse_number": "१२-९५-१", "content_sanskrit": "अथ यो विजिगीषेत क्षत्रियः क्षत्रियं युधि।\nकस्तस्य विजये धर्मो ह्येतं पृष्टो ब्रवीहि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2075184, "chapter_id": 2590, "verse_number": "१२-९५-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2075185, "chapter_id": 2590, "verse_number": "१२-९५-२", "content_sanskrit": "ससहायोऽसहायो वा राष्ट्रमागम्य भूमिपः।\nब्रूयादहं यो राजेति रक्षिष्यामि च वः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2075186, "chapter_id": 2590, "verse_number": "१२-९५-३", "content_sanskrit": "मम धर्मबलिं दत्त किंवा मां प्रतिपत्स्यथ।\nते चोक्तमागतं तत्र घृणीयुः कुशलं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2075187, "chapter_id": 2590, "verse_number": "१२-९५-४", "content_sanskrit": "ते चेदक्षत्रियाः सन्तो विरुध्येरन्कथंचन।\nसर्वोपायैर्नियन्तव्या विकर्मस्था नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2075188, "chapter_id": 2590, "verse_number": "१२-९५-५", "content_sanskrit": "अशस्त्रं क्षत्रियं मत्वा शस्त्रं गृह्णात्यथापरः।\nत्राणायाप्यसमर्थं तं मन्यमानमतीव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2075189, "chapter_id": 2590, "verse_number": "१२-९५-६x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2075190, "chapter_id": 2590, "verse_number": "१२-९५-६", "content_sanskrit": "अथः यः क्षत्रियो राजा क्षत्रियं प्रत्युपाव्रजेत्।\nकथं संप्रतियोद्धव्यस्तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2075191, "chapter_id": 2590, "verse_number": "१२-९५-७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2075192, "chapter_id": 2590, "verse_number": "१२-९५-७", "content_sanskrit": "नासन्नह्यो नाकवचो योद्धव्यः क्षत्रियो रणे।\nएक एकेन भाव्यश्च विसृजेति क्षिपामि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2075193, "chapter_id": 2590, "verse_number": "१२-९५-८", "content_sanskrit": "स चेत्सन्नद्ध आगच्छेत्सन्नद्धव्यं ततो भवेत्।\nस चेत्ससैन्य आगच्छेत्ससैन्यस्तमथाह्वयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2075194, "chapter_id": 2590, "verse_number": "१२-९५-९", "content_sanskrit": "स चेन्निकृत्या युध्येत निकृत्या प्रतियोधयेत्।\nअथ चेद्धर्मतो युध्येद्धर्मेणैव निवारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2075195, "chapter_id": 2590, "verse_number": "१२-९५-१०", "content_sanskrit": "नाश्वेन रथिनं यायादुदियाद्रथिनं रथी।\nव्यसने न प्रहर्तव्यं न भीताय जिताय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2075196, "chapter_id": 2590, "verse_number": "१२-९५-११", "content_sanskrit": "नेषुर्लिप्तो न कर्णी स्यादसतामेतदायुधम्।\nयथार्थमेव योद्धव्यं न क्रुद्ध्येत जिघांसतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2075197, "chapter_id": 2590, "verse_number": "१२-९५-१२", "content_sanskrit": "`नास्त्येकस्य गजो युद्धे गजश्चेकस्य विद्यते।\nन पदातिर्गजं युध्येन्न गतेन पदातिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2075198, "chapter_id": 2590, "verse_number": "१२-९५-१३", "content_sanskrit": "हस्तिना योधयेन्नागं कदाचिच्छिक्षितो हयः।\nदिव्यास्त्रबलसंपन्नः कामं युध्येत सर्वदा।\nनागे भूमौ समे चैव रथेनाश्वेन वा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2075199, "chapter_id": 2590, "verse_number": "१२-९५-१४", "content_sanskrit": "रामरावणयोर्युद्धे हरयो वै पदातयः।\nलक्ष्मणश्च महाभागस्तथा राजन्विभीषणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2075200, "chapter_id": 2590, "verse_number": "१२-९५-१५", "content_sanskrit": "रावणस्यान्तकाले च रथेनैन्द्रेण राधवः।\nनिजघान दुराचारं रावणं पापकारिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2075201, "chapter_id": 2590, "verse_number": "१२-९५-१६", "content_sanskrit": "दिव्यास्त्रबलसंपन्ने सर्वमेतद्विधीयते।\nदेवासुरेषु सर्वेषु दृष्टमेतत्पुरातनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2075202, "chapter_id": 2590, "verse_number": "१२-९५-१७", "content_sanskrit": "[साधूनां तु यदा भेदात्साधुश्चेद्व्यसनी भवेत्।]\nनिष्प्राणो नाभिहन्तव्यो नानपत्यः कथंचन।\nभग्नशस्त्रो विपन्नश्च कृत्तज्यो हतवाहनः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2075203, "chapter_id": 2590, "verse_number": "१२-९५-१८", "content_sanskrit": "चिकित्स्यः स्यात्स्वविषये प्राप्यो वा स्वगृहे भवेत्।\nनिर्व्रणश्च स भोक्तव्य एष धर्मः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2075204, "chapter_id": 2590, "verse_number": "१२-९५-१९", "content_sanskrit": "तस्माद्धर्मेण योद्धव्यमिति स्वायंभुवोऽब्रवात्।\nसत्सु नित्यः सतां धर्मस्तमास्थाय न नाशयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2075205, "chapter_id": 2590, "verse_number": "१२-९५-२०", "content_sanskrit": "यो वै जयत्यधर्मेण क्षत्रियो धर्मसंगरः।\nआत्मानमात्मना हन्ति पापो निकृतिजीवनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2075206, "chapter_id": 2590, "verse_number": "१२-९५-२१", "content_sanskrit": "कर्म चैतदसाधूनां साधून्योऽसाधुना जयेत्।\nधर्मेण निधनं श्रेयो न जयः पापकर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2075207, "chapter_id": 2590, "verse_number": "१२-९५-२२", "content_sanskrit": "नाधर्मश्चरितो राजन्सद्यः फलति गौरिव।\nमूलानि च प्रशाखाश्च दहन्समधिगच्छते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2075208, "chapter_id": 2590, "verse_number": "१२-९५-२३", "content_sanskrit": "पापेन कर्मणा वित्तं लब्ध्वा पापः प्रहृष्यति।\nस वर्धमानस्तेनैव पापः पापे प्रसज्जति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2075209, "chapter_id": 2590, "verse_number": "१२-९५-२४", "content_sanskrit": "न धर्मोऽस्तीति मन्वानः शुचीनवहसन्निव।\nअश्रद्दधानश्च भवेद्विनाशमुपगच्छति\nस बद्धो वारुणैः पाशैरमर्त्यैरवमन्यते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2075210, "chapter_id": 2590, "verse_number": "१२-९५-२५", "content_sanskrit": "महादृतिरिवाध्मातः स्वकृतेनैव वर्धते।\nततः समूलो ह्रियते नदीकूलादिव द्रुमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2075211, "chapter_id": 2590, "verse_number": "१२-९५-२६", "content_sanskrit": "अथैनमभिनिन्दन्ति भिन्नं कुम्भमिवाश्यानि।\nतस्माद्धर्मेण विजयं कोशं लिप्सेत भूमिपः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2075212, "chapter_id": 2590, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि पञ्चनवतितमोऽध्यायः॥ ९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]