[{"id": 2142230, "chapter_id": 4065, "verse_number": "", "content_sanskrit": "विराटः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2142231, "chapter_id": 4065, "verse_number": "१", "content_sanskrit": "यद्येष राजा कौरव्यः कुन्तीपुत्रो युधिष्ठिरः ।\nकतरो ह्यर्जुनो भ्राता भीमश्च कतमो बली\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2142232, "chapter_id": 4065, "verse_number": "२", "content_sanskrit": "नकुलः सहदेवो वा द्रौपदी वा यशस्विनी ।\nयदा द्यूते जिता लोके न प्रज्ञायन्त ते क्वचित्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2142233, "chapter_id": 4065, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2142234, "chapter_id": 4065, "verse_number": "३", "content_sanskrit": "य एष वललो ब्रूते सूपकारश्च वै(ते) नृप ।\nएष भीमो महाभाग भीमवीर्यपराक्रमः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2142235, "chapter_id": 4065, "verse_number": "४", "content_sanskrit": "एष क्रोधवशान् हत्वा पर्वते गन्धमादने ।\nसौगन्धिकानि पुष्पाणि कृष्णार्थे समुपानयत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2142236, "chapter_id": 4065, "verse_number": "५", "content_sanskrit": "गन्धर्वव्यपदेशेन कीचकानां दुरात्मनाम् ।\nशतं षडधिकं हत्वा द्रौपदीं प्रत्यनन्दयत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2142237, "chapter_id": 4065, "verse_number": "६", "content_sanskrit": "व्याघ्रान् ऋक्षान् गजांश्चैव हतवान् वै पुरे तव\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2142238, "chapter_id": 4065, "verse_number": "७", "content_sanskrit": "हिडिम्बं च बकं चैव किर्म्मीरं च जटासुरम् ।\nहत्वा निष्कण्टकं चक्रे अरण्यं सर्वतः सुखम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2142239, "chapter_id": 4065, "verse_number": "८", "content_sanskrit": "यश्चासीदश्वबन्धस्ते नकुलोऽयं परन्तपः ।\nगोसङ्ख्यः सहदेवश्च माद्रीपुत्रौ महाबलौ\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2142240, "chapter_id": 4065, "verse_number": "९", "content_sanskrit": "शृङ्गारवेषाभरणौ रूपवन्तौ मनस्विनौ ।\nनानारथसहस्राणां समर्थौ भरतर्षभौ\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2142241, "chapter_id": 4065, "verse_number": "१०", "content_sanskrit": "एषा पद्मपलाशाक्षी सुमध्या चारुहासिनी ।\nसैरन्ध्री द्रौपदी राजन् यत्कृते कीचका हताः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2142242, "chapter_id": 4065, "verse_number": "११", "content_sanskrit": "द्रुपदस्य प्रिया पुत्री धृष्टद्युम्नस्य चानुजा ।\nअग्निकुण्डात् समुद्भूता द्रौपदी त्ववगम्यताम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2142243, "chapter_id": 4065, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2142244, "chapter_id": 4065, "verse_number": "१२", "content_sanskrit": "अस्त्रज्ञो दुर्लभः कश्चित् केवलं पृथिवीमनु ।\nधनुर्भृतां तथा श्रेष्ठः कौन्तेयोऽयं धनञ्जयः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2142245, "chapter_id": 4065, "verse_number": "१३", "content_sanskrit": "एतेन खाण्डवं दग्धमकामस्य शतक्रतोः ।\nदग्धं नागवनं चैव सह नागैर्नराधिप\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2142246, "chapter_id": 4065, "verse_number": "१४", "content_sanskrit": "वर्षं च शरवर्षेण वारितं दुर्जयेन वै ।\nकरमाहारिताः सर्वे पार्थिवाः पृथिवीपते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2142247, "chapter_id": 4065, "verse_number": "१५", "content_sanskrit": "स्त्रीवेषं कृतवानेष तव राजन् निवेशने ।\nबृहन्नळेति यामाहुरर्जुनं जयतां वरम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2142248, "chapter_id": 4065, "verse_number": "१६", "content_sanskrit": "उषिताः स्म सुखं सर्वे तव राजन् निवेशने ।\nअज्ञातवासे निभृता गर्भवास इव प्रजाः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2142249, "chapter_id": 4065, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2142250, "chapter_id": 4065, "verse_number": "१७", "content_sanskrit": "यदाऽर्जुनेन ते वीराः कथिताः पञ्च पाण्डवाः ।\nतदाऽर्जुनस्य वैराटिः कथयामास विक्रमम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2142251, "chapter_id": 4065, "verse_number": "१८", "content_sanskrit": "अयं स द्विषतां मध्ये मृगाणामिव केसरी ।\nअचरद् रथबृन्देषु निघ्नंस्तेषां परावरान्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2142252, "chapter_id": 4065, "verse_number": "१९", "content_sanskrit": "अनेन विद्धा मातङ्गा महामेघोपमास्तदा ।\nहिरण्यकक्ष्याः सङ्ग्रामे दन्ताभ्यामगमन्महीम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2142253, "chapter_id": 4065, "verse_number": "२०", "content_sanskrit": "अनेन विजिता गावो निर्जिताः कौरवा युधि ।\nअस्य शङ्खप्रणादेन कर्णौ मे बधिरीकृतौ\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2142254, "chapter_id": 4065, "verse_number": "२१", "content_sanskrit": "जायते रोमहर्षो मे संस्मृत्यास्य धनुर्ध्वनिम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2142255, "chapter_id": 4065, "verse_number": "२२", "content_sanskrit": "अनेन राजन् वीरेण भीष्मद्रोणमुखा रथाः ।\nदुर्योधनेन सहिता निर्जिता भीमकर्मणा\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2142256, "chapter_id": 4065, "verse_number": "२३", "content_sanskrit": "अयं भीतं द्रवन्तं मां देवपुत्रो न्यवारयत् ।\nअस्य बाहुबलेनास्मि जीवन् प्रत्यागतः पुरम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2142257, "chapter_id": 4065, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2142258, "chapter_id": 4065, "verse_number": "२४", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा मत्स्यराजः प्रतापवान् ।\nधनञ्जयं परिष्वज्य पाण्डवानपि सर्वशः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2142259, "chapter_id": 4065, "verse_number": "२५", "content_sanskrit": "नमस्कृत्य तु राजानं राजा राज्येऽभिषेचितः ।\nनातृप्यद् दर्शने तेषां विराटो वाहिनीपतिः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2142260, "chapter_id": 4065, "verse_number": "२६", "content_sanskrit": "सम्प्रीयमाणो राजानं युधिष्ठिरमथाब्रवीत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2142261, "chapter_id": 4065, "verse_number": "२७", "content_sanskrit": "दिष्ट्या भवन्तः सम्प्राप्ताः सर्वे कुशलिनो वनात् ।\nदिष्ट्या च चरितं कृच्छ्रमज्ञातं तैर्दुरात्मभिः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2142262, "chapter_id": 4065, "verse_number": "२८", "content_sanskrit": "इदं राज्यं च नः सर्वं यच्चापि वसु किञ्चन ।\nअविभक्तमेतद् भवतां नोत्कण्ठां कर्तुमर्हत\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2142263, "chapter_id": 4065, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि त्रिसप्ततितमोऽध्यायः ॥७३॥ वैवाहिकपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2142264, "chapter_id": 4065, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]