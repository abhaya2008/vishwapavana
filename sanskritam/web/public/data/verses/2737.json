[{"id": 2081971, "chapter_id": 2737, "verse_number": "१२-२४२-०x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2081972, "chapter_id": 2737, "verse_number": "१२-२४२-१", "content_sanskrit": "अथ चेद्रोचयेदेतदुह्यते मनसा तथा।\nउन्मज्जंश्च निमज्जंश्च ज्ञानवान्प्लववान्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2081973, "chapter_id": 2737, "verse_number": "१२-२४२-२", "content_sanskrit": "प्रज्ञया निर्मितैर्धीरास्तारयन्त्यबुधान्प्लवैः।\nनाबुधास्तारयन्त्यन्यानात्मानं वा कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2081974, "chapter_id": 2737, "verse_number": "१२-२४२-३", "content_sanskrit": "छिन्नदोषो मुनिर्योगयुक्तो युञ्जीत द्वादश।\nदशकर्मसुखानर्थानुपायापायनिष्क्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2081975, "chapter_id": 2737, "verse_number": "१२-२४२-४", "content_sanskrit": "चक्षुराचारसंग्राहैर्मनसा दर्शनेन च।\nयच्छेद्वाङ्भनसी बुद्ध्या य इच्छेज्ज्ञानमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2081976, "chapter_id": 2737, "verse_number": "१२-२४२-५", "content_sanskrit": "ज्ञानेन यच्छेदात्मानं य इच्छेच्छान्तिमात्मनः।\nएतेषां चेदनुद्रष्टा पुरुषोऽपि सुदारुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2081977, "chapter_id": 2737, "verse_number": "१२-२४२-६", "content_sanskrit": "यदि वा सर्ववेदज्ञो यदि वाऽप्यनृचो द्विजः।\nयदि वा धार्मिको यज्वा यदि वा पापकृत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2081978, "chapter_id": 2737, "verse_number": "१२-२४२-७", "content_sanskrit": "यदि वा पुरुषव्याघ्रो यदि वैक्लव्यधारणः।\nतरत्येवं महादुर्गं जरामरणसागरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2081979, "chapter_id": 2737, "verse_number": "१२-२४२-८", "content_sanskrit": "एवं ह्येतेन योगेन युञ्जानो ह्येवमन्ततः।\nअपि जिज्ञासमानोऽपि शब्दब्रह्माऽतिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2081980, "chapter_id": 2737, "verse_number": "१२-२४२-९", "content_sanskrit": "धर्मोपस्थो ह्रीवरूथ उपायापायकूवरः।\nअपानाक्षः प्राणयुगः प्रज्ञायुर्जीववन्धनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2081981, "chapter_id": 2737, "verse_number": "१२-२४२-१०", "content_sanskrit": "चेतनाबन्धुरश्चारुश्चाचारग्रहनेमिमान्।\nदर्शनस्पर्शनवहो घ्राणश्रवणवाहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2081982, "chapter_id": 2737, "verse_number": "१२-२४२-११", "content_sanskrit": "प्रज्ञानाभिः सर्वतन्त्रप्रतोदो ज्ञानसारथिः।\nक्षेत्रज्ञाधिष्ठितो धीरः श्रद्धादमपुरः सरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2081983, "chapter_id": 2737, "verse_number": "१२-२४२-१२", "content_sanskrit": "त्यागरश्म्यनुगः क्षेम्यः शौचगो ध्यानगोतरः।\nजीवयुक्तो रथो दिव्यो ब्रह्मलोके धिराजते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2081984, "chapter_id": 2737, "verse_number": "१२-२४२-१३", "content_sanskrit": "अथ संत्वरमाणस्य रथमेवं युयुक्षतः।\nअक्षरं गन्तुमनसो विधिं वक्ष्यामि शीघ्रगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2081985, "chapter_id": 2737, "verse_number": "१२-२४२-१४", "content_sanskrit": "सप्त यो धारणाः कृत्स्ना वाग्यतः प्रतिपद्यते।\nपृष्ठतः पार्श्वतश्चान्यास्तावत्यस्ताः प्रधारणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2081986, "chapter_id": 2737, "verse_number": "१२-२४२-१५", "content_sanskrit": "क्रमशः पार्थिवं यच्च वायव्यं खं तथा पयः।\nज्योतिषो यत्तदैश्वर्यमहंकारस्य बुद्धितः।\nअव्यक्तस्य तथैश्वर्यं क्रमशः प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2081987, "chapter_id": 2737, "verse_number": "१२-२४२-१६", "content_sanskrit": "विक्रमाश्चापि यस्यैते तथा युङ्क्ते स योगतः।\nतथाऽस्य योगयुक्तस्य सिद्धिमात्मनि पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2081988, "chapter_id": 2737, "verse_number": "१२-२४२-१७", "content_sanskrit": "निर्मुच्यमानः सूक्ष्मत्वाद्रूपाणीमानि पश्यतः।\nशैशिरस्तु यथा धूमः सूक्ष्मः संश्रयते नभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2081989, "chapter_id": 2737, "verse_number": "१२-२४२-१८", "content_sanskrit": "तथा देहाद्विमुक्तस्य पूर्वरूपं भवत्युत।\nअथ धूमस्य विरमेद्द्वितीयं रूपदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2081990, "chapter_id": 2737, "verse_number": "१२-२४२-१९", "content_sanskrit": "जलरूपमिवाकाशे तत्रैवात्मनि पश्यति।\nअपां व्यतिक्रमे चास्य वह्निरूपं प्रकाशते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2081991, "chapter_id": 2737, "verse_number": "१२-२४२-२०", "content_sanskrit": "तस्मिन्नुपरते चास्य वायव्यं सूक्ष्ममव्ययम्।\nरूपं प्रकाशते तस्य पीतवस्त्रवदव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2081992, "chapter_id": 2737, "verse_number": "१२-२४२-२१", "content_sanskrit": "तस्मिन्नुपरते रुपमाकाशस्य प्रकाशते।\nतस्मिन्नुपरते चास्य बुद्धिरूपं प्रकाशते।\nऊर्णारूपसवर्णस्य तस्य रूपं प्रकाशते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2081993, "chapter_id": 2737, "verse_number": "१२-२४२-२२", "content_sanskrit": "अथ श्वेतां गतिं गत्वा सोहङ्कारे प्रकाशते।\nसुशुक्लं चेतसः सौक्ष्म्यमप्युक्तं ब्राह्मणस्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2081994, "chapter_id": 2737, "verse_number": "१२-२४२-२३", "content_sanskrit": "एतेष्वपि हि जातेषु फलजातानि मे शृणु।\nजातस्य पार्थिवैश्वर्यैः सृष्टिरिष्टा विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2081995, "chapter_id": 2737, "verse_number": "१२-२४२-२४", "content_sanskrit": "प्रजापतिरिवाक्षोभ्यः शरीरात्सृजते प्रजाः।\nअङ्गुल्यङ्गुष्ठमात्रेण हस्तपादेन वा तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2081996, "chapter_id": 2737, "verse_number": "१२-२४२-२५", "content_sanskrit": "पृथिवीं कम्पयत्येको गुणो वायोरिति श्रुतिः।\nआकाशभूतश्चाकाशे सवर्णत्वात्प्रकाशते।\nवर्णतो गृह्यते चाप्सु नापः पिबति चाशया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2081997, "chapter_id": 2737, "verse_number": "१२-२४२-२६", "content_sanskrit": "न चास्य तेजसां रूपं दृश्यते शाम्यते तथा।\nअहंकारेऽस्य विजिते पञ्चैते स्युर्वशानुगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2081998, "chapter_id": 2737, "verse_number": "१२-२४२-२७", "content_sanskrit": "षण्णामात्मनि बुद्धौ च जितायां प्रभवत्यथ।\nनिर्दोषा प्रतिभा ह्येनं कृत्स्ना समभिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2081999, "chapter_id": 2737, "verse_number": "१२-२४२-२८", "content_sanskrit": "तथैव व्यक्तमात्मानमव्यक्तं प्रतिपद्यते।\nयतो निःसरते लोको भवति व्यक्तसंज्ञकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2082000, "chapter_id": 2737, "verse_number": "१२-२४२-२९", "content_sanskrit": "तत्राव्यक्तमयीं विद्यां शृणु त्वं विस्तरेण मे।\nतथा व्यक्तमयं चैव संख्यापूर्वं निबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2082001, "chapter_id": 2737, "verse_number": "१२-२४२-३०", "content_sanskrit": "पञ्चविंसतितत्त्वानि तुल्यान्युभयतः समम्।\nयोगे साङ्ख्येऽपि च तथा विशेषं तत्र मे शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2082002, "chapter_id": 2737, "verse_number": "१२-२४२-३१", "content_sanskrit": "प्रोक्तं तद्व्यक्तमित्येव जायते वर्धते च यत्।\nजीर्यते म्रियते चैव चतुर्भिर्लक्षणैर्युतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2082003, "chapter_id": 2737, "verse_number": "१२-२४२-३२", "content_sanskrit": "विपरीतमतो यत्तु तदव्यक्तमुदाहृतम्।\nद्वावात्मानौ च वेदेषु सिद्धान्तेष्वप्युदाहृतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2082004, "chapter_id": 2737, "verse_number": "१२-२४२-३३", "content_sanskrit": "चतुर्लक्षणजं त्वाद्यं चतुर्वर्गं प्रचक्षते।\nव्यक्तमव्यक्तजं चैव तथा बुद्धिरथेतरत्॥\nसत्वं क्षेत्रज्ञ इत्येतद्द्वयमव्यक्तदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2082005, "chapter_id": 2737, "verse_number": "१२-२४२-३४", "content_sanskrit": "द्वावात्मानौ च वेदेषु विषयेष्वनुरज्यतः।\nविषयात्प्रतिसंहारः साङ्ख्यानां विद्धि लक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2082006, "chapter_id": 2737, "verse_number": "१२-२४२-३५", "content_sanskrit": "निर्ममश्चानहंकारो निर्द्वन्द्वश्छिन्नसंशयः।\nनैव क्रुध्यति न द्वेष्टि नानृता भाषते गिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2082007, "chapter_id": 2737, "verse_number": "१२-२४२-३६", "content_sanskrit": "आक्रुष्टस्ताडितश्चैव मैत्रीयं ध्याति नाशुभम्।\nवाग्दण्डकर्ममनसां त्रयाणां च निवर्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2082008, "chapter_id": 2737, "verse_number": "१२-२४२-३७", "content_sanskrit": "समः सर्वेषु भूतेषु ब्रह्माणमभिवर्तते।\nनैवेच्छति न चानिच्छो यात्रामात्रव्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2082009, "chapter_id": 2737, "verse_number": "१२-२४२-३८", "content_sanskrit": "अलोलुपोऽव्यथो दान्तो नाकृतिर्न निराकृतिः।\nनास्येन्द्रियमनेकाग्रं नाविक्षिप्तमनोरथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2082010, "chapter_id": 2737, "verse_number": "१२-२४२-३९", "content_sanskrit": "सर्वभूतसदृङ्भैत्रः समलोष्टाश्मकाञ्चनः।\nतुल्यप्रियाप्रियो धीरस्तुल्यनिन्दात्मसंस्तुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2082011, "chapter_id": 2737, "verse_number": "१२-२४२-४०", "content_sanskrit": "अस्पृहः सर्वकामेभ्यो ब्रह्मचर्यदृढव्रतः।\nअहिंस्रः सर्वभूतानामीदृक्साङ्ख्यो विमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2082012, "chapter_id": 2737, "verse_number": "१२-२४२-४१", "content_sanskrit": "यथा योगाद्विमुच्यन्ते कारणैर्यैर्निबोध तत्।\nयोगैश्वर्यमतिक्रान्तो योऽतिक्रामति मुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2082013, "chapter_id": 2737, "verse_number": "१२-२४२-४२", "content_sanskrit": "इत्येषा भावजा बुद्धिः कथिता ते न संशयः।\nएवं भवति निर्द्वन्द्वो ब्रह्माणं चाधिगच्छति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2082014, "chapter_id": 2737, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि द्विचत्वारिंशदधिकद्विशततमोऽध्यायः॥ २४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]