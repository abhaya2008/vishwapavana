[{"id": 2150120, "chapter_id": 4254, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2150121, "chapter_id": 4254, "verse_number": "१", "content_sanskrit": "ततोऽहं निशि राजेन्द्र प्रणम्य शिरसा तदा ।\nब्राह्मणानां पितॄणां च देवतानां च सर्वशः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2150122, "chapter_id": 4254, "verse_number": "२", "content_sanskrit": "नक्तञ्चराणां भूतानां रजन्याश्च विशाम्पते ।\nशयनं प्राप्य रहिते मनसा समचिन्तयम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2150123, "chapter_id": 4254, "verse_number": "३", "content_sanskrit": "जामदग्न्येन मे युद्धमिदं परमदारुणम् ।\nअहानि च बहून्यद्य वर्तते सुमहात्ययः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2150124, "chapter_id": 4254, "verse_number": "४", "content_sanskrit": "न च रामं महावीर्यं शक्नोमि रणमूर्धनि ।\nविजेतुं समरे विप्रं जामदग्न्यं महाबलम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2150125, "chapter_id": 4254, "verse_number": "५", "content_sanskrit": "यदि शक्यो मया जेतुं जामदग्न्यः प्रतापवान् ।\nदैवतानि प्रसन्नानि दर्शयन्तु निशां मम\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2150126, "chapter_id": 4254, "verse_number": "६", "content_sanskrit": "ततो निशि च राजेन्द्र प्रसुप्तः शरविक्षतः ।\nदक्षिणेनेह पार्श्वेन प्रभातसमये तदा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2150127, "chapter_id": 4254, "verse_number": "७", "content_sanskrit": "ततोऽहं विप्रमुख्यैस्तैर्यैरस्मि पतितो रथात् ।\nउत्थापितो धृतश्चैव मा भैरिति च सान्त्वितः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2150128, "chapter_id": 4254, "verse_number": "८", "content_sanskrit": "त एव मां महाभाग स्वप्ने दर्शनमेत्य वै ।\nपरिवार्याब्रुवन् वाक्यं तन्निबोध कुरूद्वह\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2150129, "chapter_id": 4254, "verse_number": "९", "content_sanskrit": "उत्तिष्ठ मा भैर्गाङ्गेय भयं ते नास्ति किञ्चन ।\nरक्षामहे नरव्याघ्र स्वशरीरं हि नो भवान्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2150130, "chapter_id": 4254, "verse_number": "१०", "content_sanskrit": "न त्वां रामो रणे जेता जामदग्न्यः कथञ्चन ।\nत्वमेव समरे रामं विजेता भरतर्षभ\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2150131, "chapter_id": 4254, "verse_number": "११", "content_sanskrit": "इदमस्त्रं सुदयितं प्रत्यभिज्ञास्यते भवान् ।\nउपस्थास्यति राजेन्द्र स्वयमेव तवानघ\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2150132, "chapter_id": 4254, "verse_number": "१२", "content_sanskrit": "येन शत्रून् महावीर्यान् प्रशासिष्यसि कौरव\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2150133, "chapter_id": 4254, "verse_number": "१३", "content_sanskrit": "विदितं हि तवाप्येतत् पूर्वस्मिन् देहधारणे ।\nप्राजापत्यं विश्वकृतं सुस्वापं नाम भारत\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2150134, "chapter_id": 4254, "verse_number": "१४", "content_sanskrit": "न हीदं वेद रामोऽपि पृथिव्यां वा पुमान् क्वचित् ।\nतत् स्मरस्व महाबाहो भृशं संयोजयस्व च\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2150135, "chapter_id": 4254, "verse_number": "१५", "content_sanskrit": "न च रामः क्षयं गन्ता तेनास्त्रेण नराधिप ।\nएनसा न तु संयोगं प्राप्स्यसे जातु मानद\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2150136, "chapter_id": 4254, "verse_number": "१६", "content_sanskrit": "स्वप्स्यते जामदग्न्योऽसौ त्वद्बाणबलपीडितः ।\nततो जित्वा त्वमेवैनं पुनरुत्थापयिष्यसि\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2150137, "chapter_id": 4254, "verse_number": "१७", "content_sanskrit": "अस्त्रेण दयितेनाजौ भीष्म सम्बोधनेन वै\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2150138, "chapter_id": 4254, "verse_number": "१८", "content_sanskrit": "एवं कुरुष्व कौरव्य प्रभाते रथमास्थितः ।\nप्रसुप्तं वा मृतं वेति तुल्यं मन्यामहे वयम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2150139, "chapter_id": 4254, "verse_number": "१९", "content_sanskrit": "न च रामेण मर्तव्यं कदाचिदपि पार्थिव ।\nततः समुत्पन्नमिदं प्रस्वापं युज्यतामिति\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2150140, "chapter_id": 4254, "verse_number": "२०", "content_sanskrit": "इत्युक्त्वाऽन्तर्हिता राजन् सर्व एव द्विजोत्तमाः ।\nअष्टौ सदृशरूपास्ते सर्वे भासुरमूर्तयः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2150141, "chapter_id": 4254, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि पञ्चाशीत्युत्तरशततमोऽध्यायः ॥१८५॥\nअम्बोपाख्यानपर्वणि पञ्चदशोऽध्यायः ॥१५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]