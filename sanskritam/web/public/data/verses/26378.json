[{"id": 7006378000, "chapter_id": 26378, "verse_number": "२-३५-१", "content_sanskrit": "वैशम्पायन उवाच\nमथुरोपवने गत्वा निविष्टांस्तान् नराधिपान् ।\nअपश्यन् वृष्णयः सर्वे पुरस्कृत्य जनार्दनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006378001, "chapter_id": 26378, "verse_number": "२-३५-२", "content_sanskrit": "ततो हृष्टमनाः कृष्णो रामं वचनमब्रवीत् ।\nत्वरते खलु कार्यार्थो देवतानां न संशयः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006378002, "chapter_id": 26378, "verse_number": "२-३५-३", "content_sanskrit": "यथायं संनिकृष्टो हि जरासंधो नराधिपः ।\nलक्ष्यन्ते हि ध्वजाग्राणि रथानां वातरंहसाम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006378003, "chapter_id": 26378, "verse_number": "२-३५-४", "content_sanskrit": "एतानि शशिकल्पानि नृपाणां विजिगीषताम् ।\nछत्राण्यार्य विराजन्ते प्रोच्छ्रितानि सितानि च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006378004, "chapter_id": 26378, "verse_number": "२-३५-५", "content_sanskrit": "अहो नृपरथोदग्रा विमलाश्छत्रपङ्क्तयः ।\nअभिवर्तन्ति नः शुभ्रा यथा खे हंसपङ्क्तयः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006378005, "chapter_id": 26378, "verse_number": "२-३५-६", "content_sanskrit": "नृपः प्राप्तो जरासंधो महीपतिः ।\nआवयोर्युद्धनिकषः प्रथमः समरातिथिः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006378006, "chapter_id": 26378, "verse_number": "२-३५-७", "content_sanskrit": "आर्य तिष्ठाव सहितावनुप्राप्ते महीपतौ ।\nयुद्धारम्भः प्रयोक्तव्यो बलं तावद्विमृश्यताम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006378007, "chapter_id": 26378, "verse_number": "२-३५-८", "content_sanskrit": "एवमुक्त्वा ततः कृष्णः स्वस्थः संग्रामलालसः ।\nजरासंधबलं प्रेप्सुश्चकार बलदर्शनम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006378008, "chapter_id": 26378, "verse_number": "२-३५-९", "content_sanskrit": "वीक्षमाणश्च तान् सर्वान् नृपान् यदुवरोऽव्ययः ।\nआत्मनैवात्मनो वाक्यमुवाच हृदि मन्त्रवित् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006378009, "chapter_id": 26378, "verse_number": "२-३५-१०", "content_sanskrit": "इमे ते पृथिवीपालाः पार्थिवे वर्त्मनि स्थिताः ।\nये विनाशं गमिष्यन्ति शास्त्रदृष्टेन कर्मणा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006378010, "chapter_id": 26378, "verse_number": "२-३५-११", "content_sanskrit": "प्रोक्षितान् खल्विमान्मन्ये मृत्युना नृपपुङ्गवान् ।\nस्वर्गगामीनि चाप्येषां वपूंषि प्रचकाशिरे ॥ ११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006378011, "chapter_id": 26378, "verse_number": "२-३५-१२", "content_sanskrit": "स्थाने भारपरिश्रान्ता वसुधेयं दिवं गता ।\nएषां नृपाणां मुख्यानां बलौघैरभिपीडिता ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006378012, "chapter_id": 26378, "verse_number": "२-३५-१३", "content_sanskrit": "मही निरन्तरा चेयं बलराष्ट्राभिसंवृता ।\nस्वल्पेन खलु कालेन विविक्तं पृथिवीतलम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006378013, "chapter_id": 26378, "verse_number": "२-३५-१४", "content_sanskrit": "भविष्यति नरेन्द्रौघैः शतशो विनिपातितैः ।\nवैशम्पायन उवाच\nजरासंधस्ततः क्रुद्धः प्रभुः सर्वमहीक्षिताम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006378014, "chapter_id": 26378, "verse_number": "२-३५-१५", "content_sanskrit": "नराधिपसहस्रौघैरनुयातो महाद्युतिः ।\nव्यायतोदग्रतुरगैः सुयानैः सुसमाहितैः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006378015, "chapter_id": 26378, "verse_number": "२-३५-१६", "content_sanskrit": "रथैः सांग्रामिकैर्युक्तैरसङ्गगतिभिः क्वचित् ।\nहेमकक्षैर्महाघण्टैर्वारणैर्वारिदोपमैः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006378016, "chapter_id": 26378, "verse_number": "२-३५-१७", "content_sanskrit": "महामात्रोत्तमारूढैः कल्पितै रणकोविदैः ।\nस्वारूढैः सादिभिर्युक्तैः प्रेङ्खमाणैः प्रवल्गितैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006378017, "chapter_id": 26378, "verse_number": "२-३५-१८", "content_sanskrit": "वाजिभिर्वायुसंकाशैः प्लवद्भिरिव पत्रिभिः ।\nखड्गचर्मधरोदग्रैः पत्तिभिर्बलिनां वरैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006378018, "chapter_id": 26378, "verse_number": "२-३५-१९", "content_sanskrit": "सहस्रसंख्यासंयुक्तैरुत्पतद्भिरिवोरगैः ।\nएवं चतुर्विधैः सैन्यैः कम्पमानैरिवाम्बुदैः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006378019, "chapter_id": 26378, "verse_number": "२-३५-२०", "content_sanskrit": "नृपः प्रयातो बलवाञ्जरासंधो धृतव्रतः ।\nस रथैर्मेघनिर्घोषैर्गजैश्च मदसंयुतैः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006378020, "chapter_id": 26378, "verse_number": "२-३५-२१", "content_sanskrit": "ह्रेषमाणैश्च तुरगैः क्ष्वेडमानैश्च पत्तिभिः ।\nनादयानो दिशः सर्वास्तस्याः पुर्या वनानि च ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006378021, "chapter_id": 26378, "verse_number": "२-३५-२२", "content_sanskrit": "स राजा सागराकारः ससैन्यः प्रत्यदृश्यत ।\nतद्बलं पृथिवीशानां हृष्टयोधजनाकुलम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006378022, "chapter_id": 26378, "verse_number": "२-३५-२३", "content_sanskrit": "क्ष्वेडितास्फोटितरवं मेघसैन्यमिवाबभौ ।\nरथैः पवनसम्पातैर्गजैश्च जलदोपमैः ।\nतुरगैश्च जवोपेतैः पत्तिभिः खगमोपमैः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006378023, "chapter_id": 26378, "verse_number": "२-३५-२४", "content_sanskrit": "विमिश्रं सर्वतो भाति मत्तद्विपसमाकुलम् ।\nघर्मान्ते सागरगतं यथाभ्रपटलं तथा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006378024, "chapter_id": 26378, "verse_number": "२-३५-२५", "content_sanskrit": "सबलास्ते महीपाला जरासंधपुरोगमाः ।\nपरिवार्य पुरीं सर्वे निवेशायोपचक्रिरे ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006378025, "chapter_id": 26378, "verse_number": "२-३५-२६", "content_sanskrit": "बभौ तस्य निविष्टस्य बलश्रीःशिबिरस्य वै ।\nशुक्लपर्यन्तपूर्णस्य यथा रूपं महोदधेः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006378026, "chapter_id": 26378, "verse_number": "२-३५-२७", "content_sanskrit": "वीतरात्रे ततः काले समुत्तस्थुमहीक्षितः ।\nआरोहणार्थं पुर्यास्ते समीयुर्युद्धलालसाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006378027, "chapter_id": 26378, "verse_number": "२-३५-२८", "content_sanskrit": "समवायीकृताः सर्वे यमुनामनु ते नृपाः ।\nनिविष्टा मन्त्रयामासुर्युद्धकालकुतूहलाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006378028, "chapter_id": 26378, "verse_number": "२-३५-२९", "content_sanskrit": "तेषां सुतुमुलः शब्दः शुश्रुवे पृथिवीक्षिताम् ।\nयुगान्ते भिद्यमानानां सागराणामिव स्वनः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006378029, "chapter_id": 26378, "verse_number": "२-३५-३०", "content_sanskrit": "तेषां सकञ्चुकोष्णीषाः स्थविरा वेत्रपाणयः ।\nचेरुर्मा शब्द इत्येवं वदन्तो राजशासनात् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006378030, "chapter_id": 26378, "verse_number": "२-३५-३१", "content_sanskrit": "तस्य रूपं बलस्यासीन्निःशब्दस्तिमितस्य वै ।\nलीनमीनग्रहस्येव निःशब्दस्य यथोदधेः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006378031, "chapter_id": 26378, "verse_number": "२-३५-३२", "content_sanskrit": "निःशब्दस्तिमिते तस्मिन् योगादिव महार्णवे ।\nजरासंधो बृहद् वाक्यं बृह्स्पतिरिवाददे ॥ ३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006378032, "chapter_id": 26378, "verse_number": "२-३५-३३", "content_sanskrit": "शी्घ्रं समभिवर्तन्तां बलानि पृथिवीक्षिताम् ।\nसर्वतो नगरी चेयं जनौघैः परिवार्यताम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006378033, "chapter_id": 26378, "verse_number": "२-३५-३४", "content_sanskrit": "अश्मयन्त्राणि युज्यन्तां क्षेपणीयाश्च मुद्गराः ।\nकार्या भूमिः समा सर्वा जलौघैश्च परिप्लुता ।\nऊर्ध्वं चापा निवाह्यन्तां प्रासा वै तोमरास्तथा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006378034, "chapter_id": 26378, "verse_number": "२-३५-३५", "content_sanskrit": "दयितां चैव टङ्काद्यैः खनित्रैश्च पुरी द्रुतम् ।\nनृपाश्च युद्धमार्गज्ञा विन्यस्यन्ताभदूरतः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006378035, "chapter_id": 26378, "verse_number": "२-३५-३६", "content_sanskrit": "अद्यप्रभृति सैन्यैर्मे पुरीरोधः प्रवर्त्यताम् ।\nयावदेतौ रणे गोपौ वसुदेवसुतावुभौ ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006378036, "chapter_id": 26378, "verse_number": "२-३५-३७", "content_sanskrit": "संकर्षणं च कृष्णं च घातयामि शितैः शरैः ।\nआकाशमपि पाणौघैर्निःसम्पातं यथा भवेत् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006378037, "chapter_id": 26378, "verse_number": "२-३५-३८", "content_sanskrit": "मयानुशिष्टास्तिष्ठन्तु पुरीभूमिषु भूमिपाः ।\nतेषु तेष्ववकाशेषु शीघ्रमारुह्यतां पुरी ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006378038, "chapter_id": 26378, "verse_number": "२-३५-३९", "content_sanskrit": "मद्रः कलिङ्गाधिपतिश्चेकितानः सबाह्लिकः ।\nकाश्मीरराजो गोनर्दः करूषाधिपतिस्तथा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006378039, "chapter_id": 26378, "verse_number": "२-३५-४०", "content_sanskrit": "पुनः किम्पुरुषश्चैव पर्वतीयो ह्यनामयः ।\nनगर्याः पश्चिमं द्वारं शीघ्रमारोधयन्त्विति ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006378040, "chapter_id": 26378, "verse_number": "२-३५-४१", "content_sanskrit": "पौरवो वेणुदारिश्च वैदर्भः सोमकस्तथा ।\nरुक्मी च भोजाधिपतिः सूर्याक्षश्चैव मालवः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006378041, "chapter_id": 26378, "verse_number": "२-३५-४२", "content_sanskrit": "विन्दानुविन्दावावन्त्यौ दन्तवक्त्रश्च वीर्यवान् ।\nछागलिः पुरमित्रश्च विराटश्च महीपतिः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006378042, "chapter_id": 26378, "verse_number": "२-३५-४३", "content_sanskrit": "कौरव्यो मालवश्चैव शतधन्वा विदूरथः ।\nभूरिश्रवास्त्रिगर्तश्च बाणः पञ्चनदस्तथा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006378043, "chapter_id": 26378, "verse_number": "२-३५-४४", "content_sanskrit": "उत्तरं नगरद्वारमेते दुर्गसहा नृपाः ।\nआरुह्य चाभिमर्दन्तां वज्रप्रतिमगौरवाः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006378044, "chapter_id": 26378, "verse_number": "२-३५-४५", "content_sanskrit": "उलूकः कैतवश्चैव वीरश्चांशुमतः सुतः ।\nएकलव्यो बृहत्क्षत्रः क्षत्रधर्मा जयद्रथः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006378045, "chapter_id": 26378, "verse_number": "२-३५-४६", "content_sanskrit": "उत्तमौजाश्च शल्यश्च कौरवाः कैकयास्तथा ।\nवैदिशो वामदेवश्च सांकृतिश्च सिनीपतिः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006378046, "chapter_id": 26378, "verse_number": "२-३५-४७", "content_sanskrit": "पूर्वं नगरनिर्व्यूहमैतेष्वायत्तमस्तु नः ।\nदारयन्तो विधावन्तु वाता इव बलाहकान् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006378047, "chapter_id": 26378, "verse_number": "२-३५-४८", "content_sanskrit": "अहं च दरदश्चैव चेदिराजश्च वीर्यवान् ।\nदक्षिणं नगरद्वारं पालयामः सुदंशिताः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006378048, "chapter_id": 26378, "verse_number": "२-३५-४९", "content_sanskrit": "एवमेषा पुरी क्षिप्रं समन्ताद् वेष्टिता बलैः ।\nवज्रावपातविषमं प्राप्नोतु तुमुलं भयम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006378049, "chapter_id": 26378, "verse_number": "२-३५-५०", "content_sanskrit": "गदिनो ये गदाभिस्ते परिघैः परिघायुधाः ।\nअपरे विविधैः शस्त्रैर्दारयन्तु पुरीमिमाम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006378050, "chapter_id": 26378, "verse_number": "२-३५-५१", "content_sanskrit": "अद्यैव नगरी ह्येषा विषमोच्चयसंकटा ।\nकार्या भूमिसमा सर्वा भवद्भिर्वसुधारधिपैः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006378051, "chapter_id": 26378, "verse_number": "२-३५-५२", "content_sanskrit": "चतुरङ्गबलैर्व्यूह्य जरासंधो व्यवस्थितः ।\nअथाभ्ययाद् यदून् क्रुद्धैः सह सर्वैर्नराधिपैः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006378052, "chapter_id": 26378, "verse_number": "२-३५-५३", "content_sanskrit": "प्रतिजग्मुर्दशार्हास्तं व्यूढानीकाः प्रहारिणः ।\nतद् युद्धमभवद् घोरं तेषां देवासुरोपमम् ।\nअल्पानां बहुभिः सार्धं व्यतिषक्तरथद्विपम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006378053, "chapter_id": 26378, "verse_number": "२-३५-५४", "content_sanskrit": "नगरान्निस्सृतौ दृष्ट्वा वसुदेवसुतावुभौ ।\nक्षुभितं नृवरानीकं त्रस्तसम्मूढवाहनम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006378054, "chapter_id": 26378, "verse_number": "२-३५-५५", "content_sanskrit": "रथस्थौ दंशितौ चैव चेरतुस्तत्र यादवौ ।\nमकराविव संरब्धौ समुद्रक्षोभणावुभौ ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006378055, "chapter_id": 26378, "verse_number": "२-३५-५६", "content_sanskrit": "तयोः प्रयुध्यतोः संख्ये मतिरासीन्महात्मनोः ।\nआयुधानां पुराणानामादानकृतलक्षणा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006378056, "chapter_id": 26378, "verse_number": "२-३५-५७", "content_sanskrit": "ततः खान्निपतन्ति स्म दिव्यान्याहवसम्प्लवे ।\nलेलिहानानि दीप्तानि महान्ति सुदृढानि च ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006378057, "chapter_id": 26378, "verse_number": "२-३५-५८", "content_sanskrit": "क्रव्यादैरनुयातानि मूर्तिमन्ति बृहन्ति च ।\nतृषितान्याहवे भोक्तुं नृपमांसानि वै भृशम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006378058, "chapter_id": 26378, "verse_number": "२-३५-५९", "content_sanskrit": "दिव्यस्रग्दामधारीणि त्रासयन्ति च खेचरान् ।\nप्रभया भासमानानि पतमानानि चाम्बरात् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006378059, "chapter_id": 26378, "verse_number": "२-३५-६०", "content_sanskrit": "हलं संवर्तकं नामं सौनन्दं मुसलं तथा ।\nधनुषां प्रवरं शार्ङ्गं गदा कौमोदकी तथा ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006378060, "chapter_id": 26378, "verse_number": "२-३५-६१", "content_sanskrit": "चत्वार्येतानि तेजांसि विष्णुप्रहरणानि च ।\nताभ्यां समवतीर्णानि यादवाभ्यां महामृधे ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006378061, "chapter_id": 26378, "verse_number": "२-३५-६२", "content_sanskrit": "जग्राह प्रथमं रामो ललामप्रतिमं हलम् ।\nसर्पन्तमिव सर्पेन्द्रं दिव्यमालाकुलं मृधे ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006378062, "chapter_id": 26378, "verse_number": "२-३५-६३", "content_sanskrit": "सौनन्दं च ततः श्रीमान् निरानन्दकरं द्विषाम् ।\nसव्येन सात्वतां श्रेष्ठो जग्राह मुसलोत्तमम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006378063, "chapter_id": 26378, "verse_number": "२-३५-६४", "content_sanskrit": "दर्शनीयं च लोकेषु धनुर्जलदनिःस्वनम् ।\nनाम्ना शार्ङ्गमिति ख्यातं कृप्णो जग्राह वीर्यवान् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006378064, "chapter_id": 26378, "verse_number": "२-३५-६५", "content_sanskrit": "देवैर्निगदितार्थस्य गदा तस्यापरे करे ।\nनिक्षिप्ता कुमुदाक्षस्य नाम्ना कौमोदकीति सा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006378065, "chapter_id": 26378, "verse_number": "२-३५-६६", "content_sanskrit": "तौ सप्रहरणौ वीरौ साक्षात् विष्णुतनूपमौ ।\nसमरे रामगोविन्दौ रिपूंस्तान् प्रत्ययुद्ध्यताम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006378066, "chapter_id": 26378, "verse_number": "२-३५-६७", "content_sanskrit": "सायुधप्रग्रहौ वीरौ तावन्याश्रयावुभौ ।\nपूर्वजानुजसंज्ञौ तौ रामगोविन्दलक्षणौ ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006378067, "chapter_id": 26378, "verse_number": "२-३५-६८", "content_sanskrit": "द्विषत्सु प्रतिकुर्वाणौ पराक्रान्तौ यथेश्वरौ ।\nविचेरतुर्यथा देवौ वसुदेवसुतावुभौ ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006378068, "chapter_id": 26378, "verse_number": "२-३५-६९", "content_sanskrit": "हलमुद्यम्य रामस्तु सर्पेन्द्रमिव कोपितः ।\nचचार समरे वीरो विद्विषामन्तको यथा ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006378069, "chapter_id": 26378, "verse_number": "२-३५-७०", "content_sanskrit": "विकर्षन् रथवृन्दानि क्षत्रियाणां महात्मनाम् ।\nचकार रोषं सफलं नागेषु च हयेषु च ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006378070, "chapter_id": 26378, "verse_number": "२-३५-७१", "content_sanskrit": "कुञ्जराल्लाँङ्गलक्षिप्तान् मुसलाक्षेपताडितान् ।\nरामो विराजन् समरे निर्ममन्थ यथाचलान् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006378071, "chapter_id": 26378, "verse_number": "२-३५-७२", "content_sanskrit": "ते वध्यमाना रामेण रणे क्षत्रियपुङ्गवाः ।\nजरासंधान्तिकं भीताः समरात् प्रतिजग्मिरे ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006378072, "chapter_id": 26378, "verse_number": "२-३५-७३", "content_sanskrit": "तानुवाच जरासंधः क्षत्रधर्मे व्यवस्थितः ।\nधिगेतां क्षत्रवृत्तिं वः समरे कातरान्मनाम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006378073, "chapter_id": 26378, "verse_number": "२-३५-७४", "content_sanskrit": "परावृत्तस्य समरे विरथस्य पलायतः ।\nभ्रूणहत्यामिवासह्यां प्रवदन्ति मनीषिणः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006378074, "chapter_id": 26378, "verse_number": "२-३५-७५", "content_sanskrit": "भीताः कस्मान्निवर्तध्वं धिगेनां क्षत्रवृत्तिताम् ।\nक्षिप्रं सर्वे निवर्तध्वं मम वाक्येन चोदिताः ॥ ७५। ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006378075, "chapter_id": 26378, "verse_number": "२-३५-७६", "content_sanskrit": "अथवा तिष्ठत रथैः प्रेक्षकाः समवस्थिताः ।\nयावदेतौ रणे गोपौ प्रेषयामि यमक्षयम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006378076, "chapter_id": 26378, "verse_number": "२-३५-७७", "content_sanskrit": "ततस्ते क्षत्रियाः सर्वे जरासंधेन नोदिताः ।\nसृजन्तः शरजालानि हृष्टा योद्धुं व्यवस्थिताः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006378077, "chapter_id": 26378, "verse_number": "२-३५-७८", "content_sanskrit": "ते हयैः काञ्चनापीडै रथैश्चाम्बुदनादिभिः ।\nनागैश्चाम्बुदसंकाशैर्महामात्रप्रचोदितैः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006378078, "chapter_id": 26378, "verse_number": "२-३५-७९", "content_sanskrit": "सतनुत्राः सनिस्त्रिंशाः सपताकायुधध्वजाः ।\nस्वारोपितधनुष्मन्तः सतूणीराः सतोमराः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006378079, "chapter_id": 26378, "verse_number": "२-३५-८०", "content_sanskrit": "सच्छत्राः सादिनश्चैव चारुचामरवीजिताः ।\nरणे तेऽधिगता रेजुः स्यन्दनस्था महीक्षितः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006378080, "chapter_id": 26378, "verse_number": "२-३५-८१", "content_sanskrit": "तै युद्धरागा रथिनो व्यगाहन्त युधां वराः ।\nगदाभिश्चैव गुर्वीभिः क्षेपणीयैश्च मुद्गरैः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006378081, "chapter_id": 26378, "verse_number": "२-३५-८२", "content_sanskrit": "एतस्मिन्नन्तरे तत्र देवानां नन्दिवर्धनः ।\nसुपर्णध्वजमास्थाय कृष्णस्तु रथमुत्तमम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006378082, "chapter_id": 26378, "verse_number": "२-३५-८३", "content_sanskrit": "समभ्ययाज्जरास्रधं शर्रौर्वेव्याध चाष्टभिः ।\nसारथिं चास्य विव्याध पञ्चभिर्निशितैः शरैः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006378083, "chapter_id": 26378, "verse_number": "२-३५-८४", "content_sanskrit": "जघान तुरगांश्चाजौ यतमानस्य वीर्यवान् ।\nतं कृच्छ्रगतमाज्ञाय चित्रसेनो महारथः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006378084, "chapter_id": 26378, "verse_number": "२-३५-८५", "content_sanskrit": "सेनानीः कैशिकश्चैव कृष्णं विविधतुः शरैः ।\nत्रिभिर्विव्याध संसक्तं बलदेवं च कैशिकः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006378085, "chapter_id": 26378, "verse_number": "२-३५-८६", "content_sanskrit": "बलदेवो धनुश्चास्य भल्लेनाजौ द्विधाकरोत् ।\nजवेनाभ्यर्दयच्चापि तानरीञ्छरवृष्टिभिः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006378086, "chapter_id": 26378, "verse_number": "२-३५-८७", "content_sanskrit": "बहुभिर्बहुधा वीरान् समन्तात् स्वर्णभूषणैः ।\nतं चित्रसेनः संरब्धो विव्याध नवभिः शरैः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006378087, "chapter_id": 26378, "verse_number": "२-३५-८८", "content_sanskrit": "कैशिकः पञ्चभिश्चापि जरासंधश्च सप्तभिः ।\nत्रिभिस्त्रिभिश्च नाराचैस्तान् बिभेद जनार्दनः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006378088, "chapter_id": 26378, "verse_number": "२-३५-८९", "content_sanskrit": "पञ्चभिः पञ्चभिश्चैव बलदेवः शितैः शरैः ।\nरथं चैवास्य चिच्छेद चित्रसेनस्य वीर्यवान् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006378089, "chapter_id": 26378, "verse_number": "२-३५-९०", "content_sanskrit": "बलदेवो धनुश्चास्य भल्लेनाजौ द्विधाकरोत् ।\nस च्छिन्नधन्वा विरथो गदामादाय वीर्यवान् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006378090, "chapter_id": 26378, "verse_number": "२-३५-९१", "content_sanskrit": "अभ्यधावत् सुसंरब्धो जिघांसुर्मुसलायुधम् ।\nसिसृक्षतस्तु नाराचाश्चित्रसेनवधैषिणः ।\nधनुश्चिच्छेद रामस्य जरासंधो महाबलः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006378091, "chapter_id": 26378, "verse_number": "२-३५-९२", "content_sanskrit": "गदया च जघानाश्वान् क्रोधात् स मगधेश्वरः ।\nरामं चाभ्यद्रवद् वीरो जरासंधो महाबलः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006378092, "chapter_id": 26378, "verse_number": "२-३५-९३", "content_sanskrit": "आदाय मुसलं रामो जरासंधमुपाद्रवत् ।\nतयोस्तद् युद्धमभवत् परस्परवधैषिणोः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006378093, "chapter_id": 26378, "verse_number": "२-३५-९४", "content_sanskrit": "चित्रसेनस्तु संसक्तं दृष्ट्वा रामेण मागधम् ।\nरथमन्यं समारुह्य जरासंधमवारयत् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006378094, "chapter_id": 26378, "verse_number": "२-३५-९५", "content_sanskrit": "ततो बलेन महता गजानीकेन चाप्यथ ।\nउभयोरन्तरे ताभ्यां स्वकुलं समपद्यत ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006378095, "chapter_id": 26378, "verse_number": "२-३५-९६", "content_sanskrit": "ततः सैन्येन महता जरासंधोऽभिसंवृतः ।\nरामकृष्णाग्रगान् भोजानाससाद महाबलः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006378096, "chapter_id": 26378, "verse_number": "२-३५-९७", "content_sanskrit": "तत्र प्रक्षुभितस्येव सागरस्य महास्वनः ।\nप्रादुर्बभूव तुमुलः सेनयोरुभयोरपि ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006378097, "chapter_id": 26378, "verse_number": "२-३५-९८", "content_sanskrit": "वेणुभेरीमृदङ्गानां शङ्खानां च सहस्रशः ।\nउभयोः सेनयो राजन् प्रादुरासीन्महास्वनः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7006378098, "chapter_id": 26378, "verse_number": "२-३५-९९", "content_sanskrit": "क्ष्वेडितास्फोटितोत्क्रुष्टैस्तुमुलः सर्वतोऽभवत् ।\nउत्पपात रजश्चापि खुरनेमिसमुद्धतम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7006378099, "chapter_id": 26378, "verse_number": "२-३५-१००", "content_sanskrit": "समुद्यतमहाशस्त्राः प्रगृहीतशरासनाः ।\nअन्योन्यमभिगर्जन्तः शूरास्तत्रावतस्थिरे ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7006378100, "chapter_id": 26378, "verse_number": "२-३५-१०१", "content_sanskrit": "रथिनः सादिनश्चैव पत्तयश्च सहस्रशः ।\nगजाश्चातिबलास्तत्र समुत्पेतुः समन्ततः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7006378101, "chapter_id": 26378, "verse_number": "२-३५-१०२", "content_sanskrit": "स संनिपातस्तुमुलस्त्यक्त्वा प्राणानवर्तत ।\nवृष्णिभिः सह योधानां जरासंधस्य दारुणः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7006378102, "chapter_id": 26378, "verse_number": "२-३५-१०३", "content_sanskrit": "ततः शिनिरनाधृष्टिर्बभ्रुर्विपृथुराहुकः ।\nबलदेवं पुरस्कत्य सैन्यस्याद्धेंन दंशिताः ॥१०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7006378103, "chapter_id": 26378, "verse_number": "२-३५-१०४", "content_sanskrit": "दक्षिणं पक्षमासेदुः शत्रुसैन्यस्य भारत ।\nपालितं चेदिराजेन जरासंधेन वा विभो ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7006378104, "chapter_id": 26378, "verse_number": "२-३५-१०५", "content_sanskrit": "उदीच्यैश्च महावीर्यैः शल्यशाल्वादिभिर्नृपैः ।\nसृजन्तः शरवर्षाणि समभित्यक्तजीविताः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7006378105, "chapter_id": 26378, "verse_number": "२-३५-१०६", "content_sanskrit": "अवगाहः पृथुः कङ्कः शतद्युम्नो विदूरथः ।\nहृषीकेशं पुरस्कृत्य सैन्यस्यार्द्धेन दंशिताः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7006378106, "chapter_id": 26378, "verse_number": "२-३५-१०७", "content_sanskrit": "भीष्मकेणाभिगुप्तश्च रुक्मिणा च महात्मना ।\nदेवकेनापि राजेन्द्र तथा मद्रेश्वरेण च ॥१०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7006378107, "chapter_id": 26378, "verse_number": "२-३५-१०८", "content_sanskrit": "प्राच्यैश्च दाक्षिणान्यैश्च गुप्तवीर्यबलान्वितैः ।\nतेषां च युद्धमभवत् समभित्यक्तजीवितम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7006378108, "chapter_id": 26378, "verse_number": "२-३५-१०९", "content_sanskrit": "शक्त्यृष्टिप्रासबाणौघान् सृजतामशनिस्वनान् ।\nसात्यकिश्चित्रकः श्यामो युयुधानश्च वीर्यवान् ।\nराजाधिदेवो मृदुरः श्वफल्कश्च महारथः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7006378109, "chapter_id": 26378, "verse_number": "२-३५-११०", "content_sanskrit": "सत्राजिच्च प्रसेनश्च बलेन महता वृताः ।\nव्यूहस्य पुच्छं ते सर्वे प्रतीयुर्द्विषतां मृधे ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7006378110, "chapter_id": 26378, "verse_number": "२-३५-१११", "content_sanskrit": "व्यूहस्यार्द्धं समासेदुर्मृदुरेणाभिरक्षिताः ।\nराजभिश्चापि बहुभिर्वैणुदारिमुखैः सह ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}]