[{"id": 7005862000, "chapter_id": 25862, "verse_number": "१-४५-१", "content_sanskrit": "हरिरुवाच ।\nप्रसङ्गात्कथयिष्यामि शालग्रामस्य लक्णम्।\nशालग्रामशिलास्पर्शात्कोटिजन्माघनाशनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005862001, "chapter_id": 25862, "verse_number": "१-४५-२", "content_sanskrit": "शङ्खचक्रगदापद्मी (हस्तः) (केशवाख्यो गदाधरः।\nसब्जकौमादकीचक्रशङ्खी (नारायणो) विभुः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005862002, "chapter_id": 25862, "verse_number": "१-४५-३", "content_sanskrit": "सचक्रशङ्खाब्जगदो (माधवः) श्रीगदाधरः ।\nगदब्जशङ्खचक्री वा (गोविन्दो)ऽर्च्यो गदाधरः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005862003, "chapter_id": 25862, "verse_number": "१-४५-४", "content_sanskrit": "पद्मशङ्खारिगादिने (विष्णुरूपाय) ते नमः ।\nसशङ्खाब्जगदाचक्र (मधुसूदनमूर्त्तये) ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005862004, "chapter_id": 25862, "verse_number": "१-४५-५", "content_sanskrit": "नमो गदारिशङ्खाब्जयुक्त(त्रैविक्रमाय)च।\nसारिकौमोदकीपद्मशङ्ख(वामनमूर्त्तये) ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005862005, "chapter_id": 25862, "verse_number": "१-४५-६", "content_sanskrit": "चक्राब्जशङ्खगादिने नमः (श्रीधरमूर्त्तये।\n(हृषीकेशाया)ऽब्जगदाशङ्खिने चक्रिणे नमः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005862006, "chapter_id": 25862, "verse_number": "१-४५-७", "content_sanskrit": "साब्जचक्रगदाशङ्ख(पद्मनाभस्वरूपिणे) ।\nशङ्खचक्रगदापद्मिन् (दामोदर) मनोनमः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005862007, "chapter_id": 25862, "verse_number": "१-४५-८", "content_sanskrit": "सारिशङ्खगदाब्जाय (वासुदेवाय) वै नमः ।\nशङ्खाब्जचक्रगादिने नमः (सङ्कर्षणाय) च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005862008, "chapter_id": 25862, "verse_number": "१-४५-९", "content_sanskrit": "सुशङ्खसुगदाब्जारिधृते (प्रद्युम्नमूर्त्तय)।\nनमो(ऽनिरुद्धाय) गदाशङ्खाब्जारीविधारिणे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005862009, "chapter_id": 25862, "verse_number": "१-४५-१०", "content_sanskrit": "साब्जशङ्खगदाचक्र(पुरुषोत्तममूर्त्तये) ।\nनमो(ऽधोक्षजरूपाय) गदाशङ्खारिपद्मिने ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005862010, "chapter_id": 25862, "verse_number": "१-४५-११", "content_sanskrit": "(नृसिंहमूर्त्तये) पद्मगदाशङ्खारिधारिणे ।\nपद्मारिशङ्खगदिने नमोऽ(स्त्वच्युतमूर्त्तये) ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005862011, "chapter_id": 25862, "verse_number": "१-४५-१२", "content_sanskrit": "सशङ्कचक्राब्जगदं (जनार्दन) मिहानये ।\n(उपेंद्रः) सगदः सारिः पद्मशङ्‌खिन्नमोनमः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005862012, "chapter_id": 25862, "verse_number": "१-४५-१३", "content_sanskrit": "सुचक्राब्जगदाशङ्‌खयुक्ताय (हरिमूर्त्तये) ।\nसगदाब्जारिशङ्‌खाय नमः (श्रीकृष्णमूर्त्तये) ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005862013, "chapter_id": 25862, "verse_number": "१-४५-१४", "content_sanskrit": "शालग्रामशिलाद्वारगतलग्नद्विचक्रधृक्‌ ।\nशुक्लाभो(वासुदेवाख्यः) सोऽव्याद्वः श्रीगदाधरः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005862014, "chapter_id": 25862, "verse_number": "१-४५-१५", "content_sanskrit": "लग्नद्विचक्रो रक्ताभः पूर्वभागस्तुपुष्कलः ।\nसंकर्षणोऽथ(प्रद्युम्नः) सूक्ष्मचक्रस्तु पीतकः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005862015, "chapter_id": 25862, "verse_number": "१-४५-१६", "content_sanskrit": "स दीर्घः सशिरश्छिद्रो यो(ऽनिरुद्धस्तु) वर्तल।\nनीलो द्वारि त्रिरेखश्च अथ (नारायणो)ऽसितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005862016, "chapter_id": 25862, "verse_number": "१-४५-१७", "content_sanskrit": "मध्ये गादकृती रेखा नाभिचक्रो (क्र) महोन्नतः ।\nपृथुवक्षा (नृसिंहो) वः कपिलोऽव्यात्त्रिबिन्दुकः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005862017, "chapter_id": 25862, "verse_number": "१-४५-१८", "content_sanskrit": "अथवा पञ्चबिन्दुस्तत्पूजनं ब्रह्मचारिणः ।\n(वराहः) शक्तिलिङ्गोऽव्याद्विषमद्वयचक्रकः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005862018, "chapter_id": 25862, "verse_number": "१-४५-१९", "content_sanskrit": "नीलस्त्रिरेखः स्थूलोऽथ (कूर्ममूर्त्तिः स बिन्दुमान् ।\n(कृष्णः) स वर्त्तुलावर्त्तः पातु वो नतपृष्ठकः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005862019, "chapter_id": 25862, "verse_number": "१-४५-२०", "content_sanskrit": "(श्रीधरः) पञ्चरेखोऽव्या (द्वनमाली) गादाङ्कितः ।\n(वामनो) वर्त्तुलो ह्रस्वो वा (रा) मचक्रः सुरेश्वरः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005862020, "chapter_id": 25862, "verse_number": "१-४५-२१", "content_sanskrit": "नानावर्णोऽनेकमूर्त्तिर्नागभोगी (त्वनन्तकः) ।\nस्थूलो (दामोदरो) नीलो मध्येवक्रः सुनीलकः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005862021, "chapter_id": 25862, "verse_number": "१-४५-२२", "content_sanskrit": "सङ्कीर्णद्वारकः सोऽव्यादथ ब्रह्मा सुलहतः।\nसदीर्घरेखः सुषिर एकचक्राम्बुजः पृथुः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005862022, "chapter_id": 25862, "verse_number": "१-४५-२३", "content_sanskrit": "पृथुच्छिद्रः स्थूलचक्रः(कृष्णो) (विष्णुश्च) बलववत्।\n(हयग्रीवो) ऽङ्कुशाकारः पञ्चरेखः सकौस्तुभः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005862023, "chapter_id": 25862, "verse_number": "१-४५-२४", "content_sanskrit": "(वैकुण्ठो मणिरत्नाभ एकचक्राम्बुजोऽसितः ।\n(मत्स्यो) दीर्घोऽम्बुजाकारो द्वाररेखश्च पातु वः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005862024, "chapter_id": 25862, "verse_number": "१-४५-२५", "content_sanskrit": "रामचक्रो दक्षरेखः श्यामोवोऽव्या (त्त्रिवकरमः)।\nशालग्रामे द्वारकायां स्थिताय गदिने नमः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005862025, "chapter_id": 25862, "verse_number": "१-४५-२६", "content_sanskrit": "एकद्वारश्चतुश्चक्रो वनमालाविभूषितः ।\nस्वर्णरेखासमायुक्तो गोष्पदेन विराजितः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005862026, "chapter_id": 25862, "verse_number": "१-४५-२७", "content_sanskrit": "कदम्बकुसुमाकारो (लक्ष्मीनारायणो)ऽवतु ।\nएकेन लक्षितो योव्याद्रदाधारी (सुदर्शनः) ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005862027, "chapter_id": 25862, "verse_number": "१-४५-२८", "content_sanskrit": "(लक्ष्मीनारायणो) द्वाभ्यांत्रिभिर्मूर्त्ति(स्त्रिविक्रम।\nचतुर्भिश्च (चतुर्व्यूहो) (वासुदेवश्च) पञ्चभिः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005862028, "chapter_id": 25862, "verse_number": "१-४५-२९", "content_sanskrit": "(प्रद्युम्नः) षडूभिरेव स्यात् (संकर्षण) इतसतः।\n(पुरुषोत्तमो)ऽष्टभिः स्या(न्नवव्यूहो) नवांकितः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005862029, "chapter_id": 25862, "verse_number": "१-४५-३०", "content_sanskrit": "(दशावतारो) दशभिरनिरुद्धोऽवतादथ ।\n(द्वादशात्मा) द्वादशबिरत ऊर्द्ध्व(मनन्तकः) ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005862030, "chapter_id": 25862, "verse_number": "१-४५-३१", "content_sanskrit": "विष्णोर्मूर्त्तिमयं स्तोत्रं यः पठेत्स दिवं व्रजत।\n(ब्रह्मा) चतुर्मुखो दण्डी कमण्डलुयुगान्वितः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005862031, "chapter_id": 25862, "verse_number": "१-४५-३२", "content_sanskrit": "(महेश्वरः) प्रञ्चवक्रो दशबाहुर्वृषध्ज।\nयथायुधस्तथा गौरी चण्डिका च सरस्वती ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005862032, "chapter_id": 25862, "verse_number": "१-४५-३३", "content_sanskrit": "महालक्ष्मीर्मातरश्च पद्महस्तो (दिवाकरः) ।\nगजास्यश्च गणः स्कन्दः षण्मुखोनेकधा गुणाः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005862033, "chapter_id": 25862, "verse_number": "१-४५-३४", "content_sanskrit": "एतेऽर्चिताः स्थापिताश्च प्रासादे वास्तुपूजिते ।\nधर्मार्थकाममोक्षाद्याः प्राप्यन्ते पुरुषेण च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005862034, "chapter_id": 25862, "verse_number": "१-४५-३५", "content_sanskrit": "इति श्रीगारुडे महापुराणे पूर्वखण्डे प्रथमांशाख्ये आचारकाण्डे शालग्राममूर्त्तिलक्षणं नाम पञ्चचत्वारिंशोऽध्यायः ॥४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]