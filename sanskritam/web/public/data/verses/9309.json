[{"id": 5000309000, "chapter_id": 9309, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे सप्तत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000309001, "chapter_id": 9309, "verse_number": "४-३७-१", "content_sanskrit": "एवमुक्तस्तु सुग्रीवो लक्ष्मणेन महात्मना।\nहनूमन्तं स्थितं पार्श्वे वचनं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000309002, "chapter_id": 9309, "verse_number": "४-३७-२", "content_sanskrit": "महेन्द्रहिमवद्विन्ध्यकैलासशिखरेषु च।\nमन्दरे पाण्डुशिखरे पञ्चशैलेषु ये स्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000309003, "chapter_id": 9309, "verse_number": "४-३७-३", "content_sanskrit": "तरुणादित्यवर्णेषु भ्राजमानेषु नित्यशः।\nपर्वतेषु समुद्रान्ते पश्चिमस्यां तु ये दिशि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000309004, "chapter_id": 9309, "verse_number": "४-३७-४", "content_sanskrit": "आदित्यभवने चैव गिरौ संध्याभ्रसंनिभे।\nपद्माचलवनं भीमाः संश्रिता हरिपुंगवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000309005, "chapter_id": 9309, "verse_number": "४-३७-५", "content_sanskrit": "अञ्जनाम्बुदसंकाशाः कुञ्जरेन्द्रमहौजसः।\nअञ्जने पर्वते चैव ये वसन्ति प्लवंगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000309006, "chapter_id": 9309, "verse_number": "४-३७-६", "content_sanskrit": "महाशैलगुहावासा वानराः कनकप्रभाः।\nमेरुपार्श्वगताश्चैव ये च धूम्रगिरिं श्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000309007, "chapter_id": 9309, "verse_number": "४-३७-७", "content_sanskrit": "तरुणादित्यवर्णाश्च पर्वते ये महारुणे।\nपिबन्तो मधु मैरेयं भीमवेगाः प्लवंगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000309008, "chapter_id": 9309, "verse_number": "४-३७-८", "content_sanskrit": "वनेषु च सुरम्येषु सुगन्धिषु महत्सु च।\nतापसाश्रमरम्येषु वनान्तेषु समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000309009, "chapter_id": 9309, "verse_number": "४-३७-९", "content_sanskrit": "तांस्तांस्त्वमानय क्षिप्रं पृथिव्यां सर्ववानरान्।\nसामदानादिभिः कल्पैर्वानरैर्वेगवत्तरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000309010, "chapter_id": 9309, "verse_number": "४-३७-१०", "content_sanskrit": "प्रेषिताः प्रथमं ये च मयाऽऽज्ञाता महाजवाः।\nत्वरणार्थं तु भूयस्त्वं सम्प्रेषय हरीश्वरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000309011, "chapter_id": 9309, "verse_number": "४-३७-११", "content_sanskrit": "ये प्रसक्ताश्च कामेषु दीर्घसूत्राश्च वानराः।\nइहानयस्व तान् शीघ्रं सर्वानेव कपीश्वरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000309012, "chapter_id": 9309, "verse_number": "४-३७-१२", "content_sanskrit": "अहोभिर्दशभिर्ये च नागच्छन्ति ममाज्ञया।\nहन्तव्यास्ते दुरात्मानो राजशासनदूषकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000309013, "chapter_id": 9309, "verse_number": "४-३७-१३", "content_sanskrit": "शतान्यथ सहस्राणि कोट्यश्च मम शासनात्।\nप्रयान्तु कपिसिंहानां निदेशे मम ये स्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000309014, "chapter_id": 9309, "verse_number": "४-३७-१४", "content_sanskrit": "मेघपर्वतसंकाशाश्छादयन्त इवाम्बरम्।\nघोररूपाः कपिश्रेष्ठा यान्तु मच्छासनादितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000309015, "chapter_id": 9309, "verse_number": "४-३७-१५", "content_sanskrit": "ते गतिज्ञा गतिं गत्वा पृथिव्यां सर्ववानराः।\nआनयन्तु हरीन् सर्वांस्त्वरिताः शासनान्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000309016, "chapter_id": 9309, "verse_number": "४-३७-१६", "content_sanskrit": "तस्य वानरराजस्य श्रुत्वा वायुसुतो वचः।\nदिक्षु सर्वासु विक्रान्तान् प्रेषयामास वानरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000309017, "chapter_id": 9309, "verse_number": "४-३७-१७", "content_sanskrit": "ते पदं विष्णुविक्रान्तं पतत्त्रिज्योतिरध्वगाः।\nप्रयाताः प्रहिता राज्ञा हरयस्तु क्षणेन वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000309018, "chapter_id": 9309, "verse_number": "४-३७-१८", "content_sanskrit": "ते समुद्रेषु गिरिषु वनेषु च सरस्सु च।\nवानरा वानरान् सर्वान् रामहेतोरचोदयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000309019, "chapter_id": 9309, "verse_number": "४-३७-१९", "content_sanskrit": "मृत्युकालोपमस्याज्ञां राजराजस्य वानराः।\nसुग्रीवस्याययुः श्रुत्वा सुग्रीवभयशङ्किताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000309020, "chapter_id": 9309, "verse_number": "४-३७-२०", "content_sanskrit": "ततस्तेऽञ्जनसंकाशा गिरेस्तस्मान्महाबलाः।\nतिस्रः कोट्यः प्लवंगानां निर्ययुर्यत्र राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000309021, "chapter_id": 9309, "verse_number": "४-३७-२१", "content_sanskrit": "अस्तं गच्छति यत्रार्कस्तस्मिन् गिरिवरे रताः।\nसंतप्तहेमवर्णाभास्तस्मात् कोट्यो दश च्युताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000309022, "chapter_id": 9309, "verse_number": "४-३७-२२", "content_sanskrit": "कैलासशिखरेभ्यश्च सिंहकेसरवर्चसाम्।\nततः कोटिसहस्राणि वानराणां समागमन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000309023, "chapter_id": 9309, "verse_number": "४-३७-२३", "content_sanskrit": "फलमूलेन जीवन्तो हिमवन्तमुपाश्रिताः।\nतेषां कोटिसहस्राणां सहस्रं समवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000309024, "chapter_id": 9309, "verse_number": "४-३७-२४", "content_sanskrit": "अङ्गारकसमानानां भीमानां भीमकर्मणाम्।\nविन्ध्याद् वानरकोटीनां सहस्राण्यपतन् द्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000309025, "chapter_id": 9309, "verse_number": "४-३७-२५", "content_sanskrit": "क्षीरोदवेलानिलयास्तमालवनवासिनः।\nनारिकेलाशनाश्चैव तेषां संख्या न विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000309026, "chapter_id": 9309, "verse_number": "४-३७-२६", "content_sanskrit": "वनेभ्यो गह्वरेभ्यश्च सरिद्भ्यश्च महाबलाः।\nआगच्छद् वानरी सेना पिबन्तीव दिवाकरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000309027, "chapter_id": 9309, "verse_number": "४-३७-२७", "content_sanskrit": "ये तु त्वरयितुं याता वानराः सर्ववानरान्।\nते वीरा हिमवच्छैले ददृशुस्तं महाद्रुमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000309028, "chapter_id": 9309, "verse_number": "४-३७-२८", "content_sanskrit": "तस्मिन् गिरिवरे पुण्ये यज्ञो माहेश्वरः पुरा।\nसर्वदेवमनस्तोषो बभूव सुमनोरमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000309029, "chapter_id": 9309, "verse_number": "४-३७-२९", "content_sanskrit": "अन्ननिस्यन्दजातानि मूलानि च फलानि च।\nअमृतस्वादुकल्पानि ददृशुस्तत्र वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000309030, "chapter_id": 9309, "verse_number": "४-३७-३०", "content_sanskrit": "तदन्नसम्भवं दिव्यं फलमूलं मनोहरम्।\nयः कश्चित् सकृदश्नाति मासं भवति तर्पितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000309031, "chapter_id": 9309, "verse_number": "४-३७-३१", "content_sanskrit": "तानि मूलानि दिव्यानि फलानि च फलाशनाः।\nऔषधानि च दिव्यानि जगृहुर्हरिपुंगवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000309032, "chapter_id": 9309, "verse_number": "४-३७-३२", "content_sanskrit": "तस्माच्च यज्ञायतनात् पुष्पाणि सुरभीणि च।\nआनिन्युर्वानरा गत्वा सुग्रीवप्रियकारणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000309033, "chapter_id": 9309, "verse_number": "४-३७-३३", "content_sanskrit": "ते तु सर्वे हरिवराः पृथिव्यां सर्ववानरान्।\nसंचोदयित्वा त्वरितं यूथानां जग्मुरग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000309034, "chapter_id": 9309, "verse_number": "४-३७-३४", "content_sanskrit": "ते तु तेन मुहूर्तेन कपयः शीघ्रचारिणः।\nकिष्किन्धां त्वरया प्राप्ताः सुग्रीवो यत्र वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000309035, "chapter_id": 9309, "verse_number": "४-३७-३५", "content_sanskrit": "ते गृहीत्वौषधीः सर्वाः फलमूलं च वानराः।\nतं प्रतिग्राहयामासुर्वचनं चेदमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000309036, "chapter_id": 9309, "verse_number": "४-३७-३६", "content_sanskrit": "सर्वे परिसृताः शैलाः सरितश्च वनानि च।\nपृथिव्यां वानराः सर्वे शासनादुपयान्ति ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000309037, "chapter_id": 9309, "verse_number": "४-३७-३७", "content_sanskrit": "एवं श्रुत्वा ततो हृष्टः सुग्रीवः प्लवगाधिपः।\nप्रतिजग्राह च प्रीतस्तेषां सर्वमुपायनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000309038, "chapter_id": 9309, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे सप्तत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]