[{"id": 40019330, "chapter_id": 9309, "verse_number": "1", "content_sanskrit": "एतच्छ्रुत्वाशुभंवाक्यंपितामहसमीरितम् । अङ्केनादायवैदेहिमुत्पपातविभावसुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40019331, "chapter_id": 9309, "verse_number": "2", "content_sanskrit": "नविधूयाथचितांतांतुवैदेहींहव्यवाहनः । उत्तस्थौमूर्तिमानाशुगृहीत्वाजनकात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40019332, "chapter_id": 9309, "verse_number": "3", "content_sanskrit": "तरुणादित्यसङ्काशंतप्तकाञ्चनभूषणाम् । रक्ताम्बरधरांबालांसीलकुञ्चितमूर्थजाम् ॥ अक्लिष्टमाल्याभरणांतथारूपामनिन्दिताम् । ददौरामायवैदेहीमङ्केकृत्वाविभावसुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40019333, "chapter_id": 9309, "verse_number": "4", "content_sanskrit": "तरुणादित्यसङ्काशंतप्तकाञ्चनभूषणाम् । रक्ताम्बरधरांबालांसीलकुञ्चितमूर्थजाम् ॥ अक्लिष्टमाल्याभरणांतथारूपामनिन्दिताम् । ददौरामायवैदेहीमङ्केकृत्वाविभावसुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40019334, "chapter_id": 9309, "verse_number": "5", "content_sanskrit": "अब्रवीत्तुतदारामंसाक्षीलोकस्यपावकः । एषातेराम वैदेहीपापमस्यां न विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40019335, "chapter_id": 9309, "verse_number": "6", "content_sanskrit": "नैववाचा न मनसानैवबुद्ध्या न चक्षुषा । सुवृत्तावृत्तशौण्डीरन त्वामत्यचरच्छुभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40019336, "chapter_id": 9309, "verse_number": "7", "content_sanskrit": "रावणेनापनीतैषावीर्योसतिक्तेनरक्षसा । त्वयाविरहितादीनाविवशानिर्जनाद्वनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40019337, "chapter_id": 9309, "verse_number": "8", "content_sanskrit": "रुद्धाचान्तःपुरेगुप्तात्वच्छित्तात्वत्परायणा । रक्षिताराक्षसीभिश्चघोराभिर्घोरबुद्धिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40019338, "chapter_id": 9309, "verse_number": "9", "content_sanskrit": "प्रलोभ्यमानाविविधंभर्त्स्यमाना च मैथिली । नाचिन्तयततद्रक्षस्त्वद्गतेनान्तरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40019339, "chapter_id": 9309, "verse_number": "10", "content_sanskrit": "विशुद्धभावांनिष्पापांप्रतिगृह्णीष्वमैथिलीम् । न किञ्चिरभिधातव्याअहमाज्ञापयामिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40019340, "chapter_id": 9309, "verse_number": "11", "content_sanskrit": "ततःप्रीतिमानारामःश्रुत्यैवंवदतांवरः । दध्यौमुहूर्तंधर्मात्माबाष्पव्याकुललोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40019341, "chapter_id": 9309, "verse_number": "12", "content_sanskrit": "एवमुक्तोमहातेजाधृतिमान्दृढविक्रमः । उवाचत्रिदशश्रेष्ठंरामोधर्मभृतांवरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40019342, "chapter_id": 9309, "verse_number": "13", "content_sanskrit": "अवश्यंत्रिषुलोकेषु न सीतापापमर्हति । दीर्घकालोषिताहीयंरावणान्तःपुरेशुभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40019343, "chapter_id": 9309, "verse_number": "14", "content_sanskrit": "बालिशोखलुकामात्मारामोदशरथात्मजः । इतिवक्ष्यन्तिमांसन्तोजानकीमविशोध्यहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40019344, "chapter_id": 9309, "verse_number": "15", "content_sanskrit": "अनन्यहृदयांभक्तांमच्चित्तपरिवर्तिनीम् । अहमप्यवगच्छामिमैथिलींजनकात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40019345, "chapter_id": 9309, "verse_number": "16", "content_sanskrit": "इमामपिविशालाक्षींरक्षितांस्वेनतेजसा । रावणोनातिवर्तेतवेलामिवमहोदधिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40019346, "chapter_id": 9309, "verse_number": "17", "content_sanskrit": "प्रत्ययार्थंतुलोकानांत्रयाणांसत्यसंश्रयः । उपेक्षेचापिवैदेहींप्रविशन्तींहुताशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40019347, "chapter_id": 9309, "verse_number": "18", "content_sanskrit": "न हिशक्तःसुदुष्टात्मामनसापिहिमैथिलीम् । प्रधर्षयितुमप्राप्यांदीप्तामग्निशिखामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40019348, "chapter_id": 9309, "verse_number": "19", "content_sanskrit": "नेयमर्हतिचैश्वर्यंरावणान्तःपुरेशुभा । अनन्याहिमयासीताभास्करेणप्रभायथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40019349, "chapter_id": 9309, "verse_number": "20", "content_sanskrit": "विशुद्धात्रिषुलोकेषुमैथिलीजनकात्मजा । न विहातुंमयाशक्याकीर्तिरात्ववतायथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40019350, "chapter_id": 9309, "verse_number": "21", "content_sanskrit": "अवश्यं च मयाकार्यंसर्वेषांवोवचोहितम् । स्निग्धानांलोकनाधानामेवं च वदतांहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]