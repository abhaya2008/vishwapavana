[{"id": 2134033, "chapter_id": 3893, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2134034, "chapter_id": 3893, "verse_number": "१", "content_sanskrit": "शिवा भार्या त्वङ्गिरसः शीलरूपगुणान्विता ।\nतस्याः सा प्रथमं रूपं कृत्वा देवी जनाधिप ।\nजगाम पावकाभ्याशं तं चोवाच वराङ्गना \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2134035, "chapter_id": 3893, "verse_number": "२", "content_sanskrit": "मामग्ने कामसन्तप्तां त्वं कामयितुमर्हसि । \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2134036, "chapter_id": 3893, "verse_number": "३", "content_sanskrit": "न करिष्यसि चेदेवं मृतां मामुपधारय ।\nतवाप्यधर्मः सुमहान् भविता वै हुताशन\t ॥ ३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2134037, "chapter_id": 3893, "verse_number": "४", "content_sanskrit": "अहमङ्गिरसो भार्या शिवा नाम हुताशन ।\nशिष्टाभिः प्रहिता प्राप्ता मन्त्रयित्वा विनिश्चयम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2134038, "chapter_id": 3893, "verse_number": "", "content_sanskrit": "अग्निः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2134039, "chapter_id": 3893, "verse_number": "५", "content_sanskrit": "कथं मां त्वं विजानीषे कामार्तमितराः कथम् ।\nयास्त्वया कीर्तिताः सर्वाः सप्तर्षीणां प्रियाः स्त्रियः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2134040, "chapter_id": 3893, "verse_number": "", "content_sanskrit": "शिवा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2134041, "chapter_id": 3893, "verse_number": "६", "content_sanskrit": "अस्माकं त्वं प्रियो नित्यं बिभीमस्तु वयं तव ।\nत्वच्चित्तमिङ्गितैर्ज्ञात्वा प्रेषिताऽस्मि तवान्तिकम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2134042, "chapter_id": 3893, "verse_number": "७", "content_sanskrit": "मैथुनायेह सम्प्राप्ता कामाच्चैव द्रुतं च माम् ।\n(जामयो मां प्रतीक्षन्ते गमिष्यामि हुताशन ।)\nउपयन्तुं महावीर्य पूर्वमेव त्वमर्हसि \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2134043, "chapter_id": 3893, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2134044, "chapter_id": 3893, "verse_number": "८", "content_sanskrit": "ततोऽग्निरुपयेमे तां शिवां प्रीतां मुदा युतः ।\nप्रीत्या देवी समायुक्ता शुक्रं जग्राह पाणिना \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2134045, "chapter_id": 3893, "verse_number": "९", "content_sanskrit": "अचिन्तयन्ममेदं ये रूपं द्रक्ष्यन्ति कानने ।\nते ब्राह्मणीनामनृतं दोषं वक्ष्यन्ति पावकम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2134046, "chapter_id": 3893, "verse_number": "१०", "content_sanskrit": "तस्मादेतद् रक्ष्यमाणा गरुडी सम्भवाम्यहम् ।\nवनान्निर्गमनं चैव सुखं मम भविष्यति \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2134047, "chapter_id": 3893, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2134048, "chapter_id": 3893, "verse_number": "११", "content_sanskrit": "सुपर्णी सा ततो भूत्वा निर्जगाम महावनात् ।\nअपश्यत् पर्वतं श्वेतं शरस्तम्बैः सुसंवृतम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2134049, "chapter_id": 3893, "verse_number": "१२", "content_sanskrit": "दृष्टीविषैः सप्तशीर्षैर्गुप्तं भोगिभिरद्भुतैः ।\nरक्षोभिश्च पिशाचैश्च रौद्रैर्भूतगणैस्तथा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2134050, "chapter_id": 3893, "verse_number": "१३", "content_sanskrit": "राक्षसीभिश्च सम्पूर्णमनेकैश्च मृगद्विजैः ।\nनदीप्रस्रवणोपेतं नानातरुगणाकुलम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2134051, "chapter_id": 3893, "verse_number": "१४", "content_sanskrit": "सा तत्र सहसा गत्वा शैलपृष्ठं सुदुर्गमम् ।\nप्राक्षिपत् काञ्चने कुण्डे शुक्रं सा त्वरिता शुभा \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2134052, "chapter_id": 3893, "verse_number": "१५", "content_sanskrit": "सप्तानामपि देवीनां सप्तर्षीणां महात्मनाम् ।\nपत्नीसरूपतां कृत्वा कामयामास पावकम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2134053, "chapter_id": 3893, "verse_number": "१६", "content_sanskrit": "दिव्यरूपमरुन्धत्याः कर्तुं न शकितं तया ।\nतस्यास्तपःप्रभावेण भर्तुः शुश्रूषणेन च \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2134054, "chapter_id": 3893, "verse_number": "१७", "content_sanskrit": "षट्कृत्वस्तत्तु निक्षिप्तमग्ने रेतः कुरूत्तम ।\nतस्मिन् कुण्डे प्रतिपदि कामिन्या स्वाहया तदा \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2134055, "chapter_id": 3893, "verse_number": "१८", "content_sanskrit": "तत् स्कन्नं तेजसा तत्र संवृतं जनयत् सुतम् ।\nऋषिभिः पूजितं स्कन्नमनयत् स्कन्दतां ततः\t ॥ १८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2134056, "chapter_id": 3893, "verse_number": "१९", "content_sanskrit": "षट्शिरा द्विगुणश्रोत्रो द्वादशाक्षिभुजक्रमः ।\nएकग्रीवैकजठरः कुमारः समपद्यत \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2134057, "chapter_id": 3893, "verse_number": "२०", "content_sanskrit": "द्वितीयायामभिव्यक्तस्तृतीयायां शिशुर्बभौ ।\nअङ्गप्रत्यङ्गसम्भूतश्चतुर्थ्यामभवद् गुहः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2134058, "chapter_id": 3893, "verse_number": "२१", "content_sanskrit": "लोहिताभ्रेण महता संवृतः सह विद्युता ।\nलोहिताभ्रे सुमहति भाति सूर्य इवोदितः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2134059, "chapter_id": 3893, "verse_number": "२२", "content_sanskrit": "गृहीतं तु धनुस्तेन विपुलं लोमहर्षणम् ।\nन्यस्तं यत् त्रिपुरघ्नेन सुरारिविनिकृन्तनम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2134060, "chapter_id": 3893, "verse_number": "२३", "content_sanskrit": "तद् गृहीत्वा धनुः श्रेष्ठं ननाद बलवांस्तदा ।\nसम्मोहयन्निमान् सर्वान् त्रींल्लोकान् सचराचरान् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2134061, "chapter_id": 3893, "verse_number": "२४", "content_sanskrit": "तस्य तं निनदं श्रुत्वा महामेघौघनिस्वनम् ।\nउत्पेततुर्महानागौ चित्रश्चैरावतश्च ह \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2134062, "chapter_id": 3893, "verse_number": "२५", "content_sanskrit": "तावापतन्तौ सम्प्रेक्ष्य स बालोऽर्कसमद्युतिः\nद्वाभ्यां गृहीत्वा पाणिभ्यां शक्तिं चान्येन पाणिना\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2134063, "chapter_id": 3893, "verse_number": "२६", "content_sanskrit": "अपरेणाग्निदायादस्ताम्रचूडं भुजेन सः ।\nमहाकायमुपश्लिष्टं कुक्कुटं बलिनां वरम् ।\nगृहीत्वा व्यनदद् भीमं चिक्रीड च महाभुजः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2134064, "chapter_id": 3893, "verse_number": "२७", "content_sanskrit": "द्वाभ्यां भुजाभ्यां बलवान् गृहीत्वा शङ्खमुत्तमम् ।\nप्राध्मापयत भूतानां त्रासनं बलिनामपि \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2134065, "chapter_id": 3893, "verse_number": "२८", "content_sanskrit": "द्वाभ्यां भुजाभ्यामाकाशं बहुशो निजघान सः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2134066, "chapter_id": 3893, "verse_number": "२९", "content_sanskrit": "क्रीडन् भाति महासेनस्त्रीँल्लोकान् वदनैः पिबन् ।\nपर्वताग्रेऽप्रमेयात्मा रश्मिमानुदये यथा \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2134067, "chapter_id": 3893, "verse_number": "३०", "content_sanskrit": "स तस्य पर्वतस्याग्रे निषण्णोऽद्भुतविक्रमः ।\nव्यलोकयदमेयात्मा मुखैर्नानाविधैर्दिशः ।\nस पश्यन् विविधान् भावांश्चकार निनदं पुनः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2134068, "chapter_id": 3893, "verse_number": "३१", "content_sanskrit": "तस्य तं निनदं श्रुत्वा न्यपतन् बहुधा जनाः ।\nभीताश्चोद्विग्नमनसस्तमेव शरणं ययुः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2134069, "chapter_id": 3893, "verse_number": "३२", "content_sanskrit": "ये तु तं संश्रिता देवं नानावर्णास्तदा जनाः ।\nतांस्तस्याहुः पारिषदान् ब्राह्मणाः सुमहाबलान् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2134070, "chapter_id": 3893, "verse_number": "३३", "content_sanskrit": "स तूत्थाय महाबाहुरुपसान्त्व्य च तान् जनान् ।\nधनुर्विकृष्य व्यसृजद् बाणान् श्वेते महागिरौ \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2134071, "chapter_id": 3893, "verse_number": "३४", "content_sanskrit": "बिभेद स शरैः शैलं क्रौञ्चं हिमवतः सुतम् ।\nतेन हंसाश्च गृध्राश्च मेरुं गच्छन्ति पर्वतम् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2134072, "chapter_id": 3893, "verse_number": "३५", "content_sanskrit": "स तु शीर्णोऽपतच्छैलो भृशमार्तस्वरान् रुवन् \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2134073, "chapter_id": 3893, "verse_number": "३६", "content_sanskrit": "तस्मिन्निपतिते त्वन्ये नेदुः शैला भृशं तदा ।\nघोरमार्तस्वरं चक्रुर्दृष्ट्वा क्रौञ्चं विदारितम् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2134074, "chapter_id": 3893, "verse_number": "३७", "content_sanskrit": "स तं नादं भृशार्तानां श्रुत्वाऽपि बलिनां वरः ।\nन प्रापददमेयात्मा शक्तिमुद्यम्य चानदत् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2134075, "chapter_id": 3893, "verse_number": "३८", "content_sanskrit": "सा तदा विमला शक्तिः क्षिप्ता तेनामितात्मना ।\nबिभेद शिखरं क्रोधात् श्वेतस्य तरसा गिरेः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2134076, "chapter_id": 3893, "verse_number": "३९", "content_sanskrit": "स तेनाभिहतो दीर्णो गिरिः श्वेतोऽचलैः सह ।\nउत्पपात महीं त्यक्त्वा भीतस्तस्मान्महात्मनः \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2134077, "chapter_id": 3893, "verse_number": "४०", "content_sanskrit": "ततः प्रव्यथिता भूमिर्व्यशीर्यत समन्ततः ।\nआर्ता स्कन्दं समासाद्य पुनर्बलवती बभौ \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2134078, "chapter_id": 3893, "verse_number": "४१", "content_sanskrit": "पर्वताश्च नमस्कृत्य तमेव पृथिवीं गताः ।\nअथैनमभजल्लोकः स्कन्दं शुक्लस्य पञ्चमीम् \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2134079, "chapter_id": 3893, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि चतुर्दशाधिकद्विशततमोऽध्यायः ॥ २१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2134080, "chapter_id": 3893, "verse_number": "३९", "content_sanskrit": "॥ मार्कण्डेयसमास्यापर्वणि आङ्गिरसे कुमारोत्पत्तौ एकोनचत्वारिंशोऽध्यायः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]