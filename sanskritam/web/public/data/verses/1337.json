[{"id": 2016027, "chapter_id": 1337, "verse_number": "२-७८-१", "content_sanskrit": "दुर्योधन उवाच॥\nयन्मया पाण्डवोयानां दृष्टं तच्छृणु भारत।\nआहृतं भूमिपालैर्हि वसु मुख्यं ततस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2016028, "chapter_id": 1337, "verse_number": "२-७८-२", "content_sanskrit": "नाविदं मूढमात्मानं दृष्ट्वाहं तदरेर्धनम्।\nफलतो भूमितो वाऽपि प्रतिपद्यस्व भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2016029, "chapter_id": 1337, "verse_number": "२-७८-३", "content_sanskrit": "और्णान्बैलान्वार्षदंशान् जातरूपपरिष्कृतान्।\nप्रावाराजिनमुख्यांश्च काम्भोजः प्रददौ बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2016030, "chapter_id": 1337, "verse_number": "२-७८-४", "content_sanskrit": "अश्वांस्तित्तिरिकल्माषांस्त्रिशतं शुकनासिकान्।\nअष्ट्रवामीस्त्रिगर्ताश्च पुष्टाः पीलुशमीङ्गुदैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2016031, "chapter_id": 1337, "verse_number": "२-७८-५", "content_sanskrit": "गोपाः स्वीयेन सहितास्तदादाय चतुष्पदम्।\nवसातयोऽन्यद्द्रव्यं द्वारि तस्यावतस्थिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2016032, "chapter_id": 1337, "verse_number": "२-७८-६", "content_sanskrit": "कमण्डलूनुपादाय जातरूपमयञ्छिवान्।\nरत्नानि च हिरण्यं च सुवर्णं चैव केवलम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2016033, "chapter_id": 1337, "verse_number": "२-७८-७", "content_sanskrit": "प्रीयमाणः प्रसन्नात्मा स्वयं स्वजनसंवृतः।\nत्रैखर्वो रथमुख्येशः पाण्डवाय न्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2016034, "chapter_id": 1337, "verse_number": "२-७८-८", "content_sanskrit": "यश्च स द्विजमुख्येन राज्ञः शङ्खो निवेदितः।\nप्रीत्या दत्तः कुविन्देन धर्मराजाय धीमते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2016035, "chapter_id": 1337, "verse_number": "२-७८-९", "content_sanskrit": "तं सर्वे भ्रातरो भ्रात्रे ददुः शङ्खं किरीटिने।\nतं प्रत्यगृह्णाद्बीभत्सुस्तोयजं हेममालिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2016036, "chapter_id": 1337, "verse_number": "२-७८-१०", "content_sanskrit": "चित्रं निष्कसहस्रेण भ्राजमानं स्वतेजसा।\nरुचिरं दर्शनीयं च पूजितं विश्वकर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2016037, "chapter_id": 1337, "verse_number": "२-७८-११", "content_sanskrit": "अधारयच्च धर्मश्च तं नमस्य पुनः पुनः।\nयोऽनादनेऽपि नदति स ननादाधिकं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2016038, "chapter_id": 1337, "verse_number": "२-७८-१२", "content_sanskrit": "प्रणादाद्भूमिपास्तस्य पेतुर्हीनाः खतेजसा।\nधृष्टद्युम्नः पाण्डवाश्च सात्यकिः केशवोऽष्टमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2016039, "chapter_id": 1337, "verse_number": "२-७८-१३", "content_sanskrit": "सत्वेन स्वेन सम्पन्ना अन्योन्यप्रियकारिणः।\nविसञ्ज्ञान्भूमिपान्दृष्ट्वा मां च ते प्राहसंस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2016040, "chapter_id": 1337, "verse_number": "२-७८-१४", "content_sanskrit": "ततः प्रहृष्टो बीभत्सुरददाद्धेमशृङ्गिणः।\nशताननडुहान्पञ्च द्विजमुख्याय भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2016041, "chapter_id": 1337, "verse_number": "२-७८-१५", "content_sanskrit": "सुमुखेन बलिर्मुख्यः प्रेषितोऽजातशत्रवे।\nकुविन्देन हिरण्यं च वासांसि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2016042, "chapter_id": 1337, "verse_number": "२-७८-१६", "content_sanskrit": "काश्मीरराजो मार्द्वीकं शुद्धं च सरसं मधु।\nबलिं च कुत्स्नमादाय पाण्डवायाभ्युटपागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2016043, "chapter_id": 1337, "verse_number": "२-७८-१७", "content_sanskrit": "यवना हयानुपादाय पार्वतीयान्मनोजवान्।\nआसनानि महार्हाणि कम्बलांश्च महाधनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2016044, "chapter_id": 1337, "verse_number": "२-७८-१८", "content_sanskrit": "नवान्सूक्ष्मांश्च हृद्यांश्च परार्थ्यान्सुप्रदर्शनान्।\nअन्यच्च विविधं रत्नं द्वारि ते न्यवतस्थिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2016045, "chapter_id": 1337, "verse_number": "२-७८-१९", "content_sanskrit": "श्रुतायुरपि कालिङ्गो मणिरत्नमनुत्तमम्।\nअङ्गः स्त्रियो दर्शनीया जातरूपविभूषिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2016046, "chapter_id": 1337, "verse_number": "२-७८-२०", "content_sanskrit": "वङ्गो जाम्बूनदमयान्पर्यङ्गाञ्छतशो नृप।\nदक्षिणात्सागराभ्याशात्प्रावारांश्च परश्शतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2016047, "chapter_id": 1337, "verse_number": "२-७८-२१", "content_sanskrit": "औदकानि सरत्नानि बलिं चादाय भारत।\nअन्येभ्यो भूमिपालेभ्यः पाण्डवाय न्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2016048, "chapter_id": 1337, "verse_number": "२-७८-२२", "content_sanskrit": "दार्दुरं चन्दनं मुख्यं भारं षण्णवति द्रुतम्।\nपाण्डवाय ददौ पाण्ड्यः शङ्खांस्तावत एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2016049, "chapter_id": 1337, "verse_number": "२-७८-२३", "content_sanskrit": "चन्दनागरु चानन्तं मुक्तावैडूर्यचित्रिताः।\nचोलश्च केरलश्चोमौ ददतुः पाण्डवाय वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2016050, "chapter_id": 1337, "verse_number": "२-७८-२४", "content_sanskrit": "अश्मको हेमशृङ्गीश्च दोग्ध्रीर्हेमविभूषितः।\nसवत्साः कुम्भदोहाश्च सहस्राण्यददाद्दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2016051, "chapter_id": 1337, "verse_number": "२-७८-२५", "content_sanskrit": "सैन्धवानां सहस्राणि हयानां पञ्चविंशतिम्।\nअददात्सैन्धवो राजा हेममाल्यैरलङ्कृतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2016052, "chapter_id": 1337, "verse_number": "२-७८-२६", "content_sanskrit": "सौवीरो हस्तिभिर्युक्तान्रथांश्च त्रिशतं परान्।\nजातरूपपरिष्कारान्मणिरत्नविभूषितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2016053, "chapter_id": 1337, "verse_number": "२-७८-२७", "content_sanskrit": "मध्यन्दिनार्कप्रतिमांस्तेजसा ज्वलितानिव।\nबलिं च कृत्स्नमादाय पाण्डवाय न्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2016054, "chapter_id": 1337, "verse_number": "२-७८-२८", "content_sanskrit": "अवन्तिराजो रत्नानि विविधानि सहस्रशः।\nहाराङ्गदांश्च मुख्यान्वै विविधं च विभूषणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2016055, "chapter_id": 1337, "verse_number": "२-७८-२९", "content_sanskrit": "दासीनामयुतं चापि बलिमादाय भारत।\nसभाद्वारि नरश्रेष्ठ दिदृक्षुरवतिष्ठते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2016056, "chapter_id": 1337, "verse_number": "२-७८-३०", "content_sanskrit": "दशार्णश्चेदिराजश्च शूरसेनश्च वीर्यवान्।\nवस्त्राणि मुख्यान्यादाय रत्नानि विविधानि च।\nबलिं च कृत्स्नमादाय पाण्डवाय न्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2016057, "chapter_id": 1337, "verse_number": "२-७८-३१", "content_sanskrit": "काशिराजेन हृष्टेन बली राज्ञि निवेदितः।\nअशीतिगोसहस्राणि शतान्यष्टौ च दन्तिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2016058, "chapter_id": 1337, "verse_number": "२-७८-३२", "content_sanskrit": "अयुतं च नदीजानां हयानां हेममालिनाम्।\nविविधानि च रत्नानि काशिराजो बलिं ददौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2016059, "chapter_id": 1337, "verse_number": "२-७८-३३", "content_sanskrit": "कृतक्षणश्च वैदेहः कौसलश्च बृहद्बलः।\nददतुर्वाजिमुख्यांश्च सहस्राणि चतुर्दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2016060, "chapter_id": 1337, "verse_number": "२-७८-३४", "content_sanskrit": "शैब्यो वसादिभिः सार्धं त्रिगर्तो मालवैः सह।\nतेभ्यो रत्नानि ददतुरेकैको भूमिपोऽमितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2016061, "chapter_id": 1337, "verse_number": "२-७८-३५", "content_sanskrit": "हारान्मुख्यान्परार्ध्यांश्च विविधं च विभूषणम्।\nशतं दासीसहस्राणि कार्पासिकनिवासिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2016062, "chapter_id": 1337, "verse_number": "२-७८-३६", "content_sanskrit": "श्यामास्तन्वीर्दीर्घकेशीर्हेमाभरणभूषिताः।\nबलिं च कृत्स्नमादाय भारुकच्छो नरर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2016063, "chapter_id": 1337, "verse_number": "२-७८-३७", "content_sanskrit": "शुद्धान्विप्रोत्तमार्हांश्च कम्बलप्रवरान्ददौ।\nते सर्वे पाण्डुपुत्रस्य द्वार्यतिष्ठन्दिदृक्षवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2016064, "chapter_id": 1337, "verse_number": "२-७८-३८", "content_sanskrit": "उपायनं यदा दद्युस्तदा द्वारमलभ्यत।\nइन्द्रकृष्टैर्वर्धयन्ति धान्यैर्नदमुखैस्तु ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2016065, "chapter_id": 1337, "verse_number": "२-७८-३९", "content_sanskrit": "समुद्रनिकटे जाताः परिसिन्धुनिवासिनः।\nते वै द्रुमाः पारदाश्च काश्यकैरातकैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2016066, "chapter_id": 1337, "verse_number": "२-७८-४०", "content_sanskrit": "बलिं विविधमादाय रत्नानि विविधानि च।\nअजाविकं गोहिरण्यं खरोष्ट्रं फलवन्मधु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2016067, "chapter_id": 1337, "verse_number": "२-७८-४१", "content_sanskrit": "कम्बलान्विविधांश्चैव द्वारि तिष्ठन्ति वारिताः।\nप्राग्ज्योतिषपतिः शूरो म्लेच्छानामधिपो बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2016068, "chapter_id": 1337, "verse_number": "२-७८-४२", "content_sanskrit": "यवनैः सहितो राजा भगदत्तो महाबलः।\nआजानेयान्हयाञ्छीघ्रमादायानिलरंहसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2016069, "chapter_id": 1337, "verse_number": "२-७८-४३", "content_sanskrit": "बलिं च कृत्स्नमादाय द्वारि तिष्ठति वारितः।\nअश्वसारमयान्भाण्डाञ्छुभान्दन्तत्सरूनसीन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2016070, "chapter_id": 1337, "verse_number": "२-७८-४४", "content_sanskrit": "प्राग्ज्योतिषाधिपो दत्त्वा भगदत्तोऽव्रजत्तदा।\nव्यक्षाङ्ख्यक्षांल्ललाटाक्षान्नानादिग्भ्यः समागतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2016071, "chapter_id": 1337, "verse_number": "२-७८-४५", "content_sanskrit": "औष्णीषआनहयांश्चैव बाहुकान्पुरुषादकान्।\nएकपादांश्च तत्राहमपश्यं द्वारि वारितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2016072, "chapter_id": 1337, "verse_number": "२-७८-४६", "content_sanskrit": "बल्यर्थं ददतस्तस्य हिरण्यं रजतं वसु।\nइन्द्रगोपकसङ्काशाञ्छुकवर्णान्मनोजवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2016073, "chapter_id": 1337, "verse_number": "२-७८-४७", "content_sanskrit": "तथैवेन्द्रायुधनिभान्सन्ध्याभ्रसदृशानपि।\nअनेकवर्णानारण्यान्गृहीत्वाश्वांस्तथा बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2016074, "chapter_id": 1337, "verse_number": "२-७८-४८", "content_sanskrit": "जातरूपमनर्घ्यं च ददुस्तस्यैकपादकाः।\nसिंहलश्च तदा राजा परिगृह्य धनं बहु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2016075, "chapter_id": 1337, "verse_number": "२-७८-४९", "content_sanskrit": "गोशीर्षं हरितश्यामं चन्दनप्रवरं महत्।\nभाराणां शतमेकं तु द्वारि तिष्ठति वारितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2016076, "chapter_id": 1337, "verse_number": "२-७८-५०", "content_sanskrit": "ये नग्नविषया राजन्बर्बरेयाश्च विश्रुताः।\nशतं दासीसहस्राणां कम्बलांश्च सहस्रशः।\nपरिगृह्य महाराज द्वारि तिष्ठन्ति वारिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2016077, "chapter_id": 1337, "verse_number": "२-७८-५१", "content_sanskrit": "पौण्ड्राश्च दामलिप्ताश्च यथाकामकृतो नृपाः।\nकालेयकं च रूप्यं च परिगृह्य परिच्छदान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2016078, "chapter_id": 1337, "verse_number": "२-७८-५२", "content_sanskrit": "अगरून्स्फाटिकांश्चैव दन्ताञ्जातीफलानि च।\nतक्कोलांश्च लवङ्गाश्च कर्पूरांश्च महाबल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2016079, "chapter_id": 1337, "verse_number": "२-७८-५३", "content_sanskrit": "अन्यांश्च विविधान्द्रव्यान्परिगृह्योपतस्थिरे।\nएते सर्वे महात्मानो द्वारि तिष्ठन्ति वारिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2016080, "chapter_id": 1337, "verse_number": "२-७८-५४", "content_sanskrit": "शैलेयश्च ततो राजा पत्रोर्णान्परिगृह्य सः।\nद्वारि तिष्ठन्महाराज द्वारपालैर्निवारितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2016081, "chapter_id": 1337, "verse_number": "२-७८-५५", "content_sanskrit": "चीना हूणाः कषाः काचाः पर्वतान्तरवासिनः।\nआहार्षुर्दशसाहस्रान्विन्नीतान्दिक्षु विंश्रुतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2016082, "chapter_id": 1337, "verse_number": "२-७८-५६", "content_sanskrit": "औष्णीकं कम्बलं चैव कीटजं मणिजं तथा।\nप्रमाणरागस्पर्शाढ्यं बाह्वीचीनसमुद्भवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2016083, "chapter_id": 1337, "verse_number": "२-७८-५७", "content_sanskrit": "रसान् गन्धान्प्रशंसन्तस्ततो द्वारमलभ्यत।\nखर्वटास्तोमराश्चैव शूरा वर्धनकास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2016084, "chapter_id": 1337, "verse_number": "२-७८-५८", "content_sanskrit": "चेलान्बहुविधान्गृह्य द्वारि तिष्ठन्ति वारिताः।\nप्राक्कोटा नाटकेयाश्च नन्दीनगरकास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2016085, "chapter_id": 1337, "verse_number": "२-७८-५९", "content_sanskrit": "नापितास्त्रैपुराश्चैव पञ्चमेयाः सहोरुजाः।\nतथा चाटविकाः सर्वे नानाद्रव्यपरिच्छदान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2016086, "chapter_id": 1337, "verse_number": "२-७८-६०", "content_sanskrit": "परिगृह्य महाराज द्वारि तिष्ठन्ति वारिताः।\nशकास्तुषाराः कौरव्य रोमकाः शृङ्गिणोश्मकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2016087, "chapter_id": 1337, "verse_number": "२-७८-६१", "content_sanskrit": "बलादूरुगमा राजन्गणितं चार्बुदं मया।\nकूटीकृतं सुवर्णं च पद्मकिञ्जल्कसंनिभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2016088, "chapter_id": 1337, "verse_number": "२-७८-६२", "content_sanskrit": "शितान्दीर्घानसीनन्यान्यष्टिशक्तिपरश्वथान्।\nश्लक्ष्णं वस्त्रमकार्पसमाविकं मृदु चाजिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2016089, "chapter_id": 1337, "verse_number": "२-७८-६३", "content_sanskrit": "बलं मत्तं समादाय द्वारि तिष्ठन्ति वारिताः।\nआसनानि महार्हाणि यानानि शयनानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2016090, "chapter_id": 1337, "verse_number": "२-७८-६४", "content_sanskrit": "मणिकाञ्चनचित्राणि गजदन्तमयानि च।\nरथांश्च विविधाकाराञ्जाम्बूनदपरिष्कृतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2016091, "chapter_id": 1337, "verse_number": "२-७८-६५", "content_sanskrit": "हयैर्विनीतैः सम्पन्नान्वैयाघ्रपरिवारितान्।\nविचित्रान्सपरिस्तोमांश्चापानि विविधानि च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2016092, "chapter_id": 1337, "verse_number": "२-७८-६६", "content_sanskrit": "नाराचानर्घनाराचाञ्छस्त्राणि विविधानि च।\nएतद्द्रव्यं महद्गृह्य पूर्वदेशाधिपो नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2016093, "chapter_id": 1337, "verse_number": "२-७८-६७", "content_sanskrit": "प्रविष्टो यज्ञसदनं पाण्डवस्य महात्मनः।\nजन्तुचेलान्द्विसाहस्रान्दुकूलान्ययुतानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2016094, "chapter_id": 1337, "verse_number": "२-७८-६८", "content_sanskrit": "कांस्यानि चैव भाण्डानि महार्हाणि कुथानि च।\nएतान्यन्यानि रत्नानि ददौ पार्थस्य वै मुदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2016095, "chapter_id": 1337, "verse_number": "२-७८-६९", "content_sanskrit": "अन्यान्बहुविधान्राजन्नरः सागरमाश्रिताः।\nरत्नानि विविधान्गृह्य ददुस्ते पाण्डवाय तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2016096, "chapter_id": 1337, "verse_number": "२-७८-७०", "content_sanskrit": "मालवाश्च ततो राजन्रत्नानि विविधानि च।\nगोधूमानां च राजेन्द्र द्रोणानां कोटिसंमितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2016097, "chapter_id": 1337, "verse_number": "२-७८-७१", "content_sanskrit": "अन्यांश्च विविधान्धान्यान्परिगृह्य महाबलः।\nपाण्डवाय ददौ प्रीत्या प्रविवेश महाध्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2016098, "chapter_id": 1337, "verse_number": "२-७८-७२", "content_sanskrit": "नानारत्नान्बहून्गृह्य सुराष्ट्राधिपतिर्नृपः।\nतैलकुम्भान्महाराज द्रोणानामयुतानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2016099, "chapter_id": 1337, "verse_number": "२-७८-७३", "content_sanskrit": "गुडानपि स तान्स्वादून्सहस्रशकटैर्नृपः।\nएतानि सर्वाण्यादाय ददौ कुन्तीसुताय सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2016100, "chapter_id": 1337, "verse_number": "२-७८-७४", "content_sanskrit": "अन्ये च पार्थिवा राजन्नानादेशसमागताः।\nरत्नानि विविधान्गृह्य ददुस्ते कौरवाय तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2016101, "chapter_id": 1337, "verse_number": "२-७८-७५", "content_sanskrit": "जम्बूद्वीपे समस्ते तु सराष्ट्रवनपर्वते।\nकरं तु न प्रयच्छेत नास्ति पार्थस्य पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2016102, "chapter_id": 1337, "verse_number": "२-७८-७६", "content_sanskrit": "नरः सप्तसु वर्षेसु तद्यज्ञे नास्ति नागतः।\nक्रतुर्नानागणैः कीर्णो बभौ शक्रसदो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2016103, "chapter_id": 1337, "verse_number": "२-७८-७७", "content_sanskrit": "इमांश्च दायान्विविधान्निबोध मम पार्थिव।\nयज्ञाप्थे राजभिर्दत्तान्महतो धनसञ्चयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2016104, "chapter_id": 1337, "verse_number": "२-७८-७८", "content_sanskrit": "मेरुमन्दरयोर्मध्ये शैलोदामभितो नदीम्।\nये ते कीचकवेणूनां छायां रम्यामुपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2016105, "chapter_id": 1337, "verse_number": "२-७८-७९", "content_sanskrit": "खषा एकासनाद्यर्हाः प्रदरा दीर्घवेणवः।\nपारदाश्च कुलिन्दाश्च तङ्कणाः परतङ्कणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2016106, "chapter_id": 1337, "verse_number": "२-७८-८०", "content_sanskrit": "तद्वै पिपीलिकं नाम उद्धृतं यत्पिपीलिकैः।\nजातरूपं द्रोणमेयमहार्षुः कुञ्जशो नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2016107, "chapter_id": 1337, "verse_number": "२-७८-८१", "content_sanskrit": "कृष्णवालांश्च चमराञ्छुक्लवालांस्तथा परान्।\nहिमवत्पुष्पजं चैव स्वादुक्षौद्ररसं बहु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2016108, "chapter_id": 1337, "verse_number": "२-७८-८२", "content_sanskrit": "उत्तरेभ्यः कुरुभ्यश्च व्यूढमाल्यैर्महात्मभिः।\nउत्तरादपि कैलासादोषधीः सुमहाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2016109, "chapter_id": 1337, "verse_number": "२-७८-८३", "content_sanskrit": "पार्वतीयाश्चराजान आहृत्य प्रणताः स्थिताः।\nअजातशत्रवे राजन्द्वारि तिष्ठन्ति वारिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2016110, "chapter_id": 1337, "verse_number": "२-७८-८४", "content_sanskrit": "ये परार्घ्या हिमवतः सूर्योदयगिरेरनु।\nएवंरूपाः समुद्रान्ते लौहित्यमभितश्च ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2016111, "chapter_id": 1337, "verse_number": "२-७८-८५", "content_sanskrit": "फलमूलाशना ये च किराताश्चर्मवाससः।\nचन्द्नागरुमुख्यानि महार्हान्कम्बलानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2016112, "chapter_id": 1337, "verse_number": "२-७८-८६", "content_sanskrit": "चर्मरत्नसुवर्णानि गन्धानुच्चावचानि च।\nकैरातकीनामयुतं दासीनां च विशंपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2016113, "chapter_id": 1337, "verse_number": "२-७८-८७", "content_sanskrit": "आहृत्य रमणीयार्थान्दूरगान्मृगपक्षिणः।\nनिचितं पर्वतेभ्यश्च हिरण्यंभूरिवर्चसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2016114, "chapter_id": 1337, "verse_number": "२-७८-८८", "content_sanskrit": "बलिं च कृत्स्त्रमादाय द्वारि तिष्टन्ति वारिताः।\nकापव्या दरदा दर्वाः शूरा वै यमकास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2016115, "chapter_id": 1337, "verse_number": "२-७८-८९", "content_sanskrit": "औदुम्बरा दुर्विभागा द्वारि तिष्टन्ति वारिताः।\nकाश्मीराश्च कुमाराश्च गौरका हंसकास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2016116, "chapter_id": 1337, "verse_number": "२-७८-९०", "content_sanskrit": "शिबित्रैगर्तयौधेया राजन्या मद्रकैः सह।\nवसुतेयाः समौलेया दाहक्षुद्रकमालवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2016117, "chapter_id": 1337, "verse_number": "२-७८-९१", "content_sanskrit": "चौण्डिकाश्चौदकाश्चैव साल्वाश्चैव विशम्पते।\nअङ्कवङ्काश्च यवना अनवद्या गयैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2016118, "chapter_id": 1337, "verse_number": "२-७८-९२", "content_sanskrit": "सुजातयः श्रेणिमन्तः श्रेयांसः शस्त्रधारिणः।\nआहार्षुः क्षत्रिया वित्तं शतशोऽजातशत्रवै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2016119, "chapter_id": 1337, "verse_number": "२-७८-९३", "content_sanskrit": "वङ्काः कलिङ्गा मगधास्ताम्रलिप्ताः सपुण्ड्रकाः।\nदुकूलं कौशिकं चैव पत्रोर्णं चैव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2016120, "chapter_id": 1337, "verse_number": "२-७८-९४", "content_sanskrit": "उपावृत्ता नृपास्तस्य ददुः प्रीतिं न चागमन्।\nउच्यन्ते तत्र हि द्वार्स्थैर्बलिमादाय विष्ठिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2016121, "chapter_id": 1337, "verse_number": "२-७८-९५", "content_sanskrit": "ईषादन्तान्हेमकक्ष्यान्पद्मवर्णान्कुथावृतान्।\nशैलाभान्नित्यमत्तांश्चाप्यभितः काम्यकं सरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2016122, "chapter_id": 1337, "verse_number": "२-७८-९६", "content_sanskrit": "क्षमावतः कुलीनांश्च कुञ्जरान्सपरिच्छदान्।\nदत्त्वैकैको दशशतान्द्वारेण प्रविशन्त्विति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2016123, "chapter_id": 1337, "verse_number": "२-७८-९७", "content_sanskrit": "वैदेहकाश्च पुण्ड्राश्च गौलेयास्ताम्रलिप्तकाः।\nमरुकाः काशिका दर्दा भौमेया नटनाटकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2016124, "chapter_id": 1337, "verse_number": "२-७८-९८", "content_sanskrit": "कर्णाटाः कांस्यकुट्टाश्च पद्मजालाः सतीनराः।\nदाक्षिणात्याः पुलिन्दाश्च शवेरास्तङ्कणाः शषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2016125, "chapter_id": 1337, "verse_number": "२-७८-९९", "content_sanskrit": "बर्बरा यवनाश्चैव गर्गराभीरकास्तथा।\nपल्लवाः शककारूशास्तुम्बकाः काशिकास्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2016126, "chapter_id": 1337, "verse_number": "२-७८-१००", "content_sanskrit": "एते चान्ये च बहवो नानादिगभ्यः समागताः।\nअन्यैश्चोपहृतान्यत्र रत्नानि हि महात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2016127, "chapter_id": 1337, "verse_number": "२-७८-१०१", "content_sanskrit": "समुद्रसारवैडूर्यान्मुक्ताः शङ्खास्तथैव च।\nशुभावर्ताञ्छुभाञ्छुक्तीः सिंहलाः समुपाहरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2016128, "chapter_id": 1337, "verse_number": "२-७८-१०२", "content_sanskrit": "सम्भृतान्मणिचीरैश्च श्यामांस्ताम्रान्तलोचनान्।\nराजा चित्ररथो नाम गन्धर्वो वासवानुगः।\nशतानि चत्वार्यददद्धयानां वातरंहसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2016129, "chapter_id": 1337, "verse_number": "२-७८-१०३", "content_sanskrit": "तुम्बुरुस्तु प्रमुदितो गन्धर्वो वाजिनां शतम्।\nआम्रपत्रसवर्णानामददद्धेममालिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2016130, "chapter_id": 1337, "verse_number": "२-७८-१०४", "content_sanskrit": "कृती राजा च कौरव्य शूकराणां विशाम्पते।\nअददद्गजरत्नानां शतानि सुबहून्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2016131, "chapter_id": 1337, "verse_number": "२-७८-१०५", "content_sanskrit": "विराटेन तु मत्स्येन बल्यर्थं हेममालिनाम्।\nकुञ्जराणां सहस्रे द्वे मत्तानां समुपाहृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2016132, "chapter_id": 1337, "verse_number": "२-७८-१०६", "content_sanskrit": "पांसुराष्ट्राद्वमुदानो राजा षड्विंशतिं गजान्।\nअश्वानां चसहस्रे द्वे राजन्काञ्चनमालिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2016133, "chapter_id": 1337, "verse_number": "२-७८-१०७", "content_sanskrit": "जवसत्वोपपन्नानां वयस्थानां नराधिप।\nबलिं च कृत्स्नमादाय पाण्डवेभ्यो न्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2016134, "chapter_id": 1337, "verse_number": "२-७८-१०८", "content_sanskrit": "यज्ञसेनेन दासीनां सहस्राणि चतुर्दश।\nदासानामयुतं चैव सदाराणां विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2016135, "chapter_id": 1337, "verse_number": "२-७८-१०९", "content_sanskrit": "गजयुक्ता महाराज रथाः षड्विंशतिस्तथा।\nराज्यं च कृत्स्नं पार्थेभ्यो यज्ञार्थं वै निवेदितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2016136, "chapter_id": 1337, "verse_number": "२-७८-११०", "content_sanskrit": "वासुदेवोऽपि वार्ष्णेयो मानं कुर्वन्किरीटिनः।\nअददद्गजमुख्यानां सहस्राणि चतुर्दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2016137, "chapter_id": 1337, "verse_number": "२-७८-१११", "content_sanskrit": "आत्मा हि कृष्णः पार्थस्य कृष्णस्यात्मा धनञ्जयः।\nयद्ब्रूयादर्जुनः कृष्णं सर्वं कुर्यादसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2016138, "chapter_id": 1337, "verse_number": "२-७८-११२", "content_sanskrit": "कृष्णो धनञ्जयस्यार्थे स्वर्गलोकमपि त्यजेत्।\nतथैव पार्थः कृष्णार्थे प्राणानपि परित्यजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2016139, "chapter_id": 1337, "verse_number": "२-७८-११३", "content_sanskrit": "सुरभींश्चन्दनरसान्हेमकुम्भसमास्थितान्।\nमलयाद्दर्दुराच्चैव चन्दनागुरुसञ्चयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2016140, "chapter_id": 1337, "verse_number": "२-७८-११४", "content_sanskrit": "मणिरत्नानि भास्वन्ति काञ्चनं सूक्ष्मवस्त्रकम्।\nचोलपाण्ड्यावपि द्वारं न लेभाते ह्युपस्थितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2016141, "chapter_id": 1337, "verse_number": "२-७८-११५", "content_sanskrit": "समुद्रसारं वैदूर्यं मुक्तासङ्घांस्तथैव च।\nशतशश्च कुथांस्तत्र सिंहलाः समुपाहरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2016142, "chapter_id": 1337, "verse_number": "२-७८-११६", "content_sanskrit": "संवृता मणिचीरैस्तु श्यामास्ताम्रान्तलोचनाः।\nता गृहीत्वा नरास्तत्र द्वारि तिष्ठन्ति वारिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2016143, "chapter_id": 1337, "verse_number": "२-७८-११७", "content_sanskrit": "प्रीत्यर्थं ब्राह्मणश्चैव क्षत्रियाश्च विनिर्जिताः।\nउपाजह्रुर्विशश्चैव शूद्राः शुश्रूषवस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2016144, "chapter_id": 1337, "verse_number": "२-७८-११८", "content_sanskrit": "प्रीत्या च बहुमानाच्चाप्युपागच्छन्युधिष्ठिरम्।\nसर्वे म्लेच्छाः सर्ववर्णा आदिमध्यान्तजास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2016145, "chapter_id": 1337, "verse_number": "२-७८-११९", "content_sanskrit": "नानादेशसमुत्थैश्चन नानाजितिभिरेव च।\nपर्यस्त इव लोकोऽयं युधिष्ठिरनिवेशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2016146, "chapter_id": 1337, "verse_number": "२-७८-१२०", "content_sanskrit": "उच्चावचानुपग्राहान्राजभिः प्रापितान्बहून्।\nशत्रूणां पश्यतो दुःखान्मुमूर्षा मे व्यजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2016147, "chapter_id": 1337, "verse_number": "२-७८-१२१", "content_sanskrit": "भृत्यास्तु ये पाण्डवानां तांस्ते वक्ष्यामि पार्थिव।\nयेषामामं च पक्वं च संविधत्ते युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2016148, "chapter_id": 1337, "verse_number": "२-७८-१२२", "content_sanskrit": "अयुतं त्रीणि पद्मानि गजारोहाः ससादिनः।\nरथानामर्बुदं चापि पादाता बहवस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2016149, "chapter_id": 1337, "verse_number": "२-७८-१२३", "content_sanskrit": "प्रमीयमाणमां च पच्यमानं तथैव च।\nविसृज्यमानं चान्यत्र पुण्याहस्वन एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2016150, "chapter_id": 1337, "verse_number": "२-७८-१२४", "content_sanskrit": "नाभुक्तवन्तं नापीतं नालङ्कृतमसत्कृतम्।\nअपश्यं सर्ववर्णानां युधिष्ठिरनिवेशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2016151, "chapter_id": 1337, "verse_number": "२-७८-१२५", "content_sanskrit": "अष्टाशीतिसहस्राणि स्नातका गृहमेधिनः।\nत्रिंशद्दासीक एकैको यान्बिभर्ति युधिष्ठिरः।\nसुप्रीताः परितृष्टाश्च ते ह्याशंसत्त्यरिक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2016152, "chapter_id": 1337, "verse_number": "२-७८-१२६", "content_sanskrit": "दशान्यानि सहस्राणि यतीनामूर्ध्वरेतसाम्।\nभुञ्जते रुक्मपात्रीभिर्युधिष्ठिरनिवेशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2016153, "chapter_id": 1337, "verse_number": "२-७८-१२७", "content_sanskrit": "अभुक्तं भुक्तवद्वापि सर्वमाकुब्जवामनम्।\nअभुञ्जाना याज्ञसेनी प्रत्यवैक्षद्विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2016154, "chapter_id": 1337, "verse_number": "२-७८-१२८", "content_sanskrit": "द्वौ करौ न प्रयच्छेतां कुन्तीपुत्राय भारत।\nसाम्बन्धिकेनपाञ्चालाः सख्येनान्धकवृष्णयः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2016155, "chapter_id": 1337, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि द्यूतपर्वणि अष्टसप्ततितमोऽध्यायः॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}]