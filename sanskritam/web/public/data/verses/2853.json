[{"id": 2087402, "chapter_id": 2853, "verse_number": "१२-३५८-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2087403, "chapter_id": 2853, "verse_number": "१२-३५८-१", "content_sanskrit": "अहो ह्येकान्तिनः सर्वान्प्रीणाति भगवान्हरिः।\nविधिप्रयुक्तां पूजां च गृह्णाति शिरसा स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2087404, "chapter_id": 2853, "verse_number": "१२-३५८-२", "content_sanskrit": "ये तु दग्धेन्धना लोके पुण्यपापविवर्जिताः।\nतेषां च या हि निर्दिष्टा पारम्पर्यागता गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2087405, "chapter_id": 2853, "verse_number": "१२-३५८-३", "content_sanskrit": "चतुर्थ्यां चैव ते गत्यां गच्छन्ति पुरुषोत्तमम्।\nएकान्तिनस्तु पुरुषा गच्छन्ति परमं पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2087406, "chapter_id": 2853, "verse_number": "१२-३५८-४", "content_sanskrit": "नूनमेकान्तधर्मोऽयं श्रेष्ठो नारायणप्रियः।\nअगत्वा गतयतिस्रो यद्गच्छत्यव्ययं हरिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2087407, "chapter_id": 2853, "verse_number": "१२-३५८-५", "content_sanskrit": "सहोपनिषदान्वेदान्ये विप्राः सम्यगास्थिताः।\nपठन्ति विधिमास्थाय ये चापि यतिधर्मिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2087408, "chapter_id": 2853, "verse_number": "१२-३५८-६", "content_sanskrit": "तेभ्यो विशिष्टां जानामि गतिमेकान्तिनां नृणाम्।\nकेनैष धर्मः कथितो देवेन ऋषिणाऽपि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2087409, "chapter_id": 2853, "verse_number": "१२-३५८-७", "content_sanskrit": "एकान्तिनां च का चर्या कदा चोत्पादिता विभो।\nएतन्मे संशयं छिन्धि परं कौतूहलं हि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2087410, "chapter_id": 2853, "verse_number": "१२-३५८-८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2087411, "chapter_id": 2853, "verse_number": "१२-३५८-८", "content_sanskrit": "समुपोढेष्वनीकेषु कुरुपाण्डवयोर्मृधे।\nअर्जुने विमनस्के च गीता भगवता स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2087412, "chapter_id": 2853, "verse_number": "१२-३५८-९", "content_sanskrit": "आगतिश्च गतिश्चैव पूर्वं ते कथिता मया।\nगहनो ह्येष धर्मो वै दुर्विज्ञेयोऽकृतात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2087413, "chapter_id": 2853, "verse_number": "१२-३५८-१०", "content_sanskrit": "संमितः सामवेदेन पुरैवादियुगे कृतः।\nधार्यते स्वयमीशेन राजन्नारायणेन ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2087414, "chapter_id": 2853, "verse_number": "१२-३५८-११", "content_sanskrit": "एतदर्थं महाराज पृष्टः पार्थेन नारदः।\nऋषिमध्ये महाभागः शृण्वतोः कृष्णभीष्मयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2087415, "chapter_id": 2853, "verse_number": "१२-३५८-१२", "content_sanskrit": "गुरुणा च मयाऽप्येव कथितो नृपसत्तम।\nयथा तत्कथितं तत्र नारदेन तथा शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2087416, "chapter_id": 2853, "verse_number": "१२-३५८-१३", "content_sanskrit": "यदाऽऽसीन्मानजं जन्म नारायणमुखोद्गतम्।\nब्रह्मणः पृथिवीपाल तदा नारायणः स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2087417, "chapter_id": 2853, "verse_number": "१२-३५८-१४", "content_sanskrit": "तेन धर्मेण कृतवान्दैवं पित्र्यं च भारत।\nफेनपा ऋषयश्चैव तं धर्मं प्रतिपेदिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2087418, "chapter_id": 2853, "verse_number": "१२-३५८-१५", "content_sanskrit": "वैखानसाः फेनपेभ्यो धर्मं तं प्रतिपदिरे।\nवैखानसेभ्यः सोपस्तु ततः सोऽन्तर्दधे पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2087419, "chapter_id": 2853, "verse_number": "१२-३५८-१६", "content_sanskrit": "यदाऽऽसीच्चाक्षुषं जन्म द्वितीयं ब्रह्मणो नृप।\nयदा पितामहेनैव सोमाद्धर्मः परिश्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2087420, "chapter_id": 2853, "verse_number": "१२-३५८-१७", "content_sanskrit": "नारायणात्मको राजन्रुद्राय प्रददौ च तम्।\nततो योगस्थितो रुद्रः पुरा कृतयुगे नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2087421, "chapter_id": 2853, "verse_number": "१२-३५८-१८", "content_sanskrit": "वालखिल्यानृषीन्सर्वान्धर्ममेनमपाठयत्।\nअन्तर्दधे ततो भूयस्तस्य देवस्य मायया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2087422, "chapter_id": 2853, "verse_number": "१२-३५८-१९", "content_sanskrit": "तृतीयं ब्रह्मणो जन्म यदासीद्वाचिकं महत्।\nतत्रैष धर्मः संभूतः स्वयं नारायणान्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2087423, "chapter_id": 2853, "verse_number": "१२-३५८-२०", "content_sanskrit": "सुपर्णो नाम तमृषिः प्राप्तवान्पुरुषोत्तमात्।\nतपसा वै सुतप्तेन दमेन नियमेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2087424, "chapter_id": 2853, "verse_number": "१२-३५८-२१", "content_sanskrit": "त्रिः परिक्रान्तवानेतत्सुपर्णो धर्मसुत्तमम्।\nयस्मात्तस्माद्व्रतं ह्येतत्रिसौपर्णमिहोच्येत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2087425, "chapter_id": 2853, "verse_number": "१२-३५८-२२", "content_sanskrit": "ऋग्वेदपाठपठितं व्रतमेतद्धि दुश्चरम्।\nसुपर्णाच्चाप्यधिगतो धर्म एष सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2087426, "chapter_id": 2853, "verse_number": "१२-३५८-२३", "content_sanskrit": "वायुना द्विपदश्रिष्ठे प्रथितो जगदायुषा।\nवायोः सकाशात्प्राप्तश्च ऋषिभिर्विघसाशिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2087427, "chapter_id": 2853, "verse_number": "१२-३५८-२४", "content_sanskrit": "तेभ्यो महोदधिश्चैव प्राप्तवान्धर्ममुत्तमम्।\nअन्तर्दधे ततो भूयो नारायणसमाहृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2087428, "chapter_id": 2853, "verse_number": "१२-३५८-२५", "content_sanskrit": "यदा भूयः श्रवणजा सृष्टिरासीन्महात्मनः।\nब्रह्मणः पुरुषव्याघ्र तत्र कीर्तयतः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2087429, "chapter_id": 2853, "verse_number": "१२-३५८-२६", "content_sanskrit": "जगत्स्रष्टुमना देवो हरिर्नारायणः स्वयम्।\nचिन्तयामास पुरुषं जगत्सर्गकरं प्रभुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2087430, "chapter_id": 2853, "verse_number": "१२-३५८-२७", "content_sanskrit": "अथ चिन्तयतस्तस्य कर्णाभ्यां पुरुषः स्मृतः।\nप्रजासर्गकरो ब्रह्मा तमुवाच जगत्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2087431, "chapter_id": 2853, "verse_number": "१२-३५८-२८", "content_sanskrit": "सृज प्रजाः पुत्र सर्वा मुखतः पादतस्तथा।\nश्रेयस्तव विधास्यामि बलं तेजश्च सुव्रत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2087432, "chapter_id": 2853, "verse_number": "१२-३५८-२९", "content_sanskrit": "धर्मं च मत्तो गृह्णीष्व सात्वतं नाम नामतः।\nतेन सृष्टं कृतयुगं स्थापयस्व यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2087433, "chapter_id": 2853, "verse_number": "१२-३५८-३०", "content_sanskrit": "ततो ब्रह्मा नमश्चक्रे देवाय हरिमेधसे।\nधर्मं चाग्र्यं स जग्राह सरहस्यं ससंग्रहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2087434, "chapter_id": 2853, "verse_number": "१२-३५८-३१", "content_sanskrit": "आरण्यकेन सहितं नारायणमुखोद्गतम्।\nउपदिश्य ततो धर्मं ब्रह्मणेऽमिततेजसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2087435, "chapter_id": 2853, "verse_number": "१२-३५८-३२", "content_sanskrit": "तं कार्तयुगधर्माणं निराशीः कर्मसंज्ञितम्।\nजगाम तमसः पारं यत्राव्यक्तं व्यवस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2087436, "chapter_id": 2853, "verse_number": "१२-३५८-३३", "content_sanskrit": "ततोऽथ वरदो देवो ब्रह्मा लोकपितामहः।\nअसृजत्स ततो लोकान्कृत्स्नान्स्थावरजङ्गमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2087437, "chapter_id": 2853, "verse_number": "१२-३५८-३४", "content_sanskrit": "ततः प्रावर्तत तदा आदौ कृतयुगं शुभम्।\nततो हि सात्वतो धर्मो व्याप्य लोकानवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2087438, "chapter_id": 2853, "verse_number": "१२-३५८-३५", "content_sanskrit": "तेनैवाद्येन धर्मेण ब्रह्मा लोकविसर्गकृत्।\nपूजयामास देवेशं हरिं नारायणं प्रभुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2087439, "chapter_id": 2853, "verse_number": "१२-३५८-३६", "content_sanskrit": "धर्मप्रतिष्ठाहेतोश्च मनुं स्वारोचिषं ततः।\nअध्यापयामास तदा लोकानां हितकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2087440, "chapter_id": 2853, "verse_number": "१२-३५८-३७", "content_sanskrit": "ततः स्वारोचिषः पुत्रं स्वयं शङ्खपदं नृप।\nअध्यापयत्पुराऽव्यग्रः सर्वलोकपतिर्विभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2087441, "chapter_id": 2853, "verse_number": "१२-३५८-३८", "content_sanskrit": "ततः शङ्खपदश्चापि पुत्रमात्मजमौरसम्।\nदिशापालं सुधर्माणमध्यापयत भारत।\nसोऽन्तर्दधे ततो भूयः प्राप्ते त्रेतायुगे पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2087442, "chapter_id": 2853, "verse_number": "१२-३५८-३९", "content_sanskrit": "नासत्ये जन्मनि पुरा ब्रह्मणः पार्थिवोत्तम।\nधर्ममेतं स्वयं देवो हरिर्नारायणः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2087443, "chapter_id": 2853, "verse_number": "१२-३५८-४०", "content_sanskrit": "तज्जगादारविन्दाक्षो ब्रह्मणः पश्यतस्तदा।\nसनत्कुमारो भगवांस्ततः प्राधीतवान्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2087444, "chapter_id": 2853, "verse_number": "१२-३५८-४१", "content_sanskrit": "सनत्कुमारादपि च वीरणो वै प्रजापतिः।\nकृतादौ कुरुशार्दूल धर्ममेतदधीतवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2087445, "chapter_id": 2853, "verse_number": "१२-३५८-४२", "content_sanskrit": "वीरणश्चाप्यधीत्यैनं रैभ्याय मुनये ददौ।\nरैभ्यः पुत्राय शुद्धाय सुव्रताय सुमेधसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2087446, "chapter_id": 2853, "verse_number": "१२-३५८-४३", "content_sanskrit": "कुक्षिपालाय च ददौ विशालाय च धर्मिणे।\nततोऽप्यन्तर्दधे भूयो नारायणमुखोद्गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2087447, "chapter_id": 2853, "verse_number": "१२-३५८-४४", "content_sanskrit": "अण्डजे जन्मनि पुनर्ब्रह्मणे हरियोनये।\nएष धर्मः समुद्भूतो नारायणमुखात्पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2087448, "chapter_id": 2853, "verse_number": "१२-३५८-४५", "content_sanskrit": "गृहीतो ब्रह्मणा राजन्प्रयुक्तश्च यथाविधि।\nअध्यापिताश्च मुनयो नाम्ना बर्हिपदो नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2087449, "chapter_id": 2853, "verse_number": "१२-३५८-४६", "content_sanskrit": "बर्हिषद्भ्यश्च संप्राप्तः सामवेदान्तगं द्विजम्।\nज्येष्ठं नामाभिविख्यातं ज्येष्ठसामव्रतो हरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2087450, "chapter_id": 2853, "verse_number": "१२-३५८-४७", "content_sanskrit": "ज्येष्ठाच्चाप्यनुसंक्रान्तो राजानमविकम्पनम्।\nअन्तर्दधे ततो राजन्नेष दर्मः प्रभो हरेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2087451, "chapter_id": 2853, "verse_number": "१२-३५८-४८", "content_sanskrit": "यदिदं सप्तमं जन्म पद्मजं ब्रह्मणो नृप।\nतत्रैष धर्मः कथितः स्वयं नारायणेन ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2087452, "chapter_id": 2853, "verse_number": "१२-३५८-४९", "content_sanskrit": "पितामहाय शुद्धाय युगादौ लोकधारिणे।\nपितामहश्च दक्षाय धर्ममेतं पुरा ददौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2087453, "chapter_id": 2853, "verse_number": "१२-३५८-५०", "content_sanskrit": "ततो ज्येष्ठे तु दौहित्रे प्रादाद्दक्षो नृपोत्तम।\nआदित्ये सवितुर्ज्येष्ठे विवस्वाञ्जगृहे ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2087454, "chapter_id": 2853, "verse_number": "१२-३५८-५१", "content_sanskrit": "त्रेतायुगादौ च ततो विवस्वान्ममवे ददौ।\nमनुश्च लोकभूत्यर्थं सुतायेक्ष्वाकवे ददौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2087455, "chapter_id": 2853, "verse_number": "१२-३५८-५२", "content_sanskrit": "इक्ष्वाकुणा च कथितो व्याप्य लोकानवस्थितः।\nगमिष्यति क्षयान्ते च पुनर्नारायणं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2087456, "chapter_id": 2853, "verse_number": "१२-३५८-५३", "content_sanskrit": "यतीनां चापि यो धर्मः स ते पूर्वं नृपोत्तम।\nकथितो हरिगीतासु समासविधिकल्पितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2087457, "chapter_id": 2853, "verse_number": "१२-३५८-५४", "content_sanskrit": "नारदेन सुसंप्राप्तः सरहस्यः ससंग्रहः।\nएष धर्मो जगन्नाथात्साक्षान्नारायणान्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2087458, "chapter_id": 2853, "verse_number": "१२-३५८-५५", "content_sanskrit": "एवमेव महान्धर्मे आद्यो राजन्सनातनः।\nदुर्विज्ञेयो दुष्करश्च सात्वतैर्धार्यते सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2087459, "chapter_id": 2853, "verse_number": "१२-३५८-५६", "content_sanskrit": "धर्मज्ञानेन चैतेन सुप्रयुक्तेन कर्मणा।\nअहिंसाधर्मयुक्तेन प्रीयते हरिरीश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2087460, "chapter_id": 2853, "verse_number": "१२-३५८-५७", "content_sanskrit": "एकव्यूहविभागो वा क्वचिद्द्विव्यूहसंज्ञितः।\nत्रिव्यूहश्चापि संख्यातश्चतुर्व्यूहश्च दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2087461, "chapter_id": 2853, "verse_number": "१२-३५८-५८", "content_sanskrit": "हरिरेव हि क्षेत्रज्ञो निर्ममो निष्कलस्तथा।\nजीवश्च सर्वभूतेषु पञ्चभूतगुणातिगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2087462, "chapter_id": 2853, "verse_number": "१२-३५८-५९", "content_sanskrit": "मनश्च प्रथितं राजन्पञ्चन्द्रियसमीरणम्।\nएष लोकनिधिः श्रीमानेषु लोकविसर्गकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2087463, "chapter_id": 2853, "verse_number": "१२-३५८-६०", "content_sanskrit": "अकर्ता चैव कर्ता च कार्यं कारणमेव च।\nयथेच्छति तथा राजन्क्रीडते पुरुषोऽव्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2087464, "chapter_id": 2853, "verse_number": "१२-३५८-६१", "content_sanskrit": "एष एकान्तिधर्मस्ते कीर्तितो नृपसत्तम।\nमया गुरुप्रसादेन दुर्विज्ञेयोऽकृतात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2087465, "chapter_id": 2853, "verse_number": "१२-३५८-६२", "content_sanskrit": "एकान्तिनो हि पुरुषा दुर्लभा बहवो नृप।\nयद्येकान्तिभिराकीर्णं जगत्स्यात्कुरुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2087466, "chapter_id": 2853, "verse_number": "१२-३५८-६३", "content_sanskrit": "अहिंसकैरात्मविद्भिः सर्वभूतहिते रतैः।\nभवेत्कृतयुगप्राप्तिराशीः कर्मविवर्जिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2087467, "chapter_id": 2853, "verse_number": "१२-३५८-६४", "content_sanskrit": "एवं स भगवान्व्यासो गुरुर्मम विशांपते।\nकथयामास धर्मज्ञो धर्मराजे द्विजोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2087468, "chapter_id": 2853, "verse_number": "१२-३५८-६५", "content_sanskrit": "ऋषीणां संनिधौ राजञ्शृण्वतोः कृष्णभीष्मयोः।\nतस्याप्यकथयत्पूर्वं नारदः सुमहातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2087469, "chapter_id": 2853, "verse_number": "१२-३५८-६६", "content_sanskrit": "देवं परमकं ब्रह्म श्वेतं चन्द्राभमच्युतम्।\nयत्र चैकान्तिनो यान्ति नारायणपरायणाः।\n`तदेव परमं स्थानं मुक्तानां केवलं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2087470, "chapter_id": 2853, "verse_number": "१२-३५८-६७x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2087471, "chapter_id": 2853, "verse_number": "१२-३५८-६७", "content_sanskrit": "एवं बहुविधं धर्मं प्रविबुद्धैर्निषेवितम्।\nन कुर्वन्ति कथं विप्रा अन्ये नानाव्रते स्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2087472, "chapter_id": 2853, "verse_number": "१२-३५८-६८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2087473, "chapter_id": 2853, "verse_number": "१२-३५८-६८", "content_sanskrit": "तिस्रः प्रकृतयो राजन्देहबन्धेषु निर्मिताः।\nसात्विकी राजसी चैव तामसी चैव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2087474, "chapter_id": 2853, "verse_number": "१२-३५८-६९", "content_sanskrit": "देहबन्धेषु पुरुषः श्रेष्ठः कुरुकुलोद्वह।\nसात्विकः पुरुषव्याघ्र भवेन्मोक्षाय निश्चितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2087475, "chapter_id": 2853, "verse_number": "१२-३५८-७०", "content_sanskrit": "अत्रापि स विजानाति पुरुषं ब्रह्मवित्तमम्।\nनारायणां परं मोक्षे ततो वै सात्विकः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2087476, "chapter_id": 2853, "verse_number": "१२-३५८-७१", "content_sanskrit": "मनीषितं च प्राप्नोति चिन्तयन्पुरुषोत्तमम्।\nएकान्तभक्तः सततं नारायणपरायणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2087477, "chapter_id": 2853, "verse_number": "१२-३५८-७२", "content_sanskrit": "मनीषिणो हि ये केचिद्यतयो मोक्षधर्मिणः।\nतेषां विच्छिन्नतृष्णानां योगक्षेमवहो हरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2087478, "chapter_id": 2853, "verse_number": "१२-३५८-७३", "content_sanskrit": "जायमानं हि पुरुषं यं पश्येन्मधुसूदनः।\nसात्विकस्तु स विज्ञेयो भवेन्मोक्षे च निश्चितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2087479, "chapter_id": 2853, "verse_number": "१२-३५८-७४", "content_sanskrit": "साङ्ख्ययोगेन तुल्यो हि धर्म एकान्तिसेवितः।\nनारायणात्मके मोक्षे ततो यान्ति परां गतिं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2087480, "chapter_id": 2853, "verse_number": "१२-३५८-७५", "content_sanskrit": "नारायणेन दृष्टस्तचु प्रतिबुद्धो भवेत्पुमान्।\nएवमात्मेच्छया राजन्प्रतिबुद्धो न जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2087481, "chapter_id": 2853, "verse_number": "१२-३५८-७६", "content_sanskrit": "राजसी तामसी चैव व्यामिश्रे प्रकृती स्मृते।\nतदात्मकं हि पुरुषं जायमानं विशांपते।\nप्रवृत्तिलक्षणैर्युक्तं नावेक्षति हरिः स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2087482, "chapter_id": 2853, "verse_number": "१२-३५८-७७", "content_sanskrit": "पश्यत्येनं जायमानं ब्रह्मा लोकपितामहः।\nरजसा तपसा चैव मानसं समभिप्लुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2087483, "chapter_id": 2853, "verse_number": "१२-३५८-७८", "content_sanskrit": "कामं देवाश्च ऋषयः सत्वस्था नृपसत्तम।\nहीनाः सत्वेन सूक्ष्मेण ततो वैकारिकाः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2087484, "chapter_id": 2853, "verse_number": "१२-३५८-७९x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2087485, "chapter_id": 2853, "verse_number": "१२-३५८-७९", "content_sanskrit": "कथं वैकारिको गच्छेत्पुरुषः पुरुषोत्तमम्।\nवद सर्वं यथादृष्टं प्रवृत्तिं च यथाक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2087486, "chapter_id": 2853, "verse_number": "१२-३५८-८०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2087487, "chapter_id": 2853, "verse_number": "१२-३५८-८०", "content_sanskrit": "सुसूक्ष्मं तत्त्वसंयुक्तं संयुक्तं त्रिभिरक्षरैः।\nपुरुषः पुरुषं गच्छेन्निष्क्रियं पञ्चविंशकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2087488, "chapter_id": 2853, "verse_number": "१२-३५८-८१", "content_sanskrit": "एवमेकं साङ्ख्ययोगं वेदारण्यकमेव च।\nपरस्पराङ्गान्येतानि पाञ्चरात्रं च कथ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2087489, "chapter_id": 2853, "verse_number": "१२-३५८-८२", "content_sanskrit": "एष एकान्तिनां धर्मो नारायणपरात्मकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2087490, "chapter_id": 2853, "verse_number": "१२-३५८-८३", "content_sanskrit": "यथा समुद्रात्प्रसृता जलौघा\nस्तमेव राजन्पुनराविशन्ति।\nइमे तथा ज्ञानमहाजलौघा\nनारायणं वै पुनराविशन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2087491, "chapter_id": 2853, "verse_number": "१२-३५८-८४", "content_sanskrit": "एष ते कथितो धर्मः सात्वतो यदुबान्धव।\nकुरुष्वैनं यथान्यायं यदि शक्तोसि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2087492, "chapter_id": 2853, "verse_number": "१२-३५८-८५", "content_sanskrit": "एवं हि स महाभागो नारदो गुरवे मम।\nश्वेतानां यतिनां चाह एकान्तगतिमख्याम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2087493, "chapter_id": 2853, "verse_number": "१२-३५८-८६", "content_sanskrit": "व्यासश्चाकथयत्प्रीत्या धर्मपुत्राय धीमते।\nस एवायं मया तुभ्यमाख्यातः प्रसृतो गुरोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2087494, "chapter_id": 2853, "verse_number": "१२-३५८-८७", "content_sanskrit": "इत्थं हि दुश्चरो धर्म एष पार्थिवसत्तम।\nयथैव त्वं तथैवान्ये न भजन्ति च मोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2087495, "chapter_id": 2853, "verse_number": "१२-३५८-८८", "content_sanskrit": "कृष्ण एव हि लोकानां भावनो मोहनस्तथा।\nसंहारकारकश्चैव कारणं च विशांपते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2087496, "chapter_id": 2853, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि नारायणीये अष्टपञ्चाशदधिकत्रिशततमोऽध्यायः॥ ३५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}]