[{"id": 5000171000, "chapter_id": 9171, "verse_number": "२-९४-१", "content_sanskrit": "दीर्घकालोषितस्तस्मिन् गिरौ गिरिवनप्रिय: ।\nवैदेह्या: प्रियमाकांक्षन् स्वं च चित्तं विलोभयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000171001, "chapter_id": 9171, "verse_number": "२-९४-२", "content_sanskrit": "अथ दाशरथिश्चित्रं चित्रकूटमदर्शयत् ।\nभार्य्याममरसङ्काश: शचीमिव पुरन्दर: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000171002, "chapter_id": 9171, "verse_number": "२-९४-३", "content_sanskrit": "न राज्याद्भ्रंशनं भद्रे न सुहृद्भिर्विनाभव: ।\nमनो मे बाधते दृष्ट्वा रमणीयमिमं गिरिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000171003, "chapter_id": 9171, "verse_number": "२-९४-४", "content_sanskrit": "पश्येममचलं भद्रे नानाद्विजगणायुतम् ।\nशिखरै: खमिवोद्विद्धैर्द्धातुमद्भिर्विभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000171004, "chapter_id": 9171, "verse_number": "२-९४-५", "content_sanskrit": "केचिद्रजतसङ्काशा: केचित् क्षतजसन्निभा: ।\nपीतमाञ्जिष्ठवर्णाश्च केचिन्मणिवरप्रभा: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000171005, "chapter_id": 9171, "verse_number": "२-९४-६", "content_sanskrit": "पुष्पार्ककेतकाभाश्च केचिज्ज्योतीरसप्रभा: ।\nविराजन्ते ऽचलेन्द्रस्य देशा धातुविभूषिता: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000171006, "chapter_id": 9171, "verse_number": "२-९४-७", "content_sanskrit": "नानामृगगणद्वीपितरक्ष्वृक्षगणैर्वृत: ।\nअदुष्टैर्भात्ययं शैलो बहुपक्षिसमायुत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000171007, "chapter_id": 9171, "verse_number": "२-९४-८", "content_sanskrit": "आम्रजम्ब्वसनैर्लोध्रै: प्रियालै: पनसैर्धवै: ।\nअङ्कोलैर्भव्यतिनिशैर्बिल्वतिन्दुकवेणुभि: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000171008, "chapter_id": 9171, "verse_number": "२-९४-९", "content_sanskrit": "काश्मर्यरिष्टवरुणैर्मधूकैस्तिलकैस्तथा ।\nबदर्य्यामलकैर्नीपैर्वेत्रधन्वनबीजकै: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000171009, "chapter_id": 9171, "verse_number": "२-९४-१०", "content_sanskrit": "पुष्पवद्भि: फलोपेतैश्छायावद्भिर्मनोरमै: ।\nएवमादिभिराकीर्ण: श्रियं पुष्यत्ययं गिरि: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000171010, "chapter_id": 9171, "verse_number": "२-९४-११", "content_sanskrit": "शैलप्रस्थेषु रम्येषु पश्येमान् रोमहर्षणान् ।\nकिन्नरान् द्वन्द्वशो भद्रे रममाणान् मनस्विन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000171011, "chapter_id": 9171, "verse_number": "२-९४-१२", "content_sanskrit": "शाखावसक्तान् खङ्गांश्च प्रवराण्यम्बराणि च ।\nपश्च विद्याधरस्त्रीणां क्रीडोद्देशान् मनोरमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000171012, "chapter_id": 9171, "verse_number": "२-९४-१३", "content_sanskrit": "जलप्रपातैरुद्भेदैर्निष्यन्दैश्च क्वचित् क्वचित् ।\nस्रवद्भिर्भात्ययं शैल: स्रवन्मद इव द्विप: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000171013, "chapter_id": 9171, "verse_number": "२-९४-१४", "content_sanskrit": "गुहासमीरणो गन्धान् नानापुष्पभवान् वहन् ।\nघ्राणतर्प्पणमभ्येत्य कं नरं न प्रहर्षयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000171014, "chapter_id": 9171, "verse_number": "२-९४-१५", "content_sanskrit": "यदीह शरदो ऽनेकास्त्वया सार्द्धमनिन्दिते ।\nलक्ष्मणेन च वत्स्यामि न मां शोक: प्रधक्ष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000171015, "chapter_id": 9171, "verse_number": "२-९४-१६", "content_sanskrit": "बहुपुष्पफले रम्ये नानाद्विजगणायुते ।\nविचित्रशिखरे ह्यस्मिन् रतवानस्मि भामिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000171016, "chapter_id": 9171, "verse_number": "२-९४-१७", "content_sanskrit": "अनेन वनवासेन मया प्राप्तं फलद्वयम् ।\nपितुश्चानृणता धर्मे भरतस्य प्रियं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000171017, "chapter_id": 9171, "verse_number": "२-९४-१८", "content_sanskrit": "वैदेहि रमसे कच्चिच्चित्रकूटे मया सह ।\nपश्यन्ती विविधान् भावान् मनोवाक्कायसंयतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000171018, "chapter_id": 9171, "verse_number": "२-९४-१९", "content_sanskrit": "इदमेवामृतं प्राहू राज्ञि राजर्षय: परे ।\nवनवासं भवार्थाय प्रेत्य मे प्रपितामहा: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000171019, "chapter_id": 9171, "verse_number": "२-९४-२०", "content_sanskrit": "शिला: शैलस्य शोभन्ते विशाला: शतशो ऽभित: ।\nबहुला बहुलैर्वर्णैर्नीलपीतसितारुणै: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000171020, "chapter_id": 9171, "verse_number": "२-९४-२१", "content_sanskrit": "निशि भान्त्यचलेन्द्रस्य हुताशनशिखा इव ।\nओषध्य: स्वप्रभालक्ष्या भ्राजमाना: सहस्रश: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000171021, "chapter_id": 9171, "verse_number": "२-९४-२२", "content_sanskrit": "केचित् क्षयनिभा देशा: केचिदुद्यानसन्निभा: ।\nकेचिदेकशिला भान्ति पर्वतस्यास्य भामिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000171022, "chapter_id": 9171, "verse_number": "२-९४-२३", "content_sanskrit": "भित्त्वेव वसुधां भाति चित्रकूट: समुत्थित: ।\nचित्रकूटस्य कूटो ऽसौ दृश्यते सर्वत: शुभ: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000171023, "chapter_id": 9171, "verse_number": "२-९४-२४", "content_sanskrit": "कुष्ठपुन्नागस्ऺथगरभूर्जपत्रोत्तरच्छदान् ।\nकामिनां स्वास्तरान् पश्य कुशेशयदलायुतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000171024, "chapter_id": 9171, "verse_number": "२-९४-२५", "content_sanskrit": "मृदिताश्चापविद्धाश्च दृश्यन्ते कमलस्रज: ।\nकामिभिर्वनिते पश्य फलानि विविधानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000171025, "chapter_id": 9171, "verse_number": "२-९४-२६", "content_sanskrit": "वस्वौकसारां नलिनीमत्येतीवोत्तरान् कुरून् ।\nपर्वतश्चित्रकूटो ऽसौ बहुमूलफलोदक: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000171026, "chapter_id": 9171, "verse_number": "२-९४-२७", "content_sanskrit": "इमं तु कालं वनिते विजह्रिवांस्त्वया च सीते सह लक्ष्मणेन च ।\nरतिं प्रपत्स्ये कुलधर्मवर्द्धनीं सतां पथि स्वैर्नियमै: परै: स्थित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000171027, "chapter_id": 9171, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदयोध्याकाण्डे चतुर्नवतितम: सर्ग: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]