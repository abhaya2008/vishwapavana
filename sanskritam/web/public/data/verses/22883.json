[{"id": 7002883000, "chapter_id": 22883, "verse_number": "९-१६८-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nसर्वशास्त्रार्थतत्त्वज्ञ ज्ञानविज्ञानपारग ।\nगृहदानस्य माहात्म्यं विधिं वद विदांवर ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002883001, "chapter_id": 22883, "verse_number": "९-१६८-२", "content_sanskrit": "श्रीकृष्ण उवाच ।\nन गार्हस्थयात्परो धर्मो नास्ति दानं गृहात्परम् ।\nनानृतादधिकं पापं न पूज्यो ब्राह्मणात्परः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002883002, "chapter_id": 22883, "verse_number": "९-१६८-३", "content_sanskrit": "धनधान्यसमायुक्तं कलत्रापत्यसंकुलम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002883003, "chapter_id": 22883, "verse_number": "९-१६८-४", "content_sanskrit": "गोगजाश्वगणाकीर्णं गृहं स्वर्गाद्विशिष्यते ।\nयथा मातरमाश्रित्य सर्वे जीवंति जंतवः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002883004, "chapter_id": 22883, "verse_number": "९-१६८-५", "content_sanskrit": "एवं गृहस्थमाश्रित्य वर्तयंतीतराश्रमाः ।\nधर्मश्चार्थश्च कामश्च मित्राणि प्रथितं यशः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002883005, "chapter_id": 22883, "verse_number": "९-१६८-६", "content_sanskrit": "प्राप्तकामैर्नरैः पार्थ सदा सेव्यो गृहाश्रमः ।\nन गृहेण विना धर्मो नार्थकामौ सुखं न च ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002883006, "chapter_id": 22883, "verse_number": "९-१६८-७", "content_sanskrit": "न लोक पंक्तिर्न यशः प्राप्यते त्रिदशैरपि ।\nन तत्स्वर्गे नापवर्गे न तत्केनोपमीयते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002883007, "chapter_id": 22883, "verse_number": "९-१६८-८", "content_sanskrit": "प्रसार्य पादौ यद्रात्रौ स्वगृहे स्वपतां सुखम् ।\nदिनानि नास्य गण्यंते नैनमाहुर्महाशनम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002883008, "chapter_id": 22883, "verse_number": "९-१६८-९", "content_sanskrit": "अपि शाकं पचानस्य स्वगृहे परमं सुखम् ।\nइति मत्वा महाराज कारयित्वा सुशोभनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002883009, "chapter_id": 22883, "verse_number": "९-१६८-१०", "content_sanskrit": "भवनं ब्राह्मणे देयं भव्यभूतिमभीप्सता ।\nकारयित्वा दृढस्तंभं शुभपक्वेष्टकामयम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002883010, "chapter_id": 22883, "verse_number": "९-१६८-११", "content_sanskrit": "शुभं कमठपृष्ठाभं भाभासितदिगंतरम् ।\nसुधानुलिप्तं गुप्तं च सुखशालाविराजितम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002883011, "chapter_id": 22883, "verse_number": "९-१६८-१२", "content_sanskrit": "दद्यादनंतफलदं शैववैष्णवयोगिनाम् ।\nप्रतिश्रये तु विस्तीर्णे कारिते सजले घने ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002883012, "chapter_id": 22883, "verse_number": "९-१६८-१३", "content_sanskrit": "दीनानाथजलार्थाय कृतं किं न कृतं भवेत् ।\nकारयित्वा गृहान्पश्चादृत्विग्रुद्रार्कसंख्यया ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002883013, "chapter_id": 22883, "verse_number": "९-१६८-१४", "content_sanskrit": "कुढ्यस्तंभगवाक्षाढयान्विचित्रान्बहुभूमिकान् ।\nसप्राकारप्रतोलीकान्कपाटार्गलयंत्रितान् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002883014, "chapter_id": 22883, "verse_number": "९-१६८-१५", "content_sanskrit": "सुधाधवलितान्रम्यान्विस्तीर्णांगणवाटिकान् ।\nप्रवेशनिर्गमयुतान्समासन्नजलाशयान् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002883015, "chapter_id": 22883, "verse_number": "९-१६८-१६", "content_sanskrit": "लोहोपस्करसंपूर्णांस्ता म्रोपस्करसंयुतान् ।\nस्वर्णोपस्करशोभाढ्यान्रौप्योपस्करसंकुलान् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002883016, "chapter_id": 22883, "verse_number": "९-१६८-१७", "content_sanskrit": "रत्नोपस्करसंयुक्तान्कांस्योपस्करमंडितान् ।\nआरकूटत्रपुसीसदा नोपस्करवर्जितान् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002883017, "chapter_id": 22883, "verse_number": "९-१६८-१८", "content_sanskrit": "वंशोपस्करसंकीर्णान्काष्ठोपस्कर बृंहितान् ।\nमृन्मयोपस्कराकीर्णान्वस्त्रोपकरणान्वितान् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002883018, "chapter_id": 22883, "verse_number": "९-१६८-१९", "content_sanskrit": "धर्मोपस्करसंभारशणवल्कलराजितान् ।\nराजितांस्तृणपाषाणैः सर्वोपस्करभूषितान् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002883019, "chapter_id": 22883, "verse_number": "९-१६८-२०", "content_sanskrit": "सप्तधातुमयं भांडं यत्तद्रत्नसमुद्भवम् ।\nचर्मकाष्ठमहाभांडं नववस्तुमयं तथा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002883020, "chapter_id": 22883, "verse_number": "९-१६८-२१", "content_sanskrit": "गोमहिष्यश्ववृषभप्रेष्यवेश्यागणान्वितान् ।\nक्षेत्रारामजलासन्नान्काम्यान्हर्म्यवराञ्छुभान् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002883021, "chapter_id": 22883, "verse_number": "९-१६८-२२", "content_sanskrit": "संपूर्णान्सर्वधान्यैस्तु घृततैलगुडादिभिः ।\nतिलतंदुलशालीक्षुमुद्गगोधूमसर्षपैः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002883022, "chapter_id": 22883, "verse_number": "९-१६८-२३", "content_sanskrit": "निष्पावाढक्यचणककुलत्थाणुमसूरकैः ।\nकंगुमाषयवाद्याढ्याञ्छाकवृंताकपूरितान् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002883023, "chapter_id": 22883, "verse_number": "९-१६८-२४", "content_sanskrit": "लवणार्द्रकखर्जूरद्राक्षाजीरकधान्यकैः ।\nहिंगुकुंकुमकर्पूरस्नानद्रव्यैः सचंदनैः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002883024, "chapter_id": 22883, "verse_number": "९-१६८-२५", "content_sanskrit": "धूपोपस्करपर्युप्ततूलीगण्डोपधानकैः ।\nचुल्लीच्छेदनमंथानभद्रासनकगुच्छकैः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002883025, "chapter_id": 22883, "verse_number": "९-१६८-२६", "content_sanskrit": "पिठरोलूखलस्थालीशूर्पदर्पणपत्रकैः ।\nमुशलासिकृपाणीषुदंडकोदंडमुद्गरैः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002883026, "chapter_id": 22883, "verse_number": "९-१६८-२७", "content_sanskrit": "गृहाटवाटकादर्वीदृषल्लोष्टकहस्तकैः ।\nचात्रकांशुकलोहादि दीप्तमंथनिकादिभिः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002883027, "chapter_id": 22883, "verse_number": "९-१६८-२८", "content_sanskrit": "कंडणी पेषणी चुल्ली उदकुम्भी प्रमार्जनी ।\nमंजूषाकोष्ठकासंदी कंबलैस्तनुरांकवैः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002883028, "chapter_id": 22883, "verse_number": "९-१६८-२९", "content_sanskrit": "इत्येवमादिभिः पूर्णान्गृहान्दद्याद्द्विजातिषु ।\nकर्तुश्चंद्रबलोपेते स्थिरनक्षत्रसंयुते ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002883029, "chapter_id": 22883, "verse_number": "९-१६८-३०", "content_sanskrit": "शुभेऽह्नि विप्रकथिते दानकालः प्रशस्यते ।\nएवं संभृतसंभारो यजमानः स्वयं द्विजान् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002883030, "chapter_id": 22883, "verse_number": "९-१६८-३१", "content_sanskrit": "कुलशीलसमायुक्तान्गृहसंख्यान्निमंत्रयेत् ।\nअधीतवेदाञ्छास्त्रज्ञान्पुराणस्मृतिपारगान् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002883031, "chapter_id": 22883, "verse_number": "९-१६८-३२", "content_sanskrit": "गृहस्थधर्मनिरताञ्छांतान्दांताञ्जितेंद्रियान् ।\nअलंकृत्य सपत्नीकान्वासोभिरथ पूजयेत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002883032, "chapter_id": 22883, "verse_number": "९-१६८-३३", "content_sanskrit": "सुगंधिस्रग्धरान्कृत्वा शांतिकर्मणि योजयेत् ।\nगृहांगणे कारयित्वा कुंडमेकं समेखलम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002883033, "chapter_id": 22883, "verse_number": "९-१६८-३४", "content_sanskrit": "ग्रहयज्ञः प्रकर्तव्यस्तुष्टिपुष्टिकरः सदा ।\nराक्षोघ्नानि च सूक्तानि पठेयुर्ब्राह्मणास्ततः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002883034, "chapter_id": 22883, "verse_number": "९-१६८-३५", "content_sanskrit": "वास्तुपूजा प्रकर्तव्या दिक्षु भूतबलिं क्षिपेत् ।\nततः पुण्याहघोषेण ब्राह्मणांस्तेषु वेश्मसु ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002883035, "chapter_id": 22883, "verse_number": "९-१६८-३६", "content_sanskrit": "प्रवेशयित्वा शय्यासु सभार्यानुपवेशयेत् ।\nयजमानस्ततः प्राज्ञः शुक्लांबरधरः शुचिः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002883036, "chapter_id": 22883, "verse_number": "९-१६८-३७", "content_sanskrit": "यद्यस्य विहितं पूर्वं तत्तस्य प्रतिपादयेत् ।\nइदं गृहं गृहाण त्वं सर्वोपस्करसंयुतम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002883037, "chapter_id": 22883, "verse_number": "९-१६८-३८", "content_sanskrit": "तव विप्र प्रसादेन ममास्त्वभिमतं फलम् ।\nएवमेकैकशो दत्त्वा प्रणिपत्य क्षमापयेत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002883038, "chapter_id": 22883, "verse_number": "९-१६८-३९", "content_sanskrit": "स्वस्तीति ब्राह्मणैर्वाच्यं कोदादिति च पूजितैः ।\nगृहोपकरणैस्तुल्या दक्षिणा भवनं विना ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002883039, "chapter_id": 22883, "verse_number": "९-१६८-४०", "content_sanskrit": "उपदेष्टारमापृच्छेत्तन्मूलत्वान्महर्षयः ।\nस्वयं तान्पूजयित्वा तु ततः स्वभवनं व्रजेत् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002883040, "chapter_id": 22883, "verse_number": "९-१६८-४१", "content_sanskrit": "दद्यादनेन विधिना गृहमेकं बहूनपि ।\nन संख्यानियमः कार्यः शक्तिरत्र नियामिका ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002883041, "chapter_id": 22883, "verse_number": "९-१६८-४२", "content_sanskrit": "शीतवातातपहरं दत्त्वा तृणकुटीरकम् ।\nइष्टान्कामानवाप्नोति प्रेत्य स्वर्गे महीयते ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002883042, "chapter_id": 22883, "verse_number": "९-१६८-४३", "content_sanskrit": "किं पुनर्बहुनोक्तेन सर्वोपस्करभूषिताम् ।\nअत्यंतसुखलुब्धेन दत्त्वा ब्रह्मपुरीं प्रियाम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002883043, "chapter_id": 22883, "verse_number": "९-१६८-४४", "content_sanskrit": "गोभूहिरण्यदानानि यमाः सनियमास्तथा ।\nगृहदानस्य कौंतेय कलां नार्हंति षोडशीम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002883044, "chapter_id": 22883, "verse_number": "९-१६८-४५", "content_sanskrit": "यः कारयेत्सुदृढहर्म्यवती महार्हा सत्सेवितां द्विजपुरीं सुजनोपभोग्याम् ।\nदिव्याप्सरोभिरभि नंदितचित्तवृत्तिः प्राप्नोत्यसावनवमं पदमिंदुमौलेः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]