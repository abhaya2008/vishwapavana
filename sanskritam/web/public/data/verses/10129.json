[{"id": 6000129000, "chapter_id": 10129, "verse_number": null, "content_sanskrit": "अथ दशमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000129001, "chapter_id": 10129, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.001.m4a", "display_order": 2}, {"id": 6000129002, "chapter_id": 10129, "verse_number": "६-१०-१", "content_sanskrit": "इन्द्रमेवं समादिश्य भगवान् विश्वभावनः।\nपश्यतामनिमेषाणां तत्रैवान्तर्दधे हरिः॥ ६/१०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.002.m4a", "display_order": 3, "topics": [{"text": "देवैः स्वास्थीनि याचितेन दधीचा योगेन स्वदेहत्यागः", "range": "१–१२"}]}, {"id": 6000129003, "chapter_id": 10129, "verse_number": "६-१०-२", "content_sanskrit": "तथाऽभियाचितो देवैर्ऋषिराथर्वणो महान्।\nमोदमान उवाचेदं प्रहसन्नेव भारत॥ ६/१०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.003.m4a", "display_order": 4}, {"id": 6000129004, "chapter_id": 10129, "verse_number": "६-१०-३", "content_sanskrit": "अपि वृन्दारका यूयं न जानीथ शरीरिणाम्।\nसंस्थायां यस्त्वभिद्रोहो दुःसहश्चेतनापहः॥ ६/१०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.004.m4a", "display_order": 5}, {"id": 6000129005, "chapter_id": 10129, "verse_number": "६-१०-४", "content_sanskrit": "जिजीविषूणां जीवानामात्मा प्रेष्ठ इहेप्सितः।\nक उत्सहेत तं दातुं भिक्षमाणाय विष्णवे॥ ६/१०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.005.m4a", "display_order": 6}, {"id": 6000129006, "chapter_id": 10129, "verse_number": null, "content_sanskrit": "देवा ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.006.m4a", "display_order": 7}, {"id": 6000129007, "chapter_id": 10129, "verse_number": "६-१०-५", "content_sanskrit": "किन्नु तद् दुस्त्यजं ब्रह्मन् पुंसां भूतानुकम्पिनाम्।\nभवद्विधानां महतां पुण्यश्लोकेड्यकर्मणाम्॥ ६/१०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.007.m4a", "display_order": 8}, {"id": 6000129008, "chapter_id": 10129, "verse_number": "६-१०-६", "content_sanskrit": "नूनं स्वार्थपरो लोको न वेद परसङ्कटम्।\nयदि वेद न याचेत नेति नाह यदीश्वरः॥ ६/१०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.008.m4a", "display_order": 9}, {"id": 6000129009, "chapter_id": 10129, "verse_number": null, "content_sanskrit": "ऋषिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.009.m4a", "display_order": 10}, {"id": 6000129010, "chapter_id": 10129, "verse_number": "६-१०-७", "content_sanskrit": "धर्मं वः श्रोतुकामेन यूयं वै प्रत्युदाहृताः।\nएष वः प्रियमात्मानं त्यजन्तं सन्त्यजाम्यहम्॥ ६/१०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.010.m4a", "display_order": 11}, {"id": 6000129011, "chapter_id": 10129, "verse_number": "६-१०-८", "content_sanskrit": "योऽध्रुवेणात्मना नाथा न धर्मं न यशः पुमान्।\nईहेत भूतदयया स शोच्यः स्थावरैरपि॥ ६/१०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.011.m4a", "display_order": 12}, {"id": 6000129012, "chapter_id": 10129, "verse_number": "६-१०-९", "content_sanskrit": "एतावानव्ययो धर्मः पुण्यश्लोकैरुपासितः।\nयो भूतशोकहर्षाभ्यामात्मा शोचति हृष्यति॥ ६/१०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.012.m4a", "display_order": 13}, {"id": 6000129013, "chapter_id": 10129, "verse_number": "६-१०-१०", "content_sanskrit": "अहो दैन्यमहो कष्टं पारक्यैः क्षणभङ्गुरैः।\nयन्नोपकुर्यादस्वार्थैर्मर्त्यः स्वज्ञातिविग्रहैः॥ ६/१०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.013.m4a", "display_order": 14}, {"id": 6000129014, "chapter_id": 10129, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.014.m4a", "display_order": 15}, {"id": 6000129015, "chapter_id": 10129, "verse_number": "६-१०-११", "content_sanskrit": "एवं कृतव्यवसितो दध्यङाथर्वणस्तनुम्।\nपरे भगवति ब्रह्मण्यात्मानं संनयन् जहौ॥ ६/१०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.015.m4a", "display_order": 16}, {"id": 6000129016, "chapter_id": 10129, "verse_number": "६-१०-१२", "content_sanskrit": "यत्राक्षासुमनोबुद्धिस्तत्वदृग् ध्वस्तबन्धनः।\nआस्थितः परमं योगं न देहं बुबुधे गतम्॥ ६/१०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.016.m4a", "display_order": 17}, {"id": 6000129017, "chapter_id": 10129, "verse_number": "६-१०-१३", "content_sanskrit": "अथेन्द्रो वज्रमुद्यम्य निर्मितं विश्वकर्मणा।\nमुनेस्त्वस्थिभिरुत्सिक्तो भगवत्तेजसाऽन्वितः॥ ६/१०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.017.m4a", "display_order": 18, "topics": [{"text": "तदस्थिनिर्मितं वज्रायुधमादायेन्द्रस्य अनेकैरसुरैः सहितेन वृत्रासुरेण सह युद्धम्", "range": "१३–२६"}]}, {"id": 6000129018, "chapter_id": 10129, "verse_number": "६-१०-१४", "content_sanskrit": "युतो देवगणैः सर्वैर्गजेन्द्रोपर्यशोभत।\nस्तूयमानो मुनिगणैस्‍त्रैलोक्यं हर्षयन्निव॥ ६/१०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.018.m4a", "display_order": 19}, {"id": 6000129019, "chapter_id": 10129, "verse_number": "६-१०-१५", "content_sanskrit": "वृत्रमभ्यद्रवच्छत्रुमसुरानीकयूथपैः।\nपर्यस्तमोजसा राजन् क्रुद्धो रुद्र इवान्तकम्॥ ६/१०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.019.m4a", "display_order": 20}, {"id": 6000129020, "chapter_id": 10129, "verse_number": "६-१०-१६", "content_sanskrit": "ततः सुराणामसुरै रणः परमदारुणः।\nत्रेतामुखे नर्मदायामासीद् वै प्रथमेऽन्तरे॥ ६/१०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.020.m4a", "display_order": 21}, {"id": 6000129021, "chapter_id": 10129, "verse_number": "६-१०-१७", "content_sanskrit": "रुद्रैर्वसुभिरादित्यैरश्विभ्यां पितृवह्निभिः।\nमरुद्भिर्ऋभुभिः साध्यैर्विश्वेदेवैर्मरुत्पतिम्॥ ६/१०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.021.m4a", "display_order": 22}, {"id": 6000129022, "chapter_id": 10129, "verse_number": "६-१०-१८", "content_sanskrit": "दृष्ट्वा वज्रधरं शक्रं रोचमानं स्वया श्रिया।\nनामृष्यन्नसुरा राजन् मृधे वृत्रपुरःसराः॥ ६/१०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.022.m4a", "display_order": 23}, {"id": 6000129023, "chapter_id": 10129, "verse_number": "६-१०-१९", "content_sanskrit": "नमुचिः शम्बरोऽनर्वा द्विमूर्धा वृषभोऽम्बरः।\nहयग्रीवः शङ्कुशिरा विप्रचित्तिरयोमुखः॥ ६/१०/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.023.m4a", "display_order": 24}, {"id": 6000129024, "chapter_id": 10129, "verse_number": "६-१०-२०", "content_sanskrit": "पुलोमा वृषपर्वा च प्रहेतिर्हेतिरुत्कचः।\nव्योमकेशो विरूपाक्षः कपिलोऽथ विभावसुः॥ ६/१०/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.024.m4a", "display_order": 25}, {"id": 6000129025, "chapter_id": 10129, "verse_number": "६-१०-२१", "content_sanskrit": "इल्वलो बल्वलश्चैव दन्दशूको वृषध्वजः।\nकालनाभो महानाभो भूतसन्तापनो वृकः॥ ६/१०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.025.m4a", "display_order": 26}, {"id": 6000129026, "chapter_id": 10129, "verse_number": "६-१०-२२", "content_sanskrit": "दैतेया दानवा यक्षा रक्षांसि च सहस्रशः।\nसुमालिमालिप्रमुखाः कार्तस्वरपरिच्छदाः॥ ६/१०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.026.m4a", "display_order": 27}, {"id": 6000129027, "chapter_id": 10129, "verse_number": "६-१०-२३", "content_sanskrit": "प्रतिषिध्येन्द्रसेनाग्र्यं मृत्योरपि दुरासदम्।\nअभ्यद्रवन्नसम्भीताः सिंहनादेन दुर्मदाः॥ ६/१०/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.027.m4a", "display_order": 28}, {"id": 6000129028, "chapter_id": 10129, "verse_number": "६-१०-२४", "content_sanskrit": "गदासिपरिघैर्बाणैः पाशमुद्गरतोमरैः। शूलैः परश्वधैः खड्गैः शतघ्नीभिर्भुशुण्डिभिः।\nसर्वतोऽवाकिरन्नस्‍त्रैः शस्‍त्रैश्च विबुधर्षभान्॥ ६/१०/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.028.m4a", "display_order": 29}, {"id": 6000129029, "chapter_id": 10129, "verse_number": "६-१०-२५", "content_sanskrit": "न तेऽदृश्यन्त सञ्छन्नाः शरजालैः समन्ततः।\nपुङ्खानुपुङ्खैः पतितैः प्रावृषीव नभो घनैः॥ ६/१०/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.029.m4a", "display_order": 30}, {"id": 6000129030, "chapter_id": 10129, "verse_number": "६-१०-२६", "content_sanskrit": "न ते शस्‍त्रास्‍त्रबाणौघा व्यासेदुः सुरसैनिकान्।\nछिन्नाः सिद्धपथे देवैर्लघुहस्तैः सहस्रधा॥ ६/१०/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.030.m4a", "display_order": 31}, {"id": 6000129031, "chapter_id": 10129, "verse_number": "६-१०-२७", "content_sanskrit": "अथ क्षीणास्‍त्रशस्‍त्रौघा गिरिशृृङ्गद्रुमोपलैः।\nअभ्यवर्षन् सुरबलं चिच्छिदुस्तांश्च पूर्ववत्॥ ६/१०/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.031.m4a", "display_order": 32, "topics": [{"text": "युद्धे असुराणां पराजयः", "range": "२७–३४"}]}, {"id": 6000129032, "chapter_id": 10129, "verse_number": "६-१०-२८", "content_sanskrit": "तानक्षतान् स्वस्तिमतो निशम्य शस्‍त्रास्‍त्रपूगैरथ वृत्रनाथाः।\nद्रुमैर्दृषद्भिर्विविधाद्रिशृृङ्गैरथाक्षिपंस्तत्र सुरेन्द्रसैनिकान्॥ ६/१०/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.032.m4a", "display_order": 33}, {"id": 6000129033, "chapter_id": 10129, "verse_number": "६-१०-२९", "content_sanskrit": "सर्वे प्रयासा अभवन् विमोघाः कृताः कृता देवगणेषु दैत्यैः।\nकृष्णानुकूलेषु यथा महत्सु क्षुद्रैः प्रयुक्ता रुशती रूक्षवाचः॥ ६/१०/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.033.m4a", "display_order": 34}, {"id": 6000129034, "chapter_id": 10129, "verse_number": "६-१०-३०", "content_sanskrit": "ते स्वप्रयासं वितथं निरीक्ष्य हरावभक्ता हतयुद्धदर्पाः।\nपलायनायाजिमुखे विसृज्य पतिं मनस्ते दधुरस्तसाराः॥ ६/१०/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.034.m4a", "display_order": 35}, {"id": 6000129035, "chapter_id": 10129, "verse_number": "६-१०-३१", "content_sanskrit": "वृत्रोऽसुरांस्ताननुगान् मनस्वी प्रधावतः प्रेक्ष्य बभाष एतत्।\nपलायितं प्रेक्ष्य बलं च भग्नं भयेन तीव्रेण विहस्य वीरः॥ ६/१०/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.035.m4a", "display_order": 36}, {"id": 6000129036, "chapter_id": 10129, "verse_number": "६-१०-३२", "content_sanskrit": "कालोपपन्नां रुचिरां मनस्वी उवाच वाचं पुरुषप्रवीरः।\nहे विप्रचित्ते नमुचे पुलोमन् मयानर्वन् शम्बर मे शृृणुध्वम्॥ ६/१०/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.036.m4a", "display_order": 37}, {"id": 6000129037, "chapter_id": 10129, "verse_number": "६-१०-३३", "content_sanskrit": "जातस्य मृत्युर्ध्रुव एष सर्वतः प्रतिक्रिया यस्य न चेह कॢप्ता।\nलोको यशश्चाथ ततो यदि ह्यमुं को नाम मृत्युं न वृणीत युक्तम्॥ ६/१०/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.037.m4a", "display_order": 38}, {"id": 6000129038, "chapter_id": 10129, "verse_number": "६-१०-३४", "content_sanskrit": "द्वौ सम्मताविह मृत्यू दुरापौ यद् ब्रह्मसंधारणया जितासुः।\nकलेवरं योगरतो विजह्याद् यदग्रणीर्वीरशयेऽनिवृत्तः॥ ६/१०/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_010/BhP_06.010.038.m4a", "display_order": 39}, {"id": 6000129039, "chapter_id": 10129, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां षष्ठस्कन्धे दशमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]