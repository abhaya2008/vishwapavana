[{"id": 6000140000, "chapter_id": 10140, "verse_number": null, "content_sanskrit": "अथ द्वितीयाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000140001, "chapter_id": 10140, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.001.m4a", "display_order": 2}, {"id": 6000140002, "chapter_id": 10140, "verse_number": "७-२-१", "content_sanskrit": "भ्रातर्येवं विनिहते हरिणा क्रोडमूर्तिना।\nहिरण्यकशिपू राजन् पर्यतप्यद् रुषा शुचा॥ ७/२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.002.m4a", "display_order": 3, "topics": [{"text": "स्वपुत्रे प्रह्लादे हिरण्यकशिपोर्द्वेषः कथं संजातः? इति युधिष्ठिरपृष्टेन नारदेन तत्कथनारम्भः", "range": "१–१६"}]}, {"id": 6000140003, "chapter_id": 10140, "verse_number": "७-२-२", "content_sanskrit": "आह चेदं रुषा पूर्णः सन्दष्टदशनच्छदः।\nकोपोज्ज्वलाभ्यां चक्षुर्भ्यां निरीक्षन् धूम्रमम्बरम्॥ ७/२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.003.m4a", "display_order": 4}, {"id": 6000140004, "chapter_id": 10140, "verse_number": "७-२-३", "content_sanskrit": "करालदंष्ट्रोग्रदृष्ट्या दुष्प्रेक्ष्यभ्रुकुटीमुखः।\nशूलमुद्यम्य सदसि दानवानिदमब्रवीत्॥ ७/२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.004.m4a", "display_order": 5}, {"id": 6000140005, "chapter_id": 10140, "verse_number": null, "content_sanskrit": "हिरण्यकशिपुरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.005.m4a", "display_order": 6}, {"id": 6000140006, "chapter_id": 10140, "verse_number": "७-२-४", "content_sanskrit": "भो भो दानव दैतेय द्विमूर्धंस्‍त्र्यक्ष शम्बर।\nशतबाहो हयग्रीव नमुचे पाक इल्वल॥ ७/२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.006.m4a", "display_order": 7}, {"id": 6000140007, "chapter_id": 10140, "verse_number": "७-२-५", "content_sanskrit": "विप्रचित्ते मम वचः पुलोमन् शकुनादयः।\nशृृणुताऽनन्तरं सर्वैः क्रियतामाशु मा चिरम्॥ ७/२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.007.m4a", "display_order": 8}, {"id": 6000140008, "chapter_id": 10140, "verse_number": "७-२-६", "content_sanskrit": "सपत्नैर्घातितः क्षुद्रैर्भ्राता मे दयितस्सुहृत्।\nपार्ष्णिग्राहेण हरिणा समेनाप्युपधावनैः॥ ७/२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.008.m4a", "display_order": 9}, {"id": 6000140009, "chapter_id": 10140, "verse_number": "७-२-७", "content_sanskrit": "तस्य त्यक्तस्वभावस्य घृणेर्मायावनौकसः।\nभजन्तं भजमानस्य बालस्येवास्थिरात्मनः॥ ७/२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.009.m4a", "display_order": 10}, {"id": 6000140010, "chapter_id": 10140, "verse_number": "७-२-८", "content_sanskrit": "मच्छूलभिन्नग्रीवस्य भूरिणा रुधिरेण वै।\nयुद्धप्रियं तर्पयिष्ये भ्रातरं मे हतव्यथः॥ ७/२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.010.m4a", "display_order": 11}, {"id": 6000140011, "chapter_id": 10140, "verse_number": "७-२-९", "content_sanskrit": "तस्मिन् कूटेऽहिते नष्टे कृन्तमूले वनस्पतौ।\nविटपा इव शुष्यन्ति विष्णुप्राणा दिवौकसः॥ ७/२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.011.m4a", "display_order": 12}, {"id": 6000140012, "chapter_id": 10140, "verse_number": "७-२-१०", "content_sanskrit": "तावद् यात भुवं यूयं ब्रह्मक्षत्रसमेधिताम्।\nसूदयध्वं तपोयज्ञस्वाध्यायव्रतदानकान्॥ ७/२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.012.m4a", "display_order": 13}, {"id": 6000140013, "chapter_id": 10140, "verse_number": "७-२-११", "content_sanskrit": "विष्णुर्द्विजक्रियामूलो यज्ञो धर्ममयः पुमान्।\nदेवर्षिपितृभूतानां धर्मस्य च परायणम्॥ ७/२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.013.m4a", "display_order": 14}, {"id": 6000140014, "chapter_id": 10140, "verse_number": "७-२-१२", "content_sanskrit": "यत्र यत्र द्विजा गावो वेदा वर्णाश्रमाः क्रियाः।\nतं तं जनपदं यात सन्दीपयत वृश्च्यत॥ ७/२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.014.m4a", "display_order": 15}, {"id": 6000140015, "chapter_id": 10140, "verse_number": "७-२-१३", "content_sanskrit": "इति ते भर्तृनिर्देशमादाय शिरसाऽऽदृताः।\nतथा प्रजानां कदनं विदधुः कदनप्रियाः॥ ७/२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.015.m4a", "display_order": 16}, {"id": 6000140016, "chapter_id": 10140, "verse_number": "७-२-१४", "content_sanskrit": "पुरग्रामव्रजोद्यानक्षेत्रारामाश्रमाकरान्।\nखेटखर्वटघोषांश्च ददहुः पत्तनानि च॥ ७/२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.016.m4a", "display_order": 17}, {"id": 6000140017, "chapter_id": 10140, "verse_number": "७-२-१५", "content_sanskrit": "केचित् खनित्रैर्बिभिदुः सेतुप्राकारगोपुरान्। आजीव्यांश्चिच्छिदुर्वृक्षान् केचित् परशुपाणयः।\nप्रादहञ्छरणानन्ये प्रजानां ज्वलितोल्मुकैः॥ ७/२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.017.m4a", "display_order": 18}, {"id": 6000140018, "chapter_id": 10140, "verse_number": "७-२-१६", "content_sanskrit": "एवं विप्रकृते लोके दैत्येन्द्रानुचरैर्मुहुः।\nदिवं देवाः परित्यज्य भुवि चेरुरलक्षिताः॥ ७/२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.018.m4a", "display_order": 19}, {"id": 6000140019, "chapter_id": 10140, "verse_number": "७-२-१७", "content_sanskrit": "हिरण्यकशिपुर्भ्रातुः सम्परेतस्य दुःखितः।\nकृत्वा कटोदकादीनि भ्रातृपुत्रानसान्त्वयत्॥ ७/२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.019.m4a", "display_order": 20, "topics": [{"text": "श्रीवराहकृतहिरण्याक्षवधतप्तेन हिरण्यकशिपुना स्वभ्रातृभार्यायाः स्वमातुर्दितेश्च उशीनरेश्वरदृष्टान्तकथनेन परिसान्त्वनम्", "range": "१६–२६"}]}, {"id": 6000140020, "chapter_id": 10140, "verse_number": "७-२-१८", "content_sanskrit": "शकुनिं शम्बरं धृष्टं भूतसन्तापनं वृकम्।\nकालनेमिं महानाभं हरिश्मश्रुमथोत्कलम्॥ ७/२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.020.m4a", "display_order": 21}, {"id": 6000140021, "chapter_id": 10140, "verse_number": "७-२-१९", "content_sanskrit": "तन्मातरं रुशद्भानुं दितिं च जननीं गिरा।\nश्लक्ष्णया देशकालज्ञ इदमाह जनेश्वर॥ ७/२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.021.m4a", "display_order": 22}, {"id": 6000140022, "chapter_id": 10140, "verse_number": null, "content_sanskrit": "हिरण्यकशिपुरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.022.m4a", "display_order": 23}, {"id": 6000140023, "chapter_id": 10140, "verse_number": "७-२-२०", "content_sanskrit": "अम्बाम्ब हे वधूः पुत्रा वीरं माऽर्हथ शोचितुम्।\nरिपोरभिमुखे श्लाघ्यः शूराणां वध ईप्सितः॥ ७/२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.023.m4a", "display_order": 24}, {"id": 6000140024, "chapter_id": 10140, "verse_number": "७-२-२१", "content_sanskrit": "भूतानामिह संवासः प्रपायामिव सुव्रते।\nदैवेनैकत्र नीतानामुन्नीतानां तथाऽध्रुवः॥ ७/२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.024.m4a", "display_order": 25}, {"id": 6000140025, "chapter_id": 10140, "verse_number": "७-२-२२", "content_sanskrit": "नित्य आत्माऽव्ययः शुद्धः सर्ववित् सर्वगः परः।\nधत्तेऽसावात्मनो लिङ्गं मायया विसृजन् गुणान्॥ ७/२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.025.m4a", "display_order": 26}, {"id": 6000140026, "chapter_id": 10140, "verse_number": "७-२-२३", "content_sanskrit": "यथाऽम्भसा प्रचलता तरवोऽपि चला इव।\nचक्षुषा भ्राम्यमाणेन दृश्यते भ्रमतीव भूः॥ ७/२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.026.m4a", "display_order": 27}, {"id": 6000140027, "chapter_id": 10140, "verse_number": "७-२-२४", "content_sanskrit": "एवं गुणैर्भ्राम्यमाणे मनस्यविकलः पुमान्।\nयाति तत्साम्यतां भद्रे ह्यलिङ्गो लिङ्गवानिव॥ ७/२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.027.m4a", "display_order": 28}, {"id": 6000140028, "chapter_id": 10140, "verse_number": "७-२-२५", "content_sanskrit": "एष आत्मविपर्यासो ह्यलिङ्गे लिङ्गभावना।\nएवं प्रियाप्रियैर्योगो वियोगः कर्मसंसृतिः॥ ७/२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.028.m4a", "display_order": 29}, {"id": 6000140029, "chapter_id": 10140, "verse_number": "७-२-२६", "content_sanskrit": "सम्भवश्च विनाशश्च शोकश्च विविधः स्मृतः।\nअविवेकश्च चिन्ता च विवेकस्मृतिरेव च॥ ७/२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.029.m4a", "display_order": 30}, {"id": 6000140030, "chapter_id": 10140, "verse_number": "७-२-२७", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nयमस्य प्रेतबन्धूनां संवादं तं निबोधत॥ ७/२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.030.m4a", "display_order": 31, "topics": [{"text": "मृतम् उशीनरराजं सुयज्ञमुद्दिश्य विषीदतां प्रेतबन्धूनां यमस्य च संवादः", "range": "२७–३५"}]}, {"id": 6000140031, "chapter_id": 10140, "verse_number": "७-२-२८", "content_sanskrit": "उशीनरेष्वभूद् राजा सुयज्ञ इति विश्रुतः।\nसपत्नैर्निहतो युद्धे ज्ञातयस्तमुपासत॥ ७/२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.031.m4a", "display_order": 32}, {"id": 6000140032, "chapter_id": 10140, "verse_number": "७-२-२९", "content_sanskrit": "विशीर्णरत्नकवचं विभ्रष्टाभरणस्रजम्।\nशरनिर्भिन्नहृदयं शयानमसृगाविलम्॥ ७/२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.032.m4a", "display_order": 33}, {"id": 6000140033, "chapter_id": 10140, "verse_number": "७-२-३०", "content_sanskrit": "विकीर्णकेशं स्तब्धाक्षं संरम्भाद् दष्टदच्छदम्।\nरजःकुण्ठमुखाम्भोजं छिन्नायुधभुजं मृधे॥ ७/२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.033.m4a", "display_order": 34}, {"id": 6000140034, "chapter_id": 10140, "verse_number": "७-२-३१", "content_sanskrit": "उशीनरेन्द्रं विधिना तथाकृतं पतिं महिष्यः प्रसमीक्ष्य दुःखिताः।\nहताः स्म नाथेति करैरुरो भृशं घ्नन्त्यो मुहुस्तत्पदयोरुपापतन्॥ ७/२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.034.m4a", "display_order": 35}, {"id": 6000140035, "chapter_id": 10140, "verse_number": "७-२-३२", "content_sanskrit": "रुदन्त्य उच्चैर्दयिताङ्घ्रिपङ्कजं सिञ्जन्त्य अस्तैः कुचकुङ्कुमारुणैः।\nविस्रस्तकेशाभरणाः शुचं नृणां सृजन्त्य आक्रन्दनया विलेपिरे॥ ७/२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.035.m4a", "display_order": 36}, {"id": 6000140036, "chapter_id": 10140, "verse_number": "७-२-३३", "content_sanskrit": "अहो विधात्राऽकरुणेन नः प्रभो भवान् प्रणीतो धिगगोचरं दृशाम्।\nउशीनराणामपि वृत्तिदः पुरा कृतोऽधुना येन शुचां विवर्धनः॥ ७/२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.036.m4a", "display_order": 37}, {"id": 6000140037, "chapter_id": 10140, "verse_number": "७-२-३४", "content_sanskrit": "त्वया कृतज्ञेन वयं महीपते कथं विना स्याम सुहृत्तमेन।\nतत्रानुयानं तव वीर पादयोः शुश्रूषतीनां दिश यत्र यास्यसि॥ ७/२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.037.m4a", "display_order": 38}, {"id": 6000140038, "chapter_id": 10140, "verse_number": "७-२-३५", "content_sanskrit": "एवं विलपतीनां वै परिगृह्य मृतं पतिम्।\nअनिच्छतीनां निर्हारमर्कोऽस्तं सन्न्यवर्तत॥ ७/२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.038.m4a", "display_order": 39}, {"id": 6000140039, "chapter_id": 10140, "verse_number": "७-२-३६", "content_sanskrit": "तत्र ह प्रेतबन्धूनामाश्रुत्य परिदेवनम्।\nआह तान् बालको भूत्वा यमः स्वयमुपागतः॥ ७/२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.039.m4a", "display_order": 40, "topics": [{"text": "यमेन तान्प्रति लुब्धककुलिङ्गमिथुनकथाकथनम्", "range": "३५–६१"}]}, {"id": 6000140040, "chapter_id": 10140, "verse_number": null, "content_sanskrit": "यम उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.040.m4a", "display_order": 41}, {"id": 6000140041, "chapter_id": 10140, "verse_number": "७-२-३७", "content_sanskrit": "अहो अमीषां वयसाऽधिकानां विपश्यतां लोकविधिं विमोहः।\nयत्रोद्भवस्तत्र गतं मनुष्यं स्वयं सधर्मा अनुशोचन्त्यपार्थम्॥ ७/२/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.041.m4a", "display_order": 42}, {"id": 6000140042, "chapter_id": 10140, "verse_number": "७-२-३८", "content_sanskrit": "अहो वयं धन्यतमा यदत्र त्यक्ताः पितृभ्यां न विचिन्तयामः।\nअभक्ष्यमाणा अबला वृकादिभिः स रक्षिता रक्षति यो हि गर्भे॥ ७/२/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.042.m4a", "display_order": 43}, {"id": 6000140043, "chapter_id": 10140, "verse_number": "७-२-३९", "content_sanskrit": "य इच्छयेशः सृजतीदमव्ययो य एव रक्षत्यवलुम्पते यः।\nतस्याबलाः क्रीडनमाहुरीशितुश्चराचरं निग्रहसङ्ग्रहे प्रभोः॥ ७/२/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.043.m4a", "display_order": 44}, {"id": 6000140044, "chapter_id": 10140, "verse_number": "७-२-४०", "content_sanskrit": "पथि च्युतं तिष्ठति दिष्टरक्षितं गृहे स्थितं तद्विहतं विनश्यति।\nजीवत्यनाथोऽपि तदीक्षितो वने गृहेऽपि गुप्तोऽस्य हतो न जीवति॥ ७/२/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.044.m4a", "display_order": 45}, {"id": 6000140045, "chapter_id": 10140, "verse_number": "७-२-४१", "content_sanskrit": "भूतानि तैस्तैर्निजयोनिकर्मभिर्भवन्ति काले न भवन्ति सर्वशः। ‌\nन तत्र हात्मा प्रकृतावपि स्थितस्तस्या गुणैरन्यतमो निबध्यते॥ ७/२/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.045.m4a", "display_order": 46}, {"id": 6000140046, "chapter_id": 10140, "verse_number": "७-२-४२", "content_sanskrit": "इदं शरीरं पुरुषस्य मोहजं यथा पृथग् भौतिकमीयते गृहम्।\nतथोदकैः पार्थिवतैजसैर्जनः कालेन जातो विकृतो विनश्यति॥ ७/२/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.046.m4a", "display_order": 47}, {"id": 6000140047, "chapter_id": 10140, "verse_number": "७-२-४३", "content_sanskrit": "यथाऽनलो दारुषु भिन्न ईयते यथाऽनिलो देहगतः पृथक् स्थितः।\nयथा नभः सर्वगतं न सज्जते तथा गुणैः सर्वगुणाश्रयः परः॥ ७/२/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.047.m4a", "display_order": 48}, {"id": 6000140048, "chapter_id": 10140, "verse_number": "७-२-४४", "content_sanskrit": "सुयज्ञो नन्वयं शेते मूढा यमनुशोचथ।\nयः श्रोता योऽनुवक्तेह न स दृश्येत कर्हिचित्॥ ७/२/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.048.m4a", "display_order": 49}, {"id": 6000140049, "chapter_id": 10140, "verse_number": "७-२-४५", "content_sanskrit": "न श्रोता नानुवक्ताऽयं मुख्योऽप्यत्र महानसुः।\nयस्त्विहेन्द्रियवानात्मा स चान्यः प्राणदेहयोः॥ ७/२/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.049.m4a", "display_order": 50}, {"id": 6000140050, "chapter_id": 10140, "verse_number": "७-२-४६", "content_sanskrit": "भूतेन्द्रियमनोलिङ्गान् देहानुच्चावचान् विभुः।\nभजत्युत्सृजति ह्यन्यस्तच्चापि स्वेन तेजसा॥ ७/२/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.050.m4a", "display_order": 51}, {"id": 6000140051, "chapter_id": 10140, "verse_number": "७-२-४७", "content_sanskrit": "यावल्लिङ्गान्वितो ह्यात्मा तावत् कर्मनिबन्धनः।\nततो विपर्ययः क्लेशो मायायोगोऽनुवर्तते॥ ७/२/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.051.m4a", "display_order": 52}, {"id": 6000140052, "chapter_id": 10140, "verse_number": "७-२-४८", "content_sanskrit": "वितथाभिनिवेशोऽयं यद्गुणेष्वर्थदृग्वचः।\nयथा मनोरथः स्वप्नः सर्वमैन्द्रियकं मृषा॥ ७/२/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.052.m4a", "display_order": 53}, {"id": 6000140053, "chapter_id": 10140, "verse_number": "७-२-४९", "content_sanskrit": "अथ नित्यमनित्यं वा नेह शोचन्ति तद्विदः।\nनान्यथा शक्यते कर्तुं स्वभावः शोचतामिति॥ ७/२/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.053.m4a", "display_order": 54}, {"id": 6000140054, "chapter_id": 10140, "verse_number": "७-२-५०", "content_sanskrit": "लुब्धको विपिने कश्चित् पक्षिणां निर्मितोऽन्तकः।\nवितत्य जालं विदधे तत्र तत्र प्रलोभनम्॥ ७/२/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.054.m4a", "display_order": 55}, {"id": 6000140055, "chapter_id": 10140, "verse_number": "७-२-५१", "content_sanskrit": "कुलिङ्गमिथुनं तत्र विचरत् समदृश्यत।\nतयोः कुलिङ्गी सहसा लुब्धकेन प्रलोभिता॥ ७/२/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.055.m4a", "display_order": 56}, {"id": 6000140056, "chapter_id": 10140, "verse_number": "७-२-५२", "content_sanskrit": "साऽसज्जत सिचा तन्त्या महिषी कालयन्त्रिता।\nकुलिङ्गस्तां तथाऽपन्नां निरीक्ष्य भृशदुःखितः॥ ७/२/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.056.m4a", "display_order": 57}, {"id": 6000140057, "chapter_id": 10140, "verse_number": "७-२-५३", "content_sanskrit": "स्नेहादकल्पः कृपणां पर्यदेवयदातुरः।\nअहो अकरुणो देवः स्‍त्रिया कृपणया विभुः॥ ७/२/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.057.m4a", "display_order": 58}, {"id": 6000140058, "chapter_id": 10140, "verse_number": "७-२-५४", "content_sanskrit": "कृपणं माऽनुशोचन्त्या दीनया किं करिष्यति।\nकामं नयतु मां देवः किमर्द्धेनात्मनो हि मे॥ ७/२/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.058.m4a", "display_order": 59}, {"id": 6000140059, "chapter_id": 10140, "verse_number": "७-२-५५", "content_sanskrit": "दीनेन जीवता दुःखं मन्देन विधुरायुषा। कथं त्वजातपक्षांस्तान् मातृहीनान् बिभर्म्यहम्।\nमन्दभाग्या प्रतीक्षन्ते नीडे मे मातरं प्रजाः॥ ७/२/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.059.m4a", "display_order": 60}, {"id": 6000140060, "chapter_id": 10140, "verse_number": "७-२-५६", "content_sanskrit": "एवं कुलिङ्गं विरुवन्तमारात् प्रियावियोगातुरमश्रुकण्ठम्।\nतदैव तं शाकुनिकः शरेण विव्याध कालप्रहितो निलीनः॥ ७/२/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.060.m4a", "display_order": 61}, {"id": 6000140061, "chapter_id": 10140, "verse_number": "७-२-५७", "content_sanskrit": "एवं यूयमपश्यन्त्य आत्मापायमबुद्धयः।\nनैनं प्राप्स्यथ शोचन्त्यः पतिं वर्षशतैरपि॥ ७/२/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.061.m4a", "display_order": 62}, {"id": 6000140062, "chapter_id": 10140, "verse_number": null, "content_sanskrit": "हिरण्यकशिपुरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.062.m4a", "display_order": 63}, {"id": 6000140063, "chapter_id": 10140, "verse_number": "७-२-५८", "content_sanskrit": "बाल एवं प्रवदति सर्वे विस्मितचेतसः।\nज्ञातयो मेनिरे सर्वमनित्यमयथोत्थितम्॥ ७/२/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.063.m4a", "display_order": 64}, {"id": 6000140064, "chapter_id": 10140, "verse_number": "७-२-५९", "content_sanskrit": "यम एतदुपाख्याय तत्रैवान्तरधीयत। ज्ञातयोऽपि सुयज्ञस्य चक्रुर्यत् साम्परायिकम्।\nततः शोचत मा यूयं परं चात्मानमेव च॥ ७/२/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.064.m4a", "display_order": 65}, {"id": 6000140065, "chapter_id": 10140, "verse_number": "७-२-६०", "content_sanskrit": "क आत्मा कः परो वाऽत्र स्वीयः पारक्य एव च।\nस्वपराभिनिवेशेन विनाऽज्ञानेन देहिनः॥ ७/२/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.065.m4a", "display_order": 66}, {"id": 6000140066, "chapter_id": 10140, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.066.m4a", "display_order": 67}, {"id": 6000140067, "chapter_id": 10140, "verse_number": "७-२-६१", "content_sanskrit": "इति दैत्यपतेर्वाक्यं दितिराकर्ण्य सस्नुषा।\nपुत्रशोकं क्षणात् त्यक्त्वा तत्त्वे चित्तमधारयत्॥ ७/२/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_002/BhP_07.002.067.m4a", "display_order": 68}, {"id": 6000140068, "chapter_id": 10140, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां सप्तमस्कन्धे द्वितीयाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]