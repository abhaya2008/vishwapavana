[{"id": 7005054000, "chapter_id": 25054, "verse_number": "७-१-२३७-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि यादवस्थलमुत्तमम् ।\nयादवा यत्र नष्टा वै षट्पंचाशच्च कोटयः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005054001, "chapter_id": 25054, "verse_number": "७-१-२३७-२", "content_sanskrit": "यत्र वज्रेश्वरो देवो वज्रेणाराधितः सदा ।\nयत्राभूद्दिव्यदृष्टीनामृषीणामाश्रमं कुलम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005054002, "chapter_id": 25054, "verse_number": "७-१-२३७-३", "content_sanskrit": "देव्युवाच ।\nकथं विनष्टा भगवन्नन्धका वृष्णिभिः सह ।\nपश्यतो वासुदेवस्य भोजाश्चैव महारथाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005054003, "chapter_id": 25054, "verse_number": "७-१-२३७-४", "content_sanskrit": "केन शप्तास्तु ते वीरा नष्टा वृष्ण्यन्धकादयः ।\nभोजाश्चैव महादेव विस्तरेण वदस्व मे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005054004, "chapter_id": 25054, "verse_number": "७-१-२३७-५", "content_sanskrit": "ईश्वर उवाच ।\nषट्त्रिंशे च कलौ वर्षे संप्राप्तेऽन्धकवृष्णयः ।\nअन्योन्यं मुशलैस्ते हि निजघ्नुः कालनोदिताः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005054005, "chapter_id": 25054, "verse_number": "७-१-२३७-६", "content_sanskrit": "विश्वामित्रं च कण्वं च नारदं च यशस्विनम् ।\nसारणप्रमुखान्भोजान्ददृशुर्द्वारकां गतान् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005054006, "chapter_id": 25054, "verse_number": "७-१-२३७-७", "content_sanskrit": "ते वै सांबं समानिन्युर्भूषयित्वा स्त्रियं यथा ।\nअब्रुवन्नुपसंगम्य देवदंडनिपीडिताः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005054007, "chapter_id": 25054, "verse_number": "७-१-२३७-८", "content_sanskrit": "इयं स्त्री पुत्रकामस्य बभ्रोरमिततेजसः ।\nऋषयः साधु जानीत किमियं जनयिष्यति ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005054008, "chapter_id": 25054, "verse_number": "७-१-२३७-९", "content_sanskrit": "इत्युक्तास्ते तदा देवि विप्रलंभप्रधर्षिताः ।\nप्रत्यब्रुवंस्तान्मुनयस्तच्छृणुष्व यथातथम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005054009, "chapter_id": 25054, "verse_number": "७-१-२३७-१०", "content_sanskrit": "ऋषय ऊचुः ।\nवृष्ण्यन्धकविनाशाय मुशलं घोरमायसम् ।\nवासुदेवस्य दायादः सांबोऽयं जनयिष्यति ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005054010, "chapter_id": 25054, "verse_number": "७-१-२३७-११", "content_sanskrit": "येन यूयं सुदुर्वृत्ता नृशंसा जातमन्यवः ।\nउच्छेत्तारः कुलं सर्वमृते रामाज्जनार्द्दनात् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005054011, "chapter_id": 25054, "verse_number": "७-१-२३७-१२", "content_sanskrit": "त्यक्त्वा यास्यति वः श्रीमांत्यक्त्वा भूमिं हलायुधः ।\nजरा कृष्णं महाभागं शयानं तु निवेत्स्यति ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005054012, "chapter_id": 25054, "verse_number": "७-१-२३७-१३", "content_sanskrit": "इत्यब्रुवंस्ततो देवि प्रलब्धास्ते दुरात्मभिः ।\nमुनयः क्रोधरक्ताक्षाः समीक्ष्याथ परस्परम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005054013, "chapter_id": 25054, "verse_number": "७-१-२३७-१४", "content_sanskrit": "तथोक्ता मुनयस्ते तु ततः केशवमभ्ययुः ।\nअथावदत्तदा वृष्णीञ्छ्रुत्वैवं मधुसूदनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005054014, "chapter_id": 25054, "verse_number": "७-१-२३७-१५", "content_sanskrit": "अभिज्ञो मतिमांस्तस्य भवितव्यं तथेति तत् ।\nएवमुक्त्वा हृषीकेशः प्रविवेश पुनर्गृहान् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005054015, "chapter_id": 25054, "verse_number": "७-१-२३७-१६", "content_sanskrit": "कृतांतमन्यथाकर्त्तुं नैच्छत्स जगतः प्रभुः ।\nश्वोभूते सततः सांबो मुसलं तदसूत वै ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005054016, "chapter_id": 25054, "verse_number": "७-१-२३७-१७", "content_sanskrit": "येन वृण्ष्यन्धककुले पुरुषा भस्मसात्कृताः ।\nवृष्ण्यन्धकविनाशाय किंकरप्रतिमं महत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005054017, "chapter_id": 25054, "verse_number": "७-१-२३७-१८", "content_sanskrit": "असूत शापजं घोरं तच्च राज्ञे न्यवेदयत् ।\nविषण्णोऽथ ततो राजा सूक्ष्मं चूर्णमकारयत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005054018, "chapter_id": 25054, "verse_number": "७-१-२३७-१९", "content_sanskrit": "प्राक्षिपत्सागरे तत्र पुरुषो राजशासितः ।\nअथोवाच स्वनगरे वचनादाहुकस्य हि ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005054019, "chapter_id": 25054, "verse_number": "७-१-२३७-२०", "content_sanskrit": "जनार्द्दनस्य रामस्य बभ्रोश्चैव महात्मनः ।\nअद्यप्रभृति सर्वेषां वृष्णन्धकगृहेष्विह ।\nसुरासवो न कर्त्तव्यः सर्वैर्विषयवासिभिः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005054020, "chapter_id": 25054, "verse_number": "७-१-२३७-२१", "content_sanskrit": "यश्च वो विदितं कुर्यादेवं कश्चित्क्वचिन्नरः ।\nस जीवञ्छूलमारोहेत्स्वयं कृत्वा सबांधवः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005054021, "chapter_id": 25054, "verse_number": "७-१-२३७-२२", "content_sanskrit": "ततो राजभयात्सर्वे नियमं तत्र चक्रिरे ।\nनराः शासनमाज्ञाय रामस्याक्लिष्टकर्मणः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005054022, "chapter_id": 25054, "verse_number": "७-१-२३७-२३", "content_sanskrit": "एवं प्रयतमानानां वृष्णीनामन्धकैः सह ।\nकालो गृहाणि सर्वाणि परिचक्राम नित्यशः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005054023, "chapter_id": 25054, "verse_number": "७-१-२३७-२४", "content_sanskrit": "करालो विकटो मुंडः पुरुषः कृष्णपिंगलः ।\nसम्मार्जनी महाकेतुर्जपापुष्पावतंसकः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005054024, "chapter_id": 25054, "verse_number": "७-१-२३७-२५", "content_sanskrit": "कृकलासवाहनश्च रत्तिकाकर्णभूषणः ।\nगृहाण्यवेक्ष्य वृष्णीनां नादृश्यत पुनः क्वचित् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005054025, "chapter_id": 25054, "verse_number": "७-१-२३७-२६", "content_sanskrit": "तस्य चासन्महेष्वासाः शरैः शतसहस्रशः ।\nन चाशक्यत वेद्धुं स सर्वभूताप्ययं सदा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005054026, "chapter_id": 25054, "verse_number": "७-१-२३७-२७", "content_sanskrit": "उत्पेदिरे महावाता दारुणा हि दिने दिने ।\nवृष्ण्यन्धकविनाशाय बहवो लोमहर्षणाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005054027, "chapter_id": 25054, "verse_number": "७-१-२३७-२८", "content_sanskrit": "विवृद्ध्य मूषिका रथ्यावितुन्नमणिकास्तथा ।\nकेशान्ददंशुः सुप्तानां नृणां युवतयो निशि ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005054028, "chapter_id": 25054, "verse_number": "७-१-२३७-२९", "content_sanskrit": "चीचीकूचीत्यवाशंत सारिका वृष्णिवेश्मसु ।\nनोपशाम्यति शब्दश्च स दिवारात्रमेव वा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005054029, "chapter_id": 25054, "verse_number": "७-१-२३७-३०", "content_sanskrit": "अन्वकुर्वन्नुलूकाश्च वायसान्वृष्णिवेश्मसु ।\nअजाः शिवानां च रुतमन्वकुर्वत भामिनि ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005054030, "chapter_id": 25054, "verse_number": "७-१-२३७-३१", "content_sanskrit": "पांडुरारक्तपादाश्च विहगाः कालप्रेरिताः ।\nवृष्ण्यन्धकगृहेष्वेवं कपोता व्यचरंस्तदा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005054031, "chapter_id": 25054, "verse_number": "७-१-२३७-३२", "content_sanskrit": "व्यजायंत खरा गोषु करभाश्चाश्वतरीषु च ।\nशुनीष्वपि बिडालाश्च मूषका नकुलीषु च ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005054032, "chapter_id": 25054, "verse_number": "७-१-२३७-३३", "content_sanskrit": "तापत्रयांत पापानि कुर्वंतो वृष्णयस्तथा ।\nअद्विषन्ब्राह्मणांश्चापि पितॄन्देवांस्तथैव च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005054033, "chapter_id": 25054, "verse_number": "७-१-२३७-३४", "content_sanskrit": "गुरूंश्चाप्यवमन्यंते न तु रामजनार्दनौ ।\nभार्याः पतीन्व्युच्चरंति पत्नीश्च पुरुषास्तथा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005054034, "chapter_id": 25054, "verse_number": "७-१-२३७-३५", "content_sanskrit": "विभावसुः प्रज्वलितो वामं विपरिवर्त्तते ।\nनीललोहितमांजिष्ठा विसृजंश्चार्चिषः पृथक् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005054035, "chapter_id": 25054, "verse_number": "७-१-२३७-३६", "content_sanskrit": "उदयास्तमने नित्यं पर्यस्तः स्याद्दिवाकरः ।\nव्यदृश्यत सकृत्पुंभिः कबन्धैः परिवारितः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005054036, "chapter_id": 25054, "verse_number": "७-१-२३७-३७", "content_sanskrit": "महानसेषु सिद्धांते संस्कृतेऽन्ने तु भामिनि ।\nउत्तार्यमाणे कृमयो दृश्यंते च वरानने ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005054037, "chapter_id": 25054, "verse_number": "७-१-२३७-३८", "content_sanskrit": "पुण्याहे वाच्यमाने च पठत्सु च महात्मसु ।\nअभिधावंति श्रूयंते न चादृश्यत कश्चन ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005054038, "chapter_id": 25054, "verse_number": "७-१-२३७-३९", "content_sanskrit": "परस्परस्य नक्षत्रं हन्यमानं पुनःपुनः ।\nग्रहैरपश्यन्सर्वैस्ते नात्मनस्तु कथञ्चन ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005054039, "chapter_id": 25054, "verse_number": "७-१-२३७-४०", "content_sanskrit": "न हुतं पाचयत्यग्निर्वृष्ण्यंधकपुरस्कृतम् ।\nसमंतात्प्रत्यवाशंत रासभा दारुणस्वनाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005054040, "chapter_id": 25054, "verse_number": "७-१-२३७-४१", "content_sanskrit": "एवं पश्यन्हृषीकेशः संप्राप्तान्कालपर्ययान् ।\nत्रयोदशीं ह्यमावास्यां तां दृष्ट्वा प्राब्रवीदिदम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005054041, "chapter_id": 25054, "verse_number": "७-१-२३७-४२", "content_sanskrit": "त्रयोदशी पंचदशी कृतेयं राहुणा पुनः ।\nतदा च भारते युद्धे प्राप्ता चाद्य क्षयाय नः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005054042, "chapter_id": 25054, "verse_number": "७-१-२३७-४३", "content_sanskrit": "धिग्धिगित्येवकालं तं परिचिंत्य जनार्दनः ।\nमेने प्राप्तं स षट्त्रिंशं वर्षं केशिनिषूदनः ।\nपुत्रशोकाभिसंतप्ता गांधारी यदुवाच ह ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005054043, "chapter_id": 25054, "verse_number": "७-१-२३७-४४", "content_sanskrit": "एवं पश्यन्हृषीकेशस्तदिदं समुपस्थितम् ।\nइदं च समनुप्राप्तमब्रवीद्यद्युधिष्ठिरः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005054044, "chapter_id": 25054, "verse_number": "७-१-२३७-४५", "content_sanskrit": "पुरा व्यूढेष्वनीकेषु दृष्ट्वोत्पातान्सुदारुणान् ।\nपुण्यग्रन्थस्य श्रवणाच्छांतिहोमाद्विशोधनात् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005054045, "chapter_id": 25054, "verse_number": "७-१-२३७-४६", "content_sanskrit": "पूततीर्थाभिषेकांच्च नान्यच्छ्रेयो भवेदिति ।\nइत्युक्त्वा वासुदेवस्तच्चिकीर्षन्सत्यमेव च ।\nआज्ञापयामास तदा तीर्थयात्रामरिंदमः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005054046, "chapter_id": 25054, "verse_number": "७-१-२३७-४७", "content_sanskrit": "अघोषयंत पुरुषास्तत्र केशवशासनात् ।\nतीर्थयात्रा प्रभासे वै कार्येति वरवर्णिनि ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005054047, "chapter_id": 25054, "verse_number": "७-१-२३७-४८", "content_sanskrit": "अथारिष्टानि वक्ष्यामि पुरीं द्वारवतीं प्रति ।\nकाली स्त्री पांडुरैर्दंतैः प्रविश्य नगरीं निशि ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005054048, "chapter_id": 25054, "verse_number": "७-१-२३७-४९", "content_sanskrit": "स्त्रियः स्वप्नेषु मुष्णन्ती द्वारकां प्रति धावति ।\nअग्निहोत्रनिकेतं च सुमेध्येषु च वेश्मसु ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005054049, "chapter_id": 25054, "verse_number": "७-१-२३७-५०", "content_sanskrit": "वृष्ण्यंधकांश्च खादंती स्वप्ने दृष्टा भयानका ।\nकुर्वंती भीषणं नादं कुर्कुटश्वानसंयुता ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005054050, "chapter_id": 25054, "verse_number": "७-१-२३७-५१", "content_sanskrit": "तथा सहस्रशो रौद्राश्चतुर्बाहव एव च ।\nस्त्रीणां गर्भेष्वजायंत राक्षसा गुह्यकास्तथा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005054051, "chapter_id": 25054, "verse_number": "७-१-२३७-५२", "content_sanskrit": "अलंकाराश्च च्छत्राणि ध्वजाश्च कवचानि च ।\nह्रियमाणानि दृश्यंते रक्षोभिस्तु भयानकैः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005054052, "chapter_id": 25054, "verse_number": "७-१-२३७-५३", "content_sanskrit": "यच्चाग्निदत्तं कृष्णस्य वज्रनाभमयस्मयम् ।\nदिवमाचक्रमे चक्रं वृष्णीनां पश्यतां तदा ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005054053, "chapter_id": 25054, "verse_number": "७-१-२३७-५४", "content_sanskrit": "युक्तं रथं दिव्यमादित्यवर्णं भयावहं पश्यतो दारुकस्य ।\nते सागरस्योपरिष्टाद्वर्तमानान्मनोजवांश्चतुरो वाजिमुख्यान् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005054054, "chapter_id": 25054, "verse_number": "७-१-२३७-५५", "content_sanskrit": "तालः सुपर्णश्च महाध्वजौ तौ सुपूजितौ रामजनार्दनाभ्याम् ।\nउच्चैर्जगुः स्वप्सरसो दिवानिशं वाचं चोचुर्गम्यतां तीर्थयात्राम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005054055, "chapter_id": 25054, "verse_number": "७-१-२३७-५६", "content_sanskrit": "ततो जिगमिषंतस्ते वृष्ण्यंधकमहारथाः ।\nसांतःपुरास्तीर्थयात्रामीहंते स्म नरर्षभाः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005054056, "chapter_id": 25054, "verse_number": "७-१-२३७-५७", "content_sanskrit": "ततो मांसपरा हृष्टाः पेयं वेश्मसु वृष्णयः ।\nबहु नानाविधं चक्रुर्मांसानि विविधानि च ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005054057, "chapter_id": 25054, "verse_number": "७-१-२३७-५८", "content_sanskrit": "तथा सीधुषु बद्धेषु निर्ययुर्नगराद्बहिः ।\nयानैरश्वैर्गजैश्चैव श्रीमंतस्तिग्मतेजसः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005054058, "chapter_id": 25054, "verse_number": "७-१-२३७-५९", "content_sanskrit": "ततः प्रभासे न्यवसन्यथोद्देशं यथागृहम् ।\nप्रभूतभक्ष्यपेयास्ते सदारा यादवास्तदा ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7005054059, "chapter_id": 25054, "verse_number": "७-१-२३७-६०", "content_sanskrit": "निर्विष्टांस्तान्निशम्याथ समुद्रांते स योगवित् ।\nजगामामंत्र्य तान्वीरानुद्धवोर्थविशारदः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7005054060, "chapter_id": 25054, "verse_number": "७-१-२३७-६१", "content_sanskrit": "प्रस्थितं तं महात्मानमभिवाद्य कृतांजलिम् ।\nजानन्विनाशं भोजानां नैच्छद्वारयितुं हरिः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7005054061, "chapter_id": 25054, "verse_number": "७-१-२३७-६२", "content_sanskrit": "ततः कालपरीतास्ते वृष्ण्यंधकमहारथाः ।\nअपश्यन्नुद्धवं यांतं तेजसाऽदीप्य रोदसी ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7005054062, "chapter_id": 25054, "verse_number": "७-१-२३७-६३", "content_sanskrit": "ब्राह्मणार्थेषु यत्क्लृप्तमन्नं तेषां वरानने ।\nतद्वाहनेभ्यः प्रददुः सुरागंधरसान्वितम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7005054063, "chapter_id": 25054, "verse_number": "७-१-२३७-६४", "content_sanskrit": "ततस्तूर्यशताकीर्णं नटनर्त्तकसंकुलम् ।\nप्रावर्त्तत महापानं प्रभासे तिग्मतेजसाम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7005054064, "chapter_id": 25054, "verse_number": "७-१-२३७-६५", "content_sanskrit": "कृष्णस्य संनिधौ रामः सहितः कृतवर्मणा ।\nअपिबद्युयुधानश्च गदो बभ्रुस्तथैव च ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7005054065, "chapter_id": 25054, "verse_number": "७-१-२३७-६६", "content_sanskrit": "ततः परिषदो मध्ये युयुधानो मदोत्कटः ।\nअब्रवीत्कृतवर्माणमवहस्यावमन्य च ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7005054066, "chapter_id": 25054, "verse_number": "७-१-२३७-६७", "content_sanskrit": "कः क्षत्रियो मन्यमानः सुप्तान्हन्यान्मृतानिव ।\nन तन्मृष्यत हार्दिक्यस्त्वया तत्साधु यत्कृतम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7005054067, "chapter_id": 25054, "verse_number": "७-१-२३७-६८", "content_sanskrit": "इत्युक्ते युयुधानेन पूजयामास तद्वचः ।\nप्रद्युम्नो रथिनां श्रेष्ठो हार्दिक्यमथ भर्त्सयन् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7005054068, "chapter_id": 25054, "verse_number": "७-१-२३७-६९", "content_sanskrit": "ततः पुनरपि क्रुद्धः कृतवर्मा तमब्रवीत् ।\nनिर्विशन्निव सावज्ञं तदा सव्येन पाणिना ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7005054069, "chapter_id": 25054, "verse_number": "७-१-२३७-७०", "content_sanskrit": "भूरिश्रवाश्छिन्नबाहुर्युद्धे प्रायोगतस्त्वया ।\nव्याधेनेव नृशंसेन कथं वैरेण घातितः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7005054070, "chapter_id": 25054, "verse_number": "७-१-२३७-७१", "content_sanskrit": "इति तस्य वचः श्रुत्वा केशवः परवीरहा ।\nतिर्यक्सरोषया दृष्ट्या वीक्षांचक्रे समः पुमान् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7005054071, "chapter_id": 25054, "verse_number": "७-१-२३७-७२", "content_sanskrit": "मणिं स्यमंतकं चैव यः स सत्राजितोऽभवत् ।\nस कथं स्मारयामास सात्यकिर्मधुसूदनम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7005054072, "chapter_id": 25054, "verse_number": "७-१-२३७-७३", "content_sanskrit": "तच्छ्रुत्वा केशवस्यांकमगमद्रुदती सती ।\nसत्यभामा प्रक्षुभिता कोपयन्ती जनार्द्दनम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7005054073, "chapter_id": 25054, "verse_number": "७-१-२३७-७४", "content_sanskrit": "तत उत्थाय स क्रोधात्सात्यकिर्वाक्यमब्रवीत् ।\nपंचानां द्रौपदेयानां धृष्टद्युम्नशिखंडिनः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7005054074, "chapter_id": 25054, "verse_number": "७-१-२३७-७५", "content_sanskrit": "एष गच्छामि पदवीं सत्ये तव पथे सदा ।\nसौप्तिके निहता ये च सुप्तास्तेन दुरात्मना ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7005054075, "chapter_id": 25054, "verse_number": "७-१-२३७-७६", "content_sanskrit": "द्रोणपुत्रसहायेन पापेन कृतवर्मणा ।\nसमाप्तं चायुरस्याद्य यशश्चापि सुमध्यमे ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7005054076, "chapter_id": 25054, "verse_number": "७-१-२३७-७७", "content_sanskrit": "इतीदमुक्त्वा खङ्गेन केशवस्य समीपतः ।\nअभिहत्य शिरः क्रुद्धश्चिच्छेद कृतवर्मणः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7005054077, "chapter_id": 25054, "verse_number": "७-१-२३७-७८", "content_sanskrit": "तथान्यानपि निघ्नंतं युयुधानं समंततः ।\nअन्वधावद्धृषीकेशो विनिवारयिषुस्तथा ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7005054078, "chapter_id": 25054, "verse_number": "७-१-२३७-७९", "content_sanskrit": "एकीभूतास्ततस्तस्य कालपर्यायप्रेरिताः ।\nभोजांधका महाराजं शैनेयं पर्यवारयन् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7005054079, "chapter_id": 25054, "verse_number": "७-१-२३७-८०", "content_sanskrit": "तान्दृष्ट्वाऽपततस्तूर्णमभिक्रुद्धाञ्जनार्द्दनः ।\nन चुक्रोध महातेजा जानन्कालस्य पर्ययम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7005054080, "chapter_id": 25054, "verse_number": "७-१-२३७-८१", "content_sanskrit": "ते च पानमदाविष्टाश्चोदिताश्चैव मन्युना ।\nयुयुधानमथाजघ्नुरुच्छिष्टै र्भोजनैस्तथा ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7005054081, "chapter_id": 25054, "verse_number": "७-१-२३७-८२", "content_sanskrit": "हन्यमाने तु शैनेये कुद्धो रुक्मिणिनंदनः ।\nतदंतरमथाधावन्मोक्षयिष्यञ्छिनेः सुतम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7005054082, "chapter_id": 25054, "verse_number": "७-१-२३७-८३", "content_sanskrit": "स भोजैः सह संयुक्तः सात्यकिश्चांधकैः सह ।\nबहुत्वात्तु हतौ वीरावुभौ कृष्णस्य पश्यतः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7005054083, "chapter_id": 25054, "verse_number": "७-१-२३७-८४", "content_sanskrit": "हतं दृष्ट्वा तु शैनेयं पुत्रं च यदुनंदनः ।\nएरकाणां तदा मुष्टिं कोपाज्जग्राह केशवः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7005054084, "chapter_id": 25054, "verse_number": "७-१-२३७-८५", "content_sanskrit": "तदभून्मुशलं घोरं वज्रकल्पमयस्मयम् ।\nजघान तेन कृष्णोपि ये तस्य प्रमुखे स्थिताः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7005054085, "chapter_id": 25054, "verse_number": "७-१-२३७-८६", "content_sanskrit": "ततोंऽधकाश्च भोजाश्च शिनयो वृष्णयस्तदा ।\nन्यघ्नन्नन्योन्यमाक्रन्दैर्मुशलैः कालप्रेरिताः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7005054086, "chapter_id": 25054, "verse_number": "७-१-२३७-८७", "content_sanskrit": "यश्चैकामेरकां कश्चिज्जग्राह रुषितो नरः ।\nवज्रभूता च सा देवि ह्यदृश्यत तदा प्रिये ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7005054087, "chapter_id": 25054, "verse_number": "७-१-२३७-८८", "content_sanskrit": "तृणं च मुशलीभूतमण्वपि तत्र दृश्यते ।\nब्रह्मदंडकृतं सर्वमिति तद्विद्धि भामिनि ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7005054088, "chapter_id": 25054, "verse_number": "७-१-२३७-८९", "content_sanskrit": "आविध्याविध्य देवेशि प्रहरंति स्म सायकान् ।\nतद्वज्रभूतं मुशलमपश्यंत तदा दृढम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7005054089, "chapter_id": 25054, "verse_number": "७-१-२३७-९०", "content_sanskrit": "अवधीत्पितरं पुत्रः पिता पुत्रं च भामिनि ।\nमत्तास्ते पर्यटंति स्म योधमानाः परस्परम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7005054090, "chapter_id": 25054, "verse_number": "७-१-२३७-९१", "content_sanskrit": "पतंगा इव चाग्नौ तु न्यपतन्यदुपुंगवाः ।\nनासीत्पलायने बुद्धिर्वध्यमानस्य कस्यचित् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7005054091, "chapter_id": 25054, "verse_number": "७-१-२३७-९२", "content_sanskrit": "तं तु पश्यन्महाबाहुर्जानन्कालस्यपर्ययम् ।\nमुशलं समवष्टभ्य तस्थौ स मधुसूदनः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7005054092, "chapter_id": 25054, "verse_number": "७-१-२३७-९३", "content_sanskrit": "सांबं च निहतं दृष्ट्वा चारुदेष्णं च माधवः ।\nप्रद्युम्नमनिरुद्धं च ततश्चुक्रोध भामिनि ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7005054093, "chapter_id": 25054, "verse_number": "७-१-२३७-९४", "content_sanskrit": "यादवान्क्ष्माशयानांश्च भृशं कोपसमन्वितः ।\nस निःशेषं तदा चक्रे शार्ङ्गचक्रगदाधरः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7005054094, "chapter_id": 25054, "verse_number": "७-१-२३७-९५", "content_sanskrit": "एवं तत्र महादेवि अभवद्यादव स्थलम् ।\nगव्यूतिमात्रं तद्देवि यादवानां चिताः स्मृताः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7005054095, "chapter_id": 25054, "verse_number": "७-१-२३७-९६", "content_sanskrit": "तेषां किलास्थिनिचयैः स्थलरूपं बभूव तत् ।\nभस्मपुंजनिभाकारं तेनाभूद्यादव स्थलम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7005054096, "chapter_id": 25054, "verse_number": "७-१-२३७-९७", "content_sanskrit": "दिव्यरत्नसमायुक्तं मणिमाणिक्यपूरितम् ।\nयादवानां किरीटैश्च दिव्यगन्धैः सुपूरितम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7005054097, "chapter_id": 25054, "verse_number": "७-१-२३७-९८", "content_sanskrit": "तेषां रक्षानिमित्तं हि गंगा गणपतिस्तथा ।\nयादवानां तु सर्वेषां जीवितो वज्र एव हि ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7005054098, "chapter_id": 25054, "verse_number": "७-१-२३७-९९", "content_sanskrit": "वयसोंते ततः सोऽपि प्रभासं क्षेत्रमागतः ।\nनिषिच्य स्वसुतं राज्ये नाम्ना ख्यातं महद्बलम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7005054099, "chapter_id": 25054, "verse_number": "७-१-२३७-१००", "content_sanskrit": "तेनापि स्थापितं लिंगं यादवेन्द्रेण धीमता ।\nवज्रेश्वरमिति ख्यातं तत्स्थितं यादवस्थले ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7005054100, "chapter_id": 25054, "verse_number": "७-१-२३७-१०१", "content_sanskrit": "तत्रैव सुचिरं कालं तपस्तप्तं सुपुष्कलम् ।\nनारदस्योपदेशेन प्रभासे पापनाशने ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7005054101, "chapter_id": 25054, "verse_number": "७-१-२३७-१०२", "content_sanskrit": "प्राप्तवान्परमां सिद्धिं स राजा यादवोत्तमः ।\nतत्रैव यो नरः सम्यक्स्नात्वा जांबवती जले ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7005054102, "chapter_id": 25054, "verse_number": "७-१-२३७-१०३", "content_sanskrit": "वज्रेश्वरं तु संपूज्य ब्राह्मणांस्तत्र भोजयेत् ।\nयादवस्थलसामीप्ये गोसहस्रफलं लभेत् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7005054103, "chapter_id": 25054, "verse_number": "७-१-२३७-१०४", "content_sanskrit": "षट्कोणं तत्र दातव्यमंगुल्या यादवस्थले ।\nयात्राफलमवाप्नोति सम्यक्छ्रद्धासमन्वितः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7005054104, "chapter_id": 25054, "verse_number": "७-१-२३७-१०५", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमेप्रभासक्षेत्रमाहात्म्ये यादवस्थलोत्पत्तौ वज्रेश्वरमाहात्म्यवर्णनंनाम सप्तत्रिंशदुत्तरद्विशततमोऽध्यायः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}]