[{"id": 7001442000, "chapter_id": 21442, "verse_number": "७-१-१५-१", "content_sanskrit": "वायुरुवाच ।\nयदा पुनः प्रजाः सृष्टा न व्यवर्धन्त वेधसः ।\nतदा मैथुनजां सृष्टिं ब्रह्मा कर्तुममन्यत॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001442001, "chapter_id": 21442, "verse_number": "७-१-१५-२", "content_sanskrit": "न निर्गतं पुरा यस्मान्नारीणां कुलमीश्वरात् ।\nतेन मैथुनजां सृष्टिं न शशाक पितामहः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001442002, "chapter_id": 21442, "verse_number": "७-१-१५-३", "content_sanskrit": "ततस्स विदधे बुद्धिमर्थनिश्चयगामिनीम् ।\nप्रजानमेव वृद्ध्यर्थं प्रष्टव्यः परमेश्वर॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001442003, "chapter_id": 21442, "verse_number": "७-१-१५-४", "content_sanskrit": "प्रसादेन विना तस्य न वर्धेरन्निमाः प्रजाः ।\nएवं संचिन्त्य विश्वात्मा तपः कर्तुं प्रचक्रमे॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001442004, "chapter_id": 21442, "verse_number": "७-१-१५-५", "content_sanskrit": "तदाद्या परमा शक्तिरनंता लोकभाविनी ।\nआद्या सूक्ष्मतरा शुद्धा भावगम्या मनोहरा॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001442005, "chapter_id": 21442, "verse_number": "७-१-१५-६", "content_sanskrit": "निर्गुणा निष्प्रपञ्चा च निष्कला निरुपप्लवा ।\nनिरंतरतरा नित्या नित्यमीश्वरपार्श्वगा॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001442006, "chapter_id": 21442, "verse_number": "७-१-१५-७", "content_sanskrit": "तया परमया शक्त्या भगवंतं त्रियम्बकम् ।\nसंचिन्त्य हृदये ब्रह्मा तताप परमं तपः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001442007, "chapter_id": 21442, "verse_number": "७-१-१५-८", "content_sanskrit": "तीव्रेण तपसा तस्य युक्तस्य परमेष्ठिनः ।\nअचिरेणैव कालेन पिता संप्रतुतोष ह॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001442008, "chapter_id": 21442, "verse_number": "७-१-१५-९", "content_sanskrit": "ततः केनचिदंशेन मूर्तिमाविश्य कामपि ।\nअर्धनारीश्वरो भूत्वा ययौ देवस्स्वयं हरः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001442009, "chapter_id": 21442, "verse_number": "७-१-१५-१०", "content_sanskrit": "तं दृष्ट्वा परमं देवं तमसः परमव्ययम् ।\nअद्वितीयमनिर्देश्यमदृश्यमकृतात्मभिः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001442010, "chapter_id": 21442, "verse_number": "७-१-१५-११", "content_sanskrit": "सर्वलोकविधातारं सर्वलोकेश्वरेश्वरम् ।\nसर्वलोकविधायिन्या शक्त्या परमया युतम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001442011, "chapter_id": 21442, "verse_number": "७-१-१५-१२", "content_sanskrit": "अप्रतर्क्यमनाभासममेयमजरं ध्रुवम् ।\nअचलं निर्गुणं शांतमनंतमहिमास्पदम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001442012, "chapter_id": 21442, "verse_number": "७-१-१५-१३", "content_sanskrit": "सर्वगं सर्वदं सर्वसदसद्व्यक्तिवर्जितम् ।\nसर्वोपमाननिर्मुक्तं शरण्यं शाश्वतं शिवम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001442013, "chapter_id": 21442, "verse_number": "७-१-१५-१४", "content_sanskrit": "प्रणम्य दंडवद्ब्रह्मा समुत्थाय कृतांजलिः ।\nश्रद्धाविनयसंपन्नैः श्राव्यैः संस्करसंयुतैः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001442014, "chapter_id": 21442, "verse_number": "७-१-१५-१५", "content_sanskrit": "यथार्थयुक्तसर्वार्थैर्वेदार्थपरिबृंहितैः ।\nतुष्टाव देवं देवीं च सूक्तैः सूक्ष्मार्थगोचरैः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001442015, "chapter_id": 21442, "verse_number": "७-१-१५-१६", "content_sanskrit": "ब्रह्मोवाच ।\nजय देव महादेव जयेश्वर महेश्वर ।\nजय सर्वगुण श्रेष्ठ जय सर्वसुराधिप॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001442016, "chapter_id": 21442, "verse_number": "७-१-१५-१७", "content_sanskrit": "जय प्रकृति कल्याणि जय प्रकृतिनायिके ।\nजय प्रकृतिदूरे त्वं जय प्रकृतिसुन्दरि॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001442017, "chapter_id": 21442, "verse_number": "७-१-१५-१८", "content_sanskrit": "जयामोघमहामाय जयामोघ मनोरथ ।\nजयामोघमहालील जयामोघमहाबल॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001442018, "chapter_id": 21442, "verse_number": "७-१-१५-१९", "content_sanskrit": "जय विश्वजगन्मातर्जय विश्वजगन्मये ।\nजय विश्वजगद्धात्रि जय विश्वजगत्सखि॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001442019, "chapter_id": 21442, "verse_number": "७-१-१५-२०", "content_sanskrit": "जय शाश्वतिकैश्वर्ये जय शाश्वतिकालय ।\nजय शाश्वतिकाकार जय शाश्वतिकानुग॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001442020, "chapter_id": 21442, "verse_number": "७-१-१५-२१", "content_sanskrit": "जयात्मत्रयनिर्मात्रि जयात्मत्रयपालिनि ।\nजयात्मत्रयसंहर्त्रि जयात्मत्रयनायिके॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001442021, "chapter_id": 21442, "verse_number": "७-१-१५-२२", "content_sanskrit": "जयावलोकनायत्तजगत्कारणबृंहण ।\nजयोपेक्षाकटाक्षोत्थहुतभुग्भुक्तभौतिक॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001442022, "chapter_id": 21442, "verse_number": "७-१-१५-२३", "content_sanskrit": "जय देवाद्यविज्ञेये स्वात्मसूक्ष्मदृशोज्ज्वले ।\nजय स्थूलात्मशक्त्येशेजय व्याप्तचराचरे॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001442023, "chapter_id": 21442, "verse_number": "७-१-१५-२४", "content_sanskrit": "जय नामैकविन्यस्तविश्वतत्त्वसमुच्चय ।\nजयासुरशिरोनिष्ठश्रेष्ठानुगकदंबक॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001442024, "chapter_id": 21442, "verse_number": "७-१-१५-२५", "content_sanskrit": "जयोपाश्रितसंरक्षासंविधानपटीयसि ।\nजयोन्मूलितसंसारविषवृक्षांकुरोद्गमे॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001442025, "chapter_id": 21442, "verse_number": "७-१-१५-२६", "content_sanskrit": "जय प्रादेशिकैश्वर्यवीर्यशौर्यविजृंभण ।\nजय विश्वबहिर्भूत निरस्तपरवैभव॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001442026, "chapter_id": 21442, "verse_number": "७-१-१५-२७", "content_sanskrit": "जय प्रणीतपञ्चार्थप्रयोगपरमामृत ।\nजय पञ्चार्थविज्ञानसुधास्तोत्रस्वरूपिणि॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001442027, "chapter_id": 21442, "verse_number": "७-१-१५-२८", "content_sanskrit": "जयति घोरसंसारमहारोगभिषग्वर ।\nजयानादिमलाज्ञानतमःपटलचंद्रिके॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001442028, "chapter_id": 21442, "verse_number": "७-१-१५-२९", "content_sanskrit": "जय त्रिपुरकालाग्ने जय त्रिपुरभैरवि ।\nजय त्रिगुणनिर्मुक्ते जय त्रिगुणमर्दिनि॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001442029, "chapter_id": 21442, "verse_number": "७-१-१५-३०", "content_sanskrit": "जय प्रथमसर्वज्ञ जय सर्वप्रबोधिक ।\nजय प्रचुरदिव्यांग जय प्रार्थितदायिनि॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001442030, "chapter_id": 21442, "verse_number": "७-१-१५-३१", "content_sanskrit": "क्व देव ते परं धाम क्व च तुच्छं च नो वचः ।\nतथापि भगवन् भक्त्या प्रलपंतं क्षमस्व माम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001442031, "chapter_id": 21442, "verse_number": "७-१-१५-३२", "content_sanskrit": "विज्ञाप्यैवंविधैः सूक्तैर्विश्वकर्मा चतुर्मुखः ।\nनमश्चकार रुद्राय रद्राण्यै च मुहुर्मुहुः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001442032, "chapter_id": 21442, "verse_number": "७-१-१५-३३", "content_sanskrit": "इदं स्तोत्रवरं पुण्यं ब्रह्मणा समुदीरितम् ।\nअर्धनारीश्वरं नाम शिवयोर्हर्षवर्धनम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001442033, "chapter_id": 21442, "verse_number": "७-१-१५-३४", "content_sanskrit": "य इदं कीर्तयेद्भक्त्या यस्य कस्यापि शिक्षया ।\nस तत्फलमवाप्नोति शिवयोः प्रीतिकारणात्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001442034, "chapter_id": 21442, "verse_number": "७-१-१५-३५", "content_sanskrit": "सकलभुवनभूतभावनाभ्यां जननविनाशविहीनविग्रहाभ्याम् ।\nनरवरयुवतीवपुर्धराभ्यां सततमहं प्रणतोस्मि शंकराभ्याम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]