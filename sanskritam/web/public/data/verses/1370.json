[{"id": 2017835, "chapter_id": 1370, "verse_number": "३-७-०x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2017836, "chapter_id": 1370, "verse_number": "३-७-१", "content_sanskrit": "धतराष्ट्र महाप्राज्ञ निबोध वचनं मम।\nवक्ष्यामि त्वां कौरवाणां सर्वेषां हितमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2017837, "chapter_id": 1370, "verse_number": "३-७-२", "content_sanskrit": "न मे प्रियं महाबाहो यद्गताः पाण्डवा वनम्।\nनिकृत्त्या निकृताश्चैव दुर्योधनपुरोगमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2017838, "chapter_id": 1370, "verse_number": "३-७-३", "content_sanskrit": "ते स्मरन्तः परिक्लेशान्वर्षे पूर्णे त्रयोदशे।\nविमोक्ष्यन्ति विषं क्रुद्धाः कौरवेयेषु भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2017839, "chapter_id": 1370, "verse_number": "३-७-४", "content_sanskrit": "तदयं किंनु पापात्मा तव पुत्रः सुमन्दधीः।\nपाण्डवान्नित्यसंक्रुद्धो राज्यहेतोर्जिघांसति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2017840, "chapter_id": 1370, "verse_number": "३-७-५", "content_sanskrit": "वार्यतां साध्वयं मूढः शमं गच्छतु ते सुतः।\nवनस्थांस्तानयं हन्तुमिच्छन्प्राणान्विमोक्ष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2017841, "chapter_id": 1370, "verse_number": "३-७-६", "content_sanskrit": "यथाऽऽह विदुरः प्राज्ञो यथा भीष्मो यथा वयम्।\nयथा कृपश्च द्रोणश्च तथा साधु विधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2017842, "chapter_id": 1370, "verse_number": "३-७-७", "content_sanskrit": "विग्रहो हि महाप्राज्ञ स्वजनेन विगर्हितः।\nअधर्म्यमयशस्यं च मा राजन्प्रतिपद्यथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2017843, "chapter_id": 1370, "verse_number": "३-७-८", "content_sanskrit": "समीक्षा यादृशी ह्मस्य पाण्डवान्प्रति भारत।\nउपेक्ष्यमाणा सा राजन्महान्तमनयं व्रजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2017844, "chapter_id": 1370, "verse_number": "३-७-९", "content_sanskrit": "अथवाऽयं सुमन्दात्मा वनं गच्छतु ते सुतः।\nपाण्डवैः सहितो राजन्नेक एवासहायवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2017845, "chapter_id": 1370, "verse_number": "३-७-१०", "content_sanskrit": "ततः संसर्गजः स्नेहः पुत्रस्य तव पाण्डवैः।\nयदि स्यात्कृतकृत्यस्त्वं भवेथाः पुरषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2017846, "chapter_id": 1370, "verse_number": "३-७-११", "content_sanskrit": "अथवा जायमानस्य यच्छीलमनुजायते।\nश्रूयते तन्महाराज नामृतस्यापसर्पति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2017847, "chapter_id": 1370, "verse_number": "३-७-१२", "content_sanskrit": "कथं वा मन्यते भीष्मो द्रोणोऽथ विदुरोपिवा।\nभवान्वाऽत्र परं कार्यं पुरा चार्थो निवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2017848, "chapter_id": 1370, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि किर्मीरवधपर्वणि अष्टमोऽध्यायः ॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]