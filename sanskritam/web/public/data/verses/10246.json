[{"id": 6000246000, "chapter_id": 10246, "verse_number": null, "content_sanskrit": "अथ पञ्चाशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "श्रीकृष्णरामाभ्यां रात्र्यामालोच्य सूर्योदयसमये सैन्येन सह प्रसुप्तमागधसैन्ये प्रवेशः", "range": null}]}, {"id": 6000246001, "chapter_id": 10246, "verse_number": null, "content_sanskrit": "श्रीबादरायणिरुवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.001.m4a", "display_order": 2}, {"id": 6000246002, "chapter_id": 10246, "verse_number": "१०-५०-१", "content_sanskrit": "तृतीये मासि भूयश्च राजा बार्हद्रथो बली।\nदिवानिशं तप्यमानः स्मरन् पूर्वपराभवम्॥ १०/५०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.002.m4a", "display_order": 3, "topics": [{"text": "जीवन्गच्छेति बलरामविसृष्टस्य जरासन्धस्य पूर्वापेक्षयाप्यधिकसैन्यमेलनेन श्रीकृष्णेन सह युद्धायागत्य सायं यमुनातटेऽवस्थानम्", "range": "१–१४"}]}, {"id": 6000246003, "chapter_id": 10246, "verse_number": "१०-५०-२", "content_sanskrit": "आहूय सर्वान् भूपालान् चकार कदनोद्यमम्।\nस मत्स्यान् मालवांश्चेदीन् कुरुपाञ्चालकेरलान्॥ १०/५०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.003.m4a", "display_order": 4}, {"id": 6000246004, "chapter_id": 10246, "verse_number": "१०-५०-३", "content_sanskrit": "कुलिन्दकुन्तलावन्तिकाशिगान्धारसृञ्जयान्।\nकलिङ्गकेकयानान्ध्रान् दशार्णान् वङ्गसैन्धवान्॥ १०/५०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.004.m4a", "display_order": 5}, {"id": 6000246005, "chapter_id": 10246, "verse_number": "१०-५०-४", "content_sanskrit": "माद्रान् त्रिगर्तान् सौवीरान् पार्वतेयांश्च सर्वशः।\nआहूयाक्षौहिणिगणैस्‍त्रयोविंशतिभिर्युतः॥ १०/५०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.005.m4a", "display_order": 6}, {"id": 6000246006, "chapter_id": 10246, "verse_number": "१०-५०-५", "content_sanskrit": "स मागधानतिक्रम्य पश्चिमाभिमुखो ययौ।\nआकर्षन्निव भूपालान् गजाश्वरथवल्लभान्॥ १०/५०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.006.m4a", "display_order": 7}, {"id": 6000246007, "chapter_id": 10246, "verse_number": "१०-५०-६", "content_sanskrit": "आगत्य मधुरां रोद्धुं प्राविशद् यमुनातटे।\nस्कन्धावारेण महता राजभिर्बहुभिर्युतः॥ १०/५०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.007.m4a", "display_order": 8}, {"id": 6000246008, "chapter_id": 10246, "verse_number": "१०-५०-७", "content_sanskrit": "उपगीयमानो न्यरमत् सूतमागधबन्दिभिः।\nतदाकर्ण्य रणोद्योगं मागधस्य बलीयसः॥ १०/५०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.008.m4a", "display_order": 9}, {"id": 6000246009, "chapter_id": 10246, "verse_number": "१०-५०-८", "content_sanskrit": "मन्त्रयामास शर्वर्यां कृष्णः सङ्कर्षणादिभिः।\nवसुदेवोद्धवाक्रूरशैनेयाहुकसारणैः॥ १०/५०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.009.m4a", "display_order": 10}, {"id": 6000246010, "chapter_id": 10246, "verse_number": "१०-५०-९", "content_sanskrit": "पतिरालोच्य शर्वर्यां सम्यङ् निर्धारितक्रियः।\nउषस्यनुदिते सूर्ये समाहूय भटोत्तमान्॥ १०/५०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.010.m4a", "display_order": 11}, {"id": 6000246011, "chapter_id": 10246, "verse_number": "१०-५०-१०", "content_sanskrit": "त्रिधा विभज्य गोविन्दः स्वसेनां चतुरङ्गिणीम्।\nन्ययोजयदमेयात्मा मगधेन्द्रबलं प्रति॥ १०/५०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.011.m4a", "display_order": 12}, {"id": 6000246012, "chapter_id": 10246, "verse_number": "१०-५०-११", "content_sanskrit": "सङ्कर्षणं च हार्दिक्यं गदं सारणमेव च।\nवामेन प्रेषयामास मार्गेण मधुसूदनः॥ १०/५०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.012.m4a", "display_order": 13}, {"id": 6000246013, "chapter_id": 10246, "verse_number": "१०-५०-१२", "content_sanskrit": "सात्यकिं विपृथुं चैव पृथुमुद्धवमेव च।\nदक्षिणेनैव मार्गेण प्राहिणोत् सेनया सह॥ १०/५०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.013.m4a", "display_order": 14}, {"id": 6000246014, "chapter_id": 10246, "verse_number": "१०-५०-१३", "content_sanskrit": "स्वयं कतिपयैर्युक्तो रथैः कमललोचनः।\nअग्रे मगधराजस्य प्रविवेश महद्बलम्॥ १०/५०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.014.m4a", "display_order": 15}, {"id": 6000246015, "chapter_id": 10246, "verse_number": "१०-५०-१४", "content_sanskrit": "सा सेना बहुनागाश्वरथपादातिसङ्कुला।\nप्रसुप्ता यमुनातीरे विस्रब्धा रमते सुखम्॥ १०/५०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.015.m4a", "display_order": 16}, {"id": 6000246016, "chapter_id": 10246, "verse_number": "१०-५०-१५", "content_sanskrit": "उदयाद्रिं समारोहत्यर्के तमसि नश्यति।\nनीडस्थेष्वेव कूजत्सु विहङ्गेषु ततस्ततः॥ १०/५०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.016.m4a", "display_order": 17}, {"id": 6000246017, "chapter_id": 10246, "verse_number": "१०-५०-१६", "content_sanskrit": "विकसत्सु सरोजेषु गायत्स्वलिकुलेषु च।\nप्रविवेश बलं भीमं मगधेन्द्रस्य दुर्जयम्॥ १०/५०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.017.m4a", "display_order": 18}, {"id": 6000246018, "chapter_id": 10246, "verse_number": "१०-५०-१७", "content_sanskrit": "हयाश्चाबद्धवैराणाः श्रेणीबद्धाः समन्ततः।\nकुञ्जराश्च तदा राजन्ननारोपितपञ्जराः॥ १०/५०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.018.m4a", "display_order": 19, "topics": [{"text": "श्रीकृष्णेन बलरामादिभिश्च हन्यमानायाः कर्तव्यमूढाया जरासन्धसेनायाः पलायनम्॥ तैस्तत्र त्यक्तस्य वाहनावरोधहिरण्याभरणादिरूपस्य धनस्य यदुराजाय समर्पणम्", "range": "१७–३३"}]}, {"id": 6000246019, "chapter_id": 10246, "verse_number": "१०-५०-१८", "content_sanskrit": "अनादत्तप्रहरणा भटाश्चाबद्धमूर्धजाः।\nअप्रविष्टात्मवर्माणस्तदा नारूढवाहनाः॥ १०/५०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.019.m4a", "display_order": 20}, {"id": 6000246020, "chapter_id": 10246, "verse_number": "१०-५०-१९", "content_sanskrit": "रथाश्चाबद्धतुरगाः सर्वतोऽनुद्धृतध्वजाः।\nसेनायां मगधेन्द्रस्य प्रवेशे पीतवाससः॥ १०/५०/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.020.m4a", "display_order": 21}, {"id": 6000246021, "chapter_id": 10246, "verse_number": "१०-५०-२०", "content_sanskrit": "त्रिदिक्ष्वापतितं सैन्यं दृष्ट्वा तद्राजमण्डलम्।\nइतिकर्तव्यतामूढं विभ्रान्तं समपद्यत॥ १०/५०/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.021.m4a", "display_order": 22}, {"id": 6000246022, "chapter_id": 10246, "verse_number": "१०-५०-२१", "content_sanskrit": "केचिद्भटाः समापेतुर्भयात् केचिच्च दुद्रुवुः।\nकेचिदात्तप्रहरणास्त्वभिसस्रुररीन् रणे॥ १०/५०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.022.m4a", "display_order": 23}, {"id": 6000246023, "chapter_id": 10246, "verse_number": "१०-५०-२२", "content_sanskrit": "केचिद् विभिन्नवर्माणश्छिन्नपादोरुबाहवः।\nरिपूनेवाभ्यवर्तन्त क्रोधोद्वृत्तारुणेक्षणाः॥ १०/५०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.023.m4a", "display_order": 24}, {"id": 6000246024, "chapter_id": 10246, "verse_number": "१०-५०-२३", "content_sanskrit": "केचिद् हयानपर्याणानारुह्य दृढविक्रमाः।\nमर्दयन्तो रिपून् युद्धे विमलं लेभिरे यशः॥ १०/५०/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.024.m4a", "display_order": 25}, {"id": 6000246025, "chapter_id": 10246, "verse_number": "१०-५०-२४", "content_sanskrit": "राजानः सहसोद्बुद्ध्य दृष्ट्वा सैनिकसङ्क्षयम्।\nविना रणोपस्करणं चक्रुः केचन सङ्गरम्॥ १०/५०/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.025.m4a", "display_order": 26}, {"id": 6000246026, "chapter_id": 10246, "verse_number": "१०-५०-२५", "content_sanskrit": "केचिद् विसृज्य शिबिरं विविशुर्गहनं वनम्।\nकेचिन्मागधमासाद्य विजयस्वेति चाब्रुवन्॥ १०/५०/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.026.m4a", "display_order": 27}, {"id": 6000246027, "chapter_id": 10246, "verse_number": "१०-५०-२६", "content_sanskrit": "रथेनैकेन गोविन्दः प्रविश्य रिपुवाहिनीम्।\nजघान सुबहून् वीरान् सायुधान् सरणोद्यमान्॥ १०/५०/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.027.m4a", "display_order": 28}, {"id": 6000246028, "chapter_id": 10246, "verse_number": "१०-५०-२७", "content_sanskrit": "सङ्कर्षणोऽपि बलवान् महत्या सेनया वृतः।\nबलं प्रविश्य वामेन मर्दयामास मागधम्॥ १०/५०/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.028.m4a", "display_order": 29}, {"id": 6000246029, "chapter_id": 10246, "verse_number": "१०-५०-२८", "content_sanskrit": "शैनेयोऽपि महाबाहुर्दक्षिणेनैव वर्त्मना।\nप्रविश्य चतुरङ्गेण सैन्येन महताऽर्दयत्॥ १०/५०/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.029.m4a", "display_order": 30}, {"id": 6000246030, "chapter_id": 10246, "verse_number": "१०-५०-२९", "content_sanskrit": "एवं सा व्यथिता सेना मगधेन्द्राभिरक्षिता।\nदुद्राव त्रास्यमाना वै क्षणमात्रं दिशो दश॥ १०/५०/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.030.m4a", "display_order": 31}, {"id": 6000246031, "chapter_id": 10246, "verse_number": "१०-५०-३०", "content_sanskrit": "ततोऽनुद्रुत्य वार्ष्णेयः सात्यकिः पञ्चयोजनम्।\nनिहत्य मागधं सैन्यं जयी व्यावर्तताहवात्॥ १०/५०/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.031.m4a", "display_order": 32}, {"id": 6000246032, "chapter_id": 10246, "verse_number": "१०-५०-३१", "content_sanskrit": "मतङ्गजान् पर्वतसन्निभान् बहून् निगृह्य सोपस्करतोमराङ्कुशान्।\nरथांश्च शस्‍त्रध्वजवाजिसंयुतान् निनाय कृष्णो मधुरां मनोरमाम्॥ १०/५०/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.032.m4a", "display_order": 33}, {"id": 6000246033, "chapter_id": 10246, "verse_number": "१०-५०-३२", "content_sanskrit": "छत्राणि हेमाम्बररत्नमिश्रितान्यनेकबालव्यजनानि माधवः।\nकिरीटपट्टाङ्गदकुण्डलांशुकान्यवाप कृष्णोऽगणितानि संयुगे॥ १०/५०/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.033.m4a", "display_order": 34}, {"id": 6000246034, "chapter_id": 10246, "verse_number": "१०-५०-३३", "content_sanskrit": "हलायुधो मागधकोशवाहान् प्रजावरोधायुधभूषणादिकम्।\nनियोजितः कंसभिदा रणार्जितं यदुप्रवीराय धनं न्यवेदयत्॥ १०/५०/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_050/BhP_10.050.034.m4a", "display_order": 35}, {"id": 6000246035, "chapter_id": 10246, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे पञ्चाशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]