[{"id": 2108284, "chapter_id": 3344, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2108285, "chapter_id": 3344, "verse_number": "१", "content_sanskrit": "सुपर्णेनोह्यमानास्ते जग्मुस्तं देशमाशु वै ।\nसागराम्बुपरिक्षिप्तं पक्षिसङ्घनिनादितम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2108286, "chapter_id": 3344, "verse_number": "२", "content_sanskrit": "विचित्रफलपुष्पाभिर्वनराजिभिरावृतम्\nभवनैश्चावृतं दिव्यैस्तथा पद्माकरैरपि\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2108287, "chapter_id": 3344, "verse_number": "३", "content_sanskrit": "प्रसन्नसलिलैश्चापि ह्रदैश्चित्रैर्विभूषितम् ।\nदिव्यगन्धवहैः पुण्यैर्मारुतैरुपवीजितम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2108288, "chapter_id": 3344, "verse_number": "४", "content_sanskrit": "आजिघ्रद्भिरिवाकाशं वृक्षैर्मलयजैरपि ।\nशोभितं पुष्पवर्षाणि मुञ्चद्भिर्मारुतोद्यतैः\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2108289, "chapter_id": 3344, "verse_number": "६", "content_sanskrit": "किरद्भिरिव तत्रस्थान् नागान् पुष्पाम्बुवृष्टिभिः ।\nमनःसंहर्षणं पुण्यं गन्धर्वाप्सरसां प्रियम्\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2108290, "chapter_id": 3344, "verse_number": "७", "content_sanskrit": "नानापक्षिरुतं रम्यं कद्रूपुत्रप्रहर्षणम् ।\nतत्ते वनं समासाद्य विजह्रुः पन्नगा मुदा ।\nअब्रुवंश्च महावीर्यं सुपर्णं पतगोत्तमम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2108291, "chapter_id": 3344, "verse_number": "", "content_sanskrit": "नागाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2108292, "chapter_id": 3344, "verse_number": "८", "content_sanskrit": "वहास्मानपरं द्वीपं सुरम्यं विपुलोदकम् ।\nत्वं हि देशान् बहून् रम्यान् पतन् पश्यसि खेचर\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2108293, "chapter_id": 3344, "verse_number": "९", "content_sanskrit": "स विचिन्त्याब्रवीत् पक्षी मातरं विनतां तदा ।\nकिं कारणं मया मातः कर्तव्यं सर्पभाषितम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2108294, "chapter_id": 3344, "verse_number": "", "content_sanskrit": "विनता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2108295, "chapter_id": 3344, "verse_number": "१०", "content_sanskrit": "दासीभूतास्म्यनार्याया भगिन्याः पतगोत्तम ।\nपणं वितथमास्थाय सर्पैरुपधिना कृतम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2108296, "chapter_id": 3344, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2108297, "chapter_id": 3344, "verse_number": "११", "content_sanskrit": "तस्मिंस्तु कथिते मात्रा कारणे गगनेचरः ।\nउवाच वचनं सर्पांस्तेन दुःखेन दुःखितः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2108298, "chapter_id": 3344, "verse_number": "१२", "content_sanskrit": "किं वाऽऽहृत्य विजित्वा किं किं वा कृत्वेह पौरुषम् ।\nदास्याद् वा विप्रमुच्येयं सत्यं शंसथ लेलिहाः\t ॥ १२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2108299, "chapter_id": 3344, "verse_number": "१३", "content_sanskrit": "श्रुत्वा तमब्रुवन् सर्पा आहरामृतमोजसा ।\nतदा दास्याद् विप्रमोक्षो तव मातुर्भविष्यति \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2108300, "chapter_id": 3344, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2108301, "chapter_id": 3344, "verse_number": "१४", "content_sanskrit": "इत्युक्तो गरुडः सर्पैस्ततो मातरमब्रवीत् ।\nगच्छाम्यमृतमाहर्तुं भक्ष्यमिच्छामि देहि तत् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2108302, "chapter_id": 3344, "verse_number": "", "content_sanskrit": "विनता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2108303, "chapter_id": 3344, "verse_number": "१५", "content_sanskrit": "समुद्रकुक्षावेकान्ते निषादालयमुत्तमम् ।\nसहस्राणामनेकेषां तान् भुक्त्वाऽमृतमाहर \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2108304, "chapter_id": 3344, "verse_number": "१६", "content_sanskrit": "न तु ते ब्राह्मणान् हन्तुं कार्या बुद्धिः कथञ्चन ।\nअवध्यः सर्वभूतानां ब्राह्मणो ह्यनलोपमः\t ॥ १६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2108305, "chapter_id": 3344, "verse_number": "१७", "content_sanskrit": "अग्निरर्को विषं शस्त्रं विप्रो भवति कोपितः ।\nभूतानामग्रभुग् विप्रो वर्णश्रेष्ठस्तथा गुरुः\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2108306, "chapter_id": 3344, "verse_number": "१८", "content_sanskrit": "एवमादिभी रूपैस्तु सद्गुणो ब्राह्मणो वरः ।\nस ते तात न हन्तव्यः सङ्क्रुद्धेनापि सर्वशः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2108307, "chapter_id": 3344, "verse_number": "१९", "content_sanskrit": "ब्राह्मणानामभिद्रोहो न कर्तव्यः कदाचन ।\nनचैवाग्निर्नचादित्यो भस्मीकुर्यात् तथाऽनघ \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2108308, "chapter_id": 3344, "verse_number": "२०", "content_sanskrit": "यथा कुर्यादभिक्रुद्धो ब्राह्मणः संशितव्रतः ।\nतदेतैर्विविधैर्लिङ्गैः संविद्यात् तं द्विजोत्तमम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2108309, "chapter_id": 3344, "verse_number": "", "content_sanskrit": "वैनतेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2108310, "chapter_id": 3344, "verse_number": "२१", "content_sanskrit": "यथाहमनुजानीयां ब्राह्मणं लक्षणैः शुभैः ।\nएतन्मे कारणं मातः पृच्छते वक्तुमर्हसि ।\nकिंरूपो ब्राह्मणो मातः किंशीलः किंपरायणः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2108311, "chapter_id": 3344, "verse_number": "", "content_sanskrit": "विनता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2108312, "chapter_id": 3344, "verse_number": "२२", "content_sanskrit": "यस्ते कण्ठमनुप्राप्तो निगीर्णं बडिशं यथा ।\nदहेदङ्गारवत् पुत्र तं विद्याद् ब्राह्मणर्षभम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2108313, "chapter_id": 3344, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2108314, "chapter_id": 3344, "verse_number": "२३", "content_sanskrit": "प्रोवाच चैनं विनता पुत्रस्नेहादिदं वचः ।\nजानन्त्यप्यतुलं वीर्यमाशीर्वादसमन्वितम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2108315, "chapter_id": 3344, "verse_number": "२४", "content_sanskrit": "पक्षौ ते पातु भगवान् चन्द्रः पृष्ठं तु पुत्रक ।\nशिरस्तु पातु ते वह्निर्मारुतः प्राणमेव च\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2108316, "chapter_id": 3344, "verse_number": "२५", "content_sanskrit": "अहं च ते सदा पुत्र शान्तिस्वस्तिपरायणा ।\nइहासीना भविष्यामि स्वस्तिकारे रता सदा ।\nअरिष्टं व्रज पन्थानं वत्स कार्यार्थसिद्धये \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2108317, "chapter_id": 3344, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2108318, "chapter_id": 3344, "verse_number": "२६", "content_sanskrit": "ततः स मातुर्वचनं निशम्य\nवितत्य पक्षौ नभ उत्पपात ।\nततो निषादान् बलवानुपागमत्\nबुभुक्षितः काल इवान्तको महान् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2108319, "chapter_id": 3344, "verse_number": "२७", "content_sanskrit": "स तान् निषादानुपसंहरंस्तदा\nरजः समुद्धूय नभःस्पृशं मुहुः ।\nसमुद्रकुक्षौ च विशोषयन् पयः\nसमीपगान् भूमिधरान् विचालयन् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2108320, "chapter_id": 3344, "verse_number": "२८", "content_sanskrit": "ततः स चक्रे महदाननं तदा\nनिषादमार्गं प्रतिरुध्य पक्षिराट् ।\nततो निषादास्त्वरितं प्रवव्रजुः\nयतो मुखं तस्य भुजङ्गभोजिनः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2108321, "chapter_id": 3344, "verse_number": "२९", "content_sanskrit": "तदाननं विवृतमतिप्रमाणवत् \tसमभ्ययुर्गगनमिवार्दिताः खगाः ।\nसहस्रशः पवनरयेण मोहिता महानिलप्रचलितपादपे वने \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2108322, "chapter_id": 3344, "verse_number": "३०", "content_sanskrit": "ततः खगो वदनममित्रतापनः\nसमाहरत्परिचपलो महाबलः ।\nनिषूदयन् बहुविधमत्स्यभक्षिणो\nबुभुक्षितो गगनचरेश्वरस्तदा \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2108323, "chapter_id": 3344, "verse_number": "११", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि त्रयोविंशोऽध्यायः ॥२३॥ ॥ आस्तीकपर्वणि एकादशोऽध्यायः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]