[{"id": 2008268, "chapter_id": 1161, "verse_number": "१-१६२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2008269, "chapter_id": 1161, "verse_number": "१-१६२-१", "content_sanskrit": "अथ रात्र्यां व्यतीतायामशेषो नागरो जनः।\nतत्राजगाम त्वरितो दिदृक्षुः पाण्डुनन्दनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2008270, "chapter_id": 1161, "verse_number": "१-१६२-२", "content_sanskrit": "निर्वापयन्तो ज्वलनं ते जना ददृशुस्ततः।\nजातुषं तद्गृहं दग्धममात्यं च पुरोचनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2008271, "chapter_id": 1161, "verse_number": "१-१६२-३", "content_sanskrit": "नूनं दुर्योधनेनेदं विहितं पापकर्मणा।\nपाण्डवानां विनाशायेत्येवं ते चुक्रुशुर्जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2008272, "chapter_id": 1161, "verse_number": "१-१६२-४", "content_sanskrit": "विदिते धृतराष्ट्रस्य धार्तराष्ट्रो न संशयः।\nदग्धवान्पाण्डुदायादान्न ह्येतत्प्रतिषिद्धवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2008273, "chapter_id": 1161, "verse_number": "१-१६२-५", "content_sanskrit": "नूनं शान्तनवोऽपीह न धर्मनुवर्तते।\nद्रोणश्च विदुरश्चैव कृपश्चान्ये च कौरवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2008274, "chapter_id": 1161, "verse_number": "१-१६२-६", "content_sanskrit": "नावेक्षन्ते ह तं धर्मं धर्मात्मानोऽप्यहो विधेः।\nश्रुतवन्तोऽपि विद्वांसो धनवद्वशगा अहो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2008275, "chapter_id": 1161, "verse_number": "१-१६२-७", "content_sanskrit": "साधूननाथान्धर्मिष्ठात्सत्यव्रतपरायणान्।\nनावेक्षन्ते महान्तोऽपि दैवं तेषां परायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2008276, "chapter_id": 1161, "verse_number": "१-१६२-८", "content_sanskrit": "ते वयं धृतराष्ट्राय प्रेषयामो दुरात्मने।\nसंवृत्तस्ते परः कामः पाण्डवान्दग्धवानसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2008277, "chapter_id": 1161, "verse_number": "१-१६२-९", "content_sanskrit": "ततो व्यपोहमानास्ते पाण्डवार्थे हुताशनम्।\nनिषादीं ददृशुर्दग्धां पञ्चपुत्रामनागसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2008278, "chapter_id": 1161, "verse_number": "१-१६२-१०", "content_sanskrit": "इतः पश्यत कुन्तीयं दग्धा शेते तपस्विनी।\nपुत्रैः सहैव वार्ष्णेयी हन्तेत्याहुः स्म नागराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2008279, "chapter_id": 1161, "verse_number": "१-१६२-११", "content_sanskrit": "खनकेन तु तेनैव वेश्म शोधयता बिलम्।\nपांसुभिः पिहितं तच्च पुरुषैस्तैर्न लक्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2008280, "chapter_id": 1161, "verse_number": "१-१६२-१२", "content_sanskrit": "ततस्ते प्रेषयामासुर्धृतराष्ट्राय नागराः।\nपाण्डवानग्निना दग्धानमात्यं च पुरोचनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2008281, "chapter_id": 1161, "verse_number": "१-१६२-१३", "content_sanskrit": "श्रुत्वा तु धृतराष्ट्रस्तद्राजा सुमहदप्रियम्।\nविनाशं पाण्डुपुत्राणां विललाप सुदुःखितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2008282, "chapter_id": 1161, "verse_number": "१-१६२-१४", "content_sanskrit": "अन्तर्हृष्टमनाश्चासौ बहिर्दुःखसमन्वितः।\nअन्तःशीतो बहिश्चोष्णो ग्रीष्मेऽगाधह्वदोयथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2008283, "chapter_id": 1161, "verse_number": "१-१६२-१५x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2008284, "chapter_id": 1161, "verse_number": "१-१६२-१५", "content_sanskrit": "अद्य पाण्डुर्मृतो राजा मम भ्राता महायशाः।\nतेषु वीरेषु दग्धेषु मात्रा सह विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2008285, "chapter_id": 1161, "verse_number": "१-१६२-१६", "content_sanskrit": "गच्छन्तु पुरुषाः शीघ्रं नगरं वारणावतम्।\nसत्कारयन्तु तान्वीरान्कुन्तीं राजसुतां च ताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2008286, "chapter_id": 1161, "verse_number": "१-१६२-१७", "content_sanskrit": "ये च तत्र मृतास्तेषां सुहृदः सन्ति तानपि।\nकारयन्तु च कुल्यानि शुभ्राणि च बृहन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2008287, "chapter_id": 1161, "verse_number": "१-१६२-१८", "content_sanskrit": "मम दग्धा महात्मानः कुलवंशविवर्धनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2008288, "chapter_id": 1161, "verse_number": "१-१६२-१९", "content_sanskrit": "एवं गते मया शक्यं यद्यत्कारयितुं हितम्।\nपाण्डवानां च कुन्त्याश्च तत्सर्वं क्रियतां धनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2008289, "chapter_id": 1161, "verse_number": "१-१६२-२०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2008290, "chapter_id": 1161, "verse_number": "१-१६२-२०", "content_sanskrit": "समेताश्च ततः सर्वे भीष्मेण सह कौरवाः।\nधृतराष्ट्रः सपुत्रश्च गङ्गामभिमुखा ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2008291, "chapter_id": 1161, "verse_number": "१-१६२-२१", "content_sanskrit": "एकवस्त्रा निरानन्दा निराभरणवेष्टनः।\nउदकं कर्तुकामा वै पाण्डवानां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2008292, "chapter_id": 1161, "verse_number": "१-१६२-२२", "content_sanskrit": "एवं गत्वा ततश्चक्रे ज्ञातिभिः परिवारितः।\nउदकं पाण्डुपुत्राणां धृतराष्ट्रोऽम्बिकासुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2008293, "chapter_id": 1161, "verse_number": "१-१६२-२३", "content_sanskrit": "रुरुदुः सहिताः सर्वे भृशं शोकपरायणाः।\nहा युधिष्ठिर कौरव्य हा भीम इति चापरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2008294, "chapter_id": 1161, "verse_number": "१-१६२-२४", "content_sanskrit": "हा फल्गुनेति चाप्यन्ये हा यमाविति चापरे।\nकुन्तीमार्ताश्च शोचन्त उदकं चक्रिरे जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2008295, "chapter_id": 1161, "verse_number": "१-१६२-२५", "content_sanskrit": "अन्ये पौरजनाश्चैवमन्वशोचन्त पाण्डवान्।\nविदुरस्त्वल्पशश्चक्रे शोकं वेद परं हि सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2008296, "chapter_id": 1161, "verse_number": "१-१६२-२६", "content_sanskrit": "विदुरो धृतराष्ट्रस्य जानन्सर्वं मनोगतम्।\nतेनायं विधिना सृष्टः कुटिलः कपटाशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2008297, "chapter_id": 1161, "verse_number": "१-१६२-२७", "content_sanskrit": "इत्येवं चिन्तयन्राजन्विदुरो विदुषां वरः।\nलोकानां दर्शयन्दुःखं दुःखितैः सह बान्धवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2008298, "chapter_id": 1161, "verse_number": "१-१६२-२८", "content_sanskrit": "मनसाऽचिन्तयत्पार्थान्कियद्दूरं गता इति।\nसहिताः पाण्डवाः पुत्रा इति चिन्तापरोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2008299, "chapter_id": 1161, "verse_number": "१-१६२-२९", "content_sanskrit": "ततः प्रव्यथितो भीष्मः पाण्डुराजसुतान्मृतान्।\nसह मात्रेति तच्छ्रुत्वा विललाप रुरोद च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2008300, "chapter_id": 1161, "verse_number": "१-१६२-३०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2008301, "chapter_id": 1161, "verse_number": "१-१६२-३०", "content_sanskrit": "हा युधिष्ठिर हा भीम हा धनञ्जय हा यमौ।\nहा पृथे सह पुत्रैस्त्वमेकरात्रेण स्वर्गता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2008302, "chapter_id": 1161, "verse_number": "१-१६२-३१", "content_sanskrit": "मात्रा सह कुमारास्ते सर्वे तत्रैव संस्थिताः।\nन हि तौ नोत्सहेयातां भीमसेनधनञ्जयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2008303, "chapter_id": 1161, "verse_number": "१-१६२-३२", "content_sanskrit": "तरसा वेगितात्मानौ निर्भेत्तुमपि मन्दरम्।\nपरासुत्वं न पश्यामि पृथायाः सह पाण्डवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2008304, "chapter_id": 1161, "verse_number": "१-१६२-३३", "content_sanskrit": "सर्वथा विकृतं तत्तु यदि ते निधनं गताः।\nधर्मराजः स निर्दिष्टो ननु विप्रैर्युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2008305, "chapter_id": 1161, "verse_number": "१-१६२-३४", "content_sanskrit": "पृथिव्यां च रथिश्रेष्ठो भविता स धनञ्जयः।\nसत्यव्रतो धर्मदत्तः सत्यवाक्छुभलक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2008306, "chapter_id": 1161, "verse_number": "१-१६२-३५", "content_sanskrit": "कथं कालवशं प्राप्तः पाण्डवेयो युधिष्ठिरः।\nआत्मानमुपमां कृत्वा परेषां वर्तते तु यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2008307, "chapter_id": 1161, "verse_number": "१-१६२-३६", "content_sanskrit": "मात्रा सहैव कौरव्यः कथं कालवशं गतः।\nपालितः सुचिरं कालं फलकाले यथा द्रुमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2008308, "chapter_id": 1161, "verse_number": "१-१६२-३७", "content_sanskrit": "भग्नः स्याद्वायुवेगेन तथा राजा युधिष्ठिरः।\nयौवराज्येऽभिषिक्तेन पितुर्येनाहृतं यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2008309, "chapter_id": 1161, "verse_number": "१-१६२-३८", "content_sanskrit": "आत्मनश्च पितुश्चैव सत्यधर्मप्रवृत्तिभिः।\nयच्च सा वनवासेन तन्माता दुःखभागिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2008310, "chapter_id": 1161, "verse_number": "१-१६२-३९", "content_sanskrit": "कालेन सह संमग्नो धिक्कृतान्तमनर्थकम्।\nयच्च सा वनवासेन तन्माता दुःखभागिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2008311, "chapter_id": 1161, "verse_number": "१-१६२-४०", "content_sanskrit": "पुत्रगृध्नुतया कुन्ती न भर्तारं मृतात्वनु।\nअल्पकालं कुले जाता भर्तुः प्रीतिमवाप या॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2008312, "chapter_id": 1161, "verse_number": "१-१६२-४१", "content_sanskrit": "दग्धाऽद्य सह पुत्रैः सा असंपूर्णमनोरा।\nमृतो भीम इति श्रुत्वा मनो न श्रद्दधाति मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2008313, "chapter_id": 1161, "verse_number": "१-१६२-४२", "content_sanskrit": "एतच्च चिन्तयानस्य व्यथितं बहुधा मनः।\nअवधूय च मे देहं हृदयेन विदीर्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2008314, "chapter_id": 1161, "verse_number": "१-१६२-४३", "content_sanskrit": "पीनस्कन्धश्चारुबाहुर्मेरुकूटसमो युवा।\nमृतो भीम इति श्रुत्वा मनो न श्रद्दधाति मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2008315, "chapter_id": 1161, "verse_number": "१-१६२-४४", "content_sanskrit": "अतित्यागी च योधी च क्षिप्रहस्तो दृढायुधः।\nप्रपत्तिमाँल्लब्धलक्षो रथयानविशारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2008316, "chapter_id": 1161, "verse_number": "१-१६२-४५", "content_sanskrit": "दूरपाती त्वसंभ्रान्तो महावीर्यो महास्त्रवान्।\nअदीनात्मा नरश्रेष्ठः श्रेष्ठः सर्वधनुष्मताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2008317, "chapter_id": 1161, "verse_number": "१-१६२-४६", "content_sanskrit": "येन प्राच्याश्च सौवीरा दाक्षिणात्याश्च निर्जिताः।\nख्यापितं येन शूरेण त्रिषु लोकेषु पौरुषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2008318, "chapter_id": 1161, "verse_number": "१-१६२-४७", "content_sanskrit": "यस्मिञ्जाते विशोकाऽभूत्कुन्ती पाण्डुश्च वीर्यवान्।\nपुरन्दरसमो जिष्णुः कथं कालवशं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2008319, "chapter_id": 1161, "verse_number": "१-१६२-४८", "content_sanskrit": "कथं तावृषभष्कन्धौ सिंहविक्रान्तगामिनौ।\nमर्त्यधर्ममनुप्राप्तौ यमावरिनिवर्हणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2008320, "chapter_id": 1161, "verse_number": "१-१६२-४९", "content_sanskrit": "वत्सा गताः क्व मां वृद्धं विहाय भृशमातुरम्।\nहा स्नुषे मम वार्ष्णेयि निधाय हृदि मे शुचम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2008321, "chapter_id": 1161, "verse_number": "१-१६२-५०", "content_sanskrit": "वारणावतयात्रायां के स्युर्वै शकुनाः पथि।\nएवमल्पायुषो लोके भविष्यन्ति पृथासुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2008322, "chapter_id": 1161, "verse_number": "१-१६२-५१", "content_sanskrit": "संशप्ता इति कैर्यूयं वत्सान्दर्शय मे पृथे।\nममैव नाथा मन्नाथा मम नेत्राणि पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2008323, "chapter_id": 1161, "verse_number": "१-१६२-५२", "content_sanskrit": "हा पाण्डवा मे हे वत्सा हा सिंहशिशवो मम।\nमातङ्गा हा ममोत्तुङ्गा हा ममानन्दवर्धनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2008324, "chapter_id": 1161, "verse_number": "१-१६२-५३", "content_sanskrit": "मम हीनस्य युष्माभिः सर्वलोकास्तमोवृताः।\nकदा द्रष्टाऽस्मि कौन्तेयांस्तरुणादित्यवर्चसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2008325, "chapter_id": 1161, "verse_number": "१-१६२-५४", "content_sanskrit": "अदृष्ट्वा वो महाबाहून्पुत्रवन्मम नन्दनाः।\nक्व गतिर्मे क्व गच्छामि कुतो द्रक्ष्यामि मे शिशून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2008326, "chapter_id": 1161, "verse_number": "१-१६२-५५", "content_sanskrit": "हा युधिष्ठिर हा भीम हा हा फल्गुन हा यमौ।\nमा गच्छत निवर्तध्वं मयि कोपं विमुञ्चत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2008327, "chapter_id": 1161, "verse_number": "१-१६२-५६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2008328, "chapter_id": 1161, "verse_number": "१-१६२-५६", "content_sanskrit": "श्रुत्वा तत्क्रन्दितं तस्य तिलोदं च प्रसिञ्चतः।\nदेशं कालं समाज्ञाय विदुरः प्रत्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2008329, "chapter_id": 1161, "verse_number": "१-१६२-५७", "content_sanskrit": "मा शोचीस्त्वं नरव्याघ्र जहि शोकं महाधृते।\nन तेषां विद्यते मृत्युः प्राप्तकालं कृतं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2008330, "chapter_id": 1161, "verse_number": "१-१६२-५८", "content_sanskrit": "एतच्च तेभ्य उदकं विप्रसिञ्च न भारत।\nक्षत्तेदमब्रवीद्भीष्मं कौरवाणामशृण्वताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2008331, "chapter_id": 1161, "verse_number": "१-१६२-५९", "content_sanskrit": "क्षत्तारमुपसंगम्य बाष्पोत्पीडकलस्वरः।\nमन्दंमन्दमुवाचेदं विदुरं संगमे नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2008332, "chapter_id": 1161, "verse_number": "१-१६२-६०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2008333, "chapter_id": 1161, "verse_number": "१-१६२-६०", "content_sanskrit": "कथं ते तात जीवन्ति पाण्डोः पुत्रा महाबलाः।\nकथमस्मत्कृते पक्षः पाण्डोर्न हि निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2008334, "chapter_id": 1161, "verse_number": "१-१६२-६१", "content_sanskrit": "कथं मत्प्रमुखाः सर्वे प्रमुक्ता महतो भयात्।\nजननी गरुडेनेव कुरवस्ते समुद्धृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2008335, "chapter_id": 1161, "verse_number": "१-१६२-६२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2008336, "chapter_id": 1161, "verse_number": "१-१६२-६२", "content_sanskrit": "एवमुक्तस्तु कौरव्य कौरवाणामशृण्वताम्।\nआचचक्षे स धर्मात्मा भीष्मायाद्भुतकर्मणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2008337, "chapter_id": 1161, "verse_number": "१-१६२-६३x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2008338, "chapter_id": 1161, "verse_number": "१-१६२-६३", "content_sanskrit": "धृतराष्ट्रस्य शकुने राज्ञो दुर्योधनस्य च।\nविनाशे पाण्डुपुत्राणां कृतो मतिविनिश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2008339, "chapter_id": 1161, "verse_number": "१-१६२-६४", "content_sanskrit": "तत्राहमपि च ज्ञात्वा तस्य पापस्य निश्चयम्।\nतं जिघांसुरहं चापि तेषामनुमते स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2008340, "chapter_id": 1161, "verse_number": "१-१६२-६५", "content_sanskrit": "ततो जतुगृहं गत्वा दहनेऽस्मिन्नियोजिते।\nपृथायाश्च सपुत्राया धार्तराष्ट्रस्य शासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2008341, "chapter_id": 1161, "verse_number": "१-१६२-६६", "content_sanskrit": "ततः खनकमाहूय सुरङ्गं वै बिलं तदा।\nसुगूढं कारयित्वा ते कुन्त्या पाण्डुसुतास्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2008342, "chapter_id": 1161, "verse_number": "१-१६२-६७", "content_sanskrit": "निष्क्रामिता मया पूर्वं मा स्म शोके मनः कृथाः।\nततस्तु नावमारोप्य सहपुत्रां पृथामहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2008343, "chapter_id": 1161, "verse_number": "१-१६२-६८", "content_sanskrit": "दत्त्वाऽभयं सपुत्रायै कुन्त्यै गृहमदाहयम्।\nतस्मात्ते मा स्म भूद्दुःखं मुक्ताः पापात्तु पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2008344, "chapter_id": 1161, "verse_number": "१-१६२-६९", "content_sanskrit": "निर्गताः पाण्डवा राजन्मात्रा सह परन्तपाः।\nअग्निहादान्महाघोरान्मया तस्मादुपायतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2008345, "chapter_id": 1161, "verse_number": "१-१६२-७०", "content_sanskrit": "मा स्म शोकमिमं कार्षीर्जीवन्त्येव च पाण्डवाः।\nप्रच्छन्ना विचिरिष्यन्ति यावत्कालस्य पर्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2008346, "chapter_id": 1161, "verse_number": "१-१६२-७१", "content_sanskrit": "तस्मिन्युधिष्ठिरं काले द्रक्ष्यन्ति भुवि मानवाः।\nविमलं कृष्णपक्षान्ते जगच्चन्द्रमिवोदितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2008347, "chapter_id": 1161, "verse_number": "१-१६२-७२", "content_sanskrit": "न तस्य नाशं पश्यामि यस्य भ्राता धनञ्जयः।\nभीमसेनश्च दुर्धर्षौ माद्रीपुत्रौ च तौ यमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2008348, "chapter_id": 1161, "verse_number": "१-१६२-७३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2008349, "chapter_id": 1161, "verse_number": "१-१६२-७३", "content_sanskrit": "ततः संहृष्टसर्वाङ्गो भीष्मो विदुरमब्रवीत्।\nदिष्ट्यादिष्ट्येति संहृष्टः पूजयानो महामतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2008350, "chapter_id": 1161, "verse_number": "१-१६२-७४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2008351, "chapter_id": 1161, "verse_number": "१-१६२-७४", "content_sanskrit": "युक्तं चैवानुरूपं च कृतं तात शुभं त्वया।\nवयं विमोक्षिता दुःखात्पाण्डुपक्षो न नाशितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2008352, "chapter_id": 1161, "verse_number": "१-१६२-७५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2008353, "chapter_id": 1161, "verse_number": "१-१६२-७५", "content_sanskrit": "एवमुक्त्वा विवेशाथ पुरं जनशताकुलम्।\nकुरुभिः सहितो राजन्नागरैश्च पितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2008354, "chapter_id": 1161, "verse_number": "१-१६२-७६", "content_sanskrit": "अथाम्बिकेयः सामात्यः सकर्णः सहसौबलः।\nसात्मजः पार्थनाशस्य स्मरंस्तथ्यं जर्ष च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2008355, "chapter_id": 1161, "verse_number": "१-१६२-७७", "content_sanskrit": "भीष्मश्च राजन्दुर्धर्षो विदुरश्च महामतिः।\nजहृषाते स्मरन्तौ तौ जातुषाग्नेर्विमोचनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2008356, "chapter_id": 1161, "verse_number": "१-१६२-७८", "content_sanskrit": "सत्यशीलगुणाचारै रागैर्जानपदोद्भवैः।\nद्रोणादयश्च धर्मैस्तु तेषां तान्मोचितान्विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2008357, "chapter_id": 1161, "verse_number": "१-१६२-७९", "content_sanskrit": "शौर्यलावण्यमाहात्म्यै रूपैः प्राणबलैरपि।\nस्वस्थान्पार्थानमन्यन्त पौरजानपदास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2008358, "chapter_id": 1161, "verse_number": "१-१६२-८०", "content_sanskrit": "अन्ये जनाः प्राकृताश्च स्त्रियश्च बहुलास्तदा।\nशङ्कमाना वदन्ति स्म दग्धा जीवन्ति वा न वा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2008359, "chapter_id": 1161, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि जतुगृहपर्वणि द्विषष्ट्यधिकशततमोऽध्यायः॥ १६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}]