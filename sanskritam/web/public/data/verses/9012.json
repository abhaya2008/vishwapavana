[{"id": 5000012000, "chapter_id": 9012, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे द्वादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000012001, "chapter_id": 9012, "verse_number": "१-१२-१", "content_sanskrit": "ततः काले बहुतिथे कस्मिंश्चित् सुमनोहरे ।\nवसन्ते समनुप्राप्ते राज्ञो यष्टुं मनोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000012002, "chapter_id": 9012, "verse_number": "१-१२-२", "content_sanskrit": "ततः प्रणम्य शिरसा तं विप्रं देववर्णिनम् ।\nयज्ञाय वरयामास संतानार्थं कुलस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000012003, "chapter_id": 9012, "verse_number": "१-१२-३", "content_sanskrit": "तथेति च स राजानमुवाच वसुधाधिपम् ।\nसम्भाराः सम्भ्रियन्तां ते तुरगश्च विमुच्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000012004, "chapter_id": 9012, "verse_number": "१-१२-४", "content_sanskrit": "सरय्वाश्चोत्तरे तीरे यज्ञभूमिर्विधीयताम् ।\nततोऽब्रवीनृपो वाक्यं ब्राह्मणान् वेदपारगान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000012005, "chapter_id": 9012, "verse_number": "१-१२-५", "content_sanskrit": "सुमन्त्रावाहय क्षिप्रमृत्विजो ब्रह्मवादिनः ।\nसुयज्ञं वामदेवं च जाबालिमथ काश्यपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000012006, "chapter_id": 9012, "verse_number": "१-१२-६", "content_sanskrit": "पुरोहितं वसिष्ठं च ये चान्ये द्विजसत्तमाः ।\nततः सुमन्त्रस्त्वरितं गत्वा त्वरितविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000012007, "chapter_id": 9012, "verse_number": "१-१२-७", "content_sanskrit": "समानयत् स तान् सर्वान् समस्तान् वेदपारगान् ।\nतान् पूजयित्वा धर्मात्मा राजा दशरथस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000012008, "chapter_id": 9012, "verse_number": "१-१२-८", "content_sanskrit": "धर्मार्थसहितं युक्तं श्लक्ष्णं वचनमब्रवीत् ।\nमम तातप्यमानस्य पुत्रार्थं नास्ति वै सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000012009, "chapter_id": 9012, "verse_number": "१-१२-९", "content_sanskrit": "पुत्रार्थं हयमेधेन यक्ष्यामीति मतिर्मम ।\nतदहं यष्टुमिच्छामि हयमेधेन कर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000012010, "chapter_id": 9012, "verse_number": "१-१२-१०", "content_sanskrit": "ऋषिपुत्रप्रभावेण कामान् प्राप्स्यामि चाप्यहम् ।\nततः साध्विति तद्वाक्यं ब्राह्मणाः प्रत्यपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000012011, "chapter_id": 9012, "verse_number": "१-१२-११", "content_sanskrit": "वसिष्ठप्रमुखाः सर्वे पार्थिवस्य मुखाच्च्युतम् ।\nऋष्यशृङ्गपुरोगाश्च प्रत्यूचुर्नृपतिं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000012012, "chapter_id": 9012, "verse_number": "१-१२-१२", "content_sanskrit": "सम्भाराः सम्भ्रियन्तां ते तुरगश्च विमुच्यताम् ।\nसरय्वाश्चोत्तरे तीरे यज्ञभूमिर्विधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000012013, "chapter_id": 9012, "verse_number": "१-१२-१३", "content_sanskrit": "सर्वथा प्राप्यसे पुत्रांश्चतुरोऽमितविक्रमान् ।\nयस्य ते धार्मिकी बुद्धिरियं पुत्रार्थमागता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000012014, "chapter_id": 9012, "verse_number": "१-१२-१४", "content_sanskrit": "ततः प्रीतोऽभवद् राजा श्रुत्वा तु द्विजभाषितम् ।\nअमात्यानब्रवीद् राजा हर्षेणेदं शुभाक्षरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000012015, "chapter_id": 9012, "verse_number": "१-१२-१५", "content_sanskrit": "गुरूणां वचनाच्छीघ्रं सम्भाराः सम्भ्रियन्तु मे ।\nसमर्थाधिष्ठितश्चाश्वः सोपाध्यायो विमुच्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000012016, "chapter_id": 9012, "verse_number": "१-१२-१६", "content_sanskrit": "सरय्वाश्चोत्तरे तीरे यज्ञभूमिर्विधीयताम् ।\nशान्तयश्चाभिवर्धन्तां यथाकल्पं यथाविधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000012017, "chapter_id": 9012, "verse_number": "१-१२-१७", "content_sanskrit": "शक्यः कर्तुमयं यज्ञः सर्वेणापि महीक्षिता ।\nनापराधो भवेत् कष्टो यद्यस्मिन् क्रतुसत्तमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000012018, "chapter_id": 9012, "verse_number": "१-१२-१८", "content_sanskrit": "छिद्रं हि मृगयन्त्येते विद्वांसो ब्रह्मराक्षसाः ।\nविधिहीनस्य यज्ञस्य सद्यः कर्ता विनश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000012019, "chapter_id": 9012, "verse_number": "१-१२-१९", "content_sanskrit": "तद् यथा विधिपूर्वं मे क्रतुरेष समाप्यते ।\nतथा विधानं क्रियतां समर्थाः करणेष्विह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000012020, "chapter_id": 9012, "verse_number": "१-१२-२०", "content_sanskrit": "तथेति च ततः सर्वे मन्त्रिणः प्रत्यपूजयन् ।\nपार्थिवेन्द्रस्य तद् वाक्यं यथाज्ञप्तमकुर्वत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000012021, "chapter_id": 9012, "verse_number": "१-१२-२१", "content_sanskrit": "ततो द्विजास्ते धर्मज्ञमस्तुवन् पार्थिवर्षभम् ।\nअनुज्ञातास्ततः सर्वे पुनर्जग्मुर्यथागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000012022, "chapter_id": 9012, "verse_number": "१-१२-२२", "content_sanskrit": "गतेषु तेषु विप्रेषु मन्त्रिणस्तान् नराधिपः ।\nविसर्जयित्वा स्वं वेश्म प्रविवेश महामतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000012023, "chapter_id": 9012, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे द्वादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]