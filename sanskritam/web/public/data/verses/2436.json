[{"id": 2068448, "chapter_id": 2436, "verse_number": "९-५४-०x", "content_sanskrit": "ऋषय ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2068449, "chapter_id": 2436, "verse_number": "९-५४-१", "content_sanskrit": "प्रजापतेरुत्तरवेदिरुच्यते\nसनातनं राम समन्तपञ्चकम्।\nसमीजिरे यत्र पुरा दिवौकसो\nवरेण सत्रेण महावरप्रदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2068450, "chapter_id": 2436, "verse_number": "९-५४-२", "content_sanskrit": "पुरा च राजर्षिवरेण धीमता\nबहूनि वर्षाण्यमितेन तेजसा।\nप्रकृष्टमेतत्कुरुणा महात्मना\nततः कुरुक्षेत्रमितीह पप्रथे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2068451, "chapter_id": 2436, "verse_number": "९-५४-३x", "content_sanskrit": "राम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2068452, "chapter_id": 2436, "verse_number": "९-५४-३", "content_sanskrit": "किमर्थं कुरुणा कृष्टं क्षेत्रमेतन्महात्मना।\nएतदिच्छाम्यहं श्रोतुं कथ्यमानं तपोधनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2068453, "chapter_id": 2436, "verse_number": "९-५४-४x", "content_sanskrit": "ऋषय ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2068454, "chapter_id": 2436, "verse_number": "९-५४-४", "content_sanskrit": "पुरा किल कुरुं राम कर्षन्तं सततोत्थितम्।\nअभ्येत्य शक्रस्त्रिदिवात्पर्यपृच्छत कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2068455, "chapter_id": 2436, "verse_number": "९-५४-५x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2068456, "chapter_id": 2436, "verse_number": "९-५४-५", "content_sanskrit": "किमिदं वर्तते कर्म प्रयत्नेन परेण च।\nराजर्षे किमभिप्रेत्य येनेयं कृष्यते क्षितिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2068457, "chapter_id": 2436, "verse_number": "९-५४-६x", "content_sanskrit": "कुरुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2068458, "chapter_id": 2436, "verse_number": "९-५४-६", "content_sanskrit": "इह ये पुरुषाः क्षेत्रे जनिष्यन्ति शतक्रतो।\nते गमिष्यन्ति सुकृतां लोकान्पापविवर्जितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2068459, "chapter_id": 2436, "verse_number": "९-५४-७", "content_sanskrit": "अपहास्य तु तं शक्रो जगाम त्रिदिवं पुनः।\nराजर्षिरप्यनिर्विण्णः कर्षत्येव वसुन्धराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2068460, "chapter_id": 2436, "verse_number": "९-५४-८", "content_sanskrit": "आगम्यागम्य चैवैनं भूयोभूयोऽपहास्य च।\nशत्रक्रतुरनिर्विण्णं पृष्ट्वापृष्ट्वा जगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2068461, "chapter_id": 2436, "verse_number": "९-५४-९", "content_sanskrit": "यदा तु तपसोग्रेण चकर्ष वसुधां नृपः।\nततः शक्रोऽब्रवीद्देवान्राजर्षेर्यच्चिकीर्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2068462, "chapter_id": 2436, "verse_number": "९-५४-१०", "content_sanskrit": "एतच्छ्रुत्वाऽब्रुवन्देवाः सहस्राक्षमिदं वचः।\nवरेण च्छन्द्यतां शक्र राजर्षिर्यदि शक्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2068463, "chapter_id": 2436, "verse_number": "९-५४-११", "content_sanskrit": "यदि ह्यत्र प्रसूता वै स्वर्गं गच्छन्ति मानवाः।\nअस्माननिष्ट्वा क्रतुभिर्भागो नो न भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2068464, "chapter_id": 2436, "verse_number": "९-५४-१२", "content_sanskrit": "आगम्य च ततः शक्रस्तदा राजर्षिमब्रवीत्।\nअलं खेदेन भवतः क्रियतां वचनं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2068465, "chapter_id": 2436, "verse_number": "९-५४-१३", "content_sanskrit": "मानवा ये निराहारा देहं त्यक्ष्यन्त्यतन्द्रिताः।\nयुधि वा निहताः सम्यगपि तिर्यग्गता नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2068466, "chapter_id": 2436, "verse_number": "९-५४-१४", "content_sanskrit": "ते स्वर्गभाजो राजेन्द्र भवन्त्विह हतास्तु ये।\nतथास्त्विति ततो राजा कुरुः शक्रमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2068467, "chapter_id": 2436, "verse_number": "९-५४-१५", "content_sanskrit": "ततस्तमभ्यनुज्ञाप्य प्रहृष्टेनान्तरात्मना।\nजगाम त्रिदिवं भूयः क्षिप्रं बलनिषूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2068468, "chapter_id": 2436, "verse_number": "९-५४-१६", "content_sanskrit": "एवमेतद्यदुश्रेष्ठ कृष्टं राजर्षिणा पुरा।\nशक्रेण चाभ्यनुज्ञातः पुण्ये प्राणान्मुमोच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2068469, "chapter_id": 2436, "verse_number": "९-५४-१७", "content_sanskrit": "[शक्रेण चाभ्यनुज्ञातं ब्राह्मद्यैश्च सुरैस्तथा।\nनातः परतरं पुण्यं भूमेः स्थानं भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2068470, "chapter_id": 2436, "verse_number": "९-५४-१८", "content_sanskrit": "इह तप्स्यन्ति ये केचित्तपः परमकं नराः।\nदेहत्यागेन ते सर्वे यास्यन्ति ब्रह्मणः क्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2068471, "chapter_id": 2436, "verse_number": "९-५४-१९", "content_sanskrit": "ये पुनः पुण्यभाजो वै दानं दास्यन्ति मानवाः।\nतेषां सहस्रगुणितं भविष्यत्यचिरेण वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2068472, "chapter_id": 2436, "verse_number": "९-५४-२०", "content_sanskrit": "ये चेह नित्यं मनुजा निवत्स्यन्ति शुभैषिणः।\nयमस्य विषयं ते तु न द्रक्ष्यन्ति कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2068473, "chapter_id": 2436, "verse_number": "९-५४-२१", "content_sanskrit": "यक्ष्यन्ति ये च क्रतुभिर्महद्भिर्मनुजेश्वराः।\nतेषां त्रिविष्टपे वासो यावद्भूमिर्धरिष्यति॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2068474, "chapter_id": 2436, "verse_number": "९-५४-२२", "content_sanskrit": "अपि चात्र स्वयं शक्रो जगौ गाथां सुराधिपः।\nकुरुक्षेत्रनिबद्धां वै तां शृणुष्व हलायुध॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2068475, "chapter_id": 2436, "verse_number": "९-५४-२३", "content_sanskrit": "पांसवोऽपि कुरुक्षेत्राद्वायुना समुदीरिताः।\nअपि दुष्कृतकर्माणं नयन्ति परमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2068476, "chapter_id": 2436, "verse_number": "९-५४-२४", "content_sanskrit": "`कुरुक्षेत्रं गमिष्यामि कुरुक्षेत्रे वसाम्यहम्।\nइत्येवं निश्चितो भूत्वा तेन स्वर्गं गमिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2068477, "chapter_id": 2436, "verse_number": "९-५४-२५", "content_sanskrit": "कुरुक्षेत्रं गमिष्यामि कुरुक्षेत्रे वसाम्यहम्।\nतथा स्थानं च मौनं च वीरासनमुपास्महे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2068478, "chapter_id": 2436, "verse_number": "९-५४-२६", "content_sanskrit": "एवं प्रलपमानोऽपि चिन्तयंश्च मुहुर्मुहुः।\nदूरस्थो यदि वा तिष्ठँल्लभेत्स्वर्गं सुनिश्चितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2068479, "chapter_id": 2436, "verse_number": "९-५४-२७", "content_sanskrit": "सुरर्षभा ब्राह्मणसत्तमाश्च\nतथा नृगाद्या नरदेवमुख्याः।\nइष्ट्वा महार्हैः क्रतुभिर्नृसिंह\nसन्त्यज्य देहान्सुगतिं प्रपन्नाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2068480, "chapter_id": 2436, "verse_number": "९-५४-२८", "content_sanskrit": "तंरन्तुकारन्तुकयोर्यदन्तरं\nरामहदानां च मचक्रुकस्य च।\nएतत्कुरुक्षेत्रसमन्तपञ्चकं\nप्रजापतेरुत्तरवेदिरुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2068481, "chapter_id": 2436, "verse_number": "९-५४-२९", "content_sanskrit": "शिवं महापुण्यमिदं दिवौकसां\nसुसम्मतं स्वर्गगुणैः समन्वितम्।\nअतश्च सर्वे निहता नृपा रणे\nयास्यन्ति पुण्यां गतिमक्षयां सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2068482, "chapter_id": 2436, "verse_number": "९-५४-३०", "content_sanskrit": "[इत्युवाच स्वयं शक्रः सह ब्रह्मादिभिस्तदा।\nतच्चानुमोदितं सर्वं ब्रह्मविष्णुमहेष्वरैः]॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2068483, "chapter_id": 2436, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि ह्रदप्रवेशपर्वणि चतुःपञ्चाशत्तमोऽध्यायः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]