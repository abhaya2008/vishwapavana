[{"id": 2203437, "chapter_id": 5338, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2203438, "chapter_id": 5338, "verse_number": "१", "content_sanskrit": "श्रुतं मे भवतस्तात सत्यव्रतपराक्रम ।\nदानधर्मेण महता ये प्राप्तास्त्रिदिवं नृपाः\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2203439, "chapter_id": 5338, "verse_number": "२", "content_sanskrit": "इमांस्तु श्रोतुमिच्छामि धर्मान् धर्मभृतांवर ।\nदानं कतिविधं देयं किं तस्य च फलं लभेत्\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2203440, "chapter_id": 5338, "verse_number": "३", "content_sanskrit": "कथं केभ्यश्च धर्म्यं च दानं दातव्यमिष्यते ।\nकैः कारणैः कतिविधं श्रोतुमिच्छामि तत्त्वतः\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2203441, "chapter_id": 5338, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2203442, "chapter_id": 5338, "verse_number": "४", "content_sanskrit": "शृणु तत्त्वेन कौन्तेय दानं प्रति ममानघ ।\nयथा दानं प्रदातव्यं सर्ववर्णेषु भारत\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2203443, "chapter_id": 5338, "verse_number": "५", "content_sanskrit": "धर्मादर्थाद् भयात् कामात् कारुण्यादिति भारत ।\nदानं पञ्चविधं ज्ञेयं कारणैर्यैर्निबोध तत्\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2203444, "chapter_id": 5338, "verse_number": "६", "content_sanskrit": "इह कीर्तिमवाप्नोति प्रेत्य चानुत्तमं सुखम् ।\nइति दानं प्रदातव्यं ब्राह्मणेभ्योऽनसूयता\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2203445, "chapter_id": 5338, "verse_number": "७", "content_sanskrit": "ददाति वा दास्यति वा मह्यं दत्तमनेन वा ।\nइत्यर्थिभ्यो निशम्यैव सर्वं दातव्यमर्थिने\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2203446, "chapter_id": 5338, "verse_number": "८", "content_sanskrit": "नास्याहं न मदीयोऽयं पापं कुर्याद् विमानितः ।\nइति दद्याद् भयादेव दृढं मूढाय पण्डितः\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2203447, "chapter_id": 5338, "verse_number": "९", "content_sanskrit": "प्रियो मेऽयं प्रियोऽस्याहमिति सम्प्रेक्ष्य बुद्धिमान् ।\nवयस्यायैवमक्लिष्टं दानं दद्यादतन्द्रितः\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2203448, "chapter_id": 5338, "verse_number": "१०", "content_sanskrit": "दीनश्च याचते चायमल्पेनापि हि तुष्यति ।\nइति दद्याद् दरिद्राय कारुण्यादिति सर्वथा\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2203449, "chapter_id": 5338, "verse_number": "समाप्तिः", "content_sanskrit": "इति पञ्चविधं दानं पुण्यकीर्तिविवर्धनम् ।\nयथाशक्त्या प्रदातव्यमेवमाह प्रजापतिः\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2203450, "chapter_id": 5338, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मेदानप्रभेदकथनं नाम एकोननवत्युत्तरशततमोऽध्यायः ॥१८९॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]