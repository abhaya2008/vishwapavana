[{"id": 7000040000, "chapter_id": 20040, "verse_number": "४०-१", "content_sanskrit": "दक्षकृतिशिवस्तुति-वर्णनम् ब्रह्मोवाच एवं दृष्ट्वा तदा दक्षः शंभोर्वीर्यं द्विजोत्तमाः ।\nप्राञ्जलिः प्रणतो भूत्वा संस्तोतुमुपचक्रमे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000040001, "chapter_id": 20040, "verse_number": "४०-२", "content_sanskrit": "दक्ष उवाच नमस्ते देवदेवेश नमस्तेऽन्धकसूदन ।\nदेवन्द्र त्वं बलश्रेष्ठ देवदानवपूजित ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000040002, "chapter_id": 20040, "verse_number": "४०-३", "content_sanskrit": "सहस्राक्ष विरूपाक्ष त्र्यक्ष यक्षाधिपप्रिय ।\nसर्व्वतःपाणिपादस्त्वं सर्वतोक्षिशिरोमुखः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000040003, "chapter_id": 20040, "verse_number": "४०-४", "content_sanskrit": "सर्दतःश्रुतिमांलोके सर्वमावृत्य तिष्ठसि ।\nशङ्कुकर्णो महाकर्णः सुम्भकर्णोऽर्मवालयः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000040004, "chapter_id": 20040, "verse_number": "४०-५", "content_sanskrit": "गजेन्द्रकर्णो गोकर्णः शतकर्णो नमोऽस्तु ते ।\nशतोदरः शतावर्तः शतजिह्‌वः सनातनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000040005, "chapter_id": 20040, "verse_number": "४०-६", "content_sanskrit": "गायन्ति त्वां गायत्रिणो अर्चयन्त्यर्कमर्किणः ।\nदेवदानवगोप्ता च ब्रह्म च त्वं शतक्रतुः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000040006, "chapter_id": 20040, "verse_number": "४०-७", "content_sanskrit": "मुर्तिमांस्वं महामूर्तिः समुद्रः सरसां निधिः ।\nत्वयि सर्वा देवता हि गावो गोष्ठ इवाऽऽसते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000040007, "chapter_id": 20040, "verse_number": "४०-८", "content_sanskrit": "त्वत्तः शरीरे पश्यामि सोममग्निजलेश्वरम् ।\nआदित्यमथ विष्णुं च ब्रह्माणं सवृहस्पतिम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000040008, "chapter_id": 20040, "verse_number": "४०-९", "content_sanskrit": "क्रिया करणकार्ये च कर्ता कारणमेव च ।\nअसच्च सदसच्चैव तथैव प्रभवाव्य (प्य) यौ ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000040009, "chapter_id": 20040, "verse_number": "४०-१०", "content_sanskrit": "नमो भवाय शर्वाय रुद्राय वरदाय च ।\nपशूनां पतये चैव नमोऽस्त्वन्धकघातिने ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000040010, "chapter_id": 20040, "verse_number": "४०-११", "content_sanskrit": "ज्ञिजटाय त्रिशीर्षाय त्रिसूलवरधारिणे ।\nत्र्यम्बकाय त्रिनेत्राय त्रिपुरघ्नाय वै नमः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000040011, "chapter_id": 20040, "verse_number": "४०-१२", "content_sanskrit": "नमश्चण्डाय मुण्डाय विश्वचण्डधराय च ।\nदण्डिने शङ्कुकर्णाय दण्डिदण्डाय वै नमः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000040012, "chapter_id": 20040, "verse_number": "४०-१३", "content_sanskrit": "योऽर्धदण्डिकेशाय शुष्काय विकृताय च ।\nविलोहिताय धूम्राय नीलग्रीवाय वै नमः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000040013, "chapter_id": 20040, "verse_number": "४०-१४", "content_sanskrit": "नमोऽस्त्वप्रतिरूपाय विरूपाय शिवाय च ।\nसूर्याय सूर्यपतये सूर्यध्वजपताकिने ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000040014, "chapter_id": 20040, "verse_number": "४०-१५", "content_sanskrit": "नमः प्रमथनाशाय कृषस्कन्धाय वै नमः ।\nनमो हिरण्यगर्भाय हिरण्यकवचाय च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000040015, "chapter_id": 20040, "verse_number": "४०-१६", "content_sanskrit": "हिरण्यकृतचूडाय हिरण्यपतये नमः ।\nशत्रुघाताय चण्डाय पर्मसंधशयाय च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000040016, "chapter_id": 20040, "verse_number": "४०-१७", "content_sanskrit": "नमः स्तुताय स्तुतये स्तूयमानाय वै नमः ।\nसर्वाय सर्वभक्षाय सर्वभूतान्तरात्मने ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000040017, "chapter_id": 20040, "verse_number": "४०-१८", "content_sanskrit": "नमो होमाय न्त्राय शुक्लध्वजपताकिने ।\nनमोऽनम्याय नम्याय नमः किलकिलाय च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000040018, "chapter_id": 20040, "verse_number": "४०-१९", "content_sanskrit": "नमस्त्वां शयमानाय शयितायोत्थिताय च ।\nस्थिताय धावमानाय कुब्जाय कुटिलाय च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000040019, "chapter_id": 20040, "verse_number": "४०-२०", "content_sanskrit": "नमो नर्तनशीलाय मुखवादित्रकारिणे ।\nबाधापहाय लुब्धाय गीतवादित्रकारिणे ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000040020, "chapter_id": 20040, "verse_number": "४०-२१", "content_sanskrit": "नमो ज्येष्ठाय श्रेष्ठाय बलप्रमथनाय च ।\nउग्राय च नमो नित्यं नमश्च दशबाहवे ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000040021, "chapter_id": 20040, "verse_number": "४०-२२", "content_sanskrit": "नमः कपालहस्ताय सितभस्मप्रियाय च ।\nविभीषणाय भीमाय भीष्मव्रतधराय च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000040022, "chapter_id": 20040, "verse_number": "४०-२३", "content_sanskrit": "नानाविकृतवक्त्राय खड्गजिह्वोग्रदंष्ट्रिणे ।\nपक्षमासलवार्धाय तुम्बीणाप्रियाय च ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000040023, "chapter_id": 20040, "verse_number": "४०-२४", "content_sanskrit": "अघोरघोररूपाय घोराघोरतराय च ।\nनमः शिवाय शान्तायः नमः शान्ततमाय च ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000040024, "chapter_id": 20040, "verse_number": "४०-२५", "content_sanskrit": "नमो बुद्धाय शुद्धाय संविभागप्रियाय च ।\nपवनाय पतङ्गाय नमः सांख्यापराय च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000040025, "chapter_id": 20040, "verse_number": "४०-२६", "content_sanskrit": "नमश्चण्डैकघण्टाय घण्टाजल्पाय घण्टिने ।\nसहस्रशतघण्टाय घण्टामालाप्रियाय च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000040026, "chapter_id": 20040, "verse_number": "४०-२७", "content_sanskrit": "प्राणदण्डाय नित्याय नमस्ते लोहिताय च ।\nहूंहूंकाराय रुद्राय भगाकारप्रियाय च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000040027, "chapter_id": 20040, "verse_number": "४०-२८", "content_sanskrit": "नमोऽपरवते नित्यं गिरिवृक्षप्रियाय च ।\nनमो यज्ञाधिपतये भूताय प्रस्तुताय च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000040028, "chapter_id": 20040, "verse_number": "४०-२९", "content_sanskrit": "यज्ञवाहाय दान्ताय तप्याय च भगाय च ।\nनमस्तटाय तट्याय तटिनीपतये नमः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000040029, "chapter_id": 20040, "verse_number": "४०-३०", "content_sanskrit": "अन्नदाययान्नपतये नमस्त्वन्नभुजाय च ।\nनमः सहस्रशीर्षाय सहस्रचरणाय च ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000040030, "chapter_id": 20040, "verse_number": "४०-३१", "content_sanskrit": "सहस्रोद्धतशूलाय सहस्रनयनाय च ।\nनमो बालार्कवर्णाय बालरूपधराय च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000040031, "chapter_id": 20040, "verse_number": "४०-३२", "content_sanskrit": "नमो बालार्करूपाय कालक्रीडनकाय च ।\nनमः शुद्धाय बुद्धाय क्षोभणाय भयाय च ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000040032, "chapter_id": 20040, "verse_number": "४०-३३", "content_sanskrit": "तरङ्गाङ्कितकेशाय मुक्तकेशाय वै नमः ।\nनमः षट्कर्मनिष्ठाय त्रिकर्मनियताय च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000040033, "chapter_id": 20040, "verse_number": "४०-३४", "content_sanskrit": "वर्णाश्रमाणां विधिवत्पृथग्धर्मप्रवर्तिने ।\nनमः श्रेष्ठाय ज्येष्ठाय नमः कलकलाय च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000040034, "chapter_id": 20040, "verse_number": "४०-३५", "content_sanskrit": "श्वेतपिङ्गलनेत्राय कृष्णरक्तेक्षणाय च ।\nधर्मकामार्थमोक्षाय क्रथाय क्रथनाय च ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000040035, "chapter_id": 20040, "verse_number": "४०-३६", "content_sanskrit": "साख्याय सांख्यमुख्याय योगाधिपतये नमः ।\nनमो रथ्याथिरथ्याय चतुष्पथपथाय च ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000040036, "chapter_id": 20040, "verse_number": "४०-३७", "content_sanskrit": "कृष्णाजिनोत्तरीयाय व्यालयज्ञोपवीतिने ।\nईशान रुद्रसंघात हरिकेश नमोऽस्तु ते ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000040037, "chapter_id": 20040, "verse_number": "४०-३८", "content_sanskrit": "त्र्यम्बकायाम्बिकानाथ व्यक्ताव्यक्त नमोऽस्तु ते ।\nकालकामदकामघ्न दुष्टोद्धृत्तनिषूदन ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000040038, "chapter_id": 20040, "verse_number": "४०-३९", "content_sanskrit": "सर्वगर्हितसर्वघ्न हद्योजात नमोऽस्तु ते ।\nउन्मादनशतावर्त गङ्गातोयार्द्रमूर्धज ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000040039, "chapter_id": 20040, "verse_number": "४०-४०", "content_sanskrit": "चन्द्रार्धसंयुगावर्त मेघावर्त नमोऽस्तु ते ।\nनमोऽन्नदानकर्त्रे च अन्नदप्रभवे नमः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000040040, "chapter_id": 20040, "verse_number": "४०-४१", "content_sanskrit": "अन्नभोक्त्रे च गोप्त्रे च त्वमेव प्रलयानल ।\nजरायुजाण्डजाश्चैव स्वेदजोद्भिज्ज एव च ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000040041, "chapter_id": 20040, "verse_number": "४०-४२", "content_sanskrit": "त्वमेव देवदेवेश भूतग्रामश्चतुर्विधः ।\nचराचरस्य स्रष्टा त्वं प्रतिहर्ता त्वमेव च ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000040042, "chapter_id": 20040, "verse_number": "४०-४३", "content_sanskrit": "त्वमेव ब्रह्मा विश्वेश अप्सु ब्रह्म वदन्ति ते ।\nसर्वस्य परमा योनिः सु धांशो ज्योतिषां निधिः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000040043, "chapter_id": 20040, "verse_number": "४०-४४", "content_sanskrit": "ऋक्सामानि तथोंकारमाहुस्त्वां ब्रह्मवादिनः ।\nहायि हायि हरे हायि हुवाहावेति वाऽसकृत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000040044, "chapter_id": 20040, "verse_number": "४०-४५", "content_sanskrit": "गायनति त्वां सुरश्रेष्ठाः सामगा ब्रह्मवादिनः ।\nयजुर्मय ऋङ्मयश्च सामाथर्वयुतस्तथा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000040045, "chapter_id": 20040, "verse_number": "४०-४६", "content_sanskrit": "पठ्यसे ब्रह्मविद्भिस्त्वं कल्पोपनिषदां गणैः ।\nब्राह्मणाः क्षत्रिया वैश्याः शूद्रा वर्णश्रिमाश्च ये ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000040046, "chapter_id": 20040, "verse_number": "४०-४७", "content_sanskrit": "त्वमेवाऽऽश्रमसंघाश्च विद्युत्स्तनितमेव च ।\nवृषाणां ककुदं त्वं हि गिरीणां शिखराणि च ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000040047, "chapter_id": 20040, "verse_number": "४०-४८", "content_sanskrit": "कला काष्ठा निसेषास्च नक्षत्राणि युगानि च ।\nवृषाणां ककुदं त्वं हि गिरीणां शिखराणि च ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000040048, "chapter_id": 20040, "verse_number": "४०-४९", "content_sanskrit": "सिंहो मृगाणां पतयस्तक्षकानन्तभोगिनाम् ।\nक्षीरोदो ह्यु दधीनां च मन्त्राणां प्रणवस्तथा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000040049, "chapter_id": 20040, "verse_number": "४०-५०", "content_sanskrit": "वज्रं प्रहरणानां च व्रतानां सत्यमेव च ।\nत्वमेवेच्छा च द्वेषस्च रागो मोहः शमः क्षमा ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000040050, "chapter_id": 20040, "verse_number": "४०-५१", "content_sanskrit": "व्यवसायो धृतिर्लोभः कामक्रोधौ जयाजयौ ।\nत्वं गदी त्वं शरी चापी खट्वाङ्गी मुद्‌गरो तथा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000040051, "chapter_id": 20040, "verse_number": "४०-५२", "content_sanskrit": "छेत्ता भेत्ता प्रहर्ता च नेता मन्ताऽसि नो मतः ।\nदशलक्षणसंयुक्तो धर्मोऽर्थेः काम एव च ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000040052, "chapter_id": 20040, "verse_number": "४०-५३", "content_sanskrit": "इन्दुः समुद्रः सरितः पल्वलानि सरांसि च ।\nलतावल्यस्तुणौषध्यः पशवो मृगपक्षिणः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000040053, "chapter_id": 20040, "verse_number": "४०-५४", "content_sanskrit": "द्रव्यकर्मगुणारम्भः कालपुष्पफलप्रदः ।\nआदिश्चान्तश्च मध्यश्च गायत्र्योंकार एव च ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000040054, "chapter_id": 20040, "verse_number": "४०-५५", "content_sanskrit": "हरितोलोहितः कृष्णोनीलः पीतस्तथा क्षणः ।\nकद्रुश्चकपिलो बभ्रुः कपोतो मच्छ (त्स्य) कस्तथा ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000040055, "chapter_id": 20040, "verse_number": "४०-५६", "content_sanskrit": "सुवर्मरेता विख्यातः सुवर्णश्चाप्यथो मतः ।\nसुवर्णनाम च तथा सुवर्णप्रिय एव च ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000040056, "chapter_id": 20040, "verse_number": "४०-५७", "content_sanskrit": "त्वममिन्द्रश्च यमश्चैव वरुणो धनदोऽनलः ।\nउत्फुल्लश्चिभानुस्च स्वर्भानुर्भानुरेव च ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000040057, "chapter_id": 20040, "verse_number": "४०-५८", "content_sanskrit": "होत्रं होता च होम्यं च हुतं चैव तथा प्रभुः ।\nत्रिसौपर्णस्तथा ब्रह्मन्यजुषां शतरुद्रियम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000040058, "chapter_id": 20040, "verse_number": "४०-५९", "content_sanskrit": "पवित्रं च पवित्राणां मङ्गलानां च मङ्गलम् ।\nप्राणश्च त्वं रजश्च त्वं तमः सत्त्वयुतस्तथा ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000040059, "chapter_id": 20040, "verse_number": "४०-६०", "content_sanskrit": "प्राणोऽपानः समानश्च उदानो व्यान एव च ।\nउन्मेषश्च निमेषश्च क्षुत्तृह्‌जृम्भा तथैव च ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000040060, "chapter_id": 20040, "verse_number": "४०-६१", "content_sanskrit": "लोहताङ्गस्च दंष्टी च महावक्त्रो महोदरः ।\nशुचिरोमा हरिच्छ्‌मश्रुरूर्ध्वकेशश्चलाचलः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000040061, "chapter_id": 20040, "verse_number": "४०-६२", "content_sanskrit": "गीतवादित्रनृत्याङ्गो गीतवादनकप्रियः ।\nमत्स्यो जालो जलोऽज्य्यो जलव्यालः कुटीचरः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000040062, "chapter_id": 20040, "verse_number": "४०-६३", "content_sanskrit": "विकालश्च सुकालश्च दुष्कालः कालनाशनः ।\nमृत्युश्चैवाक्षयोऽन्तश्च क्षमामायाकरोत्करः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000040063, "chapter_id": 20040, "verse_number": "४०-६४", "content_sanskrit": "संचर्तो वर्तकश्चैव संवर्तकबलाहकौ ।\nघण्टाकी घण्टाकी घण्टी चूडालो लवणोदधिः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000040064, "chapter_id": 20040, "verse_number": "४०-६५", "content_sanskrit": "ब्रह्मा कालाग्निवक्त्रश्च दण्डी मुण्डस्त्रिदण्डधृक् ।\nचतुर्युगश्तुर्वेदश्चतुर्होत्रश्चतुष्पथः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000040065, "chapter_id": 20040, "verse_number": "४०-६६", "content_sanskrit": "चातुराश्रम्यनेता च चातुवर्ण्यकरश्च ह ।\nक्षराक्षरः प्रियो धूर्तो गणैर्गण्यो गणादिपः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000040066, "chapter_id": 20040, "verse_number": "४०-६७", "content_sanskrit": "रक्तमाल्याम्बराधरो गिरीशो गिरिजाप्रियः ।\nशिल्पीशः शिल्पिनः श्रेष्ठं सर्वशिल्प्रिप्रवर्तकः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000040067, "chapter_id": 20040, "verse_number": "४०-६८", "content_sanskrit": "भगनेत्रान्तकश्चण्डः पूष्णो दन्तविनाशनः ।\nस्वाहा स्वधा वषट्कारो नमस्कार नमोऽस्तु ते ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000040068, "chapter_id": 20040, "verse_number": "४०-६९", "content_sanskrit": "गूढव्रतश्च गूढश्च गूढव्रतनिषेधितः ।\nतरमस्तारणश्चैव सर्वबूतेषु तारणः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000040069, "chapter_id": 20040, "verse_number": "४०-७०", "content_sanskrit": "धाता विधाता संधाता निघाता धारणो धरः ।\nतपो ब्रह्म च सत्यं च ब्रह्मचर्यं तथाऽऽर्जवम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000040070, "chapter_id": 20040, "verse_number": "४०-७१", "content_sanskrit": "भूतात्मा भूतकृद्‌भूतो भूतभव्यभवोद्भवः ।\nभूर्भूवः स्वरितश्चैव भूतो ह्यग्निर्महेश्वरः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000040071, "chapter_id": 20040, "verse_number": "४०-७२", "content_sanskrit": "ब्रह्मावर्तः सुरावर्तः कामावर्त नमोऽस्तु ते ।\nकामबिम्बविनिर्हन्ता कर्णिकारस्रजप्रियः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000040072, "chapter_id": 20040, "verse_number": "४०-७३", "content_sanskrit": "गोनेता गोप्रचारश्च गोवृषेश्वरवाहनः ।\nत्रैलोक्यगोप्ता गोविन्दोगच गोप्ता (?) एव च ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000040073, "chapter_id": 20040, "verse_number": "४०-७४", "content_sanskrit": "अखण्डचन्द्राभिमुखः सुमुखो दुर्मुखोऽडमुखः ।\nचतुर्मुखो बहुमुखो रणेष्वभिमुखः सदा ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000040074, "chapter_id": 20040, "verse_number": "४०-७५", "content_sanskrit": "हिरण्यगर्भः शकुनिर्धनदोऽर्थपतिर्विराट् ।\nअधर्महा महादक्षो दण्डधारो रमप्रियः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000040075, "chapter_id": 20040, "verse_number": "४०-७६", "content_sanskrit": "तिष्ठन्स्थिरश्च स्थाणुश्च निष्कम्पश्च सुनिश्चलः ।\nदुर्वारणो दुर्विषहो दुःसहो दुरतिक्रमः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000040076, "chapter_id": 20040, "verse_number": "४०-७७", "content_sanskrit": "दुर्धरो दुर्वशो नित्यो दुर्दर्पो विजयो जयः ।\nशशः शशाङ्कनयनशीतोष्णः श्रुत्तुषा जरा ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000040077, "chapter_id": 20040, "verse_number": "४०-७८", "content_sanskrit": "आधयो व्याधयश्चैव व्याधिहा व्याधिपश्च यः ।\nसह्यो यज्ञमृगव्याधो व्याधिनामाकरोऽकरः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000040078, "chapter_id": 20040, "verse_number": "४०-७९", "content_sanskrit": "शिखण्डी पुण्डरीकश्च पुणडरीकावलोकनः ।\nदण्डधृक्‌चक्रदण्डस्च रौद्रभागविनाशनः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000040079, "chapter_id": 20040, "verse_number": "४०-८०", "content_sanskrit": "विषपोऽमृतपश्चैव सुरापः भीरसोमपः ।\nमधुपस्चाऽऽपपश्चैव सर्वपस्च बलाबलः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000040080, "chapter_id": 20040, "verse_number": "४०-८१", "content_sanskrit": "वृषाङ्गराम्भो (?) वृषभस्तथा वृषभलोचनः ।\nवषभश्चैव विख्यातो लोकानां लोकसंस्कृतः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000040081, "chapter_id": 20040, "verse_number": "४०-८२", "content_sanskrit": "चन्द्रादित्यौ चक्षुषी ते हृदयं च पितामहः ।\nअग्निष्टोमस्तता वेहो धर्मकर्मप्रसाधितः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000040082, "chapter_id": 20040, "verse_number": "४०-८३", "content_sanskrit": "न ब्रह्मा न च गोविन्दः पुराणऋषयो न च ।\nमाहात्म्यं वेवितुं शक्ता याथातथ्येन ते शिवः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000040083, "chapter_id": 20040, "verse_number": "४०-८४", "content_sanskrit": "शिवा या मूर्तयः सूक्ष्मास्ते मह्यं यान्तु दर्शनम् ।\nताभिर्मां सर्वतो रक्ष पिता पत्र मिवौरसम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000040084, "chapter_id": 20040, "verse_number": "४०-८५", "content_sanskrit": "रक्ष मां रक्षणीयोऽहं तवानघ नमोऽस्तु ते ।\nभक्तानु कम्पी भगवान्भक्तश्चाहं सदा त्वयि ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000040085, "chapter_id": 20040, "verse_number": "४०-८६", "content_sanskrit": "यः सहस्राण्यनेकानि पुंसामावृत्य दुर्दृशाम् ।\nतिष्ठत्येकः समुद्रान्ते स मे गोप्ताऽस्तु नित्यशः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000040086, "chapter_id": 20040, "verse_number": "४०-८७", "content_sanskrit": "यं विनिद्रा जितश्वासाः सत्त्वस्थाः समादर्शिनः ।\nज्योतिः पश्यन्ति युञ्जानास्तस्मै योगात्मने नमः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000040087, "chapter_id": 20040, "verse_number": "४०-८८", "content_sanskrit": "संभक्ष्य सर्वभूतानि युगान्ते समुपस्थिते ।\nयः शेते जलमध्यस्थस्तं प्रपद्येऽम्बुशायिनम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000040088, "chapter_id": 20040, "verse_number": "४०-८९", "content_sanskrit": "प्रविश्य वदनं राहोर्यः सोमं पिबते निशि ।\nग्रसत्यर्कं च स्वर्भानुर्भूत्वा सोमाग्निरे च ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000040089, "chapter_id": 20040, "verse_number": "४०-९०", "content_sanskrit": "अङ्गुष्ठमात्राः पुरुषा देहस्थाः सर्वदेहिनाम् ।\nरक्षन्तु ते च मां नित्यं नित्यं चाऽऽप्ययन्तु माम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000040090, "chapter_id": 20040, "verse_number": "४०-९१", "content_sanskrit": "येनाप्युत्पादिता गर्भा अपो भागगताश्च ये ।\nतेषां स्वाहा स्वधा चैव आप्नुवन्ति स्वदन्ति च ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000040091, "chapter_id": 20040, "verse_number": "४०-९२", "content_sanskrit": "येन रोहन्ति देहस्थाः प्राणिनो रोदयन्ति च ।\nहर्षयन्ति न कृष्यन्ति नमस्तेब्यस्तु नित्यशः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000040092, "chapter_id": 20040, "verse_number": "४०-९३", "content_sanskrit": "ये समुद्रे नदीदुर्गे पर्वतेषु गुहासु च ।\nवृक्षमूलेषु गोष्ठेषु कान्तारगहनेषु च ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000040093, "chapter_id": 20040, "verse_number": "४०-९४", "content_sanskrit": "चतुष्पथेषु रथ्यासु चत्वरेषु सभासु च ।\nहस्त्यश्वरथशालासु जीर्णोद्यानालयेषु च ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000040094, "chapter_id": 20040, "verse_number": "४०-९५", "content_sanskrit": "येषु पञ्चसु भूतेषु दिशासु विदिशासु च ।\nइन्द्रार्कयोर्मध्यगता ये च चन्द्रार्करश्मिषु ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000040095, "chapter_id": 20040, "verse_number": "४०-९६", "content_sanskrit": "रसातसगता ये च येच तस्मात्परं गताः ।\nनमस्तेभ्यो नमस्तेभ्यो नमस्तेभ्यस्तु सर्वशः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000040096, "chapter_id": 20040, "verse_number": "४०-९७", "content_sanskrit": "सर्वसत्वं सर्वगो देवः सर्वभूतपतिर्भवः ।\nसर्वभूतान्तरात्मा च तेन त्वं न निमन्त्रितः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000040097, "chapter_id": 20040, "verse_number": "४०-९८", "content_sanskrit": "स्वमेव चेज्यसे देव यज्ञैर्विविधदक्षिणैः ।\nत्वमेव कर्ता सर्वस्य तेन त्वं न निमन्त्रितः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000040098, "chapter_id": 20040, "verse_number": "४०-९९", "content_sanskrit": "अथवा माययादेव मोहितः सूक्ष्मया तव ।\nतस्मात्तु कारणाद्वाऽपि त्वं मया न निमन्त्रितः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000040099, "chapter_id": 20040, "verse_number": "४०-१००", "content_sanskrit": "प्रसीद मम देवेश त्वमेव शरणं मम ।\nत्वं गतिस्त्वं प्रतिष्ठा च न चान्योऽस्तीति ने मतिः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000040100, "chapter_id": 20040, "verse_number": "४०-१०१", "content_sanskrit": "ब्रह्मोवाच स्तुत्वैवं स महादेवं विरराम प्रजापितः ।\nभगवानपि सुप्रीतः सुनर्दक्षमभाषत ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000040101, "chapter_id": 20040, "verse_number": "४०-१०२", "content_sanskrit": "श्रीभगवानुवाच परितुष्टोऽस्मि ते दक्ष स्तवेनानेन सुव्रत ।\nबहुना तु किमुक्तेन मत्समीपं यमिष्यसि ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000040102, "chapter_id": 20040, "verse_number": "४०-१०३", "content_sanskrit": "ब्रह्मोवाच तथैवमब्रवीद्वाक्यं त्रैलोक्याधिपतिर्भवः ।\nकृत्वाऽऽश्वासकरं वाक्यं सर्वज्ञो वाक्य संहितम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000040103, "chapter_id": 20040, "verse_number": "४०-१०४", "content_sanskrit": "श्रीशिव उवाच दक्ष दुःखं न कर्तव्यं यज्ञविध्वंसनं प्रति ।\nअहं यज्ञहनस्तुभ्यं दृष्टमेतत्पुराऽनघ ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000040104, "chapter_id": 20040, "verse_number": "४०-१०५", "content_sanskrit": "भूयश्च त्वं वरमिमं मत्तो गृह्णीष्व सुव्रत ।\nप्रसन्नसुमुखो भूत्वा ममैकाग्रमनाः श्रुणु ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000040105, "chapter_id": 20040, "verse_number": "४०-१०६", "content_sanskrit": "अश्वमेधसहस्रस्य वाजपेयशतस्य वै ।\nप्रजापते मत्प्रसादात्फलभागो भविष्यसि ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000040106, "chapter_id": 20040, "verse_number": "४०-१०७", "content_sanskrit": "वेदान्षडङ्गन्बुध्यस्व सांख्ययोगांश्च कृत्स्नशः ।\nतपश्च विपुलं तप्त्वा दुश्वरं देवनानवैः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000040107, "chapter_id": 20040, "verse_number": "४०-१०८", "content_sanskrit": "अब्दैर्द्वादशभिर्युक्तं गूढमप्रज्ञनिन्दितम् ।\nवर्णाश्रमकृतेर्धमेर्विनीतं न क्वचित्क्वचित् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000040108, "chapter_id": 20040, "verse_number": "४०-१०९", "content_sanskrit": "समागतं व्यवसितं पशुपाशविमोक्षणम् ।\nसर्वेषाणाश्रमाणां च मया पाशुपतं व्रतम् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000040109, "chapter_id": 20040, "verse_number": "४०-११०", "content_sanskrit": "उत्पादितं दक्ष शुभं सर्वपापविमोचनम् ।\nअस्य चीर्णस्य यत्सम्यक्फलं भवति पुष्कलम् ।\nतच्चास्तु सुमहाभाग मानसस्तयचज्यतां ज्वरः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000040110, "chapter_id": 20040, "verse_number": "४०-१११", "content_sanskrit": "ब्रह्मोवाच एवमुक्त्वा तु देवेशः सपत्नीकः सहानुगः ।\nअदर्शनमनुप्राप्तो दक्षस्यामितेजसः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7000040111, "chapter_id": 20040, "verse_number": "४०-११२", "content_sanskrit": "अवाप्य च तथा भागं यथोक्तं चोमया भवः ।\nज्वरं च सर्वधर्मज्ञो बहुधा व्यभजत्तदा ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7000040112, "chapter_id": 20040, "verse_number": "४०-११३", "content_sanskrit": "शान्त्यर्थं सर्वभूतानां श्रृणुध्वमथ वै द्विजाः ।\nशिखाभितापो नागानां पर्वतानां शिलाजतु ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7000040113, "chapter_id": 20040, "verse_number": "४०-११४", "content_sanskrit": "अपां तु नीलिकां विद्यान्निर्मोको भुजगेषु च ।\nखोरकः सौरभेयाणामूखरः पृथिवीतले ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7000040114, "chapter_id": 20040, "verse_number": "४०-११५", "content_sanskrit": "शुनुमपि च धर्मज्ञा दृष्टिप्रत्यवरोधनम् ।\nरन्ध्रागतमथाश्वानां शिखोद्‌भेदश्च बर्हिणाम् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7000040115, "chapter_id": 20040, "verse_number": "४०-११६", "content_sanskrit": "नेत्ररागः कोकिलानां द्वेषः प्रोक्तो महात्मनाम् ।\nजनानामपि भेदस्च सर्वेषामिति नः श्रुतम् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7000040116, "chapter_id": 20040, "verse_number": "४०-११७", "content_sanskrit": "शुकानामपि सर्वेषां हिक्किका प्रोच्यते ज्वरः ।\nशार्दूलेष्वथ वै विप्राः श्रमोज्वर इहोच्यते ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7000040117, "chapter_id": 20040, "verse_number": "४०-११८", "content_sanskrit": "मानुषेषु च सर्वज्ञा ज्वरो नामैष कीर्तितः ।\nमरणे जन्मनि तथा मध्ये चापि निवेशितः ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7000040118, "chapter_id": 20040, "verse_number": "४०-११९", "content_sanskrit": "एतन्माहेश्वरं तेजो ज्वरो नाम सुदारुणः ।\nनमस्यश्चैव मान्यश्च सर्वप्राणिभिरीश्वरः ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7000040119, "chapter_id": 20040, "verse_number": "४०-१२०", "content_sanskrit": "इमां ज्वरोत्पत्तिमदीनमानसः, पठेत्सदा यः सुसमाहितो नरः ।\nविमुक्तरोगः स नरो मुदायुतो, लभेत कामांश्च यथामनीषितान् ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7000040120, "chapter_id": 20040, "verse_number": "४०-१२१", "content_sanskrit": "दक्षप्रोक्तं स्तवं चापि कीर्तयेद्यः शृणोति वा ।\nनाशुभं प्राप्नुयात्किंचिद्‌दीर्घमायुरवाप्नुयात् ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7000040121, "chapter_id": 20040, "verse_number": "४०-१२२", "content_sanskrit": "यथा सर्वेषु देवेषु वरिष्ठो भगवान्भवः ।\nतथा स्तवो वरिष्ठोऽयं स्तवानां दक्षनिर्मितः ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7000040122, "chapter_id": 20040, "verse_number": "४०-१२३", "content_sanskrit": "यशःस्वर्गसुरैश्वर्यवित्तादिजयकाङ्क्षिभिः ।\nस्तोतव्यो भक्तिमास्थाय विद्याकामैश्च यत्नतः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7000040123, "chapter_id": 20040, "verse_number": "४०-१२४", "content_sanskrit": "व्याधितो दुःखितो दीनो नरो ग्रस्तो भयादिभिः ।\nराजकार्यनियुक्तो वा मुच्यते महतो भयात् ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7000040124, "chapter_id": 20040, "verse_number": "४०-१२५", "content_sanskrit": "अनेनैव च देहेन गणानां च महेश्वरात् ।\nइह लोके सुखं प्राप्य गणराडुपजायते ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7000040125, "chapter_id": 20040, "verse_number": "४०-१२६", "content_sanskrit": "न यक्षा न पिशाचा वा न नागा न विनायकाः ।\nकुर्युर्विघ्नं गृहे तस्य यत्र संस्तूयते भवः ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7000040126, "chapter_id": 20040, "verse_number": "४०-१२७", "content_sanskrit": "श्रृणुयाद्वा इदं नारी भक्त्याऽथ भवभाविता ।\nपितृपक्षे भर्तृपक्षे पूज्या भवति चैव ह ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7000040127, "chapter_id": 20040, "verse_number": "४०-१२८", "content_sanskrit": "श्रृणुयाद्वा इदं सर्वं कीर्तयेद्वाऽप्यभीक्ष्णशः ।\nतस्य सर्वाणि कार्याणि सिद्धिं गच्छन्त्यविघ्नतः ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7000040128, "chapter_id": 20040, "verse_number": "४०-१२९", "content_sanskrit": "मनसा विन्तितं यच्च यच्च वाचाऽप्युदाहृतम् ।\nसर्वं संपद्यते तस्य स्तवस्यास्यानुकोर्तनात् ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7000040129, "chapter_id": 20040, "verse_number": "४०-१३०", "content_sanskrit": "देवस्य सगुहस्याथ देव्या नंदीश्वरस्य च ।\nबलिं विभज (भाग) तः कृत्वा दमेन नियमेन च ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7000040130, "chapter_id": 20040, "verse_number": "४०-१३१", "content_sanskrit": "ततः प्रयुक्तो गृह्णीयान्नामान्यासु यथाक्रमम् ।\nइप्सिताल्लँभतेऽप्यर्थान्कामान्भोगांश्च मानवः ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7000040131, "chapter_id": 20040, "verse_number": "४०-१३२", "content_sanskrit": "मतश्च स्वर्गमाप्नोति स्त्रीसहस्रसमावृतः ।\nसर्वकामसुयुक्तो वा युक्तो वा सर्वपातकैः ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7000040132, "chapter_id": 20040, "verse_number": "४०-१३३", "content_sanskrit": "पठन्दक्षकृतं स्तोत्रं सर्वपापैः प्रमुच्यते ।\nमृतश्च गणसायुज्यं पूज्यमानः सुरासुरैः ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7000040133, "chapter_id": 20040, "verse_number": "४०-१३४", "content_sanskrit": "वृषेण विनियुक्तेन विमानेन विराजते ।\nआभूतसंप्लवस्थायी रुद्रस्यानुचरो भवेत् ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7000040134, "chapter_id": 20040, "verse_number": "४०-१३५", "content_sanskrit": "इत्याह भगवान्व्यासः पराशरसुतः प्रभुः ।\nनैतद्वेदयते कश्चिन्नैतच्छ्राव्यं च कस्यचित् ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7000040135, "chapter_id": 20040, "verse_number": "४०-१३६", "content_sanskrit": "श्रुत्वेमं परमं गुह्यं येऽपि स्युः पापयोनयः ।\nवैश्याः स्त्रियश्च शूद्राश्च रुद्रलोकमवाप्नुयुः ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7000040136, "chapter_id": 20040, "verse_number": "४०-१३७", "content_sanskrit": "श्रवयेद्यश्च विप्रेभ्यः सदा पर्वसु पर्वसु ।\nरुद्रलोकमवाप्नोति द्विजो वै नात्र संशयः ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}]