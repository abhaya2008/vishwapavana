[{"id": 7001496000, "chapter_id": 21496, "verse_number": "७-२-३४-१", "content_sanskrit": "उपमन्युरुवाच ।\nनित्यनैमित्तिकात्काम्याद्या सिद्धिरिह कीर्तिता ।\nसा सर्वा लभ्येत सद्यो लिंगबेरप्रतिष्ठया॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001496001, "chapter_id": 21496, "verse_number": "७-२-३४-२", "content_sanskrit": "सर्वो लिंगमयो लोकस्सर्वं लिंगे प्रतिष्ठितम् ।\nतस्मात्प्रतिष्ठिते लिंगे भवेत्सर्वं पतिष्ठितम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001496002, "chapter_id": 21496, "verse_number": "७-२-३४-३", "content_sanskrit": "ब्रह्मणा विष्णुना वापि रुद्रेणान्येन केन वा ।\nलिंगप्रतिष्ठामुत्सृज्य क्रियते स्वपदस्थितिः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001496003, "chapter_id": 21496, "verse_number": "७-२-३४-४", "content_sanskrit": "किमन्यदिह वक्तव्यं प्रतिष्ठां प्रति कारणम् ।\nपर्तिष्ठितं शिवेनापि लिंगं वैश्वेश्वरं यतः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001496004, "chapter_id": 21496, "verse_number": "७-२-३४-५", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन परत्रेह च शर्मणे ।\nस्थापयेत्परमेशस्य लिंगं बेरमथापि वा॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001496005, "chapter_id": 21496, "verse_number": "७-२-३४-६", "content_sanskrit": "श्रीकृष्ण उवाच ।\nकिमिदं लिंगमाख्यातं कथं लिंगी महेश्वरः ।\nकथं च लिंगभावो ऽस्य कस्मादस्मिञ्छिवो ऽर्च्यते॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001496006, "chapter_id": 21496, "verse_number": "७-२-३४-७", "content_sanskrit": "उपमन्युरुवाच ।\nअव्यक्तं लिंगमाख्यातं त्रिगुणप्रभवाप्ययम् ।\nअनाद्यनंतं विश्वस्य यदुपादानकारणम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001496007, "chapter_id": 21496, "verse_number": "७-२-३४-८", "content_sanskrit": "तदेव मूलप्रकृतिर्माया च गगनात्मिका ।\nतत एव समुत्पन्नं जगदेतच्चराचरम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001496008, "chapter_id": 21496, "verse_number": "७-२-३४-९", "content_sanskrit": "अशुद्धं चैव शुद्धं यच्छुद्धाशुद्धं च तत्त्रिधा ।\nततः शिवो महेशश्च रुद्रो विष्णुः पितामहः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001496009, "chapter_id": 21496, "verse_number": "७-२-३४-१०", "content_sanskrit": "भूतानि चेन्द्रियैर्जाता लीयन्ते ऽत्र शिवाज्ञया ।\nअत एव शिवो लिंगो लिंगमाज्ञापयेद्यतः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001496010, "chapter_id": 21496, "verse_number": "७-२-३४-११", "content_sanskrit": "यतो न तदनाज्ञातं कार्याय प्रभवेत्स्वतः ।\nततो जातस्य विश्वस्य तत्रैव विलयो यतः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001496011, "chapter_id": 21496, "verse_number": "७-२-३४-१२", "content_sanskrit": "अनेन लिंगतां तस्य भवेन्नान्येन केनचित् ।\nलिंगं च शिवयोर्देहस्ताभ्यां यस्मादधिष्ठितम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001496012, "chapter_id": 21496, "verse_number": "७-२-३४-१३", "content_sanskrit": "अतस्तत्र शिवः साम्बो नित्यमेव समर्चयेत् ।\nलिंगवेदी महादेवी लिंगं साक्षान्महेश्वरः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001496013, "chapter_id": 21496, "verse_number": "७-२-३४-१४", "content_sanskrit": "तयोः संपूजनादेव स च सा च समर्चितौ ।\nन तयोर्लिंगदेहत्वं विद्यते परमार्थतः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001496014, "chapter_id": 21496, "verse_number": "७-२-३४-१५", "content_sanskrit": "यतस्त्वेतौ विशुद्धौ तौ देहस्तदुपचारतः ।\nतदेव परमा शक्तिः शिवस्य परमात्मनः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001496015, "chapter_id": 21496, "verse_number": "७-२-३४-१६", "content_sanskrit": "शक्तिराज्ञां यदादत्ते प्रसूते तच्चराचरम् ।\nन तस्य महिमा शक्यो वक्तुं वर्षशतैरपि॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001496016, "chapter_id": 21496, "verse_number": "७-२-३४-१७", "content_sanskrit": "येनादौ मोहितौ स्यातां ब्रह्मनारायणावपि ।\nपुरा त्रिभुवनस्यास्य प्रलये समुपस्थिते॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001496017, "chapter_id": 21496, "verse_number": "७-२-३४-१८", "content_sanskrit": "वारिशय्यागतो विष्णुः सुष्वापानाकुलः सुखम् ।\nयदृच्छया गतस्तत्र ब्रह्मा लोकपितामहः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001496018, "chapter_id": 21496, "verse_number": "७-२-३४-१९", "content_sanskrit": "ददर्श पुण्डरीकाक्षं स्वपन्तं तमनाकुलम् ।\nमायया मोहितः शम्भोर्विष्णुमाह पितामहः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001496019, "chapter_id": 21496, "verse_number": "७-२-३४-२०", "content_sanskrit": "कस्त्वं वदेत्यमर्षेण प्रहृत्योत्थाप्य माधवम् ।\nस तु हस्तप्रहारेण तीव्रेणाभिहतः क्षणात्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001496020, "chapter_id": 21496, "verse_number": "७-२-३४-२१", "content_sanskrit": "प्रबुद्धोत्थाय शयनाद्ददर्श परमेष्ठिनम् ।\nतमाह चांतस्संक्रुद्धः स्वयमक्रुद्धवद्धरिः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001496021, "chapter_id": 21496, "verse_number": "७-२-३४-२२", "content_sanskrit": "कुतस्त्वमागतो वत्स कस्मात्त्वं व्याकुलो वद ।\nइति विष्णुवचः श्रुत्वा प्रभुत्वगुणसूचकम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001496022, "chapter_id": 21496, "verse_number": "७-२-३४-२३", "content_sanskrit": "रजसा बद्धवैरस्तं ब्रह्मा पुनरभाषत ।\nवत्सेति मां कुतो ब्रूषे गुरुः शिष्यमिवात्मनः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001496023, "chapter_id": 21496, "verse_number": "७-२-३४-२४", "content_sanskrit": "मां न जानासि किं नाथं प्रपञ्चो यस्य मे कृतिः ।\nत्रिधात्मानं विभज्येदं सृष्ट्वाथ परिपाल्यते॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001496024, "chapter_id": 21496, "verse_number": "७-२-३४-२५", "content_sanskrit": "संहरामि नमे कश्चित्स्रष्टा जगति विद्यते ।\nइत्युक्ते सति सो ऽप्याह ब्रह्माणं विष्णुरव्ययः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001496025, "chapter_id": 21496, "verse_number": "७-२-३४-२६", "content_sanskrit": "अहमेवादिकर्तास्य हर्ता च परिपालकः ।\nभवानपि ममैवांगादवतीर्णः पुराव्ययात्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001496026, "chapter_id": 21496, "verse_number": "७-२-३४-२७", "content_sanskrit": "मन्नियोगात्त्वमात्मानं त्रिधा कृत्वा जगत्त्रयम् ।\nसृजस्यवसि चांते तत्पुनः प्रतिसृजस्यपि॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001496027, "chapter_id": 21496, "verse_number": "७-२-३४-२८", "content_sanskrit": "विस्मृतोसि जगन्नाथं नारायणमनामयम् ।\nतवापि जनकं साक्षान्मामेवमवमन्यसे॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001496028, "chapter_id": 21496, "verse_number": "७-२-३४-२९", "content_sanskrit": "तवापराधो नास्त्यत्र भ्रांतोसि मम मायया ।\nमत्प्रसादादियं भ्रांतिरपैष्यति तवाचिरात्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001496029, "chapter_id": 21496, "verse_number": "७-२-३४-३०", "content_sanskrit": "शृणु सत्यं चतुर्वक्त्र सर्वदेवेश्वरो ह्यहम् ।\nकर्ता भर्ता च हर्ता च न मयास्ति समो विभुः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001496030, "chapter_id": 21496, "verse_number": "७-२-३४-३१", "content_sanskrit": "एवमेव विवादोभूद्ब्रह्मविष्ण्वोः परस्परम् ।\nअभवच्च महायुद्धं भैरवं रोमहर्षणम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001496031, "chapter_id": 21496, "verse_number": "७-२-३४-३२", "content_sanskrit": "मुष्टिभिर्न्निघ्नतोस्तीव्रं रजसा बद्धवैरयोः ।\nतयोर्दर्पापहाराय प्रबोधाय च देवयोः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001496032, "chapter_id": 21496, "verse_number": "७-२-३४-३३", "content_sanskrit": "मध्ये समाविरभवल्लिंगमैश्वरमद्भुतम् ।\nज्वालामालासहस्राढ्यमप्रमेयमनौपमम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001496033, "chapter_id": 21496, "verse_number": "७-२-३४-३४", "content_sanskrit": "क्षयवृद्धिविनिर्मुक्तमादिमध्यांतवर्जितम् ।\nतस्य ज्वालासहस्रेण ब्रह्मविष्णू विमोहितौ॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001496034, "chapter_id": 21496, "verse_number": "७-२-३४-३५", "content_sanskrit": "विसृज्य युद्धं किं त्वेतदित्यचिंतयतां तदा ।\nन तयोस्तस्य याथात्म्यं प्रबुद्धमभवद्यदा॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001496035, "chapter_id": 21496, "verse_number": "७-२-३४-३६", "content_sanskrit": "तदा समुद्यतौ स्यातां तस्याद्यंतं परीक्षितुम् ।\nतत्र हंसाकृतिर्ब्रह्मा विश्वतः पक्षसंयुतः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001496036, "chapter_id": 21496, "verse_number": "७-२-३४-३७", "content_sanskrit": "मनोनिलजवो भूत्वा गतस्तूर्ध्वं प्रयत्नतः ।\nनारायणोपि विश्वात्मा लीलाञ्जनचयोपमम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001496037, "chapter_id": 21496, "verse_number": "७-२-३४-३८", "content_sanskrit": "वाराहममितं रूपमस्थाय गतवानधः ।\nएवं वर्षसहस्रं तु त्वरन् विष्णुरधोगतः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001496038, "chapter_id": 21496, "verse_number": "७-२-३४-३९", "content_sanskrit": "नापश्यदल्पमप्यस्य मूलं लिंगस्य सूकरः ।\nतावत्कालं गतश्चोर्ध्वं तस्यांतं ज्ञातुमिच्छया॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001496039, "chapter_id": 21496, "verse_number": "७-२-३४-४०", "content_sanskrit": "श्रांतोत्यंतमदृष्ट्वांतं पापताधः पितामहः ।\nतथैव भगवान् विष्णुः श्रांतः संविग्नलोचनः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001496040, "chapter_id": 21496, "verse_number": "७-२-३४-४१", "content_sanskrit": "क्लेशेन महता तूर्णमधस्तादुत्थितो ऽभवत् ।\nसमागतावथान्योन्यं विस्मयस्मेरवीक्षणौ॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001496041, "chapter_id": 21496, "verse_number": "७-२-३४-४२", "content_sanskrit": "मायया मोहितौ शंभोः कृत्याकृत्यं न जग्मतुः ।\nपृष्ठतः पार्श्वतस्तस्य चाग्रतश्च स्थितावुभौ॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001496042, "chapter_id": 21496, "verse_number": "७-२-३४-४३", "content_sanskrit": "प्रणिपत्य किमात्मेदमित्यचिंतयतां तदा॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]