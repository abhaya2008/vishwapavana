[{"id": 7000405000, "chapter_id": 20405, "verse_number": "२-७७-१", "content_sanskrit": "सुकर्मोवाच ।\nकामस्य गीतलास्येन हास्येन ललितेन च ।\nमोहितो राजराजेंद्रो नटरूपेण पिप्पल॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000405001, "chapter_id": 20405, "verse_number": "२-७७-२", "content_sanskrit": "कृत्वा मूत्रं पुरीषं च स राजा नहुषात्मजः ।\nअकृत्वा पादयोः शौचमासने उपविष्टवान्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000405002, "chapter_id": 20405, "verse_number": "२-७७-३", "content_sanskrit": "तदंतरं तु संप्राप्य संचचार जरा नृपम् ।\nकामेनापि नृपश्रेष्ठ इंद्रकार्यं कृतं हितम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000405003, "chapter_id": 20405, "verse_number": "२-७७-४", "content_sanskrit": "निवृत्ते नाटके तस्मिन्गतेषु तेषु भूपतिः ।\nजराभिभूतो धर्मात्मा कामसंसक्तमानसः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000405004, "chapter_id": 20405, "verse_number": "२-७७-५", "content_sanskrit": "मोहितः काममोहेन विह्वलो विकलेंद्रियः ।\nअतीव मुग्धो धर्मात्मा विषयैश्चापवाहितः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000405005, "chapter_id": 20405, "verse_number": "२-७७-६", "content_sanskrit": "एकदा तु गतो राजा मृगया व्यसनातुरः ।\nवने च क्रीडते सोपि मोहरागवशं गतः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000405006, "chapter_id": 20405, "verse_number": "२-७७-७", "content_sanskrit": "सरसं क्रीडमानस्य नृपतेश्च महात्मनः ।\nमृगश्चैकः समायातश्चतुःशृंगो ह्यनौपमः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000405007, "chapter_id": 20405, "verse_number": "२-७७-८", "content_sanskrit": "सर्वांगसुंदरो राजन्हेमरूपतनूरुहः ।\nरत्नज्योतिः सुचित्रांगो दर्शनीयो मनोहरः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000405008, "chapter_id": 20405, "verse_number": "२-७७-९", "content_sanskrit": "अभ्यधावत्स वेगेन बाणपाणिर्धनुर्द्धरः ।\nइत्यमन्यत मेधावी कोपि दैत्यः समागतः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000405009, "chapter_id": 20405, "verse_number": "२-७७-१०", "content_sanskrit": "मृगेण च स तेनापि दूरमाकर्षितो नृपः ।\nगतः सरथवेगेन श्रमेण परिखेदितः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000405010, "chapter_id": 20405, "verse_number": "२-७७-११", "content_sanskrit": "वीक्षमाणस्य तस्यापि मृगश्चांतरधीयत ।\nस पश्यति वनं तत्र नंदंनोपममद्भुतम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000405011, "chapter_id": 20405, "verse_number": "२-७७-१२", "content_sanskrit": "चारुवृक्षसमाकीर्णं भूतपंचकशोभितम् ।\nगुरुभिश्चंदनैः पुण्यैः कदलीखंडमंडितैः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000405012, "chapter_id": 20405, "verse_number": "२-७७-१३", "content_sanskrit": "बकुलाशोकपुंनागैर्नालिकेरैश्च तिंदुकैः ।\nपूगीफलैश्च खर्जूरैः कुमुदैः सप्तपर्णकैः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000405013, "chapter_id": 20405, "verse_number": "२-७७-१४", "content_sanskrit": "पुष्पितैः कर्णिकारैश्च नानावृक्षैः सदाफलैः ।\nपुष्पितामोदसंयुक्तैः केतकैः पाटलैस्ततः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000405014, "chapter_id": 20405, "verse_number": "२-७७-१५", "content_sanskrit": "वीक्षमाणो महाराज ददर्श सर उत्तमम् ।\nपुण्योदकेन संपूर्णं विस्तीर्णं पंचयोजनम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000405015, "chapter_id": 20405, "verse_number": "२-७७-१६", "content_sanskrit": "हंसकारंडवाकीर्णं जलपक्षिविनादितम् ।\nकमलैश्चापि मुदितं श्वेतोत्पलविराजितम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000405016, "chapter_id": 20405, "verse_number": "२-७७-१७", "content_sanskrit": "रक्तोत्पलैः शोभमानं हाटकोत्पलमंडितम् ।\nनीलोत्पलैः प्रकाशितं कल्हारैरतिशोभितम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000405017, "chapter_id": 20405, "verse_number": "२-७७-१८", "content_sanskrit": "मत्तैर्मधुकरैश्चपि सर्वत्र परिनादितम् ।\nएवं सर्वगुणोपेतं ददर्श सर उत्तमम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000405018, "chapter_id": 20405, "verse_number": "२-७७-१९", "content_sanskrit": "पंचयोजनविस्तीर्णं दशयोजनदीर्घकम् ।\nतडागं सर्वतोभद्रं दिव्यभावैरलंकृतम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000405019, "chapter_id": 20405, "verse_number": "२-७७-२०", "content_sanskrit": "रथवेगेन संखिन्नः किंचिच्छ्रमनिपीडितः ।\nनिषसाद तटे तस्य चूतच्छायां सुशीतलाम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000405020, "chapter_id": 20405, "verse_number": "२-७७-२१", "content_sanskrit": "स्नात्वा पीत्वा जलं शीतं पद्मसौगंध्यवासितम् ।\nसर्वश्रमोपशमनममृतोपममेव तत्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000405021, "chapter_id": 20405, "verse_number": "२-७७-२२", "content_sanskrit": "वृक्षच्छाये ततस्तस्मिन्नुपविष्टेन भूभृता ।\nगीतध्वनिः समाकर्णि गीयमानो यथा तथा॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000405022, "chapter_id": 20405, "verse_number": "२-७७-२३", "content_sanskrit": "यथा स्त्री गायते दिव्या तथायं श्रूयते ध्वनिः ।\nगीतप्रियो महाराज एव चिंतां परां गतः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000405023, "chapter_id": 20405, "verse_number": "२-७७-२४", "content_sanskrit": "चिंताकुलस्तु धर्मात्मा यावच्चिंतयते क्षणम् ।\nतावन्नारी वरा काचित्पीनश्रोणी पयोधरा॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000405024, "chapter_id": 20405, "verse_number": "२-७७-२५", "content_sanskrit": "नृपतेः पश्यतस्तस्य वने तस्मिन्समागता ।\nसर्वाभरणशोभांगी शीललक्षणसंपदा॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000405025, "chapter_id": 20405, "verse_number": "२-७७-२६", "content_sanskrit": "तस्मिन्वने समायाता नृपतेः पुरतः स्थिता ।\nतामुवाच महाराजः का हि कस्य भविष्यसि॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000405026, "chapter_id": 20405, "verse_number": "२-७७-२७", "content_sanskrit": "किमर्थं हि समायाता तन्मे त्वं कारणं वद ।\nपृष्टा सती तदा तेन न किंचिदपि पिप्पल॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000405027, "chapter_id": 20405, "verse_number": "२-७७-२८", "content_sanskrit": "शुभाशुभं च भूपालं प्रत्यवोचद्वरानना ।\nप्रहस्यैव गता शीघ्रं वीणादंडकराऽबला॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000405028, "chapter_id": 20405, "verse_number": "२-७७-२९", "content_sanskrit": "विस्मयेनापि राजेंद्रो महता व्यापितस्तदा ।\nमया संभाषिता चेयं मां न ब्रूते स्म सोत्तरम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000405029, "chapter_id": 20405, "verse_number": "२-७७-३०", "content_sanskrit": "पुनश्चिंतां समापेदे ययातिः पृथिवीपतिः ।\nयो वै मृगो मया दृष्टश्चतुःशृंगः सुवर्णकः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000405030, "chapter_id": 20405, "verse_number": "२-७७-३१", "content_sanskrit": "तस्मान्नारी समुद्भूता तत्सत्यं प्रतिभाति मे ।\nमायारूपमिदं सत्यं दानवानां भविष्यति॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000405031, "chapter_id": 20405, "verse_number": "२-७७-३२", "content_sanskrit": "चिंतयित्वा क्षणं राजा ययातिर्नहुषात्मजः ।\nयावच्चिंतयते राजा तावन्नारी महावने॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000405032, "chapter_id": 20405, "verse_number": "२-७७-३३", "content_sanskrit": "अंतर्धानं गता विप्र प्रहस्य नृपनंदनम् ।\nएतस्मिन्नंतरे गीतं सुस्वरं पुनरेव तत्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000405033, "chapter_id": 20405, "verse_number": "२-७७-३४", "content_sanskrit": "शुश्रुवे परमं दिव्यं मूर्छनातानसंयुतम् ।\nजगाम सत्वरं राजा यत्र गीतध्वनिर्महान्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000405034, "chapter_id": 20405, "verse_number": "२-७७-३५", "content_sanskrit": "जलांते पुष्करं चैव सहस्रदलमुत्तमम् ।\nतस्योपरि वरा नारी शीलरूपगुणान्विता॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000405035, "chapter_id": 20405, "verse_number": "२-७७-३६", "content_sanskrit": "दिव्यलक्षणसंपन्ना दिव्याभरणभूषिता ।\nदिव्यैर्भावैः प्रभात्येका वीणादंडकराविला॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000405036, "chapter_id": 20405, "verse_number": "२-७७-३७", "content_sanskrit": "गायंती सुस्वरं गीतं तालमानलयान्वितम् ।\nतेन गीतप्रभावेण मोहयंती चराचरान्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000405037, "chapter_id": 20405, "verse_number": "२-७७-३८", "content_sanskrit": "देवान्मुनिगणान्सर्वान्दैत्यान्गंधर्वकिन्नरान् ।\nतां दृष्ट्वा स विशालाक्षीं रूपतेजोपशालिनीम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000405038, "chapter_id": 20405, "verse_number": "२-७७-३९", "content_sanskrit": "संसारे नास्ति चैवान्या नारीदृशी चराचरे ।\nपुरा नटो जरायुक्तो नृपतेः कायमेव हि॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000405039, "chapter_id": 20405, "verse_number": "२-७७-४०", "content_sanskrit": "संचारितो महाकामस्तदासौ प्रकटोभवत् ।\nघृतं स्पृष्ट्वा यथा वह्नी रश्मिवान्संप्रजायते॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000405040, "chapter_id": 20405, "verse_number": "२-७७-४१", "content_sanskrit": "तां च दृष्ट्वा तथा कामस्तत्कायात्प्रकटोऽभवत् ।\nमन्मथाविष्टचित्तोसौ तां दृष्ट्वा चारुलोचनाम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000405041, "chapter_id": 20405, "verse_number": "२-७७-४२", "content_sanskrit": "ईदृग्रूपा न दृष्टा मे युवती विश्वमोहिनी ।\nचिंतयित्वा क्षणं राजा कामसंसक्तमानसः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000405042, "chapter_id": 20405, "verse_number": "२-७७-४३", "content_sanskrit": "तस्याः सविरहेणापि लुब्धोभून्नृपतिस्तदा ।\nकामाग्निना दह्यमानः कामज्वरेणपीडितः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000405043, "chapter_id": 20405, "verse_number": "२-७७-४४", "content_sanskrit": "कथं स्यान्मम चैवेयं कथं भावो भविष्यति ।\nयदा मां गूहते बाला पद्मास्या पद्मलोचना॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000405044, "chapter_id": 20405, "verse_number": "२-७७-४५", "content_sanskrit": "यदीयं प्राप्यते तर्हि सफलं जीवितं भवेत् ।\nएवं विचिंत्य धर्मात्मा ययातिः पृथिवीपतिः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000405045, "chapter_id": 20405, "verse_number": "२-७७-४६", "content_sanskrit": "तामुवाच वरारोहां का त्वं कस्यापि वा शुभे ।\nपूर्वं दृष्टा तु या नारी सा दृष्टा पुनरेव च॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000405046, "chapter_id": 20405, "verse_number": "२-७७-४७", "content_sanskrit": "तां पप्रच्छ स धर्मात्मा का चेयं तव पार्श्वगा ।\nसर्वं कथय कल्याणि अहं हि नहुषात्मजः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000405047, "chapter_id": 20405, "verse_number": "२-७७-४८", "content_sanskrit": "सोमवंशप्रसूतोहं सप्तद्वीपाधिपः शुभे ।\nययातिर्नाम मे देवि ख्यातोहं भुवनत्रये॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000405048, "chapter_id": 20405, "verse_number": "२-७७-४९", "content_sanskrit": "तव संगमने चेतो भावमेवं प्रवांछते ।\nदेहि मे संगमं भद्रे कुरु सुप्रियमेव हि॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000405049, "chapter_id": 20405, "verse_number": "२-७७-५०", "content_sanskrit": "यं यं हि वांछसे भद्रे तद्ददामि न संशयः ।\nदुर्जयेनापि कामेन हतोहं वरवर्णिनि॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000405050, "chapter_id": 20405, "verse_number": "२-७७-५१", "content_sanskrit": "तस्मात्त्राहि सुदीनं मां प्रपन्नं शरणं तव ।\nराज्यं च सकलामुर्वीं शरीरमपि चात्मनः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000405051, "chapter_id": 20405, "verse_number": "२-७७-५२", "content_sanskrit": "संगमे तव दास्यामि त्रैलोक्यमिदमेव ते ।\nतस्य राज्ञो वचः श्रुत्वा सा स्त्री पद्मनिभानना॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000405052, "chapter_id": 20405, "verse_number": "२-७७-५३", "content_sanskrit": "विशालां स्वसखीं प्राह ब्रूहि राजानमागतम् ।\nनाम चोत्पत्तिस्थानं च पितरं मातरं शुभे॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000405053, "chapter_id": 20405, "verse_number": "२-७७-५४", "content_sanskrit": "ममापि भावमेकाग्रमस्याग्रे च निवेदय ।\nतस्याश्च वांछितं ज्ञात्वा विशाला भूपतिं तदा॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000405054, "chapter_id": 20405, "verse_number": "२-७७-५५", "content_sanskrit": "उवाच मधुरालापैः श्रूयतां नृपनंदन ।\nविशालोवाच ।\nकाम एष पुरा दग्धो देवदेवेन शंभुना॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000405055, "chapter_id": 20405, "verse_number": "२-७७-५६", "content_sanskrit": "रुरोद सा रतिर्दुःखाद्भर्त्राहीनापि सुस्वरम् ।\nअस्मिन्सरसि राजेंद्र सा रतिर्न्यवसत्तदा॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000405056, "chapter_id": 20405, "verse_number": "२-७७-५७", "content_sanskrit": "तस्य प्रलापमेवं सा सुस्वरं करुणान्वितम् ।\nसमाकर्ण्य ततो देवाः कृपया परयान्विताः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000405057, "chapter_id": 20405, "verse_number": "२-७७-५८", "content_sanskrit": "संजाता राजराजेंद्र शंकरं वाक्यमब्रुवन् ।\nजीवयस्व महादेव पुनरेव मनोभवम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000405058, "chapter_id": 20405, "verse_number": "२-७७-५९", "content_sanskrit": "वराकीयं महाभाग भर्तृहीना हि कीदृशी ।\nकामेनापि समायुक्तामस्मत्स्नेहात्कुरुष्व हि॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000405059, "chapter_id": 20405, "verse_number": "२-७७-६०", "content_sanskrit": "तच्छ्रुत्वा च वचः प्राह जीवयामि मनोभवम् ।\nकायेनापि विहीनोयं पंचबाणो मनोभवः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000405060, "chapter_id": 20405, "verse_number": "२-७७-६१", "content_sanskrit": "भविष्यति न संदेहो माधवस्य सखा पुनः ।\nदिव्येनापि शरीरेण वर्तयिष्यति नान्यथा॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000405061, "chapter_id": 20405, "verse_number": "२-७७-६२", "content_sanskrit": "महादेवप्रसादाच्च मीनकेतुः स जीवितः ।\nआशीर्भिरभिनंद्यैवं देव्याः कामं नरोत्तम॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000405062, "chapter_id": 20405, "verse_number": "२-७७-६३", "content_sanskrit": "गच्छ काम प्रवर्तस्व प्रियया सह नित्यशः ।\nएवमाह महातेजाः स्थितिसंहारकारकः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000405063, "chapter_id": 20405, "verse_number": "२-७७-६४", "content_sanskrit": "पुनः कामः सरःप्राप्तो यत्रास्ते दुःखिता रतिः ।\nइदं कामसरो राजन्रतिरत्र सुसंस्थिता॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000405064, "chapter_id": 20405, "verse_number": "२-७७-६५", "content_sanskrit": "दग्धे सति महाभागे मन्मथे दुःखधर्षिता ।\nरत्याः कोपात्समुत्पन्नः पावको दारुणाकृतिः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000405065, "chapter_id": 20405, "verse_number": "२-७७-६६", "content_sanskrit": "अतीवदग्धा तेनापि सा रतिर्मोहमूर्छिता ।\nअश्रुपातं मुमोचाथ भर्तृहीना नरोत्तम॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000405066, "chapter_id": 20405, "verse_number": "२-७७-६७", "content_sanskrit": "नेत्राभ्यां हि जले तस्याः पतिता अश्रुबिंदवः ।\nतेभ्यो जातो महाशोकः सर्वसौख्यप्रणाशकः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000405067, "chapter_id": 20405, "verse_number": "२-७७-६८", "content_sanskrit": "जरा पश्चात्समुत्पन्ना अश्रुभ्यो नृपसत्तम ।\nवियोगो नाम दुर्मेधास्तेभ्यो जज्ञे प्रणाशकः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000405068, "chapter_id": 20405, "verse_number": "२-७७-६९", "content_sanskrit": "दुःखसंतापकौ चोभौ जज्ञाते दारुणौ तदा ।\nमूर्छा नाम ततो जज्ञे दारुणा सुखनाशिनी॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000405069, "chapter_id": 20405, "verse_number": "२-७७-७०", "content_sanskrit": "शोकाज्जज्ञे महाराज कामज्वरोथ विभ्रमः ।\nप्रलापो विह्वलश्चैव उन्मादो मृत्युरेव च॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000405070, "chapter_id": 20405, "verse_number": "२-७७-७१", "content_sanskrit": "तस्याश्च अश्रुबिंदुभ्यो जज्ञिरे विश्वनाशकाः ।\nरत्याः पार्श्वे समुत्पन्नाः सर्वे तापांगधारिणः॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000405071, "chapter_id": 20405, "verse_number": "२-७७-७२", "content_sanskrit": "मूर्तिमंतो महाराज सद्भावगुणसंयुताः ।\nकाम एष समायातः केनाप्युक्तं तदा नृप॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000405072, "chapter_id": 20405, "verse_number": "२-७७-७३", "content_sanskrit": "महानंदेन संयुक्ता दृष्ट्वा कामं समागतम् ।\nनेत्राभ्यामश्रुपूर्णाभ्यां पतिता अश्रुबिन्दवः॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000405073, "chapter_id": 20405, "verse_number": "२-७७-७४", "content_sanskrit": "अप्सु मध्ये महाराज चापल्याज्जज्ञिरे प्रजाः ।\nप्रीतिर्नाम तदा जज्ञे ख्यातिर्लज्जा नरोत्तम॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000405074, "chapter_id": 20405, "verse_number": "२-७७-७५", "content_sanskrit": "तेभ्यो जज्ञे महानंद शांतिश्चान्या नृपोत्तम ।\nजज्ञाते द्वे शुभे कन्ये सुखसंभोगदायिके॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000405075, "chapter_id": 20405, "verse_number": "२-७७-७६", "content_sanskrit": "लीलाक्रीडा मनोभाव संयोगस्तु महान्नृप ।\nरत्यास्तु वामनेत्राद्वै आनंदादश्रुबिंदवः॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000405076, "chapter_id": 20405, "verse_number": "२-७७-७७", "content_sanskrit": "जलांते पतिता राजंस्तस्माज्जज्ञे सुपंकजम् ।\nतस्मात्सुपंकजाज्जाता इयं नारी वरानना॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000405077, "chapter_id": 20405, "verse_number": "२-७७-७८", "content_sanskrit": "अश्रुबिंदुमती नाम रतिपुत्री नरोत्तम ।\nतस्याः प्रीत्या सुखं कृत्वा नित्यं वर्त्ते समीपगा॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000405078, "chapter_id": 20405, "verse_number": "२-७७-७९", "content_sanskrit": "सखीभावस्वभावेन संहृष्टा सर्वदा शुभा ।\nविशाला नाम मे ख्यातं वरुणस्य सुता नृप॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000405079, "chapter_id": 20405, "verse_number": "२-७७-८०", "content_sanskrit": "अस्याश्चांते प्रवर्तामि स्नेहात्स्निग्धास्मि सर्वदा ।\nएतत्ते सर्वमाख्यातमस्याश्चात्मन एव ते॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000405080, "chapter_id": 20405, "verse_number": "२-७७-८१", "content_sanskrit": "तपश्चचार राजेंद्र पतिकामा वरानना ।\nराजोवाच ।\nसर्वमेव त्वयाख्यातं मया ज्ञातं शुभे शृणु॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000405081, "chapter_id": 20405, "verse_number": "२-७७-८२", "content_sanskrit": "मामेवं हि भजत्वेषा रतिपुत्री वरानना ।\nयमेषा वांछते बाला तत्सर्वं तु ददाम्यहम्॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000405082, "chapter_id": 20405, "verse_number": "२-७७-८३", "content_sanskrit": "तथा कुरुष्व कल्याणि यथा मे वश्यतां व्रजेत् ।\nविशालोवाच ।\nअस्या व्रतं प्रवक्ष्यामि तदाकर्णय भूपते॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000405083, "chapter_id": 20405, "verse_number": "२-७७-८४", "content_sanskrit": "पुरुषं यौवनोपेतं सर्वज्ञं वीरलक्षणम् ।\nदेवराजसमं राजन्धर्माचारसमन्वितम्॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000405084, "chapter_id": 20405, "verse_number": "२-७७-८५", "content_sanskrit": "तेजस्विनं महाप्राज्ञं दातारं यज्विनां वरम् ।\nगुणानां धर्मभावस्य ज्ञातारं पुण्यभाजनम्॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000405085, "chapter_id": 20405, "verse_number": "२-७७-८६", "content_sanskrit": "लोक इंद्रसमं राजन्सुयज्ञैर्धर्मतत्परम् ।\nसर्वैश्वर्यसमोपेतं नारायणमिवापरम्॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000405086, "chapter_id": 20405, "verse_number": "२-७७-८७", "content_sanskrit": "देवानां सुप्रियं नित्यं ब्राह्मणानामतिप्रियम् ।\nब्रह्मण्यं वेदतत्त्वज्ञं त्रैलोक्ये ख्यातविक्रमम्॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000405087, "chapter_id": 20405, "verse_number": "२-७७-८८", "content_sanskrit": "एवंगुणैः समुपेतं त्रैलोक्येन प्रपूजितम् ।\nसुमतिं सुप्रियं कांतं मनसा वरमीप्सति॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000405088, "chapter_id": 20405, "verse_number": "२-७७-८९", "content_sanskrit": "ययातिरुवाच ।\nएवं गुणैः समुपेतं विद्धि मामिह चागतम् ।\nअस्यानुरूपो भर्त्ताहं सृष्टो धात्रा न संशयः॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000405089, "chapter_id": 20405, "verse_number": "२-७७-९०", "content_sanskrit": "विशालोवाच ।\nभवंतं पुण्यसंवृद्धं जाने राजञ्जगत्त्रये ।\nपूर्वोक्ता ये गुणाः सर्वे मयोक्ताः संति ते त्वयि॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000405090, "chapter_id": 20405, "verse_number": "२-७७-९१", "content_sanskrit": "एकेनापि च दोषेण त्वामेषा हि न मन्यते ।\nएष मे संशयो जातो भवान्विष्णुमयो नृप॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000405091, "chapter_id": 20405, "verse_number": "२-७७-९२", "content_sanskrit": "ययातिरुवाच ।\nसमाचक्ष्व महादोषं यमेषा नानुमन्यते ।\nतत्त्वेन चारुसर्वांगी प्रसादसुमुखी भव॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000405092, "chapter_id": 20405, "verse_number": "२-७७-९३", "content_sanskrit": "विशालोवाच ।\nआत्मदोषं न जानासि कस्मात्त्वं जगतीपते ।\nजरया व्याप्तकायस्त्वमनेनेयं न मन्यते॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000405093, "chapter_id": 20405, "verse_number": "२-७७-९४", "content_sanskrit": "एवं श्रुत्वा महद्वाक्यमप्रियं जगतीपतिः ।\nदुःखेन महताविष्टस्तामुवाच पुनर्नृपः॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000405094, "chapter_id": 20405, "verse_number": "२-७७-९५", "content_sanskrit": "जरादोषो न मे भद्रे संसर्गात्कस्यचित्कदा ।\nसमुद्भूतं ममांगे वै तं न जाने जरागमम्॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000405095, "chapter_id": 20405, "verse_number": "२-७७-९६", "content_sanskrit": "यं यं हि वांछते चैषा त्रैलोक्ये दुर्लभं शुभे ।\nतमस्यै दातुकामोहं व्रियतां वर उत्तमः॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000405096, "chapter_id": 20405, "verse_number": "२-७७-९७", "content_sanskrit": "विशालोवाच ।\nजराहीनो यदा स्यास्त्वं तदा ते सुप्रिया भवेत् ।\nएतद्विनिश्चितं राजन्सत्यं सत्यं वदाम्यहम्॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000405097, "chapter_id": 20405, "verse_number": "२-७७-९८", "content_sanskrit": "श्रुतिरेवं वदेद्राजन्पुत्रे भ्रातरि भृत्यके ।\nजरा संक्राम्यते यस्य तस्यांगे परिसंचरेत्॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000405098, "chapter_id": 20405, "verse_number": "२-७७-९९", "content_sanskrit": "तारुण्यं तस्य वै गृह्य तस्मै दत्वा जरां पुनः ।\nउभयोः प्रीतिसंवादः सुरुच्या जायते शुभः॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000405099, "chapter_id": 20405, "verse_number": "२-७७-१००", "content_sanskrit": "यथात्मदानपुण्यस्य कृपया यो ददाति च ।\nफलं राजन्हि तत्तस्य जायते नात्र संशयः॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000405100, "chapter_id": 20405, "verse_number": "२-७७-१०१", "content_sanskrit": "दुःखेनोपार्जितं पुण्यमन्यस्मै हि प्रदीयते ।\nसुपुण्यं तद्भवेत्तस्य पुण्यस्य फलमश्नुते॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000405101, "chapter_id": 20405, "verse_number": "२-७७-१०२", "content_sanskrit": "पुत्राय दीयतां राजंस्तस्मात्तारुण्यमेव च ।\nप्रगृह्यैव समागच्छ सुंदरत्वेन भूपते॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000405102, "chapter_id": 20405, "verse_number": "२-७७-१०३", "content_sanskrit": "यदा त्वमिच्छसे भोक्तुं तदा त्वं कुरुभूपते ।\nएवमाभाष्य सा भूपं विशाला विरराम ह॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000405103, "chapter_id": 20405, "verse_number": "२-७७-१०४", "content_sanskrit": "सुकर्मोवाच ।\nएवमाकर्ण्य राजेंद्रो विशालामवदत्तदा ।\nराजोवाच ।\nएवमस्तु महाभागे करिष्ये वचनं तव॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000405104, "chapter_id": 20405, "verse_number": "२-७७-१०५", "content_sanskrit": "कामासक्तः समूढस्तु ययातिः पृथिवीपतिः ।\nगृहं गत्वा समाहूय सुतान्वाक्यमुवाच ह॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000405105, "chapter_id": 20405, "verse_number": "२-७७-१०६", "content_sanskrit": "तुरुं पूरुं कुरुं राजा यदुं च पितृवत्सलम् ।\nकुरुध्वं पुत्रकाः सौख्यं यूयं हि मम शासनात्॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000405106, "chapter_id": 20405, "verse_number": "२-७७-१०७", "content_sanskrit": "पुत्रा ऊचुः ।\nपितृवाक्यं प्रकर्तव्यं पुत्रैश्चापि शुभाशुभम् ।\nउच्यतां तात तच्छीघ्रं कृतं विद्धि न संशयः॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000405107, "chapter_id": 20405, "verse_number": "२-७७-१०८", "content_sanskrit": "एवमाकर्ण्यतद्वाक्यं पुत्राणां पृथिवीपतिः ।\nआचचक्षे पुनस्तेषु हर्षेणाकुलमानसः॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}]