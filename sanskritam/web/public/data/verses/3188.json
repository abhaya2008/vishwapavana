[{"id": 2101510, "chapter_id": 3188, "verse_number": "१४-४४-१", "content_sanskrit": "ब्रह्मोवाच।\nयदादिमध्यपर्यन्तं ग्रहणोपायमेव च।\nनामलक्षणसंयुक्तं सर्वं वक्ष्यामि तत्त्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101511, "chapter_id": 3188, "verse_number": "१४-४४-२", "content_sanskrit": "अहः पूर्वं ततो रात्रिर्मासाः शुक्लादयः स्मृताः।\nश्रवणादीनि ऋक्षाणि ऋतवः शिशिरादयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101512, "chapter_id": 3188, "verse_number": "१४-४४-३", "content_sanskrit": "भूमिरादिस्तु गन्धानां रसानामाप एव च।\nरूपाणामादिरग्निस्तु स्पर्शादिर्वायुरुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101513, "chapter_id": 3188, "verse_number": "१४-४४-४", "content_sanskrit": "शब्दस्यादिस्तथाऽऽकाशमेष भूतकृतो गुणः।\nअतः परं प्रवक्ष्यामि भूतानामादिमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101514, "chapter_id": 3188, "verse_number": "१४-४४-५", "content_sanskrit": "आदित्यो ज्योतिषामादिरग्निर्भूतादिरुच्यते।\nसावित्री सर्वविद्यानां देवतानां प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101515, "chapter_id": 3188, "verse_number": "१४-४४-६", "content_sanskrit": "ओङ्कारः सर्ववेदानां वचसां प्राण एव च।\nयदस्मिन्नियतं लोके सर्वं सावित्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101516, "chapter_id": 3188, "verse_number": "१४-४४-७", "content_sanskrit": "गायत्री च्छन्दसामादिः प्रजानां सर्ग उच्यते।\nगावश्चतुष्पदामादिर्मनुष्याणां द्विजातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101517, "chapter_id": 3188, "verse_number": "१४-४४-८", "content_sanskrit": "श्येनः पतत्रिणामादिर्यज्ञानां हुतमुत्तमम्।\nप्रसर्पिणां तु सर्वेषां ज्येष्ठः सर्पो द्विजोत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101518, "chapter_id": 3188, "verse_number": "१४-४४-९", "content_sanskrit": "कृतमादिर्युगानां च सर्वेषां नात्र संशयः।\nहिरण्यं सर्वरत्नानामोषधीनां यवास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2101519, "chapter_id": 3188, "verse_number": "१४-४४-१०", "content_sanskrit": "सर्वेषां भक्ष्यभोज्यानामन्नं परममुच्यते।\nद्रवाणां चैव सर्वेषां पेयानामाप उत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2101520, "chapter_id": 3188, "verse_number": "१४-४४-११", "content_sanskrit": "स्थावराणां तु भूतानां सर्वेषामविशेषतः।\nब्रह्मक्षेत्रं सदा पुण्यं प्लक्षः प्रवरजः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2101521, "chapter_id": 3188, "verse_number": "१४-४४-१२", "content_sanskrit": "अहं प्रजापतीनां च सर्वेषां नात्र संशयः।\nमम विष्णुरचिन्त्यात्मा स्वयंभूरिति संस्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2101522, "chapter_id": 3188, "verse_number": "१४-४४-१३", "content_sanskrit": "पर्वतानां महामेरुः सर्वेषामग्रजः स्मृतः।\nदिशां च प्रदिशां चोर्ध्वं दिक्पूर्वा प्रथमा तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2101523, "chapter_id": 3188, "verse_number": "१४-४४-१४", "content_sanskrit": "तथा त्रिपथगा गङ्गा नदीनामग्रजा स्मृता।\nतथा सरोदपाननां सर्वेषां सागरोऽग्रजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2101524, "chapter_id": 3188, "verse_number": "१४-४४-१५", "content_sanskrit": "देवदानवभूतानां पिशाचोरगरक्षसाम्।\nनरकिन्नरयक्षाणां सर्वेषामीश्वरः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2101525, "chapter_id": 3188, "verse_number": "१४-४४-१६", "content_sanskrit": "आदिर्विश्वस्य जगतो विष्णुर्ब्रह्ममयो महान्।\nततः परतरं यस्मात्त्रैलोक्ये नेह विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2101526, "chapter_id": 3188, "verse_number": "१४-४४-१७", "content_sanskrit": "आश्रमाणां च सर्वेषां गार्हस्थ्यं नात्र संशयः।\nलोकानामादिरव्यक्तं सर्वस्यान्तस्तदेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2101527, "chapter_id": 3188, "verse_number": "१४-४४-१८", "content_sanskrit": "अहान्यस्तमयान्तानि उदयान्ता च शर्वरी।\nसुखस्यान्तं सदा दुःखं दुःखस्यान्तं सदा सुखम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2101528, "chapter_id": 3188, "verse_number": "१४-४४-१९", "content_sanskrit": "सर्वे क्षयान्ता निचयाः पतनान्ताः समुच्छ्रयाः।\nसंयोगाश्च वियोगान्ता मरणान्तं च जीवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2101529, "chapter_id": 3188, "verse_number": "१४-४४-२०", "content_sanskrit": "सर्वं कृतं विनाशान्तं जातस्य मरणं ध्रुवम्।\nअशाश्वतं हि लोकेऽस्मिन्सदा स्थावरजङ्गमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2101530, "chapter_id": 3188, "verse_number": "१४-४४-२१", "content_sanskrit": "इष्टं दत्तं तपोऽधीतं व्रतानि नियमाश्च ये।\nसर्वमेतद्विनाशान्तं ज्ञानस्यान्तो न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2101531, "chapter_id": 3188, "verse_number": "१४-४४-२२", "content_sanskrit": "तस्माज्ज्ञानेन शुद्धेन प्रशान्तात्मा जितेन्द्रियः।\nनिर्ममो निरहंकारो मुच्यते सर्वपाप्मभिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2101532, "chapter_id": 3188, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि चतुश्चत्वारिशोऽध्यायः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]