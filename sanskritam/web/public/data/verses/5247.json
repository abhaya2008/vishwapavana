[{"id": 2199655, "chapter_id": 5247, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2199656, "chapter_id": 5247, "verse_number": "१", "content_sanskrit": "तिलानां कीदृशं दानमथ दीपस्य चैव ह ।\nअन्नानां वाससां चैव भूय एव ब्रवीहि मे\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2199657, "chapter_id": 5247, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2199658, "chapter_id": 5247, "verse_number": "२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nब्राह्मणस्य च संवादं यमस्य च युधिष्ठिर\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2199659, "chapter_id": 5247, "verse_number": "३", "content_sanskrit": "मध्यदेशे महान् ग्रामो ब्राह्मणानां बभूव ह ।\nगङ्गायमुनयोर्मध्ये यामुनस्य गिरेरधः\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2199660, "chapter_id": 5247, "verse_number": "४", "content_sanskrit": "पर्णशालेति विख्यातो रमणीयो नराधिप ।\nविद्वांसस्तत्र भूयिष्ठा ब्राह्मणाश्चावसंस्तदा\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2199661, "chapter_id": 5247, "verse_number": "५", "content_sanskrit": "अथ प्राह यमः कञ्चित् पुरुषं कृष्णवाससम् ।\nरक्ताक्षमूर्ध्वरोमाणं काकजङ्घाक्षिनासिकम्\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2199662, "chapter_id": 5247, "verse_number": "६", "content_sanskrit": "गच्छ त्वं ब्राह्मणग्रामं ततो गत्वा तमानय ।\nअगस्त्यं गोत्रतश्चापि नामतश्चापि शर्मिणम्\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2199663, "chapter_id": 5247, "verse_number": "७", "content_sanskrit": "शमे निविष्टं विद्वांसमध्यापकमनादृतम् ।\nमा चान्यमानयेथास्त्वं सगोत्रं तस्य पार्श्वतः\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2199664, "chapter_id": 5247, "verse_number": "८", "content_sanskrit": "स हि तादृग्गुणस्तेन तुल्योऽध्ययनजन्मना ।\nअपत्येषु तथा वृत्ते समस्तेनैव धीमता ।\nतमानय यथोद्दिष्टं पूजा कार्या हि तस्य मे\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2199665, "chapter_id": 5247, "verse_number": "९", "content_sanskrit": "स गत्वा प्रतिकूलं तच्चकार यमशासनम् ।\nतमाक्रम्यानयामास प्रतिषिद्धो यमेन यः\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2199666, "chapter_id": 5247, "verse_number": "१०", "content_sanskrit": "तस्मै यमः समुत्थाय पूजां कृत्वा च वीर्यवान् ।\nप्रोवाच नीयतामेष सोऽन्य आनीयतामिति\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2199667, "chapter_id": 5247, "verse_number": "११", "content_sanskrit": "एवमुक्ते तु वचने धर्मराजेन स द्विजः ।\nउवाच धर्मराजानं निर्विण्णोऽध्ययनेन वै ।\nयो मे कालो भवेच्छेषस्तं वसेयमिहाच्युत\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2199668, "chapter_id": 5247, "verse_number": "", "content_sanskrit": "यमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2199669, "chapter_id": 5247, "verse_number": "१२", "content_sanskrit": "नाहं कालस्य विहितं प्राप्नोमीह कथञ्चन ।\nयत्कर्म प्रकरोति तं तु जानामि केवलम्\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2199670, "chapter_id": 5247, "verse_number": "१३", "content_sanskrit": "गच्छ विप्र त्वमद्यैव आलयं स्वं महाद्युते ।\nब्रूहि वा त्वं यथा स्वैरं करवाणि किमित्युत\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2199671, "chapter_id": 5247, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2199672, "chapter_id": 5247, "verse_number": "१४", "content_sanskrit": "यत् तत्र कृत्वा सुमहत्पुण्यं स्यात् तद् ब्रवीहि मे ।\nसर्वस्य हि प्रमाणं त्वं त्रैलोक्यस्यापि सत्तम\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2199673, "chapter_id": 5247, "verse_number": "", "content_sanskrit": "यमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2199674, "chapter_id": 5247, "verse_number": "१५", "content_sanskrit": "शृणु तत्त्वेन विप्रर्षे प्रदानविधिमुत्तमम् ।\nतिलाः परमकं दानं पुण्यं चैवेह शाश्वतम्\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2199675, "chapter_id": 5247, "verse_number": "१६", "content_sanskrit": "तिलाश्च सम्प्रदातव्या यथाशक्ति द्विजर्षभ ।\nनित्यदानात् सर्वकामांस्तिला निर्वर्तयन्त्युत\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2199676, "chapter_id": 5247, "verse_number": "१७", "content_sanskrit": "तिलान् श्राद्धे प्रशंसन्ति दानमेतद्ध्यनुत्तमम् ।\nतान् प्रयच्छस्व विप्रेभ्यो विधिदृष्टेन कर्मणा\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2199677, "chapter_id": 5247, "verse_number": "१८", "content_sanskrit": "तिला भक्षयितव्याश्च सदा त्वालभनं च तैः ।\nकार्यं सततमिच्छद्भिः श्रेयः सर्वात्मना गृहे\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2199678, "chapter_id": 5247, "verse_number": "१९", "content_sanskrit": "तथाऽऽपः सर्वदा देयाः पेयाश्चैव न संशयः ।\nपुष्करिण्यस्तडागानि कूपांश्चैवात्र खानयेत्\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2199679, "chapter_id": 5247, "verse_number": "२०", "content_sanskrit": "एतत् सुदुर्लभतरमिह लोके द्विजोत्तम ।\nआपो नित्यं प्रदेयास्ते पुण्यं ह्येतदनुत्तमम्\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2199680, "chapter_id": 5247, "verse_number": "२१", "content_sanskrit": "प्रपाश्च कार्याः पानार्थं नित्यं ते द्विजसत्तम ।\nपुष्करिण्यस्तटाकार्थं नित्यं ते द्विजसत्तम ।\nपानीयाभ्यर्थिनं दृष्ट्वा प्रीत्या दद्यात् त्वरान्वितः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2199681, "chapter_id": 5247, "verse_number": "२२", "content_sanskrit": "तिलतण्डुलप्रदानेन वत्सराणि प्रदायकौ ।\nवस्त्रे तन्तुप्रमाणेन दीपे निमिषवत्सरम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2199682, "chapter_id": 5247, "verse_number": "२३", "content_sanskrit": "गवां रोमप्रमाणेन स्वर्गभोगमुपाश्नुते ।\nजले बिन्दुप्रमाणेन तदेतान्यपवर्जय \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2199683, "chapter_id": 5247, "verse_number": "२४", "content_sanskrit": "भुक्तेऽप्यथ प्रदेयं ते पानीयं वै विशेषतः\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2199684, "chapter_id": 5247, "verse_number": "२५", "content_sanskrit": "इत्युक्ते स तदा तेन यमदूतेन वै गृहान् ।\nनीतश्चकार च तथा सर्वं तद्यमशासनम्\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2199685, "chapter_id": 5247, "verse_number": "२६", "content_sanskrit": "नीत्वा तं यमदूतोऽपि गृहीत्वा शर्मिणं तदा ।\nययौ स धर्मराजाय न्यवेदयत चापि तम्\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2199686, "chapter_id": 5247, "verse_number": "२७", "content_sanskrit": "तं धर्मराजो धर्मज्ञं पूजयित्वा प्रतापवान् ।\nकृत्वा च संविदं तेन विससर्ज यथागतम्\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2199687, "chapter_id": 5247, "verse_number": "२८", "content_sanskrit": "तस्यापि च यमः सर्वमुपदेशं चकार ह ।\nप्रत्येत्य च स तत्सर्वं चकारोक्तं यमेन तत्\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2199688, "chapter_id": 5247, "verse_number": "२९", "content_sanskrit": "तस्मात् दीपाः प्रदातव्या दैवे पित्र्येथ गौर्द्विजे ।\nतथा प्रशंसते दीपान् यमः पितृहितेप्सया ।\nतस्माद् दीपप्रदो नित्यं सन्तारयति वै पितॄन्\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2199689, "chapter_id": 5247, "verse_number": "३०", "content_sanskrit": "दातव्याः सततं दीपास्तस्माद् भरतसत्तम ।\nदेवानां च पितॄणां च चक्षुष्यास्ते मताः प्रभो\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2199690, "chapter_id": 5247, "verse_number": "३१", "content_sanskrit": "रत्नदानं च सुमहत् पुण्यमुक्तं जनाधिप ।\nतानि विक्रीय यजते ब्राह्मणो ह्यभयङ्करः\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2199691, "chapter_id": 5247, "verse_number": "३२", "content_sanskrit": "यद्वै ददाति विप्रेभ्यो ब्राह्मणः प्रतिगृह्य वै ।\nउभयोः स्यात् तदक्षय्यं दातुरादातुरेव च\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2199692, "chapter_id": 5247, "verse_number": "३३", "content_sanskrit": "यो ददाति स्थितः स्थित्यां तादृशाय प्रतिग्रहम् ।\nउभयोरक्षयं धर्मं तं मनुः प्राह धर्मवित्\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2199693, "chapter_id": 5247, "verse_number": "३४", "content_sanskrit": "वाससां तु प्रदानेन स्वदारनिरतो नरः ।\nसुवस्त्रश्च सुवेषश्च भवतीत्यनुशुश्रुम\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2199694, "chapter_id": 5247, "verse_number": "३५", "content_sanskrit": "गावः सुवर्णं च तथा तिलाश्चैवानुवर्णिताः ।\nबहुशः पुरुषव्याघ्र वेदप्रामाण्यदर्शनात्\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2199695, "chapter_id": 5247, "verse_number": "३६", "content_sanskrit": "विवाहांश्चैव कुर्वीत पुत्रानुत्पादयेत च ।\nपुत्रलाभो हि कौरव्य सर्वलाभाद् विशिष्यते\t ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2199696, "chapter_id": 5247, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nअनुशासनपर्वणि दानधर्मे तिलादिदानप्रशंसा नाम अष्टनवतितमोऽध्यायः ॥९८॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]