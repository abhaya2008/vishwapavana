[{"id": 2173924, "chapter_id": 4698, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2173925, "chapter_id": 4698, "verse_number": "१", "content_sanskrit": "अस्य(पश्य)तां यतमानानां शूराणामनिवर्तिनाम् ।\nसङ्कल्पमकरोन्मोघं गाण्डीवेन धनञ्जयः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2173926, "chapter_id": 4698, "verse_number": "२", "content_sanskrit": "इन्द्राशनिसमस्पर्शान् अविषह्यान् मनोजवान् ।\nविसृजन् दृश्यते बाणान् धारा मुञ्चन्निवाम्बुदः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2173927, "chapter_id": 4698, "verse_number": "३", "content_sanskrit": "तत्सैन्यं भरतश्रेष्ठ वध्यमानं किरीटिना ।\nसम्प्रदुद्राव सङ्ग्रामान् तव पुत्रस्य पश्यतः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2173928, "chapter_id": 4698, "verse_number": "४", "content_sanskrit": "हतधुर्यरथाः केचिद्धतसूतास्तथा परे ।\nभग्नाक्षयुगचक्रेषाः केचिदासन् विशाम्पते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2173929, "chapter_id": 4698, "verse_number": "५", "content_sanskrit": "अन्येषां सायकाः क्षीणास्तथाऽन्ये शरपीडिताः ।\nअक्षता युगपत् केचित् प्राद्रवन् भयपीडिताः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2173930, "chapter_id": 4698, "verse_number": "६", "content_sanskrit": "केचित् पुत्रानुपादाय हतभूयिष्ठवाहनाः ।\nविचुक्रुशुः पितॄनन्ये सहायानपरे पुनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2173931, "chapter_id": 4698, "verse_number": "७", "content_sanskrit": "बान्धवांश्च नरव्याघ्र भ्रातॄन् सम्बन्धिनस्तथा ।\nदुद्रुवुः केचिदुत्सृज्य तत्र तत्र विशाम्पते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2173932, "chapter_id": 4698, "verse_number": "८", "content_sanskrit": "बहवोऽत्र भृशं विद्ध्वा मुह्यमाना महारथाः ।\nनष्टसञ्ज्ञाः स्म दृश्यन्ते पार्थबाणहता नराः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2173933, "chapter_id": 4698, "verse_number": "९", "content_sanskrit": "तानन्ये रथमारोप्य समाश्वास्य मुहूर्तकम् ।\nविश्रान्ताश्च वितृष्णाश्च पुनर्युद्धाय जग्मिरे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2173934, "chapter_id": 4698, "verse_number": "१०", "content_sanskrit": "तानपास्य गताः केचित् पुनरेव युयुत्सवः ।\nकुर्वन्तस्तव पुत्रस्य शासनं युद्धदुर्मदाः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2173935, "chapter_id": 4698, "verse_number": "११", "content_sanskrit": "पानीयमपरे पीत्वा समाश्वास्य च वाहनान् ।\nवर्माणि च समारोप्य जग्मुर्भरतसत्तम\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2173936, "chapter_id": 4698, "verse_number": "१२", "content_sanskrit": "समाश्वास्य परे भ्रातॄन् निक्षिप्य शिबिरेऽपि च ।\nपुत्रानन्ये पितॄनन्ये पुनर्युद्धमरोचयन्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2173937, "chapter_id": 4698, "verse_number": "१३", "content_sanskrit": "सज्जयित्वा रथान् केचित् यथामुख्यं विशाम्पते ।\nआप्लुत्य पाण्डवानीकं पुनर्युद्धमरोचयन्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2173938, "chapter_id": 4698, "verse_number": "१४", "content_sanskrit": "ते शूराः किङ्किणीजालैः समाच्छन्ना बभासिरे ।\nत्रैलोक्यसमरे युक्ता यथा दैवतदानवाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2173939, "chapter_id": 4698, "verse_number": "१५", "content_sanskrit": "आगम्य सहसा केचिद् रथैः स्वर्णविभूषितैः ।\nपाण्डवानामनीकेषु धृष्टद्युम्नमयोधयन्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2173940, "chapter_id": 4698, "verse_number": "१६", "content_sanskrit": "धृष्टद्युम्नोऽपि पाञ्चाल्यः शिखण्डी च महारथः ।\nनाकुलिश्च शतानीको रथानीकमयोधयन्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2173941, "chapter_id": 4698, "verse_number": "१७", "content_sanskrit": "पाञ्चाल्यस्तु ततः क्रुद्धः सैन्येन महता वृतः ।\nअभ्यद्रवत् सुसंरब्धान् तावकान् हन्तुमुद्यतः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2173942, "chapter_id": 4698, "verse_number": "१८", "content_sanskrit": "ततस्त्वापततस्तस्य तव पुत्रो जनाधिपः ।\nबाणसङ्घाननेकान् वै प्रेषयामास भारत\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2173943, "chapter_id": 4698, "verse_number": "१९", "content_sanskrit": "धृष्टद्युम्नस्ततो राजन् तव पुत्रेण धन्विना ।\nनाराचैर्बहुभिः क्षिप्रं बाह्वोरुरसि चार्दितः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2173944, "chapter_id": 4698, "verse_number": "२०", "content_sanskrit": "सोऽतिविद्धो महेष्वासः तोत्रार्दित इव द्विपः ।\nतस्याश्वांश्चतुरो बाणैः प्रेषयामास मृत्यवे\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2173945, "chapter_id": 4698, "verse_number": "२१", "content_sanskrit": "सारथेश्चास्य भल्लेन शिरः कायादपाहरत्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2173946, "chapter_id": 4698, "verse_number": "२२", "content_sanskrit": "ततो दुर्योधनो राजा पृष्ठमारुह्य वाजिनः ।\nअपाक्रामद् हतरथो नातिदूरमरिन्दमः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2173947, "chapter_id": 4698, "verse_number": "२३", "content_sanskrit": "दृष्ट्वा तु हतभूयिष्ठं स्वमनीकममर्षणः ।\nतव पुत्रो महाराज प्रययौ यत्र सौबलः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2173948, "chapter_id": 4698, "verse_number": "२४", "content_sanskrit": "ततो रथेषु भग्नेषु त्रिसाहस्रा महाद्विपाः ।\nपाण्डवान् रथिनः पञ्च समन्तात् पर्यवारयन्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2173949, "chapter_id": 4698, "verse_number": "२५", "content_sanskrit": "ते वृताः समरे पञ्च गजानीकेन भारत ।\nअशोभन्त नरव्याघ्रा ग्रहास्तारागणैरिव\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2173950, "chapter_id": 4698, "verse_number": "२६", "content_sanskrit": "ततोऽर्जुनो महाराज लब्धलक्षो महाभुजः ।\nविनिर्ययौ रथेनैव श्वेताश्वः कृष्णसारथिः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2173951, "chapter_id": 4698, "verse_number": "२७", "content_sanskrit": "तैः समन्तात् परिवृतः कुञ्जरैः पर्वतोपमैः ।\nनाराचैर्विर्विधैस्तीक्ष्णैर्गजानीकमयोधयन्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2173952, "chapter_id": 4698, "verse_number": "२८", "content_sanskrit": "तत्रैकबाणनिहतान् अपश्याम महागजान् ।\nपतितान् पात्यमानांश्च प्रभग्नान् सव्यसाचिना\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2173953, "chapter_id": 4698, "verse_number": "२९", "content_sanskrit": "भीमसेनस्तु तान् दृष्ट्वा नागान् वै पर्वतोपमान् ।\nकरेण गृह्य महतीं गदामभ्यद्रवद् बली\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2173954, "chapter_id": 4698, "verse_number": "३०", "content_sanskrit": "अवप्लुत्य रथात् तूर्णं दण्डपाणिरिवान्तकः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2173955, "chapter_id": 4698, "verse_number": "३१", "content_sanskrit": "तमुद्यतगदं दृष्ट्वा पाण्डवानां महारथम् ।\nवित्रेसुस्तावका योधाः शकृन्मूत्रं च सुस्रुवुः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2173956, "chapter_id": 4698, "verse_number": "३२", "content_sanskrit": "आविग्नं च बलं सर्वं गदाहस्ते वृकोदरे\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2173957, "chapter_id": 4698, "verse_number": "३३", "content_sanskrit": "गदया भीमसेनेन भिन्नकुम्भान् कृतव्रणान् ।\nधावमानानपश्याम कुञ्जरान् पर्वतोपमान्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2173958, "chapter_id": 4698, "verse_number": "३४", "content_sanskrit": "प्रधाव्य कुञ्जरास्ते तु भीमसेनगदाहताः ।\nपेतुरार्तस्वरं कृत्वा छिन्नपक्षा इवाद्रयः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2173959, "chapter_id": 4698, "verse_number": "३५", "content_sanskrit": "तान् भिन्नकुम्भास्तु बहून् द्रवमाणानितस्ततः ।\nपतमानांस्तु सम्प्रेक्ष्य वित्रेसुस्तव सैनिकाः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2173960, "chapter_id": 4698, "verse_number": "३६", "content_sanskrit": "युधिष्ठिरोऽपि सङ्क्रुद्धो माद्रीपुत्रौ च पाण्डवौ ।\nगार्ध्र(पत्रै)पक्षैः शितैर्बाणैर्जघ्नुर्वै गजयोधिनः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2173961, "chapter_id": 4698, "verse_number": "३७", "content_sanskrit": "धृष्टद्युम्नस्तु समरे पराजित्य नराधिपम् ।\nअपक्रान्ते तव सुते हयपृष्ठं समाश्रिते\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2173962, "chapter_id": 4698, "verse_number": "३८", "content_sanskrit": "दृष्ट्वा च पाण्डवान् सर्वान् कुञ्जरैः परिवारितान् ।\nधृष्टद्युम्नो महाराज सह सर्वैः प्रभद्रकैः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2173963, "chapter_id": 4698, "verse_number": "३९", "content_sanskrit": "पुत्रः पाञ्चालराजस्य जिघांसुः कौरवान् ययौ\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2173964, "chapter_id": 4698, "verse_number": "४०", "content_sanskrit": "अदृष्ट्वा तु रथानीके दुर्योधनमरिन्दमम् ।\nअश्वत्थामा कृपश्चैव कृतवर्मा च सात्वतः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2173965, "chapter_id": 4698, "verse_number": "४१", "content_sanskrit": "अपृच्छन् क्षत्रियांस्तत्र क्व नो दुर्योधनो गतः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2173966, "chapter_id": 4698, "verse_number": "४२", "content_sanskrit": "अपश्यमाना राजानं वर्तमाने जनक्षये\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2173967, "chapter_id": 4698, "verse_number": "४३", "content_sanskrit": "मन्वाना निहतं तत्र तव पुत्रं महारथाः ।\nविषण्णवदना भूत्वा पर्यपृच्छन्त ते सुतम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2173968, "chapter_id": 4698, "verse_number": "४४", "content_sanskrit": "आहुः केचिद्धते सूते प्रयातो यत्र सौबलः ।\nहित्वा पाञ्चालराजस्य तदनीकं दुरुत्सहम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2173969, "chapter_id": 4698, "verse_number": "४५", "content_sanskrit": "अपरे त्वब्रुवंस्तत्र क्षत्रिया भृशविक्षताः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2173970, "chapter_id": 4698, "verse_number": "", "content_sanskrit": "क्षत्रियाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2173971, "chapter_id": 4698, "verse_number": "४६", "content_sanskrit": "दुर्योधनेन किं कार्यं द्रक्ष्यध्वं यदि जीवति ।\nयुध्यध्वं सहिताः सर्वे किं वा राजा करिष्यति\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2173972, "chapter_id": 4698, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2173973, "chapter_id": 4698, "verse_number": "४७", "content_sanskrit": "ते क्षत्रियाः क्षतैर्गात्रैः हतभूयिष्ठवाहनाः ।\nशरैः सम्पीड्यमानाश्च नातिव्यक्तमिवाब्रुवन्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2173974, "chapter_id": 4698, "verse_number": "", "content_sanskrit": "क्षत्रियाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2173975, "chapter_id": 4698, "verse_number": "४८", "content_sanskrit": "इदं सर्वं बलं हन्मो येन स्म परिवारिताः ।\nएते सर्वे गजान् हत्वा उपयान्ति स्म पाण्डवाः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2173976, "chapter_id": 4698, "verse_number": "४९", "content_sanskrit": "श्रुत्वा तु वचनं तेषामश्वत्थामा महाबलः ।\nभित्त्वा पाञ्चालराजस्य तदनीकं दुरासदम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2173977, "chapter_id": 4698, "verse_number": "५०", "content_sanskrit": "कृपश्च कृतवर्मा च प्रययुर्यत्र सौबलः ।\nरथानीकं परित्यज्य शूराः सुदृढधन्विनः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2173978, "chapter_id": 4698, "verse_number": "५१", "content_sanskrit": "ततस्तेषु प्रयातेषु धृष्टद्युम्नपुरस्कृताः ।\nआययुः पाण्डवा राजन् विनिघ्नन्तश्च तावकान्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2173979, "chapter_id": 4698, "verse_number": "५२", "content_sanskrit": "दृष्ट्वा तु तानापततः सम्प्रहृष्टान् महारथान् ।\nपराक्रान्तांस्ततो दृष्ट्वा निराशा जीवितेऽभवन्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2173980, "chapter_id": 4698, "verse_number": "५३", "content_sanskrit": "विवर्णमुखभूयिष्ठमभवत् तावकं बलम्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2173981, "chapter_id": 4698, "verse_number": "५४", "content_sanskrit": "परिक्षीणायुधान् दृष्ट्वा तानहं परिवारितान् ।\nराजन् बलेन त्र्यङ्गेन त्यक्त्वा जीवितमात्मनः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2173982, "chapter_id": 4698, "verse_number": "५५", "content_sanskrit": "आत्मना पञ्चमोऽयुध्यं पाञ्चालस्य महाबलम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2173983, "chapter_id": 4698, "verse_number": "५६", "content_sanskrit": "तस्मिन् देशे व्यवस्थाप्य तत्र शारद्वतः स्थितः ।\nप्रदुद्रुवुः तदा योधाः किरीटिशरपीडिताः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2173984, "chapter_id": 4698, "verse_number": "५७", "content_sanskrit": "धृष्टद्युम्नस्य चानीके तत्र नोऽभूद् रणो महान् ।\nनिर्जितास्ते वयं सर्वे व्यपयाता रणात् ततः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2173985, "chapter_id": 4698, "verse_number": "५८", "content_sanskrit": "अथापश्यं सात्यकिं तमुपयान्तं महारथम् ।\nरथैश्चतुःशतैर्वीरो मां चाभ्यद्रवदाहवे\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2173986, "chapter_id": 4698, "verse_number": "५९", "content_sanskrit": "धृष्टद्युम्नादहं मुक्तः कथञ्चिच्छ्रान्तवाहनः ।\nपतितो माधवानीके दुष्कृती नरके यथा\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2173987, "chapter_id": 4698, "verse_number": "६०", "content_sanskrit": "तत्र युद्धमभूद् घोरं मुहूर्तमतिदारुणम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2173988, "chapter_id": 4698, "verse_number": "६१", "content_sanskrit": "सात्यकिस्तु महाबाहुर्मम हत्वा परिच्छदम् ।\nजीवग्राहमगृह्णान्मां मूर्च्छितं पतितं भुवि\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2173989, "chapter_id": 4698, "verse_number": "६२", "content_sanskrit": "तदा मुहूर्तादेवाथ गजानीकमवध्यत ।\nगदया भीमसेनेन नाराचैरर्जुनेन च\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2173990, "chapter_id": 4698, "verse_number": "६३", "content_sanskrit": "अभिपिष्टैर्महानागैः समन्तात् पर्वतोपमैः ।\nनातिप्रसिद्धैव गतिः पाण्डवानामजायत\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2173991, "chapter_id": 4698, "verse_number": "६४", "content_sanskrit": "रथमार्गं ततश्चक्रे भीमसेनो महाबलः ।\nपाण्डवानां महाराज व्यपकर्षन् महागजान्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2173992, "chapter_id": 4698, "verse_number": "६५", "content_sanskrit": "अश्वत्थामा कृपश्चैव कृतवर्मा च सात्वतः ।\nअपश्यन्तो गजानीके दुर्योधनमरिन्दमम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2173993, "chapter_id": 4698, "verse_number": "६६", "content_sanskrit": "राजानं मृगयामासुः तव पुत्रं महारथम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2173994, "chapter_id": 4698, "verse_number": "६७", "content_sanskrit": "परित्यज्य च पाञ्चाल्यं प्रयाता यत्र सौबलः ।\nराज्ञोऽदर्शनसंविग्ना वर्तमाने जनक्षये\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2173995, "chapter_id": 4698, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशल्यपर्वणि सञ्जयजीवग्रहणं नाम पञ्चविंशोऽध्यायः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2173996, "chapter_id": 4698, "verse_number": "", "content_sanskrit": "शल्यवधपर्वणि पञ्चविंशोऽध्यायः ॥२५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]