[{"id": 2095847, "chapter_id": 3046, "verse_number": "१३-१७६-१", "content_sanskrit": "वैशम्पायन उवाच।\nततो युधिष्ठिरो राजा शरतल्पे पितामहम्।\nपुनरेव महाराज पप्रच्छ वदतांवरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2095848, "chapter_id": 3046, "verse_number": "१३-१७६-२x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2095849, "chapter_id": 3046, "verse_number": "१३-१७६-२", "content_sanskrit": "ऋषयो ब्राह्मणा देवाः प्रशंसन्ति महामते।\nअहिंसालक्षणं धर्मं वेदप्रामाण्यदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2095850, "chapter_id": 3046, "verse_number": "१३-१७६-३", "content_sanskrit": "कर्मणा न नरः कुर्वन्हिंसां पार्थिवसत्तम।\nवाचा च मनसा चैवं ततो दुःखात्प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2095851, "chapter_id": 3046, "verse_number": "१३-१७६-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2095852, "chapter_id": 3046, "verse_number": "१३-१७६-४", "content_sanskrit": "चतुर्विधेयं निर्दिष्टा ह्यहिंसा ब्रह्मवादिभिः।\nएकैकतोऽपि विभ्रष्टा न भवत्यरिसूदन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2095853, "chapter_id": 3046, "verse_number": "१३-१७६-५", "content_sanskrit": "यथा सर्वश्चतुष्पाद्वै त्रिभिः पादैर्न तिष्ठति।\nतथैवेयं महीपाल कारणैः प्रोच्यते त्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2095854, "chapter_id": 3046, "verse_number": "१३-१७६-६", "content_sanskrit": "यथा नागपदेऽन्यानि पदानि पदगामिनाम्।\nसर्वाण्येवापिधीयन्ते पदजातानि कौञ्जरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2095855, "chapter_id": 3046, "verse_number": "१३-१७६-७", "content_sanskrit": "एवं लोकेष्वहिंसा तु निर्दिष्टा धर्मतः पुरा।\nकर्म्णा लिप्यते जन्तुर्वाचा च मनसाऽपि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2095856, "chapter_id": 3046, "verse_number": "१३-१७६-८", "content_sanskrit": "पूर्वं तु मनसा त्यक्त्वा त्यजेद्वाचाऽथ कर्मणा।\n`हिंसां तु नोपयुञ्जीत तथा हिंसा चतुर्विधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2095857, "chapter_id": 3046, "verse_number": "१३-१७६-९", "content_sanskrit": "काये मनसि वाक्येऽपि दोषा ह्येते प्रकीर्तिताः।\n[न भक्षयति यो मांसं त्रिविधं स विमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2095858, "chapter_id": 3046, "verse_number": "१३-१७६-१०", "content_sanskrit": "त्रिकारणं तु निर्दिष्टं श्रूयते ब्रह्मवादिभिः।\nमनो वाचि तथाऽऽस्वादे दोषा ह्येषु प्रतिष्ठिताः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2095859, "chapter_id": 3046, "verse_number": "१३-१७६-११", "content_sanskrit": "न भक्षयन्त्यतो मांसं तपोयुक्ता मनीषिणः।\nदोषांस्तु भक्षणे राजन्मांसस्येह निबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2095860, "chapter_id": 3046, "verse_number": "१३-१७६-१२", "content_sanskrit": "पुत्र मांसोपमं जानन्खादते यो विचेतनः।\nमांसं मोहसमायुक्तः पुरुषः सोऽधमः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2095861, "chapter_id": 3046, "verse_number": "१३-१७६-१३", "content_sanskrit": "पितृमातृसमायोगे पुत्रत्वं जायते यथा।\nहिंसां कृत्वाऽवशः पापो भूयिष्ठं जायते तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2095862, "chapter_id": 3046, "verse_number": "१३-१७६-१४", "content_sanskrit": "रसश्च हृदि जिह्वाया ज्ञानं प्रज्ञायते यथा।\nतथा शास्त्रेषु नियतं रागो ह्यास्वादिताद्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2095863, "chapter_id": 3046, "verse_number": "१३-१७६-१५", "content_sanskrit": "संस्कृतासंस्कृताः पक्वा लवणालवणास्तथा।\nप्रजायन्ते यथा भावास्तथा चित्तं निरुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2095864, "chapter_id": 3046, "verse_number": "१३-१७६-१६", "content_sanskrit": "भेरीमृदङ्गशब्दांश्च तन्त्रीशब्दांश्च पुष्कलान्।\nनिषेविष्यन्ति वै मन्दा मांसभक्षाः कथं नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2095865, "chapter_id": 3046, "verse_number": "१३-१७६-१७", "content_sanskrit": "`परेषां धनधान्यानां हिसकाः स्तावकास्तथा।\nप्रशंसकाश्च मांसस्य नित्यं स्वर्गे बहिष्कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2095866, "chapter_id": 3046, "verse_number": "१३-१७६-१८", "content_sanskrit": "अचिन्तितमनिर्दिष्टमसङ्कल्पितमेव च।\nरसगृद्ध्याऽभिभूता ये प्रशंसन्ति फलार्थिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2095867, "chapter_id": 3046, "verse_number": "१३-१७६-१९", "content_sanskrit": "प्रशंसा ह्येव मांसस्य दोषकल्पफलान्विता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2095868, "chapter_id": 3046, "verse_number": "१३-१७६-२०", "content_sanskrit": "`भस्म विष्ठा कृमिर्वाऽपि निष्ठा यस्येदृशी ध्रुवा।\nस कायः परपीडाभिः कथं धार्योविपश्चिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2095869, "chapter_id": 3046, "verse_number": "१३-१७६-२१", "content_sanskrit": "जीवितं हि परित्यज्य बहवः साधवो जनाः।\nस्वमांसैः परमांसानि परिपाल्य दिवं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2095870, "chapter_id": 3046, "verse_number": "१३-१७६-२२", "content_sanskrit": "एवमेषा महाराज चतुर्भिः कारणैः स्मृता।\nअहिंसा तव निर्दिष्टा सर्वधर्मानुसंहिता॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2095871, "chapter_id": 3046, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि षट्सप्तत्यधिकशततमोऽध्यायः॥ १७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]