[{"id": 2067692, "chapter_id": 2423, "verse_number": "९-४१-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2067693, "chapter_id": 2423, "verse_number": "९-४१-१", "content_sanskrit": "आर्ष्टिषेणस्तथा ब्रह्मन्विपुलं तप्तवांस्तपः।\nसिन्धुद्वीपः कथं चापि ब्राह्मण्यं लब्धवांस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2067694, "chapter_id": 2423, "verse_number": "९-४१-२", "content_sanskrit": "देवापिश्च कथं ब्रह्मन्विश्वामित्रश्च सत्तम।\nतन्ममाचक्ष्व भगवन्परं कौतूहलं हि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2067695, "chapter_id": 2423, "verse_number": "९-४१-३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2067696, "chapter_id": 2423, "verse_number": "९-४१-३", "content_sanskrit": "पुरा कृतयुगे राजन्नार्ष्टिषेणो द्विजोत्तमः।\nवसन्गुरुकुले नित्यं नित्यमध्ययने रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2067697, "chapter_id": 2423, "verse_number": "९-४१-४", "content_sanskrit": "तस्य राजन्गुरुकुले वसतो नित्यमेव च।\nसमाप्तिं नागमद्विद्या नापि वेदा विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2067698, "chapter_id": 2423, "verse_number": "९-४१-५", "content_sanskrit": "स निर्विण्णस्ततो राजंस्तपस्तेपे महातपाः।\nततो वै तपसा तेन प्राप्य वेदाननुत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2067699, "chapter_id": 2423, "verse_number": "९-४१-६", "content_sanskrit": "स विद्वान्वेदयुक्तश्च सिद्धश्चाप्यृषिसत्तमः।\nतत्र तीर्थे वरान्प्रादात्त्रीनेव सुमहातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2067700, "chapter_id": 2423, "verse_number": "९-४१-७", "content_sanskrit": "अस्मिंस्तीर्थे महानद्या अद्यप्रभृति मानवः।\nआप्लुतो वाजिमेधस्य फलं प्राप्स्यति पुष्कलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2067701, "chapter_id": 2423, "verse_number": "९-४१-८", "content_sanskrit": "अद्यप्रभृति नैवात्र भयं व्यालाद्भविष्यति।\nअपि चाल्पेन कालेन फलं प्राप्स्यति पुष्कलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2067702, "chapter_id": 2423, "verse_number": "९-४१-९", "content_sanskrit": "एवमुक्त्वा महातेजा जगाम त्रिदिवं मुनिः।\nएवं सिद्वः स भगवानार्ष्टिषेणः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2067703, "chapter_id": 2423, "verse_number": "९-४१-१०", "content_sanskrit": "तस्मिन्नेव तदा तीर्थे सिन्धुद्वीपः प्रतापवान्।\nदेवापिश्च महाराज ब्राह्मण्यं प्रापतुर्महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2067704, "chapter_id": 2423, "verse_number": "९-४१-११", "content_sanskrit": "तथाच कौशिकस्तात तपोनित्यो जितेन्द्रियः।\nतपसा वै सुतप्तेन ब्राह्मणत्वमवाप्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2067705, "chapter_id": 2423, "verse_number": "९-४१-१२", "content_sanskrit": "गाधिर्नाम महानासीत्क्षत्रियः प्रथितो भुवि।\nतस्य पुत्रोऽभवद्राजन्विश्वामित्रः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2067706, "chapter_id": 2423, "verse_number": "९-४१-१३", "content_sanskrit": "स राजा कौशिकस्तात महायोग्यभवत्किल।\nस पुत्रमभिषिच्याथ विश्वामित्रं महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2067707, "chapter_id": 2423, "verse_number": "९-४१-१४", "content_sanskrit": "देहन्यासे मनश्चक्रे तमूचुः प्रणताः प्रजाः।\nन गन्तव्यं महाप्राज्ञ त्राहि चास्मान्महाभयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2067708, "chapter_id": 2423, "verse_number": "९-४१-१५", "content_sanskrit": "एवमुक्तः प्रत्युवाच ततो गाधिः प्रजास्ततः।\nविश्वस्य जगतो गोप्ता भविष्यति सुतो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2067709, "chapter_id": 2423, "verse_number": "९-४१-१६", "content_sanskrit": "इत्युक्त्वा तु ततो गाधिर्विश्वामित्रं निवेश्य च।\nजगाम त्रिदिवं राजन्विश्वामित्रोऽभवन्नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2067710, "chapter_id": 2423, "verse_number": "९-४१-१७", "content_sanskrit": "न स शक्नोति पृथिवीं यत्नवानपि रक्षितुम्।\nततः शुश्राव राजा स राक्षसेभ्यो महाभयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2067711, "chapter_id": 2423, "verse_number": "९-४१-१८", "content_sanskrit": "निर्ययौ नगराच्चापि चतुरङ्गबलान्वितः।\nस गत्वा दूरमध्वानं वसिष्ठाश्रममभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2067712, "chapter_id": 2423, "verse_number": "९-४१-१९", "content_sanskrit": "तस्य ते सैनिका राजंश्चक्रुस्तत्रानयान्बहून्।\nततस्तु भगवान्विप्रो वसिष्ठो श्रममभ्ययात्।\nददृशेऽथ ततः सर्वं भज्यमानं महाव्रनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2067713, "chapter_id": 2423, "verse_number": "९-४१-२०", "content_sanskrit": "तस्य क्रुद्धो महाराज वसिष्ठो मुनिसत्तमः।\nसृजस्व शबरान्घोरानिति स्वां गामुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2067714, "chapter_id": 2423, "verse_number": "९-४१-२१", "content_sanskrit": "तथोक्ता साऽसृजद्धेनुः पुरुषान्घोरदर्शनान्।\nते तु तद्बलमासाद्य बभञ्जुः सर्वतोदिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2067715, "chapter_id": 2423, "verse_number": "९-४१-२२", "content_sanskrit": "तच्छ्रुत्वा विद्रुतं सैन्यं विश्वामित्रस्तु गाधिजः।\nतपः परं मन्यमानस्तपस्येव मनो दधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2067716, "chapter_id": 2423, "verse_number": "९-४१-२३", "content_sanskrit": "सोऽस्मिंस्तीर्थवरे राजन्सरस्वत्याः समाहितः।\nनियमैश्चोपवासैश्च कर्शयन्देहमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2067717, "chapter_id": 2423, "verse_number": "९-४१-२४", "content_sanskrit": "जलाहारो वायुभक्षः पर्णाहारश्च सोऽभवत्।\nतथा स्थण्डिलशायी च ये चान्ये नियमाःपृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2067718, "chapter_id": 2423, "verse_number": "९-४१-२५", "content_sanskrit": "असकृत्तस्य देवास्तु व्रतविघ्नं प्रचक्रिरे।\nन चास्य नियमाद्बुद्धिरपयाति महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2067719, "chapter_id": 2423, "verse_number": "९-४१-२६", "content_sanskrit": "ततः परेण यत्नेन तप्त्वा बहुविधं तपः।\nतेजसा भास्कराकारो गाधिजः समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2067720, "chapter_id": 2423, "verse_number": "९-४१-२७", "content_sanskrit": "तपसा तु तथायुक्तं विश्वामित्रं पितामहः।\nअमन्यत महातेजा वरदोऽदर्शयत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2067721, "chapter_id": 2423, "verse_number": "९-४१-२८", "content_sanskrit": "स तु वव्रे वरं राजन्स्यामहं ब्राह्मणस्त्विति।\nतथेति चाब्रवीद्ब्रह्मा सर्वलोकपितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2067722, "chapter_id": 2423, "verse_number": "९-४१-२९", "content_sanskrit": "स लब्ध्वा तपसोग्रेण ब्राह्मणत्वं महायशाः।\nविचचार महीं कृत्स्नां कृतकामः सुरोपमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2067723, "chapter_id": 2423, "verse_number": "९-४१-३०", "content_sanskrit": "तस्मिंस्तीर्थवरे रामः प्रदाय विविधं वसु।\nपयस्विनीस्तथा धेनूर्यानानि शयनानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2067724, "chapter_id": 2423, "verse_number": "९-४१-३१", "content_sanskrit": "अथ वस्त्राण्यलङ्कारं भक्ष्यं पेयं च शोभनम्।\nअददन्मुदितो राजन्पूजयित्वा द्विजोत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2067725, "chapter_id": 2423, "verse_number": "९-४१-३२", "content_sanskrit": "ययौ राजंस्ततो रामो बकस्याश्रममन्तिकात्।\nयत्र तेपे तपस्तीव्रं दाल्भ्यो बक इति श्रुतिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2067726, "chapter_id": 2423, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि ह्रदप्रवेशपर्वणि एकचत्वारिंशोऽध्यायः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]