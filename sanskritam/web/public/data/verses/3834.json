[{"id": 2131333, "chapter_id": 3834, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2131334, "chapter_id": 3834, "verse_number": "१", "content_sanskrit": "ततोऽहं स्तूयमानस्तु तत्र तत्र महर्षिभिः ।\nअपश्यमुदधिं भीममपां पतिमथाव्ययम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2131335, "chapter_id": 3834, "verse_number": "२", "content_sanskrit": "फेनवत्यः प्रकीर्णाश्च संहताश्च समुत्थिताः ।\nऊर्मयश्चात्र दृश्यन्ते वल्गन्त इव पर्वताः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2131336, "chapter_id": 3834, "verse_number": "३", "content_sanskrit": "नावः सहस्रशस्तत्र रत्नपूर्णाः समन्ततः ।\nनभसीव विमानानि विचरन्त्यो विरेजिरे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2131337, "chapter_id": 3834, "verse_number": "४", "content_sanskrit": "तिमिङ्गिलाः कच्छपाश्च तथा तिमितिमिङ्गिलाः ।\nमकराश्चात्र दृश्यन्ते जले मग्ना इवाद्रयः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2131338, "chapter_id": 3834, "verse_number": "५", "content_sanskrit": "शङ्खानां च सहस्राणि मग्नान्यप्सु समन्ततः ।\nदृश्यन्ते स्म यथा रात्रौ तारास्तन्वभ्रसंवृताः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2131339, "chapter_id": 3834, "verse_number": "६", "content_sanskrit": "तथा सहस्रशस्तत्र रत्नसङ्घाः प्लवन्त्युत ।\nवायुश्च घूर्णते भीमस्तदद्भुतमिवाभवत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2131340, "chapter_id": 3834, "verse_number": "७", "content_sanskrit": "तमुदीक्ष्य महावेगं सर्वाम्भोनिधिमुत्तमम् ।\nअपश्यं दानवाकीर्णं तद् दैत्यपुरमन्तिकात्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2131341, "chapter_id": 3834, "verse_number": "८", "content_sanskrit": "तत्रैव मातलिस्तूर्णं निपत्य पृथिवीतळे ।\nत्रासयन् रथघोषेण तत्पुरं समुपाद्रवत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2131342, "chapter_id": 3834, "verse_number": "९", "content_sanskrit": "रथघोषं तु तं श्रुत्वा स्तनयित्नोरिवाम्बरे ।\nमन्वाना देवराजं मामाविग्ना दानवाभवन्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2131343, "chapter_id": 3834, "verse_number": "१०", "content_sanskrit": "सर्वे सम्भ्रान्तमनसः शरचापधराः स्थिताः ।\nतथासिशूलपरशुगदामुसलपाणयः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2131344, "chapter_id": 3834, "verse_number": "११", "content_sanskrit": "ततो द्वाराणि पिदधुर्दानवास्त्रस्तचेतसः ।\nसंविधाय पुरे रक्षां न स्म कश्चन दृश्यते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2131345, "chapter_id": 3834, "verse_number": "१२", "content_sanskrit": "ततः शङ्खमुपादाय देवदत्तं महास्वनम् ।\nपरमां मुदमाश्रित्य प्राधमं तं शनैरहम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2131346, "chapter_id": 3834, "verse_number": "१३", "content_sanskrit": "स तु शब्दो दिवं स्तब्ध्वा प्रतिशब्दमजीजनत् ।\nवित्रेसुश्च निलिल्युश्च भूतानि सुमहान्त्यपि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2131347, "chapter_id": 3834, "verse_number": "१४", "content_sanskrit": "ततो निवातकवचाः सर्व एव स्वलङ्कृताः ।\nदंसिता विविधैस्त्राणैर्विचित्रायुधपाणयः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2131348, "chapter_id": 3834, "verse_number": "१५", "content_sanskrit": "आयसैश्च महाशूलैर्गदाभिर्मुसलैरपि ।\nपट्टिसैः करवाळैश्च रथचक्रैश्च भारत\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2131349, "chapter_id": 3834, "verse_number": "१६", "content_sanskrit": "शतघ्नीभिर्भुशुण्डीभिः खड्गैश्चित्रैः स्वलङ्कृतैः ।\nप्रगृहीतैर्दितेः पुत्राः प्रादुरासन् सहस्रशः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2131350, "chapter_id": 3834, "verse_number": "१७", "content_sanskrit": "ततो वेगेन महता दानवा मामुपाद्रवन् ।\nविमुञ्चन्तः शितान् बाणान् शतशोऽथ सहस्रशः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2131351, "chapter_id": 3834, "verse_number": "१८", "content_sanskrit": "ततो विचार्य बहुशो रथमार्गेषु तान् हयान् ।\nप्राचोदयत् समे देशे मातलिर्भरतर्षभ\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2131352, "chapter_id": 3834, "verse_number": "१९", "content_sanskrit": "तेन तेषां प्रणुन्नानामाशुत्वाच्छीघ्रगामिनाम् ।\nनान्वपश्यं तदा किञ्चित् तन्मेऽद्भुतमिवाभवत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2131353, "chapter_id": 3834, "verse_number": "२०", "content_sanskrit": "ततस्ते दानवास्तत्र वादित्राणि सहस्रशः ।\nविकृतस्वररूपाणि भृशं सर्वाण्यनादयन्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2131354, "chapter_id": 3834, "verse_number": "२१", "content_sanskrit": "तेन शब्देन सहसा समुद्रे पर्वतोपमाः ।\nआप्लवन्त गतैः सत्त्वैर्मत्स्याः शतसहस्रशः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2131355, "chapter_id": 3834, "verse_number": "२२", "content_sanskrit": "स सम्प्रहारस्तुमुलस्तेषां च मम भारत ।\nअवर्तत महाघोरो निवातकवचान्तकः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2131356, "chapter_id": 3834, "verse_number": "२३", "content_sanskrit": "ततो देवर्षयश्चैव तथान्ये च महर्षयः ।\nब्रह्मर्षयश्च सिद्धाश्च समाजग्मुर्महामृधे \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2131357, "chapter_id": 3834, "verse_number": "२४", "content_sanskrit": "ते वै मामनुरूपाभिर्मधुराभिर्जयैषिणः ।\nअस्तुवन् मुनयो वाग्भिर्यथेन्द्रं तारकामये\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2131358, "chapter_id": 3834, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि निवातकवचयुद्धपर्वणि युद्धारम्भे चतुष्षष्ट्यधिकशततमोऽध्यायः ॥ १६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2131359, "chapter_id": 3834, "verse_number": "", "content_sanskrit": "यक्षयुद्धपर्वणि एकादशोऽध्यायः ॥११॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]