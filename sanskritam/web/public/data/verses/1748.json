[{"id": 2034703, "chapter_id": 1748, "verse_number": "४-७१-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2034704, "chapter_id": 1748, "verse_number": "४-७१-१", "content_sanskrit": "युद्धं तु मानुषं द्रष्टुमागतास्त्रिदशाः पुरा।\nकिमकुर्वन्त ते पश्चात्कथयस्व ममानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2034705, "chapter_id": 1748, "verse_number": "४-७१-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2034706, "chapter_id": 1748, "verse_number": "४-७१-२", "content_sanskrit": "वासवप्रमुखाः सर्वे देवाः सर्षिपुरोगमाः।\nयक्षगन्धर्वसङ्घाश्च गणा अप्सरसां तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2034707, "chapter_id": 1748, "verse_number": "४-७१-३", "content_sanskrit": "युद्धं तु मानुषं दृष्ट्वा कुरूणां फल्गुनस्य च।\nएकस्य च बहूनां च रौद्रमत्युग्रदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2034708, "chapter_id": 1748, "verse_number": "४-७१-४", "content_sanskrit": "अस्त्राणामथ दिव्यानां प्रयोगानथ संग्रहान्।\nलघु सुष्ठु च चित्रं च कृतीनां च प्रयत्नतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2034709, "chapter_id": 1748, "verse_number": "४-७१-५", "content_sanskrit": "भीष्मं शारद्वतं द्रोणं कर्णं गाण्डीवधन्वना।\nजितानन्यान्भूमिपालान्दृष्ट्वा जग्मुर्दिवौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2034710, "chapter_id": 1748, "verse_number": "४-७१-६", "content_sanskrit": "सर्वे ते परितुष्टाश्च प्रशस्य च मुहुर्मुहुः।\nअसङ्गतिना तेन विमानेनाशुगामिना।\nप्रतिजग्मुरसङ्गास्ते त्रिदिवं च दिवौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2034711, "chapter_id": 1748, "verse_number": "४-७१-७", "content_sanskrit": "[*कुरवो निर्जिताः सर्वे भीष्मद्रोणकृपादयः।\nअजय्यास्त्रिदशैः सर्वैः सेन्द्रैः सर्वैः सुरासुरैः ।\nपार्थेनैकेन संग्रामे विस्मयो नो महानहो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2034712, "chapter_id": 1748, "verse_number": "४-७१-८", "content_sanskrit": "कस्मिन्मुहूर्ते संजातः कस्य धर्मस्य वा फलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2034713, "chapter_id": 1748, "verse_number": "४-७१-९", "content_sanskrit": "किमाश्चर्यं फल्गुनेऽस्मिन्यो रुद्रेण न्ययोधयत्।\nनिवातकवचानाजौ यस्त्रिंशत्कोटिसंमितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2034714, "chapter_id": 1748, "verse_number": "४-७१-१०", "content_sanskrit": "तस्य चैतत्किमाश्चर्यं स्तुवन्त इति ते सुराः ।\nजग्मुः सुरालयं हृष्टा विस्मयाविष्टचेतसः ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2034715, "chapter_id": 1748, "verse_number": "४-७१-११", "content_sanskrit": "कुरवोऽर्जुनबाणैश्च ताडिताः शरविक्षताः ।\nकुरूनभिमुखां याताः समग्रबलवाहनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2034716, "chapter_id": 1748, "verse_number": "४-७१-१२", "content_sanskrit": "विराटनगराच्चैव गजाश्वरथसंकुलाः ।\nयोधैः क्षत्रियदायादैर्बलवद्भिरधिष्ठिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2034717, "chapter_id": 1748, "verse_number": "४-७१-१३", "content_sanskrit": "विराटप्रहिता सेना नगराच्छीघ्रयायिनी ।\nउत्तरं सह सूतेन प्रत्ययात्तमरिन्दमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2034718, "chapter_id": 1748, "verse_number": "४-७१-१४", "content_sanskrit": "तस्मिंस्तूर्यशताकीर्णे हस्त्यश्चरथसंकुले ।\nप्रहर्षः स्त्रीकुमाराणां तुमुलः समपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2034719, "chapter_id": 1748, "verse_number": "४-७१-१५", "content_sanskrit": "अर्जुनस्तु ततो दृष्ट्वा सैन्यरेणुं समुत्थितम् ।\nसैन्यध्वजं निशम्याथ वैराटिं समभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2034720, "chapter_id": 1748, "verse_number": "४-७१-१६", "content_sanskrit": "नगरे तुमुलः शब्दो रेणुश्चाक्रमते नभः।\nकिंनु खल्वपयातास्ते कुरवो नगरं गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2034721, "chapter_id": 1748, "verse_number": "४-७१-१७", "content_sanskrit": "ते चैव निर्जिताऽस्माभिर्महेष्वासाः सुतेजसः ।\nआमुञ्च कवचं वीर चोदयस्व च वाजिनः ।\nजवेनाभिप्रपद्यस्व विराटनगरं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2034722, "chapter_id": 1748, "verse_number": "४-७१-१८", "content_sanskrit": "न तावत्तलनिर्घोषं गाण्डीवस्य च निस्वनम् ।\nध्वजं वा दर्शयिष्यामि अथवा स्वजनो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2034723, "chapter_id": 1748, "verse_number": "४-७१-१९x", "content_sanskrit": "उत्तर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2034724, "chapter_id": 1748, "verse_number": "४-७१-१९", "content_sanskrit": "सेनाग्रमेतन्मात्स्यानां गणिकाश्च स्वलंकृताः।\nकन्या रथेषु दृश्यन्ते योधा विविधवाससः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2034725, "chapter_id": 1748, "verse_number": "४-७१-२०", "content_sanskrit": "उत्तरामत्र पश्यामि सखीभिः परिवारिताम्।\nअनीकिन्यः प्रदृश्यन्ते हस्तिनोश्वाश्च वर्मिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2034726, "chapter_id": 1748, "verse_number": "४-७१-२१", "content_sanskrit": "रथिनश्च पदाताश्च बहवो न च शस्त्रिणः।\nविराटवचनात्सर्वे संहृष्टाः प्रतिभान्ति मे।\nन च मेऽत्र प्रतीघातश्चित्तस्य स्वजने यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2034727, "chapter_id": 1748, "verse_number": "४-७१-२२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2034728, "chapter_id": 1748, "verse_number": "४-७१-२२", "content_sanskrit": "ततः शीघ्रं समासाद्य उत्तरं स्वजनो बहु।\nपरस्परममित्रघ्नं सस्वजे तं समागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2034729, "chapter_id": 1748, "verse_number": "४-७१-२३x", "content_sanskrit": "जना ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2034730, "chapter_id": 1748, "verse_number": "४-७१-२३", "content_sanskrit": "प्रीतिमान्पुरुषव्याघ्रो हर्षयुक्तः पुनः पुनः ।\nदिष्ट्या जयसि भद्रं ते दिष्ट्या सूतो बृहन्नलाः।\nदिष्ट्या संग्राममागम्य भयं तव न किंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2034731, "chapter_id": 1748, "verse_number": "४-७१-२४x", "content_sanskrit": "उत्तर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2034732, "chapter_id": 1748, "verse_number": "४-७१-२४", "content_sanskrit": "अजैषीदेष जाञ्जिष्णुः कुरूनेकरथो रणे।\nएतस्यक बाहुवीर्यं तद्येन गावो जिता मया।\nकुरवो निर्जिता यस्मात्सग्रामेऽमिततेजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2034733, "chapter_id": 1748, "verse_number": "४-७१-२५", "content_sanskrit": "अकार्षीदेष तत्कर्म देवपुत्रोपमो युवा।\nएष तत्पुरुषव्याघ्रो विक्षोभ्य कुरुमण्डलम्।\nगावः प्रसह्य विजिता रणे मां चाभ्यपालयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2034734, "chapter_id": 1748, "verse_number": "४-७१-२६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2034735, "chapter_id": 1748, "verse_number": "४-७१-२६", "content_sanskrit": "उत्तरस्य वचः श्रुत्वा शंसमानस्य चार्जुनम्।\nचोदिता राजपुत्रेण जयं मङ्गलवादिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2034736, "chapter_id": 1748, "verse_number": "४-७१-२७", "content_sanskrit": "ततो गन्धैश्च माल्यैश्च धूपैश्च वसुसंभृतैः ।\nकन्याः पार्थममित्रघ्नं किरन्त्यः समपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2034737, "chapter_id": 1748, "verse_number": "४-७१-२८", "content_sanskrit": "आपूर्यमाणो माल्यैश्च गन्धैश्च विविधैः शुभैः ।\nसंपूज्यमानो लोकेन नगरद्वारमागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2034738, "chapter_id": 1748, "verse_number": "४-७१-२९", "content_sanskrit": "भेर्यश्च तूर्याणि च वेणवश्च\nविचित्रवेषाः प्रमदाजनाश्च।\nपुरो विराटस्य महाबलस्य\nनिष्क्रम्य भूमिंजयमभ्यनन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2034739, "chapter_id": 1748, "verse_number": "४-७१-३०", "content_sanskrit": "प्रशस्यमानस्तु जयेन तत्र\nपुत्रो विराटस्य न हृष्यति स्म।\nसंभाष्यमाणस्तु जयेन तत्र\nसोऽन्तर्मनाः पाण्डवमीक्षमाणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2034740, "chapter_id": 1748, "verse_number": "४-७१-३१", "content_sanskrit": "पुत्र्यै विराटस्य ततो वराणि\nवस्त्राण्यदात्पाण्डुसुतः सखीभ्यः।\nसभाजयंश्चापि समागतास्ता\nदृष्ट्वा जयं तच्च बलं कुमार्यः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2034741, "chapter_id": 1748, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि एकसप्ततितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]