[{"id": 2092939, "chapter_id": 2979, "verse_number": "१३-१०९-१", "content_sanskrit": "इन्द्र उवाच।\nजान्यो गामपहरेद्विक्रीयाच्चार्थकारणात्।\nएतद्विज्ञातुमिच्छामि कानु तस्य गतिर्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2092940, "chapter_id": 2979, "verse_number": "१३-१०९-२x", "content_sanskrit": "पितामह उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2092941, "chapter_id": 2979, "verse_number": "१३-१०९-२", "content_sanskrit": "भक्तार्थं विक्रयार्थं वा येऽपहारं हि कुर्वते।\nदानार्थं ब्राह्मणार्थाय तत्रेदं श्रूयतां फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2092942, "chapter_id": 2979, "verse_number": "१३-१०९-३", "content_sanskrit": "विक्रयार्थं हि यो हिंस्याद्भक्षयेद्वा निरङ्कुशः।\nघातयानं हि पुरुषं येऽनुमन्येयुरर्थिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2092943, "chapter_id": 2979, "verse_number": "१३-१०९-४", "content_sanskrit": "घातकः खादको वाऽपि तथा यश्चानुमन्यते।\nयावन्ति तस्या रोमाणि तावद्वर्षाणि मज्जति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2092944, "chapter_id": 2979, "verse_number": "१३-१०९-५", "content_sanskrit": "ये दोषा यादृशाश्चैव द्विजयज्ञोपघातके।\nविक्रये चापहारे च ते दोषा वै स्मृता गवाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2092945, "chapter_id": 2979, "verse_number": "१३-१०९-६", "content_sanskrit": "अपहृत्य तु यो गां वै ब्राह्मणाय प्रयच्छति।\nयावद्दाने तु यो गां वै ब्राह्मणाय प्रयच्छति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2092946, "chapter_id": 2979, "verse_number": "१३-१०९-७", "content_sanskrit": "सुवर्णं दक्षिणामाहुर्गोप्रदाने महाद्युते।\nसुवर्णं परमित्युक्तं दक्षिणार्थमसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2092947, "chapter_id": 2979, "verse_number": "१३-१०९-८", "content_sanskrit": "गोप्रदानात्तारयते सप्त पूर्वांस्तथाऽपरान्।\nसुवर्णं दक्षिणां कृत्वा तावद्द्विगुणमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2092948, "chapter_id": 2979, "verse_number": "१३-१०९-९", "content_sanskrit": "सुवर्णं परमं दानं सुवर्णं दक्षिणा परा।\nसुवर्णं पावनं शक्र पावनानां परं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2092949, "chapter_id": 2979, "verse_number": "१३-१०९-१०", "content_sanskrit": "कुलानां पावनं प्राहुर्जातरूपं शतक्रतो।\nएषा मे दक्षिणा प्रोक्ता समासेन महाद्युते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2092950, "chapter_id": 2979, "verse_number": "१३-१०९-११x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2092951, "chapter_id": 2979, "verse_number": "१३-१०९-११", "content_sanskrit": "एतत्पितामहेनोक्तमिन्द्राय भरतर्षभ।\nइन्द्रो दशरथायाह रामायाह पिता तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2092952, "chapter_id": 2979, "verse_number": "१३-१०९-१२", "content_sanskrit": "राघवोपि प्रियभ्रात्रे लक्ष्मणाय यशस्विने।\nऋषिभ्यो लक्ष्मणेनोक्तमरण्ये वसता प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2092953, "chapter_id": 2979, "verse_number": "१३-१०९-१३", "content_sanskrit": "पारम्पर्यागतं चेदमृषयः संशितव्रताः।\nदुर्धरं दारयामासू राजानश्चैव धार्मिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2092954, "chapter_id": 2979, "verse_number": "१३-१०९-१४", "content_sanskrit": "उपाध्यायेन गदितं मम चेदं युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2092955, "chapter_id": 2979, "verse_number": "१३-१०९-१५", "content_sanskrit": "य इदं ब्राह्मणो नित्यं वदेद्ब्राह्मणसंसदि।\nयज्ञेषु गोप्रदानेषु द्वयोरपि समागमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2092956, "chapter_id": 2979, "verse_number": "१३-१०९-१६", "content_sanskrit": "तस्य लोकाः किलाक्षय्या दैवतैः सह नित्यदा।\nइति ब्रह्मा स भगवानुवाच परमेश्वरः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2092957, "chapter_id": 2979, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि नवाधिकशततमोऽध्यायः॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]