[{"id": 7000655000, "chapter_id": 20655, "verse_number": "५-११५-१", "content_sanskrit": "श्रीराम उवाच ।\nकथं पातकसंघात संक्रमे ब्राह्मणाधमे ।\nपुराणज्ञः कथं व्याख्यां चकार द्विजसत्तम ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000655001, "chapter_id": 20655, "verse_number": "५-११५-२", "content_sanskrit": "शंभुरुवाच ।\nअध्यापने चाध्ययने जायते चाथ संगमः ।\nसंगतौ वत्सरं राम याति पातकि पातकम् ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000655002, "chapter_id": 20655, "verse_number": "५-११५-३", "content_sanskrit": "पुराणज्ञे तु काकुत्स्थ सर्वतत्वार्थवेदिनि ।\nअपिपातकसंदोह चीर्णपापं प्रणश्यति ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000655003, "chapter_id": 20655, "verse_number": "५-११५-४", "content_sanskrit": "प्रभूतवह्निनाशे हि धूमराशिर्यथैव हि ।\nशलभो दीपनाशाय वह्निनाशाय न प्रभुः ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000655004, "chapter_id": 20655, "verse_number": "५-११५-५", "content_sanskrit": "कृतं पापं तथान्येषां नाशनाय पुराणिकः ।\nभूतादिग्रस्तमर्त्यानां भूतादि भयमोचकः ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000655005, "chapter_id": 20655, "verse_number": "५-११५-६", "content_sanskrit": "समंत्रवानपनयेद्यथा न स्वयमातुरः ।\nपौराणिकस्तथा पापं न किंचित्प्राप्तुमर्हति ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000655006, "chapter_id": 20655, "verse_number": "५-११५-७", "content_sanskrit": "आत्मना च कृतं पापमन्यैरपि च यत्कृतम् ।\nपुराणज्ञो नाशयति त्वतिदुष्टं स्वकर्म्म वा ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000655007, "chapter_id": 20655, "verse_number": "५-११५-८", "content_sanskrit": "भवानीशे हृषीकेशे समवृत्तिर्विवेकवान् ।\nलोकवेदक्रियावेत्ता रुद्रजाप्यतिनिःस्पृहः ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000655008, "chapter_id": 20655, "verse_number": "५-११५-९", "content_sanskrit": "तुष्टः शांतः क्रियादक्षः प्रभूतो योगकृद्वशी ।\nयथैव ते पुराणज्ञो वसिष्ठो भगवानृषिः ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000655009, "chapter_id": 20655, "verse_number": "५-११५-१०", "content_sanskrit": "नियोगात्तव भूपाल अयोध्यायामतिष्ठत ।\nअपालयद्भुवं कृत्स्नां त्वां च रक्षः समापतत् ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000655010, "chapter_id": 20655, "verse_number": "५-११५-११", "content_sanskrit": "स च शुक्रोपदेशेन राक्षसस्त्वामथाभ्यगात् ।\nनिद्रासक्तं हनिष्यामि नान्यथावसरस्त्विति ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000655011, "chapter_id": 20655, "verse_number": "५-११५-१२", "content_sanskrit": "अथ विप्रो विदित्वैतद्वसिष्ठस्त्वद्धितप्रियः ।\nसुप्तं प्रमत्तं काकुत्स्थं रक्षो हंति न संशयः ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000655012, "chapter_id": 20655, "verse_number": "५-११५-१३", "content_sanskrit": "ब्रह्मावाप्तवरं तद्धि मया कार्यं निवारणम् ।\nइति संचिंत्य विप्रर्षिः सेनामादाय निर्गतः ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000655013, "chapter_id": 20655, "verse_number": "५-११५-१४", "content_sanskrit": "रक्षो हंतुमशक्तस्तु मृत्युहीनं ततो मुनिः ।\nस्वयं च राक्षसो भूत्वा वाक्यमाह महामुनिः ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000655014, "chapter_id": 20655, "verse_number": "५-११५-१५", "content_sanskrit": "किमर्थमागतोसीह वनं मुनिनिषेवितम् ।\nस आह राजा रक्षोघ्नस्तमहं हंतुमागतः ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000655015, "chapter_id": 20655, "verse_number": "५-११५-१६", "content_sanskrit": "मुनिरप्याह किं तेन जीवितेन मृतेन वा ।\nभुक्त्वामिषं मदीयं तु युद्धं कृत्वा जयं व्रज ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000655016, "chapter_id": 20655, "verse_number": "५-११५-१७", "content_sanskrit": "राक्षस उवाच ।\nकथं त्वं राक्षसो मह्यं भक्षणाय भविष्यसि ।\nवसिष्ठोऽप्यथ मानुष्यमास्थाय वियति स्थितः ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000655017, "chapter_id": 20655, "verse_number": "५-११५-१८", "content_sanskrit": "निष्ठीव्य मस्तके तस्य मुष्टिना तमताडयत् ।\nताडितो राक्षसस्तेन व्यद्रावयदृषिश्च तम् ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000655018, "chapter_id": 20655, "verse_number": "५-११५-१९", "content_sanskrit": "पलायमानावन्योन्यं जलधिं तु गतावुभौ ।\nतत्रस्थेन ग्रहेणासौ गृहीतो राक्षसस्तदा ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000655019, "chapter_id": 20655, "verse_number": "५-११५-२०", "content_sanskrit": "मुनिः पुनरयोध्यायां पूर्ववत्समतिष्ठत ।\nशंभुरुवाच ।\nतस्मात्स्वाभिमतं कुर्यात्पुराणज्ञो विमत्सरः ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000655020, "chapter_id": 20655, "verse_number": "५-११५-२१", "content_sanskrit": "श्रवणस्य विधानं च कथयामि शुभं शृणु ।\nशुक्लपक्षे दिने शुद्धे वारनक्षत्रयोगतः ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000655021, "chapter_id": 20655, "verse_number": "५-११५-२२", "content_sanskrit": "करणे चापि लग्ने च ग्रहताराबलान्विते ।\nअमूढेन ग्रहे बाले न च वृद्धौ गुरौस्थिते ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000655022, "chapter_id": 20655, "verse_number": "५-११५-२३", "content_sanskrit": "न कृष्णपक्षे ग्रहणे न च नास्तिकसंनिधौ ।\nपूर्वोक्तलक्षणोपेतं पुराणं शृणुयादिति ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000655023, "chapter_id": 20655, "verse_number": "५-११५-२४", "content_sanskrit": "शुद्धगेहेऽथवा शुद्धवेदिकायां मठेथ वा ।\nनदीतीरे देवगेहे सभामंडप एव च ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000655024, "chapter_id": 20655, "verse_number": "५-११५-२५", "content_sanskrit": "रथ्या मठेथ वा रम्ये पुण्यशालासु राघव ।\nस्वयं नमस्य विप्रेंद्रान्पुराणज्ञं विशेषतः ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000655025, "chapter_id": 20655, "verse_number": "५-११५-२६", "content_sanskrit": "आसनं कल्पितं कुर्य्यादूर्ध्वं सर्वविशेषितम् ।\nएहि धर्म्मासनमिति वक्तव्यं स्यादनिष्ठुरम् ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000655026, "chapter_id": 20655, "verse_number": "५-११५-२७", "content_sanskrit": "पुराणप्रक्रमदिने यत्कार्यं तदुदीरयेत् ।\nव्याख्यातारं पुराणस्य वस्त्राद्यैः परिपूजयेत् ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000655027, "chapter_id": 20655, "verse_number": "५-११५-२८", "content_sanskrit": "शुभानि दत्वा वस्त्राणि सूक्ष्माणि च नवानि च ।\nकरकंठविभूषादि पात्रमासनमेव च ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000655028, "chapter_id": 20655, "verse_number": "५-११५-२९", "content_sanskrit": "गंधपुष्पाक्षतैः पूज्य तांबूलं विनिवेद्य च ।\nशुक्लांबरधरं विष्णुं शशिवर्णं चतुर्भुजम् ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000655029, "chapter_id": 20655, "verse_number": "५-११५-३०", "content_sanskrit": "प्रसन्नवदनं ध्यायेत्सर्वविघ्नोपशांतये ।\nसभासदश्च संपूज्य गणेशं प्रार्थयेत्ततः ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000655030, "chapter_id": 20655, "verse_number": "५-११५-३१", "content_sanskrit": "ओंनमेत्यादि मंत्रेण पूजनं भारती नुतिः ।\nप्रातःकाले पुराणस्य प्रक्रमं प्रारभेदिति ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000655031, "chapter_id": 20655, "verse_number": "५-११५-३२", "content_sanskrit": "उपक्रमदिने राम त्रिपंचदश वा शुभाः ।\nश्लोका द्वितीये दिवसे ततो द्विगुणिताः शुभाः ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000655032, "chapter_id": 20655, "verse_number": "५-११५-३३", "content_sanskrit": "तृतीये दिवसे राम ततश्चाधिकमिष्यते ।\nदिनानामव्यवच्छेदाद्व्याख्यानं श्रवणं तथा ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000655033, "chapter_id": 20655, "verse_number": "५-११५-३४", "content_sanskrit": "व्यवस्थितिर्यदा जाता तदा पौराणिकं गुरुम् ।\nतांबूलादिप्रदायाथ परेद्युः शृणुयादपि ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000655034, "chapter_id": 20655, "verse_number": "५-११५-३५", "content_sanskrit": "पुराणमेवं श्रोतव्यं दैनंदिनमिति श्रुतिः ।\nव्रतरूपेण यः कश्चित्पुराणं शृणुयान्नरः ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000655035, "chapter_id": 20655, "verse_number": "५-११५-३६", "content_sanskrit": "यदैवं तत्पुराणं तु तत्र याति न संशयः ।\nपुराणं श्रोतुकामेन श्लोकश्चैकोपि चेच्छ्रुतः ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000655036, "chapter_id": 20655, "verse_number": "५-११५-३७", "content_sanskrit": "तद्दिने तु कृतं पापं नाशयेत्तु न संशयः ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000655037, "chapter_id": 20655, "verse_number": "५-११५-३८", "content_sanskrit": "एवं पुराणं शृणुयाच्च यस्तु स ब्रह्महत्याकृतपापबंधात् ।\nसुरापीतिः स्वर्णहरश्च राम गुर्वंगनागश्च विमुक्तिमेति ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000655038, "chapter_id": 20655, "verse_number": "५-११५-३९", "content_sanskrit": "पापानि चान्यानि कृतानि पुंभिः सर्वाणि नश्यंति पुराकृतानि ।\nइहापि यान्यब्दशतार्जितानि श्रोतुर्विनश्यंति तथा च वक्तुः ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000655039, "chapter_id": 20655, "verse_number": "५-११५-४०", "content_sanskrit": "कलौ समस्तविप्राणां सर्वज्ञत्वं न विद्यते ।\nविगुणापि ततो व्याख्या फलदा दानकर्मवत् ॥४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000655040, "chapter_id": 20655, "verse_number": "५-११५-४१", "content_sanskrit": "पुराणानामभिप्रायं व्यासो वेद न चापरः ।\nअहं वेद्मि विशेषेण व्यासादपि विधेरपि ॥४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000655041, "chapter_id": 20655, "verse_number": "५-११५-४२", "content_sanskrit": "न स्वाध्यायस्तपो वापि न मंत्रो न जुहोतयः ।\nफलंति न तथा तिष्ये पुराणश्रवणं यथा ॥४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000655042, "chapter_id": 20655, "verse_number": "५-११५-४३", "content_sanskrit": "एकैकश्रवणादेव पातकं महदेव तु ।\nनाशमाप्नोत्यसंदेहः श्रीशैले वर्तनादिव ॥४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000655043, "chapter_id": 20655, "verse_number": "५-११५-४४", "content_sanskrit": "अतो गुरुः पुराणज्ञः श्रोतृवंद्योऽघनाशनः ।\nन तस्मादधिकः कश्चिद्गुरुरस्ति गतिप्रदः ॥४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000655044, "chapter_id": 20655, "verse_number": "५-११५-४५", "content_sanskrit": "मंत्रेषु गुरवो ये च वेदशास्त्रेषु ये मताः ।\nनेशते सर्वविज्ञानं दातुं तस्मान्न बोधकाः ॥४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000655045, "chapter_id": 20655, "verse_number": "५-११५-४६", "content_sanskrit": "पिशाचाः प्रायशो राम ब्रह्मराक्षसनामिनः ।\nवेदमंत्रस्य वेत्तारो दृश्यंते न पुराणवित् ॥४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000655046, "chapter_id": 20655, "verse_number": "५-११५-४७", "content_sanskrit": "पुराणविमुखो नैव सर्वः सर्वं हि पश्यति ।\nपुराणज्ञो हि तस्तस्मात्पापनाशकरः प्रभुः ॥४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000655047, "chapter_id": 20655, "verse_number": "५-११५-४८", "content_sanskrit": "तत्पूजा सर्वपूजा स्यात्सर्वद्रोहोऽस्य पीडनम् ।\nयथा समस्तदानानां विद्यादानं प्रशस्यते ॥४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000655048, "chapter_id": 20655, "verse_number": "५-११५-४९", "content_sanskrit": "पौराणिकस्तथा धन्यस्तत्र दानं महत्फलम् ।\nराम उवाच ।\nकिं वा पौराणिके देयं कियत्कीदृशमेव च ॥४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000655049, "chapter_id": 20655, "verse_number": "५-११५-५०", "content_sanskrit": "पुराणं कीदृशं वर्ज्यं वर्ज्यः कीदृक्पुराणवित् ।\nशंभुरुवाच ।\nषड्रसानन्नपानानि स्नेहद्रव्याणि यानि च ॥५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000655050, "chapter_id": 20655, "verse_number": "५-११५-५१", "content_sanskrit": "गृहं सोपस्करं राम पुराणज्ञाय दापयेत् ।\nपर्याप्तान्येव सर्वाणि अधिकानि फलाधिकात् ॥५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000655051, "chapter_id": 20655, "verse_number": "५-११५-५२", "content_sanskrit": "दद्याद्द्रव्यमतो भूयः सचैलं शोभितं मृदु ।\nभूषणानि यथार्हाणि स्वशक्त्या प्रतिपादयेत् ॥५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000655052, "chapter_id": 20655, "verse_number": "५-११५-५३", "content_sanskrit": "गंधपुष्पं प्रतिदिनं केवलं गंधमेव च ।\nकेवलं च तथा पुष्पं फलकाले फलान्यपि ॥५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000655053, "chapter_id": 20655, "verse_number": "५-११५-५४", "content_sanskrit": "तांबूलं च तथा दद्यान्नमस्कुर्याच्च भक्तितः ।\nपुराणस्य समाप्तौ तु दद्याद्दानादिकं तथा ॥५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000655054, "chapter_id": 20655, "verse_number": "५-११५-५५", "content_sanskrit": "अधिकं तु तथा देयं भूहिरण्यादिकं नृप ।\nन च तूष्णीमुपक्रम्य श्रोतुमर्हति कश्चन ॥५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000655055, "chapter_id": 20655, "verse_number": "५-११५-५६", "content_sanskrit": "सभासद्भिः कृता चैव या पूजैकेन वा कृता ।\nदेवस्थाने यथाशक्ति सर्वैः पूजनमिष्यते ॥५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000655056, "chapter_id": 20655, "verse_number": "५-११५-५७", "content_sanskrit": "तीर्थेपि च यथा राम पुण्येष्वायतनेषु च ।\nस्वशक्त्या पूजनं कुर्यात्पुराणज्ञाय राघव ॥५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000655057, "chapter_id": 20655, "verse_number": "५-११५-५८", "content_sanskrit": "श्रोतुस्तु लक्षणं पूर्वं मयोक्तं तु भवेन्नृप ।\nपौराणिकस्य सर्वस्य लक्षणं कथयामि ते ॥५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000655058, "chapter_id": 20655, "verse_number": "५-११५-५९", "content_sanskrit": "कुलहीनो महाव्याधिर्महापापी तिरस्कृतः ।\nशौचाचारविहीनश्च वेदस्मृतिविवर्जितः ॥५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000655059, "chapter_id": 20655, "verse_number": "५-११५-६०", "content_sanskrit": "अन्यदेवः पूतिवचो व्यंगश्चाप्यधिकांगवान् ।\nपरपूर्वापतिः स्तेनः प्राणिहंता निराकृतिः ॥६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000655060, "chapter_id": 20655, "verse_number": "५-११५-६१", "content_sanskrit": "अथ वर्ज्यं पुराणं ते कथयामि नृपोत्तम ।\nपूर्वज्ञैरुच्यमानं च यत्प्रोक्तं मुनिभिः परैः ॥६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000655061, "chapter_id": 20655, "verse_number": "५-११५-६२", "content_sanskrit": "व्यासादयो मुनिवरा यत्प्रोचुस्तदुदीरयेत् ।\nपुराणस्थं पठेद्ग्रन्थं व्याख्यायेत विचारयन् ॥६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000655062, "chapter_id": 20655, "verse_number": "५-११५-६३", "content_sanskrit": "यया कयापि वा राम भाषयादेशभाषतः ।\nन देशभाषा रचितं ग्रंथं श्रुत्वा फलं लभेत् ॥६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000655063, "chapter_id": 20655, "verse_number": "५-११५-६४", "content_sanskrit": "व्याख्या या कापि काकुत्स्थ पुराणस्य हिता हि सा ।\nतस्मात्त्वं देवयाचस्व व्याख्यास्ये यत्पुराणकम् ॥६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000655064, "chapter_id": 20655, "verse_number": "५-११५-६५", "content_sanskrit": "शंभुरुवाच ।\nएवं पौराणिकेनोक्तं श्रुतवानपि गौतमः ।\nस्वयं वस्त्रत्रयं प्रादाद्ब्राह्मणाय महात्मने ॥६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000655065, "chapter_id": 20655, "verse_number": "५-११५-६६", "content_sanskrit": "कौर्मं पुराणं प्रथमं श्रुतवानिति नः श्रुतम् ।\nदत्तवान्स्वर्णमधिकं वस्त्राणि च शुभानि च ॥६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000655066, "chapter_id": 20655, "verse_number": "५-११५-६७", "content_sanskrit": "अथ लैंगं च शुश्राव वैष्णवं वामनं तथा ।\nपाद्मं च गारुडं चैव सौरं ब्राह्ममथैव च ॥६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000655067, "chapter_id": 20655, "verse_number": "५-११५-६८", "content_sanskrit": "एवमष्ट स शुश्राव पुराणानि स गौतमः ।\nअथ रामायणं चैव कौर्ममेव पुनश्च सः ॥६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000655068, "chapter_id": 20655, "verse_number": "५-११५-६९", "content_sanskrit": "शिवनारायणेत्येवं जपं चक्रे सदैव हि ।\nअवाप निधनं चापि स गतो ब्रह्मणः पदम् ॥६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000655069, "chapter_id": 20655, "verse_number": "५-११५-७०", "content_sanskrit": "ब्रह्मा संपूज्य तं विप्रं विष्णुलोकमथागमत् ।\nविष्णुना पूजितः सोऽथ जगाम शिवमंदिरम् ॥७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000655070, "chapter_id": 20655, "verse_number": "५-११५-७१", "content_sanskrit": "सर्वेषामेव वंद्योऽसौ गौतमो मुनिसत्तमः ।\nभारतश्रवणे चापि नियमा ये मयेरिताः ॥७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000655071, "chapter_id": 20655, "verse_number": "५-११५-७२", "content_sanskrit": "पुरा व्यासेन मुनिना त्रिवर्षाद्यत्कृतं शुभम् ।\nश्रवणात्तस्य कृत्स्नस्य व्याकर्ता भारतस्य यः ॥७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000655072, "chapter_id": 20655, "verse_number": "५-११५-७३", "content_sanskrit": "न किंचित्प्रणमेद्विप्रं मुक्त्वा योगिनमुत्तमम् ।\nसर्वेषामेव वंद्योसौ भारतं व्याकरोति यः ॥७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000655073, "chapter_id": 20655, "verse_number": "५-११५-७४", "content_sanskrit": "यो महाभारतं नित्यं व्याख्यास्यति पठेच्च वा ।\nस सर्वेभ्योधिको विप्रस्तारयेच्चैव मानवान् ॥७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000655074, "chapter_id": 20655, "verse_number": "५-११५-७५", "content_sanskrit": "व्याकरोति च पर्वैकं सर्वाणि कतिचित्तु वा ।\nसर्वपापविनिर्मुक्तो हव्ये कव्ये विशिष्यते ॥७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000655075, "chapter_id": 20655, "verse_number": "५-११५-७६", "content_sanskrit": "तमेव प्रणमेद्विप्रं तमेवार्हं च पूजयेत् ।\nतमेव भोजयेन्नित्यं सर्वं तस्मै निवेदयेत् ॥७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000655076, "chapter_id": 20655, "verse_number": "५-११५-७७", "content_sanskrit": "तस्य पूजाविधिः प्रोक्तो व्याख्यानसमये द्विजः ।\nप्रतिपूज्योऽथ वस्त्राद्यैः पूजयेद्विधिमार्गतः ॥७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000655077, "chapter_id": 20655, "verse_number": "५-११५-७८", "content_sanskrit": "आदिपर्वसमाप्तौ च सूक्ष्मवस्त्रत्रयं ददेत् ।\nसुवर्णं च यथाशक्ति सभापर्वणि वाससी ॥७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000655078, "chapter_id": 20655, "verse_number": "५-११५-७९", "content_sanskrit": "आनुशासनिकारण्यस्वर्गारोहेषु पर्वसु ।\nआदिपर्वणि पूजा या सा पूजा नृपपुंगव ॥७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000655079, "chapter_id": 20655, "verse_number": "५-११५-८०", "content_sanskrit": "कर्णाश्वमेधवैराटशल्यद्रोणेषु पर्वसु ।\nसूक्ष्मवस्त्रत्रयं शुद्धं निष्कद्वयमथापि वा ॥८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000655080, "chapter_id": 20655, "verse_number": "५-११५-८१", "content_sanskrit": "क्षुद्रपर्वस्वथान्येषु निष्कावथ समानयेत् ।\nहरिवंशे सनिष्कं तु वस्त्रत्रितयमेव तु ॥८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000655081, "chapter_id": 20655, "verse_number": "५-११५-८२", "content_sanskrit": "भारतस्याखिलस्यैव समाप्तौ क्षेत्रदो भवेत् ।\nरामायणस्य श्रवणे कांडेकांडे प्रपूजयेत् ॥८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000655082, "chapter_id": 20655, "verse_number": "५-११५-८३", "content_sanskrit": "क्षेत्रं पर्याप्तमथवा सुवर्णमपि दापयेत् ।\nव्याख्यातुर्गुरुवाक्यस्य सर्वकल्मषनाशनः ॥८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000655083, "chapter_id": 20655, "verse_number": "५-११५-८४", "content_sanskrit": "अर्थोधर्म्मश्च कामश्च मोक्षश्च नृपसत्तम ।\nव्याख्याश्रवणतः सर्वे सिद्धयंति च सुबुद्धयः ॥८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000655084, "chapter_id": 20655, "verse_number": "५-११५-८५", "content_sanskrit": "ब्रह्महत्यादिपापानां सर्वेषामपि नाशनम् ।\nएकेन श्रवणेनास्य किं नरैर्न श्रुतं भुवि ॥८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000655085, "chapter_id": 20655, "verse_number": "५-११५-८६", "content_sanskrit": "यानवसुसुवर्णाद्यैर्नित्यमेनं प्रपूजयेत् ।\nव्याख्यातारं यतः पापसंदोहस्य विनाशनम् ॥८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000655086, "chapter_id": 20655, "verse_number": "५-११५-८७", "content_sanskrit": "अन्यान्यपि पुराणानि मुनिप्रोक्तानि तान्यपि ।\nश्रोतॄणां पापनाशाय वक्तुश्चापि विशेषतः ॥८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000655087, "chapter_id": 20655, "verse_number": "५-११५-८८", "content_sanskrit": "यश्च सर्वपुराणानि षट्त्रिंशत्तु प्रकीर्तयेत् ।\nशृणोति वा न तस्यास्ति चित्तच्छेदः कदाचन ॥८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000655088, "chapter_id": 20655, "verse_number": "५-११५-८९", "content_sanskrit": "ब्राह्मं पुराणं प्रथमं द्वितीयं पाद्ममुच्यते ।\nतृतीयं वैष्णवं चैव चतुर्थं शैवमुच्यते ॥८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000655089, "chapter_id": 20655, "verse_number": "५-११५-९०", "content_sanskrit": "अथ भागवतं प्रोक्तं पंचमं षष्ठमुच्यते ।\nभविष्यं नारदीयं च सप्तमं परिकीर्तितम् ॥९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000655090, "chapter_id": 20655, "verse_number": "५-११५-९१", "content_sanskrit": "मार्कंडेयमिति प्रोक्तमष्टमं नवमं तथा ।\nआग्नेयं ब्रह्मवैवर्तं दशमं परिकीर्तितम् ॥९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000655091, "chapter_id": 20655, "verse_number": "५-११५-९२", "content_sanskrit": "लैंगं च वामनं चैव स्कांदं मात्स्यमथैव च ।\nकौर्मं वाराहमुदितं गारुडं वाथ कीर्तितम् ॥९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000655092, "chapter_id": 20655, "verse_number": "५-११५-९३", "content_sanskrit": "ब्रह्मांडमित्यष्टादशपुराणानि विदुर्बुधाः ।\nतथा चोपपुराणानि कथयिष्याम्यतः परम् ॥९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000655093, "chapter_id": 20655, "verse_number": "५-११५-९४", "content_sanskrit": "आद्यं सनत्कुमाराख्यं नारसिंहमतः परम् ।\nतृतीयमांडमुद्दिष्टं दौर्वाससमथैव च ॥९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000655094, "chapter_id": 20655, "verse_number": "५-११५-९५", "content_sanskrit": "नारदीयमथान्यं च कापिलं मानवं तथा ।\nतद्वदौशनस प्रोक्तं ब्रह्मांडं च ततः परम् ॥९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000655095, "chapter_id": 20655, "verse_number": "५-११५-९६", "content_sanskrit": "वारुणं कालिकाह्वानं माहेशं सांबमेव च ।\nसौरं पाराशरं चैव मारीचं भार्गवाह्वयम् ॥९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000655096, "chapter_id": 20655, "verse_number": "५-११५-९७", "content_sanskrit": "कौमारं च पुराणानि कीर्तितान्यष्ट वै दश ।\nअष्टादशपुराणानां व्याकर्ता तु भवेन्मनुः ॥९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}]