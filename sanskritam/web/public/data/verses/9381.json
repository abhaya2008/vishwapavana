[{"id": 40022102, "chapter_id": 9381, "verse_number": "1", "content_sanskrit": "तथोक्ते तानृषीन्रामः प्रत्युवाच कृताञ्जलिः । किमाहारः किमाचारो लवणः क्व च वर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40022103, "chapter_id": 9381, "verse_number": "2", "content_sanskrit": "राघवस्य वचः श्रुत्वा ऋषयः सर्व एव ते । ततो निवेदयामासुर्लवणो ववृधे यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40022104, "chapter_id": 9381, "verse_number": "3", "content_sanskrit": "आहारः सर्वसत्त्वानि विशेषेण च तापसाः । आचारो रौद्रता नित्यं वासो मधुवने तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40022105, "chapter_id": 9381, "verse_number": "4", "content_sanskrit": "हत्वा बहुसहस्राणि सिंहव्याघ्रमृगद्विपान् । मानुषांश्चैव कुरुते नित्यमाहारमाह्निकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40022106, "chapter_id": 9381, "verse_number": "5", "content_sanskrit": "ततो ऽन्तराणि सत्त्वानि खादते स महाबलः । संहारे समनुप्राप्ते व्यादितास्य इवान्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40022107, "chapter_id": 9381, "verse_number": "6", "content_sanskrit": "तच्छ्रुत्वा राघवो वाक्यमुवाच स महामुनीन् । घातयिष्यामि तद्रक्षो ह्यपगच्छतु वो भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40022108, "chapter_id": 9381, "verse_number": "7", "content_sanskrit": "प्रतिज्ञाय तथा तेषां मुनीनामुग्रतेजसाम् । स भ्रातऽन्सहितान्सर्वानुवाच रघुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40022109, "chapter_id": 9381, "verse_number": "8", "content_sanskrit": "को हन्ता लवणं वीरः कस्यांशः स विधीयताम् । भरतस्य महाबाहोः शत्रुघ्नस्य च धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40022110, "chapter_id": 9381, "verse_number": "9", "content_sanskrit": "राघवेणैवमुक्तस्तु भरतो वाक्यमब्रवीत् । अहमेनं वधिष्यामि ममांशः स विधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40022111, "chapter_id": 9381, "verse_number": "10", "content_sanskrit": "भरतस्य वचः श्रुत्वा धैर्यशौर्यसमन्वितम् । लक्ष्मणावरजस्तस्थौ हित्वा सौवर्णमासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40022112, "chapter_id": 9381, "verse_number": "11", "content_sanskrit": "शत्रुघ्नस्त्वब्रवीद्वाक्यं प्रणिपत्य नराधिपम् । कृतकर्मा महाबाहुर्मध्यमो रघुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40022113, "chapter_id": 9381, "verse_number": "12", "content_sanskrit": "आर्येण हि पुरा शून्या त्वयोध्या परिपालिता । सन्तापं हृदये कृत्वा आर्यस्यागमनं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40022114, "chapter_id": 9381, "verse_number": "13", "content_sanskrit": "दुःखानि च बहूनीह ह्यनुभूतानि पार्थिव । शयानो दुःखशय्यासु नन्दिग्रामे ऽवसत्पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40022115, "chapter_id": 9381, "verse_number": "14", "content_sanskrit": "फलमूलाशनो भूत्वा जटी चीरधरस्तथा । अनुभूयेदृशं दुःखमेष राघवनन्दनः । प्रेष्ये मयि स्थिते राजन्न भूयः क्लेशमाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40022116, "chapter_id": 9381, "verse_number": "15", "content_sanskrit": "तथा ब्रुवति शत्रुघ्ने राघवः पुनरब्रवीत् । एवं भवतु काकुत्स्थ क्रियतां मम शासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40022117, "chapter_id": 9381, "verse_number": "16", "content_sanskrit": "राज्ये त्वामभिषेक्ष्यामि मधोस्तु नगरे शुभे । निवेशय महाबाहो भरतं यद्यवेक्षसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40022118, "chapter_id": 9381, "verse_number": "17", "content_sanskrit": "शूरस्त्वं कृतविद्यश्च समर्थश्च निवेशने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40022119, "chapter_id": 9381, "verse_number": "18", "content_sanskrit": "यो हि शत्रुं समुत्पाट्य पार्थिवस्य पुनः क्षये । न विधत्ते नृपं तत्र नरकं स हि गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40022120, "chapter_id": 9381, "verse_number": "19", "content_sanskrit": "स त्वं हत्वा मधुसुतं लवणं पापनिश्चयम् । राज्यं प्रशाधि धर्मेण वाक्यं मे यद्यवेक्षसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40022121, "chapter_id": 9381, "verse_number": "20", "content_sanskrit": "उत्तरं च न वक्तव्यं शूर वाक्यान्तरे मम । बालेन पूर्वजस्याज्ञा कर्तव्या नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40022122, "chapter_id": 9381, "verse_number": "21", "content_sanskrit": "अभिषेकं च काकुत्स्थ प्रतीच्छस्व मयोद्यतम् । वसिष्ठप्रमुखैर्विप्रैर्विधिमन्त्रपुरस्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]