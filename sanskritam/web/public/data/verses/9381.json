[{"id": 5000381000, "chapter_id": 9381, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे द्विचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000381001, "chapter_id": 9381, "verse_number": "५-४२-१", "content_sanskrit": "ततः पक्षिनिनादेन वृक्षभङ्गस्वनेन च।\nबभूवुस्त्राससम्भ्रान्ताः सर्वे लङ्कानिवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000381002, "chapter_id": 9381, "verse_number": "५-४२-२", "content_sanskrit": "विद्रुताश्च भयत्रस्ता विनेदुर्मृगपक्षिणः।\nरक्षसां च निमित्तानि क्रूराणि प्रतिपेदिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000381003, "chapter_id": 9381, "verse_number": "५-४२-३", "content_sanskrit": "ततो गतायां निद्रायां राक्षस्यो विकृताननाः।\nतद् वनं ददृशुर्भग्नं तं च वीरं महाकपिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000381004, "chapter_id": 9381, "verse_number": "५-४२-४", "content_sanskrit": "स ता दृष्ट्वा महाबाहुर्महासत्त्वो महाबलः।\nचकार सुमहद्रूपं राक्षसीनां भयावहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000381005, "chapter_id": 9381, "verse_number": "५-४२-५", "content_sanskrit": "ततस्तु गिरिसंकाशमतिकायं महाबलम्।\nराक्षस्यो वानरं दृष्ट्वा पप्रच्छुर्जनकात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000381006, "chapter_id": 9381, "verse_number": "५-४२-६", "content_sanskrit": "कोऽयं कस्य कुतो वायं किंनिमित्तमिहागतः।\nकथं त्वया सहानेन संवादः कृत इत्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000381007, "chapter_id": 9381, "verse_number": "५-४२-७", "content_sanskrit": "आचक्ष्व नो विशालाक्षि मा भूत्ते सुभगे भयम्।\nसंवादमसितापाङ्गि त्वया किं कृतवानयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000381008, "chapter_id": 9381, "verse_number": "५-४२-८", "content_sanskrit": "अथाब्रवीत् तदा साध्वी सीता सर्वाङ्गशोभना।\nरक्षसां कामरूपाणां विज्ञाने का गतिर्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000381009, "chapter_id": 9381, "verse_number": "५-४२-९", "content_sanskrit": "यूयमेवास्य जानीत योऽयं यद् वा करिष्यति।\nअहिरेव ह्यहेः पादान् विजानाति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000381010, "chapter_id": 9381, "verse_number": "५-४२-१०", "content_sanskrit": "अहमप्यतिभीतास्मि नैव जानामि को ह्ययम्।\nवेद्मि राक्षसमेवैनं कामरूपिणमागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000381011, "chapter_id": 9381, "verse_number": "५-४२-११", "content_sanskrit": "वैदेह्या वचनं श्रुत्वा राक्षस्यो विद्रुता द्रुतम्।\nस्थिताः काश्चिद‍्गताः काश्चिद् रावणाय निवेदितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000381012, "chapter_id": 9381, "verse_number": "५-४२-१२", "content_sanskrit": "रावणस्य समीपे तु राक्षस्यो विकृताननाः।\nविरूपं वानरं भीमं रावणाय न्यवेदिषुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000381013, "chapter_id": 9381, "verse_number": "५-४२-१३", "content_sanskrit": "अशोकवनिकामध्ये राजन् भीमवपुः कपिः।\nसीतया कृतसंवादस्तिष्ठत्यमितविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000381014, "chapter_id": 9381, "verse_number": "५-४२-१४", "content_sanskrit": "न च तं जानकी सीता हरिं हरिणलोचना।\nअस्माभिर्बहुधा पृष्टा निवेदयितुमिच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000381015, "chapter_id": 9381, "verse_number": "५-४२-१५", "content_sanskrit": "वासवस्य भवेद् दूतो दूतो वैश्रवणस्य वा।\nप्रेषितो वापि रामेण सीतान्वेषणकाङ्क्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000381016, "chapter_id": 9381, "verse_number": "५-४२-१६", "content_sanskrit": "तेनैवाद्भुतरूपेण यत्तत्तव मनोहरम्।\nनानामृगगणाकीर्णं प्रमृष्टं प्रमदावनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000381017, "chapter_id": 9381, "verse_number": "५-४२-१७", "content_sanskrit": "न तत्र कश्चिदुद्देशो यस्तेन न विनाशितः।\nयत्र सा जानकी देवी स तेन न विनाशितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000381018, "chapter_id": 9381, "verse_number": "५-४२-१८", "content_sanskrit": "जानकीरक्षणार्थं वा श्रमाद् वा नोपलक्ष्यते।\nअथवा कः श्रमस्तस्य सैव तेनाभिरक्षिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000381019, "chapter_id": 9381, "verse_number": "५-४२-१९", "content_sanskrit": "चारुपल्लवपत्राढ्यं यं सीता स्वयमास्थिता।\nप्रवृद्धः शिंशपावृक्षः स च तेनाभिरक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000381020, "chapter_id": 9381, "verse_number": "५-४२-२०", "content_sanskrit": "तस्योग्ररूपस्योग्रं त्वं दण्डमाज्ञातुमर्हसि।\nसीता सम्भाषिता येन वनं तेन विनाशितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000381021, "chapter_id": 9381, "verse_number": "५-४२-२१", "content_sanskrit": "मनःपरिगृहीतां तां तव रक्षोगणेश्वर।\nकः सीतामभिभाषेत यो न स्यात् त्यक्तजीवितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000381022, "chapter_id": 9381, "verse_number": "५-४२-२२", "content_sanskrit": "राक्षसीनां वचः श्रुत्वा रावणो राक्षसेश्वरः।\nचिताग्निरिव जज्वाल कोपसंवर्तितेक्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000381023, "chapter_id": 9381, "verse_number": "५-४२-२३", "content_sanskrit": "तस्य क्रुद्धस्य नेत्राभ्यां प्रापतन्नश्रुबिन्दवः।\nदीप्ताभ्यामिव दीपाभ्यां सार्चिषः स्नेहबिन्दवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000381024, "chapter_id": 9381, "verse_number": "५-४२-२४", "content_sanskrit": "आत्मनः सदृशान् वीरान् किंकरान्नाम राक्षसान्।\nव्यादिदेश महातेजा निग्रहार्थं हनूमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000381025, "chapter_id": 9381, "verse_number": "५-४२-२५", "content_sanskrit": "तेषामशीतिसाहस्रं किंकराणां तरस्विनाम्।\nनिर्ययुर्भवनात् तस्मात् कूटमुद‍्गरपाणयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000381026, "chapter_id": 9381, "verse_number": "५-४२-२६", "content_sanskrit": "महोदरा महादंष्ट्रा घोररूपा महाबलाः।\nयुद्धाभिमनसः सर्वे हनूमद्‍ग्रहणोन्मुखाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000381027, "chapter_id": 9381, "verse_number": "५-४२-२७", "content_sanskrit": "ते कपिं तं समासाद्य तोरणस्थमवस्थितम्।\nअभिपेतुर्महावेगाः पतंगा इव पावकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000381028, "chapter_id": 9381, "verse_number": "५-४२-२८", "content_sanskrit": "ते गदाभिर्विचित्राभिः परिघैः काञ्चनाङ्गदैः।\nआजग्मुर्वानरश्रेष्ठं शरैरादित्यसंनिभैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000381029, "chapter_id": 9381, "verse_number": "५-४२-२९", "content_sanskrit": "मुद‍्गरैः पट्टिशैः शूलैः प्रासतोमरपाणयः।\nपरिवार्य हनूमन्तं सहसा तस्थुरग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000381030, "chapter_id": 9381, "verse_number": "५-४२-३०", "content_sanskrit": "हनूमानपि तेजस्वी श्रीमान् पर्वतसंनिभः।\nक्षितावाविद्ध्य लाङ्गूलं ननाद च महाध्वनिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000381031, "chapter_id": 9381, "verse_number": "५-४२-३१", "content_sanskrit": "स भूत्वा तु महाकायो हनूमान् मारुतात्मजः।\nपुच्छमास्फोटयामास लङ्कां शब्देन पूरयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000381032, "chapter_id": 9381, "verse_number": "५-४२-३२", "content_sanskrit": "तस्यास्फोटितशब्देन महता चानुनादिना।\nपेतुर्विहङ्गा गगनादुच्चैश्चेदमघोषयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000381033, "chapter_id": 9381, "verse_number": "५-४२-३३", "content_sanskrit": "जयत्यतिबलो रामो लक्ष्मणश्च महाबलः।\nराजा जयति सुग्रीवो राघवेणाभिपालितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000381034, "chapter_id": 9381, "verse_number": "५-४२-३४", "content_sanskrit": "दासोऽहं कोसलेन्द्रस्य रामस्याक्लिष्टकर्मणः।\nहनूमान् शत्रुसैन्यानां निहन्ता मारुतात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000381035, "chapter_id": 9381, "verse_number": "५-४२-३५", "content_sanskrit": "न रावणसहस्रं मे युद्धे प्रतिबलं भवेत्।\nशिलाभिश्च प्रहरतः पादपैश्च सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000381036, "chapter_id": 9381, "verse_number": "५-४२-३६", "content_sanskrit": "अर्दयित्वा पुरीं लङ्कामभिवाद्य च मैथिलीम्।\nसमृद्धार्थो गमिष्यामि मिषतां सर्वरक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000381037, "chapter_id": 9381, "verse_number": "५-४२-३७", "content_sanskrit": "तस्य संनादशब्देन तेऽभवन् भयशङ्किताः।\nददृशुश्च हनूमन्तं संध्यामेघमिवोन्नतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000381038, "chapter_id": 9381, "verse_number": "५-४२-३८", "content_sanskrit": "स्वामिसंदेशनिःशङ्कास्ततस्ते राक्षसाः कपिम्।\nचित्रैः प्रहरणैर्भीमैरभिपेतुस्ततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000381039, "chapter_id": 9381, "verse_number": "५-४२-३९", "content_sanskrit": "स तैः परिवृतः शूरैः सर्वतः स महाबलः।\nआससादायसं भीमं परिघं तोरणाश्रितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000381040, "chapter_id": 9381, "verse_number": "५-४२-४०", "content_sanskrit": "स तं परिघमादाय जघान रजनीचरान्।\nसपन्नगमिवादाय स्फुरन्तं विनतासुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000381041, "chapter_id": 9381, "verse_number": "५-४२-४१", "content_sanskrit": "विचचाराम्बरे वीरः परिगृह्य च मारुतिः।\nसूदयामास वज्रेण दैत्यानिव सहस्रदृक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000381042, "chapter_id": 9381, "verse_number": "५-४२-४२", "content_sanskrit": "स हत्वा राक्षसान् वीरः किंकरान् मारुतात्मजः।\nयुद्धाकाङ्क्षी महावीरस्तोरणं समवस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000381043, "chapter_id": 9381, "verse_number": "५-४२-४३", "content_sanskrit": "ततस्तस्माद् भयान्मुक्ताः कतिचित्तत्र राक्षसाः।\nनिहतान् किंकरान् सर्वान् रावणाय न्यवेदयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000381044, "chapter_id": 9381, "verse_number": "५-४२-४४", "content_sanskrit": "स राक्षसानां निहतं महाबलं\nनिशम्य राजा परिवृत्तलोचनः।\nसमादिदेशाप्रतिमं पराक्रमे\nप्रहस्तपुत्रं समरे सुदुर्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000381045, "chapter_id": 9381, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे द्विचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]