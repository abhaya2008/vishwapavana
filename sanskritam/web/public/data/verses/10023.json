[{"id": 6000023000, "chapter_id": 10023, "verse_number": null, "content_sanskrit": "अथ तृतीयाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000023001, "chapter_id": 10023, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_003/BhP_02.003.001.m4a", "display_order": 2}, {"id": 6000023002, "chapter_id": 10023, "verse_number": "२-३-१", "content_sanskrit": "एवमेतन्निगदितं पृष्टवान् यद्भवान् मम।\nनृणां यन्म्रियमाणानां मनुष्येषु मनीषिणाम्॥ २/३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_003/BhP_02.003.002.m4a", "display_order": 3, "topics": [{"text": "शुकेन परीक्षितं प्रति इतरदेवताभजनस्य अल्पास्थिरैहिकफलमात्रसाधनत्वेन हरिभक्तेरेव निखिलपुरुषार्थसाधनत्वकथनम्", "range": "१"}]}, {"id": 6000023003, "chapter_id": 10023, "verse_number": "२-३-२", "content_sanskrit": "ब्रह्मवर्चसकामस्तु यजेत ब्रह्मणस्पतिम्।\nइन्द्रमिन्द्रियकामस्तु प्रजाकामः प्रजापतीन्॥ २/३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_003/BhP_02.003.003.m4a", "display_order": 4}, {"id": 6000023004, "chapter_id": 10023, "verse_number": "२-३-३", "content_sanskrit": "देवीं मायां तु श्रीकामस्तेजस्कामो विभावसुम्।\nवसुकामो वसून् रुद्रान्वीर्यकामस्तु वीर्यदान्॥ २/३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_003/BhP_02.003.004.m4a", "display_order": 5}, {"id": 6000023005, "chapter_id": 10023, "verse_number": "२-३-४", "content_sanskrit": "अन्नाद्यकामस्त्वदितिं स्वर्गकामोऽदितेः सुतान्।\nविश्वान्देवान् राष्ट्रकामः साध्यान्संसाधको विशाम्॥ २/३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_003/BhP_02.003.005.m4a", "display_order": 6}, {"id": 6000023006, "chapter_id": 10023, "verse_number": "२-३-५", "content_sanskrit": "आयुष्कामोऽश्विनौ देवौ पुष्टिकाम इलां यजेत्।\nप्रतिष्ठाकामः पुरुषो रोदसी लोकमातरौ॥ २/३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_003/BhP_02.003.006.m4a", "display_order": 7}, {"id": 6000023007, "chapter_id": 10023, "verse_number": "२-३-६", "content_sanskrit": "रूपाभिकामो गन्धर्वान् स्‍त्रीकामोऽप्सर उर्वशीम्।\nआधिपत्यकामः सर्वेषां यजेत परमेष्ठिनम्॥ २/३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_003/BhP_02.003.007.m4a", "display_order": 8}, {"id": 6000023008, "chapter_id": 10023, "verse_number": "२-३-७", "content_sanskrit": "यज्ञं यजेद्यशस्कामः कोशकामः प्रचेतसम्।\nविद्याकामस्तु गिरिशं दाम्पत्यार्थ उमां सतीम्॥ २/३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_003/BhP_02.003.008.m4a", "display_order": 9}, {"id": 6000023009, "chapter_id": 10023, "verse_number": "२-३-८", "content_sanskrit": "धर्मार्थमुत्तमश्लोकं तन्तुं तन्वन् पितॄन् यजेत्।\nरक्षाकामः पुण्यजनान् ओजस्कामो मरुद्गणान्॥ २/३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_003/BhP_02.003.009.m4a", "display_order": 10}, {"id": 6000023010, "chapter_id": 10023, "verse_number": "२-३-९", "content_sanskrit": "राज्यकामो मनून्देवान् निर्ऋतिं त्वभिचरन्यजेत्।\nग्रामकामो यजेत्सोममकामः पुरुषं पुमान्॥ २/३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_003/BhP_02.003.010.m4a", "display_order": 11}, {"id": 6000023011, "chapter_id": 10023, "verse_number": "२-३-१०", "content_sanskrit": "अकामः सर्वकामो वा मोक्षकाम उदारधीः।\nतीव्रेण भक्तियोगेन यजेत पुरुषं परम्॥ २/३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_003/BhP_02.003.011.m4a", "display_order": 12}, {"id": 6000023012, "chapter_id": 10023, "verse_number": "२-३-११", "content_sanskrit": "एतावानेव यजतामिह निःश्रेयसोदयः।\nभगवत्यचलो भावो यद्भागवतसङ्गतः॥ २/३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_003/BhP_02.003.012.m4a", "display_order": 13}, {"id": 6000023013, "chapter_id": 10023, "verse_number": "२-३-१२", "content_sanskrit": "ज्ञानं यदा प्रतिनिवृत्तगुणोर्मिचक्रमात्मप्रसाद उभयत्र गुणेष्वसङ्गः।\nकैवल्यसम्भृतपथस्त्वथ भक्तियोगः को निर्वृतो हरिकथासु रतिं न कुर्यात्॥ २/३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_003/BhP_02.003.013.m4a", "display_order": 14}, {"id": 6000023014, "chapter_id": 10023, "verse_number": null, "content_sanskrit": "शौनक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_003/BhP_02.003.014.m4a", "display_order": 15}, {"id": 6000023015, "chapter_id": 10023, "verse_number": "२-३-१३", "content_sanskrit": "इत्यभिव्याहृतं राजा निशम्य भरतर्षभः।\nकिमन्यत्पृष्टवान्भूयो वैयासकिमृषिं कविम्॥ २/३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_003/BhP_02.003.015.m4a", "display_order": 16}, {"id": 6000023016, "chapter_id": 10023, "verse_number": "२-३-१४", "content_sanskrit": "एतच्छुश्रूषतां विद्वन्सूत नोऽर्हसि भाषितुम्।\nकथा हरिगुणोदाराः सतां स्युः सदसि ध्रुवम्॥ २/३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_003/BhP_02.003.016.m4a", "display_order": 17}, {"id": 6000023017, "chapter_id": 10023, "verse_number": "२-३-१५", "content_sanskrit": "स वै भागवतो राजा पाण्डवेयो महारथः।\nबालः क्रीडनकैः क्रीडन्कृष्णक्रीडां य आददे॥ २/३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_003/BhP_02.003.017.m4a", "display_order": 18}, {"id": 6000023018, "chapter_id": 10023, "verse_number": "२-३-१६", "content_sanskrit": "वैयासकिश्च भगवान्वासुदेवपरायणः।\nउरुगायगुणोदाराः सतां स्युर्हि समागमे॥ २/३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_003/BhP_02.003.018.m4a", "display_order": 19}, {"id": 6000023019, "chapter_id": 10023, "verse_number": "२-३-१७", "content_sanskrit": "आयुर्हरति वै पुंसामुद्यन्नस्तं च यन्नसौ।\nतस्यर्ते यः क्षणो नीत उत्तमश्लोकवार्तया॥ २/३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_003/BhP_02.003.019.m4a", "display_order": 20}, {"id": 6000023020, "chapter_id": 10023, "verse_number": "२-३-१८", "content_sanskrit": "तरवः किन्न जीवन्ति भस्‍त्राः किं न श्वसन्त्युत।\nन खादन्ति न मेहन्ति किं ग्रामपशवोऽपरे॥ २/३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_003/BhP_02.003.020.m4a", "display_order": 21}, {"id": 6000023021, "chapter_id": 10023, "verse_number": "२-३-१९", "content_sanskrit": "श्वविड्वराहोष्ट्रखरैः स तुल्यः पुरुषः पशुः।\nन यत्कर्णपथोपेतो जातु नाम गदाग्रजः॥ २/३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_003/BhP_02.003.021.m4a", "display_order": 22}, {"id": 6000023022, "chapter_id": 10023, "verse_number": "२-३-२०", "content_sanskrit": "बिले बतोरुक्रमविक्रमान्ये न शृण्वतः कर्णपुटे नरस्य।\nजिह्वाऽसती दार्दुरिकेव सूत न चेत्प्रगायत्युरुगायगाथाम्॥ २/३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_003/BhP_02.003.022.m4a", "display_order": 23}, {"id": 6000023023, "chapter_id": 10023, "verse_number": "२-३-२१", "content_sanskrit": "भारः परं पट्टकिरीटजुष्टमप्युत्तमाङ्गं न नमेन्मुकुन्दम्।\nशावौ करौ नो कुरुतः सपर्यां हरेर्लसत्काञ्चनकङ्कणौ वा॥ २/३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_003/BhP_02.003.023.m4a", "display_order": 24}, {"id": 6000023024, "chapter_id": 10023, "verse_number": "२-३-२२", "content_sanskrit": "बर्हायिते ते नयने नराणां लिङ्गानि विष्णोर्न निरीक्षतो ये।\nपादौ नृणां तौ द्रुमजन्मभाजौ क्षेत्राणि नानुव्रजतो हरेर्यौ॥ २/३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_003/BhP_02.003.024.m4a", "display_order": 25}, {"id": 6000023025, "chapter_id": 10023, "verse_number": "२-३-२३", "content_sanskrit": "जीवच्छवो भागवताङ्घ्रिरेणुं न जातु मर्त्योऽभिलषेत यस्तु।\nश्रीविष्णुपद्या मनुजस्तुलस्याः श्वसञ्छवो यस्तु न वेद गन्धम्॥ २/३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_003/BhP_02.003.025.m4a", "display_order": 26}, {"id": 6000023026, "chapter_id": 10023, "verse_number": "२-३-२४", "content_sanskrit": "तदश्मसारं हृदयं बतेदं यद्गृह्यमाणैर्हरिनामधेयैः।\nन विक्रियेताथ मुखे विकारो नेत्रे जलं गात्ररुहेषु हर्षः॥ २/३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_003/BhP_02.003.026.m4a", "display_order": 27}, {"id": 6000023027, "chapter_id": 10023, "verse_number": "२-३-२५", "content_sanskrit": "अथाभिधेह्यङ्ग मनोऽनुकूलं प्रभाषसे भागवतप्रधानः।\nयदाह वैयासकिरात्मविद्याविशारदो नृपतिं साधु पृष्टः॥ २/३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_003/BhP_02.003.027.m4a", "display_order": 28}, {"id": 6000023028, "chapter_id": 10023, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां द्वितीयस्कन्धे तृतीयाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]