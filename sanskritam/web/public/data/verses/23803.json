[{"id": 7003803000, "chapter_id": 23803, "verse_number": "२-२-४७-१", "content_sanskrit": "मुनय ऊचुः ।\nभगवन्सर्वशास्त्रज्ञ श्रुतं परममद्भुतम् ।\nयात्रारूपं भगवतो माहात्म्यं पापनाशनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003803001, "chapter_id": 23803, "verse_number": "२-२-४७-२", "content_sanskrit": "यथाहं पूजितो देवः कामिभिः सर्वकामदः ।\nभूत्युपासनया भूतिप्रदो ब्रूहि तथा हि नः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003803002, "chapter_id": 23803, "verse_number": "२-२-४७-३", "content_sanskrit": "जैमिनिरुवाच ।\nसर्वा विभूतयो विष्णोर्जगत्यस्मिंश्चराचराः ।\nभूतिप्रदो विभूतिश्च स एकः परमेश्वरः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003803003, "chapter_id": 23803, "verse_number": "२-२-४७-४", "content_sanskrit": "यथायथोप चरति तथा वै जायते नरः ।\nएतावदस्य महिमा परिमातुं न शक्यते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003803004, "chapter_id": 23803, "verse_number": "२-२-४७-५", "content_sanskrit": "यो यथा समुपास्ते तं तथा वै फलमाप्नुयात् ।\nएकः पंथाश्चतुर्णां वै धर्मादीनां स दारवः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003803005, "chapter_id": 23803, "verse_number": "२-२-४७-६", "content_sanskrit": "धर्मस्य पथा गहनः संकीर्णो वहुशासनैः ।\nतत्त्वावधारणे नास्य क्षमः कोऽपि द्विजोत्तमाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003803006, "chapter_id": 23803, "verse_number": "२-२-४७-७", "content_sanskrit": "अर्थकामौ हि तन्मूलावित्थं स्थूलगती सदा ।\nतेषां त्रयाणां भगवाननायासेन वृद्धिकृत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003803007, "chapter_id": 23803, "verse_number": "२-२-४७-८", "content_sanskrit": "धर्मो हि भगवान्विष्णुर्धर्ममूलमिदं जगत् ।\nधर्मस्य जगतश्चापि प्रभुरेष जनार्दनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003803008, "chapter_id": 23803, "verse_number": "२-२-४७-९", "content_sanskrit": "पुरुषार्थमये तस्मिन्भक्तिर्यस्य प्रतिष्ठिता ।\nस सर्वकामतृप्तात्मा न शोचति न कांक्षति ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003803009, "chapter_id": 23803, "verse_number": "२-२-४७-१०", "content_sanskrit": "त्रैलोक्यैश्वर्यदातासौ शक्ररूपो ह्युपासितः ।\nभावितो धातृरूपेण वंशवृद्धिकरो हरिः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003803010, "chapter_id": 23803, "verse_number": "२-२-४७-११", "content_sanskrit": "सनत्कुमाररूपेण दीर्घमायुः प्रयच्छति ।\nवृत्तिसंपत्प्रदो ह्येष पृथुरूपेण भावितः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003803011, "chapter_id": 23803, "verse_number": "२-२-४७-१२", "content_sanskrit": "गङ्गादितीर्थफलदो वाचस्पतिरुपासितः ।\nअंतस्तमः प्रणुदति भास्वद्रूपेण भावितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003803012, "chapter_id": 23803, "verse_number": "२-२-४७-१३", "content_sanskrit": "सौभाग्यमतुलं दद्यादमृतांशुरुपासितः ।\nविद्याष्टादशतत्त्वज्ञो वाक्पतित्वेन भावयन् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003803013, "chapter_id": 23803, "verse_number": "२-२-४७-१४", "content_sanskrit": "वाजिमेधादियज्ञानां फलदोऽयं सनातनः ।\nयज्ञेश्वरस्वरूपेण भावितोऽयं जगन्मयः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003803014, "chapter_id": 23803, "verse_number": "२-२-४७-१५", "content_sanskrit": "ध्यातः कुबेररूपेण समृद्धिमतुलां ददेत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003803015, "chapter_id": 23803, "verse_number": "२-२-४७-१६", "content_sanskrit": "एवं दयांबुधिरसौ तस्मिन्नीलाचले वसन् ।\nदीनानाथानुग्रहाय दारुव्याजशरीरवान् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003803016, "chapter_id": 23803, "verse_number": "२-२-४७-१७", "content_sanskrit": "प्रयात तत्र भो विप्रा वसध्वं सुसमाहिताः ।\nश्रीशपादाब्जयुगलं शरणं तत्प्रपद्यत ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003803017, "chapter_id": 23803, "verse_number": "२-२-४७-१८", "content_sanskrit": "ऐहिकामुष्मिकान्भोगान्वाञ्छध्वं यदि शाश्वतान् ।\nअन्ते मुक्तिं च कैवल्यां यथेच्छं तत्र प्राप्नुत ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003803018, "chapter_id": 23803, "verse_number": "२-२-४७-१९", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे पुरुषोत्तमक्षेत्रमाहात्म्ये सप्तचत्वारिंशोऽध्यायः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]