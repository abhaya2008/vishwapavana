[{"id": 2099368, "chapter_id": 3125, "verse_number": "१३-२५५-१", "content_sanskrit": "युधिष्ठिर उवाच*।\nपितामह महाप्राज्ञ सर्वशास्त्रविशारद।\nकिं जप्यं जपतो नित्यं भवेद्धर्मफलं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2099369, "chapter_id": 3125, "verse_number": "१३-२५५-२", "content_sanskrit": "प्रस्थाने वा प्रवेशे वा प्रवृत्ते वाऽपि कर्मणि।\nदैवे वा श्राद्धकाले वा किं जप्यं कर्मसाधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2099370, "chapter_id": 3125, "verse_number": "१३-२५५-३", "content_sanskrit": "शान्तिकं पौष्टिकं रक्षा शत्रुघ्नं भयनाशनम्।\nजप्यं यद्ब्रह्म समितं तद्भवान्वक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2099371, "chapter_id": 3125, "verse_number": "१३-२५५-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2099372, "chapter_id": 3125, "verse_number": "१३-२५५-४", "content_sanskrit": "व्यासप्रोक्तमिमं मन्त्रं शृणुष्वैकमना नृप।\nसावित्र्या विहितं दिव्यं सद्यः पावविमोचनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2099373, "chapter_id": 3125, "verse_number": "१३-२५५-५", "content_sanskrit": "शृणु मन्त्रविधिं कृत्स्नं प्रोच्यमानं मयाऽनघ।\nयं श्रुत्वा पाण्डवश्रेष्ठ सर्वपापैः प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2099374, "chapter_id": 3125, "verse_number": "१३-२५५-६", "content_sanskrit": "रात्रावहनि धर्मज्ञ जपन्पापैर्न लिप्यते।\nतत्तेऽहं सम्प्रवक्ष्यामि शृणुष्वैकमना नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2099375, "chapter_id": 3125, "verse_number": "१३-२५५-७", "content_sanskrit": "आयुष्मान्भवते चैव यं श्रुत्वा पार्थिवात्मज।\nपुरुषस्तु सुसिद्धार्थः प्रेत्य चेह च मोदते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2099376, "chapter_id": 3125, "verse_number": "१३-२५५-८", "content_sanskrit": "सेवितं सततं राजन्पुरा राजर्षिसत्तमैः।\nक्षत्रधर्मपैरर्नित्यं सत्यव्रतपरायणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2099377, "chapter_id": 3125, "verse_number": "१३-२५५-९", "content_sanskrit": "इदमाह्निकमव्यग्रं कुर्वद्भिर्नियतैः सदा।\nनृपैर्भरतशार्दूल प्राप्यते श्रीरनुत्तमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2099378, "chapter_id": 3125, "verse_number": "१३-२५५-१०", "content_sanskrit": "नमो वसिष्ठाय महाव्रताय\nपराशरं वेदनिधइं नमस्ते।\nनमोस्त्वनन्ताय महोरगाय\nनमोस्तु सिद्धेभ्य इहाक्षयेभ्यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2099379, "chapter_id": 3125, "verse_number": "१३-२५५-११", "content_sanskrit": "नमोस्त्वृषिभ्यः परमं परेषां\nदेवेषु देवं वरदं वराणाम्।\nसहस्रशीर्षाय नमः शिवाय\nसहस्रनामाय जनार्दनाय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2099380, "chapter_id": 3125, "verse_number": "१३-२५५-१२", "content_sanskrit": "अजैकपादहिर्बुध्न्यः पिनाकी चापराजितः।\nऋतश्च पितृरूपश्च त्र्यम्बकश्च महेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2099381, "chapter_id": 3125, "verse_number": "१३-२५५-१३", "content_sanskrit": "वृषाकपिश्च शंभुश्च हवनोऽथेश्वरस्तथा।\nएकादशैते प्रथिता रुद्रास्त्रिभुवनेश्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2099382, "chapter_id": 3125, "verse_number": "१३-२५५-१४", "content_sanskrit": "शतमेतत्समाम्नातं शतरुद्रे महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2099383, "chapter_id": 3125, "verse_number": "१३-२५५-१५", "content_sanskrit": "अंशो भगश्च मित्रश्च वरुणश्च जलेश्वरः।\nतथा धाताऽर्यमा चैव जयन्तो भास्करस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2099384, "chapter_id": 3125, "verse_number": "१३-२५५-१६", "content_sanskrit": "त्वष्टा पूषा तथैवेन्द्रो द्वादशो विष्णुरुच्यते।\nइत्येते द्वादशादित्याः काश्यपेया इति श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2099385, "chapter_id": 3125, "verse_number": "१३-२५५-१७", "content_sanskrit": "धरो ध्रुवश्च सोमश्च सावित्रोऽथानिलोऽनलः।\nप्रत्यूषश्च प्रभासश्च वसवोष्टौ प्रकीर्तिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2099386, "chapter_id": 3125, "verse_number": "१३-२५५-१८", "content_sanskrit": "नासत्यश्चापि दस्रश्च स्मृतौ द्वावश्विनावपि।\nमार्तण्डस्यात्मजावेतौ संज्ञानासाविनिर्गतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2099387, "chapter_id": 3125, "verse_number": "१३-२५५-१९", "content_sanskrit": "अतः परं प्रवक्ष्यामि लोकानां कर्मसाक्षिणः।\nअपि यज्ञस्य वेत्तारो दत्तस्य सुकृतस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2099388, "chapter_id": 3125, "verse_number": "१३-२५५-२०", "content_sanskrit": "अदृश्याः सर्वभूतेषु पश्यन्ति त्रिदशेश्वराः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2099389, "chapter_id": 3125, "verse_number": "१३-२५५-२०", "content_sanskrit": "शुभाशुभानि कर्माणि मृत्युः कालश्च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2099390, "chapter_id": 3125, "verse_number": "१३-२५५-२१", "content_sanskrit": "विश्वेदेवाः पितृगणा मूर्तिमन्तस्तपोधनाः।\nमुनयश्चैव सिद्धाश्च तपोमोक्षपरायणाः।\nशुचिस्मिताः कीर्तयतां प्रयच्छन्ति शुभं नृणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2099391, "chapter_id": 3125, "verse_number": "१३-२५५-२२", "content_sanskrit": "प्रजापतिकृतानेतान्लोकान्दिव्येन तेजसा।\nवसन्ति सर्वलोकेषु प्रयताः सर्वकर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2099392, "chapter_id": 3125, "verse_number": "१३-२५५-२३", "content_sanskrit": "प्राणानामीश्वरानेतान्कीर्तयन्प्रयतो नरः।\nधर्मार्थकामैर्विपुलैर्युज्यते सह नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2099393, "chapter_id": 3125, "verse_number": "१३-२५५-२४", "content_sanskrit": "लोकांश्च लभते पुण्यान्विश्वेश्वरकृताञ्शुभान्।\nएते देवास्त्रयस्त्रिंशत्सर्वभूतगणेश्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2099394, "chapter_id": 3125, "verse_number": "१३-२५५-२५", "content_sanskrit": "नन्दीश्वरो महाकायो ग्रामणीर्वृषभध्वजः।\nईश्वराः सर्वलोकानां गणेश्वरविनायकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2099395, "chapter_id": 3125, "verse_number": "१३-२५५-२६", "content_sanskrit": "सौम्या रौद्रा गणाश्चैव योगभूतगणास्तथा।\nज्योतींषि सरितो व्योम सुपर्णः पतगेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2099396, "chapter_id": 3125, "verse_number": "१३-२५५-२७", "content_sanskrit": "पृथिव्यां तपसा सिद्धाः स्थावराश्च चरास्च ह।\nहिमवान्गिरयः सर्वे चत्वारश्च महार्णवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2099397, "chapter_id": 3125, "verse_number": "१३-२५५-२८", "content_sanskrit": "भवस्यानुचराश्चैव हरतुल्यपराक्रमाः।\nविष्णुर्देवोथ जिष्णुश्च स्कन्दश्चाम्बिकया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2099398, "chapter_id": 3125, "verse_number": "१३-२५५-२९", "content_sanskrit": "कीर्तयन्प्रयतः सर्वान्सर्वपापैः प्रमुच्यते।\nअत ऊर्ध्वं प्रवक्ष्यामि मानवानृषिसत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2099399, "chapter_id": 3125, "verse_number": "१३-२५५-३०", "content_sanskrit": "यवक्रीतश्च रैभ्यश्च अर्वावसुपरावसू।\nऔशिजश्चैव कक्षीवान्बलश्चाङ्गिरसः सुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2099400, "chapter_id": 3125, "verse_number": "१३-२५५-३१", "content_sanskrit": "ऋषिर्मेधातिथेः पुत्रः कण्वो बर्हिषदस्तथा।\nब्रह्मतेजोमयाः सर्वे कीर्तिता लोकभावनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2099401, "chapter_id": 3125, "verse_number": "१३-२५५-३२", "content_sanskrit": "लभन्ते हि शुभं सर्वे रुद्रानलवसुप्रभाः।\nभुवि कृत्वा शुभं कर्म मोदन्ते दिवि दैवतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2099402, "chapter_id": 3125, "verse_number": "१३-२५५-३३", "content_sanskrit": "महेन्द्रगुरवः सप्त प्राचीं वै दिशमाश्रिताः।\nप्रयतः कीर्तयेदेताञ्शक्रलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2099403, "chapter_id": 3125, "verse_number": "१३-२५५-३४", "content_sanskrit": "उन्मुचुः प्रमुचुश्चैव स्वस्त्यात्रेयश्च वीर्यवान्।\nदृढव्यश्चोर्ध्वबाहुश्च तृणसोमाङ्गिरास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2099404, "chapter_id": 3125, "verse_number": "१३-२५५-३५", "content_sanskrit": "मित्रावरुणयोः पुत्रस्तथाऽगस्त्यः प्रतापवान्।\nधर्मराजर्त्विजः सप्त दक्षिणां दिशमाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2099405, "chapter_id": 3125, "verse_number": "१३-२५५-३६", "content_sanskrit": "दृढेयुश्च ऋतेयुश्च परिव्याधश्च कीर्तिमान्।\nएकतश्च द्वितश्चैव त्रितश्चादित्यसन्निभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2099406, "chapter_id": 3125, "verse_number": "१३-२५५-३७", "content_sanskrit": "अत्रेः पुत्रश्च धर्मात्मा ऋषिः सारस्वतस्तथा।\nवरुणस्यर्त्विजः सप्त पश्चिमां दिशमाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2099407, "chapter_id": 3125, "verse_number": "१३-२५५-३८", "content_sanskrit": "अत्रिर्वसिष्ठो भगवान्कश्यपश्च महानृषिः।\nगौतमश्च भरद्वाजो विश्वामित्रोथ कौशिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2099408, "chapter_id": 3125, "verse_number": "१३-२५५-३९", "content_sanskrit": "ऋचीकतनयश्चोग्रो जमदग्निः प्रतापवान्।\nधनेश्वरस्य गुरवः सप्तैते उत्तराश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2099409, "chapter_id": 3125, "verse_number": "१३-२५५-४०", "content_sanskrit": "अपरे मुनयः सप्त दिक्षु सर्वास्वधिष्ठिताः।\nकीर्तिस्वस्तिकरा नॄणां कीर्तिता लोकभावनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2099410, "chapter_id": 3125, "verse_number": "१३-२५५-४१", "content_sanskrit": "धर्मः कामश्च कालश्च वसुर्वासुकिरेव च।\nअनन्तः कपिलश्चैव सप्तैते धरणीधराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2099411, "chapter_id": 3125, "verse_number": "१३-२५५-४२", "content_sanskrit": "रामो व्यासस्तथा द्रौणिरश्वत्थामा च लोमशः।\nइत्येते मुनयो दिव्या एकैकः सप्तसप्तधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2099412, "chapter_id": 3125, "verse_number": "१३-२५५-४३", "content_sanskrit": "शान्तिस्वस्तिकरा लोके दिशांपालाः प्रतीर्तिताः।\nयस्यांयस्यां दिशि ह्येते तन्मुखः शरणं व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2099413, "chapter_id": 3125, "verse_number": "१३-२५५-४४", "content_sanskrit": "स्रष्टारः सर्वभूतानां कीर्तिता लोकपावनाः।\nसंवर्तो मेरुसावर्णो मार्कण्डेयश्च धार्मिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2099414, "chapter_id": 3125, "verse_number": "१३-२५५-४५", "content_sanskrit": "साङ्ख्ययोगौ नारदश्च दुर्वासाश्च महानृषिः।\nअत्यन्ततपसो दान्तास्त्रिषु लोकेषु विश्रुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2099415, "chapter_id": 3125, "verse_number": "१३-२५५-४६", "content_sanskrit": "अपरे रुद्रसङ्काशाः कीर्तिता ब्रह्मलौकिकाः।\nअपुत्रो लभते पुत्रं दरिद्रो लभते धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2099416, "chapter_id": 3125, "verse_number": "१३-२५५-४७", "content_sanskrit": "तथा धर्मार्थकामेषु सिद्धिं च लभते नरः।\nपृथुं वैन्यं नृपवरं पृथ्वी यस्याभवत्सुता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2099417, "chapter_id": 3125, "verse_number": "१३-२५५-४८", "content_sanskrit": "प्रजापतिं सार्वभौमं कीर्तयेद्वसुधाधिपम्।\nआदित्यवंशप्रभवं महेन्द्रसमविक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2099418, "chapter_id": 3125, "verse_number": "१३-२५५-४९", "content_sanskrit": "पुरूरवसमैलं च त्रिषु लोकेषु विश्रुतम्।\nबुधस्य दयितं पुत्रं कीर्तयेद्वसुधाधिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2099419, "chapter_id": 3125, "verse_number": "१३-२५५-५०", "content_sanskrit": "त्रिलोकविश्रुतं वीरं भरतं च प्रकीर्तयेत्।\nगवामयेन यज्ञेन येनेष्टं वै कृते युगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2099420, "chapter_id": 3125, "verse_number": "१३-२५५-५१", "content_sanskrit": "रन्तिदेवं महादेवं कीर्तयेत्परमद्युतिम्।\nविश्वजित्तपसोपेतं लक्षण्यं लोकपूजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2099421, "chapter_id": 3125, "verse_number": "१३-२५५-५२", "content_sanskrit": "तथा श्वेतं च राजर्षिं कीर्तयेत्परमुद्यतिम्।\nसगरस्यात्मजा येन प्लावितास्तारितास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2099422, "chapter_id": 3125, "verse_number": "१३-२५५-५३", "content_sanskrit": "हुताशनसमानेतान्महारूपान्महौजसः।\nउग्रकायान्महासत्वान्कीर्तयेत्कीर्तिवर्धनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2099423, "chapter_id": 3125, "verse_number": "१३-२५५-५४", "content_sanskrit": "देवानृषिगणांश्चैव नृपांश्च जगतीश्वरान्।\nसाङ्ख्यं योगं च परमं हव्यं कव्यं तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2099424, "chapter_id": 3125, "verse_number": "१३-२५५-५५", "content_sanskrit": "कीर्तितं परमं ब्रह्म सर्वश्रुतिपरायणम्।\nमङ्गल्यं सर्वभूतानां पवित्रं बहु कीर्तितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2099425, "chapter_id": 3125, "verse_number": "१३-२५५-५६", "content_sanskrit": "व्याधिप्रशमनं श्रेष्ठं पौष्टिकं सर्वकर्मणाम्।\nप्रयतः कीर्तयेच्चैतान्कल्यं सायं च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2099426, "chapter_id": 3125, "verse_number": "१३-२५५-५७", "content_sanskrit": "एते वै यान्ति वर्षन्ति भान्ति वान्ति सृजन्ति च।\nएते विनायकाः श्रेष्ठा दक्षाः क्षान्ता जितेन्द्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2099427, "chapter_id": 3125, "verse_number": "१३-२५५-५८", "content_sanskrit": "नराणामशुभं सर्वे व्यपोहन्ति प्रकीर्तिताः।\nसाक्षिभूता महात्मानः पापस्य सुकृतस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2099428, "chapter_id": 3125, "verse_number": "१३-२५५-५९", "content_sanskrit": "एतान्वै कल्यमुत्थाय कीर्तयञ्शुभमश्नुते।\nनाग्निचोरभयं तस्य न मार्गप्रतिरोधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2099429, "chapter_id": 3125, "verse_number": "१३-२५५-६०", "content_sanskrit": "एतान्कीर्तयतां नित्यं दुःस्वप्नो नश्यते नृणाम्।\nमुच्यते सर्वपापेभ्यः स्वस्तिमांश्च गृहान्व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2099430, "chapter_id": 3125, "verse_number": "१३-२५५-६१", "content_sanskrit": "दीक्षाकालेषु सर्वेषु यः पठेन्नियतो द्विजः।\nन्यायवानात्मनिरतः क्षान्तो दान्तोऽनसूयकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2099431, "chapter_id": 3125, "verse_number": "१३-२५५-६२", "content_sanskrit": "रोगार्तो व्याधियुक्तो वा पठन्पापात्प्रमुच्यते।\nवास्तुमध्ये तु पठतः कुले स्वस्त्ययनं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2099432, "chapter_id": 3125, "verse_number": "१३-२५५-६३", "content_sanskrit": "क्षेत्रमध्ये तु पठतः सर्वं सस्यं प्ररोहति।\nगच्छतः क्षेममध्वानं ग्रामान्तरगतः पठन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2099433, "chapter_id": 3125, "verse_number": "१३-२५५-६४", "content_sanskrit": "आत्मनश्च सुतानां च दाराणां च धनस्य च।\nबीजानामोषधीनां च रक्षामेतां प्रयोजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2099434, "chapter_id": 3125, "verse_number": "१३-२५५-६५", "content_sanskrit": "एतान्सङ्ग्रामकाले तु पठतः क्षत्रियस्य तु।\nव्रजन्ति रिपवो नाशं क्षेमं च परिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2099435, "chapter_id": 3125, "verse_number": "१३-२५५-६६", "content_sanskrit": "एतान्दैवे च पित्र्ये च पठतः पुरुषस्य हि।\nभुञ्जते पितरः कव्यं हव्यं च त्रिदिवौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2099436, "chapter_id": 3125, "verse_number": "१३-२५५-६७", "content_sanskrit": "न व्याधिश्वापदभयं न द्विपान्न हि तस्करात्।\nकश्मलं लघुतां याति पाप्मना च प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2099437, "chapter_id": 3125, "verse_number": "१३-२५५-६८", "content_sanskrit": "यानपात्रे च याने च प्रवासे राजवेश्मनि।\nपरां सिद्धिमवाप्नोति सावित्रीं ह्युत्तमां पठन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2099438, "chapter_id": 3125, "verse_number": "१३-२५५-६९", "content_sanskrit": "न च राजभयं तेषां न पिशाचान्न राक्षसात्।\nनाग्न्यम्बुपवनव्यालाद्भयं तस्योपजायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2099439, "chapter_id": 3125, "verse_number": "१३-२५५-७०", "content_sanskrit": "चतुर्णामपि वर्णानामाश्रमस्य विशेषतः।\nकरोति सततं शान्तिं सावित्रीमुत्तमां पठन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2099440, "chapter_id": 3125, "verse_number": "१३-२५५-७१", "content_sanskrit": "नाग्निर्दहति काष्ठानि सावित्री यत्र पठ्यते।\nन तत्र बालो म्रियते न च तिष्ठन्ति पन्नगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2099441, "chapter_id": 3125, "verse_number": "१३-२५५-७२", "content_sanskrit": "न तेषां विद्यते दुःखं गच्छन्ति परमां गतिम्।\nये शृण्वन्ति महद्ब्रह्म सावित्रीगुणकीर्तनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2099442, "chapter_id": 3125, "verse_number": "१३-२५५-७३", "content_sanskrit": "गवां मध्ये तु पठतो गावोऽस्य बहुवत्सलाः।\nप्रस्थाने वा प्रवासे वा सर्वावस्थां गतः पठेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2099443, "chapter_id": 3125, "verse_number": "१३-२५५-७४", "content_sanskrit": "जपतां जुह्वतां चैव नित्यं च प्रयतात्मनाम्।\nऋषीणां परमं जप्यं गुह्यमेतन्नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2099444, "chapter_id": 3125, "verse_number": "१३-२५५-७५", "content_sanskrit": "याथातथ्येन सिद्धस्य इतिहासं पुरातनम्।\nपराशरमतं दिव्यं शक्राय कथितं पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2099445, "chapter_id": 3125, "verse_number": "१३-२५५-७६", "content_sanskrit": "तदेतत्ते समाख्यातं तथ्यं ब्रह्म सनातनम्।\nहृदयं सर्वभूतानां श्रुतिरेषा सनातनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2099446, "chapter_id": 3125, "verse_number": "१३-२५५-७७", "content_sanskrit": "सोमादित्यान्वयाः सर्वे राघवाः कुरवस्तथा।\nपठन्ति शुचयो नित्यं सावित्रीं प्राणिनां गतिं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2099447, "chapter_id": 3125, "verse_number": "१३-२५५-७८", "content_sanskrit": "अभ्यासे नित्यं देवानां सप्तर्षीणां ध्रुवस्य च।\nमोक्षणं सर्वकृच्छ्राणां मोचयत्यशुभात्सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2099448, "chapter_id": 3125, "verse_number": "१३-२५५-७९", "content_sanskrit": "वृद्धैः काश्यपगौतमप्रभृतिभिर्भृग्वङ्गिरोत्र्यादिभिः\nशुक्रागस्त्यबृहस्पतिप्रभृतिभिर्ब्रह्मह्मर्षिभिः सेवितम्।\nभारद्वाजमतं ऋचीकतनयैः प्राप्तं वसिष्ठात्पुनः\nसावित्रीमधिगम्य शक्रवसुभिः कृत्स्ना जिता दानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2099449, "chapter_id": 3125, "verse_number": "१३-२५५-८०", "content_sanskrit": "यो गोशतं कनकशृङ्गमयं ददाति\nविप्राय वेदविदुषे च बहुश्रुताय।\nदिव्यां च भारतकथां कथयेच्च नित्यं\nतुल्यं फलं भवति तस्य च तस्य चैव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2099450, "chapter_id": 3125, "verse_number": "१३-२५५-८१", "content_sanskrit": "धर्मो विवर्धति भृगोः परिकीर्तनेन\nवीर्यं विवर्धति पसिष्ठनमोनतेन।\nसङ्ग्रामजिद्भवति चैव रघुं नमस्य-\nन्स्यादश्विनौ च परिकीर्तयतो न रोगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2099451, "chapter_id": 3125, "verse_number": "१३-२५५-८२", "content_sanskrit": "एषा ते कथिता राजन्सावित्री ब्रह्मशाश्वती।\nविवक्षुरसि यच्चान्यत्तत्ते वक्ष्यामि भारत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2099452, "chapter_id": 3125, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि पञ्चपञ्चाशदधिकद्विशततमोऽध्यायः॥ २५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}]