[{"id": 2145636, "chapter_id": 4137, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2145637, "chapter_id": 4137, "verse_number": "१", "content_sanskrit": "भूयो मे पुण्डरीकाक्षं सञ्जयाचक्ष्व तत्त्वतः ।\nनामकर्मार्थवित् तात प्राप्नुयां पुरुषोत्तमम्\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2145638, "chapter_id": 4137, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2145639, "chapter_id": 4137, "verse_number": "२", "content_sanskrit": "श्रुतं मे वासुदेवस्य नामनिर्वचनं शुभम् ।\nयावत् तत्राभिजानेऽहम् अप्रमेयो हि केशवः\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2145640, "chapter_id": 4137, "verse_number": "३", "content_sanskrit": "वसनात् सर्वभूतानां वसुत्वाद् देवयोनितः ।\nवासुदेवस्ततो वेद्यो विषुत्वाद् विष्णुरुच्यते\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2145641, "chapter_id": 4137, "verse_number": "४", "content_sanskrit": "मौनाद्ध्यानाच्च योगाच्च विद्धि भारत माधवम् ।\nसर्वसत्त्वमयत्वाच्च मधुहा मधुसूदनः\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2145642, "chapter_id": 4137, "verse_number": "५", "content_sanskrit": "कृषिर्भूवाचकः शब्दो णश्च निर्वृतिवाचकः ।\nकृष्णस्तद्भावयोगाच्च कृष्णो भवति शाश्वतः\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2145643, "chapter_id": 4137, "verse_number": "६", "content_sanskrit": "पुण्डरीकं परं धाम नित्यमक्षयमक्षरम् ।\nतद्भावात् पुण्डरीकाक्षो दस्युत्रासाज्जनार्दनः\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2145644, "chapter_id": 4137, "verse_number": "७", "content_sanskrit": "यतः सत्वं न च्यवते यच्च सत्वान्न हीयते ।\nतत्त्वतः सात्वतस्तस्माद् आर्षभाद् वृषभेक्षणः\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2145645, "chapter_id": 4137, "verse_number": "८", "content_sanskrit": "न जायते जनित्राऽयम् अजस्तस्मादनीकजित् ।\nदेवानां सुखशंसित्वाद् दमाद् दामोदरो विभुः\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2145646, "chapter_id": 4137, "verse_number": "९", "content_sanskrit": "हर्षात् सुखात् सुखैश्वर्याद् हृषीकेशत्वमश्नुते ।\nबाहुभ्यां रोदसी बिभ्रन् महाबाहुरिति स्मृतः\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2145647, "chapter_id": 4137, "verse_number": "१०", "content_sanskrit": "अधो न क्षीयते जातु यस्मात् तस्मादधोक्षजः ।\nनराणामयनाच्चापि ततो नारायणः स्मृतः\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2145648, "chapter_id": 4137, "verse_number": "११", "content_sanskrit": "पूरणात् सादनाच्चापि ततो वै पुरुषोत्तमः\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2145649, "chapter_id": 4137, "verse_number": "१२", "content_sanskrit": "असतश्च सतश्चैव सर्वस्य प्रभवोऽप्ययः\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2145650, "chapter_id": 4137, "verse_number": "१३", "content_sanskrit": "सर्वस्य च सदा ज्ञानात् सर्वज्ञं तं प्रचक्षते\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2145651, "chapter_id": 4137, "verse_number": "१४", "content_sanskrit": "सत्ये प्रतिष्ठितः कृष्णः सत्यमत्र प्रतिष्ठितम् ।\nसत्तासत्ते च गोविन्दः तस्मात् सत्योऽपि नामतः\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2145652, "chapter_id": 4137, "verse_number": "१५", "content_sanskrit": "विष्णुर्विक्रमणाद् देवो जयनाज्जिष्णुरुच्यते\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2145653, "chapter_id": 4137, "verse_number": "१६", "content_sanskrit": "शाश्वतत्वादनन्तश्च गोविन्दश्चेतनादभूत् ।\nअतत्त्वं कुरुते तत्त्वं येन मोहयते प्रजाः\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2145654, "chapter_id": 4137, "verse_number": "१७", "content_sanskrit": "एवंविधो धर्मनित्यो भगवान् मधुसूदनः ।\nआगन्ता हि महाबाहुरानृशंस्यार्थमच्युतः\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2145655, "chapter_id": 4137, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि अष्टषष्टितमोऽध्यायः ॥६८॥\nव्यासाभिगमनपर्वणि एकविंशोऽध्यायः ॥२१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]