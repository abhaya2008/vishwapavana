[{"id": 2095872, "chapter_id": 3047, "verse_number": "१३-१७७-१", "content_sanskrit": "युधिष्ठिर उवाच।\nअहिंसा परमो धर्म इत्युक्तं बहुशस्त्वया।\nश्राद्धेषु च भवानाह पितॄणां मांसमीप्सितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2095873, "chapter_id": 3047, "verse_number": "१३-१७७-२", "content_sanskrit": "मांसैर्बहुविधैः प्रोक्तस्त्वया श्राद्धविधिः पुरा।\nअहत्वा च कुतो मांसमेवमेतद्विरुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2095874, "chapter_id": 3047, "verse_number": "१३-१७७-३", "content_sanskrit": "जातो नः संशयो धर्मे मांसस्य परिवर्जने।\nदोषो भक्षयत कः स्यात्कश्चाभक्षयतो गुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2095875, "chapter_id": 3047, "verse_number": "१३-१७७-४", "content_sanskrit": "हत्वा भक्षयतो वाऽपि परेणोपहृतस्य वा।\nहन्याद्वा यः परस्यार्थे क्रीत्वा वा भक्षयेन्नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2095876, "chapter_id": 3047, "verse_number": "१३-१७७-५", "content_sanskrit": "एतदिच्छामि तत्त्वेन कथ्यमानं त्वयाऽनघ।\nनिश्चयेन चिकीर्षामि धर्ममेतं सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2095877, "chapter_id": 3047, "verse_number": "१३-१७७-६", "content_sanskrit": "कथमायुरवाप्नोति कथं भवति सत्ववान्।\nकथमव्यङ्गतामेति लक्षण्यो जायते कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2095878, "chapter_id": 3047, "verse_number": "१३-१७७-७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2095879, "chapter_id": 3047, "verse_number": "१३-१७७-७", "content_sanskrit": "मांसस्याभक्षणाद्राजन्यो धर्मः कुरुनन्दन।\nतं मे शृणु यथातत्त्वं यश्चास्य विधिरुत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2095880, "chapter_id": 3047, "verse_number": "१३-१७७-८", "content_sanskrit": "रूपमव्यङ्गतामायुर्बुद्धिं सत्वं बलं स्मृतिम्।\nप्राप्तुकामैर्नरैर्हिंसा वर्जनीया कृतात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2095881, "chapter_id": 3047, "verse_number": "१३-१७७-९", "content_sanskrit": "ऋषीणामत्र संवादो बहुशः कुरुनन्दन।\nबभूव तेषां तु मतं यत्तच्छृणु युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2095882, "chapter_id": 3047, "verse_number": "१३-१७७-१०", "content_sanskrit": "यो यजेताश्वमेधेन मासिमासि यतव्रतः।\nवर्जयेन्मधु मांसं च सममेतद्युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2095883, "chapter_id": 3047, "verse_number": "१३-१७७-११", "content_sanskrit": "सप्तर्षयो वालखिल्यास्तथैव च मरीचिपाः।\nमांसस्याभक्षणं राजन्प्रशंसन्ति मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2095884, "chapter_id": 3047, "verse_number": "१३-१७७-१२", "content_sanskrit": "न भक्षयति यो मांसं न च हन्यान्न घातयेत्।\nतन्मित्रं सर्वभूतानां मनुः स्वायंभुवोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2095885, "chapter_id": 3047, "verse_number": "१३-१७७-१३", "content_sanskrit": "अधृष्यः सर्वभूतानां विश्वास्यः सर्वजन्तुषु।\nसाधूनां सम्मतो नित्यं भवेन्मांसं विवर्जयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2095886, "chapter_id": 3047, "verse_number": "१३-१७७-१४", "content_sanskrit": "स्वमांसं परमांसेन यो वर्धयितुमिच्छति।\nअविश्वास्योऽवसीदेत्स इति होवाच नारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2095887, "chapter_id": 3047, "verse_number": "१३-१७७-१५", "content_sanskrit": "ददाति यजते चापि तपस्वी च भवत्यपि।\nमधुमांसनिवृत्त्येति प्राह चैवं बृहस्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2095888, "chapter_id": 3047, "verse_number": "१३-१७७-१६", "content_sanskrit": "मासिमास्यश्वमेधेन यो यजेत शतं समाः।\nन खादति च यो मांसं सममेतन्मतं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2095889, "chapter_id": 3047, "verse_number": "१३-१७७-१७", "content_sanskrit": "सदा यजति सत्रेण सदा दानं प्रयच्छति।\nसदा तपस्वी भवति मद्यमांसविवर्जनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2095890, "chapter_id": 3047, "verse_number": "१३-१७७-१८", "content_sanskrit": "सर्वे वेदा न तत्कुर्युः सर्वे यज्ञाश्च भारत।\nयो भक्षयित्वा मांसानि पश्चादपि निवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2095891, "chapter_id": 3047, "verse_number": "१३-१७७-१९", "content_sanskrit": "`भक्षयित्वा निमित्तेऽपि दुष्करं कुरुते तपः।\nदुष्करं च रसज्ञेन मांसस्य परिवर्जनम्।\nचर्तुं व्रतमिदं श्रेष्ठं सर्वप्राण्यभयप्रदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2095892, "chapter_id": 3047, "verse_number": "१३-१७७-२०", "content_sanskrit": "सर्वभूतेषु यो विद्वान्ददात्यभयदक्षिणाम्।\nदाता भवति लोके स प्राणानां नात्र संशयः।\nएवं वै परमं धर्मं प्रशंसन्ति मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2095893, "chapter_id": 3047, "verse_number": "१३-१७७-२१", "content_sanskrit": "प्राणा यथाऽऽत्मनोऽभीष्टा भूतानामपि वै तथा।\nआत्मौपम्येन गन्तव्यं बुद्धिमद्भिः कृतात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2095894, "chapter_id": 3047, "verse_number": "१३-१७७-२२", "content_sanskrit": "विकीर्णकर्णकेनापि तृणमस्पन्दने भयम्।\nकिं पुनर्हन्यमानानां तरसा जीवितार्थिनाम्।\nअरोगाणामपापानां पापैर्मांसोपजीविभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2095895, "chapter_id": 3047, "verse_number": "१३-१७७-२३", "content_sanskrit": "मृत्युतो भयमस्तीति शङ्कायां दुःखमुत्तरम्।\nधर्मस्यायतनं तस्मान्मांसस्य परिवर्जनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2095896, "chapter_id": 3047, "verse_number": "१३-१७७-२४", "content_sanskrit": "अहिंसा परमो धर्मस्तथाऽहिंसा परं तपः।\nअहिंसा परमं सत्यं ततो धर्मः प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2095897, "chapter_id": 3047, "verse_number": "१३-१७७-२५", "content_sanskrit": "न हि मांसं तृणात्काष्ठादुपलाद्वाऽपि जायते।\nहत्वा जन्तुं ततो मांसं तस्माद्दोषस्तु भक्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2095898, "chapter_id": 3047, "verse_number": "१३-१७७-२६", "content_sanskrit": "स्वाहास्वाधामृतभुजो देवाः सत्यार्जवप्रियाः।\nराक्षसेन्द्रभयान्मुक्ताः सर्वभूतपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2095899, "chapter_id": 3047, "verse_number": "१३-१७७-२७", "content_sanskrit": "कान्तारेष्वथ घोरेषु दुर्गेषु गहनेषु च।\nरात्रावहनि सन्ध्यासु चत्वरेषु सभासु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2095900, "chapter_id": 3047, "verse_number": "१३-१७७-२८", "content_sanskrit": "उद्यतेषु च शस्त्रेषु मृगव्यालहतेषु च।\nअमांसभक्षणाद्राजन्न भयं तेषु विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2095901, "chapter_id": 3047, "verse_number": "१३-१७७-२९", "content_sanskrit": "शरण्यः सर्वभूतानां विश्वास्यः सर्वजन्तुषु।\nअनुद्वेगकरो लोके न चाप्युद्विजते सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2095902, "chapter_id": 3047, "verse_number": "१३-१७७-३०", "content_sanskrit": "यदि चेत्स्वादको न स्यान्न तदा घातको भवेत्।\nघातकः खादकार्थाय तद्धातयति वै नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2095903, "chapter_id": 3047, "verse_number": "१३-१७७-३१", "content_sanskrit": "अभक्ष्यमेतदिति वै इति हिंसा निवर्तते।\nखादकक्रमतो हिंसा मृगादीनां प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2095904, "chapter_id": 3047, "verse_number": "१३-१७७-३२", "content_sanskrit": "यस्माद्ग्रसति चैवायुर्हिंसकानां महाद्युते।\nतस्माद्विवर्जयेन्मांसं य इच्छेद्भूतिमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2095905, "chapter_id": 3047, "verse_number": "१३-१७७-३३", "content_sanskrit": "त्रातारं नाधिगच्छन्ति रौद्राः प्राणिविहिंसकाः।\nउद्वेजकास्तु भूतानां यथा व्यालमृगास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2095906, "chapter_id": 3047, "verse_number": "१३-१७७-३४", "content_sanskrit": "लोभाद्वा बुद्धिमोहाद्वा बलवीर्यार्थमेव च।\nसंसर्गादथ पापानामधर्मो रुचितो नृणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2095907, "chapter_id": 3047, "verse_number": "१३-१७७-३५", "content_sanskrit": "स्वमांसं परमांसेन यो वर्धयितुमिच्छति।\nउद्विग्नराष्ट्रे वसति यत्र यत्राभिजायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2095908, "chapter_id": 3047, "verse_number": "१३-१७७-३६", "content_sanskrit": "धन्यं यशस्यामायुष्यं स्वर्ग्यं स्वस्त्ययनं महत्।\nमांसस्याभक्षणं प्राहुर्नियताः परमर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2095909, "chapter_id": 3047, "verse_number": "१३-१७७-३७", "content_sanskrit": "इदं तु खलु कौन्तेय श्रुतमासीत्पुरा मया।\nमार्कण्डेयस्य वदतो ये दोषा मांसभक्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2095910, "chapter_id": 3047, "verse_number": "१३-१७७-३८", "content_sanskrit": "यो हि खादति सांसानि प्राणिनां जीवितैषिणाम्।\nसदा भवति वै पापः प्राणिहन्ता तथैव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2095911, "chapter_id": 3047, "verse_number": "१३-१७७-३९", "content_sanskrit": "धनेन क्रयिको हन्ति खादकश्चोपभोगतः।\nघातको वधबन्धाभ्यामित्येष त्रिविधो वधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2095912, "chapter_id": 3047, "verse_number": "१३-१७७-४०", "content_sanskrit": "अखादन्ननुमोदंश्च भावदोषेण मानवः।\nयोऽनुमोदति हन्यन्तं सोऽपि दोषेण लिप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2095913, "chapter_id": 3047, "verse_number": "१३-१७७-४१", "content_sanskrit": "अधृष्यः सर्वभूतानामायुष्मान्निरुजः सदा।\nभवत्यभक्षयन्मासं दयावान्प्राणिनामिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2095914, "chapter_id": 3047, "verse_number": "१३-१७७-४२", "content_sanskrit": "हिरण्यदानैर्गोदानैर्भूमिदानैश्च सर्वशः।\nमांसस्याभक्षणे धर्मो विशिष्ट इति नः श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2095915, "chapter_id": 3047, "verse_number": "१३-१७७-४३", "content_sanskrit": "अप्रोक्षितं वृथामासं विधिहीनं न भक्षयेत्।\nभक्षयन्निरयं याति नरो नास्त्यत्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2095916, "chapter_id": 3047, "verse_number": "१३-१७७-४४", "content_sanskrit": "प्रोक्षिताभ्युक्षितं मांसं तथा ब्राह्म्णकाम्यया।\nअल्पदोषमिति ज्ञेयं विपरिते तु लिप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2095917, "chapter_id": 3047, "verse_number": "१३-१७७-४५", "content_sanskrit": "खादकस्य कृते जन्तून्यो हन्यात्पुरुषाधमः।\nमहादोषकरस्तत्र घातको न तु खादकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2095918, "chapter_id": 3047, "verse_number": "१३-१७७-४६", "content_sanskrit": "इज्यायज्ञश्रुतिकृतैर्या मार्गैरबुधोऽधमः।\nहन्याज्जन्तून्मांसगृध्नुः स वै नरकभाङ्नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2095919, "chapter_id": 3047, "verse_number": "१३-१७७-४७", "content_sanskrit": "भक्षयित्वाऽपि यो मांसं पश्चादपि निवर्तते।\nतस्यापि सुमहान्धर्मो यः पापाद्विनिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2095920, "chapter_id": 3047, "verse_number": "१३-१७७-४८", "content_sanskrit": "आहर्ता चानुमन्ता च विशस्ता क्रयविक्रयी।\nसंस्कर्ता चोपभोक्ता च घातकाः सर्व एव ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2095921, "chapter_id": 3047, "verse_number": "१३-१७७-४९", "content_sanskrit": "इदमन्यत्तु वक्ष्यामि प्रमाणं विधिनिर्मितम्।\nपुराणमुषिभिर्जुष्टं वेदेषु परिनिश्चितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2095922, "chapter_id": 3047, "verse_number": "१३-१७७-५०", "content_sanskrit": "प्रवृत्तिलक्षणे धर्मे फलार्थिभिरभिद्रुते।\nयथोक्तं राजशार्दूल न तु तन्मोक्षकारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2095923, "chapter_id": 3047, "verse_number": "१३-१७७-५१", "content_sanskrit": "हविर्यत्संस्कृतं मन्त्रैः प्रोक्षिताभ्युक्षितं शुचि।\nवेदोक्तेन प्रमाणेन पितॄणां प्रक्रियासु च।\nप्रवृत्तिधर्मिणा भक्ष्यं नान्यथा मनुरब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2095924, "chapter_id": 3047, "verse_number": "१३-१७७-५२", "content_sanskrit": "अस्वर्ग्यमयशस्यं च रक्षोवद्भरतर्षभ।\nविधिहीनं नरः पूर्वं मांसं राजन्न भक्षयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2095925, "chapter_id": 3047, "verse_number": "१३-१७७-५३", "content_sanskrit": "य इच्छेत्पुरुषोऽत्यन्तमात्मानं निरुपद्रवम्।\nस वर्जयेत मांसानि प्राणिनामिह सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2095926, "chapter_id": 3047, "verse_number": "१३-१७७-५४", "content_sanskrit": "श्रूयते हि पुराकल्पे नृणां व्रीहिमयः पशुः।\nयेनायजन्त विद्वांसः पुण्यलोकपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2095927, "chapter_id": 3047, "verse_number": "१३-१७७-५५", "content_sanskrit": "ऋषिभिः संशयं पृष्टो वसुश्चेदिपतिः पुरा।\nअभक्ष्यमपि मांसं यः प्राह भक्ष्यमिति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2095928, "chapter_id": 3047, "verse_number": "१३-१७७-५६", "content_sanskrit": "आकाशादवनिं प्राप्तस्ततः स पृथिवीपतिः।\nयस्तदेव पुनश्चोक्त्वा विवेश धरणीतलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2095929, "chapter_id": 3047, "verse_number": "१३-१७७-५७", "content_sanskrit": "प्रजानां हितकामेन त्वगस्त्येन महात्मना।\nआरण्याः सर्वदैवत्याः प्रोक्षितास्तापसैर्मृगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2095930, "chapter_id": 3047, "verse_number": "१३-१७७-५८", "content_sanskrit": "क्रिया ह्येवं न हीयन्ते पितृदैवतसंश्रिताः।\nप्रीयन्ते पितरश्चैव न्यायतो मांसतर्पिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2095931, "chapter_id": 3047, "verse_number": "१३-१७७-५९", "content_sanskrit": "इदं तु शृणु राजेन्द्र मांसस्याभक्षणे गुणाः।\n[अभक्षणे सर्वसुखं मांसस्य मनुजाधिप॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2095932, "chapter_id": 3047, "verse_number": "१३-१७७-६०", "content_sanskrit": "यस्तु वर्षशतं पूर्णं तपस्तप्येत्सुदारुणम्।\nयश्चैव वर्जयेन्मांसं सममेतन्मतं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2095933, "chapter_id": 3047, "verse_number": "१३-१७७-६१", "content_sanskrit": "कौमुद्यास्तु विशेषेण शुक्लपक्षे नराधिप।\nवर्जयेत्सर्वमांसानि धर्मो ह्यत्र विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2095934, "chapter_id": 3047, "verse_number": "१३-१७७-६२", "content_sanskrit": "[चतुरो वार्षिकान्मासान्यो मांसं परिवर्जयेत्।\nचत्वारि भद्राण्याप्नोति कीर्तिमायुर्यशो बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2095935, "chapter_id": 3047, "verse_number": "१३-१७७-६३", "content_sanskrit": "अथवा मासमेकं वै सर्वमांसान्यभक्षयन्।\nअतीत्य सर्वदुःखानि सुखं जीवेन्निरामयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2095936, "chapter_id": 3047, "verse_number": "१३-१७७-६४", "content_sanskrit": "वर्जयन्ति हि मांसानि मासशः पक्षशोपि वा।\nतेषां हिंसानिवृत्तानां ब्रह्मलोको विधीयते॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2095937, "chapter_id": 3047, "verse_number": "१३-१७७-६५", "content_sanskrit": "मांसं तु कौमुदं पक्षं वर्जितं पार्थ राजभिः।\nसर्वभूतात्मभूतस्थैर्विदितार्थपरावरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2095938, "chapter_id": 3047, "verse_number": "१३-१७७-६६", "content_sanskrit": "नाभागेनाम्बरीषेण गयेन च महात्मना।\nआयुषाऽथानरण्येन दिलीपरघुसूनुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2095939, "chapter_id": 3047, "verse_number": "१३-१७७-६७", "content_sanskrit": "कार्तवीर्यानिरुद्धाभ्यां नहुषेण ययातिना।\nनृगेण विष्वगश्वेन तथैव शशबिन्दुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2095940, "chapter_id": 3047, "verse_number": "१३-१७७-६८", "content_sanskrit": "युवनाश्वेन च तथा शिबिनौशीनरेण च।\nमुचुकुन्देन मान्धात्रा हरिश्चन्द्रेण वा विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2095941, "chapter_id": 3047, "verse_number": "१३-१७७-६९", "content_sanskrit": "सत्यं वदत माऽसत्यं सत्यं धर्मः सनातनः।\nहरिश्चन्द्रश्चरति वै दिवि सत्येन चन्द्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2095942, "chapter_id": 3047, "verse_number": "१३-१७७-७०", "content_sanskrit": "श्येनचित्रेण राजेन्द्र सोमकेन वृकेण च।\nरैवते रन्तिदेवेन वसुना सृञ्जयेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2095943, "chapter_id": 3047, "verse_number": "१३-१७७-७१", "content_sanskrit": "एतैश्चान्यैश्च राजेन्द्र कृपेण भरतेन च।\nदुष्यन्तेन करूशेन रामालर्कनलैस्तथा।\nविचकाश्वेन निमिना जनकेन च धीमता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2095944, "chapter_id": 3047, "verse_number": "१३-१७७-७२", "content_sanskrit": "ऐलेन पृथुना चैंव वीरसेनेन चैव ह।\nइक्ष्वाकुणा शम्भुना च श्वेतेन सगरेण च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2095945, "chapter_id": 3047, "verse_number": "१३-१७७-७३", "content_sanskrit": "अजेन धुन्धुना चैव तथैव च सुबाहुना।\nहर्यश्वेन च राजेन्द्र क्षुपेण भरतेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2095946, "chapter_id": 3047, "verse_number": "१३-१७७-७४", "content_sanskrit": "एतैश्चान्यैश्च राजेन्द्रि पुरा मांसं न भक्षितम्।\nशारदं कौमुदं मासं ततस्ते स्वर्गमाप्नुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2095947, "chapter_id": 3047, "verse_number": "१३-१७७-७५", "content_sanskrit": "ब्रह्मलोके च तिष्ठन्ति ज्वलमानाः श्रियाऽन्विताः।\nउपास्यमाना गन्धर्वैः स्त्रीसहस्रसमन्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2095948, "chapter_id": 3047, "verse_number": "१३-१७७-७६", "content_sanskrit": "तदेतदुत्तमं धर्ममहिंसाधर्मलक्षणम्।\nये चरन्ति महात्मानो नाकपृष्ठे वसन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2095949, "chapter_id": 3047, "verse_number": "१३-१७७-७७", "content_sanskrit": "मधु मांसं च ये नित्यं वर्जयन्तीह धार्मिकाः।\nजन्मप्रभृति मद्यं च सर्व ते मुनयः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2095950, "chapter_id": 3047, "verse_number": "१३-१७७-७८", "content_sanskrit": "इमं धर्मममांसादं यश्चरेनच्छ्रावयीत वा।\nअपि चेत्सुदुराचारो न जातु निरयं व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2095951, "chapter_id": 3047, "verse_number": "१३-१७७-७९", "content_sanskrit": "पठेद्वा च इदं राजञ्शृणुयाद्वाऽप्यभीक्ष्णशः।\nअमांसभक्षणविधिं पवित्रमृषिपूजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2095952, "chapter_id": 3047, "verse_number": "१३-१७७-८०", "content_sanskrit": "विमुक्तः सर्वपापेभ्यः सर्वकामैर्महीयते।\nविशिष्टतां ज्ञातिषु च लभते नात्र संशयः।\n`अहिंस्रो दानशीलश्च मधुमांसविवर्जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2095953, "chapter_id": 3047, "verse_number": "१३-१७७-८१", "content_sanskrit": "आपन्नश्चापदो मुच्येद्बद्धो मुच्येत बन्धनात्।\nमुच्येत्तथाऽऽतुरो रोगाद्दुःखान्मुच्येत दुःखितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2095954, "chapter_id": 3047, "verse_number": "१३-१७७-८२", "content_sanskrit": "तिर्यग्योनिं न गच्छेत रूपवांश्च भवेन्नरः।\nऋद्धिमान्वै कुरुश्रेष्ठ प्राप्नुयाच्च महद्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2095955, "chapter_id": 3047, "verse_number": "१३-१७७-८३", "content_sanskrit": "एतत्ते कथितं राजन्मांसस्य परिवर्जने।\nप्रवृत्तौ च निवृत्तौ च विधानमृषिनिर्मितम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2095956, "chapter_id": 3047, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि सप्तसप्तत्यधिकशततमोऽध्यायः॥ १७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}]