[{"id": 7005498000, "chapter_id": 25498, "verse_number": "२-१५-१", "content_sanskrit": "व्यास उवाच ।\nवेद वेदौ तथा वेदान वेदान वा चतुरो द्विजाः ।\nअधीत्य चाधिगम्यार्थं ततः स्नायाद द्विजोत्तमः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005498001, "chapter_id": 25498, "verse_number": "२-१५-२", "content_sanskrit": "गुरवे तु वरं दत्वा स्नायीत तदनुज्ञया ।\nचीर्णव्रतोऽथ युक्तात्माक सशक्तः स्नातुमर्हति ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005498002, "chapter_id": 25498, "verse_number": "२-१५-३", "content_sanskrit": "वैणवीं धारयेद यष्टिमन्तर्वासस्तथोत्तरम ।\nयजॉपवीताद्वितयं सोदकं च कमन्डलुम ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005498003, "chapter_id": 25498, "verse_number": "२-१५-४", "content_sanskrit": "छत्रं चोष्णीषममलं पादुके चाप्युपानहौ ।\nरौक्मे च कुण्डले वेदं कुत्तकेशनख शुचिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005498004, "chapter_id": 25498, "verse_number": "२-१५-५", "content_sanskrit": "स्वाध्याये नित्ययुक्तः स्याद बहिर्माल्यं च धारयेत ।\nअन्यत्र कात्र्चानाद विप्रो न रक्तां बिभृयात स्त्रजम ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005498005, "chapter_id": 25498, "verse_number": "२-१५-६", "content_sanskrit": "शुक्लाम्बरधरो नित्यं सुगन्धः प्रियदर्शनः ।\nन जीर्णमलवदवासा भवेद वै विभते सति ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005498006, "chapter_id": 25498, "verse_number": "२-१५-७", "content_sanskrit": "न रक्तमुल्बणं चान्यधृतं अवासो न कुण्डिकाम ।\nनोपानहु स्त्र्जं च्थ पादुके च प्रयोजयेत ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005498007, "chapter_id": 25498, "verse_number": "२-१५-८", "content_sanskrit": "उपवीतमलंकारं दर्भान कृष्णाजिनानि च ।\nनापसव्यं परिदध्याद वासो न विकृतं वसेत ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005498008, "chapter_id": 25498, "verse_number": "२-१५-९", "content_sanskrit": "आहरेद विधिवद दारान सद्रुशानात्मनः शुभान ।\nरुपलक्षणसंयुक्तान योनिदोषविवर्जितान ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005498009, "chapter_id": 25498, "verse_number": "२-१५-१०", "content_sanskrit": "अमातृगोत्रप्रभावामसमानर्षिगोत्रजाम ।\nआहरेद ब्राह्मणो भ्रार्यां शीलशौचसमन्विताम ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005498010, "chapter_id": 25498, "verse_number": "२-१५-११", "content_sanskrit": "ऋतुकालभिगामी स्याद यावत पुत्रोऽभिजायते ।\nवर्जयेत प्रतिषिद्धानि प्रयन्तेन दिनानि तु ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005498011, "chapter_id": 25498, "verse_number": "२-१५-१२", "content_sanskrit": "षष्ठष्टमीं पंचदशीं द्वादशीं च चतुर्दशीम ।\nब्रह्माचारी भवेन्नित्यं तद्वज्जन्मत्रयाहनि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005498012, "chapter_id": 25498, "verse_number": "२-१५-१३", "content_sanskrit": "आदधीतवसथ्याग्निं जुहुयाज्जातवेदसम ।\nव्रतानि स्नातको नित्यं पावनानि च पालयेत ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005498013, "chapter_id": 25498, "verse_number": "२-१५-१४", "content_sanskrit": "वेदोदितं स्वकं कर्मं नित्यं कुर्यादतन्दितः ।\nअकूर्वाणः पतत्याशु नरकानतिभीषणान ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005498014, "chapter_id": 25498, "verse_number": "२-१५-१५", "content_sanskrit": "अभ्यसेत प्रयतो वेदं महायज्ञान न हापयेत ।\nकुर्याद गृहाणि कर्माणि संध्योपासनमेव च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005498015, "chapter_id": 25498, "verse_number": "२-१५-१६", "content_sanskrit": "संख्यं समाधिकैः कुर्यादुपेयादीश्वरं सदा ।\nदैवतान्यपि गच्छेत कुर्याद भायाभिषोपाषणाम ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005498016, "chapter_id": 25498, "verse_number": "२-१५-१७", "content_sanskrit": "न धर्मं ख्यापयेद विद्वान न पापं गूहयेदपिः ।\nकुर्वातात्महितं नित्यं सर्वभुतानुकम्पमः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005498017, "chapter_id": 25498, "verse_number": "२-१५-१८", "content_sanskrit": "वयसःकुर्मणो ऽर्थस्य श्रुतस्याभिजनस्य च ।\nवेषवाग्बुद्धिसारुप्यमाचरन विचरेत सदा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005498018, "chapter_id": 25498, "verse_number": "२-१५-१९", "content_sanskrit": "श्रुतिस्मृत्युदित सम्यक सधुभिर्यश्च सेवितः ।\nतमाचारं निषेवेत नेहेतान्यत्र कर्हिचित ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005498019, "chapter_id": 25498, "verse_number": "२-१५-२०", "content_sanskrit": "येनास्य पितरो याता येन याताः पितामहाः ।\nतेन यायात सतां मार्गं तेन गच्छन न रिष्यति ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005498020, "chapter_id": 25498, "verse_number": "२-१५-२१", "content_sanskrit": "नित्यं स्वाध्यायशीलः स्यान्नित्यं यज्ञोपवीतवान ।\nसत्यवादी जितक्रोधी ब्रह्माभूयाय कल्पते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005498021, "chapter_id": 25498, "verse_number": "२-१५-२२", "content_sanskrit": "संध्यास्नानपरो नित्यं ब्रह्मायज्ञपरायणः ।\nअनसुयो मृदुर्दान्तो गृहस्थः प्रेत्य वर्धते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005498022, "chapter_id": 25498, "verse_number": "२-१५-२३", "content_sanskrit": "वीतरागभक्रोधो लोभमोहर्विवर्जितः ।\nसावित्रीजाप्यनिरतः श्राद्धकृन्मुच्यते गृही ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005498023, "chapter_id": 25498, "verse_number": "२-१५-२४", "content_sanskrit": "मातापित्रोर्हिते युक्तो गोब्राह्माणहिते रतः ।\nदान्तो यज्वा देवभक्तो ब्रह्मालोके महीयते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005498024, "chapter_id": 25498, "verse_number": "२-१५-२५", "content_sanskrit": "त्रिवर्गसेवी सततं देवतानां च पुजनम ।\nकुर्यादहरहर्नित्यं नमस्येत प्रयतः सुरान ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005498025, "chapter_id": 25498, "verse_number": "२-१५-२६", "content_sanskrit": "विभगशीलः सततं क्षमायुक्तोदयालुकः ।\nगृहस्थस्तु समाख्यातो न गृहेण गृही भवेत ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005498026, "chapter_id": 25498, "verse_number": "२-१५-२७", "content_sanskrit": "क्षमा दया च विज्ञानं सत्यं चैव दमः शमः ।\nअध्यात्मनिरतं ज्ञानमेतद ब्राह्मणलक्षणम ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005498027, "chapter_id": 25498, "verse_number": "२-१५-२८", "content_sanskrit": "एतस्मान्न प्रमाद्येत विशेषेण द्विजोत्तमः ।\nयथाशक्ति चरण कर्म निन्दितानि विवर्जयेत ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005498028, "chapter_id": 25498, "verse_number": "२-१५-२९", "content_sanskrit": "विधुय मोहकलिलं लध्वा योगमनुत्तमम ।\nगृहस्थो मुच्यते बन्धात नात्र कार्या विचारणा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005498029, "chapter_id": 25498, "verse_number": "२-१५-३०", "content_sanskrit": "विगर्हातिक्रमाक्षेपहिंसाबन्धवधात्मनाम ।\nअन्यमन्युसमुत्थानां दोषाणां मर्षण क्षमा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005498030, "chapter_id": 25498, "verse_number": "२-१५-३१", "content_sanskrit": "स्वदुःखेष्विव कारुण्यं परदुःखेषु सौहृदात ।\nदयेति मुनयः प्राहुः साक्षाद धर्मस्य साधनम ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005498031, "chapter_id": 25498, "verse_number": "२-१५-३२", "content_sanskrit": "चतुर्दशानां विद्यानां धारणं हि यथार्थतः ।\nविज्ञानामिति तद विद्याद येन धर्मो विवर्धते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005498032, "chapter_id": 25498, "verse_number": "२-१५-३३", "content_sanskrit": "अधीत्य विधिवद विद्यामर्थ चैवोपलभ्यं तु ।\nधर्मकार्यान्निवृत्तश्‍चेन्न तद विज्ञानमिष्यति ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005498033, "chapter_id": 25498, "verse_number": "२-१५-३४", "content_sanskrit": "सत्येन लोकात्र्जयति सत्यं तत्परमं पदम ।\nयथाभूतप्रवादं तु सत्यमाहुर्मनीषिणः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005498034, "chapter_id": 25498, "verse_number": "२-१५-३५", "content_sanskrit": "दमः शरीरोपरमः शमः प्रज्ञाप्रसादजः ।\nअध्यात्ममक्षरं विद्याद यत्र गत्वा न शोचति ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005498035, "chapter_id": 25498, "verse_number": "२-१५-३६", "content_sanskrit": "यया स देवो भगवान विद्यया वेद्यते परः ।\nसाक्षाद देवो महादेवस्तज्ज्ञकनमिति कीर्तितम ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005498036, "chapter_id": 25498, "verse_number": "२-१५-३७", "content_sanskrit": "तन्निष्ठस्तप्तरो विद्वान्नित्यमक्रोधन शुचि ।\nमहायज्ञपरो विप्रो लभते तदनुत्तमम ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005498037, "chapter_id": 25498, "verse_number": "२-१५-३८", "content_sanskrit": "धर्मस्यायतनं यत्नाच्छरीरं परिपालयेत ।\nन हि देहं विना रुद्रः पुरुषैर्विद्यते परः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005498038, "chapter_id": 25498, "verse_number": "२-१५-३९", "content_sanskrit": "नित्यं धर्मार्थकामेषुअ युज्येत नियतो द्विजः ।\nन धर्मवर्जितं काममर्थं वा मनसा स्मरेत ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005498039, "chapter_id": 25498, "verse_number": "२-१५-४०", "content_sanskrit": "सीदन्नपि हि धर्मेण न त्वधर्मे समाचरेत ।\nधर्मो हि भगवान देवो गतिः सर्वेषु जन्तुषु ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005498040, "chapter_id": 25498, "verse_number": "२-१५-४१", "content_sanskrit": "भूतानां प्रियकारी स्यात न परद्रोहकर्माधीः ।\nन वेददेवतानिन्दाम कुर्यात तैश्च न संवसेत ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005498041, "chapter_id": 25498, "verse_number": "२-१५-४२", "content_sanskrit": "यस्त्विमं नियतं विप्रो धर्माध्यायं पठेच्युति ।\nअध्यापतेत श्रावयेद वा ब्रह्मालोक महीयते ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]