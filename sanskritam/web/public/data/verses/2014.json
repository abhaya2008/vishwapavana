[{"id": 2045625, "chapter_id": 2014, "verse_number": "६-६३-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2045626, "chapter_id": 2014, "verse_number": "६-६३-१", "content_sanskrit": "हते तस्मिन्गजानीके पुत्रो दुर्योधनस्तव।\nभीमसेनं ध्नतेत्येवं सर्वसैन्यान्यचोदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2045627, "chapter_id": 2014, "verse_number": "६-६३-२", "content_sanskrit": "ततः सर्वाण्यनीकानि तव पुत्रस्य शासनात्।\nअभ्यद्रवन्भीमसेनं नदन्तं भैरवान्रवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2045628, "chapter_id": 2014, "verse_number": "६-६३-३", "content_sanskrit": "तं बलौघमपर्यन्तं देवैरपि सुदुःसहम् ।\nआपतन्तं सुदुष्पारं समुद्रिमिव पर्वणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2045629, "chapter_id": 2014, "verse_number": "६-६३-४", "content_sanskrit": "रथनागाश्वकलिलं शङ्खदुन्दुभिनादितम् ।\nअनन्तरथपादातं रजसा सर्वतो वृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2045630, "chapter_id": 2014, "verse_number": "६-६३-५", "content_sanskrit": "तं भीमसेनः समरे महोदधिमिवापरम् ।\nसेनासागरमक्षोभ्यं वेलेव समवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2045631, "chapter_id": 2014, "verse_number": "६-६३-६", "content_sanskrit": "तदाश्चर्यमपश्याम पाण्डवस्य महात्मनः ।\nभीमसेनस्य समरे राजन्कर्मातिमानुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2045632, "chapter_id": 2014, "verse_number": "६-६३-७", "content_sanskrit": "उदीर्णान्पार्थिवान्सर्वान्साश्वान्सरथकुञ्जरान् ।\nअसंभ्रमं भीमसेनो गदया समवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2045633, "chapter_id": 2014, "verse_number": "६-६३-८", "content_sanskrit": "स संवार्य बलौघांस्तन्गदया रथिनां वरः।\nअतिष्ठत्तुमुले भीमो गिरिर्मेरुरिवाचलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2045634, "chapter_id": 2014, "verse_number": "६-६३-९", "content_sanskrit": "तस्मिन्सुतुमुले घोरे काले परमदारुणे।\nभ्रातरश्चैव पुत्राश्च धृष्टद्युम्नश्च पार्षतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2045635, "chapter_id": 2014, "verse_number": "६-६३-१०", "content_sanskrit": "द्रौपदेयाभिमन्युश्च शिखण्डी चापराजितः ।\nन प्राजहन्भीमसेनं भये जाते महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2045636, "chapter_id": 2014, "verse_number": "६-६३-११", "content_sanskrit": "ततः शैक्यायसीं गुर्वीं प्रगृह्य महतीं गदाम्।\nअधावत्तावकान्योधान्दण्डपाणिरिवान्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2045637, "chapter_id": 2014, "verse_number": "६-६३-१२", "content_sanskrit": "पोययन्रथबृन्दानि वाजिबृन्दनि चाभिभूः ।\nकर्षयन्रथवृन्दानि बाहुवेगेन पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2045638, "chapter_id": 2014, "verse_number": "६-६३-१३", "content_sanskrit": "विनिध्रन्यचतत्सङ्ख्ये युगान्ते कालविद्विभुः ।\nऊरुवेगेन संकर्षन्रथजालानि पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2045639, "chapter_id": 2014, "verse_number": "६-६३-१४", "content_sanskrit": "बलानि संममर्दाशु नड्वलानीव कुञ्जरः ।\nमृद्गन्रथेभ्यो रथिनो गजेभ्यो गजयोधिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2045640, "chapter_id": 2014, "verse_number": "६-६३-१५", "content_sanskrit": "सादिनश्चाश्वपृष्ठेभ्यो भूमौ वापि पदातिनः ।\nगदया व्यवमत्सर्वान्वातो वृक्षानिवौजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2045641, "chapter_id": 2014, "verse_number": "६-६३-१६", "content_sanskrit": "भीमसेनो महाबाहुस्तव पुत्रस्य वै बले।\nसापि प्रञ्जानसामासैः प्रदिग्धा रुधिरेण च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2045642, "chapter_id": 2014, "verse_number": "६-६३-१७", "content_sanskrit": "अदृश्यत महारौद्रा गदा नागाश्वपातनी।\nतत्रतत्र हतैश्चापि मनुष्यगजवाजिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2045643, "chapter_id": 2014, "verse_number": "६-६३-१८", "content_sanskrit": "रणाङ्गणं समभवन्मृत्योरावाससन्निभम् ।\nपिनाकमिव रुद्रस्य क्रुद्धस्याभिघ्नतः पशून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2045644, "chapter_id": 2014, "verse_number": "६-६३-१९", "content_sanskrit": "यमदण्डोपमामुग्रामिन्द्राशनिसमस्वनाम् ।\nददृशुर्भीमसेनस्य रौद्रां विशसनीं गदाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2045645, "chapter_id": 2014, "verse_number": "६-६३-२०", "content_sanskrit": "आविध्यतो गदां तस्य कौन्तेयस्य महात्मनः ।\nबभौ रूपं महाघोरं कालस्येव युगक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2045646, "chapter_id": 2014, "verse_number": "६-६३-२१", "content_sanskrit": "तं तथा महतीं सेनां द्रावयन्तं पुनः पुनः ।\nदृष्ट्वा मृत्युमवायान्तं सर्वे विमनसोऽभवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2045647, "chapter_id": 2014, "verse_number": "६-६३-२२", "content_sanskrit": "यतोयतः प्रेक्षते स्म गदामुद्यम्य पाण्डवः।\nतेनतेन स्म दीर्यन्ते सर्वसैन्यानि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2045648, "chapter_id": 2014, "verse_number": "६-६३-२३", "content_sanskrit": "प्रदारयन्तं सैन्यानि बलेनामितविक्रमम् ।\nग्रसमानमनीकानि व्यादितास्यमिवान्तकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2045649, "chapter_id": 2014, "verse_number": "६-६३-२४", "content_sanskrit": "तं तथा भीमकर्माणं प्रगृहीतमहागदम् ।\nदृष्ट्वा वृकोदरं भीष्मः सहसैव समभ्ययात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2045650, "chapter_id": 2014, "verse_number": "६-६३-२५", "content_sanskrit": "महता रथघोषेण रथेनादित्यवर्चसा ।\nछादयञ्शरवर्षेण पर्जन्य इव वृष्टिमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2045651, "chapter_id": 2014, "verse_number": "६-६३-२६", "content_sanskrit": "तमायान्तं तथा दृष्ट्वा व्यात्ताननमिवान्तकम् ।\nभीष्मं भीमो महाबाहुः प्रत्युदीयादमर्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2045652, "chapter_id": 2014, "verse_number": "६-६३-२७", "content_sanskrit": "तस्मिन्क्षणे सात्यकिः सत्यसन्धः\nशिनिप्रवीरोऽभ्यपतत्पितामहम्।\nनिघ्नन्नमित्रान्धनुषा दृढेन\nसंकम्पयंस्तव पुत्रस्य सैन्यम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2045653, "chapter_id": 2014, "verse_number": "६-६३-२८", "content_sanskrit": "तं यान्तमश्वै रजतप्रकाशैः\nशरान्वपन्तं निशितान्सुपुङ्खान्।\nनाशक्नवन्धारयितुं तदानीं\nसर्वे गणा भारत ये त्वदीयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2045654, "chapter_id": 2014, "verse_number": "६-६३-२९", "content_sanskrit": "अविध्यदेनं दशभिः पृषत्कैः-\nरलम्बुसो राक्षसोऽसौ तदानीम् ।\nशरैश्चतुर्भिः प्रतिविद्ध्य तं च\nनप्ता शिनेरभ्यपतद्रथेन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2045655, "chapter_id": 2014, "verse_number": "६-६३-३०", "content_sanskrit": "अन्वागतं वृष्णिवरं निशम्य\nतं शत्रुमध्ये परिवर्तमानम्।\nप्रद्रावयन्तं कुरुपुङ्गवांश्च\nपुनः पुनश्च प्रणदन्तमाजौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2045656, "chapter_id": 2014, "verse_number": "६-६३-३१", "content_sanskrit": "योधास्त्वदीयाः शरवर्षैरवर्ष-\nन्मेघा यथा भूधरमम्बुवेगैः ।\nतथापि तं धारयितुं न शेकु-\nर्मध्यंदिने सूर्यमिवातपन्तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2045657, "chapter_id": 2014, "verse_number": "६-६३-३२", "content_sanskrit": "न तत्र कश्चिन्नविषण्ण आसी-\nदृते राजन्सोमदत्तस्य पुत्रात्।\nस वै समादाय धनुर्महात्मा\nभिरिश्रवा भारत सौमदत्तिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2045658, "chapter_id": 2014, "verse_number": "६-६३-३३", "content_sanskrit": "दृष्ट्वा रथान्स्वान्व्यपनीयमाना-\nन्प्रत्युद्ययौ सात्यकिं योद्धुमिच्छन् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2045659, "chapter_id": 2014, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि चतुर्थदिवसयुद्धे त्रिषष्टितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]