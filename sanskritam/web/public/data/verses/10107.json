[{"id": 6000107000, "chapter_id": 10107, "verse_number": null, "content_sanskrit": "अथ द्वादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000107001, "chapter_id": 10107, "verse_number": null, "content_sanskrit": "रहूगण उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_012/BhP_05.012.001.m4a", "display_order": 2}, {"id": 6000107002, "chapter_id": 10107, "verse_number": "५-१२-१", "content_sanskrit": "नमो नमः कारणविग्रहाय स्वरूपतुच्छीकृतविग्रहाय।\nनमोऽवधूतद्विजबन्धुलिङ्गनिगूढनित्यानुभवाय तुभ्यम्॥ ५/१२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_012/BhP_05.012.002.m4a", "display_order": 3, "topics": [{"text": "पुनस्तेन राज्ञा स्वसंशयान्पृष्टेन जडभरतेन राज्ञे ज्ञानोपदेशः", "range": "१–१३"}]}, {"id": 6000107003, "chapter_id": 10107, "verse_number": "५-१२-२", "content_sanskrit": "ज्वरामयार्तस्य यथाऽगदं सन् निदाघदग्धस्य यथा हिमाम्भः।\nकुदेहमानाहिविनष्टदृष्टेर्ब्रह्मन् वचस्तेऽमृतमौषधं मे॥ ५/१२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_012/BhP_05.012.003.m4a", "display_order": 4}, {"id": 6000107004, "chapter_id": 10107, "verse_number": "५-१२-३", "content_sanskrit": "तस्माद्भवन्तं मम संशयार्थं पृच्छामि पश्चादधुना सुबोधम्।\nअध्यात्मयोगग्रथितं पुरोक्तमाख्याहि कौतुहलचेतसो मे॥ ५/१२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_012/BhP_05.012.004.m4a", "display_order": 5}, {"id": 6000107005, "chapter_id": 10107, "verse_number": "५-१२-४", "content_sanskrit": "यदाह योगेश्वर दृश्यमानं क्रियाफलं सद्व्यवहारमूलम्।\nन ह्यञ्जसा तत्त्वविमर्शनाय भवानमुष्मिन्भ्रमते मनो मे॥ ५/१२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_012/BhP_05.012.005.m4a", "display_order": 6}, {"id": 6000107006, "chapter_id": 10107, "verse_number": null, "content_sanskrit": "ब्राह्मण उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_012/BhP_05.012.006.m4a", "display_order": 7}, {"id": 6000107007, "chapter_id": 10107, "verse_number": "५-१२-५", "content_sanskrit": "अयं जनो नाम चलन्पृथिव्यां यः पार्थिवः पार्थिव कस्य हेतोः।\nतस्यापि चाङ्घ्र्योरधि गुल्फजङ्घाजानूरुमध्योरःशिरोधरांसाः॥ ५/१२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_012/BhP_05.012.007.m4a", "display_order": 8}, {"id": 6000107008, "chapter_id": 10107, "verse_number": "५-१२-६", "content_sanskrit": "अंसे च दार्वी शिबिका च यस्यां सौवीरराजेत्यपदेश आस्ते।\nयस्मिन्भवान् रूढनिजाभिमानो राजाऽस्मि सिन्धुष्विति दुर्मदान्धः॥ ५/१२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_012/BhP_05.012.008.m4a", "display_order": 9}, {"id": 6000107009, "chapter_id": 10107, "verse_number": "५-१२-७", "content_sanskrit": "शोच्यानिमांस्तानधिकस्तवाधिर्विष्ट्या निगृह्णन्निरनुग्रहोऽसि।\nजनस्य गोप्तेति विकत्थमानो न शोभसे वृद्धसभासु दुष्टः॥ ५/१२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_012/BhP_05.012.009.m4a", "display_order": 10}, {"id": 6000107010, "chapter_id": 10107, "verse_number": "५-१२-८", "content_sanskrit": "यदि क्षितावेव चराचरस्य विदाम निष्ठां प्रभवं च नित्यम्।\nतन्नामतोऽन्यद्व्यवहारमात्रं निरूप्यतां तत्क्रिययाऽनुमेयम्॥ ५/१२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_012/BhP_05.012.010.m4a", "display_order": 11}, {"id": 6000107011, "chapter_id": 10107, "verse_number": "५-१२-९", "content_sanskrit": "एवं निरुक्तं क्षितिशब्दवृत्तम् असन्निधानं परमाणवो ये।\nअविद्यया मनसा कल्पितास्ते येषां समूहेन कृतो विशेषः॥ ५/१२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_012/BhP_05.012.011.m4a", "display_order": 12}, {"id": 6000107012, "chapter_id": 10107, "verse_number": "५-१२-१०", "content_sanskrit": "एवं कृशं स्थूलमणुर्बृहृद्यदसच्च सज्जीवमजीवमन्यत्।\nद्रव्यस्वभावाशयकालकर्मनाम्न्याऽजयाऽवैहि कृतं द्वितीयम्॥ ५/१२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_012/BhP_05.012.012.m4a", "display_order": 13}, {"id": 6000107013, "chapter_id": 10107, "verse_number": "५-१२-११", "content_sanskrit": "ज्ञानं विशुद्धं परमार्थमेकमनन्तरं न बहिर्ब्रह्म सत्यम्।\nप्रत्यक् प्रशान्तं भगवच्छब्दवाच्यं यद्वासुदेवं कवयो वदन्ति॥ ५/१२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_012/BhP_05.012.013.m4a", "display_order": 14}, {"id": 6000107014, "chapter_id": 10107, "verse_number": "५-१२-१२", "content_sanskrit": "रहूगणैतत्तपसा न याति न विद्यया निर्वसनाद्‌ गृहाद्वा।\nन छन्दसा नोत जलाग्निसूर्यैर्विना महत्पादरजोभिषेकम्॥ ५/१२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_012/BhP_05.012.014.m4a", "display_order": 15}, {"id": 6000107015, "chapter_id": 10107, "verse_number": "५-१२-१३", "content_sanskrit": "यत्रोत्तमश्लोकगुणानुवादः प्रस्तूयते ग्राम्यकथाविघातः।\nनिषेव्यमाणोऽनुदिनं मुमुक्षोर्मतिं सतीं यच्छति वासुदेवे॥ ५/१२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_012/BhP_05.012.015.m4a", "display_order": 16}, {"id": 6000107016, "chapter_id": 10107, "verse_number": "५-१२-१४", "content_sanskrit": "अहं पुरा भरतो नाम राजा विमुक्तदृष्टश्रुतसङ्गबन्धः।\nआराधनं भगवत ईहमानो मृगोऽभवं मृगसङ्गाद्धतार्थः॥ ५/१२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_012/BhP_05.012.016.m4a", "display_order": 17, "topics": [{"text": "तत्सन्देहापनुत्त्यर्थं स्वस्य पूर्वजन्मनि हरिणजन्मप्राप्तिकथनेन दुःसङ्गस्य त्याज्यत्वकथनम्", "range": "१४–१६"}]}, {"id": 6000107017, "chapter_id": 10107, "verse_number": "५-१२-१५", "content_sanskrit": "सा मां स्मृतिर्मृगदेहेऽपि वीर कृष्णार्चनप्रभवा नो जहाति।\nअथो अहं जनसङ्गाद्विमुक्तो विशङ्कमानोऽवधूतश्चरामि॥ ५/१२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_012/BhP_05.012.017.m4a", "display_order": 18}, {"id": 6000107018, "chapter_id": 10107, "verse_number": "५-१२-१६", "content_sanskrit": "तस्मान्नरोऽसङ्गसुसङ्गजातज्ञानासिनैवेह विवृक्णसङ्गः।\nहरिं तदीहाकथनश्रुतिभ्यां लब्धस्मृतिर्यात्यति पारमध्वनः॥ ५/१२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_012/BhP_05.012.018.m4a", "display_order": 19}, {"id": 6000107019, "chapter_id": 10107, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां पञ्चमस्कन्धे द्वादशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]