[{"id": 2001139, "chapter_id": 1012, "verse_number": "१-१३-०x", "content_sanskrit": "शौनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001140, "chapter_id": 1012, "verse_number": "१-१३-१", "content_sanskrit": "किमर्थं राजशार्दूलः स राजा जनमेजयः।\nसर्पसत्रेण सर्पाणां गतोऽन्तं तद्वदस्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001141, "chapter_id": 1012, "verse_number": "१-१३-२", "content_sanskrit": "निखिलेन यथातत्त्वं सौते सर्वमशेषतः।\nआस्तीकश्च द्विजश्रेष्ठः किमर्थं जपतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001142, "chapter_id": 1012, "verse_number": "१-१३-३", "content_sanskrit": "मोक्षयामास भुजगान्प्रदीप्ताद्वसुरेतसः।\nकस्य पुत्रः स राजासीत्सर्पसत्रं य आहरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001143, "chapter_id": 1012, "verse_number": "१-१३-४", "content_sanskrit": "स च द्विजातिप्रवरः कस्य पुत्रोऽभिधत्स्व मे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001144, "chapter_id": 1012, "verse_number": "१-१३-४x", "content_sanskrit": "सौतिरुवाच।\nमहदाक्यानमास्तीकं यथैतत्प्रोच्यते द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001145, "chapter_id": 1012, "verse_number": "१-१३-५", "content_sanskrit": "सर्वमेतदशेषेण शृणु मे वदतां वर।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001146, "chapter_id": 1012, "verse_number": "१-१३-५x", "content_sanskrit": "शौनक उवाच।\nश्रोतुमिच्छाम्यशेषेण कथामेतां मनोरमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001147, "chapter_id": 1012, "verse_number": "१-१३-६", "content_sanskrit": "आस्तीकस्य पुराणर्षेर्ब्राह्मणस्य यशस्विनः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001148, "chapter_id": 1012, "verse_number": "१-१३-६x", "content_sanskrit": "सौतिरुवाच।\nइतिहासमिमं विप्राः पुराणं परिचक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001149, "chapter_id": 1012, "verse_number": "१-१३-७", "content_sanskrit": "कृष्णद्वैपायनप्रोक्तं नैमिषारण्यवासिषु।\nपूर्वं प्रचोदितः सूतः पिता मे लोमहर्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001150, "chapter_id": 1012, "verse_number": "१-१३-८", "content_sanskrit": "शिष्यो व्यासस्य मेधावी ब्राह्मणेष्विदमुक्तवान्।\nतस्मादहमुपश्रुत्य प्रवक्ष्यामि यथातथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001151, "chapter_id": 1012, "verse_number": "१-१३-९", "content_sanskrit": "इदमास्तीकमाख्यानं तुभ्यं शौनक पृच्छते।\nकथयिष्याम्यशेषेण सर्वपापप्रणाशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2001152, "chapter_id": 1012, "verse_number": "१-१३-१०", "content_sanskrit": "आस्तीकस्य पिता ह्यासीत्प्रजापतिसमः प्रभुः।\nब्रह्मचारी यताहारस्तपस्युग्रे रतः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2001153, "chapter_id": 1012, "verse_number": "१-१३-११", "content_sanskrit": "जरत्कारुरिति ख्यात ऊर्ध्वरेता महातपाः।\nयायावराणां प्रवरो धर्मज्ञः संशितव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2001154, "chapter_id": 1012, "verse_number": "१-१३-१२", "content_sanskrit": "स कदाचिन्महाभागस्तपोबलसमन्वितः।\nचचार पृथिवीं सर्वां यत्रसायंगृहो मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2001155, "chapter_id": 1012, "verse_number": "१-१३-१३", "content_sanskrit": "तीर्थेषु च समाप्लावं कुर्वन्नटति सर्वशः।\nचरन्दीक्षां महातेजा दुश्चरामकृतात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2001156, "chapter_id": 1012, "verse_number": "१-१३-१४", "content_sanskrit": "वायुभक्षो निराहारः शुष्यन्ननिमिषो मुनिः।\nइतस्ततः परिचरन्दीप्तपावकसप्रभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2001157, "chapter_id": 1012, "verse_number": "१-१३-१५", "content_sanskrit": "अटमानः कदाचित्स्वान्स ददर्श पितामहान्।\nलम्बमानान्महागर्ते पादैरूर्ध्वैरवाङ्मुखान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2001158, "chapter_id": 1012, "verse_number": "१-१३-१६", "content_sanskrit": "तानब्रवीत्स दृष्ट्वै जरत्कारुः पितामहान्।\nके भवन्तोऽवलम्बन्ते गर्ते ह्यस्मिन्नधोमुखाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2001159, "chapter_id": 1012, "verse_number": "१-१३-१७", "content_sanskrit": "वीरणस्तम्भके लग्नाः सर्वतः परिभक्षिते।\nमूषकेन निगूढेन गर्तेऽस्मिन्नित्यवासिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2001160, "chapter_id": 1012, "verse_number": "१-१३-१८x", "content_sanskrit": "पितर ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2001161, "chapter_id": 1012, "verse_number": "१-१३-१८", "content_sanskrit": "यायावरा नाम वयमृषयः संशितव्रताः।\nसंतानप्रक्षयाद्ब्रह्मन्नधो गच्छाम मेदिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2001162, "chapter_id": 1012, "verse_number": "१-१३-१९", "content_sanskrit": "अस्माकं संततिस्त्वेको जरत्कारुरिति स्मृतः।\nमन्दभाग्योऽल्पभाग्यानां तप एकं समास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2001163, "chapter_id": 1012, "verse_number": "१-१३-२०", "content_sanskrit": "न स पुत्राञ्जनयितुं दारान्मूढश्चिकीर्षति।\nतेन लम्बामहे गर्ते संतानस्य क्षयादिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2001164, "chapter_id": 1012, "verse_number": "१-१३-२१", "content_sanskrit": "अनाथास्तेन नाथेन यथा दुष्कृतिनस्तथा।\nयेषां तु संततिर्नास्ति मर्त्यलोके सुखावहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2001165, "chapter_id": 1012, "verse_number": "१-१३-२२", "content_sanskrit": "न ते लभन्ते वसतिं स्वर्गे पुण्यकृतोऽपि हि।\nकस्त्वं बन्धुरिवास्माकमनुशोचसि सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2001166, "chapter_id": 1012, "verse_number": "१-१३-२३", "content_sanskrit": "ज्ञातुमिच्छामहे ब्रह्मन्को भवानिह नः स्थितः।\nकिमर्थं चैव नः शोच्याननुशोचसि सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2001167, "chapter_id": 1012, "verse_number": "१-१३-२४x", "content_sanskrit": "जरत्कारुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2001168, "chapter_id": 1012, "verse_number": "१-१३-२४", "content_sanskrit": "मम पूर्वे भवन्तो वै पितरः सपितामहाः।\nब्रूत किं करवाण्यद्य जरत्कारुरहं स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2001169, "chapter_id": 1012, "verse_number": "१-१३-२५x", "content_sanskrit": "पितर ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2001170, "chapter_id": 1012, "verse_number": "१-१३-२५", "content_sanskrit": "यतस्व यत्नवांस्तात संतानाय कुलस्य नः।\nआत्मनोऽर्थेऽस्मदर्थे च धर्म इत्येव वा विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2001171, "chapter_id": 1012, "verse_number": "१-१३-२६", "content_sanskrit": "न हि धर्मफलैस्तात न तपोऽभिः सुसंचितैः।\nतां गतिं प्राप्नुवन्तीह पुत्रिणो यां व्रजन्ति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2001172, "chapter_id": 1012, "verse_number": "१-१३-२७", "content_sanskrit": "तद्दारग्रहणे यत्नं संतत्यां च मनः कुरु।\nपुत्रकास्मन्नियोगात्त्वमेतन्नः परमं हितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2001173, "chapter_id": 1012, "verse_number": "१-१३-२८x", "content_sanskrit": "जरत्कारुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2001174, "chapter_id": 1012, "verse_number": "१-१३-२८", "content_sanskrit": "न दारान्वै करिष्येऽहं न धनं जीवितार्थतः।\nभवतां तु हितार्थाय करिष्ये दारसंग्रहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2001175, "chapter_id": 1012, "verse_number": "१-१३-२९", "content_sanskrit": "समयेन च कर्ताऽहमनेन विधिपूर्वकम्।\nतथा यद्युपलप्स्यामि करिष्ये नान्यथा ह्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2001176, "chapter_id": 1012, "verse_number": "१-१३-३०", "content_sanskrit": "सनाम्नी या भवित्री मे दित्सिता चैव बन्धुभिः।\nभैक्ष्यवत्तामहं कन्यामुपयंस्ये विधानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2001177, "chapter_id": 1012, "verse_number": "१-१३-३१", "content_sanskrit": "दरिद्राय हि मे भार्यां को दास्यति विशेषतः।\nप्रतिग्रहीष्ये भिक्षां तु यदि कश्चित्प्रदास्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2001178, "chapter_id": 1012, "verse_number": "१-१३-३२", "content_sanskrit": "एवं दारक्रियाहेतोः प्रयतिष्ये पितामहाः।\nअनेन विधिना शश्वन्न करिष्येऽहमन्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2001179, "chapter_id": 1012, "verse_number": "१-१३-३३", "content_sanskrit": "तत्र चोत्पत्स्यते जन्तुर्भवतां तारणाय वै।\nशाश्वतं स्थानमासाद्य मोदन्तां पितरो मम॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2001180, "chapter_id": 1012, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि त्रयोदशोऽध्यायः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]