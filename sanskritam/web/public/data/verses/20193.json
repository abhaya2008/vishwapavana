[{"id": 7000193000, "chapter_id": 20193, "verse_number": "१९३-१", "content_sanskrit": "कुब्जोद्धारवर्णनम् व्यास उवाच राजमार्गे ततः कृष्णः सानुलेपनभाजनाम् ।\nददर्श कुब्जामायान्तीं नवयौवनगोचराम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000193001, "chapter_id": 20193, "verse_number": "१९३-२", "content_sanskrit": "तामाह ललितं कृष्णं कस्येदमनुलेपनम् ।\nभवत्या नीयते सत्यं वदेन्दीवरलोचने ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000193002, "chapter_id": 20193, "verse_number": "१९३-३", "content_sanskrit": "सकामेनैव सा प्रोक्ता सानुरागा हरिं प्रति ।\nप्राह सा ललितं कुब्जा ददर्श च बलात्ततः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000193003, "chapter_id": 20193, "verse_number": "१९३-४", "content_sanskrit": "कुब्जोवाच कान्त कस्मान्न जानासि कंसेनापि नियोजिता ।\nनैकवक्रेति विख्यातामनुलेपनकर्मणि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000193004, "chapter_id": 20193, "verse_number": "१९३-५", "content_sanskrit": "नान्यपिष्टं हि कंसस्य प्रीतये ह्यनुलेपनम् ।\nभवत्यहमतीवास्य प्रसादधनभाजनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000193005, "chapter_id": 20193, "verse_number": "१९३-६", "content_sanskrit": "श्रीकृष्ण उवाच सुगन्धमेतद्राजार्हं रुचिरं रुचिरानने ।\nआवयोर्गात्रसदृशं दीयतामनुलेपनम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000193006, "chapter_id": 20193, "verse_number": "१९३-७", "content_sanskrit": "व्यास उवाच श्रुत्वा तमाह सा कृष्णं गृह्यतामिति सादरम् ।\nअनुलेपं च प्रददौ गात्रयोग्यमथोभयोः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000193007, "chapter_id": 20193, "verse_number": "१९३-८", "content_sanskrit": "भक्तिच्छेदानुलिप्ताङ्गौ ततस्तौ पुरुषर्षभौ ।\nसेन्द्रचापौ विराजन्तौ सितकृष्णाविवाम्बुदौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000193008, "chapter_id": 20193, "verse_number": "१९३-९", "content_sanskrit": "ततस्तां चिबुके शौरिरुल्लापनविधानवित् ।\nउल्लाप्य तोलयामास द्व्यङ्गुलेनाग्रपाणिना ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000193009, "chapter_id": 20193, "verse_number": "१९३-१०", "content_sanskrit": "चकर्ष पद्भ्यां च तदा ऋजुत्वं केशवोऽनयत् ।\nततः सा ऋजुतां प्राप्ता योषितामभवद्वरा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000193010, "chapter_id": 20193, "verse_number": "१९३-११", "content_sanskrit": "विलासललितं प्राह प्रेमगर्भभरालसम् ।\nवस्त्रे प्रगृह्य गोविन्दं व्रज गेहं ममेति वै ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000193011, "chapter_id": 20193, "verse_number": "१९३-१२", "content_sanskrit": "आयास्ये भवतीगेहमिति तां प्राह केशवः ।\nविससर्ज जहासोच्चै रामस्याऽऽलोक्य चाऽऽननम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000193012, "chapter_id": 20193, "verse_number": "१९३-१३", "content_sanskrit": "भक्तिच्छेदानुलिप्ताङ्गौ नीलपीताम्बरावुभौ ।\nधनुःशालं ततो यातौ चित्रमाल्योपसोभितौ ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000193013, "chapter_id": 20193, "verse_number": "१९३-१४", "content_sanskrit": "अध्यास्य च धनूरत्नं ताभ्यां पृष्टैस्तु रक्षिभिः ।\nआख्यातं सहसा कृष्णो गृहीत्वाऽपूरयद्धनुः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000193014, "chapter_id": 20193, "verse_number": "१९३-१५", "content_sanskrit": "ततः पूरयता तेन भज्यमानं बलाद्धनुः ।\nचकारातिमहाशब्दं मथुरा तेन पूरिता ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000193015, "chapter_id": 20193, "verse_number": "१९३-१६", "content_sanskrit": "अनुयुक्तौ ततस्तौ च भग्ने धनुषि रक्षिभिः ।\nरक्षिसैन्यं निकृत्योभौ निष्क्रान्तौ कार्मुकालयात् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000193016, "chapter_id": 20193, "verse_number": "१९३-१७", "content_sanskrit": "अक्रूरागमवृत्तान्तमुपलभ्य तथा धनुः ।\nभग्नं श्रुत्वाऽथ कंसोऽपि प्राह चाणूरमुष्टिकौ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000193017, "chapter_id": 20193, "verse_number": "१९३-१८", "content_sanskrit": "कंस उवाच गोपालदारकौ प्राप्तौ भवद्भ्यां तौ ममाग्रतः ।\nमल्लयुद्धेन हन्तव्यौ मम प्राणहरौ हि तौ ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000193018, "chapter_id": 20193, "verse_number": "१९३-१९", "content_sanskrit": "नियुद्धे तद्विनाशेन भवद्‌भ्यां तोषितो ह्यहम् ।\nदास्याम्यभिमतान्कामान्नान्यथैतन्महाबलौ ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000193019, "chapter_id": 20193, "verse_number": "१९३-२०", "content_sanskrit": "न्यायतोऽन्यायतो वाऽपि भवद्‌भ्यां तौ ममाहितौ ।\nहन्तव्यौ तद्वधाद्राज्यं सामान्यं वो भविष्यति ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000193020, "chapter_id": 20193, "verse_number": "१९३-२१", "content_sanskrit": "व्यास उवाच इत्यादिस्य स तौ मल्लौ ततश्चाऽहूय हस्तिपम् ।\nप्रोवाचोच्चैस्त्वया मत्तः समाजद्वारि कुञ्जरः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000193021, "chapter_id": 20193, "verse_number": "१९३-२२", "content_sanskrit": "स्थाप्यः कुवलयापीडस्तेन तौ गोपदारकौ ।\nघातनीयौ नियुद्धाय रङ्गद्वारमुपागतौ ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000193022, "chapter_id": 20193, "verse_number": "१९३-२३", "content_sanskrit": "तमाज्ञाप्याथ दृष्ट्वा च मञ्चान्सर्वानुपाहृतान् ।\nआसन्नमरणः कंसः सूर्योदयमुदैक्षत ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000193023, "chapter_id": 20193, "verse_number": "१९३-२४", "content_sanskrit": "ततः समस्तमञ्चेषु नागरः स तदा जनः ।\nराजमञ्चेषु चाऽऽरूढाः सह भृत्यैर्महीभृतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000193024, "chapter_id": 20193, "verse_number": "१९३-२५", "content_sanskrit": "मल्लप्राश्निकवर्गश्च रङ्गमध्ये समीपगः ।\nकृतः कंसेन कंसोऽपि तुङगमञ्चे व्यवस्तितः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000193025, "chapter_id": 20193, "verse_number": "१९३-२६", "content_sanskrit": "अन्तःपुराणां मञ्चाश्च यथाऽन्ये परिकल्पिताः ।\nअन्ये च वारमुख्यानामन्ये नगरयोषिताम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000193026, "chapter_id": 20193, "verse_number": "१९३-२७", "content_sanskrit": "नन्दगोपादयो गोपा मञ्चेष्वन्येष्ववस्तिताः ।\nअक्रूरवसुदेवौ च मञ्चप्रान्ते व्यवस्थितौ ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000193027, "chapter_id": 20193, "verse_number": "१९३-२८", "content_sanskrit": "नगरीयोषितां मध्ये देवकी पुत्रगर्धिनी ।\nअन्तकालेऽपि पुत्रस्य द्रक्ष्यामीति मुखं स्थिता ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000193028, "chapter_id": 20193, "verse_number": "१९३-२९", "content_sanskrit": "वाद्यमानेषु तूर्येषु चाणूरे चातिवल्गति ।\nहाहाकारपरे लोक आस्फोटयति मुष्टिके ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000193029, "chapter_id": 20193, "verse_number": "१९३-३०", "content_sanskrit": "हत्वा कुवलयापीडं हस्त्यारोहप्रचोदितम् ।\nमदासृगनुलिप्ताङ्गौ गजदन्तवरायुधौ ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000193030, "chapter_id": 20193, "verse_number": "१९३-३१", "content_sanskrit": "मृगमध्ये यथा सिंहौ गर्वलीलावलोकिनौ ।\nप्रविष्टौ सुमहारङ्गं बलदेवजनार्दनौ ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000193031, "chapter_id": 20193, "verse_number": "१९३-३२", "content_sanskrit": "हाहाकारो महाञ्जज्ञे सर्वरङ्गेष्वनन्तरम् ।\nकृष्णोऽयं बलभद्रोऽयमति लोकस्य विस्मयात् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000193032, "chapter_id": 20193, "verse_number": "१९३-३३", "content_sanskrit": "सोऽयं येन हता घोरा पूतना सा निशाचरी ।\nप्रक्षिप्तं शकटं येन भग्नौ च यमलार्जुनौ ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000193033, "chapter_id": 20193, "verse_number": "१९३-३४", "content_sanskrit": "सोऽयं यः कालियं नागं ननर्ताऽऽरुह्य बालकः ।\nधृतो गोवर्धनो येन सप्तरात्रं महागिरिः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000193034, "chapter_id": 20193, "verse_number": "१९३-३५", "content_sanskrit": "अरिष्टो धेनुकः केशी लीलयैव महात्मना ।\nहतो येन च दुर्वृत्तो दृश्यते सोऽयमच्युतः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000193035, "chapter_id": 20193, "verse_number": "१९३-३६", "content_sanskrit": "अयं चास्य महाबाहुर्बलदेवोऽग्रजोऽग्रतः ।\nप्रयाति लीलया योषिन्मनोनयननन्दनः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000193036, "chapter_id": 20193, "verse_number": "१९३-३७", "content_sanskrit": "अयं स कथ्यते प्राज्ञैः पुराणार्थावलोकिभिः ।\nगोपालो यादवं वंशं मग्नमभ्युद्धरिष्यति ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000193037, "chapter_id": 20193, "verse_number": "१९३-३८", "content_sanskrit": "अयं स सर्वभूतस्य विष्णोरखिलजन्मनः ।\nअवतीर्णो महीमंशो नुनं भारहरो भुवः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000193038, "chapter_id": 20193, "verse_number": "१९३-३९", "content_sanskrit": "इत्येवं वर्णिते पौरे रामे कृष्णे च तत्क्षणात् ।\nउरस्तताप देवक्याः स्नेहस्नुतपयोधरम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000193039, "chapter_id": 20193, "verse_number": "१९३-४०", "content_sanskrit": "महोत्सवमिवालोक्य पुत्रावेव विलोकयन् ।\nयुवेव वसुदेवोऽभूद्विहायाभ्यागतां जराम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000193040, "chapter_id": 20193, "verse_number": "१९३-४१", "content_sanskrit": "विस्तारिताक्षियुगला राजान्तःपुरयोषितः ।\nनागरस्त्रीसमूहश्च द्रष्टुं न विरराम तौ ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000193041, "chapter_id": 20193, "verse_number": "१९३-४२", "content_sanskrit": "स्त्रिय ऊचुः सख्यः पश्यत कृष्णस्य मुकमप्यम्बुजेक्षणम् ।\nगजयुद्धकृतायासस्वेदाम्बुकणिकाञ्चितम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000193042, "chapter_id": 20193, "verse_number": "१९३-४३", "content_sanskrit": "विकासीव सरोम्भोजमवश्यायजलोक्षितम् ।\nपरिभूताक्षरं जन्म सफलं क्रियतां दृशः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000193043, "chapter_id": 20193, "verse_number": "१९३-४४", "content_sanskrit": "श्रीवत्साङ्कं जगद्वाम बालस्यैतद्विलोक्यताम् ।\nविपक्षक्षपणं वक्षो भुजयुग्मं च भामिनि ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000193044, "chapter_id": 20193, "verse_number": "१९३-४५", "content_sanskrit": "बल्गता मुष्टिकेनैव चाणूरेण तथा परैः ।\nक्रियते बलभद्रस्य हास्यमीषद्विलोक्यताम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000193045, "chapter_id": 20193, "verse_number": "१९३-४६", "content_sanskrit": "सख्यः पश्यत चाणूरं नियुद्धार्थमयं हरिः ।\nसमुपैति न सन्त्यत्र किं वृद्धा युक्तकारिणः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000193046, "chapter_id": 20193, "verse_number": "१९३-४७", "content_sanskrit": "क्व यौवनोन्मुखीभूतः सुकुमारतनुर्हरिः ।\nक्व वज्रकठिनाभोगशरीरोऽयं महासुरः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000193047, "chapter_id": 20193, "verse_number": "१९३-४८", "content_sanskrit": "इमौ सुललितौ रङ्गे वर्तेते नवयौवनौ ।\nदैतेयमल्लाश्चाणूरप्रमुखास्त्वतिदारुणाः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000193048, "chapter_id": 20193, "verse_number": "१९३-४९", "content_sanskrit": "नियुद्धप्राशिनकानां तु महानेष व्यतिक्रमः ।\nयद्‌बालबलिनोर्युद्धं मध्यस्थैः समुपेक्ष्यते ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000193049, "chapter_id": 20193, "verse_number": "१९३-५०", "content_sanskrit": "व्यास उवाच इत्थं पुरस्त्रीलोकस्य वदतश्चायन्भुवम् ।\nववर्ष हर्षोत्कर्षं च जनस्य भगवान्हरिः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000193050, "chapter_id": 20193, "verse_number": "१९३-५१", "content_sanskrit": "बलभद्रोऽपि चाऽऽस्फोट्य ववल्ग ललितं यदा ।\nपदे पदे तदा भूमिर्न शीर्णा यत्त दद्भनुतम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000193051, "chapter_id": 20193, "verse_number": "१९३-५२", "content_sanskrit": "चाणूरेण ततः कृष्णो युयुधेऽमितविक्रमः ।\nनियुद्धकुशलो दैत्यों बलदेवेन मुषिटकः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000193052, "chapter_id": 20193, "verse_number": "१९३-५३", "content_sanskrit": "संनिपातावधूतैश्च चाणूरेण समं हरिः ।\nक्षेपणैर्मुष्टिभिश्चैव कीलीवज्रनिपातनैः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000193053, "chapter_id": 20193, "verse_number": "१९३-५४", "content_sanskrit": "पादौद्धूतैः प्रमृष्टाभिस्तयोर्युद्धमभून्महत् ।\nअशस्त्रमतिघोरं तत्तयोर्युद्धं सुदारुणम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000193054, "chapter_id": 20193, "verse_number": "१९३-५५", "content_sanskrit": "स्वबलप्राणनिष्पाद्यं समाजोत्सवसंनिधौ ।\nयावद्यावच्च चाणूरो युयुधे हरिणा सह ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000193055, "chapter_id": 20193, "verse_number": "१९३-५६", "content_sanskrit": "प्राणहानिमवापाग्य्रां तावत्तावन्न बान्धवम् ।\nकृष्णोऽपि युयुधे तेन लीलयैव जगन्मयः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000193056, "chapter_id": 20193, "verse_number": "१९३-५७", "content_sanskrit": "खेदाच्चालयता कोपान्निजशेषकरे करम् ।\nबलक्षयं विवृद्धिं च दृष्ट्वा चाणूरकृष्णयोः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000193057, "chapter_id": 20193, "verse_number": "१९३-५८", "content_sanskrit": "वारयामास तूर्याणि कंसः कोपपरायणः ।\nमृदङ्गदिषु वाद्येषु प्रतिषिद्धेषु तत्क्षणात् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000193058, "chapter_id": 20193, "verse_number": "१९३-५९", "content_sanskrit": "खसंगतान्यवाद्यन्त दैवतूर्याण्यनेकशः ।\nजय गोविन्द चाणूरं जहि केशव दानवम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000193059, "chapter_id": 20193, "verse_number": "१९३-६०", "content_sanskrit": "इत्यन्तर्धिगता देवास्तुष्टुवुस्ते प्रहर्षिताः ।\nचाणूरेण चिरं कालं क्रीडित्वा मधुसूदनः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000193060, "chapter_id": 20193, "verse_number": "१९३-६१", "content_sanskrit": "उत्पाट्य भ्रामयामास तद्वधाय कृतोद्यमः ।\nभ्रामयित्वा शतगुणं दैत्यमल्लममित्रजित् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000193061, "chapter_id": 20193, "verse_number": "१९३-६२", "content_sanskrit": "भूमावास्फोटयामास गगने गतजीवितम् ।\nभूमावास्फोटितस्तेन चाणूरः शतधा भवन् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000193062, "chapter_id": 20193, "verse_number": "१९३-६३", "content_sanskrit": "रक्तस्रावमहापङ्कां चकार स तदा भुवम् ।\nबलदेवस्तु तत्कालं मुष्टिकेन महाबलः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000193063, "chapter_id": 20193, "verse_number": "१९३-६४", "content_sanskrit": "युयुधे दैत्यमल्लेन चाणूरेण यथा हरिः ।\nसोऽप्येनं मुष्टिना मूर्ध्नि वक्षस्याहत्य जानुना ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000193064, "chapter_id": 20193, "verse_number": "१९३-६५", "content_sanskrit": "पातयित्वा धरापृष्ठे निष्पिपेष गतायुषम् ।\nकष्णस्तोशलकं भूयो मल्लराजं महाबलम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000193065, "chapter_id": 20193, "verse_number": "१९३-६६", "content_sanskrit": "वाममुष्टिप्रहारेण पातयामास भूतले ।\nचाणूरे निहते मल्ले मुष्टिके च निपातिते ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000193066, "chapter_id": 20193, "verse_number": "१९३-६७", "content_sanskrit": "नीते क्षयं तोशलके सर्वे मल्लाः प्रदुद्रुवुः ।\nववल्गतुस्तदा रङ्गे कृष्णसंकर्षणावुभौ ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000193067, "chapter_id": 20193, "verse_number": "१९३-६८", "content_sanskrit": "समानवयसो गोपान्बलादाकृष्य हर्षितौ ।\nकंसोऽपि कोपरक्ताक्षः प्राहोच्चैर्व्यायतान्नरान् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000193068, "chapter_id": 20193, "verse_number": "१९३-६९", "content_sanskrit": "गोपावेतौ समाजौघान्निष्क्रम्येतां बलादितः ।\nनन्दोऽपि गृह्यतां पापो निगडैराशु बध्यताम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000193069, "chapter_id": 20193, "verse_number": "१९३-७०", "content_sanskrit": "अवृद्धार्हेण दण्डेन वसुदेवोऽपि वध्यताम् ।\nवल्गन्ति गोपाः कृष्णेन ये चेमे सहिताः पुनः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000193070, "chapter_id": 20193, "verse_number": "१९३-७१", "content_sanskrit": "गावो ह्रियन्तामेषां च यच्चास्ति वसु किंचन ।\nएवामाज्ञापयन्तं तं प्रहस्य मधुसूदनः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000193071, "chapter_id": 20193, "verse_number": "१९३-७२", "content_sanskrit": "उत्पत्याऽऽरुह्य तन्मञ्चं कंसं जग्राह वेगितः ।\nकेशेष्वाकृष्य विगलत्किरीटमवनीतले ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000193072, "chapter_id": 20193, "verse_number": "१९३-७३", "content_sanskrit": "स कंसं पातयामास तस्योपरि पपात च ।\nनिःशेषजगदाधारगुरुणा पततोपति ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000193073, "chapter_id": 20193, "verse_number": "१९३-७४", "content_sanskrit": "कृष्णेन त्याजितः प्राणान्नुग्रसेनात्मजो नृपः ।\nमृतस्य केशेषु तदा गृहीत्वा मधुसूदनः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000193074, "chapter_id": 20193, "verse_number": "१९३-७५", "content_sanskrit": "चकर्ष देहं कंसस्य रङ्गमध्ये महाबलः ।\nगौरवेणातमहता परिपातेन कृष्यता ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000193075, "chapter_id": 20193, "verse_number": "१९३-७६", "content_sanskrit": "कृता कंसस्य देहेन वेगितेन महात्मना ।\nकंसे गृहीते कृष्णेन तद्‌भ्राताऽभ्यागतो रुषा ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000193076, "chapter_id": 20193, "verse_number": "१९३-७७", "content_sanskrit": "सुनामा बलभद्रेण लीलयेव निपातितः ।\nततो हाहाकृतं सर्वमासीत्तद्रङ्गमण्डलम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000193077, "chapter_id": 20193, "verse_number": "१९३-७८", "content_sanskrit": "अवज्ञया हतं दृष्ट्वा कृष्णेन मथुरेश्वरम् ।\nकृष्णोऽपि वसुदेवस्य पादौ जग्राह सत्वरम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000193078, "chapter_id": 20193, "verse_number": "१९३-७९", "content_sanskrit": "देवक्याश्च महाबाहुर्बलदेवसहायवान् ।\nउत्थाप्य वसुदेवस्तु देवकी च जनार्दनम् ।\nस्मृतजन्मोक्तवचनौ तावेव प्रणतौ स्थितौ ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000193079, "chapter_id": 20193, "verse_number": "१९३-८०", "content_sanskrit": "वसुदेव उवाच प्रसीद देवदेवेश देवानां प्रवर प्रभो ।\nतथाऽऽवयोः प्रसादेन कृताभ्युद्धार केशव ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000193080, "chapter_id": 20193, "verse_number": "१९३-८१", "content_sanskrit": "आराधितो यद्‌भगवानवतीर्णो गृहे मम ।\nदुर्वृत्तनिधनार्थाय तेन नः पावितं कुलम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000193081, "chapter_id": 20193, "verse_number": "१९३-८२", "content_sanskrit": "त्वमन्तः सर्वभूतानां सर्वभूतेष्वस्थितः ।\nवर्तते च समस्तात्मंसत्वत्तो भूतभविष्यती ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000193082, "chapter_id": 20193, "verse_number": "१९३-८३", "content_sanskrit": "यज्ञे त्वमिज्यसेऽचिन्त्य सर्वदेवमयाच्युते ।\nत्वमेव यज्ञो यज्वा च यज्ञानां परमेश्वर ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000193083, "chapter_id": 20193, "verse_number": "१९३-८४", "content_sanskrit": "सापह्नवं मम मनो यदेतत्तवयि जायते ।\nदेवक्याश्चाऽऽत्मजप्रीत्या तदत्यन्तविडम्बना ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000193084, "chapter_id": 20193, "verse_number": "१९३-८५", "content_sanskrit": "त्वं कर्ता सर्वभूतानामनादिनिधनो भवान् ।\nक्व च मे मानुषस्यैषा जिह्वा पुत्रेति वक्ष्यति ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000193085, "chapter_id": 20193, "verse_number": "१९३-८६", "content_sanskrit": "जगदेतज्जगन्नाथ संभूतमखिलं यतः ।\nकया युक्ताय विना मायां सोऽस्मत्तः संभविष्यति ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000193086, "chapter_id": 20193, "verse_number": "१९३-८७", "content_sanskrit": "यस्मिन्प्रतिष्ठितं सर्वं जगत्स्थावरजङ्गमम् ।\nस कोष्ठोत्सङ्गशयने मनुष्याज्जायते कथम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000193087, "chapter_id": 20193, "verse_number": "१९३-८८", "content_sanskrit": "स त्वं प्रसीद परमेश्वर पाहि विश्वमंशावतारकरणैर्न ममासि पुत्रः ।\nआब्रह्मपादपमयं जगदीश सर्वं, चित्ते विमोहयसि किं परमेश्वरात्मन् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000193088, "chapter_id": 20193, "verse_number": "१९३-८९", "content_sanskrit": "मायाविमोहितदृशा तनयो ममेति, कंसाद्भयं कृतवता तु मयाऽतितीव्रम् ।\nनीतोऽसि गोकुलमरातिभयाकुलस्य, वृद्धिं गतोऽसि मम चैव गवामधीश ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000193089, "chapter_id": 20193, "verse_number": "१९३-९०", "content_sanskrit": "कर्माणि रुद्रमरुदश्विशतक्रतूनां, साध्यानि यानि न भवन्ति निरीक्षितानि ।\nत्वं विष्णुरीशजगतामुपकार्हेतोः प्राप्तोऽसि नः परिगतः परमो विमोहः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}]