[{"id": 7003118000, "chapter_id": 23118, "verse_number": "४-५४-१", "content_sanskrit": "नारद उवाच ।\nअतः परं किं रहस्यं बभूव मुनिसत्तम ।\nकथं जगाम भगवान्मथुरां नन्दमन्दिरात् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003118001, "chapter_id": 23118, "verse_number": "४-५४-२", "content_sanskrit": "नन्दो दधार प्राणांश्च विच्छेदेन हरेः कथम् ।\nगोपाङ्गना यशोदा वा कृष्णैकतानमानसाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003118002, "chapter_id": 23118, "verse_number": "४-५४-३", "content_sanskrit": "चक्षुर्निमेषविच्छेदाद्या राधा न हि जीवति ।\nकथं दधार सा देवी प्राणान्प्राणेश्वरं विना ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003118003, "chapter_id": 23118, "verse_number": "४-५४-४", "content_sanskrit": "येये तत्सङ्गिनो गोपाः शयनासनभोगतः ।\nकथं विसस्मरुस्ते च तादृशं बांधवं व्रजे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003118004, "chapter_id": 23118, "verse_number": "४-५४-५", "content_sanskrit": "श्रीकृष्णो मथुरां गत्वा किं किं कर्म चकार सः ।\nस्वर्गारोहणपर्यन्तं तद्भवान्वक्तुमर्हति ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003118005, "chapter_id": 23118, "verse_number": "४-५४-६", "content_sanskrit": "श्रीनारायण उवाच ।\nकंसश्चकार यज्ञं च समाहूतो धनुर्मखम् ।\nजगाम तत्र भगवांस्तेन राज्ञा निमन्त्रितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003118006, "chapter_id": 23118, "verse_number": "४-५४-७", "content_sanskrit": "राजा प्रस्थापयामास चाक्रूरं भगवत्प्रियम् ।\nअक्रूरः प्रेरितो राज्ञा गत्वा च नन्दमन्दिर म् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003118007, "chapter_id": 23118, "verse_number": "४-५४-८", "content_sanskrit": "श्रीकृष्णं च गृहीत्वा स सगणं मथुरां गतः ।\nकृष्णः श्रीमथुरां गत्वा जघान नृपतिं मुने ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003118008, "chapter_id": 23118, "verse_number": "४-५४-९", "content_sanskrit": "जघान रजकं चैव चाणूरं मुष्टिकं गजम् ।\nचकार पित्रोरुद्धारं बान्धवानां च बान्धवः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003118009, "chapter_id": 23118, "verse_number": "४-५४-१०", "content_sanskrit": "कुब्जया सह शृङ्गारं कृत्वा च कौतुकेन च ।\nतं च प्रस्थापयामास गोलोकं गोपिकापतिः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003118010, "chapter_id": 23118, "verse_number": "४-५४-११", "content_sanskrit": "चकार कृपया विष्णुर्मालाकारस्य मोक्षणम् ।\nकृपया चोद्धवद्वारा बोधयामास गोपिकाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003118011, "chapter_id": 23118, "verse_number": "४-५४-१२", "content_sanskrit": "तदोपनीतो भगवानवन्तीनगरं ययौ ।\nचकार विद्याग्रहणं मुनेः सांदीपनेर्गुरोः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003118012, "chapter_id": 23118, "verse_number": "४-५४-१३", "content_sanskrit": "ततो जित्वा जरासन्धं निहत्य यवनेश्वरम् ।\nउग्रसेनं च नृपतिं चकार विधिपूर्वकम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003118013, "chapter_id": 23118, "verse_number": "४-५४-१४", "content_sanskrit": "गत्वा समुद्रनिकटं निर्माय द्वारकां पुरीम् ।\nजहार रुक्मिणीं देवीं जित्वा नृपतिसंघकम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003118014, "chapter_id": 23118, "verse_number": "४-५४-१५", "content_sanskrit": "कालिंदीं लक्ष्मणां शैब्यां सत्यां जांबवतीं सतीम् ।\nमित्रविंदां नाग्नजितीं समुद्वाहं चकार सः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003118015, "chapter_id": 23118, "verse_number": "४-५४-१६", "content_sanskrit": "निहत्य नरकं भूपं रणेन दारुणेन च ।\nपत्नीषोडशसाहस्रं विहारं च चकार सः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003118016, "chapter_id": 23118, "verse_number": "४-५४-१७", "content_sanskrit": "जहार पारिजातं च जित्वा शक्रं च लीलया ।\nचिच्छेद बाणहस्तांश्च जित्वा च चन्द्रशेखरम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003118017, "chapter_id": 23118, "verse_number": "४-५४-१८", "content_sanskrit": "पौत्रस्य मोक्षणं कृत्वा पुनरागत्य द्वारकाम् ।\nआत्मानं दर्शयामास लोकांश्च प्रतिमन्दिरम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003118018, "chapter_id": 23118, "verse_number": "४-५४-१९", "content_sanskrit": "योगे च वसुदेवस्य तीर्थयात्राप्रसंगतः ।\nप्राणाधिष्ठातृदेवीं च ददर्श तत्र राधिकाम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003118019, "chapter_id": 23118, "verse_number": "४-५४-२०", "content_sanskrit": "पूर्णे च शतवर्षे च सुदाम्नः शापमोक्षणे ।\nपुनर्ययौ तया सार्द्धं पुण्यं वृन्दावनं वनम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003118020, "chapter_id": 23118, "verse_number": "४-५४-२१", "content_sanskrit": "पुनश्चतुर्दशाब्दं च तया सार्धं जगत्पतिः ।\nचकार रासं रासे च पुण्यक्षेत्रे च भारते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003118021, "chapter_id": 23118, "verse_number": "४-५४-२२", "content_sanskrit": "पूर्णमेकादशाब्दं च निवृत्य नन्दमंदिरे ।\nमथुरायां द्वारकायां पूर्णमब्दशतं विभुः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003118022, "chapter_id": 23118, "verse_number": "४-५४-२३", "content_sanskrit": "चकार भारहरणं पृथिव्यां पृथुविक्रमः। ।\nपंचविंशतिवर्षे च शतवर्षाधिकं मुने ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003118023, "chapter_id": 23118, "verse_number": "४-५४-२४", "content_sanskrit": "तिष्ठञ्जगाम गोलोकं पृथिव्यां च पुरातनः ।\nयशोदायै च नन्दाय वृषभानाय धीमते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003118024, "chapter_id": 23118, "verse_number": "४-५४-२५", "content_sanskrit": "राधामात्रे कलावत्यै ददौ सामीप्यमोक्षणम् ।\nकृष्णेन सार्द्धं गोपी च राधिका च कुतूहलात् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003118025, "chapter_id": 23118, "verse_number": "४-५४-२६", "content_sanskrit": "निबध्य धर्मसेतुं च वेदोक्तं च युगे युगे ।\nइत्येवं कथितं सर्वं समासेन महामुने ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003118026, "chapter_id": 23118, "verse_number": "४-५४-२७", "content_sanskrit": "श्रीकृष्णचरितं रम्यं चतुर्वर्गफलप्रदम् ।\nब्रह्मादिस्तम्बपर्यन्तं सर्वं नश्वरमेव च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003118027, "chapter_id": 23118, "verse_number": "४-५४-२८", "content_sanskrit": "भज तं परमानन्दं सानन्दं नन्दनन्दनम् ।\nस्वेच्छामयं परं ब्रह्म परमात्मानमीश्वरम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003118028, "chapter_id": 23118, "verse_number": "४-५४-२९", "content_sanskrit": "परमव्ययमव्यक्तं भक्तानुग्रहविग्रहम् ।\nसत्य नित्यं स्वतंत्रं च सर्वेशं प्रकृतेः परम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003118029, "chapter_id": 23118, "verse_number": "४-५४-३०", "content_sanskrit": "निर्गुणं च निरीहं च निराकारं निरञ्जनम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]