[{"id": 2022218, "chapter_id": 1464, "verse_number": "३-१०२-०x", "content_sanskrit": "देवा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2022219, "chapter_id": 1464, "verse_number": "३-१०२-१", "content_sanskrit": "तव प्रसादाद्वर्धन्ते प्रजाः सर्वाश्चतुर्विधाः।\nता भाविता भावयनति हव्यकव्यैर्दिवौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2022220, "chapter_id": 1464, "verse_number": "३-१०२-२", "content_sanskrit": "लोका ह्येवं विवर्धन्ते ह्यन्योन्यं समुपाश्रिताः।\nत्वत्प्रसादान्निरुद्विग्नास्त्वयैव परिरक्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2022221, "chapter_id": 1464, "verse_number": "३-१०२-३", "content_sanskrit": "इदं च समनुप्राप्तं लोकानां भयमुत्तमम्।\nन च जानीम केनेति रात्रौ वध्यन्ति ब्राह्मणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2022222, "chapter_id": 1464, "verse_number": "३-१०२-४", "content_sanskrit": "क्षीणेषु च ब्राह्मणेषु पृथिवी क्षयमेष्यति।\nतत पृथिव्यां क्षीणायां त्रिदिवं क्षयमेष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2022223, "chapter_id": 1464, "verse_number": "३-१०२-५", "content_sanskrit": "त्वत्प्रसादान्महाबाहो लोकाः सर्वे जगत्पते।\nविनाशं नाधिगच्छेयुस्त्वया वै परिरक्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2022224, "chapter_id": 1464, "verse_number": "३-१०२-६x", "content_sanskrit": "विष्णुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2022225, "chapter_id": 1464, "verse_number": "३-१०२-६", "content_sanskrit": "विदितं मे सुराः सर्वं प्रजानां क्षयकारणम्।\nभवतां चापि वक्ष्यामि शृणुध्वं विगतज्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2022226, "chapter_id": 1464, "verse_number": "३-१०२-७", "content_sanskrit": "कालेया इति विख्याता गणाः परमदारुणाः।\nतैश्च वृत्रं समाश्रित्य जगत्सर्वं प्रमाथितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2022227, "chapter_id": 1464, "verse_number": "३-१०२-८", "content_sanskrit": "ते वृत्रं निहतं दृष्ट्वा सहस्राक्षेण धीमता।\nजीवितं परिरक्षन्तः प्रविष्टा वरुणालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2022228, "chapter_id": 1464, "verse_number": "३-१०२-९", "content_sanskrit": "ते प्रविश्योदधिं घोरं नक्रग्राहसमाकुलम्।\nउत्सादार्थं लोकानां रात्रौ घ्नन्ति ऋषीनिह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2022229, "chapter_id": 1464, "verse_number": "३-१०२-१०", "content_sanskrit": "न तु शक्याः क्षयं नेतुं समुद्राश्रयिणो हि ते।\nसमुद्रस्य क्षये बुद्धिर्भवद्भिः संप्रधार्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2022230, "chapter_id": 1464, "verse_number": "३-१०२-११", "content_sanskrit": "`एतच्छ्रुत्वा वचो देवा विष्णुना समुदीरितम्।\nविष्णुमेव पुरस्कृत्यब्रह्माणं समुपस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2022231, "chapter_id": 1464, "verse_number": "३-१०२-१२", "content_sanskrit": "ततस्ते प्रणता भूत्वा तमेवार्धं न्यवेदयन्।\nसर्वलोकविनाशार्थं कालेया कृतनिश्चयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2022232, "chapter_id": 1464, "verse_number": "३-१०२-१३", "content_sanskrit": "एषां तद्वचनं श्रुत्वा पद्मयोनिः सनातनः।\nउवाच परमप्रीतस्त्रिदशानर्थवद्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2022233, "chapter_id": 1464, "verse_number": "३-१०२-१४", "content_sanskrit": "विदितं मे सुराः सर्वे दानवानां विवेष्टितम्।\nमनुष्यादेश्च निधनं कालेयैः कालचोदितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2022234, "chapter_id": 1464, "verse_number": "३-१०२-१५", "content_sanskrit": "क्षयस्तेपामनुप्राप्तः कालेनोपहताश्च ये।\nउपायं संप्रवक्ष्यामि समुद्रस्य विशोषणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2022235, "chapter_id": 1464, "verse_number": "३-१०२-१६", "content_sanskrit": "अगस्त्य इतिविग्व्यातो वारुणिः सुसमाहितः।\nतमुपागम्य सहिता इममर्थं प्रयाचत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2022236, "chapter_id": 1464, "verse_number": "३-१०२-१७", "content_sanskrit": "स हि शक्तो महातेजाः क्षणात्पातुं महोदधिम्।\nअगस्त्येन विना को हि शक्तोऽन्योऽर्णवशोपणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2022237, "chapter_id": 1464, "verse_number": "३-१०२-१८", "content_sanskrit": "अन्यथा हि न शक्यास्ते विना सागरशोपणम्।\nसमुद्रे च क्षयं नीते कालेयान्निहनिष्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2022238, "chapter_id": 1464, "verse_number": "३-१०२-१९", "content_sanskrit": "एवं श्रुत्वा वचो देवा ब्रह्मणः परमेष्ठिनः।\nपरमेष्ठिनमाज्ञाप्यअगस्त्यस्याश्रमं ययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2022239, "chapter_id": 1464, "verse_number": "३-१०२-२०", "content_sanskrit": "तत्रापश्यन्महात्मानं वारुणिं दीप्ततेजसम्।\nउपास्यमानमृपिभिर्देवैरिव पितामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2022240, "chapter_id": 1464, "verse_number": "३-१०२-२१", "content_sanskrit": "तेऽभिगम्य महात्मानं मैत्रावरुणिमच्युतम्।\nआश्रमश्थं तपोराशिं कर्मभिः स्वैस्तु तुष्टुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2022241, "chapter_id": 1464, "verse_number": "३-१०२-२२x", "content_sanskrit": "देवा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2022242, "chapter_id": 1464, "verse_number": "३-१०२-२२", "content_sanskrit": "नहुपेणाभितप्तानां त्वं लोकानां गतिः पुरा।\nभ्रंशितश्च सुरैश्वर्याल्लोकार्थं लोककण्टकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2022243, "chapter_id": 1464, "verse_number": "३-१०२-२३", "content_sanskrit": "क्रोधात्प्रवृद्धस्तरणं भास्करस्य नभोगतः।\nवचस्तवानतिक्रामन्विन्ध्यः शैलो न वर्धते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2022244, "chapter_id": 1464, "verse_number": "३-१०२-२४", "content_sanskrit": "तमसा चावृतेलोके मृत्युनाऽभ्यर्दिताः प्रजाः।\nत्वामेव नाथमासाद्य निर्वृतिं परमां गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2022245, "chapter_id": 1464, "verse_number": "३-१०२-२५", "content_sanskrit": "अस्माकं भयभीतानां नित्यशो भगवान्गतिः।\nततस्त्वार्ताः प्रयाचामो वरं त्वां वरदो ह्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2022246, "chapter_id": 1464, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि द्व्यधिकशततमोऽध्यायः ॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]