[{"id": 40015388, "chapter_id": 9223, "verse_number": "1", "content_sanskrit": "तेनशङ्खविमिश्रेणभेरीशब्देनराघवः । उपयातिमहाबाहूरामःपरपुरञ्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40015389, "chapter_id": 9223, "verse_number": "2", "content_sanskrit": "तंनिनादंनिशम्याथरावणोराक्षसेश्वरः । मुहूर्तंध्यानमास्थायसचिवानभ्युदैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40015390, "chapter_id": 9223, "verse_number": "3", "content_sanskrit": "अथतान्सचिवांस्तत्रसर्वानाभाष्यरावणः । सभांसन्नादयन् सर्वामित्युवाचमहाबलः ॥ जगत्सन्तापन्क्रूरोगर्हयन्राक्षसेश्वरः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40015391, "chapter_id": 9223, "verse_number": "4", "content_sanskrit": "तरणंसागरस्यापिविक्रमंबलसञ्जियम् ॥ यदुक्तवन्तोरामस्यभवन्तस्तन्मयाश्रुतम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40015392, "chapter_id": 9223, "verse_number": "5", "content_sanskrit": "भवतश्चाप्यहंवेमदियुद्धेसत्यपराक्रमान् ॥ तूषिकानीक्षतोऽन्योन्यंविदित्वारामविक्रमम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40015393, "chapter_id": 9223, "verse_number": "6", "content_sanskrit": "ततस्तुसुमहाप्राज्ञोमाल्यवान्नामराक्षसः ॥ रावणस्यवचश्श्रुत्वामातुःपैतामहोऽब्रवीत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40015394, "chapter_id": 9223, "verse_number": "7", "content_sanskrit": "विद्यास्वभिविनीतोयोराजाराजन्नयानुगः ॥ सशास्तिचिरमैश्वर्यमरींश्चकुरुतेवशे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40015395, "chapter_id": 9223, "verse_number": "8", "content_sanskrit": "सन्दधानोहिकालेनविगृह्णंश्चारिभिस्सह ॥ स्वपक्षवर्थनंकुर्वन्महदैश्वर्यमश्नुते ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40015396, "chapter_id": 9223, "verse_number": "9", "content_sanskrit": "हीयमानेनकर्तव्योराज्ञासन्धिस्समेवच ॥ नशत्रुमवमन्येतज्यायान्कुर्वीतविग्रहम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40015397, "chapter_id": 9223, "verse_number": "10", "content_sanskrit": "तन्मह्यंरोचतेसन्धिस्सहरामेणरावण ॥ यदर्थमभियुक्ता: स्मसीतातस्मैप्रदीयताम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40015398, "chapter_id": 9223, "verse_number": "11", "content_sanskrit": "यस्यदेवर्षयस्सर्वेगन्धर्वाश्चजयैषिणः ॥ विरोथंमागमस्तेनसन्धिस्तेतेनरोचताम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40015399, "chapter_id": 9223, "verse_number": "12", "content_sanskrit": "असृजद्भगवान्पक्षौद्वावेनहिपितामहः ॥ सुराणामसुराणांचधर्माधर्मौतदाश्रयौ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40015400, "chapter_id": 9223, "verse_number": "13", "content_sanskrit": "धर्मोहिश्रूयतेपक्षीह्यमराणांमहात्मनाम् ॥ अधर्मोरक्षसांपक्षोह्यसुराणांचराक्षस ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40015401, "chapter_id": 9223, "verse_number": "14", "content_sanskrit": "धर्मोवैग्रसतेऽधर्मंततःकृतमभूद्युगम् ॥ अधर्मोग्रसतेधर्मंततस्तिष्यःप्रवर्तते ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40015402, "chapter_id": 9223, "verse_number": "15", "content_sanskrit": "तत्त्वयाचरयालोकान्धर्मोपिविनिहतोमहान् ॥ अधर्मःप्रगृहीतश्चतेनास्मद्बलिनःपरे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40015403, "chapter_id": 9223, "verse_number": "16", "content_sanskrit": "सप्रमादावदिवृद्धस्तेऽधर्मोहिग्रसतेहिनः ॥ विवर्थयतिपक्षंचसुराणांसुरभावनः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40015404, "chapter_id": 9223, "verse_number": "17", "content_sanskrit": "विषयेषुप्रसक्तेनयत्किञ्चित्कारणात्वया ॥ ऋषीणामग्नकल्पानामुद्वेगोजनितोमहान् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40015405, "chapter_id": 9223, "verse_number": "18", "content_sanskrit": "तेषांप्रभावोदुर्धर्षःप्रदीप्तइवपावकः ॥ तपसाभावितात्मानोधर्मस्यानुग्रहेरताः । मुख्यर्यज्ञैर्यजन्त्येतेनित्यंतैस्सैर्द्विजातयः ॥ जुह्वत्यनगींश्चविधिवद्वेदांश्चोच्चैरधीयते । अभिभूयचरक्षांसिब्रह्मघोषानुदैरयन् ॥ दिशोऽपिविद्रुतास्सर्वेस्तनयित्नुरिवोष्णगे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40015406, "chapter_id": 9223, "verse_number": "19", "content_sanskrit": "तेषांप्रभावोदुर्धर्षःप्रदीप्तइवपावकः ॥ तपसाभावितात्मानोधर्मस्यानुग्रहेरताः । मुख्यर्यज्ञैर्यजन्त्येतेनित्यंतैस्सैर्द्विजातयः ॥ जुह्वत्यनगींश्चविधिवद्वेदांश्चोच्चैरधीयते । अभिभूयचरक्षांसिब्रह्मघोषानुदैरयन् ॥ दिशोऽपिविद्रुतास्सर्वेस्तनयित्नुरिवोष्णगे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40015407, "chapter_id": 9223, "verse_number": "20", "content_sanskrit": "तेषांप्रभावोदुर्धर्षःप्रदीप्तइवपावकः ॥ तपसाभावितात्मानोधर्मस्यानुग्रहेरताः । मुख्यर्यज्ञैर्यजन्त्येतेनित्यंतैस्सैर्द्विजातयः ॥ जुह्वत्यनगींश्चविधिवद्वेदांश्चोच्चैरधीयते । अभिभूयचरक्षांसिब्रह्मघोषानुदैरयन् ॥ दिशोऽपिविद्रुतास्सर्वेस्तनयित्नुरिवोष्णगे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40015408, "chapter_id": 9223, "verse_number": "21", "content_sanskrit": "ऋषीणामग्निकल्पानामग्निहोत्रासमुत्थितः ॥ अदत्तेरक्षसांतेजोधूमोव्याप्यदिशोदश ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40015409, "chapter_id": 9223, "verse_number": "22", "content_sanskrit": "तेषुतेषुचदेशेषुपुण्येष्वेवदृढव्रतैः ॥ चर्यमाणंतपस्तीव्रंसन्तापयतिराक्षसान् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40015410, "chapter_id": 9223, "verse_number": "23", "content_sanskrit": "देवदानवयक्षेभ्योगृहीतश्चवरस्त्वया ॥ मनुषावानराऋक्षागोलाङ्गूलामहाबलाः । बलवन्तइहागम्यगर्जन्तीदृढविक्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40015411, "chapter_id": 9223, "verse_number": "24", "content_sanskrit": "देवदानवयक्षेभ्योगृहीतश्चवरस्त्वया ॥ मनुषावानराऋक्षागोलाङ्गूलामहाबलाः । बलवन्तइहागम्यगर्जन्तीदृढविक्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40015412, "chapter_id": 9223, "verse_number": "25", "content_sanskrit": "उत्पातान्विविधान्दृष्टवाघोरन्बहुविधांस्तथा । विनाशमनुपश्यामिसर्वेषांरक्षसामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40015413, "chapter_id": 9223, "verse_number": "26", "content_sanskrit": "खराभिस्न्तिताघोरामेघाःप्रतिभयङ्कराः । शोणितेनाभिवर्षन्तिलङ्कामुष्णेनसर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40015414, "chapter_id": 9223, "verse_number": "27", "content_sanskrit": "रुदतांवाहनानांचप्रपवन्त्यौस्रबिन्दवः । ध्वजाध्वस्ताविवर्णाश्चनप्रभान्तियथापुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40015415, "chapter_id": 9223, "verse_number": "28", "content_sanskrit": "व्याळागोमायवोगृध्रावाश्यन्तिचसुभैरवम् । प्रविश्यलङ्कामनिशंसमवायांश्चकुर्वते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40015416, "chapter_id": 9223, "verse_number": "29", "content_sanskrit": "काळिकाःपाण्डुरैर्दन्तै: प्रहसन्त्यग्रतःस्थिताः । स्त्रियस्स्वप्नेषुमुष्ण्नत्योगृहाणिप्रतिभाष्यच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40015417, "chapter_id": 9223, "verse_number": "30", "content_sanskrit": "गृहाणांबलिकर्माणिश्वानःपर्युपभुञ्जते । खरागोषुप्रजायन्तेमूषकानकुलैस्सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40015418, "chapter_id": 9223, "verse_number": "31", "content_sanskrit": "मार्जाराद्वीपिभिस्सार्थंसूकराश्शुनकैस्सह । किन्नराराक्षसैश्चापिसमीयुर्मानुषैस्सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40015419, "chapter_id": 9223, "verse_number": "32", "content_sanskrit": "पाण्डुरारक्तपादाश्चविहङ्गाःकालचोदिताः । राक्षसानांविनाशायकपोताविचरन्तिच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40015420, "chapter_id": 9223, "verse_number": "33", "content_sanskrit": "वीचीकूचीतिवाश्य्नत्यश्शारिकावेश्मसुस्थिताः । पतन्तिग्रथिताश्चापिनिर्जिताःकलहैषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40015421, "chapter_id": 9223, "verse_number": "34", "content_sanskrit": "पक्षिणश्चमृगास्सर्वेप्रत्यादित्यंरुदन्तिच । कराळोविकटोमुण्डःपुरुषःकष्णपिङ्गळः ॥ कालोगृहाणि