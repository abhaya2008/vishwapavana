[{"id": 5000223000, "chapter_id": 9223, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे सप्तविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000223001, "chapter_id": 9223, "verse_number": "३-२७-१", "content_sanskrit": "खरं तु रामाभिमुखं प्रयान्तं वाहिनीपतिः।\nराक्षसस्त्रिशिरा नाम संनिपत्येदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000223002, "chapter_id": 9223, "verse_number": "३-२७-२", "content_sanskrit": "मां नियोजय विक्रान्तं त्वं निवर्तस्व साहसात्।\nपश्य रामं महाबाहुं संयुगे विनिपातितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000223003, "chapter_id": 9223, "verse_number": "३-२७-३", "content_sanskrit": "प्रतिजानामि ते सत्यमायुधं चाहमालभे।\nयथा रामं वधिष्यामि वधार्हं सर्वरक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000223004, "chapter_id": 9223, "verse_number": "३-२७-४", "content_sanskrit": "अहं वास्य रणे मृत्युरेष वा समरे मम।\nविनिवर्त्य रणोत्साहं मुहूर्तं प्राश्निको भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000223005, "chapter_id": 9223, "verse_number": "३-२७-५", "content_sanskrit": "प्रहृष्टो वा हते रामे जनस्थानं प्रयास्यसि।\nमयि वा निहते रामं संयुगाय प्रयास्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000223006, "chapter_id": 9223, "verse_number": "३-२७-६", "content_sanskrit": "खरस्त्रिशिरसा तेन मृत्युलोभात् प्रसादितः।\nगच्छ युध्येत्यनुज्ञातो राघवाभिमुखो ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000223007, "chapter_id": 9223, "verse_number": "३-२७-७", "content_sanskrit": "त्रिशिरास्तु रथेनैव वाजियुक्तेन भास्वता।\nअभ्यद्रवद् रणे रामं त्रिशृङ्ग इव पर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000223008, "chapter_id": 9223, "verse_number": "३-२७-८", "content_sanskrit": "शरधारासमूहान् स महामेघ इवोत्सृजन्।\nव्यसृजत् सदृशं नादं जलार्द्रस्येव दुन्दुभेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000223009, "chapter_id": 9223, "verse_number": "३-२७-९", "content_sanskrit": "आगच्छन्तं त्रिशिरसं राक्षसं प्रेक्ष्य राघवः।\nधनुषा प्रतिजग्राह विधुन्वन् सायकान् शितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000223010, "chapter_id": 9223, "verse_number": "३-२७-१०", "content_sanskrit": "स सम्प्रहारस्तुमुलो रामत्रिशिरसोस्तदा।\nसम्बभूवातिबलिनोः सिंहकुञ्जरयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000223011, "chapter_id": 9223, "verse_number": "३-२७-११", "content_sanskrit": "ततस्त्रिशिरसा बाणैर्ललाटे ताडितस्त्रिभिः।\nअमर्षी कुपितो रामः संरब्ध इदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000223012, "chapter_id": 9223, "verse_number": "३-२७-१२", "content_sanskrit": "अहो विक्रमशूरस्य राक्षसस्येदृशं बलम्।\nपुष्पैरिव शरैर्योऽहं ललाटेऽस्मि परिक्षतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000223013, "chapter_id": 9223, "verse_number": "३-२७-१३", "content_sanskrit": "ममापि प्रतिगृह्णीष्व शरांश्चापगुणाच्च्युतान्।\nएवमुक्त्वा सुसंरब्धः शरानाशीविषोपमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000223014, "chapter_id": 9223, "verse_number": "३-२७-१४", "content_sanskrit": "त्रिशिरोवक्षसि क्रुद्धो निजघान चतुर्दश।\nचतुर्भिस्तुरगानस्य शरैः संनतपर्वभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000223015, "chapter_id": 9223, "verse_number": "३-२७-१५", "content_sanskrit": "न्यपातयत तेजस्वी चतुरस्तस्य वाजिनः।\nअष्टभिः सायकैः सूतं रथोपस्थे न्यपातयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000223016, "chapter_id": 9223, "verse_number": "३-२७-१६", "content_sanskrit": "रामश्चिच्छेद बाणेन ध्वजं चास्य समुच्छ्रितम्।\nततो हतरथात् तस्मादुत्पतन्तं निशाचरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000223017, "chapter_id": 9223, "verse_number": "३-२७-१७", "content_sanskrit": "चिच्छेद रामस्तं बाणैर्हृदये सोऽभवज्जडः।\nसायकैश्चाप्रमेयात्मा सामर्षस्तस्य रक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000223018, "chapter_id": 9223, "verse_number": "३-२७-१८", "content_sanskrit": "शिरांस्यपातयत् त्रीणि वेगवद्भिस्त्रिभिः शरैः।\nस धूमशोणितोद‍्गारी रामबाणाभिपीडितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000223019, "chapter_id": 9223, "verse_number": "३-२७-१९", "content_sanskrit": "न्यपतत् पतितैः पूर्वं समरस्थो निशाचरः।\nहतशेषास्ततो भग्ना राक्षसाः खरसंश्रयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000223020, "chapter_id": 9223, "verse_number": "३-२७-२०", "content_sanskrit": "द्रवन्ति स्म न तिष्ठन्ति व्याघ्रत्रस्ता मृगा इव।\nतान् खरो द्रवतो दृष्ट्वा निवर्त्य रुषितस्त्वरन्।\nराममेवाभिदुद्राव राहुश्चन्द्रमसं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000223021, "chapter_id": 9223, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे सप्तविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]