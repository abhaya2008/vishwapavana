[{"id": 7000624000, "chapter_id": 20624, "verse_number": "५-८३-१", "content_sanskrit": "नारद उवाच ।\nभगवन्सर्वमाख्यातं यद्यत्पृष्टं मया गुरो ।\nअधुना श्रोतुमिच्छामि भावमार्गमनुत्तमम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000624001, "chapter_id": 20624, "verse_number": "५-८३-२", "content_sanskrit": "शिव उवाच ।\nसाधु विप्र त्वया पृष्टं सर्वलोकहितैषिणा ।\nरहस्यमपि वक्ष्यामि तन्मे निगदतः शृणु ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000624002, "chapter_id": 20624, "verse_number": "५-८३-३", "content_sanskrit": "दास्यः सखायः पितरौ प्रेयस्यश्च हरेरिह ।\nसर्वे नित्या मुनिश्रेष्ठ वसंति गुणशालिनः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000624003, "chapter_id": 20624, "verse_number": "५-८३-४", "content_sanskrit": "यथा प्रकटलीलायां पुराणेषु प्रकीर्तिताः ।\nतथा ते नित्यलीलायां संति वृंदावने भुवि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000624004, "chapter_id": 20624, "verse_number": "५-८३-५", "content_sanskrit": "गमनागमने नित्यं करोति वनगोष्ठयोः ।\nगोचारणं वयस्यैश्च विनाऽसुरविघातनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000624005, "chapter_id": 20624, "verse_number": "५-८३-६", "content_sanskrit": "करकीयाभिमानिन्यस्तथा तस्य प्रिया जनाः ।\nप्रच्छन्नेनैव भावेन रमयंति निजप्रियम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000624006, "chapter_id": 20624, "verse_number": "५-८३-७", "content_sanskrit": "आत्मानं चिंतयेत्तत्र तासां मध्ये मनोरमाम् ।\nरूपयौवनसंपन्नां किशोरीं प्रमदाकृतिम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000624007, "chapter_id": 20624, "verse_number": "५-८३-८", "content_sanskrit": "नानाशिल्पकलाभिज्ञां कृष्णभोगानुरूपिणीम् ।\nप्रार्थितामपि कृष्णेन तत्र भोगपराङ्मुखीम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000624008, "chapter_id": 20624, "verse_number": "५-८३-९", "content_sanskrit": "राधिकानुचरीं तत्र तत्सेवनपरायणाम् ।\nकृष्णादप्यधिकं प्रेम राधिकायां प्रकुर्वतीम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000624009, "chapter_id": 20624, "verse_number": "५-८३-१०", "content_sanskrit": "प्रीत्यानुदिवसं यत्नात्तयोः संगमकारिणीम् ।\nतत्सेवनसुखाह्लादभावेनातिसुनिर्वृताम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000624010, "chapter_id": 20624, "verse_number": "५-८३-११", "content_sanskrit": "इत्यात्मानं विचिंत्यैव तत्र सेवां समाचरेत् ।\nब्राह्मं मुहूर्त्तमारभ्य यावत्स्यात्तु महानिशा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000624011, "chapter_id": 20624, "verse_number": "५-८३-१२", "content_sanskrit": "नारद उवाच ।\nहरेर्दैनंदिनीं लीलां श्रोतुमिच्छामि तत्त्वतः ।\nलीलामजानता सेव्यो मनसा तु कथं हरिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000624012, "chapter_id": 20624, "verse_number": "५-८३-१३", "content_sanskrit": "शिव उवाच ।\nनाहं जानामि तां लीलां हरेर्नारदतत्त्वतः ।\nवृंदादेवीमितो गच्छ सा ते लीलां प्रवक्ष्यति ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000624013, "chapter_id": 20624, "verse_number": "५-८३-१४", "content_sanskrit": "अविदूर इतः स्थानात्केशीतीर्थसमीपतः ।\nसखीसंघवृता सास्ते गोविंदपरिचारिका ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000624014, "chapter_id": 20624, "verse_number": "५-८३-१५", "content_sanskrit": "सूत उवाच ।\nइत्युक्तस्तं परिक्रम्य हृष्टो नत्वा पुनः पुनः ।\nवृंदाश्रमं जगामाथ नारदो मुनिसत्तमः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000624015, "chapter_id": 20624, "verse_number": "५-८३-१६", "content_sanskrit": "वृंदापि नारदं दृष्ट्वा प्रणम्य च पुनःपुनः ।\nउवाच च मुनिश्रेष्ठ कथमत्रागतिस्तव ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000624016, "chapter_id": 20624, "verse_number": "५-८३-१७", "content_sanskrit": "नारद उवाच ।\nत्वत्तो वेदितुमिच्छामि नैत्यकं चरितं हरेः ।\nतदादितो मम ब्रूहि यदि योग्योऽस्मि शोभने ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000624017, "chapter_id": 20624, "verse_number": "५-८३-१८", "content_sanskrit": "वृंदोवाच ।\nरहस्यमपिवक्ष्यामि कृष्णभक्तोसि नारद ।\nन प्रकाश्यं त्वयाप्येतद्गुह्याद्गुह्यतरं महत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000624018, "chapter_id": 20624, "verse_number": "५-८३-१९", "content_sanskrit": "मध्ये वृंदावने रम्ये पंचाशत्कुंजमंडिते ।\nकल्पवृक्षनिकुंजे तु दिव्यरत्नमये गृहे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000624019, "chapter_id": 20624, "verse_number": "५-८३-२०", "content_sanskrit": "निद्रितौ तिष्ठतस्तल्पे निबिडालिंगितौ मिथः ।\nमदाज्ञाकारिभिः पश्चात्पक्षिभिर्बोधितावपि ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000624020, "chapter_id": 20624, "verse_number": "५-८३-२१", "content_sanskrit": "गाढालिंगनजानंदमाप्तौ तद्भंगकातरौ ।\nन मनः कुरुतस्तल्पात्समुत्थातुं मनागपि ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000624021, "chapter_id": 20624, "verse_number": "५-८३-२२", "content_sanskrit": "ततश्च सारिकासंघैः शुकाद्यैः परितो मुहुः ।\nबोधितौ विविधैर्वाक्यैः स्वतल्पादुदतिष्ठताम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000624022, "chapter_id": 20624, "verse_number": "५-८३-२३", "content_sanskrit": "उपविष्टौ ततो दृष्ट्वा सख्यस्तल्पे मुदान्वितौ ।\nप्रविश्य सेवां कुर्वंति तत्काले ह्युचितां तयोः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000624023, "chapter_id": 20624, "verse_number": "५-८३-२४", "content_sanskrit": "पुनश्च सारिकावाक्यैस्तावुत्थाय स्वतल्पतः ।\nगच्छतः स्वस्वभवनं भीत्युत्कंठाकुलौ ततः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000624024, "chapter_id": 20624, "verse_number": "५-८३-२५", "content_sanskrit": "प्रातश्च बोधितो मात्रा तल्पादुत्थाय सत्वरः ।\nकृत्वा कृष्णो दंतकाष्ठं बलदेवसमन्वितः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000624025, "chapter_id": 20624, "verse_number": "५-८३-२६", "content_sanskrit": "मात्रानुमोदितो याति गोशालां सखिभिर्वृतः ।\nराधापि बोधिता विप्र वयस्याभिः स्वतल्पतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000624026, "chapter_id": 20624, "verse_number": "५-८३-२७", "content_sanskrit": "उत्थाय दंतकाष्ठादि कृत्वाभ्यंगं समाचरेत् ।\nस्नानवेदीं ततो गत्वा स्नापिता सा निजालिभिः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000624027, "chapter_id": 20624, "verse_number": "५-८३-२८", "content_sanskrit": "भूषागृहे व्रजेत्तत्र वयस्या भूषयंत्यपि ।\nभूषणैर्विविधैर्दिव्यैर्गंधमाल्यानुलेपनैः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000624028, "chapter_id": 20624, "verse_number": "५-८३-२९", "content_sanskrit": "ततः सखीजनैस्तस्याः श्वश्रूं संप्रार्थ्य यत्नतः ।\nकर्तुमाहूयतेस्वन्नं ससखी सा यशोदया ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000624029, "chapter_id": 20624, "verse_number": "५-८३-३०", "content_sanskrit": "नारद उवाच ।\nकथमाहूयते देवि पाकार्थं तु यशोदया ।\nसतीषु पाककर्त्रीषु रोहिणीप्रमुखास्वपि ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000624030, "chapter_id": 20624, "verse_number": "५-८३-३१", "content_sanskrit": "वृंदोवाच ।\nपूर्वं दुर्वाससा दत्तो वरस्तस्यै महामुने ।\nइति कात्यायनी वक्त्राच्छ्रुतमासीन्मया पुरा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000624031, "chapter_id": 20624, "verse_number": "५-८३-३२", "content_sanskrit": "त्वया यत्पच्यते देवि तदन्नं मदनुग्रहात् ।\nमिष्टं स्यादमृतस्पर्द्धि भोक्तुरायुष्करं तथा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000624032, "chapter_id": 20624, "verse_number": "५-८३-३३", "content_sanskrit": "इत्याह्वयति तां नित्यं यशोदा पुत्रवत्सला ।\nआयुष्मान्मे भवेत्पुत्रः स्वादुलोभात्तथा सती ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000624033, "chapter_id": 20624, "verse_number": "५-८३-३४", "content_sanskrit": "श्रुत्वानुमोदिता हृष्टा सापि नंदालयं व्रजेत् ।\nससखीप्रकरा तत्र गत्वा पाकं करोति च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000624034, "chapter_id": 20624, "verse_number": "५-८३-३५", "content_sanskrit": "कृष्णोऽपि दुग्ध्वा गाः काश्चिद्दोहयित्वा जनैः पराः ।\nआगच्छति पितुर्वाक्यात्स्वगृहं सखिभिर्वृतः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000624035, "chapter_id": 20624, "verse_number": "५-८३-३६", "content_sanskrit": "अभ्यंगमर्दनं कृत्वा दासैः संस्नापितो मुदा ।\nधौतवस्त्रधरः स्रग्वी चंदनाक्तकलेवरः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000624036, "chapter_id": 20624, "verse_number": "५-८३-३७", "content_sanskrit": "द्विफालबद्धचिकुरैर्ग्रीवा भालोपरिस्फुरन् ।\nचंद्राकारस्फुरद्भालतिलकालकरंजितः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000624037, "chapter_id": 20624, "verse_number": "५-८३-३८", "content_sanskrit": "कंकणांगदकेयूर रत्नमुद्रा लसत्करः ।\nमुक्ताहारस्फुरद्वक्षा मकराकृतिकुंडलः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000624038, "chapter_id": 20624, "verse_number": "५-८३-३९", "content_sanskrit": "मुहुराकारितो मात्रा प्रविशेद्भोजनालयम् ।\nअवलंब्य करं सख्युर्बलदेवमनुव्रतः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000624039, "chapter_id": 20624, "verse_number": "५-८३-४०", "content_sanskrit": "भुंक्तेऽथ विविधान्नानि भ्रात्रा च सखिभिर्वृतः ।\nहासयन्विविधैर्हास्यैः सखींस्तैर्हसति स्वयम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000624040, "chapter_id": 20624, "verse_number": "५-८३-४१", "content_sanskrit": "इत्थं भुक्त्वा तथाचम्य दिव्यखट्वोपरि क्षणम् ।\nविश्रम्य सेवकैर्दत्तं तांबूलं विभजन्नदन् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000624041, "chapter_id": 20624, "verse_number": "५-८३-४२", "content_sanskrit": "गोपवेषधरः कृष्णो धेनुवृंदपुरस्सरः ।\nव्रजवासिजनैः प्रीत्या सर्वैरनुगतः पथि ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000624042, "chapter_id": 20624, "verse_number": "५-८३-४३", "content_sanskrit": "पितरं मातरं नत्वा नेत्रांते नापितं गणम् ।\nयथायोग्यं तथा चान्यान्विनिवर्त्य वनं व्रजेत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000624043, "chapter_id": 20624, "verse_number": "५-८३-४४", "content_sanskrit": "वनं प्रविश्य सखिभिः क्रीडयित्वा क्षणं ततः ।\nविहारैर्विविधैस्तत्र वने विक्रीडते मुदा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000624044, "chapter_id": 20624, "verse_number": "५-८३-४५", "content_sanskrit": "वंचयित्वा ततः सर्वान्द्वित्रैः प्रियसखैर्वृतः ।\nसंकेतकं व्रजेद्धर्षात्प्रियासंदर्शनोत्सुकः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000624045, "chapter_id": 20624, "verse_number": "५-८३-४६", "content_sanskrit": "सापि कृष्णं वनं यातं दृष्ट्वा स्वं गृहमागता ।\nसूर्यादिपूजाव्याजेन कुसुमाहृतये तथा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000624046, "chapter_id": 20624, "verse_number": "५-८३-४७", "content_sanskrit": "वंचयित्वा गुरून्याति प्रियसंगेच्छया वनम् ।\nइत्थं तौ बहुयत्नेन मिलित्वा कानने ततः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000624047, "chapter_id": 20624, "verse_number": "५-८३-४८", "content_sanskrit": "विहारैर्विविधैस्तत्र दिनं विक्रीडतो मुदा ।\nदोलायां च समारूढौ सखिभिर्दोलितौ क्वचित् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000624048, "chapter_id": 20624, "verse_number": "५-८३-४९", "content_sanskrit": "क्वापि वेणुं करस्रस्तं प्रिययापह्नुतं हरिः ।\nअन्वेषयन्नुपालब्धो विप्रलब्धप्रियागणैः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000624049, "chapter_id": 20624, "verse_number": "५-८३-५०", "content_sanskrit": "हसितैर्बहुधा ताभिर्हासितस्तत्र तिष्ठति ।\nवसंतवायुना जुष्टं वनखण्डं मुदा क्वचित् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000624050, "chapter_id": 20624, "verse_number": "५-८३-५१", "content_sanskrit": "प्रविश्य चंदनांभोभिः कुंकुमादिजलैरपि ।\nनिषिंचतो यंत्रमुक्तैस्तत्पंकैर्लिंपतो मिथः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000624051, "chapter_id": 20624, "verse_number": "५-८३-५२", "content_sanskrit": "सख्योऽप्येवं निषिंचंति ताश्च तौ सिंचतः पुनः ।\nवसंतवायुजुष्टेषु वनखंडेषु सर्वतः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000624052, "chapter_id": 20624, "verse_number": "५-८३-५३", "content_sanskrit": "तत्तत्कालोचितैर्नानाविहारैः सगणौ द्विज ।\nश्रांतौ क्वचिद्वृक्षमूलमासाद्य मुनिसत्तम ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000624053, "chapter_id": 20624, "verse_number": "५-८३-५४", "content_sanskrit": "उपविश्यासने दिव्ये मधुपानं प्रचक्रतुः ।\nततो मधुमदोन्मत्तौ निद्रया मीलितेक्षणौ ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000624054, "chapter_id": 20624, "verse_number": "५-८३-५५", "content_sanskrit": "मिथः पाणी समालंब्य कामबाणवशं गतौ ।\nरिरंसूविशतःकुञ्जंस्खलद्वाङ्मनसौपथि ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000624055, "chapter_id": 20624, "verse_number": "५-८३-५६", "content_sanskrit": "क्रीडतश्च ततस्तत्र करिणीयूथपौ यथा ।\nसख्योऽपि मधुभिर्मत्ता निद्रयापीडितेक्षणाः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000624056, "chapter_id": 20624, "verse_number": "५-८३-५७", "content_sanskrit": "अभितो मंजुकुंजेषु सर्वा एवापि शिश्यिरे ।\nपृथगेकेन वपुषा कृष्णोऽपि युगपद्विभुः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000624057, "chapter_id": 20624, "verse_number": "५-८३-५८", "content_sanskrit": "सर्वासां संनिधिं गच्छेत्प्रियया प्रेरितो मुहुः ।\nरमयित्वा च ताः सर्वाः करिणीर्गजराडिव ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000624058, "chapter_id": 20624, "verse_number": "५-८३-५९", "content_sanskrit": "प्रियया च तथा ताभिः क्रीडार्थं च सरो व्रजेत् ।\nजलसेकैर्मिथस्तत्र क्रीडतः सगणौ ततः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000624059, "chapter_id": 20624, "verse_number": "५-८३-६०", "content_sanskrit": "वासः स्रक्चंदनैर्दिव्यैर्भूषणैरपि भूषितौ ।\nतत्रैव सरसस्तीरे दिव्यरत्नमये गृहे ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000624060, "chapter_id": 20624, "verse_number": "५-८३-६१", "content_sanskrit": "प्रागेव फलमूलानि कल्पितानि मया मुने ।\nहरिस्तु प्रथमं भुक्त्वा कांतया परिवेष्टितः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000624061, "chapter_id": 20624, "verse_number": "५-८३-६२", "content_sanskrit": "द्वित्राभिः सेवितो गच्छेच्छय्यां पुष्पविनिर्मिताम् ।\nतांबूलैर्व्यजनैस्तत्र पादसंवाहनादिभिः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000624062, "chapter_id": 20624, "verse_number": "५-८३-६३", "content_sanskrit": "सेव्यमानो हसंस्ताभिर्मोदते प्रेयसीं स्मरन् ।\nराधिकापि हरौ सुप्ते सगणा मुदितांतरा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000624063, "chapter_id": 20624, "verse_number": "५-८३-६४", "content_sanskrit": "अपि तत्र गतप्राणा तदुच्छिष्टं भुनक्ति च ।\nकिंचिदेव ततो भुक्त्वा व्रजेच्छय्यानिकेतनम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000624064, "chapter_id": 20624, "verse_number": "५-८३-६५", "content_sanskrit": "द्रष्टुं कांतमुखांभोजं चकोरीव निशाकरम् ।\nतांबूलचर्वितं तस्य तत्रत्याभिर्निवेदितम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000624065, "chapter_id": 20624, "verse_number": "५-८३-६६", "content_sanskrit": "तांबूलान्यपि चाश्नाति विभजंती प्रियालिषु ।\nकृष्णोऽपि तासां शुश्रूषुः स्वच्छंदं भाषितं मिथः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000624066, "chapter_id": 20624, "verse_number": "५-८३-६७", "content_sanskrit": "प्राप्तनिद्र इवाभाति विनिद्रोऽपि पटावृतः ।\nताश्च क्ष्वेली क्षणं कृत्वा कुतश्चिदनुमानतः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000624067, "chapter_id": 20624, "verse_number": "५-८३-६८", "content_sanskrit": "विदश्य रसनां दद्भिः पश्यंत्योऽन्योन्यमाननम् ।\nविलीना इव लज्जाब्धौ क्षणमूचुर्न किंचन ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000624068, "chapter_id": 20624, "verse_number": "५-८३-६९", "content_sanskrit": "क्षणादेव ततो वस्त्रं दूरीकृत्य तदंगतः ।\nसाधुनिद्रां गतोऽसीति हासयंत्यो हसंति च ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000624069, "chapter_id": 20624, "verse_number": "५-८३-७०", "content_sanskrit": "एवं तैर्विविधैर्हास्यै रममाणौ गणैः सह ।\nअनुभूय क्षणं निद्रा सुखं च मुनिसत्तम ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000624070, "chapter_id": 20624, "verse_number": "५-८३-७१", "content_sanskrit": "उपविश्यासने दिव्ये सगणौ विस्तृते मुदा ।\nपणीकृत्य मिथोहार चुंबाश्लेषपरिच्छदान् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000624071, "chapter_id": 20624, "verse_number": "५-८३-७२", "content_sanskrit": "अक्षै र्विक्रीडतः प्रेम्णा नर्मालापपुरस्सरम् ।\nपराजितोऽपि प्रियया जितोहमिति वै ब्रुवन् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000624072, "chapter_id": 20624, "verse_number": "५-८३-७३", "content_sanskrit": "हारादिग्रहणे तस्याः प्रवृत्तस्ताड्यते तया ।\nतयैवं ताडितः कृष्णः करेणास्य सरोरुहे ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000624073, "chapter_id": 20624, "verse_number": "५-८३-७४", "content_sanskrit": "विषण्णमानसो भूत्वा गंतुं प्रकुरुते मतिम् ।\nजितोऽस्मि चेत्त्वया देवि गृह्यतां यत्पणीकृतम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000624074, "chapter_id": 20624, "verse_number": "५-८३-७५", "content_sanskrit": "चुंबनादि मया दत्तमित्युक्त्वा सा तथाचरेत् ।\nकौटिल्यं तद्भ्रुवोर्द्रष्टुं श्रोतुं तद्भर्त्सनं वचः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000624075, "chapter_id": 20624, "verse_number": "५-८३-७६", "content_sanskrit": "ततः सारीशुकानां च श्रुत्वा वागाहवं मिथः ।\nनिर्गच्छतस्ततः स्थानाद्गंतुकामौ गृहं प्रति ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000624076, "chapter_id": 20624, "verse_number": "५-८३-७७", "content_sanskrit": "कृष्णः कांतामनुज्ञाप्य गवामभिमुखं व्रजेत् ।\nसा तु सूर्यगृहं गच्छेत्सखीमंडलसंयुता ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000624077, "chapter_id": 20624, "verse_number": "५-८३-७८", "content_sanskrit": "कियद्दूरं ततो गत्वा परावृत्य हरिं पुनः ।\nविप्रवेषं समास्थाय याति सूर्यगृहं प्रति ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000624078, "chapter_id": 20624, "verse_number": "५-८३-७९", "content_sanskrit": "सूर्यं प्रपूजयेत्तत्र प्रार्थितस्तत्सखीजनैः ।\nतदैव कल्पितैर्वेदैः परिहासविगर्भितैः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000624079, "chapter_id": 20624, "verse_number": "५-८३-८०", "content_sanskrit": "ततस्ता ज्ञापितं कांतं परिज्ञाय विचक्षणाः ।\nआनंदसागरे मग्ना न विदुः स्वं न चापरम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000624080, "chapter_id": 20624, "verse_number": "५-८३-८१", "content_sanskrit": "विहारैर्विविधैरेवं सार्द्धयामद्वयं मुने ।\nनीत्वा गृहं व्रजेयुस्ताः स च कृष्णो गवां व्रजेत् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000624081, "chapter_id": 20624, "verse_number": "५-८३-८२", "content_sanskrit": "संगम्य स्वसखीन्कृष्णो गृहीत्वा गाः समंततः ।\nआगच्छति व्रजं हर्षान्नादयन्मुरलद्यं मुने ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000624082, "chapter_id": 20624, "verse_number": "५-८३-८३", "content_sanskrit": "ततो नंदादयः सर्वे श्रुत्वा वेणुरवं हरेः ।\nगोधूलिपटलव्याप्तं दृष्ट्वा चापि नभस्तलम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000624083, "chapter_id": 20624, "verse_number": "५-८३-८४", "content_sanskrit": "विसृज्य सर्वकर्माणि स्त्रियो बालादयोऽपि च ।\nकृष्णस्याभिमुखं यांति तद्दर्शनसमुत्सुकाः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000624084, "chapter_id": 20624, "verse_number": "५-८३-८५", "content_sanskrit": "राजमार्गे व्रजद्वारि यत्र सर्वे व्रजौकसः ।\nकृष्णोऽपि तान्समागम्य यथावदनुपूर्वशः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000624085, "chapter_id": 20624, "verse_number": "५-८३-८६", "content_sanskrit": "दर्शनस्पर्शनैर्वाचा स्मितपूर्वावलोकनैः ।\nगोपवृद्धान्नमस्कारैः कायिकैर्वाचिकैरपि ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000624086, "chapter_id": 20624, "verse_number": "५-८३-८७", "content_sanskrit": "अष्टांगपातैः पितरौ रोहिणीमपि नारद ।\nनेत्रांतसूचितेनैव विनयेन प्रियां तथा ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000624087, "chapter_id": 20624, "verse_number": "५-८३-८८", "content_sanskrit": "एवं तैस्तद्यथायोग्यं व्रजौकोभिः प्रपूजितः ।\nगवालये तथा गाश्च संप्रवेश्य समंततः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000624088, "chapter_id": 20624, "verse_number": "५-८३-८९", "content_sanskrit": "पितृभ्यामर्थितो याति भ्रात्रा सह निजालयम् ।\nस्नात्वा पीत्वा तत्र किंचिद्भुक्त्वा मात्रानुमोदितः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000624089, "chapter_id": 20624, "verse_number": "५-८३-९०", "content_sanskrit": "गवालयं पुनर्याति दोग्धुकामो गवां पयः ।\nताश्च दुग्ध्वा दोहयित्वा पाययित्वा च काश्चन ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000624090, "chapter_id": 20624, "verse_number": "५-८३-९१", "content_sanskrit": "पित्रा सार्द्धं गृहं याति तत्र भावशतानुगः ।\nतत्र पित्रा पितृव्यैश्च तत्पुत्रैश्च बलेन च ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000624091, "chapter_id": 20624, "verse_number": "५-८३-९२", "content_sanskrit": "भुनक्ति विविधान्नानि चर्व्यचोष्यादिकानि च ।\nतन्मतिः प्रार्थनात्पूर्वं राधिका च तदैव ह ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000624092, "chapter_id": 20624, "verse_number": "५-८३-९३", "content_sanskrit": "प्रस्थापयेत्सखीद्वारा पक्वान्नानि तदालयम् ।\nश्लाघयंश्च हरिस्तानि भुक्त्वा पित्रादिभिः सह ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000624093, "chapter_id": 20624, "verse_number": "५-८३-९४", "content_sanskrit": "सभागृहं व्रजेत्तैश्च जुष्टं बंदिजनादिभिः ।\nपक्वान्नानि गृहीत्वा याः सख्यस्तत्र पुरागताः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000624094, "chapter_id": 20624, "verse_number": "५-८३-९५", "content_sanskrit": "बहूनि च पुनस्तानि प्रदत्तानि यशोदया ।\nसख्यस्तत्र तया दत्तं कृष्णोच्छिष्टं नयंति च ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000624095, "chapter_id": 20624, "verse_number": "५-८३-९६", "content_sanskrit": "सर्वं ताभिः समानीय राधिकायै निवेद्यते ।\nसापि भुक्त्वा सखीवर्गयुता तदनुपूर्वशः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000624096, "chapter_id": 20624, "verse_number": "५-८३-९७", "content_sanskrit": "सखीभिर्मंडिता तिष्ठेदभिसर्त्तुं समुद्यता ।\nप्रस्थाप्यते मया काचिदित एव ततः सखी ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000624097, "chapter_id": 20624, "verse_number": "५-८३-९८", "content_sanskrit": "तयाभिसारिता साथ यमुनायाः समीपतः ।\nकल्पवृक्षनिकुंजेऽस्मिन्दिव्यरत्नमये गृहे ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000624098, "chapter_id": 20624, "verse_number": "५-८३-९९", "content_sanskrit": "सितकृष्णनिशायोग्यवेषा याति सखीवृता ।\nकृष्णोऽपि विविधं तत्र दृष्ट्वा कौतूहलं ततः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000624099, "chapter_id": 20624, "verse_number": "५-८३-१००", "content_sanskrit": "कात्यायन्या मनोज्ञानि श्रुत्वा संगीतकान्यपि ।\nधनधान्यादिभिस्ताश्च प्रीणयित्वा विधानतः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000624100, "chapter_id": 20624, "verse_number": "५-८३-१०१", "content_sanskrit": "जनैराराधितो मात्रा याति सख्यानिकेतनम् ।\nमातरि प्रस्थितायां च भोजयित्वा ततो गृहम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000624101, "chapter_id": 20624, "verse_number": "५-८३-१०२", "content_sanskrit": "संकेतकं कांतयात्र समागच्छेदलक्षितः ।\nमिलित्वा तावुभावत्र क्रीडतो वनराजिषु ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000624102, "chapter_id": 20624, "verse_number": "५-८३-१०३", "content_sanskrit": "विहारैर्विविधै रासलास्यहासपुरस्सरैः ।\nसार्द्धयामद्वयं नीत्वा रात्रेरेवं विहारतः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000624103, "chapter_id": 20624, "verse_number": "५-८३-१०४", "content_sanskrit": "सुषुप्सू विशतः कुंजं पक्षिणीभिरलक्षितौ ।\nएकांते कुसुमैः कॢप्ते केलितल्पे मनोहरे ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000624104, "chapter_id": 20624, "verse_number": "५-८३-१०५", "content_sanskrit": "सुप्ता वा तिष्ठतस्तत्र सेव्यमानौ निजालिभिः ।\nइति ते सर्वमाख्यातं नैत्यकं चरितं हरेः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000624105, "chapter_id": 20624, "verse_number": "५-८३-१०६", "content_sanskrit": "पापिनोऽपि विमुच्यंते श्रवणादस्य नारद ।\nनारद उवाच ।\nधन्योऽस्म्यनुगृहीतोऽस्मि त्वया देवि न संशयः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000624106, "chapter_id": 20624, "verse_number": "५-८३-१०७", "content_sanskrit": "हरेर्दैनंदिनीलीला यतो मेऽद्य प्रकाशिता ।\nसूत उवाच ।\nइत्युक्त्वा तां परिक्रम्य तया चापि प्रपूजितः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000624107, "chapter_id": 20624, "verse_number": "५-८३-१०८", "content_sanskrit": "अंतर्धानं गतो ब्रह्मन्नारदो मुनिसत्तमः ।\nमयाप्येतच्चानुपूर्व्यात्सर्वमेव प्रकीर्तितम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000624108, "chapter_id": 20624, "verse_number": "५-८३-१०९", "content_sanskrit": "जपेन्नित्यं प्रयत्नेन मंत्रयुग्ममनुत्तमम् ।\nकृष्णवक्त्रादिदं लब्धं पुरा रुद्रेण यत्नतः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000624109, "chapter_id": 20624, "verse_number": "५-८३-११०", "content_sanskrit": "तेनोक्तं नारदायापि नारदेन ममोदितम् ।\nसंस्कारांश्च विधायैव मयाप्येतत्तवोदितम् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000624110, "chapter_id": 20624, "verse_number": "५-८३-१११", "content_sanskrit": "त्वयाप्येतद्गोपनीयं रहस्यं परमाद्भुतम् ।\nशौनक उवाच ।\nकृतकृत्योभवं साक्षात्त्वत्प्रसादादहं गुरो ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7000624111, "chapter_id": 20624, "verse_number": "५-८३-११२", "content_sanskrit": "रहस्यानां रहस्यं यत्त्वया मह्यं प्रकाशितम् ।\nसूत उवाच ।\nधर्मानेतानुपातिष्ठञ्जल्पन्मंत्रमहर्निशम् ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7000624112, "chapter_id": 20624, "verse_number": "५-८३-११३", "content_sanskrit": "अचिरादेव तद्दास्यमवाप्स्यसि न संशयः ।\nमयापि गम्यते ब्रह्मन्नित्यमायतनं विभोः ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7000624113, "chapter_id": 20624, "verse_number": "५-८३-११४", "content_sanskrit": "गुरोर्गुरोर्भानुजायाः कूले गोपीश्वरस्य च ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7000624114, "chapter_id": 20624, "verse_number": "५-८३-११५", "content_sanskrit": "इदं चरित्रं परमं पवित्रं प्रोक्तं महेशेन महानुभावम् ।\nशृण्वंति ये भक्तियुता मनुष्यास्ते यांति नित्यं पदमच्युतस्य ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7000624115, "chapter_id": 20624, "verse_number": "५-८३-११६", "content_sanskrit": "धन्यं यशस्यमायुष्यमारोग्याभीष्टसिद्धिदम् ।\nस्वर्गापवर्गसंपत्तिकारणं पापनाशनम् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7000624116, "chapter_id": 20624, "verse_number": "५-८३-११७", "content_sanskrit": "भक्त्या पठंति ये नित्यं मानवा विष्णुतत्पराः ।\nन तेषां पुनरावृत्तिर्विष्णुलोकात्कथंचन ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}]