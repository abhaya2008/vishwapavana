[{"id": 900004307, "chapter_id": 8334, "verse_number": "10.1", "content_sanskrit": "जातिः ‘न मेये मानापेक्षा ‘इत्यादिका", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900004308, "chapter_id": 8334, "verse_number": "10.2", "content_sanskrit": "मेये मानापेक्षाऽस्तीति च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900004309, "chapter_id": 8334, "verse_number": "10.3", "content_sanskrit": "न केवलमियं जातिः स्ववाक्यविरोधान्तर्गता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900004310, "chapter_id": 8334, "verse_number": "10.4", "content_sanskrit": "तदनेन प्रतिज्ञासंन्यासविरोधापसिद्धान्तानां निरनुयोज्यानुयोगे च जातेः विरोध एवान्तर्भावः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900004311, "chapter_id": 8334, "verse_number": "10.5", "content_sanskrit": "सिद्धमपि दूषणासमर्थमुत्तरम् जातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900004312, "chapter_id": 8334, "verse_number": "10.6", "content_sanskrit": "तत्रानभ्युपेतयुक्ताङ्केन प्रतिप्रमाणेन प्रतिपक्षतया प्रत्यव-स्थानं प्रतिधर्मसमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900004313, "chapter_id": 8334, "verse_number": "10.7", "content_sanskrit": "अत्र युक्ताङ्गहीनप्रतिप्रमाणोपलम्भो द्वारम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900004314, "chapter_id": 8334, "verse_number": "10.8", "content_sanskrit": "वादिसाधनसामर्थ्येन साध्यस्यैव व्याप्तिं विना ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900004315, "chapter_id": 8334, "verse_number": "10.9", "content_sanskrit": "दृष्टान्ते साध्यस्य साधनस्य वा व्यापकं किंञ्चित् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900004316, "chapter_id": 8334, "verse_number": "10.10", "content_sanskrit": "पक्षमात्रविवक्षितरूपवद्धेतुमत्वतदभावयोः सपक्षस्यापि साध्यत्वाऽपादनं वर्ण्यसमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900004317, "chapter_id": 8334, "verse_number": "10.11", "content_sanskrit": "अत्र पक्षमात्रविवक्षितरूपवद्धेतुमत्वादर्शनमुत्थानहेतुः साध्यसाधनवैकल्ये आरोप्ये", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900004318, "chapter_id": 8334, "verse_number": "10.12", "content_sanskrit": "सपक्षमात्रविवक्षितरूपवद्धेतुमत्वतदभावयोः पक्षस्य असाध्यत्वापादनमवर्ण्यसमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900004319, "chapter_id": 8334, "verse_number": "10.13", "content_sanskrit": "साधनस्य धर्मान्तरेण धर्मान्तरस्य साध्यधर्मेण ...", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900004320, "chapter_id": 8334, "verse_number": "10.14", "content_sanskrit": "अत्र क्वचिद्व्यभिचारदर्शनमुत्थानहेतुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900004321, "chapter_id": 8334, "verse_number": "10.15", "content_sanskrit": "पक्षाऽदीनां सिद्धानामपि तेनैव हेतुना साध्यत्वापादनं साध्यसमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900004322, "chapter_id": 8334, "verse_number": "10.16", "content_sanskrit": "अत्र विशिष्टसाधकत्वाभिमान उत्थानहेतुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900004323, "chapter_id": 8334, "verse_number": "10.17", "content_sanskrit": "साधनस्य साध्याप्राप्तिपक्षनिरासेन प्राप्तिपक्षमवशेष्य तददुषणं प्राप्तिसमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900004324, "chapter_id": 8334, "verse_number": "10.18", "content_sanskrit": "अप्राप्तावतिप्रसङ्गः अत्रोत्थानबीजम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900004325, "chapter_id": 8334, "verse_number": "10.19", "content_sanskrit": "प्राप्तिपक्षनिरासेन अप्राप्तिपक्षं शेषयित्वा तद्दूषणम् अप्राप्तिसमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900004326, "chapter_id": 8334, "verse_number": "10.20", "content_sanskrit": "सिद्धस्यापि पक्षाऽदेः उत्पादकज्ञापकानवस्थाप्रसञ्जनं प्रसङ्गसमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900004327, "chapter_id": 8334, "verse_number": "10.21", "content_sanskrit": "हेतुं विना प्रतिदृष्टान्तमात्रेण बाधप्रतिरोधोद्भावनं प्रति-दृष्टान्तसमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900004328, "chapter_id": 8334, "verse_number": "10.22", "content_sanskrit": "पक्षाऽदीनां प्रागुत्पत्तेः हेतुवृत्त्यभावेन असिद्ध्याद्युद्भावनं अनुत्पत्तिसमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900004329, "chapter_id": 8334, "verse_number": "10.23", "content_sanskrit": "सत्यपि निर्णयकारणे संशयकारणमात्रेण संशयापादनं संशयसमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900004330, "chapter_id": 8334, "verse_number": "10.24", "content_sanskrit": "अङ्गीकृतानधिकबलत्वेन बाधचोदनं प्रकरणसमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900004331, "chapter_id": 8334, "verse_number": "10.25", "content_sanskrit": "हेतोः साध्यात् पूर्वापरसहभावनिरासेन ओतुत्व-चोदनं ओतुसमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900004332, "chapter_id": 8334, "verse_number": "10.26", "content_sanskrit": "प्रतितर्कप्रतीतिरत्रोत्थानहेतुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900004333, "chapter_id": 8334, "verse_number": "10.27", "content_sanskrit": "व्याप्तिं विना वाद्युक्तिमात्रेण ‘अर्थात् इदमाक्षिप्तं’ ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900004334, "chapter_id": 8334, "verse_number": "10.28", "content_sanskrit": "साधनप्रतिबन्द्या तदितरधर्मेण तद्वतां सर्वपदार्थाना-मविशेषापादनं अविशेषसमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900004335, "chapter_id": 8334, "verse_number": "10.29", "content_sanskrit": "मत्पक्षेऽपि किञ्चित् प्रमाणं भविष्यतीति तदुप-पादनमुपपत्तिसमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900004336, "chapter_id": 8334, "verse_number": "10.30", "content_sanskrit": "वादिवाक्यस्यावधारणे तात्पर्यमारोप्य विकल्प्य तद्दूषणमुपलब्धिसमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900004337, "chapter_id": 8334, "verse_number": "10.31", "content_sanskrit": "उपलब्ध्यादिविषयिधर्माणां स्वात्मनि तदतद्रूपतां ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900004338, "chapter_id": 8334, "verse_number": "10.32", "content_sanskrit": "अत्र विषयिधर्मोपलब्धिः उत्थानबीजम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 900004339, "chapter_id": 8334, "verse_number": "10.33", "content_sanskrit": "विवक्षितस्य कस्यचिद्धर्मस्य तदतद्रूपतां विकल्प्य ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 900004340, "chapter_id": 8334, "verse_number": "10.34", "content_sanskrit": "वादिसाधनप्रतिबन्द्या धर्मान्तरेण सर्वस्य साध्य-धर्मवत्वापादनमनित्यसमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 900004341, "chapter_id": 8334, "verse_number": "10.35", "content_sanskrit": "पक्षादीनामन्यतमस्यासिद्धिमुद्भाव्य..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]