[{"id": 7006416000, "chapter_id": 26416, "verse_number": "२-७५-१", "content_sanskrit": "वैशम्पायन उवाच\nततो रथवरं कृष्णः समारुह्य महामनाः ।\nबिल्वोदकेश्वरं देवं नमस्कृत्य ययौ नृप ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006416001, "chapter_id": 26416, "verse_number": "२-७५-२", "content_sanskrit": "महेन्द्रमाह्वयामास रथस्थो मधुसूदनः ।\nसत्कृतं पुष्कराभ्याशे सर्वैर्देवगणैः सह ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006416002, "chapter_id": 26416, "verse_number": "२-७५-३", "content_sanskrit": "ततः शक्रो जयन्तोऽथ हरिभिर्युक्तमुत्तमम् ।\nआरुरोह रथं देवः सर्वकामप्रदः सताम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006416003, "chapter_id": 26416, "verse_number": "२-७५-४", "content_sanskrit": "ततो रथस्थयोर्युद्धमभवत् कुरुनन्दन ।\nदेवयोर्दैवयोगेन पारिजातकृते तदा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006416004, "chapter_id": 26416, "verse_number": "२-७५-५", "content_sanskrit": "ततोऽहनद् रणे विष्णुर्बाणैः शत्रुबलार्दनः ।\nसैन्यानि देवराजस्य बाणजालैरजिह्मगैः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006416005, "chapter_id": 26416, "verse_number": "२-७५-६", "content_sanskrit": "उपेन्द्रं न महेन्द्रोऽथ नैव विष्णुः सुरेश्वरम् ।\nताडयामासतुर्वीरौ शस्त्रैः शक्तावपि प्रभो ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006416006, "chapter_id": 26416, "verse_number": "२-७५-७", "content_sanskrit": "एकैकमश्वं दशभिर्महेन्द्रस्य जनार्दनः ।\nविव्याध विशिखैस्तीक्ष्णैरस्त्रयुक्तैर्जनेश्वर ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006416007, "chapter_id": 26416, "verse_number": "२-७५-८", "content_sanskrit": "शैब्याद्यानपि देवेन्द्रः शरैरमरसत्तमः ।\nछादयामास राजेन्द्र घोरैरस्त्राभिमन्त्रितैः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006416008, "chapter_id": 26416, "verse_number": "२-७५-९", "content_sanskrit": "स च बाणसहस्रैश्च कृष्णो गजमवाकिरत् ।\nगरुडं च महातेजा बलभिद्धरिवाहनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006416009, "chapter_id": 26416, "verse_number": "२-७५-१०", "content_sanskrit": "भूयिष्ठाभ्यां रथाभ्यां तौ तदहः शत्रुदारणौ ।\nयुयुधाते महात्मानौ नारायणसुराधिपौ ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006416010, "chapter_id": 26416, "verse_number": "२-७५-११", "content_sanskrit": "चकम्पे वसुधा कृत्स्ना नौर्जलस्थेव भारत ।\nदिशां दाहेन दिग्देशाः संवृताश्च समन्ततः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006416011, "chapter_id": 26416, "verse_number": "२-७५-१२", "content_sanskrit": "चेलुर्गिरिवराश्चैव पेतुश्च शतशो द्रुमाः ।\nपेतुश्च धरणीपृष्ठे मर्त्या धर्मगुणान्विताः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006416012, "chapter_id": 26416, "verse_number": "२-७५-१३", "content_sanskrit": "निर्घाताः शतशश्चैव पेतुस्तत्र नराधिप ।\nऊहुश्च सरितः सर्वाः प्रतिस्रोतो विशाम्पते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006416013, "chapter_id": 26416, "verse_number": "२-७५-१४", "content_sanskrit": "विष्वग्वाता ववुश्चैव पेतुरुल्काश्च निष्प्रभाः ।\nमुहुर्मुहुर्भूतसंघा रथनादेन मोहिताः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006416014, "chapter_id": 26416, "verse_number": "२-७५-१५", "content_sanskrit": "प्रजज्वाल जले चैव वह्निर्जनपदेश्वर ।\nयुयुधुश्च ग्रहैः सार्द्धं ग्रहा नभसि सर्वतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006416015, "chapter_id": 26416, "verse_number": "२-७५-१६", "content_sanskrit": "ज्योतींषि शतशः पेतुः स्वर्गाच्च धरणीतले ।\nदिशां गजाः प्रकुपिता नागाश्च धरणीतले ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006416016, "chapter_id": 26416, "verse_number": "२-७५-१७", "content_sanskrit": "गर्दभारुणसंस्थानैश्छिन्नाभ्रैश्चावृतं नभः ।\nविनदद्भिर्महारावैरुल्काशोणितवर्षिभिः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006416017, "chapter_id": 26416, "verse_number": "२-७५-१८", "content_sanskrit": "न भूर्न द्यौर्न गगनं नरेन्द्रवृषभाभवन् ।\nस्वस्थानि सुरवीरौ तु दृष्ट्वा युद्धगतौ तदा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006416018, "chapter_id": 26416, "verse_number": "२-७५-१९", "content_sanskrit": "जेपुर्मुनिगणा मन्त्राञ्जगतो हितकाम्यया ।\nब्राह्मणाश्च महात्मानो ह्यतिष्ठंस्तेषु सत्वराः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006416019, "chapter_id": 26416, "verse_number": "२-७५-२०", "content_sanskrit": "ततो ब्रह्मा महातेजाः कश्यपं वाक्यमब्रवीत् ।\nगच्छ बध्वा सहादित्या पुत्रौ वारय सुव्रत ॥ २०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006416020, "chapter_id": 26416, "verse_number": "२-७५-२१", "content_sanskrit": "स तथेति तदा देवमुक्त्वा पद्मभवं मुनिः ।\nजगाम रथमास्थाय तस्थौ नरवरान्तिके ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006416021, "chapter_id": 26416, "verse_number": "२-७५-२२", "content_sanskrit": "स्थितं तु कश्यपं दृष्ट्वा सहादित्या तदन्तरा ।\nउभौ रथाभ्यां धरणीमवतीर्णौ महाबलौ ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006416022, "chapter_id": 26416, "verse_number": "२-७५-२३", "content_sanskrit": "न्यस्तशस्त्रौ च तौ वीरौ ववन्दतुररिंदमौ ।\nपितरौ धर्मतत्त्वज्ञौ सर्वभूतहिते रतौ ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006416023, "chapter_id": 26416, "verse_number": "२-७५-२४", "content_sanskrit": "उभौ गृहीत्वा हस्ताभ्यामदितिस्त्वब्रवीद् वचः ।\nअसोदराविवैवं किमन्योन्यं हन्तुमिच्छतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006416024, "chapter_id": 26416, "verse_number": "२-७५-२५", "content_sanskrit": "स्वल्पमर्थं पुरस्कृत्य प्रवृत्तमतिदारुणम् ।\nसदृशं नेति पश्यामि सर्वथा मम पुत्रयोः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006416025, "chapter_id": 26416, "verse_number": "२-७५-२६", "content_sanskrit": "श्रोतव्यं यदि मातुश्च पितुश्चैव प्रजापतेः ।\nन्यस्तशस्त्रौ स्थितौ भूत्वा कुरुतं वचनं मम ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006416026, "chapter_id": 26416, "verse_number": "२-७५-२७", "content_sanskrit": "तथेत्युक्त्वा च तौ देवौ स्नातुकामौ महाबलौ ।\nगङ्गां जग्मतुरेवाथ प्रजल्पन्तौ परस्परम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006416027, "chapter_id": 26416, "verse_number": "२-७५-२८", "content_sanskrit": "शक्र उवाच\nत्वं प्रभुर्लोककृत् कृत्स्नराज्येऽहं स्थापितस्त्वया ।\nस्थापयित्वा कथं नाम पुनर्मामवमन्यसे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006416028, "chapter_id": 26416, "verse_number": "२-७५-२९", "content_sanskrit": "भ्रातृत्वमुपगम्यैव ज्येष्ठत्वं चाप्यपोह्य च ।\nकथं कमलपत्राक्ष निर्वाणं कर्तुमिच्छसि ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006416029, "chapter_id": 26416, "verse_number": "२-७५-३०", "content_sanskrit": "स्नातौ तु जाह्नवीतोये पुनरभ्यागतौ नृप ।\nयत्रादितिः कश्यपश्च महात्मानौ दृढव्रतौ ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006416030, "chapter_id": 26416, "verse_number": "२-७५-३१", "content_sanskrit": "प्रियसंगमनं नाम तं देशं मुनयोऽवदन् ।\nयत्र तौ संगतौ चोभौ पितृभ्यां कमलेक्षणौ ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006416031, "chapter_id": 26416, "verse_number": "२-७५-३२", "content_sanskrit": "ततः शक्रस्य कौरव्य दत्त्वा वाचाभयं तदा ।\nयत्र देवगणाः सर्वे समेता धर्मचारिणः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006416032, "chapter_id": 26416, "verse_number": "२-७५-३३", "content_sanskrit": "ततो ययुर्विमानैस्तु देवाः सर्वे त्रिविष्टपम् ।\nऋद्ध्या परमया युक्तास्तेषामेवानुरूपया ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006416033, "chapter_id": 26416, "verse_number": "२-७५-३४", "content_sanskrit": "कश्यपश्चादितिश्चैव तथा शक्रजनार्दनौ ।\nविमानमेकमारुह्य गता राजंस्त्रिविष्टपम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006416034, "chapter_id": 26416, "verse_number": "२-७५-३५", "content_sanskrit": "ते शक्रसदनं प्राप्ता रम्यं सर्वगुणान्वितम् ।\nऊषुरेकत्र कौरव्य मुदिता धर्मचारिणः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006416035, "chapter_id": 26416, "verse_number": "२-७५-३६", "content_sanskrit": "शची तु कश्यपं पत्न्या सहितं धर्मवत्सला ।\nउपाचरन्महात्मानं सर्वभूतहिते रतम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006416036, "chapter_id": 26416, "verse_number": "२-७५-३७", "content_sanskrit": "ततस्तस्यां प्रभातायां रजन्यामब्रवीद्धरिम् ।\nअदितिर्धर्मतत्त्वज्ञा सर्वभूतहितं वचः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006416037, "chapter_id": 26416, "verse_number": "२-७५-३८", "content_sanskrit": "उपेन्द्र द्वारकां गच्छ पारिजातं नयस्व च ।\nवध्वा सम्प्रापयस्वेश पुण्यकं हृदये स्थितम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006416038, "chapter_id": 26416, "verse_number": "२-७५-३९", "content_sanskrit": "पुण्यके सत्यया प्राप्ते पुनरेष त्वया तरुः ।\nनन्दने पुरुषश्रेष्ठ स्थाप्यः स्थाने यथोचिते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006416039, "chapter_id": 26416, "verse_number": "२-७५-४०", "content_sanskrit": "एवमस्त्विति कृष्णेन देवमाता यशस्विनी ।\nउक्ता धर्मगुणैर्युक्ता नारदेन महात्मना ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006416040, "chapter_id": 26416, "verse_number": "२-७५-४१", "content_sanskrit": "ततोऽभिवाद्य पितरं मातरं च जनार्दनः ।\nमहेन्द्रं सह शच्याथ प्रतस्थे द्वारकां प्रति ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006416041, "chapter_id": 26416, "verse_number": "२-७५-४२", "content_sanskrit": "ददौ कृष्णाय पौलोमी नियोगान् कुरुनन्दन ।\nसर्वासामेव कृष्णस्य भार्याणां धर्मचारिणी ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006416042, "chapter_id": 26416, "verse_number": "२-७५-४३", "content_sanskrit": "दिव्यानां सर्वरत्नानां वाससां च मनस्विनी ।\nनानारागविरक्तानां सदैवारजसामपि ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006416043, "chapter_id": 26416, "verse_number": "२-७५-४४", "content_sanskrit": "भार्याणां च सहस्राणि यानि षोडश माधवे ।\nप्रतिगृह्य महातेजाः प्रययौ द्वारकां प्रति ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006416044, "chapter_id": 26416, "verse_number": "२-७५-४५", "content_sanskrit": "सम्पूज्यमानो द्युतिमान् खेचरैः पुण्यकर्मभिः ।\nससात्यकिः सपुत्रश्च प्राप्तो रैवतकं गिरिम् ॥ ४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006416045, "chapter_id": 26416, "verse_number": "२-७५-४६", "content_sanskrit": "स तत्र स्थापयित्वा च पारिजातं वरद्रुमम् ।\nसात्यकं प्रेषयामास द्वारकां द्वारशालिनीम् ॥ ४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006416046, "chapter_id": 26416, "verse_number": "२-७५-४७", "content_sanskrit": "श्रीकृष्ण उवाच\nपारिजातमिहानीतं महेन्द्रसदनान्मया ।\nनिवेदय महाबाहो भैमानां भैमवर्द्धन ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006416047, "chapter_id": 26416, "verse_number": "२-७५-४८", "content_sanskrit": "अद्य द्वारवतीं चैव पारिजातमहं द्रुमम् ।\nप्रवेशयिष्ये नगरे शोभा प्रक्रियतां शुभा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006416048, "chapter_id": 26416, "verse_number": "२-७५-४९", "content_sanskrit": "इत्युक्तः सात्यको गत्वा तथोक्त्वा पुनरागतः ।\nकुमारैर्नागरैः सार्द्धं साम्बप्रभृतिभिः प्रभो ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006416049, "chapter_id": 26416, "verse_number": "२-७५-५०", "content_sanskrit": "ततोऽग्रतः पारिजातमारोप्य गरुडे तदा ।\nप्रद्युम्नो द्वारकां रम्यां विवेश रथिनां वरः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006416050, "chapter_id": 26416, "verse_number": "२-७५-५१", "content_sanskrit": "शैब्यादिहययुक्तेन रथेनानुययौ हरिः ।\nतस्याथ रथमुख्येन सात्यकः साम्ब एव च ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006416051, "chapter_id": 26416, "verse_number": "२-७५-५२", "content_sanskrit": "ये त्वन्ये नृप वार्ष्णेया यानैर्बहुविधैस्तथा ।\nययुः प्रहृष्टास्तत् कर्म पूजयन्तो महात्मनः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006416052, "chapter_id": 26416, "verse_number": "२-७५-५३", "content_sanskrit": "सात्यकाद् विस्तरं श्रुत्वा यादवा नागरास्तथा ।\nविस्मयं परमं जग्मुरप्रमेयस्य कर्मणा ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006416053, "chapter_id": 26416, "verse_number": "२-७५-५४", "content_sanskrit": "तं दिव्यकुसुमं वृक्षं दृष्ट्वाऽऽनर्तनिवासिनः ।\nराजन् न ततृपुर्हृष्टाः पश्यमाना महोदयम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006416054, "chapter_id": 26416, "verse_number": "२-७५-५५", "content_sanskrit": "तमद्भुतमचिन्त्यं च मदकेलिकलाण्डजम् ।\nवृक्षोत्तमं पश्यतां वै वृद्धानामगमज्जरा ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006416055, "chapter_id": 26416, "verse_number": "२-७५-५६", "content_sanskrit": "ये त्वन्धचक्षुषः सर्वे तेऽभवन् दिव्यचक्षुषः ।\nविरोगा रोगिणश्चासन् घ्रात्वा गन्धं वनस्पतेः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006416056, "chapter_id": 26416, "verse_number": "२-७५-५७", "content_sanskrit": "लपन्तः कौकिलाञ्छ्वेताञ्छ्रुत्वाऽऽनर्तनिवासिनः ।\nबभूवुर्हृष्टमनसो ववन्दुश्च जनार्दनम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006416057, "chapter_id": 26416, "verse_number": "२-७५-५८", "content_sanskrit": "तूर्याणि गेयानि मधुराणि च ।\nशुश्रुवुस्तस्य वृक्षस्य नातिदूरं गता नराः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006416058, "chapter_id": 26416, "verse_number": "२-७५-५९", "content_sanskrit": "योऽयं संकल्पयामास गन्धं हृद्यं नरस्तथा ।\nस तदैव तमाजघ्रे पारिजातसमुद्भवम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006416059, "chapter_id": 26416, "verse_number": "२-७५-६०", "content_sanskrit": "ततः प्रविश्य रम्यां तु द्वारकां यदुनन्दनः ।\nवसुदेवं महात्मानं ददृशे देवकीं तथा ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006416060, "chapter_id": 26416, "verse_number": "२-७५-६१", "content_sanskrit": "कुकुराधिपतिं चैव बलं भ्रातरमेव च ।\nवृद्धाश्च यादवानां ये मानार्हानमरोपमान् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006416061, "chapter_id": 26416, "verse_number": "२-७५-६२", "content_sanskrit": "विसृज्य तान् वै भगवाननादिनिधनोऽच्युतः ।\nसम्पूज्य च यथान्यायं स्वमेव भवनं गतः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006416062, "chapter_id": 26416, "verse_number": "२-७५-६३", "content_sanskrit": "स सत्यभामया वासं विवेश मधुसूदनः ।\nपारिजातं तरुश्रेष्ठं ग्रहाय गदपूर्वजः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006416063, "chapter_id": 26416, "verse_number": "२-७५-६४", "content_sanskrit": "सा देवी पूजयामास प्रहृष्टा वासवानुजम् ।\nप्रतिजग्राह तं चापि पारिजातं महाद्रुमम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006416064, "chapter_id": 26416, "verse_number": "२-७५-६५", "content_sanskrit": "मनीषितेन स तरुरल्पो भवति भारत ।\nमहांश्च वासुदेवस्य तदद्भुतमभून्महत् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006416065, "chapter_id": 26416, "verse_number": "२-७५-६६", "content_sanskrit": "कदाचिद् द्वारकां सर्वां प्रच्छादयति भारत ।\nकदाचिद्धस्तधार्यस्तु भवत्यङ्गुष्ठसंनिभः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006416066, "chapter_id": 26416, "verse_number": "२-७५-६७", "content_sanskrit": "ननन्द सत्या कौरव्य देवी प्राप्य मनोरथम् ।\nपुण्यकार्थं तु सम्भारान् सम्भर्तुमुपचक्रमे ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006416067, "chapter_id": 26416, "verse_number": "२-७५-६८", "content_sanskrit": "यानि द्रव्याणि कौरव्य जम्बूद्वीपे तु कानिचित् ।\nयोग्यानि तानि कृष्णेन सम्भृतानि महात्मना ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006416068, "chapter_id": 26416, "verse_number": "२-७५-६९", "content_sanskrit": "मुनिं तदासस्मृतवान् स नारदं\nजनार्दनः सर्वगुणोचितं वशी ।\nप्रतिग्रहार्थं व्रतकस्य सत्यया\nयथोपदिष्टस्य पुरंदरानुजः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]