[{"id": 7006372000, "chapter_id": 26372, "verse_number": "२-२८-१", "content_sanskrit": "वैशम्पायन उवाच\nस चिन्तयित्वा धनुषो भङ्गं भोजविवर्धनः ।\nबभूव विमना राजा चिन्तयन् भृशदुःखितः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006372001, "chapter_id": 26372, "verse_number": "२-२८-२", "content_sanskrit": "कथं बालो विगतभीरवमत्य महाबलम् ।\nप्रेक्ष्यमाणस्तु पुरुषैर्धनुर्भङ्क्त्वा विनिर्गतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006372002, "chapter_id": 26372, "verse_number": "२-२८-३", "content_sanskrit": "यस्यार्थे दारुणं कर्म कृतं लोकविगर्हितम् ।\nपितृष्वस्रात्मजान् वीरान्षडेवाहं न्यपोथयम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006372003, "chapter_id": 26372, "verse_number": "२-२८-४", "content_sanskrit": "दैवं पुरुषकारेण न शक्यमतिवर्तितुम् ।\nनारदोक्तं च वचनं नूनं मह्यमुपस्थितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006372004, "chapter_id": 26372, "verse_number": "२-२८-५", "content_sanskrit": "एवं राजा विचिन्त्याथ निष्क्रम्य स्वगृहोत्तमात् ।\nप्रेक्षागारं जगामाशु मञ्चानामवलोककः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006372005, "chapter_id": 26372, "verse_number": "२-२८-६", "content_sanskrit": "स दृष्ट्वा सर्वनिर्युक्तं प्रेक्षागारं नृपोत्तमः ।\nश्रेणीनां दृढनिर्युक्तैर्मञ्चवाटैर्निरन्तरम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006372006, "chapter_id": 26372, "verse_number": "२-२८-७", "content_sanskrit": "सोत्तमागारयुक्ताभिर्वलभीभिर्विभूषितम् ।\nछदीभिः सम्प्रवृद्धाभिरेकस्तम्भैर्विभूषितम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006372007, "chapter_id": 26372, "verse_number": "२-२८-८", "content_sanskrit": "सर्वतः सारनिर्व्यूहं स्वायतं सुप्रतिष्ठितम् ।\nउदग्राक्लिष्टसुक्लिष्टमञ्चारोहणमुत्तमम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006372008, "chapter_id": 26372, "verse_number": "२-२८-९", "content_sanskrit": "नृपासनपरिक्षिप्तं संचारपथसंकुलम् ।\nछन्नं तद् वेदिकाभिश्च मानुषौघभरक्षमम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006372009, "chapter_id": 26372, "verse_number": "२-२८-१०", "content_sanskrit": "स टष्ट्वा भूषितं रङ्गमाज्ञापयत बुद्धिमान् ।\nश्वः सचित्राः समाल्याश्च सपताकास्तथैव च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006372010, "chapter_id": 26372, "verse_number": "२-२८-११", "content_sanskrit": "सुवासिता वपुष्मन्त उपनीतोत्तरच्छदाः ।\nक्रियन्तां मञ्चवाटाश्च वलभ्यो वीथयस्तथा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006372011, "chapter_id": 26372, "verse_number": "२-२८-१२", "content_sanskrit": "रङ्गवाटे करीषस्य कल्प्यन्तां राशयोऽव्ययाः ।\nपटास्तरणशोभाश्च वलयश्चानुरूपतः ॥ १२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006372012, "chapter_id": 26372, "verse_number": "२-२८-१३", "content_sanskrit": "स्थाप्यन्तां सुनिखाताश्च पानकुम्भा यथाक्रमम् ।\nउदभारसहाः सर्वे सकाञ्चनघटोत्तमाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006372013, "chapter_id": 26372, "verse_number": "२-२८-१४", "content_sanskrit": "वलयश्चोपकल्प्यन्तां कषायाश्चैव कुम्भशः ।\nप्राश्निकाश्च निमन्त्र्यन्तां श्रेण्यश्च सपुरोगमाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006372014, "chapter_id": 26372, "verse_number": "२-२८-१५", "content_sanskrit": "आज्ञा च देया मल्लानां प्रेक्षकाणां तथैव च ।\nसमाजे मञ्चशोभाश्च कल्प्यन्तां सूपकल्पिताः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006372015, "chapter_id": 26372, "verse_number": "२-२८-१६", "content_sanskrit": "एवमाज्ञाप्य राजा स समाजविधिमुत्तमम् ।\nसमाजवाटान्निष्क्रम्य विवेश स्वं निवेशनम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006372016, "chapter_id": 26372, "verse_number": "२-२८-१७", "content_sanskrit": "आह्वानं तत्र संचक्रे तस्य मल्लद्वयस्य वै ।\nचाणूरस्याप्रमेयस्य मुष्टिकस्य तथैव च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006372017, "chapter_id": 26372, "verse_number": "२-२८-१८", "content_sanskrit": "तौ तु मल्लौ महावीर्यौ बलिनौ बाहुशालिनौ ।\nकंसस्याज्ञां पुरस्कृत्य हृष्टौ विविशतुस्तदा ॥ १८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006372018, "chapter_id": 26372, "verse_number": "२-२८-१९", "content_sanskrit": "तौ समीपगतौ दृष्ट्वा मल्लौ जगति विश्रुतौ ।\nउवाच कंसो नृपतिः सोपन्यासमिदं वचः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006372019, "chapter_id": 26372, "verse_number": "२-२८-२०", "content_sanskrit": "भवन्तौ मम विख्यातौ मल्लौ वीरध्वजोच्छ्रितौ ।\nपूजितौ च यथान्यायं सत्कारार्हौ विशेषतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006372020, "chapter_id": 26372, "verse_number": "२-२८-२१", "content_sanskrit": "तन्मत्तो यदि सत्कारः स्मर्यते सुकृतानि च ।\nकर्तव्यं मे महत् कर्म भवद्भ्यां स्वेन तेजसा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006372021, "chapter_id": 26372, "verse_number": "२-२८-२२", "content_sanskrit": "यावेतौ मम संवृद्धौ व्रजे गोपालकावुभौ ।\nसंकर्षणश्च कृष्णश्च बालावपि जितश्रमौ ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006372022, "chapter_id": 26372, "verse_number": "२-२८-२३", "content_sanskrit": "एतौ रङ्गगतौ युद्धे युद्ध्यमानौ वनेचरौ ।\nनिपातानन्तरं शीघ्रं हन्तव्यौ नात्र संशयः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006372023, "chapter_id": 26372, "verse_number": "२-२८-२४", "content_sanskrit": "बालाविमौ सुचपलावक्रियाविति सर्वथा ।\nनावज्ञा तत्र कर्तव्या कर्तव्यो यत्न एव हि ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006372024, "chapter_id": 26372, "verse_number": "२-२८-२५", "content_sanskrit": "ताभ्यां युधि निरस्ताभ्यां गोपाभ्यां रङ्गसंनिधौ ।\nआयत्यां च तदात्वे च श्रेयो मम भविष्यति ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006372025, "chapter_id": 26372, "verse_number": "२-२८-२६", "content_sanskrit": "नृपतेः स्नेहसंयुक्तैर्वचोभिर्हृष्टमानसौ ।\nऊचतुर्युद्धसम्मत्तौ मल्लौ चाणूरमुष्टिकौ ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006372026, "chapter_id": 26372, "verse_number": "२-२८-२७", "content_sanskrit": "यद्यावयोस्तौ प्रमुखे स्थास्येते गोपकिल्बिषौ ।\nहतावित्येव मन्तव्यौ प्रेतरूपौ तपस्विनौ ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006372027, "chapter_id": 26372, "verse_number": "२-२८-२८", "content_sanskrit": "यद्यावां प्रतियोत्स्येते तावरिष्टपरिप्लुतौ ।\nआवाभ्यां रोषयुक्ताभ्यां प्रमुखे तौ वनेचरौ ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006372028, "chapter_id": 26372, "verse_number": "२-२८-२९", "content_sanskrit": "एवं वाग्विषमुत्सृज्य तावुभौ मल्लपुङ्गवौ ।\nअनुज्ञातौ नरेन्द्रेण स्वे गृहे तौ प्रजग्मतुः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006372029, "chapter_id": 26372, "verse_number": "२-२८-३०", "content_sanskrit": "महामात्रं ततः कंसो बभाषे हस्तिजीविनम् ।\nहस्ती कुवलयापीडः समाजद्वारि तिष्ठतु ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006372030, "chapter_id": 26372, "verse_number": "२-२८-३१", "content_sanskrit": "बलवान् मदलोलाक्षश्चपलः क्रोधनो नृषु ।\nदानोत्कटकटश्चण्डः प्रतिवारणरोषणः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006372031, "chapter_id": 26372, "verse_number": "२-२८-३२", "content_sanskrit": "स संनोदयितव्यस्ते तावुद्दिश्य वनौकसौ ।\nवसुदेवसुतौ वीरौ यथा स्यातां गतायुषौ ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006372032, "chapter_id": 26372, "verse_number": "२-२८-३३", "content_sanskrit": "त्वया चैव गजेन्द्रेण यदि तौ गोष्ठजीविनौ ।\nभवेतां पतितौ रङ्गे पश्येयमहमुत्कटौ ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006372033, "chapter_id": 26372, "verse_number": "२-२८-३४", "content_sanskrit": "ततस्तौ पतितौ दृष्ट्वा वसुदेवः सबान्धवः ।\nछिन्नमूलो निरालम्बः सभार्यो विनशिष्यति ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006372034, "chapter_id": 26372, "verse_number": "२-२८-३५", "content_sanskrit": "ये चेमे यादवा मूर्खाः सर्वे कृष्णपरायणाः ।\nविनशिष्यन्ति च्छिन्नाशा दृष्ट्वा कृष्णं निपातितम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006372035, "chapter_id": 26372, "verse_number": "२-२८-३६", "content_sanskrit": "एतौ हत्वा गजेन्द्रेण मल्लैर्वा स्वयमेव वा ।\nपुरीं निर्यादवीं कृत्वा विचरिष्याम्यहं सुखी ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006372036, "chapter_id": 26372, "verse_number": "२-२८-३७", "content_sanskrit": "करके मैं सुखपूर्वक विचरूँगा ।\nपिता हि मे परित्यक्तो यादवानां कुलोद्वहः ।\nशेषाश्च मे परित्यक्ता यादवाः कृष्णपक्षिणः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006372037, "chapter_id": 26372, "verse_number": "२-२८-३८", "content_sanskrit": "न चाहमुग्रसेनेन जातः किल सुतार्थिना ।\nमानुषेणाल्पवीर्येण यथा मामाह नारदः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006372038, "chapter_id": 26372, "verse_number": "२-२८-३९", "content_sanskrit": "महामात्र उवाच\nकथमुक्तं नारदेन राजन् देवर्षिणा पुरा ।\nआश्चर्यमेतत् कथितं त्वत्तः श्रुतमरिंदम ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006372039, "chapter_id": 26372, "verse_number": "२-२८-४०", "content_sanskrit": "कथमन्येन जातस्त्वमुग्रसेनात् पितुर्विना ।\nतव मात्रा कथं राजन् कृतं कर्मेदमीदृशम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006372040, "chapter_id": 26372, "verse_number": "२-२८-४१", "content_sanskrit": "अन्यापि प्राकृता नारी न कुर्याच्च जुगुप्सितम् ।\nविस्तरं श्रोतुमिच्छामि ह्येतत् कौतूहलं हि मे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006372041, "chapter_id": 26372, "verse_number": "२-२८-४२", "content_sanskrit": "कंस उवाच\nयथा कथितवान् विप्रो महर्षिर्नारदः प्रभुः ।\nतथाहं सम्प्रवक्ष्यामि यदि तै श्रवणे मतिः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006372042, "chapter_id": 26372, "verse_number": "२-२८-४३", "content_sanskrit": "आगतः शक्रसदनात् स वै शक्रसखो मुनिः ।\nचन्द्रांशुशुक्लवसनो जटामण्डलमुद्वहन् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006372043, "chapter_id": 26372, "verse_number": "२-२८-४४", "content_sanskrit": "कृष्णाजिनोत्तरीयेण रुक्मयज्ञोपवीतवान् ।\nदण्डी कमण्डलुधरः प्रजापतिरिवापरः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006372044, "chapter_id": 26372, "verse_number": "२-२८-४५", "content_sanskrit": "गाता चतुर्णां वेदानां विद्वान् गान्धर्ववेदवित् ।\nस नारदोऽथ देवर्षिर्ब्रह्मलोकचरोऽव्ययः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006372045, "chapter_id": 26372, "verse_number": "२-२८-४६", "content_sanskrit": "तमागतमृषिं दृष्ट्वा पूजयित्वा यथाविधि ।\nपाद्यार्घ्यमासनं दत्त्वा सम्प्रवेश्योपविश्य ह ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006372046, "chapter_id": 26372, "verse_number": "२-२८-४७", "content_sanskrit": "सुखोपविष्टोऽथ मुनिः पृष्ट्वा च कुशलं मम ।\nउवाच च प्रीतमना देवर्षिर्भावितात्मवान् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006372047, "chapter_id": 26372, "verse_number": "२-२८-४८", "content_sanskrit": "नारद उवाच\nपूजितोऽहं त्वया वीर विधिदृष्टेन कर्मणा ।\nइदमेकं मम वचः श्रूयतां प्रतिगृह्यताम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006372048, "chapter_id": 26372, "verse_number": "२-२८-४९", "content_sanskrit": "गतोऽहं देवसदनं सौवर्णं मेरुपर्वतम् ।\nसोऽहं कदाचिद् देवानां समाजे मेरुमूर्धनि ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006372049, "chapter_id": 26372, "verse_number": "२-२८-५०", "content_sanskrit": "तत्र मन्त्रयतामेवं देवतानां मया श्रुतः ।\nभवतः सानुगम्यैव वधोपायः सुदारुणः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006372050, "chapter_id": 26372, "verse_number": "२-२८-५१", "content_sanskrit": "तत्र यो देवकीगर्भो विष्णुर्लोकनमस्कृतः ।\nयोऽस्या गर्भोऽष्टमः कंस स ते मृत्युर्भविष्यति ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006372051, "chapter_id": 26372, "verse_number": "२-२८-५२", "content_sanskrit": "देवानां स तु सर्वस्वं त्रिदिवस्य गतिश्च सः ।\nपरं रहस्यं देवानां स ते मृत्युर्भविष्यति ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006372052, "chapter_id": 26372, "verse_number": "२-२८-५३", "content_sanskrit": "यत्नश्च क्रियतां कंस गर्भाणां पातनं प्रति ।\nनावज्ञा रिपवे कार्या दुर्बले स्वजनेऽपि वा ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006372053, "chapter_id": 26372, "verse_number": "२-२८-५४", "content_sanskrit": "न चायमुग्रसेनः स पिता तव महाबलः ।\nद्रुमिलो नाम तेजस्वी सौभस्य पतिरूर्जितः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006372054, "chapter_id": 26372, "verse_number": "२-२८-५५", "content_sanskrit": "श्रुत्वाहं तद् वचस्तस्य किंचिद् रोषसमन्वितः ।\nभूयोऽपृच्छं कथं ब्रह्मन् द्रुमिलो नाम दानवः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006372055, "chapter_id": 26372, "verse_number": "२-२८-५६", "content_sanskrit": "मम मात्रा कथं तस्य ब्रूहि विप्र समागमः ।\nएतदिच्छाम्यहं श्रोतुं विस्तरेण तपोधन ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006372056, "chapter_id": 26372, "verse_number": "२-२८-५७", "content_sanskrit": "नारद उवाच\nहन्त ते कथयिष्यामि शृणु राजन् यथार्थतः ।\nद्रमिलस्य च मात्रा ते संवादं च समागमम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006372057, "chapter_id": 26372, "verse_number": "२-२८-५८", "content_sanskrit": "सुयामुनं नाम नगं तव माता रजस्वला ।\nप्रेक्षितुं सहिता स्त्रीभिर्गता वै सा कुतूहलात् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006372058, "chapter_id": 26372, "verse_number": "२-२८-५९", "content_sanskrit": "सा तत्र रमणीयेषु रुचिरद्रुमसानुषु ।\nचचार नगशृङ्गेषु कन्दरेषु नदीषु च ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006372059, "chapter_id": 26372, "verse_number": "२-२८-६०", "content_sanskrit": "किन्नरोद्गीतमधुराः प्रतिश्रुत्यभिनादिताः ।\nशृण्वन्ती काजननीर्वाचः श्रोत्रसुखावहाः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006372060, "chapter_id": 26372, "verse_number": "२-२८-६१", "content_sanskrit": "बर्हिणां चैव विरुतं खगानां च विकूजितम् ।\nअभीक्ष्णमभिशृण्वन्ती स्त्रीधर्ममभिरोचयत् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006372061, "chapter_id": 26372, "verse_number": "२-२८-६२", "content_sanskrit": "एतस्मिन्नन्तरे वायुर्वनराजिविनिःसृतः ।\nहृद्यः कुसुमगन्धाढ्यो ववौ मन्मथबोधनः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006372062, "chapter_id": 26372, "verse_number": "२-२८-६३", "content_sanskrit": "द्विरेफाभरणाश्चैव कदम्बा वायुघट्टिताः ।\nमुमुचुर्गन्धमधिकं संततासारमूर्छिताः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006372063, "chapter_id": 26372, "verse_number": "२-२८-६४", "content_sanskrit": "केसराः पुष्पवर्षैश्च ववृषुर्मदबोधनाः ।\nनीपा दीपा इवाभान्ति पुष्पकण्टकधारिणः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006372064, "chapter_id": 26372, "verse_number": "२-२८-६५", "content_sanskrit": "मही नवतृणच्छन्ना शक्रगोपविभूषिता ।\nयौवनस्थेव वनिता स्वं दधारार्तवं वपुः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006372065, "chapter_id": 26372, "verse_number": "२-२८-६६", "content_sanskrit": "अथ सौभपतिः श्रीमान् द्रुमिलो नाम दानवः ।\nभविष्यद्दैवयोगेन विधात्रा तत्र नीयते ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006372066, "chapter_id": 26372, "verse_number": "२-२८-६७", "content_sanskrit": "कामगेन रथेनाशु तरुणादित्यवर्चसा ।\nयदृच्छया गतस्तत्र सुयामुनदिदृक्षया ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006372067, "chapter_id": 26372, "verse_number": "२-२८-६८", "content_sanskrit": "विहायसा कामगमो मनसोऽप्याशुगामिना ।\nस तं प्राप्य पर्वतेन्द्रमवतीर्य रथोत्तमात् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006372068, "chapter_id": 26372, "verse_number": "२-२८-६९", "content_sanskrit": "पर्वतोपवने न्यस्य रथं पररथारुजम् ।\nअथासौ सूतसहितश्चचार नगमूर्धनि ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006372069, "chapter_id": 26372, "verse_number": "२-२८-७०", "content_sanskrit": "ततो बहून्यपश्येतां काननानि वनानि च ।\nसर्वर्तुगुणसम्पन्नं नन्दनस्येव काननम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006372070, "chapter_id": 26372, "verse_number": "२-२८-७१", "content_sanskrit": "चेरतुर्नगशृङ्गेषु कन्दरेषु नदीषु च ।\nनानाधातुपिनद्धैश्च शृङ्गैर्बहुभिरुच्छ्रितैः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006372071, "chapter_id": 26372, "verse_number": "२-२८-७२", "content_sanskrit": "नानारत्नविचित्रैश्च काञ्चनाञ्जनराजतान् ।\nनानाकुसुमगन्धाढ्यान् नानासत्त्वगणैर्युतान् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006372072, "chapter_id": 26372, "verse_number": "२-२८-७३", "content_sanskrit": "नानाद्विजगणैर्घुष्टान् नानापुष्पफलद्रुमान् ।\nनानौषधिसमायुक्तानृषिसिद्धानुसेवितान् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006372073, "chapter_id": 26372, "verse_number": "२-२८-७४", "content_sanskrit": "विद्याधरान् किम्पुरुषानृक्षवानरराक्षसान् ।\nसिंहान् व्याघ्रान् वराहांश्च महिषाञ्छरभाञ्छशान ॥७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006372074, "chapter_id": 26372, "verse_number": "२-२८-७५", "content_sanskrit": "सृमरांश्चमरान्न्यङ्कून् मातङ्गान् यक्षराक्षसान् ।\nएवं बहुविधान् पश्यंश्चरमाणो नगोत्तमम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006372075, "chapter_id": 26372, "verse_number": "२-२८-७६", "content_sanskrit": "दूराद् ददर्श नृपतिर्देवीं देवसुतोपमाम् ।\nक्रीडमानां सखीभिश्च पुष्पं चैव विचिन्वतीम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006372076, "chapter_id": 26372, "verse_number": "२-२८-७७", "content_sanskrit": "ततश्चरन्तीं सुश्रोणीं सस्त्रीभिः सह संवृताम् ।\nदृप्त सौभपतिर्दूराद् विस्मयन् सूतमब्रवीत् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006372077, "chapter_id": 26372, "verse_number": "२-२८-७८", "content_sanskrit": "कस्येयं मृगशावाक्षी वनान्तरविचारिणी ।\nरूपौदार्यगुणोपेता मन्मथस्य रतिर्यथा ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006372078, "chapter_id": 26372, "verse_number": "२-२८-७९", "content_sanskrit": "शचीव पुरुहूतस्य उताहो वा तिलोत्तमा ।\nनारायणोरुं निर्भिद्य सम्भूता वरवर्णिनी ।\nऐलस्य दयिता देवी योषिद्रत्नं  किमुर्वशी ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006372079, "chapter_id": 26372, "verse_number": "२-२८-८०", "content_sanskrit": "क्षीरार्णवे मथ्यमाने सुरासुरगणैः सह ।\nमन्थानं मन्दरं कृत्वामृतार्थमिति नः श्रुतम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006372080, "chapter_id": 26372, "verse_number": "२-२८-८१", "content_sanskrit": "ततोऽमृतात्समुत्तस्थौ देवी श्रीर्लोकभाविनी ।\nनारायणाङ्कलुलिता किं श्रीरेषा वराङ्गना ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006372081, "chapter_id": 26372, "verse_number": "२-२८-८२", "content_sanskrit": "नीलमेघान्तरगता द्योतयन्त्यचिरप्रभा ।\nतथा योषिद्गणान् मध्ये रूपं प्रद्योतयद् वनम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006372082, "chapter_id": 26372, "verse_number": "२-२८-८३", "content_sanskrit": "अतीव सुकुमाराङ्गी सुप्रभेन्दुनिभानना ।\nदृष्ट्वा रूपमनिन्द्याङ्ग्या विभ्रान्तो व्याकुलेन्द्रियः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006372083, "chapter_id": 26372, "verse_number": "२-२८-८४", "content_sanskrit": "कामस्य वशमापन्नो मनो विह्वलतीव मे ।\nभृशं कृन्तति मेऽङ्गानि सायकैः कुसुमायुधः ।\nभित्त्वा हृदि शरान् पञ्च निर्दयं हन्ति मे मनः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006372084, "chapter_id": 26372, "verse_number": "२-२८-८५", "content_sanskrit": "हदयाग्निर्वर्धयति आज्यसिक्त इवानलः ।\nकथमद्य भवेत् कार्यं शमार्थं मन्मथाग्निना ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006372085, "chapter_id": 26372, "verse_number": "२-२८-८६", "content_sanskrit": "केनोपायेन किं कुर्मो भजेन्मां मत्तगामिनी ।\nएवं बहु चिन्तयानो नोपलभ्य च दानवः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006372086, "chapter_id": 26372, "verse_number": "२-२८-८७", "content_sanskrit": "सूतमाह मुहूर्तं तु तिष्ठस्व त्वमिहानघ ।\nअहं यास्यामि तां द्रष्टुं कस्येयमिति योषितम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006372087, "chapter_id": 26372, "verse_number": "२-२८-८८", "content_sanskrit": "प्रतीक्षमाणस्तिष्ठस्व यावदागमनं मम ।\nश्रुत्वा तु वचनं तस्य तथास्त्विति वचोऽब्रवीत् ॥८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006372088, "chapter_id": 26372, "verse_number": "२-२८-८९", "content_sanskrit": "एवमुक्त्वा दानवेन्द्रो गमनाय मनो दधे ।\nवार्युपस्पृश्य बलवान् ध्यानमेवान्वचिन्तयत् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006372089, "chapter_id": 26372, "verse_number": "२-२८-९०", "content_sanskrit": "मुहूर्तं ध्यानमात्रेण दृष्टं ज्ञानबलात् ततः ।\nउग्रसेनस्य पत्नीति ज्ञात्वा हर्षमुपागतः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006372090, "chapter_id": 26372, "verse_number": "२-२८-९१", "content_sanskrit": "उग्रसेनस्य रूपं वै कृत्वा स्वं परिवर्त्य सः ।\nउपासर्पन्महाबाहुः प्रहसन् दानवेश्वरः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006372091, "chapter_id": 26372, "verse_number": "२-२८-९२", "content_sanskrit": "स्मयमानश्च शनकैर्जग्राहामितवीर्यवान् ।\nउग्रसेनस्य रूपेण मातरं ते व्यधर्षयत् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006372092, "chapter_id": 26372, "verse_number": "२-२८-९३", "content_sanskrit": "सा पतिस्निग्धहृदया तं भावेनोपसर्पती ।\nशङ्किता चाभवत्पश्चात्तस्य गौरवदर्शनात् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006372093, "chapter_id": 26372, "verse_number": "२-२८-९४", "content_sanskrit": "सा तमाहोत्थिता भीता न त्वं मम पतिर्धुवम् ।\nकस्य त्वं विकृताचारो येनास्मि मलिनीकृता ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006372094, "chapter_id": 26372, "verse_number": "२-२८-९५", "content_sanskrit": "एकभर्तृव्रतमिदं मम संदूषितं त्वया ।\nपत्युर्मे रूपमास्थाय नीच नीचेन कर्मणा ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006372095, "chapter_id": 26372, "verse_number": "२-२८-९६", "content_sanskrit": "किं मां वक्ष्यन्ति रुषिता बान्धवाः कुलपांसनीम् ।\nजुगुप्सिता च वत्स्यामि पतिपक्षैर्निराकृता ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006372096, "chapter_id": 26372, "verse_number": "२-२८-९७", "content_sanskrit": "धिक्त्वामीदृशमक्षान्तं दुष्कुलं व्युत्थितेन्द्रियम् ।\nअविश्वास्यमनार्यं च परदाराभिमर्शनम् ॥९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006372097, "chapter_id": 26372, "verse_number": "२-२८-९८", "content_sanskrit": "स तामाह प्रसज्जन्तीं क्षिप्तः क्रोधेन दानवः ।\nअहं वै द्रुमिलो नाम सौभस्य पतिरूर्जितः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7006372098, "chapter_id": 26372, "verse_number": "२-२८-९९", "content_sanskrit": "किं मां क्षिपसि रोषेण मूढे पण्डितमानिनि ।\nमानुषं पतिमाश्रित्य नीचं मृत्युवशे स्थितम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7006372099, "chapter_id": 26372, "verse_number": "२-२८-१००", "content_sanskrit": "व्यभिचारान्न दुष्यन्ति स्त्रियः स्त्रीमानगर्विते ।\nन ह्यासां नियता बुद्धिर्मानुषीणां विशेषतः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7006372100, "chapter_id": 26372, "verse_number": "२-२८-१०१", "content_sanskrit": "श्रूयन्ते हि स्त्रियो बह्व्यो व्यभिचारव्यतिक्रमैः ।\nप्रसूता देवसंकाशान् पुत्रान् निश्चलविक्रमान् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7006372101, "chapter_id": 26372, "verse_number": "२-२८-१०२", "content_sanskrit": "अतीव हि त्वं स्त्रीलोके पतिधर्मवती सती ।\nशुद्धा केशान्विधुन्वन्ती भाषसे यद्यदिच्छसि॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7006372102, "chapter_id": 26372, "verse_number": "२-२८-१०३", "content_sanskrit": "कस्य त्वमिति यच्चाहं त्वयोक्तो मत्तकाशिनि ।\nकंसस्तस्माद् रिपुध्वंसी तव पुत्रो भविष्यति ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7006372103, "chapter_id": 26372, "verse_number": "२-२८-१०४", "content_sanskrit": "सा सरोषा पुनर्भूत्वा निन्दन्ती तस्य तं वरम् ।\nउवाच व्यथिता देवी दानवं धृष्टवादिनम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7006372104, "chapter_id": 26372, "verse_number": "२-२८-१०५", "content_sanskrit": "धिक ते वृत्तं सुदुर्वृत्त यः सर्वा निन्दसि स्त्रियः।\nसन्ति स्त्रियो नीचवृत्ताः सन्ति चैव पतिव्रताः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7006372105, "chapter_id": 26372, "verse_number": "२-२८-१०६", "content_sanskrit": "यास्त्वेकपत्न्यः श्रूयन्तेऽरुन्धतीप्रमुखाः स्त्रियः ।\nधृता याभिः प्रजाः सर्वा लोकाश्चैव कुलाधम ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7006372106, "chapter_id": 26372, "verse_number": "२-२८-१०७", "content_sanskrit": "यस्त्वया मम पुत्रो वै दत्तो वृत्तविनाशनः ।\nन मे बहुमतस्त्वेष शृणु चापि यदुच्यते ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7006372107, "chapter_id": 26372, "verse_number": "२-२८-१०८", "content_sanskrit": "उत्पत्स्यति पुमान् नीच पतिवंशे ममाद्य यः ।\nभविष्यति स ते मृत्युर्यश्च दत्तस्त्वया सुतः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7006372108, "chapter_id": 26372, "verse_number": "२-२८-१०९", "content_sanskrit": "द्रुमिलस्त्वेवमुक्तस्तु जगामाकाशमेव तु ।\nतेनैव रथमुख्येन दिव्येनाप्रतिगामिना ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7006372109, "chapter_id": 26372, "verse_number": "२-२८-११०", "content_sanskrit": "जगाम च पुरीं दीना माता तदहरेव ते ।\nमामेवमुक्त्वा भगवान् नारदो मुनिसत्तमः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7006372110, "chapter_id": 26372, "verse_number": "२-२८-१११", "content_sanskrit": "दीप्यमानस्तपोवीर्यात् साक्षादग्निरिव ज्वलन् ।\nवल्लकीं वाद्यमानो हि सप्तस्वरविमूर्च्छिताम् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7006372111, "chapter_id": 26372, "verse_number": "२-२८-११२", "content_sanskrit": "गायनो लक्ष्यवीथीं स जगाम ब्रह्मणोऽन्तिकम् ।\nशृणुष्वेदं महामात्र निबोध वचनं मम ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7006372112, "chapter_id": 26372, "verse_number": "२-२८-११३", "content_sanskrit": "तथ्यं चोक्तं नारदेन त्रैलोक्यज्ञेन धीमता ।\nअलं बलेन वीर्येण नयेन विनयेन च ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7006372113, "chapter_id": 26372, "verse_number": "२-२८-११४", "content_sanskrit": "प्रमाणैर्वापि वीर्येण तेजसा विक्रमेण च ।\nसत्येन चैव दानेन नान्योऽस्ति सदृशः पुमान् ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7006372114, "chapter_id": 26372, "verse_number": "२-२८-११५", "content_sanskrit": "विदित्वा सर्वमात्मानं वचनं श्रद्दधाम्यहम् ।\nक्ष्रेत्रजोऽहं सुतस्तस्य उग्रसेनस्य हस्तिप ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7006372115, "chapter_id": 26372, "verse_number": "२-२८-११६", "content_sanskrit": "मातापितृभ्यां संत्यक्तः स्थापितः स्वेन तेजसा ।\nउभाभ्यामपि विद्विष्टो बान्धवैश्च विशेषतः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7006372116, "chapter_id": 26372, "verse_number": "२-२८-११७", "content_sanskrit": "एतानपि हनिष्यामि यादवान् कृष्णपक्षिणः ।\nतदिमौ घातयित्वा तु हस्तिना गोपकिल्बिषौ ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7006372117, "chapter_id": 26372, "verse_number": "२-२८-११८", "content_sanskrit": "तद् गच्छ गजमारुह्य सांकुशप्रासतोमरः ।\nस्थिरो भव महामात्र समाजद्वारि मा चिरम् ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}]