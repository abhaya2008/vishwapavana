[{"id": 7006421000, "chapter_id": 26421, "verse_number": "२-८१-१", "content_sanskrit": "उमोवाच\nबान्धवान् सगुणानिच्छेदेकभक्तेन नित्यदा ।\nसप्तमीं सप्तमीं नित्यं क्षपेत् स्त्री पतिदेवता ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006421001, "chapter_id": 26421, "verse_number": "२-८१-२", "content_sanskrit": "ततः संवत्सरे पूर्णे वृक्षं दद्याद्धिरण्मयम् ।\nसदक्षिणं ब्राह्मणाय शुभबन्धुमती भवेत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006421002, "chapter_id": 26421, "verse_number": "२-८१-३", "content_sanskrit": "करञ्जे दीपकं दद्यात् सदा या प्रमदा वरे ।\nपूर्णे संवत्सरे दद्यात् सौवर्णं दीपकं ततः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006421003, "chapter_id": 26421, "verse_number": "२-८१-४", "content_sanskrit": "रुच्या सा स्त्री भवेद् भर्तुरिष्टा पुत्रवती तथा ।\nसपत्नीनामधि तथा दीपवज्ज्वलते शुभे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006421004, "chapter_id": 26421, "verse_number": "२-८१-५", "content_sanskrit": "या शेषभोजिनी नित्यं नैव च स्यादरुन्तुदा ।\nन च स्याद्व्यशना सौम्ये नित्यं च पतिदेवता ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006421005, "chapter_id": 26421, "verse_number": "२-८१-६", "content_sanskrit": "शौचान्विता च सततं न च रूक्षाभिभाषिणी ।\nश्वश्रूश्वशुरयोर्निंत्यं शुश्रूषाभिरता सती ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006421006, "chapter_id": 26421, "verse_number": "२-८१-७", "content_sanskrit": "किं तस्या व्रतकैः कार्यं किं वा स्यादुपवासकैः ।\nया भर्तृदेवता नित्यं सत्यधर्मगुणान्विता ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006421007, "chapter_id": 26421, "verse_number": "२-८१-८", "content_sanskrit": "विधवा स्त्री तु या हि स्याद्दैवयोगात्सती सति ।\nतस्या वक्ष्यामि यो धर्मः पुराणोक्तः सुमध्यमे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006421008, "chapter_id": 26421, "verse_number": "२-८१-९", "content_sanskrit": "पतिं संकल्पयित्वा सा चित्रस्थं वाथ मृन्मयम् ।\nतस्य पूजां सदा कुर्यात् सतां धर्ममनुस्मरेत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006421009, "chapter_id": 26421, "verse_number": "२-८१-१०", "content_sanskrit": "तत एवाभ्यनुज्ञां सा नित्यं याचेत सुव्रता ।\nव्रतके चोपवासे च भोजने च विशेषतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006421010, "chapter_id": 26421, "verse_number": "२-८१-११", "content_sanskrit": "भर्तृलोकान् व्रजत्येव न चेद् व्युच्चरते पतिम् ।\nशाण्डिली सूर्यवद् भाति सततं पतिदेवता ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006421011, "chapter_id": 26421, "verse_number": "२-८१-१२", "content_sanskrit": "अद्यप्रभृति सर्वेषां देवानां चैव योषितः ।\nद्रक्ष्यन्ति पुण्यकविधिं पौराणो यः सनातनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006421012, "chapter_id": 26421, "verse_number": "२-८१-१३", "content_sanskrit": "मुनिश्च नारदः कृत्स्नं पौराणं ज्ञास्यते विधिम् ।\nउपवासस्य धर्मात्मा व्रतकानां तथैव च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006421013, "chapter_id": 26421, "verse_number": "२-८१-१४", "content_sanskrit": "अदितिस्तपसेन्द्राणी त्वं च सोमसुते वरे ।\nप्रवर्तने पुण्यकानां व्रतकानां च सर्वदा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006421014, "chapter_id": 26421, "verse_number": "२-८१-१५", "content_sanskrit": "कीर्तनीयाः सतीनां हि भविष्यथ गुणान्विताः ।\nउपवासव्रतविधिं यथावदिह कृत्स्नशः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006421015, "chapter_id": 26421, "verse_number": "२-८१-१६", "content_sanskrit": "प्रादुर्भावेषु सर्वेषु भार्या विष्णोर्महात्मनः ।\nज्ञास्यन्ति पुण्यकविधिं नित्यमेव सनातनम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006421016, "chapter_id": 26421, "verse_number": "२-८१-१७", "content_sanskrit": "सविशेषं च धर्माणां स्त्रीधर्मेषु प्रशस्यते ।\nपतिभक्तिरदुष्टत्वमवाग्दुष्टत्वमेव च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006421017, "chapter_id": 26421, "verse_number": "२-८१-१८", "content_sanskrit": "नारद उवाच\nएवमुक्तास्तु ताः साध्व्यो महादेव्या तपोधनाः ।\nजग्मुर्हृष्टा महादेवीं प्रणिपत्य हरप्रियाम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006421018, "chapter_id": 26421, "verse_number": "२-८१-१९", "content_sanskrit": "अदितिर्व्रतकं चक्रे शृणु यद् धर्मचारिणी ।\nउमाव्रतविधिः सर्वः पूर्वोद्दिष्टस्तया कृतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006421019, "chapter_id": 26421, "verse_number": "२-८१-२०", "content_sanskrit": "पारिजाते निबध्याथ मम दत्तस्तु कश्यपः ।\nअदितिव्रतकं नाम तद् दत्तं सत्यभामया ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006421020, "chapter_id": 26421, "verse_number": "२-८१-२१", "content_sanskrit": "तदेव व्रतकं दत्तं सावित्र्या धर्मनित्यया ।\nतैरेव युक्तैः संयुक्तमिदं त्वभ्यधिकं कृतम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006421021, "chapter_id": 26421, "verse_number": "२-८१-२२", "content_sanskrit": "संध्याकाले तु सम्प्राप्ते स्थाने स्थाने तथैव च ।\nपूजनं वा नमस्कारो जपश्च द्विगुणः स्मृतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006421022, "chapter_id": 26421, "verse_number": "२-८१-२३", "content_sanskrit": "सावित्रीव्रतकं कृत्वा तथादित्या व्रतं सती ।\nभर्तुः कुलं पितृकुलमात्मानं चैव तारयेत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006421023, "chapter_id": 26421, "verse_number": "२-८१-२४", "content_sanskrit": "इन्द्राणी व्रतकं चक्रे तदेवौमं यथाविधि ।\nरक्तमभ्यधिकं वासो भोजनं चैव सामिषम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006421024, "chapter_id": 26421, "verse_number": "२-८१-२५", "content_sanskrit": "चतुर्थे दिवसे वापि पुण्यकार्थं विधिः पुनः ।\nअहोरात्रोपवासश्च देयं कुम्भशतं तथा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006421025, "chapter_id": 26421, "verse_number": "२-८१-२६", "content_sanskrit": "गङ्गया व्रतकं दत्तं तदेवौमं यशस्करि ।\nस्नानमभ्यधिकं त्वत्र प्रत्यूषस्यात्मनो जले ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006421026, "chapter_id": 26421, "verse_number": "२-८१-२७", "content_sanskrit": "अन्यस्मिन् वा जले माघशुक्लपक्षे हरिप्रिये ।\nएतद् गङ्गाव्रतं नाम सर्वकामप्रदं स्मृतम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006421027, "chapter_id": 26421, "verse_number": "२-८१-२८", "content_sanskrit": "सप्त सप्त च सप्ताथ कुलानि हरिवल्लभे ।\nस्त्री तारयति धर्मज्ञा गङ्गाव्रतकचारिणी ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006421028, "chapter_id": 26421, "verse_number": "२-८१-२९", "content_sanskrit": "देयं कुम्भसहस्रं तु गङ्गाया व्रतके शुभे ।\nतारणं पारणं चैव तद् व्रतं सार्वकामिकम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006421029, "chapter_id": 26421, "verse_number": "२-८१-३०", "content_sanskrit": "यमभार्या चकाराथ व्रतं यामरथं शुभम् ।\nहेमन्ते तत् तु कर्तव्यमाकाशे हरिवल्लभे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006421030, "chapter_id": 26421, "verse_number": "२-८१-३१", "content_sanskrit": "इमानि चैव वाक्यानि ब्रूयादाकाशमास्थिता ।\nस्नात्वा शुचिसमाचारा नमस्कृत्य पतिं शुभे ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006421031, "chapter_id": 26421, "verse_number": "२-८१-३२", "content_sanskrit": "चराम्यहं यामरथं हिमं पृष्ठेन धारये ।\nपतिव्रता जीवपुत्रा भवेयं च पुरोऽधिका ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006421032, "chapter_id": 26421, "verse_number": "२-८१-३३", "content_sanskrit": "सपत्नीरधितिष्ठेयं पश्येयं चैव मा यमम् ।\nसभर्तृपुत्रा जीवेयं चिरं च सुखमेव च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006421033, "chapter_id": 26421, "verse_number": "२-८१-३४", "content_sanskrit": "पतिलोकं च गच्छेयं भवेयं नन्दिनी तथा ।\nसुचैला मृष्टहस्ता च स्वजनेष्टा गुणान्विता ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006421034, "chapter_id": 26421, "verse_number": "२-८१-३५", "content_sanskrit": "एवं कृत्वा ततो विप्रं मधुना स्वस्ति वाचयेत् ।\nतिलैरपि तथा कृष्णैः पायसेन तु भोजयेत् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006421035, "chapter_id": 26421, "verse_number": "२-८१-३६", "content_sanskrit": "एवं व्रतानि देवीभिः कृतान्यमरवर्णिनि ।\nमहादेव्या पुरोक्तानि रुद्रपत्न्या हरिप्रिये ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006421036, "chapter_id": 26421, "verse_number": "२-८१-३७", "content_sanskrit": "अहं ब्रवीमि तपसा मदीयेन समन्विताः ।\nसर्वा द्रक्ष्यथ गुण्यानि व्रतकानि तथैव च ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006421037, "chapter_id": 26421, "verse_number": "२-८१-३८", "content_sanskrit": "पौराणान्युमया देव्या यानि दृष्टानि वै पुरा ।\nकल्याणगुणयुक्तानि पावनानि शुभानि च ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006421038, "chapter_id": 26421, "verse_number": "२-८१-३९", "content_sanskrit": "वैशम्पायन उवाच\nरुक्मिणी व्रतकं चक्रे दृष्ट्वा व्रतकविस्तरम् ।\nउमाया वरदानेन दृष्ट्वा दिव्येन चक्षुषा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006421039, "chapter_id": 26421, "verse_number": "२-८१-४०", "content_sanskrit": "उमाव्रतकवत् सर्वं वृषदानं तथाधिकम् ।\nरत्नमालाप्रदानं च तथान्नं सार्वकामिकम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006421040, "chapter_id": 26421, "verse_number": "२-८१-४१", "content_sanskrit": "तथा जाम्बवती चक्रे पुरोमाव्रतकं तथा ।\nददावभ्यधिकं सा तु रत्नवृक्षं मनोहरम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006421041, "chapter_id": 26421, "verse_number": "२-८१-४२", "content_sanskrit": "सत्या ददौ तथैवाथ पुरोमाव्रतकं तथा ।\nपीतमभ्यधिकं वासस्तया दत्तमुमाव्रते ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006421042, "chapter_id": 26421, "verse_number": "२-८१-४३", "content_sanskrit": "रोहिण्याथ च फाल्गुन्या मघया च पुरातने ।\nव्रतानि खलु दत्तानि बहूनि कुलवर्धन ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006421043, "chapter_id": 26421, "verse_number": "२-८१-४४", "content_sanskrit": "ददौ शतभिषा चैव व्रतकं पुण्यलक्षणम् ।\nयेन नक्षत्रमुख्यत्वं जगाम कुरुनन्दन ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]