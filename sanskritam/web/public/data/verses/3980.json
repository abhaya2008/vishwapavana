[{"id": 2137435, "chapter_id": 3980, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2137436, "chapter_id": 3980, "verse_number": "१", "content_sanskrit": "गते तस्मिन् द्विजश्रेष्ठे कस्मिंश्चित् कारणान्तरे ।\nचिन्तयामास सा कन्या मन्त्रग्रामबलाबलम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2137437, "chapter_id": 3980, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2137438, "chapter_id": 3980, "verse_number": "२", "content_sanskrit": "अयं वै कीदृशस्तेन मम दत्तो महात्मना ।\nमन्त्रग्रामो बलं तस्य ज्ञास्ये नातिचिरादिति \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2137439, "chapter_id": 3980, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2137440, "chapter_id": 3980, "verse_number": "३", "content_sanskrit": "एवं सञ्चिन्तयन्ती सा ददर्शर्तुं यदृच्छया ।\nव्रीडिता साभवद् बाला कन्याभावे रजस्वला \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2137441, "chapter_id": 3980, "verse_number": "४", "content_sanskrit": "ततो हर्म्यतळस्था सा महार्हशयनोचिता ।\nअथोद्यन्तं सहस्त्रांशुं पृथादीप्तं ददर्श ह ।\nन ततर्प च रूपेण भानोः सन्ध्यागतस्य सा \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2137442, "chapter_id": 3980, "verse_number": "", "content_sanskrit": "तस्या दृष्टिरभूद् दिव्या सापश्यद् दिव्यदर्शनम् ।\nतत्र बद्धमनोदृष्टिरभवत् सा सुमध्यमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2137443, "chapter_id": 3980, "verse_number": "५", "content_sanskrit": "तस्या दृष्टिरभूद् दिव्या सापश्यद् दिव्यदर्शनम् ।\nआमुक्तकवचं देवं कुण्डलाभ्यां विभूषितम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2137444, "chapter_id": 3980, "verse_number": "६", "content_sanskrit": "तस्याः कौतूहलं त्वासीन्मन्त्रं प्रति नराधिप ।\nआह्वानमकरोत् साऽथ तस्य देवस्य भाविनी \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2137445, "chapter_id": 3980, "verse_number": "७", "content_sanskrit": "प्राणानुपस्पृश्य तदा ह्याजुहाव दिवाकरम् ।\nआजगाम ततो राजंस्त्वरमाणो दिवाकरः \t ॥ ७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2137446, "chapter_id": 3980, "verse_number": "८", "content_sanskrit": "मधुपिङ्गो महाबाहुः कम्बुग्रीवो हसन्निव ।\nअङ्गदी बद्धमुकुटो दिशः प्रज्वालयन्निव \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2137447, "chapter_id": 3980, "verse_number": "९", "content_sanskrit": "योगात् कृत्वा द्विधाऽऽत्मानमाजगाम तताप च ।\nआबभाषे ततः कुन्तीं साम्ना परमवल्गुना \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2137448, "chapter_id": 3980, "verse_number": "", "content_sanskrit": "सूर्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2137449, "chapter_id": 3980, "verse_number": "१०", "content_sanskrit": "आगतोऽस्मि वशं भद्रे तव मन्त्रबलात् कृतः ।\nकिं करोमि वशो राज्ञि ब्रूहि कर्ता तदस्मि ते \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2137450, "chapter_id": 3980, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2137451, "chapter_id": 3980, "verse_number": "११", "content_sanskrit": "गम्यतां भगवंस्तत्र यत एवागतो ह्यसि ।\nकौतूहलात् समाहूतः प्रसीद भगवन्निति \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2137452, "chapter_id": 3980, "verse_number": "", "content_sanskrit": "सूर्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2137453, "chapter_id": 3980, "verse_number": "१२", "content_sanskrit": "गमिष्येऽहं यथा मां त्वं ब्रवीषि तनुमध्यमे ।\nन तु देवं समाहूय न्याय्यं प्रेषयितुं वृथा \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2137454, "chapter_id": 3980, "verse_number": "१३", "content_sanskrit": "तवाभिसन्धिः सुभगे सूर्यात् पुत्रो भवेदिति ।\nवीर्येणाप्रतिमो लोके कवची कुण्डलीति च \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2137455, "chapter_id": 3980, "verse_number": "१४", "content_sanskrit": "सा त्वमात्मप्रदानं वै कुरुष्व गजगामिनि ।\nउत्पत्स्यति हि पुत्रस्ते यथासङ्कल्पमङ्गने \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2137456, "chapter_id": 3980, "verse_number": "१५", "content_sanskrit": "अथ गच्छाम्यहं भद्रे त्वया सङ्गम्य सुस्मिते ।\nशपिष्ये त्वामहं क्रुद्धो ब्राह्मणं पितरं च ते \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2137457, "chapter_id": 3980, "verse_number": "१६", "content_sanskrit": "यदि त्वं वचनं नाद्य करिष्यसि मम प्रियम् ।\nत्वत्कृते तान् प्रधक्ष्यामि सर्वानपि न संशयः ।\nपितरं चैव ते मूढं यो न वेत्ति तवानयम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2137458, "chapter_id": 3980, "verse_number": "१७", "content_sanskrit": "तस्य च ब्राह्मणस्याद्य योऽसौ मन्त्रमदात् तव ।\nशीलवृत्तमविज्ञाय धास्यामि विनयं परम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2137459, "chapter_id": 3980, "verse_number": "१८", "content_sanskrit": "एते हि विबुधाः सर्वे पुरन्दरमुखा दिवि ।\nत्वया प्रलब्धं पश्यन्ति स्मयन्त इव भाविनि \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2137460, "chapter_id": 3980, "verse_number": "१९", "content_sanskrit": "पश्य चैनान् सुरगणान् दिव्यं चक्षुरिदं हि ते ।\nपूर्वमेव मया दत्तं दृष्टवत्यसि येन माम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2137461, "chapter_id": 3980, "verse_number": "", "content_sanskrit": "वैशम्पयानः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2137462, "chapter_id": 3980, "verse_number": "२०", "content_sanskrit": "ततोऽपश्यत् त्रिदशान् राजपुत्री\nसर्वानेव स्वेषु धिष्ण्येषु स्वस्थान् ।\nप्रभावन्तं भानुमन्तं महान्तं\nयथाऽऽदित्यं रोचमानांस्तथैव ।\nसा तान् दृष्ट्वा व्रीडमानेव बाला\nसूर्यं देवी वचनं प्राह भीता\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2137463, "chapter_id": 3980, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2137464, "chapter_id": 3980, "verse_number": "२१", "content_sanskrit": "गच्छ त्वं वै गोपते स्वं विमानं\nकन्याभावाद् दुःख एवापचारः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2137465, "chapter_id": 3980, "verse_number": "२२", "content_sanskrit": "पिता माता गुरवश्चैव येऽन्ये\nदेहस्यास्य प्रभवन्ति प्रदाने ।\nनाहं धर्मं लोपयिष्यामि लोके\nस्त्रीणां वृत्तं पूज्यते देहरक्षा \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2137466, "chapter_id": 3980, "verse_number": "२३", "content_sanskrit": "मया मन्त्रबलं ज्ञातुमाहूतस्त्वं विभावसो ।\nबाल्याद् बालेति तत्कृत्वा क्षन्तुमर्हसि मे विभो \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2137467, "chapter_id": 3980, "verse_number": "", "content_sanskrit": "सूर्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2137468, "chapter_id": 3980, "verse_number": "२४", "content_sanskrit": "बालेति कृत्वानुनयं तवाहं\nददानि नान्यानुनयं लभेत ।\nआत्मप्रदानं कुरु कुन्ति कन्ये\nशान्तिस्तवैवं हि भवेच्च भीरु \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2137469, "chapter_id": 3980, "verse_number": "२५", "content_sanskrit": "न चापि गन्तुं युक्तं हि मया मिथ्याकृतेन वै ।\nगमिष्याम्यनवद्याङ्गि लोके समवहास्यताम् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2137470, "chapter_id": 3980, "verse_number": "२६", "content_sanskrit": "असमेत्य त्वया भीरु मन्त्राहूतेन भाविनि ।\nगच्छेयमेवं सुश्रोणि गतोऽहं वै निराकृतः ।\nसर्वेषां विबुधानां च वक्तव्यः स्यां तथा शुभे \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2137471, "chapter_id": 3980, "verse_number": "२७", "content_sanskrit": "सा त्वं मया समागच्छ पुत्रं लप्स्यसि मादृशम् ।\nविशिष्टा सर्वलोकेषु भविष्यसि न संशयः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2137472, "chapter_id": 3980, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि पञ्चवत्यधिकद्विशततमोऽध्यायः ॥२९५॥\nकुण्डलाहरणपर्वणि सूर्याह्वाने सप्तमोऽध्यायः ॥७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]