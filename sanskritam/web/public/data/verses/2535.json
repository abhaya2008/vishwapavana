[{"id": 2072735, "chapter_id": 2535, "verse_number": "१२-४०-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2072736, "chapter_id": 2535, "verse_number": "१२-४०-१", "content_sanskrit": "प्रकृतीनां च तद्वाक्यं देशकालोपबृंहितम्।\nश्रुत्वा युधिष्ठिरो राजाऽथोत्तरं प्रत्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2072737, "chapter_id": 2535, "verse_number": "१२-४०-२", "content_sanskrit": "धन्याः पाण्डुसुता नूनं येषां ब्राह्मणपुङ्गवाः।\nतथ्यान्वाप्यथवाऽतथ्यान्गुणानाहुः समागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2072738, "chapter_id": 2535, "verse_number": "१२-४०-३", "content_sanskrit": "अनुग्राह्या वयं नूनं भवतामिति मे मतिः।\nयदेवं गुणसंपन्नानस्मान्ब्रूथ विमत्सराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2072739, "chapter_id": 2535, "verse_number": "१२-४०-४", "content_sanskrit": "धृतराष्ट्रो महाराजः पिता नो दैवतं परम्।\nशासनेऽस्य प्रिये चैव स्थेयं मत्प्रियकाङ्क्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2072740, "chapter_id": 2535, "verse_number": "१२-४०-५", "content_sanskrit": "एतदर्थं हि जीवामि कृत्वा ज्ञातिवधं महत्।\nअस्य शुश्रूषणं कार्यं मया नित्यमतन्द्रिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2072741, "chapter_id": 2535, "verse_number": "१२-४०-६", "content_sanskrit": "यदि चाहमनुग्राह्यो भवतां सुहृदां तथा।\nधृतरा यथापूर्वं वृत्तिं वर्तितुमर्हथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2072742, "chapter_id": 2535, "verse_number": "१२-४०-७", "content_sanskrit": "एष नाथो हि जगतो भवतां च मया सह।\nअस्य प्रसादे पृथिवी पाण्डवाः सर्व एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2072743, "chapter_id": 2535, "verse_number": "१२-४०-८", "content_sanskrit": "एतन्मनसि कर्तव्यं भवद्भिर्वचनं मम।\nअनुज्ञाप्याथ तान्राजा यथेष्टं गम्यतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2072744, "chapter_id": 2535, "verse_number": "१२-४०-९", "content_sanskrit": "पौरजानपदान्सर्वान्विसृज्य कुरुनन्दनः।\nयौवराज्येन कौन्तेयं भीमसेनमयोजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2072745, "chapter_id": 2535, "verse_number": "१२-४०-१०", "content_sanskrit": "मन्त्रे च निश्चये चैव षाङ्गुण्यस्य च चिन्तने।\nविदुरं बुद्धिसंपन्नं प्रीतिमान्स समादिशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2072746, "chapter_id": 2535, "verse_number": "१२-४०-११", "content_sanskrit": "कृताकृतपरिज्ञाने तथाऽऽयव्ययचिन्तने।\nसंजयं योजयामास वृद्धं सर्वगुणैर्युतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2072747, "chapter_id": 2535, "verse_number": "१२-४०-१२", "content_sanskrit": "बलस्य परिमाणे च भक्तवेतनयोस्तथा।\nनकुलं व्यादिशद्राजा कर्मणां चान्ववेक्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2072748, "chapter_id": 2535, "verse_number": "१२-४०-१३", "content_sanskrit": "परचक्रोपरोधे च दृप्तानां चावमर्दने।\nयुधिष्ठिरो महाराज फल्गुनं व्यादिदेश ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2072749, "chapter_id": 2535, "verse_number": "१२-४०-१४", "content_sanskrit": "द्विजानां देवकार्येषु कार्येष्वन्येषु चैव ह।\nधौम्यं पुरोधसां श्रेष्ठं नित्यमेव समादिशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2072750, "chapter_id": 2535, "verse_number": "१२-४०-१५", "content_sanskrit": "सहदेवं समीपस्थं नित्यमेव समादिशत्।\nतने गोप्यो हि नृपतिः सर्वावस्थो विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2072751, "chapter_id": 2535, "verse_number": "१२-४०-१६", "content_sanskrit": "यान्यानमन्यद्योग्यांश्च येषु येष्विह कर्मसु।\nतांस्तांस्तेष्वेव युयुजे प्रीयमाणो महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2072752, "chapter_id": 2535, "verse_number": "१२-४०-१७", "content_sanskrit": "विदुरं संजयं चैव युयुत्सुं च महामतिम्।\nअब्रवीत्परवीरघ्नो धर्मात्मा धर्मवत्सलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2072753, "chapter_id": 2535, "verse_number": "१२-४०-१८", "content_sanskrit": "उत्थायोत्थाय तत्कार्यमस्य राज्ञः पितुर्मम।\nसर्वं भवद्भिः कर्तव्यमप्रमत्तैर्यथा मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2072754, "chapter_id": 2535, "verse_number": "१२-४०-१९", "content_sanskrit": "पौरजानपदानां च यानि कार्याणि नित्यशः।\nराजानं समनुज्ञाप्य तानि कार्याणि धर्मतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2072755, "chapter_id": 2535, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि चत्वारिंशोऽध्यायः॥ ४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]