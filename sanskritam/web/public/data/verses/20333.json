[{"id": 7000333000, "chapter_id": 20333, "verse_number": "२-५-१", "content_sanskrit": "शिवशर्मोवाच ।\nतपसा दमशौचाभ्यांगुरुशुश्रूषया तथा ।\nभक्त्याभावेन तुष्टोस्मि तवाद्य चसुपुत्रक॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000333001, "chapter_id": 20333, "verse_number": "२-५-२", "content_sanskrit": "त्यजामि वैकृतं रूपं मत्तः सुखमवाप्नुहि ।\nएवमुक्वा सुतं विप्रो दर्शयामास तां तनुम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000333002, "chapter_id": 20333, "verse_number": "२-५-३", "content_sanskrit": "यथापूर्वं स्थितौ तौ तु तथा स दृष्टवान्गुरू ।\nदीप्तिमंतौ महात्मानौ सूर्यबिंबोपमावुभौ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000333003, "chapter_id": 20333, "verse_number": "२-५-४", "content_sanskrit": "ननाम पादौ सद्भक्त्या उभयोस्तु महात्मनोः ।\nततः सुतं समामंत्र्य हर्षेण महतान्वितः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000333004, "chapter_id": 20333, "verse_number": "२-५-५", "content_sanskrit": "विष्णोः प्रसादाद्धर्मात्मा भार्यया सह केशवम् ।\nजगाम निजपुण्यैश्च योगाभ्यासेन सत्तमः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000333005, "chapter_id": 20333, "verse_number": "२-५-६", "content_sanskrit": "प्रविष्टो वैष्णवं धाम स मुनिर्दुर्लभं पदम् ।\nनत्वन्यैः प्राप्यते पुण्यैस्तपोभिर्मुक्तिदं पदम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000333006, "chapter_id": 20333, "verse_number": "२-५-७", "content_sanskrit": "विष्णोस्तु चिंतनैर्न्यासध्यानज्ञानैः स्तवैस्तथा ।\nन दानैस्तीर्थयात्राभिर्दृश्यते मधुसूदनः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000333007, "chapter_id": 20333, "verse_number": "२-५-८", "content_sanskrit": "समाधिज्ञानयोगेन दृश्यते परमं पदम् ।\nमहायोगैर्यथा विप्रः प्रविष्टो वैष्णवीं तनुम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000333008, "chapter_id": 20333, "verse_number": "२-५-९", "content_sanskrit": "सूत उवाच ।\nततस्तत्र तपस्तेपे सोमशर्मा महाद्युतिः ।\nअश्मलोष्टसमं मेने कांचनंभूषणं पुनः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000333009, "chapter_id": 20333, "verse_number": "२-५-१०", "content_sanskrit": "जिताहारः स धर्मात्मा निद्रया परिवर्जितः ।\nस सर्वान्विषयांस्त्यक्त्वा एकांतमपि सेवते॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000333010, "chapter_id": 20333, "verse_number": "२-५-११", "content_sanskrit": "योगासनसमारूढो निराशो निःपरिग्रहः ।\nतस्य वेला सुसंप्राप्ता मृत्युकालस्य वै तदा॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000333011, "chapter_id": 20333, "verse_number": "२-५-१२", "content_sanskrit": "आगता दानवा विप्रं सोमशर्माणमंतिके ।\nमृत्युकाले तु संप्राप्ते प्राणयात्रा प्रवर्तिनः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000333012, "chapter_id": 20333, "verse_number": "२-५-१३", "content_sanskrit": "शालिग्रामे महाक्षेत्रे ऋषीणां मानवर्द्धने ।\nकेचिद्वदंति वै दैत्याः केचिद्वदंति दानवाः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000333013, "chapter_id": 20333, "verse_number": "२-५-१४", "content_sanskrit": "एवंविधो महाशब्दः कर्णरंध्रं गतस्तदा ।\nतस्यैव विप्रवर्यस्य सुचिरात्सोमशर्मणः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000333014, "chapter_id": 20333, "verse_number": "२-५-१५", "content_sanskrit": "ज्ञानध्यानविलग्नस्य प्रविष्टं दैत्यजं भयम् ।\nतेन ध्यानेन तस्यापि दैत्यभीत्यैव वै तदा॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000333015, "chapter_id": 20333, "verse_number": "२-५-१६", "content_sanskrit": "सत्वरं चैव तत्प्राणा गतास्तस्य महात्मनः ।\nदैत्यभयेन संयुक्तः स हि मृत्युवशं गतः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000333016, "chapter_id": 20333, "verse_number": "२-५-१७", "content_sanskrit": "तस्माद्दैत्यगृहे जातो हिरण्यकशिपोः सुतः ।\nदेवासुरे महायुद्धे निहतश्चक्रपाणिना॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000333017, "chapter_id": 20333, "verse_number": "२-५-१८", "content_sanskrit": "युद्ध्यमानेन तेनापि प्रह्लादेन महात्मना ।\nसुदृष्टं वासुदेवत्वं विश्वरूपसमन्वितम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000333018, "chapter_id": 20333, "verse_number": "२-५-१९", "content_sanskrit": "योगाभ्यासेन पूर्वेण ज्ञानमासीन्महात्मनः ।\nसस्मार पूर्वकं सर्वं चरितं शिवशर्मणः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000333019, "chapter_id": 20333, "verse_number": "२-५-२०", "content_sanskrit": "प्रागहं सोमशर्माख्यः प्रविष्टो दानवीं तनुम् ।\nअस्मात्कायात्कदा पुण्यं केवलं धाम उत्तमम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000333020, "chapter_id": 20333, "verse_number": "२-५-२१", "content_sanskrit": "प्रयास्यामि महापुण्यैर्ज्ञानाख्यैर्मोक्षदायकम् ।\nसमरे म्रियमाणेन प्रह्लादेन महात्मना॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000333021, "chapter_id": 20333, "verse_number": "२-५-२२", "content_sanskrit": "एवं चिंता कृता पूर्वं श्रूयतां द्विजसत्तमाः ।\nएवं तु च समाख्यातं सर्वसंदेहनाशनम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000333022, "chapter_id": 20333, "verse_number": "२-५-२३", "content_sanskrit": "सूत उवाच ।\nप्रह्लादे निहते संख्ये देवदेवेन चक्रिणा ।\nरुरुदे कमला सा तु हतपुत्रा च कामिनी॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000333023, "chapter_id": 20333, "verse_number": "२-५-२४", "content_sanskrit": "प्रह्लादस्य तु या माता हिरण्यकशिपोः प्रिया ।\nप्रह्लादस्य महाशोकैर्दिवारात्रौ प्रशोचति॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000333024, "chapter_id": 20333, "verse_number": "२-५-२५", "content_sanskrit": "पतिव्रता महाभागा कमला नाम तत्प्रिया ।\nरोदमानां दिवारात्रौ नारदस्तामुवाच ह॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000333025, "chapter_id": 20333, "verse_number": "२-५-२६", "content_sanskrit": "मा शुचस्त्वं महाभागे पुत्रार्थं पुण्यभागिनि ।\nनिहतो वासुदेवेन तव पुत्रः समेष्यति॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000333026, "chapter_id": 20333, "verse_number": "२-५-२७", "content_sanskrit": "भूयः स्वलक्षणोपेतस्त्वत्सुतश्च महामतिः ।\nप्रह्लादेति च वै नाम पुनरस्य भविष्यति॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000333027, "chapter_id": 20333, "verse_number": "२-५-२८", "content_sanskrit": "विहीनश्चासुरैर्भावैर्देवत्वेन समन्वितः ।\nइंद्रत्वे मोदते भद्रे सर्वदेवैर्नमस्कृतः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000333028, "chapter_id": 20333, "verse_number": "२-५-२९", "content_sanskrit": "सुखीभवमहाभागेतेनपुत्रेणवैसदा ।\nन प्रकाश्या त्वया देवि सुवार्तेयं च कस्यचित्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000333029, "chapter_id": 20333, "verse_number": "२-५-३०", "content_sanskrit": "कर्त्तव्यमज्ञानभावैः सुगोप्यं कुरु त्वं सदा ।\nएवमुक्त्वा गतो विप्रो नारदो मुनिसत्तमः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000333030, "chapter_id": 20333, "verse_number": "२-५-३१", "content_sanskrit": "कमलायाश्चोदरे तु जन्मा स्यानुत्तमं पुनः ।\nप्रह्लादेति च वै नाम तस्याख्यानं महात्मनः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000333031, "chapter_id": 20333, "verse_number": "२-५-३२", "content_sanskrit": "बाल्यं भावं गतो विप्राः कृष्णमेव व्यचिंतयत् ।\nनरसिंहप्रसादेन देवराजो भवेद्दिवि॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000333032, "chapter_id": 20333, "verse_number": "२-५-३३", "content_sanskrit": "देवत्वं लभ्य चैवासावैंद्रं पदमनुत्तमम् ।\nमोक्षं यास्यति ज्ञानात्मा वैष्णवं धाम चोत्तमम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000333033, "chapter_id": 20333, "verse_number": "२-५-३४", "content_sanskrit": "असंख्याता महाभागाः सृष्टेर्भावा ह्यनेकशः ।\nमोह एवं न कर्त्तव्यो ज्ञानवद्भिर्महात्मभिः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000333034, "chapter_id": 20333, "verse_number": "२-५-३५", "content_sanskrit": "एतद्वः सर्वमाख्यातं यथापृष्टं द्विजोत्तमाः ।\nअन्यं पृच्छ महाभाग संदेहं ते भिनद्म्यहम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000333035, "chapter_id": 20333, "verse_number": "२-५-३६", "content_sanskrit": "विजयं देवतानां तु दानवानां महत्क्षयम् ।\nकृतं हि देवदेवेन स्थापितं भुवनत्रयम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000333036, "chapter_id": 20333, "verse_number": "२-५-३७", "content_sanskrit": "ऋषय ऊचुः ।\nइन्द्रत्वं कस्य संजातं देवानां शब्दधारकम् ।\nकेन दत्तं त्वमाचक्ष्व विस्तराद्द्विजसत्तम॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000333037, "chapter_id": 20333, "verse_number": "२-५-३८", "content_sanskrit": "सूत उवाच ।\nविस्तरेण प्रवक्ष्यामि इन्द्रत्वे येन सत्तमः ।\nप्राप्त एष महाभागो यथा पुण्यतमेन च॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000333038, "chapter_id": 20333, "verse_number": "२-५-३९", "content_sanskrit": "हतेषु तेषु दैत्येषु समस्तेषुमहाहवे ।\nअतिनष्टेषु पापेषु गोविंदेन महात्मना॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000333039, "chapter_id": 20333, "verse_number": "२-५-४०", "content_sanskrit": "ततो देवाः सगंधर्वा नागा विद्याधरास्तथा ।\nसंप्रोचुर्माधवं सर्वे बद्धप्रांजलयस्ततः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000333040, "chapter_id": 20333, "verse_number": "२-५-४१", "content_sanskrit": "भगवन्देवदेवेश हृषीकेश नमोस्तु ते ।\nविज्ञापयामहे त्वां वै तत्सर्वमवधार्यताम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000333041, "chapter_id": 20333, "verse_number": "२-५-४२", "content_sanskrit": "शास्ता गोप्ता च पुण्यात्मा अस्माकं कुरु केशव ।\nराजानं पुण्यधर्माणं त्वमिंद्रं लोकशासनम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000333042, "chapter_id": 20333, "verse_number": "२-५-४३", "content_sanskrit": "त्रैलोक्यस्य प्रजा देव यमाश्रित्य सुखं लभेत् ।\nवासुदेव उवाच ।\nमम लोके महाभागा वैष्णवेन समन्वितः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000333043, "chapter_id": 20333, "verse_number": "२-५-४४", "content_sanskrit": "तेजसा ब्राह्मणश्रेष्ठश्चिरकालं निवासितः ।\nतस्य कालः प्रपूर्णश्च मम लोके महात्मनः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000333044, "chapter_id": 20333, "verse_number": "२-५-४५", "content_sanskrit": "वसतस्तस्य विप्रस्य मद्भक्तस्य सुरोत्तमाः ।\nतेजसा वैष्णवेनैव भवतां पालको हि सः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000333045, "chapter_id": 20333, "verse_number": "२-५-४६", "content_sanskrit": "भविष्यति स धर्मात्मा स च धर्मानुरंजकः ।\nपालको धारकश्चैव स च ब्राह्मणसत्तमः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000333046, "chapter_id": 20333, "verse_number": "२-५-४७", "content_sanskrit": "भविष्यति स धर्मात्मा भवतां त्राणकारणात् ।\nअदित्यास्तनयश्चैव सुव्रताख्यो महामनाः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000333047, "chapter_id": 20333, "verse_number": "२-५-४८", "content_sanskrit": "महाबलो महावीर्यः स व इंद्रो भविष्यति ।\nसूत उवाच ।\nएवं वरान्स देवेशो दत्वा देवेभ्य उत्तमम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000333048, "chapter_id": 20333, "verse_number": "२-५-४९", "content_sanskrit": "देवा विजयिनः सर्वे विष्णुना सह सत्तमाः ।\nकश्यपं पितरं दृष्टुं मातरं च ततो गताः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000333049, "chapter_id": 20333, "verse_number": "२-५-५०", "content_sanskrit": "प्रणेमुस्ते महात्मान उभावेतौ सुखासनौ ।\nऊचुः प्रांजलयः सर्वे हर्षेण महतान्विताः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000333050, "chapter_id": 20333, "verse_number": "२-५-५१", "content_sanskrit": "युवयोश्च प्रसादेन देवत्वं हि गता वयम् ।\nहर्षेण महताविष्टो देवान्वाक्यमुवाच सः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000333051, "chapter_id": 20333, "verse_number": "२-५-५२", "content_sanskrit": "कश्यप उवाच ।\nयूयं वै सत्यधर्मेण वर्तमानाः सदैव हि ।\nआवयोश्च प्रसादेन तपसश्च प्रभावतः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000333052, "chapter_id": 20333, "verse_number": "२-५-५३", "content_sanskrit": "प्राप्तवंतो भवंतस्तु देवत्वं चाक्षयं पदम् ।\nवरमेव ददाम्येषां बहुप्रीतिसमन्विताः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000333053, "chapter_id": 20333, "verse_number": "२-५-५४", "content_sanskrit": "अमरा निर्जराश्चैव अक्षयाश्च भविष्यथ ।\nसर्वकामसमृद्धार्थाः सर्वसिद्धिसमन्विताः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000333054, "chapter_id": 20333, "verse_number": "२-५-५५", "content_sanskrit": "देवा नागाश्च गंधर्वा मत्प्रसादान्महासुराः ।\nविष्णुरुवाच ।\nवरं वरय भद्रं ते देवमातर्यशस्विनि॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000333055, "chapter_id": 20333, "verse_number": "२-५-५६", "content_sanskrit": "मनसा चेप्सितं सर्वं तत्ते दद्मि सुनिश्चितम् ।\nअदितिरुवाच ।\nपूर्वं पुत्रवती भूता प्रसादात्तव माधव॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000333056, "chapter_id": 20333, "verse_number": "२-५-५७", "content_sanskrit": "अमरा निर्जराः सर्वे अक्षयाः पुण्यवत्सलाः ।\nअमी पुत्रा मया लब्धाः श्रूयतां मधुसूदन॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000333057, "chapter_id": 20333, "verse_number": "२-५-५८", "content_sanskrit": "सुतरां त्वं च गोविंद सर्वकामसमृद्धिदः ।\nमम गर्भे वसंश्चैव भवांश्च मम नंदनः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000333058, "chapter_id": 20333, "verse_number": "२-५-५९", "content_sanskrit": "त्वया पुत्रेण नित्यं च यथा नंदामि केशव ।\nएवं महोदयं नाथ पूरयस्व मनोरथम्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000333059, "chapter_id": 20333, "verse_number": "२-५-६०", "content_sanskrit": "वासुदेव उवाच ।\nभवत्या देवकार्यार्थं गंतव्यं मानुषीं तनुम् ।\nतदाहं तव गर्भे वै वासं यास्यामि निश्चितम्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000333060, "chapter_id": 20333, "verse_number": "२-५-६१", "content_sanskrit": "युगे द्वादशके प्राप्ते भूभारहरणाय वै ।\nजमदग्निसुतो देवि रामो नाम द्विजोत्तमः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000333061, "chapter_id": 20333, "verse_number": "२-५-६२", "content_sanskrit": "प्रतापतेजसायुक्तः सर्वक्षत्रवधाय च ।\nतव पुत्रो भविष्यामि सर्वशस्त्रभृतां वरः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000333062, "chapter_id": 20333, "verse_number": "२-५-६३", "content_sanskrit": "सप्तविंशतिके प्राप्ते त्रेताख्ये तु तथा युगे ।\nरामो नाम भविष्यामि तव पुत्रः पतिव्रते॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000333063, "chapter_id": 20333, "verse_number": "२-५-६४", "content_sanskrit": "पुनः पुत्रो भविष्यामि तवैव शृणु पुण्यधेः ।\nअष्टाविंशतिके प्राप्ते द्वापरांते युगे तदा॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000333064, "chapter_id": 20333, "verse_number": "२-५-६५", "content_sanskrit": "सर्वदैत्यविनाशार्थे भूभारहरणाय च ।\nवासुदेवाख्यस्ते पुत्रो भविष्यामि न संशयः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000333065, "chapter_id": 20333, "verse_number": "२-५-६६", "content_sanskrit": "इदानीं कुरु कल्याणि मद्वाक्यं धर्मसंयुतम् ।\nसर्वलक्षणसंपन्नं सत्यधर्मसमन्वितम्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000333066, "chapter_id": 20333, "verse_number": "२-५-६७", "content_sanskrit": "सर्वज्ञं सर्वदे देवि पुत्रमुत्पाद्य सुंदरम् ।\nइंद्रत्वं तस्य दास्यामि इंद्रः सोपि भविष्यति॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000333067, "chapter_id": 20333, "verse_number": "२-५-६८", "content_sanskrit": "एवं संभाषितं श्रुत्वा महाहर्षसमन्विता ।\nदेवदेवप्रसादेन इंद्रः पुत्रो भविष्यति॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000333068, "chapter_id": 20333, "verse_number": "२-५-६९", "content_sanskrit": "एवमस्तु महाभाग तव वाक्यं करोम्यहम् ।\nततस्ता देवताः सर्वा जग्मुः स्वस्थानमेव हि॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000333069, "chapter_id": 20333, "verse_number": "२-५-७०", "content_sanskrit": "हरिणा सह ते सर्वे निरातंका मुदान्विताः ।\nसूत उवाच ।\nअदितिः कश्यपं प्राह ऋतुं प्राप्य मनस्विनी॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000333070, "chapter_id": 20333, "verse_number": "२-५-७१", "content_sanskrit": "भगवन्दीयतां पुत्रः सुरेंद्रपदभोजकः ।\nचिंतयित्वा क्षणं विप्रस्तामुवाच मनस्विनीम्॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000333071, "chapter_id": 20333, "verse_number": "२-५-७२", "content_sanskrit": "एवमस्तु महाभागे तव पुत्रो भविष्यति ।\nत्रैलोक्यस्यापि कर्ता स यज्ञभोक्ता स एव च॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000333072, "chapter_id": 20333, "verse_number": "२-५-७३", "content_sanskrit": "तस्याः शिरसि सन्यस्य स्वहस्तं च द्विजोत्तमः ।\nतपश्चचार तेजस्वी सत्यधर्मसमन्वितः॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000333073, "chapter_id": 20333, "verse_number": "२-५-७४", "content_sanskrit": "सुव्रतो नाम तेजस्वी विष्णुलोके वसेत्सदा ।\nतस्य पुण्यक्षये जाते विष्णुलोकाद्द्विजोत्तमाः॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000333074, "chapter_id": 20333, "verse_number": "२-५-७५", "content_sanskrit": "पतनं कर्मवशतस्ततस्तस्य द्विजोत्तमाः ।\nपुण्यगर्भं गतो विप्र अदित्यास्तु महातपाः॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000333075, "chapter_id": 20333, "verse_number": "२-५-७६", "content_sanskrit": "इंद्रत्वं भोक्तुकामार्थं सत्यपुण्येन कर्मणा ।\nगर्भं दधार सा देवी पुण्येन तपसा किल॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000333076, "chapter_id": 20333, "verse_number": "२-५-७७", "content_sanskrit": "तपस्तेपे निरालस्या वनवासं गता सती ।\nदिव्यं वर्षशतं यातं तपंत्यां देवमातरि॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000333077, "chapter_id": 20333, "verse_number": "२-५-७८", "content_sanskrit": "तपंत्यथ तपस्तीव्रं दुष्करं देवतासुरैः ।\nततः सा तपसा तेन तेजसा च प्रभान्विता॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000333078, "chapter_id": 20333, "verse_number": "२-५-७९", "content_sanskrit": "सूर्यतेजः प्रतीकाशा द्वितीय इव भास्करः ।\nशुशुभे सा यथा दीप्ता परमं ध्यानमास्थिता॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000333079, "chapter_id": 20333, "verse_number": "२-५-८०", "content_sanskrit": "रूपेणाधिकतां याता तपसस्तेजसा तदा ।\nतपोध्यानपरा सा च वायुभक्षा तपस्विनी॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000333080, "chapter_id": 20333, "verse_number": "२-५-८१", "content_sanskrit": "अधिकं शुशुभे देवी दक्षस्य तनया तदा ।\nसिद्धाश्च ऋषयः सर्वे देवाश्चापि महौजसः॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000333081, "chapter_id": 20333, "verse_number": "२-५-८२", "content_sanskrit": "स्तुवंति तां महाभागां रक्षंति च सुतत्पराः ।\nपूर्णे वर्षशते तस्या विष्णुस्तत्र समागतः॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000333082, "chapter_id": 20333, "verse_number": "२-५-८३", "content_sanskrit": "तामुवाच महाभागामदितिं तपसान्विताम् ।\nदेवि गर्भः सुसंपूर्णः सूतिकालः प्रवर्तते॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000333083, "chapter_id": 20333, "verse_number": "२-५-८४", "content_sanskrit": "तवैव तपसा पुष्टस्तेजसा च प्रवर्द्धितः ।\nअद्यैव गर्भमेतं त्वं मुंच मुंच यशस्विनि॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000333084, "chapter_id": 20333, "verse_number": "२-५-८५", "content_sanskrit": "एवमाभाष्य देवेशः स जगाम स्वकं गृहम् ।\nअसूत पुत्रं सा देवी काले प्राप्ते महोदये॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000333085, "chapter_id": 20333, "verse_number": "२-५-८६", "content_sanskrit": "सा पुत्रं दीप्तिसंयुक्तं द्वितीयमिव भास्करम् ।\nसुभगं चारुसर्वांगं सर्वलक्षणसंयुतम्॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000333086, "chapter_id": 20333, "verse_number": "२-५-८७", "content_sanskrit": "चतुर्बाहुं महाकायं लोकपालं सुरेश्वरम् ।\nतेजोज्वालासमाकीर्णं चक्रपद्मसुहस्तकम्॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000333087, "chapter_id": 20333, "verse_number": "२-५-८८", "content_sanskrit": "चंद्रबिंबानुकारेण वदनेन महामतिः ।\nराजमानं महाप्राज्ञं तेजसा वैष्णवेन च॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000333088, "chapter_id": 20333, "verse_number": "२-५-८९", "content_sanskrit": "अन्यैश्च लक्षणैर्दिव्यैर्दिव्यभावैरलंकृतम् ।\nसर्वलक्षणसंपूर्णं चंद्रास्यं कमलेक्षणम्॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000333089, "chapter_id": 20333, "verse_number": "२-५-९०", "content_sanskrit": "आजग्मुस्ते त्रयो देवा ऋषयो वेदपारगाः ।\nगंधर्वाश्च ततो नागाः सिद्धाविद्याधरास्तथा॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000333090, "chapter_id": 20333, "verse_number": "२-५-९१", "content_sanskrit": "ऋषयः सप्त ते दिव्याः पूर्वापरमहौजसः ।\nअन्ये च मुनयः पुण्याः पुण्यमंगलदायिनः॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000333091, "chapter_id": 20333, "verse_number": "२-५-९२", "content_sanskrit": "आजग्मुस्ते महात्मानो हर्षनिर्भरमानसाः ।\nतस्मिञ्जाते महाभागे भगवंतो महौजसि॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000333092, "chapter_id": 20333, "verse_number": "२-५-९३", "content_sanskrit": "आजग्मुर्देवताः सर्वे पर्वतास्तु तपस्विनः ।\nक्षीराद्याः सागराः सर्वे नद्यश्चैव तथामलाः॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000333093, "chapter_id": 20333, "verse_number": "२-५-९४", "content_sanskrit": "प्रीतिमंतस्ततः सर्वे ये चान्ये हि चराचराः ।\nमंगलैस्तु महोत्साहं चक्रुः सर्वे सुरेश्वराः॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000333094, "chapter_id": 20333, "verse_number": "२-५-९५", "content_sanskrit": "ननृतुश्चाप्सराः संघा गंधर्वा ललितं जगुः ।\nवेदमंत्रैस्ततो देवा ब्राह्मणा वेदपारगाः॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000333095, "chapter_id": 20333, "verse_number": "२-५-९६", "content_sanskrit": "स्तुवंति तं महात्मानं सुतं वै कश्यपस्य च ।\nब्रह्मा विष्णुश्च रुद्रश्च वेदाश्चैव समागताः॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000333096, "chapter_id": 20333, "verse_number": "२-५-९७", "content_sanskrit": "सांगोपांगैश्च संयुक्तास्तस्मिञ्जाते महौजसि ।\nत्रैलोक्ये यानि सत्वानि पुण्ययुक्तानि सत्तम॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000333097, "chapter_id": 20333, "verse_number": "२-५-९८", "content_sanskrit": "समागतानि तत्रैव तस्मिञ्जाते महौजसि ।\nमंगलं चक्रिरे सर्वे गीतपुण्यैर्महोत्सवैः॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000333098, "chapter_id": 20333, "verse_number": "२-५-९९", "content_sanskrit": "हर्षेण निर्भराः सर्वे पूजयंतो महौजसः ।\nब्रह्माद्याश्च त्रयो देवाः कश्यपोथ बृहस्पतिः॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000333099, "chapter_id": 20333, "verse_number": "२-५-१००", "content_sanskrit": "चक्रिरे नामकर्माणि तस्यैव हि महात्मनः ।\nवसुदत्तेति विख्यातो वसुदेति पुनस्तव॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000333100, "chapter_id": 20333, "verse_number": "२-५-१०१", "content_sanskrit": "आखंडलेति तन्नाम मरुत्वान्नाम ते पुनः ।\nमघवांश्च बिडौजास्त्वं पाकशासन इत्यपि॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000333101, "chapter_id": 20333, "verse_number": "२-५-१०२", "content_sanskrit": "शक्रश्चैव हि विख्यात इंद्रश्चैवेति ते सुतः ।\nइत्येतानि च नामानि तस्यैव च महात्मनः॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000333102, "chapter_id": 20333, "verse_number": "२-५-१०३", "content_sanskrit": "चक्रुश्च देवताः सर्वाः संतुष्टा हृष्टमानसाः ।\nस्नानं तु कारयामासुः संस्काराणि महासुरः॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000333103, "chapter_id": 20333, "verse_number": "२-५-१०४", "content_sanskrit": "विश्वकर्माणमाहूय ददुराभरणानि च ।\nतानि पुण्यानि दिव्यानि तस्मै ते तु महात्मने॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000333104, "chapter_id": 20333, "verse_number": "२-५-१०५", "content_sanskrit": "जाते तस्मिन्महाभागे देवराजे महात्मनि ।\nएवं मुदं ततः प्रापुः सर्वे देवा महौजसः॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000333105, "chapter_id": 20333, "verse_number": "२-५-१०६", "content_sanskrit": "पुण्ये तिथौ तथा ऋक्षे सुमुहूर्ते महात्मभिः ।\nइंद्रत्वे स्थापितो देवैरभिषिक्तः सुमंगलैः॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000333106, "chapter_id": 20333, "verse_number": "२-५-१०७", "content_sanskrit": "प्राप्तमैंद्रपदं तेन प्रसादात्तस्य चक्रिणः ।\nतपश्चकार तेजस्वी वसुदत्तः सुरेश्वरः॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000333107, "chapter_id": 20333, "verse_number": "२-५-१०८", "content_sanskrit": "उग्रेण तेजसा युक्तो वज्रपाशांकुशायुधः॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000333108, "chapter_id": 20333, "verse_number": "२-५-१०९", "content_sanskrit": "सूत उवाच ।\nउग्रं समस्तं तपसः प्रभावं विलोक्य शुक्रो निजगाद गाथाम् ।\nलोकेषु कोन्यो न भविष्यतीति यथा हि चायं च सुदर्शनीयः॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000333109, "chapter_id": 20333, "verse_number": "२-५-११०", "content_sanskrit": "विष्णोः प्रसादान्न परो महात्मा संप्राप्तमैश्वर्यमिहैव दिव्यम्॥ ११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000333110, "chapter_id": 20333, "verse_number": "२-५-१११", "content_sanskrit": "अनेन तुल्यो न भविष्यतीति लोकेषु चान्यस्तपसोग्रवीर्यः॥ १११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}]