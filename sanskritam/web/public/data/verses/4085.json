[{"id": 2143131, "chapter_id": 4085, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2143132, "chapter_id": 4085, "verse_number": "१", "content_sanskrit": "अथ सञ्चिन्तयानस्य देवराजस्य धीमतः ।\nनहुषस्य वधोपायं लोकपालैः सदैवतैः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2143133, "chapter_id": 4085, "verse_number": "२", "content_sanskrit": "तपस्वी तत्र भगवान् अगस्त्यः प्रत्यदृश्यत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2143134, "chapter_id": 4085, "verse_number": "३", "content_sanskrit": "सोऽब्रवीदर्च्य देवेन्द्रं दिष्ट्या वै वर्धते भवान् ।\nविश्वरूपविनाशेन वृत्रासुरवधेन च\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2143135, "chapter_id": 4085, "verse_number": "४", "content_sanskrit": "दिष्ट्या धर्मः स्थितो लोके दिष्ट्या लोकाः प्रतिष्ठिताः ।\nदिष्ट्या पश्यामि देवेन्द्रं दिष्ट्या लोकान् पुनर्नवान्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2143136, "chapter_id": 4085, "verse_number": "५", "content_sanskrit": "दिष्ट्याऽद्य नहुषो भ्रष्टो देवराज्यात् पुरन्दर ।\nदिष्ट्या भवन्तं पश्यामो हतारिं बलसूदन\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2143137, "chapter_id": 4085, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2143138, "chapter_id": 4085, "verse_number": "६", "content_sanskrit": "स्वागतं ते महर्षेऽस्तु प्रीतोऽहं दर्शनात् तव ।\nपाद्यमाचमनीयं च गामर्घ्यं च प्रतीच्छ मे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2143139, "chapter_id": 4085, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2143140, "chapter_id": 4085, "verse_number": "७", "content_sanskrit": "पूजितं चोपविष्टं तमासने मुनिसत्तमम् ।\nपर्यपृच्छत देवेशः प्रहृष्टो ब्राह्मणर्षभम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2143141, "chapter_id": 4085, "verse_number": "८", "content_sanskrit": "एतदिच्छामि भगवन् कथ्यमानं द्विजोत्तम ।\nपरिभ्रष्टः कथं स्वर्गान्नहुषः पापनिश्चयः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2143142, "chapter_id": 4085, "verse_number": "", "content_sanskrit": "अगस्त्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2143143, "chapter_id": 4085, "verse_number": "९", "content_sanskrit": "शृणु शक्र प्रियं वाक्यं यथा राजा दुरात्मवान् ।\nस्वर्गाद् भ्रष्टो दुराचारो नहुषो बलवत्तरः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2143144, "chapter_id": 4085, "verse_number": "१०", "content_sanskrit": "श्रमार्ताश्च वहन्तस्तं नहुषं पापकारिणम् ।\nदेवर्षयो महाभागास्तथा ब्रह्मर्षयोऽमलाः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2143145, "chapter_id": 4085, "verse_number": "११", "content_sanskrit": "पप्रच्छुर्नहुषं देव संशयं जयतां वरम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2143146, "chapter_id": 4085, "verse_number": "१२", "content_sanskrit": "य इमे ब्रह्मणा प्रोक्ता मन्त्रा वै प्रोक्षणे गवाम् ।\nएते प्रमाणं भवत उताहो नेति वासव\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2143147, "chapter_id": 4085, "verse_number": "१३", "content_sanskrit": "नहुषो नेति तानाह तमसा मूढचेतनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2143148, "chapter_id": 4085, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2143149, "chapter_id": 4085, "verse_number": "१४", "content_sanskrit": "अधर्मे सम्प्रवृत्तस्त्वं धर्मं न प्रतिपद्यसे ।\nप्रमाणमेतदस्माकं पूर्वं प्रोक्तं महर्षिभिः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2143150, "chapter_id": 4085, "verse_number": "", "content_sanskrit": "अगस्त्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2143151, "chapter_id": 4085, "verse_number": "१५", "content_sanskrit": "ततो विवदमानः स मुनिभिः सह वासव ।\nअथ मामस्पृशन् मूर्ध्नि पादेनाधर्मपीडितः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2143152, "chapter_id": 4085, "verse_number": "१६", "content_sanskrit": "तेनाभूद् हततेजाश्च निःश्रीकश्च शचीपते ।\nततस्तमहमाविग्नमवोचं भयपीडितम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2143153, "chapter_id": 4085, "verse_number": "१७", "content_sanskrit": "यस्मात् पूर्वैः कृतं मार्गं ब्रह्मर्षिभिरनुष्ठितम् ।\nअदुष्टं दूषयसि वै यन्मे मूर्ध्न्यस्पृशः पदा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2143154, "chapter_id": 4085, "verse_number": "१८", "content_sanskrit": "यच्चापि त्वमृषीन् मूढ ब्रह्मकल्पान् दुरासदान् ।\nवाहान् कृत्वा वाहयसि तेन स्वर्गाद् हतप्रभः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2143155, "chapter_id": 4085, "verse_number": "१९", "content_sanskrit": "ध्वंस पाप परिभ्रष्टः क्षीणपुण्यो महीतळे\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2143156, "chapter_id": 4085, "verse_number": "२०", "content_sanskrit": "दशवर्षसहस्राणि सर्परूपधरो महान् ।\nविचरिष्यसि पूर्णेषु पुनः स्वर्गमवाप्स्यसि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2143157, "chapter_id": 4085, "verse_number": "२१", "content_sanskrit": "दृष्ट्वा युधिष्ठिरं नाम तव वंशसमुद्भवम् ।\nनिहतो ब्रह्मशापेन प्रपद्यस्व त्रिविष्टपम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2143158, "chapter_id": 4085, "verse_number": "२२", "content_sanskrit": "एवं भ्रष्टो दुरात्मा स देवराज्यादरिन्दम ।\nदिष्ट्या वर्धामहे शक्र हतो ब्रह्मर्षिकण्टकः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2143159, "chapter_id": 4085, "verse_number": "२३", "content_sanskrit": "त्रिविष्टपं प्रपद्यस्व पाहि लोकान् शचीपते ।\nजितेन्द्रियो जितामित्रः स्तूयमानो महर्षिभिः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2143160, "chapter_id": 4085, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2143161, "chapter_id": 4085, "verse_number": "२४", "content_sanskrit": "ततो देवा भृशं तुष्टा महर्षिगणसंवृताः ।\nपितरश्चैव यक्षाश्च भुजगा राक्षसास्तथा\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2143162, "chapter_id": 4085, "verse_number": "२५", "content_sanskrit": "गन्धर्वा देवकन्याश्च सर्वे चाप्सरसां गणाः ।\nसरांसि सरितः शैलाः सागराश्च विशाम्पते\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2143163, "chapter_id": 4085, "verse_number": "२६", "content_sanskrit": "उपगम्याब्रुवन् सर्वे दिष्ट्या वर्धसि शत्रुहन् ।\nहतश्च नहुषः पापो दिष्ट्याऽगस्त्येन धीमता\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2143164, "chapter_id": 4085, "verse_number": "२७", "content_sanskrit": "दिष्ट्या पापसमाचारः कृतः सर्पो महीतळे\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2143165, "chapter_id": 4085, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि सप्तदशोऽध्यायः ॥१७॥ सेनोद्योगपर्वणि सप्तदशोऽध्यायः ॥१७॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]