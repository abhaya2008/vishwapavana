[{"id": 7002973000, "chapter_id": 22973, "verse_number": "२-२०-१", "content_sanskrit": "नारायण उवाच ।\nशिवस्तत्त्वं समाकर्ण्य तत्त्वज्ञानविशारदः ।\nययौ स्वयं च समरं स्वगणैः सह नारद ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002973001, "chapter_id": 22973, "verse_number": "२-२०-२", "content_sanskrit": "शंखचूडः शिवं दृष्ट्वा विमानादवरुह्य च ।\nननाम परया भक्त्या दण्डवत्पतितो भुवि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002973002, "chapter_id": 22973, "verse_number": "२-२०-३", "content_sanskrit": "तं प्रणम्य च वेगेन विमानं ह्यारुरोह सः ।\nतूर्णं चकार सन्नाहं धनुर्जग्राह दुर्वहम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002973003, "chapter_id": 22973, "verse_number": "२-२०-४", "content_sanskrit": "शिवदानवयोर्युद्धं पूर्णमब्दं बभूव ह ।\nन वै बभूवतुर्ब्रह्मंस्तयोर्जयपराजयौ ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002973004, "chapter_id": 22973, "verse_number": "२-२०-५", "content_sanskrit": "न्यस्तशस्त्रश्च भगवान्न्यस्तशस्त्रश्च दानवः ।\nरथस्थः शंखचूडश्च वृषस्थो वृषभध्वजः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002973005, "chapter_id": 22973, "verse_number": "२-२०-६", "content_sanskrit": "दानवानां च शतकमुद्वृत्तं च बभूव ह ।\nरणे ये मृताः शंभोर्जीवयामास तान्विभुः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002973006, "chapter_id": 22973, "verse_number": "२-२०-७", "content_sanskrit": "ततो विष्णुर्महामायो वृद्धब्राह्मणरूपधृक् ।\nआगत्य च रणस्थानमवोचद्दानवेश्वरम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002973007, "chapter_id": 22973, "verse_number": "२-२०-८", "content_sanskrit": "वृद्धब्राह्मण उवाच ।\nदेहि भिक्षां च राजेन्द्र मह्यं विप्राय साम्प्रतम् ।\nत्वं सर्वसम्पदां दाता यन्मे मनसि वाञ्छितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002973008, "chapter_id": 22973, "verse_number": "२-२०-९", "content_sanskrit": "निराहाराय वृद्धाय तृषितायातुराय च ।\nपश्चात्त्वां कथयिष्यामि पुरः सत्यं च कुर्विति ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002973009, "chapter_id": 22973, "verse_number": "२-२०-१०", "content_sanskrit": "ओमित्युवाच राजेन्द्रः प्रसन्नवदनेक्षणः ।\nकवचार्थी जनश्चाहमित्युवाच स मायया ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002973010, "chapter_id": 22973, "verse_number": "२-२०-११", "content_sanskrit": "तच्छ्रुत्वा दानवश्रेष्ठो ददौ कवचमुत्तमम् ।\nगृहीत्वा कवचं दिव्यं जगाम हरिरेव च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002973011, "chapter_id": 22973, "verse_number": "२-२०-१२", "content_sanskrit": "शङ्खचूडस्य रूपेण जगाम तुलसीं प्रति ।\nगत्वा तस्यां मायया च वीर्य्याधानं चकार ह ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002973012, "chapter_id": 22973, "verse_number": "२-२०-१३", "content_sanskrit": "अथ शम्भुर्हरेः शूलं दानवार्थं समग्रहीत् ।\nग्रीष्ममध्याह्नमार्त्तण्डशतकप्रभमुज्ज्वलम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002973013, "chapter_id": 22973, "verse_number": "२-२०-१४", "content_sanskrit": "नारायणाधिष्ठिताग्रं ब्रह्माधिष्ठितमध्यमम् ।\nशिवाधिष्ठितमूलं च कालाधिष्ठितधारकम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002973014, "chapter_id": 22973, "verse_number": "२-२०-१५", "content_sanskrit": "किरणावलिसंयुक्तं प्रलयाग्निशिखोपमम् ।\nदुर्निवार्यं च दुर्धर्षमव्यर्थं वैरिघातकम्॥ ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002973015, "chapter_id": 22973, "verse_number": "२-२०-१६", "content_sanskrit": "तेजसा चक्रतुल्यं च सर्वशस्त्रविघातकम् ।\nशिवकेशवयोरन्यद् दुर्वहं च भयंकरम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002973016, "chapter_id": 22973, "verse_number": "२-२०-१७", "content_sanskrit": "धनुस्सहस्रं दैर्घ्येण विस्तृत्या शतहस्तकम् ।\nसजीवं ब्रह्मरूपं च नित्यरूपमनिर्मितम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002973017, "chapter_id": 22973, "verse_number": "२-२०-१८", "content_sanskrit": "संहर्तुं सर्वविध्यण्डमेकदा दैवलीलया ।\nचिक्षेप घूर्णनं कृत्वा शंखचूडे च नारद ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002973018, "chapter_id": 22973, "verse_number": "२-२०-१९", "content_sanskrit": "राजा चापं परित्यज्य श्रीकृष्णचरणाम्बुजम् ।\nध्यानं चकार भक्त्या च कृत्वा योगासनं धिया॥ ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002973019, "chapter_id": 22973, "verse_number": "२-२०-२०", "content_sanskrit": "शूलं च भ्रमणं कृत्वा न्यपतद्दानवोपरि ।\nचकार भस्मसात्तं च सरथं चैव लीलया ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002973020, "chapter_id": 22973, "verse_number": "२-२०-२१", "content_sanskrit": "राजा धृत्वा दिव्यरूपं बालकं गोपवेषकम् ।\nद्विभुजं मुरलीहस्तं रत्नभूषणभूषितम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002973021, "chapter_id": 22973, "verse_number": "२-२०-२२", "content_sanskrit": "नानारत्नसुभूषाढ्यगोपकोटिभिरावृतम् ।\nगोलोकादागतं यानमारुह्य तत्पुरं ययौ ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002973022, "chapter_id": 22973, "verse_number": "२-२०-२३", "content_sanskrit": "गत्वा ननाम शिरसा राधामाधवयोर्मुने ।\nभक्त्या तच्चरणाम्भोजं रासे वृन्दावने मुने ।\nसुदामानं तौ च दृष्ट्वा प्रसन्न वदनेक्षणौ ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002973023, "chapter_id": 22973, "verse_number": "२-२०-२४", "content_sanskrit": "तदा च चक्रतुः क्रोडे स्नेहेन परिसंप्लुतौ ।\nअथ शूलश्च वेगेन प्रययौ शूलिनः करम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002973024, "chapter_id": 22973, "verse_number": "२-२०-२५", "content_sanskrit": "शङ्करस्तेन शूलेन दानवस्यास्थिजालकम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002973025, "chapter_id": 22973, "verse_number": "२-२०-२६", "content_sanskrit": "प्रेम्णा च प्रेरयामास लवणोदे च सागरे ।\nअस्थिभिः शंखचूडस्य शंखजातिर्बभूव ह॥ ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002973026, "chapter_id": 22973, "verse_number": "२-२०-२७", "content_sanskrit": "नानाप्रकाररूपा च श्रेष्ठा पूता सुरार्चने ।\nप्रशस्तं शंखतोयं च देवानां प्रीतिदं परम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002973027, "chapter_id": 22973, "verse_number": "२-२०-२८", "content_sanskrit": "तीर्थतोयस्वरूपं च पवित्रं शंकरं विना ।\nशंखशब्दो भवेद्यत्र तत्र लक्ष्मीश्च सुस्थिरा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002973028, "chapter_id": 22973, "verse_number": "२-२०-२९", "content_sanskrit": "स स्नातः सर्वतीर्थेषु यः स्नातः शंखवारिणा ।\nशंखं हरेरधिष्ठानं यत्र शंखस्ततो हरिः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002973029, "chapter_id": 22973, "verse_number": "२-२०-३०", "content_sanskrit": "तत्रैव सततं लक्ष्मीर्दूरीभूतममङ्गलम् ।\nस्त्रीणां च शंखध्वनिभिः शूद्राणां च विशेषतः ।\nभीता रुष्टा याति लक्ष्मीः स्थलमन्यं स्थलात्ततः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002973030, "chapter_id": 22973, "verse_number": "२-२०-३१", "content_sanskrit": "शिवश्च दानवं हत्वा शिवलोकं जगाम सः ।\nप्रहृष्टो वृषमारुह्य स्वगणैश्च समावृतः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002973031, "chapter_id": 22973, "verse_number": "२-२०-३२", "content_sanskrit": "सुराः स्वविषयं प्रापुः परमानन्दसंयुताः ।\nनेदुर्दुन्दुभयः स्वर्गे जगुर्गन्धर्वकिन्नराः॥ ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002973032, "chapter_id": 22973, "verse_number": "२-२०-३३", "content_sanskrit": "बभूव पुष्पवृष्टिश्च शिवस्योपरि सन्ततम् ।\nप्रशशंसुः सुरास्तं च मुनीन्द्रप्रवरादयः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]