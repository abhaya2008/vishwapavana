[{"id": 5000004000, "chapter_id": 9004, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे चतुर्थः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000004001, "chapter_id": 9004, "verse_number": "१-४-१", "content_sanskrit": "प्राप्तराज्यस्य रामस्य वाल्मीकिर्भगवानृषिः ।\nचकार चरितं कृत्स्नं विचित्रपदमर्थवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000004002, "chapter_id": 9004, "verse_number": "१-४-२", "content_sanskrit": "चतुर्विंशत्सहस्राणि श्लोकानामुक्तवानृषिः ।\nतथा सर्गशतान् पञ्च षट्काण्डानि तथोत्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000004003, "chapter_id": 9004, "verse_number": "१-४-३", "content_sanskrit": "कृत्वा तु तन्महाप्राज्ञः सभविष्यं सहोत्तरम् ।\nचिन्तयामास को न्वेतत् प्रयुञ्जीयादिति प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000004004, "chapter_id": 9004, "verse_number": "१-४-४", "content_sanskrit": "तस्य चिन्तयमानस्य महर्षेर्भावितात्मनः ।\nअगृह्णीतां ततः पादौ मुनिवेषौ कुशीलवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000004005, "chapter_id": 9004, "verse_number": "१-४-५", "content_sanskrit": "कुशीलवौ तु धर्मज्ञौ राजपुत्रौ यशस्विनौ ।\nभ्रातरौ स्वरसंपन्नौ ददर्शाश्रमवासिनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000004006, "chapter_id": 9004, "verse_number": "१-४-६", "content_sanskrit": "स तु मेधाविनौ दृष्ट्वा वेदेषु परिनिष्ठितौ ।\nवेदोपबृंह्मणार्थाय तावग्राहयत प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000004007, "chapter_id": 9004, "verse_number": "१-४-७", "content_sanskrit": "काव्यं रामायणं कृत्स्नं सीतायाश्चरितं महत् ।\nपौलस्त्यवधमित्येवं चकार चरितव्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000004008, "chapter_id": 9004, "verse_number": "१-४-८", "content_sanskrit": "पाठ्ये गेये च मधुरं प्रमाणैस्त्रिभिरन्वितम् ।\nजातिभिः सप्तभिर्युक्तं तन्त्रीलयसमन्वितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000004009, "chapter_id": 9004, "verse_number": "१-४-९", "content_sanskrit": "रसैः शृङ्गारकरुणहास्यरौद्रभयानकैः ।\nवीरादिभी रसैर्युक्तं काव्यमेतदगायताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000004010, "chapter_id": 9004, "verse_number": "१-४-१०", "content_sanskrit": "तौ तु गान्धर्वतत्त्वज्ञौ स्थानमूर्च्छनकोविदौ ।\nभ्रातरौ स्वरसम्पन्नौ गन्धर्वाविव रूपिणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000004011, "chapter_id": 9004, "verse_number": "१-४-११", "content_sanskrit": "रूपलक्षणसम्पन्नौ मधुरस्वरभाषिणौ ।\nबिम्बादिवोत्थितौ बिम्बौ रामदेहात् तथापरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000004012, "chapter_id": 9004, "verse_number": "१-४-१२", "content_sanskrit": "तौ राजपुत्रौ कार्त्स्न्येन धर्म्यमाख्यानमुत्तमम् ।\nवाचोविधेयं तत्सर्वं कृत्वा काव्यमनिन्दितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000004013, "chapter_id": 9004, "verse_number": "१-४-१३", "content_sanskrit": "ऋषीणां च द्विजातीनां साधूनां च समागमे ।\nयथोपदेशं तत्त्वज्ञौ जगतुः सुसमाहितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000004014, "chapter_id": 9004, "verse_number": "१-४-१४", "content_sanskrit": "महात्मानौ महाभागौ सर्वलक्षणलक्षितौ ।\nतौ कदाचित् समेतानामृषीणां भावितात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000004015, "chapter_id": 9004, "verse_number": "१-४-१५", "content_sanskrit": "मध्ये सभं समीपस्थाविदं काव्यमगायताम् ।\nतच्छ्रुत्वा मुनयः सर्वे बाष्पपर्याकुलेक्षणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000004016, "chapter_id": 9004, "verse_number": "१-४-१६", "content_sanskrit": "साधु साध्विति तावूचुः परं विस्मयमागताः ।\nते प्रीतमनसः सर्वे मुनयो धर्मवत्सलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000004017, "chapter_id": 9004, "verse_number": "१-४-१७", "content_sanskrit": "प्रशशंसुः प्रशस्तव्यौ गायमानौ कुशीलवौ ।\nअहो गीतस्य माधुर्यं श्लोकानां च विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000004018, "chapter_id": 9004, "verse_number": "१-४-१८", "content_sanskrit": "चिरनिर्वृत्तमप्येतत् प्रत्यक्षमिव दर्शितम् ।\nप्रविश्य तावुभौ सुष्ठु तथाभावमगायताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000004019, "chapter_id": 9004, "verse_number": "१-४-१९", "content_sanskrit": "सहितौ मधुरं रक्तं सम्पन्नं स्वरसंपदा ।\nएवं प्रशस्यमानौ तौ तपः श्लाघ्यैर्महर्षिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000004020, "chapter_id": 9004, "verse_number": "१-४-२०", "content_sanskrit": "संरक्ततरमत्यर्थं मधुरं तावगायताम् ।\nप्रीतः कश्चिन्मुनिस्ताभ्यां संस्थितः कलशं ददौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000004021, "chapter_id": 9004, "verse_number": "१-४-२१", "content_sanskrit": "प्रसन्नो वल्कलं कश्चिद् ददौ ताभ्यां महायशाः ।\nअन्यः कृष्णाजिनमदाद् यज्ञसूत्रं तथापरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000004022, "chapter_id": 9004, "verse_number": "१-४-२२", "content_sanskrit": "कश्चित् कमण्डलुं प्रादान्मौञ्जीमन्यो महामुनिः ।\nबृसीमन्यस्तदा प्रादात् कौपीनमपरो मुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000004023, "chapter_id": 9004, "verse_number": "१-४-२३", "content_sanskrit": "ताभ्यां ददौ तदा हृष्टः कुठारमपरो मुनिः ।\nकाषायमपरो वस्त्रं चीरमन्यो ददौ मुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000004024, "chapter_id": 9004, "verse_number": "१-४-२४", "content_sanskrit": "जटाबन्धनमन्यस्तु काष्ठरज्जुं मुदान्वितः ।\nयज्ञभाण्डमृषिः कश्चित् काष्ठभारं तथा परः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000004025, "chapter_id": 9004, "verse_number": "१-४-२५", "content_sanskrit": "औदुम्बरीं ब्रुसीमन्यः स्वस्ति केचित् तदावदन् ।\nआयुष्यमपरे प्राहुर्मुदा तत्र महर्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000004026, "chapter_id": 9004, "verse_number": "१-४-२६", "content_sanskrit": "ददुश्चैवं वरान् सर्वे मुनयः सत्यवादिनः ।\nआश्चर्यमिदमाख्यानं मुनिना सम्प्रकीर्तितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000004027, "chapter_id": 9004, "verse_number": "१-४-२७", "content_sanskrit": "परं कवीनामाधारं समाप्तं च यथाक्रमम् ।\nअभिगीतमिदं गीतं सर्वगीतेषु कोविदौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000004028, "chapter_id": 9004, "verse_number": "१-४-२८", "content_sanskrit": "आयुष्यं पुष्टिजननं सर्वश्रुतिमनोहरम् ।\nप्रशस्यमानौ सर्वत्र कदाचित् तत्र गायकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000004029, "chapter_id": 9004, "verse_number": "१-४-२९", "content_sanskrit": "रथ्यासु राजमार्गेषु ददर्श भरताग्रजः ।\nस्ववेश्म चानीय ततो भ्रातरौ स कुशीलवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000004030, "chapter_id": 9004, "verse_number": "१-४-३०", "content_sanskrit": "पूजयामास पूजार्हौ रामः शत्रुनिबर्हणः ।\nआसीनः काञ्चने दिव्ये स च सिंहासने प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000004031, "chapter_id": 9004, "verse_number": "१-४-३१", "content_sanskrit": "उपोपविष्टैः सचिवैर्भ्रातृभिश्च समन्वितः ।\nदृष्ट्वा तु रूपसम्पन्नौ विनीतौ भ्रातरावुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000004032, "chapter_id": 9004, "verse_number": "१-४-३२", "content_sanskrit": "उवाच लक्ष्मणं रामः शत्रुघ्नं भरतं तथा ।\nश्रूयतामेतदाख्यानमनयोर्देववर्चसोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000004033, "chapter_id": 9004, "verse_number": "१-४-३३", "content_sanskrit": "विचित्रार्थपदं सम्यग्गायकौ समचोदयत् ।\nतौ चापि मधुरं रक्तं स्वचित्तायतनिःस्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000004034, "chapter_id": 9004, "verse_number": "१-४-३४", "content_sanskrit": "तन्त्रीलयवदत्यर्थं विश्रुतार्थमगायताम् ।\nह्लादयत् सर्वगात्राणि मनांसि हृदयानि च ।\nश्रोत्राश्रयसुखं गेयं तद् बभौ जनसंसदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000004035, "chapter_id": 9004, "verse_number": "१-४-३५", "content_sanskrit": "इमौ मुनी पार्थिवलक्षणान्वितौ ।\n::कुशीलवौ चैव महातपस्विनौ ।\nममापि तद् भूतिकरं प्रचक्षते ।\n::महानुभावं चरितं निबोधत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000004036, "chapter_id": 9004, "verse_number": "१-४-३६", "content_sanskrit": "ततस्तु तौ रामवचः प्रचोदिता-\n::वगायतां मार्गविधानसम्पदा ।\nस चापि रामः परिषद्गतः शनै-\nर्बुभूषयासक्तमना बभूव ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000004037, "chapter_id": 9004, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे चतुर्थः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]