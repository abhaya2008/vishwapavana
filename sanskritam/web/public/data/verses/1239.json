[{"id": 2011631, "chapter_id": 1239, "verse_number": "१-२४०-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2011632, "chapter_id": 1239, "verse_number": "१-२४०-१", "content_sanskrit": "चैराः संचारिते तस्मिन्ननुज्ञाते युधिष्ठिरे।\nवासुदेवाभ्यनुज्ञातः कथयित्वेतिकृत्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2011633, "chapter_id": 1239, "verse_number": "१-२४०-२", "content_sanskrit": "कृष्णस्य मतमास्थाय प्रययौ भरतर्षभः।\nद्वारकाया उपवने तस्थौ वै कार्यसाधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2011634, "chapter_id": 1239, "verse_number": "१-२४०-३", "content_sanskrit": "निवृत्ते ह्युत्सवे तस्मिन्गिरौ रैवतके तदा।\nवृष्णयोऽप्यगमन्सर्वे पुरीं द्वारवतीमनु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2011635, "chapter_id": 1239, "verse_number": "१-२४०-४", "content_sanskrit": "चिन्तयानस्ततो भद्रामुपविष्टः शिलातले।\nरमणीये वनोद्देशे बहुपादपसंवृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2011636, "chapter_id": 1239, "verse_number": "१-२४०-५", "content_sanskrit": "सालतालाश्वकर्णैश्च बकुलैरर्जुनैस्तथा।\nचम्पकाशोकपुन्नागैः केतकैः पाटलैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2011637, "chapter_id": 1239, "verse_number": "१-२४०-६", "content_sanskrit": "कर्णिकारैरशोकैश्च अङ्कोलैरतिमुक्तकैः।\nएवमादिभिरन्यैश्च संवृते स शिलातले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2011638, "chapter_id": 1239, "verse_number": "१-२४०-७", "content_sanskrit": "पुनःपुनश्चिन्तयानः सुभद्रां भद्रभाषिणीम्।\nयदृच्छया चोपपन्नान्वृष्णिवीरान्ददर्श सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2011639, "chapter_id": 1239, "verse_number": "१-२४०-८", "content_sanskrit": "बलदेवं च हार्दिक्यं साम्बं सारणमेव च।\nप्रद्युम्नं च गदं चैव चारुदेष्णं विदूरथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2011640, "chapter_id": 1239, "verse_number": "१-२४०-९", "content_sanskrit": "भानुं च हरितं चैव विपृथुं पृथुमेव च।\nतथान्यांश्च बहून्पश्यन्हृदि शोकमधारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2011641, "chapter_id": 1239, "verse_number": "१-२४०-१०", "content_sanskrit": "ततस्ते सहिताः सर्वे यतिं दृष्ट्वा समुत्सुकाः।\nवृष्णयो विनयोपेताः परिवार्योपतस्थिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2011642, "chapter_id": 1239, "verse_number": "१-२४०-११", "content_sanskrit": "ततोऽर्जुनः प्रीतमनाः स्वागतं व्याजहार सः।\nआस्यतामास्यतां सर्वै रमणीये शिलातले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2011643, "chapter_id": 1239, "verse_number": "१-२४०-१२", "content_sanskrit": "इत्येवमुक्ता यतिना प्रीतास्ते यादवर्षभाः।\nउपोपविविशुः सर्वे ते स्वागतमिति ब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2011644, "chapter_id": 1239, "verse_number": "१-२४०-१३", "content_sanskrit": "परितः सन्निविष्टेषु वृष्णिवीरेषु पाण्डवः।\nआकारं गूहमानस्तु कुशलप्रश्नमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2011645, "chapter_id": 1239, "verse_number": "१-२४०-१४", "content_sanskrit": "सर्वत्र कुशलं चोक्त्वा बलदेवोऽब्रवीदिदम्।\nप्रसादं कुरु मे विप्र कुतस्त्वं चागतो ह्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2011646, "chapter_id": 1239, "verse_number": "१-२४०-१५", "content_sanskrit": "त्वया दृष्टानि पुण्यानि वद त्वं वदतांवर।\nपर्वतांश्चैव तीर्थानि वनान्यायतनानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2011647, "chapter_id": 1239, "verse_number": "१-२४०-१६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2011648, "chapter_id": 1239, "verse_number": "१-२४०-१६", "content_sanskrit": "तीर्थानां दर्शनं चैव पर्वतानां च भारत।\nआपगानां वनानां च कथयामास ताः कथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2011649, "chapter_id": 1239, "verse_number": "१-२४०-१७", "content_sanskrit": "श्रुत्वा धर्मकथाः पुण्या वृष्णिवीरा मुदान्विताः।\nअपूजयंस्तदा भिक्षुं कथान्ते जनमेजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2011650, "chapter_id": 1239, "verse_number": "१-२४०-१८", "content_sanskrit": "ततस्तु यादवाः सर्वे मन्त्रयन्ति स्म भारत।\nअयं देशातिथिः श्रीमान्यतिलिङ्गधरो द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2011651, "chapter_id": 1239, "verse_number": "१-२४०-१९", "content_sanskrit": "आवासं कमुपाश्रित्य वसेत निरुपद्रवः।\nइत्येवं प्रब्रुवन्तस्तु रौहिणेयं च यादवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2011652, "chapter_id": 1239, "verse_number": "१-२४०-२०", "content_sanskrit": "ददृशुः कृष्णमायान्तं सर्वे यादवनन्दनम्।\nएहि केशव तातेति रौहिणेयो वचोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2011653, "chapter_id": 1239, "verse_number": "१-२४०-२१", "content_sanskrit": "यतिलिङ्गधरो विद्वान्देशातिथिरयं द्विजः।\nवर्षमासनिवासार्थमागतो नः पुरं प्रति।\nस्थाने यस्मिन्निवसतु तन्मे ब्रूहि जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2011654, "chapter_id": 1239, "verse_number": "१-२४०-२२x", "content_sanskrit": "श्रीकृष्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2011655, "chapter_id": 1239, "verse_number": "१-२४०-२२", "content_sanskrit": "त्वयि स्थिते महाभाग परवानस्मि धर्मतः।\nस्वयं तु रुचिरे स्थाने वासयेर्यदुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2011656, "chapter_id": 1239, "verse_number": "१-२४०-२३", "content_sanskrit": "प्रीतः स तेन वाक्येन परिष्वज्य जनार्दनम्।\nबलदेवोऽब्रवीद्वाक्यं चिन्तयित्वा महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2011657, "chapter_id": 1239, "verse_number": "१-२४०-२४", "content_sanskrit": "आरामे तु वसेद्धीमांश्चतुरो वर्षमासकान्।\nकन्यागृहे सुभद्राया भुक्त्वा भोजनमिच्छया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2011658, "chapter_id": 1239, "verse_number": "१-२४०-२५", "content_sanskrit": "लतागृहेषु वसतामिति मे धीयते मतिः।\nलब्धानुज्ञास्त्वया तात मन्यन्ते सर्वयादवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2011659, "chapter_id": 1239, "verse_number": "१-२४०-२६x", "content_sanskrit": "श्रीकृष्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2011660, "chapter_id": 1239, "verse_number": "१-२४०-२६", "content_sanskrit": "बलवान्दर्शनीयश्च वाग्मी श्रीमान्बहुश्रुतः।\nकन्यापुरसमीपे तु न युक्तमिति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2011661, "chapter_id": 1239, "verse_number": "१-२४०-२७", "content_sanskrit": "गुरुः शास्ता च नेता च शास्त्रज्ञो धर्मवित्तमः।\nत्वयोक्तं न विरुध्येहं करिष्यामि वचस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2011662, "chapter_id": 1239, "verse_number": "१-२४०-२८", "content_sanskrit": "शुभाशुभस्य विज्ञाता नान्योऽस्मि भुवि कश्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2011663, "chapter_id": 1239, "verse_number": "१-२४०-२९x", "content_sanskrit": "बलदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2011664, "chapter_id": 1239, "verse_number": "१-२४०-२९", "content_sanskrit": "अयं देशातिथिः श्रीमान्सर्वधर्मभृतां वरः।\nधृतिमान्विनयोपेतः सत्यबादी जितेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2011665, "chapter_id": 1239, "verse_number": "१-२४०-३०", "content_sanskrit": "यतिलिङ्गधरो ह्येष को विजानाति मानसम्।\nत्वमिमं पुण्डरीकाक्ष नीत्वा कन्यापुरं शुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2011666, "chapter_id": 1239, "verse_number": "१-२४०-३१", "content_sanskrit": "निवेदय सुभद्रायै मद्वाक्यपरिचोदितः।\nभक्ष्यैर्भोज्यैश्च पानैश्च अन्नैरिष्टैश्च पूजय॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2011667, "chapter_id": 1239, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि सुभद्राहरणपर्वणि चत्वारिंशदधिकद्विशततमोऽध्यायः॥ २४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]