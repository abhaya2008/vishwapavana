[{"id": 7006386000, "chapter_id": 26386, "verse_number": "२-४३-१", "content_sanskrit": "वैशम्पायन उवाच\nतौ नगादाप्लुतौ दृष्ट्वा वसुदेवसुतावुभौ ।\nक्षुब्धं नरवरानीकं सर्वं सम्मूढवाहनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006386001, "chapter_id": 26386, "verse_number": "२-४३-२", "content_sanskrit": "बाहुप्रहरणौ तौ तु चेरतुस्तत्र यादवौ ।\nमकराविव संरब्धौ समुद्रक्षोभणावुभौ ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006386002, "chapter_id": 26386, "verse_number": "२-४३-३", "content_sanskrit": "ताभ्यां मृधे प्रविष्टाभ्यां यादवाभ्यां मतिस्त्वभूत् ।\nआयुधानां पुराणानामादानकृतलक्षणा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006386003, "chapter_id": 26386, "verse_number": "२-४३-४", "content_sanskrit": "ततोऽम्बरतलाद् भूयः पतन्ति स्म महात्मनोः ।\nमध्ये राजसहस्रस्य समरं प्रतिकाङ्क्षिणोः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006386004, "chapter_id": 26386, "verse_number": "२-४३-५", "content_sanskrit": "यानि वै माथुरे युद्धे प्राप्तान्याहवशोभिनोः ।\nतान्यम्बरात् पतन्ति स्म दिव्यान्याहवसम्प्लवे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006386005, "chapter_id": 26386, "verse_number": "२-४३-६", "content_sanskrit": "लेलिहानानि दीप्तानि दीप्ताग्निसदृशानि वै ।\nनिक्षिप्य यानि तत्रैव तानि प्राप्तौ स्म यादवौ ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006386006, "chapter_id": 26386, "verse_number": "२-४३-७", "content_sanskrit": "क्रव्यादैरनुयातानि मूर्तिमन्ति बृहन्ति च ।\nतृषितान्याहवे भोक्तुं नृपमांसानि सर्वशः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006386007, "chapter_id": 26386, "verse_number": "२-४३-८", "content_sanskrit": "दिव्यस्रग्दामधारीणि त्रासयन्ति च खेचरान् ।\nप्रभया भासमानानि दंशितानि दिशो दश ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006386008, "chapter_id": 26386, "verse_number": "२-४३-९", "content_sanskrit": "हलं सांवर्तकं नाम सौनन्दं मुसलं तथा ।\nचक्रं सुदर्शनं नाम गदां कौमोदकीं तथा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006386009, "chapter_id": 26386, "verse_number": "२-४३-१०", "content_sanskrit": "चत्वार्येतानि तेजांसि विष्णुप्रहरणानि वै ।\nताभ्यां समवतीर्णानि यादवाभ्यां महामृधे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006386010, "chapter_id": 26386, "verse_number": "२-४३-११", "content_sanskrit": "जग्राह प्रथमं रामो ललामप्रतिमं रणे ।\nसर्पन्तमिव सर्पेन्द्रं दिव्यमालाकुलं हलम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006386011, "chapter_id": 26386, "verse_number": "२-४३-१२", "content_sanskrit": "सव्येन सात्वतां श्रेष्ठो जग्राह मुसलोत्तमम् ।\nसौनन्दं नाम बलवान् निरानन्दकरं द्विषाम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006386012, "chapter_id": 26386, "verse_number": "२-४३-१३", "content_sanskrit": "दर्शनीयं च लोकेषु चक्रमादित्यवर्चसम् ।\nनाम्ना सुदर्शनं नाम प्रीतो जग्राह केशवः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006386013, "chapter_id": 26386, "verse_number": "२-४३-१४", "content_sanskrit": "दर्शनीयं च लोकेषु धनुर्जलदनिःस्वनम् । ।\nनाम्ना शार्ङ्गमिति ख्यातं प्रीतो जग्राह वीर्यवान् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006386014, "chapter_id": 26386, "verse_number": "२-४३-१५", "content_sanskrit": "देवैर्निगदितार्थस्य गदा तस्यापरे करे ।\nनिषक्ता कुमुदाक्षस्य नाम्ना कौमोदकीति सा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006386015, "chapter_id": 26386, "verse_number": "२-४३-१६", "content_sanskrit": "तौ सप्रहरणौ वीरौ साक्षाद्विष्णुतनूपमौ ।\nसमरे रामगोविन्दौ रिपूंस्तान् प्रत्ययुद्ध्यताम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006386016, "chapter_id": 26386, "verse_number": "२-४३-१७", "content_sanskrit": "आयुधप्रग्रहौ वीरौ तावन्योन्यमयावुभौ ।\nपूर्वजानुजसंज्ञौ तु रामगोविन्दलक्षणौ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006386017, "chapter_id": 26386, "verse_number": "२-४३-१८", "content_sanskrit": "समरेऽप्रतिरूपौ तौ विष्णुरेको द्विधा कृतः ।\nद्विषत्सु प्रतिकुर्वाणौ पराक्रान्तौ यथेश्वरौ ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006386018, "chapter_id": 26386, "verse_number": "२-४३-१९", "content_sanskrit": "हलमुद्यम्य रामस्तु सर्पेन्द्रमिव कोपनम् ।\nचचार समरे वीरो द्विषतामन्तकोपमः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006386019, "chapter_id": 26386, "verse_number": "२-४३-२०", "content_sanskrit": "विकर्षन् रथवृन्दानि क्षत्रियाणां महात्मनाम् ।\nचकार रोषं सफलं नागेषु च हयेषु च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006386020, "chapter_id": 26386, "verse_number": "२-४३-२१", "content_sanskrit": "कुञ्जराँल्लाङ्गलोत्क्षिप्तान् मुसलाक्षेपताडितान् ।\nरामोऽभिरामः समरे निर्ममन्थ यथाचलान् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006386021, "chapter_id": 26386, "verse_number": "२-४३-२२", "content_sanskrit": "ते वध्यमाना रामेण समरे क्षत्रियर्षभाः ।\nजरासंधान्तिकं भीता विरथाः प्रतिजग्मिरे ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006386022, "chapter_id": 26386, "verse_number": "२-४३-२३", "content_sanskrit": "तानुवाच जरासंधः क्षत्रधर्मे व्यवस्थितः ।\nधिगेतां क्षत्रवृत्तिं वः समरे कातरात्मनाम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006386023, "chapter_id": 26386, "verse_number": "२-४३-२४", "content_sanskrit": "पराक्रान्तस्य समरे विरथस्य पलायतः ।\nभ्रूणहत्यामिवासह्यां प्रवदन्ति मनीषिणः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006386024, "chapter_id": 26386, "verse_number": "२-४३-२५", "content_sanskrit": "पत्तिनो भुवि चैकस्य गोपस्याल्पबलीयसः ।\nभीताः किं विनिवर्तध्वं धिगेतां क्षत्रवृत्तिताम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006386025, "chapter_id": 26386, "verse_number": "२-४३-२६", "content_sanskrit": "क्षिप्रं समभिवर्तन्तां मम वाक्येन नोदिताः ।\nयावदेतौ रणे गोपौ प्रेषयामि यमक्षयम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006386026, "chapter_id": 26386, "verse_number": "२-४३-२७", "content_sanskrit": "ततस्ते क्षत्रियाः सर्वे जरासंधेन नोदिताः ।\nक्षिपन्तः शरजालानि हृष्टा योद्धुमुपस्थिताः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006386027, "chapter_id": 26386, "verse_number": "२-४३-२८", "content_sanskrit": "ते हयैः काञ्चनापीडै रथैश्चेन्दुसमप्रभैः ।\nनागैश्चाम्भोदसंकाशैर्महामात्रप्रणोदितैः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006386028, "chapter_id": 26386, "verse_number": "२-४३-२९", "content_sanskrit": "सतनुत्राणनिस्त्रिंशाः सायुधाभरणाम्बराः ।\nस्वारोपितधनुष्मन्तः सतूणीराः ससायकाः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006386029, "chapter_id": 26386, "verse_number": "२-४३-३०", "content_sanskrit": "सच्छत्रोत्सेधिनः सर्वे चारुचामरवीजिताः ।\nरणावनिगता रेजुः स्यन्दनस्था महीक्षितः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006386030, "chapter_id": 26386, "verse_number": "२-४३-३१", "content_sanskrit": "तौ युद्धरङ्गापतितौ विधावन्तौ महाभुजौ ।\nवसुदेवसुतौ वीरौ युयुत्सू प्रत्यदृश्यताम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006386031, "chapter_id": 26386, "verse_number": "२-४३-३२", "content_sanskrit": "तद् युद्धमभवत्तत्र तयोस्तेषां तु संयुगं ।\nसायकोत्सर्गबहुलं गदानिर्घातदारुणम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006386032, "chapter_id": 26386, "verse_number": "२-४३-३३", "content_sanskrit": "ततः शरसहस्राणि प्रतीच्छन्तौ रणेषिणौ ।\nतस्थतुर्योधमुख्यौ तावभिवृष्टौ यथाचलौ ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006386033, "chapter_id": 26386, "verse_number": "२-४३-३४", "content_sanskrit": "गदाभिश्चैव गुर्वीभिः क्षेपणीयैश्च मुद्गरैः ।\nअर्द्यमानौ महेष्वासौ यादवौ न चकम्पतुः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006386034, "chapter_id": 26386, "verse_number": "२-४३-३५", "content_sanskrit": "ततः कृष्णोऽम्बुदाकारः शङ्खचक्रगदाधरः ।\nव्यवर्धत महातेजा वातयुक्त इवानलः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006386035, "chapter_id": 26386, "verse_number": "२-४३-३६", "content_sanskrit": "स चक्रेणार्कतुल्येन दीप्यमानेन तेजसा ।\nचिच्छेद समरे वीरो नृगजाश्वमहारथान् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006386036, "chapter_id": 26386, "verse_number": "२-४३-३७", "content_sanskrit": "गदानिपातविहता लाङ्गलेन च कर्षिताः ।\nन शेकुस्ते रणे स्थातुं पार्थिवा नष्टचेतसः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006386037, "chapter_id": 26386, "verse_number": "२-४३-३८", "content_sanskrit": "चक्रक्षुरनिकृत्तानि विचित्राणि महीक्षिताम् ।\nरथयूथानि भग्नानि न शेकुश्चलितुं रणे ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006386038, "chapter_id": 26386, "verse_number": "२-४३-३९", "content_sanskrit": "मुसलाक्षेपभग्नाश्च कुञ्जराः षष्टिहायनाः ।\nघना इव घनापाये भग्नदन्ता विचुक्रुशुः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006386039, "chapter_id": 26386, "verse_number": "२-४३-४०", "content_sanskrit": "चक्रानलज्वालहताः सादिनः सपदातयः ।\nपेतुः परासवस्तत्र यथा वज्रहतास्तथा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006386040, "chapter_id": 26386, "verse_number": "२-४३-४१", "content_sanskrit": "चक्रलाङ्गलनिर्दग्धं तत्सैन्यं विदलीकृतम् ।\nयुगान्तोपहतप्रख्यं सर्वं पतितमाबभौ ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006386041, "chapter_id": 26386, "verse_number": "२-४३-४२", "content_sanskrit": "आक्रीडभूमिं दिव्यानामायुधानां वपुष्मताम् ।\nवैष्णवानां नृपास्ते तु द्रष्टुमप्यबलीयसः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006386042, "chapter_id": 26386, "verse_number": "२-४३-४३", "content_sanskrit": "केचिद्रथा सम्मृदिताः केचिन्निहतपार्थिवाः ।\nभग्नैकचक्रास्त्वपरे विकीर्णा धरणीतले ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006386043, "chapter_id": 26386, "verse_number": "२-४३-४४", "content_sanskrit": "तस्मिन् विशसने घोरे चक्रलाङ्गलसम्प्लवे ।\nदारुणानि प्रवृत्तानि रक्षांस्यौत्पातिकानि च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006386044, "chapter_id": 26386, "verse_number": "२-४३-४५", "content_sanskrit": "आर्तानां कूजमानानां पाटितानां च वेणुवत् ।\nअन्तो न शक्यतेऽन्वेष्टुं नृनागरथवाजिनाम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006386045, "chapter_id": 26386, "verse_number": "२-४३-४६", "content_sanskrit": "सा पातितनरेन्द्राणां रुधिराऽऽर्द्रा रणक्षितिः ।\nयोषेव चन्दनार्द्राङ्गी भैरवा प्रतिभाति वै ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006386046, "chapter_id": 26386, "verse_number": "२-४३-४७", "content_sanskrit": "नरकेशास्थिमज्जान्त्रैः शातितानां च दन्तिनाम् ।\nरुधिरौघप्लवस्तत्र च्छादयामास मेदिनीम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006386047, "chapter_id": 26386, "verse_number": "२-४३-४८", "content_sanskrit": "तस्मिन् महाभीषणके नरवाहनसंक्षये ।\nशिवानामशिवैः शब्दैर्नादिते घोरदर्शने ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006386048, "chapter_id": 26386, "verse_number": "२-४३-४९", "content_sanskrit": "आर्तस्तनितसंनादे रुधिराम्बुह्रदाकुले ।\nअन्तकाक्रीडसदृशे नागदेहैः समावृते ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006386049, "chapter_id": 26386, "verse_number": "२-४३-५०", "content_sanskrit": "अपास्तैर्बाहुभिर्योधैस्तुरगैश्च विदारितैः ।\nकङ्कैश्च बलगृध्रैश्च नादितैः प्रतिनादिते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006386050, "chapter_id": 26386, "verse_number": "२-४३-५१", "content_sanskrit": "निपाते पृथिवीशानां मृत्युसाधारणे रणे ।\nकृष्णः शत्रुवधं कर्तुं चचारान्तकदर्शनः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006386051, "chapter_id": 26386, "verse_number": "२-४३-५२", "content_sanskrit": "युगान्तार्कप्रभं चक्रं कालीं चैवायसीं गदाम् ।\nगृह्य सैन्यावनिगतो बभाषे केशवो नृपान् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006386052, "chapter_id": 26386, "verse_number": "२-४३-५३", "content_sanskrit": "किन्न युद्धयत वै शूरा हस्त्यश्वरथसंयुताः ।\nकिमिदं गम्यते शूराः कृतास्त्रा दृढनिश्चयाः ।\nअहं सपूर्वजः संख्ये पदातिः प्रमुखे स्थितः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006386053, "chapter_id": 26386, "verse_number": "२-४३-५४", "content_sanskrit": "अदृष्टदोषेण रणे भवन्तो येन पालिताः ।\nस इदानीं जरासंधः किमर्थं नाभिवर्तते ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006386054, "chapter_id": 26386, "verse_number": "२-४३-५५", "content_sanskrit": "एवमुक्ते तु नृपतिर्दरदो नाम वीर्यवान् ।\nरामं हलाग्रोग्रभुजं प्रत्ययात् सैन्यमध्यगम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006386055, "chapter_id": 26386, "verse_number": "२-४३-५६", "content_sanskrit": "बभाषे स तु ताम्राक्षमुक्षाणमिव सेवनी ।\nएह्येहि राम युध्यस्व मया सार्द्धमरिंदम ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006386056, "chapter_id": 26386, "verse_number": "२-४३-५७", "content_sanskrit": "तद् युद्धमभवत् ताभ्यां रामस्य दरदस्य च ।\nमृधे लोकवरिष्ठाभ्यां कुञ्जराभ्यामिवौजसा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006386057, "chapter_id": 26386, "verse_number": "२-४३-५८", "content_sanskrit": "योजयित्वा ततः स्कन्धे रामो दरदमाहवे ।\nहलेन बलिनां श्रेष्ठो मुसलेनावपोथयत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006386058, "chapter_id": 26386, "verse_number": "२-४३-५९", "content_sanskrit": "स्वकायगतमूर्धा वै मुसलेनावपोथितः ।\nपपात दरदो भूमौ दारितार्द्व इवाचलः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006386059, "chapter_id": 26386, "verse_number": "२-४३-६०", "content_sanskrit": "रामेण निहते तस्मिन् दरदे राजसत्तमे ।\nजरासंधस्य राज्ञस्तु रामेणासीत्समागमः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006386060, "chapter_id": 26386, "verse_number": "२-४३-६१", "content_sanskrit": "महेन्द्रस्येव वृत्रेण दारुणो लोमहर्षणः ।\nगदे गृहीत्वा विक्रान्तावन्योन्यमभिधावतः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006386061, "chapter_id": 26386, "verse_number": "२-४३-६२", "content_sanskrit": "कम्पयन्तौ भुवं वीरौ तावुद्यतमहागदौ ।\nददृशाते महात्मानौ गिरी सशिखराविव ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006386062, "chapter_id": 26386, "verse_number": "२-४३-६३", "content_sanskrit": "व्युपारमन्त युद्धानि प्रेक्ष्य तौ पुरुषर्षभौ ।\nसंरब्धाविव धावन्तौ गदायुद्धेषु विश्रुतौ ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006386063, "chapter_id": 26386, "verse_number": "२-४३-६४", "content_sanskrit": "तावुभौ परमाचार्यौ लोके ख्यातौ महाबलौ ।\nमत्ताविव महानागावन्योन्यं समधावताम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006386064, "chapter_id": 26386, "verse_number": "२-४३-६५", "content_sanskrit": "ततो देवाः सगन्धर्वाः सिद्धाश्च परमर्षयः ।\nयक्षाश्चाप्सरसश्चैव समाजग्मुः सहस्रशः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006386065, "chapter_id": 26386, "verse_number": "२-४३-६६", "content_sanskrit": "तद्देवयक्षगन्धर्वमहर्षिभिरलंकृतम् ।\nशुशुभेऽभ्यधिकं राजन् नभो ज्योतिर्गणैरिव ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006386066, "chapter_id": 26386, "verse_number": "२-४३-६७", "content_sanskrit": "अभिदुद्राव रामं तु जरासंधो नराधिपः ।\nसव्यं मण्डलमाश्रित्य बलदेवस्तु दक्षिणम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006386067, "chapter_id": 26386, "verse_number": "२-४३-६८", "content_sanskrit": "तावन्योन्यं प्रजह्राते गदायुद्धविशारदौ ।\nदन्ताभ्यामिव मातङ्गौ नादयन्तौ दिशो दश ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006386068, "chapter_id": 26386, "verse_number": "२-४३-६९", "content_sanskrit": "गदानिपातो रामस्य शुश्रुवेऽशनिनिःस्वनः ।\nजरासंधस्य च रणे पर्वतस्येव दीर्यतः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006386069, "chapter_id": 26386, "verse_number": "२-४३-७०", "content_sanskrit": "न स्म कम्पयते रामं जरासंधकरच्युता ।\nगदा गदाभृतां श्रेष्ठं विन्ध्यं गिरिमिवानिलः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006386070, "chapter_id": 26386, "verse_number": "२-४३-७१", "content_sanskrit": "रामस्य तु गदावेगं राजा स मगधेश्वरः ।\nसेहे धैर्येण महता शिक्षया च व्यपोथयत् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006386071, "chapter_id": 26386, "verse_number": "२-४३-७२", "content_sanskrit": "ततोऽन्तरिक्षे वागासीत् सुस्वरा लोकसाक्षिणी ।\nन त्वया राम वध्योऽयमलं खेदेन मानद ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006386072, "chapter_id": 26386, "verse_number": "२-४३-७३", "content_sanskrit": "विहितोऽस्य मया मृत्युस्तस्मात्साधु व्युपारम ।\nअचिरेणैव कालेन प्राणांस्त्यक्ष्यति मागधः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006386073, "chapter_id": 26386, "verse_number": "२-४३-७४", "content_sanskrit": "जरासंधस्तु तच्छ्रुत्वा विमनाः समपद्यत ।\nन प्राहरत् ततस्तस्मै पुनरेव हलायुधः ।\nतौ व्युपारमतां युद्धाद्वृष्णयस्ते च पार्थिवाः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006386074, "chapter_id": 26386, "verse_number": "२-४३-७५", "content_sanskrit": "दीर्घकालं महाराज निजघ्नुरितरेतरम् ।\nपराजिते त्वपक्रान्ते जरासंधे महीपतौ ।\nविविक्तमभवत् सैन्यं परावृत्तमहारथम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006386075, "chapter_id": 26386, "verse_number": "२-४३-७६", "content_sanskrit": "ते नृपाश्चोदितैर्नागैः स्यन्दनैस्तुरगैस्तथा ।\nदुद्रुवुर्भीतमनसो व्याघ्राघ्राता मृगा इव ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006386076, "chapter_id": 26386, "verse_number": "२-४३-७७", "content_sanskrit": "तन्नरेन्द्रैः परित्यक्तं भग्नदर्पैर्महारथैः ।\nघोरं क्रव्यादबहुलं रौद्रमायोधनं बभौ ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006386077, "chapter_id": 26386, "verse_number": "२-४३-७८", "content_sanskrit": "द्रवत्सु रथमुख्येषु चेदिराजो महाद्युतिः ।\nस्मृत्वा यादवसम्बन्धं कृष्णमेवान्ववर्तत ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006386078, "chapter_id": 26386, "verse_number": "२-४३-७९", "content_sanskrit": "वृतः कारूषसैन्येन चेदिसैन्येन चानघ ।\nसम्बन्धकामो गोविन्दमिदमाह स चेदिराट् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006386079, "chapter_id": 26386, "verse_number": "२-४३-८०", "content_sanskrit": "अहं पितृष्वसुर्भर्ता तव यादवनन्दन ।\nसबलस्त्वामुपावृत्तस्त्वं हि मे दयितः प्रभो ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006386080, "chapter_id": 26386, "verse_number": "२-४३-८१", "content_sanskrit": "उक्तश्चैष मया राजा जरासंधोऽल्पचेतनः ।\nकृष्णाद् विरम दुर्बुद्धे विग्रहाद् रणकर्मणि ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006386081, "chapter_id": 26386, "verse_number": "२-४३-८२", "content_sanskrit": "तदेषोऽद्य मया त्यक्तो मम वाक्यस्य दूषकः ।\nभग्नो युद्धे जरासंधस्त्वया द्रवति सानुगः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006386082, "chapter_id": 26386, "verse_number": "२-४३-८३", "content_sanskrit": "निर्वैरो नैष संयाति स्वपुरं पृथिवीपतिः ।\nत्वय्येव भूयोऽप्यपरं दर्शयिष्यति किल्बिषम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006386083, "chapter_id": 26386, "verse_number": "२-४३-८४", "content_sanskrit": "तदिमां संत्यजाशु त्वं महीं हतनराकुलाम् ।\nक्रव्यादगणसंकीर्णां सेवितव्याममानुषैः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006386084, "chapter_id": 26386, "verse_number": "२-४३-८५", "content_sanskrit": "करवीरपुरं कृष्ण गच्छामः सबलानुगाः ।\nशृगालं वासुदेवं वै द्रक्ष्यामस्तत्र पार्थिवम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006386085, "chapter_id": 26386, "verse_number": "२-४३-८६", "content_sanskrit": "इमौ रथवरोदग्रौ युवयोः कारितौ मया ।\nयोजितौ शीघ्रतुरगैः स्वङ्गचक्राक्षकूबरौ ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006386086, "chapter_id": 26386, "verse_number": "२-४३-८७", "content_sanskrit": "शीघ्रमारुह भद्रं ते बलदेवसहायवान् ।\nत्वरामः करवीरस्थं द्रष्टुं तं वसुधाधिपम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006386087, "chapter_id": 26386, "verse_number": "२-४३-८८", "content_sanskrit": "वैशम्पायन उवाच\nपितृष्वसृपतेर्वाक्यं श्रुत्वा चेदिपतेस्तदा ।\nवाक्यं हृष्टमनाः कृष्णो जगाद जगतो गुरुः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006386088, "chapter_id": 26386, "verse_number": "२-४३-८९", "content_sanskrit": "अहो युद्धाभिसंतप्तौ देशकालोचितं त्वया ।\nबान्धवप्रतिरूपेण संसिक्तौ वचनाम्बुना ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006386089, "chapter_id": 26386, "verse_number": "२-४३-९०", "content_sanskrit": "देशकालविशिष्टस्य हितस्य मधुरस्य च ।\nवाक्यस्य दुर्लभा लोके वक्तारश्चेदिसत्तम ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006386090, "chapter_id": 26386, "verse_number": "२-४३-९१", "content_sanskrit": "चेदिनाथ सनाथौ स्वः संवृत्तौ तव दर्शनात् ।\nनावयोः किंचिदप्राप्यं ययोस्त्वं बन्धुरीदृशः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006386091, "chapter_id": 26386, "verse_number": "२-४३-९२", "content_sanskrit": "जरासंधस्य निधनं ये चान्ये तत्समा नृपाः ।\nपर्याप्तौ त्वत्सनाथौ स्वः कर्तुं चेदिकुलोद्वह ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006386092, "chapter_id": 26386, "verse_number": "२-४३-९३", "content_sanskrit": "यदूनां प्रथमो बन्धुस्त्वं हि सर्वमहीक्षिताम् ।\nअतः प्रभृति संग्रामान् द्रक्ष्यसे चेदिसत्तम ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006386093, "chapter_id": 26386, "verse_number": "२-४३-९४", "content_sanskrit": "चाक्रं मौसलमित्येवं संग्रामं रणवृत्तयः ।\nकथयिष्यन्ति लोकेऽस्मिन्ये धरिष्यन्ति पार्थिवाः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006386094, "chapter_id": 26386, "verse_number": "२-४३-९५", "content_sanskrit": "राज्ञां पराजयं युद्धे गोमन्तेऽचलसत्तमे ।\nश्रवणाद् धारणाद् वापि स्वर्गलोकं व्रजन्ति हि ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006386095, "chapter_id": 26386, "verse_number": "२-४३-९६", "content_sanskrit": "तद्गच्छाम महाराज करवीरं पुरोत्तमम् ।\nत्वयोद्दिष्टेन मार्गेण चेदिराज शिवाय वै ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006386096, "chapter_id": 26386, "verse_number": "२-४३-९७", "content_sanskrit": "ते स्यन्दनगताः सर्वे पवनोत्पातिभिर्हयैः ।\nभेजिरे दीर्घमध्वानं मूर्तिमन्त इवाग्नयः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006386097, "chapter_id": 26386, "verse_number": "२-४३-९८", "content_sanskrit": "ते त्रिरात्रोषिताः प्राप्ताः करवीरं पुरोत्तमम् ।\nशिवाय च शिवे देशे निविष्टास्त्रिदशोपमाः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}]