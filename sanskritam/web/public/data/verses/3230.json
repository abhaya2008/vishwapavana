[{"id": 2102869, "chapter_id": 3230, "verse_number": "१४-८६-१", "content_sanskrit": "वैशम्पायन उवाच।\nन्यवर्तत ततो वाजी येन नागाह्वयं पुरम्।\nतं निवृत्तं तु शुश्राव चारेणैव युधिष्ठिरः।\nश्रुत्वाऽर्जुनं कुशलिनं स च हृष्टमनाऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2102870, "chapter_id": 3230, "verse_number": "१४-८६-२", "content_sanskrit": "विजयस्य च तत्कर्म गान्धारविषये तदा।\nश्रुत्वा चान्येषु देशेषु स सुप्रीतोऽभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2102871, "chapter_id": 3230, "verse_number": "१४-८६-३", "content_sanskrit": "एतस्मिन्नेव काले तु द्वादशीं माघमासिकीम्।\nइष्टं गृहीत्वा नक्षत्रं धर्मराजो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2102872, "chapter_id": 3230, "verse_number": "१४-८६-४", "content_sanskrit": "समानीय महातेजाः सर्वान्भ्रातॄन्महीपतिः।\nभीमं च नकुलं चैव सहदेवं च कौरव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2102873, "chapter_id": 3230, "verse_number": "१४-८६-५", "content_sanskrit": "प्रोवाचेदं वचः काले तदा धर्मभृतांवरः।\nआमन्त्र्य वदतां श्रेष्ठो भीमं प्रहरतां वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2102874, "chapter_id": 3230, "verse_number": "१४-८६-६", "content_sanskrit": "आयाति भीमसेनासौ सहाश्वेन तवानुजः।\nयथा मे पुरुषाः प्राहुर्ये धनंजयसारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2102875, "chapter_id": 3230, "verse_number": "१४-८६-७", "content_sanskrit": "उपस्थितश्च कालोऽयमभितो वर्तते हयः।\nमाघी च पौर्णमासीयं मासः शेषो वृकोदर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2102876, "chapter_id": 3230, "verse_number": "१४-८६-८", "content_sanskrit": "तत्प्रस्थाप्यन्तु विद्वांसो ब्राह्मणा वेदपारगाः।\nवाजिमेधार्थसिद्ध्यर्थं देशं पश्यन्तु यज्ञियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2102877, "chapter_id": 3230, "verse_number": "१४-८६-९", "content_sanskrit": "इत्युक्तः स तु तच्चक्रे भीमो नृपतिशासनम्।\nहृष्टः श्रुत्वा गुडोकेशमायान्तं पुरुषर्षभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2102878, "chapter_id": 3230, "verse_number": "१४-८६-१०", "content_sanskrit": "ततो ययौ भीमसेनः प्राज्ञैः स्थपतिभिः सह।\nब्राह्मणानग्रतः कृत्वा कुशलान्यज्ञकर्मणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2102879, "chapter_id": 3230, "verse_number": "१४-८६-११", "content_sanskrit": "तं ससालचयं श्रीमत्सप्रतोलीसुघट्टितम्।\nमापयामास कौरव्यो यज्ञवाटं यताविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2102880, "chapter_id": 3230, "verse_number": "१४-८६-१२", "content_sanskrit": "प्रासादशतसम्बन्धं मणिप्रवरकुट्टिमम्।\n`सदः स पत्नीसदनं साग्नीध्रमपि चोत्तरम्।\nकारयामास विदिवद्धेमरत्नविभूषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2102881, "chapter_id": 3230, "verse_number": "१४-८६-१३", "content_sanskrit": "स्तंभान्कनकचित्रांश्च तोरणानि बृहन्ति च।\nयज्ञायतनदेशेशु दत्त्वा शुद्धं च काञ्चनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2102882, "chapter_id": 3230, "verse_number": "१४-८६-१४", "content_sanskrit": "अन्तःपुराणां राज्ञां च नानादेशसमीयुषाम्।\nकारयामास धर्मात्मा तत्रतत्र यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2102883, "chapter_id": 3230, "verse_number": "१४-८६-१५", "content_sanskrit": "ब्राह्मणानां न वेश्मानि नानादेशसमीयुषाम्।\nकारयामास कौन्तेयो विधिवत्तान्यनेकशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2102884, "chapter_id": 3230, "verse_number": "१४-८६-१६", "content_sanskrit": "तथा सम्प्रेषयामास दूतान्नृपतिशासनात्।\nभीमसेनो महाबाहो राज्ञामक्लिष्टकर्मणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2102885, "chapter_id": 3230, "verse_number": "१४-८६-१७", "content_sanskrit": "ते प्रियार्थं कुरुपतेराययुर्नृपसत्तम।\nरत्नान्यनेकान्यादाय स्त्रियोऽश्वानायुधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2102886, "chapter_id": 3230, "verse_number": "१४-८६-१८", "content_sanskrit": "तेषां निर्विशतां तेषु शिबिरेषु महात्मनाम्।\nनर्दतः सागरस्येव दिवस्पृगभवत्स्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2102887, "chapter_id": 3230, "verse_number": "१४-८६-१९", "content_sanskrit": "`प्रत्युद्गम्य नमस्कृत्य ब्राह्मणांश्च न्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2102888, "chapter_id": 3230, "verse_number": "१४-८६-२०", "content_sanskrit": "तेषामभ्यागतानां च स राजा कुरुवर्धनः।\nव्यादिदेशान्नपानानि शय्याश्चाप्यतिमानुषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2102889, "chapter_id": 3230, "verse_number": "१४-८६-२१", "content_sanskrit": "वाहनानां च विविधाः शालाः शालीक्षुगोरसैः।\nउपेता भरतश्रेष्ठो व्यादिदेश स धर्मराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2102890, "chapter_id": 3230, "verse_number": "१४-८६-२२", "content_sanskrit": "`वर्णाः पृथक्सन्निविष्टा ह्युत्तरोत्तरपूजिताः।\nतथा तस्मिन्महायज्ञे धर्मराजस्य धीमतः।\nसमाजग्मुर्मुनिगणा बहवो ब्रह्मवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2102891, "chapter_id": 3230, "verse_number": "१४-८६-२३", "content_sanskrit": "ये च द्विजातिप्रवरास्तत्रासन्पृथिवीपते।\nसमाजग्मुः सशिष्यांस्तान्प्रतिजग्राह कौरवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2102892, "chapter_id": 3230, "verse_number": "१४-८६-२४", "content_sanskrit": "सर्वांश्च ताननुययौ यावदावसथान्प्रति।\nस्वयमेव महातेजा दंभं त्यक्त्वा युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2102893, "chapter_id": 3230, "verse_number": "१४-८६-२५", "content_sanskrit": "ततः कृत्वा स्थपतयः शिल्पिनोऽन्ये च ये तदा।\nकृत्स्नं यज्ञविधिं राजन्धर्मराजे न्यवेदयन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2102894, "chapter_id": 3230, "verse_number": "१४-८६-२६", "content_sanskrit": "तच्छ्रुत्वा धर्मराजस्तु कृतं सर्वमतन्द्रितः।\nहृष्टरूपोऽभवद्राजन्सह भ्रातृभिरादृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2102895, "chapter_id": 3230, "verse_number": "१४-८६-२७", "content_sanskrit": "तस्मिन्यज्ञे प्रवृत्ते तु वाग्मिनो हेतुवादिनः।\nहेतुवादान्बहूनाहुः परस्परजिगीषवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2102896, "chapter_id": 3230, "verse_number": "१४-८६-२८", "content_sanskrit": "ददृशुस्तं नृपतयो यज्ञस्य विधिमुत्तमम्।\nदेवेन्द्रस्येव विहितं भीमसेनेन भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2102897, "chapter_id": 3230, "verse_number": "१४-८६-२९", "content_sanskrit": "ददृशुस्तोरणान्यत्र शातकुंभमयानि ते।\nशय्यासनविहारांश्च सुबहून्रत्नसंचयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2102898, "chapter_id": 3230, "verse_number": "१४-८६-३०", "content_sanskrit": "घटान्पात्रीः कटाहानि कलशान्वर्धमानकान्।\nन हि किञ्चिदसौवर्णमपश्यन्वसुधाधिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2102899, "chapter_id": 3230, "verse_number": "१४-८६-३१", "content_sanskrit": "यूपांश्च शास्त्रपठितान्दारवान्हेमभूषितान्।\nउपक्लृप्तान्यथाकालं विधिवद्भूरिवर्चसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2102900, "chapter_id": 3230, "verse_number": "१४-८६-३२", "content_sanskrit": "स्थलजाक जलजा ये च पशवः केचन प्रभो।\nसर्वानेव समानीतानपश्यंस्तत्र ते नृपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2102901, "chapter_id": 3230, "verse_number": "१४-८६-३३", "content_sanskrit": "गाश्चैव महिषीश्चैव तथा वृद्धस्त्रियोपि च।\nऔदकानि च सत्वानि श्वापदानि वयांसि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2102902, "chapter_id": 3230, "verse_number": "१४-८६-३४", "content_sanskrit": "जरायुजाण्डजातानि स्वेदजान्युद्भिदानि च।\nपर्वतानूपजातानि भूतानि ददृशुश्च ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2102903, "chapter_id": 3230, "verse_number": "१४-८६-३५", "content_sanskrit": "एवं प्रमुदितं सर्वं पशुगोधनधान्यतः।\nयज्ञवाटं नृपा दृष्ट्वा परं विस्मयमागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2102904, "chapter_id": 3230, "verse_number": "१४-८६-३६", "content_sanskrit": "`अनिशं दीयते च स्म तत्र भोज्यं पृथग्विधम्॥\nब्राह्मणानां विशां चैव बहुमृष्टान्नमृद्धिमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2102905, "chapter_id": 3230, "verse_number": "१४-८६-३७", "content_sanskrit": "पूर्णे शतसहस्रे तु विप्राणां तत्रि भुञ्जताम्।\nदुन्दुभिर्मेघनिर्घोषो मुहुर्मुहुरताड्यत।\nविननादासकृच्चापि दिवसेदिवसे गते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2102906, "chapter_id": 3230, "verse_number": "१४-८६-३८", "content_sanskrit": "एवं स ववृते यज्ञो धर्मराजस्य धीमतः।\nअन्नस्य सुबहून्राजन्नुत्सर्गान्पर्वतोपमान्।\nदधिकुल्याशअच ददृशुः सर्पिषश्च ह्रदाञ्जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2102907, "chapter_id": 3230, "verse_number": "१४-८६-३९", "content_sanskrit": "जंबूद्वीपो हि सकलो नानजनपदायुतः।\nराजन्नदृस्यतैकस्थो राज्ञस्तस्य महामखे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2102908, "chapter_id": 3230, "verse_number": "१४-८६-४०", "content_sanskrit": "तत्र जातिसहस्राणि पुरुषाणां ततस्ततः।\nगृहीत्वा धमाजग्मुर्बहूनि भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2102909, "chapter_id": 3230, "verse_number": "१४-८६-४१", "content_sanskrit": "स्रग्विणश्तापि ते सर्वे सुमुष्टमणिकुण्डलाः।\nपर्यवेषन्द्विजातींस्ताञ्शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2102910, "chapter_id": 3230, "verse_number": "१४-८६-४२", "content_sanskrit": "विविधान्यन्नपानानि पुरुषा येऽनुयायिनः।\nते वै नृपोपभोज्यानि ब्राह्मणानां ददुश्च ह॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2102911, "chapter_id": 3230, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि षडशीतितमोऽध्यायः॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]