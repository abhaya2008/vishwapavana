[{"id": 2158304, "chapter_id": 4428, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2158305, "chapter_id": 4428, "verse_number": "१", "content_sanskrit": "समरे तूग्रकर्माणः कर्मभिर्व्यञ्जितश्रमाः ।\nसकृष्णाः पाण्डवाः पञ्च देवैरपि दुरासदाः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2158306, "chapter_id": 4428, "verse_number": "२", "content_sanskrit": "शश्वत् कर्मान्वयैर्बुद्ध्या प्रकृत्या यशसा श्रिया ।\nन भूतो भविता वाऽपि कृष्णस्य सदृशः पुमान्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2158307, "chapter_id": 4428, "verse_number": "३", "content_sanskrit": "सत्यधर्मतपोदानैर्विप्रपूजादिभिर्गुणैः ।\nसदेहस्त्रिदिवं प्राप्तो राजा किल युधिष्ठिरः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2158308, "chapter_id": 4428, "verse_number": "४", "content_sanskrit": "युगान्ते चान्तको राजन् जामदग्न्यश्च कीर्तिमान् ।\nरणस्थो भीमसेनश्च कथ्यन्ते सदृशास्त्रयः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2158309, "chapter_id": 4428, "verse_number": "५", "content_sanskrit": "प्रतिज्ञाकर्मदक्षस्य रणे गाण्डीवधन्वनः ।\nउपमां नाधिगच्छामि पार्थस्य सदृशीं क्षितौ\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2158310, "chapter_id": 4428, "verse_number": "६", "content_sanskrit": "गुरुवात्सल्यमत्यन्तं नैभृत्यं विनयो दमः ।\nनकुले प्रातिरूप्यं च शौर्यं च नियतानि षट्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2158311, "chapter_id": 4428, "verse_number": "७", "content_sanskrit": "श्रुतगाम्भीर्यमाधुर्यसत्त्वरूपपराक्रमैः ।\nसदृशो देवयोर्वीरः सहदेवः किलाश्विनोः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2158312, "chapter_id": 4428, "verse_number": "८", "content_sanskrit": "ये च कृष्णे गुणाः स्फीताः पाण्डवेयेषु ये गुणाः ।\nअभिमन्यौ किलैकस्था दृश्यन्ते ते गुणाः शुभाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2158313, "chapter_id": 4428, "verse_number": "९", "content_sanskrit": "युधिष्ठिरस्य धैर्येण कृष्णस्य चरितेन च ।\nकर्मणा भीमसेनस्य सदृशं भीमकर्मणः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2158314, "chapter_id": 4428, "verse_number": "१०", "content_sanskrit": "धनञ्जयस्य रूपेण विक्रमेण श्रुतेन च ।\nविनये सहदेवस्य सदृशं नकुलस्य च\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2158315, "chapter_id": 4428, "verse_number": "११", "content_sanskrit": "अभिमन्युं द्विजश्रेष्ठ सौभद्रमपराजितम् ।\nश्रोतुमिच्छामि कार्त्स्न्येन कथमायोधने हतः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2158316, "chapter_id": 4428, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2158317, "chapter_id": 4428, "verse_number": "१२", "content_sanskrit": "अभिमन्युं हतं श्रुत्वा धृतराष्ट्रो जनेश्वरः ।\nविस्तरेण महाराज पर्यपृच्छत् स सञ्जयम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2158318, "chapter_id": 4428, "verse_number": "१३", "content_sanskrit": "अभिमन्युं हतं सूत सौभद्रमपराजितम् ।\nश्रोतुमिच्छामि कार्त्स्न्येन कथमायोधनैः हतः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2158319, "chapter_id": 4428, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2158320, "chapter_id": 4428, "verse_number": "१४", "content_sanskrit": "स्थिरो भव महाराज शोकं धारय दुर्धरम् ।\nमहान्तं बन्धुनाशं ते कथयिष्यामि तच्छृणु\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2158321, "chapter_id": 4428, "verse_number": "१५", "content_sanskrit": "पुत्रं पुरुषसिंहस्य सञ्जयाप्राप्तयौवनम् ।\nरणे निपतितं श्रुत्वा दृढं मे दूयते मनः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2158322, "chapter_id": 4428, "verse_number": "१६", "content_sanskrit": "दारुणः क्षत्रधर्मोऽयं विहितो धर्मकर्तृभिः ।\nयत्र राज्येप्सवः शूरा बाले शस्त्रमपातयन्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2158323, "chapter_id": 4428, "verse_number": "१७", "content_sanskrit": "बालमत्यन्तसुखिनं प्रहरन्तमभीतवत् ।\nकृतास्त्रा बहवो जघ्नुर्ब्रूहि गावल्गणे कथम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2158324, "chapter_id": 4428, "verse_number": "१८", "content_sanskrit": "बिभित्सता तदाऽनीकं सौभद्रेणामितौजसा ।\nचिक्रीडितं यथा सङ्खे तन्ममाचक्ष्व सञ्जय\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2158325, "chapter_id": 4428, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2158326, "chapter_id": 4428, "verse_number": "१९", "content_sanskrit": "यन्मां पृच्छसि सङ्ग्रामे सौभद्रं विनिपातितम् ।\nतत् तेऽहं सम्प्रवक्ष्यामि शृणु राजन् समाहितः\nविक्रीडितं कुमारस्य यथाऽनीकं बिभित्सतः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2158327, "chapter_id": 4428, "verse_number": "२०", "content_sanskrit": "दवाग्न्यभिपरीतानां भूरिगुल्मतृणद्रुमे ।\nवनौकसामिवारण्ये त्वदीयानामभूद् भयम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2158328, "chapter_id": 4428, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां द्रोणपर्वणि त्रयस्त्रिंशोऽध्यायः ॥ ३३ ॥\nअभिमन्युवधपर्वणि द्वितीयोऽध्यायः ॥ २ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]