[{"id": 40013625, "chapter_id": 9176, "verse_number": "1", "content_sanskrit": "ततस्तु शिंशुपामूले जानकीं पर्युपस्थिताम्। अभिवाद्याब्रवीद्दिष्ट्या पश्यामि त्वामिहाक्षताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40013626, "chapter_id": 9176, "verse_number": "2", "content_sanskrit": "ततस्तं प्रस्थितं सीता वीक्षमाणा पुनः पुनः। भर्तृस्नेहान्वितं वाक्यं हनुमन्तमभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40013627, "chapter_id": 9176, "verse_number": "3", "content_sanskrit": "काममस्य त्वमेवैकः कार्यस्य परिसाधने। पर्याप्तः परवीरघ्न यशस्यस्ते बलोदयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40013628, "chapter_id": 9176, "verse_number": "4", "content_sanskrit": "शरैस्तु सङ्कुलां कृत्वा लङ्कां परबलार्दनः। मां नयेद्यदि काकुत्स्थस्तत्तस्य सदृशं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40013629, "chapter_id": 9176, "verse_number": "5", "content_sanskrit": "तद्यथा तस्य विक्रान्तमनुरूपं महात्मनः। भवत्याहवशूरस्य तथा त्वमुपपादय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40013630, "chapter_id": 9176, "verse_number": "6", "content_sanskrit": "तदर्थोपहितं वाक्यं प्रश्रितं हेतुसंहितम्। निशम्य हनुमांस्तस्या वाक्यमुत्तरमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40013631, "chapter_id": 9176, "verse_number": "7", "content_sanskrit": "क्षिप्रमेष्यति काकुत्स्थः हर्यृक्षप्रवरैर्वृतः। यस्ते युधि विजित्यारीन् शोकं व्यपनयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40013632, "chapter_id": 9176, "verse_number": "8", "content_sanskrit": "एवमाश्वास्य वैदेहीं हनुमान् मारुतात्मजः। गमनाय मतिं कृत्वा वैदेहीमभ्यवादयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40013633, "chapter_id": 9176, "verse_number": "9", "content_sanskrit": "ततस्स कपिशार्दूलः स्वामिसन्दर्शनोत्सुकः। आरुरोह गिरिश्रेष्ठमरिष्टमरिमर्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40013634, "chapter_id": 9176, "verse_number": "10", "content_sanskrit": "तुङ्गपद्मकजुष्टाभिर्नीलाभिर्वनराजिभिः। सोत्तरीयमिवाम्भोदैः शृंगान्तरविलम्बिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40013635, "chapter_id": 9176, "verse_number": "11", "content_sanskrit": "बोध्यमानमिव प्रीत्या दिवाकरकरैश्शुभैः। उन्मिषन्तमिवोद्धूतैर्लोचनैरिव धातुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40013636, "chapter_id": 9176, "verse_number": "12", "content_sanskrit": "तोयौघननिस्स्वनैर्मन्द्रैः प्राधीतमिव पर्वतम्। प्रगीतमिव विस्पष्टैर्नानाप्रस्रवणस्वनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40013637, "chapter_id": 9176, "verse_number": "13", "content_sanskrit": "देवदारुभिरत्युच्चैरूर्ध्वबाहुमिव स्थितम्। प्रपातजलनिर्घोषैः प्राक्रुष्टमिव सर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40013638, "chapter_id": 9176, "verse_number": "14", "content_sanskrit": "वेपमानमिव श्यामैः कम्पमानैश्शरद्वनैः। वेणुभिर्मारुतोद्धूतैः कूजन्तमिव कीचकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40013639, "chapter_id": 9176, "verse_number": "15", "content_sanskrit": "निश्श्वसन्तमिवामर्षाद्घोरैराशीविषोत्तमैः। नीहारकृतगम्भीरैर्ध्यायन्तमिव गह्वरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40013640, "chapter_id": 9176, "verse_number": "16", "content_sanskrit": "मेघपादनिभैः पादैः प्रक्रान्तमिव सर्वतः। जृंम्भमाणमिवाऽकाशे शिखरैरभ्रमालिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40013641, "chapter_id": 9176, "verse_number": "17", "content_sanskrit": "कूटैश्च बहुधा कीर्णैश्शोभितं बहुकन्दरैः। सालतालाश्वकर्णैश्च वंशैश्च बहुभिर्वृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40013642, "chapter_id": 9176, "verse_number": "18", "content_sanskrit": "लतावितानैर्विततैः पुष्पवद्भिरलङ्कृतम्। नानामृगगणाकीर्णं धातुनिष्यन्दभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40013643, "chapter_id": 9176, "verse_number": "19", "content_sanskrit": "बहुप्रस्रवणोपेतं शिलासञ्चयसङ्कटम्। महर्षियक्षगन्धर्वकिन्नरोरगसेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40013644, "chapter_id": 9176, "verse_number": "20", "content_sanskrit": "लतापादपसङ्घातं सिंहाध्युषितकन्दरम्। व्याघ्रसङ्घसमाकीर्णं स्वादुमूलफलद्रुमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40013645, "chapter_id": 9176, "verse_number": "21", "content_sanskrit": "तमारुरोह हनुमान् पर्वतं पवनात्मजः। रामदर्शनशीघ्रेण प्रहर्षेणाभिचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40013646, "chapter_id": 9176, "verse_number": "22", "content_sanskrit": "तेन पादतलाक्रान्ता रम्येषु गिरिसानुषु। सघोषास्समशीर्यन्त शिलाश्चूर्णीकृतास्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40013647, "chapter_id": 9176, "verse_number": "23", "content_sanskrit": "स तमारुह्य शैलेन्द्रं व्यवर्धत महाकपिः। दक्षिणादुत्तरं पारं प्रार्थयन् लवणाम्भसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40013648, "chapter_id": 9176, "verse_number": "24", "content_sanskrit": "अधिरुह्य ततो वीरः पर्वतं पवनात्मजः। ददर्श सागरं भीमं मीनोरगनिषेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40013649, "chapter_id": 9176, "verse_number": "25", "content_sanskrit": "स मारुत इवाऽकाशं मारुतस्यात्मसम्भवः। प्रपेदे हरिशार्दूलो दक्षिणादुत्तरां दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40013650, "chapter_id": 9176, "verse_number": "26", "content_sanskrit": "स तदा पीडितस्तेन कपिना पर्वतोत्तमः। ररास सह तैर्भूतैः प्रविशन्वसुधातलम् ॥ कम्पमानैश्च शिखरैः पतद्भिरपि च द्रुमैः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40013651, "chapter_id": 9176, "verse_number": "27", "content_sanskrit": "तस्योरुवेगोन्मथिताः पादपाः पुष्पशालिनः ॥ निपेतुर्भूतले रुग्णाश्शक्रायुधहता इव।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40013652, "chapter_id": 9176, "verse_number": "28", "content_sanskrit": "कन्दरान्तरसंस्थानां पीडितानां महौजसाम् ॥ सिंहानां निनदो भीमो नभो भिन्दन् स शुश्रुवे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40013653, "chapter_id": 9176, "verse_number": "29", "content_sanskrit": "त्रस्तव्यावृत्तवसना व्याकुलीकृतभूषणाः ॥ विद्याधर्यः समुत्पेतुस्सहसा धरणीधरात्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40013654, "chapter_id": 9176, "verse_number": "30", "content_sanskrit": "अतिप्रमाणा बलिनो दीप्तजिह्वा महाविषाः ॥ निपीडितशिरोग्रीवा व्यचेष्टन्त महाहयः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40013655, "chapter_id": 9176, "verse_number": "31", "content_sanskrit": "किन्नरोरगन्धर्वयक्षविद्याधरास्तदा ॥ पीडितं तं नगवरं त्यक्त्वा गगनमास्थिता:।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40013656, "chapter_id": 9176, "verse_number": "32", "content_sanskrit": "स च भूमिधरः श्रीमान्बलिना तेन पीडितः ॥ सवृक्षशिखरोदग्रः प्रविवेश रसातलम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40013657, "chapter_id": 9176, "verse_number": "33", "content_sanskrit": "दशयोजनविस्तारस्त्रिंशद्योजनमुच्छ्रितः ॥ धरण्यां समतां यातः स बभूव धराधरः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40013658, "chapter_id": 9176, "verse_number": "34", "content_sanskrit": "स लिलङ्घयिषुर्भीमं सलीलं लवणार्णवम् ॥ कल्लोलास्फालवेलान्तमुत्पपात नभो हरिः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]