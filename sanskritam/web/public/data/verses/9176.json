[{"id": 5000176000, "chapter_id": 9176, "verse_number": "२-९९-१", "content_sanskrit": "निविष्टायां तु सेनायामुत्सुको भरतस्तदा।\nजगाम भ्रातरं द्रष्टुं शत्रुध्नमनुदर्शयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000176001, "chapter_id": 9176, "verse_number": "२-९९-२", "content_sanskrit": "ऋषिं वसिष्ठं सन्दिश्य मातऽर्मे शीघ्रमानय।\nइति त्वरितमग्रे स जगाम गुरुवत्सल: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000176002, "chapter_id": 9176, "verse_number": "२-९९-३", "content_sanskrit": "सुमन्त्रस्त्वपि शत्रुघ्नमदूरादन्वपद्यत।\nरामदर्शनजस्तर्षो भरतस्येव तस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000176003, "chapter_id": 9176, "verse_number": "२-९९-४", "content_sanskrit": "गच्छन्नेवाथ भरतस्तापसालयसंस्थिताम्।\nभ्रातु: पर्णकुटीं श्रीमानुटजं च ददर्श ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000176004, "chapter_id": 9176, "verse_number": "२-९९-५", "content_sanskrit": "शालायास्त्वग्रतस्तस्या ददर्श भरतस्तदा।\nकाष्ठानि चावभग्नानि पुष्पाण्युपचितानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000176005, "chapter_id": 9176, "verse_number": "२-९९-६", "content_sanskrit": "सलक्ष्मणस्य रामस्य ददर्शाश्रममीयुष:।\nकृतं वृक्षेष्वभिज्ञानं कुशचीरै: क्वचित् क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000176006, "chapter_id": 9176, "verse_number": "२-९९-७", "content_sanskrit": "ददर्श च वने तस्मिन् महत: सञ्चयान् कृतान्।\nमृगाणां महिषाणां च कऺरीषै: शीतकारणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000176007, "chapter_id": 9176, "verse_number": "२-९९-८", "content_sanskrit": "गच्छन्नेव महाबाहुर्द्युतिमान् भरतस्तदा।\nशत्रुघ्नं चाब्रवीद्धृष्टस्तानमात्यांश्च सर्वश: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000176008, "chapter_id": 9176, "verse_number": "२-९९-९", "content_sanskrit": "मन्ये प्राप्ता: स्म तं देशं भरद्वाजो यमब्रवीत्।\nनातिदूरे हि मन्येऽहं नदीं मन्दाकिनीमित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000176009, "chapter_id": 9176, "verse_number": "२-९९-१०", "content_sanskrit": "उच्चैर्बद्धानि चीराणि लक्ष्मणेन भवेदयम्।\nअभिज्ञानकृत: पन्था विकाले गन्तुमिच्छता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000176010, "chapter_id": 9176, "verse_number": "२-९९-११", "content_sanskrit": "इदं चोदात्तदन्तानां कुञ्जराणां तरस्विनाम्।\nशैलपार्श्वे परिक्रान्तमन्योन्यमभिगर्जताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000176011, "chapter_id": 9176, "verse_number": "२-९९-१२", "content_sanskrit": "यमेवाधातुमिच्छन्ति तापसा: सततं वने।\nतस्यासौ दृश्यते धूम: सङ्कुल: कृष्णवर्त्मन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000176012, "chapter_id": 9176, "verse_number": "२-९९-१३", "content_sanskrit": "अत्राहं पुरुषव्याघ्रं गुरुसंस्कारकारिणम्।\nआर्यं द्रक्ष्यामि संहृष्टो महर्षिमिव राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000176013, "chapter_id": 9176, "verse_number": "२-९९-१४", "content_sanskrit": "अथ गत्वा मुहूर्तं तु चित्रकूटं स राघव:।\nमन्दाकिनीमनुप्राप्तस्तं जनं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000176014, "chapter_id": 9176, "verse_number": "२-९९-१५", "content_sanskrit": "जगत्यां पुरुषव्याघ्र आस्ते वीरासने रत:।\nजनेन्द्रो निर्जनं प्राप्य धिङ्मे जन्म सजीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000176015, "chapter_id": 9176, "verse_number": "२-९९-१६", "content_sanskrit": "मत्कृते व्यसनं प्राप्तो लोकनाथो महाद्युति:।\nसर्वान् कामान् परित्यज्य वने वसति राघव: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000176016, "chapter_id": 9176, "verse_number": "२-९९-१७", "content_sanskrit": "इति लोकसमाक्रुष्ट: पादेष्वद्य प्रसादयन्।\nरामस्य निपतिष्यामि सीताया लक्ष्मणस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000176017, "chapter_id": 9176, "verse_number": "२-९९-१८", "content_sanskrit": "एवं स विलपंस्तस्मिन् वने दशरथात्मज:।\nददर्श महतीं पुण्यां पर्णशालां मनोरमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000176018, "chapter_id": 9176, "verse_number": "२-९९-१९", "content_sanskrit": "सालतालाश्वकर्णानां पर्णैर्बहुभिरावृताम्।\nविशालां मृदुभिस्तीर्णां कुशैर्वेदिमिवाध्वरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000176019, "chapter_id": 9176, "verse_number": "२-९९-२०", "content_sanskrit": "शक्रायुधनिकाशैश्च कार्मुकैर्भारसाधनै:।\nरुक्मपृष्टष्ठैर्महासारै: शोभितां शत्रुबाधकै: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000176020, "chapter_id": 9176, "verse_number": "२-९९-२१", "content_sanskrit": "अर्करश्मिप्रतीकाशैर्घोरैस्तूणीगतै: शरै:।\nशोभितां दीप्तवदनै: सर्प्पैर्भोगवतीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000176021, "chapter_id": 9176, "verse_number": "२-९९-२२", "content_sanskrit": "महारजतवासोभ्यामसिभ्यां च विराजिताम्।\nरुक्मबिन्दुविचित्राभ्यां चर्मभ्यां चापि शोभिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000176022, "chapter_id": 9176, "verse_number": "२-९९-२३", "content_sanskrit": "गोधाङ्गुलित्रैरासक्तैश्चित्रै: काञ्चनभूषितै:।\nअरिसङ्घैरनाधृष्यां मृगै: सिंहगुहामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000176023, "chapter_id": 9176, "verse_number": "२-९९-२४", "content_sanskrit": "प्रागुदक्प्रवणां वेदिं विशालां दीप्तपावकाम्।\nददर्श भरतस्तत्र पुण्यां रामनिवेशने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000176024, "chapter_id": 9176, "verse_number": "२-९९-२५", "content_sanskrit": "निरीक्ष्य स मुहूर्त्तं तु ददर्श भरतो गुरम्।\nउटजे राममासीनं जटामण्डलधारिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000176025, "chapter_id": 9176, "verse_number": "२-९९-२६", "content_sanskrit": "तं तु कृष्णाजिनधरं चीरवल्कलवाससम्।\nददर्श राममासीनमभित: पावकोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000176026, "chapter_id": 9176, "verse_number": "२-९९-२७", "content_sanskrit": "सिंहस्कन्धं महाबाहुं पुण्डरीकनिभेक्षणम्।\nपृथिव्या: सागरान्ताया भर्त्तारं धर्मचारिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000176027, "chapter_id": 9176, "verse_number": "२-९९-२८", "content_sanskrit": "उपविष्टं महाबाहुं ब्रह्माणमिव शाश्वतम्।\nस्थण्डिले दर्भसंस्तीर्णे सीतया लक्ष्मणेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000176028, "chapter_id": 9176, "verse_number": "२-९९-२९", "content_sanskrit": "तं दृष्ट्वा भरत: श्रीमान् दु:खशोकपरिप्लुत:।\nअभ्यधावत धर्मात्मा भरत: कैकयीसुत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000176029, "chapter_id": 9176, "verse_number": "२-९९-३०", "content_sanskrit": "दृष्ट्वैव विललापार्त्तो बाष्पसन्दिग्धया गिरा।\nअशक्नुवन् धारयितुं धैर्याद्वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000176030, "chapter_id": 9176, "verse_number": "२-९९-३१", "content_sanskrit": "य: संसदि प्रकृतिभिर्भवेद्युक्त उपासितुम्।\nवन्यैर्मृगैरुपासीन: सोऽयमास्ते ममाग्रज: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000176031, "chapter_id": 9176, "verse_number": "२-९९-३२", "content_sanskrit": "वासोभिर्बहुसाहस्रैर्यो महात्मा पुरोचित:।\nमृगाजिने सोऽयमिह प्रवस्ते धर्ममाचरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000176032, "chapter_id": 9176, "verse_number": "२-९९-३३", "content_sanskrit": "अधारयद्यो विविधाश्चित्रा: सुमनसस्तदा\nसोऽयं जटाभारमिमं वहते राघव: कथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000176033, "chapter_id": 9176, "verse_number": "२-९९-३४", "content_sanskrit": "यस्य यज्ञैर्यथोद्दिष्टैर्युक्तो धर्मस्य सञ्चय:।\nशरीरक्लेशसम्भूतं स धर्मं परिमार्गते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000176034, "chapter_id": 9176, "verse_number": "२-९९-३५", "content_sanskrit": "चन्दनेन महार्हेण यस्याङ्गमुपसेवितम्।\nमलेन तस्याङ्गमिदं कथमार्यस्य सेव्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000176035, "chapter_id": 9176, "verse_number": "२-९९-३६", "content_sanskrit": "मन्निमित्तमिदं दु:खं प्राप्तो राम: सुखोचित:।\nधिग्जीवितं नृशंसस्य मम लोकविगर्हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000176036, "chapter_id": 9176, "verse_number": "२-९९-३७", "content_sanskrit": "इत्येवं विलपन् दीन: प्रस्विन्नमुखपङ्कज:।\nपादावप्राप्य रामस्य पपात भरतो रुदन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000176037, "chapter_id": 9176, "verse_number": "२-९९-३८", "content_sanskrit": "दु:खाभितप्तो भरतो राजपुत्रो महाबल:।\nउक्त्वार्येति सकृद्दीनं पुनर्नोवाच किञ्चन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000176038, "chapter_id": 9176, "verse_number": "२-९९-३९", "content_sanskrit": "बाष्पापिहितकण्ठश्च प्रेक्ष्य रामं यशस्विनम्।\nआर्येत्येवाथ संक्रुश्य व्याहर्त्तुं नाशकत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000176039, "chapter_id": 9176, "verse_number": "२-९९-४०", "content_sanskrit": "शत्रुघ्नश्चापि रामस्य ववन्दे चरणौ रुदन्।\nतावुभौ स समालिङ्ग्य रामश्चाश्रूण्यवर्त्तयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000176040, "chapter_id": 9176, "verse_number": "२-९९-४१", "content_sanskrit": "तत: सुमन्त्रेण गुहेन चैव समीयतू राजसुतावरण्ये।\nदिवाकरश्चैव निशाकरश्च यथाम्बरे शुक्रबृहस्पतिभ्याम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000176041, "chapter_id": 9176, "verse_number": "२-९९-४२", "content_sanskrit": "तान् पार्थिवान् वारणयूथपाभान् समागतांस्तत्र महत्यरण्ये।\nवनौकसस्तेऽपि समीक्ष्य सर्वेप्यश्रूण्यमुञ्चन् प्रविहाय हर्षम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000176042, "chapter_id": 9176, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदयोध्याकाण्डे एकोनशततम: सर्ग: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]