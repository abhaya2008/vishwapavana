[{"id": 6000061000, "chapter_id": 10061, "verse_number": null, "content_sanskrit": "अथ एकत्रिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "कपिलेन देवहूतिं प्रति विरक्तिजननाय विषयासक्तानां नरकयातनाद्यनुभवप्रकारवर्णनम्", "range": null}]}, {"id": 6000061001, "chapter_id": 10061, "verse_number": null, "content_sanskrit": "भगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.001.m4a", "display_order": 2}, {"id": 6000061002, "chapter_id": 10061, "verse_number": "३-३१-१", "content_sanskrit": "तस्यैतस्य जनो नूनं नायं वेदोरुविक्रमम्।\nकाल्यमानोऽपि बलिना वायोरिव घनावलिः॥ ३/३१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.002.m4a", "display_order": 3}, {"id": 6000061003, "chapter_id": 10061, "verse_number": "३-३१-२", "content_sanskrit": "यं यमर्थमुपादत्ते दुःखेन सुखहेतवे।\nतं तं धुनोति भगवान् पुमाञ्छोचति यत्कृते॥ ३/३१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.003.m4a", "display_order": 4}, {"id": 6000061004, "chapter_id": 10061, "verse_number": "३-३१-३", "content_sanskrit": "यदध्रुवस्य देहस्य सानुबन्धस्य दुर्मतिः।\nध्रुवाणि मन्यते मोहाद् गृहक्षेत्रवसूनि च॥ ३/३१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.004.m4a", "display_order": 5}, {"id": 6000061005, "chapter_id": 10061, "verse_number": "३-३१-४", "content_sanskrit": "जन्तुर्वै भव एतस्मिन् यां यां योनिमुपव्रजेत्।\nतस्यां तस्यां स लभते निर्वृतिं न विरज्यते॥ ३/३१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.005.m4a", "display_order": 6}, {"id": 6000061006, "chapter_id": 10061, "verse_number": "३-३१-५", "content_sanskrit": "नरकस्थोऽपि देहं वै न पुमांस्त्यक्तुमिच्छति।\nनारक्यां निर्वृतौ सत्यां देवमायाविमोहितः॥ ३/३१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.006.m4a", "display_order": 7}, {"id": 6000061007, "chapter_id": 10061, "verse_number": "३-३१-६", "content_sanskrit": "आत्मजायासुतागारपशुद्रविणबन्धुषु।\nनिरूढमूलहृदय आत्मानं बहुमन्यते॥ ३/३१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.007.m4a", "display_order": 8}, {"id": 6000061008, "chapter_id": 10061, "verse_number": "३-३१-७", "content_sanskrit": "सन्दह्यमानसर्वाङ्ग एषामुद्वहनादिना।\nकरोत्यविरतं मूढो दुरितानि दुराशयः॥ ३/३१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.008.m4a", "display_order": 9}, {"id": 6000061009, "chapter_id": 10061, "verse_number": "३-३१-८", "content_sanskrit": "आक्षिप्तात्मेन्द्रियः स्‍त्रीणामसतीनां च मायया।\nरहोरचितसल्लापैः शिशूणां कलभाषणैः॥ ३/३१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.009.m4a", "display_order": 10}, {"id": 6000061010, "chapter_id": 10061, "verse_number": "३-३१-९", "content_sanskrit": "गृहेषु कूटधर्मेषु दुःखतन्त्रेष्वतन्द्रितः।\nकुर्वन् दुःखप्रतीकारं सुखवन्मन्यते गृही॥ ३/३१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.010.m4a", "display_order": 11}, {"id": 6000061011, "chapter_id": 10061, "verse_number": "३-३१-१०", "content_sanskrit": "अर्थैरापादितैर्गुर्व्या हिंसयेतस्ततश्च तान्।\nपुष्णाति येषां पोषेण शेषभुग् यात्यधः स्वयम्॥ ३/३१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.011.m4a", "display_order": 12}, {"id": 6000061012, "chapter_id": 10061, "verse_number": "३-३१-११", "content_sanskrit": "वार्तायां लुप्यमानायामारब्धायां पुनः पुनः।\nलोभाभिभूतो निःसत्त्वः परार्थे कुरुते स्पृहाम्॥ ३/३१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.012.m4a", "display_order": 13}, {"id": 6000061013, "chapter_id": 10061, "verse_number": "३-३१-१२", "content_sanskrit": "कुटुम्बभरणाकल्पो मन्दभाग्यो वृथोद्यमः।\nश्रिया विहीनः कृपणो ध्यायञ्छ्वसति मूढधीः॥ ३/३१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.013.m4a", "display_order": 14}, {"id": 6000061014, "chapter_id": 10061, "verse_number": "३-३१-१३", "content_sanskrit": "एवं स्वभरणाकल्पं तत्कलत्रादयस्तदा।\nनाद्रियन्ते यथापूर्वं कीनाश इव गोजरम्॥ ३/३१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.014.m4a", "display_order": 15}, {"id": 6000061015, "chapter_id": 10061, "verse_number": "३-३१-१४", "content_sanskrit": "तत्राप्यजातनिर्वेदो भ्रियमाणः स्वयम्भृतैः।\nजरयोपात्तवैरूप्यो मरणाभिमुखो गृहे॥ ३/३१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.015.m4a", "display_order": 16}, {"id": 6000061016, "chapter_id": 10061, "verse_number": "३-३१-१५", "content_sanskrit": "आस्तेऽवमत्योपन्यस्तं गृहपाल इवाहरन्।\nआमयेनाप्रदीप्ताग्निरल्पाहारोऽल्पचेष्टितः॥ ३/३१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.016.m4a", "display_order": 17}, {"id": 6000061017, "chapter_id": 10061, "verse_number": "३-३१-१६", "content_sanskrit": "वायुनोत्क्रमतोत्तारकफसंरुद्धनासिकः।\nखासश्वासकृतायासः कण्ठो घुरुघुरायते॥ ३/३१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.017.m4a", "display_order": 18}, {"id": 6000061018, "chapter_id": 10061, "verse_number": "३-३१-१७", "content_sanskrit": "शयानः परिशोचद्भिः परिवीतः स्वबन्धुभिः।\nवाच्यमानोऽपि न ब्रूते कालपाशवशं गतः॥ ३/३१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.018.m4a", "display_order": 19}, {"id": 6000061019, "chapter_id": 10061, "verse_number": "३-३१-१८", "content_sanskrit": "एवं कुटुम्बभरणे व्यापृतात्माऽजितेन्द्रियः।\nम्रियते रुदतां स्वानामुरुवेदनयाऽस्तधीः॥ ३/३१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.019.m4a", "display_order": 20}, {"id": 6000061020, "chapter_id": 10061, "verse_number": "३-३१-१९", "content_sanskrit": "यमदूतौ तदा प्राप्तौ भीमौ सरभसेक्षणौ।\nस दृष्ट्वा त्रस्तहृदयः शकृन्मूत्रं विमुञ्चति॥ ३/३१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.020.m4a", "display_order": 21}, {"id": 6000061021, "chapter_id": 10061, "verse_number": "३-३१-२०", "content_sanskrit": "यातनादेह आवृत्त्य पाशैर्बद‌्ध्वा गले बलात्।\nनीयते दीर्घमध्वानं दण्ड्यं राजभटा यथा॥ ३/३१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.021.m4a", "display_order": 22}, {"id": 6000061022, "chapter_id": 10061, "verse_number": "३-३१-२१", "content_sanskrit": "तयोर्निर्भिन्नहृदयस्तर्जनैर्जातवेपथुः।\nपथि श्वभिर्भक्ष्यमाण आर्तोऽघं स्वमनुस्मरन्॥ ३/३१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.022.m4a", "display_order": 23}, {"id": 6000061023, "chapter_id": 10061, "verse_number": "३-३१-२२", "content_sanskrit": "क्षुत्तृट्परीतोऽर्कदवानलानिलैः सन्तप्यमानः पथि तप्तवालुके।\nकृच्छ्रेण पृष्ठे कशया च ताडितश्चलत्यशक्तोऽपि निराश्रयोदके॥ ३/३१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.023.m4a", "display_order": 24}, {"id": 6000061024, "chapter_id": 10061, "verse_number": "३-३१-२३", "content_sanskrit": "तत्र तत्र पतञ्छ्रान्तो मूर्च्छितः पुनरुत्थितः।\nतथा पापीयसा नीतस्तमसा यमसादनम्॥ ३/३१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.024.m4a", "display_order": 25}, {"id": 6000061025, "chapter_id": 10061, "verse_number": "३-३१-२४", "content_sanskrit": "योजनानां सहस्राणि नवतिर्नव चाध्वनः।\nत्रिभिर्मुहूर्तैर्द्वाभ्यां वा नीतः प्राप्नोति यातनाम्॥ ३/३१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.025.m4a", "display_order": 26}, {"id": 6000061026, "chapter_id": 10061, "verse_number": "३-३१-२५", "content_sanskrit": "आदीपनं स्वगात्राणां वेष्टयित्वोल्मुकादिभिः।\nआत्ममांसादनं क्‍वापि स्वकृतं परतोऽपि वा॥ ३/३१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.026.m4a", "display_order": 27}, {"id": 6000061027, "chapter_id": 10061, "verse_number": "३-३१-२६", "content_sanskrit": "जीवतश्चान्त्राभ्युद्धारः श्वगृध्रैर्यमसादने।\nसर्पवृश्चिकदंशाद्यैः स्मरद्भिश्चात्मवैशसम्॥ ३/३१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.027.m4a", "display_order": 28}, {"id": 6000061028, "chapter_id": 10061, "verse_number": "३-३१-२७", "content_sanskrit": "कृन्तनं चावयवशो गजादिभ्यो भिदापनम्।\nपातनं गिरिशृृङ्गेभ्यो रोधनं चाम्बुगर्तयोः॥ ३/३१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.028.m4a", "display_order": 29}, {"id": 6000061029, "chapter_id": 10061, "verse_number": "३-३१-२८", "content_sanskrit": "यास्तामिस्रान्धतामिस्ररौरवाद्याश्च यातनाः।\nभुङ्क्ते नरो वा नारी वा मिथः सङ्गेन निर्मिताः॥ ३/३१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.029.m4a", "display_order": 30}, {"id": 6000061030, "chapter_id": 10061, "verse_number": "३-३१-२९", "content_sanskrit": "अत्रैव नरकः स्वर्ग इति मातः प्रचक्षते।\nया यातना वै नारक्यस्ता इहाप्युपलक्षिताः॥ ३/३१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.030.m4a", "display_order": 31}, {"id": 6000061031, "chapter_id": 10061, "verse_number": "३-३१-३०", "content_sanskrit": "एवं कुटुम्बं बिभ्राण उदरम्भर एव च।\nविसृज्येहोभयं प्रेत्य भुङ्क्ते तत्फलमीदृशम्॥ ३/३१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.031.m4a", "display_order": 32}, {"id": 6000061032, "chapter_id": 10061, "verse_number": "३-३१-३१", "content_sanskrit": "एकः प्रपद्यतेऽध्वानं हित्वेह स्वकलेवरम्।\nकुशलेतरपाथेयो भूतद्रोहेण यद् भृतम्॥ ३/३१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.032.m4a", "display_order": 33}, {"id": 6000061033, "chapter_id": 10061, "verse_number": "३-३१-३२", "content_sanskrit": "दैवेनासादितं तस्य शमलं निरये पुमान्।\nभुङ्क्ते कुटुम्बपोषस्य हृतचित्त इवातुरः॥ ३/३१/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.033.m4a", "display_order": 34}, {"id": 6000061034, "chapter_id": 10061, "verse_number": "३-३१-३३", "content_sanskrit": "केवलेन ह्यधर्मेण कुटुम्बभरणोत्सुकः।\nयाति जीवोऽन्धतामिस्रं चरमं तमसः पदम्॥ ३/३१/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.034.m4a", "display_order": 35}, {"id": 6000061035, "chapter_id": 10061, "verse_number": "३-३१-३४", "content_sanskrit": "अधस्तान्नरलोकस्य यावतीर्यातनास्तु ताः।\nक्रमशः समनुक्रम्य पुनरत्राव्रजेच्छुचिः॥ ३/३१/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_031/BhP_03.031.035.m4a", "display_order": 36}, {"id": 6000061036, "chapter_id": 10061, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे एकत्रिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]