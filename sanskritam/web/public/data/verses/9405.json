[{"id": 5000405000, "chapter_id": 9405, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे षट्षष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000405001, "chapter_id": 9405, "verse_number": "५-६६-१", "content_sanskrit": "एवमुक्तो हनुमता रामो दशरथात्मजः।\nतं मणिं हृदये कृत्वा रुरोद सहलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000405002, "chapter_id": 9405, "verse_number": "५-६६-२", "content_sanskrit": "तं तु दृष्ट्वा मणिश्रेष्ठं राघवः शोककर्शितः।\nनेत्राभ्यामश्रुपूर्णाभ्यां सुग्रीवमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000405003, "chapter_id": 9405, "verse_number": "५-६६-३", "content_sanskrit": "यथैव धेनुः स्रवति स्नेहाद् वत्सस्य वत्सला।\nतथा ममापि हृदयं मणिश्रेष्ठस्य दर्शनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000405004, "chapter_id": 9405, "verse_number": "५-६६-४", "content_sanskrit": "मणिरत्नमिदं दत्तं वैदेह्याः श्वशुरेण मे।\nवधूकाले यथा बद्धमधिकं मूर्ध्नि शोभते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000405005, "chapter_id": 9405, "verse_number": "५-६६-५", "content_sanskrit": "अयं हि जलसम्भूतो मणिः प्रवरपूजितः।\nयज्ञे परमतुष्टेन दत्तः शक्रेण धीमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000405006, "chapter_id": 9405, "verse_number": "५-६६-६", "content_sanskrit": "इमं दृष्ट्वा मणिश्रेष्ठं तथा तातस्य दर्शनम्।\nअद्यास्म्यवगतः सौम्य वैदेहस्य तथा विभोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000405007, "chapter_id": 9405, "verse_number": "५-६६-७", "content_sanskrit": "अयं हि शोभते तस्याः प्रियाया मूर्ध्नि मे मणिः।\nअद्यास्य दर्शनेनाहं प्राप्तां तामिव चिन्तये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000405008, "chapter_id": 9405, "verse_number": "५-६६-८", "content_sanskrit": "किमाह सीता वैदेही ब्रूहि सौम्य पुनः पुनः।\nपरासुमिव तोयेन सिञ्चन्ती वाक्यवारिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000405009, "chapter_id": 9405, "verse_number": "५-६६-९", "content_sanskrit": "इतस्तु किं दुःखतरं यदिमं वारिसम्भवम्।\nमणिं पश्यामि सौमित्रे वैदेहीमागतां विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000405010, "chapter_id": 9405, "verse_number": "५-६६-१०", "content_sanskrit": "चिरं जीवति वैदेही यदि मासं धरिष्यति।\nक्षणं वीर न जीवेयं विना तामसितेक्षणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000405011, "chapter_id": 9405, "verse_number": "५-६६-११", "content_sanskrit": "नय मामपि तं देशं यत्र दृष्टा मम प्रिया।\nन तिष्ठेयं क्षणमपि प्रवृत्तिमुपलभ्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000405012, "chapter_id": 9405, "verse_number": "५-६६-१२", "content_sanskrit": "कथं सा मम सुश्रोणी भीरुभीरुः सती तदा।\nभयावहानां घोराणां मध्ये तिष्ठति रक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000405013, "chapter_id": 9405, "verse_number": "५-६६-१३", "content_sanskrit": "शारदस्तिमिरोन्मुक्तो नूनं चन्द्र इवाम्बुदैः।\nआवृतो वदनं तस्या न विराजति साम्प्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000405014, "chapter_id": 9405, "verse_number": "५-६६-१४", "content_sanskrit": "किमाह सीता हनुमंस्तत्त्वतः कथयस्व मे।\nएतेन खलु जीविष्ये भेषजेनातुरो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000405015, "chapter_id": 9405, "verse_number": "५-६६-१५", "content_sanskrit": "मधुरा मधुरालापा किमाह मम भामिनी।\nमद्विहीना वरारोहा हनुमन् कथयस्व मे।\nदुःखाद् दुःखतरं प्राप्य कथं जीवति जानकी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000405016, "chapter_id": 9405, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे षट्षष्टितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]