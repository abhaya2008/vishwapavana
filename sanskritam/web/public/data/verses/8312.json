[{"id": 900003932, "chapter_id": 8312, "verse_number": "8.1", "content_sanskrit": "स्वायम्भुवस्येह मनो१र्वंशोऽयं विस्तराच्छ्रुतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900003933, "chapter_id": 8312, "verse_number": "8.2", "content_sanskrit": "आसीद् गिरिवरो राजंस्त्रिकूट इति विश्रुतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900003934, "chapter_id": 8312, "verse_number": "8.3", "content_sanskrit": "एवंव्यवसितो बुद्ध्या समाधाय मनो हृदि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900003935, "chapter_id": 8312, "verse_number": "8.4", "content_sanskrit": "तदा देवर्षिगन्धर्वा ब्रह्मेशानपुरोगमाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900003936, "chapter_id": 8312, "verse_number": "8.5", "content_sanskrit": "राजन्नुदितमेतत् ते हरेः कर्माघनाशनम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900003937, "chapter_id": 8312, "verse_number": "8.6", "content_sanskrit": "एवं स्तुतः सुरगणैर्भगवान् हरिरीश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900003938, "chapter_id": 8312, "verse_number": "8.7", "content_sanskrit": "ते नागराजमामन्त्र्य फलभागेन वासुकिम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900003939, "chapter_id": 8312, "verse_number": "8.8", "content_sanskrit": "पीते गरे वृषाङ्गेण प्रीतास्तेऽमरदानवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900003940, "chapter_id": 8312, "verse_number": "8.9", "content_sanskrit": "इति दानवदैतेया नाविन्दन्नमृतं नृप", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900003941, "chapter_id": 8312, "verse_number": "8.10", "content_sanskrit": "अथो सुराः प्रत्युपलब्धचेतसः परस्य पुंसः परयाऽनुकम्पया", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900003942, "chapter_id": 8312, "verse_number": "8.11", "content_sanskrit": "वृषध्वजो निशम्येदं योषिद्रूपेण दानवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900003943, "chapter_id": 8312, "verse_number": "8.12", "content_sanskrit": "मनुर्विवस्वतः पुत्रः श्राद्धदेव इति श्रुतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900003944, "chapter_id": 8312, "verse_number": "8.13", "content_sanskrit": "मन्वन्तरेषु भगवन् यथा मन्वादयस्त्विमे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900003945, "chapter_id": 8312, "verse_number": "8.14", "content_sanskrit": "बलेः पदत्रयं भूमेः कस्माद्धरिरयाचत", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900003946, "chapter_id": 8312, "verse_number": "8.15", "content_sanskrit": "एवं पुत्रेषु नष्टेषु देवमाताऽदितिस्तदा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900003947, "chapter_id": 8312, "verse_number": "8.16", "content_sanskrit": "इत्युक्ता साऽदिती राजन् स्वभर्त्रा कश्यपेन वै", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900003948, "chapter_id": 8312, "verse_number": "8.17", "content_sanskrit": "इत्थं विरिञ्चिस्तुतकर्मवीर्यः प्रादुर्बभूवामृतभूरदित्याम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900003949, "chapter_id": 8312, "verse_number": "8.18", "content_sanskrit": "इति वैरोचनेर्वाक्यं धर्मयुक्तं सुसूनृतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900003950, "chapter_id": 8312, "verse_number": "8.19", "content_sanskrit": "बलिरेवं गृहपतिः कुलाचार्येण भाषितः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900003951, "chapter_id": 8312, "verse_number": "8.20", "content_sanskrit": "स तं समीक्ष्याब्जभवो नखेन्दुभिर्हृतस्वधामद्युतिरावृतोऽभ्यगात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900003952, "chapter_id": 8312, "verse_number": "8.21", "content_sanskrit": "इत्युक्तवन्तं पुरुषं पुरातनं महानुभावोऽखिलसाधुसम्मतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900003953, "chapter_id": 8312, "verse_number": "8.22", "content_sanskrit": "भगवन् श्रोतुमिच्छामि हरेरद्भुतकर्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]