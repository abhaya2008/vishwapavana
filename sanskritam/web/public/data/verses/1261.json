[{"id": 2012670, "chapter_id": 1261, "verse_number": "२-२-१", "content_sanskrit": "वैशम्पायन उवाच।\nउषित्वा खाण्डवप्रस्थे सुखवासं जनार्दनः।\nपार्थैः प्रीतिसमायुक्तैः पूजनार्होऽभिपूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2012671, "chapter_id": 1261, "verse_number": "२-२-२", "content_sanskrit": "गमनाय मतिं चक्रे पितुर्दर्शनलालसः।\nधर्मराजमथामन्त्र्य पृथां च पृथुलोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2012672, "chapter_id": 1261, "verse_number": "२-२-३", "content_sanskrit": "ववन्दे चरणौ मूर्ध्ना जगद्वन्द्यः पितृष्वसुः।\nस तया मूर्ध्न्युपाघ्रातः परिष्वक्तश्च केशवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2012673, "chapter_id": 1261, "verse_number": "२-२-४", "content_sanskrit": "ददर्शानन्तरं कृष्णो भगिनीं स्वां महायशाः।\nतामुपेत्य हृषीकेशः प्रीत्या बाष्पसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2012674, "chapter_id": 1261, "verse_number": "२-२-५", "content_sanskrit": "अर्थ्यं तथ्यं हितं वाक्यं लघु युक्तमनुत्तरम्।\nउवाच भगवान्भद्रां सुभद्रां भद्रभाषिणीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2012675, "chapter_id": 1261, "verse_number": "२-२-६", "content_sanskrit": "तया स्वजनगामीनि श्रावितो वचनानि सः।\nसम्पूजितश्चाप्यसकृच्छिरसा चाभिवादितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2012676, "chapter_id": 1261, "verse_number": "२-२-७", "content_sanskrit": "तामनुज्ञाय वार्ष्णेयः प्रतिनन्द्य च भामिनीम्।\nददर्शानन्तरं कृष्णां धौम्यं चापि जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2012677, "chapter_id": 1261, "verse_number": "२-२-८", "content_sanskrit": "ववन्दे च यथान्यायं धौम्यं पुरुषसत्तमः।\nद्रौपदीं सान्त्वयित्वा च सुभद्रां परिदाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2012678, "chapter_id": 1261, "verse_number": "२-२-९", "content_sanskrit": "भ्रातृनभ्यगमद्विद्वान्पार्थेन सहितो बली।\nभ्रातृभिः पञ्चभिः कृष्णो वृतः शक्र इवामरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2012679, "chapter_id": 1261, "verse_number": "२-२-१०", "content_sanskrit": "यात्राकालस्य योग्यानि कर्माणि गरुडध्वजः।\nकर्तुकामः शुचिर्भूत्वा स्नातवान्समलङ्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2012680, "chapter_id": 1261, "verse_number": "२-२-११", "content_sanskrit": "अर्चयामास देवांश्च द्विजांश्च यदुपुङ्गवः।\nमाल्यजाप्यनमस्कारैर्गन्धैरुच्चावचैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2012681, "chapter_id": 1261, "verse_number": "२-२-१२", "content_sanskrit": "स कृत्वा सर्वकार्याणि प्रतस्थे तस्थुपां वरः।\nउपेत्य स यदुश्रेष्ठो बाह्यकक्षाद्विनिर्गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2012682, "chapter_id": 1261, "verse_number": "२-२-१३", "content_sanskrit": "स्वस्ति वाच्यार्हतो विप्रान्दधिपात्रफलाक्षतैः।\nवसु प्रदाय च ततः प्रदक्षिणमथाकरोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2012683, "chapter_id": 1261, "verse_number": "२-२-१४", "content_sanskrit": "काञ्चनं रथमास्थाय तार्क्ष्यकेतनमाशुगम्।\nगदाचक्रासिशार्ङ्गाद्यैरायुधैरावृतं शुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2012684, "chapter_id": 1261, "verse_number": "२-२-१५", "content_sanskrit": "सुतिथावथ नक्षत्रे मुहूर्ते च गुणान्विते।\nप्रययौ पुण्डरीकाक्षः शैब्यसुग्रीववाहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2012685, "chapter_id": 1261, "verse_number": "२-२-१६", "content_sanskrit": "अन्वारुरोह चाप्येनं प्रेम्णा राजा युधिष्ठिरः।\nअपास्य चास्य यन्तारं दारुकं यन्तृसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2012686, "chapter_id": 1261, "verse_number": "२-२-१७", "content_sanskrit": "अभीषून्सम्प्रजग्राह स्वयं कुरुपतिस्तदा।\nउपारुह्यार्जुनश्चाऽपि चामरव्यजनं सितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2012687, "chapter_id": 1261, "verse_number": "२-२-१८", "content_sanskrit": "रुक्मदण्डं बृहद्बाहुर्विदुधाव प्रदक्षिणम्।\nतथैव भीमसेनोऽपि रथमारुह्य वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2012688, "chapter_id": 1261, "verse_number": "२-२-१९", "content_sanskrit": "छत्रं शतशलाकं च दिव्यमाल्योपशोभितम्।\nवैडूर्यमणिदण्डं च चामीकरविभूषितम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2012689, "chapter_id": 1261, "verse_number": "२-२-२०", "content_sanskrit": "दधार तरसा भीमः मुच्छत्रं शार्ङ्गधन्वने।\nभीमसेनार्जुनौ चापि यमावरिनिषूदनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2012690, "chapter_id": 1261, "verse_number": "२-२-२१", "content_sanskrit": "पृष्ठतोऽनुययुः कृष्णमृत्विक्पौरजनैर्वृता।\nस तथा भ्रातृभिः सर्वैः केशवः परवीरहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2012691, "chapter_id": 1261, "verse_number": "२-२-२२", "content_sanskrit": "अन्वीयमानः शुशुभे शिष्यैरिव गुरुः प्रियैः।\nअभिमन्युं च सौभद्रं वृद्धैः परिवृतस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2012692, "chapter_id": 1261, "verse_number": "२-२-२३", "content_sanskrit": "रथमारोप्य निर्यातो धौम्यो ब्राह्मणपुङ्गवः।\nइन्द्रप्रस्थमतिक्रम्य क्रोशमात्रं महाद्युतिः।\nपार्थमामन्त्र्य गोविन्दः परिष्वज्य सुपीडितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2012693, "chapter_id": 1261, "verse_number": "२-२-२४", "content_sanskrit": "युधिष्ठरं पूजयित्वा भीमसेनं यमौ तथा।\nपरिष्वक्तो भृशं तैस्तु यमाभ्यामभिवादितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2012694, "chapter_id": 1261, "verse_number": "२-२-२५", "content_sanskrit": "योजनार्धमथो गत्वा कृष्णः परपुरञ्जयः।\nयुधिष्ठिरं समामन्त्र्य निवर्तस्वेति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2012695, "chapter_id": 1261, "verse_number": "२-२-२६", "content_sanskrit": "ततोऽभिवाद्य गोविन्दः पादौ जग्राह धर्मवित्।\nउत्थाप्य धर्मराजस्तु मूर्ध्न्युपाघ्राय केशवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2012696, "chapter_id": 1261, "verse_number": "२-२-२७", "content_sanskrit": "पाण्डवो यादवश्रेष्ठं कृष्णं कमललोचनम्।\nगम्यतामित्यनुज्ञाप्य धर्मराजो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2012697, "chapter_id": 1261, "verse_number": "२-२-२८", "content_sanskrit": "ततस्तैः संविदं कृत्वा यथावन्मधुसूदनः।\nनिवर्त्य च तथा कृच्छ्रात्पाण्डवान्सपदानुगान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2012698, "chapter_id": 1261, "verse_number": "२-२-२९", "content_sanskrit": "स्वां पुरीं प्रययौ हृष्टो यथा शक्रोऽमरावतीम्॥\nलोचनैरनुजग्मुस्ते तमादृष्टिपथात्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2012699, "chapter_id": 1261, "verse_number": "२-२-३०", "content_sanskrit": "मनोभिरनुजग्मुस्ते कृष्णं प्रीतिसमन्वयात्।\nअतृप्तमनसामेव तेषां केशवदर्शने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2012700, "chapter_id": 1261, "verse_number": "२-२-३१", "content_sanskrit": "क्षिप्रमन्तर्दधे शौरिश्चक्षुषां प्रियदर्शनः।\nअकामा एव पार्थास्ते गोविन्दगमानसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2012701, "chapter_id": 1261, "verse_number": "२-२-३२", "content_sanskrit": "निवृत्योपययुस्तूर्णं स्वं पुरं पुरुषर्षभाः।\nस्यन्दनेनाथ कृष्णोऽपि त्वरितं द्वारकामगात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2012702, "chapter_id": 1261, "verse_number": "२-२-३३", "content_sanskrit": "सात्वतेन च वीरेण पृष्ठतो यायिना तदा।\nदारुकेण च सूतेन सहितो देवकीसुतः।\nस गतो द्वारकां विष्णुर्गरुत्मानिव वेगवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2012703, "chapter_id": 1261, "verse_number": "२-२-३४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2012704, "chapter_id": 1261, "verse_number": "२-२-३४", "content_sanskrit": "निवृत्य धर्मराजस्तु सह भ्रातृभिरच्युतः।\nसुहृत्परिवृतो राजा प्रविवेश पुरोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2012705, "chapter_id": 1261, "verse_number": "२-२-३५", "content_sanskrit": "विसृज्य सुहृदः सर्वान्भ्रातॄन्पुत्रांश्च धर्मराट्।\nमुमोद पुरुषव्याघ्रो द्रौपद्या सहितो नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2012706, "chapter_id": 1261, "verse_number": "२-२-३६", "content_sanskrit": "केशवोपि मुदा युक्तः प्रविवेश पुरोत्तमम्।\nपूज्यमानो यदुश्रेष्ठैरुग्रसेनमुखैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2012707, "chapter_id": 1261, "verse_number": "२-२-३७", "content_sanskrit": "आहुकं पितरं वृद्धं मातरं च यशस्विनीम्।\nअभिवाद्य बलं चैव स्थितः कमललोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2012708, "chapter_id": 1261, "verse_number": "२-२-३८", "content_sanskrit": "प्रद्युम्नसाम्बनिशठांश्चरुदेष्णं गदं तथा।\nअनिरुद्धं च भानुं च परिष्वज्य जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2012709, "chapter_id": 1261, "verse_number": "२-२-३९", "content_sanskrit": "स वृद्धैरभ्यनुज्ञातो रुक्मिण्या भवनं ययौ।\nस तत्र भवने दिव्ये प्रमुमोद सुखी सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2012710, "chapter_id": 1261, "verse_number": "२-२-४०", "content_sanskrit": "एतस्मिन्नन्तरे राजन्मयो दैत्याधिपस्तदा।\nविधिवत्कल्पयामास सभां धर्मसुताय वै॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2012711, "chapter_id": 1261, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि मन्त्रपर्वणि द्वितीयोऽध्यायः॥ २॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]