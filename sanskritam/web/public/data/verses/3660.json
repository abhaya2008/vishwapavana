[{"id": 2124104, "chapter_id": 3660, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2124105, "chapter_id": 3660, "verse_number": "१", "content_sanskrit": "प्रभातायां तु शर्वर्यां तेषामक्लिष्टकर्मणाम् ।\nवनं यियासतां विप्राः तस्थुर्भिक्षाभुजोऽग्रतः ।\nतानुवाच ततो राजा कुन्तीपुत्रो युधिष्ठिरः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2124106, "chapter_id": 3660, "verse_number": "२", "content_sanskrit": "वयं हि हृतसर्वस्वा हृतराज्या हृतश्रियः ।\nफलमूलामिषाहारा वनं यास्याम दुःखिताः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2124107, "chapter_id": 3660, "verse_number": "३", "content_sanskrit": "वनं च दोषबहुलं बहुव्यालसरीसृपम् ।\nपरिक्लेशश्च वो मन्ये ध्रुवं तत्र भविष्यति\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2124108, "chapter_id": 3660, "verse_number": "४", "content_sanskrit": "ब्राह्मणानां च सङ्क्लेशो दैवतान्यपि सादयेत् ।\nकिं पुनर्मामितो विप्रा निवर्तध्वं यथागतम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2124109, "chapter_id": 3660, "verse_number": "", "content_sanskrit": "ब्राह्मणाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2124110, "chapter_id": 3660, "verse_number": "५", "content_sanskrit": "या गतिर्भवतां राजन् तां वयं गन्तुमुद्यताः ।\nनार्हथास्मान् परित्यक्तुं भक्तान् सद्धर्मदर्शिनः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2124111, "chapter_id": 3660, "verse_number": "६", "content_sanskrit": "अनुकम्पां हि भक्तेषु दैवतान्यपि कुर्वते ।\nविशेषतो ब्राह्मणेषु सदाचारावलम्बिषु\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2124112, "chapter_id": 3660, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2124113, "chapter_id": 3660, "verse_number": "७", "content_sanskrit": "ममापि परमा भक्तिर्ब्राह्मणेषु सदा द्विजाः ।\nसहायविपरिभ्रंशस्त्वयं सादयतीव माम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2124114, "chapter_id": 3660, "verse_number": "८", "content_sanskrit": "आहरेयुर्हि मे किञ्चित् फलमूलमृगांस्तथा ।\nत इमे शोकजैर्दुःखैर्भ्रातरो मे विमोहिताः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2124115, "chapter_id": 3660, "verse_number": "९", "content_sanskrit": "द्रौपद्या विप्रकर्षेण राज्यापहरणेन च ।\nदुःखान्वितानिमान् क्लेशैर्नाहं वक्तुमिहोत्सहे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2124116, "chapter_id": 3660, "verse_number": "", "content_sanskrit": "ब्राह्मणाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2124117, "chapter_id": 3660, "verse_number": "१०", "content_sanskrit": "अस्मत्पोषणजा चिन्ता मा भूत् ते हृदि पार्थिव ।\nस्वयमाहृत्य वन्यानि ह्यनुयास्यामहे वयम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2124118, "chapter_id": 3660, "verse_number": "११", "content_sanskrit": "अनुध्यानेन जप्येन विधास्यामः शिवं तव ।\nकथाभिश्चानुकूलाभिः सह रंस्यामहे वने\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2124119, "chapter_id": 3660, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2124120, "chapter_id": 3660, "verse_number": "१२", "content_sanskrit": "एवमेतन्न संदेहो रमेयं ब्राह्मणैः सह ।\nन्यूनभावात्तु पश्यामि प्रत्यादेशमिवात्मनः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2124121, "chapter_id": 3660, "verse_number": "१३", "content_sanskrit": "कथं द्रक्ष्यामि वः सर्वान् स्वयमाहृतभोजनान् ।\nमद्भक्तान् क्लिश्यतोऽनर्हान् धिक् पापान् धृतराष्ट्रजान् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2124122, "chapter_id": 3660, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2124123, "chapter_id": 3660, "verse_number": "१४", "content_sanskrit": "इत्युक्त्वा नृपतिः शोचन् निषसाद महीतळे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2124124, "chapter_id": 3660, "verse_number": "१५", "content_sanskrit": "तमध्यात्मरतो विद्वान् शौनको नाम वै द्विजः ।\nयोगे साङ्ख्ये च कुशलो राजानमिदमब्रवीत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2124125, "chapter_id": 3660, "verse_number": "", "content_sanskrit": "शौनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2124126, "chapter_id": 3660, "verse_number": "१६", "content_sanskrit": "शोकस्थानसहस्राणि भयस्थानशतानि च ।\nदिवसे दिवसे मूढमाविशन्ति न पण्डितम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2124127, "chapter_id": 3660, "verse_number": "१७", "content_sanskrit": "नहि ज्ञाननिरुद्धेषु बह्वपायेषु कर्मसु ।\nश्रेयोघातिषु सज्जन्ते बुद्धिमन्तो भवद्विधाः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2124128, "chapter_id": 3660, "verse_number": "१८", "content_sanskrit": "अष्टाङ्गां बुद्धिमाहुर्हि सर्वश्रेयोऽविघातिनीम् ।\nश्रुतिस्मृतिसमायुक्तां सा राजन् त्वय्यवस्थिता\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2124129, "chapter_id": 3660, "verse_number": "१९", "content_sanskrit": "अर्थकृच्छ्रेषु दुर्गेषु व्यापत्सु स्वजनेष्वपि ।\nशरीरे मानसे दुःखे न सीदन्ति भवादृशाः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2124130, "chapter_id": 3660, "verse_number": "२०", "content_sanskrit": "श्रूयतां चाभिधास्यामि जनकेन यथा पुरा ।\nआत्मव्यवस्थानकरा गीताः श्लोका महात्मना\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2124131, "chapter_id": 3660, "verse_number": "२१", "content_sanskrit": "मनोदेहसमुत्थाभ्यां दुःखाभ्यामर्दितं जगत् ।\nतयोर्व्याससमासाभ्यां शमोपायमिमं शृणु\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2124132, "chapter_id": 3660, "verse_number": "२२", "content_sanskrit": "व्याधेरनिष्टसंयोगात् श्रमादिष्टविवर्जनात् ।\nदुःखं चतुर्भिः शारीरं कारणैः सम्प्रवर्तते\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2124133, "chapter_id": 3660, "verse_number": "२३", "content_sanskrit": "व्याधयश्च शरीरेऽस्मिन् वातपित्थकफोद्भवाः ।\nअजीर्णप्रभवाः सर्वे दुःखपापोद्भवा नृणाम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2124134, "chapter_id": 3660, "verse_number": "२४", "content_sanskrit": "तदाशुप्रतिकाराच्च सततं चापिचिन्तनात् ।\nआधिव्याधिप्रशमनं क्रियायोगं फलेन च ।\nमतिमन्तो विदो वैद्याः शमं प्रायेण कुर्वते \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2124135, "chapter_id": 3660, "verse_number": "२५", "content_sanskrit": "मानसस्य प्रियाख्यानसम्भोगोपनयैर्नृणाम् ।\nमानसेन हि दुःखेन शरीरमुपतप्यते ।\nअयःपिण्डेन तप्तेन कुम्भसंस्थमिवोदकम् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2124136, "chapter_id": 3660, "verse_number": "२६", "content_sanskrit": "मानसं शमयेत् तस्मात् ज्ञानेनाग्निमिवाम्बुना ।\nप्रशान्ते मानसे दुःखे शारीरमुपशाम्यति\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2124137, "chapter_id": 3660, "verse_number": "२७", "content_sanskrit": "मनसो दुःखमूलं तु स्नेह इत्युपलभ्यते ।\nस्नेहात्तु सज्जते जन्तुर्दुःखयोगमुपैति च\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2124138, "chapter_id": 3660, "verse_number": "२८", "content_sanskrit": "स्नेहमूलानि दुःखानि स्नेहजानि भयानि च ।\nशोकहर्षौ तथाऽऽयासः स्नेहात् सर्वं प्रवर्तते\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2124139, "chapter_id": 3660, "verse_number": "२९", "content_sanskrit": "स्नेहात् कारुण्यरागौ च प्रजास्वीर्ष्यानयस्तथा ।\nअश्रेयस्कावुभावेतौ पूर्वस्तत्र गुरुः स्मृतः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2124140, "chapter_id": 3660, "verse_number": "३०", "content_sanskrit": "कोटराग्निर्यथाऽशेषं समूलं पादपं दहेत् ।\nधर्मार्थिनं तथाऽल्पोऽपि रागद्वेषो विनाशयेत् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2124141, "chapter_id": 3660, "verse_number": "३१", "content_sanskrit": "विप्रयोगेन तु त्यागी दोषदर्शी समागमात् ।\nविरागं भजते जन्तुर्निर्वैरो निष्परिग्रहः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2124142, "chapter_id": 3660, "verse_number": "३२", "content_sanskrit": "तस्मात् स्नेहं न लिप्सेत मित्रेभ्यो धनसञ्चयात् ।\nस्वशरीरसमुत्थं तु ज्ञानेन विनिवर्तते\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2124143, "chapter_id": 3660, "verse_number": "३३", "content_sanskrit": "ज्ञानान्वितेषु दुःखेषु शास्त्रज्ञेषु कृतात्मसु ।\nन तेषु सज्जते स्नेहः पद्मपत्रेष्विवोदकम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2124144, "chapter_id": 3660, "verse_number": "३४", "content_sanskrit": "रागाभिभूतः पुरुषः कामेन परिकृष्यते ।\nइच्छा सञ्जायते चास्य ततस्तृष्णा प्रवर्तते\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2124145, "chapter_id": 3660, "verse_number": "३५", "content_sanskrit": "तृष्णा हि सर्वपापिष्ठा नित्योद्वेगकरी स्मृता ।\nअधर्मबहुला चैव घोरा पापानुबन्धिनी \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2124146, "chapter_id": 3660, "verse_number": "", "content_sanskrit": "या दुस्त्यजा दुर्मतिभिर्या न जीर्यति जीर्यतः ।\nयोऽसौ प्राणान्तिको रोगः तां तृष्णां त्यजतः सुखम् ॥३६", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2124147, "chapter_id": 3660, "verse_number": "३७", "content_sanskrit": "अनाद्यन्ता तु सा तृष्णा अन्तर्देहगता नृणाम् ।\nविनाशयति सम्भूता अयोरज इवानलः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2124148, "chapter_id": 3660, "verse_number": "३८", "content_sanskrit": "यथेधः स्वसमुत्थेन वह्निना नाशमृच्छति ।\nतथाऽकृतात्मा लोभेन सहजेन विनश्यति \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2124149, "chapter_id": 3660, "verse_number": "३९", "content_sanskrit": "राजतः सलिलादग्नेः चोरतः स्वजनादपि ।\nभयमर्थवतां नित्यं मृत्योः प्राणभृतामिव\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2124150, "chapter_id": 3660, "verse_number": "४०", "content_sanskrit": "यथा ह्यामिषमाकाशे पक्षिभिः श्वापदैर्भुवि ।\nभक्ष्यते सलिले मत्स्यैस्तथा सर्वेण वित्तवान्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2124151, "chapter_id": 3660, "verse_number": "४२", "content_sanskrit": "अर्थ एव हि केषांचिदनर्थो भविता नृणाम् ।\nअर्थश्रेयसि चासक्तो न श्रेयो विन्दते नरः ।\nतस्मादर्थागमाः सर्वे मदमोहविवर्धनाः \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2124152, "chapter_id": 3660, "verse_number": "४३", "content_sanskrit": "कार्पण्यं दर्पमानौ च भयमुद्वेग एव च ।\nअर्थजानि विदुः प्राज्ञा दुःखान्येतानि देहिनाम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2124153, "chapter_id": 3660, "verse_number": "४४", "content_sanskrit": "अर्थस्योपार्जने दुःखं पालने रक्षणे तथा ।\nनाशे दुःखं व्यये दुःखं घ्नन्ति चाप्यर्थकारणात्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2124154, "chapter_id": 3660, "verse_number": "४५", "content_sanskrit": "अर्था दुःखं परित्यक्तुः पालिताश्चापि तेऽसुखाः ।\nदुःखेन चाधिगम्यन्ते तेषां नाशं न चिन्तयेत्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2124155, "chapter_id": 3660, "verse_number": "४६", "content_sanskrit": "असन्तोषपरा मूढाः सन्तोषं यान्ति पण्डिताः ।\nअतो नास्ति विवित्सायाः सन्तोषः परमं सुखम् ।\nतस्मात् संतोषमेवेह धनं पश्यन्ति पण्डिताः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2124156, "chapter_id": 3660, "verse_number": "४७", "content_sanskrit": "अनित्यं यौवनं रूपं जीवितं द्रव्यसञ्चयः ।\nआरोग्यं प्रियसंवासो गृद्ध्येदेषु न पण्डितः \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2124157, "chapter_id": 3660, "verse_number": "४८", "content_sanskrit": "त्यजेत सञ्चयांस्तस्मात् तज्जं क्लेशं सहेतुकः ।\nनहि सञ्चयवान् कश्चिद् दृश्यते निरुपद्रवः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2124158, "chapter_id": 3660, "verse_number": "४९", "content_sanskrit": "अतश्च धर्मिभिःसद्भिर्न चेहार्थः प्रशस्यते ।\nप्रक्षालनाद्धि पङ्कस्य श्रेयो नस्पर्शनं नृणाम् \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2124159, "chapter_id": 3660, "verse_number": "५०", "content_sanskrit": "युधिष्ठिरत्वमर्थेषु न स्पृहां कर्तुमर्हसि ।\nधर्मेण यदि ते कार्यं विमुक्तेप्सुर्भवार्थतः \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2124160, "chapter_id": 3660, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2124161, "chapter_id": 3660, "verse_number": "५१", "content_sanskrit": "न ब्रह्मन् भोगलिप्सार्थमियमर्थेप्सुता मम ।\nभरणार्थं तु विप्राणां ब्रह्मन् काङ्क्षे न लोभतः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2124162, "chapter_id": 3660, "verse_number": "५२", "content_sanskrit": "कथं ह्यस्माद्विधो ब्रह्मन् वर्तमानो गृहाश्रमे ।\nभरणं पालनं चापि न कुर्यादनुयायिनाम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2124163, "chapter_id": 3660, "verse_number": "५३", "content_sanskrit": "संविभागो हि भूतानां सर्वेषामेव शिष्यते ।\nतथैव याचमानेभ्यः प्रदेयं गृहमेधिना\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2124164, "chapter_id": 3660, "verse_number": "५४", "content_sanskrit": "तृणानि भूमिरुदकं वाक् चतुर्थी च सूनृता ।\nसतामेतानि गेहेषु नोच्छिद्यन्ते कदाचन\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2124165, "chapter_id": 3660, "verse_number": "५५", "content_sanskrit": "देयमार्तस्य शयनं सति श्रान्तस्य चासनम् ।\nतृषितस्य च पानीयं क्षुधितस्य च भोजनम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2124166, "chapter_id": 3660, "verse_number": "५६", "content_sanskrit": "चक्षुर्दद्यान्मनो दद्याद् वाचं दद्याच्च सूनृताम् ।\nउत्थाय चासनं दद्यादेष धर्मः सनातनः ।\nप्रत्युत्थायाभिगमनं कुर्यान्न्यायेन चार्चनम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2124167, "chapter_id": 3660, "verse_number": "५७", "content_sanskrit": "अग्निहोत्रमनड्वांश्च ज्ञातयोऽतिथिबान्धवाः ।\nपुत्रदारगृहांश्चैव निर्दहेयुरपूजिताः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2124168, "chapter_id": 3660, "verse_number": "५८", "content_sanskrit": "नात्मार्थे पाचयेदन्नं न वृथा घातयेत् पशून् ।\nन चैकः स्वयमश्नीयाद् विधिवद् यन्न निर्वपेत् \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2124169, "chapter_id": 3660, "verse_number": "५९", "content_sanskrit": "श्वभ्यश्च श्वपचेभ्यश्च वयोभ्यश्चावपेद् भुवि ।\nवैश्वदेवं हि नामैतत् सायंप्रातर्विधीयते\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2124170, "chapter_id": 3660, "verse_number": "६०", "content_sanskrit": "विघसाशी भवेन्नित्यं नित्यं चामृतभोजनः ।\nविघसं भृत्यशेषं स्याद् यज्ञशेषस्तथाऽमृतम् \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2124171, "chapter_id": 3660, "verse_number": "६१", "content_sanskrit": "देवान् पितॄन् मनुष्यांश्च भिक्षूनतिथिपञ्चमान् ।\nअनुव्रजेदुपासीत स यज्ञः पञ्चदक्षिणः \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2124172, "chapter_id": 3660, "verse_number": "६२", "content_sanskrit": "यो दद्यादपरिक्लिष्टमन्नमध्वनि तिष्ठते ।\nश्रान्तायादृष्टपूर्वाय तस्य पुण्यफलं महत्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2124173, "chapter_id": 3660, "verse_number": "६३", "content_sanskrit": "एतां यो वर्तते वृत्तिं वर्तमानो गृहाश्रमे ।\nतस्य धर्मं परं प्राहुः कथं वा विप्र मन्यसे\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2124174, "chapter_id": 3660, "verse_number": "", "content_sanskrit": "शौनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2124175, "chapter_id": 3660, "verse_number": "६४", "content_sanskrit": "अहो बत महत् कष्टं विपरीतमिदं जगत् ।\nयेनापत्रपते साधुरसाधुस्तेन तुष्यति\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2124176, "chapter_id": 3660, "verse_number": "६५", "content_sanskrit": "शिश्नोदरकृते चाज्ञः करोति विघसं बहु ।\nमोहरागसमाक्रान्त इन्द्रियार्थवशानुगः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2124177, "chapter_id": 3660, "verse_number": "६६", "content_sanskrit": "ह्रियते बुध्यमानोऽपि मनोहारिभिरिन्द्रियैः ।\nविमूढसंज्ञो दुष्टाश्वैरुद्भ्रान्तैरिव सारथिः \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2124178, "chapter_id": 3660, "verse_number": "६७", "content_sanskrit": "षडिन्द्रियाणि विषयं समागच्छन्ति वै यदा ।\nतदा प्रादुर्भवत्येषां पूर्वसङ्कल्पजं मनः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2124179, "chapter_id": 3660, "verse_number": "६८", "content_sanskrit": "मनो यस्येन्द्रियग्रामविषयं प्रति चोदितम् ।\nतस्यौत्सुक्यं सम्भवति प्रवृत्तिश्चोपजायते\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2124180, "chapter_id": 3660, "verse_number": "६९", "content_sanskrit": "ततः सङ्कल्पवीर्येण कामेन विषयेषुभिः ।\nविद्धः पतति लोभाग्नौ ज्योतिर्लोभात् पतङ्गवत्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2124181, "chapter_id": 3660, "verse_number": "७०", "content_sanskrit": "ततो दारैर्विहारैश्च मोहितश्च महेप्सया ।\nमहामोहमुखे मग्नो नात्मानमवबुध्यते\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2124182, "chapter_id": 3660, "verse_number": "७१", "content_sanskrit": "एवं पतति संसारे तासु तास्विह योनिषु ।\nअविद्याकर्मतृष्णाभिर्भ्राम्यमाणोऽथ चक्रवत्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2124183, "chapter_id": 3660, "verse_number": "७२", "content_sanskrit": "ब्रह्मादिषु तृणान्तेषु भूतेषु परिवर्तते ।\nजले भुवि तथाऽऽकाशे जायमानः पुनः पुनः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2124184, "chapter_id": 3660, "verse_number": "७३", "content_sanskrit": "अबुधानां गतिस्त्वेषा बुधानामपि मे शृणु ।\nये धर्मे श्रेयसि रता विमोक्षरतयो जनाः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2124185, "chapter_id": 3660, "verse_number": "७४", "content_sanskrit": "यदिदं वेदवचनं कुरु कर्म त्यजेति च ।\nतस्मात् सर्वानिमान् धर्मानभिजानन् समाचरेत् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2124186, "chapter_id": 3660, "verse_number": "७५", "content_sanskrit": "इज्याध्ययनदानानि तपः सत्यं क्षमा दमः ।\nअलोभ इति मार्गोऽयं धर्मस्याष्टविधःस्मृतः \t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2124187, "chapter_id": 3660, "verse_number": "७६", "content_sanskrit": "तत्र पूर्वश्चतुर्भागः पितृयानपथे स्थितः ।\nकर्तव्यमिति यत् कार्यं नाभिमानान्न मत्सरात् \t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2124188, "chapter_id": 3660, "verse_number": "७७", "content_sanskrit": "उत्तरं देवयानं तु सद्भिराचरितं सदा ।\nअष्टाङ्गेनैव मार्गेण विशुद्धात्मा समाचरेत्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2124189, "chapter_id": 3660, "verse_number": "७८", "content_sanskrit": "सम्यक्सङ्कल्पयोगाच्च सम्यक्चेन्द्रियगोचरात् ।\nसम्यग्व्रतविशेषाच्च सम्यक् च गुरुसेवनात्\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2124190, "chapter_id": 3660, "verse_number": "७९", "content_sanskrit": "सम्यगाहारयोगाच्च सम्यक् चाध्ययनागमात् ।\nसम्यक् कर्मोपसंन्यासात् सम्यक् चित्तनिरोधनात् \t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2124191, "chapter_id": 3660, "verse_number": "८०", "content_sanskrit": "सम्यक् कर्माणि कुर्वन्ति संसारविजिगीषवः ।\nरागद्वेषविनिर्मुक्ता ऐश्वर्यवशतां गताः\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2124192, "chapter_id": 3660, "verse_number": "८१", "content_sanskrit": "रुद्राः साध्यास्तथाऽऽदित्या वसवोऽथाश्विनावपि ।\nयोगैश्वर्येण संयुक्ता धारयन्ति प्रजा इमाः\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2124193, "chapter_id": 3660, "verse_number": "८२", "content_sanskrit": "तथा त्वमपि कौन्तेय तप आस्थाय पुष्कलम् ।\nतपसा सिद्धिमन्विच्छ योगसिद्धिं च भारत\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2124194, "chapter_id": 3660, "verse_number": "८३", "content_sanskrit": "पितृमातृमयी सिद्धिः प्राप्ता कर्ममयी च ते ।\nतपसा सिद्धिमन्विच्छ द्विजानां भरणाय वै\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2124195, "chapter_id": 3660, "verse_number": "८४", "content_sanskrit": "सिद्धा हि यद्यदिच्छन्ति कुर्वते तदनुग्रहम् ।\nतस्मात् तपः समास्थाय कुरुष्वात्ममनोरथम्\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2124196, "chapter_id": 3660, "verse_number": "२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि\nद्वितीयोऽध्यायः ॥२॥ ॥आरण्यकपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}]