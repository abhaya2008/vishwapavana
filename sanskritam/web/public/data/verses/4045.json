[{"id": 2141097, "chapter_id": 4045, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2141098, "chapter_id": 4045, "verse_number": "१", "content_sanskrit": "तथा व्यूढेष्वनीकेषु कौरवेयैर्महारथैः ।\nउपायादर्जुनस्तूर्णं रथघोषेण नादयन्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2141099, "chapter_id": 4045, "verse_number": "२", "content_sanskrit": "ददृशुस्तद् ध्वजाग्रं ते शुश्रुवुश्च रथस्वनम् ।\nदोधूयमानस्य भृशं गाण्डीवस्य च निस्वनम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2141100, "chapter_id": 4045, "verse_number": "३", "content_sanskrit": "त्रिक्रोशमात्रं गत्वा तु पाण्डवः श्वेतवाहनः ।\nसेनामुखमभिप्रेक्ष्य पार्थो वैराटिमब्रवीत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2141101, "chapter_id": 4045, "verse_number": "४", "content_sanskrit": "राजानं नात्र पश्यामि रथानीके व्यवस्थितम् ।\nदक्षिणं पक्षमास्थाय कुरवो यान्त्युदङ्मुखाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2141102, "chapter_id": 4045, "verse_number": "५", "content_sanskrit": "उत्सृज्यैतद् रथानीकं महेष्वासाभिरक्षितम् ।\nगवाग्रमभितो याहि यावत् पश्यामि वै रिपुम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2141103, "chapter_id": 4045, "verse_number": "६", "content_sanskrit": "गवाग्रमभितो गत्वा गाश्चाप्याशु निवर्तय\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2141104, "chapter_id": 4045, "verse_number": "७", "content_sanskrit": "यावदेते निवर्तन्ते कुरवो जवमास्थिताः ।\nतावदेव पशून् सर्वान् निवर्तिष्ये तथा हि भो\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2141105, "chapter_id": 4045, "verse_number": "८", "content_sanskrit": "इत्युक्त्वा समरे पार्थो वैराटिमपराजितः ।\nसव्यं पक्षमनुप्राप्य जवेनाश्वानचोदयत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2141106, "chapter_id": 4045, "verse_number": "९", "content_sanskrit": "ततस्तत् सर्वमालोक्य द्रोणो वचनमब्रवीत् ।\nमहारथमनुप्राप्तं दृष्ट्वा गाण्डीवधन्विनम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2141107, "chapter_id": 4045, "verse_number": "१०", "content_sanskrit": "एतद् ध्वजाग्रं पार्थस्य दूरतः परिदृश्यते ।\nमेघः सविद्युत्स्तनितो रोरवीति च वानरः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2141108, "chapter_id": 4045, "verse_number": "११", "content_sanskrit": "अवस्थाय रथं याति गाण्डीवं विक्षिपन् धनुः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2141109, "chapter_id": 4045, "verse_number": "१२", "content_sanskrit": "अश्वानां स्तनतां शब्दो वहतां पाकशासनिम् ।\nरथस्थाम्बुधरस्येव श्रूयते भृशदारुणः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2141110, "chapter_id": 4045, "verse_number": "१३", "content_sanskrit": "दारयन्निव तेजस्वी वसुधां वासवात्मजः ।\nएष तिष्ठन् रथश्रेष्ठो रथे रथवरप्रणुत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2141111, "chapter_id": 4045, "verse_number": "१४", "content_sanskrit": "एष दृष्ट्वा रथानीकमस्माकमरिमर्दनः ।\nह्रीमान् वदान्यो धृतिमान् सत्करोति च पाण्डवः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2141112, "chapter_id": 4045, "verse_number": "१५", "content_sanskrit": "ततोऽभ्यवादयत् पार्थो भीष्मं शान्तनवं कृपम् ।\nद्वाभ्यां द्वाभ्यां तथाऽऽचार्यं द्रोणं च निशितैः शरैः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2141113, "chapter_id": 4045, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2141114, "chapter_id": 4045, "verse_number": "१६", "content_sanskrit": "इमौ बाणावनुप्राप्तौ पादयोः प्रत्युपस्थितौ ।\nबन्धुराग्रनिपातौ मे चित्रपुङ्खावजिह्मगौ\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2141115, "chapter_id": 4045, "verse_number": "१७", "content_sanskrit": "इमौ चाप्यपरौ बाणावभितः कर्णमूलयोः ।\nसंस्पृशान्तावतिक्रान्तौ पृष्ट्वेवानामयं भृशम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2141116, "chapter_id": 4045, "verse_number": "१८", "content_sanskrit": "चिरदृष्टोऽयमस्माभिर्धर्मज्ञो बान्धवप्रियः ।\nअतीव ज्वलते लक्ष्म्या पाण्डुपुत्रः प्रतापवान्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2141117, "chapter_id": 4045, "verse_number": "१९", "content_sanskrit": "निरुष्य च वने वासं कृत्वा कर्म सुदुष्करम् ।\nअभिवादयते पार्थः पूजयन् मामरिन्दमः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2141118, "chapter_id": 4045, "verse_number": "२०", "content_sanskrit": "अमर्षेण हि सम्पूर्णो दुःखेन प्रतिबोधितः ।\nअद्येमां भारतीं सेनामेको नाशयते ध्रुवम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2141119, "chapter_id": 4045, "verse_number": "२१", "content_sanskrit": "द्व्यधिकं दशमुष्य वत्सराणां\nस्वजनेनाविदितस्त्रयोदशं च ।\nज्वलते रथमास्थितः किरीटी\nतम इव रात्रिजमभ्युदस्य सूर्यः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2141120, "chapter_id": 4045, "verse_number": "२२", "content_sanskrit": "रथी शरी चारुमाली निषङ्गी\nशङ्खी पताकी कवची किरीटी ।\nखड्गी च धन्वी च विराजतेऽसौ\nशिखीव यज्ञेषु घृतेन सिक्तः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2141121, "chapter_id": 4045, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि त्रिपञ्चाशोऽध्यायः ॥५३॥ गोग्रहणपर्वणि षड्विंशोऽध्यायः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]