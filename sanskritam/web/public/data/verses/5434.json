[{"id": 2207834, "chapter_id": 5434, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2207835, "chapter_id": 5434, "verse_number": "१", "content_sanskrit": "सङ्कल्पदंशमशकं शोकहर्षहिमातपम् ।\nमोहान्धकारतिमिरं लोभव्यालसरीसृपम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2207836, "chapter_id": 5434, "verse_number": "२", "content_sanskrit": "विषयैकान्त्यकाध्वानं कामक्रोधविरोधिकम् ।\nतदतीत्य महादुर्गं प्रविष्टोऽस्मि महद्वनम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2207837, "chapter_id": 5434, "verse_number": "", "content_sanskrit": "ब्राह्मणी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2207838, "chapter_id": 5434, "verse_number": "३", "content_sanskrit": "क्व तद् वनं महाप्राज्ञ के वृक्षाः सरितश्च काः ।\nकियन्तः पर्वताश्चैव कियत्यध्वनि तद्वनम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2207839, "chapter_id": 5434, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2207840, "chapter_id": 5434, "verse_number": "४", "content_sanskrit": "नैतदस्ति पृथग्भावे मन्दस्य च ततः सुखम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2207841, "chapter_id": 5434, "verse_number": "५", "content_sanskrit": "न तदस्त्यपृथग्भावे किञ्चिद् दूरतरं ततः ।\nतस्माद् ह्रस्वतरं नास्ति न ततोऽन्यद् बृहत्तरम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2207842, "chapter_id": 5434, "verse_number": "६", "content_sanskrit": "नास्ति तस्माद् दुःखतरं नास्त्यन्यत् तत्समं सुखम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2207843, "chapter_id": 5434, "verse_number": "७", "content_sanskrit": "न तत्राविश्य शोचन्ति न प्रहृष्यन्ति च द्विजाः ।\nन च बिभ्यति केभ्यश्चिन्नैभ्यो बिभ्यति केचन\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2207844, "chapter_id": 5434, "verse_number": "८", "content_sanskrit": "तस्मिन् वने सप्त महाद्रुमा हि\nफलानि सप्तातिथयश्च सप्त ।\nसप्ताश्रमाः सप्त समाधयश्च\nदीक्षाश्च सप्तैतदरण्यरूपम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2207845, "chapter_id": 5434, "verse_number": "९", "content_sanskrit": "पञ्च पर्वाणि दिव्यानि पुष्पाणि च फलानि च ।\nसृजन्तः पादपास्तत्र व्याप्य तिष्ठन्ति तद्वनम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2207846, "chapter_id": 5434, "verse_number": "१०", "content_sanskrit": "सुरभीण्येव पर्णानि पुष्पाणि च फलानि च ।\nसृजन्तः पादपास्तत्र व्याप्य तिष्ठन्ति तद्वनम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2207847, "chapter_id": 5434, "verse_number": "११", "content_sanskrit": "शङ्कराणि त्रिवर्णानि पुष्पाणि च फलानि च ।\nसृजन्तः पादपास्तत्र व्याप्य तिष्ठन्ति तद्वनम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2207848, "chapter_id": 5434, "verse_number": "१२", "content_sanskrit": "एको ह्यग्निः सुमना ब्राह्मणोऽत्र\nसप्ते(पञ्चे)न्द्रियाणि समिधश्चात्र सन्ति ।\nतेभ्यो मोक्षात् सप्त फलन्ति दीक्षा\nगुणाः फलान्यतिथयः फलाशाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2207849, "chapter_id": 5434, "verse_number": "१३", "content_sanskrit": "आतिथ्यं प्रतिगृह्णन्ति तत्र सप्त महर्षयः ।\nअर्चितेषु व्यतीतेषु तेष्वन्यद् रोचते वनम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2207850, "chapter_id": 5434, "verse_number": "१४", "content_sanskrit": "प्रतिज्ञावृक्षम् अफलं शान्तिच्छायासमन्वितम् ।\nज्ञानाश्रयं तृप्तितोयं तमः क्षेत्रज्ञभास्करम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2207851, "chapter_id": 5434, "verse_number": "१५", "content_sanskrit": "येऽधिगच्छन्ति तत् सन्तस्तेषां नास्ति पुनर्भवः ।\nऊर्ध्वं चाधश्च तिर्यक् च तस्य नान्तोऽधिगम्यते\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2207852, "chapter_id": 5434, "verse_number": "१६", "content_sanskrit": "सप्त स्त्रियस्तत्र चरन्ति सत्याः\nत्ववाङ्मुखा भानुमत्यो जनित्र्यः ।\nऊर्ध्वं रसानाददते प्रजाभ्यः\nसर्वान् यथा नित्यमनित्यता च\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2207853, "chapter_id": 5434, "verse_number": "१७", "content_sanskrit": "तत्रैव प्रतितिष्ठन्ति पुनस्तत्रोदयन्ति च ।\nते च सप्तर्षयः सिद्धा वसिष्ठप्रमुखैस्त्विह\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2207854, "chapter_id": 5434, "verse_number": "१८", "content_sanskrit": "यशो वर्चो भगश्चौजो विजयः सिद्धतेजसी ।\nएवमेवानुवर्तन्ते सप्त ज्योतींषि भास्करम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2207855, "chapter_id": 5434, "verse_number": "१९", "content_sanskrit": "ऋषयः पर्वताश्चैव सन्ति तत्र समासतः ।\nनद्यश्च पर्वतो वारि वहन्त्यो ब्रह्मसम्भवम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2207856, "chapter_id": 5434, "verse_number": "२०", "content_sanskrit": "नदीनां सङ्गमस्तत्र वैताने समुपह्वरे ।\nस्वात्मतृप्ता यतो यान्ति साक्षाद् दान्ताः पितामहम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2207857, "chapter_id": 5434, "verse_number": "२१", "content_sanskrit": "कृशाङ्गाः सुव्रताः शान्ताः तपसा दग्धकिल्बिषाः ।\nआत्मन्यात्मानमावेश्य ब्राह्मणास्तमुपासते\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2207858, "chapter_id": 5434, "verse_number": "२२", "content_sanskrit": "ऋचमप्यत्र शंसन्ति विद्यारण्यविदो जनाः ।\nतदरण्यमभिप्रेत्य कथा कथमजायत\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2207859, "chapter_id": 5434, "verse_number": "२३", "content_sanskrit": "एतदेवेदृशं दिव्यमरण्यं ब्राह्मणा विदुः ।\nविदित्वा चानुतिष्ठन्ति क्षेत्रज्ञेनानुदर्शिना\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2207860, "chapter_id": 5434, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्वमेधिकपर्वणि अनुगीतासु\nसंसारवर्णनं नाम अष्टाविंशोऽध्यायः ॥२८॥\nअनुगीतापर्वणि त्रयोदशोऽध्यायः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]