[{"id": 7002049000, "chapter_id": 22049, "verse_number": "९४-१", "content_sanskrit": "ईश्वर उवाच ।\nईशादिषु चरक्याद्याः पूर्ववत्पूजयेद्वहिः ।\nआहुतित्रितयं दद्यात्प्रतिदेवमनुक्रमात् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002049001, "chapter_id": 22049, "verse_number": "९४-२", "content_sanskrit": "दत्वा भूतबलिं लग्ने शिलान्यासमनुक्रमात् ।\nमध्यसूत्रे न्यसेच्छक्तिं कुम्भञ्चानन्तमुत्तमं ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002049002, "chapter_id": 22049, "verse_number": "९४-३", "content_sanskrit": "नकारारूढमूलेन कुम्भेऽस्मिन् धारयेच्छिलां ।\nकुम्भानष्टौ सभद्रादीन् दिक्षु पूर्वादिषु क्रमात् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002049003, "chapter_id": 22049, "verse_number": "९४-४", "content_sanskrit": "लोकपालाणुभिर्न्यस्य श्वभ्रेषु न्यस्तशक्तिषु ।\nशिलास्तेष्वथ नन्दाद्याः क्रमेण विनियोजयेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002049004, "chapter_id": 22049, "verse_number": "९४-५", "content_sanskrit": "शम्बरैर्मूर्तिनाथानां यथा स्युर्भित्तिमध्यतः ।\nतासु धर्मादिकानष्टौ कोणात्कोणं विभागशः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002049005, "chapter_id": 22049, "verse_number": "९४-६", "content_sanskrit": "सुभद्रादिषु नन्दाद्याश्चतस्रोऽग्न्यादिकोणगाः ।\nअजिताद्याश्च पूर्वादिजयादिष्वथ विन्यसेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002049006, "chapter_id": 22049, "verse_number": "९४-७", "content_sanskrit": "ब्रह्माणं चोपरि मस्य व्यापकं च महेश्वरं ।\nचिन्तयेदेषु चाधानं व्योमप्रसादमध्यगं ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002049007, "chapter_id": 22049, "verse_number": "९४-८", "content_sanskrit": "बलिन्दत्त्वा जपेदस्त्रं विघ्नदोषनिवारणं ।\nशिलापञ्चकपक्षेऽपि मनागुद्दिश्यते यथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002049008, "chapter_id": 22049, "verse_number": "९४-९", "content_sanskrit": "मध्ये पूर्णशिलान्यासः सुभद्रकलशेऽर्धतः ।\nपद्मादिषु च नन्दाद्याः कोणेष्वग्न्यादिषु क्रमात् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002049009, "chapter_id": 22049, "verse_number": "९४-१०", "content_sanskrit": "मध्यभावे चतस्रोऽपि मातृवद्भावसम्मताः ।\nॐ पूर्णे त्वं महाविश्वे सर्वसन्दोहलक्षणे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002049010, "chapter_id": 22049, "verse_number": "९४-११", "content_sanskrit": "सर्वसम्पूर्णमेवात्र कुरुष्वाङ्गिरसः सुते ।\nॐ नन्दे त्वं नन्दिनी पुंसां त्वामत्र स्थापयाम्यहं ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002049011, "chapter_id": 22049, "verse_number": "९४-१२", "content_sanskrit": "प्रासादे तिष्ठ सन्तृप्ता यावच्चन्द्रार्कतारकं ।\nआयुः कामं श्रियन्नन्दे देहि वासिष्ठ देहिनां ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002049012, "chapter_id": 22049, "verse_number": "९४-१३", "content_sanskrit": "अस्मिन् रक्षा सदा कार्या प्रासादे यत्नतस्त्वया ।\nॐ भद्रे त्वं सर्वदा भद्रं लोकानां कुरु काश्यपि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002049013, "chapter_id": 22049, "verse_number": "९४-१४", "content_sanskrit": "आयुर्दा कामदा देवि श्रीप्रदा च सदा भव ।\nॐ जयेऽत्र सर्वदा देवि श्रीदा ।\nअयुर्दा च सदा भव ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002049014, "chapter_id": 22049, "verse_number": "९४-१५", "content_sanskrit": "ॐ जयेऽत्र सर्वदा देवि तिष्ठ त्वं स्थापिता मय ।\nनित्यञ्जयाय भूत्यै च स्वामिनी भव भार्गवि ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002049015, "chapter_id": 22049, "verse_number": "९४-१६", "content_sanskrit": "ॐ रिक्तेऽतिरिक्तदोषघ्ने सिद्धिमुक्तिप्रदे शुभं ।\nसर्वदा सर्वदेशस्थे तिष्ठास्मिन् विश्वरूपिणि ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002049016, "chapter_id": 22049, "verse_number": "९४-१७", "content_sanskrit": "गगनायतनन्ध्यात्वा तत्र तत्त्वत्रयं न्यसेत् ।\nप्रायश्चित्तन्ततो हुत्वा विधिना विसृजेन्मखं ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]