[{"id": 2145112, "chapter_id": 4125, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2145113, "chapter_id": 4125, "verse_number": "१", "content_sanskrit": "एवमेतन्महाराज यथा वदसि भारत ।\nयुद्धे विनाशः क्षत्रस्य गाण्डीवेन प्रदृश्यते\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2145114, "chapter_id": 4125, "verse_number": "२", "content_sanskrit": "इदं तु नाभिजानामि तव धीरस्य धीमतः ।\nयत् पुत्रवशमागच्छेः तत्वज्ञः सव्यसाचिनः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2145115, "chapter_id": 4125, "verse_number": "३", "content_sanskrit": "नैष कालो महाराज तव शश्वत् कृतागसः ।\nत्वया ह्येवादितः पार्था निकृता भरतर्षभ\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2145116, "chapter_id": 4125, "verse_number": "४", "content_sanskrit": "स्वीकृतास्तैर्जनपदाः कुरवस्ते सजाङ्गलाः ।\nकथं वीरैर्जितां भूमिमखिलां प्रतिपद्यथाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2145117, "chapter_id": 4125, "verse_number": "५", "content_sanskrit": "पिता श्रेष्ठः सुहृद् यश्च सम्यक् प्रणिहितात्मवान् ।\nआस्थेयं हि हितं तेन न द्रोग्धा गुरुरुच्यते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2145118, "chapter_id": 4125, "verse_number": "६", "content_sanskrit": "इदं जितमिदं लब्धमिति श्रुत्वा पराजितान् ।\nद्यूतकाले महाराज स्मयसे स्म कुमारवत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2145119, "chapter_id": 4125, "verse_number": "७", "content_sanskrit": "परुषाण्युच्यमानांश्च पुरा पार्थानुपेक्षसे ।\nकृत्स्नं राज्यं जयन्तीति प्रपातं नानुपश्यसि\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2145120, "chapter_id": 4125, "verse_number": "८", "content_sanskrit": "पित्र्यं राज्यं महाराज कुरवस्ते सजाङ्गलाः ।\nकथं वीरार्जितामुर्वीमखिलां प्रतिपद्यथाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2145121, "chapter_id": 4125, "verse_number": "९", "content_sanskrit": "बाहुवीर्यैर्जिता भूमिस्तव पार्थैर्निवेदिता ।\nमयेदं कृतमित्येव मन्यसे राजसत्तम\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2145122, "chapter_id": 4125, "verse_number": "१०", "content_sanskrit": "ग्रस्तान् गन्धर्वराजेन मज्जतो ह्यप्लवेऽम्भसि ।\nआनिनाय पुनः पार्थः पुत्रांस्ते राजसत्तम\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2145123, "chapter_id": 4125, "verse_number": "११", "content_sanskrit": "कुमारवच्च स्मयसे ऋते विनिकृतेषु यत् ।\nपाण्डवेषु वने राजन् प्रव्रजत्सु पुनः पुनः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2145124, "chapter_id": 4125, "verse_number": "१२", "content_sanskrit": "प्रवर्षतः शरव्रातान् अर्जुनस्य शितान् बहून् ।\nअप्यर्णवा विशुष्येयुः किं पुनर्मांसयोनयः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2145125, "chapter_id": 4125, "verse_number": "१३", "content_sanskrit": "अस्यतां फल्गुनः श्रेष्ठो गाण्डीवं धनुषां वरम् ।\nकेशवः सर्वभूतानामायुधानां सुदर्शनम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2145126, "chapter_id": 4125, "verse_number": "१४", "content_sanskrit": "वानरो रोचमानश्च केतुः केतुमतां वरः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2145127, "chapter_id": 4125, "verse_number": "१५", "content_sanskrit": "एवमेतानि स रथो वहन् श्वेतहयो रणे ।\nक्षपयिष्यति नो राजन् कालचक्रमिवोद्यतम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2145128, "chapter_id": 4125, "verse_number": "१६", "content_sanskrit": "तस्याद्य वसुधा राजन् निखिला भरतर्षभ ।\nयस्य भीमार्जुनौ योधौ स राजा राजसत्तमः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2145129, "chapter_id": 4125, "verse_number": "१७", "content_sanskrit": "तथा भीमहतप्रायां मज्जन्तीं तव वाहिनीम् ।\nदुर्योधनमुखा दृष्ट्वा क्षयं यास्यन्ति कौरवाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2145130, "chapter_id": 4125, "verse_number": "१८", "content_sanskrit": "न भीमार्जुनयोर्भीता लप्स्यन्ते विजयं प्रभो ।\nतव पुत्रा महाराज राजानश्चानुसारिणः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2145131, "chapter_id": 4125, "verse_number": "१९", "content_sanskrit": "मत्स्यास्त्वामद्य नार्चन्ति पाञ्चालाश्च सकेकयाः ।\nसाल्वेयाः शूरसेनाश्च सर्वे त्वामवजानते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2145132, "chapter_id": 4125, "verse_number": "२०", "content_sanskrit": "पार्थं ह्येते गताः सर्वे वीर्यज्ञास्तस्य धीमतः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2145133, "chapter_id": 4125, "verse_number": "२१", "content_sanskrit": "पुत्रस्य तव दोषेण नानुशोचितुमर्हसि ।\nभक्ता अपि विरुध्यन्ते तव पुत्रैः सदैव ते\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2145134, "chapter_id": 4125, "verse_number": "२२", "content_sanskrit": "अनर्हानेव तु वने धर्मयुक्तान् विकर्मणा ।\nयोऽक्लेशयत् पाण्डुपुत्रान् यो विद्वेष्ट्यधुनाऽपि वा\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2145135, "chapter_id": 4125, "verse_number": "२३", "content_sanskrit": "सर्वोपायैर्नियन्तव्यः सानुगः पापपूरुषः ।\nतव पुत्रो महाराज नानुशोचितुमर्हसि\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2145136, "chapter_id": 4125, "verse_number": "२४", "content_sanskrit": "अपरोक्षं महाराज साक्षाच्चैनं ब्रवीम्यहम् ।\nद्यूतकाले मया चोक्तं विदुरेण च धीमता\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2145137, "chapter_id": 4125, "verse_number": "२५", "content_sanskrit": "यदिदं ते विलपितं पाण्डवान् प्रति भारत ।\nअनीशेनैव राजेन्द्र सर्वमेतन्निरर्थकम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2145138, "chapter_id": 4125, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि षट्पञ्चाशोऽध्यायः ॥५६॥ व्यासाभिगमनपर्वणि नवमोऽध्यायः ॥९॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]