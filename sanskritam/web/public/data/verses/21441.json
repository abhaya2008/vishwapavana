[{"id": 7001441000, "chapter_id": 21441, "verse_number": "७-१-१४-१", "content_sanskrit": "वायुरुवाच ।\nप्रतिकल्पं प्रवक्ष्यामि रुद्राविर्भावकारणम् ।\nयतो विच्छिन्नसंताना ब्रह्मसृष्टिः प्रवर्तते॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001441001, "chapter_id": 21441, "verse_number": "७-१-१४-२", "content_sanskrit": "कल्पेकल्पे प्रजाः सृष्ट्वा ब्रह्मा ब्रह्मांडसंभवः ।\nअवृद्धिहेतोर्भूतानां मुमोह भृशदुःखितः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001441002, "chapter_id": 21441, "verse_number": "७-१-१४-३", "content_sanskrit": "तस्य दुःखप्रशांत्यर्थं प्रजानां च विवृद्धये ।\nतत्तत्कल्पेषु कालात्मा रुद्रो रुद्रगणाधिपः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001441003, "chapter_id": 21441, "verse_number": "७-१-१४-४", "content_sanskrit": "निर्दिष्टः पममेशेन महेशो नीललोहितः ।\nपुत्रो भूत्वानुगृह्णाति ब्रह्माणं ब्रह्मणोनुजः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001441004, "chapter_id": 21441, "verse_number": "७-१-१४-५", "content_sanskrit": "स एव भगवानीशस्तेजोराशिरनामयः ।\nअनादिनिधनोधाता भूतसंकोचको विभुः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001441005, "chapter_id": 21441, "verse_number": "७-१-१४-६", "content_sanskrit": "परमैश्वर्यसंयुक्तः परमेश्वरभावितः ।\nतच्छक्त्याधिष्ठितश्शश्वत्तच्चिह्नैरपि चिह्नितः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001441006, "chapter_id": 21441, "verse_number": "७-१-१४-७", "content_sanskrit": "तन्नामनामा तद्रूपस्तत्कार्यकरणक्षमः ।\nतत्तुल्यव्यवहारश्च तदाज्ञापरिपालकः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001441007, "chapter_id": 21441, "verse_number": "७-१-१४-८", "content_sanskrit": "सहस्रादित्यसंकाशश्चन्द्रावयवभूषणः ।\nभुजंगहारकेयूरवलयो मुंजमेखलः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001441008, "chapter_id": 21441, "verse_number": "७-१-१४-९", "content_sanskrit": "जलंधरविरिंचेन्द्रकपालशकलोज्ज्वलः ।\nगङ्गातुंगतरंगार्धपिंगलाननमूर्धजः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001441009, "chapter_id": 21441, "verse_number": "७-१-१४-१०", "content_sanskrit": "भग्नदंष्ट्रांकुराक्रान्तप्रान्तकान्तधराधरः ।\nसव्यश्रवणपार्श्वांतमंडलीकृतकुण्डलः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001441010, "chapter_id": 21441, "verse_number": "७-१-१४-११", "content_sanskrit": "महावृषभनिर्याणो महाजलदनिःस्वनः ।\nमहानलसमप्रख्यो महाबलपराक्रमः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001441011, "chapter_id": 21441, "verse_number": "७-१-१४-१२", "content_sanskrit": "एवं घोरमहारूपो ब्रह्मपुत्रीं महेश्वरः ।\nविज्ञानं ब्रह्मणे दत्त्वा सर्गे सहकरोति च॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001441012, "chapter_id": 21441, "verse_number": "७-१-१४-१३", "content_sanskrit": "तस्माद्रुद्रप्रसादेन प्रतिकल्पं प्रजापतेः ।\nप्रवाहरूपतो नित्या प्रजासृष्टिः प्रवर्तते॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001441013, "chapter_id": 21441, "verse_number": "७-१-१४-१४", "content_sanskrit": "कदाचित्प्रार्थितः स्रष्टुं ब्रह्मणा नीललोहितः ।\nस्वात्मना सदृशान् सर्वान् ससर्ज मनसा विभुः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001441014, "chapter_id": 21441, "verse_number": "७-१-१४-१५", "content_sanskrit": "कपर्दिनो निरातंकान्नीलग्रीवांस्त्रिलोचनान् ।\nजरामरणनिर्मुक्तान् दीप्तशूलवरायुधान्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001441015, "chapter_id": 21441, "verse_number": "७-१-१४-१६", "content_sanskrit": "तैस्तु संच्छादितं सर्वं चतुर्दशविधं जगत् ।\nतान्दृष्टा विविधान्रुद्रान् रुद्रमाह पितामहः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001441016, "chapter_id": 21441, "verse_number": "७-१-१४-१७", "content_sanskrit": "नमस्ते देवदेवेश मास्राक्षीरीदृशीः प्रजाः ।\nअन्याः सृज त्वं भद्रं ते प्रजा मृत्युसमन्विताः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001441017, "chapter_id": 21441, "verse_number": "७-१-१४-१८", "content_sanskrit": "इत्युक्तः प्रहसन्प्राह ब्रह्माणं परमेश्वरः ।\nनास्ति मे तादृशस्सर्गस्सृज त्वमशुभाः प्रजाः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001441018, "chapter_id": 21441, "verse_number": "७-१-१४-१९", "content_sanskrit": "ये त्विमे मनसा सृष्टा महात्मानो महाबलाः ।\nचरिष्यंति मया सार्धं सर्व एव हि याज्ञिकाः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001441019, "chapter_id": 21441, "verse_number": "७-१-१४-२०", "content_sanskrit": "इत्युक्त्वा विश्वकर्माणं विश्वभूतेश्वरो हरः ।\nसह रुद्रैः प्रजासर्गान्निवृत्तात्मा व्यतिष्ठत॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001441020, "chapter_id": 21441, "verse_number": "७-१-१४-२१", "content_sanskrit": "ततः प्रभृति देवो ऽसौ न प्रसूते प्रजाः शुभाः ।\nऊर्ध्वरेताः स्थितः स्थाणुर्यावदाभूतसंप्लवम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]