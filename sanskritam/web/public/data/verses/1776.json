[{"id": 2035788, "chapter_id": 1776, "verse_number": "५-२१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2035789, "chapter_id": 1776, "verse_number": "५-२१-१", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा प्रज्ञावृद्धो महाद्युतिः।\nसंपूज्यैनं यथाकालं भीष्मो वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2035790, "chapter_id": 1776, "verse_number": "५-२१-२", "content_sanskrit": "दिष्ट्या कुशलिनः सर्वे सह दामोदरेण ते।\nदिष्ट्या सहायवन्तश्च दिष्ट्या धर्मे च ते रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2035791, "chapter_id": 1776, "verse_number": "५-२१-३", "content_sanskrit": "दिष्ट्या च सन्धिकामास्ते भ्रातरः कुरुनन्दनाः ।\nदिष्टा न युद्धमनसः पाण्डवाः सह बान्धवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2035792, "chapter_id": 1776, "verse_number": "५-२१-४", "content_sanskrit": "भवता सत्यमुक्तं तु सर्वमेतन्न संशयः।\nअतितीक्ष्णं तु ते वाक्यं ब्राह्मण्यादिति मे मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2035793, "chapter_id": 1776, "verse_number": "५-२१-५", "content_sanskrit": "असंशयं क्सेशितास्ते वने चेह च पाण्डवाः।\nप्राप्ताश्च धर्मतः सर्वं पितुर्धनमसंशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2035794, "chapter_id": 1776, "verse_number": "५-२१-६", "content_sanskrit": "किरीटि बलवान्पार्थः कृतास्त्रश्च महारथः ।\nको हि पाण्डुसुतं युद्धे विषहेत धनञ्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2035795, "chapter_id": 1776, "verse_number": "५-२१-७", "content_sanskrit": "अपि वज्रधरः साक्षात्किमुतान्ये धनुर्भृतः ।\nत्रयाणामपि लोकानां समर्थ इति मे मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2035796, "chapter_id": 1776, "verse_number": "५-२१-८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2035797, "chapter_id": 1776, "verse_number": "५-२१-८", "content_sanskrit": "भीष्मे ब्रुवति तद्वाक्यं धृष्टमाक्षिप्य मन्युना।\nदुर्योधनं समालोक्य कर्णो वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2035798, "chapter_id": 1776, "verse_number": "५-२१-९", "content_sanskrit": "न तत्राविदितं ब्रह्मँल्लोके भूतेन केनचित् ।\nपुनरुक्तेन किं तेन भाषितेन पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2035799, "chapter_id": 1776, "verse_number": "५-२१-१०", "content_sanskrit": "दुर्योधनार्थे शकुनिर्द्यूते निर्जितवान्पुरा ।\nसमयेन गतोऽरण्यं पाण्डुपुत्रो युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2035800, "chapter_id": 1776, "verse_number": "५-२१-११", "content_sanskrit": "स तं समयमाश्रित्य राज्यं नेच्छति पैतृकम्।\nबलमाश्रित्य मत्स्यानां पाञ्चालानां च मूर्खवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2035801, "chapter_id": 1776, "verse_number": "५-२१-१२", "content_sanskrit": "दुर्योधनो भयाद्विद्वन्न दद्यात्पादमन्ततः।\nधर्मतस्तु महीं कृत्स्नां प्रदद्याच्छत्रवेऽपि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2035802, "chapter_id": 1776, "verse_number": "५-२१-१३", "content_sanskrit": "यदि काङ्क्षन्ति ते राज्यं पितृपैतामहं पुनः ।\nयथाप्रतिज्ञं कालं तं चरन्तु वनमाश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2035803, "chapter_id": 1776, "verse_number": "५-२१-१४", "content_sanskrit": "ततो दुर्योधनस्याङ्के वर्तन्तामकुतोभयाः ।\nअधार्मिकीं तु मा बुद्धिं मौर्ख्यात्कुर्वन्तु केवलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2035804, "chapter_id": 1776, "verse_number": "५-२१-१५", "content_sanskrit": "अथ ते धर्ममुत्सृत्य युद्धमिच्छन्ति पाण्डवाः।\nआसाद्येमान्कुरुश्रेष्ठान्स्मरिष्यन्ति वचो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2035805, "chapter_id": 1776, "verse_number": "५-२१-१६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2035806, "chapter_id": 1776, "verse_number": "५-२१-१६", "content_sanskrit": "किं नु राधेय वाचा ते कर्म तत्स्मर्तुमर्हसि।\nएक एव यदा पार्थः षड्रथाञ्जितवान्युधि ॥ ५-२१-१७a` विराटनगरे धीरः किं त्वं तत्रैव नागतः।\nबहुशो जीयमानस्य कर्म दृष्टं तदैव ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2035807, "chapter_id": 1776, "verse_number": "५-२१-१८", "content_sanskrit": "न चेदेवं करिष्यामो यदयं ब्राह्मणोऽब्रवीत्।\nध्रुवं युधि हतास्तेन भक्षयिष्याम पांसुकान्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2035808, "chapter_id": 1776, "verse_number": "५-२१-१९", "content_sanskrit": "` दुर्योधनः सहामात्यो विनङ्क्ष्यति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2035809, "chapter_id": 1776, "verse_number": "५-२१-१९x", "content_sanskrit": "वैशम्पायन उवाच।\nधृतराष्ट्रस्ततो भीष्ममनुमान्य प्रसाद्य च।\nअवभर्त्स्य च राधेयमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2035810, "chapter_id": 1776, "verse_number": "५-२१-२०", "content_sanskrit": "अस्मद्धितं वाक्यमिदं भीष्मः शान्तनवोऽब्रवीत्।\nपाण्डवानां हितं चैव सर्वस्य जगतस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2035811, "chapter_id": 1776, "verse_number": "५-२१-२१", "content_sanskrit": "चिन्तयित्वा तु पार्थेभ्यः प्रेषयिष्यामि सञ्जयम् ।\nस भवान्प्रतियात्वद्य पाण्डवानेव माचिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2035812, "chapter_id": 1776, "verse_number": "५-२१-२२", "content_sanskrit": "स तं सत्कृत्य कौरव्यः प्रेषयामास पाण्डवान् ।\nसभामध्ये समाहूय सञ्जयं वाक्यमब्रवीत् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2035813, "chapter_id": 1776, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि सञ्जययानपर्वणि एकविंशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]