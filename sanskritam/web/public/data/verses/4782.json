[{"id": 2178772, "chapter_id": 4782, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2178773, "chapter_id": 4782, "verse_number": "१", "content_sanskrit": "उत्तिष्ठोत्तिष्ठ गान्धारि मा च शोके मनः कृथाः ।\nतवैव ह्यपराधेन कुरवो निधनं गताः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2178774, "chapter_id": 4782, "verse_number": "२", "content_sanskrit": "या त्वं पुत्रं दुरात्मानम् ईर्षुमत्यन्तमानिनम् ।\nदुर्योधनं पुरस्कृत्य दुष्कृतं साधु मन्यसे\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2178775, "chapter_id": 4782, "verse_number": "३", "content_sanskrit": "निष्ठुरं चैव परुषं वृद्धानां शासनातिगम् ।\nकथमात्मकृतं दोषं मय्याधातुमिहेच्छसि\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2178776, "chapter_id": 4782, "verse_number": "४", "content_sanskrit": "मृतं वा यदि वा नष्टं योऽतीतमनुशोचति ।\nदुःखेन लभते दुःखं द्वावनर्थौ प्रपद्यते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2178777, "chapter_id": 4782, "verse_number": "५", "content_sanskrit": "तपोर्थिनं ब्राह्मणी दत्तगर्भा\nगौर्वोढारं धावितारं तुरङ्गः ।\nशूद्रा दासं पशुपालं तु वैश्या\nवधार्थिनं त्वद्विधा राजपुत्री\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2178778, "chapter_id": 4782, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2178779, "chapter_id": 4782, "verse_number": "६", "content_sanskrit": "तच्छ्रुत्वा वासुदेवस्य पुनरुक्तं वचोऽप्रियम् ।\nतूष्णीं बभूव गान्धारी शोकव्याकुललोचना\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2178780, "chapter_id": 4782, "verse_number": "७", "content_sanskrit": "धृतराष्ट्रस्तु राजर्षिर्निगृह्याबुद्धिजं तमः ।\nपर्यपृच्छत धर्मात्मा धर्मराजं युधिष्ठिरम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2178781, "chapter_id": 4782, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2178782, "chapter_id": 4782, "verse_number": "८", "content_sanskrit": "जीवतां परिमाणज्ञः सैन्यानामसि पाण्डव ।\nहतानां यदि जानीषे परिमाणं ब्रवीहि मे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2178783, "chapter_id": 4782, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2178784, "chapter_id": 4782, "verse_number": "९", "content_sanskrit": "दशायुतसहस्राणि सहस्राणि च विंशतिः ।\nकोट्यः षष्टिश्च षट् चैव अस्मिन् राजन् मृधे हताः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2178785, "chapter_id": 4782, "verse_number": "१०", "content_sanskrit": "आलक्षाणां तु शूराणां सहस्राणि चतुर्दश ।\nदश चान्यानि राजेन्द्र शतं षष्टिश्च भारत\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2178786, "chapter_id": 4782, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2178787, "chapter_id": 4782, "verse_number": "११", "content_sanskrit": "युधिष्ठिर गतिं कां ते गताः पुरुषसत्तमाः ।\nआचक्ष्व मे महाबाहो सर्वज्ञो ह्यसि मे मतः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2178788, "chapter_id": 4782, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2178789, "chapter_id": 4782, "verse_number": "१२", "content_sanskrit": "यैर्हुतानि शरीराणि हृष्टैः परमसंयुगे ।\nदेवराजसमास्ते तु देवराजेन पूजिताः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2178790, "chapter_id": 4782, "verse_number": "१३", "content_sanskrit": "ये त्वहृष्टेन मनसा मर्तव्यमिति भारत ।\nगन्धर्वलोके पूज्यन्ते ते गन्धर्वैः समागताः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2178791, "chapter_id": 4782, "verse_number": "१४", "content_sanskrit": "ये तु सङ्ग्रामभूमिष्ठा याचमानाः पराङ्मुखाः ।\nशस्त्रेण निधनं प्राप्तास्ते गता गुह्यकान् प्रति\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2178792, "chapter_id": 4782, "verse_number": "१५", "content_sanskrit": "विध्यमानाः परैर्ये तु ह्रीयमाणा निरायुधाः ।\nह्रीनिषेधा महात्मानः परानभिमुखान् रणे\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2178793, "chapter_id": 4782, "verse_number": "१६", "content_sanskrit": "भिद्यमानाः शितैर्बाणैः क्षत्रधर्मपरायणाः ।\nहतास्ते ब्रह्मसदनं गता वीराः सुवर्चसः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2178794, "chapter_id": 4782, "verse_number": "१७", "content_sanskrit": "क्षत्रधर्मेण निहतास्ते गताः परमां गतिम् ।\nये तत्र निहता राजन्नन्तरायोधनं प्रति\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2178795, "chapter_id": 4782, "verse_number": "१८", "content_sanskrit": "यथाकथञ्चित् पुरुषास्ते गता ह्युत्तरान् कुरून्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2178796, "chapter_id": 4782, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2178797, "chapter_id": 4782, "verse_number": "१९", "content_sanskrit": "येन ज्ञानबलेनैव पुत्र पश्यसि सिद्धवत् ।\nतन्मे वद महाबाहो श्रोतव्यं यदि वै मया\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2178798, "chapter_id": 4782, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2178799, "chapter_id": 4782, "verse_number": "२०", "content_sanskrit": "निदेशात् भवतः पूर्वं वने विचरता मया ।\nतीर्थयात्राप्रसङ्गेन सम्प्राप्तो यमुनातटम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2178800, "chapter_id": 4782, "verse_number": "२१", "content_sanskrit": "देवर्षिर्लोमशो दृष्टस्ततः प्राप्तोऽस्म्यनुस्मृतिम् ।\nदिव्यं चक्षुरनुप्राप्तं ज्ञानयोगेन वै पुरा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2178801, "chapter_id": 4782, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2178802, "chapter_id": 4782, "verse_number": "२२", "content_sanskrit": "यथाऽनाथा जनास्तात नाथवन्तश्च पाण्डव ।\nकच्चित्तेषां शरीराणि धक्ष्यन्ते विधिपूर्वकम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2178803, "chapter_id": 4782, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2178804, "chapter_id": 4782, "verse_number": "२३", "content_sanskrit": "न येषां शान्तिकर्तारो न च ये ह्याहिताग्नयः ।\nवयं तु तेषां कुर्मोऽद्य बहुत्वात् तात कर्मणः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2178805, "chapter_id": 4782, "verse_number": "२४", "content_sanskrit": "यान् सुपर्णाश्च गृध्राश्च विकर्षन्ति ततस्ततः ।\nतेषां सङ्कर्षणा लोका भविष्यन्ति न संशयः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2178806, "chapter_id": 4782, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2178807, "chapter_id": 4782, "verse_number": "२५", "content_sanskrit": "एवमुक्त्वा महाप्राज्ञः कुन्तीपुत्रो युधिष्ठिरः ।\nआदिदेश सुधर्माणं धौम्यं सूतं च सञ्जयम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2178808, "chapter_id": 4782, "verse_number": "२६", "content_sanskrit": "विदुरं च महाबुद्धिं युयुत्सुं चापि कौरवम् ।\nइन्द्रसेनमुखान् भृत्यान् सूतांश्चैव च सर्वशः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2178809, "chapter_id": 4782, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2178810, "chapter_id": 4782, "verse_number": "२७", "content_sanskrit": "भवन्तः कारयन्त्वेषां प्रेतकार्याणि सर्वशः ।\nयथा नाथवतां किञ्चिच्छरीरं न विनश्यते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2178811, "chapter_id": 4782, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2178812, "chapter_id": 4782, "verse_number": "२८", "content_sanskrit": "शासनाद्धर्मराजस्य क्षत्ता सूतश्च सञ्जयः ।\nसुधर्मा धौम्यसहित इन्द्रसेनादयस्तथा\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2178813, "chapter_id": 4782, "verse_number": "२९", "content_sanskrit": "चन्दनागुरुकाष्ठानि तथा कालेयकान्यपि ।\nघृतं तैलं च गन्धांश्च क्षौमाणि वसनानि च\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2178814, "chapter_id": 4782, "verse_number": "३०", "content_sanskrit": "समाहृत्य महार्हाणि दारूणां चैव सञ्चयान् ।\nरथांश्च मृदितांस्तत्र नानाप्रहरणानि च\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2178815, "chapter_id": 4782, "verse_number": "३१", "content_sanskrit": "चिताः कृत्वा प्रयत्नेन यथा मुख्यान् नराधिपान् ।\nदाहयामासुरव्यग्रा विधिदृष्टेन कर्मणा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2178816, "chapter_id": 4782, "verse_number": "३२", "content_sanskrit": "दुर्योधनं च राजानं भ्रातॄंश्चास्य महारथान् ।\nशल्यं शलं च राजानं भूरिश्रवसमेव च\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2178817, "chapter_id": 4782, "verse_number": "३३", "content_sanskrit": "जयद्रथं च राजानमभिमन्युं च भारत ।\nदौःशासनिं लक्ष्मणं च धृष्टकेतुं च भारत\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2178818, "chapter_id": 4782, "verse_number": "३४", "content_sanskrit": "बृहद्बलं सोमदत्तं सृञ्जयं च महारथम् ।\nराजानं क्षेमधन्वानं विराटद्रुपदौ तथा\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2178819, "chapter_id": 4782, "verse_number": "३५", "content_sanskrit": "शिखण्डिनं च पाञ्चाल्यं धृष्टद्युम्नं च भारत ।\nयुधामन्युं च दुर्धर्षमुत्तमौजसमेव च\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2178820, "chapter_id": 4782, "verse_number": "३६", "content_sanskrit": "कोसलेन्द्रं द्रौपदेयान् शकुनिं चैव सौबलम् ।\nअचलं पुष्कलं चैव भगदत्तं च भारत\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2178821, "chapter_id": 4782, "verse_number": "३७", "content_sanskrit": "कर्णं वैकर्तनं चैव सहपुत्रममर्षणम् ।\nकेकयांश्च महेष्वासान् त्रिगर्तांश्च महारथान्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2178822, "chapter_id": 4782, "verse_number": "३८", "content_sanskrit": "घटोत्कचं राक्षसेन्द्रं बकभ्रातरमेव च ।\nअलम्बुसं च राजानं जलसन्धं च पार्थिवम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2178823, "chapter_id": 4782, "verse_number": "३९", "content_sanskrit": "अन्यांश्च पार्थिवान् शूरान् शतशोऽथ सहस्रशः ।\nघृतधाराहुतैर्दीप्तैः पावकैः समदाहयन्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2178824, "chapter_id": 4782, "verse_number": "४०", "content_sanskrit": "पितृमेधांश्च केषाञ्चित् पार्थिवानां महात्मनाम् ।\nसामानि चान्वगीयन्त तेऽन्वशासत चापरे\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2178825, "chapter_id": 4782, "verse_number": "४१", "content_sanskrit": "साम्नामृचां च नादेन स्त्रीणां च रुदितस्वनैः ।\nकश्मलं सर्वभूतानां तदानीमन्वपद्यत\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2178826, "chapter_id": 4782, "verse_number": "४२", "content_sanskrit": "हुताश्च तत्र दीप्ताश्च दीप्यमानाश्च पावकाः ।\nनभसीवान्वदृश्यन्त ग्रहास्तन्वभ्रसंवृताः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2178827, "chapter_id": 4782, "verse_number": "४३", "content_sanskrit": "ये चाप्यनाथास्तत्रासन् नानादेशसमागताः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2178828, "chapter_id": 4782, "verse_number": "४४", "content_sanskrit": "तांश्च सर्वान् समानीय राशीन् कृत्वा सहस्रशः ।\nचितादारुभिरत्युग्रैः प्रभूतस्नेहमूर्च्छितैः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2178829, "chapter_id": 4782, "verse_number": "४५", "content_sanskrit": "दाहयामास विदुरो धर्मराजस्य शासनात्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2178830, "chapter_id": 4782, "verse_number": "४६", "content_sanskrit": "कारयित्वा क्रियास्तेषां कुरुराजो युधिष्ठिरः ।\nधृतराष्ट्रं पुरस्कृत्य गङ्गामभिमुखोऽगमत्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2178831, "chapter_id": 4782, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां स्त्रीपर्वणि\nषड्विंशोऽध्यायः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2178832, "chapter_id": 4782, "verse_number": "", "content_sanskrit": "श्राद्धपर्वणि प्रथमोऽध्यायः ॥१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]