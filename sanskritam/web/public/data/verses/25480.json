[{"id": 7005480000, "chapter_id": 25480, "verse_number": "१-५०-१", "content_sanskrit": "सूत उवाच ।\nशाकद्वीपस्य विस्ताराद् द्विगुणेन व्यवस्थितः ।\nक्षीरार्णवं समाश्रित्य द्वीपं पुष्करसंज्ञितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005480001, "chapter_id": 25480, "verse_number": "१-५०-२", "content_sanskrit": "एक एवात्र विप्रेन्द्राः पर्वतो मानसोत्तरः ।\nयोजनानां सहस्राणि सार्द्धं पञ्चाशदुच्छ्रितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005480002, "chapter_id": 25480, "verse_number": "१-५०-३", "content_sanskrit": "तावदेव च विस्तीर्णः सर्वतः पारिमण्डलः ।\nस एव द्वीपश्चार्द्धेन मानसोत्तरसंज्ञितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005480003, "chapter_id": 25480, "verse_number": "१-५०-४", "content_sanskrit": "एक एव महाभागः संनिवेशाद् द्विधा कृतः ।\nतस्मिन् द्वीपे स्मृतौ द्वौ तु पुण्यौ जनपदौ शुभौ ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005480004, "chapter_id": 25480, "verse_number": "१-५०-५", "content_sanskrit": "अपरौ मानसस्याथ पर्वतस्यानुमण्डलौ ।\nमहावीतं स्मृतं वर्षं धातकीखण्डमेव च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005480005, "chapter_id": 25480, "verse_number": "१-५०-६", "content_sanskrit": "स्वादूदकेनोदधिना पुष्करः परिवारितः ।\nतस्मिन् द्वीपे महावृक्षो न्यग्रोधोऽमरपूजितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005480006, "chapter_id": 25480, "verse_number": "१-५०-७", "content_sanskrit": "तस्मिन् निवसति ब्रह्मा विश्वात्मा विश्वभावनः ।\nतत्रैव मुनिशार्दूलः शिवनारायणालयः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005480007, "chapter_id": 25480, "verse_number": "१-५०-८", "content_sanskrit": "वसत्यत्र महादेवो हरोर्द्वं हरिरव्ययः ।\nसंपूज्यमानो ब्रह्माद्यैः कुमाराद्यैश्च योगिभिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005480008, "chapter_id": 25480, "verse_number": "१-५०-९", "content_sanskrit": "गन्धर्वैः किन्नरैर्यक्षैरीश्वरः कृष्णपिङ्गलः ।\nस्वस्थास्तत्र प्रजाः सर्वा ब्रह्मणा शतशत्विषः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005480009, "chapter_id": 25480, "verse_number": "१-५०-१०", "content_sanskrit": "निरामया विशोकाश्च रागद्वेषविवर्ज्जिताः ।\nसत्यानृते न तत्रास्तां नोत्तमाधममध्यमाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005480010, "chapter_id": 25480, "verse_number": "१-५०-११", "content_sanskrit": "न वर्णाश्रमधर्माश्च न नद्यो न च पर्वताः ।\nपरेण पुष्करेणाथ समावृत्य स्थितो महान् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005480011, "chapter_id": 25480, "verse_number": "१-५०-१२", "content_sanskrit": "स्वादूदकसमुद्रस्तु समन्ताद् द्विजसत्तमाः ।\nपरेण तस्य महती दृश्यते लोकसंस्थितिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005480012, "chapter_id": 25480, "verse_number": "१-५०-१३", "content_sanskrit": "काञ्चनी द्विगुणा भूमिः सर्वा चैव शिलोपमा ।\nतस्याः परेण शैलस्तु मर्यादा भानुमण्डलः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005480013, "chapter_id": 25480, "verse_number": "१-५०-१४", "content_sanskrit": "प्रकाशश्चाप्रकाशश्च लोकालोकः स उच्यते ।\nयोजनानां सहस्राणि दश तस्योच्छ्रयः स्मृतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005480014, "chapter_id": 25480, "verse_number": "१-५०-१५", "content_sanskrit": "तावानेव च विस्तारो लोकालोको महागिरेः ।\nसमावृत्य तु तं शैलं सर्वतो वै समस्थितम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005480015, "chapter_id": 25480, "verse_number": "१-५०-१६", "content_sanskrit": "तमश्चाण्डकटाहेन समन्तात् परिवेष्टितम् ।\nएतै सप्त महालोकाः पातालाः स ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005480016, "chapter_id": 25480, "verse_number": "१-५०-१७", "content_sanskrit": "ब्रह्माण्डस्यैष विस्तारः संक्षेपेण मयोदितः ।\nअण्डानामीदृशानां तु कोट्यो ज्ञेयाः सहस्रशः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005480017, "chapter_id": 25480, "verse_number": "१-५०-१८", "content_sanskrit": "सर्वगत्वात् प्रधानस्य कारणस्याव्ययात्मनः ।\nअण्डेष्वेतेषु सर्वेषु भुवनानि चतुर्दश ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005480018, "chapter_id": 25480, "verse_number": "१-५०-१९", "content_sanskrit": "तत्र तत्र चतुर्वक्रा रुद्रा नारायणादयः ।\nदशोत्तरमथैकैकमण्डावरणसप्तकम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005480019, "chapter_id": 25480, "verse_number": "१-५०-२०", "content_sanskrit": "समन्तात् संस्थितं विप्रा यत्र यान्ति मनीषिणः ।\nअनन्तमेकमव्यक्तनादिनिधनं महत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005480020, "chapter_id": 25480, "verse_number": "१-५०-२१", "content_sanskrit": "अतीत्य वर्त्तते सर्वं जगत् प्रकृतिरक्षरम् ।\nअनन्तत्वमनन्तस्य यतः संख्या न विद्यते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005480021, "chapter_id": 25480, "verse_number": "१-५०-२२", "content_sanskrit": "तदव्यक्तमिति ज्ञेयं तद् ब्रह्म परमं पदम् ।\nअनन्त एष सर्वत्र सर्वस्थानेषु पठ्यते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005480022, "chapter_id": 25480, "verse_number": "१-५०-२३", "content_sanskrit": "तस्य पूर्वं मयाऽप्युक्तं यत्तन्माहात्म्यमव्ययम् ।\nगतः स एष सर्वत्र सर्वस्थानेषु पूज्यते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005480023, "chapter_id": 25480, "verse_number": "१-५०-२४", "content_sanskrit": "भूमौ रसातले चैव आकाशे पवनेऽनले ।\nअणवेषु च सर्वेषु दिवि चैव न सशयः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005480024, "chapter_id": 25480, "verse_number": "१-५०-२५", "content_sanskrit": "तथा तमसि सत्त्वे च एष एव महाद्युतिः ।\nअनेकधा विभक्ताङ्गः क्रीडते पुरुषोत्तमः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005480025, "chapter_id": 25480, "verse_number": "१-५०-२६", "content_sanskrit": "महेश्वरः परोऽव्यक्तादण्डमव्यक्तसंभवम् ।\nअण्डाद् ब्रह्मा समुत्पन्नस्तेन सृष्टमिदं जगत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]