[{"id": 2002226, "chapter_id": 1046, "verse_number": "१-४७-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2002227, "chapter_id": 1046, "verse_number": "१-४७-१", "content_sanskrit": "वासुकिस्त्वब्रवीद्वाक्यं जरत्कारुमृषिं तदा।\nसनाम्नी तव कन्येयं स्वसा मे तपसान्विता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2002228, "chapter_id": 1046, "verse_number": "१-४७-२", "content_sanskrit": "भरिष्यामि च ते भार्यां प्रतीच्छेमां द्विजोत्तम।\nरक्षणं च करिष्येऽस्याः सर्वशक्त्या तपोधन।\nत्वदर्थं रक्ष्यते चैषा मया मुनिवरोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2002229, "chapter_id": 1046, "verse_number": "१-४७-३x", "content_sanskrit": "जरत्कारुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2002230, "chapter_id": 1046, "verse_number": "१-४७-३", "content_sanskrit": "न भरिष्येऽहमेतां वै एष मे समयः कृतः।\nअप्रियं च न कर्तव्यं कृते चैनां त्यजाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2002231, "chapter_id": 1046, "verse_number": "१-४७-४x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2002232, "chapter_id": 1046, "verse_number": "१-४७-४", "content_sanskrit": "प्रतिश्रुते तु नागेन भरिष्ये भगिनीमिति।\nजरत्कारुस्तदा वेश्म भुजगस्य जगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2002233, "chapter_id": 1046, "verse_number": "१-४७-५", "content_sanskrit": "तत्र मन्त्रविदां श्रेष्ठस्तपोवृद्धो महाव्रतः।\nजग्राह पाणिं धर्मात्मा विधिमन्त्रपुरस्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2002234, "chapter_id": 1046, "verse_number": "१-४७-६", "content_sanskrit": "ततो वासगृहं रम्यं पन्नगेन्द्रस्य संमतम्।\nजगाम भार्याम दाय स्तूयमानो महर्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2002235, "chapter_id": 1046, "verse_number": "१-४७-७", "content_sanskrit": "शयनं तत्र संक्लृप्तं स्पर्ध्यास्तरणसंवृतम्।\nतत्र भार्यासहायो वै जरत्कारुरुवास ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2002236, "chapter_id": 1046, "verse_number": "१-४७-८", "content_sanskrit": "स तत्र समयं चक्रे भार्यया सह सत्तमः।\nविप्रियं मे न कर्तव्यं न च वाच्यं कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2002237, "chapter_id": 1046, "verse_number": "१-४७-९", "content_sanskrit": "त्यजेयं विप्रिये च त्वां कृते वासं च ते गृहे।\nएतद्गृहाण वचनं मया यत्समुदीरितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2002238, "chapter_id": 1046, "verse_number": "१-४७-१०", "content_sanskrit": "ततः परमसंविग्ना स्वसा नागपतेस्तदा।\nअतिदुःखान्विता वाक्यं तमुवाचैवमस्त्विति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2002239, "chapter_id": 1046, "verse_number": "१-४७-११", "content_sanskrit": "तथैव सा च भर्तारं दुःखशीलमुपचारत्।\nउपायैः श्वेतकाकीयैः प्रियकामा यशस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2002240, "chapter_id": 1046, "verse_number": "१-४७-१२", "content_sanskrit": "ऋतुकाले ततः स्नाता कदाचिद्वासुकेः स्वसा।\nभर्तारं वै यथान्यायमुपतस्थे महामुनिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2002241, "chapter_id": 1046, "verse_number": "१-४७-१३", "content_sanskrit": "तत्र तस्याः समभवद्गर्भो ज्वलनसन्निभः।\nअतीव तेजसा युक्तो वैश्वानरसमद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2002242, "chapter_id": 1046, "verse_number": "१-४७-१४", "content_sanskrit": "शुक्लपक्षे यथा सोमो व्यवर्धत तथैव सः।\nततः कतिपयाहस्तु जरत्कारुर्महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2002243, "chapter_id": 1046, "verse_number": "१-४७-१५", "content_sanskrit": "उत्सङ्गेऽस्याः शिरः कृत्वा सुष्वाप परिखिन्नवत्।\nतस्मिंश्च सुप्ते विप्रेन्द्रे सवितास्तमियाद्गिरिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2002244, "chapter_id": 1046, "verse_number": "१-४७-१६", "content_sanskrit": "अह्नः परिक्षये ब्रह्मंस्ततः साऽचिन्तयत्तदा।\nवासुकेर्भगिनी भीता धर्मलोपान्मनस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2002245, "chapter_id": 1046, "verse_number": "१-४७-१७", "content_sanskrit": "किं नु मे सुकृतं भूयाद्भर्तुरुत्थापनं न वा।\nदुःखशीलो हि धर्मात्मा कथं नास्यापराध्नुयाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2002246, "chapter_id": 1046, "verse_number": "१-४७-१८", "content_sanskrit": "कोपो वा धर्मशीलस्य धर्मलोपोऽथवा पुनः।\nधर्मलोपो गरीयान्वै स्यादित्यत्राकरोन्मतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2002247, "chapter_id": 1046, "verse_number": "१-४७-१९", "content_sanskrit": "उत्थापयिष्ये यद्येनं ध्रुवं कोपं करिष्यति।\nधर्मलोपो भवेदस्य सन्ध्यातिक्रमणे ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2002248, "chapter_id": 1046, "verse_number": "१-४७-२०", "content_sanskrit": "इति निश्चित्य मनसा जरत्कारुर्भुजंगमा।\nतमृषिं दीप्ततपसं शयानमनलोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2002249, "chapter_id": 1046, "verse_number": "१-४७-२१", "content_sanskrit": "उवाचेदं वचः श्लक्ष्णं ततो मधुरभाषिणी।\nउत्तिष्ठ त्वं महाभाग सूर्योऽस्तमुपगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2002250, "chapter_id": 1046, "verse_number": "१-४७-२२", "content_sanskrit": "सन्ध्यामुपास्स्व भगवन्नपः स्पृष्ट्वा यतव्रतः।\nप्रादुष्कृताग्निहोत्रोऽयं मुहूर्तो रम्यदारुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2002251, "chapter_id": 1046, "verse_number": "१-४७-२३", "content_sanskrit": "सन्ध्या प्रवर्तते चेयं पश्चिमायां दिशि प्रभो।\nएवमुक्तः स भगवाञ्जरत्कारुर्महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2002252, "chapter_id": 1046, "verse_number": "१-४७-२४", "content_sanskrit": "भार्यां प्रस्फुरमाणौष्ठ इदं वचनमब्रवीत्।\nअवमानः प्रयुक्तोऽयं त्वया मम भुजंगमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2002253, "chapter_id": 1046, "verse_number": "१-४७-२५", "content_sanskrit": "समीपे ते न वत्स्यामि गमिष्यामि यथागतम्।\nशक्तिरस्ति न वामोरु मयि सुप्ते विभावसोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2002254, "chapter_id": 1046, "verse_number": "१-४७-२६", "content_sanskrit": "अस्तं गन्तुं यथाकालमिति मे हृदि वर्तते।\nन चाप्यवमतस्येह वासो रोचेत कस्यचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2002255, "chapter_id": 1046, "verse_number": "१-४७-२७", "content_sanskrit": "किं पुनर्धर्मशीलस्य मम वा मद्विधस्य वा।\nएवमुक्ता जरत्कारुर्भर्त्रा हृदयकम्पनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2002256, "chapter_id": 1046, "verse_number": "१-४७-२८", "content_sanskrit": "अब्रवीद्भगिनी तत्र वासुकेः सन्निवेशने।\nनावमानात्कृतवती तवाहं विप्रे बोधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2002257, "chapter_id": 1046, "verse_number": "१-४७-२९", "content_sanskrit": "धर्मलोपो न ते विप्र स्यादित्येतन्मया कृतम्।\nउवाच भार्यामित्युक्तो जरत्कारुर्महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2002258, "chapter_id": 1046, "verse_number": "१-४७-३०", "content_sanskrit": "ऋषिः कोपसमाविष्टस्त्यक्तुकामो भुजंगमाम्।\nन मे वागनृतं प्राह गमिष्येऽहं भुजंगमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2002259, "chapter_id": 1046, "verse_number": "१-४७-३१", "content_sanskrit": "समयो ह्येष मे पूर्वं त्वया सह मिथः कृतः।\nसुखमस्म्युषितो भद्रे ब्रूयास्त्वं भ्रातरं शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2002260, "chapter_id": 1046, "verse_number": "१-४७-३२", "content_sanskrit": "इतो मयि गते भीरु गतः स भगवानिति।\nत्वं चापि मयि निष्क्रान्ते न शोकं कर्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2002261, "chapter_id": 1046, "verse_number": "१-४७-३३", "content_sanskrit": "इत्युक्ता साऽनवद्याङ्गी प्रत्युवाच मुनिं तदा।\nजरत्कारुं जरत्कारुश्चिन्ताशोकपरायणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2002262, "chapter_id": 1046, "verse_number": "१-४७-३४", "content_sanskrit": "बाष्पगद्गदया वाचा मुखेन परिशुष्यता।\nकृताञ्जलिर्वरारोहा पर्यश्रुनयना ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2002263, "chapter_id": 1046, "verse_number": "१-४७-३५", "content_sanskrit": "धैर्यमालम्ब्य वामोरूर्हृदयेन प्रवेपता।\nन मामर्हसि धर्मज्ञ परित्यक्तुमनागसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2002264, "chapter_id": 1046, "verse_number": "१-४७-३६", "content_sanskrit": "धर्मे स्थितां स्थितो धर्मे सदा प्रियहिते रताम्।\nप्रदाने कारणं यच्च मम तुभ्यं द्विजोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2002265, "chapter_id": 1046, "verse_number": "१-४७-३७", "content_sanskrit": "तदलब्धवतीं मन्दां किं मां वक्ष्यति वासुकिः।\nमातृशापाभिभूतानां ज्ञातीनां मम सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2002266, "chapter_id": 1046, "verse_number": "१-४७-३८", "content_sanskrit": "अपत्यमीप्सितं त्वत्तस्तच्च तावन्न दृश्यते।\nत्वत्तो ह्यपत्यलाभेन ज्ञातीनां मे शिवं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2002267, "chapter_id": 1046, "verse_number": "१-४७-३९", "content_sanskrit": "संप्रयोगो भवेन्नायां मम मोघस्त्वया द्विज।\nज्ञातीनां हितमिच्छन्ती भगवंस्त्वां प्रसादये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2002268, "chapter_id": 1046, "verse_number": "१-४७-४०", "content_sanskrit": "इममव्यक्तरूपं मे गर्भमाधाय सत्तम।\nकथं त्यक्त्वा महात्मा सन्गन्तुमिच्छस्यनागसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2002269, "chapter_id": 1046, "verse_number": "१-४७-४१", "content_sanskrit": "एवमुक्तस्तु स मुनिर्भार्यां वचनमब्रवीत्।\nयद्युक्तमनुरूपं च जरत्कारुं तपोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2002270, "chapter_id": 1046, "verse_number": "१-४७-४२", "content_sanskrit": "अस्त्ययं सुभगे गर्भस्तव वैश्वानरोपमः।\nऋषिः परमधर्मात्मा वेदवेदाङ्गपारगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2002271, "chapter_id": 1046, "verse_number": "१-४७-४३", "content_sanskrit": "एवमुक्त्वा स धर्मात्मा जरत्कारुर्महानृषिः।\nउग्राय तपसे भूयो जगाम कृतनिश्चयः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2002272, "chapter_id": 1046, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि सप्तचत्वारिंशोऽध्यायः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]