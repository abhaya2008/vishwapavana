[{"id": 2208003, "chapter_id": 5439, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2208004, "chapter_id": 5439, "verse_number": "१", "content_sanskrit": "अत्राप्युदहरन्तीममितिहासं पुरातनम् ।\nब्राह्मणस्य च संवादं जनकस्य च भामिनि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2208005, "chapter_id": 5439, "verse_number": "२", "content_sanskrit": "ब्राह्मणं जनको राजा सन्नं कस्मिंश्चिदागसि ।\nविषये मे न वस्तव्यमिति शिष्यार्थमब्रवीत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2208006, "chapter_id": 5439, "verse_number": "३", "content_sanskrit": "इत्युक्तः प्रत्युवाचाथ ब्राह्मणो राजसत्तमः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2208007, "chapter_id": 5439, "verse_number": "४", "content_sanskrit": "आचक्ष्व विषयान् राजन् यान् यांस्तव वशे स्थितान् ।\nसोऽन्यस्य विषये राज्ञो वस्तुमिच्छाम्यहं विभो ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2208008, "chapter_id": 5439, "verse_number": "५", "content_sanskrit": "वचस्ते कर्तुमिच्छामि यथाशास्त्रं महीपते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2208009, "chapter_id": 5439, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2208010, "chapter_id": 5439, "verse_number": "६", "content_sanskrit": "इत्युक्तस्तु तदा राजा ब्राह्मणेन यशस्विना ।\nमुहुरुष्णं च निःश्वस्य न स तं प्रत्यभाषत ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2208011, "chapter_id": 5439, "verse_number": "७", "content_sanskrit": "तमासीनं ध्यायमानं राजानममितौजसम् ।\nकश्मलं सहसाऽगच्छद् भानुमन्तमिव ग्रहः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2208012, "chapter_id": 5439, "verse_number": "८", "content_sanskrit": "तमाश्वास्य ततो राजा व्यपेते कश्मले तदा ।\nततो मुहूर्तादिव तं ब्राह्मणं वाक्यमब्रवीत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2208013, "chapter_id": 5439, "verse_number": "", "content_sanskrit": "जनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2208014, "chapter_id": 5439, "verse_number": "९", "content_sanskrit": "पितृपैतामहे राज्ये वश्ये जनपदे सति ।\nविषयं नाधिगच्छामि विचिन्वन् पृथिवीमिमाम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2208015, "chapter_id": 5439, "verse_number": "१०", "content_sanskrit": "नाध्यगच्छं यदा पृथ्व्यां मिथिला मार्गिता मया ।\nनाध्यगच्छं यदा तस्यां स्वप्रजा मार्गिता मया ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2208016, "chapter_id": 5439, "verse_number": "११", "content_sanskrit": "नाध्यगच्छं यदा तासु ततो मे कश्मलोऽभवत् ।\nततो मे कश्मलस्यान्ते मतिः पुनरुपस्थिता ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2208017, "chapter_id": 5439, "verse_number": "१२", "content_sanskrit": "तया न विषयं मन्ये सर्वो वा विषयो मम ।\nआत्माऽपि चायं न मम सर्वा वा पृथिवी मम ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2208018, "chapter_id": 5439, "verse_number": "१३", "content_sanskrit": "यथा मम तथाऽन्येषामिति मन्ये द्विजोत्तम ।\nउष्यतां यावदुत्साहं भुज्यतां यावदिष्यते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2208019, "chapter_id": 5439, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2208020, "chapter_id": 5439, "verse_number": "१४", "content_sanskrit": "पितृपैतामहे राज्ये वश्ये जनपदे सति ।\nब्रूहि कां बुद्धिमास्थाय ममत्वं वर्जितं त्वया ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2208021, "chapter_id": 5439, "verse_number": "१५", "content_sanskrit": "कां वै बुद्धिं विनिश्चित्य सर्वो वै विषयस्तव ।\nनावैषि विषयं येन सर्वो वा विषयस्तव ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2208022, "chapter_id": 5439, "verse_number": "", "content_sanskrit": "जनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2208023, "chapter_id": 5439, "verse_number": "१६", "content_sanskrit": "अभवन्त इहारम्भाः विदिताः सर्वकर्मसु ।\nनाध्यगच्छमहं तस्मान्ममेदमिति यद् भवेत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2208024, "chapter_id": 5439, "verse_number": "१७", "content_sanskrit": "कस्येदमिति कस्य स्वमिति वेदवचः सदा ।\nनाध्यगच्छमहं बुद्ध्या ममेदमिति यद् भवेत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2208025, "chapter_id": 5439, "verse_number": "१८", "content_sanskrit": "एतां बुद्धिं विनिश्चित्य ममत्वं वर्जितं मया ।\nशृणु बुद्धिं तु यां श्रुत्वा सर्वस्तु विषयो मम ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2208026, "chapter_id": 5439, "verse_number": "१९", "content_sanskrit": "नाहमात्मार्थमिच्छामि गन्धान् घ्राणगतानपि ।\nतस्मान्मे निर्जिता भूमिर्वशे तिष्ठति नित्यशः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2208027, "chapter_id": 5439, "verse_number": "२०", "content_sanskrit": "नाहमात्मार्थमिच्छामि रसानास्येऽपि वर्ततः ।\nआपो मे निर्जितास्तस्माद् वशे तिष्ठन्ति नित्यशः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2208028, "chapter_id": 5439, "verse_number": "२१", "content_sanskrit": "नाहमात्मार्थमिच्छामि रूपं ज्योतिश्च चक्षुषः ।\nतस्मान्मे निर्जितं ज्योतिर्वशे तिष्ठति नित्यदा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2208029, "chapter_id": 5439, "verse_number": "२२", "content_sanskrit": "नाहमात्मार्थमिच्छामि स्पर्शांस्त्वचि गताश्च ये ।\nतस्मान्मे निर्जितो वायुर्वशे तिष्ठति नित्यदा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2208030, "chapter_id": 5439, "verse_number": "२३", "content_sanskrit": "नाहमात्मार्थमिच्छामि शब्दान् श्रोत्रगतानपि ।\nआकाशं मे जितं तस्माद् वशे तिष्ठति नित्यशः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2208031, "chapter_id": 5439, "verse_number": "२४", "content_sanskrit": "नाहमात्मार्थमिच्छामि मनो नित्यं मनोन्तरे ।\nमनो मे निर्जितं तस्माद् वशे तिष्ठति नित्यशः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2208032, "chapter_id": 5439, "verse_number": "२५", "content_sanskrit": "देवेभ्यश्च पितृभ्यश्च भूतेभ्योऽतिथिभिः सह ।\nभुक्त्यर्थं सर्व एवेमे समारम्भा भवन्ति वै ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2208033, "chapter_id": 5439, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2208034, "chapter_id": 5439, "verse_number": "२६", "content_sanskrit": "ततः प्रहस्य जनकं ब्राह्मणः पुनरब्रवीत् ।\nत्वज्जिज्ञासार्थमद्येह विद्धि मां धर्ममागतम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2208035, "chapter_id": 5439, "verse_number": "२७", "content_sanskrit": "त्वमद्य ब्रह्मभावस्य बुद्धावप्यनिवर्तिनः ।\nसत्वनेमिनिरुद्धस्य चक्रस्यैव प्रवर्तकः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2208036, "chapter_id": 5439, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अनुगीतासु जनकब्राह्मणसंवादो नाम त्रयस्त्रिंशोऽध्यायः ॥३३॥\nअनुगीतापर्वणि अष्टादशोऽध्यायः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]