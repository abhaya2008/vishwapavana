[{"id": 5000051000, "chapter_id": 9051, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे एकपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000051001, "chapter_id": 9051, "verse_number": "१-५१-१", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा विश्वामित्रस्य धीमतः।\nहृष्टरोमा महातेजाः शतानन्दो महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000051002, "chapter_id": 9051, "verse_number": "१-५१-२", "content_sanskrit": "गौतमस्य सुतो ज्येष्ठस्तपसा द्योतितप्रभः।\nरामसंदर्शनादेव परं विस्मयमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000051003, "chapter_id": 9051, "verse_number": "१-५१-३", "content_sanskrit": "एतौ निषण्णौ सम्प्रेक्ष्य शतानन्दो नृपात्मजौ।\nसुखासीनौ मुनिश्रेष्ठं विश्वामित्रमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000051004, "chapter_id": 9051, "verse_number": "१-५१-४", "content_sanskrit": "अपि ते मुनिशार्दूल मम माता यशस्विनी।\nदर्शिता राजपुत्राय तपोदीर्घमुपागता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000051005, "chapter_id": 9051, "verse_number": "१-५१-५", "content_sanskrit": "अपि रामे महातेजा मम माता यशस्विनी।\nवन्यैरुपाहरत् पूजां पूजार्हे सर्वदेहिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000051006, "chapter_id": 9051, "verse_number": "१-५१-६", "content_sanskrit": "अपि रामाय कथितं यद् वृत्तं तत् पुरातनम्।\nमम मातुर्महातेजो देवेन दुरनुष्ठितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000051007, "chapter_id": 9051, "verse_number": "१-५१-७", "content_sanskrit": "अपि कौशिक भद्रं ते गुरुणा मम संगता।\nमम माता मुनिश्रेष्ठ रामसंदर्शनादितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000051008, "chapter_id": 9051, "verse_number": "१-५१-८", "content_sanskrit": "अपि मे गुरुणा रामः पूजितः कुशिकात्मज।\nइहागतो महातेजाः पूजां प्राप्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000051009, "chapter_id": 9051, "verse_number": "१-५१-९", "content_sanskrit": "अपि शान्तेन मनसा गुरुर्मे कुशिकात्मज।\nइहागतेन रामेण पूजितेनाभिवादितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000051010, "chapter_id": 9051, "verse_number": "१-५१-१०", "content_sanskrit": "तच्छ्रुत्वा वचनं तस्य विश्वामित्रो महामुनिः।\nप्रत्युवाच शतानन्दं वाक्यज्ञो वाक्यकोविदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000051011, "chapter_id": 9051, "verse_number": "१-५१-११", "content_sanskrit": "नातिक्रान्तं मुनिश्रेष्ठ यत्कर्तव्यं कृतं मया।\nसंगता मुनिना पत्नी भार्गवेणेव रेणुका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000051012, "chapter_id": 9051, "verse_number": "१-५१-१२", "content_sanskrit": "तच्छ्रुत्वा वचनं तस्य विश्वामित्रस्य धीमतः।\nशतानन्दो महातेजा रामं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000051013, "chapter_id": 9051, "verse_number": "१-५१-१३", "content_sanskrit": "स्वागतं ते नरश्रेष्ठ दिष्ट्या प्राप्तोऽसि राघव।\nविश्वामित्रं पुरस्कृत्य महर्षिमपराजितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000051014, "chapter_id": 9051, "verse_number": "१-५१-१४", "content_sanskrit": "अचिन्त्यकर्मा तपसा ब्रह्मर्षिरमितप्रभः।\nविश्वामित्रो महातेजा वेद्‍म्येनं परमां गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000051015, "chapter_id": 9051, "verse_number": "१-५१-१५", "content_sanskrit": "नास्ति धन्यतरो राम त्वत्तोऽन्यो भुवि कश्चन।\nगोप्ता कुशिकपुत्रस्ते येन तप्तं महत्तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000051016, "chapter_id": 9051, "verse_number": "१-५१-१६", "content_sanskrit": "श्रूयतां चाभिधास्यामि कौशिकस्य महात्मनः।\nयथाबलं यथातत्त्वं तन्मे निगदतः शृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000051017, "chapter_id": 9051, "verse_number": "१-५१-१७", "content_sanskrit": "राजाऽऽसीदेष धर्मात्मा दीर्घकालमरिंदमः।\nधर्मज्ञः कृतविद्यश्च प्रजानां च हिते रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000051018, "chapter_id": 9051, "verse_number": "१-५१-१८", "content_sanskrit": "प्रजापतिसुतस्त्वासीत् कुशो नाम महीपतिः।\nकुशस्य पुत्रो बलवान् कुशनाभः सुधार्मिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000051019, "chapter_id": 9051, "verse_number": "१-५१-१९", "content_sanskrit": "कुशनाभसुतस्त्वासीद् गाधिरित्येव विश्रुतः।\nगाधेः पुत्रो महातेजा विश्वामित्रो महामुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000051020, "chapter_id": 9051, "verse_number": "१-५१-२०", "content_sanskrit": "विश्वामित्रो महातेजाः पालयामास मेदिनीम्।\nबहुवर्षसहस्राणि राजा राज्यमकारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000051021, "chapter_id": 9051, "verse_number": "१-५१-२१", "content_sanskrit": "कदाचित् तु महातेजा योजयित्वा वरूथिनीम्।\nअक्षौहिणीपरिवृतः परिचक्राम मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000051022, "chapter_id": 9051, "verse_number": "१-५१-२२", "content_sanskrit": "नगराणि च राष्ट्राणि सरितश्च महागिरीन्।\nआश्रमान् क्रमशो राजा विचरन्नाजगाम ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000051023, "chapter_id": 9051, "verse_number": "१-५१-२३", "content_sanskrit": "वसिष्ठस्याश्रमपदं नानापुष्पलताद्रुमम्।\nनानामृगगणाकीर्णं सिद्धचारणसेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000051024, "chapter_id": 9051, "verse_number": "१-५१-२४", "content_sanskrit": "देवदानवगन्धर्वैः किंनरैरुपशोभितम्।\nप्रशान्तहरिणाकीर्णं द्विजसङ्घनिषेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000051025, "chapter_id": 9051, "verse_number": "१-५१-२५", "content_sanskrit": "ब्रह्मर्षिगणसंकीर्णं देवर्षिगणसेवितम्।\nतपश्चरणसंसिद्धैरग्निकल्पैर्महात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000051026, "chapter_id": 9051, "verse_number": "१-५१-२६", "content_sanskrit": "सततं संकुलं श्रीमद‍्ब्रह्मकल्पैर्महात्मभिः।\nअब्भक्षैर्वायुभक्षैश्च शीर्णपर्णाशनैस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000051027, "chapter_id": 9051, "verse_number": "१-५१-२७", "content_sanskrit": "फलमूलाशनैर्दान्तैर्जितदोषैर्जितेन्द्रियैः।\nऋषिभिर्वालखिल्यैश्च जपहोमपरायणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000051028, "chapter_id": 9051, "verse_number": "१-५१-२८", "content_sanskrit": "अन्यैर्वैखानसैश्चैव समन्तादुपशोभितम्।\nवसिष्ठस्याश्रमपदं ब्रह्मलोकमिवापरम्।\nददर्श जयतां श्रेष्ठो विश्वामित्रो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000051029, "chapter_id": 9051, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे एकपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]