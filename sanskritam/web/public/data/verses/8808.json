[{"id": 40000829, "chapter_id": 8808, "verse_number": "1", "content_sanskrit": "मुनेर्वचनमक्लीबं श्रुत्वा नरवरात्मज:। राघव: प्राञ्जलिर्भूत्वा प्रत्युवाच दृढव्रत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40000830, "chapter_id": 8808, "verse_number": "2", "content_sanskrit": "पितुर्वचननिर्देशात्पितुर्वचनगौरवात्। वचनं कौशिकस्येति कर्तव्यमविशङ्कया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40000831, "chapter_id": 8808, "verse_number": "3", "content_sanskrit": "अनुशिष्टोऽस्म्ययोध्यायां गुरुमध्ये महात्मना। पित्रा दशरथेनाहं नावज्ञेयं हि तद्वच: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40000832, "chapter_id": 8808, "verse_number": "4", "content_sanskrit": "सोऽहं पितुर्वचश्श्रुत्वा शासनाद्ब्रह्मवादिन:। करिष्यामि न सन्देहस्ताटकावधमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40000833, "chapter_id": 8808, "verse_number": "5", "content_sanskrit": "गोब्राह्मणहितार्थाय देशस्यास्य सुखाय च। तव चैवाप्रमेयस्य वचनं कर्तुमुद्यत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40000834, "chapter_id": 8808, "verse_number": "6", "content_sanskrit": "एवमुक्त्वा धनुर्मध्ये बध्वा मुष्टिमरिन्दम:। ज्याशब्दमकरोत्तीव्रं दिशश्शब्देन नादयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40000835, "chapter_id": 8808, "verse_number": "7", "content_sanskrit": "तेन शब्देन वित्रस्तास्ताटकावनवासिन:। ताटका च सुसंक्रुद्धा तेन शब्देन मोहिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40000836, "chapter_id": 8808, "verse_number": "8", "content_sanskrit": "तं शब्दमभिनिध्याय राक्षसी क्रोधमूर्छिता। श्रुत्वा चाभ्यद्रवद्वेगाद्यतश्शब्दो विनिस्सृत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40000837, "chapter_id": 8808, "verse_number": "9", "content_sanskrit": "तां दृष्ट्वा राघव: क्रुद्धां विकृतां विकृताननाम्। प्रमाणेनातिवृद्धां च लक्ष्मणं सोऽभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40000838, "chapter_id": 8808, "verse_number": "10", "content_sanskrit": "पश्य लक्ष्मण यक्षिण्या भैरवं दारुणं वपु:। भिद्येरन् दर्शनादस्या भीरूणां हृदयानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40000839, "chapter_id": 8808, "verse_number": "11", "content_sanskrit": "एनां पश्य दुराधर्षां मायाबलसमन्विताम्। विनिवृत्तां करोम्यद्य हृतकर्णाग्रनासिकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40000840, "chapter_id": 8808, "verse_number": "12", "content_sanskrit": "न ह्येनामुत्सहे हन्तुं स्त्रीस्वभावेन रक्षिताम्। वीर्यं चास्यां गतिं चापि हनिष्यामीति मे मति: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40000841, "chapter_id": 8808, "verse_number": "13", "content_sanskrit": "एवं ब्रुवाणे रामे तु ताटका क्रोधमूर्छिता। उद्यम्य बाहू गर्जन्ती राममेवाभ्यधावत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40000842, "chapter_id": 8808, "verse_number": "14", "content_sanskrit": "विश्वामित्रस्तु ब्रह्मर्षिर्हुङ्कारेणाभिभर्त्स्यताम्। स्वस्ति राघवयोरस्तु जयं चैवाभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40000843, "chapter_id": 8808, "verse_number": "15", "content_sanskrit": "उद्धून्वाना रजो घोरं ताटका राघवावुभौ। रजोमोहेन महता मुहूर्तं सा व्यमोहयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40000844, "chapter_id": 8808, "verse_number": "16", "content_sanskrit": "ततो मायां समास्थाय शिलावर्षेण राघवौ। अवाकिरत्सुमहता ततश्चुक्रोध राघव: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40000845, "chapter_id": 8808, "verse_number": "17", "content_sanskrit": "शिलावर्षं महत्तस्याश्शरवर्षेण राघव:। प्रतिहत्योपधावन्त्या: करौ चिच्छेद पत्रिभि: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40000846, "chapter_id": 8808, "verse_number": "18", "content_sanskrit": "ततश्छिन्नभुजां श्रान्तामभ्याशे परिगर्जतीम्। सौमित्रिरकरोत्क्रोधाद्धृतकर्णाग्रनासिकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40000847, "chapter_id": 8808, "verse_number": "19", "content_sanskrit": "कामरूपधरा सद्य: कृत्वा रूपाण्यनेकश: । अन्तर्धानं गता यक्षी मोहयन्तीव मायया ॥ अश्मवर्षं विमुञ्चन्ती भैरवं विचचार ह ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40000848, "chapter_id": 8808, "verse_number": "20", "content_sanskrit": "ततस्तावश्मवर्षेण कीर्यमाणौ समन्तत: ॥ दृष्ट्वा गाधिसुतश्श्रीमानिदं वचनमब्रवीत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40000849, "chapter_id": 8808, "verse_number": "21", "content_sanskrit": "अलं ते घृणया राम पापैषा दुष्टचारिणी ॥ यज्ञविघ्नकरी यक्षी पुरावर्धति मायया।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40000850, "chapter_id": 8808, "verse_number": "22", "content_sanskrit": "वध्यतां तावदेवैषा पुरा सन्ध्या प्रवर्तते ॥ रक्षांसि सन्ध्याकालेषु दुर्धर्षाणि भवन्ति वै।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40000851, "chapter_id": 8808, "verse_number": "23", "content_sanskrit": "इत्युक्तस्तु तदा यक्षी अश्मवृष्ट्याभिवर्षतीम् ॥ दर्शयन् शब्दवेधित्वं तां रुरोध स सायकै:।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40000852, "chapter_id": 8808, "verse_number": "24", "content_sanskrit": "सा रुद्धा शरजालेन मायाबलसमन्विता ॥ अभिदुद्राव काकुत्स्थं लक्ष्मणं च विनेदुषी।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40000853, "chapter_id": 8808, "verse_number": "25", "content_sanskrit": "तामापतन्तीं वेगेन विक्रान्तामशनीमिव ॥ शरेणोरसि विव्याथ सा पपात ममार च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40000854, "chapter_id": 8808, "verse_number": "26", "content_sanskrit": "तां हतां भीमसङ्काशां दृष्ट्वा सुरपतिस्तदा ॥ साधु साध्विति काकुत्स्थं सुराश्च समपूजयन्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40000855, "chapter_id": 8808, "verse_number": "27", "content_sanskrit": "उवाच परमप्रीत स्सहस्राक्ष: पुरन्दर: ॥ सुराश्च सर्वे संहृष्टा विश्वामित्रमथाब्रुवन्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40000856, "chapter_id": 8808, "verse_number": "28", "content_sanskrit": "मुने कौशिक भद्रं ते सेन्द्रास्सर्वे मरुद्गणा: ॥ तोषिता: कर्मणाऽनेन स्नेहं दर्शय राघवे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40000857, "chapter_id": 8808, "verse_number": "29", "content_sanskrit": "प्रजापतेर्भृशाश्वस्य पुत्रान् सत्यपराक्रमान् ॥ तपोबलभृतो ब्रह्मन् राघवाय निवेदय।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40000858, "chapter_id": 8808, "verse_number": "30", "content_sanskrit": "पात्रभूतश्च ते ब्रह्मंस्तवानुगमने धृत: ॥ कर्तव्यं च महत्कर्म सुराणां राजसूनुना।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40000859, "chapter_id": 8808, "verse_number": "31", "content_sanskrit": "एवमुक्त्वा सुरास्सर्वे हृष्टा जग्मुर्यथागतम् ॥ विश्वामित्रं पुरस्कृत्य ततस्सन्ध्या प्रवर्तते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40000860, "chapter_id": 8808, "verse_number": "32", "content_sanskrit": "ततो मुनिवर: प्रीतस्ताटकावधतोषित: ॥ मूर्ध्नि राममुपाघ्राय इदं वचनमब्रवीत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40000861, "chapter_id": 8808, "verse_number": "33", "content_sanskrit": "इहाद्य रजनीं राम वसेम शुभदर्शन ॥ श्व: प्रभाते गमिष्यामस्तदाश्रमपदं मम।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40000862, "chapter_id": 8808, "verse_number": "34", "content_sanskrit": "विश्वामित्रवच: श्रुत्वा हृष्टो दशरथात्मज: ॥ उवास रजनीं तत्र ताटकाया वने सुखम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40000863, "chapter_id": 8808, "verse_number": "35", "content_sanskrit": "मुक्तशापं वनं तच्च तस्मिन्नेव तदाहनि ॥ रमणीयं विबभ्राज यथा चैत्ररथं वनम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40000864, "chapter_id": 8808, "verse_number": "36", "content_sanskrit": "निहत्य तां यक्षसुतां स राम: प्रशस्यमानस्सुरसिद्धसङ्घै:। उवास तस्मिन्मुनिना सहैव प्रभातवेलां प्रतिबोध्यमान: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]