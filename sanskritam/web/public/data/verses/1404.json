[{"id": 2019403, "chapter_id": 1404, "verse_number": "३-४२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2019404, "chapter_id": 1404, "verse_number": "३-४२-१", "content_sanskrit": "गतेषु लोकपालेषु पार्थः शत्रुनिबर्हणः।\nचिन्तयामास राजेन्द्र देवराजरथागमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2019405, "chapter_id": 1404, "verse_number": "३-४२-२", "content_sanskrit": "तस्य चिन्तयमानस्य गुडाकेशस्य धीमतः।\nरथो मातलिसंयुक्त आजगाम महाप्रभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2019406, "chapter_id": 1404, "verse_number": "३-४२-३", "content_sanskrit": "नभो वितिमिरं कुर्वञ्जलदान्पाटयन्निव।\nदिशः संपूरयन्नादैर्महामेघरवोपमैः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2019407, "chapter_id": 1404, "verse_number": "३-४२-४", "content_sanskrit": "असयः शक्तयो भीमा गदाश्चोग्रप्रदर्शनाः।\nदिव्यप्रभावाः प्रासाश्च विद्युतश्च महाप्रभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2019408, "chapter_id": 1404, "verse_number": "३-४२-५", "content_sanskrit": "तथैवाशनयश्चैव चक्रयुक्तास्तुलागुडाः।\nवायुस्फोटाः सनिर्घाताः शङ्खमेघस्वनास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2019409, "chapter_id": 1404, "verse_number": "३-४२-६", "content_sanskrit": "तत्रनागा महाकाया ज्वलितास्याः सुदारुणाः।\nसिताभ्रकूटप्रतिमाः संहताश्च यथोपलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2019410, "chapter_id": 1404, "verse_number": "३-४२-७", "content_sanskrit": "दशवाजिसहस्राणि हरीणां वातरंहसाम्।\nवहन्ति यं नेत्रमुषं दिव्यं मायामयं रथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2019411, "chapter_id": 1404, "verse_number": "३-४२-८", "content_sanskrit": "तत्रापश्यन्महानीलं वैजयन्तं महाप्रभम्।\nध्वजमिन्दीवरश्यामं वंशं कनकभूषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2019412, "chapter_id": 1404, "verse_number": "३-४२-९", "content_sanskrit": "तस्मिन्रथे स्थितं सूतं तप्तहेमविभूषितम्।\nदृष्ट्वा पार्थो महाबाहुर्देवराजमतर्कयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2019413, "chapter_id": 1404, "verse_number": "३-४२-१०", "content_sanskrit": "तथा तर्कयतस्तस्य फल्गुनस्याथ मातलिः।\nसन्नतः प्रस्थितो भूत्वा वाक्यमर्जुनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2019414, "chapter_id": 1404, "verse_number": "३-४२-११", "content_sanskrit": "भोभो शक्रात्मज श्रीमञ्शक्रस्त्वां द्रष्टुमिच्छति।\nआरोहतु भवाञ्शीघ्रं रथमिन्द्रस्य संभतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2019415, "chapter_id": 1404, "verse_number": "३-४२-१२", "content_sanskrit": "आह माममरश्रेष्ठः पिता तव शतक्रतुः।\nकुन्तीसुतमिह प्राप्तं पश्यन्तु त्रिदशालयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2019416, "chapter_id": 1404, "verse_number": "३-४२-१३", "content_sanskrit": "एष शक्रः परिवृतो देवैर्ऋषिगणैस्तथा।\nगन्धर्वैरप्सरोभिश्च त्वां दिदृक्षुः प्रतीक्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2019417, "chapter_id": 1404, "verse_number": "३-४२-१४", "content_sanskrit": "अस्माल्लोकाद्देवलोकं पाकशासनशासनात्।\nमारोह त्वं मया सार्धं लब्धास्त्रः पुनरेष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2019418, "chapter_id": 1404, "verse_number": "३-४२-१५x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2019419, "chapter_id": 1404, "verse_number": "३-४२-१५", "content_sanskrit": "मातले गच्छ शीघ्रं त्वमारोहस्व रथोत्तमम्।\nराजसूयाश्वमेधानां शतैरपि सुदुर्लभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2019420, "chapter_id": 1404, "verse_number": "३-४२-१६", "content_sanskrit": "पार्थिवैः सुमहाभागैर्यज्वभिर्भूरिदक्षिणैः।\nदैवतैर्वा दुरारोहं दानवैर्वा रथोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2019421, "chapter_id": 1404, "verse_number": "३-४२-१७", "content_sanskrit": "नातप्ततपसा शक्य एष दिव्यो महारथः।\nद्रष्टुं वाऽप्यथवा स्प्रष्टुमारोढुं कुत एव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2019422, "chapter_id": 1404, "verse_number": "३-४२-१८", "content_sanskrit": "त्वयि मतिष्ठिते साधो रथस्थे स्थिरवाजिनि।\nपश्चादहमथारोक्ष्ये मुकृती सत्पथं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2019423, "chapter_id": 1404, "verse_number": "३-४२-१९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2019424, "chapter_id": 1404, "verse_number": "३-४२-१९", "content_sanskrit": "तस्यतद्वचनं श्रुत्वा मातलिः शक्रसारथिः।\nआरुरोह रथं शीघ्रं हयाञ्जग्राह रश्मिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2019425, "chapter_id": 1404, "verse_number": "३-४२-२०", "content_sanskrit": "ततोऽर्जुनो हृष्टमना गङ्गायामाप्लुतः शुचिः।\nजजाप जप्यं कौन्तेयो विधिवत्कुरुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2019426, "chapter_id": 1404, "verse_number": "३-४२-२१", "content_sanskrit": "ततः पितृन्यथान्यायं तर्पयित्वा यथाविधि।\nमन्दरं शैलराजं तमाप्रष्टुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2019427, "chapter_id": 1404, "verse_number": "३-४२-२२", "content_sanskrit": "साधूनां पुण्यशीलानां मुनीनां पुण्यकर्मणाम्।\nत्वं सदा संश्रयः शैल स्वर्गमार्गाभिकाङ्क्षिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2019428, "chapter_id": 1404, "verse_number": "३-४२-२३", "content_sanskrit": "त्वत्प्रसादात्सदा शैल ब्राह्मणाः क्षत्रिया विशः।\nस्वर्गं प्राप्ताश्चरन्ति स्म देवैः सह गतव्यथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2019429, "chapter_id": 1404, "verse_number": "३-४२-२४", "content_sanskrit": "अद्रिराज महाशैल मुनिसंश्रय तीर्थवन्।\nगच्छाम्यामन्त्रयित्वा त्वां सुखमस्म्युषितस्त्वयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2019430, "chapter_id": 1404, "verse_number": "३-४२-२५", "content_sanskrit": "तव सानूनि कुञ्जाश्च नद्यः प्रस्रवणानि च।\nतीर्थानि च सुपुण्यानि मया दृष्टान्यनेकशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2019431, "chapter_id": 1404, "verse_number": "३-४२-२६", "content_sanskrit": "सुसुगन्धाश्च वैर्योघास्त्वच्छरीरविनिःसृताः।\nअमृतास्वादसृशाः पीताः प्रस्रवणोदकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2019432, "chapter_id": 1404, "verse_number": "३-४२-२७", "content_sanskrit": "शिशुर्यथा पितुश्चाङ्के सुखं शेते तटे तथा।\nमया तवाङ्के ललितं शैलराज महाप्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2019433, "chapter_id": 1404, "verse_number": "३-४२-२८", "content_sanskrit": "अप्सरोगणसंकीर्णए ब्रह्मघोषानुनादिते।\nसुखमस्म्युषितः शैल तव सानुषु नित्यदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2019434, "chapter_id": 1404, "verse_number": "३-४२-२९", "content_sanskrit": "एवमुक्त्वार्जुनः शैलमामन्त्र्य परवीरहा।\nआरुरोह रथं दिव्यं द्योतयन्निव भास्करः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2019435, "chapter_id": 1404, "verse_number": "३-४२-३०", "content_sanskrit": "स तेनादित्यरूपेण दिव्येनाद्भुतकर्मणा।\nऊर्ध्वमाचक्रमे धीमान्प्रहृष्टः कुरुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2019436, "chapter_id": 1404, "verse_number": "३-४२-३१", "content_sanskrit": "सोऽदर्शनपथं यातो मर्त्यानां धर्मचारिणाम्।\nददर्शाद्भुतरूपाणि विमानानि सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2019437, "chapter_id": 1404, "verse_number": "३-४२-३२", "content_sanskrit": "न तत्र सूर्यः सोमो वा द्योतते न च पावकः।\nस्वयैव प्रभया तत्र द्योतन्ते पुण्यलब्धया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2019438, "chapter_id": 1404, "verse_number": "३-४२-३३", "content_sanskrit": "तारारूपाणि यानीह दृश्यन्ते द्युतिमन्ति वै।\nआकाशे विप्रकृष्टत्वात्तनूनि सुमहान्त्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2019439, "chapter_id": 1404, "verse_number": "३-४२-३४", "content_sanskrit": "तानि तत्र प्रभास्वन्ति रूपवन्ति च पाण्डवः।\nददर्श स्वेषु धिष्ण्येषु दीप्तिमन्ति स्वयाऽर्चिषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2019440, "chapter_id": 1404, "verse_number": "३-४२-३५", "content_sanskrit": "तत्र राजर्षयः सिद्धा वीराश्च निहता युधि।\nतपसा च जितं स्वर्गं संपेतुः शतसङ्घशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2019441, "chapter_id": 1404, "verse_number": "३-४२-३६", "content_sanskrit": "गन्धर्वाणां सहस्राणि मूर्यज्वलिततेजसाम्।\nगुह्यकारनामृषीणां च तथैवाप्सरसां गणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2019442, "chapter_id": 1404, "verse_number": "३-४२-३७", "content_sanskrit": "लोकानात्मप्रभान्पश्यन्फल्गुनो विस्मयान्वितः।\nपप्रच्छ मातलिं प्रीत्या स चाप्येनमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2019443, "chapter_id": 1404, "verse_number": "३-४२-३८", "content_sanskrit": "एते सुकृतिनः पार्थ स्वेषु धिष्ण्येष्ववस्थिताः।\nतान्दृष्टवानसि विभो तारारूपाणि भूतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2019444, "chapter_id": 1404, "verse_number": "३-४२-३९", "content_sanskrit": "ततोऽपश्यत्स्थितं द्वारि मत्तं विजयिनं गजम्।\nऐरावतं चतुर्दन्तं कैलासमिव शृङ्गिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2019445, "chapter_id": 1404, "verse_number": "३-४२-४०", "content_sanskrit": "स सिद्धमार्गमाक्रम्य कुरुपाण्डवसत्तमः।\nव्यरोचत यथापूर्वं मान्धाता पार्थिवोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2019446, "chapter_id": 1404, "verse_number": "३-४२-४१", "content_sanskrit": "अभिचक्राम लोकान्स राज्ञां राजीवलोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2019447, "chapter_id": 1404, "verse_number": "३-४२-४२", "content_sanskrit": "[एवं स संक्रमंस्तत्र स्वर्गलोके महायशाः ।]\nततो ददर्श शक्रस्य पुरीं ताममरावतीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2019448, "chapter_id": 1404, "verse_number": "", "content_sanskrit": "॥ इति रश्रीमन्महाभारते अरण्यपर्वणि इन्द्रलोकाभिगमनपर्वणि द्विचत्वारिंशोऽध्यायः ॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]