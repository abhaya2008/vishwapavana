[{"id": 2020422, "chapter_id": 1426, "verse_number": "३-६४-०x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2020423, "chapter_id": 1426, "verse_number": "३-६४-१", "content_sanskrit": "तस्मिन्नन्तर्हिते नागे प्रययौ नैषधो नलः।\nऋतुपर्णस्य नगरं प्राविशद्दशमेऽहनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2020424, "chapter_id": 1426, "verse_number": "३-६४-२", "content_sanskrit": "स राजानमुपातिष्ठद्बाहुकोऽहमिति ब्रुवन्।\nअश्वानां वाहने युक्तः पृथिव्यां नास्ति मत्समः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2020425, "chapter_id": 1426, "verse_number": "३-६४-३", "content_sanskrit": "अर्थकृच्छ्रेषु चैवाहं प्रष्टव्यो नैपुणेषु च।\nअन्नसंस्कारमपि च जानाम्यन्यैर्विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2020426, "chapter_id": 1426, "verse_number": "३-६४-४", "content_sanskrit": "यानि शिल्पानि लोकेऽस्मिन्यच्चैवान्यत्सुदुष्करम्।\nसर्वं यतिष्ये तत्कर्तुमृतुपर्ण भरस्व माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2020427, "chapter_id": 1426, "verse_number": "३-६४-५", "content_sanskrit": "`इत्युक्तः स नलेनाथ ऋतुपर्णो नराधिपः।\nउवाच सुप्रीतमनास्तं प्रेक्ष्य च महीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2020428, "chapter_id": 1426, "verse_number": "३-६४-६", "content_sanskrit": "वसबाहुक भद्रं ते सर्वमेतत्करिष्यसि।\nशीघ्रयाने सदा बुद्धिर्ध्रियते मे विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2020429, "chapter_id": 1426, "verse_number": "३-६४-७", "content_sanskrit": "स त्वमातिष्ठ योगं तं येन शीध्रां हया मम।\nभवेयुरश्वाध्यक्षोसि वेतनं ते शतंशतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2020430, "chapter_id": 1426, "verse_number": "३-६४-८", "content_sanskrit": "त्वामुपस्थास्यतश्चैव नित्यं वार्ष्णेयजीवलौ।\nएताभ्यां रंस्यसे सार्धं वस वै मयि बाहुक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2020431, "chapter_id": 1426, "verse_number": "३-६४-९x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2020432, "chapter_id": 1426, "verse_number": "३-६४-९", "content_sanskrit": "एवमुक्तो नलस्तेन न्यवसत्तत्रपूजितः।\nऋतुपर्णस्य नगरे सहवार्ष्णेयजीवलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2020433, "chapter_id": 1426, "verse_number": "३-६४-१०", "content_sanskrit": "स वै तत्रावसद्राजा वैदर्भीमनुचिन्तयन्।\nसायंसायं सदा चेमं श्लोकमेकं जगाद ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2020434, "chapter_id": 1426, "verse_number": "३-६४-११", "content_sanskrit": "क्व नु सा क्षुत्पिपासार्ता श्रान्ता शेते तपस्विनी।\nस्मरन्ती तस्य मन्दस्य कं वाऽऽसाद्योपतिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2020435, "chapter_id": 1426, "verse_number": "३-६४-१२", "content_sanskrit": "एवं ब्रुवन्तं राजानं निशायां जीवलोऽब्रवीत्।\nकामेनां शोचसे नित्यं श्रोतुमिच्छामि बाहुक।\nआयुष्मन्कस्य वा नारी यामेवमनुशोचसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2020436, "chapter_id": 1426, "verse_number": "३-६४-१३", "content_sanskrit": "तमुवाच नलो राजा मन्दप्रज्ञस्य कस्यचित्।\nआसीद्बहुमता नारी तस्या दृढतरश्च सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2020437, "chapter_id": 1426, "verse_number": "३-६४-१४", "content_sanskrit": "स वै केनचिदर्थेन तया मन्दो व्ययुज्यत।\nविप्रयुक्तः स मन्दात्मा भ्रमत्यसुखपीडितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2020438, "chapter_id": 1426, "verse_number": "३-६४-१५", "content_sanskrit": "दह्यमानः स शोकेन दिवारात्रमतन्द्रितः।\nनिशाकाले स्मरंस्तस्याः श्लोकमेकं स्म गायति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2020439, "chapter_id": 1426, "verse_number": "३-६४-१६", "content_sanskrit": "स विभ्रमन्महीं सर्वां क्वचिदासाद्य किंचन।\nवसत्यनर्हस्तद्दुःखं भूय एवानुसंस्मरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2020440, "chapter_id": 1426, "verse_number": "३-६४-१७", "content_sanskrit": "सा तु तं पुरुषं नारी कृच्छेऽप्यनुगता वने।\nत्यक्ता तेनाल्पभाग्येन दुष्करं यदि जीवति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2020441, "chapter_id": 1426, "verse_number": "३-६४-१८", "content_sanskrit": "एका बालाऽनभिज्ञा च मार्गमाणाऽतथोचिता।\nक्षुत्पिपासापरीताङ्गी दुष्करं यदि जीवति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2020442, "chapter_id": 1426, "verse_number": "३-६४-१९", "content_sanskrit": "श्वापदाचरिते नित्यं वने महति दारुणे।\nत्यक्ता तेनाल्पभाग्येन मन्दप्रज्ञेन मारिष ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2020443, "chapter_id": 1426, "verse_number": "३-६४-२०", "content_sanskrit": "इत्येवं नैषधो राजा दमयन्तीमनुस्मरन्।\nअज्ञातवासं न्यवसद्राज्ञस्तस्य नवेशने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2020444, "chapter_id": 1426, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि नलोपाख्यानपर्वणि चतुःषष्टितमोऽध्यायः ॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]