[{"id": 7004107000, "chapter_id": 24107, "verse_number": "४-५६-१", "content_sanskrit": "स्कंद उवाच ।\nअथेशाज्ञां समादाय गजवक्त्रः प्रतस्थिवान् ।\nशंभोः काश्यागमोपायं चिंतयन्मंदराद्रितः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004107001, "chapter_id": 24107, "verse_number": "४-५६-२", "content_sanskrit": "प्राप्य वाराणसीं तूर्णमाशु स्यंदनगो विभुः ।\nवाडवीं मूर्तिमालंब्य प्राविशच्छकुनैः स्तुतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004107002, "chapter_id": 24107, "verse_number": "४-५६-३", "content_sanskrit": "नक्षत्रपाठको भूत्वा वृद्धः प्रत्यवरोधगः ।\nचचार मध्ये नगरं पौराणां प्रीतिमावहन् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004107003, "chapter_id": 24107, "verse_number": "४-५६-४", "content_sanskrit": "स्वयमेव निशाभागे स्वप्नं संदर्शयन्नृणाम् ।\nप्रातस्तेषां गृहान्गत्वा तेषां वक्ति बलाबलम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004107004, "chapter_id": 24107, "verse_number": "४-५६-५", "content_sanskrit": "भवद्भिरद्य रात्रौ यद्दृष्टं स्वप्नविचेष्टितम् ।\nभवत्कौतूहलोत्पत्त्यै तदेव कथयाम्यहम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004107005, "chapter_id": 24107, "verse_number": "४-५६-६", "content_sanskrit": "स्वपता भवता रात्रौ तुर्ये यामे महाह्रदः ।\nअदर्शि तत्र च भवान्मज्जन्मज्जंस्तटंगतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004107006, "chapter_id": 24107, "verse_number": "४-५६-७", "content_sanskrit": "तदंबुपिच्छिले पंके मग्नोन्मग्नोसि भूरिशः ।\nदुःस्वप्नस्यास्य च महान्विपाकोति भयप्रदः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004107007, "chapter_id": 24107, "verse_number": "४-५६-८", "content_sanskrit": "काषायवसनो मुंडः प्रैक्ष्यहो भवतापि यः ।\nपरितापं महानेष जनयिष्यति दारुणम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004107008, "chapter_id": 24107, "verse_number": "४-५६-९", "content_sanskrit": "रात्रौ सूर्यग्रहो दृष्टो महानिष्टकरो ध्रुवम् ।\nऐंद्रधनुर्द्वयं रात्रौ यदलोकि न तच्छुभम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004107009, "chapter_id": 24107, "verse_number": "४-५६-१०", "content_sanskrit": "प्रतीच्यां रविरागत्य प्रोद्यंतं व्योम्नि शीतगुम् ।\nपातयामास भूपृष्ठे तद्राज्यभयसूचकम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004107010, "chapter_id": 24107, "verse_number": "४-५६-११", "content_sanskrit": "युगपत्केतुयुगलं युध्यमानं परस्परम् ।\nयददर्शि न तद्भद्रं राष्ट्रभंगाय केवलम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004107011, "chapter_id": 24107, "verse_number": "४-५६-१२", "content_sanskrit": "विशीर्यत्केशदशनं नीयमानं च दक्षिणे ।\nआत्मानं यत्समद्राक्षीः कुटुंबस्यापि भीषणम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004107012, "chapter_id": 24107, "verse_number": "४-५६-१३", "content_sanskrit": "प्रासादध्वजभंगोयस्त्वयैक्षत निशाक्षये ।\nराज्यक्षयकरं विद्धि महोत्पाताय निश्चितम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004107013, "chapter_id": 24107, "verse_number": "४-५६-१४", "content_sanskrit": "नगरी प्लाविता स्वप्ने तरंगैः क्षीरनीरधेः ।\nपक्षैस्त्रिचतुरैः शंके महाशंकां पुरौकसाम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004107014, "chapter_id": 24107, "verse_number": "४-५६-१५", "content_sanskrit": "स्वप्ने वानरयानेन यत्त्वमूढोसि दक्षिणाम् ।\nअतस्तद्वंचनोपायः पुरत्यागो महामते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004107015, "chapter_id": 24107, "verse_number": "४-५६-१६", "content_sanskrit": "रुदती या त्वया दृष्टा महिलैका निशात्यये ।\nमुक्तकेशी विवसना सा नारी श्रीरिवोद्गता ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004107016, "chapter_id": 24107, "verse_number": "४-५६-१७", "content_sanskrit": "देवालयस्य कलशो यत्त्वया वीक्षितः पतन् ।\nदिनैः कतिपयैरेव राज्यभंगो भविष्यति ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004107017, "chapter_id": 24107, "verse_number": "४-५६-१८", "content_sanskrit": "पुरी परिवृता स्वप्ने मृगयूथैः समंततः ।\nरोरूयमाणैरत्यर्थं मासेनैवोद्वसी भवेत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004107018, "chapter_id": 24107, "verse_number": "४-५६-१९", "content_sanskrit": "आतायियूकगृध्राद्यैः पुरीमुपरिचारिभिः ।\nसूच्यतेत्याहितं किंचिद्ध्रुवमत्र निवासिनाम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004107019, "chapter_id": 24107, "verse_number": "४-५६-२०", "content_sanskrit": "स्वप्नोत्पातानिति बहूञ्शंसञ्शंसन्नितस्ततः ।\nबहूनुच्चाटयांचक्रे स विघ्नेशः पुरौकसः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004107020, "chapter_id": 24107, "verse_number": "४-५६-२१", "content_sanskrit": "केषांचित्पुरतो वादीद्ग्रहचारं प्रदर्शयन् ।\nएकराशिस्थिताः सौरि सितभौमा न शोभनाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004107021, "chapter_id": 24107, "verse_number": "४-५६-२२", "content_sanskrit": "सोयं धूमग्रहो व्योम्नि भित्त्वा सप्तर्षिमंडलम् ।\nप्रयातः पश्चिमामाशां स नाशाय विशांपतेः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004107022, "chapter_id": 24107, "verse_number": "४-५६-२३", "content_sanskrit": "अतिचारगतो मंदः पुनर्वक्राध्व संस्थितः ।\nपापग्रहसमायुक्तो न युक्तोयमिहेष्यते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004107023, "chapter_id": 24107, "verse_number": "४-५६-२४", "content_sanskrit": "व्यतीते वासरे योयं भूकंपः समपद्यत ।\nकंपं जनयतेऽतीव हृदो मेपि पुरौकसः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004107024, "chapter_id": 24107, "verse_number": "४-५६-२५", "content_sanskrit": "उदीच्यादक्षिणाशायां येयमुल्का प्रधाविता ।\nविलीना च वियत्येव स निर्घातं न सा शुभा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004107025, "chapter_id": 24107, "verse_number": "४-५६-२६", "content_sanskrit": "उन्मूलितो महामूलो महानिलरयेण यः ।\nचत्वरे चैत्यवृक्षोयं महोत्पातं प्रशंसति ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004107026, "chapter_id": 24107, "verse_number": "४-५६-२७", "content_sanskrit": "सूर्योदयमनुप्राप्य प्राच्यां शुष्कतरूपरि ।\nकरटो रारटीत्येष कटूत्कट भयप्रदः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004107027, "chapter_id": 24107, "verse_number": "४-५६-२८", "content_sanskrit": "मध्ये विपणि यतूर्णं कौचिच्चारण्यचारिणौ ।\nमृगौ मृगयतां यातौ पौराणां पुरतोऽहितौ ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004107028, "chapter_id": 24107, "verse_number": "४-५६-२९", "content_sanskrit": "रसालशालमुकुलं वीक्ष्यते यच्छरद्यदः ।\nमहाकालभयं मन्येप्यकालेपि पुरौकसाम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004107029, "chapter_id": 24107, "verse_number": "४-५६-३०", "content_sanskrit": "साध्वसंजनयित्वेति केचिदुच्चाटिताः पुरः ।\nतेन विघ्नकृतापौराः कपटद्विजरूपिणा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004107030, "chapter_id": 24107, "verse_number": "४-५६-३१", "content_sanskrit": "अथ मध्येवरोधं स प्रविश्य निजमायया ।\nदृष्टार्थमेव कथयन्स्त्रीणां विस्रंभभूरभूत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004107031, "chapter_id": 24107, "verse_number": "४-५६-३२", "content_sanskrit": "तव पुत्रशतं जज्ञे सप्तोनं शुभलक्षणे ।\nतेष्वेकस्तुरगारूढो बाह्याल्यां पतितो मृतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004107032, "chapter_id": 24107, "verse_number": "४-५६-३३", "content_sanskrit": "अंतर्वत्नी त्वियं कन्या जनयिष्यति शोभनाम् ।\nएषा हि दुर्भगा पूर्वं सांप्रतं सुभगाऽभवत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004107033, "chapter_id": 24107, "verse_number": "४-५६-३४", "content_sanskrit": "असौ हि राज्ञो राज्ञीनामत्यंतमिहवल्लभा ।\nमुक्तालंकृतिरेतस्यै राज्ञा दत्ता निजोरसः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004107034, "chapter_id": 24107, "verse_number": "४-५६-३५", "content_sanskrit": "पंचसप्तदिनान्येव जातानीतीह तर्क्यते ।\nअस्यै राज्ञा प्रसादेन ग्रामौ दातुमुदीरितौ ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004107035, "chapter_id": 24107, "verse_number": "४-५६-३६", "content_sanskrit": "इति दृष्टार्थकथनै राज्ञीमान्योभवद्द्विजः ।\nवर्णयंति च ता राज्ञः परोक्षेपि गुणान्बहून् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004107036, "chapter_id": 24107, "verse_number": "४-५६-३७", "content_sanskrit": "अहो यादृगसौ विप्रः सर्वत्रातिविचक्षणः ।\nसुशीलश्च सुरूपश्च सत्यवाङ्मितभाषणः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004107037, "chapter_id": 24107, "verse_number": "४-५६-३८", "content_sanskrit": "अलोलुप उदारश्च सदाचारो जितेंद्रियः ।\nअपि स्वल्पेन संतुष्टः प्रतिग्रहपराङ्मुखः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004107038, "chapter_id": 24107, "verse_number": "४-५६-३९", "content_sanskrit": "जितक्रोधः प्रसन्नास्यस्त्वनसूयुरवंचकः ।\nकृतज्ञः प्रीतिसुमुखः परिवादपराङ्मुखः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004107039, "chapter_id": 24107, "verse_number": "४-५६-४०", "content_sanskrit": "पुण्योपदेष्टा पुण्यात्मा सर्वव्रतपरायणः ।\nशुचिः शुचिचरित्रश्च श्रुतिस्मृतिविशारदः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004107040, "chapter_id": 24107, "verse_number": "४-५६-४१", "content_sanskrit": "धीरः पुण्येतिहासज्ञः सर्वदृक्सर्वसंमतः ।\nकलाकलापकुशलो ज्योतिःशास्त्रविदुत्तमः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004107041, "chapter_id": 24107, "verse_number": "४-५६-४२", "content_sanskrit": "क्षमी कुलीनोऽकृपणो भोक्ता निर्मलमानसः ।\nइत्यादि गुणसंपन्नः कोपि क्वापि न दृग्गतः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004107042, "chapter_id": 24107, "verse_number": "४-५६-४३", "content_sanskrit": "इत्थं तास्तद्गुणग्रामं वर्णयंत्यः पदेपदे ।\nकालं विनोदयंति स्म अंतःपुरचराः स्त्रियः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004107043, "chapter_id": 24107, "verse_number": "४-५६-४४", "content_sanskrit": "एकदावसरं प्राप्य दिवोदासस्य भूभुजः ।\nराज्ञी लीलावती नाम राज्ञे तं विन्यवेदयत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004107044, "chapter_id": 24107, "verse_number": "४-५६-४५", "content_sanskrit": "राजन्वृद्धो गुणैर्वृद्धो ब्राह्मणः सुविचक्षणः ।\nएकोस्ति स तु द्रष्टव्यो मूर्तो ब्रह्मनिधिः परः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004107045, "chapter_id": 24107, "verse_number": "४-५६-४६", "content_sanskrit": "राज्ञी राज्ञा कृतानुज्ञा सखीं प्रेष्य विचक्षणाम् ।\nआनिनाय च तं विप्रं ब्राह्मं तेज इवांगवत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004107046, "chapter_id": 24107, "verse_number": "४-५६-४७", "content_sanskrit": "राजापि दूरादायांतं त विलोक्यमहीसुरम् ।\nयत्राकृतिर्गुणास्तत्र जहर्षेति वदन्हृदि ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004107047, "chapter_id": 24107, "verse_number": "४-५६-४८", "content_sanskrit": "पदैर्द्वित्रैर्नृपतिना कृताभ्युत्थानसत्कृतिः ।\nचतुर्निगमजाभिः स तमाशीर्भिरनंदयत् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004107048, "chapter_id": 24107, "verse_number": "४-५६-४९", "content_sanskrit": "कृतप्रणामो राज्ञा स सादरं दत्तमासनम् ।\nभेजेथ कुशलं पृष्टः स राज्ञा तेन भूपतिः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004107049, "chapter_id": 24107, "verse_number": "४-५६-५०", "content_sanskrit": "परस्परं कुशलिनौ कुशलौ च कथागमे ।\nप्रश्नोत्तराभ्यां संतुष्टौ द्विजवर्य क्षमाभृतौ ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004107050, "chapter_id": 24107, "verse_number": "४-५६-५१", "content_sanskrit": "कथावसाने राज्ञाथ गेहं विससृजे द्विजः ।\nलब्धमानमहापूजः स स्वमाश्रममाविशत् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004107051, "chapter_id": 24107, "verse_number": "४-५६-५२", "content_sanskrit": "गतेऽथ स्वाश्रमं विप्रे दिवोदासो नरेश्वरः ।\nलीलावत्याः पुरो विप्रं वर्णयामास भूरिशः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004107052, "chapter_id": 24107, "verse_number": "४-५६-५३", "content_sanskrit": "महादेवि महाप्राज्ञे लीलावति गुणप्रिये ।\nयथाशंसि तथा विप्रस्ततोपि गुणवत्तरः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004107053, "chapter_id": 24107, "verse_number": "४-५६-५४", "content_sanskrit": "अतीतं वेत्ति सकलं वर्तमानमवैति च ।\nप्रष्टव्यः प्रातराहूय भविष्यं किंचिदेष वै ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004107054, "chapter_id": 24107, "verse_number": "४-५६-५५", "content_sanskrit": "महाविभव संभारैर्महाभोगैरनेकधा ।\nव्युष्टायां स नृपो रात्र्यां प्रातराहूतवान्द्विजम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004107055, "chapter_id": 24107, "verse_number": "४-५६-५६", "content_sanskrit": "सत्कृत्य तं द्विजं भक्त्या दुकूलादि प्रदानतः ।\nएकांते तं द्विजं राजा पप्रच्छ निजहृत्स्थितम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004107056, "chapter_id": 24107, "verse_number": "४-५६-५७", "content_sanskrit": "राजोवाच ।\nद्विजवर्यो भवानेकः प्रतिभातीति निश्चितम् ।\nयथातत्त्ववती ते धीर्न तथान्यस्य मे मतिः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004107057, "chapter_id": 24107, "verse_number": "४-५६-५८", "content_sanskrit": "दृष्ट्वा त्वां तु महाप्राज्ञं शांतं दांतं तपोनिधिम् ।\nकिंचित्प्रष्टुमना विप्र तदाख्याहि यथार्थवत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004107058, "chapter_id": 24107, "verse_number": "४-५६-५९", "content_sanskrit": "शासितेयं मया पृथ्वी न तथान्यैस्तु पार्थिवैः ।\nयावद्भूति मया भुक्ता दिव्या भोगा अनेकधा ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004107059, "chapter_id": 24107, "verse_number": "४-५६-६०", "content_sanskrit": "निजौरसेभ्योप्यधिकं रात्रिंदिवमतंद्रितम् ।\nविनिर्जित्य हठाद्दुष्टान्प्रजेयं परिपालिता ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004107060, "chapter_id": 24107, "verse_number": "४-५६-६१", "content_sanskrit": "द्विजपादार्चनात्किंचित्सुकृतं वेद्मि नापरम् ।\nअनेनापरिकथ्येन कथितेनेह किं मम ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004107061, "chapter_id": 24107, "verse_number": "४-५६-६२", "content_sanskrit": "निर्विस्ममिव मे चेतः सांप्रतं सर्वकर्मसु ।\nविचार्यार्य शुभोदर्कमत आख्याहि सत्तम ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004107062, "chapter_id": 24107, "verse_number": "४-५६-६३", "content_sanskrit": "द्विज उवाच ।\nअपि स्वल्पतरं कृत्यं यद्भवेद्भूभुजामिह ।\nएकांते तत्तु पृष्टेन वक्तव्यं सुधिया सदा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004107063, "chapter_id": 24107, "verse_number": "४-५६-६४", "content_sanskrit": "अमात्येनाप्यपृष्टेन न वक्तव्यं नृपाग्रतः ।\nमहापमानभीतेन स्तोकमप्यत्र किंचन ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004107064, "chapter_id": 24107, "verse_number": "४-५६-६५", "content_sanskrit": "पृष्टश्चेत्कथयामीह मा तत्र कुरु संशयम् ।\nतत्कृते तव गंता वै मनो निर्वेदकारणम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004107065, "chapter_id": 24107, "verse_number": "४-५६-६६", "content_sanskrit": "शृणु राजन्महाबुद्धे नायथार्थं ब्रवीम्यहम् ।\nविक्रांतोस्यतिशूरोसि भाग्यवानसि सर्वदा ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004107066, "chapter_id": 24107, "verse_number": "४-५६-६७", "content_sanskrit": "पुण्येन यशसा बुद्ध्या संपन्नोस्ति भवान्यथा ।\nमन्ये तथामरावत्यां त्रिदशेशोपि नैव हि ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004107067, "chapter_id": 24107, "verse_number": "४-५६-६८", "content_sanskrit": "सुधिया त्वां गुरुं मन्ये प्रसादेन सुधाकरम् ।\nतेजसास्ति भवानर्कः प्रतापेनाशुशुक्षणिः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004107068, "chapter_id": 24107, "verse_number": "४-५६-६९", "content_sanskrit": "प्रभंजनो बलेनासि श्रीदोसि श्रीसमर्पणैः ।\nशासनेन भवान्रुद्रो निरृतिस्त्वं रणांगणे ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004107069, "chapter_id": 24107, "verse_number": "४-५६-७०", "content_sanskrit": "दुष्टपाशयिता पाशी यमो नियमनेऽसताम् ।\nइंदनात्त्वं महेंद्रोसि क्षमया त्वमसि क्षमा ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004107070, "chapter_id": 24107, "verse_number": "४-५६-७१", "content_sanskrit": "मर्यादया भवानब्धिर्महत्त्वे हिमवानसि ।\nभार्गवो राजनीत्यासि राज्येन मनुना समः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004107071, "chapter_id": 24107, "verse_number": "४-५६-७२", "content_sanskrit": "संतापहर्तांबुदवत्पवित्रो गांगनामवत् ।\nसर्वेषामेव जंतूनां काशीव सुगतिप्रदः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004107072, "chapter_id": 24107, "verse_number": "४-५६-७३", "content_sanskrit": "रुद्रः संहाररूपेण पालनेन चतुर्भुजः ।\nविधिवत्त्वं विधातासि भारती ते मुखांबुजे ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004107073, "chapter_id": 24107, "verse_number": "४-५६-७४", "content_sanskrit": "त्वत्पाणिपद्मे कमला त्वत्क्रोधेस्ति हलाहलः ।\nअमृतं तव वागेव त्वद्भुजावश्विनीसुतौ ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004107074, "chapter_id": 24107, "verse_number": "४-५६-७५", "content_sanskrit": "तत्किं यत्त्वयि भूजानौ सर्वदेवमयो ह्यसि ।\nतस्मात्तव शुभोदर्को मया ज्ञातोस्ति तत्त्वतः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004107075, "chapter_id": 24107, "verse_number": "४-५६-७६", "content_sanskrit": "आरभ्याद्य दिनाद्भूप ब्राह्मणोऽष्टादशेहनि ।\nउदीच्यः कश्चिदागत्य ध्रुवं त्वामुपदेक्ष्यति ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004107076, "chapter_id": 24107, "verse_number": "४-५६-७७", "content_sanskrit": "तस्य वाक्यं त्वया राजन्कर्तव्यमविचारितम् ।\nततस्ते हृत्स्थितं सर्वं सेत्स्यत्येव महामते ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004107077, "chapter_id": 24107, "verse_number": "४-५६-७८", "content_sanskrit": "इत्युक्त्वा पृच्छ्य राजानं लब्धानुज्ञो द्विजोत्तमः ।\nविवेश स्वाश्रमं तुष्टो नृपोप्याश्चर्यवानभूत् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004107078, "chapter_id": 24107, "verse_number": "४-५६-७९", "content_sanskrit": "इत्थं विघ्नजिता सर्वा पुरी स्वात्मवशीकृता ।\nसपौरा सावरोधा च सनृपा निजमायया ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004107079, "chapter_id": 24107, "verse_number": "४-५६-८०", "content_sanskrit": "कृतकृत्यमिवात्मानं ततो मत्वा स विघ्नजित् ।\nविधाय बहुधात्मानं काश्यां स्थितिमवाप च ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004107080, "chapter_id": 24107, "verse_number": "४-५६-८१", "content_sanskrit": "यदा स न दिवोदासः प्रागासीत्कुंभसंभव ।\nतदातनं निजं स्थानमलंचक्रे गणाधिपः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004107081, "chapter_id": 24107, "verse_number": "४-५६-८२", "content_sanskrit": "दिवोदासे नरपतौ विष्णुनोच्चाटिते सति ।\nपुनर्नवीकृतायां च नगर्यां विश्वकर्मणा ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004107082, "chapter_id": 24107, "verse_number": "४-५६-८३", "content_sanskrit": "स्वयमागत्य देवेन मंदरात्सुंदरां पुरीम् ।\nवाराणसीं प्रथमतस्तुष्टुवे गणनायकम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004107083, "chapter_id": 24107, "verse_number": "४-५६-८४", "content_sanskrit": "अगस्त्य उवाच ।\nकथं स्तुतो भगवता देवदेवेन विघ्नजित् ।\nकथं च बहुधात्मानं स चकार विनायकः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004107084, "chapter_id": 24107, "verse_number": "४-५६-८५", "content_sanskrit": "केनकेन स वै नाम्ना काशिपुर्यां व्यवस्थितः ।\nइति सर्वं समासेन कथयस्व षडानन ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004107085, "chapter_id": 24107, "verse_number": "४-५६-८६", "content_sanskrit": "इत्युदीरितमाकर्ण्य कुंभयोनेः षडाननः ।\nयथावत्कथयामास गणराज कथां शुभाम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004107086, "chapter_id": 24107, "verse_number": "४-५६-८७", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां चतुर्थे काशीखंड उत्तरार्द्धे गणेशमाया प्रपंचो नाम षट्पंचाशत्तमोऽध्यायः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}]