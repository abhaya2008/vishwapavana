[{"id": 2019225, "chapter_id": 1401, "verse_number": "३-३९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2019226, "chapter_id": 1401, "verse_number": "३-३९-१", "content_sanskrit": "गतेषु तेषु सर्वेषु तपस्विषु महात्मसु।\nपिनाकपाणिर्भगवान्सर्वपापहरो हरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2019227, "chapter_id": 1401, "verse_number": "३-३९-२", "content_sanskrit": "कैरातं वेषमास्थाय काञ्चनद्रुमसन्निभम्।\nविभ्राजमानो वपुषा गिरिर्मेरुरिवापरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2019228, "chapter_id": 1401, "verse_number": "३-३९-३", "content_sanskrit": "श्रीगद्धनुरुपादाय शरांश्चाशीविषोपमान्।\nनिष्पपात महार्चिष्मान्दहन्कक्षमिवानलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2019229, "chapter_id": 1401, "verse_number": "३-३९-४", "content_sanskrit": "देव्या सहोमया श्रीमान्समानव्रतवेषया।\nनानावेषधरैर्हृष्टैर्भूतैरनुगतस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2019230, "chapter_id": 1401, "verse_number": "३-३९-५", "content_sanskrit": "किरातवेषसंछन्नः स्त्रीभिश्चापि सहस्रशः।\nअशोभत तदा राजन्स देशोऽतीव भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2019231, "chapter_id": 1401, "verse_number": "३-३९-६", "content_sanskrit": "क्षणेन तद्वनं सर्वं निःशब्दमभवत्तदा।\nनादः प्रस्रवणानां च पक्षिणां चाप्युपारमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2019232, "chapter_id": 1401, "verse_number": "३-३९-७", "content_sanskrit": "स सन्निकर्षमागम्य पार्थस्याक्लिष्टकर्मणः।\nमूकं नाम दितेः पुत्रं ददर्शाद्भुतदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2019233, "chapter_id": 1401, "verse_number": "३-३९-८", "content_sanskrit": "वाराहं रूपमास्थाय तर्जयन्तमिवार्जुनम्।\nहन्तुं परमदुष्टात्मा तमुवाचाथ फल्गुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2019234, "chapter_id": 1401, "verse_number": "३-३९-९", "content_sanskrit": "गाण्डीवं धनुरादाय शरांश्चाशीविषोपमान्।\nसज्यं धनुर्वरं कृत्वा ज्याघोषेण निनादयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2019235, "chapter_id": 1401, "verse_number": "३-३९-१०", "content_sanskrit": "यन्मां प्रार्थयसे हन्तुमनागसमिहागतम्।\nतस्मात्त्वां पूर्वमेवाहं नेष्यामि यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2019236, "chapter_id": 1401, "verse_number": "३-३९-११", "content_sanskrit": "दृष्ट्वा तं प्रहरिष्यन्तं फल्गुनं दृढधन्विनम्।\nकिरातरूपी सहसा वारयामास शंकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2019237, "chapter_id": 1401, "verse_number": "३-३९-१२", "content_sanskrit": "मयैष प्रार्थितः पूर्वं नीलमेघसमप्रभः।\nअनादृत्यैव तद्वाक्यं प्रजहाराथ फल्गुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2019238, "chapter_id": 1401, "verse_number": "३-३९-१३", "content_sanskrit": "किरातश्च समं तस्मिन्नेकलक्ष्ये महाद्युतिः।\nप्रमुमोचाशनिप्रख्यं शरमग्निशिखोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2019239, "chapter_id": 1401, "verse_number": "३-३९-१४", "content_sanskrit": "तौ मुक्तौ सायकौ ताभ्यां समं तत्र निपेततुः।\nमूकस्य गात्रे विस्तीर्णे शैलपृष्ठनिभे तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2019240, "chapter_id": 1401, "verse_number": "३-३९-१५", "content_sanskrit": "यथाऽशनैर्विनिष्पेषो वज्रस्येव च पर्वते।\nतथा तयोः सन्निपातः शरयोरभवत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2019241, "chapter_id": 1401, "verse_number": "३-३९-१६", "content_sanskrit": "स विद्धो बहुभिर्बाणैर्दीप्तास्यैः पन्नगैरिव।\nममार राक्षसं रूपं भूयः कृत्वा सुदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2019242, "chapter_id": 1401, "verse_number": "३-३९-१७", "content_sanskrit": "स ददर्श ततो जिष्णुः पुरुषं काञ्चनप्रभम्।\nकिरातवेषसंछन्नं स्त्रीसहायममित्रहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2019243, "chapter_id": 1401, "verse_number": "३-३९-१८", "content_sanskrit": "तमब्रवीत्प्रीतमना कौन्तेयः प्रहसन्निव।\nको भवानटते शून्ये वने रस्त्रीगणसंवृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2019244, "chapter_id": 1401, "verse_number": "३-३९-१९", "content_sanskrit": "न त्वमस्मिन्वने घोरे बिभेषि कनकप्रभ।\nकिमर्थं च त्वया विद्धो मृगोऽयं मत्परिग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2019245, "chapter_id": 1401, "verse_number": "३-३९-२०", "content_sanskrit": "मयाऽभिपन्नः पूर्वं हि राक्षसोऽयमिहागतः।\nकामात्परिभवाद्वाऽपि न मे जीवन्विमोक्ष्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2019246, "chapter_id": 1401, "verse_number": "३-३९-२१", "content_sanskrit": "न ह्येष मृगयाधर्मो यस्त्वयाऽद्य कृतो मयि।\nतेन त्वां भ्रंशयिष्यामि जीवितात्पर्वताश्रयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2019247, "chapter_id": 1401, "verse_number": "३-३९-२२", "content_sanskrit": "इत्युक्तः पाण्डवेयेन किरातः प्रहसन्निव।\nउवाच श्लक्ष्णया वाचा पाण्डवं सव्यसाचिनं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2019248, "chapter_id": 1401, "verse_number": "३-३९-२३", "content_sanskrit": "न मत्कृते त्वया वीरः भीः कार्या वनमन्तिकात्।\nइयं भूमिः सदाऽस्माकमुचिता वसतां वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2019249, "chapter_id": 1401, "verse_number": "३-३९-२४", "content_sanskrit": "त्वया तु दुष्करः कस्मादिह वासः प्ररोचितः।\nवयं तु बहुसत्त्वेऽस्मिन्निवसामस्तपोधन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2019250, "chapter_id": 1401, "verse_number": "३-३९-२५", "content_sanskrit": "भवांस्तु कृष्णवत्मार्भः सुकुमारः सुखोचितः।\nकथं शून्यमिमं देशमेकाकी विचरिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2019251, "chapter_id": 1401, "verse_number": "३-३९-२६x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2019252, "chapter_id": 1401, "verse_number": "३-३९-२६", "content_sanskrit": "गाण्डीवमाश्रयं कृत्वा नाराजांश्चाग्निसन्निभान्।\nनिवसामि महारण्ये द्वितीय इव पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2019253, "chapter_id": 1401, "verse_number": "३-३९-२७", "content_sanskrit": "एष चापि मया जन्तुर्मृगरूपं समाश्रितः।\nराक्षसो निहतो घोरो हन्तुं मामिह चागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2019254, "chapter_id": 1401, "verse_number": "३-३९-२८x", "content_sanskrit": "किरात उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2019255, "chapter_id": 1401, "verse_number": "३-३९-२८", "content_sanskrit": "मयैष धन्वनिर्मुक्तैस्ताडितः पूर्वमेव हि।\nबाणैरभिहतः शेते नीतश्च यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2019256, "chapter_id": 1401, "verse_number": "३-३९-२९", "content_sanskrit": "ममैवायं लक्ष्यभूतः पूर्वमेव परिग्रहः।\nममैव च प्रहारेण जीविताद्व्यपरिपितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2019257, "chapter_id": 1401, "verse_number": "३-३९-३०", "content_sanskrit": "दोषान्स्वान्नार्हसेऽन्यस्मै वक्तुं स्वबलदर्पितः।\nअभिषक्तोस्मि मन्दात्मन्न मे जीवन्विमोक्ष्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2019258, "chapter_id": 1401, "verse_number": "३-३९-३१", "content_sanskrit": "स्थिरो भव विमोक्ष्यामि सायकानशनीनिव।\nघटस्व परया शक्त्या मुञ्च त्वमपि सायकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2019259, "chapter_id": 1401, "verse_number": "३-३९-३२", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा किरातस्यार्जुनस्तदा।\nरोषमाहारयामास ताडयामास चेषुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2019260, "chapter_id": 1401, "verse_number": "३-३९-३३", "content_sanskrit": "ततो हृष्टेन मनसा प्रतिजग्राह सायकान्।\nभूयोभूय इति प्राह मन्दमन्देत्युवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2019261, "chapter_id": 1401, "verse_number": "३-३९-३४", "content_sanskrit": "प्रहरस्व शरानेतान्नाराचान्मर्मभेदिनः।\nइत्युक्तो बाणवर्षं स मुमोच सहसाऽर्जुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2019262, "chapter_id": 1401, "verse_number": "३-३९-३५", "content_sanskrit": "ततस्तौ तत्रसंरब्धौ गर्जमानौ मुहुर्मुहुः।\nशरैराशीविषाकारैस्ततक्षाते परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2019263, "chapter_id": 1401, "verse_number": "३-३९-३६", "content_sanskrit": "ततोऽर्जुनः शरवर्षं किराते समवासृजत्।\nतत्प्रसन्नेन मनसा प्रतिजग्राह शंकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2019264, "chapter_id": 1401, "verse_number": "३-३९-३७", "content_sanskrit": "मुहूर्तं शरवर्षं तु प्रतिगृह्य पिनाकधृक्।\nअक्षतेन शरीरेण तस्थौ गिरिवाचलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2019265, "chapter_id": 1401, "verse_number": "३-३९-३८", "content_sanskrit": "स दृष्ट्वा बाणवर्षं तु मघीभूतं धनंजयः।\nपरमं विस्मयं चक्रे साधुसाध्विति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2019266, "chapter_id": 1401, "verse_number": "३-३९-३९", "content_sanskrit": "अहोऽयं सुकुमाराङ्गो हिमवच्छिखराश्रयः।\nगाण्डीवमुक्तान्नाराचान्प्रतिगृह्णात्यविह्वलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2019267, "chapter_id": 1401, "verse_number": "३-३९-४०", "content_sanskrit": "कोऽयं देवो भवेत्साक्षाद्रुद्रो यक्षः सुरोऽसुरः।\nविद्यते हि गिरिश्रेष्ठे त्रिदशानां समागमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2019268, "chapter_id": 1401, "verse_number": "३-३९-४१", "content_sanskrit": "न हि मद्वाणजालानामुत्सृष्टानां सहस्रशः।\nशक्तोऽन्यः सहितुं वेगमृते देवं पिनाकिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2019269, "chapter_id": 1401, "verse_number": "३-३९-४२", "content_sanskrit": "देवो वा यदि वा यक्षो रुद्रादन्यो व्यवस्थितः।\nअहमेनं शरैस्तीक्ष्णैर्नयामि यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2019270, "chapter_id": 1401, "verse_number": "३-३९-४३", "content_sanskrit": "ततो हृष्टमना जिष्णुर्नाराचान्मर्मभेदिनः।\nव्यसृजच्छतधा राजन्मयूखानिव भास्करः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2019271, "chapter_id": 1401, "verse_number": "३-३९-४४", "content_sanskrit": "तान्प्रसन्नेन मनसा भगवाँल्लोकभावनः।\nशूलपाणिः प्रत्यगृह्णाच्छिलावर्षमिवाचलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2019272, "chapter_id": 1401, "verse_number": "३-३९-४५", "content_sanskrit": "क्षणेन क्षीणबाणोऽथ संवृत्तः फल्गुनस्तदा।\nवित्रासं च जगामाथ तं दृष्ट्वा शरसंक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2019273, "chapter_id": 1401, "verse_number": "३-३९-४६", "content_sanskrit": "चिन्तयामास जिष्णुस्तु भगवन्तं हुताशनम्।\nपुरस्तादक्षयौ दत्तौ तूणौ येनास्य खाण्डवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2019274, "chapter_id": 1401, "verse_number": "३-३९-४७", "content_sanskrit": "किं नु मोक्ष्यामि धनुषा यन्मे बाणाः क्षयं गताः।\nअयं च पुरुषः कोपि बाणान्ग्रसति सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2019275, "chapter_id": 1401, "verse_number": "३-३९-४८", "content_sanskrit": "अहमेनं धनुष्कोट्या रशूलाग्रेणेव कुञ्जरम्।\nनयामि दण्डधारस्य यमस्य सदनं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2019276, "chapter_id": 1401, "verse_number": "३-३९-४९", "content_sanskrit": "प्रगृह्याथ धनुष्कोट्या ज्यापाशेनावकृष्य च।\nमुष्टिभिश्चापि हतवान्वज्रकल्पैर्महाद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2019277, "chapter_id": 1401, "verse_number": "३-३९-५०", "content_sanskrit": "संप्रायुध्यद्धनुष्कोट्या कौन्तेयः परवीरहा।\nतदप्यस्य धनुर्दिव्यं जग्राह गिरिगोचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2019278, "chapter_id": 1401, "verse_number": "३-३९-५१", "content_sanskrit": "ततोऽर्जुनो ग्रस्तधनुः खङ्गपाणिरतिष्ठत।\nयुद्धस्यान्तमभीप्सन्वै वेगेनाभिजगाम तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2019279, "chapter_id": 1401, "verse_number": "३-३९-५२", "content_sanskrit": "तस्य मूर्ध्नि शितं खङ्गमसक्तं पर्वतेष्वपि।\nमुमोय भुजवीर्येण विक्रम्य कुरुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2019280, "chapter_id": 1401, "verse_number": "३-३९-५३", "content_sanskrit": "तकस्य मूर्धानमासाद्य पफालासिवरो हि सः।\nततो वृक्षैः शिलाभिश्च योधयामास फल्गुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2019281, "chapter_id": 1401, "verse_number": "३-३९-५४", "content_sanskrit": "तदा वृक्षान्महाकायः प्रत्यगृह्णादथो शिलाः।\nकिरातरूपी भगवांस्ततः पार्थो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2019282, "chapter_id": 1401, "verse_number": "३-३९-५५", "content_sanskrit": "मुष्टिभिर्वज्रसंस्पर्शैर्धूममुत्पादयन्मुखे।\nप्रजहार दुराधर्षे किरातसमरूपिणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2019283, "chapter_id": 1401, "verse_number": "३-३९-५६", "content_sanskrit": "ततः शक्राशनिसमैर्मुष्टिभिर्भृशदारुणैः।\nकिरातरूपी भगवानर्दयामास फल्गुनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2019284, "chapter_id": 1401, "verse_number": "३-३९-५७", "content_sanskrit": "ततश्चटचटाशब्दः सुधोरः समजायत।\nपाण्डवस्य च मुष्टीनां किरातस् च युध्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2019285, "chapter_id": 1401, "verse_number": "३-३९-५८", "content_sanskrit": "सुमुहूर्तं तयोर्युद्धमभवल्लोमहर्षणम्।\nभुजप्रहारसंयुक्तं वृत्रवासवयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2019286, "chapter_id": 1401, "verse_number": "३-३९-५९", "content_sanskrit": "महाराज ततो जिष्णुः किरातमुरसा बली।\nपाण्डवं च विचेष्टन्तं किरातोप्यहनद्बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2019287, "chapter_id": 1401, "verse_number": "३-३९-६०", "content_sanskrit": "तयोर्भुजविनिष्पेषात्संधर्षेणोरसोस्तथा।\nसमजायत गात्रेषु पावकोऽङ्गारधूमवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2019288, "chapter_id": 1401, "verse_number": "३-३९-६१", "content_sanskrit": "तत एनं महादेवः पीड्य गात्रैः सुपीडितम्।\nतेजसा व्क्रमद्रोषाच्चेतस्तस्य विमोहयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2019289, "chapter_id": 1401, "verse_number": "३-३९-६२", "content_sanskrit": "ततोऽभिपीडितैर्गात्रैः पिण्डीकृत इवाबभौ।\nफल्गुनो गात्रसंरुद्धो देवदेवेन भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2019290, "chapter_id": 1401, "verse_number": "३-३९-६३", "content_sanskrit": "निरुच्छ्वासोऽभवच्चैव सन्निरुद्धो महामनाः।\nततः पपात संमूढस्ततः प्रीतोऽभवद्भवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2019291, "chapter_id": 1401, "verse_number": "३-३९-६४", "content_sanskrit": "स मुहूर्तं तथा भूत्वा सचेताः पुनरुत्थितः।\nरुधिरेणाप्लुताङ्गस्तु पाण्डवो भृशदुःखितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2019292, "chapter_id": 1401, "verse_number": "३-३९-६५", "content_sanskrit": "शरण्यं शरणं गत्वा भगवन्तं पिनाकिनम्।\nमृन्मयं स्ण्डिलं कृत्वामाल्येनापूजयद्भवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2019293, "chapter_id": 1401, "verse_number": "३-३९-६६", "content_sanskrit": "तच्च माल्यं तदा पार्थः किरातशिरसि स्थितम्।\nअपश्यत्पाण्डवश्रेष्ठो हर्षेण प्रकृतिं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2019294, "chapter_id": 1401, "verse_number": "३-३९-६७", "content_sanskrit": "पपात पादयोस्तस्य ततः प्रीतोऽभवद्भवः।\n[उवाच चैनं वचसा मेघगम्भीरगीर्हसः।\nजातविस्मयमालोक्य ततः क्षीणाङ्गसंहतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2019295, "chapter_id": 1401, "verse_number": "३-३९-६८x", "content_sanskrit": "भव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2019296, "chapter_id": 1401, "verse_number": "३-३९-६८", "content_sanskrit": "भोभो फल्गुन तुष्टोस्मि कर्मणाऽप्रतिमेन ते।\nशौर्येणानेन धृत्या च क्षत्रियो नास्ति ते समः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2019297, "chapter_id": 1401, "verse_number": "३-३९-६९", "content_sanskrit": "समं तेजश्च वीर्यं च ममाद्य तव चानघ।\nप्रीतस्तेऽहं महाबाहो पश्य मां भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2019298, "chapter_id": 1401, "verse_number": "३-३९-७०", "content_sanskrit": "ददामि ते विशालाक्ष चक्षुः पूर्वं मुनिर्भवान्।\nविजेष्यसि रणे शत्रूनपि सर्वान्दिवौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2019299, "chapter_id": 1401, "verse_number": "३-३९-७१", "content_sanskrit": "[प्रीत्या च तेऽहं दास्यामि यदस्त्रमनिवारितम्।\nत्वं हि शक्तो मदीयं तदस्त्रं धारयितुं क्षणात् ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2019300, "chapter_id": 1401, "verse_number": "३-३९-७२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2019301, "chapter_id": 1401, "verse_number": "३-३९-७२", "content_sanskrit": "ततो देवं महादेवं गिरिशं शूनपाणिनम्।\nददर्श फल्गुनस्तत्र सह देव्या महाद्युतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2019302, "chapter_id": 1401, "verse_number": "३-३९-७३", "content_sanskrit": "स जानुभ्यां महीं गत्वा शिरसा प्रणिपत्य च।\nप्रसादयामास हरं पार्थः परपुरंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2019303, "chapter_id": 1401, "verse_number": "३-३९-७४x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2019304, "chapter_id": 1401, "verse_number": "३-३९-७४", "content_sanskrit": "कपर्दिन्सर्वभूतेश भगनेत्रनिपातन।\n[देवदेव महादेव नीलग्रीव जटाधर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2019305, "chapter_id": 1401, "verse_number": "३-३९-७५", "content_sanskrit": "कारणानां च परमं जाने त्वां त्र्यम्बकं विभुम्।\nदेवानां च गतिं देवं त्वत्प्रसूतमिदं जगत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2019306, "chapter_id": 1401, "verse_number": "३-३९-७६", "content_sanskrit": "अजेयस्त्वं त्रिभिर्लोकैः सदेवासुरमानुषैः।\nशिवाय विष्णुरूपाय विष्णवे शिवरूपिणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2019307, "chapter_id": 1401, "verse_number": "३-३९-७७", "content_sanskrit": "दक्षियज्ञविनाशाय हरिरूपाय ते नमः।\nललाटाक्षाय शर्वाय मीढुषे शूलपाणये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2019308, "chapter_id": 1401, "verse_number": "३-३९-७८", "content_sanskrit": "पिनाकगोप्त्रे सूर्याय मङ्गल्याय च वेधसे।\nप्रसादये त्वां भगवन्सर्वभूतमहेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2019309, "chapter_id": 1401, "verse_number": "३-३९-७९", "content_sanskrit": "गणेशं जगतः शम्भुं लोककारणकारणम्।\nप्रधानपुरुषातीतं परं सूक्ष्मतरं हरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2019310, "chapter_id": 1401, "verse_number": "३-३९-८०", "content_sanskrit": "व्यतिक्रमं मे भगवन्क्षन्तुमर्हसि शंकर।\nभगवन्दर्शनाकाङ्क्षी प्राप्तोस्मीमं महागिरिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2019311, "chapter_id": 1401, "verse_number": "३-३९-८१", "content_sanskrit": "दयितं तव देवेश तापसालयमुत्तमम्।\nप्रसादये त्वां भगवन्सर्वलोकनमस्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2019312, "chapter_id": 1401, "verse_number": "३-३९-८२", "content_sanskrit": "कृतो मयाऽयमज्ञानाद्विमर्दो यस्त्वया सह।\nशरणं प्रतिपन्नाय तत्क्षमस्वाद्य शंकर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2019313, "chapter_id": 1401, "verse_number": "३-३९-८३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2019314, "chapter_id": 1401, "verse_number": "३-३९-८३", "content_sanskrit": "तमुवाच महातेजाः प्रहसन्वृषभध्वजः।\nप्रगृह्य रुचिरं बाहुं क्षान्तमित्येव फल्गुनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2019315, "chapter_id": 1401, "verse_number": "३-३९-८४", "content_sanskrit": "परिष्वज्य च बाहुभ्यां प्रीतात्मा भगवान्हरः।\nपुनः पार्थं सान्त्वपूर्वमुवाच वृषभध्वजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2019316, "chapter_id": 1401, "verse_number": "३-३९-८५", "content_sanskrit": "`गङ्गाङ्गितजटः शर्वः पार्थस्यामिततेजसः।\nप्रगृह्य रुचिरं बाहुं वृत्तं ताम्रतलाङ्गुलिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2019317, "chapter_id": 1401, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि कैरातपर्वणि एकोनचत्वारिंशोऽध्यायः ॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}]