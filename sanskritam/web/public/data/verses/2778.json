[{"id": 2083351, "chapter_id": 2778, "verse_number": "१२-२८३-०x", "content_sanskrit": "* युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2083352, "chapter_id": 2778, "verse_number": "१२-२८३-१", "content_sanskrit": "अतिक्रामति कालेऽस्मिन्सर्वभूतभयावहे।\nकिं श्रेयः प्रतिपद्येत तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2083353, "chapter_id": 2778, "verse_number": "१२-२८३-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2083354, "chapter_id": 2778, "verse_number": "१२-२८३-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nपितुः पुत्रेण संवादं तं निबोध युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2083355, "chapter_id": 2778, "verse_number": "१२-२८३-३", "content_sanskrit": "द्विजातेः कस्यजित्पार्थ स्वाध्यायनिरतस्य वै।\nपुत्रो बभूव मेधावी मेधावी नाम नामतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2083356, "chapter_id": 2778, "verse_number": "१२-२८३-४", "content_sanskrit": "सोऽब्रवीत्पितरं पुत्रः स्वाध्यायकरणे रतम्।\nमोक्षधर्मेष्वकुशलं मोक्षधर्मविचक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2083357, "chapter_id": 2778, "verse_number": "१२-२८३-५x", "content_sanskrit": "पुत्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2083358, "chapter_id": 2778, "verse_number": "१२-२८३-५", "content_sanskrit": "धीरः किंस्वित्तात कुर्यात्प्रजानन्\nक्षिप्रं ह्यायुर्भ्रश्यते मानवानाम्।\nपितस्तथाऽऽख्याहि यथार्थयोगं\nममानुपूर्व्या येन धर्मं चरेयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2083359, "chapter_id": 2778, "verse_number": "१२-२८३-६x", "content_sanskrit": "पितोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2083360, "chapter_id": 2778, "verse_number": "१२-२८३-६", "content_sanskrit": "अधीत्य वेदान्ब्रह्मचर्येषु पुत्र\nपुत्रानिच्छेत्पावनार्थं पितृणाम्।\nअग्नीनाधाय विधिवच्चेष्टयज्ञो\nवनं प्रविश्याथ मुनिर्बुभूषेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2083361, "chapter_id": 2778, "verse_number": "१२-२८३-७x", "content_sanskrit": "पुत्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2083362, "chapter_id": 2778, "verse_number": "१२-२८३-७", "content_sanskrit": "एवमभ्याहते लोके सर्वतः परिवारिते।\nअमोधासु पतन्तीषु किं धीर इव भाषसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2083363, "chapter_id": 2778, "verse_number": "१२-२८३-८x", "content_sanskrit": "पितोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2083364, "chapter_id": 2778, "verse_number": "१२-२८३-८", "content_sanskrit": "कथमभ्याहतो लोकः केन वा परिवारितः।\nअमोघाः काः पतन्तीह किंनु भीषयसीव माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2083365, "chapter_id": 2778, "verse_number": "१२-२८३-९x", "content_sanskrit": "पुत्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2083366, "chapter_id": 2778, "verse_number": "१२-२८३-९", "content_sanskrit": "मृत्युनाऽऽभ्याहतो लोको जस्या परिवारितः।\nअहोरात्राः पतन्तीमे तच्च कस्मान्न बुध्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2083367, "chapter_id": 2778, "verse_number": "१२-२८३-१०", "content_sanskrit": "यदाहमेव जानामि न मृत्युस्तिष्ठतीति ह।\nसोहं कथं प्रतीक्षिप्ये ज्ञानेनापिहितश्चरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2083368, "chapter_id": 2778, "verse_number": "१२-२८३-११", "content_sanskrit": "रात्र्यांरात्र्यां व्यतीतायामायुरल्पतरं यदा।\nगाधोदके मत्स्य इव सुखं विन्देत कस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2083369, "chapter_id": 2778, "verse_number": "१२-२८३-१२", "content_sanskrit": "`यामेकरात्रिं प्रथमां गर्भो विशति मातरम्।\nतामेव रात्रिं प्रस्वाप्य मरणाय विवर्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2083370, "chapter_id": 2778, "verse_number": "१२-२८३-१३", "content_sanskrit": "पुष्पाणीव विचिन्वन्तमन्यत्र गतमानसम्।\nअनवाप्तेषु कामेषु मृत्युरभ्येति गानवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2083371, "chapter_id": 2778, "verse_number": "१२-२८३-१४", "content_sanskrit": "श्वः कार्यमद्य कुर्वीत पूर्वाङ्गे चापराहिकम्।\nन हि प्रतीक्षते मृत्युः कृतं वाऽस्य न वा कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2083372, "chapter_id": 2778, "verse_number": "१२-२८३-१५", "content_sanskrit": "अद्यैव कुरु यच्छ्रेयो मा त्वां कालोऽत्यगान्महान्।\nको हि जानाति कस्याद्य मृत्युकालो मविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2083373, "chapter_id": 2778, "verse_number": "१२-२८३-१६", "content_sanskrit": "अकृतेष्वेव कार्येषु मृत्युर्वै संप्रकर्षति।\nयुवैव धर्मशीलः स्यादनिमित्तं हि जीवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2083374, "chapter_id": 2778, "verse_number": "१२-२८३-१७", "content_sanskrit": "कृते धर्म भवेत्प्रीतिरिह प्रेत्य च शाश्वती।\nमोहेन हि समाविष्टः पुत्रदारार्तमुद्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2083375, "chapter_id": 2778, "verse_number": "१२-२८३-१८", "content_sanskrit": "कृत्वा कार्यमकार्यं वा तुष्टिमेषां प्रयच्छति।\nतं पुत्रपशुसंपन्नं व्याभक्तमनसं नरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2083376, "chapter_id": 2778, "verse_number": "१२-२८३-१९", "content_sanskrit": "सप्तं व्यायं महौघो वा मृत्युरादाय गच्छति।\nसंविन्वानकमेवैनं कामानामवितृप्तकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2083377, "chapter_id": 2778, "verse_number": "१२-२८३-२०", "content_sanskrit": "वृकीवोरपमासाद्य मुत्युरादाय गच्छति।\nइदं कृतमिदं कार्यमिदमन्यत्कृताकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2083378, "chapter_id": 2778, "verse_number": "१२-२८३-२१", "content_sanskrit": "एवमीहासमायुक्तं मृत्युरादाय गच्छति।\nकृतानां फलमप्राप्तं कार्याणां कर्मसङ्गिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2083379, "chapter_id": 2778, "verse_number": "१२-२८३-२२", "content_sanskrit": "क्षेत्रापणगृहासक्तं मृत्युरादाय गच्छति।\nदुर्बलं बलवन्तं च प्राज्ञं शूरं जडं कविम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2083380, "chapter_id": 2778, "verse_number": "१२-२८३-२३", "content_sanskrit": "अप्राप्तसर्वकामार्थं मृत्युरादाय गच्छति।\nमृत्युर्जरा च व्याधिश्चदुःखं चानेककारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2083381, "chapter_id": 2778, "verse_number": "१२-२८३-२४", "content_sanskrit": "असंत्याज्यं यदा मर्त्यैः किं स्वस्थ इव तिष्ठति।\nजातमेवान्तकोऽन्ताय जरा चाभ्येति देहिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2083382, "chapter_id": 2778, "verse_number": "१२-२८३-२५", "content_sanskrit": "अनुषक्ता द्वयेनैते भावाः स्थावरजङ्गमाः।\nन मृत्युसेनामायान्तीं जातु कश्चित्प्रबाधते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2083383, "chapter_id": 2778, "verse_number": "१२-२८३-२६", "content_sanskrit": "बलात्सत्यमृते त्वेकं सत्ये ह्यमृतमाश्रितम्।\nमृत्योर्वा गृहमेतद्वै या ग्रामे वसतो रतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2083384, "chapter_id": 2778, "verse_number": "१२-२८३-२७", "content_sanskrit": "देवानामेषु वै गोष्ठो यदरण्यमिति श्रुतिः।\nनिबन्धनी रज्जुरेषा या ग्रामे वसतो रतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2083385, "chapter_id": 2778, "verse_number": "१२-२८३-२८", "content_sanskrit": "छित्त्वैनां सुकृतो यान्ति नैनां छिन्दन्ति दुष्कृतः।\nयो न हिंसति सत्वानि मनोवाक्कर्महेतुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2083386, "chapter_id": 2778, "verse_number": "१२-२८३-२९", "content_sanskrit": "जीवितार्थापनयनैः प्राणिभिर्न स बध्यते।\nतस्मात्सत्यव्रताचारः सत्यव्रतपरायणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2083387, "chapter_id": 2778, "verse_number": "१२-२८३-३०", "content_sanskrit": "सत्यकामः समो दान्ताः सत्येनैवान्तकं जयेत्।\nअमृतं चैव मृत्युश्च द्वयं देहे प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2083388, "chapter_id": 2778, "verse_number": "१२-२८३-३१", "content_sanskrit": "मृत्युरापद्यते मोहात्सत्येनापद्यतेऽमृतम्।\nसोहं सत्यमहिंसाथीं कामक्रोधबहिष्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2083389, "chapter_id": 2778, "verse_number": "१२-२८३-३२", "content_sanskrit": "समाश्रित्य सुखं क्षेमी मृत्युं हास्याम्यमृत्युवत्।\nशान्तियज्ञरतो दान्तो ब्रह्मयज्ञे स्थितो मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2083390, "chapter_id": 2778, "verse_number": "१२-२८३-३३", "content_sanskrit": "वाङ्भनः कर्मयज्ञश्च भविष्याम्युदगायने।\nपशुयज्ञैः कथं हिंस्रैर्मादृशो यष्टुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2083391, "chapter_id": 2778, "verse_number": "१२-२८३-३४", "content_sanskrit": "अन्तवद्भिरुत प्राज्ञः क्षत्रयज्ञैः पिशाचवत्।\nआत्मन्येवात्मना जात आत्मनिष्ठोऽप्रजः पितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2083392, "chapter_id": 2778, "verse_number": "१२-२८३-३५", "content_sanskrit": "आत्मयज्ञो भविष्यामि न मां तारयति प्रजा।\nयस्य वाङ्भनसी स्यातां सम्यक्प्रणिहिते सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2083393, "chapter_id": 2778, "verse_number": "१२-२८३-३६", "content_sanskrit": "तपस्त्यागश्च योगश्च स तैः सर्वमवाप्नुयात्।\nनास्ति विद्यासमं चक्षुर्नास्ति विद्यासमं फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2083394, "chapter_id": 2778, "verse_number": "१२-२८३-३७", "content_sanskrit": "नास्ति रागसमं दुःखं नास्ति त्यागसमं सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2083395, "chapter_id": 2778, "verse_number": "१२-२८३-३८", "content_sanskrit": "नैतादृशं ब्राह्मणस्यास्ति वित्तं\nयथैकता समता सत्यता च।\nशीले स्थितिर्दण्डविधानमार्जवं\nततस्ततश्चोपरमः क्रियाभ्यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2083396, "chapter_id": 2778, "verse_number": "१२-२८३-३९", "content_sanskrit": "किं ते धनैर्बान्धवैर्वाऽपि किं ते\nकिं ते दारैब्राह्मण यो मरिष्यसि।\nआत्मानमन्विच्छ गृहा प्रविष्टं\nपितामहास्ते क्व गताः पिता च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2083397, "chapter_id": 2778, "verse_number": "१२-२८३-४०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2083398, "chapter_id": 2778, "verse_number": "१२-२८३-४०", "content_sanskrit": "पुत्रस्यैतद्वचः श्रुत्वा तथाकार्षीत्पिता नृप।\nतथा त्वमपि राजेन्द्र सत्यधर्मपरो भव॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2083399, "chapter_id": 2778, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि त्र्यशीत्यधिकद्विशततमोऽध्यायः॥ २८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]