[{"id": 2194959, "chapter_id": 5147, "verse_number": "", "content_sanskrit": "सूर्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2194960, "chapter_id": 5147, "verse_number": "१", "content_sanskrit": "नैष देवोऽनिलसखो नासुरो न च पन्नगः ।\nउञ्छवृत्तिव्रते सिद्धो मुनिरेष दिवं गतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2194961, "chapter_id": 5147, "verse_number": "२", "content_sanskrit": "एष मूलफलाहारः शीर्णपर्णाशनस्तथा ।\nअब्भक्षो वायुभक्षश्च आसीद् विप्रः समाहितः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2194962, "chapter_id": 5147, "verse_number": "३", "content_sanskrit": "ऋचश्चानेन विप्रेण संहितान्तरभिष्टुताः ।\nस्वर्गद्वारकृतोद्योगो येनासौ त्रिदिवं गतः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2194963, "chapter_id": 5147, "verse_number": "४", "content_sanskrit": "असन्नधीरनाकाङ्क्षी नित्यमुञ्छशिलाशनः ।\nसर्वभूतहिते युक्त एष विप्रो भुजङ्गम\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2194964, "chapter_id": 5147, "verse_number": "५", "content_sanskrit": "न हि देवा न गन्धर्वा नासुरा न च पन्नगाः ।\nप्रभवन्तीह भूतानां प्राप्तानां परमां गतिम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2194965, "chapter_id": 5147, "verse_number": "", "content_sanskrit": "नागः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2194966, "chapter_id": 5147, "verse_number": "६", "content_sanskrit": "एतदेवंविधं दृष्टमाश्चर्यं तत्र मे द्विज ।\nसंसिद्धो मानुषः कायो योऽसौ सिद्धगतिं गतः ।\nसूर्येण सहितो ब्रह्मन् पृथिवीं परिवर्तते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2194967, "chapter_id": 5147, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे षण्णवत्युत्तरशततमोऽध्यायः ॥१९६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]