[{"id": 2091428, "chapter_id": 2945, "verse_number": "१३-७५-१", "content_sanskrit": "भीष्म उवाच।\nएवमेतन्महाबाहो नात्र मिथ्याऽस्ति किञ्चन।\nयथा ब्रवीषि कौरव्य नारीं प्रति जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2091429, "chapter_id": 2945, "verse_number": "१३-७५-२", "content_sanskrit": "अत्र ते वर्तयिष्यामि इतिहासं पुरातनम्।\nयथा रक्षा कृता पूर्वं विपुलेन महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2091430, "chapter_id": 2945, "verse_number": "१३-७५-३", "content_sanskrit": "प्रमदाश्च यथा सृष्टा ब्रह्मणा भरतर्षभ॥\nयदर्थं तच्च ते तात प्रवक्ष्यामि नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2091431, "chapter_id": 2945, "verse_number": "१३-७५-४", "content_sanskrit": "न हि स्त्रीभ्यः परं पुत्र पापीयः किञ्चिदस्ति वै।\nअग्निर्हिः प्रमदा दीप्तो मायाश्च मयजा विभो।\nक्षुरधारा विषं सर्पो मृत्युरित्येकतः स्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2091432, "chapter_id": 2945, "verse_number": "१३-७५-५", "content_sanskrit": "प्रजा इमा महाबाहो धार्मिक्य इति नः श्रुतम्।\nस्वयं गच्छन्ति देवत्वं ततो देवानियाद्भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2091433, "chapter_id": 2945, "verse_number": "१३-७५-६", "content_sanskrit": "अथाभ्यागच्छन्देवास्ते पितामहमरिंदम।\nनिवेद्य मानसं चापि तूष्णीमासन्नधोमुखाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2091434, "chapter_id": 2945, "verse_number": "१३-७५-७", "content_sanskrit": "तेषामन्तर्गतं ज्ञात्वा देवानां स पितामहः।\nमानवानां प्रमोहार्थं कृत्या नार्योऽसृजत्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2091435, "chapter_id": 2945, "verse_number": "१३-७५-८", "content_sanskrit": "पूर्वसर्गे तु कौन्तेय साध्व्यो नार्य इहाभवन्।\nअसाध्व्यस्तु समुत्पन्नाः कृत्याः सर्गात्प्रजापतेः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2091436, "chapter_id": 2945, "verse_number": "१३-७५-९", "content_sanskrit": "ताभ्यः कामान्यथाकामं प्रादाद्धि स पितामहः।\nताः कामलुब्धाः प्रमदाः प्रामथ्नन्त नरान्सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2091437, "chapter_id": 2945, "verse_number": "१३-७५-१०", "content_sanskrit": "क्रोधं कामस्य देवेशः सहायं चासृजत्प्रभुः।\nअसज्जन्त प्रजाः सर्वाः कामक्रोधवशङ्गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2091438, "chapter_id": 2945, "verse_number": "१३-७५-११", "content_sanskrit": "`द्विजानां च गुरूणां च महागुरुनृपादिनाम्।\nक्षणस्त्रीसङ्गकामोत्था यातनाहो निरन्तरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2091439, "chapter_id": 2945, "verse_number": "१३-७५-१२", "content_sanskrit": "अरक्तमनसां नित्यं ब्रह्मचर्यामलात्मनाम्।\nतपोदमार्चनाध्यानयुक्तानां शुद्धिरुत्तमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2091440, "chapter_id": 2945, "verse_number": "१३-७५-१३", "content_sanskrit": "न च स्त्रीणां क्रियाः काश्चिदिति धर्मो व्यवस्थितः।\nनिरिन्द्रिया ह्यशास्त्राश्च स्त्रियोऽनृतमिति श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2091441, "chapter_id": 2945, "verse_number": "१३-७५-१४", "content_sanskrit": "शय्यासनमलङ्कारमन्नपानमनार्यताम्।\nदुर्वाग्भावं रतिं चैव ददौ स्त्रीभ्यः प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2091442, "chapter_id": 2945, "verse_number": "१३-७५-१५", "content_sanskrit": "न तासां रक्षणं शक्यं कर्तुं पुंसां कथञ्चन।\nअपि विस्वकृता तात कुतस्तु पुरुषैरिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2091443, "chapter_id": 2945, "verse_number": "१३-७५-१६", "content_sanskrit": "वाचा च वधबन्धैर्वा क्लेशैर्वा विविधैस्तथा।\nन शक्या रक्षितुं नार्यस्ता हि नित्यमसंयताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2091444, "chapter_id": 2945, "verse_number": "१३-७५-१७", "content_sanskrit": "इदं तु पुरुषव्याघ्र पुरस्ताच्छ्रुतवानहम्।\nयथा रक्षा कृता पूर्वं विपुलेन गुरुस्त्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2091445, "chapter_id": 2945, "verse_number": "१३-७५-१८", "content_sanskrit": "ऋषिरासीन्महाभागो देवशर्मेति विश्रुतः।\nतस्य भार्या रुचिर्नाम रूपेणासदृशी भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2091446, "chapter_id": 2945, "verse_number": "१३-७५-१९", "content_sanskrit": "तस्या रूपेण सम्मत्ता देवगन्धर्वदानवाः।\nविशेषेण तु राजेन्द्र वृत्रहा पाकशासनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2091447, "chapter_id": 2945, "verse_number": "१३-७५-२०", "content_sanskrit": "नारीणां चरितज्ञश्च देवशर्मा महामतिः।\nयथाशक्ति यथोस्साहं भार्यां तामभ्यरक्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2091448, "chapter_id": 2945, "verse_number": "१३-७५-२१", "content_sanskrit": "पुरंदरं च जानंश्च परस्त्रीकामचारिणम्।\nतस्माद्यत्नेन भार्याया रक्षणं स चकार ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2091449, "chapter_id": 2945, "verse_number": "१३-७५-२२", "content_sanskrit": "स कदाचिदृषिस्तात यज्ञं कर्तुमनास्तदा।\nभार्यासंरक्षणं कार्यं कथं स्यादित्यचिन्तयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2091450, "chapter_id": 2945, "verse_number": "१३-७५-२३", "content_sanskrit": "रक्षाविधानं मनसा स सञ्चिन्त्य महातपाः।\nआहूय दयितं शिष्यं विपुलं प्राह भार्गवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2091451, "chapter_id": 2945, "verse_number": "१३-७५-२४", "content_sanskrit": "यज्ञकारो गमिष्यामि रुचिं चेमां सुरेश्वरः।\nयतः प्रार्थयते नित्यं तां रक्षस्व यथाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2091452, "chapter_id": 2945, "verse_number": "१३-७५-२५", "content_sanskrit": "अप्रमत्तेन ते भाव्यं सदा प्रति पुरंदरम्।\nस हि रूपाणि कुरुते विविधानि भृगूत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2091453, "chapter_id": 2945, "verse_number": "१३-७५-२६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2091454, "chapter_id": 2945, "verse_number": "१३-७५-२६", "content_sanskrit": "इत्युक्तो विपुलस्तेन तपस्वी नियतेन्द्रियः।\nसदैवोग्रतपा राजन्नग्र्यर्कसदृशद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2091455, "chapter_id": 2945, "verse_number": "१३-७५-२७", "content_sanskrit": "धर्मज्ञः सत्यवादी च तथेति प्रत्यभाषत।\nपुनश्चेदं महाराज पप्रच्छ प्रस्थितं गुरुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2091456, "chapter_id": 2945, "verse_number": "१३-७५-२८", "content_sanskrit": "कानि रूपाणि शक्रस्य भवन्त्यागच्छतो मुने।\nवपुस्तेजश्च कीदृग्वै तन्मे व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2091457, "chapter_id": 2945, "verse_number": "१३-७५-२९x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2091458, "chapter_id": 2945, "verse_number": "१३-७५-२९", "content_sanskrit": "ततः स भगवांस्तस्मै विपुलाय महात्मने।\nआचचक्षे यथातत्त्वं मायां शक्रस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2091459, "chapter_id": 2945, "verse_number": "१३-७५-३०", "content_sanskrit": "बहुमायः स विप्रर्षे बलहा पाकशासनः।\nतांस्तान्विकुरुते भावान्बहूनथ मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2091460, "chapter_id": 2945, "verse_number": "१३-७५-३१", "content_sanskrit": "किरीटी वज्रधृग्धन्वी मुकुटी बद्धकुण्डलः।\nभवत्यथ मुहूर्तेनि चण्डालसमदर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2091461, "chapter_id": 2945, "verse_number": "१३-७५-३२", "content_sanskrit": "शिखी जटी चीरवासाः पुनर्भवति पुत्रक।\nबृहच्छरीरश्च पनश्चीरवासाः पुनः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2091462, "chapter_id": 2945, "verse_number": "१३-७५-३३", "content_sanskrit": "गौरं श्यामं च कृष्णं च वर्णं विकुरुते पुनः।\nविरूपो रूपवांश्चैव युवा वृद्धस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2091463, "chapter_id": 2945, "verse_number": "१३-७५-३४", "content_sanskrit": "`प्राज्ञो जडश्च मूकश्च ह्रस्वो दीर्घस्तथैव च।\nब्राह्मणः क्षत्रियश्चैव वैश्यः शूद्रस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2091464, "chapter_id": 2945, "verse_number": "१३-७५-३५", "content_sanskrit": "प्रतिलोमोऽनुलोमश्च भवत्यथ शतक्रतुः।\nशुकवायसरूपी च हंसकोकिलरूपवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2091465, "chapter_id": 2945, "verse_number": "१३-७५-३६", "content_sanskrit": "सिंहव्याघ्रगजानां च रूपं धारयते पुनः।\nदैवं दैत्यमथो राज्ञां वपुर्धारयतेऽपि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2091466, "chapter_id": 2945, "verse_number": "१३-७५-३७", "content_sanskrit": "अकृशो मायुभग्राङ्गः शकुनिर्विकृतस्तथा।\nचतुष्पाद्बहुरूपश्च पुनर्भवति बालिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2091467, "chapter_id": 2945, "verse_number": "१३-७५-३८", "content_sanskrit": "मक्षिकामशकादीनां वपुर्धारयतेऽपि च।\nन शक्यमस्य ग्रहणं कर्तुं विपुल केनचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2091468, "chapter_id": 2945, "verse_number": "१३-७५-३९", "content_sanskrit": "अपि विश्वकृता तात येन सृष्टमिदं जगत्।\nपुनरन्तर्हितः शक्रो दृश्यते ज्ञानचक्षुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2091469, "chapter_id": 2945, "verse_number": "१३-७५-४०", "content_sanskrit": "वायुभूतश्च स पुनर्देवराजो भवत्युतः।\nएवंरूपाणि सततं कुरुते पाकशासनः।\nतस्माद्विपुल यत्नेन रक्षेमां तनुमध्यमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2091470, "chapter_id": 2945, "verse_number": "१३-७५-४१", "content_sanskrit": "यथा रुचिं नवलिहेद्देवेन्द्रो भृगुसत्तम।\nक्रतावुपहिते न्यस्तं हविः श्वेव दुरात्मवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2091471, "chapter_id": 2945, "verse_number": "१३-७५-४२", "content_sanskrit": "एवमाख्याय स मुनिर्यज्ञकारोऽगमत्तदा।\nदेवशर्मा महाभागस्ततो भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2091472, "chapter_id": 2945, "verse_number": "१३-७५-४३", "content_sanskrit": "विपुलस्तु वचः श्रुत्वा गुरोश्चिन्तामुपेयिवान्।\nरक्षां च परमां चक्रे देवराजान्महाबलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2091473, "chapter_id": 2945, "verse_number": "१३-७५-४४", "content_sanskrit": "किन्नु शक्यं मया कर्तुं गुरुदाराभिरक्षणे।\nमायावी हि सुरेन्द्रोसौ दुर्धर्षश्चापि वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2091474, "chapter_id": 2945, "verse_number": "१३-७५-४५", "content_sanskrit": "नीपिधायाश्रमं शक्यो रक्षितुं पाकशासनः।\nउटजं वा तथा ह्यस्य नानाविधसरूपता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2091475, "chapter_id": 2945, "verse_number": "१३-७५-४६", "content_sanskrit": "वायुरूपेण वा शक्रो गुरुपत्नीं प्रधर्षयेत्।\nतस्मादिमां सम्प्रविश्य रुचिं स्थास्येहमद्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2091476, "chapter_id": 2945, "verse_number": "१३-७५-४७", "content_sanskrit": "अथवा पौरुषेणेयं न शक्या रक्षितुं मया।\nबहुरूपो हि भगवाञ्छ्रूयते पाकशासनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2091477, "chapter_id": 2945, "verse_number": "१३-७५-४८", "content_sanskrit": "सोहं योगबलादेनां रक्षिष्ये पाकशासनात्।\nगात्राणि गात्रैरस्याहं सम्प्रवेक्ष्ये हि रक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2091478, "chapter_id": 2945, "verse_number": "१३-७५-४९", "content_sanskrit": "यद्युच्छिष्टामिमां पत्नीमद्य पश्यति मे गुरुः।\nशप्स्यत्यसंशयं कोपाद्दिव्यज्ञानो महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2091479, "chapter_id": 2945, "verse_number": "१३-७५-५०", "content_sanskrit": "न चेयं रक्षितुं शक्या यथाऽन्या प्रमदा नृभिः।\nमायावी हि सुरेन्द्रोसावहो प्राप्तोस्मि संशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2091480, "chapter_id": 2945, "verse_number": "१३-७५-५१", "content_sanskrit": "अवश्यं करणीयं हि गुरोरिह हि शासनम्।\nयदि त्वेतदहं कुर्यामाश्चर्यं स्यात्कृतं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2091481, "chapter_id": 2945, "verse_number": "१३-७५-५२", "content_sanskrit": "योगेनाथ प्रविश्येदं गुरुपत्न्याः कलेवरम्।\nअसक्तः पद्मपत्रस्थो जलबिन्दुर्यथा चलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2091482, "chapter_id": 2945, "verse_number": "१३-७५-५३", "content_sanskrit": "एवमेव शरीरे ऽस्या निवत्स्यामि समाहितः।\nनिर्मुक्तस्य रजोरूपान्नापराधो भवेन्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2091483, "chapter_id": 2945, "verse_number": "१३-७५-५४", "content_sanskrit": "यथाहि शून्यां पथिकः सभामध्यावसेत्यथि।\nतथाऽद्यावासयिष्यामि गुरुपत्न्याः कलेवरम्।\nएवमेव शरीरे ऽस्य निवत्स्यामि समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2091484, "chapter_id": 2945, "verse_number": "१३-७५-५५", "content_sanskrit": "इत्येवं धर्ममालोक्य वेदवेदांश्च सर्वशः।\nतपश्च विपुलं दृष्ट्वा गुरोरात्मन एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2091485, "chapter_id": 2945, "verse_number": "१३-७५-५६", "content_sanskrit": "इति निश्चित्य मनसा रक्षां प्रति स भार्गवः।\nअन्वतिष्ठत्परं यत्नं यथा तच्छृणु पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2091486, "chapter_id": 2945, "verse_number": "१३-७५-५७", "content_sanskrit": "गुरुपत्नीं समासीनो विपुलः स महातपाः।\nउपासीनामनिन्द्याङ्गी कथार्थैः समलोभयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2091487, "chapter_id": 2945, "verse_number": "१३-७५-५८", "content_sanskrit": "नेत्राभ्यां नेत्रयोरस्या रश्मिं संयोज्य रश्मिभिः।\nविवेश विपुलः कायमाकाशं पवनो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2091488, "chapter_id": 2945, "verse_number": "१३-७५-५९", "content_sanskrit": "लक्षणं लक्षणेनैव वदनं वदनेन च।\nअविचेष्टन्नतिष्ठद्वै छायेवान्तर्गतो मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2091489, "chapter_id": 2945, "verse_number": "१३-७५-६०", "content_sanskrit": "ततो विष्टभ्य विपुलो गुरुपत्न्याः कलेवरम्।\nउवास रक्षणे युक्तो न च सा तमबुध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2091490, "chapter_id": 2945, "verse_number": "", "content_sanskrit": "यं कालं नागतो राजन्गुरुस्तस्य महात्मनः।\nक्रतुं समाप्य स्वगृहं तं कालं सोऽभ्यरक्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]