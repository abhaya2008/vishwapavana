[{"id": 7000818000, "chapter_id": 20818, "verse_number": "६-१६१-१", "content_sanskrit": "महादेव उवाच ।\nसोमतीर्थं ततो गच्छेद्गुप्तं साभ्रमतीतटे ।\nपातालात्तत्र निर्गत्य कालाग्निरभवद्भवः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000818001, "chapter_id": 20818, "verse_number": "६-१६१-२", "content_sanskrit": "सोमतीर्थे नरः स्नात्वा दृष्ट्वा सोमेश्वरं शिवम् ।\nसोमपानफलं साक्षाद्भवतीति न संशयः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000818002, "chapter_id": 20818, "verse_number": "६-१६१-३", "content_sanskrit": "रूपवान्सुभगो भोगी सर्वशास्त्रविशारदः ।\nनरो भवति लोकेऽस्मिन्परत्र च शिवं व्रजेत्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000818003, "chapter_id": 20818, "verse_number": "६-१६१-४", "content_sanskrit": "अत्रेतिहासं वक्ष्यामि शृणु सुंदरि तत्वतः ।\nयं श्रुत्वा मुच्यते चात्र ब्रह्महत्यादिपातकात्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000818004, "chapter_id": 20818, "verse_number": "६-१६१-५", "content_sanskrit": "कौषीतकेन ऋषिणा तपस्तप्तं विशेषतः ।\nनिराहारी स वै जातः पर्णाशनरतः परम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000818005, "chapter_id": 20818, "verse_number": "६-१६१-६", "content_sanskrit": "वायुभक्षस्ततः कुर्वन्नात्मध्यानपरायणः ।\nएवं बहुयुगं तत्र तप्तं तेन महत्तपः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000818006, "chapter_id": 20818, "verse_number": "६-१६१-७", "content_sanskrit": "कदाचिद्दैवयोगेन सुप्रसन्नो महेश्वरः ।\nयं यं प्रार्थयसे विप्र तत्सर्वं प्रददाम्यहम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000818007, "chapter_id": 20818, "verse_number": "६-१६१-८", "content_sanskrit": "कौषीतक उवाच ।\nतव प्रसादाद्देवेश अत्र लिंगं प्रजायताम् ।\nअत्र सोमेश्वर इति ख्यातो देवो भवेद्ध्रुवम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000818008, "chapter_id": 20818, "verse_number": "६-१६१-९", "content_sanskrit": "यत्र स्नात्वा च भुक्त्वा च वांछितं फलमाप्नुयात् ।\nअत्र स्थाने विशेषेण रुद्रजाप्यादिकं यदि॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000818009, "chapter_id": 20818, "verse_number": "६-१६१-१०", "content_sanskrit": "कारयंति नरश्रेष्ठा धर्मानर्थाल्लंभंति ते ।\nअपुत्रो लभते पुत्रं निर्धनो लभते धनम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000818010, "chapter_id": 20818, "verse_number": "६-१६१-११", "content_sanskrit": "राज्यकामी तु तद्राज्यं लभते नात्र संशयः ।\nयदि चेत्त्वं प्रसन्नोऽसि तत्सर्वं देहि मे प्रभो॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000818011, "chapter_id": 20818, "verse_number": "६-१६१-१२", "content_sanskrit": "ईश्वर उवाच ।\nतदा चैव सुरेशेन सर्वं दत्तं द्विजन्मने ।\nतदा प्रभृति तत्तीर्थं सोमलिंगेति विश्रुतम्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000818012, "chapter_id": 20818, "verse_number": "६-१६१-१३", "content_sanskrit": "चंदनैर्वा बिल्वपत्रैयेऽर्चयंति सदाशिवम् ।\nलभंते मानुषे देहे सौख्यं पुत्रादिसंभवम्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000818013, "chapter_id": 20818, "verse_number": "६-१६१-१४", "content_sanskrit": "सोमवारे तथा प्राप्ते यो गच्छति हरालयम् ।\nवाछितं लभते नित्यं सोमलिंग प्रसादतः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000818014, "chapter_id": 20818, "verse_number": "६-१६१-१५", "content_sanskrit": "अत्र गत्वा तु यो देवि यद्ददाति फलादिकम् ।\nयया कामनया चैव तं तं प्राप्नोति निश्चितम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000818015, "chapter_id": 20818, "verse_number": "६-१६१-१६", "content_sanskrit": "श्वेतैर्वा करवीरैश्च पारिजातैस्तथा पुनः ।\nयेऽर्चयंति च तं देवं श्रीमहेशं पिनाकिनम्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000818016, "chapter_id": 20818, "verse_number": "६-१६१-१७", "content_sanskrit": "ते लभंते सुरश्रेष्ठे शैवं पदमनुत्तमम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]