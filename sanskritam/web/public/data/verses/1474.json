[{"id": 2022492, "chapter_id": 1474, "verse_number": "३-११२-०x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2022493, "chapter_id": 1474, "verse_number": "३-११२-१", "content_sanskrit": "सा तु नाव्याश्रमं चक्रे राजकार्यार्थसिद्धये।\nसंदेशाच्चैव नृपतेः स्वबुद्ध्या चैव भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2022494, "chapter_id": 1474, "verse_number": "३-११२-२", "content_sanskrit": "नानापुष्पफलैर्वृक्षैः कृत्रिमैरुपशोभितैः।\nनानागुल्मलतोपेतैः स्वादुकामफलप्रदैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2022495, "chapter_id": 1474, "verse_number": "३-११२-३", "content_sanskrit": "अतीव रमणीयं तदतीव च मनोहरम्।\nचक्रे नाव्याश्रमं रम्यमद्भुतोपमदेर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2022496, "chapter_id": 1474, "verse_number": "३-११२-४", "content_sanskrit": "ततो निवध्य सा नावमदूरे काश्यपाश्रमात्।\nचारयामास पुरुषैर्विहारं तस्य वै मुनेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2022497, "chapter_id": 1474, "verse_number": "३-११२-५", "content_sanskrit": "ततो दुहितरं वेश्यां समाधायेतिकार्यताम्।\nदृष्ट्वाऽन्तरं काशय्पस्य प्राहिणोद्बुद्धिसंमताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2022498, "chapter_id": 1474, "verse_number": "३-११२-६", "content_sanskrit": "सा तत्र गत्वा कुशला तपोनित्यस्य संनिधौ।\nआश्रमं तं समासाद्य ददर्श तमृषेः सुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2022499, "chapter_id": 1474, "verse_number": "३-११२-७x", "content_sanskrit": "वेश्योवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2022500, "chapter_id": 1474, "verse_number": "३-११२-७", "content_sanskrit": "कच्चिन्मुने कुशलं तापसानां\nकच्चिच्च वो मूलफलं प्रभूतम्।\nकच्चिद्भवान्रमते चाश्रेऽस्मिं-\nस्त्वां वै द्रष्टुं सांप्रतमागतास्मि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2022501, "chapter_id": 1474, "verse_number": "३-११२-८", "content_sanskrit": "कच्चित्तपो वर्धते तापसानां\nपिता च ते कच्चिदहीनतेजाः।\nकच्चित्त्वया प्रीयतेचैव विप्र\nकच्चित्स्वाध्यायः क्रियते चर्श्यशृङ्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2022502, "chapter_id": 1474, "verse_number": "३-११२-९x", "content_sanskrit": "ऋश्यशृङ्ग उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2022503, "chapter_id": 1474, "verse_number": "३-११२-९", "content_sanskrit": "ऋद्ध्या भवाञ्ज्योतिरिव प्रकाशते\nमन्ये चाहं त्वामभिवादनीयम्।\nपाद्यं वै ते संप्रदास्यामि कामा-\nद्यथाधर्मं फलमूलानि चैव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2022504, "chapter_id": 1474, "verse_number": "३-११२-१०", "content_sanskrit": "कौश्यां बृस्यामास्स्व यथोपजोषं\nकृष्णाजिनेनावृतायां सुखाय।\nक्व चाश्रमस्तव किं नाम चेदं\nव्रतंब्रह्मंश्चरसि हि देववत्त्वम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2022505, "chapter_id": 1474, "verse_number": "३-११२-११x", "content_sanskrit": "वेश्योवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2022506, "chapter_id": 1474, "verse_number": "३-११२-११", "content_sanskrit": "ममाश्रमः काश्यपपुत्र रम्य-\nस्त्रियोजनं शैलमिमं परेण।\nतत्रस्वधर्मोऽनभिवादनं नो\nन चोदकं पाद्यमुपस्पृशामः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2022507, "chapter_id": 1474, "verse_number": "३-११२-१२", "content_sanskrit": "भवता नाभिवाद्योऽहमभिवाद्यो भवान्मया।\nव्रतमेतादृशं ब्रह्मन्परिष्वज्यो भवान्मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2022508, "chapter_id": 1474, "verse_number": "३-११२-१३x", "content_sanskrit": "ऋश्यशृङ्ग उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2022509, "chapter_id": 1474, "verse_number": "३-११२-१३", "content_sanskrit": "फलानि पक्वानि ददानि तेऽहं\nभल्लातकान्यामलकानि चैव।\nकरूषकानीङ्गुदधन्वनानि\nप्रियालानां काङ्क्षितं वै कुरुष्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2022510, "chapter_id": 1474, "verse_number": "३-११२-१४x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2022511, "chapter_id": 1474, "verse_number": "३-११२-१४", "content_sanskrit": "सा तानि सर्वाणि विसर्जयित्वा\nभक्ष्याण्यनर्हाणि ददौ ततोऽस्मै।\nतान्यृश्यशृङ्गाय महारसानि\nभृशं सुरूपाणि च मोदकानि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2022512, "chapter_id": 1474, "verse_number": "३-११२-१५", "content_sanskrit": "ददौ च माल्यानि सुगन्धवन्ति\nचित्राणि वासांसि च भानुमन्ति।\nपेयानि चाग्र्याणि ततो मुमोद\nचिक्रीड चैव प्रजहास चैव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2022513, "chapter_id": 1474, "verse_number": "३-११२-१६", "content_sanskrit": "सा कन्दुकेनारमतास्य मूले\nविभज्यमाना फलिता लतेव।\nगात्रैश्च गात्राणि निषेवमाणा\nसमाश्लिषच्चासकृदृश्यशृङ्गम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2022514, "chapter_id": 1474, "verse_number": "३-११२-१७", "content_sanskrit": "सर्जानशोकांस्तिलकांश्च वृक्षा-\nन्सुपुष्पितानवनाम्यावभज्य।\nविलज्जमानेव मदाभिभूता\nप्रोभयामास सुतं महर्षेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2022515, "chapter_id": 1474, "verse_number": "३-११२-१८", "content_sanskrit": "अथर्श्यशृङ्गं विकृतंसमीक्ष्य\nपुनः पुनः पीञ्य च कायमस्य।\nअवेक्ष्यमाणा शनकैर्जगाम\nकृत्वाऽग्निहोत्रस्य तदाऽपदेशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2022516, "chapter_id": 1474, "verse_number": "३-११२-१९", "content_sanskrit": "तस्यां गतायां मदनेन मत्तो\nविचेतनश्चाभवदृश्यशृङ्गः।\nतामेव भावेन गतेन शून्ये\nविनिःश्वसन्नार्तरूपो बभूव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2022517, "chapter_id": 1474, "verse_number": "३-११२-२०", "content_sanskrit": "ततो मुहूर्ताद्धरिपिङ्गलाक्षः\nप्रवेष्टितो रोमभिरानखाग्रात्।\nस्वाध्यायवान्वृत्तसमाधियुक्तो\nविभाण्डकः काश्यपः प्रादुरासीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2022518, "chapter_id": 1474, "verse_number": "३-११२-२१", "content_sanskrit": "सोऽपश्यदासीनमुपेत्य पुत्रं\nध्यायन्तमेकं विपरीतचित्तम्।\nविनिःश्वसन्तं मुहुरूर्ध्वदृष्टिं\nविभाण़्कः पुत्रमुवाच दीनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2022519, "chapter_id": 1474, "verse_number": "३-११२-२२", "content_sanskrit": "न कल्पिताः समिधः किंनु तात\nकच्चिद्धुतं चाग्निहोऽत्रं त्वयाऽद्य।\n`न संसृष्टं क्रियते द्वारभागे\nसुवृक्षाणा खण्डने कः प्रवृत्तः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2022520, "chapter_id": 1474, "verse_number": "३-११२-२३", "content_sanskrit": "सुनिर्णिक्तं स्रुक्स्रुवं होमधेनुः\nकच्चित्सवत्साद्यकृता त्वया च।\n`कोप्यागतः शुश्रूषणायेह पुत्र\nकुतश्चित्रं माल्यमिदं प्रवृद्धम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2022521, "chapter_id": 1474, "verse_number": "३-११२-२४", "content_sanskrit": "न वै यथापूर्वमिवासि पुत्र\nचिन्तापरश्चासि विचेतनश्च।\nदीनोतिमात्रं किमिवाद्य खिन्नः\nपृच्छामि त्वां क इहाद्यागतोऽभूत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2022522, "chapter_id": 1474, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि द्वादशाधिकशततमोऽध्यायः ॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]