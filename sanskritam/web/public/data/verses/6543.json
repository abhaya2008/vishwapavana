[
  {
    "id": 10644301,
    "chapter_id": 6543,
    "verse_number": "11.1",
    "content_sanskrit": "प्रदर्शितमिति ।\nसूत्रेणेत्यर्थः । प्रदर्शितानि वाक्यानि यद्यपि प्रतिपादयन्तीत्यन्वयः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1
  },
  {
    "id": 10644302,
    "chapter_id": 6543,
    "verse_number": "11.2",
    "content_sanskrit": "प्रमाणान्तरस्य विरोधित्वेनोदये विरोधादविरोधेनोदये अनुवादादनुदयेऽर्थाभावात् अप्रामाण्यं वाक्यस्येत्यभिप्रेत्याह -\nपरिनिष्ठित इति ।\nअसाध्यस्वभाववस्तुनीत्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2
  },
  {
    "id": 10644303,
    "chapter_id": 6543,
    "verse_number": "11.3",
    "content_sanskrit": "असंवादशब्देन प्रमाणान्तराणामनुदय उच्यते ।\nसत्यमिति ।\nअनपेक्षत्वमस्त्येवेत्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3
  },
  {
    "id": 10644304,
    "chapter_id": 6543,
    "verse_number": "11.4",
    "content_sanskrit": "असंवादादिति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4
  },
  {
    "id": 10644305,
    "chapter_id": 6543,
    "verse_number": "11.5",
    "content_sanskrit": "समतलमिति ।\nविसंवादाच्चेति भावः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5
  },
  {
    "id": 10644306,
    "chapter_id": 6543,
    "verse_number": "11.6",
    "content_sanskrit": "तथा इहापि स्यादिति ।\nअहं मनुष्य इति प्रत्यक्षेण विसंवादाच्च ब्रह्मैकत्वश्रुतिः अप्रमाणं स्यादित्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6
  },
  {
    "id": 10644307,
    "chapter_id": 6543,
    "verse_number": "11.7",
    "content_sanskrit": "पुरुषार्थशून्यत्वादप्रामाण्यमिति ।\nअपुरुषार्थे तात्पर्याभावादिति भावः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7
  },
  {
    "id": 10644308,
    "chapter_id": 6543,
    "verse_number": "11.8",
    "content_sanskrit": "हानोपादानविषयाविति ।\nप्रवृत्तिन्निवृत्तिसाध्यावित्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8
  },
  {
    "id": 10644309,
    "chapter_id": 6543,
    "verse_number": "11.9",
    "content_sanskrit": "न सिद्ध इति ।\nसिद्धत्वात् क्रियात्वेन साध्यत्वमक्रियाशेषत्वात् क्रियाशेषतया साध्यत्वं च नास्तीत्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9
  },
  {
    "id": 10644310,
    "chapter_id": 6543,
    "verse_number": "11.10",
    "content_sanskrit": "उपपन्ना वेति ।\nअतो वेदान्तवाक्यानामपि विधिसंस्पर्शमन्तरेण अर्थवत्तानुपपन्ना इत्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10
  },
  {
    "id": 10644311,
    "chapter_id": 6543,
    "verse_number": "11.11",
    "content_sanskrit": "अविषये\nब्रह्मणीत्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11
  },
  {
    "id": 10644312,
    "chapter_id": 6543,
    "verse_number": "11.12",
    "content_sanskrit": "शब्दमात्रस्येति ।\nविधिरहितवाक्यस्येत्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12
  },
  {
    "id": 10644313,
    "chapter_id": 6543,
    "verse_number": "11.13",
    "content_sanskrit": "शास्त्रस्येति ।\nविधिपदयुक्त°वाक्यस्येत्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13
  },
  {
    "id": 10644314,
    "chapter_id": 6543,
    "verse_number": "11.14",
    "content_sanskrit": "नानवगतार्थप्रकाशन इति ।\nअतोऽवगतविषयत्वे वक्तव्ये प्रमाणान्तरेणावगत्यभावात् विधिस्पर्शाभावाच्च न ब्रह्मणि प्रामाण्यमिति भावः° ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14
  },
  {
    "id": 10644315,
    "chapter_id": 6543,
    "verse_number": "11.15",
    "content_sanskrit": "संवादाभावादिति ।\nजगत्कारणं सर्वज्ञं ब्रह्मैवेत्यत्र प्रमाणान्तरसंवादाभावादित्यर्थः ।°",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15
  },
  {
    "id": 10644316,
    "chapter_id": 6543,
    "verse_number": "11.16",
    "content_sanskrit": "सत्यमिति ।\nन कारणे सर्वज्ञत्वादिप्रतिपादनेन विधिशेषत्वं वाक्यस्योच्यते भाष्यकारेण, किन्त्वारोपितरूपकथनेनेत्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16
  },
  {
    "id": 10644317,
    "chapter_id": 6543,
    "verse_number": "11.17",
    "content_sanskrit": "उपासनाप्रकरणादपि भिन्नप्रकरणत्वात् न वेदान्तानामुपासनाविधिशेषत्वमिति तत्राह -\nएवं चाध्ययनविधीति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17
  },
  {
    "id": 10644318,
    "chapter_id": 6543,
    "verse_number": "11.18",
    "content_sanskrit": "वेदान्तै°र्ब्रह्मसाक्षात्काराभावे तेषां निष्फलत्वमिति तत्राह -\nफलं चेति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18
  },
  {
    "id": 10644319,
    "chapter_id": 6543,
    "verse_number": "11.19",
    "content_sanskrit": "सूत्रं व्याचष्टे -\nतत् ब्रह्म सर्वज्ञत्वादीत्यादिना ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19
  },
  {
    "id": 10644320,
    "chapter_id": 6543,
    "verse_number": "11.20",
    "content_sanskrit": "सूत्रगतसमित्यंशं व्याचष्टे -\nसम्यगन्वय इत्यादिना ।\nपदानामनुगम इति सम्बन्धः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20
  },
  {
    "id": 10644321,
    "chapter_id": 6543,
    "verse_number": "11.21",
    "content_sanskrit": "गवानयनवाक्यस्थपदानां शुक्लो घट इति वाक्यस्थपदानां यथा भिन्नपदार्थसंसर्गविषयतयान्वयः न तथेह पदानामन्वय इत्याह -\nअनवच्छिन्नार्थानामिति ।\nअभिन्नार्थानामित्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21
  },
  {
    "id": 10644322,
    "chapter_id": 6543,
    "verse_number": "11.22",
    "content_sanskrit": "अभिन्नार्थनिष्ठत्वेऽप्युद्भिद्यागशब्दयोरिव न नियोगापेक्षयान्वय इत्याह -\nअनन्याकाङ्क्षाणामिति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22
  },
  {
    "id": 10644323,
    "chapter_id": 6543,
    "verse_number": "11.23",
    "content_sanskrit": "पदार्थानामपि क्रियाकारकाणामिवान्वयं व्यावर्तयति -\nअव्यतिरिक्तेति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23
  },
  {
    "id": 10644324,
    "chapter_id": 6543,
    "verse_number": "11.24",
    "content_sanskrit": "शुक्लघटादीनामिवान्वयं व्यावर्तयति -\nएकरसेति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24
  },
  {
    "id": 10644325,
    "chapter_id": 6543,
    "verse_number": "11.25",
    "content_sanskrit": "विभक्त्यभिधेयकारकत्वादिभेदो न प्रमेयमनुप्रविशतीत्याह -\nप्रातिपदिकेति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25
  },
  {
    "id": 10644326,
    "chapter_id": 6543,
    "verse_number": "11.26",
    "content_sanskrit": "प्रथमाविभक्त्यर्थभूतलिङ्गसङ्ख्यापरिमा°णादीनामप्यनुप्रवेशो नास्तीत्याह -\nमात्रेति ।\nअनुगमः अन्वय इत्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26
  },
  {
    "id": 10644327,
    "chapter_id": 6543,
    "verse_number": "11.27",
    "content_sanskrit": "अपर्यायशब्दवाच्यत्वात् भिन्नार्थत्वं स्यादित्याशङ्क्य ब्रह्मात्मैकत्वपरवाक्यजातस्यैकरसार्थवृत्तितायामुदाहरणमाह -\nसोऽयमित्यादीति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27
  },
  {
    "id": 10644328,
    "chapter_id": 6543,
    "verse_number": "11.28",
    "content_sanskrit": "सत्यज्ञानादिब्रह्मस्वरूपपरवाक्यजातस्यैकरसार्थवृत्तितायामुदाहरणमाह -\nप्रकृष्टप्रकाशशब्दयोरिवेति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28
  },
  {
    "id": 10644329,
    "chapter_id": 6543,
    "verse_number": "11.29",
    "content_sanskrit": "तयोरेकार्थनिष्ठतामेव दर्शयति -\nतथा च व्यक्तिविशेष इति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29
  },
  {
    "id": 10644330,
    "chapter_id": 6543,
    "verse_number": "11.30",
    "content_sanskrit": "तदेवं प्रतिवचनं भवतीति ।\nप्रकाशसामान्यस्य प्रकर्षगुणस्य चन्द्रप्रातिपदिकाभिधेयत्वाभावात् । प्रकाशप्रकर्षशब्दयोः स्वाभिमताभिधेयत्वा°भावात् । प्रकाशसामान्यं प्रकर्षगुणं च परित्यज्य लक्षणया प्रकाशव्यक्तौ चन्द्रप्रातिपदिकार्थे वृत्तिरित्यभ्युपगमे प्रतिवचनं भवतीत्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30
  },
  {
    "id": 10644331,
    "chapter_id": 6543,
    "verse_number": "11.31",
    "content_sanskrit": "गुणगुण्यन्वयः क्रियाकारकान्वयो वा किं न स्यादित्यत आह -\nएवं च सतीति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31
  },
  {
    "id": 10644332,
    "chapter_id": 6543,
    "verse_number": "11.32",
    "content_sanskrit": "परस्परावच्छिन्नेति ।\nपरस्पराभिन्नेत्यर्थः । एकमेवाद्वितीयमित्यादिभेदप्रतिषेधादिति भावः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32
  },
  {
    "id": 10644333,
    "chapter_id": 6543,
    "verse_number": "11.33",
    "content_sanskrit": "तथाविधानीति ।\nएकरसार्थनिष्ठानीत्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33
  },
  {
    "id": 10644334,
    "chapter_id": 6543,
    "verse_number": "11.34",
    "content_sanskrit": "उदाहरणेष्वेवेति ।\nयतो वा इमानीत्यादिवाक्येष्वेवेत्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34
  },
  {
    "id": 10644335,
    "chapter_id": 6543,
    "verse_number": "11.35",
    "content_sanskrit": "उदहरणान्तरेणेति ।\nसदेवेत्यादिवाक्येनेत्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35
  },
  {
    "id": 10644336,
    "chapter_id": 6543,
    "verse_number": "11.36",
    "content_sanskrit": "तटस्थस्यैवेति ।\nजीवात् पृथग्भूतस्यैवेत्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36
  },
  {
    "id": 10644337,
    "chapter_id": 6543,
    "verse_number": "11.37",
    "content_sanskrit": "इह त्विति ।\nसमन्वयसूत्र इत्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37
  },
  {
    "id": 10644338,
    "chapter_id": 6543,
    "verse_number": "11.38",
    "content_sanskrit": "तथाभूतान्येवेति ।\nजीवस्य ब्रह्मात्मतावगतिपर्यन्तान्येवेत्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38
  },
  {
    "id": 10644339,
    "chapter_id": 6543,
    "verse_number": "11.39",
    "content_sanskrit": "शब्दस्य प्रामाण्यं किं सम्बन्धग्रहणाय शब्दार्थं प्रमाणान्तरविषयमपेक्षते, किं वा शब्दस्य प्रमाणान्तरसम्भिन्नार्थविषयत्वादपेक्षत इति विकल्प्य प्रथमपक्षोऽङ्गीकृत इत्याह -\nयद्यपि शब्दमात्रस्येति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39
  },
  {
    "id": 10644340,
    "chapter_id": 6543,
    "verse_number": "11.40",
    "content_sanskrit": "प्रयोगो दृष्टः इति° ।\nउत्तमवृद्धस्य प्रयोगो दृष्ट इत्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40
  },
  {
    "id": 10644341,
    "chapter_id": 6543,
    "verse_number": "11.41",
    "content_sanskrit": "द्वितीयपक्षोऽनुपपन्न इत्याह -\nव्युत्पत्ता तु कथमिति ।\nकेवलार्थशब्दस्य शक्तिं गृह्णातीति भावः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41
  },
  {
    "id": 10644342,
    "chapter_id": 6543,
    "verse_number": "11.42",
    "content_sanskrit": "तदेवोपपादयति -\nश्रोतृव्यवहारो हीति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42
  },
  {
    "id": 10644343,
    "chapter_id": 6543,
    "verse_number": "11.43",
    "content_sanskrit": "स च श्रोतुरिति ।\nकेवलार्थज्ञाननिमित्तः, श्रोतुर्व्यवहारः, न तु वक्तुर्ज्ञानसम्भिन्नार्थविषयज्ञाननिमित्तः अतः परिशुद्ध° इत्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43
  },
  {
    "id": 10644344,
    "chapter_id": 6543,
    "verse_number": "11.44",
    "content_sanskrit": "ज्ञानान्तरसिद्धार्थावबोधकत्वमिति ।\nवक्तृज्ञानविशिष्टार्थावबोधकत्वं शब्दस्य नावगतमित्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44
  },
  {
    "id": 10644345,
    "chapter_id": 6543,
    "verse_number": "11.45",
    "content_sanskrit": "तेनानवगम्यैवेति ।\nअर्थविषयवक्तृज्ञानमर्थविशेषणतयाऽनवगम्यैव केवलार्थे न शब्दस्य सम्बन्धावगम इत्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45
  },
  {
    "id": 10644346,
    "chapter_id": 6543,
    "verse_number": "11.46",
    "content_sanskrit": "यथावगमं चेति ।\nबालो यदा श्रोता भवति तदा तस्य केवलार्थे शब्दाद्विज्ञानोत्पत्तिर्भवति न वक्तुर्ज्ञानविशिष्टार्थ इत्यर्थः । बालोऽव्युत्पन्नः पश्चादुत्तमवृद्धो यदा भवति तदा ज्ञानान्तरेणार्थमवगम्य विवक्षित्वा परस्मै प्रयुङ्क्ते तत्र प्रमाणान्तरविवक्षयोः उपयोगमिति मध्यमवृद्धस्य शब्दात् ज्ञानोत्पत्तावर्थविशेषणतया शाब्दज्ञानं प्रति विषयत्वेन तयोरुपयोगं न प्रतिपद्यत इत्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46
  },
  {
    "id": 10644347,
    "chapter_id": 6543,
    "verse_number": "11.47",
    "content_sanskrit": "प्रमाणान्तरगृहीतार्थप्रकाशन इति ।\nप्रमाणान्तरविशिष्टार्थप्रकाशन इत्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47
  },
  {
    "id": 10644348,
    "chapter_id": 6543,
    "verse_number": "11.48",
    "content_sanskrit": "कथमप्रामाण्यमाशङ्क्येतेति ।\nअनपेक्षत्वात् प्रमाणान्तरसंवादादिना नाप्रामाण्यमित्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48
  },
  {
    "id": 10644349,
    "chapter_id": 6543,
    "verse_number": "11.49",
    "content_sanskrit": "प्रमेयगतदोषादेव चित्रनिम्नोन्नतादिज्ञानवत् ब्रह्मज्ञानमपि मिथ्येति नेत्याह -\nप्रमेयस्येत्यादिना ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49
  },
  {
    "id": 10644350,
    "chapter_id": 6543,
    "verse_number": "11.50",
    "content_sanskrit": "विषयस्य ज्ञानहेतुत्वाभावे कथं ज्ञानस्य विषयाकारतेति तत्राह -\nशब्दस्यैवेति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50
  },
  {
    "id": 10644351,
    "chapter_id": 6543,
    "verse_number": "11.51",
    "content_sanskrit": "तदेकनिष्ठत्वेनेति ।\nशब्दसामर्थ्यस्यार्थनिष्ठत्वात् ज्ञानस्यार्थाकारतेत्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51
  },
  {
    "id": 10644352,
    "chapter_id": 6543,
    "verse_number": "11.52",
    "content_sanskrit": "तर्हि संवादार्थं ब्रह्मणि प्रमाणान्तरं वक्तव्यमिति नेत्याह -\nन संवादलक्षणमिति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52
  },
  {
    "id": 10644353,
    "chapter_id": 6543,
    "verse_number": "11.53",
    "content_sanskrit": "बोधलक्षणमिति ।\nअज्ञातार्थबोधगम्यं प्रामाण्यमित्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53
  },
  {
    "id": 10644354,
    "chapter_id": 6543,
    "verse_number": "11.54",
    "content_sanskrit": "स्वरूपवाक्यानामपीति ।\nब्रह्मात्मैक्यप्रतिपादकवाक्यानामपीत्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54
  },
  {
    "id": 10644355,
    "chapter_id": 6543,
    "verse_number": "11.55",
    "content_sanskrit": "सूत्रवचनविरोध इति चोदयति -\nननु विधिवाक्यानामेवेति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55
  },
  {
    "id": 10644356,
    "chapter_id": 6543,
    "verse_number": "11.56",
    "content_sanskrit": "सूत्रकारप्रामाण्यादेवाम्नायस्य क्रियार्थत्वमिति नेत्याह -\nन ह्येकमपीति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56
  },
  {
    "id": 10644357,
    "chapter_id": 6543,
    "verse_number": "11.57",
    "content_sanskrit": "प्रवर्तकं प्रमाणमिति लक्षणाद्विधिवाक्यमेव प्रमाणं न बोधकं प्रमाणमिति नेत्याह -\nप्रत्यक्षादिष्वपीति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57
  },
  {
    "id": 10644358,
    "chapter_id": 6543,
    "verse_number": "11.58",
    "content_sanskrit": "ननु भिन्नमेव प्रमाणलक्षणं प्रत्यक्षादिषु वस्तुमात्रावबोधः प्रमाणलक्षणं, प्रवृत्तिनिवृत्ती तु वस्तुस्वभावानुरोधिन्यौ, न प्रमाण°फलं, शब्दे तु पुनः प्रवृत्तिनिवृत्तिफलपर्यन्त एव प्रमाणव्यापारः श्रोतुः पुरुषार्थमुद्दिश्य शब्दप्रयोगात् प्रवृत्तिनिवृत्तिशून्ये भूते वस्तुनि न शब्दप्रामाण्यमित्याह -\nआह युक्तमित्यादिना ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58
  },
  {
    "id": 10644359,
    "chapter_id": 6543,
    "verse_number": "11.59",
    "content_sanskrit": "तावतेति ।\nअज्ञातार्थबोधकत्वादेवेत्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59
  },
  {
    "id": 10644360,
    "chapter_id": 6543,
    "verse_number": "11.60",
    "content_sanskrit": "अपेक्षान्तराभावादिति ।\nविषयस्य पुरुषार्थत्वापेक्षाभावादित्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60
  },
  {
    "id": 10644361,
    "chapter_id": 6543,
    "verse_number": "11.61",
    "content_sanskrit": "विध्यानर्थक्येति ।\nअध्ययनविध्यानर्थक्यप्रसङ्गादित्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61
  },
  {
    "id": 10644362,
    "chapter_id": 6543,
    "verse_number": "11.62",
    "content_sanskrit": "न त्वि°त्थमन्यथा वेति ।\nप्रवृत्तिनिवृत्तिसाध्यमेव स्यादसाध्यं मे स्यादिति वा नापेक्षत इत्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62
  },
  {
    "id": 10644363,
    "chapter_id": 6543,
    "verse_number": "11.63",
    "content_sanskrit": "पुरुषार्थश्चेत् साध्य एवेति निश्चिनुयादिति तत्राह -\nन चास्येति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63
  },
  {
    "id": 10644364,
    "chapter_id": 6543,
    "verse_number": "11.64",
    "content_sanskrit": "ननु सर्वः साध्य एव पुरुषार्थः, न तु सिद्धस्वभावः प्रेप्सागोचरत्वाभावादिति तत्राह -\nद्विविधं चेष्टमिति° ।\nकिञ्चित्प्राप्तमपीत्यत्र भ्रान्त्या अप्राप्तं प्रेप्सतीत्यन्वयः । भ्रान्त्या अपरिहृतं परिजिहीर्षतीत्यन्वयः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64
  },
  {
    "id": 10644365,
    "chapter_id": 6543,
    "verse_number": "11.65",
    "content_sanskrit": "प्राप्यपरिहार्ययोरिति ।\nग्रामगर्तयोरित्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65
  },
  {
    "id": 10644366,
    "chapter_id": 6543,
    "verse_number": "11.66",
    "content_sanskrit": "साधनज्ञानायत्तत्वादिति ।\nसाधनज्ञानतदनुष्ठानायत्तत्वादित्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66
  },
  {
    "id": 10644367,
    "chapter_id": 6543,
    "verse_number": "11.67",
    "content_sanskrit": "इतरयोरिति ।\nप्राप्तसुवर्णपरिहृतसर्पयोरित्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67
  },
  {
    "id": 10644368,
    "chapter_id": 6543,
    "verse_number": "11.68",
    "content_sanskrit": "एवमपीति ।\nज्ञानमात्रेणलभ्यमानमपीत्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68
  },
  {
    "id": 10644369,
    "chapter_id": 6543,
    "verse_number": "11.69",
    "content_sanskrit": "साधनसाध्यात् ज्ञानलभ्यस्यातिशयेन पुरुषार्थतामा -\nसुतरां चाभिनन्दतीति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69
  },
  {
    "id": 10644370,
    "chapter_id": 6543,
    "verse_number": "11.70",
    "content_sanskrit": "ब्रह्मात्मैकत्वे प्रतिपाद्यमाने ज्ञानमात्रलभ्यः पुरुषार्थोऽस्तीत्याह -\nअनेकानर्थकलुषितमिवेति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70
  },
  {
    "id": 10644371,
    "chapter_id": 6543,
    "verse_number": "11.71",
    "content_sanskrit": "न विध्यानर्थक्यप्रसङ्ग इति ।\nनाध्ययनविध्यानर्थक्यप्रसङ्ग इत्यर्थः । इति परानन्द° || इति अष्टमवर्णककाशिका ||",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71
  }
]