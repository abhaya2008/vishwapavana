[{"id": 2014386, "chapter_id": 1296, "verse_number": "२-३७-१", "content_sanskrit": "वैशम्पायन उवाच॥\nतत आमन्त्रिता राजन्राजानः सत्कृतास्तदा।\nपुरेभ्यः प्रययुस्तेभ्यो विमानेभ्य इवामराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2014387, "chapter_id": 1296, "verse_number": "२-३७-२", "content_sanskrit": "ते वै दिग्भ्यः समापेतुः पार्थिवास्तत्र भारत।\nसमादाय महार्हाणि रत्नानि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2014388, "chapter_id": 1296, "verse_number": "२-३७-३", "content_sanskrit": "तच्छ्रुत्वा धर्मराजस्य यज्ञे यज्ञविदस्तदा।\nराजानः शतशस्तुष्टैर्मनोभिर्मनुर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2014389, "chapter_id": 1296, "verse_number": "२-३७-४", "content_sanskrit": "बहु वित्तं समादाय विविधं पार्थिवा ययुः।\nद्रष्टुकामाः सभां चैव धर्मराजं च पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2014390, "chapter_id": 1296, "verse_number": "२-३७-५", "content_sanskrit": "स गत्वा हास्तिनपुरं नकुलः समितिञ्जयः।\nभीष्ममामन्त्रयाञ्चक्रे धृतराष्ट्रं च पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2014391, "chapter_id": 1296, "verse_number": "२-३७-६", "content_sanskrit": "प्रयतः प्राञ्जलिर्भूत्वा भारतानानयत्तदा।\nधृतराष्ट्रं च भीष्मं च विदुरं च महामतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2014392, "chapter_id": 1296, "verse_number": "२-३७-७", "content_sanskrit": "दुर्योधनमुखांश्चैव भ्रातॄन्सर्वानथानयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2014393, "chapter_id": 1296, "verse_number": "२-३७-८", "content_sanskrit": "सत्कृत्यामन्त्रिताः सर्वे ह्याचार्यप्रमुखास्ततः।\nप्रययुः प्रीतमनसो यज्ञं ब्रह्मपुरस्सराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2014394, "chapter_id": 1296, "verse_number": "२-३७-९", "content_sanskrit": "धृतराष्ट्रश्च भीष्मश्च विदुरस्च महामतिः।\nदुर्योधनपुरोगाश्च भ्रातरः सर्व एव ते।\nगान्धारराजः सुबलः शकुनिश्च महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2014395, "chapter_id": 1296, "verse_number": "२-३७-१०", "content_sanskrit": "अचलो वृषकश्चैव कर्णश्च रथिनां वरः।\nतथा शल्यश्च बलवान्बाह्लिकश्च महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2014396, "chapter_id": 1296, "verse_number": "२-३७-११", "content_sanskrit": "सोमदत्तोऽथ कौरव्यो भूरिर्भूरिश्रवाः शलः।\nअश्वत्थामा कृपो द्रोणः सैन्धवश्च जयद्रथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2014397, "chapter_id": 1296, "verse_number": "२-३७-१२", "content_sanskrit": "यज्ञसेनः सपुत्रश्च साल्वश्च वसुधाधिपः।\nप्राग्ज्योतिषश्च नृपतिर्भगदत्तो महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2014398, "chapter_id": 1296, "verse_number": "२-३७-१३", "content_sanskrit": "स तु सर्वैः सह म्लेच्छैः सागरानूपवासिभिः।\nपार्वतीयाश्च राजानो राजा चैव बृहद्बलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2014399, "chapter_id": 1296, "verse_number": "२-३७-१४", "content_sanskrit": "पौण्ड्रको वासुदेवश्च वङ्गः कालिङ्गकस्तथा।\nआकर्षाः कुन्तलाश्चैव गालवाश्चान्ध्रकास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2014400, "chapter_id": 1296, "verse_number": "२-३७-१५", "content_sanskrit": "द्राविडाः सिंहलाश्चैव राजा काश्मीरकस्तथा।\nकुन्तिभोजो महातेजाः पार्थिवो गौरवाहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2014401, "chapter_id": 1296, "verse_number": "२-३७-१६", "content_sanskrit": "बाह्लिकाश्चापरे शूरा राजानः सर्व एव ते।\nविराटः सह पुत्राभ्यां मावेल्लश्च महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2014402, "chapter_id": 1296, "verse_number": "२-३७-१७", "content_sanskrit": "राजानो राजपुत्राश्च नानाजनपदेश्वराः।\nशिशुपालो महावीर्यः सह पुत्रेण भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2014403, "chapter_id": 1296, "verse_number": "२-३७-१८", "content_sanskrit": "आगच्छत्पाण्डवेयस्य यज्ञं समरदुर्मदः।\nरामश्चैवानिरुद्धश्च कङ्कश्च सहसारणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2014404, "chapter_id": 1296, "verse_number": "२-३७-१९", "content_sanskrit": "गदप्रद्युम्नसाम्बाश्च चारुदेष्णश्च वीर्यवान्।\nउल्मुको निशठश्चैव वीरश्चाङ्गावहस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2014405, "chapter_id": 1296, "verse_number": "२-३७-२०", "content_sanskrit": "वृष्णयो निखिलाश्चान्ये समाजग्मुर्महारथाः।\nएते चान्ये च बहवो राजानो मध्यदेशजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2014406, "chapter_id": 1296, "verse_number": "२-३७-२१", "content_sanskrit": "आजग्मुः पाण्डुपुत्रस्य राजसूयं महाक्रतुम्।\nददुस्तेषामावसथान्धर्मराजस्य शासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2014407, "chapter_id": 1296, "verse_number": "२-३७-२२", "content_sanskrit": "बहुभक्ष्यान्वितान्राजन्दीर्घिकावृक्षशोभितान्।\nतथा धर्मात्मजः पूजां चक्रे तेषां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2014408, "chapter_id": 1296, "verse_number": "२-३७-२३", "content_sanskrit": "सत्कृताश्च यथोद्दिष्टाञ्जग्मुरावसथान्नृपाः।\nकैलासशिखरप्रख्यान्मनोज्ञान्द्रव्यभूषितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2014409, "chapter_id": 1296, "verse_number": "२-३७-२४", "content_sanskrit": "सर्वतः संवृतानुच्चैः प्राकारैः सुकृतैः सितैः।\nसुवर्णजालसंवीतान्मणिकुट्टिमभूषितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2014410, "chapter_id": 1296, "verse_number": "२-३७-२५", "content_sanskrit": "सुखारोहणसोपानान्महासनपरिच्छदान्।\nस्नग्दामसमवच्छन्नानुत्तमागुरुगन्धिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2014411, "chapter_id": 1296, "verse_number": "२-३७-२६", "content_sanskrit": "हंसेन्दुवर्णसदृशानायोजनसुदर्शनान्।\nअसम्बाधान्समद्वारान्युतानुच्चावचैर्गुणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2014412, "chapter_id": 1296, "verse_number": "२-३७-२७", "content_sanskrit": "बहुधातुनिबद्धाङ्गान्हिमवच्छिखरानिव।\nविश्रान्तास्ते ततोऽपश्यन्भूमिपा भूरिदक्षिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2014413, "chapter_id": 1296, "verse_number": "२-३७-२८", "content_sanskrit": "वृतं सदस्यैर्बहुभिर्धर्मराजं युधिष्ठिरम्।\nतत्सदः पार्थिवैः कीर्णं ब्राह्मणैश्च महर्षिभिः।\nभ्राजते स्म तदा राजन्नाकपृष्ठं यथाऽमरैः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2014414, "chapter_id": 1296, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि दिग्विजयपर्वणि सप्तत्रिंशोऽध्यायः॥ ३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]