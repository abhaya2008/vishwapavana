[{"id": 5000072000, "chapter_id": 9072, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे द्विसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000072001, "chapter_id": 9072, "verse_number": "१-७२-१", "content_sanskrit": "तमुक्तवन्तं वैदेहं विश्वामित्रो महामुनिः।\nउवाच वचनं वीरं वसिष्ठसहितो नृपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000072002, "chapter_id": 9072, "verse_number": "१-७२-२", "content_sanskrit": "अचिन्त्यान्यप्रमेयाणि कुलानि नरपुंगव।\nइक्ष्वाकूणां विदेहानां नैषां तुल्योऽस्ति कश्चन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000072003, "chapter_id": 9072, "verse_number": "१-७२-३", "content_sanskrit": "सदृशो धर्मसम्बन्धः सदृशो रूपसम्पदा।\nरामलक्ष्मणयो राजन् सीता चोर्मिलया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000072004, "chapter_id": 9072, "verse_number": "१-७२-४", "content_sanskrit": "वक्तव्यं च नरश्रेष्ठ श्रूयतां वचनं मम।\nभ्राता यवीयान् धर्मज्ञ एष राजा कुशध्वजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000072005, "chapter_id": 9072, "verse_number": "१-७२-५", "content_sanskrit": "अस्य धर्मात्मनो राजन् रूपेणाप्रतिमं भुवि।\nसुताद्वयं नरश्रेष्ठ पत्न्यर्थं वरयामहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000072006, "chapter_id": 9072, "verse_number": "१-७२-६", "content_sanskrit": "भरतस्य कुमारस्य शत्रुघ्नस्य च धीमतः।\nवरये ते सुते राजंस्तयोरर्थे महात्मनोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000072007, "chapter_id": 9072, "verse_number": "१-७२-७", "content_sanskrit": "पुत्रा दशरथस्येमे रूपयौवनशालिनः।\nलोकपालसमाः सर्वे देवतुल्यपराक्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000072008, "chapter_id": 9072, "verse_number": "१-७२-८", "content_sanskrit": "उभयोरपि राजेन्द्र सम्बन्धेनानुबध्यताम्।\nइक्ष्वाकुकुलमव्यग्रं भवतः पुण्यकर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000072009, "chapter_id": 9072, "verse_number": "१-७२-९", "content_sanskrit": "विश्वामित्रवचः श्रुत्वा वसिष्ठस्य मते तदा।\nजनकः प्राञ्जलिर्वाक्यमुवाच मुनिपुंगवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000072010, "chapter_id": 9072, "verse_number": "१-७२-१०", "content_sanskrit": "कुलं धन्यमिदं मन्ये येषां तौ मुनिपुंगवौ।\nसदृशं कुलसम्बन्धं यदाज्ञापयतः स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000072011, "chapter_id": 9072, "verse_number": "१-७२-११", "content_sanskrit": "एवं भवतु भद्रं वः कुशध्वजसुते इमे।\nपत्न्यौ भजेतां सहितौ शत्रुघ्नभरतावुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000072012, "chapter_id": 9072, "verse_number": "१-७२-१२", "content_sanskrit": "एकाह्ना राजपुत्रीणां चतसॄणां महामुने।\nपाणीन् गृह्णन्तु चत्वारो राजपुत्रा महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000072013, "chapter_id": 9072, "verse_number": "१-७२-१३", "content_sanskrit": "उत्तरे दिवसे ब्रह्मन् फल्गुनीभ्यां मनीषिणः।\nवैवाहिकं प्रशंसन्ति भगो यत्र प्रजापतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000072014, "chapter_id": 9072, "verse_number": "१-७२-१४", "content_sanskrit": "एवमुक्त्वा वचः सौम्यं प्रत्युत्थाय कृताञ्जलिः।\nउभौ मुनिवरौ राजा जनको वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000072015, "chapter_id": 9072, "verse_number": "१-७२-१५", "content_sanskrit": "परो धर्मः कृतो मह्यं शिष्योऽस्मि भवतोस्तथा।\nइमान्यासनमुख्यानि आस्यतां मुनिपुंगवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000072016, "chapter_id": 9072, "verse_number": "१-७२-१६", "content_sanskrit": "यथा दशरथस्येयं तथायोध्या पुरी मम।\nप्रभुत्वे नास्ति संदेहो यथार्हं कर्तुमर्हथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000072017, "chapter_id": 9072, "verse_number": "१-७२-१७", "content_sanskrit": "तथा ब्रुवति वैदेहे जनके रघुनन्दनः।\nराजा दशरथो हृष्टः प्रत्युवाच महीपतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000072018, "chapter_id": 9072, "verse_number": "१-७२-१८", "content_sanskrit": "युवामसंख्येयगुणौ भ्रातरौ मिथिलेश्वरौ।\nऋषयो राजसङ्घाश्च भवद्भ्यामभिपूजिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000072019, "chapter_id": 9072, "verse_number": "१-७२-१९", "content_sanskrit": "स्वस्ति प्राप्नुहि भद्रं ते गमिष्यामः स्वमालयम्।\nश्राद्धकर्माणि विधिवद्विधास्य इति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000072020, "chapter_id": 9072, "verse_number": "१-७२-२०", "content_sanskrit": "तमापृष्ट्वा नरपतिं राजा दशरथस्तदा।\nमुनीन्द्रौ तौ पुरस्कृत्य जगामाशु महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000072021, "chapter_id": 9072, "verse_number": "१-७२-२१", "content_sanskrit": "स गत्वा निलयं राजा श्राद्धं कृत्वा विधानतः।\nप्रभाते काल्यमुत्थाय चक्रे गोदानमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000072022, "chapter_id": 9072, "verse_number": "१-७२-२२", "content_sanskrit": "गवां शतसहस्रं च ब्राह्मणेभ्यो नराधिपः।\nएकैकशो ददौ राजा पुत्रानुद्दिश्य धर्मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000072023, "chapter_id": 9072, "verse_number": "१-७२-२३", "content_sanskrit": "सुवर्णशृङ्ग्यः सम्पन्नाः सवत्साः कांस्यदोहनाः।\nगवां शतसहस्राणि चत्वारि पुरुषर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000072024, "chapter_id": 9072, "verse_number": "१-७२-२४", "content_sanskrit": "वित्तमन्यच्च सुबहु द्विजेभ्यो रघुनन्दनः।\nददौ गोदानमुद्दिश्य पुत्राणां पुत्रवत्सलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000072025, "chapter_id": 9072, "verse_number": "१-७२-२५", "content_sanskrit": "स सुतैः कृतगोदानैर्वृतः सन्नृपतिस्तदा।\nलोकपालैरिवाभाति वृतः सौम्यः प्रजापतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000072026, "chapter_id": 9072, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे द्विसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]