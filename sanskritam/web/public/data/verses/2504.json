[{"id": 2071297, "chapter_id": 2504, "verse_number": "१२-९-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2071298, "chapter_id": 2504, "verse_number": "१२-९-१", "content_sanskrit": "मुहूर्तं तावदेकाग्रो मनः श्रोत्रेऽन्तरात्मनि।\nधारयन्नपि ते श्रुत्वा रोचते वचनं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2071299, "chapter_id": 2504, "verse_number": "१२-९-२", "content_sanskrit": "सार्थगम्यमहं मार्गं न जातु त्वत्कृते पुनः।\nगच्छेयं तं गमिष्यामि हित्वा ग्राम्यसुखान्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2071300, "chapter_id": 2504, "verse_number": "१२-९-३", "content_sanskrit": "क्षेम्यश्चैकाकिना गम्यः पन्था कोस्तीति पृच्छ माम्।\nअथवा नेच्छसि प्रष्टुमपृच्छन्नपि मे शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2071301, "chapter_id": 2504, "verse_number": "१२-९-४", "content_sanskrit": "हित्वा ग्राम्यसुखाचारं तप्यमानो महत्तपः।\nअरण्ये फलमूलाशी चरिष्यामि मृगैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2071302, "chapter_id": 2504, "verse_number": "१२-९-५", "content_sanskrit": "जुह्वानोऽग्निं यथाकालमुभौ कालावुपस्पृशन्।\nकृशः परिमिताहारश्चर्मचीरजटाधरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2071303, "chapter_id": 2504, "verse_number": "१२-९-६", "content_sanskrit": "शीतवातातपसहः क्षुत्पिपासाश्रमक्षमः।\nतपसा विधिदृष्टेन शरीरमुपशोषयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2071304, "chapter_id": 2504, "verse_number": "१२-९-७", "content_sanskrit": "मनःकर्णसुखा नित्यं श्रृण्वन्नुच्चावचा गिरः।\nमुदितानामरण्येषु नदतां मृगपक्षिणाम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2071305, "chapter_id": 2504, "verse_number": "१२-९-८", "content_sanskrit": "आजिघ्रन्पेशलान्गन्धान्फुल्लानां वृक्षवीरुधाम्॥\nनानारूपान्वने पश्यन्रमणीयान्वनौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2071306, "chapter_id": 2504, "verse_number": "१२-९-९", "content_sanskrit": "वानप्रस्थजनस्यापि दर्शनं कूलवासिनः।\nनाप्रियाण्याचरिष्यामि किंपुनर्ग्रामवासिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2071307, "chapter_id": 2504, "verse_number": "१२-९-१०", "content_sanskrit": "एकान्तशीली विमृशन्पक्वापक्वेन वर्तयन्।\nपितॄन्देवांश्च वन्येन वाग्भिरद्भिश्च तर्पयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2071308, "chapter_id": 2504, "verse_number": "१२-९-११", "content_sanskrit": "एवमारण्यशास्त्राणामुग्रमुग्रतरं विधिम्।\nसेवमानः प्रतीक्षिष्ये देहस्यास्य समापनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2071309, "chapter_id": 2504, "verse_number": "१२-९-१२", "content_sanskrit": "अथवैकोऽहमेकाहमेकैकस्मिन्वनस्पतौ।\nचरन्भैक्षं मुनिर्मुण्डः क्षपयिष्ये कलेवरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2071310, "chapter_id": 2504, "verse_number": "१२-९-१३", "content_sanskrit": "पांसुभिः समभिच्छन्नः शून्यागारप्रतिश्रयः।\nवृक्षमूलनिकेतो वा त्यक्तसर्वप्रियाप्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2071311, "chapter_id": 2504, "verse_number": "१२-९-१४", "content_sanskrit": "न शोचन्न प्रहृष्यंश्च तुल्यनिन्दात्मसंस्तुतिः।\nनिराशीर्निर्ममो भूत्वा निर्द्वन्द्वो निष्परिग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2071312, "chapter_id": 2504, "verse_number": "१२-९-१५", "content_sanskrit": "आत्मारामः प्रसन्नात्मा जडान्धबधिराकृतिः।\nअकुर्वाणः परैः कांचित्संविदं जातु कैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2071313, "chapter_id": 2504, "verse_number": "१२-९-१६", "content_sanskrit": "जङ्गमाजङ्गमान्सर्वानविहिंसंश्चतुर्विधान्।\nप्रजाः सर्वाः स्वधर्मस्थाः समः प्राणभृतः प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2071314, "chapter_id": 2504, "verse_number": "१२-९-१७", "content_sanskrit": "न चाप्यवहसन्कंचिन्न कुर्वन्भ्रुकुटीः क्वचित्।\nप्रसन्नवदनो नित्यं सर्वेन्द्रियसुसंयतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2071315, "chapter_id": 2504, "verse_number": "१२-९-१८", "content_sanskrit": "अपृच्छन्कस्यचिन्मार्गं प्रव्रजन्नेव केनचित्।\nन देशं न दिशं कांचिद्गन्तुमिच्छन्विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2071316, "chapter_id": 2504, "verse_number": "१२-९-१९", "content_sanskrit": "गमने निरपेक्षश्च पश्चादनवलोकयन्।\nऋजुः प्रणिहितो गच्छन्स्त्रीसंस्थापरिवर्जकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2071317, "chapter_id": 2504, "verse_number": "१२-९-२०", "content_sanskrit": "स्वभावस्तु प्रयात्यग्रे प्रभवन्त्यशनान्यपि।\nद्वन्द्वानि च विरुद्धानि तानि सर्वाण्यचिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2071318, "chapter_id": 2504, "verse_number": "१२-९-२१", "content_sanskrit": "अल्पं वा स्वादु वा भोज्यं पूर्वालाभेन जातुचित्।\nअन्येष्वपि चरँल्लाभमलाभे सप्त पूरयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2071319, "chapter_id": 2504, "verse_number": "१२-९-२२", "content_sanskrit": "विधूमे न्यस्तमुसले व्यङ्गारे भुक्तवज्जने।\nअतीतपात्रसंचारे काले विगतभिक्षुके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2071320, "chapter_id": 2504, "verse_number": "१२-९-२३", "content_sanskrit": "एककालं चरन्भैक्षं त्रीनथ द्वे च पञ्च वा।\nस्नेहपाशं विमुच्याहं चरिष्यामि महीमिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2071321, "chapter_id": 2504, "verse_number": "१२-९-२४", "content_sanskrit": "अलाभे सति वा लाभे समदर्शी महातपाः।\nन जिजीविषुवत्किंचिन्न मुमूर्षुवदाचरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2071322, "chapter_id": 2504, "verse_number": "१२-९-२५", "content_sanskrit": "जीवितं मरणं चैव नाभिनन्दन्न च द्विपन्।\nवास्यैकं तक्षतो बाहुं चन्दनेनैकपुक्षतः।\nनाकल्याणं न कल्याणं चिन्तयन्नुभयोस्तयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2071323, "chapter_id": 2504, "verse_number": "१२-९-२६", "content_sanskrit": "याः काश्चिज्जीवता शक्याः कर्तुमभ्युदयक्रियाः।\nसर्वास्ताः समभित्यज्य निमेषादिव्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2071324, "chapter_id": 2504, "verse_number": "१२-९-२७", "content_sanskrit": "तेषु नित्यमसक्तश्च त्यक्तसर्वेन्द्रियक्रियः।\nअपरित्यक्तसंकल्पः सुनिर्णिक्तात्मकल्मपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2071325, "chapter_id": 2504, "verse_number": "१२-९-२८", "content_sanskrit": "विमुक्तः सर्वसङ्गेभ्यो व्यतीतः सर्ववागुराः।\nन वशे कस्यचित्तिष्ठन्सधर्मा मातरिश्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2071326, "chapter_id": 2504, "verse_number": "१२-९-२९", "content_sanskrit": "वीतरागश्चरन्नेवं तुष्टिं प्राप्स्यामि मानसीम्।\nतृष्णया हि महत्पापमज्ञानादस्मि कारितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2071327, "chapter_id": 2504, "verse_number": "१२-९-३०", "content_sanskrit": "कुशलाकुशलान्येके कृत्वा कर्माणि मानवाः।\nकार्यकारणसंश्लिष्टं स्वजनं नाम ब्रिभ्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2071328, "chapter_id": 2504, "verse_number": "१२-९-३१", "content_sanskrit": "आयुपोऽन्ते प्रहायेदं क्षीणप्राणं कलेवरम्।\nप्रतिगृह्णाति तत्पापं कर्तुः कर्मफलं हि तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2071329, "chapter_id": 2504, "verse_number": "१२-९-३२", "content_sanskrit": "एवं संसारचक्रेऽस्मिन्व्याविद्धे रथचक्रवत्।\nसमेति भूतग्रामोऽयं भूतग्रामेण कार्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2071330, "chapter_id": 2504, "verse_number": "१२-९-३३", "content_sanskrit": "जन्ममृत्युजराव्याधिवेदनाभिरभिद्रुतम्।\nअपारमिव चास्वस्थं संसारं त्यजतः सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2071331, "chapter_id": 2504, "verse_number": "१२-९-३४", "content_sanskrit": "दिवः पतत्सु देवेषु स्थानेभ्यश्च महर्षिषु।\nको हि नाम भवेनार्थी भवेत्कारणतत्त्ववित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2071332, "chapter_id": 2504, "verse_number": "१२-९-३५", "content_sanskrit": "कृत्वा हि विविधं कर्म तत्तद्विविधलक्षणम्।\nपार्थिवैर्नृपतिः स्वल्पैः कारणैरेव बध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2071333, "chapter_id": 2504, "verse_number": "१२-९-३६", "content_sanskrit": "तस्मात्प्रज्ञामुतमिदं चिरान्मां प्रत्युपस्थितम्।\nतत्प्राप्य प्रार्थये स्थानमव्ययं शाश्वतं ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2071334, "chapter_id": 2504, "verse_number": "१२-९-३७", "content_sanskrit": "एतया संततं धृत्या चरन्नेवंप्रकारया।\nजन्ममृत्युजराव्याधिवेदनाभिरभिद्रुतम्।\nदेहं संस्थापयिष्यामि निर्भयं मार्गमास्थितः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2071335, "chapter_id": 2504, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि नवमोऽध्यायः॥ ९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]