[{"id": 7004212000, "chapter_id": 24212, "verse_number": "५-१-६१-१", "content_sanskrit": "सनत्कुमार उवाच ।\nअधिमासं समासाद्य योऽन्यत्र स्थितिमात्मनः ।\nकरोति स नरो मूर्खो महाकालवनादृते॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004212001, "chapter_id": 24212, "verse_number": "५-१-६१-२", "content_sanskrit": "अधिमासे नरो व्यास तीर्थे पुरुषोत्तमाभिधे ।\nस्नात्वा दत्त्वा च दानानि तेषां लोकाः सनातनाः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004212002, "chapter_id": 24212, "verse_number": "५-१-६१-३", "content_sanskrit": "पुरुषोत्तमं समभ्यर्च्य रमालालितपादकम् ।\nतथैव च उमां देवीं शंकरेण च पूजयेत्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004212003, "chapter_id": 24212, "verse_number": "५-१-६१-४", "content_sanskrit": "वांछितार्थशतं प्राप्य विष्णुलोके महीयते ।\nभाद्रपदे सिते पक्षे एकादश्यां समाहितः ।\nउपोष्य विधिवद्व्यास रात्रौ जागरणं चरेत्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004212004, "chapter_id": 24212, "verse_number": "५-१-६१-५", "content_sanskrit": "विष्णोश्च पूजनं कार्यं जलयात्रा तथैव च ।\nपुरुषोत्तमसरे नित्यं तस्य पुण्यफलं शृणु॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004212005, "chapter_id": 24212, "verse_number": "५-१-६१-६", "content_sanskrit": "पुत्रदारधनं सम्यगायुरारोग्यसंपदः ।\nन तेषां दुर्लभं किंचित्त्रिषु लोकेषु विद्यते॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004212006, "chapter_id": 24212, "verse_number": "५-१-६१-७", "content_sanskrit": "तस्य पूर्वतरे भागे जटेश्वरमहेश्वरः ।\nतिष्ठति तापसस्तीरे यत्र राजा भगीरथः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004212007, "chapter_id": 24212, "verse_number": "५-१-६१-८", "content_sanskrit": "तपस्तप्त्वा परं लेभे पुण्यं पुण्यवतां वरः ।\nगंगां भूतलमानीय सर्वलोकसुखाय वै॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004212008, "chapter_id": 24212, "verse_number": "५-१-६१-९", "content_sanskrit": "तस्य तीर्थे नरः स्नात्वा तिलधेनुं प्रदापयेत् ।\nसर्वयज्ञफलं प्राप्य पुत्रवाञ्जा यते नरः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004212009, "chapter_id": 24212, "verse_number": "५-१-६१-१०", "content_sanskrit": "तस्येशानतरे भागे रामो भार्गवसत्तमः ।\nतपस्तेपे सुधर्मात्मा आत्मकायविशुद्धये॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004212010, "chapter_id": 24212, "verse_number": "५-१-६१-११", "content_sanskrit": "कौशिकी च सरिच्छ्रेष्ठा सर्वतीर्थवरप्रदा ।\nतत्र स्नात्वा नरो जातिहत्यादोषविवर्जितः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004212011, "chapter_id": 24212, "verse_number": "५-१-६१-१२", "content_sanskrit": "रामेश्वरं समालोक्य धूतपापो भवेन्नरः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]