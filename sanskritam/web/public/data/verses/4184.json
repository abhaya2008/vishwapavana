[{"id": 2147299, "chapter_id": 4184, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2147300, "chapter_id": 4184, "verse_number": "१", "content_sanskrit": "हर्यश्वस्त्वब्रवीद् वाक्यं विचिन्त्य बहुधा ततः ।\nदीर्घकालं विनिःश्वस्य प्रजाहेतोर्नृपोत्तमः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2147301, "chapter_id": 4184, "verse_number": "२", "content_sanskrit": "उन्नतेषून्नता षट्सु सूक्ष्मा सूक्ष्मेषु सप्तसु ।\nगम्भीरा त्रिषु गम्भीरेष्वियं रक्ता हि पञ्चसु\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2147302, "chapter_id": 4184, "verse_number": "३", "content_sanskrit": "श्रोण्यौ ललाटकक्षौ च घ्राणं चेति षडुन्नतम् ।\nसूक्ष्माण्यङ्गुलिपर्वाणि केशरोमनखत्वचः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2147303, "chapter_id": 4184, "verse_number": "४", "content_sanskrit": "स्वरः सत्वं च नाभिश्च त्रिगम्भीरं प्रचक्षते ।\nपाणिपादतळे रक्ते नेत्रान्तास्यनखानि च\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2147304, "chapter_id": 4184, "verse_number": "५", "content_sanskrit": "बहुदेवासुरालोका बहुगन्धर्वदर्शना ।\nबहुलक्षणसम्पन्ना बहुकल्याणचारिणी\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2147305, "chapter_id": 4184, "verse_number": "६", "content_sanskrit": "समर्थेयं जनयितुं चक्रवर्तिनमात्मजम् ।\nब्रूहि शुल्कं द्विजश्रेष्ठ समीक्ष्य विभवं मम\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2147306, "chapter_id": 4184, "verse_number": "", "content_sanskrit": "गालवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2147307, "chapter_id": 4184, "verse_number": "७", "content_sanskrit": "एकतः श्यामकर्णानां शतान्यष्टौ च देहि मे ।\nहयानां चन्द्रशुभ्राणां देशजानां वपुष्मताम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2147308, "chapter_id": 4184, "verse_number": "८", "content_sanskrit": "ततस्तव भवित्रीयं पुत्राणां जननी शुभा ।\nअरणीव हुताशानां योनिरायतलोचना\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2147309, "chapter_id": 4184, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2147310, "chapter_id": 4184, "verse_number": "९", "content_sanskrit": "स तच्छ्रुत्वा वचो राजा हर्यश्वः काममोहितः ।\nउवाच गालवं दीनो राजर्षिर्ऋषिसत्तमम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2147311, "chapter_id": 4184, "verse_number": "१०", "content_sanskrit": "द्वे मे शते सन्निहिते हयानां यद्विधास्तव ।\nएष्टव्याः शतशस्त्वन्ये चरन्ति मम वाजिनः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2147312, "chapter_id": 4184, "verse_number": "११", "content_sanskrit": "सोऽहमेकमपत्यं वै जनयिष्यामि गालव ।\nअस्यामेतं भवान् कामं सम्पादयतु मे वरम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2147313, "chapter_id": 4184, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2147314, "chapter_id": 4184, "verse_number": "१२", "content_sanskrit": "एतच्छ्रुत्वा तु सा कन्या गालवं वाक्यमब्रवीत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2147315, "chapter_id": 4184, "verse_number": "१३", "content_sanskrit": "मम दत्तो वरः कश्चित् केनचिद् ब्रह्मवादिना ।\nप्रसूत्यन्ते प्रसूत्यन्ते कन्यैव त्वमिति प्रभो\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2147316, "chapter_id": 4184, "verse_number": "१४", "content_sanskrit": "स त्वं ददस्व मां राज्ञे परिगृह्य हयोत्तमान्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2147317, "chapter_id": 4184, "verse_number": "१५", "content_sanskrit": "नृपेभ्यो हि चतुर्भ्यस्ते पूर्णान्यष्टौ शतानि वै ।\nभविष्यन्ति तथा पुत्रा मम चत्वार एव च\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2147318, "chapter_id": 4184, "verse_number": "१६", "content_sanskrit": "क्रियतामुपसंहारो गुर्वर्थं द्विजसत्तम ।\nएषा तावन्मम प्रज्ञा यथा वा मन्यसे द्विज\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2147319, "chapter_id": 4184, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2147320, "chapter_id": 4184, "verse_number": "१७", "content_sanskrit": "एवमुक्तस्तु स मुनिः कन्यया गालवस्तदा ।\nहर्यश्वं पृथिवीपालमिदं वचनमब्रवीत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2147321, "chapter_id": 4184, "verse_number": "१८", "content_sanskrit": "इयं कन्या नरश्रेष्ठ हर्यश्व प्रतिगृह्यताम् ।\nचतुर्भागेन शुल्कस्य जनयस्वैकमात्मजम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2147322, "chapter_id": 4184, "verse_number": "१९", "content_sanskrit": "परिगृह्य स तां कन्यां गालवं प्रतिनन्द्य च ।\nसमये देशकाले च लब्धवान् सुतमीप्सितम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2147323, "chapter_id": 4184, "verse_number": "२०", "content_sanskrit": "जातो वसुमना नाम वसुभ्यो वसुसत्तमः ।\nवसुप्रख्यो नरपतिः स बभूव वसुप्रदः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2147324, "chapter_id": 4184, "verse_number": "२१", "content_sanskrit": "अथ काले पुनर्धीमान् गालवः प्रत्युपस्थितः ।\nउपसङ्गम्य होवाच हर्यश्वं प्रीतमानसम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2147325, "chapter_id": 4184, "verse_number": "२२", "content_sanskrit": "जातो नृप सुतस्तेऽयं बालो भास्करसन्निभः ।\nकालो गन्तुं नरश्रेष्ठ शुल्कार्थमपरं नृपम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2147326, "chapter_id": 4184, "verse_number": "२३", "content_sanskrit": "हर्यश्वः सत्यवचने ततः स्थित्वा च पौरुषे ।\nदुर्लभत्वाद्धयानां च प्रददौ माधवीं पुनः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2147327, "chapter_id": 4184, "verse_number": "२४", "content_sanskrit": "माधवी च पुनर्दीप्तां परित्यज्य नृपश्रियम् ।\nकुमारी कामतो भूत्वा गालवं पृष्ठतोऽन्वगात्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2147328, "chapter_id": 4184, "verse_number": "२५", "content_sanskrit": "त्वय्येव तावत् तिष्ठन्तु हया इत्युक्तवान् द्विजः ।\nप्रययौ कन्यया सार्धं दिवोदासं प्रजेश्वरम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2147329, "chapter_id": 4184, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि पञ्चदशोत्तरशततमोऽध्यायः ॥११५॥\nभगवद्यानपर्वणि षट्चत्वारिंशोऽध्यायः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]