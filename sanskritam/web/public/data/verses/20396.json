[{"id": 7000396000, "chapter_id": 20396, "verse_number": "२-६८-१", "content_sanskrit": "ययातिरुवाच ।\nअधर्मस्य फलं सूत श्रुतं सर्वं मया विभो ।\nधर्मस्यापि फलं ब्रूहि श्रोतुं कौतूहलं मम॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000396001, "chapter_id": 20396, "verse_number": "२-६८-२", "content_sanskrit": "मातलिरुवाच ।\nअथ पापैरिमे यांति यमलोकं चतुर्विधाः ।\nसंत्रासजननं घोरं विवशाः सर्वदेहिनः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000396002, "chapter_id": 20396, "verse_number": "२-६८-३", "content_sanskrit": "गर्भस्थैर्जायमानैश्च बालैस्तरुणमध्यमैः ।\nपुंस्त्रीनपुंसकैर्वृद्धैर्यातव्यं जंतुभिस्ततः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000396003, "chapter_id": 20396, "verse_number": "२-६८-४", "content_sanskrit": "शुभाशुभफलं तत्र देहिनां प्रविचार्यते ।\nचित्रगुप्तादिभिः सर्वैर्मध्यस्थैः सर्वदर्शिभिः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000396004, "chapter_id": 20396, "verse_number": "२-६८-५", "content_sanskrit": "न तेत्र प्राणिनः संति ये न यांति यमक्षयम् ।\nअवश्यं हि कृतं कर्म भोक्तव्यं तद्विचारितम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000396005, "chapter_id": 20396, "verse_number": "२-६८-६", "content_sanskrit": "ये तत्र शुभकर्माणः सौम्यचित्तादयान्विताः ।\nते नरा यांति सौम्येन पथा यमनिकेतनम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000396006, "chapter_id": 20396, "verse_number": "२-६८-७", "content_sanskrit": "यः प्रदद्याच्च विप्राणामुपानत्काष्ठपादुके ।\nस विमानेन महता सुखं याति यमालयम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000396007, "chapter_id": 20396, "verse_number": "२-६८-८", "content_sanskrit": "छत्रदानेन गच्छंति पथा साभ्रेण देहिनः ।\nदिव्यवस्त्रपरीधाना यांति वस्त्रप्रदायिनः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000396008, "chapter_id": 20396, "verse_number": "२-६८-९", "content_sanskrit": "शिबिकायाः प्रदानेन विमानेन सुखं व्रजेत् ।\nसुखासनप्रदानेन सुखं यांति यमालयम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000396009, "chapter_id": 20396, "verse_number": "२-६८-१०", "content_sanskrit": "आरामकर्ता छायासु शीतलासु सुखं व्रजेत् ।\nयांति पुष्पकयानेन पुष्पारामप्रदायिनः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000396010, "chapter_id": 20396, "verse_number": "२-६८-११", "content_sanskrit": "देवायतनकर्ता च यतीनामाश्रमस्य च ।\nअनाथमंडपानां च क्रीडन्याति गृहोत्तमैः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000396011, "chapter_id": 20396, "verse_number": "२-६८-१२", "content_sanskrit": "देवाग्निगुरुविप्राणां मातापित्रोश्च पूजकः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000396012, "chapter_id": 20396, "verse_number": "२-६८-१३", "content_sanskrit": "विप्रेषु दीनेषु गुणान्वितेषु यच्छ्रद्धया स्वल्पमपि प्रदत्तम् ।\nतत्सर्वकामान्समुपैति लोके श्राद्धे च दानं प्रवदंति संतः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000396013, "chapter_id": 20396, "verse_number": "२-६८-१४", "content_sanskrit": "श्रद्धादानेन विज्ञेयमपि वालाग्रमात्रकम् ।\nयत्पात्रादि चतुष्टयं श्रद्धा तेषु सदा मम॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000396014, "chapter_id": 20396, "verse_number": "२-६८-१५", "content_sanskrit": "श्रद्धीयते सदा तस्माच्छ्रद्धायास्तत्फलं भवेत् ।\nगुणान्वितेषु दीनेषु यच्छत्यावसथान्यपि॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000396015, "chapter_id": 20396, "verse_number": "२-६८-१६", "content_sanskrit": "स प्रयाति सर्वकामं स्थानं पैतामहं नृप ।\nश्रद्धयायेन विप्राय दत्तं काकिणिमात्रकम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000396016, "chapter_id": 20396, "verse_number": "२-६८-१७", "content_sanskrit": "सस्याद्दिव्यतिथिर्भूप देवानां कीर्तिवर्धनः ।\nतस्माच्छ्रद्धान्वितैर्देयं तत्फलं भवति ध्रुवम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]