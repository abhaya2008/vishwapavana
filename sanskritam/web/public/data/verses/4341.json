[{"id": 2153978, "chapter_id": 4341, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2153979, "chapter_id": 4341, "verse_number": "१", "content_sanskrit": "एवं बहुगुणं सैन्यमेवं बहुविधं परम् ।\nव्यूढमेवं यथाशास्त्रममोघं चैव सञ्जय\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2153980, "chapter_id": 4341, "verse_number": "२", "content_sanskrit": "पुष्टमस्माकमत्यन्तमभिकामं च नः सदा ।\nप्रह्वमव्यसनोपेतं पुरस्ताद् दृष्टविक्रमम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2153981, "chapter_id": 4341, "verse_number": "३", "content_sanskrit": "नातिवृद्धमबालं च न कृशं न च पीवरम् ।\nलघुवृत्तायतप्रायं सारगात्रमनामयम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2153982, "chapter_id": 4341, "verse_number": "४", "content_sanskrit": "आत्तसन्नाहशस्त्रं च बहुशस्त्रपरिग्रहम् ।\nअसियुद्धे नियुद्धे च गदायुद्धे च कोविदम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2153983, "chapter_id": 4341, "verse_number": "५", "content_sanskrit": "प्रासर्ष्टितोमरेष्वाजौ परिघेष्वायसेषु च ।\nभिण्डिपालेषु शक्तीषु मुसलेषु च सर्वशः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2153984, "chapter_id": 4341, "verse_number": "६", "content_sanskrit": "कम्पनेषु च चापेषु कणपेषु च सर्वशः ।\nक्षेपणीषु च चित्रासु मुष्टियुद्धेषु कोविदम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2153985, "chapter_id": 4341, "verse_number": "७", "content_sanskrit": "अपरोक्षं च विद्यासु व्यायामेषु कृतश्रमम् ।\nशस्त्रग्रहणविद्यासु सर्वासु परिनिष्ठितम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2153986, "chapter_id": 4341, "verse_number": "८", "content_sanskrit": "आरोहे पर्यवस्कन्दे सरणे सान्तरप्लुते ।\nसम्यक्प्रहरणे याने व्यपयाने च कोविदम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2153987, "chapter_id": 4341, "verse_number": "९", "content_sanskrit": "नागाश्वरथयानेषु बहुशः सुपरीक्षितम् ।\nपरीक्ष्य च यथान्यायं वेतनेनोपपादितम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2153988, "chapter_id": 4341, "verse_number": "१०", "content_sanskrit": "न गोष्ठ्या नोपचारेण न च बन्धुनिमित्ततः ।\nन सौहृदबलैश्चापि नाकुलीनपरिग्रहैः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2153989, "chapter_id": 4341, "verse_number": "११", "content_sanskrit": "समृद्धजनमार्यं च तुष्टसत्कृतबान्धवम् ।\nकृतोपकारभूयिष्ठं यशस्वि च मनस्वि च\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2153990, "chapter_id": 4341, "verse_number": "१२", "content_sanskrit": "सजयैश्च नरैर्मुख्यैर्बहुशो दृष्टकर्मभिः ।\nलोकपालोपमैस्तात पालितं लोकविश्रुतैः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2153991, "chapter_id": 4341, "verse_number": "१३", "content_sanskrit": "बहुभिः क्षत्रियैर्गुप्तं पृथिव्यां लोकसम्मतैः ।\nअस्मानभिगतैः कामात्सबलैः सपदानुगैः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2153992, "chapter_id": 4341, "verse_number": "१४", "content_sanskrit": "महोदधिमिवापूर्णमापगाभिः समन्ततः ।\nअपक्षैः पक्षिसङ्काशै रथैर्नागैश्च संवृतम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2153993, "chapter_id": 4341, "verse_number": "१५", "content_sanskrit": "नानायोधजलं भीमं वाहनोर्मितरङ्गिणम् ।\nक्षेपण्यसिगदाशक्तिशरप्राससमाकुलम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2153994, "chapter_id": 4341, "verse_number": "१६", "content_sanskrit": "ध्वजभूषणसम्बाधं रत्नपट्टेन सञ्चितम् ।\nवाहनैः परिसर्पद्भिर्वायुवेगविकम्पितम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2153995, "chapter_id": 4341, "verse_number": "१७", "content_sanskrit": "अपारमिव गर्जन्तं सागरप्रतिमं महत् ।\nद्रोणभीष्माभिसङ्गुप्तं गुप्तं च कृतवर्मणा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2153996, "chapter_id": 4341, "verse_number": "१८", "content_sanskrit": "कृपदुःशासनाभ्यां च जयद्रथमुखैस्तथा ।\nभगदत्तविकर्णाभ्यां द्रौणिसौबलबाह्लिकैः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2153997, "chapter_id": 4341, "verse_number": "१९", "content_sanskrit": "गुप्तं प्रवीरैर्लोकस्य सारवद्भिर्महात्मभिः ।\nयदहन्यत सैन्यं मे दिष्टमेतत्पुरातनम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2153998, "chapter_id": 4341, "verse_number": "२०", "content_sanskrit": "नैतादृशं समुद्योगं दृष्टवन्तो हि मानुषाः ।\nऋषयो वा महाभागाः पुराणा भुवि सञ्जय\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2153999, "chapter_id": 4341, "verse_number": "२१", "content_sanskrit": "ईदृशो(ऽ)पि बलौघस्तु युक्तः शस्त्रास्त्रसम्पदा ।\nवध्यते यत्र सङ्ग्रामे किमन्यद् भागधेयतः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2154000, "chapter_id": 4341, "verse_number": "२२", "content_sanskrit": "विपरीतमिदं सर्वं प्रतिभाति स्म सञ्जय ।\nयत्रेदृशं बलं घोरं नातरद् युधि पाण्डवान् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2154001, "chapter_id": 4341, "verse_number": "२३", "content_sanskrit": "अथ वा पाण्डवार्थाय देवास्तत्र समागताः ।\nयुध्यन्ते मामकं सैन्यं यथावध्यन्त सञ्जय\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2154002, "chapter_id": 4341, "verse_number": "२४", "content_sanskrit": "उक्तोऽपि विदुरेणेह हितं पथ्यं च नित्यशः ।\nन च गृह्णाति तन्मन्दः पुत्रो दुर्योधनो मम\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2154003, "chapter_id": 4341, "verse_number": "२५", "content_sanskrit": "तस्य मन्ये मतिः पूर्वं सर्वज्ञस्य महात्मनः ।\nआसीद् यथागतं तात येन दृष्टमिदं पुरा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2154004, "chapter_id": 4341, "verse_number": "२६", "content_sanskrit": "अथवा भाव्यमेवं हि सञ्जयैतेन सर्वथा ।\nपुरा धात्रा यथा सृष्टं तत्तथा न तदन्यथा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2154005, "chapter_id": 4341, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां भीष्मपर्वणि द्वासप्ततितमोऽध्यायः ॥७२॥\n॥ इति भीष्मवधपर्वणि द्वात्रिंशोऽध्यायः ॥३३॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]