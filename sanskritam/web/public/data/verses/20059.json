[{"id": 7000059000, "chapter_id": 20059, "verse_number": "५९-१", "content_sanskrit": "अथैकोनषष्टितमोऽध्यायः श्वेतमाधवमाहात्म्यवर्णनम् ब्रह्मोवाच अनन्ताख्यं वासुदेवं दृष्ट्वा भक्त्या प्रणम्य च ।\nसर्वपापविनिर्मुक्तो नरो याति परं पदम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000059001, "chapter_id": 20059, "verse_number": "५९-२", "content_sanskrit": "मया चाऽऽराधितश्चासौ शक्रेण तदन्तरम् ।\nविभिषणेन रामेण कस्तं नाऽऽराधयेत्पुमान् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000059002, "chapter_id": 20059, "verse_number": "५९-३", "content_sanskrit": "श्वेतगङ्गां नरः स्नात्वा यः पश्येच्छ्वेतमाधवम् ।\nमत्स्याख्यं माधवं चैव श्वेतद्वीपं स गच्छति ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000059003, "chapter_id": 20059, "verse_number": "५९-४", "content_sanskrit": "मुनय ऊचुः श्वेतमाधवमाहात्म्यं वक्तुमर्हस्यशेषतः ।\nविस्तरेण जगन्नाथ प्रतिमां तस्य वै हरेः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000059004, "chapter_id": 20059, "verse_number": "५९-५", "content_sanskrit": "तस्मिन्क्षेत्रवरे पुण्ये विख्याते जगतीतले ।\nश्वेताख्यं माधवं देवं कस्तं स्थापितवान्पुरा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000059005, "chapter_id": 20059, "verse_number": "५९-६", "content_sanskrit": "ब्रह्मोवाच अभूत्कृतयुगे विप्राः श्वेतो नाम नृपो बली ।\nमतिमान्धर्मविच्छूरः सत्यसंधो दृढव्रतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000059006, "chapter_id": 20059, "verse_number": "५९-७", "content_sanskrit": "यस्य राज्ये तु वर्षाणां सहस्रं दश मानवाः ।\nभवन्त्यायुष्मन्तो लोका बालस्तस्मिन्न सीदति ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000059007, "chapter_id": 20059, "verse_number": "५९-८", "content_sanskrit": "वर्तमाने तदा राज्ये किंचित्काले गते द्विजाः ।\nकपालगौतमौ नाम ऋषिः परमधार्मिकः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000059008, "chapter_id": 20059, "verse_number": "५९-९", "content_sanskrit": "सुतोऽस्याजातदन्तश्च मृतः कालवशाद् द्विजाः ।\nतमादाय ऋषिर्धोमान्नृपस्यान्तिकमानयत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000059009, "chapter_id": 20059, "verse_number": "५९-१०", "content_sanskrit": "दृष्ट्वैवं नृपतिः सुप्तं कुमारं गतचेतसम् ।\nप्रतिज्ञामकरोद्विप्रा जीवनार्थं शिशोस्तदा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000059010, "chapter_id": 20059, "verse_number": "५९-११", "content_sanskrit": "राजोवाच यावद्बालमहं त्वेनं यमस्य सदने गतम् ।\nनाऽऽनये सप्तरात्रेण चितां दीप्तां समारुहे ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000059011, "chapter_id": 20059, "verse_number": "५९-१२", "content_sanskrit": "ब्रह्मोवाच एवमुक्त्वाऽसितैः पद्मैः शतैर्दशशतादिकैः ।\nसंपूज्य च महादेवं राजा विद्यां पुनर्जपेत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000059012, "chapter_id": 20059, "verse_number": "५९-१३", "content_sanskrit": "अतिभक्तिं तु संचिन्त्य नृपस्य जगदीश्वरः ।\nसांनिध्यमागमत्तुष्टोऽस्मीत्युवाच सहोमया ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000059013, "chapter_id": 20059, "verse_number": "५९-१४", "content_sanskrit": "श्रुत्वैवं गिरमीशस्य विलोक्य सहसा हरम् ।\nभस्मदिग्धं विख्यपाक्षं शरत्कुन्देन्दुवर्चसम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000059014, "chapter_id": 20059, "verse_number": "५९-१५", "content_sanskrit": "शार्दूलचवर्मवसनं शशाङ्काङ्कितमूर्धजम् ।\nमहीं निपत्य सहसा प्रणम्य स तदाऽब्रवीत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000059015, "chapter_id": 20059, "verse_number": "५९-१६", "content_sanskrit": "श्वेत उवाच कारुण्यं यदि मे दृष्ट्वा प्रसन्नोऽसि प्रभो यदि ।\nकालस्य वशमापन्नो बालको द्विजपुत्रकः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000059016, "chapter_id": 20059, "verse_number": "५९-१७", "content_sanskrit": "जीवत्वेष पुनर्बाल इत्येवं व्रतमाहितम् ।\nअकस्माच्च मृतं बालं नियम्य भगवन्स्वयम् ।\nयथोक्तायुष्यसंयुक्तं क्षेमं कुरु महेश्वर ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000059017, "chapter_id": 20059, "verse_number": "५९-१८", "content_sanskrit": "ब्रह्मोवाच श्वेतस्यैतद्वचः श्रुत्वा मुदं प्राप हरस्तदा ।\nकालमाज्ञापयामास सर्वभूतभयंकरम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000059018, "chapter_id": 20059, "verse_number": "५९-१९", "content_sanskrit": "नियम्य कालं दुर्धर्षं यमस्याऽऽज्ञाकरं द्विजाः ।\nबालं संजीवयामास मृत्योर्मुखगतं पुनः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000059019, "chapter_id": 20059, "verse_number": "५९-२०", "content_sanskrit": "कृत्वा क्षेमं जगत्सर्वं मुनेः पुत्रं स तं द्विजाः ।\nदेव्या सहोमया देवस्तत्रैवान्तरधीयत ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000059020, "chapter_id": 20059, "verse_number": "५९-२१", "content_sanskrit": "एवं संजीवयामास मुनेः पुत्रं नृपोत्तमः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000059021, "chapter_id": 20059, "verse_number": "५९-२२", "content_sanskrit": "मुनय ऊचुः देवदेव जगन्नाथ त्रैलोक्यप्रभवाव्यय ।\nब्रूहि नः परमं तथ्यं श्वेताख्यस्य च सांप्रतम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000059022, "chapter_id": 20059, "verse_number": "५९-२३", "content_sanskrit": "ब्रह्मोवाच श्रृणुध्वं मुनिशार्दूलाः सर्वसत्त्वहितावहम् ।\nप्रवक्ष्यामि यथातथ्यं यत्पृच्छथ ममानघाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000059023, "chapter_id": 20059, "verse_number": "५९-२४", "content_sanskrit": "माधवस्य च माहात्म्यं सर्वपापप्रणाशनम् ।\nयच्छ्रुत्वाऽभिमतान्कामान्ध्रुवं प्राप्नोति मानवः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000059024, "chapter_id": 20059, "verse_number": "५९-२५", "content_sanskrit": "श्रुतवानृषिभिः पूर्वं माधवाख्यस्य भो द्विजाः ।\nश्रृणुध्वं तां कथां दिव्यां भयशोकार्तिनासिनीम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000059025, "chapter_id": 20059, "verse_number": "५९-२६", "content_sanskrit": "स कृत्वा राज्यमेकाग्य्रं वर्षाणां च सहस्रशः ।\nविचार्य लौकिकान्धर्मान्वैदिकान्नियमांस्तथा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000059026, "chapter_id": 20059, "verse_number": "५९-२७", "content_sanskrit": "केशवाराधने विप्रा निश्चितं व्रतमास्थितः ।\nस गत्वा परमं क्षेत्रं सागरं दक्षिणाश्रयम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000059027, "chapter_id": 20059, "verse_number": "५९-२८", "content_sanskrit": "तटे तस्मिञ्छुभे रम्ये देशे कृष्णस्य चान्तिके ।\nश्वेतोऽथ कारयामास प्रसादं शुभलक्षणम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000059028, "chapter_id": 20059, "verse_number": "५९-२९", "content_sanskrit": "धन्वन्तरशतं चैकं देवदेवस्य दक्षिणे ।\nततः श्वेतेन विप्रेन्द्राः श्वेतशैलमयेन च ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000059029, "chapter_id": 20059, "verse_number": "५९-३०", "content_sanskrit": "कृतः स भगवाञ्छ्वेतो माधवश्चन्द्रसंनिभः ।\nप्रतिष्ठां विधिवच्चक्रे यथोद्दिष्टां स्वयं तु सः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000059030, "chapter_id": 20059, "verse_number": "५९-३१", "content_sanskrit": "दत्त्वा दानं द्विजातिभ्यो दीनानाथतपस्विनाम् ।\nअथानन्तरतो राजा माधवस्य च संनिधौ ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000059031, "chapter_id": 20059, "verse_number": "५९-३२", "content_sanskrit": "महीं निपत्य सहसा ओंकारं द्वादशाक्षरम् ।\nजपन्स मौनमास्थाय मासमेकं समाधिना ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000059032, "chapter_id": 20059, "verse_number": "५९-३३", "content_sanskrit": "निराहारो महाभागः सम्यग्विष्णुपदे स्थितः ।\nजपान्ते स तु देवेशं संस्तोतुमुपचक्रमे ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000059033, "chapter_id": 20059, "verse_number": "५९-३४", "content_sanskrit": "श्वेत उवाच ओं नमो वासुदेवाय नमः संकर्षणाय च ।\nप्रद्युम्नायानिरुद्धाय नमो नारायणाय च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000059034, "chapter_id": 20059, "verse_number": "५९-३५", "content_sanskrit": "नमोऽस्तु बहुरूपाय विश्वरूपाय वेधसे ।\nनिर्गुणायाप्रतर्क्याय शुचये शुक्लकर्मणे ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000059035, "chapter_id": 20059, "verse_number": "५९-३६", "content_sanskrit": "ओं नमः पद्मनाभाय पद्मगर्भोद्भवाय च ।\nनमोऽस्तु पद्मवर्णाय पद्महस्ताय ते नमः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000059036, "chapter_id": 20059, "verse_number": "५९-३७", "content_sanskrit": "ओं नमः पुष्कराक्षाय सहस्राक्षाय मीढुषे ।\nनमः सहस्रपादाय सहस्रभुज मन्यवे ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000059037, "chapter_id": 20059, "verse_number": "५९-३८", "content_sanskrit": "ओं नमोऽस्तु वराहाय वरदाय सुमेधसे ।\nवरिष्ठाय वरेण्याय शरण्यायाच्युताय च ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000059038, "chapter_id": 20059, "verse_number": "५९-३९", "content_sanskrit": "ओं नमो बालरूपाय बालपद्मप्रभाय च ।\nबालार्कसोमनेत्राय मुञ्जकेशाय धीमते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000059039, "chapter_id": 20059, "verse_number": "५९-४०", "content_sanskrit": "केशवाय नमो नित्यं नमो नारायणाय च ।\nमाधवाय वरिष्ठाय गोविन्दाय नमो नमः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000059040, "chapter_id": 20059, "verse_number": "५९-४१", "content_sanskrit": "ओं नमो विष्णवे नित्यं देवाय वसुरेतसे ।\nमधुसूदनाय नमः शुद्धायांशुधराय च ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000059041, "chapter_id": 20059, "verse_number": "५९-४२", "content_sanskrit": "नमोऽनन्ताय सूक्ष्माय नमः श्रीवत्सधारिणे ।\nत्रिविक्रमाय च नमो दिव्यपीताम्बराय च ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000059042, "chapter_id": 20059, "verse_number": "५९-४३", "content_sanskrit": "सृष्टिकर्त्रे नमस्तुभ्यं गोप्त्रे धात्रे नमो नमः ।\nनमोऽस्तु गुणभूताय निर्गुणाय नमो नमः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000059043, "chapter_id": 20059, "verse_number": "५९-४४", "content_sanskrit": "नमो वामनरूपाय नमो वामनकर्मणे ।\nनमो वामननेत्राय नमो वामनवाहिने ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000059044, "chapter_id": 20059, "verse_number": "५९-४५", "content_sanskrit": "नमो रम्याय पूज्याय नमोऽस्त्वव्यक्तरूपिणे ।\nअप्रतर्क्याय शुद्धाय नमो भयहराय च ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000059045, "chapter_id": 20059, "verse_number": "५९-४६", "content_sanskrit": "संसारार्णवपोताय प्रशान्ताय स्वरूपिणे ।\nशिवाय सौम्यरूपाय रुद्रायोत्तारणाय च ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000059046, "chapter_id": 20059, "verse_number": "५९-४७", "content_sanskrit": "भवभङ्गकृते चैव भवभोगप्रदाय च ।\nभवसंघातरूपाय भवसृष्टिकृते नमः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000059047, "chapter_id": 20059, "verse_number": "५९-४८", "content_sanskrit": "ओं नमो दिव्यरूपाय सोमाग्निश्वसिताय च ।\nसोमसूर्यांशुकेशाय गोब्राह्मणहिताय च ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000059048, "chapter_id": 20059, "verse_number": "५९-४९", "content_sanskrit": "ओं नम ऋक्स्वरूपाय पदक्रमस्वरूपिणे ।\nऋक्स्तुताय नमस्तुभ्यं नम ऋक्साधनाय च ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000059049, "chapter_id": 20059, "verse_number": "५९-५०", "content_sanskrit": "ओं नमो यजुषां धात्रे यजूरूपधराय च ।\nयजुर्याज्याय जुष्टाय यजुषां पतये नमः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000059050, "chapter_id": 20059, "verse_number": "५९-५१", "content_sanskrit": "ओं नमः श्रीपते देव श्रीधराय वराय च ।\nश्रियः कान्ताय दान्ताय योगिचिन्त्याय योगिने ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000059051, "chapter_id": 20059, "verse_number": "५९-५२", "content_sanskrit": "ओं नमः सामरूपाय सामध्वनिवराय च ।\nओं नमः सामसौम्याय मामयोगविदे नमः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000059052, "chapter_id": 20059, "verse_number": "५९-५३", "content_sanskrit": "साम्ने च सामगीताय ओं नमः सामधारिणे ।\nसामयज्ञविदे चैव नमः सामाकराय च ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000059053, "chapter_id": 20059, "verse_number": "५९-५४", "content_sanskrit": "नमस्त्वथर्वशिरसे नमोऽथर्वस्वरूपिणे ।\nनमोऽस्त्वथर्वपादाय नमोऽथर्वकराय च ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000059054, "chapter_id": 20059, "verse_number": "५९-५५", "content_sanskrit": "ओं नमो वज्रशीर्षाय मधुकैटभघातिने ।\nमहोदधिजलस्थाय वेदाहरणकारिणे ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000059055, "chapter_id": 20059, "verse_number": "५९-५६", "content_sanskrit": "नमो दीप्तस्वरूपाय हृषीकेशाय वै नमः ।\nनमो भगवते तुभ्यं वासुदेवाय ते नमः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000059056, "chapter_id": 20059, "verse_number": "५९-५७", "content_sanskrit": "नारायण नमस्तुभ्यं नमो लोकहिताय च ।\nओं नमो मोहनाशाय भवभङ्गकराय च ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000059057, "chapter_id": 20059, "verse_number": "५९-५८", "content_sanskrit": "गतिप्रदाय च नमो नमो बन्धहराय च ।\nत्रैलोक्यतेजसां कर्त्रे नमस्तेजःस्वरूपिणे ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000059058, "chapter_id": 20059, "verse_number": "५९-५९", "content_sanskrit": "योगीश्वराय शुद्धाय रामायोत्तरणाय च ।\nसुखाय सुखनेत्राय नमः सुकृतधारिणे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000059059, "chapter_id": 20059, "verse_number": "५९-६०", "content_sanskrit": "वासुदेवाय वन्द्याय वामदेवाय वै नमः ।\nदेहिनां देहकर्त्रे च भेदभङ्गकराय च ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000059060, "chapter_id": 20059, "verse_number": "५९-६१", "content_sanskrit": "देवैर्वान्दितदेहाय नमस्ते दिव्यमौलिने ।\nनमो वासनिवासाय वासव्यवहराय च ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000059061, "chapter_id": 20059, "verse_number": "५९-६२", "content_sanskrit": "ओं नमो वसुकर्त्रे च वसुवासप्रदाय च ।\nनमो यज्ञस्वरूपाय यज्ञेशाय च योगिने ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000059062, "chapter_id": 20059, "verse_number": "५९-६३", "content_sanskrit": "यतियोगकरेशाय नमो यज्ञाङ्गधारिणे ।\nसंकर्षणाय च नमः प्रलम्बमथनाय च ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000059063, "chapter_id": 20059, "verse_number": "५९-६४", "content_sanskrit": "मेघघोषस्वनोत्तीर्णवेगलाङ्गलधारिणे ।\nनमोऽस्तु ज्ञानिनां ज्ञान नारायणपरायण ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000059064, "chapter_id": 20059, "verse_number": "५९-६५", "content_sanskrit": "न मेऽस्ति त्वामृते बन्धुर्नरकोत्तारणे प्रभो ।\nअतस्त्वां सर्वभावेन प्रणतो नतवत्सल ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000059065, "chapter_id": 20059, "verse_number": "५९-६६", "content_sanskrit": "मलं यत्कायजं वाऽपि मानसं चैव केशव ।\nन तस्यान्योऽस्ति देवेश क्षालकस्त्वामृतेऽच्युत ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000059066, "chapter_id": 20059, "verse_number": "५९-६७", "content_sanskrit": "संसर्गाणि समस्तानि विहाय त्वामुपस्थितः ।\nसंगो मेऽस्तु त्वया सार्धमात्मलाभाय केशव ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000059067, "chapter_id": 20059, "verse_number": "५९-६८", "content_sanskrit": "कष्टमापत्सुदुष्पारं संसारं वेद्मि केशव ।\nतापत्रयपरिक्लिष्टस्तेन त्वां शरणं गतः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000059068, "chapter_id": 20059, "verse_number": "५९-६९", "content_sanskrit": "एषणभिर्जगत्सर्वं मोहितं मायया तव ।\nआकर्षितं च लोभाद्यैरतस्त्वामहमाश्रितः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000059069, "chapter_id": 20059, "verse_number": "५९-७०", "content_sanskrit": "नास्ति किंचित्सुखं विष्णो संसारस्थस्य देहिनः ।\nयथा यथा हि यज्ञेश त्वयि चेतः प्रवर्तते ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000059070, "chapter_id": 20059, "verse_number": "५९-७१", "content_sanskrit": "तथा फलविहीनं तु सुखमात्यन्तिकं लभेत् ।\nनष्टो विवेकशून्योऽस्मि दृश्यते जगदातुरम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000059071, "chapter_id": 20059, "verse_number": "५९-७२", "content_sanskrit": "गोविन्द त्राहि संसारान्मामुद्धर्तुं त्वमर्हसि ।\nमग्नस्य मोहसलिले निरुत्तरे भवार्णवे ।\nउद्धर्ता पुण्डरीकाक्ष त्वामृतेऽन्यो न विद्यते ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000059072, "chapter_id": 20059, "verse_number": "५९-७३", "content_sanskrit": "ब्रह्मोवाच इत्थं स्तुतस्ततस्तेन राज्ञा श्वेतेन भो द्विजाः ।\nतस्मिन्क्षेत्रवरे दिव्ये विख्याते पुरुषोत्तमे ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000059073, "chapter_id": 20059, "verse_number": "५९-७४", "content_sanskrit": "भक्तिं तस्य तु संचिन्त्य देवदेवो जगद्गुरुः ।\nआजगाम नृपस्याग्रे सर्वैर्देवैर्वृतो हरिः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000059074, "chapter_id": 20059, "verse_number": "५९-७५", "content_sanskrit": "नीलजीमूतसंकाशः पद्मपत्रायतेक्षणः ।\nदधत्सुदर्शनं धीमान्कराग्रे दीप्तमण्डलम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000059075, "chapter_id": 20059, "verse_number": "५९-७६", "content_sanskrit": "क्षीरोदजलसंकाशो विमलश्चन्द्रसंनिभः ।\nरराज वामहस्तेऽस्य पाञ्चजन्यो महाद्युतिः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000059076, "chapter_id": 20059, "verse_number": "५९-७७", "content_sanskrit": "पक्षिराजध्वजः श्रीमान्गदाशार्ङ्गासिधृक्प्रभुः ।\nउवाच साधु भो राजन्यस्य ते मतिरुत्तमा यादिष्टं वर भद्रं ते प्रसन्नोऽस्मि तवानघ ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000059077, "chapter_id": 20059, "verse_number": "५९-७८", "content_sanskrit": "ब्रह्मोवाच श्रुत्वैवं देवदेवस्य वाक्यं तत्परमामृतम् ।\nप्रणम्य शिरसोवाच श्वेतस्तद्गतमानसः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000059078, "chapter_id": 20059, "verse_number": "५९-७९", "content_sanskrit": "यद्यहं भगवन्भक्तः प्रयच्छ वरमुत्तमम् ।\nआब्रह्मभवनादूर्ध्वं वैष्णवं पदमव्ययम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000059079, "chapter_id": 20059, "verse_number": "५९-८०", "content_sanskrit": "विमलं विरजं शुद्धं संसारासङ्गवर्जितम् ।\nतत्पदं गन्तुमिच्छामि त्वत्प्रसादाज्जगत्पते ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000059080, "chapter_id": 20059, "verse_number": "५९-८१", "content_sanskrit": "श्रीभगवानुवाच यत्पदं विबुधाः सर्वे मुनयः सिद्धयोगिनः ।\nनाभिगच्छन्ति यद्रम्यं परं पदमनामयम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000059081, "chapter_id": 20059, "verse_number": "५९-८२", "content_sanskrit": "यास्यसि परमं स्थानं राज्यामृतमुपास्य च ।\nसर्वांल्लोकानतिक्रम्य मम लोकं गमिष्यसि ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000059082, "chapter_id": 20059, "verse_number": "५९-८३", "content_sanskrit": "कीर्तिस्तवात्र राजेन्द्र त्रींल्लोकांश्च गमिष्यति ।\nसांनिध्यं मम चैवात्र सर्वदैव भविष्यति ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000059083, "chapter_id": 20059, "verse_number": "५९-८४", "content_sanskrit": "श्वेतगङ्गेति गास्यन्ति सर्वे ते देवदानवाः ।\nकुशाग्रेणापि राजेन्द्रश्वेतगाङ्गेयमम्बु च ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000059084, "chapter_id": 20059, "verse_number": "५९-८५", "content_sanskrit": "स्पृष्ट्वा स्वर्गं गमिष्यन्ति मद्भक्ता ये समाहिताः ।\nयस्त्विमां प्रतिमांगच्छेन्माधवाख्यां शशिप्रभाम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000059085, "chapter_id": 20059, "verse_number": "५९-८६", "content_sanskrit": "शङ्खगोक्षीरसंकाशामशेषाघविनाशिनीम् ।\nतां प्रणम्य सकृद्भक्त्या पुण्डरीकनिकनिभेक्षणाम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000059086, "chapter_id": 20059, "verse_number": "५९-८७", "content_sanskrit": "विहाय सर्वलोकान्वै मम लोके महीयते ।\nमन्वन्तराणि तत्रैव देवकन्याभिरावृतः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000059087, "chapter_id": 20059, "verse_number": "५९-८८", "content_sanskrit": "गीयमानश्च मधुरं सिद्धगन्धर्वसेवितः ।\nभुनक्ति विपुलान्भोगान्यथेष्टं मामकैः सह ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000059088, "chapter_id": 20059, "verse_number": "५९-८९", "content_sanskrit": "च्युतस्तस्मादिहाऽऽगत्य मनुष्यो ब्राह्मणो भवेत् ।\nवेदवेदाङ्गविच्छ्रीमान्भोगवांश्चिरजीवितः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000059089, "chapter_id": 20059, "verse_number": "५९-९०", "content_sanskrit": "गजाश्वरथयानाढ्यो धनधान्यावृतः शुचिः ।\nरूपवान्बहुभग्यश्च पुत्रपौत्रसमन्वितः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000059090, "chapter_id": 20059, "verse_number": "५९-९१", "content_sanskrit": "पुरुषोत्तमं पुनः प्राप्य वटमूलेऽथ सागरे ।\nत्यक्त्वा देहं हरिं स्मृत्वा ततः शान्तपदं व्रजेत् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}]