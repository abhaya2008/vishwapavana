[{"id": 7006256000, "chapter_id": 26256, "verse_number": "३-१०-१", "content_sanskrit": "हयग्रीव उवाच अथ देवा महेन्द्राद्या विष्णुना प्रभविष्मुना ।\nअङ्गीकृता महाधीराः प्रमोदं परमं ययुः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006256001, "chapter_id": 26256, "verse_number": "३-१०-२", "content_sanskrit": "मलकाद्यास्तु ते सर्वे दैत्या विष्णुपराङ्मुखाः ।\nसंत्यक्ताश्च श्रिया देव्या भृशमुद्वेगमागताः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006256002, "chapter_id": 26256, "verse_number": "३-१०-३", "content_sanskrit": "ततो जगृहिरे दैत्या धन्वन्तरिकरस्थितम् ।\nपरमामृतसाराढ्यं कलशं कनकोद्भवम् ।\nअथासुराणां देवानामन्योन्यं कलहोऽभवत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006256003, "chapter_id": 26256, "verse_number": "३-१०-४", "content_sanskrit": "एतस्मिन्नन्तरे विष्णुः सर्वलोकैकरक्षकः ।\nसम्यगाराधयामासललितां स्वैक्यरूपिणीम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006256004, "chapter_id": 26256, "verse_number": "३-१०-५", "content_sanskrit": "सुराणामसुराणां च रणं वीक्ष्य सुदारुणम् ।\nब्रह्मा निजपदं प्राप शंभुः कैलासमास्थितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006256005, "chapter_id": 26256, "verse_number": "३-१०-६", "content_sanskrit": "मलकं योधयामास दैत्यानामधिपं वृषा ।\nअसुरैश्च सुराः सर्वे सांपरायमकुर्वत ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006256006, "chapter_id": 26256, "verse_number": "३-१०-७", "content_sanskrit": "भगवानपि योगीन्द्रः समाराध्य महेश्वरीम् ।\nतदेकध्यानयोगेन तद्रूपः समजायत ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006256007, "chapter_id": 26256, "verse_number": "३-१०-८", "content_sanskrit": "सर्वसंमोहिनी सा तु साक्षाच्छृङ्गारनायिका ।\nसर्वशृङ्गारवेषाढ्या सर्वाभरणभूषिता ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006256008, "chapter_id": 26256, "verse_number": "३-१०-९", "content_sanskrit": "सुराणामसुराणां च निवार्य रणमुल्वणम् ।\nमन्दस्मितेन दैतेयान्मोहयन्ती जगद ह ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006256009, "chapter_id": 26256, "verse_number": "३-१०-१०", "content_sanskrit": "अलं युद्धेन किं शस्त्रेर्मर्मस्थानविभेदिभिः ।\nनिष्ठुरैः किं वृथालापैः कण्ठशोषणहेतुभिः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006256010, "chapter_id": 26256, "verse_number": "३-१०-११", "content_sanskrit": "अहमेवात्र मध्यस्था युष्माकं च दिवौकसाम् ।\nयूयं तथामी नितरामत्र हि क्लेशभागिनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006256011, "chapter_id": 26256, "verse_number": "३-१०-१२", "content_sanskrit": "सर्वेषां सममेवाद्य दास्याम्यमृतमद्भुतम् ।\nमम हस्ते प्रदातव्यं सुधापात्रमनुत्तमम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006256012, "chapter_id": 26256, "verse_number": "३-१०-१३", "content_sanskrit": "इति तस्या वचः श्रुत्वा दैत्यास्तद्वाक्यमोहिताः ।\nपीयूषकलशं तस्यै ददुस्ते मुग्धचेतसः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006256013, "chapter_id": 26256, "verse_number": "३-१०-१४", "content_sanskrit": "सा तत्पात्रं समादाय जगन्मोहनरूपिणी ।\nसुराणामसुराणां च वृथक्पङ्क्तिं चकार ह ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006256014, "chapter_id": 26256, "verse_number": "३-१०-१५", "content_sanskrit": "द्वयोः पङ्क्त्योश्च मध्यस्थास्तानुवाच सुरासुरान् ।\nतूष्णीं भवन्तु सर्वेऽपि क्रमशो दीयते मया ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006256015, "chapter_id": 26256, "verse_number": "३-१०-१६", "content_sanskrit": "तद्वाक्यमुररीचक्रुस्ते सर्वे समवायिनः ।\nसा तु संमोहिताश्लेषलोका दातुं प्रचक्रमे ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006256016, "chapter_id": 26256, "verse_number": "३-१०-१७", "content_sanskrit": "क्वणत्कनकदर्वीका क्वणन्मङ्गलकङ्कणा ।\nकमनीयविभूषाढ्या कला सा परमा बभौ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006256017, "chapter_id": 26256, "verse_number": "३-१०-१८", "content_sanskrit": "वामे वामे करांभोजे सुधाकलशमुज्ज्वलम् ।\nसुधां तां देवतापङ्क्तौ पूर्वं दर्व्या तदादिशत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006256018, "chapter_id": 26256, "verse_number": "३-१०-१९", "content_sanskrit": "दिशन्ती क्रमशास्तत्र चन्द्रभास्करसूचितम् ।\nदर्वीकरेण चिच्छेद सैंहिकेयं तु मध्यगम् ।\nपीतामृतशिरोमात्रं तस्य व्योम जगाम च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006256019, "chapter_id": 26256, "verse_number": "३-१०-२०", "content_sanskrit": "तं दृष्ट्वाप्यसुरास्तत्र तूष्णीमासन्विमोहिताः ।\nएवं क्रमेण तत्सर्वं विबुधेभ्यो वितीर्य सा ।\nअसुराणां पुरः पात्रं सानिनाय तिरोदधे ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006256020, "chapter_id": 26256, "verse_number": "३-१०-२१", "content_sanskrit": "रिक्तपात्रं तु तं दृष्ट्वा सर्वे दैतेयदानवाः ।\nउद्वेलं केवलं क्रोधं प्राप्ता युद्धचिकीर्षया ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006256021, "chapter_id": 26256, "verse_number": "३-१०-२२", "content_sanskrit": "इन्द्रादयः सुराः सर्वे सुधापानाद्बलोत्तराः ।\nदुर्वलैरसुरैः सार्धं समयुद्ध्यन्त सायुधाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006256022, "chapter_id": 26256, "verse_number": "३-१०-२३", "content_sanskrit": "ते विध्यमानाः शतशो दानवेन्द्राः सुरोत्तमैः ।\nदिगन्तान्कतिचिज्जग्मुः पातालं कतिचिद्ययुः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006256023, "chapter_id": 26256, "verse_number": "३-१०-२४", "content_sanskrit": "दैत्यं मलकनामानं विजित्य विबुधेश्वरः ।\nआत्मीयां श्रियमाजह्रे श्रीकटाक्ष समीक्षितः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006256024, "chapter_id": 26256, "verse_number": "३-१०-२५", "content_sanskrit": "पुनः सिंहासनं प्राप्य महेन्द्रः सुरसेवितः ।\nत्रैलोक्यं पालयामास पूर्ववत्पूर्वदेवजित् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006256025, "chapter_id": 26256, "verse_number": "३-१०-२६", "content_sanskrit": "निर्भया निखिला देवास्त्रैलोक्ये सचराचरे ।\nयथाकामं चरन्ति स्म सर्वदा हृष्टचेतसः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006256026, "chapter_id": 26256, "verse_number": "३-१०-२७", "content_sanskrit": "तदा तदखिलं दृष्ट्वा मोहिनीचरितं मुनिः ।\nविस्मितः कामचारी तु कैलासं नारदो गतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006256027, "chapter_id": 26256, "verse_number": "३-१०-२८", "content_sanskrit": "नन्दिना च कृतानुज्ञः प्रणम्य परमेश्वरम् ।\nतेन संभाव्यमानोऽसौ तुष्टो विष्टरमास्त सः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006256028, "chapter_id": 26256, "verse_number": "३-१०-२९", "content_sanskrit": "आसनस्थं महादेवो मुनिं स्वेच्छाविहारिणम् ।\nपप्रच्छ पार्वतीजानिः स्वच्छस्फटिकसन्निभः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006256029, "chapter_id": 26256, "verse_number": "३-१०-३०", "content_sanskrit": "भगवन्सर्ववृत्तज्ञ पवित्रीकृतविष्टर ।\nकलहप्रिय देवर्षे किं वृत्तं तत्र नाकिनाम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006256030, "chapter_id": 26256, "verse_number": "३-१०-३१", "content_sanskrit": "सुराणामसुराणां वा विजयः समजायत ।\nकिं वाप्यमृतवृत्तान्तं विष्णुना वापि किं कृतम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006256031, "chapter_id": 26256, "verse_number": "३-१०-३२", "content_sanskrit": "इति पृष्टो महेशेन नारदो मुनिसत्तमः ।\nउवाच विस्मयाविष्टः प्रसन्नवदनेक्षणः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006256032, "chapter_id": 26256, "verse_number": "३-१०-३३", "content_sanskrit": "सर्वं जानासि भगवन्सर्वज्ञोऽसि यतस्ततः ।\nतथापि परिपृष्टेन मया तद्वक्ष्यतेऽधुना ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006256033, "chapter_id": 26256, "verse_number": "३-१०-३४", "content_sanskrit": "तादृशे समरे घोरे सति दैत्यदिवौकसाम् ।\nआदिनारायमः श्रीमान्मोहिनीरूपमादधे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006256034, "chapter_id": 26256, "verse_number": "३-१०-३५", "content_sanskrit": "तामुदारविभूषाढ्यां मूर्तां शृङ्गारदेवताम् ।\nसुरासुराः समालोक्य विरताः समरोध्यमात् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006256035, "chapter_id": 26256, "verse_number": "३-१०-३६", "content_sanskrit": "तन्मायामोहिता दैत्याः सुधापात्रं च याचिताः ।\nकृत्वा तामेव मध्यस्थामर्पयामासुरञ्जसा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006256036, "chapter_id": 26256, "verse_number": "३-१०-३७", "content_sanskrit": "तदा देवी तदादाय मन्दस्मितमनोहरा ।\nदेवेभ्य एव पीयूषमशेषं विततार सा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006256037, "chapter_id": 26256, "verse_number": "३-१०-३८", "content_sanskrit": "तिरोहितामदृष्ट्वा तां दृष्ट्वा शून्यं च पात्रकम् ।\nज्वलन्मन्युमुखा दैत्या युद्धाय पुनरुत्थिताः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006256038, "chapter_id": 26256, "verse_number": "३-१०-३९", "content_sanskrit": "अमरैरमृतास्वादादत्युल्वणपराक्रमैः ।\nपराजिता महादैत्या नष्टाः पातालमभ्ययुः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006256039, "chapter_id": 26256, "verse_number": "३-१०-४०", "content_sanskrit": "इमं वृत्तान्तमाकर्ण्य भवानीपतिख्ययः ।\nनारदं प्रेषयित्वाशु तदुक्तं सततं स्मरन् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006256040, "chapter_id": 26256, "verse_number": "३-१०-४१", "content_sanskrit": "अज्ञातः प्रमथैः सर्वैः स्कन्दनन्दिविनायकैः ।\nपार्वतीसहितो विष्णुमाजगाम सविस्मयः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006256041, "chapter_id": 26256, "verse_number": "३-१०-४२", "content_sanskrit": "क्षीरोदतीरगं दृष्ट्वा सस्त्रीकं वृषवाहनम् ।\nभोगिभोगासनाद्विष्णुः समुत्थाय समागतः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006256042, "chapter_id": 26256, "verse_number": "३-१०-४३", "content_sanskrit": "वाहनादवरुह्येशः पार्वत्या सहितः स्थितम् ।\nतं दृष्ट्वा शीघ्रमागत्य संपूज्यार्घ्यादितो मुदा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006256043, "chapter_id": 26256, "verse_number": "३-१०-४४", "content_sanskrit": "सस्नेहं गाढमालिङ्ग्य भवानीपतिमच्युतः ।\nतदागमनकार्यं च पृष्टवान्विष्टरश्रवाः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006256044, "chapter_id": 26256, "verse_number": "३-१०-४५", "content_sanskrit": "तमुवाच महादेवो भगवन्पुरुषोत्तम ।\nमहायोगेश्वर श्रीमन्सर्वसौभाग्यसुन्दरम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006256045, "chapter_id": 26256, "verse_number": "३-१०-४६", "content_sanskrit": "सर्वसंमोहजनकमवाङ्मनसगोचरम् ।\nयद्रूपं भवतोपात्तं तन्मह्यं संप्रदर्शय ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006256046, "chapter_id": 26256, "verse_number": "३-१०-४७", "content_sanskrit": "द्रष्टुमिच्छामि ते रूपं शृङ्गारस्याधिदैवतम् ।\nअवश्यं दर्शनीयं मे त्वं हि प्रार्थितकामधृक् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006256047, "chapter_id": 26256, "verse_number": "३-१०-४८", "content_sanskrit": "इति संप्रार्थितः शश्वन्महादेवेन तेन सः ।\nयद्ध्यानवैभवाल्लब्धं रूपमद्वैतमद्भुतम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006256048, "chapter_id": 26256, "verse_number": "३-१०-४९", "content_sanskrit": "तदेवानन्यमनसा ध्यात्वा किञ्चिद्विहस्य सः ।\nतथास्त्विति तिरोऽधत्त महायोगेश्वरो हरिः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006256049, "chapter_id": 26256, "verse_number": "३-१०-५०", "content_sanskrit": "शर्वोऽपि सर्वतश्चक्षुर्मुहुर्व्यापारयन्क्वचित् ।\nअदृष्टपूर्वमाराममभिरामं व्यलोकयत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006256050, "chapter_id": 26256, "verse_number": "३-१०-५१", "content_sanskrit": "विकसत्कुसुमश्रेणीविनोदिमधुपालिकम् ।\nचंपकस्तबकामोदसुरभीकृतदिक्तटम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006256051, "chapter_id": 26256, "verse_number": "३-१०-५२", "content_sanskrit": "माकन्दवृन्दमाध्वीकमाद्यदुल्लोलकोकिलम् ।\nअशोकमण्डलीकाण्डसताण्डवशिखण्डिकम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006256052, "chapter_id": 26256, "verse_number": "३-१०-५३", "content_sanskrit": "भृङ्गालिनवझङ्कारजितवल्लकिनिस्वनम् ।\nपाटलोदारसौरभ्यपाटलीकुसुमोज्ज्वलम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006256053, "chapter_id": 26256, "verse_number": "३-१०-५४", "content_sanskrit": "तमालतालहिन्तालकृतमालाविलासितम् ।\nपर्यन्तदीर्घिकादीर्घपङ्कजश्रीपरिष्कृतम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006256054, "chapter_id": 26256, "verse_number": "३-१०-५५", "content_sanskrit": "वातपातचलच्चारुपल्लवोत्फुल्लपुष्पकम् ।\nसन्तानप्रसवामोदसन्तानाधिकवासितम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006256055, "chapter_id": 26256, "verse_number": "३-१०-५६", "content_sanskrit": "तत्र सर्वत्र पुष्पाढ्ये सर्वलोकमनोहरे ।\nपारिजाततरोर्मूले कान्ता काचिददृश्यत ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006256056, "chapter_id": 26256, "verse_number": "३-१०-५७", "content_sanskrit": "बालार्कपाटलाकारा नवयौवनदर्पिता ।\nआकृष्टपद्मरागाभा चरणाब्जनखच्छदा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006256057, "chapter_id": 26256, "verse_number": "३-१०-५८", "content_sanskrit": "यावकश्रीविनिक्षेपपादलौहित्यवाहिनी ।\nकलनिःस्वनमञ्जीरपदपद्ममनोहरा ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006256058, "chapter_id": 26256, "verse_number": "३-१०-५९", "content_sanskrit": "अनङ्गवीरतूणीरदर्पोन्मदनजङ्घिका ।\nकरिशुण्डाकदलिकाकान्तितुल्योरुशोभिनी ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006256059, "chapter_id": 26256, "verse_number": "३-१०-६०", "content_sanskrit": "अरुणेन दुकूलेन सुस्पर्शेन तनीयसा ।\nअलङ्कृतनितंबाढ्या जघनाभोगभासुरा ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006256060, "chapter_id": 26256, "verse_number": "३-१०-६१", "content_sanskrit": "नवमाणिक्यसन्नद्धहेमकाञ्जीविराजिता ।\nनतनाभिमहावर्त्तत्रिवल्यूर्मिप्रभाझरा ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006256061, "chapter_id": 26256, "verse_number": "३-१०-६२", "content_sanskrit": "स्तनकुड्मलहिन्दोलमुक्तादामशतावृता ।\nअतिपीवरवक्षोजभारभङ्गुरमध्यभूः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006256062, "chapter_id": 26256, "verse_number": "३-१०-६३", "content_sanskrit": "शिरीषकोमलभुजा कङ्कणाङ्गदशालिनी ।\nसोर्मिकां गुलिमन्मृष्टशङ्खसुन्दरकन्धरा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006256063, "chapter_id": 26256, "verse_number": "३-१०-६४", "content_sanskrit": "मुखदर्पणवृत्ताभचुबुकापाटलाघरा ।\nशुचिभिः पङ्क्तिभिः शुद्धैर्विद्यारूपैर्विभास्वरैः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006256064, "chapter_id": 26256, "verse_number": "३-१०-६५", "content_sanskrit": "कुन्दकुड्मलसच्छायैर्दन्तैर्दर्शितचन्द्रिका ।\nस्थूलमौक्तिकसन्नद्धनासाभरणभासुरा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006256065, "chapter_id": 26256, "verse_number": "३-१०-६६", "content_sanskrit": "केतकान्तर्द्दलद्रोणिदीर्घदीर्घविलोचना ।\nअर्धेन्दुतुलिताफाले सम्यक्कॢप्तालकच्छटा ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006256066, "chapter_id": 26256, "verse_number": "३-१०-६७", "content_sanskrit": "पालीवतंसमाणिक्यकुण्डलामण्डितश्रुतिः ।\nनवकर्पूरकस्तूरीरसामोदितवीटिका ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006256067, "chapter_id": 26256, "verse_number": "३-१०-६८", "content_sanskrit": "शरच्चरुनिशानाथमण्डलीमधुरानना ।\nस्फुरत्कस्तूरितिलका नीलकुन्तलसंहतिः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006256068, "chapter_id": 26256, "verse_number": "३-१०-६९", "content_sanskrit": "सीमन्तरेखाविन्यस्तसिंदूरश्रेणिभासुरा ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006256069, "chapter_id": 26256, "verse_number": "३-१०-७०", "content_sanskrit": "स्फरच्चन्द्रकलोत्तंसमदलोलविलोचना ।\nसर्वशृङ्गारवेषाढ्या सर्वाभरणमण्डिता ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006256070, "chapter_id": 26256, "verse_number": "३-१०-७१", "content_sanskrit": "तामिमां कन्दुकक्रीडालोलामालोलभूषणाम् ।\nदृष्ट्वा क्षिप्रमुमां त्यक्त्वा सोऽन्वधावदथेश्वरः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006256071, "chapter_id": 26256, "verse_number": "३-१०-७२", "content_sanskrit": "उमापि तं समोवेक्ष्य धावन्तं चात्मनः प्रियम् ।\nस्वात्मानं स्वात्मर्सोन्दर्यं निन्दन्ती चातिविस्मिता ।\nतस्थाववाङ्मुखी तूष्णीं लज्जासूयासमन्विता ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006256072, "chapter_id": 26256, "verse_number": "३-१०-७३", "content_sanskrit": "गृहीत्वा कथमप्येनामालिलिग मुहुर्मुहुः ।\nउद्धूयोद्धूय साप्येवं धावति स्म सुदूरतः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006256073, "chapter_id": 26256, "verse_number": "३-१०-७४", "content_sanskrit": "पुनर्गृहीत्वा तामीशः कामं कामवशीसृतः ।\nआश्र्लिष्टं चातिवेगेन तद्वीर्यं प्रच्युतं तदा ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006256074, "chapter_id": 26256, "verse_number": "३-१०-७५", "content_sanskrit": "ततः समुत्थितो देवो महाशास्ता महाबलः ।\nअनेककोटिदैत्येन्द्रगर्वनिर्वापणक्षमः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006256075, "chapter_id": 26256, "verse_number": "३-१०-७६", "content_sanskrit": "तद्वीर्यबिन्दुसंस्पर्शात्सा भूमिस्तत्रतत्र च ।\nरजतस्वर्मवर्णाभूल्लक्षणाद्विन्ध्यमर्दन ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006256076, "chapter_id": 26256, "verse_number": "३-१०-७७", "content_sanskrit": "तथैवान्तर्दधे सापि देवता विश्वमोहिनी ।\nनिवृत्तः स गिरीशोऽपि गिरिं गौरीसखो ययौ ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006256077, "chapter_id": 26256, "verse_number": "३-१०-७८", "content_sanskrit": "अथाद्भुतमिदं वक्ष्ये लोपामुद्रापते शृणु ।\nयन्न कस्यचिदाख्यातं ममैव त्दृदयेस्थितम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006256078, "chapter_id": 26256, "verse_number": "३-१०-७९", "content_sanskrit": "पुरा भण्डासुरो नाम सर्वदैत्यशिखामणिः ।\nपूर्वं देवान्बहुविधान्यः शास्ता स्वेच्छया पटुः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006256079, "chapter_id": 26256, "verse_number": "३-१०-८०", "content_sanskrit": "विशुक्रं नाम दैतेयं वर्गसंरक्षणक्षमम् ।\nशुक्रतुल्यं विचारज्ञं दक्षांसेन ससर्ज सः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006256080, "chapter_id": 26256, "verse_number": "३-१०-८१", "content_sanskrit": "वामांसेन विषाङ्गं च सृष्टवान्दुष्टशेखरम् ।\nधूमिनीनामधेयां च भगिनीं भण्डदानवः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006256081, "chapter_id": 26256, "verse_number": "३-१०-८२", "content_sanskrit": "भ्रातृभ्यामुग्रवीर्याभ्यां सहितो निहताहितः ।\nब्रह्माण्डं खण्डयामास शौर्यवीर्यसमुच्छ्रितः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006256082, "chapter_id": 26256, "verse_number": "३-१०-८३", "content_sanskrit": "ब्रह्मविष्णुमहेशाश्च तं दृष्ट्वा दीप्ततेजसम् ।\nपलायनपराः सद्यः स्वे स्वे धाम्नि सदावसन् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006256083, "chapter_id": 26256, "verse_number": "३-१०-८४", "content_sanskrit": "तदानीमेव तद्बाहुमंमर्द्दन विमूर्च्छिताः ।\nश्वसितुं चापि पटवो नाभवन्नाकिनां गणाः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006256084, "chapter_id": 26256, "verse_number": "३-१०-८५", "content_sanskrit": "केचित्पातालगर्भेषु केचिदंबुधिवारिषु ।\nकेचिद्दिगन्तकोणेषु केचित्कुञ्जेषु भूभृताम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006256085, "chapter_id": 26256, "verse_number": "३-१०-८६", "content_sanskrit": "विलीना भृशवित्रस्तास्त्यक्तदारसुतस्त्रियः ।\nभ्रष्टाधिकारा ऋभवो विचेरुश्छन्नवेषकाः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006256086, "chapter_id": 26256, "verse_number": "३-१०-८७", "content_sanskrit": "यक्षान्महोरगान्सिद्धान्साध्यान्समरदुर्मदान् ।\nब्रह्माणं पद्मनाभं च रुद्रं वज्रिणमेव च ।\nमत्वा तृणायितान्सर्वांल्लोकान्भण्डः शशासह ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006256087, "chapter_id": 26256, "verse_number": "३-१०-८८", "content_sanskrit": "अथ भण्डासुरं हन्तुं त्रैलोक्यं चापि रक्षितुम् ।\nतृतीयमुदभूद्रूपं महायागानलान्मुने ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006256088, "chapter_id": 26256, "verse_number": "३-१०-८९", "content_sanskrit": "यद्रूपशालिनीमाहुर्ललिता परदेवताम् ।\nपाशाङ्कुशधनुर्वाणपरिष्कृतचतुर्भुजाम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006256089, "chapter_id": 26256, "verse_number": "३-१०-९०", "content_sanskrit": "सा देवी परम शक्तिः परब्रह्मस्वरूपिणी ।\nजघान भण्डदैत्येन्द्रं युद्धे युद्धविशारदा ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}]