[{"id": 50008190, "chapter_id": 11397, "verse_number": "1", "content_sanskrit": "विदुर उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50008191, "chapter_id": 11397, "verse_number": "2", "content_sanskrit": "अन्तर्हिते भगवति ब्रह्मा लोकपितामहः। प्रजाः ससर्ज कतिधा दैहिकार्मानसीर्विभुः॥ ३/११/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50008192, "chapter_id": 11397, "verse_number": "3", "content_sanskrit": "ये च मे भगवान् पृष्टास्त्वय्यर्था बहुवित्तम। तान् वदस्वानुपूर्व्येण छिन्धि नः सर्वसंशयान्॥ ३/११/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50008193, "chapter_id": 11397, "verse_number": "4", "content_sanskrit": "श्रीशुक उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50008194, "chapter_id": 11397, "verse_number": "5", "content_sanskrit": "एवं सञ्चोदितस्तेन क्षत्त्रा कौषारवो मुनिः। प्रीतः प्रत्याह तान् प्रश्नान् हृदिस्थानथ भारत॥ ३/११/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50008195, "chapter_id": 11397, "verse_number": "6", "content_sanskrit": "मैत्रेय उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50008196, "chapter_id": 11397, "verse_number": "7", "content_sanskrit": "विरिञ्चोऽपि तदा चक्रे दिव्यं वर्षशतं तपः। आत्मन्यात्मानमावेश्य यथाऽऽह भगवानजः॥ ३/११/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50008197, "chapter_id": 11397, "verse_number": "8", "content_sanskrit": "तद् विलोक्यात्मसम्भूतो वायुना यदधिष्ठितम्। पदम्मम्भश्च तत्कालकृतवीर्येण कम्पितम्॥ ३/११/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50008198, "chapter_id": 11397, "verse_number": "9", "content_sanskrit": "तपसा ह्येधमानेन विद्यया चात्मसंस्थया। विवृद्धविज्ञानबलो न्यपाद् वायुं सहाम्भसा॥ ३/११/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50008199, "chapter_id": 11397, "verse_number": "10", "content_sanskrit": "तद् विलोक्य वियद्व्यापि पुष्करं यदधिष्ठितः। अनेन लोकान् प्राग् लीनान् कल्पितास्मीत्यचिन्तयत्॥ ३/११/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50008200, "chapter_id": 11397, "verse_number": "11", "content_sanskrit": "पदम्कोशं तदाविश्य भगवान् कर्मचोदितः। एकं व्यभाङ्क्षीदुरुधा त्रिधा भाव्य द्विसप्तधा॥ ३/११/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50008201, "chapter_id": 11397, "verse_number": "12", "content_sanskrit": "एतावज्जीवलोकस्य संस्थाभेदः समासतः। धर्मस्य ह्यनिमित्तस्य विपाकः परमेष्ठिनः॥ ३/११/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50008202, "chapter_id": 11397, "verse_number": "13", "content_sanskrit": "विदुर उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50008203, "chapter_id": 11397, "verse_number": "14", "content_sanskrit": "यदात्थ बहुरूपस्य हरेरद्भुतकर्मणः। कालाख्यं लक्षणं ब्रह्मन् यथा वर्णय नः प्रभो॥ ३/११/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50008204, "chapter_id": 11397, "verse_number": "15", "content_sanskrit": "मैत्रेय उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50008205, "chapter_id": 11397, "verse_number": "16", "content_sanskrit": "गुणव्यतिकराकारो निर्विशेषोऽप्रतिष्ठितः। पुरुषस्तदुपादानमात्मानं लीलयाऽसृजत्॥ ३/११/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50008206, "chapter_id": 11397, "verse_number": "17", "content_sanskrit": "विश्वं वै ब्रह्मतन्मात्रं संस्थितं विष्णुमायया। ईश्वरेण परिच्छिन्नं कालेनाव्यक्तमूर्तिना॥ ३/११/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50008207, "chapter_id": 11397, "verse_number": "18", "content_sanskrit": "यथेदानीं तथाऽग्रे च पश्चादप्येतदीदृशम्। सर्गो नवविधस्तस्य प्राकृतो वैकृतश्च यः॥ ३/११/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50008208, "chapter_id": 11397, "verse_number": "19", "content_sanskrit": "कालद्रव्यगुणैरस्य त्रिविधः प्रतिसङ्क्रमः। आद्यस्तु महतः सर्गो गुणवैषम्यमात्मनः॥ ३/११/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50008209, "chapter_id": 11397, "verse_number": "20", "content_sanskrit": "द्वितीयस्त्वहमस्तत्र द्रव्यज्ञानक्रियादयः। भूतसर्गस्तृतीयस्तु तन्मात्रद्रव्यशक्तिमान्॥ ३/११/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50008210, "chapter_id": 11397, "verse_number": "21", "content_sanskrit": "चतुर्थ ऐन्द्रियः सर्गो यस्तु ज्ञानक्रियात्मकः। वैकारिको देवसर्गः पञ्चमो यन्मयं मनः॥ ३/११/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50008211, "chapter_id": 11397, "verse_number": "22", "content_sanskrit": "षष्ठस्तु तमसः सर्गो यस्त्वबुद्धिकृतः प्रभोः। षडिमे प्राकृताः सर्गा वैकृतानपि मे शृणु॥ ३/११/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50008212, "chapter_id": 11397, "verse_number": "23", "content_sanskrit": "रजोभाजो भगवतो लीलेयं हरिमेधसः। सप्तमो मुख्यसर्गस्तु षड्विधस्तस्थुषां च यः॥ ३/११/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50008213, "chapter_id": 11397, "verse_number": "24", "content_sanskrit": "वनस्पत्योषधिलतात्वक्सारा वीरुधो द्रुमाः। उत्स्रोतसस्तमःप्राया अन्तःस्पर्शा विशोषिणः॥ ३/११/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50008214, "chapter_id": 11397, "verse_number": "25", "content_sanskrit": "तिरश्चामष्टमः सर्गः सोऽष्टाविंशद्विधो मतः। अविदो भूरितमसो घ्राणज्ञा हृदिवेदिनः॥ ३/११/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50008215, "chapter_id": 11397, "verse_number": "26", "content_sanskrit": "गौरजो महिषः कृष्णः सूकरो गवयो रुरुः। द्विशफाः पशवश्चेमे अविरुष्ट्रश्च सत्तम॥ ३/११/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50008216, "chapter_id": 11397, "verse_number": "27", "content_sanskrit": "खरोऽश्वोऽश्वतरो गौरः शरभश्चमरी तथा। एते चैकशफाः क्षत्तः शृणु पञ्चनखान् पशून्॥ ३/११/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50008217, "chapter_id": 11397, "verse_number": "28", "content_sanskrit": "श्वा सृगालो वृको व्याघ्रो मार्जारः शशशल्यकौ। सिंहः कपिर्गजः कूर्मो गोधा च मकरादयः॥ ३/११/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50008218, "chapter_id": 11397, "verse_number": "29", "content_sanskrit": "कङ्कगृध्रबळश्येना भासवल्लूरबर्हिणः। हंससारसचक्राह्वाः काकोलूकादयः खगाः॥ ३/११/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50008219, "chapter_id": 11397, "verse_number": "30", "content_sanskrit": "अर्वाक्स्रोतस्तु नवमः क्षत्तरेकविधो नृणाम्। रजोऽधिकाः कर्मपरा दुःखे च सुखमानिनः॥ ३/११/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50008220, "chapter_id": 11397, "verse_number": "31", "content_sanskrit": "वैकृतास्त्रय एवैते देवसर्गश्च सत्तम। वैकारिकश्च यः प्रोक्तः कौमारस्तूभयात्मकः॥ ३/११/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50008221, "chapter_id": 11397, "verse_number": "32", "content_sanskrit": "देवसर्गश्चाष्टविधो विबुधाः पितरोऽसुराः। गन्धर्वाप्सरसः सिद्धा यक्षरक्षांसि चारणाः॥ ३/११/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50008222, "chapter_id": 11397, "verse_number": "33", "content_sanskrit": "भूतप्रेतपिशाचाश्च विद्याध्राः किन्नरादयः। दशैते विदुराख्याताः सर्गास्ते विश्वसृकृताः॥ ३/११/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50008223, "chapter_id": 11397, "verse_number": "34", "content_sanskrit": "अतः परं प्रवक्ष्यामि वंशान् मन्वन्तराणि च। एवं रजःप्लुतः स्रष्टा कल्पादिष्वात्मभूर्हरिः। सृजत्यमोघसङ्कल्प आत्मैवात्मानमात्मना॥ ३/११/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50008224, "chapter_id": 11397, "verse_number": "35", "content_sanskrit": "गुणव्यत्यय एतस्मिन् मायावत्त्वादधीशितुः। न पौर्वापर्यमिच्छन्ति नद्यां भ्राम्यद्भ्रमेरिव॥ ३/११/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50008225, "chapter_id": 11397, "verse_number": "36", "content_sanskrit": "देवासुरादयः क्षत्तः कल्पेऽस्मिन् ये प्रकार्तिताः। त एव नामरूपाभ्यामासन् मन्वन्तरान्तरे॥ ३/११/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50008226, "chapter_id": 11397, "verse_number": "37", "content_sanskrit": "॥ इति श्रीमद्भागवते तृतीयस्कन्ध एकादशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]