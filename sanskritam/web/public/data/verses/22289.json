[{"id": 7002289000, "chapter_id": 22289, "verse_number": "३३४-१", "content_sanskrit": "अग्निरुवाच ।\nयतिविच्छेद इत्युक्तस्तत्तन्मध्यान्तयौ गणौ ।\nयौसः कुमारलालिता तौ गौ चित्रपदा स्मृता ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002289001, "chapter_id": 22289, "verse_number": "३३४-२", "content_sanskrit": "विद्युन्माला मममागणैर्भूतगणैर्भवेत् ।\nमाणवकाक्रीड़ितकं वनौ हलमुखी वसः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002289002, "chapter_id": 22289, "verse_number": "३३४-३", "content_sanskrit": "स्याद्भुजङ्गशिशुसूतानौ मेहनं मरुतं ननौ ।\nभवेच्छुद्धविराड्वृत्तं प्रतिपादं समौ जगौ ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002289003, "chapter_id": 22289, "verse_number": "३३४-४", "content_sanskrit": "पणवोमलयोमः स्याज्जौ गौ मयूरसारिणी ।\nसत्तामभसगा वृत्तं भजताद्युपरिस्थिता ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002289004, "chapter_id": 22289, "verse_number": "३३४-५", "content_sanskrit": "रुक्मवती भससगाविन्द्रावज्रा तजौ जगौ ।\nजतौ जगौ गूपपूर्व्वावाद्यन्ताद्युपजातयः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002289005, "chapter_id": 22289, "verse_number": "३३४-६", "content_sanskrit": "दोधकं भगभागौ स्यात् शालिनी मतभागगौ ।\nयतिः समुद्रा ऋषयः वातोर्म्मी मभतागगौ ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002289006, "chapter_id": 22289, "verse_number": "३३४-७", "content_sanskrit": "चतुःस्वरा स्याद्भ्रमरी विलासिता मभौनलौ ।\nसमुद्रा अथ ऋषयो वनौ लौगौ रथोद्धता ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002289007, "chapter_id": 22289, "verse_number": "३३४-८", "content_sanskrit": "सामताधनभागौगोवृत्ताननसमाश्च सः ।\nश्येनी वजवनागः स्याद्रम्या नपरगागगः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002289008, "chapter_id": 22289, "verse_number": "३३४-९", "content_sanskrit": "जगती वंशस्था वृत्तं जतौ जावथ तौ जवौ ।\nइन्द्रवंशा तोटकं सैरचतुर्भिः प्रतिपादतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002289009, "chapter_id": 22289, "verse_number": "३३४-१०", "content_sanskrit": "भवेद्द्रुतविलम्बिता नभौ भवावथौ नलौ ।\nस्यौ श्रीपुठो वसुवेदा जलोगतिजलौ जमौ ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002289010, "chapter_id": 22289, "verse_number": "३३४-११", "content_sanskrit": "जसौ वसर्व्ववश्चाथ ततं ननमराः स्मृतं ।\nकुशुमविचित्रान्यौ द्यौ नौ नौ रौ स्याच्चलाम्बिका ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002289011, "chapter_id": 22289, "verse_number": "३३४-१२", "content_sanskrit": "भुजङ्गप्र्यातं थैः स्याच्चतुभिः स्राग्विनीभवैः ।\nप्रमिताक्षरा गजौ सौ कान्तोत्पीड़ा मतौ समौ ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002289012, "chapter_id": 22289, "verse_number": "३३४-१३", "content_sanskrit": "वैश्वदेवी ममयायाः पञ्चाङ्गा नवमालिनी ।\nनजौ भयौ प्रतिपादं गणा यदि जगत्यपि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002289013, "chapter_id": 22289, "verse_number": "३३४-१४", "content_sanskrit": "प्रहर्षणी मवजवा गोपतिर्बह्निदिक्षु च ।\nरुचिरा जभसजगा च्छिन्ना वेदैर्ग्रहैः स्मृता ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002289014, "chapter_id": 22289, "verse_number": "३३४-१५", "content_sanskrit": "मत्तमयूरं मतया सगौ वेदग्रहे यतिः ।\nगौरीनलनसागः स्यादसम्बाधा नतौ नगौ ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002289015, "chapter_id": 22289, "verse_number": "३३४-१६", "content_sanskrit": "गोग इन्द्रियनवकौ ननौ वसनगाः स्वराः ।\nस्वराश्चापराजिता स्यान्ननभाननगाः स्वराः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002289016, "chapter_id": 22289, "verse_number": "३३४-१७", "content_sanskrit": "द्विःप्रहरणकलिता वसन्ततिलका नभौ ।\nजौ गौ सिंहोन्नता सा स्यान्मुनेरुद्धर्षणी च सा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002289017, "chapter_id": 22289, "verse_number": "३३४-१८", "content_sanskrit": "चन्द्रावर्त्ता ननौ सोमावर्त्तर्तुनवकः स्मृतः ।\nमणिगुणनिकरा सौ मालिनौ नौ मयौ ययः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002289018, "chapter_id": 22289, "verse_number": "३३४-१९", "content_sanskrit": "यतिर्वसुस्वरा भौ वौ नतलमित्रसग्रहाः ।\nऋषभगजविलासितं ज्ञेया शिखरिणी जगौ ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002289019, "chapter_id": 22289, "verse_number": "३३४-२०", "content_sanskrit": "रसभालभृगुरुद्राः पृथ्वीजसजसा जनौ ।\nगोवसुग्रहविच्छिन्ना पिह्गलेनेरिता पुरा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002289020, "chapter_id": 22289, "verse_number": "३३४-२१", "content_sanskrit": "वंशपत्रपतितं स्याद् भवना भौ नगौ सदिक् ।\nहरिणी नसमारः सो नगौ रसचतुःस्वराः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002289021, "chapter_id": 22289, "verse_number": "३३४-२२", "content_sanskrit": "मन्दाक्रान्ता नभनतं तगौगछिरसस्वराः ।\nकुसुमितलता वेल्लिता मतना यययाः शराः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002289022, "chapter_id": 22289, "verse_number": "३३४-२३", "content_sanskrit": "रथाः स्व्राः प्रतिरथससजाः सततश्च गः ।\nशार्दूलविक्रीड़ितं स्यादादित्यमुनयो यतिः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002289023, "chapter_id": 22289, "verse_number": "३३४-२४", "content_sanskrit": "कृतिः सुवदना मोरो भनया भनगाः सुराः ।\nयतिर्मुनिरसाश्चाथ इति वृत्तं क्रमात् स्मृतम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002289024, "chapter_id": 22289, "verse_number": "३३४-२५", "content_sanskrit": "स्रग्ध्रा मरतानोमोयपौ त्रिःसप्तका यतिः ।\nसमुद्रकं भरजानोवनगा दशभास्कराः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002289025, "chapter_id": 22289, "verse_number": "३३४-२६", "content_sanskrit": "अस्वललितं नजभा जभजा भनमीशतः ।\nमत्ताक्रीड़ा ममनना नौनग्नौ गोष्टमातिथिः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002289026, "chapter_id": 22289, "verse_number": "३३४-२७", "content_sanskrit": "तन्वी भनतसाभोभो लयो वाणसुरार्क्ककाः ।\nक्रौञ्चपदा भमतता नौ नौ वाण्शराष्टतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002289027, "chapter_id": 22289, "verse_number": "३३४-२८", "content_sanskrit": "भुजङ्गविजृम्भितं ममतना ननवासनौ ।\nगष्टेशमुनिभिश्छेदो ह्युहाराख्यमीदृशम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002289028, "chapter_id": 22289, "verse_number": "३३४-२९", "content_sanskrit": "मननानतानः सो गगौ ग्रहरसो रसात् ।\nनौ सप्तरोदण्डदः स्याच्चण्डवृष्टिप्रघातकं ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002289029, "chapter_id": 22289, "verse_number": "३३४-३०", "content_sanskrit": "रेफवृद्ध्या णणवा स्युर्व्यालजीमूतमुख्यकाः ।\nशेषे वै प्रचिता ज्ञेया गाथाप्रस्तार उच्यते ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]