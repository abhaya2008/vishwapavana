[{"id": 7002528000, "chapter_id": 22528, "verse_number": "१-१९०-१", "content_sanskrit": "सौरधर्मेषु सूर्यानूरुसंवादवर्णनम् ।\nसप्ताश्वतिलक उवाच  ।\nतारारूपविमानानामिमाः संति च कोटयः ।\nयः कुर्यात्तु नमस्कारं तस्यैव च फलं भवेत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002528001, "chapter_id": 22528, "verse_number": "१-१९०-२", "content_sanskrit": "इत्येता गतयः प्रोक्ता महत्यः सौरधर्मिणाम् ।\nतस्मात्सौरः सदा धर्मः कर्तव्यः सुखमिच्छता ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002528002, "chapter_id": 22528, "verse_number": "१-१९०-३", "content_sanskrit": "इदानीं पापनिचयाः स्थूला नरकहेतवः ।\nते समासेन कथ्यन्ते मनोवाक्कायसाधनैः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002528003, "chapter_id": 22528, "verse_number": "१-१९०-४", "content_sanskrit": "गवां मार्गे वने चाग्नेः पुरे ग्रामे समर्पणम् ।\nइत्येतानीह पापानि सुरापानसमानि च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002528004, "chapter_id": 22528, "verse_number": "१-१९०-५", "content_sanskrit": "वने सर्वस्य हरणं नरस्त्रीगजवाजिनाम् ।\nगोभूसमीपजातानामोषधीनां च खेचर ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002528005, "chapter_id": 22528, "verse_number": "१-१९०-६", "content_sanskrit": "चन्दनागुरुकर्पूरकस्तूरीपट्टवाससाम् ।\nहस्तन्यासाप हरणं रुक्मस्तेयसमं स्मृतम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002528006, "chapter_id": 22528, "verse_number": "१-१९०-७", "content_sanskrit": "कन्यानां वरयोग्यानामाकर्षणमसंगतः ।\nपुत्रमित्रकलत्रेषु गमनं भगिनीषु च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002528007, "chapter_id": 22528, "verse_number": "१-१९०-८", "content_sanskrit": "कुमारीसाहसं घोरमंत्यजस्त्रीनिषेवणम् ।\nसवर्णायाश्च गमनं गुरुतल्पसमं स्मृतम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002528008, "chapter_id": 22528, "verse_number": "१-१९०-९", "content_sanskrit": "महापातकतुल्यानि पापान्युक्तानि यानि तु ।\nतानि पातकसंज्ञानि ब्रूमहे चोपपातकम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002528009, "chapter_id": 22528, "verse_number": "१-१९०-१०", "content_sanskrit": "द्विजायार्थं परिश्रुत्य न प्रयच्छति यो द्विज ।\nसद्भार्याणां च संत्यागः साधुबन्धुतपस्विनाम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002528010, "chapter_id": 22528, "verse_number": "१-१९०-११", "content_sanskrit": "गोभू हिरण्यवस्त्राणामपहारः प्रयत्नतः ।\nईश्वरार्पितबुद्धीनां पीडनं सुमहत्कृतम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002528011, "chapter_id": 22528, "verse_number": "१-१९०-१२", "content_sanskrit": "यः पीडामाश्रमस्थान आचरेदल्पिकामपि ।\nतद्भूत्युपरिभूतस्य पशुधान्यधनस्य च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002528012, "chapter_id": 22528, "verse_number": "१-१९०-१३", "content_sanskrit": "कूपधान्यपशुस्तेयमयाज्यानां च याजनम् ।\nयज्ञारामतडागानां दारापत्यस्य विक्रयः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002528013, "chapter_id": 22528, "verse_number": "१-१९०-१४", "content_sanskrit": "तीर्थ यात्रोपवासानां व्रते च जपकर्मणि ।\nस्त्रीधनान्युपकर्षंति ये जनाः पापकर्मणा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002528014, "chapter_id": 22528, "verse_number": "१-१९०-१५", "content_sanskrit": "अरक्षणं च नारीणां मद्यपस्त्रीनिषेवणम् ।\nऋषीणामप्रदानं च धान्यवृद्ध्युपसेवनम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002528015, "chapter_id": 22528, "verse_number": "१-१९०-१६", "content_sanskrit": "देवाग्निसाधुसाध्वीनां निन्दा गोब्राह्मणस्य च ।\nप्रत्यक्षं वा परोक्षं वा राजमाण्डलिकानपि ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002528016, "chapter_id": 22528, "verse_number": "१-१९०-१७", "content_sanskrit": "उत्सन्नपितृदेवाश्च स्वकर्मत्यागिनश्च ये ।\nदुःशीला नास्तिकाः पापाः सदसच्छून्यवादिनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002528017, "chapter_id": 22528, "verse_number": "१-१९०-१८", "content_sanskrit": "एवं कामे प्रवृत्ते तु वियोनौ पशुयोनिषु ।\nरजस्वलास्वयोनौ तु मैथुनं यः समाचरेत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002528018, "chapter_id": 22528, "verse_number": "१-१९०-१९", "content_sanskrit": "स्त्रीपुत्रमित्रसंप्रीते रारामोच्छेदकाश्च ये ।\nजनस्याप्रियवक्तारो जनाभिप्रायभेदिनः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002528019, "chapter_id": 22528, "verse_number": "१-१९०-२०", "content_sanskrit": "भेत्ता तडागवप्राणां संक्रमाणां रसस्य च ।\nएकपंक्तिस्थितानां च पंक्तिभेदं करोति यः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002528020, "chapter_id": 22528, "verse_number": "१-१९०-२१", "content_sanskrit": "इत्येतैस्तु नराः पापैरुपपातकिनः स्मृताः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]