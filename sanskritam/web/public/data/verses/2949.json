[{"id": 2091598, "chapter_id": 2949, "verse_number": "१३-७९-१", "content_sanskrit": "युधिष्ठिर उवाच।\nयन्मूलं सर्वधर्माणां प्रजनस्य गृहस्य च।\nपितृदेवातिथीनां च तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2091599, "chapter_id": 2949, "verse_number": "१३-७९-२", "content_sanskrit": "अयं हि सर्वधर्माणां धर्मश्चिन्त्यतमो मतः।\nकीदृशाय प्रदेया स्यात्कन्येति वसुधाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2091600, "chapter_id": 2949, "verse_number": "१३-७९-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2091601, "chapter_id": 2949, "verse_number": "१३-७९-३", "content_sanskrit": "शीलवृत्ते समाज्ञाय विद्यां योनिं च कर्म च।\nअद्भिरेव प्रदातव्या कन्या गुणवते भवेत्।\nब्राह्मणानां सतामेष नित्यं धर्मो युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2091602, "chapter_id": 2949, "verse_number": "१३-७९-४", "content_sanskrit": "आवाह्यमावहेदेवं यो दद्यादनुकूलतः।\nशिष्टानां क्षत्रियाणां च धर्म एष सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2091603, "chapter_id": 2949, "verse_number": "१३-७९-५", "content_sanskrit": "आत्माभिप्रेतमुत्सृज्य कन्याभिप्रेत एष यः।\nअभिप्रेता च या यस्य तस्मै देया युधिष्ठिर।\nगान्धर्वमिति तं धर्मं प्राहुर्वेदविदो जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2091604, "chapter_id": 2949, "verse_number": "१३-७९-६", "content_sanskrit": "धनेन बहुधा क्रीत्वा सम्प्रलोभ्य च बान्धवान्।\nअसुराणां नृपैतं वै धर्ममाहुर्मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2091605, "chapter_id": 2949, "verse_number": "१३-७९-७", "content_sanskrit": "हत्वा छित्त्वा च शीर्षाणि रुदतां रुदतीं गृहात्।\nप्रसह्य हरणं तात राक्षसो विधिरुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2091606, "chapter_id": 2949, "verse_number": "१३-७९-८", "content_sanskrit": "`सुसां मत्तां प्रमत्तां वा रहो रात्रौ च गच्छति।\nस पापिष्ठो विवाहानां पैशाचः कथितोऽधमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2091607, "chapter_id": 2949, "verse_number": "१३-७९-९", "content_sanskrit": "पञ्चानां तु त्रयो धर्म्या द्वावधर्म्यौ युधिष्ठिर।\nपैशाचश्चासुरश्चैव न कर्तव्यौ कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2091608, "chapter_id": 2949, "verse_number": "१३-७९-१०", "content_sanskrit": "ब्राह्मः क्षात्रोऽथ गान्धर्व एते धर्म्या नरर्षभ।\nपृथग्वा यदि वा मिश्राः कर्तव्या नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2091609, "chapter_id": 2949, "verse_number": "१३-७९-११", "content_sanskrit": "तिस्त्रो भार्या ब्राह्मणस्य द्वे भार्ये क्षत्रियस्य तु।\nवैश्यः स्वजात्यां विन्देत तास्वपत्यं हिताय हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2091610, "chapter_id": 2949, "verse_number": "१३-७९-१२", "content_sanskrit": "द्विजस्य ब्राह्म्णी श्रेष्ठा क्षत्रिया क्षत्रियस्य तु।\nरत्यर्थमपि शूद्रा स्यान्नेत्याहुरपरे जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2091611, "chapter_id": 2949, "verse_number": "१३-७९-१३", "content_sanskrit": "अपत्यजन्म शूद्रायां न प्रशंसन्ति साधवः।\nशूद्रायां जनयविन्प्रः प्रायश्चित्ती विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2091612, "chapter_id": 2949, "verse_number": "१३-७९-१४", "content_sanskrit": "`नातिबालां वहन्त्यन्ते अनित्यत्वात्प्रजार्थिनः।\nवहन्ति कर्मिणस्तस्यामन्तः शुद्धिव्यपेक्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2091613, "chapter_id": 2949, "verse_number": "१३-७९-१५", "content_sanskrit": "अपरान्वयसम्भूतां संस्वप्नादिविवर्जिताम्।\nकामो यस्यां निषिद्धश्च केचिदिच्छन्ति चापदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2091614, "chapter_id": 2949, "verse_number": "१३-७९-१६", "content_sanskrit": "त्रिंशद्वर्षो दशवर्षां भार्यां विन्देत नग्निकाम्।\nएकविंशतिवर्षो वा सप्तवर्षामवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2091615, "chapter_id": 2949, "verse_number": "१३-७९-१७", "content_sanskrit": "यस्यास्तु न भवेद्भाता पिता वा भरतर्षभ।\nनोपयच्छेत तां जातु पुत्रिकाधर्मिणी हि सा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2091616, "chapter_id": 2949, "verse_number": "१३-७९-१८", "content_sanskrit": "त्रीणि वर्षाण्युदीक्षेत कन्या ऋतुमती सती।\nचतुर्थेऽत्वथ सम्प्राप्ते स्वयं भर्तारमर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2091617, "chapter_id": 2949, "verse_number": "१३-७९-१९", "content_sanskrit": "प्रजा न हीयते तस्या रतिश्च भरतर्षभ।\nअतोऽन्यथा वर्तमाना भवेद्वाच्या प्रजापतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2091618, "chapter_id": 2949, "verse_number": "१३-७९-२०", "content_sanskrit": "असपिण्डा च या मातुरसगोत्रा च या पितुः।\nइत्येतामुपयच्छेत तं धर्मं मनुरब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2091619, "chapter_id": 2949, "verse_number": "१३-७९-२१x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2091620, "chapter_id": 2949, "verse_number": "१३-७९-२१", "content_sanskrit": "शुल्कमन्येन दत्तं स्याद्ददानीत्याह चापरः।\nबलादन्यः प्रभाषेत धनमन्यः प्रदर्शयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2091621, "chapter_id": 2949, "verse_number": "१३-७९-२२", "content_sanskrit": "पाणिग्रहीत्ता चान्यः स्यात्कस्य भार्या पितामह।\nतत्त्वं जिज्ञासमानानां चक्षुर्भवतु नो भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2091622, "chapter_id": 2949, "verse_number": "१३-७९-२३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2091623, "chapter_id": 2949, "verse_number": "१३-७९-२३", "content_sanskrit": "यत्किञ्चित्कर्म मानुष्यं संस्थानाय प्रदृश्यते।\nमन्त्रवन्मन्त्रितं तस्य मृषावादस्तु पातकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2091624, "chapter_id": 2949, "verse_number": "१३-७९-२४", "content_sanskrit": "भार्यापत्यृत्विगाचार्याः शिष्योपाध्याय एव च।\nमृषोक्ते दण्डमर्हन्ति नेत्याहुरपरे जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2091625, "chapter_id": 2949, "verse_number": "१३-७९-२५", "content_sanskrit": "नह्यकामेन संवादं मनुरेवं प्रशंसति।\nअयशस्यमधर्म्यं च यन्मृषा धर्मगोपनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2091626, "chapter_id": 2949, "verse_number": "१३-७९-२६", "content_sanskrit": "नैकान्तो दोष एकस्मिंस्तदा केनोपपद्यते।\nधर्मतो यां प्रयच्छन्ति यां च क्रीणन्ति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2091627, "chapter_id": 2949, "verse_number": "१३-७९-२७", "content_sanskrit": "बन्धुभिः समनुज्ञाते मन्त्रहोमौ प्रयोजयेत्।\nतथा सिध्यन्ति ते मन्त्रा नादत्तायाः कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2091628, "chapter_id": 2949, "verse_number": "१३-७९-२८", "content_sanskrit": "यस्त्वत्र मन्इत्रसमयो भार्यापत्योर्मिथः कृतः।\nतमेवाहुर्गरीयांसं यश्चासौ ज्ञातिभिः कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2091629, "chapter_id": 2949, "verse_number": "१३-७९-२९", "content_sanskrit": "देवदत्तां पतिर्भार्यां वेत्ति धर्मस्य शासनात्।\nस दैवीं मानुषीं वाचमनृतां पर्युदस्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2091630, "chapter_id": 2949, "verse_number": "१३-७९-३०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2091631, "chapter_id": 2949, "verse_number": "१३-७९-३०", "content_sanskrit": "कन्यायां प्राप्तसुल्कायां ज्यायांश्चेदाव्रजेद्वरः।\nधर्मकामार्थसम्पन्नो वाच्यमत्रानृतं न वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2091632, "chapter_id": 2949, "verse_number": "१३-७९-३१", "content_sanskrit": "तस्मिन्नुभयतो दोषे कुर्वञ्श्रेयः समाचरेत्।\nअयं नः सर्वधर्माणां धर्मश्चिन्त्यतमो मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2091633, "chapter_id": 2949, "verse_number": "१३-७९-३२", "content_sanskrit": "तत्त्वं जिज्ञासमानानां चक्षुर्भवतु नो भवान्।\nतदेतत्सर्वमाचक्ष्व न हि तृप्यामि कथ्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2091634, "chapter_id": 2949, "verse_number": "१३-७९-३३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2091635, "chapter_id": 2949, "verse_number": "१३-७९-३३", "content_sanskrit": "नैव निष्ठाकरं शुल्कं ज्ञात्वाऽऽसीत्तेन नानृतम्।\nन हि शुल्कपराः सन्तः कन्यां ददति कर्हिचित्।\nअन्यैर्गुणैरुपेतं तु शुल्कं याचन्ति बान्धवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2091636, "chapter_id": 2949, "verse_number": "१३-७९-३४", "content_sanskrit": "अलङ्कृत्वा वहस्वेति यो दद्यादनुकूलतः।\nयच्च तां च ददत्येवं न शुल्कं विक्रयो न सः।\nप्रतिगृह्य भवेद्देमेव धर्मः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2091637, "chapter_id": 2949, "verse_number": "१३-७९-३५", "content_sanskrit": "दास्यामि भवते कन्यामिति पूर्वं नभाषितम्।\nये चाहुर्ये च नाहुर्ये ये चावश्यं वदन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2091638, "chapter_id": 2949, "verse_number": "१३-७९-३६", "content_sanskrit": "तस्मादाग्रहणात्पाणेर्याचयन्ति परस्परम्।\nकन्यावरः पुरा दत्तो मरुद्भिरिति नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2091639, "chapter_id": 2949, "verse_number": "१३-७९-३७", "content_sanskrit": "नानिष्टाय प्रदातव्या कन्या इत्यृषिचोदितम्।\nतन्मूलं काममूलस्य प्रजनस्येति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2091640, "chapter_id": 2949, "verse_number": "१३-७९-३८", "content_sanskrit": "समीक्ष्य च बहून्दोषान्संवासाद्विद्धि पाणयोः।\nयथा निष्ठाकरं शुल्कं न जात्वासीत्तथा शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2091641, "chapter_id": 2949, "verse_number": "१३-७९-३९", "content_sanskrit": "अहं विचित्रवीर्यस्य द्वे कन्ये समुदावहम्।\nजित्वाऽङ्गमागधान्सर्वान्काशीनथ च कोसलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2091642, "chapter_id": 2949, "verse_number": "१३-७९-४०", "content_sanskrit": "गृहीतपाणिरेकाऽऽसीत्प्राप्तशुल्काऽपराऽभवत्।\nकन्याऽगृहीता तत्रैव विसर्ज्या इति मे पिता।\nअब्रवीदितरां कन्यामावहेति स कौरवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2091643, "chapter_id": 2949, "verse_number": "१३-७९-४१", "content_sanskrit": "अप्यन्याननुपप्रच्छ शङ्कमानः पितुर्वचः।\nअतीव ह्यस्य धर्मेच्छा पितुर्मेऽभ्यधिकाऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2091644, "chapter_id": 2949, "verse_number": "१३-७९-४२", "content_sanskrit": "ततोहमब्रवं राजन्नाचारेप्सुरिदं वचः।\nआचारं तत्त्वतो वेत्तुमिच्छामि च पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2091645, "chapter_id": 2949, "verse_number": "१३-७९-४३", "content_sanskrit": "ततो मयैवमुक्ते तु वाक्ये धर्मभृतावरः॥\nपिता मम महाराज बीह्लीको वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2091646, "chapter_id": 2949, "verse_number": "१३-७९-४४", "content_sanskrit": "यदि व शुल्कतो निष्ठा न पाणिग्रहणात्तथा।\nलाजान्तरमुपासीत प्राप्तशुल्क इति स्मृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2091647, "chapter_id": 2949, "verse_number": "१३-७९-४५", "content_sanskrit": "न हि धर्मविदः प्राहुः प्रमाणं वाक्यतः स्मृतम्।\nयेषां वै शुल्कतो निष्ठा न पाणिग्रहणात्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2091648, "chapter_id": 2949, "verse_number": "१३-७९-४६", "content_sanskrit": "प्रसिद्धं भाषितं दाने नैषां प्रत्यायकं पुनः।\nये मन्यन्ते क्रयं शुल्कं न ते धर्मविदो नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2091649, "chapter_id": 2949, "verse_number": "१३-७९-४७", "content_sanskrit": "न चैतेभ्यः प्रदातव्या न वोढव्या तथाविधा।\nन ह्येव भार्या क्रेतव्या न विक्रय्यां कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2091650, "chapter_id": 2949, "verse_number": "१३-७९-४८", "content_sanskrit": "ये च क्रीणन्ति दासीवद्विक्रीणन्ति तथैव च।\nभवेत्तेषां तथा निष्ठा लुब्धानां पापचेतसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2091651, "chapter_id": 2949, "verse_number": "१३-७९-४९", "content_sanskrit": "अस्मिन्नर्थे सत्यवन्तं पर्यपृच्छन्त वै जनाः।\nकन्यायाः प्राप्तशुल्कायाः शुल्कदः प्रशमं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2091652, "chapter_id": 2949, "verse_number": "१३-७९-५०", "content_sanskrit": "पाणिग्रहीता वाऽन्यः स्यादत्र नो धर्मसंशयः।\nतन्नश्छिन्धि महाप्राज्ञ त्वं हि वै प्राज्ञसम्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2091653, "chapter_id": 2949, "verse_number": "१३-७९-५१", "content_sanskrit": "तत्त्वं जिज्ञासमानानां चक्षुर्भवतु नो भवान्।\nतानेवं ब्रुवतः सर्वान्सत्यवान्वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2091654, "chapter_id": 2949, "verse_number": "१३-७९-५२", "content_sanskrit": "यत्रेष्टं तत्र देया स्यान्नात्र कार्या विचारणा।\nकुर्वते जीवतोप्येवं मृते नैवास्ति संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2091655, "chapter_id": 2949, "verse_number": "१३-७९-५३", "content_sanskrit": "देवरं प्रविशेत्कन्या तप्येद्वाऽपि तपः पुनः।\nतमेवानुगता भूत्वा पाणिग्राहस्य नाम सा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2091656, "chapter_id": 2949, "verse_number": "१३-७९-५४", "content_sanskrit": "लिखन्त्येव तु केषांचिदपरेषां शनैरपि।\nइति ये संवदन्त्यत्र त एतं निश्चयं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2091657, "chapter_id": 2949, "verse_number": "१३-७९-५५", "content_sanskrit": "तत्पाणिग्रहणात्पूर्वमन्तरं यत्र वर्तते।\nसर्वमङ्गलमन्त्रं वै मृषावादस्तु पातकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2091658, "chapter_id": 2949, "verse_number": "१३-७९-५६", "content_sanskrit": "पाणिग्रहणमन्त्राणां निष्ठा स्यात्सप्तमे पदे।\nपाणिग्रहस्य भार्या स्याद्यस्य चाद्भिः प्रदीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2091659, "chapter_id": 2949, "verse_number": "१३-७९-५७", "content_sanskrit": "इति देयं वदन्त्यत्र त एतं निश्चयं विदुः।\nअनुकूलामनुवशां भ्रात्रा दत्तामुपाग्निकाम्।\nपरिक्रम्य यथान्यायं भार्यां विन्देद्द्विजोत्तमः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2091660, "chapter_id": 2949, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकोनाशीतितमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]