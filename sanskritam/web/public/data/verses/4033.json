[{"id": 2140630, "chapter_id": 4033, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2140631, "chapter_id": 4033, "verse_number": "१", "content_sanskrit": "उत्तरेणैवमुक्तस्तु पार्थो वैराटिमब्रवीत् ।\nमृद्व्या प्रत्याययन् वाचा भीतं शङ्कावशं गतम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2140632, "chapter_id": 4033, "verse_number": "२", "content_sanskrit": "यत् त्वया प्रथमं पृष्टं शत्रुसेनाङ्गमर्दनम् ।\nपार्थस्येदं धनुर्दिव्यं गाण्डीवमिति विश्रुतम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2140633, "chapter_id": 4033, "verse_number": "३", "content_sanskrit": "अभेद्यमभयं श्रीमद् दिव्यमच्छेद्यमव्रणम् ।\nसर्वायुधमहामात्रं शातकुम्भमयं धनुः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2140634, "chapter_id": 4033, "verse_number": "४", "content_sanskrit": "एतच्छतसहस्रेण सम्मितं राष्ट्रवर्धनम् ।\nदेवदानवगन्धर्वैः पूजितं शाश्वतीः समाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2140635, "chapter_id": 4033, "verse_number": "५", "content_sanskrit": "येन देवासुरान् पार्थः सर्वान् विषहते रणे ।\nएतद् वर्षसहस्रं तु ब्रह्मा पूर्वमधारयत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2140636, "chapter_id": 4033, "verse_number": "६", "content_sanskrit": "ततोऽनन्तरमेवाथ प्रजापतिरधारयत् ।\nसोमः पञ्चसहस्राणि तथा च वरुणः शतम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2140637, "chapter_id": 4033, "verse_number": "७", "content_sanskrit": "तस्माच्च वरुणादग्निः प्रेम्णा प्राहृत्य तच्छुभम् ।\nअग्निना प्रातिभाव्येन दत्तं पार्थाय गाण्डिवम् ।\nपञ्चषष्टि च वर्षाणि कौन्तेयो धारयिष्यति\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2140638, "chapter_id": 4033, "verse_number": "८", "content_sanskrit": "एवंवीर्यं महावेगमेतच्च धनुरुत्तमम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2140639, "chapter_id": 4033, "verse_number": "९", "content_sanskrit": "नीलोत्पलसमं राज्ञः कौरव्यस्य महात्मनः ।\nबिन्दवश्चात्र सौवर्णाः पृष्ठे साधुनियोजिताः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2140640, "chapter_id": 4033, "verse_number": "१०", "content_sanskrit": "विश्रुतं भीमसेनस्य जातरूपमयं दृढम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2140641, "chapter_id": 4033, "verse_number": "११", "content_sanskrit": "सहस्रयोधाः सौवर्णा द्वीपिनश्च चतुर्दश ।\nऋषभा यत्र सौवर्णाः पृष्ठे तिष्ठन्ति शृङ्गिणः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2140642, "chapter_id": 4033, "verse_number": "१२", "content_sanskrit": "येन भीमोऽजयत् कृत्स्नां दिशं प्राचीं परन्तपः ।\nपृष्ठे विभक्ताः शोभन्ते कुशाग्निप्रतिदीपिताः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2140643, "chapter_id": 4033, "verse_number": "१३", "content_sanskrit": "पूजितं सुरमर्त्येषु प्रथितं धनुरुत्तमम् ।\nतालप्रमाणं भीमस्य रत्नरुग्मविभूषितम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2140644, "chapter_id": 4033, "verse_number": "१४", "content_sanskrit": "दुरानमं महद् दीर्घं सुरूपं दुष्प्रधर्षणम् ।\nबर्हिणश्चात्र सौवर्णाः शतचन्द्रकभूषणाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2140645, "chapter_id": 4033, "verse_number": "१५", "content_sanskrit": "नकुलस्य धनुस्त्वेतद् माद्रीपुत्रस्य धीमतः ।\nएतेन सदृशं चित्रं धनुरेतद् यवीयसः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2140646, "chapter_id": 4033, "verse_number": "१६", "content_sanskrit": "हारिद्रवर्णा राज्ञस्तु कौरव्यस्य महात्मनः ।\nविपत्त्रा भीमसेनस्य गिरीणामपि दारणाः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2140647, "chapter_id": 4033, "verse_number": "१७", "content_sanskrit": "सुप्रभाः सुमहाकायास्तीक्ष्णाग्राः सुतरां दृढाः ।\nभीमेन प्रहिता ह्येते वारणानां निवारणाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2140648, "chapter_id": 4033, "verse_number": "१८", "content_sanskrit": "सुवर्णदण्डरुचिराः कालदण्डोपमाः शिताः ।\nनकुलस्य शरा ह्येते वज्राशनिसमप्रभाः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2140649, "chapter_id": 4033, "verse_number": "१९", "content_sanskrit": "यांश्च त्वं पृच्छसे दीप्तान् समधारान् समाहितान् ।\nवराहकर्णास्तीक्ष्णाग्राः सहदेवस्य ते शराः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2140650, "chapter_id": 4033, "verse_number": "२०", "content_sanskrit": "यस्त्वयं सायको दीर्घो गव्ये कोशे च दंसितः ।\nपार्थस्यायं महाघोरः सर्वभारसहो महान्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2140651, "chapter_id": 4033, "verse_number": "२१", "content_sanskrit": "यस्त्वयं निर्मलः खड्गो द्वीपिचर्मणि दंसितः ।\nराज्ञो युधिष्ठिरस्यायं कुन्तीपुत्रस्य धीमतः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2140652, "chapter_id": 4033, "verse_number": "२२", "content_sanskrit": "वैयाघ्रकोशो भीमस्य पञ्चशार्दूललक्षणः ।\nवारणानां सुदृप्तानां शिक्षितः स्कन्धशातने\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2140653, "chapter_id": 4033, "verse_number": "२३", "content_sanskrit": "नीलोत्पलसवर्णोऽयं खड्गः पार्थस्य धीमतः ।\nमृगेन्द्रचर्मपिहितस्तीक्ष्णधारः सुनिर्मलः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2140654, "chapter_id": 4033, "verse_number": "२४", "content_sanskrit": "दर्शनीयः सुतीक्ष्णाग्रः कुन्तीपुत्रस्य धीमतः ।\nअर्जुनस्यैव निस्त्रिंशः परसैन्यप्रदूषणः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2140655, "chapter_id": 4033, "verse_number": "२५", "content_sanskrit": "यस्त्वयं पार्षते कोशे निक्षिप्तः रुचिरत्सरुः ।\nनकुलस्यैष निस्त्रिंशो वैश्वानरसमप्रभः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2140656, "chapter_id": 4033, "verse_number": "२६", "content_sanskrit": "यस्त्वयं पिङ्गलः खड्गश्चित्रो मणिमयत्सरुः ।\nसहदेवस्य खड्गोऽयं भारसाहोऽतिदंसितः ।\nभीमस्यायं महादण्डः सर्वामित्रविनाशनः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2140657, "chapter_id": 4033, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2140658, "chapter_id": 4033, "verse_number": "२७", "content_sanskrit": "भेदतो ह्यर्जुनस्तूर्णं कथयामास तत्वतः ।\nआयुधानि कलापानि निस्त्रिंशांश्चातुलप्रभान्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2140659, "chapter_id": 4033, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि एकचत्वारिंशोऽध्यायः ॥४१॥ गोग्रहणपर्वणि चतुर्दशोऽध्यायः ॥१४॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]