[{"id": 5000018000, "chapter_id": 9018, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे अष्टादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000018001, "chapter_id": 9018, "verse_number": "१-१८-१", "content_sanskrit": "निर्वृत्ते तु क्रतौ तस्मिन् हयमेधे महात्मनः ।\nप्रतिगृह्यमरा भागान् प्रतिजग्मुर्यथागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000018002, "chapter_id": 9018, "verse_number": "१-१८-२", "content_sanskrit": "समाप्तदीक्षानियमः पत्नीगणसमन्वितः ।\nप्रविवेश पुरीं राजा सभृत्यबलवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000018003, "chapter_id": 9018, "verse_number": "१-१८-३", "content_sanskrit": "यथार्हं पूजितास्तेन राज्ञा वै पृथिवीश्वराः ।\nमुदिताः प्रययुर्देशान् प्रणम्य मुनिपुंगवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000018004, "chapter_id": 9018, "verse_number": "१-१८-४", "content_sanskrit": "श्रीमतां गच्छतां तेषां स्वगृहाणि पुरात् ततः ।\nबलानि राज्ञां शुभ्राणि प्रहृष्टानि चकाशिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000018005, "chapter_id": 9018, "verse_number": "१-१८-५", "content_sanskrit": "गतेषु पृथिवीशेषु राजा दशरथः पुनः ।\nप्रविवेश पुरीं श्रीमान् पुरस्कृत्य द्विजोत्तमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000018006, "chapter_id": 9018, "verse_number": "१-१८-६", "content_sanskrit": "शान्तया प्रययौ सार्धमृशष्यशृङ्गः सुपूजितः ।\nअमुगम्यमानो राज्ञा च सानुयात्रेण धीमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000018007, "chapter_id": 9018, "verse_number": "१-१८-७", "content_sanskrit": "एवं विसृज्य तान् सर्वान् राजा सम्पूर्णमानसः ।\nउवास सुखितस्तत्र पुत्रोत्पत्तिं विचिन्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000018008, "chapter_id": 9018, "verse_number": "१-१८-८", "content_sanskrit": "ततो यज्ञे समाप्ते तु ऋतूनां षट् समत्ययुः ।\nततश्च द्वादशे मासे चैत्रे नावमिके तिथौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000018009, "chapter_id": 9018, "verse_number": "१-१८-९", "content_sanskrit": "नक्षत्रेऽदितिदैवत्ये स्वोच्चसंस्थेषु पञ्चसु ।\nग्रहेषु कर्कटे लग्ने वाक्पताविन्दुना सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000018010, "chapter_id": 9018, "verse_number": "१-१८-१०", "content_sanskrit": "प्रोद्यमाने जगन्नाथं सर्वलोकनमस्कृतम् ।\nकौसल्याजनयद् रामं दिव्यलक्षणसंयुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000018011, "chapter_id": 9018, "verse_number": "१-१८-११", "content_sanskrit": "विष्णोरर्धं महाभागं पुत्रमैक्ष्वाकुनन्दनम् ।\nलोहिताक्षं महाबाहुं रक्तोष्ठं दुन्दुभिस्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000018012, "chapter_id": 9018, "verse_number": "१-१८-१२", "content_sanskrit": "कौसल्या शुशुभे तेन पुत्रेणामिततेजसा ।\nयथा वरेण देवानामदितिर्वज्रपाणिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000018013, "chapter_id": 9018, "verse_number": "१-१८-१३", "content_sanskrit": "भरतो नाम कैकेय्यां जज्ञे सत्यपराक्रमः ।\nसाक्षाद् विष्णोश्चतुर्भागः सर्वैः समुदितो गुणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000018014, "chapter_id": 9018, "verse_number": "१-१८-१४", "content_sanskrit": "अथ लक्ष्मणशत्रुघ्नौ सुमित्राजनयत् सुतौ ।\nवीरौ सर्वास्त्रकुशलौ विष्णोरर्धसमन्वितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000018015, "chapter_id": 9018, "verse_number": "१-१८-१५", "content_sanskrit": "पुष्ये जातस्तु भरतो मीनलग्ने प्रसन्नधीः ।\nसार्पे जातौ तु सौमित्री कुलीरेऽभ्युदिते रवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000018016, "chapter_id": 9018, "verse_number": "१-१८-१६", "content_sanskrit": "राज्ञः पुत्रा महात्मानश्चत्वारो जज्ञिरे पृथक् ।\nगुणवन्तोऽनुरूपाश्च रुच्या प्रोष्ठपदोपमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000018017, "chapter_id": 9018, "verse_number": "१-१८-१७", "content_sanskrit": "जगुः कलं च गन्धर्वा ननृतुश्चाप्सरोगणाः ।\nदेवदुन्दुभयो नेदुः पुष्पवृष्टिश्च खात् पतत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000018018, "chapter_id": 9018, "verse_number": "१-१८-१८", "content_sanskrit": "उत्सवश्च महानासीदयोध्यायां जनाकुलः ।\nरथ्याश्च जनसम्बाधा नटनर्तकसंकुलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000018019, "chapter_id": 9018, "verse_number": "१-१८-१९", "content_sanskrit": "गायनैश्च विराविण्यो वादनैश्च तथापरैः ।\nविरेजुर्विपुलास्तत्र सर्वरत्नसमन्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000018020, "chapter_id": 9018, "verse_number": "१-१८-२०", "content_sanskrit": "प्रदेयांश्च ददौ राजा सूतमागधवन्दिनाम् ।\nब्राह्मणेभ्यो ददौ वित्तम् गोधनानि सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000018021, "chapter_id": 9018, "verse_number": "१-१८-२१", "content_sanskrit": "अतीत्यैकादशाहं तु नामकर्म तथाकरोत् ।\nज्येष्ठं रामं महात्मानं भरतं कैकयीसुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000018022, "chapter_id": 9018, "verse_number": "१-१८-२२", "content_sanskrit": "सौमित्रिं लक्ष्मणमिति शत्रुघ्नमपरं तथा ।\nवसिष्ठः परमप्रीतो नामानि कुरुते तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000018023, "chapter_id": 9018, "verse_number": "१-१८-२३", "content_sanskrit": "ब्राह्मणान् भोजयामास पौराजानपदानपि ।\nअददद् ब्राह्मणानां च रत्नौघमलं बहु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000018024, "chapter_id": 9018, "verse_number": "१-१८-२४", "content_sanskrit": "तेषां जन्मक्रियादीनि सर्वकर्माण्यकारयत् ।\nतेषां केतुरिव ज्येष्ठो रामो रतिकरः पितुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000018025, "chapter_id": 9018, "verse_number": "१-१८-२५", "content_sanskrit": "बभूव भूयो भूतानां स्वयम्भूरिव सम्मतः ।\nसर्वे वेदविदः शूराः सर्वे लोकहिते रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000018026, "chapter_id": 9018, "verse_number": "१-१८-२६", "content_sanskrit": "सर्वे ज्ञानोपसम्पन्नाः सर्वे समुदिता गुणैः ।\nतेषामपि महातेजा रामः सत्यपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000018027, "chapter_id": 9018, "verse_number": "१-१८-२७", "content_sanskrit": "इष्टः सर्वस्य लोकस्य शशाङ्क इव निर्मलः ।\nगजस्कन्धेऽश्वपृष्ठे च रथचर्यासु सम्मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000018028, "chapter_id": 9018, "verse_number": "१-१८-२८", "content_sanskrit": "धनुर्वेदे च निरतः पितुः शुश्रूषणे रतः ।\nबाल्यात् प्रभृति सुस्निग्धो लक्ष्मणो लक्ष्मिवर्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000018029, "chapter_id": 9018, "verse_number": "१-१८-२९", "content_sanskrit": "रामस्य लोकरामस्य भ्रातुर्ज्येष्ठस्य नित्यशः ।\nसर्वप्रियकरस्तस्य रामस्यापि शरीरतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000018030, "chapter_id": 9018, "verse_number": "१-१८-३०", "content_sanskrit": "लक्ष्मणो लक्ष्मिसम्पन्नो बहिःप्राण इवापरः ।\nन च तेन विना निद्रां लभते पुरुषोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000018031, "chapter_id": 9018, "verse_number": "१-१८-३१", "content_sanskrit": "मृष्टमन्नमुपानीतमश्नाति न हि तं विना ।\nयदा हि हयमारूढो मृगयां याति राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000018032, "chapter_id": 9018, "verse_number": "१-१८-३२", "content_sanskrit": "अथैनं पृष्ठतोऽभ्येति सधनुः परिपालयन् ।\nभरतस्यापि शत्रुघ्नो लक्ष्मणावरजो हि सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000018033, "chapter_id": 9018, "verse_number": "१-१८-३३", "content_sanskrit": "प्राणैः प्रियतरो नित्यं तस्य चासीत् तथा प्रियः ।\nस चतुर्भिर्महाभागैः पुत्रैर्दशरथः प्रियैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000018034, "chapter_id": 9018, "verse_number": "१-१८-३४", "content_sanskrit": "बभूव परमप्रीतो देवैरिव पितामहः ।\nते यदा ज्ञानसंपन्नाः सर्वे समुदिता गुणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000018035, "chapter_id": 9018, "verse_number": "१-१८-३५", "content_sanskrit": "ह्रीमन्तः कीर्तिमन्तश्च सर्वज्ञा दीर्घदर्शिनः ।\nतेषामेवंप्रभावाणां सर्वेषां दीप्ततेजसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000018036, "chapter_id": 9018, "verse_number": "१-१८-३६", "content_sanskrit": "पिता दशरथो हृष्टो ब्रह्मा लोकाधिपो यथा ।\nते चापि मनुजव्याघ्रा वैदिकाध्ययने रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000018037, "chapter_id": 9018, "verse_number": "१-१८-३७", "content_sanskrit": "पितृशुश्रूषणरता धनुर्वेदे च निष्ठिताः ।\nअथ राजा दशरथस्तेषां दारक्रियां प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000018038, "chapter_id": 9018, "verse_number": "१-१८-३८", "content_sanskrit": "चिन्तयामास धर्मात्मा सोपाध्यायः सबान्धवः ।\nतस्य चिन्तयमानस्य मन्त्रिमध्ये महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000018039, "chapter_id": 9018, "verse_number": "१-१८-३९", "content_sanskrit": "अभ्यागच्छन्महातेजो विश्वामित्रो महामुनिः ।\nस राज्ञो दर्शनाकाङ्क्षी द्वाराध्यक्षानुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000018040, "chapter_id": 9018, "verse_number": "१-१८-४०", "content_sanskrit": "शीघ्रमाख्यात मां प्राप्तं कौशिकं गाधिनः सुतम् ।\nतच्छ्रुत्वा वचनं तस्य राज्ञो वेश्म प्रदुद्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000018041, "chapter_id": 9018, "verse_number": "१-१८-४१", "content_sanskrit": "संभ्रान्तमनसः सर्वे तेन वाक्येन चोदिताः ।\nते गत्वा राजभवनं विश्वामित्रमृषिं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000018042, "chapter_id": 9018, "verse_number": "१-१८-४२", "content_sanskrit": "प्राप्तमावेदयामासुर्नृपायेक्ष्वाकवे तदा ।\nतेषां तद्वचनं श्रुत्वा सपुरोधाः समाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000018043, "chapter_id": 9018, "verse_number": "१-१८-४३", "content_sanskrit": "प्रत्युज्जगाम संहृष्टो ब्रह्माणमिव वासवः ।\nस दृष्ट्वा ज्वलितं दीप्त्या तापसं संशितव्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000018044, "chapter_id": 9018, "verse_number": "१-१८-४४", "content_sanskrit": "प्रहृष्टवदनो राजा ततोऽर्घ्यमुपहारयत् ।\nस राज्ञः प्रतिगृह्यार्घ्यं शास्त्रदृष्टेन कर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000018045, "chapter_id": 9018, "verse_number": "१-१८-४५", "content_sanskrit": "कुशलं चाव्ययं चैव पर्यपृच्छन्नराधिपम् ।\nपुरे कोशे जनपदे बान्धवेषु सुहृत्सु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000018046, "chapter_id": 9018, "verse_number": "१-१८-४६", "content_sanskrit": "कुशलं कौशिको राज्ञः पर्यपृच्छत् सुधार्मिकः ।\nअपि ते संनताः सर्वे सामन्तरिपवो जिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000018047, "chapter_id": 9018, "verse_number": "१-१८-४७", "content_sanskrit": "दैवं च मानुषं चैव कर्म ते साध्वनुष्ठितम् ।\nवसिष्ठं च समागम्य कुशलं मुनिपुङ्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000018048, "chapter_id": 9018, "verse_number": "१-१८-४८", "content_sanskrit": "ऋषींश्च तान् यथान्यायं महाभाग उवाच ह ।\nते सर्वे हृष्टमनसस्तस्य राज्ञो निवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000018049, "chapter_id": 9018, "verse_number": "१-१८-४९", "content_sanskrit": "विविशुः पूजितास्तेन निषेदुश्च यथार्हतः ।\nअथ हृष्टमना राजा विश्वामित्रं महामुनिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000018050, "chapter_id": 9018, "verse_number": "१-१८-५०", "content_sanskrit": "उवाच परमोदारो हृष्टस्तमभिपूजयन् ।\nयथामृतस्य सम्प्राप्तिर्यथा वर्षमनूदके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000018051, "chapter_id": 9018, "verse_number": "१-१८-५१", "content_sanskrit": "यथा सदृशदारेषु पुत्रजन्माप्रजस्य वै ।\nप्रणष्टस्य यथा लाभो यथा हर्षो महोदयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000018052, "chapter_id": 9018, "verse_number": "१-१८-५२", "content_sanskrit": "तथैवागमनं मन्ये स्वागतं ते महामुने ।\nकं च ते परमं कामं करोमि किमु हर्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000018053, "chapter_id": 9018, "verse_number": "१-१८-५३", "content_sanskrit": "पात्रभूतोऽसि मे विप्र दिष्ट्या प्राप्तोऽसि मानद ।\nअद्य मे सफलं जन्म जीवितं च सुजीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000018054, "chapter_id": 9018, "verse_number": "१-१८-५४", "content_sanskrit": "यस्माद् विप्रेन्द्रमद्राक्षं सुप्रभाता निशा मम ।\nपूर्वं राजर्षिशब्देन तपसा द्योतितप्रभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000018055, "chapter_id": 9018, "verse_number": "१-१८-५५", "content_sanskrit": "ब्रह्मर्षित्वमनुप्राप्तः पूज्योऽसि बहुधा मया ।\nतदद्भुतमभूद् विप्र पवित्रं परमं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000018056, "chapter_id": 9018, "verse_number": "१-१८-५६", "content_sanskrit": "शुभक्षेत्रगतश्चाहं तव संदर्शनात् प्रभो ।\nब्रूहि यत् प्रार्थितं तुभ्यं कार्यमागमनं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000018057, "chapter_id": 9018, "verse_number": "१-१८-५७", "content_sanskrit": "इच्छाम्यनुगृहीतोऽहं त्वदर्थं परिवृद्धये ।\nकार्यस्य न विमर्शं च गन्तुमर्हसि सुव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000018058, "chapter_id": 9018, "verse_number": "१-१८-५८", "content_sanskrit": "कर्ता चाहमशेषेण दैवतं हि भवान् मम ।\nमम च अयमनुप्राप्तो महानभ्युदयो द्विज ।\nतवागमनजः कृत्स्नो धर्मश्चानुत्तमो द्विज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000018059, "chapter_id": 9018, "verse_number": "१-१८-५९", "content_sanskrit": "इति हृदयसुखं निशम्य वाक्यं\n:::श्रुतिसुखमात्मवता विनीतमुक्तम् ।\nप्रथितगुणयशा गुणैर्विशिष्टः\n:::परमऋषिः परमं जगाम हर्षम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000018060, "chapter_id": 9018, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे अष्टादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]