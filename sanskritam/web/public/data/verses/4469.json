[{"id": 2159919, "chapter_id": 4469, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2159920, "chapter_id": 4469, "verse_number": "१", "content_sanskrit": "धार्तराष्ट्रस्य तं मन्त्रं स्मरन्नेव धनञ्जयः ।\nप्रतिज्ञामात्मनो रक्षन् मुमोहाचिन्त्यविक्रमः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2159921, "chapter_id": 4469, "verse_number": "२", "content_sanskrit": "तं तु शोकेन सन्तप्तं स्वप्ने कपिवरध्वजम् ।\nआससाद महातेजा ज्वलन् वै गरुडध्वजः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2159922, "chapter_id": 4469, "verse_number": "३", "content_sanskrit": "प्रत्युत्थानं तु कृष्णस्य सर्वावस्थासु फल्गुनः ।\nन लोपयति धर्मात्मा भक्त्या प्रेम्णा च नित्यशः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2159923, "chapter_id": 4469, "verse_number": "४", "content_sanskrit": "प्रत्युत्थाय स गोविन्दं स्वं तस्मै चासनं ददौ ।\nनासने च तथा बुद्धिं बीभत्सुर्व्यदधात् स्वयम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2159924, "chapter_id": 4469, "verse_number": "५", "content_sanskrit": "ततः कृष्णो महातेजा जानँल्लोकस्य निश्चयम् ।\nकुन्तीपुत्रमिदं वाक्यमासीनः स्थितमब्रवीत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2159925, "chapter_id": 4469, "verse_number": "६", "content_sanskrit": "मा विषादे मनः पार्थ कृथाः कालो हि दुर्जयः ।\nकालः सर्वाणि भूतानि नियच्छति भवाभवे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2159926, "chapter_id": 4469, "verse_number": "७", "content_sanskrit": "किमर्थं च विषादस्ते तद् ब्रूहि द्विपदां वर ।\nन शोच्यं विदुषां श्रेष्ठ शोकः कार्यविनाशनः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2159927, "chapter_id": 4469, "verse_number": "८", "content_sanskrit": "शोचन् नन्दयते शत्रून् कर्शयत्यपि बान्धवान् ।\nयस्तु कार्यो भवेत् कार्यः कर्मणा तत् समाचर ।\nहीनचेष्टस्य यः शोकः स हि शत्रुर्धनञ्जय॥\nक्षीयते च नरस्तस्मान्न त्वं शोचितुमर्हसि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2159928, "chapter_id": 4469, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2159929, "chapter_id": 4469, "verse_number": "९", "content_sanskrit": "तथोक्तो वासुदेवेन बीभत्सुरपराजितः ।\nबभाषे हि तदा विद्वान् इदं वचनमर्थवत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2159930, "chapter_id": 4469, "verse_number": "१०", "content_sanskrit": "मया प्रतिज्ञा महती जयद्रथवधे कृता ।\nश्वो हन्तास्मि दुरात्मानं पुत्रघ्नमिति केशव\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2159931, "chapter_id": 4469, "verse_number": "११", "content_sanskrit": "मत्प्रतिज्ञाविघातार्थं धार्तराष्ट्रैः किलाच्युत ।\nपृष्ठतः सैन्धवः कार्यः सर्वैर्गुप्तो महारथैः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2159932, "chapter_id": 4469, "verse_number": "१२", "content_sanskrit": "दश चैका तथा कृष्ण अक्षोहिण्यः सुदुर्जयाः ।\nहतावशेषास्तत्रेमा दशमाश्चैव सङ्ख्यया \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2159933, "chapter_id": 4469, "verse_number": "१३", "content_sanskrit": "ताभिः परिवृतः सङ्खे सर्वैश्चैव महारथैः॥\nकथं शक्येत सन्द्रष्टुं दुरात्मा कृष्ण सैन्धवः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2159934, "chapter_id": 4469, "verse_number": "१४", "content_sanskrit": "प्रतिज्ञापारणं चापि न भविष्यति केशव॥\nप्रतिज्ञायां च हीनायां कथं जीवेत मद्विधः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2159935, "chapter_id": 4469, "verse_number": "१५", "content_sanskrit": "दुःखापायस्य मे वीर विकाङ्क्षा परिवर्तते ।\nद्रुतं च याति सविता तत एतद् ब्रवीम्यहम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2159936, "chapter_id": 4469, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2159937, "chapter_id": 4469, "verse_number": "१६", "content_sanskrit": "शोकस्थानं तु तद् बुद्ध्वा पार्थस्य द्विजकेतनः ।\nसंस्पृश्याम्भस्ततः कृष्णः प्राङ्मुखः समवस्थितः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2159938, "chapter_id": 4469, "verse_number": "१७", "content_sanskrit": "इदं वाक्यं महातेजा बभाषे पुष्करेक्षणः ।\nहितार्थं पाण्डुपुत्रस्य सैन्धवस्य वधे धृतः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2159939, "chapter_id": 4469, "verse_number": "१८", "content_sanskrit": "पार्थ पाशुपतं नाम महास्त्रं तत् सनातनम् ।\nयेन दैत्या मृधे सर्वे निहताः शूलपाणिना\nयदि तद् विदितं तेऽद्य श्वो हन्तासि जयद्रथम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2159940, "chapter_id": 4469, "verse_number": "१९", "content_sanskrit": "अथ ज्ञातुं प्रपद्यस्व मनसा वृषभध्वजम् ।\nतं देवं मनसा ध्यायन् जोषमास्स्व धनञ्जय\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2159941, "chapter_id": 4469, "verse_number": "२०", "content_sanskrit": "ततस्तस्य प्रसादात् त्वं भक्त्या प्राप्स्यसि तन्महत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2159942, "chapter_id": 4469, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2159943, "chapter_id": 4469, "verse_number": "२१", "content_sanskrit": "ततः कृष्णवचः श्रुत्वा संस्पृश्याम्भो धनञ्जयः ।\nभूमावासीत् समापन्नो जगाम मनसा शिवम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2159944, "chapter_id": 4469, "verse_number": "२२", "content_sanskrit": "ततः प्रणिहिते ब्राह्मे मुहूर्ते शुभलक्षणे ।\nआत्मानमर्जुनोऽपश्यद् गगने सहकेशवम्\nज्योतिर्भिश्च समाकीर्णं सिद्धगन्धर्वसेवितम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2159945, "chapter_id": 4469, "verse_number": "२३", "content_sanskrit": "वायुवेगगतिः पार्थः खं भेजे सहमाधवः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2159946, "chapter_id": 4469, "verse_number": "२४", "content_sanskrit": "केशवेन गृहीतः स दक्षिणे विभुना भुजे ।\nप्रेक्षमाणो बहून् भावान् जगामाद्भुतदर्शनान्\nउदीच्यां दिशि धर्मात्मा सोऽपश्यच्छ्वेतपर्वतम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2159947, "chapter_id": 4469, "verse_number": "२५", "content_sanskrit": "कुबेरस्य विहारं च नळिनीं पद्मभूषिताम् ।\nसरिच्छ्रेष्ठां च तां गङ्गां वीक्षमाणो बहूदकाम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2159948, "chapter_id": 4469, "verse_number": "२६", "content_sanskrit": "सदा पुष्पफलैर्वृक्षैरुपेतां स्फटिकोदकाम् ।\nसिंहव्याघ्रसमाकीर्णां नानामृगगणाकुलाम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2159949, "chapter_id": 4469, "verse_number": "२७", "content_sanskrit": "पुण्याश्रमवतीं रम्यां मनोज्ञां द्विजशोभिताम् ।\nमन्दरस्य प्रदेशांश्च किन्नरोद्गीतनादितान्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2159950, "chapter_id": 4469, "verse_number": "२८", "content_sanskrit": "हेमरूप्यमयैः शृङ्गैर्नानौषधिविभूषितान् ।\nतथा मन्दारवृक्षैश्च पुष्पितैरुपशोभितान्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2159951, "chapter_id": 4469, "verse_number": "२९", "content_sanskrit": "स्निग्धाञ्जनचयाकारं सम्प्राप्तः काळपर्वतम् ।\nपुण्यं हिमवतः पादं मणिमन्तं च पर्वतम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2159952, "chapter_id": 4469, "verse_number": "३०", "content_sanskrit": "ब्रह्मतुङ्गनदीं चान्यां नानाजनपदानपि ।\nसुशृङ्गं शतशृङ्गं च शय्यानागं तथैव च\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2159953, "chapter_id": 4469, "verse_number": "३१", "content_sanskrit": "पुण्यमश्वशिरःस्थानं स्थानमाथर्वणस्य च ।\nपृषदंशं च शैलेन्द्रं महामन्दरमेव च\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2159954, "chapter_id": 4469, "verse_number": "३२", "content_sanskrit": "अप्सरोभिः समाकीर्णं किन्नरैश्चोपशोभितम् ।\nतांश्च शैलान् व्रजन् पार्थः प्रेक्षते सहकेशवः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2159955, "chapter_id": 4469, "verse_number": "३३", "content_sanskrit": "शुभैः प्रस्रवणैर्जुष्टां हेमधातुविभूषिताम् ।\nचन्द्ररश्मिपरीताङ्गीं पृथिवीं पुरमालिनीम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2159956, "chapter_id": 4469, "verse_number": "३४", "content_sanskrit": "समुद्रांश्चाद्भुताकारान् पश्यन् सुबहुलाद्भुतान् ।\nवियद् द्यां पृथिवीं चैव पश्यन् विष्णुपदे व्रजन्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2159957, "chapter_id": 4469, "verse_number": "३५", "content_sanskrit": "विस्मितः सह कृष्णेन क्षिप्तो बाण इवात्यगात्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2159958, "chapter_id": 4469, "verse_number": "३६", "content_sanskrit": "ग्रहनक्षत्रसोमानां सूर्याग्न्योश्च समत्विषम् ।\nअपश्यत तदा पार्थो ज्वलन्तमिव पर्वतम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2159959, "chapter_id": 4469, "verse_number": "३७", "content_sanskrit": "समापन्नस्तु तं देशं शैलाग्रे समवस्थितम् ।\nतपोनित्यं महात्मानमपश्यद् वानरध्वजः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2159960, "chapter_id": 4469, "verse_number": "३८", "content_sanskrit": "सहस्रमिव सूर्याणां दीप्यमानं स्वतेजसा ।\nशूलिनं जटिलं शीर्णवल्कलाजिनवाससम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2159961, "chapter_id": 4469, "verse_number": "३९", "content_sanskrit": "नयनानां सहस्रैश्च विचित्राङ्गं महौजसम् ।\nपार्वत्या सहितं देवं भूतसङ्घैश्च भास्वरम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2159962, "chapter_id": 4469, "verse_number": "४०", "content_sanskrit": "गीतवादित्रसंवादैः ताळनर्तनलासितैः ।\nवल्गितास्फोटितोत्क्रुष्टैः पुण्यैर्गन्धैश्च सेवितम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2159963, "chapter_id": 4469, "verse_number": "४१", "content_sanskrit": "स्तूयमानं स्तवैर्दिव्यै ऋषिभिर्ब्रह्मवादिभिः ।\nगोप्तारं सर्वभूतानामिष्वासवरमच्युतम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2159964, "chapter_id": 4469, "verse_number": "४२", "content_sanskrit": "वासुदेवस्तु तं दृष्ट्वा जगाम शिरसा क्षितिम् ।\nपार्थेन सह धर्मात्मा गृणन् ब्रह्म सनातनम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2159965, "chapter_id": 4469, "verse_number": "४३", "content_sanskrit": "लोकादिं विश्वकर्माणमजमीशानमव्ययम् ।\nतमसः परमं ज्योतिः खं वायुर्ज्योतिषां गतिम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2159966, "chapter_id": 4469, "verse_number": "४४", "content_sanskrit": "स्रष्टारं वारिधाराणां भुवश्च प्रकृतिं पराम् ।\nदेवदानवयक्षाणां मनुष्याणां च सादनम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2159967, "chapter_id": 4469, "verse_number": "४५", "content_sanskrit": "योगिनां परमं ब्रह्म व्यक्तं ब्रह्मविदां निधिम् ।\nपरावरस्य स्रष्टारं प्रतिहर्तारमेव च\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2159968, "chapter_id": 4469, "verse_number": "४६", "content_sanskrit": "कालकोपं महात्मानं शक्रसूर्यगुणोदयम् ।\nववन्दतुस्तदा कृष्णौ वाङ्मनोबुद्धिकर्मभिः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2159969, "chapter_id": 4469, "verse_number": "४७", "content_sanskrit": "यं प्रपश्यन्ति विद्वांसः सूक्ष्माध्यात्मनिदर्शनात् ।\nतमजं कारणात्मानं जग्मतुः शरणं भवम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2159970, "chapter_id": 4469, "verse_number": "४८", "content_sanskrit": "अर्जुनश्चापि तं देवं भूयो भूयोऽप्यवन्दत॥\nज्ञात्वैकं सर्वलोकादिं भूतभव्यभवत्प्रभुम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2159971, "chapter_id": 4469, "verse_number": "४९", "content_sanskrit": "शरण्यं शरणं देवमीशानं परमेश्वरम् ।\nजगाम जगतां नाथमर्जुनः सजनार्दनः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2159972, "chapter_id": 4469, "verse_number": "५०", "content_sanskrit": "ततस्तावागतौ दृष्ट्वा नरनारायणावुभौ ।\nसुप्रसन्नमनाः शर्व उवाच प्रहसन्निव\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2159973, "chapter_id": 4469, "verse_number": "५१", "content_sanskrit": "स्वागतं वां नरश्रेष्ठौ विक्लवं च न तिष्ठताम् ।\nकिञ्च वामीप्सितं वीरौ मनसा क्षिप्रमुच्यताम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2159974, "chapter_id": 4469, "verse_number": "५२", "content_sanskrit": "केन कार्येण सम्प्राप्तौ युवां तत्साधने रतौ ।\nव्रियतामात्मनः श्रेयः तत् सर्वं च ददानि वाम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2159975, "chapter_id": 4469, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2159976, "chapter_id": 4469, "verse_number": "५३", "content_sanskrit": "ततस्तद् वचनं श्रुत्वा प्रत्युत्थाय कृताञ्जली ।\nवासुदेवार्जुनौ शर्वं तुष्टुवाते महामती\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2159977, "chapter_id": 4469, "verse_number": "५४", "content_sanskrit": "नमो भवाय शर्वाय रुद्राय वरदाय च ।\nपशूनां पतये नित्यम् उग्राय च कपर्दिने\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2159978, "chapter_id": 4469, "verse_number": "५५", "content_sanskrit": "कुमारगुरवे नित्यं नीलग्रीवाय वेधसे ।\nविलोहिताय धूम्राय व्यालयज्ञोपवीतिने \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2159979, "chapter_id": 4469, "verse_number": "५६", "content_sanskrit": "महादेवाय भीमाय त्र्यम्बकाय शिवाय च ।\nईशानाय मखघ्नाय नमोऽस्त्वन्धकघातिने\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2159980, "chapter_id": 4469, "verse_number": "५७", "content_sanskrit": "नित्यं नीलशिखण्डाय शूलिने दैत्यघातिने ।\nहन्त्रे गोप्त्रे त्रिनेत्राय व्याधाय वसुरेतसे\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2159981, "chapter_id": 4469, "verse_number": "५८", "content_sanskrit": "अचिन्त्यायाम्बिकाभर्त्रे सर्वदेवस्तुताय च ।\nवृषध्वजाय मुण्डाय जटिने ब्रह्मचारिणे\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2159982, "chapter_id": 4469, "verse_number": "५९", "content_sanskrit": "तपसे तप्यमानाय ब्रह्मण्यायाजिताय च ।\nविश्वात्मने विश्वसृजे विश्वमावृत्य तिष्ठते\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2159983, "chapter_id": 4469, "verse_number": "६०", "content_sanskrit": "नमो नमस्ते व्यासाय भूतानां प्रभवे सदा ।\nअभिगम्याय काम्याय स्तुत्यायार्याय सर्वदा\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2159984, "chapter_id": 4469, "verse_number": "६१", "content_sanskrit": "ब्रह्मवक्त्राय कान्ताय शङ्कराय शिवाय च ।\nनमोऽस्तु वाचस्पतये प्रजानां पतये नमः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2159985, "chapter_id": 4469, "verse_number": "६२", "content_sanskrit": "नमो विश्वस्य पतये महतां पतये नमः ।\nनमः सहस्रशिरसे सहस्रभुजमन्यवे\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2159986, "chapter_id": 4469, "verse_number": "६३", "content_sanskrit": "सहस्रनेत्रपादाय नमोऽसङ्ख्येयकर्मणे ।\nनमो हिरण्यगर्भाय हिरण्यकवचाय च\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2159987, "chapter_id": 4469, "verse_number": "६४", "content_sanskrit": "नमोऽस्तु देवदेवाय महाभूतधराय च ।\nभक्तानुकम्पिने नित्यं सिद्ध्यतां नो वरः प्रभो\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2159988, "chapter_id": 4469, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2159989, "chapter_id": 4469, "verse_number": "६५", "content_sanskrit": "एवं स्तुत्वा महादेवं वासुदेवः सहार्जुनः ।\nप्रसादयामास भवं तदा ह्यस्त्रोपलब्धये॥\nअर्जुनाय ददौ बुद्धिं तस्मिन्नस्त्रे यदीप्सितम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2159990, "chapter_id": 4469, "verse_number": "६६", "content_sanskrit": "ततः पार्थः प्रसन्नात्मा प्राञ्जलिर्वृषभध्वजम् ।\nददर्शोत्फुल्लनयनः समस्तं तेजसां निधिम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2159991, "chapter_id": 4469, "verse_number": "६७", "content_sanskrit": "तं चोपहारं स्वकृतं नैशं नैत्यकमात्मनः ।\nददर्श त्र्यम्बकाभ्याशे वासुदेवे निवेदितम्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2159992, "chapter_id": 4469, "verse_number": "६८", "content_sanskrit": "ततोऽभिपूज्य मनसा कृष्णं शर्वं च पाण्डवः ।\nइच्छाम्यहं दिव्यमस्त्रमित्यभाषत शङ्करम्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2159993, "chapter_id": 4469, "verse_number": "७०", "content_sanskrit": "ततः पार्थस्य विज्ञाय वरार्थं वचनं विभुः ।\nवासुदेवार्जुनौ देवः स्मयमानोऽभ्यभाषत\t॥६९॥\nस्वागतं वां नरश्रेष्ठौ विज्ञातं मनसेप्सितम् ।\nयेन कामेन सम्प्राप्तौ भवद्भ्यां तं ददाम्यहम्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2159994, "chapter_id": 4469, "verse_number": "७१", "content_sanskrit": "सरोऽमृतमयं दिव्यमभ्याशे शत्रुसूदनौ ।\nतत्र मे तद्धनुर्दिव्यं शराश्च निहिताः पुरा\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2159995, "chapter_id": 4469, "verse_number": "७२", "content_sanskrit": "येन देवारयः सर्वे मया युधि निपातिताः ।\nयुवामेतद् द्वयं कृष्णौ तदिहानयत द्रुतम्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2159996, "chapter_id": 4469, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2159997, "chapter_id": 4469, "verse_number": "७३", "content_sanskrit": "तथेत्युक्त्वा तु तौ वीरौ शर्वं पारिषदैः सह ।\nप्रस्थितौ तत् सरो दिव्यं दिव्याश्चर्यशतायुतम्\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2159998, "chapter_id": 4469, "verse_number": "७४", "content_sanskrit": "निर्दिष्टं यद् वृषाङ्केण पुण्यं सर्वार्थसाधकम् ।\nतज्जग्मतुरसम्भ्रान्तौ नरनारायणावृषी\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2159999, "chapter_id": 4469, "verse_number": "७५", "content_sanskrit": "ततस्तौ तत् सरो गत्वा सूर्यमण्डलसन्निभम् ।\nनागमन्तर्जले घोरं ददृशातेऽच्युतार्जुनौ\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2160000, "chapter_id": 4469, "verse_number": "७६", "content_sanskrit": "द्वितीयं चापरं नागं सहस्रशिरसं वरम् ।\nवमन्तं विपुलां ज्वालां ददृशातेऽग्निवर्चसम्\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2160001, "chapter_id": 4469, "verse_number": "७७", "content_sanskrit": "ततः कृष्णश्च पार्थश्च संस्पृश्याम्भः कृताञ्जली ।\nतौ नागावुपतस्थाते नमस्यन्तौ वृषध्वजम्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2160002, "chapter_id": 4469, "verse_number": "७८", "content_sanskrit": "गृणन्तौ वेदविदुषौ तद् ब्रह्म शतरुद्रियम् ।\nअप्रमेयप्रमाणं तौ गत्वा सर्वात्मना भवम्\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2160003, "chapter_id": 4469, "verse_number": "७९", "content_sanskrit": "ततस्तौ रुद्रमाहात्म्याद् हित्वा रूपं महोरगौ ।\nधनुर्बाणश्च शत्रुघ्नौ तद् द्वन्द्वं समपद्यत\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2160004, "chapter_id": 4469, "verse_number": "८०", "content_sanskrit": "ततो जगृहतुः प्रीतौ धनुर्बाणं च सुप्रभम् ।\nजग्मतुश्च महात्मानौ ददृशुश्च महात्मने\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2160005, "chapter_id": 4469, "verse_number": "८१", "content_sanskrit": "ततः पार्श्वे वृषाङ्कस्य ब्रह्मचारी व्यवर्तत ।\nपिङ्गाक्षस्तपसा श्रेष्ठो बलवान्नीललोहितः\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2160006, "chapter_id": 4469, "verse_number": "८२", "content_sanskrit": "स सङ्गृह्य धनुर्घोरं तस्थौ स्थानं समाहितः ।\nव्यपाकर्षच्च विधिवत् सशरं धनुरुत्तमम्\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2160007, "chapter_id": 4469, "verse_number": "८३", "content_sanskrit": "तस्य मौर्वीं च मुष्टिं च स्थानं चालक्ष्य पाण्डवः ।\nश्रुत्वा मन्त्रं भवप्रोक्तं जग्राहाचिन्त्यविक्रमः\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2160008, "chapter_id": 4469, "verse_number": "८४", "content_sanskrit": "स सरस्येव तं बाणं मुमोचातिबलः प्रभुः ।\nचिक्षेप च पुनर्वीरः तस्मिन् सरसि तद् धनुः\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2160009, "chapter_id": 4469, "verse_number": "८५", "content_sanskrit": "ततः प्रीतं भवं ज्ञात्वा प्रीतिमानर्जुनस्तदा ।\nवरमारण्यके दत्तं शङ्करस्य च दर्शनम्\nमनसा चिन्तयामास तन्मे सम्पद्यतां भव\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2160010, "chapter_id": 4469, "verse_number": "८६", "content_sanskrit": "तस्य तन्मतमाज्ञाय प्रीतः प्रादाद् वरं भवः \t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2160011, "chapter_id": 4469, "verse_number": "८७", "content_sanskrit": "संहृष्टरोमा दुर्धर्षः कृतं कार्यममन्यत ।\nततः पाशुपतं दिव्यमवाप्य पुनरीश्वरात्\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2160012, "chapter_id": 4469, "verse_number": "८८", "content_sanskrit": "ततोऽर्जुनहृषीकेशौ पुनः पुनररिन्दमौ ।\nववन्दतुश्च संहृष्टौ शिरोभ्यां तौ महेश्वरम्\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2160013, "chapter_id": 4469, "verse_number": "८९", "content_sanskrit": "अनुज्ञातौ क्षणे तस्मिन् भवेनार्जुनकेशवौ ।\nप्राप्तौ स्वशिबिरं वीरौ मुदा परमया युतौ\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2160014, "chapter_id": 4469, "verse_number": "९०", "content_sanskrit": "तथा भवेनानुमतौ महासुरनिपातिनौ ।\nइन्द्राविष्णू यथा प्रीतौ जम्भस्य वधकाङ्क्षिणौ\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2160015, "chapter_id": 4469, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि चतुःसप्ततितमोऽध्यायः ॥ ७४ ॥\nप्रतिज्ञापर्वणि षष्ठोऽध्यायः ॥ ६ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}]