[{"id": 2122926, "chapter_id": 3638, "verse_number": "", "content_sanskrit": "शकुनियुधिष्ठिरयोः संवादः । द्यूतनिर्धारणम् । द्यूतोपक्रमश्च ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2122927, "chapter_id": 3638, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2122928, "chapter_id": 3638, "verse_number": "१", "content_sanskrit": "वीराः प्रविश्य तां पार्था युधिष्ठिरपुरोगमाः ।\nसमेत्य पार्थिवान् सर्वान् यथार्हमभिपूज्य च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2122929, "chapter_id": 3638, "verse_number": "२", "content_sanskrit": "यथावयः समीयाना उपविष्टा यथार्हतः ।\nआसनेषु विचित्रेषु स्वच्छास्तरणवत्सु च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2122930, "chapter_id": 3638, "verse_number": "३", "content_sanskrit": "अथ तेषु प्रविष्टेषु सर्वेषु च नृपेषु च ।\nशकुनिः सौबलस्तत्र युधिष्ठिरमभाषत ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2122931, "chapter_id": 3638, "verse_number": "४", "content_sanskrit": "उपस्तीर्णा सभा राजन् वयं चैव कृतक्षणाः ।\nअक्षानुप्त्वा देवनस्य समयोऽस्तु युधिष्ठिर ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2122932, "chapter_id": 3638, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2122933, "chapter_id": 3638, "verse_number": "५", "content_sanskrit": "निकृत्या देवनं पापं न क्षात्रोऽत्र पराक्रमः ।\nन च नीतिर्ध्रुवं राजन् किं त्वं द्यूतं प्रशंससि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2122934, "chapter_id": 3638, "verse_number": "६", "content_sanskrit": "नच मायां प्रशंसन्ति कृतिनः कितवस्य ह ।\nशकुने मैव नो जैषीरमार्गेण नृशंसवत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2122935, "chapter_id": 3638, "verse_number": "", "content_sanskrit": "शकुनिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2122936, "chapter_id": 3638, "verse_number": "७", "content_sanskrit": "योऽन्वेति सङ्ख्यां निकृतौ विधिज्ञः\nचेष्टास्वखिन्नं कितवोऽक्षजासु ।\nमहामतिर्योऽनुजानाति द्यूतं\nस वै सर्वं सहते प्रक्रियासु ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2122937, "chapter_id": 3638, "verse_number": "८", "content_sanskrit": "अक्षग्रहः सोऽभिभवेत् परं तु\nतेनैव कालो भवतीदमात्थ ।\nदीव्यावहे पार्थिव मा विशङ्कां\nकुरुष्व पाणं चिरं च मा कृथाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2122938, "chapter_id": 3638, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2122939, "chapter_id": 3638, "verse_number": "९", "content_sanskrit": "एवमाहायमसितो देवलो मुनिसत्तमः ।\nइमानि शोकद्वाराणि यो वै सञ्चरते सदा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2122940, "chapter_id": 3638, "verse_number": "१०", "content_sanskrit": "इदं वै देवनं पापं मायया कितवैः सह ।\nधर्मेण तु जयो युद्धे तत् परं न तु देवनम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2122941, "chapter_id": 3638, "verse_number": "११", "content_sanskrit": "नार्या नेच्छन्ति भाषाभिर्मायया न चरन्त्युत ।\nअजिह्ममशठं युद्धमेतत् सत्पुरुषव्रतम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2122942, "chapter_id": 3638, "verse_number": "१२", "content_sanskrit": "शक्तितो ब्राह्मणार्थाय शिक्षितुं प्रयतामहे ।\nतद्वै विद्वान् माऽतिदेवीर्मा जैषीः शकुने परम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2122943, "chapter_id": 3638, "verse_number": "१३", "content_sanskrit": "नाहं निकृत्या कामेयं सुखान्युत धनानि वा ।\nकिं तवास्याद्य निकृतेर्वित्तमेतेन युज्यते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2122944, "chapter_id": 3638, "verse_number": "", "content_sanskrit": "शकुनिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2122945, "chapter_id": 3638, "verse_number": "१४", "content_sanskrit": "श्रोत्रियोऽश्रोत्रियसुतं निकृत्यैव युधिष्ठिर ।\nविद्वानविदुषोऽभ्येति नाहुस्तां निकृतिं जनाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2122946, "chapter_id": 3638, "verse_number": "१५", "content_sanskrit": "अक्षैर्हि शिक्षितोऽभ्येति निकृत्यैव युधिष्ठिर ।\nअकृतास्त्रं कृतास्त्रश्च दुर्बलं बलवत्तरः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2122947, "chapter_id": 3638, "verse_number": "१६", "content_sanskrit": "एवं त्वं मामिहाभ्येत्य निकृतिं यदि मन्यसे ।\nदेवनाद् विनिवर्तस्व यदि ते विद्यते भयम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2122948, "chapter_id": 3638, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2122949, "chapter_id": 3638, "verse_number": "१७", "content_sanskrit": "आहूतो न निवर्तेयमिति मे व्रतमाहितम् ।\nविधिश्च बलवान् राजन् दिष्टस्यास्मि वशे स्थितः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2122950, "chapter_id": 3638, "verse_number": "१८", "content_sanskrit": "अस्मिन् समागमे केन देवनं नौ भविष्यति ।\nप्रतिपाणश्च को न्यस्तस्ततो द्यूतं प्रवर्तताम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2122951, "chapter_id": 3638, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2122952, "chapter_id": 3638, "verse_number": "१९", "content_sanskrit": "अहं दातास्मि रत्नानां धनानां च विशाम्पते ।\nमदर्थे देविता चायं शकुनिर्मातुलो मम ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2122953, "chapter_id": 3638, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2122954, "chapter_id": 3638, "verse_number": "२०", "content_sanskrit": "अन्येनान्यस्य विषमं देवनं प्रतिभाति मे ।\nएतद्विद्वान्नु(?)पादत्स्व काममेवं प्रवर्तताम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2122955, "chapter_id": 3638, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2122956, "chapter_id": 3638, "verse_number": "२१", "content_sanskrit": "प्रवर्तमाने द्यूते तु राजानं सर्वपार्थिवाः ।\nधृतराष्ट्रं पुरस्कृत्य विविशुस्तां सभां ततः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2122957, "chapter_id": 3638, "verse_number": "२२", "content_sanskrit": "भीष्मो द्रोणः कृपश्चैव विदुरश्च महामतिः ।\nनातीव प्रीतमनसस्तेऽन्ववर्तन्त भारत ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2122958, "chapter_id": 3638, "verse_number": "२३", "content_sanskrit": "ते द्वन्द्वशः पृथक् चैव सिंहस्कन्धा महौजसः ।\nसिंहासनानि भूरीणि विचित्राणि च भेजिरे ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2122959, "chapter_id": 3638, "verse_number": "२४", "content_sanskrit": "शुशुभे सा सभा राजन् राजभिस्तैः समागतैः ।\nदेवैरिव महाभागैः समुदीर्णं त्रिविष्टपम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2122960, "chapter_id": 3638, "verse_number": "२५", "content_sanskrit": "सर्वे वेदविदः शूराः सर्वे भास्वरमूर्तयः ।\nप्रावर्तत महाराज सुहृद्द्यूतमनन्तरम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2122961, "chapter_id": 3638, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2122962, "chapter_id": 3638, "verse_number": "२६", "content_sanskrit": "अयं बहुधनो राजन् सागरावर्तसन्निभः ।\nमणिहारोत्तमः श्रीमान् कनकोत्तमभूषणः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2122963, "chapter_id": 3638, "verse_number": "२७", "content_sanskrit": "एतद्राजधनं मह्यं प्रतिपाणोऽत्र कस्तव ।\nयेन मां त्वं महाराज धनेन प्रतिदीव्यसे ।\nभवत्वेष क्रमस्तावज्जयाम्येनं दुरोदरम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2122964, "chapter_id": 3638, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2122965, "chapter_id": 3638, "verse_number": "२८", "content_sanskrit": "सन्ति मे मणयश्चैव धनानि विविधानि च ।\nमत्सरश्च न मेऽर्थेषु जयामैतद् दुरोदरम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2122966, "chapter_id": 3638, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2122967, "chapter_id": 3638, "verse_number": "२९", "content_sanskrit": "एतच्छ्रुत्वा तु शकुनिः निकृतिं तामुपाश्रितः ।\nततो जग्राह शकुनिस्तानक्षानक्षतत्त्ववित् ।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2122968, "chapter_id": 3638, "verse_number": "१२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां सभापर्वणि\nअशीतितमोऽध्यायः ॥८०॥ ॥ द्यूतपर्वणि द्वादशोऽध्यायः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]