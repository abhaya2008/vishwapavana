[{"id": 7001650000, "chapter_id": 21650, "verse_number": "१-३६-१", "content_sanskrit": "सनक उवाच ।\nवेदमालेः सुतौ प्रोक्तौ यावुभौ मुनिसत्तम ।\nयज्ञमाली सुमाली च तयोः कर्माधुनोच्यत ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001650001, "chapter_id": 21650, "verse_number": "१-३६-२", "content_sanskrit": "तयोराद्यो यज्ञमाली विभेद पितृसंचितम् ।\nधनं द्विधा कनिष्टस्य भागमेकं ददौ तदा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001650002, "chapter_id": 21650, "verse_number": "१-३६-३", "content_sanskrit": "सुमाली च धनं सर्वं व्यसनाभिरकतः सदा ।\nअपादाना दिभिश्चैव नाशयामास भो द्विज ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001650003, "chapter_id": 21650, "verse_number": "१-३६-४", "content_sanskrit": "गीतवाद्यरतो नित्यं मद्यपानरतोऽभवत् ।\nवेश्याविभ्रमलुब्धोऽसौ परदारतोऽभवत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001650004, "chapter_id": 21650, "verse_number": "१-३६-५", "content_sanskrit": "सर्वस्मिन्नाशमायाते हिरण्ये पितृसंचिते ।\nअपहृत्य परं द्रव्यं वारस्त्रीनिरतोऽभवत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001650005, "chapter_id": 21650, "verse_number": "१-३६-६", "content_sanskrit": "दृष्ट्वा सुमालिनः शूलं यज्ञमाली महामतिः ।\nबभूव दुःखितोऽत्यर्थं भ्रातरं चदमब्रवीत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001650006, "chapter_id": 21650, "verse_number": "१-३६-७", "content_sanskrit": "अलममत्यंतकष्टेन वृत्तेनास्मत्कुलेऽनुज ।\nत्वमेक एव दुष्टात्मा महापापरतोऽभवः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001650007, "chapter_id": 21650, "verse_number": "१-३६-८", "content_sanskrit": "एवं निवारयंतं तं बहुशो ज्येष्टसोदरम् ।\nहनिष्यामीति निश्चित्य खङ्गहस्तः कचेऽग्रहीत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001650008, "chapter_id": 21650, "verse_number": "१-३६-९", "content_sanskrit": "ततो महारवो जज्ञे नगरे भृशदारुणः ।\nबबंधुर्नागराश्चैनं कुपितास्ते सुमालिनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001650009, "chapter_id": 21650, "verse_number": "१-३६-१०", "content_sanskrit": "यज्ञमाली ह्यमेयात्मा पौरान्संप्रार्थ्य दुःखितः ।\nबंधनान्मोचयामास भ्रातृस्नेहविमोहितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001650010, "chapter_id": 21650, "verse_number": "१-३६-११", "content_sanskrit": "यज्ञमाली पुनस्चापि बिभिदे स्वधनं द्विधा ।\nआददे स्वयमर्द्धं च ददावर्द्धं यवीयसे ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001650011, "chapter_id": 21650, "verse_number": "१-३६-१२", "content_sanskrit": "सुमाली त्वतिमूढात्मा तद्धनं चापि नारद ।\nमूर्खैः पारंवडचंडालैर्बुभुजे च सहोद्धतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001650012, "chapter_id": 21650, "verse_number": "१-३६-१३", "content_sanskrit": "असतामुपभो गाय दुर्जनानां विभूतयः ।\nपिचुमंदः फलाढ्योऽपि काकैरेवोपभुज्यते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001650013, "chapter_id": 21650, "verse_number": "१-३६-१४", "content_sanskrit": "भ्रात्रा दत्तं धनं तञ्च सुमाली नाशयन्मुने ।\nमद्यपानप्रमत्तश्च गोमांसा दीन्यभक्षयत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001650014, "chapter_id": 21650, "verse_number": "१-३६-१५", "content_sanskrit": "त्यक्तो बंधुजनैः सर्वैश्चांडालस्त्रीसमन्वितः ।\nराज्ञापि बाधितो विप्रप्रपेदे निर्जनं वनम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001650015, "chapter_id": 21650, "verse_number": "१-३६-१६", "content_sanskrit": "यज्ञमाली सुधीर्विप्र सदा धर्मरतोऽभवेत् ।\nअवारितं ददावन्नं सत्सङ्गगतकल्मषः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001650016, "chapter_id": 21650, "verse_number": "१-३६-१७", "content_sanskrit": "पित्रा कृतानि सर्वाणि तडागादीनि सत्तम ।\nअपालयत्प्रयत्नेन सदा धर्मपरायणः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001650017, "chapter_id": 21650, "verse_number": "१-३६-१८", "content_sanskrit": "विश्राणितं धनं सर्वं यज्ञमालेर्महात्मनः ।\nसत्पात्रदाननिष्टस्य धर्ममार्गप्रवर्तिनः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001650018, "chapter_id": 21650, "verse_number": "१-३६-१९", "content_sanskrit": "अहो सदुपभोगाय सज्जनानां विभूतयः ।\nकल्पवृक्षफलं सर्वममरैरेव भुज्यते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001650019, "chapter_id": 21650, "verse_number": "१-३६-२०", "content_sanskrit": "धनं विश्राण्य धर्मार्थं यज्ञमाली महामतिः ।\nनित्यं विष्णुगृहे सम्यक्परिचर्य्यापरोऽभवत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001650020, "chapter_id": 21650, "verse_number": "१-३६-२१", "content_sanskrit": "कालेन गच्छता तौ तु वृद्धभावमुपागतौ ।\nयज्ञमाली सुमाली च ह्येककाले मृतावुभौ ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001650021, "chapter_id": 21650, "verse_number": "१-३६-२२", "content_sanskrit": "हरिपूजारतस्यास्य यज्ञमालिमहात्मनः ।\nहरिः संप्रेषयामास विमानं पार्षदा वृतम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001650022, "chapter_id": 21650, "verse_number": "१-३६-२३", "content_sanskrit": "दिव्यं विमानमारुह्य यज्ञमाली महामतिः ।\nपूज्यमानः सुरगणैः स्तूयमानो मुनीश्वरैः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001650023, "chapter_id": 21650, "verse_number": "१-३६-२४", "content_sanskrit": "गंधर्वैर्गीयमानश्च सेवितश्चाप्सरोगणैः ।\nकामधेन्वा पुष्यमाणश्चित्राभरणभूषितः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001650024, "chapter_id": 21650, "verse_number": "१-३६-२५", "content_sanskrit": "कोमलैस्तुलसीमाल्यैर्भूषितस्तेजसां निधिः ।\nगच्छन्विष्णुपदं दिव्यंमनुजं पथि दृष्टवान् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001650025, "chapter_id": 21650, "verse_number": "१-३६-२६", "content_sanskrit": "ताह्यमानं यमभटैः क्षुत्तृड्भ्यां परिपीडितम् ।\nप्रेतभूतं विवस्त्रं च दुःखितं पाशवेष्टितम् ।\nइतस्ततः प्राधावन्तं विलपंतमनाथवत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001650026, "chapter_id": 21650, "verse_number": "१-३६-२७", "content_sanskrit": "क्रोशन्तं च सुदंतं च दृष्ट्वा मनसि विव्यथे ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001650027, "chapter_id": 21650, "verse_number": "१-३६-२८", "content_sanskrit": "यज्ञमालीदयायुक्तो विष्णुदूतान्समीपगान् ।\nकोऽयं भटैर्बाध्यमानं इत्यपृच्छत्कृतांजलिः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001650028, "chapter_id": 21650, "verse_number": "१-३६-२९", "content_sanskrit": "अथ ते हरिदूतास्तं यज्ञमालिमहौजसम् ।\nअसौ सुमाली भ्राता ते पापात्मेति समब्रुवन् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001650029, "chapter_id": 21650, "verse_number": "१-३६-३०", "content_sanskrit": "यज्ञमाली समाकर्ण्य व्याख्यातं विष्णुकिंकरैः ।\nमनसा दुःखमापन्नः पुनः पप्रच्छ नारद ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001650030, "chapter_id": 21650, "verse_number": "१-३६-३१", "content_sanskrit": "कथमस्य भवेन्मोक्षः सांचितैः पापसंचयैः ।\nतदुपायंबदध्वं मे यूयं हि ममबांधवाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001650031, "chapter_id": 21650, "verse_number": "१-३६-३२", "content_sanskrit": "सख्यं साप्तपदीनं स्यादित्याहुर्धर्मकोविदाः ।\nसतां साप्तपदी मैत्री सत्सतां त्रिपदी तथा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001650032, "chapter_id": 21650, "verse_number": "१-३६-३३", "content_sanskrit": "सत्सतामपि ये संतस्तेषां मैत्रघी पदे पदे ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001650033, "chapter_id": 21650, "verse_number": "१-३६-३४", "content_sanskrit": "तस्मान्मे बांधवा यूयं मां नेतुं समुपागताः ।\nयतोऽयं मम भ्रातापि मुच्यते तदिहोच्यताम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001650034, "chapter_id": 21650, "verse_number": "१-३६-३५", "content_sanskrit": "यज्ञमालिवचः श्रुत्वा विष्णुदूता दयालवः ।\nपुनः स्मितामुखाः प्रोचुर्यज्ञमालिहरिप्रियम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001650035, "chapter_id": 21650, "verse_number": "१-३६-३६", "content_sanskrit": "विष्णुदूता ऊचुः ।\nयज्ञमालिन्महाभाग नारायणपरायण ।\nउपायं तव वक्ष्यामः सुमालिप्रेममुक्तिदम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001650036, "chapter_id": 21650, "verse_number": "१-३६-३७", "content_sanskrit": "कृतं यत्सुमहत्कर्म त्वया प्राक्तनजन्मनि ।\nप्रवक्ष्यामः समासेन तच्छ्रणुष्व समाहितः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001650037, "chapter_id": 21650, "verse_number": "१-३६-३८", "content_sanskrit": "पुरा त्वं वैश्यजातीयो नाम्ना विश्वंघभरः स्मृतः ।\nत्वया कृतानि पापानि अहंत्यगणितानि वै ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001650038, "chapter_id": 21650, "verse_number": "१-३६-३९", "content_sanskrit": "सुकर्मवासनाहीनो मातापित्रोर्विरोधकृत् ।\nएकदा बंधुभिस्त्यक्तः शोकसंतापपीडितः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001650039, "chapter_id": 21650, "verse_number": "१-३६-४०", "content_sanskrit": "क्षुधाग्निनापि संतप्तः प्राप्तवान्हरिमंदिरम् ।\nतदा वृष्टिरभूत्तत्र तत्स्थानं पंकिलं ह्यभूत ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001650040, "chapter_id": 21650, "verse_number": "१-३६-४१", "content_sanskrit": "दीरीकृतस्त्वया पंकस्तत्स्थाने स्थातुमिच्छया ।\nउपलेपनतां प्राप्तं तत्स्थानं विष्णुमंदिरे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001650041, "chapter_id": 21650, "verse_number": "१-३६-४२", "content_sanskrit": "त्वयोषितं तु तद्गात्रौ तस्मिन्देवालये द्विज ।\nदंशितश्चैव सर्पेण प्राप्तं पञ्चत्वमेव च ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001650042, "chapter_id": 21650, "verse_number": "१-३६-४३", "content_sanskrit": "तेन पुण्यप्रभावेन उपलेपकृतेन च ।\nविप्रजन्म त्वया प्राप्तं हरि भक्तिस्तथाचला ॥४२।।॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001650043, "chapter_id": 21650, "verse_number": "१-३६-४४", "content_sanskrit": "कल्पकोटिशतं साग्रं संप्राप्य हरिसन्निधिम् ।\nवसाद्य ज्ञानमासाद्य परं मोक्षं गमिष्यसि ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001650044, "chapter_id": 21650, "verse_number": "१-३६-४५", "content_sanskrit": "अनुजं पातकिश्रेष्टं त्वं समुद्धर्त्तमिच्छसि ।\nउपायं तव वक्ष्यामस्तं निबोध महामते ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001650045, "chapter_id": 21650, "verse_number": "१-३६-४६", "content_sanskrit": "गोचर्ममात्रभूमेस्तु उपलेपनजं फलम् ।\nदत्त्वोद्धर महाभाग भ्रातरं कृपयान्वितः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001650046, "chapter_id": 21650, "verse_number": "१-३६-४७", "content_sanskrit": "एवमुक्तो विष्णुदूतैर्यज्ञमाली महापतिः ।\nतत्फलं प्रददौ तस्मै भ्रात्रे पापविमुक्तये ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001650047, "chapter_id": 21650, "verse_number": "१-३६-४८", "content_sanskrit": "सुमाली भ्रातृदत्तेन पुण्येन गतकल्मषः ।\nबभूव यमदूतास्तु तं त्यक्त्वा प्रपलायिताः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001650048, "chapter_id": 21650, "verse_number": "१-३६-४९", "content_sanskrit": "विमानं चागतं सद्यः सर्वभोगसमन्वितम् ।\nतदा सुमाली स्वर्यानमारुह्य मुमुदे मुने ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001650049, "chapter_id": 21650, "verse_number": "१-३६-५०", "content_sanskrit": "तावुभौ भ्रातरौ विप्र सुरवृंदनमस्कृतौ ।\nअवापतुर्भृशं प्रीतिं समालिंग्य परस्परम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001650050, "chapter_id": 21650, "verse_number": "१-३६-५१", "content_sanskrit": "यज्ञमाली सुमाली च स्तूयमानौ महर्षिभिः ।\nगीयमानौ च गंधर्वैर्विष्णुलोकं प्रजग्मतुः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001650051, "chapter_id": 21650, "verse_number": "१-३६-५२", "content_sanskrit": "अवाप्य हरिसालोक्यं सुमाली मुनिसत्तम ।\nयज्ञमाली चोषतुस्तौ कल्पमेकं मुदान्वितौ ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001650052, "chapter_id": 21650, "verse_number": "१-३६-५३", "content_sanskrit": "भुक्त्वा भोगान्बहूँस्तत्र यज्ञमाली महामतिः ।\nतत्रैव ज्ञानसंपन्नः परं मोक्षमुपागतः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001650053, "chapter_id": 21650, "verse_number": "१-३६-५४", "content_sanskrit": "सुमाली तु महाभागो विष्णुलोके मुदान्वितः ।\nस्थित्वा भूमिं पुनः प्राप्य विप्रत्वं समुपागतः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001650054, "chapter_id": 21650, "verse_number": "१-३६-५५", "content_sanskrit": "अतिशुद्धे कुले जातो गुणवान्वेदपारगः ।\nसर्वसंपत्समोपेतो हरिभक्तिपरायणः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001650055, "chapter_id": 21650, "verse_number": "१-३६-५६", "content_sanskrit": "व्याहरन्हरिनामानि प्रपेदे जाह्नवीतटम् ।\nतत्र स्नातश्च गंगायां दृष्ट्वा विश्वेश्वरं प्रभुम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001650056, "chapter_id": 21650, "verse_number": "१-३६-५७", "content_sanskrit": "अवाप परमं स्थानं योगिनामपि दुर्लभम् ।\nउपलेपनमाहात्म्यं कथितं ते मुनीश्वर ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001650057, "chapter_id": 21650, "verse_number": "१-३६-५८", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन संपूज्यो जगतांपतिः ।\nअकामादपि ये विष्णोः सकृत्पूजां प्रकुर्वते ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001650058, "chapter_id": 21650, "verse_number": "१-३६-५९", "content_sanskrit": "न तेषां भवबंधस्तु कदाचिदपि जायते ।\nहरिभक्तिरतान्यस्तु हरिबुद्ध्या समर्चयेत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001650059, "chapter_id": 21650, "verse_number": "१-३६-६०", "content_sanskrit": "तस्य तुष्यंति विप्रेंद्र ब्रह्मविष्णुमहेश्वराः ।\nहरिभक्तिपराणां तु संगिनां संगमात्रतः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001650060, "chapter_id": 21650, "verse_number": "१-३६-६१", "content_sanskrit": "मुच्यते सर्वपापेभ्यो महापातकवानपि ।\nहरिपूजापराणां च हरिनामरतात्मनाम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001650061, "chapter_id": 21650, "verse_number": "१-३६-६२", "content_sanskrit": "शुश्रूषानिरता यांति पापिनोऽपि परां गतिम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]