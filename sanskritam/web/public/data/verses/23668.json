[{"id": 7003668000, "chapter_id": 23668, "verse_number": "१-२-५५-१", "content_sanskrit": "सूत उवाच ।\nइति बाभ्रव्यवचनमाकर्ण्य कुरुनन्दनः ।\nप्राणमन्नारदं भक्त्या विस्मितः पुलकान्वितः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003668001, "chapter_id": 23668, "verse_number": "१-२-५५-२", "content_sanskrit": "प्रशस्य च चिरं कालं पुनर्नारदमब्रवीत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003668002, "chapter_id": 23668, "verse_number": "१-२-५५-३", "content_sanskrit": "गुप्तक्षेत्रस्य माहात्म्यं शृण्वानस्त्वन्मुखान्मुने ।\nतृप्तिं नैवाधिगच्छामि भूयस्तद्वक्तुमर्हसि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003668003, "chapter_id": 23668, "verse_number": "१-२-५५-४", "content_sanskrit": "नारद उवाच ।\nमहालिंगस्य वक्ष्यामि महिमानं कुरूद्वह ।\nगौतमेश्वर लिंगस्य सावधानः शृणुष्व तत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003668004, "chapter_id": 23668, "verse_number": "१-२-५५-५", "content_sanskrit": "अक्षपादो महायोगी गौतमाख्योऽभवन्मुनिः ।\nगोदावरीसमानेता अहल्यायाः पतिः प्रभुः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003668005, "chapter_id": 23668, "verse_number": "१-२-५५-६", "content_sanskrit": "गुप्त क्षेत्रस्य माहात्म्यं स च ज्ञात्वा महोत्तमम् ।\nयोगसंसाधनं कुर्वन्नत्र तेपे तपो महत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003668006, "chapter_id": 23668, "verse_number": "१-२-५५-७", "content_sanskrit": "योगसिद्धिं ततः प्राप्य गौतमेन महात्मना ।\nअत्र संस्थापितं लिंगं गौतमेश्वरसंज्ञया ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003668007, "chapter_id": 23668, "verse_number": "१-२-५५-८", "content_sanskrit": "संस्नाप्यैतन्महालिंगं चन्दनेन विलिप्य च ।\nसंपूज्य पुष्पैर्विविधैर्गुग्गुलं दाहयेत्पुरः ।\nसर्वपापविनिर्मुक्तो रुद्रलोके महीयते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003668008, "chapter_id": 23668, "verse_number": "१-२-५५-९", "content_sanskrit": "अर्जुन उवाच ।\nयोगस्वरूपमिच्छामि श्रोतुं नारद तत्त्वतः ।\nयोगं सर्वे प्रशंसंति यतः सर्वोत्तमोत्तमम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003668009, "chapter_id": 23668, "verse_number": "१-२-५५-१०", "content_sanskrit": "नारद उवाच ।\nसमासात्तव वक्ष्यामि योगतत्त्वं कुरूद्वह ।\nश्रवणादपि नैर्मल्यं यस्य स्यात्सेवनात्किमु ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003668010, "chapter_id": 23668, "verse_number": "१-२-५५-११", "content_sanskrit": "चित्तवृत्तिनिरोधाख्यं योगतत्त्वं प्रकीर्त्यते ।\nतदष्टांगप्रकारेण साधयंतीह योगिनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003668011, "chapter_id": 23668, "verse_number": "१-२-५५-१२", "content_sanskrit": "यमश्च नियमश्चैव प्राणायामस्तृतीयकः ।\nप्रत्याहारो धारणा च ध्येयं ध्यानं च सप्तमम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003668012, "chapter_id": 23668, "verse_number": "१-२-५५-१३", "content_sanskrit": "समाधिरिति चाष्टांगो योगः संपरिकीर्तितः ।\nप्रत्येकं लक्षणं तेषामष्टानां शृणु पांडव ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003668013, "chapter_id": 23668, "verse_number": "१-२-५५-१४", "content_sanskrit": "अनुक्रमान्नरो येषां साधनाद्योगमश्नुते ।\nअहिंसा सत्यमस्तेयं ब्रह्मचर्यापरिग्रहौ ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003668014, "chapter_id": 23668, "verse_number": "१-२-५५-१५", "content_sanskrit": "एते पंच यमाः प्रोक्ताः शृण्वेषामपि लक्षणम् ।\nआत्मवत्सर्वभूतेषु यो हिताय प्रवर्तते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003668015, "chapter_id": 23668, "verse_number": "१-२-५५-१६", "content_sanskrit": "अहिंसैषा समाख्याता वेदसंविहिता च या ।\nदृष्टं श्रुतं चानुमितं स्वानुभूतं यथार्थतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003668016, "chapter_id": 23668, "verse_number": "१-२-५५-१७", "content_sanskrit": "कथनं सत्यमित्युक्तं परपीडाविवर्जितम् ।\nअनादानं परस्वानामापद्यपि कथंचन ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003668017, "chapter_id": 23668, "verse_number": "१-२-५५-१८", "content_sanskrit": "मनसा कर्मणा वाचा तदस्तेयं प्रकीर्तितम् ।\nअमैथुनं यतीनां च मनोवाक्कायकर्मभिः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003668018, "chapter_id": 23668, "verse_number": "१-२-५५-१९", "content_sanskrit": "ऋतौ स्वदारगमनं गेहिनां ब्रह्मचर्यता ।\nयतीनां सर्वसंन्यासो मनोवाक्कायकर्मणा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003668019, "chapter_id": 23668, "verse_number": "१-२-५५-२०", "content_sanskrit": "गृहस्थानां च मनसा स्मृत एषोऽपरिग्रहः ।\nएते यमास्तव प्रोक्ताः पंचैव नियमाञ्छृणु ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003668020, "chapter_id": 23668, "verse_number": "१-२-५५-२१", "content_sanskrit": "शौचं तुष्टिस्तपश्चैव जपो भक्तिर्गुरोस्तथा ।\nएतेषामपि पंचानां पृथक्संशृणु लक्षणम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003668021, "chapter_id": 23668, "verse_number": "१-२-५५-२२", "content_sanskrit": "बाह्यमाभ्यतरं चैव द्विविधं शौचमुच्यते ।\nबाह्यं तु मृज्जलैः प्रोक्तमांतरं शुद्धमानसम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003668022, "chapter_id": 23668, "verse_number": "१-२-५५-२३", "content_sanskrit": "न्यायेनागतया वृत्त्या भिक्षया वार्तयापि च ।\nसंतोषो यस्य सततं सा तुष्टिरिति चोच्यते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003668023, "chapter_id": 23668, "verse_number": "१-२-५५-२४", "content_sanskrit": "चांद्रायणादीनि पुनस्तपांसि विहितानि च ।\nआहारलाघवपरः कुर्यात्तत्तप उच्यते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003668024, "chapter_id": 23668, "verse_number": "१-२-५५-२५", "content_sanskrit": "स्वाध्यायस्तु जपः प्रोक्तः प्रणवाभ्यसनादिकः ।\nशिवे ज्ञाने गुरौ भक्तिर्गुरुभक्तिरिति स्मृता ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003668025, "chapter_id": 23668, "verse_number": "१-२-५५-२६", "content_sanskrit": "एवं संसाध्य नियमान्संयमांश्च विचक्षणः ।\nप्राणायामाय संदध्यान्नान्यथा योगसाधकः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003668026, "chapter_id": 23668, "verse_number": "१-२-५५-२७", "content_sanskrit": "यतोऽशुचिशरीरस्य वायुकोपो महान्भवेत् ।\nवायुकोपात्कुष्ठता च जडत्वादीनुपाश्नुते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003668027, "chapter_id": 23668, "verse_number": "१-२-५५-२८", "content_sanskrit": "तस्माद्विचक्षणः शुद्धं कृत्वा देहं यतेत्परम् ।\nप्राणायामस्य वक्ष्यामि लक्षणं शृणु पांडव ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003668028, "chapter_id": 23668, "verse_number": "१-२-५५-२९", "content_sanskrit": "प्राणापाननिरोधश्च प्राणायामः प्रकीर्तितः ।\nलघुमध्योत्तरीयाख्यः स च धीरैस्त्रिधोदितः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003668029, "chapter_id": 23668, "verse_number": "१-२-५५-३०", "content_sanskrit": "लघुर्द्वादशमात्रस्तु मात्रा निमिष उन्मिषः ।\nद्विगुणो मध्यमश्चोक्तस्त्रिगुणश्चोत्तमः स्मृतः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003668030, "chapter_id": 23668, "verse_number": "१-२-५५-३१", "content_sanskrit": "प्रथमेन जयेत्स्वेदं मध्यमेन तु वेपथुम् ।\nविषादं च तृतीयेन जयेद्दोषाननुक्रमात् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003668031, "chapter_id": 23668, "verse_number": "१-२-५५-३२", "content_sanskrit": "पद्माख्यमासनं कृत्वा रेचकं पूरकं तथा ।\nकुंभकं च सुखासीनः प्राणायामं त्रिधाऽभ्यसेत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003668032, "chapter_id": 23668, "verse_number": "१-२-५५-३३", "content_sanskrit": "प्राणानामुपसंरोधात्प्राणायाम इति स्मृतः ।\nयथा पर्वतधातूनां ध्मातानां दह्यते मलः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003668033, "chapter_id": 23668, "verse_number": "१-२-५५-३४", "content_sanskrit": "तथेंद्रियवृतो दोषः प्राणायामेन दह्यते ।\nगोशतं कापिलं दत्त्वा यत्फलं तत्फलं भवेत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003668034, "chapter_id": 23668, "verse_number": "१-२-५५-३५", "content_sanskrit": "प्राणायामेन योगज्ञस्तस्मात्प्राणं सदा यमेत् ।\nप्राणायामेन सिद्ध्यन्ति दिव्याः शान्त्यादयः क्रमात् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003668035, "chapter_id": 23668, "verse_number": "१-२-५५-३६", "content_sanskrit": "शांतिः प्रशान्तिर्दीप्तिश्च प्रसादश्च यथाक्रमम्॥ स  ।\nहजागंतुकामानां पापानां च प्रवर्तताम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003668036, "chapter_id": 23668, "verse_number": "१-२-५५-३७", "content_sanskrit": "वासनाशांतिरित्याख्यः प्रथमो जायते गुणः ।\nलोभमोहात्मकान्दोषान्निराकृत्यैव कृत्स्नशः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003668037, "chapter_id": 23668, "verse_number": "१-२-५५-३८", "content_sanskrit": "तपसां च यदा प्राप्तिः सा शांतिरिति चोच्यते ।\nसर्वेन्द्रियप्रसादश्च बुद्धेर्वै मरुतामपि ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003668038, "chapter_id": 23668, "verse_number": "१-२-५५-३९", "content_sanskrit": "प्रसाद इति स प्रोक्तः प्राप्यमेवं चतुष्टयम् ।\nएवंफलं सदा योगी प्राणायामं समभ्यसेत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003668039, "chapter_id": 23668, "verse_number": "१-२-५५-४०", "content_sanskrit": "मृदुत्वं सेव्यमानास्तु सिंहशार्दूलकुंजराः ।\nयथा यान्ति तथा प्राणो वश्यो भवति साधितः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003668040, "chapter_id": 23668, "verse_number": "१-२-५५-४१", "content_sanskrit": "प्राणायामस्त्वयं प्रोक्तः प्रत्याहारं ततः शृणु ।\nविषयेषु प्रवृत्तस्य चेतसो विनिवर्तनम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003668041, "chapter_id": 23668, "verse_number": "१-२-५५-४२", "content_sanskrit": "प्रत्याहारं विनिर्दिष्टतस्य संयमनं हि यत् ।\nप्रत्याहारस्त्वयं प्रोक्तो धारणालक्षणं शृणु ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003668042, "chapter_id": 23668, "verse_number": "१-२-५५-४३", "content_sanskrit": "यथा तोयार्थिनस्तोयं पत्रनालादिभिः शनैः ।\nआपिबेयुस्तथा वायुं योगी नयति साधितम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003668043, "chapter_id": 23668, "verse_number": "१-२-५५-४४", "content_sanskrit": "प्राग्नाभ्यां हृदये वायुरथ तालौ भ्रुवोंऽतरे ।\nचतुर्दले षड्दशे च द्वादशे षोडशद्विके ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003668044, "chapter_id": 23668, "verse_number": "१-२-५५-४५", "content_sanskrit": "आकुंचनेनैव मूर्द्धमुन्नीय पवनं शनैः ।\nमूर्धनि ब्रह्मरंध्रे तं प्राणं संधारयेत्कृती ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003668045, "chapter_id": 23668, "verse_number": "१-२-५५-४६", "content_sanskrit": "प्राणायामा दश द्वौ च धारणैषा प्रकीर्त्यते ।\nदशैता धारणाः स्थाप्य प्राप्नोत्यक्षरसाम्यताम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003668046, "chapter_id": 23668, "verse_number": "१-२-५५-४७", "content_sanskrit": "धारणास्थस्य यद्ध्येयं तस्य त्वं शृणु लक्षणम् ।\nध्येयं बहुविधं पार्थ यस्यांतो नोपलभ्यते ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003668047, "chapter_id": 23668, "verse_number": "१-२-५५-४८", "content_sanskrit": "केचिच्छिवं हरिं केचित्केचित्सूर्यं विधिं परे ।\nकेचिद्देवीं महद्भूतामुत ध्यायन्ति केचन ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003668048, "chapter_id": 23668, "verse_number": "१-२-५५-४९", "content_sanskrit": "तत्र यो यच्च ध्यायेत स च तत्र प्रलीयते ।\nतस्मात्सदा शिवं देवं पंचवक्त्रं हरं स्मरेत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003668049, "chapter_id": 23668, "verse_number": "१-२-५५-५०", "content_sanskrit": "पद्मासनस्थं तं गौरं बीजपूरकरं स्थितम् ।\nदशहस्तं सुप्रसन्नवदनं ध्यानमास्थितम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003668050, "chapter_id": 23668, "verse_number": "१-२-५५-५१", "content_sanskrit": "ध्येयमेतत्तव प्रोक्तं तस्माद्ध्यानं समाचरेत् ।\nध्यानस्य लक्षणं चैतन्निमेषार्धमपि स्फुटम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003668051, "chapter_id": 23668, "verse_number": "१-२-५५-५२", "content_sanskrit": "न पृथग्जायते ध्येयाद्धारणां यः समास्थितः ।\nएवमेतां दुरारोहां भूमिमास्थाय योगवित् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003668052, "chapter_id": 23668, "verse_number": "१-२-५५-५३", "content_sanskrit": "न किंचिच्चिंतयेत्पश्चात्समाधिरिति कीर्त्यते ।\nसमाधेर्लक्षणं सम्यग्ब्रुवतो मे निशामय ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003668053, "chapter_id": 23668, "verse_number": "१-२-५५-५४", "content_sanskrit": "शब्दस्पर्शरसैर्हीनं गंधरूपविवर्जितम् ।\nपरं पुरुषं संप्राप्तः समाधिस्थः प्रकीर्तितः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003668054, "chapter_id": 23668, "verse_number": "१-२-५५-५५", "content_sanskrit": "तां तु प्राप्य नरो विघ्नैर्नाभिभूयेत कर्हिचित् ।\nसमाधिस्थश्च दुःखेन गुरुणापि न चाल्यते ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003668055, "chapter_id": 23668, "verse_number": "१-२-५५-५६", "content_sanskrit": "शंखाद्याः शतशस्तस्य वाद्यन्ते यदि कर्णयोः ।\nभेर्यश्च यदि हन्यंते शब्दं बाह्यं न विंदति ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003668056, "chapter_id": 23668, "verse_number": "१-२-५५-५७", "content_sanskrit": "कशाप्रहाराभिहतो वह्निदग्धतनुस्तथा ।\nशीताढ्येव स्थितो घोरे स्पर्शं बाह्यं न विन्दति ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003668057, "chapter_id": 23668, "verse_number": "१-२-५५-५८", "content_sanskrit": "रूपे गंधे रसे बाह्ये तादृशस्य तु का कथा ।\nदृष्ट्वा य आत्मनात्मानं समाधिं लभते पुनः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003668058, "chapter_id": 23668, "verse_number": "१-२-५५-५९", "content_sanskrit": "तृष्णा वाथ बुभुक्षा वा बाधेते तं न कर्हिचित् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003668059, "chapter_id": 23668, "verse_number": "१-२-५५-६०", "content_sanskrit": "न स्वर्गे न च पाताले मानुष्ये क्व च तत्सुखम् ।\nसमाधिं निश्चलं प्राप्य यत्सुखं विंदते नरः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003668060, "chapter_id": 23668, "verse_number": "१-२-५५-६१", "content_sanskrit": "एवमारूढयोगस्य तस्यापि कुरुनदन ।\nपंचोपसर्गाः कटुकाः प्रवर्तंते यथा शृणु ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003668061, "chapter_id": 23668, "verse_number": "१-२-५५-६२", "content_sanskrit": "प्रातिभः श्रावणो दैवो भ्रमावर्तोऽथ भीषणः ।\nप्रतिभा सर्वशास्त्राणां प्रातिभोऽयं च सात्त्विकः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003668062, "chapter_id": 23668, "verse_number": "१-२-५५-६३", "content_sanskrit": "तेन यो मदमादद्याद्योगी शीघ्रं च चेतसः ।\nयोजनानां सहस्रेभ्यः श्रवणं श्रावणस्तु सः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003668063, "chapter_id": 23668, "verse_number": "१-२-५५-६४", "content_sanskrit": "द्वितीयः सात्विकश्चायमस्मान्मत्तो विनश्यति ।\nअष्टौ पश्यति योनीश्च देवानां दैव इत्यसौ ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003668064, "chapter_id": 23668, "verse_number": "१-२-५५-६५", "content_sanskrit": "अयं च सात्त्विको दोषो मदादस्माद्विनश्यति ।\nआवर्त इव तोयस्य जनावर्ते यदाकुलः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003668065, "chapter_id": 23668, "verse_number": "१-२-५५-६६", "content_sanskrit": "आवर्ताख्यस्त्वयं दोषो राजसः स महाभयः ।\nभ्राम्यते यन्निरालम्बं मनो दोषैश्च योगिनः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003668066, "chapter_id": 23668, "verse_number": "१-२-५५-६७", "content_sanskrit": "समस्ताधारविभ्रंशाद्भ्रमाख्यस्तामसो गुणः ।\nएतैर्नाशितयोगाश्च सकला देवयोनयः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003668067, "chapter_id": 23668, "verse_number": "१-२-५५-६८", "content_sanskrit": "उपसर्गैर्महाघोरैरावर्त्यंते पुनः पुनः ।\nप्रावृत्य कंबलं शुक्लं योगी तस्मान्मनोमयम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003668068, "chapter_id": 23668, "verse_number": "१-२-५५-६९", "content_sanskrit": "चिंतयेत्परमं ब्रह्म कृत्वा तत्प्रवणं मनः ।\nआहाराः सात्त्विकाश्चैव संसेव्याः सिद्धिमिच्छता ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003668069, "chapter_id": 23668, "verse_number": "१-२-५५-७०", "content_sanskrit": "राजसैस्तामसैश्चैव योगी सिद्धयेन्न कर्हिचित् ।\nश्रद्दधानेषु दांतेषु श्रोत्रियेषु महात्मसु ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003668070, "chapter_id": 23668, "verse_number": "१-२-५५-७१", "content_sanskrit": "स्वधर्मादनपेतेषु भिक्षा याच्या च योगिना ।\nभैक्षं यवान्नं तक्रं वा पयो यावकमेव वा ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003668071, "chapter_id": 23668, "verse_number": "१-२-५५-७२", "content_sanskrit": "फलमूलं विपक्वं वा कणपिण्याकसक्तवः ।\nश्रुता इत्येत आहारा योगिनां सिद्धिकारकाः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003668072, "chapter_id": 23668, "verse_number": "१-२-५५-७३", "content_sanskrit": "मृत्युकालं विदित्वा च निमित्तैर्योगसाधकः ।\nयोगं युञ्जीत कालस्य वंचनार्थं समाहितः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003668073, "chapter_id": 23668, "verse_number": "१-२-५५-७४", "content_sanskrit": "निमित्तानि च वक्ष्यामि मृत्युं यो वेत्ति योगवित् ।\nरक्तकृष्णांबरधरा गायंतीह सती च यम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003668074, "chapter_id": 23668, "verse_number": "१-२-५५-७५", "content_sanskrit": "दक्षिणाशां नयेन्नारी स्वप्ने सोऽपि न जीवति ।\nनग्नं क्षपणकं स्वप्ने हसमानं प्रदृश्य च ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003668075, "chapter_id": 23668, "verse_number": "१-२-५५-७६", "content_sanskrit": "एनं च वीक्ष्य वल्गन्तं तं विद्यान्मृत्युमागतम् ।\nऋक्षवानरयुग्यस्थो गायन्यो दक्षिणां दिशम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003668076, "chapter_id": 23668, "verse_number": "१-२-५५-७७", "content_sanskrit": "याति मज्जेदधौ पंके गोमये वा न जीवति ।\nकेशांगारैस्तथा भस्मभुजंगैर्निजलां नदीम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003668077, "chapter_id": 23668, "verse_number": "१-२-५५-७८", "content_sanskrit": "एषामन्यतमैः पूर्णां दृष्ट्वा स्वप्ने न जीवति ।\nकरालैर्विकटै रूक्षैः पुरुषैरुद्यतायुधैः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003668078, "chapter_id": 23668, "verse_number": "१-२-५५-७९", "content_sanskrit": "पाषाणैस्ताडितः स्वप्ने सद्यो मृत्युं भजेन्नरः ।\nसूर्योदये यस्य शिवा क्रोशंती याति सम्मुखम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003668079, "chapter_id": 23668, "verse_number": "१-२-५५-८०", "content_sanskrit": "विपरीतं परीतं वा स सद्यो मृत्युमृच्छति ।\nदीपाधिगंधं नो वेत्ति वमत्यग्निं तथा निशि ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003668080, "chapter_id": 23668, "verse_number": "१-२-५५-८१", "content_sanskrit": "नात्मानं परनेत्रस्थं वीक्षते न स जीवति ।\nशक्रायुधं चार्धरात्रे दिवा वा ग्रहणं तथा ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003668081, "chapter_id": 23668, "verse_number": "१-२-५५-८२", "content_sanskrit": "दृष्ट्वा मन्येत स क्षीणमात्मजीवितमाप्तवान् ।\nनासिका वक्रतामेति कर्णयोर्न्नमनोन्नती ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003668082, "chapter_id": 23668, "verse_number": "१-२-५५-८३", "content_sanskrit": "नेत्रं च वामं स्रवति यस्य तस्यायुरुद्गतम् ।\nआरक्ततामेति मुखं जिह्वा चाप्यसिता यदा ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003668083, "chapter_id": 23668, "verse_number": "१-२-५५-८४", "content_sanskrit": "तदा प्राज्ञो विजानीयादासन्नं मृत्युमात्मनः ।\nउष्ट्ररासभयानेन स्वप्ने यो याति दक्षिणाम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003668084, "chapter_id": 23668, "verse_number": "१-२-५५-८५", "content_sanskrit": "दिशं कर्णौ पिधायापि निर्घोषं शृणुयान्न च ।\nन स जीवेत्तथा स्वप्ने पति तस्य पिधीयते ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003668085, "chapter_id": 23668, "verse_number": "१-२-५५-८६", "content_sanskrit": "द्वारं न चोत्तिष्ठति च शुभ्रा दृष्टिश्च लोहिता ।\nस्वप्नेऽग्निं प्रविशेद्यश्च न च निष्क्रमते पुनः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003668086, "chapter_id": 23668, "verse_number": "१-२-५५-८७", "content_sanskrit": "जलप्रवेशादपि वा तदंतं तस्य जीवितम् ।\nयश्चाभिहन्यते दुष्टैर्भूतै रात्रावथो दिवा ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003668087, "chapter_id": 23668, "verse_number": "१-२-५५-८८", "content_sanskrit": "प्रकृतैर्विकृतैर्वापि तस्यासन्नौ यमांतकौ ।\nदेवतानां गुरूणां च पित्रोर्ज्ञानविदां तथा ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003668088, "chapter_id": 23668, "verse_number": "१-२-५५-८९", "content_sanskrit": "निन्दामवज्ञां कुरुते भक्तो भूत्वा न जीवति ।\nएवं दृष्ट्वा निमित्तानि विपरीतानि योगवित् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003668089, "chapter_id": 23668, "verse_number": "१-२-५५-९०", "content_sanskrit": "धारणां सम्यगास्थाय समाधावचलो भवेत् ।\nयदि नेच्छति ते मृत्युं ततो नासौ प्रपद्यते ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003668090, "chapter_id": 23668, "verse_number": "१-२-५५-९१", "content_sanskrit": "विमुक्तिमथवा वांछेद्विसृजेद्ब्रह्ममूर्धनि ।\nसंति देहे विमुक्ते च उपसर्गाश्च ये पुनः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003668091, "chapter_id": 23668, "verse_number": "१-२-५५-९२", "content_sanskrit": "योगिनं समुपायांति शृणु तानपि पांडव ।\nऐशान्ये राक्षसपुरे यक्षो गन्धर्व एव च ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003668092, "chapter_id": 23668, "verse_number": "१-२-५५-९३", "content_sanskrit": "ऐन्द्रे सौम्ये प्रजापत्ये ब्राह्मे चाष्टसु सिद्धयः ।\nभवंति चाष्टौ शृणु ताः पार्थिवी या च तैजसी ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003668093, "chapter_id": 23668, "verse_number": "१-२-५५-९४", "content_sanskrit": "वायवी व्योमात्मिका चैव मानसाहम्भवा मतिः ।\nप्रत्येकमष्टधा भिन्ना द्विगुणा द्विगुणा क्रमात ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003668094, "chapter_id": 23668, "verse_number": "१-२-५५-९५", "content_sanskrit": "पूर्वे चाष्टौ चतुःषष्टिरन्ते शृणुष्व तद्यथा ।\nस्थूलता ह्रस्वता बाल्यं वार्धक्यं योवनं तथा ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003668095, "chapter_id": 23668, "verse_number": "१-२-५५-९६", "content_sanskrit": "नानाजाति स्वरूपं च चतुर्भिर्देहधारणम् ।\nपार्थिवांशं विना नित्यमष्टौ पार्थिवसिद्धयः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003668096, "chapter_id": 23668, "verse_number": "१-२-५५-९७", "content_sanskrit": "विजिते पृथिवीतत्त्वे यदैशान्ये भवन्ति च ।\nभूमाविव जले वासो नातुरोऽर्णवमापिबेत् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003668097, "chapter_id": 23668, "verse_number": "१-२-५५-९८", "content_sanskrit": "सर्वत्र जलप्राप्तिश्च अपि शुष्कं द्रवं फलम् ।\nत्रिभिर्देहस्य धरणं नदीर्वा स्थापयेत्करे ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003668098, "chapter_id": 23668, "verse_number": "१-२-५५-९९", "content_sanskrit": "अव्रणत्वं शरीरस्य कांतिश्चाथाष्टकं स्मृतम् ।\nअष्टौ पूर्वा इमाश्चाष्टौ राक्षसानां पुरे स्मृताः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003668099, "chapter_id": 23668, "verse_number": "१-२-५५-१००", "content_sanskrit": "देहादग्निविनिर्माणं तत्तापभयवर्जनम् ।\nशक्तिदत्वं च लोकानां जलमध्येग्निज्वालनम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003668100, "chapter_id": 23668, "verse_number": "१-२-५५-१०१", "content_sanskrit": "अग्निग्रहश्च हस्तेन स्मृतिमात्रेण पावनम् ।\nभस्मीभूतस्य निर्माणं द्वाभ्यां देहस्य धारणम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003668101, "chapter_id": 23668, "verse_number": "१-२-५५-१०२", "content_sanskrit": "पूर्वाः षोडश चाप्यष्टौ तेजसो यक्षसद्मनि ।\nमनोगतित्वं भूतानामन्तर्निवेशनं तथा ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003668102, "chapter_id": 23668, "verse_number": "१-२-५५-१०३", "content_sanskrit": "पर्वतादिमहाभारवहनं लीलयैव च ।\nलघुत्वं गौरवत्वं च पाणिभ्यां वायुवारणम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003668103, "chapter_id": 23668, "verse_number": "१-२-५५-१०४", "content_sanskrit": "अंगुल्यग्रनिपातेन भूमेः सर्वत्र कम्पनम् ।\nएकेन देहनिष्पत्तिर्गांधर्वे वांति सिद्धयः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003668104, "chapter_id": 23668, "verse_number": "१-२-५५-१०५", "content_sanskrit": "चतुर्विंशतिः पूर्वाश्चाप्यष्टावेताश्च सिद्धयः ।\nगन्धर्वलोके द्वात्रिंशदत ऊर्ध्वं निशामय ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003668105, "chapter_id": 23668, "verse_number": "१-२-५५-१०६", "content_sanskrit": "छायाविहीननिष्पत्तिरिंद्रियाणामदर्शनम् ।\nआकाशगमनं नित्यमिंद्रियादिशमः स्वयम् ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003668106, "chapter_id": 23668, "verse_number": "१-२-५५-१०७", "content_sanskrit": "दूरे च शब्दग्रहणं सर्वशब्दावगाहनम् ।\nतन्मात्रलिंगग्रहणं सर्वप्राणिनिदर्शनम् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003668107, "chapter_id": 23668, "verse_number": "१-२-५५-१०८", "content_sanskrit": "अष्टौ वातात्मिकाश्चैन्द्रे द्वात्रिंशदपि पूर्वकाः ।\nयथाकामोपलब्धिश्च यथाकामविनिर्गमः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003668108, "chapter_id": 23668, "verse_number": "१-२-५५-१०९", "content_sanskrit": "सर्वत्राभिभवश्चैव सर्वगुह्यनिदर्शनम् ।\nसंसारदर्शनं चापि मानस्योऽष्टौ च सिद्धयः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003668109, "chapter_id": 23668, "verse_number": "१-२-५५-११०", "content_sanskrit": "चत्वारिंशच्च पूर्वाश्च सोमलोके स्मृतास्त्विमाः ।\nछेदनं तापनं बन्धः संसारपरिवर्तनम् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003668110, "chapter_id": 23668, "verse_number": "१-२-५५-१११", "content_sanskrit": "सर्वभूत प्रसादत्वं मृत्युकालजयस्तथा ।\nअहंकारोद्भवश्चाष्टौ प्राजापत्ये च पूर्विकाः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003668111, "chapter_id": 23668, "verse_number": "१-२-५५-११२", "content_sanskrit": "आकारेण जगत्सष्टिस्तथानुग्रह एव च ।\nप्रलयस्याधिकारं च लोकचित्रप्रवर्तनम् ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003668112, "chapter_id": 23668, "verse_number": "१-२-५५-११३", "content_sanskrit": "असादृश्यमिदं व्यक्तं निर्वाणं च पृथक्पृथक् ।\nशुभेतरस्य कर्तृत्वमष्टौ बुद्धिभवास्त्वमी ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003668113, "chapter_id": 23668, "verse_number": "१-२-५५-११४", "content_sanskrit": "षट्पंचाशत्तथा पूर्वाश्चतुःषष्टिरिमे गुणाः ।\nब्राह्मये पदे प्रवर्तंते गुह्यमेतत्तवेरितम् ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003668114, "chapter_id": 23668, "verse_number": "१-२-५५-११५", "content_sanskrit": "जीवतो देहभेदे वा सिद्ध्यश्चैतास्तु योगिनाम् ।\nसंगो नैव विधातव्यो भयात्पतनसंभवात् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003668115, "chapter_id": 23668, "verse_number": "१-२-५५-११६", "content_sanskrit": "एतान्गुणान्निराकृत्य युञ्जतो योगिनस्तदा ।\nसिद्धयोऽष्टौ प्रवर्तंते योगसंसिद्धिकारकाः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003668116, "chapter_id": 23668, "verse_number": "१-२-५५-११७", "content_sanskrit": "अणिमा लघिमा चैव महिमा प्राप्तिरेव च ।\nप्राकाम्यं च तथेशित्वं वशित्वं च तथापरे ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003668117, "chapter_id": 23668, "verse_number": "१-२-५५-११८", "content_sanskrit": "यत्र कामावसायित्वं माहेश्वरपदस्थिताः ।\nसूक्ष्मात्सूक्ष्मत्वमणिमा शीघ्रत्वाल्लघिमा स्मृता ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003668118, "chapter_id": 23668, "verse_number": "१-२-५५-११९", "content_sanskrit": "महिमा शेषपूज्यत्वात्प्राप्तिर्नाप्राप्यमस्य यत् ।\nप्राकाम्यमस्य व्यापित्वादीशित्वं चेश्वरो यतः ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003668119, "chapter_id": 23668, "verse_number": "१-२-५५-१२०", "content_sanskrit": "वशित्वाद्वशिता नाम सप्तमी सिद्धिरुत्तमा ।\nयत्रेच्छा तत्र च स्थानं तत्र कामावसायिता ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003668120, "chapter_id": 23668, "verse_number": "१-२-५५-१२१", "content_sanskrit": "ऐश्वरं पदमाप्तस्य भवंत्येताश्च सिद्धयः ।\nततो न जायते नैव वर्धते न विनश्यति ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7003668121, "chapter_id": 23668, "verse_number": "१-२-५५-१२२", "content_sanskrit": "एष मुक्त इति प्रोक्तो य एवं मुक्तिमाप्नुयात् ।\nयथा जलं जलेनैक्यं निक्षिप्तमुपगच्छति ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7003668122, "chapter_id": 23668, "verse_number": "१-२-५५-१२३", "content_sanskrit": "तथैवं सात्म्यमभ्येति योगिनामात्मा परात्मना ।\nएवं ज्ञात्वा फलं योगी सदा योगं समभ्यसेत् ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7003668123, "chapter_id": 23668, "verse_number": "१-२-५५-१२४", "content_sanskrit": "अत्रोपमां व्याहरंति योगार्थं योगिनोऽ मलाः ।\nशशांकरश्मिसंयोगादर्ककांतो हुताशनम् ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7003668124, "chapter_id": 23668, "verse_number": "१-२-५५-१२५", "content_sanskrit": "समुत्सृजति नैकः सन्नुपमा सास्ति योगिनः ।\nकपिंजलाखुनकुला वसंति स्वामिव द्गृहे ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7003668125, "chapter_id": 23668, "verse_number": "१-२-५५-१२६", "content_sanskrit": "ध्वस्ते यांत्यन्यतो दुःखं न तेषां सोपमा यतेः ।\nमृद्देहकल्पदेहोऽपि मुखाग्रेण कनीयसा ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7003668126, "chapter_id": 23668, "verse_number": "१-२-५५-१२७", "content_sanskrit": "करोति मृद्भागचयमुपदेशः स योगिनः ।\nपशुपक्षिमनुष्याद्यैः पत्रपुष्पफलान्वितम् ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7003668127, "chapter_id": 23668, "verse_number": "१-२-५५-१२८", "content_sanskrit": "वृक्षं विलुप्यमानं च लब्ध्वा सिध्यंति योगिनः ।\nरुरुगात्रविषाणाग्रमालक्ष्य तिलकाकृतिम् ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7003668128, "chapter_id": 23668, "verse_number": "१-२-५५-१२९", "content_sanskrit": "सह तेन विवर्धेत योगी सिद्धिमुपाश्नुते ।\nद्रव्यं पूर्णमुपादाय पात्रमारोहते भुवः ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7003668129, "chapter_id": 23668, "verse_number": "१-२-५५-१३०", "content_sanskrit": "तुंगमार्गं विलोक्यैवं विज्ञातं कि न योगिनाम् ।\nतद्गेहं यत्र वसति तद्भोज्यं येन जीवति ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7003668130, "chapter_id": 23668, "verse_number": "१-२-५५-१३१", "content_sanskrit": "येन निष्पाद्यते चार्थः स्वयं स्याद्योगसिद्धये ।\nतथा ज्ञानमुपासीत योगी यत्कार्यसाधकम् ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7003668131, "chapter_id": 23668, "verse_number": "१-२-५५-१३२", "content_sanskrit": "ज्ञानानां बहुता येयं योगविघ्नकरी हि सा ।\nइदं ज्ञेयमिदं ज्ञेयमिति यस्तृषितश्चरेत् ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7003668132, "chapter_id": 23668, "verse_number": "१-२-५५-१३३", "content_sanskrit": "अपि कल्पसहस्रायुर्नैव ज्ञेयमवाप्नुयात् ।\nत्यक्तसंगो जितक्रोधो लब्धाहारो जितेंद्रियः ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7003668133, "chapter_id": 23668, "verse_number": "१-२-५५-१३४", "content_sanskrit": "पिधाय बुद्ध्या द्वाराणि मनो ध्याने निवेशयेत् ।\nआहारं सात्त्विकं सेवेन्न तं येन विचेतनः ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7003668134, "chapter_id": 23668, "verse_number": "१-२-५५-१३५", "content_sanskrit": "स्यादयं तं च भुंजानो रौरवस्य प्रियातिथिः ।\nवाग्दण्डः कर्मदण्डश्च मनोदंडश्च ते त्रयः ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7003668135, "chapter_id": 23668, "verse_number": "१-२-५५-१३६", "content_sanskrit": "यस्यैते नियता दंडाः स त्रिदंडी यतिः स्मृतः ।\nअनुरागं जनो याति परोक्षे गुणकीर्तनम् ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7003668136, "chapter_id": 23668, "verse_number": "१-२-५५-१३७", "content_sanskrit": "न बिभ्यति च सत्त्वानि सिद्धेर्लक्षणमुच्यते ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7003668137, "chapter_id": 23668, "verse_number": "१-२-५५-१३८", "content_sanskrit": "अलौल्यमारोग्यमनिष्ठुरत्वं गंधः शुभो मूत्रपुरीषयोश्च ।\nकांतिः प्रसादः स्वरसौम्यता च योगप्रवृत्तेः प्रथमं हि चिह्नम् ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7003668138, "chapter_id": 23668, "verse_number": "१-२-५५-१३९", "content_sanskrit": "समाहितो ब्रह्मपरोऽप्रमादी शुचिस्तथैकांतरतिर्जितेन्द्रियः ।\nसमाप्नुयाद्योगमिमं महामना विमुक्तिमाप्नोति ततश्च योगतः ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7003668139, "chapter_id": 23668, "verse_number": "१-२-५५-१४०", "content_sanskrit": "कुलं पवित्रं जननी कृतार्था वसुन्धरा भाग्यवती च तेन ।\nअवाह्यमार्गे सुखसिन्धुमग्नं लग्नं परे ब्रह्मणि यस्य चेतः ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7003668140, "chapter_id": 23668, "verse_number": "१-२-५५-१४१", "content_sanskrit": "विशुद्धबुद्धिः समलोष्टकांचनः समस्तभूतेषु वसन्समो हि यः ।\nस्थानं परं शाश्वतमव्ययं च यतिर्हि गत्वा न पुनः प्रजायते ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7003668141, "chapter_id": 23668, "verse_number": "१-२-५५-१४२", "content_sanskrit": "इदं मया योगरहस्यमुक्तमेवंविधं गौतमः प्राप योगम् ।\nतेनैतच्च स्थापितं पार्थ लिंगं संदर्शनादर्चनात्कल्मषघ्नम् ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7003668142, "chapter_id": 23668, "verse_number": "१-२-५५-१४३", "content_sanskrit": "यश्चाश्विने कृष्णचतुर्दशीदिने रात्रौ समभ्यर्चति लिंगमेतन् ।\nस्नात्वा अहल्यासरसि प्रधाने श्रद्धाय सर्वं प्रविधाय भक्तितः ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7003668143, "chapter_id": 23668, "verse_number": "१-२-५५-१४४", "content_sanskrit": "महोपकारेण विमुक्तपापः स याति यत्रास्ति स गौतमो मुनिः ॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7003668144, "chapter_id": 23668, "verse_number": "१-२-५५-१४५", "content_sanskrit": "इदं मया पार्थ तव प्रणीतं गुप्तस्य क्षेत्रस्य समासयोगात् ।\nमाहात्म्यमेतत्सकलं शृणोति यः स स्याद्विशुद्धः किमु वच्मि भूयः ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7003668145, "chapter_id": 23668, "verse_number": "१-२-५५-१४६", "content_sanskrit": "य इदं शृणुयाद्भक्त्या गौतमाख्यानमुत्तमम् ।\nपुत्रपौत्रप्रियं प्राप्य स याति पदमव्ययम् ॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7003668146, "chapter_id": 23668, "verse_number": "१-२-५५-१४७", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां प्रथमे माहेश्वरखण्डे कौमारिकाखण्डे गौतमेश्वरमाहात्म्यसविस्तरयोगलक्षणवर्णनंनाम पञ्चपंचाशत्तमोऽध्यायः ॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}]