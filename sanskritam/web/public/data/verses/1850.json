[{"id": 2038886, "chapter_id": 1850, "verse_number": "५-९५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2038887, "chapter_id": 1850, "verse_number": "५-९५-१", "content_sanskrit": "तेष्वासीनेषु सर्वेषु तूष्णींभूतेषु राजसु।\nवाक्यमभ्याददे कृष्णः सुदंष्ट्रो दुन्दुभिस्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2038888, "chapter_id": 1850, "verse_number": "५-९५-२", "content_sanskrit": "जीमूत इव धर्मान्ते सर्वां संश्रावयन्सभाम् ।\nधृतराष्ट्रमभिप्रेक्ष्य समभाषत माधवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2038889, "chapter_id": 1850, "verse_number": "५-९५-३x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2038890, "chapter_id": 1850, "verse_number": "५-९५-३", "content_sanskrit": "कुरूणां पाण्डवानां च शमः स्यादिति भारत ।\nअप्रणशेन वीराणामेतद्याचितुमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2038891, "chapter_id": 1850, "verse_number": "५-९५-४", "content_sanskrit": "राजन्नान्यत्प्रवक्तव्यं तव नैःश्रेयसं वचः ।\nविदितं ह्येव ते सर्वं वेदितव्यमरिन्दम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2038892, "chapter_id": 1850, "verse_number": "५-९५-५", "content_sanskrit": "इदं ह्यद्य कुलं श्रेष्ठं सर्वराजसु पार्थिव ।\nश्रुतवृत्तोपसंपन्नं सर्वैः समुदितं गुणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2038893, "chapter_id": 1850, "verse_number": "५-९५-६", "content_sanskrit": "कृपानुकम्पा कारुण्यमानृशंस्यं च भारत ।\nतथार्जवं क्षमा सत्यं कुरुष्वेतद्विशिष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2038894, "chapter_id": 1850, "verse_number": "५-९५-७", "content_sanskrit": "तस्मिन्नेवंविधे राजन्कुले महति तिष्ठति।\nत्वन्निमित्तं विशेषेण नेह युक्तमसांप्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2038895, "chapter_id": 1850, "verse_number": "५-९५-८", "content_sanskrit": "त्वं हि धारयिता श्रेष्ठः कुरूणां कुरुसत्तम।\nमिथ्याप्रचरतां तात बाह्येष्वाभ्यन्तरेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2038896, "chapter_id": 1850, "verse_number": "५-९५-९", "content_sanskrit": "ते पुत्रास्तव कौरव्य दुर्योधनपुरोगमाः।\nधर्मार्थौ पृष्ठतः कृत्वा प्रचरन्ति नृशंसवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2038897, "chapter_id": 1850, "verse_number": "५-९५-१०", "content_sanskrit": "अशिष्टा गतमर्यादा लोभेन हृतचेतसः।\nस्वेषु बन्धुषु मुख्येषु तद्वेत्थ पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2038898, "chapter_id": 1850, "verse_number": "५-९५-११", "content_sanskrit": "सेयमापन्महाघोरा कुरुष्वेव समुत्थिता ।\nउपेक्ष्यमाणा कौरव्य पृथिवीं घातयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2038899, "chapter_id": 1850, "verse_number": "५-९५-१२", "content_sanskrit": "शक्या चेयं शमयितुं त्वं चेदिच्छसि भारत ।\nन दुष्करो ह्यत्र शमो मतो मे भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2038900, "chapter_id": 1850, "verse_number": "५-९५-१३", "content_sanskrit": "त्वय्यधीनः शमो राजन्मयि चैव विशांपते ।\nपुत्रान्स्थापय कौरव्य स्थापयिष्याम्यहं परान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2038901, "chapter_id": 1850, "verse_number": "५-९५-१४", "content_sanskrit": "आज्ञा तव हि राजेन्द्र कार्या पुत्रैः सहान्वयैः ।\nहितं बलवदप्येषां तिष्ठतां तव शासने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2038902, "chapter_id": 1850, "verse_number": "५-९५-१५", "content_sanskrit": "तव चैव हितं राजन्पाण्डवानामथो हितम् ।\nशमे प्रयतमानस्य तव शासनकाङ्क्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2038903, "chapter_id": 1850, "verse_number": "५-९५-१६", "content_sanskrit": "स्वयं निष्फलमालक्ष्य संविधत्स्व विशांपते ।\nसहायभूता भरतास्तवैव स्युर्जनेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2038904, "chapter_id": 1850, "verse_number": "५-९५-१७", "content_sanskrit": "धर्मार्थयोस्तिष्ठ राजन्पाण्डवैरभिरक्षितः ।\nन हि शक्यास्तथाभूता यत्नादपि नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2038905, "chapter_id": 1850, "verse_number": "५-९५-१८", "content_sanskrit": "न हि त्वां पाण्डवैर्जेतुं रक्ष्यमाणं महात्मभिः ।\nइन्द्रोपि देवैः सहितः प्रसहेत कुतो नृपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2038906, "chapter_id": 1850, "verse_number": "५-९५-१९", "content_sanskrit": "यत्र भीष्मश्च द्रोणश्च कृपः कर्णो विविंशतिः ।\nअश्वत्थामा विकर्णश्च सोमदत्तोऽथ बाह्लिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2038907, "chapter_id": 1850, "verse_number": "५-९५-२०", "content_sanskrit": "सैन्धवश्च कलिङ्गश्च काम्भोजश्च सुदक्षिणः ।\nयुधिष्ठिरो भीमसेनः सव्यसाची यमौ तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2038908, "chapter_id": 1850, "verse_number": "५-९५-२१", "content_sanskrit": "सात्यकिश्च महातेजा युयुत्सुश्च महारथः ।\nको नु तान्विपरीतात्मा युद्ध्येत भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2038909, "chapter_id": 1850, "verse_number": "५-९५-२२", "content_sanskrit": "लोकस्येश्वरतां भूयः शत्रुभिश्चाप्यधृष्यताम्।\nप्राप्स्यसि त्वममित्रघ्न सहितः कुरुपाण्डवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2038910, "chapter_id": 1850, "verse_number": "५-९५-२३", "content_sanskrit": "तस्य ते पृथिवीपालास्त्वत्समाः पृथिवीपते ।\nश्रेयांसश्चैव राजानः सन्धास्यन्ते परन्तप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2038911, "chapter_id": 1850, "verse_number": "५-९५-२४", "content_sanskrit": "स त्वं पुत्रैश्च पौत्रैश्च पितृभिर्भ्रातृभिस्तथा ।\nसुहृद्भिः सर्वतो गुप्तः सुखं शक्ष्यसि जीवितुं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2038912, "chapter_id": 1850, "verse_number": "५-९५-२५", "content_sanskrit": "एतानेव पुरोधाय यत्कृत्य च यथा पुरा।\nअखिलां भोक्ष्यसे सर्वां पृथिवीं पृथिवीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2038913, "chapter_id": 1850, "verse_number": "५-९५-२६", "content_sanskrit": "एतैर्हि सहितः सर्वैः पाण्डवैः स्वैश्च भारत ।\nअन्यान्विजेष्यसे शत्रूनेष स्वार्थस्तवाखिलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2038914, "chapter_id": 1850, "verse_number": "५-९५-२७", "content_sanskrit": "तैरेवोपार्जितां भूमिं भोक्ष्यसे च परन्तप ।\nयदि संपत्स्यसे पुत्रैः सहामात्यैर्नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2038915, "chapter_id": 1850, "verse_number": "५-९५-२८", "content_sanskrit": "संयुगे वै महाराज दृश्यते सुमहान्क्षयः।\nक्षये चोभयतो राजन्कं धर्ममनुपश्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2038916, "chapter_id": 1850, "verse_number": "५-९५-२९", "content_sanskrit": "पाण्डवैर्निहतैः सङ्ख्ये पुत्रैर्वापि महाबलैः ।\nयद्विन्देथाः सुखं राजंस्तद्ब्रूहि भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2038917, "chapter_id": 1850, "verse_number": "५-९५-३०", "content_sanskrit": "शूराश्च हि कृतास्त्राश्च सर्वे युद्धाभिकाङ्क्षिणः।\nपाण्डवास्तावकाश्चैव तान्रक्ष महतो भयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2038918, "chapter_id": 1850, "verse_number": "५-९५-३१", "content_sanskrit": "न पश्येम कुरून्सर्वान्पाण्डवांश्चैव संयुगे।\nक्षीणानुभयतः शूरान्राथिनो रथिभिर्हतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2038919, "chapter_id": 1850, "verse_number": "५-९५-३२", "content_sanskrit": "समवेताः पृथिव्यां हि राजानो राजसत्तम ।\nअमर्षवशमापन्ना नाशयेयुरिमाः प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2038920, "chapter_id": 1850, "verse_number": "५-९५-३३", "content_sanskrit": "त्राहि राजन्निमं लोकं न नश्येयुरिमाः प्रजाः।\nत्वयि प्रकृतिमापन्ने शेषः स्यात्कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2038921, "chapter_id": 1850, "verse_number": "५-९५-३४", "content_sanskrit": "शुक्ला वादन्या ह्रीमन्त आर्याः पुण्याभिजातयः ॥\nअन्योन्यसचिवा राजंस्तान्पाहि महतो भयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2038922, "chapter_id": 1850, "verse_number": "५-९५-३५", "content_sanskrit": "शिवेनेमे भूमिपालाः समागम्य परस्परम्।\nसह भुक्त्वा च पीत्वा च प्रतियान्तु यथागृहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2038923, "chapter_id": 1850, "verse_number": "५-९५-३६", "content_sanskrit": "सुवाससः स्रग्विणश्च सत्कृता भरतर्षभ ।\nअमर्षं च निराकृत्य वैराणि च परन्तप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2038924, "chapter_id": 1850, "verse_number": "५-९५-३७", "content_sanskrit": "हार्दं यत्पाण्डवेष्वासीत्प्राप्तोऽस्मिन्नायुषः क्षये ।\nतदेव ते भवत्वद्य सन्धत्स्व भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2038925, "chapter_id": 1850, "verse_number": "५-९५-३८", "content_sanskrit": "बाला विहीनाः पित्रा ते त्वयैव परिवर्धिताः ।\nतान्पालय यथान्यायं पुत्रांश्च भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2038926, "chapter_id": 1850, "verse_number": "५-९५-३९", "content_sanskrit": "भवतैव हि रक्ष्यास्ते व्यसनेषु विशेषतः।\nमा ते धर्मस्तथैवार्थो नश्येत भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2038927, "chapter_id": 1850, "verse_number": "५-९५-४०", "content_sanskrit": "आहुस्त्वां पाण्डवा राजन्नभिवाद्य प्रसाद्य च।\nभवतः शासनाद्दुःखसमुभूतं सहानुगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2038928, "chapter_id": 1850, "verse_number": "५-९५-४१", "content_sanskrit": "द्वादशेमानि वर्षाणि वने निर्व्युषितानि नः।\nत्रयोदशं तथाऽज्ञातैः सजने परिवत्सरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2038929, "chapter_id": 1850, "verse_number": "५-९५-४२", "content_sanskrit": "स्थाता नः समये तस्मिन्पितेति कृतनिश्चयाः ।\nनाहास्म समयं तात तच्च नो ब्राह्मणा विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2038930, "chapter_id": 1850, "verse_number": "५-९५-४३", "content_sanskrit": "तस्मिन्नः समये तिष्ठ स्थितानां भरतर्षभ ।\nनित्यं संक्लेशिता राजन्स्वराज्यांशं लभेमहि ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2038931, "chapter_id": 1850, "verse_number": "५-९५-४४", "content_sanskrit": "त्वं धर्ममर्थं संजानन्सम्यङ्वस्त्रातुमर्हसि ॥\nगुरुत्वं भवति प्रेक्ष्य बहून्क्लेशांस्तितिक्ष्महे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2038932, "chapter_id": 1850, "verse_number": "५-९५-४५", "content_sanskrit": "स भवान्मातृपितृव्रदस्मासु प्रतिपद्यताम् ॥\nगुरोर्गरीयसी वृत्तिर्या च शिष्यस्य भारत ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2038933, "chapter_id": 1850, "verse_number": "५-९५-४६", "content_sanskrit": "वर्तामहे त्वयि च तां त्वं च वर्तस्व नस्तथा ॥\nपित्रा स्थापयितव्या हि वयमुत्पथमास्थिताः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2038934, "chapter_id": 1850, "verse_number": "५-९५-४७", "content_sanskrit": "संस्थापय पथिप्वस्मांस्तिष्ठ धर्मे सुवर्त्मनि ॥\nआहुश्चेमां परिषदं पुत्रास्ते भरतर्षभ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2038935, "chapter_id": 1850, "verse_number": "५-९५-४८", "content_sanskrit": "धर्मज्ञेषु सभासत्सु नेह युक्तमसांप्रतम् ॥\nयत्र धर्मो ह्यधर्मेण सत्यं यत्रानृतेन च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2038936, "chapter_id": 1850, "verse_number": "५-९५-४९", "content_sanskrit": "हन्यते प्रेक्षमाणानां हतास्तत्र सभासदः ॥\nविद्धो धर्मो ह्यधर्मेण सभां यत्र प्रपद्यते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2038937, "chapter_id": 1850, "verse_number": "५-९५-५०", "content_sanskrit": "नचास्य शल्यं कृन्तन्ति विद्धास्तत्र सभासदः ॥\nधर्म एतानारुजति यथा नद्यनुकूलजान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2038938, "chapter_id": 1850, "verse_number": "५-९५-५१", "content_sanskrit": "ये धर्ममनुपश्यन्तस्तूष्णीं ध्यायन्त आसते ।\nते सत्यमाहुर्धर्म्यं च न्याय्यं च भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2038939, "chapter_id": 1850, "verse_number": "५-९५-५२", "content_sanskrit": "शक्यं किमन्यद्वक्तुं ते दानादन्यञ्जनेश्वर ।\nब्रुवन्तु ते महीपालाः सभायां ये समासते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2038940, "chapter_id": 1850, "verse_number": "५-९५-५३", "content_sanskrit": "धर्मार्थौ संप्रधार्यैव यदि सत्यं ब्रवीम्यहम् ।\nप्रमुञ्चोमान्मृत्युपाशात्क्षत्रियान्पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2038941, "chapter_id": 1850, "verse_number": "५-९५-५४", "content_sanskrit": "प्रशाम्य भरतश्रेष्ठ मा मन्युवशमन्वगाः ।\nपित्र्यं तेभ्यः प्रदायांशं पाण्डवेभ्यो यथोचितम् ।\nततः सपुत्रः सिद्धार्थो भुङ्क्ष भोगान्परन्तप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2038942, "chapter_id": 1850, "verse_number": "५-९५-५५", "content_sanskrit": "अजातशत्रुं जानीषे स्थितं धर्मे सतां सदा।\nसपुत्रे त्वयि वृत्तिं च वर्तते यां नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2038943, "chapter_id": 1850, "verse_number": "५-९५-५६", "content_sanskrit": "दाहितश्च निरस्तश्च त्वामेवोपाश्रितः पुनः ।\nइन्द्रप्रस्थं त्वयैवासौ सपुत्रेण विवासितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2038944, "chapter_id": 1850, "verse_number": "५-९५-५७", "content_sanskrit": "स तत्र विवसन्सर्वान्वशमानीय पार्थिवान्।\nत्वन्मुखानकरोद्राजन्न च त्वामत्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2038945, "chapter_id": 1850, "verse_number": "५-९५-५८", "content_sanskrit": "तस्यैवं वर्तमानस्य सौबलेन जिहीर्षता।\nराष्ट्राणि धनधान्यं च प्रयुक्तः परमोपधिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2038946, "chapter_id": 1850, "verse_number": "५-९५-५९", "content_sanskrit": "स तामवस्थां संप्राप्य कृष्णां प्रेक्ष्य सभां गताम्।\nक्षत्रधर्मादमेयात्मा नाकम्पत युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2038947, "chapter_id": 1850, "verse_number": "५-९५-६०", "content_sanskrit": "अहं तु तव तेषां च श्रेय इच्छामि भारत ।\nधर्मादर्थात्सुखाच्चैव मा राजन्नीनशः प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2038948, "chapter_id": 1850, "verse_number": "५-९५-६१", "content_sanskrit": "अनर्थमर्थं मन्वानोऽप्यर्थं चानर्थमात्मनः ।\nलोभेऽतिप्रसृतान्पुत्रान्निगृह्णीष्व विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2038949, "chapter_id": 1850, "verse_number": "५-९५-६२", "content_sanskrit": "स्थिताः शुश्रूषितुं पार्थाः स्थिता योद्धुमरिन्दमाः ।\nयत्ते पथ्यतमं राजंस्तस्मिंतिष्ठ परन्तप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2038950, "chapter_id": 1850, "verse_number": "५-९५-६३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2038951, "chapter_id": 1850, "verse_number": "५-९५-६३", "content_sanskrit": "तद्वाक्यं पार्थिवाः सर्वे हृदयैः समपूजयन्।\nन तत्र कश्चिद्वक्तुं हि वाचं प्राक्रामदग्रतः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2038952, "chapter_id": 1850, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि पञ्चनवतितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]