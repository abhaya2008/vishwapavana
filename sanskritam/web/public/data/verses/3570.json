[{"id": 2119650, "chapter_id": 3570, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2119651, "chapter_id": 3570, "verse_number": "१", "content_sanskrit": "प्रायशो राजलोकास्ते कथिता वदतां वर ।\nवैवस्वतसभायां वै यथावदनुपूर्वशः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2119652, "chapter_id": 3570, "verse_number": "२", "content_sanskrit": "वरुणस्य सभायां च नागास्ते कथिता विभो ।\nदैत्येन्द्राश्चैव भूयिष्ठाः सरितः सागरास्तथा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2119653, "chapter_id": 3570, "verse_number": "३", "content_sanskrit": "तथा धनपतेर्यक्षा राक्षसा गुह्यकाश्च ये ।\nगन्धर्वाप्सरसश्चैव भगवांश्च वृषध्वजः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2119654, "chapter_id": 3570, "verse_number": "४", "content_sanskrit": "पितामहसभायां तु कथितास्ते महर्षयः ।\nसर्वे देवनिकायाश्च सर्वशास्त्राणि चैव ह\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2119655, "chapter_id": 3570, "verse_number": "५", "content_sanskrit": "शक्रस्य तु सभायां तु देवाः सङ्कीर्तिता मुने ।\nउद्देशतश्च गन्धर्वा विविधाश्च महर्षयः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2119656, "chapter_id": 3570, "verse_number": "६", "content_sanskrit": "एक एव तु राजर्षिर्हरिश्चन्द्रो महामुने ।\nकथितस्ते सभानित्यो देवेन्द्रस्य महात्मनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2119657, "chapter_id": 3570, "verse_number": "७", "content_sanskrit": "केन कर्मविपाकेन हरिश्चन्द्रो द्विजर्षभ ।\nतेषु राजसहस्रेषु प्रभयाऽप्यतिरोचते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2119658, "chapter_id": 3570, "verse_number": "८", "content_sanskrit": "किं कर्म तेनाचरितं तपो वापि व्रतोऽपि वा ।\nयेनासौ सह शक्रेण मोदते सुमहायशाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2119659, "chapter_id": 3570, "verse_number": "९", "content_sanskrit": "पितृलोकगतश्चापि त्वया विप्र पिता मम ।\nदृष्टः पाण्डुर्महाभागः कथं त्वासीत् समागमः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2119660, "chapter_id": 3570, "verse_number": "१०", "content_sanskrit": "किमुक्तवान् मा भगवन्नेतदिच्छामि वेदितुम् ।\nअनागतमतिक्रान्तं तत् सर्वं त्वयि निष्ठितम् ।\nत्वत्तः सर्वमिदं श्रोतुं परं कौतूहलं हि मे\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2119661, "chapter_id": 3570, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2119662, "chapter_id": 3570, "verse_number": "११", "content_sanskrit": "यन्मां पृच्छसि राजेन्द्र हरिश्चन्द्रं प्रति प्रभो ।\nतत् तेऽहं सम्प्रवक्ष्यामि माहात्म्यं तस्य धीमतः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2119663, "chapter_id": 3570, "verse_number": "१२", "content_sanskrit": "इक्ष्वाकूणां कुले जातस्त्रिशङ्कुर्नाम पार्थिवः ।\nअयोध्याधिपतिर्वीरो विश्वामित्रेण संस्थितः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2119664, "chapter_id": 3570, "verse_number": "१३", "content_sanskrit": "तस्य सत्यवती नाम पत्नी केकयवंशजा ।\nतस्यां गर्भः समभवद् धर्मेण कुरुनन्दन\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2119665, "chapter_id": 3570, "verse_number": "१४", "content_sanskrit": "सा च काले महाभागा जन्ममासं प्रविश्य वै ।\nकुमारं जनयामास हरिश्चन्द्रमकल्मषम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2119666, "chapter_id": 3570, "verse_number": "१५", "content_sanskrit": "स वै राजा हरिश्चन्द्रः त्रैशङ्कव इति स्मृतः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2119667, "chapter_id": 3570, "verse_number": "१६", "content_sanskrit": "स राजा बलवानासीत् सम्राट् सर्वमहीभृताम् ।\nतस्य सर्वे महीपालाः शासनावनताः स्थिताः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2119668, "chapter_id": 3570, "verse_number": "१७", "content_sanskrit": "तेनैकं रथमास्थाय जैत्रं हेमविभूषितम् ।\nशस्त्रप्रतापेन जिता द्वीपाः सप्त जनेश्वर\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2119669, "chapter_id": 3570, "verse_number": "१८", "content_sanskrit": "स विजित्य महीं सर्वां सशैलवनकाननाम् ।\nआजहार महाराज राजसूयं महाक्रतुम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2119670, "chapter_id": 3570, "verse_number": "१९", "content_sanskrit": "तस्य सर्वे महीपाला धनान्याजह्रुराज्ञया ।\nद्विजानां परिवेष्टारस्तस्मिन् यज्ञे च तेऽभवन्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2119671, "chapter_id": 3570, "verse_number": "२०", "content_sanskrit": "समाप्तयज्ञो विधिवद्धरिश्चन्द्रः प्रतापवान् ।\nअभिषिक्तश्च शुशुभे साम्राज्ये स नराधिपः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2119672, "chapter_id": 3570, "verse_number": "२१", "content_sanskrit": "राजसूयेऽभिषिक्तस्तु समाप्तवरदक्षिणः ।\nअददाद् द्रविणं प्रीत्या याचकानां युधिष्ठिर ।\nयथोक्तं च क्रतौ तस्मिंस्ततः पञ्चगुणाधिकम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2119673, "chapter_id": 3570, "verse_number": "२२", "content_sanskrit": "अतर्पयच्च वसुभिर्ब्राह्मणान् भरतर्षभ ।\nयज्ञकालेऽथ सम्प्राप्तान् नानादिग्भ्यः समागतान्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2119674, "chapter_id": 3570, "verse_number": "२३", "content_sanskrit": "भक्ष्यैर्भोज्यैश्च पानैश्च यथाकाममुदाहृतैः ।\nरत्नौघतर्पितैस्तुष्टैर्द्विजैश्च समुदाहृतः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2119675, "chapter_id": 3570, "verse_number": "२४", "content_sanskrit": "तेजस्वी च यशस्वी च सर्वेभ्योऽभ्यधिकोऽभवत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2119676, "chapter_id": 3570, "verse_number": "२५", "content_sanskrit": "एतस्मात् कारणात् पार्थ हरिश्चन्द्रो युधिष्ठिर ।\nतेषु राजसहस्रेषु प्रभयाऽप्यतिरिच्यते\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2119677, "chapter_id": 3570, "verse_number": "२६", "content_sanskrit": "ये यजन्ते महीपाला राजसूयं महाक्रतुम् ।\nसम्प्राप्तास्ते महेन्द्रेण मोदन्ते दिवि भारत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2119678, "chapter_id": 3570, "verse_number": "२७", "content_sanskrit": "ये चापि निधनं प्राप्ताः सङ्ग्रामेष्वपलायिनः ।\nते प्राप्तास्तां सभां राजन् मोदन्ते दिवि भारत\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2119679, "chapter_id": 3570, "verse_number": "२८", "content_sanskrit": "तपसा ये च घोरेण त्यक्त्वा जीर्णं कलेवरम् ।\nते तत् स्थानं समासाद्य श्रीमन्तो भान्ति नित्यशः ॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2119680, "chapter_id": 3570, "verse_number": "२९", "content_sanskrit": "पिताऽऽह त्वा च कौन्तेय पाण्डुः कौरववर्धनः ।\nहरिश्चन्द्रे श्रियं दृष्ट्वा नृपतौ जातविस्मयः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2119681, "chapter_id": 3570, "verse_number": "३०", "content_sanskrit": "समर्थोऽसि महीं जेतुं भ्रातरस्ते वशे स्थिताः ।\nराजसूयं क्रतुश्रेष्ठमाहरस्वेति भारत\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2119682, "chapter_id": 3570, "verse_number": "३१", "content_sanskrit": "त्वयीष्टवति पुत्रेऽहं हरिश्चन्द्रवदाशु वै ।\nमोदिष्ये बहुळाः शश्वत् समाः शक्रस्य संसदि\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2119683, "chapter_id": 3570, "verse_number": "३२", "content_sanskrit": "एवं भवतु वक्ष्येऽहं पुत्रं तव नराधिप ।\nभूलोकं यदि गच्छेयमिति पाण्डुमथाब्रुवम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2119684, "chapter_id": 3570, "verse_number": "३३", "content_sanskrit": "तस्य त्वं पुरुषव्याघ्र सङ्कल्पं कुरु पाण्डव ।\nगन्तारस्ते महेन्द्रस्य पूर्वे सर्वे पितामहाः ।\nसलोकतां सुरेन्द्रस्य त्रैलोक्याधिपतेर्नृप\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2119685, "chapter_id": 3570, "verse_number": "३४", "content_sanskrit": "बहुविघ्नश्च नृपते क्रतुरेष स्मृतो महान् ।\nछिद्राण्यस्य तु वाञ्छन्ति यज्ञघ्ना ब्रह्मराक्षसाः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2119686, "chapter_id": 3570, "verse_number": "३५", "content_sanskrit": "युद्धं च क्षत्रगमनं पृथिवीक्षयकारकम् ।\nकिञ्चिदेव निमित्तं तु भवत्यत्र क्षयावहम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2119687, "chapter_id": 3570, "verse_number": "३६", "content_sanskrit": "एतत् सञ्चिन्त्य राजेन्द्र यज्ञमेतं समाचर\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2119688, "chapter_id": 3570, "verse_number": "३७", "content_sanskrit": "अप्रमत्तोत्थितो नित्यं चातुर्वर्ण्यस्य रक्षणे ।\nभव एधस्व मोदस्व दानैस्तर्पय च द्विजान्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2119689, "chapter_id": 3570, "verse_number": "३८", "content_sanskrit": "एतत् ते विस्तरेणोक्तं यन्मां त्वं परिपृच्छसि ।\nआपृच्छे त्वां गमिष्यामि दाशार्हनगरं प्रति\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2119690, "chapter_id": 3570, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2119691, "chapter_id": 3570, "verse_number": "३९", "content_sanskrit": "एवमाख्याय पार्थेभ्यो नारदो जनमेजय ।\nजगाम तैर्वृतो राजन् ऋषिभिर्यैः समागतः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2119692, "chapter_id": 3570, "verse_number": "४०", "content_sanskrit": "गतेऽथ नारदे पार्थो भ्रातृभिः सह कौरव ।\nराजसूयं क्रतुश्रेष्ठं चिन्तयामास भारत\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2119693, "chapter_id": 3570, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि द्वादशोऽध्यायः ॥१२॥ ॥ मन्त्रपर्वणि द्वादशोऽध्यायः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2119694, "chapter_id": 3570, "verse_number": "", "content_sanskrit": "—— ०  ——", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]