[{"id": 2146279, "chapter_id": 4156, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2146280, "chapter_id": 4156, "verse_number": "१", "content_sanskrit": "प्रातरुत्थाय कृष्णस्तु कृतवान् सर्वमाह्निकम् ।\nब्राह्मणैरभ्यनुज्ञातः प्रययौ नगरं प्रति\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2146281, "chapter_id": 4156, "verse_number": "२", "content_sanskrit": "तं प्रयान्तं महाबाहुमनुज्ञाप्य ततो नृप ।\nपर्यवर्तन्त ते सर्वे कुशस्थलनिवासिनः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2146282, "chapter_id": 4156, "verse_number": "३", "content_sanskrit": "प्रददौ पुण्डरीकाक्षो रत्नानि च धनानि च ।\nप्रययौ पुण्डरीकाक्षः कुरूणां सदनं प्रति\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2146283, "chapter_id": 4156, "verse_number": "४", "content_sanskrit": "पन्थानमाचेमुरिव ग्रसमाना इवाम्बरम् ।\nदारुकेण प्रचुदिता हयास्तस्य महात्मनः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2146284, "chapter_id": 4156, "verse_number": "५", "content_sanskrit": "अन्नानि शय्या वासांसि तथा रत्नानि सर्वशः ।\nदुर्योधनेन कृष्णार्थं पथि सन्निहितं बहु\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2146285, "chapter_id": 4156, "verse_number": "६", "content_sanskrit": "नाभ्यनन्दन्महाबाहुरुपायात् कुरुसंसदम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2146286, "chapter_id": 4156, "verse_number": "७", "content_sanskrit": "धार्तराष्ट्रास्तमायान्तं प्रत्युज्जग्मुः स्वलङ्कृताः ।\nदुर्योधनादृते सर्वे भीष्मद्रोणकृपादयः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2146287, "chapter_id": 4156, "verse_number": "८", "content_sanskrit": "पौराश्च बहुला राजन् हृषीकेशदिदृक्षवः ।\nयानैर्बहुविधैरन्ये पद्भिरेव तथाऽपरे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2146288, "chapter_id": 4156, "verse_number": "९", "content_sanskrit": "स वै पथि समागम्य भीष्मेणाक्लिष्टकर्मणा ।\nद्रोणेन धार्तराष्ट्रैश्च तैर्वृतो नगरं ययौ\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2146289, "chapter_id": 4156, "verse_number": "१०", "content_sanskrit": "कृष्णसम्माननार्थं च नगरं समलङ्कृतम् ।\nबभूव राजमार्गश्च बहुरत्नसमाचिताः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2146290, "chapter_id": 4156, "verse_number": "११", "content_sanskrit": "न च कश्चिद् गृहे राजन् तदाऽऽसीद् भरतर्षभ ।\nन स्त्री न वृद्धो न शिशुः वासुदेवदिदृक्षया\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2146291, "chapter_id": 4156, "verse_number": "१२", "content_sanskrit": "राजमार्गे नरास्तस्मिन् सम्भवन्त्यवनिं गताः ।\nतथा समभवद् राजन् हृषीकेशप्रवेशने\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2146292, "chapter_id": 4156, "verse_number": "१३", "content_sanskrit": "आवृतानि वरस्त्रीभिः गृहाणि सुमहान्त्यपि ।\nप्रचलन्तीव भारेण तत्र तत्र महीतळे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2146293, "chapter_id": 4156, "verse_number": "१४", "content_sanskrit": "तथा च गतिमन्तस्ते वासुदेवस्य वाजिनः ।\nसुमन्दगतयोऽभूवन् राजमार्गे नरैर्वृते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2146294, "chapter_id": 4156, "verse_number": "१५", "content_sanskrit": "स गृहं धृतराष्ट्रस्य प्राविशच्छत्रुकर्शनः ।\nपाण्डरं पुण्डरीकाक्षः प्रासादैरुपशोभितम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2146295, "chapter_id": 4156, "verse_number": "१६", "content_sanskrit": "तिस्रः कक्ष्या व्यतिक्रम्य केशवो राजवेश्मनः ।\nवैचित्रवीर्यं राजानमभ्यगच्छदरिन्दमः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2146296, "chapter_id": 4156, "verse_number": "१७", "content_sanskrit": "अभ्यागच्छति दाशार्हे प्रज्ञाचक्षुर्नराधिपः ।\nसहैव द्रोणभीष्माभ्यामुदतिष्ठन् महायशाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2146297, "chapter_id": 4156, "verse_number": "१८", "content_sanskrit": "कृपश्च सोमदत्तश्च महाराजश्च बाह्लिकः ।\nआसनेभ्योऽचलन् सर्वे पूजयन्तो जनार्दनम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2146298, "chapter_id": 4156, "verse_number": "१९", "content_sanskrit": "ततो राजानमासाद्य धृतराष्ट्रं यशस्विनम् ।\nसभीष्मं पूजयामास वार्ष्णेयो वाग्भिरञ्जसा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2146299, "chapter_id": 4156, "verse_number": "२०", "content_sanskrit": "ते स्वधर्मानकुर्वन्त सम्पूज्य मधुसूदनम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2146300, "chapter_id": 4156, "verse_number": "२१", "content_sanskrit": "तेषु धर्मानुपूर्वीं तां प्रयुज्य मधुसूदनः ।\nयथावयः समीयाय राजभिः सह माधवः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2146301, "chapter_id": 4156, "verse_number": "२२", "content_sanskrit": "अथ द्रोणं सबाह्लीकं सपुत्रं च यशस्विनम् ।\nकृपं च सोमदत्तं च समीयाय जनार्दनः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2146302, "chapter_id": 4156, "verse_number": "२३", "content_sanskrit": "तत्रासीदूर्जितं मृष्टं काञ्चनं महदासनम् ।\nशासनाद् धृतराष्ट्रस्य तत्रोपाविशदच्युतः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2146303, "chapter_id": 4156, "verse_number": "२४", "content_sanskrit": "अथ गां मधुपर्कं चाप्युदकं च जनार्दने ।\nउपजह्रुर्यथान्यायं धृतराष्ट्रपुरोहिताः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2146304, "chapter_id": 4156, "verse_number": "२५", "content_sanskrit": "कृतातिथ्यस्तु गोविन्दः सर्वान् परिहसन् कुरून् ।\nआस्ते सम्बन्धकं कुर्वन् कुरुभिः परिवारितः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2146305, "chapter_id": 4156, "verse_number": "२६", "content_sanskrit": "सोऽर्चितो धृतराष्ट्रेण पूजितश्च महायशाः ।\nराजानं समनुज्ञाप्य निरक्रामदरिन्दमः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2146306, "chapter_id": 4156, "verse_number": "२७", "content_sanskrit": "तैः समेत्य यथान्यायं कुरुभिः कुरुसंसदि ।\nविदुरावसथं रम्यमुपातिष्ठत माधवः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2146307, "chapter_id": 4156, "verse_number": "२८", "content_sanskrit": "विदुरः सर्वकल्याणैरभिगम्य जनार्दनम् ।\nअर्चयामास दाशार्हं सर्वकामैरुपस्थितम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2146308, "chapter_id": 4156, "verse_number": "२९", "content_sanskrit": "कृतातिथ्यं तु गोविन्दं विदुरः सर्वधर्मवित् ।\nकुशलं पाण्डुपुत्राणां पप्रच्छ मधुसूदनम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2146309, "chapter_id": 4156, "verse_number": "३०", "content_sanskrit": "प्रीयमाणस्य सुहृदो विदुरो बुद्धिमत्तरः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2146310, "chapter_id": 4156, "verse_number": "३१", "content_sanskrit": "धर्मनित्यस्य तु सतो गतरोषस्य धीमतः ।\nतस्य सर्वं सविस्तारं पाण्डवानां विचेष्टितम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2146311, "chapter_id": 4156, "verse_number": "३२", "content_sanskrit": "क्षत्तुराचष्ट दाशार्हो यथा प्रत्यक्षदर्शिवान्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2146312, "chapter_id": 4156, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि सप्ताशीतितमोऽध्यायः ॥८७॥\nभगवद्यानपर्वणि अष्टादशोऽध्यायः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]