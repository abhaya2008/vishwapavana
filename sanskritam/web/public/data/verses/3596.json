[{"id": 2121182, "chapter_id": 3596, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2121183, "chapter_id": 3596, "verse_number": "१", "content_sanskrit": "प्रादुर्भावसहस्राणि समतीतान्यनेकशः ।\nयथाशक्ति तु वक्ष्यामि शृणु तान् कुरुनन्दन\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2121184, "chapter_id": 3596, "verse_number": "२", "content_sanskrit": "पुरा कमलनाभस्य स्वपतः सागराम्भसि ।\nपुष्करे यत्र सम्भूता देवा ऋषिगणैः सह \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2121185, "chapter_id": 3596, "verse_number": "३", "content_sanskrit": "एष पौष्करिको नाम प्रादुर्भावः प्रकीर्तितः ।\nपुराणः कथ्यते यत्र देवैः श्रुतिसमाहितः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2121186, "chapter_id": 3596, "verse_number": "४", "content_sanskrit": "वाराहस्तु श्रुतिमुखः प्रादुर्भावो महात्मनः ।\nयत्र विष्णुः सुरश्रेष्ठो वाराहं रूपमास्थितः ।\nउज्जहार महीं तोयात् सशैलवनकाननाम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2121187, "chapter_id": 3596, "verse_number": "५", "content_sanskrit": "वेदस्कन्धो यूपदंष्ट्रः क्रतुदन्तश्चितीमुखः ।\nअग्निजिह्वो दर्भरोमा ब्रह्मशीर्षो महातपाः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2121188, "chapter_id": 3596, "verse_number": "६", "content_sanskrit": "अहोरात्रेक्षणो दिव्यो वेदाङ्गः श्रुतिभूषणः ।\nआज्यनासः स्रुवतुण्डः सामघोषस्वनो महान्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2121189, "chapter_id": 3596, "verse_number": "७", "content_sanskrit": "धर्मसत्यमयः श्रीमान् कर्मविक्रमसत्कृतः ।\nप्रायश्चित्तनखो धीरः पशुजानुर्महावृषः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2121190, "chapter_id": 3596, "verse_number": "८", "content_sanskrit": "औद्गात्रहोमलिङ्गोऽसौ पशुबीजमहौषधिः ।\nबाह्यान्तरात्मा मन्त्रास्थिविकृतः सौम्यदर्शनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2121191, "chapter_id": 3596, "verse_number": "९", "content_sanskrit": "वेदिस्कन्धो हविर्गन्धो हव्यकव्यादिवेगवान् ।\nप्राग्वंशकायो द्युतिमान् नानादीक्षाभिराचितः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2121192, "chapter_id": 3596, "verse_number": "१०", "content_sanskrit": "दक्षिणाहृदयो योगी महासत्रमयो महान् ।\nउपाकर्मोष्ठरुचकः प्रवर्ग्यावर्तभूषणः ।\nजायापत्नीसहायो वै मणिशृङ्ग इवोच्छ्रितः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2121193, "chapter_id": 3596, "verse_number": "११", "content_sanskrit": "एवं यज्ञवराहो वै भूत्वा विष्णुः सनातनः ।\nमहीं सागरपर्यन्तां सशैलवनाकाननाम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2121194, "chapter_id": 3596, "verse_number": "१२", "content_sanskrit": "एकार्णवजले भ्रष्टामेकार्णवगतः प्रभुः ।\nमज्जितां सलिले तस्मिन् स्वदेवीं दयितां तदा ।\nउज्जहार विषाणेन मार्कण्डेयस्य पश्यतः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2121195, "chapter_id": 3596, "verse_number": "१३", "content_sanskrit": "शृङ्गेणेमां समुद्धृत्य लोकानां हितकाम्यया ।\nसहस्रशीर्षो देवो हि निर्ममे जगतीं प्रभुः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2121196, "chapter_id": 3596, "verse_number": "१४", "content_sanskrit": "एवं यज्ञवराहेण भूतभव्यभवात्मना ।\nउद्धृता पृथिवी देवी सागराम्बुधरा पुरा ।\nनिहता दानवाः सर्वे देवदेवेन विष्णुना\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2121197, "chapter_id": 3596, "verse_number": "१५", "content_sanskrit": "वाराहः कथितो ह्येष नारसिंहमथो शृणु ।\nयत्र भूत्वा मृगेन्द्रेण हिरण्यकशिपुर्हतः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2121198, "chapter_id": 3596, "verse_number": "१६", "content_sanskrit": "दैत्येन्दो बलवान् राजन् सुरारिर्बलगर्वितः ।\nहिरण्यकशिपुर्नाम आसीत् त्रैलोक्यकण्टकः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2121199, "chapter_id": 3596, "verse_number": "१७", "content_sanskrit": "दैत्यानामादिपुरुषो वीर्येणाप्रतिमो बली ।\nप्रविश्य स वनं राजन् चकार तप उत्तमम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2121200, "chapter_id": 3596, "verse_number": "१८", "content_sanskrit": "दशवर्षसहस्राणि शतानि दश पञ्च च ।\nजपोपवासैस्तस्यासीत् स्थाणुर्मौनव्रतोऽभवत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2121201, "chapter_id": 3596, "verse_number": "१९", "content_sanskrit": "ततो दमशमाभ्यां च ब्रह्मचर्येण चानघ ।\nब्रह्मा प्रीतमनास्तस्य तपसा नियमेन च \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2121202, "chapter_id": 3596, "verse_number": "२०", "content_sanskrit": "ततः स्वयम्भूर्भगवान् स्वयमागम्य भूपते ।\nविमानेनार्कवर्णेन हंसयुक्तेन भास्वता \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2121203, "chapter_id": 3596, "verse_number": "२१", "content_sanskrit": "आदित्यैर्वसुभिः साध्यैर्मरुद्भिर्दैवतैः सह ।\nरुद्रैर्विश्वसहायैश्च यक्षराक्षसकिन्नरैः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2121204, "chapter_id": 3596, "verse_number": "२२", "content_sanskrit": "दिशाभिर्विदिशाभिश्च नदीभिः सागरैः सह ।\nनक्षत्रैश्च मूहूर्तैश्च खेचरैश्चापरैर्ग्रहैः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2121205, "chapter_id": 3596, "verse_number": "२३", "content_sanskrit": "देवर्षिभिस्तपोयुक्तैः सिद्धैः सप्तर्षिभिस्तथा ।\nराजर्षिभिः पुण्यतमैर्गन्धर्वैरप्सरोगणैः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2121206, "chapter_id": 3596, "verse_number": "२४", "content_sanskrit": "चराचरगुरुः श्रीमान् वृतः सर्वैः सुरैस्तथा ।\nब्रह्मा ब्रह्मविदां श्रेष्ठो दैत्यमागम्य चाब्रवीत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2121207, "chapter_id": 3596, "verse_number": "२५", "content_sanskrit": "प्रीतोऽस्मि तव भक्तस्य तपसाऽनेन सुव्रत ।\nवरं वरय भद्रं ते यथेष्टं काममाप्नुहि\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2121208, "chapter_id": 3596, "verse_number": "२६", "content_sanskrit": "न देवासुरगन्धर्वा न यक्षोरगराक्षसाः ।\nन मानुषाः पिशाचाश्च हन्युर्मां देवसत्तम\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2121209, "chapter_id": 3596, "verse_number": "२७", "content_sanskrit": "ऋषयो वा न मां शापैः क्रुद्धा लोकपितामह ।\nशपेयुस्तपसा युक्ता वर एष वृतो मया\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2121210, "chapter_id": 3596, "verse_number": "२८", "content_sanskrit": "न शस्त्रेण नचास्त्रेण गिरिणा पादपेन वा ।\nन शुष्केण न चार्द्रेण स्यान्न वाऽन्येन मे वधः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2121211, "chapter_id": 3596, "verse_number": "२९", "content_sanskrit": "नाकाशे वा नवा भूमौ रात्रौ वा दिवसेऽपि वा ।\nनान्तर्वा न बहिर्वापि स्याद् वधो मे पितामह\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2121212, "chapter_id": 3596, "verse_number": "३०", "content_sanskrit": "पशुभिर्वा मृगैर्न स्यात् पक्षिभिर्वा सरीसृपैः ।\nददासि चेद् वरानेतान् देवदेव वृणोम्यहम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2121213, "chapter_id": 3596, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2121214, "chapter_id": 3596, "verse_number": "३१", "content_sanskrit": "एते दिव्या वरास्तात मया दत्तास्तवाद्भुताः ।\nसर्वकामवरांस्तात प्राप्स्यसे त्वं न संशयः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2121215, "chapter_id": 3596, "verse_number": "३२", "content_sanskrit": "एवमुक्त्वा स भगवान् जगामाकाशमेव ह ।\nरराज ब्रह्मलोकस्थो ब्रह्मर्षिगणसेवितः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2121216, "chapter_id": 3596, "verse_number": "३३", "content_sanskrit": "ततो देवाश्च नागाश्च गन्धर्वा मुनयस्तथा ।\nवरप्रदानं श्रुत्वैव ते ब्रह्माणमुपस्थिताः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2121217, "chapter_id": 3596, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2121218, "chapter_id": 3596, "verse_number": "३४", "content_sanskrit": "वरेणानेन भगवन् बाधिष्यति च नोऽसुरः ।\nतत् प्रसीदस्व भगवन् वधोऽस्य प्रविचिन्त्यताम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2121219, "chapter_id": 3596, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2121220, "chapter_id": 3596, "verse_number": "३५", "content_sanskrit": "भगवान् सर्वभूतानां स्वयम्भूरादिकृद् विभुः ।\nस्रष्टा च हव्यकव्यानामव्यक्तप्रकृतिर्ध्रुवम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2121221, "chapter_id": 3596, "verse_number": "३६", "content_sanskrit": "ततो लोकहितं वाक्यं श्रुत्वा देवः प्रजापतिः ।\nप्रोवाच भगवान् वाक्यं सर्वदेवगणांस्तदा\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2121222, "chapter_id": 3596, "verse_number": "३७", "content_sanskrit": "अवश्यं त्रिदशास्तेन प्राप्तव्यं तपसः फलम् ।\nतपसोऽन्तेऽस्य भगवान् वधं कृष्णः करिष्यति\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2121223, "chapter_id": 3596, "verse_number": "३८", "content_sanskrit": "एतच्छ्रुत्वा सुराः सर्वे ब्रह्मणा तस्य वै वधम् ।\nस्वानि स्थानानि दिव्यानि जग्मुस्ते वै मुदाऽन्विताः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2121224, "chapter_id": 3596, "verse_number": "३९", "content_sanskrit": "लब्धमात्रे वरे चापि सर्वाः सोऽबाधत प्रजाः ।\nहिरण्यकशिपुर्दैत्यो वरदानेन दर्पितः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2121225, "chapter_id": 3596, "verse_number": "४०", "content_sanskrit": "राज्यं चकार दैत्येन्द्रो दैत्यसङ्घैः समावृतः ।\nसप्त द्वीपान् वशे चक्रे लोकान् लोकान्तरान् बलात्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2121226, "chapter_id": 3596, "verse_number": "४१", "content_sanskrit": "दिव्यभोगान् समस्तान् वै लोके सर्वानवाप सः ।\nदेवांस्त्रिभुवनस्थांस्तु पराजित्य महासुरः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2121227, "chapter_id": 3596, "verse_number": "४२", "content_sanskrit": "त्रैलोक्यं वशमानीय स्वर्गे वसति दानवः ।\nयदा वरमदोन्मत्तो न्यवसद् दानवो दिवि\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2121228, "chapter_id": 3596, "verse_number": "४३", "content_sanskrit": "अथ लोकान् समस्तांश्च विजित्य स महाबलः ।\nभवेयमहमेवेन्द्रः सोमोऽग्निर्मारुतो रविः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2121229, "chapter_id": 3596, "verse_number": "४४", "content_sanskrit": "सलिलं चान्तरिक्षं च नक्षत्राणि दिशो दश ।\nअहं क्रोधश्च कामश्च वरुणो वसवो यमः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2121230, "chapter_id": 3596, "verse_number": "", "content_sanskrit": "धनदश्च धनाध्यक्षो यक्षः किम्पुरुषाधिपः ।\nएते भवेयमित्युक्त्वा स्वयं भूत्वा बलान्वितः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2121231, "chapter_id": 3596, "verse_number": "४५", "content_sanskrit": "तेषां गृहीत्वा स्थानानि तेषां कार्याण्यवाप सः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2121232, "chapter_id": 3596, "verse_number": "४६", "content_sanskrit": "एवमादीनि कर्माणि कृत्वा दैत्यपतिर्बली ।\nआश्रमेषु महाभागान् मुनीन् वै संशितव्रतान्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2121233, "chapter_id": 3596, "verse_number": "४७", "content_sanskrit": "सत्यधर्मपरान् दान्तान् पुरा धर्षितवान् स्म सः ।\nयज्ञीयान् कृतवान् दैत्यान् नयज्ञीयाश्च देवताः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2121234, "chapter_id": 3596, "verse_number": "४८", "content_sanskrit": "यत्र यत्र सुरा जग्मुः तत्र तत्र व्रजत्युत ।\nस्थानानि देवतानां तु हृत्वा राज्यमपालयत्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2121235, "chapter_id": 3596, "verse_number": "४९", "content_sanskrit": "पञ्चकोट्यश्च वर्षाणि नियुतान्येकषष्टि च ।\nषष्टिश्चैव सहस्राणां जग्मुस्तस्य दुरात्मनः ।\nएतद्वर्षं स दैत्येन्द्रो भोगैश्वर्यमवाप ह\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2121236, "chapter_id": 3596, "verse_number": "५०", "content_sanskrit": "तेनातिबाध्यमानास्ते दैत्येन्द्रेण बलीयसा ।\nब्रह्मलोकं सुरा जग्मुः सर्वे शक्रपुरोगमाः ।\nपितामहं समासाद्य खिन्नाः प्राञ्जलयोऽब्रुवन्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2121237, "chapter_id": 3596, "verse_number": "५१", "content_sanskrit": "भगवन् भूतभव्येश त्रायस्व न इहागतान् ।\nभयं दितिसुताद् घोरं भवत्यद्य दिवानिशम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2121238, "chapter_id": 3596, "verse_number": "५२", "content_sanskrit": "भगवन् सर्वभूतानां स्वयम्भूरादिकृद् विभुः ।\nस्रष्टा त्वं हव्यकव्यानामव्यक्तः प्रकृतिर्ध्रुवः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2121239, "chapter_id": 3596, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2121240, "chapter_id": 3596, "verse_number": "५३", "content_sanskrit": "श्रूयतां परमं दैवं दुर्विज्ञेयं मयाऽपि च ।\nनारायणस्तु पुरुषो विश्वरूपो महाद्युतिः \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2121241, "chapter_id": 3596, "verse_number": "५४", "content_sanskrit": "अव्यक्तः सर्वभूतानामचिन्त्यो विभुरव्ययः ।\nममापि स तु युष्माकं व्यसने परमा गतिः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2121242, "chapter_id": 3596, "verse_number": "५५", "content_sanskrit": "नारायणः परोऽव्यक्ताद् अहमव्यक्तसम्भवः ।\nमत्तो जज्ञुः प्रजा लोकाः सर्वे देवासुराश्च ते\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2121243, "chapter_id": 3596, "verse_number": "५६", "content_sanskrit": "देवा यथाऽहं युष्माकं तथा नारायणो मम ।\nपितामहोऽहं सर्वस्य स विष्णुः प्रपितामहः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2121244, "chapter_id": 3596, "verse_number": "५७", "content_sanskrit": "निश्चयं विबुधा दैत्यं विष्णुस्तं संहरिष्यति ।\nतस्य नास्ति नशक्यं च तस्माद् व्रजत मा चिरम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2121245, "chapter_id": 3596, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2121246, "chapter_id": 3596, "verse_number": "५८", "content_sanskrit": "पितामहवचः श्रुत्वा सर्वे ते भरतर्षभ ।\nविबुधा ब्रह्मणा सार्धं जग्मुः क्षीरोदधिं प्रति\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2121247, "chapter_id": 3596, "verse_number": "५९", "content_sanskrit": "आदित्या मरुतः साध्या विश्वे च वसवस्तदा ।\nरुद्रा महर्षयश्चैव अश्विनौ च सुरूपिणौ\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2121248, "chapter_id": 3596, "verse_number": "६०", "content_sanskrit": "अन्ये च दिव्या ये राजन् ते सर्वे सगणाः सुराः ।\nचतुर्मुखं पुरस्कृत्य श्वेतद्वीपमुपागताः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2121249, "chapter_id": 3596, "verse_number": "६१", "content_sanskrit": "गत्वा क्षीरसमुद्रे तं शाश्वतं परमां गतिम् ।\nअनन्तशयनं देवमनन्तादित्यतेजसम् ।\nशरण्यं त्रिदशा विष्णुमुपतस्थुः सनातनम्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2121250, "chapter_id": 3596, "verse_number": "६२", "content_sanskrit": "देवं ब्रह्ममयं यज्ञं ब्रह्मेन्द्रेशं महाबलम् ।\nभूतं भव्यं भविष्यं च प्रभुं लोकनमस्कृतम् ।\nनारायणं विभुं देवं शरण्यं शरणं गताः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2121251, "chapter_id": 3596, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2121252, "chapter_id": 3596, "verse_number": "६३", "content_sanskrit": "त्रायस्व नोऽद्य देवेश हिरण्यकशिपोर्वधात् ।\nत्वं हि नः परमो धाता ब्रह्मादीनां सुरोत्तम \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2121253, "chapter_id": 3596, "verse_number": "६४", "content_sanskrit": "प्रोत्फुल्लाम्बुजपत्राक्ष शत्रुपक्षभयङ्कर ।\nक्षयाय दितिवंशस्य शरण्यस्त्वं भविष्यसि \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2121254, "chapter_id": 3596, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2121255, "chapter_id": 3596, "verse_number": "६५", "content_sanskrit": "तद् देवानां वचः श्रुत्वा तदा विष्णुः शुचिश्रवाः ।\nअदृश्यः सर्वभूतानां वक्तुमेवोपचक्रमे\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2121256, "chapter_id": 3596, "verse_number": "६६", "content_sanskrit": "भयं त्यजध्वममरा अभयं वो ददाम्यहम् ।\nतथैव त्रिदिवं देवाः प्रतिपद्यत मा चिरम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2121257, "chapter_id": 3596, "verse_number": "६७", "content_sanskrit": "एषोऽहं सगणं दैत्यं वरदानेन दर्पितम् ।\nअवध्यममरेन्द्राणां दानवेन्द्रं निहन्म्यहम्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2121258, "chapter_id": 3596, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2121259, "chapter_id": 3596, "verse_number": "६८", "content_sanskrit": "भगवन् भूतभव्येश खिन्ना ह्येते भृशं सुराः ।\nतस्मात्त्वं जहि दैत्येन्द्रं क्षिप्रं कालोऽस्य माचिरम्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2121260, "chapter_id": 3596, "verse_number": "", "content_sanskrit": "श्रीविष्णुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2121261, "chapter_id": 3596, "verse_number": "६९", "content_sanskrit": "क्षिप्रमेव करिष्यामि त्वरया दैत्यनाशनम् ।\nतस्मात् त्वं विबुधाश्चैव प्रतिपद्यत वै दिवम्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2121262, "chapter_id": 3596, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2121263, "chapter_id": 3596, "verse_number": "७०", "content_sanskrit": "एवमुक्त्वा स भगवान् विसृज्य त्रिदिवेश्वरान् ।\nनरस्यार्धतनुं कृत्वा सिंहस्यार्धतनुं तथा\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2121264, "chapter_id": 3596, "verse_number": "७१", "content_sanskrit": "नारसिंहेन वपुषा पाणिं निष्पिष्य पाणिना ।\nभीमरूपो महातेजो व्यादितास्य इवान्तकः ।\nहिरण्यकशिपुं राजन् जगाम हरिरीश्वरः \t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2121265, "chapter_id": 3596, "verse_number": "७२", "content_sanskrit": "दैत्याः समागतं दृष्ट्वा नारसिंहं महाबलम् ।\nववर्षुः शस्त्रवर्षांश्च सुसङ्क्रुद्धास्तदा हरिम्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2121266, "chapter_id": 3596, "verse_number": "७३", "content_sanskrit": "तैः सृष्टान् सर्वशस्त्राणि भक्षयामास वै हरिः ।\nजघान च रणे दैत्यान् सहस्राणि बहून्यपि\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2121267, "chapter_id": 3596, "verse_number": "७४", "content_sanskrit": "तान् निहत्यैव दैतेयान् सर्वान् क्रुद्धान् महाबलान् ।\nअभ्यधावत् सुसङ्क्रुद्धो दैत्येन्द्रं बलगर्वितम्\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2121268, "chapter_id": 3596, "verse_number": "७५", "content_sanskrit": "जीमूतघनसङ्काशो जीमूतघननिस्वनः ।\nजीमूत इव दीप्ताक्षो जीमूत इव वेगवान् ।\nदेवारिर्दितिजो दुष्टो नृसिंहं समुपाद्रवत्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2121269, "chapter_id": 3596, "verse_number": "७६", "content_sanskrit": "दैत्यं सोऽतिबलं दृप्तं समशार्दूलविक्रमः ।\nदृप्तैर्दैत्यगणैर्गुप्तं खरैर्नखमुखैरुत\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2121270, "chapter_id": 3596, "verse_number": "७७", "content_sanskrit": "ततः कृत्वा तु युद्धं वै तेन दैत्येन वै हरिः ।\nसन्ध्याकाले महातेजा भवनान्ते त्वरान्वितः\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2121271, "chapter_id": 3596, "verse_number": "७८", "content_sanskrit": "ऊरौ निधाय दैत्येन्द्रं निर्बिभेद नखैस्तदा ।\nमहाबलं महावीर्यं वरदानेन दर्पितम् ।\nदैत्यश्रेष्ठं सुरश्रेष्ठो जघान तरसा हरिः\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2121272, "chapter_id": 3596, "verse_number": "७९", "content_sanskrit": "हिरण्यकशिपुं हत्वा सर्वदैत्यांश्च वै तदा ।\nविबुधानां प्रजानां च हितं कृत्वा महाद्युतिः ।\nप्रमुमोद हरिर्देवः स्थाप्य धर्मं तदा भुवि\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2121273, "chapter_id": 3596, "verse_number": "८०", "content_sanskrit": "एष ते नारसिंहोऽत्र कथितः पाण्डुनन्दन ।\nशृणु त्वं वामनं नाम प्रादुर्भावं महात्मनः\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2121274, "chapter_id": 3596, "verse_number": "७", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां सभापर्वणि\nअष्टत्रिंशोऽध्यायः ॥३८॥ ॥ अर्घाभिहरणपर्वणि सप्तमोऽध्यायः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2121275, "chapter_id": 3596, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}]