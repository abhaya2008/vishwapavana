[{"id": 2039316, "chapter_id": 1863, "verse_number": "५-१०८-०x", "content_sanskrit": "सुपर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039317, "chapter_id": 1863, "verse_number": "५-१०८-१", "content_sanskrit": "अनुशिष्टोऽस्मि देवेन गालव ज्ञानयोनिना।\nब्रूहि कामं तु कां यामि द्रष्टुं प्रथममो दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039318, "chapter_id": 1863, "verse_number": "५-१०८-२", "content_sanskrit": "पूर्वां वा दक्षिणां वाहमथवा पश्चिमां दिशम्।\nउत्तरां वा द्विजश्रेष्ठ कुतो गच्छामि गालव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039319, "chapter_id": 1863, "verse_number": "५-१०८-३", "content_sanskrit": "यस्यामुदयते पूर्वं सर्वलोकप्रभावनः ।\nसविता यत्र सन्ध्यायां साध्यानां वर्तते तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039320, "chapter_id": 1863, "verse_number": "५-१०८-४", "content_sanskrit": "यस्यां पूर्वं मतिर्जाता यया व्याप्तमिदं जगत्।\nचक्षुषी यत्र धर्मस्य यत्र चैष प्रतिष्ठितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039321, "chapter_id": 1863, "verse_number": "५-१०८-५", "content_sanskrit": "कृतं यतो हुतं हव्यं सर्पते सर्वतोदिशम् ॥\nएतद्द्वारं द्विजश्रेष्ठ दिवसस्य तथाऽध्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039322, "chapter_id": 1863, "verse_number": "५-१०८-६", "content_sanskrit": "अत्र पूर्वं प्रसूता वै दाक्षायण्यः प्रजाः स्त्रियः ।\nयस्यां दिशि प्रवृद्धाश्च कश्यपस्यात्मसंभवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039323, "chapter_id": 1863, "verse_number": "५-१०८-७", "content_sanskrit": "अदोमूला सुराणां श्रीर्यत्र शक्रोऽभ्यषिच्यत।\nसुरराज्येन विप्रर्षे देवैश्चात्र तपश्चितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039324, "chapter_id": 1863, "verse_number": "५-१०८-८", "content_sanskrit": "एतस्मात्कारणाद्ब्रह्मन्पूर्वेत्येषा दिगुच्यते।\nयस्मात्पूर्वतरे काले पूर्वमेवावृतासुरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039325, "chapter_id": 1863, "verse_number": "५-१०८-९", "content_sanskrit": "अत एव च सर्वेषां पूर्वामाशां प्रचक्षते ।\nपूर्वं सर्वाणि कार्याणि दैवानि सुखमीप्सता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039326, "chapter_id": 1863, "verse_number": "५-१०८-१०", "content_sanskrit": "अत्र वेदाञ्जगौ पूर्वं भगवाँल्लोकभावनः ।\nअत्रैवोक्ता सवित्रासीत्सावित्री ब्रह्मवादिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039327, "chapter_id": 1863, "verse_number": "५-१०८-११", "content_sanskrit": "अत्र दत्तानि सूर्येण यजूंषि द्विजसत्तम ।\nअत्र लब्धवरः सोमः सुरैः क्रतुषु पीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039328, "chapter_id": 1863, "verse_number": "५-१०८-१२", "content_sanskrit": "अत्र तृप्ता हुतवहाः स्वां योनिमुपभुञ्जते ।\nअत्र पातालमाश्रित्य वरुणः श्रियमाप च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039329, "chapter_id": 1863, "verse_number": "५-१०८-१३", "content_sanskrit": "अत्र पूर्वं वसिष्ठस्य पौराणस्य द्विजर्षभ ।\nसूतिश्चैव प्रतिष्ठा च निधनं च प्रकाशते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039330, "chapter_id": 1863, "verse_number": "५-१०८-१४", "content_sanskrit": "ओङ्कारस्यात्र जायन्ते सृतयो दशतीर्दश ।\nपिबन्ति मुनयो यत्र हविर्धूमं स्म धूमपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039331, "chapter_id": 1863, "verse_number": "५-१०८-१५", "content_sanskrit": "प्रोक्षिता यत्र बहवो वराहाद्या मृगा वने।\nशक्रेण यज्ञभागार्थे दैवतेषु प्रकल्पिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039332, "chapter_id": 1863, "verse_number": "५-१०८-१६", "content_sanskrit": "अत्राहिताः कृतघ्नाश्च मानुषाश्चासुराश्च ये।\nउदयंस्तान्हि सर्वान्वै क्रोधाद्धन्ति विभावसुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039333, "chapter_id": 1863, "verse_number": "५-१०८-१७", "content_sanskrit": "एतद्द्वारं त्रिलोकस्य स्वर्गस्य च सुखस्य च।\nएष पूर्वो दिशां भागो विशावोऽत्र यदीच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039334, "chapter_id": 1863, "verse_number": "५-१०८-१८", "content_sanskrit": "प्रियं कार्यं हि मे तस्य यस्यास्मि वचने स्थितः।\nब्रूहि गालव यास्यामि शृणु चाप्यपरां दिशम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039335, "chapter_id": 1863, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि अष्टाधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]