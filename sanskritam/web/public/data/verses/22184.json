[{"id": 7002184000, "chapter_id": 22184, "verse_number": "२२९-१", "content_sanskrit": "पुष्कर उवाच ।\nस्वप्नं शुभाशुभं वक्ष्ये दुःस्वप्नहरणन्तथा ।\nनाभिं विनान्यत्र गात्रे तृणवृक्षसमुद्भवः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002184001, "chapter_id": 22184, "verse_number": "२२९-२", "content_sanskrit": "चूर्णनं मूद्र्ध्नि कांस्यानां मुण्डनं नग्नता तथा ।\nमलिनाम्बरधारित्वमभ्यङ्गः पङ्कदिग्धता ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002184002, "chapter_id": 22184, "verse_number": "२२९-३", "content_sanskrit": "उच्चात् प्रपतनञ्चैव विवाहो गीतमेव च ।\nतन्त्रीवाद्यविनोदश्च दालारोहणमेव च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002184003, "chapter_id": 22184, "verse_number": "२२९-४", "content_sanskrit": "अर्जनं पद्मलोहानां सर्पाणामथ मारणं ।\nरक्तपुष्पद्रुमाणाञ्च चण्डालस्य तथैव च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002184004, "chapter_id": 22184, "verse_number": "२२९-५", "content_sanskrit": "वराहश्वखरोष्ट्राणां तथा चारोहणक्रिया ।\nभक्षणं पक्षिमांसानां तैलस्य कृशरस्य च१ ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002184005, "chapter_id": 22184, "verse_number": "२२९-६", "content_sanskrit": "मातुः प्रवेशो जठरे चितारोहणमेव च ।\nशक्रध्वजाभिपतनं पतनं शशिसूर्य्ययोः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002184006, "chapter_id": 22184, "verse_number": "२२९-७", "content_sanskrit": "दिव्यान्तरीक्षभौमानामुत्पातानाञ्च दर्शनं ।\nदेवद्विजातिभूपानां गुरूणाङ्कोप एव च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002184007, "chapter_id": 22184, "verse_number": "२२९-८", "content_sanskrit": "नर्त्तनं हसनञ्चैव विवाहो गीतमेव च ।\nतन्त्रीवाद्यविहीनानां वाद्यानामपि वादनं ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002184008, "chapter_id": 22184, "verse_number": "२२९-९", "content_sanskrit": "स्त्रोतोवहाधोगमनं स्नानं गोमयवारिणा ।\nपङ्कोदकेन च तथा मशीतोयेन वाप्यथ ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002184009, "chapter_id": 22184, "verse_number": "२२९-१०", "content_sanskrit": "आलिड्गनं कुमारीणां पुरुषाणाञ्च मैथुनं ।\nहानिश्चैव स्वगात्राणां विरेको वमनक्रिया ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002184010, "chapter_id": 22184, "verse_number": "२२९-११", "content_sanskrit": "दक्षिणाशाप्रगमनं व्याधिनाभिभवस्तथा ।\nफलानामुपहानिश्च धातूनां भेदनं तथा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002184011, "chapter_id": 22184, "verse_number": "२२९-१२", "content_sanskrit": "गृहाणाञ्चैव पतनं गृहसम्मार्जनन्तथा ।\nक्रोडा पिशाचक्रव्यादवानरान्त्यनरैरपि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002184012, "chapter_id": 22184, "verse_number": "२२९-१३", "content_sanskrit": "परादभिभवश्चैव तस्माच्च व्यसनोद्भवः ।\nकाषायवस्त्रधारित्वं तद्वस्त्रै क्रीडनं तथा४ ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002184013, "chapter_id": 22184, "verse_number": "२२९-१४", "content_sanskrit": "स्रेहपानावगाहौ च रक्तमाल्यानुलेपनं ।\nइत्यधन्यानि स्वप्नानि तेषामकथनं शुभं ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002184014, "chapter_id": 22184, "verse_number": "२२९-१५", "content_sanskrit": "भूयश्च स्वपनं तद्वत् कार्य्यं स्नानं द्विजार्च्चनं ।\nतिलैर्होमो हरिब्रह्मशिवार्कगणपूजनं ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002184015, "chapter_id": 22184, "verse_number": "२२९-१६", "content_sanskrit": "तथा स्तुतिप्रपठनं पुंसूक्तादिजपस्तथा ।\nस्वप्नास्तु प्रथमे यामे५ संवत्सरविपाकिनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002184016, "chapter_id": 22184, "verse_number": "२२९-१७", "content_sanskrit": "षड्भिर्मासैर्द्वितीये तु त्रिभिर्मासैस्त्रियामिकाः ।\nचतुर्थे त्वर्द्धमासेन दशाहादरुणोदये ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002184017, "chapter_id": 22184, "verse_number": "२२९-१८", "content_sanskrit": "एकस्यामथ चेद्रात्रौ शुभं वा यदि वाऽशुभं ।\nपश्चाद् दृष्टस्तु यस्तत्र तस्य पाकं विनिर्दिशेत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002184018, "chapter_id": 22184, "verse_number": "२२९-१९", "content_sanskrit": "तस्मात्तु शोभने स्वप्ने पश्चात्स्वापो न शस्यते ।\nशैलप्रासादनागाश्ववृषभारोहणं हितं ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002184019, "chapter_id": 22184, "verse_number": "२२९-२०", "content_sanskrit": "द्रुमाणां स्वेतपुष्पाणां गगने च तथा द्विज ।\nद्रुमतृणोद्भवो नाभौ तथा च बहुबाहुता ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002184020, "chapter_id": 22184, "verse_number": "२२९-२१", "content_sanskrit": "तथा च बहुशीर्षत्वं पलितोद्बव एव च ।\nसुशुक्लमाल्यधारित्वं सुशुक्लाम्बरधारिता ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002184021, "chapter_id": 22184, "verse_number": "२२९-२२", "content_sanskrit": "चन्द्रार्कताराग्रहणं परिमार्जनमेव च ।\nशक्रध्वजालिङ्गनञ्च ध्वजोच्छ्रायक्रिया तथा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002184022, "chapter_id": 22184, "verse_number": "२२९-२३", "content_sanskrit": "भूम्यम्बुधाराग्रहणं६ शत्रूणाञ्चैव विक्रिया ।\nजयो विवादे द्युते च सङ्ग्रामे च तथा द्विज ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002184023, "chapter_id": 22184, "verse_number": "२२९-२४", "content_sanskrit": "भक्षणञ्चार्ट्रमांसानाम्पायसस्य च भक्षणं ।\nदर्शनं रुधिरस्यापि स्नानं वा रुधिरेण च ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002184024, "chapter_id": 22184, "verse_number": "२२९-२५", "content_sanskrit": "सुगरुधिरमद्यानां पानं क्षीरस्य वाप्यथ ।\nअस्त्रैर्विचेष्टनं भूमौ निर्मलं गगनं तथा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002184025, "chapter_id": 22184, "verse_number": "२२९-२६", "content_sanskrit": "मुखेन दोहनं शस्तं महिषीणां तथा गवां ।\nसिंहीनां हस्तिनीनाञ्च बडवानां तथैव च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002184026, "chapter_id": 22184, "verse_number": "२२९-२७", "content_sanskrit": "प्रसादो देवविप्रेभ्यो गुरुभ्यश्च तथा द्विज ।\nअम्भसा चाभिषेखस्तु गवां श्रृङ्गच्युतेन च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002184027, "chapter_id": 22184, "verse_number": "२२९-२८", "content_sanskrit": "चन्द्राद् भ्रष्टेन वा राम ज्ञेयं राकज्यप्रदं हि तत् ।\nराज्याभिषेकश्च तथा छेदनं शिरसोऽप्यथ ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002184028, "chapter_id": 22184, "verse_number": "२२९-२९", "content_sanskrit": "मरणं वह्निलाभश्च वह्निदाहो गृहादिषु ।\nलब्धिश्च राकजलिङ्गानां तन्त्रीवाद्याभिवादनं ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002184029, "chapter_id": 22184, "verse_number": "२२९-३०", "content_sanskrit": "यस्तु पश्यति स्वप्नान्ते राजानं कुञ्जरं हयं ।\nहिरण्यं वृषभङ्गाञ्च कुटुम्बस्तस्य वर्द्धते ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002184030, "chapter_id": 22184, "verse_number": "२२९-३१", "content_sanskrit": "वृषेभगृहशैलाग्रवृक्षारोहणरोदनं ।\nघृतविष्ठानुलेपो वा अगम्यागमनं तथा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]