[{"id": 2002467, "chapter_id": 1053, "verse_number": "१-५४-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2002468, "chapter_id": 1053, "verse_number": "१-५४-१", "content_sanskrit": "तत आहूय पुत्रं स्वं जरत्कारुर्भुजंगमा।\nवासुकेर्नागराजस्य वचनादिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2002469, "chapter_id": 1053, "verse_number": "१-५४-२", "content_sanskrit": "अहं तव पितुः पुत्र भ्रात्रा दत्ता निमित्ततः।\nकालः स चायं संप्राप्तस्तत्कुरुष्व यथातथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2002470, "chapter_id": 1053, "verse_number": "१-५४-३x", "content_sanskrit": "आस्तीक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2002471, "chapter_id": 1053, "verse_number": "१-५४-३", "content_sanskrit": "किंनिमित्तं मम पितुर्दत्ता त्वं मातुलेन मे।\nतन्ममाचक्ष्व तत्त्वेन श्रुत्वा कर्ताऽस्मि तत्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2002472, "chapter_id": 1053, "verse_number": "१-५४-४x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2002473, "chapter_id": 1053, "verse_number": "१-५४-४", "content_sanskrit": "तत आचष्ट सा तस्मै बान्धवानां हितैषिणी।\nभगिनी नागराजस्य जरत्कारुरविक्लबा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2002474, "chapter_id": 1053, "verse_number": "१-५४-५x", "content_sanskrit": "जरत्कारुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2002475, "chapter_id": 1053, "verse_number": "१-५४-५", "content_sanskrit": "पन्नगानामशेषाणां माता कद्रूरिति श्रुता।\nतया शप्ता रुषितया सुता यस्मान्निबोध तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2002476, "chapter_id": 1053, "verse_number": "१-५४-६", "content_sanskrit": "उच्चैः श्रवाः सोऽश्वराजो यन्मिथ्या न कृतो मम।\nविनतार्थाय पणिते दासभावाय पुत्रकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2002477, "chapter_id": 1053, "verse_number": "१-५४-७", "content_sanskrit": "जनमेजयस्य वो यज्ञे धक्ष्यत्यनिलसारथिः।\nतत्र पञ्चत्वमापन्नाः प्रेतलोकं गमिष्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2002478, "chapter_id": 1053, "verse_number": "१-५४-८", "content_sanskrit": "तां च शप्तवतीं देवः साक्षाल्लोकपितामहः।\nएवमस्त्विति तद्वाक्यं प्रोवाचानु मुमोद च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2002479, "chapter_id": 1053, "verse_number": "१-५४-९", "content_sanskrit": "वासुकिश्चापि तच्छ्रुत्वा पितामहवचस्तदा।\nअमृते मथिते तात देवाञ्छरणमीयिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2002480, "chapter_id": 1053, "verse_number": "१-५४-१०", "content_sanskrit": "सिद्धार्थाश्च सुराः सर्वे प्राप्यामृतमनुत्तमम्।\nभ्रातरं मे पुरस्कृत्य पितामहमुपागमन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2002481, "chapter_id": 1053, "verse_number": "१-५४-११", "content_sanskrit": "ते तं प्रसादयामासुः सुराः सर्वेऽब्जसंभवम्।\nराज्ञा वासुकिना सार्धं शापोऽसौन भवेदिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2002482, "chapter_id": 1053, "verse_number": "१-५४-१२x", "content_sanskrit": "देवा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2002483, "chapter_id": 1053, "verse_number": "१-५४-१२", "content_sanskrit": "वासुकिर्नागराजोऽयं दुःखितो ज्ञातिकारणात्।\nअभिशापः स मातुस्तु भगवन्न भवेत्कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2002484, "chapter_id": 1053, "verse_number": "१-५४-१३x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2002485, "chapter_id": 1053, "verse_number": "१-५४-१३", "content_sanskrit": "जरत्कारुर्जरत्कारुं यां भार्यां समवाप्स्यति।\nतत्र जातो द्विजः शापान्मोक्षयिष्यति पन्नगान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2002486, "chapter_id": 1053, "verse_number": "१-५४-१४", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं वासुकिः पन्नगोत्तमः।\nप्रादान्माममरप्रख्य तव पित्रे महात्मने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2002487, "chapter_id": 1053, "verse_number": "१-५४-१५", "content_sanskrit": "प्रागेवानागते काले तस्मात्त्व मय्यजायथाः।\nअयं स कालः संप्राप्तो भयान्नस्त्रातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2002488, "chapter_id": 1053, "verse_number": "१-५४-१६", "content_sanskrit": "भ्रातरं चापि मे तस्मात्त्रातुमर्हसि पावकात्।\nन मोघं तु कृतं तत्स्याद्यदहं तव धीमते।\nपित्रे दत्ता विमोक्षार्थं कथं वा पुत्र मन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2002489, "chapter_id": 1053, "verse_number": "१-५४-१७x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2002490, "chapter_id": 1053, "verse_number": "१-५४-१७", "content_sanskrit": "एवमुक्तस्तथेत्युक्त्वा सास्तीको मातरं तदा।\nअब्रवीद्दुःखसंतप्तं वासुकिं जीवयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2002491, "chapter_id": 1053, "verse_number": "१-५४-१८", "content_sanskrit": "अहं त्वां मोक्षयिष्यामि वासुके पन्नगोत्तम।\nतस्माच्छापान्महासत्त्व सत्यमेतद्ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2002492, "chapter_id": 1053, "verse_number": "१-५४-१९", "content_sanskrit": "भव स्वस्थमना नाग न हि ते विद्यते भयम्।\nप्रयतिष्ये तथा राजन्यथा श्रेयो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2002493, "chapter_id": 1053, "verse_number": "१-५४-२०", "content_sanskrit": "न मे वागनृतं प्राह स्वैरेष्वपि कुतोऽन्यथा।\nतं वै नृपवरं गत्वा दीक्षितं जनमेजयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2002494, "chapter_id": 1053, "verse_number": "१-५४-२१", "content_sanskrit": "वाग्भिर्मङ्गलयुक्ताभिस्तोषयिष्येऽद्य मातुल।\nयथा स यज्ञो नृपतेर्निवत्रिष्यति सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2002495, "chapter_id": 1053, "verse_number": "१-५४-२२", "content_sanskrit": "स संभावय नागेन्द्र मयि सर्वं महामते।\nन ते मयि मनो जातु मिथ्या भवितुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2002496, "chapter_id": 1053, "verse_number": "१-५४-२३x", "content_sanskrit": "वासुकिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2002497, "chapter_id": 1053, "verse_number": "१-५४-२३", "content_sanskrit": "आस्तीक परिघूर्णामि हृदयं मे विदीर्यते।\nदिशो न प्रतिजानामि ब्रह्मदण्डनिपीडितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2002498, "chapter_id": 1053, "verse_number": "१-५४-२४x", "content_sanskrit": "आस्तीक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2002499, "chapter_id": 1053, "verse_number": "१-५४-२४", "content_sanskrit": "न सन्तापस्त्वया कार्यः कथंचित्पन्नगोत्तम।\nप्रदीप्ताग्नेः समुत्पन्नं नाशयिष्यामि ते भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2002500, "chapter_id": 1053, "verse_number": "१-५४-२५", "content_sanskrit": "ब्रह्मदण्डं महाघोरं कालाग्निसमतेजसम्।\nनाशयिष्यामि माऽत्र त्वं भयंकार्षीः कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2002501, "chapter_id": 1053, "verse_number": "१-५४-२६x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2002502, "chapter_id": 1053, "verse_number": "१-५४-२६", "content_sanskrit": "ततः स वासुकेर्घोरमपनीय मनोज्वरम्।\nआधाय चात्मनोऽङ्गेषु जगाम त्वरितो भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2002503, "chapter_id": 1053, "verse_number": "१-५४-२७", "content_sanskrit": "जनमेजयस्य तं यज्ञं सर्वैः समुदितं गुणैः।\nमोक्षाय भुजगेन्द्राणामास्तीको द्विजसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2002504, "chapter_id": 1053, "verse_number": "१-५४-२८", "content_sanskrit": "स गत्वाऽपश्यदास्तीको यज्ञायतनमुत्तमम्।\nवृतं सदस्यैर्बहुभिः सूर्यवह्निसमप्रभैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2002505, "chapter_id": 1053, "verse_number": "१-५४-२९", "content_sanskrit": "स तत्र वारितो द्वास्थैः प्रविशन्द्विजसत्तमः।\nअभितुष्टाव तं यज्ञं प्रवेशार्थी परंतपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2002506, "chapter_id": 1053, "verse_number": "१-५४-३०", "content_sanskrit": "स प्राप्य यज्ञायतनं वरिष्ठं\nद्विजोत्तमः पुण्यकृतां वरिष्ठः।\nतुष्टाव राजानमनन्तकीर्ति-\nमृत्विक्सदस्यांश्च तथैव चाग्निम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2002507, "chapter_id": 1053, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि चतुःपञ्चाशत्तमोऽध्यायः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]