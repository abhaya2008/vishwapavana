[{"id": 2097559, "chapter_id": 3089, "verse_number": "१३-२१९-१", "content_sanskrit": "उमोवाच।\nभगवन्देवदेवेश मानुषेष्वेव केचन।\nज्ञानविज्ञानसम्पन्ना बुद्धिमन्तो विचक्षणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2097560, "chapter_id": 3089, "verse_number": "१३-२१९-२", "content_sanskrit": "दुर्गतास्तु प्रदृश्यन्ते यतमाना यथाविधि।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2097561, "chapter_id": 3089, "verse_number": "१३-२१९-३x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2097562, "chapter_id": 3089, "verse_number": "१३-२१९-३", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु कल्याणि कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2097563, "chapter_id": 3089, "verse_number": "१३-२१९-४", "content_sanskrit": "ये पुरा मनुजा देवि श्रुतवन्तोपि केवलम्।\nनिरा**** निरन्नाद्या भृशमात्मपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2097564, "chapter_id": 3089, "verse_number": "१३-२१९-५", "content_sanskrit": "ते पुनर्जन्मनि शुभे ज्ञानबुद्धियुता अपि।\nनिष्किञ्चना भवन्त्येव अनुप्तं हि न रोहति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2097565, "chapter_id": 3089, "verse_number": "१३-२१९-६x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2097566, "chapter_id": 3089, "verse_number": "१३-२१९-६", "content_sanskrit": "मूर्खा लोके प्रदृश्यन्ते वृथा मूढा विचेतसः।\nज्ञानविज्ञानरहिताः समृद्धाश्च समन्ततः।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2097567, "chapter_id": 3089, "verse_number": "१३-२१९-७x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2097568, "chapter_id": 3089, "verse_number": "१३-२१९-७", "content_sanskrit": "ये पुरा मनुजा देवि बालिशा अपि सर्वतः।\nसमाचरन्ति दानानि दीनानुग्रहकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2097569, "chapter_id": 3089, "verse_number": "१३-२१९-८", "content_sanskrit": "अबुद्धिपूर्वं वा दानं ददत्येव यतस्ततः।\nते पुनर्जन्मनि शुभे प्राप्नुवन्त्येव तत्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2097570, "chapter_id": 3089, "verse_number": "१३-२१९-९", "content_sanskrit": "पण्डितोऽपण्डितो वाऽपि भुङ्क्ते दानफलं नरः।\nबुद्ध्याऽनपेक्षितं दानं सर्वथा तत्फलत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2097571, "chapter_id": 3089, "verse_number": "१३-२१९-१०x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2097572, "chapter_id": 3089, "verse_number": "१३-२१९-१०", "content_sanskrit": "भगवन्देवदेवेश मानुषेष्वेव केचन।\nमेधाविनः श्रुतधरा भवन्ति विशदाक्षराः।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2097573, "chapter_id": 3089, "verse_number": "१३-२१९-११x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2097574, "chapter_id": 3089, "verse_number": "१३-२१९-११", "content_sanskrit": "ये पुरा मनुजा देवि गुरुशुश्रूषका भृशम्।\nज्ञानार्थं ते तु सङ्गृह्य तीर्थतो विधिपूर्वकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2097575, "chapter_id": 3089, "verse_number": "१३-२१९-१२", "content_sanskrit": "विधिनैव परांश्चैव ग्राहयन्ति च नान्यथा।\nअश्लाघमाना ज्ञानेन प्रशान्ता यतवाचकाः।\nविद्यास्थानानि ये लोके स्थापयन्ति च यत्नतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2097576, "chapter_id": 3089, "verse_number": "१३-२१९-१३", "content_sanskrit": "तादृश मरणं प्राप्ताः पुनर्जन्मनि शोभने।\nमेधाविनः श्रुतधरा भवन्ति विशदाक्षराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2097577, "chapter_id": 3089, "verse_number": "१३-२१९-१४x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2097578, "chapter_id": 3089, "verse_number": "१३-२१९-१४", "content_sanskrit": "अपरे मानुषा देव यतन्तोपि यतस्ततः।\nबहिष्कृताः प्रदृश्यन्ते श्रुतविज्ञानबुद्धितः।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2097579, "chapter_id": 3089, "verse_number": "१३-२१९-१५x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2097580, "chapter_id": 3089, "verse_number": "१३-२१९-१५", "content_sanskrit": "ये पुरा मनुजा देवि ज्ञानदर्पसमन्विताः।\nश्लाघमानाश्च तत्प्राप्य ज्ञानाहङ्कारमोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2097581, "chapter_id": 3089, "verse_number": "१३-२१९-१६", "content_sanskrit": "वदन्ति ये परान्नित्यं ज्ञानाधिक्येन दर्पिताः।\nज्ञानादसूयां कुर्वन्ति न सहन्ते च चापरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2097582, "chapter_id": 3089, "verse_number": "१३-२१९-१७", "content_sanskrit": "तादृशा मरणं प्राप्ताः पुनर्जन्मनि शोभने।\nमानुष्यं सुचिरात्प्राप्य तत्र बोधविवर्जिताः।\nभवन्ति सततं देवि यतन्तो हीनमेधसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2097583, "chapter_id": 3089, "verse_number": "१३-२१९-१८x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2097584, "chapter_id": 3089, "verse_number": "१३-२१९-१८", "content_sanskrit": "भगवन्मानुषाः केचित्सर्वकल्याणसंयुताः।\nपुत्रैर्दारैर्गुणयुतैर्दासीदासपरिच्छदैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2097585, "chapter_id": 3089, "verse_number": "१३-२१९-१९", "content_sanskrit": "परमं बुद्धिसंयुक्ताः स्थानैश्वर्यपरिग्रहैः।\nव्याधिहीना नबाधाश्च रूपारोग्यबलैर्युताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2097586, "chapter_id": 3089, "verse_number": "१३-२१९-२०", "content_sanskrit": "धनधान्येन सम्पन्नाः प्रासादैर्यानवाहनैः।\nसर्वोपभोगसंयुक्ता नानाचित्रैर्मनोहरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2097587, "chapter_id": 3089, "verse_number": "१३-२१९-२१", "content_sanskrit": "ज्ञातिभिः सह मोदन्ते अविघ्नं तु दिनेदिने।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2097588, "chapter_id": 3089, "verse_number": "१३-२१९-२२x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2097589, "chapter_id": 3089, "verse_number": "१३-२१९-२२", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु सर्वं समाहिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2097590, "chapter_id": 3089, "verse_number": "१३-२१९-२३", "content_sanskrit": "ये पुरा मनुजा देवि आढ्या वा इतरेऽपि वा।\nश्रुतवृत्तसमायुक्ता दानकामाः श्रुतप्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2097591, "chapter_id": 3089, "verse_number": "१३-२१९-२४", "content_sanskrit": "परेङ्गितपरा नित्यं दातव्यमिति निश्चिताः।\nसत्यसन्धाः क्षमाशीला लोभमोहविवर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2097592, "chapter_id": 3089, "verse_number": "१३-२१९-२५", "content_sanskrit": "दातारः पात्रतो दानं व्रतैर्नियमसंयुताः।\nस्वदुःखमिव संस्मृत्य परदुःखविवर्जिताः।\nसौम्यशीलाः शुभाचारा देवब्राह्मणपूजकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2097593, "chapter_id": 3089, "verse_number": "१३-२१९-२६", "content_sanskrit": "एवंशीलसमाचाराः पुनर्जन्मनि शोभने।\nदिवि वा भुवि वा देवि जायन्ते कर्मभोगिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2097594, "chapter_id": 3089, "verse_number": "१३-२१९-२७", "content_sanskrit": "मानुषेष्वपि ये जातास्तादृशाः सम्भवन्ति ते।\nयादृशास्तु तथा प्रोक्ताः सर्वे कल्याणसंयुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2097595, "chapter_id": 3089, "verse_number": "१३-२१९-२८", "content_sanskrit": "रूपं द्रव्यं बलं चायुर्भोगैश्वर्यं बलं श्रुतम्।\nइत्येतत्सर्वसाद्गुण्यं दानाद्भवति नान्यथा।\nतपोदानमयं सर्वमिति विद्धि शुभानने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2097596, "chapter_id": 3089, "verse_number": "१३-२१९-२९x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2097597, "chapter_id": 3089, "verse_number": "१३-२१९-२९", "content_sanskrit": "अथ केचित्प्रदृश्यन्ते मानुषेष्वेव मानुषाः।\nदुर्गताः क्लेशभूयिष्ठा दानभोगविवर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2097598, "chapter_id": 3089, "verse_number": "१३-२१९-३०", "content_sanskrit": "भयैस्त्रिभिः समाजुष्टा व्याधिक्षुद्भयसंयुताः।\nदुष्कलत्राभिभूताश्च सततं विघ्नदर्शकाः।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2097599, "chapter_id": 3089, "verse_number": "१३-२१९-३१x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2097600, "chapter_id": 3089, "verse_number": "१३-२१९-३१", "content_sanskrit": "ये पुरा मनुजा देवि आसुरं भावमाश्रिताः।\nक्रोधलोभसमायुक्ता निरन्नाद्याश्च निष्क्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2097601, "chapter_id": 3089, "verse_number": "१३-२१९-३२", "content_sanskrit": "नास्तिकाश्चैव धूर्ताश्च मूर्खाश्चात्मपरायणाः।\nपरोपतापिनो देवि प्रायशः प्राणिनिर्दयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2097602, "chapter_id": 3089, "verse_number": "१३-२१९-३३", "content_sanskrit": "एवंयुक्तसमाचाराः पुनर्जन्मनि शोभने।\nकथंचित्प्राप्य मानुष्यं तत्र ते दुःखपीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2097603, "chapter_id": 3089, "verse_number": "१३-२१९-३४", "content_sanskrit": "सर्वतः सम्भवन्त्येव पूर्वमात्मप्रमादतः।\nयथा ते पूर्वकथितास्तथा ते सम्भवन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2097604, "chapter_id": 3089, "verse_number": "१३-२१९-३५", "content_sanskrit": "शुभाशुभं कृतं कर्म सुखदुःखफलोदयम्।\nइति ते कथितं देवि भूयः श्रोतुं किमिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2097605, "chapter_id": 3089, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकोनविंशत्यधिकद्विशततमोऽध्यायः॥ २१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]