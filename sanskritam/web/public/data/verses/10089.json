[{"id": 6000089000, "chapter_id": 10089, "verse_number": null, "content_sanskrit": "अथ पञ्चविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000089001, "chapter_id": 10089, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.001.m4a", "display_order": 2}, {"id": 6000089002, "chapter_id": 10089, "verse_number": "४-२५-१", "content_sanskrit": "इति संदिश्य भगवान् बार्हिषदैरभिपूजितः।\nपश्यतां राजपुत्राणां तत्रैवान्तर्दधे हरः॥ ४/२५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.002.m4a", "display_order": 3, "topics": [{"text": "प्रचेतोभिः रुद्रोपदिष्टमार्गेण भगवन्तमुद्दिश्य तपश्चरणम्", "range": "१–२"}]}, {"id": 6000089003, "chapter_id": 10089, "verse_number": "४-२५-२", "content_sanskrit": "रुद्रगीतं भगवतः स्तोत्रं सर्वे प्रचेतसः।\nजपन्तस्ते तपस्तेपुर्वर्षाणामयुतं जले॥ ४/२५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.003.m4a", "display_order": 4}, {"id": 6000089004, "chapter_id": 10089, "verse_number": "४-२५-३", "content_sanskrit": "प्राचीनबर्हिषं क्षत्तः कर्मस्वासक्तमानसम्।\nनारदोऽध्यात्मतत्त्वज्ञः कृपालुः प्रत्यबोधयत्॥ ४/२५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.004.m4a", "display_order": 5, "topics": [{"text": "एतस्मिन्नन्तरे नारदस्य प्राचीनवर्हिषः समीपगमनम्", "range": "३–५"}]}, {"id": 6000089005, "chapter_id": 10089, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.005.m4a", "display_order": 6}, {"id": 6000089006, "chapter_id": 10089, "verse_number": "४-२५-४", "content_sanskrit": "श्रेयस्त्वं कतमद् राजन् कर्मणाऽऽत्मन ईहसे।\nदुःखहानिः सुखावाप्तिः श्रेयस्तन्नेहयेष्यते॥ ४/२५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.006.m4a", "display_order": 7}, {"id": 6000089007, "chapter_id": 10089, "verse_number": null, "content_sanskrit": "प्राचीनबर्हिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.007.m4a", "display_order": 8}, {"id": 6000089008, "chapter_id": 10089, "verse_number": "४-२५-५", "content_sanskrit": "न जानामि महाभाग परं कर्मापविद्धधीः।\nब्रूहि मे विमलं ज्ञानं येन मुच्येय कर्मभिः॥ ४/२५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.008.m4a", "display_order": 9}, {"id": 6000089009, "chapter_id": 10089, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.009.m4a", "display_order": 10}, {"id": 6000089010, "chapter_id": 10089, "verse_number": "४-२५-६", "content_sanskrit": "गृहेषु कूटधर्मेषु पुत्रदारधनार्थधीः।\nन परं विन्दते मूढो भ्राम्यन् संसारवर्त्मसु॥ ४/२५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.010.m4a", "display_order": 11, "topics": [{"text": "नारदेन प्राचीनबर्हिषे कर्ममार्गापेक्षया ज्ञानमार्गः श्रेष्ठ इत्युपदेशार्थ पुरंजनोपाख्यानकथनारम्भः", "range": "६–१९"}]}, {"id": 6000089011, "chapter_id": 10089, "verse_number": "४-२५-७", "content_sanskrit": "भो भो प्रजापते राजन् पशून् पश्य त्वयाऽध्वरे।\nसंज्ञापितान् जीवसङ्घान् निर्घृणेन सहस्रशः॥ ४/२५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.011.m4a", "display_order": 12}, {"id": 6000089012, "chapter_id": 10089, "verse_number": "४-२५-८", "content_sanskrit": "एते त्वां सम्प्रतीक्षन्ते स्मरन्तो वैशसं तव।\nसम्परेतमयःकूटैश्छिन्दन्त्युत्थितमन्यवः॥ ४/२५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.012.m4a", "display_order": 13}, {"id": 6000089013, "chapter_id": 10089, "verse_number": "४-२५-९", "content_sanskrit": "अत्र ते कथयिष्येऽहमितिहासं पुरातनम्।\nपुरञ्जनस्य चरितं निबोध गदतो मम॥ ४/२५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.013.m4a", "display_order": 14}, {"id": 6000089014, "chapter_id": 10089, "verse_number": "४-२५-१०", "content_sanskrit": "आसीत् पुरञ्जनो नाम राजा राजन् बृहच्छ्रवाः।\nतस्याविज्ञातनामाऽऽसीत् सखाऽविज्ञातचेष्टितः॥ ४/२५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.014.m4a", "display_order": 15}, {"id": 6000089015, "chapter_id": 10089, "verse_number": "४-२५-११", "content_sanskrit": "सोऽन्वेषमाणः शरणं बभ्राम पृथिवीं प्रभुः।\nनानुरूपं यदाऽविन्ददभूत् स विमना इव॥ ४/२५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.015.m4a", "display_order": 16}, {"id": 6000089016, "chapter_id": 10089, "verse_number": "४-२५-१२", "content_sanskrit": "न साधु मेने ताः सर्वा भूतले यावतीः पुरः।\nकामान् कामयमानोऽसौ तस्य तस्याभिपत्तये॥ ४/२५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.016.m4a", "display_order": 17}, {"id": 6000089017, "chapter_id": 10089, "verse_number": "४-२५-१३", "content_sanskrit": "स एकदा हिमवतो दक्षिणेष्वथ सानुषु।\nददर्श नवभिर्द्वारैः पुरीं लक्षितलक्षणाम्॥ ४/२५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.017.m4a", "display_order": 18}, {"id": 6000089018, "chapter_id": 10089, "verse_number": "४-२५-१४", "content_sanskrit": "प्राकारोपवनाट्टालपरिखैरुच्चतोरणैः।\nस्वर्णरौप्यायसैः शृृङ्गैः संकुलां सर्वतो गृहैः॥ ४/२५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.018.m4a", "display_order": 19}, {"id": 6000089019, "chapter_id": 10089, "verse_number": "४-२५-१५", "content_sanskrit": "नीलस्फटिकवैदूर्यमुक्तामरकतारुणैः।\nकॢप्तहर्म्यस्थलीं दीप्तां श्रिया भोगवतीमिव॥ ४/२५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.019.m4a", "display_order": 20}, {"id": 6000089020, "chapter_id": 10089, "verse_number": "४-२५-१६", "content_sanskrit": "सभाचत्वररथ्याभिराक्रीडायतनापणैः।\nचैत्यध्वजपताकाभिर्युक्तां विद्रुमवेदिभिः॥ ४/२५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.020.m4a", "display_order": 21}, {"id": 6000089021, "chapter_id": 10089, "verse_number": "४-२५-१७", "content_sanskrit": "पुर्यास्तु बाह्योपवने दिव्यद्रुमलताकुले।\nनदद्विहङ्गालिकुलकोलाहलजलाशये॥ ४/२५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.021.m4a", "display_order": 22}, {"id": 6000089022, "chapter_id": 10089, "verse_number": "४-२५-१८", "content_sanskrit": "हिमनिर्झरविप्रुष्मत्कुसुमाकरवायुना।\nचलत्प्रवालविटपिनलिनीतटसंपदि॥ ४/२५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.022.m4a", "display_order": 23}, {"id": 6000089023, "chapter_id": 10089, "verse_number": "४-२५-१९", "content_sanskrit": "नानारण्यमृगव्रातैरनाबाधे मुनिव्रतैः।\nआहूतं मन्यते पान्थो यत्र कोकिलकूजितैः॥ ४/२५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.023.m4a", "display_order": 24}, {"id": 6000089024, "chapter_id": 10089, "verse_number": "४-२५-२०", "content_sanskrit": "यदृच्छयाऽऽगतां तत्र ददर्श प्रमदोत्तमाम्।\nभृत्यैर्दशभिरायान्तीमेकैकशतनायकैः॥ ४/२५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.024.m4a", "display_order": 25, "topics": [{"text": "पुरंजनस्य कामभोगकथाकथनम्", "range": "२०–६३"}]}, {"id": 6000089025, "chapter_id": 10089, "verse_number": "४-२५-२१", "content_sanskrit": "तेषां परिवृढो राजन् सर्वेषां बलिमुद्वहन्।\nसस्‍त्रीकाणां सखा तस्या बहुरूपोऽग्रणीः स्‍त्रियः॥ ४/२५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.025.m4a", "display_order": 26}, {"id": 6000089026, "chapter_id": 10089, "verse_number": "४-२५-२२", "content_sanskrit": "पञ्चशीर्षाहिना गुप्तां प्रतीहारेण सर्वतः।\nअन्वेषमाणामृषभमप्रौढां कामरूपिणीम्॥ ४/२५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.026.m4a", "display_order": 27}, {"id": 6000089027, "chapter_id": 10089, "verse_number": "४-२५-२३", "content_sanskrit": "सुनासां सुदतीं बालां सुकपोलां वराननाम्।\nसमविन्यस्तकर्णाभ्यां बिभ्रतीं कुण्डलश्रियम्॥ ४/२५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.027.m4a", "display_order": 28}, {"id": 6000089028, "chapter_id": 10089, "verse_number": "४-२५-२४", "content_sanskrit": "पिशङ्गनीवीं सुश्रोणीं श्यामां कनकमेखलाम्।\nपद्भ्यां क्‍वणद्भ्यां चलतीं नूपुरैर्देवतामिव॥ ४/२५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.028.m4a", "display_order": 29}, {"id": 6000089029, "chapter_id": 10089, "verse_number": "४-२५-२५", "content_sanskrit": "स्तनौ व्यञ्जितकैशोरौ समवृत्तौ निरन्तरौ।\nवस्‍त्रान्तेन निगूहन्तीं व्रीडया गजगामिनीम्॥ ४/२५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.029.m4a", "display_order": 30}, {"id": 6000089030, "chapter_id": 10089, "verse_number": "४-२५-२६", "content_sanskrit": "तामाह ललितां वीरः सव्रीडस्मितशोभिनीम्।\nस्निग्धेनापाङ्गपुङ्खेन स्पृष्टः प्रेमभ्रमद्‌भ्रुवा॥ ४/२५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.030.m4a", "display_order": 31}, {"id": 6000089031, "chapter_id": 10089, "verse_number": "४-२५-२७", "content_sanskrit": "का त्वं कञ्जपलाशाक्षि कस्यासीह कुतः सति।\nइमामुप पुरीं भीरु किं चिकीर्षसि शंस मे॥ ४/२५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.031.m4a", "display_order": 32}, {"id": 6000089032, "chapter_id": 10089, "verse_number": "४-२५-२८", "content_sanskrit": "क एतेऽनुपथा एत एकादशमहाभटाः।\nएता वा ललना सुभ्रु कोऽयं तेऽहिः पुरस्सरः॥ ४/२५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.032.m4a", "display_order": 33}, {"id": 6000089033, "chapter_id": 10089, "verse_number": "४-२५-२९", "content_sanskrit": "त्वं ह्रीर्भवान्यस्यथ वाग् रमा पतिं विचिन्वती किं मुनिवद् रहो वने।\nत्वदङ्घ्रिसाम्याप्तसमस्तकामः क्‍व पद्मकोशः पतितः कराग्रात्॥ ४/२५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.033.m4a", "display_order": 34}, {"id": 6000089034, "chapter_id": 10089, "verse_number": "४-२५-३०", "content_sanskrit": "नासां वरोर्वन्यतमा, भुविस्पृक् पुरीमिमां वीरवरेण साकम्।\nअर्हस्यलङ्कर्तुमदभ्रकर्मणा लोकं परं श्रीरिव यज्ञपुंसा॥ ४/२५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.034.m4a", "display_order": 35}, {"id": 6000089035, "chapter_id": 10089, "verse_number": "४-२५-३१", "content_sanskrit": "यदेष माऽपाङ्गविखण्डितेन्द्रियं सव्रीडहासेक्षणविभ्रमद्‌भ्रुवः।\nतवोपसृष्टो भगवान् मनोभवः प्रबाधतेऽथानुगृहाण शोभने॥ ४/२५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.035.m4a", "display_order": 36}, {"id": 6000089036, "chapter_id": 10089, "verse_number": "४-२५-३२", "content_sanskrit": "त्वदाननं सुभ्रु सुतारलोचनं व्यालम्बिनीलालकवृन्दसंवृतम्।\nउन्नीय मे दर्शय वल्गुवाचकं यद् व्रीडया नाभिमुखं शुचिस्मिते॥ ४/२५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.036.m4a", "display_order": 37}, {"id": 6000089037, "chapter_id": 10089, "verse_number": "४-२५-३३", "content_sanskrit": "इत्थं पुरञ्जनं नारी याचमानमधीरवत्।\nअभ्यभाषत तं वीरं हसन्ती वीरमोहिनी॥ ४/२५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.037.m4a", "display_order": 38}, {"id": 6000089038, "chapter_id": 10089, "verse_number": "४-२५-३४", "content_sanskrit": "न विदाम वयं सम्यक् कर्तारं पुरुषर्षभ।\nआत्मनश्च परस्यापि गोत्रं नाम च यत् कृतम्॥ ४/२५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.038.m4a", "display_order": 39}, {"id": 6000089039, "chapter_id": 10089, "verse_number": "४-२५-३५", "content_sanskrit": "इहाद्य सन्तमात्मानं विदाम न ततः परम्।\nयेनेयं निर्मिता वीर पुरी शरणमात्मनः॥ ४/२५/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.039.m4a", "display_order": 40}, {"id": 6000089040, "chapter_id": 10089, "verse_number": "४-२५-३६", "content_sanskrit": "एते सखायः सख्यो मे नरा नार्यश्च मानद।\nसुप्तायां मयि जागर्ति नागोऽयं पालयन् पुरीम्॥ ४/२५/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.040.m4a", "display_order": 41}, {"id": 6000089041, "chapter_id": 10089, "verse_number": "४-२५-३७", "content_sanskrit": "दिष्ट्याऽऽगतोऽसि भद्रं ते ग्राम्यान्भोगानभीप्ससे।\nउद्वहिष्यामि त्वां स्नेहं स्वबन्धुभिररिन्दम॥ ४/२५/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.041.m4a", "display_order": 42}, {"id": 6000089042, "chapter_id": 10089, "verse_number": "४-२५-३८", "content_sanskrit": "इमां त्वमधितिष्ठस्व पुरीं नवमुखीं विभो।\nमयोपनीतान् गृह्णानः कामभोगान् शतं समाः॥ ४/२५/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.042.m4a", "display_order": 43}, {"id": 6000089043, "chapter_id": 10089, "verse_number": "४-२५-३९", "content_sanskrit": "का नु त्वदन्यं रमयेदरतिज्ञमकोविदम्।\nअसांपरायाभिमुखमश्वस्तनविदं पशुम्॥ ४/२५/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.043.m4a", "display_order": 44}, {"id": 6000089044, "chapter_id": 10089, "verse_number": "४-२५-४०", "content_sanskrit": "धर्मो ह्यत्रार्थकामौ च प्रजानन्दोऽमृतं यशः।\nलोका विशोका विरजा यान् न केवलिनो विदुः॥ ४/२५/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.044.m4a", "display_order": 45}, {"id": 6000089045, "chapter_id": 10089, "verse_number": "४-२५-४१", "content_sanskrit": "पितृदेवर्षिमर्त्यानां भूतानामात्मनश्च ह।\nक्षेम्यं वदन्ति शरणं भवेऽस्मिन् यद् गृहाश्रमम्॥ ४/२५/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.045.m4a", "display_order": 46}, {"id": 6000089046, "chapter_id": 10089, "verse_number": "४-२५-४२", "content_sanskrit": "का नाम वीर विख्यातं वदान्यं प्रियदर्शनम्।\nन वृणीत पतिं प्राप्तं मादृशी त्वादृशं स्वयम्॥ ४/२५/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.046.m4a", "display_order": 47}, {"id": 6000089047, "chapter_id": 10089, "verse_number": "४-२५-४३", "content_sanskrit": "कस्या मनस्ते भुजगेन्द्रभोगयोः स्‍त्रियो न सज्जेद् भुजयोर्महाभुज।\nयोऽनाथवर्गाधिमलं घृणोद्धतस्मितावलोकेन चरस्यपोहितुम्॥ ४/२५/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.047.m4a", "display_order": 48}, {"id": 6000089048, "chapter_id": 10089, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.048.m4a", "display_order": 49}, {"id": 6000089049, "chapter_id": 10089, "verse_number": "४-२५-४४", "content_sanskrit": "इति तौ दम्पती तत्र समुह्य समयं मिथः।\nतां प्रविश्य पुरीं राजन् मुमुदाते शतं समाः॥ ४/२५/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.049.m4a", "display_order": 50}, {"id": 6000089050, "chapter_id": 10089, "verse_number": "४-२५-४५", "content_sanskrit": "उपगीयमानो ललितं तत्र तत्र च गायकैः।\nक्रीडन् परिवृतः स्‍त्रीभिर्ह्रदिनीमाविशच्छुचौ॥ ४/२५/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.050.m4a", "display_order": 51}, {"id": 6000089051, "chapter_id": 10089, "verse_number": "४-२५-४६", "content_sanskrit": "सप्तोपरि कृता द्वारः पुरस्तस्यास्तु द्वे अधः।\nपृथग् विषयगत्यर्थं तस्यां यः कश्चनेश्वरः॥ ४/२५/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.051.m4a", "display_order": 52}, {"id": 6000089052, "chapter_id": 10089, "verse_number": "४-२५-४७", "content_sanskrit": "पञ्चद्वारस्तु पौरस्त्या दक्षिणैका तथोत्तरा।\nपश्चिमे द्वे अमूषां ते नामानि नृप वर्णये॥ ४/२५/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.052.m4a", "display_order": 53}, {"id": 6000089053, "chapter_id": 10089, "verse_number": "४-२५-४८", "content_sanskrit": "खद्योताविर्मुखी च प्राग्द्वारावेकत्र निर्मिते।\nविभ्राजितं जनपदं याति ताभ्यां द्युमत्सखः॥ ४/२५/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.053.m4a", "display_order": 54}, {"id": 6000089054, "chapter_id": 10089, "verse_number": "४-२५-४९", "content_sanskrit": "नलिनी नालिनी च प्राग्द्वारावेकत्र निर्मिते।\nअवधूतसखस्ताभ्यां विषयं याति सौरभम्॥ ४/२५/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.054.m4a", "display_order": 55}, {"id": 6000089055, "chapter_id": 10089, "verse_number": "४-२५-५०", "content_sanskrit": "मुख्या नाम पुरस्ताद् द्वास्तयाऽऽपणबहूदनौ।\nविषयौ याति पुरराट् रसज्ञविपणान्वितः॥ ४/२५/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.055.m4a", "display_order": 56}, {"id": 6000089056, "chapter_id": 10089, "verse_number": "४-२५-५१", "content_sanskrit": "पितृभूर्नृप पुर्या द्वाः दक्षिणेन पुरञ्जनः।\nराष्ट्रं दक्षिणपाञ्चालं याति श्रुतधरान्वितः॥ ४/२५/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.056.m4a", "display_order": 57}, {"id": 6000089057, "chapter_id": 10089, "verse_number": "४-२५-५२", "content_sanskrit": "देवभूर्नाम पुर्या द्वाः उत्तरेण पुरञ्जनः।\nराष्ट्रमुत्तरपाञ्चालं याति श्रुतधरान्वितः॥ ४/२५/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.057.m4a", "display_order": 58}, {"id": 6000089058, "chapter_id": 10089, "verse_number": "४-२५-५३", "content_sanskrit": "आसुरी नाम पश्चाद् द्वास्तया याति पुरञ्जनः।\nग्राम्यकं नाम विषयं दुर्मदेन समन्वितः॥ ४/२५/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.058.m4a", "display_order": 59}, {"id": 6000089059, "chapter_id": 10089, "verse_number": "४-२५-५४", "content_sanskrit": "निर्ऋतिर्नाम पश्चाद्द्वास्तया याति पुरञ्जनः।\nवैशसं नाम विषयं लुब्धकेन समन्वितः॥ ४/२५/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.059.m4a", "display_order": 60}, {"id": 6000089060, "chapter_id": 10089, "verse_number": "४-२५-५५", "content_sanskrit": "अन्धावमीषां पौराणां निर्वाक्योपस्करावुभौ।\nअक्षण्वतामधिपतिस्ताभ्यां याति करोति च॥ ४/२५/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.060.m4a", "display_order": 61}, {"id": 6000089061, "chapter_id": 10089, "verse_number": "४-२५-५६", "content_sanskrit": "स्वयं त्वन्तःपुरगतो विषूचिना समन्वितः।\nमोहं प्रसादं हर्षं वा याति जायात्मजोद्भवम्॥ ४/२५/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.061.m4a", "display_order": 62}, {"id": 6000089062, "chapter_id": 10089, "verse_number": "४-२५-५७", "content_sanskrit": "एवं कर्मसु संसक्तः कामात्मा वञ्चितोऽबुधः।\nमहिषी यद् यदीहेत तत् तदेवान्ववर्तत॥ ४/२५/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.062.m4a", "display_order": 63}, {"id": 6000089063, "chapter_id": 10089, "verse_number": "४-२५-५८", "content_sanskrit": "क्‍वचित् पिबन्त्यां पिबति मदिरां मदविह्वलः।\nअश्नन्त्यां क्‍वचिदश्नाति जक्षत्यां सह जक्षति॥ ४/२५/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.063.m4a", "display_order": 64}, {"id": 6000089064, "chapter_id": 10089, "verse_number": "४-२५-५९", "content_sanskrit": "क्‍वचिद्गायति गायन्त्यां रुदन्त्यां रुदतिक्‍वचित्।\nक्‍वचिद्धसन्त्यां हसति जल्पन्त्यामनुजल्पति॥ ४/२५/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.064.m4a", "display_order": 65}, {"id": 6000089065, "chapter_id": 10089, "verse_number": "४-२५-६०", "content_sanskrit": "क्‍वचिद्धावति धावन्त्यां तिष्ठन्त्यामनुतिष्ठति।\nअनुशेते शयानायामन्वास्ते क्‍वचिदासतीम्॥ ४/२५/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.065.m4a", "display_order": 66}, {"id": 6000089066, "chapter_id": 10089, "verse_number": "४-२५-६१", "content_sanskrit": "क्‍वचिच्छृणोति शृण्वन्त्यां पश्यन्त्यामनुपश्यति।\nक्‍वचिज्जिघ्रति जिघ्रन्त्यां स्पृशन्त्यां स्पृशति क्‍वचित्॥ ४/२५/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.066.m4a", "display_order": 67}, {"id": 6000089067, "chapter_id": 10089, "verse_number": "४-२५-६२", "content_sanskrit": "क्‍वचिच्च शोचतीं जायामनुशोचति दीनवत्।\nअनुहृष्यति हृष्टायां मुदितामनुमोदते॥ ४/२५/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.067.m4a", "display_order": 68}, {"id": 6000089068, "chapter_id": 10089, "verse_number": "४-२५-६३", "content_sanskrit": "विप्रलब्धो महिष्यैवं सर्वप्रकृतिवञ्चितः।\nनेच्छन्ननुकरोत्यज्ञः क्लैब्यात् क्रीडामृगो यथा॥ ४/२५/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_025/BhP_04.025.068.m4a", "display_order": 69}, {"id": 6000089069, "chapter_id": 10089, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे पञ्चविंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}]