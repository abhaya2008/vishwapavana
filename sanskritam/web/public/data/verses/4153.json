[{"id": 2146205, "chapter_id": 4153, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2146206, "chapter_id": 4153, "verse_number": "१", "content_sanskrit": "उपप्लाव्यादिह क्षत्तरुपयातो जनार्दनः ।\nकुशस्थले निवसति स च प्रातरिहैष्यति\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2146207, "chapter_id": 4153, "verse_number": "२", "content_sanskrit": "आहुकानामधिपतिः पुरोगः सर्वसात्वताम् ।\nमहामना महावीर्यो महामात्रो जनार्दनः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2146208, "chapter_id": 4153, "verse_number": "३", "content_sanskrit": "स्फीतस्य वृष्णिवंशस्य भर्ता गोप्ता च माधवः ।\nत्रयाणामपि लोकानां भगवान् प्रपितामहः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2146209, "chapter_id": 4153, "verse_number": "४", "content_sanskrit": "वृष्ण्यन्धकाः सुमनसो यस्य प्रज्ञामुपासते ।\nआदित्या वसवो रुद्रा यथा बुद्धिं बृहस्पतेः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2146210, "chapter_id": 4153, "verse_number": "५", "content_sanskrit": "तस्मै पूजां प्रयोक्ष्यामि दाशार्हाय महात्मने ।\nप्रत्यक्षं तव धर्मज्ञ तन्मे कथयतः शृणु\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2146211, "chapter_id": 4153, "verse_number": "६", "content_sanskrit": "एकवर्णैः सुपुष्टाङ्गैर्बाह्लिकैश्च हयोत्तमैः ।\nचतुर्युक्तान् रथांस्तस्मै रौग्मान् दास्यामि षोडश\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2146212, "chapter_id": 4153, "verse_number": "७", "content_sanskrit": "नित्यप्रभिन्नान् मातङ्गान् ईषादन्तान् प्रहारिणः ।\nअष्टानुचरमैकैकमष्टौ दास्यामि केशवे\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2146213, "chapter_id": 4153, "verse_number": "८", "content_sanskrit": "दासीनामप्रजातानां शुभानां रुग्मवर्चसाम् ।\nशतमस्मै प्रदास्यामि दासानामपि तावताम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2146214, "chapter_id": 4153, "verse_number": "९", "content_sanskrit": "आविकं च सुखस्पर्शं पार्वतीयैरुपाहृतम् ।\nतदप्यस्मै प्रदास्यामि सहस्राणि दशाष्ट च\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2146215, "chapter_id": 4153, "verse_number": "१०", "content_sanskrit": "अजिनानां सहस्राणि चीनदेशोद्भवानि च ।\nतान्यप्यस्मै प्रदास्यामि यावदर्हति केशवः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2146216, "chapter_id": 4153, "verse_number": "११", "content_sanskrit": "दिवा रात्रौ च भात्येष सुतेजा विमलो मणिः ।\nतमप्यस्मै प्रदास्यामि तमप्यर्हति केशवः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2146217, "chapter_id": 4153, "verse_number": "१२", "content_sanskrit": "एकेनाभिपतत्यह्ना योजनानि चतुर्दश ।\nयानमश्वतरीयुक्तं तदप्यस्मै ददाम्यहम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2146218, "chapter_id": 4153, "verse_number": "१३", "content_sanskrit": "यावन्ति वाहनान्यस्य यावन्तः पुरुषाश्च वै ।\nततोऽष्टगुणमप्यस्मै भोज्यं दास्याम्यहं सदा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2146219, "chapter_id": 4153, "verse_number": "१४", "content_sanskrit": "मम पुत्राश्च पौत्राश्च सर्वे दुर्योधनादृते ।\nप्रत्युद्यास्यन्ति दाशार्हं रथैर्मृष्टैः स्वलङ्कृताः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2146220, "chapter_id": 4153, "verse_number": "१५", "content_sanskrit": "स्वलङ्कृताश्च कल्याण्यः पादैरेव सहस्रशः ।\nवारमुख्या महाभागं प्रत्युद्यास्यन्ति केशवम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2146221, "chapter_id": 4153, "verse_number": "१६", "content_sanskrit": "नगरादपि याः काश्चिद् गमिष्यन्ति जनार्दनम् ।\nद्रष्टुं कन्याश्च कल्याण्यः ताश्च यास्यन्त्यनावृताः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2146222, "chapter_id": 4153, "verse_number": "१७", "content_sanskrit": "सस्त्रीपुरुषबालं च नगरं मधुसूदनम् ।\nउदीक्षतां महात्मानं भानुमन्तमिव प्रजाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2146223, "chapter_id": 4153, "verse_number": "१८", "content_sanskrit": "महाध्वजपताकाश्च क्रियन्तां सर्वतो दिशः ।\nजलावसिक्तो विरजाः पन्थाः कार्यस्तु सर्वतः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2146224, "chapter_id": 4153, "verse_number": "१९", "content_sanskrit": "दुःशासनस्य च गृहं दुर्योधनगृहाद् वरम् ।\nतदद्य क्रियतां क्षिप्रं सुसम्मृष्टमलङ्कृतम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2146225, "chapter_id": 4153, "verse_number": "२०", "content_sanskrit": "एतद्धि रुचिराकारैः प्रासादैरुपशोभितम् ।\nशिवं च रमणीयं च सर्वत्र सुमनोरमम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2146226, "chapter_id": 4153, "verse_number": "२१", "content_sanskrit": "सर्वमस्मिन् गृहे रत्नं मम दुर्योधनस्य च ।\nयद्यदर्हति वार्ष्णेयः तत्तद् देयमसंशयम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2146227, "chapter_id": 4153, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2146228, "chapter_id": 4153, "verse_number": "२२", "content_sanskrit": "राजन् बहुमतश्चासि त्रैलोक्यस्यापि सत्तमः ।\nसम्भावितश्च लोकस्य सम्मतश्चासि भारत\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2146229, "chapter_id": 4153, "verse_number": "२३", "content_sanskrit": "यत् त्वमेवं गते(तं) ब्रूयाः पश्चिमे वयसि स्थितः ।\nशास्त्राद्वा कारणाद्वापि सुस्थिरः स्थविरो ह्यसि\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2146230, "chapter_id": 4153, "verse_number": "२४", "content_sanskrit": "लेखाऽश्मनीव भाः सूर्ये महोर्मिरिव सागरे ।\nधर्मस्त्वयि महाराज इति व्यवसिताः प्रजाः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2146231, "chapter_id": 4153, "verse_number": "२५", "content_sanskrit": "सदैव भावितो लोको गुणौघैस्तव पार्थिव ।\nगुणानां रक्षणे नित्यं प्रयतस्व सबान्धवः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2146232, "chapter_id": 4153, "verse_number": "२६", "content_sanskrit": "आर्जवं प्रतिपद्यस्व मा बाल्याद् बहुधा नशीः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2146233, "chapter_id": 4153, "verse_number": "२७", "content_sanskrit": "राजन् पुत्रांश्च पौत्रांश्च सुहृदश्चैव सुप्रियान् ।\nयत् त्वं दित्ससि कृष्णाय राजन्नतिथये बहु\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2146234, "chapter_id": 4153, "verse_number": "२८", "content_sanskrit": "एतदन्यच्च दाशार्हः पृथिवीमपि चार्हति\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2146235, "chapter_id": 4153, "verse_number": "२९", "content_sanskrit": "न तु त्वं धर्ममुद्दिश्य तस्य वा प्रियकारणात् ।\nएतद् दित्ससि कृष्णाय सत्येनात्मानमालभे\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2146236, "chapter_id": 4153, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्याम् उद्योगपर्वणि चतुरशीतितमोऽध्यायः ॥८४॥\nभगवद्यानपर्वणि पञ्चदशोऽध्यायः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]