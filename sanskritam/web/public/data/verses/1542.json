[{"id": 2025203, "chapter_id": 1542, "verse_number": "३-१८०-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2025204, "chapter_id": 1542, "verse_number": "३-१८०-१", "content_sanskrit": "कथं नागायुतप्राणो भीमो भीमपराक्रमः।\nभयमाहारयत्तीव्रं तस्मादजगरान्मुने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2025205, "chapter_id": 1542, "verse_number": "३-१८०-२", "content_sanskrit": "पौलस्त्यं धनदं युद्दे य आह्वयति दर्पितः।\nनलिन्यां कदनं कृत्वा निहन्ता यक्षरक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2025206, "chapter_id": 1542, "verse_number": "३-१८०-३", "content_sanskrit": "तं संससि भयाविष्टमापन्नमरिसूदनम्।\nएतदिच्छाम्यहं श्रोतुं परं कौतूहलं हि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2025207, "chapter_id": 1542, "verse_number": "३-१८०-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2025208, "chapter_id": 1542, "verse_number": "३-१८०-४", "content_sanskrit": "बह्वाश्चर्ये वने तेषां वसतामुग्रधन्विनाम्।\nप्राप्तानामाश्रमं राजन्राजर्षेर्वृषपर्वणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2025209, "chapter_id": 1542, "verse_number": "३-१८०-५", "content_sanskrit": "यदृच्छया धनुष्पाणिर्बद्धखङ्गो वृकोदरः।\nददर्श तद्वनं रम्यं देवगन्धर्वसेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2025210, "chapter_id": 1542, "verse_number": "३-१८०-६", "content_sanskrit": "स ददर्श शुभान्देशान्गिरेर्हिमवतस्तदा।\nदेवर्षिसिद्धचरितानप्सरोगणसेवितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2025211, "chapter_id": 1542, "verse_number": "३-१८०-७", "content_sanskrit": "चकोरैरुपचक्रैशच् पक्षिभिर्जीवजीवकैः।\nकोकिलैर्भृङ्गराजैश्च तत्र तत्र निनादितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2025212, "chapter_id": 1542, "verse_number": "३-१८०-८", "content_sanskrit": "नित्यपुष्पफलैर्वृक्षैर्हिमसंस्पर्शकोमलैः।\nउपेतान्बहुलच्छायैर्मनोनयननन्दनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2025213, "chapter_id": 1542, "verse_number": "३-१८०-९", "content_sanskrit": "स संपश्यन्गिरिनदीर्वैडूर्यमणिसंनिभैः।\nसलिलैर्हिमसंकाशैर्हंसकारण्डवायुतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2025214, "chapter_id": 1542, "verse_number": "३-१८०-१०", "content_sanskrit": "वनानि देवदारूणां मेघानामिव वागुराः।\nहरिचन्दनमिश्राणि तुङ्गकालीयकान्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2025215, "chapter_id": 1542, "verse_number": "३-१८०-११", "content_sanskrit": "मृगयां परिधावन्स समेषु मरुधन्वसु।\nविध्यन्मृगाञ्शरैः शुद्धैश्चचार स महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2025216, "chapter_id": 1542, "verse_number": "३-१८०-१२", "content_sanskrit": "भीमसेनस्तु विख्यातो महान्तं दंष्ट्रिणं बलात्।\nनिघ्नन्नागशतप्राणो वने तस्मिन्महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2025217, "chapter_id": 1542, "verse_number": "३-१८०-१३", "content_sanskrit": "मृगाणां सवराहाणां महिषाणां महाभुजः।\nविनिघ्नंस्तत्रतत्रैव भीमो भीमपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2025218, "chapter_id": 1542, "verse_number": "३-१८०-१४", "content_sanskrit": "स मातङ्गशतप्राणो मनुष्यशतवारणः।\nसिंहशार्दूलविक्रान्तो वने तस्मिन्महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2025219, "chapter_id": 1542, "verse_number": "३-१८०-१५", "content_sanskrit": "वृक्षानुत्पाटयामास तरसा वै बभञ्ज च।\nपृथिव्याश्च प्रदेशान्वै नादयंस्तु वनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2025220, "chapter_id": 1542, "verse_number": "३-१८०-१६", "content_sanskrit": "पर्वताग्राणि वै मृद्गन्नादयानश्च विज्वरः।\nप्रक्षिपन्पादपांश्चापि नादेनापूरयन्महीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2025221, "chapter_id": 1542, "verse_number": "३-१८०-१७", "content_sanskrit": "वेगेन न्यपतद्भीमो निर्भयश्च पुनः पुनः।\nआस्फोटयन्क्ष्वेडयंश्च तलतालांश्च वादयन्।\nचिरसंबद्धदर्पस्तु भीमसेनो वने तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2025222, "chapter_id": 1542, "verse_number": "३-१८०-१८", "content_sanskrit": "गजेनद्राश्च महासत्वा मृगेन्द्राश्च महाबलाः।\nभीमसेनस्य नादेन व्यमुञ्चन्त गुहा भयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2025223, "chapter_id": 1542, "verse_number": "३-१८०-१९", "content_sanskrit": "क्वचित्प्रधावंस्तिष्ठंश्च क्वचिच्चोपविशंस्तथा।\nमृगप्रेप्सुर्महारौद्रे वने चरति निर्भयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2025224, "chapter_id": 1542, "verse_number": "३-१८०-२०", "content_sanskrit": "स तत्रमनुजव्याघ्रो वने वनचरोपमः।\nपद्भ्यामभिसमापेदे भीमसेनो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2025225, "chapter_id": 1542, "verse_number": "३-१८०-२१", "content_sanskrit": "स प्रविष्टो महारण्ये नादान्नदति चाद्भुतान्।\nत्रासयन्सर्वभूतानि महासत्वपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2025226, "chapter_id": 1542, "verse_number": "३-१८०-२२", "content_sanskrit": "ततो भीमस्य शब्देन भीताः सर्पा गुहाशयाः।\nअतिक्रान्तास्तु वेगेन जगामानुसृतः शनैः।\nततोऽमरवरप्रख्यो भीमसेनो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2025227, "chapter_id": 1542, "verse_number": "३-१८०-२३", "content_sanskrit": "स ददर्श महाकायं भुजङ्गं रोमहर्षणम्।\nगिरिदुर्गे समापन्नं कायेनावृत्य कन्दरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2025228, "chapter_id": 1542, "verse_number": "३-१८०-२४", "content_sanskrit": "पर्वताभोगवर्ष्माणं भोगैश्चन्द्रार्कमण्डलैः।\nचित्राङ्गमङ्गजैश्चित्रैर्हरिद्रासदृशच्छविम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2025229, "chapter_id": 1542, "verse_number": "३-१८०-२५", "content_sanskrit": "गुहाकारेण वक्रेण चतुर्दंष्ट्रेण राजता।\nदीप्ताक्षेणातिताम्रेण लिहानं सृक्विणी मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2025230, "chapter_id": 1542, "verse_number": "३-१८०-२६", "content_sanskrit": "त्रासनं सर्वभूतानां कालान्तकयमोपमम्।\nनिःश्वासक्ष्वेडनादेन भर्त्सयन्तमिव स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2025231, "chapter_id": 1542, "verse_number": "३-१८०-२७", "content_sanskrit": "स भीमं सहसाऽभ्येत्य पृदाकुः क्षुधितो भृशम्।\nजग्राहाजगरो ग्राहो भुजयोरुभयोर्बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2025232, "chapter_id": 1542, "verse_number": "३-१८०-२८", "content_sanskrit": "तेन संस्पृष्टगात्रस्य भीमसेनस्य वै तदा।\nसंज्ञा मुमोह सहसा वरदानेन तस्य हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2025233, "chapter_id": 1542, "verse_number": "३-१८०-२९", "content_sanskrit": "दशनागसहस्राणि धारयन्ति हि यद्बलम्।\nइद्रलं भीमसेनस्य भुजयोरसमं परैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2025234, "chapter_id": 1542, "verse_number": "३-१८०-३०", "content_sanskrit": "स तेजस्वी तथा तेन भुजगेन वशीकृतः।\nविम्फुरञ्शनकैर्भीमो न शशाक विचेष्टितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2025235, "chapter_id": 1542, "verse_number": "३-१८०-३१", "content_sanskrit": "नागायुतसमप्राणः सिंहस्कन्धो महाभुजः।\nगृहीतो व्यजहात्सत्वं वरदानविमोहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2025236, "chapter_id": 1542, "verse_number": "३-१८०-३२", "content_sanskrit": "स हि प्रयत्नमकरोत्तीव्रमात्मविमोक्षणे।\nन चैनमशकद्वीरः कथंचित्प्रतिबाधितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2025237, "chapter_id": 1542, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि आजगरपर्वणि अशीत्यधिकशततमोऽध्यायः ॥ १८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]