[{"id": 2098504, "chapter_id": 3107, "verse_number": "१३-२३७-१", "content_sanskrit": "उमोवाच।\nभगवन्देवदेवेश विशिष्टं यज्ञमुच्यते।\nलौकिकं वैदिकं चैव तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2098505, "chapter_id": 3107, "verse_number": "१३-२३७-२x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2098506, "chapter_id": 3107, "verse_number": "१३-२३७-२", "content_sanskrit": "देवतानां तु पूजा या यज्ञेष्वेव समाहिता।\nयज्ञा वेदेष्वधीताश्च वेदा ब्राह्मणसंयुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2098507, "chapter_id": 3107, "verse_number": "१३-२३७-३", "content_sanskrit": "इदं तु सकलं दिव्यं दिवि वा भुवि वा प्रिये।\nयज्ञार्थं विद्धि तत्सृष्टं लोकानां हितकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2098508, "chapter_id": 3107, "verse_number": "१३-२३७-४", "content_sanskrit": "एवं विज्ञाय तत्कर्ता सदारः सततं द्विजः।\nप्रेत्यभावे लभेल्लोकान्ब्रह्मकर्मसमाधिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2098509, "chapter_id": 3107, "verse_number": "१३-२३७-५", "content_sanskrit": "ब्राह्मणेष्वेव तद्ब्रह्म नित्यं देवि समाहितम्।\nतस्माद्विप्रैर्यथाशास्त्रं विधिदृष्टेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2098510, "chapter_id": 3107, "verse_number": "१३-२३७-६", "content_sanskrit": "यज्ञकर्मि कृतं सर्वं देवता अभितर्पयेत्।\nब्राह्मणाः क्षत्रियाश्चैव यज्ञार्थं प्रायशः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2098511, "chapter_id": 3107, "verse_number": "१३-२३७-७", "content_sanskrit": "अग्निष्टोमादिभिर्यज्ञैर्वेदेषु परिकल्पितैः।\nसुशुद्धैर्यजमानैस्च ऋत्विग्भिश्च यथाविधिः।\nशुद्धैर्द्रव्योपकरणैर्यष्टव्यमिति निश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2098512, "chapter_id": 3107, "verse_number": "१३-२३७-८", "content_sanskrit": "तथा कृतेषु यज्ञेषु देवानां तोषणं भवेत्।\nतुष्टेषु सर्वदेवेषु यज्वा यज्ञफलं लभेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2098513, "chapter_id": 3107, "verse_number": "१३-२३७-९", "content_sanskrit": "देवाः सन्तोषिता यज्ञैर्लोकान्संवर्धयन्त्युत।\nउभयोर्लोकयोर्भूतिर्देवि यज्ञे प्रदृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2098514, "chapter_id": 3107, "verse_number": "१३-२३७-१०", "content_sanskrit": "तस्माद्यज्वा दिवं गत्वा अमरैः सह मोदते।\nनास्ति यज्ञसमं दानं नास्ति यज्ञसमो निधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2098515, "chapter_id": 3107, "verse_number": "१३-२३७-११", "content_sanskrit": "सर्वधर्मसमुद्देशो देवि यज्ञे समाहितः।\nएषा यज्ञकृता पूजा लौकिकीमपरां शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2098516, "chapter_id": 3107, "verse_number": "१३-२३७-१२", "content_sanskrit": "देवसत्कारमुद्दिश्य क्रियते लौकिकोत्सवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2098517, "chapter_id": 3107, "verse_number": "१३-२३७-१३", "content_sanskrit": "देवगोष्ठेऽधिसंस्कृत्य चोत्सवं यः करोति वै।\nयागान्देवोपहारांश्च शुचिर्भूत्वा यथाविधि।\nदेवान्सन्तोषयित्वा स देवि धर्ममवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2098518, "chapter_id": 3107, "verse_number": "१३-२३७-१४", "content_sanskrit": "गन्धमाल्यैश्च विविधैः परमान्नेन धूपनैः।\nबह्वीभिः स्तुतिभिश्चैव स्तुवद्भिः प्रयतैर्नरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2098519, "chapter_id": 3107, "verse_number": "१३-२३७-१५", "content_sanskrit": "नृत्तैर्वाद्यैश्च गान्धर्वैरन्यैर्दृष्टिविलोभनैः।\nदेवसत्कारमुद्दिश्य कुर्वते ये नरा भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2098520, "chapter_id": 3107, "verse_number": "१३-२३७-१६", "content_sanskrit": "तेषां भक्तिकृतेनैव सत्कारेणैव पूजिताः।\nतेनैव तोषं संयान्ति देवि देवास्त्रिविष्टपे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2098521, "chapter_id": 3107, "verse_number": "१३-२३७-१७", "content_sanskrit": "मानुषैश्चोपकारैर्वा शुचिभिः सत्परायणैः।\nब्रह्मचर्यपरैरेतत्कृतं धर्मफलं लभेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2098522, "chapter_id": 3107, "verse_number": "१३-२३७-१८", "content_sanskrit": "केवलैः स्तुतिभिर्देवि गन्धमाल्यसमाहितैः।\nप्रयतैः शुद्धगात्रैस्तु शुद्धदेशे सुपूजिताः।\nसन्तोषं यान्ति ते देवा भक्तैः सम्पूजितास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2098523, "chapter_id": 3107, "verse_number": "१३-२३७-१९", "content_sanskrit": "देवान्सन्तोषयित्वैव देवि धर्ममवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2098524, "chapter_id": 3107, "verse_number": "१३-२३७-२०x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2098525, "chapter_id": 3107, "verse_number": "१३-२३७-२०", "content_sanskrit": "त्रिविष्टपस्था वै भूमौ देवा मानुषचेष्टितम्।\nकथं ज्ञास्यन्ति विधिवत्तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2098526, "chapter_id": 3107, "verse_number": "१३-२३७-२१x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2098527, "chapter_id": 3107, "verse_number": "१३-२३७-२१", "content_sanskrit": "तदहं तेप्रवक्ष्यामि यथा तैर्विद्यते प्रिये।\nप्राणिनां तु शरीरेषु अन्तरात्मा व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2098528, "chapter_id": 3107, "verse_number": "१३-२३७-२२", "content_sanskrit": "आत्मानं परमं देवमिति विद्धि शुभेक्षणे।\nआत्मा मनोव्यवस्थानात्सर्वं वेत्ति शुभाशुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2098529, "chapter_id": 3107, "verse_number": "१३-२३७-२३", "content_sanskrit": "आत्मैव देवास्तद्विद्युरव्यग्रमनसा कृतम्।\nसतां मनोव्यवस्थानाच्छुभं भवति वै नृणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2098530, "chapter_id": 3107, "verse_number": "१३-२३७-२४", "content_sanskrit": "तस्माद्देवाऽभिसम्पूज्या ब्राह्मणानां तथैव च।\nयज्ञाश्च धर्मकार्याणि गुरुपूजा च शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2098531, "chapter_id": 3107, "verse_number": "१३-२३७-२५", "content_sanskrit": "शुद्धगात्रैर्व्रतयुतैस्तन्मयैस्तत्परायणैः।\nएवं व्यवस्थितैर्नित्यं कर्तव्यमिति निश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2098532, "chapter_id": 3107, "verse_number": "१३-२३७-२६", "content_sanskrit": "एवं कृत्वा शुभाकाङ्क्षी परत्रेह च मोदते।\nअन्यथा मन आविश्य कृतं न फलति प्रिये।\nऋतेऽपि तु मनो देवि अशुभं फलति ध्रुवम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2098533, "chapter_id": 3107, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि सप्तत्रिंशदधिकद्विशततमोऽध्यायः॥ २३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]