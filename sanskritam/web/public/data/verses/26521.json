[{"id": 7006521000, "chapter_id": 26521, "verse_number": "३-६०-१", "content_sanskrit": "कुबेरस्य अनुह्रादेन सार्द्धं भयंकरं युद्धम् वैशम्पायन उवाच धनाध्यक्षमनुह्रादः प्रह्रादस्यानुजो बली ।\nससैन्यं योधयामास क्षोभयन् यक्षवाहिनीम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006521001, "chapter_id": 26521, "verse_number": "३-६०-२", "content_sanskrit": "महता च बलौघेन त्वनुह्रादोऽसुरोत्तमः ।\nअर्दयामास संक्रुद्धो धनाध्यक्षं प्रतापवान् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006521002, "chapter_id": 26521, "verse_number": "३-६०-३", "content_sanskrit": "अमृष्यमाणस्त्रिदशानाहवस्थानुदायुधान् ।\nचकार कदनं घोरं धनुष्पाणिर्महासुरः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006521003, "chapter_id": 26521, "verse_number": "३-६०-४", "content_sanskrit": "आवर्त इव संजज्ञे बलस्य महतो महान् ।\nक्षुभितस्याप्रमेयस्य सागरस्येव सम्प्लवे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006521004, "chapter_id": 26521, "verse_number": "३-६०-५", "content_sanskrit": "त्रिदशानां शरीरैस्तु दानवानां च मेदिनी ।\nबभूव निचिता घोरैः पर्वतैरिव सम्प्लवे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006521005, "chapter_id": 26521, "verse_number": "३-६०-६", "content_sanskrit": "मेरुपृष्ठं तु रक्तेन रञ्जितं सम्प्रकाशते ।\nसर्वतो माधवे मासि पुष्पितैरिव किंशुकः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006521006, "chapter_id": 26521, "verse_number": "३-६०-७", "content_sanskrit": "हतैर्वीरैर्गजैरश्वैः प्रावर्तत महानदी ।\nशोणितौघा महाघोरा यमराष्ट्रविवर्धिनी ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006521007, "chapter_id": 26521, "verse_number": "३-६०-८", "content_sanskrit": "शकृन्मेदोमहापङ्का सम्प्रकीर्णान्त्रशैवला ।\nछिन्नकायशिरोमीना अङ्गावयवशाद्वला ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006521008, "chapter_id": 26521, "verse_number": "३-६०-९", "content_sanskrit": "गृध्रहंससमाकीर्णा केकिसारसनादिता ।\nवसाफेनसमाकीर्णा प्रोत्क्रुष्टस्तनितस्वरा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006521009, "chapter_id": 26521, "verse_number": "३-६०-१०", "content_sanskrit": "तां कापुरुषदुस्तारां युद्धभूमौ महानदीम् ।\nनदीमिवातपापाये हंससंघोपशोभिताम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006521010, "chapter_id": 26521, "verse_number": "३-६०-११", "content_sanskrit": "त्रिदशा दानवाश्चैव तेरुस्ते दुस्तरां नदीम् ।\nयथा पद्मरजोध्वस्तां नलिनीं गजयूथपाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006521011, "chapter_id": 26521, "verse_number": "३-६०-१२", "content_sanskrit": "ततः सृजन्तं बाणौघाँननुह्रादं रथे स्थितम् ।\nददर्श तरसा देवो निघ्नन्तं यक्षवाहिनीम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006521012, "chapter_id": 26521, "verse_number": "३-६०-१३", "content_sanskrit": "क्रुद्धस्ततो दैत्यबलं सूदयामास वित्तपः ।\nविक्षिपन्निव खे वायुर्महाभ्रपटलं बलात् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006521013, "chapter_id": 26521, "verse_number": "३-६०-१४", "content_sanskrit": "समीक्ष्य तुमुलं युद्धमनुह्रादश्च वीर्यवान् ।\nरथेनादित्यवर्णेन कुबेरमभिदुद्रुवे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006521014, "chapter_id": 26521, "verse_number": "३-६०-१५", "content_sanskrit": "स धनुर्धन्विनां श्रेष्ठो विकृष्य रणमूर्धनि ।\nउत्ससर्ज शितान् बाणान्वित्तेशस्य महात्मनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006521015, "chapter_id": 26521, "verse_number": "३-६०-१६", "content_sanskrit": "कुबेरं प्राप्य ते बाणा निर्भिद्य सुसमाहिताः ।\nअपरान्पृष्ठतो जघ्नुर्व्यासक्तान्यक्षराक्षसान् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006521016, "chapter_id": 26521, "verse_number": "३-६०-१७", "content_sanskrit": "देवः शरैरभिहतो निशितैर्ज्वलनोपमैः ।\nअनुह्रादं प्रत्युदियात् संक्रुद्धः परमाहवे ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006521017, "chapter_id": 26521, "verse_number": "३-६०-१८", "content_sanskrit": "ततो वैश्रवणो राजा क्रुद्धो यक्षगणैः सह ।\nववर्ष शरवर्षाणि दानवं प्रति वीर्यवान् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006521018, "chapter_id": 26521, "verse_number": "३-६०-१९", "content_sanskrit": "तद्यथा शारदं वर्षं गोवृषः शीघ्रमागतम् ।\nअपारयन् वारयितुं प्रतिगृह्णन् निमीलितः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006521019, "chapter_id": 26521, "verse_number": "३-६०-२०", "content_sanskrit": "एवमेव कुबेरस्य शरवर्षं महासुरः ।\nनिमीलिताक्षः सहसा दैत्यः सहति दारुणम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006521020, "chapter_id": 26521, "verse_number": "३-६०-२१", "content_sanskrit": "रोषितः शरवर्षेण धनदेन महासुरः ।\nइन्द्रकेतुप्रतीकाशमभीतोऽपश्यत द्रुमम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006521021, "chapter_id": 26521, "verse_number": "३-६०-२२", "content_sanskrit": "प्रवृद्धशाखाविटपं तरुणाङ्कुरपल्लवम् ।\nउत्पाट्य कुपितो दैत्यस्तरुं फलसमन्वितम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006521022, "chapter_id": 26521, "verse_number": "३-६०-२३", "content_sanskrit": "निजघान हयाञ्छ्रेष्ठान् कुबेरस्य महात्मनः ।\nतस्य कर्म महाघोरं दृष्ट्वा सर्वे महासुराः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006521023, "chapter_id": 26521, "verse_number": "३-६०-२४", "content_sanskrit": "सिंहनादं नदन्ति स्म अनुह्रादप्रहर्षिताः ।\nतयोस्तु तुमुलं युद्धं संजज्ञे देवदैत्ययोः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006521024, "chapter_id": 26521, "verse_number": "३-६०-२५", "content_sanskrit": "ततस्तौ क्रोधरक्ताक्षावन्योन्यवधकाङ्क्षिणौ ।\nअन्योन्यं विविधैः शस्त्रैर्घोरैर्जघ्नतुराहवे ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006521025, "chapter_id": 26521, "verse_number": "३-६०-२६", "content_sanskrit": "त्रिदशा दानवान् सर्वे मथित्वा प्राणदंस्तदा ।\nदानवैस्त्रिदशाश्चापि क्रुद्धैर्भुवि निपातिताः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006521026, "chapter_id": 26521, "verse_number": "३-६०-२७", "content_sanskrit": "दानवास्त्वथ संक्रुद्धास्त्रिदशान् निशितैः शरैः ।\nविव्यधुर्वज्रसंकाशैः कङ्कपत्रैरजिह्मगैः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006521027, "chapter_id": 26521, "verse_number": "३-६०-२८", "content_sanskrit": "विदार्यमाणा दैत्यौघैस्त्रिदशास्तु महाबलाः ।\nअमर्षिततराश्चक्रुर्युद्धकर्माण्यभीतवत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006521028, "chapter_id": 26521, "verse_number": "३-६०-२९", "content_sanskrit": "तैर्गदाभिः सुभीमाभिः पट्टिशैः शूलमुद्गरैः ।\nपरिघैश्च सुतीक्ष्णाग्रैर्दानवाः पीडिताः शरैः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006521029, "chapter_id": 26521, "verse_number": "३-६०-३०", "content_sanskrit": "शरनिर्भिन्नगात्राश्च खड्गविच्छिन्नवक्षसः ।\nजगृहुस्ते शिलाश्चैव द्रुमाश्चासुरसत्तमाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006521030, "chapter_id": 26521, "verse_number": "३-६०-३१", "content_sanskrit": "ते भीमवेगा दितिजा नर्दमानाः पुनः पुनः ।\nममन्थुस्त्रिदशान् वीर्याच्छतशोऽथ सहस्रशः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006521031, "chapter_id": 26521, "verse_number": "३-६०-३२", "content_sanskrit": "ततस्तु तुमुलं युद्धं तेषां समभिवर्तत ।\nशिलाभिर्विपुलाभिश्च शतशश्चैव पादपैः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006521032, "chapter_id": 26521, "verse_number": "३-६०-३३", "content_sanskrit": "परिघैः पट्टिशैर्भल्लैर्भिन्दिपालैः परश्वधैः ।\nकेचिन्निवृत्तशिरसः केचिच्च विदलीकृताः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006521033, "chapter_id": 26521, "verse_number": "३-६०-३४", "content_sanskrit": "केचिद् विनिहता भूमौ रुधिरार्द्राः सुरासुराः ।\nकेचिद् रणाजिरान्नष्टाः परस्परवधार्दिताः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006521034, "chapter_id": 26521, "verse_number": "३-६०-३५", "content_sanskrit": "विभिन्नहृदयाः केचिच्छिन्नपादाश्च शेरते ।\nविदारितास्त्रिशूलैश्च केचित् तत्र गतासवः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006521035, "chapter_id": 26521, "verse_number": "३-६०-३६", "content_sanskrit": "तत् सुभीमं महद्युद्धं देवदानवसंकुलम् ।\nबभूव तुमुलं युद्धं शिलापादपसंकुलम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006521036, "chapter_id": 26521, "verse_number": "३-६०-३७", "content_sanskrit": "धनुर्ज्यातन्त्रिमधुरं हिक्कातालसमन्वितम् ।\nआर्तस्तनितघोषाढ्यं युद्धं गान्धर्वमाबभौ ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006521037, "chapter_id": 26521, "verse_number": "३-६०-३८", "content_sanskrit": "कुबेरः स धनुष्पाणिर्दानवान् रणमूर्धनि ।\nदिशो विद्रावयामास संक्रुद्धः शरवृष्टिभिः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006521038, "chapter_id": 26521, "verse_number": "३-६०-३९", "content_sanskrit": "कुबेरेणार्दितं सैन्यं विद्रुतं प्रेक्ष्य दानवः ।\nअम्यद्रवदनुह्रादः प्रगृह्य महतीं शिलाम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006521039, "chapter_id": 26521, "verse_number": "३-६०-४०", "content_sanskrit": "क्रोधाद् द्विगुणरक्ताक्षः पितृतुल्यपराक्रमः ।\nशिलां तां पातयामास कुबेरस्य रथोत्तमे ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006521040, "chapter_id": 26521, "verse_number": "३-६०-४१", "content_sanskrit": "आपतन्तीं शिलां दृष्ट्वा गदापाणिर्धनाधिपः ।\nरथादाप्लुत्य वेगेन वसुधायां व्यतिष्ठत ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006521041, "chapter_id": 26521, "verse_number": "३-६०-४२", "content_sanskrit": "सचक्रकूबरहयं सध्वजं सशरासनम् ।\nभङ्क्त्वा रथोत्तमं तस्य निपपात शिला भुवि ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006521042, "chapter_id": 26521, "verse_number": "३-६०-४३", "content_sanskrit": "विमथ्य तु कुबेरस्य प्रह्रादस्यानुजो रथम् ।\nशूराणां कदनं चक्रे सस्कन्धविटपैर्द्रुमैः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006521043, "chapter_id": 26521, "verse_number": "३-६०-४४", "content_sanskrit": "निर्भिन्नशिरसो भग्नास्त्रिदशाः शोणितोक्षिताः ।\nद्रुमप्रव्यथिताङ्गाश्च निपेतुर्धरणीतले ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006521044, "chapter_id": 26521, "verse_number": "३-६०-४५", "content_sanskrit": "विद्राव्य विपुलं सैन्यमनुह्रादो महासुरः ।\nगिरिशृङ्गं गृहीत्वा तु कुबेरमभिदुद्रुवे ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006521045, "chapter_id": 26521, "verse_number": "३-६०-४६", "content_sanskrit": "तमापतन्तं धनदो गदामुद्यम्य वीर्यवान् ।\nविनदित्वाऽऽह्वयामास दानवेन्द्रं महाबलम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006521046, "chapter_id": 26521, "verse_number": "३-६०-४७", "content_sanskrit": "तस्य दैत्यस्य संक्रुद्धो गदां तां बहुकण्टकाम् ।\nन्यपातयत वित्तेशो दानवस्योरसि प्रभो ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006521047, "chapter_id": 26521, "verse_number": "३-६०-४८", "content_sanskrit": "दैत्यः सक्रोधताम्राक्षस्तं प्रहारमचिन्तयन् ।\nवित्तेशस्योपरि तदा गिरिशृङगमपातयत् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006521048, "chapter_id": 26521, "verse_number": "३-६०-४९", "content_sanskrit": "स विह्वलितसर्वाङ्गो गिरिशृङ्गेण ताडितः ।\nपपात सहसा भूमौ विशीर्ण इव पर्वतः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006521049, "chapter_id": 26521, "verse_number": "३-६०-५०", "content_sanskrit": "वित्तेशं विह्वलं दृष्ट्वा सर्वे ते यक्षराक्षसाः ।\nपरिवार्य महात्मानं ररक्षुर्भीमविक्रमाः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006521050, "chapter_id": 26521, "verse_number": "३-६०-५१", "content_sanskrit": "मुहूर्तं विह्वलो भूत्वा पुनर्विश्रवसः सुतः ।\nउपतस्थे च सहसा धनदः क्रोधमूर्च्छितः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006521051, "chapter_id": 26521, "verse_number": "३-६०-५२", "content_sanskrit": "स ननाद महानादं त्रैलोक्यमभिनादयन् ।\nजनयन्निव निर्घोषं विधमन्निव पर्वतान् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006521052, "chapter_id": 26521, "verse_number": "३-६०-५३", "content_sanskrit": "तमवध्यं तु विज्ञाय निहन्तुं पुनरुत्थितम् ।\nप्रेक्ष्य पिङ्गाक्षमायान्तं दानवा विप्रदुद्रुवुः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006521053, "chapter_id": 26521, "verse_number": "३-६०-५४", "content_sanskrit": "तांस्तु विद्रवतो दृष्ट्वानुह्रादो ह्यसुरोऽब्रवीत् ।\nकालनेमिं दानवं च वीर्यदर्पसमन्वितम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006521054, "chapter_id": 26521, "verse_number": "३-६०-५५", "content_sanskrit": "आत्मानं चैव वीर्यं च विस्मृत्याभिजनं तथा ।\nक्व गच्छथ भयत्रस्ताः प्राकृता इव दानवाः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006521055, "chapter_id": 26521, "verse_number": "३-६०-५६", "content_sanskrit": "निवर्तध्वं महावीर्याः किं प्राणान् परिरक्षथ ।\nनालं युद्धाय यक्षोऽयं महतीयं विभीषिका ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006521056, "chapter_id": 26521, "verse_number": "३-६०-५७", "content_sanskrit": "एतां विभीषिकामद्य दानवानां समुत्थिताम् ।\nविक्रम्य विधमिष्यामि निवर्तध्वं महासुराः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006521057, "chapter_id": 26521, "verse_number": "३-६०-५८", "content_sanskrit": "तेऽसुराः संनिवृत्ताश्च समदा इव कुञ्जराः ।\nनिजघ्नुः परमक्रुद्धा देवसैन्यं महासुराः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006521058, "chapter_id": 26521, "verse_number": "३-६०-५९", "content_sanskrit": "क्षीणप्रहरणाः केचिन्महामेघनिभस्वनाः ।\nदर्पोत्कटा भुजैरेव सम्प्रहारं प्रचक्रिरे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006521059, "chapter_id": 26521, "verse_number": "३-६०-६०", "content_sanskrit": "प्रांशुभिश्चैव काष्ठैश्च शिलाभिश्च महाबलाः ।\nबाहुभिश्च तथान्योन्यमाक्षिपन्ति स्म वेगिताः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006521060, "chapter_id": 26521, "verse_number": "३-६०-६१", "content_sanskrit": "मुष्टिभिश्च तलैश्चैव नखपातैर्महाबलाः ।\nपादपैश्च महाशाखैरयुध्यन्त रणाजिरे ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006521061, "chapter_id": 26521, "verse_number": "३-६०-६२", "content_sanskrit": "अनुह्रादस्तु संक्रुद्धो देवतानां महाचमूम् ।\nममन्थ परमायत्तो वनान्यग्निरिवोत्थितः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006521062, "chapter_id": 26521, "verse_number": "३-६०-६३", "content_sanskrit": "रुधिरार्द्रास्तु बहवः शेरते योधसत्तमाः ।\nविकृताः पतिता भूमौ ताम्रपुष्पा इव द्रुमाः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006521063, "chapter_id": 26521, "verse_number": "३-६०-६४", "content_sanskrit": "अनुह्रादस्य विक्रान्तो देवस्त्वाशीविषोपमान् ।\nयुध्यमानस्य समरे व्यसृजन्निशिताञ्छरान् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006521064, "chapter_id": 26521, "verse_number": "३-६०-६५", "content_sanskrit": "धनाधिपेन विद्धस्य अनुह्रादस्य संयुगे ।\nअङ्गारमिश्राः क्रुद्धस्य मुखान्निश्चेरुरर्चिषः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006521065, "chapter_id": 26521, "verse_number": "३-६०-६६", "content_sanskrit": "अथ बाणसहस्रेण वित्तेशं दानवोत्तमः ।\nविव्याध स शरैः क्रुद्धो दण्डपाणिरिवान्तकः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006521066, "chapter_id": 26521, "verse_number": "३-६०-६७", "content_sanskrit": "कुबेरस्तु शरैर्भिन्नः समन्तात्क्षतजोक्षितः ।\nरुधिरं परिसुस्राव गिरिः प्रस्रवणैरिव ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006521067, "chapter_id": 26521, "verse_number": "३-६०-६८", "content_sanskrit": "लब्ध्वा स तु पुनः संज्ञां रोषरक्तेक्षणः सुरः ।\nगदामथ समासाद्य भीमां भीमपराक्रमः ।\nचिक्षेप दैत्यमुद्दिश्य बलात्क्रोधेन मूर्छितः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006521068, "chapter_id": 26521, "verse_number": "३-६०-६९", "content_sanskrit": "अप्राप्तामन्तरे सोऽथ तां गदां गदयासुरः ।\nबभञ्ज विनदन् क्रुद्धस्तदाश्चर्यमभूत् तदा ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006521069, "chapter_id": 26521, "verse_number": "३-६०-७०", "content_sanskrit": "प्रगृह्य तु गदां भूयो ह्यभिदुद्राव दानवम् ।\nतमापतन्तं दृष्ट्वैव अनुह्रादो महाबलः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006521070, "chapter_id": 26521, "verse_number": "३-६०-७१", "content_sanskrit": "गिरिशृङ्गमिवोत्पाट्य कैलासाचलसंनिभम् ।\nधनाधिपं प्रदुद्राव व्यादितास्य इवान्तकः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006521071, "chapter_id": 26521, "verse_number": "३-६०-७२", "content_sanskrit": "तमन्तकमिवायान्तमजेयं सकलैः सुरैः ।\nग्रसन्तमिव तं दैत्यं त्रैलोक्यमखिलं रुषा ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006521072, "chapter_id": 26521, "verse_number": "३-६०-७३", "content_sanskrit": "तमालोक्य तथा भूतं धनाध्यक्षो रणं भयात् ।\nअपहाय ययौ तत्र यत्र शक्रः सुराधिपः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006521073, "chapter_id": 26521, "verse_number": "३-६०-७४", "content_sanskrit": "तस्य चापि महत् कर्म दृष्ट्वा वित्तपतिस्तदा ।\nजगाम भयसंत्रस्तो यत्र देवः शचीपतिः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]