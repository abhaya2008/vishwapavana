[{"id": 7006426000, "chapter_id": 26426, "verse_number": "२-८६-१", "content_sanskrit": "जनमेजय उवाच\nश्रुतोऽयं षट्पुरवधो रम्यो मुनिवरोत्तम ।\nपुरोक्तमन्धकवधं वैशम्पायन कीर्तय ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006426001, "chapter_id": 26426, "verse_number": "२-८६-२", "content_sanskrit": "भानुमत्याश्च हरणं निकुम्भस्य वधं तथा ।\nप्रब्रूहि वदतां श्रेष्ठ परं कौतूहलं हि मे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006426002, "chapter_id": 26426, "verse_number": "२-८६-३", "content_sanskrit": "वैशम्पायन उवाच\nदितिर्हतेषु पुत्रेषु विष्णुना प्रभविष्णुना ।\nतपसाऽऽराधयामास मारीचं कश्यपं पुरा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006426003, "chapter_id": 26426, "verse_number": "२-८६-४", "content_sanskrit": "तपसा कालयुक्तेन तथा शुश्रूषया मुनेः ।\nआनुकूल्येन च तथा माधुर्येण च भारत ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006426004, "chapter_id": 26426, "verse_number": "२-८६-५", "content_sanskrit": "परितुष्टः कश्यपस्तु तामुवाच तपोधनः ।\nपरितुष्टोऽस्मि ते भद्रे वरं वरय सुव्रते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006426005, "chapter_id": 26426, "verse_number": "२-८६-६", "content_sanskrit": "दितिरुवाच\nहतपुत्रास्मि भगवन् देवैर्धर्मभृतां वर ।\nअवध्यं पुत्रमिच्छामि देवैरमितविक्रमम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006426006, "chapter_id": 26426, "verse_number": "२-८६-७", "content_sanskrit": "कश्यप उवाच\nअवध्यस्ते सुतो देवि दाक्षायणि भवेदिति ।\nदेवानां संशयो नात्र कश्चित्कमललोचने ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006426007, "chapter_id": 26426, "verse_number": "२-८६-८", "content_sanskrit": "देवदेवमृते रुद्रं तस्य न प्रभवाम्यहम् ।\nआत्मा ततस्ते पुत्रेण रक्षितव्यो हि सर्वथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006426008, "chapter_id": 26426, "verse_number": "२-८६-९", "content_sanskrit": "अन्वालभत तां देवीं कश्यपः सत्यवागथ ।\nअङ्गु्ल्योदरदेशे तु सा पुत्रं सुषुवे ततः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006426009, "chapter_id": 26426, "verse_number": "२-८६-१०", "content_sanskrit": "सहस्त्रबाहुं कौरव्य सहस्रशिरसं तथा ।\nद्विसहस्रेक्षणं चैव तावच्चरणमेव च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006426010, "chapter_id": 26426, "verse_number": "२-८६-११", "content_sanskrit": "स व्रजत्यन्धवद् यस्मादनन्धोऽपि हि भारत ।\nतमन्धकोऽयं नाम्नेति प्रोचुस्तत्र निवासिनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006426011, "chapter_id": 26426, "verse_number": "२-८६-१२", "content_sanskrit": "अवध्योऽस्मीति लोकान् स सर्वान् बाधति भारत ।\nहरत्यपि च रत्नानि सर्वाण्यात्मबलाश्रयात् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006426012, "chapter_id": 26426, "verse_number": "२-८६-१३", "content_sanskrit": "वासयत्यात्मवीर्येण निगृह्याप्सरसां गणान् ।\nस वेश्मन्यूर्जितोऽत्यर्थं सर्वलोकभयंकरः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006426013, "chapter_id": 26426, "verse_number": "२-८६-१४", "content_sanskrit": "परदारापहरणं पररत्नविलोपनम् ।\nचकार सततं मोहादन्धकः पापनिश्चयः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006426014, "chapter_id": 26426, "verse_number": "२-८६-१५", "content_sanskrit": "त्रैलोक्यविजयं कर्तुमुद्यतः स तु भारत ।\nसहायैरसुरैः सार्धं बहुभिः सर्वधर्षिभिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006426015, "chapter_id": 26426, "verse_number": "२-८६-१६", "content_sanskrit": "तच्छ्रुत्वा भगवाञ्छक्रः कश्यपं पितरं ब्रवीत् ।\nअन्धकेनेदमारब्धमीदृशं मुनिसत्तम ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006426016, "chapter_id": 26426, "verse_number": "२-८६-१७", "content_sanskrit": "आज्ञापय विभो कार्यमस्माकं समनन्तरम् ।\nयवीयसः कथं नाम सोढव्यं स्यान्मुने मया ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006426017, "chapter_id": 26426, "verse_number": "२-८६-१८", "content_sanskrit": "इष्टपुत्रे प्रहर्तव्यं कथं नाम मया विभो ।\nइहात्रभवती कुर्यान्मन्युं मयि हते सुते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006426018, "chapter_id": 26426, "verse_number": "२-८६-१९", "content_sanskrit": "देवेन्द्रवचनं श्रुत्वा कश्यपोऽथाब्रवीन्मुनिः ।\nवारयिष्यामि देवेन्द्र सर्वथा भद्रमस्तु ते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006426019, "chapter_id": 26426, "verse_number": "२-८६-२०", "content_sanskrit": "अन्धकं वारयामास दित्या सह तु कश्यपः ।\nत्रैलोक्यविजयाद् वीरं कृच्छ्रकृच्छ्रेण भारत ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006426020, "chapter_id": 26426, "verse_number": "२-८६-२१", "content_sanskrit": "वारितोऽपि स दुष्टात्मा बाधत्येव दिवौकसः ।\nतैस्तैरुपायैर्दुष्टात्मा प्रमथ्य च तथामरान् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006426021, "chapter_id": 26426, "verse_number": "२-८६-२२", "content_sanskrit": "बभञ्ज कानने वृक्षानुद्यानानि च दुर्मतिः ।\nउच्चैःश्रवःसुतानश्वान् बलादप्यानयद् दिवः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006426022, "chapter_id": 26426, "verse_number": "२-८६-२३", "content_sanskrit": "नागान् दिशागजसुतान् दिव्यानपि च भारत ।\nबलाद्धरति देवानां पश्यतां वरदर्पितः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006426023, "chapter_id": 26426, "verse_number": "२-८६-२४", "content_sanskrit": "देवानाप्यायन्ते तु ये यशैस्तपसा तथा ।\nतेषां चकार विघ्नं स दुष्टात्मा देवकण्टकः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006426024, "chapter_id": 26426, "verse_number": "२-८६-२५", "content_sanskrit": "नेजुर्यज्ञैस्त्रयो वर्णास्तेपुश्च न तपांस्यपि ।\nअन्धकस्य भयाद् राजन् यज्ञविघ्नानि कुर्वतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006426025, "chapter_id": 26426, "verse_number": "२-८६-२६", "content_sanskrit": "तस्येच्छया वाति वायुरादित्यश्च तपत्युत ।\nचन्द्रमा वा सनक्षत्रो दृश्यते नैव वा पुनः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006426026, "chapter_id": 26426, "verse_number": "२-८६-२७", "content_sanskrit": "न व्रजन्ति विमानानि विहायसि भयात् प्रभो ।\nअन्धकस्यातिघोरस्य बलदृप्तस्य दुर्मतेः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006426027, "chapter_id": 26426, "verse_number": "२-८६-२८", "content_sanskrit": "निरोङ्कारवषट्कारं जगद् वीर तथाभवत् ।\nअन्धकस्यातिघोरस्य भयात् कुरुकुलोद्वह ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006426028, "chapter_id": 26426, "verse_number": "२-८६-२९", "content_sanskrit": "कुरूंस्तथोत्तरान् पापो द्रावयामास भारत ।\nभद्राश्वान् केतुमालांश्च जम्बूद्वीपांस्तथैव च ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006426029, "chapter_id": 26426, "verse_number": "२-८६-३०", "content_sanskrit": "मानयन्ति च तं देवा दानवाश्च दुरासदाः ।\nभूतानि च तथान्यानि समर्थान्यपि सर्वथा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006426030, "chapter_id": 26426, "verse_number": "२-८६-३१", "content_sanskrit": "ऋषयो वध्यमानास्तु समेता ब्रह्मवादिनः ।\nअचिन्तयन्नन्धकस्य वधं धर्मभृतां वर ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006426031, "chapter_id": 26426, "verse_number": "२-८६-३२", "content_sanskrit": "तेषां बृहस्पतिर्मध्ये धीमानिदमथाब्रवीत् ।\nनास्य रुद्रादृते मृत्युर्विद्यते च कथंचन ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006426032, "chapter_id": 26426, "verse_number": "२-८६-३३", "content_sanskrit": "तथा वरे दीयमाने कश्यपेनापि शब्दितः ।\nनाहं रुद्रात् परित्रातुं शक्त इत्येव धीमतः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006426033, "chapter_id": 26426, "verse_number": "२-८६-३४", "content_sanskrit": "तमुपायं चिन्तयामः शर्वो येन सनातनः ।\nजानीयात् सर्वभूतानि पीड्यमानानि शङ्करः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006426034, "chapter_id": 26426, "verse_number": "२-८६-३५", "content_sanskrit": "विदितार्थो हि भगवानवश्यं जगतः प्रभुः ।\nअश्रुप्रमार्जनं देवः करिष्यति सतां गतिः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006426035, "chapter_id": 26426, "verse_number": "२-८६-३६", "content_sanskrit": "व्रतं हि देवदेवस्य भवस्य जगतो गुरोः ।\nसन्तोऽसद्भ्यो रक्षितव्या ब्राह्मणास्तु विशेषतः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006426036, "chapter_id": 26426, "verse_number": "२-८६-३७", "content_sanskrit": "ते वयं नारदं सर्वे प्रयाम शरणं द्विजम् ।\nउपायं वेत्स्यते तत्र वयस्यो हि भवस्य सः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006426037, "chapter_id": 26426, "verse_number": "२-८६-३८", "content_sanskrit": "बृहस्पतिवचः श्रुत्वा सर्वेऽप्यथ तपोधनाः ।\nतावद् ददृशुराकाशे प्राप्तं देवर्षिसत्तमम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006426038, "chapter_id": 26426, "verse_number": "२-८६-३९", "content_sanskrit": "पूजयित्वा यथान्यायं सत्कृत्य विधिवन्मुनिम् ।\nदेवर्षे भगवन् साधो कैलासं व्रज सत्वरम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006426039, "chapter_id": 26426, "verse_number": "२-८६-४०", "content_sanskrit": "विज्ञप्तुमर्हसे देवमन्धकस्य वधे हरम् ।\nत्राणार्थं नारदं प्रोचुस्तांस्तथेति स चोक्तवान् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006426040, "chapter_id": 26426, "verse_number": "२-८६-४१", "content_sanskrit": "ऋषिष्वथ प्रयातेषु तत्कार्यं नारदो मुनिः ।\nविचार्य मनसा विद्वानिति कार्यं स दृष्टवान् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006426041, "chapter_id": 26426, "verse_number": "२-८६-४२", "content_sanskrit": "स देवदेवं भगवान् द्रष्टुं मुनिरथाययौ ।\nमन्दारवनमध्यस्थो यत्र नित्यो वृषध्वजः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006426042, "chapter_id": 26426, "verse_number": "२-८६-४३", "content_sanskrit": "स तत्र रजनीमेकामुषित्वा मुनिसत्तमः ।\nमन्दाराणां वने रम्ये दयितः शूलपाणिनः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006426043, "chapter_id": 26426, "verse_number": "२-८६-४४", "content_sanskrit": "आजगाम पुनः स्वर्गं लब्ध्वानुज्ञां वृषध्वजात् ।\nमन्दारपुष्पैः सुकृतां मालामाबध्य भारत ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006426044, "chapter_id": 26426, "verse_number": "२-८६-४५", "content_sanskrit": "ग्रथितां सविशेषां तां सर्वगन्धोत्तमोत्तमाम् ।\nसंतानमाल्यदामाथ तैरेव कुसुमैः कृतम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006426045, "chapter_id": 26426, "verse_number": "२-८६-४६", "content_sanskrit": "तच्च कण्ठे समासज्य महागन्धं नराधिप ।\nआययावन्धको यत्र दुरात्मा बलदर्पितः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006426046, "chapter_id": 26426, "verse_number": "२-८६-४७", "content_sanskrit": "अन्धकस्त्वथ तं दृष्ट्वा गन्धमाघ्राय चोत्तमम् ।\nसंतानकानां स्रङ्मालां महागन्धां महामुने ।\nकुत्रायं पुष्पजातिर्वा कमनीया तपोधन ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006426047, "chapter_id": 26426, "verse_number": "२-८६-४८", "content_sanskrit": "गन्धान्वर्णाञ्छुभांस्तान् हि भोः पुष्यति मुहुर्मुहुः ।\nस्वर्गे संतानकुसुमान्यतिवर्तति सर्वथा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006426048, "chapter_id": 26426, "verse_number": "२-८६-४९", "content_sanskrit": "कः प्रभुस्तस्य वृक्षस्य शक्यं वाऽऽनयितुं मुने ।\nआचक्ष्व यद्यनुग्राह्या वयं ते देवतातिथे ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006426049, "chapter_id": 26426, "verse_number": "२-८६-५०", "content_sanskrit": "तमुवाच मुनिश्रेष्ठः प्रहसन्निव भारत ।\nआदाय दक्षिणे हस्ते महतस्तपसो निधिः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006426050, "chapter_id": 26426, "verse_number": "२-८६-५१", "content_sanskrit": "मन्दरे पर्वतश्रेष्ठे वीर कामगमं वनम् ।\nतत्र चैवंविधं पुष्पं भोः सृष्टिः शूलपाणिनः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006426051, "chapter_id": 26426, "verse_number": "२-८६-५२", "content_sanskrit": "न तु तत्र वनं कश्चिदच्छन्देन महात्मनः ।\nप्रवेष्टुं लभते तद्धि रक्षन्ति प्रवरोत्तमाः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006426052, "chapter_id": 26426, "verse_number": "२-८६-५३", "content_sanskrit": "नानाप्रहरणा घोरा नानावेषा दुरासदाः ।\nअवध्याः सर्वभूतानां महादेवाभिरक्षिताः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006426053, "chapter_id": 26426, "verse_number": "२-८६-५४", "content_sanskrit": "नित्यं प्रक्रीडते तत्र सोमः सप्रवरो हरः ।\nमन्दारद्रुमखण्डेषु सर्वात्मा सर्वभावनः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006426054, "chapter_id": 26426, "verse_number": "२-८६-५५", "content_sanskrit": "तपोविशेषैराराध्य हरं त्रिभुवनेश्वरम् ।\nशक्यं मन्दारपुष्पाणि प्राप्तुं कश्यपवंशज ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006426055, "chapter_id": 26426, "verse_number": "२-८६-५६", "content_sanskrit": "स्त्रीरत्नमणिरत्नानि यानि चान्यानि चाप्यथ ।\nकाङ्क्षितानि फलन्ति स्म ते द्रुमा हरवल्लभाः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006426056, "chapter_id": 26426, "verse_number": "२-८६-५७", "content_sanskrit": "न तत्र सूर्यः सोमोऽथ तपत्यतुलविक्रम ।\nस्वयंप्रभं तरुवनं तद् भो दुःखविवर्जितम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006426057, "chapter_id": 26426, "verse_number": "२-८६-५८", "content_sanskrit": "तत्र गन्धान् स्रवन्त्यन्ये नीराण्यन्ये महाद्रुमाः ।\nवासांसि विविधान्यन्ये सुगन्धीनि महाबल ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006426058, "chapter_id": 26426, "verse_number": "२-८६-५९", "content_sanskrit": "भक्ष्यं भोज्यं च पेयं च चोष्यं लेह्यं तथैव च ।\nतरुभ्यः स्रवते तेभ्यो विविधं मनसेप्सितम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006426059, "chapter_id": 26426, "verse_number": "२-८६-६०", "content_sanskrit": "पिपासा वा बुभुक्षा वा ग्लानिश्चिन्तापि वानघ ।\nन मन्दारवने वीर भवतीत्युपधार्यताम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006426060, "chapter_id": 26426, "verse_number": "२-८६-६१", "content_sanskrit": "न तै वर्णयितुं शक्या गुणा वर्षशतैरपि ।\nगुणा ये तत्र वर्द्धन्ते स्वर्गाद् बहुगुणोत्तराः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006426061, "chapter_id": 26426, "verse_number": "२-८६-६२", "content_sanskrit": "अतीव हि जयेल्लोकान् समहेन्द्रान् न संशयः ।\nएकाहमपि यस्तत्र वसेच्च दितिजोत्तम ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006426062, "chapter_id": 26426, "verse_number": "२-८६-६३", "content_sanskrit": "स्वर्गस्यापि हि तत्स्वर्गं सुखानामपि तत्सुखम् ।\nबभूव जगतः सर्वमिति मे धीयते मनः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]