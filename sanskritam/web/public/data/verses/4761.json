[{"id": 2178006, "chapter_id": 4761, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2178007, "chapter_id": 4761, "verse_number": "१", "content_sanskrit": "यदिदं धर्मगहनं बुद्ध्या समनुबुद्ध्यसे ।\nएतद् विस्तरतः सर्वं बुद्धिमार्गं प्रशंस मे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2178008, "chapter_id": 4761, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2178009, "chapter_id": 4761, "verse_number": "२", "content_sanskrit": "अत्र ते वर्तयिष्यामि नमस्कृत्वा स्वयम्भुवे ।\nयथा संसारगहनं वदन्ति परमर्षयः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2178010, "chapter_id": 4761, "verse_number": "३", "content_sanskrit": "कश्चिन्महति संसारे वर्तमानो द्विजः किल ।\nवनं दुर्गमनुप्राप्तो महत् क्रव्यादसङ्कुलम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2178011, "chapter_id": 4761, "verse_number": "४", "content_sanskrit": "सिंहव्याघ्रगजक्षौघैरतिघोरैर्महास्वनैः ।\nसमन्तात् सम्परिक्षिप्तं यस्माद् द्रष्टुर्महद्भयम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2178012, "chapter_id": 4761, "verse_number": "५", "content_sanskrit": "तदस्य दृष्ट्वा हृदयमुद्वेगमगमत् परम् ।\nअत्युच्छ्रयाश्च रोमाणां विक्रियाश्च भवन्ति वै\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2178013, "chapter_id": 4761, "verse_number": "६", "content_sanskrit": "स तद् वनं व्यतिसरन् नृप धावन्नितस्ततः ।\nवीक्षमाणो दिशः सर्वाः शरणं क्व भवेदिति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2178014, "chapter_id": 4761, "verse_number": "७", "content_sanskrit": "स तेषां छिद्रमन्विच्छन् प्रद्रुतो भयपीडितः ।\nन च निर्याति वै दूरं न च तैर्विप्रयुज्यते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2178015, "chapter_id": 4761, "verse_number": "८", "content_sanskrit": "अथापश्यद् वनं गूढं समन्ताद् वागुरावृतम् ।\nबाहुभ्यां सम्परिष्वक्तः स्त्रिया परमघोरया\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2178016, "chapter_id": 4761, "verse_number": "९", "content_sanskrit": "पञ्चशीर्षधरैर्नागैः शैलैरिव समुन्नतैः ।\nनभस्पृशैर्महावृक्षैः परिक्षिप्तं महावनम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2178017, "chapter_id": 4761, "verse_number": "१०", "content_sanskrit": "वनमध्ये च तत्राभूद् उदपानः समावृतः ।\nवल्लीभिस्तृणनद्धाभिर्गूढाभिरभिसंवृतः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2178018, "chapter_id": 4761, "verse_number": "११", "content_sanskrit": "पपात स द्विजस्तत्र निगूढे सलिलाशये ।\nविलग्नश्चाभवत् तस्मिन् लतासन्तानसङ्कुले\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2178019, "chapter_id": 4761, "verse_number": "१२", "content_sanskrit": "पनसस्य यथा जातं वृन्तबद्धं महाफलम् ।\nस तथा लम्बते तत्र ऊर्ध्वपादो ह्यधःशिराः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2178020, "chapter_id": 4761, "verse_number": "१३", "content_sanskrit": "तथा तत्रैव चायातो दन्ती दलितपर्वतः ।\nकूपपीनाहवेलायाम् अपश्यत महागजम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2178021, "chapter_id": 4761, "verse_number": "१४", "content_sanskrit": "षड्वक्त्रं कृष्णशबलं द्विषट्कपदचारिणम् ।\nक्रमेण परिसर्पन्तं वल्लीवृक्षसमावृतम् ।\nकूपमध्ये महानागमपश्यत महाबलम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2178022, "chapter_id": 4761, "verse_number": "१५", "content_sanskrit": "तस्य शाखाप्रशाखासु वृक्षशाखाप्रलम्बिनः ।\nनानावर्णा मधुकरा घोररूपा भयावहाः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2178023, "chapter_id": 4761, "verse_number": "१६", "content_sanskrit": "आसते मधु संहृत्य पूर्वमेव निकेतजाः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2178024, "chapter_id": 4761, "verse_number": "१७", "content_sanskrit": "भूयो भूयः समीहन्ते मधूनि भरतर्षभ ।\nस्वादूनि यानि भूतानि यैर्बालो न वितृप्यते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2178025, "chapter_id": 4761, "verse_number": "१८", "content_sanskrit": "तेषां मधूनां विविधा धारा प्रस्रवते सदा ।\nतां लम्बमानः स पुमान् धारां पिबति सर्वदा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2178026, "chapter_id": 4761, "verse_number": "१९", "content_sanskrit": "न चास्य तृष्णा विरता पिबमानस्य सङ्कटे ।\nअभीप्सति च तां नित्यमतृप्तश्च पुनः पुनः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2178027, "chapter_id": 4761, "verse_number": "२०", "content_sanskrit": "न चास्य जीविते राजन् निर्वेदः समजायत ।\nतत्रैव च मनुष्यस्य जीविताशा प्रतिष्ठिता\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2178028, "chapter_id": 4761, "verse_number": "२१", "content_sanskrit": "कृष्णाः श्वेताश्च तं वृक्षं निकृन्तन्ति स्म मूषिकाः ।\nव्यालैश्च तद् वनं दुर्गं स्त्रिया च परमोग्रया\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2178029, "chapter_id": 4761, "verse_number": "२२", "content_sanskrit": "कूपाधस्ताच्च नागेन पीनाहे कुञ्जरेण च ।\nवृक्षप्रपाताच्च भयं मूषिकेभ्यश्च पञ्चमम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2178030, "chapter_id": 4761, "verse_number": "२३", "content_sanskrit": "मधुलोभान्मधुकरैः षष्ठमाहुर्महद्भयम् ।\nएवं संवसते तत्र क्षिप्तः संसारसागरे\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2178031, "chapter_id": 4761, "verse_number": "२४", "content_sanskrit": "न चैव जीविताशायां निर्वेदमुपगच्छति\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2178032, "chapter_id": 4761, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां स्त्रीपर्वणि\nधृतराष्ट्रविशोके पञ्चमोऽध्यायः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2178033, "chapter_id": 4761, "verse_number": "", "content_sanskrit": "जलप्रदानपर्वणि पञ्चमोऽध्यायः ॥५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]