[{"id": 2118976, "chapter_id": 3557, "verse_number": "", "content_sanskrit": "जरितारिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2118977, "chapter_id": 3557, "verse_number": "१", "content_sanskrit": "पुरतः कृच्छ्रकालस्य धीमान् जागर्ति पूरुषः ।\nस कृच्छ्रकालं सम्प्राप्य व्यथां नैवैति कर्हिचित् \t॥ १॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2118978, "chapter_id": 3557, "verse_number": "२", "content_sanskrit": "यस्तु कृच्छ्रमसम्प्राप्तं विश्वासान्नावबुध्यते ।\nस कृच्छ्रकाले व्यथितो न प्रजानाति किञ्चन \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2118979, "chapter_id": 3557, "verse_number": "", "content_sanskrit": "सारिसृक्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2118980, "chapter_id": 3557, "verse_number": "३", "content_sanskrit": "धीरस्त्वमसि मेधावी प्राणकृच्छ्रमिदं च नः ।\nशूरः प्राज्ञो बहूनां हि भवत्येको गुणाधिकः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2118981, "chapter_id": 3557, "verse_number": "", "content_sanskrit": "स्तम्बमित्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2118982, "chapter_id": 3557, "verse_number": "४", "content_sanskrit": "ज्येष्ठस्तातो भवति वै ज्येष्ठो मुञ्चति कृच्छ्रतः ।\nज्येष्ठश्चेन्न प्रजानाति कनीयान् किं करिष्यति \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2118983, "chapter_id": 3557, "verse_number": "", "content_sanskrit": "द्रोणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2118984, "chapter_id": 3557, "verse_number": "५", "content_sanskrit": "हिरण्यरेतास्त्वरितो ज्वलन्नायाति नः क्षयम् ।\nसप्तजिह्वोऽनलः क्षामो लेलिहानो विसर्पति \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2118985, "chapter_id": 3557, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2118986, "chapter_id": 3557, "verse_number": "६", "content_sanskrit": "एवमुक्तो भ्रातृभिस्तु जरितारिर्विभावसुम् ।\nतुष्टाव प्राञ्जलिर्भूत्वा यत् तच्छृणु नराधिप \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2118987, "chapter_id": 3557, "verse_number": "", "content_sanskrit": "जरितारिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2118988, "chapter_id": 3557, "verse_number": "७", "content_sanskrit": "आत्मा स वायुः पवन शरीरमुत वीरुधः ।\nयोनिरापश्च ते शुक्ल योनिस्त्वमसि चाम्भसः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2118989, "chapter_id": 3557, "verse_number": "८", "content_sanskrit": "ऊर्ध्वं चाधश्च गच्छन्ति विसर्पन्ति च पार्श्वतः ।\nअर्चिषस्ते महावीर्य रश्मयः सवितुर्यथा \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2118990, "chapter_id": 3557, "verse_number": "", "content_sanskrit": "सारिसृक्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2118991, "chapter_id": 3557, "verse_number": "९", "content_sanskrit": "माता प्रपन्ना पितरं न विद्मः\nपक्षाश्च नो न सुजाता भवन्ति ।\nन नस्त्राता विद्यते वै त्वदन्यः\nतस्मादस्मान् परिधत्स्वैकवीर \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2118992, "chapter_id": 3557, "verse_number": "१०", "content_sanskrit": "यदग्ने ते शिवं रूपं ये च ते सप्त हेतयः ।\nतेन नः परिरक्षेथाः पीडितान् शरणैषिणः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2118993, "chapter_id": 3557, "verse_number": "११", "content_sanskrit": "त्वमेवैकस्तपसां जातवेदो\nनान्यस्तप्ता विद्यते गोषु देव ।\nऋषीनस्मान् बालकान् पालयस्व\nपरेणास्मान् प्रेहि वै हव्यवाह \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2118994, "chapter_id": 3557, "verse_number": "", "content_sanskrit": "स्तम्बमित्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2118995, "chapter_id": 3557, "verse_number": "१२", "content_sanskrit": "सर्वमग्ने त्वमेवैकस्त्वयि सर्वमिदं जगत् ।\nत्वं धारयसि भूतानि भुवनं त्वं बिभर्षि च \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2118996, "chapter_id": 3557, "verse_number": "", "content_sanskrit": "द्रोणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2118997, "chapter_id": 3557, "verse_number": "१३", "content_sanskrit": "त्वमग्ने हव्यवाट् चैव त्वमेव परमा गतिः ।\nमनीषिणस्त्वां यजन्ते बहुधा चैकधाऽपि च \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2118998, "chapter_id": 3557, "verse_number": "१४", "content_sanskrit": "सृष्ट्वा लोकांस्त्रीनिमान् हव्यवाह\nकाले प्राप्ते पचसि पुनः समिद्धः ।\nसर्वस्यास्य भुवनस्य प्रसूतिः\nत्वमग्ने भवसि पुनः प्रतिष्ठा \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2118999, "chapter_id": 3557, "verse_number": "१५", "content_sanskrit": "त्वमन्नं प्राणिनां भुङ्क्षे अन्तर्भूतो जगत्पते ।\nनित्यप्रवृद्धः पचसि त्वयि सर्वं प्रतिष्ठितम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2119000, "chapter_id": 3557, "verse_number": "१७", "content_sanskrit": "सूर्यो भूत्वा रश्मिभिर्जातवेदो\nभूमेरापो भूमिगतान् रसांश्च ।\nविश्वं चादाय पुनरुत्सर्गकाले\nसृष्ट्वा वृष्ट्या भावयसीह शुक्ल \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2119001, "chapter_id": 3557, "verse_number": "१८", "content_sanskrit": "त्वत्त एताः पुनः शुक्लवीरुधो हरितच्छदाः ।\nजायन्ते पुष्करिण्यश्च सुभद्रश्च महोदधिः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2119002, "chapter_id": 3557, "verse_number": "१९", "content_sanskrit": "शोभनं सद्म तिग्मांशो वरुणस्य परायणम् ।\nशिवस्त्राता भवास्माकं माऽस्मानद्य विनाशय \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2119003, "chapter_id": 3557, "verse_number": "२०", "content_sanskrit": "पिङ्गलाक्ष हयग्रीव कृष्णवर्त्मन् हुताशन ।\nपरेण प्रेहि मुञ्चास्मान् सागरस्य ग्रहानिव\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2119004, "chapter_id": 3557, "verse_number": "", "content_sanskrit": "वैशम्पयानः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2119005, "chapter_id": 3557, "verse_number": "२१", "content_sanskrit": "एवमुक्तो जातवेदा द्रोणेनाक्लिष्टकर्मणा ।\nद्रोणमाह प्रतीतात्मा मन्दपालप्रतिज्ञया \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2119006, "chapter_id": 3557, "verse_number": "", "content_sanskrit": "अग्निः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2119007, "chapter_id": 3557, "verse_number": "२२", "content_sanskrit": "ऋषिर्द्रोणस्त्वमसि वै ब्रह्मैतद् व्याहृतं त्वया ।\nर्हप्सितं ते करिष्यामि न च ते विद्यते भयम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2119008, "chapter_id": 3557, "verse_number": "२३", "content_sanskrit": "मन्दपालेन यूयं हि मम पूर्वं निवेदिताः ।\nवर्जयेः पुत्रकान् मह्यं दहन् दावमिति स्म ह \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2119009, "chapter_id": 3557, "verse_number": "२४", "content_sanskrit": "यच्च तद्वचनं तस्य त्वया यच्चेह भाषितम् ।\nउभयं मे गरीयस्त्वाद् ब्रूहि किं करवाणि ते ।\nभृशं प्रीतोऽस्मि भद्रं ते ब्रह्मन् स्तोत्रेण ते विभो \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2119010, "chapter_id": 3557, "verse_number": "", "content_sanskrit": "द्रोणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2119011, "chapter_id": 3557, "verse_number": "२५", "content_sanskrit": "इमे मार्जारकाः शुक्ल नित्यमुद्वेजयन्ति नः ।\nएतान् कुरुष्व दंष्ट्रासु हव्यवाडार्तिसम्भवान्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2119012, "chapter_id": 3557, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2119013, "chapter_id": 3557, "verse_number": "२६", "content_sanskrit": "तथा तत् कृतवानग्निरभ्यनुज्ञाय शार्ङ्गकान् ।\nददाह खाण्डवं चैव समिद्धो जनमेजय \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2119014, "chapter_id": 3557, "verse_number": "२३६", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nषड्त्रिंशत्यधिकद्विशततमोऽध्यायः ॥२३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2119015, "chapter_id": 3557, "verse_number": "५", "content_sanskrit": "॥ इति मयदर्शनपर्वणि पञ्चमोऽध्यायः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2119016, "chapter_id": 3557, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]