[{"id": 2092141, "chapter_id": 2960, "verse_number": "१३-९०-१", "content_sanskrit": "च्यवन उवाच।\nवरश्च गृह्यतां मत्तो यश्च ते संशयो हृदि।\nतं प्रब्रूदि नरश्रेष्ठ सर्वं सम्पादयामि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2092142, "chapter_id": 2960, "verse_number": "१३-९०-२x", "content_sanskrit": "कुशिक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2092143, "chapter_id": 2960, "verse_number": "१३-९०-२", "content_sanskrit": "यदि प्रीतोसि भगवंस्ततो मे वद भार्गव।\nकारणं श्रोतुसिच्छमि मद्गृहे वासकारितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2092144, "chapter_id": 2960, "verse_number": "१३-९०-३", "content_sanskrit": "शयनं चैकपार्श्वेन दिवसानेकविंशतिम्।\nन किञ्चिदुक्त्वा गमनं बहिश्च मुनिपुङ्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2092145, "chapter_id": 2960, "verse_number": "१३-९०-४", "content_sanskrit": "अन्तर्धानमकस्माच्च पुनरेव च दर्शनम्।\nपुनश्च शयनं विप्र दिवसानेकविंशतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2092146, "chapter_id": 2960, "verse_number": "१३-९०-५", "content_sanskrit": "तैलाभ्यक्तस्य गमनं भोजनं च गृहे मम।\nसमुपानीय विविधं यद्दग्धं जातवेदसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2092147, "chapter_id": 2960, "verse_number": "१३-९०-६", "content_sanskrit": "निर्याणां च रथेनाशु सहसा यत्कृतं त्वया।\nधनानां च विसर्गश्च वनस्यापि च दर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2092148, "chapter_id": 2960, "verse_number": "१३-९०-७", "content_sanskrit": "प्रासादानां बहूनां च काञ्चनानां महामुने।\nमणिविद्रुमपादानां पर्यङ्काणां च दर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2092149, "chapter_id": 2960, "verse_number": "१३-९०-८", "content_sanskrit": "पुनश्चादर्शनं तस्य श्रोतुमिच्छामि कारणम्।\nअतीव ह्यत्र मुह्यामि चिन्तयानो भृगूद्वह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2092150, "chapter_id": 2960, "verse_number": "१३-९०-९", "content_sanskrit": "न चैवात्राधिगच्छामि सर्वस्यास्य विनिश्चयम्।\nएतदिच्छामि कार्त्स्न्येन सत्यं श्रोतुं तपोधन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2092151, "chapter_id": 2960, "verse_number": "१३-९०-१०x", "content_sanskrit": "च्यवन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2092152, "chapter_id": 2960, "verse_number": "१३-९०-१०", "content_sanskrit": "शृणु सर्वमशेषेणि यदिदं येन हेतुना।\nन हि शक्यमनाख्यातुमेवं पृष्टेन पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2092153, "chapter_id": 2960, "verse_number": "१३-९०-११", "content_sanskrit": "पितामहस्य वदतः पुरा देवसमागमे।\nश्रुतवानस्मि यद्राजंस्तन्मे निगदतः शृणु।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2092154, "chapter_id": 2960, "verse_number": "१३-९०-१२", "content_sanskrit": "ब्रह्मक्षत्रविरोधेन भविता कुलसङ्करः।\nपौत्रस्ते भविता राजंस्तेजोवीर्यसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2092155, "chapter_id": 2960, "verse_number": "१३-९०-१३", "content_sanskrit": "ततः स्वकुलरक्षार्थमहं त्वां समुपागतः।\nचिकीर्षन्कुशिकोच्छेदं संदिधक्षुः कुलं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2092156, "chapter_id": 2960, "verse_number": "१३-९०-१४", "content_sanskrit": "ततोऽहमागम्य पुरे त्वामवोचं महीपते।\nनियमं कञ्चिदारप्सये शुश्रूषा क्रियतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2092157, "chapter_id": 2960, "verse_number": "१३-९०-१५", "content_sanskrit": "न च ते दुष्कृतं किञ्चिदहमासादयं गृहे।\nतेन जीवसि राजर्षे न भवेथास्त्वमन्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2092158, "chapter_id": 2960, "verse_number": "१३-९०-१६", "content_sanskrit": "एवं बुद्धिं समास्थाय दिवसानेकविंशतिम्।\nसुप्तोस्मि यदि मां कश्चिद्बोधयेदिति पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2092159, "chapter_id": 2960, "verse_number": "१३-९०-१७", "content_sanskrit": "यदा त्वया सभार्येण संसुप्तो न प्रबोधितः।\nअहं तदैव ते प्रीतो मनसा राजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2092160, "chapter_id": 2960, "verse_number": "१३-९०-१८", "content_sanskrit": "उत्थाय चास्मि निष्क्रान्तो यदि मां त्वं महीपते।\nपृच्छेः क्व यास्यसीत्येवं शपेयं त्वामिति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2092161, "chapter_id": 2960, "verse_number": "१३-९०-१९", "content_sanskrit": "अन्तर्हितः पुनश्चास्मि पुनरेव च ते गृहे।\nयोगमास्थाय संसुप्तो दिवसानेकविंशतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2092162, "chapter_id": 2960, "verse_number": "१३-९०-२०", "content_sanskrit": "क्षुधितौ मामसूयेथां श्रमाद्वेति नराधिप।\nएतां बुद्धिं समास्थाय कर्शितौ वां क्षुधा मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2092163, "chapter_id": 2960, "verse_number": "१३-९०-२१", "content_sanskrit": "न च तेऽभूत्सुसूक्ष्मोपि मन्युर्मनसि पार्थिव।\nसभार्यस्य नरश्रेष्ठ तेन ते प्रीतिमानहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2092164, "chapter_id": 2960, "verse_number": "१३-९०-२२", "content_sanskrit": "भोजनं च समानाय्य यत्तदादीपितं मया।\nक्रुध्येथा यदि मात्सर्यादिति तन्मर्षितं च मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2092165, "chapter_id": 2960, "verse_number": "१३-९०-२३", "content_sanskrit": "ततोऽहं रथमारुह्य त्वामवोचं नराधिप।\nसभार्यो मां वहस्वेति तच्च त्वं कृतवांस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2092166, "chapter_id": 2960, "verse_number": "१३-९०-२४", "content_sanskrit": "अविशङ्को नरपते प्रीतोऽहं चापि तेन ह।\nधनोत्सर्गेऽपि च कृते न त्वां क्रोधोप्यधर्षयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2092167, "chapter_id": 2960, "verse_number": "१३-९०-२५", "content_sanskrit": "ततः प्रीतेन ते राजन्पुनरेतत्कृतं तव।\nसभार्यस्य वनं भूयस्तद्विद्धि मनुजाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2092168, "chapter_id": 2960, "verse_number": "१३-९०-२६", "content_sanskrit": "प्रीत्यर्थं तव चैतन्मे स्वर्गसंदर्शनं कृतम्।\nयत्ते वनेऽस्मिन्नृपते दृष्टं दिव्यं सुदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2092169, "chapter_id": 2960, "verse_number": "१३-९०-२७", "content_sanskrit": "स्वर्गोद्देशस्त्वया राजन्सशरीरेण पार्थिव।\nमुहूर्तमनुभूतोऽसौ सभार्येण नृपोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2092170, "chapter_id": 2960, "verse_number": "१३-९०-२८", "content_sanskrit": "निदर्शनार्थं तपसो धर्मस्य च नराधिप।\nतत्र नासीत्स्पृहा राजंस्तच्चापि विदितं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2092171, "chapter_id": 2960, "verse_number": "१३-९०-२९", "content_sanskrit": "ब्राह्मण्यं काङ्क्षसे हि त्वं तपश्च पृथिवीपते।\nअवमत्य नरेन्द्रत्वं देवेन्द्रत्वं च पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2092172, "chapter_id": 2960, "verse_number": "१३-९०-३०", "content_sanskrit": "एवमेतद्यथातत्वं ब्राह्मण्यं तात दुर्लभम्।\nब्राह्मण्ये सति चर्षित्वमृषित्वे च तपस्विता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2092173, "chapter_id": 2960, "verse_number": "१३-९०-३१", "content_sanskrit": "भविष्यत्येष ते कामः कुशिकात्कौशिको द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2092174, "chapter_id": 2960, "verse_number": "१३-९०-३२", "content_sanskrit": "तृतीयं पुरुषं प्राप्य ब्राह्मणत्वं गमिष्यति।\nवंशस्ते पार्थिवश्रेष्ठ भृगूणामेव तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2092175, "chapter_id": 2960, "verse_number": "१३-९०-३३", "content_sanskrit": "पौत्रस्ते भविता विप्रस्तपस्वी पावकद्युतिः।\n`जमदग्नौ महाभाग तपसा भावितात्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2092176, "chapter_id": 2960, "verse_number": "१३-९०-३४", "content_sanskrit": "यः स देवमनुष्याणआं भयमुत्पादयिष्यति।\nत्रयाणामेव लोकानां सत्यमेतद्ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2092177, "chapter_id": 2960, "verse_number": "१३-९०-३५", "content_sanskrit": "वरं गृहाण राजर्षे यस्ते मनसि वर्तते।\nतीर्थयात्रां गमिष्यामि पुरा कालोऽतिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2092178, "chapter_id": 2960, "verse_number": "१३-९०-३६x", "content_sanskrit": "कुशिक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2092179, "chapter_id": 2960, "verse_number": "१३-९०-३६", "content_sanskrit": "एष एव वरो मेऽद्य यत्त्वं प्रीतो महामुने।\nभवत्वेतद्यथार्थत्वं भवेत्पौत्रो ममानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2092180, "chapter_id": 2960, "verse_number": "१३-९०-३७", "content_sanskrit": "ब्राह्मण्यं मे कुलस्यास्तु भगवन्नेष मे वरः।\nपुनश्चाख्यातुमिच्छामि भगवन्विस्तरेण वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2092181, "chapter_id": 2960, "verse_number": "१३-९०-३८", "content_sanskrit": "कथमेष्यति विप्रत्वं कुलं मे भृगुनन्दन।\nकश्चासौ भविता बन्धुर्मम कश्चापि सम्मतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2092182, "chapter_id": 2960, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि नवतितमोऽध्यायः॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]