[{"id": 2086194, "chapter_id": 2833, "verse_number": "१२-३८८-०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2086195, "chapter_id": 2833, "verse_number": "१२-३३८-१", "content_sanskrit": "अशोकं शोकनाशार्थं शास्त्रं शान्तिकरं शिवम्।\nनिशम्य लभते बुद्धिं तां लब्ध्वा सुखमेधते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2086196, "chapter_id": 2833, "verse_number": "१२-३३८-२", "content_sanskrit": "शोकस्थानसहस्राणि भयस्थानशतानि च।\nदिवसेदिवसे मूढमाविशन्ति न पण्डितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2086197, "chapter_id": 2833, "verse_number": "१२-३३८-३", "content_sanskrit": "तस्मादनिष्टनाशार्थमितिहासं निबोध मे।\nतिष्ठते चेद्वशे बुद्धिर्लभते शोकनाशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2086198, "chapter_id": 2833, "verse_number": "१२-३३८-४", "content_sanskrit": "अनिष्टसंप्रयोगाच्च विप्रयोगात्प्रियस्य च।\nमनुष्या मानसैर्दुःखैर्युज्यन्ते स्वल्पबुद्ध्यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2086199, "chapter_id": 2833, "verse_number": "१२-३३८-५", "content_sanskrit": "द्रव्येषु समतीतेषु ये गुणास्तान्न चिन्तयेत्।\nन तानाद्रियमाणस्य स्नेहबन्धः प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2086200, "chapter_id": 2833, "verse_number": "१२-३३८-६", "content_sanskrit": "दोषदर्शी भवेत्तत्र यत्र रागः प्रवर्तते।\nअनिष्ट्वद्धितं पश्येत्तथा क्षिप्रं विरज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2086201, "chapter_id": 2833, "verse_number": "१२-३३८-७", "content_sanskrit": "नार्थो न धर्मो न यशो योऽतीतमनुशोचति।\nअप्यभावेन युज्येत तच्चास्य न निवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2086202, "chapter_id": 2833, "verse_number": "१२-३३८-८", "content_sanskrit": "गुणैर्भूतानि युज्यन्ते वियुज्यन्ते तथैव च।\nसर्वाणि नैतदेकस्य शोकस्थानं हि युज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2086203, "chapter_id": 2833, "verse_number": "१२-३३८-९", "content_sanskrit": "मृतं वा यदि वा नष्टं योऽतीतमनुशोचति।\nदुःखेन लभते दुःखं द्वावनर्थौ प्रपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2086204, "chapter_id": 2833, "verse_number": "१२-३३८-१०", "content_sanskrit": "नाश्रु कुर्वन्ति ये बुद्ध्या दृष्ट्वा लोकेषु संततिम्।\nसम्यक्प्रपश्यतः सर्वं नाश्रुकर्मोपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2086205, "chapter_id": 2833, "verse_number": "१२-३३८-११", "content_sanskrit": "दुःखोपघाते शारीरे मानसे चाप्युपस्थिते।\nयस्मिन्न शक्यते कर्तुं यत्नस्तन्नानुचिन्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2086206, "chapter_id": 2833, "verse_number": "१२-३३८-१२", "content_sanskrit": "भैषज्यमेतद्दुःखस्य यदेतन्नानुचिन्तयेत्।\nचिन्त्यमानं हि न व्येति भूयश्चापि प्रवर्धते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2086207, "chapter_id": 2833, "verse_number": "१२-३३८-१३", "content_sanskrit": "प्रज्ञया मानसं दुःखं हन्याच्छारीरमौषधैः।\nएतद्विज्ञानमसामर्थ्यं न बालैः समतामियात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2086208, "chapter_id": 2833, "verse_number": "१२-३३८-१४", "content_sanskrit": "अनित्यं यौवनं रूपं जीवितं द्रव्यसंचयः।\nआरोग्यं प्रियसंसर्गो गृध्येत्तत्र न पण्डितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2086209, "chapter_id": 2833, "verse_number": "१२-३३८-१५", "content_sanskrit": "न जानपदिकं दुःखमेकः शोचितुमर्हति।\nअशोचन्प्रतिकुर्वीत यदि पश्येदुपक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2086210, "chapter_id": 2833, "verse_number": "१२-३३८-१६", "content_sanskrit": "सुखाद्बहुतरं दुःखं जीविते नात्र संशयः।\nस्निग्धत्वं चेन्द्रियार्थेषु मोहान्मरणमप्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2086211, "chapter_id": 2833, "verse_number": "१२-३३८-१७", "content_sanskrit": "परित्यजति यो दुःखं सुखं वाऽप्युभयं नरः।\nअभ्येति ब्रह्म सोत्यन्तं न तं शोचन्ति पण्डिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2086212, "chapter_id": 2833, "verse_number": "१२-३३८-१८", "content_sanskrit": "त्यजन्ते दुःखमर्था हि पालनेन च ते सुखाः।\nदुःखेन चाधिगम्यन्ते नाशमेषां न चिन्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2086213, "chapter_id": 2833, "verse_number": "१२-३३८-१९", "content_sanskrit": "अन्यामन्यां धनावस्थां प्राप्य वैशेषिकीं नराः।\nअतृप्ता यान्ति विध्वंसं संतोषं यान्ति पण्डिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2086214, "chapter_id": 2833, "verse_number": "१२-३३८-२०", "content_sanskrit": "सर्वे क्षयान्ता निचयाः पतनान्ताः समुच्छ्रयाः।\nसंयोगा विप्रयोगान्ता मरणान्तं हि जीवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2086215, "chapter_id": 2833, "verse_number": "१२-३३८-२१", "content_sanskrit": "अन्तो नास्ति पिपासायास्तुष्टिस्तु परमं सुखम्।\nतस्मात्संतोषमेवेह धनं पश्यन्ति पण्डिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2086216, "chapter_id": 2833, "verse_number": "१२-३३८-२२", "content_sanskrit": "निमेषमात्रमपि हि वयो गच्छन्न तिष्ठति।\nस्वशरीरेष्वनित्येषु नित्यं किमनुचिन्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2086217, "chapter_id": 2833, "verse_number": "१२-३३८-२३", "content_sanskrit": "भूतेषु भावं संचिन्त्य ये बुद्ध्वा मनसः परम्।\nन शोचन्ति गताध्वानः पश्यन्तः परमां गतिं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2086218, "chapter_id": 2833, "verse_number": "१२-३३८-२४", "content_sanskrit": "संचिन्वानकमेवैनं कामानामवितृप्तकम्।\nव्याघ्रः पशुमिवासाद्य मृत्युरादाय गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2086219, "chapter_id": 2833, "verse_number": "१२-३३८-२५", "content_sanskrit": "तथाऽप्युपायं संपश्येद्दुःखस्य परिमोक्षणे।\nअशोचन्नारभेतैव युक्तश्चाव्यसनी भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2086220, "chapter_id": 2833, "verse_number": "१२-३३८-२६", "content_sanskrit": "शब्दे स्पर्शे च रूपे च गन्धेषु च रसेषु च।\nनोपभोगात्परं किंचिद्धनिनो वाऽधनस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2086221, "chapter_id": 2833, "verse_number": "१२-३३८-२७", "content_sanskrit": "प्राक्संप्रयोगाद्भूतानां नास्ति दुःखं परायणम्।\nविप्रयोगात्तु सर्वस्य न शोचेत्प्रकृतिस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2086222, "chapter_id": 2833, "verse_number": "१२-३३८-२८", "content_sanskrit": "धृत्या शिश्नोदरं रक्षेत्पाणिपादं च चक्षुषा।\nचक्षुःश्रोत्रे च मनसा मनो वाचं च विद्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2086223, "chapter_id": 2833, "verse_number": "१२-३३८-२९", "content_sanskrit": "प्रणयं प्रतिसंहृत्य सस्निग्धेष्वितरेषु च।\nविचरेदसमुन्नद्धः स सुखी स च पण्डितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2086224, "chapter_id": 2833, "verse_number": "१२-३३८-३०", "content_sanskrit": "अध्यात्मरतिरासीनो निरपेक्षो निरामिषः।\nआत्मनैव सहायेन यश्चरेत्स सुखी भवेत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2086225, "chapter_id": 2833, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि अष्टत्रिंशदधिकत्रिशततमोऽध्यायः॥ ३३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]