[{"id": 2106612, "chapter_id": 3315, "verse_number": "१७-३-१", "content_sanskrit": "वैशम्पायन उवाच।\nततः सन्नादयञ्शक्रो दिवं भूमिं च सर्वशः।\nरथेनोपययौ पार्थमारोहेत्यब्रवीच्च तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2106613, "chapter_id": 3315, "verse_number": "१७-३-२", "content_sanskrit": "स्वभ्रातॄन्पतितान्दृष्ट्वा धर्मराजो युधिष्ठिरः।\nअब्रवीच्छोकसंतप्तः सहस्राक्षमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2106614, "chapter_id": 3315, "verse_number": "१७-३-३", "content_sanskrit": "भ्रातरः पतिता मेऽत्र गच्छेयुस्ते मया सह।\nन विना भ्रातृभिः स्वर्गमिच्छे गन्तुं सुरेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2106615, "chapter_id": 3315, "verse_number": "१७-३-४", "content_sanskrit": "सुकुमारी सुखार्हा च राजपुत्री पुरंदर।\nसाऽस्माभिः सह गच्छेत तद्भवाननुमन्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2106616, "chapter_id": 3315, "verse_number": "१७-३-५x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2106617, "chapter_id": 3315, "verse_number": "१७-३-५", "content_sanskrit": "भ्रातॄन्द्रक्ष्यसि स्वर्गे त्वमग्रतस्त्रिदिवं गतान्।\nकृष्णया सहितान्सर्वान्मा शुचो भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2106618, "chapter_id": 3315, "verse_number": "१७-३-६", "content_sanskrit": "निक्षिप्य मानुषं देहं गतास्ते भरतर्षभ।\nअनेन त्वं शरीरेण स्वर्गं गन्ता न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2106619, "chapter_id": 3315, "verse_number": "१७-३-७x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2106620, "chapter_id": 3315, "verse_number": "१७-३-७", "content_sanskrit": "अयं श्वा भूतभव्येश भक्तो मां नित्यमेव ह।\nस गच्छेत मया सार्धमानृशंस्या हि मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2106621, "chapter_id": 3315, "verse_number": "१७-३-८x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2106622, "chapter_id": 3315, "verse_number": "१७-३-८", "content_sanskrit": "अमर्त्यत्वं मत्समत्वं च राज-\nञ्श्रियं कृत्स्नां महतीं चैव सिद्धिम्।\nसंप्राप्तोद्य स्वर्गसुखानि च त्वं\nत्यज श्वानं नात्र नृशंसमस्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2106623, "chapter_id": 3315, "verse_number": "१७-३-९x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2106624, "chapter_id": 3315, "verse_number": "१७-३-९", "content_sanskrit": "अनार्यमार्येणि सहस्रनेत्र\nशक्यं कर्तुं दुष्करमेतदार्य।\nमा मे श्रिया सङ्गमनं तयाऽस्तु\nयस्याः कृते भक्तजनं त्यजेयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2106625, "chapter_id": 3315, "verse_number": "१७-३-१०x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2106626, "chapter_id": 3315, "verse_number": "१७-३-१०", "content_sanskrit": "स्वर्गे लोके श्ववतां नास्ति धिष्ण्य-\nमिष्टापूर्तं क्रोधवशा हरन्ति।\nततो विचार्यि क्रियतां धर्मराज\nत्यज श्वानं नात्र नृशंसमस्ति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2106627, "chapter_id": 3315, "verse_number": "१७-३-११x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2106628, "chapter_id": 3315, "verse_number": "१७-३-११", "content_sanskrit": "भक्तत्यागं प्राहुरत्यन्तपापं\nतुल्यं लोके ब्रह्मवध्याकृतेन।\nतस्मान्नाहं जातु कथञ्चनाद्य\nत्यक्ष्याम्येनं स्वसुखार्थी महेन्द्रः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2106629, "chapter_id": 3315, "verse_number": "१७-३-१२", "content_sanskrit": "भीतं भक्तं नान्यदस्तीति चार्तं\nप्राप्तं क्षीणं रक्षणे प्राणलिप्सुम्।\nप्राणत्यागादप्यहं नैव मोक्तुं\nयतेयं वै नित्यमेतद्व्रतं मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2106630, "chapter_id": 3315, "verse_number": "१७-३-१३x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2106631, "chapter_id": 3315, "verse_number": "१७-३-१३", "content_sanskrit": "शुना दृष्टं क्रोधवशा हरन्ति\nयद्दत्तमिष्टं विवृतमथो हुतं च।\nतस्माच्छुनस्त्यागमिमं कुरुष्व\nशुनस्त्यागात्प्राप्स्यसे देवलोकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2106632, "chapter_id": 3315, "verse_number": "१७-३-१४", "content_sanskrit": "त्यक्त्वा भ्रातॄन्दयितां चापि कृष्णां\nप्राप्तो लोकः कर्मणा स्वेन वीर।\nश्वानं चैनं न त्यजसे कथं नु\nत्यागं कृत्स्नं चास्थितो मुह्यसेऽद्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2106633, "chapter_id": 3315, "verse_number": "१७-३-१५x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2106634, "chapter_id": 3315, "verse_number": "१७-३-१५", "content_sanskrit": "न विद्यते संधिरथापि विग्रहो\nमृतैर्मर्त्यैरिति लोकेषु निष्ठा।\nन ते मया जीवयितुं हि शक्या-\nस्ततस्त्यागस्तेषु कृतो न जीवताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2106635, "chapter_id": 3315, "verse_number": "१७-३-१६", "content_sanskrit": "प्रतिप्रदानं शरणागतस्य\nस्त्रिया वधो ब्राह्मणस्वापहारः।\nमित्रद्रोहस्तानि चत्वारि शक्र\nभक्तत्यागश्चैव समो मतो मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2106636, "chapter_id": 3315, "verse_number": "१७-३-१७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2106637, "chapter_id": 3315, "verse_number": "१७-३-१७", "content_sanskrit": "तद्धर्मराजस्य वचो निशम्य\nधर्मस्वरूपी भगवानुवाच।\nयुधिष्ठिरं प्रीतियुक्तो नरेन्द्रं\nश्लक्ष्णैर्वाक्यैः संस्तवसंप्रयुक्तैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2106638, "chapter_id": 3315, "verse_number": "१७-३-१८", "content_sanskrit": "अभिजातोसि राजेन्द्र पितुर्वृत्तेन मेधया।\nअनुक्रोशेनि चानेन सर्वभूतेषु भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2106639, "chapter_id": 3315, "verse_number": "१७-३-१९", "content_sanskrit": "पुरा द्वैतवने चासि मया पुत्र परीक्षितः।\nपानीयार्थे पराक्रान्ता यत्र ते भ्रातरो हताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2106640, "chapter_id": 3315, "verse_number": "१७-३-२०", "content_sanskrit": "भीमार्जुनौ परित्यज्य यत्र त्वं भ्रातरावुभौ।\nमात्रोः साम्यमभीप्सन्वै नकुलं जीवमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2106641, "chapter_id": 3315, "verse_number": "१७-३-२१", "content_sanskrit": "अयं श्वा भक्त इत्येवं त्यक्तो देवरथस्त्वया।\nतस्मात्स्वर्गे न ते तुल्यः कश्चिदस्ति नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2106642, "chapter_id": 3315, "verse_number": "१७-३-२२", "content_sanskrit": "अतस्तवाक्षया लोकाः स्वशरीरेण भारत।\nप्राप्तोसि भरतश्रेष्ठ दिव्यां गतिमनुत्तमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2106643, "chapter_id": 3315, "verse_number": "१७-३-२३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2106644, "chapter_id": 3315, "verse_number": "१७-३-२३", "content_sanskrit": "ततो धर्मश्च शक्रश्च मरुतश्चाश्विनावपि।\nदेवा देवर्षयश्चैव रथमारोप्य पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2106645, "chapter_id": 3315, "verse_number": "१७-३-२४", "content_sanskrit": "प्रययुः स्वैर्विमानैस्ते सिद्धाः कामविहारिणः।\nसर्वे विरजसः पुण्याः पुण्यवाग्बुद्धिकर्मिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2106646, "chapter_id": 3315, "verse_number": "१७-३-२५", "content_sanskrit": "स तं रथं समास्थाय राजा कुरुकुलोद्वहः।\nऊर्ध्वमाचक्रमे शीघ्रं तेजसाऽऽवृत्यरोदसी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2106647, "chapter_id": 3315, "verse_number": "१७-३-२६", "content_sanskrit": "ततो देवनिकाय्यस्थो नारदः सर्वलोकवित्।\nउवाचोच्चैस्तदा वाक्यं बृहद्वादी बृहत्तपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2106648, "chapter_id": 3315, "verse_number": "१७-३-२७", "content_sanskrit": "येऽपि राजर्षयः पूर्वे ते चापि समुपस्थिताः।\nकीति प्रच्छाद्य तेषां वै कुरुराजोऽधितिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2106649, "chapter_id": 3315, "verse_number": "१७-३-२८", "content_sanskrit": "लोकानावृत्य यशसा तेजसा वृत्तसंपदा।\nस्वशरीरेण सम्प्राप्तं नान्यं शुश्रम पाण्डवात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2106650, "chapter_id": 3315, "verse_number": "१७-३-२९", "content_sanskrit": "तेजांसि यानि दृष्टानि भूमिष्ठेन त्वया विभो।\nवेश्मानि भुवि देवानां पश्यामूनि सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2106651, "chapter_id": 3315, "verse_number": "१७-३-३०", "content_sanskrit": "नारदस्य वचः श्रुत्वा राजा वचनमब्रवीत्।\nभ्रातॄनपश्यन्धर्मात्मा स्वपक्षांश्चैव पार्थिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2106652, "chapter_id": 3315, "verse_number": "१७-३-३१", "content_sanskrit": "शुभं वा यदि वा पापं भ्रातॄणां स्थानमद्य मे।\nतदेव प्राप्तुमिच्छामि लोकान्यान्न कामये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2106653, "chapter_id": 3315, "verse_number": "१७-३-३२", "content_sanskrit": "राज्ञस्तु वचनं श्रुत्वा देवराजः पुरंदरः।\nआनृशंस्यसमायुक्तं प्रत्युवाच युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2106654, "chapter_id": 3315, "verse_number": "१७-३-३३", "content_sanskrit": "स्थानेऽस्मिन्वस राजेन्द्र कर्मभिर्निर्जिते शुभैः।\nकिं त्वं मानुष्यकं स्नेहमद्यापि परिकर्षसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2106655, "chapter_id": 3315, "verse_number": "१७-३-३४", "content_sanskrit": "सिद्धिं प्राप्तोसि परमां यता नान्यः पुमान्क्वचित्।\nनैव ते भ्रातरः स्थानं सम्प्राप्ताः कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2106656, "chapter_id": 3315, "verse_number": "१७-३-३५", "content_sanskrit": "अद्यापि मानुषो भावः स्पृशते त्वां नराधिप।\nस्वर्गोऽयं पश्य देवर्षीन्सिद्धांश्च त्रिदिवालयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2106657, "chapter_id": 3315, "verse_number": "१७-३-३६", "content_sanskrit": "युधिष्ठिरस्तु देवेन्द्रमेवंवादिनमीश्वरम्।\nपुनरेवाब्रवीद्धीमानिदं वचनमर्थवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2106658, "chapter_id": 3315, "verse_number": "१७-३-३७", "content_sanskrit": "तैर्विना नोत्सहे वस्तुमिह दैत्यनिबर्हण।\nगन्तुमिच्छामि तत्राहं यत्र मे भ्रातरो गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2106659, "chapter_id": 3315, "verse_number": "१७-३-३८", "content_sanskrit": "यत्र सा बृहती श्यामा बुद्धिसत्त्वगुणान्विता।\nद्रौपदी योषितांश्रेष्ठा यत्र चैव सुता मम॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2106660, "chapter_id": 3315, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते महाप्रस्थानिकपर्वणि तृतीयोऽध्यायः॥ ३ ॥ महाप्रस्थानिकं पर्वं समाप्तम्॥ १७ ॥\n------------\nअतः परं स्वर्गारोहणपर्वः तस्यायमाद्यः श्लोकः। जनमेजय उवाच। स्वर्गं त्रिविष्टपं प्राप्य मम पूर्वपितामहाः। पाण्डवा धार्तराष्ट्राश्च कानि स्थानानि भेजिरे॥ १ ॥ इदं महाप्रस्थानिकं पर्व कुंभघोणस्येन टी.आर्. कृष्णमाचार्येण टी.आर्. व्यासाचार्येण च मुम्बय्यां निर्णयसागरमुद्रायन्त्रे मुद्रापितम्। शकाब्दाः १८३२ सन १९१०.", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]