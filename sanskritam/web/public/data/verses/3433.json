[{"id": 2112953, "chapter_id": 3433, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2112954, "chapter_id": 3433, "verse_number": "१", "content_sanskrit": "तमतीतमुपक्रम्य राजा स्वमिव बान्धवम् ।\nसभार्यः शोकमोहार्तः पर्यदेवयदातुरः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2112955, "chapter_id": 3433, "verse_number": "", "content_sanskrit": "पाण्डुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2112956, "chapter_id": 3433, "verse_number": "२", "content_sanskrit": "सतामपि कुले जाताः कर्मणा चातिदुर्गतिम् ।\nप्राप्नुवन्ति दुरात्मानः कामलोभप्रमोहिताः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2112957, "chapter_id": 3433, "verse_number": "३", "content_sanskrit": "कुले धर्मात्मनां जातः कामात्मा किल भारतः ।\nजीवितान्तमनुप्राप्तो बालभावे पिता मम \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2112958, "chapter_id": 3433, "verse_number": "४", "content_sanskrit": "तस्य कामात्मनः क्षेत्रे राज्ञः संयतवाग् ऋषिः ।\nकृष्णद्वैपायनः साक्षाद् भगवान् मामजीजनत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2112959, "chapter_id": 3433, "verse_number": "५", "content_sanskrit": "तस्य मे व्यसने बुद्धिः सञ्जातेयमिहाधुना ।\nत्यक्तस्य देवैर्विषयान् मृगयायां दुरात्मनः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2112960, "chapter_id": 3433, "verse_number": "६", "content_sanskrit": "मोक्षमेव व्यवस्यामि बन्धो हि व्यसनं महत् ।\nसद्वृत्तिमनुवर्तिष्ये तामहं पितुरव्ययाम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2112961, "chapter_id": 3433, "verse_number": "७", "content_sanskrit": "अतीव तपसाऽऽत्मानं योजयिष्याम्यसंशयम् ।\nतस्मादेकार्हमेकोऽहमेकैकस्मिन् वनस्पतौ \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2112962, "chapter_id": 3433, "verse_number": "८", "content_sanskrit": "चरन् भिक्षां मुनिर्मुण्डश्चरिष्यामि महीमिमाम् ।\nपांसुना च प्रतिच्छन्नः शून्यागारप्रतिश्रयः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2112963, "chapter_id": 3433, "verse_number": "९", "content_sanskrit": "वृक्षमूलनिकेतो वा त्यक्तसर्वप्रियाप्रियः ।\nन शोचन्न सुहृष्यंश्च तुल्यनिन्दात्मसंस्तुतिः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2112964, "chapter_id": 3433, "verse_number": "१०", "content_sanskrit": "निराशीर्निर्नमस्कारो निर्द्वन्द्वो निष्परिग्रहः ।\nन जात्वभिहसन् किञ्चिन्नकुर्वन् भ्रुकुटीं क्वचित्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2112965, "chapter_id": 3433, "verse_number": "११", "content_sanskrit": "प्रसन्नवदनो नित्यं सर्वप्राणभृतां प्रति ।\nजङ्गमाजङ्गमं सर्वमविहिंसंश्चतुर्विधम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2112966, "chapter_id": 3433, "verse_number": "१२", "content_sanskrit": "प्रजावर्गे स्ववर्गस्थः समः सर्वप्रजाः प्रति ।\nएककालं चरन् भिक्षां कुलानि द्वे च पञ्च च \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2112967, "chapter_id": 3433, "verse_number": "१३", "content_sanskrit": "असम्भवे वा भैक्षस्य चरन्ननशनान्यपि ।\nअल्पमल्पमथो भोज्यं पूर्वलोभान्न जातु चित्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2112968, "chapter_id": 3433, "verse_number": "१४", "content_sanskrit": "नित्यं नातिचरन् लाभे अलाभे सप्त पूरयन् ।\nवास्यैकं तक्षतो बाहुं चन्दनेनैकमुक्षतः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2112969, "chapter_id": 3433, "verse_number": "१५", "content_sanskrit": "नाकल्याणं न कल्याणं ध्यायन्नुभययोरपि ।\nयाःकाश्चिज्जीवता शक्याः कर्तुं नित्याक्षताः क्रियाः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2112970, "chapter_id": 3433, "verse_number": "१६", "content_sanskrit": "ताः सर्वाः समतिक्रम्य निमेषादिष्ववस्थितः ।\nन जिजीविषुवत् किञ्चिन्न मुमूर्षुवदाचरन् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2112971, "chapter_id": 3433, "verse_number": "१७", "content_sanskrit": "जीवितं मरणं चैव नाभिनन्दन् न च द्विषन् ।\nतासु चाप्यनवस्थासु त्यक्तसर्वेन्द्रियक्रियः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2112972, "chapter_id": 3433, "verse_number": "१८", "content_sanskrit": "सम्परित्यक्तसर्वात्मा सुनिर्णिक्तात्मकिल्बिषः ।\nनिर्मुक्तः सर्वपापेभ्यो व्यतीतः सर्ववागुराः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2112973, "chapter_id": 3433, "verse_number": "१९", "content_sanskrit": "न वशे कस्यचित् तिष्ठन् सधर्मा मातविश्वनः ।\nएतया सततं वृत्त्या चरन्नेवम्प्रकारया \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2112974, "chapter_id": 3433, "verse_number": "२०", "content_sanskrit": "देहं सन्तारयिष्यामि निर्भयं ज्ञानमाश्रितः ।\nनाहं श्वाचरिते मार्गे स्ववीर्यक्षयशोचिते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2112975, "chapter_id": 3433, "verse_number": "२१", "content_sanskrit": "स्वधर्मात् सततापेते चरेयं वीरवर्जिते ।\nसत्कृतोऽसत्कृतो वाऽपि योऽन्यां कृपणचक्षुषा ।\nउपैति वृत्तिं कामात्मा स शुनां वर्तते पथि \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2112976, "chapter_id": 3433, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2112977, "chapter_id": 3433, "verse_number": "२२", "content_sanskrit": "एवमुक्त्वा सुदुःखार्तः स राजा भरतर्षभः ।\nअवेक्षमाणः कुन्तीं च माद्रीं च समभाषत \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2112978, "chapter_id": 3433, "verse_number": "२३", "content_sanskrit": "कौसल्या विदुरः क्षत्ता राजा च सहबन्धुभिः ।\nआर्या सत्यवती भीष्मः ते च सर्वहिता मम\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2112979, "chapter_id": 3433, "verse_number": "२४", "content_sanskrit": "ब्राह्मणाश्च महाभागे लोके ये संशितव्रताः ।\nपौरवृद्धाश्च ये तत्र निवसन्त्यस्मदाश्रयाः ।\nप्रसाद्य सर्वे वक्तव्याः पाण्डुः प्रव्राजितो वनम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2112980, "chapter_id": 3433, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2112981, "chapter_id": 3433, "verse_number": "२५", "content_sanskrit": "श्रुत्वा च वचनं भर्तुः त्यागधर्मकृतात्मनः ।\nते समं वचनं कुन्ती माद्री च समभाषताम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2112982, "chapter_id": 3433, "verse_number": "२६", "content_sanskrit": "अन्येऽपि ह्माश्रमाः सन्ति ये शक्या भरतर्षभ ।\nआवाभ्यां सह सञ्चर्तुं धर्ममाश्रित्य चिन्त्यताम् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2112983, "chapter_id": 3433, "verse_number": "२७", "content_sanskrit": "आवाभ्यां धर्मपत्नीभ्यां सह तप्त्वा महत्तपः ।\nत्वमेव भविताऽस्यार्थं स्वर्गे चापि न संशयः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2112984, "chapter_id": 3433, "verse_number": "२८", "content_sanskrit": "प्रणिधायेन्द्रियग्रामं भर्तृलोकं नरर्षभ ।\nत्यक्तकामसुखे ह्मावां राजंस्तप्स्यावहे तपः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2112985, "chapter_id": 3433, "verse_number": "२९", "content_sanskrit": "यदि वाऽऽवां महाभाग त्यक्ष्यस्येव विशाम्पते ।\nअद्यैवाऽऽवां प्रहास्यावो जीवितं भरतर्षभ \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2112986, "chapter_id": 3433, "verse_number": "", "content_sanskrit": "पाण्डुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2112987, "chapter_id": 3433, "verse_number": "३०", "content_sanskrit": "यदि व्यवसितं त्वेवं युवाभ्यां धर्ममिश्रितम् ।\nसद्वृत्तिमनुवर्तिष्ये तामहं पितुरव्ययाम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2112988, "chapter_id": 3433, "verse_number": "३१", "content_sanskrit": "त्यक्तग्राम्यसमाचारः तप्यमानो महत्तपः ।\nवल्कली फलमूलाशी चरिष्यामि महावने \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2112989, "chapter_id": 3433, "verse_number": "३२", "content_sanskrit": "अग्निं जुह्वदुभौ कालावुभौ कालावुपस्पृशन् ।\nकृशः परिमिताहारश्चीरचर्मजटाधरः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2112990, "chapter_id": 3433, "verse_number": "३३", "content_sanskrit": "शीतवातातपसहः क्षुत्पिपासाश्रमान्वितः ।\nतपसा विधियुक्तेन शरीरं परिशोषयन् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2112991, "chapter_id": 3433, "verse_number": "३४", "content_sanskrit": "एकान्तशीलो विमृशन् पक्कापक्वेन वर्तयन् ।\nपितॄन् देवांश्च वन्येन वाग्भिरद्भिश्च तर्पयन् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2112992, "chapter_id": 3433, "verse_number": "३५", "content_sanskrit": "वानप्रस्थजनस्यापि दर्शयन् कुलवासिनः ।\nनाप्रियाणि चरन् जातु किं पुनर्ग्रामवासिनः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2112993, "chapter_id": 3433, "verse_number": "३६", "content_sanskrit": "एवमारण्यशास्त्राणामुक्तमुग्रं तपोविधिम् ।\nतपमानः प्रतीक्षिष्ये देहस्यास्य विमोक्षणम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2112994, "chapter_id": 3433, "verse_number": "", "content_sanskrit": "वैशम्पयानः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2112995, "chapter_id": 3433, "verse_number": "३७", "content_sanskrit": "एवमुक्त्वा स भार्ये ते राजा कौरववंशजः ।\nततश्चूडामणिं निष्कानङ्गदे कुण्डलानि च \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2112996, "chapter_id": 3433, "verse_number": "३८", "content_sanskrit": "मकुटं हारसूत्रं च कटिबन्धं तथैव च ।\nवासांसि विमलाः खङ्गाः स्त्रीणामाभरणानि च \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2112997, "chapter_id": 3433, "verse_number": "३९", "content_sanskrit": "वाहनानि च मुख्यानि शस्त्राणि विविधानि च ।\nहैमभाण्डानि दिव्यानि पर्यङ्कास्तरणानि च \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2112998, "chapter_id": 3433, "verse_number": "४०", "content_sanskrit": "मणिमुक्ताप्रवाळानि वसूनि विविधानि च ।\nआसनानि च मुख्यानि बहूनि विविधानि च \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2112999, "chapter_id": 3433, "verse_number": "४१", "content_sanskrit": "प्रदाय सर्वं विप्रेभ्यः पाण्डुः पुनरभाषत ।\nगत्वा नागपुरं वाच्यं पाण्डुः प्रव्राजितो वने \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2113000, "chapter_id": 3433, "verse_number": "४२", "content_sanskrit": "अर्थं कामं रतिं चैव विविधानि धनानि च ।\nप्रतस्थे सर्वमुसृज्य सभार्यो भरतर्षभः \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2113001, "chapter_id": 3433, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2113002, "chapter_id": 3433, "verse_number": "४३", "content_sanskrit": "ततस्तस्यानुयात्राणि सर्वे च परिचारकाः ।\nश्रुत्वा भरतसिंहस्य विविधाः करुणा गिरः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2113003, "chapter_id": 3433, "verse_number": "४४", "content_sanskrit": "भीममार्तस्वरं कृत्वा हाहेति परिचुक्रुशुः ।\nउष्णमास्रं प्रमुञ्चन्तः तमालोक्य यशस्विनम् \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2113004, "chapter_id": 3433, "verse_number": "४५", "content_sanskrit": "ययुर्नागपुरं तूर्णं सर्वमादाय तद्धनम् ।\nते गत्वा नगरं राज्ञे यथावृत्तं महात्मने \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2113005, "chapter_id": 3433, "verse_number": "४६", "content_sanskrit": "कथयाञ्चक्रिरे सर्वं धनं च विविधं ददुः ।\nगृहीत्वा धृतराष्ट्रस्तु धनं भरतसत्तम \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2113006, "chapter_id": 3433, "verse_number": "४७", "content_sanskrit": "कृपायुक्तो महाराजः पाण्डुमेव स्म शोचति ।\nराजपुत्रस्तु कौसल्यो मुनिर्मूलफलाशनः \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2113007, "chapter_id": 3433, "verse_number": "४८", "content_sanskrit": "जगाम सह भार्याभ्यामाशु नागसहं गिरिम् ।\nस चैत्ररथमासाद्य वारिषेणमवाप्य च \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2113008, "chapter_id": 3433, "verse_number": "४९", "content_sanskrit": "वारिषेणमतिक्रम्य गत्वा गन्धरजोवहम् ।\nरक्ष्यमाणो महाभूतैः सिद्धैश्च परमर्षिभिः \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2113009, "chapter_id": 3433, "verse_number": "५०", "content_sanskrit": "उवास सततं राजा समेषु विषमेषु च ।\nइन्द्रद्युम्नसरः प्राप्य हंसकूटमतीत्य च \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2113010, "chapter_id": 3433, "verse_number": "५१", "content_sanskrit": "शतशृङ्गे महाप्राज्ञः तापसः समपद्यत ।\nतत्रापि तपसि श्रेष्ठे वर्तमानः परन्तपः \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2113011, "chapter_id": 3433, "verse_number": "५२", "content_sanskrit": "सिद्धचारणसङ्घानां बभूव परमप्रियः ।\nशुश्रूषुरनहंवादी नियतात्मा जितेन्द्रियः \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2113012, "chapter_id": 3433, "verse_number": "५३", "content_sanskrit": "स्वर्गं गन्तुं पराक्रान्तः स्वेन वीर्येण भारत ।\nकेषाञ्चिदभवद् भ्राता केषाञ्चिदभवत् सखा\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2113013, "chapter_id": 3433, "verse_number": "५४", "content_sanskrit": "ऋषिभिस्त्वभवत् कैश्चित् पुत्रवत् परिरक्षितः ।\nस तु कालेन महता प्राप्य निष्कल्मषं तपः \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2113014, "chapter_id": 3433, "verse_number": "५५", "content_sanskrit": "ब्रह्मर्षिसदृशः पाण्डुरभवद् भरतर्षभ ।\nअमावास्यां तु सहिता ऋषयः संशितव्रताः \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2113015, "chapter_id": 3433, "verse_number": "५६", "content_sanskrit": "ब्रह्माणं द्रष्टुकामास्ते सम्प्रतस्थुर्मनीषिणः ।\nसम्प्रस्थितानृषीन् दृष्ट्वा पाण्डुर्वचनमब्रवीत् ।\nभवन्तः क्व गमिष्यन्ति ब्रूत मे वदतां वराः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2113016, "chapter_id": 3433, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2113017, "chapter_id": 3433, "verse_number": "५७", "content_sanskrit": "समवायो महानद्य ब्रह्मलोके महात्मनाम् ।\nदेवानां च ऋषीणां च पितृणां च महात्मनाम् ।\nवयं तत्र गमिष्यामो द्रष्टुकामाः स्वयम्भुवम् \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2113018, "chapter_id": 3433, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2113019, "chapter_id": 3433, "verse_number": "५८", "content_sanskrit": "पाण्डुमुत्थाय सहसा गन्तुकामं महर्षयः ।\nस्वर्गमार्गं तितीर्षन्तं शतश्रुङ्गादुदङ्मुखम्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2113020, "chapter_id": 3433, "verse_number": "५९", "content_sanskrit": "प्रस्थितं सह भार्याभ्यामब्रुवंस्ते तपोधनाः ।\nउपर्युपरि गच्छन्तः शैलराजमुदङ्मुखाः \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2113021, "chapter_id": 3433, "verse_number": "६०", "content_sanskrit": "प्रपश्यामो गिरिं तस्मिन् दुर्गान् देशान् बहून् वयम् ।\nयक्षराक्षसगुप्तानि गन्धर्वचरितानि च \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2113022, "chapter_id": 3433, "verse_number": "६१", "content_sanskrit": "आक्रीडितान्यप्सरोभिः सह देवगणैः सदा ।\nसदनानि कुबेरस्य हृद्यानि च मृदूनि च\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2113023, "chapter_id": 3433, "verse_number": "६२", "content_sanskrit": "तेषां नदं नितम्बांश्च घोरांश्च गिरिगह्वरान् ।\nसन्ति नित्यं हिमाक्रान्ता निवृत्तमृगपक्षिणः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2113024, "chapter_id": 3433, "verse_number": "६३", "content_sanskrit": "सन्ति केचित् सदावर्षा घोररूपा दुरासदाः ।\nपक्षिणोऽत्र न गच्छन्ति कथमेवापरे मृगाः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2113025, "chapter_id": 3433, "verse_number": "६५", "content_sanskrit": "वायुरेवात्र संयाति सिद्धा यक्षाश्च चारणाः ।\nगच्छन्त्यौ शैलराजेऽस्मिन् राजपुत्र्यौ कथं त्विमे ।\nन सीदेतामदुःखार्हे मा गमो भरतर्षभ \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2113026, "chapter_id": 3433, "verse_number": "", "content_sanskrit": "पाण्डुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2113027, "chapter_id": 3433, "verse_number": "६६", "content_sanskrit": "अप्रजस्य किल स्वर्गमद्वारं सम्प्रचक्षते ।\nस हि सन्तापतप्तोऽहमप्रजश्च ब्रवीमि वः \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2113028, "chapter_id": 3433, "verse_number": "६७", "content_sanskrit": "सोऽहमुग्रेण तपसा सभार्यस्त्यक्तजीवितः ।\nअनपत्योऽपि विन्देयं स्वर्गमुग्रेण कर्मणा \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2113029, "chapter_id": 3433, "verse_number": "", "content_sanskrit": "तापसाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2113030, "chapter_id": 3433, "verse_number": "६८", "content_sanskrit": "अप्रजश्च महाभाग न स्वर्गं गन्तुमर्हसि ।\nअस्ति वै तव धर्मात्मन् विदुर्देवोपमं शुभम्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2113031, "chapter_id": 3433, "verse_number": "६९", "content_sanskrit": "अपत्यमनघं त्विष्टं पश्यामो दिव्यचक्षुषा ।\nदैवादिष्टं मनुष्येन्द्र कारणेनोपपादय\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2113032, "chapter_id": 3433, "verse_number": "७०", "content_sanskrit": "अरिष्टं क्षेममव्यग्रो विन्देथाः परमां गतिम् ।\nतस्मादिष्टफले तात कुरु यत्नं यथागमम् ।\nअपत्यं गुणसम्पन्नं लब्ध्वा प्रीतिमवाप्स्यसि \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2113033, "chapter_id": 3433, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2113034, "chapter_id": 3433, "verse_number": "७१", "content_sanskrit": "तच्छ्रुत्वा तापसवचः कौरव्यः समचिन्तयत् ।\nमृगशापादपहतामात्मनो हीन्द्रियक्रियाम्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2113035, "chapter_id": 3433, "verse_number": "७२", "content_sanskrit": "अथ पारशवीं कन्यां देवकस्य महीपतेः ।\nरूपयौवनसम्पन्नां स शुश्रावापगासुतः \t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2113036, "chapter_id": 3433, "verse_number": "७३", "content_sanskrit": "ततस्तु वरयित्वा तामानाय्य भरतर्षभः ।\nविवाहं कारयामाम विदुरस्य महामतेः \t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2113037, "chapter_id": 3433, "verse_number": "७४", "content_sanskrit": "तस्यां चोत्पादयामास विदुरः कुरुनन्दनः ।\nपुत्रान् विनयसम्पन्नानात्मनः सदृशान् गुणैः \t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2113038, "chapter_id": 3433, "verse_number": "११२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायामादिपर्वणि\nद्वादशाधिकशततमोऽध्यायः ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2113039, "chapter_id": 3433, "verse_number": "६०", "content_sanskrit": "॥ इति सम्भवपर्वणि षष्टितमोऽध्यायः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2113040, "chapter_id": 3433, "verse_number": "", "content_sanskrit": "* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}]