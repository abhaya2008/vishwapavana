[{"id": 7004346000, "chapter_id": 24346, "verse_number": "५-३-४०-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततो गच्छेत्तु राजेन्द्र करञ्जेश्वरमुत्तमम् ।\nयत्र सिद्धो महाभागो दैत्यो लोकेषु विश्रुतः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004346001, "chapter_id": 24346, "verse_number": "५-३-४०-२", "content_sanskrit": "युधिष्ठिर उवाच ।\nयोऽसौ सिद्धो महाभाग तत्र तीर्थे महातपाः ।\nकस्य पुत्रः कथं सिद्धः कस्मिन्काले वद द्विज॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004346002, "chapter_id": 24346, "verse_number": "५-३-४०-३", "content_sanskrit": "मार्कण्डेय उवाच ।\nपुरा कृतयुगे राजन्मानसो ब्रह्मणः सुतः ।\nवेदवेदाङ्गतत्त्वज्ञो मरीचिर्नाम नामतः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004346003, "chapter_id": 24346, "verse_number": "५-३-४०-४", "content_sanskrit": "तस्यापि तपसो राशेः कालेन महतानघ ।\nपुत्रोऽथ मानसो जातः साक्षाद्ब्रह्मेव चापरः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004346004, "chapter_id": 24346, "verse_number": "५-३-४०-५", "content_sanskrit": "क्षमा दमो दया दानं सत्यं शौचमथार्जवम् ।\nमरीचेश्च गुणा ह्येते सन्ति तस्य च भारत॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004346005, "chapter_id": 24346, "verse_number": "५-३-४०-६", "content_sanskrit": "एवं गुणगणाकीर्णं कश्यपं द्विजसत्तमम् ।\nज्ञात्वा प्रजापतिर्दक्षो भार्यार्थे स्वसुतां ददौ॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004346006, "chapter_id": 24346, "verse_number": "५-३-४०-७", "content_sanskrit": "अदितिर्दितिर्दनुश्चैव तथाप्येवं दशापराः ।\nयासां पुत्राश्च संजाताः पौत्राश्च भरतर्षभ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004346007, "chapter_id": 24346, "verse_number": "५-३-४०-८", "content_sanskrit": "अदितिर्जनयामास पुत्रानिन्द्रपुरोगमान् ।\nजातास्तस्य महाबाहो कश्यपस्य प्रजापतेः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004346008, "chapter_id": 24346, "verse_number": "५-३-४०-९", "content_sanskrit": "यैस्तु लोकत्रयं व्याप्तं स्थावरं जङ्गमं महत् ।\nतथान्यस्य महाभागो दनोः पुत्रो व्यजायत॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004346009, "chapter_id": 24346, "verse_number": "५-३-४०-१०", "content_sanskrit": "सर्वलक्षणसम्पन्नः करञ्जो नाम नामतः ।\nबाल एव महाभाग चचार स महत्तपः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004346010, "chapter_id": 24346, "verse_number": "५-३-४०-११", "content_sanskrit": "नर्मदातटमाश्रित्य चातिघोरमनुत्तमम् ।\nदिव्यं वर्षसहस्रं च कृच्छ्रचान्द्रायणं नृप॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004346011, "chapter_id": 24346, "verse_number": "५-३-४०-१२", "content_sanskrit": "शाकमूलफलाहारः स्नानहोमपरायणः ।\nततस्तुष्टो महादेव उमया सहितः किल॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004346012, "chapter_id": 24346, "verse_number": "५-३-४०-१३", "content_sanskrit": "वरेण छन्दयामास त्रिपुरान्तकरः प्रभुः ।\nभोः करञ्ज महासत्त्व परितुष्टोऽस्मि तेऽनघ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004346013, "chapter_id": 24346, "verse_number": "५-३-४०-१४", "content_sanskrit": "वरं वृणीष्व ते दद्मि ह्यमरत्वमृते मम॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004346014, "chapter_id": 24346, "verse_number": "५-३-४०-१५", "content_sanskrit": "करञ्ज उवाच ।\nयदि तुष्टो महादेव यदि देयो वरो मम ।\nतर्हि पुत्राश्च पौत्राश्च सन्तु मे धर्मवत्सलाः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004346015, "chapter_id": 24346, "verse_number": "५-३-४०-१६", "content_sanskrit": "तथेत्युक्त्वा महादेव उमया सहितस्तदा ।\nवृषारूढो गणैः सार्द्धं तत्रैवान्तरधीयत॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004346016, "chapter_id": 24346, "verse_number": "५-३-४०-१७", "content_sanskrit": "गते चादर्शनं देवे सोऽपि दैत्यो मुदान्वितः ।\nस्वनाम्नात्र महादेवं स्थापयित्वा ययौ गृहम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004346017, "chapter_id": 24346, "verse_number": "५-३-४०-१८", "content_sanskrit": "तदाप्रभृति तत्तीर्थं सर्वतीर्थेष्वनुत्तमम् ।\nस्नानमात्रानरस्तत्र मुच्यते सर्वपातकैः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004346018, "chapter_id": 24346, "verse_number": "५-३-४०-१९", "content_sanskrit": "तत्र तीर्थे तु यः स्नात्वा तर्पयेत्पितृदेवताः ।\nसोऽग्निष्टोमस्य यज्ञस्य फलं प्राप्नोत्यसंशयम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004346019, "chapter_id": 24346, "verse_number": "५-३-४०-२०", "content_sanskrit": "अनाशकं तु यः कुर्यात्तस्मिंस्तीर्थे नराधिप ।\nअनिवर्त्या गतिस्तस्य रुद्रलोकं स गच्छति॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004346020, "chapter_id": 24346, "verse_number": "५-३-४०-२१", "content_sanskrit": "अथवाग्निजले प्राणान्यस्त्यजेद्धर्मनन्दन ।\nअयुतद्वितयं वस्ते वर्षाणां शिवमन्दिरे॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004346021, "chapter_id": 24346, "verse_number": "५-३-४०-२२", "content_sanskrit": "ततश्चैव क्षये जाते जायते विमले कुले ।\nवेदवेदाङ्गतत्त्वज्ञः सर्वशास्त्रविशारदः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004346022, "chapter_id": 24346, "verse_number": "५-३-४०-२३", "content_sanskrit": "राजा वा राजतुल्यो वा जीवेच्च शरदः शतम् ।\nपुत्रपौत्रसमोपेतः सर्वव्याधिविवर्जितः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004346023, "chapter_id": 24346, "verse_number": "५-३-४०-२४", "content_sanskrit": "एवं ते सर्वमाख्यातं पृष्टं यद्यत्त्वयानघ ।\nतीर्थस्य तु फलं तस्य स्नानदानेषु भारत॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004346024, "chapter_id": 24346, "verse_number": "५-३-४०-२५", "content_sanskrit": "एतत्पुण्यं पापहरं धन्यं दुःस्वप्ननाशनम् ।\nपठतां शृण्वतां चैव तीर्थमाहात्म्यमुत्तमम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004346025, "chapter_id": 24346, "verse_number": "५-३-४०-२६", "content_sanskrit": "यस्तु श्रावयते श्राद्धे पठेत्पितृपरायणः ।\nअक्षयं जायते पुण्यमित्येवं शङ्करोऽब्रवीत्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]