[{"id": 2060372, "chapter_id": 2292, "verse_number": "८-१३-०x", "content_sanskrit": "`सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2060373, "chapter_id": 2292, "verse_number": "८-१३-१", "content_sanskrit": "श्रुतकीर्तिमथायान्तं किरन्तं निशिताञ्शरान्।\nमद्रराजो महाराज वारयामास हृष्टवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2060374, "chapter_id": 2292, "verse_number": "८-१३-२", "content_sanskrit": "मद्रराजं समासाद्य श्रुतकीर्तिर्महारथः।\nविव्याध भल्लैर्विशत्या कार्तस्वरविभूषितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2060375, "chapter_id": 2292, "verse_number": "८-१३-३", "content_sanskrit": "प्रतिविव्याध तं शल्यं त्रिभिस्तूर्णमजिह्मगैः।\nसारथिं चास्य भल्लेन भृशं विव्याध भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2060376, "chapter_id": 2292, "verse_number": "८-१३-४", "content_sanskrit": "स शल्यं शरवर्षेण च्छादयामास संयुगे।\nमुमोच निशितान्बाणान्मद्रराजरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2060377, "chapter_id": 2292, "verse_number": "८-१३-५", "content_sanskrit": "ततः शल्यो महाराज श्रुतकीर्तिभुजच्युतान्।\nचिच्छेद समरे बाणासन्बणैः सन्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2060378, "chapter_id": 2292, "verse_number": "८-१३-६", "content_sanskrit": "श्रुतकीर्तिस्ततः श्ल्यं भित्त्वा नवभिरायसैः।\nसारथिं त्रिभिरानर्च्छत्पुनः शल्यं च प़ञ्चभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2060379, "chapter_id": 2292, "verse_number": "८-१३-७", "content_sanskrit": "तस्य शल्यो धनुश्छित्त्वा हस्तावापं निकृत्य च।\nविव्याध समरे तूर्णं सप्तभिस्तं शरोत्तमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2060380, "chapter_id": 2292, "verse_number": "८-१३-८", "content_sanskrit": "अथान्यद्धनुरादाय श्रुतकीर्तिर्महारथः।\nभद्रेश्वरं चतुःषष्ट्या बाह्वोरुरसि चार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2060381, "chapter_id": 2292, "verse_number": "८-१३-९", "content_sanskrit": "ततस्तु समरे राजंस्तेन विद्वः शिलीमुखैः।\nxxविव्याध तं चापि नवत्या निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2060382, "chapter_id": 2292, "verse_number": "८-१३-१०", "content_sanskrit": "तस्य मद्रेश्वरश्चापं पुनश्चिच्छेद मारिष।\nस च्छिन्नधन्वा समरे गदां चिक्षेप सत्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2060383, "chapter_id": 2292, "verse_number": "८-१३-११", "content_sanskrit": "पट्टैर्जाम्बूनदैर्बद्धां रुप्यपट्टैश्च भारत।\nभ्राजमानां यथा नारीं दिव्यवस्त्रविभूषिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2060384, "chapter_id": 2292, "verse_number": "८-१३-१२", "content_sanskrit": "तामापतन्तीं सहसा दीप्यमानाशनिप्रभाम्।\nशरैरनेकसाहस्रैर्व्यष्टम्भयत मद्रराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2060385, "chapter_id": 2292, "verse_number": "८-१३-१३", "content_sanskrit": "विष्टभ्य च गदां वीरः पातयित्वा च भूतले।\nश्रुकीर्तिमथायत्तो राजन्विव्याध पञ्चभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2060386, "chapter_id": 2292, "verse_number": "८-१३-१४", "content_sanskrit": "तस्य शक्तिं रमे भूयश्चिक्षेप भुजोपमाम्।\nतां द्विधा चाछिनच्छल्यो मेदिन्यां सा त्वशीर्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2060387, "chapter_id": 2292, "verse_number": "८-१३-१५", "content_sanskrit": "तस्य शल्यः क्षुरप्रेण यन्तुः कायाच्छिरोऽहरत्।\nबालहस्ताद्यथा श्येन आमिषं वै नरोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2060388, "chapter_id": 2292, "verse_number": "८-१३-१६", "content_sanskrit": "स पपात रथोपस्थात्सारथिस्तस्य भारत।\nततस्ते प्राद्रवन्सङ्ख्ये हय्नास्तस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2060389, "chapter_id": 2292, "verse_number": "८-१३-१७", "content_sanskrit": "पलायमानैस्तैरश्वैः सोपनीतो रमाजिरात्।\nश्रुतकीर्तिर्महाराज पश्यतां सर्वयोधिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2060390, "chapter_id": 2292, "verse_number": "८-१३-१८", "content_sanskrit": "ततो मद्रेश्वरो राजा पाण्डवानामनीकिनीम्।\nव्यगाहत मुदा युक्तो नलिनीं द्विरदो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2060391, "chapter_id": 2292, "verse_number": "८-१३-१९", "content_sanskrit": "लोलयामास स बलं सिंहः पशुगणानिव।\nशल्यस्तत्र महारङ्गे पाण्डवानां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2060392, "chapter_id": 2292, "verse_number": "८-१३-२०", "content_sanskrit": "निपात्य पाण्डुपाञ्चालान्पृतनासु व्यवस्थितः।\nअशोभत रणे शल्यो विधूमोऽग्निरिव ज्वलन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2060393, "chapter_id": 2292, "verse_number": "८-१३-२१", "content_sanskrit": "सेनाकक्षं महद्दग्ध्वा कक्षमग्निरिवोत्थितः।\nस्थितो रराज समरे पुरं दग्ध्वेव शङ्करः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2060394, "chapter_id": 2292, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि षोडशदिवसयुद्धे त्रयोदशोऽध्यायः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]