[{"id": 2085858, "chapter_id": 2827, "verse_number": "१२-३३२-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2085859, "chapter_id": 2827, "verse_number": "१२-३३२-१", "content_sanskrit": "स लब्ध्वा परमं देवाद्वरं सत्यवतीसुतः।\nअरणीं तु ततो गृह्य ममन्थाग्निचिकीर्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2085860, "chapter_id": 2827, "verse_number": "१२-३३२-२", "content_sanskrit": "अथ रूपं परं राजन्बिभ्रतीं स्वेन तेजसा।\nघृताचीं नामाप्सरसमपश्यद्भगवानृषिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2085861, "chapter_id": 2827, "verse_number": "१२-३३२-३", "content_sanskrit": "ऋषिरप्सरसं दृष्ट्वा सहसा काममोहितः।\nअभवद्भगवान्व्यासो वने तस्मिन्युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2085862, "chapter_id": 2827, "verse_number": "१२-३३२-४", "content_sanskrit": "सा च दृष्ट्वा तदा व्यासं कामसंविग्नमानसम्।\nशुकी भूत्वा महाराज घृताची समुपागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2085863, "chapter_id": 2827, "verse_number": "१२-३३२-५", "content_sanskrit": "स तामप्सरसं दृष्ट्वा रूपेणान्येन संवृताम्।\nशरीरजेनानुगतः सर्वगात्रातिगेन ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2085864, "chapter_id": 2827, "verse_number": "१२-३३२-६", "content_sanskrit": "स तु धैर्येण महता निगृह्णन्हृच्छयं मुनिः।\nन शशाक नियन्तुं तद्व्यासः प्रविसृतं मनः।\nभावित्वाच्चैव भावस्य घृताच्या वपुषा हृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2085865, "chapter_id": 2827, "verse_number": "१२-३३२-७", "content_sanskrit": "यत्नान्नियच्छतस्तस्य मुनेरग्निचिकीर्षया।\nअरण्यामेव सहसा तस्य शुक्रमवापतत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2085866, "chapter_id": 2827, "verse_number": "१२-३३२-८", "content_sanskrit": "सोऽविशङ्केन मनसा तथैव द्विजसत्तमः।\nअरणीं ममन्थ ब्रह्मर्षिस्तस्यां जज्ञे शुको नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2085867, "chapter_id": 2827, "verse_number": "१२-३३२-९", "content_sanskrit": "शुक्रे निर्मथ्यमाने स शुको जज्ञे महातपाः।\nपरमर्षिर्महायोगी अरणीगर्भसंभवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2085868, "chapter_id": 2827, "verse_number": "१२-३३२-१०", "content_sanskrit": "यथाऽध्वरे समिद्धोऽग्निर्भाति हव्यमुदावहन्।\nतथारूपः शुको जज्ञे प्रज्वलन्निव तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2085869, "chapter_id": 2827, "verse_number": "१२-३३२-११", "content_sanskrit": "विभ्रत्पितुश्च कौरव्य रूपवर्णमनुत्तमम्।\nबभौ तदा भावितात्मा विधूमोऽग्निरिवज्वलन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2085870, "chapter_id": 2827, "verse_number": "१२-३३२-१२", "content_sanskrit": "तं गङ्गा सरितां श्रेष्ठा मेरुपृष्ठे जनेश्वर।\nस्वरूपिणी तदाऽभ्येत्य स्नापयामास वारिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2085871, "chapter_id": 2827, "verse_number": "१२-३३२-१३", "content_sanskrit": "अन्तरिक्षाच्च कौरव्य दण्डः कृष्णाजिनं च ह।\nपपात भुवि राजेन्द्र शुकस्थार्थे महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2085872, "chapter_id": 2827, "verse_number": "१२-३३२-१४", "content_sanskrit": "जेगीयन्ते स्म गन्धर्वा ननृतुश्चाप्सरोगणाः।\nदेवदुन्दुभयश्चैव प्रावाद्यन्त सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2085873, "chapter_id": 2827, "verse_number": "१२-३३२-१५", "content_sanskrit": "विश्वासुश्च गन्धर्वस्तथा तुम्बुरुनारदौ।\nहाहा हूहूश्च गन्धर्वौ तुष्टुवुः शुकसंभवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2085874, "chapter_id": 2827, "verse_number": "१२-३३२-१६", "content_sanskrit": "तत्र शक्रपुरोगाश्च लोकपालाः समागताः।\nदेवा देवर्षयश्चैव तथा ब्रह्मर्षयोऽपि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2085875, "chapter_id": 2827, "verse_number": "१२-३३२-१७", "content_sanskrit": "दिव्यानि सर्वपुष्पाणि प्रववर्ष च मारुतः।\nजङ्गमं स्थावरं चैव प्रहृष्टमभवज्जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2085876, "chapter_id": 2827, "verse_number": "१२-३३२-१८", "content_sanskrit": "तं महात्मा स्वयं प्रीत्या देव्या सह महाद्युतिः।\nजतामात्रं मुनेः पुत्रं विधिनोपानयत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2085877, "chapter_id": 2827, "verse_number": "१२-३३२-१९", "content_sanskrit": "तस्य देवेश्वरः शक्रो दिव्यमद्भुतदर्शनम्।\nददौ कमण्डलुं प्रीत्या देववासांसि चाभिभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2085878, "chapter_id": 2827, "verse_number": "१२-३३२-२०", "content_sanskrit": "हंसाश्च शतपत्राश्च सारसाश्च सहस्रशः।\nप्रदक्षिणमवर्तन्त शुकाश्चाषाश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2085879, "chapter_id": 2827, "verse_number": "१२-३३२-२१", "content_sanskrit": "आरणेयस्ततो दिव्यं प्राप्य जन्म महाद्युतिः।\nतत्रैवोवास मेधावी ब्रह्मचारी समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2085880, "chapter_id": 2827, "verse_number": "१२-३३२-२२", "content_sanskrit": "उत्पन्नमात्रं तं वेदाः सरहस्याः ससंग्रहाः।\nउपतस्थुर्महाराज यथाऽस्य पितरं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2085881, "chapter_id": 2827, "verse_number": "१२-३३२-२३", "content_sanskrit": "बृहस्पतिं च वव्रे स वेदवेदाङ्गभाष्यवित्।\nउपाध्यायं महाराज धर्ममेवानुचिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2085882, "chapter_id": 2827, "verse_number": "१२-३३२-२४", "content_sanskrit": "सोऽधीत्य निखिलान्वेदान्सरहस्यान्ससंग्रहान्।\nइतिहासं च कार्त्स्न्येन धर्मशास्त्राणि चाभिभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2085883, "chapter_id": 2827, "verse_number": "१२-३३२-२५", "content_sanskrit": "गुरवे दक्षिणां दत्त्वा समावृत्तो महामुनिः।\nउग्रं तपः समारेभे ब्रह्मचारी समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2085884, "chapter_id": 2827, "verse_number": "१२-३३२-२६", "content_sanskrit": "देवतानामृषीणां च बाल्येऽपि स महातपाः।\nसंमन्त्रणीयो मान्यश्च ज्ञानेन तपसा तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2085885, "chapter_id": 2827, "verse_number": "१२-३३२-२७", "content_sanskrit": "न त्वस्य रमते बुद्धिराश्रमेषु नराधिप।\nत्रिषु गार्हस्थ्यमूलेषु मोक्षधर्मानुदर्शिनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2085886, "chapter_id": 2827, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि द्वात्रिंशदधिकत्रिशततमोऽध्यायः॥ ३३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]