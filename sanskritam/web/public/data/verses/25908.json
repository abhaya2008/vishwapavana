[{"id": 7005908000, "chapter_id": 25908, "verse_number": "१-९१-१", "content_sanskrit": "सूत उवाच ।\nस्वायम्भुवाद्या मुनयो हरिं ध्यायन्ति र्मणा।\nव्रताचारार्चनाध्यानस्तुतिजप्यपरायणाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005908001, "chapter_id": 25908, "verse_number": "१-९१-२", "content_sanskrit": "देहेन्द्रियमनोबुद्धिप्राणाहङ्कारवर्जितम्।\nआकशेन विहीनं वै तेजसा परिवर्जितम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005908002, "chapter_id": 25908, "verse_number": "१-९१-३", "content_sanskrit": "उदकेन विहीनं वै तद्धर्मपरिवर्जितम।\nपृथिवीरहितं चैव सर्वभूतविवर्जितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005908003, "chapter_id": 25908, "verse_number": "१-९१-४", "content_sanskrit": "भूताध्यक्षं तथा बद्धनियन्तारं प्रभुं विभुम।\nचैतन्यरूपतारूपं सर्वाध्यक्षं निरञ्जनम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005908004, "chapter_id": 25908, "verse_number": "१-९१-५", "content_sanskrit": "मुक्तसङ्गं महेशानं सर्वदेवप्रपूजितम् ।\nतेजोरूपमसत्त्वं च तपसा परिवर्जितम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005908005, "chapter_id": 25908, "verse_number": "१-९१-६", "content_sanskrit": "रहितं रजसा नित्यं व्यतिरिक्तं गुणैस्त्रिभि।\nसर्वरूपविहीनं वै कर्तृत्वादिविवर्जितम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005908006, "chapter_id": 25908, "verse_number": "१-९१-७", "content_sanskrit": "वासनारहितं शुद्धं सर्वदोषविवर्जितम् ।\nपिपासावर्जितं तत्तच्छो कमोहविवर्जितम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005908007, "chapter_id": 25908, "verse_number": "१-९१-८", "content_sanskrit": "जरामरणहीनं वै कूटस्थं मोहवर्जितम् ।\nउत्पत्तिरहितं चैव प्रलयेन विवर्जितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005908008, "chapter_id": 25908, "verse_number": "१-९१-९", "content_sanskrit": "सत्यं सर्वाचारहीनं निष्कलं परमेश्वरम् ।\nजाग्रत्स्वप्नसुषुप्त्यादिवर्जितं नामवर्जितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005908009, "chapter_id": 25908, "verse_number": "१-९१-१०", "content_sanskrit": "अध्यक्षं जाग्रदादीनां शान्तरूपं सुरेश्वरम् ।\nजाग्रदादिस्थितं नित्यं कार्य्यकारणवर्जितम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005908010, "chapter_id": 25908, "verse_number": "१-९१-११", "content_sanskrit": "सर्वदृष्टं तथा मूर्त्तं सूक्ष्मं सूक्ष्मतरंरम्।\nज्ञानदृक् श्रोत्रविज्ञानं परमानन्दरूपकम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005908011, "chapter_id": 25908, "verse_number": "१-९१-१२", "content_sanskrit": "विश्वेन रहितं तद्वत्तैजसेन विवर्जितम् ।\nप्राज्ञेन रहितञ्चैव तुरीयं परमाक्षरम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005908012, "chapter_id": 25908, "verse_number": "१-९१-१३", "content_sanskrit": "सर्वगोप्तृ सर्वहन्तृ सर्वभूतात्मरूपि।\nबुद्धिधर्मविहीनं वै निराधारं शिवं हरिम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005908013, "chapter_id": 25908, "verse_number": "१-९१-१४", "content_sanskrit": "विक्रियारहितं चैव वेदान्तैर्वेद्यमेव च ।\nवेदरूपं परं भूतमिन्द्रियेभ्यः परं शुभम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005908014, "chapter_id": 25908, "verse_number": "१-९१-१५", "content_sanskrit": "शब्देन वर्जितञ्चैव रसेन च विवर्जितम् ।\nस्पर्शेन रहितं देवं रूपमात्रविवर्जितम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005908015, "chapter_id": 25908, "verse_number": "१-९१-१६", "content_sanskrit": "रूपेण रहितञ्चैव गन्धेन परिवर्जितम् ।\nअनादि ब्रह्मरन्ध्रान्तमहं ब्रह्मास्मि केवलम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005908016, "chapter_id": 25908, "verse_number": "१-९१-१७", "content_sanskrit": "एवं ज्ञात्वा महादेवध्यानं कुर्य्याज्जितेन्द्रियः ।\nध्यानं यः कुरुते ह्येवं स भवेद्बह्म मानवः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005908017, "chapter_id": 25908, "verse_number": "१-९१-१८", "content_sanskrit": "इति ध्यानं समाख्यातमश्विरस्य मया तव ।\nअधुना कथयाम्यन्यत्किन्तद्ब्रूहि वृषध्वज ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]