[{"id": 2047085, "chapter_id": 2044, "verse_number": "६-९३-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2047086, "chapter_id": 2044, "verse_number": "६-९३-१", "content_sanskrit": "विमुखीकृत्य वर्सांस्तु तावकान्युधि राक्षसः।\nजिघांसुभरतश्रेष्ठ दुर्योधनमुपाद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2047087, "chapter_id": 2044, "verse_number": "६-९३-२", "content_sanskrit": "तमापतन्तं संप्रेक्ष्य राजानं प्रति वेगितम् ।\nअभ्यधावञ्जिघांसन्तस्तावका युद्धदुर्मदाःक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2047088, "chapter_id": 2044, "verse_number": "६-९३-३", "content_sanskrit": "तालमात्राणि चापानि विकर्षन्तो महारथाः ।\nतमेकमभ्यधावन्त नदन्तः सिंहसङ्घवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2047089, "chapter_id": 2044, "verse_number": "६-९३-४", "content_sanskrit": "अथैनं शरवर्षेण समन्तात्पर्यवाकिरन् ।\nपर्वतं वारिधाराभिः शरदीव वलाहकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2047090, "chapter_id": 2044, "verse_number": "६-९३-५", "content_sanskrit": "स गाढविद्धो व्यथितस्तोत्रार्दित इव द्विपः ।\nउत्पपात तदाऽऽकाशं समन्ताद्वैनतेयवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2047091, "chapter_id": 2044, "verse_number": "६-९३-६", "content_sanskrit": "व्यनदत्सुमहानादं जीमूत इव शारदः ।\nदिशः खं विदिशश्चैव नादयन्भैरवस्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2047092, "chapter_id": 2044, "verse_number": "६-९३-७", "content_sanskrit": "राक्षसस्य तु तं शब्दं श्रुत्वा राजा युधिष्ठिरः ।\nउवाच भरतश्रेष्ठ भीमसेनमरिन्दमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2047093, "chapter_id": 2044, "verse_number": "६-९३-८", "content_sanskrit": "युध्यते राक्षसो नूनं धार्तराष्ट्रैर्महारथैः ।\nयथाऽस्य श्रूयते शब्दो नदतो भैरवं स्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2047094, "chapter_id": 2044, "verse_number": "६-९३-९", "content_sanskrit": "अतिभारं च पश्यामि तस्मिन्राक्षसपुङ्गवे ।\nपितामहश्च संक्रुद्धः पाञ्चालान्हन्तुमुद्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2047095, "chapter_id": 2044, "verse_number": "६-९३-१०", "content_sanskrit": "तेषां च रक्षणार्थाय युध्यते फल्गुनः परैः।\nएतज्ज्ञात्वा महाबाहो कार्यद्वयमुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2047096, "chapter_id": 2044, "verse_number": "६-९३-११", "content_sanskrit": "गच्छ रक्षस्व हैडिम्बं शंशयं परमं गतम् ।\nभ्रातुर्वचनमाज्ञाय त्वरमाणो वृकोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2047097, "chapter_id": 2044, "verse_number": "६-९३-१२", "content_sanskrit": "प्रययौ सिंहनादेन त्रासयन्सर्वपार्थिवान् ।\nवेगेन महता राजन्पर्वकाले यथोदधिःक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2047098, "chapter_id": 2044, "verse_number": "६-९३-१३", "content_sanskrit": "तमन्वगात्सत्यधृतिः सौचित्तिर्युद्धदुर्मदः ।\nश्रेणिमान्वसुदानश्च पुत्रः काश्यस्य चाभिभूः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2047099, "chapter_id": 2044, "verse_number": "६-९३-१४", "content_sanskrit": "अभिमन्युमुखाश्चैव द्रौपदेया महारथाः ।\nक्षत्रदेवश्च विक्रन्तः क्षत्रधर्मा तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2047100, "chapter_id": 2044, "verse_number": "६-९३-१५", "content_sanskrit": "अनूपाधिपतिश्चैव नीलः स्वबलमास्थितः ।\nमहता रथवंशेन हैडिम्बं पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2047101, "chapter_id": 2044, "verse_number": "६-९३-१६", "content_sanskrit": "कुञ्चरैश्च सदा मत्तैः षट्सहस्रैः प्रहारिभिःक ।\nअभ्यरक्षन्त सहिता राक्षसेन्द्रं घटोत्कचम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2047102, "chapter_id": 2044, "verse_number": "६-९३-१७", "content_sanskrit": "सिंहनादेन महता नेमिघोषेण चैव ह।\nखुरशब्दनिपातैश्च कम्पयन्तो वसुंधराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2047103, "chapter_id": 2044, "verse_number": "६-९३-१८", "content_sanskrit": "तेषामापततां श्रुत्वा शब्दं तं तावकं बलम् ।\nभीमसेनभयोद्विग्नं विवर्णवदनं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2047104, "chapter_id": 2044, "verse_number": "६-९३-१९", "content_sanskrit": "परिवृत्य महाराज परित्यज्य घटोत्कचम् ।\nततः प्रववृते युद्धंक तत्र तेषां महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2047105, "chapter_id": 2044, "verse_number": "६-९३-२०", "content_sanskrit": "तावकानां परेषां च संग्रामेष्वनिवर्तिनाम् ।\nनानारूपाणि शस्त्राणि विसृजन्तो महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2047106, "chapter_id": 2044, "verse_number": "६-९३-२१", "content_sanskrit": "अन्योन्यमभिधावन्तः संप्रहारं प्रचक्रिरे ।\nव्यतिष्यक्तं महारौद्रं युद्धं भीरुभयावहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2047107, "chapter_id": 2044, "verse_number": "६-९३-२२", "content_sanskrit": "हया हयैः समाजग्मुः पादाताश्च पदातिभिः ।\n`रथा रथैः समागच्छन्नागा नागैश्च संयुगे\nअन्योन्यं समरे राजन्प्रार्थयानाः समभ्ययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2047108, "chapter_id": 2044, "verse_number": "६-९३-२३", "content_sanskrit": "सहसा चाभवत्तीव्रं सन्निपातन्महद्रजः।\nगजाश्वरथपत्तीनां पादनेमिसमुद्धतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2047109, "chapter_id": 2044, "verse_number": "६-९३-२४", "content_sanskrit": "धूम्रारुणं रजस्तीव्रं रणभूमिं समावृणोत्।\nनैव स्वे न परे राजन्समजानन्परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2047110, "chapter_id": 2044, "verse_number": "६-९३-२५", "content_sanskrit": "पिता पुत्रं न जानीते पुत्रो वा पितरं तथा ।\nनिर्मर्यादे तथाभूते वैशसे रोमहर्षणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2047111, "chapter_id": 2044, "verse_number": "६-९३-२६", "content_sanskrit": "शस्त्राणां भरतश्रेष्ठ मनुष्याणां च र्जताम् ।\nसुमहानभवच्छब्दः प्रेतानामिव भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2047112, "chapter_id": 2044, "verse_number": "६-९३-२७", "content_sanskrit": "गजवाजिमनुष्याणां शोणितान्रतरङ्गिणी ।\nप्राववर्तत नदी तत्र केशशैवलशाद्वला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2047113, "chapter_id": 2044, "verse_number": "६-९३-२८", "content_sanskrit": "नराणां चैव कायेभ्यः शिरसां पततां रणे।\nशुश्रुवे सुमहाञ्छब्दः पततामश्मनामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2047114, "chapter_id": 2044, "verse_number": "६-९३-२९", "content_sanskrit": "विशिरस्कैर्मनुष्यैश्च छिन्नगात्रैश्च वारणैः ।\nअश्वैः संभिन्नदेहैश्च संकीर्णाऽभूद्वसुंधरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2047115, "chapter_id": 2044, "verse_number": "६-९३-३०", "content_sanskrit": "नानाविधानि शस्त्राणि विसृजन्तो महारथाः ।\nअन्योन्यमभिधावन्तः संप्रहारार्थमुद्यताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2047116, "chapter_id": 2044, "verse_number": "६-९३-३१", "content_sanskrit": "हया हयान्समासाद्य प्रेषिता हयसादिभिः ।\nसमाहत्य रणेऽन्योन्यं निपेतुर्गतजीविताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2047117, "chapter_id": 2044, "verse_number": "६-९३-३२", "content_sanskrit": "नरा नरान्समासाद्य क्रोधरक्तेक्षणा भृशम् ।\nउरांस्युरोभिरन्योन्यं समाश्लिष्य निजघ्निरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2047118, "chapter_id": 2044, "verse_number": "६-९३-३३", "content_sanskrit": "प्रेषिताश्च महामात्रैर्वारणाः परवारणैः ।\nअभ्यघ्नन्त विषणाग्रैर्वारणानेव संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2047119, "chapter_id": 2044, "verse_number": "६-९३-३४", "content_sanskrit": "ते जातरुधिरोत्पीडाः पताकाभिरलङ्कृताः ।\nसंसक्ताः प्रत्यदृश्यन्त मेघा इव सविद्युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2047120, "chapter_id": 2044, "verse_number": "६-९३-३५", "content_sanskrit": "केचिद्भिन्ना विषाणाग्रैर्भिन्नकुम्भाश्च तोमरैः ।\nविनदन्तोऽभ्यधावन्त गर्जमाना धना इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2047121, "chapter_id": 2044, "verse_number": "६-९३-३६", "content_sanskrit": "केचिद्धस्तैर्द्विधाच्छिन्नैश्छिन्नगात्रास्तथाऽपरे ।\nनिपेतुस्तुमुले तस्मिंश्छिन्नपक्षा इवाद्रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2047122, "chapter_id": 2044, "verse_number": "६-९३-३७", "content_sanskrit": "पार्श्वैस्तु दारितैरन्ये वारणैर्वरवारणाः ।\nमुमुचुः शोणितं भूरि धातूनिव महीधराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2047123, "chapter_id": 2044, "verse_number": "६-९३-३८", "content_sanskrit": "नाराचनिहतास्त्वन्ये तथा विद्धाश्च तोमरैः ।\nविनदन्तोऽभ्यधावन्त विशृङ्गा इव पर्वताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2047124, "chapter_id": 2044, "verse_number": "६-९३-३९", "content_sanskrit": "केचित्क्रोधसमाविष्टा मदान्धा निरवग्रहाः ।\nरथान्हयान्पदातींश्च ममृदुः शतशो रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2047125, "chapter_id": 2044, "verse_number": "६-९३-४०", "content_sanskrit": "तथा हया हयारोहैस्ताडिताः प्रासतोमरैः ।\nतेन तेनाभ्यवर्तन्त कुर्वन्तो व्याकुला दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2047126, "chapter_id": 2044, "verse_number": "६-९३-४१", "content_sanskrit": "रथिनो रथिभिः सार्धं कुलपुत्रास्तनुत्यजः।\nपरां शक्तिं समास्थाय चक्रुः कर्माण्यभीतवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2047127, "chapter_id": 2044, "verse_number": "६-९३-४२", "content_sanskrit": "स्वयंवर इवामर्दे प्रजह्रुरितरेतरम् ।\nप्रार्थयाना यशो राजन्स्वर्गं वा युद्धशालिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2047128, "chapter_id": 2044, "verse_number": "६-९३-४३", "content_sanskrit": "तस्मिंस्तथा वर्तमाने संग्रामे रोमहर्षणे।\nधार्तराष्ट्रं महत्सैन्यं प्रययौ विमुखीकृतम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2047129, "chapter_id": 2044, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि अष्टमदिवसयुद्धे त्रिनवतितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]