[{"id": 7004498000, "chapter_id": 24498, "verse_number": "५-३-१९२-१", "content_sanskrit": "मार्कण्डेय उवाच ।\nतस्यैवानन्तरं तात देवतीर्थमनुत्तमम् ।\nदृष्ट्वा तु श्रीपतिं पापैर्मुच्यते मानवो भुवि॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004498001, "chapter_id": 24498, "verse_number": "५-३-१९२-२", "content_sanskrit": "महर्षेस्तस्य जामाता भृगोर्देवो जनार्दनः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004498002, "chapter_id": 24498, "verse_number": "५-३-१९२-३", "content_sanskrit": "युधिष्ठिर उवाच ।\nकोऽयं श्रियः पतिर्देवो देवानामधिपो विभुः ।\nकथं जन्माभवत्तस्य देवेषु त्रिषु वा मुने॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004498003, "chapter_id": 24498, "verse_number": "५-३-१९२-४", "content_sanskrit": "सम्बन्धी च कथं जातो भृगुणा सह केशवः ।\nएतद्विस्तरतो ब्रह्मन् वक्तुमर्हसि भार्गव॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004498004, "chapter_id": 24498, "verse_number": "५-३-१९२-५", "content_sanskrit": "मार्कण्डेय उवाच ।\nसंक्षेपात्कथयिष्यामि साध्यस्य चरितं महत् ।\nन हि विस्तरतो वक्तुं शक्ताः सर्वे महर्षयः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004498005, "chapter_id": 24498, "verse_number": "५-३-१९२-६", "content_sanskrit": "नारायणस्य नाभ्यब्जाज्जातो देवश्चतुर्मुखः ।\nतस्य दक्षोऽङ्गजो राजन् दक्षिणाङ्गुष्ठसम्भवः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004498006, "chapter_id": 24498, "verse_number": "५-३-१९२-७", "content_sanskrit": "धर्मः स्तनान्तात्संजातस्तस्य पुत्रोऽभवत्किल ।\nनारायणसहायोऽसावजोऽपि भरतर्षभ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004498007, "chapter_id": 24498, "verse_number": "५-३-१९२-८", "content_sanskrit": "मरुत्वती वसुर्ज्ञाना लम्बा भानुमती सती ।\nसंकल्पा च मुहूर्ता च साध्या विश्वावती ककुप्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004498008, "chapter_id": 24498, "verse_number": "५-३-१९२-९", "content_sanskrit": "धर्मपत्न्यो दशैवैता दाक्षायण्यो महाप्रभाः ।\nतासां साध्या महाभागा पुत्रानजनयन्नृप॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004498009, "chapter_id": 24498, "verse_number": "५-३-१९२-१०", "content_sanskrit": "नरो नारायणश्चैव हरिः कृष्णस्तथैव च ।\nविष्णोरंशांशका ह्येते चत्वारो धर्मसूनवः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004498010, "chapter_id": 24498, "verse_number": "५-३-१९२-११", "content_sanskrit": "तथा नारायणनरौ गन्धमादनपर्वते ।\nआत्मन्यात्मानमाधाय तेपतुः परमं तपः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004498011, "chapter_id": 24498, "verse_number": "५-३-१९२-१२", "content_sanskrit": "ध्यायमानावनौपम्यं स्वं कारणमकारणम् ।\nवासुदेवमनिर्देश्यमप्रतर्क्यमनन्तरम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004498012, "chapter_id": 24498, "verse_number": "५-३-१९२-१३", "content_sanskrit": "योगयुक्तौ महात्मानावास्थितावुरुतापसौ ।\nतयोस्तपःप्रभावेण न तताप दिवाकरः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004498013, "chapter_id": 24498, "verse_number": "५-३-१९२-१४", "content_sanskrit": "ववाह शङ्कितो वायुः सुखस्पर्शो ह्यशङ्कितः ।\nशिशिरोऽभवदत्यर्थं ज्वलन्नपि विभावसुः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004498014, "chapter_id": 24498, "verse_number": "५-३-१९२-१५", "content_sanskrit": "सिंहव्याघ्रादयः सौम्याश्चेरुः सह मृगैर्गिरौ ।\nतयोर्गौरिव भारार्ता पृथिवी पृथिवीपते॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004498015, "chapter_id": 24498, "verse_number": "५-३-१९२-१६", "content_sanskrit": "चेरुश्च भूधराश्चैव चुक्षुभे च महोदधिः ।\nदेवाश्च स्वेषु धिष्ण्येषु निष्प्रभेषु हतप्रभाः ।\nबभूवुरवनीपाल परमं क्षोभमागताः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004498016, "chapter_id": 24498, "verse_number": "५-३-१९२-१७", "content_sanskrit": "देवराजस्तथा शक्रः संतप्तस्तपसा तयोः ।\nयुयोजाप्सरसस्तत्र तयोर्विघ्नचिकीर्षया॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004498017, "chapter_id": 24498, "verse_number": "५-३-१९२-१८", "content_sanskrit": "इन्द्र उवाच ।\nरम्भे तिलोत्तमे कुब्जे घृताचि ललिते शुभे ।\nप्रम्लोचे सुभ्रु सुम्लोचे सौरभेयि महोद्धते॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004498018, "chapter_id": 24498, "verse_number": "५-३-१९२-१९", "content_sanskrit": "अलम्बुषे मिश्रकेशि पुण्डरीके वरूथिनि ।\nविलोकनीयं बिभ्राणा वपुर्मन्मथबोधनम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004498019, "chapter_id": 24498, "verse_number": "५-३-१९२-२०", "content_sanskrit": "गन्धमादनमासाद्य कुरुध्वं वचनं मम ।\nनरनारायणौ तत्र तपोदीक्षान्वितौ द्विजौ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004498020, "chapter_id": 24498, "verse_number": "५-३-१९२-२१", "content_sanskrit": "तेपाते धर्मतनयौ तपः परमदुश्चरम् ।\nतावस्माकं वरारोहाः कुर्वाणौ परमं तपः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004498021, "chapter_id": 24498, "verse_number": "५-३-१९२-२२", "content_sanskrit": "कर्मातिशयदुःखार्तिप्रदावायतिनाशनौ ।\nतद्गच्छत न भीः कार्या भवतीभिरिदं वचः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004498022, "chapter_id": 24498, "verse_number": "५-३-१९२-२३", "content_sanskrit": "स्मरः सहायो भविता वसन्तश्च वराङ्गनाः ।\nरूपं वयः समालोक्य मदनोद्दीपनं परम् ।\nकन्दर्पवशमभ्येति विवशः को न मानवः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004498023, "chapter_id": 24498, "verse_number": "५-३-१९२-२४", "content_sanskrit": "मार्कण्डेय उवाच ।\nइत्युक्त्वा देवराजेन मदनेन समं तदा ।\nजग्मुरप्सरसः सर्वा वसन्तश्च महीपते॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004498024, "chapter_id": 24498, "verse_number": "५-३-१९२-२५", "content_sanskrit": "गन्धमादनमासाद्य पुंस्कोकिलकुलाकुलम् ।\nचचार माधवो रम्यं प्रोत्फुल्लवनपादपम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004498025, "chapter_id": 24498, "verse_number": "५-३-१९२-२६", "content_sanskrit": "प्रववौ दक्षिणाशायां मलयानुगतोऽनिलः ।\nभृङ्गमालारुतरवै रमणीयमभूद्वनम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004498026, "chapter_id": 24498, "verse_number": "५-३-१९२-२७", "content_sanskrit": "गन्धश्च सुरभिः सद्यो वनराजिसमुद्भवः ।\nकिन्नरोरगयक्षाणां बभूव घ्राणतर्पणः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004498027, "chapter_id": 24498, "verse_number": "५-३-१९२-२८", "content_sanskrit": "वराङ्गनाश्च ताः सर्वा नरनारायणावृषी ।\nविलोभयितुमारब्धा वागङ्गललितस्मितैः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004498028, "chapter_id": 24498, "verse_number": "५-३-१९२-२९", "content_sanskrit": "जगौ मनोहरं काचिन्ननर्त तत्र चाप्सराः ।\nअवादयत्तथैवान्या मनोहरतरं नृप॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004498029, "chapter_id": 24498, "verse_number": "५-३-१९२-३०", "content_sanskrit": "हावैर्भावैः सृतैर्हास्यैस्तथान्या वल्गुभाषितैः ।\nतयोः क्षोभाय तन्वङ्ग्यश्चक्रुरुद्यममङ्गनाः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004498030, "chapter_id": 24498, "verse_number": "५-३-१९२-३१", "content_sanskrit": "तथापि न तयोः कश्चिन्मनसः पृथिवीपते ।\nविकारोऽभवदध्यात्मपारसम्प्राप्तचेतसोः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004498031, "chapter_id": 24498, "verse_number": "५-३-१९२-३२", "content_sanskrit": "निवातस्थौ यथा दीपावकम्पौ नृप तिष्ठतः ।\nवासुदेवार्पणस्वस्थे तथैव मनसी तयोः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004498032, "chapter_id": 24498, "verse_number": "५-३-१९२-३३", "content_sanskrit": "पूर्यमाणोऽपि चाम्भोभिर्भुवमन्यां महोदधिः ।\nयथा न याति संक्षोभं तथा तन्मानसं क्वचित्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004498033, "chapter_id": 24498, "verse_number": "५-३-१९२-३४", "content_sanskrit": "सर्वभूतहितं ब्रह्म वासुदेवमयं परम् ।\nमन्यमानौ न रागस्य द्वेषस्य च वशंगतौ॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004498034, "chapter_id": 24498, "verse_number": "५-३-१९२-३५", "content_sanskrit": "स्मरोऽपि न शशाकाथ प्रवेष्टुं हृदयं तयोः ।\nविद्यामयं दीपयुतमन्धकार इवालयम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004498035, "chapter_id": 24498, "verse_number": "५-३-१९२-३६", "content_sanskrit": "पुष्पोज्ज्वलांस्तरुवरान् वसन्तं दक्षिणानिलम् ।\nताश्चैवाप्सरसः सर्वाः कन्दर्पं च महामुनी॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004498036, "chapter_id": 24498, "verse_number": "५-३-१९२-३७", "content_sanskrit": "यच्चारब्धं तपस्ताभ्यामात्मानं गन्धमादनम् ।\nददर्शातेऽखिलं रूपं ब्रह्मणः पुरुषर्षभ॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004498037, "chapter_id": 24498, "verse_number": "५-३-१९२-३८", "content_sanskrit": "दाहाय नामलो वह्नेर्नापः क्लेदाय चाम्भसः ।\nतद्द्रव्यमेव तद्द्रव्यविकाराय न वै यतः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004498038, "chapter_id": 24498, "verse_number": "५-३-१९२-३९", "content_sanskrit": "ततो विज्ञाय विज्ञाय परं ब्रह्म स्वरूपतः ।\nमधुकन्दर्पयोषित्सु विकारो नाभवत्तयोः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004498039, "chapter_id": 24498, "verse_number": "५-३-१९२-४०", "content_sanskrit": "ततो गुरुतरं यत्नं वसन्तमदनौ नृप ।\nचक्राते ताश्च तन्वङ्ग्यस्तत्क्षोभाय पुनःपुनः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004498040, "chapter_id": 24498, "verse_number": "५-३-१९२-४१", "content_sanskrit": "अथ नारायणो धैर्यं संधायोदीर्णमानसः ।\nऊरोरुत्पादयामास वराङ्गीमबलां तदा॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004498041, "chapter_id": 24498, "verse_number": "५-३-१९२-४२", "content_sanskrit": "त्रैलोक्यसुन्दरीरत्नमशेषमवनीपते ।\nगुणैर्लाघवमभ्येति यस्याः संदर्शनादनु॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004498042, "chapter_id": 24498, "verse_number": "५-३-१९२-४३", "content_sanskrit": "तां विलोक्य महीपाल चकम्पे मनसानिलः ।\nवसन्तो विस्मयं यातः स्मरः सस्मार किंचन॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004498043, "chapter_id": 24498, "verse_number": "५-३-१९२-४४", "content_sanskrit": "रम्भातिलोत्तमाद्याश्च वैलक्ष्यं देवयोषितः ।\nन रेजुरवनीपाल तल्लक्ष्यहृदयेक्षणाः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004498044, "chapter_id": 24498, "verse_number": "५-३-१९२-४५", "content_sanskrit": "ततः कामो वसन्तश्च पार्थिवाप्सरसश्च ताः ।\nप्रणम्य भगवन्तौ तौ तुष्टुवुर्मुनिसत्तमौ॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004498045, "chapter_id": 24498, "verse_number": "५-३-१९२-४६", "content_sanskrit": "वसन्तकामाप्सरस ऊचुः ।\nप्रसीदतु जगद्धाता यस्य देवस्य मायया ।\nमोहिताः स्म विजानीमो नान्तरं विद्यते द्वयोः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004498046, "chapter_id": 24498, "verse_number": "५-३-१९२-४७", "content_sanskrit": "प्रसीदतु स वां देवो यस्य रूपमिदं द्विधा ।\nधामभूतस्य लोकानामनादेरप्रतिष्ठतः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004498047, "chapter_id": 24498, "verse_number": "५-३-१९२-४८", "content_sanskrit": "नरनारायणौ देवौ शङ्खचक्रायुधावुभौ ।\nआस्तां प्रसादसुमुखावस्माकमपराधिनाम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004498048, "chapter_id": 24498, "verse_number": "५-३-१९२-४९", "content_sanskrit": "निधानं सर्वविद्यानां सर्वपापवनानलः ।\nनारायणोऽतो भगवान् सर्वपापं व्यपोहतु॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004498049, "chapter_id": 24498, "verse_number": "५-३-१९२-५०", "content_sanskrit": "शार्ङ्गचिह्नायुधः श्रीमानात्मज्ञानमयोऽनघः ।\nनरः समस्तपापानि हतात्मा सर्वदेहिनाम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004498050, "chapter_id": 24498, "verse_number": "५-३-१९२-५१", "content_sanskrit": "जटाकलापबद्धोऽयमनयोर्नः क्षमावतोः ।\nसौम्यास्यदृष्टिः पापानि हन्तुं जन्मार्जितानि वै॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004498051, "chapter_id": 24498, "verse_number": "५-३-१९२-५२", "content_sanskrit": "तथात्मविद्यादोषेण योऽपराधः कृतो महान् ।\nत्रैलोक्यवन्द्यौ यौ नाथौ विलोभयितुमागताः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004498052, "chapter_id": 24498, "verse_number": "५-३-१९२-५३", "content_sanskrit": "प्रसीद देव विज्ञानधन मूढदृशामिव ।\nभवन्ति सन्तः सततं स्वधर्मपरिपालकाः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004498053, "chapter_id": 24498, "verse_number": "५-३-१९२-५४", "content_sanskrit": "दृष्ट्वैतन्नः समुत्पन्नं यथा स्त्रीरत्नमुत्तमम् ।\nत्वयि नारायणोत्पन्ना श्रेष्ठा पारवती मतिः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004498054, "chapter_id": 24498, "verse_number": "५-३-१९२-५५", "content_sanskrit": "तेन सत्येन सत्यात्मन्परमात्मन्सनातन ।\nनारायण प्रसीदेश सर्वलोकपरायण॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004498055, "chapter_id": 24498, "verse_number": "५-३-१९२-५६", "content_sanskrit": "प्रसन्नबुद्धे शान्तात्मन्प्रसन्नवदनेक्षण ।\nप्रसीद योगिनामीश नर सर्वगताच्युत॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004498056, "chapter_id": 24498, "verse_number": "५-३-१९२-५७", "content_sanskrit": "नमस्यामो नरं देवं तथा नारायणं हरिम् ।\nनमो नराय नम्याय नमो नारायणाय च॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004498057, "chapter_id": 24498, "verse_number": "५-३-१९२-५८", "content_sanskrit": "प्रसन्नानामनाथानां तथा नाथवतां प्रभो ।\nशं करोतु नरोऽस्माकं शं नारायण देहि नः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004498058, "chapter_id": 24498, "verse_number": "५-३-१९२-५९", "content_sanskrit": "मार्कण्डेय उवाच ।\nएवमभ्यर्चितः स्तुत्या रागद्वेषादिवर्जितः ।\nप्राहेशः सर्वभूतानां मध्ये नारायणो नृप॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004498059, "chapter_id": 24498, "verse_number": "५-३-१९२-६०", "content_sanskrit": "नारायण उवाच ।\nस्वागतं माधवे कामे भवत्वप्सरसामपि ।\nयत्कार्यमागतानां च इहास्माभिस्तदुच्यताम्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004498060, "chapter_id": 24498, "verse_number": "५-३-१९२-६१", "content_sanskrit": "यूयं संसिद्धये नूनमस्माकं बलशत्रुणा ।\nसंप्रेषितास्ततोऽस्माकं नृत्ययोगादिदर्शनम्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004498061, "chapter_id": 24498, "verse_number": "५-३-१९२-६२", "content_sanskrit": "न वयं गीतनृत्येन नाङ्गचेष्टादिभाषितैः ।\nलुब्धा वै विषयैर्मन्ये विषया दारुणात्मकाः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004498062, "chapter_id": 24498, "verse_number": "५-३-१९२-६३", "content_sanskrit": "शब्दादिसङ्गदुष्टानि यदा नाक्षाणि नः शुभाः ।\nतदा नृत्यादयो भावाः कथं लोभप्रदायिनः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004498063, "chapter_id": 24498, "verse_number": "५-३-१९२-६४", "content_sanskrit": "ते सिद्धाः स्म न वै साध्या भवतीनां स्मरस्य च ।\nमाधवस्य च शाक्रोऽपि स्वास्थ्यं यात्वविशङ्किताः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004498064, "chapter_id": 24498, "verse_number": "५-३-१९२-६५", "content_sanskrit": "योऽसौ परश्च परमः पुरुषः परमेश्वरः ।\nपरमात्मा समस्तस्य स्थावरस्य चरस्य च॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004498065, "chapter_id": 24498, "verse_number": "५-३-१९२-६६", "content_sanskrit": "उत्पत्तिहेतुरेते च यस्मिन्सर्वं प्रलीयते ।\nसर्वावासीति देवत्वाद्वासुदेवेत्युदाहृतः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004498066, "chapter_id": 24498, "verse_number": "५-३-१९२-६७", "content_sanskrit": "वयमंशांशकास्तस्य चतुर्व्यूहस्य मानिनः ।\nतदादेशितवार्त्मानौ जगद्बोधाय देहिनाम्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004498067, "chapter_id": 24498, "verse_number": "५-३-१९२-६८", "content_sanskrit": "तत्सर्वभूतं सर्वेशं सर्वत्र समदर्शिनम् ।\nकुतः पश्यन्तौ रागादीन्करिष्यामो विभेदिनः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004498068, "chapter_id": 24498, "verse_number": "५-३-१९२-६९", "content_sanskrit": "वसन्ते मयि चेन्द्रे च भवतीषु तथा स्मरे ।\nयदा स एव भूतात्मा तदा द्वेषादयः कथम्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004498069, "chapter_id": 24498, "verse_number": "५-३-१९२-७०", "content_sanskrit": "तन्मयान्यविभक्तानि यदा सर्वेषु जन्तुषु ।\nसर्वेश्वरेश्वरो विष्णुः कुतो रागादयस्ततः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004498070, "chapter_id": 24498, "verse_number": "५-३-१९२-७१", "content_sanskrit": "ब्रह्माणमिन्द्रमीशानमादित्यमरुतोऽखिलान् ।\nविश्वेदेवानृषीन् साध्यान्वसून्पितृगणांस्तथा॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004498071, "chapter_id": 24498, "verse_number": "५-३-१९२-७२", "content_sanskrit": "यक्षराक्षसभूतादीन्नागान्सर्पान्सरीसृपान् ।\nमनुष्यपक्षिगोरूपगजसिंहजलेचरान्॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004498072, "chapter_id": 24498, "verse_number": "५-३-१९२-७३", "content_sanskrit": "मक्षिकामशकान्दंशाञ्छलभाञ्जलजान् कृमीन् ।\nगुल्मवृक्षलतावल्लीत्वक्सारतृणजातिषु॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004498073, "chapter_id": 24498, "verse_number": "५-३-१९२-७४", "content_sanskrit": "यच्च किंचिददृश्यं वा दृश्यं वा त्रिदशाङ्गनाः ।\nमन्यध्वं जातमेकस्य तत्सर्वं परमात्मनः॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004498074, "chapter_id": 24498, "verse_number": "५-३-१९२-७५", "content_sanskrit": "जायमानः कथं विष्णुमात्मानं परमं च यत् ।\nरागद्वेषौ तथा लोभं कः कुर्यादमराङ्गनाः॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004498075, "chapter_id": 24498, "verse_number": "५-३-१९२-७६", "content_sanskrit": "सर्वभूतमये विष्णौ सर्वगे सर्वधातरि ।\nनिपात्य तं पृथग्भूते कुतो रागादिको गुणः॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004498076, "chapter_id": 24498, "verse_number": "५-३-१९२-७७", "content_sanskrit": "एवमस्मासु युष्मासु सर्वभूतेषु चाबलाः ।\nतन्मथैकत्वभूतेषु रागाद्यवसरः कुतः॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004498077, "chapter_id": 24498, "verse_number": "५-३-१९२-७८", "content_sanskrit": "सम्यग्दृष्टिरियं प्रोक्ता समस्तैक्यावलोकिनी ।\nपृथग्विज्ञानमात्रैव लोकसंव्यवहारवत्॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004498078, "chapter_id": 24498, "verse_number": "५-३-१९२-७९", "content_sanskrit": "भूतेन्द्रियान्तः करणप्रधानपुरुषात्मकम् ।\nजगद्वै ह्येतदखिलं तदा भेदः किमात्मकः॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004498079, "chapter_id": 24498, "verse_number": "५-३-१९२-८०", "content_sanskrit": "भवन्ति लयमायान्ति समुद्रसलिलोर्मयः ।\nन वारिभेदतो भिन्नास्तथैवैक्यादिदं जगत्॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004498080, "chapter_id": 24498, "verse_number": "५-३-१९२-८१", "content_sanskrit": "यथाग्नेरर्चिषः पीताः पिङ्गलारुणधूसराः ।\nतथापि नाग्नितो भिन्नास्तथैतद्ब्रह्मणो जगत्॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004498081, "chapter_id": 24498, "verse_number": "५-३-१९२-८२", "content_sanskrit": "भवतीभिश्च यत्क्षोभमस्माकं स पुरंदरः ।\nकारयत्यसदेतच्च विवेकाचारचेतसाम्॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004498082, "chapter_id": 24498, "verse_number": "५-३-१९२-८३", "content_sanskrit": "भवन्त्यः स च देवेन्द्रो लोकाश्च ससुरासुराः ।\nसमुद्राद्रिवनोपेता मद्देहान्तरगोचराः॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004498083, "chapter_id": 24498, "verse_number": "५-३-१९२-८४", "content_sanskrit": "यथेयं चारुसर्वाङ्गी भवतीनां मयाग्रतः ।\nदर्शिता दर्शयिष्यामि तथा चैवाखिलं जगत्॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004498084, "chapter_id": 24498, "verse_number": "५-३-१९२-८५", "content_sanskrit": "प्रयातु शक्रो मा गर्वमिन्द्रत्वं कस्य सुस्थिरम् ।\nयूयं च मा स्मयं यात सन्ति रूपान्विताः स्त्रियः॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004498085, "chapter_id": 24498, "verse_number": "५-३-१९२-८६", "content_sanskrit": "किं सुरूपं कुरूपं वा यदा भेदो न दृश्यते ।\nतारतम्यं सुरूपत्वे सततं भिन्नदर्शनात्॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004498086, "chapter_id": 24498, "verse_number": "५-३-१९२-८७", "content_sanskrit": "भवतीनां स्मयं मत्वा रूपौदार्यगुणोद्भवम् ।\nमयेयं दर्शिता तन्वी ततस्तु शममेष्यथ॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004498087, "chapter_id": 24498, "verse_number": "५-३-१९२-८८", "content_sanskrit": "यस्मान्मदूरोर्निष्पन्ना त्वियमिन्दीवरेक्षणा ।\nउर्वशी नाम कल्याणी भविष्यति वराप्सराः॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004498088, "chapter_id": 24498, "verse_number": "५-३-१९२-८९", "content_sanskrit": "तदियं देवराजस्य नीयतां वरवर्णिनी ।\nभवत्यस्तेन चास्माकं प्रेषिताः प्रीतिमिच्छता॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004498089, "chapter_id": 24498, "verse_number": "५-३-१९२-९०", "content_sanskrit": "वक्तव्यश्च सहस्राक्षो नास्माकं भोगकारणात् ।\nतपश्चर्या न वाप्राप्यफलं प्राप्तुमभीप्सता॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004498090, "chapter_id": 24498, "verse_number": "५-३-१९२-९१", "content_sanskrit": "सन्मार्गमस्य जगतो दर्शयिष्ये करोम्यहम् ।\nतथा नरेण सहितो जगतः पालनोद्यतः॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004498091, "chapter_id": 24498, "verse_number": "५-३-१९२-९२", "content_sanskrit": "यदि कश्चित्तवाबाधां करोति त्रिदशेश्वर ।\nतमहं वारयिष्यामि निवृत्तो भव वासव॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004498092, "chapter_id": 24498, "verse_number": "५-३-१९२-९३", "content_sanskrit": "कर्तासि चेत्त्वमाबाधां न दुष्टस्येह कस्यचित् ।\nतं चापि शास्ता तदहं प्रवर्तिष्याम्यसंशयम्॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004498093, "chapter_id": 24498, "verse_number": "५-३-१९२-९४", "content_sanskrit": "एतज्ज्ञात्वा न सन्तापस्त्वया कार्यो हि मां प्रति ।\nउपकाराय जगतामवतीर्णोऽस्मि वासव॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004498094, "chapter_id": 24498, "verse_number": "५-३-१९२-९५", "content_sanskrit": "या चेयमुर्वशी मत्तः समुद्भूता पुरंदर त्रेताग्निहेतुभूतेयं एवं प्राप्य भविष्यति॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}]