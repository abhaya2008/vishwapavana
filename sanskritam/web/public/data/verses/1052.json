[{"id": 2002437, "chapter_id": 1052, "verse_number": "१-५३-०x", "content_sanskrit": "शौनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2002438, "chapter_id": 1052, "verse_number": "१-५३-१", "content_sanskrit": "सर्पसत्रे तदा राज्ञः पाण्डवेयस्य धीमतः।\nजनमेजयस्य के त्वासन्नृत्विजः परमर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2002439, "chapter_id": 1052, "verse_number": "१-५३-२", "content_sanskrit": "के सदस्या बभूवुश्च सर्पसत्रे सुदारुणे।\nविषादजननेऽत्यर्थं पन्नगानां महाभय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2002440, "chapter_id": 1052, "verse_number": "१-५३-३", "content_sanskrit": "सर्वं विस्तरशस्तात भवाञ्छंसितुमर्हति।\nसर्पसत्रविधानज्ञविज्ञेयाः के च सूतज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2002441, "chapter_id": 1052, "verse_number": "१-५३-४x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2002442, "chapter_id": 1052, "verse_number": "१-५३-४", "content_sanskrit": "हन्त ते कथयिष्यामि नामानीह मनीषिणाम्।\nये ऋत्विजः सदस्याश्च तस्यासन्नृपतेस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2002443, "chapter_id": 1052, "verse_number": "१-५३-५", "content_sanskrit": "तत्र होता बभूवाथ ब्राह्मणश्चण्डभार्गवः।\nच्यवनस्यान्वये ख्यातो जातो वेदविदां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2002444, "chapter_id": 1052, "verse_number": "१-५३-६", "content_sanskrit": "उद्गाता ब्राह्मणो वृद्धो विद्वान्कौत्सौऽथ जैमिनिः।\nब्र्हमाऽभवच्छार्ङ्गरवोऽथाध्वर्युश्चापि पिङ्गलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2002445, "chapter_id": 1052, "verse_number": "१-५३-७", "content_sanskrit": "सदस्यश्चाभवद्व्यासः पुत्रशिष्यसहायवान्।\nउद्दालकः प्रमतकः श्वेतकेतुश्च पिङ्गलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2002446, "chapter_id": 1052, "verse_number": "१-५३-८", "content_sanskrit": "असितो देवलश्चैव नारदः पर्वतस्तथा।\nआत्रेयः कुम्डजठरौ द्विजः कालघटस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2002447, "chapter_id": 1052, "verse_number": "१-५३-९", "content_sanskrit": "वात्स्यः श्रुतश्रवा वृद्धो जपस्वाध्यायशीलवान्।\nकोहलो देवशर्मा च मौद्गल्यः समसौरभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2002448, "chapter_id": 1052, "verse_number": "१-५३-१०", "content_sanskrit": "एते चान्ये च बहवो ब्राह्मणा वेदपारगाः।\nसदस्याश्चाभवंस्तत्र सत्रे पारिक्षितस्य ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2002449, "chapter_id": 1052, "verse_number": "१-५३-११", "content_sanskrit": "जुह्वत्स्वृत्विक्ष्वथ तदा सर्पसत्रे महाक्रतौ।\nअहयः प्रापतंस्तत्र घोराः प्राणिभयावहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2002450, "chapter_id": 1052, "verse_number": "१-५३-१२", "content_sanskrit": "वसामेदोवहाः कुल्या नागानां संप्रवर्तिताः।\nववौ गन्धश्च तुमुलो दह्यतामनिशं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2002451, "chapter_id": 1052, "verse_number": "१-५३-१३", "content_sanskrit": "पततां चैव नागानां धिष्ठितानां तथाम्बरे।\nअश्रूयतानिशं शब्दः पच्यतां चाग्निना भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2002452, "chapter_id": 1052, "verse_number": "१-५३-१४", "content_sanskrit": "तक्षकस्तु स नागेन्द्रः पुरंदरनिवेशनम्।\nगतः श्रुत्वैव राजानं दीक्षितं जनमेजयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2002453, "chapter_id": 1052, "verse_number": "१-५३-१५", "content_sanskrit": "ततः सर्वं यथावृत्तमाख्याय भुजगोत्तमः।\nअगच्छच्छरणं भीत आगस्कृत्वा पुरंदरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2002454, "chapter_id": 1052, "verse_number": "१-५३-१६", "content_sanskrit": "तमिन्द्रः प्राह सुप्रीतो न तवास्तीह तक्षक।\nभयं नागेन्द्र तस्माद्वै सर्पसत्रात्कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2002455, "chapter_id": 1052, "verse_number": "१-५३-१७", "content_sanskrit": "प्रसादितो मया पूर्वं तवार्थाय पितामहः।\nतस्मात्तव भयं नास्ति व्येतु तेनसो ज्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2002456, "chapter_id": 1052, "verse_number": "१-५३-१८x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2002457, "chapter_id": 1052, "verse_number": "१-५३-१८", "content_sanskrit": "एवमाश्वासितस्तेन ततः स भुजगोत्तमः।\nउवास भवने तस्मिञ्शक्रस्य मुदितः सुखी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2002458, "chapter_id": 1052, "verse_number": "१-५३-१९", "content_sanskrit": "अजस्रं निपतत्स्वग्नौ नागेषु भृशदुःखितः।\nअल्पशेषपरीवारो वासुकिः पर्यतप्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2002459, "chapter_id": 1052, "verse_number": "१-५३-२०", "content_sanskrit": "कश्मलं चाविशद्धोरं वासुकिं पन्नगोत्तमम्।\nस घूर्णमानहृदयो भगिनीमिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2002460, "chapter_id": 1052, "verse_number": "१-५३-२१", "content_sanskrit": "दह्यन्तेऽङ्गानि मे भद्रे न दिशः प्रतिभान्ति माम्।\nसीदामीव च संमोहाद्धूर्णतीव च मे मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2002461, "chapter_id": 1052, "verse_number": "१-५३-२२", "content_sanskrit": "दृष्टिर्भ्राम्यति मेऽतीव हृदयं दीर्यतीव च।\nपतिष्याम्यवशोऽद्याहं तस्मिन्दीप्ते विभावसौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2002462, "chapter_id": 1052, "verse_number": "१-५३-२३", "content_sanskrit": "पारिक्षितस्य यज्ञोऽसौ वर्ततेऽस्मज्जिघांसया।\nव्यक्तं मयाऽभिगन्तव्यं प्रेतराजनिवेशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2002463, "chapter_id": 1052, "verse_number": "१-५३-२४", "content_sanskrit": "अयं स कालः संप्राप्तो यदर्थमसि मे स्वसः।\nजरत्करौ(पुरा)मयादत्तात्रायस्वास्मान्सबान्धवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2002464, "chapter_id": 1052, "verse_number": "१-५३-२५", "content_sanskrit": "आस्तीकः किल यज्ञं तं वर्तन्तं भुजगोत्तमे।\nप्रतिषेत्स्यति मां पूर्वं स्वयमाह पितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2002465, "chapter_id": 1052, "verse_number": "१-५३-२६", "content_sanskrit": "तद्वत्से ब्रूहि वत्सं स्वं कुमारं वृद्धसंमतम्।\nममाद्य त्वं सभृत्यस्य मोक्षार्थं वेदवित्तमम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2002466, "chapter_id": 1052, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि त्रिपञ्चाशत्तमोऽध्यायः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]