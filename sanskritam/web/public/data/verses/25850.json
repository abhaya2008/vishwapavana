[{"id": 7005850000, "chapter_id": 25850, "verse_number": "१-३३-१", "content_sanskrit": "रुद्र उवाच ।\nसुदर्शनस्य पूजां मे वद शङ्खगदाधर ।\nग्रहरोगादिकं सर्वं यत्कृत्वा नाशमेति वै ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005850001, "chapter_id": 25850, "verse_number": "१-३३-२", "content_sanskrit": "हरिरुवाच ।\nसुदर्शनस्य चक्रस्य श्रृणु पूजां वृषध्व।\nस्नानमादौ प्रकुर्वीत पूजयेच्च हरिं तत ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005850002, "chapter_id": 25850, "verse_number": "१-३३-३", "content_sanskrit": "मूलमन्त्रेण वै न्यासं मूलमन्त्रं श्रृणुष्व च।\nसहस्रारं हुं फट् नमो मन्त्रः प्रणवपूर्वकः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005850003, "chapter_id": 25850, "verse_number": "१-३३-४", "content_sanskrit": "कथितः सर्वदुष्टानां नाशको मन्त्रभेदकः ।\nध्यायेत्सुदर्शनं देवं हृदि पद्मेऽमले शुभे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005850004, "chapter_id": 25850, "verse_number": "१-३३-५", "content_sanskrit": "शङ्कचक्रगदापद्मधरं सौम्यं किरीटिनम् ।\nआवाह्य मण्डले देवं पूर्वोक्तविधिना हर ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005850005, "chapter_id": 25850, "verse_number": "१-३३-६", "content_sanskrit": "पूजयेद्रन्धपुष्पाद्यैरुपचारैर्महेश्वर ।\nपूजयित्वा जपेन्मन्त्रं शतमष्टोत्तरं नरः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005850006, "chapter_id": 25850, "verse_number": "१-३३-७", "content_sanskrit": "एवं यः कुरुते रुद्र ! चक्रस्यार्चनमुत्मम्।\nसर्वरोगविनिर्मुक्तो विष्णुलोकं समाप्नुयात् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005850007, "chapter_id": 25850, "verse_number": "१-३३-८", "content_sanskrit": "एतत्स्तोत्रं जपेत्पश्चात्सर्वव्याधिविनानम्।\nनमः सुदर्शनायैव सहस्रादित्यवर्चसे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005850008, "chapter_id": 25850, "verse_number": "१-३३-९", "content_sanskrit": "ज्वालामालाप्रदीप्ताय सहस्राराय चक्षुष।\nसर्वदुष्टविनाशाय सर्वपातकमर्दिने ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005850009, "chapter_id": 25850, "verse_number": "१-३३-१०", "content_sanskrit": "सुचक्राय विचक्राय सर्वमन्त्रविभेदिने ।\nप्रसवित्रे जगद्धात्रे जगद्विध्वंसिने नमः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005850010, "chapter_id": 25850, "verse_number": "१-३३-११", "content_sanskrit": "पालनार्थाय लोकानां दुष्टासुरविनाशिने ।\nउग्राय चैव सौम्याय चण्डाय च नमोनमः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005850011, "chapter_id": 25850, "verse_number": "१-३३-१२", "content_sanskrit": "नमश्चक्षुः स्वरूपाय संसारभयभेदिने ।\nमायापञ्जरभेत्रे च शिवाय च नमोनमः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005850012, "chapter_id": 25850, "verse_number": "१-३३-१३", "content_sanskrit": "ग्रहातिग्रहरूपाय ग्रहाणां पतेय नमः ।\nकालाय मृत्यवे चैव भीमाय च नमोनमः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005850013, "chapter_id": 25850, "verse_number": "१-३३-१४", "content_sanskrit": "भक्तानुग्रहदात्रे च भक्तगोप्त्रे नमोम।\nविष्णुरूपाय शान्ताय चायुधानां धराय च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005850014, "chapter_id": 25850, "verse_number": "१-३३-१५", "content_sanskrit": "विष्णुशस्त्राय चक्राय नमो भूयो नमोनमः ।\nइति स्तोत्रं महापुण्यं चक्रस्य तव कीर्त्तितम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005850015, "chapter_id": 25850, "verse_number": "१-३३-१६", "content_sanskrit": "यः पठेत्परया भक्त्या विष्णुलोकं स गच्छति ।\nचक्रपूजाविधिं यश्च पठेद्रुद्र जितेन्द्रियः ।\nस पापं भस्मसात्कृत्वा विष्णुलोकाय कल्पते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005850016, "chapter_id": 25850, "verse_number": "१-३३-१७", "content_sanskrit": "इति श्रीगारुडे महापुराणे पूर्वखण्डे प्रथमांशाख्ये आचारकाण्डे सुदर्शनपूजाविधिर्नाम त्रयस्त्रिंशोऽध्यायः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]