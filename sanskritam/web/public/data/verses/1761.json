[{"id": 2035174, "chapter_id": 1761, "verse_number": "५-६-०x", "content_sanskrit": "द्रुपद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2035175, "chapter_id": 1761, "verse_number": "५-६-१", "content_sanskrit": "भूतानां प्राणिनः श्रेष्ठाः प्राणिनां बुद्धिजीविनः।\nबुद्धिमत्सु नराः श्रेष्ठा नरेष्वपि द्विजातयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2035176, "chapter_id": 1761, "verse_number": "५-६-२", "content_sanskrit": "द्विजेषु वैद्याः श्रेयांसो वैद्येषु कृतबुद्धयः।\nकृतबुद्धिषु कर्तारः कर्तृषु ब्रह्मवादिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2035177, "chapter_id": 1761, "verse_number": "५-६-३", "content_sanskrit": "स भवान्कृबुद्धीनां प्रधान इति मे मतिः ।\nकुलेन च विशिष्टोऽसि वयसा च श्रुतेन च।\nप्रज्ञया सदृशश्चासि शुक्रेणाङ्गिरसेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2035178, "chapter_id": 1761, "verse_number": "५-६-४", "content_sanskrit": "विदितं चापि ते सर्वं यथावृत्तः स कौरवः ।\nपाण्डवश्च यथावृत्तः कुन्तीपुत्रो युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2035179, "chapter_id": 1761, "verse_number": "५-६-५", "content_sanskrit": "धृतराष्ट्रस्य विदिते वञ्चिताः पाण्डवाः परैः ।\nविदुरेणानुनीतोऽपि पुत्रमेवानुवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2035180, "chapter_id": 1761, "verse_number": "५-६-६", "content_sanskrit": "शकुनिर्बुद्धिपूर्वं हि कुन्तीपुत्रं समाह्वयत् ।\nअनक्षज्ञं मताक्षः सन्क्षत्रवृत्ते स्थितं शुचिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2035181, "chapter_id": 1761, "verse_number": "५-६-७", "content_sanskrit": "ते तथा वञ्चयित्वा तु धर्मराजं युधिष्ठिरम् ।\nन कस्यांचिदवस्थायां राज्यं दास्यन्ति वै स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2035182, "chapter_id": 1761, "verse_number": "५-६-८", "content_sanskrit": "भवांस्तु धर्मसंयुक्तं धृतराष्ट्रं ब्रुवन्वचः ।\nमनांसि तस्य योधानां ध्रुवमावर्तयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2035183, "chapter_id": 1761, "verse_number": "५-६-९", "content_sanskrit": "विदुरश्चापि तद्वाक्यं साधयिष्यति तावकम्।\nभीष्मद्रोणकृपादीनां भेदं संजनयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2035184, "chapter_id": 1761, "verse_number": "५-६-१०", "content_sanskrit": "अमात्येषु च भिन्नेषु योधेषु विमुखेषु च।\nपुनरेकत्र करणं तेषां कर्म भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2035185, "chapter_id": 1761, "verse_number": "५-६-११", "content_sanskrit": "एतस्मिन्नन्तरे पार्थाः सुखमेकाग्रबुद्धयः।\nसेनाकर्म करिष्यन्ति द्रव्याणां चैव सञ्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2035186, "chapter_id": 1761, "verse_number": "५-६-१२", "content_sanskrit": "भिद्यमानेषु च स्वेषु लम्बमाने तथा त्वयि।\nन तथा ते करिष्यन्ति सेनाकर्म न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2035187, "chapter_id": 1761, "verse_number": "५-६-१३", "content_sanskrit": "एतत्प्रयोजनं चात्र प्राधान्येनोपलभ्यते।\nसंगत्या धृतराष्ट्रश्च कुर्याद्धर्म्यं वचस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2035188, "chapter_id": 1761, "verse_number": "५-६-१४", "content_sanskrit": "स भवान्धर्मयुक्तश्च धर्म्यं तेषु समाचरन् ।\nकृपालुषु परिक्लेशान्पाण्डवीयान्प्रकीर्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2035189, "chapter_id": 1761, "verse_number": "५-६-१५", "content_sanskrit": "वृद्धेषु कुलधर्मं च ब्रुवन्पूर्वैरनुष्ठितम् ।\nविभेत्स्यति मनांस्येषमिति मे नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2035190, "chapter_id": 1761, "verse_number": "५-६-१६", "content_sanskrit": "न च तेभ्यो भयं तेऽस्ति ब्राह्मणो ह्यसि वेदवित् ।\nदूतकर्मणि युक्तश्च स्थविरश्च विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2035191, "chapter_id": 1761, "verse_number": "५-६-१७", "content_sanskrit": "स भवान्पुष्ययोगेन मुहूर्तेन जयेन च।\nकौरवेयान्प्रयात्वाशु कौन्तेयस्यार्थसिद्धये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2035192, "chapter_id": 1761, "verse_number": "५-६-१८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2035193, "chapter_id": 1761, "verse_number": "५-६-१८", "content_sanskrit": "तथाऽनुशिष्टः प्रययौ द्रुपदेन महात्मना।\nपुरोधा वृत्तसंपन्नो नगरं नागसाह्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2035194, "chapter_id": 1761, "verse_number": "५-६-१९", "content_sanskrit": "शिष्यैः परिवृतो विद्वान्नीतिशास्त्रार्थकोविदः ।\nपाण्डवानां हितार्थाय कौरवान्प्रतिजग्मिवान् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2035195, "chapter_id": 1761, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि सेनोद्योगपर्वणि षष्ठोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]