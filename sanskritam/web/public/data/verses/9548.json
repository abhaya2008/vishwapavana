[{"id": 5000548000, "chapter_id": 9548, "verse_number": "७-१३-१", "content_sanskrit": "अथ लोकेश्वरोत्सृष्टा तत्र कालेन केनचित् ।\nनिद्रा समभवत्तीव्रा कुम्भकर्णस्य रूपिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000548001, "chapter_id": 9548, "verse_number": "७-१३-२", "content_sanskrit": "ततो भ्रातरमासीनं कुम्भकर्णो ऽब्रवीद्वचः ।\nनिद्रा मां बाधते राजन्कारयस्व ममालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000548002, "chapter_id": 9548, "verse_number": "७-१३-३", "content_sanskrit": "विनियुक्तास्ततो राज्ञा शिल्पिनो विश्वकर्मवत् ।\nविस्तीर्णं योजनं शुभ्रं ततो द्विगुणमायतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000548003, "chapter_id": 9548, "verse_number": "७-१३-४", "content_sanskrit": "दर्शनीयं निराबाधं कुम्भकर्णस्य चक्रिरे ।\nस्फाटिकैः काञ्चनैश्चित्रैः स्तम्भैः सर्वत्र शोभितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000548004, "chapter_id": 9548, "verse_number": "७-१३-५", "content_sanskrit": "वैडूर्यकृतसोपानं किङ्किणीजालकं तथा ।\nदान्ततोरणविन्यस्तं वज्रस्फटिकवेदिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000548005, "chapter_id": 9548, "verse_number": "७-१३-६", "content_sanskrit": "मनोहरं सर्वसुखं कारयामास राक्षसः ।\nसर्वत्र सुखदं नित्यं मेरोः पुण्यां गुहामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000548006, "chapter_id": 9548, "verse_number": "७-१३-७", "content_sanskrit": "तत्र निद्रां समाविष्टः कुम्भकर्णो महाबलः ।\nबहून्यब्दसहस्राणि शयानो न प्रबुद्ध्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000548007, "chapter_id": 9548, "verse_number": "७-१३-८", "content_sanskrit": "निद्राभिभूते तु तदा कुम्भकर्णे दशाननः ।\nदेवर्षियक्षगन्धर्वान्सञ्जघ्ने हि निरङ्कुशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000548008, "chapter_id": 9548, "verse_number": "७-१३-९", "content_sanskrit": "उद्यानानि च चित्राणि नन्दनादीनि यानि च ।\nतानि गत्वा सुसङक्रुद्धो भिनत्ति स्म दशाननः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000548009, "chapter_id": 9548, "verse_number": "७-१३-१०", "content_sanskrit": "नदीं गज इव क्रीडन्वृक्षान्वायुरिव क्षिपन् ।\nनगान्व्रज्र इवोत्सृष्टो विध्वंसयति राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000548010, "chapter_id": 9548, "verse_number": "७-१३-११", "content_sanskrit": "तथावृत्तं तु विज्ञाय दशग्रीवं धनेश्वरः ।\nकुलानुरूपं धर्मज्ञो वृत्तं संस्मृत्य चात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000548011, "chapter_id": 9548, "verse_number": "७-१३-१२", "content_sanskrit": "सौभ्रात्रदर्शनार्थं तु दूतं वैश्रवणस्तदा ।\nलङ्कां सम्प्रेषयामास दशग्रीवस्य वै हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000548012, "chapter_id": 9548, "verse_number": "७-१३-१३", "content_sanskrit": "स गत्वा नगरीं लङ्कामाससाद विभीषणम् ।\nमानितस्तेन धर्मेण पृष्टश्चागमनं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000548013, "chapter_id": 9548, "verse_number": "७-१३-१४", "content_sanskrit": "पृष्ट्वा च कुशलं राज्ञो ज्ञातीनां च बिभीषणः ।\nसभायां दर्शयामास तमासीनं दशाननम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000548014, "chapter_id": 9548, "verse_number": "७-१३-१५", "content_sanskrit": "स दृष्ट्वा तत्र राजानं दीप्यमानं स्वतेजसा ।\nजयेति वाचा सम्पूज्य तूष्णीं समभिवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000548015, "chapter_id": 9548, "verse_number": "७-१३-१६", "content_sanskrit": "तं तत्रोत्तमपर्यङ्के वरास्तरणशोभिते ।\nउपविष्टं दशग्रीवं दूतो वाक्यमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000548016, "chapter_id": 9548, "verse_number": "७-१३-१७", "content_sanskrit": "राजन्वदामि ते सर्वं भ्राता तव यदब्रवीत् ।\nउभयोः सदृशं वीर वृत्तस्य च कुलस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000548017, "chapter_id": 9548, "verse_number": "७-१३-१८", "content_sanskrit": "साधु पर्याप्तमेतावत्कृतश्चारित्रसङ्ग्रहः ।\nसाधु धर्मे व्यवस्थानं क्रियतां यदि शक्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000548018, "chapter_id": 9548, "verse_number": "७-१३-१९", "content_sanskrit": "दृष्टं मे नन्दनं भग्नमृषयो निहताः श्रुताः ।\nदेवतानां समुद्योगस्त्वत्तो राजन्मम श्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000548019, "chapter_id": 9548, "verse_number": "७-१३-२०", "content_sanskrit": "निराकृतश्च बहुशस्त्वया ऽहं राक्षसाधिप ।\nअपराद्धा हि बाल्याच्च रमणीयाः स्वबान्धवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000548020, "chapter_id": 9548, "verse_number": "७-१३-२१", "content_sanskrit": "अहं तु हिमवत्पृष्ठं गतो धर्ममुपासितुम् ।\nरौद्रं व्रत्तं समास्थाय नियतो नियतेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000548021, "chapter_id": 9548, "verse_number": "७-१३-२२", "content_sanskrit": "तत्र देवो मया दृष्टः सह देव्या मया प्रभुः ।\nसव्यं चक्षुर्मया दैवात्तत्र देव्यां निपातितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000548022, "chapter_id": 9548, "verse_number": "७-१३-२३", "content_sanskrit": "का न्वियं स्यादिति शुभा न खल्वन्येन हेतुना ।\nरूपं ह्यनुपमं कृत्वा रुद्राणी तत्र तिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000548023, "chapter_id": 9548, "verse_number": "७-१३-२४", "content_sanskrit": "देव्या दिव्यप्रभावेण दग्धं सव्यं ममेक्षणम् ।\nरेणुध्वस्तमिव ज्योतिः पिङ्गुलत्वमुपागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000548024, "chapter_id": 9548, "verse_number": "७-१३-२५", "content_sanskrit": "ततो ऽहमन्यद्विस्तीर्णं गत्वा तस्य गिरेस्तटम् ।\nतूष्णीं वर्षशतान्यष्टौ समाधारं महाव्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000548025, "chapter_id": 9548, "verse_number": "७-१३-२६", "content_sanskrit": "समाप्ते नियमे तस्मिंस्तत्र देवो महेश्वरः ।\nप्रीतः प्रीतेन मनसा प्राह वाक्यमिदं प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000548026, "chapter_id": 9548, "verse_number": "७-१३-२७", "content_sanskrit": "पैङ्गल्यं यदवाप्तं हि देव्या रूपनिरीक्षणात् ।\nप्रीतो ऽस्मि तव धर्मज्ञ तपसा नेन सुव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000548027, "chapter_id": 9548, "verse_number": "७-१३-२८", "content_sanskrit": "मया चैतद्व्रतं चीर्णं त्वया चैव धनाधिप ।\nतृतीयः पुरुषो नास्ति यश्चरेव्रतमीदृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000548028, "chapter_id": 9548, "verse_number": "७-१३-२९", "content_sanskrit": "व्रतं सुनिश्चयं ह्येतन्मया ह्युत्पादितं पुरा ।\nतत्सखित्वं मया सौम्य रोचयस्व धनेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000548029, "chapter_id": 9548, "verse_number": "७-१३-३०", "content_sanskrit": "तपसा निर्जितश्चैव सखा भव ममानघ ।\nदेव्या दग्धं प्रभावेण यच्च सव्यं तवेक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000548030, "chapter_id": 9548, "verse_number": "७-१३-३१", "content_sanskrit": "एकाक्षिपिङ्गलेत्येव नाम स्थास्यति शाश्वतम् ।\nएवं तेन सखित्वं च प्राप्यानुज्ञां च शङ्करात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000548031, "chapter_id": 9548, "verse_number": "७-१३-३२", "content_sanskrit": "आगत्य च श्रुतो ऽयं मे तव पापविनिश्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000548032, "chapter_id": 9548, "verse_number": "७-१३-३३", "content_sanskrit": "तदधर्मिष्ठसंयोगान्निवर्त कुलदूषणात् ।\nचिन्त्यते हि वधोपायः सर्षिसङ्घैः सुरैस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000548033, "chapter_id": 9548, "verse_number": "७-१३-३४", "content_sanskrit": "एवमुक्तो दशग्रीवः क्रुद्धसंरक्तलोचनः ।\nहस्तौ दन्तांश्च सम्पीड्य वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000548034, "chapter_id": 9548, "verse_number": "७-१३-३५", "content_sanskrit": "विज्ञातं ते मया दूत वाक्यं यस्य प्रभाषसे ।\nनैतत्त्वमसि नैवासौ भ्रात्रा येनासि चोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000548035, "chapter_id": 9548, "verse_number": "७-१३-३६", "content_sanskrit": "हितं नैष ममैतद्धि ब्रवीति धनरक्षकः ।\nमहेश्वरसखित्वं तु मूढ श्रावयते किल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000548036, "chapter_id": 9548, "verse_number": "७-१३-३७", "content_sanskrit": "न चेदं क्षमणीयं मे यदेतद्भाषितं त्वया ।\nयदेतावन्मया कालं दूत तस्य तु मर्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000548037, "chapter_id": 9548, "verse_number": "७-१३-३८", "content_sanskrit": "न हन्तव्यो गुरुर्ज्येष्ठो मया ऽयमिति मन्यते ।\nतस्य त्विदानीं श्रुत्वा मे वाक्यमेषा कृता मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000548038, "chapter_id": 9548, "verse_number": "७-१३-३९", "content_sanskrit": "त्रीँल्लोकानपि जेष्यामि बाहुवीर्यमुपाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000548039, "chapter_id": 9548, "verse_number": "७-१३-४०", "content_sanskrit": "एतन्मुहूर्तमेवाहं तस्यैकस्य तु वै कृते ।\nचतुरो लोकपालांस्तान्नयिष्यामि यमक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000548040, "chapter_id": 9548, "verse_number": "७-१३-४१", "content_sanskrit": "एवमुक्त्वा तु लङ्केशो दूतं खड्गेन जघ्निवान् ।\nददौ भक्षयितुं ह्येनं राक्षसानां दुरात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000548041, "chapter_id": 9548, "verse_number": "७-१३-४२", "content_sanskrit": "एवं कृतस्वस्त्ययनो रथमारुह्य रावणः ।\nत्रैलोक्यविजयाकाङ्क्षी ययौ यत्र धनेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000548042, "chapter_id": 9548, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे त्रयोदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]