[{"id": 2027158, "chapter_id": 1582, "verse_number": "३-२२०-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2027159, "chapter_id": 1582, "verse_number": "३-२२०-१", "content_sanskrit": "श्रुत्वेमां धर्मसंयुक्तां धर्मराजः कथां शुभाम्।\nपुनः पप्रच्छ तमृषिं मार्कण्डेयमिदं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2027160, "chapter_id": 1582, "verse_number": "३-२२०-२", "content_sanskrit": "कथमग्निर्वनं यातः कथं चाप्यङ्गिराः पुरा।\nनष्टेऽग्नौ हव्यमहवदग्निर्भूत्वा महाद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2027161, "chapter_id": 1582, "verse_number": "३-२२०-३", "content_sanskrit": "अग्निर्यदा चैक एव बहुत्वं चास्य कर्मसु।\nदृश्यते भगवन्सर्वमेतदिच्छामि वेदितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2027162, "chapter_id": 1582, "verse_number": "३-२२०-४", "content_sanskrit": "कुमारश्च यथोत्पन्नो यथा चाग्नेः सुतोऽभवत्।\nयथा रुद्राच्च संभूतो गङ्गायां कृत्तिकासु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2027163, "chapter_id": 1582, "verse_number": "३-२२०-५", "content_sanskrit": "एतदिच्छाम्यहं त्वत्तः श्रोतुं भार्गवसत्तम।\nकौतूहलसमाविष्टो याथातथ्यं महामुने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2027164, "chapter_id": 1582, "verse_number": "३-२२०-६x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2027165, "chapter_id": 1582, "verse_number": "३-२२०-६", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nयथा क्रुद्धो हुतवहस्तपस्तप्तुं वनं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2027166, "chapter_id": 1582, "verse_number": "३-२२०-७", "content_sanskrit": "यथा च भगवानग्निः स्वयमेवाङ्गेराऽभवत्।\nसंतापयंश्च प्रभया नाशयंस्तिमिरावलिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2027167, "chapter_id": 1582, "verse_number": "३-२२०-८", "content_sanskrit": "पुराङ्गिरा महाबाहो चचार तप उत्तमम्।\nआश्रमस्थो महाभागो हव्यवाहं विशेषयन्।\nयथाग्निर्भूत्वा तु तदा जगत्सर्वं व्यकाशयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2027168, "chapter_id": 1582, "verse_number": "३-२२०-९", "content_sanskrit": "तपश्चरंस्तु हुतभुक्संतप्तस्तस्य तेजसा।\nभृशं ग्लानश्चतेजस्वी न च किंचित्प्रजज्ञिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2027169, "chapter_id": 1582, "verse_number": "३-२२०-१०", "content_sanskrit": "अथ संचिन्तयामास भगवान्हव्यवाहनः।\nअन्योऽग्निरिव लोकानां ब्रह्मणा संप्रकल्पितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2027170, "chapter_id": 1582, "verse_number": "३-२२०-११", "content_sanskrit": "अग्नित्वं विप्रनष्टं हि तप्यमानस् मे तपः।\nकथमग्निः पुनरहं भवेयमिति चिन्त्य सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2027171, "chapter_id": 1582, "verse_number": "३-२२०-१२", "content_sanskrit": "अपश्यदग्निवल्लोकांस्तापयन्तं महामुनिम्।\nसोपासर्पच्छनैर्भीतस्तमुवाच तदाङ्गिराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2027172, "chapter_id": 1582, "verse_number": "३-२२०-१३", "content_sanskrit": "शीघ्रमेव भवस्वाग्निस्त्वं पुनर्लोकभावनः।\nविज्ञातश्चासि लोकेषु त्रिषु संस्थानचारिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2027173, "chapter_id": 1582, "verse_number": "३-२२०-१४", "content_sanskrit": "त्वमग्ने प्रथमः सृष्टो ब्र्हमणा तिमिरापर्हः।\nस्वस्थानं प्रतिपद्यस्व शीघ्रमेव तमो नुद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2027174, "chapter_id": 1582, "verse_number": "३-२२०-१५x", "content_sanskrit": "अग्निरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2027175, "chapter_id": 1582, "verse_number": "३-२२०-१५", "content_sanskrit": "नष्टकीर्तिरहं लोके भवाञ्जातो हुताशनः।\nभवन्तमेव ज्ञास्यन्ति पावकं न तु मां जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2027176, "chapter_id": 1582, "verse_number": "३-२२०-१६", "content_sanskrit": "निक्षिपम्यहमग्नित्वं त्वमग्निः प्रथमो भव।\nभविष्यामि द्वितीयोऽहं प्राजापत्यक एव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2027177, "chapter_id": 1582, "verse_number": "३-२२०-१७x", "content_sanskrit": "अङ्गिरा उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2027178, "chapter_id": 1582, "verse_number": "३-२२०-१७", "content_sanskrit": "कुरु पुण्यं प्रजास्वर्ग्यं भवाग्निस्तिमिरापहः।\nमां च देव कुरुष्वाग्ने प्रथमं पुत्रमञ्जसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2027179, "chapter_id": 1582, "verse_number": "३-२२०-१८x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2027180, "chapter_id": 1582, "verse_number": "३-२२०-१८", "content_sanskrit": "तच्छ्रुत्वाङ्गिरसो वाक्यं जातवेदास्तथाऽकरोत्।\nराजन्वृहस्पतिर्नाम तस्याप्यङ्गिरसः सुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2027181, "chapter_id": 1582, "verse_number": "३-२२०-१९", "content_sanskrit": "ज्ञात्वा प्रथमजं तं तु वह्नेरङ्गिरसं सुतम्।\nउपेत्य देवाः पप्रच्छुः कारणं तत्र भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2027182, "chapter_id": 1582, "verse_number": "३-२२०-२०", "content_sanskrit": "स तु पृष्टस्तदा देवैस्तत कारणमब्रवीत्।\nप्रत्यगृह्णन्त देवाश्च तद्वचोऽङ्गिरसस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2027183, "chapter_id": 1582, "verse_number": "३-२२०-२१", "content_sanskrit": "तत्रनानाविधानग्नीन्प्रवक्ष्यामि महाप्रभान्।\nकर्मभिर्वहुभिः ख्याताननानार्थान्ब्राह्मणेष्विह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2027184, "chapter_id": 1582, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि विंशत्यधिकद्विशततमोऽध्यायः ॥ २२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]