[{"id": 2071860, "chapter_id": 2518, "verse_number": "१२-२३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2071861, "chapter_id": 2518, "verse_number": "१२-२३-१", "content_sanskrit": "एवमुक्तस्तु कौन्तेयो गुडाकेशेन भारत।\nनोवाच किंचित्कौरव्यस्ततो द्वैपायनोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2071862, "chapter_id": 2518, "verse_number": "१२-२३-२x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2071863, "chapter_id": 2518, "verse_number": "१२-२३-२", "content_sanskrit": "बीभत्सोर्वचनं सौम्य सत्यमेतद्युधिष्ठिर।\nशास्त्रदृष्टः परो धर्मः स्मृतो गार्हस्थ्य आश्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2071864, "chapter_id": 2518, "verse_number": "१२-२३-३", "content_sanskrit": "स्वधर्मं चर धर्मज्ञ यथाशास्त्रं यथाविधि।\nन हि गार्हस्थ्यमुत्सृज्य तवारण्यं विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2071865, "chapter_id": 2518, "verse_number": "१२-२३-४", "content_sanskrit": "गृहस्थं हि सदा देवाः पितरोऽतिथयस्तथा।\nभृत्याश्चैवोपजीवन्ति तान्भरस्व महीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2071866, "chapter_id": 2518, "verse_number": "१२-२३-५", "content_sanskrit": "वयांसि पशवश्चैव भूतानि च जनाधिप।\nगृहस्थैरेव धार्यन्ते तस्माच्छ्रेष्ठो गृहाश्रमी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2071867, "chapter_id": 2518, "verse_number": "१२-२३-६", "content_sanskrit": "सोऽयं चतुर्णामेतेषामाश्रमाणां दुराचरः।\nतं चराद्य विधिं पार्थ दुश्चरं दुर्बलेन्द्रियैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2071868, "chapter_id": 2518, "verse_number": "१२-२३-७", "content_sanskrit": "वेदज्ञानं च ते कृत्स्नं तपश्चाचरितं महत्।\nपितृपैतामहं राज्यं धुर्यवद्वोद्दुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2071869, "chapter_id": 2518, "verse_number": "१२-२३-८", "content_sanskrit": "तपो यज्ञस्तथा विद्या भैक्ष्यमिन्द्रियसंयमः।\nध्यानं विद्या समुत्थानं संतोषश्च श्रियं प्रति।\nतथा ह्येकान्तशीलत्वं तुष्टिर्दानं च शक्तितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2071870, "chapter_id": 2518, "verse_number": "१२-२३-९", "content_sanskrit": "ब्राह्मणानां महाराज चेष्टा संसिद्धिकारिका।\nक्षत्रियाणां तु वक्ष्यामि तवापि विदितं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2071871, "chapter_id": 2518, "verse_number": "१२-२३-१०", "content_sanskrit": "यज्ञो विद्या समुत्थानमसंतोषः श्रियं प्रति।\nदण्डधारणमुग्रत्वं प्रजानां परिपालनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2071872, "chapter_id": 2518, "verse_number": "१२-२३-११", "content_sanskrit": "वेदज्ञानं तथा कृत्स्नं तपः सुचरितं तथा।\nद्रविणोपार्जनं भूरि पात्रे च प्रतिपादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2071873, "chapter_id": 2518, "verse_number": "१२-२३-१२", "content_sanskrit": "एतानि राज्ञां कर्माणि सुकृतानि विशांपते।\nइमं लोकममुं चैव साधयन्तीति नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2071874, "chapter_id": 2518, "verse_number": "१२-२३-१३", "content_sanskrit": "एषां ज्यायस्तु कौन्तेय दण्डधारणमुच्यते।\nबलं हि क्षत्रिये नित्यं बले दण्डः समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2071875, "chapter_id": 2518, "verse_number": "१२-२३-१४", "content_sanskrit": "एताश्चेष्टाः क्षत्रियाणां राजन्संसिद्धिकारिकाः।\nअपि गाथामिमां चापि बृहस्पतिरगायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2071876, "chapter_id": 2518, "verse_number": "१२-२३-१५", "content_sanskrit": "भूमिरेतौ निगिरति सर्पो बिलशयानिव।\nराजानं चाविरोद्धारं ब्राह्मणं चाप्रवासिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2071877, "chapter_id": 2518, "verse_number": "१२-२३-१६", "content_sanskrit": "सुद्युम्नश्चापि राजर्षिः श्रूयते दण्डधारणात्।\nप्राप्तवान्परमां सिद्धिं दक्षः प्राचेतसो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2071878, "chapter_id": 2518, "verse_number": "१२-२३-१७x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2071879, "chapter_id": 2518, "verse_number": "१२-२३-१७", "content_sanskrit": "भगवन्कर्मणा केन सुद्युम्नो वसुधाधिपः।\nसंसिद्धिं परमां प्राप्तः श्रोतुमिच्छामि तं नृपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2071880, "chapter_id": 2518, "verse_number": "१२-२३-१८x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2071881, "chapter_id": 2518, "verse_number": "१२-२३-१८", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nशङ्खश्च लिखितश्चास्तां भ्रातरौ संशितव्रतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2071882, "chapter_id": 2518, "verse_number": "१२-२३-१९", "content_sanskrit": "तयोरावसथावास्तां रमणीयौ पृथक्पृथक्।\nनित्यपुष्पफलैर्वृक्षैरुपेतौ बाहुदामनु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2071883, "chapter_id": 2518, "verse_number": "१२-२३-२०", "content_sanskrit": "ततः कदाचिल्लिखितः शङ्खस्याश्रममागतः।\nयदृच्छयाऽथ शङ्खोपि निष्क्रान्तोऽभवदाश्रमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2071884, "chapter_id": 2518, "verse_number": "१२-२३-२१", "content_sanskrit": "सोऽभिगम्याश्रमं भ्रातुश्चंक्रमँल्लिखितस्तदा।\nफलानि शातयामास सम्यक्परिणतान्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2071885, "chapter_id": 2518, "verse_number": "१२-२३-२२", "content_sanskrit": "तान्युपादाय विस्रब्धो भक्षयामास स द्विजः।\nतस्मिंश्च भक्षयत्येव शङ्खोऽप्याश्रममागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2071886, "chapter_id": 2518, "verse_number": "१२-२३-२३", "content_sanskrit": "भक्षयन्तं तु तं दृष्ट्वा शङ्खो भ्रातरमब्रवीत्।\nकुतः फलान्यवाप्तानि हेतुना केन खादसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2071887, "chapter_id": 2518, "verse_number": "१२-२३-२४", "content_sanskrit": "सोऽब्रवीद्धातरं ज्येष्ठमुपसृत्याभिवाद्य च।\nइत एव गृहीतानि मयेति प्रहसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2071888, "chapter_id": 2518, "verse_number": "१२-२३-२५", "content_sanskrit": "तमब्रतीत्तथा शङ्खस्तीव्ररोषसमन्वितः।\nस्तेयं त्वया कृतमिदं फलान्याददता स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2071889, "chapter_id": 2518, "verse_number": "१२-२३-२६", "content_sanskrit": "गच्छ राजानमासाद्य स्वकर्म कथयस्व वै।\nअदत्तादानमेवं हि कृतं पार्थिवसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2071890, "chapter_id": 2518, "verse_number": "१२-२३-२७", "content_sanskrit": "स्तेनं मां त्वं विदित्वा च स्वधर्ममनुपालय।\nशीघ्रं धारय चोरस्य मम दण्डं नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2071891, "chapter_id": 2518, "verse_number": "१२-२३-२८", "content_sanskrit": "इत्युक्तस्तस्य वचनात्सुद्युम्न स नराधिपम्।\nअभ्यगच्छन्महाबाहो लिखितः संशितव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2071892, "chapter_id": 2518, "verse_number": "१२-२३-२९", "content_sanskrit": "सुद्युम्नस्त्वन्तपालेभ्यः श्रुत्वा लिखितमागतम्।\nअभ्यगच्छत्सहामात्यः पद्भ्यामेव जनेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2071893, "chapter_id": 2518, "verse_number": "१२-२३-३०", "content_sanskrit": "तमब्रवीत्समागम्य स राजा धर्मवित्तमम्।\nकिमागमनमाचक्ष्व भगवन्कृतमेव तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2071894, "chapter_id": 2518, "verse_number": "१२-२३-३१", "content_sanskrit": "एवमुक्तः स विप्रर्षिः सुद्युम्नमिदमब्रवीत्।\nप्रतिश्रुत्य करिष्येति श्रुत्वा तत्कर्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2071895, "chapter_id": 2518, "verse_number": "१२-२३-३२", "content_sanskrit": "अनिसृष्टानि गुरुणा फलानि मनुजर्षभ।\nभक्षितानि महाराज तत्र मां शाधि माचिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2071896, "chapter_id": 2518, "verse_number": "१२-२३-३३x", "content_sanskrit": "सुद्युम्न उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2071897, "chapter_id": 2518, "verse_number": "१२-२३-३३", "content_sanskrit": "प्रमाणं चेन्मतो राजा भवतो दण्डधारणे।\nअनुज्ञायामपि तथा हेतुः स्याद्ब्राह्मणर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2071898, "chapter_id": 2518, "verse_number": "१२-२३-३४", "content_sanskrit": "स भवानभ्यनुज्ञातः शुचिकर्मा महाव्रतः।\nब्रूहि कामानतोऽन्यांस्त्वं करिष्यामि हि ते वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2071899, "chapter_id": 2518, "verse_number": "१२-२३-३५x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2071900, "chapter_id": 2518, "verse_number": "१२-२३-३५", "content_sanskrit": "संछन्द्यमानो ब्रह्मर्षिः पार्थिवेन महात्मना।\nनान्यं स वरयामास तस्माद्दण्डादृते वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2071901, "chapter_id": 2518, "verse_number": "१२-२३-३६", "content_sanskrit": "ततः स पृथिवीपालो लिखितस्य महात्मनः।\nकरौ प्रच्छेदयामास धृतदण्डो जगाम सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2071902, "chapter_id": 2518, "verse_number": "१२-२३-३७", "content_sanskrit": "स गत्वा भ्रातरं शङ्खमार्तरूपोऽब्रवीदिदम्।\nधृतदण्डस्य दुर्बुद्धेर्भवांस्तत्क्षन्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2071903, "chapter_id": 2518, "verse_number": "१२-२३-३८x", "content_sanskrit": "शङ्ख उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2071904, "chapter_id": 2518, "verse_number": "१२-२३-३८", "content_sanskrit": "न कुप्ये तव धर्मज्ञ न त्वं दूषयसे मम।\n`सुनिर्मलं कुलं ब्रह्मन्नस्मिञ्जगति विश्रुतम्।\nधर्मस्तु ते व्यतिक्रान्तस्ततस्ते निष्कृतिः कृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2071905, "chapter_id": 2518, "verse_number": "१२-२३-३९", "content_sanskrit": "त्वं गत्वा बाहुदां शीघ्रं तर्पयस्व यथाविधि।\nदेवानृषीन्पितृंश्चैव मा चाधर्मे मनः कृथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2071906, "chapter_id": 2518, "verse_number": "१२-२३-४०", "content_sanskrit": "`ब्रह्महत्यां सुरापानं स्तेयं गुर्वङ्गनागमम्।\nमहान्ति पातकान्याहुः संयोगं चैव तैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2071907, "chapter_id": 2518, "verse_number": "१२-२३-४१", "content_sanskrit": "न स्तेयसदृशं ब्रह्मन्महापातकमस्ति हि।\nजगत्यस्मिन्महाभाग ब्रह्महत्यासमं हि तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2071908, "chapter_id": 2518, "verse_number": "१२-२३-४२", "content_sanskrit": "सर्वपातकिनां ब्रह्मन्दण्डः शारीर उच्यते।\nतस्करस्य विशेषेण नान्यो दण्डो विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2071909, "chapter_id": 2518, "verse_number": "१२-२३-४३", "content_sanskrit": "ब्राह्मणः क्षत्रियो वाऽपि वैश्यः शूद्रोऽथवा द्विज।\nसर्वे कामकृते पापे हन्तव्या न विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2071910, "chapter_id": 2518, "verse_number": "१२-२३-४४", "content_sanskrit": "राजभिर्धृतदण्डा वै कृत्वा पापानि मानवाः।\nनिर्मलाः स्वर्गमायान्ति सन्तः सुकृतिनो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2071911, "chapter_id": 2518, "verse_number": "१२-२३-४५", "content_sanskrit": "उद्धृतं नः कुलं ब्रह्मन्नाज्ञादण्डे धृते त्वयि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2071912, "chapter_id": 2518, "verse_number": "१२-२३-४६", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा शङ्खस्य लिखितस्तदा।\nअवगाह्यापगां पुण्यामुदकार्थं प्रचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2071913, "chapter_id": 2518, "verse_number": "१२-२३-४७", "content_sanskrit": "प्रादुरास्तां ततस्तस्य करौ जलजसन्निभौ।\nततः स विस्मितो भ्रातुर्दर्शयामास तौ करौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2071914, "chapter_id": 2518, "verse_number": "१२-२३-४८", "content_sanskrit": "ततस्तमब्रवीच्छङ्खस्तपसेदं कृतं मया।\nमा च तेऽव विशङ्का भूद्दैवमत्र विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2071915, "chapter_id": 2518, "verse_number": "१२-२३-४९x", "content_sanskrit": "लिखित उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2071916, "chapter_id": 2518, "verse_number": "१२-२३-४९", "content_sanskrit": "किंतु नाहं त्वया पूतः पूर्वमेव महाद्युते।\nयस्य ते तपसो वीर्यमीदृशं द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2071917, "chapter_id": 2518, "verse_number": "१२-२३-५०x", "content_sanskrit": "शङ्ख उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2071918, "chapter_id": 2518, "verse_number": "१२-२३-५०", "content_sanskrit": "एवमेतन्मया कार्यं नाहं दण्डधरस्तव।\nस च पूतो नरपतिस्त्वं चापि पितृभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2071919, "chapter_id": 2518, "verse_number": "१२-२३-५१x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2071920, "chapter_id": 2518, "verse_number": "१२-२३-५१", "content_sanskrit": "स राजा पाण्डवश्रेष्ठ श्रेयान्वै तेन कर्मणा।\nप्राप्तवान्परमां सिद्धिं दक्षः प्राचेतसो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2071921, "chapter_id": 2518, "verse_number": "१२-२३-५२", "content_sanskrit": "एष धर्मः क्षत्रियाणां प्रजानां परिपालनम्।\nउत्पथेभ्यो महाराज मा स्म शोके मनः कृथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2071922, "chapter_id": 2518, "verse_number": "१२-२३-५३", "content_sanskrit": "भ्रातुरस्य हितं वाक्यं शृणु धर्मज्ञसत्तम।\nदण्ड एव हि राजेन्द्र क्षत्रधर्मो न मुण्डनम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2071923, "chapter_id": 2518, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि त्रयोविंशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]