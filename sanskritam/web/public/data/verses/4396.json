[{"id": 2156604, "chapter_id": 4396, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2156605, "chapter_id": 4396, "verse_number": "१", "content_sanskrit": "तमप्रतिमसत्त्वौजोबलवीर्यपराक्रमम् ।\nहतं देवव्रतं श्रुत्वा पाञ्चाल्येन शिखण्डिना\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2156606, "chapter_id": 4396, "verse_number": "२", "content_sanskrit": "धृतराष्ट्रस्तदा राजा बाष्पव्याकुललोचनः ।\nकिमचेष्टत विप्रर्षे हते पितरि वीर्यवान् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2156607, "chapter_id": 4396, "verse_number": "३", "content_sanskrit": "यस्य पुत्रो हि भगवन् भीष्मद्रोणमुखै रथैः ।\nपराजित्य महेष्वासान् पाण्डवान् राज्यमिच्छति \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2156608, "chapter_id": 4396, "verse_number": "४", "content_sanskrit": "तस्मिन् हते तु भगवन् केतौ सर्वधनुष्मताम् ।\nयदचेष्टत कौरव्यः तन्मे ब्रूहि द्विजोत्तम \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2156609, "chapter_id": 4396, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2156610, "chapter_id": 4396, "verse_number": "५", "content_sanskrit": "श्रुत्वा भीष्मस्य निधनमप्रहृष्टमना भृशम् ।\nपुत्राणां जयमाकाङ्क्षन् विललाप सुदुःखितः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2156611, "chapter_id": 4396, "verse_number": "६", "content_sanskrit": "निहतं पितरं श्रुत्वा धृतराष्ट्रो जनाधिपः ।\nलेभे न शान्तिं कौरव्यश्चिन्ताशोकपरायणः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2156612, "chapter_id": 4396, "verse_number": "७", "content_sanskrit": "तस्य चिन्तयतो दुःखमनिशं कौरवस्य तत् ।\nआजगाम विशुद्धात्मा पुनर्गावल्गणिस्तदा \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2156613, "chapter_id": 4396, "verse_number": "८", "content_sanskrit": "व्यासप्रसादाद् विज्ञाय सर्ववृत्तान्तमुत्तमम् ।\nसैनिकानां च सर्वेषां सेनयोरुभयोरपि \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2156614, "chapter_id": 4396, "verse_number": "९", "content_sanskrit": "शिबिरात् सञ्जयं प्राप्तं निशि नागाह्वयं पुरम् ।\nआम्बिकेयो महाराज धृतराष्ट्रोऽन्वपृच्छत \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2156615, "chapter_id": 4396, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2156616, "chapter_id": 4396, "verse_number": "१०", "content_sanskrit": "सङ्काल्य तु महात्मानं भीष्मं भीमपराक्रमम् ।\nकिमचेष्टन् परं तात कुरवः कालचोदिताः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2156617, "chapter_id": 4396, "verse_number": "११", "content_sanskrit": "तस्मिंस्तु निहते वीरे भीष्मे युधि महौजसि ।\nकस्य स्म कुरवोऽस्मार्षुः निमग्नाः शोकसागरे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2156618, "chapter_id": 4396, "verse_number": "१२", "content_sanskrit": "तद् द्वितीयं महत् खण्डं त्रैलोक्यस्यापि भीषणम् ।\nभयमुत्पादयंस्तीव्रं बाधेन्नाम महद्बलम् ।\nभीष्मतः कौरवेयाणामपि यास्यति किन्नु तत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2156619, "chapter_id": 4396, "verse_number": "१३", "content_sanskrit": "देवव्रते तु निहते कुरूणामृषभे तदा ।\nकिमकुर्वन् नृपतयः तन्ममाचक्ष्व सञ्जय \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2156620, "chapter_id": 4396, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2156621, "chapter_id": 4396, "verse_number": "१४", "content_sanskrit": "शृणु राजन्नेकमना वचनं ब्रुवतो मम ।\nयत् ते पुत्रास्तदाऽकार्षुः हते देवव्रते मृधे \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2156622, "chapter_id": 4396, "verse_number": "१५", "content_sanskrit": "निहते तु तदा सङ्खे भीष्मे सत्यपराक्रमे ।\nतावकाः पाण्डवेयाश्च प्रवदन्तः पृथक्पृथक् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2156623, "chapter_id": 4396, "verse_number": "१६", "content_sanskrit": "विस्मिताश्च प्रहृष्टाश्च क्षत्रधर्मं विशाम्पते ।\nस्वधर्मं निन्दमानास्ते प्रणिपत्य महात्मने \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2156624, "chapter_id": 4396, "verse_number": "१७", "content_sanskrit": "शयनं कल्पयामासुः भीष्मायामिततेजसे ।\nसोपधानं नरव्याघ्र शरैः सन्नतपर्वभिः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2156625, "chapter_id": 4396, "verse_number": "१८", "content_sanskrit": "विधाय रक्षां भीष्माय प्रणिपत्य पितामहम् ।\nअनुमान्य च गाङ्गेयं कृत्वा चापि प्रदक्षिणम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2156626, "chapter_id": 4396, "verse_number": "१९", "content_sanskrit": "क्रोधसंरक्तनयनाः समवेत्य परस्परम् ।\nपुनर्युद्धाय सञ्जग्मुः क्षत्रियाः कालचोदिताः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2156627, "chapter_id": 4396, "verse_number": "२०", "content_sanskrit": "ततस्तूर्यनिनादैश्च भेरीणां च महास्वनैः ।\nतावकानामनीकानि परेषां चापि निर्ययुः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2156628, "chapter_id": 4396, "verse_number": "२१", "content_sanskrit": "तस्मिन्नहनि राजेन्द्र पतिते शन्तनोः सुते ।\nअमर्षवशमापन्नाः कालोपहतचेतसः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2156629, "chapter_id": 4396, "verse_number": "२२", "content_sanskrit": "अनादृत्य वचः पथ्यं गाङ्गेयस्य महात्मनः ।\nनिर्ययुः भरतश्रेष्ठाः शस्त्राण्यादाय सर्वशः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2156630, "chapter_id": 4396, "verse_number": "२३", "content_sanskrit": "मोहात् तव च पुत्रस्य वधाच्छान्तनवस्य च ।\nकौरवा मृत्युनाऽऽज्ञप्ताः सहिताः सर्वराजभिः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2156631, "chapter_id": 4396, "verse_number": "२४", "content_sanskrit": "अजावय इवागोपा वने श्वापदसङ्कुले ।\nकर्ण कर्णेति चाक्रुश्य शेषा भारत तावकाः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2156632, "chapter_id": 4396, "verse_number": "२५", "content_sanskrit": "भृशमुद्विग्नमनसो हीना देवव्रतेन ते\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2156633, "chapter_id": 4396, "verse_number": "२६", "content_sanskrit": "पतिते भरतश्रेष्ठे बभूव कुरुवाहिनी ।\nद्यौरिवापेतनक्षत्रा हीनं खमिव भानुना\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2156634, "chapter_id": 4396, "verse_number": "२७", "content_sanskrit": "विपन्नसस्येव मही वाक् चैवासंस्कृता यथा ।\nआसुरीव यथा सेना निगृहीते नृपे बलौ\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2156635, "chapter_id": 4396, "verse_number": "२८", "content_sanskrit": "विधवा तु यथा नारी शुष्कतोयेव निम्नगा ।\nवृकैरिव वने रुद्धा पृषती हतयूथपा\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2156636, "chapter_id": 4396, "verse_number": "२९", "content_sanskrit": "यथा सिंहे विनिष्क्रान्ते पर्वतस्येव कन्दरा\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2156637, "chapter_id": 4396, "verse_number": "३१", "content_sanskrit": "सा सेना भरतश्रेष्ठे पतिते जाह्नवीसुते ।\nशरभाहतसिंहेव महती गिरिकन्दरा\t॥३०॥\nविष्वग् वाताहता क्षुब्धा नौरिवासीन्महार्णवे\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2156638, "chapter_id": 4396, "verse_number": "३३", "content_sanskrit": "बलिभिः पाण्डवैर्दृप्तैः लब्धलक्षैर्भृशार्दिता ।\nसा तथा निहता सेना व्याकुलाश्वरथद्विपा \t॥३२॥\nविषण्णभूयिष्ठनरा कृपणा द्रष्टुराबभौ\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2156639, "chapter_id": 4396, "verse_number": "३४", "content_sanskrit": "तस्यां दृप्ता नृपतयः सैनिकाश्च पृथग्विधाः ।\nपाताळ इव मज्जन्तो हीना देवव्रतेन ते\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2156640, "chapter_id": 4396, "verse_number": "३५", "content_sanskrit": "कर्णं हि कुरवोऽस्मार्षुः स हि देवव्रतोपमः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2156641, "chapter_id": 4396, "verse_number": "३६", "content_sanskrit": "सर्वशस्त्रभृतां श्रेष्ठं रोचमानमिवानलम् ।\nबन्धुमापद्गतस्येव तेषामासीद् गतं मनः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2156642, "chapter_id": 4396, "verse_number": "३७", "content_sanskrit": "चुक्रुशुः कर्ण कर्णेति शेषा भारत पार्थिवाः ।\nराधेयो हि हितोऽस्माकं सूतपुत्रस्तनुत्यजः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2156643, "chapter_id": 4396, "verse_number": "३८", "content_sanskrit": "स हि नायुद्ध्यत तदा दशाहान्येक एव च ।\nसामात्यबान्धवः कर्णः समानयत माचिरम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2156644, "chapter_id": 4396, "verse_number": "३९", "content_sanskrit": "भीष्मेण हि महाबाहुः सर्वक्षत्रस्य पश्यतः ।\nरथेषु गण्यमानेषु बलविक्रमशालिषु\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2156645, "chapter_id": 4396, "verse_number": "४०", "content_sanskrit": "सङ्ख्यातोऽर्धरथः कर्णो दोषानुक्त्वा महारथः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2156646, "chapter_id": 4396, "verse_number": "४१", "content_sanskrit": "रथातिरथसङ्ख्यायां योऽग्रणीः शूर उत्तमः ।\nपितृवित्ताम्बुदेवेशानपि योद्धुं समुत्सहेत्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2156647, "chapter_id": 4396, "verse_number": "४२", "content_sanskrit": "स च तेनैव कोपेन राजन् गाङ्गेयमुक्तवान् ।\nत्वयि युद्ध्यति कौरव्य नाहं योत्स्ये कथञ्चन\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2156648, "chapter_id": 4396, "verse_number": "४३", "content_sanskrit": "त्वया तु पाण्डवेयेषु निहतेषु महामृधे ।\nदुर्योधनमनुज्ञाप्य वनं यास्यामि कौरव\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2156649, "chapter_id": 4396, "verse_number": "४४", "content_sanskrit": "हते वा युधि पार्थैस्तु त्वयि स्वर्गं समेयुषि ।\nहन्तास्म्येकरथेनैव कृत्स्नान् यान् मन्यसे रथान्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2156650, "chapter_id": 4396, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2156651, "chapter_id": 4396, "verse_number": "४५", "content_sanskrit": "एवमुक्त्वा महातेजा दशाहान्येक एव सः ।\nनायुद्ध्यत तदा कर्णः पुत्रस्य तव सम्मते\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2156652, "chapter_id": 4396, "verse_number": "४६", "content_sanskrit": "भीष्मस्त्वमितविक्रान्तः पाण्डवेयस्य पार्थिव ।\nजघान समरे योधान् असङ्ख्येयपराक्रमान्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2156653, "chapter_id": 4396, "verse_number": "४७", "content_sanskrit": "तस्मिंस्तु निहते शूरे तव पुत्रा महारथम् ।\nकर्णं राजंस्तदा जग्मुः तर्तुकामा इव प्लवम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2156654, "chapter_id": 4396, "verse_number": "४८", "content_sanskrit": "तावकास्तव पुत्राश्च सहिताः सर्वराजभिः ।\nहा कर्ण इति चक्रन्दुः कालोऽयमिति चाब्रुवन्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2156655, "chapter_id": 4396, "verse_number": "४९", "content_sanskrit": "जामदग्न्याभ्यनुज्ञातम् अस्त्रैर्दुर्वारपौरुषम् ।\nअगमन् मनसा कर्णं मन्युनाभ्यधिकेष्विह\t॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2156656, "chapter_id": 4396, "verse_number": "५०", "content_sanskrit": "स हि शक्तो रणे राजंस्त्रातुमस्मान्महाभयात् ।\nत्रिदशानिव गोविन्दः सततं स्मासुराद् भयात्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2156657, "chapter_id": 4396, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2156658, "chapter_id": 4396, "verse_number": "५१", "content_sanskrit": "तथा तु सञ्जये कर्णं कीर्तयाने पुनःपुनः ।\nअशीतमिव निःश्वस्य धृतराष्ट्रोऽब्रवीदिदम् \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2156659, "chapter_id": 4396, "verse_number": "५२", "content_sanskrit": "यत् तद् वैकर्तनं कर्णमगमद्वो मनस्तदा ।\nअप्यरक्षत् स राधेयः सूतपुत्रस्तनुत्यजः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2156660, "chapter_id": 4396, "verse_number": "५३", "content_sanskrit": "अपि तन्न मृषा कर्णो युधि सत्यपराक्रमः ।\nसम्भ्रान्तानां तदार्तानां त्रस्तानां त्राणमिच्छताम्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2156661, "chapter_id": 4396, "verse_number": "५४", "content_sanskrit": "अपि तत् पूरयाञ्चक्रे धनुर्धरवरो युधि ।\nयत् तद् विनिहते भीष्मे कौरवाणां महाव्रते\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2156662, "chapter_id": 4396, "verse_number": "५५", "content_sanskrit": "तत् खण्डं पूरयन् कर्णः परेषामादधद् भयम् ।\nकृतवान् मम पुत्राणां जयाशां सफलामपि\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2156663, "chapter_id": 4396, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसाहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि प्रथमोऽध्यायः ॥१॥\nद्रोणाभिषेकपर्वणि प्रथमोऽध्यायः ॥१॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]