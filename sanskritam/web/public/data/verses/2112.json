[{"id": 2050750, "chapter_id": 2112, "verse_number": "७-३९-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2050751, "chapter_id": 2112, "verse_number": "७-३९-१", "content_sanskrit": "द्वैधीभवति मे चित्तं शुचा तुष्ट्या च सञ्जय।\nमम पुत्रस्य यत्नैन्यं सौभद्रः समवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2050752, "chapter_id": 2112, "verse_number": "७-३९-२", "content_sanskrit": "विस्तरेणैव मे शंस सर्वं गावल्गणे पुनः।\nविक्रीडितं कुमारस्य स्कन्दस्येवासुरैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2050753, "chapter_id": 2112, "verse_number": "७-३९-३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2050754, "chapter_id": 2112, "verse_number": "७-३९-३", "content_sanskrit": "हन्त ते सम्प्रवक्ष्यामि विमर्दमतिदारुणम्।\nएकस्य च बहूनां च यथासीत्तुमुलो रणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2050755, "chapter_id": 2112, "verse_number": "७-३९-४", "content_sanskrit": "अभिमन्युः कृतोत्साहः कृतोत्साहानरिन्दमान्।\nरथस्थो रथिनः सर्वांस्तावकानभ्यवर्षयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2050756, "chapter_id": 2112, "verse_number": "७-३९-५", "content_sanskrit": "द्रोणं कर्णं कृपं शल्यं द्रौणिं भोजं बृहद्बलम्॥\nदुर्योधनं सौमदत्तिं शकुनिं च महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2050757, "chapter_id": 2112, "verse_number": "७-३९-६", "content_sanskrit": "नानानृपान्नृपसुतान्सैन्यानि विविधानि च।\nअलातचक्रवत्सर्वांश्चरन्बाणैः समार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2050758, "chapter_id": 2112, "verse_number": "७-३९-७", "content_sanskrit": "निघ्नन्नमित्रान्सौभद्रः परमास्त्रैः प्रतापवान्।\nअदर्शयत तेजस्वी दिक्षु सर्वासु भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2050759, "chapter_id": 2112, "verse_number": "७-३९-८", "content_sanskrit": "तद्दृष्ट्वा चरितं तस्य सौभद्रस्यामितौजसः।\nसमकम्पन्त सैन्यानि त्वदीयानि सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2050760, "chapter_id": 2112, "verse_number": "७-३९-९", "content_sanskrit": "अथाब्रवीन्महाप्राज्ञो भारद्वाजः प्रतापवान्।\nहर्षेणोत्फुल्लनयनः कृपमाभाष्य सत्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2050761, "chapter_id": 2112, "verse_number": "७-३९-१०", "content_sanskrit": "घटयन्निव मर्माणि पुत्रस्य तव भारत।\nअभिमन्युं रणे दृष्ट्वा तदा रणविशारदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2050762, "chapter_id": 2112, "verse_number": "७-३९-११x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2050763, "chapter_id": 2112, "verse_number": "७-३९-११", "content_sanskrit": "एष गच्छति सौभद्रः पार्थानां प्रथितो युवा।\nनन्दयन्सुहृदः सर्वान्राजानं च युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2050764, "chapter_id": 2112, "verse_number": "७-३९-१२", "content_sanskrit": "नकुलं सहदेवं च भीमसेनं च पाण्डवम्।\nबन्धून्सम्बन्धिनश्चान्यान्मध्यस्थान्सुहृदस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2050765, "chapter_id": 2112, "verse_number": "७-३९-१३", "content_sanskrit": "नास्य युद्धे समं मन्ये कञ्चिदन्यं धनुर्धरम्।\nइच्छन्हन्यादिमां सेनां किमर्थमपि नेच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2050766, "chapter_id": 2112, "verse_number": "७-३९-१४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2050767, "chapter_id": 2112, "verse_number": "७-३९-१४", "content_sanskrit": "द्रोणस्य प्रीतिसंयुक्तं श्रुत्वा वाक्यं तवात्मजः।\nआर्जुनिं प्रति सङ्क्रुद्धो द्रोणं दृष्ट्वा स्मयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2050768, "chapter_id": 2112, "verse_number": "७-३९-१५", "content_sanskrit": "अथ दुर्योधनः कर्णमब्रवीद्बाह्लिकं नृपः।\nदुःशासनं मद्रराजं तांस्तथाऽन्यान्महारथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2050769, "chapter_id": 2112, "verse_number": "७-३९-१६", "content_sanskrit": "सर्वभूर्धाभिषिक्तानामाचार्यो ब्रह्मवित्तमः।\nअर्जुनस्य सुतं मूढं नायं हन्तुमिहेच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2050770, "chapter_id": 2112, "verse_number": "७-३९-१७", "content_sanskrit": "न ह्यस्य समरे युद्ध्येदन्तकोऽप्याततायिनः।\nकिमङ्ग पुनरेवान्यो मर्त्यः सत्यं ब्रवीमि वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2050771, "chapter_id": 2112, "verse_number": "७-३९-१८", "content_sanskrit": "अर्जुनस्य सुतं त्वेष शिष्यत्वादभिरक्षति।\nशिष्याः पुत्राश्च दयितास्तदपत्यं च धर्मिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2050772, "chapter_id": 2112, "verse_number": "७-३९-१९", "content_sanskrit": "संरक्ष्यमाणो द्रोणेन मन्यते वीर्यमात्मनः।\nआत्मसम्भावितो मूढस्तं प्रमथ्नीत माचिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2050773, "chapter_id": 2112, "verse_number": "७-३९-२०", "content_sanskrit": "एवमुक्तास्तु ते राज्ञा सात्वतीपुत्रमभ्ययुः।\nसंरब्धास्ते जिघांसन्तो भारद्वाजस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2050774, "chapter_id": 2112, "verse_number": "७-३९-२१", "content_sanskrit": "दुःशासनस्तु तच्छ्रुत्वा दुर्योधनवचस्तदा।\nअब्रवीत्कुरुशार्दूल दुर्योधनमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2050775, "chapter_id": 2112, "verse_number": "७-३९-२२", "content_sanskrit": "अहमेनं हनिष्यामि महाराज ब्रवीमि ते।\nमिषतां पाण्डु पुत्राणां पाञ्चालानां च पश्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2050776, "chapter_id": 2112, "verse_number": "७-३९-२३", "content_sanskrit": "ग्रसिष्याम्यद्य सौभद्रं यथा राहुर्दिवाकरम्।\nउत्क्रुश्य चाब्रवीद्वाक्यं कुरुराजमिदं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2050777, "chapter_id": 2112, "verse_number": "७-३९-२४", "content_sanskrit": "श्रुत्वा कृष्णौ मया ग्रस्तं सौभद्रमतिमानिनौ।\nगमिष्यतः प्रेतलोकं जीवलोकान्न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2050778, "chapter_id": 2112, "verse_number": "७-३९-२५", "content_sanskrit": "तौ च श्रुत्वा मृतौ व्यक्तं पाण्डोः क्षेत्रोद्भवाः सुताः।\nएकाह्वा ससुहृद्वर्गाः क्लैब्याद्धास्यन्ति जीवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2050779, "chapter_id": 2112, "verse_number": "७-३९-२६", "content_sanskrit": "तस्मादस्मिन्हते शत्रौ हताः सर्वेऽहितास्तव।\nशिवेन मां ध्याहि राजन्नेष हन्मि रिपूंस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2050780, "chapter_id": 2112, "verse_number": "७-३९-२७x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2050781, "chapter_id": 2112, "verse_number": "७-३९-२७", "content_sanskrit": "एवमुक्त्वाऽनदद्राजन्पुत्रो दुःशासनस्तव।\nसौभद्रमभ्ययात्क्रुद्धः शरवर्षैरवाकिरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2050782, "chapter_id": 2112, "verse_number": "७-३९-२८", "content_sanskrit": "तमतिक्रुद्धमायान्तं तव पुत्रमरिंदमः।\nअभिमन्युः शरैस्तीक्ष्णैः षड्विंशत्या समार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2050783, "chapter_id": 2112, "verse_number": "७-३९-२९", "content_sanskrit": "दुःशासनस्तु सङ्क्रुद्धः प्रभिन्न इव कुञ्जरः।\nअयोधयत सौभद्रमभिमन्युश्च तं रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2050784, "chapter_id": 2112, "verse_number": "७-३९-३०", "content_sanskrit": "तौ मण्डलानि चित्राणि रथाभ्यां सव्यदक्षिणम्।\nचरमाणावयुध्येतां रथशिक्षाविशारदौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2050785, "chapter_id": 2112, "verse_number": "७-३९-३१", "content_sanskrit": "अथ पणवमृदङ्गदुन्दुभीनां\nक्रकचमहानकभेरिझर्झराणम्।\nनिनदमतिभृशं नराः प्रचक्रु--\nर्लवणजलोद्भवसिंहनादमिश्रम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2050786, "chapter_id": 2112, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि अभिमन्युवधपर्वणि त्रयोदशदिवसयुद्धे एकोनचत्वारिंशोऽध्यायः॥ ३९ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-३९-१७ अङ्गेत्यसूयायाम्॥ ५-३९-१८ धर्मिणामिति सोल्लुण्ठम्॥ ५-३९-१९ आत्मसंभावितः अहमेवेति सम्भावनामारूढः॥ ५-३९-३१ लवणजलोद्भवः शङ्खः॥ ५-३९-३९ एकोनचत्वारिंशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]