  {
    "id": 16779019,
    "chapter_id": 6179,
    "verse_number": "3.19",
    "content_sanskrit": "त एतदेव रूपमभिसंविशन्त्येतस्माद्रूपादुद्यन्ति ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "base_unit_id": "Ch_C03_S06_V02"
