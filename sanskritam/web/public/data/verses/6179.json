  },
  {
    "id": 16779017,
    "chapter_id": 6179,
    "verse_number": "3.17",
    "content_sanskrit": "ते वा एते रसानाꣳ रसा वेदा हि रसास्तेषामेते रसास्तानि वा एतान्यमृतानाममृतानि वेदा ह्यमृतास्तेषामेतान्यमृतानि ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "base_unit_id": "Ch_C03_S05_V04"
  },
  {
    "id": 16779018,
    "chapter_id": 6179,
    "verse_number": "3.18",
    "content_sanskrit": "तद्यत्प्रथमममृतं तद्वसव उपजीवन्त्यग्निना मुखेन न वै देवा अश्नन्ति न पिबन्त्येतदेवामृतं दृष्ट्वा तृप्यन्ति ॥ १ ॥",
