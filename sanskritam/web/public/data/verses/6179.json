[
  {
    "id": 16779001,
    "chapter_id": 6179,
    "verse_number": "3.1",
    "content_sanskrit": "असौ वा आदित्यो देवमधु तस्य द्यौरेव तिरश्चीनवꣳशोऽन्तरिक्षमपूपो मरीचयः पुत्राः ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "base_unit_id": "Ch_C03_S01_V01"
  },
  {
    "id": 16779002,
    "chapter_id": 6179,
    "verse_number": "3.2",
    "content_sanskrit": "तस्य ये प्राञ्चो रश्मयस्ता एवास्य प्राच्यो मधुनाड्यः । ऋच एव मधुकृत ऋग्वेद एव पुष्पं ता अमृता आपस्ता वा एता ऋचः ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "base_unit_id": "Ch_C03_S01_V02"
  },
  {
    "id": 16779003,
    "chapter_id": 6179,
    "verse_number": "3.3",
    "content_sanskrit": "एतमृग्वेदमभ्यतपꣳस्तस्याभितप्तस्य यशस्तेज इन्द्रियं वीर्यमन्नाद्यं रसोऽजायत ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "base_unit_id": "Ch_C03_S01_V03"
  },
  {
    "id": 16779004,
    "chapter_id": 6179,
    "verse_number": "3.4",
    "content_sanskrit": "तद्व्यक्षरत्तदादित्यमभितोऽश्रयत्तद्वा एतद्यदेतदादित्यस्य रोहितꣳ रूपम् ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "base_unit_id": "Ch_C03_S01_V04"
  },
  {
    "id": 16779005,
    "chapter_id": 6179,
    "verse_number": "3.5",
    "content_sanskrit": "अथ येऽस्य दक्षिणा रश्मयस्ता एवास्य दक्षिणा मधुनाड्यो यजूꣳष्येव मधुकृतो यजुर्वेद एव पुष्पं ता अमृता आपः ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "base_unit_id": "Ch_C03_S02_V01"
  },
  {
    "id": 16779006,
    "chapter_id": 6179,
    "verse_number": "3.6",
    "content_sanskrit": "तानि वा एतानि यजूꣳष्येतं यजुर्वेदमभ्यतपꣳस्तस्याभितप्तस्य यशस्तेज इन्द्रियं वीर्यमन्नाद्यꣳ रसोऽजायत ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "base_unit_id": "Ch_C03_S02_V02"
  },
  {
    "id": 16779007,
    "chapter_id": 6179,
    "verse_number": "3.7",
    "content_sanskrit": "तद्व्यक्षरत्तदादित्यमभितोऽश्रयत्तद्वा एतद्यदेतदादित्यस्य शुक्लꣳ रूपम् ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "base_unit_id": "Ch_C03_S02_V03"
  },
  {
    "id": 16779008,
    "chapter_id": 6179,
    "verse_number": "3.8",
    "content_sanskrit": "अथ येऽस्य प्रत्यञ्चो रश्मयस्ता एवास्य प्रतीच्यो मधुनाड्यः सामान्येव मधुकृतः सामवेद एव पुष्पं ता अमृता आपः ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "base_unit_id": "Ch_C03_S03_V01"
  },
  {
    "id": 16779009,
    "chapter_id": 6179,
    "verse_number": "3.9",
    "content_sanskrit": "तानि वा एतानि सामान्येतं सामवेदमभ्यतपंस्तस्याभितप्तस्य यशस्तेज इन्द्रियं वीर्यमन्नाद्यꣳ रसोऽजायत ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
