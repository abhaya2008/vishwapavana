  {
    "id": 16779034,
    "chapter_id": 6179,
    "verse_number": "3.34",
    "content_sanskrit": "अथ यत्पञ्चमममृतं तत्साध्या उपजीवन्ति ब्रह्मणा मुखेन न वै देवा अश्नन्ति न पिबन्त्येतदेवामृतं दृष्ट्वा तृप्यन्ति ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "base_unit_id": "Ch_C03_S10_V01"
  },
  {
    "id": 16779035,
    "chapter_id": 6179,
    "verse_number": "3.35",
    "content_sanskrit": "त एतदेव रूपमभिसंविशन्त्येतस्माद्रूपादुद्यन्ति ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "base_unit_id": "Ch_C03_S10_V02"
  },
  {
    "id": 16779036,
    "chapter_id": 6179,
    "verse_number": "3.36",
    "content_sanskrit": "स य एतदेवममृतं वेद साध्यानामेवैको भूत्वा ब्रह्मणैव मुखेनैतदेवामृतं दृष्ट्वा तृप्यति स एतदेव रूपमभिसंविशत्येतस्माद्रूपादुदेति ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "base_unit_id": "Ch_C03_S10_V03"
  },
  {
    "id": 16779037,
    "chapter_id": 6179,
    "verse_number": "3.37",
    "content_sanskrit": "स यावदादित्य उत्तरत उदेता दक्षिणतोऽस्तमेता द्विस्तावदूर्ध्व उदेतार्वागस्तमेता साध्यानामेव तावदाधिपत्यं स्वाराज्यꣳ पर्येता ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "base_unit_id": "Ch_C03_S10_V04"
  },
  {
    "id": 16779038,
    "chapter_id": 6179,
    "verse_number": "3.38",
    "content_sanskrit": "अथ तत ऊर्ध्व उदेत्य नैवोदेता नास्तमेतैकल एव मध्ये स्थाता तदेष श्लोकः ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "base_unit_id": "Ch_C03_S11_V01"
  },
  {
    "id": 16779039,
    "chapter_id": 6179,
    "verse_number": "3.39",
    "content_sanskrit": "न वै तत्र न निंलोच नोदियाय कदाचन । देवास्तेनाहꣳ सत्येन मा विराधिषि ब्रह्मणेति ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "base_unit_id": "Ch_C03_S11_V02"
  },
  {
    "id": 16779040,
    "chapter_id": 6179,
    "verse_number": "3.40",
    "content_sanskrit": "न ह वा अस्मा उदेति न निंलोचति सकृद्दिवा हैवास्मै भवति य एतामेवं ब्रह्मोपनिषदं वेद ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "base_unit_id": "Ch_C03_S11_V03"
  },
  {
    "id": 16779041,
    "chapter_id": 6179,
    "verse_number": "3.41",
    "content_sanskrit": "तद्धैतद्ब्रह्मा प्रजापतय उवाच प्रजापतिर्मनवे मनुः प्रजाभ्यस्तद्धैतदुद्दालकायारुणये ज्येष्ठाय पुत्राय पिता ब्रह्म प्रोवाच ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "base_unit_id": "Ch_C03_S11_V04"
  },
  {
    "id": 16779042,
    "chapter_id": 6179,
    "verse_number": "3.42",
    "content_sanskrit": "इदं वाव तज्ज्येष्ठाय पुत्राय पिता ब्रह्म प्रब्रूयात्प्रणाय्याय वान्तेवासिने ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "base_unit_id": "Ch_C03_S11_V05"
  },
  {
    "id": 16779043,
    "chapter_id": 6179,
    "verse_number": "3.43",
    "content_sanskrit": "नान्यस्मै कस्मैचन यद्यप्यस्मा इमामद्भिः परिगृहीतां धनस्य पूर्णां दद्यादेतदेव ततो भूय इत्येतदेव ततो भूय इति ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "base_unit_id": "Ch_C03_S11_V06"
  },
  {
    "id": 16779044,
    "chapter_id": 6179,
    "verse_number": "3.44",
    "content_sanskrit": "गायत्री वा इदं सर्वं भूतं यदिदं किञ्च वाग्वै गायत्री वाग्वा इदं सर्वं भूतं गायति च त्रायते च ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "base_unit_id": "Ch_C03_S12_V01"
  },
  {
    "id": 16779045,
    "chapter_id": 6179,
    "verse_number": "3.45",
    "content_sanskrit": "या वै सा गायत्रीयं वाव सा येयं पृथिव्यस्याꣳ हीदꣳ सर्वं भूतं प्रतिष्ठितमेतामेव नातिशीयते ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "base_unit_id": "Ch_C03_S12_V02"
  },
  {
    "id": 16779046,
    "chapter_id": 6179,
    "verse_number": "3.46",
    "content_sanskrit": "या वै सा पृथिवीयं वाव सा यदिदमस्मिन्पुरुषे शरीरमस्मिन्हीमे प्राणाः प्रतिष्ठिता एतदेव नातिशीयन्ते ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "base_unit_id": "Ch_C03_S12_V03"
  },
  {
    "id": 16779047,
    "chapter_id": 6179,
    "verse_number": "3.47",
    "content_sanskrit": "यद्वै तत्पुरुषे शरीरमिदं वाव तद्यदिदमस्मिन्नन्तः पुरुषे हृदयमस्मिन्हीमे प्राणाः प्रतिष्ठिता एतदेव नातिशीयन्ते ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "base_unit_id": "Ch_C03_S12_V04"
  },
  {
    "id": 16779048,
    "chapter_id": 6179,
    "verse_number": "3.48",
    "content_sanskrit": "सैषा चतुष्पदा षड्‌विधा गायत्री तदेतदृचाभ्यनूक्तम् ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "base_unit_id": "Ch_C03_S12_V05"
  },
  {
    "id": 16779049,
    "chapter_id": 6179,
    "verse_number": "3.49",
    "content_sanskrit": "तावानस्य महिमा ततो ज्यायंश्च पूरुषः । पादोऽस्य सर्वा भूतानि त्रिपादस्यामृतं दिवीति ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "base_unit_id": "Ch_C03_S12_V06"
  },
  {
    "id": 16779050,
    "chapter_id": 6179,
    "verse_number": "3.50",
    "content_sanskrit": "यद्वै तद्ब्रह्मेतीदं वाव तद्योयं बहिर्धा पुरुषादाकाशो यो वै स बहिर्धा पुरुषादाकाशः ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "base_unit_id": "Ch_C03_S12_V07"
  },
  {
    "id": 16779051,
    "chapter_id": 6179,
    "verse_number": "3.51",
    "content_sanskrit": "अयं वाव स योऽयमन्तः पुरुष आकाशो यो वै सोऽन्तः पुरुष आकाशः ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "base_unit_id": "Ch_C03_S12_V08"
  },
  {
    "id": 16779052,
    "chapter_id": 6179,
    "verse_number": "3.52",
    "content_sanskrit": "अयं वाव स योऽयमन्तर्हृदय आकाशस्तदेतत्पूर्णमप्रवर्ति पूर्णामप्रवर्तिनीं श्रियं लभते य एवं वेद ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "base_unit_id": "Ch_C03_S12_V09"
  },
  {
    "id": 16779053,
    "chapter_id": 6179,
    "verse_number": "3.53",
    "content_sanskrit": "तस्य ह वा एतस्य हृदयस्य पञ्च देवसुषयः स योऽस्य प्राङ्सुषिः स प्राणस्तच्चक्षुः स आदित्यस्तदेतत्तेजोऽन्नाद्यमित्युपासीत तेजस्व्यन्नादो भवति य एवं वेद ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "base_unit_id": "Ch_C03_S13_V01"
  },
  {
    "id": 16779054,
    "chapter_id": 6179,
    "verse_number": "3.54",
    "content_sanskrit": "अथ योऽस्य दक्षिणः सुषिः स व्यानस्तच्छ्रोत्रꣳ स चन्द्रमास्तदेतच्छ्रीश्च यशश्चेत्युपासीत श्रीमान्यशस्वी भवति य एवं वेद ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "base_unit_id": "Ch_C03_S13_V02"
  },
  {
    "id": 16779055,
    "chapter_id": 6179,
    "verse_number": "3.55",
    "content_sanskrit": "अथ योऽस्य प्रत्यङ्सुषिः सोऽपानः सा वाक्योऽग्निस्तदेतद्ब्रह्मवर्चसमन्नाद्यमित्युपासीत ब्रह्मवर्चस्यन्नादो भवति य एवं वेद ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "base_unit_id": "Ch_C03_S13_V03"
  },
  {
    "id": 16779056,
    "chapter_id": 6179,
    "verse_number": "3.56",
    "content_sanskrit": "अथ योऽस्योदङ्सुषिः स समानस्तन्मनः स पर्जन्यस्तदेतत्कीर्तिश्च व्युष्टिश्चेत्युपासीत कीर्तिमान्व्युष्टिमान्भवति य एवं वेद ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "base_unit_id": "Ch_C03_S13_V04"
  },
  {
    "id": 16779057,
    "chapter_id": 6179,
    "verse_number": "3.57",
    "content_sanskrit": "अथ योऽस्योर्ध्वः सुषिः स उदानः स वायुः स आकाशस्तदेतदोजश्च महश्चेत्युपासीतौजस्वी महस्वान्भवति य एवं वेद ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "base_unit_id": "Ch_C03_S13_V05"
  },
  {
    "id": 16779058,
    "chapter_id": 6179,
    "verse_number": "3.58",
    "content_sanskrit": "ते वा एते पञ्च ब्रह्मपुरुषाः स्वर्गस्य लोकस्य द्वारपाः स य एतानेवं पञ्च ब्रह्मपुरुषान्स्वर्गस्य लोकस्य द्वारपान्वेदास्य कुले वीरो जायते प्रतिपद्यते स्वर्गं लोकं य एतानेवं पञ्च ब्रह्मपुरुषान्स्वर्गस्य लोकस्य द्वारपान्वेद ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "base_unit_id": "Ch_C03_S13_V06"
  },
  {
    "id": 16779059,
    "chapter_id": 6179,
    "verse_number": "3.59",
    "content_sanskrit": "अथ यदतः परो दिवो ज्योतिर्दीप्यते विश्वतः पृष्ठेषु सर्वतः पृष्ठेष्वनुत्तमेषूत्तमेषु लोकेष्विदं वाव तद्यदिदमस्मिन्नन्तः पुरुषे ज्योतिः ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "base_unit_id": "Ch_C03_S13_V07"
  },
  {
    "id": 16779060,
    "chapter_id": 6179,
    "verse_number": "3.60",
    "content_sanskrit": "तस्यैषा दृष्टिर्यत्रैतदस्मिञ्छरीरे सꣳस्पर्शेनोष्णिमानं विजानाति तस्यैषा श्रुतिर्यत्रैतत्कर्णावपिगृह्य निनदमिव नदथुरिवाग्नेरिव ज्वलत उपशृणोति तदेतद्दृष्टं च श्रुतं चेत्युपासीत चक्षुष्यः श्रुतो भवति य एवं वेद य एवं वेद ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "base_unit_id": "Ch_C03_S13_V08"
  },
  {
    "id": 16779061,
    "chapter_id": 6179,
    "verse_number": "3.61",
    "content_sanskrit": "सर्वं खल्विदं ब्रह्म तज्जलानिति शान्त उपासीत । अथ खलु क्रतुमयः पुरुषो यथाक्रतुरस्मिंल्लोके पुरुषो भवति तथेतः प्रेत्य भवति स क्रतुं कुर्वीत ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "base_unit_id": "Ch_C03_S14_V01"
  },
  {
    "id": 16779062,
    "chapter_id": 6179,
    "verse_number": "3.62",
    "content_sanskrit": "मनोमयः प्राणशरीरो भारूपः सत्यसङ्कल्प आकाशात्मा सर्वकर्मा सर्वकामः सर्वगन्धः सर्वरसः सर्वमिदमभ्यात्तोऽवाक्यनादरः ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "base_unit_id": "Ch_C03_S14_V02"
  },
  {
    "id": 16779063,
    "chapter_id": 6179,
    "verse_number": "3.63",
    "content_sanskrit": "एष म आत्मान्तर्हृदयेऽणीयान्व्रीहेर्वा यवाद्वा सर्षपाद्वा श्यामाकाद्वा श्यामाकतण्डुलाद्वैष म आत्मान्तर्हृदये ज्यायान्पृथिव्या ज्यायानन्तरिक्षाज्ज्यायान्दिवो ज्यायानेभ्यो लोकेभ्यः ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "base_unit_id": "Ch_C03_S14_V03"
  },
  {
    "id": 16779064,
    "chapter_id": 6179,
    "verse_number": "3.64",
    "content_sanskrit": "सर्वकर्मा सर्वकामः सर्वगन्धः सर्वरसः सर्वमिदमभ्यात्तोऽवाक्यनादर एष म आत्मान्तर्हृदय एतद्ब्रह्मैतमितः प्रेत्याभिसम्भवितास्मीति यस्य स्यादद्धा न विचिकित्सास्तीति ह स्माह शाण्डिल्यः शाण्डिल्यः ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "base_unit_id": "Ch_C03_S14_V04"
  },
  {
    "id": 16779065,
    "chapter_id": 6179,
    "verse_number": "3.65",
    "content_sanskrit": "अन्तरिक्षोदरः कोशो भूमिबुध्नो न जीर्यति दीशो ह्यस्य स्रक्तयो द्यौरस्योत्तरं बिलꣳ स एष कोशो वसुधानस्तस्मिन्विश्वमिदꣳ श्रितम् ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "base_unit_id": "Ch_C03_S15_V01"
  },
  {
    "id": 16779066,
    "chapter_id": 6179,
    "verse_number": "3.66",
    "content_sanskrit": "तस्य प्राची दिग्जुहूर्नाम सहमाना नाम दक्षिणा राज्ञी नाम प्रतीची सुभूता नामोदीची तासां वायुर्वत्सः स य एतमेवं वायुं दिशां वत्सं वेद न पुत्ररोदं रोदिति सोऽहमेतमेवं वायुं दिशां वत्सं वेद मा पुत्ररोदं रुदम् ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "base_unit_id": "Ch_C03_S15_V02"
  },
  {
    "id": 16779067,
    "chapter_id": 6179,
    "verse_number": "3.67",
    "content_sanskrit": "अरिष्टं कोशं प्रपद्येऽमुनामुनामुना प्राणं प्रपद्येऽमुनामुनामुना भूः प्रपद्येऽमुनामुनामुना भुवः प्रपद्येऽमुनामुनामुना स्वः प्रपद्येऽमुनामुनामुना ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "base_unit_id": "Ch_C03_S15_V03"
  },
  {
    "id": 16779068,
    "chapter_id": 6179,
    "verse_number": "3.68",
    "content_sanskrit": "स यदवोचं प्राणं प्रपद्य इति प्राणो वा इदꣳ सर्वं भूतं यदिदं किञ्च तमेव तत्प्रापत्सि ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "base_unit_id": "Ch_C03_S15_V04"
  },
  {
    "id": 16779069,
    "chapter_id": 6179,
    "verse_number": "3.69",
    "content_sanskrit": "अथ यदवोचं भूः प्रपद्य इति पृथिवीं प्रपद्येऽन्तरिक्षं प्रपद्ये दिवं प्रपद्य इत्येव तदवोचम् ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "base_unit_id": "Ch_C03_S15_V05"
  },
  {
    "id": 16779070,
    "chapter_id": 6179,
    "verse_number": "3.70",
    "content_sanskrit": "अथ यदवोचं भुवः प्रपद्य इत्यग्निं प्रपद्ये वायुं प्रपद्य आदित्यं प्रपद्य इत्येव तदवोचम् ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "base_unit_id": "Ch_C03_S15_V06"
  },
  {
    "id": 16779071,
    "chapter_id": 6179,
    "verse_number": "3.71",
    "content_sanskrit": "अथ यदवोचं स्वः प्रपद्य इत्यृग्वेदं प्रपद्ये यजुर्वेदं प्रपद्ये सामवेदं प्रपद्य इत्येव तदवोचं तदवोचम् ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "base_unit_id": "Ch_C03_S15_V07"
  },
  {
    "id": 16779072,
    "chapter_id": 6179,
    "verse_number": "3.72",
    "content_sanskrit": "पुरुषो वाव यज्ञस्तस्य यानि चतुर्विंशति वर्षाणि तत्प्रातःसवनं चतुर्विंशत्यक्षरा गायत्री गायत्रं प्रातःसवनं तदस्य वसवोऽन्वायत्ताः प्राणा वाव वसव एते हीदं सर्वं वासयन्ति ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "base_unit_id": "Ch_C03_S16_V01"
  },
  {
    "id": 16779073,
    "chapter_id": 6179,
    "verse_number": "3.73",
    "content_sanskrit": "तं चेदेतस्मिन्वयसि किञ्चिदुपतपेत्स ब्रूयात्प्रा वसव इदं मे प्रातःसवनं माध्यंन्दिनꣳ सवनमनुसन्तनुतेति माहं प्राणानां वसूनां मध्ये यज्ञो विलोप्सीयेत्युद्धैव तत एत्यगदो ह भवति ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "base_unit_id": "Ch_C03_S16_V02"
  },
  {
    "id": 16779074,
    "chapter_id": 6179,
    "verse_number": "3.74",
    "content_sanskrit": "अथ यानि चतुश्चत्वारिंशद्वर्षाणि तन्माध्यन्दिनं सवनं चतुश्चत्वारिंशदक्षरा त्रिष्टुप्त्रैष्टुभं माध्यंन्दिनꣳ सवनं तदस्य रुद्रा अन्वायत्ताः प्राणा वाव रुद्रा एते हीदं सर्वꣳ रोदयन्ति ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "base_unit_id": "Ch_C03_S16_V03"
  },
  {
    "id": 16779075,
    "chapter_id": 6179,
    "verse_number": "3.75",
    "content_sanskrit": "तं चेदेतस्मिन्वयसि किञ्चिदुपतपेत्सब्रूयात्प्राणा रुद्रा इदं मे माध्यंन्दिनꣳ सवनं तृतीयसवनमनुसन्तनुतेति माहं प्राणानां रुद्राणां मध्ये यज्ञो विलोप्सीयेत्युद्धैव तत एत्यगदो ह भवति ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "base_unit_id": "Ch_C03_S16_V04"
  },
  {
    "id": 16779076,
    "chapter_id": 6179,
    "verse_number": "3.76",
    "content_sanskrit": "अथ यान्यष्टाचत्वारिꣳशद्वर्षाणि तत्तृतीयसवनमष्टाचत्वारिꣳशदक्षरा जगती जागतं तृतीयसवनं तदस्यादित्या अन्वायत्ताः प्राणा वावादित्या एते हीदं सर्वमाददते ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "base_unit_id": "Ch_C03_S16_V05"
  },
  {
    "id": 16779077,
    "chapter_id": 6179,
    "verse_number": "3.77",
    "content_sanskrit": "तं चेदस्मिन्वयसि किञ्चिदुपतपेत्स ब्रूयात्प्राणा आदित्या इदं मे तृतीयसवनमायुरनुसन्तनुतेति माहं प्राणानामादित्यानां मध्ये यज्ञो विलोप्सीयेत्युद्धैव तत एत्यगदो हैव भवति ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "base_unit_id": "Ch_C03_S16_V06"
  },
  {
    "id": 16779078,
    "chapter_id": 6179,
    "verse_number": "3.78",
    "content_sanskrit": "एतद्ध स्म वै तद्विद्वानाह महिदास ऐतरेयः स किं म एतदुपतपसि योऽहमनेन न प्रेष्यामीति स ह षोडशं वर्षशतमजीवत्प्र ह षोडशं वर्षशतं जीवति य एवं वेद ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "base_unit_id": "Ch_C03_S16_V07"
  },
  {
    "id": 16779079,
    "chapter_id": 6179,
    "verse_number": "3.79",
    "content_sanskrit": "स यदशिशिषति यत्पिपासति यन्न रमते ता अस्य दीक्षाः ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "base_unit_id": "Ch_C03_S17_V01"
  },
  {
    "id": 16779080,
    "chapter_id": 6179,
    "verse_number": "3.80",
    "content_sanskrit": "अथ यदश्नाति यत्पिबति यद्रमते तदुपसदैरेति ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "base_unit_id": "Ch_C03_S17_V02"
  },
  {
    "id": 16779081,
    "chapter_id": 6179,
    "verse_number": "3.81",
    "content_sanskrit": "अथ यद्धसति यज्जक्षति यन्मैथुनं चरति स्तुतशस्त्रैरेव तदेति ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "base_unit_id": "Ch_C03_S17_V03"
  },
  {
    "id": 16779082,
    "chapter_id": 6179,
    "verse_number": "3.82",
    "content_sanskrit": "अथ यत्तपो दानमार्जवमहिंसा सत्यवचनमिति ता अस्य दक्षिणाः ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "base_unit_id": "Ch_C03_S17_V04"
  },
  {
    "id": 16779083,
    "chapter_id": 6179,
    "verse_number": "3.83",
    "content_sanskrit": "तस्मादाहुः सोष्यत्यसोष्टेति पुनरुत्पादनमेवास्य तन्मरणमेवावभृथः ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "base_unit_id": "Ch_C03_S17_V05"
  },
  {
    "id": 16779084,
    "chapter_id": 6179,
    "verse_number": "3.84",
    "content_sanskrit": "तद्धैतद्घोर आङ्गिरसः कृष्णाय देवकीपुत्रायोक्त्वोवाचापिपास एव स बभूव सोऽन्तवेलायामेतत्त्रयं प्रतिपद्येताक्षितमस्यच्युतमसि प्राणसं शितमसीति तत्रैते द्वे ऋचौ भवतः ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "base_unit_id": "Ch_C03_S17_V06"
  },
  {
    "id": 16779085,
    "chapter_id": 6179,
    "verse_number": "3.85",
    "content_sanskrit": "आदित्प्रत्नस्य रेतसः । उद्वयं तमसस्परि ज्योतिः पश्यन्त उत्तरꣳस्वः पश्यन्ति उत्तरं देवं देवत्रा सूर्यमगन्म ज्योतिरुत्तममिति ज्योतिरुत्तममिति ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "base_unit_id": "Ch_C03_S17_V07"
  },
  {
    "id": 16779086,
    "chapter_id": 6179,
    "verse_number": "3.86",
    "content_sanskrit": "मनो ब्रह्मेत्युपसीतेत्यध्यात्ममथाधिदैवतमाकाशो ब्रह्मेत्युभयमादिष्टं भवत्यध्यात्मं चाधिदैवतं च ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "base_unit_id": "Ch_C03_S18_V01"
  },
  {
    "id": 16779087,
    "chapter_id": 6179,
    "verse_number": "3.87",
    "content_sanskrit": "तदेतच्चतुष्पाद्ब्रह्म वाक्पादः प्राणः पादश्चक्षुः पादः श्रोत्रं पाद इत्यध्यात्ममथाधिदैवतमग्निः पादो वायुः पाद आदित्यः पादो दिशः पाद इत्युभयमेवादिष्टं भवत्यध्यात्मं चैवाधिदैवतं च ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 87,
    "base_unit_id": "Ch_C03_S18_V02"
  },
  {
    "id": 16779088,
    "chapter_id": 6179,
    "verse_number": "3.88",
    "content_sanskrit": "वागेव ब्रह्मणश्चतुर्थः पादः सोऽग्निना ज्योतिषा भाति च तपति च भाति च तपति च कीर्त्या यशसा ब्रह्मवर्चसेन य एवं वेद ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 88,
    "base_unit_id": "Ch_C03_S18_V03"
  },
  {
    "id": 16779089,
    "chapter_id": 6179,
    "verse_number": "3.89",
    "content_sanskrit": "प्राण एव ब्रह्मणश्चतुर्थः पादः स वायुना ज्योतिषा भाति च तपति च भाति च तपति च कीर्त्या यशसा ब्रह्मवर्चसेन य एवं वेद ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 89,
    "base_unit_id": "Ch_C03_S18_V04"
  },
  {
    "id": 16779090,
    "chapter_id": 6179,
    "verse_number": "3.90",
    "content_sanskrit": "चक्षुरेव ब्रह्मणश्चतुर्थः पादः स आदित्येन ज्योतिषा भाति च तपति च भाति च तपति च कीर्त्या यशसा ब्रह्मवर्चसेन य एवं वेद ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 90,
    "base_unit_id": "Ch_C03_S18_V05"
  },
  {
    "id": 16779091,
    "chapter_id": 6179,
    "verse_number": "3.91",
    "content_sanskrit": "श्रोत्रमेव ब्रह्मणश्चतुर्थः पादः स दिग्भिर्ज्योतिषा भाति च तपति च भाति च तपति च कीर्त्या यशसा ब्रह्मवर्चसेन य एवं वेद य एवं वेद ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 91,
    "base_unit_id": "Ch_C03_S18_V06"
  },
  {
    "id": 16779092,
    "chapter_id": 6179,
    "verse_number": "3.92",
    "content_sanskrit": "आदित्यो ब्रह्मेत्यादेशस्तस्योपव्याख्यानमसदेवेदमग्र आसीत् । तत्सदासीत्तत्समभवत्तदाण्डं निरवर्तत तत्संवत्सरस्य मात्रामशयत तन्निरभिद्यत ते आण्डकपाले रजतं च सुवर्णं चाभवताम् ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 92,
    "base_unit_id": "Ch_C03_S19_V01"
  },
  {
    "id": 16779093,
    "chapter_id": 6179,
    "verse_number": "3.93",
    "content_sanskrit": "तद्यद्रजतं सेयं पृथिवी यत्सुवर्णं सा द्यौर्यज्जरायु ते पर्वता यदुल्बं समेघो नीहारो या धमनयस्ता नद्यो यद्वास्तेयमुदकं स समुद्रः ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 93,
    "base_unit_id": "Ch_C03_S19_V02"
  },
  {
    "id": 16779094,
    "chapter_id": 6179,
    "verse_number": "3.94",
