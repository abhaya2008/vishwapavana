  {
    "id": 16779010,
    "chapter_id": 6179,
    "verse_number": "3.10",
    "content_sanskrit": "तद्व्यक्षरत्तदादित्यमभितोऽश्रयत्तद्वा एतद्यदेतदादित्यस्य कृष्णꣳ रूपम् ॥ ३ ॥",
    "padaccheda": "",
