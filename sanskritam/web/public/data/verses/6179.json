  {
    "id": 16779011,
    "chapter_id": 6179,
    "verse_number": "3.11",
    "content_sanskrit": "अथ येऽस्योदञ्चो रश्मयस्ता एवास्योदीच्यो मधुनाड्योऽथर्वाङ्गिरस एव मधुकृत इतिहासपुराणं पुष्पं ता अमृता आपः ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "base_unit_id": "Ch_C03_S04_V01"
  },
  {
    "id": 16779012,
    "chapter_id": 6179,
    "verse_number": "3.12",
    "content_sanskrit": "ते वा एतेऽथर्वाङ्गिरस एतदितिहासपुराणमभ्यतपꣳ स्तस्याभितप्तस्य यशस्तेज इन्द्रियं वीर्यमन्नाद्यꣳ रसोऽजायत ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "base_unit_id": "Ch_C03_S04_V02"
  },
  {
    "id": 16779013,
    "chapter_id": 6179,
    "verse_number": "3.13",
    "content_sanskrit": "तद्व्यक्षरत्तदादित्यमभितोऽश्रयत्तद्वा एतद्यदेतदादित्यस्य परं कृष्णꣳ रूपम् ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "base_unit_id": "Ch_C03_S04_V03"
  },
  {
    "id": 16779014,
    "chapter_id": 6179,
    "verse_number": "3.14",
    "content_sanskrit": "अथ येऽस्योर्ध्वा रश्मयस्ता एवास्योर्ध्वा मधुनाड्यो गुह्या एवादेशा मधुकृतो ब्रह्मैव पुष्पं ता अमृता आपः ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "base_unit_id": "Ch_C03_S05_V01"
  },
  {
    "id": 16779015,
    "chapter_id": 6179,
    "verse_number": "3.15",
    "content_sanskrit": "ते वा एते गुह्या आदेशा एतद्ब्रह्माभ्यतपꣳ स्तस्याभितप्तस्य यशस्तेज इन्द्रियं वीर्यमन्नाद्यꣳ रसोऽजायत ॥ २ ॥",
