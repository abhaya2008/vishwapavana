[{"id": 2103274, "chapter_id": 3240, "verse_number": "१४-९६-१", "content_sanskrit": "जनमेजय उवाच।\nअश्वमेधे पुरावृत्ते केशवं केशिसूदनम्।\nधर्मसंशयमुद्दिश्य किमपृच्छत्पितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2103275, "chapter_id": 3240, "verse_number": "१४-९६-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2103276, "chapter_id": 3240, "verse_number": "१४-९६-२", "content_sanskrit": "पश्चिमेनाश्वमेधेन यदा स्नातो युधिष्ठिरः।\nतदा राजा नमस्कृत्य केशवं पुनरब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2103277, "chapter_id": 3240, "verse_number": "१४-९६-३", "content_sanskrit": "भववन्वैष्णवा धर्माः किंफलाः किंपरायणाः।\nकिं धर्ममधिकृत्याथ भवतोत्पादिताः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2103278, "chapter_id": 3240, "verse_number": "१४-९६-४", "content_sanskrit": "यदि तेहमनुग्राह्यः प्रियोस्मि मधुसूदन।\nश्रोतव्या यदि मे कृष्ण तन्मे कथय सुव्रत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2103279, "chapter_id": 3240, "verse_number": "१४-९६-५", "content_sanskrit": "पवित्रा किल ते धर्माः सर्वपापप्रणाशनाः।\nसर्वधर्मोत्तमाः पुण्या भगवंस्त्वन्मुखोद्गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2103280, "chapter_id": 3240, "verse_number": "१४-९६-६", "content_sanskrit": "याञ्श्रुत्वा ब्रह्महा गोघ्नो मातृहा गुरुतल्पगः।\nपाकर्भेदी कृतघ्नश्च सुरापो ब्रह्मविक्रयी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2103281, "chapter_id": 3240, "verse_number": "१४-९६-७", "content_sanskrit": "मित्रविश्वासघाती च वीरहा भ्रूणहा तथा।\nतपोविक्रयिणश्चैव दानविक्रयिणस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2103282, "chapter_id": 3240, "verse_number": "१४-९६-८", "content_sanskrit": "आत्मविक्रमयिणो मूढा जीवेद्यश्च विकर्मभिः।\nपापाः शठा नैकृतिका डांभिका दूषकास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2103283, "chapter_id": 3240, "verse_number": "१४-९६-९", "content_sanskrit": "रसभेदकरा ये च ये च स्युर्ब्रह्मघातकाः।\nशूद्रप्रेष्यकराश्चोरा विप्रा ये च पुरोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2103284, "chapter_id": 3240, "verse_number": "१४-९६-१०", "content_sanskrit": "निक्षेपहारिणः स्त्रीघ्नास्तथा ये पारदारिकाः।\nएते चान्ये च पापा ये मुच्यन्तेतेऽपि किल्बिषात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2103285, "chapter_id": 3240, "verse_number": "१४-९६-११", "content_sanskrit": "तानाचक्ष्व सुरश्रेष्ठ त्वद्भक्तस्य ममाच्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2103286, "chapter_id": 3240, "verse_number": "१४-९६-१२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2103287, "chapter_id": 3240, "verse_number": "१४-९६-१२", "content_sanskrit": "इत्येवं कथिते देवे धर्मपुत्रेण संसदि।\nवसिष्ठाद्यास्तपोयुक्ता मुनयस्तत्वदर्शिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2103288, "chapter_id": 3240, "verse_number": "१४-९६-१३", "content_sanskrit": "श्रोतुकामाः परं गुह्यं वैष्णवं धर्ममुत्तमम्।\nतथा भागवताश्चैव ततस्तं पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2103289, "chapter_id": 3240, "verse_number": "१४-९६-१४x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2103290, "chapter_id": 3240, "verse_number": "१४-९६-१४", "content_sanskrit": "तत्वतस्तव भावेन पादमूलमुपागतम्।\nयदि जानासि मां भक्तं स्निग्धं वा भक्तवत्सल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2103291, "chapter_id": 3240, "verse_number": "१४-९६-१५", "content_sanskrit": "धर्मगुह्यानि सर्वाणि वेत्तुमिच्छामि तत्वतः।\nधर्मान्कथय मे देव यद्यनुग्रहभागहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2103292, "chapter_id": 3240, "verse_number": "१४-९६-१६", "content_sanskrit": "श्रुता मे मानवा धर्मा वासिष्ठाः काश्यपास्तथा।\nगार्गीया गौतमीयाश्च तथा गोपालकस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2103293, "chapter_id": 3240, "verse_number": "१४-९६-१७", "content_sanskrit": "पराशरकृताः पूर्वा मैत्रेयस्य च धीमतः।\nऔमा माहेश्वराश्चैव नन्दिधर्माश्च पावनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2103294, "chapter_id": 3240, "verse_number": "१४-९६-१८", "content_sanskrit": "ब्रह्मणा कथिता ये च कौमाराश्च श्रुता मया।\nधूमायनकृता धर्माः काण्डवैश्वानरा अपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2103295, "chapter_id": 3240, "verse_number": "१४-९६-१९", "content_sanskrit": "भार्गवा याज्ञवल्क्याश्च मार्कण्डेयकृता अपि।\nभारद्वाजकृता ये च बृहस्पतिकृताश्च ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2103296, "chapter_id": 3240, "verse_number": "१४-९६-२०", "content_sanskrit": "कुणेश्च कुणिबाहोश्च विश्वामित्रकृताश्च ये।\nसुमन्तुजैमिनिकृताः शाकुनेयास्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2103297, "chapter_id": 3240, "verse_number": "१४-९६-२१", "content_sanskrit": "पुलस्त्यपुलहोद्गीताः पावकीयास्तथैव च।\nअगस्त्यगीता मौद्गल्याः शाण्डिल्याः शलभायनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2103298, "chapter_id": 3240, "verse_number": "१४-९६-२२", "content_sanskrit": "वालखिल्यकृता ये च ये च सप्तर्षिभिस्तथा।\nआपस्तंबकृता धर्माः शङ्खस्य लिखितस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2103299, "chapter_id": 3240, "verse_number": "१४-९६-२३", "content_sanskrit": "प्राजापत्यास्तथा याम्या माहेन्द्राश्च श्रुता मया।\nवैयाघ्रव्यासकीयाश्च विभण्डककृताश्च ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2103300, "chapter_id": 3240, "verse_number": "१४-९६-२४", "content_sanskrit": "नारदीयाः श्रुता धर्माः कापोताश्च श्रुता मया।\nतथा विदुरवाक्यानि भृगोरङ्गिरसस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2103301, "chapter_id": 3240, "verse_number": "१४-९६-२५", "content_sanskrit": "क्रौञ्चा मृदङ्गगीताश्च सौर्या हारीतकाश्च ये।\nये पिशङ्गकृताश्चापि कातपायाः सुवालकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2103302, "chapter_id": 3240, "verse_number": "१४-९६-२६", "content_sanskrit": "उद्दालककृता धर्मा औशनस्यास्तथैव च।\nवैशम्पायनगीताश्च ये चान्येऽप्येवमादितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2103303, "chapter_id": 3240, "verse_number": "१४-९६-२७", "content_sanskrit": "एतेभ्यः सर्वधर्मेभ्यो देव त्वन्मुखनिस्सृताः।\nपावनात्वात्पवित्रत्वाद्विशिष्टा इति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2103304, "chapter_id": 3240, "verse_number": "१४-९६-२८", "content_sanskrit": "तस्माद्धि त्वां प्रपन्नस्य त्वद्भक्तस्य च केशव।\nयुष्मदीयान्वरान्धर्मान्पुण्यान्कथय मेच्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2103305, "chapter_id": 3240, "verse_number": "१४-९६-२९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2103306, "chapter_id": 3240, "verse_number": "१४-९६-२९", "content_sanskrit": "एवं पृष्टस्तु धर्मज्ञो धर्मपुत्रेण केशवः।\nउवाच धर्मान्सूक्ष्मार्थान्धर्मपुत्रस्य हर्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2103307, "chapter_id": 3240, "verse_number": "१४-९६-३०", "content_sanskrit": "एवं ते यस्य कौन्तेय यत्नो धर्मेषु सुव्रत।\nतस्य ते दुर्लभो लोके न कश्चिदपि विद्येत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2103308, "chapter_id": 3240, "verse_number": "१४-९६-३१", "content_sanskrit": "धर्मः श्रुतो वा दृष्टो वा कथितो वा कृतोपि वा।\nअनुमोदितो वा राजेन्द्र नयतीन्द्रपदं नरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2103309, "chapter_id": 3240, "verse_number": "१४-९६-३२", "content_sanskrit": "धर्मः पिता च माता च धर्मो नाथः सुहृत्तथा।\nधर्मो भ्राता सखा चैव धर्मः स्वामी परंतप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2103310, "chapter_id": 3240, "verse_number": "१४-९६-३३", "content_sanskrit": "धर्मादर्थश्च कामश्च धर्माद्भोगाः सुखानि च।\nधर्मार्दैश्वर्यमेवाग्र्यं धर्मात्स्वर्गगतिः परा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2103311, "chapter_id": 3240, "verse_number": "१४-९६-३४", "content_sanskrit": "धर्मोयं सेवितः शुद्धस्त्रायते महतो भयात्।\nधर्माद्द्विजत्वं देवत्वं धर्मः पावयते नरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2103312, "chapter_id": 3240, "verse_number": "१४-९६-३५", "content_sanskrit": "यदा च क्षीयते पापं कालेन पुरुषस्य तु।\nतदा संजायते बुद्धिर्धर्मं कर्तुं युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2103313, "chapter_id": 3240, "verse_number": "१४-९६-३६", "content_sanskrit": "जन्मान्तरसहस्रैस्तु मनुष्यत्वं हि दुर्लभम्।\nतद्गत्वापीह यो धर्मं न करोति स्ववञ्चितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2103314, "chapter_id": 3240, "verse_number": "१४-९६-३७", "content_sanskrit": "कुत्सिता ये दरिद्राश्च विरूपा व्याधितास्तथा।\nपरद्वेष्याश्च मूर्खाश्च न तैर्धर्मः कृतः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2103315, "chapter_id": 3240, "verse_number": "१४-९६-३८", "content_sanskrit": "ये च दीर्घायुषः शूराः पण्डिता भोगिनस्तथा॥\nनीरोगा रूपसंपन्नास्तैर्धर्मः सुकृतः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2103316, "chapter_id": 3240, "verse_number": "१४-९६-३९", "content_sanskrit": "एवं धर्मः कृतः शुद्धो नयते गतिमुत्तमाम्।\nअधर्मं सेवते यस्तु तिर्यग्योन्यां पतत्यसौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2103317, "chapter_id": 3240, "verse_number": "१४-९६-४०", "content_sanskrit": "इदं रहस्यं कौन्तेय शृणु धर्ममनुत्तमम्।\nकथयिष्ये परं धर्मं तव भक्तस्य पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2103318, "chapter_id": 3240, "verse_number": "१४-९६-४१", "content_sanskrit": "इष्टस्त्वमसि मेऽत्यर्थं प्रपन्नश्चापि मां सदा।\nपरमार्थमपि ब्रूयां किं पुनर्धर्मसंहिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2103319, "chapter_id": 3240, "verse_number": "१४-९६-४२", "content_sanskrit": "इदं मे मानुषं जन्म कृतमात्मनि मायया।\nधर्मसंस्थापनार्थाय दुष्टानां नाशनाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2103320, "chapter_id": 3240, "verse_number": "१४-९६-४३", "content_sanskrit": "मानुष्यं भावमापन्नं ये मां गृह्णन्त्यवज्ञया।\nसंसारान्तर्हि ते मूढास्तिर्यग्योनिष्वनेकशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2103321, "chapter_id": 3240, "verse_number": "१४-९६-४४", "content_sanskrit": "ये च मां सर्वभूतस्थं पश्यन्ति ज्ञानचक्षुषा।\nमद्भक्तांस्तान्सदा युक्तान्मत्समीपं नयाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2103322, "chapter_id": 3240, "verse_number": "१४-९६-४५", "content_sanskrit": "मद्भक्ता न विनश्यन्ति मद्भक्ता वीतकल्मषाः।\nमद्भाक्तानां तु मानुष्ये सफल जन्म पाण्डवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2103323, "chapter_id": 3240, "verse_number": "१४-९६-४६", "content_sanskrit": "अपि पापेष्वभिरता मद्भक्ताः पाण्डुनन्दन।\nमुच्यन्ते पातकैः सर्वैः पद्मपत्रमिवांभसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2103324, "chapter_id": 3240, "verse_number": "१४-९६-४७", "content_sanskrit": "जन्मान्तरसहस्रेषु तपसा भावितात्मनाम्।\nभक्तिरुत्पद्यते तात मनुष्याणां न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2103325, "chapter_id": 3240, "verse_number": "१४-९६-४८", "content_sanskrit": "यच्च रूपं परं गुह्यं कूटस्तमचलं ध्रुवम्।\nन दृश्यते तता देवैर्मद्भक्तैर्दृश्यते यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2103326, "chapter_id": 3240, "verse_number": "१४-९६-४९", "content_sanskrit": "अपरं यच्च मे रूपं पर्रादुर्भावेषु दृश्यते।\nतदर्चयन्ति सर्वार्थैः सर्वभूतानि पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2103327, "chapter_id": 3240, "verse_number": "१४-९६-५०", "content_sanskrit": "कल्पकोटिसहस्रेषु व्यतीतेष्वागते च।\nदर्शयामीह तद्रूपं यच्च पश्यन्ति मे सुराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2103328, "chapter_id": 3240, "verse_number": "१४-९६-५१", "content_sanskrit": "स्तित्युत्पत्त्यव्ययकरं यो मां ज्ञात्वा प्रपद्यते।\nअनुगृह्णाम्यहं तं वै संसारान्मोचयामि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2103329, "chapter_id": 3240, "verse_number": "१४-९६-५२", "content_sanskrit": "अहमादिर्हि देवानां सृष्टा ब्रह्मादयो मया।\nप्रकृतिं स्वामवष्टभ्य जगत्सर्वं सृजाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2103330, "chapter_id": 3240, "verse_number": "१४-९६-५३", "content_sanskrit": "तमोमूलोहमव्यक्तो रजोमध्ये प्रतिष्ठितः।\nऊर्ध्वं सत्त्वं विना लोभं ब्रह्मादिस्तंबपर्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2103331, "chapter_id": 3240, "verse_number": "१४-९६-५४", "content_sanskrit": "मूर्धानं मे विद्धि दिवं चन्द्रादित्यौ च लोचने।\nगावोग्निर्बाह्मणो वक्त्रं मारुतः श्वसनं च मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2103332, "chapter_id": 3240, "verse_number": "१४-९६-५५", "content_sanskrit": "दिशो मे बाहवश्चाष्टौ नक्षत्राणि च भूषणम्।\nअन्तरिक्षमुरो विद्धि सर्वभूतावकाशकम्।\nमार्गो मेघानिलाभ्यां तु यन्ममोदरमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2103333, "chapter_id": 3240, "verse_number": "१४-९६-५६", "content_sanskrit": "पृथिवीमण्डलं यद्वै द्वीपार्णवनगैर्युतम्।\nसर्वसंधारणोपेतं पादौ मम युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2103334, "chapter_id": 3240, "verse_number": "१४-९६-५७", "content_sanskrit": "स्थितो ह्येकगुणः खेऽहं द्विगुणश्चास्मि मारुते।\nत्रिगुणोग्नौ स्थितोहं वै सलिले च चतुर्गुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2103335, "chapter_id": 3240, "verse_number": "१४-९६-५८", "content_sanskrit": "शब्दाद्या ये गुणाः पञ्च महाभूतेषु पञ्चसु।\nतन्मात्रासंस्थितः सोहं पृथिव्यां पञ्चधास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2103336, "chapter_id": 3240, "verse_number": "१४-९६-५९", "content_sanskrit": "अहं सहस्रसीर्षस्तु सहस्रवदनेक्षणः।\nसहस्रबाहूदरधृक्सहस्रोरुः सहस्रपात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2103337, "chapter_id": 3240, "verse_number": "१४-९६-६०", "content_sanskrit": "धृत्वोर्वीं सर्वतः सम्यगत्यतिष्ठं दशांगुलम्।\nसर्वभूतात्मभूतस्थः सर्वव्यापी ततोस्म्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2103338, "chapter_id": 3240, "verse_number": "१४-९६-६१", "content_sanskrit": "अचिन्त्योहमनन्तोहमजरोहमजो ह्यहम्।\nअनाद्योऽहमवध्योहमप्रमेयोहमव्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2103339, "chapter_id": 3240, "verse_number": "१४-९६-६२", "content_sanskrit": "निर्गुणोहं निगूढात्मा निर्द्वन्द्वो निर्ममो नृप।\nनिष्कलो निर्विकारोहं निदानममृतस्य तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2103340, "chapter_id": 3240, "verse_number": "१४-९६-६३", "content_sanskrit": "सुधा चाहं स्वधा चाहं स्वाहा चाहं नराधिप।\nतेजसा तपसा चाहं भूतग्रामं चतुर्विधम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2103341, "chapter_id": 3240, "verse_number": "१४-९६-६४", "content_sanskrit": "स्नेहपाशैर्गुणबद्ध्वा धारयाम्यात्ममायया।\nचातुराश्रमधर्मेहं चातुर्होत्रफलाशनः।\nचतुर्मूर्तिश्चतुर्यज्ञश्चतुराश्रमभावनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2103342, "chapter_id": 3240, "verse_number": "१४-९६-६५", "content_sanskrit": "संहृत्याहं जगत्सर्वं कृत्वा वै गर्भमात्मनः।\nशयामि दिव्ययोगेन प्रलयेषु युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2103343, "chapter_id": 3240, "verse_number": "१४-९६-६६", "content_sanskrit": "सहस्रयुगपर्यन्तां ब्राह्मीं रात्रिं महार्णवे।\nस्थित्वा सृजामि भूतानि जङ्गमानि स्थिराणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2103344, "chapter_id": 3240, "verse_number": "१४-९६-६७", "content_sanskrit": "कल्पे कल्पे च भूतानि संहरामि सृजामि च।\nन च मां तानि जानन्ति मायया मोहितानि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2103345, "chapter_id": 3240, "verse_number": "१४-९६-६८", "content_sanskrit": "मम चैवान्धकारस्य मार्गितव्यस्य नित्यशः।\nप्रशान्तस्येव दीपस्य गतिर्नैपोपलभ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2103346, "chapter_id": 3240, "verse_number": "१४-९६-६९", "content_sanskrit": "न तदस्ति क्वचिद्राजन्यत्राहं न प्रतिष्ठितः।\nन च तद्विद्यते भूतं मयि यन्न प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2103347, "chapter_id": 3240, "verse_number": "१४-९६-७०", "content_sanskrit": "यावन्मित्रं भवेद्भूतं स्थूलं सूक्ष्ममिदं जगत्।\nदीवभूतो ह्यहं तस्मिंस्तावन्मात्रं प्रतिष्ठितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2103348, "chapter_id": 3240, "verse_number": "१४-९६-७१", "content_sanskrit": "किंचात्र बहुनोक्तेन सत्यमेतद्ब्रवीमि ते।\nयद्भूतं यद्भविष्यच्च तत्सर्वमहमेव तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2103349, "chapter_id": 3240, "verse_number": "१४-९६-७२", "content_sanskrit": "मया सृष्टानि भूतानि मन्मयानि च भारत।\nमामेव न विजानन्ति मायया मोहितानि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2103350, "chapter_id": 3240, "verse_number": "१४-९६-७३", "content_sanskrit": "एवं सर्वं जगदिदं सदेवासुरमानुषम्।\nमत्तः प्रभवते राजन्मय्येव प्रविलीयते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2103351, "chapter_id": 3240, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि वैष्णवधर्मपर्वणि षण्णवतितमोऽध्यायः॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]