[{"id": 2146874, "chapter_id": 4170, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2146875, "chapter_id": 4170, "verse_number": "१", "content_sanskrit": "इदं रसातळं नाम सप्तमं पृथिवीतळम् ।\nयत्रास्ते सुरभिर्माता गवाममृतसम्भवा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2146876, "chapter_id": 4170, "verse_number": "२", "content_sanskrit": "क्षरन्ती सततं क्षीरं पृथिवीसारसम्भवम् ।\nषण्णां रसानां सारेण रसमेकमनुत्तमम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2146877, "chapter_id": 4170, "verse_number": "३", "content_sanskrit": "अमृतेनाभितृप्तस्य वाचमुद्गिरतः पुरा ।\nपितामहस्य वदनाद् उदतिष्ठदनिन्दिता\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2146878, "chapter_id": 4170, "verse_number": "४", "content_sanskrit": "यस्याः क्षीरस्य धाराया निपतन्त्या महीतळे ।\nह्रदः कृतः क्षीरनिधिः पवित्रं परमं पदम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2146879, "chapter_id": 4170, "verse_number": "५", "content_sanskrit": "पुष्पितस्यैव फेनेन पर्यन्तमनुवेष्टितम् ।\nपिबन्तो निवसन्त्यत्र फेनपा मुनिसत्तमाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2146880, "chapter_id": 4170, "verse_number": "६", "content_sanskrit": "फेनपा नाम ते ख्याताः फेनाहाराश्च मातले ।\nउग्रे तपसि वर्तन्ते येषां बिभ्यति देवताः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2146881, "chapter_id": 4170, "verse_number": "७", "content_sanskrit": "अस्याश्चतस्रो धेन्वोऽन्या दिक्षु सर्वासु मातले ।\nनिवसन्ति दिशां पाल्यो धारयन्त्यो दिशः स्म ताः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2146882, "chapter_id": 4170, "verse_number": "८", "content_sanskrit": "पूर्वां दिशं धारयते सुरूपा नाम सौरभी ।\nदक्षिणां हंसिका नाम धारयत्यपरा दिशम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2146883, "chapter_id": 4170, "verse_number": "९", "content_sanskrit": "पश्चिमा वारुणी दिक् च धार्यते वै सुभद्रया ।\nमहानुभावया नित्यं मातले विश्वरूपया\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2146884, "chapter_id": 4170, "verse_number": "१०", "content_sanskrit": "सर्वकामदुघा नाम धेनुर्धारयते दिशम् ।\nउत्तरां मातले धर्म्यां तथैलबिलिसंश्रिताम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2146885, "chapter_id": 4170, "verse_number": "११", "content_sanskrit": "आसां तु पयसा मिश्रं पयो निर्मथ्य सागरे ।\nमन्थानं मन्दरं कृत्वा दैवैरसुरसंहितैः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2146886, "chapter_id": 4170, "verse_number": "१२", "content_sanskrit": "उद्धृता वारुणी लक्ष्मीः अमृतं चापि मातले ।\nउच्चैःश्रवाश्चाश्वराजो मणिरत्नं च कौस्तुभम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2146887, "chapter_id": 4170, "verse_number": "१३", "content_sanskrit": "सुधाहारेषु च सुधां स्वधाभोजिषु च स्वधाम् ।\nअमृतं चामृताशेषु सुरभिः क्षरते पयः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2146888, "chapter_id": 4170, "verse_number": "१४", "content_sanskrit": "अत्र गाथा पुरा गीता रसातळनिवासिभिः ।\nपौराणी श्रूयते लोके गीयते या मनीषिभिः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2146889, "chapter_id": 4170, "verse_number": "१५", "content_sanskrit": "न नागलोके न स्वर्गे न विमाने त्रिविष्टपे ।\nपरिवासः सुखस्तादृक् रसातळतळे यथा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2146890, "chapter_id": 4170, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकाधिकशततमोऽध्यायः ॥१०१॥\nभगवद्यानपर्वणि द्वात्रिंशोऽध्यायः ॥३२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]