[{"id": 2179686, "chapter_id": 4806, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2179687, "chapter_id": 4806, "verse_number": "१", "content_sanskrit": "एवमुक्तस्तु कौन्तेयो गुडाकेशेन भारत ।\nनोवाच किञ्चित् कौरव्यस्ततो द्वैपायनोऽब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2179688, "chapter_id": 4806, "verse_number": "", "content_sanskrit": "श्रीवेदव्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2179689, "chapter_id": 4806, "verse_number": "२", "content_sanskrit": "बीभत्सोर्वचनं सम्यक् सत्यमेतद् युधिष्ठिर ।\nशास्त्रदृष्टः परो धर्मः स्मृतो गार्हस्थ्य आश्रमः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2179690, "chapter_id": 4806, "verse_number": "३", "content_sanskrit": "स्वधर्मं चर धर्मज्ञ यथाशास्त्रं यथाविधि ।\nनहि गार्हस्थ्यमुत्सृय तवारण्यं विधीयते\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2179691, "chapter_id": 4806, "verse_number": "४", "content_sanskrit": "गृहस्थं हि सदा देवाः पितरो ऋषयस्तथा ।\nभृत्याश्वैवोपजीवन्ति तान् भजस्व महीपते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2179692, "chapter_id": 4806, "verse_number": "५", "content_sanskrit": "वयांसि पशवश्चैव भूतानि च महीपते ।\nगृहस्थैरेव धार्यन्ते तस्माज्ज्येष्ठाश्रमो गृही\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2179693, "chapter_id": 4806, "verse_number": "६", "content_sanskrit": "सोऽयं चतुर्णामेतेषामाश्रमाणां दुराचरः ।\nतं चराविमनाः पार्थ दुश्चर दुर्बलेन्द्रियैः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2179694, "chapter_id": 4806, "verse_number": "७", "content_sanskrit": "वेदज्ञानं च ते कृत्स्नं तपश्च चरितं महत् ।\nपितृपैतामहे राज्ये धुरमुद्वोढुमर्हसि\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2179695, "chapter_id": 4806, "verse_number": "८", "content_sanskrit": "तपो यज्ञस्तथा विद्या भैक्षमिन्द्रियनिग्रहः ।\nध्यानमेकान्तशीलत्वं तुष्टिर्दानं च शक्तितः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2179696, "chapter_id": 4806, "verse_number": "९", "content_sanskrit": "ब्राह्मणानां महाराज चेष्टाः संसिद्धिकारिकाः ।\nक्षत्रियाणां च वक्ष्यामि तवापि विदितं पुनः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2179697, "chapter_id": 4806, "verse_number": "१०", "content_sanskrit": "यज्ञो विद्या समुत्थानमसन्तोषः श्रियं प्रति ।\nदण्डधारणमत्युग्रं प्रजानां परिपालनम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2179698, "chapter_id": 4806, "verse_number": "११", "content_sanskrit": "वेदज्ञानं तथा कृत्स्नं तपः सुचरितं तथा ।\nद्रविणोपार्जनं भूरि पात्रेषु प्रतिपादनम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2179699, "chapter_id": 4806, "verse_number": "१२", "content_sanskrit": "एतानि राज्ञां कर्माणि सुकृतानि विशां पते ।\nइमं लोकममुं लोकं साधयन्तीति नः श्रुतम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2179700, "chapter_id": 4806, "verse_number": "१३", "content_sanskrit": "तेषां ज्यायस्तु कौन्तेय दण्डधारणमुच्यते ।\nबलं हि क्षत्रिये नित्यं बले दण्डः समाहितः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2179701, "chapter_id": 4806, "verse_number": "१४", "content_sanskrit": "एताश्चेष्टाः क्षत्रियाणां राजन् संसिद्धि कारिकाः ।\nअपि गाथामिमां चापि बृहस्पतिरभाषत\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2179702, "chapter_id": 4806, "verse_number": "१५", "content_sanskrit": "भूमिरेतौ निगिरति सर्पो बिलशयानिव ।\nराजानं चाविरोद्धार ब्राह्मणं चाप्रवासिनम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2179703, "chapter_id": 4806, "verse_number": "१६", "content_sanskrit": "सुद्युम्नश्चापि राजर्षिः श्रूयते दण्डधारणात् ।\nप्राप्तवान् परमां सिद्धिं दक्षः प्राचेतसो यथा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2179704, "chapter_id": 4806, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे त्रयोविंशोऽध्यायः ॥ २३ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]