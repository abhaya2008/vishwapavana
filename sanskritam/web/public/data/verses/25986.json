[{"id": 7005986000, "chapter_id": 25986, "verse_number": "१-१६९-१", "content_sanskrit": "धन्वन्तरिरुवाच ।\nहिताहितविकेकाय अनुपानविधिं ब्रुवे ।\nरक्तशालि त्रिदोषघ्नं तृष्णामेदोनिवारकम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005986001, "chapter_id": 25986, "verse_number": "१-१६९-२", "content_sanskrit": "महाशालि परं वृष्यं कलमः श्लेष्मपित्तहा ।\nशीत्तो गुरुस्त्रिदोषघ्नः प्रायशो गौरषष्टिकः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005986002, "chapter_id": 25986, "verse_number": "१-१६९-३", "content_sanskrit": "श्यामाकः शोषणो रूक्षो वातलः श्लेष्मपित्तह ।\nतद्वत्प्रियङ्गुनीवारकोरदूषाः प्रकीर्तिताः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005986003, "chapter_id": 25986, "verse_number": "१-१६९-४", "content_sanskrit": "बहुवारः सकृच्छीतः श्लेष्मपित्तहरो यवः ।\nवृष्यः शीतो गुरुः स्वादुर्गोधूमो वातनाशनः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005986004, "chapter_id": 25986, "verse_number": "१-१६९-५", "content_sanskrit": "कफपित्तास्त्रजिन्मुद्गः कषायो मधुरोलघुः ।\nमाषो बहुबलो वृष्यः पित्तश्लेष्महरो गुरुः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005986005, "chapter_id": 25986, "verse_number": "१-१६९-६", "content_sanskrit": "अवृष्यः श्लेष्मपित्तघ्नो राजमाषोऽनिलार्तनुत् ।\nकुलत्थः श्वासहिक्काहृत्कफगुल्मानिलापहः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005986006, "chapter_id": 25986, "verse_number": "१-१६९-७", "content_sanskrit": "रक्तपित्तज्वरोन्माथो शीतो ग्राही मकुष्ठकः ।\nपुंस्त्वासृक्कफपित्तघ्नश्चणको वातलः स्मृतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005986007, "chapter_id": 25986, "verse_number": "१-१६९-८", "content_sanskrit": "मसूरो मधुरः शीव संग्रही कफपित्तहा ।\nतद्वत्सर्वगुणाढ्यश्च कलायश्चातिवातलः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005986008, "chapter_id": 25986, "verse_number": "१-१६९-९", "content_sanskrit": "आग्की कफपित्तघ्नो शुक्रला च तथा स्मृता ।\nअतसी पित्तला ज्ञेया सिद्धार्थः कफवातजित् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005986009, "chapter_id": 25986, "verse_number": "१-१६९-१०", "content_sanskrit": "सक्षारमधुरस्निग्धो बलोष्णपित्तकृत्तिलः ।\nबलघ्ना रूक्षलाः शीता विविधाः सस्यजातयः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005986010, "chapter_id": 25986, "verse_number": "१-१६९-११", "content_sanskrit": "चित्रकेङ्गुदिनालीकाः पिप्पलीमधुशिग्रवः ।\nचव्याचरणनिर्गुण्डीतर्कारीकाशमर्दकाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005986011, "chapter_id": 25986, "verse_number": "१-१६९-१२", "content_sanskrit": "सबिल्वाः कफपित्तघ्नाः क्रिमिघ्ना लघुदीका ।\nवर्षाभूमार्करौ वातकफघ्नौ दोषनाशनौ ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005986012, "chapter_id": 25986, "verse_number": "१-१६९-१३", "content_sanskrit": "तिक्तरसः स्यादेरण्डः काकमाची त्रिदोषहृत् ।\nचाङ्गेरी कफवातघ्नी सर्षपः सर्वदोषदम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005986013, "chapter_id": 25986, "verse_number": "१-१६९-१४", "content_sanskrit": "तद्वदेव च कौस्मसुम्भं राजिका वातपितला ।\nनाडीचः कफपित्तघ्नः चुचुर्मधुरशीतलः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005986014, "chapter_id": 25986, "verse_number": "१-१६९-१५", "content_sanskrit": "दोषघ्नं पद्मपत्रञ्च त्रिपुटं वातकृत्परम। ।\nसक्षारः सर्वदोषघ्नो वास्तुको रोचनः परः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005986015, "chapter_id": 25986, "verse_number": "१-१६९-१६", "content_sanskrit": "तण्डुकीयोविपहरः पालङ्क्याश्च तथापरे ।\nमूलकं दोषकृच्छामं स्विन्नं वातकफापदम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005986016, "chapter_id": 25986, "verse_number": "१-१६९-१७", "content_sanskrit": "सर्वदोषहरं ह्यद्यं कण्ठ्यं तत्पक्वमिषते ।\nकर्कोटकं सवार्ताकं पदोलं कारवेल्लकम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005986017, "chapter_id": 25986, "verse_number": "१-१६९-१८", "content_sanskrit": "कुष्ठमेहज्वरश्वासकासपित्तकफापहम् ।\nसर्वदोषहरं हृद्यं कूष्माण्डं बस्तिशोधनम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005986018, "chapter_id": 25986, "verse_number": "१-१६९-१९", "content_sanskrit": "कलिङ्गालाबुनी पित्तनाशिनी वातकारिणी ।\nत्रपुषोर्वारुके वातश्लेष्मले पित्तवारणे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005986019, "chapter_id": 25986, "verse_number": "१-१६९-२०", "content_sanskrit": "वृक्षाम्लं कफवातघ्नं जम्बीरं कफवातनुत् ।\nवातघ्नं दाडिमं ग्राहि नागरङ्गफलं गुरु ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005986020, "chapter_id": 25986, "verse_number": "१-१६९-२१", "content_sanskrit": "केशरं मातुलुङ्गं च दीपनं कफवातनुत् ।\nवातपित्तहरो माषस्त्वक्स्निग्धोष्णानिलापहः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005986021, "chapter_id": 25986, "verse_number": "१-१६९-२२", "content_sanskrit": "सरमामलकं वृष्यं मधुरं हृद्यमम्लकृत् ।\nभुक्तप्ररोचका पुण्या हरीतक्यमृतोपमा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005986022, "chapter_id": 25986, "verse_number": "१-१६९-२३", "content_sanskrit": "स्त्रंसनी कफवातघ्नी ह्यक्षस्तद्वत्त्रिदोषजित् ।\nवातश्लेष्महरं त्वम्लं स्त्रंसनं तिन्तिडीफलम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005986023, "chapter_id": 25986, "verse_number": "१-१६९-२४", "content_sanskrit": "दोषलं लकुचं स्वादु बकुलं कफवातजित् ।\nगुल्मवातकफश्वासकासघ्नं बीजपूरकम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005986024, "chapter_id": 25986, "verse_number": "१-१६९-२५", "content_sanskrit": "कपित्थं ग्राहि दोषघ्नं पक्वं गुरु विषापम ।\nकफपित्तकरं बालमापूर्णं पित्तवर्धनम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005986025, "chapter_id": 25986, "verse_number": "१-१६९-२६", "content_sanskrit": "पक्वाम्रं वातकृन्मांसशुक्रवर्णबलप्रदम् ।\nवातघ्नं कफपित्तघ्नं ग्राहि विष्टम्भि जाम्बवम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005986026, "chapter_id": 25986, "verse_number": "१-१६९-२७", "content_sanskrit": "तिन्दुकं कफवातघ्नं बदरं वातपित्तहृत् ।\nविष्टम्भि वातलं बिल्वं प्रियालं पवनापहम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005986027, "chapter_id": 25986, "verse_number": "१-१६९-२८", "content_sanskrit": "राजादनफलं मोचं पनसं नारिकेलजम् ।\nशुक्रमांसकराण्याहुः स्वादुस्निग्धगुरूणि च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005986028, "chapter_id": 25986, "verse_number": "१-१६९-२९", "content_sanskrit": "द्राक्षामधूकखर्जूरं कुङ्कुमं वातरक्तजित् ।\nमागधी मधुरा पक्वा श्वासपित्तहरा परा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005986029, "chapter_id": 25986, "verse_number": "१-१६९-३०", "content_sanskrit": "आर्द्रकं रोचकं वृष्यं दीपनं कफवातहत ।\nशुण्ठीमरिचपिप्पल्यः कफवातजितो मताः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005986030, "chapter_id": 25986, "verse_number": "१-१६९-३१", "content_sanskrit": "अवृष्यं मरिचं विद्यादिति वैद्यकसंमतम् ।\nगुल्मशूलविबन्धघ्नं हिङ्गुवातकफापहम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005986031, "chapter_id": 25986, "verse_number": "१-१६९-३२", "content_sanskrit": "यवानीधन्यकाजाज्यः वातश्लेष्मनुदः परम् ।\nचक्षुष्यं सैन्धवं वृष्यं त्रिदोषशमनं स्मृतम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005986032, "chapter_id": 25986, "verse_number": "१-१६९-३३", "content_sanskrit": "सौवर्चलं विबन्धघ्नमुष्णं हृच्छूलनाशनम् ।\nउष्णं शूलहरं तीक्ष्णं विडङ्गं वातनाशनम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005986033, "chapter_id": 25986, "verse_number": "१-१६९-३४", "content_sanskrit": "रोमकं वातलं स्वादु रोचनं क्लेदनं गुरु ।\nहृत्पाण्डुगलरोगघ्नं यवक्षारोऽग्निदीपनः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005986034, "chapter_id": 25986, "verse_number": "१-१६९-३५", "content_sanskrit": "दहनो दीपनस्तीक्ष्णः सर्जिक्षारो विदारणः ।\nदोषघ्नं नाभसं वारिलघु हृद्यं विषापहम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005986035, "chapter_id": 25986, "verse_number": "१-१६९-३६", "content_sanskrit": "नादेयं वातलं रूक्षं सारसं मदुर लघु ।\nवातश्लेष्महरं वार्प्यं ताडागं वातलं स्मृतम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005986036, "chapter_id": 25986, "verse_number": "१-१६९-३७", "content_sanskrit": "रौच्यमग्निकरं रूक्षं कफघ्नंलघु नैर्झरम। ।\nदीपनं पित्तलं कौपमौद्भिदं पित्तनाशनम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005986037, "chapter_id": 25986, "verse_number": "१-१६९-३८", "content_sanskrit": "दिवार्ककिरणैर्जुष्टं रात्रौ चैवेन्दुरश्मिभिः ।\nसर्वदोषविनिर्मुक्तं तत्तुल्यं गगनाम्बुना ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005986038, "chapter_id": 25986, "verse_number": "१-१६९-३९", "content_sanskrit": "उष्णं वारि ज्वरश्वासमेदोऽनिलकफापहम् ।\nशृतं शीतत्रिदोषघ्नमुषितं तच्च दोषलम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005986039, "chapter_id": 25986, "verse_number": "१-१६९-४०", "content_sanskrit": "गोक्षीरं वातपित्तग्नं स्निग्धं गुरुरसायनम् ।\nगव्याद्गुरुतरं स्निग्धं माहिष्वह्निनाशनम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005986040, "chapter_id": 25986, "verse_number": "१-१६९-४१", "content_sanskrit": "छागं रक्तातिसारघ्नं कासश्वासकफापहम् ।\nचक्षुष्यं जीवनं स्त्रीणां रक्तपित्ते चनावनम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005986041, "chapter_id": 25986, "verse_number": "१-१६९-४२", "content_sanskrit": "परं वातहरं वृष्यं पित्तश्लेष्मकरं दधि ।\nदोषघ्नं मन्थजातन्तु मस्तु स्रोतोविशोधनम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005986042, "chapter_id": 25986, "verse_number": "१-१६९-४३", "content_sanskrit": "ग्रहण्यर्शोऽर्दितार्तिघ्नं नवनीतं नवोदधतम् ।\nविकाराश्च किलाटाद्या गुरवः कुष्ठहेतवः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005986043, "chapter_id": 25986, "verse_number": "१-१६९-४४", "content_sanskrit": "परं ग्रहणीशोथार्शः पाण्ड्वतीसारगुल्मनुत। ।\nत्रिदोषशमनं तक्रं कथितं पूर्वसूरिभिः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005986044, "chapter_id": 25986, "verse_number": "१-१६९-४५", "content_sanskrit": "वृष्यञ्च मधुरं सर्पिर्वातपित्तकफापहम् ।\nगव्यं मेध्यञ्च चाक्षुष्यं संस्काराच्च त्रिदोषजित् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005986045, "chapter_id": 25986, "verse_number": "१-१६९-४६", "content_sanskrit": "अपस्मारगदोन्मादमूर्छाघ्नं संस्कृतङ्घृतम् ।\nअजादीनाञ्च सर्पोषि विद्याद्गोक्षीरसद्गुणै। ।\nकफवातहरं मूत्रं सर्वक्रिमिविषापहम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005986046, "chapter_id": 25986, "verse_number": "१-१६९-४७", "content_sanskrit": "पाण्डुत्वोदरकुष्ठार्शः शोथगुल्मप्रमेहनुत् ।\nवातश्लेष्महरं बल्यं तैलं कश्यं तिलोद्भवम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005986047, "chapter_id": 25986, "verse_number": "१-१६९-४८", "content_sanskrit": "सार्षपं कृमिपाण्डुघ्नं कफमेदोऽनिलापहम् ।\nक्षौमं तैलमचक्षुष्यं पित्तहृद्वातनाशनम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005986048, "chapter_id": 25986, "verse_number": "१-१६९-४९", "content_sanskrit": "अक्षजं कफपित्तघ्नं केश्यं त्वक्श्रोत्रतर्पणम् ।\nत्रिदोषघ्नं मधु प्रोक्तं वातलञ्च प्रकीर्तितम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005986049, "chapter_id": 25986, "verse_number": "१-१६९-५०", "content_sanskrit": "हिक्काश्वासकृमिच्छर्दिमेहतृष्णाविषामहम् ।\nइक्षवोरक्तपित्तघ्नो बल्या वृष्याः कफप्रदाः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005986050, "chapter_id": 25986, "verse_number": "१-१६९-५१", "content_sanskrit": "फाणितं पित्तलं तव्रिं सुरा मत्स्यण्डिका लघुः ।\nखण्डं वृष्यं तथा स्निग्धं स्वाद्वसृक्पित्तवातजित् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005986051, "chapter_id": 25986, "verse_number": "१-१६९-५२", "content_sanskrit": "वातपित्तहरो रूक्षो वातघ्नः कफकृद्गुडः ।\nस पित्तघ्नः परः पथ्यः पुराणोऽसृक्प्रसादनः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005986052, "chapter_id": 25986, "verse_number": "१-१६९-५३", "content_sanskrit": "रक्तिपित्तहरा वृष्या सस्नेहा गडशर्करा ।\nसर्वपित्तकरं मद्यमम्लत्वात्कफवातजित् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005986053, "chapter_id": 25986, "verse_number": "१-१६९-५४", "content_sanskrit": "रक्तपित्तकरास्तीक्ष्णास्तथा सौवीरजातयः ।\nपाचनो दीपनः पथ्यो मण्डः स्याद्भृष्टतण्डुलः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005986054, "chapter_id": 25986, "verse_number": "१-१६९-५५", "content_sanskrit": "वातानुलोमनी लघ्वी पेया वस्तिविशोधनी ।\nसतक्रदाडिमव्योषा सगुडा मधुपिप्पली ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005986055, "chapter_id": 25986, "verse_number": "१-१६९-५६", "content_sanskrit": "इन्तीयं सुकृता पेया कासश्वा सप्रवाहिका। ।\nपायसः कफकृद्बल्यः कृशरा वातनाशिनी ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005986056, "chapter_id": 25986, "verse_number": "१-१६९-५७", "content_sanskrit": "सुधौतः प्रस्त्रुतः स्निग्धः सुखोष्णलघुरोचनः ।\nकन्दमूलफलेहैः साधितो बृंहणोगुरुः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005986057, "chapter_id": 25986, "verse_number": "१-१६९-५८", "content_sanskrit": "ईषदुष्णसेवनाच्च लघुः सूपः सुसाधितः ।\nस्विन्न निष्पीडितं शाकं हितं स्नेहादिसंस्कृतम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005986058, "chapter_id": 25986, "verse_number": "१-१६९-५९", "content_sanskrit": "दाडिमामलकैर्यूषो वह्निकृद्वातपित्तहा ।\nश्वासकासप्रतिश्यायकफघ्नो मलकैः कृतः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7005986059, "chapter_id": 25986, "verse_number": "१-१६९-६०", "content_sanskrit": "यवकोलकुलत्थानां यूषः कण्ठ्योऽनिलापहः ।\nमुद्गामलकजो ग्राही श्लेष्मपित्तविनाशनः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7005986060, "chapter_id": 25986, "verse_number": "१-१६९-६१", "content_sanskrit": "सगुडं दधि वातघ्नं सक्तवो रूक्षवातुलाः ।\nघृतपूर्णोऽग्निकारी स्याद्वृष्या गुर्वो च शष्कुली ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7005986061, "chapter_id": 25986, "verse_number": "१-१६९-६२", "content_sanskrit": "बृंहणाः सामिषा भक्ष्यपिष्ट का गुखः स्मृताः ।\nतैलसिद्धाश्च दृष्टिघ्नास्तोयस्विन्नाश्च दुर्जराः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7005986062, "chapter_id": 25986, "verse_number": "१-१६९-६३", "content_sanskrit": "अत्युष्णा मण्डकाः पथ्याः शीतला गुखो मता। ।\nअनुपानञ्च पानीयं श्रमतृष्णादिनाशनम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7005986063, "chapter_id": 25986, "verse_number": "१-१६९-६४", "content_sanskrit": "अन्नपानादिना रक्षा कृत्स्याद्रोगवर्जितः ।\nअनुष्णः शिखिकण्ठाभो विषञ्चैव विवर्णकृत् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7005986064, "chapter_id": 25986, "verse_number": "१-१६९-६५", "content_sanskrit": "गन्धस्पर्शरसास्तीव्राभोक्तुश्च स्यान्मनोव्यथा ।\nआघ्राणे चाक्षिरोगः स्यादसाध्यश्च भिषग्वरैः ।\nवेपथुर्जृम्भणाद्यं स्याद्विषस्यैतत्तु लक्षणम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]