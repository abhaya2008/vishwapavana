[{"id": 2018011, "chapter_id": 1374, "verse_number": "३-१२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2018012, "chapter_id": 1374, "verse_number": "३-१२-१", "content_sanskrit": "भोजाः प्रव्रजिताञ्श्रुत्वा वृष्णयश्चान्धकैः सह।\nपाण्डवान्दुःखसंतप्तान्समाजग्मुर्महावने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2018013, "chapter_id": 1374, "verse_number": "३-१२-२", "content_sanskrit": "पाञ्चालस्य च दायादो धृष्टकेतुश्च चेदिपः।\nकेकयाश्च महावीर्या भ्रातरो लोकविश्रुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2018014, "chapter_id": 1374, "verse_number": "३-१२-३", "content_sanskrit": "वने द्रष्टुं ययुः पार्थान्क्रोधामर्षसमन्विताः।\nगर्हयन्तो धार्तराष्ट्रान्किं कुर्म इति चाब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2018015, "chapter_id": 1374, "verse_number": "३-१२-४", "content_sanskrit": "वासुदेवं पुरस्कृत्य सर्वे ते क्षत्रियर्षभाः।\nपरिवार्योपविविशुर्धर्मराजं युधिष्ठिरम्।\nअभिवाद्य कुरुश्रेष्ठं विषण्णः केशवोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2018016, "chapter_id": 1374, "verse_number": "३-१२-५x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2018017, "chapter_id": 1374, "verse_number": "३-१२-५", "content_sanskrit": "दुर्योधनस्य कर्णस् शकुनेश्च दुरात्मनः।\nदुःशासनचतुर्थानां भूमिः पास्यति शोणितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2018018, "chapter_id": 1374, "verse_number": "३-१२-६", "content_sanskrit": "एतान्निहत्य समरे ये च तेषां पदानुगाः।\nतांश्च सर्वान्विनिर्जित्य सहितान्स नराधिपान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2018019, "chapter_id": 1374, "verse_number": "३-१२-७", "content_sanskrit": "ततः सर्वेऽभिषिञ्चामो धर्मराजं युधिष्ठिरम्।\nनिकृत्याऽभिचरन्वध्य एष धर्मः सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2018020, "chapter_id": 1374, "verse_number": "३-१२-८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2018021, "chapter_id": 1374, "verse_number": "३-१२-८", "content_sanskrit": "पार्तानामभिषङ्गेण तथा क्रुद्धं जनार्दनम्।\nअर्जुनः शमयामास दिधक्षन्तमिव प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2018022, "chapter_id": 1374, "verse_number": "३-१२-९", "content_sanskrit": "संक्रुद्धं केशवं दृष्ट्वा पूर्वदेवेषु फल्गुनः।\nकीर्तयामास कर्माणि सत्यकीर्तेर्महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2018023, "chapter_id": 1374, "verse_number": "३-१२-१०", "content_sanskrit": "पुरुषस्याप्रमेयस्य सत्यस्यामिततेजसः।\nप्रजापतिपतेर्विष्णोर्लोकनाथस्य धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2018024, "chapter_id": 1374, "verse_number": "३-१२-११x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2018025, "chapter_id": 1374, "verse_number": "३-१२-११", "content_sanskrit": "दशवर्षसहस्राणि यत्रसायंगृहो मुनिः।\nव्यचरस्त्वं पुरा कृष्ण पर्वते गन्धमादने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2018026, "chapter_id": 1374, "verse_number": "३-१२-१२", "content_sanskrit": "दशवर्षसहस्राणि दशवर्षशतानि च।\nपुष्करेष्ववसः कृष्णं त्वमपो भक्षयन्पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2018027, "chapter_id": 1374, "verse_number": "३-१२-१३", "content_sanskrit": "ऊर्ध्वबाहुर्विशालायां बदर्यां मधुसूदन।\nअतिष्ठ एकपादेन वायुभक्षः शतं समाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2018028, "chapter_id": 1374, "verse_number": "३-१२-१४", "content_sanskrit": "कृष्णाजिनोत्तरासङ्गः कृशो धमनिसंततः।\nआसीः कृष्ण सरस्वत्यां सत्रेद्वादशवार्षिके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2018029, "chapter_id": 1374, "verse_number": "३-१२-१५", "content_sanskrit": "प्रभासभप्यथासाद्य तीर्थं पुण्यजनार्चितम्।\nतत्र कृष्ण महातेजा दिव्यं वर्षसहस्रकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2018030, "chapter_id": 1374, "verse_number": "३-१२-१६", "content_sanskrit": "आतिष्ठस्त्वमथैकेन पादेन नियमस्थितः।\nलोकप्रवृत्तिहेतोस्त्वमिति व्यासो ममाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2018031, "chapter_id": 1374, "verse_number": "३-१२-१७", "content_sanskrit": "क्षेत्रज्ञः सर्वभूतानामादिरन्तश्च केशवं।\nनिधानं तपसां कृष्ण यज्ञस्त्वं च सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2018032, "chapter_id": 1374, "verse_number": "३-१२-१८", "content_sanskrit": "`योगकर्ता हृषीकेशः सांख्यकर्ता सनातनः।\nशीलस्त्वं सर्वयोगानां करणं नियमस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2018033, "chapter_id": 1374, "verse_number": "३-१२-१९", "content_sanskrit": "निहत्य नरकं भौममाहृत्य मणिकुण्डले।\nप्रथमोत्पादितं कृष्ण मेध्यमश्वमवासृजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2018034, "chapter_id": 1374, "verse_number": "३-१२-२०", "content_sanskrit": "कृत्वातत्कर्म लोकानामृषभः सर्वलोकजित्।\nअवधीस्त्वं रणे सर्वान्समेतान्दैत्यदानवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2018035, "chapter_id": 1374, "verse_number": "३-१२-२१", "content_sanskrit": "ततः सर्वेश्वरत्वं च संप्रदाय शचीपतेः।\nमानुषेषु महाबाहो प्रादुर्भूतोऽसि केशव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2018036, "chapter_id": 1374, "verse_number": "३-१२-२२", "content_sanskrit": "स त्वं नारायणो भूत्वा हरिरासीः परंतप।\nब्रह्मा सोमश्च सूर्यश्च धर्मो धाता यमोऽनलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2018037, "chapter_id": 1374, "verse_number": "३-१२-२३", "content_sanskrit": "वायुर्वैश्रवणो रुद्रः कालः खं पृथिवी दिशः।\nअजश्चराचरगुरुः स्रष्टा त्वं पुरुषोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2018038, "chapter_id": 1374, "verse_number": "३-१२-२४", "content_sanskrit": "तुरायणादिभिर्देव क्रतुभिर्भूरदक्षिणैः।\nअयजो भूरितेजा वै कृष्ण चैत्ररथे वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2018039, "chapter_id": 1374, "verse_number": "३-१२-२५", "content_sanskrit": "शतं शतसहस्राणि सुवर्णस्य जनार्दन।\nएकैकस्मिंस्तदा यज्ञे परिपूर्णानि दत्तवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2018040, "chapter_id": 1374, "verse_number": "३-१२-२६", "content_sanskrit": "अदितेरपि पुत्रत्वमेत्य यादवनन्दन।\nत्वं विष्णुरिति विख्यात इन्द्रादवरजो विभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2018041, "chapter_id": 1374, "verse_number": "३-१२-२७", "content_sanskrit": "शिशुर्भूत्वा दिवं खं च पृथिवीं च परंतप।\nत्रिभिर्विक्रमणैः कृष्ण क्रान्तवानसि तेजसा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2018042, "chapter_id": 1374, "verse_number": "३-१२-२८", "content_sanskrit": "संप्राप्य दिवमाकाशमादित्यस्यन्दने स्थितः।\nअत्यरोचश्च भूतात्मन्भास्करं स्वेन तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2018043, "chapter_id": 1374, "verse_number": "३-१२-२९", "content_sanskrit": "प्रादुर्भावसहस्रेषु तेषुतेषु त्वया विभो।\nअधर्मरुचयः कृष्ण निहताः शतशोऽसुराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2018044, "chapter_id": 1374, "verse_number": "३-१२-३०", "content_sanskrit": "सादिता मौखाः पाशा निशुम्भनरकौ हतौ।\nकृतः क्षेमः पुनः पन्थाः पुरं प्राग्ज्योतिषं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2018045, "chapter_id": 1374, "verse_number": "३-१२-३१", "content_sanskrit": "जारूथ्यामाहुतिः क्राथः शिशुपालो नृपैः सह।\nजरासन्धश्च शैब्यश्च शतधन्वा च निर्जितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2018046, "chapter_id": 1374, "verse_number": "३-१२-३२", "content_sanskrit": "तथा पर्जन्यघोषेण रथेनादित्यवर्चसा।\nअहार्षी रुक्मिणीं भैष्मीं रणे निर्जित्य रुक्मिणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2018047, "chapter_id": 1374, "verse_number": "३-१२-३३", "content_sanskrit": "इन्द्रद्युम्नो हतः कोपाद्यवनश्च कशेरुमान्।\nहतः सौभपतिः साल्वस्त्वया सौभं च पातितम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2018048, "chapter_id": 1374, "verse_number": "३-१२-३४", "content_sanskrit": "एवमेते युधि हता भूयश्चान्याञ्शृमुष्व ह।\nइरावत्यां हतो भोजः कार्तवीर्यसमो युधि।\nगोपतिस्तालकेतुश्च त्वया विनिहतावुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2018049, "chapter_id": 1374, "verse_number": "३-१२-३५", "content_sanskrit": "तां च भोगवतीं पुण्यामृषिकान्तां जनार्दन।\nद्वारकामात्मसात्कृत्वा समुद्रं गमयिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2018050, "chapter_id": 1374, "verse_number": "३-१२-३६", "content_sanskrit": "न क्रोधो न च मात्सर्यं नानृतं मधुसूदन।\nत्वयि तिष्ठति दाशार्ह न नृशंस्यं कुतोऽनृजु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2018051, "chapter_id": 1374, "verse_number": "३-१२-३७", "content_sanskrit": "आसीनं चैत्यमध्ये त्वां दीप्यमानं स्वतेजसा।\nआगम्य ऋषयः सर्वेऽयाचन्ताभयमच्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2018052, "chapter_id": 1374, "verse_number": "३-१२-३८", "content_sanskrit": "युगान्ते सर्वभूतानि संक्षिप्य मधुसूदन।\nआत्मनैवात्मसात्कृत्वा जगदासीः परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2018053, "chapter_id": 1374, "verse_number": "३-१२-३९", "content_sanskrit": "युगादौ तव वार्ष्णेय नाभिपद्मादजायत।\nब्रह्मा चराचरगुरुर्यस्येदं सकलं जगत्।\nतं हन्तुमुद्यतौ घोरौ दानवौ मधुकैटभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2018054, "chapter_id": 1374, "verse_number": "३-१२-४०", "content_sanskrit": "तयोर्व्यतिक्रमं दृष्ट्वा क्रुद्धस्य भवतो हरेः।\nललाटाज्जातवाञ्शंभुः शूलपाणिस्त्रिलोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2018055, "chapter_id": 1374, "verse_number": "३-१२-४१", "content_sanskrit": "इत्थं तावपि देवेशौ त्वच्छरीरसमुद्भवौ।\nत्वन्नियोगकरावेताविति मे नारदोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2018056, "chapter_id": 1374, "verse_number": "३-१२-४२", "content_sanskrit": "तथा नारायण पुरा क्रतुभिर्भूरिदक्षिणैः।\nइष्टवांस्त्वं महासत्रं कृष्ण चैत्ररथे वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2018057, "chapter_id": 1374, "verse_number": "३-१२-४३", "content_sanskrit": "नैवं परे नापरे वा करिष्यन्ति कृतानि वा।\nयानि कर्माणि देव त्वं बाल एव महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2018058, "chapter_id": 1374, "verse_number": "३-१२-४४", "content_sanskrit": "कृतवान्पुण्डरीकाक्ष बलदेवसहायवान्।\nवैराजभवने चापि ब्रह्मणा न्यवसः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2018059, "chapter_id": 1374, "verse_number": "३-१२-४५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2018060, "chapter_id": 1374, "verse_number": "३-१२-४५", "content_sanskrit": "एवमुक्त्वा महात्मानमात्मा कृष्णस्य पाण्डवः।\nतूष्णीमासीत्ततः पार्थमित्युवाच जनार्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2018061, "chapter_id": 1374, "verse_number": "३-१२-४६", "content_sanskrit": "ममैव त्वं तवैवाहं ये मदीयास्तवैव ते।\nयस्त्वां द्वेष्टि स मां द्वेष्टि यस्त्वामनु स मामनु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2018062, "chapter_id": 1374, "verse_number": "३-१२-४७", "content_sanskrit": "नरस्त्वमसि दुर्धर्ष हरिर्नारायणो ह्यहम्।\nकाले लोकमिमं प्राप्तौ नरनारायणावृषी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2018063, "chapter_id": 1374, "verse_number": "३-१२-४८", "content_sanskrit": "अनन्यः पार्थ मत्तस्त्वं त्वत्तश्चाहं तथैव च।\nनावयोरन्तरं शक्यं वेदितुं भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2018064, "chapter_id": 1374, "verse_number": "३-१२-४९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2018065, "chapter_id": 1374, "verse_number": "३-१२-४९", "content_sanskrit": "`इत्युक्त्वा पुण्डरीकाक्षः पाण्डवं सुप्रियं वचः।\nप्रीयमाणो हृषीकेशस्तूष्णीं तत्र बभूव सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2018066, "chapter_id": 1374, "verse_number": "३-१२-५०", "content_sanskrit": "एवमुक्ते तु वचने केशेवेन महात्मना।\nतस्मिन्वीरसमावाये संरब्धेष्वथ राजसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2018067, "chapter_id": 1374, "verse_number": "३-१२-५१", "content_sanskrit": "धृष्टद्युम्नमुखैर्वीरैर्भ्रातृभिः परिवारिता।\nपाञ्चाली पुण्डरीकाक्षमासीनं यादवैः सह।\nअभिगम्याब्रवीत्कृष्णा शरण्यं शरणैषिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2018068, "chapter_id": 1374, "verse_number": "३-१२-५२x", "content_sanskrit": "द्रौपद्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2018069, "chapter_id": 1374, "verse_number": "३-१२-५२", "content_sanskrit": "`वासुदेव हृषीकेश वासवावरजाच्युत।\nदेवदेवोसि देवानामिति द्वैपायनोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2018070, "chapter_id": 1374, "verse_number": "३-१२-५३", "content_sanskrit": "पूर्वे प्रजाभिसर्गे त्वामाहुरेकं प्रजापतिम्।\nस्रष्टारं सर्वलोकानामसितो देवलोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2018071, "chapter_id": 1374, "verse_number": "३-१२-५४", "content_sanskrit": "विष्णुस्त्वमसि दुर्धर्ष त्वं यज्ञो मधुसूदन।\nयष्टात्वमसि त्वमसि यष्टव्यो जामदग्न्यो यथाऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2018072, "chapter_id": 1374, "verse_number": "३-१२-५५", "content_sanskrit": "ऋषयस्त्वां क्षमामाहुः सत्यं च परुषोत्तम।\nसत्याद्यज्ञोसि संभूतः कश्यपस्त्वां यथाऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2018073, "chapter_id": 1374, "verse_number": "३-१२-५६", "content_sanskrit": "साध्यानामपि देवानां शिवानामीश्वरेश्वर।\nलोकभावन लोकेश यथा त्वां नारदोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2018074, "chapter_id": 1374, "verse_number": "३-१२-५७", "content_sanskrit": "ब्रह्मशंकरशक्राद्यैर्देववृन्दैः पुनः पुनः।\nक्रीडसे त्वं नरव्याघ्र बालः क्रीडनकैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2018075, "chapter_id": 1374, "verse_number": "३-१२-५८", "content_sanskrit": "द्यौश्च ते शिरसा व्याप्ता पद्भ्यां च पृथिवीप्रभो।\nजठरे खमिमे लोकाः पुरुषोसि सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2018076, "chapter_id": 1374, "verse_number": "३-१२-५९", "content_sanskrit": "विद्यातपोभितप्तानां तपसा भावितात्मनाम्।\nआत्मदर्शनतृप्तानामृषीणामसि सत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2018077, "chapter_id": 1374, "verse_number": "३-१२-६०", "content_sanskrit": "राजर्षीणां पुण्यकृतामाहवेष्वनिवर्तिनाम्।\nसर्वधर्मोपपन्नानां त्वं गतिः पुरुषर्षभ।\nत्वं प्रभुस्त्वं विभुश्च त्वं भूतात्मा त्वं विचेष्टसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2018078, "chapter_id": 1374, "verse_number": "३-१२-६१", "content_sanskrit": "लोकपालाश्च लोकाश्च नक्षत्राणि दिशे दश।\nनभश्चन्द्रश्च सूर्यश्च त्वयि सर्वं प्रतिष्ठितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2018079, "chapter_id": 1374, "verse_number": "३-१२-६२", "content_sanskrit": "मंर्त्यता चैव भूतानाममरत्वं दिवौकसाम्।\nत्वयि सर्वं महाबाहो लोककार्यं प्रतिष्ठितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2018080, "chapter_id": 1374, "verse_number": "३-१२-६३", "content_sanskrit": "सा तेऽहं दुःखमाख्यास्ये प्रणयान्मधुसूदन।\nईशस्त्वं सर्वभूतानां ये दिव्या ये च मानुषाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2018081, "chapter_id": 1374, "verse_number": "३-१२-६४", "content_sanskrit": "कथं नु भार्या पार्थानां तव कृष्ण सखी विभो।\nधृष्टद्युम्नस्य भगिनी सभां कृष्येत मादृशी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2018082, "chapter_id": 1374, "verse_number": "३-१२-६५", "content_sanskrit": "स्त्रीधर्मिणी वेपमाना शोणितेन समुक्षिता।\nएकवस्त्रा विकृष्टाऽस्मि दुःखिता कुरुसंसदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2018083, "chapter_id": 1374, "verse_number": "३-१२-६६", "content_sanskrit": "राज्ञां मध्ये सभायां तु रजसाऽतिपरिप्लुता।\nदृष्ट्वा च मां धार्तराष्ट्राः प्राहसन्पापचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2018084, "chapter_id": 1374, "verse_number": "३-१२-६७", "content_sanskrit": "दासीभावेन मां भोक्तुमीष्सुते मधुसूदन।\nजीवत्सु पाण्डुपुत्रेषु पाञ्चालेषु च वृष्णिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2018085, "chapter_id": 1374, "verse_number": "३-१२-६८", "content_sanskrit": "नन्वहं कृष्ण भीष्मस्य धृतराष्ट्रस्य चोभयोः।\nस्नुषा भवामि धर्मेण साऽहं दासीकृता बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2018086, "chapter_id": 1374, "verse_number": "३-१२-६९", "content_sanskrit": "गर्हयेपाण्डवांस्त्वेव युधि श्रेष्ठान्महाबलान्।\nयत्क्लिश्यमानां प्रेक्षन्ते धर्मपत्नीं यशस्विनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2018087, "chapter_id": 1374, "verse_number": "३-१२-७०", "content_sanskrit": "धिग्बलं भीमसेनस्य धिक्पार्थस् च गाण्डिवम्।\nयौ मां विप्रकृतां क्षुद्रैर्मर्षयेतां जनार्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2018088, "chapter_id": 1374, "verse_number": "३-१२-७१", "content_sanskrit": "शाश्वतोऽयं धर्मपथः सद्भिराचरितः सदा।\nयद्भार्यां परिरक्षन्ति भर्तारोऽल्पबला अपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2018089, "chapter_id": 1374, "verse_number": "३-१२-७२", "content_sanskrit": "भार्यायां रक्ष्यमाणायां प्रजा भवति रक्षिता।\nप्रजायां रक्ष्यमाणायामात्मा भवति रक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2018090, "chapter_id": 1374, "verse_number": "३-१२-७३", "content_sanskrit": "आत्मा हि जायेत तस्यां तस्मज्जाया भवत्युत।\nभर्ता च भार्यया रक्ष्यः कथं जायान्ममोदरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2018091, "chapter_id": 1374, "verse_number": "३-१२-७४", "content_sanskrit": "नन्विमे शरणं प्राप्तं न त्यजन्ति कदाचन।\nते मां शरणमापन्नां नान्वपद्यन्त पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2018092, "chapter_id": 1374, "verse_number": "३-१२-७५", "content_sanskrit": "पञ्चभिः पतिभिर्जाताः कुमासरा मे महौजसः।\nएतेषामप्यवेक्षार्थं त्रातव्याऽस्मि जनार्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2018093, "chapter_id": 1374, "verse_number": "३-१२-७६", "content_sanskrit": "प्रतिविन्ध्यो युधिष्ठिरात्सुतसोमो वृकोदरात्।\nअर्जुनाच्छ्रुतकीर्तिश्च शतानीकस्तु नाकुलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2018094, "chapter_id": 1374, "verse_number": "३-१२-७७", "content_sanskrit": "कनिष्ठाच्छ्रुतकर्मा च सर्वे सत्यपराक्रमा।\nप्रद्युम्नो यादृशः कृष्ण तादृशास्ते महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2018095, "chapter_id": 1374, "verse_number": "३-१२-७८", "content_sanskrit": "नन्विमे धनुषि श्रेष्ठा अजेया युधि शात्रवैः।\nकिमर्थं धार्तराष्ट्राणां सहन्ते दुर्बलीयसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2018096, "chapter_id": 1374, "verse_number": "३-१२-७९", "content_sanskrit": "अधर्मेण हृतं राज्यं सर्वे दासाः कृतास्तथा।\nसभायां परिकृष्टाऽहमेकवस्त्रा रजस्वला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2018097, "chapter_id": 1374, "verse_number": "३-१२-८०", "content_sanskrit": "नाधिज्यमपि यच्छक्यं कर्तुमन्येन गाण्डिवम्।\nअन्यत्रार्जुनभीमाभ्यां त्वया वा मधुसूदन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2018098, "chapter_id": 1374, "verse_number": "३-१२-८१", "content_sanskrit": "धिग्बलं भीमसेनस्य धिक्पार्थस्य च पौरुषम्।\nयत्र दुर्योधनः कृष्ण मुहूर्तमपि जीवति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2018099, "chapter_id": 1374, "verse_number": "३-१२-८२", "content_sanskrit": "य एतानाक्षिपद्राष्टात्सह मात्राऽविहिंसकान्।\nअधीयानान्पुरा बालान्व्रतस्थान्मधुसूदन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2018100, "chapter_id": 1374, "verse_number": "३-१२-८३", "content_sanskrit": "भोजने भीमसेनस्य पापः प्राक्षिपयद्विषम्।\nकालकूटं नवं तीक्ष्णं संभृतं रोमहर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2018101, "chapter_id": 1374, "verse_number": "३-१२-८४", "content_sanskrit": "तज्जीर्णमविकारेण सहान्नेन जनार्दन।\nसशेषत्वान्महाबाहो भीमस्य पुरुषोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2018102, "chapter_id": 1374, "verse_number": "३-१२-८५", "content_sanskrit": "प्रमाणकोट्यां विश्वस्तं तथा सुप्तं वृकोदरम्।\nबद्ध्वैनं कृष्ण गङ्गायां प्रक्षिप्य पुरमाव्रजत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2018103, "chapter_id": 1374, "verse_number": "३-१२-८६", "content_sanskrit": "यदा विबुद्धः कौन्तेयस्तदा संछिद्य बन्धनम्।\nउदतिष्ठन्महाबाहुर्भीमसेनो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2018104, "chapter_id": 1374, "verse_number": "३-१२-८७", "content_sanskrit": "आशीविषैः कृष्णसर्पैः सुप्तंचैनमदंशयत्।\nसर्वेष्वेवाङ्गदेशेषु न ममार च शत्रुहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2018105, "chapter_id": 1374, "verse_number": "३-१२-८८", "content_sanskrit": "प्रतिबुद्धस्तु कौन्तेयः सर्वान्सर्पानपोथयत्।\nसारथिं चास्य दयितमपहस्तेन जघ्निवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2018106, "chapter_id": 1374, "verse_number": "३-१२-८९", "content_sanskrit": "पुनः सुप्तानुपाधाक्षीद्बालकान्वारणावते।\nशयानानार्यया सार्धं को नु तत्कर्तुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2018107, "chapter_id": 1374, "verse_number": "३-१२-९०", "content_sanskrit": "यत्रार्या रुदती भीता पाण्डवानिदमब्रवीत्।\nमहद्व्यसनमापन्ना शिखिना परिवारिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2018108, "chapter_id": 1374, "verse_number": "३-१२-९१", "content_sanskrit": "हा हतास्मि कुंतोन्वद्य भवेच्छान्तिरिहानलात्।\nअनाथा विनशिष्यामि बालकैः पुत्रकैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2018109, "chapter_id": 1374, "verse_number": "३-१२-९२", "content_sanskrit": "तत्र भीमो महाबाहुर्वायुवेगपराक्रमः।\nआर्यामाश्वासयामास भ्रातॄंश्चापि वृकोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2018110, "chapter_id": 1374, "verse_number": "३-१२-९३", "content_sanskrit": "वैनतेयो यथा पक्षी गरुत्मान्पततांवरः।\nतथैवाभिपतिष्यामि भयंवो नेह विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2018111, "chapter_id": 1374, "verse_number": "३-१२-९४", "content_sanskrit": "आर्यामङ्केन वामेन राजानं दक्षिणेन च।\nअंसयोश्च यमौ कृत्वा पृष्ठे बीभत्सुमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2018112, "chapter_id": 1374, "verse_number": "३-१२-९५", "content_sanskrit": "सहसोत्पत्य वेगेन सर्वानादाय वीर्यवान्।\nभ्रातॄनार्यां च बलवान्मोक्षयामास पावकात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2018113, "chapter_id": 1374, "verse_number": "३-१२-९६", "content_sanskrit": "ते रात्रौ प्रस्थितां सर्वे सह मात्रा यशस्विनः।\nअभ्यगच्छन्महारण्ये हिडिम्बवनमन्तिकात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2018114, "chapter_id": 1374, "verse_number": "३-१२-९७", "content_sanskrit": "श्रान्ताः प्रसुप्तास्तत्रेमे मात्रा सह सुदुःखिताः।\nसुप्तांश्चैनानभ्यगच्छद्धिडिम्बा नाम राक्षसी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2018115, "chapter_id": 1374, "verse_number": "३-१२-९८", "content_sanskrit": "सा दृष्ट्वा पाण्डवांस्तत्र सुप्तान्मात्रा सह क्षितौ।\nहृच्छयेनाभिभूतात्मा भीमसेनमकामयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2018116, "chapter_id": 1374, "verse_number": "३-१२-९९", "content_sanskrit": "भीमस्य पादौ कृत्वा तु स्वउत्सङ्गे ततोऽबला।\nपर्यमर्दत संहृष्टा कल्याणी मृदुपाणिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2018117, "chapter_id": 1374, "verse_number": "३-१२-१००", "content_sanskrit": "तामबुद्ध्यदमेयात्मा बलवान्सत्यविक्रमः।\nपर्यपृच्छत तां भीमः किमिहेच्छस्यनिन्दिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2018118, "chapter_id": 1374, "verse_number": "३-१२-१०१", "content_sanskrit": "एवमुक्ता तु भीमेन राक्षसी कामरूपिणी।\nभीमसेनं महात्मानमाह चैवमनिन्दिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2018119, "chapter_id": 1374, "verse_number": "३-१२-१०२", "content_sanskrit": "पलायध्वमितः क्षिप्रं मम भ्रातैष वीर्यवान्।\nआगमिष्यति वो हन्तुं तस्माद्गच्छत माचिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2018120, "chapter_id": 1374, "verse_number": "३-१२-१०३", "content_sanskrit": "अथ भीमोऽभ्युवाचैनां साभिमानमिदं वचः।\nनोद्विजेयमहं तस्मान्निहनिष्येऽहमागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2018121, "chapter_id": 1374, "verse_number": "३-१२-१०४", "content_sanskrit": "तयोः श्रुत्वा तु संजल्पमागच्छद्राक्षसाधमः।\nभीमरूपो महानादान्विसृजन्भीमदर्शनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2018122, "chapter_id": 1374, "verse_number": "३-१२-१०५x", "content_sanskrit": "राक्षस उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2018123, "chapter_id": 1374, "verse_number": "३-१२-१०५", "content_sanskrit": "केन सार्धं कथयसि आनयैनं ममान्तिकम्।\nहिडिम्बे भक्षयिष्यामो न चिरं कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2018124, "chapter_id": 1374, "verse_number": "३-१२-१०६", "content_sanskrit": "सा कृपासंगृहीतेन हृदयेन मनस्विनी।\nनैनमैच्छत्तदाकर्तुमनुक्रोशादनिन्दिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2018125, "chapter_id": 1374, "verse_number": "३-१२-१०७", "content_sanskrit": "स नादान्विनदन्घोरान्राक्षसः पुरुषादकः।\nअभ्यद्रवत वेगेन भीमसेनं तदा किल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2018126, "chapter_id": 1374, "verse_number": "३-१२-१०८", "content_sanskrit": "तमभिद्रुत्य संक्रुद्धो वेगेन महता बली।\nअगृह्णात्पाणिना पाणिं भीमसेनस्य राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2018127, "chapter_id": 1374, "verse_number": "३-१२-१०९", "content_sanskrit": "इन्द्राशनिसमस्पर्शं वज्रसंहननं दृढम्।\nसंहत्य भीमसेनाय व्याक्षिपत्सहसा करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2018128, "chapter_id": 1374, "verse_number": "३-१२-११०", "content_sanskrit": "गृहीतं पाणिना पाणिं भीमसेनस्य रक्षसा।\nनामृष्यत महाबाहुस्तत्राक्रुद्ध्यद्वृकोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2018129, "chapter_id": 1374, "verse_number": "३-१२-१११", "content_sanskrit": "तदासीत्तुमुलं युद्धं भीमसेनहिडिम्बयोः।\nसर्वास्त्रविदुषोर्घोरं वृत्रवासवयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2018130, "chapter_id": 1374, "verse_number": "३-१२-११२", "content_sanskrit": "विक्रीड्य सुचिरं भीमो राक्षसेन सहानघ।\nनिजघान महावीर्यस्तं तदा निर्बलं बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2018131, "chapter_id": 1374, "verse_number": "३-१२-११३", "content_sanskrit": "हत्वा हिडिम्बं भीमोऽथ प्रस्थितो भ्रातृभिः सह।\nहिडिम्बामग्रतः कृत्वा यस्यां जातो घटोत्कटः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2018132, "chapter_id": 1374, "verse_number": "३-१२-११४", "content_sanskrit": "ततः संप्राद्रवन्सर्वे सह मात्रा परंतपाः।\nएकचक्रामभिमुखाः संवृता ब्राह्मणव्रजैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2018133, "chapter_id": 1374, "verse_number": "३-१२-११५", "content_sanskrit": "प्रस्थाने व्यास एषां च मन्त्री प्रियहिते रतः।\nततोऽगच्छन्नेकचक्रां पाणअडवाः संशितव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2018134, "chapter_id": 1374, "verse_number": "३-१२-११६", "content_sanskrit": "तत्राप्यासादयामासुर्बकं नाम महाबलम्।\nपुरुषादं प्रतिभयं हिडिम्बेनैव संमितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2018135, "chapter_id": 1374, "verse_number": "३-१२-११७", "content_sanskrit": "तं चापि विनिहत्योग्रं भीमः प्रहरतां वरः।\nसहितो भ्रातृभिः सर्वैर्द्रुपदस्य पुरं ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2018136, "chapter_id": 1374, "verse_number": "३-१२-११८", "content_sanskrit": "लब्धाऽहमपि तत्रैव वसता सव्यसाचिना।\nयथा त्वया जिता कृष्णरुक्मिणी भीष्मकात्मजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2018137, "chapter_id": 1374, "verse_number": "३-१२-११९", "content_sanskrit": "एवं सुयुद्धे पार्थेन जिताऽहं मधुसूदन।\nस्वयंवरे महत्कर्म कृत्वा न सुकरं परैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2018138, "chapter_id": 1374, "verse_number": "३-१२-१२०", "content_sanskrit": "एवं क्लेशैः सुबहुभिः क्लिश्यमाना सुदुःखिता।\nनिवसाम्यार्यया हीना कृष्ण धौम्यपुरःसुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2018139, "chapter_id": 1374, "verse_number": "३-१२-१२१", "content_sanskrit": "त इमे सिंहविक्रान्ता वीर्येणाभ्यधिकाः परैः।\nनिहीनैः परिक्लिश्यन्ति समुपेक्षन्ति मां कथं।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2018140, "chapter_id": 1374, "verse_number": "३-१२-१२२", "content_sanskrit": "एतादृशानि दुःखानि महन्ती दुर्बलीयसाम्।\nदीर्घकालं प्रदीप्ताऽस्मि पापानां पापकर्मणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2018141, "chapter_id": 1374, "verse_number": "३-१२-१२३", "content_sanskrit": "कुले महतिजाताऽस्मि दिव्येन विधिना किल।\nपाण्डवानां प्रिया भार्या स्नुषा पाण्डोर्महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2018142, "chapter_id": 1374, "verse_number": "३-१२-१२४", "content_sanskrit": "केशग्रहमनुप्राप्ता का नु जीवेत मादृशी।\nपञ्चानामिन्द्रकल्पानां प्रेक्षतां मधुसूदन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2018143, "chapter_id": 1374, "verse_number": "३-१२-१२५", "content_sanskrit": "इत्युक्त्वा प्रारुदत्कृष्णा मुखं प्रच्छाद्य पाणिना।\nपद्मकोशप्रकाशेन मृदुना मृदुभाषिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2018144, "chapter_id": 1374, "verse_number": "३-१२-१२६", "content_sanskrit": "स्तनावपतितौ पीनौ सुजातौ शुभलक्षणौ।\nअभ्यवर्षत पाञ्चाली दुःखजैरश्रुबिन्दुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2018145, "chapter_id": 1374, "verse_number": "३-१२-१२७", "content_sanskrit": "चक्षुषी परिमार्जन्ती निःश्वसन्ती पुनःपुनः।\nबाष्पपूर्णेन कणअठेन क्रुद्धा वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2018146, "chapter_id": 1374, "verse_number": "३-१२-१२८", "content_sanskrit": "नैव मे पतयः सन्ति न पुत्रा न च बान्धवाः।\nन भ्रातरो न च पिता नैव त्वं मधुसूदन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2018147, "chapter_id": 1374, "verse_number": "३-१२-१२९", "content_sanskrit": "ये मां विप्रकृतां क्षुद्रैरुपेक्षध्वं विशोकवत्।\nन च मे शाम्यते दुःखं कर्णो यत्प्राहसत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2018148, "chapter_id": 1374, "verse_number": "३-१२-१३०", "content_sanskrit": "चतुर्भिः कारणैः कृष्ण त्वया रक्ष्याऽस्मि नित्यशः।\nसंबन्धाद्गौरवात्सख्यात्प्रभुत्वेनैव केशव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2018149, "chapter_id": 1374, "verse_number": "३-१२-१३१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2018150, "chapter_id": 1374, "verse_number": "३-१२-१३१", "content_sanskrit": "अथ तामब्रवीत्कृष्णस्तस्मिन्वीरसमागमे।\nरोदिष्यन्ति स्त्रियो ह्येवं येषां क्रुद्धासि नामिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 2018151, "chapter_id": 1374, "verse_number": "३-१२-१३२", "content_sanskrit": "बीभत्सुशरसंछन्नाञ्शोणितौघपरिप्लुतान्।\nनिहतान्वल्लभान्वीक्ष्य शयानान्वसुधातले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 2018152, "chapter_id": 1374, "verse_number": "३-१२-१३३", "content_sanskrit": "यत्समर्थं पाण्डवनां तत्करिष्यामि मा शुचः।\nसत्यं ते प्रतिजानामि राज्ञां राज्ञी भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 2018153, "chapter_id": 1374, "verse_number": "३-१२-१३४", "content_sanskrit": "पतेद्द्यौर्हिमवाञ्शीर्येत्पृथिवी शकली भवेत्।\nशुष्येत्तोयनिधिः कृष्णे न मे मोघं वचो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 2018154, "chapter_id": 1374, "verse_number": "३-१२-१३५", "content_sanskrit": "तच्छ्रुत्वा द्रौपदी वाक्यं प्रतिवाक्यमथाच्युतात्।\nसाचीकृतमवैक्षत्सा पाञ्चाली मध्यमं पतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 2018155, "chapter_id": 1374, "verse_number": "३-१२-१३६", "content_sanskrit": "आबभाषे महाराज द्रौपदीमर्जुनस्तदा।\nमा रोदीः शुभताम्राक्षि यदाह मधुसूदनः।\nतथा तद्भविता देवि नान्यथा वरवर्णिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 2018156, "chapter_id": 1374, "verse_number": "३-१२-१३७x", "content_sanskrit": "धृष्टद्युम्न उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 2018157, "chapter_id": 1374, "verse_number": "३-१२-१३७", "content_sanskrit": "अहं द्रोणं हनिष्यामि शिखण्डी तु पितामहम्।\nदुर्योधनं भीमसेनः कर्णं हन्ता धनिजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 2018158, "chapter_id": 1374, "verse_number": "३-१२-१३८", "content_sanskrit": "रामकृष्णौ व्यपाश्रित्य अजेयाः स्म रणए स्वसः।\nअपि वृत्रहणा युद्धे किं पुनर्धृतराष्ट्रजैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 2018159, "chapter_id": 1374, "verse_number": "३-१२-१३९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 2018160, "chapter_id": 1374, "verse_number": "३-१२-१३९", "content_sanskrit": "इत्युक्तेऽभिमुखा वीरा वासुदेवमुपास्थितः।\nतेषां मध्ये महाबाहुः केशवो वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 2018161, "chapter_id": 1374, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि अर्जुनाभिगमनपर्वणि द्वादशोऽध्यायः ॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}]