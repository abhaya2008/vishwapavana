[{"id": 2174528, "chapter_id": 4705, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2174529, "chapter_id": 4705, "verse_number": "१", "content_sanskrit": "एवं सन्तर्ज्यमानस्तु पुत्रो मम महीपतिः ।\nप्रकृत्या मन्युमान् वीरः कथमासीत् परन्तपः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2174530, "chapter_id": 4705, "verse_number": "२", "content_sanskrit": "न हि सन्तर्जना तेन श्रुतपूर्वा कदाचन ।\nराजभावेन मान्यश्च सर्वलोकस्य सोऽभवत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2174531, "chapter_id": 4705, "verse_number": "३", "content_sanskrit": "इदं च पृथिवी सर्वा सम्लेच्छाटविका भृशम् ।\nप्रसादाद्ध्रियते तस्य प्रत्यक्षं तव सञ्जय\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2174532, "chapter_id": 4705, "verse_number": "४", "content_sanskrit": "स तथा तर्ज्यमानस्तु विषमस्थो विशेषतः ।\nविहीनश्च स्वकैर्भृत्यैर्विजनैश्च धृतो भृशम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2174533, "chapter_id": 4705, "verse_number": "५", "content_sanskrit": "श्रुत्वा वाचः सुकटुका जययुक्ताः पुनः पुनः ।\nकिमब्रवीत् पाण्डवेयान् तन्ममाचक्ष्व सञ्जय\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2174534, "chapter_id": 4705, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2174535, "chapter_id": 4705, "verse_number": "६", "content_sanskrit": "तर्ज्यमानस्तदा राजा उदकस्थस्तवात्मजः ।\nयुधिष्ठिरेण राजेन्द्र भ्रातृभिः सहितेन हि\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2174536, "chapter_id": 4705, "verse_number": "७", "content_sanskrit": "श्रुत्वा तु कटुका वाचो विषमस्थो नराधिपः ।\nदीर्घमुष्णं च निःश्वस्य सलिलस्थो मुहुर्मुहुः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2174537, "chapter_id": 4705, "verse_number": "८", "content_sanskrit": "सलिलान्तर्गतो राजा धून्वन् हस्तौ पुनः पुनः ।\nमनश्चकार युद्धाय राजानं चाभ्यभाषत\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2174538, "chapter_id": 4705, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2174539, "chapter_id": 4705, "verse_number": "९", "content_sanskrit": "यूयं ससुहृदः पार्थाः सर्वे सायुधवाहनाः ।\nअहमेकः परिद्यूनो विरथो हतवाहनः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2174540, "chapter_id": 4705, "verse_number": "१०", "content_sanskrit": "आत्तशस्त्रै रथगतैर्बहुभिः परिवारितः ।\nकथमेकः पदातिः सन्नशस्त्रो योद्धुमुत्सहे\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2174541, "chapter_id": 4705, "verse_number": "११", "content_sanskrit": "एकैकश्चैव मां यूयं योधयध्वं युधिष्ठिर ।\nन ह्येको बहुभिर्योधैर्न्याय्यं योधयितुं रिपुः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2174542, "chapter_id": 4705, "verse_number": "१२", "content_sanskrit": "हीनशस्त्रो विकवचः श्रान्तश्चापः समाश्रितः ।\nभृशं विक्षतगात्रश्च श्रान्तवाहनसैनिकः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2174543, "chapter_id": 4705, "verse_number": "१३", "content_sanskrit": "न मे त्वत्तो भयं राजन् न च पार्थाद् वृकोदरात् ।\nफल्गुनाद् वासुदेवाद् वा पाञ्चालेभ्योऽथवा पुनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2174544, "chapter_id": 4705, "verse_number": "१४", "content_sanskrit": "यमाभ्यां युयुधानाद्वा ये चान्ये तव सैनिकाः ।\nएकः सर्वानहं क्रुद्धान् एतान् योद्धुमिहोत्सहे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2174545, "chapter_id": 4705, "verse_number": "१५", "content_sanskrit": "धर्ममूलं सतां कीर्तिर्मनुष्याणां जनाधिप ।\nधर्मं चैवेह कीर्तिं च पालयन् प्रब्रवीमि ते\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2174546, "chapter_id": 4705, "verse_number": "१६", "content_sanskrit": "अहमुत्थाय वः सर्वान् प्रतियोत्स्यामि संयुगे ।\nअन्वभ्याशं गतान् सर्वान् निहनिष्यामि भारत\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2174547, "chapter_id": 4705, "verse_number": "१७", "content_sanskrit": "अद्यः वः सरथान् साश्वान् अशस्त्रो विरथोऽपि सन् ।\nनक्षत्राणीव सर्वाणि सविता रात्रिसङ्क्षये\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2174548, "chapter_id": 4705, "verse_number": "१८", "content_sanskrit": "तेजसा नाशयिष्यामि स्थिरीभवत पाण्डवाः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2174549, "chapter_id": 4705, "verse_number": "१९", "content_sanskrit": "अद्यानृण्यं गमिष्यामि क्षत्रियाणां यशस्विनाम् ।\nबाह्लीकद्रोणभीष्माभ्यां कर्णस्य च महात्मनः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2174550, "chapter_id": 4705, "verse_number": "२०", "content_sanskrit": "जयद्रथस्य शूरस्य भगदत्तस्य चोभयोः ।\nमद्रराजस्य शल्यस्य भूरिश्रवस एव च\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2174551, "chapter_id": 4705, "verse_number": "२१", "content_sanskrit": "भ्रातॄणां भरतश्रेष्ठ शकुनेः सौबलस्य च ।\nमित्राणां सुहृदां चैव बान्धवानां च सर्वशः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2174552, "chapter_id": 4705, "verse_number": "२२", "content_sanskrit": "आनृण्यमद्य यास्यामि हत्वा त्वां भ्रातृभिः सह\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2174553, "chapter_id": 4705, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2174554, "chapter_id": 4705, "verse_number": "२३", "content_sanskrit": "एवमुक्त्वा तु वचनं विरराम नराधिपः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2174555, "chapter_id": 4705, "verse_number": "", "content_sanskrit": "सलिलान्तर्गतः श्रीमान् पुत्रो दुर्योधनस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2174556, "chapter_id": 4705, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2174557, "chapter_id": 4705, "verse_number": "२४", "content_sanskrit": "दिष्ट्या त्वमपि जानीषे क्षत्रधर्मं सुयोधन ।\nदिष्ट्या ते वर्तते बुद्धिर्युद्धायैव महाभुज\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2174558, "chapter_id": 4705, "verse_number": "२५", "content_sanskrit": "दिष्ट्या शूरोऽसि गान्धारे दिष्ट्या जानासि सङ्गरम् ।\nयस्त्वमेकोऽद्य नः सर्वान् संयुगे योद्धुमिच्छसि\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2174559, "chapter_id": 4705, "verse_number": "२६", "content_sanskrit": "एक एकेन सङ्गम्य यत्ते सम्मतमायुधम् ।\nतत् त्वमादाय युध्यस्व प्रेक्षकास्ते वयं स्थिताः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2174560, "chapter_id": 4705, "verse_number": "२७", "content_sanskrit": "अयमिष्टं च ते कामं वीर भूयो ददाम्यहम् ।\nहनैकं भव नो राजा हतो वा स्वर्गमाप्नुहि\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2174561, "chapter_id": 4705, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2174562, "chapter_id": 4705, "verse_number": "२८", "content_sanskrit": "एकश्चेद् योद्धुमाक्रन्दे वरोऽद्य मम दीयताम् ।\nआयुधानामियं चापि मता मे सततं गदा\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2174563, "chapter_id": 4705, "verse_number": "२९", "content_sanskrit": "भ्रातॄणां भवतामेकः शक्यं मां यो हि मन्यते ।\nपदातिर्गदया सङ्खे स युध्यतु मया सह\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2174564, "chapter_id": 4705, "verse_number": "३०", "content_sanskrit": "वृत्तानि रथयुद्धानि विचित्राणि पदे पदे ।\nइदं त्वेकं गदायुद्धं भवत्वद्याद्भुतं महत्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2174565, "chapter_id": 4705, "verse_number": "३१", "content_sanskrit": "अर्थानामपि पर्यायं भोक्तुमिच्छन्ति मानवाः ।\nयुद्धानामपि पर्यायो भवत्वनुमते तव\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2174566, "chapter_id": 4705, "verse_number": "३२", "content_sanskrit": "गदया त्वां महाबाहो विजेष्यामि सहानुजम् ।\nपाञ्चालान् सृञ्जयांश्चैव ये चान्ये तव बान्धवाः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2174567, "chapter_id": 4705, "verse_number": "३३", "content_sanskrit": "तिष्ठतु प्रेक्षकाः सर्वे गदायुद्धं प्रवर्तताम् ।\nन हि मे सम्भ्रमो जातु शक्रादपि युधिष्ठिर\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2174568, "chapter_id": 4705, "verse_number": "", "content_sanskrit": "श्रीभीमसेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2174569, "chapter_id": 4705, "verse_number": "३४", "content_sanskrit": "उत्तिष्ठोत्तिष्ठ गान्धारे मां योधय सुयोधन ।\nएक एकेन सङ्गम्य गदया संयुगे बली\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2174570, "chapter_id": 4705, "verse_number": "३५", "content_sanskrit": "पुरुषो भव गान्धारे युध्यस्व सुसमाहितः ।\nअद्य ते जीवितं नास्ति यदिन्द्रोऽपि तवाश्रयः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2174571, "chapter_id": 4705, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2174572, "chapter_id": 4705, "verse_number": "३६", "content_sanskrit": "एतत् स नरशार्दूलो नामृष्यत तवात्मजः ।\nसलिलान्तर्गतः श्वभ्रे महानाग इव श्वसन्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2174573, "chapter_id": 4705, "verse_number": "३७", "content_sanskrit": "ततोऽसौ वाक्प्रतोदेन तुद्यमानः पुनः पुनः ।\nवाचं न ममृषे धीमान् उत्तमाश्वः कशामिव\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2174574, "chapter_id": 4705, "verse_number": "३८", "content_sanskrit": "सङ्क्षोभ्य सलिलं वेगाद् गदामादाय वीर्यवान् ।\nअद्रिसारमयीं गुर्वीं जातरूपपरिष्कृताम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2174575, "chapter_id": 4705, "verse_number": "३९", "content_sanskrit": "अन्तर्जलात् समुत्तस्थौ नागेन्द्र इव निःश्वसन्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2174576, "chapter_id": 4705, "verse_number": "४०", "content_sanskrit": "स हित्वा स्तम्भितं तोयं स्कन्धे कृत्वाऽऽयसीं गदाम् ।\nउदतिष्ठत पुत्रस्ते प्रतपन् रश्मिमानिव\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2174577, "chapter_id": 4705, "verse_number": "४१", "content_sanskrit": "ततः शैक्यायसीं गुर्वीं काञ्चनाङ्गदभूषणाम् ।\nगदां परामृशन् धीमान् धार्तराष्ट्रो महायशाः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2174578, "chapter_id": 4705, "verse_number": "४२", "content_sanskrit": "गदाहस्तं तु तं दृष्ट्वा सशृङ्गमिव पर्वतम् ।\nप्रजानामिव सङ्क्रुद्धं शूलपाणिमवस्थितम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2174579, "chapter_id": 4705, "verse_number": "४३", "content_sanskrit": "सगदो भारतो भाति प्रतपन् भास्करो यथा\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2174580, "chapter_id": 4705, "verse_number": "४४", "content_sanskrit": "तमुत्तीर्णं महाबाहुं गदाहस्तमरिन्दमम् ।\nमेनिरे सर्वभूतानि दण्डहस्तमिवान्तकम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2174581, "chapter_id": 4705, "verse_number": "४५", "content_sanskrit": "वज्रहस्तं यथा शक्रं शूलहस्तं यथा हरम् ।\nददृशुः सर्वपाञ्चालाः पुत्रं तव जनाधिप\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2174582, "chapter_id": 4705, "verse_number": "४६", "content_sanskrit": "तमुत्तीर्णं तु सम्प्रेक्ष्य समहृष्यन्त सर्वशः ।\nपाञ्चालाः पाण्डवेयाश्च तेऽन्योन्यस्य तळं ददुः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2174583, "chapter_id": 4705, "verse_number": "४७", "content_sanskrit": "अपहासं तु तं मत्वा पुत्रो दुर्योधनस्तव ।\nउद्धृत्य नयने क्रूरे दिधक्षुरिव पाण्डवान्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2174584, "chapter_id": 4705, "verse_number": "४८", "content_sanskrit": "त्रिशिखां भ्रुकुटीं कृत्वा सन्दष्टदशनच्छदः ।\nप्रत्युवाच ततस्तान् वै पाण्डवान् सहकेशवान्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2174585, "chapter_id": 4705, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2174586, "chapter_id": 4705, "verse_number": "४९", "content_sanskrit": "अपहासस्य वोऽद्यास्य प्रतिमोक्तास्मि पाण्डवाः ।\nगमिष्यथ हताः सद्यः सपाञ्चाला यमक्षयम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2174587, "chapter_id": 4705, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2174588, "chapter_id": 4705, "verse_number": "५०", "content_sanskrit": "उत्थितस्तु जलात् तस्माद् योद्धुकामः सुतस्तव ।\nअतिष्ठच्च गदापाणी रुधिरेण समुक्षितः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2174589, "chapter_id": 4705, "verse_number": "५१", "content_sanskrit": "तस्य शोणितदिग्धस्य सलिलेन समुक्षितम् ।\nशरीरं तु तदा भाति स्रवन्निव महीधरः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2174590, "chapter_id": 4705, "verse_number": "५२", "content_sanskrit": "तमुद्यतगदं वीरं मेनिरे तत्र पाण्डवाः ।\nवैवस्वतमिव क्रुद्धं शूलपाणिमवस्थितम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2174591, "chapter_id": 4705, "verse_number": "५३", "content_sanskrit": "स मेघनिनदो हर्षाद् विनदन्निव गोवृषः ।\nआजुहाव तदा पार्थान् गदया भीमविक्रमः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2174592, "chapter_id": 4705, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2174593, "chapter_id": 4705, "verse_number": "५४", "content_sanskrit": "एकैकशश्च मां यूयं योधयध्वं युधिष्ठिर ।\nन ह्येको बहुभिर्न्याय्यं वीर योधयितुं रणे\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2174594, "chapter_id": 4705, "verse_number": "५५", "content_sanskrit": "न्यस्तवर्मा विशेषेण श्रान्तश्चाप्सु परिप्लुतः ।\nभृशं विक्षतगात्रश्च हतवाहनसैनिकः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2174595, "chapter_id": 4705, "verse_number": "५६", "content_sanskrit": "अवश्यमेव योद्धव्यं सर्वैरेव महारथ ।\nयुक्तं न युक्तमित्येतत् वेत्सि त्वं चैव सर्वदा\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2174596, "chapter_id": 4705, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2174597, "chapter_id": 4705, "verse_number": "५७", "content_sanskrit": "मा भूदियं तव प्रज्ञा कथमेकं सुयोधन ।\nयदाऽभिमन्युं बहवो युधि जघ्नुर्महारथाः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2174598, "chapter_id": 4705, "verse_number": "५८", "content_sanskrit": "क्षत्रधर्मं भृशं क्रूरं निरपेक्षं सुनिर्घृणम् ।\nअन्यथा तु कथं हन्युरभिमन्युं तथागतम्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2174599, "chapter_id": 4705, "verse_number": "५९", "content_sanskrit": "सर्वे भवन्तो धर्मज्ञाः सर्वे शूरास्तनुत्यजः ।\nन्यायेन युध्यतां प्रोक्ता शक्रलोकगतिः परा\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2174600, "chapter_id": 4705, "verse_number": "६०", "content_sanskrit": "यद्येकस्तु न हन्तव्यो बहुभिर्धर्म एव तु ।\nतदाऽभिमन्युं बहवो निजघ्नुस्त्वन्मते कथम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2174601, "chapter_id": 4705, "verse_number": "६१", "content_sanskrit": "सर्वो विमृशते जन्तुः कृच्छ्रस्थो धर्मदर्शनम् ।\nयदसौ पिहितं द्वारं परलोकस्य पश्यति\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2174602, "chapter_id": 4705, "verse_number": "६२", "content_sanskrit": "आमुञ्च कवचं वीर मूर्धजान् यमयस्व च ।\nयच्चान्यदपि ते नास्ति तदप्याचक्ष्व भारत\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2174603, "chapter_id": 4705, "verse_number": "६३", "content_sanskrit": "इदमेकं च ते कामं वीर भूयो ददाम्यहम्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2174604, "chapter_id": 4705, "verse_number": "६४", "content_sanskrit": "पञ्चानां पाण्डवेयानां येन योद्धुमिहेच्छसि ।\nतं हत्वा भव राजा त्वं हतो वा स्वर्गमाप्नुहि\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2174605, "chapter_id": 4705, "verse_number": "६५", "content_sanskrit": "ऋते च जीवितं वीर युद्धे किं कुर्मि ते प्रियम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2174606, "chapter_id": 4705, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2174607, "chapter_id": 4705, "verse_number": "६६", "content_sanskrit": "ततस्तव सुतो राजन् वर्म जग्राह काञ्चनम् ।\nविचित्रं च शिरत्रा(स्त्रा)णं जाम्बूनदपरिष्कृतम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2174608, "chapter_id": 4705, "verse_number": "६७", "content_sanskrit": "सोऽवबद्धशिरस्त्राणं शुद्धकाञ्चनवर्मभृत् ।\nरराज राजन् पुत्रस्ते काञ्चनः शैलराडिव\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2174609, "chapter_id": 4705, "verse_number": "६८", "content_sanskrit": "सन्नद्धः सगदो राजन् सज्जः सङ्ग्राममूर्धनि ।\nअब्रवीत् पाण्डवान् राजन् पुत्रो दुर्योधनस्तव\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2174610, "chapter_id": 4705, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2174611, "chapter_id": 4705, "verse_number": "६९", "content_sanskrit": "भ्रातॄणां भवतामेको युध्यतां गदया मया ।\nसहदेवेन वा योत्स्ये भीमेन नकुलेन वा\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2174612, "chapter_id": 4705, "verse_number": "७०", "content_sanskrit": "अथवा फल्गुनेनाद्य त्वया वा भरतर्षभ ।\nयोत्स्येऽहं सङ्गरं प्राप्य विजेष्ये च रणाजिरे\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2174613, "chapter_id": 4705, "verse_number": "७१", "content_sanskrit": "अहमद्य गमिष्यामि वैरस्यान्तं सुदुर्गमम् ।\nगदया पुरुषव्याघ्र हेमपट्टनिबद्धया\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2174614, "chapter_id": 4705, "verse_number": "७२", "content_sanskrit": "गदायुद्धे न मे कश्चित् सदृशोऽस्तीति चिन्तय\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2174615, "chapter_id": 4705, "verse_number": "७३", "content_sanskrit": "गदया पोथयिष्यामि सर्वानेव पृथक् पृथक्\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2174616, "chapter_id": 4705, "verse_number": "७४", "content_sanskrit": "न मे समर्थाः सर्वे वै योद्धुं न्यायेन केचन ।\nन युक्तमात्मना वक्तुमेवं गर्वोद्धतं वचः\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2174617, "chapter_id": 4705, "verse_number": "७५", "content_sanskrit": "अथवा सफलं ह्येतत्करिष्ये भवतां पुरः ।\nअस्मिन्मुहूर्ते सत्यं वा मिथ्या वै तद् भविष्यति\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2174618, "chapter_id": 4705, "verse_number": "७६", "content_sanskrit": "गृह्यतां च गदा यो वै युध्यतेऽद्य मया सह\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2174619, "chapter_id": 4705, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि तृतीयोऽध्यायः ॥३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}]