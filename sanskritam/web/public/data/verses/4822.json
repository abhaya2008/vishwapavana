[{"id": 2180481, "chapter_id": 4822, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2180482, "chapter_id": 4822, "verse_number": "१", "content_sanskrit": "प्रवेशने तु पार्थानां जनस्य पुरवासिनः ।\nदिदृक्षूणां सहस्राणि समाजग्मुर्बहून्यथ\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2180483, "chapter_id": 4822, "verse_number": "२", "content_sanskrit": "स राजमार्गः शुशुभे समलङ्कृतचत्वरः ।\nयथा चन्द्रोदये राजन् वर्धमानो महोदधिः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2180484, "chapter_id": 4822, "verse_number": "३", "content_sanskrit": "गृहाणि राजमार्गे तु रत्नवन्ति बृहन्ति च ।\nप्राकम्पन्तेव भारेण स्त्रीणां पूर्णानि भारत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2180485, "chapter_id": 4822, "verse_number": "४", "content_sanskrit": "ताः शनैरिव सव्रीडं प्रशशंसुर्युधिष्ठिरम् ।\nभीमसेनार्जुनौ चैव माद्रीपुत्रौ च पाण्डवौ\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2180486, "chapter_id": 4822, "verse_number": "५", "content_sanskrit": "धन्या त्वमसि पाञ्चालि या त्वं पुरुषसत्तमान् ।\nउपतिष्ठसि कल्याणि महर्षीनिव गौतमी\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2180487, "chapter_id": 4822, "verse_number": "६", "content_sanskrit": "तव कर्माण्यमोघानि व्रतचर्या च भामिनि ।\nइति कृष्णां महाराज प्रशशंसुस्तदा स्त्रियः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2180488, "chapter_id": 4822, "verse_number": "७", "content_sanskrit": "प्रशंसावचनैस्तासां मिथःशब्दैश्च भारत ।\nप्रीतिजैश्च तदा शब्दैः पुरमासीत् समाकुलम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2180489, "chapter_id": 4822, "verse_number": "८", "content_sanskrit": "तमतीत्य यथायुक्तं राजमार्गं युधिष्ठिरः ।\nअलङ्कृतं शोभमानमुपायाद् राजवेश्म ह\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2180490, "chapter_id": 4822, "verse_number": "९", "content_sanskrit": "ततः प्रकृतयः सर्वाः पौरजानपदास्तथा ।\nऊचुः कथाः कर्णसुखाः समुपेत्य ततस्ततः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2180491, "chapter_id": 4822, "verse_number": "१०", "content_sanskrit": "दिष्ट्या जयसि राजेन्द्र शत्रून् शत्रुनिषूदन ।\nदिष्ट्या राज्यं पुनः प्राप्तं धर्मेण च बलेन च\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2180492, "chapter_id": 4822, "verse_number": "११", "content_sanskrit": "भव नस्त्वं महाराज राजेह शरदां शतम् ।\nप्रजाः पालय धर्मेण यथेन्द्रस्त्रिदिवं नृप\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2180493, "chapter_id": 4822, "verse_number": "१२", "content_sanskrit": "एवं राजकुलद्वारि मङ्गलैरभिपूजितः ।\nआशीर्वादान् द्विजैरुक्तान् प्रतिगृह्य समन्ततः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2180494, "chapter_id": 4822, "verse_number": "१३", "content_sanskrit": "प्रविश्य भवनं राजा देवराजगृहोपमम् ।\nश्रुत्वा विजयसंयुक्तं रथात् पश्चादवातरत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2180495, "chapter_id": 4822, "verse_number": "१४", "content_sanskrit": "प्रविश्याभ्यन्तरं श्रीमान् दैवतान्यभिगम्य च ।\nपूजयामास रत्नैश्च गन्धैर्माल्यैश्च सर्वशः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2180496, "chapter_id": 4822, "verse_number": "१५", "content_sanskrit": "निश्चक्राम ततः श्रीमान् पुनरेव महायशाः ।\nददर्श ब्राह्मणांश्चैव सोऽभिरूपानुपस्थितान्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2180497, "chapter_id": 4822, "verse_number": "१६", "content_sanskrit": "स संवृतस्तदा विप्रैराशीर्वादविवक्षुभिः ।\nशुशुभे विमलश्चन्द्रस्तारागणवृतो यथा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2180498, "chapter_id": 4822, "verse_number": "१७", "content_sanskrit": "तान् स सम्पूजयामास कौन्तेयो विधिवद् द्विजान् ।\nधौम्यं गुरुं पुरस्कृत्य ज्येष्ठं पितरमेव च\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2180499, "chapter_id": 4822, "verse_number": "१८", "content_sanskrit": "सुमनोमोदकै रत्नैर्हिरण्येन च भूरिणा ।\nगोभिर्वस्त्रैश्च राजेन्द्र विविधैश्च किमिच्छकैः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2180500, "chapter_id": 4822, "verse_number": "१९", "content_sanskrit": "ततः पुण्याहघोषोऽभूद् दिवं स्तब्ध्वेव भारत ।\nसुहृदां हर्षजननः पुण्यः श्रुतिसुखावहः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2180501, "chapter_id": 4822, "verse_number": "२०", "content_sanskrit": "हंसवन्नेदुषां राजन् द्विजानां तत्र भारती ।\nशुश्रुवे वेदविदुषां पुष्कलार्थपदाक्षरा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2180502, "chapter_id": 4822, "verse_number": "२१", "content_sanskrit": "ततो दुन्दुभिनिर्घोषः शङ्खानां च मनोरमः ।\nजयं प्रवदतां तत्र स्वनः प्रादुरभून्नृप\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2180503, "chapter_id": 4822, "verse_number": "२२", "content_sanskrit": "निःशब्दे च स्थिते तत्र ततो विप्रजने पुनः ।\nराजानं ब्राह्मणच्छद्मा चार्वाको राक्षसोऽब्रवीत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2180504, "chapter_id": 4822, "verse_number": "२३", "content_sanskrit": "तत्र दुर्योधनसखा भिक्षुरूपेण संवृतः ।\nसाक्षः शिखी त्रिदण्डी च धृष्टो विगतसाध्वसः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2180505, "chapter_id": 4822, "verse_number": "२४", "content_sanskrit": "वृतः सर्वैस्तदा विप्रैराशीर्वादविवक्षुभिः ।\nपरसहस्रैः राजेन्द्र तपोनियमसंस्थितैः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2180506, "chapter_id": 4822, "verse_number": "२५", "content_sanskrit": "स दुष्टः पापमाशंसन् पाण्डवानां महात्मनाम् ।\nअनामन्त्र्यैव तान् विप्रांस्तमुवाच महीपतिम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2180507, "chapter_id": 4822, "verse_number": "२६", "content_sanskrit": "इमे प्राहुर्द्विजाः सर्वे समारोप्य वचो मयि ।\nधिग् भवन्तं कुनृपतिं ज्ञातिघातिनमस्तु वै\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2180508, "chapter_id": 4822, "verse_number": "२७", "content_sanskrit": "किं ते राज्येन कौन्तेय कृत्वेमं ज्ञातिसङ्क्ष्यम् ।\nघातयित्वा गुरूंश्चैव मृतं श्रेयो न जीवितम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2180509, "chapter_id": 4822, "verse_number": "समाप्तिः", "content_sanskrit": "इति ते वै द्विजाः श्रुत्वा तस्य घोरस्य रक्षसः ।\nविव्यथुश्चुक्रुशुश्चैव तस्य वाक्यप्रधर्षिताः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2180510, "chapter_id": 4822, "verse_number": "२९", "content_sanskrit": "ततस्ते ब्राह्मणाः सर्वे स च राजा युधिष्ठिरः ।\nव्रीडिता परमोद्विग्नास्तूष्णीमासन् विशाम्पते\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2180511, "chapter_id": 4822, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2180512, "chapter_id": 4822, "verse_number": "३०", "content_sanskrit": "प्रसीदन्तु भवन्तो मे प्रणतस्याभियाचतः ।\nप्रत्यापन्नं व्यसनिनं न मां धिक्कर्तुमर्हथ\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2180513, "chapter_id": 4822, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2180514, "chapter_id": 4822, "verse_number": "३१", "content_sanskrit": "ततो राजन् ब्राह्मणास्ते सर्व एव विशाम्पते ।\nऊचुर्नैतद् वचोऽस्माकं श्रीरस्तु तव पार्थिव\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2180515, "chapter_id": 4822, "verse_number": "३२", "content_sanskrit": "जज्ञुश्चैव महात्मानस्ततस्तं ज्ञानचक्षुषा ।\nब्राह्मणा वेदविद्वांसस्तपोभिर्विमलीकृताः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2180516, "chapter_id": 4822, "verse_number": "", "content_sanskrit": "ब्राह्मणाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2180517, "chapter_id": 4822, "verse_number": "३३", "content_sanskrit": "एष दुर्योधनसखा चार्वाको नाम राक्षसः ।\nपरिव्राजकरूपेण हितं तस्य चिकीर्षति\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2180518, "chapter_id": 4822, "verse_number": "३४", "content_sanskrit": "न वयं ब्रूम धर्मात्मन् व्येतु ते भयमीदृशम् ।\nउपतिष्ठतु कल्याणं भवन्तं भ्रातृभिः सह\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2180519, "chapter_id": 4822, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2180520, "chapter_id": 4822, "verse_number": "३५", "content_sanskrit": "ततस्ते ब्राह्मणाः सर्वे हुङ्कारैः क्रोधमूर्छिताः ।\nनिर्भर्त्सयन्तः शुचयो निजघ्नुः पापराक्षसम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2180521, "chapter_id": 4822, "verse_number": "३६", "content_sanskrit": "स पपात विनिर्दग्धस्तेजसा ब्रह्मवादिनाम् ।\nमहेन्द्राशनिनिर्दग्धः पादपोऽङ्कुरवानिव\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2180522, "chapter_id": 4822, "verse_number": "३७", "content_sanskrit": "पूजिताश्च ययुर्विप्रा राजानमभिनन्द्य तम् ।\nराजा च हर्षमापेदे पाण्डवः ससुहृज्जनः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2180523, "chapter_id": 4822, "verse_number": "३८", "content_sanskrit": "ततस्तत्र तु राजानं तिष्ठन्तं भ्रातृभिः सह ।\nउवाच देवकीपुत्रः सर्वदर्शी जनार्दनः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2180524, "chapter_id": 4822, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2180525, "chapter_id": 4822, "verse_number": "३९", "content_sanskrit": "ब्राह्मणास्तात लोकेऽस्मिन्नर्चनीयाः सदा मम ।\nएते भूमिचरा देवा वाग्विषाः सुप्रसादकाः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2180526, "chapter_id": 4822, "verse_number": "४०", "content_sanskrit": "पुरा कृतयुगे तात चार्वाको नाम राक्षसः ।\nतपस्तेपे महाबाहो बदर्यां बहुवत्सरम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2180527, "chapter_id": 4822, "verse_number": "४१", "content_sanskrit": "छन्द्यमानो वरेणाथ ब्रह्मणा स पुनःपुनः ।\nअभयं सर्वभूतेभ्यो वरयामास भारत\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2180528, "chapter_id": 4822, "verse_number": "४२", "content_sanskrit": "द्विजावमानादन्यत्र प्रादाद् वरमनुत्तमम् ।\nअभयं सर्वभूतेभ्यस्ततस्तस्मै जगत्प्रभुः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2180529, "chapter_id": 4822, "verse_number": "४३", "content_sanskrit": "स तु लब्धवरः पापो देवानमितविक्रमः ।\nराक्षसस्तापयामास तीव्रकर्मा महाबलः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2180530, "chapter_id": 4822, "verse_number": "४४", "content_sanskrit": "ततो देवाः समेत्याथ ब्रह्माणमिदमब्रुवन् ।\nवधाय रक्षसस्तस्य बलविप्रकृतास्तदा\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2180531, "chapter_id": 4822, "verse_number": "४५", "content_sanskrit": "तानुवाचाव्ययो देवो विहितं तत्र वै मया ।\nयथास्य भविता मृत्युरचिरेणैव भारत\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2180532, "chapter_id": 4822, "verse_number": "४६", "content_sanskrit": "राजा दुर्योधनो नाम सखाऽस्य भविता नृप ।\nतस्य स्नेहावबद्धोऽसौ ब्राह्मणानवमंस्यते\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2180533, "chapter_id": 4822, "verse_number": "४७", "content_sanskrit": "तत्रैनं रुषिता विप्रा विप्रकारप्रधर्षिताः ।\nधक्ष्यन्ति वाग्बलाः पापं ततो नाशं गमिष्यति\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2180534, "chapter_id": 4822, "verse_number": "४८", "content_sanskrit": "स एष निहतः शेते ब्रह्मदण्डेन राक्षसः ।\nचार्वाको नृपतिश्रेष्ठ मा शुचो भरतर्षभ\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2180535, "chapter_id": 4822, "verse_number": "४९", "content_sanskrit": "हतास्ते क्षत्रधर्मेण ज्ञातयस्तव पार्थिव ।\nस्वर्गताश्च महात्मानो वीराः क्षत्रियपुङ्गवाः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2180536, "chapter_id": 4822, "verse_number": "५०", "content_sanskrit": "स त्वमातिष्ठ कल्याणं मा ते भूद् ग्लानिरच्युत ।\nशत्रून् जहि प्रजा रक्ष द्विजांश्च प्रतिपालय\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2180537, "chapter_id": 4822, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे एकोनचत्वारिंशोऽध्यायः ॥ ३९ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]