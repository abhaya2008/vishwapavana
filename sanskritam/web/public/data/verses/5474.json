[{"id": 2209363, "chapter_id": 5474, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2209364, "chapter_id": 5474, "verse_number": "१", "content_sanskrit": "एवमुक्तः स राजेन्द्र केशिहा दुःखमूर्च्छितः ।\nतथेति व्याजहारोच्चैः ह्लादयन्निव तं जनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2209365, "chapter_id": 5474, "verse_number": "२", "content_sanskrit": "वाक्येनैतेन सहसा तं जनं पुरुषर्षभः ।\nह्लादयामास स विभुर्घर्मार्तं सलिलैरिव ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2209366, "chapter_id": 5474, "verse_number": "३", "content_sanskrit": "ततः स प्राविशत् तूर्णं जन्मवेश्म पितुस्तव ।\nअर्चितं पुरुषव्याघ्र सितैर्माल्यैर्यथाविधि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2209367, "chapter_id": 5474, "verse_number": "४", "content_sanskrit": "अपां कुम्भैः सुपूर्णैश्च विन्यस्तैः सर्वतोदिशम् ।\nघृतेन तिन्दुकालाजैः सर्षपैश्च महाभुजः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2209368, "chapter_id": 5474, "verse_number": "५", "content_sanskrit": "शस्त्रैश्च विमलैर्न्यस्तैः पावकैश्च समन्ततः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2209369, "chapter_id": 5474, "verse_number": "६", "content_sanskrit": "वृद्धाभिश्चानुरूपाभिः परिवारार्थमप्युत ।\nदक्षैश्च परितो वीर भिषग्भिः कुशलैस्तथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2209370, "chapter_id": 5474, "verse_number": "७", "content_sanskrit": "ददर्श स च स तेजस्वी रक्षोघ्नान्यपि सर्वशः ।\nद्रव्याणि स्थापितानि स्म विधिवत् कुशलैस्तथा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2209371, "chapter_id": 5474, "verse_number": "८", "content_sanskrit": "जनैर्युक्तं च तद् दृष्ट्वा जन्मवेश्म पितुस्तव ।\nहृष्टोऽभवद् हृषीकेशः साधु साध्विति सोऽब्रवीत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2209372, "chapter_id": 5474, "verse_number": "९", "content_sanskrit": "तथा ब्रुवति गोविन्दे प्रहृष्टवदने तदा ।\nद्रौपदी त्वरिता गत्वा वैराटीं वाक्यमब्रवीत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2209373, "chapter_id": 5474, "verse_number": "", "content_sanskrit": "द्रौपदी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2209374, "chapter_id": 5474, "verse_number": "१०", "content_sanskrit": "अयमायाति ते भर्तुर्मातुलो मधुसूदनः ।\nपुराणर्षिरचिन्त्यात्मा समीपमपराजितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2209375, "chapter_id": 5474, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2209376, "chapter_id": 5474, "verse_number": "११", "content_sanskrit": "सा तु बाष्पकलां वाचं निगृह्याश्रूणि चैव ह ।\nसुसंवीता तदा भूत्वा देववत् कृष्णमीक्षति ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2209377, "chapter_id": 5474, "verse_number": "१२", "content_sanskrit": "सा तदा दूयमानेन हृदयेन मनस्विनी ।\nदृष्ट्वा गोविन्दमायान्तं कृपणं पर्यदेवयत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2209378, "chapter_id": 5474, "verse_number": "", "content_sanskrit": "उत्तरा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2209379, "chapter_id": 5474, "verse_number": "१३", "content_sanskrit": "पुण्डरीकाक्ष पश्य त्वं बालाविह विनाकृतौ ।\nअभिमन्युं च मां चैव हतौ तुल्यं जनार्दन ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2209380, "chapter_id": 5474, "verse_number": "१४", "content_sanskrit": "वार्ष्णेय मधुहन् वीर शिरसा त्वां प्रसादये ।\nद्रोणपुत्रास्त्रनिर्दग्धं जीवयैनं जनार्दन ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2209381, "chapter_id": 5474, "verse_number": "१५", "content_sanskrit": "यदि स्म धर्मराजेन भीमसेनेन वा पुनः ।\nत्वया वा पुण्डरीकाक्ष वाक्यमुक्तमिदं भवेत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2209382, "chapter_id": 5474, "verse_number": "१६", "content_sanskrit": "अजातानामिषीकेयं जनित्रीं हन्त्विति प्रभो ।\nअहमेव विनष्टा स्यां नेदमेवं गतं भवेत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2209383, "chapter_id": 5474, "verse_number": "१७", "content_sanskrit": "गर्भस्थस्यास्य बालस्य ब्रह्मास्त्रेन निपातनम् ।\nकृत्वा नृशंसं दुर्बुद्धिर्द्रौणिः किं फलमश्नुते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2209384, "chapter_id": 5474, "verse_number": "१८", "content_sanskrit": "सा त्वां प्रणम्य शिरसा याचे शत्रुनिबर्हण ।\nप्राणांस्त्यक्ष्यामि गोविन्द नायं जीवति वा यदि ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2209385, "chapter_id": 5474, "verse_number": "१९", "content_sanskrit": "अस्मिन् हि बहवः कृष्ण ये ममासन् मनोरथाः ।\nते द्रोणपुत्रेण हताः किं नु जीवामि केशव ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2209386, "chapter_id": 5474, "verse_number": "२०", "content_sanskrit": "आसीन्मम मतिः कृष्ण पूर्णोत्सङ्गा जनार्दन ।\nअभिवादयिष्ये हृष्टेति तदिदं वितथं कृतम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2209387, "chapter_id": 5474, "verse_number": "२१", "content_sanskrit": "चपलाक्षस्य दायादे मृतेऽस्मिन् पुरुषर्षभ ।\nविफला मे कृताः कृष्ण हृदि सर्वे मनोरथाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2209388, "chapter_id": 5474, "verse_number": "२२", "content_sanskrit": "चपलाक्षः किलातीव प्रियस्ते मधुसूदन ।\nसुतमीक्षस्व तस्यैनं ब्रह्मास्त्रेण निपातितम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2209389, "chapter_id": 5474, "verse_number": "२३", "content_sanskrit": "कृतघ्नोऽयं नृशंसोऽयं यथाऽस्य जनकस्तथा ।\nयः पाण्डवीं श्रियं त्यक्त्वा गतोऽद्य यमसादनम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2209390, "chapter_id": 5474, "verse_number": "२४", "content_sanskrit": "मया चैतत् प्रतिज्ञातं रणमूर्धनि केशव ।\nअभिमन्यौ हते वीर त्वामेष्याम्यचिरादिव ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2209391, "chapter_id": 5474, "verse_number": "२५", "content_sanskrit": "तच्च नाकरवं कृष्ण नृशंसा जीवितप्रिया ।\nइदानीमागतां तत्र किं नु वक्ष्यति फाल्गुनिः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2209392, "chapter_id": 5474, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि जन्मगृहप्रवेशने उत्तराया वचनप्रकारकथनं नाम अष्टषष्टितमोऽध्यायः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]