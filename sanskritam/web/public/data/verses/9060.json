[{"id": 5000060000, "chapter_id": 9060, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे षष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000060001, "chapter_id": 9060, "verse_number": "१-६०-१", "content_sanskrit": "तपोबलहतान् ज्ञात्वा वासिष्ठान् समहोदयान्।\nऋषिमध्ये महातेजा विश्वामित्रोऽभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000060002, "chapter_id": 9060, "verse_number": "१-६०-२", "content_sanskrit": "अयमिक्ष्वाकुदायादस्त्रिशङ्कुरिति विश्रुतः।\nधर्मिष्ठश्च वदान्यश्च मां चैव शरणं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000060003, "chapter_id": 9060, "verse_number": "१-६०-३", "content_sanskrit": "स्वेनानेन शरीरेण देवलोकजिगीषया।\nयथायं स्वशरीरेण देवलोकं गमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000060004, "chapter_id": 9060, "verse_number": "१-६०-४", "content_sanskrit": "तथा प्रवर्त्यतां यज्ञो भवद्भिश्च मया सह।\nविश्वामित्रवचः श्रुत्वा सर्व एव महर्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000060005, "chapter_id": 9060, "verse_number": "१-६०-५", "content_sanskrit": "ऊचुः समेताः सहसा धर्मज्ञा धर्मसंहितम्।\nअयं कुशिकदायादो मुनिः परमकोपनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000060006, "chapter_id": 9060, "verse_number": "१-६०-६", "content_sanskrit": "यदाह वचनं सम्यगेतत् कार्यं न संशयः।\nअग्निकल्पो हि भगवान् शापं दास्यति रोषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000060007, "chapter_id": 9060, "verse_number": "१-६०-७", "content_sanskrit": "तस्मात् प्रवर्त्यतां यज्ञः सशरीरो यथा दिवि।\nगच्छेदिक्ष्वाकुदायादो विश्वामित्रस्य तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000060008, "chapter_id": 9060, "verse_number": "१-६०-८", "content_sanskrit": "ततः प्रवर्त्यतां यज्ञः सर्वे समधितिष्ठत।\nएवमुक्त्वा महर्षयः संजह्रुस्ताः क्रियास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000060009, "chapter_id": 9060, "verse_number": "१-६०-९", "content_sanskrit": "याजकश्च महातेजा विश्वामित्रोऽभवत् क्रतौ।\nऋत्विजश्चानुपूर्व्येण मन्त्रवन्मन्त्रकोविदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000060010, "chapter_id": 9060, "verse_number": "१-६०-१०", "content_sanskrit": "चक्रुः सर्वाणि कर्माणि यथाकल्पं यथाविधि।\nततः कालेन महता विश्वामित्रो महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000060011, "chapter_id": 9060, "verse_number": "१-६०-११", "content_sanskrit": "चकारावाहनं तत्र भागार्थं सर्वदेवताः।\nनाभ्यागमंस्तदा तत्र भागार्थं सर्वदेवताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000060012, "chapter_id": 9060, "verse_number": "१-६०-१२", "content_sanskrit": "ततः कोपसमाविष्टो विश्वामित्रो महामुनिः।\nस्रुवमुद्यम्य सक्रोधस्त्रिशङ्कुमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000060013, "chapter_id": 9060, "verse_number": "१-६०-१३", "content_sanskrit": "पश्य मे तपसो वीर्यं स्वार्जितस्य नरेश्वर।\nएष त्वां स्वशरीरेण नयामि स्वर्गमोजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000060014, "chapter_id": 9060, "verse_number": "१-६०-१४", "content_sanskrit": "दुष्प्रापं स्वशरीरेण स्वर्गं गच्छ नरेश्वर।\nस्वार्जितं किंचिदप्यस्ति मया हि तपसः फलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000060015, "chapter_id": 9060, "verse_number": "१-६०-१५", "content_sanskrit": "राजंस्त्वं तेजसा तस्य सशरीरो दिवं व्रज।\nउक्तवाक्ये मुनौ तस्मिन् सशरीरो नरेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000060016, "chapter_id": 9060, "verse_number": "१-६०-१६", "content_sanskrit": "दिवं जगाम काकुत्स्थ मुनीनां पश्यतां तदा।\nस्वर्गलोकं गतं दृष्ट्वा त्रिशङ्कुं पाकशासनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000060017, "chapter_id": 9060, "verse_number": "१-६०-१७", "content_sanskrit": "सह सर्वैः सुरगणैरिदं वचनमब्रवीत्।\nत्रिशङ्को गच्छ भूयस्त्वं नासि स्वर्गकृतालयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000060018, "chapter_id": 9060, "verse_number": "१-६०-१८", "content_sanskrit": "गुरुशापहतो मूढ पत भूमिमवाक्शिराः।\nएवमुक्तो महेन्द्रेण त्रिशङ्कुरपतत् पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000060019, "chapter_id": 9060, "verse_number": "१-६०-१९", "content_sanskrit": "विक्रोशमानस्त्राहीति विश्वामित्रं तपोधनम्।\nतच्छ्रुत्वा वचनं तस्य क्रोशमानस्य कौशिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000060020, "chapter_id": 9060, "verse_number": "१-६०-२०", "content_sanskrit": "रोषमाहारयत् तीव्रं तिष्ठ तिष्ठेति चाब्रवीत्।\nऋषिमध्ये स तेजस्वी प्रजापतिरिवापरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000060021, "chapter_id": 9060, "verse_number": "१-६०-२१", "content_sanskrit": "सृजन् दक्षिणमार्गस्थान् सप्तर्षीनपरान् पुनः।\nनक्षत्रवंशमपरमसृजत् क्रोधमूर्च्छितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000060022, "chapter_id": 9060, "verse_number": "१-६०-२२", "content_sanskrit": "दक्षिणां दिशमास्थाय ऋषिमध्ये महायशाः।\nसृष्ट्वा नक्षत्रवंशं च क्रोधेन कलुषीकृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000060023, "chapter_id": 9060, "verse_number": "१-६०-२३", "content_sanskrit": "अन्यमिन्द्रं करिष्यामि लोको वा स्यादनिन्द्रकः।\nदैवतान्यपि स क्रोधात् स्रष्टुं समुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000060024, "chapter_id": 9060, "verse_number": "१-६०-२४", "content_sanskrit": "ततः परमसम्भ्रान्ताः सर्षिसङ्घाः सुरासुराः।\nविश्वामित्रं महात्मानमूचुः सानुनयं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000060025, "chapter_id": 9060, "verse_number": "१-६०-२५", "content_sanskrit": "अयं राजा महाभाग गुरुशापपरिक्षतः।\nसशरीरो दिवं यातुं नार्हत्येव तपोधन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000060026, "chapter_id": 9060, "verse_number": "१-६०-२६", "content_sanskrit": "तेषां तद् वचनं श्रुत्वा देवानां मुनिपुंगवः।\nअब्रवीत् सुमहद् वाक्यं कौशिकः सर्वदेवताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000060027, "chapter_id": 9060, "verse_number": "१-६०-२७", "content_sanskrit": "सशरीरस्य भद्रं वस्त्रिशङ्कोरस्य भूपतेः।\nआरोहणं प्रतिज्ञातं नानृतं कर्तुमुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000060028, "chapter_id": 9060, "verse_number": "१-६०-२८", "content_sanskrit": "स्वर्गोऽस्तु सशरीरस्य त्रिशङ्कोरस्य शाश्वतः।\nनक्षत्राणि च सर्वाणि मामकानि ध्रुवाण्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000060029, "chapter_id": 9060, "verse_number": "१-६०-२९", "content_sanskrit": "यावल्लोका धरिष्यन्ति तिष्ठन्त्वेतानि सर्वशः।\nयत् कृतानि सुराः सर्वे तदनुज्ञातुमर्हथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000060030, "chapter_id": 9060, "verse_number": "१-६०-३०", "content_sanskrit": "एवमुक्ताः सुराः सर्वे प्रत्यूचुर्मुनिपुंगवम्।\nएवं भवतु भद्रं ते तिष्ठन्त्वेतानि सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000060031, "chapter_id": 9060, "verse_number": "१-६०-३१", "content_sanskrit": "गगने तान्यनेकानि वैश्वानरपथाद् बहिः।\nनक्षत्राणि मुनिश्रेष्ठ तेषु ज्योतिःषु जाज्वलन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000060032, "chapter_id": 9060, "verse_number": "१-६०-३२", "content_sanskrit": "अवाक्शिरास्त्रिशङ्कुश्च तिष्ठत्वमरसंनिभः।\nअनुयास्यन्ति चैतानि ज्योतींषि नृपसत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000060033, "chapter_id": 9060, "verse_number": "१-६०-३३", "content_sanskrit": "कृतार्थं कीर्तिमन्तं च स्वर्गलोकगतं यथा।\nविश्वामित्रस्तु धर्मात्मा सर्वदेवैरभिष्टुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000060034, "chapter_id": 9060, "verse_number": "१-६०-३४", "content_sanskrit": "ऋषिमध्ये महातेजा बाढमित्येव देवताः।\nततो देवा महात्मानो ऋषयश्च तपोधनाः।\nजग्मुर्यथागतं सर्वे यज्ञस्यान्ते नरोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000060035, "chapter_id": 9060, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे षष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]