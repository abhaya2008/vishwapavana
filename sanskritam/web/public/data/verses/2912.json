[{"id": 2089379, "chapter_id": 2912, "verse_number": "१३-४२-१", "content_sanskrit": "`सुपर्ण उवाच।\nएवं दत्ताभयस्तेन ततोऽहमृषिसत्तमाः।\nनष्टखेदश्रमभयः क्षणेन ह्यभवं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2089380, "chapter_id": 2912, "verse_number": "१३-४२-२", "content_sanskrit": "स शनैर्याति भगवान्गत्या लघुपराक्रमः।\nअहं तु सुमहावेगमास्तायानुव्रजामि तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2089381, "chapter_id": 2912, "verse_number": "१३-४२-३", "content_sanskrit": "स गत्वा दीर्घमध्वानमाकाशममितह्युतिः।\nमनसाऽप्यगमं देवमाससादात्मतत्ववित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2089382, "chapter_id": 2912, "verse_number": "१३-४२-४", "content_sanskrit": "अथ देवः समासाद्य मनसः सदृशं जवम्।\nमोहयित्वा च मां तत्र क्षणेनान्तरधीयत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2089383, "chapter_id": 2912, "verse_number": "१३-४२-५", "content_sanskrit": "तत्राम्बुधरधीरेण भोशब्देनानुनादिना।\nअयं भोऽहमिति प्राह वाक्यं वाक्यविशारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2089384, "chapter_id": 2912, "verse_number": "१३-४२-६", "content_sanskrit": "शब्दानुसारी तु ततस्तं देशमहमाव्रजम्।\nतत्रापश्यं ततश्चाहं श्रीमद्धंसयुतं सरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2089385, "chapter_id": 2912, "verse_number": "१३-४२-७", "content_sanskrit": "स तत्सरः समासाद्य भगवानात्मवित्तमः।\nभोशब्दप्रतिसृष्टेन स्वरेण प्रतिवादिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2089386, "chapter_id": 2912, "verse_number": "१३-४२-८", "content_sanskrit": "विवेश देवः स्वां योनिं मामिदं चाभ्यभाषत।\nविशस्व सलिलं सौम्य सुखमत्र वसामहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2089387, "chapter_id": 2912, "verse_number": "१३-४२-९", "content_sanskrit": "ततश्च प्राविशं तत्र सह तेन महात्मना।\nदृष्टवानद्भुततरं तस्मिन्सरसि भास्वताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2089388, "chapter_id": 2912, "verse_number": "१३-४२-१०", "content_sanskrit": "अग्नीनामप्रणीतानामिद्धानामिन्धनैर्विना।\nदीप्तानामाज्यसिक्तानां स्यानेष्वर्चिष्मतां सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2089389, "chapter_id": 2912, "verse_number": "१३-४२-११", "content_sanskrit": "दीप्तिस्तेषामनाज्यानां प्राप्ताज्यानामिवाभवत्।\nअनिद्धानामिव सतामिद्धानामिव भास्वताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2089390, "chapter_id": 2912, "verse_number": "१३-४२-१२", "content_sanskrit": "अथाहं वरदं देवं नापश्यं तत्र सङ्गतम्।\nततः सम्मोहमापन्नो विषादभगमं परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2089391, "chapter_id": 2912, "verse_number": "१३-४२-१३", "content_sanskrit": "अपश्यं चाग्निहोत्राणि शतशोऽथ सहस्रशः।\nविधिना सम्प्रणीतानि धिष्ण्येष्वाज्यवतां तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2089392, "chapter_id": 2912, "verse_number": "१३-४२-१४", "content_sanskrit": "असंभृष्टतलाश्चैव वेदीः कुसुमसंस्तृताः।\nकुशपद्मोत्पलासङ्गाः कलशांश्च हिरण्मयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2089393, "chapter_id": 2912, "verse_number": "१३-४२-१५", "content_sanskrit": "अग्निहोत्राणि चित्राणि शतशोऽथ सहस्रशः।\nअग्निहोत्राय योग्यानि यानि द्रव्याणि कानिचित्।\nतानि चात्र समृद्धानि दृष्टवानस्म्यनेकशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2089394, "chapter_id": 2912, "verse_number": "१३-४२-१६", "content_sanskrit": "मनोहृद्यतमश्चाग्निः सुरभिः पुण्यलक्षणः।\nआज्यगन्धो मनोग्राही घ्राणचक्षुस्सुखावहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2089395, "chapter_id": 2912, "verse_number": "१३-४२-१७", "content_sanskrit": "तेषां तत्राग्निहोत्राणामीडितानां सहस्रशः।\nसमीपे त्वद्भुततममपश्यमहमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2089396, "chapter_id": 2912, "verse_number": "१३-४२-१८", "content_sanskrit": "चन्द्रांशुकाशशुभ्राणां तुषारोद्भेदवर्चसाम्।\nविमलादित्यभासानां स्थण्डिलानि सहस्रशः।\nदृष्टान्यग्निसमीपे तु ध्युतिमन्ति महान्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2089397, "chapter_id": 2912, "verse_number": "१३-४२-१९", "content_sanskrit": "एषु चाग्निसमीपेषु शुश्राव सुपदाक्षराः।\nप्रभावान्तरितानां तु प्रस्पष्टाक्षरभाषिणाम्।\nऋग्यजुःसामगानां च मधुराः सुस्वरा गिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2089398, "chapter_id": 2912, "verse_number": "१३-४२-२०", "content_sanskrit": "सुसंमृष्टतलैस्तैस्तु बृहद्बिर्दीप्ततेजसैः।\nपावकैः पावितात्माहमभवं लघुविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2089399, "chapter_id": 2912, "verse_number": "१३-४२-२१", "content_sanskrit": "ततोऽहं तेषु धिष्ण्येषु ज्वलमानेषु यज्वनाम्।\nतं देशं प्रणमित्वाऽथ अन्वेष्टुमुपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2089400, "chapter_id": 2912, "verse_number": "१३-४२-२२", "content_sanskrit": "तान्यनेकसहस्राणि पर्यटंस्तु महाजवात्।\nअपश्यमानस्तं देवं ततोऽहं व्यथितोऽभवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2089401, "chapter_id": 2912, "verse_number": "१३-४२-२३", "content_sanskrit": "ततस्तेष्वग्निहोत्रेषु ज्वलत्सु विमलार्चिषु।\nभानुमत्सु न पश्यामि देवदेवं सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2089402, "chapter_id": 2912, "verse_number": "१३-४२-२४", "content_sanskrit": "ततोऽहं तानि दीप्तानि परीय व्यस्थितेन्द्रियः।\nनान्तं तेषां प्रपश्यामि खेदश्च सहसाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2089403, "chapter_id": 2912, "verse_number": "१३-४२-२५", "content_sanskrit": "विसृत्य सर्वतो दृष्टिं भयमोहसमन्वितः।\nश्रमं परंममापन्नश्चिन्तयानस्त्वचेतनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2089404, "chapter_id": 2912, "verse_number": "१३-४२-२६", "content_sanskrit": "तस्मिन्न खलु वर्तेऽहं लोके यत्रैतदीदृशम्।\nऋग्यजुस्सामनिर्घोषः श्रूयते न च दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2089405, "chapter_id": 2912, "verse_number": "१३-४२-२७", "content_sanskrit": "न च पश्यामि तं देवं येनाहमिह चोदितः।\nएवं चिन्तासभापन्नः प्रध्यातुमुपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2089406, "chapter_id": 2912, "verse_number": "१३-४२-२८", "content_sanskrit": "ततश्चिन्तयतो मह्यं मोहेनाविष्टचेतसः।\nमहाशब्दः प्रादुरासीत्सुभृशं मे व्यथाकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2089407, "chapter_id": 2912, "verse_number": "१३-४२-२९", "content_sanskrit": "अथाहं सहसा तत्र शृणोमि विपुलध्वनिम्।\nअपश्यं च सुपर्णानां सहस्राण्ययुतानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2089408, "chapter_id": 2912, "verse_number": "१३-४२-३०", "content_sanskrit": "अभ्यद्रवन्त मामेव विपुलद्युतिरंहसः।\nतेषामहं प्रभावेण सर्वथैवावरोऽभवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2089409, "chapter_id": 2912, "verse_number": "१३-४२-३१", "content_sanskrit": "सोऽहं समन्ततः सर्वैः सुपर्णैरतितेजसैः।\nदृष्ट्वाऽऽत्मानं परिगतं सम्भ्रमं परमं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2089410, "chapter_id": 2912, "verse_number": "१३-४२-३२", "content_sanskrit": "विनयावनतो भूत्वा नमश्चक्रे महात्मने।\nअनादिनिधनायैभिर्नामभिः परमात्मने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2089411, "chapter_id": 2912, "verse_number": "१३-४२-३३", "content_sanskrit": "नारायणाय शुद्धाय शाश्वताय ध्रुवाय च।\nभूतभव्यभवेशाय शिवाय शिवमूर्तये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2089412, "chapter_id": 2912, "verse_number": "१३-४२-३४", "content_sanskrit": "शिवयोनेः शिवाद्यायि शिवपूज्यतमाय च।\nघोररूपाय महते युगान्तकरणाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2089413, "chapter_id": 2912, "verse_number": "१३-४२-३५", "content_sanskrit": "विश्वाय विश्वदेवाय विश्वेशाय महात्मने।\nसहस्रोदरपादाय सहस्रनयनाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2089414, "chapter_id": 2912, "verse_number": "१३-४२-३६", "content_sanskrit": "सहस्रबाहवे चैव सहस्रवदनाय च।\nशुचिश्रवाय महते ऋतुसंवत्सराय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2089415, "chapter_id": 2912, "verse_number": "१३-४२-३७", "content_sanskrit": "ऋग्यजुःसामवक्त्राय अथर्वशिरसे नमः।\nहृषीकेशाय कृष्णाय द्रुहिणोरुक्रमाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2089416, "chapter_id": 2912, "verse_number": "१३-४२-३८", "content_sanskrit": "बृहद्वेगाय तार्क्ष्याय वराहायैकशृङ्गिणे।\nशिपिविष्टाय सत्याय हरयेऽथ शिखण्डिने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2089417, "chapter_id": 2912, "verse_number": "१३-४२-३९", "content_sanskrit": "हुताशायोर्ध्ववक्त्राय रौद्रानीकाय साधवे।\nसिन्धवे सिन्धुवर्षघ्ने देवानां सिन्धवे नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2089418, "chapter_id": 2912, "verse_number": "१३-४२-४०", "content_sanskrit": "गरुत्मते त्रिनेत्राय सुधर्माय वृषाकृते।\nसम्म्राडुग्रे संकृतये विरजे सम्भवे भवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2089419, "chapter_id": 2912, "verse_number": "१३-४२-४१", "content_sanskrit": "वृषाय वृषरूपाय विभवे भूर्भुवाय व।\nदीप्तसृष्टाय यज्ञाय स्थिराय स्थविराय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2089420, "chapter_id": 2912, "verse_number": "१३-४२-४२", "content_sanskrit": "अच्युताय तुषाराय वीराय च समाय च।\nजिष्णवे पुरुहूताय वसिष्ठाय वराय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2089421, "chapter_id": 2912, "verse_number": "१३-४२-४३", "content_sanskrit": "सत्येशाय सुरेशाय हरयेऽथ शिखण्डिने।\nबर्हिषाय वरेण्याय वसवे विश्ववेधसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2089422, "chapter_id": 2912, "verse_number": "१३-४२-४४", "content_sanskrit": "किरीटिने सुकेशाय वासुदेवाय शुष्मिणे।\nबृहदुक्थ्यसुषेणाय युग्ये दुन्दुभये तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2089423, "chapter_id": 2912, "verse_number": "१३-४२-४५", "content_sanskrit": "भयेसखाय विभवे भरद्वाजेऽभयाय च।\nभास्कराय च चन्द्राय पद्मनाभाय भूरिणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2089424, "chapter_id": 2912, "verse_number": "१३-४२-४६", "content_sanskrit": "पुनर्वसुभृतत्वाय जीवप्रभविषाय च।\nवषट्काराय स्वाहाय स्वधाय निधनाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2089425, "chapter_id": 2912, "verse_number": "१३-४२-४७", "content_sanskrit": "ऋचे च यजुषे साम्ने त्रैलोक्यपतये नमः।\nश्रीपद्मायात्मसदृशे धरणीधारिणे परे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2089426, "chapter_id": 2912, "verse_number": "१३-४२-४८", "content_sanskrit": "सौम्यासौम्यस्वरूपाय सौम्ये सुमनसे नमः।\nविश्वाय च सुविश्वाय विश्वरूपधराय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2089427, "chapter_id": 2912, "verse_number": "१३-४२-४९", "content_sanskrit": "केशवाय सुकेशाय रश्मिकेशाय भूरिणे।\nहिरण्यगर्भाय नमः सौम्याय वृषरूपिणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2089428, "chapter_id": 2912, "verse_number": "१३-४२-५०", "content_sanskrit": "नारायणाग्र्यवपुषे पुरुहूताय वज्रिणे।\nवर्मिणे वृषसेनाय धर्मसेनाय रोधसे।\nमुनये ज्वरमुक्तायि ज्वराधिपतये नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2089429, "chapter_id": 2912, "verse_number": "१३-४२-५१", "content_sanskrit": "अनेत्राय त्रिनेत्राय पिङ्गलाय विडूर्मिणे।\nतपोब्रह्मनिधानाय युगपर्यायिणे नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2089430, "chapter_id": 2912, "verse_number": "१३-४२-५२", "content_sanskrit": "शरणाय शरण्याय भक्तेष्टशरणाय च।\nनमः सर्वभवेशाय भूतभव्यभवाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2089431, "chapter_id": 2912, "verse_number": "१३-४२-५३", "content_sanskrit": "पाहि मां देवदेवेश कोप्यजोसि सनातनः।\nएवं गतोस्मि शरणं शरण्यं ब्रह्मयोनिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2089432, "chapter_id": 2912, "verse_number": "१३-४२-५४", "content_sanskrit": "स्तव्यं स्तवं स्तुतवतस्तत्तमो मे प्रणश्यत।\nभयं च मे व्यपगतं पक्षिणोऽन्तर्हिताऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2089433, "chapter_id": 2912, "verse_number": "१३-४२-५५", "content_sanskrit": "शृणोमि च गिरं दिव्यामन्तर्धानगतां शिवाम्।\nमा भैर्गरुत्मन्दान्तोसि पुनः सेन्द्रान्दिवौकसः।\nस्वं चैव भवनं गत्वा द्रक्ष्यसे पुत्रबान्धवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2089434, "chapter_id": 2912, "verse_number": "१३-४२-५६", "content_sanskrit": "ततस्तस्मिन्क्षणेनैव सहसैव महाद्युतिः।\nप्रत्यदृश्यत तेजस्वी पुरस्तात्स ममान्तिके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2089435, "chapter_id": 2912, "verse_number": "१३-४२-५७", "content_sanskrit": "समागम्य ततस्तेन शिवेन परमात्मना।\nअपश्यं चाहमायान्तं नरनारायणाश्रमे।\nचतुर्द्विगुणविन्यासं तं च देवं सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2089436, "chapter_id": 2912, "verse_number": "१३-४२-५८", "content_sanskrit": "यजतस्तानृषीन्देवान्वदतो ध्यायतो मुनीन्।\nयुक्तान्सिद्धान्नैष्ठिकांश्च जपतो यजतो गृहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2089437, "chapter_id": 2912, "verse_number": "१३-४२-५९", "content_sanskrit": "पुष्पपूरपरिक्षिप्तं धूपितं दीपितं हुतम्।\nवन्दितं सिक्तसम्मृष्टं नरनारायणाश्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2089438, "chapter_id": 2912, "verse_number": "१३-४२-६०", "content_sanskrit": "तदद्भुतमहं दृष्ट्वा विस्मितोस्मि तदाऽनघाः।\nजगाम शिरसा देवं प्रयतेनान्तरात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2089439, "chapter_id": 2912, "verse_number": "१३-४२-६१", "content_sanskrit": "तदत्यद्भुतसङ्कासं किमेतदिति चिन्तयन्।\nनाध्यगच्छं परं दिव्यं तस्य सर्वभवात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2089440, "chapter_id": 2912, "verse_number": "१३-४२-६२", "content_sanskrit": "प्रणिपत्य सुदुर्धर्षं पुनः पुनरुदीक्ष्य च।\nशिरस्यञ्जलिमाधाय विस्मयोत्फुल्ललोचनः।\nअवोचं तमदीनार्थं श्रेष्ठानां श्रेष्ठमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2089441, "chapter_id": 2912, "verse_number": "१३-४२-६३", "content_sanskrit": "नमस्ते भगवन्देव भूतभव्यभवत्प्रभो।\nयदेतदद्भुतं देव मया दृष्टं त्वदाश्रयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2089442, "chapter_id": 2912, "verse_number": "१३-४२-६४", "content_sanskrit": "अनादिमद्यपर्यन्तं किं तच्छंसितुमर्हसि।\nयदि जानासि सां भक्तं यदि वाऽनुग्रहो मयि।\nशंस सर्वमशेषेण श्रोतव्यं यदि चेन्मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2089443, "chapter_id": 2912, "verse_number": "१३-४२-६५", "content_sanskrit": "स्वभावस्तव दुर्ज्ञेयः प्रादुर्भावो भवस्य च।\nभवद्भूतभविष्येश सर्वथा गहनं भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2089444, "chapter_id": 2912, "verse_number": "१३-४२-६६", "content_sanskrit": "ब्रूहि सर्वमशेषेण तदाश्चर्यं महामुने।\nकिं तदत्यद्भुतं वृत्तं तेष्वग्निषु समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2089445, "chapter_id": 2912, "verse_number": "१३-४२-६७", "content_sanskrit": "कानि तान्यग्निहोत्राणि केषां शब्दः श्रुतो मया।\nशृण्वतां ब्रह्म सततमदृश्यानां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2089446, "chapter_id": 2912, "verse_number": "१३-४२-६८", "content_sanskrit": "एतन्मे भगवन्कृष्ण ब्रूहि सर्वमशेषतः।\nगृणन्त्यग्निसमीपेषु के च ते ब्रह्मराशयः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2089447, "chapter_id": 2912, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि द्विचत्वारिंशोऽध्यायः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]