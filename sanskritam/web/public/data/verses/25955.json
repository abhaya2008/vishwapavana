[{"id": 7005955000, "chapter_id": 25955, "verse_number": "१-१३८-१", "content_sanskrit": "(इति व्रतानि समाप्तानि) ।\nहरिरुवाच ।\nराज्ञां वंशान्प्रवक्ष्यामि वंशानुचरितानि च ।\nविष्णुनाभ्यब्जतो ब्रह्मा दक्षोऽङ्गुष्ठाच्च तस्य वै ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005955001, "chapter_id": 25955, "verse_number": "१-१३८-२", "content_sanskrit": "ततोऽपितर्विवस्वांश्च ततः सूनुर्विवस्वतः मनुरिक्ष्वाकुशर्याती नृगो धृष्टः प्रषध्रकः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005955002, "chapter_id": 25955, "verse_number": "१-१३८-३", "content_sanskrit": "नरिष्यन्तश्च नाभागो दिष्टः शशक एव च ।\nमनोरासीदिला कन्या सुद्युम्नोऽस्य सुतोऽभवत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005955003, "chapter_id": 25955, "verse_number": "१-१३८-४", "content_sanskrit": "इलायां तु बुधाज्जातो राजा रुद्र पुरूरवाः ।\nसुतास्त्रयश्च सुद्युम्नादुत्कलो विनतो गयः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005955004, "chapter_id": 25955, "verse_number": "१-१३८-५", "content_sanskrit": "अभृच्छ्रद्रो गोवधात्तु पृषध्रस्तु मनोः सुतः। ।\nकरूषात्क्षत्त्रिया जाता कारूषा इति विश्रुताः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005955005, "chapter_id": 25955, "verse_number": "१-१३८-६", "content_sanskrit": "दिष्टपुत्रस्तु नाभागो वैश्यातामगमत्स च ।\nतस्माद्भलन्दनः पुत्रो वत्सप्रीतिर्भलन्दनात् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005955006, "chapter_id": 25955, "verse_number": "१-१३८-७", "content_sanskrit": "ततः पांशुः खनित्रोऽभूद्भूपस्तस्मात्ततः क्षुप ।\nक्षुपाद्विंशोऽभवत्पुत्रो विंशाज्जातो विविंशकः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005955007, "chapter_id": 25955, "verse_number": "१-१३८-८", "content_sanskrit": "विविंशाच्च खनीनेत्रो विभूतिस्तत्सुतः स्मृतः ।\nकरन्धमो विभूतेस्तु ततो जातोऽप्यविक्षितः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005955008, "chapter_id": 25955, "verse_number": "१-१३८-९", "content_sanskrit": "मरुत्तोऽविक्षितस्यापि नरिष्यन्तस्ततः स्मतः ।\nनरिष्यन्तात्तमो जातस्ततोभूद्राजवर्धनः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005955009, "chapter_id": 25955, "verse_number": "१-१३८-१०", "content_sanskrit": "राजवर्धात्सुधृतिश्च नरोऽभूत्सुधृतेः सुतः ।\nनराच्च केवलः पुत्रः केवलाद्धुन्धुमानपि ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005955010, "chapter_id": 25955, "verse_number": "१-१३८-११", "content_sanskrit": "धुन्धुमतो वेगवांश्च बुधो वेगवतः सुतः ।\nतृणबिन्दुर्बुधाज्जातः कान्या चैलविला तथा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005955011, "chapter_id": 25955, "verse_number": "१-१३८-१२", "content_sanskrit": "विशालं जनयामास तृणबिन्दोस्त्वलम्बुसा ।\nविशालाद्धेमचन्द्रोऽभूद्धेम चन्द्राच्च चन्द्रकः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005955012, "chapter_id": 25955, "verse_number": "१-१३८-१३", "content_sanskrit": "धूम्राश्वश्चैव चन्द्रात्तु धूम्राश्वात्सृञ्जयसथा ।\nसञ्जयात्सहदेवोऽभूत्कृशाश्वस्तत्सुतोऽभवत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005955013, "chapter_id": 25955, "verse_number": "१-१३८-१४", "content_sanskrit": "कृशाश्वात्सोमदत्तस्तुततोऽभूज्जनमेजयः ।\nतत्पुत्रश्च सुमन्तिश्च एते वैशालका नृपाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005955014, "chapter_id": 25955, "verse_number": "१-१३८-१५", "content_sanskrit": "शर्यातेस्तु सुकन्याबूत्सा भार्या च्यवनस्य त। ।\nअनन्तो नाम शार्यते रनन्ताद्रेवतोऽभवत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005955015, "chapter_id": 25955, "verse_number": "१-१३८-१६", "content_sanskrit": "रैवतो रेवतस्यापि रैवताद्रेवती सुता ।\nधृष्टस्य धार्ष्टर्(त) कं क्षेत्रं वैष्णवं (श्यकं) तद्वभूव ह ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005955016, "chapter_id": 25955, "verse_number": "१-१३८-१७", "content_sanskrit": "नाभागपुत्रो नेष्ठो ह्यम्बरीषोऽपि तत्सुत। ।\nअम्बरीषाद्विरूपोऽभूत्पृषदश्वो विरूपतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005955017, "chapter_id": 25955, "verse_number": "१-१३८-१८", "content_sanskrit": "रथीनरश्च तत्पुत्रो वासुदेवपरायणः ।\nइक्ष्वाकोस्तु त्रयः पुत्राः विकुक्षिनिमिदण्डकाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005955018, "chapter_id": 25955, "verse_number": "१-१३८-१९", "content_sanskrit": "इक्ष्वाकुजो विकुक्षिस्तु शशादः शशभक्षणात् ।\nपुरञ्जयः शशादाच्च ककुत्स्थाख्योऽभवत्सुतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005955019, "chapter_id": 25955, "verse_number": "१-१३८-२०", "content_sanskrit": "अनेनास्तु ककुत्सथाच्च पृथुः पुत्रस्त्वनेनसः ।\nविश्वरातः पृथोः पुत्र आर्द्रेऽभूद्विश्वराततः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005955020, "chapter_id": 25955, "verse_number": "१-१३८-२१", "content_sanskrit": "युवनाश्वोऽभवच्चार्द्राच्छावस्तो युवनाश्वतः ।\nबृहदश्वस्तुशावस्तात्तत्पुत्रः कुवलाश्वकः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005955021, "chapter_id": 25955, "verse_number": "१-१३८-२२", "content_sanskrit": "धुन्धुमारो हि विक्यातो दृढश्वश्चततोऽभवत् ।\nचन्द्राश्वः कपिलाश्वश्च हर्यश्वश्च दृढश्वतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005955022, "chapter_id": 25955, "verse_number": "१-१३८-२३", "content_sanskrit": "हर्यश्वाच्च निकुम्बोऽभूद्धिताश्वश्च निकुम्भत। ।\nपूजाश्वश्च हिताश्वाच्च तत्सतो युवनाश्वकः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005955023, "chapter_id": 25955, "verse_number": "१-१३८-२४", "content_sanskrit": "युवनाश्वाच्च मान्धाता बिन्दुमत्यास्ततोऽभवत् ।\nमुचुकुन्दोऽम्बरीषश्च पुरुकुत्सस्त्रयः सुताः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005955024, "chapter_id": 25955, "verse_number": "१-१३८-२५", "content_sanskrit": "पञ्चाशत्कन्यकाश्चैव भार्यास्ताः सौभरेर्मुने। ।\nयुवनाश्वोऽम्बरीषाच्च हरितो युवनाश्वतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005955025, "chapter_id": 25955, "verse_number": "१-१३८-२६", "content_sanskrit": "पुरुकुत्सान्नर्मदायां त्रसदस्युरबूत्सुतः ।\nअनरण्यस्ततो जातो हर्यश्वोऽप्यनरण्यतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005955026, "chapter_id": 25955, "verse_number": "१-१३८-२७", "content_sanskrit": "तत्पुत्रोऽभूद्वसुमनास्त्रिधन्वा तस्य चात्मजः ।\nत्रय्यारुणस्तस्य पुत्रस्तस्त सत्यरतः सुतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005955027, "chapter_id": 25955, "verse_number": "१-१३८-२८", "content_sanskrit": "यस्त्रिशङ्कुः समाख्यातो हरिश्चन्द्रोऽभवत्त ।\nहरिश्चन्द्राद्रोहिताश्वो हरितो रोहिताश्वतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005955028, "chapter_id": 25955, "verse_number": "१-१३८-२९", "content_sanskrit": "हरितस्य सुतश्चञ्चुश्चञ्चोश्च विजयः सुत। ।\nविजयाद्रुरुको जज्ञे रुरुकात्तु वृकः सुतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005955029, "chapter_id": 25955, "verse_number": "१-१३८-३०", "content_sanskrit": "वृकाद्बाहुर्नृपोऽभूच्च बाहोस्तु सगरः स्मृतः ।\nषष्टिः पुत्र सहस्राणि सुमत्यां सगराद्धर ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005955030, "chapter_id": 25955, "verse_number": "१-१३८-३१", "content_sanskrit": "केशिन्यामेक एवासावसमञ्जससंज्ञकः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005955031, "chapter_id": 25955, "verse_number": "१-१३८-३२", "content_sanskrit": "तस्यांशुमान्सुतो विद्वान्दिलीपस्तत्सुतोऽभवत। ।\nभगीरथो दिलीपाच्च यो गङ्गामानयद्भुवम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005955032, "chapter_id": 25955, "verse_number": "१-१३८-३३", "content_sanskrit": "श्रुतो भगीरथसुतो नाभगश्च श्रुतात्किल ।\nनाभागादम्बरीषोऽभूत्सिन्दुद्वीपोऽम्बरीषतः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005955033, "chapter_id": 25955, "verse_number": "१-१३८-३४", "content_sanskrit": "सिन्दुद्वीपस्यायुतायुरृतुपर्णस्तदात्मजः ।\nऋतुषर्णात्सर्वकामः सुदासोऽभूत्तदात्मजः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005955034, "chapter_id": 25955, "verse_number": "१-१३८-३५", "content_sanskrit": "सुदासस्य च सौदासो नाम्ना मित्रसहः स्मृतः ।\nकल्माष पादसंज्ञश्च दमयन्त्यां तदात्मजः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005955035, "chapter_id": 25955, "verse_number": "१-१३८-३६", "content_sanskrit": "अश्वकाख्योऽभवत्पुत्रो ह्यश्वकान्मूल(नमच्छ) कोऽभवत् ।\nततो दशरथो राजा तस्य चैलविलः सुतः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005955036, "chapter_id": 25955, "verse_number": "१-१३८-३७", "content_sanskrit": "तस्य विश्वसहः पुत्रः खट्वाङ्गश्च तदात्मजः ।\nखट्वाङ्गद्दीर्घबाहुश्च दीर्घबाहोर्ह्यजः सुतः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005955037, "chapter_id": 25955, "verse_number": "१-१३८-३८", "content_sanskrit": "तस्य पुत्त्रो दशरथश्चत्वारस्तत्सुताःसमृताः ।\nरामलक्ष्मणशत्रुघ्नभरताश्च महाबलाः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005955038, "chapter_id": 25955, "verse_number": "१-१३८-३९", "content_sanskrit": "रामात्कुशलवौ जातौ भरतात्तार्क्षपुष्करौ ।\nचित्राङ्गदश्चन्द्रकेतुर्लक्ष्मणात्संबभूवतुः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005955039, "chapter_id": 25955, "verse_number": "१-१३८-४०", "content_sanskrit": "सुबाहुशूरसेनौ च शत्रुघ्नात्संबभूवतुः ।\nकुशस्य चातिथिः पुत्रो निषधो ह्यतिथेः सुतः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005955040, "chapter_id": 25955, "verse_number": "१-१३८-४१", "content_sanskrit": "निषधस्य नलः पुत्रो नलस्य च नभाः स्मत ।\nनभसः पुण्डरीकस्तुक्षेमधन्वा तदात्मजः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005955041, "chapter_id": 25955, "verse_number": "१-१३८-४२", "content_sanskrit": "देवानीकस्तस्य पुत्रो देवानीकादहीनकः ।\nअहीनकाद्रुरुर्यज्ञे पारियात्रो रुरोः सुतः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005955042, "chapter_id": 25955, "verse_number": "१-१३८-४३", "content_sanskrit": "पारियात्राद्दलो यज्ञे दल पुत्रश्छलः स्मृतः ।\nछलादुक्थस्ततो ह्युक्थाद्वज्रनाभस्ततो गणः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005955043, "chapter_id": 25955, "verse_number": "१-१३८-४४", "content_sanskrit": "उषिताश्वो गणाज्जज्ञे ततो विश्वसहोऽभवत् ।\nहिरण्यनाभस्तत्पुत्रस्तत्पुत्रः पुष्पकः स्मृतः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005955044, "chapter_id": 25955, "verse_number": "१-१३८-४५", "content_sanskrit": "ध्रुवसन्धिरभूत्पुष्पाद्ध्रुवसन्धेः सुदर्शनः ।\nसुदर्शनादग्निवर्णः पद्मवणोऽग्निवर्णतः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005955045, "chapter_id": 25955, "verse_number": "१-१३८-४६", "content_sanskrit": "शीघ्रस्तु पद्मवर्णात्तु शीघ्रात्पुत्रो मरुस्तभूत् ।\nमरोः प्रसुश्रुतः पुत्रस्तस्य चोदावसुः सुतः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005955046, "chapter_id": 25955, "verse_number": "१-१३८-४७", "content_sanskrit": "उदावसोर्नन्दिवर्धनः सुकेतुर्नन्दिवर्धनत ।\nसुकेतोर्देवरातोऽभूद्वृहदुक्थस्ततः सुतः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005955047, "chapter_id": 25955, "verse_number": "१-१३८-४८", "content_sanskrit": "बृहदुक्थान्महावीर्यः सुधृतिस्तस्य चात्मजः ।\nसुधृतेर्धृष्टकेतुश्च हर्यश्वो धृष्टकेतुतः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005955048, "chapter_id": 25955, "verse_number": "१-१३८-४९", "content_sanskrit": "हर्यश्वात्तु मरुर्जातो मरोः प्रतीन्धकोवत् ।\nप्रतीन्धकात्कृतिरथो देवमीढस्तदात्मजः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005955049, "chapter_id": 25955, "verse_number": "१-१३८-५०", "content_sanskrit": "विबुधो देवमीढात्तु विबुधात्तु महाधृतिः ।\nमहाधृतेः कीर्तिरातो महारोमा तदात्मजः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005955050, "chapter_id": 25955, "verse_number": "१-१३८-५१", "content_sanskrit": "महारोम्णः स्वर्णरोमा ह्रस्वरोमा तदात्मजः ।\nसीरध्वजो ह्रस्वरोम्णः तस्य सीताभवत्सुता ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005955051, "chapter_id": 25955, "verse_number": "१-१३८-५२", "content_sanskrit": "भ्राता कुशध्वजस्तस्य सीरध्वजात्तु भानुमान् ।\nशतद्युम्नो भानुमतः शतद्युम्नाच्छुचिः स्मृतः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005955052, "chapter_id": 25955, "verse_number": "१-१३८-५३", "content_sanskrit": "ऊर्जनामा शुचेः पुत्रः सनद्वाजस्तदात्मजः ।\nसनद्वाजात्कुलिर्जातोऽनञ्जनस्तु कुलेः सुतः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005955053, "chapter_id": 25955, "verse_number": "१-१३८-५४", "content_sanskrit": "अनञ्जनाच्च कुलजित्तस्यापि चाधिनेमिकः ।\nश्रुतायुस्तस्य पुत्रोऽभूत्सुपार्श्वश्च तदात्मजः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005955054, "chapter_id": 25955, "verse_number": "१-१३८-५५", "content_sanskrit": "सुपार्श्वात्सृंजयो जातः क्षेमारिः सृजयात्समृतः ।\nक्षेमारि तस्त्वनेनाश्च तस्य रामरथः स्मृतः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005955055, "chapter_id": 25955, "verse_number": "१-१३८-५६", "content_sanskrit": "सत्यरथो रामरथात्तस्मादुपगुरुः स्मृतः ।\nउपगुरोरुपगुप्तः स्वागतश्चोपगुप्ततः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005955056, "chapter_id": 25955, "verse_number": "१-१३८-५७", "content_sanskrit": "स्वनरः स्वागताज्जज्ञे सुवर्चास्तस्य चात्मजः ।\nसुवर्चसः सुपार्श्वस्तु सुश्रुतश्च सुपार्श्वतः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005955057, "chapter_id": 25955, "verse_number": "१-१३८-५८", "content_sanskrit": "जयस्तु सुश्रुताज्जज्ञे जयात्तु विजयोऽभवत। ।\nविजयस्य ऋतः पुत्रः ऋतस्य सुनयः सुतः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005955058, "chapter_id": 25955, "verse_number": "१-१३८-५९", "content_sanskrit": "सुनयाद्वीतहव्यस्तु वीतहव्याद्धतिः स्मृतः ।\nबहुलाश्वो धृतेः पुत्रो बहुलाश्वात्कृतिः स्मृतः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7005955059, "chapter_id": 25955, "verse_number": "१-१३८-६०", "content_sanskrit": "जनकस्य द्वये वंशे उक्तो योगसमाश्रयः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]