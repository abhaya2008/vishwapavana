[{"id": 2088570, "chapter_id": 2890, "verse_number": "१३-२०-१", "content_sanskrit": "`भीष्म उवाच।\nयुधिष्ठिर महाबाहो शृणु राजन्यथातथम्।\nगरुडं पक्षिणां श्रेष्ठं वैनतेयं महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2088571, "chapter_id": 2890, "verse_number": "१३-२०-२", "content_sanskrit": "तथा च गरुडो राजन्सुपर्णश्च यथाऽभवत्।\nयथा च भुजगान्हन्ति तथा मे ब्रुवतः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2088572, "chapter_id": 2890, "verse_number": "१३-२०-३", "content_sanskrit": "पुराऽहं तात रामेणि जामदग्न्येन धीमता।\nकैलासशिखरे रम्ये मृगान्निघ्नन्सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2088573, "chapter_id": 2890, "verse_number": "१३-२०-४", "content_sanskrit": "तमहं तात दृष्टैव शस्त्रण्युत्सृज्य सर्वशः।\nअभिवाद्य पूर्वं रामाय विनयेनोपतस्थिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2088574, "chapter_id": 2890, "verse_number": "१३-२०-५", "content_sanskrit": "तमहं कथान्ते वरदं सुपर्णस्य बलौजसी।\nअपृच्छं स च मां प्रीतः प्रत्युवाच युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2088575, "chapter_id": 2890, "verse_number": "१३-२०-६", "content_sanskrit": "कद्रूश्च विनता चास्तां प्रजापतिसुते उभे।\nते तु धर्मेणोपयेमे मारीचः कश्यपः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2088576, "chapter_id": 2890, "verse_number": "१३-२०-७", "content_sanskrit": "प्रादात्ताभ्यां वरं प्रीतो भार्याभ्यां सुमहातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2088577, "chapter_id": 2890, "verse_number": "१३-२०-८", "content_sanskrit": "तत्र कद्रूर्वरं वव्रे पुत्राणां दशतः शतम्।\nतुल्यतेजःप्रभावानां सर्वेषां तुल्यजन्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2088578, "chapter_id": 2890, "verse_number": "१३-२०-९", "content_sanskrit": "विनता तु वव्रे द्वौ पुत्रौ वीरौ भरतसत्तम।\nकद्रूपुत्रसहस्रेण तुल्यवेगपराक्रमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2088579, "chapter_id": 2890, "verse_number": "१३-२०-१०", "content_sanskrit": "स तु ताभ्यां वरं प्रादात्तथेत्युक्त्वा महातपाः।\nजनयामास तान्पुत्रां स्ताभ्यामासीद्यथा पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2088580, "chapter_id": 2890, "verse_number": "१३-२०-११", "content_sanskrit": "कद्रूः प्रजज्ञे ह्यण्डानां तथैव दशतःशतम्।\nअण्डे द्वे विनता चैव दर्शनीयतरे शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2088581, "chapter_id": 2890, "verse_number": "१३-२०-१२", "content_sanskrit": "तानि त्वण्डानि तु तयोः कद्रूविनतयोर्द्वयोः।\nसोपस्वेदेषु पात्रेषु निदधुः परिचारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2088582, "chapter_id": 2890, "verse_number": "१३-२०-१३", "content_sanskrit": "निस्सरन्ति तदाऽण्डेभ्यः कद्रूपुत्रा भुजङ्गमाः।\nपञ्चवर्षशते काले दृष्ट्वाऽमोघबलौजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2088583, "chapter_id": 2890, "verse_number": "१३-२०-१४", "content_sanskrit": "विनता तेषु जातेषु पन्नगेषु महात्मसु।\nविपुत्रा पुत्रसंतापाद्दण्डमेकं बिभेद ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2088584, "chapter_id": 2890, "verse_number": "१३-२०-१५", "content_sanskrit": "किमनेन करिष्येऽहमिति वाक्यमभाषत।\nनहि पञ्चशते काले पुरा पुत्रौ ददर्श सा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2088585, "chapter_id": 2890, "verse_number": "१३-२०-१६", "content_sanskrit": "सापश्यदण्डान्निष्क्रान्तं विनापत्रं मनस्विनम्।\nपूर्वकायोपसम्पन्नं वियुक्तमितरेण ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2088586, "chapter_id": 2890, "verse_number": "१३-२०-१७", "content_sanskrit": "दृष्ट्वा तु तं तथारूपमसमग्रशरीरिणम्।\nपुत्रदुःखान्विताऽशोचत्स च पक्षी तथा गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2088587, "chapter_id": 2890, "verse_number": "१३-२०-१८", "content_sanskrit": "अब्रवीच्च मुदा युक्तः पर्यश्रुनयनस्तदा।\nमातरं च पलाशी ह हतोऽहमिति चासकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2088588, "chapter_id": 2890, "verse_number": "१३-२०-१९", "content_sanskrit": "न त्वया काङ्क्षितः कालो यावानेवात्यगात्पुरा।\nआवां भवाय पुत्रौ ते श्वसनाद्बलवत्तरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2088589, "chapter_id": 2890, "verse_number": "१३-२०-२०", "content_sanskrit": "ईर्ष्याक्रोधाभिभूतत्वाद्योहमेवं कृतस्त्वया।\nतस्मात्त्वमपि मे मातर्दासीभावं गमिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2088590, "chapter_id": 2890, "verse_number": "१३-२०-२१", "content_sanskrit": "पञ्चवर्षशतानि त्वं स्पर्धसे वै यया सह।\nदासी तस्या भवित्रीति साश्रुपातमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2088591, "chapter_id": 2890, "verse_number": "१३-२०-२२", "content_sanskrit": "एष चैव महाभागे बली बलवतांवरः।\nमोक्षयिष्यति ते मातर्दासीभावान्ममानुजः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2088592, "chapter_id": 2890, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि विंशोऽध्यायः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]