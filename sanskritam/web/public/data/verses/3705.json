[{"id": 2126284, "chapter_id": 3705, "verse_number": "", "content_sanskrit": "बृहदश्चः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2126285, "chapter_id": 3705, "verse_number": "१", "content_sanskrit": "दमयन्ती तु तच्छ्रुत्वा वचो हंसस्य भारत ।\nतदा प्रभृति न स्वस्था नळं प्रति बभूव सा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2126286, "chapter_id": 3705, "verse_number": "२", "content_sanskrit": "ततश्चिन्तापरा दीना विवर्णवदना कृशा ।\nबभूव दमयन्ती तु निःश्वासपरमा तदा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2126287, "chapter_id": 3705, "verse_number": "३", "content_sanskrit": "ऊर्ध्वदृष्टिर्ध्यानपरा बभूवोन्मत्तदर्शना ।\nन शय्यासनभोगेषु रतिं विन्दति कर्हिचित् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2126288, "chapter_id": 3705, "verse_number": "४", "content_sanskrit": "न नक्तं न दिवा शेते हाहेति वदती मुहुः ।\nतामस्वस्थां तदाकारां सख्यस्ता जज्ञुरिङ्गितैः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2126289, "chapter_id": 3705, "verse_number": "५", "content_sanskrit": "ततो विदर्भपतये दमयन्त्याः सखीगणः ।\nन्यवेदयत चास्वस्थां दमयन्तीं नरेश्वर\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2126290, "chapter_id": 3705, "verse_number": "६", "content_sanskrit": "तच्छ्रुत्वा नृपतिर्भीमो दमयन्तीसखीगणात् ।\nचिन्तयामास तत् कार्यं सुमहत् स्वां सुतां प्रति ।\nकिमस्मद्दुहिता मेऽद्य नातिस्वस्थोपलक्ष्यते \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2126291, "chapter_id": 3705, "verse_number": "७", "content_sanskrit": "स समीक्ष्य महीपालः स्वसुतां प्राप्तयौवनाम् ।\nअपश्यदात्मनः कार्यं दमयन्त्याः स्वयंवरम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2126292, "chapter_id": 3705, "verse_number": "८", "content_sanskrit": "स सन्निमन्त्रयामास महीपालान् विशांपते ।\nएषोऽनुभूयतां वीराः स्वयंवर इति स्मह\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2126293, "chapter_id": 3705, "verse_number": "९", "content_sanskrit": "श्रुत्वा तु पार्थिवाः सर्वे दमयन्त्याः स्वयंवरम् ।\nअभिजग्मुस्तदा भीमं राजानो भीमशासनात्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2126294, "chapter_id": 3705, "verse_number": "१०", "content_sanskrit": "हस्त्यश्वरथघोषेण नादयन्तो वसुन्धराम् ।\nविचित्रमाल्याभरणैर्बलैर्भृत्यैः स्वलङ्कृताः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2126295, "chapter_id": 3705, "verse_number": "११", "content_sanskrit": "एतस्मिन्नेव काले तु पुराणावृषिसत्तमौ ।\nअटमानौ महात्मानाविन्द्रलोकान्महीं गतौ\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2126296, "chapter_id": 3705, "verse_number": "१२", "content_sanskrit": "नारदः पर्वतश्चैव महाप्राज्ञौ महाद्युती ।\nदेवराजस्य भवनं विविशाते सुपूजितौ\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2126297, "chapter_id": 3705, "verse_number": "१३", "content_sanskrit": "तावर्चित्वा सहस्राक्षस्ततः कुशलमव्ययम् ।\nपप्रच्छानामयं चापि तयोः सर्वगतं प्रभुः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2126298, "chapter_id": 3705, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2126299, "chapter_id": 3705, "verse_number": "१४", "content_sanskrit": "आवयोः कुशलं देव सर्वत्र गतमीश्वर ।\nलोके च भगवन् कृत्स्ना नृपाः कुशलिनो विभो\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2126300, "chapter_id": 3705, "verse_number": "", "content_sanskrit": "बृहदश्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2126301, "chapter_id": 3705, "verse_number": "१५", "content_sanskrit": "नारदस्य वचः श्रुत्वा पप्रच्छ बलवृत्रहा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2126302, "chapter_id": 3705, "verse_number": "१६", "content_sanskrit": "धर्मज्ञाः पृथिवीपालाः त्यक्तजीवितयोधिनः ।\nशस्त्रेण निधनं काले ये गच्छन्त्यपराङ्मुखाः ।\nअयं लोकोऽक्षयस्तेषां यथैव मम कामधुक् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2126303, "chapter_id": 3705, "verse_number": "१७", "content_sanskrit": "क्व नु ते क्षत्रियाः शूरा न हि पश्यामि तानहम् ।\nआगच्छतो महीपालानतिथीन् दयितान् मम\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2126304, "chapter_id": 3705, "verse_number": "१८", "content_sanskrit": "एवमुक्तस्तु शक्रेण नारदः प्रत्युवाच ह ।\nशृणु मे भगवन् येन न दृश्यन्ते महीक्षितः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2126305, "chapter_id": 3705, "verse_number": "१९", "content_sanskrit": "विदर्भराजतनया दमयन्तीति विश्रुता ।\nरूपेण समतिक्रान्ता पृथिव्यां सर्वयोषितः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2126306, "chapter_id": 3705, "verse_number": "२०", "content_sanskrit": "तस्याः स्वयंवरः शक्र भविता नचिरादिव ।\nतत्र गच्छन्ति राजानो राजपुत्राश्च सर्वशः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2126307, "chapter_id": 3705, "verse_number": "२१", "content_sanskrit": "तां रत्नभूतां लोकस्य प्रार्थयन्तो महीक्षितः ।\nकाङ्क्षन्ति स्म विशेषेण बलवृत्रनिषूदन \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2126308, "chapter_id": 3705, "verse_number": "", "content_sanskrit": "बृहदश्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2126309, "chapter_id": 3705, "verse_number": "२२", "content_sanskrit": "एतेषु कथ्यमानेषु लोकपालाश्च साग्निकाः ।\nआजग्मुर्देवराजस्य समीपममरोत्तमाः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2126310, "chapter_id": 3705, "verse_number": "२३", "content_sanskrit": "ततस्ते शुश्रुवुः सर्वे नारदस्य वचो महत् ।\nश्रुत्वा चैवाब्रुवन् सर्वे गच्छाम वयमप्युत\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2126311, "chapter_id": 3705, "verse_number": "२४", "content_sanskrit": "ततः सर्वे महाराज सगणाः सहवाहनाः ।\nविदर्भानभितो जग्मुर्यत्र सर्वे महीक्षितः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2126312, "chapter_id": 3705, "verse_number": "२५", "content_sanskrit": "नळोऽपि राजा कौन्तेय श्रुत्वा राज्ञां समागमम् ।\nअभ्यगच्छददीनात्मा दमयन्तीमनुव्रतः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2126313, "chapter_id": 3705, "verse_number": "२६", "content_sanskrit": "अथ देवाः पथि नळं ददृशुर्भूतळे स्थितम् ।\nसाक्षादिव स्थितं मूर्त्या मन्मथं रूपसम्पदा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2126314, "chapter_id": 3705, "verse_number": "२७", "content_sanskrit": "तं दृष्ट्वा लोकपालास्ते भ्राजमानं यथा रविम् ।\nतस्थुर्विगतसङ्कल्पा विस्मिता रूपसम्पदा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2126315, "chapter_id": 3705, "verse_number": "२८", "content_sanskrit": "ततोऽन्तरिक्षे विष्टभ्य विमानानि दिवौकसः ।\nअब्रुवन्नैषधं राजन्नवतीर्य नभस्स्थलात्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2126316, "chapter_id": 3705, "verse_number": "२९", "content_sanskrit": "भो भो नैषध राजेन्द्र नळ सत्यव्रतो भवान् ।\nअस्माकं कुरु साहाय्यं दूतो भव नरोत्तम\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2126317, "chapter_id": 3705, "verse_number": "", "content_sanskrit": "बृहदश्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2126318, "chapter_id": 3705, "verse_number": "३०", "content_sanskrit": "तेभ्यः प्रतिज्ञाय नळः करिष्य इति भारत ।\nअथैतान् परिपप्रच्छ कृताञ्जलिरुपस्थितः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2126319, "chapter_id": 3705, "verse_number": "३१", "content_sanskrit": "के वै भवन्तः कश्चासौ यस्याहं दूत ईप्सितः ।\nकिञ्च तत्र मया कार्यं कथयध्वं यथातथम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2126320, "chapter_id": 3705, "verse_number": "", "content_sanskrit": "बृहदश्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2126321, "chapter_id": 3705, "verse_number": "३२", "content_sanskrit": "एवमुक्तो नैषधेन मघवानभ्यभाषत ।\nअमरान् वै निबोधास्मान् दमयन्त्यर्थमागतान्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2126322, "chapter_id": 3705, "verse_number": "३३", "content_sanskrit": "अहमिन्द्रोऽयमग्निश्च तथैवायमपाम्पतिः ।\nशरीरान्तकरो नॄणां यमोऽयमपि पार्थिव ।\nस वै त्वमागतानस्मान् दमयन्त्यै निवेदय \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2126323, "chapter_id": 3705, "verse_number": "३४", "content_sanskrit": "लोकपालाः सहेन्द्रास्त्वां समायान्ति दिदृक्षवः ।\nप्राप्तुमिच्छन्ति देवास्त्वां शक्रोऽग्निर्वरुणो यमः ।\nतेषामन्यतमं देवं पतित्वे वरयेति ह\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2126324, "chapter_id": 3705, "verse_number": "३५", "content_sanskrit": "एवमुक्तः स शक्रेण नळः प्राञ्जलिरब्रवीत् ।\nएकार्थसमवेतं मां न प्रेषयितुमर्हथ\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2126325, "chapter_id": 3705, "verse_number": "३६", "content_sanskrit": "कथं हि जातसङ्कल्पः स्त्रियमुत्सहते नरः ।\nपरार्थमीदृशं वक्तुं तद्वै पश्य सुरेश्वर ।\nएवमुक्तो नैषधेन मघवान् पुनरब्रवीत्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2126326, "chapter_id": 3705, "verse_number": "३७", "content_sanskrit": "करिष्य इति संश्रुत्य पूर्वमस्मासु नैषध ।\nन करिष्यसि कस्मात् त्वं व्रज नैषध माचिरम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2126327, "chapter_id": 3705, "verse_number": "३८", "content_sanskrit": "स वै त्वमागतानस्मान् दमयन्त्यै निवेदय ।\nएवमुक्तः स देवैस्तैर्नैषधः पुनरब्रवीत् ।\nसुरक्षितानि वेश्मानि प्रवेष्टुं कथमुत्सहे \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2126328, "chapter_id": 3705, "verse_number": "", "content_sanskrit": "बृहदश्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2126329, "chapter_id": 3705, "verse_number": "३९", "content_sanskrit": "प्रवेक्ष्यसीति तं शक्रः पुनरेवाभ्यभाषत ।\nस जगाम तथेत्युक्त्वा दमयन्त्या निवेशनम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2126330, "chapter_id": 3705, "verse_number": "४०", "content_sanskrit": "ददर्श तत्र वैदर्भीं सखीगणसमावृताम् ।\nदेदीप्यमानां वपुषा श्रिया च वरवर्णिनीम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2126331, "chapter_id": 3705, "verse_number": "४१", "content_sanskrit": "अतीव सुकुमाराङ्गीं तनुमध्यां सुलोचनाम् ।\nआक्षिपन्तीमिव च तां शशिनं स्वेन तेजसा\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2126332, "chapter_id": 3705, "verse_number": "४२", "content_sanskrit": "तस्य दृष्ट्वैव ववृधे कामस्तां चारुहासिनीम् ।\nसत्यं चिकीर्षमाणस्तु वारयामास हृच्छयम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2126333, "chapter_id": 3705, "verse_number": "४३", "content_sanskrit": "ततस्ता नैषधं दृष्ट्वा सम्भ्रान्ताः परमाङ्गनाः ।\nआसनेभ्यः समुत्पेतुः तेजसा तस्य धर्षिताः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2126334, "chapter_id": 3705, "verse_number": "४४", "content_sanskrit": "प्रशशंसुश्च सम्प्रीता नळं ता विस्मयान्विताः ।\nन चैनमभ्यभाषन्त मनोभिस्त्वभ्यचिन्तयन्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2126335, "chapter_id": 3705, "verse_number": "४५", "content_sanskrit": "अहो रूपमहो धैर्यमहो कान्तिर्महात्मनः ।\nकोऽयं देवोऽथवा यक्षो गन्धर्वो नु भविष्यति \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2126336, "chapter_id": 3705, "verse_number": "४६", "content_sanskrit": "न त्वेनं शक्नुवन्ति स्म व्याहर्तुमपि किञ्चन ।\nतेजसा धर्षिताः सर्वा लज्जावत्यो वराङ्गनाः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2126337, "chapter_id": 3705, "verse_number": "४७", "content_sanskrit": "अथैनं स्मयमानेव स्मितपूर्वाभिभाषिणी ।\nदमयन्ती नळं वीरमभ्यभाषत विस्मिता\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2126338, "chapter_id": 3705, "verse_number": "४८", "content_sanskrit": "कस्त्वं सर्वानवद्याङ्ग मम हृच्छयवर्धन ।\nप्राप्तोऽस्यमरवद् वीर ज्ञातुमिच्छामहेऽनघ \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2126339, "chapter_id": 3705, "verse_number": "४९", "content_sanskrit": "कथमागमनं चेह कथं चापि न लक्षितः ।\nसुरक्षितं च मे वेश्म राजा चैवोग्रशासनः \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2126340, "chapter_id": 3705, "verse_number": "५०", "content_sanskrit": "एवमुक्तस्तु वैदर्भ्या नळस्तां प्रत्यभाषत ।\nनळं मां विद्धि कल्याणि देवदूतमिहागतम् \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2126341, "chapter_id": 3705, "verse_number": "५१", "content_sanskrit": "देवास्त्वां प्राप्तुमिच्छन्ति शक्रोऽग्निर्वरुणो यमः ।\nतेषामन्यतमं देवं पतिं वरय शोभने\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2126342, "chapter_id": 3705, "verse_number": "५२", "content_sanskrit": "तेषामेव प्रभावेण प्रविष्टोऽहमलक्षितः।\nप्रविशन्तं हि मां कश्चिन् नापश्यन्नाप्यवारयत्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2126343, "chapter_id": 3705, "verse_number": "५३", "content_sanskrit": "एतदर्थमहं भद्रे प्रेषितः सुरसत्तमैः ।\nएतच्छ्रुत्वा तु मे वाक्यं प्रकुरुष्व यथेच्छसि\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2126344, "chapter_id": 3705, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि सप्तचत्वारिंशोऽध्यायः ॥४७॥\n॥ तीर्थयात्रापर्वणि तृतीयोऽध्यायः ॥३॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]