[{"id": 5000216000, "chapter_id": 9216, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000216001, "chapter_id": 9216, "verse_number": "३-२०-१", "content_sanskrit": "ततः शूर्पणखा घोरा राघवाश्रममागता।\nराक्षसानाचचक्षे तौ भ्रातरौ सह सीतया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000216002, "chapter_id": 9216, "verse_number": "३-२०-२", "content_sanskrit": "ते रामं पर्णशालायामुपविष्टं महाबलम्।\nददृशुः सीतया सार्धं लक्ष्मणेनापि सेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000216003, "chapter_id": 9216, "verse_number": "३-२०-३", "content_sanskrit": "तां दृष्ट्वा राघवः श्रीमानागतांस्तांश्च राक्षसान्।\nअब्रवीद् भ्रातरं रामो लक्ष्मणं दीप्ततेजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000216004, "chapter_id": 9216, "verse_number": "३-२०-४", "content_sanskrit": "मुहूर्तं भव सौमित्रे सीतायाः प्रत्यनन्तरः।\nइमानस्या वधिष्यामि पदवीमागतानिह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000216005, "chapter_id": 9216, "verse_number": "३-२०-५", "content_sanskrit": "वाक्यमेतत् ततः श्रुत्वा रामस्य विदितात्मनः।\nतथेति लक्ष्मणो वाक्यं राघवस्य प्रपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000216006, "chapter_id": 9216, "verse_number": "३-२०-६", "content_sanskrit": "राघवोऽपि महच्चापं चामीकरविभूषितम्।\nचकार सज्यं धर्मात्मा तानि रक्षांसि चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000216007, "chapter_id": 9216, "verse_number": "३-२०-७", "content_sanskrit": "पुत्रौ दशरथस्यावां भ्रातरौ रामलक्ष्मणौ।\nप्रविष्टौ सीतया सार्धं दुश्चरं दण्डकावनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000216008, "chapter_id": 9216, "verse_number": "३-२०-८", "content_sanskrit": "फलमूलाशनौ दान्तौ तापसौ ब्रह्मचारिणौ।\nवसन्तौ दण्डकारण्ये किमर्थमुपहिंसथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000216009, "chapter_id": 9216, "verse_number": "३-२०-९", "content_sanskrit": "युष्मान् पापात्मकान् हन्तुं विप्रकारान् महाहवे।\nऋषीणां तु नियोगेन सम्प्राप्तः सशरासनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000216010, "chapter_id": 9216, "verse_number": "३-२०-१०", "content_sanskrit": "तिष्ठतैवात्र संतुष्टा नोपवर्तितुमर्हथ।\nयदि प्राणैरिहार्थो वो निवर्तध्वं निशाचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000216011, "chapter_id": 9216, "verse_number": "३-२०-११", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा राक्षसास्ते चतुर्दश।\nऊचुर्वाचं सुसंक्रुद्धा ब्रह्मघ्नाः शूलपाणयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000216012, "chapter_id": 9216, "verse_number": "३-२०-१२", "content_sanskrit": "संरक्तनयना घोरा रामं संरक्तलोचनम्।\nपरुषा मधुराभाषं हृष्टा दृष्टपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000216013, "chapter_id": 9216, "verse_number": "३-२०-१३", "content_sanskrit": "क्रोधमुत्पाद्य नो भर्तुः खरस्य सुमहात्मनः।\nत्वमेव हास्यसे प्राणान् सद्योऽस्माभिर्हतो युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000216014, "chapter_id": 9216, "verse_number": "३-२०-१४", "content_sanskrit": "का हि ते शक्तिरेकस्य बहूनां रणमूर्धनि।\nअस्माकमग्रतः स्थातुं किं पुनर्योद्धुमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000216015, "chapter_id": 9216, "verse_number": "३-२०-१५", "content_sanskrit": "एभिर्बाहुप्रयुक्तैश्च परिघैः शूलपट्टिशैः।\nप्राणांस्त्यक्ष्यसि वीर्यं च धनुश्च करपीडितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000216016, "chapter_id": 9216, "verse_number": "३-२०-१६", "content_sanskrit": "इत्येवमुक्त्वा संरब्धा राक्षसास्ते चतुर्दश।\nउद्यतायुधनिस्त्रिंशा राममेवाभिदुद्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000216017, "chapter_id": 9216, "verse_number": "३-२०-१७", "content_sanskrit": "चिक्षिपुस्तानि शूलानि राघवं प्रति दुर्जयम्।\nतानि शूलानि काकुत्स्थः समस्तानि चतुर्दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000216018, "chapter_id": 9216, "verse_number": "३-२०-१८", "content_sanskrit": "तावद्भिरेव चिच्छेद शरैः काञ्चनभूषितैः।\nततः पश्चान्महातेजा नाराचान् सूर्यसंनिभान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000216019, "chapter_id": 9216, "verse_number": "३-२०-१९", "content_sanskrit": "जग्राह परमक्रुद्धश्चतुर्दश शिलाशितान्।\nगृहीत्वा धनुरायम्य लक्ष्यानुद्दिश्य राक्षसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000216020, "chapter_id": 9216, "verse_number": "३-२०-२०", "content_sanskrit": "मुमोच राघवो बाणान् वज्रानिव शतक्रतुः।\nते भित्त्वा रक्षसां वेगाद् वक्षांसि रुधिरप्लुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000216021, "chapter_id": 9216, "verse_number": "३-२०-२१", "content_sanskrit": "विनिष्पेतुस्तदा भूमौ वल्मीकादिव पन्नगाः।\nतैर्भग्नहृदया भूमौ छिन्नमूला इव द्रुमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000216022, "chapter_id": 9216, "verse_number": "३-२०-२२", "content_sanskrit": "निपेतुः शोणितस्नाता विकृता विगतासवः।\nतान् भूमौ पतितान् दृष्ट्वा राक्षसी क्रोधमूर्छिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000216023, "chapter_id": 9216, "verse_number": "३-२०-२३", "content_sanskrit": "उपगम्य खरं सा तु किंचित्संशुष्कशोणिता।\nपपात पुनरेवार्ता सनिर्यासेव वल्लरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000216024, "chapter_id": 9216, "verse_number": "३-२०-२४", "content_sanskrit": "भ्रातुः समीपे शोकार्ता ससर्ज निनदं महत् ।\nसस्वरं मुमुचे बाष्पं विवर्णवदना तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000216025, "chapter_id": 9216, "verse_number": "३-२०-२५", "content_sanskrit": "निपातितान् प्रेक्ष्य रणे तु राक्षसान्\nप्रधाविता शूर्पणखा पुनस्ततः।\nवधं च तेषां निखिलेन रक्षसां\nशशंस सर्वं भगिनी खरस्य सा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000216026, "chapter_id": 9216, "verse_number": null, "content_sanskrit": "इति वाल्मीकि रामायणे आदि काव्ये अरण्यकाण्डे विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]