[{"id": 2009256, "chapter_id": 1181, "verse_number": "१-१८२-०x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2009257, "chapter_id": 1181, "verse_number": "१-१८२-१", "content_sanskrit": "श्रुत्वा जतुगृहे वृत्तं ब्राह्मणाः संशितव्रताः।\nपाञ्चालराजं द्रुपदमिदं वचनमब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2009258, "chapter_id": 1181, "verse_number": "१-१८२-२", "content_sanskrit": "धार्तराष्ट्राः सहामात्या मन्त्रयित्वा परस्परम्।\nपाण्डवानां विनाशाय मतिं चक्रुः सुदुष्कराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2009259, "chapter_id": 1181, "verse_number": "१-१८२-३", "content_sanskrit": "दुर्योधनेन प्रहितः पुरोचन इति श्रुतः।\nवारणावतमासाद्य कृत्वा जतुगृहं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2009260, "chapter_id": 1181, "verse_number": "१-१८२-४", "content_sanskrit": "तस्मिन्गृहे सुविस्रब्धान्पाण्डवान्पृथया सह।\nअर्धरात्रे महाराज दग्धवानतिदुर्मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2009261, "chapter_id": 1181, "verse_number": "१-१८२-५", "content_sanskrit": "तेनाग्निना स्वयं चापि दग्धः क्षुद्रो नृशंसवत्।\nएतच्छ्रुत्वा सुसंहृष्टो धृतराष्ट्रः सबान्धवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2009262, "chapter_id": 1181, "verse_number": "१-१८२-६", "content_sanskrit": "अल्पशोकः प्रहृष्टात्मा शशास विदुरं तदा।\nपाण्डवानां महाप्राज्ञ कुरु पिण्डोदकक्रियाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2009263, "chapter_id": 1181, "verse_number": "१-१८२-७", "content_sanskrit": "अहो विधिवशादेव गतास्ते यमसादनम्।\nइत्युक्त्वा प्रारदत्तत्र धृतराष्ट्रः सबान्धवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2009264, "chapter_id": 1181, "verse_number": "१-१८२-८", "content_sanskrit": "श्रुत्वा भीष्मेण विदुरः कृतवानौर्ध्वदेहिकम्।\nपाण्डवानां विनाशाय कृतं कर्म दुरात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2009265, "chapter_id": 1181, "verse_number": "१-१८२-९", "content_sanskrit": "एतत्कार्यस्य कर्ता तु न दृष्टो न श्रुतः पुरा।\nएतद्वृत्तं महाभाग पाण्डवान्प्रति नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2009266, "chapter_id": 1181, "verse_number": "१-१८२-१०x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2009267, "chapter_id": 1181, "verse_number": "१-१८२-१०", "content_sanskrit": "श्रुत्वा तु वचनं तेषां यज्ञसेनो महामतिः।\nयथा तज्जनकः शोचेदौरसस्य विनाशे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2009268, "chapter_id": 1181, "verse_number": "१-१८२-११", "content_sanskrit": "तथाऽतप्यत वै राजा पाण्डवानां विनाशने।\nसमाहूय प्रकृतयः सहिताः सर्वनागरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2009269, "chapter_id": 1181, "verse_number": "१-१८२-१२", "content_sanskrit": "कारुण्यादेव पाञ्चालः प्रोवाचेदं वचस्तदा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2009270, "chapter_id": 1181, "verse_number": "१-१८२-१२x", "content_sanskrit": "द्रुपद उवाच।\nअहो रूपमहो धैर्यमहो वीर्यमहो बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2009271, "chapter_id": 1181, "verse_number": "१-१८२-१३", "content_sanskrit": "चिन्तयामि दिवारात्रमर्जुनं प्रति बान्धवाः।\nभ्रातृभिः सहितो मात्रा सोऽदह्यत हुताशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2009272, "chapter_id": 1181, "verse_number": "१-१८२-१४", "content_sanskrit": "किमाश्चर्यमितो लोके कालो हि दुरतिक्रमः।\nमिथ्याप्रतिज्ञो लोकेषु किं करिष्यामि सांप्रतं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2009273, "chapter_id": 1181, "verse_number": "१-१८२-१५", "content_sanskrit": "अन्तर्गतेन दुःखेन दह्यमानो दिवानिशम्।\nयाजोपयाजौ सत्कृत्य याचितौ तौ मयाऽनघौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2009274, "chapter_id": 1181, "verse_number": "१-१८२-१६", "content_sanskrit": "भारद्वाजस्य हन्तारं देवीं चाप्यर्जुनस्य वै।\nलोकस्तद्वेद यच्चापि तथा याजेन मे श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2009275, "chapter_id": 1181, "verse_number": "१-१८२-१७", "content_sanskrit": "याजेन पुत्रकामीयं हुत्वा चोत्पादिताविमौ।\nधृष्टद्युम्नश्च कृष्णा च मम तुष्टिकरावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2009276, "chapter_id": 1181, "verse_number": "१-१८२-१८", "content_sanskrit": "किं करिष्यामि ते नष्टाः पाण्डवाः पृथया सह।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2009277, "chapter_id": 1181, "verse_number": "१-१८२-१८x", "content_sanskrit": "ब्राह्मण उवाच।\nइत्येवमुक्त्वा पाञ्चालः शुशोच परमातुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2009278, "chapter_id": 1181, "verse_number": "१-१८२-१९", "content_sanskrit": "दृष्ट्वा शोचन्तमत्यर्थं पाञ्चालमिदमब्रवीत्।\nपुरोधाः सत्वसंपन्नः सम्यग्विद्याविशेषवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2009279, "chapter_id": 1181, "verse_number": "१-१८२-२०", "content_sanskrit": "वृद्धानुशासने सक्ताः पाण्डवा धर्मचारिणः।\nतादृशा न विनश्यन्ति नैव यान्ति पराभवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2009280, "chapter_id": 1181, "verse_number": "१-१८२-२१", "content_sanskrit": "मया दृष्टमिदं सत्यं शृणु त्वं मनुजाधिप।\nब्राह्मणैः कथितं सत्यं वेदेषु च मया श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2009281, "chapter_id": 1181, "verse_number": "१-१८२-२२", "content_sanskrit": "बृहस्पतिमतेनाथ पौलोम्या च पुरा श्रुतम्।\nनष्ट हन्द्रो बिसग्रन्थ्यामुपश्रुत्या हि दर्शितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2009282, "chapter_id": 1181, "verse_number": "१-१८२-२३", "content_sanskrit": "उपश्रुतिर्महाराज पाण्डवार्थे मया श्रुता।\nयत्रकुत्रापि जीवन्ति पाण्डवास्ते न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2009283, "chapter_id": 1181, "verse_number": "१-१८२-२४", "content_sanskrit": "मया दृष्टानि लिङ्गानि इहैवैष्यन्ति पाण्डवाः।\nयन्निमित्तमिहायान्ति तच्छृणुष्व नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2009284, "chapter_id": 1181, "verse_number": "१-१८२-२५", "content_sanskrit": "स्वयंवरः क्षत्रियाणां कन्यादाने प्रदर्शितः।\nस्वयंवरस्तु नगरे घुष्यतां राजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2009285, "chapter_id": 1181, "verse_number": "१-१८२-२६", "content_sanskrit": "यत्र वा निवसन्तस्ते पाण्डवाः पृथया सह।\nदूरस्था वा समीपस्था स्वर्गस्था वाऽपि पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2009286, "chapter_id": 1181, "verse_number": "१-१८२-२७", "content_sanskrit": "श्रुत्वा स्वयंवरं राजन्समेष्यन्ति न संशयः।\nतस्मात्स्वयंवरो राजन्घुष्यतां मा चिरं कृथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2009287, "chapter_id": 1181, "verse_number": "१-१८२-२८x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2009288, "chapter_id": 1181, "verse_number": "१-१८२-२८", "content_sanskrit": "श्रुत्वा पुरोहितेनोक्तं पाञ्चालः प्रीतिमांस्तदा।\nघोषयामास नगरे द्रौपद्यास्तु स्वयंवरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2009289, "chapter_id": 1181, "verse_number": "१-१८२-२९", "content_sanskrit": "पुष्यमासे तु रोहिण्यां शुक्लपक्षे शुभे तिथौ।\nदिवसैः पञ्चसप्तत्या भविष्यति न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2009290, "chapter_id": 1181, "verse_number": "१-१८२-३०", "content_sanskrit": "देवगन्धर्वयक्षाश्च ऋषयश्च तपोधनाः।\nस्वयंवरं द्रष्टुकामा गच्छन्त्येव न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2009291, "chapter_id": 1181, "verse_number": "१-१८२-३१", "content_sanskrit": "तव पुत्रा महात्मानो दर्शनीयो विशेषतः।\nयदृच्छया सा पाञ्चाली गच्छेद्वान्यतमं पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2009292, "chapter_id": 1181, "verse_number": "१-१८२-३२", "content_sanskrit": "को हि जानाति लोकेषु प्रजापतिमतं शुभण्।\nतस्मात्सपुत्रा गच्छेथा यदि ब्राह्मणि रोचते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2009293, "chapter_id": 1181, "verse_number": "१-१८२-३३", "content_sanskrit": "नित्यकालं सुभिक्षास्ते पाञ्चालास्तु तपोधने।\nयज्ञसेनस्तु राजा स ब्रह्मण्यः सत्यसङ्गरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2009294, "chapter_id": 1181, "verse_number": "१-१८२-३४", "content_sanskrit": "ब्रह्मण्या नागराः सर्वे ब्राह्मणाश्चातिथिप्रियाः।\nनित्यकालं प्रदास्यन्ति आमन्त्रणमयाचितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2009295, "chapter_id": 1181, "verse_number": "१-१८२-३५", "content_sanskrit": "अहं च तत्र गच्छामि ममैभिः सह शिष्यकैः।\nएकसार्थाः प्रयाताः स्मो ब्राह्मण्या यदि रोचते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2009296, "chapter_id": 1181, "verse_number": "१-१८२-३६x", "content_sanskrit": "एतावदुक्त्वा वचनं ब्राह्मणो विरराम ह॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2009297, "chapter_id": 1181, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि चैत्ररथपर्वणि द्व्यशीत्यधिकशततमोऽध्यायः॥ १८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]