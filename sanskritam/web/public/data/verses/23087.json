[{"id": 7003087000, "chapter_id": 23087, "verse_number": "४-२२-१", "content_sanskrit": "श्रीनारायण उवाच ।\nएकदा राधिकानाथो बलेन सह बालकैः ।\nजगाम तत्तालवनं परिपक्वफलान्वितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003087001, "chapter_id": 23087, "verse_number": "४-२२-२", "content_sanskrit": "वृक्षाणां रक्षिता दैत्यः खर रूपी च धेनुकः।\nकोटिसिंहसमबलो देवानां दर्पनाशनः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003087002, "chapter_id": 23087, "verse_number": "४-२२-३", "content_sanskrit": "शरीरं पर्वतसमं कूपतुल्ये च लोचने ।\nईषापंक्तिसमा दन्तास्तुण्डं पर्वतगह्वरम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003087003, "chapter_id": 23087, "verse_number": "४-२२-४", "content_sanskrit": "शतहस्तपरिमिता जिह्वा लोला भयानका ।\nकासारसदृशी नाभिः शब्दस्तस्य भयानकः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003087004, "chapter_id": 23087, "verse_number": "४-२२-५", "content_sanskrit": "दृष्ट्वा तालवनं बाला हर्षमापुरनिन्दिताः ।\nकौतुकात्कृष्णमूचुस्ते स्मेराननसरोरुहाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003087005, "chapter_id": 23087, "verse_number": "४-२२-६", "content_sanskrit": "बाला ऊचुः ।\nहे कृष्ण करुणासिन्धो दीन बन्धो जगत्पते ।\nमहाबल बलभ्रातः समस्तबलिनां वर ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003087006, "chapter_id": 23087, "verse_number": "४-२२-७", "content_sanskrit": "अवधानं कुरु विभो क्षणार्द्धं नो निवेदने ।\nक्षुधितानां शिशूनां च भक्तानां भक्तवत्सल ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003087007, "chapter_id": 23087, "verse_number": "४-२२-८", "content_sanskrit": "स्वादूनि सुन्दराण्येव पश्य तालफलानि च ।\nभङ्क्तुं चालयितुं वृक्षान्पातितुं च फलानि च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003087008, "chapter_id": 23087, "verse_number": "४-२२-९", "content_sanskrit": "नानावर्णानि पुष्पाणि पक्वानि दुर्लभानि च ।\nआज्ञां करोषि चेत्कृष्ण चेष्टां कर्त्तु वयं क्षमाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003087009, "chapter_id": 23087, "verse_number": "४-२२-१०", "content_sanskrit": "किं त्वत्र दैत्यो बलवान्खररूपी च धेनुकः ।\nअजितस्त्रिदशैः सर्वैर्महाबलपराक्रमः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003087010, "chapter_id": 23087, "verse_number": "४-२२-११", "content_sanskrit": "दुर्निवार्यश्च सर्वेषां कंसस्य सचिवो महान् ।\nहिंसकः सर्वजन्तूनां वनानामस्ति रक्षिता ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003087011, "chapter_id": 23087, "verse_number": "४-२२-१२", "content_sanskrit": "सुविचार्य जगत्कान्त वद नो वदतां वर ।\nयुक्तं कार्यमयुक्तं वा कर्तव्यमथ वा न वा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003087012, "chapter_id": 23087, "verse_number": "४-२२-१३", "content_sanskrit": "बालकानां वचः श्रुत्वा भगवान्मधुसूदनः ।\nउवाच मधुरं बालान्वचनं तत्सुखावहम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003087013, "chapter_id": 23087, "verse_number": "४-२२-१४", "content_sanskrit": "श्रीकृष्ण उवाच ।\nकिं वो दैत्याद्भयं बाला यूयं मत्सहचारिणः ।\nवृक्षान्भङ्क्त्वा चालयित्वा फलानि खादताभयम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003087014, "chapter_id": 23087, "verse_number": "४-२२-१५", "content_sanskrit": "श्रीकृष्णाज्ञां समादाय बालका बलशालिनः ।\nउत्पेतुर्वृक्षशिखरं क्षुधिताश्च फलार्थिनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003087015, "chapter_id": 23087, "verse_number": "४-२२-१६", "content_sanskrit": "नानाप्रकारवर्णानि स्वादूनि सुन्दराणि च ।\nफलानि पातयामासुः परिपक्वानि नारद ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003087016, "chapter_id": 23087, "verse_number": "४-२२-१७", "content_sanskrit": "केचिद्बभञ्जुर्वृक्षाश्च चालयामासुरेव च ।\nकेचित्कोलाहलं चकुर्ननृतुस्तत्र केचन ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003087017, "chapter_id": 23087, "verse_number": "४-२२-१८", "content_sanskrit": "अवरुह्य तरुभ्यश्च बालका बलशालिनः ।\nफलान्यादाय गच्छन्तो ददृशुर्दैत्यपुङ्गवम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003087018, "chapter_id": 23087, "verse_number": "४-२२-१९", "content_sanskrit": "महाबलं महाकायं घोरं गर्दभरूपिणम् ।\nआगच्छन्तं महावेगात्कुर्वन्तं शब्दमुल्बणम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003087019, "chapter_id": 23087, "verse_number": "४-२२-२०", "content_sanskrit": "तं दृष्ट्वा रुरुदुः सर्वे फलानि तत्यजुर्भिया ।\nकृष्णकृष्णेति शब्दं च प्रचक्रुर्बहुधा भृशम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003087020, "chapter_id": 23087, "verse_number": "४-२२-२१", "content_sanskrit": "अस्मान्रक्ष समागच्छ हे कृष्ण करुणानिधे ।\nहे सङ्कर्षण नो रक्ष प्राणा नो यान्ति दानवात् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003087021, "chapter_id": 23087, "verse_number": "४-२२-२२", "content_sanskrit": "हे कृष्ण हे कृष्ण हरे मुरारे गोविन्द दामोदर दीनबन्धो। ।\nगोपीशगोपेश भवार्णवेऽस्मा ननन्त नारायण रक्ष रक्ष ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003087022, "chapter_id": 23087, "verse_number": "४-२२-२३", "content_sanskrit": "भयेऽभये वाथ शुभेऽशुभे वा सुखेषु दुःखेषु च दीननाथ ।\nत्वया विनाऽन्यं शरणं भवार्णवे न नोऽस्ति हे माधव रक्ष रक्ष ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003087023, "chapter_id": 23087, "verse_number": "४-२२-२४", "content_sanskrit": "जयजय गुणसिन्धो कृष्ण भक्तैकबन्धो बहुतरभययुक्तान्बालकान्रक्ष रक्ष ।\nजहि दनुजकुलानामीशमस्माक मन्तं सुरकुलबलदर्पं वर्धयेमं निहत्य ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003087024, "chapter_id": 23087, "verse_number": "४-२२-२५", "content_sanskrit": "बालानां विक्लवं दृष्ट्वा बलेन सह माधवः ।\nआजगाम शिशुस्थानं भयहा भक्त वत्सलः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003087025, "chapter_id": 23087, "verse_number": "४-२२-२६", "content_sanskrit": "भयं नास्ति भयं नास्तीत्युक्त्वा दुद्राव सत्वरम् ।\nईषद्धास्यप्रसन्नास्यो निर्भयं दत्तवाञ्छिशून् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003087026, "chapter_id": 23087, "verse_number": "४-२२-२७", "content_sanskrit": "दृष्ट्वा कृष्णं बलं बाला ननृतुर्विजहुर्भयम् ।\nहरिस्मृतिश्चाभयदा सर्वमङ्गलदायिका ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003087027, "chapter_id": 23087, "verse_number": "४-२२-२८", "content_sanskrit": "श्रीकृष्णो दानवं दृष्ट्वा ग्रसन्तं पुरतः शिशून्।\nबलं संबोध्य बलिनमुवाच मधुसूदनः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003087028, "chapter_id": 23087, "verse_number": "४-२२-२९", "content_sanskrit": "श्रीकृष्ण उवाच ।\nदानवो बलिपुत्रोऽयं नाम्ना साहसिको बली ।\nगर्दभो ब्रह्मशापेन शप्तो दुर्वाससा पुरा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003087029, "chapter_id": 23087, "verse_number": "४-२२-३०", "content_sanskrit": "पापिष्ठो मम वध्योऽयं महाबलपराकमः ।\nअहमेनं वधिष्यामि त्वं रक्ष बालकान्बल ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003087030, "chapter_id": 23087, "verse_number": "४-२२-३१", "content_sanskrit": "आदाय बालकान्सर्वान्दूरं गच्छेत्युवाच ह ।\nतान्गृहीत्वा बलः शीघ्रं जगाम त्वरयाज्ञया ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003087031, "chapter_id": 23087, "verse_number": "४-२२-३२", "content_sanskrit": "दृष्ट्वा कृष्णं दानवेन्द्रो महाबलपराक्रमः ।\nजग्रास लीलया कोपाज्ज्वलदग्निशिखोपमम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003087032, "chapter_id": 23087, "verse_number": "४-२२-३३", "content_sanskrit": "बभूवातिदाहयुक्तो मर्तुकामोऽतितेजसा ।\nउज्जग्रास पुनर्दैत्यो विभुं तेजस्विनं भिया ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003087033, "chapter_id": 23087, "verse_number": "४-२२-३४", "content_sanskrit": "उज्झितं सन्तमीशं च दृष्ट्वा दैत्यो मुमोच ह। ।\nअतीव सुन्दरं शान्तं ज्वलन्तं ब्रह्मतेजसा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003087034, "chapter_id": 23087, "verse_number": "४-२२-३५", "content_sanskrit": "कृष्णदर्शनमात्रेण बभूवास्य पुरा स्मृतिः ।\nआत्मानं बुबुधे कृष्णं जगतां कारणं परम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003087035, "chapter_id": 23087, "verse_number": "४-२२-३६", "content_sanskrit": "तेजःस्वरूपमीशं तं दृष्ट्वा तुष्टाव दानवः ।\nयथागमं यथाजन्म गुणातीतं श्रुतेः परम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003087036, "chapter_id": 23087, "verse_number": "४-२२-३७", "content_sanskrit": "दानव उवाच ।\nवामनोऽसि त्वमंशेन मत्पितुर्यज्ञभिक्षुकः ।\nराज्यहर्ता च श्रीहर्ता सुतलस्थलदायकः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003087037, "chapter_id": 23087, "verse_number": "४-२२-३८", "content_sanskrit": "बलिर्भक्तिवशो वीरः सर्वेशो भक्तवत्सलः ।\nशीघ्रं त्वं हिन्धि मां पापं शापाद्गर्दभरूपिणम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003087038, "chapter_id": 23087, "verse_number": "४-२२-३९", "content_sanskrit": "मुनेर्दुर्वाससः शापादीदृशं जन्म कुत्सितम् ।\nमृत्युरुक्तश्च मुनिना त्वत्तो मम जगत्पते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003087039, "chapter_id": 23087, "verse_number": "४-२२-४०", "content_sanskrit": "षोडशारेण चक्रेण सुतीक्ष्णेनातितेजसा ।\nजहि मां जगतां नाथ सद्भक्तिं कुरु मोक्षद ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003087040, "chapter_id": 23087, "verse_number": "४-२२-४१", "content_sanskrit": "त्वमंशेन वराहश्च समुद्धर्तुं वसुन्धराम् ।\nवेदानां रक्षिता नाथ हिरण्याक्षनिषूदनः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003087041, "chapter_id": 23087, "verse_number": "४-२२-४२", "content_sanskrit": "त्वं नृसिंहः स्वयं पूर्णो हिरण्यकशिपोर्वधे ।\nप्रह्रादानुग्रहार्थाय देवानां रक्षणाय च ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003087042, "chapter_id": 23087, "verse_number": "४-२२-४३", "content_sanskrit": "त्वं च वेदोद्धारकर्ता मीनांशेन दयानिधे ।\nनृपस्य ज्ञानदानाय रक्षायै सुरविप्रयोः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003087043, "chapter_id": 23087, "verse_number": "४-२२-४४", "content_sanskrit": "शेषाधारश्च कूर्मस्त्वमंशेन सृष्टिहेतवे ।\nविश्वाधारश्च विश्वस्त्वमंशेनापि सहस्रधृक् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003087044, "chapter_id": 23087, "verse_number": "४-२२-४५", "content_sanskrit": "रामो दाशरथिस्त्वं च जानक्युद्धारहेतवे ।\nदशकन्धरहन्ता च सिन्धौ सेतुविधायकः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003087045, "chapter_id": 23087, "verse_number": "४-२२-४६", "content_sanskrit": "कलया परशुरामश्च जमदग्निसुतो महान् ।\nत्रिःसप्तकृत्वो भूपानां निहन्ता जगतीपते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003087046, "chapter_id": 23087, "verse_number": "४-२२-४७", "content_sanskrit": "अंशेन कपिलस्त्वं च सिद्धानां च गुरोर्गुरुः ।\nमातृज्ञानप्रदाता च योगशास्त्रविधायकः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003087047, "chapter_id": 23087, "verse_number": "४-२२-४८", "content_sanskrit": "अंशेन ज्ञानिनां श्रेष्ठो नरनारायणावृषी ।\nत्वं च धर्मसुतो भूत्वा लोकविस्तारकारकः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003087048, "chapter_id": 23087, "verse_number": "४-२२-४९", "content_sanskrit": "अधुना कृष्णरूपस्त्वं परिपूर्णतमः स्वयम् ।\nसर्वेषामवताराणां बीजरूपः सनातनः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003087049, "chapter_id": 23087, "verse_number": "४-२२-५०", "content_sanskrit": "यशोदाजीवनो नित्यो नन्दैकानन्दवर्धनः ।\nप्राणाधिदेवो गोपीनां राधाप्राणाधिकप्रियः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003087050, "chapter_id": 23087, "verse_number": "४-२२-५१", "content_sanskrit": "वसुदेवसुतः शान्तो देवकीदुःखभञ्जनः ।\nअयोनिसंभवः श्रीमान्पृथिवीभारहारकः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003087051, "chapter_id": 23087, "verse_number": "४-२२-५२", "content_sanskrit": "पूतनायै मातृगतिं प्रदाता च कृपानिधिः ।\nबककेशिप्रलम्बानां ममापि मोक्षकारकः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003087052, "chapter_id": 23087, "verse_number": "४-२२-५३", "content_sanskrit": "स्वेच्छामय गुणातीत भक्तानां भयभञ्जन ।\nप्रसीद राधिकानाथ प्रसीद कुरु मोक्षणम्॥ ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003087053, "chapter_id": 23087, "verse_number": "४-२२-५४", "content_sanskrit": "हे नाथ गार्दभीयोनेः समुद्धर भवार्णवात्।\nमूर्खस्त्वद्भक्तपुत्रोऽहं मामुद्धर्तुं त्वमर्हसि ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003087054, "chapter_id": 23087, "verse_number": "४-२२-५५", "content_sanskrit": "वेदा ब्रह्मादयो यं च मुनीन्द्राः स्तोतुमक्षमाः ।\nकिं स्तौमि तं गुणातीतं पुरा दैत्योऽधुना खरः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003087055, "chapter_id": 23087, "verse_number": "४-२२-५६", "content_sanskrit": "एवं कुरु कृपासिन्धो येन मे न भवेज्जनुः ।\nदृष्ट्वा पादारविन्दं ते कः पुनर्भवनं व्रजेत् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003087056, "chapter_id": 23087, "verse_number": "४-२२-५७", "content_sanskrit": "ब्रह्मा स्तोता खरः स्तोता नोपहासितुमर्हसि।\nसदीश्वरस्य विज्ञस्य योग्यायोग्ये समा कृपा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003087057, "chapter_id": 23087, "verse_number": "४-२२-५८", "content_sanskrit": "इत्येवमुक्त्वा दैत्येन्द्रस्तस्थौ च पुरतो हरेः ।\nप्रसन्नवदनः श्रीमानतितुष्टो बभूव ह ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003087058, "chapter_id": 23087, "verse_number": "४-२२-५९", "content_sanskrit": "इदं दैत्यकृतं स्तोत्रं नित्यं भक्त्या च यः पठेत् ।\nसालोक्यसार्ष्टिसामीप्यं लीलया लभते हरेः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003087059, "chapter_id": 23087, "verse_number": "४-२२-६०", "content_sanskrit": "इह लोके हरेर्भक्तिमन्ते दास्यं सुदुर्लभम्। ।\nविद्यां श्रियं सुकवितां पुत्रपौत्रान्यशो लभेत् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003087060, "chapter_id": 23087, "verse_number": "४-२२-६१", "content_sanskrit": "श्रीनारायण उवाच ।\nश्रुत्वाऽनुमेने दैत्येन्द्रस्तवनं करुणानिधिः ।\nकथं करोमि संहारमीदृशं भक्तमित्यहो॥ ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003087061, "chapter_id": 23087, "verse_number": "४-२२-६२", "content_sanskrit": "अनुमन्य स्मृतिं तस्य संजहार हरिः स्वयम् ।\nन हि युक्तो वधः स्तोतुर्दुर्वक्तुर्विधिरीश्वरात् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003087062, "chapter_id": 23087, "verse_number": "४-२२-६३", "content_sanskrit": "दानवो मायया विष्णोर्विसस्मार पुनः स्वकम्। ।\nदुरुक्तिस्तत्कण्ठदेशे ह्यधिष्ठानं चकार ह ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003087063, "chapter_id": 23087, "verse_number": "४-२२-६४", "content_sanskrit": "उवाच श्रीहरिं दैत्यः कोपात्प्रस्फुरिताधरः ।\nमुने सद्यो मर्तुकामो दैवग्रस्तो विचेतनः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003087064, "chapter_id": 23087, "verse_number": "४-२२-६५", "content_sanskrit": "दैत्य उवाचध्रुवं त्वं मर्तुकामोऽसि दुर्बुद्धे मानवार्भक ।\nअद्य प्रस्थापयिष्यामि त्वामहं यममन्दिरम्॥ ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003087065, "chapter_id": 23087, "verse_number": "४-२२-६६", "content_sanskrit": "आयासि जीवनाकाङ्क्षी मम तालवनं शिशो। ।\nन यास्यसि पुनर्गेहं बान्धवं न हि द्रक्ष्यसि ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003087066, "chapter_id": 23087, "verse_number": "४-२२-६७", "content_sanskrit": "न कंसो न जरासन्धो नरको न समो मम ।\nदेवाः कम्पन्ति मे नित्यं के चान्ये मत्समा भुवि ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003087067, "chapter_id": 23087, "verse_number": "४-२२-६८", "content_sanskrit": "नहि संहारकर्ता च मां संहर्तुं क्षमः शिवः ।\nन च ब्रह्मा न विष्णुश्च न मृत्युः काल एव च ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003087068, "chapter_id": 23087, "verse_number": "४-२२-६९", "content_sanskrit": "मम तालतरून्भङ्क्त्वा पातयित्वा फलानि च ।\nअहंकरोषि सहसा किमहो कस्य तेजसा ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003087069, "chapter_id": 23087, "verse_number": "४-२२-७०", "content_sanskrit": "कस्त्वं वद बटो सत्यं कमनीयोऽतिसुन्दरः ।\nदुर्लभं जीवनं दातुं मह्यं कथमिहागतः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003087070, "chapter_id": 23087, "verse_number": "४-२२-७१", "content_sanskrit": "इत्युक्त्वा मस्तके कृत्वा प्रेरयित्वा तु तं बली ।\nदूरतः पातयामास श्रीकृष्णं मरणोन्मुखः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003087071, "chapter_id": 23087, "verse_number": "४-२२-७२", "content_sanskrit": "पातयित्वा च तं भूमौ विषाणाभ्यां जघान सः ।\nकृष्णाङ्गस्पर्शमात्रेण तद्विषाणे बभञ्जतुः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003087072, "chapter_id": 23087, "verse_number": "४-२२-७३", "content_sanskrit": "दैत्यो भग्नविषाणश्च तमीशं कोपयन्मुने ।\nजग्रास चर्वणं कर्तुं भग्नदन्तो बभूव ह ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003087073, "chapter_id": 23087, "verse_number": "४-२२-७४", "content_sanskrit": "तेजसा दग्धवक्त्रश्च तमुज्जग्राह तत्क्षणे ।\nजज्वाल व्यथितः कोपाद्ददार खुरतो महीम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003087074, "chapter_id": 23087, "verse_number": "४-२२-७५", "content_sanskrit": "चूर्णयित्वा तु लांगूलं शब्दं कृत्वा भयानकम् ।\nस जगाम शिशुस्थानं दुद्रुवुर्बालका भिया ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003087075, "chapter_id": 23087, "verse_number": "४-२२-७६", "content_sanskrit": "बलं च प्रेरयामास मस्तकेन महाबली ।\nबलो मुष्टिं ददौ तस्मै मूर्च्छामाप ततोऽसुरः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003087076, "chapter_id": 23087, "verse_number": "४-२२-७७", "content_sanskrit": "क्षणेन चेतनां प्राप्य जगाम हरिसन्निधिम् ।\nबलमुष्ट्या च व्यथितः पुनर्मूर्च्छामवाप सः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003087077, "chapter_id": 23087, "verse_number": "४-२२-७८", "content_sanskrit": "पुनश्च चेतनां प्राप्य समुत्तस्थौ व्यथाकुलः ।\nउत्ससर्ज बृहल्लेडं मूत्रं च भयमाप ह ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003087078, "chapter_id": 23087, "verse_number": "४-२२-७९", "content_sanskrit": "क्षणात्संधिक्षणं प्राप्य  महाबलपराक्रमः ।\nकृत्वा शिरसि गोविन्दं चूर्णयामास दानवः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003087079, "chapter_id": 23087, "verse_number": "४-२२-८०", "content_sanskrit": "पातयामास भूमौ तं चूर्णयित्वा पुनःपुनः ।\nउत्पाट्य  तालवृक्षं तं ताडयामास माधवः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003087080, "chapter_id": 23087, "verse_number": "४-२२-८१", "content_sanskrit": "यथा खड्गप्रहारेण दानवस्य भवेद्व्यथा ।\nतथा बभूव दैत्यस्य तालवृक्षस्य ताडनात् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003087081, "chapter_id": 23087, "verse_number": "४-२२-८२", "content_sanskrit": "गोवर्धनं समुत्पाट्य घातयामास तं विभुः ।\nपपात वेगाच्छैलेन्द्रस्तस्योपरि महामुने ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003087082, "chapter_id": 23087, "verse_number": "४-२२-८३", "content_sanskrit": "पर्वतस्य प्रहारेण मूर्च्छामाप महाबलः। ।\nबभूव जर्जराङ्गश्च रुधिरं च समुद्वमन् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003087083, "chapter_id": 23087, "verse_number": "४-२२-८४", "content_sanskrit": "क्षणेन चेतनां प्राप्य समुत्तस्थौ रुषाऽसुरः ।\nगृहीत्वा पर्वतश्रेष्ठं प्रेरयामास माधवम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003087084, "chapter_id": 23087, "verse_number": "४-२२-८५", "content_sanskrit": "दृष्ट्वा शैलमुत्पतन्तं वेगेन मधुसूदनः ।\nजग्राह दक्षिणकरे यथेक्षुदण्डवत्प्रभुः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003087085, "chapter_id": 23087, "verse_number": "४-२२-८६", "content_sanskrit": "पूर्वस्थाने पर्वतं तं स्थापयामास कौतुकात् ।\nगृहीत्वा दैत्यकर्णाग्रं पातयामास दूरतः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003087086, "chapter_id": 23087, "verse_number": "४-२२-८७", "content_sanskrit": "उत्पत्य च महावेगाच्चकार वेष्टनं हरेः ।\nपृथिवीं घर्षयामास तीक्ष्णाग्रेण खुरेण च ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003087087, "chapter_id": 23087, "verse_number": "४-२२-८८", "content_sanskrit": "प्रगृह्य श्रीहरिं वेगात्कृत्वा मूर्ध्नि महासुरः ।\nउत्पपात मनोयायी लीलया लक्षयोजनम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003087088, "chapter_id": 23087, "verse_number": "४-२२-८९", "content_sanskrit": "प्रहरं च तयोर्युद्धं निर्लक्षे च बभूव ह ।\nततो गृहीत्वा श्रीकृष्णं पपात धरणीतले ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003087089, "chapter_id": 23087, "verse_number": "४-२२-९०", "content_sanskrit": "पुनर्मुहूर्तं युद्धं च बभूव भूतले तयोः ।\nमुदा हरिः प्रशशंस प्रहस्य दानवेश्वरम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003087090, "chapter_id": 23087, "verse_number": "४-२२-९१", "content_sanskrit": "मद्भक्तस्य बलेः पुत्रं धन्यं तज्जीवनं परम्। ।\nस्वस्त्यस्तु ते दानवेन्द्र वत्स निर्वाणतां व्रज ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003087091, "chapter_id": 23087, "verse_number": "४-२२-९२", "content_sanskrit": "मद्दर्शनं स्वस्तिबीजं परं निर्वाणकारणम् ।\nसर्वाधिकं सर्वपरं लभ स्थानं मनोहरम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003087092, "chapter_id": 23087, "verse_number": "४-२२-९३", "content_sanskrit": "इत्येवमुक्त्वा श्रीकृष्णः सस्मार चक्रमुत्तमम् ।\nसूर्यकोटिसमं दीप्त्या जग्राह तत्सुदर्शनम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003087093, "chapter_id": 23087, "verse_number": "४-२२-९४", "content_sanskrit": "चिक्षेप भ्रामयित्वा च षोडशारमनुत्तमम् ।\nचिच्छेद लीलयाऽवध्यं ब्रह्मविष्णुमहेश्वरैः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003087094, "chapter_id": 23087, "verse_number": "४-२२-९५", "content_sanskrit": "पपात मस्तकं भूमौ दानवस्य महात्मनः ।\nतेजःसमूह उत्तस्थौ शतसूर्यसमप्र भः९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003087095, "chapter_id": 23087, "verse_number": "४-२२-९६", "content_sanskrit": "विलोक्य हरिलोकं संश्लिष्टं कृष्णपदाम्बुजे ।\nसंप्राप्य परमं मोक्षमहो दानवपुङ्गवः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003087096, "chapter_id": 23087, "verse_number": "४-२२-९७", "content_sanskrit": "गगनस्थाः सुराः सर्वे मुनयश्च भृशं मुदा ।\nपारिजातप्रसूनानां चक्रुस्ते तत्र वर्षणम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003087097, "chapter_id": 23087, "verse_number": "४-२२-९८", "content_sanskrit": "नेदुर्दुन्दुभयः स्वर्गे ननृतुश्चाप्सरोगणाः ।\nजगुर्गन्धर्वनिकरा स्तुष्टुवुर्मुनयो मुदा ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003087098, "chapter_id": 23087, "verse_number": "४-२२-९९", "content_sanskrit": "स्तुत्वा जग्मुः सुराः सर्वे मुनयो हर्षविह्वलाः ।\nधेनुकस्य वधं दृष्ट्वा तत्राजग्मुश्च बालकाः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003087099, "chapter_id": 23087, "verse_number": "४-२२-१००", "content_sanskrit": "बलश्च बलिनां श्रेष्ठस्तुष्टाव पुरुषोत्तमम् ।\nतुष्टुवुर्बालकाः सर्वे ननृतुश्च मुदाऽन्विताः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003087100, "chapter_id": 23087, "verse_number": "४-२२-१०१", "content_sanskrit": "दत्त्वा कृष्णबलाभ्यां च प्रपक्वानि फलानि च ।\nसर्वाणि भक्षयामासुर्बालाः प्रहष्टमानसाः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003087101, "chapter_id": 23087, "verse_number": "४-२२-१०२", "content_sanskrit": "भुक्त्वा पीत्वा हरिः शीघ्रं बलेन बालकैः सह ।\nजगाम स्वालयं ब्रह्मन्निहत्य दानवेश्वरम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}]