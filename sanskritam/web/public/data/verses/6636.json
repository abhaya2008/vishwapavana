[
  {
    "id": 20006267,
    "chapter_id": 6636,
    "verse_number": "6.1",
    "content_sanskrit": "अथ रिरंसुममुं युगपद्गिरौ कृतयथास्वतरुप्रसवश्रिया । ऋतुगणेन निषेवितुमादधे भुवि पदं विपदन्तकृतं सतां ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20006268,
    "chapter_id": 6636,
    "verse_number": "6.2",
    "content_sanskrit": "नवपलाशपलाशवनं पुरः स्फुटपरागपरागतपङ्कजम् । मृदुलतान्तलतान्तमलोकयत्स सुरभिं सुरभिं सुमनोभरैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20006269,
    "chapter_id": 6636,
    "verse_number": "6.3",
    "content_sanskrit": "विलुलितालकसंहृतिरामृशन्मृगदृशां श्रमवारि ललाटजम् । तनुतरङ्गततिं सरसां दलत्कुवलयं वलयन्मरुदाववौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20006270,
    "chapter_id": 6636,
    "verse_number": "6.4",
    "content_sanskrit": "तुलयति स्म विलोचनतारकाः कुरबकस्तबकव्यतिषह्किणि । गुणवदाश्रयलब्धगुणोददये मालिनिमालिनि माधवयोषितां ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20006271,
    "chapter_id": 6636,
    "verse_number": "6.5",
    "content_sanskrit": "स्फुटमिवोज्वलकाञ्चकान्तिभिर्युतमशोकमशोभत चम्पकैः । विरहिणां हृदयस्य भिदाभृतः कपिशितं पिशितं मदनाग्निना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20006272,
    "chapter_id": 6636,
    "verse_number": "6.6",
    "content_sanskrit": "स्मराहुताशनमुर्मुरचूर्णतां दधुरिवाम्रवनस्य रजःकणाः । निपातिताः परितः पथिकव्रजानुपरि ते परितेपुरतो भृशम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20006273,
    "chapter_id": 6636,
    "verse_number": "6.7",
    "content_sanskrit": "रतिपतिप्रहितेव कृतक्रुधः प्रियतमेषु वधूरनुनायिका । बकुलपुष्परसासवपेशलध्वनिरगान्निरगात्मधुपावलिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20006274,
    "chapter_id": 6636,
    "verse_number": "6.8",
    "content_sanskrit": "प्रियसखीसदृशं प्रतिबोधिताः किमपि काम्यगिरा परपुष्टया । प्रियतमाय वपुर्गुरुमत्सरच्छिदुरयादुरनाचिंअङ्गनाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20006275,
    "chapter_id": 6636,
    "verse_number": "6.9",
    "content_sanskrit": "मधुकरैरपवादकरैरिव स्मृतिभुवः पथिकाः हरिणा इव । कलतया वचसः परिवादिनीस्वरजिता वशमाययुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20006276,
    "chapter_id": 6636,
    "verse_number": "6.10",
    "content_sanskrit": "समभिसृत्य रसादवलम्बितः प्रमदया कुसुमावचिचीर्षया । अविनमन्न रराजवृथोच्चकैरनृतया नृतया वनपादपः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20006277,
    "chapter_id": 6636,
    "verse_number": "6.11",
    "content_sanskrit": "इदमपास्य विरागि परागीरलिकदम्बकमम्बुरुहां ततीः । स्तनभरेण जितस्तबकानमन्नवलते वलतेऽभिमुखं तव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20006278,
    "chapter_id": 6636,
    "verse_number": "6.12",
    "content_sanskrit": "सुरभिणिश्वसिते दधतस्तृषं नवसुधामधुरे च तवाधरे । अलमलेरिव गन्धरसावमू मम न सौमनसौ मनसो मुदे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20006279,
    "chapter_id": 6636,
    "verse_number": "6.13",
    "content_sanskrit": "इति गदन्तमनन्तरमङ्गना भुजयुगोन्नमनोच्चतरस्तनी । प्रणयिनं रभसादुदरश्रिया वलिभयादलिभयादिव सस्वजे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20006280,
    "chapter_id": 6636,
    "verse_number": "6.14",
    "content_sanskrit": "वदनसौरभलोभपरिभ्रमद्भ्रमरसंभ्रमसंभृतशोभया । चलितया विदधे कलमेखलाकलकलोऽलकलोलदृशान्यया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20006281,
    "chapter_id": 6636,
    "verse_number": "6.15",
    "content_sanskrit": "अजगणन्गणशः प्रियमग्रतः प्रणतमप्यभिमानितया न याः । सति मधावभवन्मदनव्यथा विधुरिता धुरिताः कुकुरस्त्रियः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20006282,
    "chapter_id": 6636,
    "verse_number": "6.16",
    "content_sanskrit": "कुसुमकार्मुककार्मुकसंहितद्रुतशिलीमुखखण्डितविग्रहाः । मरणमप्यपराः प्रतिपेदिरे किमु मुहुर्मुहुर्गतभर्तृकाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20006283,
    "chapter_id": 6636,
    "verse_number": "6.17",
    "content_sanskrit": "रुरुधिषा वदनाम्बुरुहश्रियः सुतनु सत्मलङ्करणाय ते । तदपि सम्प्रति सन्निहिते मधावधिगमं धिगमङ्गलमश्रुणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20006284,
    "chapter_id": 6636,
    "verse_number": "6.18",
    "content_sanskrit": "त्यजति कष्टामसावचिरादसून्विरहवेदनयेत्यघशङ्गिभिः । प्रियतया गदितास्त्वयि बान्धवैरवितथा वितथाः सखि मा गिरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20006285,
    "chapter_id": 6636,
    "verse_number": "6.19",
    "content_sanskrit": "न खलु दूरगतोऽप्यधिवर्तते महमसाविति बन्धुतयोदितैः । प्रणयिनो निशमय्य वधूर्बहिः स्वरमृतैरमृतैरिव निर्ववौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20006286,
    "chapter_id": 6636,
    "verse_number": "6.20",
    "content_sanskrit": "मधुरया मधुबोधितमाधवीमधुसमृद्धिसमेधितमेधया । मधुकराङ्गनया मुहुरुन्मदध्वनिभृता निभृताक्षरमुज्जगे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20006287,
    "chapter_id": 6636,
    "verse_number": "6.21",
    "content_sanskrit": "अरुणिताखिशैलवना मुहुर्विदधती पथिकान्परितापिनः । विकचकिंशुकसंहतिरुच्चकैरुदवहद्दवहव्यवहश्रियम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20006288,
    "chapter_id": 6636,
    "verse_number": "6.22",
    "content_sanskrit": "रवितुरङ्गतनूरुहतुल्यतां दधति यत्र शिरीषरजोरुचः । उपययौ विदधन्नवमल्लिकाः शुचिरसौ चिरसौरभसंपदः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20006289,
    "chapter_id": 6636,
    "verse_number": "6.23",
    "content_sanskrit": "दलितकोमलपाटलकुड्मले निजवधूश्वसितानुविधायिनि । मरुति वाति विलासिभिरुन्मदभ्रमदलौ मदलौल्यमुपाददे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20006290,
    "chapter_id": 6636,
    "verse_number": "6.24",
    "content_sanskrit": "निदधिरे दयितोरसि तत्क्षणस्पनवारितुषारभृतः स्तनाः । सरसचन्दनरेणुरनुक्षणं विचकरे च करेण वरोरुभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20006291,
    "chapter_id": 6636,
    "verse_number": "6.25",
    "content_sanskrit": "स्फुरदधीरतडिन्नयना मुहुः प्रियमिवागलितोरुपयोधरा । जलधरावलिरप्रतिपालितस्वसमया समयाञ्जगतीधरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20006292,
    "chapter_id": 6636,
    "verse_number": "6.26",
    "content_sanskrit": "गजकदम्बकमेचकमुच्चकैर्नभसि वीक्ष्य नवाम्बुदमम्बरे । अभिससार न वल्लभमङ्गना न चकमे च कमेकरसं रहः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20006293,
    "chapter_id": 6636,
    "verse_number": "6.27",
    "content_sanskrit": "अनुययौ विविधोपलकुण्डलद्युतिवितानकसंवलितांशुकम् । धुततनुर्वलयस्य पयोमुचः शबलिमा बलिमानमुषो वपुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20006294,
    "chapter_id": 6636,
    "verse_number": "6.28",
    "content_sanskrit": "द्रुतसमीरचलैः क्षणलक्षितव्यवहिता विटपैरिव मञ्जरी । नततमालनिभस्य नभस्तरोरचिररोचिररोचत वारिदैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20006295,
    "chapter_id": 6636,
    "verse_number": "6.29",
    "content_sanskrit": "पटलमम्बुमुचां पथिकाङ्गना सपदि जीवितसंशयमेष्यती । सनयनाम्बुसखीजन संभ्रमाद्विधुरबन्धुरबन्धुरमैक्षत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20006296,
    "chapter_id": 6636,
    "verse_number": "6.30",
    "content_sanskrit": "प्रवसतः सुतरामुदकम्पयद्विलकन्दलकम्पनलालितः । नमयति स्म वनानि मनस्विनीजननमनो घनमारुतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20006297,
    "chapter_id": 6636,
    "verse_number": "6.31",
    "content_sanskrit": "जलदपङ्क्तिरनर्तयदुन्मदंकलविलापि कलापिकदम्बकम् । कृतसमार्जनमर्दलमण्डलध्वनिजया निजया स्वनसंपदा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20006298,
    "chapter_id": 6636,
    "verse_number": "6.32",
    "content_sanskrit": "नवकदम्बजोऽरुणिताम्बरैरधिपुरन्ध्रि शिलीन्ध्रसुगन्धिभिः । मनसि रागवतामनुरागिता नवनवा वनवायुभिरादधे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20006299,
    "chapter_id": 6636,
    "verse_number": "6.33",
    "content_sanskrit": "शमिततापमपोढमहीरजः प्रथमबिन्दुभिरम्बुमुचोऽम्भसां । प्रविरलैरचलाङ्गनमङ्गनाजनसुगं न सुगन्धि न चक्रिरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20006300,
    "chapter_id": 6636,
    "verse_number": "6.34",
    "content_sanskrit": "द्विरदवलक्षमलक्ष्यत स्फुरितभृङ्गमृच्छवि केतकम् । घनघनौघविघट्टनया दिवः कृशसिखं शशिखण्डमिव च्युतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20006301,
    "chapter_id": 6636,
    "verse_number": "6.35",
    "content_sanskrit": "दलितमौक्तिकचूर्णविपाण्डवः स्फुरितनिर्झरशीकरचारवः । कुटजपुष्पपरागकणाः स्फुटं विदधिरे दधिरेणुविडम्बनाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20006302,
    "chapter_id": 6636,
    "verse_number": "6.36",
    "content_sanskrit": "नवपयःकणकोमलमालतीकुसुमसंततिसंततसङ्गिभिः । प्रचलितोडुनिभैः परिपाण्डिमाः शुभरजोभरजोऽलिभिराददे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20006303,
    "chapter_id": 6636,
    "verse_number": "6.37",
    "content_sanskrit": "निजरजः पटवासमिवाकिरद्धृतपटोपमवारिमुचां दिशां । प्रियवियुक्तवधूजनचेतसामनवनी नवनीपवनावलिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20006304,
    "chapter_id": 6636,
    "verse_number": "6.38",
    "content_sanskrit": "प्रणयकोपभृतोऽपि पराङ्मुखाः सपदि वारिधरारवभीरवः । प्रणयिनः परिरब्धुमथाङ्गना ववलिरे वलिरेचितमध्यमाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20006305,
    "chapter_id": 6636,
    "verse_number": "6.39",
    "content_sanskrit": "विगतरागगुणोऽपि जनो न कश्चलति वाति पयोदनभस्वति । अभिहितेऽलिभिरेवमिवोच्चकैरननृते ननृते नवपल्लवैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20006306,
    "chapter_id": 6636,
    "verse_number": "6.40",
    "content_sanskrit": "अरमयन्भवनादचिरद्युतेः किल भयादमपयातुमनिच्छवः । यदुनरेन्द्रगणं तरुणागणास्तमथ मन्मथमन्थरभाषिणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20006307,
    "chapter_id": 6636,
    "verse_number": "6.41",
    "content_sanskrit": "ददतमन्तरिताहिमदीधितिं खगकुलाय कुलायनिलायिताम् । जलदकालमबोधकृतं दिशामपराथाप रथवयवायुधः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20006308,
    "chapter_id": 6636,
    "verse_number": "6.42",
    "content_sanskrit": "स विकचोत्पलचक्षुषमैक्षत क्षितिभृतोऽङगगतां दयितामिव । शरदमच्छगलद्वसनोपमाक्षमधनामघनाशनकीर्तनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20006309,
    "chapter_id": 6636,
    "verse_number": "6.43",
    "content_sanskrit": "जगति नैशमशीतकरः करैर्वियति वारिदवृन्दमयं तमः । जलजराजिषु नैन्द्रमदिद्रवन्न महतामहताः क्व च नारयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20006310,
    "chapter_id": 6636,
    "verse_number": "6.44",
    "content_sanskrit": "समय एव करोति बलाबलं प्रणिगतवन्त इतीव शरीरिणाम् । शरदि हंसरवाः परुषीकृतस्वरमयूरमयू रमणीयताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20006311,
    "chapter_id": 6636,
    "verse_number": "6.45",
    "content_sanskrit": "तनुरुहाणि पुरो विजितध्वनेर्धवलपक्षविहङ्गमकूजितैः । जगलुरक्षमयेव शिखण्डिनः परिभवोऽरिभवो हि सुदुःसहः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20006312,
    "chapter_id": 6636,
    "verse_number": "6.46",
    "content_sanskrit": "अनुवनं वनराजिवधूमुखे बहलरागजवाधरचारुणि । विकचबाणवलयोऽधिकं रुरुचिरे रुचिरेक्षणविभ्रमाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20006313,
    "chapter_id": 6636,
    "verse_number": "6.47",
    "content_sanskrit": "कनकभङ्गपिशङ्गदलैर्दधे सरजसारुणकेशरचारुभिः । प्रियविमानितमानवतीरुषां निरसनैरसनैरवृथार्थता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20006314,
    "chapter_id": 6636,
    "verse_number": "6.48",
    "content_sanskrit": "मुखसरोजरुचं मदपाटलामनुचकार चकोरदृशां यतः । धृतनवातपमुत्सुकतामतो न कमलं कमलम्भयदम्भसि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20006315,
    "chapter_id": 6636,
    "verse_number": "6.49",
    "content_sanskrit": "विगतसस्यजिधत्समघट्टयत्कलमगोपवधूर्न मृगव्रजम् । श्रुततदीरितकोमलगीतकध्वनिमिषेऽनिमेषेक्षणमग्रतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20006316,
    "chapter_id": 6636,
    "verse_number": "6.50",
    "content_sanskrit": "कृतमदं निगदन्त इवाकुलीकृतजगत्रयमूर्जमतङ्गजम् । ववुरयुक्छदगुच्छसुगन्धयः सततगास्ततगानगिरोऽलिभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20006317,
    "chapter_id": 6636,
    "verse_number": "6.51",
    "content_sanskrit": "विगतवारिधरावरणाः क्वचिददृशुरुल्लसितासितासिताः । क्वचिदिवेन्द्रगजाजिनकञ्चुकाः शरदि नीरदिनीर्यदेवो दिशः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20006318,
    "chapter_id": 6636,
    "verse_number": "6.52",
    "content_sanskrit": "विलुलितामनिलैः शरदङ्गना नवसरोरुहकेशरसम्भवाम् । विकरितुं परिहासविधित्सया हरिवधूरिव धूलिमुधक्षिपत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20006319,
    "chapter_id": 6636,
    "verse_number": "6.53",
    "content_sanskrit": "हरितपत्रमयीव मरुद्गणैः स्रगवनद्धमनोरमपल्लवा । मधुरिपोरभिताम्रमुखी मुदं दिवि तता विततान शुकावलिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20006320,
    "chapter_id": 6636,
    "verse_number": "6.54",
    "content_sanskrit": "स्मितसरोरुहनेत्रसरोजलामतिसितङ्गविहङ्गहसद्दिवम् । अकलयन्मुदितामिव सर्वतः स शरदन्तुरदिह्मुखाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20006321,
    "chapter_id": 6636,
    "verse_number": "6.55",
    "content_sanskrit": "गजद्वयसीरपि हैमनस्तुहिनयन्सरितः पृषतां पतिः । सलिलसन्ततिमध्वगयोषितामतुनतातनुतापकृतं दृशां ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20006322,
    "chapter_id": 6636,
    "verse_number": "6.56",
    "content_sanskrit": "इदमयुक्तमहो महदेव यद्वरतनोः स्मरयत्यनिलोऽन्यदा । स्मृसयौवनसोष्मपयोधरान्सतुहिनस्तु हिनस्तु वियोगिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20006323,
    "chapter_id": 6636,
    "verse_number": "6.57",
    "content_sanskrit": "प्रियतमेन यया सरुषा स्थितं न सह सा सहसा परिरभ्य तम् । श्लथयितुं क्षणमक्षमतामङ्गना न सह सा सहसा कृतवेपथुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20006324,
    "chapter_id": 6636,
    "verse_number": "6.58",
    "content_sanskrit": "भृशमदूयत याधरपल्लवक्षतिरनावरणा हिममारुतैः । दशनरश्मिपटेन च सीत्कृतैर्निवासितेव सितेन सुनिर्ववौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20006325,
    "chapter_id": 6636,
    "verse_number": "6.59",
    "content_sanskrit": "व्रणभृता सुतनोः कलसीकृतस्फुरितदन्तमरीचिमयं दधे । स्फुटमिवावरणं हिमारुतैर्मृदुतया दुतयाधरलेखया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20006326,
    "chapter_id": 6636,
    "verse_number": "6.60",
    "content_sanskrit": "धृततुषारकणस्य नभस्वतस्तरुलताङ्गुलितर्जनविभ्रमाः । पृथु निरन्तरमिष्टभुजान्तरं वनितयानितया न विषेहिरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20006327,
    "chapter_id": 6636,
    "verse_number": "6.61",
    "content_sanskrit": "हिमऋतावपि ताः स्म भृशस्विदो युवतयः सुतरामुपकारिणौ । प्रकटयत्यनुरागमकृत्रिमं स्मरमयं रमयन्ति विलासिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20006328,
    "chapter_id": 6636,
    "verse_number": "6.62",
    "content_sanskrit": "कुसुमयन्फलिनीरवैमर्दविकासिभिरहितहुंकृतिः । उपवनं निरभर्सयत प्रियान्वियुवतीर्युवतीः शिशिरानिलः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20006329,
    "chapter_id": 6636,
    "verse_number": "6.63",
    "content_sanskrit": "उपचितेषु परेष्वसमर्थतां व्रजति कालवशाद्बलवानपि । तपसि मन्दगभस्तिरभीषुमान्नहि महाहिमनिकरोऽभवत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20006330,
    "chapter_id": 6636,
    "verse_number": "6.64",
    "content_sanskrit": "अबिषिषेणयिषुं भुवनानि यः स्मरमिवाख्यात लोध्ररचश्चयः । क्षुभितसैन्यपरागविपाण्डुरद्युतिरयं तिरयन्नुभूद्दिशः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20006331,
    "chapter_id": 6636,
    "verse_number": "6.65",
    "content_sanskrit": "शिशिरमासमपास्य गुणोस्य नः क इव शीतहरस्य कुचोष्मणः । इति धियास्तरुषः परिरेभिरे घनमतो नमतोऽनुमतान्प्रियाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20006332,
    "chapter_id": 6636,
    "verse_number": "6.66",
    "content_sanskrit": "अधिलवङ्गममी रजसाधिकं मलिनिताः सुमनोदलतालिनः । स्फुटमिति प्रसवेन पुरोऽहसत्सपदि कुन्दलता दलतालिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20006333,
    "chapter_id": 6636,
    "verse_number": "6.67",
    "content_sanskrit": "अतिसुरभिभाजि पुष्पश्रियामतुनुतरतयेष सन्तानकः । तरुणपरभृतः स्वनं रागिणामतनुत रतये वसन्तानकः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20006334,
    "chapter_id": 6636,
    "verse_number": "6.68",
    "content_sanskrit": "नोज्झितुं युवतिमानसनिरासे दक्षमिष्टमधुवासरसां । चूतमालिरलिनामतिरागादक्षमिष्ट मधुवासरसारम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20006335,
    "chapter_id": 6636,
    "verse_number": "6.69",
    "content_sanskrit": "जगद्वशीकर्तुमिमाः स्मरस्य प्रभावनीके तनवै जयन्तीः । इत्यस्य तेने कदलीर्मधुश्रीः प्रभावनी केतनवैजयन्तीः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20006336,
    "chapter_id": 6636,
    "verse_number": "6.70",
    "content_sanskrit": "स्मररागमयी वपुस्तमिस्रा परिसस्तार रवेरसत्यवशम् । प्रियमाप दिवापि कोकिले स्त्री परितस्ताररवे रसत्वश्यम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20006337,
    "chapter_id": 6636,
    "verse_number": "6.71",
