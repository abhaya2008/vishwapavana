[{"id": 7004470000, "chapter_id": 24470, "verse_number": "५-३-१६४-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततो गच्छेन्महाराज सांवौरं तीर्थमुत्तमम् ।\nयत्र संनिहितो भानुः पूज्यमानः सुरासुरैः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004470001, "chapter_id": 24470, "verse_number": "५-३-१६४-२", "content_sanskrit": "तत्र ये पङ्गुतां प्राप्ताः शीर्णघ्राणनखा नराः ।\nदद्रुमण्डलभिन्नाङ्गा मक्षिकाकृमिसंकुलाः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004470002, "chapter_id": 24470, "verse_number": "५-३-१६४-३", "content_sanskrit": "मातापितृभ्यां रहिता भ्रातृभार्याविवर्जिताः ।\nअनाथा विकला व्यङ्गा मग्ना ये दुःखसागरे॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004470003, "chapter_id": 24470, "verse_number": "५-३-१६४-४", "content_sanskrit": "तेषां नाथो जगद्योनिर्नर्मदातटमाश्रितः ।\nसांवौरनाथो लोकानामार्तिहा दुःखनाशनः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004470004, "chapter_id": 24470, "verse_number": "५-३-१६४-५", "content_sanskrit": "तत्र तीर्थे तु यः स्नात्वा मासमेकं निरन्तरम् ।\nपूजयेद्भास्करं देवं तस्य पुण्यफलं शृणु॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004470005, "chapter_id": 24470, "verse_number": "५-३-१६४-६", "content_sanskrit": "यत्फलं चोत्तरे पार्थ तथा वै पूर्वसागरे ।\nदक्षिणे पश्चिमे स्नात्वा तत्र तीर्थे तु तत्फलम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004470006, "chapter_id": 24470, "verse_number": "५-३-१६४-७", "content_sanskrit": "कौमारे यौवने पापं वार्द्धके यच्च संचितम् ।\nतत्प्रणश्यति सांवौरे स्नानमात्रान्न संशयः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004470007, "chapter_id": 24470, "verse_number": "५-३-१६४-८", "content_sanskrit": "न व्याधिर्नैव दारिद्र्यं न चैवेष्टवियोजनम् ।\nसप्तजन्मानि राजेन्द्र सांवौरपरिसेवनात्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004470008, "chapter_id": 24470, "verse_number": "५-३-१६४-९", "content_sanskrit": "सप्तम्यामुपवासेन तद्दिने चाप्युपोषिते ।\nस तत्फलमवाप्नोति तत्र स्नात्वा न संशयः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004470009, "chapter_id": 24470, "verse_number": "५-३-१६४-१०", "content_sanskrit": "रक्तचन्दनमिश्रेण यदर्घ्येण फलं स्मृतम् ।\nतत्र तीर्थे नृपश्रेष्ठ स्नात्वा तत्फलमाप्नुयात्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004470010, "chapter_id": 24470, "verse_number": "५-३-१६४-११", "content_sanskrit": "नर्मदासलिलं रम्यं सर्वपातकनाशनम् ।\nनिरीक्षितं विशेषेण सांवौरेण महात्मना॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004470011, "chapter_id": 24470, "verse_number": "५-३-१६४-१२", "content_sanskrit": "ते धन्यास्ते महात्मानस्तेषां जन्म सुजीवितम् ।\nस्नात्वा पश्यन्ति देवेशं सांवौरेश्वरमुत्तमम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004470012, "chapter_id": 24470, "verse_number": "५-३-१६४-१३", "content_sanskrit": "सूर्यलोके वसेत्तावद्यावदाभूतसम्प्लवम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]