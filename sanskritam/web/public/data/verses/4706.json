[{"id": 2174620, "chapter_id": 4706, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2174621, "chapter_id": 4706, "verse_number": "१", "content_sanskrit": "एवं दुर्योधने राजन् गर्जमाने पुनः पुनः ।\nवासुदेवोऽब्रवीद् क्रुद्धो युधिष्ठिरमिदं वचः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2174622, "chapter_id": 4706, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2174623, "chapter_id": 4706, "verse_number": "२", "content_sanskrit": "किमिदं व्याहृतं राजन् त्वया साहसमीदृशम् ।\nएकमेव निहत्याजौ भव राजा कुरुष्विति\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2174624, "chapter_id": 4706, "verse_number": "३", "content_sanskrit": "यदि नाम ह्ययं क्रुद्धो वरयेत् त्वां युधिष्ठिर ।\nअर्जुनं नकुलं वाऽपि सहदेवमथापि वा ।\nन समर्थानहं मन्ये गदाहस्तस्य संयुगे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2174625, "chapter_id": 4706, "verse_number": "४", "content_sanskrit": "एतेन हि कृता योध्या वर्षाणीह त्रयोदश ।\nआयसैः पुरुषै राजन् भीमसेनवधेप्सया\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2174626, "chapter_id": 4706, "verse_number": "५", "content_sanskrit": "कथं नाम भवेत् कार्यमस्माभिर्भरतर्षभ ।\nसाहसं कृतवान् यत् त्वमनुक्रोशान्नृपोत्तम\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2174627, "chapter_id": 4706, "verse_number": "६", "content_sanskrit": "न चान्यमद्य पश्यामि प्रतियोद्धारमाहवे ।\nऋते वृकोदरात् पार्थात् स च नातिकृतश्रमः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2174628, "chapter_id": 4706, "verse_number": "७", "content_sanskrit": "तदिदं द्यूतमारब्धं पुनरेव यथा पुरा ।\nविषमं शकुनेश्चैव तव चैव विशेषतः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2174629, "chapter_id": 4706, "verse_number": "८", "content_sanskrit": "बली भीमः समर्थश्च कृती राजन् सुयोधनः ।\nबलवान् वै कृती वेति कृती राजन् विशिष्यते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2174630, "chapter_id": 4706, "verse_number": "९", "content_sanskrit": "सोऽयं राजंस्त्वया शत्रुः समे पथि निवेशितः ।\nन्यस्तश्चात्मा सुविषमे कृच्छ्रमापादिता वयम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2174631, "chapter_id": 4706, "verse_number": "१०", "content_sanskrit": "को हि सर्वान् विनिर्जित्य शत्रूनेकेन वैरिणा ।\nपणित्वा चैकपाणेन शोचयेदेवमाहवम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2174632, "chapter_id": 4706, "verse_number": "११", "content_sanskrit": "कृच्छ्रप्राप्तेन च तथा हारयेद् राज्यमागतम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2174633, "chapter_id": 4706, "verse_number": "१२", "content_sanskrit": "न हि पश्यामि तँल्लोके याऽद्य दुर्योधनं रणे ।\nगदाहस्तं विजेतुं वै शक्तः स्यादमरोऽपि हि\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2174634, "chapter_id": 4706, "verse_number": "", "content_sanskrit": "(फल्गुनो वा भवान् वाऽपि माद्रीपुत्रावथापि वा ।\nन समर्थानहं मन्ये गदाहस्तस्य संयुगे\t॥१३॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2174635, "chapter_id": 4706, "verse_number": "१४", "content_sanskrit": "न त्वं भीमो न नकुलः सहदेवोऽथ फल्गुनः ।\nजेतुं न्यायेन शक्तो वै कृती राजा सुयोधनः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2174636, "chapter_id": 4706, "verse_number": "१५", "content_sanskrit": "स कथं वदसे शत्रुं युध्यस्व गदयेति ह ।\nएकं वा त्वं निहत्याजौ भव राजेति भारत\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2174637, "chapter_id": 4706, "verse_number": "१६", "content_sanskrit": "नूनं न राज्यभागेषा पाण्डोः कुन्त्याश्च सन्ततिः ।\nअत्यन्तवनवासाय सृष्टा भैक्षाय वा पुनः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2174638, "chapter_id": 4706, "verse_number": "", "content_sanskrit": "श्रीभीमसेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2174639, "chapter_id": 4706, "verse_number": "१७", "content_sanskrit": "मधुसूदन मा कार्षीर्विषादं यदुपुङ्गव ।\nअद्य पारं गमिष्यामि वैरस्यास्य सुदुर्गमम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2174640, "chapter_id": 4706, "verse_number": "१८", "content_sanskrit": "अहं सुयोधनं सङ्खे हनिष्यामि न संशयः ।\nविजयो वै ध्रुवः कृष्ण धर्मराजस्य दृश्यते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2174641, "chapter_id": 4706, "verse_number": "१९", "content_sanskrit": "अध्य(त्य)र्थेन गुणेनेयं गदा गुरुतरी मम ।\nन तथा धार्तराष्ट्रस्य मा कार्षीर्माधव व्यथाम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2174642, "chapter_id": 4706, "verse_number": "२०", "content_sanskrit": "अनया गदया चाहं संयुगे योद्धुमुत्सहे ।\nभवन्तः प्रेक्षकाः सर्वे मम सन्तु जनार्दन\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2174643, "chapter_id": 4706, "verse_number": "२१", "content_sanskrit": "सामरानपि लोकांस्त्रीन् नानाशस्त्रधरान् युधि ।\nयोधयेयं रणे कृष्ण किमुताद्य सुयोधनम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2174644, "chapter_id": 4706, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2174645, "chapter_id": 4706, "verse_number": "२२", "content_sanskrit": "तं तथा भाषमाणं तु वासुदेवो वृकोदरम् ।\nहृष्टः सम्पूजयामास वचनं चेदमब्रवीत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2174646, "chapter_id": 4706, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2174647, "chapter_id": 4706, "verse_number": "२३", "content_sanskrit": "त्वामासाद्य महाबाहो धर्मराजो युधिष्ठिरः ।\nनिहतारिः स्वकां दीप्तां श्रियमाप्नोत्यसंशयम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2174648, "chapter_id": 4706, "verse_number": "२४", "content_sanskrit": "त्वया विनिहताः सर्वे धृतराष्ट्रसुता रणे ।\nराजानो राजपुत्राश्च नागाश्च विनिपातिताः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2174649, "chapter_id": 4706, "verse_number": "२५", "content_sanskrit": "कलिङ्गमागधाः प्राच्या गान्धाराः कुरवस्तथा ।\nत्वमासाद्य महायुद्धे निहताः पाण्डुनन्दन\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2174650, "chapter_id": 4706, "verse_number": "२६", "content_sanskrit": "हत्वा दुर्योधनं चापि प्रयच्छोर्वीं ससागराम् ।\nधर्मराजाय कौन्तेय सशैलवनकाननाम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2174651, "chapter_id": 4706, "verse_number": "२७", "content_sanskrit": "त्वां तु प्राप्य रणे पापो धार्तराष्ट्रो विनश्यति ।\nत्वमस्य सक्थिनी भङ्क्त्वा प्रतिज्ञां पालयिष्यसि\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2174652, "chapter_id": 4706, "verse_number": "२८", "content_sanskrit": "यत्नेन हि त्वया पार्थ योद्धव्यो धृतराष्ट्रजः ।\nकृती च युद्धशौण्डश्च बलवांश्चैव पार्थिवः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2174653, "chapter_id": 4706, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2174654, "chapter_id": 4706, "verse_number": "२९", "content_sanskrit": "ततस्तु सात्यकी राजन् पूजयामास पाण्डवम् ।\nविविधाभरणस्रग्भिर्भीमसेनं जनेश्वर\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2174655, "chapter_id": 4706, "verse_number": "३०", "content_sanskrit": "पाञ्चालाः पाण्डवेयाश्च धर्मराजपुरोगमाः ।\nतद्वचो भीमसेनस्य सर्व एवाभ्यपूजयन्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2174656, "chapter_id": 4706, "verse_number": "३१", "content_sanskrit": "ततो भीमबलो भीमो युधिष्ठिरमथाब्रवीत् ।\nसृञ्जयैः सह तिष्ठन्तं तपन्तमिव भास्करम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2174657, "chapter_id": 4706, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2174658, "chapter_id": 4706, "verse_number": "३२", "content_sanskrit": "अहमेतेन सङ्गम्य संयुगे योद्धुमुत्सहे ।\nन हि शक्तो रणे जेतुं मामेष पुरुषाधमः ।\nसुयोधने धार्तराष्ट्रे खाण्डवेऽग्निमिवार्जुनः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2174659, "chapter_id": 4706, "verse_number": "३३", "content_sanskrit": "अद्य क्रोधं विमोक्ष्यामि निहितं हृच्छयं भृशम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2174660, "chapter_id": 4706, "verse_number": "", "content_sanskrit": "(शल्यमद्योद्धरिष्यामि तव पाण्डव हृद्गतम्\t॥३४॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2174661, "chapter_id": 4706, "verse_number": "३५", "content_sanskrit": "निहत्य गदया पापमद्य राजन् सुखी भव\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2174662, "chapter_id": 4706, "verse_number": "३६", "content_sanskrit": "अद्य कीर्तिमयीं मालां प्रतिमोक्ष्ये तवानघ ।\nप्राणान् श्रियं च राज्यं च मोक्ष्यतेऽद्य सुयोधनः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2174663, "chapter_id": 4706, "verse_number": "३७", "content_sanskrit": "राजा तु धृतराष्ट्रोऽथ श्रुत्वा पुत्रं निपातितम् ।\nस्मरिष्यत्यशुभं कर्म यत्तच्छकुनिबुद्धिजम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2174664, "chapter_id": 4706, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2174665, "chapter_id": 4706, "verse_number": "३८", "content_sanskrit": "इत्युक्त्वा भरतश्रेष्ठो गदामुद्यम्य भारत ।\nअवातिष्ठत युद्धाय शक्रो वृत्रमिवाह्वयन्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2174666, "chapter_id": 4706, "verse_number": "३९", "content_sanskrit": "तदाह्वानममृष्यन् वै तव पुत्रोऽतिवीर्यवान् ।\nप्रत्युपस्थित एवाशु मत्तो मत्तमिव द्विपम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2174667, "chapter_id": 4706, "verse_number": "४०", "content_sanskrit": "गदाहस्तं तव सुतं युद्धाय समुपस्थितम् ।\nददृशुः पाण्डवाः सर्वे कैलासमिव शृङ्गिणम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2174668, "chapter_id": 4706, "verse_number": "४१", "content_sanskrit": "तमेकाकिनमासाद्य धार्तराष्ट्रं महाबलम् ।\nनिर्यूथमिव मातङ्गं समहृष्यन्त पाण्डवाः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2174669, "chapter_id": 4706, "verse_number": "४२", "content_sanskrit": "तमुद्यतगदं दृष्ट्वा कैलासमिव शृङ्गिणम् ।\nभीमसेनस्तदा राजन् दुर्योधनमथाब्रवीत्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2174670, "chapter_id": 4706, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2174671, "chapter_id": 4706, "verse_number": "४३", "content_sanskrit": "राज्ञा च धृतराष्ट्रेण त्वया चास्मासु यत् कृतम् ।\nस्मर तद् दुष्कृतं कर्म यद् वृत्तं वारणावते\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2174672, "chapter_id": 4706, "verse_number": "४४", "content_sanskrit": "द्रौपदी सुपरिक्लिष्टा सभामध्ये रजस्वला ।\nद्यूते च वञ्चितो राजा शकुनेर्बुद्धिलाघवात्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2174673, "chapter_id": 4706, "verse_number": "४५", "content_sanskrit": "यानि चान्यानि दुष्टात्मन् पापानि कृतवानसि ।\nअनागतस्सु पार्थेषु तस्य पश्य महत् फलम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2174674, "chapter_id": 4706, "verse_number": "४६", "content_sanskrit": "त्वत्कृते निहतः शेते शरतल्पे महायशाः ।\nगाङ्गेयो भरतश्रेष्ठः सर्वेषां नः पितामहः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2174675, "chapter_id": 4706, "verse_number": "४७", "content_sanskrit": "हतो द्रोणश्च कर्णश्च हतः शल्यश्च वीर्यवान् ।\nवैराग्नेरादिकर्ता च शकुनिर्विनिपातितः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2174676, "chapter_id": 4706, "verse_number": "४८", "content_sanskrit": "भ्रातरस्ते हताः शूरा पुत्राश्च सहसैनिकाः ।\nराजानश्च हताः शूराः समरेष्वनिवर्तिनः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2174677, "chapter_id": 4706, "verse_number": "४९", "content_sanskrit": "एते चान्ये च बहवो निहताः क्षत्रियर्षभाः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2174678, "chapter_id": 4706, "verse_number": "५०", "content_sanskrit": "प्रातिकामी तथा पापो द्रौपद्याः क्लेशकृद्धतः ।\nअवशिष्टस्त्वमेवैकः कुलघ्नोऽधमपूरुषः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2174679, "chapter_id": 4706, "verse_number": "५१", "content_sanskrit": "त्वामप्यद्य हनिष्यामि गदया नात्र संशयः ।\nअद्य तेऽहं रणे दर्पं सर्वं नाशयिता नृप\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2174680, "chapter_id": 4706, "verse_number": "५२", "content_sanskrit": "राज्याशां विपुलां चापि पाण्डवेषु च दुष्कृतम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2174681, "chapter_id": 4706, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2174682, "chapter_id": 4706, "verse_number": "५३", "content_sanskrit": "किं कत्थनेन बहुधा युध्यस्वाद्य मया सह ।\nअद्य तेऽहं विनेष्यामि युद्धश्रद्धां वृकोदर\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2174683, "chapter_id": 4706, "verse_number": "५४", "content_sanskrit": "किं न पश्यसि मां पार्थ गदापाणिमवस्थितम् ।\nहिमवच्छिखराकारां प्रगृह्य महतीं गदाम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2174684, "chapter_id": 4706, "verse_number": "५५", "content_sanskrit": "गदिनं कोऽद्य मां पार्थ जेतुमुत्सहते रिपुः ।\nन्यायतो युध्यमानश्च देवेष्वपि पुरन्दरः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2174685, "chapter_id": 4706, "verse_number": "५६", "content_sanskrit": "मा वृथा गर्ज कौन्तेय शारदाभ्र इवाजलः ।\nदर्शयस्व बलं युद्धे यावन्नासून् निहन्मि ते\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2174686, "chapter_id": 4706, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2174687, "chapter_id": 4706, "verse_number": "५७", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा पाञ्चालाः सहसृञ्जयाः ।\nसर्वे सम्पूजयामासुः तद्वचो विजिगीषवः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2174688, "chapter_id": 4706, "verse_number": "५८", "content_sanskrit": "तं मत्तमिव मातङ्गं तळशब्देन पार्थिवाः ।\nभूयः संहर्षयामासुः राजन् दुर्योधनं द्विषः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2174689, "chapter_id": 4706, "verse_number": "५९", "content_sanskrit": "बृहन्ति कुञ्जरा राजन् हया हे(ह्रे)षन्ति चासकृत् ।\nशस्त्राणि सम्प्रदीप्यन्ते पाण्डवानां यशस्विनाम्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2174690, "chapter_id": 4706, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि चतुर्थोऽध्यायः ॥४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]