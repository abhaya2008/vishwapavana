[{"id": 7000314000, "chapter_id": 20314, "verse_number": "१-६८-१", "content_sanskrit": "व्यास उवाच ।\nबलं च निहतं दृष्ट्वा नमुचिं च स्वकाग्रजम् ।\nमुचिस्तत्राब्रवीद्वाक्यं ज्येष्ठो मे सूदितस्त्वया॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000314001, "chapter_id": 20314, "verse_number": "१-६८-२", "content_sanskrit": "परोक्षेणाधुना त्वां च शरैर्नेष्यामि भास्करिम् ।\nतमब्रवीन्महातेजाः शक्रः सर्वसुरार्चितः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000314002, "chapter_id": 20314, "verse_number": "१-६८-३", "content_sanskrit": "भ्रातुस्ते धर्मपंथानमिदानीं लप्स्यसे ध्रुवम् ।\nवह्नेरुष्णमविज्ञाय प्रमोहाच्छलभा यथा॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000314003, "chapter_id": 20314, "verse_number": "१-६८-४", "content_sanskrit": "सहसा प्रविशंत्यग्निं तथा मां योद्धुमिच्छसि ।\nएवं ब्रुवाणमिन्द्रं च जघान विशिखैस्त्रिभिः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000314004, "chapter_id": 20314, "verse_number": "१-६८-५", "content_sanskrit": "स चिच्छेद त्रिभिर्बाणैः शक्रः परपुरंजयः ।\nततो जघान दशभिरिंद्रमैरावणं त्रिभिः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000314005, "chapter_id": 20314, "verse_number": "१-६८-६", "content_sanskrit": "सप्तभिर्मातलिं छित्वा नादैरुच्चैर्ननाद ह ।\nशक्रं प्रति पुनर्दैत्यो भ्रामयामास संभ्रमात्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000314006, "chapter_id": 20314, "verse_number": "१-६८-७", "content_sanskrit": "आयसीं तां गदां कोपान्महाबलपराक्रमः ।\nततस्तु लाघवाच्छक्रो जघान कुलिशेन हि॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000314007, "chapter_id": 20314, "verse_number": "१-६८-८", "content_sanskrit": "भिदुरस्यावपातेन गतासुर्निपपात ह ।\nदनुजस्य प्रपातेन संचचाल वसुंधरा॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000314008, "chapter_id": 20314, "verse_number": "१-६८-९", "content_sanskrit": "देवाः प्रचक्रुर्नृत्यानि दानवा विप्रदुद्रुवुः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]