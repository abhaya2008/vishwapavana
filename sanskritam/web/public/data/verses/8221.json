[{"id": 900001157, "chapter_id": 8221, "verse_number": "3.1", "content_sanskrit": "नान्तः प्रज्ञं न बहिः प्रज्ञं नोभयतः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900001158, "chapter_id": 8221, "verse_number": "3.2", "content_sanskrit": "अत्रैते श्लोकाः भवन्ति..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900001159, "chapter_id": 8221, "verse_number": "3.3", "content_sanskrit": "कार्यकारणबद्धौ ताविष्येते विश्वतैजसौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900001160, "chapter_id": 8221, "verse_number": "3.4", "content_sanskrit": "नाऽत्मानं न परांश्चैव न सत्यं नापि चानृतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900001161, "chapter_id": 8221, "verse_number": "3.5", "content_sanskrit": "द्वैतस्याग्रहणं तुल्यमुभयोः प्राज्ञतुर्ययोः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900001162, "chapter_id": 8221, "verse_number": "3.6", "content_sanskrit": "स्वप्ननिद्रायुतावाद्यौ प्राज्ञस्त्वस्वप्ननिद्रया", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900001163, "chapter_id": 8221, "verse_number": "3.7", "content_sanskrit": "अनादिमायया सुप्तो यदा जीवः प्रबुद्ध्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900001164, "chapter_id": 8221, "verse_number": "3.8", "content_sanskrit": "प्रपञ्चो यदि विद्येत निवर्त्तेत न संशयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900001165, "chapter_id": 8221, "verse_number": "3.9", "content_sanskrit": "विकल्पो विनिवर्तेत कल्पितो यदि केनचित्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]