[{"id": 2069911, "chapter_id": 2462, "verse_number": "१०-१४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2069912, "chapter_id": 2462, "verse_number": "१०-१४-१", "content_sanskrit": "इङ्गितेनैव दाशार्हस्तस्याभिप्रायमादितः।\nद्रौणेर्बुद्धा महाबाहुरर्जुनं प्रत्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2069913, "chapter_id": 2462, "verse_number": "१०-१४-२", "content_sanskrit": "अर्जुनार्जुन यद्दिव्यमस्त्रं ते हृदि वर्तते।\nद्रोणोपदिष्टं तस्यायं कालः सम्प्रति पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2069914, "chapter_id": 2462, "verse_number": "१०-१४-३", "content_sanskrit": "भ्रातॄणामात्मनश्चैव परित्राणाय भारत।\nविसृजैतत्त्वमप्याजावस्त्रमस्त्रनिवारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2069915, "chapter_id": 2462, "verse_number": "१०-१४-४", "content_sanskrit": "केशवेनैवमुक्तोऽथ पाण्डवः परवीरहा।\nअवातरद्रथात्तूर्णं प्रगृह्य सशरं धनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2069916, "chapter_id": 2462, "verse_number": "१०-१४-५", "content_sanskrit": "पूर्वमाचार्यपुत्राय ततोऽनन्तरमात्मने।\nभ्रातृभ्यश्चैव सर्वेभ्यः स्वस्तीत्युक्त्वा परन्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2069917, "chapter_id": 2462, "verse_number": "१०-१४-६", "content_sanskrit": "देवताभ्यो नमस्कृत्य गुरुभ्यश्चैव सर्वशः।\nउत्ससर्ज शिवं ध्यायन्नस्त्रमस्त्रेण शाम्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2069918, "chapter_id": 2462, "verse_number": "१०-१४-७", "content_sanskrit": "ततस्तदस्रं सहसा सृष्टं गाण्डीवधन्वना।\nप्रजज्वाल महार्चिष्मद्युगान्तानलसन्निभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2069919, "chapter_id": 2462, "verse_number": "१०-१४-८", "content_sanskrit": "तथैव द्रोणपुत्रस्य तदस्त्रं तिग्मतेजसः।\nप्रजज्वाल महाज्वालं तेजोमण्डलसंवृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2069920, "chapter_id": 2462, "verse_number": "१०-१४-९", "content_sanskrit": "निर्घाता बहवश्चासन्पेतुरुल्काः सहस्रशः।\nमहद्भयं च भूतानां सर्वेषां समजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2069921, "chapter_id": 2462, "verse_number": "१०-१४-१०", "content_sanskrit": "सशब्दमभवद्व्योम ज्वालामालाकुलं भृशम्।\nचचाल च मही कृत्स्ना सपर्वतवनद्रुमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2069922, "chapter_id": 2462, "verse_number": "१०-१४-११", "content_sanskrit": "तावस्त्रतेजसा लोकांस्त्रासयन्तौ ततः स्थितौ।\nमहर्षी सहितौ तत्र दर्शयामासतुस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2069923, "chapter_id": 2462, "verse_number": "१०-१४-१२", "content_sanskrit": "नारदः सर्वधर्मात्मा भरतानां पितामहः।\nउभौ शमयितुं वीरौ भारद्वाजधनञ्जयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2069924, "chapter_id": 2462, "verse_number": "१०-१४-१३", "content_sanskrit": "तौ मुनी सर्वधर्मज्ञौ सर्वभूतहितैपिणौ।\nदीप्तयोरस्रयोर्मध्ये स्थितौ परमतेजसौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2069925, "chapter_id": 2462, "verse_number": "१०-१४-१४", "content_sanskrit": "तदन्तरमनाधृष्यावुपगम्य यशस्विनौ।\nआस्तामृषिवरौ तत्र ज्वलिताविव पावकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2069926, "chapter_id": 2462, "verse_number": "१०-१४-१५", "content_sanskrit": "प्राणभृद्भिरनाधृष्यौ देवदानवसम्मतौ।\nअस्त्रतेजः शमयितुं लोकानां हितकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2069927, "chapter_id": 2462, "verse_number": "१०-१४-१६x", "content_sanskrit": "ऋषी ऊचतुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2069928, "chapter_id": 2462, "verse_number": "१०-१४-१६", "content_sanskrit": "महास्त्रविदुषः पूर्वे येऽप्यतीता महारथाः।\nनैतदस्रं मनुष्येषु तैः प्रयुक्तं कथञ्चन।\nकिमिदं साहसं वीरौ कृतवन्तौ महात्ययम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2069929, "chapter_id": 2462, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सौप्तिकपर्वणि ऐषीकपर्वमि चतुर्दशोऽध्यायः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]