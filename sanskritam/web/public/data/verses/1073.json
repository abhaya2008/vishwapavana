[{"id": 2003747, "chapter_id": 1073, "verse_number": "१-७४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2003748, "chapter_id": 1073, "verse_number": "१-७४-१", "content_sanskrit": "ततः काव्यो भृगुश्रेष्ठः समन्युरुपगम्य ह।\nवृषपर्वाणमासीनमित्युवाचाविचारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2003749, "chapter_id": 1073, "verse_number": "१-७४-२", "content_sanskrit": "नाधर्मश्चरितो राजन्सद्यः फलति गौरिव।\nशनैरावर्त्यमानो हि कर्तुर्मूलानि कृन्तति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2003750, "chapter_id": 1073, "verse_number": "१-७४-३", "content_sanskrit": "पुत्रेषु वा नप्तृषु वा न चेदात्मनि पश्यति।\nफलत्येव ध्रुवं पायं गुरुभुक्तमिवोदरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2003751, "chapter_id": 1073, "verse_number": "१-७४-४", "content_sanskrit": "अधीयानं हितं राजन्क्षमावन्तं जितेन्द्रियम्।\nयदघातयथा विप्रं कचमाङ्गिरसं तदा।\nअपापशीलं धर्मज्ञं शुश्रूषुं मद्गृहे रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2003752, "chapter_id": 1073, "verse_number": "१-७४-५", "content_sanskrit": "शर्मिष्ठया देवयानी क्रूरमुक्ता बहु प्रभो।\nविप्रकृत्य च संरम्भात्कूपे क्षिप्ता मनस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2003753, "chapter_id": 1073, "verse_number": "१-७४-६", "content_sanskrit": "सा न कल्पेत वासाय तयाहं रहितः कथम्।\nवसेयमिह तस्मात्ते त्यजामि विषयं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2003754, "chapter_id": 1073, "verse_number": "१-७४-७", "content_sanskrit": "वधादनर्हतस्तस्य वधाच्च दुहितुर्मम।\nवषपर्वन्निबोधेयं त्यक्ष्यामि त्वां सबान्धवम्।\nस्थातुं त्वद्विषये राजन्न शक्ष्यामि त्वया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2003755, "chapter_id": 1073, "verse_number": "१-७४-८", "content_sanskrit": "मा शोच वृषपर्वंस्त्वं मा क्रुध्यस्व विशांपते।\nस्थातुं ते विषये राजन्न शक्ष्यामि तया विना।\nअस्या गतिर्गतिर्मह्यं प्रियमस्याः प्रियं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2003756, "chapter_id": 1073, "verse_number": "१-७४-९x", "content_sanskrit": "वृषपर्वोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2003757, "chapter_id": 1073, "verse_number": "१-७४-९", "content_sanskrit": "यदि ब्रह्मन्घातयामि यदि वा क्रोशयाम्यहम्।\nशर्मिष्ठया देवयानीं तेन गच्छाम्यसद्गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2003758, "chapter_id": 1073, "verse_number": "१-७४-१०x", "content_sanskrit": "शुक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2003759, "chapter_id": 1073, "verse_number": "१-७४-१०", "content_sanskrit": "अहो मामभिजानासि दैत्य मिथ्याप्रलापिनम्।\nयथेममात्मनो दोषं न नियच्छस्पुपेक्षसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2003760, "chapter_id": 1073, "verse_number": "१-७४-११x", "content_sanskrit": "वृषपर्वोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2003761, "chapter_id": 1073, "verse_number": "१-७४-११", "content_sanskrit": "नाधर्मं न मृषावादं त्वयि जानामि भार्गव।\nत्वयि धर्मश्च सत्यं च तत्प्रसीदतु नो भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2003762, "chapter_id": 1073, "verse_number": "१-७४-१२", "content_sanskrit": "यद्यस्मानपहाय त्वमितो गच्छसि भार्गव।\nसमुद्रं संप्रवेक्ष्यामि पूर्वं मद्बान्धवैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2003763, "chapter_id": 1073, "verse_number": "१-७४-१३", "content_sanskrit": "पातालमथवा चाग्निं नान्यदस्ति परायणम्।\nयद्येव देवान्गच्छेस्त्वं मां च त्यक्त्वा ग्रहाधिप।\nसर्वत्यागं ततः कृत्वा प्रविशामि हुताशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2003764, "chapter_id": 1073, "verse_number": "१-७४-१४x", "content_sanskrit": "शुक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2003765, "chapter_id": 1073, "verse_number": "१-७४-१४", "content_sanskrit": "समुद्रं प्रविशध्वं वा दिशो वा द्रवतासुराः।\nदुहितुर्नाप्रियं सोहुं शक्तोऽहं दयिता हि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2003766, "chapter_id": 1073, "verse_number": "१-७४-१५", "content_sanskrit": "प्रसाद्यतां देवयानी जीवितं यत्र मे स्थितम्।\nयोगक्षेमकरस्तेऽहमिन्द्रस्येव बृहस्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2003767, "chapter_id": 1073, "verse_number": "१-७४-१६x", "content_sanskrit": "वृषपर्वोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2003768, "chapter_id": 1073, "verse_number": "१-७४-१६", "content_sanskrit": "यत्किंचिदसुरेन्द्राणां विद्यते वसु भार्गव।\nभुवि हस्तिगवाश्वं च तस्य त्वं मम चेश्चरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2003769, "chapter_id": 1073, "verse_number": "१-७४-१७x", "content_sanskrit": "शुक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2003770, "chapter_id": 1073, "verse_number": "१-७४-१७", "content_sanskrit": "यत्किंचिदस्ति द्रविणं दैत्येन्द्राणां महासुर।\nतस्येश्वरोस्मि यद्येषा देवयानी प्रसाद्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2003771, "chapter_id": 1073, "verse_number": "१-७४-१८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2003772, "chapter_id": 1073, "verse_number": "१-७४-१८", "content_sanskrit": "एवमुक्तस्तथेत्याह वृषपर्वा महाकविम्।\nदेवयान्यन्तिकं गत्वा तमर्थं प्राह भार्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2003773, "chapter_id": 1073, "verse_number": "१-७४-१९x", "content_sanskrit": "देवयान्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2003774, "chapter_id": 1073, "verse_number": "१-७४-१९", "content_sanskrit": "यदि त्वमीश्वरस्तात राज्ञो वित्तस्य भार्गव।\nनाभिजानामि तत्तेऽहं राजा तु वदतु स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2003775, "chapter_id": 1073, "verse_number": "१-७४-२०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2003776, "chapter_id": 1073, "verse_number": "१-७४-२०", "content_sanskrit": "शुक्रस्य वचनं श्रुत्वा वृषपर्वा सबान्धवः।\nदेवयानि प्रसीदेति पपात भुवि पादयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2003777, "chapter_id": 1073, "verse_number": "१-७४-२१x", "content_sanskrit": "वृषपर्वोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2003778, "chapter_id": 1073, "verse_number": "१-७४-२१", "content_sanskrit": "स्तुत्यो वन्द्यश्च सततं मया तातश्च ते शुभे।\nयं काममभिकामाऽसि देवयानि शुचिस्मिते।\nतत्तेऽहं संप्रदास्यामि यदि वापि हि दुर्लभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2003779, "chapter_id": 1073, "verse_number": "१-७४-२२x", "content_sanskrit": "देवयान्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2003780, "chapter_id": 1073, "verse_number": "१-७४-२२", "content_sanskrit": "दासीं कन्यासहस्रेण शर्मिष्ठामभिकामये।\nअनु मां तत्र गच्छेत्सा यत्र दद्याच्च मे पिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2003781, "chapter_id": 1073, "verse_number": "१-७४-२३x", "content_sanskrit": "वृषपर्वोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2003782, "chapter_id": 1073, "verse_number": "१-७४-२३", "content_sanskrit": "उत्तिष्ठ त्वं गच्छ धात्रि शर्मिष्ठां शीघ्रमानय।\nयं च कामयते कामं देवयानी करोतु तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2003783, "chapter_id": 1073, "verse_number": "१-७४-२४", "content_sanskrit": "त्यजेदेकं कुलस्यार्थे ग्रामार्थे च कुलं त्यजेत्।\nग्रामं जनपदस्यार्थे आत्मार्थे पृथिवीं त्यजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2003784, "chapter_id": 1073, "verse_number": "१-७४-२५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2003785, "chapter_id": 1073, "verse_number": "१-७४-२५", "content_sanskrit": "ततो धात्री तत्र गत्वा शर्मिष्ठां वाक्यमब्रवीत्।\nउत्तिष्ठ भद्रे शर्मिष्ठे ज्ञातीनां सुखमावह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2003786, "chapter_id": 1073, "verse_number": "१-७४-२६", "content_sanskrit": "त्यजति ब्राह्मणः शिष्यान्देवयान्या प्रचोदितः।\nसायं कामयते कां स कार्योऽद्य त्वयाऽनघे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2003787, "chapter_id": 1073, "verse_number": "१-७४-२७x", "content_sanskrit": "शर्मिष्ठोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2003788, "chapter_id": 1073, "verse_number": "१-७४-२७", "content_sanskrit": "यं सा कामयते कां करवाण्यहमद्य तम्।\nयद्येवमाह्वयेच्छुक्रो देवयानीकृते हि माम्।\nमद्दोषान्मागमच्छुक्रो देवयानी च मत्कृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2003789, "chapter_id": 1073, "verse_number": "१-७४-२८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2003790, "chapter_id": 1073, "verse_number": "१-७४-२८", "content_sanskrit": "ततः कन्यासहस्रेण वृता शिबिकया तदा।\nपितुर्नियोगात्त्वरिता निश्चक्राम पुरोत्तमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2003791, "chapter_id": 1073, "verse_number": "१-७४-२९x", "content_sanskrit": "शर्मिष्ठोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2003792, "chapter_id": 1073, "verse_number": "१-७४-२९", "content_sanskrit": "अहं दासीसहस्रेण दासी ते परिचारिका।\nअनु त्वां तत्र यास्यामि यत्र दास्यति ते पिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2003793, "chapter_id": 1073, "verse_number": "१-७४-३०x", "content_sanskrit": "देवयान्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2003794, "chapter_id": 1073, "verse_number": "१-७४-३०", "content_sanskrit": "स्तुवतो दुहिताऽहं ते याचतः प्रतिगृह्णतः।\nस्तूयमानस्य दुहिता कथं दासी भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2003795, "chapter_id": 1073, "verse_number": "१-७४-३१x", "content_sanskrit": "शर्मिष्ठोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2003796, "chapter_id": 1073, "verse_number": "१-७४-३१", "content_sanskrit": "येनकेनचिदार्तानां ज्ञातीनां सुखमावहेत्।\nअतस्त्वामनुयास्यामि तत्र दास्यति ते पिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2003797, "chapter_id": 1073, "verse_number": "१-७४-३२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2003798, "chapter_id": 1073, "verse_number": "१-७४-३२", "content_sanskrit": "प्रतिश्रुते दासभावे दुहित्रा वृषपर्वणः।\nदेवयानी नृपश्रेष्ठ पितरं वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2003799, "chapter_id": 1073, "verse_number": "१-७४-३३x", "content_sanskrit": "देवयान्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2003800, "chapter_id": 1073, "verse_number": "१-७४-३३", "content_sanskrit": "प्रविशामि पुरं तात तुष्टाऽस्मि द्विजसत्तम।\nअमोघं तव विज्ञानमस्ति विद्याबलं च ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2003801, "chapter_id": 1073, "verse_number": "१-७४-३४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2003802, "chapter_id": 1073, "verse_number": "१-७४-३४", "content_sanskrit": "एवमुक्तो दुहित्रा स द्विजश्रेष्ठो महायशाः।\nप्रविवेश पुरं हृष्टः पूजितः सर्वदानैवः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2003803, "chapter_id": 1073, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि चतुःसप्ततितमोऽध्यायः॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]