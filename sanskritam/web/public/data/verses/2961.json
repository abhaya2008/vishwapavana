[{"id": 2092183, "chapter_id": 2961, "verse_number": "१३-९१-१", "content_sanskrit": "च्यवन उवाच।\nअवश्यं कथनीयं मे तवैतन्नरपुङ्गव।\nयदर्थं त्वाहमुच्छेत्तुं सम्प्राप्तो मनुजाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2092184, "chapter_id": 2961, "verse_number": "१३-९१-२", "content_sanskrit": "भूगूणां क्षत्रिया याज्या नित्यमेतज्जनाधिप।\nते च भेदं गमिष्यन्ति दैवयुक्तेन हेतुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2092185, "chapter_id": 2961, "verse_number": "१३-९१-३", "content_sanskrit": "क्षत्रियाश्च भृगून्सर्वान्वधिष्यन्ति नराधिप।\nआगर्भादनुकृन्तन्तो दैतदण्डनिपीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2092186, "chapter_id": 2961, "verse_number": "१३-९१-४", "content_sanskrit": "तत उत्पत्स्यतेऽस्माकं कुले गोत्रविवर्धनः।\nऔर्वो नाम महातेजा ज्वलितार्कसमद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2092187, "chapter_id": 2961, "verse_number": "१३-९१-५", "content_sanskrit": "स त्रैलोक्यविनाशाय कोपाग्निं जनयिष्यति।\nमहीं सपर्वतवनां यः करिष्यति भस्मसात्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2092188, "chapter_id": 2961, "verse_number": "१३-९१-६", "content_sanskrit": "कञ्चित्कालं तु वह्निं च स एव शमयिष्यति।\nसमुद्रे वडवावक्त्रे प्रक्षिप्य मुनिसत्तमः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2092189, "chapter_id": 2961, "verse_number": "१३-९१-७", "content_sanskrit": "पुत्रं तस्य महाराज ऋचीकं भृगुनन्दनम्।\nसाक्षात्कृत्स्नो धनुर्वेदः समुपस्थास्यतेऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2092190, "chapter_id": 2961, "verse_number": "१३-९१-८", "content_sanskrit": "क्षत्रियाणामभावाय दैवयुक्तेनु हेतुना।\nस तु तं प्रतिगृह्यैव पुत्रे संक्रामयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2092191, "chapter_id": 2961, "verse_number": "१३-९१-९", "content_sanskrit": "जमदग्नौ महाभागे तपसा भावितात्मनि।\nस चापि भृगुशार्दूलस्तं वेदं धारयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2092192, "chapter_id": 2961, "verse_number": "१३-९१-१०", "content_sanskrit": "कुलात्तु तव धर्मात्मन्कन्यां सोऽधिगमिष्यति।\nउद्भावनार्थं भवतो वंशस्य भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2092193, "chapter_id": 2961, "verse_number": "१३-९१-११", "content_sanskrit": "`क्षत्रहन्ता भवेद्धिंस्र इति दैवं सनातनम्।\nनारायणमुपास्यास्य वरात्तं पुत्रमृच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2092194, "chapter_id": 2961, "verse_number": "१३-९१-१२", "content_sanskrit": "गाधेर्दुहितरं प्राप्यि पौत्रीं तव महातपाः।\nब्राह्मणं क्षत्रधर्माणं पुत्रमुत्पादयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2092195, "chapter_id": 2961, "verse_number": "१३-९१-१३", "content_sanskrit": "क्षत्रियं विप्रधर्माणं बृहस्पतिमिवौजसा।\nविश्वामित्रं तव कुले गाधेः पुत्रं सुधार्मिकम्।\nतपसा महता युक्तं प्रदास्यति महाद्युते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2092196, "chapter_id": 2961, "verse_number": "१३-९१-१४", "content_sanskrit": "स्त्रियौ तु कारणं तत्र परिवर्ते भविष्यतः।\nपितामहनियोगाद्वै नान्यथैतद्भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2092197, "chapter_id": 2961, "verse_number": "१३-९१-१५", "content_sanskrit": "तृतीये पुरुषे तुभ्यं ब्राह्मणत्वमुपैष्यति।\nभविता त्वं च सम्बन्धी भृगूणां भावितात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2092198, "chapter_id": 2961, "verse_number": "१३-९१-१६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2092199, "chapter_id": 2961, "verse_number": "१३-९१-१६", "content_sanskrit": "कुशिकस्तु मुनेर्वाक्यं च्यवनस्य महात्मनः।\nश्रुत्वा हृष्टोऽभवद्राजा वाक्यं चेदमुवाच ह।\nएवमस्त्विति धर्मात्मा तदा भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2092200, "chapter_id": 2961, "verse_number": "१३-९१-१७", "content_sanskrit": "च्यवनस्तु महातेजाः पुनरेव नराधिपम्।\nवरार्थं चोदयामास तमुवाच स पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2092201, "chapter_id": 2961, "verse_number": "१३-९१-१८", "content_sanskrit": "बाढमेवं ग्रहीष्यामि कामांस्त्वत्तो महामुने।\nब्रह्मभूतं कुलं मेऽस्तु धर्मे चास्य मनो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2092202, "chapter_id": 2961, "verse_number": "१३-९१-१९", "content_sanskrit": "एवमुक्तस्तथेत्येवं प्रत्युक्त्वा च्यवनो मुनिः।\nअभ्यनुज्ञाय नृपतिं तीर्थयात्रां ययौ तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2092203, "chapter_id": 2961, "verse_number": "१३-९१-२०", "content_sanskrit": "एतत्ते कथितं सर्वमशेषेण मया नृप।\nभृगूणां कुशिकानां च अभिसम्बन्धकारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2092204, "chapter_id": 2961, "verse_number": "१३-९१-२१", "content_sanskrit": "यथोक्तमृषिणा चापि तदा तदभवन्नृप।\nजन्म रामस्य च मुनेर्विश्वामित्रस्य चैव हि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2092205, "chapter_id": 2961, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकनवतितमोऽध्यायः॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]