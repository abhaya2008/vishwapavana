[{"id": 2119463, "chapter_id": 3566, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2119464, "chapter_id": 3566, "verse_number": "१", "content_sanskrit": "कथयिष्ये सभां दिव्यां याम्यां राजन् निबोध मे ।\nवैवस्वतस्य चार्थाय विश्वकर्मा चकार याम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2119465, "chapter_id": 3566, "verse_number": "२", "content_sanskrit": "तेजस्विनी सभा राजन् बभूव शतयोजना ।\nविस्तारायामसम्पन्ना भूयसी चापि पाण्डव\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2119466, "chapter_id": 3566, "verse_number": "३", "content_sanskrit": "अर्कप्रकाशा भ्राजिष्णुः सर्वतः कामचारिणी ।\nनैवातिशीता नात्युष्णा मनसश्च प्रहर्षिणी\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2119467, "chapter_id": 3566, "verse_number": "४", "content_sanskrit": "न शोको न जरा तस्यां क्षुत्पिपासे नचाप्रियम् ।\nन दैन्यं नच कार्पण्यं प्रतिकूलं नचाप्युत\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2119468, "chapter_id": 3566, "verse_number": "५", "content_sanskrit": "सर्वे कामाः स्थितास्तस्यां ये दिव्या ये च मानुषाः ।\nरसवन्तः प्रभूताश्च भक्ष्यभोज्याश्च भारत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2119469, "chapter_id": 3566, "verse_number": "६", "content_sanskrit": "पुण्यगन्धाः स्रजस्तत्र नित्यपुष्पफला द्रुमाः ।\nरसवन्ति च रम्याणि शीतान्युष्णानि चैव ह\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2119470, "chapter_id": 3566, "verse_number": "७", "content_sanskrit": "वृक्षाश्च विविधास्तत्र नित्यपुष्पा मनोरमाः ।\nशीतळानि च तोयानि सुखोष्णानि च भारत\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2119471, "chapter_id": 3566, "verse_number": "८", "content_sanskrit": "यमं वैवस्वतं तात प्रहृष्टाः पर्युपासते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2119472, "chapter_id": 3566, "verse_number": "९", "content_sanskrit": "ययातिर्नहुषः पूरुर्मान्धाता सोमको नृगः ।\nत्रसदस्युश्चैत्ररथः कृतवीर्यः श्रुतश्रवाः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2119473, "chapter_id": 3566, "verse_number": "१०", "content_sanskrit": "अरिपुण्ड्रः सुविघ्नश्च कृतवेदः कृताकृतिः ।\nप्रतर्दनः शिबिर्मात्स्यः पृथुवक्षा बृहद्रथः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2119474, "chapter_id": 3566, "verse_number": "११", "content_sanskrit": "ऐलो मरुत्तः कुशिकः साङ्काश्यः साङ्कृतिर्भवः ।\nशन्तनुश्च सदश्वोर्मी कार्तवीर्यश्च पार्थिवः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2119475, "chapter_id": 3566, "verse_number": "१२", "content_sanskrit": "भरतस्तथैलः सुरथः सुनीथो नैषधो नळः ।\nदिवोदासो वसुमना अम्बरीषो भगीरथः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2119476, "chapter_id": 3566, "verse_number": "१३", "content_sanskrit": "व्यश्वः सदश्वो वाध्य्रश्वः पञ्चहस्तः पृथुश्रवाः ।\nऋषभो वृषसेनश्च कूपश्च सुमहाबलः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2119477, "chapter_id": 3566, "verse_number": "१४", "content_sanskrit": "पृषदश्वोऽथ सुमनाः पुरुकुत्सो ध्वजी रथी ।\nआर्ष्टिषेणो दिलीपश्च महात्मा चाप्युशीनरः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2119478, "chapter_id": 3566, "verse_number": "१५", "content_sanskrit": "औशीनरः पुण्डरीको ययातिर्भरतः शुचिः ।\nअङ्गोऽरिष्टश्च दैवाश्वो दुःषन्तः सञ्जयो जयः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2119479, "chapter_id": 3566, "verse_number": "१६", "content_sanskrit": "भागस्वरिः सुनीथश्च निषधोऽथ निमी रथी ।\nकरन्धमो बाहकश्च सुद्युम्नो बलवान् मधुः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2119480, "chapter_id": 3566, "verse_number": "१७", "content_sanskrit": "कपोतरोमा तृणकः सहदेवार्जुनौ तथा ।\nरामो दाशरथिश्चैव लक्ष्मणोऽथ प्रतर्दनः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2119481, "chapter_id": 3566, "verse_number": "१८", "content_sanskrit": "अळर्कः कक्षसेनश्च गयो गौराश्व एव च ।\nजामदग्न्यश्च रामश्च नाभागसगरौ तथा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2119482, "chapter_id": 3566, "verse_number": "१९", "content_sanskrit": "भूरिद्युम्नो ह्यधीरश्च पृथाश्वो जनकस्तथा ।\nवैन्यो राजा पारिषेणः पुरुजो जनमेजयः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2119483, "chapter_id": 3566, "verse_number": "२०", "content_sanskrit": "ब्रह्मदत्तस्त्रिगर्तश्च राजोपरिचरस्तथा ।\nमहाभुजो महाजानुर्मायासृष्टो हयोऽनघः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2119484, "chapter_id": 3566, "verse_number": "२१", "content_sanskrit": "पाद्मश्च मुचुकुन्दश्च इन्द्रद्युम्नः प्रसेनजित् ।\nअरिष्टनेमिः प्रद्युम्नः पृथुश्च जनकस्तथा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2119485, "chapter_id": 3566, "verse_number": "२२", "content_sanskrit": "शतं मत्स्या नृपतयः शतं नीपाः शतं गयाः ।\nधृतराष्ट्राश्चैव शतमशीतिर्जनमेजयाः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2119486, "chapter_id": 3566, "verse_number": "२३", "content_sanskrit": "शतं च ब्रह्मदत्तानां वैरिणो वैरिणस्तथा ।\nशन्तनुश्चैव राजर्षिः पाण्डुश्चैव पिता तव\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2119487, "chapter_id": 3566, "verse_number": "२४", "content_sanskrit": "ऋषड्भवः शतरथो देवराजो जयद्रथः ।\nवृषादर्विश्च राजर्षिर्धाम्ना सह समृद्धिना\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2119488, "chapter_id": 3566, "verse_number": "२५", "content_sanskrit": "अथापरे सहस्राणि ये गताः शशबिन्दवः ।\nइष्ट्वाऽश्वमेधैर्बहुभिर्महद्भिर्भूरिदक्षिणैः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2119489, "chapter_id": 3566, "verse_number": "२६", "content_sanskrit": "एते राजर्षयः पुण्याः कीर्तिमन्तो बहुश्रुताः ।\nतस्यां सभायां राजर्षे वैवस्वतमुपासते\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2119490, "chapter_id": 3566, "verse_number": "२७", "content_sanskrit": "अगस्त्योऽथ मतङ्गश्च कालो मृत्युस्तथैव च ।\nयज्वानश्चैव सिद्धाश्च ये च योगशरीरिणः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2119491, "chapter_id": 3566, "verse_number": "२८", "content_sanskrit": "अग्निष्वात्ताश्च पितरः फेनपाश्चोष्मपाश्च ये ।\nस्वधावन्तो बर्हिषदो मूर्तामूर्ताश्च ये स्मृताः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2119492, "chapter_id": 3566, "verse_number": "२९", "content_sanskrit": "कालचक्रं च साक्षाच्च भगवान् हव्यवाहनः ।\nनरा दुष्कृतकर्माणो दक्षिणायनमृत्यवः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2119493, "chapter_id": 3566, "verse_number": "३०", "content_sanskrit": "कालस्य नयने युक्ता यमस्य पुरुषाश्च ये\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2119494, "chapter_id": 3566, "verse_number": "३१", "content_sanskrit": "तस्यां शिंशुपपालाशाः तथा काशकुशादयः ।\nउपासते यमं राजन् मूर्तिमन्तो निरामयाः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2119495, "chapter_id": 3566, "verse_number": "३२", "content_sanskrit": "एते चान्ये च बहवः पितृराजसभासदः ।\nअशक्याः परिसङ्ख्यातुं नामभिः कर्मभिस्तथा\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2119496, "chapter_id": 3566, "verse_number": "३३", "content_sanskrit": "असम्बाधा हि सा पार्थ रम्या कामगमा सभा ।\nदीर्घकालं तपस्तप्त्वा निर्मिता विश्वकर्मणा\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2119497, "chapter_id": 3566, "verse_number": "३४", "content_sanskrit": "प्रभासन्ती ज्वलन्ती च तेजसा स्वेन भारत ।\nतामुग्रतपसो यान्ति सुव्रताः सत्यवादिनः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2119498, "chapter_id": 3566, "verse_number": "३५", "content_sanskrit": "शान्ताः सन्न्यासिनः शुद्धाः पूताः पुण्येन कर्मणा ।\nसर्वे भास्वरदेहाश्च सर्वे च विरजोम्बराः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2119499, "chapter_id": 3566, "verse_number": "३६", "content_sanskrit": "चित्राङ्गदाश्चित्रमाल्याः सर्वे ज्वलितकुण्डलाः ।\nस्वकृतैः कर्मभिः पुण्यैः पारिबर्हैश्च भूषिताः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2119500, "chapter_id": 3566, "verse_number": "३७", "content_sanskrit": "गन्धर्वाश्च महात्मानः शतशोऽप्सरसां गणाः ।\nवादित्रं नृत्तगीतं च हास्यं लास्यं च सर्वशः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2119501, "chapter_id": 3566, "verse_number": "३८", "content_sanskrit": "पुण्याश्च गन्धाः शब्दाश्च तस्यां पार्थ समन्ततः ।\nदिव्यानि चैव माल्यानि उपतिष्ठन्ति नित्यशः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2119502, "chapter_id": 3566, "verse_number": "३९", "content_sanskrit": "शतशोऽथ सहस्राणि धर्मिष्ठं तं प्रजेश्वरम् ।\nउपासते महात्मानो रूपयुक्ता स्वलङ्कृताः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2119503, "chapter_id": 3566, "verse_number": "४०", "content_sanskrit": "ईदृशी सा सभा राजन् पितृराज्ञो महात्मनः ।\nवरुणस्यापि वक्ष्यामि सभां पुष्करमालिनीम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2119504, "chapter_id": 3566, "verse_number": "८", "content_sanskrit": "॥ इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि अष्टमोऽध्यायः ॥८॥ ॥ मन्त्रपर्वणि अष्टमोऽध्यायः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2119505, "chapter_id": 3566, "verse_number": "", "content_sanskrit": "—— ०  ——", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]