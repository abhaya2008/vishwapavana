[{"id": 2132991, "chapter_id": 3869, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2132992, "chapter_id": 3869, "verse_number": "१", "content_sanskrit": "स एवमुक्तो राजर्षिरुदङ्केनापराजितः ।\nउदङ्कं कौरवश्रेष्ठ कृताञ्जलिरथाब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2132993, "chapter_id": 3869, "verse_number": "२", "content_sanskrit": "नहि मे गमनं ब्रह्मन् मोघमेतद् भविष्यति ।\nपुत्रो ममापि भगवन् कुवलाश्व इति स्मृतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2132994, "chapter_id": 3869, "verse_number": "३", "content_sanskrit": "धृतिमान् क्षिप्रकारी च वीर्येणाप्रतिमो भुवि ।\nप्रियं वै सर्वमेतत् ते करिष्यति न संशयः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2132995, "chapter_id": 3869, "verse_number": "४", "content_sanskrit": "पुत्रैः परिवृतः सर्वैः शूरैः परिघबाहुभिः ।\nहनिष्यति महाबाहुस्तं वै धुन्धुं महासुरम् ।\nविसर्जयस्व मां ब्रह्मन् न्यस्तशस्त्रोऽस्मि साम्प्रतम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2132996, "chapter_id": 3869, "verse_number": "५", "content_sanskrit": "तथाऽस्त्विति च तेनोक्तो मुनिनाऽमिततेजसा ।\nस तमादिश्य तनयमुदङ्काय महात्मने\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2132997, "chapter_id": 3869, "verse_number": "६", "content_sanskrit": "क्रियतामिति राजर्षिर्जगाम वनमुत्तमम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2132998, "chapter_id": 3869, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2132999, "chapter_id": 3869, "verse_number": "७", "content_sanskrit": "क एष भगवन् दैत्यो महावीर्यस्तपोधन ।\nकस्य पुत्रोऽथ नप्ता वा एतदिच्छामि वेदितुम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2133000, "chapter_id": 3869, "verse_number": "८", "content_sanskrit": "एवं महावीर्यबलो न श्रुतो मे तपोधन ।\nयस्य निःश्वासवातेन कम्पते भूः सपर्वता\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2133001, "chapter_id": 3869, "verse_number": "९", "content_sanskrit": "एतदिच्छामि भगवन् याथातथ्येन वेदितुम् ।\nसर्वमेव महाप्राज्ञ विस्तरेण तपोधन\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2133002, "chapter_id": 3869, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2133003, "chapter_id": 3869, "verse_number": "१०", "content_sanskrit": "शृणु राजन्निदं सर्वं यथावृत्तं नराधिप ।\nएकार्णवे निरालोके नष्टे स्थावरजङ्गमे ।\nप्रनष्टेषु च भूतेषु सर्वेषु भरतर्षभ\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2133004, "chapter_id": 3869, "verse_number": "११", "content_sanskrit": "प्रभवं लोककर्तारं विष्णुं शाश्वतमव्ययम् ।\nचतुर्भुजमुदाराङ्गं दृष्टवानस्मि भारत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2133005, "chapter_id": 3869, "verse_number": "१२", "content_sanskrit": "सुष्वाप भगवान् विष्णुरहिशय्यां स एव हि ।\nनागस्य भोगे महति शेषस्यामिततेजसः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2133006, "chapter_id": 3869, "verse_number": "१३", "content_sanskrit": "लोककर्ता महाभाग भगवानच्युतो हरिः ।\nनागभोगेन महता परिगृह्य(रभ्य) च मेदिनीम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2133007, "chapter_id": 3869, "verse_number": "१४", "content_sanskrit": "स्वपतस्तस्य देवस्य पद्मं सूर्यसमप्रभम् ।\nनाभ्या विनिःसृतं दिव्यं यत्रोत्पन्नः पितामहः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2133008, "chapter_id": 3869, "verse_number": "१५", "content_sanskrit": "साक्षाल्लोकगुरुर्ब्रह्मा पद्मे सूर्येन्दुसप्रभः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2133009, "chapter_id": 3869, "verse_number": "१६", "content_sanskrit": "चतुर्वेदश्चतुर्मूर्तिश्चतुर्वर्गश्चतुर्मुखः ।\nस्वप्रभावाद् दुराधर्षो महाबलपराक्रमः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2133010, "chapter_id": 3869, "verse_number": "१७", "content_sanskrit": "कस्यचित् त्वथ कालस्य दानवौ वीर्यसत्तमौ ।\nमधुश्च कैटभश्चैव दृष्टवन्तौ हरिं प्रभुम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2133011, "chapter_id": 3869, "verse_number": "१८", "content_sanskrit": "शयानं शयने दिव्ये नागभोगे महाद्युतिम् ।\nबहुयोजनविस्तीर्णे बहुयोजनमायते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2133012, "chapter_id": 3869, "verse_number": "१९", "content_sanskrit": "किरीटकौस्तुभधरं पीतकौशेयवाससम् ।\nदीप्यमानं श्रिया राजन् तेजसा वपुषा तदा ।\nसहस्रसूर्यप्रतिममद्भुतोपमदर्शनम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2133013, "chapter_id": 3869, "verse_number": "२०", "content_sanskrit": "विस्मयः सुमहानासीत् मधुकैटभयोस्तदा ।\nदृष्ट्वा पितामहं चैव पद्मे पद्मनिभेक्षणम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2133014, "chapter_id": 3869, "verse_number": "२१", "content_sanskrit": "वित्रासयेतामथ तौ ब्रह्माणममितौजसम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2133015, "chapter_id": 3869, "verse_number": "२२", "content_sanskrit": "वित्रास्यमानो बहुधा ब्रह्मा ताभ्यां महायशाः ।\nअकम्पयत् पद्मनालं ततोऽबुध्यत केशवः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2133016, "chapter_id": 3869, "verse_number": "२३", "content_sanskrit": "अथापश्यत गोविन्दो दानवौ वीर्यसत्तमौ ।\nदृष्ट्वा तावब्रवीद् देवः स्वागतं वां महाबलौ ।\nददामि वां वरं श्रेष्ठं प्रीतिर्हि मम जायते\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2133017, "chapter_id": 3869, "verse_number": "२४", "content_sanskrit": "तौ प्रहस्य हृषीकेशं महादर्पौ महाबलौ ।\nप्रत्यब्रूतां महाराज सहितौ मधुसूदनम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2133018, "chapter_id": 3869, "verse_number": "२५", "content_sanskrit": "आवां वरय देव त्वं वरदौ स्वः सुरोत्तम ।\nदातारौ स्वो वरं तुभ्यं तद् ब्रवीह्यविचारयन्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2133019, "chapter_id": 3869, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2133020, "chapter_id": 3869, "verse_number": "२६", "content_sanskrit": "प्रतिगृह्णे वरं वीरावीप्सितं च वरोत्तमम् ।\nयुवां हि वीर्यसम्पन्नौ न वामस्ति समः पुमान्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2133021, "chapter_id": 3869, "verse_number": "२७", "content_sanskrit": "वध्यत्वमुपगच्छेतां मम सत्यपराक्रमौ ।\nएतदिच्छाम्यहं कामं प्राप्तुं लोकहिताय वै\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2133022, "chapter_id": 3869, "verse_number": "", "content_sanskrit": "मधुकैटभौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2133023, "chapter_id": 3869, "verse_number": "२८", "content_sanskrit": "अनृतं नोक्तपूर्वं नौ स्वैरेष्वपि कुतोऽन्यथा ।\nसत्ये धर्मे च निरतौ विध्यावां पुरुषोत्तम\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2133024, "chapter_id": 3869, "verse_number": "२९", "content_sanskrit": "बले वीर्ये च रूपे च शमे न च समोऽस्ति नौ ।\nधर्मे तपसि दाने च शीलसत्त्वदमेषु च\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2133025, "chapter_id": 3869, "verse_number": "३०", "content_sanskrit": "उपप्लवो महानस्मानुपावर्तत केशव ।\nउक्तं प्रतिकुरुष्व त्वं कालो हि दुरतिक्रमः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2133026, "chapter_id": 3869, "verse_number": "३१", "content_sanskrit": "आवामिच्छावहे देव कृतमेकं त्वया विभो ।\nअनाधृ(वृ)ते त्वमाकाशे जह्यावां सुरसत्तम\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2133027, "chapter_id": 3869, "verse_number": "३२", "content_sanskrit": "पुत्रमभ्यवगच्छेताम् तव चैव सुलोचन ।\nवर एष वृतो देव तद् विद्धि सुरसत्तम\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2133028, "chapter_id": 3869, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2133029, "chapter_id": 3869, "verse_number": "३३", "content_sanskrit": "बाढमेवं करिष्यामि सर्वमेतद् भविष्यति\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2133030, "chapter_id": 3869, "verse_number": "३४", "content_sanskrit": "चिन्तयन्नथ गोविन्दो नापश्यत् तदनाधृ(वृ)तम् ।\nअवकाशं पृथिव्यां वा दिवि वा मधुसूदनः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2133031, "chapter_id": 3869, "verse_number": "३५", "content_sanskrit": "स्वकावनाधृतावूरू दृष्ट्वा देववरस्तदा ।\nमधुकैटभयोर्गृह्य शिरसि मधुसूदनः ।\nचक्रेण शितधारेण न्यकृन्तत महायशाः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2133032, "chapter_id": 3869, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि नवत्यधिकशततमोऽध्यायः ॥१९०॥\n॥ इति मार्कण्डेयसमस्यापर्वणि पञ्चदशोऽध्यायः ॥१५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]