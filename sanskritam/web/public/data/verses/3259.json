[{"id": 2104818, "chapter_id": 3259, "verse_number": "१४-११५-१", "content_sanskrit": "वैशम्पायन उवाच।\nकेशवेनैवमाख्याते धर्मपुत्रः पुनःपुनः।\nपप्रच्छ दानकालस्य विशेषं च विधिं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2104819, "chapter_id": 3259, "verse_number": "१४-११५-२x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2104820, "chapter_id": 3259, "verse_number": "१४-११५-२", "content_sanskrit": "देव किं फलमाख्यातं विषुवेष्मवरेश्वर।\nसूर्येन्दूपप्लवे चैव वस्तुमर्हति तत्फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2104821, "chapter_id": 3259, "verse_number": "१४-११५-३x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2104822, "chapter_id": 3259, "verse_number": "१४-११५-३", "content_sanskrit": "शृणुष्व राजन्विषुवे सोमार्कग्रहणेषु च।\nव्यतीपातेऽयने चैव दानं स्यादक्षयं फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2104823, "chapter_id": 3259, "verse_number": "१४-११५-४", "content_sanskrit": "राजन्नयनयोर्मध्ये विषुवं सम्प्रचक्षते।\nसमे रात्रिदिने तत्र सन्ध्यायां विषुवे नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2104824, "chapter_id": 3259, "verse_number": "१४-११५-५", "content_sanskrit": "ब्रह्माऽहं शङ्करश्चापि तिष्ठामः सहिताः सकृत्।\nक्रियाकरणकार्याणामेकीभावत्वकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2104825, "chapter_id": 3259, "verse_number": "१४-११५-६", "content_sanskrit": "अस्माकमेकीभूतानां निष्कलं परमं पदम्।\nतन्मुहूर्तं परं पुण्यं राजन्विषुवसंज्ञितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2104826, "chapter_id": 3259, "verse_number": "१४-११५-७", "content_sanskrit": "तदेवाद्यक्षरं ब्रह्म परं ब्रह्मेति कीर्तितम्।\nतस्मिन्मुहूर्ते सर्वे तु चिन्तयन्ति परं पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2104827, "chapter_id": 3259, "verse_number": "१४-११५-८", "content_sanskrit": "देवाश्च वसवो रुद्राः पितरश्चाश्विनौ तथा।\nसाध्याश्च विश्वे गन्धर्वाः सिद्धा ब्रह्मर्षयस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2104828, "chapter_id": 3259, "verse_number": "१४-११५-९", "content_sanskrit": "सोमादयो ग्रहाश्चैव सरितः सागरास्तथा।\nमरुतोत्सरसो नागा यक्षराक्षसगुह्यकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2104829, "chapter_id": 3259, "verse_number": "१४-११५-१०", "content_sanskrit": "एते चान्ये च राजेन्द्र विषुवे संयतेन्द्रियाः।\nसोपवासाः प्रयत्नेन भवन्ति ध्यानतत्पराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2104830, "chapter_id": 3259, "verse_number": "१४-११५-११", "content_sanskrit": "अन्नं गावस्तिलान्भूमिं कन्यादानं तथैव च।\nगृहमायतनं धान्यं वाहनं शयनं तथा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2104831, "chapter_id": 3259, "verse_number": "१४-११५-१२", "content_sanskrit": "यच्चान्यच्च मया प्रोक्तं तत्प्रयच्छ युधिष्ठिर।\nदीयते विषुवेष्वेवं श्रोत्रियेभ्यो विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2104832, "chapter_id": 3259, "verse_number": "१४-११५-१३", "content_sanskrit": "तस्य दानस्य कौन्तेय क्षयं नैवोपपद्यते।\nवर्धतेऽहरहः पुण्यं तद्दानं कोटिसंमितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2104833, "chapter_id": 3259, "verse_number": "१४-११५-१४", "content_sanskrit": "विषुवे स्नपनं यस्तु मम कुर्याद्धरस्य वा।\nअर्चनां च यतान्यायं तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2104834, "chapter_id": 3259, "verse_number": "१४-११५-१५", "content_sanskrit": "दशजन्मकृतं पापं तस्य सद्यो विनश्यति।\nदशानामश्वमेधानामिष्टानां लभते फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2104835, "chapter_id": 3259, "verse_number": "१४-११५-१६", "content_sanskrit": "विमानं दिव्यमारूढः कामरूपी यथासुखम्।\nस याति मामकं लोकं रुद्रलोकमथापि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2104836, "chapter_id": 3259, "verse_number": "१४-११५-१७", "content_sanskrit": "तत्रस्थैर्देवगन्धर्वेर्गीयमानो यथासुखम्।\nदिव्यवर्षसहस्राणि कोटिमेकं तु मोदते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2104837, "chapter_id": 3259, "verse_number": "१४-११५-१८", "content_sanskrit": "ततश्चापि च्युतः कालादिह लोके द्विजोत्तमः।\nचतुर्णामपि वेदानां पारगो ब्रह्मिविद्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2104838, "chapter_id": 3259, "verse_number": "१४-११५-१९", "content_sanskrit": "चन्द्रसूर्यग्रहे व्योम्नि मम वा शङ्करस्य वा।\nगायत्रीं मामिकां वाऽपि जपेद्यः शङ्करस्य वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2104839, "chapter_id": 3259, "verse_number": "१४-११५-२०", "content_sanskrit": "शङ्खर्तूर्यस्वनैश्चैव कांस्यघण्टास्वनैरपि।\nकारयेत्तु ध्वनिं भक्त्या तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2104840, "chapter_id": 3259, "verse_number": "१४-११५-२१", "content_sanskrit": "गान्धर्वैर्होमजप्यैश्च जप्तैरुत्कृष्टनामभिः।\nदुर्बलोपि भवेद्राहुः सोमश्च बलवान्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2104841, "chapter_id": 3259, "verse_number": "१४-११५-२२", "content_sanskrit": "सूर्येन्दूपप्लवे चैव श्रोत्रियेभ्यः प्रदीयते।\nतत्सहस्रगुणं भूत्वा दांतारमुपतिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2104842, "chapter_id": 3259, "verse_number": "१४-११५-२३", "content_sanskrit": "महापातकयुक्तोपि यद्यपि स्यान्नरोत्तम।\nनिष्पापस्तत्क्षणादेव तेन दानेन जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2104843, "chapter_id": 3259, "verse_number": "१४-११५-२४", "content_sanskrit": "चन्द्रसूर्यप्रकाशेन विमानेन विराजता।\nयाति सोमपुरं रम्यं सेव्यमानोप्सरोगणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2104844, "chapter_id": 3259, "verse_number": "१४-११५-२५", "content_sanskrit": "यावदृक्षाणि तिष्ठन्ति गगने शशिना सह।\nतावत्कालं स रजेन्द्र सोमलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2104845, "chapter_id": 3259, "verse_number": "१४-११५-२६", "content_sanskrit": "ततश्चापि च्युतः कालादिह लोके युधिष्ठिर।\nवेदवेदाङ्गविद्विप्रः कोटीधनपतिर्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2104846, "chapter_id": 3259, "verse_number": "१४-११५-२७x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2104847, "chapter_id": 3259, "verse_number": "१४-११५-२७", "content_sanskrit": "भगवंस्तव गायत्री जप्यते च कथं विभो।\nकिं वा तस्य फळं देव ममाचक्ष्व सुरेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2104848, "chapter_id": 3259, "verse_number": "१४-११५-२८x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2104849, "chapter_id": 3259, "verse_number": "१४-११५-२८", "content_sanskrit": "द्वादश्यां विषुवे चैव चन्द्रसूर्यग्रहे तथा।\nअयने श्रवणे चैव व्यतीपाते तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2104850, "chapter_id": 3259, "verse_number": "१४-११५-२९", "content_sanskrit": "अश्वत्तदर्शने चैव तथा मद्दर्शनेऽपि च।\nजप्या तु मम गायत्री चाथवाऽष्टाक्षरं नृप।\nआर्जितं दुष्कृतं तस्य नाशयेन्नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2104851, "chapter_id": 3259, "verse_number": "१४-११५-३०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2104852, "chapter_id": 3259, "verse_number": "१४-११५-३०", "content_sanskrit": "अश्वत्थदर्शनं चैव किं त्वद्दर्शनसंमितम्।\nएतत्कथय मे देव परं कौतूहलं हि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2104853, "chapter_id": 3259, "verse_number": "१४-११५-३१x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2104854, "chapter_id": 3259, "verse_number": "१४-११५-३१", "content_sanskrit": "अहमश्वत्थरूपेण पालयामि जगत्त्रयम्।\nअस्वत्थो न स्थितो यत्र नाहं तत्र प्रतिष्ठितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2104855, "chapter_id": 3259, "verse_number": "१४-११५-३२", "content_sanskrit": "यत्राहं संस्थितो राजन्नस्वत्थश्चापि तिष्ठति।\nयस्त्वेनमर्चयेद्भक्त्या स मां साक्षात्समर्चति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2104856, "chapter_id": 3259, "verse_number": "१४-११५-३३", "content_sanskrit": "यस्त्वेनं प्रहरेत्कोपान्मामेव प्रहरेत्तु सः।\nतस्मात्प्रदक्षिणं कुर्यान्न चिन्द्यादेनमन्वहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2104857, "chapter_id": 3259, "verse_number": "१४-११५-३४", "content_sanskrit": "व्रतस्य पारणं तीर्थमार्जवं तीर्थमुच्यते।\nदेवशुश्रूषणं तीर्तचं गुरुशुश्रूषणं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2104858, "chapter_id": 3259, "verse_number": "१४-११५-३५", "content_sanskrit": "पितृशुश्रूषणं तीर्थं मातृशुश्रूषणं तथा।\nदाराणां तोषणं तीर्तं गार्हस्थ्यं तीर्थमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2104859, "chapter_id": 3259, "verse_number": "१४-११५-३६", "content_sanskrit": "आतिथेयः परं तीर्थं ब्रह्मतीर्थं सनातनम्।\nब्रह्मिचर्यं परं तीर्तं त्रेताग्निस्तीर्थमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2104860, "chapter_id": 3259, "verse_number": "१४-११५-३७", "content_sanskrit": "मूलं धर्मं तु विज्ञाय मनस्तत्रावधार्यताम्॥\nगच्छ तीर्थानि कौन्तेय धर्मो धर्मेण वर्धते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2104861, "chapter_id": 3259, "verse_number": "१४-११५-३८", "content_sanskrit": "द्विविधं तीर्थमित्याहुः स्थावरं जङ्गमं तथा।\nस्तावराज्जङ्गमं तीर्थं ततो ज्ञानपरिग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2104862, "chapter_id": 3259, "verse_number": "१४-११५-३९", "content_sanskrit": "कर्म्णाऽपि विशुद्धस्य पुरुषस्येह भारत।\nहृदये सर्वतीर्थानि तीर्थभूतः स उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2104863, "chapter_id": 3259, "verse_number": "१४-११५-४०", "content_sanskrit": "गुरुतीर्थं परं ज्ञानमतस्तीर्तं न विद्यते।\nज्ञानतीर्तं परं तीर्तं ब्रह्मतीर्तं सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2104864, "chapter_id": 3259, "verse_number": "१४-११५-४१", "content_sanskrit": "क्षमा तु परमं तीर्तं सर्वतीर्थेषु पाण्डव।\nक्षमावतामयं लोकः परश्चैव क्षमावताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2104865, "chapter_id": 3259, "verse_number": "१४-११५-४२", "content_sanskrit": "मानितोऽमानितो वाऽपि पूजितोऽपूजितोपि वा।\nआक्रुष्टस्तर्जितो वाऽपि क्षमावांस्तीर्थमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2104866, "chapter_id": 3259, "verse_number": "१४-११५-४३", "content_sanskrit": "क्षमा यशः क्षमा दानं क्षमा यज्ञः क्षमा दमः।\nक्षमाऽहिंसा क्षमा धर्मः क्षमा चेन्द्रियनिग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2104867, "chapter_id": 3259, "verse_number": "१४-११५-४४", "content_sanskrit": "क्षमा दया क्षमा यज्ञः क्षमयैव धृतं जगत्।\nक्षमावान्ब्राह्मणो देवः क्षमावान्ब्राह्मणो वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2104868, "chapter_id": 3259, "verse_number": "१४-११५-४५", "content_sanskrit": "क्षमावानाप्नुयात्स्वर्गं क्षमावानाप्नुयाद्यशः।\nक्षमावान्प्राप्नुयान्मोक्षं तस्मात्साद्युः स उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2104869, "chapter_id": 3259, "verse_number": "१४-११५-४६", "content_sanskrit": "आत्मा नदी भारतपुण्यतीर्थ-\nमात्मा तीर्थं सर्वतीर्थप्रधानम्।\nआत्मा यज्ञः सततं मन्यते वै\nस्वर्गो मोक्षः सर्वमात्मन्यधीनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2104870, "chapter_id": 3259, "verse_number": "१४-११५-४७", "content_sanskrit": "आचारनैर्मल्यमुपागतेन\nसत्यक्षमानिस्तुलशीतलेन।\nज्ञानांबुना स्नाति हि नित्यमेवं\nकिं तस्य भूयः सलिलेन तीर्थम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2104871, "chapter_id": 3259, "verse_number": "१४-११५-४८x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2104872, "chapter_id": 3259, "verse_number": "१४-११५-४८", "content_sanskrit": "भगवन्सर्वपापघ्नं प्रायश्चित्तमदुष्करम्।\nत्वद्भक्तस्य सुरश्रेष्ठ मम त्वं वक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2104873, "chapter_id": 3259, "verse_number": "१४-११५-४९x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2104874, "chapter_id": 3259, "verse_number": "१४-११५-४९", "content_sanskrit": "रहलस्यमिदमत्यर्थमश्राव्यं पापकर्मणाम्।\nअधार्मिकाणामश्राव्यं प्रायश्चित्तं ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2104875, "chapter_id": 3259, "verse_number": "१४-११५-५०", "content_sanskrit": "पावनं ब्राह्ममं दृष्ट्वा मद्गतेनान्तरात्मना।\nनमो ब्रह्मण्यदेवायेत्यभिवादनमाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2104876, "chapter_id": 3259, "verse_number": "१४-११५-५१", "content_sanskrit": "प्रदक्षिणं च यः कुर्यात्पुनरष्टाक्षरेण तु।\nतेन तुष्टेन विप्रेणि तत्पापं क्षपयाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2104877, "chapter_id": 3259, "verse_number": "१४-११५-५२", "content_sanskrit": "पोत्रकृष्टां वराहस्य मृत्तिकां शिरसा वहन्।\nप्राणायामशतं कृत्वा नरः पापैः प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2104878, "chapter_id": 3259, "verse_number": "१४-११५-५३", "content_sanskrit": "दक्षिणावर्तशङ्खाद्वा कपिलाशृङ्गतोपि वा।\nप्राक्स्रोतसं नदीं गत्वा ममायतनसंनिधौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2104879, "chapter_id": 3259, "verse_number": "१४-११५-५४", "content_sanskrit": "सलिलेन तु यः स्नायात्सकृदेव रविग्रहे।\nतस्य यत्संचितं पापं तत्क्षणादेव नश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2104880, "chapter_id": 3259, "verse_number": "१४-११५-५५", "content_sanskrit": "मस्तकान्निस्सृतैस्तोयैः कपिलाया युधिष्ठिर।\nगोमूत्रेणापि यः स्नायाद्रोहिण्यां मम वा दिने।\nविप्रपादच्युतैर्वाऽपि तोयैः पापं प्रणश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2104881, "chapter_id": 3259, "verse_number": "१४-११५-५६", "content_sanskrit": "नमस्येद्यस्तु मद्भक्त्या शिंशुमारं प्रजापतिम्।\nचतुर्दशाङ्गसंयुक्तं तस्य पापं प्रणस्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2104882, "chapter_id": 3259, "verse_number": "१४-११५-५७", "content_sanskrit": "ततश्चतुर्दशाङ्गानि शृणु तस्य युधिष्ठिर।\nशिरो धर्मो हनुर्ब्रह्मा वृषावुत्तरदक्षिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2104883, "chapter_id": 3259, "verse_number": "१४-११५-५८", "content_sanskrit": "हृदयं तु भवेद्विष्णुरंसौ स्यातां तथाऽश्विनौ।\nअत्रिर्मध्यं भवेद्राजँल्लिङ्गं संवत्सरं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2104884, "chapter_id": 3259, "verse_number": "१४-११५-५९", "content_sanskrit": "मित्रावरुणकौ पादावूरुद्वन्द्वं हुताशनः।\nततः पश्चाद्भवेदिन्द्रस्ततः पश्चात्प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2104885, "chapter_id": 3259, "verse_number": "१४-११५-६०", "content_sanskrit": "अभयं च ततः पश्चात्स एव ध्रुवसंज्ञिकः।\nएतान्यङ्गानि सर्वाणि शिंशुमारप्रजापतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2104886, "chapter_id": 3259, "verse_number": "१४-११५-६१", "content_sanskrit": "विबेत्तु पञ्चगव्यं यः पौर्णमास्यामुपोष्य तु।\nतस्य नश्यति यत्पापं तत्पापं पूर्वसंचितम्॥\nतथैव ब्रह्मकूर्च तु समन्त्रं तु पृथक्पृथक्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2104887, "chapter_id": 3259, "verse_number": "१४-११५-६२", "content_sanskrit": "मासिमासि विबेद्यस्तु तस्य पापं प्रणश्यति॥\nपात्रं च ब्रह्मकूर्चं च शृणु तत्र च भारत।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2104888, "chapter_id": 3259, "verse_number": "१४-११५-६३", "content_sanskrit": "पालाशं पद्मपत्रं च ताम्रं वाऽथ हिरण्ययम्।\nसादयित्वा तु गृह्णीयात्तत्तु पात्रमुदाहृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2104889, "chapter_id": 3259, "verse_number": "१४-११५-६४", "content_sanskrit": "गायत्र्या गृह्णते मूत्रं गन्धद्वारेति गोमयम्।\nआप्यायस्वेति च क्षीरं दधिक्राण्वेति वै दधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2104890, "chapter_id": 3259, "verse_number": "१४-११५-६५", "content_sanskrit": "तेजोसिशुक्लमित्याज्यं देवस्यत्वेति कुशोदकम्।\nआपोहिष्ठेत्यृचा गृह्यि यवचूर्णं यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2104891, "chapter_id": 3259, "verse_number": "१४-११५-६६", "content_sanskrit": "ब्रह्मणे च यथा हुत्वा समिद्धे च हुताशने।\nआलोड्य प्रणवेनैव निर्मथ्य प्रणवेन तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2104892, "chapter_id": 3259, "verse_number": "१४-११५-६७", "content_sanskrit": "उद्धृत्य प्रणवेनैव पिबेतु प्रणवेन तु।\nमहताऽपि स पापेन त्वचेवाहिर्विमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2104893, "chapter_id": 3259, "verse_number": "१४-११५-६८", "content_sanskrit": "भद्रं न हति यः पादं पठन्नृक्सहितां तदा।\nअन्तर्जले वाऽभ्यादित्ये तस्य पापं प्रणश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2104894, "chapter_id": 3259, "verse_number": "१४-११५-६९", "content_sanskrit": "मम सूक्तं जपेद्यस्तु नित्यं मद्गतमानसः।\nन पापेन स लिप्येत पद्मपत्रमिवांभसा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2104895, "chapter_id": 3259, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकप्रर्वणि वैष्णवधर्मपर्वणि पञ्चदशाधिकशततमोऽध्यायः॥ ११५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]