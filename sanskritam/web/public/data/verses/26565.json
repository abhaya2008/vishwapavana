[{"id": 7006565000, "chapter_id": 26565, "verse_number": "३-१०४-१", "content_sanskrit": "वैशम्पायन उवाच आसीच्छाल्वेषु राजेन्द्र ब्रह्मदत्तो नृपोत्तमः ।\nनाम्ना राजन् स पूतात्मा सर्वभूतदयापरः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006565001, "chapter_id": 26565, "verse_number": "३-१०४-२", "content_sanskrit": "पञ्चयज्ञपरो नित्यं जितात्मा विजितेन्द्रियः ।\nब्रह्मविद् वेदविच्चैव सदा यज्ञमयः शिवः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006565002, "chapter_id": 26565, "verse_number": "३-१०४-३", "content_sanskrit": "तस्य भार्ये महीपाल रूपौदार्यगुणान्विते ।\nबभूवतुः सुसम्पन्ने अनपत्ये नृपोत्तम ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006565003, "chapter_id": 26565, "verse_number": "३-१०४-४", "content_sanskrit": "स ताभ्यां मुमुदे राजा शच्या शक्र इवाम्बरे ।\nनाम्ना मित्रसहो नाम सखा चासीद् द्विजोत्तमः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006565004, "chapter_id": 26565, "verse_number": "३-१०४-५", "content_sanskrit": "तस्य राज्ञो महायोगी वेदवेदान्ततत्परः ।\nअनपत्यः स विप्रेन्द्रो यथा राजा बभूव ह ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006565005, "chapter_id": 26565, "verse_number": "३-१०४-६", "content_sanskrit": "स राजा सहितस्ताभ्यामर्चयामास शंकरम् ।\nपुत्रार्थं शूलिनं शर्वं दश वर्षाण्यनन्यधीः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006565006, "chapter_id": 26565, "verse_number": "३-१०४-७", "content_sanskrit": "स विप्रो वैष्णवं सत्रं पुत्रार्थे समयोजयत् ।\nअर्चितस्तेन राजेन्द्र शंकरो नीललोहितः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006565007, "chapter_id": 26565, "verse_number": "३-१०४-८", "content_sanskrit": "आत्मानं दर्शयामास स्वप्ने राजानमब्रवीत् ।\nप्रीतोऽस्मि तव भद्रं ते वरं वरय सुव्रत ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006565008, "chapter_id": 26565, "verse_number": "३-१०४-९", "content_sanskrit": "अथ राजा जगन्नाथमुवाचेदं स्मयन्निव ।\nपुत्रौ मम भवेतां हि तथेत्युक्त्वा वृषध्वजः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006565009, "chapter_id": 26565, "verse_number": "३-१०४-१०", "content_sanskrit": "अन्तर्धानं गतः शम्भुः प्रतिबुद्धस्ततो नृपः ।\nसोऽपि मित्रसहो विद्वान् देवं केशवमव्ययम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006565010, "chapter_id": 26565, "verse_number": "३-१०४-११", "content_sanskrit": "पञ्चवर्षं जगन्नाथमर्चयामास भक्तितः ।\nअर्चितस्तेन विप्रेण देवदेवो जनार्दनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006565011, "chapter_id": 26565, "verse_number": "३-१०४-१२", "content_sanskrit": "पुत्रमेकं ददौ तस्मै स्वात्मना सदृशं हरिः ।\nते भार्ये गर्भमाधत्तां तेजसा शंकरस्य ह ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006565012, "chapter_id": 26565, "verse_number": "३-१०४-१३", "content_sanskrit": "विप्रभार्या महाराज वैष्णवं तेज आदधत् ।\nमहिष्यौ ते महावीर्यौ पुत्रौ शंकरनिर्मितौ ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006565013, "chapter_id": 26565, "verse_number": "३-१०४-१४", "content_sanskrit": "असूयेतां महीपाल क्रमेणैव नृपस्य ह ।\nस तयोश्च महाराज नामकर्मादिकाः क्रियाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006565014, "chapter_id": 26565, "verse_number": "३-१०४-१५", "content_sanskrit": "चकार विधिवत्सर्वा विप्रेभ्योऽदान्महद्धनम् ।\nस च विप्रो विनीतात्मा पुत्रमेकं हि लब्धवान् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006565015, "chapter_id": 26565, "verse_number": "३-१०४-१६", "content_sanskrit": "साक्षादिव जगन्नाथं स्थितं पुत्रात्मना नृप ।\nजातकर्मादिकं सर्वं ब्राह्मणः स चकार ह ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006565016, "chapter_id": 26565, "verse_number": "३-१०४-१७", "content_sanskrit": "तौ कुमारावयं चैव त्रयः सवयसोऽभवन् ।\nवेदानधीत्य ते सर्वाञ्छ्रुत्वा चान्वीक्षिकीं तथा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006565017, "chapter_id": 26565, "verse_number": "३-१०४-१८", "content_sanskrit": "धनुर्वेदे तथाऽस्त्रे च निपुणास्तेऽभवंस्तदा ।\nहंसो ज्येष्ठो नृपसुतो डिम्भकोऽनन्तरोऽभवत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006565018, "chapter_id": 26565, "verse_number": "३-१०४-१९", "content_sanskrit": "स च विप्रसुतो राजन् जनार्दन इति स्मृतः ।\nअन्योन्यं मित्रतां याताः सर्वे चैव कुमारकाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]