[{"id": 5000280000, "chapter_id": 9280, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे अष्टमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000280001, "chapter_id": 9280, "verse_number": "४-८-१", "content_sanskrit": "परितुष्टस्तु सुग्रीवस्तेन वाक्येन हर्षितः।\nलक्ष्मणस्याग्रजं शूरमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000280002, "chapter_id": 9280, "verse_number": "४-८-२", "content_sanskrit": "सर्वथाहमनुग्राह्यो देवतानां न संशयः।\nउपपन्नो गुणोपेतः सखा यस्य भवान् मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000280003, "chapter_id": 9280, "verse_number": "४-८-३", "content_sanskrit": "शक्यं खलु भवेद् राम सहायेन त्वयानघ।\nसुरराज्यमपि प्राप्तुं स्वराज्यं किमुत प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000280004, "chapter_id": 9280, "verse_number": "४-८-४", "content_sanskrit": "सोऽहं सभाज्यो बन्धूनां सुहृदां चैव राघव।\nयस्याग्निसाक्षिकं मित्रं लब्धं राघववंशजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000280005, "chapter_id": 9280, "verse_number": "४-८-५", "content_sanskrit": "अहमप्यनुरूपस्ते वयस्यो ज्ञास्यसे शनैः।\nन तु वक्तुं समर्थोऽहं त्वयि आत्मगतान् गुणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000280006, "chapter_id": 9280, "verse_number": "४-८-६", "content_sanskrit": "महात्मनां तु भूयिष्ठं त्वद्विधानां कृतात्मनाम्।\nनिश्चला भवति प्रीतिर्धैर्यमात्मवतां वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000280007, "chapter_id": 9280, "verse_number": "४-८-७", "content_sanskrit": "रजतं वा सुवर्णं वा शुभान्याभरणानि च।\nअविभक्तानि साधूनामवगच्छन्ति साधवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000280008, "chapter_id": 9280, "verse_number": "४-८-८", "content_sanskrit": "आढ्योवापि दरिद्रो वा दुःखितः सुखितोऽपि वा।\nनिर्दोषश्च सदोषश्च वयस्यः परमा गतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000280009, "chapter_id": 9280, "verse_number": "४-८-९", "content_sanskrit": "धनत्यागः सुखत्यागो देशत्यागोऽपि वानघ।\nवयस्यार्थे प्रवर्तन्ते स्नेहं दृष्ट्वा तथाविधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000280010, "chapter_id": 9280, "verse_number": "४-८-१०", "content_sanskrit": "तत् तथेत्यब्रवीद् रामः सुग्रीवं प्रियवादिनम्।\nलक्ष्मणस्याग्रतो लक्ष्म्या वासवस्येव धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000280011, "chapter_id": 9280, "verse_number": "४-८-११", "content_sanskrit": "ततो रामं स्थितं दृष्ट्वा लक्ष्मणं च महाबलम्।\nसुग्रीवः सर्वतश्चक्षुर्वने लोलमपातयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000280012, "chapter_id": 9280, "verse_number": "४-८-१२", "content_sanskrit": "स ददर्श ततः सालमविदूरे हरीश्वरः।\nसुपुष्पमीषत्पत्राढ्यं भ्रमरैरुपशोभितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000280013, "chapter_id": 9280, "verse_number": "४-८-१३", "content_sanskrit": "तस्यैकां पर्णबहुलां शाखां भङ्‍क्त्वा सुशोभिताम्।\nरामस्यास्तीर्य सुग्रीवो निषसाद सराघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000280014, "chapter_id": 9280, "verse_number": "४-८-१४", "content_sanskrit": "तावासीनौ ततो दृष्ट्वा हनूमानपि लक्ष्मणम्।\nशालशाखां समुत्पाट्य विनीतमुपवेशयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000280015, "chapter_id": 9280, "verse_number": "४-८-१५", "content_sanskrit": "सुखोपविष्टं रामं तु प्रसन्नमुदधिं यथा।\nसालपुष्पावसंकीर्णे तस्मिन् गिरिवरोत्तमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000280016, "chapter_id": 9280, "verse_number": "४-८-१६", "content_sanskrit": "ततः प्रहृष्टः सुग्रीवः श्लक्ष्णया शुभया गिरा।\nउवाच प्रणयाद् रामं हर्षव्याकुलिताक्षरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000280017, "chapter_id": 9280, "verse_number": "४-८-१७", "content_sanskrit": "अहं विनिकृतो भ्रात्रा चराम्येष भयार्दितः।\nऋष्यमूकं गिरिवरं हृतभार्यः सुदुःखितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000280018, "chapter_id": 9280, "verse_number": "४-८-१८", "content_sanskrit": "सोऽहं त्रस्तो भये मग्नो वने सम्भ्रान्तचेतनः।\nवालिना निकृतो भ्रात्रा कृतवैरश्च राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000280019, "chapter_id": 9280, "verse_number": "४-८-१९", "content_sanskrit": "वालिनो मे भयार्तस्य सर्वलोकाभयंकर।\nममापि त्वमनाथस्य प्रसादं कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000280020, "chapter_id": 9280, "verse_number": "४-८-२०", "content_sanskrit": "एवमुक्तस्तु तेजस्वी धर्मज्ञो धर्मवत्सलः।\nप्रत्युवाच स काकुत्स्थः सुग्रीवं प्रहसन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000280021, "chapter_id": 9280, "verse_number": "४-८-२१", "content_sanskrit": "उपकारफलं मित्रमपकारोऽरिलक्षणम्।\nअद्यैव तं वधिष्यामि तव भार्यापहारिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000280022, "chapter_id": 9280, "verse_number": "४-८-२२", "content_sanskrit": "इमे हि मे महाभाग पत्रिणस्तिग्मतेजसः।\nकार्तिकेयवनोद‍्भूताः शरा हेमविभूषिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000280023, "chapter_id": 9280, "verse_number": "४-८-२३", "content_sanskrit": "कङ्कपत्रपरिच्छन्ना महेन्द्राशनिसंनिभाः।\nसुपर्वाणः सुतीक्ष्णाग्राः सरोषा भुजगा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000280024, "chapter_id": 9280, "verse_number": "४-८-२४", "content_sanskrit": "वालिसंज्ञममित्रं ते भ्रातरं कृतकिल्बिषम्।\nशरैर्विनिहतं पश्य विकीर्णमिव पर्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000280025, "chapter_id": 9280, "verse_number": "४-८-२५", "content_sanskrit": "राघवस्य वचः श्रुत्वा सुग्रीवो वाहिनीपतिः।\nप्रहर्षमतुलं लेभे साधु साध्विति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000280026, "chapter_id": 9280, "verse_number": "४-८-२६", "content_sanskrit": "राम शोकाभिभूतोऽहं शोकार्तानां भवान् गतिः।\nवयस्य इति कृत्वा हि त्वय्यहं परिदेवये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000280027, "chapter_id": 9280, "verse_number": "४-८-२७", "content_sanskrit": "त्वं हि पाणिप्रदानेन वयस्यो मेऽग्निसाक्षिकम्।\nकृतः प्राणैर्बहुमतः सत्येन च शपाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000280028, "chapter_id": 9280, "verse_number": "४-८-२८", "content_sanskrit": "वयस्य इति कृत्वा च विस्रब्धः प्रवदाम्यहम्।\nदुःखमन्तर्गतं तन्मे मनो हरति नित्यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000280029, "chapter_id": 9280, "verse_number": "४-८-२९", "content_sanskrit": "एतावदुक्त्वा वचनं बाष्पदूषितलोचनः।\nबाष्पदूषितया वाचा नोच्चैः शक्नोति भाषितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000280030, "chapter_id": 9280, "verse_number": "४-८-३०", "content_sanskrit": "बाष्पवेगं तु सहसा नदीवेगमिवागतम्।\nधारयामास धैर्येण सुग्रीवो रामसंनिधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000280031, "chapter_id": 9280, "verse_number": "४-८-३१", "content_sanskrit": "स निगृह्य तु तं बाष्पं प्रमृज्य नयने शुभे।\nविनिःश्वस्य च तेजस्वी राघवं पुनरूचिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000280032, "chapter_id": 9280, "verse_number": "४-८-३२", "content_sanskrit": "पुराहं वालिना राम राज्यात् स्वादवरोपितः।\nपरुषाणि च संश्राव्य निर्धूतोऽस्मि बलीयसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000280033, "chapter_id": 9280, "verse_number": "४-८-३३", "content_sanskrit": "हृता भार्या च मे तेन प्राणेभ्योऽपि गरीयसी।\nसुहृदश्च मदीया ये संयता बन्धनेषु ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000280034, "chapter_id": 9280, "verse_number": "४-८-३४", "content_sanskrit": "यत्नवांश्च स दुष्टात्मा मद्विनाशाय राघव।\nबहुशस्तप्रयुक्ताश्च वानरा निहता मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000280035, "chapter_id": 9280, "verse_number": "४-८-३५", "content_sanskrit": "शङ्कया त्वेतयाहं च दृष्ट्वा त्वामपि राघव।\nनोपसर्पाम्यहं भीतो भये सर्वे हि बिभ्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000280036, "chapter_id": 9280, "verse_number": "४-८-३६", "content_sanskrit": "केवलं हि सहाया मे हनुमत्प्रमुखास्त्विमे।\nअतोऽहं धारयाम्यद्य प्राणान् कृच्छ्रगतोऽपि सन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000280037, "chapter_id": 9280, "verse_number": "४-८-३७", "content_sanskrit": "एते हि कपयः स्निग्धा मां रक्षन्ति समन्ततः।\nसह गच्छन्ति गन्तव्ये नित्यं तिष्ठन्ति चास्थिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000280038, "chapter_id": 9280, "verse_number": "४-८-३८", "content_sanskrit": "संक्षेपस्त्वेष मे राम किमुक्त्वा विस्तरं हि ते।\nस मे ज्येष्ठो रिपुर्भ्राता वाली विश्रुतपौरुषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000280039, "chapter_id": 9280, "verse_number": "४-८-३९", "content_sanskrit": "तद्विनाशेऽपि मे दुःखं प्रमृष्टं स्यादनन्तरम्।\nसुखं मे जीवितं चैव तद्विनाशनिबन्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000280040, "chapter_id": 9280, "verse_number": "४-८-४०", "content_sanskrit": "एष मे राम शोकान्तः शोकार्तेन निवेदितः।\nदुःखितः सुखितो वापि सख्युर्नित्यं सखा गतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000280041, "chapter_id": 9280, "verse_number": "४-८-४१", "content_sanskrit": "श्रुत्वैतच्च वचो रामः सुग्रीवमिदमब्रवीत्।\nकिं निमित्तमभूद् वैरं श्रोतुमिच्छामि तत्त्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000280042, "chapter_id": 9280, "verse_number": "४-८-४२", "content_sanskrit": "सुखं हि कारणं श्रुत्वा वैरस्य तव वानर।\nआनन्तर्याद् विधास्यामि सम्प्रधार्य बलाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000280043, "chapter_id": 9280, "verse_number": "४-८-४३", "content_sanskrit": "बलवान् हि ममामर्षः श्रुत्वा त्वामवमानितम्।\nवर्धते हृदयोत्कम्पी प्रावृड्वेग इवाम्भसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000280044, "chapter_id": 9280, "verse_number": "४-८-४४", "content_sanskrit": "हृष्टः कथय विस्रब्धो यावदारोप्यते धनुः।\nसृष्टश्च हि मया बाणो निरस्तश्च रिपुस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000280045, "chapter_id": 9280, "verse_number": "४-८-४५", "content_sanskrit": "एवमुक्तस्तु सुग्रीवः काकुत्स्थेन महात्मना।\nप्रहर्षमतुलं लेभे चतुर्भिः सह वानरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000280046, "chapter_id": 9280, "verse_number": "४-८-४६", "content_sanskrit": "ततः प्रहृष्टवदनः सुग्रीवो लक्ष्मणाग्रजे।\nवैरस्य कारणं तत्त्वमाख्यातुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000280047, "chapter_id": 9280, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे अष्टमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]