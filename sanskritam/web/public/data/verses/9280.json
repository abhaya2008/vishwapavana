[{"id": 40018207, "chapter_id": 9280, "verse_number": "1", "content_sanskrit": "रुधिरक्लिन्नगात्रस्तुलक्ष्मणःशुभलक्षणः । बभूवहृष्टस्तंहत्वाशक्रजेतारमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40018208, "chapter_id": 9280, "verse_number": "2", "content_sanskrit": "ततःसजाम्बवन्तंचहनूमन्तंचवीर्यवान् । संनिपत्यमहातेजास्तांश्चसर्वान्वनौकसः ॥ आजगामततःशीघ्रंयत्रसुग्रीवराघवौ । विभीषणमवष्टभ्यहनूमन्तंचलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40018209, "chapter_id": 9280, "verse_number": "3", "content_sanskrit": "ततःसजाम्बवन्तंचहनूमन्तंचवीर्यवान् । संनिपत्यमहातेजास्तांश्चसर्वान्वनौकसः ॥ आजगामततःशीघ्रंयत्रसुग्रीवराघवौ । विभीषणमवष्टभ्यहनूमन्तंचलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40018210, "chapter_id": 9280, "verse_number": "4", "content_sanskrit": "ततोराममभिक्रम्यसौमित्रिरभिवाद्य च । तस्थौभ्रातृसमीपस्थःशक्रस्येन्द्रानुजोयथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40018211, "chapter_id": 9280, "verse_number": "5", "content_sanskrit": "निष्टनन्निवचागत्यराघवायमहात्मने । आचचक्षेतदावीरोघोरमिन्द्रजितोवधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40018212, "chapter_id": 9280, "verse_number": "6", "content_sanskrit": "रावणेस्तुशिरश्छिन्नंलक्ष्मणेनमहात्मना । न्यवेदयतरामायतदाहृष्टोविभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40018213, "chapter_id": 9280, "verse_number": "7", "content_sanskrit": "श्रुत्वैवतुमहावीर्योलक्षणनेन्द्रजिद्वधम् । प्रहर्षमतुलंलेभेवाक्यंचेदमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40018214, "chapter_id": 9280, "verse_number": "8", "content_sanskrit": "साधुलक्ष्मणतुष्टोऽस्मिकर्मचासुकरंकृतम् । रावणेर्हिविनाशेनजितमुत्यपधारय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40018215, "chapter_id": 9280, "verse_number": "9", "content_sanskrit": "स तंशिरस्युपाघ्रायलक्ष्मणंकीर्तिवर्धनम् । लज्जमानंबलात्स्नेहादङ्गमारोप्यवीर्यवान् ॥ उपवेश्यतमुत्सङ्गेपरिष्वज्यावपीडितम् । भ्रातरंलक्ष्मणंस्निग्धंपुनःपुनरुदैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40018216, "chapter_id": 9280, "verse_number": "10", "content_sanskrit": "स तंशिरस्युपाघ्रायलक्ष्मणंकीर्तिवर्धनम् । लज्जमानंबलात्स्नेहादङ्गमारोप्यवीर्यवान् ॥ उपवेश्यतमुत्सङ्गेपरिष्वज्यावपीडितम् । भ्रातरंलक्ष्मणंस्निग्धंपुनःपुनरुदैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40018217, "chapter_id": 9280, "verse_number": "11", "content_sanskrit": "शल्यसंपीडितंशस्तंनिःश्वसन्तंतुंलक्ष्मणम् । रामस्तुदुःखसन्तप्तंतंतुनिःश्वासपीडितम् ॥ मूर्ध्निचैनमुपाघ्रायभूयःसंस्पृश्य च त्वरन् । उवाचलक्ष्मणंवाक्यमाश्वास्यपुरुषर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40018218, "chapter_id": 9280, "verse_number": "12", "content_sanskrit": "शल्यसंपीडितंशस्तंनिःश्वसन्तंतुंलक्ष्मणम् । रामस्तुदुःखसन्तप्तंतंतुनिःश्वासपीडितम् ॥ मूर्ध्निचैनमुपाघ्रायभूयःसंस्पृश्य च त्वरन् । उवाचलक्ष्मणंवाक्यमाश्वास्यपुरुषर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40018219, "chapter_id": 9280, "verse_number": "13", "content_sanskrit": "कृतंपरमकळ्याणंकर्मदुष्करकर्मणा । अद्यमन्येहतेपुत्रेरावणंनिहतंयुधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40018220, "chapter_id": 9280, "verse_number": "14", "content_sanskrit": "अद्याहंविजयीशत्रौहतेतस्मिन् दुरात्मनि । रावणस्यनृशंसस्यदिष्ट्यावीरत्वयारणे ॥ छिन्नोहिदक्षिणोबाहुः स हितस्यव्यपाश्रयः । विभीषणहनूमद्भ्यांकृतंकर्ममहद्रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40018221, "chapter_id": 9280, "verse_number": "15", "content_sanskrit": "अद्याहंविजयीशत्रौहतेतस्मिन् दुरात्मनि । रावणस्यनृशंसस्यदिष्ट्यावीरत्वयारणे ॥ छिन्नोहिदक्षिणोबाहुः स हितस्यव्यपाश्रयः । विभीषणहनूमद्भ्यांकृतंकर्ममहद्रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40018222, "chapter_id": 9280, "verse_number": "16", "content_sanskrit": "अहोरात्रैस्त्रिभिर्वीरःकथञ्चितवन्दिपातितः । विरमित्रःकृतोऽस्म्यद्यनिर्यास्यतिहिरावणः ॥ बलव्यूहेनमहताश्रुत्वापुत्त्रंनिपातितम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40018223, "chapter_id": 9280, "verse_number": "17", "content_sanskrit": "तंपुत्रवधसन्तप्तंनिर्यान्तंराक्षसाधिपम् ॥ बलेनावृत्यमहतानिहनिष्यामिदुर्जयम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40018224, "chapter_id": 9280, "verse_number": "18", "content_sanskrit": "त्वयालक्ष्मणनाथेनसीता च पृथिवी च मे ॥ न दुष्प्रापाहतेतस्मिन् शक्रजेतरिचाहवे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40018225, "chapter_id": 9280, "verse_number": "19", "content_sanskrit": "सतंभ्रातरमाश्वास्यपरिष्वज्य च राघवः ॥ रामःसुषेणंमुदितस्समाभाष्येदमब्रवीत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40018226, "chapter_id": 9280, "verse_number": "20", "content_sanskrit": "सशल्योऽयंमहाप्राज्ञस्सौमित्रिर्मित्रवत्सलः ॥ यथाभवतिसुस्वस्थस्तथात्वंसमुपाचर ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40018227, "chapter_id": 9280, "verse_number": "21", "content_sanskrit": "विशल्यःक्रियतांक्षिप्रंसौमित्रिस्सविभीषणः ॥ ऋक्ष्वानरसैन्यानांशूराणांद्रुमयोधिनाम् । येचाप्यन्येऽत्रयुध्यन्तिसशल्याव्रणिनस्तथा ॥ तेऽपिसर्वेप्रयत्नेनक्रियन्तांसुखिनस्तथा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40018228, "chapter_id": 9280, "verse_number": "22", "content_sanskrit": "विशल्यःक्रियतांक्षिप्रंसौमित्रिस्सविभीषणः ॥ ऋक्ष्वानरसैन्यानांशूराणांद्रुमयोधिनाम् । येचाप्यन्येऽत्रयुध्यन्तिसशल्याव्रणिनस्तथा ॥ तेऽपिसर्वेप्रयत्नेनक्रियन्तांसुखिनस्तथा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40018229, "chapter_id": 9280, "verse_number": "23", "content_sanskrit": "एवमुक्तस्तुरामेणमहात्माहरियूथपः ॥ लक्ष्मणायदरौनस्तस्सुषेणःपरमौषधम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40018230, "chapter_id": 9280, "verse_number": "24", "content_sanskrit": "स तस्यगन्धमाघ्रायविशल्यस्समपद्यत ॥ तदानिर्वेदनश्चैवसंरूढव्रणएव च ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40018231, "chapter_id": 9280, "verse_number": "25", "content_sanskrit": "विभीषणमुखानां च सुहृदांराघवाज्नाया ॥ सर्ववानरमुख्यानांचिकित्सामकरोत्तदा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40018232, "chapter_id": 9280, "verse_number": "26", "content_sanskrit": "ततःप्रकृतिमापन्नोहृतशल्योगतव्यथ: ॥ सौमित्रिर्मुदितस्तत्र क्षणेन विगतज्वरः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit