[{"id": 2038287, "chapter_id": 1835, "verse_number": "५-८०-०x", "content_sanskrit": "सहदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2038288, "chapter_id": 1835, "verse_number": "५-८०-१", "content_sanskrit": "यदेतत्कथितं राज्ञा धर्म एष सनातनः।\nयथा च युद्धमेव स्यात्तथा कार्यमरिन्दम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2038289, "chapter_id": 1835, "verse_number": "५-८०-२", "content_sanskrit": "यदि प्रसममिच्छेयुः कुरवः पाण्डवैः सह।\nतथापि युद्धं दाशार्ह योजयेथाः सहैव तैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2038290, "chapter_id": 1835, "verse_number": "५-८०-३", "content_sanskrit": "कथं नु दृष्ट्वा पाञ्चालीं तथा कृष्ण सभागताम्।\nअवधेन प्रशाम्येत मम मन्युः सुयोधने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2038291, "chapter_id": 1835, "verse_number": "५-८०-४", "content_sanskrit": "यदि भीमार्जुनौ कृष्ण धर्मराजश्च धार्मिकः ।\nधर्ममुत्सृज्य तेनाहं योद्धुमिच्छामि संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2038292, "chapter_id": 1835, "verse_number": "५-८०-५", "content_sanskrit": "ब्रूहि मद्वचनं कृष्ण सुयोधनमपण्डितम्।\nकृच्छ्रे वने वा वस्तव्यं पुरे वा नागसाह्वये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2038293, "chapter_id": 1835, "verse_number": "५-८०-६x", "content_sanskrit": "सात्यकिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2038294, "chapter_id": 1835, "verse_number": "५-८०-६", "content_sanskrit": "सत्यमाह महाबाहो सहदेवो महामतिः।\nदुर्योधनवधे शान्तिस्तस्य कोपस्य मे भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2038295, "chapter_id": 1835, "verse_number": "५-८०-७", "content_sanskrit": "न जानासि यथा दृष्ट्वा चीराजिनधरान्वने।\nतवापि मन्युरुद्धूतो दुःखितान्प्रेक्ष्य पाण्डवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2038296, "chapter_id": 1835, "verse_number": "५-८०-८", "content_sanskrit": "तस्मान्माद्रीसुतः शूरो यदाह रणकर्कशः।\nवचनं सर्वयोधानां तन्मतं पुरुषोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2038297, "chapter_id": 1835, "verse_number": "५-८०-९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2038298, "chapter_id": 1835, "verse_number": "५-८०-९", "content_sanskrit": "एवं वदि वाक्यं तु युयुधाने महामतौ।\nसुभीमः सिंहनादोऽभूद्योधानां तत्र सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2038299, "chapter_id": 1835, "verse_number": "५-८०-१०", "content_sanskrit": "सर्वे हि सर्वशो वीरास्तद्वचः प्रत्यपूजयन्।\nसाधुसाध्विति शैनेयं हर्षयन्तो युयुत्सवः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2038300, "chapter_id": 1835, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि अशीतितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]