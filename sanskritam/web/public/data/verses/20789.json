[{"id": 7000789000, "chapter_id": 20789, "verse_number": "६-१३२-१", "content_sanskrit": "पार्वत्युवाच ।\nअनंतवासुदेवस्य कीदृशं स्मरणं स्मृतम् ।\nयच्छ्रुत्वा न पुनर्मोहो मानुषाणां प्रजायते॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000789001, "chapter_id": 20789, "verse_number": "६-१३२-२", "content_sanskrit": "महादेव उवाच ।\nदृष्टतत्वेन देवेशि स्मरंति विष्णुं नित्यशः ।\nतृषातुरो यथा वारि तद्वद्विष्णुं स्मराम्यहम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000789002, "chapter_id": 20789, "verse_number": "६-१३२-३", "content_sanskrit": "हिमेनाकुलितं विश्वं स्मरत्यग्निं यथा तथा ।\nतद्वदेव तु वै विष्णुं स्मरंति विबुधादयः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000789003, "chapter_id": 20789, "verse_number": "६-१३२-४", "content_sanskrit": "पतिव्रता यथा नारी पतिं स्मरति नित्यशः ।\nतथा स्मरंति लोकेशं विष्णुं विश्वेश्वरेश्वरम्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000789004, "chapter_id": 20789, "verse_number": "६-१३२-५", "content_sanskrit": "भयार्त्तः शरणं यद्वदर्थलोभी यथा धनम् ।\nपुत्रकामो यथा पुत्रं तथा विष्णुं स्मराम्यहम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000789005, "chapter_id": 20789, "verse_number": "६-१३२-६", "content_sanskrit": "दूरस्थोऽपि यथा गेहं चातको माधवं यथा ।\nब्रह्मविद्यां ब्रह्मविदस्तथा विष्णुं स्मराम्यहम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000789006, "chapter_id": 20789, "verse_number": "६-१३२-७", "content_sanskrit": "हंसा मानसमिच्छंति ऋषयः स्मरणं हरेः ।\nभक्ताश्च भक्तिमिच्छंति तथा विष्णुं स्मराम्यहम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000789007, "chapter_id": 20789, "verse_number": "६-१३२-८", "content_sanskrit": "प्राणिनां वल्लभो देहो यत्र आत्माऽवतिष्ठति ।\nआयुर्वांच्छंति ये जीवास्तथा विष्णुं स्मराम्यहम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000789008, "chapter_id": 20789, "verse_number": "६-१३२-९", "content_sanskrit": "भ्रमराश्च यथा पुष्पं चक्रवाका दिवाकरम् ।\nयथात्मवल्लभा भक्तिस्तथा विष्णुं स्मराम्यहम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000789009, "chapter_id": 20789, "verse_number": "६-१३२-१०", "content_sanskrit": "अंधेनाकुलिता लोका दीपं वांच्छंति वै यथा ।\nतथा वै पुरुषा लोके स्मरणं केशवस्य च॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000789010, "chapter_id": 20789, "verse_number": "६-१३२-११", "content_sanskrit": "यथा श्रमार्त्ता विश्रामं निद्रा व्यसनिनो यथा ।\nगतालस्या यथा विद्यां तथा विष्णुं स्मराम्यहम्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000789011, "chapter_id": 20789, "verse_number": "६-१३२-१२", "content_sanskrit": "मातंगाः पार्वतीं भूमिं सिंहा वनगजादिकम् ।\nतथैव स्मरणं विष्णोः कर्तव्यं पापभीरुभिः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000789012, "chapter_id": 20789, "verse_number": "६-१३२-१३", "content_sanskrit": "सूर्यकांते रवेर्योगाद्वह्निस्तत्र प्रजायते ।\nएवं वै साधुसंयोगाद्धरौ भक्तिः प्रजायते॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000789013, "chapter_id": 20789, "verse_number": "६-१३२-१४", "content_sanskrit": "शीतरश्मेर्यथा कांतश्चंद्रयोगादपः श्रयेत् ।\nएवं वैष्णवसंयोगान्मुक्तिर्भवति शाश्वती॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000789014, "chapter_id": 20789, "verse_number": "६-१३२-१५", "content_sanskrit": "कुमुद्वती यथा सोमं दृष्ट्वा पुष्पं विकासते ।\nतद्वद्देवे कृता भक्तिर्मुक्तिदा सर्वदा नृणाम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000789015, "chapter_id": 20789, "verse_number": "६-१३२-१६", "content_sanskrit": "यथानलायाः संत्रस्ता भ्रमरी स्मरणं चरेत् ।\nतेन स्मरणयोगेन नलासारूप्यतामियात्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000789016, "chapter_id": 20789, "verse_number": "६-१३२-१७", "content_sanskrit": "गोपीभिर्जारबुद्ध्या च विष्णोश्च स्मरणं कृतम् ।\nताश्च सायुज्यतां नीतास्तथा विष्णुं स्मराम्यहम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000789017, "chapter_id": 20789, "verse_number": "६-१३२-१८", "content_sanskrit": "केऽपि वै दुष्टभावेन च्छद्मभावेन केचन ।\nके चापि लोभभावेन चिंतयंति जनार्दनम्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000789018, "chapter_id": 20789, "verse_number": "६-१३२-१९", "content_sanskrit": "भक्त्या वा स्नेहभावेन द्वेषभावेन वा पुनः ।\nकेऽपि स्वामित्त्वभावेन बुद्धया वा बुद्धिपूर्वकम्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000789019, "chapter_id": 20789, "verse_number": "६-१३२-२०", "content_sanskrit": "येनकेनापि भावेन चिंतयंति जनार्दनम् ।\nइहलोके सुखं भुक्त्वा यांति विष्णोः सनातनम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000789020, "chapter_id": 20789, "verse_number": "६-१३२-२१", "content_sanskrit": "अहो विष्णोश्च माहात्म्यमद्भुतं लोमहर्षणम् ।\nयदृच्छयापि स्मरणं त्रिधामुक्तिप्रदायकम्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000789021, "chapter_id": 20789, "verse_number": "६-१३२-२२", "content_sanskrit": "न धनेन समृद्धेन विपुलाविद्यया तथा ।\nएकेन भक्तियोगेन समीपे दृश्यते क्षणात्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000789022, "chapter_id": 20789, "verse_number": "६-१३२-२३", "content_sanskrit": "सांनिध्येऽपि स्थितो दूरे नेत्रयोरंजनं यथा ।\nभक्तियोगेन दृश्येन भक्तैश्चैव सनातनः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000789023, "chapter_id": 20789, "verse_number": "६-१३२-२४", "content_sanskrit": "इदं तत्वमिदं तत्वं मोहितो देवमायया ।\nभक्तितत्वं यदा प्राप्तं तदा विष्णुमयं जगत्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000789024, "chapter_id": 20789, "verse_number": "६-१३२-२५", "content_sanskrit": "इंद्राद्यैरमृतं प्राप्तं सुखार्थे शृणु सुंदरि ।\nतथापि दुःखितास्ते वै भक्त्या विष्णोर्यथा विना॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000789025, "chapter_id": 20789, "verse_number": "६-१३२-२६", "content_sanskrit": "भक्तिमेवामृतं प्राप्य पुनर्दुःखं न जायते ।\nवैकुंठाख्यं पदं प्राप्य मोदते विष्णुसन्निधौ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000789026, "chapter_id": 20789, "verse_number": "६-१३२-२७", "content_sanskrit": "वारि त्यक्त्वा यथा हंसः पयः पिबति नित्यशः ।\nएवं धर्मान्परित्यज्य विष्णोर्भक्तिं समाश्रयेत्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000789027, "chapter_id": 20789, "verse_number": "६-१३२-२८", "content_sanskrit": "अन्यभक्तिं परित्यज्य विष्णुभक्तिं समाश्रयेत् ।\nतोयं बद्ध्वा तु वस्त्रेण कृतं कार्यं कथं भवेत्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000789028, "chapter_id": 20789, "verse_number": "६-१३२-२९", "content_sanskrit": "प्राप्य देहं विना भक्तिं क्रियते स वृथाश्रमः ।\nविष्णुभक्तिं विना धर्मानुपदिशंति ये जनाः ।\nते पतंति सदा घोरे नरके नात्र संशयः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000789029, "chapter_id": 20789, "verse_number": "६-१३२-३०", "content_sanskrit": "बाहुभ्यां सागरं तर्तुं यद्वन्मूर्खोऽभिवांछति ।\nसंसारसागरं तद्वद्विष्णुभक्तिं विना नरः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000789030, "chapter_id": 20789, "verse_number": "६-१३२-३१", "content_sanskrit": "विष्णुभक्तिं च रक्षंति कर्मणा पात्यते यदि ।\nअकिंचनः स्पृहायुक्तो मेरौ धत्ते यथा स्पृहाम्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000789031, "chapter_id": 20789, "verse_number": "६-१३२-३२", "content_sanskrit": "तव भक्तौ तथा देव मया हि क्रियते स्पृहा ।\nजन्मांतरे हि सा भक्तिर्मामकी यत्करोति हि॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000789032, "chapter_id": 20789, "verse_number": "६-१३२-३३", "content_sanskrit": "वह्निर्यथेह स्वल्पोऽपि दहते विविधं वनम् ।\nतद्वदेव तु सा भक्तिरणुमात्रा कृता मया॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000789033, "chapter_id": 20789, "verse_number": "६-१३२-३४", "content_sanskrit": "शतैश्च श्रूयते भक्तिः सहस्रैरपि बुध्यते ।\nतेषां मध्ये तु देवेशि भक्तोह्येकः प्रजायते॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000789034, "chapter_id": 20789, "verse_number": "६-१३२-३५", "content_sanskrit": "बुद्धिं परेषां दास्यंति लोके बहुविधा जनाः ।\nस्वयमाचरते सोऽपि नरः कोटिषु दृश्यते॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000789035, "chapter_id": 20789, "verse_number": "६-१३२-३६", "content_sanskrit": "पूजया हस्यते भक्तिर्जयेन परिहस्यते ।\nएवं भावो हि देवेशे भक्तिस्तेनैव गृह्यते॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000789036, "chapter_id": 20789, "verse_number": "६-१३२-३७", "content_sanskrit": "सागरे च यथा पातः कूपे त्राणोपवेशनम् ।\nयस्य भावो हि तद्वच्च भक्तिः सा तेन गृह्यते॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000789037, "chapter_id": 20789, "verse_number": "६-१३२-३८", "content_sanskrit": "मूले सिक्तस्य वृक्षस्य पत्रं शाखासु दृश्यते ।\nभजनादेव भो देवि फलमग्रे प्रतिष्ठितम्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000789038, "chapter_id": 20789, "verse_number": "६-१३२-३९", "content_sanskrit": "पानीयहारिणा यद्वत्घटे चित्तं प्रधीयते ।\nतद्वद्देवे हरौ चित्तं धृत्वा मोक्षमवाप्नुयात्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000789039, "chapter_id": 20789, "verse_number": "६-१३२-४०", "content_sanskrit": "शैशवे च यथा माता गुडं स्तोकं ददाति वै ।\nपुनर्याचति वै बालो गुडं वै लोभकारणात्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000789040, "chapter_id": 20789, "verse_number": "६-१३२-४१", "content_sanskrit": "नीरे नीरं यथाक्षिप्तं दुग्धे दुग्धं घृते घृतम् ।\nतद्वद्भेदं न पश्यंति विष्णुभक्तिप्रसादतः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000789041, "chapter_id": 20789, "verse_number": "६-१३२-४२", "content_sanskrit": "भानुः सर्वगतो यद्वद्वह्निः सर्वगतो यथा ।\nभक्तिः स्थितस्तथा भक्तः कर्मभिर्नैव बाध्यते॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000789042, "chapter_id": 20789, "verse_number": "६-१३२-४३", "content_sanskrit": "अजामिलः स्वधर्मं च त्यक्त्वा पापं समाचरन् ।\nपुत्रं नारायणं स्मृत्वा मुक्तिं वै प्राप्तवान्ध्रुवम्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000789043, "chapter_id": 20789, "verse_number": "६-१३२-४४", "content_sanskrit": "दिवारात्रौ च ये भक्ता नाममात्रोपजीविनः ।\nवैकुंठवासिनस्ते वै तत्र वेदा हि साक्षिणः॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000789044, "chapter_id": 20789, "verse_number": "६-१३२-४५", "content_sanskrit": "अश्वमेधादियज्ञानां फलं स्वर्गेऽपि दृश्यते ।\nतत्फलं तु समग्रं वै भुक्त्वा वै संपतंति च॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000789045, "chapter_id": 20789, "verse_number": "६-१३२-४६", "content_sanskrit": "विष्णुभक्तिस्तथा देवि भुक्त्वा भोगाननेकशः ।\nवैकुंठं प्राप्य वा तेषां पुनरागमनं कदा॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000789046, "chapter_id": 20789, "verse_number": "६-१३२-४७", "content_sanskrit": "विष्णुभक्तिः कृता येन विष्णुलोके वसत्यसौ ।\nदृष्टांतं पश्य देवेशि विष्णुभक्तिप्रसादतः॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000789047, "chapter_id": 20789, "verse_number": "६-१३२-४८", "content_sanskrit": "ग्रावाणो जलमध्यस्थाः शतशस्तेन तारिताः ।\nविना जलं सोमकांतो विष्णुभक्तस्य मानसम्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000789048, "chapter_id": 20789, "verse_number": "६-१३२-४९", "content_sanskrit": "दर्दुरो वसते नीरे षट्पदो हि वनांतरे ।\nगंधं वेत्ति कुमुद्वत्या भक्तो भक्तौ तथा हरेः॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000789049, "chapter_id": 20789, "verse_number": "६-१३२-५०", "content_sanskrit": "गंगातटे वसंत्येके एके वै शतयोजनम् ।\nकश्चिद्गंगाफलं वेत्ति विष्णुभक्तिं परस्तथा॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000789050, "chapter_id": 20789, "verse_number": "६-१३२-५१", "content_sanskrit": "कर्पूरागुरुभारं हि उष्ट्रो वहति नित्यशः ।\nमध्यगंधं न जानाति तथा विष्णुं बहिर्मुखाः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000789051, "chapter_id": 20789, "verse_number": "६-१३२-५२", "content_sanskrit": "मृगाः शालं हि जिघ्रंति कस्तूरीगंधमिच्छवः ।\nस्वनाभिस्थं न जानंति तथा विष्णुं बहिर्मुखाः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000789052, "chapter_id": 20789, "verse_number": "६-१३२-५३", "content_sanskrit": "उपदेशो हि मूर्खाणां वृथा वै नगनंदिनि ।\nतथैव विष्णुभक्तेर्हि उपदेशो बहिर्मुखे॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000789053, "chapter_id": 20789, "verse_number": "६-१३२-५४", "content_sanskrit": "अहिना च पयः पीतं तत्पयो हि विषायते ।\nतथा वै चान्यभक्तानां विष्णुभक्तिर्विषायते॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000789054, "chapter_id": 20789, "verse_number": "६-१३२-५५", "content_sanskrit": "चक्षुर्विना यथा दीपं दृष्ट्वा दर्पणमेव च ।\nसमीपस्था न पश्यंति तथा विष्णुं बहिर्मुखाः॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000789055, "chapter_id": 20789, "verse_number": "६-१३२-५६", "content_sanskrit": "पावको हि यथा धूमैरादर्शोपि मलेन च ।\nयथोल्बेनावृतो गर्भो देहे कृष्णस्तथावृतः॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000789056, "chapter_id": 20789, "verse_number": "६-१३२-५७", "content_sanskrit": "दुग्धे सर्पिः स्थितं यद्वत्तिले तैलं तु सर्वदा ।\nचराचरे तथा विष्णुर्दृश्यते नगनंदिनि॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000789057, "chapter_id": 20789, "verse_number": "६-१३२-५८", "content_sanskrit": "एकसूत्रे मणिगणा धार्यंते बहवो यथा ।\nएवं ब्रह्मादिभिर्विश्वं संप्रोतं ब्रह्मचिन्मये॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000789058, "chapter_id": 20789, "verse_number": "६-१३२-५९", "content_sanskrit": "यथा काष्ठे स्थितो वह्निर्मंथनादेव दृश्यते ।\nएवं सर्वगतो विष्णुर्ध्यानादेव प्रदृश्यते॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000789059, "chapter_id": 20789, "verse_number": "६-१३२-६०", "content_sanskrit": "आदिरेको भवेद्दीपस्तस्माज्जाताः सहस्रशः ।\nएवमेकः स्थितो विष्णुः सर्वव्याप्य प्रतिष्ठति॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000789060, "chapter_id": 20789, "verse_number": "६-१३२-६१", "content_sanskrit": "यथा सूर्योदये ज्योतिः पुष्करे तिष्ठते सदा ।\nदृश्यते बहुधा नीरे लोके विष्णुस्तथा हि सः॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000789061, "chapter_id": 20789, "verse_number": "६-१३२-६२", "content_sanskrit": "मारुतः प्रकृतिस्थोऽपि नानागंधवहः सदा ।\nईश्वरः सर्वजीवस्थो भुंक्ते प्रकृतिजान्गुणान्॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000789062, "chapter_id": 20789, "verse_number": "६-१३२-६३", "content_sanskrit": "शर्करा विषसंयोगान्नीरं भवति यादृशम् ।\nसंभूत्त्वा तादृशो ह्यात्मा कर्मणः फलमश्नुते॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000789063, "chapter_id": 20789, "verse_number": "६-१३२-६४", "content_sanskrit": "उर्वी च नीरसंयोगान्नानावृक्षा प्रजायते ।\nप्रकृतेर्गुणसंयोगान्नानायोनिषु जायते॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000789064, "chapter_id": 20789, "verse_number": "६-१३२-६५", "content_sanskrit": "गजे वै मशके चैव देवे वा मानुषेऽपि वा ।\nनाधिको न च न्यूनो वै निष्ठो देहे स निश्चलः॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000789065, "chapter_id": 20789, "verse_number": "६-१३२-६६", "content_sanskrit": "ब्रह्मादिस्तंबपर्यंता ये चात्र भुवि मानवाः ।\nदेवा यज्ञास्तथा नागा गंधर्वाः किन्नरादयः॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000789066, "chapter_id": 20789, "verse_number": "६-१३२-६७", "content_sanskrit": "तेषु सर्वेषु दृश्यंते जले चंद्रमसो यथा ।\nस सच्चिदानंदशिवः स महेशो हि दृश्यते॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000789067, "chapter_id": 20789, "verse_number": "६-१३२-६८", "content_sanskrit": "स वै विष्णुस्तथा प्रोक्तः सोऽयं सर्वगतो हरिः ।\nवेदांतवेद्यः सर्वेशः कालातीतो ह्यनामयः॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000789068, "chapter_id": 20789, "verse_number": "६-१३२-६९", "content_sanskrit": "एवं तं वेत्ति यो देवि स भक्तो नात्र संशयः ।\nएको हि बहुधा ज्ञेयो बहुधाप्येक एव सः॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000789069, "chapter_id": 20789, "verse_number": "६-१३२-७०", "content_sanskrit": "नामरूपविभेदेन जल्प्यते बहुधा भुवि ।\nचक्षुषा न रवेर्ज्योतिर्भानुना चक्षुरेधते॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000789070, "chapter_id": 20789, "verse_number": "६-१३२-७१", "content_sanskrit": "परमात्मा तथा चात्मा प्रतिदेहे तु सर्वदा ।\nघटे घटे यथाकाशस्तस्मिन्भग्ने यथा स्थितः॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000789071, "chapter_id": 20789, "verse_number": "६-१३२-७२", "content_sanskrit": "रूपे रूपे तथा त्वं हि भग्ने तस्मिन्सुनिश्चलः ।\nयथा काष्ठमयं रूपं पतते प्रभुणा विना॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000789072, "chapter_id": 20789, "verse_number": "६-१३२-७३", "content_sanskrit": "क्रिमिभेदमयो देहो पतते चात्मना विना ।\nहेम्नो भवंति वर्णाश्च वह्निना यांति पूर्ववत्॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000789073, "chapter_id": 20789, "verse_number": "६-१३२-७४", "content_sanskrit": "तद्वज्जीवाः प्रपद्यंते भक्ता वै पूर्वरूपताम् ।\nस्वघनेनावृतं सूर्यं मूढाः पश्यंति निष्प्रभम्॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000789074, "chapter_id": 20789, "verse_number": "६-१३२-७५", "content_sanskrit": "तथाऽज्ञानधियो मूढा न जानंति तमीश्वरम् ।\nनिर्विकल्पं निराकारं वेदां तैः परिपाठ्यते॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000789075, "chapter_id": 20789, "verse_number": "६-१३२-७६", "content_sanskrit": "निराकाराच्च साकारं स्वेच्छया च प्रकाशते ।\nतस्मात्संजातमाकाशं निःशब्दं गुणवर्जितम्॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000789076, "chapter_id": 20789, "verse_number": "६-१३२-७७", "content_sanskrit": "आकाशान्मारुतो जातः सशब्दं च तदाऽभवत् ।\nवातादजायत ज्योतिर्ज्योतिषश्चाभवज्जलम्॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000789077, "chapter_id": 20789, "verse_number": "६-१३२-७८", "content_sanskrit": "तज्जले रुक्मगर्भश्च विराड्वै विश्वरूपधृक् ।\nतस्य नाभिसरोजे च ब्रह्मांडानां च कोटयः॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000789078, "chapter_id": 20789, "verse_number": "६-१३२-७९", "content_sanskrit": "प्रकृतिः पुरुषस्तस्मान्निर्मितं तु त्रिधा जगत् ।\nतयोर्द्वयोश्च संयोगात्तत्त्वयोगो ऽभ्यजायत॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000789079, "chapter_id": 20789, "verse_number": "६-१३२-८०", "content_sanskrit": "सात्विकी विष्णुसंभूतिर्ब्रह्मा वै राजसः स्मृतः ।\nशिवस्तु तामसः प्रोक्त एभिः सर्वं प्रवर्तितम्॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000789080, "chapter_id": 20789, "verse_number": "६-१३२-८१", "content_sanskrit": "एका ब्राह्मी स्थितिर्लोके कर्मबीजानुसारतः ।\nतया संहरते विष्णुः सर्वलोकानुशेषतः॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000789081, "chapter_id": 20789, "verse_number": "६-१३२-८२", "content_sanskrit": "तिष्ठत्यसौ तदा तत्र भगवान्विष्णुरव्ययः ।\nएवं सर्वगतो विष्णुरादिमध्यांत एव च॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000789082, "chapter_id": 20789, "verse_number": "६-१३२-८३", "content_sanskrit": "अविद्यया न जानंति लोका वै कर्मनिश्चिताः ।\nवर्णोचितानि कर्माणि यः कालेषु प्रकारयेत्॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000789083, "chapter_id": 20789, "verse_number": "६-१३२-८४", "content_sanskrit": "यत्कर्मविष्णुदैवत्यं न हि गर्भस्य कारणम् ।\nवेदांतशास्त्रे मुनिभिः सर्वदैव विचार्यते॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000789084, "chapter_id": 20789, "verse_number": "६-१३२-८५", "content_sanskrit": "ब्रह्मज्ञानमिदं देहे तदहं परिकीर्त्तये ।\nशुभाशुभस्य कार्यं च कारणं मन एव हि॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000789085, "chapter_id": 20789, "verse_number": "६-१३२-८६", "content_sanskrit": "मनसा शुध्यते सर्वं तदा ब्रह्म सनातनम् ।\nमन एव सदा बंधुर्मन एव सदा रिपुः॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000789086, "chapter_id": 20789, "verse_number": "६-१३२-८७", "content_sanskrit": "मनसा तारिताः केचिन्मनसा यातिताश्च के ।\nमध्ये सर्वपरित्यागः बाह्ये कर्म तथाचरन्॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000789087, "chapter_id": 20789, "verse_number": "६-१३२-८८", "content_sanskrit": "एवमेव कृतं कर्म कुर्वन्नपि न लिप्यते ।\nपद्मपत्रं यथा नीर लेशैरपि न लिप्यते॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000789088, "chapter_id": 20789, "verse_number": "६-१३२-८९", "content_sanskrit": "अग्निरग्नौ यथा क्षिप्तो भक्त्या च किं प्रयोजनम् ।\nयदा भक्तिरसो ज्ञातो न मुक्ती रोचते तदा॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000789089, "chapter_id": 20789, "verse_number": "६-१३२-९०", "content_sanskrit": "योगैरष्टविधैर्विष्णुर्न प्राप्यश्चेह जन्मनि ।\nभक्त्या वा प्राप्यते विष्णुः सर्वदा सुलभो भवेत्॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000789090, "chapter_id": 20789, "verse_number": "६-१३२-९१", "content_sanskrit": "वेदांतैः प्राप्यते ज्ञानं ज्ञानेन ज्ञेयमेव च ।\nतत्तु ज्ञेयं यदा प्राप्तं तदा शून्यमिदं जगत्॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000789091, "chapter_id": 20789, "verse_number": "६-१३२-९२", "content_sanskrit": "बलेन प्राप्यते विष्णुर्योगैरष्टविधैश्च किम् ।\nसर्वेषामेव भावानां भावशुद्धिः प्रशस्यते॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000789092, "chapter_id": 20789, "verse_number": "६-१३२-९३", "content_sanskrit": "आलिंग्यते यथा कांता यथा भावस्तथा फलम् ।\nउपानद्युक्तपादो हि वेत्ति चर्ममयीं महीम्॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000789093, "chapter_id": 20789, "verse_number": "६-१३२-९४", "content_sanskrit": "बुद्धिर्यथाविधा यस्य तद्वत्स मन्यते जगत् ।\nदुग्धेन सिक्तो निंबोऽपि कटुभावं न तु त्यजेत्॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000789094, "chapter_id": 20789, "verse_number": "६-१३२-९५", "content_sanskrit": "प्रकृतिं यांति भूतानि उपदेशो निरर्थकः ।\nछित्वा वै सहकारं च फलं पत्रं कथं लभेत्॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000789095, "chapter_id": 20789, "verse_number": "६-१३२-९६", "content_sanskrit": "इंद्रियाणां सुखार्थेन वृथा जन्म कथं नयेत् ।\nस्थाल्यां वैडूर्यमय्यां हि पच्यते चौषधं यथा॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000789096, "chapter_id": 20789, "verse_number": "६-१३२-९७", "content_sanskrit": "दह्यते चागदस्तद्वद्वृथाजन्म कथं भवेत् ।\nनिधानं च गृहे क्षिप्त्वा शुभः सेवां कथं चरेत्॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000789097, "chapter_id": 20789, "verse_number": "६-१३२-९८", "content_sanskrit": "त्यक्त्वा वैकुंठनाथं तमन्यमार्गे कथं रमेत् ।\nभक्तिहीनैश्चतुर्वेदैः पठितैः किं प्रयोजनम्॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000789098, "chapter_id": 20789, "verse_number": "६-१३२-९९", "content_sanskrit": "श्वापचो भक्तियुक्तस्तु त्रिदशैरपि पूज्यते ।\nस्वकरे कंकणं बद्ध्वा दर्पणैः किं प्रयोजनम्॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000789099, "chapter_id": 20789, "verse_number": "६-१३२-१००", "content_sanskrit": "ब्रह्मरुद्रादिभिर्देवैर्दत्तैश्वर्याश्च सेवकाः ।\nअर्पितं नैव गृह्णंति प्रभोश्चैव तु किंचन॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000789100, "chapter_id": 20789, "verse_number": "६-१३२-१०१", "content_sanskrit": "अकिंचनाय भक्ताय दातुं नालं गतो वरम् ।\nनिःशरीरस्य कृष्णस्य तत्र ध्यानं कथं भवेत्॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000789101, "chapter_id": 20789, "verse_number": "६-१३२-१०२", "content_sanskrit": "साकारं बहवो दृष्ट्वा गता भक्त्या च तत्पदम् ।\nपूजा भक्तिः कथं शून्ये साकारे कथ्यते बुधैः॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000789102, "chapter_id": 20789, "verse_number": "६-१३२-१०३", "content_sanskrit": "शून्यमार्गे कथं याति आधारेण विना नरः ।\nसाकारो यः स्वयं स्वामी निराकारः स वै प्रभुः॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000789103, "chapter_id": 20789, "verse_number": "६-१३२-१०४", "content_sanskrit": "साकारो हि सुखेनैव निराकारो न दृश्यते ।\nसेवारसश्च साकारे निराकारेण वैरसः॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000789104, "chapter_id": 20789, "verse_number": "६-१३२-१०५", "content_sanskrit": "साकारेण निराकारो ज्ञायते स्वयमेव हि ।\nहरिस्मृतिप्रसादेन रोमांचित तनुर्यदा॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000789105, "chapter_id": 20789, "verse_number": "६-१३२-१०६", "content_sanskrit": "नयनानंदसलिलं मुक्तिर्दासी भवेत्तदा ।\nबाल्ये च यत्कृतं पापं तत्कथं न विनश्यति॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000789106, "chapter_id": 20789, "verse_number": "६-१३२-१०७", "content_sanskrit": "पूजादानव्रतैस्तीर्थैर्जपहोमैस्त्वदर्पितैः ।\nनिजधर्मं परित्यज्य तपो घोरं कथं चरेत्॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000789107, "chapter_id": 20789, "verse_number": "६-१३२-१०८", "content_sanskrit": "स्वधर्मे निधनं श्रेयः परमधर्मो भयावहः ।\nविधिं संत्यज्य शास्त्रीयं तपो घोरं कथं चरेत्॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000789108, "chapter_id": 20789, "verse_number": "६-१३२-१०९", "content_sanskrit": "आश्रमेण विना मूढो नैव सिद्धिमवाप्नुयात् ।\nब्रह्मणा निर्मिता वर्णाः स्वे स्वे धर्मे नियोजिताः॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000789109, "chapter_id": 20789, "verse_number": "६-१३२-११०", "content_sanskrit": "स्वधर्मेणागतं द्रव्यं शुक्लद्रव्यं तदुच्यते ।\nशुक्लद्रव्येण यद्दानं दीयते श्रद्धयान्वितम्॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000789110, "chapter_id": 20789, "verse_number": "६-१३२-१११", "content_sanskrit": "स्वल्पेनापि महत्पुण्यं तस्य संख्या न विद्यते ।\nनीचसंगेन यद्द्रव्यमानीतं गृहकर्मसु॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7000789111, "chapter_id": 20789, "verse_number": "६-१३२-११२", "content_sanskrit": "तेन द्रव्येण यद्दानं कृतं वै मनुजादिभिः ।\nतत्फलं न भवेत्ते वै नैव तत्फलभागिनः॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7000789112, "chapter_id": 20789, "verse_number": "६-१३२-११३", "content_sanskrit": "यादृशं कुरुते कर्म इंद्रियाणां सुखेच्छया ।\nतादृशीं योनिमाप्नोति मूढो हि ज्ञानदुर्बलः॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7000789113, "chapter_id": 20789, "verse_number": "६-१३२-११४", "content_sanskrit": "इह यत्कुरुते कर्म तत्परत्रोपभुज्यते ।\nपुण्यमाचरतः पुंसो यदि दुःखं प्रजायते॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7000789114, "chapter_id": 20789, "verse_number": "६-१३२-११५", "content_sanskrit": "तदा तापो न कर्त्तव्यस्तत्कर्म पूर्वदेहजम् ।\nपापमाचरतः पुंसो जायते दुःखमेव च॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7000789115, "chapter_id": 20789, "verse_number": "६-१३२-११६", "content_sanskrit": "न कर्त्तव्यस्तदा हर्षः सुखे तत्र सुरेश्वरि ।\nरज्जुबद्धाश्च पशवः प्रभुणा स्वेच्छया यथा॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7000789116, "chapter_id": 20789, "verse_number": "६-१३२-११७", "content_sanskrit": "नीयंते कर्मबंधेन मनुजा अपि भूतले ।\nशाखामृगो वनचरो नृत्यते च गृहे गृहे॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7000789117, "chapter_id": 20789, "verse_number": "६-१३२-११८", "content_sanskrit": "एवं च कर्मणा जीवा नीयंते सर्वयोनिषु ।\nक्रीडता कंदुको यद्वत्प्रेर्यते प्रभुणेच्छया॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7000789118, "chapter_id": 20789, "verse_number": "६-१३२-११९", "content_sanskrit": "कर्मणा वा तथा जंतुर्नीयते सुखदुःखयोः ।\nप्राणी स्वकर्मभिर्बद्धो न शक्तो बंधनिग्रहे॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7000789119, "chapter_id": 20789, "verse_number": "६-१३२-१२०", "content_sanskrit": "देवा वै कर्मभिर्बद्धा ऋषयश्च तथापरे ।\nकैलासे रुद्रदेहस्था भुजंगा विषभोजिनः॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7000789120, "chapter_id": 20789, "verse_number": "६-१३२-१२१", "content_sanskrit": "असमर्थाः सुधा भोक्तुं कर्मयोनिर्बलीयसी ।\nनीरोगदेहदाता यो बुधैः सूर्यो हि कथ्यते॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7000789121, "chapter_id": 20789, "verse_number": "६-१३२-१२२", "content_sanskrit": "तद्रथे सारथिः पंगुः कर्मयोनिर्बलीयसी ।\nइंद्रद्युम्नो हि राजर्षिर्गजत्वं कर्मणा गतः॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7000789122, "chapter_id": 20789, "verse_number": "६-१३२-१२३", "content_sanskrit": "समर्थस्वामिना तस्मिन्कर्मयोनिर्वृथा कृता ।\nरुद्रब्रह्मादयो देवा मानवाश्चासुराश्च ये॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7000789123, "chapter_id": 20789, "verse_number": "६-१३२-१२४", "content_sanskrit": "ते सर्वे कर्मबद्धाश्च विचरंति महीतले ।\nकर्माधीनं जगत्सर्वं विष्णुना निर्मितं पुरा॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7000789124, "chapter_id": 20789, "verse_number": "६-१३२-१२५", "content_sanskrit": "तत्कर्मकेशवाधीनं रामनाम्ना विनश्यति ।\nसर्वत्रापि स्थितं तोयं मुक्तिदं तु सितासिते॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7000789125, "chapter_id": 20789, "verse_number": "६-१३२-१२६", "content_sanskrit": "एवमाचरतां कर्म मुक्तिदं केशवार्चनम् ।\nइंद्रियाणां सुखार्थाय यः कर्म मनसाचरेत्॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7000789126, "chapter_id": 20789, "verse_number": "६-१३२-१२७", "content_sanskrit": "अहं कृतेन मन्येत केवलं देहमेव हि ।\nमनसा संस्मरन्जंतुः प्रायश्चित्तं समाचरेत्॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7000789127, "chapter_id": 20789, "verse_number": "६-१३२-१२८", "content_sanskrit": "स पूर्वकर्मभोक्ता च अग्रे कर्म न वर्द्धते ।\nप्रशंसंति ग्रहान्केचित्केचित्प्रेतपिशाचकान्॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7000789128, "chapter_id": 20789, "verse_number": "६-१३२-१२९", "content_sanskrit": "केचिद्देवान्प्रशंसंति ह्योषधीः केचिदूचिरे ।\nकेचिन्मंत्रं च सिद्धिं च केचिद्बुद्धिपराक्रमम्॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7000789129, "chapter_id": 20789, "verse_number": "६-१३२-१३०", "content_sanskrit": "उद्यमं साहसं धैर्यं केचिन्नीतिं बलं तथा ।\nअहंकर्मप्रशंसाभिः सर्वे कामानुवर्तिनः॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7000789130, "chapter_id": 20789, "verse_number": "६-१३२-१३१", "content_sanskrit": "इति मे निश्चिता बुद्धिः कथ्यते पूर्वसूरिभिः ।\nयदा पुण्यमयो जंतुः पापं किंचिन्नः विद्यते॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7000789131, "chapter_id": 20789, "verse_number": "६-१३२-१३२", "content_sanskrit": "ज्ञानं हि द्विविधं चैव तदा पुण्यं सुखं भवेत् ।\nपापं पुण्यं समं यस्य तदा कर्मसु विद्यते॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7000789132, "chapter_id": 20789, "verse_number": "६-१३२-१३३", "content_sanskrit": "समं योगं यदा द्वंद्वं तदानंदपदं व्रजेत् ।\nबाह्ये सर्वपरित्यागी मनसा संस्पृही भवेत्॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7000789133, "chapter_id": 20789, "verse_number": "६-१३२-१३४", "content_sanskrit": "तद्वृथाचरितं तस्य तेन तत्पापभोगिनः ।\nबाह्ये करोति कर्माणि मनसा निःस्पृहो भवेत्॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7000789134, "chapter_id": 20789, "verse_number": "६-१३२-१३५", "content_sanskrit": "त्यागोऽसौ मध्यमो ज्ञेयो न तु पूर्णफलं लभेत् ।\nबाह्यमध्ये परित्यज्य बुद्ध्या शून्यावलंबनम्॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7000789135, "chapter_id": 20789, "verse_number": "६-१३२-१३६", "content_sanskrit": "त्यागः स उत्तमो ज्ञेयो योगिनामपि दुर्ल्लभः ।\nक्रोधात्सर्वं त्यजंत्येके केचिद्वादप्रभावतः॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7000789136, "chapter_id": 20789, "verse_number": "६-१३२-१३७", "content_sanskrit": "कष्टात्सर्वं त्यजंत्येके त्यागाः सर्वेनुमध्यमाः ।\nसुबुद्ध्या श्रद्धया युक्तो न क्रोधादिवशंगतः॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7000789137, "chapter_id": 20789, "verse_number": "६-१३२-१३८", "content_sanskrit": "कर्मणां ह्यवलिप्तोऽपि सुगतिं याति मानवः ।\nशुचीनां श्रीमतां गेहे धीमतां योगिनामपि॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7000789138, "chapter_id": 20789, "verse_number": "६-१३२-१३९", "content_sanskrit": "योगाद्भ्रष्टस्तु जायेत कुले वै द्विजपूर्वके ।\nस्वल्पेनैव तु कालेन पूर्णं योगं च विंदति॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7000789139, "chapter_id": 20789, "verse_number": "६-१३२-१४०", "content_sanskrit": "चिदानंदपदं गच्छेद्योगभक्तिप्रसादतः ।\nपंकेनैव यथा पंकं रुधिरं रुधिरेण वै॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7000789140, "chapter_id": 20789, "verse_number": "६-१३२-१४१", "content_sanskrit": "हिंसया कर्मणा कर्म कथं क्षालयितुं क्षमः ।\nहिंसाकर्ममयोयज्ञः कथं कर्मक्षये क्षमः॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7000789141, "chapter_id": 20789, "verse_number": "६-१३२-१४२", "content_sanskrit": "स्वर्गकामकृता यज्ञा स्वर्गे ते चाल्पसौख्यदाः ।\nअनित्यानि तु सौख्यानि भवंति च बहून्यपि॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7000789142, "chapter_id": 20789, "verse_number": "६-१३२-१४३", "content_sanskrit": "नित्यं सौख्यं न तेष्वस्ति विना भक्त्या हरेः क्वचित् ।\nसार्वभौमसुखं राज्यं स्वर्गे चापि तथा सुखम्॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7000789143, "chapter_id": 20789, "verse_number": "६-१३२-१४४", "content_sanskrit": "अन्यत्किंचिन्न वांछामि गर्भवासाद्बिभेम्यहम् ।\nग्रावा वै भिद्यते लोहैर्माणिक्यं नैव भिद्यते॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7000789144, "chapter_id": 20789, "verse_number": "६-१३२-१४५", "content_sanskrit": "नानाकाममयी बुद्ध्या विष्णुभक्तिर्न भिद्यते ।\nबको जलचरान्भुंक्ते मंडूकादींश्च वर्जयेत्॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7000789145, "chapter_id": 20789, "verse_number": "६-१३२-१४६", "content_sanskrit": "तथा यमः सर्वहंता वर्जयेत्कृष्णसेवकान् ।\nयो रक्षति स हर्ता च स वै पालक उच्यते॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7000789146, "chapter_id": 20789, "verse_number": "६-१३२-१४७", "content_sanskrit": "अपराधशतैर्युक्तं स्वं स्थाने यत्र वासिता ।\nयथा कृतापराधस्य कृष्णस्तस्य कृपाकरः॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7000789147, "chapter_id": 20789, "verse_number": "६-१३२-१४८", "content_sanskrit": "फलं च लभते वाद्य रक्षकः किं करोति चेत् ।\nएवमात्मा च देहेस्मिन्परवश्यकृपाकरः॥१४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 7000789148, "chapter_id": 20789, "verse_number": "६-१३२-१४९", "content_sanskrit": "प्राप्तो न पारः शनकैर्मल्लैर्युक्ता न वापि ता ।\nव्याधस्य मुक्तिदाता च कुब्जका तारिता स्वयम्॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 7000789149, "chapter_id": 20789, "verse_number": "६-१३२-१५०", "content_sanskrit": "ब्रह्माद्यैर्दुर्लभः स्वप्ने सुलभो गोपमंदिरे ।\nगोपोच्छिष्टं यदा भुक्तं तदा ते तारिताः स्वयम्॥१५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 7000789150, "chapter_id": 20789, "verse_number": "६-१३२-१५१", "content_sanskrit": "योगिभिर्गीयते नित्यं परमात्मा जनार्दनः ।\nअव्ययः पुरुषः श्रीमान्दृष्ट्वा तैर्देवि विस्मये॥१५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 7000789151, "chapter_id": 20789, "verse_number": "६-१३२-१५२", "content_sanskrit": "एतत्स्मरणकं दिव्यं ये पठंति दिने दिने ।\nसर्वपापविनिर्मुक्ता यांति विष्णोः सनातनम्॥१५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 7000789152, "chapter_id": 20789, "verse_number": "६-१३२-१५३", "content_sanskrit": "अनया भावबुद्ध्या च पठनं विष्णुसन्निधौ ।\nइहलोके सुखं भुक्त्वा परं पदमवाप्नुयात्॥१५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}]