[{"id": 2018822, "chapter_id": 1394, "verse_number": "३-३२-०x", "content_sanskrit": "द्रौपद्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2018823, "chapter_id": 1394, "verse_number": "३-३२-१", "content_sanskrit": "नावमन्ये न गर्हे च धर्मं पार्थ कथंचन।\nईश्वरं कुत एवाहमवमंस्ये प्रजापतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2018824, "chapter_id": 1394, "verse_number": "३-३२-२", "content_sanskrit": "आर्ताऽहं प्रलपामीदमिति मां विद्धि भारत।\nभूयश्च विलपिष्यामि सुमनास्त्वं निबोध मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2018825, "chapter_id": 1394, "verse_number": "३-३२-३", "content_sanskrit": "कर्म खल्विह कर्तव्यं जातेनामित्रकर्शन।\nअकर्माणो हि जीवन्ति स्थावरा नेतरे जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2018826, "chapter_id": 1394, "verse_number": "३-३२-४", "content_sanskrit": "आमातृस्तन्यपानाच्च यावच्छय्योपसर्पणम्।\nजङ्गमाः कर्मणा वृत्तिमाप्नुवन्ति युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2018827, "chapter_id": 1394, "verse_number": "३-३२-५", "content_sanskrit": "जङ्गमेषु विशेषेण मनुष्या भरतर्षभ।\nइच्छन्ति कर्मणा वृत्तिमवाप्तुं प्रेत्य चेह च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2018828, "chapter_id": 1394, "verse_number": "३-३२-६", "content_sanskrit": "उत्थानमभिजानन्ति सर्वभूतानि भारत।\nप्रत्यक्षं फलमश्नन्ति कर्मणां लोकसाक्षिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2018829, "chapter_id": 1394, "verse_number": "३-३२-७", "content_sanskrit": "पश्यन्तः स्वं समुत्थानमुपजीवन्ति जन्तरः।\nअपि धाता विधाता च यथाऽयमुदके बकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2018830, "chapter_id": 1394, "verse_number": "३-३२-८", "content_sanskrit": "[अकर्मणां वै भूतानां वृत्तिः स्वान्न हि काचन।\nतदेवाभिप्रपद्येत न विहन्यात्कदाचन ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2018831, "chapter_id": 1394, "verse_number": "३-३२-९", "content_sanskrit": "स्वकर्म कुरु माहासीः कर्मणा भव दंशितः।\nकृत्यं हि योऽभिजानाति सहस्रे सोस्ति नास्ति वां ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2018832, "chapter_id": 1394, "verse_number": "३-३२-१०", "content_sanskrit": "तस्य चापि भवेत्कार्वं विवृद्धौ रक्षणे तथा।\nभक्ष्यमाणो द्यनावाषः क्षीयेत हिमवानपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2018833, "chapter_id": 1394, "verse_number": "३-३२-११", "content_sanskrit": "उत्सीदेरन्प्रजाः सर्वा न कुर्युः कर्म चेद्यदि।\n[तथा ह्येता न वर्धेरन्कर्म चेदफलं भवेत् ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2018834, "chapter_id": 1394, "verse_number": "३-३२-१२", "content_sanskrit": "दृष्ट्वाऽपिच फलं कर्म पश्यामः कुर्वतो जनान्।\nनान्यथा ह्यपि जानन्ति वृत्तिं लोकाः कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2018835, "chapter_id": 1394, "verse_number": "३-३२-१३", "content_sanskrit": "यश्च दिष्टपरो लोके यश्चापि हठवादकः।\nउभावपि शठावेतौ कर्मबुद्धिः प्रशस्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2018836, "chapter_id": 1394, "verse_number": "३-३२-१४", "content_sanskrit": "यो हि दिष्टमुपासीत निर्विचेष्टः सुखं स्वपन्।\nअवसीदेत्सुदुर्बुद्धिरामो घट इवोदके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2018837, "chapter_id": 1394, "verse_number": "३-३२-१५", "content_sanskrit": "तथैव हठबुद्धिर्यः शक्तः कर्मण्यकर्मकृत्।\nआसीत न चिरं जीवेदनाथ इव दुर्बलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2018838, "chapter_id": 1394, "verse_number": "३-३२-१६", "content_sanskrit": "अकस्मादिह यः कश्चिदर्थं प्राप्नोति पूरुषः।\nतं हठेनेति मन्यन्ते स हि यत्नो न कस्यचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2018839, "chapter_id": 1394, "verse_number": "३-३२-१७", "content_sanskrit": "वश्चापि कश्रित्पुरुषो दिष्टं नाम भजत्युत।\nदैवेन विधिना पार्थ तद्दैवमिति निश्चितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2018840, "chapter_id": 1394, "verse_number": "३-३२-१८", "content_sanskrit": "यत्तावस्कर्मणा किंचित्फलमाप्नोति पूरुषः।\nप्रत्यक्षं चक्षुषा दृष्टं तत्पौरुषमिति श्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2018841, "chapter_id": 1394, "verse_number": "३-३२-१९", "content_sanskrit": "स्वभावतः प्रवृत्तो यः प्राप्नोत्यर्थं न कारणात्।\nतत्स्वभावात्प्रकं विद्धि फलं पुरुषसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2018842, "chapter_id": 1394, "verse_number": "३-३२-२०", "content_sanskrit": "एवं हठाच्च दैवाच्च स्वभावात्कर्मणस्तथा।\nयानि प्राप्नोति पुरुषस्तत्फलं पूर्वकर्मणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2018843, "chapter_id": 1394, "verse_number": "३-३२-२१", "content_sanskrit": "धातापि हि स्वकर्मैव तैस्तैर्हेतुभिरीश्वरः।\nविदधाति विभज्येह फलं पूर्वकतं नृणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2018844, "chapter_id": 1394, "verse_number": "३-३२-२२", "content_sanskrit": "यद्धि यः पुरुषः किंचित्कुरुते वै शुभाशुभम्।\nतद्धातृविहितं विद्धि पूर्वकर्मफलोदयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2018845, "chapter_id": 1394, "verse_number": "३-३२-२३", "content_sanskrit": "कारणं तस्य देहोऽयं धातुः कर्मणि कर्मणि।\nस यथा प्रेरयत्येनं तथाऽयं कुरुतेऽवशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2018846, "chapter_id": 1394, "verse_number": "३-३२-२४", "content_sanskrit": "तेषुतेषु हि कृत्येषु विनियोक्ता महेश्वरः।\nसर्वभूतानि कौन्तेय कारयत्यवशान्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2018847, "chapter_id": 1394, "verse_number": "३-३२-२५", "content_sanskrit": "मनसाऽर्थान्विनिश्चित्य पश्चात्प्राप्नोति कर्मणा।\nबुद्धिपूर्वं स्वयं वीर पुरुषस्तत्र कारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2018848, "chapter_id": 1394, "verse_number": "३-३२-२६", "content_sanskrit": "संख्यातुं नैव शक्यानि कर्माणि पुरुषर्षभ।\nअगारनगराणां हि सिद्धिः पुरुषहैतुकी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2018849, "chapter_id": 1394, "verse_number": "३-३२-२७", "content_sanskrit": "तिले तैलं गवि क्षीरं काष्ठे पावकमन्ततः।\nएवं धीरो विजानीयादुपायं चास्य सिद्धये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2018850, "chapter_id": 1394, "verse_number": "३-३२-२८", "content_sanskrit": "ततः प्रवर्तते पश्चात्कारणेष्वस्व सिद्धये।\nतां सिद्धिमुपजीवन्ति कर्मणामिह जन्तवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2018851, "chapter_id": 1394, "verse_number": "३-३२-२९", "content_sanskrit": "कुशलेन कृतं कर्म कर्त्रा साधु स्वनुष्ठितम्।\nइदं त्वकुशलेनेति विशेषादुपलभ्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2018852, "chapter_id": 1394, "verse_number": "३-३२-३०", "content_sanskrit": "इष्टापूर्त्तफलं न स्यान्न शिष्यो न गुरुर्भवेत्।\nपुरुषः कर्मसाध्येषु स्वाच्चेदयमकारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2018853, "chapter_id": 1394, "verse_number": "३-३२-३१", "content_sanskrit": "कर्तृत्वादेव पुरुषः कर्मसिद्धौ प्रशस्यते।\nअसिद्धौ निन्द्यते चापि कर्मनाशः कथं त्विह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2018854, "chapter_id": 1394, "verse_number": "३-३२-३२", "content_sanskrit": "सर्वमेव हठेनैके दैवेनैके वदन्त्युत।\nपुंसः प्रयत्नजं केचिद्दैवमेतद्विशिष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2018855, "chapter_id": 1394, "verse_number": "३-३२-३३", "content_sanskrit": "न चैवैतावता कार्यं मन्यन्त इति चापरे।\nअस्ति सर्वमदृश्यं तु दिष्टं चैव तथा हठः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2018856, "chapter_id": 1394, "verse_number": "३-३२-३४", "content_sanskrit": "दृश्यते हि हठाच्चैव दिष्टाच्चार्थस्य संततिः।\nकिंचिद्दैवाद्धठात्किंचित्किंचिदेव स्वकर्मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2018857, "chapter_id": 1394, "verse_number": "३-३२-३५", "content_sanskrit": "पुरुषः फलमाप्नोति चतुर्थं नात्र कारणम्।\nकुशलाः प्रतिजानन्ति ये वै तत्त्वविदोजनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2018858, "chapter_id": 1394, "verse_number": "३-३२-३६", "content_sanskrit": "तथैव धाता भूतानामिष्टानिष्टफलप्रदः।\nयदि न स्वानन भूतानां कृपणो नाम कश्चन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2018859, "chapter_id": 1394, "verse_number": "३-३२-३७", "content_sanskrit": "यंयमर्थमभिप्रेप्सुः कुरुते कर्म पूरुषः।\nतत्तत्सफलमेव स्याद्यदि न स्यात्पुरा कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2018860, "chapter_id": 1394, "verse_number": "३-३२-३८", "content_sanskrit": "त्रिद्वारामर्थसिद्धिं तु नानुपश्यन्ति ये नराः।\nतथैवानर्थसिद्धिं च यथा लोकास्तथैव ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2018861, "chapter_id": 1394, "verse_number": "३-३२-३९", "content_sanskrit": "कर्तव्यमेव कर्मेति मनोरेष विनिश्चयः।\nएकान्तेन ह्यनीहोऽयं वर्ततेऽस्मासु संप्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2018862, "chapter_id": 1394, "verse_number": "३-३२-४०", "content_sanskrit": "कुर्वतो हि भवत्येव प्रायेणेह युधिष्ठिर।\nएकान्तफलसिद्धिं तु न विन्दत्यलसः क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2018863, "chapter_id": 1394, "verse_number": "३-३२-४१", "content_sanskrit": "असंभवे त्वस्य हेतुः प्रायश्चित्तं तु लक्ष्यते।\nकृतेकर्मणि राजेन्द्र तथाऽनृण्यमवाप्नुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2018864, "chapter_id": 1394, "verse_number": "३-३२-४२", "content_sanskrit": "अलक्ष्मीराविशत्येनं शयानमलसं नरम्।\nनिःसंशयं फलं लब्ध्वा दक्षो भूतिमुपाश्नुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2018865, "chapter_id": 1394, "verse_number": "३-३२-४३", "content_sanskrit": "अनर्थं संशयावस्थं गृणन्त्यामुक्तसशंयाः।\nधीरा नराः कर्मरता न तु निःसंशयाः क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2018866, "chapter_id": 1394, "verse_number": "३-३२-४४", "content_sanskrit": "एकान्ते नह्यनर्थोऽयं वर्ततेऽस्मासु सांप्रतम्।\nस तु निःसंशयं न स्यात्त्वयि कर्मण्यवस्थिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2018867, "chapter_id": 1394, "verse_number": "३-३२-४५", "content_sanskrit": "अथवाऽसिद्धिरेव स्यान्महिमा तु तदेव ते।\nवृकोदरस्य बीभत्सोर्भात्रोश्च यमयोरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2018868, "chapter_id": 1394, "verse_number": "३-३३-४६", "content_sanskrit": "अन्येषां कर्म सफलमस्माकमपि वा पुनः।\nविप्रकर्षेण बुद्ध्येत कृतकर्मा यथा फलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2018869, "chapter_id": 1394, "verse_number": "३-३२-४७", "content_sanskrit": "पृथिवीं लाङ्गलेनेह कृष्ट्वा बीजं वपत्युत।\nआस्तेऽथ कर्षकस्तूष्णीं पर्जन्यस्तत्र कारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2018870, "chapter_id": 1394, "verse_number": "३-३२-४८", "content_sanskrit": "वृष्टिश्चेन्नानुगृह्णीयादनेनास्तत्र कर्षकः।\nयदन्यः पुरुषः कुर्यात्तत्कृतं सफलं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2018871, "chapter_id": 1394, "verse_number": "३-३२-४९", "content_sanskrit": "तच्चेदं फलमस्माकमपराधो न मे क्वचित्।\nइति धीरोऽन्ववेक्ष्यैव नात्मानं तत्रगर्हयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2018872, "chapter_id": 1394, "verse_number": "३-३२-५०", "content_sanskrit": "कुर्वतो नार्थसिद्धिर्मे भवतीति ह भारत।\nनिर्वेदो नात्र गन्तव्यो द्वावन्तौ यस्य कर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2018873, "chapter_id": 1394, "verse_number": "३-३२-५१", "content_sanskrit": "सिद्धिर्वाऽप्यथवाऽसिद्धिरप्रवृत्तिरतोऽन्यथा।\nबहूनां समवाये हि भावानां कर्म सिध्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2018874, "chapter_id": 1394, "verse_number": "३-३२-५२", "content_sanskrit": "गुणाभावे फलं न्यूनं भवत्यफलमेव च।\nअनारम्भे हि न फलं न गुणो दृश्यते क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2018875, "chapter_id": 1394, "verse_number": "३-३२-५३", "content_sanskrit": "देशकालावुपायांश्च मङ्गलं स्वस्तिसिद्धये।\nयुनक्ति मेधया धीरो यथायोगं यथाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2018876, "chapter_id": 1394, "verse_number": "३-३२-५४", "content_sanskrit": "अप्युपायेन तत्कार्यमुपदेष्टा पराक्रमः।\nभूयिष्ठं कर्मयोगेषु सर्व एव पराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2018877, "chapter_id": 1394, "verse_number": "३-३२-५५", "content_sanskrit": "यत्रधीमानवेक्षेत श्रेयासं बहुभिर्गुणैः।\nसाम्नैवार्थं ततो लिप्सेत्कर्म चास्मै प्रयोजयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2018878, "chapter_id": 1394, "verse_number": "३-३२-५६", "content_sanskrit": "व्यसनं नाभिकाङ्क्षेत्त विनाशं वा युधिष्ठिर।\nअपि सिन्धोर्गिरेर्वाऽपि किं पुनर्मर्त्यधर्मिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2018879, "chapter_id": 1394, "verse_number": "३-३२-५७", "content_sanskrit": "उत्थानयुक्तः सततं परेषामन्तरैषणे।\nआनृण्यमाप्नोति नरः परस्यात्मन एव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2018880, "chapter_id": 1394, "verse_number": "३-३२-५८", "content_sanskrit": "न त्वेवात्माऽवमन्तव्यः पुरुषेण कदाचन।\nन ह्यात्मपरिभूतस् भूतिर्भवति शोभना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2018881, "chapter_id": 1394, "verse_number": "३-३२-५९", "content_sanskrit": "एवं संस्थितिका सिद्धिरियं लोकस्य भारत।\nचित्रा सिद्धिगतिः प्रोक्ता कालावस्थाविभागशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2018882, "chapter_id": 1394, "verse_number": "३-३२-६०", "content_sanskrit": "ब्राह्मणं मे पिता पूर्वं वासयामास पण्डितम्।\nसर्वं चार्थमिमं प्राह पित्रे मे भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2018883, "chapter_id": 1394, "verse_number": "३-३२-६१", "content_sanskrit": "नीतिं बृहस्पतिप्रोक्तां भ्रातृन्मेऽग्राहयन्पुरा।\nतेषां सकाशादश्रौषमहमेतां तदा गृहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2018884, "chapter_id": 1394, "verse_number": "३-३२-६२", "content_sanskrit": "स मां राजन्कर्मवतीमागतामाह सान्त्वयन्।\nशुश्रूषमाणामासीनां पितुरङ्के युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2018885, "chapter_id": 1394, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि अर्जुनाभिगमनपर्वणि द्वात्रिंशोऽध्यायः ॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]