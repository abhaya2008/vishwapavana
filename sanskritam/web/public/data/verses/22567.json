[{"id": 7002567000, "chapter_id": 22567, "verse_number": "२-१३-१", "content_sanskrit": "सूत उवाच ।\nअतः परं प्रवक्ष्यामि कुंडानामथ निर्णयम् ।\nतस्योद्धारं च संस्कारं शृणुध्वं द्विजसत्तमाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002567001, "chapter_id": 22567, "verse_number": "२-१३-२", "content_sanskrit": "चतुरस्रं च वृत्तं च पादार्धं चार्धचंद्रकम् ।\nयोन्याकारं चंद्रकं च अष्टार्धमथ पंचमम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002567002, "chapter_id": 22567, "verse_number": "२-१३-३", "content_sanskrit": "सप्तार्धं च नवार्धं च कुंडं दशकमीरितम् ।\nभूमिं संशोध्य विधिवत्तुषकेशादिवर्जिताम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002567003, "chapter_id": 22567, "verse_number": "२-१३-४", "content_sanskrit": "भ्रामयेच्चोर्ध्वतस्तस्या भस्मांगाराणि यत्नतः ।\nअंकुरार्पणकं कुर्यात्सप्ताहादेव बुद्धिमान् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002567004, "chapter_id": 22567, "verse_number": "२-१३-५", "content_sanskrit": "स्थानं विमर्दितं कुर्यात्खनित्वा सेचयेज्जलैः ।\nपुष्टिहस्तोच्छ्रायमितं प्रकुर्यात्परिसूत्रयेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002567005, "chapter_id": 22567, "verse_number": "२-१३-६", "content_sanskrit": "अर्कांगुलमितं सूत्रं चतुरस्रं प्रकल्पयेत् ।\nअष्टादशांगके क्षेत्रे न्यसेदेकं बहिस्ततः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002567006, "chapter_id": 22567, "verse_number": "२-१३-७", "content_sanskrit": "मापयेत्तेन मानेन त्रिवृत्तं कुंडमुज्ज्वलम् ।\nपूर्ववद्विभजेत्क्षेत्रं भागैकं पुरतो न्यसेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002567007, "chapter_id": 22567, "verse_number": "२-१३-८", "content_sanskrit": "वृत्तानि कालिकादीनि बहिस्त्रीणि विवर्जयेत् ।\nपद्मकुंडमिदं प्रोक्तं विलोचनमनोहरम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002567008, "chapter_id": 22567, "verse_number": "२-१३-९", "content_sanskrit": "दशधा भेदयेत्क्षेत्रे उर्ध्वाधोर्ध्वांगुलद्वयम् ।\nसंपरिपातयेत्सूत्रं पाटयेत्तत्प्रमाणतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002567009, "chapter_id": 22567, "verse_number": "२-१३-१०", "content_sanskrit": "पंचधा भेदिते क्षेत्रे कामं वा विभजेत्सुधीः ।\nन्यसेत्पुरस्तादेवांगं कोणार्धार्धप्रमाणतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002567010, "chapter_id": 22567, "verse_number": "२-१३-११", "content_sanskrit": "योनिस्थानं प्रतिष्ठाप्य अश्वत्थस्य दलाकृतिः ।\nसूत्रद्वयं ततो दद्यात्कुंडं परिमितं भवेत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002567011, "chapter_id": 22567, "verse_number": "२-१३-१२", "content_sanskrit": "चतुरस्रं समुद्धृत्य सूत्रं संकल्पयोगतः ।\nदिशं प्रति यथान्यायं पातयेच्च द्विजोत्तमाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002567012, "chapter_id": 22567, "verse_number": "२-१३-१३", "content_sanskrit": "शृंगाटकं युग्मपुटं षडस्रं कुंडत्रयं बुधाः ।\nजलाशयारामकूपे नित्ये गृहमये यथा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002567013, "chapter_id": 22567, "verse_number": "२-१३-१४", "content_sanskrit": "चतुस्रं भवेत्कुंडं द्विजसंस्कारकर्मणि ।\nदेवप्रतिष्ठायागे च गृहवास्तौ चतुर्थकम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002567014, "chapter_id": 22567, "verse_number": "२-१३-१५", "content_sanskrit": "वसुंधरायोगभेदे प्रपंचे वर्तमादिशेत् ।\nसोमेऽष्टौ पंकजं प्रोक्तं नरमेधाश्वमेधयोः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002567015, "chapter_id": 22567, "verse_number": "२-१३-१६", "content_sanskrit": "अंकुरार्पणयागे च वैष्णवे यागकर्मणि ।\nशिवदेव्योश्च जन्मादावष्टम्यां चार्धचंद्रकम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002567016, "chapter_id": 22567, "verse_number": "२-१३-१७", "content_sanskrit": "मार्जारपौष्टिके वैरं रम्ये च शांतिके तथा ।\nशांतिप्रतिष्ठायागे तु शाक्तानां काम्यकर्मणि ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002567017, "chapter_id": 22567, "verse_number": "२-१३-१८", "content_sanskrit": "पुरश्चरणकाम्येषु ज्वरादीनां विमोक्षणे ।\nएवंविधेषु कार्येषु योनिकुंडं प्रशस्यते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002567018, "chapter_id": 22567, "verse_number": "२-१३-१९", "content_sanskrit": "देवतातीर्थयात्रादौ महायुद्धप्रवेशने ।\nसौरे शांते पौष्टिके च षट्पुरं कुंडमुत्तमम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002567019, "chapter_id": 22567, "verse_number": "२-१३-२०", "content_sanskrit": "मारणोच्चाटने चैव तथा रोगोपशांतये ।\nवैष्णवानां कोटिहोमे नृपाणामतिशोचने ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002567020, "chapter_id": 22567, "verse_number": "२-१३-२१", "content_sanskrit": "अष्टास्रमब्जकुंडं च सप्तास्रं निधिसाधने ।\nराज्ञा साध्ये च पंचास्रं कन्याप्राप्तौ त्रिरस्रकम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002567021, "chapter_id": 22567, "verse_number": "२-१३-२२", "content_sanskrit": "यावन्निम्नं भवेदेव विस्तारस्तावदेव तु ।\nकुंडानुरूपतः कार्या मेखला सर्वतो बुधैः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002567022, "chapter_id": 22567, "verse_number": "२-१३-२३", "content_sanskrit": "अयुतादिषु होमेषु मेखलां योजयेत्सुधीः ।\nनिम्न प्रमाणे चात्रापि मूले सार्धांगुलं त्यजेत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002567023, "chapter_id": 22567, "verse_number": "२-१३-२४", "content_sanskrit": "कोणवेदरसैर्मानं यथायोग्यमनुक्रमात् ।\nमुष्टिहस्ते समुत्सेधो सार्धांगुलपरिष्कृतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002567024, "chapter_id": 22567, "verse_number": "२-१३-२५", "content_sanskrit": "अरत्निमात्रे कुंडे तु त्रिश्चैकांगुलतः क्रमात् ।\nएकहस्तमिते कुंडे वेदाग्निनयनांगुलाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002567025, "chapter_id": 22567, "verse_number": "२-१३-२६", "content_sanskrit": "सप्तमेखलकं युक्तं लक्षहोमे न शस्यते ।\nपंचमेखलकं वाथ लक्षकोट्यां च योजयेत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002567026, "chapter_id": 22567, "verse_number": "२-१३-२७", "content_sanskrit": "एकांगुलादिमानेन नेमिं संवर्धयेत्सुधीः ।\nचतुर्हस्तमिते कुंडे तावदेव गुणांगुलाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002567027, "chapter_id": 22567, "verse_number": "२-१३-२८", "content_sanskrit": "वसुहस्ते भानुपंक्तिर्युग्महीनेऽपि ताः क्रमात् ।\nसर्वाः समा ग्रहमखे मेखलाश्च सहस्रके ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002567028, "chapter_id": 22567, "verse_number": "२-१३-२९", "content_sanskrit": "पार्श्वतो योजयेत्तत्र मेखलास्ता यथाक्रमम्  ।\nसार्धांगुलादिमानेन नेमिं संवर्धयेत्सुधीः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002567029, "chapter_id": 22567, "verse_number": "२-१३-३०", "content_sanskrit": "एकमेखलयागेन योजयेच्छक्तिभावतः ।\nहोमाधिक्ये बहुफलमन्यूनं नाधिकं भवेत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002567030, "chapter_id": 22567, "verse_number": "२-१३-३१", "content_sanskrit": "कुंडस्य रूपं जानीयात्परमं प्रकृतेर्वपुः ।\nततो होमे शतगुणं स्थंडिले स्वल्पकं फलम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002567031, "chapter_id": 22567, "verse_number": "२-१३-३२", "content_sanskrit": "षटचतुर्धा गुणायामविस्तारोन्नतिशालिनी ।\nएकांगुलं तु योन्यग्रं कुर्यादीषदधोमुखम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002567032, "chapter_id": 22567, "verse_number": "२-१३-३३", "content_sanskrit": "एकैकांगुलतो योनिं कुंडशून्येषु वर्धयेत् ।\nसममध्ये मेखलायाः सपर्या या सुलक्षणा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002567033, "chapter_id": 22567, "verse_number": "२-१३-३४", "content_sanskrit": "स्थापयेत्कुंडकोणेषु योनिं तां द्विजसत्तमाः ।\nकुंडानां कल्पयेन्नाभिं स्फुटमंबुजसन्निभाम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002567034, "chapter_id": 22567, "verse_number": "२-१३-३५", "content_sanskrit": "तत्तु कुंडानुरूपं वा सुव्यक्तं सुमनोहरम् ।\nयोनिकुंडे योनिमब्जं कुंडे नाभिं च वर्जयेत् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002567035, "chapter_id": 22567, "verse_number": "२-१३-३६", "content_sanskrit": "यावद्द्वयप्रमाणेन अर्धांगुलक्रमाद्बहिः ।\nनाभिं प्रवर्धयेदेकं कुंडानां रूपतो यथा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002567036, "chapter_id": 22567, "verse_number": "२-१३-३७", "content_sanskrit": "तत्र तत्र भवेत्कुंडं बिंबशून्यं न होमयेत् ।\nशिवशक्तिसमायोगात्काम उत्पद्यते यतः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002567037, "chapter_id": 22567, "verse_number": "२-१३-३८", "content_sanskrit": "अवटोपि उमादेवी बिंबः ख्यातः सदाशिवः ।\nन कुर्यादेकया हीनं मरणं च समुद्दिशेत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002567038, "chapter_id": 22567, "verse_number": "२-१३-३९", "content_sanskrit": "त्रयोदशांगुलं हित्वा वह्निहस्तमथापि वा ।\nमहातीर्थे सिद्धक्षेत्रे यत्र शंभुगृहे कुले ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002567039, "chapter_id": 22567, "verse_number": "२-१३-४०", "content_sanskrit": "तस्य दक्षिणदिग्भागे अग्रतो मंडलं लिखेत् ।\nतत्र पूजा प्रकर्तव्या पूर्वमानेन चाश्रयेत् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002567040, "chapter_id": 22567, "verse_number": "२-१३-४१", "content_sanskrit": "अर्कहस्तांतरे कुर्याच्छतोर्ध्वांते शतेन वा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]