[{"id": 7002869000, "chapter_id": 22869, "verse_number": "९-१५४-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nघृतधेनुं प्रवक्ष्यामि तां शृणुष्व नरोत्तम ।\nदीयते येन विधिना यादृग्रूपां च कारयेत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002869001, "chapter_id": 22869, "verse_number": "९-१५४-२", "content_sanskrit": "गव्यस्य सर्पिषः कुम्भान्गंधमाल्यविभूषितान् ।\nकांस्योपदोहसंयुक्तान्सितवस्त्रावगुण्ठितान् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002869002, "chapter_id": 22869, "verse_number": "९-१५४-३", "content_sanskrit": "इक्षुयष्टिमयाः पादाः खुरा रौप्यमयास्तथा ।\nसौवर्णे चाक्षिणी कार्ये शृंगे चागुरुकाष्ठके ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002869003, "chapter_id": 22869, "verse_number": "९-१५४-४", "content_sanskrit": "सप्तधान्यमये पार्श्वे पटोर्णेन च कम्बलम् ।\nकुर्यात्तुरुष्ककर्पूरैर्घ्राणं फलमयान्स्तनान् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002869004, "chapter_id": 22869, "verse_number": "९-१५४-५", "content_sanskrit": "तद्वच्छर्करया जिह्वां गुडक्षीरमयं मुखम् ।\nक्षौमसूत्रेण लांगूलं रोमाणि सितसर्षपैः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002869005, "chapter_id": 22869, "verse_number": "९-१५४-६", "content_sanskrit": "ताम्रपात्रमयं पृष्ठं कुर्याच्छ्रद्धासमन्वितः ।\nईदृग्रूपां तु संकल्प्य घृतधेनुं नराधिप ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002869006, "chapter_id": 22869, "verse_number": "९-१५४-७", "content_sanskrit": "तद्वत्कल्पनया धेनोर्वत्सं च परिकल्पयेत् ।\nमंत्रेणानेन राजेन्द्र तां समभ्यर्च्य बुद्धिमान् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002869007, "chapter_id": 22869, "verse_number": "९-१५४-८", "content_sanskrit": "आज्यं तेजः समुद्दिष्टमाज्यं पापहरं परम् ।\nआज्यं सुराणामाहारः सर्वमाज्ये प्रतिष्ठितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002869008, "chapter_id": 22869, "verse_number": "९-१५४-९", "content_sanskrit": "त्वं चैवाज्यमयी देवि कल्पितासि मया किल ।\nसर्वपापापनोदाय सुखाय भव भामिनि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002869009, "chapter_id": 22869, "verse_number": "९-१५४-१०", "content_sanskrit": "तं च विप्रं महाभाग मनसेव घृतार्चिषा ।\nकल्पयित्वा ततस्तस्मै प्रयतः प्रतिपादयेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002869010, "chapter_id": 22869, "verse_number": "९-१५४-११", "content_sanskrit": "दक्षिणासहिता धेनुः कल्पिताज्यमयी शुभा ।\nएतां ममोपकाराय गृहाण त्वं द्विजोत्तम ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002869011, "chapter_id": 22869, "verse_number": "९-१५४-१२", "content_sanskrit": "इत्युदाहृत्य विप्राय तां गां तु प्रतिपादयेत् ।\nदत्त्वैकरात्रं स्थित्वा च घृताहारो यतव्रतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002869012, "chapter_id": 22869, "verse_number": "९-१५४-१३", "content_sanskrit": "अनेन च विधानेन नवनीतमयी शुभा ।\nदातव्या नृपते धेनुर्न्यूनाधिकविवर्जिता ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002869013, "chapter_id": 22869, "verse_number": "९-१५४-१४", "content_sanskrit": "शृणु पार्थ महाबाहो प्रदानफलमुत्तमम् ।\nघृतक्षीरमहानद्यो यत्र पायसकर्दमाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002869014, "chapter_id": 22869, "verse_number": "९-१५४-१५", "content_sanskrit": "घृतधेनुप्रदा यांति तत्र कामैः सुपूरिताः ।\nपितुरूर्ध्वं च ये सप्त पुरुषास्तस्य येऽप्यधः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002869015, "chapter_id": 22869, "verse_number": "९-१५४-१६", "content_sanskrit": "तांस्तेषु नृप लोकेषु स नयत्यस्तकल्मषान् ।\nसकामानामियं व्युष्टिः कथिता नृपसत्तम ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002869016, "chapter_id": 22869, "verse_number": "९-१५४-१७", "content_sanskrit": "निष्किल्विषं पदं यांति निष्कामा घृतधेनुदाः ।\nघृतमग्निर्घृतं सोमस्तन्मयाः सर्वदेवताः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002869017, "chapter_id": 22869, "verse_number": "९-१५४-१८", "content_sanskrit": "घृतं प्रयच्छतां भीता भवंत्यखिलदेवताः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002869018, "chapter_id": 22869, "verse_number": "९-१५४-१९", "content_sanskrit": "मायाजलं सुतकलत्रमहोर्मिमालं लोभोग्रनक्रविषमं बहुपुण्यभाजः ।\nलग्ना निमग्नवपुषो घृतधेनुपुच्छे संसारसागरमपारमहो तरंति ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]