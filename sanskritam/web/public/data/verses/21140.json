[{"id": 7001140000, "chapter_id": 21140, "verse_number": "२-२-३१-१", "content_sanskrit": "ब्रह्मोवाच ।\nएतस्मिन्नन्तरे तत्र नभोवाणी मुनीश्वर ।\nअवोचच्छृण्वतां दक्षसुरादीनां यथार्थतः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001140001, "chapter_id": 21140, "verse_number": "२-२-३१-२", "content_sanskrit": "व्योमवाण्युवाच ।\nरे रे दक्ष दुराचार दंभाचारपरायण ।\nकिं कृतं ते महामूढ कर्म चानर्थकारकम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001140002, "chapter_id": 21140, "verse_number": "२-२-३१-३", "content_sanskrit": "न कृतं शैवराजस्य दधीचेर्वचनस्य हि ।\nप्रमाणं तत्कृते मूढ सर्वानंदकरं शुभम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001140003, "chapter_id": 21140, "verse_number": "२-२-३१-४", "content_sanskrit": "निर्गतस्ते मखाद्विप्रः शापं दत्त्वा सुदुस्सहम् ।\nततोपि बुद्धं किंचिन्नो त्वया मूढेन चेतसि॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001140004, "chapter_id": 21140, "verse_number": "२-२-३१-५", "content_sanskrit": "ततः कृतः कथं नो वै स्वपुत्र्यास्त्वादरः परः ।\nसमागतायास्सत्याश्च मंगलाया गृहं स्वतः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001140005, "chapter_id": 21140, "verse_number": "२-२-३१-६", "content_sanskrit": "सतीभवौ नार्चितौ हि किमिदं ज्ञानदुर्बल ।\nब्रह्मपुत्र इति वृथा गर्वितोसि विमोहितः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001140006, "chapter_id": 21140, "verse_number": "२-२-३१-७", "content_sanskrit": "सा सत्येव सदाराध्या सर्वा पापफलप्रदा ।\nत्रिलोकमाता कल्याणी शंकरार्द्धांगभागिनी॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001140007, "chapter_id": 21140, "verse_number": "२-२-३१-८", "content_sanskrit": "सा सत्येवार्चिता नित्यं सर्वसौभाग्यदायिनी ।\nमाहेश्वरी स्वभक्तानां सर्वमंगलदायिनी॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001140008, "chapter_id": 21140, "verse_number": "२-२-३१-९", "content_sanskrit": "सा सत्येवार्चिता नित्यं संसारभयनाशिनी ।\nमनोभीष्टप्रदा दैवी सर्वोपद्रवहारिणी॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001140009, "chapter_id": 21140, "verse_number": "२-२-३१-१०", "content_sanskrit": "सा सत्येवार्चिता नित्यं कीर्तिसंपत्प्रदायिनी ।\nपरमा परमेशानी भुक्तिमुक्तिप्रदायिनी॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001140010, "chapter_id": 21140, "verse_number": "२-२-३१-११", "content_sanskrit": "सा सत्येव जगद्धात्री जगद्रक्षणकारिणी ।\nअनादिशक्तिः कल्पान्ते जगत्संहारकारिणी॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001140011, "chapter_id": 21140, "verse_number": "२-२-३१-१२", "content_sanskrit": "सा सत्येव जगन्माता विष्णु माताविलासिनी ।\nब्रह्मेन्द्रचन्द्रवह्न्यर्कदेवादिजननी स्मृता॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001140012, "chapter_id": 21140, "verse_number": "२-२-३१-१३", "content_sanskrit": "सा सत्येव तपोधर्मदातादिफलदायिनी ।\nशंभुशक्तिर्महादेवी दुष्टहंत्री परात्परा॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001140013, "chapter_id": 21140, "verse_number": "२-२-३१-१४", "content_sanskrit": "ईदृग्विधा सती देवी यस्य पत्नी सदा प्रिया ।\nतस्यै भागो न दत्तस्ते मूढेन कुविचारिणा॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001140014, "chapter_id": 21140, "verse_number": "२-२-३१-१५", "content_sanskrit": "शंभुर्हि परमेशानस्सर्वस्वामी परात्परः ।\nविष्णुब्रह्मादिसंसेव्यः सर्वकल्याणकारकः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001140015, "chapter_id": 21140, "verse_number": "२-२-३१-१६", "content_sanskrit": "तप्यते हि तपः सिद्धैरेतद्दर्शनकांक्षिभिः ।\nयुज्यते योगिभिर्योगैरेतद्दर्शनकांक्षिभिः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001140016, "chapter_id": 21140, "verse_number": "२-२-३१-१७", "content_sanskrit": "अनंतधनधान्यानां यागादीनां तथैव च ।\nदर्शनं शंकरस्यैव महत्फलमुदाहृतम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001140017, "chapter_id": 21140, "verse_number": "२-२-३१-१८", "content_sanskrit": "शिव एव जगद्धाता सर्वविद्यापतिः प्रभुः ।\nआदिविद्यावरस्वामी सर्वमंगलमंगलः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001140018, "chapter_id": 21140, "verse_number": "२-२-३१-१९", "content_sanskrit": "तच्छक्तेर्न कृतो यस्मात्सत्करोद्य त्वया खल ।\nअतएवाऽध्वरस्यास्य विनाशो हि भविष्यति॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001140019, "chapter_id": 21140, "verse_number": "२-२-३१-२०", "content_sanskrit": "अमंगलं भवत्येव पूजार्हाणामपूजया ।\nपूज्यमाना च नासौ हि यतः पूज्यतमा शिवा॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001140020, "chapter_id": 21140, "verse_number": "२-२-३१-२१", "content_sanskrit": "सहस्रेणापि शिरसां शेषो यत्पादजं रजः ।\nवहत्यहरहः प्रीत्या तस्य शक्तिः शिवा सती॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001140021, "chapter_id": 21140, "verse_number": "२-२-३१-२२", "content_sanskrit": "यत्पादपद्ममनिशं ध्यात्वा संपूज्य सादरम् ।\nविष्णुविष्णुत्वमापन्नस्तस्य शंभोः प्रिया सती॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001140022, "chapter_id": 21140, "verse_number": "२-२-३१-२३", "content_sanskrit": "यत्पादपद्ममनिशं ध्यात्वा संपूज्य सादरम् ।\nब्रह्मा ब्रह्मत्वमापन्नस्तस्य शंभोः प्रिया सती॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001140023, "chapter_id": 21140, "verse_number": "२-२-३१-२४", "content_sanskrit": "यत्पादपद्ममनिशं ध्यात्वा संपूज्य सादरम् ।\nइन्द्रादयो लोकपालाः प्रापुस्स्वं स्वं परं पदम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001140024, "chapter_id": 21140, "verse_number": "२-२-३१-२५", "content_sanskrit": "जगत्पिता शिवश्शक्तिर्जगन्माता च सा सती ।\nसत्कृतौ न त्वया मूढ कथं श्रेयो भविष्यति॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001140025, "chapter_id": 21140, "verse_number": "२-२-३१-२६", "content_sanskrit": "दौर्भाग्यं त्वयि संक्रांतं संक्रांतास्त्वयि चापदः ।\nयौ चानाराधितौ भक्त्या भवानीशंकरौ च तौ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001140026, "chapter_id": 21140, "verse_number": "२-२-३१-२७", "content_sanskrit": "अनभ्यर्च्य शिवं शंभुं कल्याणं प्राप्नुयामिति ।\nकिमस्ति गर्वो दुर्वारस्स गर्वोद्य विनश्यति॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001140027, "chapter_id": 21140, "verse_number": "२-२-३१-२८", "content_sanskrit": "सर्वेशविमुखो भूत्वा देवेष्वेतेषु कस्तव ।\nकरिष्यति सहायं तं न ते पश्यामि सर्वथा॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001140028, "chapter_id": 21140, "verse_number": "२-२-३१-२९", "content_sanskrit": "यदि देवाः करिष्यंति साहाय्यमधुना तव ।\nतदा नाशं समाप्स्यंति शलभा इव वह्निना॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001140029, "chapter_id": 21140, "verse_number": "२-२-३१-३०", "content_sanskrit": "ज्वलत्वद्य मुखं ते वै यज्ञध्वंसो भवत्वति ।\nसहायास्तव यावंतस्ते ज्वलंत्वद्य सत्वरम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001140030, "chapter_id": 21140, "verse_number": "२-२-३१-३१", "content_sanskrit": "अमराणां च सर्वेषां शपथोऽमंगलाय ते ।\nकरिष्यंत्यद्य साहाय्यं यदेतस्य दुरात्मनः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001140031, "chapter_id": 21140, "verse_number": "२-२-३१-३२", "content_sanskrit": "निर्गच्छंत्वमरास्स्वोकमेतदध्वरमंडपात् ।\nअन्यथा भवतो नाशो भविष्यत्यद्य सर्वथा॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001140032, "chapter_id": 21140, "verse_number": "२-२-३१-३३", "content_sanskrit": "निर्गच्छंत्वपरे सर्वे मुनिनागादयो मखात् ।\nअन्यथा भवतां नाशो भविष्यत्यद्य सर्वथा॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001140033, "chapter_id": 21140, "verse_number": "२-२-३१-३४", "content_sanskrit": "निर्गच्छ त्वं हरे शीघ्रमेतदध्वरमंडपात् ।\nअन्यथा भवतो नाशो भविष्यत्यद्य सर्वथा॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001140034, "chapter_id": 21140, "verse_number": "२-२-३१-३५", "content_sanskrit": "निर्गच्छ त्वं विधे शीघ्रमेतदध्वरमंडपात् ।\nअन्यथा भवतो नाशो भविष्यत्यद्य सर्वथा॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001140035, "chapter_id": 21140, "verse_number": "२-२-३१-३६", "content_sanskrit": "ब्रह्मोवाच ।\nइत्युक्त्वाध्वरशालायामखिलायां सुसंस्थितान् ।\nव्यरमत्सा नभोवाणी सर्वकल्याणकारिणी॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001140036, "chapter_id": 21140, "verse_number": "२-२-३१-३७", "content_sanskrit": "तच्छ्रुत्वा व्योमवचनं सर्वे हर्यादयस्सुराः ।\nअकार्षुर्विस्मयं तात मुनयश्च तथा परे॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]