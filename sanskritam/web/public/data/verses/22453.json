[{"id": 7002453000, "chapter_id": 22453, "verse_number": "१-११५-१", "content_sanskrit": "ब्रह्मोवाच ।\nप्रशंसन्ति महात्मानः संवादं भास्कराश्रयम् ।\nगौतम्या सह कौशल्या सुमनायां सुरालये ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002453001, "chapter_id": 22453, "verse_number": "१-११५-२", "content_sanskrit": "स्वर्गेऽतिशोभनां दृष्ट्वा कौशल्यां पतिना सह ।\nब्राह्मणी गौतमी नाम पर्यपृच्छत विस्मिता ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002453002, "chapter_id": 22453, "verse_number": "१-११५-३", "content_sanskrit": "गौतम्युवाच ।\nशतशः सन्ति कौशल्ये देवाः स्वर्गनिवासिनः ।\nदेवपत्न्यस्तथैवैताः सिद्धाः सिद्धाङ्गनास्तथा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002453003, "chapter_id": 22453, "verse_number": "१-११५-४", "content_sanskrit": "न तेषामीदृशो गन्धो न कान्तिर्न सुरूपता ।\nन वाससी शोभने ये यथा ते पतिना सह ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002453004, "chapter_id": 22453, "verse_number": "१-११५-५", "content_sanskrit": "नैवाभरणजातानि तेषां भ्राजन्ति वै तथा ।\nयथा तव यथा पत्युर्न च स्वर्गनिवासिनाम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002453005, "chapter_id": 22453, "verse_number": "१-११५-६", "content_sanskrit": "सुस्नातचैलतश्चैव युवयोरतिरिच्यते ।\nलेखाद्यानामपीशानां क्षयातिशयवर्जितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002453006, "chapter_id": 22453, "verse_number": "१-११५-७", "content_sanskrit": "तपःप्रभावो दानं वा होमो वा कर्मसंज्ञितः ।\nयुवयोर्यत्समाचक्ष्व तत्सर्वं वरवर्णिनि ।\nयेन मे विक्रमे बुद्धिर्मनुजा येन सङ्गताः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002453007, "chapter_id": 22453, "verse_number": "१-११५-८", "content_sanskrit": "कौशल्योवाच ।\nयज्ञो यज्ञेश्वरो भानुरावाभ्यां जातु तोषितः ।\nस्वर्गप्राप्तिरियं तस्य कर्मणः फलमुत्तमम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002453008, "chapter_id": 22453, "verse_number": "१-११५-९", "content_sanskrit": "सुरूपता ततः प्रीतिः पश्यतां चारुवेषिता ।\nयत्पृच्छसि महाभागे तदप्येषां वदामि ते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002453009, "chapter_id": 22453, "verse_number": "१-११५-१०", "content_sanskrit": "तीर्थोदकैस्तथा गन्धैः स्नापितो यद्दिवाकरः ।\nतेन कान्तिरियं नित्यं देवांस्त्रिभुवनेश्वरान् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002453010, "chapter_id": 22453, "verse_number": "१-११५-११", "content_sanskrit": "मनःप्रसादः सौम्यत्वं शरीरे ये च निर्वृताः ।\nयत्प्रियत्वं च सर्वं स्यात्तद्घृतस्नपनात्फलम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002453011, "chapter_id": 22453, "verse_number": "१-११५-१२", "content_sanskrit": "यान्यभीष्टानि वासांसि यच्चाभीष्टविभूषणम् ।\nरत्नानि यान्यभीष्टानि यत्प्रियं चानुलेपनम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002453012, "chapter_id": 22453, "verse_number": "१-११५-१३", "content_sanskrit": "ये धृता यानि माल्यानि दयितान्यभवन्सदा ।\nमम भर्तुस्तदैवास्य तदा राज्यं प्रशासतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002453013, "chapter_id": 22453, "verse_number": "१-११५-१४", "content_sanskrit": "तानि सर्वाणि सर्वज्ञ सर्वपातरि भानुनि ।\nदत्तानि तं समुत्थोऽयं गन्धधूपात्मको गुणः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002453014, "chapter_id": 22453, "verse_number": "१-११५-१५", "content_sanskrit": "आहारा दयिता ये च पवित्राश्च निवेदिताः ।\nत्रिलोककर्तुः सवितुस्तृप्तिस्तद्गुणसम्भवा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002453015, "chapter_id": 22453, "verse_number": "१-११५-१६", "content_sanskrit": "स्वर्गकामेन मे भर्त्रा मया च शुभदर्शने ।\nकृतमेतत्कृतेनाभूदावयोर्भवसंक्षयः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002453016, "chapter_id": 22453, "verse_number": "१-११५-१७", "content_sanskrit": "ये त्वकामा नराः सम्यक्तत्कुर्वन्ति च शोभने ।\nतेषां ददाति विश्वेशो भगवान्मुक्तिमीश्वरः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002453017, "chapter_id": 22453, "verse_number": "१-११५-१८", "content_sanskrit": "ब्रह्मोवाच ।\nएवमभ्यर्च्य मार्तण्डमर्कं देवेश्वरं गुरुम् ।\nप्राप्तोऽस्म्यभिमतान्कामान्कृष्णाहं शाश्वतीः समाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002453018, "chapter_id": 22453, "verse_number": "१-११५-१९", "content_sanskrit": "चन्दनागुरुकर्पूरकुङ्कुमोशीरपद्मकैः ।\nअनुलिप्तो नरैर्भक्त्या ददाति१ सागरोद्भवाम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002453019, "chapter_id": 22453, "verse_number": "१-११५-२०", "content_sanskrit": "कालेयकं तुरुष्कं च रक्तचन्दनमेव च ।\nयान्यात्मनि सदेष्टानि तानि शस्यान्यपाकुरु ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002453020, "chapter_id": 22453, "verse_number": "१-११५-२१", "content_sanskrit": "गन्धाश्चापि शुभा ये च धूपा ये विजयोदयाः ।\nदिवाकरस्य धर्मज्ञ निवेद्यास्सर्वदाच्युत ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002453021, "chapter_id": 22453, "verse_number": "१-११५-२२", "content_sanskrit": "न दद्यात्सल्लकीक्षारं नो मुखेन च संहृतम् ।\nदद्यादर्काय धर्मज्ञ धूपमाराधनोद्यतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002453022, "chapter_id": 22453, "verse_number": "१-११५-२३", "content_sanskrit": "मालती मल्लिका चैव यूथिका चातिमुक्तिकः ।\nपाटलाः करवीरश्च जपा सेवन्तिरेव च ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002453023, "chapter_id": 22453, "verse_number": "१-११५-२४", "content_sanskrit": "कुङ्कुमस्तगरश्चैव कर्णिकारः सकेशरः ।\nचम्पकः केतक कुन्दो बाणबर्बरमालिका ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002453024, "chapter_id": 22453, "verse_number": "१-११५-२५", "content_sanskrit": "अशोकस्तिलको लोध्रस्तथा चैवाटरूषकः ।\nशतपत्राणि धन्यानि बकाह्वानी विशेषतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002453025, "chapter_id": 22453, "verse_number": "१-११५-२६", "content_sanskrit": "अगस्तिं किंशुकं तद्वत्पूजार्थं भास्करस्य तु ।\nअमी पुष्पप्रकारास्तु शस्ता भास्करपूजने ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002453026, "chapter_id": 22453, "verse_number": "१-११५-२७", "content_sanskrit": "बिल्वपत्रं शमीपत्रं पत्रं वा भृङ्गरस्य च ।\nतमालपत्रं च हरे सदैव भगवत्प्रियम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002453027, "chapter_id": 22453, "verse_number": "१-११५-२८", "content_sanskrit": "तुलसी कालतुलसी तथा रक्तं च चन्दनम् ।\nकेतकी पत्रपुष्पं तु सद्यस्तुष्टिकरं रवेः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002453028, "chapter_id": 22453, "verse_number": "१-११५-२९", "content_sanskrit": "पद्मोत्पलसमुत्थानि रक्तं नीलोत्पलं तथा ।\nसितोत्पलं तु भानोस्तु दयितानि सदाच्युत ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002453029, "chapter_id": 22453, "verse_number": "१-११५-३०", "content_sanskrit": "कृष्णलोकन्मत्तकं कान्तं तथैव गिरिमल्लिका ।\nन कर्णिकारिकापुष्पं भास्कराय निवेदयेत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002453030, "chapter_id": 22453, "verse_number": "१-११५-३१", "content_sanskrit": "कुटजं शाल्मलीपुष्पं तथान्यद्गन्धवर्जितम् ।\nनिवेदितं भयं रोगं निःस्वतां च प्रयच्छति ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002453031, "chapter_id": 22453, "verse_number": "१-११५-३२", "content_sanskrit": "येषां न प्रतिषेधोऽस्ति गन्धवर्णान्वितानि च ।\nतानि पुष्पाणि देयानि मानवे लोकभानवे ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002453032, "chapter_id": 22453, "verse_number": "१-११५-३३", "content_sanskrit": "सुगन्धैश्च मुरामांसीकर्पूरागरुचन्दनैः ।\nतथान्यैश्च शुभैर्द्रव्यैरर्चयेद्वनमालिनम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002453033, "chapter_id": 22453, "verse_number": "१-११५-३४", "content_sanskrit": "दुकूलपट्टकौशेयवार्क्षकार्पासकादिभिः ।\nवासोभिः पूजयेद्भानुं यानि चात्मप्रियाणि तु ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002453034, "chapter_id": 22453, "verse_number": "१-११५-३५", "content_sanskrit": "भक्ष्याणि यान्यभीष्टानि भोज्यान्यभिमतानि च ।\nफलं च वल्लभं यत्स्यात्तत्ते देयं दिवाकरे ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002453035, "chapter_id": 22453, "verse_number": "१-११५-३६", "content_sanskrit": "सुवर्णमणिमुक्तानि रजतं च तथाच्युत ।\nदक्षिणा विविधा चेह यच्चान्यदपि वल्लभम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002453036, "chapter_id": 22453, "verse_number": "१-११५-३७", "content_sanskrit": "आत्मानं भास्करं मत्वा यज्ञं तस्मै निवेदयेत् ।\nतत्तदव्यक्तरूपाय भास्कराय निवेदयेत् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]