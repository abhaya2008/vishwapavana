[{"id": 2132260, "chapter_id": 3859, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2132261, "chapter_id": 3859, "verse_number": "१", "content_sanskrit": "भूय एव महाभाग्यं ब्राह्मणानां निबोध मे ।\nवैन्यो नामेह राजर्षिरश्वमेधाय दीक्षितः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2132262, "chapter_id": 3859, "verse_number": "२", "content_sanskrit": "तमत्रिर्गन्तुमारेभे वित्तार्थमिति नः श्रुतम् ।\nभूयोऽर्थं नानुरुध्यत् स धर्मव्यक्तिनिदर्शनात् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2132263, "chapter_id": 3859, "verse_number": "३", "content_sanskrit": "स विचिन्त्य महातेजा वनमेवान्वरोचयत् ।\nधर्मपत्नीं समाहूय पुत्रांश्चेदमुवाच ह \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2132264, "chapter_id": 3859, "verse_number": "", "content_sanskrit": "प्राप्स्यामः फलमत्यन्तं बहुलं निरुपद्रवम् ।\nअरण्यगमनं क्षिप्रं रोचतां वो गुणाधिकम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2132265, "chapter_id": 3859, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2132266, "chapter_id": 3859, "verse_number": "४", "content_sanskrit": "तं भार्या प्रत्युवाचाथ धर्ममेवानुतन्वती \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2132267, "chapter_id": 3859, "verse_number": "५", "content_sanskrit": "वैन्यं गत्वा महात्मानमर्थयस्व धनं बहु \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2132268, "chapter_id": 3859, "verse_number": "६", "content_sanskrit": "स ते दास्यति राजर्षिर्यजमानोऽर्थितो धनम् ।\nतत आदाय विप्रर्षे प्रतिगृह्य धनं बहु ।\nभृत्यान् सुतान् संविभज्य ततो व्रज यथेप्सितम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2132269, "chapter_id": 3859, "verse_number": "७", "content_sanskrit": "एष वै परमो धर्मो धर्मविद्भिरुदाहृतः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2132270, "chapter_id": 3859, "verse_number": "", "content_sanskrit": "अत्रिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2132271, "chapter_id": 3859, "verse_number": "८", "content_sanskrit": "कथितो मे महाभागे गौतमेन महात्मना ।\nवैन्यो धर्मार्थसंयुक्तः सत्यव्रतसमन्वितः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2132272, "chapter_id": 3859, "verse_number": "९", "content_sanskrit": "द्वेष्टारः किन्तु नः सन्ति वसन्तस्तत्र वै द्विजाः ।\nयथा मे गौतमः प्राह ततो न व्यवसाम्यहम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2132273, "chapter_id": 3859, "verse_number": "१०", "content_sanskrit": "तत्र स्म वाचं कल्याणीं धर्मकामार्थसंहिताम् ।\nमयोक्तामन्यथा ब्रूयुस्ततस्ते वै निरर्थिकाम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2132274, "chapter_id": 3859, "verse_number": "११", "content_sanskrit": "गमिष्यामि महाप्राज्ञे रोचते मे वचस्तव ।\nगाश्च मे दास्यते वैन्यः प्रभूतं चार्थसञ्चयम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2132275, "chapter_id": 3859, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2132276, "chapter_id": 3859, "verse_number": "१२", "content_sanskrit": "एवमुक्त्वा जगामाशु वैन्ययज्ञं महातपाः ।\nगत्वा च यज्ञायतनमत्रिस्तुष्टाव तं नृपम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2132277, "chapter_id": 3859, "verse_number": "", "content_sanskrit": "राजन् धन्यस्त्वमीशश्च भुवि त्वं प्रथमो नृपः ।\nस्तुवन्ति त्वां मुनिगणास्त्वदन्यो नास्ति धर्मवित् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2132278, "chapter_id": 3859, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2132279, "chapter_id": 3859, "verse_number": "१३", "content_sanskrit": "तमब्रवीदृषिः क्रुद्धो वचनं वै महातपाः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2132280, "chapter_id": 3859, "verse_number": "", "content_sanskrit": "गौतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2132281, "chapter_id": 3859, "verse_number": "१४", "content_sanskrit": "मैवमत्रे पुनर्ब्रूया न ते प्रज्ञा समाहिता ।\nअत्र नः प्रथमं स्थाता महेन्द्रो वै प्रजापतिः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2132282, "chapter_id": 3859, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2132283, "chapter_id": 3859, "verse_number": "१५", "content_sanskrit": "अथात्रिरपि राजेन्द्र गौतमं प्रत्यभाषत \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2132284, "chapter_id": 3859, "verse_number": "१६", "content_sanskrit": "अयमेव विधाता हि यथैवेन्द्रः प्रजापतिः ।\nत्वमेव मुह्यसे मोहान्न प्रज्ञानं तवास्ति ह \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2132285, "chapter_id": 3859, "verse_number": "", "content_sanskrit": "गौतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2132286, "chapter_id": 3859, "verse_number": "१७", "content_sanskrit": "जानामि नाहं मुह्यामि त्वमेवात्र विमुह्यते ।\nस्तौषि त्वं दर्शनप्रेप्सू राजानं जनसंसदि\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2132287, "chapter_id": 3859, "verse_number": "१८", "content_sanskrit": "न वेत्थ परमं धर्मं न चावैषि प्रयोजनम् ।\nबालस्त्वमसि मूढश्च वृद्धः केनापि हेतुना\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2132288, "chapter_id": 3859, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2132289, "chapter_id": 3859, "verse_number": "१९", "content_sanskrit": "विवदन्तौ तथा तौ तु मुनीनां दर्शने स्थितौ ।\nये तस्य यज्ञे संवृत्तास्तेऽपृच्छन्त कथं त्विमौ\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2132290, "chapter_id": 3859, "verse_number": "२०", "content_sanskrit": "प्रवेशः केन दत्तोऽयमुभयोर्वैन्यसंसदि ।\nउच्चैः समभिभाषन्तौ केन कार्येण धिष्ठितौ \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2132291, "chapter_id": 3859, "verse_number": "२१", "content_sanskrit": "ततः परमधर्मात्मा काश्यपः सर्वधर्मवित् ।\nविवादिनावनुप्राप्तौ तावुभौ प्रत्यवेदयत् ।\nअथाब्रवीत् सदस्यांस्तु गौतमो मुनिसत्तमान् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2132292, "chapter_id": 3859, "verse_number": "२२", "content_sanskrit": "आवयोर्व्याहृतं प्रश्नं शृणुत द्विजसत्तमाः ।\nवैन्यं विधातेत्याहात्रिरत्र नौ संशयो महान्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2132293, "chapter_id": 3859, "verse_number": "२३", "content_sanskrit": "ततस्तद्गौतमेनोक्तं वाक्यं वैन्यस्य संसदि ।\nश्रुत्वैव तु महात्मानो मुनयोऽभ्यद्रवन् द्रुतम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2132294, "chapter_id": 3859, "verse_number": "२४", "content_sanskrit": "सनत्कुमारं धर्मज्ञं संशयच्छेदनाय वै ।\nपप्रच्छुः प्रणताः सर्वे ब्रह्माणमिव सोमपाः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2132295, "chapter_id": 3859, "verse_number": "२५", "content_sanskrit": "स च तेषां वचः श्रुत्वा यथातत्त्वं महातपाः ।\nप्रत्युवाचाथ तानेव धर्मार्थसहितं वचः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2132296, "chapter_id": 3859, "verse_number": "२६", "content_sanskrit": "ब्रह्म क्षत्रेण सहितं क्षत्रं च ब्रह्मणा सह ।\nराजा वै प्रथितो धर्मः प्रजानां पतिरेव च \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2132297, "chapter_id": 3859, "verse_number": "२७", "content_sanskrit": "स एव शक्रः शुक्रश्च स धाता च बृहस्पतिः ।\nसंयुक्तौ दहतः शत्रून् वनानीवाग्निमारुतौ ।\nप्रजापतिर्विराट् सम्राट् क्षत्रियो भूपतिर्नृपः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2132298, "chapter_id": 3859, "verse_number": "२८", "content_sanskrit": "य एभिः स्तूयते शब्दैः कस्तं नार्चितुमर्हति\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2132299, "chapter_id": 3859, "verse_number": "२९", "content_sanskrit": "पुरायोनिर्युधाजिच्च सुभिक्षान्न्युचितोद्भवः ।\nस्वर्णेता सहजिद् बभ्रुरिति राजाभिधीयते ।\nसत्ययोनिः पुराविच्च सत्यधर्मप्रवर्तकः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2132300, "chapter_id": 3859, "verse_number": "३०", "content_sanskrit": "पुरा यो ब्रह्मणा सृष्टः प्रजानां परिपालने ।\nदुष्टानां निग्रहं कर्ता स च राजाभिधीयते \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2132301, "chapter_id": 3859, "verse_number": "३१", "content_sanskrit": "सत्यं मन्युर्दया रक्षा धर्माधर्मविलोकनम् ।\nविद्यन्ते यस्य चाराश्च स राजेत्यभिधियते \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2132302, "chapter_id": 3859, "verse_number": "३२", "content_sanskrit": "अधर्मादृषयो भीता बलं क्षत्रे समादधन् ।\nतस्माद्धि ब्रह्मणा क्षत्रं क्षत्रेण ब्रह्म चाव्ययम् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2132303, "chapter_id": 3859, "verse_number": "३३", "content_sanskrit": "आदित्यो दिवि देवेषु तमो नुदति तेजसा ।\nतथैव नृपतिर्भूमावधर्मान् नुदते भृशम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2132304, "chapter_id": 3859, "verse_number": "३४", "content_sanskrit": "ततो राज्ञः प्रधानत्वं शास्त्रप्रामाण्यदर्शनात् ।\nउत्तरः सिद्ध्यते पक्षो येन राजेति भाषितम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2132305, "chapter_id": 3859, "verse_number": "", "content_sanskrit": "अत्रिणा व्याहृतं पूर्वं तत् तथैव न चान्यथा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2132306, "chapter_id": 3859, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2132307, "chapter_id": 3859, "verse_number": "३५", "content_sanskrit": "ततः स राजा संहृष्टः सिद्धे पक्षे महामनाः ।\nतमत्रिमब्रवीत् प्रीतः पूर्वं येनाभिसंस्तुतः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2132308, "chapter_id": 3859, "verse_number": "", "content_sanskrit": "वैन्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2132309, "chapter_id": 3859, "verse_number": "३६", "content_sanskrit": "यस्मात् पूर्वं मनुष्येषु ज्यायांसं मामिहाब्रवीः ।\nसर्वदेवैश्च विप्रर्षे सम्मितं श्रेष्ठमेव च \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2132310, "chapter_id": 3859, "verse_number": "३७", "content_sanskrit": "तस्मात् तेऽहं प्रदास्यामि विविधं वसु भूरि च ।\nदासीसहस्रं श्यामानां सुवस्त्राणामलङ्कृतम् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2132311, "chapter_id": 3859, "verse_number": "३८", "content_sanskrit": "दशकोटीर्हिरण्यस्य रुक्मभारांस्तथा दश ।\nएतद् ददामि विप्रर्षे सर्वज्ञस्त्वं हि मे मतः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2132312, "chapter_id": 3859, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2132313, "chapter_id": 3859, "verse_number": "३९", "content_sanskrit": "तदत्रिर्न्यायतः सर्वं प्रतिगृह्याभिसत्कृतः ।\nप्रत्युज्जगाम तेजस्वी गृहानेव महातपाः \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2132314, "chapter_id": 3859, "verse_number": "४०", "content_sanskrit": "प्रदाय च धनं प्रीतः पुत्रेभ्यः प्रयतात्मवान् ।\nतपः समभिसन्धाय वनमेवान्वपद्यत\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2132315, "chapter_id": 3859, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि अशीत्य- धिकशततमो अध्यायः ॥ १८०॥ मार्कण्डेयसमस्यापर्वणि पञ्चमोध्यायः ॥५॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]