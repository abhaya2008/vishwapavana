[{"id": 2196887, "chapter_id": 5187, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2196888, "chapter_id": 5187, "verse_number": "१", "content_sanskrit": "एवं भगवतः कृष्णात् श्रुत्वा सर्वं युधिष्ठिरः ।\nशरतल्पगतं भीष्मं भूयः पप्रच्छ भूपते\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2196889, "chapter_id": 5187, "verse_number": "२", "content_sanskrit": "आत्मन्यग्नीन् समाधाय य एते कुरुनन्दन ।\nद्विजातयो व्रतोपेता जपयज्ञपरायणाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2196890, "chapter_id": 5187, "verse_number": "३", "content_sanskrit": "यजन्त्यारम्भयज्ञैश्च मानसं यज्ञमास्थिता ।\nअग्निभ्यश्च परं नास्ति येषामेषा व्यवस्थितिः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2196891, "chapter_id": 5187, "verse_number": "४", "content_sanskrit": "तेषां गतिर्महाप्राज्ञ कीदृशी किंपराश्च ते ।\nएतदिच्छामि तत्त्वेन त्वत्तः श्रोतुं पितामह\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2196892, "chapter_id": 5187, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2196893, "chapter_id": 5187, "verse_number": "५", "content_sanskrit": "अत्र ते वर्तयिष्यामि इतिहासं पुरातनम् ।\nवैकुण्ठस्य च संवादं सुपर्णस्य च भारत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2196894, "chapter_id": 5187, "verse_number": "६", "content_sanskrit": "अमृतस्य समुत्पत्तौ देवानामसुरैः सह ।\nषष्टिं वर्षसहस्राणि देवासुरमवर्तत\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2196895, "chapter_id": 5187, "verse_number": "७", "content_sanskrit": "तत्र देवास्तु दैतेयैर्वध्यन्ते भृशदारुणैः ।\nत्रातारं नाधिगच्छन्ति वध्यमाना महासुरैः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2196896, "chapter_id": 5187, "verse_number": "८", "content_sanskrit": "आर्तास्ते देवदेवेशं प्रपन्नाः शरणैषिणः ।\nपितामहं महाप्राज्ञ वध्यमाना सुरेतरैः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2196897, "chapter_id": 5187, "verse_number": "९", "content_sanskrit": "ता दृष्ट्वा देवता ब्रह्मा सन्त्रस्तेन्द्रियमानसाः ।\nवैकुण्ठं शरणं देवं प्रतिपेदे च तैः सह\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2196898, "chapter_id": 5187, "verse_number": "१०", "content_sanskrit": "ततः स देवैः सहितः पद्मयोनिर्नरेश्वर ।\nतुष्टाव प्राञ्जलिर्भूत्वा नारायणमनामयम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2196899, "chapter_id": 5187, "verse_number": "११", "content_sanskrit": "त्वद्रूपचिन्तनान्नाम्नां स्मरणादर्चनादपि ।\nतपोयोगादिभिश्चैव श्रेयो यान्ति मनीषिणः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2196900, "chapter_id": 5187, "verse_number": "१२", "content_sanskrit": "भक्तवत्सल पद्माक्ष परमेश्वर पापहन् ।\nपरमात्माविकाराद्य नारायण नमोस्तु ते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2196901, "chapter_id": 5187, "verse_number": "१३", "content_sanskrit": "नमस्ते सर्वलोकादे सर्वात्मामितविक्रम ।\nसर्वभूतभविष्येश सर्वभूतमहेश्वर\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2196902, "chapter_id": 5187, "verse_number": "१४", "content_sanskrit": "देवानामपि देवस्त्वं सर्वविद्यापरायणः ।\nजगद्बीजसमाहारो जगतः परमो ह्यसि\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2196903, "chapter_id": 5187, "verse_number": "१५", "content_sanskrit": "त्रायस्व देवता वीर दानवाद्यैः सुपीडिता ।\nलोकांश्च लोकपालांश्च ऋषींश्च जयतांवर\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2196904, "chapter_id": 5187, "verse_number": "१६", "content_sanskrit": "वेदाः साङ्गोपनिषदः सरहस्याः ससङ्ग्रहाः ।\nसोङ्काराः सवषट्काराः प्राहुस्त्वां यज्ञमुत्तमम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2196905, "chapter_id": 5187, "verse_number": "१७", "content_sanskrit": "पवित्राणां पवित्रं च मङ्गलानां च मङ्गलम् ।\nतपस्विनां तपश्चैव दैवतं देवतास्वपि\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2196906, "chapter_id": 5187, "verse_number": "१८", "content_sanskrit": "एवमादिपुरस्कारैर्ऋक्सामयजुषां गणैः ।\nवैकुण्ठं तुष्टुवुर्देवाः सर्वे ब्रह्मर्षिभिः सह\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2196907, "chapter_id": 5187, "verse_number": "१९", "content_sanskrit": "ततोऽन्तरिक्षे वागासीन्मेघगम्भीरनिस्वना ।\nजेष्यध्वं दानवान् यूयं मयैव सह सङ्गरे\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2196908, "chapter_id": 5187, "verse_number": "२०", "content_sanskrit": "ततो देवगणानां च दानवानां च युद्ध्यताम् ।\nप्रादुरासीन्महातेजा शार्ङ्गचक्रगदाधरः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2196909, "chapter_id": 5187, "verse_number": "२१", "content_sanskrit": "सुपर्णपृष्ठमास्थाय तेजसा प्रदहन्निव ।\nव्यधमद् दानवान् सर्वान् बाहुद्रविणतेजसा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2196910, "chapter_id": 5187, "verse_number": "२२", "content_sanskrit": "तं समासाद्य समरे दैत्यदानवपुङ्गवाः ।\nव्यनश्यन्त महाराज पतङ्गा इव पावकम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2196911, "chapter_id": 5187, "verse_number": "२३", "content_sanskrit": "स विजित्यासुरान् सर्वान् दानवांश्च महामतिः ।\nपश्यतामेव देवानां तत्रैवान्तरधीयत\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2196912, "chapter_id": 5187, "verse_number": "२४", "content_sanskrit": "तं दृष्ट्वाऽन्तर्हितं देवं विष्णुं देवामितद्युतिम् ।\nविस्मयोत्फुल्लनयना ब्रह्माणमिदमब्रुवन्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2196913, "chapter_id": 5187, "verse_number": "२५", "content_sanskrit": "भगवन् सर्वलोकेश सर्वलोकपितामह ।\nइदमत्यद्भुतं वृत्तं तन्नः शंसितुमर्हसि\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2196914, "chapter_id": 5187, "verse_number": "२६", "content_sanskrit": "देवासुरेऽस्मिन् सङ्ग्रामे त्राता येन वयं विभो ।\nएतद् विज्ञातुमिच्छामः कुतोऽसौ कश्च तत्त्वतः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2196915, "chapter_id": 5187, "verse_number": "२७", "content_sanskrit": "कोऽयमस्मान् परित्राय तूष्णीमेव यथागतम् ।\nप्रतिप्रयातो दिव्यात्मा तं नः शंसितुमर्हसि\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2196916, "chapter_id": 5187, "verse_number": "२८", "content_sanskrit": "एवमुक्तः सुरैः सर्वैर्वचनं वचनार्थवित् ।\nउवाच पद्मनाभस्य पूर्वरूपं प्रति प्रभो\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2196917, "chapter_id": 5187, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2196918, "chapter_id": 5187, "verse_number": "२९", "content_sanskrit": "न ह्येनं वेद तत्त्वेन भुवनं भुवनेश्वरम् ।\nसङ्ख्यातुं नैव चात्मानं निर्गुणं गुणिनां वरम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2196919, "chapter_id": 5187, "verse_number": "३०", "content_sanskrit": "अत्र वो वर्तयिष्यामि इतिहासं पुरातनम् ।\nसुपर्णस्य च संवादमृषीणां चापि देवताः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2196920, "chapter_id": 5187, "verse_number": "३१", "content_sanskrit": "पुरा ब्रह्मर्षयश्चैव सिद्धाश्च भुवनेश्वरम् ।\nआश्रित्य हिमवत्पृष्ठे चक्रिरे विविधाः कथाः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2196921, "chapter_id": 5187, "verse_number": "३२", "content_sanskrit": "तेषां कथयतां तत्र कथान्ते पततांवरः ।\nप्रादुरासीत् महातेजा वाहश्चक्रगदाभृतः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2196922, "chapter_id": 5187, "verse_number": "३३", "content_sanskrit": "स तान् ऋषीन् समासाद्य विनयावनताननः ।\nअवतीर्य महावीर्यस्तानृषीनभिजग्मिवान्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2196923, "chapter_id": 5187, "verse_number": "३४", "content_sanskrit": "अभ्यर्चितः स ऋषिभिः स्वागतेन महाबलः ।\nउपाविशत तेजस्वी भूमौ वेगवतांवरः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2196924, "chapter_id": 5187, "verse_number": "३५", "content_sanskrit": "तमासीनं महात्मानं वैनतेयं महाद्युतिम् ।\nऋषयः परिपप्रच्छुर्महात्मानस्तपस्विनः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2196925, "chapter_id": 5187, "verse_number": "३६", "content_sanskrit": "कौतूहलं वैनतेय परं नो हृदि वर्तते ।\nतस्य नान्योऽस्ति वक्तेह त्वामृते पन्नगाशन\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2196926, "chapter_id": 5187, "verse_number": "३७", "content_sanskrit": "तदाख्यातुमिहेच्छामो भवता प्रश्नमुत्तमम् ।\nएवमुक्तः प्रत्युवाच प्राञ्जलिर्विनतासुतः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2196927, "chapter_id": 5187, "verse_number": "३८", "content_sanskrit": "धन्योऽस्म्यनुगृहीतोऽस्मि यन्मां ब्रह्मर्षिसत्तमाः ।\nप्रष्टव्यं प्रष्टुमिच्छन्ति प्रीतिमन्तोऽनसूयकाः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2196928, "chapter_id": 5187, "verse_number": "३९", "content_sanskrit": "किं मया ब्रूत वक्तव्यं कार्यं च वदतांवराः ।\nयूयं हि मां यथायुक्तं सर्वं वै प्रष्टुमर्हथ\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2196929, "chapter_id": 5187, "verse_number": "४०", "content_sanskrit": "नमस्कृत्वा ह्यनन्ताय ततस्ते ऋषिसत्तमाः ।\nप्रष्टुं प्रचक्रमुस्तत्र वैनतेयं महाबलम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2196930, "chapter_id": 5187, "verse_number": "४१", "content_sanskrit": "देवदेवं महात्मानं नारायणमनामयम् ।\nभवानुपास्ते वरदं कुतोऽसौ कश्च तत्त्वतः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2196931, "chapter_id": 5187, "verse_number": "४२", "content_sanskrit": "प्रकृतिर्विकृतिर्वाऽस्य कीदृशी क्व नु संस्थितिः ।\nएतद् भवन्तं पृच्छामो देवोऽयं क्व कृतालयः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2196932, "chapter_id": 5187, "verse_number": "४३", "content_sanskrit": "एष भक्तप्रियो देवः प्रियभक्तस्तथैव च ।\nत्वं प्रियश्चास्य भक्तश्च नान्यः काश्यप विद्यते\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2196933, "chapter_id": 5187, "verse_number": "४४", "content_sanskrit": "मुष्णन्निव मनश्चक्षूंष्यविभाव्यतनुर्विभुः ।\nअनादिमध्यनिधनो न विद्मैनं कुतो ह्यसौ\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2196934, "chapter_id": 5187, "verse_number": "४५", "content_sanskrit": "वेदेष्वपि च विश्वात्मा गीयते न च विद्महे ।\nतत्त्वतस्तत्त्वभूतात्मा विभुर्नित्यः सनातनः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2196935, "chapter_id": 5187, "verse_number": "४६", "content_sanskrit": "पृथिवी वायुराकाशमापो ज्योतिश्च पञ्चमम् ।\nगुणाश्चैषां यथासङ्ख्यं भावाभावौ तथैव च\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2196936, "chapter_id": 5187, "verse_number": "४७", "content_sanskrit": "तमः सत्वं रजश्चैव भावाश्चैव तदात्मकाः ।\nमनो बुद्धिश्च तेजश्च बुद्धिगम्यानि तत्त्वतः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2196937, "chapter_id": 5187, "verse_number": "४८", "content_sanskrit": "जायन्ते तात कस्माद्धि तिष्ठते तेष्वसौ विभुः ।\nसञ्चित्य बहुधा बुद्ध्या नाध्यवस्यामहे परम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2196938, "chapter_id": 5187, "verse_number": "४९", "content_sanskrit": "तस्य देवस्य तत्त्वेन तन्नः शंस यथातथम् ।\nएतमेव परं प्रश्नं कौतूहलसमन्विताः ।\nएवं भवन्तं पृच्छामस्तन्नः शंसितुमर्हसि\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2196939, "chapter_id": 5187, "verse_number": "", "content_sanskrit": "सुपर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2196940, "chapter_id": 5187, "verse_number": "५०", "content_sanskrit": "स्थूलतो यस्तु भगवांस्तेनैव स्वेन हेतुना ।\nत्रैलोक्यस्य तु रक्षार्थं दृश्यते रूपमास्थितः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2196941, "chapter_id": 5187, "verse_number": "५१", "content_sanskrit": "मया तु महदाश्चर्यं पुरा दृष्टं सनातने ।\nदेवे श्रीवृक्षनिलये तच्छृणुध्वमशेषतः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2196942, "chapter_id": 5187, "verse_number": "५२", "content_sanskrit": "न स्म शक्तो मया वेत्तुं न भवद्भिः कथञ्चन ।\nयथा मां प्राह भगवांस्तथा तच्छ्रूयतां मम\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2196943, "chapter_id": 5187, "verse_number": "५३", "content_sanskrit": "मयाऽमृतं देवतानां मिषतामृषिसत्तमाः ।\nहृतं विपाट्य तद्यन्त्रं विद्राव्यामृतरक्षिणः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2196944, "chapter_id": 5187, "verse_number": "५४", "content_sanskrit": "देवता विमुखीकृत्य सेन्द्राः समरुतो मृधे ।\nउन्मथ्याशु गिरींश्चैव विमोक्ष्य च महोदधिम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2196945, "chapter_id": 5187, "verse_number": "५५", "content_sanskrit": "तं दृष्ट्वा मम विक्रान्तं वागुवाचाशरीरिणी ।\nप्रीतोऽस्मि ते वैनतेय कर्मणाऽनेन सुव्रत\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2196946, "chapter_id": 5187, "verse_number": "५६", "content_sanskrit": "अवृथा तेऽस्तु मद्वाक्यं ब्रूहि किं करवाणि ते ।\nतामेवंवादिनीं वाचमहं प्रत्युक्तवांस्तदा\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2196947, "chapter_id": 5187, "verse_number": "५७", "content_sanskrit": "ज्ञातुमिच्छामि कस्त्वं हि ततो मे दास्यसे वरम् ।\nप्रकृतिर्विकृतिर्वा त्वं देवो वा दानवोऽपि वा\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2196948, "chapter_id": 5187, "verse_number": "५८", "content_sanskrit": "ततो जलदगम्भीरं प्रहस्य गदतांवरः ।\nउवाच वरदः प्रीतः काले त्वं माऽभिवेत्स्यति\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2196949, "chapter_id": 5187, "verse_number": "५९", "content_sanskrit": "वाहनं भव मे साधो वरं दद्मि तवोत्तमम् ।\nन ते वीर्येण सदृशः कश्चिल्लोके भविष्यति\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2196950, "chapter_id": 5187, "verse_number": "६०", "content_sanskrit": "पतङ्ग पततांश्रेष्ठ न देवो नापि दानवः ।\nमत्सखित्वमनुप्राप्तो दुर्धर्षश्च भविष्यति\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2196951, "chapter_id": 5187, "verse_number": "६१", "content_sanskrit": "तमब्रवं देवदेवं मामेवंवादिनं परम् ।\nप्रयतः प्राञ्जलिर्भूत्वा प्रणम्य शिरसा विभुम्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2196952, "chapter_id": 5187, "verse_number": "६२", "content_sanskrit": "एवमेतन्महाबाहो सर्वमेतद् भविष्यति ।\nवाहनं ते भविष्यामि यथा वदसि मां भवान्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2196953, "chapter_id": 5187, "verse_number": "६३", "content_sanskrit": "ममापि च महाबुद्धे निश्चयं श्रूयतामिति ।\nध्वजस्तेऽहं भविष्यामि रथस्थस्य न संशयः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2196954, "chapter_id": 5187, "verse_number": "६४", "content_sanskrit": "तथास्त्विति स मामुक्त्वा भूयः प्राह महामनाः ।\nन ते गतिविघातोऽद्य भविष्यत्यमृतं विना\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2196955, "chapter_id": 5187, "verse_number": "६५", "content_sanskrit": "एवं कृत्वा तु समयं देवदेवः सनातनः ।\nमामुक्त्वा साधयस्वेति यथाभिप्रायतो गतः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2196956, "chapter_id": 5187, "verse_number": "६६", "content_sanskrit": "ततोऽहं कृतसंवादो तेन केनापि सत्तमाः ।\nकौतूहलसमाविष्टः पितरं काश्यपं गतः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2196957, "chapter_id": 5187, "verse_number": "६७", "content_sanskrit": "सोऽहं पितरमासाद्य प्रणिपत्याभिवाद्य च ।\nसर्वमेतद् यथातथ्यमुक्तवान् पितुरन्तिके\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2196958, "chapter_id": 5187, "verse_number": "६८", "content_sanskrit": "श्रुत्वा तु भगवान् मह्यं ध्यानमेवान्वपद्यत ।\nस मुहूर्तमिव ध्यात्वा मामाह वदतांवरः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2196959, "chapter_id": 5187, "verse_number": "६९", "content_sanskrit": "धन्योऽस्यनुगृहीतश्च यत्त्वं तेन महात्मना ।\nसंवादं कृतवांस्तात गुह्येन परमात्मना\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2196960, "chapter_id": 5187, "verse_number": "७०", "content_sanskrit": "स्थूलदृश्यः स भगवांस्तेन तेनैव हेतुना ।\nदृश्यतेऽव्यक्तरूपस्थः प्रधानं प्रभवाप्ययः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2196961, "chapter_id": 5187, "verse_number": "७१", "content_sanskrit": "मया हि स महातेजा नान्ययोगसमाधिना ।\nतपसोग्रेण तेजस्वी तोषितस्तपसां निधिः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2196962, "chapter_id": 5187, "verse_number": "७२", "content_sanskrit": "ततो मे दर्शयामास तोषयन्निव पुत्रक ।\nश्वेतपीतारुणनिभः कद्रूकपिलपिङ्गलः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2196963, "chapter_id": 5187, "verse_number": "७३", "content_sanskrit": "रक्तनीलासितनिभः सहस्रोदरपाणिमान् ।\nद्विसाहस्रमहावक्त्र एकाक्षः शतलोचनः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2196964, "chapter_id": 5187, "verse_number": "७४", "content_sanskrit": "अनिष्यन्दा निराहाराः समानाः सूर्यतेजसा ।\nतमुपासन्ति परमं गुह्यमक्षरमव्ययम्\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2196965, "chapter_id": 5187, "verse_number": "७५", "content_sanskrit": "समासाद्य तु तं विश्वमहं मूर्ध्ना प्रणम्य च ।\nऋग्यजुःसामभिः स्तुत्वा शरण्यं शरणं गतः\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2196966, "chapter_id": 5187, "verse_number": "७६", "content_sanskrit": "महामेघौघधीरेण स्वरेण जयतांवरः ।\nआभाष्य पुत्र पुत्रेति इदमाह ध्रुवं वचः\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2196967, "chapter_id": 5187, "verse_number": "७७", "content_sanskrit": "त्वयाऽभ्युदयकामेन तपश्चीर्णं महामुने ।\nअमुक्तस्त्वं न मां सङ्गैरविमुक्तोऽद्य पश्यसि\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2196968, "chapter_id": 5187, "verse_number": "७८", "content_sanskrit": "यदा सङ्गैर्विमुक्तश्च गतमोहो गतस्पृहः ।\nभविष्यसि तदा ब्रह्म मामनुध्यास्यसे द्विज\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2196969, "chapter_id": 5187, "verse_number": "७९", "content_sanskrit": "एकान्तिकीं मतिं कृत्वा मद्भक्तो मत्परायणः ।\nज्ञास्यसे मां ततो ब्रह्मन् वीतमोहश्च तत्त्वतः\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2196970, "chapter_id": 5187, "verse_number": "८०", "content_sanskrit": "तेन त्वं कृतसंवादः स्वतः सर्वहितैषिणा ।\nविश्वरूपेण देवेन पुरुषेण महात्मना\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2196971, "chapter_id": 5187, "verse_number": "८१", "content_sanskrit": "तमेवाराधय क्षिप्रं तमाराध्य न सीदसि ।\nसोऽहमेवं भगवता पित्रा ब्रह्मर्षिसत्तमाः ।\nअनुनीतो यथान्यायं स्वमेव भवनं गतः\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2196972, "chapter_id": 5187, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे गरुडकाश्यपसमागमो नाम अष्टत्रिंशोऽध्यायः ॥३८॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}]