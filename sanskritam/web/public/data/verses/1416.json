[{"id": 2019945, "chapter_id": 1416, "verse_number": "३-५४-०x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2019946, "chapter_id": 1416, "verse_number": "३-५४-१", "content_sanskrit": "अथ काले शुभे प्राप्ते तथौ पुण्ये क्षणे तथा।\nआजुहाव महीपालान्भीमो राजा स्वयंवरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2019947, "chapter_id": 1416, "verse_number": "३-५४-२", "content_sanskrit": "तच्छ्रुत्वा पृथिवीपालाः सर्वे हृच्छयपीडिताः।\nत्वरिताः समपाजग्मुर्दमयन्तीमभीप्सवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2019948, "chapter_id": 1416, "verse_number": "३-५४-३", "content_sanskrit": "कनकस्तम्भरुचिरं तोरणेन विराजितम्।\nविविशुस्ते नृपा रङ्गं महासिंह इवाचलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2019949, "chapter_id": 1416, "verse_number": "३-५४-४", "content_sanskrit": "तत्रासनेषु विविधेष्वासीनाः पृथिवीक्षितः।\nसुरभिस्रग्धराः सर्वे प्रमृष्टमणिकुण्डलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2019950, "chapter_id": 1416, "verse_number": "३-५४-५", "content_sanskrit": "संपूर्णां पुरुषव्याघ्रैर्व्याघ्रैर्गिरिगुहामिव।\n`प्रविवेश नलो देवैः पुण्यश्लोको नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2019951, "chapter_id": 1416, "verse_number": "३-५४-६", "content_sanskrit": "तत्र स्म पीना दृश्यन्ते बाहवः परिघोपमाः।\nआकारवर्णसुश्लक्ष्णाः पञ्चशीर्षा इवोरगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2019952, "chapter_id": 1416, "verse_number": "३-५४-७", "content_sanskrit": "सुकेशान्तानि चारूणि सुनासानि शुभानि च।\nमुखानि राज्ञां शोभन्ते नक्षत्राणि यथा दिवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2019953, "chapter_id": 1416, "verse_number": "३-५४-८", "content_sanskrit": "दमयन्ती ततो रङ्गं प्रविवेश शुभानना।\nमुष्णन्ती प्रभया राज्ञां चक्षूषि च मनांसि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2019954, "chapter_id": 1416, "verse_number": "३-५४-९", "content_sanskrit": "तस्या गात्रेषु पतिता तेषां दृष्टिर्महात्मनाम्।\nतत्रतत्रैव सक्ताऽभून्न चचाल च पश्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2019955, "chapter_id": 1416, "verse_number": "३-५४-१०", "content_sanskrit": "ततः संकीर्त्यमानेषु राज्ञां नामसु भारत।\nददर्श भैमी पुरुषान्पञ्च तुल्याकृतीनिह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2019956, "chapter_id": 1416, "verse_number": "३-५४-११", "content_sanskrit": "तान्समीक्ष्य ततः सर्वान्निर्विशेषाकृतीन्स्थितान्।\nसंदेहादथ वेदर्भी नाभ्यजानान्नलं नृपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2019957, "chapter_id": 1416, "verse_number": "३-५४-१२", "content_sanskrit": "`निर्विशेषवयोवेषरूपाणां तत्र सा शुभा।\nयंयं हि ददृशे तेषां तंतं मेने नलं नृपम्।\nसाचिन्तयन्ती बुद्ध्याऽथ तर्कयामास भामिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2019958, "chapter_id": 1416, "verse_number": "३-५४-१३", "content_sanskrit": "कथं नु देवाञ्जानीयां कथं विद्यां नलं नृपम्।\nएवं संचिन्तयन्ती सा वैदर्भी भृशदुःखिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2019959, "chapter_id": 1416, "verse_number": "३-५४-१४", "content_sanskrit": "श्रुतानि देवलिङ्गानि तर्कयामास भारत।\nदेवानां यानि लिङ्गानि स्थविरेभ्यः श्रुतानि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2019960, "chapter_id": 1416, "verse_number": "३-५४-१५", "content_sanskrit": "तानीह तिष्ठतां भूमावेकस्यापि न लक्षये।\nएवं विचिन्त्य बहुधा विचार्य च पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2019961, "chapter_id": 1416, "verse_number": "३-५४-१६", "content_sanskrit": "शरणं प्रति देवानां प्राप्तकालममन्यत।\nवाचा च मनसा चैव नमस्कारं प्रयुज्य सा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2019962, "chapter_id": 1416, "verse_number": "३-५४-१७", "content_sanskrit": "देवेभ्यः प्राञ्जलिर्भूत्वा वेपमानेदमब्रवीत्।\nहंसानां वचनं श्रुत्वा यथा मे नैषधो वृतः।\nपतित्वे तेन सत्येन देवास्तं प्रदिशन्तु मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2019963, "chapter_id": 1416, "verse_number": "३-५४-१८", "content_sanskrit": "मनसा वचसा चैव यथा नातिचराम्यहम्।\nतेन सत्येन विबुधास्तमेव प्रदिशन्तु मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2019964, "chapter_id": 1416, "verse_number": "३-५४-१९", "content_sanskrit": "यथा देवैः स मे भर्ता विहितो निषधाधिषः।\nतेन सत्येन मे देवास्तमेव प्रदिशन्तु मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2019965, "chapter_id": 1416, "verse_number": "३-५४-२०", "content_sanskrit": "यथेदं व्रतमारब्धं नलस्याराधने मया।\nतेन सत्येन मे देवास्तमेव प्रदिशन्तु मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2019966, "chapter_id": 1416, "verse_number": "३-५४-२१", "content_sanskrit": "स्वं चैव रूपं पुष्यन्तु लोकपाला महेश्वराः।\nयथाऽहमभिजानीयां पुण्यश्लोकं नराधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2019967, "chapter_id": 1416, "verse_number": "३-५४-२२", "content_sanskrit": "निशम्य दमयन्त्यास्तत्करुणं प्रतिदेवितम्।\nनिश्चयंपरमं तथ्यमनुरागं च नैषधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2019968, "chapter_id": 1416, "verse_number": "३-५४-२३", "content_sanskrit": "मनोविशुद्धिं बुद्धिं च भक्तिं रागं च नैषधे।\nयथोक्तं चक्रिरे देवाः सामर्थ्यं लिङ्गधारणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2019969, "chapter_id": 1416, "verse_number": "३-५४-२४", "content_sanskrit": "साऽपश्यद्विबुधान्सर्वानस्वेदान्स्तब्धलोचनान्।\nअम्लानस्रग्रजोहीनान्स्थितानस्पृशतः क्षितिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2019970, "chapter_id": 1416, "verse_number": "३-५४-२५", "content_sanskrit": "छायाद्वितीयो म्लानस्रग्रजःस्वेदसमन्वितः।\nभूमिष्ठो नैषधश्चैव निमेषेण च सूचितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2019971, "chapter_id": 1416, "verse_number": "३-५४-२६", "content_sanskrit": "सा समीक्ष्य तु तान्देवान्पुण्यश्लोकं च भारत।\nनैषधं वरयामास भैमी धर्मेण पाण्डव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2019972, "chapter_id": 1416, "verse_number": "३-५४-२७", "content_sanskrit": "विलज्जमाना वस्त्रान्तं जग्राहायतलोचना।\nस्कन्धदेशेऽसृजत्तस्य स्रजं परमशोभनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2019973, "chapter_id": 1416, "verse_number": "३-५४-२८", "content_sanskrit": "वरयामास चैवैनं पतित्वे वरवर्णिनी।\nततो हाहेति सहसा मुक्तः शब्दो नराधिपैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2019974, "chapter_id": 1416, "verse_number": "३-५४-२९", "content_sanskrit": "देवैर्महर्षिभिस्तत्र साधुसाध्विति भारत।\nविस्मितैरीरितः शब्दः प्रशंसद्भिर्नलं नृपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2019975, "chapter_id": 1416, "verse_number": "३-५४-३०", "content_sanskrit": "दमयन्तीं तु कौरव्य वीरसेनसुतो नृपः।\nआश्वासयद्वरारोहां प्रहृष्टेनान्तरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2019976, "chapter_id": 1416, "verse_number": "३-५४-३१", "content_sanskrit": "यत्त्वं भजसि कल्याणि पुमांसं देवसन्निधौ।\nतस्मान्मां विद्धि भर्तारमेतत्ते वचने रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2019977, "chapter_id": 1416, "verse_number": "३-५४-३२", "content_sanskrit": "यावच्च मे धरिष्यन्ति प्राणा देहे शुचिस्मिते।\nतावत्त्वयि भविष्यामि सत्यमेतद्ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2019978, "chapter_id": 1416, "verse_number": "३-५४-३३", "content_sanskrit": "दमयन्ती तथा वाग्भिरभिनन्द्य कृताञ्जलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2019979, "chapter_id": 1416, "verse_number": "३-५४-३४", "content_sanskrit": "तौ परस्परतः प्रीतौ दृष्ट्वा त्वग्निपुरोगमान्।\nतानेव शरणं देवाञ्जग्मतुर्मनसा तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2019980, "chapter_id": 1416, "verse_number": "३-५४-३५", "content_sanskrit": "वृते तु नैषधे भैम्या लोकपाला महौजसः।\nप्रहृष्टमनसः सर्वे नलायाष्टौ वरान्ददुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2019981, "chapter_id": 1416, "verse_number": "३-५४-३६", "content_sanskrit": "प्रत्यक्षदर्शनं यज्ञे गतिं चानुत्तमां शुभाम्।\nनैषधाय ददौ शक्रः प्रीयमाणः शचीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2019982, "chapter_id": 1416, "verse_number": "३-५४-३७", "content_sanskrit": "अग्निरात्मभवं प्रादाद्यत्र वाञ्छति नैषधः।\nलोकानात्मप्रभांश्चैव ददौ तस्मै हुताशनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2019983, "chapter_id": 1416, "verse_number": "३-५४-३८", "content_sanskrit": "यमस्त्वन्नरसं प्रादाद्धर्मे च परमां स्थितिम्।\nअपांपतिरपां भावं यत्रवाञ्छति नैपधः ॥\nस्रजश्चोत्तमगन्धाढ्याः सर्वेच मिथुनं ददुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2019984, "chapter_id": 1416, "verse_number": "३-५४-३९", "content_sanskrit": "वरानेवं प्रदायास्य देवास्ते त्रिदिवं गताः।\n`एतत्सर्वं नलोऽपश्यद्दमयन्ती च भारत।\nयथा स्वप्नं महाराज तथैव ददृशुर्जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2019985, "chapter_id": 1416, "verse_number": "३-५४-४०", "content_sanskrit": "ततः स्वयवरं चक्रे भीमो राजाऽतिमानुषम्।\nसमागतेषु सर्वेषु भूपालेसु विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2019986, "chapter_id": 1416, "verse_number": "३-५४-४१", "content_sanskrit": "दमयन्त्यपि तद्दृष्ट्वाराजमण्डलमृद्धिमत्।\nअन्वीक्ष्यनैषधं वव्रे भैमी धर्मेण भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2019987, "chapter_id": 1416, "verse_number": "३-५४-४२", "content_sanskrit": "वृते च नैषधे भैम्या निवृत्ते च स्वयंवरे।\nसर्व एव महीपालाः प्रतिजग्मुर्यथागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2019988, "chapter_id": 1416, "verse_number": "३-५४-४३", "content_sanskrit": "पार्थिवाश्चानुभूयास्य विवाहं विस्मयान्विताः।\nदमयन्त्याश्च मुदिताः प्रतिजग्मुर्यथागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2019989, "chapter_id": 1416, "verse_number": "३-५४-४४", "content_sanskrit": "गतेषु पार्थिवेन्द्रेषु भीमः प्रीतो महामनाः।\nविवाहं कारयामास दमयन्त्या नलस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2019990, "chapter_id": 1416, "verse_number": "३-५४-४५", "content_sanskrit": "उष्य तत्र तथाकामं नैषधो द्विपदांवरः।\nभीमेन समनुज्ञातो जगाम नगरं स्वकम्।\nअवाप्य नारीरत्नं तु पुण्यश्लोकोपि पार्थिवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2019991, "chapter_id": 1416, "verse_number": "३-५४-४६", "content_sanskrit": "रेमे सह तया राजञ्छच्येव बलवृत्रहा।\nअतीव मुदितो राजा भ्राजमानोंशुमानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2019992, "chapter_id": 1416, "verse_number": "३-५४-४७", "content_sanskrit": "अरञ्जयत्प्रजा वीरो धर्मेण परिपालयन्।\nईजे चाप्यश्वमेधेन ययातिरिव नाहुषः।\nअन्यैश्च बहुभिर्धीमान्क्रतुभिश्चाप्तदक्षिणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2019993, "chapter_id": 1416, "verse_number": "३-५४-४८", "content_sanskrit": "पुगश्च रमणीयेषु वनेषूपवनेषु च।\nदमयन्त्या सह नलो विजहारामरोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2019994, "chapter_id": 1416, "verse_number": "३-५४-४९", "content_sanskrit": "जनयामास च ततो दमयन्त्यां महामनाः।\nइन्द्रसेनं सुतं चापि इन्द्रसेनां चकन्यकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2019995, "chapter_id": 1416, "verse_number": "३-५४-५०", "content_sanskrit": "एवं स यजमानश्च विहरंश्च नराधिपः।\nररक्ष वसुसंपूर्णां वसुधां वसुधाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2019996, "chapter_id": 1416, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि नलोपाख्यानपर्वणि चतुःपञ्चाशोऽध्यायः ॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]