[{"id": 2170421, "chapter_id": 4639, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2170422, "chapter_id": 4639, "verse_number": "१", "content_sanskrit": "ततः श्वेताश्वसंयुक्ते नारायणसमाहिते ।\nतिष्ठन् रथवरे श्रीमानर्जुनः समपद्यत\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2170423, "chapter_id": 4639, "verse_number": "२", "content_sanskrit": "तद्बलं नृपतिश्रेष्ठ तावकं विजयो रणे ।\nव्यक्षोभयदुदीर्णाश्वं महोदधिमिवानिलः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2170424, "chapter_id": 4639, "verse_number": "३", "content_sanskrit": "दुर्योधनस्तव सुतः प्रमथन् वैरिवाहिनीम् ।\nअभ्ययात् सहसा क्रुद्धः सैन्यार्धेनापि संवृतः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2170425, "chapter_id": 4639, "verse_number": "४", "content_sanskrit": "पर्यवारयदायान्तं युधिष्ठिरममर्षणः ।\nक्षुरप्राणां त्रिसप्तत्या ततोऽविध्यत पाण्डवम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2170426, "chapter_id": 4639, "verse_number": "५", "content_sanskrit": "अक्रुध्यत भृशं तत्र कुन्तीपुत्रो युधिष्ठिरः ।\nस भल्लांस्त्रिंशतस्तूर्णं तव पुत्रे न्यवेशयत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2170427, "chapter_id": 4639, "verse_number": "६", "content_sanskrit": "ततोऽधावन्त कौरव्या जिघृक्षन्तो युधिष्ठिरम् ।\nदुष्टभावान् परान् ज्ञात्वा समवेता महारथाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2170428, "chapter_id": 4639, "verse_number": "७", "content_sanskrit": "आजग्मुस्तं परीप्सन्तः कुन्तीपुत्रं युधिष्ठिरम् ।\nनकुलः सहदेवश्च धृष्टद्युम्नश्च पार्षतः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2170429, "chapter_id": 4639, "verse_number": "८", "content_sanskrit": "अक्षोहिण्या परिवृतास्तेऽभ्यधावन् युधिष्ठिरम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2170430, "chapter_id": 4639, "verse_number": "९", "content_sanskrit": "भीमसेनश्च समरे मृद्नंस्तव महारथान् ।\nअभ्यधावदभिप्रेप्सू राजानं शत्रुभिर्वृतम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2170431, "chapter_id": 4639, "verse_number": "१०", "content_sanskrit": "तांस्तु सर्वान् महेष्वासान् कर्णो वैकर्तनो नृप ।\nशरवर्षेण महता प्रत्यवारयदागतान्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2170432, "chapter_id": 4639, "verse_number": "११", "content_sanskrit": "शरौघान् विसृजन्तस्ते प्रेरयन्तश्च तोमरान् ।\nन शेकुर्यत्नवन्तोऽपि राधेयं प्रतिवीक्षितुम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2170433, "chapter_id": 4639, "verse_number": "१२", "content_sanskrit": "तांश्च सर्वान् महेष्वासान् सर्वशस्त्रास्त्रपारगः ।\nमहता शरवर्षेण राधेयः प्रत्यवारयत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2170434, "chapter_id": 4639, "verse_number": "१३", "content_sanskrit": "दुर्योधनं तु विंशत्या नाराचानां कृती बली ।\nअविध्यत् तूर्णमभ्येत्य सहदेवो महारथः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2170435, "chapter_id": 4639, "verse_number": "१४", "content_sanskrit": "सोऽतिविद्धो बलवता राजा बलसमन्वितः ।\nप्रभिन्न इव मातङ्गो रुधिरेण परिप्लुतः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2170436, "chapter_id": 4639, "verse_number": "१५", "content_sanskrit": "दृष्ट्वा सुतं तव शरैर्गाढविद्धं सुतेजनैः ।\nअभ्यधावद् भृशं क्रुद्धो राधेयो रथिनां वरः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2170437, "chapter_id": 4639, "verse_number": "१६", "content_sanskrit": "दुर्योधनं तथा दृष्ट्वा शीघ्रमस्त्रमुदीर्य सः ।\nतेन यौधिष्ठिरं सैन्यमवधीत् पार्षतं तथा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2170438, "chapter_id": 4639, "verse_number": "१७", "content_sanskrit": "ततो यौधिष्ठिरं सैन्यं वध्यमानं महात्मना ।\nसहसा प्राद्रवद् राजन् सूतपुत्रभयार्दितम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2170439, "chapter_id": 4639, "verse_number": "१८", "content_sanskrit": "विविधा विशिखास्तत्र सम्पतन्तः परस्परम् ।\nपुङ्खैः पुङ्खान् समाजघ्नुः सूतपुत्रधनुश्च्युताः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2170440, "chapter_id": 4639, "verse_number": "१९", "content_sanskrit": "अन्तरिक्षे शरौघाणां पततां च परस्परम् ।\nसङ्घर्षेण महाराज पावकः समजायत\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2170441, "chapter_id": 4639, "verse_number": "२०", "content_sanskrit": "ततो दश दिशः शीघ्रैः शलभैरिव यायिभिः ।\nअभ्यहंस्तरसा कर्णः शरैः परशरीरगैः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2170442, "chapter_id": 4639, "verse_number": "२१", "content_sanskrit": "रक्तचन्दनसन्दिग्धौ मणिहेमविभूषितौ ।\nबाहू व्यत्यक्षिपत् कर्णः परमास्त्रं विदर्शयन्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2170443, "chapter_id": 4639, "verse_number": "२२", "content_sanskrit": "ततः सर्वा दिशो राजन् सायकैर्विप्रमोहयन् ।\nअपीडयद् भृशं कर्णो धर्मपुत्रं युधिष्ठिरम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2170444, "chapter_id": 4639, "verse_number": "२३", "content_sanskrit": "ततः क्रुद्धो महाराज धर्मपुत्रो युधिष्ठिरः ।\nनिशितैरिषुभिः कर्णं पञ्चाशद्भिः समार्पयत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2170445, "chapter_id": 4639, "verse_number": "२४", "content_sanskrit": "बाणान्धकारमभवत् तद्युद्धं घोरदर्शनम् ।\nहाहाकारो महानासीत् तावकानां विशाम्पते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2170446, "chapter_id": 4639, "verse_number": "२५", "content_sanskrit": "वध्यमाने तदा सैन्ये धर्मपुत्रेण मारिष\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2170447, "chapter_id": 4639, "verse_number": "२६", "content_sanskrit": "सायकैर्विविधैस्तीक्ष्णैः कङ्कपत्रैः शिलाशितैः ।\nभल्लैरनेकैर्विविधैः शक्त्यृष्टिमुसलैरपि\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2170448, "chapter_id": 4639, "verse_number": "२७", "content_sanskrit": "यत्र यत्र स धर्मात्मा दृष्ट्वा दृष्टिं व्यसर्जयत् ।\nतत्र तत्र व्यशीर्यन्त तावका भरतर्षभ\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2170449, "chapter_id": 4639, "verse_number": "२८", "content_sanskrit": "कर्णोऽपि भृशसङ्क्रुद्धो धर्मराजं युधिष्ठिरम् ।\nनाराचैरर्धचन्द्रैश्च वत्सदन्तैश्च संयुगे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2170450, "chapter_id": 4639, "verse_number": "२९", "content_sanskrit": "अमर्षी क्रोधनश्चैव रोषप्रस्फुरिताधरः ।\nसायकैरप्रमेयात्मा युधिष्ठिरमुपाद्रवत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2170451, "chapter_id": 4639, "verse_number": "३०", "content_sanskrit": "युधिष्ठिरश्चापि शतं स्वर्णपुङ्खैः शितैः शरैः ।\nप्रहसन्निव तं कर्णः कङ्कपत्रैः शिलाशितैः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2170452, "chapter_id": 4639, "verse_number": "३१", "content_sanskrit": "उरस्यविध्यद् राजानं त्रिभिर्भल्लैश्च पाण्डवम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2170453, "chapter_id": 4639, "verse_number": "३२", "content_sanskrit": "स पीडितो भृशं तेन धर्मराजो युधिष्ठिरः ।\nउपविश्य रथोपस्थे सूतं याहीत्यचोदयत्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2170454, "chapter_id": 4639, "verse_number": "३३", "content_sanskrit": "प्राक्रोशन्त ततः सर्वे धार्तराष्ट्राः सराजकाः ।\nगृह्णीध्वमिति राजानमभ्यधावन्त सर्वशः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2170455, "chapter_id": 4639, "verse_number": "३४", "content_sanskrit": "ततः शरशतै राजन्नैकैकानां प्रहारिणाम् ।\nपाञ्चालसहिता राजन् धार्तराष्ट्रान् न्यवारयन्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2170456, "chapter_id": 4639, "verse_number": "३५", "content_sanskrit": "तस्मिन् सुतुमुले युद्धे वर्तमाने जनक्षये ।\nदुर्योधनश्च भीमश्च समेयातां महाबलौ\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2170457, "chapter_id": 4639, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nएकोनषष्टितमोऽध्यायः ॥५९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]