[{"id": 5000598000, "chapter_id": 9598, "verse_number": "७-६३-१", "content_sanskrit": "एवमुक्तस्तु रामेण परां व्रीडामुपागमत् ।\nशत्रुघ्नो वीर्यसम्पन्नो मन्दं मन्दमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000598001, "chapter_id": 9598, "verse_number": "७-६३-२", "content_sanskrit": "अधर्मं विद्म काकुत्स्थ ह्यस्मिन्नर्थे नरेश्वर ।\nकथं तिष्ठत्सु ज्येष्ठेषु कनीयानभिषिच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000598002, "chapter_id": 9598, "verse_number": "७-६३-३", "content_sanskrit": "अवश्यं करणीयं च शासनं पुरुषर्षभ ।\nतव चैव महाभाग शासनं दुरतिक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000598003, "chapter_id": 9598, "verse_number": "७-६३-४", "content_sanskrit": "त्वत्तो मया श्रुतं वीर श्रुतिभ्यश्च मया श्रुतम् ।\nनोत्तरं हि मया वाच्यं मध्यमे प्रतिजानति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000598004, "chapter_id": 9598, "verse_number": "७-६३-५", "content_sanskrit": "व्याहृतं दुर्वचो घोरं हन्तास्मि लवणं मृधे ।\nतस्यैवं मे दुरुक्तस्य दुर्गतिः पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000598005, "chapter_id": 9598, "verse_number": "७-६३-६", "content_sanskrit": "उत्तरं नहि वक्तव्यं ज्येष्ठेनाभिहिते पुनः ।\nअधर्मसहितं चैव परलोकविवर्जितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000598006, "chapter_id": 9598, "verse_number": "७-६३-७", "content_sanskrit": "सो ऽहं द्वितीयं काकुत्स्थ न वक्ष्यामि तवोत्तरम् ।\nमा द्वितीयेन दण्डो वै निपतेन्मयि मानद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000598007, "chapter_id": 9598, "verse_number": "७-६३-८", "content_sanskrit": "कामकारो ह्यहं राजंस्तवास्मि पुरुषर्षभ ।\nअधर्मं जहि काकुत्स्थ मत्कृते रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000598008, "chapter_id": 9598, "verse_number": "७-६३-९", "content_sanskrit": "एवमुक्ते तु शूरेण शत्रुघ्नेन महात्मना ।\nउवाच रामः संहृष्टो भरतं लक्ष्मणं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000598009, "chapter_id": 9598, "verse_number": "७-६३-१०", "content_sanskrit": "सम्भारानभिषेकस्य आनयध्वं समाहिताः ।\nअद्यैव पुरुषव्याघ्रमभिषेक्ष्यामि राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000598010, "chapter_id": 9598, "verse_number": "७-६३-११", "content_sanskrit": "पुरोहितं च काकुत्स्थं नैगमानृत्विजस्तथा ।\nमन्त्रिणश्चैव तान्सर्वानानयध्वं ममाज्ञया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000598011, "chapter_id": 9598, "verse_number": "७-६३-१२", "content_sanskrit": "राज्ञः शासनमाज्ञाय तथा ऽकुर्वन्महारथाः ।\nअभिषेकसमारम्भं पुरस्कृत्य पुरोधसम् ।\nप्रविष्टा राजभवनं राजानो ब्राह्मणास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000598012, "chapter_id": 9598, "verse_number": "७-६३-१३", "content_sanskrit": "तथो ऽभिषेको ववृधे शत्रुघ्नस्य महात्मनः ।\nसम्प्रहर्षकरः श्रीमान्राघवस्य पुरस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000598013, "chapter_id": 9598, "verse_number": "७-६३-१४", "content_sanskrit": "अभिषिक्तस्तु शत्रुघ्नो बभौ चादित्यसन्निभः ।\nअभिषिक्तः पुरा स्कन्दः सेन्द्रैरिव मरुद्गणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000598014, "chapter_id": 9598, "verse_number": "७-६३-१५", "content_sanskrit": "अभिषिक्ते तु शत्रुघ्ने रामेणाक्लिष्टकर्मणा ।\nपौराः प्रमुदिताश्चासन्ब्राह्मणाश्च बहुश्रुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000598015, "chapter_id": 9598, "verse_number": "७-६३-१६", "content_sanskrit": "कौसल्या च सुमित्रा च मङ्गलं केकयी तथा ।\nचक्रुस्ता राजभवने याश्चान्या राजयोषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000598016, "chapter_id": 9598, "verse_number": "७-६३-१७", "content_sanskrit": "ऋषयश्च महात्मानो यमुनातीरवासिनः ।\nहतं लवणमाशंसुः शत्रुघ्नस्याभिषेचनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000598017, "chapter_id": 9598, "verse_number": "७-६३-१८", "content_sanskrit": "ततो ऽभिषिक्तं शत्रुघ्नमङ्कमारोप्य राघवः ।\nउवाच मधुरां वाणीं तेजस्तस्याभिपूरयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000598018, "chapter_id": 9598, "verse_number": "७-६३-१९", "content_sanskrit": "अयं शरस्त्वमोघस्ते दिव्यः परपुरञ्जयः ।\nअनेन लवणं सौम्य हन्ता ऽसि रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000598019, "chapter_id": 9598, "verse_number": "७-६३-२०", "content_sanskrit": "सृष्टः शरो ऽयं काकुत्स्थ यदा शेते महार्णवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000598020, "chapter_id": 9598, "verse_number": "७-६३-२१", "content_sanskrit": "स्वयम्भूरजितो देवो यन्नापश्यन्सुरासुराः ।\nअदृश्यः सर्वभूतानां तेनायं तु शरोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000598021, "chapter_id": 9598, "verse_number": "७-६३-२२", "content_sanskrit": "सृष्टः क्रोधाभिभूतेन विनाशार्थं दुरात्मनोः ।\nमधुकैटभयोर्वीर विघाते वर्तमानयोः ।\nस्रष्टुकामेन लोकांस्त्रींस्तौ चानेन हतौ युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000598022, "chapter_id": 9598, "verse_number": "७-६३-२३", "content_sanskrit": "तौ हत्वा जनभोगार्थं कैटभं तु मधुं तथा ।\nअनेन शरमुख्येन ततो लोकांश्चकार सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000598023, "chapter_id": 9598, "verse_number": "७-६३-२४", "content_sanskrit": "नायं मया शरः पूर्वं रावणस्य वधार्थिना ।\nमुक्तः शत्रुघ्न भूतानां महांस्त्रासो भवेदिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000598024, "chapter_id": 9598, "verse_number": "७-६३-२५", "content_sanskrit": "यच्च तस्य महच्छूलं त्र्यम्बकेण महात्मना ।\nदत्तं शत्रुविनाशाय मधोरायुधमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000598025, "chapter_id": 9598, "verse_number": "७-६३-२६", "content_sanskrit": "स तं निक्षिप्य भवने पूज्यमान पुनः पुनः ।\nदिशः सर्वाः समासाद्य प्राप्नोत्याहारमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000598026, "chapter_id": 9598, "verse_number": "७-६३-२७", "content_sanskrit": "यदा तु युद्धमाकाङ्क्षन् कश्चिदेनं समाह्वयेत् ।\nतदा शूलं गहीत्वा तं भस्म रक्षः करोति हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000598027, "chapter_id": 9598, "verse_number": "७-६३-२८", "content_sanskrit": "स त्वं पुरुषशार्दूल तमायुधविनाकृतम् ।\nअप्रविष्टं पुरं पूर्वं द्वारि तिष्ठ धृतायुधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000598028, "chapter_id": 9598, "verse_number": "७-६३-२९", "content_sanskrit": "अप्रविष्टं च भवनं युद्धाय पुरुषर्षभ ।\nआह्वयेथा महाबाहो ततो हन्तासि राक्षसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000598029, "chapter_id": 9598, "verse_number": "७-६३-३०", "content_sanskrit": "अन्यथा क्रियमाणे तु अवध्यः स भविष्यति ।\nयदि त्वेवं कृते वीर विनाशमुपयास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000598030, "chapter_id": 9598, "verse_number": "७-६३-३१", "content_sanskrit": "एतत्ते सर्वमाख्यातं शूलस्य च विपर्ययः ।\nश्रीमतः शितिकण्ठस्य कृत्यं हि दुरतिक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000598031, "chapter_id": 9598, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे त्रिषष्टितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]