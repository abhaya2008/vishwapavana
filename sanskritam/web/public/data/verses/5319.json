[{"id": 2202855, "chapter_id": 5319, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2202856, "chapter_id": 5319, "verse_number": "१", "content_sanskrit": "क्षत्रधर्ममनुप्राप्तः स्मरन्नेव स वीर्यवान् ।\nत्यक्त्वा स कीटतां राजन् चचार विपुलं तपः\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2202857, "chapter_id": 5319, "verse_number": "२", "content_sanskrit": "तस्य धर्मार्थविदुषो दृष्ट्वा तद्विपुलं तपः ।\nआजगाम द्विजश्रेष्ठः कृष्णद्वैपायनस्तदा\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2202858, "chapter_id": 5319, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2202859, "chapter_id": 5319, "verse_number": "३", "content_sanskrit": "क्षात्रं चैव व्रतं कीट भूतानां परिपालनम् ।\nक्षात्रं चैव व्रतं ध्यायन् ततो विप्रत्वमेष्यसि\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2202860, "chapter_id": 5319, "verse_number": "४", "content_sanskrit": "पाहि सर्वाः प्रजाः सम्यक् शुभाशुभविदात्मवान् ।\nशुभैः संविभजन् कामैरशुभानां च पावनैः\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2202861, "chapter_id": 5319, "verse_number": "५", "content_sanskrit": "आत्मवान् भव सुप्रीतः स्वधर्मचरणे रतः ।\nक्षात्रीं तनुं समुत्सृज्य ततो विप्रत्वमेष्यसि\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2202862, "chapter_id": 5319, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2202863, "chapter_id": 5319, "verse_number": "६", "content_sanskrit": "सोऽथारण्यमभिप्रेत्य पुनरेव युधिष्ठिर ।\nमहर्षेर्वचनं श्रुत्वा प्रजा धर्मेण पाल्य च\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2202864, "chapter_id": 5319, "verse_number": "७", "content_sanskrit": "अचिरेणैव कालेन कीटः पार्थिवसत्तम ।\nप्रजापालनधर्मेण प्रेत्य विप्रत्वमागतः\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2202865, "chapter_id": 5319, "verse_number": "८", "content_sanskrit": "ततस्तं ब्राह्मणं दृष्ट्वा पुनरेव महायशाः ।\nआजगाम महाप्राज्ञः कृष्णद्वैपायनस्तदा\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2202866, "chapter_id": 5319, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2202867, "chapter_id": 5319, "verse_number": "९", "content_sanskrit": "भो भो विप्रर्षभ श्रीमन् मा व्यथिष्ठाः कथञ्चन ।\nशुभकृच्छुभयोनीषु पापकृत् पापयोनिषु ।\nउपपद्यति धर्मज्ञ यथाधर्मं यथागमम्\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2202868, "chapter_id": 5319, "verse_number": "१०", "content_sanskrit": "तस्मान्मृत्युभयात् कीट मा व्यथिष्ठाः कथञ्चन ।\nधर्मलोपाद् भयं ते स्यात् तस्माद् धर्मं चरोत्तमम्\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2202869, "chapter_id": 5319, "verse_number": "", "content_sanskrit": "कीटः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2202870, "chapter_id": 5319, "verse_number": "११", "content_sanskrit": "सुखात् सुखतरं प्राप्तो भगवंस्त्वत्कृते ह्यहम् ।\nधर्ममूलां श्रियं प्राप्य पाप्मा नष्ट इहाद्य मे\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2202871, "chapter_id": 5319, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2202872, "chapter_id": 5319, "verse_number": "१२", "content_sanskrit": "भगवद्वचनात् कीटो ब्राह्मण्यं प्राप्य दुर्लभम् ।\nअकरोत् पृथिवीं राजन् यज्ञयूपशताङ्किताम् ।\nततः सालोक्यमगमद् ब्रह्मणो ब्रह्मवित्तमः\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2202873, "chapter_id": 5319, "verse_number": "१३", "content_sanskrit": "अवाप च परं कीटः पार्थ ब्रह्म सनातनम् ।\nस्वकर्मफलनिर्वृत्तं व्यासस्य वचनं यथा\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2202874, "chapter_id": 5319, "verse_number": "१४", "content_sanskrit": "तेऽपि यस्मात् स्वभावेन हताः क्षत्रियपुङ्गवाः ।\nसम्प्राप्तास्ते गतिं पुण्यां तस्मात् पुत्रक मा शुच॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2202875, "chapter_id": 5319, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे कीटस्य सद्गतिप्राप्तिर्नाम सप्तत्युत्तरशततमोऽध्यायः ॥१७०॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]