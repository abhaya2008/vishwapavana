[{"id": 2045014, "chapter_id": 2004, "verse_number": "६-५३-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2045015, "chapter_id": 2004, "verse_number": "६-५३-१", "content_sanskrit": "कथं द्रोणो महेष्वासः पाञ्चाल्यश्चापि पार्षतः।\nउभौ समीयतुर्यत्तौ तन्ममाचक्ष्व सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2045016, "chapter_id": 2004, "verse_number": "६-५३-२", "content_sanskrit": "दिष्टमेव परं मन्ये पौरुषादिति मे मतिः।\nयत्र शान्तनवो भीष्मो नातरद्युधि पाण्डवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2045017, "chapter_id": 2004, "verse_number": "६-५३-३", "content_sanskrit": "भीष्मो हि समरे क्रुद्धो हन्याल्लोकांश्चराचरान्।\nस कथं पाण्डवं युद्धे नातरत्सञ्जयौजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2045018, "chapter_id": 2004, "verse_number": "६-५३-४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2045019, "chapter_id": 2004, "verse_number": "६-५३-४", "content_sanskrit": "श्रृणु राजन्स्थिरो भूत्वा युद्धमेतत्सुदारुणम्।\nन शक्याः पाण्डवा जेतुं देवैरपि सवासवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2045020, "chapter_id": 2004, "verse_number": "६-५३-५", "content_sanskrit": "द्रोणस्तु निशितैर्बाणैर्धृष्टद्युम्नमविध्यत।\nसारथिं चास्य भल्लेन रथनीडादपातयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2045021, "chapter_id": 2004, "verse_number": "६-५३-६", "content_sanskrit": "तथाऽस्य चतुरो वाहांश्चतुर्भिः सायकोत्तमैः ।\nपीडयामास संक्रुद्धो धृष्टद्युम्नस्य मारिष ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2045022, "chapter_id": 2004, "verse_number": "६-५३-७", "content_sanskrit": "धृष्टद्युम्नस्ततो द्रोणं नवत्या निशितैः शरैः ।\nविव्याध प्रहसन्वीरस्तिष्ठतिष्ठेति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2045023, "chapter_id": 2004, "verse_number": "६-५३-८", "content_sanskrit": "ततः पुनरमेयात्मा भारद्वाजः प्रतापवान्।\nशरैः प्रच्छादयामास धृष्टद्युम्नममर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2045024, "chapter_id": 2004, "verse_number": "६-५३-९", "content_sanskrit": "आददे च शरं घोरं पार्षतान्तचिकीर्षकया।\nशक्राशनिसमस्पर्शं कालदण्डमिवापरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2045025, "chapter_id": 2004, "verse_number": "६-५३-१०", "content_sanskrit": "हाहाकारो महानासीत्सर्वसैन्येषु भारत ।\nतमिषुं संधितं दृष्ट्वा भारद्वाजेन संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2045026, "chapter_id": 2004, "verse_number": "६-५३-११", "content_sanskrit": "तत्राद्भुतमपश्याम धृष्टद्युम्नस्य पौरुषम्।\nयदेकः समरे वीरस्तस्थौ गिरिरिवाचलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2045027, "chapter_id": 2004, "verse_number": "६-५३-१२", "content_sanskrit": "तं च दीप्तं शरं घोरमायान्तं मृत्युमात्मनः ।\nचिच्छेद शरवृष्टिं च भारद्वाजे मुमोच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2045028, "chapter_id": 2004, "verse_number": "६-५३-१३", "content_sanskrit": "तत उच्चुक्रुशुः सर्वे पाञ्चालाः पाण्डवैः सह।\nधृष्टद्युम्नेन तत्कर्म कृतं दृष्ट्वा सुदुष्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2045029, "chapter_id": 2004, "verse_number": "६-५३-१४", "content_sanskrit": "ततः शक्तिं महावेगां स्वर्णवैडूर्यभूषिताम् ।\nद्रोणस्य निधनाकाङ्क्षी चिक्षेप स पराक्रमी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2045030, "chapter_id": 2004, "verse_number": "६-५३-१५", "content_sanskrit": "तामापतन्तीं सहसा शक्तिं कनकभूषिताम्।\nत्रिधा चिच्छेद समरे भारद्वाजो हसन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2045031, "chapter_id": 2004, "verse_number": "६-५३-१६", "content_sanskrit": "शक्तिं विनिहतां दृष्ट्वा धृष्टद्युम्नः प्रतपवान् ।\nववर्ष शरवर्षाणि द्रोणं प्रति जनेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2045032, "chapter_id": 2004, "verse_number": "६-५३-१७", "content_sanskrit": "शरवर्षं ततस्तत्तु सन्निवार्य महायशाः।\nद्रोणो द्रुपदपुत्रस्य मध्ये चिच्छेद कार्मुकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2045033, "chapter_id": 2004, "verse_number": "६-५३-१८", "content_sanskrit": "स च्छिन्नधन्वा समरे गदां गुर्वी महायशाः ।\nद्रोणाय प्रेषयामास गिरिसारमयीं बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2045034, "chapter_id": 2004, "verse_number": "६-५३-१९", "content_sanskrit": "सा गदा वेगवन्मुक्ता प्रायाद्द्रोणजिघांसया ।\nतत्राद्भुतमपश्याम भारद्वाजस्य पौरुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2045035, "chapter_id": 2004, "verse_number": "६-५३-२०", "content_sanskrit": "लाघवाद्व्यंसयामास गदां हेमविभूषिताम्।\nव्यंसयित्वा गदां तां च प्रेषयामास पार्षतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2045036, "chapter_id": 2004, "verse_number": "६-५३-२१", "content_sanskrit": "भल्लान्सुनिशितान्पीतातान्रुक्मपुङ्खान्सुदारुणान्।\nते तस्य कवचं भित्त्वा पपुः शोणितमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2045037, "chapter_id": 2004, "verse_number": "६-५३-२२", "content_sanskrit": "अथान्यद्धनुरादाय धृष्टद्युम्नो महारथः ।\nद्रोणं युधि पराक्रम्य शरैर्विव्याध पञ्चभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2045038, "chapter_id": 2004, "verse_number": "६-५३-२३", "content_sanskrit": "रुधिराक्तौ ततस्तौ तु शुशुभाते नरर्षभौ ।\nवसन्तसमये राजन्पुष्पिताविव किंशुकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2045039, "chapter_id": 2004, "verse_number": "६-५३-२४", "content_sanskrit": "अमर्षितस्ततो राजन्पराक्रम्य चमूमुखे ।\nद्रोणो द्रुपदपुत्रस्य पुनश्चिच्छेद कार्मुकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2045040, "chapter_id": 2004, "verse_number": "६-५३-२५", "content_sanskrit": "अथैनं छिन्नधन्वानं शरैः सन्नतपर्वभिः ।\nअभ्यवर्षदमेयात्मा वृष्ट्या मेघ इवाचलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2045041, "chapter_id": 2004, "verse_number": "६-५३-२६", "content_sanskrit": "सारथिं चास्य भल्लेन रथनीजादपातयत् ।\nअथास्य चतुरो वाहांश्चतुर्भिर्निशितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2045042, "chapter_id": 2004, "verse_number": "६-५३-२७", "content_sanskrit": "पातयामास समरे सिंहनादं ननाद च।\nततोऽपरेण भल्लेन हस्ताच्चापमथाच्छिनत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2045043, "chapter_id": 2004, "verse_number": "६-५३-२८", "content_sanskrit": "स च्छिन्नधन्वा विरथो हताश्वो हतसारथिः ।\nगदापाणिरवारोहत्स्व्यापयन्पौरुषं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2045044, "chapter_id": 2004, "verse_number": "६-५३-२९", "content_sanskrit": "तामस्य विशिस्वैस्तूर्णं पातयामास भारत ।\nरथादनवरूढस्य तदद्भुतमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2045045, "chapter_id": 2004, "verse_number": "६-५३-३०", "content_sanskrit": "ततः स विपुलं चर्म शतचन्द्रं च भानुमत्।\nखङ्गं च विपुलं दिव्यं प्रगृह्य सुभुजो बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2045046, "chapter_id": 2004, "verse_number": "६-५३-३१", "content_sanskrit": "अभिदुद्राव वेगेन द्रोणस्य वधाकाङ्क्षया।\nआमिषार्थी यथा सिंहो वने मत्तमिव द्विपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2045047, "chapter_id": 2004, "verse_number": "६-५३-३२", "content_sanskrit": "तत्राद्भुतमपश्याम भारद्वाजस्य पौरुषम् ।\nलाघवं चास्त्रयोगं च बलं बाह्वोश्च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2045048, "chapter_id": 2004, "verse_number": "६-५३-३३", "content_sanskrit": "यदेनं शरवर्षेण वारयामास पार्षतम् ।\nन शशाक ततो गन्तुं बलवानपि संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2045049, "chapter_id": 2004, "verse_number": "६-५३-३४", "content_sanskrit": "निवारितस्तु द्रोणेन धृष्टद्युम्नो महारथः ।\nन्यावारयच्छरौघांस्तांश्चर्मणा कृतहस्तवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2045050, "chapter_id": 2004, "verse_number": "६-५३-३५", "content_sanskrit": "ततो भीमो महाबाहुः सहसाऽभ्यपतद्बली ।\nसाहाय्यकारी समरे पार्षतस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2045051, "chapter_id": 2004, "verse_number": "६-५३-३६", "content_sanskrit": "स द्रोमं निशितैर्बाणै राजन्विव्याध सप्तभिः ।\nपार्षतं च रथं तूर्णं स्वकमारोहयत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2045052, "chapter_id": 2004, "verse_number": "६-५३-३७", "content_sanskrit": "ततो दुर्योधनो राजन्कलिङ्गं समचोदयत्।\nसैन्येन महता युक्तं भारद्वाजस्य रक्षणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2045053, "chapter_id": 2004, "verse_number": "६-५३-३८", "content_sanskrit": "ततः सा महती सेन कलिङ्गानां जनेश्वर ।\nभीममभ्युद्ययौ तूर्णं तव पुत्रस्य शासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2045054, "chapter_id": 2004, "verse_number": "६-५३-३९", "content_sanskrit": "पाञ्चाल्यमथ संत्यज्य द्रोणोऽपि रथिनां वरः।\nविराटद्रुपदौ वृद्धौ वारयामास संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2045055, "chapter_id": 2004, "verse_number": "६-५३-४०", "content_sanskrit": "धृष्टद्युम्नोऽपि समरे धर्मराजानमभ्ययात्।\nततः प्रववृते युद्धं तुमुलं रोमहर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2045056, "chapter_id": 2004, "verse_number": "६-५३-४१", "content_sanskrit": "कलिङ्गानां च समरे भीष्मस्य च महात्मनः ।\nजगतः प्रक्षयकरं घोररूपं भयावहम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2045057, "chapter_id": 2004, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि द्वितीयदिवसयुद्धे त्रिपञ्चाशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]