[{"id": 2102654, "chapter_id": 3223, "verse_number": "१४-७९-१", "content_sanskrit": "वैशम्पायन उवाच।\nश्रुत्वा तु नृपतिः प्राप्तं पितरं बभ्रुवाहनः।\nनिर्ययौ विनयेनाथ ब्राह्मणार्यपुरःसरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2102655, "chapter_id": 3223, "verse_number": "१४-७९-२", "content_sanskrit": "मणलूरेश्वरं त्वेवमुपयातं धनंजयः।\nनाभ्यनन्दत्स मेधावी क्षत्रधर्ममनुस्मरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2102656, "chapter_id": 3223, "verse_number": "१४-७९-३", "content_sanskrit": "उवाच च स धर्मात्मा समन्युः फल्गुनस्तदा।\nप्रक्रियेयं न ते युक्ता बहिस्त्वं क्षत्रधर्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2102657, "chapter_id": 3223, "verse_number": "१४-७९-४", "content_sanskrit": "संरक्ष्यमाणं तुरगं यौधिष्ठिरमुपागतम्।\nयज्ञियं विषयान्ते मां नायोत्सीः किंनु पुत्रक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2102658, "chapter_id": 3223, "verse_number": "१४-७९-५", "content_sanskrit": "धिक्त्वामस्तु सुदुर्बुद्धिं क्षत्रधर्माविशारदम्।\nयो मां युद्धाय सम्प्राप्तं साम्नैव प्रत्यगृह्णथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2102659, "chapter_id": 3223, "verse_number": "१४-७९-६", "content_sanskrit": "न त्वया पुरुषार्थो हि कश्चिदस्तीह जीवता।\nयस्त्वं स्त्रीवद्युधा प्राप्तं मां साम्ना प्रत्यगृह्णथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2102660, "chapter_id": 3223, "verse_number": "१४-७९-७", "content_sanskrit": "यद्यहं न्यस्तशस्त्रस्त्वामागच्छेयं सुदुर्मते।\nप्रक्रियेयं भवेद्युक्ता तावतव नराधम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2102661, "chapter_id": 3223, "verse_number": "१४-७९-८", "content_sanskrit": "तमेवमुक्तं भर्त्रा तु विदित्वा पन्नगात्मजा।\nअमृष्यमाणा भित्त्वोर्वीमुलूपी समुपागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2102662, "chapter_id": 3223, "verse_number": "१४-७९-९", "content_sanskrit": "सा ददर्श तत पुत्रं विमृशन्तमधोमुखम्।\nसंतर्ज्यमानमसकृत्पित्रा युद्धार्थिना विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2102663, "chapter_id": 3223, "verse_number": "१४-७९-१०", "content_sanskrit": "ततः सा चारुसर्वाङ्गी समुपेत्योरगात्मजा।\nउलूपी प्राह वचनं क्षत्रधर्मविशारद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2102664, "chapter_id": 3223, "verse_number": "१४-७९-११", "content_sanskrit": "उलूपीं मां निबोध त्वं मातरं पन्नगात्मजाम्।\nकुरुष्व वचनं पुत्र धर्मस्ते भविता परः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2102665, "chapter_id": 3223, "verse_number": "१४-७९-१२", "content_sanskrit": "युध्यस्वैनं कुरुश्रेष्ठं धनंजयमरिन्दमम्॥\nएवमेष हि ते प्रीतो भविष्यति न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2102666, "chapter_id": 3223, "verse_number": "१४-७९-१३", "content_sanskrit": "एवमुद्धार्षितो राजा स मात्रा बभ्रुवाहनः।\nमनश्चक्रे महातेजा युद्धाय भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2102667, "chapter_id": 3223, "verse_number": "१४-७९-१४", "content_sanskrit": "सन्नह्य काञ्चनं वर्म शिरस्त्राणं च भानुमत्।\nतूणीरशतसंबाधमारुरोह रथोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2102668, "chapter_id": 3223, "verse_number": "१४-७९-१५", "content_sanskrit": "सर्वोपकरणोपेतं युक्तमश्वैर्मनोजवैः।\nसचक्रोपस्करं श्रीमान्हेमभाण्डपरिष्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2102669, "chapter_id": 3223, "verse_number": "१४-७९-१६", "content_sanskrit": "परमार्चितमुच्छ्रित्य ध्वजं हंसं हिरण्मयम्।\nप्रययौ पार्थमुद्दिश्य स राजा बभ्रुवाहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2102670, "chapter_id": 3223, "verse_number": "१४-७९-१७", "content_sanskrit": "ततोऽभ्योत्य हयं वीरो यज्ञियं पार्थरक्षितम्।\nग्राहयामास पुरुषैर्हयशिक्षाविशारदैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2102671, "chapter_id": 3223, "verse_number": "१४-७९-१८", "content_sanskrit": "गृहीतं वाजिनं दृष्ट्वा प्रीतात्मा स धनंजयः।\nपुत्रं रथस्थं भूमिष्ठः संन्यवारयदाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2102672, "chapter_id": 3223, "verse_number": "१४-७९-१९", "content_sanskrit": "स तत्र राजा तं वीरं शरसङ्घैरनेकशः।\nअर्दयामास निशितैराशीविषविषोपमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2102673, "chapter_id": 3223, "verse_number": "१४-७९-२०", "content_sanskrit": "तयोः समभवद्युद्धं पितुः पुत्रस्यक चातुलम्।\nदेवासुररणप्रख्यमुभयोः प्रीयमाणयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2102674, "chapter_id": 3223, "verse_number": "१४-७९-२१", "content_sanskrit": "किरीटिनं प्रविव्याघ शरेणानतपर्वणा।\nजत्रुदेशे नरव्याघ्रं प्रहसन्बभ्रुवाहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2102675, "chapter_id": 3223, "verse_number": "१४-७९-२२", "content_sanskrit": "सोभ्यगात्सहपुङ्खेन वल्मीकमिव पन्नगः।\nविनिर्भद्य च कौन्तेयं प्रविवेशि महीतलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2102676, "chapter_id": 3223, "verse_number": "१४-७९-२३", "content_sanskrit": "स गाढवेदनो धीमानालम्ब्य धनुरुत्तमम्।\nदिव्यं तेजः समाविश्य प्रमीत इव सोभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2102677, "chapter_id": 3223, "verse_number": "१४-७९-२४", "content_sanskrit": "स संज्ञामुपलभ्याथ प्रशस्य पुरुषर्षभः।\nपुत्रं शक्रात्मजो वाक्यमिदमाह महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2102678, "chapter_id": 3223, "verse_number": "१४-७९-२५", "content_sanskrit": "साधुसाधु महाबाहो वत्स चित्राङ्गदात्मज।\nसदृशं कर्म ते दृष्ट्वा प्रीतिमानस्मि पुत्रक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2102679, "chapter_id": 3223, "verse_number": "१४-७९-२६", "content_sanskrit": "विमुञ्चाम्येष ते बाणान्पुत्र युद्धे स्थिरो भव।\nइत्येवमुक्त्वा नाराचैरभ्यवर्षदमित्रहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2102680, "chapter_id": 3223, "verse_number": "१४-७९-२७", "content_sanskrit": "तान्स गाण्डीवनिर्मुक्तान्वज्राशनिसमप्रभान्।\nनाराचानच्छिनद्राज भल्लैः सर्वांस्त्रिधा द्विधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2102681, "chapter_id": 3223, "verse_number": "१४-७९-२८", "content_sanskrit": "तस्य पार्थः शरैर्दिव्यैर्ध्वजं हेमपरिष्कृतम्।\nसुवर्णतालप्रतिमं क्षुरेणापाहरद्रथात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2102682, "chapter_id": 3223, "verse_number": "१४-७९-२९", "content_sanskrit": "हयांश्चास्य महाकायान्महावेगानरिंदम।\nचकार राजन्निर्जावान्प्रहसन्निव पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2102683, "chapter_id": 3223, "verse_number": "१४-७९-३०", "content_sanskrit": "स रथादवतीर्याथ राजा परमकोपनः।\nपदातिः पितरं क्रुद्धो योधयामास पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2102684, "chapter_id": 3223, "verse_number": "१४-७९-३१", "content_sanskrit": "सम्प्रीयमाणः पार्थानामृषभः पुत्रविक्रमात्।\nनात्यर्थं पीडयामास पुत्रं वज्रधरात्मजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2102685, "chapter_id": 3223, "verse_number": "१४-७९-३२", "content_sanskrit": "स हन्यमानोऽभिमुखं पितरं बभ्रुवाहनः।\nशरैराशीविषाकारैः पुनरेवार्दयद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2102686, "chapter_id": 3223, "verse_number": "१४-७९-३३", "content_sanskrit": "ततः स बाल्यात्पितरं विव्याध हृदि पत्रिणा।\nनिशेतेन सुपुङ्खेन बलवद्बभ्रुवाहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2102687, "chapter_id": 3223, "verse_number": "१४-७९-३४", "content_sanskrit": "स बाणस्तेजसा दीप्तो ज्वलन्निव हुताशनः।\nविवेश पाण्डवं राजन्मर्म भित्त्वाऽतिदुःखकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2102688, "chapter_id": 3223, "verse_number": "१४-७९-३५", "content_sanskrit": "स तेनातिभृशं विद्धः पुत्रेण कुरुनन्दनः।\nमहीं जगाम मोहार्तस्ततो राजन्धनंजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2102689, "chapter_id": 3223, "verse_number": "१४-७९-३६", "content_sanskrit": "तस्मिन्निपतिते वीरे कौरवाणां धुरंधरे।\nसोपि मोहं जगामाथ ततश्चित्राङ्गदासुतः।ष", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2102690, "chapter_id": 3223, "verse_number": "१४-७९-३७", "content_sanskrit": "व्यायम्य संयुगे राजा दृष्ट्वा च पितरं हतम्।\nपूर्वमेव स बाणौर्घर्गाढविद्धोऽर्जुनेन ह।\nपपात सोपि धरणीमालिङ्ग्य रणमूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2102691, "chapter_id": 3223, "verse_number": "१४-७९-३८", "content_sanskrit": "भर्तारं निहतं दृष्ट्वा पुत्रं च पतितं भुवि।\nचित्राङ्गदा परित्रस्ता प्रविवेश रणाजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2102692, "chapter_id": 3223, "verse_number": "१४-७९-३९", "content_sanskrit": "शोकसंतप्तहृदया रुदती वेपती भृशम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2102693, "chapter_id": 3223, "verse_number": "१४-७९-४०", "content_sanskrit": "मणलूरपतेर्माता ददर्श निहतं पतिम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2102694, "chapter_id": 3223, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधकपर्वणि अनुगीतापर्वणि एकोनाशीतितमोऽध्यायः॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]