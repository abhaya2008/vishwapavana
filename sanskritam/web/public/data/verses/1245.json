[{"id": 2011966, "chapter_id": 1245, "verse_number": "१-२४६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2011967, "chapter_id": 1245, "verse_number": "१-२४६-१", "content_sanskrit": "क्रोशणात्रे पुरस्यासीद्गोष्ठं पार्थस्य शोभनम्।\nतत्रापि यात्वा बीभत्सुर्निविष्टो यदुकन्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2011968, "chapter_id": 1245, "verse_number": "१-२४६-२", "content_sanskrit": "ततः सुभद्रां सत्कृत्य पार्थो वचनमब्रवीत्।\nगोपिकानां तु वेषेण गच्छ त्वं वृजिनं पुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2011969, "chapter_id": 1245, "verse_number": "१-२४६-३", "content_sanskrit": "कामव्याहारिणी कृष्णा रोचतां ते वचो मम।\nदृष्ट्वा तु परुषं ब्रूयात्सह तत्र मयागताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2011970, "chapter_id": 1245, "verse_number": "१-२४६-४", "content_sanskrit": "अन्यवेषेण तु गतां दृष्ट्वा सा त्वां प्रियं वदेत्।\nयत्तु सा प्रथमं ब्रूयान्न तस्यास्ति निवर्तनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2011971, "chapter_id": 1245, "verse_number": "१-२४६-५", "content_sanskrit": "तस्मान्मानं च दर्पं च व्यपनीय स्वयं व्रज।\nतस्य तद्वचनं श्रुत्वा सुभद्रा प्रत्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2011972, "chapter_id": 1245, "verse_number": "१-२४६-६", "content_sanskrit": "एवमेतत्करिष्यामि यथा त्वं पार्थ भाषसे।\nसुभद्रावचनं श्रुत्वा सुप्रीतः पाकशासनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2011973, "chapter_id": 1245, "verse_number": "१-२४६-७", "content_sanskrit": "गोपालान्स समानीय त्वरितो वाक्यमब्रवीत्।\nतरुम्यः सन्ति यावन्त्यस्ताः सर्वा व्रजयोषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2011974, "chapter_id": 1245, "verse_number": "१-२४६-८", "content_sanskrit": "आगच्छन्तु गमिष्यन्त्या भद्रया सह सङ्गताः।\nइन्द्रप्रस्थं पुरवरं कृष्णां द्रष्टुं यशस्विनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2011975, "chapter_id": 1245, "verse_number": "१-२४६-९", "content_sanskrit": "एतच्छ्रुत्वा तु गोपालैरानीता व्रजयोषितः।\nततस्ताभिः परिवृतां व्रजस्त्रीभिः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2011976, "chapter_id": 1245, "verse_number": "१-२४६-१०", "content_sanskrit": "सुभद्रां त्वरमाणश्च रक्तकौशेयवासिनीम्।\nपार्थः प्रस्थापयामास कृत्वा गोपालिकावपुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2011977, "chapter_id": 1245, "verse_number": "१-२४६-११", "content_sanskrit": "साऽधिकं तेन रूपेण शोभमाना यशस्विनी।\nगोपालिकामध्यगता प्रययौ वृजिनं पुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2011978, "chapter_id": 1245, "verse_number": "१-२४६-१२", "content_sanskrit": "त्वरिता खाण्डवप्रस्थमाससाद विवेश च।\nभवनं श्रेष्ठमासाद्य वीरपत्नी वराङ्गना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2011979, "chapter_id": 1245, "verse_number": "१-२४६-१३", "content_sanskrit": "ववन्दे पृथुताम्राक्षी पृथां भद्रा पितृष्वसाम्।\nतां कुन्ती चारुसर्वाङ्गीमुपाजिघ्रत मूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2011980, "chapter_id": 1245, "verse_number": "१-२४६-१४", "content_sanskrit": "प्रीत्या परमया युक्ता आशीर्भिर्युञ्जताऽतुलाम्।\nततोऽभिगम्य त्वरिता पूर्णेन्दुसदृशानना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2011981, "chapter_id": 1245, "verse_number": "१-२४६-१५", "content_sanskrit": "ववन्दे द्रौपदीं भद्रा प्रेष्याऽहमिति चाब्रवीत्।\nप्रत्युत्थाय तदा कृष्णा स्वसारं माधवस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2011982, "chapter_id": 1245, "verse_number": "१-२४६-१६", "content_sanskrit": "परिष्वज्यावदत्प्रीत्या निःसपत्नोस्तु ते पतिः।\nवीरसूर्भव भद्रे त्वं भव भर्तृप्रिया तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2011983, "chapter_id": 1245, "verse_number": "१-२४६-१७", "content_sanskrit": "ओजसा निर्मिता बह्वीरुवाच परमाशिषः।\nतथैव मुदिता भद्रा तामुवाच तथास्त्विति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2011984, "chapter_id": 1245, "verse_number": "१-२४६-१८", "content_sanskrit": "ततः सुभद्रां वार्ष्णेयी परिष्वज्य शुभाननाम्।\nअङ्के निवेश्य मुदिता वसुदेवं प्रशस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2011985, "chapter_id": 1245, "verse_number": "१-२४६-१९", "content_sanskrit": "ततः किलकिलाशब्दः क्षणेन समपद्यत।\nहर्षादानर्तयोधानामासाद्य वृजिनं पुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2011986, "chapter_id": 1245, "verse_number": "१-२४६-२०", "content_sanskrit": "देवपुत्रप्रकाशास्ते जाम्बूनदमयध्वजाः।\nपृष्ठतोऽनुययुः पार्थं पुरुहूतमिवामराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2011987, "chapter_id": 1245, "verse_number": "१-२४६-२१", "content_sanskrit": "गोभिरुष्ट्रैः सदश्वैश्च युक्तानि बहुला जनाः।\nददृशुर्यानमुख्यानि दाशार्हपुरवासिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2011988, "chapter_id": 1245, "verse_number": "१-२४६-२२", "content_sanskrit": "ततः पुरवरे यूनां पुंसां वाच उदीरिताः।\nअर्जुने प्रतियाति स्म अश्रूयन्त समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2011989, "chapter_id": 1245, "verse_number": "१-२४६-२३", "content_sanskrit": "प्रवासादागतं पार्थं दृष्ट्वा स्वमिव बान्धवम्।\nसोऽभिगम्य नरश्रेष्ठो दाशार्हशतसंवृतः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2011990, "chapter_id": 1245, "verse_number": "१-२४६-२४", "content_sanskrit": "पौरैः पुरवरं प्रीत्या परया चाभिनन्दितः।\nप्राप्य चान्तःपुरद्वारमवरुह्य नरर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2011991, "chapter_id": 1245, "verse_number": "१-२४६-२५", "content_sanskrit": "ववन्दे धौम्यमासाद्य मातरं च धनञ्जयः।\nस्पृष्ट्वा च चरणौ राज्ञो भीमस्य च धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2011992, "chapter_id": 1245, "verse_number": "१-२४६-२६", "content_sanskrit": "यमाभ्यां वन्दितो हृष्टः सस्वजे तौ ननन्द च।\nब्राह्मणप्रमुखान्सर्वान्भ्रातृभिः सह सङ्गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2011993, "chapter_id": 1245, "verse_number": "१-२४६-२७", "content_sanskrit": "यथार्हं मानयामास पौरजानपदानपि।\nतत्रस्थान्यनुयातानि तीर्थान्यायतनानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2011994, "chapter_id": 1245, "verse_number": "१-२४६-२८", "content_sanskrit": "निवेदयामास तदा राज्ञे सर्वं स्वनुष्ठितम्।\nभ्रातृभ्यश्चैव सर्वेभ्यः कथयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2011995, "chapter_id": 1245, "verse_number": "१-२४६-२९", "content_sanskrit": "श्रुत्वा सर्वं महाप्राज्ञो धर्मराजो युधिष्ठिरः।\nपुरस्तादेव तेषां तु पूजयामास चार्जुनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2011996, "chapter_id": 1245, "verse_number": "१-२४६-३०", "content_sanskrit": "पाण्डवेन यथार्हं तु पूजार्हेण सुपूजितः।\nन्यविशच्चाभ्यनुज्ञातो राज्ञा तुष्टो यशस्विना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2011997, "chapter_id": 1245, "verse_number": "१-२४६-३१", "content_sanskrit": "तामदीनां सुपूजार्हां सुभद्रां प्रीतिवर्धिनीम्।\nसाक्षाच्छ्रियममन्यन्त पार्थाः कृष्णसहोदराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2011998, "chapter_id": 1245, "verse_number": "१-२४६-३२", "content_sanskrit": "गुरूणां श्वशुराणां च देवराणां तथैव च।\nसुभद्रा स्वेन वृत्तेन बभूव परमप्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2011999, "chapter_id": 1245, "verse_number": "१-२४६-३३", "content_sanskrit": "ततस्ते हृष्टमनसः पाण्डवेया महारथाः।\nकुन्ती च परमप्रीता कृष्णा च सततं तथा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2012000, "chapter_id": 1245, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि हरणाहरणपर्वणि षट्चत्वारिंशदधिकद्विशततमोऽध्यायः॥ २४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]