[{"id": 2081390, "chapter_id": 2729, "verse_number": "१२-२३४-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2081391, "chapter_id": 2729, "verse_number": "१२-२३४-१", "content_sanskrit": "मग्नस्य व्यसने कृच्छ्रे किं श्रेयः पुरुषस्य हि।\nबन्धुनाशे महीपाल राज्यनाशेऽथवा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2081392, "chapter_id": 2729, "verse_number": "१२-२३४-२", "content_sanskrit": "त्वं हि नः परमो वक्ता लोकेऽस्मिन्भरतर्षभ।\nएतद्भवन्तं पृच्छामि तन्मे त्वं वक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2081393, "chapter_id": 2729, "verse_number": "१२-२३४-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2081394, "chapter_id": 2729, "verse_number": "१२-२३४-३", "content_sanskrit": "पुत्रदारैः सुखैश्चैव वियक्तस्य धनेन च।\nमग्नस्य व्यसने कृच्छ्रे धृतिः श्रेयस्करी नृप।\nधैर्येण युक्तस्य सतः शरीरं न विशीर्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2081395, "chapter_id": 2729, "verse_number": "१२-२३४-४", "content_sanskrit": "[विशोकता सुखं धत्ते धत्ते चारोग्यमुत्तमम्।]\nआरोग्याच्च शरीरस्य स पुनर्विन्दते श्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2081396, "chapter_id": 2729, "verse_number": "१२-२३४-५", "content_sanskrit": "यश्च प्राज्ञो नरस्तात सात्विकीं वृत्तिमास्थितः।\nतस्यैश्वर्यं च धैर्यं च व्यवसायश्च कर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2081397, "chapter_id": 2729, "verse_number": "१२-२३४-६", "content_sanskrit": "अत्रैवोदाहरन्तीममितिहासं पुरातनम्।\nबलिवासवसंवादं पुनरेव युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2081398, "chapter_id": 2729, "verse_number": "१२-२३४-७", "content_sanskrit": "वृत्ते देवासुरे युद्धे दैत्यदानवसंक्षये।\nविष्णुक्रान्तेषु लोकेषु देवराजे शतक्रतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2081399, "chapter_id": 2729, "verse_number": "१२-२३४-८", "content_sanskrit": "इज्यमानेषु देवेषु चातुर्वर्ण्ये व्यवस्थिते।\nसमृध्यमाने त्रैलोक्ये प्रीतियुक्ते स्वयंभुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2081400, "chapter_id": 2729, "verse_number": "१२-२३४-९", "content_sanskrit": "रुद्रैर्वसुभिरादित्यैरश्विभ्यामपि चर्षिभिः।\nगन्धर्वैर्भुजगेन्द्रैश्च सिद्धैश्चान्यैर्वृतः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2081401, "chapter_id": 2729, "verse_number": "१२-२३४-१०", "content_sanskrit": "चतुर्दन्तं सुदान्तं च वारणेन्द्रं श्रिया वृतम्।\nआरुह्यैरावणं शक्रस्त्रैलोक्यमनुसंययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2081402, "chapter_id": 2729, "verse_number": "१२-२३४-११", "content_sanskrit": "स कदाचित्समुद्रान्ते कस्मिंश्चिद्गिरिगह्वरे।\nबलिं वैरोचनिं वज्री ददर्शोपससर्प च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2081403, "chapter_id": 2729, "verse_number": "१२-२३४-१२", "content_sanskrit": "तमैरावतमूर्धस्थं प्रेक्ष्य देवगणैर्वृतम्।\nसुरेन्द्रमिन्द्रं दैत्येन्द्रो न शुशोच न विव्यथे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2081404, "chapter_id": 2729, "verse_number": "१२-२३४-१३", "content_sanskrit": "दृष्ट्वा तमविकारस्थं तिष्ठन्तं निर्भयं बलिम्।\nअधिरूढो द्विपश्रेष्ठमित्युवाच शतक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2081405, "chapter_id": 2729, "verse_number": "१२-२३४-१४", "content_sanskrit": "दैत्य न व्यथसे शौर्यादथवा वृद्धसेवया।\nतपसा भावितत्वाद्वा सर्वथैतत्सुदुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2081406, "chapter_id": 2729, "verse_number": "१२-२३४-१५", "content_sanskrit": "शत्रुभिर्वशमानीतो हीनः स्थानादनुत्तमात्।\nवैरोचने किमाश्रित्य शोचितव्ये न शोचसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2081407, "chapter_id": 2729, "verse_number": "१२-२३४-१६", "content_sanskrit": "श्रैष्ट्यं प्राप्य स्वजातीनां भुक्त्वा भोगाननुत्तमान्।\nहृतस्वरत्नराज्यस्त्वं ब्रूहि कस्मान्न शोचसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2081408, "chapter_id": 2729, "verse_number": "१२-२३४-१७", "content_sanskrit": "ईश्वरो हि पुरा भूत्वा पितृपैतामहे पदे।\nतत्त्वमद्य हृतं दृष्ट्वा सपत्नैः किं न शोचसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2081409, "chapter_id": 2729, "verse_number": "१२-२३४-१८", "content_sanskrit": "बद्धश्च वारुणैः पाशैर्वज्रेण च समाहतः।\nहृतदारो हृतधनो ब्रूहि कस्मान्न शोचसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2081410, "chapter_id": 2729, "verse_number": "१२-२३४-१९", "content_sanskrit": "नष्टश्रीर्विभवभ्रष्टो यन्न शोचसि दुष्करम्।\nत्रैलोक्यराज्यनाशे हि कोऽन्यो जीवितुमुत्सहेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2081411, "chapter_id": 2729, "verse_number": "१२-२३४-२०", "content_sanskrit": "एतच्चान्यच्च परुषं ब्रुवन्तं परिभूय तम्।\nश्रुत्वा दुःखमसंभ्रान्तो बलिर्वैरोचनोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2081412, "chapter_id": 2729, "verse_number": "१२-२३४-२१", "content_sanskrit": "निगृहीते मयि भृशं शक्र किं कत्थितेन ते।\nवज्रमुद्यम्य तिष्ठन्तं पश्यामि त्वां पुरंदर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2081413, "chapter_id": 2729, "verse_number": "१२-२३४-२२", "content_sanskrit": "अशक्तः पूर्वमासीस्त्वं कथंचिच्छक्ततां गतः।\nकस्त्वदन्य इमां वाचं सुक्रूरां वक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2081414, "chapter_id": 2729, "verse_number": "१२-२३४-२३", "content_sanskrit": "यस्तु शत्रोर्वशस्थस्य शक्तोऽपि कुरुते दयाम्।\nहस्तप्राप्तस्य वीरस्य तं चैव पुरुषं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2081415, "chapter_id": 2729, "verse_number": "१२-२३४-२४", "content_sanskrit": "अनिश्चयो हि युद्धेषु द्वयोर्विवदमानयोः।\nएकः प्राप्नोति विजयमेकश्चैव पराजयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2081416, "chapter_id": 2729, "verse_number": "१२-२३४-२५", "content_sanskrit": "मा च ते भूत्स्वभावोऽयं मयि दानवपुङ्गवे।\nईश्वरः सर्वभूतानां विक्रमेण जितो बलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2081417, "chapter_id": 2729, "verse_number": "१२-२३४-२६", "content_sanskrit": "नैतदस्मत्कृतं शक्र नैतच्छक्र कृतं त्वया।\nयत्त्वमेवं गतो वज्रिन्यद्वाऽऽप्येवं गता वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2081418, "chapter_id": 2729, "verse_number": "१२-२३४-२७", "content_sanskrit": "अहमासं यथाऽद्य त्वं भविता त्वं यथा वयम्।\nमावमंस्था मया कर्म दुष्कृतं कृतमित्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2081419, "chapter_id": 2729, "verse_number": "१२-२३४-२८", "content_sanskrit": "सुखदुःखे हि पुरुषः पर्यायेणाधिगच्छति।\nपर्यायेणासि शक्रत्वं प्राप्तः शक्र न कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2081420, "chapter_id": 2729, "verse_number": "१२-२३४-२९", "content_sanskrit": "कालः काले नयति मां त्वां च कालो नयत्ययम्।\nतेनाहं त्वं यथा नाद्य त्वं चापि न यथा वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2081421, "chapter_id": 2729, "verse_number": "१२-२३४-३०", "content_sanskrit": "न मातृपितृशुश्रूषा न च दैवतपूजनम्।\nनान्यो गुणसमाचारः पुरुषस्य सुखावहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2081422, "chapter_id": 2729, "verse_number": "१२-२३४-३१", "content_sanskrit": "न विद्या न तपो दानं न मित्राणि न बान्धवाः।\nशक्नुवन्ति परित्रातुं नरं कालेन पीडितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2081423, "chapter_id": 2729, "verse_number": "१२-२३४-३२", "content_sanskrit": "नागामिनमनर्थं हि प्रतिघातशतैरपि।\nशक्नुवन्ति प्रतिव्योढुमृते बुद्धिबलान्नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2081424, "chapter_id": 2729, "verse_number": "१२-२३४-३३", "content_sanskrit": "पर्यायैर्हन्यमानानां परित्राता न विद्यते।\nइदं तु दुःखं यच्छक्र कर्ताऽहमिति मन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2081425, "chapter_id": 2729, "verse_number": "१२-२३४-३४", "content_sanskrit": "यदि कर्ता भवेत्कर्ता न क्रियेत कदाचन।\nयस्मात्तु क्रियते कर्ता तस्मात्कर्ताऽप्यनीश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2081426, "chapter_id": 2729, "verse_number": "१२-२३४-३५", "content_sanskrit": "कालेन त्वाऽहमजयं कालेनाहं जितस्त्वया।\nगन्ता गतिमतां कालः कालः कलयति प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2081427, "chapter_id": 2729, "verse_number": "१२-२३४-३६", "content_sanskrit": "इन्द्र प्राकृतया बुद्ध्या प्रलपन्नावबुद्ध्यसे।\nकेचित्त्वां बहुमन्यन्ते श्रैष्ठ्यं प्राप्तं स्वकर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2081428, "chapter_id": 2729, "verse_number": "१२-२३४-३७", "content_sanskrit": "कथमस्मद्विधो नाम जानँल्लोकप्रवृत्तयः।\nकालेनाभ्याहतः शोचेन्मुह्येद्वाऽप्यथविभ्रमेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2081429, "chapter_id": 2729, "verse_number": "१२-२३४-३८", "content_sanskrit": "कथं कालपरीतस्य मम वा मद्विधस्य वा।\nबुद्धिर्व्यसनमासाद्य भिन्ना नौरिव सीदति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2081430, "chapter_id": 2729, "verse_number": "१२-२३४-३९", "content_sanskrit": "अहं च त्वं च ये चान्ये भविष्यन्ति सुराधिपाः।\nते सर्वे शक्र यास्यन्ति मार्गमिन्द्रशतैर्गतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2081431, "chapter_id": 2729, "verse_number": "१२-२३४-४०", "content_sanskrit": "त्वामप्येवं सुदुर्धर्षं ज्वलन्तं परया श्रिया।\nकाले परिणते कालः कलयिष्यति मामिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2081432, "chapter_id": 2729, "verse_number": "१२-२३४-४१", "content_sanskrit": "बहूनीन्द्रसहस्राणि दैवतानां युगे युगे।\nअभ्यतीतानि कालेन कालो हि दुरतिक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2081433, "chapter_id": 2729, "verse_number": "१२-२३४-४२", "content_sanskrit": "इदं तु लब्ध्वा संस्थानमात्मानं बहु मन्यसे।\nसर्वभूतभवं देवं ब्रह्माणमिव शाश्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2081434, "chapter_id": 2729, "verse_number": "१२-२३४-४३", "content_sanskrit": "न चेदमचलं स्थानमनन्तं वाऽपि कस्यचित्।\nत्वं तु बालिशया बुद्ध्या ममेदमिति मन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2081435, "chapter_id": 2729, "verse_number": "१२-२३४-४४", "content_sanskrit": "अविश्वस्ते विश्वसिषि मन्यसे वाऽध्रुवे ध्रुवम्।\nनित्यं कालपरीतात्मा भवत्येवं सुरेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2081436, "chapter_id": 2729, "verse_number": "१२-२३४-४५", "content_sanskrit": "ममेयमिति मोहात्त्वं राजश्रियमभीप्ससि।\nनेयं तव न चास्माकं न चान्येषां स्थिरा मता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2081437, "chapter_id": 2729, "verse_number": "१२-२३४-४६", "content_sanskrit": "अतिक्रम्य बहूनन्यांस्त्वयि तावदियं गता।\nकंचित्कालमियं स्थित्वा त्वयि वासव चञ्चला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2081438, "chapter_id": 2729, "verse_number": "१२-२३४-४७", "content_sanskrit": "गौर्निवासमिवोत्सृज्य पुनरन्यं गमिष्यति।\nसुरेशा ये ह्यतिक्रान्तास्तान्न संख्यातुमुत्सहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2081439, "chapter_id": 2729, "verse_number": "१२-२३४-४८", "content_sanskrit": "त्वत्तो बहुतराश्चान्ये भविष्यन्ति पुरंदर।\nसवृक्षौषधिगुल्मेयं ससरित्पर्वताकरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2081440, "chapter_id": 2729, "verse_number": "१२-२३४-४९", "content_sanskrit": "तानिदानीं न पश्यामि यैर्भुक्तेयं पुरा मही।\nपृथुरैलो मयो भीमो नरकः शम्बरस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2081441, "chapter_id": 2729, "verse_number": "१२-२३४-५०", "content_sanskrit": "अश्वग्रीवः पुलोमा च स्वर्भानुरमितप्रभः]\nप्रह्लादो नमुचिर्दक्षो विप्रचित्तिर्विरोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2081442, "chapter_id": 2729, "verse_number": "१२-२३४-५१", "content_sanskrit": "ह्रीनिषेवः सुहोत्रश्च भूरिहा पुष्पवान्वृषः।\nसत्येषुर्ऋषभो बाहुः कपिलाश्वो निरूपकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2081443, "chapter_id": 2729, "verse_number": "१२-२३४-५२", "content_sanskrit": "बाणः कार्तस्वरो वह्निर्विश्वदंष्ट्रोऽथ नैर्ऋतिः।\nसंकोचोऽथ वरीताक्षो वराहाश्वो रुचिप्रभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2081444, "chapter_id": 2729, "verse_number": "१२-२३४-५३", "content_sanskrit": "विश्वजित्प्रतिरूपश्च वृषाण्डो विष्करो मधुः।\nहिरण्यकशिपुश्चैव कैटभश्चैव दानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2081445, "chapter_id": 2729, "verse_number": "१२-२३४-५४", "content_sanskrit": "दैतेया दानवाश्चैव सर्वे ते नैर्ऋतैः सह।\nएते चान्ये च बहवः पूर्वे पूर्वतराश्च ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2081446, "chapter_id": 2729, "verse_number": "१२-२३४-५५", "content_sanskrit": "दैत्येन्द्रा दानवेन्द्राश्च यांश्चान्याननुशुश्रुम्।\nबहवः पूर्वदैत्येन्द्राः संत्यज्य पृथिवीं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2081447, "chapter_id": 2729, "verse_number": "१२-२३४-५६", "content_sanskrit": "कालेनाभ्याहताः सर्वे कालो हि बलवत्तरः।\nसर्वैः क्रतुशतैरिष्टं न त्वमेकः शतक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2081448, "chapter_id": 2729, "verse_number": "१२-२३४-५७", "content_sanskrit": "सर्वे धर्मपराश्चासन्सर्वे सततसत्रिणः।\nअन्तरिक्षचराः सर्वे सर्वेऽभिमुखयोधिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2081449, "chapter_id": 2729, "verse_number": "१२-२३४-५८", "content_sanskrit": "सर्वे संहननोपेताः सर्वे परिघबाहवः।\nसर्वे मायाशतधराः सर्वे ते कामरूपिणः।\nसर्वे समरमासाद्य न श्रूयन्ते पराजिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2081450, "chapter_id": 2729, "verse_number": "१२-२३४-५९", "content_sanskrit": "सर्वे सत्यव्रतपराः सर्वे कामविहारिणः।\nसर्वे वेदव्रतपराः सर्वे चैव बहुश्रुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2081451, "chapter_id": 2729, "verse_number": "१२-२३४-६०", "content_sanskrit": "सर्वे संमतमैश्वर्यमीश्वराः प्रतिपेदिरे।\nन चैश्वर्यमदस्तेषां भूतपूर्वो महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2081452, "chapter_id": 2729, "verse_number": "१२-२३४-६१", "content_sanskrit": "सर्वे यथार्हदातारः सर्वे विगतमत्सराः।\nसर्वे सर्वेषु भूतेषु यथावत्प्रतिपेदरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2081453, "chapter_id": 2729, "verse_number": "१२-२३४-६२", "content_sanskrit": "सर्वे दाक्षायणीपुत्राः प्राजपत्या महाबलाः।\nज्वलन्तः प्रतपन्तश्च कालेन प्रतिसंहृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2081454, "chapter_id": 2729, "verse_number": "१२-२३४-६३", "content_sanskrit": "त्वं चैवेमां यदा भुक्त्वा पृथिवीं त्यक्ष्यसे पुनः।\nन शक्ष्यसि तदा शक्र नियन्तुं शोकमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2081455, "chapter_id": 2729, "verse_number": "१२-२३४-६४", "content_sanskrit": "मुञ्चेच्छां कामभोगेषु मुञ्जेमं श्रीभवं मदम्।\nएवं स्वराज्यनाशे त्वं शोकं संप्रसहिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2081456, "chapter_id": 2729, "verse_number": "१२-२३४-६५", "content_sanskrit": "शोककाले शुचो मा त्वं हर्षकाले च मा हृषः।\nअतीतानागतं हित्वा प्रत्युत्पन्नेन वर्तय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2081457, "chapter_id": 2729, "verse_number": "१२-२३४-६६", "content_sanskrit": "मां चेदभ्यागतः कालः सदा युक्तमतन्द्रितः।\nक्षमस्व न चिरादिन्द्र त्वामप्युपगमिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2081458, "chapter_id": 2729, "verse_number": "१२-२३४-६७", "content_sanskrit": "त्रासयन्निव देवेन्द्र वाग्भिस्तक्षसि मामिह।\nसंयते मयि ननं त्वमात्मानं बहु मन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2081459, "chapter_id": 2729, "verse_number": "१२-२३४-६८", "content_sanskrit": "कालः प्रथममायान्मां पञ्चात्त्वामनुधावति।\nतेन गर्जसि देवेन्द्र पूर्वं कालहते मयि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2081460, "chapter_id": 2729, "verse_number": "१२-२३४-६९", "content_sanskrit": "को हि स्थातुमलं लोके मम क्रुद्धस्य संयुगे।\nकालस्तु बलवान्प्राप्तस्तेन तिष्ठसि वासव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2081461, "chapter_id": 2729, "verse_number": "१२-२३४-७०", "content_sanskrit": "यत्तद्वर्षसहस्रान्तं तूर्णं भवितुमर्हति।\nयथा मे सर्वगात्राणि न सुस्थानि महौजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2081462, "chapter_id": 2729, "verse_number": "१२-२३४-७१", "content_sanskrit": "अहमैन्द्राच्च्युतः स्थानात्त्वमिन्द्रः प्रकृतो दिवि।\nसुचित्रे जीवलोकेऽस्मिन्नुपास्यः कालपर्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2081463, "chapter_id": 2729, "verse_number": "१२-२३४-७२", "content_sanskrit": "किं हि कृत्वा स्वमिन्द्रोऽद्य किं वा कृत्वा वयं च्युताः।\nकालः कर्ता विकर्ता च सर्वमन्यदकारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2081464, "chapter_id": 2729, "verse_number": "१२-२३४-७३", "content_sanskrit": "नाशं विनाशमैश्वर्यं सुखदुःखे भवाभवौ।\nविद्वान्प्राप्यैवमत्यर्थं न प्रहृष्येन्न च व्यथेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2081465, "chapter_id": 2729, "verse_number": "१२-२३४-७४", "content_sanskrit": "त्वमेव हीन्द्र वेत्थास्मान्वेदाहं त्वां च वासव।\nकिं कत्थसे मां किंच त्वं कालेन निरपत्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2081466, "chapter_id": 2729, "verse_number": "१२-२३४-७५", "content_sanskrit": "त्वमेव हि पुरा वेत्थ यत्तदा पौरुषं मम।\nसमरेषु च विक्रान्तं पर्याप्तं तन्निदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2081467, "chapter_id": 2729, "verse_number": "१२-२३४-७६", "content_sanskrit": "आदित्याश्चैव रुद्राश्च साध्याश्च वसुभिः सह।\nमया विनिर्जिताः पूर्वं मरुतश्च शचीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2081468, "chapter_id": 2729, "verse_number": "१२-२३४-७७", "content_sanskrit": "त्वमेव शक्र जानासि देवासुरसमागमे।\nसमेता विबुधा भग्नास्तरसा समरे मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2081469, "chapter_id": 2729, "verse_number": "१२-२३४-७८", "content_sanskrit": "पर्वताश्चासकृत्क्षिप्ताः सवनाः सवनौकसः।\nसशृङ्गशिखरा भग्नाः समरे मूर्ध्निं ते मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2081470, "chapter_id": 2729, "verse_number": "१२-२३४-७९", "content_sanskrit": "किं नु शक्यं मया कर्तुं कालो हि दुरतिक्रमः।\nन हि त्वां नोत्सहे हन्तुं सवज्रमपि मुष्टिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2081471, "chapter_id": 2729, "verse_number": "१२-२३४-८०", "content_sanskrit": "न तु विक्रमकालोऽयं क्षमाकालोऽयमागतः।\nतेन त्वां मर्षये शक्र दुर्मर्षणतरस्त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2081472, "chapter_id": 2729, "verse_number": "१२-२३४-८१", "content_sanskrit": "तं मां परिणते काले परीतं कालवह्निना।\nनियतं कालपाशेन बद्धं शक्र विकत्थसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2081473, "chapter_id": 2729, "verse_number": "१२-२३४-८२", "content_sanskrit": "अयं स पुरुषः श्यामो लोकस्य दुरतिक्रमः।\nबद्ध्वा तिष्ठति मां रौद्रः पशुं रशनया यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2081474, "chapter_id": 2729, "verse_number": "१२-२३४-८३", "content_sanskrit": "लाभालाभौ सुखं दुःखं कामक्रोधौ भवाभवौ।\nवधो बन्धप्रमोक्षश्च सर्वं कालेन लभ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2081475, "chapter_id": 2729, "verse_number": "१२-२३४-८४", "content_sanskrit": "नाहं कर्ता न कर्ता त्वं कर्ता यस्तु सदा प्रभुः।\nसोयं पचति कालो मां वृक्षे फलमिवागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2081476, "chapter_id": 2729, "verse_number": "१२-२३४-८५", "content_sanskrit": "यान्येव पुरुषः कुर्वन्सुखैः कालेन युज्यते।\nपुनस्तान्येव कुर्वाणो दुःखैः कालेन युज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2081477, "chapter_id": 2729, "verse_number": "१२-२३४-८६", "content_sanskrit": "न च कालेन कालज्ञः स्पृष्टः शोचितुमर्हति।\nतेन शक्र न शोचामि नास्ति शोके सहायता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2081478, "chapter_id": 2729, "verse_number": "१२-२३४-८७", "content_sanskrit": "यदा हि शोचतः शोको व्यसनं नाषकर्षति।\nसामर्थ्यं शोचतो नास्तीत्यतोऽहं नाद्य शोचिमि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2081479, "chapter_id": 2729, "verse_number": "१२-२३४-८८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2081480, "chapter_id": 2729, "verse_number": "१२-२३४-८८", "content_sanskrit": "एवमुक्तः सहस्राक्षो भगवान्पाकशासनः।\nप्रतिसंहृत्य संरम्भमित्युवाच शतक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2081481, "chapter_id": 2729, "verse_number": "१२-२३४-८९", "content_sanskrit": "सवज्रमुद्यतं बाहुं दृष्ट्वा पाशांश्च वारुणान्।\nकस्येह न व्यथेद्बुद्धिर्मृत्योरपि जिघांसतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2081482, "chapter_id": 2729, "verse_number": "१२-२३४-९०", "content_sanskrit": "सा ते न व्यथते बुद्धिरचला तत्त्वदर्शिनी।\nव्रुवन्न व्यथसेऽद्य त्वं धैर्यात्सत्यपराक्रम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2081483, "chapter_id": 2729, "verse_number": "१२-२३४-९१", "content_sanskrit": "को हि विश्वासमर्थेषु शरीरे वा शरीरभृत्।\nकर्तुमुत्सहते लोके दृष्ट्वा संप्रस्थितं जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2081484, "chapter_id": 2729, "verse_number": "१२-२३४-९२", "content_sanskrit": "अहमप्येवमेवैनं लोकं जानाम्यशाश्वतम्।\nकालाग्नावाहितं घोरे गुह्ये सततगेऽक्षरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2081485, "chapter_id": 2729, "verse_number": "१२-२३४-९३", "content_sanskrit": "न चात्र परिहारोऽस्ति कालस्पृष्टस्य कस्यचित्।\nसूक्ष्माणां महतां चैव भूतानां परिपच्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2081486, "chapter_id": 2729, "verse_number": "१२-२३४-९४", "content_sanskrit": "अनीशस्याप्रमत्तस्य भूतानि पचतः सदा।\nअनिवृत्तस्य कालस्य क्षयं प्राप्तो न मुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2081487, "chapter_id": 2729, "verse_number": "१२-२३४-९५", "content_sanskrit": "अप्रमत्तः प्रमत्तेषु कालो जागर्ति देहिषु।\nप्रयत्नेनाप्यपक्रान्तो दृष्टपूर्वो न केनचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2081488, "chapter_id": 2729, "verse_number": "१२-२३४-९६", "content_sanskrit": "पुराणः शाश्वतो धर्मः सर्वप्राणभृतां समः।\nकालो न परिहार्यश्च न चास्यास्ति व्यतिक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2081489, "chapter_id": 2729, "verse_number": "१२-२३४-९७", "content_sanskrit": "अहोरात्रांश्च मासांश्च क्षणान्काष्ठा लवान्कलाः।\nसंपीडयति यः कालो वृद्धिं वार्धुपिको यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2081490, "chapter_id": 2729, "verse_number": "१२-२३४-९८", "content_sanskrit": "इदमद्य करिष्यामि श्वः कर्ताऽस्मीति वादिनम्।\nकालो हरति संप्राप्तो नदीवेग इव द्रुमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2081491, "chapter_id": 2729, "verse_number": "१२-२३४-९९", "content_sanskrit": "इदानीं तावदेवासौ मया दृष्टः कथं मृतः।\nइति कालेन ह्रियतां प्रलापः श्रूयते नृणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2081492, "chapter_id": 2729, "verse_number": "१२-२३४-१००", "content_sanskrit": "नश्यन्त्यर्थास्तथा भोगाः स्थानमैश्वर्यमेव च।\nजीवितं जीवलोकस्य कालेनागम्य नीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2081493, "chapter_id": 2729, "verse_number": "१२-२३४-१०१", "content_sanskrit": "उच्छ्राया विनिपातान्ता भावोऽभावः स एव च।\nअनित्यमध्रुवं सर्वं व्यवसायो हि दुष्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2081494, "chapter_id": 2729, "verse_number": "१२-२३४-१०२", "content_sanskrit": "सा ते न व्यथते बुद्धिरचला तत्त्वदर्शिनी।\nअहमासं पुरा चेति मनसाऽपि न बुद्ध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2081495, "chapter_id": 2729, "verse_number": "१२-२३४-१०३", "content_sanskrit": "कालेनाक्रम्य लोकेऽस्मिन्पच्यमाने बलीयसा।\nअज्येष्ठमकनिष्ठं च क्षिप्यमाणो न बुद्ध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2081496, "chapter_id": 2729, "verse_number": "१२-२३४-१०४", "content_sanskrit": "ईर्ष्याभिमानलोभेषु कामक्रोधभयेषु च।\nस्पृहामोहाभिमानेषु लोकः सक्तो विमुह्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2081497, "chapter_id": 2729, "verse_number": "१२-२३४-१०५", "content_sanskrit": "भवांस्तु भावतत्त्वज्ञो विद्वाञ्ज्ञानतपोन्वितः।\nकालं पश्यति सुव्यक्तं पाणावामलकं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2081498, "chapter_id": 2729, "verse_number": "१२-२३४-१०६", "content_sanskrit": "कालचारित्रतत्त्वज्ञः सर्वशास्त्रविशारदः।\nवैरोचते कृतार्थोऽसि स्पृहणीयो विजानताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2081499, "chapter_id": 2729, "verse_number": "१२-२३४-१०७", "content_sanskrit": "सर्वलोको ह्ययं मन्ये बुद्ध्या परिगतस्त्वया।\nविहरन्सर्वतोमुक्तो न क्वचिच्च विषीदसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2081500, "chapter_id": 2729, "verse_number": "१२-२३४-१०८", "content_sanskrit": "रजश्च हि तमश्च त्वां स्पृशते न जितेन्द्रियम्।\nनिष्प्रीतिं नष्टसंतापमात्मानं त्वमुपाससे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2081501, "chapter_id": 2729, "verse_number": "१२-२३४-१०९", "content_sanskrit": "सुहृदं सर्वभूतानां निर्वैरं शान्तमानसम्।\nदृष्ट्वा त्वां मम संजाता त्वय्यनुक्रोशिनी मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2081502, "chapter_id": 2729, "verse_number": "१२-२३४-११०", "content_sanskrit": "नाहमेतादृशं बुद्धं हन्तुमिच्छामि बन्धनैः।\nआनृशंस्यं परो धर्मो ह्यनुक्रोशश्च मे त्वयि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2081503, "chapter_id": 2729, "verse_number": "१२-२३४-१११", "content_sanskrit": "मोक्ष्यन्ते वारुणाः पाशास्तवेमे कालपर्ययात्।\nप्रजानामुपचारेण स्वस्ति तेऽस्तु महासुर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2081504, "chapter_id": 2729, "verse_number": "१२-२३४-११२", "content_sanskrit": "यदा श्वश्रूं स्नुषा वृद्धां परिचारेण योक्ष्यते।\nपुत्रश्च पितरं मोहात्प्रेषयिष्यति कर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2081505, "chapter_id": 2729, "verse_number": "१२-२३४-११३", "content_sanskrit": "ब्राह्मणैः कारयिष्यन्ति वृषलाः पादधावनम्।\nशूद्राश्च ब्राह्मणीं भार्यामुपयास्यन्ति निर्भयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2081506, "chapter_id": 2729, "verse_number": "१२-२३४-११४", "content_sanskrit": "वियोनिषु विमोक्ष्यन्ति बीजानि पुरुषा यदा।\nसंकरं कांस्यभाण्डैश्च बलिं चैव कुपात्रकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2081507, "chapter_id": 2729, "verse_number": "१२-२३४-११५", "content_sanskrit": "चातुर्वर्ण्यं यदा कृत्स्नममर्यादं भविष्यति।\nएकैकस्ते तदा पाशः क्रमशः परिमोक्ष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2081508, "chapter_id": 2729, "verse_number": "१२-२३४-११६", "content_sanskrit": "अस्मत्तस्ते भयं नास्ति समयं प्रतिपालय।\nसुखी भव निराबाधः स्वस्थचेता निरामयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2081509, "chapter_id": 2729, "verse_number": "१२-२३४-११७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2081510, "chapter_id": 2729, "verse_number": "१२-२३४-११७", "content_sanskrit": "तमेवमुक्त्वा भगवाञ्छतक्रतुः\nप्रतिप्रयातो गजराजवाहनः।\nविजित्य सर्वानसुरान्सुराधिपो\nननन्द हर्षेण बभूव चैकराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2081511, "chapter_id": 2729, "verse_number": "१२-२३४-११८", "content_sanskrit": "महर्षयस्तुष्टुवुरञ्जसा च तं\nवृषाकर्पि सर्वचराचरेश्वरम्।\nहिमापहो हव्यमुवाह चाध्वरे\nतथाऽमृतं चार्पितमीश्वरोऽपि हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2081512, "chapter_id": 2729, "verse_number": "१२-२३४-११९", "content_sanskrit": "द्विजोत्तमैः सर्वगतैरभिष्टुतो\nविदीप्ततेजाः शतमन्युरीश्वरः।\nप्रशान्तचेता मुदितः स्वमालयं\nत्रिविष्टपं प्राप्य मुमोद वासवः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2081513, "chapter_id": 2729, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि चतुस्त्रिंशदधिकद्विशततमोऽध्यायः॥ २३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}]