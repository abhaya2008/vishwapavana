[{"id": 2021989, "chapter_id": 1457, "verse_number": "३-९५-०x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2021990, "chapter_id": 1457, "verse_number": "३-९५-१", "content_sanskrit": "यदात्वमन्यतागस्त्यो गार्हस्थ्ये तां क्षमामिति।\nतदाऽभिगम्य प्रोवाच वैदर्भं पृथिवीपतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2021991, "chapter_id": 1457, "verse_number": "३-९५-२", "content_sanskrit": "राजन्निवेशे बुद्धिर्मे वर्तते पुत्रकारणात्।\nवरयेत्वां महीपाल लोपामुद्रां प्रयच्छ मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2021992, "chapter_id": 1457, "verse_number": "३-९५-३", "content_sanskrit": "एवमुक्तः स मिनिना महीपालो विचेतनः।\nप्रत्याख्यानाय चाशक्तः प्रदातुं चैव नैच्छत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2021993, "chapter_id": 1457, "verse_number": "३-९५-४", "content_sanskrit": "ततः स भार्यामभ्येत्य प्रोवाच पृथिवीपतिः।\nमहर्षिर्वीर्यवानेष क्रुद्धः शापाग्निना दहेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2021994, "chapter_id": 1457, "verse_number": "३-९५-५", "content_sanskrit": "तं तथा दुःखितं दृष्ट्वा सभार्यं पृथिवीपतिम्।\nलोपामुद्राऽभिगम्येदं काले वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2021995, "chapter_id": 1457, "verse_number": "३-९५-६", "content_sanskrit": "न मत्कृते महीपाल पीडामभ्येतुमर्हसि।\nप्रयच्छ मामगस्त्याय त्राह्यात्मानं मया पितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2021996, "chapter_id": 1457, "verse_number": "३-९५-७", "content_sanskrit": "दुहितुर्वचनाद्राजा सोऽगस्त्याय महात्मने।\nलोपामुद्रां ततः प्रादाद्विधिपूर्वं विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2021997, "chapter_id": 1457, "verse_number": "३-९५-८", "content_sanskrit": "प्राप्य भार्यामगस्त्यस्तु लोपामुद्रामभाषत।\nमहार्हाण्युत्सृजैतानि वासांस्याभरणानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2021998, "chapter_id": 1457, "verse_number": "३-९५-९", "content_sanskrit": "ततः सा दर्शनीयानि महार्हाणि तनूनि च।\nसमुत्ससर्ज रम्भोरूर्वसनान्यायतेक्षणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2021999, "chapter_id": 1457, "verse_number": "३-९५-१०", "content_sanskrit": "ततश्चीराणि जग्राह वल्कलान्यजिनानि च।\nसमानव्रतचर्या च बभूवायतलोचना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2022000, "chapter_id": 1457, "verse_number": "३-९५-११", "content_sanskrit": "गङ्गाद्वारमथागम्य भगवानृषिसत्तमः।\nउग्रमातिष्ठत तपः सह पत्न्याऽनुकूलया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2022001, "chapter_id": 1457, "verse_number": "३-९५-१२", "content_sanskrit": "सा प्रीत्या बहुमानाच्च पतिं पर्यचरत्तदा।\nअगस्त्यश्च परां प्रीतिं भार्यायामगमत्प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2022002, "chapter_id": 1457, "verse_number": "३-९५-१३", "content_sanskrit": "ततो बहुतिथे काले लोपामुद्रां विशांपते।\nतपसा द्योतितां स्नातां ददर्श भगवानृषिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2022003, "chapter_id": 1457, "verse_number": "३-९५-१४", "content_sanskrit": "स तस्याः परिचारेण शौचेन च दमेन च।\nश्रिया रूपेण च प्रीतो मैथुनायाजुहाव ताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2022004, "chapter_id": 1457, "verse_number": "३-९५-१५", "content_sanskrit": "ततः सा प्राञ्जलिर्भूत्वा लज्जमानेव भामिनी।\nतदा सप्रणयं वाक्यं भगवन्तमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2022005, "chapter_id": 1457, "verse_number": "३-९५-१६", "content_sanskrit": "असंशयं प्रजाहेतोर्भार्यां पतिरविन्दत।\nपा तु त्वयि मम प्रीतिस्तामृषे कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2022006, "chapter_id": 1457, "verse_number": "३-९५-१७", "content_sanskrit": "यथा पितुर्गृहे विप्र प्रासादे शयनं मम।\nतथाविधे त्वं शयने मामुपैतुमिहार्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2022007, "chapter_id": 1457, "verse_number": "३-९५-१८", "content_sanskrit": "इच्छामि त्वां स्रग्विणं च भूषणैश्च विभूषितम्।\nउपसर्तुं यथाकामं दिव्याभरणभूषिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2022008, "chapter_id": 1457, "verse_number": "३-९५-१९", "content_sanskrit": "अन्यथा नोपतिष्ठेयं चीरकाषायवासिनी।\nनैवापवित्रो विप्रर्षे भूषणोयं कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2022009, "chapter_id": 1457, "verse_number": "३-९५-२०x", "content_sanskrit": "अगस्त्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2022010, "chapter_id": 1457, "verse_number": "३-९५-२०", "content_sanskrit": "न ते धनानि विद्यन्ते लोपामुद्रे तथा मम।\nयथाविधानि कल्याणि पितुस्तव सुमध्यमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2022011, "chapter_id": 1457, "verse_number": "३-९५-२१x", "content_sanskrit": "लोपामुद्रोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2022012, "chapter_id": 1457, "verse_number": "३-९५-२१", "content_sanskrit": "ईशोसि तपसा सर्वं समाहर्तुं तपोधन।\nक्षणेन जीवलोके यद्वसु किंचन विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2022013, "chapter_id": 1457, "verse_number": "३-९५-२२x", "content_sanskrit": "अगस्त्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2022014, "chapter_id": 1457, "verse_number": "३-९५-२२", "content_sanskrit": "एवमेतद्यथाऽऽत्थ त्वं तपोव्ययकरं तु तत्।\nयथा तु मे न नश्येत तपस्तन्मां प्रयोदय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2022015, "chapter_id": 1457, "verse_number": "३-९५-२३x", "content_sanskrit": "लोपामुद्रोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2022016, "chapter_id": 1457, "verse_number": "३-९५-२३", "content_sanskrit": "अल्पावशिष्टः कालोऽयमृतोर्मम तपोधन।\nन चान्यथाऽहमिच्छामि त्वामुपैतुं कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2022017, "chapter_id": 1457, "verse_number": "३-९५-२४", "content_sanskrit": "न चापि धर्ममिच्छामि विलोप्तुं ते कथंचन।\nएवं तु मे यथाकामं संपादयितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2022018, "chapter_id": 1457, "verse_number": "३-९५-२५x", "content_sanskrit": "अगस्तय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2022019, "chapter_id": 1457, "verse_number": "", "content_sanskrit": "यद्येष काम सुभगे तव बुद्ध्या विनिश्चितः।\nहर्तुं गच्छाम्यहं भद्रे चर काममिह स्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]