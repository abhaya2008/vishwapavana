[{"id": 2059022, "chapter_id": 2272, "verse_number": "७-१९९-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2059023, "chapter_id": 2272, "verse_number": "७-१९९-१", "content_sanskrit": "साङ्गा वेदा यथान्यायं येनाधीता महात्मना।\nयस्मिन्साक्षाद्धनुर्वेदो हीनिषेवे प्रतिष्ठितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2059024, "chapter_id": 2272, "verse_number": "७-१९९-२", "content_sanskrit": "यस्य प्रसादात्कुर्वन्ति कर्माणि पुरुषर्षभाः।\nअमानुषाणि सङ्ग्रामे देवैरसुकराणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2059025, "chapter_id": 2272, "verse_number": "७-१९९-३", "content_sanskrit": "तस्मिन्नाक्रुश्यति द्रोणे समक्षं पापकर्मणा।\nनीचं कर्म कृतं तेन क्षुद्रेण गुरुघातिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2059026, "chapter_id": 2272, "verse_number": "७-१९९-४", "content_sanskrit": "नामर्षं तत्र कुर्वन्ति धिक्क्षात्रं धिगमर्षिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2059027, "chapter_id": 2272, "verse_number": "७-१९९-५", "content_sanskrit": "पार्थाः सर्वे च राजानः पृथिव्यां ये धनुर्धराः।\nश्रुत्वा किमाहुः पाञ्चाल्यं तन्ममाचक्ष्व सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2059028, "chapter_id": 2272, "verse_number": "७-१९९-६x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2059029, "chapter_id": 2272, "verse_number": "७-१९९-६", "content_sanskrit": "श्रुत्वा द्रुपदपुत्रस्य ता वाचः क्रूरकर्मणः।\nतूष्णीं बभूवू राजानः सर्व एव विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2059030, "chapter_id": 2272, "verse_number": "७-१९९-७", "content_sanskrit": "अर्जुनस्तु कटाक्षेण जिह्मं विप्रेक्ष्य पार्षतम्।\nसबाष्पमतिनिःश्वस्य धिग्धिगित्येव चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2059031, "chapter_id": 2272, "verse_number": "७-१९९-८", "content_sanskrit": "युधिष्ठिरश्च भीमश्च यमौ कृष्णस्तथाऽपरे।\nआसन्सुव्रीडिता राजन्सात्यकिस्त्वब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2059032, "chapter_id": 2272, "verse_number": "७-१९९-९", "content_sanskrit": "नेहास्ति पुरुषः कश्चिद्य इमं पापपूरुषम्।\nभाषमाणमकल्याणं शीघ्रं हन्यान्नराधमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2059033, "chapter_id": 2272, "verse_number": "७-१९९-१०", "content_sanskrit": "एते त्वां पाण्डवाः सर्वे कुत्सयन्ति विवित्सया।\nकर्मणा तेन पापेन श्वपाकं ब्राह्मणा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2059034, "chapter_id": 2272, "verse_number": "७-१९९-११", "content_sanskrit": "एतत्कृत्वा महत्पापं निन्दितः सर्वसाधुभिः।\nन लज्जसे कथं वक्तुं समितिं प्राप्य शोभनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2059035, "chapter_id": 2272, "verse_number": "७-१९९-१२", "content_sanskrit": "कथं च शतधा जिह्वा न ते मूर्धा च दीर्यते।\nगुरुमाक्रोशतः क्षुद्र न चाधर्मेण पात्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2059036, "chapter_id": 2272, "verse_number": "७-१९९-१३", "content_sanskrit": "वाच्यस्त्वमसि पार्थैश्च सर्वैश्चान्धकवृष्णिभिः।\nयत्कर्म कलुषं कृत्वा श्लाघसे जनसंसदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2059037, "chapter_id": 2272, "verse_number": "७-१९९-१४", "content_sanskrit": "अकार्यं तादृशं कृत्वा पुनरेव गुरुं क्षिपन्।\nवध्यस्त्वं न त्वयार्थोऽस्ति मुहूर्तमपि जीवता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2059038, "chapter_id": 2272, "verse_number": "७-१९९-१५", "content_sanskrit": "कस्त्वेतद्व्यवसेत्पायं त्वदन्यः पुरुषाधम।\nनिगृह्य केशेषु वधं गुरोर्धर्मात्मनः सतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2059039, "chapter_id": 2272, "verse_number": "७-१९९-१६", "content_sanskrit": "सप्तावरे तथा पूर्वे बान्धवास्ते निमञ्जिताः।\nयशसा च परित्यक्तास्त्वां प्राप्य कुलपांसनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2059040, "chapter_id": 2272, "verse_number": "७-१९९-१७", "content_sanskrit": "उक्तवांश्चापि यत्पार्थे भीष्मं प्रति नरर्षभ।\nतथान्तो विहितस्तेन स्वयमेव महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2059041, "chapter_id": 2272, "verse_number": "७-१९९-१८", "content_sanskrit": "तस्यापि तव सोदर्यो निहन्ता पापकृत्तमः।\nनान्यः पाञ्चालपुत्रेभ्यो विद्यते भुवि पापकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2059042, "chapter_id": 2272, "verse_number": "७-१९९-१९", "content_sanskrit": "स चापि सृष्टः पित्रा ते भीष्मस्यान्तकरः किल।\nशिखण्डी रक्षितस्तेन स च मृत्युर्महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2059043, "chapter_id": 2272, "verse_number": "७-१९९-२०", "content_sanskrit": "पाञ्चालाश्चलिता धर्मात्क्षुद्रा मित्रगुरुद्रुहः।\nत्वां प्राप्य सहसोदर्यं धिक्कृतं सर्वसाधुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2059044, "chapter_id": 2272, "verse_number": "७-१९९-२१", "content_sanskrit": "पुनश्चेदीदृशीं वाचं मत्समीपे वदिष्यसि।\nशिरस्ते पोथयिष्यामि गदया वज्रकल्पया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2059045, "chapter_id": 2272, "verse_number": "७-१९९-२२", "content_sanskrit": "त्वां च ब्रह्महणं दृष्ट्वा जनः सूर्यमवेक्षते।\nब्रह्महत्या हि ते पापं प्रायश्चित्तार्थमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2059046, "chapter_id": 2272, "verse_number": "७-१९९-२३", "content_sanskrit": "पाञ्चालक सुदुर्वृत्त ममैव गुरुमग्रतः।\nगुरोर्गुरुं च भूयोऽपि क्षिपन्नैव हि लज्जसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2059047, "chapter_id": 2272, "verse_number": "७-१९९-२४", "content_sanskrit": "तिष्ठतिष्ठ सहस्वैकं गदापातमिमं मम।\nतव चापि सहिष्येऽहं गदापाताननेकशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2059048, "chapter_id": 2272, "verse_number": "७-१९९-२५", "content_sanskrit": "सात्वतेनैवमाक्षिप्तः पार्षतः परुषाक्षरम्।\nसंरब्धं सात्यकिं प्राह सङ्क्रुद्धः प्रहसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2059049, "chapter_id": 2272, "verse_number": "७-१९९-२६x", "content_sanskrit": "धृष्टद्युम्न उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2059050, "chapter_id": 2272, "verse_number": "७-१९९-२६", "content_sanskrit": "श्रूयतेश्रूयते चेति क्षम्यते चेति माधव।\nसदाऽनार्योऽशुभः साधुं पुरुषं क्षेप्तुमिच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2059051, "chapter_id": 2272, "verse_number": "७-१९९-२७", "content_sanskrit": "क्षमा प्रशस्यते लोके न तु पापोऽर्हति क्षमाम्।\nक्षमावन्तं हि पापात्मा जितोऽयमिति मन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2059052, "chapter_id": 2272, "verse_number": "७-१९९-२८", "content_sanskrit": "स त्वं क्षुद्रसमाचारो नीचात्मा पापनिश्चयः।\nआकेशाग्रान्नखाग्राच्च वक्तव्यो वक्तुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2059053, "chapter_id": 2272, "verse_number": "७-१९९-२९", "content_sanskrit": "`वरं हि ते मृतिः पाप न च ते चित्तमीदृशम्।\nश्रोतुं वक्तव्यतामूलं नीचाचाराश्च मानवाः।\nपरान्क्षिपन्ति दोषेण स्वेषु दोषेष्वदृष्टयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2059054, "chapter_id": 2272, "verse_number": "७-१९९-३०", "content_sanskrit": "यः स भूरिश्रवाश्छिन्नभुजः प्रायगतस्त्वया।\nवार्यमाणेन हि हतस्ततः पापतरं नु किम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2059055, "chapter_id": 2272, "verse_number": "७-१९९-३१", "content_sanskrit": "प्रेषमाणो मया द्रोणो दिव्येनास्त्रेण संयुगे।\nविसृष्टशस्त्रो निहतः किं तत्र कुर दुष्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2059056, "chapter_id": 2272, "verse_number": "७-१९९-३२", "content_sanskrit": "अयुध्यमानं यस्त्वाजौ तथा प्रायगतं मुनिम्।\nछिन्नबाहुं परैर्हन्यात्सात्यके स कथं वदेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2059057, "chapter_id": 2272, "verse_number": "७-१९९-३३", "content_sanskrit": "निहत्य त्वां पदा भूमौ स विकर्षति वीर्यवान्।\nकिं तदा न निहंस्येनं भूत्वा पुरुषसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2059058, "chapter_id": 2272, "verse_number": "७-१९९-३४", "content_sanskrit": "त्वया पुनरनार्येण पूर्वं पार्थेन निर्जितः।\nयदा तदा हतः शूरः सौमदत्तिः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2059059, "chapter_id": 2272, "verse_number": "७-१९९-३५", "content_sanskrit": "यत्रयत्र तु पाण्डूनां द्रोणो द्रावयते चमूम्।\nकिरञ्छरसहस्राणि तत्रतत्र प्रयाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2059060, "chapter_id": 2272, "verse_number": "७-१९९-३६", "content_sanskrit": "स त्वमेवंविधं कृत्वा कर्म चण्डालवत्स्वयम्।\nवक्तुमर्हसि वक्तव्यः कस्मात्त्वं परुषाण्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2059061, "chapter_id": 2272, "verse_number": "७-१९९-३७", "content_sanskrit": "कर्ता त्वं कर्मणो ह्यस्य नाहं वृष्णिकुलाधम।\nपापानां च त्वमावासः कर्मणां मा पुनर्वद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2059062, "chapter_id": 2272, "verse_number": "७-१९९-३८", "content_sanskrit": "जोषमास्व न मां भूयो वक्तुमर्हस्यतः परम्।\nअधरोत्तरमेतद्वि यन्मां त्वं वक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2059063, "chapter_id": 2272, "verse_number": "७-१९९-३९", "content_sanskrit": "अथ वक्ष्यसि मां मौर्ख्याद्भूयः परुषमीदृशम्।\nगमयिष्यामि बाणैस्त्वां युधि वैवस्वतक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2059064, "chapter_id": 2272, "verse_number": "७-१९९-४०", "content_sanskrit": "न चैव मूर्ख धर्मेण केवलेनैव शक्यते।\nतेषामपि ह्यधर्मेण चेष्टितं शृणु यादृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2059065, "chapter_id": 2272, "verse_number": "७-१९९-४१", "content_sanskrit": "वञ्चितः पाण्डवः पूर्वमधर्मेण युधिष्ठिरः।\nद्रौपदी च परिक्लिष्टा तथाऽधर्मेण सात्यके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2059066, "chapter_id": 2272, "verse_number": "७-१९९-४२", "content_sanskrit": "प्रव्राजिता वनं सर्वे पाण्डवाः सह कृष्णया।\nसर्वस्वमपकृष्टं च तथाऽधर्मेण बालिश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2059067, "chapter_id": 2272, "verse_number": "७-१९९-४३", "content_sanskrit": "अधर्मेणापकृष्टश्च मद्रराजः परैरितः।\nअधर्मेण तथा बालः सौभद्रो विनिपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2059068, "chapter_id": 2272, "verse_number": "७-१९९-४४", "content_sanskrit": "इतोऽप्यधर्मेण हतो भीष्मः परपुरञ्जयः।\nभूरिश्रवा ह्यधर्मेण त्वया धर्मविदा हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2059069, "chapter_id": 2272, "verse_number": "७-१९९-४५", "content_sanskrit": "एवं परैराचरितं पाण्डवेयैश्च संयुगे।\nरक्षमाणैर्जयं वीरैर्धर्मज्ञैरपि सात्वत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2059070, "chapter_id": 2272, "verse_number": "७-१९९-४६", "content_sanskrit": "दुर्ज्ञेयः स परो धर्मस्तथाऽधर्मश्च दुर्विदः।\nयुध्यस्व कौरवैः सार्धं मा गाः पितृनिवेशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2059071, "chapter_id": 2272, "verse_number": "७-१९९-४७x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2059072, "chapter_id": 2272, "verse_number": "७-१९९-४७", "content_sanskrit": "एवमादीनि वाक्यानि क्रूराणि परुषाणि च।\nश्रावितः सात्यकिः श्रीमानाकम्पित इवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2059073, "chapter_id": 2272, "verse_number": "७-१९९-४८", "content_sanskrit": "तच्छ्रुत्वा क्रोधताम्राक्षः सात्यकिस्त्वाददे गदाम्।\nविनिः श्वस्य यथा सर्पः प्रणिधाय रथे धनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2059074, "chapter_id": 2272, "verse_number": "७-१९९-४९", "content_sanskrit": "ततोऽभिपत्य पाञ्चाल्यं संरम्भेणेदमब्रवीत्।\nन त्वां वक्ष्यामि परुषं हनिष्ये त्वां वधक्षमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2059075, "chapter_id": 2272, "verse_number": "७-१९९-५०", "content_sanskrit": "तमापतन्तं सहसा महाबलममर्षणम्।\nपाञ्चाल्यायाभिसङ्क्रुद्धमन्तकायान्तकोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2059076, "chapter_id": 2272, "verse_number": "७-१९९-५१", "content_sanskrit": "चोदितो वासुदेवेन भीमसेनो महाबलः।\nअवप्लुत्य रथात्तूर्णं बाहुभ्यां समवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2059077, "chapter_id": 2272, "verse_number": "७-१९९-५२", "content_sanskrit": "द्रवमाणं तथा क्रुद्धं सात्यकिं पाण्डवो बली।\nप्रस्पन्दमानमादाय जगाम बलिनं बलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2059078, "chapter_id": 2272, "verse_number": "७-१९९-५३", "content_sanskrit": "स्थित्वा विष्टभ्य चरणौ भीमेन शिनिपुङ्गवः।\nनिगृहीतः पदे षष्ठे बलेन बलिनां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2059079, "chapter_id": 2272, "verse_number": "७-१९९-५४", "content_sanskrit": "अवरुह्य रथात्तूर्णं ध्रियमाणं बलीयसा।\nउवाच श्लक्ष्णया वाचा सहदेवो विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2059080, "chapter_id": 2272, "verse_number": "७-१९९-५५", "content_sanskrit": "अस्माकं पुरुषव्याघ्र मित्रमन्यन्न विद्यते।\nपरमन्धकवृष्णिभ्यः पाञ्चलेभ्यश्च मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2059081, "chapter_id": 2272, "verse_number": "७-१९९-५६", "content_sanskrit": "तथैवान्धकवृष्णीनां तथैव च विशेषतः।\nकृष्णस्य च तथाऽस्मत्तो मित्रमन्यन्न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2059082, "chapter_id": 2272, "verse_number": "७-१९९-५७", "content_sanskrit": "पाञ्चालानां च वार्ष्णेय समुद्रान्तां विचिन्वताम्।\nनान्यदस्ति परं मित्रं यथा पाण्डववृष्णयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2059083, "chapter_id": 2272, "verse_number": "७-१९९-५८", "content_sanskrit": "स भवानीदृशं मित्रं मन्यते च यथा भवान्।\nभवन्तश्च यथाऽस्माकं भवतां च तथा वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2059084, "chapter_id": 2272, "verse_number": "७-१९९-५९", "content_sanskrit": "स एवं सर्वधर्मज्ञ मित्रधर्ममनुस्मरन्।\nनियच्छ मन्युं पाञ्चाल्यात्प्रशाम्य शिनिपुङ्गवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2059085, "chapter_id": 2272, "verse_number": "७-१९९-६०", "content_sanskrit": "पार्षतस्य क्षम त्वं वै क्षमतां पार्षतश्च ते।\nवयं क्षमयितारश्च किमन्यत्र शमाद्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2059086, "chapter_id": 2272, "verse_number": "७-१९९-६१", "content_sanskrit": "प्रशाम्यमाने शैनेये सहदेवेन मारिष।\nपाञ्चालराजस्य सुतः प्रहसन्निदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2059087, "chapter_id": 2272, "verse_number": "७-१९९-६२", "content_sanskrit": "मुञ्चमुञ्च शिनेः पौत्रं भीम युद्धमदान्वितम्।\nआसादयतु मामेष धराधरमिवानिलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2059088, "chapter_id": 2272, "verse_number": "७-१९९-६३", "content_sanskrit": "यावदस्य शितैर्बाणैः संरम्भं विनयाम्यहम्।\nयुद्धश्रुद्धां च कौन्तेय जीवितं चास्य संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2059089, "chapter_id": 2272, "verse_number": "७-१९९-६४", "content_sanskrit": "किं नु शक्यं मया कर्तुं यत्कार्यमिदमुच्यताम्।\nसुमहत्पाण्डुपुत्राणामायान्त्येते हि कौरवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2059090, "chapter_id": 2272, "verse_number": "७-१९९-६५", "content_sanskrit": "अथवा फल्गुनः सर्वान्वारयिष्यति संयुगे।\nअहमप्यस्य मूर्धानं पातयिष्यामि सायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2059091, "chapter_id": 2272, "verse_number": "७-१९९-६६", "content_sanskrit": "मन्यते च्छिन्नबाहुं मां भूरिश्रवसमाहवे।\nउत्सृजैनमहं चैनमेष वा मां हनिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2059092, "chapter_id": 2272, "verse_number": "७-१९९-६७", "content_sanskrit": "शृण्वन्पाञ्चालवाक्यानि सात्यकिः सर्पवच्छ्वसन्।\nभीमबाह्वन्तरे सक्तो विस्फुरत्यनिशं बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2059093, "chapter_id": 2272, "verse_number": "७-१९९-६८", "content_sanskrit": "तौ वृषाविव नर्दन्तौ बलिनौ बाहुशालिनौ।\nत्वरया वासुदेवश्च धर्मराजश्च मारिष।\nयत्नेन महता वीरौ वारयामासतुस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2059094, "chapter_id": 2272, "verse_number": "७-१९९-६९", "content_sanskrit": "निवार्य परमेष्वासौ कोपसंरक्तलोचनौ।\nयुयुत्सूनपरान्सङ्ख्ये प्रतीयुः क्षत्रियर्षभाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2059095, "chapter_id": 2272, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि नारायणास्त्रमोक्षपर्वणि पञ्चदशदिवसयुद्धे एकोनद्विशततमोऽध्यायः॥ १९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]