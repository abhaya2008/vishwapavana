[{"id": 2004410, "chapter_id": 1087, "verse_number": "१-८८-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2004411, "chapter_id": 1087, "verse_number": "१-८८-१", "content_sanskrit": "पुत्रं ययातेः प्रबूहि पूरुं धर्मभृतां वरम्।\nआनुपूर्व्येण ये चान्ये पूरोर्वंशविवर्धनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2004412, "chapter_id": 1087, "verse_number": "१-८८-२", "content_sanskrit": "विस्तरेण पुनर्ब्रूहि दौष्यन्तेर्जनमेजयात्।\nसंबभूव यथा राजा भरतो द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2004413, "chapter_id": 1087, "verse_number": "१-८८-३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2004414, "chapter_id": 1087, "verse_number": "१-८८-३", "content_sanskrit": "पूरुर्नृपतिशार्दूलो यथैवास्य पिता नृप।\nधर्मनित्यः स्थितो राज्ये शक्रतुल्यपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2004415, "chapter_id": 1087, "verse_number": "१-८८-४", "content_sanskrit": "प्रवीरेश्वररौद्राश्वास्त्रयः पुत्रा महारथाः।\nपूरोः पौष्ट्यामजायन्त प्रवीरो वंशकृत्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2004416, "chapter_id": 1087, "verse_number": "१-८८-५", "content_sanskrit": "मनस्युरभवत्तस्माच्छूरसेनीसुतः प्रभुः।\nपृथिव्याश्चतुरन्ताया गोप्ता राजीवलोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2004417, "chapter_id": 1087, "verse_number": "१-८८-६", "content_sanskrit": "शक्तः संहननो वाग्मी सौवीरीतनयास्त्रयः।\nमनस्योरभवन्पुत्राः शूराः सर्वे महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2004418, "chapter_id": 1087, "verse_number": "१-८८-७", "content_sanskrit": "अन्वग्भानुप्रभृतयो मिश्रकेश्यां मनस्विनः।\nरौद्राश्वस्य महेष्वासा दशाप्सरसि सूनवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2004419, "chapter_id": 1087, "verse_number": "१-८८-८", "content_sanskrit": "यज्वानो जज्ञिरे शूराः प्रजावन्तो बहुश्रुताः।\nसर्वे सर्वास्त्रविद्वासः सर्वे धर्मपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2004420, "chapter_id": 1087, "verse_number": "१-८८-९", "content_sanskrit": "ऋचेयुरथ कक्षेयुः कृकणेयुश्च वीर्यवान्।\nस्थण्डिलेयुर्वनेयुश्च जलेयुश्च महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2004421, "chapter_id": 1087, "verse_number": "१-८८-१०", "content_sanskrit": "तेजेयुर्बलावान्धीमान्सत्येयुश्चन्द्रविक्रमः।\nधर्मेयुः सन्नतेयुश्च दशमो देवविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2004422, "chapter_id": 1087, "verse_number": "१-८८-११", "content_sanskrit": "अनाधृष्टिरभूत्तेषां विद्वान्भुवि तथैकराट्।\nऋचेयुरथ विक्रान्तो देवानामिव वासवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2004423, "chapter_id": 1087, "verse_number": "१-८८-१२", "content_sanskrit": "अनाधृष्टिसुतस्त्वासीद्राजसूयाश्वमेधकृत्।\nमतिनार इति ख्यातो राजा परमधार्मिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2004424, "chapter_id": 1087, "verse_number": "१-८८-१३", "content_sanskrit": "मतिनारसुता राजंश्चत्वारोऽमितविक्रमाः।\nतंसुर्महानतिरथो द्रुह्युश्चाप्रतिमद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2004425, "chapter_id": 1087, "verse_number": "१-८८-१४", "content_sanskrit": "तेषां तंसुर्महावीर्यः पौरवं वंशमुद्वहन्।\nआजहार यशो दीप्तं जिगाय च वसुंधराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2004426, "chapter_id": 1087, "verse_number": "१-८८-१५", "content_sanskrit": "ईलिनं तु सुतं तंसुर्जनयामास वीर्यवान्।\nसोऽपि कृत्स्नामिमां भूमिं विजिग्ये जयतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2004427, "chapter_id": 1087, "verse_number": "१-८८-१६", "content_sanskrit": "रथन्तर्यां सुतान्पञ्च पञ्चभूतोपमांस्ततः।\nईलिनो जनयामास दुष्यन्तप्रभृतीन्नृपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2004428, "chapter_id": 1087, "verse_number": "१-८८-१७", "content_sanskrit": "दुष्यन्तं शूरभीमौ च प्रवसुं वसुमेव च।\nतेषां श्रेष्ठोऽभवद्राजा दुष्यन्तो दुर्जयो युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2004429, "chapter_id": 1087, "verse_number": "१-८८-१८", "content_sanskrit": "दुष्यन्ताल्लक्षणायां तु जज्ञे वै जनमेजयः।\nशकुन्तलायां भरतो दौष्यन्तिरभवत्सुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2004430, "chapter_id": 1087, "verse_number": "१-८८-१९", "content_sanskrit": "तस्माद्भरतवंशस्य विप्रतस्थे महद्यशः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2004431, "chapter_id": 1087, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि अष्टाशीतितमोऽध्यायः॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]