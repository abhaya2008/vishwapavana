[{"id": 5000088000, "chapter_id": 9088, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे एकादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000088001, "chapter_id": 9088, "verse_number": "२-११-१", "content_sanskrit": "तं मन्मथशरैर्विद्धं कामवेगवशानुगम्।\nउवाच पृथिवीपालं कैकेयी दारुणं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000088002, "chapter_id": 9088, "verse_number": "२-११-२", "content_sanskrit": "नास्मि विप्रकृता देव केनचिन्नावमानिता।\nअभिप्रायस्तु मे कश्चित् तमिच्छामि त्वया कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000088003, "chapter_id": 9088, "verse_number": "२-११-३", "content_sanskrit": "प्रतिज्ञां प्रतिजानीष्व यदि त्वं कर्तुमिच्छसि।\nअथ ते व्याहरिष्यामि यथाभिप्रार्थितं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000088004, "chapter_id": 9088, "verse_number": "२-११-४", "content_sanskrit": "तामुवाच महाराजः कैकेयीमीषदुत्स्मयः।\nकामी हस्तेन संगृह्य मूर्धजेषु भुवि स्थिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000088005, "chapter_id": 9088, "verse_number": "२-११-५", "content_sanskrit": "अवलिप्ते न जानासि त्वत्तः प्रियतरो मम।\nमनुजो मनुजव्याघ्राद् रामादन्यो न विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000088006, "chapter_id": 9088, "verse_number": "२-११-६", "content_sanskrit": "तेनाजय्येन मुख्येन राघवेण महात्मना।\nशपे ते जीवनार्हेण ब्रूहि यन्मनसेप्सितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000088007, "chapter_id": 9088, "verse_number": "२-११-७", "content_sanskrit": "यं मुहूर्तमपश्यंस्तु न जीवे तमहं ध्रुवम्।\nतेन रामेण कैकेयि शपे ते वचनक्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000088008, "chapter_id": 9088, "verse_number": "२-११-८", "content_sanskrit": "आत्मना चात्मजैश्चान्यैर्वृणे यं मनुजर्षभम्।\nतेन रामेण कैकेयि शपे ते वचनक्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000088009, "chapter_id": 9088, "verse_number": "२-११-९", "content_sanskrit": "भद्रे हृदयमप्येतदनुमृश्योद्धरस्व मे।\nएतत् समीक्ष्य कैकेयि ब्रूहि यत् साधु मन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000088010, "chapter_id": 9088, "verse_number": "२-११-१०", "content_sanskrit": "बलमात्मनि पश्यन्ती न विशङ्कितुमर्हसि।\nकरिष्यामि तव प्रीतिं सुकृतेनापि ते शपे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000088011, "chapter_id": 9088, "verse_number": "२-११-११", "content_sanskrit": "सा तदर्थमना देवी तमभिप्रायमागतम्।\nनिर्माध्यस्थ्याच्च हर्षाच्च बभाषे दुर्वचं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000088012, "chapter_id": 9088, "verse_number": "२-११-१२", "content_sanskrit": "तेन वाक्येन संहृष्टा तमभिप्रायमात्मनः।\nव्याजहार महाघोरमभ्यागतमिवान्तकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000088013, "chapter_id": 9088, "verse_number": "२-११-१३", "content_sanskrit": "यथा क्रमेण शपसे वरं मम ददासि च।\nतच्छृण्वन्तु त्रयस्त्रिंशद् देवाः सेन्द्रपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000088014, "chapter_id": 9088, "verse_number": "२-११-१४", "content_sanskrit": "चन्द्रादित्यौ नभश्चैव ग्रहा रात्र्यहनी दिशः।\nजगच्च पृथिवी चेयं सगन्धर्वाः सराक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000088015, "chapter_id": 9088, "verse_number": "२-११-१५", "content_sanskrit": "निशाचराणि भूतानि गृहेषु गृहदेवताः।\nयानि चान्यानि भूतानि जानीयुर्भाषितं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000088016, "chapter_id": 9088, "verse_number": "२-११-१६", "content_sanskrit": "सत्यसंधो महातेजा धर्मज्ञः सत्यवाक्शुचिः।\nवरं मम ददात्येष सर्वे शृण्वन्तु दैवताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000088017, "chapter_id": 9088, "verse_number": "२-११-१७", "content_sanskrit": "इति देवी महेष्वासं परिगृह्याभिशस्य च।\nततः परमुवाचेदं वरदं काममोहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000088018, "chapter_id": 9088, "verse_number": "२-११-१८", "content_sanskrit": "स्मर राजन् पुरा वृत्तं तस्मिन् देवासुरे रणे।\nतत्र त्वां च्यावयच्छत्रुस्तव जीवितमन्तरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000088019, "chapter_id": 9088, "verse_number": "२-११-१९", "content_sanskrit": "तत्र चापि मया देव यत् त्वं समभिरक्षितः।\nजाग्रत्या यतमानायास्ततो मे प्रददौ वरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000088020, "chapter_id": 9088, "verse_number": "२-११-२०", "content_sanskrit": "तौ दत्तौ च वरौ देव निक्षेपौ मृगयाम्यहम्।\nतवैव पृथिवीपाल सकाशे रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000088021, "chapter_id": 9088, "verse_number": "२-११-२१", "content_sanskrit": "तत् प्रतिश्रुत्य धर्मेण न चेद् दास्यसि मे वरम्।\nअद्यैव हि प्रहास्यामि जीवितं त्वद्विमानिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000088022, "chapter_id": 9088, "verse_number": "२-११-२२", "content_sanskrit": "वाङ्मात्रेण तदा राजा कैकेय्या स्ववशे कृतः।\nप्रचस्कन्द विनाशाय पाशं मृग इवात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000088023, "chapter_id": 9088, "verse_number": "२-११-२३", "content_sanskrit": "ततः परमुवाचेदं वरदं काममोहितम्।\nवरौ देयौ त्वया देव तदा दत्तौ महीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000088024, "chapter_id": 9088, "verse_number": "२-११-२४", "content_sanskrit": "तौ तावदहमद्यैव वक्ष्यामि शृणु मे वचः।\nअभिषेकसमारम्भो राघवस्योपकल्पितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000088025, "chapter_id": 9088, "verse_number": "२-११-२५", "content_sanskrit": "अनेनैवाभिषेकेण भरतो मेऽभिषिच्यताम्।\nयो द्वितीयो वरो देव दत्तः प्रीतेन मे त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000088026, "chapter_id": 9088, "verse_number": "२-११-२६", "content_sanskrit": "तदा देवासुरे युद्धे तस्य कालोऽयमागतः।\nनव पञ्च च वर्षाणि दण्डकारण्यमाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000088027, "chapter_id": 9088, "verse_number": "२-११-२७", "content_sanskrit": "चीराजिनधरो धीरो रामो भवतु तापसः।\nभरतो भजतामद्य यौवराज्यमकण्टकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000088028, "chapter_id": 9088, "verse_number": "२-११-२८", "content_sanskrit": "एष मे परमः कामो दत्तमेव वरं वृणे।\nअद्य चैव हि पश्येयं प्रयान्तं राघवं वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000088029, "chapter_id": 9088, "verse_number": "२-११-२९", "content_sanskrit": "स राजराजो भव सत्यसंगरः कुलं च शीलं च हि जन्म रक्ष च।\nपरत्र वासे हि वदन्त्यनुत्तमं तपोधनाः सत्यवचो हितं नृणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000088030, "chapter_id": 9088, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे एकादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]