[{"id": 2193133, "chapter_id": 5106, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2193134, "chapter_id": 5106, "verse_number": "१", "content_sanskrit": "कथं व्यासस्य धर्मात्मा शुकोजज्ञेमहातपाः ।\nसिद्धिं च परमां प्राप्तस्तन्मे ब्रूहि पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2193135, "chapter_id": 5106, "verse_number": "२", "content_sanskrit": "कस्यां चोत्पादयामास शुकं व्यासस्तपोधनः ।\nन ह्यस्य जननीं विद्म जन्म चाग्र्यंमहात्मनः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2193136, "chapter_id": 5106, "verse_number": "३", "content_sanskrit": "कथं च बालस्य सतः सूक्ष्मज्ञाने गतामतिः ।\nयथा नान्यस्य लोकेऽस्मिन् द्वितीयस्येह कस्यचित्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2193137, "chapter_id": 5106, "verse_number": "४", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं विस्तरेण महाद्युते।\nन हि मे तृप्तिरस्तीह शृण्वतोऽमृतमुत्तमम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2193138, "chapter_id": 5106, "verse_number": "५", "content_sanskrit": "माहात्म्यमात्मयोगं चविज्ञानं च शुकस्य ह ।\nयथावदानुपूर्व्येण तन्मे ब्रूहि पितामह\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2193139, "chapter_id": 5106, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2193140, "chapter_id": 5106, "verse_number": "६", "content_sanskrit": "न हायनैर्न पलितैर्न वित्तेन न बन्धुभिः ।\nऋषयश्चक्रिरे धर्मं योऽनूचानः स नो महान्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2193141, "chapter_id": 5106, "verse_number": "७", "content_sanskrit": "तपोमूलमिदं सर्वंयन्मां पृच्छसि पाण्डव ।\nतदिन्द्रियाणि संयम्य तपो भवति नान्यथा\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2193142, "chapter_id": 5106, "verse_number": "८", "content_sanskrit": "इन्द्रियाणां प्रसङ्गेन दोषमृच्छत्यसंशयम् ।\nसन्नियम्य तु तान्येव सिद्धिं प्राप्नोतिमानवः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2193143, "chapter_id": 5106, "verse_number": "९", "content_sanskrit": "अश्वमेधसहस्रस्य वाजपेयशतस्य च ।\nयोगस्य कलया तात न तुल्यं विद्यते फलम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2193144, "chapter_id": 5106, "verse_number": "१०", "content_sanskrit": "अत्र ते वर्तयिष्यामिजन्मयोगफलं यथा ।\nशुकस्याग्र्यां गतिं चैव दुर्विदामकृतात्मभिः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2193145, "chapter_id": 5106, "verse_number": "११", "content_sanskrit": "मेरुशृङ्गे किल पुरा कर्णिकारवनायुते ।\nविजहार महादेवो भीमैर्भूतगणैर्वृतः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2193146, "chapter_id": 5106, "verse_number": "१२", "content_sanskrit": "शैलराजसुता चैव देवीतत्राभवत् पुरा ।\nतत्र दिव्यं तपस्तेपे कृष्णद्वैपायनः प्रभुः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2193147, "chapter_id": 5106, "verse_number": "१३", "content_sanskrit": "योगेनात्मानमाविश्य योगधर्मपरायणः ।\nधारयन् स तपस्तेपे पुत्रार्थं कुरुसत्तम\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2193148, "chapter_id": 5106, "verse_number": "१४", "content_sanskrit": "अग्नेर्भूमेरपां वायोरन्तरिक्षस्य चाभिभो ।\nवीर्येण सम्मितःपुत्रो मम भूयादिति स्म ह\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2193149, "chapter_id": 5106, "verse_number": "१५", "content_sanskrit": "सङ्कल्पेनाथ सोऽनेन दुष्प्रापेणाकृतात्मभिः ।\nवरयामास देवेशमास्थितस्तपउत्तमम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2193150, "chapter_id": 5106, "verse_number": "१६", "content_sanskrit": "अतिष्ठन् मारुताहारः शतं किल समाः प्रभुः ।\nआराधयन्महादेवं बहुरूपमुमापतिम्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2193151, "chapter_id": 5106, "verse_number": "१७", "content_sanskrit": "तत्र ब्रह्मर्षयश्चैव सर्वे देवर्षयस्तथा ।\nलोकपालाश्च लोकेशं साध्याश्च वसुभिःसह\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2193152, "chapter_id": 5106, "verse_number": "१८", "content_sanskrit": "आदित्याश्चैव रुद्राश्च दिवाकरनिशाकरौ ।\nमरुतो मारुतश्चैव सागराः सरितस्तथा॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2193153, "chapter_id": 5106, "verse_number": "१९", "content_sanskrit": "अश्विनौ देवगन्धर्वास्तथा नारदपर्वतौ ।\nविश्वावसुश्च गन्धर्वः सिद्धाश्चाप्सरसां गणाः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2193154, "chapter_id": 5106, "verse_number": "२०", "content_sanskrit": "तत्र रुद्रो महादेवः कर्णिकारमयीं शुभाम्।\nधारयाणः स्रजं भाति ज्योत्स्नामिव निशाकरः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2193155, "chapter_id": 5106, "verse_number": "२१", "content_sanskrit": "तस्मिन्दिव्ये वने रम्ये देवदेवर्षिसङ्कुले ।\nआस्थितः परमं योगमृषिः पुत्रार्थमुद्यतः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2193156, "chapter_id": 5106, "verse_number": "२२", "content_sanskrit": "न चास्य हीयते वर्णो न ग्लानिरुपजायते ।\nत्रयाणामपिलोकानां तदद्भुतमिवाभवत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2193157, "chapter_id": 5106, "verse_number": "२३", "content_sanskrit": "जटाश्च तेजसा तस्य वैश्वानरशिखोपमाः ।\nप्रज्वलन्त्यः स्म दृश्यन्ते युक्तस्यामिततेजसः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2193158, "chapter_id": 5106, "verse_number": "२४", "content_sanskrit": "मार्कण्डेयो हि भगवानेतदाख्यातवान्मम ।\nस देवचरितानीह कथयामास मे सदा॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2193159, "chapter_id": 5106, "verse_number": "२५", "content_sanskrit": "ता एताद्यापि कृष्णस्य तपसातेन दीपिताः ।\nअग्निवर्णा जटास्तात प्रकाशन्ते महात्मनः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2193160, "chapter_id": 5106, "verse_number": "२६", "content_sanskrit": "एवंविधेन तपसा तस्य भक्त्या च भारत ।\nमहेश्वरः प्रसन्नात्मा चकार मनसामतिम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2193161, "chapter_id": 5106, "verse_number": "२७", "content_sanskrit": "उवाच चैनं भगवांस्त्र्यम्बकः प्रहसन्निव ।\nएवंविधस्ते तनयो द्वैपायन भविष्यति\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2193162, "chapter_id": 5106, "verse_number": "२८", "content_sanskrit": "यथा ह्यग्निर्यथा वायुर्यथाभूमिर्यथा जलम् ।\nयथा च खं तथा शुद्धो भविष्यति सुतो महान्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2193163, "chapter_id": 5106, "verse_number": "२९", "content_sanskrit": "तद्भावभावी तद्बुद्धिस्तदात्मा तदपाश्रयः ।\nतेजसावृत्य लोकांस्त्रीन् यशः प्राप्स्यति केवलम्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2193164, "chapter_id": 5106, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे पञ्चपञ्चाशोत्तरशततमोऽध्यायः ॥१५५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]