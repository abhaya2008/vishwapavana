[{"id": 6000173000, "chapter_id": 10173, "verse_number": null, "content_sanskrit": "अथ विंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000173001, "chapter_id": 10173, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.001.m4a", "display_order": 2}, {"id": 6000173002, "chapter_id": 10173, "verse_number": "८-२०-१", "content_sanskrit": "स तं समीक्ष्याब्जभवो नखेन्दुभिर्हृतस्वधामद्युतिरावृतोऽभ्यगात्।\nमरीचिमिश्रा ऋषयो बृहद्व्रताः सनन्दनाद्या नरदेव योगिनः॥ ८/२०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.002.m4a", "display_order": 3, "topics": [{"text": "द्वितीयेन पदा स्वर्लोकं क्रमतस्त्रिविक्रमस्य ब्रह्मादिदेवैः पादप्रक्षालनम्", "range": "१–७"}]}, {"id": 6000173003, "chapter_id": 10173, "verse_number": "८-२०-२", "content_sanskrit": "वेदोपवेदा नियमा यमान्वितास्तर्केतिहासाङ्गपुराणसंहिताः।\nये चापरे योगसमीरदीपितज्ञानाग्निना रन्धितकर्मकल्मषाः।\nववन्दिरे यत्स्मरणानुभावतः स्वायम्भुवं धाम गता अकर्मकम्॥ ८/२०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.003.m4a", "display_order": 4}, {"id": 6000173004, "chapter_id": 10173, "verse_number": "८-२०-३", "content_sanskrit": "अथाङ्घ्रये प्रोन्नमिताय विष्णोरुपाहरत् पद्मभवोऽर्हणोदकम्।\nसमर्च्य भक्त्याऽभ्यगृणाच्छुचिश्रवा यन्नाभिपङ्केरुहसम्भवः स्वयम्॥ ८/२०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.004.m4a", "display_order": 5}, {"id": 6000173005, "chapter_id": 10173, "verse_number": "८-२०-४", "content_sanskrit": "धातुः कमण्डलुजलं तदुरुक्रमस्य पादावनेजनपवित्रतया नरेन्द्र।\nस्वर्धुन्यभून्नभसि सा पतती निमार्ष्टि लोकत्रयं भगवतो विशदेव कीर्तिः॥ ८/२०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.005.m4a", "display_order": 6}, {"id": 6000173006, "chapter_id": 10173, "verse_number": "८-२०-५", "content_sanskrit": "ब्रह्मादयो लोकनाथाः स्वनाथाय समादृताः।\nसानुगा बलिमाजह्रुरसङ्क्षिप्तात्मभूतये॥ ८/२०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.006.m4a", "display_order": 7}, {"id": 6000173007, "chapter_id": 10173, "verse_number": "८-२०-६", "content_sanskrit": "तोयैः समर्हणैः स्रग्भिर्दिव्यगन्धानुलेपनैः।\nधूपैर्दीपैः सुरभिभिर्लाजाक्षतफलाङ्कुरैः॥ ८/२०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.007.m4a", "display_order": 8}, {"id": 6000173008, "chapter_id": 10173, "verse_number": "८-२०-७", "content_sanskrit": "स्तवनैर्जयशब्दैश्च तद्वीर्यमहिमाङ्कितैः। नृत्तवादित्रगीतैश्च शङ्खदुन्दुभिनिःस्वनैः।\nजाम्बवान् ऋक्षराजस्तु भेरीशब्दैर्मनोजवः॥ ८/२०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.008.m4a", "display_order": 9}, {"id": 6000173009, "chapter_id": 10173, "verse_number": "८-२०-८", "content_sanskrit": "विजयं दिक्षु सर्वासु महोत्सवमघोषयत्। महीं सर्वां हृतां दृष्ट्वा त्रिपदव्याजयाञ्चया।\nऊचुः स्वभर्तुरसुरा दीक्षितस्यात्यमर्षिताः॥ ८/२०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.009.m4a", "display_order": 10, "topics": [{"text": "वामनं हन्तुमुद्युक्तानामसुराणां विष्णुपार्षदैर्निवारणम्", "range": "८–१६"}]}, {"id": 6000173010, "chapter_id": 10173, "verse_number": "८-२०-९", "content_sanskrit": "न वा अयं ब्रह्मबन्धुर्विष्णुर्मायाविनां वरः।\nद्विजरूपप्रतिच्छन्नो देवकार्यं चिकीर्षति॥ ८/२०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.010.m4a", "display_order": 11}, {"id": 6000173011, "chapter_id": 10173, "verse_number": "८-२०-१०", "content_sanskrit": "अनेन याचमानेन शत्रुणा बहुरूपिणा।\nसर्वस्वं नो हृतं भर्तुर्न्यस्तदण्डस्य बर्हिषि॥ ८/२०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.011.m4a", "display_order": 12}, {"id": 6000173012, "chapter_id": 10173, "verse_number": "८-२०-११", "content_sanskrit": "सत्यव्रतस्य सततं दीक्षितस्य विशेषतः।\nनानृतं भाषितुं शक्यं ब्रह्मण्यस्य दयावतः॥ ८/२०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.012.m4a", "display_order": 13}, {"id": 6000173013, "chapter_id": 10173, "verse_number": "८-२०-१२", "content_sanskrit": "तस्मादस्य वधो धर्मो भर्तुः शुश्रूषणं च नः।\nइत्यायुधानि जगृहुर्बलेरनुचरासुराः॥ ८/२०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.013.m4a", "display_order": 14}, {"id": 6000173014, "chapter_id": 10173, "verse_number": "८-२०-१३", "content_sanskrit": "ते सर्वे वामनं हन्तुं शूलपट्टिशपाणयः।\nअनिच्छतो बले राजन् प्राद्रवञ्जातमन्यवः॥ ८/२०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.014.m4a", "display_order": 15}, {"id": 6000173015, "chapter_id": 10173, "verse_number": "८-२०-१४", "content_sanskrit": "तानभिद्रवतो दृष्ट्वा दितिजानीकपान् नृप।\nप्रहस्यानुचरा विष्णोः प्रत्यषेधन्नुदायुधाः॥ ८/२०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.015.m4a", "display_order": 16}, {"id": 6000173016, "chapter_id": 10173, "verse_number": "८-२०-१५", "content_sanskrit": "नन्दः सुनन्दोऽथ जयो विजयः प्रबलो बलः।\nकुमुदः कुमुदाक्षश्च विष्वक्सेनः पतत्त्रिराट्॥ ८/२०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.016.m4a", "display_order": 17}, {"id": 6000173017, "chapter_id": 10173, "verse_number": "८-२०-१६", "content_sanskrit": "जयन्तः श्रुतदेवश्च पुष्पदन्तोऽथ सात्वतः।\nसर्वे नागायुतप्राणाः स्वां स्वां ते जघ्नुरासुरीम्॥ ८/२०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.017.m4a", "display_order": 18}, {"id": 6000173018, "chapter_id": 10173, "verse_number": "८-२०-१७", "content_sanskrit": "हन्यमानान् स्वकान् दृष्ट्वा पुरुषानुचरैर्बलिः।\nवारयामास संरब्धान् काव्यशापमनुस्मरन्॥ ८/२०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.018.m4a", "display_order": 19, "topics": [{"text": "भगवदभिप्रायज्ञेन गरुडेन बलेर्वारुणपाशैर्बन्धनम्", "range": "१७–३३"}]}, {"id": 6000173019, "chapter_id": 10173, "verse_number": "८-२०-१८", "content_sanskrit": "हे विप्रचित्ते हे राहो हे हेते श्रूयतां वचः।\nमा युध्यत निवर्तध्वं न नः कालोऽयमर्थकृत्॥ ८/२०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.019.m4a", "display_order": 20}, {"id": 6000173020, "chapter_id": 10173, "verse_number": "८-२०-१९", "content_sanskrit": "यः प्रभुः सर्वभूतानां सुखदुःखोपपत्तये।\nतं नातिवर्तितुं दैत्याः पौरुषैरीश्वरः पुमान्॥ ८/२०/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.020.m4a", "display_order": 21}, {"id": 6000173021, "chapter_id": 10173, "verse_number": "८-२०-२०", "content_sanskrit": "यो नो भवाय प्रागासीदभवाय दिवौकसाम्।\nस एव भगवानद्य वर्तते तद्विपर्ययम्॥ ८/२०/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.021.m4a", "display_order": 22}, {"id": 6000173022, "chapter_id": 10173, "verse_number": "८-२०-२१", "content_sanskrit": "बलेन सचिवैर्बुद्ध्या दुर्गमन्त्रौषधादिभिः।\nसामादिभिरुपायैश्च कालं नात्येति वै जनः॥ ८/२०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.022.m4a", "display_order": 23}, {"id": 6000173023, "chapter_id": 10173, "verse_number": "८-२०-२२", "content_sanskrit": "भवद्भिर्निर्जिता ह्येते बहुशोऽनुचरा हरेः।\nदैवरुद्धास्त एवाद्य युधि जित्वा नदन्ति नः॥ ८/२०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.023.m4a", "display_order": 24}, {"id": 6000173024, "chapter_id": 10173, "verse_number": "८-२०-२३", "content_sanskrit": "एतान् वयं विजेष्यामो यदि दैवं प्रसीदति।\nतस्मात् कालं प्रतीक्षध्वं यो नोऽर्थत्वाय कल्पते॥ ८/२०/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.024.m4a", "display_order": 25}, {"id": 6000173025, "chapter_id": 10173, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.025.m4a", "display_order": 26}, {"id": 6000173026, "chapter_id": 10173, "verse_number": "८-२०-२४", "content_sanskrit": "पत्युर्निगदितं श्रुत्वा दैत्यदानवयूथपाः।\nरसां निविविशू राजन् विष्णुपार्षदताडिताः॥ ८/२०/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.026.m4a", "display_order": 27}, {"id": 6000173027, "chapter_id": 10173, "verse_number": "८-२०-२५", "content_sanskrit": "अथ तार्क्ष्यसुतो ज्ञात्वा विराड् विभुचिकीर्षितम्।\nबबन्ध वारुणैः पाशैर्बलिं सौत्येऽहनि क्रतोः॥ ८/२०/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.027.m4a", "display_order": 28}, {"id": 6000173028, "chapter_id": 10173, "verse_number": "८-२०-२६", "content_sanskrit": "हाहाकारो महानासीद् रोदस्योः सर्वतो दिशम्।\nगृह्यमाणेऽसुरपतौ विष्णुना प्रभविष्णुना॥ ८/२०/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.028.m4a", "display_order": 29}, {"id": 6000173029, "chapter_id": 10173, "verse_number": "८-२०-२७", "content_sanskrit": "तं बद्धं वारुणैः पाशैर्भगवानाह वामनः।\nनष्टश्रियं स्थिरप्रज्ञमुदारयशसं नृप॥ ८/२०/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.029.m4a", "display_order": 30}, {"id": 6000173030, "chapter_id": 10173, "verse_number": null, "content_sanskrit": "श्री भगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.030.m4a", "display_order": 31}, {"id": 6000173031, "chapter_id": 10173, "verse_number": "८-२०-२८", "content_sanskrit": "पदानि त्रीणि दत्तानि भूमेर्मह्यं त्वयाऽसुर।\nद्वाभ्यां क्रान्ता मही सर्वा तृतीयमुपकल्पय॥ ८/२०/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.031.m4a", "display_order": 32}, {"id": 6000173032, "chapter_id": 10173, "verse_number": "८-२०-२९", "content_sanskrit": "यावत् तपत्यसौ गोभिर्यावदिन्दुः सहोडुभिः।\nयावद् वर्षति पर्जन्यस्तावती भूरियं तव॥ ८/२०/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.032.m4a", "display_order": 33}, {"id": 6000173033, "chapter_id": 10173, "verse_number": "८-२०-३०", "content_sanskrit": "पदैकेन मया क्रान्तो भूर्लोको विवरैः सह।\nस्वर्लोकस्तु द्वितीयेन पश्यतस्ते मयाऽऽत्मना॥ ८/२०/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.033.m4a", "display_order": 34}, {"id": 6000173034, "chapter_id": 10173, "verse_number": "८-२०-३१", "content_sanskrit": "प्रतिश्रुतमदातुस्ते निरये वास इष्यते।\nविश त्वं निरयं तस्माद् गुरुणा चानुमोदितः॥ ८/२०/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.034.m4a", "display_order": 35}, {"id": 6000173035, "chapter_id": 10173, "verse_number": "८-२०-३२", "content_sanskrit": "यो विप्राय प्रतिश्रुत्य न तदर्पयते क्‍वचित्।\nवृथा मनोरथस्तस्य दूरं स्वर्गात् पतत्यधः॥ ८/२०/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.035.m4a", "display_order": 36}, {"id": 6000173036, "chapter_id": 10173, "verse_number": "८-२०-३३", "content_sanskrit": "विप्रलब्धो ददामीति त्वयाऽहं चाद्य मानिना।\nतद्व्यलीकफलं भुङ्क्ष्व निरयं कतिचित् समाः॥ ८/२०/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.036.m4a", "display_order": 37}, {"id": 6000173037, "chapter_id": 10173, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.037.m4a", "display_order": 38}, {"id": 6000173038, "chapter_id": 10173, "verse_number": "८-२०-३४", "content_sanskrit": "एवं विप्रकृतो राजन् बलिर्भगवताऽसुरः।\nभिद्यमानोऽप्यभिन्नात्मा प्रत्याहाविक्लवं वचः॥ ८/२०/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.038.m4a", "display_order": 39, "topics": [{"text": "बलिना भगवत्स्तुतिः", "range": "३४–४४"}]}, {"id": 6000173039, "chapter_id": 10173, "verse_number": null, "content_sanskrit": "बलिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.039.m4a", "display_order": 40}, {"id": 6000173040, "chapter_id": 10173, "verse_number": "८-२०-३५", "content_sanskrit": "यद्युत्तमश्लोक भवान् ममेरितं वचो व्यलीकं सुरवर्य मन्यसे।\nकरोम्यृतं तन्न भवेत् प्रलम्भनं पदं तृतीयं कुरु शीर्ष्णि मे निजम्॥ ८/२०/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.040.m4a", "display_order": 41}, {"id": 6000173041, "chapter_id": 10173, "verse_number": "८-२०-३६", "content_sanskrit": "बिभेमि नाहं निरयात् पदच्युतो न पाशबन्धाद् व्यसनाद् दुरत्ययात्।\nनैवार्थकृच्छ्राद् भवतो विनिग्रहाद् असाधुवादाद् भृशमुद्विजे यथा॥ ८/२०/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.041.m4a", "display_order": 42}, {"id": 6000173042, "chapter_id": 10173, "verse_number": "८-२०-३७", "content_sanskrit": "पुंसां श्लाघ्यतमं मन्ये दण्डमर्हत्तमार्पितम्।\nयं न माता पिता भ्राता सुहृदश्चादिशन्ति हि॥ ८/२०/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.042.m4a", "display_order": 43}, {"id": 6000173043, "chapter_id": 10173, "verse_number": "८-२०-३८", "content_sanskrit": "त्वं नूनमसुराणां नः पारोक्ष्यं परमो गुरुः।\nयो नोऽनेकमदान्धानां तद्भ्रंशं चक्षुरादिशः॥ ८/२०/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.043.m4a", "display_order": 44}, {"id": 6000173044, "chapter_id": 10173, "verse_number": "८-२०-३९", "content_sanskrit": "यस्मिन् वैरानुबन्धेन रूढेन विबुधेतराः।\nबहवो लेभिरे सिद्धिं यामिहैकान्तयोगिनः॥ ८/२०/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.044.m4a", "display_order": 45}, {"id": 6000173045, "chapter_id": 10173, "verse_number": "८-२०-४०", "content_sanskrit": "तेनाहं निगृहीतोऽस्मि भवता भूरिकर्मणा।\nबद्धश्च वारुणैः पाशैर्नानुव्रीडे न विव्यथे॥ ८/२०/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.045.m4a", "display_order": 46}, {"id": 6000173046, "chapter_id": 10173, "verse_number": "८-२०-४१", "content_sanskrit": "पितामहो मे भवदीयसम्मतः प्रह्लाद आविष्कृतसाधुवादः।\nभवद्विपक्षेण विचित्रवैशसं सम्प्रापितस्त्वत्परमः स्वपित्रा॥ ८/२०/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.046.m4a", "display_order": 47}, {"id": 6000173047, "chapter_id": 10173, "verse_number": "८-२०-४२", "content_sanskrit": "किमात्मनाऽनेन जहाति यो मुदं किं रिक्थहारैः स्वजनाख्यदस्युभिः।\nकिं जायया संसृतिहेतुभूतया मर्त्यस्य गेहैः किमिहायुषो व्ययः॥ ८/२०/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.047.m4a", "display_order": 48}, {"id": 6000173048, "chapter_id": 10173, "verse_number": "८-२०-४३", "content_sanskrit": "इत्थं स निश्चित्य पितामहो महानगाधबोधो भवतः पादपद्मम्।\nध्रुवं प्रपेदे ह्यकुतोभयं जनाद् भीतः स्वपक्षक्षपणस्य सत्तमः॥ ८/२०/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.048.m4a", "display_order": 49}, {"id": 6000173049, "chapter_id": 10173, "verse_number": "८-२०-४४", "content_sanskrit": "अथाहमप्यात्मरिपोस्तवान्तिकं दैवेन नीतः प्रसभं त्याजितश्रीः।\nइदं कृतान्तान्तिकवर्ति जीवितं ययाऽध्रुवं स्तब्धमतिर्न बुध्यते॥ ८/२०/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.049.m4a", "display_order": 50}, {"id": 6000173050, "chapter_id": 10173, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.050.m4a", "display_order": 51}, {"id": 6000173051, "chapter_id": 10173, "verse_number": "८-२०-४५", "content_sanskrit": "तस्येत्थं भाषमाणस्य प्रह्लादो भगवत्प्रियः।\nआजगाम कुरुश्रेष्ठ राकापतिरिवोत्थितः॥ ८/२०/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.051.m4a", "display_order": 52, "topics": [{"text": "प्रह्लादस्य तत्रागमनम्", "range": "४५–५०"}]}, {"id": 6000173052, "chapter_id": 10173, "verse_number": "८-२०-४६", "content_sanskrit": "तमिन्द्रसेनः स्वपितामहं श्रिया विराजमानं नलिनायतेक्षणम्।\nप्रांशुं पिशङ्गाम्बरमञ्जनत्विषं प्रलम्बबाहुं सुभगं समैक्षत॥ ८/२०/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.052.m4a", "display_order": 53}, {"id": 6000173053, "chapter_id": 10173, "verse_number": "८-२०-४७", "content_sanskrit": "तस्मै बलिर्वारुणपाशयन्त्रितः समर्हणं नोपजहार पूर्ववत्।\nननाम मूर्ध्नाऽश्रुविलोललोचनः सव्रीडनीचीनमुखो बभूव ह॥ ८/२०/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.053.m4a", "display_order": 54}, {"id": 6000173054, "chapter_id": 10173, "verse_number": "८-२०-४८", "content_sanskrit": "स तत्र हासीनमुदीक्ष्य सत्पतिं सुनन्दनन्दाद्यनुगैरुपासितम्।\nउपेत्य भूमौ तरसा महामना ननाम मूर्ध्ना पुलकाश्रुविह्वलः॥ ८/२०/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.054.m4a", "display_order": 55}, {"id": 6000173055, "chapter_id": 10173, "verse_number": null, "content_sanskrit": "प्रह्लाद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.055.m4a", "display_order": 56}, {"id": 6000173056, "chapter_id": 10173, "verse_number": "८-२०-४९", "content_sanskrit": "त्वयैव दत्तं पदमैन्द्रमूर्जितं हृतं तदेवाद्य तथैव शोभनम्।\nमन्ये महानस्य कृतोऽप्यनुग्रहो विभ्रंशितो यच्छ्रिय आत्ममोहनात्॥ ८/२०/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.056.m4a", "display_order": 57}, {"id": 6000173057, "chapter_id": 10173, "verse_number": "८-२०-५०", "content_sanskrit": "यया हि विद्वानपि मुह्यते जनस्तत्कोऽभिचष्टे गतिमात्मनो यथा।\nतस्मै नमस्ते जगदीश्वराय वै नारायणायाखिललोकसाक्षिणे॥ ८/२०/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.057.m4a", "display_order": 58}, {"id": 6000173058, "chapter_id": 10173, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.058.m4a", "display_order": 59}, {"id": 6000173059, "chapter_id": 10173, "verse_number": "८-२०-५१", "content_sanskrit": "बद्धं वीक्ष्य पतिं साध्वी तत्पत्नी भयविह्वला।\nप्राञ्जलिः प्रणतोपेन्द्रं बभाषेऽवाङ्मुखी नृप॥ ८/२०/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.059.m4a", "display_order": 60, "topics": [{"text": "सप्रह्लादस्य बलेः सुतललोकप्रेषणम्", "range": "५१–६९"}]}, {"id": 6000173060, "chapter_id": 10173, "verse_number": null, "content_sanskrit": "विन्ध्यावलिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.060.m4a", "display_order": 61}, {"id": 6000173061, "chapter_id": 10173, "verse_number": "८-२०-५२", "content_sanskrit": "क्रीडार्थमात्मन इदं त्रिजगत् कृतं ते स्वाम्यं तु तत्र कुधियोऽपर ईश कुर्युः।\nकर्तुः प्रभोस्तव किमस्य त आवहन्ति त्यक्तह्रियस्त्वदवरोपितकर्तृवादाः॥ ८/२०/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.061.m4a", "display_order": 62}, {"id": 6000173062, "chapter_id": 10173, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.062.m4a", "display_order": 63}, {"id": 6000173063, "chapter_id": 10173, "verse_number": "८-२०-५३", "content_sanskrit": "तस्या नु शृण्वतो राजन् प्रह्लादस्य कृताञ्जलेः।\nहिरण्यगर्भो भगवानुवाच मधुसूदनम्॥ ८/२०/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.063.m4a", "display_order": 64}, {"id": 6000173064, "chapter_id": 10173, "verse_number": null, "content_sanskrit": "ब्रह्मोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.064.m4a", "display_order": 65}, {"id": 6000173065, "chapter_id": 10173, "verse_number": "८-२०-५४", "content_sanskrit": "भूतभावन भूतेश देवदेव जगन्मय।\nमुञ्चैनं हृतसर्वस्वं नायमर्हति निग्रहम्॥ ८/२०/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.065.m4a", "display_order": 66}, {"id": 6000173066, "chapter_id": 10173, "verse_number": "८-२०-५५", "content_sanskrit": "कृत्स्ना तेऽनेन दत्ता भूर्लोकाः कर्मार्जिताश्च ये।\nनिवेदितं च सर्वस्वमात्माऽविक्लवया धिया॥ ८/२०/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.066.m4a", "display_order": 67}, {"id": 6000173067, "chapter_id": 10173, "verse_number": "८-२०-५६", "content_sanskrit": "यत्पादयोरशठधीः सलिलं प्रदाय दूर्वाङ्कुरैरपि विधाय सतीं सपर्याम्।\nअप्युत्तमां गतिमसौ भजते त्रिलोकीं दत्त्वा नविक्लवमनाः कथमार्तिमृच्छेत्॥ ८/२०/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.067.m4a", "display_order": 68}, {"id": 6000173068, "chapter_id": 10173, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.068.m4a", "display_order": 69}, {"id": 6000173069, "chapter_id": 10173, "verse_number": "८-२०-५७", "content_sanskrit": "ब्रह्मन् यमनुगृह्णामि तद्वित्तं विधुनोम्यहम्।\nयन्मदः पुरुषः स्तब्धो लोकं मां चावमन्यते॥ ८/२०/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.069.m4a", "display_order": 70}, {"id": 6000173070, "chapter_id": 10173, "verse_number": "८-२०-५८", "content_sanskrit": "यदा कदाचिज्जीवात्मा संसरन् निजकर्मभिः।\nनानायोनिष्वनीशोऽयं पौरुषीं गतिमाव्रजेत्॥ ८/२०/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.070.m4a", "display_order": 71}, {"id": 6000173071, "chapter_id": 10173, "verse_number": "८-२०-५९", "content_sanskrit": "जन्मकर्मवयोरूपविद्यैश्वर्यधनादिभिः।\nयद्यस्य न भवेत् स्तम्भस्तत्रायं मदनुग्रहः॥ ८/२०/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.071.m4a", "display_order": 72}, {"id": 6000173072, "chapter_id": 10173, "verse_number": "८-२०-६०", "content_sanskrit": "मानस्तम्भनिमित्तानां जन्मादीनां समन्ततः।\nसर्वश्रेयःप्रतीपानां हन्त मुह्येन्न मत्परः॥ ८/२०/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.072.m4a", "display_order": 73}, {"id": 6000173073, "chapter_id": 10173, "verse_number": "८-२०-६१", "content_sanskrit": "एष दानवदैत्यानामग्रणीः कीर्तिवर्धनः।\nअजैषीदजयां मायां सीदन्नपि न मुह्यति॥ ८/२०/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.073.m4a", "display_order": 74}, {"id": 6000173074, "chapter_id": 10173, "verse_number": "८-२०-६२", "content_sanskrit": "क्षणाद् विभ्रंशितः स्थानात् क्षिप्तो बद्धश्च शत्रुभिः।\nज्ञातिभिश्च परित्यक्तो यातनामनुयापितः॥ ८/२०/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.074.m4a", "display_order": 75}, {"id": 6000173075, "chapter_id": 10173, "verse_number": "८-२०-६३", "content_sanskrit": "गुरुणा भर्त्सितः शप्तो जहौ सत्यं न सुव्रतः।\nछलैरुक्तो मया धर्मो नायं त्यजति सत्पथम्॥ ८/२०/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.075.m4a", "display_order": 76}, {"id": 6000173076, "chapter_id": 10173, "verse_number": "८-२०-६४", "content_sanskrit": "एवं मे प्रापितं स्थानं दुष्प्रापममरैरपि।\nसावर्णेरन्तरस्यायं भवितेन्द्रो मदाश्रयः॥ ८/२०/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.076.m4a", "display_order": 77}, {"id": 6000173077, "chapter_id": 10173, "verse_number": "८-२०-६५", "content_sanskrit": "तावत् सुतलमध्यास्तां विश्वकर्मविनिर्मितम्।\nयत्राधयो व्याधयश्च क्लमस्तन्द्री पराभवः॥ ८/२०/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.077.m4a", "display_order": 78}, {"id": 6000173078, "chapter_id": 10173, "verse_number": "८-२०-६६", "content_sanskrit": "नोपसर्गा निवसतां सम्भवन्ति ममेच्छया।\nइन्द्रसेन महाराज याहि भो भद्रमस्तु ते॥ ८/२०/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.078.m4a", "display_order": 79}, {"id": 6000173079, "chapter_id": 10173, "verse_number": "८-२०-६७", "content_sanskrit": "सुतलं स्वर्गिभिः प्रार्थ्यं ज्ञातिभिः परिवारितः।\nन त्वामभिभविष्यन्ति लोकेशाः किमुतापरे॥ ८/२०/६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.079.m4a", "display_order": 80}, {"id": 6000173080, "chapter_id": 10173, "verse_number": "८-२०-६८", "content_sanskrit": "त्वच्छासनातिगान् दैत्यान् चक्रं मे सूदयिष्यति।\nरक्षिष्ये सर्वतोऽहं त्वां सानुगं सपरिच्छदम्॥ ८/२०/६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.080.m4a", "display_order": 81}, {"id": 6000173081, "chapter_id": 10173, "verse_number": "८-२०-६९", "content_sanskrit": "सदा सन्निहितं वीर तत्र मां द्रक्ष्यते भवान्। तत्र दानवदैत्यानां सङ्गात् ते भाव आसुरः।\nदृष्ट्वा मदनुभावं वै सद्यः कुण्ठोऽवनङ्क्ष्यति॥ ८/२०/६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_020/BhP_08.020.081.m4a", "display_order": 82}, {"id": 6000173082, "chapter_id": 10173, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायाम् अष्टमस्कन्धे विंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}]