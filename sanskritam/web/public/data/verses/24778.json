[{"id": 7004778000, "chapter_id": 24778, "verse_number": "६-२४०-१", "content_sanskrit": "ब्रह्मोवाच ।\nहरेर्दीपस्तु मद्दीपादधिकोऽयं प्रकुर्वतः ।\nवैकुण्ठवास एव स्यान्ममैश्वर्यमवांछितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004778001, "chapter_id": 24778, "verse_number": "६-२४०-२", "content_sanskrit": "नारद उवाच ।\nदीपोऽयं विष्णुभवने मन्त्रवद्विहितो नरैः ।\nसदा विशेषफलदश्चातुर्मास्येऽधिकः कथम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004778002, "chapter_id": 24778, "verse_number": "६-२४०-३", "content_sanskrit": "ब्रह्मोवाच ।\nविष्णुर्नित्याधिदैवं मे विष्णुः पूज्यः सदा मम ।\nविष्णुमेनं सदा ध्याये विष्णुर्मत्तः परो हि सः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004778003, "chapter_id": 24778, "verse_number": "६-२४०-४", "content_sanskrit": "स विष्णु वल्लभो दीपः सर्वदा पापहारकः ।\nचातुर्मास्ये विशेषेण कामनासिद्धिकारकः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004778004, "chapter_id": 24778, "verse_number": "६-२४०-५", "content_sanskrit": "विष्णुर्दीपेन संतुष्टो यथा भवति पुत्रक ।\nतथा यज्ञसहस्रैश्च वरं नैव प्रयच्छति ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004778005, "chapter_id": 24778, "verse_number": "६-२४०-६", "content_sanskrit": "स्वल्प व्ययेन दीपस्य फलमानंतकं नृणाम् ।\nअनंतशयने प्राप्ते पुण्यसंख्या न विद्यते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004778006, "chapter_id": 24778, "verse_number": "६-२४०-७", "content_sanskrit": "तस्मात्सर्वात्मभावेन श्रद्धया संयुतेन च ।\nदीपप्रदानं कुरुते हरेः पापैर्न लिप्यते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004778007, "chapter_id": 24778, "verse_number": "६-२४०-८", "content_sanskrit": "उपचारैः षोडशकैर्यतिरूपे हरौ पुनः ।\nदीपप्रदाने विहिते सर्वमुद्द्योतितं जगत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004778008, "chapter_id": 24778, "verse_number": "६-२४०-९", "content_sanskrit": "दीपादनंतरं ब्रह्मन्नन्नस्य च निवेदनम् ।\nत्रयोदश्या भक्तियुक्तैः कार्यं मोक्षपदस्थितैः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004778009, "chapter_id": 24778, "verse_number": "६-२४०-१०", "content_sanskrit": "अमृतं संपरित्यज्य यदन्नं देवता अपि ।\nस्पृहयंति गृहस्थस्य गृहद्वारगताः सदा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004778010, "chapter_id": 24778, "verse_number": "६-२४०-११", "content_sanskrit": "हरौ सुप्ते विशेषेण प्रदेयः प्रत्यहं नरैः ।\nफलैरर्घ्यो विष्णुतुष्ट्यै तत्कालसमुदा हृतैः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004778011, "chapter_id": 24778, "verse_number": "६-२४०-१२", "content_sanskrit": "तांबूलवल्लीपत्रैश्च तथा पूगफलैः शुभैः ।\nद्राक्षाजंब्वाम्रजफलैरक्रोडैर्दाडिमैरपि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004778012, "chapter_id": 24778, "verse_number": "६-२४०-१३", "content_sanskrit": "बीजपूरफलैश्चैव दद्यादर्घ्यं सुभक्तितः ।\nशंखतोयं समादाय तस्योपरि फलं शुभम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004778013, "chapter_id": 24778, "verse_number": "६-२४०-१४", "content_sanskrit": "मंत्रेणानेन विप्रेन्द्र केशवाय निवेदयेत् ।\nपुनराचमनं देयमन्नदानादनंतरम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004778014, "chapter_id": 24778, "verse_number": "६-२४०-१५", "content_sanskrit": "आर्तिक्यं च ततः कुर्यात्सर्वपापविनाशनम् ।\nचतुर्दश्या नमस्कुर्याद्विष्णवे यतिरूपिणे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004778015, "chapter_id": 24778, "verse_number": "६-२४०-१६", "content_sanskrit": "पंचदश्या भ्रमः कार्यः सर्वदिक्षु द्विजैः सह ।\nसप्तसागरजै स्तोयैर्दत्तैर्यत्फलमाप्यते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004778016, "chapter_id": 24778, "verse_number": "६-२४०-१७", "content_sanskrit": "तत्तोयदानाच्च हरेः प्राप्यते विष्णुवल्लभैः ।\nचतुर्वारभ्रमीभिश्च जगत्सर्वं चराचरम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004778017, "chapter_id": 24778, "verse_number": "६-२४०-१८", "content_sanskrit": "क्रांतं भवति विप्राग्र्य तत्तीर्थगमनादिकम् ।\nषोडश्या देवसायुज्यं चिन्तयेद्योगवित्तमः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004778018, "chapter_id": 24778, "verse_number": "६-२४०-१९", "content_sanskrit": "आत्मनश्च हरेर्नित्यं न मूर्तिं भावयेत्तदा ।\nमूर्तामूर्तस्वरूप त्वाद्दृश्यो भवति योगवित् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004778019, "chapter_id": 24778, "verse_number": "६-२४०-२०", "content_sanskrit": "तस्मिन्दृष्टे निवर्तेत सदसद्रूपजा क्रिया ।\nआत्मानं तेजसां मध्ये चिन्तयेत्सूर्यवर्चसम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004778020, "chapter_id": 24778, "verse_number": "६-२४०-२१", "content_sanskrit": "अहमेव सदा विष्णुरित्यात्मनि विचारयन् ।\nलभते वैष्णवं देहं जीवन्मुक्तो द्विजो भवेत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004778021, "chapter_id": 24778, "verse_number": "६-२४०-२२", "content_sanskrit": "चातुर्मास्ये विशेषेण योगयुक्तो द्विजो भवेत् ।\nइयं भक्तिः समादिष्टा मोक्षमार्गप्रदे हरौ ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]