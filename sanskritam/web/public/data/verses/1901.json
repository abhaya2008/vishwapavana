[{"id": 2040631, "chapter_id": 1901, "verse_number": "५-१४६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2040632, "chapter_id": 1901, "verse_number": "५-१४६-१", "content_sanskrit": "ततः सूर्यान्निश्चरितां कर्णः शुश्राव भारतीम्।\nदुरत्ययां प्रणयिनीं पितृवद्भास्करेरिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2040633, "chapter_id": 1901, "verse_number": "५-१४६-२x", "content_sanskrit": "सूर्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2040634, "chapter_id": 1901, "verse_number": "५-१४६-२", "content_sanskrit": "सत्यमाह पृथा वाक्यं कर्ण मातृवचः कुरु।\nश्रेयस्ते स्यान्नरव्याघ्र सर्वमाचरतस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2040635, "chapter_id": 1901, "verse_number": "५-१४६-३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2040636, "chapter_id": 1901, "verse_number": "५-१४६-३", "content_sanskrit": "एवमुक्तस्य मात्रा च स्वयं पित्रा च भानुना ।\nचचाल नैव कर्णस्य मतिः सत्यधृतेस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2040637, "chapter_id": 1901, "verse_number": "५-१४६-४x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2040638, "chapter_id": 1901, "verse_number": "५-१४६-४", "content_sanskrit": "न चैतच्छ्रद्दधे वाक्यं क्षत्रिये भाषितं त्वया।\nधर्मद्वारं ममैतत्स्यान्नियोगकरणं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2040639, "chapter_id": 1901, "verse_number": "५-१४६-५", "content_sanskrit": "अकरोन्मयि यत्पापं भवती सुमहात्ययम् ।\nअपाकीर्णोऽस्मि यन्मातस्तद्यशःकीर्तिनाशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2040640, "chapter_id": 1901, "verse_number": "५-१४६-६", "content_sanskrit": "अहं चेत्क्षत्रियो जातो न प्राप्तः क्षत्रसत्क्रियाम् ।\nत्वत्कृते किं नु पापीयः शत्रुः कुर्यान्ममाहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2040641, "chapter_id": 1901, "verse_number": "५-१४६-७", "content_sanskrit": "क्रियाकाले त्वनुक्रोशमकृत्वा त्वमिमं मम।\nहीनसंस्क्रासमयमद्य मां समचूचुदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2040642, "chapter_id": 1901, "verse_number": "५-१४६-८", "content_sanskrit": "न वै मम हितं पूर्वं मातृवच्चेष्टितं त्वया।\nसा मां संबोधयस्यद्य केवलात्महितैषिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2040643, "chapter_id": 1901, "verse_number": "५-१४६-९", "content_sanskrit": "कृष्णेन सहितात्को वै न व्यथेत धनंजयात्।\nकोद्य भीतं न मां विद्यात्पर्थानां समितिं गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2040644, "chapter_id": 1901, "verse_number": "५-१४६-१०", "content_sanskrit": "अभ्राता विदितः पूर्वं युद्धकाले प्रकाशितः ।\nपाण्डवान्यदि गच्छामि किं मां क्षत्रं वदिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2040645, "chapter_id": 1901, "verse_number": "५-१४६-११", "content_sanskrit": "सर्वकामैः संविभक्तः पूजितश्च यथासुखम् ।\nअहं वै धार्तराष्ट्राणां कुर्यां तदफलं कथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2040646, "chapter_id": 1901, "verse_number": "५-१४६-१२", "content_sanskrit": "उपनह्य परैर्वैरं ये मां नित्यमुपासते ।\nनमस्कुर्वन्ति च सदा वसवो वासवं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2040647, "chapter_id": 1901, "verse_number": "५-१४६-१३", "content_sanskrit": "मम प्राणेन ये शत्रूञ्शक्ताः प्रतिसमासितुम्।\nमन्यन्ते ते कथं तेषामहं छिन्द्यां मनोरथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2040648, "chapter_id": 1901, "verse_number": "५-१४६-१४", "content_sanskrit": "मया प्लवेन संग्रामं तितीर्षन्ति दुरत्ययम्।\nअपारे पारकामा ये त्यजेयं तानहं कथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2040649, "chapter_id": 1901, "verse_number": "५-१४६-१५", "content_sanskrit": "अयं हि कालः संप्राप्तो धार्तराष्ट्रोपजीविनाम् ।\nनिर्वेष्टव्यं मया तत्र प्राणानपरिरक्षता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2040650, "chapter_id": 1901, "verse_number": "५-१४६-१६", "content_sanskrit": "कृतार्थाः सुभृता ये हि कृत्यकाले ह्युपस्थिते।\nअनवेक्ष्य कृतं पापा विकुर्वन्त्यनवस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2040651, "chapter_id": 1901, "verse_number": "५-१४६-१७", "content_sanskrit": "राजकिल्बिषिणां तेषां भर्तृपिण्डापहारिणाम्।\nनैवायं न परो लोको विद्यते पापकर्मणाम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2040652, "chapter_id": 1901, "verse_number": "५-१४६-१८", "content_sanskrit": "धृतराष्ट्रस्य पुत्राणामर्थे योत्स्यामि ते सुतैः ।\nबलं च शक्तिं चास्थाय न वै त्वय्यनृतं वदे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2040653, "chapter_id": 1901, "verse_number": "५-१४६-१९", "content_sanskrit": "आनृशंस्यमथो वृत्तं रक्षन्सत्पुरुषोचितम्।\nअतोऽर्थकरमप्येतन्न करोम्यद्य ते वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2040654, "chapter_id": 1901, "verse_number": "५-१४६-२०", "content_sanskrit": "न च तेऽयं समारम्भो मयि मोघो भविष्यति।\nवध्यान्विषह्यान्संग्रामे न हनिष्यामि ते सुतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2040655, "chapter_id": 1901, "verse_number": "५-१४६-२१", "content_sanskrit": "युधिष्ठिरं च भीमं च यमौ चैवार्जुनादृते ।\nअर्जुनेन समं युद्धमपि यौधिष्ठिरे बले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2040656, "chapter_id": 1901, "verse_number": "५-१४६-२२", "content_sanskrit": "अर्जुनं हि निहत्याजौ संप्राप्तं स्यात्फलं मया।\nयशसा चापि युज्येयं निहतः सव्यसाचिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2040657, "chapter_id": 1901, "verse_number": "५-१४६-२३", "content_sanskrit": "न ते जातु नशिष्यन्ति पुत्राः पञ्च यशस्विनि ।\nनिरर्जुनाः सकर्णा वा सार्जुना वा हते मयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2040658, "chapter_id": 1901, "verse_number": "५-१४६-२४", "content_sanskrit": "इति कर्णवचः श्रुत्वा कुन्ती दुःखात्प्रवेषती ।\nउवाच पुत्रमाश्लिष्य कर्णं धैर्यादकम्पनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2040659, "chapter_id": 1901, "verse_number": "५-१४६-२५", "content_sanskrit": "एवं वै भाव्यमेतेन क्षयं यास्यन्ति कौरवाः ।\nयथा त्वं भाषसे कर्ण दैवं तु बलवत्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2040660, "chapter_id": 1901, "verse_number": "५-१४६-२६", "content_sanskrit": "त्वया चतुर्णां भ्रातॄणामभयं शत्रुकर्शन ।\nदत्तं तत्प्रतिजानीहि सङ्गरप्रतिमोचनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2040661, "chapter_id": 1901, "verse_number": "५-१४६-२७", "content_sanskrit": "अनामयं स्वस्ति चेति पृथाथो कर्णमब्रवीत् ।\nतां कर्णोऽभ्यवदत्प्रीतस्ततस्तौ जग्मतुः पृथक् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2040662, "chapter_id": 1901, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि षट्चत्वारिंशदधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]