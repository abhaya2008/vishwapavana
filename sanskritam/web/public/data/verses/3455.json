[{"id": 2114087, "chapter_id": 3455, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2114088, "chapter_id": 3455, "verse_number": "१", "content_sanskrit": "कुरुराजे तु रङ्गस्थे भीमे च बलिनां वरे ।\nपक्षपातकृतस्नेहः स द्विधेवाभवज्जनः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2114089, "chapter_id": 3455, "verse_number": "२", "content_sanskrit": "जय हे कुरुराजेति जय हे भीम इत्युत ।\nपुरुषाणां सुविपुळाः प्रणादाः सहसोत्थिताः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2114090, "chapter_id": 3455, "verse_number": "३", "content_sanskrit": "ततः क्षुब्धार्णवसमं रङ्गमालोक्य बुद्धिमान् ।\nभारद्वाजः प्रियं पुत्रमश्वत्थामानमब्रवीत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2114091, "chapter_id": 3455, "verse_number": "४", "content_sanskrit": "वारयैतौ महावीर्यौ कृतयोगावुभावपि ।\nमा भूद् रङ्गप्रकोपोऽयं भीमदुर्योधनोद्भवः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2114092, "chapter_id": 3455, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2114093, "chapter_id": 3455, "verse_number": "५", "content_sanskrit": "तत उत्थाय वेगेन अश्वत्थामा न्यवारयत् ।\nगुरोराज्ञा भीम इति गान्धारे गुरुशासनम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2114094, "chapter_id": 3455, "verse_number": "६", "content_sanskrit": "अलं योगकृतं वेगमलं साहसमित्युत ।\nततस्तावुद्यतगदौ गुरुपुत्रेण वारितौ \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2114095, "chapter_id": 3455, "verse_number": "७", "content_sanskrit": "युगान्तानिलसङ्क्षुब्धौ महावेगाविवार्णवौ ।\nततो रङ्गाङ्कणगतो द्रोणो वचनमब्रवीत् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2114096, "chapter_id": 3455, "verse_number": "८", "content_sanskrit": "निवार्य वादित्रगणं महामेघनिभस्वनम् ।\nयो मे पुत्रात् प्रियतरः सर्वास्त्रविदुषां वरः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2114097, "chapter_id": 3455, "verse_number": "९", "content_sanskrit": "ऐन्द्रिरिन्द्रानुजसमः स पार्थो दृश्यतामिति ।\nआचार्यवचनात् सोऽथ कृतस्वस्त्ययनो युवा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2114098, "chapter_id": 3455, "verse_number": "१०", "content_sanskrit": "बद्धगोधाङ्गुलित्राणः पूर्णतूणः सकार्मुकः ।\nकाञ्चनं कवचं बिभ्रत् प्रत्यदृश्यत फल्गुनः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2114099, "chapter_id": 3455, "verse_number": "११", "content_sanskrit": "एकः सेन्द्रायुधतडित् ससन्ध्य इव तोयदः ।\nततः सर्वस्य रङ्गस्य समुत्पिञ्जलकोऽभवत् ।\nवादित्राण्यप्यवाद्यन्त सशङ्खानि समन्ततः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2114100, "chapter_id": 3455, "verse_number": "", "content_sanskrit": "प्रेक्षकाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2114101, "chapter_id": 3455, "verse_number": "१२", "content_sanskrit": "एष कुन्तीसुतः श्रीमानेष पाण्डवमध्यमः ।\nएष पुत्रो महेन्द्रस्य कुरूणामेष रक्षिता \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2114102, "chapter_id": 3455, "verse_number": "१३", "content_sanskrit": "एषोऽस्त्रविदुषां श्रेष्ठ एष धर्मभृतां वरः ।\nएष शीलवतां चापि शीर्षरत्नाकरोर्जुनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2114103, "chapter_id": 3455, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2114104, "chapter_id": 3455, "verse_number": "१४", "content_sanskrit": "इत्येवमतुळा वाचः शृण्वन्त्याः प्रेक्षकेरिताः ।\nकुन्त्याः प्रस्रवसम्मिश्रैरास्रैः क्लिन्नमुरोऽभवत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2114105, "chapter_id": 3455, "verse_number": "१५", "content_sanskrit": "तेन शब्देन महता पूर्णश्रुतिरथाब्रवीत् ।\nधृतराष्ट्रो नरश्रेष्ठो विदुरं हृष्टमानसः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2114106, "chapter_id": 3455, "verse_number": "१६", "content_sanskrit": "क्षत्तः क्षुब्धार्णवसमः किमेष सुमहास्वनः ।\nसहसैवोत्थितो रङ्गे भिन्दन्निव नभस्तळम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2114107, "chapter_id": 3455, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2114108, "chapter_id": 3455, "verse_number": "१७", "content_sanskrit": "एष पार्थो महाबाहुः कौन्तेयः पाण्डुनन्दनः ।\nअवतीर्णः सकवचस्तत्रैष जननिस्वनः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2114109, "chapter_id": 3455, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2114110, "chapter_id": 3455, "verse_number": "१८", "content_sanskrit": "धन्योऽस्म्यनुगृहीतोऽस्मि रक्षितोऽस्मि महामते ।\nपृथारणिसमुद्भूतैस्त्रिभिः पाण्डववह्निभिः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2114111, "chapter_id": 3455, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2114112, "chapter_id": 3455, "verse_number": "१९", "content_sanskrit": "तस्मिन् प्रमुदिते रङ्गे कथञ्चित् पर्यवस्थिते ।\nदर्शयामास बीभत्सुराचार्यादस्त्रलाघवम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2114113, "chapter_id": 3455, "verse_number": "२०", "content_sanskrit": "आग्नेयेनासृजद् वह्निं वारुणेनासृजत् पयः ।\nवायव्यादसृजद् वायुं पर्जन्यादसृजद् घनान् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2114114, "chapter_id": 3455, "verse_number": "२१", "content_sanskrit": "भौमेन प्रासृजद् भूमिं पार्वतेनासृजद् गिरिम् ।\nअन्तर्धानेन चास्त्रेण पुनरन्तर्हितोऽभवत्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2114115, "chapter_id": 3455, "verse_number": "२२", "content_sanskrit": "क्षणात् प्रांशुः क्षणाद् ह्रस्वः क्षणाच्च रथघूर्गतः ।\nक्षणेन रथमध्यस्थः क्षणेनावतरन्महीम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2114116, "chapter_id": 3455, "verse_number": "२३", "content_sanskrit": "सुकुमारश्च शूरश्च गुरुश्चापि गुरुप्रियः ।\nसौष्ठवेन हि संयुक्तः सोऽविध्यद् विविधैः शरैः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2114117, "chapter_id": 3455, "verse_number": "२४", "content_sanskrit": "भ्रमतश्च वराहस्य सिंहस्य प्रमुखे स्थितः ।\nपञ्च बाणान् नसंयुक्तान् स मुमोचैकबाणवत् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2114118, "chapter_id": 3455, "verse_number": "२५", "content_sanskrit": "गव्ये विषाणकोशे च बालरज्ज्ववलम्बिते ।\nनिचखान महावीरः सायकानेकविंशतिम् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2114119, "chapter_id": 3455, "verse_number": "२६", "content_sanskrit": "इत्येवमादि सुमहत् खड्गे धनुषि चाभवत् ।\nगदायां चास्त्रकुशलो दर्शकानां प्रदर्शयन् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2114120, "chapter_id": 3455, "verse_number": "२७", "content_sanskrit": "चक्रतोमरप्रासानां भिण्डिपालपरश्वधान् ।\nअन्येषां चापि शिक्षाणां दर्शयामास लाघवम् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2114121, "chapter_id": 3455, "verse_number": "२८", "content_sanskrit": "ततः समाप्तभूयिष्ठे तस्मिन् कर्मणि भारत ।\nमन्दीभूते समाजे च वादित्राणां च निस्वने\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2114122, "chapter_id": 3455, "verse_number": "२९", "content_sanskrit": "द्वारदेशात् समुद्भूतो माहात्म्यबलसूचकः ।\nवज्रनिष्पेषसदृशः शुश्रुवे भूरिनिस्वनः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2114123, "chapter_id": 3455, "verse_number": "३०", "content_sanskrit": "शीर्यन्ते किं नु गिरयः किंस्विद् भूमिर्विदीर्यते ।\nकिंस्विदापूर्यते व्योम जलभारस्वनैर्घनैः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2114124, "chapter_id": 3455, "verse_number": "३१", "content_sanskrit": "रङ्गस्यैवं मतिरभूत् क्षणेन वसुधाधिप ।\nद्वारं चाभिमुखाः सर्वे बभूवुः प्रेक्षकास्तदा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2114125, "chapter_id": 3455, "verse_number": "३२", "content_sanskrit": "पञ्चभिर्भ्रातृभिः पार्थैर्द्रोणः परिवृतो बभौ ।\nपञ्चतारेण संयुक्तः सावित्रेणेव चन्द्रमाः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2114126, "chapter_id": 3455, "verse_number": "३३", "content_sanskrit": "अश्वत्थाम्ना च सहितं भ्रातॄणां शतमूर्जितम् ।\nदुर्योधनममित्रघ्नमुत्थितं पर्यवारयत्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2114127, "chapter_id": 3455, "verse_number": "३४", "content_sanskrit": "स तैस्तदा भ्रातृभिरुद्यतायुधै-\nर्वृतो गदापाणिरवस्थितः स्थिरः ।\nबभौ तदा दानवसङ्क्षये पुरा\nपुरन्दरो देवगणैरिवावृतः \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2114128, "chapter_id": 3455, "verse_number": "१३४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nचतुःत्रिंशत्यधिकशततमोऽध्यायः ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2114129, "chapter_id": 3455, "verse_number": "८२", "content_sanskrit": "॥ इति सम्भवपर्वणि द्व्यशीतितमोऽध्यायः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2114130, "chapter_id": 3455, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]