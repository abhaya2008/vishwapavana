[{"id": 6000159000, "chapter_id": 10159, "verse_number": null, "content_sanskrit": "अथ षष्ठाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000159001, "chapter_id": 10159, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.001.m4a", "display_order": 2}, {"id": 6000159002, "chapter_id": 10159, "verse_number": "८-६-१", "content_sanskrit": "एवं स्तुतः सुरगणैर्भगवान् हरिरीश्वरः।\nतेषामाविरभूद् राजन् सहस्रार्कोदयद्युतिः॥ ८/६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.002.m4a", "display_order": 3, "topics": [{"text": "स्तुतिप्रसन्नेन भगवता देवेभ्यः प्रत्यक्षीभवनम्", "range": "१–७"}]}, {"id": 6000159003, "chapter_id": 10159, "verse_number": "८-६-२", "content_sanskrit": "तेनैव महसा सर्वे देवाः प्रतिहतेक्षणाः।\nनापश्यन् खं दिशः क्षोणीमात्मानं चाग्रतो विभुम्॥ ८/६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.003.m4a", "display_order": 4}, {"id": 6000159004, "chapter_id": 10159, "verse_number": "८-६-३", "content_sanskrit": "विरिञ्चो भगवान् दृष्ट्वा सह शर्वेण भारत।\nस्वच्छं मरकतश्यामं कञ्जगर्भारुणेक्षणम्॥ ८/६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.004.m4a", "display_order": 5}, {"id": 6000159005, "chapter_id": 10159, "verse_number": "८-६-४", "content_sanskrit": "तप्तहेमावदातेन लसत्कौशेयवाससा।\nप्रसन्नचारुसर्वाङ्गं सुमुखं सुन्दरभ्रुवम्॥ ८/६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.005.m4a", "display_order": 6}, {"id": 6000159006, "chapter_id": 10159, "verse_number": "८-६-५", "content_sanskrit": "महामणिकिरीटेन केयूराभ्यां च भूषितम्।\nकर्णाभरणनिर्भातकपोलश्रीमुखाम्बुजम्॥ ८/६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.006.m4a", "display_order": 7}, {"id": 6000159007, "chapter_id": 10159, "verse_number": "८-६-६", "content_sanskrit": "काञ्चीकलापवलयहारनूपुरशोभितम्।\nकौस्तुभाभरणं लक्ष्म बिभ्रतं वनमालिनम्॥ ८/६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.007.m4a", "display_order": 8}, {"id": 6000159008, "chapter_id": 10159, "verse_number": "८-६-७", "content_sanskrit": "सुदर्शनादिभिः स्वास्‍त्रैर्मूर्तिमद्भिरुपासितम्। तुष्टाव देवप्रवरः सर्वेशं पुरुषं परम्।\nसर्वामरगणैः सार्धं सर्वाङ्गैरवनिं गतैः॥ ८/६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.008.m4a", "display_order": 9}, {"id": 6000159009, "chapter_id": 10159, "verse_number": null, "content_sanskrit": "ब्रह्मोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.009.m4a", "display_order": 10}, {"id": 6000159010, "chapter_id": 10159, "verse_number": "८-६-८", "content_sanskrit": "अजाय जन्मस्थितिसंयमाय गुणाय निर्वाणसुखार्णवाय।\nअणोरणिम्नेऽपरिगण्यधाम्ने महानुभावाय नमो नमस्ते॥ ८/६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.010.m4a", "display_order": 11, "topics": [{"text": "पुनरपरोक्षतो ब्रह्मणा भगवत्स्तुतिः", "range": "८–१७"}]}, {"id": 6000159011, "chapter_id": 10159, "verse_number": "८-६-९", "content_sanskrit": "रूपं तवैतत् पुरुषर्षभेड्यं श्रेयोऽर्थिभिर्वैदिकतान्त्रिकैश्च।\nयोगेन धातः सह नस्‍त्रिलोकान् पश्याम्यमुष्मिन् भव विश्वमूर्ते॥ ८/६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.011.m4a", "display_order": 12}, {"id": 6000159012, "chapter_id": 10159, "verse_number": "८-६-१०", "content_sanskrit": "त्वय्यग्र आसीदिदमात्मतन्त्रे त्वमादिरन्तो जगतोऽस्य मध्यम्।\nघटस्य मृत्स्नेव परः परस्मात् त्वमेव चाशेषविशेषनामा॥ ८/६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.012.m4a", "display_order": 13}, {"id": 6000159013, "chapter_id": 10159, "verse_number": "८-६-११", "content_sanskrit": "त्वं माययाऽऽत्माश्रयया स्वयेदं निर्माय विश्वं तदनुप्रविष्टः।\nपश्यन्ति युक्ता मनसा मनीषिणो गुणव्यवायेऽप्यगुणं विपश्चितः॥ ८/६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.013.m4a", "display_order": 14}, {"id": 6000159014, "chapter_id": 10159, "verse_number": "८-६-१२", "content_sanskrit": "यथाऽग्निमेधस्यमृतं च गोषु भुव्यन्नम्बूत्खनने तथोर्व्याः।\nयोगैर्मनुष्या अधियन्ति हित्वा गुणेषु बुद्ध्या कवयोऽवयन्ति॥ ८/६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.014.m4a", "display_order": 15}, {"id": 6000159015, "chapter_id": 10159, "verse_number": "८-६-१३", "content_sanskrit": "तं त्वा वयं नाथ समुज्जिहानं सरोजनाभातिचिरेप्सितार्थम्।\nदृष्ट्वा गता निर्वृतिमद्य सर्वे गजा दवार्ता इव गाङ्गमम्भः॥ ८/६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.015.m4a", "display_order": 16}, {"id": 6000159016, "chapter_id": 10159, "verse_number": "८-६-१४", "content_sanskrit": "स त्वं विधत्स्वाखिललोकपाला वयं यदर्थास्तव पादमूलम्।\nसमागतास्ते बहिरन्तरात्मन् किं वाऽद्य विज्ञाप्यमशेषसाक्षिणः॥ ८/६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.016.m4a", "display_order": 17}, {"id": 6000159017, "chapter_id": 10159, "verse_number": "८-६-१५", "content_sanskrit": "अहं गिरित्रश्च सुरादयो ये दक्षादयोऽग्नेरिव केतवस्ते।\nकिं वा विधेमेश पृथग्विभाविता विधत्स्व शं नो द्विजदेवमित्र॥ ८/६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.017.m4a", "display_order": 18}, {"id": 6000159018, "chapter_id": 10159, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.018.m4a", "display_order": 19}, {"id": 6000159019, "chapter_id": 10159, "verse_number": "८-६-१६", "content_sanskrit": "एवं विरिञ्च्यादिभिरीडितस्तद् विज्ञाय तेषां हृदयं यथैव।\nजगाद जीमूतगभीरया गिरा बद्धाञ्जलीन् संवृतसर्वकामान्॥ ८/६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.019.m4a", "display_order": 20}, {"id": 6000159020, "chapter_id": 10159, "verse_number": "८-६-१७", "content_sanskrit": "एक एवेश्वरस्तस्मिन् सुरकार्ये सुरेश्वरः।\nविहर्तुकामस्तानाह समुद्रोन्मथनादिभिः॥ ८/६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.020.m4a", "display_order": 21}, {"id": 6000159021, "chapter_id": 10159, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.021.m4a", "display_order": 22}, {"id": 6000159022, "chapter_id": 10159, "verse_number": "८-६-१८", "content_sanskrit": "हन्त ब्रह्मन्नहो शम्भो हे देवा मम भाषितम्।\nशृणुतावहिताः सर्वे श्रेयो वः स्याद् यथा पुरा॥ ८/६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.022.m4a", "display_order": 23, "topics": [{"text": "भगवता श्रीनारायणेन देवान्प्रति असुरैः सह सन्धिं कृत्वा तत्साहाय्येन क्षीरोदधौ अमृतमथनार्थमाज्ञादानम्", "range": "१८–२६"}]}, {"id": 6000159023, "chapter_id": 10159, "verse_number": "८-६-१९", "content_sanskrit": "यातुधानैश्च दैतेयैस्तावत् सन्धिर्विधीयताम्।\nकालेनानुगृहीतैस्तैर्यावद् वो भव आत्मनः॥ ८/६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.023.m4a", "display_order": 24}, {"id": 6000159024, "chapter_id": 10159, "verse_number": "८-६-२०", "content_sanskrit": "अरयोऽपि हि सन्धेयाः सति कार्यार्थगौरवे।\nअहिमूषकवद् देवा ह्यर्थस्य पदवीं गतैः॥ ८/६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.024.m4a", "display_order": 25}, {"id": 6000159025, "chapter_id": 10159, "verse_number": "८-६-२१", "content_sanskrit": "अमृतोत्पादने यत्नः क्रियतामविलम्बितम्।\nयस्य पीतस्य वै जन्तुर्मृत्युग्रस्तोऽमरो भवेत्॥ ८/६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.025.m4a", "display_order": 26}, {"id": 6000159026, "chapter_id": 10159, "verse_number": "८-६-२२", "content_sanskrit": "क्षिप्त्वा क्षीरोदधौ सर्वा वीरुत्तृणलतौषधीः।\nमन्थानं मन्दरं कृत्वा नेत्रं कृत्वा तु वासुकिम्॥ ८/६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.026.m4a", "display_order": 27}, {"id": 6000159027, "chapter_id": 10159, "verse_number": "८-६-२३", "content_sanskrit": "सहायेन मया देवा निर्मथध्वमतन्द्रिताः।\nक्लेशभाजो भविष्यन्ति दैत्या, यूयं फलग्रहाः॥ ८/६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.027.m4a", "display_order": 28}, {"id": 6000159028, "chapter_id": 10159, "verse_number": "८-६-२४", "content_sanskrit": "यूयं तदनुमोदध्वं यदिच्छन्त्यसुराः सुराः।\nन संरम्भेण सिध्यन्ति सर्वेऽर्थाः सान्त्वया यथा॥ ८/६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.028.m4a", "display_order": 29}, {"id": 6000159029, "chapter_id": 10159, "verse_number": "८-६-२५", "content_sanskrit": "न भेतव्यं कालकूटाद् विषाज्जलधिसम्भवात्।\nलोभः कार्यो न वो जातु रोषः कामस्तु वस्तुषु॥ ८/६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.029.m4a", "display_order": 30}, {"id": 6000159030, "chapter_id": 10159, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.030.m4a", "display_order": 31}, {"id": 6000159031, "chapter_id": 10159, "verse_number": "८-६-२६", "content_sanskrit": "इति देवान् समादिश्य भगवान् पुरुषोत्तमः।\nतेषामन्तर्दधे राजन् स्वच्छन्दगतिरीश्वरः॥ ८/६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.031.m4a", "display_order": 32}, {"id": 6000159032, "chapter_id": 10159, "verse_number": "८-६-२७", "content_sanskrit": "अथ तस्मै भगवते नमस्कृत्य पितामहः।\nभवश्च जग्मतुः स्वं स्वं धाम चेयुर्बलिं सुराः॥ ८/६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.032.m4a", "display_order": 33, "topics": [{"text": "तदर्थं मन्दरपर्वतानयनम्", "range": "२७–३९"}]}, {"id": 6000159033, "chapter_id": 10159, "verse_number": "८-६-२८", "content_sanskrit": "दृष्ट्वाऽरीनथ सम्पन्नान् जातक्षोभान् स्वनायकान्।\nन्यषेधद् दैत्यराडुच्चैः सन्धिविग्रहकालवित्॥ ८/६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.033.m4a", "display_order": 34}, {"id": 6000159034, "chapter_id": 10159, "verse_number": "८-६-२९", "content_sanskrit": "ते वैरोचनिमासीनं गुप्तं चासुरयूथपैः।\nश्रिया परमया जुष्टं जिताशेषमुपागमन्॥ ८/६/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.034.m4a", "display_order": 35}, {"id": 6000159035, "chapter_id": 10159, "verse_number": "८-६-३०", "content_sanskrit": "महेन्द्रः श्लक्ष्णया वाचा सान्त्वयित्वा महामतिः।\nअभ्यभाषत तत्सर्वं शिक्षितं पुरुषोत्तमात्॥ ८/६/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.035.m4a", "display_order": 36}, {"id": 6000159036, "chapter_id": 10159, "verse_number": "८-६-३१", "content_sanskrit": "तदरोचत दैत्यस्य तत्रान्ये येऽसुराधिपाः।\nशम्बरोऽरिष्टनेमिश्च ये च त्रिपुरवासिनः॥ ८/६/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.036.m4a", "display_order": 37}, {"id": 6000159037, "chapter_id": 10159, "verse_number": "८-६-३२", "content_sanskrit": "ततो देवासुराः कृत्वा संविदं कृतसौहृदाः।\nउद्यमं परमं चक्रुरमृतार्थे परन्तप॥ ८/६/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.037.m4a", "display_order": 38}, {"id": 6000159038, "chapter_id": 10159, "verse_number": "८-६-३३", "content_sanskrit": "ततस्ते मन्दरगिरिमञ्जसोत्पाट्य दुर्मदाः।\nनदन्त उदधिं निन्युः शक्ताः परिघबाहवः॥ ८/६/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.038.m4a", "display_order": 39}, {"id": 6000159039, "chapter_id": 10159, "verse_number": "८-६-३४", "content_sanskrit": "दूरभारोद्वहश्रान्ताः शक्रवैरोचनादयः।\nअपारयन्तस्तं वोढुं विवशा विजहुः पथि॥ ८/६/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.039.m4a", "display_order": 40}, {"id": 6000159040, "chapter_id": 10159, "verse_number": "८-६-३५", "content_sanskrit": "निपतन् स गिरिस्तावद् बहून् अमरदानवान्।\nचूर्णयामास महता भारेण कनकाचलः॥ ८/६/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.040.m4a", "display_order": 41}, {"id": 6000159041, "chapter_id": 10159, "verse_number": "८-६-३६", "content_sanskrit": "तांस्तथा भग्नमनसो भग्नबाहूरुकन्धरान्।\nविज्ञाय भगवांस्तत्र बभूव गरुडध्वजः॥ ८/६/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.041.m4a", "display_order": 42}, {"id": 6000159042, "chapter_id": 10159, "verse_number": "८-६-३७", "content_sanskrit": "गिरिपातविनिष्पिष्टान् विलोक्यामरदानवान्।\nईक्षया जीवयामास निर्जरान् निर्व्रणान् यथा॥ ८/६/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.042.m4a", "display_order": 43}, {"id": 6000159043, "chapter_id": 10159, "verse_number": "८-६-३८", "content_sanskrit": "गिरिं चारोप्य गरुडे हस्तेनैकेन लीलया।\nआरुह्य प्रययावब्धिं सुरासुरगणैर्वृतः॥ ८/६/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.043.m4a", "display_order": 44}, {"id": 6000159044, "chapter_id": 10159, "verse_number": "८-६-३९", "content_sanskrit": "अवरोप्य गिरिं स्कन्धात् सुपर्णः पततां वरः।\nययौ जलान्त उत्सृज्य हरिणा स विसर्जितः॥ ८/६/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_006/BhP_08.006.044.m4a", "display_order": 45}, {"id": 6000159045, "chapter_id": 10159, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायाम्ऽष्टमस्कन्धे षष्ठाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]