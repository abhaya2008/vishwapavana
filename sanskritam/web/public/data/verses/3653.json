[{"id": 2123736, "chapter_id": 3653, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2123737, "chapter_id": 3653, "verse_number": "१", "content_sanskrit": "ततो व्यध्वगतं पार्थं प्रातिकामी युधिष्ठिरम् ।\nउवाच वचनाद् राज्ञो धृतराष्ट्रस्य धीमतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2123738, "chapter_id": 3653, "verse_number": "२", "content_sanskrit": "उपास्तीर्णा सभा राजन्नक्षानुप्त्वा युधिष्ठिर ।\nएहि पाण्डव दीव्येति पिता त्वाह नराधिपः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2123739, "chapter_id": 3653, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2123740, "chapter_id": 3653, "verse_number": "३", "content_sanskrit": "धातुर्नियोगाद् भूतानि प्राप्नुवन्ति शुभाशुभे ।\nन निवृत्तिस्तयोरस्ति देवितव्यं पुनर्यदि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2123741, "chapter_id": 3653, "verse_number": "४", "content_sanskrit": "अक्षद्यूते समाह्वानं नियोगात् स्थविरस्य च ।\nजानन्नपि च यत् क्षुद्रं नातिक्रमितुमुत्सहे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2123742, "chapter_id": 3653, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2123743, "chapter_id": 3653, "verse_number": "समाप्तिः", "content_sanskrit": "इति ब्रुवन् निववृते भ्रातृभिः सह पाण्डवः ।\nजानंश्च शकुनेर्मायां पार्थो द्यूतमियात् पुनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2123744, "chapter_id": 3653, "verse_number": "६", "content_sanskrit": "विविशुस्ते सभां तां तु पुनरेव महारथाः ।\nव्यथयन्ति स्म चेतांसि सुहृदां भरतर्षभ ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2123745, "chapter_id": 3653, "verse_number": "७", "content_sanskrit": "यथोपजोषमासीनाः पुनर्द्यूतप्रवृत्तये ।\nसर्वराजविनाशाय दैवेनोपनिपीडिताः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2123746, "chapter_id": 3653, "verse_number": "", "content_sanskrit": "शकुनिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2123747, "chapter_id": 3653, "verse_number": "८", "content_sanskrit": "अमुञ्चत् स्थविरो यद्वो धनं विजितमेव तत् ।\nमहाग्लहं धनं चैकं शृणु मे भरतर्षभ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2123748, "chapter_id": 3653, "verse_number": "९", "content_sanskrit": "वयं द्वादश वर्षाणि युष्माभिर्द्यूतनिर्जिताः ।\nप्रविशेम महारण्यं रौरवाजिनवाससः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2123749, "chapter_id": 3653, "verse_number": "१०", "content_sanskrit": "त्रयोदशं च स्वजनैः प्रच्छन्नाः परिवत्सरम् ।\nज्ञाताश्चेत् पुनरन्यानि वने वर्षाणि द्वादश ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2123750, "chapter_id": 3653, "verse_number": "११", "content_sanskrit": "अस्माभिर्वा जिता यूयं वने वर्षाणि द्वादश ।\nवसध्वं कृष्णया सार्धमजिनैः परिवारिताः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2123751, "chapter_id": 3653, "verse_number": "१२", "content_sanskrit": "त्रयोदशे च निर्वृत्ते पुनरेव यथोचितम् ।\nस्वराज्यं प्रतिपत्तव्यमितरैरथवेतरैः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2123752, "chapter_id": 3653, "verse_number": "१३", "content_sanskrit": "अनेन व्यवसायेन सहास्माभिर्नृपोत्तम ।\nअक्षानुप्त्वा पुनर्द्यूतमेहि दीव्यस्व भारत ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2123753, "chapter_id": 3653, "verse_number": "१४", "content_sanskrit": "अथ सभ्याः सभामध्ये समुच्छ्रितकरास्तथा ।\nऊचुरुद्विग्नमनसः संवेगात् सर्व एव हि ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2123754, "chapter_id": 3653, "verse_number": "१५", "content_sanskrit": "अहो धिक् बान्धवानेतान् बोधयन्ति महद्भयम् ।\nबुद्ध्याऽबुद्ध्यन्त बुध्द्यन्ते वयं च भरतर्षभाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2123755, "chapter_id": 3653, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2123756, "chapter_id": 3653, "verse_number": "१६", "content_sanskrit": "जनप्रवादान् सुबहून् इति शृण्वन् नराधिपः ।\nह्रिया च धर्मसङ्गाच्च पार्थो द्यूतमियात् पुनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2123757, "chapter_id": 3653, "verse_number": "१७", "content_sanskrit": "जानन्नपि महाबुद्धिः पुनर्द्यूतमवर्तयत् ।\nअप्ययं नु विनाशः स्यात् कुरूणामिति चिन्तयन् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2123758, "chapter_id": 3653, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2123759, "chapter_id": 3653, "verse_number": "१८", "content_sanskrit": "कथं वै मद्विधो राजा स्वधर्ममनुपालयन् ।\nआहूतो विनिवर्तेत दीव्यामि शकुने त्वया ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2123760, "chapter_id": 3653, "verse_number": "", "content_sanskrit": "शकुनिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2123761, "chapter_id": 3653, "verse_number": "१९", "content_sanskrit": "गजाश्वं बहुधेनूकमपर्यन्तमजाविकम् ।\nतथा गावो हिरण्यं च दासीदासं च सर्वशः ।\nएष वै ग्लह एवैको वनवासाय पाण्डव ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2123762, "chapter_id": 3653, "verse_number": "२०", "content_sanskrit": "यूयं वयं वा विजिता वसेम वनमाश्रिताः ।\nत्रयोदशं च वै वर्षमज्ञाताः स्वजनैस्तथा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2123763, "chapter_id": 3653, "verse_number": "२१", "content_sanskrit": "अनेन व्यवसायेन दीव्याम भरतर्षभ ।\nसमुत्क्षेपेण चैकेन वनवासाय भारत ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2123764, "chapter_id": 3653, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2123765, "chapter_id": 3653, "verse_number": "२२", "content_sanskrit": "एवं दैवबलाविष्टो धर्मराजो युधिष्ठिरः ।\nभीष्मद्रोणौ वार्यमाणो विदुरेण च धीमता ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2123766, "chapter_id": 3653, "verse_number": "२३", "content_sanskrit": "युयुत्सुना कृपेणाथ सञ्जयेन च भारत ।\nगान्धार्या पृथया चैव भीमार्जुनयमैस्तथा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2123767, "chapter_id": 3653, "verse_number": "२४", "content_sanskrit": "विकर्णेन च वीरेण द्रौपद्या द्रौणिना तथा ।\nसोमदत्तेन च तथा बाह्लीकेन च धीमता ।\nवार्यतेऽतीव सततं न च राजा नियच्छति ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2123768, "chapter_id": 3653, "verse_number": "२५", "content_sanskrit": "एवं संवार्यमाणोऽपि कौन्तेयो हितकाम्यया ।\nदेवकार्यार्थसिद्ध्यर्थं मुहूर्तं कलिमाविशत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2123769, "chapter_id": 3653, "verse_number": "२६", "content_sanskrit": "आविष्टः कलिना राजन् शकुनिं प्रत्यभाषत ।\nएवं भवत्विति तदा वनवासाय दीव्यते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2123770, "chapter_id": 3653, "verse_number": "२७", "content_sanskrit": "प्रतिजग्राह तत् पार्थो ग्लहं जग्राह सौबलः ।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2123771, "chapter_id": 3653, "verse_number": "३", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि पञ्चनवतितमोऽध्यायः ॥९५॥\n॥ अनुद्यूतपर्वणि तृतीयोऽध्यायः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2123772, "chapter_id": 3653, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]