[{"id": 5000050000, "chapter_id": 9050, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे पञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000050001, "chapter_id": 9050, "verse_number": "१-५०-१", "content_sanskrit": "ततः प्रागुत्तरां गत्वा रामः सौमित्रिणा सह।\nविश्वामित्रं पुरस्कृत्य यज्ञवाटमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000050002, "chapter_id": 9050, "verse_number": "१-५०-२", "content_sanskrit": "रामस्तु मुनिशार्दूलमुवाच सहलक्ष्मणः।\nसाध्वी यज्ञसमृद्धिर्हि जनकस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000050003, "chapter_id": 9050, "verse_number": "१-५०-३", "content_sanskrit": "बहूनीह सहस्राणि नानादेशनिवासिनाम्।\nब्राह्मणानां महाभाग वेदाध्ययनशालिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000050004, "chapter_id": 9050, "verse_number": "१-५०-४", "content_sanskrit": "ऋषिवाटाश्च दृश्यन्ते शकटीशतसंकुलाः।\nदेशो विधीयतां ब्रह्मन् यत्र वत्स्यामहे वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000050005, "chapter_id": 9050, "verse_number": "१-५०-५", "content_sanskrit": "रामस्य वचनं श्रुत्वा विश्वामित्रो महामुनिः।\nनिवासमकरोद् देशे विविक्ते सलिलान्विते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000050006, "chapter_id": 9050, "verse_number": "१-५०-६", "content_sanskrit": "विश्वामित्रमनुप्राप्तं श्रुत्वा नृपवरस्तदा।\nशतानन्दं पुरस्कृत्य पुरोहितमनिन्दितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000050007, "chapter_id": 9050, "verse_number": "१-५०-७", "content_sanskrit": "ऋत्विजोऽपि महात्मानस्त्वर्घ्यमादाय सत्वरम्।\nप्रत्युज्जगाम सहसा विनयेन समन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000050008, "chapter_id": 9050, "verse_number": "१-५०-८", "content_sanskrit": "विश्वामित्राय धर्मेण ददौ धर्मपुरस्कृतम्।\nप्रतिगृह्य तु तां पूजां जनकस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000050009, "chapter_id": 9050, "verse_number": "१-५०-९", "content_sanskrit": "पप्रच्छ कुशलं राज्ञो यज्ञस्य च निरामयम्।\nस तांश्चाथ मुनीन् पृष्ट्वा सोपाध्यायपुरोधसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000050010, "chapter_id": 9050, "verse_number": "१-५०-१०", "content_sanskrit": "यथार्हमृषिभिः सर्वैः समागच्छत् प्रहृष्टवत्।\nअथ राजा मुनिश्रेष्ठं कृताञ्जलिरभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000050011, "chapter_id": 9050, "verse_number": "१-५०-११", "content_sanskrit": "आसने भगवानास्तां सहैभिर्मुनिपुंगवैः।\nजनकस्य वचः श्रुत्वा निषसाद महामुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000050012, "chapter_id": 9050, "verse_number": "१-५०-१२", "content_sanskrit": "पुरोधा ऋत्विजश्चैव राजा च सहमन्त्रिभिः।\nआसनेषु यथान्यायमुपविष्टाः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000050013, "chapter_id": 9050, "verse_number": "१-५०-१३", "content_sanskrit": "दृष्ट्वा स नृपतिस्तत्र विश्वामित्रमथाब्रवीत्।\nअद्य यज्ञसमृद्धिर्मे सफला दैवतैः कृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000050014, "chapter_id": 9050, "verse_number": "१-५०-१४", "content_sanskrit": "अद्य यज्ञफलं प्राप्तं भगवद्दर्शनान्मया।\nधन्योऽस्म्यनुगृहीतोऽस्मि यस्य मे मुनिपुंगवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000050015, "chapter_id": 9050, "verse_number": "१-५०-१५", "content_sanskrit": "यज्ञोपसदनं ब्रह्मन् प्राप्तोऽसि मुनिभिः सह।\nद्वादशाहं तु ब्रह्मर्षे दीक्षामाहुर्मनीषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000050016, "chapter_id": 9050, "verse_number": "१-५०-१६", "content_sanskrit": "ततो भागार्थिनो देवान् द्रष्टुमर्हसि कौशिक।\nइत्युक्त्वा मुनिशार्दूलं प्रहृष्टवदनस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000050017, "chapter_id": 9050, "verse_number": "१-५०-१७", "content_sanskrit": "पुनस्तं परिपप्रच्छ प्राञ्जलिः प्रयतो नृपः।\nइमौ कुमारौ भद्रं ते देवतुल्यपराक्रमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000050018, "chapter_id": 9050, "verse_number": "१-५०-१८", "content_sanskrit": "गजतुल्यगती वीरौ शार्दूलवृषभोपमौ।\nपद्मपत्रविशालाक्षौ खड्गतूणीधनुर्धरौ।\nअश्विनाविव रूपेण समुपस्थितयौवनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000050019, "chapter_id": 9050, "verse_number": "१-५०-१९", "content_sanskrit": "यदृच्छयेव गां प्राप्तौ देवलोकादिवामरौ।\nकथं पद‍्भ्यामिह प्राप्तौ किमर्थं कस्य वा मुने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000050020, "chapter_id": 9050, "verse_number": "१-५०-२०", "content_sanskrit": "वरायुधधरौ वीरौ कस्य पुत्रौ महामुने।\nभूषयन्ताविमं देशं चन्द्रसूर्याविवाम्बरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000050021, "chapter_id": 9050, "verse_number": "१-५०-२१", "content_sanskrit": "परस्परस्य सदृशौ प्रमाणेङ्गितचेष्टितैः।\nकाकपक्षधरौ वीरौ श्रोतुमिच्छामि तत्त्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000050022, "chapter_id": 9050, "verse_number": "१-५०-२२", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा जनकस्य महात्मनः।\nन्यवेदयदमेयात्मा पुत्रौ दशरथस्य तौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000050023, "chapter_id": 9050, "verse_number": "१-५०-२३", "content_sanskrit": "सिद्धाश्रमनिवासं च राक्षसानां वधं तथा।\nतत्रागमनमव्यग्रं विशालायाश्च दर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000050024, "chapter_id": 9050, "verse_number": "१-५०-२४", "content_sanskrit": "अहल्यादर्शनं चैव गौतमेन समागमम्।\nमहाधनुषि जिज्ञासां कर्तुमागमनं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000050025, "chapter_id": 9050, "verse_number": "१-५०-२५", "content_sanskrit": "एतत् सर्वं महातेजा जनकाय महात्मने।\nनिवेद्य विररामाथ विश्वामित्रो महामुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000050026, "chapter_id": 9050, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे पञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]