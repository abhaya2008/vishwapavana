[{"id": 2142265, "chapter_id": 4066, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2142266, "chapter_id": 4066, "verse_number": "१", "content_sanskrit": "विराटस्य वचः श्रुत्वा पार्थस्य च महात्मनः ।\nउत्तरः प्रत्युवाचेदमभिपन्ने युधिष्ठिरे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2142267, "chapter_id": 4066, "verse_number": "२", "content_sanskrit": "प्रसादनं प्राप्तकालं पाण्डवस्याभिरोचये ।\nतेजस्वी बलवान् शूरो राजराजेश्वरः प्रभुः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2142268, "chapter_id": 4066, "verse_number": "३", "content_sanskrit": "उत्तरां च वरारोहां पार्थस्यामित्रकर्शन ।\nप्रणिपत्य प्रयच्छामस्तस्य शिष्या भवामहे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2142269, "chapter_id": 4066, "verse_number": "४", "content_sanskrit": "वयं च सर्वे सामात्याः कुन्तीपुत्रं युधिष्ठिरम् ।\nप्रसाद्य ह्युपतिष्ठामो राजन् किं करवामहे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2142270, "chapter_id": 4066, "verse_number": "५", "content_sanskrit": "राजंस्त्वमसि सङ्ग्रामे गृहीतस्तेन मोक्षितः ।\nएतेषां बाहुवीर्येण गावश्च विजितास्त्वया\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2142271, "chapter_id": 4066, "verse_number": "६", "content_sanskrit": "कुरवो निर्जिता यस्मात् सङ्ग्रामेऽमिततेजसः ।\nएष तत् सर्वमकरोत् कुन्तीपुत्रो युधिष्ठिरः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2142272, "chapter_id": 4066, "verse_number": "७", "content_sanskrit": "आर्याः पूज्याश्च मान्याश्च प्रत्युत्थेयाश्च पाण्डवाः ।\nअर्च्याश्चैवाभिवाद्याश्च प्राप्तकालं च मे मतम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2142273, "chapter_id": 4066, "verse_number": "८", "content_sanskrit": "पूज्यन्तां पूजनीयाश्च महाभागाश्च पाण्डवाः ।\nन ह्येते कुपिताः शेषं कुर्युराशीविषोपमाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2142274, "chapter_id": 4066, "verse_number": "९", "content_sanskrit": "तस्माच्छीघ्रं प्रपद्यामः कुन्तीपुत्रं युधिष्ठिरम् ।\nप्रसादयाम भद्रं ते सह पार्थैर्महात्मभिः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2142275, "chapter_id": 4066, "verse_number": "१०", "content_sanskrit": "जानाम्यहमिदं सर्वमेषां तु बलपौरुषम् ।\nकुले च जन्म महति फल्गुनस्य च विक्रमम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2142276, "chapter_id": 4066, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2142277, "chapter_id": 4066, "verse_number": "११", "content_sanskrit": "उत्तरात् पाण्डवान् श्रुत्वा विराटो दुःखमोहितः ।\nउत्तरं चापि सम्प्रेक्ष्य प्राप्तकालमचिन्तयत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2142278, "chapter_id": 4066, "verse_number": "१२", "content_sanskrit": "ततो विराटः सामात्यः सकळत्रः सबान्धवः ।\nउत्तरामग्रतः कृत्वा शिरःस्नातां कृताञ्जलिः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2142279, "chapter_id": 4066, "verse_number": "१३", "content_sanskrit": "भूमौ निपतितस्तूर्णं पाण्डवस्य समीपतः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2142280, "chapter_id": 4066, "verse_number": "", "content_sanskrit": "विराटः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2142281, "chapter_id": 4066, "verse_number": "१४", "content_sanskrit": "प्रसीदतु महाराजो धर्मपुत्रो युधिष्ठिरः ।\nप्रच्छन्नरूपवेषत्वान्नाग्निर्दृष्टस्तृणैर्वृतः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2142282, "chapter_id": 4066, "verse_number": "१५", "content_sanskrit": "शिरसाऽभिप्रपन्नोऽस्मि सपुत्रपरिचारकः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2142283, "chapter_id": 4066, "verse_number": "१६", "content_sanskrit": "यदस्माभिरजानद्भिरधिक्षिप्तो महीपतिः ।\nअवमत्य कृतं सर्वमयुक्तं प्राकृतो यथा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2142284, "chapter_id": 4066, "verse_number": "१७", "content_sanskrit": "क्षन्तुमर्हसि तत्सर्वं धर्मज्ञो बन्धुवत्सलः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2142285, "chapter_id": 4066, "verse_number": "१८", "content_sanskrit": "यदिदं मामकं राष्ट्रं पुरं राज्यं च पार्थिव ।\nसदण्डकोशं विसृजे तव भृत्योऽस्मि पाण्डव\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2142286, "chapter_id": 4066, "verse_number": "१९", "content_sanskrit": "वयं च सर्वे सामात्या भवन्तं शरणं गताः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2142287, "chapter_id": 4066, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2142288, "chapter_id": 4066, "verse_number": "२०", "content_sanskrit": "तं धर्मराजः पतितं महीतळे\nसबन्धुवर्गं प्रसमेत्य पार्थिवम् ।\nउवाच वाक्यं परलोकदर्शनः\nप्रनष्टमन्युर्गतशोकमत्सरः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2142289, "chapter_id": 4066, "verse_number": "२१", "content_sanskrit": "न ते भयं पार्थिव विद्यते मयि\nप्रतीतिरूपोऽस्म्यनुचिन्त्य पार्थिव ।\nएतत् त्वया सम्यगिहोपपादितं\nद्विजैरमात्यैः सदृशैश्च पण्डितैः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2142290, "chapter_id": 4066, "verse_number": "२२", "content_sanskrit": "इमां च कन्यां समलङ्कृतां भृशं\nसमीक्ष्य तुष्टोऽस्मि नरेन्द्रसत्तम\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2142291, "chapter_id": 4066, "verse_number": "२३", "content_sanskrit": "क्षान्तमेतन्महाबाहो यन्मां वदसि पार्थिव ।\nन चैव किञ्चित् पश्यामि विकृतं ते नराधिप\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2142292, "chapter_id": 4066, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2142293, "chapter_id": 4066, "verse_number": "२४", "content_sanskrit": "ततो विराटः परमाभितुष्टः\nसमीक्ष्य राज्ञा समयं चकार ।\nराज्यं च सर्वं विससर्ज तस्मै\nसदण्डकोशं सपुरं महात्मा\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2142294, "chapter_id": 4066, "verse_number": "२५", "content_sanskrit": "पाण्डवांश्च ततः सर्वान् मत्स्यराजः प्रतापवान् ।\nधनञ्जयं पुरस्कृत्य दिष्ट्या दिष्ट्येति चाब्रवीत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2142295, "chapter_id": 4066, "verse_number": "२६", "content_sanskrit": "समुपाघ्राय मूर्धानं संश्लिष्य च पुनः पुनः ।\nयुधिष्ठिरं च भीमं च माद्रीपुत्रौ धनञ्जयम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2142296, "chapter_id": 4066, "verse_number": "२७", "content_sanskrit": "नातृप्यद् दर्शने तेषां विराटो वाहिनीपतिः ।\nसम्प्रीयमाणो राजानं युधिष्ठिरमथाब्रवीत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2142297, "chapter_id": 4066, "verse_number": "२८", "content_sanskrit": "दिष्ट्या भवन्तः सम्प्राप्ताः सर्वे कुशलिनो वनात् ।\nदिष्ट्या सम्पारितं कृच्छ्रमज्ञातं वै महात्मभिः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2142298, "chapter_id": 4066, "verse_number": "२९", "content_sanskrit": "इदं च राज्यं वः पार्था यच्चान्यद् वसु किञ्चन\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2142299, "chapter_id": 4066, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि चतुःसप्ततितमोऽध्यायः ॥७४॥ वैवाहिकपर्वणि तृतीयोऽध्यायः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2142300, "chapter_id": 4066, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]