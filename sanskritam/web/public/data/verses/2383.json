[{"id": 2065283, "chapter_id": 2383, "verse_number": "९-२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2065284, "chapter_id": 2383, "verse_number": "९-२-१", "content_sanskrit": "विसृष्टास्वथ नारीषु धृतराष्ट्रोऽम्बिकासुतः।\nविललाप महाराज दुःखाद्दुःखतरं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2065285, "chapter_id": 2383, "verse_number": "९-२-२", "content_sanskrit": "सधूममिव निःश्वस्य करौ धुन्वन्पुनःपुनः।\nबहु सञ्चिन्तयित्वा तु सञ्जयं वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2065286, "chapter_id": 2383, "verse_number": "९-२-३x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2065287, "chapter_id": 2383, "verse_number": "९-२-३", "content_sanskrit": "अहो बत महद्दुःखं यदहं पाण्डवान्रणे।\nक्षेमिणश्चाव्ययांश्चैव त्वत्तः सूत शृणोमि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2065288, "chapter_id": 2383, "verse_number": "९-२-४", "content_sanskrit": "वज्रसारमयं नूनं हृदयं सुदृढं मम।\nयच्छ्रुत्वा निहतान्पुत्रान्दीर्यते न सहस्रधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2065289, "chapter_id": 2383, "verse_number": "९-२-५", "content_sanskrit": "चिन्तयित्वा वचस्तेषां बालक्रीडां च सञ्जय।\nअद्य चैव हताञ्श्रुत्वा दीर्यते मे भृशं मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2065290, "chapter_id": 2383, "verse_number": "९-२-६", "content_sanskrit": "अन्धत्वाद्यदि पुत्राणां न मे रूपिनिदर्शनम्।\nपुत्रस्नेहकृता प्रीतिर्नित्यमेतेषु धारिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2065291, "chapter_id": 2383, "verse_number": "९-२-७", "content_sanskrit": "बालभावमतिक्रम्य यौवनस्थांश्च तानहम्।\nश्रियं प्राप्तांश्च ताञ्श्रुत्वा हृष्ट आसं तदाऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2065292, "chapter_id": 2383, "verse_number": "९-२-८", "content_sanskrit": "तानद्य निहताञ्श्रुत्वा हतैश्वर्यान्हतौजसः।\nन लभेयं क्वचिच्छान्तिं पुत्राधिभिरभिप्लुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2065293, "chapter_id": 2383, "verse_number": "९-२-९", "content_sanskrit": "एह्येहि वत्स राजेन्द्र ममानाथस्य पुत्रक।\nत्वया हीनो महाबाहो कां नु यास्याम्यहं गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2065294, "chapter_id": 2383, "verse_number": "९-२-१०", "content_sanskrit": "कथं त्वं पृथिवीपालांस्त्यक्त्वा तात समागतान्।\nशेषे विनिहतो भूमौ प्राकृतः कुनृपो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2065295, "chapter_id": 2383, "verse_number": "९-२-११", "content_sanskrit": "गतिर्भूत्वा महाराज ज्ञातीनां सुहृदां तथा।\nअन्धं वृद्वं च मां वीर विहाय क्व नु यास्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2065296, "chapter_id": 2383, "verse_number": "९-२-१२", "content_sanskrit": "सा कृपा सा च ते प्रीतिः सा च राजसु मानिता।\nकथं त्वं निहतः पार्थैः संयुगेष्वपराजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2065297, "chapter_id": 2383, "verse_number": "९-२-१३", "content_sanskrit": "को नु मामुत्थितः काले ताततातेति वक्ष्यति।\nमहाराजेति सततं लोकनाथेति चासकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2065298, "chapter_id": 2383, "verse_number": "९-२-१४", "content_sanskrit": "परिष्वज्य च कं कण्ठे स्नेहेन क्लिन्नलोचनः।\nअनुशास्ताऽस्मि कौरव्य तत्साधु वदमे वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2065299, "chapter_id": 2383, "verse_number": "९-२-१५", "content_sanskrit": "ननु नामाहमश्रौषं वचनं तव पुत्रक।\nभूयसी मम पृथ्वीयं तात पार्थस्य नो तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2065300, "chapter_id": 2383, "verse_number": "९-२-१६", "content_sanskrit": "भगदत्तः कृपः शल्य आवन्त्योऽथ जयद्रथः।\nभूरिश्रवाः सोमदत्तो महाराजश्च बाह्लिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2065301, "chapter_id": 2383, "verse_number": "९-२-१७", "content_sanskrit": "अश्वत्थामा च भोजश्च मागधश्च महाबलः।\nबृहद्बलश्च क्राथश्च शकुनिश्चापि सौबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2065302, "chapter_id": 2383, "verse_number": "९-२-१८", "content_sanskrit": "म्लेच्छाश्च शतसाहस्राः शकाश्च यवनैः सह।\nसुदक्षिणश्च काम्भोजस्त्रिगर्ताधिपतिस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2065303, "chapter_id": 2383, "verse_number": "९-२-१९", "content_sanskrit": "भीष्मः पितामहश्चैव भारद्वाजोऽथ गौतमः।\nश्रुतायुश्चाश्रुतायुश्च शतायुश्चापि वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2065304, "chapter_id": 2383, "verse_number": "९-२-२०", "content_sanskrit": "जलसन्धोऽथार्ष्यशृङ्गी राक्षसश्चाप्यलायुधः।\nअलम्बुसो वीरबाहुः सुबाहुश्च महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2065305, "chapter_id": 2383, "verse_number": "९-२-२१", "content_sanskrit": "एते चान्ये च बहवो राजानो राजसत्तम।\nमदर्थं प्रहरिष्यन्ति प्राणांस्त्यक्त्वा धनानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2065306, "chapter_id": 2383, "verse_number": "९-२-२२", "content_sanskrit": "तेषां मध्ये स्थितो युद्धे भ्रातृभिः परिवारितः।\nयोधयिष्याम्यहं पार्थान्पाञ्चालांश्चैव सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2065307, "chapter_id": 2383, "verse_number": "९-२-२३", "content_sanskrit": "चेदींश्च नृपशार्दूल द्रौपदेयांश्च संयुगे।\nसात्यकिं कुन्तिभोजं च राक्षसं च घटोत्कचम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2065308, "chapter_id": 2383, "verse_number": "९-२-२४", "content_sanskrit": "एकोऽप्येषां महाराज समर्थः सन्निवारणे।\nसमरे पाण्डवेयानां सङ्क्रुद्धो ह्यभिधावताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2065309, "chapter_id": 2383, "verse_number": "९-२-२५", "content_sanskrit": "किं पुनः सहिता वीराः कृतवैराश्च पाण्डवैः।\nअथवा सर्व एवैते पाण्डवस्यानुयायिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2065310, "chapter_id": 2383, "verse_number": "९-२-२६", "content_sanskrit": "योत्स्यन्ते सह राजेन्द्र हनिष्यन्ति च तान्मृधे।\nकर्ण एको मया सार्धं निहनिष्यति पाण्डवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2065311, "chapter_id": 2383, "verse_number": "९-२-२७", "content_sanskrit": "ते वै नृपतयो वीराः स्थास्यन्ति मम शासने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2065312, "chapter_id": 2383, "verse_number": "९-२-२८", "content_sanskrit": "यश्च तेषां प्रणेता वै वासुदेवो महाबलः।\nन स सन्नह्यते राजन्निति मामब्रवीद्वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2065313, "chapter_id": 2383, "verse_number": "९-२-२९", "content_sanskrit": "एवं च वदतः सूत बहुशो मम सन्निधौ।\nयुक्तितो ह्यनुपश्यामि निहतान्पाण़्डवान्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2065314, "chapter_id": 2383, "verse_number": "९-२-३०", "content_sanskrit": "तेषां मध्ये स्थिता यत्र हन्यन्ते मम पुत्रकाः।\nव्यायच्छमानाः समरे किमन्यद्भागधेयतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2065315, "chapter_id": 2383, "verse_number": "९-२-३१", "content_sanskrit": "भीष्मश्च निहतो यत्र लोकनाथः प्रतापवान्।\nशिखण़्डिनं समासाद्य मृगेन्द्र इव जम्बुकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2065316, "chapter_id": 2383, "verse_number": "९-२-३२", "content_sanskrit": "द्रोणश्च ब्राह्मणो यत्र सर्वशस्त्रास्त्रपारगः।\nनिहतः पाण्डवैः सङ्ख्ये किमन्यद्भागधेयतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2065317, "chapter_id": 2383, "verse_number": "९-२-३३", "content_sanskrit": "कर्णश्च निहतः सङ्ख्ये दिव्यास्त्रज्ञो महाबलः।\nभूरिश्रवा हतो पत्र सोमदत्तश्च संयुगे।\nबाह्लिकश्च महाराज किमन्यद्भागधेयतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2065318, "chapter_id": 2383, "verse_number": "९-२-३४", "content_sanskrit": "भगदत्तो हतो यत्र गजयुद्धविशारदः।\nजयद्रथश्च निहतः किमन्यद्भागधेयतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2065319, "chapter_id": 2383, "verse_number": "९-२-३५", "content_sanskrit": "सुदक्षिणो हतो यत्र जलसन्धश्च पौरवः।\nश्रुतायुश्चाश्रुतायुश्च किमन्यद्भागधेयतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2065320, "chapter_id": 2383, "verse_number": "९-२-३६", "content_sanskrit": "महाबलस्तथा पाण्ड्यः सर्वशस्त्रभृतां वरः।\nनिहतः पाण्डवैः सङ्ख्ये किमन्यद्भागधेयतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2065321, "chapter_id": 2383, "verse_number": "९-२-३७", "content_sanskrit": "बृहद्बलो हतो यत्र मागधश्च महाबलः।\nउग्रायुधश्च विक्रान्तः प्रतिमानं धनुष्मताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2065322, "chapter_id": 2383, "verse_number": "९-२-३८", "content_sanskrit": "आवन्त्यो निहतो यत्र त्रैगर्तश्च जनाधिपः।\nसंशप्तकाश्च निहताः किमन्यद्भागधेयतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2065323, "chapter_id": 2383, "verse_number": "९-२-३९", "content_sanskrit": "अलम्बुसस्तथा राजन्राक्षसश्चाप्यलायुधः।\nआर्ष्यशृङ्गिश्च निहतः किमन्यद्भागधेयतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2065324, "chapter_id": 2383, "verse_number": "९-२-४०", "content_sanskrit": "नारायणा हता यत्र गोपाला युद्धदुर्मदाः।\nम्लेच्छाश्च बहुसाहस्राः किमन्यद्भागधेयतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2065325, "chapter_id": 2383, "verse_number": "९-२-४१", "content_sanskrit": "शकुनिः सौबलो यत्र कैतव्यश्च महाबलः।\nनिहतः सबलो वीरः किमन्यद्भागधेयतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2065326, "chapter_id": 2383, "verse_number": "९-२-४२", "content_sanskrit": "एते चान्ये च बहवः कृतास्त्रा युद्धदुर्मदाः।\nराजानो राजपुत्राश्च शूराः परिघबाहवः।\nनिहता बहवो यत्र किमन्यद्भागधेयतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2065327, "chapter_id": 2383, "verse_number": "९-२-४३", "content_sanskrit": "यत्र शूरा महेष्वासाः कृतास्त्रा युद्वदुर्मदाः।\nबहवो निहताः सूत महेन्द्रसमविक्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2065328, "chapter_id": 2383, "verse_number": "९-२-४४", "content_sanskrit": "नानादेशसमावृत्ताः क्षत्रिया यत्र सञ्जय।\nनिहताः समरे सर्वे किमन्यद्भागधेयतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2065329, "chapter_id": 2383, "verse_number": "९-२-४५", "content_sanskrit": "पुत्राश्च मे विनिहताः पौत्राश्चैव महाबलाः।\nवयस्या भ्रातरश्चैव किमन्यद्भागधेयतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2065330, "chapter_id": 2383, "verse_number": "९-२-४६", "content_sanskrit": "भागधेयसमायुक्तो ध्रुवमुत्पद्यते नरः।\nयस्तु भाग्यसमायुक्तः स शुभं प्राप्नुयान्नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2065331, "chapter_id": 2383, "verse_number": "९-२-४७", "content_sanskrit": "अहं वियुक्तस्तैर्भाग्यैः पुत्रैश्चैवेह सञ्जय।\nकथमद्य भविष्यामि वृद्धः शत्रुवशं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2065332, "chapter_id": 2383, "verse_number": "९-२-४८", "content_sanskrit": "नान्यदत्र परं मन्ये वनवासादृते प्रभो।\nसोऽहं वनं गमिष्यामि निर्बन्धुर्ज्ञातिसंक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2065333, "chapter_id": 2383, "verse_number": "९-२-४९", "content_sanskrit": "न हि मेऽन्यद्भवेच्छ्रेयो वनाभ्युपगमादृते।\nइमामवस्थां प्राप्तस्य लूनपक्षस्य सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2065334, "chapter_id": 2383, "verse_number": "९-२-५०", "content_sanskrit": "दुर्योधनो हतो यत्र शल्यश्च निहतो युधि।\nदुःशासनो विविंशश्च विकर्णश्च महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2065335, "chapter_id": 2383, "verse_number": "९-२-५१", "content_sanskrit": "कथं हि भीमसेनस्य श्रोष्येऽहं शब्दमुत्तमम्।\nएकेन समरे येन हतं पुत्रशतं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2065336, "chapter_id": 2383, "verse_number": "९-२-५२", "content_sanskrit": "असकृद्वदतस्तस्य दुर्योधनवधेन च।\nदुःखशोकाभिसन्तप्तो न श्रोष्ये परुषा गिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2065337, "chapter_id": 2383, "verse_number": "९-२-५३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2065338, "chapter_id": 2383, "verse_number": "९-२-५३", "content_sanskrit": "एवं स शोकसन्तप्तः पार्थिवो हतबान्धवः।\nमुहुर्मुहुर्मुह्यमानः पुत्राधिभिरभिप्लुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2065339, "chapter_id": 2383, "verse_number": "९-२-५४", "content_sanskrit": "विलप्य सुचिरं कालं धृतराष्ट्रोऽम्बिकासुतः।\nदीर्घमुष्णं स निःश्वस्य चिन्तयित्वा पराभवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2065340, "chapter_id": 2383, "verse_number": "९-२-५५", "content_sanskrit": "दुःखेन महता राजन्सन्तप्तो भरतर्षभः।\nपुनर्गावल्गणिं सूतं पर्यपृच्छद्यथातथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2065341, "chapter_id": 2383, "verse_number": "९-२-५६x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2065342, "chapter_id": 2383, "verse_number": "९-२-५६", "content_sanskrit": "भीष्मद्रोणौ हतौ श्रुत्वा सूतपुत्रं च पातितम्।\nसेनापतिं प्रणेतारं कमकुर्वत मामकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2065343, "chapter_id": 2383, "verse_number": "९-२-५७", "content_sanskrit": "यं यं सेनाप्रणेतारं युधि कुर्वन्ति मामकाः।\nअचिरेणैव कालेन तं तं निघ्नन्ति पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2065344, "chapter_id": 2383, "verse_number": "९-२-५८", "content_sanskrit": "रणमूर्ध्नि हतो भीष्मः पश्यतां वः किरीटिना।\nएवमेव हतो द्रोणः सर्वेषामेव पश्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2065345, "chapter_id": 2383, "verse_number": "९-२-५९", "content_sanskrit": "एवमेव हतः कर्णः सूतपुत्रः प्रतापवान्।\nसराजकानां सर्वेषां पश्यतां वः किरीटिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2065346, "chapter_id": 2383, "verse_number": "९-२-६०", "content_sanskrit": "पूर्वमेवाहमुक्तो वै विदुरेण महात्मना।\nदुर्योधनापराधेन प्रजेयं विनशिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2065347, "chapter_id": 2383, "verse_number": "९-२-६१", "content_sanskrit": "केचिन्न सम्यक्पश्यन्ति मूढाः सम्यगवेक्ष्य च।\nतदिदं मम मूढस्य तथाभूतं वचः स्म तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2065348, "chapter_id": 2383, "verse_number": "९-२-६२", "content_sanskrit": "यदब्रवीत्स धर्मात्मा विदुरो दीर्घदर्शिवान्।\nतत्तथा समनुप्राप्तं वचनं सत्यवादिनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2065349, "chapter_id": 2383, "verse_number": "९-२-६३", "content_sanskrit": "दैवोपहतचित्तेन यन्मयाऽनुष्ठितं पुरा।\nअनयस्य फलं तस्य ब्रूहि गावल्गणे पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2065350, "chapter_id": 2383, "verse_number": "९-२-६४", "content_sanskrit": "को वा मुखमनीकानामासीत्कर्णो निपातिते।\nअर्जुनं वासुदेवं च को वा प्रत्युद्ययौ रथी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2065351, "chapter_id": 2383, "verse_number": "९-२-६५", "content_sanskrit": "केऽरक्षन्दक्षिणं चक्रं मद्रराजस्य संयुगे।\nवामं च योद्वुकामस्य के वा वीरस्य पृष्ठतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2065352, "chapter_id": 2383, "verse_number": "९-२-६६", "content_sanskrit": "कथं च वः समेतानां मद्रराजो महारथः।\nनिहतः पाण्डवैः सङ्ख्ये पुत्रो वा मम सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2065353, "chapter_id": 2383, "verse_number": "९-२-६७", "content_sanskrit": "ब्रूहि सर्वं यथातत्त्वं भरतानां महाक्षयम्।\nयथा च निहतः सङ्ख्ये पुत्रो दुर्योधनो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2065354, "chapter_id": 2383, "verse_number": "९-२-६८", "content_sanskrit": "पाञ्चालाश्च यथा सर्वे निहताः सपदानुगाः।\nधृष्टद्युम्नः शिखण्डी च द्रौपद्याः पञ्च चात्मजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2065355, "chapter_id": 2383, "verse_number": "९-२-६९", "content_sanskrit": "पाण्डवाश्च यथा मुक्तास्तथोभौ माधवौ युधि।\nकृपश्च कृतवर्मा च भारद्वाजस्य चात्मजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2065356, "chapter_id": 2383, "verse_number": "९-२-७०", "content_sanskrit": "यद्यथा यादृशं चैव युद्धं वृत्तं च साम्प्रतम्।\nअखिलं श्रोतुमिच्छामि कुशलो ह्यसि सञ्जय॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2065357, "chapter_id": 2383, "verse_number": "९-२-०", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि शल्यवधपर्वणि द्वितीयोऽध्यायः* ॥ २ ॥* एतदनन्तरं झ.पाठे एकोऽध्यायोऽधिको दृश्यते।\nशल्यपर्व - अध्याय ००२*\nMahabharata - Shalya Parva - Chapter Topics\nपार्थेन निहते कर्णे पाण्डवभयात्पलायमानां सेनां निवर्त्य दुर्योधनस्य पुनर्युद्धोद्यमः॥ १ ॥\nMahabharata - Shalya Parva - Chapter Text", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2065358, "chapter_id": 2383, "verse_number": "९-२-०x", "content_sanskrit": "[सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2065359, "chapter_id": 2383, "verse_number": "९-२-१", "content_sanskrit": "शृणु राजन्नवहितो यथावृत्तो महान्क्षयः।\nकुरूणां पाण्डवानां च समासाद्य परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2065360, "chapter_id": 2383, "verse_number": "९-२-२", "content_sanskrit": "निहते सूतपुत्रे तु पाण्डवेन महात्मना।\nविद्रुतेषु च सैन्येषु समानीतेषु चासकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2065361, "chapter_id": 2383, "verse_number": "९-२-३", "content_sanskrit": "घोरे मनुष्यदेहानामाजौ नरवरक्षये।\nयत्तत्कर्णे हते पार्थः कसिंहनादमथाकरोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2065362, "chapter_id": 2383, "verse_number": "९-२-४", "content_sanskrit": "तदा तव सुतान्राजन्प्राविशत्सुमहद्भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2065363, "chapter_id": 2383, "verse_number": "९-२-५", "content_sanskrit": "न सन्धातुमनीकानि न चैवाथ पराक्रमे।\nआसीद्बुद्धिर्हते कर्णे तव योधस्य कस्यचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2065364, "chapter_id": 2383, "verse_number": "९-२-६", "content_sanskrit": "वणिजो नावि भिन्नायामगाधे विप्लुवा इव।\nअपारे पारमिच्छन्तो हते द्वीपे किरीटिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2065365, "chapter_id": 2383, "verse_number": "९-२-७", "content_sanskrit": "सूतपुत्रो हते राजन्वित्रस्ताः शरविक्षताः।\nअनाथा नाथमिच्छन्तो मृगाः सिंहार्दिता इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2065366, "chapter_id": 2383, "verse_number": "९-२-८", "content_sanskrit": "भग्नशृङ्गा इव वृषा शीर्णदंष्ट्रा इवोरगाः।\nप्रत्युपायाम सायाह्ने निर्जिताः सव्यसाचिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2065367, "chapter_id": 2383, "verse_number": "९-२-९", "content_sanskrit": "हतप्रवीरा विध्वस्ता निकृत्ता निशितैः शरैः।\nसूतपुत्रे हते राजन्पुत्रास्ते प्राद्रवंस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2065368, "chapter_id": 2383, "verse_number": "९-२-१०", "content_sanskrit": "विध्वस्तकवचनाः सर्वे कान्दिशीका विचेतसः।\nअन्योन्यमभिनिघ्नन्तो वीक्षमाणा भयाद्दिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2065369, "chapter_id": 2383, "verse_number": "९-२-११", "content_sanskrit": "मामेव नूनं बीभत्सुर्मामेव च वृकोदरः।\nअभियातीति मन्वानाः पेतुर्मम्लुश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2065370, "chapter_id": 2383, "verse_number": "९-२-१२", "content_sanskrit": "अश्वानन्ये गजानन्ये रथानन्ये महारथाः।\nआरुह्य जवसम्पन्नाः पादातान्प्रजहुर्भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2065371, "chapter_id": 2383, "verse_number": "९-२-१३", "content_sanskrit": "कुञ्जरैः स्यन्दना भग्नाः सादिनश्च महारथैः।\nपदातिसङ्घाश्चाश्वौघैः पलायद्भिर्भृशं हताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2065372, "chapter_id": 2383, "verse_number": "९-२-१४", "content_sanskrit": "व्यालतस्करसङ्कीर्णे सार्थहीना यथा वने।\nतथा त्वदीया निहते सूतपुत्रे पदाऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2065373, "chapter_id": 2383, "verse_number": "९-२-१५", "content_sanskrit": "हतारोहास्तथा नागाश्छिन्नहस्तास्तथाऽपरे।\nसर्वं पार्थमयं लोकमपश्यन्वै भयार्दिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2065374, "chapter_id": 2383, "verse_number": "९-२-१६", "content_sanskrit": "तान्प्रेक्ष्य द्रवतः सर्वान्भीमसेनभयार्दितान्।\nदुर्योधनोऽथ स्वं सूतं हाहाकृत्वैवमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2065375, "chapter_id": 2383, "verse_number": "९-२-१७", "content_sanskrit": "नातिक्रमिष्यते पार्थो धनुष्पाणिमवस्थितम्।\nजघने युध्यमानं मां तूर्णमश्वान्प्रचोदय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2065376, "chapter_id": 2383, "verse_number": "९-२-१८", "content_sanskrit": "समरे युध्यमानं हि कौन्तेयो मां धनञ्जयः।\nनोत्सहेताप्यतिक्रान्तुं वेलामिव महार्णवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2065377, "chapter_id": 2383, "verse_number": "९-२-१९", "content_sanskrit": "अद्यार्जुनं सगोविन्दं मानिनं च वृकोदरम्।\nनिहत्य शिष्टाञ्शत्रूंश्च कर्णस्यानृण्यमाप्नुयाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2065378, "chapter_id": 2383, "verse_number": "९-२-२०", "content_sanskrit": "तच्छ्रुत्वा कुरुराजस्य शूरार्यसदृशं वचः।\nसूतो हेमपरिच्छन्नाञ्शनैरश्वानचोदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2065379, "chapter_id": 2383, "verse_number": "९-२-२१", "content_sanskrit": "गजाश्वरथहीनास्तु पादाताश्चैव मारिष।\nपञ्चविंशतिसाहस्राः प्राद्रवञ्शनकैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2065380, "chapter_id": 2383, "verse_number": "९-२-२२", "content_sanskrit": "तान्भीमसेनः सङ्क्रुद्धो धृष्टद्युम्नश्च पार्षतः।\nबलेन चतुरङ्गेण परिक्षिप्याहनच्छरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2065381, "chapter_id": 2383, "verse_number": "९-२-२३", "content_sanskrit": "प्रत्ययुध्यंस्तु ते सर्वे भीमसेनं सपार्षतम्।\nपार्थपार्षतयोश्चान्ये जगृहुस्तत्र नामनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2065382, "chapter_id": 2383, "verse_number": "९-२-२४", "content_sanskrit": "अक्रुध्यत रणे भीमस्तैर्मृधे प्रत्यवस्थितैः।\nसोऽवतीर्य रथात्तूर्णं गदापाणिरयुध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2065383, "chapter_id": 2383, "verse_number": "९-२-२५", "content_sanskrit": "न तान्रथस्थो भूमिष्ठान्धर्मापेक्षी वृकोदरः।\nयोधयामास कौन्तेयो भुजवीर्यमुपाश्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2065384, "chapter_id": 2383, "verse_number": "९-२-२६", "content_sanskrit": "जातरूपपरिच्छन्नां प्रगृह्य महतीं गदाम्।\nन्यवधीत्तावकान्सर्वान्दण्डपाणिरिवान्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2065385, "chapter_id": 2383, "verse_number": "९-२-२७", "content_sanskrit": "पदातयो हि संरब्धास्त्यक्तजीवितबान्धवाः।\nभीममभ्यद्रवन्सङ्ख्ये पतङ्गा इव पावकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2065386, "chapter_id": 2383, "verse_number": "९-२-२८", "content_sanskrit": "आसाद्य भीमसेनं ते संरब्धा युद्धदुर्मदाः।\nविनेदुः सहसा दृष्ट्वा भूतग्रामा इवान्तकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2065387, "chapter_id": 2383, "verse_number": "९-२-२९", "content_sanskrit": "श्येनवद्व्यचरद्भीमः खङ्गेन गदया तथा।\nपञ्चविंशतिसाहस्रांस्तावकानां व्यपोथयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2065388, "chapter_id": 2383, "verse_number": "९-२-३०", "content_sanskrit": "हत्वा तत्पुरुषानीकं भीमः सत्यपराक्रमः।\nधृष्टद्युम्नं पुरस्कृत्य पुनस्तस्थौ महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2065389, "chapter_id": 2383, "verse_number": "९-२-३१", "content_sanskrit": "धनञ्जयो रथानीकमन्वपद्यत वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2065390, "chapter_id": 2383, "verse_number": "९-२-३२", "content_sanskrit": "माद्रीपुत्रौ च शकुनिं सात्यकिश्च महाबलः।\nजवेनाभ्यपतन्हृष्टा घ्नन्तो दौर्योधनं बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2065391, "chapter_id": 2383, "verse_number": "९-२-३३", "content_sanskrit": "तस्याश्ववाहान्सुबहूंस्ते निहत्य शितैः शरैः।\nतमन्वधावंस्त्वरितास्तत्र युद्धमवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2065392, "chapter_id": 2383, "verse_number": "९-२-३४", "content_sanskrit": "ततो धनञ्जयो राजन्रथानीकमगाहत।\nविश्रुतं त्रिषु लोकेषु गाण्डीवं व्याक्षिपन्धनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2065393, "chapter_id": 2383, "verse_number": "९-२-३५", "content_sanskrit": "कृष्णसारथिमायान्तं दृष्ट्वा श्वेतहयं रथम्।\nअर्जुनं चापि योद्वारं त्वदीयाः प्राद्रावन्भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2065394, "chapter_id": 2383, "verse_number": "९-२-३६", "content_sanskrit": "विप्रहीनरथाश्वाश्च शरैश्च परिवारिताः।\nपञ्चविंशतिसाहस्राः पार्थमार्च्छन्पदातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2065395, "chapter_id": 2383, "verse_number": "९-२-३७", "content_sanskrit": "हत्वा तत्पुरुषानीकं पाञ्चालानां महारथः।\nभीमसेनं पुरस्कृत्य न चिरात्प्रत्यदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2065396, "chapter_id": 2383, "verse_number": "९-२-३८", "content_sanskrit": "महाधनुर्धरः श्रीमानमित्रगणमर्दनः।\nपुत्रः पाञ्चालराजस्य धृष्टद्युम्नो महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2065397, "chapter_id": 2383, "verse_number": "९-२-३९", "content_sanskrit": "पारावतसवर्णाश्वं कोविदारवरध्वजम्।\nधृष्टद्युम्नं रणे दृष्ट्वा त्वदीयाः प्राद्रवन्भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2065398, "chapter_id": 2383, "verse_number": "९-२-४०", "content_sanskrit": "गान्धारराजं श्रीघ्रास्त्रमनुसृत्य यशस्विनौ।\nअचिरात्प्रत्यदृश्येतां माद्रीपुत्रौ ससात्यकी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2065399, "chapter_id": 2383, "verse_number": "९-२-४१", "content_sanskrit": "चेकितानः शिखण्डी च द्रौपदेयाश्च मारिष।\nहत्वा त्वदीयं सुमहत्सैन्यं शङ्खानथाधमन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2065400, "chapter_id": 2383, "verse_number": "९-२-४२", "content_sanskrit": "ते सर्वे तावकान्प्रेक्ष्य द्रवतो वै पराङ्मुखान्।\nअभ्यधावन्त निघ्नन्तो वृषाञ्चित्वा वृषा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2065401, "chapter_id": 2383, "verse_number": "९-२-४३", "content_sanskrit": "सेनावशेषं तं दृष्ट्वा तव पुत्रस्य पाण्डवः।\nअवस्थितं सव्यसाची चुक्रोध बलवन्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2065402, "chapter_id": 2383, "verse_number": "९-२-४४", "content_sanskrit": "तत एनं शरै राजन्सहसा समवाकिरत्।\nरजसा चोद्गतेनाथ न स्म किञ्चन दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2065403, "chapter_id": 2383, "verse_number": "९-२-४५", "content_sanskrit": "अन्धकारीकृते लोके शरीभूते महीतले।\nदिशः सर्वा महाराज तावकाः प्राद्रवन्भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2065404, "chapter_id": 2383, "verse_number": "९-२-४६", "content_sanskrit": "भज्यमानेषु सर्वेषु कुरुराजो विशाम्पते।\nपरेषामात्मनश्चैव सैन्ये ते समुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2065405, "chapter_id": 2383, "verse_number": "९-२-४७", "content_sanskrit": "ततो दुर्योधनः सर्वानाजुहावाथ पाण्डवान्।\nयुद्धाय भरतश्रेष्ठ देवानिव पुरा बलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2065406, "chapter_id": 2383, "verse_number": "९-२-४८", "content_sanskrit": "त एनमभिगर्जन्तं सहिताः समुपाद्रवन्।\nनानाशस्त्रसृजः क्रुद्धा भर्त्सयन्तो मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2065407, "chapter_id": 2383, "verse_number": "९-२-४९", "content_sanskrit": "दुर्योधनोऽप्यसम्भ्रान्तस्तानरीन्व्यधमच्छरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2065408, "chapter_id": 2383, "verse_number": "९-२-५०", "content_sanskrit": "तत्राद्भुतमपरश्याम तव पुत्रस्य पौरुषम्।\nयदेनं पाण्डवाः सर्वे न शेकुरतिवर्तितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2065409, "chapter_id": 2383, "verse_number": "९-२-५१", "content_sanskrit": "नातिदूरापयातं च कृतबुद्धि पलायने।\nदुर्योधनः स्वकं सैन्यमपश्यकद्भृशविक्षतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2065410, "chapter_id": 2383, "verse_number": "९-२-५२", "content_sanskrit": "ततोऽवस्थाप्य राजेन्द्र कृतबुद्धिस्तवात्मजः।\nहर्षयन्निव तान्योधांस्ततो वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2065411, "chapter_id": 2383, "verse_number": "९-२-५३", "content_sanskrit": "न तं देशं प्रपश्यामि पृथिव्यां पर्वतेषु च।\nयत्र यातान्न वो हन्युः पाण्डवाः किं सृतेन वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2065412, "chapter_id": 2383, "verse_number": "९-२-५४", "content_sanskrit": "स्वल्पं चैव बलं तेषां कृष्णौ च भृशविक्षतौ।\nयदि सर्वेऽपि तिष्ठामो ध्रुवं नो विजयो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2065413, "chapter_id": 2383, "verse_number": "९-२-५५", "content_sanskrit": "विप्लयातांस्तु वो भिन्नान्पाण्डवाः कृतकिल्पिषान्।\nअनुसृत्य हनिष्यन्ति श्रेयोः न समरे वधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2065414, "chapter_id": 2383, "verse_number": "९-२-५६", "content_sanskrit": "सुखः साङ्ग्रामिको मृत्युः क्षत्रधर्मेण युध्यताम्।\nमृतो दुःखं न जानीते प्रेत्य चानन्त्यमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2065415, "chapter_id": 2383, "verse_number": "९-२-५७", "content_sanskrit": "शृण्वन्तु क्षत्रियाः सर्वे यावन्तोऽत्र समागताः।\nद्विषतो भीमसेनस्य वशमेष्यथ विद्रुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2065416, "chapter_id": 2383, "verse_number": "९-२-५८", "content_sanskrit": "पितामहैराचरितं न धर्मं हातुमर्हथ।\nनान्यत्कर्मास्ति पापीयः क्षत्रियस्य पलायनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2065417, "chapter_id": 2383, "verse_number": "९-२-५९", "content_sanskrit": "न युद्वधर्माच्छ्रेयान्हि पन्थाः स्वर्गस्य कौरवाः।\nसुचिरेणार्जिताँलोकान्सद्यो युद्धात्समश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2065418, "chapter_id": 2383, "verse_number": "९-२-६०", "content_sanskrit": "तस्य तद्वचनं राज्ञः पूजयित्वा महारथाः।\nपुनरेवाभ्यवर्तन्त क्षत्रियाः पाण्डवान्प्रति।\nपराजयममृष्यन्त कृतचित्ताश्च विक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2065419, "chapter_id": 2383, "verse_number": "९-२-६१", "content_sanskrit": "ततः प्रववृते युद्धं पुनरेव सुदारुणम्।\nतावकानां परेषां च देवासुररणोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2065420, "chapter_id": 2383, "verse_number": "९-२-६२", "content_sanskrit": "युधिष्ठिरपुरोगांश्च सर्वसैन्येन पाण्डवान्।\nअन्वधावन्महाराज पुत्रो दुर्योधनस्तव॥] ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2065421, "chapter_id": 2383, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि शल्यवधपर्वणि अध्यायः॥\nMahabharata - Shalya Parva - Chapter Footnotes\n९-२-२ सधूममिव अत्युष्णित्यर्थः॥ ९-२-१४ परिष्वज्य च मां कण्ठे स्नेहेन क्लिन्नलोचनः। अनुशाधीति कौरव्य तत्साधु वद मे वचः इति झ.पाठः॥ ९-२-३७ प्रतिमानं केतुभूतः॥ ९-२-६१ केचित्सम्यक्प्रपश्यन्ति मूढास्तु न तथा परे इति ख.पाठः। सम्यगवेक्ष्य निपुणं विभाव्यापि मूढास्तथाभूतं तद्वचः केचिन्न पश्यन्तीति सम्बन्धः। तथाभूतं यथार्थम्॥ ९-२-२ द्वितीयोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}]