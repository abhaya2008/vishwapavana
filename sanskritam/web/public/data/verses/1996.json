[{"id": 2044462, "chapter_id": 1996, "verse_number": "६-४५-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2044463, "chapter_id": 1996, "verse_number": "६-४५-१", "content_sanskrit": "पूर्वाह्णे तस्य रौद्रस्य युद्धमह्नो विशांपते।\nप्रावर्तत महाघोरं राज्ञां देहावकर्तनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2044464, "chapter_id": 1996, "verse_number": "६-४५-२", "content_sanskrit": "कुरूणां सृञ्जयानां च जिगीषूणां परस्परम् ।\nसिंहानामिव संह्रादो दिवमुर्वी च नादयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2044465, "chapter_id": 1996, "verse_number": "६-४५-३", "content_sanskrit": "आसीत्किलकिलाशब्दस्तलशङ्खरवैः सह ।\nजझिरे सिंहनादाश्च शूराणां प्रतिगर्जताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2044466, "chapter_id": 1996, "verse_number": "६-४५-४", "content_sanskrit": "तलत्राभिहताश्चैव ज्याशब्दा भरतर्षभ।\nपत्तीनां पादशब्दश्च वाजिनां च महास्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2044467, "chapter_id": 1996, "verse_number": "६-४५-५", "content_sanskrit": "तोत्राङ्कुशनिपातश्च आयुधानां च निःस्वनः।\nघण्टाशब्दश्च नागानामन्योन्यमभिधावताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2044468, "chapter_id": 1996, "verse_number": "६-४५-६", "content_sanskrit": "तस्मिन्समुदिते शब्दे तुगुले रोमहर्षणे ।\nबभूव रथनिर्घोषः पर्जन्यनिनदोपमःक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2044469, "chapter_id": 1996, "verse_number": "६-४५-७", "content_sanskrit": "ते मनः क्रूरमाधाय समभित्यक्तजीविताः ।\nपाण्डवानभ्यवर्तन्त सर्व एवोच्छ्रितध्वजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2044470, "chapter_id": 1996, "verse_number": "६-४५-८", "content_sanskrit": "अथ शान्तनवो राजन्नभ्यधावद्धनञ्जयम् ।\nप्रगृह्य कार्मुकं घोरं कालदण्डोपमं रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2044471, "chapter_id": 1996, "verse_number": "६-४५-९", "content_sanskrit": "अर्जुनोऽपि धनुर्गृह्य गाण्डीवं लोकविश्रुतम् ।\nअभ्यधावत तेजस्वी गाङ्गेयं रणमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2044472, "chapter_id": 1996, "verse_number": "६-४५-१०", "content_sanskrit": "तावुभौ कुरुशार्दूलौ परस्परवधैषिणौ।\nगाङ्गेयस्तु रणे पार्थं विद्ध्वा नाकम्पयद्बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2044473, "chapter_id": 1996, "verse_number": "६-४५-११", "content_sanskrit": "तथैव पाण्डवो राजन्भीष्मं नाकम्पयद्युधि।\nसात्यकिस्तु महेष्वासः कृतवर्माणमभ्यात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2044474, "chapter_id": 1996, "verse_number": "६-४५-१२", "content_sanskrit": "तयोः समभयवद्युद्धं तुमुलं रोमहर्षणम् ।\nसात्यकिः कृतवर्माणं कृतवार्मा च सात्यकिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2044475, "chapter_id": 1996, "verse_number": "६-४५-१३", "content_sanskrit": "आनर्च्छतुः शरैर्घोरैस्तक्षमाणौ परस्परम्।\nतौ शराचितसर्वाङ्गौ शुशुभाते महाबलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2044476, "chapter_id": 1996, "verse_number": "६-४५-१४", "content_sanskrit": "वसन्ते पुष्पशबलौ पुष्पिताविव किंशुकौ ।\nअभिमन्युर्महेष्वासं बृहद्बलमयोधयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2044477, "chapter_id": 1996, "verse_number": "६-४५-१५", "content_sanskrit": "ततः कोसलराजाऽसावभिमन्योर्विशांपते ।\nध्वजं चिच्छेद समरे सारथिं च व्यपातयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2044478, "chapter_id": 1996, "verse_number": "६-४५-१६", "content_sanskrit": "सौभद्रस्तु ततः क्रुद्धः पातिते रथसारथौ।\nबृहद्बलं महाराज विव्याध नवभिः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2044479, "chapter_id": 1996, "verse_number": "६-४५-१७", "content_sanskrit": "अथापराभ्यां भल्लाभ्यां शिताभ्यामरिमर्दनः ।\nध्वजमेकेन चिच्छेद पार्ष्णिमेकेन सारथिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2044480, "chapter_id": 1996, "verse_number": "६-४५-१८", "content_sanskrit": "अन्योन्यं च शरैः क्रुद्धौ ततक्षाते परस्परम् ।\nमानिनं समरे दृप्तं कृतवैरं महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2044481, "chapter_id": 1996, "verse_number": "६-४५-१९", "content_sanskrit": "भीमसेनस्तव सुतं दुर्योधनमयोधयत् ।\nतावुभौ नरशार्दूलौ कुरुमुख्यौ महाबलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2044482, "chapter_id": 1996, "verse_number": "६-४५-२०", "content_sanskrit": "अन्योन्यं शरवर्षाभ्यां ववृषाते रणाजिरे।\nतौ वीक्ष्य तु महात्मानौ कृतिनौ चित्रयोधिनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2044483, "chapter_id": 1996, "verse_number": "६-४५-२१", "content_sanskrit": "विस्मयः सर्वभूतानां समपद्यत भारत।\nदुःशासनस्तु नकुलं प्रत्युद्याय महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2044484, "chapter_id": 1996, "verse_number": "६-४५-२२", "content_sanskrit": "अविध्यन्निशितैर्बाणैर्बहुभिर्मर्मभेदिभिः ।\nतस्य माद्रीसुतः केतुं सशरं च शरासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2044485, "chapter_id": 1996, "verse_number": "६-४५-२३", "content_sanskrit": "चिच्छेद निशितैर्बाणैः प्रहसन्निव भारत ।\nअथैनं पञ्चविंशत्या क्षुद्रकाणां समार्पयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2044486, "chapter_id": 1996, "verse_number": "६-४५-२४", "content_sanskrit": "पुत्रस्तु तव दुर्धर्षो नकुलस्य महाहवे ।\nतुरङ्गांश्चिच्छिदे बाणैर्ध्वजं चैवाभ्यपातयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2044487, "chapter_id": 1996, "verse_number": "६-४५-२५", "content_sanskrit": "दुर्मुखः सहदेवं च प्रत्युद्याय महाबलम् ।\nविव्याध शरवर्षेण यतमानं महाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2044488, "chapter_id": 1996, "verse_number": "६-४५-२६", "content_sanskrit": "सहदेवस्ततो वीरो दुर्मुखस्य महारणे।\nशरेण भृतशीक्ष्णेन पातयामास सारथिम् ॥ ६-४५-२७aतावन्योन्यं समासाद्य समरे युद्धदुर्मदौ । ६-४५-२७bत्रासयेतां शरैर्घोरैः कृतप्रतिकृतैषिणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2044489, "chapter_id": 1996, "verse_number": "६-४५-२८", "content_sanskrit": "युधिष्ठिरः स्वयं राजा मद्रराजानमभ्ययात्।\nतस्य मद्राधिपश्चापं द्विधा चिच्छेद मारिष ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2044490, "chapter_id": 1996, "verse_number": "६-४५-२९", "content_sanskrit": "तदपास्य धनुश्छिन्नं कुन्तीपुत्रो युधिष्ठिरः ।\nअन्यत्कार्मुकमादाय वेगवद्बलवत्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2044491, "chapter_id": 1996, "verse_number": "६-४५-३०", "content_sanskrit": "ततो मद्रेश्वरं राजा शरैः सन्नतपर्वभिः ।\nछादयामास संक्रुद्धस्तिष्ठ तिष्ठेति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2044492, "chapter_id": 1996, "verse_number": "६-४५-३१", "content_sanskrit": "धृष्टद्युम्नस्ततो द्रोणमभ्यद्रवत भारत।\nतस्य द्रोणः सुसंक्रुद्धः परासुकरणं दृढम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2044493, "chapter_id": 1996, "verse_number": "६-४५-३२", "content_sanskrit": "त्रिधा चिच्छेद समरे पाञ्चाल्यस्य तु कार्मुकम् ।\nशरं चैव महाघोरं कालदण्डमिवापरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2044494, "chapter_id": 1996, "verse_number": "६-४५-३३", "content_sanskrit": "प्रेषयामास समरे सोऽस्य काये न्यमञ्जत।\nअथान्यद्धनुरादाय सायकांश्च चतुर्दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2044495, "chapter_id": 1996, "verse_number": "६-४५-३४", "content_sanskrit": "द्रोणं द्रुपदपुत्रस्तु प्रतिविव्याध संयुगे ।\nतावन्योन्यं सुसंक्रुद्धौ चक्रतुः शुभृशं रणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2044496, "chapter_id": 1996, "verse_number": "६-४५-३५", "content_sanskrit": "सौमदत्तिं रणे शङ्खो रभसं रभसो युधि ।\nप्रत्युद्ययौ महाराज तिष्ठतिष्ठेति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2044497, "chapter_id": 1996, "verse_number": "६-४५-३६", "content_sanskrit": "तस्य वै दक्षिणं वीरो निर्बिभेद रणे भुजम् ।\nसमदत्तिस्तथा शङ्खं जत्रुदेशे समाहनत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2044498, "chapter_id": 1996, "verse_number": "६-४५-३७", "content_sanskrit": "तयोस्तदभवद्युद्धं घोररूपं विशांपते ।\nदृप्तयोः समरे पूर्वं वृत्रवासवयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2044499, "chapter_id": 1996, "verse_number": "६-४५-३८", "content_sanskrit": "बाह्लीकं तु रणे क्रुद्ध क्रुद्धरूपो विशांपते।\nअभ्यद्रवदमेयात्मा धृष्टकेतुर्महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2044500, "chapter_id": 1996, "verse_number": "६-४५-३९", "content_sanskrit": "बाह्लीकस्तु रणे राजन्धृष्टकेतुममर्षणः ।\nशरैर्बहुभिरानर्च्छत्सिंहनादमथानदत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2044501, "chapter_id": 1996, "verse_number": "६-४५-४०", "content_sanskrit": "चेदिराजस्तु संक्रुद्धो बाह्लीकं नवभिः शरैः ।\nविव्याध समरे तूर्णं मत्तो मत्तमिव द्विपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2044502, "chapter_id": 1996, "verse_number": "६-४५-४१", "content_sanskrit": "तौ तत्र समरे क्रुद्धौ नर्दन्तौ च पुनः पुनः ।\nसमीयतुः सुसंक्रुद्धावङ्गारवबुधाविव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2044503, "chapter_id": 1996, "verse_number": "६-४५-४२", "content_sanskrit": "राक्षसं रौद्रकर्माणं क्रूरकर्मा घटोत्कचः ।\nअलम्बुसं प्रत्युदियाद्बलं शक्र इवाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2044504, "chapter_id": 1996, "verse_number": "६-४५-४३", "content_sanskrit": "घटोत्कचस्ततः क्रुद्धो राक्षसं तं महाबलम् ।\nनवत्या सायकैस्तीक्ष्णैर्दारयामास भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2044505, "chapter_id": 1996, "verse_number": "६-४५-४४", "content_sanskrit": "अलम्बुसस्तु समरे भैमसेनिं महाबलम् ।\nबहुधा दारयामास शरैः सन्नतपर्वभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2044506, "chapter_id": 1996, "verse_number": "६-४५-४५", "content_sanskrit": "व्यभ्राजेतां ततस्तौ तु संयुगे शरविक्षतौ।\nयथा देवासुरे युद्धे बलशक्रौ महाबलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2044507, "chapter_id": 1996, "verse_number": "६-४५-४६", "content_sanskrit": "शिखण्डी समरे राजन्द्रौणिमभ्युद्ययौ बली ।\nअश्वत्थामा ततः क्रुद्दः शिखण्डिनमुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2044508, "chapter_id": 1996, "verse_number": "६-४५-४७", "content_sanskrit": "नाराचेन सुतीक्ष्णेन भृशं विद्ध्वा ह्यकम्पयत् ।\nशिखण्ड्यपि ततो राजन्द्रोणपुत्रमताडयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2044509, "chapter_id": 1996, "verse_number": "६-४५-४८", "content_sanskrit": "सायकेन सुपीतेन तीक्ष्णेन निशितेन च।\nतौ जघ्नतुस्तदान्योन्यं शरैर्बहुविधैर्मृधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2044510, "chapter_id": 1996, "verse_number": "६-४५-४९", "content_sanskrit": "भगदत्तं रणे शूरं विराटो वाहिनीपतिः।\nअभ्ययात्त्वरितो राजंस्ततो युद्धमवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2044511, "chapter_id": 1996, "verse_number": "६-४५-५०", "content_sanskrit": "विराटो भगदत्तं तु शरवर्षण भारत।\nअभ्यवर्षत्सुसंक्रुद्धो मेघो वृष्ट्या इवाचलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2044512, "chapter_id": 1996, "verse_number": "६-४५-५१", "content_sanskrit": "भगदत्तस्ततस्तूर्णं विराटं पृथिवीपतिम् ।\nछादयामास समरे मेघः सूर्यमिवोदितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2044513, "chapter_id": 1996, "verse_number": "६-४५-५२", "content_sanskrit": "बृहत्क्षत्रं तु कैकेयं कृपः शारद्वतो ययौ ।\nतं कृपः शरवर्षेण च्छादयामास भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2044514, "chapter_id": 1996, "verse_number": "६-४५-५३", "content_sanskrit": "गौतमं कैकयः क्रुद्धः शरवृष्ट्याऽभ्यपूरयत् ।\nतावन्योन्यं हयान्हत्वा धनुश्छित्वा च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2044515, "chapter_id": 1996, "verse_number": "६-४५-५४", "content_sanskrit": "विरथावसियुद्धाय समीयतुरमर्षणौ ।\nतयोस्तदभवद्युद्धं घोररूपं सुदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2044516, "chapter_id": 1996, "verse_number": "६-४५-५५", "content_sanskrit": "द्रुपदस्तु ततो राजन्सैन्धवं वै जयद्रथम् ।\nअभ्युद्ययौ हृष्टरूपो हृष्टरूपं परंतपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2044517, "chapter_id": 1996, "verse_number": "६-४५-५६", "content_sanskrit": "ततः सैन्धवको राजा द्रुपदं विशिखैस्त्रिभिः ।\nताजयामास समरे स च तं प्रत्यबिध्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2044518, "chapter_id": 1996, "verse_number": "६-४५-५७", "content_sanskrit": "तयोस्तदभवद्युद्धं घोररूपं सुदारुणम् ।\nईक्षणप्रीतिजननं शुक्राङ्गरकयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2044519, "chapter_id": 1996, "verse_number": "६-४५-५८", "content_sanskrit": "विकर्णस्तु सुतस्तुभ्यं सुतसोमं महाबलम् ।\nअभ्ययाञ्जवनैरश्वैस्ततो युद्धमवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2044520, "chapter_id": 1996, "verse_number": "६-४५-५९", "content_sanskrit": "विकर्णः सुतसोमं तु विद्ध्वा नाकम्पयच्छरैः ।\nसुतसोमो विकर्णं च तदद्भुतमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2044521, "chapter_id": 1996, "verse_number": "६-४५-६०", "content_sanskrit": "सुशर्माणं नरव्याघ्रश्चेकितानो महारथः ।\nअभ्यद्रवत्सुसंक्रुद्धः पाण्डवार्थे पराक्रमी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2044522, "chapter_id": 1996, "verse_number": "६-४५-६१", "content_sanskrit": "शुशर्मा तु महाराज चेकितानं महारथम् ।\nमहता शरवर्षेण वारयामास संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2044523, "chapter_id": 1996, "verse_number": "६-४५-६२", "content_sanskrit": "चेकितानोऽपि संरब्धः सुशर्माणां महाहवे ।\nप्राच्छादयत्तमिषुभिर्महामेघ इवाचलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2044524, "chapter_id": 1996, "verse_number": "६-४५-६३", "content_sanskrit": "शकुनिः प्रतिविन्ध्यं तु पराक्रान्तं पराक्रमी ।\nअभ्यद्रवत राजेन्द्र मत्तः सिंह इव द्विपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2044525, "chapter_id": 1996, "verse_number": "६-४५-६४", "content_sanskrit": "यौधिष्ठिरस्तु संक्रुद्धः सौबलं निशितैः शरैः ।\nव्यदारयत संग्रामे मघवानिव दानवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2044526, "chapter_id": 1996, "verse_number": "६-४५-६५", "content_sanskrit": "शकुनिः प्रतिविन्ध्यं तु प्रतिविध्यन्तमाहवे।\nव्यदारयन्महाप्राज्ञः शरैः सन्नतपर्वभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2044527, "chapter_id": 1996, "verse_number": "६-४५-६६", "content_sanskrit": "सुदक्षिणं तु राजेन्द्र काम्भोजानां महारथम् ।\nश्रुतकर्मा पराक्रान्तमभ्यद्रवत संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2044528, "chapter_id": 1996, "verse_number": "६-४५-६७", "content_sanskrit": "सुदक्षिणस्तु समरे साहदेविं महारथम् ।\nविद्ध्वा नाकम्पयत वै मैनाकमिव पर्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2044529, "chapter_id": 1996, "verse_number": "६-४५-६८", "content_sanskrit": "श्रुतकर्मा ततः क्रुद्धः काम्भोजानां महारथम् ।\nशरैर्बहुभिरानर्च्छद्दारयन्निव सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2044530, "chapter_id": 1996, "verse_number": "६-४५-६९", "content_sanskrit": "इरावानथ संक्रुद्धः श्रुतायुषमरिन्दमम् ।\nप्रत्युद्ययौ रणे यत्तो यत्तरूपं परंतपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2044531, "chapter_id": 1996, "verse_number": "६-४५-७०", "content_sanskrit": "आर्जुनिस्तस्य समरे हयान्हत्वा महारथः ।\nननाद बलवान्नादं तत्सैन्यं प्रत्यपूरयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2044532, "chapter_id": 1996, "verse_number": "६-४५-७१", "content_sanskrit": "श्रुतायुस्तु ततः क्रुद्धः फाल्गुनेः समरे हयान्।\nनिजघान गदाग्रेण ततो युद्धमवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2044533, "chapter_id": 1996, "verse_number": "६-४५-७२", "content_sanskrit": "विन्दानिविन्दावावन्त्यौ कुन्तिभोजं महारथम् ।\nससेनं ससुतं वीरं संसस़ञ्जतुराहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2044534, "chapter_id": 1996, "verse_number": "६-४५-७३", "content_sanskrit": "तत्राद्भुतमपश्याम तयोर्घोरं पराक्रमम् ।\nअयुध्येतां स्थिरौ भूत्वा महत्या सेनया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2044535, "chapter_id": 1996, "verse_number": "६-४५-७४", "content_sanskrit": "अनुविन्दस्तु गदया कुन्तिभोजमताडयत्।\nकुन्तिभोजश्च तं तूर्णं शरव्रातैरवाकिरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2044536, "chapter_id": 1996, "verse_number": "६-४५-७५", "content_sanskrit": "कुन्तिभोजसुतश्चापि विन्दं विव्याध सायकैः ।\nस च तं प्रतिविव्याध तदद्भुतमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2044537, "chapter_id": 1996, "verse_number": "६-४५-७६", "content_sanskrit": "केकया भ्रातरः पञ्च गान्धारान्पञ्च मारिष ।\nससैन्यास्ते ससैन्यांश्च योधयामासुराहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2044538, "chapter_id": 1996, "verse_number": "६-४५-७७", "content_sanskrit": "वीरबाहुश्च ते पुत्रो वैराटिं रथसत्तमम् ।\nउत्तरं योधयामास विव्याध निशितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2044539, "chapter_id": 1996, "verse_number": "६-४५-७८", "content_sanskrit": "उत्तरश्चापि तं वीरं विव्याध निशितैः शरैः ।\nचेदिराट् समरे राजन्नुलूकं समभिद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2044540, "chapter_id": 1996, "verse_number": "६-४५-७९", "content_sanskrit": "तथैव शरवर्षेण उलूकं समविद्ध्यत ।\nउलूकश्चापि तं बाणैर्निशितैर्लोमवाहिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2044541, "chapter_id": 1996, "verse_number": "६-४५-८०", "content_sanskrit": "तयोर्युद्धं समभवद्धोररूपं विशांते ।\nदारयेतां सुसंक्रुद्धावन्योन्यमपराजितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2044542, "chapter_id": 1996, "verse_number": "६-४५-८१", "content_sanskrit": "एवं द्वन्द्वसहस्राणि रथवारणवाजिनाम् ।\nपदातीनां च समरे तव तेषां च संकुले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2044543, "chapter_id": 1996, "verse_number": "६-४५-८२", "content_sanskrit": "मुहूर्तमिव तद्युद्धमासीन्मधुरदर्शनम् ।\nतत उन्मत्तवद्राजन्न प्राज्ञायत किंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2044544, "chapter_id": 1996, "verse_number": "६-४५-८३", "content_sanskrit": "गजो गजेन समरे रथिनं च रथी ययौ ।\nअश्वोऽश्वं समभिप्रायात्पदातिश्च पदातिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2044545, "chapter_id": 1996, "verse_number": "६-४५-८४", "content_sanskrit": "ततो युद्धं सुदुर्धर्षं व्याकुलं समपद्यत।\nशूराणां समरे तत्र समासाद्येतरेतरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2044546, "chapter_id": 1996, "verse_number": "६-४५-८५", "content_sanskrit": "तत्र देवर्षयः सिद्धाश्चारणाश्च समागताः ।\nप्रेक्षन्त तद्रणं घोरं देवासुरसमं भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2044547, "chapter_id": 1996, "verse_number": "६-४५-८६", "content_sanskrit": "ततो दन्तिसहस्राणि र्थानां चापि मारिष।\nअश्वौघाः पुरुषौघाश्च विपरीतं समाययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2044548, "chapter_id": 1996, "verse_number": "६-४५-८७", "content_sanskrit": "तत्रतत्र प्रदृश्यन्ते रथवारणपत्तयः ।\nसादिनश्च नरव्याघ्र युध्यमाना मुहुर्मुहुः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2044549, "chapter_id": 1996, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि प्रथमदिवसयुद्धे पञ्चचत्वारिंशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}]