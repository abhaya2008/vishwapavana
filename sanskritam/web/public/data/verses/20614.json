[{"id": 7000614000, "chapter_id": 20614, "verse_number": "५-७३-१", "content_sanskrit": "ईश्वर उवाच ।\nयत्त्वया पृष्टमाश्चर्यं तन्मया भाषितं क्रमात् ।\nयत्र मुह्यंति ब्रह्माद्यास्तत्र को वा न मुह्यति॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000614001, "chapter_id": 20614, "verse_number": "५-७३-२", "content_sanskrit": "तथापि ते प्रवक्ष्यामि यदुक्तं परमर्षिणा ।\nमहाराजमंबरीषं विष्णुभक्तं शिवान्वितम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000614002, "chapter_id": 20614, "verse_number": "५-७३-३", "content_sanskrit": "बदर्याश्रममासाद्य समासीनं जितेंद्रियम् ।\nराजा प्रणम्य तुष्टाव विष्णुधर्मविवित्सया॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000614003, "chapter_id": 20614, "verse_number": "५-७३-४", "content_sanskrit": "वेदव्यासं महाभागं सर्वज्ञं पुरुषोत्तमम् ।\nमां त्वं संसारदुष्पारे परित्रातुमिहार्हसि॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000614004, "chapter_id": 20614, "verse_number": "५-७३-५", "content_sanskrit": "विषयेषु विरक्तोऽस्मि नमस्तेभ्यो नमोखिलम् ।\nयत्तत्पदमनुद्विग्नं सच्चिदानंदविग्रहम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000614005, "chapter_id": 20614, "verse_number": "५-७३-६", "content_sanskrit": "परं ब्रह्म पराकाशमनाकाशमनामयम् ।\nयत्साक्षात्कृत्य मुनयो भवांभोधिं तरंति हि॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000614006, "chapter_id": 20614, "verse_number": "५-७३-७", "content_sanskrit": "तत्राहं मनसो नित्यं कथं गतिमवाप्नुयाम् ।\nव्यास उवाच ।\nअतिगोप्यं त्वया पृष्टं यन्मया न शुकं प्रति॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000614007, "chapter_id": 20614, "verse_number": "५-७३-८", "content_sanskrit": "गदितं स्वसुतं किंतु त्वां वक्ष्यामि हरिप्रियम् ।\nआसीदिदं परं विश्वं यद्रूपं यत्प्रतिष्ठितम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000614008, "chapter_id": 20614, "verse_number": "५-७३-९", "content_sanskrit": "अव्याकृतमव्यथितं तदीश्वरमयं शृणु ।\nमया कृतं तपः पूर्वं बहुवर्षसहस्रकम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000614009, "chapter_id": 20614, "verse_number": "५-७३-१०", "content_sanskrit": "फलमूलपलाशांबु वाय्वाहारनिषेविणा ।\nततो मामाहभगवान्स्वध्याननिरतं हरिः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000614010, "chapter_id": 20614, "verse_number": "५-७३-११", "content_sanskrit": "कस्मिन्नर्थे चिकीर्षाते विवित्सा वा महामते ।\nप्रसन्नोऽस्मि वृणुष्व त्वं वरं च वरदर्षभात्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000614011, "chapter_id": 20614, "verse_number": "५-७३-१२", "content_sanskrit": "मद्दर्शनांतः संसार इति सत्यं ब्रवीमि ते ।\nततोऽहमब्रुवं कृष्णं पुलकोत्फुल्लविग्रहः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000614012, "chapter_id": 20614, "verse_number": "५-७३-१३", "content_sanskrit": "त्वामहं द्रष्टुमिच्छामि चक्षुर्भ्यां मधुसूदन ।\nयत्तत्सत्यं परं ब्रह्म जगज्ज्योतिं जगत्पतिम्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000614013, "chapter_id": 20614, "verse_number": "५-७३-१४", "content_sanskrit": "वदंति वेदशिरसश्चाक्षुषं नाथमद्भुतम् ।\nश्रीभगवानुवाच ।\nब्रह्मणैवं पुरा पृष्टः प्रार्थितश्च यथा पुरा॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000614014, "chapter_id": 20614, "verse_number": "५-७३-१५", "content_sanskrit": "यदवोचमहं तस्मै तत्तुभ्यमपि कथ्यते ।\nमामेके प्रकृतिं प्राहुः पुरुषं च तथेश्वरम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000614015, "chapter_id": 20614, "verse_number": "५-७३-१६", "content_sanskrit": "धर्ममेके धनं चैके मोक्षमेकेऽकुतोभयम् ।\nशून्यमेके भावमेके शिवमेके सदाशिवम्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000614016, "chapter_id": 20614, "verse_number": "५-७३-१७", "content_sanskrit": "अपरे वेदशिरसि स्थितमेकं सनातनम् ।\nसद्भावं विक्रियाहीनं सच्चिदानंदविग्रहम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000614017, "chapter_id": 20614, "verse_number": "५-७३-१८", "content_sanskrit": "पश्याद्य दर्शयिष्यामि स्वरूपं वेदगोपितम् ।\nततोऽपश्यं भूपबालमहं कालांबुदप्रभम्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000614018, "chapter_id": 20614, "verse_number": "५-७३-१९", "content_sanskrit": "गोपकन्यावृतं गोपं हसंतं गोपबालकैः ।\nकदंबमूलआसीनं पीतवाससमद्भुतम्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000614019, "chapter_id": 20614, "verse_number": "५-७३-२०", "content_sanskrit": "वनं वृंदावनं नाम नवपल्लवमंडितम् ।\nकोकिलभ्रमरारावं मनोभव मनोहरम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000614020, "chapter_id": 20614, "verse_number": "५-७३-२१", "content_sanskrit": "नदीमपश्यं कालिंदीमिंदीवरदलप्रभाम् ।\nगोवर्द्धनमथापश्यं कृष्णरामकरोद्धृतम्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000614021, "chapter_id": 20614, "verse_number": "५-७३-२२", "content_sanskrit": "महेंद्रदर्पनाशाय गोगोपालसुखावहम् ।\nगोपालमबलासंगमुदितं वेणुवादिनम्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000614022, "chapter_id": 20614, "verse_number": "५-७३-२३", "content_sanskrit": "दृष्ट्वातिहृष्टो ह्यभवं सर्वभूषणभूषणम् ।\nततो मामाह भगवान्वृंदावनचरः स्वयम्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000614023, "chapter_id": 20614, "verse_number": "५-७३-२४", "content_sanskrit": "यदिदं मे त्वया दृष्टं रूपं दिव्यं सनातनम् ।\nनिष्कलं निष्क्रियं शांतं सच्चिदानंदविग्रहम्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000614024, "chapter_id": 20614, "verse_number": "५-७३-२५", "content_sanskrit": "पूर्णं पद्मपलाशाक्षं नातः परतरं मम ।\nइदमेववदंत्येतेवेदाःकारणकारणम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000614025, "chapter_id": 20614, "verse_number": "५-७३-२६", "content_sanskrit": "सत्यंनित्यंपरानंदंचिद्घनंशाश्वतंशिवम् ।\nनित्यां मे मथुरां विद्धि वनं वृंदावनं तथा॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000614026, "chapter_id": 20614, "verse_number": "५-७३-२७", "content_sanskrit": "यमुनां गोपकन्याश्च तथा गोपालबालकाः ।\nममावतारो नित्योऽयमत्र मा संशयं कृथाः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000614027, "chapter_id": 20614, "verse_number": "५-७३-२८", "content_sanskrit": "ममेष्टा हि सदा राधा सर्वज्ञोऽहं परात्परः ।\nसर्वकामश्च सर्वेशः सर्वानंदः परात्परः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000614028, "chapter_id": 20614, "verse_number": "५-७३-२९", "content_sanskrit": "मयि सर्वमिदं विश्वं भाति मायाविजृंभितम् ।\nततोऽहमब्रुवं देवं जगत्कारणकारणम्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000614029, "chapter_id": 20614, "verse_number": "५-७३-३०", "content_sanskrit": "काश्च गोप्यस्तु के गोपा वृक्षोऽयं कीदृशो मतः ।\nवनं किं कोकिलाद्याश्च नदी केयं गिरिश्च कः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000614030, "chapter_id": 20614, "verse_number": "५-७३-३१", "content_sanskrit": "कोऽसौ वेणुर्महाभागो लोकानंदैकभाजनम् ।\nभगवानाह मां प्रीतः प्रसन्नवदनांबुजः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000614031, "chapter_id": 20614, "verse_number": "५-७३-३२", "content_sanskrit": "गोप्यस्तु श्रुतयो ज्ञेया ऋचो वै गोपकन्यकाः ।\nदेवकन्याश्च राजेंद्र तपोयुक्ता मुमुक्षवः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000614032, "chapter_id": 20614, "verse_number": "५-७३-३३", "content_sanskrit": "गोपाला मुनयः सर्वे वैकुंठानंदमूर्त्तयः ।\nकल्पवृक्षः कदंबोऽयं परानंदैकभाजनम्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000614033, "chapter_id": 20614, "verse_number": "५-७३-३४", "content_sanskrit": "वनमानंदकाख्यं हि महापातकनाशनम् ।\nसिद्धाश्च साध्या गंधर्वाः कोकिलाद्या न संशयः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000614034, "chapter_id": 20614, "verse_number": "५-७३-३५", "content_sanskrit": "केचिदानंदहृदयं साक्षाद्यमुनया तनुम् ।\nअनादिर्हरिदासोऽयं भूधरो नात्र संशयः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000614035, "chapter_id": 20614, "verse_number": "५-७३-३६", "content_sanskrit": "वेणुर्यः शृणुतं विप्रं तवापि विदितं तथा ।\nद्विज आसीच्छांतमनास्तपः शांतिपरायणः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000614036, "chapter_id": 20614, "verse_number": "५-७३-३७", "content_sanskrit": "नाम्ना देवव्रतोदांतः कर्मकांडविशारदः ।\nस वैष्णवजनव्रातमध्यवर्त्ती क्रियापरः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000614037, "chapter_id": 20614, "verse_number": "५-७३-३८", "content_sanskrit": "स कदाचन शुश्राव यज्ञेशोऽस्तीति भूपते ।\nतस्य गेहमथाभ्यागाद्द्विजो मद्गतनिश्चयः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000614038, "chapter_id": 20614, "verse_number": "५-७३-३९", "content_sanskrit": "स मद्भक्तः क्वचित्पूजां तुलसीदलवारिणा ।\nकृतवांस्तद्गृहे किंचित्फलं मूलं न्यवेदयत्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000614039, "chapter_id": 20614, "verse_number": "५-७३-४०", "content_sanskrit": "स्नानवारिफलं किंचित्तस्मै मत्या ददौ सुधीः ।\nअश्रद्धया स्मितं कृत्वा सोऽप्यगृह्णाद्द्विजन्मनः॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000614040, "chapter_id": 20614, "verse_number": "५-७३-४१", "content_sanskrit": "तेन पापेन संजातं वेणुत्वमतिदारुणम् ।\nतेन पुण्येन तस्याथ मदीय प्रियतां गतः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000614041, "chapter_id": 20614, "verse_number": "५-७३-४२", "content_sanskrit": "अमुना सोपि राजेंद्र केतुमानिव राजते ।\nयुगांते तद्विष्णुपरो भूत्वा ब्रह्म समाप्स्यति॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000614042, "chapter_id": 20614, "verse_number": "५-७३-४३", "content_sanskrit": "अहो न जानंति नरा दुराशयाः पुरीं मदीयां परमां सनातनीम् ।\nसुरेंद्र नागेंद्र मुनींद्र संस्तुतां मनोरमां तां मथुरां पुरातनीम्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000614043, "chapter_id": 20614, "verse_number": "५-७३-४४", "content_sanskrit": "काश्यादयो यद्यपि संति पुर्यस्तासां तु मध्ये मथुरैव धन्या ।\nयज्जन्ममौंजीव्रतमृत्युदाहैर्नृणां चतुर्द्धा विदधाति मुक्तिम्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000614044, "chapter_id": 20614, "verse_number": "५-७३-४५", "content_sanskrit": "यदा विशुद्धास्तपआदिना जनाः शुभाशया ध्यानधना निरंतरम् ।\nतदैव पश्यंति ममोत्तमां पुरीं न चान्यथा कल्पशतैर्द्विजोत्तमाः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000614045, "chapter_id": 20614, "verse_number": "५-७३-४६", "content_sanskrit": "मथुरावासिनो धन्या मान्या अपि दिवौकसाम् ।\nअगण्यमहिमानस्ते सर्व एव चतुर्भुजाः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000614046, "chapter_id": 20614, "verse_number": "५-७३-४७", "content_sanskrit": "मथुरावासिनो ये तु दोषान्पश्यंति मानवाः ।\nतेषु दोषं न पश्यंति जन्ममृत्युसहस्रजम्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000614047, "chapter_id": 20614, "verse_number": "५-७३-४८", "content_sanskrit": "अधना अपि ते धन्या मथुरां ये स्मरंति ते ।\nयत्र भूतेश्वरो देवो मोक्षदः पापिनामपि॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000614048, "chapter_id": 20614, "verse_number": "५-७३-४९", "content_sanskrit": "मम प्रियतमो नित्यं देवो भूतेश्वरः परः ।\nयः कदापि मम प्रीत्यै न संत्यजति तां पुरीम्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000614049, "chapter_id": 20614, "verse_number": "५-७३-५०", "content_sanskrit": "भूतेश्वरं यो न नमेन्न पूजयेन्न वास्मरेद्दुश्चरितो मनुष्यः ।\nनैनां स पश्येन्मथुरां मदीयां स्वयंप्रकाशां परदेवताख्याम्॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000614050, "chapter_id": 20614, "verse_number": "५-७३-५१", "content_sanskrit": "न कथं मयि भक्तिं स लभते पापपूरुषः ।\nयो मदीयं परं भक्तं शिवं संपूजयेन्नहि॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000614051, "chapter_id": 20614, "verse_number": "५-७३-५२", "content_sanskrit": "मन्मायामोहितधियः प्रायस्ते मानवाधमाः ।\nभूतेश्वरं न नमंति न स्मरंति स्तुवंति ये॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000614052, "chapter_id": 20614, "verse_number": "५-७३-५३", "content_sanskrit": "बालकोऽपि ध्रुवो यत्र ममाराधनतत्परः ।\nप्राप स्थानं परं शुद्धं यत्नयुक्तं पितामहैः॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000614053, "chapter_id": 20614, "verse_number": "५-७३-५४", "content_sanskrit": "तां पुरीं प्राप्य मथुरां मदीयां सुरदुर्लभाम् ।\nखंजो भूत्वांधको वापि प्राणानेव परित्यजेत्॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000614054, "chapter_id": 20614, "verse_number": "५-७३-५५", "content_sanskrit": "वेदव्यासमहाभाग मा कृथाः संशयं क्वचित् ।\nरहस्यं वेदशिरसां यन्मया ते प्रकाशितम्॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000614055, "chapter_id": 20614, "verse_number": "५-७३-५६", "content_sanskrit": "इमं भगवता प्रोक्तमध्यायं यः पठेच्छुचिः ।\nशृणुयाद्वापि यो भक्त्या मुक्तिस्तस्यापि शाश्वती॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]