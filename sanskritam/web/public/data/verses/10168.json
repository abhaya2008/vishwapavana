[{"id": 6000168000, "chapter_id": 10168, "verse_number": null, "content_sanskrit": "अथ पञ्चदशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000168001, "chapter_id": 10168, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.001.m4a", "display_order": 2}, {"id": 6000168002, "chapter_id": 10168, "verse_number": "८-१५-१", "content_sanskrit": "एवं पुत्रेषु नष्टेषु देवमाताऽदितिस्तदा।\nहृते त्रिविष्टपे दैत्यैः पर्यतप्यदनाथवत्॥ ८/१५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.002.m4a", "display_order": 3, "topics": [{"text": "पुत्राणां त्रिविष्टपनाशेन शोचन्त्या अदित्या प्रार्थितेन कश्यपेन हरितोषणार्थं तस्यै पयोव्रतोपदेशः", "range": "१–६२"}]}, {"id": 6000168003, "chapter_id": 10168, "verse_number": "८-१५-२", "content_sanskrit": "एकदा कश्यपस्तस्या आश्रमं भगवानगात्।\nनिरुत्सवं निरानन्दं समाधेर्विरतश्चिरात्॥ ८/१५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.003.m4a", "display_order": 4}, {"id": 6000168004, "chapter_id": 10168, "verse_number": "८-१५-३", "content_sanskrit": "स पत्नीं दीनवदनां कृतासनपरिग्रहः।\nसभाजितो यथान्यायम् इदमाह कुरूद्वह॥ ८/१५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.004.m4a", "display_order": 5}, {"id": 6000168005, "chapter_id": 10168, "verse_number": "८-१५-४", "content_sanskrit": "अप्यभद्रं न विप्राणां भद्रे लोकेऽधुनाऽऽगतम्।\nन धर्मस्य न लोकस्य मृत्योश्छन्दानुवर्तिनः॥ ८/१५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.005.m4a", "display_order": 6}, {"id": 6000168006, "chapter_id": 10168, "verse_number": "८-१५-५", "content_sanskrit": "अपि वाऽकुशलं किं वा गृहेषु गृहमेधिनि।\nधर्मस्यार्थस्य कामस्य यत्र योगो ह्ययोगिनाम्॥ ८/१५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.006.m4a", "display_order": 7}, {"id": 6000168007, "chapter_id": 10168, "verse_number": "८-१५-६", "content_sanskrit": "अपि वाऽतिथयोऽभ्येत्य कुटुम्बासक्तया त्वया।\nगृहादपूजिता याताः प्रत्युत्थानेन वा क्‍वचित्॥ ८/१५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.007.m4a", "display_order": 8}, {"id": 6000168008, "chapter_id": 10168, "verse_number": "८-१५-७", "content_sanskrit": "गृहेषु येष्वतिथयो नार्चिताः सलिलैरपि।\nयदि निर्यान्ति ते नूनं प्रेतराजगृहोपमाः॥ ८/१५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.008.m4a", "display_order": 9}, {"id": 6000168009, "chapter_id": 10168, "verse_number": "८-१५-८", "content_sanskrit": "अप्यग्नयस्तु वेलायां न हुता हविषा सति।\nत्वयोद्विग्नधिया भद्रे प्रोषिते मयि कर्हिचित्॥ ८/१५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.009.m4a", "display_order": 10}, {"id": 6000168010, "chapter_id": 10168, "verse_number": "८-१५-९", "content_sanskrit": "यत्पूजया कामदुघान् यान्ति लोकान् गृहान्विताः।\nब्राह्मणोऽग्निश्च वै विष्णोः सर्वदेवात्मनो मुखम्॥ ८/१५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.010.m4a", "display_order": 11}, {"id": 6000168011, "chapter_id": 10168, "verse_number": "८-१५-१०", "content_sanskrit": "अपि सर्वे कुशलिनस्तव पुत्रा मनस्विनि।\nलक्षयेऽस्वस्थमात्मानं भवत्या लक्षणैरहम्॥ ८/१५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.011.m4a", "display_order": 12}, {"id": 6000168012, "chapter_id": 10168, "verse_number": null, "content_sanskrit": "अदितिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.012.m4a", "display_order": 13}, {"id": 6000168013, "chapter_id": 10168, "verse_number": "८-१५-११", "content_sanskrit": "भद्रं द्विजगवां ब्रह्मन् धर्मस्यास्य जनस्य च।\nत्रिवर्गस्य परं क्षेत्रं गृहमेधिन् गृहा इमे॥ ८/१५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.013.m4a", "display_order": 14}, {"id": 6000168014, "chapter_id": 10168, "verse_number": "८-१५-१२", "content_sanskrit": "अग्नयोऽतिथयो भृत्या भिक्षवो ये च लिप्सवः।\nसर्वं भगवतो ब्रह्मन्ननुध्यानान्न रिष्यति॥ ८/१५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.014.m4a", "display_order": 15}, {"id": 6000168015, "chapter_id": 10168, "verse_number": "८-१५-१३", "content_sanskrit": "को नु मे भगवन् कामो न सम्पद्येत मानसः।\nयस्या भवान् प्रजाध्यक्ष एवं धर्मान् प्रभाषते॥ ८/१५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.015.m4a", "display_order": 16}, {"id": 6000168016, "chapter_id": 10168, "verse_number": "८-१५-१४", "content_sanskrit": "तवैव मारीच मनःशरीरजाः प्रजा इमाः सत्त्वरजस्तमोजुषः।\nमनोरथं तासु सुरादिषु प्रभो यथाविभागं भजते महेश्वरः॥ ८/१५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.016.m4a", "display_order": 17}, {"id": 6000168017, "chapter_id": 10168, "verse_number": "८-१५-१५", "content_sanskrit": "तस्मादंशं भजन्त्या मे श्रेयश्चिन्तय सुव्रत।\nहृतश्रियो हृतस्थानाः सपत्नैः पाहि नः प्रभो॥ ८/१५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.017.m4a", "display_order": 18}, {"id": 6000168018, "chapter_id": 10168, "verse_number": "८-१५-१६", "content_sanskrit": "परैर्विवासिता साऽहं मग्ना व्यसनसागरे।\nऐश्वर्यं श्रीर्यशः स्थानं हृतानि प्रबलैर्मम॥ ८/१५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.018.m4a", "display_order": 19}, {"id": 6000168019, "chapter_id": 10168, "verse_number": "८-१५-१७", "content_sanskrit": "यथा तानि पुनः साधो प्रपद्येरन् ममात्मजाः।\nतथा विधेहि कल्याणं धिया कल्याणकृत्तम॥ ८/१५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.019.m4a", "display_order": 20}, {"id": 6000168020, "chapter_id": 10168, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.020.m4a", "display_order": 21}, {"id": 6000168021, "chapter_id": 10168, "verse_number": "८-१५-१८", "content_sanskrit": "एवमभ्यर्थितोऽदित्या कस्तामाह स्मयन्निव।\nअहो मायाबलं विष्णोः स्नेहबद्धमिदं जगत्॥ ८/१५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.021.m4a", "display_order": 22}, {"id": 6000168022, "chapter_id": 10168, "verse_number": "८-१५-१९", "content_sanskrit": "क्‍व देहो भौतिकोऽनात्मा क्‍व चाऽत्मा प्रकृतेः परः।\nकस्य के पतिपुत्राद्या मोह एव हि कारणम्॥ ८/१५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.022.m4a", "display_order": 23}, {"id": 6000168023, "chapter_id": 10168, "verse_number": "८-१५-२०", "content_sanskrit": "उपतिष्ठस्व पुरुषं भगवन्तं जनार्दनम्।\nसर्वभूतगुहावासं वासुदेवं जगद्गुरुम्॥ ८/१५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.023.m4a", "display_order": 24}, {"id": 6000168024, "chapter_id": 10168, "verse_number": "८-१५-२१", "content_sanskrit": "स विधास्यति ते कामान् हरिर्दीनानुकम्पनः।\nअमोघा भगवद्भक्तिर्नेतरेति मतिर्मम॥ ८/१५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.024.m4a", "display_order": 25}, {"id": 6000168025, "chapter_id": 10168, "verse_number": null, "content_sanskrit": "अदितिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.025.m4a", "display_order": 26}, {"id": 6000168026, "chapter_id": 10168, "verse_number": "८-१५-२२", "content_sanskrit": "केनाहं विधिना ब्रह्मन्नुपस्थास्ये जगत्पतिम्।\nयथा मे सत्यसङ्कल्पो विदध्यात्स मनोरथम्॥ ८/१५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.026.m4a", "display_order": 27}, {"id": 6000168027, "chapter_id": 10168, "verse_number": "८-१५-२३", "content_sanskrit": "आदिश त्वं द्विजश्रेष्ठ विधिं तदुपधावनम्।\nआशु तुष्यति मे देवः सीदन्त्याः सह पुत्रकैः॥ ८/१५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.027.m4a", "display_order": 28}, {"id": 6000168028, "chapter_id": 10168, "verse_number": null, "content_sanskrit": "कश्यप उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.028.m4a", "display_order": 29}, {"id": 6000168029, "chapter_id": 10168, "verse_number": "८-१५-२४", "content_sanskrit": "एतन्मे भगवान् पृष्टः प्रजाकामस्य पद्मजः।\nयदाह ते प्रवक्ष्यामि व्रतं केशवतोषणम्॥ ८/१५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.029.m4a", "display_order": 30}, {"id": 6000168030, "chapter_id": 10168, "verse_number": "८-१५-२५", "content_sanskrit": "फाल्गुनस्यामले पक्षे द्वादशाहं पयोव्रतः।\nअर्चयेदरविन्दाक्षं भक्त्या परमयाऽन्वितः॥ ८/१५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.030.m4a", "display_order": 31}, {"id": 6000168031, "chapter_id": 10168, "verse_number": "८-१५-२६", "content_sanskrit": "सिनीवाल्यां मृदालिप्य स्नायात् क्रोडविदीर्णया।\nयदि लभ्येत वै स्रोतस्येतं मन्त्रमुदीरयेत्॥ ८/१५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.031.m4a", "display_order": 32}, {"id": 6000168032, "chapter_id": 10168, "verse_number": "८-१५-२७", "content_sanskrit": "त्वं देव्यादिवराहेण रसायाः स्थानमिच्छता।\nउद्धृताऽसि नमस्तुभ्यं पाप्मानं मे प्रणाशय॥ ८/१५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.032.m4a", "display_order": 33}, {"id": 6000168033, "chapter_id": 10168, "verse_number": "८-१५-२८", "content_sanskrit": "निर्वर्तितात्मनियमो देवमर्चेत् समाहितः।\nअर्चायां स्थण्डिले सूर्ये जले वह्नौ गुरावपि॥ ८/१५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.033.m4a", "display_order": 34}, {"id": 6000168034, "chapter_id": 10168, "verse_number": "८-१५-२९", "content_sanskrit": "नमस्तुभ्यं भगवते पुरुषाय महीयसे।\nसर्वभूतनिवासाय वासुदेवाय साक्षिणे॥ ८/१५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.034.m4a", "display_order": 35}, {"id": 6000168035, "chapter_id": 10168, "verse_number": "८-१५-३०", "content_sanskrit": "नमोऽव्यक्ताय सूक्ष्माय प्रधानपुरुषाय च।\nचतुर्विंशद्गुणज्ञाय गुणसंख्यानहेतवे॥ ८/१५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.035.m4a", "display_order": 36}, {"id": 6000168036, "chapter_id": 10168, "verse_number": "८-१५-३१", "content_sanskrit": "नमो द्विशीर्षे त्रिपदे चतुःशृङ्गाय तन्तवे।\nसप्तहस्ताय यज्ञाय त्रयीविद्याऽऽत्मने नमः॥ ८/१५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.036.m4a", "display_order": 37}, {"id": 6000168037, "chapter_id": 10168, "verse_number": "८-१५-३२", "content_sanskrit": "नमः शिवाय रुद्राय नमः शक्तिधराय च।\nसर्वविद्याधिपतये भूतानां पतये नमः॥ ८/१५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.037.m4a", "display_order": 38}, {"id": 6000168038, "chapter_id": 10168, "verse_number": "८-१५-३३", "content_sanskrit": "नमो हिरण्यगर्भाय प्राणाय जगदात्मने।\nयोगैश्वर्यशरीराय नमस्ते योगहेतवे॥ ८/१५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.038.m4a", "display_order": 39}, {"id": 6000168039, "chapter_id": 10168, "verse_number": "८-१५-३४", "content_sanskrit": "नमस्त आदिदेवाय देवदेवाय ते नमः।\nनारायणाय ऋषये नराय हरये नमः॥ ८/१५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.039.m4a", "display_order": 40}, {"id": 6000168040, "chapter_id": 10168, "verse_number": "८-१५-३५", "content_sanskrit": "नमो मरकतश्यामवपुषेऽधिगतश्रिये।\nकेशवाय नमस्तुभ्यं नमस्ते पीतवाससे॥ ८/१५/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.040.m4a", "display_order": 41}, {"id": 6000168041, "chapter_id": 10168, "verse_number": "८-१५-३६", "content_sanskrit": "त्वं सर्ववरदः पुंसां वरेण्य वरदर्षभ।\nअतस्ते तपसा धीराः पादरेणुमुपासते॥ ८/१५/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.041.m4a", "display_order": 42}, {"id": 6000168042, "chapter_id": 10168, "verse_number": "८-१५-३७", "content_sanskrit": "अन्ववर्तन्त यं देवाः श्रीविनिर्जितपद्मयोः।\nस्पृहयन्त इवामोदं भगवान् मे प्रसीदताम्॥ ८/१५/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.042.m4a", "display_order": 43}, {"id": 6000168043, "chapter_id": 10168, "verse_number": "८-१५-३८", "content_sanskrit": "एतैर्मन्त्रैर्हृषीकेशमावाहनपुरस्सरम्।\nअर्चयेच्छ्रद्धया युक्तः पाद्योपस्पर्शनादिभिः॥ ८/१५/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.043.m4a", "display_order": 44}, {"id": 6000168044, "chapter_id": 10168, "verse_number": "८-१५-३९", "content_sanskrit": "अर्चितं गन्धमाल्याद्यैः पयसा स्नापयेद् विभुम्।\nवस्‍त्रोपवीताभरणपाद्योपस्पर्शनैस्ततः॥ ८/१५/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.044.m4a", "display_order": 45}, {"id": 6000168045, "chapter_id": 10168, "verse_number": "८-१५-४०", "content_sanskrit": "गन्धधूपादिभिश्चार्चेत् द्वादशाक्षरविद्यया।\nशृतं पयसि नैवेद्यं शाल्यन्नं विभवे सति॥ ८/१५/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.045.m4a", "display_order": 46}, {"id": 6000168046, "chapter_id": 10168, "verse_number": "८-१५-४१", "content_sanskrit": "ससर्पिः सगुडं दत्त्वा जुहुयान्मूलविद्यया।\nनिवेदितं तद्भक्ताय दद्याद् भुञ्जीत वा स्वयम्॥ ८/१५/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.046.m4a", "display_order": 47}, {"id": 6000168047, "chapter_id": 10168, "verse_number": "८-१५-४२", "content_sanskrit": "दत्त्वाऽचमनमर्चित्वा ताम्बूलं च निवेदयेत्।\nजपेदष्टोत्तरशतं स्तुवीत स्तुतिभिः प्रभुम्॥ ८/१५/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.047.m4a", "display_order": 48}, {"id": 6000168048, "chapter_id": 10168, "verse_number": "८-१५-४३", "content_sanskrit": "कृत्वा प्रदक्षिणं भूमौ प्रणमेद् दण्डवन्मुदा।\nकृत्वा शिरसि तच्छेषं देवमुद्वासयेत् ततः॥ ८/१५/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.048.m4a", "display_order": 49}, {"id": 6000168049, "chapter_id": 10168, "verse_number": "८-१५-४४", "content_sanskrit": "द्व्यवरान् भोजयेद् विप्रान् पायसेन यथोचितम्।\nभुञ्जीत तैरनुज्ञातो हुतशेषं सभाजितैः॥ ८/१५/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.049.m4a", "display_order": 50}, {"id": 6000168050, "chapter_id": 10168, "verse_number": "८-१५-४५", "content_sanskrit": "ब्रह्मचार्यथ तद्रात्र्यां श्वो भूते प्रथमेऽहनि।\nप्रातः शुचिर्यथोक्तेन विधिना सुसमाहितः॥ ८/१५/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.050.m4a", "display_order": 51}, {"id": 6000168051, "chapter_id": 10168, "verse_number": "८-१५-४६", "content_sanskrit": "पयसा स्नापयित्वाऽर्चेद् यावद् व्रतसमापनम्।\nपयोभक्षो व्रतमिदं चरेद् विष्ण्वर्चनादृतः॥ ८/१५/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.051.m4a", "display_order": 52}, {"id": 6000168052, "chapter_id": 10168, "verse_number": "८-१५-४७", "content_sanskrit": "पूर्ववज्जुहुयादग्निं ब्राह्मणांश्चापि भोजयेत्।\nएवं त्वहरहः कुर्याद् द्वादशाहं पयोव्रतम्॥ ८/१५/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.052.m4a", "display_order": 53}, {"id": 6000168053, "chapter_id": 10168, "verse_number": "८-१५-४८", "content_sanskrit": "हरेराराधनं होममर्हणं द्विजतर्पणम्।\nप्रतिपद्दिनमारभ्य यावच्छुक्लत्रयोदशी॥ ८/१५/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.053.m4a", "display_order": 54}, {"id": 6000168054, "chapter_id": 10168, "verse_number": "८-१५-४९", "content_sanskrit": "ब्रह्मचर्यमधःस्वापं स्नानं त्रिषवणं चरेत्।\nवर्जयेदसदालापं भोगानुच्चावचांस्तथा॥ ८/१५/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.054.m4a", "display_order": 55}, {"id": 6000168055, "chapter_id": 10168, "verse_number": "८-१५-५०", "content_sanskrit": "अहिंस्रः सर्वभूतानां वासुदेवपरायणः।\nत्रयोदश्यामथो विष्णोः स्नापनं स्नापकैर्विभोः॥ ८/१५/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.055.m4a", "display_order": 56}, {"id": 6000168056, "chapter_id": 10168, "verse_number": "८-१५-५१", "content_sanskrit": "कारयेच्छास्‍त्रदृष्टेन विधिना विधिकोविदैः।\nपूजां च महतीं कुर्याद् वित्तशाठ्यविवर्जितः॥ ८/१५/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.056.m4a", "display_order": 57}, {"id": 6000168057, "chapter_id": 10168, "verse_number": "८-१५-५२", "content_sanskrit": "चरुं निरूप्य पयसि शिपिविष्टाय विष्णवे।\nशृतेन तेन पुरुषं यजेत सुसमाहितः॥ ८/१५/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.057.m4a", "display_order": 58}, {"id": 6000168058, "chapter_id": 10168, "verse_number": "८-१५-५३", "content_sanskrit": "नैवेद्यं चापि गुणवद् दद्यात् पुरुषतुष्टिदम्।\nआचार्यं ज्ञानसम्पन्नं वस्‍त्राभरणधेनुभिः॥ ८/१५/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.058.m4a", "display_order": 59}, {"id": 6000168059, "chapter_id": 10168, "verse_number": "८-१५-५४", "content_sanskrit": "तोषयेद् ऋत्विजश्चैव तद् विद्ध्याराधनं हरेः।\nभोजयेत् तान् गुणवता सदन्नेन शुचिस्मिते॥ ८/१५/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.059.m4a", "display_order": 60}, {"id": 6000168060, "chapter_id": 10168, "verse_number": "८-१५-५५", "content_sanskrit": "अन्यांश्च ब्राह्मणान् शक्त्या ये च तत्र समागताः।\nदक्षिणां गुरवे दद्याद् ऋत्विग्भ्यश्च यथार्हतः॥ ८/१५/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.060.m4a", "display_order": 61}, {"id": 6000168061, "chapter_id": 10168, "verse_number": "८-१५-५६", "content_sanskrit": "अन्नाद्येनाश्वपाकांश्च प्रीणयेत् समुपागतान्।\nभुक्तवत्सु च विप्रेषु दीनान्धकृपणादिषु॥ ८/१५/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.061.m4a", "display_order": 62}, {"id": 6000168062, "chapter_id": 10168, "verse_number": "८-१५-५७", "content_sanskrit": "विष्णोस्तत्प्रीणनं विद्वान् सह भुञ्जीत बन्धुभिः।\nनृत्यवादित्रगीतैश्च स्तुतिभिः स्वस्तिवाचकैः॥ ८/१५/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.062.m4a", "display_order": 63}, {"id": 6000168063, "chapter_id": 10168, "verse_number": "८-१५-५८", "content_sanskrit": "कारयेत् तत्कथाभिश्च पूजां भगवतोऽन्वहम्।\nएतत् पयोव्रतं नाम पुरुषाराधनं परम्॥ ८/१५/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.063.m4a", "display_order": 64}, {"id": 6000168064, "chapter_id": 10168, "verse_number": "८-१५-५९", "content_sanskrit": "पितामहेनाभिहितं मम ते समुदाहृतम्।\nत्वं चानेन महाभागे सम्यक् चीर्णेन केशवम्॥ ८/१५/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.064.m4a", "display_order": 65}, {"id": 6000168065, "chapter_id": 10168, "verse_number": "८-१५-६०", "content_sanskrit": "आत्मना शुद्धभावेन भजनीयं भजाव्ययम्।\nअयं वै सर्वयज्ञाख्यः सर्वव्रतमिदं श्रुतम्॥ ८/१५/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.065.m4a", "display_order": 66}, {"id": 6000168066, "chapter_id": 10168, "verse_number": "८-१५-६१", "content_sanskrit": "तपःसारमिदं भद्रे दानं चेश्वरतर्पणम्। त एव नियमाः साक्षात् त एव च यमोत्तमाः।\nतपो दानं व्रतं यज्ञो येन तुष्यत्यधोक्षजः॥ ८/१५/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.066.m4a", "display_order": 67}, {"id": 6000168067, "chapter_id": 10168, "verse_number": "८-१५-६२", "content_sanskrit": "तस्मादेवं व्रतं भद्रे प्रयता श्रद्धया चर।\nभगवान् परितुष्टस्ते वरानाशु विधास्यति॥ ८/१५/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_015/BhP_08.015.067.m4a", "display_order": 68}, {"id": 6000168068, "chapter_id": 10168, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायाम् अष्टमस्कन्धे पञ्चदशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]