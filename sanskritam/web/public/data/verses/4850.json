[{"id": 2181658, "chapter_id": 4850, "verse_number": "", "content_sanskrit": "विस्तरेण वर्णाश्रमधर्मकथनम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2181659, "chapter_id": 4850, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2181660, "chapter_id": 4850, "verse_number": "१", "content_sanskrit": "श्रुता मे कथिताः पूर्वैश्चत्वारो मानवाश्रमाः ।\nव्याख्यानमेषामाचक्ष्व पृच्छतो मे पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2181661, "chapter_id": 4850, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2181662, "chapter_id": 4850, "verse_number": "२", "content_sanskrit": "विदिताः सर्व एवेह धर्मास्तव युधिष्ठिर ।\nयथा मम महाबाहो विदिताः साधुसम्मताः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2181663, "chapter_id": 4850, "verse_number": "३", "content_sanskrit": "यत्तु लिङ्गान्तरगतं पृच्छसे मां युधिष्ठिर ।\nधर्मं धर्मभृतां श्रेष्ठ तन्निबोध नराधिप\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2181664, "chapter_id": 4850, "verse_number": "४", "content_sanskrit": "सर्वाण्येतानि कौन्तेय विद्यन्ते मनुजर्षभ ।\nसाध्वाचारप्रवृत्तानां चातुराश्रम्यकर्मणाम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2181665, "chapter_id": 4850, "verse_number": "५", "content_sanskrit": "अकामद्वेषयुक्तस्य दण्डनीत्या युधिष्ठिर ।\nसमेक्षिणश्च भूतेषु भैक्षाश्रमपदं भवेत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2181666, "chapter_id": 4850, "verse_number": "६", "content_sanskrit": "वेत्त्यादानविसर्गं यो निग्रहानुग्रहौ तथा ।\nयथोक्तवृत्तेर्वीरस्य क्षेमाश्रमपदं भवेत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2181667, "chapter_id": 4850, "verse_number": "७", "content_sanskrit": "अर्हान् पूजयतो नित्यं संविभागेन पाण्डव ।\nसर्वतस्तस्य कौन्तेय भैक्ष्याश्रमपदं भवेत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2181668, "chapter_id": 4850, "verse_number": "८", "content_sanskrit": "ज्ञातिसम्बन्धिमित्राणि व्यापन्नानि युधिष्ठिर ।\nसमभ्युद्धरमाणस्य दीक्षाश्रमपदं भवेत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2181669, "chapter_id": 4850, "verse_number": "९", "content_sanskrit": "लोकमुख्येषु सत्कारं लिङ्गमुख्येषु चानघ ।\nकुर्वतस्तस्य कौन्तेय वन्याश्रमपदं भवेत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2181670, "chapter_id": 4850, "verse_number": "१०", "content_sanskrit": "आह्निकं भूतयज्ञांश्च पितृयज्ञांश्च मानुषान् ।\nकुर्वतः पार्थ विपुलान् सत्याश्रमपदं भवेत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2181671, "chapter_id": 4850, "verse_number": "११", "content_sanskrit": "संविभागेन भूतानामतिथीनां तथार्चनात् ।\nदेवयज्ञैश्च राजेन्द्र वन्याश्रमपदं भवेत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2181672, "chapter_id": 4850, "verse_number": "१२", "content_sanskrit": "मर्दनं परराष्ट्राणां शिष्टार्थं सत्यविक्रम ।\nकुर्वतः पुरुषव्याघ्र वन्याश्रमपदं भवेत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2181673, "chapter_id": 4850, "verse_number": "१३", "content_sanskrit": "पालनात् सर्वभूतानां स्वराष्ट्रपरिपालनात् ।\nदीक्षा बहुविधा राज्ञो वन्याश्रमपदं भवेत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2181674, "chapter_id": 4850, "verse_number": "१४", "content_sanskrit": "वेदाध्ययननित्यत्वं क्षमाथाचार्यपूजनम् ।\nतथोपाध्यायशुश्रूषा ब्रह्माश्रमपदं भवेत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2181675, "chapter_id": 4850, "verse_number": "१५", "content_sanskrit": "आह्निकं जपमानस्य देवान् पूजयतः सदा ।\nधर्मेण पुरुषव्याघ्र धर्माश्रमपदं भवेत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2181676, "chapter_id": 4850, "verse_number": "१६", "content_sanskrit": "मृत्युर्वा रक्षणं वेत्ति यस्य राज्ञो विनिश्चयः ।\nप्राणद्यूते ततस्तस्य ब्रह्माश्रमपदं भवेत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2181677, "chapter_id": 4850, "verse_number": "१७", "content_sanskrit": "अजिह्ममशठं मार्गं सेवमानस्य भारत ।\nसर्वदा सर्वभूतेषु ब्रह्माश्रमपदं भवेत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2181678, "chapter_id": 4850, "verse_number": "१८", "content_sanskrit": "वानप्रस्थेषु विप्रेषु त्रैविद्येषु च भारत ।\nप्रयच्छतोऽर्थान् विपुलान् वन्याश्रमपदं भवेत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2181679, "chapter_id": 4850, "verse_number": "१९", "content_sanskrit": "सर्वभूतेष्वनुक्रोशं कुर्वतस्तस्य भारत ।\nआनृशंस्यप्रवृत्तस्य सर्वावस्थं पदं भवेत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2181680, "chapter_id": 4850, "verse_number": "२०", "content_sanskrit": "बालवृद्धेषु कौरव्य सर्वावस्थं युधिष्ठिर ।\nअनुक्रोशं विदधतः सर्वावस्थं पदं भवेत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2181681, "chapter_id": 4850, "verse_number": "२१", "content_sanskrit": "बलात्कृतेष्अु भूतेषु परित्राणं कुरूद्वह ।\nशरणागतेषु कौरव्य कुर्वन् गार्हस्थ्यमावसेत्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2181682, "chapter_id": 4850, "verse_number": "२२", "content_sanskrit": "चराचराणां भूतानां रक्षामपि च सर्वशः ।\nयथार्हपूजां च सदा कुर्वन् गार्हस्थ्यमावसेत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2181683, "chapter_id": 4850, "verse_number": "२४", "content_sanskrit": "ज्येष्ठानुज्येष्ठपत्नीनां भ्रातॄणां पुत्रनप्तृणाम् ।\nनिग्रहानुग्रहौ पार्थ गार्हस्थ्यमिति तत् तपः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2181684, "chapter_id": 4850, "verse_number": "२४", "content_sanskrit": "साधूनामर्चनीयानां प्रजासु विदितात्मनाम् ।\nपालनं पुरुषव्याघ्र गृहाश्रमपदं भवेत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2181685, "chapter_id": 4850, "verse_number": "२५", "content_sanskrit": "आश्रमस्थानि सर्वाणि यस्तु वेश्मनि भारत ।\nआददीतेह भोज्येन तद् गार्हस्थ्यं युधिष्ठिर\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2181686, "chapter_id": 4850, "verse_number": "२६", "content_sanskrit": "यः स्थितः पुरुषो धर्मे धात्रा सृष्टे यथार्थवत् ।\nआश्रमाणां स सर्वेषां फलं प्राप्नोत्यनुत्तमम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2181687, "chapter_id": 4850, "verse_number": "२७", "content_sanskrit": "यस्मिन्न नश्यन्ति गुणाः कौन्तेय पुरुषे सदा ।\nआश्रमस्थं तमप्याहुर्नरश्रेष्ठं युधिष्ठिर\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2181688, "chapter_id": 4850, "verse_number": "२८", "content_sanskrit": "स्थानमानं वयोमानं कुलमानं तथैव च ।\nकुर्वन् वसति सर्वेषु ह्याश्रमेषु युधिष्ठिर\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2181689, "chapter_id": 4850, "verse_number": "२९", "content_sanskrit": "देशधर्माश्च कौन्तेय कुलधर्मांस्तथैव च ।\nपालयन् पुरुषव्याघ्र राजा सर्वाश्रमी भवेत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2181690, "chapter_id": 4850, "verse_number": "३०", "content_sanskrit": "काले विभूतिं भूतानामुपहारांस्तथैव च ।\nअर्हयन् पुरुषव्याघ्र साधूनामाश्रमे वसेत्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2181691, "chapter_id": 4850, "verse_number": "३१", "content_sanskrit": "दशधर्मगतश्चापि यो धर्मं प्रत्यवेक्षते ।\nसर्वलोकस्य कौन्तेय राजा भवति सोऽऽश्रमी\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2181692, "chapter_id": 4850, "verse_number": "३२", "content_sanskrit": "ये धर्मकुशला लोके धर्मं कुर्वन्ति साधवः ।\nपालिता यस्य विषये पादोंऽशस्तस्य भूपतेः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2181693, "chapter_id": 4850, "verse_number": "३३", "content_sanskrit": "धर्मारामान् धर्मपरान् ये न रक्षन्ति मानवान् ।\nपार्थिवाः पुरुषव्याघ्र तेषां पापं हरन्ति ते\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2181694, "chapter_id": 4850, "verse_number": "३४", "content_sanskrit": "ये च रक्षासहायाः स्युः पार्थिवानां युधिष्ठिर ।\nते चैवांशहराः सर्वे धर्मे परकृतेऽनघ\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2181695, "chapter_id": 4850, "verse_number": "३५", "content_sanskrit": "सर्वाश्रमपदे ह्याहुर्गार्हस्थ्यं दीप्तनिर्णयम् ।\nपावनं पुरुषव्याघ्र यं वयं पर्युपास्महे\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2181696, "chapter_id": 4850, "verse_number": "३६", "content_sanskrit": "आत्मोपमस्तु भूतेषु यो वै भवति मानवः ।\nन्यस्तदण्डो जितक्रोधः स प्रेत्य लभते सुखम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2181697, "chapter_id": 4850, "verse_number": "३७", "content_sanskrit": "धर्मोत्थिता सत्त्ववीर्या धर्मसेतुवटारका ।\nत्यागवाताध्वगा शीघ्रा नौस्त्वा सन्तारयिष्यति\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2181698, "chapter_id": 4850, "verse_number": "३८", "content_sanskrit": "यदा निवृत्तः सर्वस्मात् कामो योऽस्य हृदि स्थितः ।\nतदा भवति सत्त्वस्थस्ततो ब्रह्म समश्नुते\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2181699, "chapter_id": 4850, "verse_number": "३९", "content_sanskrit": "सुप्रसन्नस्तु भावेन योगेन च नराधिप ।\nधर्मं पुरुषशार्दूल प्राप्स्यते पालने रतः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2181700, "chapter_id": 4850, "verse_number": "४०", "content_sanskrit": "वेदाध्ययनशीलानां विप्राणां साधुकर्मणाम् ।\nपालने यत्नमातिष्ठ सर्वलोकस्य चानघ\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2181701, "chapter_id": 4850, "verse_number": "४१", "content_sanskrit": "वने चरति यो धर्ममाश्रमेषु च भारत ।\nरक्षया तच्छतगुणं धर्मं प्राप्नोति पार्थिवः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2181702, "chapter_id": 4850, "verse_number": "४२", "content_sanskrit": "एष ते विविधो धर्मः पाण्डवश्रेष्ठ कीर्तितः ।\nअनुतिष्ठ त्वमेनं वै पूर्वैर्दृष्टं सनातनम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2181703, "chapter_id": 4850, "verse_number": "४३", "content_sanskrit": "चातुराश्रम्यमेकाग्रः चातुर्वर्ण्यं च पाण्डव ।\nधर्मं पुरुषशार्दूल प्राप्स्यसे पालने रतः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2181704, "chapter_id": 4850, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे सप्तषष्टितमोऽध्यायः ॥ ६७ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]