[{"id": 6000060000, "chapter_id": 10060, "verse_number": null, "content_sanskrit": "अथ त्रिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000060001, "chapter_id": 10060, "verse_number": null, "content_sanskrit": "देवहूतिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.001.m4a", "display_order": 2}, {"id": 6000060002, "chapter_id": 10060, "verse_number": "३-३०-१", "content_sanskrit": "लक्षणं महदादीनां प्रकृतेः पुरुषस्य च।\nस्वरूपं लक्ष्यतेऽमीषां येन तत् पारमार्थिकम्॥ ३/३०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.002.m4a", "display_order": 3, "topics": [{"text": "कपिलेन देवहूतिं प्रति भक्तियोगनिरूपणम्", "range": "१–२७"}]}, {"id": 6000060003, "chapter_id": 10060, "verse_number": "३-३०-२", "content_sanskrit": "यथा साङ्ख्येषु कथितं यन्मूलं तत् प्रचक्षते।\nभक्तियोगस्य मे मार्गं ब्रूहि विस्तरशः प्रभो॥ ३/३०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.003.m4a", "display_order": 4}, {"id": 6000060004, "chapter_id": 10060, "verse_number": "३-३०-३", "content_sanskrit": "विरागो येन पुरुषो भगवन् सर्वतो भवेत्।\nआचक्ष्व जीवलोकस्य विविधाः कर्मसंसृतीः॥ ३/३०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.004.m4a", "display_order": 5}, {"id": 6000060005, "chapter_id": 10060, "verse_number": "३-३०-४", "content_sanskrit": "कालस्येश्वररूपस्य परेषां च परस्य ते।\nस्वरूपं बत कुर्वन्ति यद्धेतोः कुशलं जनाः॥ ३/३०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.005.m4a", "display_order": 6}, {"id": 6000060006, "chapter_id": 10060, "verse_number": "३-३०-५", "content_sanskrit": "लोकस्य मिथ्याभिमतेरचक्षुषश्चिरं प्रसुप्तस्य तमस्यनाश्रये।\nश्रान्तस्य कर्मस्वनुविद्धया धिया त्वमाविरासीः किल योगभास्करः॥ ३/३०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.006.m4a", "display_order": 7}, {"id": 6000060007, "chapter_id": 10060, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.007.m4a", "display_order": 8}, {"id": 6000060008, "chapter_id": 10060, "verse_number": "३-३०-६", "content_sanskrit": "इति मातुर्वचः श्लक्ष्णं प्रतिनन्द्य महामुनिः।\nआबभाषे कुरुश्रेष्ठ प्रीतस्तां करुणार्दितः॥ ३/३०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.008.m4a", "display_order": 9}, {"id": 6000060009, "chapter_id": 10060, "verse_number": null, "content_sanskrit": "भगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.009.m4a", "display_order": 10}, {"id": 6000060010, "chapter_id": 10060, "verse_number": "३-३०-७", "content_sanskrit": "भक्तियोगो बहुविधो मार्गैर्भामिनि भाव्यते।\nस्वभावगुणमार्गेण पुंसां भावो विभिद्यते॥ ३/३०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.010.m4a", "display_order": 11}, {"id": 6000060011, "chapter_id": 10060, "verse_number": "३-३०-८", "content_sanskrit": "अभिसन्धाय यो हिंसां दम्भं मात्सर्यमेव च।\nसंरम्भी भिन्नदृग् भावं मयि कुर्यात् स तामसः॥ ३/३०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.011.m4a", "display_order": 12}, {"id": 6000060012, "chapter_id": 10060, "verse_number": "३-३०-९", "content_sanskrit": "विषयानभिसन्धाय यश ऐश्वर्यमेव च।\nअर्चादावर्चयेद् यो मां पृथग्भावः स राजसः॥ ३/३०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.012.m4a", "display_order": 13}, {"id": 6000060013, "chapter_id": 10060, "verse_number": "३-३०-१०", "content_sanskrit": "कर्मनिर्हारमुद्दिश्य परस्मिन् वा तदर्पणम्।\nयजेद् यष्टव्यमिति वाऽपृथग्भावः स सात्त्विकः॥ ३/३०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.013.m4a", "display_order": 14}, {"id": 6000060014, "chapter_id": 10060, "verse_number": "३-३०-११", "content_sanskrit": "मद्गुणश्रुतमात्रेण मयि सर्वगुणाश्रये।\nमनोगतिरविच्छिन्ना यथा गङ्गाम्भसोऽम्बुधौ॥ ३/३०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.014.m4a", "display_order": 15}, {"id": 6000060015, "chapter_id": 10060, "verse_number": "३-३०-१२", "content_sanskrit": "लक्षणं भक्तियोगस्य निर्गुणस्य ह्युदाहृतम्।\nअहैतुक्यव्यवहिता या भक्तिः पुरुषोत्तमे॥ ३/३०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.015.m4a", "display_order": 16}, {"id": 6000060016, "chapter_id": 10060, "verse_number": "३-३०-१३", "content_sanskrit": "सालोक्यसार्ष्टिसामीप्यसारूप्यैकत्वमित्युत।\nदीयमानान् न गृह्णन्ति विना मत्सेवनं जनाः॥ ३/३०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.016.m4a", "display_order": 17}, {"id": 6000060017, "chapter_id": 10060, "verse_number": "३-३०-१४", "content_sanskrit": "स एव भक्तियोगाख्य आत्यन्तिक उदाहृतः।\nयेनातिव्रज्य त्रिगुणान् मद्भावायोपपद्यते॥ ३/३०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.017.m4a", "display_order": 18}, {"id": 6000060018, "chapter_id": 10060, "verse_number": "३-३०-१५", "content_sanskrit": "निषेवितेनानिमित्तेन स्वधर्मेण महीयसा।\nक्रियायोगेन शस्तेन नातिहिंस्रेण नित्यशः॥ ३/३०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.018.m4a", "display_order": 19}, {"id": 6000060019, "chapter_id": 10060, "verse_number": "३-३०-१६", "content_sanskrit": "मद्धिष्ण्यदर्शनस्पर्शपूजास्तुत्यभिवन्दनैः।\nभूतेषु मद्भावनया सत्येनासङ्गमेन च॥ ३/३०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.019.m4a", "display_order": 20}, {"id": 6000060020, "chapter_id": 10060, "verse_number": "३-३०-१७", "content_sanskrit": "महतां बहुमानेन हीनानामनुकम्पया।\nमैत्र्या वा चात्मतुल्येषु यमेन नियमेन च॥ ३/३०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.020.m4a", "display_order": 21}, {"id": 6000060021, "chapter_id": 10060, "verse_number": "३-३०-१८", "content_sanskrit": "आध्यात्मिकानुश्रवणान्नामसङ्कीर्तनाच्च मे।\nआर्जवेनार्यसङ्गेन निरहंक्रियया तथा॥ ३/३०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.021.m4a", "display_order": 22}, {"id": 6000060022, "chapter_id": 10060, "verse_number": "३-३०-१९", "content_sanskrit": "मद्धर्मेणापि यर्ह्येतैः परिसंशुद्ध आशयः।\nपुरुषस्याञ्जसाऽभ्येति श्रुतमात्रगुणं हि माम्॥ ३/३०/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.022.m4a", "display_order": 23}, {"id": 6000060023, "chapter_id": 10060, "verse_number": "३-३०-२०", "content_sanskrit": "यथा वातरथो घ्राणमावृङ्क्ते गन्ध आशयात्।\nएवं योगरतं चेत आत्मानमविकारि यत्॥ ३/३०/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.023.m4a", "display_order": 24}, {"id": 6000060024, "chapter_id": 10060, "verse_number": "३-३०-२१", "content_sanskrit": "अहं सर्वेषु भूतेषु भूतात्माऽवस्थितः सदा।\nतमवज्ञाय मां मर्त्यः कुरुतेऽर्चाविडम्बनम्॥ ३/३०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.024.m4a", "display_order": 25}, {"id": 6000060025, "chapter_id": 10060, "verse_number": "३-३०-२२", "content_sanskrit": "यो मां सर्वेषु भूतेषु सन्तमात्मानमीश्वरम्।\nहित्वाऽर्चां भजते मौढ्याद् भस्मन्येव जुहोति सः॥ ३/३०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.025.m4a", "display_order": 26}, {"id": 6000060026, "chapter_id": 10060, "verse_number": "३-३०-२३", "content_sanskrit": "द्विषतः परकाये मां मानिनो भिन्नदर्शिनः।\nभूतेषु बद्धवैरस्य न मनः शान्तिमृच्छति॥ ३/३०/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.026.m4a", "display_order": 27}, {"id": 6000060027, "chapter_id": 10060, "verse_number": "३-३०-२४", "content_sanskrit": "अहमुच्चावचैर्द्रव्यैः क्रिययोत्पन्नयाऽनघे।\nनैव तृप्येऽर्चितोऽर्चायां भूतग्रामावमानिनः॥ ३/३०/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.027.m4a", "display_order": 28}, {"id": 6000060028, "chapter_id": 10060, "verse_number": "३-३०-२५", "content_sanskrit": "अर्चादावर्चयेत् तावदीश्वरं मां स्वकर्मकृत्।\nयावन्न वेद स्वहृदि सर्वभूतेष्ववस्थितम्॥ ३/३०/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.028.m4a", "display_order": 29}, {"id": 6000060029, "chapter_id": 10060, "verse_number": "३-३०-२६", "content_sanskrit": "आत्मनश्च परस्यापि यः करोत्यन्तरोदरम्।\nतस्य भिन्नदृशो मृत्युर्विधत्ते भयमुल्बणम्॥ ३/३०/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.029.m4a", "display_order": 30}, {"id": 6000060030, "chapter_id": 10060, "verse_number": "३-३०-२७", "content_sanskrit": "अथ मां सर्वभूतेषु भूतात्मानं कृतालयम्।\nअर्हयेद् दानमानाभ्यां मैत्र्या भिन्नेन चक्षुषा॥ ३/३०/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.030.m4a", "display_order": 31}, {"id": 6000060031, "chapter_id": 10060, "verse_number": "३-३०-२८", "content_sanskrit": "जीवाः श्रेष्ठा ह्यजीवानां ततः प्राणभृतः शुभे।\nततः सचित्ताः प्रवरास्ततश्चेन्द्रियवृत्तयः॥ ३/३०/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.031.m4a", "display_order": 32, "topics": [{"text": "जीवतारतम्यम्", "range": "२८–३५"}]}, {"id": 6000060032, "chapter_id": 10060, "verse_number": "३-३०-२९", "content_sanskrit": "अत्रापि स्पर्शवेदिभ्यः प्रवरा रसवेदिनः।\nतेभ्यो गन्धविदः श्रेष्ठास्ततः शब्दविदो वराः॥ ३/३०/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.032.m4a", "display_order": 33}, {"id": 6000060033, "chapter_id": 10060, "verse_number": "३-३०-३०", "content_sanskrit": "रूपभेदविदस्तत्र ततश्चोभयतोदतः।\nतेषां बहुपदः श्रेष्ठाश्चतुष्पादस्ततो द्विपात्॥ ३/३०/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.033.m4a", "display_order": 34}, {"id": 6000060034, "chapter_id": 10060, "verse_number": "३-३०-३१", "content_sanskrit": "ततो वर्णाश्च चत्वारस्तेषां ब्राह्मण उत्तमः।\nब्राह्मणेष्वपि वेदज्ञो ह्यर्थज्ञोऽभ्यधिकस्ततः॥ ३/३०/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.034.m4a", "display_order": 35}, {"id": 6000060035, "chapter_id": 10060, "verse_number": "३-३०-३२", "content_sanskrit": "अर्थज्ञात् संशयच्छेत्ता ततः श्रेयान् स्वधर्मकृत्।\nमुक्तसङ्गस्ततो भूयान् न दोग्धा धर्ममात्मनः॥ ३/३०/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.035.m4a", "display_order": 36}, {"id": 6000060036, "chapter_id": 10060, "verse_number": "३-३०-३३", "content_sanskrit": "तस्मान्मय्यर्पिताशेषक्रियार्थात्मरतिर्नरः। मय्यर्पितात्मनः पुंसो मयि संन्यस्तकर्मणः।\nन पश्यामि परं भूतमकर्तुः समदर्शनात्॥ ३/३०/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.036.m4a", "display_order": 37}, {"id": 6000060037, "chapter_id": 10060, "verse_number": "३-३०-३४", "content_sanskrit": "मनसैतानि भूतानि प्रणमेद् बहुमानयन्।\nईश्वरो जीवकलया प्रविष्टो भगवानिति॥ ३/३०/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.037.m4a", "display_order": 38}, {"id": 6000060038, "chapter_id": 10060, "verse_number": "३-३०-३५", "content_sanskrit": "भक्तियोगश्च योगश्च मया मानव्युदीरितः।\nययोरेकतरेणैव पुरुषः पुरुषं व्रजेत्॥ ३/३०/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.038.m4a", "display_order": 39}, {"id": 6000060039, "chapter_id": 10060, "verse_number": "३-३०-३६", "content_sanskrit": "यत् तद् भगवतो रूपं ब्रह्मणः परमात्मनः।\nपरं प्रधानात् पुरुषाद् दैवं कर्मविचेष्टितम्॥ ३/३०/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.039.m4a", "display_order": 40, "topics": [{"text": "तथा कालमहिमानुवर्णनम्", "range": "३६–४५"}]}, {"id": 6000060040, "chapter_id": 10060, "verse_number": "३-३०-३७", "content_sanskrit": "रूपभेदास्पदं दिव्यं काल इत्यभिधीयते।\nभूतानां महदादीनां यतो भिन्नदृशां भयम्॥ ३/३०/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.040.m4a", "display_order": 41}, {"id": 6000060041, "chapter_id": 10060, "verse_number": "३-३०-३८", "content_sanskrit": "योऽन्तः प्रविश्य भूतानि भूतैरत्त्यखिलाश्रयः।\nस विष्ण्वाख्यो धिया ज्ञेयः कालः कलयतां प्रभुः॥ ३/३०/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.041.m4a", "display_order": 42}, {"id": 6000060042, "chapter_id": 10060, "verse_number": "३-३०-३९", "content_sanskrit": "न चास्य कश्चिद् दयितो न द्वेष्यो न च बान्धवः।\nआविशत्यप्रमत्तोऽसौ प्रमत्तं जनमन्तकृत्॥ ३/३०/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.042.m4a", "display_order": 43}, {"id": 6000060043, "chapter_id": 10060, "verse_number": "३-३०-४०", "content_sanskrit": "यद्भयाद् वाति वातोऽयं सूर्यस्तपति यद्भयात्।\nयद्भयाद् वर्षते देवो भगणो भाति यद्भयात्॥ ३/३०/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.043.m4a", "display_order": 44}, {"id": 6000060044, "chapter_id": 10060, "verse_number": "३-३०-४१", "content_sanskrit": "यद् वनस्पतयो भीता लताश्चौषधिभिः सह।\nस्वे स्वे कालेऽभिगृह्णन्ति पुष्पाणि च फलानि च॥ ३/३०/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.044.m4a", "display_order": 45}, {"id": 6000060045, "chapter_id": 10060, "verse_number": "३-३०-४२", "content_sanskrit": "स्रवन्ति सरितो भीता नोत्सर्पत्युदधिर्यतः।\nअग्निरिन्धे सगिरिभिर्भूर्न मज्जति यद्भयात्॥ ३/३०/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.045.m4a", "display_order": 46}, {"id": 6000060046, "chapter_id": 10060, "verse_number": "३-३०-४३", "content_sanskrit": "नभो ददाति श्वसतां मार्गं यन्नियमाददः।\nलोकस्य देहं तनुते महान् सप्तभिरावृतः॥ ३/३०/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.046.m4a", "display_order": 47}, {"id": 6000060047, "chapter_id": 10060, "verse_number": "३-३०-४४", "content_sanskrit": "गुणाभिमानिनो देवाः सर्गादिष्वस्य यद्भयात्।\nवर्तन्तेऽनुयुगं येषां वश एतच्चराचरम्॥ ३/३०/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.047.m4a", "display_order": 48}, {"id": 6000060048, "chapter_id": 10060, "verse_number": "३-३०-४५", "content_sanskrit": "सोऽनन्तोऽन्तकरः कालोऽनादिरादिकृदव्ययः।\nजनं जनेन जनयन् मारयन् मृत्युनाऽऽत्मनः॥ ३/३०/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_030/BhP_03.030.048.m4a", "display_order": 49}, {"id": 6000060049, "chapter_id": 10060, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे त्रिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]