[{"id": 7003960000, "chapter_id": 23960, "verse_number": "३-१-२३-१", "content_sanskrit": "श्रीसूत उवाच ।\nअग्नितीर्थाभिधे तीर्थे सर्वपातकनाशने ।\nस्नानं कृत्वा विशुद्धात्मा चक्रतीर्थं ततो व्रजेत्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003960001, "chapter_id": 23960, "verse_number": "३-१-२३-२", "content_sanskrit": "यंयं कामं समुद्दिश्य चक्रतीर्थे द्विजोत्तमाः ।\nस्नानं समाचरेन्मर्त्यस्तंतं कामं समश्नुते॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003960002, "chapter_id": 23960, "verse_number": "३-१-२३-३", "content_sanskrit": "पुराहिर्बुध्न्यनामा तु महर्षिः संशित व्रतः ।\nसुदर्शनमुपास्तास्मिंस्तपस्वी गंधमादने॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003960003, "chapter_id": 23960, "verse_number": "३-१-२३-४", "content_sanskrit": "तपस्यंतं मुनिं तत्र राक्षसा घोररूपिणः ।\nअबाधंत सदा विप्रास्तपोविघ्नैकतत्पराः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003960004, "chapter_id": 23960, "verse_number": "३-१-२३-५", "content_sanskrit": "सुदर्शनं तदागत्य भक्तरक्षणवांछया ।\nयातुधानान्बाधमानान्न्यवधीर्लीलया पुरा॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003960005, "chapter_id": 23960, "verse_number": "३-१-२३-६", "content_sanskrit": "तदाप्रभृति तच्चक्रं भक्तप्रार्थनया द्विजाः ।\nअहिर्बुध्न्यकृते तीर्थे सन्निधानं सदाऽकरोत्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003960006, "chapter_id": 23960, "verse_number": "३-१-२३-७", "content_sanskrit": "तदाप्रभृति तत्तीर्थं चक्रतीर्थमितीर्यते ।\nसुदर्शनप्रसादेन तत्र तीर्थे निमज्जनात्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003960007, "chapter_id": 23960, "verse_number": "३-१-२३-८", "content_sanskrit": "रक्षःपिशाचा दिकृता पीडा नास्त्येव कर्हिचित् ।\nस्नात्वास्मिन्पावने तीर्थे छिन्नपाणिः पुरा रविः ।\nस हिरण्यमयौ पाणी लब्धवांस्तीर्थवैभवात्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003960008, "chapter_id": 23960, "verse_number": "३-१-२३-९", "content_sanskrit": "ऋषय ऊचुः ।\nछिन्नपाणिः कथमभूदादित्यः सूतनंदन ।\nयथा च लब्धवान्पाणी सौवर्णौ तद्वदस्व नः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003960009, "chapter_id": 23960, "verse_number": "३-१-२३-१०", "content_sanskrit": "श्रीसूत उवाच ।\nइंद्रादयः सुराः पूर्वं संततं दैत्यपीडिताः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003960010, "chapter_id": 23960, "verse_number": "३-१-२३-११", "content_sanskrit": "किं कुर्म इति संचित्य संभूय सममंत्रयन् ।\nबृहस्पतिं पुरस्कृत्य मंत्रयित्वा चिरं सुराः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003960011, "chapter_id": 23960, "verse_number": "३-१-२३-१२", "content_sanskrit": "तुरासाहं पुरोधाय धाम स्वायंभुवं ययुः ।\nते ब्रह्माणं समासाद्य दृष्ट्वा स्तुत्वा च भक्तितः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003960012, "chapter_id": 23960, "verse_number": "३-१-२३-१३", "content_sanskrit": "ततो व्यजिज्ञपस्तस्मै स्वेषामागमकारणम् ।\nसुरा ऊचुः ।\nभगवन्भारतीनाथ दैत्या ह्यस्मान्बलोत्कटाः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003960013, "chapter_id": 23960, "verse_number": "३-१-२३-१४", "content_sanskrit": "बाधंते सततं देव तत्र ब्रूहि प्रतिक्रियाम् ।\nइत्युक्तः स सुरैर्ब्रह्मा तानाह कृपया वचः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003960014, "chapter_id": 23960, "verse_number": "३-१-२३-१५", "content_sanskrit": "ब्रह्मोवाच ।\nमा भैष्ट यूयं विबुधास्तत्रोपायं ब्रवीम्यहम् ।\nमाहेश्वरं महायज्ञमसुराणां विनाशनम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003960015, "chapter_id": 23960, "verse_number": "३-१-२३-१६", "content_sanskrit": "प्रारभध्वं सुरा यूयं मुनिभिस्तत्त्वदर्शिभिः ।\nअयं च दैवतैः सर्वैर्विधिलोभं विना कृतः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003960016, "chapter_id": 23960, "verse_number": "३-१-२३-१७", "content_sanskrit": "माहेश्वरो महायज्ञः क्रियतां गंधमादने ।\nयदि ह्यन्यत्र तं यज्ञं कुर्युस्तद्विबुधर्षभाः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003960017, "chapter_id": 23960, "verse_number": "३-१-२३-१८", "content_sanskrit": "यज्ञविघ्नं तदा कुर्युर्दुरात्मानः सुरद्विषः ।\nक्रियते यद्ययं यज्ञो गंधमादनपर्वते॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003960018, "chapter_id": 23960, "verse_number": "३-१-२३-१९", "content_sanskrit": "सुदर्शनप्रसादेन नैव विघ्नो भवेत्तदा ।\nअहिर्बुध्न्याभिधानस्य महर्षेर्गंधमादने॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003960019, "chapter_id": 23960, "verse_number": "३-१-२३-२०", "content_sanskrit": "अनुग्रहाय तत्तीर्थे सन्निधत्ते सुदर्शनम् ।\nअतः कुरुध्वं भो यूयं तं यज्ञं गंधमादने॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003960020, "chapter_id": 23960, "verse_number": "३-१-२३-२१", "content_sanskrit": "नातिदूरे चक्रतीर्थादसुराणां विनाशकम् ।\nततस्ते ब्रह्मवचसा सहसा गंधमादनम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003960021, "chapter_id": 23960, "verse_number": "३-१-२३-२२", "content_sanskrit": "बृहस्पतिं पुरस्कृत्य जग्मुर्यज्ञचिकीर्षया ।\nते प्रणम्य महात्मानमहिर्बुध्न्यं मुनीश्वरम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003960022, "chapter_id": 23960, "verse_number": "३-१-२३-२३", "content_sanskrit": "अकल्पयन्यज्ञवाटन्नातिदूरे तदाश्रमात् ।\nयज्ञकर्मसु निष्णातैः सहितास्ते तपोधनैः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003960023, "chapter_id": 23960, "verse_number": "३-१-२३-२४", "content_sanskrit": "इष्टिमारेभिरे देवा असुराणां विनाशिनीम् ।\nतस्मिन्कर्मणि होतासीत्स्वयमेव बृहस्पतिः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003960024, "chapter_id": 23960, "verse_number": "३-१-२३-२५", "content_sanskrit": "बभूव मैत्रावरुणो जयंतः पाकशासनिः ।\nअच्छावाको बभूवात्र वसूनामष्टमो वसुः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003960025, "chapter_id": 23960, "verse_number": "३-१-२३-२६", "content_sanskrit": "ग्रावस्तुदभवत्तत्र शक्तिपुत्रः पराशरः ।\nअष्टावक्रो महातेजा अध्वर्युधुरमूढवान्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003960026, "chapter_id": 23960, "verse_number": "३-१-२३-२७", "content_sanskrit": "तत्र प्रतिप्रस्थाताभूद्विश्वामित्रो महामुनिः ।\nनेष्टा बभूव वरुण उन्नेता च धनेश्वरः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003960027, "chapter_id": 23960, "verse_number": "३-१-२३-२८", "content_sanskrit": "ब्रह्मा बभूव सविता यज्ञस्यार्धधुरं वहन् ।\nबभूव ब्राह्मणाच्छंसी वसिष्ठो ब्रह्मणोत्तमः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003960028, "chapter_id": 23960, "verse_number": "३-१-२३-२९", "content_sanskrit": "आग्नीध्रोऽभूच्छुनःशेपः पोता जातश्च पावकः ।\nउद्गाता वायुरभवत्प्रस्तोता च परेतराट्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003960029, "chapter_id": 23960, "verse_number": "३-१-२३-३०", "content_sanskrit": "प्रतिहर्ता तु तत्रासीदगस्त्यः कुंभसंभवः ।\nसुब्रह्मण्यो मधुच्छंदा विश्वामित्रात्मजो महान्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003960030, "chapter_id": 23960, "verse_number": "३-१-२३-३१", "content_sanskrit": "यजमानः स्वयमभूद्देवराजः पुरंदरः ।\nउपद्रष्टा बभूवात्र व्यासपुत्रः शुको मुनिः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003960031, "chapter_id": 23960, "verse_number": "३-१-२३-३२", "content_sanskrit": "ततस्ते ऋत्विजः सर्वे देवराजं पुरंदरम् ।\nविधिवद्दीक्षयांचक्रुस्तत्र माहेश्वरे क्रतौ॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003960032, "chapter_id": 23960, "verse_number": "३-१-२३-३३", "content_sanskrit": "प्रावर्तत महायज्ञ एवं वै गंधमादने ।\nसुदर्शनप्रभावेन दुःसहेनातिपीडिताः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003960033, "chapter_id": 23960, "verse_number": "३-१-२३-३४", "content_sanskrit": "नाविंदन्नसुरास्तत्र रंध्रं यज्ञे प्रवर्तिते ।\nएवन्निरंतरायोऽसौ प्रावर्तत महा क्रतुः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003960034, "chapter_id": 23960, "verse_number": "३-१-२३-३५", "content_sanskrit": "भक्षयंश्च हरिस्तत्र जज्वाल हुतवाहनः ।\nविधिवत्कर्मजालानि कृत्वाध्वर्युरसंभ्रमात्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003960035, "chapter_id": 23960, "verse_number": "३-१-२३-३६", "content_sanskrit": "मंत्रपूतं पुरोडाशं जुहवामास पावके ।\nहुतशेषं पुरोडाशं विभज्याध्वर्युरादरात्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003960036, "chapter_id": 23960, "verse_number": "३-१-२३-३७", "content_sanskrit": "ऋत्विग्भ्यो होतृमुख्येभ्यः प्रददौ पापनाशनम् ।\nसवित्रे ब्रह्मणे चैकमत्युग्रतरतेजसम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003960037, "chapter_id": 23960, "verse_number": "३-१-२३-३८", "content_sanskrit": "ददौ तत्र पुरोडाशभागं प्राशित्रनामकम् ।\nप्रतिजग्राह पाणिभ्यां प्राशित्रं सविता तदा॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003960038, "chapter_id": 23960, "verse_number": "३-१-२३-३९", "content_sanskrit": "सवित्रा स्पृष्टमात्रं सत्तत्प्राशित्रं दुरासदम् ।\nतस्य पाणी प्रचिच्छेद पश्यतां सर्वऋत्विजाम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003960039, "chapter_id": 23960, "verse_number": "३-१-२३-४०", "content_sanskrit": "ततः संछिन्नपाणिः स प्राशित्रेणोग्रतेजसा ।\nकिमेतदिति संत्रस्तो विषण्णवदनोऽभवत्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003960040, "chapter_id": 23960, "verse_number": "३-१-२३-४१", "content_sanskrit": "सविता ऋत्विजः सर्वान्समाहूयेदमब्रवीत् ।\nसवितोवाच ।\nपुरोडाशस्य भागोऽयं मम प्राशित्रनामकः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003960041, "chapter_id": 23960, "verse_number": "३-१-२३-४२", "content_sanskrit": "दत्तश्चिच्छेद मत्पाणी मिषत्स्वेव भवत्स्वपि ।\nअतो भवंतः संभूय सर्व एव हि ऋत्विजः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003960042, "chapter_id": 23960, "verse_number": "३-१-२३-४३", "content_sanskrit": "कल्पयंतामिमौ पाणी नोचेद्यज्ञं निहन्म्यमुम् ।\nसवितुर्वाक्यमाकर्ण्य ते सर्वे समचिंतयन्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003960043, "chapter_id": 23960, "verse_number": "३-१-२३-४४", "content_sanskrit": "तत्र मध्ये मुनींद्राणां देवानां चैव सर्वशः ।\nअष्टावक्रो महातेजा ऋत्विजस्तानभाषत॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003960044, "chapter_id": 23960, "verse_number": "३-१-२३-४५", "content_sanskrit": "अष्टावक्र उवाच ।\nशृणुध्वमृत्विजः सर्वे मम वाक्यं समाहिताः ।\nमयि जीवति विप्रेंद्रा विरिंचानां शतं गतम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003960045, "chapter_id": 23960, "verse_number": "३-१-२३-४६", "content_sanskrit": "जायंते च म्रियंते च चतुराननकोटयः ।\nपश्यन्नेव च तान्सर्वानहं प्राणानधारयम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003960046, "chapter_id": 23960, "verse_number": "३-१-२३-४७", "content_sanskrit": "तत्र लोकेश्वराभिख्ये वर्तमाने प्रजापतौ ।\nविप्रो हरिहरोनाम निवसञ्छयामलापुरे॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003960047, "chapter_id": 23960, "verse_number": "३-१-२३-४८", "content_sanskrit": "व्याधेनारण्यवासेन केल्यर्थं लक्ष्यवेधिना ।\nछिन्नपादोऽभवद्बाणैर्लक्ष्य मध्यं समागतः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003960048, "chapter_id": 23960, "verse_number": "३-१-२३-४९", "content_sanskrit": "स गंधमादनं प्राप्य मुनिभिः प्रेरितस्तदा ।\nस्नात्वा च मुनितीर्थेऽस्मिन्प्राप्तवांश्चरणौ पुरा॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003960049, "chapter_id": 23960, "verse_number": "३-१-२३-५०", "content_sanskrit": "तदा पुण्यमिदं तीर्थं मुनितीर्थमितीरितम् ।\nइदानीं चक्रतीर्थाख्यं चक्रनाम त्वविंदत॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003960050, "chapter_id": 23960, "verse_number": "३-१-२३-५१", "content_sanskrit": "तदत्र क्रियतां स्नानं प्राशित्रच्छिन्नपाणिना ।\nमुनितीर्थे सवित्रापि युष्माकं यदि रोचते॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003960051, "chapter_id": 23960, "verse_number": "३-१-२३-५२", "content_sanskrit": "ऋत्विजः कथितास्त्वेवमष्टावक्रमहर्षिणा ।\nसवितारमभाषंत सर्व एव प्रहर्षिताः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003960052, "chapter_id": 23960, "verse_number": "३-१-२३-५३", "content_sanskrit": "सवितः स्नाहि तीर्थेऽ स्मिंस्तव पाणी भविष्यतः ।\nअष्टावक्रो यथा प्राह तथा कुरु समाहितः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003960053, "chapter_id": 23960, "verse_number": "३-१-२३-५४", "content_sanskrit": "ततः स सविता गत्वा चक्रतीर्थं महत्तरम् ।\nसस्नौ पाण्योरवाप्त्यर्थमिष्टदायिनि तत्र सः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003960054, "chapter_id": 23960, "verse_number": "३-१-२३-५५", "content_sanskrit": "उत्तिष्ठन्नेव स तदा तत्र स्नात्वा सभक्तिकम् ।\nयुक्तो हिरण्मयाभ्यां तु पाणिभ्यां समदृश्यत॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003960055, "chapter_id": 23960, "verse_number": "३-१-२३-५६", "content_sanskrit": "हिरण्यपाणिं तं दृष्ट्वा जहृषुः सर्वऋत्विजः ।\nततः समाप्य तं यज्ञं दैत्यसंघान्विजित्य च॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003960056, "chapter_id": 23960, "verse_number": "३-१-२३-५७", "content_sanskrit": "इंद्रादयः सुराः सर्वे सुखिताः स्वर्गमाययुः ।\nतस्मादेतत्समागत्य तीर्थं सर्वैश्च मानवैः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003960057, "chapter_id": 23960, "verse_number": "३-१-२३-५८", "content_sanskrit": "सेवनीयं प्रयत्नेन स्वस्वाभीष्टस्य सिद्धये ।\nअंधैश्च कुणिभिर्मूकैर्बधिरैः कुब्जकैरपि॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003960058, "chapter_id": 23960, "verse_number": "३-१-२३-५९", "content_sanskrit": "खंजैः पंगुभिरप्येतदंगहीनैस्तथापरैः ।\nसंछिन्नपाणिचरणैः संछिन्नान्यांगसंचयैः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003960059, "chapter_id": 23960, "verse_number": "३-१-२३-६०", "content_sanskrit": "मनुष्यैश्च तथान्यैश्च विकलांगस्य पूर्तये ।\nसेवनीयमिदं तीर्थं सर्वाभीष्टप्रदायकम्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003960060, "chapter_id": 23960, "verse_number": "३-१-२३-६१", "content_sanskrit": "एवं वः कथितं विप्राश्चक्रतीर्थस्य वैभवम् ।\nयत्र स्नात्वा पुरा छिन्नौ पाणी प्राप प्रभाकरः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003960061, "chapter_id": 23960, "verse_number": "३-१-२३-६२", "content_sanskrit": "यः पठेदिममध्यायं शृणुयाद्वा समाहितः ।\nअंगानि विकलान्यस्य पूर्णानि स्युर्न संशयः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003960062, "chapter_id": 23960, "verse_number": "३-१-२३-६३", "content_sanskrit": "मोक्षकामस्य मर्त्यस्य मुक्तिः स्यान्नात्र संशयः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]