[{"id": 2159136, "chapter_id": 4448, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2159137, "chapter_id": 4448, "verse_number": "१", "content_sanskrit": "सुहोत्रं पार्थिवं चापि मृतं सृञ्जय शुश्रुम ।\nएकवीरमनाधृष्यममित्रगणमर्दनम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2159138, "chapter_id": 4448, "verse_number": "२", "content_sanskrit": "यः प्राप्य राज्यं धर्मेण ऋत्विङ्मन्त्रिपुरोहितान् ।\nसम्मान्य चात्मनः श्रेयः पृष्ट्वा तेषां मते स्थितः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2159139, "chapter_id": 4448, "verse_number": "३", "content_sanskrit": "प्रजानां पालनं धर्मो दानमिज्या द्विषज्जयः ।\nएतत् सुहोत्रो विज्ञाय धर्म्यमैच्छद् धनागमम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2159140, "chapter_id": 4448, "verse_number": "४", "content_sanskrit": "धर्मेणाराधयद् देवान् बाणैः शत्रूनजीजयत् ।\nसर्वाण्यपि च भूतानि स्वगुणैरन्वरञ्जयत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2159141, "chapter_id": 4448, "verse_number": "५", "content_sanskrit": "सोऽभुङ्क्तेमां वसुमतीं म्लेच्छाटविकवर्जिताम् ।\nतस्मै ववर्ष पर्जन्यो हिरण्यं परिवत्सरम्\nहिरण्योदास्तथा नद्यः सुहोत्रस्य महात्मनः\nहैरण्यास्तत्र वाहिन्यः स्वैरिण्यो ह्यवहन् पुरा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2159142, "chapter_id": 4448, "verse_number": "६", "content_sanskrit": "यस्मिन् कूर्मान् कर्कटकान् मत्स्यांश्च विविधान् बहून् ।\nकामान् वर्षति पर्जन्यो रूप्याणि विविधानि च\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2159143, "chapter_id": 4448, "verse_number": "७", "content_sanskrit": "सौवर्णान्यप्रमेयानि वाप्यः क्रोशसुसम्मिताः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2159144, "chapter_id": 4448, "verse_number": "८", "content_sanskrit": "स तत्र शतसाहस्रान् नक्रान् मकरकच्छपान् ।\nसौवर्णान् पतितान् दृष्ट्वा ततोऽस्मयत वै मिथः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2159145, "chapter_id": 4448, "verse_number": "९", "content_sanskrit": "तद् हिरण्यमपर्यन्तं राजर्षिः कुरुजाङ्गले ।\nईजानो वितते यज्ञे ब्राह्मणेभ्यो ह्यमन्यत\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2159146, "chapter_id": 4448, "verse_number": "१०", "content_sanskrit": "सोऽश्वमेधसहस्रेण राजसूयशतेन च ।\nपुण्यैः क्षत्रिययज्ञैश्च प्रभूतवरदक्षिणैः\nकाम्यनैमित्तिकाजस्रैरिष्ट्वेष्टां गतिमाप्तवान्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2159147, "chapter_id": 4448, "verse_number": "११", "content_sanskrit": "स चेन्ममार सृञ्जय चतुर्भद्रतरस्त्वया ।\nपुत्रात् पुण्यतमस्तुभ्यं मा पुत्रमनुतप्यथाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2159148, "chapter_id": 4448, "verse_number": "१२", "content_sanskrit": "अयज्वानमदक्षिण्यमधिवैत्येत्युदाहरत् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2159149, "chapter_id": 4448, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां द्रोणपर्वणि त्रिपञ्चाशत्त्मोऽध्यायः॥ ५३॥\nअभिमन्युवधपर्वणि द्वाविंशोऽध्यायः॥ २२॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]