[{"id": 7000621000, "chapter_id": 20621, "verse_number": "५-८०-१", "content_sanskrit": "पार्वत्युवाच ।\nघोरे कलियुगे प्राप्ते विषयग्राहसंकुले ।\nपुत्रदारधनाद्यार्तैस्तत्कथं धार्यते विभो॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000621001, "chapter_id": 20621, "verse_number": "५-८०-२", "content_sanskrit": "तदुपायं महादेव कथयस्व कृपानिधे ।\nईश्वर उवाच ।\nहरेर्नाम हरेर्नाम हरेर्नामैव केवलम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000621002, "chapter_id": 20621, "verse_number": "५-८०-३", "content_sanskrit": "हरेराम हरेकृष्ण कृष्णकृष्णेति मंगलम् ।\nएवं वदंति ये नित्यं न हि तान्बाधते कलि॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000621003, "chapter_id": 20621, "verse_number": "५-८०-४", "content_sanskrit": "अंतरांतरकर्माणि कृत्वा नामानि च स्मरेत् ।\nकृष्णकृष्णेति कृष्णेति कृष्णेत्याह पुनः पुनः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000621004, "chapter_id": 20621, "verse_number": "५-८०-५", "content_sanskrit": "मन्नाम चैव त्वन्नाम योजयित्वा व्यतिक्रमात् ।\nसोऽपि पापात्प्रमुच्येत तूलराशेरिवानलः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000621005, "chapter_id": 20621, "verse_number": "५-८०-६", "content_sanskrit": "जयाद्येतत्त्वया वाप्यथवा श्रीशब्दपूर्वकम् ।\nतच्च मे मंगलं नाम जपन्पापात्प्रमुच्यते॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000621006, "chapter_id": 20621, "verse_number": "५-८०-७", "content_sanskrit": "दिवानिशि च संध्यायां सर्वकालेषु संस्मरेत् ।\nअहर्निशं स्मरन्रामं कृष्णं पश्यति चक्षुषा॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000621007, "chapter_id": 20621, "verse_number": "५-८०-८", "content_sanskrit": "अशुचिर्वा शुचिर्वापि सर्वकालेषु सर्वदा ।\nनामसंस्मरणादेव संसारान्मुच्यते क्षणात्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000621008, "chapter_id": 20621, "verse_number": "५-८०-९", "content_sanskrit": "नानापराधयुक्तस्य नामापि च हरत्यघम् ।\nयज्ञव्रततपोदानं सांगं नैव कलौ युगे॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000621009, "chapter_id": 20621, "verse_number": "५-८०-१०", "content_sanskrit": "गंगास्नानं हरेर्नाम निरपायमिदं द्वयम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000621010, "chapter_id": 20621, "verse_number": "५-८०-११", "content_sanskrit": "हत्यायुतं पापसहस्रमुग्रं गुर्वंगनाकोटिनिषेवणं च ।\nस्तेयान्यथान्यानि हरेः प्रियेण गोविंदनाम्ना न च संति भद्रे॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000621011, "chapter_id": 20621, "verse_number": "५-८०-१२", "content_sanskrit": "अपवित्रः पवित्रो वा सर्वावस्थां गतोऽपि वा ।\nयः स्मरेत्पुंडीकाक्षं स बाह्याभ्यंतरः शुचिः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000621012, "chapter_id": 20621, "verse_number": "५-८०-१३", "content_sanskrit": "नामसंस्मरणादेव तथा तस्यार्थचिंतनात् ।\nसौवर्णीं राजतीं वापि तथा पैष्टीं स्रगाकृतिम्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000621013, "chapter_id": 20621, "verse_number": "५-८०-१४", "content_sanskrit": "पादयोश्चिह्नितां कृत्वा पूजां चैव समारभेत् ।\nदक्षिणस्य पदोंगुष्ठमूले चक्रं बिभर्ति यः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000621014, "chapter_id": 20621, "verse_number": "५-८०-१५", "content_sanskrit": "तत्र नम्रजनस्यापि संसारच्छेदनाय च ।\nमध्यमांगुलिमूले तु धत्ते कमलमच्युतः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000621015, "chapter_id": 20621, "verse_number": "५-८०-१६", "content_sanskrit": "ध्यातृचित्तद्विरेफाणां लोभनायातिशोभनम् ।\nपद्मस्याधोध्वजं धत्ते सर्वानर्थजयध्वजम्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000621016, "chapter_id": 20621, "verse_number": "५-८०-१७", "content_sanskrit": "कनिष्ठामूलतो वज्रं भक्तपापौघभेदनम् ।\nपार्श्वमध्येंऽकुशं भक्तचित्ते रभसकारणम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000621017, "chapter_id": 20621, "verse_number": "५-८०-१८", "content_sanskrit": "भोगसंपन्मयं धत्ते यवमंगुष्ठपर्वणि ।\nमूले गदां च पापाद्रिभेदनीं सर्वदेहिनाम्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000621018, "chapter_id": 20621, "verse_number": "५-८०-१९", "content_sanskrit": "सर्वविद्याप्रकाशाय धत्ते स भगवानजः ।\nपद्मादीन्यपि चिह्नानि तत्र दक्षेण यत्पुनः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000621019, "chapter_id": 20621, "verse_number": "५-८०-२०", "content_sanskrit": "वामपादे वसेत्सोऽयं बिभर्त्ति करुणानिधिः ।\nतस्माद्गोविंदमाहात्म्यमानंदरससुंदरम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000621020, "chapter_id": 20621, "verse_number": "५-८०-२१", "content_sanskrit": "शृणुयात्कीर्त्तयेन्नित्यं स निर्मुक्तो न संशयः ।\nमासकृत्यं प्रवक्ष्यामि विष्णोः प्रीतिकरं परम्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000621021, "chapter_id": 20621, "verse_number": "५-८०-२२", "content_sanskrit": "ज्येष्ठे तु स्नापनं कुर्याच्छ्रीविष्णोर्यत्नतः शुचिः ।\nदैनंदिनं तु दुरितं पक्षमासर्त्तुवर्षजम्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000621022, "chapter_id": 20621, "verse_number": "५-८०-२३", "content_sanskrit": "ब्रह्महत्यासहस्राणि ज्ञाता ज्ञातकृतानि च ।\nस्वर्णस्तेयसुरापान गुरुतल्पायुतानि च॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000621023, "chapter_id": 20621, "verse_number": "५-८०-२४", "content_sanskrit": "कोटिकोटिसहस्राणि ह्युपपापानि यानि च ।\nसर्वाण्यथ प्रणश्यंति पौर्णमास्यां तु वासरे॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000621024, "chapter_id": 20621, "verse_number": "५-८०-२५", "content_sanskrit": "आसिंचेदच्युतं मूर्ध्नि तदैतत्कलशोदकम् ।\nपुरुषसूक्तेन मंत्रेण पावमानीभिरेव च॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000621025, "chapter_id": 20621, "verse_number": "५-८०-२६", "content_sanskrit": "नालिकेरोदकेनाथ तथा तालफलांबुना ।\nरत्नोदकेन गंधेन तथा पुष्पोदकेन च॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000621026, "chapter_id": 20621, "verse_number": "५-८०-२७", "content_sanskrit": "पंचोपचारैराराध्य यथाविभवविस्तरैः ।\nघं घंटायै नम इति घंटावाद्यं प्रदापयेत्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000621027, "chapter_id": 20621, "verse_number": "५-८०-२८", "content_sanskrit": "पतितस्य महाध्वानन्यस्तपातकसंचये ।\nपाहि मां पापिनं घोरसंसारार्णवपातिनम्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000621028, "chapter_id": 20621, "verse_number": "५-८०-२९", "content_sanskrit": "य एवं कुरुते विद्वान्ब्राह्मणः श्रोत्रियः शुचिः ।\nसर्वपापैः प्रमुच्येत विष्णुलोकं स गच्छति॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000621029, "chapter_id": 20621, "verse_number": "५-८०-३०", "content_sanskrit": "आषाढशुक्लैकादश्यां कुर्यात्स्वापमहोत्सवम् ।\nआषाढे च रथं कुर्याच्छ्रावणे श्रवणाविधिम्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000621030, "chapter_id": 20621, "verse_number": "५-८०-३१", "content_sanskrit": "भाद्रे च जन्मदिवस उपवासपरो भवेत् ।\nप्रसुप्तस्य परीवर्तमाश्विने मासि कारयेत्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000621031, "chapter_id": 20621, "verse_number": "५-८०-३२", "content_sanskrit": "उत्थानं श्रीहरेः कुर्यादन्यथा विष्णुद्रोहकृत् ।\nशुभे चैवाश्विने मासि महामायां च पूजयेत्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000621032, "chapter_id": 20621, "verse_number": "५-८०-३३", "content_sanskrit": "सौवर्णीं राजतीं वापि विष्णुरूपां बलिं विना ।\nहिंसाद्वेषौ न कर्तव्यौ धर्मात्मा विष्णुपूजकः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000621033, "chapter_id": 20621, "verse_number": "५-८०-३४", "content_sanskrit": "कार्तिके पुष्यमासे च कामतः पुण्यमाचरेत् ।\nदामोदराय दीपं च प्रांशुस्थाने प्रदापयेत्॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000621034, "chapter_id": 20621, "verse_number": "५-८०-३५", "content_sanskrit": "सप्तवर्तिप्रमाणेन दीपः स्याच्चतुरंगुलः ।\nपक्षांते च प्रकर्तव्या दीपमालावलि शुभा॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000621035, "chapter_id": 20621, "verse_number": "५-८०-३६", "content_sanskrit": "मार्गशीर्षे सिते पक्षे षष्ठ्यां च सितवस्त्रकैः ।\nपूजयेज्जगदीशं च ब्रह्माणं च विशेषतः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000621036, "chapter_id": 20621, "verse_number": "५-८०-३७", "content_sanskrit": "पौषे पुष्पाभिषेकं च वर्जयेच्चंदनं श्लथम् ।\nसंक्रांत्यां माघमासे च साधिवासित तंडुलात्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000621037, "chapter_id": 20621, "verse_number": "५-८०-३८", "content_sanskrit": "नैवेद्यं विष्णवे दद्यादिमं मंत्रमुदीरयेत् ।\nब्राह्मणान्भोजयेद्भक्त्या देवदेवपुरः स्थितान्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000621038, "chapter_id": 20621, "verse_number": "५-८०-३९", "content_sanskrit": "अभ्यर्च्य भगवद्भक्तान्द्विजांश्च भगवद्धिया ।\nएकस्मिन्भोजिते भक्ते कोटिर्भवति भोजिता॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000621039, "chapter_id": 20621, "verse_number": "५-८०-४०", "content_sanskrit": "विप्रभोजनमात्रेण व्यंगं सांगं ध्रुवं भवेत् ।\nपंचम्यां शुक्लपक्षे तु स्नापयित्वा च केशवम्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000621040, "chapter_id": 20621, "verse_number": "५-८०-४१", "content_sanskrit": "पूजयित्वा विधानेन चूतपल्लवसंयुतैः ।\nफलचूर्णैश्च विविधैर्वासितैः पटसाधितैः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000621041, "chapter_id": 20621, "verse_number": "५-८०-४२", "content_sanskrit": "काननं रमणीयं च प्रदीप्तं दीपदीपितम् ।\nद्राक्षेक्षु रंभा जंबीर नागरंगं च पूगकम्॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000621042, "chapter_id": 20621, "verse_number": "५-८०-४३", "content_sanskrit": "नालिकेरं च धात्रीं च पनसं च हरीतकीम् ।\nअन्यैश्च वृक्षखंडैश्च सर्वर्तुकुसुमान्वितैः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000621043, "chapter_id": 20621, "verse_number": "५-८०-४४", "content_sanskrit": "अन्यैश्च विविधैश्चैव फलपुष्पसमन्वितैः ।\nवितानैः कुसुमोद्दामैर्वारिपूर्णघटैस्तथा॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000621044, "chapter_id": 20621, "verse_number": "५-८०-४५", "content_sanskrit": "चूतशाखोपशाखाभिः शोभितं छत्रचामरैः ।\nजयकृष्णेति संस्मृत्य प्रदक्षिणपुरस्सरम्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000621045, "chapter_id": 20621, "verse_number": "५-८०-४६", "content_sanskrit": "विशेषतः कलियुगे दोलोत्सवो विधीयते ।\nफाल्गुने च चतुर्दश्यामष्टमे यामसंज्ञके॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000621046, "chapter_id": 20621, "verse_number": "५-८०-४७", "content_sanskrit": "अथवा पौर्णमास्यां तु प्रतिपत्संधिसंज्ञके ।\nपूजयेद्विधिवद्भक्त्या फल्गुचूर्णैश्चतुर्विधैः॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000621047, "chapter_id": 20621, "verse_number": "५-८०-४८", "content_sanskrit": "सितरक्तैर्गौरपीतैः कर्पूरादि विमिश्रितैः ।\nहरिद्रारागयोगाच्च रंगरूपैर्मनोहरैः॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000621048, "chapter_id": 20621, "verse_number": "५-८०-४९", "content_sanskrit": "अन्यैर्वा रंगरूपैश्च प्रीणयेत्परमेश्वरम् ।\nएकादश्यां समारभ्य पंचम्यां तं समापयेत्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000621049, "chapter_id": 20621, "verse_number": "५-८०-५०", "content_sanskrit": "पंचाहानि त्र्यहानि वा दोलोत्सवो विधीयते ।\nदक्षिणाभिमुखं कृष्णं दोलमानं सकृन्नराः॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000621050, "chapter_id": 20621, "verse_number": "५-८०-५१", "content_sanskrit": "दृष्ट्वापराधनिचयैर्मुक्तास्ते नात्र संशयः ।\nनिक्षिप्य जलपात्रे च मासि माधवसंज्ञके॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000621051, "chapter_id": 20621, "verse_number": "५-८०-५२", "content_sanskrit": "सौवर्णपात्रे रौप्ये वा ताम्रे वाप्यथ मृण्मये ।\nतोयस्थं योऽर्चयेद्देवं शालग्रामसमुद्भवम्॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000621052, "chapter_id": 20621, "verse_number": "५-८०-५३", "content_sanskrit": "प्रतिमां वा महाभागे तस्य पुण्यं न गण्यते ।\nदमनारोपणं कृत्वा श्रीविष्णौ च समर्पयेत्॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000621053, "chapter_id": 20621, "verse_number": "५-८०-५४", "content_sanskrit": "वैशाखे श्रावणे भाद्रे कर्तव्यं वा तदर्पणम् ।\nपूर्वेपूर्वे तु वातस्थे दमनादिषु कर्मसु॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000621054, "chapter_id": 20621, "verse_number": "५-८०-५५", "content_sanskrit": "प्रकर्तव्यं विधानेन अन्यथा निष्फलं भवेत् ।\nवैशाखे च तृतीयायां जलमध्ये विशेषतः॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000621055, "chapter_id": 20621, "verse_number": "५-८०-५६", "content_sanskrit": "अथवा मंडले कुर्यान्मंडपे वा बृहद्वने ।\nसुगंधचंदनेनांगं सुपुष्टं च दिनेदिने॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000621056, "chapter_id": 20621, "verse_number": "५-८०-५७", "content_sanskrit": "यथाप्रयत्नतः कुर्यात्कृशांगस्येव पुष्टिदम् ।\nचंदनागुरु ह्रीबेर कृष्णकुंकुम रोचना॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000621057, "chapter_id": 20621, "verse_number": "५-८०-५८", "content_sanskrit": "जटामांसी मुरा चैव विष्णोर्गंधाष्टकं विदुः ।\nतैस्तैर्गंधयुतैश्चापि विष्णोरंगानि लेपयेत्॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000621058, "chapter_id": 20621, "verse_number": "५-८०-५९", "content_sanskrit": "धृष्टं च तुलसीकाष्ठं कर्पूरागुरुयोगतः ।\nअथवा केसरैर्योज्यं हरिचंदनमुच्यते॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000621059, "chapter_id": 20621, "verse_number": "५-८०-६०", "content_sanskrit": "यात्राकाले च ये कृष्णं भक्त्या पश्यंति मानवाः ।\nन तेषां पुनरावृत्तिः कल्पकोटिशतैरपि॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000621060, "chapter_id": 20621, "verse_number": "५-८०-६१", "content_sanskrit": "सुगंधमिश्रितैस्तोयैर्देवदेवं गलंति ये ।\nअथवा पुष्पमध्ये तु स्थापयेज्जगदीश्वरम्॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000621061, "chapter_id": 20621, "verse_number": "५-८०-६२", "content_sanskrit": "वृंदावनं तत्र गत्वा उपस्कृत्य फलानि च ।\nविष्णुभक्तेन योग्येन भोजयेत्तदशेषतः॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000621062, "chapter_id": 20621, "verse_number": "५-८०-६३", "content_sanskrit": "नारिकेलफलं बीजकोशं चोद्धृत्य दापयेत् ।\nघोंटाफलं च पनसं कोशमुद्धृत्य दापयेत्॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000621063, "chapter_id": 20621, "verse_number": "५-८०-६४", "content_sanskrit": "दध्ना विमिश्रितं चान्नं घृतेनाप्लुत्य दापयेत् ।\nपाचितं पिष्टकं पूपमष्टादशघृतेन च॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000621064, "chapter_id": 20621, "verse_number": "५-८०-६५", "content_sanskrit": "तैलैश्च तिलसंमिश्रैः फलं पक्वं प्रदापयेत् ।\nयद्यदेवात्मनः प्रीतं तत्तदीशाय दापयेत्॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000621065, "chapter_id": 20621, "verse_number": "५-८०-६६", "content_sanskrit": "दत्वा नैवेद्यवस्त्रादि नाददीत कथंचन ।\nत्यक्तं च विष्णुमुद्दिश्य तद्भक्तेभ्यो विशेषतः॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000621066, "chapter_id": 20621, "verse_number": "५-८०-६७", "content_sanskrit": "इति ते कथितं किंचित्समासेन महेश्वरि ।\nगोपनीयं प्रयत्नेन स्वयोनिरिव पार्वति॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000621067, "chapter_id": 20621, "verse_number": "५-८०-६८", "content_sanskrit": "श्रीकृष्णरूपगुणवर्णन शास्त्रवर्गबोधाधिकार इह चेदलमन्यपाठैः ।\nतत्प्रेमभावरसभक्तिविलास नामहारेषु चेत्खलु मनः किमु कामिनीभिः॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000621068, "chapter_id": 20621, "verse_number": "५-८०-६९", "content_sanskrit": "तच्चेतसा प्रभजतां व्रजबालकेंद्रं वृंदावनक्षितितलं यमुनाजलं च ।\nतल्लोकनाथपदपंकजधूलिमिश्रलिप्तं वपुः किल वृथागरुचंदनाद्यैः॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]