[{"id": 2110388, "chapter_id": 3388, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2110389, "chapter_id": 3388, "verse_number": "१", "content_sanskrit": "कृतविद्ये कचे प्राप्ते हृष्टरूपा दिवौकसः ।\nकचादधीत्य तां विद्यां कृतार्था भरतर्षभ\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2110390, "chapter_id": 3388, "verse_number": "२", "content_sanskrit": "ततो देवाः समागम्य शतक्रतुमथाब्रुवन् ।\nकालस्ते विक्रमस्यायं जहि शत्रून् पुरन्दर\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2110391, "chapter_id": 3388, "verse_number": "३", "content_sanskrit": "एवमुक्तस्तु भगवान् सह तैस्त्रिदिवेश्वरैः ।\nतथेत्युक्त्वाऽभिचक्राम सोऽपश्यत वने स्त्रियः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2110392, "chapter_id": 3388, "verse_number": "४", "content_sanskrit": "क्रीडन्तीनां कन्यकानामारामे नन्दनोपमे ।\nवायुभूत्वा स वस्त्राणि सर्वाण्येव व्यमिश्रयत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2110393, "chapter_id": 3388, "verse_number": "५", "content_sanskrit": "ततो जलात् समुत्तीर्य ताः कन्याः सहितास्तदा ।\nवस्त्राणि जगृहुस्तानि यथाऽऽसन्नान्यनेकशः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2110394, "chapter_id": 3388, "verse_number": "६", "content_sanskrit": "तत्र वासो देवयान्याः शर्मिष्ठा जगृहे तदा ।\nव्यतिमिश्रमजानन्ती दुहिता वृषपर्वणः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2110395, "chapter_id": 3388, "verse_number": "७", "content_sanskrit": "ततस्तयोर्मिथस्तत्र विरोधः समजायत ।\nदेययान्याश्च राजेन्द्र शर्मिष्ठायाश्च तत्कृते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2110396, "chapter_id": 3388, "verse_number": "", "content_sanskrit": "देवयानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2110397, "chapter_id": 3388, "verse_number": "८", "content_sanskrit": "कस्माद् गृह्णासि मे वस्त्रं शिष्यभूता ममासुरि ।\nसमुदाचारहीनाया न ते श्रेयो भविष्यति\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2110398, "chapter_id": 3388, "verse_number": "", "content_sanskrit": "शर्मिष्ठा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2110399, "chapter_id": 3388, "verse_number": "९", "content_sanskrit": "आसीनं च शयानं च पिता ते पितरं मम ।\nस्तौति वन्दति चाभीक्ष्णं नीचैः स्थित्वा विनीतवत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2110400, "chapter_id": 3388, "verse_number": "१०", "content_sanskrit": "स्तुवतो दुहिता त्वं वै याचतः प्रतिगृह्णतः ।\nसुताऽहं स्तूयमानस्य ददतोऽप्रतिगृह्णतः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2110401, "chapter_id": 3388, "verse_number": "११", "content_sanskrit": "आधून्वस्व विधून्वस्व द्रुह्य कुप्य च या किल ।\nअनायुधा सायुधाया रिक्ता क्षुभ्यसि भिक्षुकि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2110402, "chapter_id": 3388, "verse_number": "१२", "content_sanskrit": "लप्स्यसे प्रतियोद्धारं न हि त्वां गणयाम्यहम् ।\nप्रतिकूलं वदसि चेदितः प्रभृति याचकि ।\nआकृष्य मम दासीभिः प्रस्थास्यामि बहिर्बहिः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2110403, "chapter_id": 3388, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2110404, "chapter_id": 3388, "verse_number": "१३", "content_sanskrit": "सा मूर्च्छिता देवयानीं गत्वा हृत्वा च वाससी ।\nशर्मिष्ठा प्राक्षिपत् कूपे ततः स्वं पुरमाविशत् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2110405, "chapter_id": 3388, "verse_number": "१४", "content_sanskrit": "हतेयमिति विज्ञाय शर्मिष्ठा पापनिश्चया ।\nअनवेक्ष्य ययौ वेश्म क्रोधवेगपरायणा \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2110406, "chapter_id": 3388, "verse_number": "१५", "content_sanskrit": "प्रविश्य स्वगृहं स्वस्था धर्ममासुरमाश्रिता ।\nअथ तं देशमागच्छद् ययातिर्नहुषात्मजः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2110407, "chapter_id": 3388, "verse_number": "१६", "content_sanskrit": "श्रान्तयुग्यहयः श्रीमान् मृगलिप्सुः पिपासितः ।\nस नाहुषः प्रेक्षमाण उदपानं गतोदकम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2110408, "chapter_id": 3388, "verse_number": "१७", "content_sanskrit": "ददर्श कन्यां रूपेण दीप्तामग्निशिखामिव ।\nतां दृष्ट्वा रूपसम्पन्नां सर्वालङ्कारभूषिताम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2110409, "chapter_id": 3388, "verse_number": "१८", "content_sanskrit": "सर्वलक्षणसम्पन्नामपृच्छत् स नराधिपः ।\nतामपृच्छत् स दृष्ट्वैव कन्याममरवर्णिनीम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2110410, "chapter_id": 3388, "verse_number": "१९", "content_sanskrit": "सान्त्वयित्वा नरश्रेष्ठ साम्ना परमवल्गुना ।\nका त्वं ताम्रनखी श्यामा सुमृष्टमणिकुण्डला\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2110411, "chapter_id": 3388, "verse_number": "२०", "content_sanskrit": "दीर्घं ध्यायसि चात्यर्थं कस्माच्छ्वससि चातुरा ।\nकथं च पतिता ह्यस्मिन् कूपे वीरुत्तृणावृते ।\nदुहिता चैव कस्य त्वं सर्वं वद सुमध्यमे\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2110412, "chapter_id": 3388, "verse_number": "", "content_sanskrit": "देवयानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2110413, "chapter_id": 3388, "verse_number": "२१", "content_sanskrit": "योऽसौ देवैर्हतान् दैत्यानुत्थापयति विद्यया ।\nतस्य शुक्रस्य कन्याऽहमिदमासादितं मया\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2110414, "chapter_id": 3388, "verse_number": "२२", "content_sanskrit": "पृच्छसे मां कस्त्वमसि रूपवीर्यबलान्वितः ।\nब्रूह्यत्रागमनं किं वा श्रोतुमिच्छामि तत्वतः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2110415, "chapter_id": 3388, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2110416, "chapter_id": 3388, "verse_number": "२३", "content_sanskrit": "ययातिर्नाहुषोऽहं तु श्रान्तोऽद्य मृगकाङ्क्षया ।\nअत्राहमागतो भद्रे दृष्टवानस्मि त्वामिह\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2110417, "chapter_id": 3388, "verse_number": "", "content_sanskrit": "देवयानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2110418, "chapter_id": 3388, "verse_number": "२४", "content_sanskrit": "एष मे दक्षिणो राजन् पाणिस्ताम्रनखाङ्गुलिः ।\nसमुद्धर गृहीत्वा तु कुलीनस्त्वं हि मे मतः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2110419, "chapter_id": 3388, "verse_number": "२५", "content_sanskrit": "भूयोऽपि त्वामुपागमे वीर्यवन्तं मनस्विनम् ।\nअस्मान्मां संशयाद् राजन् मोक्षयाऽऽशु विशांपते\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2110420, "chapter_id": 3388, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2110421, "chapter_id": 3388, "verse_number": "२६", "content_sanskrit": "स्त्री चैषा ब्राह्मणी चेति विज्ञायैनां स नाहुषः ।\nगृहीत्वा दक्षिणं पाणिमुज्जहार ततोऽवटात्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2110422, "chapter_id": 3388, "verse_number": "२७", "content_sanskrit": "उद्धृत्य चैनां तरसा तस्मात् कूपान्नराधिपः ।\nगच्छ भद्रे यथाकामं न भयं विद्यते तव \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2110423, "chapter_id": 3388, "verse_number": "२८", "content_sanskrit": "इत्युच्यमाना नृपतिं देवयानीदमुत्तरम् ।\nउवाच मामुपादाय गच्छ शीघ्रं प्रियोऽसि मे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2110424, "chapter_id": 3388, "verse_number": "२९", "content_sanskrit": "गृहीताऽहं त्वया पाणौ तस्माद् भर्ता भविष्यसि ।\nइत्येवमुक्तो नृपतिराह क्षत्रकुलोद्भवः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2110425, "chapter_id": 3388, "verse_number": "३०", "content_sanskrit": "त्वं भद्रे ब्राह्मणी तस्मान्मया नार्हसि सङ्गमम् ।\nसर्वलोकगुरुः काव्यस्त्वं तस्य दुहिता हि वै ।\nतस्मादपि भयं मेऽद्य तस्मात् कल्याणि नार्हसि\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2110426, "chapter_id": 3388, "verse_number": "", "content_sanskrit": "देवयानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2110427, "chapter_id": 3388, "verse_number": "३१", "content_sanskrit": "यदि मद्वचनादद्य मां नेच्छसि नराधिप ।\nत्वामेव वरये पित्रा पश्चाज्ज्ञास्यसि गच्छ हि\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2110428, "chapter_id": 3388, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2110429, "chapter_id": 3388, "verse_number": "३२", "content_sanskrit": "आमन्त्रयित्वा सुश्रोणीं ययातिः स्वपुरं ययौ ।\nनृपे तु गतमात्रे सा देवयानी शुचिस्मिता \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2110430, "chapter_id": 3388, "verse_number": "३३", "content_sanskrit": "क्वचिदार्ता च रुदती वृक्षमाश्रित्य तिष्ठति ।\nततश्चिरायामानायां दुहितर्याह भार्गवः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2110431, "chapter_id": 3388, "verse_number": "३४", "content_sanskrit": "धात्रि त्वमानय क्षिप्रं देवयानीं सुमध्यमाम् ।\nइत्युक्तमात्रे सा धात्री त्वरिता ह्वयितुं गता \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2110432, "chapter_id": 3388, "verse_number": "३५", "content_sanskrit": "यत्र यत्र सखीभिः सा गता पदममार्गत ।\nसा ददर्श तथा दीनां श्रमार्तां रुदतीं स्थिताम् \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2110433, "chapter_id": 3388, "verse_number": "", "content_sanskrit": "धात्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2110434, "chapter_id": 3388, "verse_number": "३६", "content_sanskrit": "वृत्तं ते किमिदं भद्रे शीघ्रं वद पिताऽऽह्वयत् ।\nधात्रीमाह समाहूय शर्मिष्ठाव्रजिनं कृतम् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2110435, "chapter_id": 3388, "verse_number": "३७", "content_sanskrit": "त्वरिता घूर्णिके गच्छ सर्वमाचक्ष्व मे पितुः ।\nनहीदानीं प्रवेक्ष्यामि नगरं वृषपर्वणः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2110436, "chapter_id": 3388, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2110437, "chapter_id": 3388, "verse_number": "३८", "content_sanskrit": "धात्री प्रत्वरितं गत्वा घूर्णिकाऽसुरमन्दिरम् ।\nदृष्ट्वा काव्यमुवाचेदं सम्भ्रमाविष्टचेतना\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2110438, "chapter_id": 3388, "verse_number": "३९", "content_sanskrit": "आचष्ट ते महाप्राज्ञ देवयानी वने गता ।\nशर्मिष्ठया महाभाग दुहित्रा वृषपर्वणः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2110439, "chapter_id": 3388, "verse_number": "४०", "content_sanskrit": "श्रुत्वा दुहितरं काव्यो हतां शर्मिष्ठया ततः ।\nत्वरया निर्ययौ दुःखान्मार्गमाणः सुतां वने \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2110440, "chapter_id": 3388, "verse_number": "४२", "content_sanskrit": "दृष्ट्वा दुहितरं काव्यो देवयानीं तथागताम् ।\nवाहुभ्यां सम्परिष्वज्य दुःखितो वाक्यमब्रवीत् \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2110441, "chapter_id": 3388, "verse_number": "४३", "content_sanskrit": "आत्मदोषैर्हि गच्छन्ति सर्वे दुःखसुखे जनाः ।\nपुरा दुश्चरितं मन्ये तस्मात् ते निष्कृतिः कृता\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2110442, "chapter_id": 3388, "verse_number": "", "content_sanskrit": "देवयानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2110443, "chapter_id": 3388, "verse_number": "४४", "content_sanskrit": "दुष्कृतिर्वास्तु वा मास्तु शृणुष्व वचनं मम ।\nशर्मिष्ठया दुरुक्तास्मि दुहित्रा वृषपर्वणः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2110444, "chapter_id": 3388, "verse_number": "४५", "content_sanskrit": "सत्यं किलैतत् सा प्राह दैत्यानामसि गायनः ।\nएवं मामवदत् क्रोधाद् बहुशो वार्षपर्वणी\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2110445, "chapter_id": 3388, "verse_number": "४६", "content_sanskrit": "वचनं तीक्ष्णपरुषं क्रोधरक्तेक्षणा भृशम् ।\nस्तुवतो दुहिता त्वं वै याचतः प्रतिगृह्नतः ।\nसुताऽहं स्तूयमानस्य ददतोऽप्रतिगृह्नतः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2110446, "chapter_id": 3388, "verse_number": "समाप्तिः", "content_sanskrit": "इति मामाह शर्मिष्ठा बहुशो वार्षपर्वणी ।\nक्रोधसंरक्तनयना दर्पपूर्णानना ततः \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2110447, "chapter_id": 3388, "verse_number": "४८", "content_sanskrit": "यद्यहं स्तुवतस्तात दुहिता प्रतिगृह्नतः ।\nप्रसादयिष्ये शर्मिष्ठामित्युक्ता हि सखी मया\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2110448, "chapter_id": 3388, "verse_number": "४९", "content_sanskrit": "उक्ताऽप्येवं भृशं क्रुद्धा मां गृह्य विजने वने ।\nकूपे प्रक्षेपयामास प्रक्षिप्यैव गृहं ययौ\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2110449, "chapter_id": 3388, "verse_number": "", "content_sanskrit": "शुक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2110450, "chapter_id": 3388, "verse_number": "५०", "content_sanskrit": "स्तुवतो दुहिता न त्वं वन्दिनः प्रतिगृह्नतः ।\nअस्तोतुः स्तूयमानस्य दुहिता देवयान्यसि\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2110451, "chapter_id": 3388, "verse_number": "५१", "content_sanskrit": "वृषपर्वा च तद् वेद शक्रो राजा च नाहुषः ।\nअचिन्त्यं ब्रह्म कल्याणि ऐश्वर्यं हि बलं मम\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2110452, "chapter_id": 3388, "verse_number": "५२", "content_sanskrit": "वृषपर्वा च तं वेद शक्रो राजा च नाहुषः ।\nअचिन्त्यं ब्रह्म कल्याणि नाहं गायी न वन्दिकः \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2110453, "chapter_id": 3388, "verse_number": "", "content_sanskrit": "॥ इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2110454, "chapter_id": 3388, "verse_number": "६७", "content_sanskrit": "आदिपर्वणि सप्तषष्टितमोऽध्यायः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2110455, "chapter_id": 3388, "verse_number": "१५", "content_sanskrit": "॥ सम्भवपर्वणि पञ्चदशोऽध्यायः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]