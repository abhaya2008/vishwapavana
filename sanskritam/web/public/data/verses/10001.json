[{"id": 6000001000, "chapter_id": 10001, "verse_number": null, "content_sanskrit": "॥ श्रीमद्धनुमद्भीममध्वान्तर्गतरामकृष्णवेदव्यासात्मकलक्ष्मीहयग्रीवाय नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000001001, "chapter_id": 10001, "verse_number": null, "content_sanskrit": "भगवद्बादरायणप्रणीतं श्रीमद्भागवतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 6000001002, "chapter_id": 10001, "verse_number": null, "content_sanskrit": "अथ प्रथमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 6000001003, "chapter_id": 10001, "verse_number": null, "content_sanskrit": "ओं नमो भगवते वासुदेवाय", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_001/BhP_01.001.001.m4a", "display_order": 4}, {"id": 6000001004, "chapter_id": 10001, "verse_number": "१-१-१", "content_sanskrit": "जन्माद्यस्य यतोऽन्वयादितरतश्‍चार्थेष्वभिज्ञः स्वराट्\nतेने ब्रह्म हृदा य आदिकवये मुह्यन्ति यं सूरयः।\nतेजोवारिमृदां यथा विनिमयो यत्र त्रिसर्गो मृषा\nधाम्ना स्वेन सदा निरस्तकुहकं सत्यं परं धीमहि॥ १/१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_001/BhP_01.001.002.m4a", "display_order": 5, "topics": [{"text": "भगवता श्रीवेदव्यासेन श्रीमद्भागवतग्रन्थारम्भे मङ्गलाचरणम्", "range": "१–३"}]}, {"id": 6000001005, "chapter_id": 10001, "verse_number": "१-१-२", "content_sanskrit": "धर्मः प्रोज्झितकैतवोऽत्र परमो निर्मत्सराणां सतां\nवेद्यं वास्तवमत्र वस्तु शिवदं तापत्रयोन्मूलनम्।\nश्रीमद्भागवते महामुनिकृते किं वा परैरीश्‍वरः\nसद्यो हृद्यवरुध्यतेऽत्र कृतिभिः शुश्रूषुभिस्तत्क्षणात्॥ १/१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_001/BhP_01.001.003.m4a", "display_order": 6}, {"id": 6000001006, "chapter_id": 10001, "verse_number": "१-१-३", "content_sanskrit": "निगमकल्पतरोर्गलितं फलं शुकमुखादमृतद्रवसंयुतम्।\nपिबत भागवतं रसमालयं मुहुरहो रसिका भुवि भावुकाः॥ १/१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_001/BhP_01.001.004.m4a", "display_order": 7}, {"id": 6000001007, "chapter_id": 10001, "verse_number": "१-१-४", "content_sanskrit": "नैमिषेऽनिमिषक्षेत्रे ऋषयः शौनकादयः।\nसत्रं स्वर्गाय लोकाय सहस्रसममासत॥ १/१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_001/BhP_01.001.005.m4a", "display_order": 8, "topics": [{"text": "नैमिषारण्ये शौनकाद्यृषिभिः सूतपौराणिकं प्रति षट्‌प्रश्नकरणम्", "range": "४–८"}]}, {"id": 6000001008, "chapter_id": 10001, "verse_number": "१-१-५", "content_sanskrit": "त एकदा तु मुनयः प्रातर्हुतहुताशनाः।\nसत्कृतं सूतमासीनं पप्रच्छुरिदमादृताः॥ १/१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_001/BhP_01.001.006.m4a", "display_order": 9}, {"id": 6000001009, "chapter_id": 10001, "verse_number": null, "content_sanskrit": "ऋषय ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_001/BhP_01.001.007.m4a", "display_order": 10}, {"id": 6000001010, "chapter_id": 10001, "verse_number": "१-१-६", "content_sanskrit": "त्वया खलु पुराणानि सेतिहासानि चानघ।\nआख्यातान्यप्यधीतानि धर्मशास्‍त्राणि तान्युत॥ १/१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_001/BhP_01.001.008.m4a", "display_order": 11}, {"id": 6000001011, "chapter_id": 10001, "verse_number": "१-१-७", "content_sanskrit": "यानि वेद विदां श्रेष्‍ठो भगवान् बादरायणः।\nअन्ये च मुनयः सूत परावरविदो विदुः॥ १/१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_001/BhP_01.001.009.m4a", "display_order": 12}, {"id": 6000001012, "chapter_id": 10001, "verse_number": "१-१-८", "content_sanskrit": "वेत्थ त्वं सौम्य तत्सर्वं तत्त्वतस्तदनुग्रहात्।\nब्रूयुः स्निग्धस्य शिष्यस्य गुरवो गुह्यमप्युत॥ १/१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_001/BhP_01.001.010.m4a", "display_order": 13}, {"id": 6000001013, "chapter_id": 10001, "verse_number": "१-१-९", "content_sanskrit": "तत्र तत्राञ्जसाऽयुष्मान् भवता यद्विनिश्‍चितम्।\nपुंसामेकान्ततः श्रेयस्तन्नः शंसितुमर्हसि॥ १/१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_001/BhP_01.001.011.m4a", "display_order": 14, "topics": [{"text": "ते च- ‘पुंसामेकान्ततः श्रेयः किम्?’ इति प्रथमः प्रश्नः", "range": "९"}]}, {"id": 6000001014, "chapter_id": 10001, "verse_number": "१-१-१०", "content_sanskrit": "प्रायेणाल्पायुषो मर्त्याः कलावस्मिन्युगे जनाः।\nमन्दाः सुमन्दमतयो मन्दभाग्या ह्युपद्रुताः॥ १/१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_001/BhP_01.001.012.m4a", "display_order": 15, "topics": [{"text": "‘सर्वशास्‍त्रार्थसारः कः?’ इति द्वितीयः", "range": "१०–११"}]}, {"id": 6000001015, "chapter_id": 10001, "verse_number": "१-१-११", "content_sanskrit": "भूरीणि भूरिकर्माणि श्रोतव्यानि विभागशः। अतः साधोऽत्र यत्सारं समुद्धृत्य मनीषया।\nब्रूहि भद्राय भूतानां येनात्माऽऽशु प्रसीदति॥ १/१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_001/BhP_01.001.013.m4a", "display_order": 16}, {"id": 6000001016, "chapter_id": 10001, "verse_number": "१-१-१२", "content_sanskrit": "सूत जानासि भद्रं ते भगवान् सात्वतां पतिः।\nदेवक्यां वसुदेवस्य जातो यस्य चिकीर्षया॥ १/१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_001/BhP_01.001.014.m4a", "display_order": 17, "topics": [{"text": "‘भगवान् देवक्यां जातः किमकरोत्?’ इति तृतीयः", "range": "१२–१३"}]}, {"id": 6000001017, "chapter_id": 10001, "verse_number": "१-१-१३", "content_sanskrit": "तन्नः शुश्रूषमाणानामर्हस्यङ्गानुवर्णितुम्।\nयस्यावतारो भूतानां क्षेमाय विभवाय च॥ १/१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_001/BhP_01.001.015.m4a", "display_order": 18}, {"id": 6000001018, "chapter_id": 10001, "verse_number": "१-१-१४", "content_sanskrit": "आपन्नः संसृतिं घोरां यन्नाम विवशो गृणन्।\nततः सद्यो विमुच्येत यं बिभेति स्वयं भवः॥ १/१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_001/BhP_01.001.016.m4a", "display_order": 19, "topics": [{"text": "‘श्रीकृष्णस्य उदाराणि कर्माणि ब्रूहि’ इति चतुर्थः", "range": "१४–१७"}]}, {"id": 6000001019, "chapter_id": 10001, "verse_number": "१-१-१५", "content_sanskrit": "यत्पादसंश्रयाः सूत मुनयः प्रशमायनाः।\nसद्यः पुनन्त्युपस्पृष्‍टाः स्वर्धुनीवानुसेवया॥ १/१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_001/BhP_01.001.017.m4a", "display_order": 20}, {"id": 6000001020, "chapter_id": 10001, "verse_number": "१-१-१६", "content_sanskrit": "को वा भगवतस्तस्य पुण्यश्लोकेड्यकर्मणः।\nशुद्धिकामो न शृणुयाद्यशः कलिमलापहम्॥ १/१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_001/BhP_01.001.018.m4a", "display_order": 21}, {"id": 6000001021, "chapter_id": 10001, "verse_number": "१-१-१७", "content_sanskrit": "तस्य कर्माण्युदाराणि परिगीतानि सूरिभिः।\nब्रूहि नः श्रद्दधानानां लीलया दधतः कलाः॥ १/१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_001/BhP_01.001.019.m4a", "display_order": 22}, {"id": 6000001022, "chapter_id": 10001, "verse_number": "१-१-१८", "content_sanskrit": "अथाख्याहि हरेर्धीमन्नवतारकथाः शुभाः।\nलीला विदधतः स्वैरमीश्‍वरस्यात्ममायया॥ १/१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_001/BhP_01.001.020.m4a", "display_order": 23, "topics": [{"text": "भगवतो मत्स्याद्यवतारकथनप्रश्नः पञ्चमः", "range": "१८"}]}, {"id": 6000001023, "chapter_id": 10001, "verse_number": "१-१-१९", "content_sanskrit": "वयं तु न वितृप्याम उत्तमश्लोकविक्रमैः।\nयच्छृण्वतां रसज्ञानां स्वादु स्वादु पदे पदे॥ १/१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_001/BhP_01.001.021.m4a", "display_order": 24, "topics": [{"text": "‘धर्मः कं शरणं गतः?’ इति षष्‍ठः प्रश्नः", "range": "१९–२३"}]}, {"id": 6000001024, "chapter_id": 10001, "verse_number": "१-१-२०", "content_sanskrit": "कृतवान् किल वीर्याणि सह रामेण केशवः।\nअतिमर्त्यानि भगवान् गूढः कपटमानुषः॥ १/१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_001/BhP_01.001.022.m4a", "display_order": 25}, {"id": 6000001025, "chapter_id": 10001, "verse_number": "१-१-२१", "content_sanskrit": "कलिमागतमाज्ञाय क्षेत्रेऽस्मिन् वैष्णवे वयम्।\nआसीना दीर्घसत्रेण कथायां सक्षणा हरेः॥ १/१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_001/BhP_01.001.023.m4a", "display_order": 26}, {"id": 6000001026, "chapter_id": 10001, "verse_number": "१-१-२२", "content_sanskrit": "त्वं नः सन्दर्शितो धात्रा दुस्तरं निस्तितीर्षताम्।\nकलिं सत्त्वहरं पुंसां कर्णधार इवार्णवम्॥ १/१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_001/BhP_01.001.024.m4a", "display_order": 27}, {"id": 6000001027, "chapter_id": 10001, "verse_number": "१-१-२३", "content_sanskrit": "ब्रूहि योगेश्‍वरे कृष्णे ब्रह्मण्ये धर्मकर्मणि।\nस्वां काष्‍ठामधुनोपेते धर्मः कं शरणं गतः॥ १/१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_001/BhP_01.001.025.m4a", "display_order": 28}, {"id": 6000001028, "chapter_id": 10001, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां प्रथमस्कन्धे प्रथमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]