[{"id": 2096444, "chapter_id": 3062, "verse_number": "१३-१९२-१", "content_sanskrit": "[लोमश उवाच।\nपरदारेषु ये सक्ता अकृत्वा दारसङ्ग्रहम्।\nनिराशाः पितरस्तेषां श्राद्धकाले भवन्ति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096445, "chapter_id": 3062, "verse_number": "१३-१९२-२", "content_sanskrit": "परदाररतिर्यश्च यश्च वन्ध्यामुपासते।\nब्रह्मस्वं हरते यश्च समदोषा भवन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096446, "chapter_id": 3062, "verse_number": "१३-१९२-३", "content_sanskrit": "असम्भाष्या भवन्त्येते पितॄणां नात्र संशयः।\nदेवताः पितरश्चैषां नाभिनन्दन्ति तद्धविः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096447, "chapter_id": 3062, "verse_number": "१३-१९२-४", "content_sanskrit": "तस्मात्परस्य वै दारांस्त्यजेद्वन्ध्यां च योषितम्।\nब्रह्मस्वं हि न हर्तव्यमात्मनो हितमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096448, "chapter_id": 3062, "verse_number": "१३-१९२-५", "content_sanskrit": "श्रूयतां चापरं गुह्यं रहस्यं धर्मसंहितम्।\nश्रद्दधानेन कर्तव्यं गुरुणां वचनं सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096449, "chapter_id": 3062, "verse_number": "१३-१९२-६", "content_sanskrit": "द्वादश्यां पौर्णमास्यां च मासिमासि घृताक्षतम्।\nब्राह्मणेभ्यः प्रयच्छेत तस्य पुण्यं निबोधत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096450, "chapter_id": 3062, "verse_number": "१३-१९२-७", "content_sanskrit": "सोमश्च वर्धते तेन समुद्रश्च महोदधिः।\nअश्वमेधचतुर्भागं फलं सृजति वासवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096451, "chapter_id": 3062, "verse_number": "१३-१९२-८", "content_sanskrit": "दानेनैतेन तेजस्वी वीर्यवांश्च भवेन्नरः।\nप्रीतश्च भगवान्सोम इष्टान्कामान्प्रयच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096452, "chapter_id": 3062, "verse_number": "१३-१९२-९", "content_sanskrit": "श्रूयतां चापरो धर्मः सरहस्यो महाफलः।\nइदं कलियुगं प्राप्य मनुष्याणां सुखावहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096453, "chapter_id": 3062, "verse_number": "१३-१९२-१०", "content_sanskrit": "कल्यमुत्थाय यो मर्त्यः स्नातः शुक्लेन वाससा।\nतिलपात्रं प्रयच्छेत ब्राह्मणेभ्यः समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2096454, "chapter_id": 3062, "verse_number": "१३-१९२-११", "content_sanskrit": "तिलोदकं च यो दद्यात्पितॄणां मधुना सह।\nदीपकं कृसंर चैव श्रूयतां तस्य यत्फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2096455, "chapter_id": 3062, "verse_number": "१३-१९२-१२", "content_sanskrit": "तिलपात्रे फलं प्राह भगवान्पाकशांसनः।\nगोप्रदानं च यः कुर्याद्भूमिदानं च शाश्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2096456, "chapter_id": 3062, "verse_number": "१३-१९२-१३", "content_sanskrit": "अग्निष्टोमं च यो यज्ञं यजेत बहुदक्षिणम्।\nतिलपात्रं सहैतेन समं मन्यन्ति देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2096457, "chapter_id": 3062, "verse_number": "१३-१९२-१४", "content_sanskrit": "तिलोदकं सदा श्राद्धे मन्यन्ते पितरोऽक्षयम्।\nदीपे च कृसरे चैव तुष्यन्तेऽस्य पितामहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2096458, "chapter_id": 3062, "verse_number": "१३-१९२-१५", "content_sanskrit": "स्वर्गे च पितृलोके च पितृदेवाभिपूजितम्।\nएवमेतन्मयोद्दिष्टपिदृष्टं पुरातनम्॥] ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2096459, "chapter_id": 3062, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि द्विनवत्यधिकशततमोऽध्यायः॥ १९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]