[{"id": 2213032, "chapter_id": 5545, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2213033, "chapter_id": 5545, "verse_number": "१", "content_sanskrit": "ततः प्रासादहर्म्येषु वसुधायां च पार्थिव ।\nस्त्रीणां च पुरुषाणां च सुमहान् निःस्वनोऽभवत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2213034, "chapter_id": 5545, "verse_number": "२", "content_sanskrit": "स राजा राजमार्गेण नृनारीसङ्कुलेन च ।\nकथञ्चिन्निर्ययौ धीमान् वेपमानः कृताञ्जलिः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2213035, "chapter_id": 5545, "verse_number": "३", "content_sanskrit": "स वर्धमानद्वारेण निर्ययौ गजसाह्वयात् ।\nविसर्जयामास तदा तं जनौघं मुहुर्मुहुः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2213036, "chapter_id": 5545, "verse_number": "४", "content_sanskrit": "राज्ञा सह वनं गन्तुं विदुरो धृतनिश्चयः ।\nसञ्जयश्च महामात्रः सूतो गावल्गणिस्तथा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2213037, "chapter_id": 5545, "verse_number": "५", "content_sanskrit": "कृपं निवर्तयामास युयुत्सुं च महारथम् ।\nधृतराष्ट्रो महाराज कुन्तीपुत्रं युधिष्ठिरम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2213038, "chapter_id": 5545, "verse_number": "६", "content_sanskrit": "निवृत्ते पौरवर्गे तु राजा सान्तःपुरस्तदा ।\nधृतराष्ट्राभ्यनुज्ञातो निवर्तितुमियेष सः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2213039, "chapter_id": 5545, "verse_number": "७", "content_sanskrit": "सोऽब्रवीन्मातरं कुन्तीमुपेत्य भरतर्षभ\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2213040, "chapter_id": 5545, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2213041, "chapter_id": 5545, "verse_number": "८", "content_sanskrit": "अहं राजानमन्विष्ये भवती विनिवर्तताम् ।\nवधूपरिवृता राज्ञि नगरं गन्तुमर्हसि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2213042, "chapter_id": 5545, "verse_number": "९", "content_sanskrit": "राजा यात्वेष धर्मात्मा तपसे धृतनिश्चयः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2213043, "chapter_id": 5545, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2213044, "chapter_id": 5545, "verse_number": "१०", "content_sanskrit": "इत्युक्ता धर्मराजेन बाष्पव्याकुललोचना ।\nजगादैवं तदा कुन्ती गान्धारीं परिगृह्य ह\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2213045, "chapter_id": 5545, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2213046, "chapter_id": 5545, "verse_number": "११", "content_sanskrit": "सहदेवे महाराज मा प्रमादं कृथाः क्वचित् ।\nएष मामनुरक्तो हि राजंस्त्वां चैव सर्वदा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2213047, "chapter_id": 5545, "verse_number": "१२", "content_sanskrit": "कर्णं स्मरेथाः सततं सङ्ग्रामेष्वपलायिनम् ।\nअवकीर्णो हि स मया वीरो दुष्प्रज्ञया तदा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2213048, "chapter_id": 5545, "verse_number": "१३", "content_sanskrit": "आयसं हृदयं नूनं मन्दाया मम पुत्रक ।\nयत् सूर्यजमपश्यन्त्याः शतशो यन्न दीर्यते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2213049, "chapter_id": 5545, "verse_number": "१४", "content_sanskrit": "एवं कृते तु किं शक्यं मया कर्तुमरिन्दम ।\nमम दोषोऽयमत्यर्थं ख्यापितो यन्न सूर्यजः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2213050, "chapter_id": 5545, "verse_number": "१५", "content_sanskrit": "तन्निमित्तं महाबाहो दानं दद्यास्त्वमुत्तमम् ।\nसदैव भ्रातृभिः सार्धमग्रजस्यारिमर्दन\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2213051, "chapter_id": 5545, "verse_number": "१६", "content_sanskrit": "द्रौपद्याश्च प्रिये नित्यं स्थातव्यमरिकर्शन\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2213052, "chapter_id": 5545, "verse_number": "१७", "content_sanskrit": "भीमसेनार्जुनौ चैव नकुलश्च कुरूद्वह ।\nसमाधेयास्त्वया धीमन् त्वं ह्येव कुलधूर्गतः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2213053, "chapter_id": 5545, "verse_number": "१८", "content_sanskrit": "श्वश्रूश्वशुरयोः पादौ शुश्रूषन्ती वने त्वहम् ।\nगान्धारीसहिता वत्स्ये तापसी मलपङ्किनी\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2213054, "chapter_id": 5545, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2213055, "chapter_id": 5545, "verse_number": "१९", "content_sanskrit": "एवमुक्तः स धर्मात्मा भ्रातृभिः सहितो वशी ।\nविषादमगमत् तीव्रं न च किञ्चिदुवाच ताम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2213056, "chapter_id": 5545, "verse_number": "२०", "content_sanskrit": "स मुहूर्तमिव ध्यात्वा धर्मराजो युधिष्ठिरः ।\nउवाच मातरं दीनश्चिन्ताशोकपरायणः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2213057, "chapter_id": 5545, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2213058, "chapter_id": 5545, "verse_number": "२१", "content_sanskrit": "किमिदं ते व्यवसितं नैव त्वं वक्तुमर्हसि ।\nन त्वामभ्यनुजानामि प्रसादं कर्तुमर्हसि\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2213059, "chapter_id": 5545, "verse_number": "२२", "content_sanskrit": "व्यरोचयः पुराऽस्माकमुत्साहं शुभदर्शने ।\nविदुलाया वचोभिस्त्वं नास्मान् सन्त्यक्तुमर्हसि\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2213060, "chapter_id": 5545, "verse_number": "२३", "content_sanskrit": "निहत्य पृथिवीपालान् राज्यं प्राप्तमिदं मया ।\nतव प्रज्ञामुपश्रुत्य वासुदेवान्नरर्षभात्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2213061, "chapter_id": 5545, "verse_number": "२४", "content_sanskrit": "क्व सा बुद्धिरियं चाद्य भवत्या या श्रुता मया ।\nक्षत्रधर्मे स्थितं त्यक्त्वा न प्रयातुमिहार्हसि\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2213062, "chapter_id": 5545, "verse_number": "२५", "content_sanskrit": "अस्मानुत्सृज्य राज्यं च स्नुषां चेमां यशस्विनीम् ।\nकथं वत्स्यसि शून्येषु वनेष्वम्ब प्रसीद मे\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2213063, "chapter_id": 5545, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2213064, "chapter_id": 5545, "verse_number": "समाप्तिः", "content_sanskrit": "इति बाष्पकला वाचः कुन्ती पुत्रस्य शृण्वती ।\nजगामैवाश्रुपूर्णाक्षी भीमस्तामिदमब्रवीत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2213065, "chapter_id": 5545, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2213066, "chapter_id": 5545, "verse_number": "२७", "content_sanskrit": "यदा राज्यमिदं कुन्ती भोक्तव्यं पुत्रसाद्गतम् ।\nप्राप्तव्या दानधर्माश्च यथेयं ते कुतो मतिः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2213067, "chapter_id": 5545, "verse_number": "२८", "content_sanskrit": "किं वयं कारिताः पूर्वं भवत्या पृथिवीक्षयम् ।\nकस्य हेतोः परित्यज्य राज्यं गन्तुमिहार्हसि\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2213068, "chapter_id": 5545, "verse_number": "२९", "content_sanskrit": "वनात् तस्मात् किमानीता भवत्या बालका वयम् ।\nदुःखशोकसमाविष्टौ माद्रीपुत्राविमौ तदा\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2213069, "chapter_id": 5545, "verse_number": "३०", "content_sanskrit": "प्रसीद मातर्मा गास्त्वं वनमद्य यशस्विनि ।\nश्रियं यौधिष्ठिरीं तावद् भुङ्क्ष्व पार्थबलार्जिताम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2213070, "chapter_id": 5545, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2213071, "chapter_id": 5545, "verse_number": "समाप्तिः", "content_sanskrit": "इति सा निश्चितैवाथ वनवासकृतक्षणा ।\nलालप्यतां बहुविधं पुत्राणां नाकरोद् वचः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2213072, "chapter_id": 5545, "verse_number": "३२", "content_sanskrit": "द्रौपदी चान्वयाच्छ्वश्रूं विषण्णवदना तदा ।\nवनवासाय गच्छन्तीं रुदन्ती भद्रया सह\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2213073, "chapter_id": 5545, "verse_number": "३३", "content_sanskrit": "सा पुत्रान् रुदतः सर्वान् मुहुर्मुहुरुदीक्षती ।\nजगामैव महाभागा वनाय धृतनिश्चया\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2213074, "chapter_id": 5545, "verse_number": "३४", "content_sanskrit": "अन्वयुः पाण्डवास्तत्र सभृत्यान्तःपुरास्तदा ।\nततः प्रमृज्य साऽश्रूणि पुत्रान् वचनमब्रवीत्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2213075, "chapter_id": 5545, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्रमवासिकपर्वणि कुन्तीवनप्रस्थानं नाम एकविंशोऽध्यायः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2213076, "chapter_id": 5545, "verse_number": "", "content_sanskrit": "आश्रमवासपर्वणि एकविंशोऽध्यायः ॥२१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]