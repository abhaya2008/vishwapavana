[{"id": 7004064000, "chapter_id": 24064, "verse_number": "४-१३-१", "content_sanskrit": "गणावूचतुः ।\nइमां गंधवतीं पुण्यां पुरीं वायोर्विलोकय ।\nवारुण्या उत्तरे भागे महाभाग्यनिधे द्विज ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004064001, "chapter_id": 24064, "verse_number": "४-१३-२", "content_sanskrit": "अस्यां प्रभंजनो नाम जगत्प्राणोदिगीश्वरः ।\nआराध्य श्रीमहादेवं दिक्पालत्वमवाप्तवान् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004064002, "chapter_id": 24064, "verse_number": "४-१३-३", "content_sanskrit": "पुरा कश्यपदायादः पूतात्मेति च विश्रुतः ।\nधूर्जटे राजधान्यां स चचार विपुलं तपः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004064003, "chapter_id": 24064, "verse_number": "४-१३-४", "content_sanskrit": "वाराणस्यां महाभागो वर्षाणामयुतं शतम् ।\nस्थापयित्वा महालिंगं पावनं पवनेश्वरम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004064004, "chapter_id": 24064, "verse_number": "४-१३-५", "content_sanskrit": "यस्य दर्शनमात्रेण पूतात्मा जायते नरः ।\nपापकंचुकमुत्सृज्य स वसेत्पावने पुरे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004064005, "chapter_id": 24064, "verse_number": "४-१३-६", "content_sanskrit": "ततस्तस्योग्रतपसा तपसाफलदः शिवः ।\nआविरासीत्ततो लिंगाज्ज्योतीरूपो महेश्वरः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004064006, "chapter_id": 24064, "verse_number": "४-१३-७", "content_sanskrit": "उवाच च प्रसन्नात्मा करुणामृतसागरः ।\nउत्तिष्ठोत्तिष्ठ पूतात्मन्वरं वरय सुव्रत ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004064007, "chapter_id": 24064, "verse_number": "४-१३-८", "content_sanskrit": "अनेन तपसोग्रेण लिंगस्याराधनेन च ।\nतवादेयं न पूतात्मंस्त्रैलोक्ये सचराचरे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004064008, "chapter_id": 24064, "verse_number": "४-१३-९", "content_sanskrit": "पूतात्मोवाच ।\nदेवदेवमहादेव देवानामभयप्रद ।\nब्रह्मनारायणेंद्रादि सर्वदेवपदप्रद ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004064009, "chapter_id": 24064, "verse_number": "४-१३-१०", "content_sanskrit": "वेदास्त्वां न च विंदंति किमात्मक इति प्रभो ।\nप्राप्ताः शतपथत्वं च नेतिनेतीतिवादिनः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004064010, "chapter_id": 24064, "verse_number": "४-१३-११", "content_sanskrit": "ब्रह्मविष्ण्वोपि गिरां गोचरो न च वाक्पतेः ।\nप्रमथेशं कथं स्तोतुं मादृशः प्रभवेत्प्रभो ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004064011, "chapter_id": 24064, "verse_number": "४-१३-१२", "content_sanskrit": "प्रसह्य प्रमिमीतेश भक्तिर्मांस्तुतिकर्मणि ।\nकरोमि किं जगन्नाथ न वश्यानींद्रियाणि मे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004064012, "chapter_id": 24064, "verse_number": "४-१३-१३", "content_sanskrit": "विश्वं त्वं नास्ति वै भेदस्त्वमेकः सर्वगो यतः ।\nस्तुत्यं स्तोता स्तुतिस्त्वं च सगुणो निर्गुणो भवान् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004064013, "chapter_id": 24064, "verse_number": "४-१३-१४", "content_sanskrit": "सर्गात्पुरा भवानेको रूपनाम विवर्जितः ।\nयोगिनोपि न ते तत्त्वं विंदंति परमार्थतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004064014, "chapter_id": 24064, "verse_number": "४-१३-१५", "content_sanskrit": "यदैकलो न शक्नोषि रंतुं स्वैरचर प्रभो ।\nतदिच्छा तवयोत्पन्ना सेव्या शक्तिरभूत्तव ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004064015, "chapter_id": 24064, "verse_number": "४-१३-१६", "content_sanskrit": "त्वमेको द्वित्वमापन्नः शिवशक्तिप्रभेदतः ।\nत्वं ज्ञानरूपो भगवान्स्वेच्छा शक्तिस्वरूपिणी ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004064016, "chapter_id": 24064, "verse_number": "४-१३-१७", "content_sanskrit": "उभाभ्यां शिवशक्तिभ्या युवाभ्यां निजलीलया ।\nउत्पादिता क्रियाशक्तिस्ततः सर्वमिदं जगत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004064017, "chapter_id": 24064, "verse_number": "४-१३-१८", "content_sanskrit": "ज्ञानशक्तिर्भवानीश इच्छाशक्तिरुमा स्मृता ।\nक्रियाशक्तिरिदं विश्वमस्य त्वं कारणं ततः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004064018, "chapter_id": 24064, "verse_number": "४-१३-१९", "content_sanskrit": "दक्षिणांगं तव विधिर्वामांगं तव चाच्युतः ।\nचंद्रसूर्याग्निनेत्रस्त्वं त्वन्निःश्वासः श्रुतित्रयम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004064019, "chapter_id": 24064, "verse_number": "४-१३-२०", "content_sanskrit": "त्वत्स्वेदादंबुनिधयस्तव श्रोत्रं समीरणः ।\nबाहवस्ते दशदिशो मुखं ते ब्राह्मणाः स्मृताः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004064020, "chapter_id": 24064, "verse_number": "४-१३-२१", "content_sanskrit": "राजन्यवर्यास्ते बाहु वैश्या ऊरुसमुद्भवाः ।\nपद्भ्यां शूद्रस्तवेशान केशास्ते जलदाः प्रभो ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004064021, "chapter_id": 24064, "verse_number": "४-१३-२२", "content_sanskrit": "त्वं पुं प्रकृतिरूपेण ब्रह्मांडमसृजः पुरा ।\nमध्ये ब्रह्मांडमखिलं विश्वमेतच्चराचरम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004064022, "chapter_id": 24064, "verse_number": "४-१३-२३", "content_sanskrit": "अतस्त्वत्तो न मन्येऽहं किंचिद्भिन्नं जगन्मय ।\nत्वयि सर्वाणि भूतानि सर्वभूतमयो भवान् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004064023, "chapter_id": 24064, "verse_number": "४-१३-२४", "content_sanskrit": "नमस्तुभ्यं नमस्तुभ्यं नमस्तुऽभ्यं नमोनमः ।\nअयमेव वरो नाथ त्वयि मेऽस्तु स्थिरा मतिः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004064024, "chapter_id": 24064, "verse_number": "४-१३-२५", "content_sanskrit": "इत्युक्तवति देवेश स्तस्मिन्पूतात्मनि प्रभुः ।\nस्वमूर्तित्वं समारोप्य दिक्पालपदमादधे ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004064025, "chapter_id": 24064, "verse_number": "४-१३-२६", "content_sanskrit": "सर्वगो मम रूपेण सर्वतत्त्वावबोधकः ।\nसर्वेषामायुषोरूपं भवानेव भविष्यति ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004064026, "chapter_id": 24064, "verse_number": "४-१३-२७", "content_sanskrit": "तव लिंगमिदं दिव्यं ये द्रक्ष्यंतीह मानवाः ।\nसर्वभोगसमृद्धास्ते त्वल्लोकसुखभागिनः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004064027, "chapter_id": 24064, "verse_number": "४-१३-२८", "content_sanskrit": "पवमानेश्वरं लिंगं मध्ये जन्मसकृन्नरः ।\nयथोक्तविधिना पूज्य सुगंधस्नपनादिभिः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004064028, "chapter_id": 24064, "verse_number": "४-१३-२९", "content_sanskrit": "सुगंधचंदनैः पुष्पैर्मम लोके महीयते ।\nज्येष्ठेशात्पश्चिमेभागे वायुकुंडोत्तरेण तु ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004064029, "chapter_id": 24064, "verse_number": "४-१३-३०", "content_sanskrit": "पावमानं समाराध्य पूतो भवति तत्क्षणात् ।\nइति दत्त्वा वरान्देवस्तस्मिंल्लिंगे लयं ययौ ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004064030, "chapter_id": 24064, "verse_number": "४-१३-३१", "content_sanskrit": "गणावूचतुः ।\nइति गंधवती पुर्याः स्वरूपं ते निरूपितम् ।\nतस्याः प्राच्यां कुबेरस्य श्रीमत्येषालकापुरी ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004064031, "chapter_id": 24064, "verse_number": "४-१३-३२", "content_sanskrit": "शंभोः सखित्वमापेदे नाथोस्या भक्तियोगतः ।\nनिधीनां पद्ममुख्यानां दाता भोक्ता हरार्चनात् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004064032, "chapter_id": 24064, "verse_number": "४-१३-३३", "content_sanskrit": "शिवशर्मोवाच ।\nकोसौ कस्य पुनः कीदृग्भक्तिरस्य सदाशिवे ।\nयया सखित्वमापन्नो देवदेवस्यधूर्जटेः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004064033, "chapter_id": 24064, "verse_number": "४-१३-३४", "content_sanskrit": "इति श्रोतुं मम मनः श्रुतिगोचरतां गतम् ।\nयुवयोर्वाक्सुधास्वाद मेदुरोदरमंथरम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004064034, "chapter_id": 24064, "verse_number": "४-१३-३५", "content_sanskrit": "गणावूचतुः ।\nशिवशर्मन्महाप्राज्ञ परिशुद्धेंद्रियेश्वर ।\nसुतीर्थक्षालिताशेषजन्मजातमहामल ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004064035, "chapter_id": 24064, "verse_number": "४-१३-३६", "content_sanskrit": "सुहृदि प्रेमसंपन्ने त्वय्यनुद्यं न किंचन ।\nसाधुभिः सह संवादः सर्वश्रेयोऽभिवृद्धये ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004064036, "chapter_id": 24064, "verse_number": "४-१३-३७", "content_sanskrit": "आसीत्कांपिल्यनगरे सोमयाजिकुलोद्भवः ।\nदीक्षितो यज्ञदत्ताख्यो यज्ञविद्याविशारदः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004064037, "chapter_id": 24064, "verse_number": "४-१३-३८", "content_sanskrit": "वेदवेदांगवेदार्थान्वेदोक्ताचारचंचुरः ।\nराजमान्यो बहुधनो वदान्यः कीर्तिभाजनम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004064038, "chapter_id": 24064, "verse_number": "४-१३-३९", "content_sanskrit": "अग्निशुश्रूषणरतो वेदाध्ययनतत्परः ।\nतस्य पुत्रो गुणनिधिश्चंद्रबिंबसमाकृतिः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004064039, "chapter_id": 24064, "verse_number": "४-१३-४०", "content_sanskrit": "कृतोपनयनः सोथ विद्यां जग्राह भूरिशः ।\nअथ पित्रानभिज्ञातो द्यूतकर्मरतोऽभवत् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004064040, "chapter_id": 24064, "verse_number": "४-१३-४१", "content_sanskrit": "आदायादाय बहुशो धनं मातुः सकाशतः ।\nददाति द्यूतकारेभ्यो मैत्री तैश्च चकार सः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004064041, "chapter_id": 24064, "verse_number": "४-१३-४२", "content_sanskrit": "संत्यक्त ब्राह्मणाचारः संध्यास्नानपराङ्मुखः ।\nनिंदको वेदशास्त्राणां देवब्राह्मणनिंदकः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004064042, "chapter_id": 24064, "verse_number": "४-१३-४३", "content_sanskrit": "स्मृत्याचारविहीनस्तु गीतवाद्यविनोदभाक् ।\nनटपाखंडिभंडैश्च बद्धप्रेमपरंपरः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004064043, "chapter_id": 24064, "verse_number": "४-१३-४४", "content_sanskrit": "प्रेरितोपि जनन्या स न याति पितुरंतिकम् ।\nगृहकार्यांतरव्यग्रो दीक्षितो दीक्षितायिनीम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004064044, "chapter_id": 24064, "verse_number": "४-१३-४५", "content_sanskrit": "यदा यदैव तां पृच्छेदयेगुणनिधिः सुतः ।\nन दृश्यते मया गेहे क्व याति विदधाति किम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004064045, "chapter_id": 24064, "verse_number": "४-१३-४६", "content_sanskrit": "तदा तदेति सा ब्रूयादिदानीं स बहिर्गतः ।\nस्नात्वा समर्च्य वै देवानेतावंतमनेहसम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004064046, "chapter_id": 24064, "verse_number": "४-१३-४७", "content_sanskrit": "अधीत्याध्ययनार्थं स द्वित्रैर्मित्रैः समं ययौ ।\nएकपुत्रेति तन्माता प्रतारयति दीक्षितम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004064047, "chapter_id": 24064, "verse_number": "४-१३-४८", "content_sanskrit": "न तत्कर्म च तद्वृत्तं किंचिद्वेत्ति स दीक्षितः ।\nस च केशांतकर्मास्य कृत्वा वर्षेऽथ षोडशे ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004064048, "chapter_id": 24064, "verse_number": "४-१३-४९", "content_sanskrit": "गृह्योक्तेन विधानेन पाणिग्राहमकारयत् ।\nप्रत्यहं तस्य जननी सुतं गुणनिधिं मृदु ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004064049, "chapter_id": 24064, "verse_number": "४-१३-५०", "content_sanskrit": "शास्ति स्नेहार्द्रहृदया क्रोधनस्ते पितेत्यलम् ।\nयदि ज्ञास्यति ते वृत्तं त्वां च मां ताडयिष्यति ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004064050, "chapter_id": 24064, "verse_number": "४-१३-५१", "content_sanskrit": "आच्छादयामि ते नित्यं पितुरग्रे कुचेष्टितम् ।\nलोकमान्योस्ति ते तातः सदाचारैर्न वै धनैः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004064051, "chapter_id": 24064, "verse_number": "४-१३-५२", "content_sanskrit": "ब्राह्मणानां धनं पुत्र सद्विद्या साधुसंगमः ।\nसच्छ्रोत्रियास्त्वनूचाना दीक्षिताः सोमयाजिनः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004064052, "chapter_id": 24064, "verse_number": "४-१३-५३", "content_sanskrit": "इति रूढिमिह प्राप्तास्तव पूर्वपितामहाः ।\nत्यक्त्वा दुर्वृत्तसंसर्गं साधुसंगरतो भव ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004064053, "chapter_id": 24064, "verse_number": "४-१३-५४", "content_sanskrit": "सद्विद्या सुमनो धेहि ब्राह्मणाचारमाचर ।\nतवानुरूपारूपेण वयसाकुलशीलतः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004064054, "chapter_id": 24064, "verse_number": "४-१३-५५", "content_sanskrit": "ऊनविंशतिकोऽसि त्वमेषा षोडशवार्षिकी ।\nतव पत्नी गुणनिधे साध्वी मधुरभाषिणी ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004064055, "chapter_id": 24064, "verse_number": "४-१३-५६", "content_sanskrit": "एतां संवृणु सद्वृत्तां पितृभक्तियुता भव ।\nश्वशुरोपि हि ते मान्यः सर्वत्र गुणशीलतः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004064056, "chapter_id": 24064, "verse_number": "४-१३-५७", "content_sanskrit": "ततोऽपत्रपसे किं न त्यज दुर्वृत्ततां शिशो ।\nमातुलास्तेऽतुलाः पुत्र विद्याशीलकुलादिभिः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004064057, "chapter_id": 24064, "verse_number": "४-१३-५८", "content_sanskrit": "तेभ्योपि न बिभेषि त्वं शुद्धोस्युभय वंशतः ।\nपश्यैतान्प्रतिवेश्मस्थान्ब्राह्मणानां कुमारकान् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004064058, "chapter_id": 24064, "verse_number": "४-१३-५९", "content_sanskrit": "गृहेपि शिष्यान्पश्यैतान्पितुस्ते विनयोचितान् ।\nराजापि श्रोष्यति यदा तव दुश्चेष्टितं सुत ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004064059, "chapter_id": 24064, "verse_number": "४-१३-६०", "content_sanskrit": "श्रद्धां विहाय ते ताते वृत्तिलोपं करिष्यति ।\nबालचेष्टितमेवैतद्वदंत्यद्यापि ते जनाः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004064060, "chapter_id": 24064, "verse_number": "४-१३-६१", "content_sanskrit": "अनंतरं हसिष्यंति युक्तं दीक्षिततास्त्विति ।\nसर्वेप्याक्षारयिष्यंति तव विप्रं च मां च वै ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004064061, "chapter_id": 24064, "verse_number": "४-१३-६२", "content_sanskrit": "मातुश्चरित्रं तनयो धत्ते दुर्भाषणैरिति ।\nपिता पितेन पापीयाञ्च्छ्रुतिस्मृतिपथीनकिम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004064062, "chapter_id": 24064, "verse_number": "४-१३-६३", "content_sanskrit": "तदंघ्रिलीनमनसो मम साक्षी महेश्वरः ।\nन चर्तुस्नातयापीह मुखं दुष्टस्य वीक्षितम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004064063, "chapter_id": 24064, "verse_number": "४-१३-६४", "content_sanskrit": "अहो बलीयान्सविधिर्येन जाता भवानिति ।\nप्रतिक्षणं जनन्येति शिक्ष्यमाणोतिदुर्मदः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004064064, "chapter_id": 24064, "verse_number": "४-१३-६५", "content_sanskrit": "न तत्याज च तद्धर्मं दुर्बोधो व्यसनी यतः ।\nमृगया मद्य पैशुन्य वेश्याचौर्यदुरोदरैः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004064065, "chapter_id": 24064, "verse_number": "४-१३-६६", "content_sanskrit": "सपारदारैर्व्यसनैरेभिः कोत्र न खंडितः ।\nयद्यन्मध्ये गृहे पश्येत्तत्तन्नीत्वा सुदुर्मतिः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004064066, "chapter_id": 24064, "verse_number": "४-१३-६७", "content_sanskrit": "अर्पयेद्द्यूतकाराणां सकुप्यं वसनादिकम् ।\nनवरत्नमयीं मातुः करतः पितुरूर्मिकाम ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004064067, "chapter_id": 24064, "verse_number": "४-१३-६८", "content_sanskrit": "स्वपंत्यास्त्वेकदाऽदाय दुरोदरिकरेऽर्पयत् ।\nएकदा गच्छता राजभवनान्निजमुद्रिका ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004064068, "chapter_id": 24064, "verse_number": "४-१३-६९", "content_sanskrit": "दीक्षितेन परिज्ञाता दैवाद्द्यूतकृतः करे ।\nउवाच दीक्षितस्तं च कुतो लब्धा त्वयोर्मिका ।\nपृष्टस्तेनाथ निर्बंधादसकृत्प्रत्युवाच किम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004064069, "chapter_id": 24064, "verse_number": "४-१३-७०", "content_sanskrit": "ममाक्षिपसि विप्रोच्चैः किं मया चौर्य कर्मणा ।\nलब्धा मुद्रा त्वदीयेन पुत्रेणैषा ममार्पिता ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004064070, "chapter_id": 24064, "verse_number": "४-१३-७१", "content_sanskrit": "मम मातुर्हि पूर्वे द्युर्जित्वानीतो हि शाटकः ।\nन केवलं ममाप्येतदंगुलीयं समर्पितम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004064071, "chapter_id": 24064, "verse_number": "४-१३-७२", "content_sanskrit": "अन्येषां द्यूतकर्तृणां भूरि तेनार्पितं वसु ।\nरत्नकुप्यदुकूलानि भृंगारुप्रभृतीनि च ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004064072, "chapter_id": 24064, "verse_number": "४-१३-७३", "content_sanskrit": "भाजनानि विचित्राणि कांस्य ताम्रमयानि च ।\nनग्नीकृत्यप्रति दिनं बद्ध्यंते द्यूतकारिभिः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004064073, "chapter_id": 24064, "verse_number": "४-१३-७४", "content_sanskrit": "न तेन सदृशः कश्चिदाक्षिको भूमिमंडले ।\nअद्य यावत्त्वया विप्र दुरोदरशिरोमणिः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004064074, "chapter_id": 24064, "verse_number": "४-१३-७५", "content_sanskrit": "कथं नाज्ञायि तनयो ऽविनयानयकोविदः ।\nइति श्रुत्वा त्रपाभार विनम्रतरकंधरः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004064075, "chapter_id": 24064, "verse_number": "४-१३-७६", "content_sanskrit": "प्रावृत्य वाससा मौलिं प्राविशन्निजमंदिरम् ।\nमहापतिव्रतामास्य पत्नीं प्रोवाच तामथ ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004064076, "chapter_id": 24064, "verse_number": "४-१३-७७", "content_sanskrit": "दीक्षितायिनि कुत्रासि क्व ते गुणनिधिः सुतः ।\nअथ तिष्ठतु किं तेन क्व सा मम शुभोर्मिका ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004064077, "chapter_id": 24064, "verse_number": "४-१३-७८", "content_sanskrit": "अंगोद्वर्तन काले या त्वया मेंऽगुलितो हृता ।\nनवरत्नमयीं शीघ्रं तामानीय प्रयच्छ मे ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004064078, "chapter_id": 24064, "verse_number": "४-१३-७९", "content_sanskrit": "इति श्रुत्वाथ तद्वाक्यं भीता सा दीक्षितायिनी ।\nप्रोवाच सा तु माध्याह्नीं क्रियां निष्पादयत्वथ ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004064079, "chapter_id": 24064, "verse_number": "४-१३-८०", "content_sanskrit": "व्यग्रास्मि देवपूजार्थमुपहारादि कर्मणि ।\nसमयोयमतिक्रामेदतिथीनां प्रियातिथे ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004064080, "chapter_id": 24064, "verse_number": "४-१३-८१", "content_sanskrit": "इदानीमेव पक्वान्नकरणव्यग्रया मया ।\nस्थापिता भाजने क्वापि विस्मृतेति न वेद्म्यहम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004064081, "chapter_id": 24064, "verse_number": "४-१३-८२", "content_sanskrit": "दीक्षित उवाच ।\nहंहो सत्पुत्रजननि नित्यं सत्यप्रभाषिणि ।\nयदायदा त्वां संपृच्छे तनयः क्व गतस्त्विति ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004064082, "chapter_id": 24064, "verse_number": "४-१३-८३", "content_sanskrit": "तदातदेति त्वं ब्रूया नाथेदानीं स निर्गतः ।\nअधीत्याध्ययनार्थं च द्वित्रैर्मित्रैः सयुग्बहिः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004064083, "chapter_id": 24064, "verse_number": "४-१३-८४", "content_sanskrit": "कुतस्त्वच्छाटकः पत्नि मांजिष्ठो यो मयाऽर्पितः ।\nलंबते वस्त्रधान्यांयस्तथ्यं ब्रूहि भयं त्यज ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004064084, "chapter_id": 24064, "verse_number": "४-१३-८५", "content_sanskrit": "सांप्रतं नेक्ष्यते सोपि भृंगारुर्मणिमंडितः ।\nपट्टसूत्रमयीसापि त्रिपटी क्व नृपार्पिता ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004064085, "chapter_id": 24064, "verse_number": "४-१३-८६", "content_sanskrit": "क्व दाक्षिणात्यं तत्कांस्यं गौडी ताम्रघटी क्व सा ।\nनागदंतमयी सा क्व सुखकौतुकमंचिका ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004064086, "chapter_id": 24064, "verse_number": "४-१३-८७", "content_sanskrit": "क्व सा पर्वतदेशीया चंद्रकांतशिलोद्भवा ।\nदीपिका व्यग्रहस्ताग्रा सालंकृच्छालभंजिका ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004064087, "chapter_id": 24064, "verse_number": "४-१३-८८", "content_sanskrit": "किं बहूक्तेन कुलजे तुभ्यं कुप्याम्यहं वृथा ।\nतदाभ्यवहरिष्येहमुपयंस्याम्यहं यदा ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004064088, "chapter_id": 24064, "verse_number": "४-१३-८९", "content_sanskrit": "अनपत्योस्मि तेनाहं दुष्टेन कुलदूषिणा ।\nउत्तिष्ठानय दर्भांबु तस्मै दद्यां तिलांजलिम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004064089, "chapter_id": 24064, "verse_number": "४-१३-९०", "content_sanskrit": "अपुत्रत्वं वरं नृणां कुपुत्रात्कुलपांसनात् ।\nत्यजेदेकं कुलस्यार्थे नीतिरेषा सनातनी ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004064090, "chapter_id": 24064, "verse_number": "४-१३-९१", "content_sanskrit": "स्नात्वा नित्यविधिं कृत्वा तस्मिन्नेवाह्निकस्यचित् ।\nश्रोत्रियस्य सुतां प्राप्य पाणिं जग्राह दीक्षितः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004064091, "chapter_id": 24064, "verse_number": "४-१३-९२", "content_sanskrit": "श्रुत्वा तथा स वृत्तांतं प्राक्तनं स्वं विनिंद्य च ।\nकांचिद्दिशं समालोच्य निर्ययौ दीक्षितांगजः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004064092, "chapter_id": 24064, "verse_number": "४-१३-९३", "content_sanskrit": "चिंतामवाप महतीं क्व यामि करवाणि किम् ।\nनाहमभ्यस्तविद्योस्मि न चैवास्ति धनोस्म्यहम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004064093, "chapter_id": 24064, "verse_number": "४-१३-९४", "content_sanskrit": "देशांतरे ह्यस्ति धनः सद्विद्यः सुखमेधते ।\nभयमस्ति धने चौरात्सविद्यः सर्वतोऽभयः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004064094, "chapter_id": 24064, "verse_number": "४-१३-९५", "content_sanskrit": "यायजूके कुले जन्म क्वक्व मे व्यसनं तथा ।\nअहो बलीयान्स विधिर्भाविकर्मानुसंधयेत् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004064095, "chapter_id": 24064, "verse_number": "४-१३-९६", "content_sanskrit": "भिक्षितुं नाधिगच्छामि न मे परिचितः क्वचित् ।\nन च पार्श्वे धनं किंचित्किमत्र शरणं भवेत् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004064096, "chapter_id": 24064, "verse_number": "४-१३-९७", "content_sanskrit": "सदाभ्युदिते भानौ प्रसूर्मे मृष्टभोजनम् ।\nदद्यादद्यात्र कं याचे याचेह जननी न मे ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004064097, "chapter_id": 24064, "verse_number": "४-१३-९८", "content_sanskrit": "इति चिंतयतस्तस्य भानुरस्ताचलं गतः ।\nएतस्मिन्नेव समये कश्चिन्माहेश्वरो नरः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004064098, "chapter_id": 24064, "verse_number": "४-१३-९९", "content_sanskrit": "महोपहारानादाय नगराद्बहिरभ्यगात् ।\nसमभ्यर्चितुमीशानं शिवरात्रावुपोषितः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004064099, "chapter_id": 24064, "verse_number": "४-१३-१००", "content_sanskrit": "पक्वान्नगंधमाघ्राय क्षुधितः स तमन्वगात् ।\nइदमन्नं मया ग्राह्यं शिवायोपस्कृतं निशि ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004064100, "chapter_id": 24064, "verse_number": "४-१३-१०१", "content_sanskrit": "इत्याशामवलंब्याथ द्वारि शंभोरुपाविशत् ।\nददर्श च महापूजां तेन भक्तेन निर्मिताम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004064101, "chapter_id": 24064, "verse_number": "४-१३-१०२", "content_sanskrit": "विधाय नृत्यगीतादि भक्ताः सुप्ताः क्षणं यदा ।\nनैवेद्यं स तदाऽदातुं गर्भागारं विवेश ह ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004064102, "chapter_id": 24064, "verse_number": "४-१३-१०३", "content_sanskrit": "दीपं मंदप्रभं दृष्ट्वा पक्वान्नावेक्षणाय सः ।\nनिजचैलांचलाद्वर्तिं दत्त्वा समुददीपयत् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004064103, "chapter_id": 24064, "verse_number": "४-१३-१०४", "content_sanskrit": "ततः पक्कान्नमादाय त्वरितं गच्छतो बहिः ।\nतस्य पादतलाघातात्प्रसुप्तः कोप्यबुध्यत ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004064104, "chapter_id": 24064, "verse_number": "४-१३-१०५", "content_sanskrit": "कोयंकोयं त्वरापन्नश्चोरोयं गृह्यतामिति ।\nयावद्भूयात्समागत्य तावत्स पुररक्षकैः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004064105, "chapter_id": 24064, "verse_number": "४-१३-१०६", "content_sanskrit": "पलायमानो निहतः क्षणात्पंचत्वमागतः ।\nअभक्षयच्च नैवेद्यं भाविपुण्यबलान्न सः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004064106, "chapter_id": 24064, "verse_number": "४-१३-१०७", "content_sanskrit": "अथ बद्धः समागत्य पाशमुद्गरपाणिभिः ।\nनिनीषुभिः सयमिनीं यामैः स विकटैर्भटैः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004064107, "chapter_id": 24064, "verse_number": "४-१३-१०८", "content_sanskrit": "तावत्पारिषदाः प्राप्ताः किंकिणीजालमालितम् ।\nदिव्यंविमानमादाय तं नेतुं शूलपाणयः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004064108, "chapter_id": 24064, "verse_number": "४-१३-१०९", "content_sanskrit": "शंभोर्गणान्समालोक्य भीतैस्तैर्यमकिंकरैः ।\nअवादिप्रणतैरित्थं दुर्वृत्तोयं गणा द्विजः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004064109, "chapter_id": 24064, "verse_number": "४-१३-११०", "content_sanskrit": "कुलाचारप्रतीपोयं पित्रोर्वाक्यपराङ्मुखः ।\nसत्यशौचपरिभ्रष्टःसंध्यास्नानविवर्जितः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004064110, "chapter_id": 24064, "verse_number": "४-१३-१११", "content_sanskrit": "आस्तां दूरेऽस्य कर्माणि शिवनिर्माल्यहारकः ।\nप्रत्यक्षतोऽत्र वीक्षध्वमस्पृश्योयं भवादृशाम् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004064111, "chapter_id": 24064, "verse_number": "४-१३-११२", "content_sanskrit": "शिवनिर्माल्यभोक्तारः शिवनिर्माल्यलंघकाः ।\nशिवनिर्माल्यदातारः स्पर्शस्तेषां ह्यपुण्यकृत् ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004064112, "chapter_id": 24064, "verse_number": "४-१३-११३", "content_sanskrit": "विषमालोड्य वापे यं श्रेयोवाऽनशनं परम् ।\nसेवितव्यं शिवस्वं न प्राणः कंठगतैरपि ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004064113, "chapter_id": 24064, "verse_number": "४-१३-११४", "content_sanskrit": "यूयं प्रमाणं धर्मेषु यथा न च तथा वयम् ।\nअस्ति चेद्धर्मलेशोस्य गणास्तच्छृणुमो वयम् ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004064114, "chapter_id": 24064, "verse_number": "४-१३-११५", "content_sanskrit": "इत्थं तद्वाक्यमाकर्ण्य प्रोचुः पारिषदास्ततः ।\nकिंकराः शिवधर्मा ये सूक्ष्मास्ते वै भवादृशैः ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004064115, "chapter_id": 24064, "verse_number": "४-१३-११६", "content_sanskrit": "स्थूललक्ष्यैः कथं लक्ष्या लक्ष्या ये सूक्ष्मदृष्टिभिः ।\nअनेनानेन सा कर्म यत्कृतं शृणुतेह तत् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004064116, "chapter_id": 24064, "verse_number": "४-१३-११७", "content_sanskrit": "पतंती लिंगशिरसि दीपच्छाया निवारिता ।\nस्वचैलांचलतोऽनेन दत्त्वादीपे दशां निशि ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7004064117, "chapter_id": 24064, "verse_number": "४-१३-११८", "content_sanskrit": "अपरोपि परो धर्मो जातस्तत्रास्य किंकराः ।\nशृण्वता शिवनामानि प्रसंगादपिगृह्णतः ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7004064118, "chapter_id": 24064, "verse_number": "४-१३-११९", "content_sanskrit": "भक्तेन विधिना पूजा क्रियमाणा निरीक्षिता ।\nउपोषिते न भूतायामनेन स्थिरचेतसा ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7004064119, "chapter_id": 24064, "verse_number": "४-१३-१२०", "content_sanskrit": "कलिंगराजोभविताऽधुनाविधुतकल्मषः ।\nएष द्विजवरो दूता यूयं यात यथागताः ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7004064120, "chapter_id": 24064, "verse_number": "४-१३-१२१", "content_sanskrit": "पार्षदैर्यमदूतेभ्यो मोचितस्त्विति स द्विजः ।\nअरिंदमस्य तनयः कलिंगाधितेर्दमः ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7004064121, "chapter_id": 24064, "verse_number": "४-१३-१२२", "content_sanskrit": "क्रमाद्राज्यमवाप्याथ पितर्युपरते युवा ।\nनान्यं धर्मं विजानाति दुर्दमो भूपतिर्दमः ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7004064122, "chapter_id": 24064, "verse_number": "४-१३-१२३", "content_sanskrit": "शिवालयेषु सर्वेषु दीपदानादृते द्विज ।\nग्रामाधीशान्समाहूय सर्वान्त्स्वविषयस्थितान् ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7004064123, "chapter_id": 24064, "verse_number": "४-१३-१२४", "content_sanskrit": "इत्थमाज्ञापयामास स मे दंड्यो भविष्यति ।\nयस्य यस्याभितो ग्रामं यावंतश्च शिवालयाः ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7004064124, "chapter_id": 24064, "verse_number": "४-१३-१२५", "content_sanskrit": "तत्र तत्र सदा दीपो द्योतनीयोऽविचारितम् ।\nममाज्ञाभंगदोषेण शिरश्छेत्स्याम्यसंशयम् ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7004064125, "chapter_id": 24064, "verse_number": "४-१३-१२६", "content_sanskrit": "इति तद्भयतो दीप्ता दीपाः प्रति शिवालयम् ।\nअनेनैव स धर्मेण यावज्जीवं दमो नृपः ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7004064126, "chapter_id": 24064, "verse_number": "४-१३-१२७", "content_sanskrit": "धर्मर्द्धि महतीं प्राप्य कालधर्मवशं गतः ।\nसदीपवासनायागोद्बहून्दीपान्प्रदीप्य वै ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7004064127, "chapter_id": 24064, "verse_number": "४-१३-१२८", "content_sanskrit": "अलकायाः पतिरभूद्रत्नदीपशिखाश्रयः ।\nएवं फलति कालेन शिवेऽल्पमपि यत्कृतम् ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7004064128, "chapter_id": 24064, "verse_number": "४-१३-१२९", "content_sanskrit": "इति ज्ञात्वा शिवे कार्यं भजनं स्वसुखार्थिभिः ।\nक्व स दीक्षितदायादः सर्वधर्म पराङ्मुखः ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7004064129, "chapter_id": 24064, "verse_number": "४-१३-१३०", "content_sanskrit": "स्वार्थदीपदशोद्योत लिंगमौलि तमोहरः ।\nकलिंगविषये राज्यं प्राप्तो धर्मरतिः सदा ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7004064130, "chapter_id": 24064, "verse_number": "४-१३-१३१", "content_sanskrit": "शिवालये समुद्दीप्य दीपान्प्राग्वासनोदयात् ।\nक्वैषा दिक्पालपदवी शिवशर्मन्विलोकय ।\nमनुष्यधर्मणानेन सांप्रतं येह भुज्यते ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7004064131, "chapter_id": 24064, "verse_number": "४-१३-१३२", "content_sanskrit": "गणावूचतुः ।\nसर्वदैव शिवेनासौ सखित्वं च यथेयिवान् ।\nतदप्येकमना विप्र संशृणुष्व ब्रवावहै ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7004064132, "chapter_id": 24064, "verse_number": "४-१३-१३३", "content_sanskrit": "पाद्मे कल्पे पुरा विप्र ब्रह्मणो मानसात्सुतात् ।\nपुलस्त्याद्विश्रवा जज्ञे तस्य वैश्रवणः सुतः ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7004064133, "chapter_id": 24064, "verse_number": "४-१३-१३४", "content_sanskrit": "तेनेयमलका भुक्ता पुरी विश्वकृता कृता ।\nआराध्यं त्र्यंबकं देवमत्युग्रतपसा पुरा ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7004064134, "chapter_id": 24064, "verse_number": "४-१३-१३५", "content_sanskrit": "व्यतीते तत्र कल्पे वै प्रवृत्ते मेघवाहने ।\nयाज्ञदत्तिरसौश्रीदस्तपस्तेपे सुदुःसहम् ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7004064135, "chapter_id": 24064, "verse_number": "४-१३-१३६", "content_sanskrit": "भक्तिप्रभावं विज्ञाय शंभोस्तद्दीपमात्रतः ।\nपुरीं पुरारेः संप्राप्य काशिकां चित्प्रकाशिकाम् ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7004064136, "chapter_id": 24064, "verse_number": "४-१३-१३७", "content_sanskrit": "शिवैकदशमुद्बोध्य चित्ररत्नप्रदीपकम् ।\nअनन्यभक्तिस्नेहाढ्यं तन्महोध्याननिश्चलम् ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7004064137, "chapter_id": 24064, "verse_number": "४-१३-१३८", "content_sanskrit": "शिवैक्यसुमहापात्रं तपोग्निपरिबृंहितम् ।\nकामक्रोधमहाविघ्नपतंगाघातवर्जितम् ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7004064138, "chapter_id": 24064, "verse_number": "४-१३-१३९", "content_sanskrit": "प्राणसंरोधनिर्वातं निर्मलं निर्मलेक्षणात् ।\nसंस्थाप्य शांभवं लिंगं सद्भावकुसुमार्चितम् ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7004064139, "chapter_id": 24064, "verse_number": "४-१३-१४०", "content_sanskrit": "तावत्तताप स तपस्त्वगस्थिपरिशेषितम् ।\nयावद्बभूव तद्वर्ष्म वर्षाणामयुतं शतम् ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7004064140, "chapter_id": 24064, "verse_number": "४-१३-१४१", "content_sanskrit": "ततः सह विशालाक्ष्या देवो विश्वेश्वरः स्वयम् ।\nअलकापतिमालोक्य प्रसन्नेनांतरात्मना ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7004064141, "chapter_id": 24064, "verse_number": "४-१३-१४२", "content_sanskrit": "लिंगे मनः समाधाय स्थितं स्थाणुस्वरूपिणम् ।\nउवाच वरदोस्मीति तप्त्वालमलकापते ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7004064142, "chapter_id": 24064, "verse_number": "४-१३-१४३", "content_sanskrit": "उन्मील्य नयने यावत्स पश्यति तपोधनः ।\nतावदुद्यत्सहस्रांशु सहस्राधिक तेजसम् ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7004064143, "chapter_id": 24064, "verse_number": "४-१३-१४४", "content_sanskrit": "पुरो ददर्श श्रीकंठं चंद्रचूडमुमाधवम् ।\nतत्तेजः परिभूताक्षितेजाः संमील्य लोचने ॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7004064144, "chapter_id": 24064, "verse_number": "४-१३-१४५", "content_sanskrit": "उवाच देवदेवेशं मनोरथपथातिगम् ।\nनिजांघ्रिदर्शनेनाथ दृक्सामर्थ्यं प्रयच्छ मे ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7004064145, "chapter_id": 24064, "verse_number": "४-१३-१४६", "content_sanskrit": "अयमेव वरो नाथ यत्त्वं साक्षान्निरीक्ष्यसे ।\nकिमन्येन वरेणेश नमस्ते शशिशेखर ॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7004064146, "chapter_id": 24064, "verse_number": "४-१३-१४७", "content_sanskrit": "इति तद्वचनं श्रुत्वा देवदेव उमापतिः ।\nददौ दर्शनसामर्थ्यं स्पृष्ट्वा पाणितलेन तम् ॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7004064147, "chapter_id": 24064, "verse_number": "४-१३-१४८", "content_sanskrit": "प्रसार्य नयने पूर्वमुमामेव व्यलोकयत् ।\nशंभोः समीपे कायोषिदेषा सर्वांगसुंदरी ॥१४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 7004064148, "chapter_id": 24064, "verse_number": "४-१३-१४९", "content_sanskrit": "अनया किंतपस्तप्तं ममापि तपसोधिकम् ।\nअहो रूपमहो प्रेम सौभाग्यश्रीरहो भृशम् ॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 7004064149, "chapter_id": 24064, "verse_number": "४-१३-१५०", "content_sanskrit": "क्रूरदृग्वीक्षते यावत्पुनःपुनरिदं वदन् ।\nतावत्पुस्फोट तन्नेत्रं वामं वामा विलोकनात ॥१५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 7004064150, "chapter_id": 24064, "verse_number": "४-१३-१५१", "content_sanskrit": "अथ देव्यब्रवीद्देवं किमसौ दुष्टतापसः ।\nअसकृद्वीक्ष्य मां वक्ति न्यक्कुर्वन्मे तपःप्रभाम् ॥१५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 7004064151, "chapter_id": 24064, "verse_number": "४-१३-१५२", "content_sanskrit": "असकृद्दक्षिणेनाक्ष्णा पुनर्मामेवपश्यति ।\nअसूयमानो मे रूपं प्रेमसौभाग्यसंपदः ॥१५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 7004064152, "chapter_id": 24064, "verse_number": "४-१३-१५३", "content_sanskrit": "इति देवीगिरं श्रुत्वा प्रहस्य प्राह तां प्रभुः ।\nउमे त्वदीयः पुत्रोयं न च क्रूरेण चक्षुषा ॥१५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}, {"id": 7004064153, "chapter_id": 24064, "verse_number": "४-१३-१५४", "content_sanskrit": "संपश्यते तपो लक्ष्मीं तव किं त्वधिवर्णयेत् ।\nइति देवीं समाभाष्य तमीशः पुनरब्रवीत् ॥१५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 154}, {"id": 7004064154, "chapter_id": 24064, "verse_number": "४-१३-१५५", "content_sanskrit": "वरान्ददामि ते वत्स तपसानेन तोषितः ।\nनिधीनामधिनाथस्त्वं गुह्यकानां भवेश्वरः ॥१५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 155}, {"id": 7004064155, "chapter_id": 24064, "verse_number": "४-१३-१५६", "content_sanskrit": "यक्षाणां किन्नराणां च राजा राज्ञां च सुव्रत ।\nपतिः पुण्यजनानां च सर्वेषां धनदो भव ॥१५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 156}, {"id": 7004064156, "chapter_id": 24064, "verse_number": "४-१३-१५७", "content_sanskrit": "मया सख्यं च ते नित्यं वत्स्यामि च तवांतिके ।\nअलकां निकषामित्र तव प्रीतिविवृद्धये ॥१५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 157}, {"id": 7004064157, "chapter_id": 24064, "verse_number": "४-१३-१५८", "content_sanskrit": "आगच्छ पादयोरस्याः पत ते जननी त्वियम् ।\nइति दत्त्वा वरान्देवः पुनराह शिवां शिवः ।\nप्रसादं कुरु देवेशि तपस्विन्यंगजेऽत्र वै ॥१५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 158}, {"id": 7004064158, "chapter_id": 24064, "verse_number": "४-१३-१५९", "content_sanskrit": "देव्युवाच ।\nवत्स ते निश्चला भक्तिर्भवे भवतु सर्वदा ।\nभवैकांषेंगो गोनेत्रेण वामेन स्फुटितेन ह ॥१५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 159}, {"id": 7004064159, "chapter_id": 24064, "verse_number": "४-१३-१६०", "content_sanskrit": "देवेन दत्ता ये तुभ्यं वराः संतु तथैव ते ।\nकुबेरो भव नाम्ना त्वं मम रूपेर्ष्यया सुत ॥१६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 160}, {"id": 7004064160, "chapter_id": 24064, "verse_number": "४-१३-१६१", "content_sanskrit": "त्वयेदं स्थापितं लिंगं तव नाम्ना भविष्यति ।\nसिद्धिदं साधकानां च सर्वपापहरं परम् ॥१६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 161}, {"id": 7004064161, "chapter_id": 24064, "verse_number": "४-१३-१६२", "content_sanskrit": "न धनेन वियुज्येत न सख्या न च बांधवैः ।\nकुबेरेश्वरलिंगस्य कुर्याद्यो दर्शनं नरः ॥१६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 162}, {"id": 7004064162, "chapter_id": 24064, "verse_number": "४-१३-१६३", "content_sanskrit": "विश्वेशाद्दक्षिणेभागे कुबेरेशं समर्चयेत् ।\nनरो लिप्येत नो पापैर्न दारिद्र्येण नोऽसुखैः ॥१६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 163}, {"id": 7004064163, "chapter_id": 24064, "verse_number": "४-१३-१६४", "content_sanskrit": "इति दत्त्वा वरान्देवो देव्या सह महेश्वरः ।\nधनदाया विवेशाथ धाम वैश्वेश्वरं परम् ॥१६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 164}, {"id": 7004064164, "chapter_id": 24064, "verse_number": "४-१३-१६५", "content_sanskrit": "गणावूचतुः ।\nइत्थं सखित्वं श्रीशंभोः प्रापैष धनदः परम् ।\nअलकां निकषाचैष कैलासः शंकरालयः ॥१६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 165}, {"id": 7004064165, "chapter_id": 24064, "verse_number": "४-१३-१६६", "content_sanskrit": "पुर्यां यक्षेश्वराणां ते स्वरूपमिति वर्णितम् ।\nयच्छ्रुत्वा सर्वपापेभ्यो नरो मुच्येदसंशयम् ॥१६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 166}]