[{"id": 2123773, "chapter_id": 3654, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2123774, "chapter_id": 3654, "verse_number": "१", "content_sanskrit": "वनवासाय चक्रुस्ते मतिं पार्था पराजिताः ।\nअजिनान्युत्तरीयाणि जगृहुश्च यथाक्रमम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2123775, "chapter_id": 3654, "verse_number": "२", "content_sanskrit": "अजिनैः संवृतान् दृष्ट्वा हृतराज्यानरिन्दमान् ।\nप्रस्थितान् वनवासाय ततो दुश्शासनोऽब्रवीत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2123776, "chapter_id": 3654, "verse_number": "३", "content_sanskrit": "प्रवृत्तं धार्तराष्ट्रस्य चक्रं राज्ञो महात्मनः ।\nपरिभूताः पाण्डुसुता आर्तिं परमिकां गताः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2123777, "chapter_id": 3654, "verse_number": "४", "content_sanskrit": "अद्य देवाः सुप्रवृत्ताः सर्वैर्वर्त्मभिरच्छलैः ।\nगुणज्येष्ठास्तथा ज्येष्ठाः श्रेयांसो यद् वयं परैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2123778, "chapter_id": 3654, "verse_number": "५", "content_sanskrit": "नरकं पतिताः पार्था दीर्घकालमनन्तकम् ।\nसुखाच्च हीना राज्याच्च विनष्टाः शाश्वतीः समाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2123779, "chapter_id": 3654, "verse_number": "६", "content_sanskrit": "बलेन मत्ता ये ते स्म धार्तराष्ट्रान् प्रहासिषुः ।\nते निर्जिता हृतधना वनमेष्यन्ति पाण्डवाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2123780, "chapter_id": 3654, "verse_number": "७", "content_sanskrit": "चित्रान् सन्नाहानवमुञ्चन्तु पार्था\nवासांसि दिव्यानि च भानुमन्ति ।\nविवस्यन्तां रुरुचर्माणि तानि\nयथा ग्लहः सौबलेनाभ्युपेतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2123781, "chapter_id": 3654, "verse_number": "८", "content_sanskrit": "न सन्ति लोकेषु पुमांस ईदृशा\nइत्येवं वै भावितबुद्धयः सदा ।\nज्ञास्यन्ति ते त्मानमिमेऽद्य पाण्डवा\nविपर्यये षण्डतिला इवाफलाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2123782, "chapter_id": 3654, "verse_number": "९", "content_sanskrit": "अयं हि भावोदय ईदृशानां\nमनस्विनां कौरव मा भवेद्वः ।\nआदीक्षितानामजिनानि यद्वद्\nबलीयसां पाण्डवानां तथैव ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2123783, "chapter_id": 3654, "verse_number": "१०", "content_sanskrit": "महाप्राज्ञः सोमको यज्ञसेनः\nकन्यां पाञ्चालीं पाण्डवेभ्यः प्रदाय ।\nस चाकार्षीत् दुष्कृतं ते हसन्ति\nक्लीबाः पार्थाः पतयो याज्ञसेन्याः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2123784, "chapter_id": 3654, "verse_number": "११", "content_sanskrit": "प्रनष्टवृत्तानजिनानिवोषितान्\nदृष्ट्वाऽरण्ये निर्धनानप्रतिष्ठान् ।\nकां त्वं प्रीतिं लप्स्यसे याज्ञसेनि\nपतिं वृणीष्वान्यमथो यमिच्छसि ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2123785, "chapter_id": 3654, "verse_number": "१२", "content_sanskrit": "एते हि सर्वे कुरवः समेताः\nक्षान्ता दान्ताः सुद्रविणोपपन्नाः ।\nएषां वृणीष्वान्यतरं पतित्वे\nमा त्वां तपेत् कार्यविपर्ययोऽयम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2123786, "chapter_id": 3654, "verse_number": "१३", "content_sanskrit": "यथाऽफलाः षण्डतिला यथा चर्ममया मृगाः ।\nतथैव पाण्डवाः सर्वे यथा काकयवा अपि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2123787, "chapter_id": 3654, "verse_number": "१४", "content_sanskrit": "किं पाण्डवांस्त्वं पतितानुपास्से\nमोघः श्रमः षण्डतिलानुपास्य ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2123788, "chapter_id": 3654, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2123789, "chapter_id": 3654, "verse_number": "१५", "content_sanskrit": "एवं नृशंसः परुषाणि पार्थान्\nव्याश्रावयद् धृतराष्ट्रस्य पुत्रः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2123790, "chapter_id": 3654, "verse_number": "१६", "content_sanskrit": "तद्वै श्रुत्वा भीमसेनोऽत्यमर्षी\nनिर्भत्स्योच्चैः सन्निगृह्यैव रोषात् ।\nउवाचैनं सहसैवोपगम्य\nसिंहो यथा हैमवतः सृगालम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2123791, "chapter_id": 3654, "verse_number": "१७", "content_sanskrit": "क्रूर पापजनैर्जुष्टमकृतार्थं प्रभाषसे ।\nगान्धारविद्यया हि त्वं राजमध्ये विकत्थसे ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2123792, "chapter_id": 3654, "verse_number": "१८", "content_sanskrit": "यथा तुदसि मर्माणि वाक्शरैरिह नो भृशम् ।\nतथा स्मारयिता तेऽहं कृन्तन् मर्माणि संयुगे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2123793, "chapter_id": 3654, "verse_number": "१९", "content_sanskrit": "ये च त्वामनुवर्तन्ते कामलोभवशानुगम् ।\nगोप्तारः सानुबन्धांस्तान् नेष्यामि यमसादनम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2123794, "chapter_id": 3654, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2123795, "chapter_id": 3654, "verse_number": "२०", "content_sanskrit": "एवं ब्रुवाणमजिनैर्निवासितं\nदुःखाभिभूतं परिनृत्यति स्म ।\nमध्ये कुरूणामनिषिद्धमार्गं\nगौर्गौरिति स्माह्वयन् मुक्तलज्जः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2123796, "chapter_id": 3654, "verse_number": "", "content_sanskrit": "भीमसेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2123797, "chapter_id": 3654, "verse_number": "२१", "content_sanskrit": "नृशंस परुषं वक्तुं शक्यं दुश्शासन त्वया ।\nनिकृत्या हि धनं लब्ध्वा को विकत्थितुमर्हति ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2123798, "chapter_id": 3654, "verse_number": "२२", "content_sanskrit": "मा ह स्म सुकृतां लोकान् गच्छेत् पार्थो वृकोदरः ।\nयदि वक्षसि भित्त्वा ते न पिबेच्छोणितं रणे ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2123799, "chapter_id": 3654, "verse_number": "२३", "content_sanskrit": "धार्तराष्ट्रान् रणे हत्वा मिषतां सर्वधन्विनाम् ।\nशमं गन्तास्मि नचिरात् सत्यमेतत् ब्रवीमि ते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2123800, "chapter_id": 3654, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2123801, "chapter_id": 3654, "verse_number": "२४", "content_sanskrit": "ततः स राजा सिंहगतेः सहेळं\nदुर्योधनो भीमसेनस्य रोषात् ।\nगतिं सरोषादनुचकार मन्दो\nनिर्गच्छतां कौरवाणां सभायाः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2123802, "chapter_id": 3654, "verse_number": "२५", "content_sanskrit": "नैतावता कृतमित्यब्रवीत् तं\nवृकोदरः सन्निवृत्तार्धकायः ।\nशीघ्रं हि त्वां निहतं सानुबन्धं\nसंस्मार्याहं सम्प्रवक्ष्यामि मूढम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2123803, "chapter_id": 3654, "verse_number": "२६", "content_sanskrit": "एवं समीक्ष्यात्मनि वाच्यमानं\nनियम्य मन्युं बलवान् स मानी ।\nराजानुजः संसदि कौरवाणां\nविनिष्क्रमन् वाक्यमुवाच भीमः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2123804, "chapter_id": 3654, "verse_number": "२७", "content_sanskrit": "अहं दुर्योधनं हन्ता कर्णं हन्ता धनञ्जयः ।\nशकुनिं चाक्षकितवं सहदेवो हनिष्यति ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2123805, "chapter_id": 3654, "verse_number": "२८", "content_sanskrit": "इदं च भूयो वक्ष्यामि सभामध्ये महद् वचः ।\nसत्यं देवाः करिष्यन्ति यन्नो बुद्धं भविष्यति ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2123806, "chapter_id": 3654, "verse_number": "२९", "content_sanskrit": "सुयोधनमिमं पापं हन्तास्मि गदया युधि ।\nशिरः पादेन चास्याहमधिष्ठास्यामि भूतळे ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2123807, "chapter_id": 3654, "verse_number": "३०", "content_sanskrit": "वाक्यशूरस्य चैवास्य परुषस्य दुरात्मनः ।\nदुश्शासनस्य रुधिरं पातास्मि मृगराडिव ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2123808, "chapter_id": 3654, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2123809, "chapter_id": 3654, "verse_number": "३१", "content_sanskrit": "भीमसेन न ते सन्ति येषां वैरं त्वया सह ।\nमत्वा गृहेषु सुखिनो न बुद्ध्यन्ते महद्भयम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2123810, "chapter_id": 3654, "verse_number": "३२", "content_sanskrit": "न वै वाच्यं व्यवसितं भीम विज्ञायतां सताम् ।\nइतश्चतुर्दशे वर्षे द्रष्टारो यद् भविष्यति ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2123811, "chapter_id": 3654, "verse_number": "", "content_sanskrit": "भीमसेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2123812, "chapter_id": 3654, "verse_number": "३३", "content_sanskrit": "दुर्योधनस्य कर्णस्य शकुनेश्च दुरात्मनः ।\nदुश्शासनचतुर्थानां भूमिः पास्यति शोणितम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2123813, "chapter_id": 3654, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2123814, "chapter_id": 3654, "verse_number": "३४", "content_sanskrit": "असूनृतानां वक्तारं संहृष्टानां दुरात्मनाम् ।\nभीमसेन नियोगात् ते हन्ताऽहं कर्णमाहवे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2123815, "chapter_id": 3654, "verse_number": "३५", "content_sanskrit": "अर्जुनः प्रतिजानीते भीमस्य प्रियकाम्यया ।\nकर्णं कर्णानुगांश्चैव रणे हन्तास्मि पत्रिभिः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2123816, "chapter_id": 3654, "verse_number": "३६", "content_sanskrit": "ये चान्ये प्रतियोत्स्यन्ति बुद्धिमोहेन वै नृपाः ।\nतांश्च सर्वान् शितैर्बाणैर्नेतास्मि यमसादनम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2123817, "chapter_id": 3654, "verse_number": "३७", "content_sanskrit": "चलेद्धि हिमवान् स्थानान्निष्प्रभः स्याद्दिवाकरः ।\nशैत्यं सोमात् प्रणश्येत मत्सत्यं विचलेद् यदि ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2123818, "chapter_id": 3654, "verse_number": "३८", "content_sanskrit": "न प्रदास्यति चेद् राज्यमितो वर्षे चतुर्दशे ।\nदुर्योधनोऽपि सत्कृत्य सत्यमेतद् भविष्यति ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2123819, "chapter_id": 3654, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2123820, "chapter_id": 3654, "verse_number": "३९", "content_sanskrit": "इत्युक्तवति पार्थे तु श्रीमान् माद्रवतीसुतः ।\nप्रगृह्य विपुलं बाहुं सहदेवः प्रतापवान् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2123821, "chapter_id": 3654, "verse_number": "४०", "content_sanskrit": "सौबलस्य वधप्रेप्सुरिदं वचनमब्रवीत् ।\nक्रोधसंरक्तनयनो निश्श्वसन्निव पन्नगः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2123822, "chapter_id": 3654, "verse_number": "४१", "content_sanskrit": "अक्षाणि मूढ दुर्बुद्धे गान्धाराणां यशोहर ।\nनैतेऽक्षा निशिता बाणाः त्वयैते समरे वृताः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2123823, "chapter_id": 3654, "verse_number": "४२", "content_sanskrit": "यथैवेहोक्तवान् भीमः त्वामुद्दिश्य सबान्धवम् ।\nकर्ताऽहं कर्मणस्तस्य कुरु कार्याणि सर्वशः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2123824, "chapter_id": 3654, "verse_number": "४३", "content_sanskrit": "हन्तास्मि तरसा युद्धे त्वां विक्रम्य सबान्धवम् ।\nयदि स्थास्यसि सङ्ग्रामे क्षत्रधर्मेण सौबल ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2123825, "chapter_id": 3654, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2123826, "chapter_id": 3654, "verse_number": "४४", "content_sanskrit": "सहदेववचः श्रुत्वा नकुलोऽपि विशाम्पते ।\nदर्शनीयतमो नॄणामिदं वचनमब्रवीत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2123827, "chapter_id": 3654, "verse_number": "४५", "content_sanskrit": "सुतेयं यज्ञसेनस्य द्यूतेऽस्मिन् धृतराष्ट्रजैः ।\nयैर्वाचः श्राविता रूक्षाः स्थितैर्दुर्योधनप्रिये ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2123828, "chapter_id": 3654, "verse_number": "४६", "content_sanskrit": "धार्तराष्ट्रान् सुदुर्वृत्तान् मुमूर्षून् कालचोदितान् ।\nदर्शयिष्यामि भूयिष्ठमहं वैवस्वतक्षयम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2123829, "chapter_id": 3654, "verse_number": "४७", "content_sanskrit": "उलूकं च दुरात्मानं सौबलस्य सुतं प्रियम् ।\nक्रूरं हन्तास्मि समरे तं वै क्रूरं नराधमम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2123830, "chapter_id": 3654, "verse_number": "४८", "content_sanskrit": "निदेशाद् धर्मराजस्य द्रौपद्याः पदवीं चरन् ।\nनिर्धार्तराष्ट्रां पृथिवीं कर्तास्मि नचिरादिव ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2123831, "chapter_id": 3654, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2123832, "chapter_id": 3654, "verse_number": "४९", "content_sanskrit": "एवं ते पुरुषव्याघ्राः परिघायतबाहवः ।\nप्रतिज्ञां विपुलां कृत्वा धृतराष्ट्रमुपागमन् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2123833, "chapter_id": 3654, "verse_number": "४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि षण्णवतितमोऽध्यायः ॥९६॥\n॥ अनुद्यूतपर्वणि चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2123834, "chapter_id": 3654, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]