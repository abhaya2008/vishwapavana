[{"id": 2088711, "chapter_id": 2896, "verse_number": "१३-२६-१", "content_sanskrit": "`गरुड उवाच।\nकथं तौ भगवञ्शक्यौ मया वारणकच्छपौ॥\nयुगपद्गृहीतं तं मे त्वमुपायं वक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2088712, "chapter_id": 2896, "verse_number": "१३-२६-२x", "content_sanskrit": "कश्यय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2088713, "chapter_id": 2896, "verse_number": "१३-२६-२", "content_sanskrit": "योद्धुकामे गजे तस्मिन्मुहूर्तं स जलेचरः।\nउत्तिष्ठति जलात्तूर्णं योद्धुकामः पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2088714, "chapter_id": 2896, "verse_number": "१३-२६-३", "content_sanskrit": "जलजं निर्गतं तात प्रमत्तं चैव वारणम्।\nग्रहीष्यसि पतङ्गेश नान्यो योगोऽत्र विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2088715, "chapter_id": 2896, "verse_number": "१३-२६-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2088716, "chapter_id": 2896, "verse_number": "१३-२६-४", "content_sanskrit": "इत्येमुक्तो विहगस्तद्गत्वा वनमुत्तमम्।\nददर्श वारणेन्द्रं तं मेघाचलसमप्रभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2088717, "chapter_id": 2896, "verse_number": "१३-२६-५", "content_sanskrit": "तां स नागो गिरेर्वीथिं सम्प्राप्त इव भारतः।\nस तं दृष्ट्वा महाभागः सम्प्रहृष्टतनूरुहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2088718, "chapter_id": 2896, "verse_number": "१३-२६-६", "content_sanskrit": "बिभक्षयिषतो राजन्दारुणस्य महात्मनः॥\nमातङ्गं कच्छपं चैव प्रहर्षः सुमहानभूत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2088719, "chapter_id": 2896, "verse_number": "१३-२६-७", "content_sanskrit": "अथ वेगेन महता खेचरः स महाबलः।\nसङ्कुच्य सर्वगात्राणि कृच्छ्रेणैवान्वपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2088720, "chapter_id": 2896, "verse_number": "१३-२६-८", "content_sanskrit": "तथा गत्वा तमध्वानं वारणप्रवरो बली।\nनिशश्वास महाश्वासः श्रमाद्विश्रमणाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2088721, "chapter_id": 2896, "verse_number": "१३-२६-९", "content_sanskrit": "तस्य निश्वासवातेन मदगन्धेन चैव ह।\nउदतिष्ठन्महाकूर्मो वारणप्रतिषेधकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2088722, "chapter_id": 2896, "verse_number": "१३-२६-१०", "content_sanskrit": "तयोः सुतुमुलं युद्धं ददर्श पतगेश्वरः।\nकच्छपेन्द्रद्विरदयोरिन्द्रप्रह्वादयोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2088723, "chapter_id": 2896, "verse_number": "१३-२६-११", "content_sanskrit": "स्पृशन्तमग्रहस्तेन तोयं वारणयूथपम्।\nदन्तैर्नस्तैश्च जलजो वारयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2088724, "chapter_id": 2896, "verse_number": "१३-२६-१२", "content_sanskrit": "जलजं वारणोऽप्येवं चरणैः पुष्करेण च।\nप्रत्यषेधन्निमज्जन्तमुन्मज्जन्तं तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2088725, "chapter_id": 2896, "verse_number": "१३-२६-१३", "content_sanskrit": "मुहूर्तमभवद्युद्धं तयोर्भीमप्रदर्शनम्।\nअथ तस्माज्जलाद्राजन्कच्छपः स्थलमास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2088726, "chapter_id": 2896, "verse_number": "१३-२६-१४", "content_sanskrit": "स तु नागः प्रभग्रोऽपि पिपासुर्न न्यवर्तत।\nतोयगृध्नुः शनैस्तर्षादपासर्पत पृष्ठतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2088727, "chapter_id": 2896, "verse_number": "१३-२६-१५", "content_sanskrit": "तं दृष्ट्वा जलजस्तूर्णमपसर्पन्तमाहवात्।\nअभिदुद्राव वेगेन वज्रयाणिरिवासुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2088728, "chapter_id": 2896, "verse_number": "१३-२६-१६", "content_sanskrit": "तं रोषात्स्थलमुत्तीर्णमसम्प्राप्तं गजोत्तमम्।\nउभावेव समस्तौ तु जग्राह विनतासुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2088729, "chapter_id": 2896, "verse_number": "१३-२६-१७", "content_sanskrit": "चरणेन तु सव्येन जग्राह स गजोत्तमम्।\nप्रस्पन्दमानं बलवान्दक्षिणेन तु कच्छपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2088730, "chapter_id": 2896, "verse_number": "१३-२६-१८", "content_sanskrit": "उत्पपात ततस्तूर्णं पन्नगेन्द्रनिषूदतः।\nदिवं खं च समुत्पत्य पक्षाभ्यामपराजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2088731, "chapter_id": 2896, "verse_number": "१३-२६-१९", "content_sanskrit": "तेन चोत्पतता तूर्णं सङ्गृहीतौ नखैर्भृशम्।\nवज्रगर्भैः सुनिशितैः प्राणांस्तूर्णं मुमोचतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2088732, "chapter_id": 2896, "verse_number": "१३-२६-२०", "content_sanskrit": "तौ गृह्य बलवांस्तूर्णं स्रस्तपादशिरोधरौ।\nविवल्गन्निव खे क्रीडन्खेचरोऽभिजगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2088733, "chapter_id": 2896, "verse_number": "१३-२६-२१", "content_sanskrit": "अत्तुकामस्ततो वीरः पृथिव्यां पृथिवीपते।\nनिरैक्षत न चापश्यद्द्रुमं पर्याप्तमासितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2088734, "chapter_id": 2896, "verse_number": "१३-२६-२२", "content_sanskrit": "नैमिषं त्वथ सम्प्राप्य देवारण्यं महाद्युतिः।\nअपश्यत द्रुमं कञ्चिच्छाखास्कन्धसमावृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2088735, "chapter_id": 2896, "verse_number": "१३-२६-२३", "content_sanskrit": "हिमवच्छिखरप्रख्यं योजनद्वयमुच्छ्रितम्।\nपरिणाहेन राजेन्द्र नल्वमात्रं समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2088736, "chapter_id": 2896, "verse_number": "१३-२६-२४", "content_sanskrit": "तस्य शाखाऽभवत्काचिदायता पञ्चयोजनम्।\nदृढमूला दृढस्कन्धा वज्रपत्रसमाचिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2088737, "chapter_id": 2896, "verse_number": "१३-२६-२५", "content_sanskrit": "तत्रोपविष्टः सहसा वैनतेयो निगृह्य तौ।\nअत्तुकामस्ततः शाखा तस्य वेगादवापतत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2088738, "chapter_id": 2896, "verse_number": "१३-२६-२६", "content_sanskrit": "तां पतन्तीमभिप्रेक्ष्य प्रेक्ष्य चर्षिगणानधः।\nआसीनान्वसुभिः सार्धं सत्रेण जगतीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2088739, "chapter_id": 2896, "verse_number": "१३-२६-२७", "content_sanskrit": "वैखानसान्नाम यतीन्वालखिल्यगणानपि।\nतत्र भीराविशत्तस्य पतगेन्द्रस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2088740, "chapter_id": 2896, "verse_number": "१३-२६-२८", "content_sanskrit": "तान्दृष्ट्वा स यतींस्तत्र समासीनान्सुरैः सह।\nतुण्डेन गृह्य तां शाखामुत्पपात खगेश्वरः।\nतौच पक्षी भुजङ्गाशो व्योम्नि क्रीडन्निवाव्रजत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2088741, "chapter_id": 2896, "verse_number": "१३-२६-२९", "content_sanskrit": "तं दृष्ट्वा गुरुसम्भारं प्रगृह्योत्पतितं खगम्।\nऋषयस्तेऽब्रुवन्सर्वे गरुडोऽयमिति स्म ह।\nन त्वन्यः क्षमते कश्चिद्यथाऽयं वीर्यवान्खगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2088742, "chapter_id": 2896, "verse_number": "१३-२६-३०", "content_sanskrit": "असौ यच्छति धर्मात्मा गुरुभारसमन्वितः।\nअयं क्रीडन्निवाकाशे तस्माद्गरुड एव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2088743, "chapter_id": 2896, "verse_number": "१३-२६-३१", "content_sanskrit": "एवं ते समयं सर्वे वसवश्च दिवौकसः।\nअकार्षुः पक्षिराजस्य गरुडेत्येव नाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2088744, "chapter_id": 2896, "verse_number": "१३-२६-३२", "content_sanskrit": "स पक्षी पृथिवीं सर्वां परिधावंस्ततस्ततः।\nमुमुक्षः शाखिनः शाखां न स्म देशमपश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2088745, "chapter_id": 2896, "verse_number": "१३-२६-३३", "content_sanskrit": "स वाचमशृणोद्दिव्यामुपर्युपरि जल्पतः।\nदेवदूतस्य विस्पष्टमाभाष्य गरुडेति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2088746, "chapter_id": 2896, "verse_number": "१३-२६-३४", "content_sanskrit": "वैनतेय कुविन्देषु समुद्रान्ते महाबल।\nपात्यतां शाखिनः शाखा न हि ते धर्मनिश्चयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2088747, "chapter_id": 2896, "verse_number": "१३-२६-३५", "content_sanskrit": "तच्छ्रुत्वा गरुडस्तूर्णं जगाम लवणाम्भसः।\nउद्देशं यत्र ते मन्दाः कुविन्दाः पापकर्मिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2088748, "chapter_id": 2896, "verse_number": "१३-२६-३६", "content_sanskrit": "ततो गत्वा ततः शाखां मुमोच पततांवरः।\nतया हता ********* दास्तदा षड्विंशतो नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2088749, "chapter_id": 2896, "verse_number": "१३-२६-३७", "content_sanskrit": "स देशो राजशार्दूल ख्यातः परमदारुणः।\nशाखापतग इत्येव कुविन्दानां महात्मनाम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2088750, "chapter_id": 2896, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि षड्विंशोऽध्यायः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]