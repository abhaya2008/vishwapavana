[{"id": 2109501, "chapter_id": 3377, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2109502, "chapter_id": 3377, "verse_number": "१", "content_sanskrit": "पूरोर्वंशं महाधन्यं राज्ञाममिततेजसाम् ।\nप्रवक्ष्यामि पितॄणां ते तेषां नामानि मे शृणु \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2109503, "chapter_id": 3377, "verse_number": "२", "content_sanskrit": "अव्यक्तप्रभवो ब्रह्मा शाश्वतः नित्य अव्ययः ।\nतस्मान्मरीचिः सञ्जज्ञे दक्षश्चैव प्रजापतिः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2109504, "chapter_id": 3377, "verse_number": "३", "content_sanskrit": "अङ्गुष्ठाद् दक्षमसृजच्चक्षुर्भ्यां न मरीचिनम् ।\nमरीचेः काश्यपः पुत्रो दक्षस्य दुहिताऽदितिः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2109505, "chapter_id": 3377, "verse_number": "४", "content_sanskrit": "अदित्यां काश्यपस्य विवस्वान् । विवस्वतो मनुः मनोरिळा ॥ इळायाः पुरूरवाः । पुरूरवस आयुः । आयुषो नहुषः । नहुषस्य ययातिः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2109506, "chapter_id": 3377, "verse_number": "५", "content_sanskrit": "ययातेर्द्वे भार्ये बभूवतुः । उशनसो दुहिता देवयानी । वृष- पर्वणश्च दुहिता शर्मिष्ठा नाम \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2109507, "chapter_id": 3377, "verse_number": "६", "content_sanskrit": "तत्रानुवंशो भवति \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2109508, "chapter_id": 3377, "verse_number": "७", "content_sanskrit": "यदुं च तुर्वशुं चोभौ देवयानी व्यजायत ।\nद्रुह्युं चानुं च पूरुं च शर्मिष्ठा वार्षपर्वणी\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2109509, "chapter_id": 3377, "verse_number": "८", "content_sanskrit": "तत्र यदोर्यादवाः । पूरोः पौरवाः । पूरोर्भार्या कौसल्या बभूव। तस्यामस्य जज्ञे जनमेजयः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2109510, "chapter_id": 3377, "verse_number": "९", "content_sanskrit": "स त्रीन् हयमेधानाजहार । विश्वजिता चेष्ट्वा वनं प्रविवेश\n॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2109511, "chapter_id": 3377, "verse_number": "१०", "content_sanskrit": "जनमेजयस्तु खलु सुनन्दां नामोपयेमे । तस्यामस्य जज्ञे प्राचीन्वान् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2109512, "chapter_id": 3377, "verse_number": "११", "content_sanskrit": "यः प्राचीं दिशं जिगाय यावत्सूर्योदयात् । तत्तस्य प्राचीन्व- त्वम् \t\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2109513, "chapter_id": 3377, "verse_number": "१२", "content_sanskrit": "प्राचीन्वांस्तु खल्वाश्मकीमुपयेमे सुष्ठुवां नाम यादवीम् । तस्यामस्य जज्ञे शय्यातिः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2109514, "chapter_id": 3377, "verse_number": "१३", "content_sanskrit": "शय्यातिस्तु त्रिशङ्कोर्दुहितरं वराङ्गीं नामोपयेमे । तस्यामस्य जज्ञेऽहम्पातिः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2109515, "chapter_id": 3377, "verse_number": "१४", "content_sanskrit": "अहम्पातिस्तु खलु कृतवीर्यदुहितरमुपयेमे भानुमतीं नाम । तस्यामस्य सार्वभौमः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2109516, "chapter_id": 3377, "verse_number": "१५", "content_sanskrit": "सार्वभौमस्तु खलु जित्वाऽऽजहार कैकयीं सुन्दरां नाम । तस्यामस्य जज्ञे जयत्सेनः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2109517, "chapter_id": 3377, "verse_number": "१६", "content_sanskrit": "जयस्तेनस्तु खलु वैदर्भीमुपयेमे सुषावां नाम । तस्यामस्य जज्ञे अपराचीनः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2109518, "chapter_id": 3377, "verse_number": "१७", "content_sanskrit": "अपराचीनस्तु खलु वैदर्भीमपरामुपयेमे मर्यादां नाम । तस्या- मस्य जज्ञे ऋक्षः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2109519, "chapter_id": 3377, "verse_number": "१८", "content_sanskrit": "ऋक्षस्तु वामदेव्यामङ्गराजकन्यायामृक्षं पुत्रमजीजनत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2109520, "chapter_id": 3377, "verse_number": "१९", "content_sanskrit": "ऋक्षस्तु खलु तक्षकदुहितरं ज्वलन्तीं नामोपयेमे । तस्याम- न्तिनारमुत्पादयामास \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2109521, "chapter_id": 3377, "verse_number": "२०", "content_sanskrit": "अन्तिनारस्तु सरस्वत्यां द्वादशवार्षिकं सत्रमाजहार । तमु- दवसाने निर्वृत्ते सरस्वत्यभिगम्य भर्तारं वरयामास । तस्यां पुत्रं जनयामास त्रसुं नाम \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2109522, "chapter_id": 3377, "verse_number": "", "content_sanskrit": "अत्रानुवंशो भवति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2109523, "chapter_id": 3377, "verse_number": "२१", "content_sanskrit": "त्रस्नुः सरस्वतीपुत्र अन्तिनारादजायत ।\nइलिलं जनयामास कालिन्द्यां त्रस्नुरात्मजम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2109524, "chapter_id": 3377, "verse_number": "२२", "content_sanskrit": "स एव दुष्षन्तो विश्वामित्रदुहितरं शकुन्तलां नाम । तस्या-मस्य जज्ञे भरतः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2109525, "chapter_id": 3377, "verse_number": "", "content_sanskrit": "तत्रैमौ श्लोकौ भवतः –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2109526, "chapter_id": 3377, "verse_number": "२३", "content_sanskrit": "माता भस्त्रा पितुः पुत्रो यस्माज्जातः स एव सः ।\nभरस्व पुत्रं दुष्षन्त सत्यमाह शकुन्तला \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2109527, "chapter_id": 3377, "verse_number": "२४", "content_sanskrit": "रेतोधाः पुत्रं नयति नरदेव यमक्षयम् ।\nत्वं चास्य धाता गर्भस्य सत्यमाह शकुन्तला \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2109528, "chapter_id": 3377, "verse_number": "२५", "content_sanskrit": "ततोऽस्य भरतत्वम् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2109529, "chapter_id": 3377, "verse_number": "२६", "content_sanskrit": "भरतस्तु खलु काशेयीं सार्वसेनीमुपयेमे सुनन्दां नाम। तस्या- मस्य जज्ञे भुमन्युः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2109530, "chapter_id": 3377, "verse_number": "२७", "content_sanskrit": "भुमन्युस्तु खलु दाशार्हीमुपयेमे सुपर्णां नाम । तस्यामस्य जज्ञे सुहोत्रः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2109531, "chapter_id": 3377, "verse_number": "२८", "content_sanskrit": "सुहोत्रस्तु खल्वैक्ष्वाकीमुपयेमे जयन्तीं नाम । तस्यामस्य जज्ञे हस्ती । य इदं पुरं स्थापयामास । तस्माद्धस्तिनपुरत्वम्\n॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2109532, "chapter_id": 3377, "verse_number": "२९", "content_sanskrit": "हस्ती तु खलु त्रैगर्तीमुपयेमे यशोधरां नाम । तस्यामस्य जज्ञे विकुञ्जनः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2109533, "chapter_id": 3377, "verse_number": "३०", "content_sanskrit": "विकुञ्जनस्तु दाशार्हीमुपयेमे विन्दां नाम । तस्यामस्य जज्ञेऽजमीढः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2109534, "chapter_id": 3377, "verse_number": "", "content_sanskrit": "अजमीढस्य तु चतुर्विंशतिपुत्रशतं बभूव कैकय्यां नागायां गान्धार्यां विमलायामृक्षायामिति । पृथग्वंशकर्तारो नृपतयः॥३१", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2109535, "chapter_id": 3377, "verse_number": "३२", "content_sanskrit": "अजमीढादृक्षायां वंशकर्ता संवरणो जज्ञे \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2109536, "chapter_id": 3377, "verse_number": "३३", "content_sanskrit": "संवरणस्तु खलु वैवस्वतीं तपतीं नामोपयेमे । तस्यामस्य जज्ञे कुरुः \t\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2109537, "chapter_id": 3377, "verse_number": "३४", "content_sanskrit": "कुरुस्तु दाशार्हीमुपयेमे शुभाङ्गीं नाम । तस्यामस्य जज्ञे विडूरथः\n॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2109538, "chapter_id": 3377, "verse_number": "३५", "content_sanskrit": "विडूरथस्तु खलु मागधीमुपयेमे सम्प्रियां नाम । तस्यामस्य जज्ञेऽनश्वान् \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2109539, "chapter_id": 3377, "verse_number": "३६", "content_sanskrit": "अनश्वांस्तु मागधीमुपयेमे सुवेषां नाम । तस्यामस्य जज्ञे परीक्षित् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2109540, "chapter_id": 3377, "verse_number": "३७", "content_sanskrit": "परीक्षित्तु बाहुकामुपयेमेऽमृतां नाम । तस्यामस्य जज्ञे भीम-सेनः \t\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2109541, "chapter_id": 3377, "verse_number": "३८", "content_sanskrit": "भीमसेनस्तु खलु कैकयीमुपयेमे सुकुमारीं नाम । तस्यामस्य जज्ञे पर्यश्रवाः । यमाहुः प्रतीप इति \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2109542, "chapter_id": 3377, "verse_number": "३९", "content_sanskrit": "प्रतीपस्तु शैब्यामुपयेमे सुनन्दां नाम । तस्यां त्रीन् पुत्रानु- त्पादयामास देवापिं शन्तनुं बाह्लीकं चेति \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2109543, "chapter_id": 3377, "verse_number": "४०", "content_sanskrit": "देवापिस्तु खलु बाल एवारण्यं प्रविवेश । शन्तनुस्तु मही- पालोऽभवत् \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2109544, "chapter_id": 3377, "verse_number": "", "content_sanskrit": "तत्र श्लोको भवति –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2109545, "chapter_id": 3377, "verse_number": "", "content_sanskrit": "यं यं कराभ्यां स्पशति जीर्णं स सुखमश्नुते ।\nपुनर्युवाऽऽभ्यां भवति तस्मात् तं शन्तनुं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2109546, "chapter_id": 3377, "verse_number": "४१", "content_sanskrit": "तत्तस्य शन्तनुत्वम् \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2109547, "chapter_id": 3377, "verse_number": "४२", "content_sanskrit": "शन्तनुस्तु खलु गङ्गां भागीरथीमुपयेमे । तस्यामस्य जज्ञे\nदेवव्रतो नाम यमाहुर्भीष्म इति \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2109548, "chapter_id": 3377, "verse_number": "४३", "content_sanskrit": "भीष्मस्तु पितुः प्रीतिचिकीर्षया सत्यवतीमानयामास मातरम् । यामाहुः काळीति \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2109549, "chapter_id": 3377, "verse_number": "४४", "content_sanskrit": "तस्यां पूर्वं पराशरात् कन्यागर्भो द्वैपायनः । तस्यामेव शन्तनो- र्द्वौ पुत्रौ बभूवतुः चित्राङ्गदो विचित्रवीर्यश्चेति \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2109550, "chapter_id": 3377, "verse_number": "४५", "content_sanskrit": "चित्राङ्गदस्त्वप्राप्तयौवन एव गन्धर्वेण निहतः । ततो विचित्र- वीर्यो राजा बभूव \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2109551, "chapter_id": 3377, "verse_number": "", "content_sanskrit": "विचित्रवीर्यस्तु खलु काशिराजस्य सुते अम्बिकाम्बालिके उद- वहत् । स विचित्रवीर्योऽनुत्पन्नापत्य एव विदेहत्वं प्राप्तः ॥४६", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2109552, "chapter_id": 3377, "verse_number": "४७", "content_sanskrit": "ततो सत्यवती चिन्तयामास । कथं नु खलु शन्तनोः पिण्ड- विच्छेदो न स्यादिति \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2109553, "chapter_id": 3377, "verse_number": "४८", "content_sanskrit": "साऽथ द्वैपायनं चिन्तयामास सोऽग्रतः स्थितः किं करवाणीति मातरि । तं सत्यवत्युवाच भ्राता तेऽनपत्य एव स्वर्गतः तस्यार्थेऽपत्यमुत्पादयेति \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2109554, "chapter_id": 3377, "verse_number": "४९", "content_sanskrit": "स परमित्युवाच स तत्र त्रीन् पुत्रानुत्पादयामास । धृतराष्ट्रं पाण्डुं विदुरं चेति \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2109555, "chapter_id": 3377, "verse_number": "५०", "content_sanskrit": "धृतराष्ट्रस्य राज्ञः पुत्राणां शतं बभूव गान्धर्यां वरदानात् तेषां च धार्तराष्ट्राणां चत्वारः प्रधानाः दुर्योधनो दुश्शासनो विकर्ण- श्चित्रसेनश्च इति \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2109556, "chapter_id": 3377, "verse_number": "५१", "content_sanskrit": "पाण्डोस्तु कुन्ती माद्रीति स्त्रीरत्ने बभूवतुः । स मृगयां चरन् मैथुनगतमृषिं मृगचारिणं बाणेनाजघान \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2109557, "chapter_id": 3377, "verse_number": "५२", "content_sanskrit": "स बाणविद्ध उवाच पाण्डुम् \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2109558, "chapter_id": 3377, "verse_number": "", "content_sanskrit": "अत्र श्लोको भवति–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2109559, "chapter_id": 3377, "verse_number": "५३", "content_sanskrit": "योऽकृतार्थं हि मां क्रूर बाणेनाघ्ना मूगव्रतम् ।\nत्वामप्येतादृशो भावः क्षिप्रमेव गमिष्यति \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2109560, "chapter_id": 3377, "verse_number": "समाप्तिः", "content_sanskrit": "इति मृगव्रतचारिणा ऋषिणा शप्तः \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2109561, "chapter_id": 3377, "verse_number": "", "content_sanskrit": "स विषण्णरूपः पाण्डुस्तं शापं परिहरन् नोपसर्पति भार्ये ॥५५", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2109562, "chapter_id": 3377, "verse_number": "५६", "content_sanskrit": "आह च । स्वचापल्यादिदं प्राप्तवानहम् । शृणोमि नानपत्य- स्य लोकाः सन्तीति । ममार्थे पुत्रानुत्पादयेति कुन्तीमुवाच\n॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2109563, "chapter_id": 3377, "verse_number": "५७", "content_sanskrit": "सा पुत्रानुत्पादयामास धर्माद् युधिष्ठिरं मारुताद् भीमसेन- मिन्द्रादर्जुनमिति \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2109564, "chapter_id": 3377, "verse_number": "५८", "content_sanskrit": "प्रहृष्टरूपः पाण्डुरुवाचैवम् इयं ते माद्री सपत्नी ह्यनपत्या व्रीडिता साध्वी चैवमस्यामपत्यमुत्पाद्यतामिति सा तथेति तस्यै व्रतमादिदेश \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2109565, "chapter_id": 3377, "verse_number": "५९", "content_sanskrit": "तस्यां नकुलसहदेवौ यमावश्विभ्यां जज्ञाते \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2109566, "chapter_id": 3377, "verse_number": "६०", "content_sanskrit": "माद्रीं तु स्वलङ्कृतां दृष्ट्वा पाण्डुर्भावं चक्रे । स तां प्राप्यैव विदेहत्वं प्राप्तः \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2109567, "chapter_id": 3377, "verse_number": "६१", "content_sanskrit": "तत्रैनं चितायामन्वारुरोह माद्री । कुन्तीं चोवाच यमयोरा- र्ययाऽप्रमत्तया भवितव्यमिति \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2109568, "chapter_id": 3377, "verse_number": "६२", "content_sanskrit": "ततः पञ्च पाण्डवान् कुन्त्या सह हस्तिनपुरं नयन्ति स्म सुतपस्विनः \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2109569, "chapter_id": 3377, "verse_number": "६३", "content_sanskrit": "तत्र भीष्माय धृतराष्ट्रविदुरयोः पाण्डोः स्वर्गगमनं याथातथ्यं निवेदयन्ति स्म तपस्विनः \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2109570, "chapter_id": 3377, "verse_number": "६४", "content_sanskrit": "पाण्डवान् सह कुन्त्या जतुगृहे दाहयितुकामो धृतराष्ट्रा- त्मजोऽभूत् \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2109571, "chapter_id": 3377, "verse_number": "६५", "content_sanskrit": "तांश्च विदुरो मोक्षयित्वा प्रीतोऽभवत् \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2109572, "chapter_id": 3377, "verse_number": "६६", "content_sanskrit": "ततो हिडिम्बं हत्वा पुत्रमुत्पादयामास भीमः । तत एकचक्रां जग्मुः कुशलिनः \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2109573, "chapter_id": 3377, "verse_number": "६७", "content_sanskrit": "पाञ्चालविषयं गत्वा स्वयंवरे द्रौपदीं लब्ध्वाऽर्धराज्यं प्राप्ये- न्द्रप्रस्थनिवासिनस्तस्यां पुत्रानुत्पादयामासुर्दौपद्यां प्रतिविन्ध्यं युधिष्ठिरः सुतसोमं वृकोदरः श्रुतकीर्तिमर्जुनः । शतानीकं\nनकुलः । श्रुतकर्माणं सहदेव इति \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2109574, "chapter_id": 3377, "verse_number": "६८", "content_sanskrit": "शैव्यस्य कन्यां देवकीं नामोपयेमे युधिष्ठिरः । तस्यां पुत्रं जनयामास युधिष्ठिरो यौधेयं नाम \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2109575, "chapter_id": 3377, "verse_number": "६९", "content_sanskrit": "भीमसेनस्तु खलु वाराणस्यां काशिराजकन्यां बलधारीं नामो- दवहत् स्वयंवरस्थाम् । तस्यामस्य जज्ञे शर्वत्रातः ॥ ६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2109576, "chapter_id": 3377, "verse_number": "७०", "content_sanskrit": "भीमसेनस्तु पूर्वमेव हिडिम्बायां राक्षस्यां जनयामास घटोत्कचं नाम \t\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2109577, "chapter_id": 3377, "verse_number": "७१", "content_sanskrit": "अर्जुनस्तु खलु द्वारवतीं गत्वा भगवतो वासुदेवस्य भगिनीं सुभद्रां नामोदवहत् । तस्यामभिमन्युं नाम पुत्रं जनयामास\n॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2109578, "chapter_id": 3377, "verse_number": "७२", "content_sanskrit": "अर्जुनस्तु नागकन्यायामुलूप्यामिरावन्तं नाम पुत्रं जनयामास\n॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2109579, "chapter_id": 3377, "verse_number": "७३", "content_sanskrit": "ततो मणलूरुपतिकन्यायां चित्राङ्गदायामर्जुनः पुत्रमुत्पाद-यामास बभ्रुवाहनं नाम \t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2109580, "chapter_id": 3377, "verse_number": "७४", "content_sanskrit": "नकुलस्तु खलु चैद्यां रेणुमतीं नामोपयेमे । तस्यां पुत्रं जनया- मास निरमित्रं नाम \t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2109581, "chapter_id": 3377, "verse_number": "७५", "content_sanskrit": "सहदेवस्तु खलु माद्रीमेव स्वयंवरे विजयां नामोदवहद्\nभार्याम् । तस्यां पुत्रं जनयामास सुहोत्रं नाम \t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2109582, "chapter_id": 3377, "verse_number": "७६", "content_sanskrit": "एते त्रयोदश पुत्राः पाण्डवानाम् \t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2109583, "chapter_id": 3377, "verse_number": "७७", "content_sanskrit": "विराटस्य दुहितरमुत्तरां नामाभिमन्युरुपयेमे । तस्यामस्य परासुर्गर्भोऽजायत \t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2109584, "chapter_id": 3377, "verse_number": "७७", "content_sanskrit": "तमुत्सङ्गे प्रतिजग्राह पृथिवी नियोगात् पुरुषोत्तमस्य ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2109585, "chapter_id": 3377, "verse_number": "७८", "content_sanskrit": "सुभद्रायाः षाण्मासिकं गर्भमिमं जीवयामि पादस्पर्शादिति वासुदेव उवाच \t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2109586, "chapter_id": 3377, "verse_number": "७९", "content_sanskrit": "अहं जीवयामि कुमारमनन्तवीर्यं जात एवायमजायत । अभि- मन्योः सत्येन चेयं पृथिवी धारयत्विति वासुदेवस्य पादस्पर्शात् सजीवोऽजायत ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2109587, "chapter_id": 3377, "verse_number": "", "content_sanskrit": "नाम तस्याकरोत् सुभद्रा । परिक्षीणे कुले जात उत्तरायां पर- न्तपः । परीक्षिदभयत् तस्मात् सौभद्रात् तु यशस्विनः ॥८०", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2109588, "chapter_id": 3377, "verse_number": "८१", "content_sanskrit": "परीक्षित् तु खलु मुद्रवतीं नामोपयेमे । तस्यां तत्र भवान् जनमेजयः \t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2109589, "chapter_id": 3377, "verse_number": "८२", "content_sanskrit": "जनमेजयात्तु भवतः खलु वपुष्टमायां पुत्रौ द्वौ शतानीकः शङ्खश्च \t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2109590, "chapter_id": 3377, "verse_number": "८३", "content_sanskrit": "शतानीकस्तु खलु वैदेहीमुपयेमे । तस्यामस्य जज्ञे पुत्रोऽश्वमेध- दत्तः \t\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2109591, "chapter_id": 3377, "verse_number": "८४", "content_sanskrit": "इत्येष पूरोर्वंशश्च पाण्डवानां च कीर्तितः ।\nपूरोर्वंशमिमं श्रुत्वा सर्वपापैः प्रमुच्यते \t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2109592, "chapter_id": 3377, "verse_number": "४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nषट्पञ्चाशत्तमोऽध्यायः॥५६॥ ॥ सम्भवपर्वणि चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}]