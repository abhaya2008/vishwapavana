[{"id": 5000529000, "chapter_id": 9529, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे द्वाविंशत्यधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000529001, "chapter_id": 9529, "verse_number": "६-१२२-१", "content_sanskrit": "उपस्थितं तु तं कृत्वा पुष्पकं पुष्पभूषितम्।\nअविदूरे स्थितो राममित्युवाच विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000529002, "chapter_id": 9529, "verse_number": "६-१२२-२", "content_sanskrit": "स तु बद्धाञ्जलिपुटो विनीतो राक्षसेश्वरः।\nअब्रवीत् त्वरयोपेतः किं करोमीति राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000529003, "chapter_id": 9529, "verse_number": "६-१२२-३", "content_sanskrit": "तमब्रवीन्महातेजा लक्ष्मणस्योपशृण्वतः।\nविमृश्य राघवो वाक्यमिदं स्नेहपुरस्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000529004, "chapter_id": 9529, "verse_number": "६-१२२-४", "content_sanskrit": "कृतप्रयत्नकर्माणः सर्व एव वनौकसः।\nरत्नैरर्थैश्च विविधैः सम्पूज्यन्तां विभीषण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000529005, "chapter_id": 9529, "verse_number": "६-१२२-५", "content_sanskrit": "सहामीभिस्त्वया लङ्का निर्जिता राक्षसेश्वर।\nहृष्टैः प्राणभयं त्यक्त्वा संग्रामेष्वनिवर्तिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000529006, "chapter_id": 9529, "verse_number": "६-१२२-६", "content_sanskrit": "त इमे कृतकर्माणः सर्व एव वनौकसः।\nधनरत्नप्रदानैश्च कर्मैषां सफलं कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000529007, "chapter_id": 9529, "verse_number": "६-१२२-७", "content_sanskrit": "एवं सम्मानिताश्चैते नन्द्यमाना यथा त्वया।\nभविष्यन्ति कृतज्ञेन निर्वृता हरियूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000529008, "chapter_id": 9529, "verse_number": "६-१२२-८", "content_sanskrit": "त्यागिनं संग्रहीतारं सानुक्रोशं जितेन्द्रियम्।\nसर्वे त्वामभिगच्छन्ति ततः सम्बोधयामि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000529009, "chapter_id": 9529, "verse_number": "६-१२२-९", "content_sanskrit": "हीनं रतिगुणैः सर्वैरभिहन्तारमाहवे।\nसेना त्यजति संविग्ना नृपतिं तं नरेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000529010, "chapter_id": 9529, "verse_number": "६-१२२-१०", "content_sanskrit": "एवमुक्तस्तु रामेण वानरांस्तान् विभीषणः।\nरत्नार्थसंविभागेन सर्वानेवाभ्यपूजयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000529011, "chapter_id": 9529, "verse_number": "६-१२२-११", "content_sanskrit": "ततस्तान् पूजितान् दृष्ट्वा रत्नार्थैर्हरियूथपान्।\nआरुरोह तदा रामस्तद् विमानमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000529012, "chapter_id": 9529, "verse_number": "६-१२२-१२", "content_sanskrit": "अङ्केनादाय वैदेहीं लज्जमानां मनस्विनीम्।\nलक्ष्मणेन सह भ्रात्रा विक्रान्तेन धनुष्मता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000529013, "chapter_id": 9529, "verse_number": "६-१२२-१३", "content_sanskrit": "अब्रवीत् स विमानस्थः पूजयन् सर्ववानरान्।\nसुग्रीवं च महावीर्यं काकुत्स्थः सविभीषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000529014, "chapter_id": 9529, "verse_number": "६-१२२-१४", "content_sanskrit": "मित्रकार्यं कृतमिदं भवद्भिर्वानरर्षभाः।\nअनुज्ञाता मया सर्वे यथेष्टं प्रतिगच्छत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000529015, "chapter_id": 9529, "verse_number": "६-१२२-१५", "content_sanskrit": "यत् तु कार्यं वयस्येन स्निग्धेन च हितेन च।\nकृतं सुग्रीव तत् सर्वं भवताधर्मभीरुणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000529016, "chapter_id": 9529, "verse_number": "६-१२२-१६", "content_sanskrit": "किष्किन्धां प्रति याह्याशु स्वसैन्येनाभिसंवृतः।\nस्वराज्ये वस लङ्कायां मया दत्ते विभीषण।\nन त्वां धर्षयितुं शक्ताः सेन्द्रा अपि दिवौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000529017, "chapter_id": 9529, "verse_number": "६-१२२-१७", "content_sanskrit": "अयोध्यां प्रति यास्यामि राजधानीं पितुर्मम।\nअभ्यनुज्ञातुमिच्छामि सर्वानामन्त्रयामि वः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000529018, "chapter_id": 9529, "verse_number": "६-१२२-१८", "content_sanskrit": "एवमुक्तास्तु रामेण हरीन्द्रा हरयस्तथा।\nऊचुः प्राञ्जलयः सर्वे राक्षसश्च विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000529019, "chapter_id": 9529, "verse_number": "६-१२२-१९", "content_sanskrit": "अयोध्यां गन्तुमिच्छामः सर्वान् नयतु नो भवान्।\nमुद्युक्ता विचरिष्यामो वनान्युपवनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000529020, "chapter_id": 9529, "verse_number": "६-१२२-२०", "content_sanskrit": "दृष्ट्वा त्वामभिषेकार्द्रं कौसल्यामभिवाद्य च।\nअचिरादागमिष्यामः स्वगृहान् नृपसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000529021, "chapter_id": 9529, "verse_number": "६-१२२-२१", "content_sanskrit": "एवमुक्तस्तु धर्मात्मा वानरैः सविभीषणैः।\nअब्रवीद् वानरान् रामः ससुग्रीवविभीषणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000529022, "chapter_id": 9529, "verse_number": "६-१२२-२२", "content_sanskrit": "प्रियात् प्रियतरं लब्धं यदहं ससुहृज्जनः।\nसर्वैर्भवद्भिः सहितः प्रीतिं लप्स्ये पुरीं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000529023, "chapter_id": 9529, "verse_number": "६-१२२-२३", "content_sanskrit": "क्षिप्रमारोह सुग्रीव विमानं सह वानरैः।\nत्वमप्यारोह सामात्यो राक्षसेन्द्र विभीषण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000529024, "chapter_id": 9529, "verse_number": "६-१२२-२४", "content_sanskrit": "ततः स पुष्पकं दिव्यं सुग्रीवः सह वानरैः।\nआरुरोह मुदा युक्तः सामात्यश्च विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000529025, "chapter_id": 9529, "verse_number": "६-१२२-२५", "content_sanskrit": "तेष्वारूढेषु सर्वेषु कौबेरं परमासनम्।\nराघवेणाभ्यनुज्ञातमुत्पपात विहायसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000529026, "chapter_id": 9529, "verse_number": "६-१२२-२६", "content_sanskrit": "खगतेन विमानेन हंसयुक्तेन भास्वता।\nप्रहृष्टश्च प्रतीतश्च बभौ रामः कुबेरवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000529027, "chapter_id": 9529, "verse_number": "६-१२२-२७", "content_sanskrit": "ते सर्वे वानरर्क्षाश्च राक्षसाश्च महाबलाः।\nयथासुखमसम्बाधं दिव्ये तस्मिन्नुपाविशन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000529028, "chapter_id": 9529, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे द्वाविंशत्यधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]