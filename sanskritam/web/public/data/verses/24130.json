[{"id": 7004130000, "chapter_id": 24130, "verse_number": "४-७९-१", "content_sanskrit": "स्कंद उवाच ।\nआनंदबाष्पसलिलरुद्धकंठं विलोक्य तम् ।\nमृडः पस्पर्श पाणिभ्यां सौधाभ्यां तु सुधांबुधिः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004130001, "chapter_id": 24130, "verse_number": "४-७९-२", "content_sanskrit": "अथ तत्स्पर्शसौख्येन धर्मराजो महातपाः ।\nपुनरंकुरयामास तपोग्नि ज्वलितां तनुम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004130002, "chapter_id": 24130, "verse_number": "४-७९-३", "content_sanskrit": "ततः प्रोवाच स ब्राध्निर्देव देवमुमापतिम् ।\nप्रसन्नवदनं शांतं शांतपारिषदावृतम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004130003, "chapter_id": 24130, "verse_number": "४-७९-४", "content_sanskrit": "प्रसन्नोसि यदीशान सर्वज्ञ करुणानिधे ।\nकिमन्येन वरेणात्र यत्त्वं साक्षात्कृतो मया ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004130004, "chapter_id": 24130, "verse_number": "४-७९-५", "content_sanskrit": "यं न वेदा विदुः सम्यङ्न च तौ वेदपूरुषौ ।\nततोपि वरयोग्योस्मि तन्नाथ प्रार्थयाम्यहम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004130005, "chapter_id": 24130, "verse_number": "४-७९-६", "content_sanskrit": "श्रीकंठांडज डिंभानाममीषां मधुरब्रुवाम् ।\nमत्तपश्चिरसाक्षीणां मत्पुरः प्राप्तजन्मनाम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004130006, "chapter_id": 24130, "verse_number": "४-७९-७", "content_sanskrit": "पितृभ्यां परिहीनानामितिहास कथाविदाम् ।\nत्यक्ताहारविहाराणां कीराणां वरदो भव ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004130007, "chapter_id": 24130, "verse_number": "४-७९-८", "content_sanskrit": "एतत्प्रसूतिसमये आमयेन प्रपीडिता ।\nशुकी पंचत्वमापन्ना शुकः श्येनेन भक्षितः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004130008, "chapter_id": 24130, "verse_number": "४-७९-९", "content_sanskrit": "रक्षितानामनाथानां सदा मन्मुखदर्शिनाम् ।\nअनाथनाथ भवता ह्यायुःशेषस्वरूपिणा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004130009, "chapter_id": 24130, "verse_number": "४-७९-१०", "content_sanskrit": "इति धर्मवचः श्रुत्वा परोपकृतिनिर्मलम् ।\nतानाहूय मुने शंभुर्विनयावनताननान् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004130010, "chapter_id": 24130, "verse_number": "४-७९-११", "content_sanskrit": "उवाच धर्मेति प्रीतः शुकशावानिदं वचः ।\nअयि पत्त्ररथा ब्रूत साधवो धर्मसंगताः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004130011, "chapter_id": 24130, "verse_number": "४-७९-१२", "content_sanskrit": "को वरो भवता देयो धर्मेश परिचारिणाम् ।\nसाधुसंसर्गसंक्षीण जन्मांतरमहैनसाम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004130012, "chapter_id": 24130, "verse_number": "४-७९-१३", "content_sanskrit": "इति श्रुत्वा महेशस्य वचनं ते पतत्त्रिणः ।\nप्रोचुः प्रणम्य देवेशं नमस्ते भवनाशन ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004130013, "chapter_id": 24130, "verse_number": "४-७९-१४", "content_sanskrit": "पक्षिण ऊचुः ।\nअनाथनाथ सर्वज्ञ को वरो नः समीहितः ।\nइतोपि त्र्यक्ष यत्साक्षात्तिर्यक्त्वेपि समीक्षिताः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004130014, "chapter_id": 24130, "verse_number": "४-७९-१५", "content_sanskrit": "लाभाः संतूद्यमवतां गिरीशेह परः शताः ।\nपरं परोयं लाभोत्र यत्त्वं दृग्गोचरी भवेः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004130015, "chapter_id": 24130, "verse_number": "४-७९-१६", "content_sanskrit": "यदेतद्दृश्यते नाथ तत्सर्वं क्षणभंगुरम् ।\nअभंगुरो भवानेकस्त्वत्सपर्याप्यभंगुरा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004130016, "chapter_id": 24130, "verse_number": "४-७९-१७", "content_sanskrit": "विचित्रजन्मकोटीनां स्मृतिर्नोत्र परिस्फुरेत् ।\nएतत्तपस्विरचितलिंगपूजा विलोकनात् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004130017, "chapter_id": 24130, "verse_number": "४-७९-१८", "content_sanskrit": "देवयोनिरपि प्राप्ता चिरमस्माभिरीशितः ।\nदिव्यांगना सहस्राणि तत्र भुक्त्वा स्वलीलया ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004130018, "chapter_id": 24130, "verse_number": "४-७९-१९", "content_sanskrit": "आसुरी दानवी नागी नैरृती चापि कैन्नरी ।\nविद्याधरी च गांधर्वी योनिरस्माभिरर्जिता ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004130019, "chapter_id": 24130, "verse_number": "४-७९-२०", "content_sanskrit": "नरत्वे भूपतित्वं च परिप्राप्तमनेकशः ।\nजले जलचरत्वं च स्थले च स्थलचारिता ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004130020, "chapter_id": 24130, "verse_number": "४-७९-२१", "content_sanskrit": "वने वनौकसो जाता ग्रामेषु ग्रामवासिनः ।\nदातारो याचितारश्च रक्षितारश्च घातुकाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004130021, "chapter_id": 24130, "verse_number": "४-७९-२२", "content_sanskrit": "सुखिनोपि वयं जाता दुःखिनो वयमास्म च ।\nजेतारश्च वयं जाताः पराजेतार एव च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004130022, "chapter_id": 24130, "verse_number": "४-७९-२३", "content_sanskrit": "अधीतिनोपि मूर्खाश्च स्वामिनः सेवका अपि ।\nचतुर्षु भूतग्रामेषु उत्तमाधममध्यमाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004130023, "chapter_id": 24130, "verse_number": "४-७९-२४", "content_sanskrit": "अभूम भूरिशः शंभो न क्वापि स्थैर्यमागताः ।\nइतोयोनेस्ततो योनौ ततो योनेस्ततोन्यतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004130024, "chapter_id": 24130, "verse_number": "४-७९-२५", "content_sanskrit": "पिनाकिन्क्वापि न प्रापि सुखलेशो मनागपि ।\nइदानीं पुण्यसंभारैर्धर्मेश्वरविलोकनात् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004130025, "chapter_id": 24130, "verse_number": "४-७९-२६", "content_sanskrit": "तापनेःसुतपो वह्निज्वालाप्रज्वलितैनसः ।\nसंवीक्ष्य त्र्यक्ष साक्षात्त्वां कृतकृत्या बभूविम ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004130026, "chapter_id": 24130, "verse_number": "४-७९-२७", "content_sanskrit": "तथापि चेद्वरो देयस्तिर्यक्ष्वस्मासु धूर्जटे ।\nकृपणेष्वपि शोच्येषु ज्ञानं सर्वज्ञ देहि तत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004130027, "chapter_id": 24130, "verse_number": "४-७९-२८", "content_sanskrit": "येन ज्ञानेन मुक्ताः स्मोऽमुष्मात्संसारबंधनात् ।\nयंत्रिताः प्राकृतैः पाशैरदुर्भेद्यैश्च मादृशैः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004130028, "chapter_id": 24130, "verse_number": "४-७९-२९", "content_sanskrit": "ऐंद्रं पदं न वांछामो न चांद्रं नान्यदेव हि ।\nवाञ्छामः केवलं मृत्युं काश्यां शंभोऽपुनर्भवम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004130029, "chapter_id": 24130, "verse_number": "४-७९-३०", "content_sanskrit": "त्वत्सान्निध्याद्विजानीमः सर्वज्ञ सकलं वयम् ।\nयथा चंदनसंसर्गात्सर्वे सुरभयो द्रुमाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004130030, "chapter_id": 24130, "verse_number": "४-७९-३१", "content_sanskrit": "एतदेव परं ज्ञानं संसारोच्छित्तिकारणम् ।\nवपुर्विसर्जनं काले यत्तवानंदकानने ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004130031, "chapter_id": 24130, "verse_number": "४-७९-३२", "content_sanskrit": "निर्मथ्य विष्वग्वाग्जालं सारभूतमिदं परम् ।\nब्रह्मणोदीरितं पूर्वं काश्यां मुक्तिस्तनुत्यजाम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004130032, "chapter_id": 24130, "verse_number": "४-७९-३३", "content_sanskrit": "यद्वाच्यं बहुभिर्ग्रंथैस्तदष्टाभिरिहाक्षरैः ।\nहरिणोक्तं रविपुरः कैवल्यं काशिसंस्थितौ ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004130033, "chapter_id": 24130, "verse_number": "४-७९-३४", "content_sanskrit": "याज्ञवल्क्यो मुनिवरः प्रोक्तवान्मुनिसंसदि ।\nरवेरधीत्य निगमान्काश्यामंते परं पदम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004130034, "chapter_id": 24130, "verse_number": "४-७९-३५", "content_sanskrit": "स्वामिनापि जगद्धात्री पुरतो मंदराचले ।\nइदमेव पुरा प्रोक्तं काशीनिर्वाणजन्मभूः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004130035, "chapter_id": 24130, "verse_number": "४-७९-३६", "content_sanskrit": "कृष्णद्वैपायनोप्येवं शंभो वक्ष्यति नान्यथा ।\nयत्रविश्वेश्वरः साक्षान्मुक्तिस्तत्र पदेपदे ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004130036, "chapter_id": 24130, "verse_number": "४-७९-३७", "content_sanskrit": "वदंत्यन्येपि मुनयस्तीर्थसंन्यासकारिणः ।\nचिरंतना लोमशाद्याः काशिका मुक्तिकाशिका ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004130037, "chapter_id": 24130, "verse_number": "४-७९-३८", "content_sanskrit": "वयमप्येवं जानीमो यत्र स्वर्गतरंगिणी ।\nआनंदकानने शंर्भोमोक्षस्तत्रैव निश्चितम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004130038, "chapter_id": 24130, "verse_number": "४-७९-३९", "content_sanskrit": "भूतं भावि भविष्यं यत्स्वर्गे मर्त्ये रसातले ।\nतत्सर्वमेव जानीमो धर्मेशानुग्रहात्परात् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004130039, "chapter_id": 24130, "verse_number": "४-७९-४०", "content_sanskrit": "अतो हिरण्यगर्भोक्तं हरिप्रोक्तं मुनीरितम् ।\nभवतोक्तं च निखिलं शंभो जानीमहे वयम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004130040, "chapter_id": 24130, "verse_number": "४-७९-४१", "content_sanskrit": "करामलकवत्सर्वमेतद्ब्रह्मांडगोलकम् ।\nअस्मद्वाग्गोचरेऽस्त्येव धर्मपीठनिषेवणात् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004130041, "chapter_id": 24130, "verse_number": "४-७९-४२", "content_sanskrit": "धर्मराजस्य तपसा तिर्यञ्चोपि वयं विभो ।\nजाताः स्म निर्विकल्पं हि सर्वज्ञानस्य भाजनम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004130042, "chapter_id": 24130, "verse_number": "४-७९-४३", "content_sanskrit": "मधुरं मृदुलं सत्यं स्वप्रमाणं सुसंस्कृतम् ।\nहितं मितं सदृष्टांतं श्रुत्वा पक्षिसुभाषितम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004130043, "chapter_id": 24130, "verse_number": "४-७९-४४", "content_sanskrit": "देवोतिविस्मयापन्नो ऽवर्णयत्पीठगौरवम् ।\nत्रैलोक्यनगरे चात्र काशीराजगृहं मम ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004130044, "chapter_id": 24130, "verse_number": "४-७९-४५", "content_sanskrit": "तत्रापि भोगभवनमनर्घ्यमणिनिर्मितम् ।\nमोक्षलक्ष्मीविलासाख्यः प्रासादो मेति शर्मभूः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004130045, "chapter_id": 24130, "verse_number": "४-७९-४६", "content_sanskrit": "पतत्त्रिणो पिमुच्यंते यं कुर्वाणाः प्रदक्षिणम् ।\nस्वेच्छया विचरंतः खे खेचरा अपि देवताः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004130046, "chapter_id": 24130, "verse_number": "४-७९-४७", "content_sanskrit": "मोक्षलक्ष्मीविलासाख्य प्रासादस्य विलोकनात् ।\nशरीराद्दूरतो याति ब्रह्महत्यापि नान्यथा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004130047, "chapter_id": 24130, "verse_number": "४-७९-४८", "content_sanskrit": "मोक्षलक्ष्मीविलासस्य कलशो यैर्निरीक्षतः ।\nनिधानकलशास्तांस्तु न मुंचंति पदेपदे ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004130048, "chapter_id": 24130, "verse_number": "४-७९-४९", "content_sanskrit": "दूरतोपि पताकापि मम प्रासादमूर्धगा ।\nनेत्रातिथी कृता यैस्तु नित्यं तेऽतिथयो मम ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004130049, "chapter_id": 24130, "verse_number": "४-७९-५०", "content_sanskrit": "भूमिं भित्त्वा स्वयं जातस्तत्प्रासादमिषेण हि ।\nआनंदाख्यस्य कंदस्य कोप्येष परमोंकुरः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004130050, "chapter_id": 24130, "verse_number": "४-७९-५१", "content_sanskrit": "ब्रह्मादिस्थावरांतानि यत्र रूपण्यनेकशः ।\nमामेवोपासते नित्यं चित्रं चित्रगतान्यपि ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004130051, "chapter_id": 24130, "verse_number": "४-७९-५२", "content_sanskrit": "ससौधो मेखिले लोके स्थानं परमनिर्वृतेः ।\nरतिशाला स मे रम्या स मे विश्वासभूमिका ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004130052, "chapter_id": 24130, "verse_number": "४-७९-५३", "content_sanskrit": "मम सर्वगतस्यापि प्रासादोयं परास्पदम् ।\nपरं ब्रह्म यदाम्नातं परमोपनिषद्गिरा ।\nअमूर्तं तदहं मूर्तो भूयां भक्तकृपावशात् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004130053, "chapter_id": 24130, "verse_number": "४-७९-५४", "content_sanskrit": "नैःश्रेयस्याः श्रियो धाम तद्याम्यां मंडपोस्ति मे ।\nतत्राहं सततं तिष्ठे तत्सदोमंडपं मम ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004130054, "chapter_id": 24130, "verse_number": "४-७९-५५", "content_sanskrit": "निमेषार्धप्रमाणं च कालं तिष्ठति निश्चलः ।\nतत्र यस्तेन वै योगः समभ्यस्तः समाः शतम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004130055, "chapter_id": 24130, "verse_number": "४-७९-५६", "content_sanskrit": "निर्वाणमंडपं नाम तत्स्थानं जगतीतले ।\nतत्रर्चं संजपन्नेकां लभेत्सर्वश्रुतेः फलम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004130056, "chapter_id": 24130, "verse_number": "४-७९-५७", "content_sanskrit": "प्राणायामं तु यः कुर्यादप्येकं मुक्तिमंडपे ।\nतेनाष्टांगः समभ्यस्तो योगोऽन्यत्रायुतं समाः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004130057, "chapter_id": 24130, "verse_number": "४-७९-५८", "content_sanskrit": "निर्वाणमंडपे यस्तु जपेदेकं षडक्षरम् ।\nकोटिरुद्रेण जप्तेन यत्फलं तस्य तद्भवेत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004130058, "chapter_id": 24130, "verse_number": "४-७९-५९", "content_sanskrit": "शुचिर्गंगांभसि स्नातो यो जपेच्छतरुद्रियम् ।\nनिर्वाणमंडपे ज्ञेयः स रुद्रो द्विजवेषभृत् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004130059, "chapter_id": 24130, "verse_number": "४-७९-६०", "content_sanskrit": "ब्रह्मयज्ञसकृत्कृत्वा मम दक्षिणमंडपे ।\nब्रह्मलोकमवाप्याथ परं ब्रह्माधिगच्छति ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004130060, "chapter_id": 24130, "verse_number": "४-७९-६१", "content_sanskrit": "धर्मशास्त्रं पुराणानि सेतिहासानि तत्र यः ।\nपठेन्निरभिलाषुः सन्स वसेन्मम वेश्मनि ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004130061, "chapter_id": 24130, "verse_number": "४-७९-६२", "content_sanskrit": "तिष्ठेदिंद्रियचापल्यं यो निवार्य क्षणं कृती ।\nनिर्वाणमंडपेन्यत्र तेन तप्तं महत्तपः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004130062, "chapter_id": 24130, "verse_number": "४-७९-६३", "content_sanskrit": "वायुभक्षणतोन्यत्र यत्पुण्यं शरदां शतम् ।\nतत्पुण्यं घटिकार्धेन मौनं दक्षिणमंडपे ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004130063, "chapter_id": 24130, "verse_number": "४-७९-६४", "content_sanskrit": "मितं कृष्णलकेनापि योदद्यान्मुक्तिमंडपे ।\nस्वर्णं सौवर्णयानेन स तु संचरते दिवि ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004130064, "chapter_id": 24130, "verse_number": "४-७९-६५", "content_sanskrit": "तत्रैकं जागरं कुर्याद्यस्मिन्कस्मिन्दिनेपि यः ।\nउपोषितोर्चयेल्लिंगं स सर्वव्रतपुण्यभाक् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004130065, "chapter_id": 24130, "verse_number": "४-७९-६६", "content_sanskrit": "तत्र दत्त्वा महादानं तत्र कृत्वा महाव्रतम् ।\nतत्राधीत्याखिलं वेदं च्यवते न नरो दिवः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004130066, "chapter_id": 24130, "verse_number": "४-७९-६७", "content_sanskrit": "प्रयाणं कुर्वते यस्य प्राणा मे मुक्तिमंडपे ।\nसमामनुप्रविष्टोत्र तिष्ठेद्यावदहं खलु ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004130067, "chapter_id": 24130, "verse_number": "४-७९-६८", "content_sanskrit": "जलक्रीडां सदा कुर्यां ज्ञानवाप्यां सहोमया ।\nयदंबुपानमात्रेण ज्ञानं जायेत निमर्लम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004130068, "chapter_id": 24130, "verse_number": "४-७९-६९", "content_sanskrit": "तज्जलक्रीडनस्थानं मम प्रीतिकरं महत् ।\nअमुष्मिन्राजसदने जाड्यहृज्जलपूरितम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004130069, "chapter_id": 24130, "verse_number": "४-७९-७०", "content_sanskrit": "तत्प्रासादपुरोभागे मम शृंगारमंडपः॥ श्री  ।\nपीठं तद्धि विज्ञेयं निःश्रीकश्रीसमर्पणम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004130070, "chapter_id": 24130, "verse_number": "४-७९-७१", "content_sanskrit": "मदर्थं तत्र यो दद्याद्दुकूलानि शुचीन्यहो ।\nमाल्यानि सुविचित्राणि यक्षकर्दमवंति च ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004130071, "chapter_id": 24130, "verse_number": "४-७९-७२", "content_sanskrit": "नाना नेपथ्यवस्तूनि पूजोपकरणाऽन्यपि ।\nस श्रियालंकृतस्तिष्ठेद्यत्र कुत्रापि सत्तमः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004130072, "chapter_id": 24130, "verse_number": "४-७९-७३", "content_sanskrit": "निर्वाणलक्ष्मीर्वृणुते तं निर्वाणपदाप्तये ।\nयत्र कुत्रापि निधनं प्राप्नुयादपि स ध्रुवम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004130073, "chapter_id": 24130, "verse_number": "४-७९-७४", "content_sanskrit": "मोक्षलक्ष्मीविलासाख्य प्रासादस्योत्तरे मम ।\nऐश्वर्यमडपं रम्यं तत्रैश्वर्यं ददाम्यहम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004130074, "chapter_id": 24130, "verse_number": "४-७९-७५", "content_sanskrit": "मत्प्रासादैंद्रदिग्भागे ज्ञानमंडपमस्ति यत् ।\nज्ञानं दिशामि सततं तत्र मां ध्यायतां सताम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004130075, "chapter_id": 24130, "verse_number": "४-७९-७६", "content_sanskrit": "भवानि राजसदने ममास्ति हि महानसम् ।\nयत्तत्रोपहृतं पुण्यं निर्विशामि मुदैव तत् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004130076, "chapter_id": 24130, "verse_number": "४-७९-७७", "content_sanskrit": "विशालाक्ष्या महासौधे मम विश्रामभूमिका ।\nतत्र संसृतिखिन्नानां विश्रामं श्राणयाम्यहम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004130077, "chapter_id": 24130, "verse_number": "४-७९-७८", "content_sanskrit": "नियमस्नानतीर्थं च चक्रपुष्करिणी मम ।\nतत्र स्नानवतां पुंसां तन्नैर्मल्यं दिशाम्यहम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004130078, "chapter_id": 24130, "verse_number": "४-७९-७९", "content_sanskrit": "यदाहुः परमं तत्त्वं यदाहुर्ब्रह्मसत्तमम् ।\nस्वसंवेद्यं यदाहुश्च तत्तत्रांते दिशाम्यहम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004130079, "chapter_id": 24130, "verse_number": "४-७९-८०", "content_sanskrit": "यदाहुस्तारकं ज्ञानं यदाहुरतिनिर्मलम् ।\nस्वात्मारामं यदाहुश्च तत्तत्रांते दिशाम्यहम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004130080, "chapter_id": 24130, "verse_number": "४-७९-८१", "content_sanskrit": "जगन्मंगलभूर्यात्र परमा मणिकर्णिका ।\nविपाशयामि तत्राहं कर्मभिः पाशितान्पशून् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004130081, "chapter_id": 24130, "verse_number": "४-७९-८२", "content_sanskrit": "निर्वाणश्राणने यत्र पात्रापात्रं न चिंतये ।\nआनंदकानने तन्मे दानस्थानं दिवानिशम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004130082, "chapter_id": 24130, "verse_number": "४-७९-८३", "content_sanskrit": "भवांबुधौ महागाधे प्राणिनः परिमज्जतः ।\nभूत्वैव कर्णधारोंते यत्र संतारयाम्यहम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004130083, "chapter_id": 24130, "verse_number": "४-७९-८४", "content_sanskrit": "सौभाग्यभाग्यभूर्या वै विख्याता मणिकर्णिका ।\nददामि तस्यां सर्वस्वमग्रजायांत्यजाय वा ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004130084, "chapter_id": 24130, "verse_number": "४-७९-८५", "content_sanskrit": "महासमाधिसंपन्नैर्वेदांतार्थ निषेविभिः ।\nदुष्प्रापोन्यत्र यो मोक्षः शोच्यैरपि स लभ्यते ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004130085, "chapter_id": 24130, "verse_number": "४-७९-८६", "content_sanskrit": "दीक्षितो वा दिवाकीर्तिः पंडितो वाप्यपंडितः ।\nतुल्यो मे मोक्षदीक्षायां संप्राप्य मणिकर्णिकाम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004130086, "chapter_id": 24130, "verse_number": "४-७९-८७", "content_sanskrit": "यत्त्यागेन्यत्र कृपणस्तत्प्राप्य मणिकर्णिकाम् ।\nददामि जंतुमात्राय सर्वस्वं चिरसंचितम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004130087, "chapter_id": 24130, "verse_number": "४-७९-८८", "content_sanskrit": "यदि दैवादिह प्राप्तस्त्रिसंयोगोऽतिदुर्घटः ।\nअविचारं तदा देयं सर्वस्वं चिरसंचितम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004130088, "chapter_id": 24130, "verse_number": "४-७९-८९", "content_sanskrit": "शरीरमथ संपत्तिरथ सा मणिकर्णिका ।\nत्रिसंयोगोयमप्राप्यो देवैरिंद्रादिकैरपि ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004130089, "chapter_id": 24130, "verse_number": "४-७९-९०", "content_sanskrit": "पुनः पुनर्विचार्येति जंतुमात्रेभ्य एव च ।\nनिर्वाणलक्ष्मीं यच्छामि सदोपमणिकर्णिकम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004130090, "chapter_id": 24130, "verse_number": "४-७९-९१", "content_sanskrit": "मुक्तिदा न मही सा मे वाराणस्यां महीयसी ।\nतन्मही रजसा साम्यं त्रिलोक्यपि न चोद्वहेत् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004130091, "chapter_id": 24130, "verse_number": "४-७९-९२", "content_sanskrit": "परं लिंगार्चनस्थानमविमुक्तेश्वरेश्वरम् ।\nतत्र पूजां सकृत्कृत्वा कृतकृत्यो नरो भवेत् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004130092, "chapter_id": 24130, "verse_number": "४-७९-९३", "content_sanskrit": "सायं पाशुपतीं संध्यां कुर्यां पशुपतीश्वरे ।\nविभूतिधारणात्तत्र पशुपाशैर्न बध्यते ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004130093, "chapter_id": 24130, "verse_number": "४-७९-९४", "content_sanskrit": "प्रातःसध्याकरोम्येव सदोंकारनिकेतने ।\nतत्रैकापि कृता संध्या सर्वपातककृंतनी ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004130094, "chapter_id": 24130, "verse_number": "४-७९-९५", "content_sanskrit": "वसामि कृत्तिवासेहं सदा प्रति चतुर्दशि ।\nअत्र जागरणं कृत्वा चतुर्दश्यां न गर्भभाक् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004130095, "chapter_id": 24130, "verse_number": "४-७९-९६", "content_sanskrit": "रत्नेश्वरोर्चितो दद्यान्महारत्नानि भक्तितः ।\nरत्नैः समर्च्य तल्लिंगं स्त्रीरत्नादि लभेन्नरः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004130096, "chapter_id": 24130, "verse_number": "४-७९-९७", "content_sanskrit": "विष्टपत्रितयांतःस्थोप्यहं लिंगे त्रिविष्टपे ।\nतिष्ठामि सततं भक्तमनोरथसमृद्धये ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004130097, "chapter_id": 24130, "verse_number": "४-७९-९८", "content_sanskrit": "विरजस्कं महापीठं तत्र संसेव्य मानवः ।\nविरजा जायते नूनं चतुर्नद कृतोदकः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004130098, "chapter_id": 24130, "verse_number": "४-७९-९९", "content_sanskrit": "महादेवे महापीठं मम साधकसिद्धिदम् ।\nतत्पीठदर्शनादेव महापापैः प्रमुच्यते ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004130099, "chapter_id": 24130, "verse_number": "४-७९-१००", "content_sanskrit": "पितृप्रीतिप्रदं पीठं वृषभध्वजसंज्ञकम् ।\nपितृतर्पणकृत्तत्र पितॄंस्तारयति क्षणात् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004130100, "chapter_id": 24130, "verse_number": "४-७९-१०१", "content_sanskrit": "आदिकेशवपीठेहमादिकेशवरूपधृक् ।\nश्वेतद्वीपं नये भक्तान्वैष्णवानतिवल्लभान् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004130101, "chapter_id": 24130, "verse_number": "४-७९-१०२", "content_sanskrit": "तत्रैव मंगलापीठे सर्वमंगलदायिनि ।\nउप पंचनदे तीर्थे भक्तान्संतारयाम्यहम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004130102, "chapter_id": 24130, "verse_number": "४-७९-१०३", "content_sanskrit": "बिंदुमाधवरूपेण यत्राहं वैष्णवाञ्जनान् ।\nनये पंचनदस्नातांस्तद्विष्णोः परमं पदम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004130103, "chapter_id": 24130, "verse_number": "४-७९-१०४", "content_sanskrit": "पंचमुद्रे महापीठे ये वीरेश्वरसेवकाः ।\nतेषां परमनिर्वाणं कालेनाल्पेन जायते ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004130104, "chapter_id": 24130, "verse_number": "४-७९-१०५", "content_sanskrit": "तत्र सिद्धेश्वरीपीठे चंद्रेश्वर समीपतः ।\nतत्र संनिधिकर्तॄणां सिद्धिः षण्मासतो भवेत् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004130105, "chapter_id": 24130, "verse_number": "४-७९-१०६", "content_sanskrit": "काश्यां च योगिनीपीठे योगसिद्धिविधायिनि ।\nसिद्धीरुच्चाटनाद्याश्च कैर्न लब्धाः सुसाधकैः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004130106, "chapter_id": 24130, "verse_number": "४-७९-१०७", "content_sanskrit": "अनेकानीह पीठानि संति काश्यां पदेपदे ।\nपरं धर्मेशपीठस्य काचिच्छक्तिरनुत्तमा ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004130107, "chapter_id": 24130, "verse_number": "४-७९-१०८", "content_sanskrit": "यत्रामी बालकीराश्च निर्मलज्ञानभाजनम् ।\nआसुः सदुपदेशान्मे त्रातत्रातेति भाषिणः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004130108, "chapter_id": 24130, "verse_number": "४-७९-१०९", "content_sanskrit": "एतद्धर्मेश्वरं पीठं त्यजाम्यद्यदिनावधि ।\nन कदाचित्तरणिजत्वत्तपोवनमुत्तमम् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004130109, "chapter_id": 24130, "verse_number": "४-७९-११०", "content_sanskrit": "ममानुग्रहतः कीरानेतान्पश्य रवेः सुत ।\nदिव्यविमानमारुह्य गंतारो मत्पुरं महत् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004130110, "chapter_id": 24130, "verse_number": "४-७९-१११", "content_sanskrit": "तत्र भुक्त्वा चिरं भोगाञ्ज्ञानं प्राप्य मयेरितम् ।\nइह मुक्तिमवाप्स्यंति त्वत्संसर्गातिनिर्मलाः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004130111, "chapter_id": 24130, "verse_number": "४-७९-११२", "content_sanskrit": "इत्युक्तवति देवेशे कैलासशिखरोपमम् ।\nदिव्यं विमानमापन्नं रुद्रकन्यापरिष्कृतम् ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004130112, "chapter_id": 24130, "verse_number": "४-७९-११३", "content_sanskrit": "आरुह्यते न यानेन दिव्यरूपवराः खगाः ।\nकैलासमभिसंजग्मुर्धर्ममापृच्छ्यतेऽमलाः ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004130113, "chapter_id": 24130, "verse_number": "४-७९-११४", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां चतुर्थे काशीखंड उत्तरार्धे धर्मेशाख्याननामैकोनाशीतितमोऽध्यायः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}]