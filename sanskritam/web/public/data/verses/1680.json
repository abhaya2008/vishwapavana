[{"id": 2031214, "chapter_id": 1680, "verse_number": "४-३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2031215, "chapter_id": 1680, "verse_number": "४-३-१", "content_sanskrit": "एवं निर्दिश्य चात्मानं निश्वसन्नुष्णमार्तिजम् ।\nविमुञ्चन्नश्रु नेत्राभ्यां भीमसेनमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2031216, "chapter_id": 1680, "verse_number": "४-३-२", "content_sanskrit": "भीमसेन कथं कर्म मात्स्यराष्ट्रे करिष्यसि।\nहत्वा क्रोधवशांस्तत्र पर्वते गन्धमादने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2031217, "chapter_id": 1680, "verse_number": "४-३-३", "content_sanskrit": "यक्षान्क्रोधाभिताम्राक्षान्राक्षसांश्चापि पौरुषात्।\nप्रादाः पाञ्चालकन्यायै पद्मानि सुबहून्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2031218, "chapter_id": 1680, "verse_number": "४-३-४", "content_sanskrit": "बकं राक्षसराजानं भीषणं पुरुषादकम् ।\nजघ्निवानसि कौन्तेय ब्राह्मणार्थमरिन्दम।\nक्षेमा चाभयसंवीता सैकचक्रा त्वया कृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2031219, "chapter_id": 1680, "verse_number": "४-३-५", "content_sanskrit": "हिडिम्बं च महावीर्यं किर्मीरं चैव राक्षसम्।\nत्वया हत्वा महाबाहो वनं निष्कण्टकं कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2031220, "chapter_id": 1680, "verse_number": "४-३-६", "content_sanskrit": "आपदं चापि संप्राप्ता द्रौपदी चारुहासिनी ।\nजटासुरवधं कृत्वा वयं च परिमोक्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2031221, "chapter_id": 1680, "verse_number": "४-३-७", "content_sanskrit": "मत्स्यराजांन्तिके तात वीर्यपूर्णोऽत्यमर्षणः।\nवृकोदर विराटस्य बलीयान्दुर्बलीयसः।\nसमीपे नगरे तस्य वत्स्यसे केन कर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2031222, "chapter_id": 1680, "verse_number": "४-३-८x", "content_sanskrit": "भीम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2031223, "chapter_id": 1680, "verse_number": "४-३-८", "content_sanskrit": "सूदोऽहं वललो नाम्ना सूपकारो नराधिप।\nउपस्थास्यामि राजानं विराटमिति रोचये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2031224, "chapter_id": 1680, "verse_number": "४-३-९", "content_sanskrit": "रसान्नानाविधांश्चापि स्वादूंश्च मधुरांस्तथा ।\nसूपांश्चापि करिष्यामि कुशलोस्मि महानसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2031225, "chapter_id": 1680, "verse_number": "४-३-१०", "content_sanskrit": "कृतपूर्वाणि यान्यस्य व्यञ्जनानि सुशिक्षितैः ।\nतान्यप्यभिभविष्यामि प्रीतिं संजनयन्नहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2031226, "chapter_id": 1680, "verse_number": "४-३-११", "content_sanskrit": "पूर्वमप्राशितांस्तेन कर्ता रसगुणान्वितान् ।\nस्वादु व्यञ्जनमास्वाद्य मात्स्यः प्रीतो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2031227, "chapter_id": 1680, "verse_number": "४-३-१२", "content_sanskrit": "आहरिष्यामि दारूणां पाटितानां शतंशतम्।\nराजा कर्माणि मे दृष्ट्वा न मां परिभविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2031228, "chapter_id": 1680, "verse_number": "४-३-१३", "content_sanskrit": "ये च तस्य महामल्लाः समरेष्वपराजिताः ।\nकृतप्रतापा बहुशो राज्ञः प्रत्यायिता बले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2031229, "chapter_id": 1680, "verse_number": "४-३-१४", "content_sanskrit": "रङ्गोपजीविनः सर्वे परेषां च भयावहाः ।\nतानहं निहनिष्यामि रतिं राज्ञः प्रवर्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2031230, "chapter_id": 1680, "verse_number": "४-३-१५", "content_sanskrit": "न च तान्युध्यमानोऽहं नयिष्ये यमसादनम्।\nतथा तान्निहनिष्यामि जीविष्यन्ति यथाऽऽतुराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2031231, "chapter_id": 1680, "verse_number": "४-३-१६", "content_sanskrit": "वृषो वा महिषो वापि नागो वा षाष्टिहायनः ।\nसिंहो व्याघ्रो ग्रहीतव्यो भविष्यति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2031232, "chapter_id": 1680, "verse_number": "४-३-१७", "content_sanskrit": "तान्सर्वान्दुर्ग्रहानन्यैराशीविषविषोपमान्।\nबलादहं ग्रहीष्यामि मत्स्यराजस्य पश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2031233, "chapter_id": 1680, "verse_number": "४-३-१८", "content_sanskrit": "आरालिका वा सूदा वा येऽस्य युक्ता महानसे।\nतानहं प्रीणयिष्यामिं मनुष्यान्स्तेन कर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2031234, "chapter_id": 1680, "verse_number": "४-३-१९", "content_sanskrit": "आरालिको गोविकर्ता सूपकर्ता नियोधकः।\nआसं युधिष्ठिरस्याहमिति वक्ष्यामि मानवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2031235, "chapter_id": 1680, "verse_number": "४-३-२०", "content_sanskrit": "आत्मानमात्मना रक्षंश्चरिष्यामि विशांपते ।\nइत्येवं च प्रतिज्ञातं विचरिष्याम्यहं यथा।\nविराटनगरे च्छन्नो विराटस्य समीपतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2031236, "chapter_id": 1680, "verse_number": "४-३-२१x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2031237, "chapter_id": 1680, "verse_number": "४-३-२१", "content_sanskrit": "अग्निर्ब्राह्मणरूपेण प्रच्छन्नोऽन्नमयाचत।\nमहाशनं ब्राह्मणं मां प्रमुञ्चार्जुन खाण्डवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2031238, "chapter_id": 1680, "verse_number": "४-३-२२", "content_sanskrit": "संशुश्रुवे च धर्मात्मा यस्तमर्थं चकार ह।\nतस्मै ब्राह्मणरूपाय हुताशाय महायशाः ।\nविजित्यैकरथेनेन्द्रं हत्वा पन्नगराक्षसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2031239, "chapter_id": 1680, "verse_number": "४-३-२३", "content_sanskrit": "यस्तु देवान्मनुष्यांश्च सर्वानेकरथोऽजयत्।\nस भीमधन्वा श्वेताश्वः पाण्डवः किं करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2031240, "chapter_id": 1680, "verse_number": "४-३-२४", "content_sanskrit": "आशीविषसमस्पर्शो नागानामिव वासुकिः ।\nदृष्टीविष इवाहीनामग्निस्तेजस्विनामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2031241, "chapter_id": 1680, "verse_number": "४-३-२५", "content_sanskrit": "समुद्र इव सिन्धूनां शैलानां हिमवानिव।\nमहेन्द्र इव देवानां दानवानां बलिर्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2031242, "chapter_id": 1680, "verse_number": "४-३-२६", "content_sanskrit": "सुप्रतीको गजेन्द्राणां युग्यानां तुरगो यथा।\nकुबेर इव यक्षाणां मृगाणां केसरी यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2031243, "chapter_id": 1680, "verse_number": "४-३-२७", "content_sanskrit": "राक्षसानां दशग्रीवो दैत्यानामिव शम्बरः ।\nरुद्राणामिव कापाली विष्णुर्बलवतामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2031244, "chapter_id": 1680, "verse_number": "४-३-२८", "content_sanskrit": "रोषामर्षसमायुक्तो भुजङ्गानां च तक्षकः ।\nवायुवेगबलोद्धृतो गरुडः पततामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2031245, "chapter_id": 1680, "verse_number": "४-३-२९", "content_sanskrit": "तपतामिव चादित्यः प्रजानां ब्राह्मणो यथा।\nह्रदानामिव पातालं पर्जन्यो नर्दतामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2031246, "chapter_id": 1680, "verse_number": "४-३-३०", "content_sanskrit": "आयुधानां वरो वज्रः ककुद्मांश्च गवां वरः।\nधृतराष्ट्रश्च नागानां हस्तिष्वैरावतो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2031247, "chapter_id": 1680, "verse_number": "४-३-३१", "content_sanskrit": "पुत्रः प्रियाणामधिको भार्या च सुहृदां वरा।\nगिरीणां प्रवरो मेरुर्देवानां मधुसूदनः।\nग्रहाणां प्रवरश्चन्द्रः सरसां मानसो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2031248, "chapter_id": 1680, "verse_number": "४-३-३२", "content_sanskrit": "यथैतानि विशिष्टानि स्वस्यां जात्यां वृकोदर ।\nएवं युवा गुडाकेशः श्रेष्ठः सर्वधनुष्मताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2031249, "chapter_id": 1680, "verse_number": "४-३-३३", "content_sanskrit": "सोयमिन्द्रादनवमो वासुदेवाच्च भारत ।\nउषित्वा पञ्च वर्षाणि सहस्राक्षस्य वेश्मनि।\nब्रह्मचारी व्रते युक्तः सर्वशस्त्रभृतांवरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2031250, "chapter_id": 1680, "verse_number": "४-३-३४", "content_sanskrit": "अवाप चास्त्रमस्त्रज्ञः सर्वज्ञः सर्वसंमतः ।\nक्षिप्रं चाणु विचित्रं च ध्रुवं च वदतां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2031251, "chapter_id": 1680, "verse_number": "४-३-३५", "content_sanskrit": "अनुज्ञातः सुरेन्द्रेण पुनः प्रत्यागतो महीम्।\nधार्तराष्ट्रविनाशाय पाण्डवानां जयाय च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2031252, "chapter_id": 1680, "verse_number": "४-३-३६", "content_sanskrit": "यं मन्ये द्वादशं रुद्रमादित्यानां त्रयोदशम् ।\nवसूनां नवमं मन्ये गिरीणामष्टमः स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2031253, "chapter_id": 1680, "verse_number": "४-३-३७", "content_sanskrit": "यस्य दीर्घौ समौ बाहू ज्याघातेन किणीकृतौ ।\nदक्षिणश्चैव सव्यश्च बाहू अनडुहो यथा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2031254, "chapter_id": 1680, "verse_number": "४-३-३८", "content_sanskrit": "तलाङ्गुलित्राभ्युचितौ नागराजकरोपमौ ।\nपीनौ परिघसङ्काशौ मृदुताम्रतलौ शुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2031255, "chapter_id": 1680, "verse_number": "४-३-३९", "content_sanskrit": "श्यामो युवा गुडाकेशो दर्शनीयश्च पाण्डवः ।\nगाण्डीवधन्वा श्वेताश्वः किरीटी वानरध्वजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2031256, "chapter_id": 1680, "verse_number": "४-३-४०", "content_sanskrit": "किंरूपधारी किंकर्मा किंचेष्टः किंपरायणः।\nबीभत्सुर्भीमधन्वा च किं करिष्यति चार्जुनः ।\nकुन्तीपुत्रो विराटस्य रमते केन कर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2031257, "chapter_id": 1680, "verse_number": "४-३-४१x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2031258, "chapter_id": 1680, "verse_number": "४-३-४१", "content_sanskrit": "इमौ किणीकृतौ बाहू ज्याघाततलपीडनात्।\nनित्यं कञ्चुकसंछन्नौ नान्यथा गोप्तुमुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2031259, "chapter_id": 1680, "verse_number": "४-३-४२", "content_sanskrit": "किं तु कार्यवशादेतदाचरिष्यामि कुत्सितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2031260, "chapter_id": 1680, "verse_number": "४-३-४३", "content_sanskrit": "बाहू मे भरतश्रेष्ठ महालाञ्छनलक्षितौ ।\nज्याघातेन महान्तौ मे गूहितुं नान्यथोत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2031261, "chapter_id": 1680, "verse_number": "४-३-४४", "content_sanskrit": "उभौ कम्बू प्रतीमुच्य कुण्डले परिपातुके ।\nवेणीकृतशिरा भूत्वा भविष्यामि बृहन्नला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2031262, "chapter_id": 1680, "verse_number": "४-३-४५", "content_sanskrit": "पठन्नाख्यायिकां नाम स्त्रीभावेन पुनः पुनः ।\nप्रजानां समुदाचारं बहुनर्मकृतं वदन् ।\nरमयिष्यामि राजानमन्यं चान्तःपुरे जनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2031263, "chapter_id": 1680, "verse_number": "४-३-४६", "content_sanskrit": "नृत्तं गीतं च वादित्रं दिव्यं च विविधं तथा ।\nशिक्षयिष्याम्यहं राजन्विराटनगरे स्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2031264, "chapter_id": 1680, "verse_number": "४-३-४७", "content_sanskrit": "स्त्रीभावसमुदाचारान्नृत्तगीतकथाश्रयैः।\nछादयिष्यामि राजेन्द्र माययाऽऽत्मानमात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2031265, "chapter_id": 1680, "verse_number": "४-३-४८", "content_sanskrit": "युधिष्ठिरस्य गेहेऽस्मिन्द्रौपद्याः परिचारिका।\nउषिताऽस्मीति वक्ष्यामि धर्मराजस्य संमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2031266, "chapter_id": 1680, "verse_number": "४-३-४९", "content_sanskrit": "उर्वश्याश्चापि शापेन प्राप्तोस्मि नृप षण्डताम्।\nशक्रप्रसादान्मुक्तोऽहं वर्षादूर्ध्वं त्रयोदशात्।\nइत्येतन्मे प्रतिज्ञातं विचरिष्याम्यहं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2031267, "chapter_id": 1680, "verse_number": "४-३-५०", "content_sanskrit": "एतेन विधिना छन्नः कृतकेन यथा नलः।\nविहरिष्यामि राजेन्द्र विराटस्य पुरे सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2031268, "chapter_id": 1680, "verse_number": "४-३-५१x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2031269, "chapter_id": 1680, "verse_number": "४-३-५१", "content_sanskrit": "वासुदेवसमो लोके यशसा विक्रमेण च।\nसोयं राज्ये विराटस्य भवने भरतर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2031270, "chapter_id": 1680, "verse_number": "४-३-५२", "content_sanskrit": "मेरुः प्रच्छादित इव वसन्वज्रोण मुष्टिना।\nआख्याता षण्डकोस्मीति प्रतिज्ञातं हि पातकं ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2031271, "chapter_id": 1680, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि पाण्डवप्रवेशपर्वणि तृतीयोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]