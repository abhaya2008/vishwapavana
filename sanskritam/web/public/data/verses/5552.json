[{"id": 2213227, "chapter_id": 5552, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2213228, "chapter_id": 5552, "verse_number": "१", "content_sanskrit": "एवं ते पुरुषव्याघ्राः पाण्डवा मातृनन्दनाः ।\nस्मरन्तो मातरं वीरा बभूवुर्भृशदुःखिताः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2213229, "chapter_id": 5552, "verse_number": "२", "content_sanskrit": "ये राजकार्येषु पुरा नामाद्यन्त क्वचिन्नृप ।\nते राजकार्याणि तदा नाकार्षुर्मनसा पुरे\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2213230, "chapter_id": 5552, "verse_number": "३", "content_sanskrit": "आविष्टा इव शोकेन नाभ्यनन्दन्त किञ्चन ।\nसम्भाष्यमाणा अपि ते न किञ्चित् प्रत्यपूजयन्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2213231, "chapter_id": 5552, "verse_number": "४", "content_sanskrit": "ते स्म वीरा दुराधर्षा गाम्भीर्ये सागरोपमाः ।\nशोकोपहतविज्ञाना नष्टसञ्ज्ञा इवाभवन्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2213232, "chapter_id": 5552, "verse_number": "५", "content_sanskrit": "अनुस्मरन्तो जननीं ततस्ते कुरुनन्दनाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2213233, "chapter_id": 5552, "verse_number": "", "content_sanskrit": "पाण्डवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2213234, "chapter_id": 5552, "verse_number": "६", "content_sanskrit": "कथं नु वृद्धमिथुनं वहत्यद्य पृथा कृशा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2213235, "chapter_id": 5552, "verse_number": "७", "content_sanskrit": "कथं च स महीपालो हतपुत्रो निराश्रयः ।\nपत्न्या सह वसत्येको वने श्वापदसेविते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2213236, "chapter_id": 5552, "verse_number": "", "content_sanskrit": "(सा च देवी महाभागा गान्धारी हतवान्धवा ।\nपतिमन्धं कथं वृद्धमन्वेति विजने वने\t॥८॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2213237, "chapter_id": 5552, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2213238, "chapter_id": 5552, "verse_number": "९", "content_sanskrit": "एवं तेषां कथयतामौत्सुक्यमभवत् तदा ।\nगमने चाभवद् बुद्धिर्धृतराष्ट्रदिदृक्षया\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2213239, "chapter_id": 5552, "verse_number": "१०", "content_sanskrit": "सहदेवस्तु राजानं प्रणिपत्येदमब्रवीत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2213240, "chapter_id": 5552, "verse_number": "", "content_sanskrit": "सहदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2213241, "chapter_id": 5552, "verse_number": "११", "content_sanskrit": "अहो नु भवतो दृष्टं हृदयं गमनं प्रति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2213242, "chapter_id": 5552, "verse_number": "१२", "content_sanskrit": "न हि त्वा गौरवेणाहम् अशकं वक्तुमात्मना ।\nगमनं प्रति राजेन्द्र तदिदं प्रत्युपस्थितम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2213243, "chapter_id": 5552, "verse_number": "१३", "content_sanskrit": "दिष्ट्या द्रक्ष्यामि तां कुन्तीं वर्तमानां तपस्विनीम् ।\nजटिलां तापसीं वृद्धां कुशकाशपरिक्षताम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2213244, "chapter_id": 5552, "verse_number": "१४", "content_sanskrit": "प्रासादहर्म्यसंवृद्धामत्यन्तसुखभागिनीम् ।\nकदा नु जननीं श्रान्तां द्रक्ष्यामि भृशदुःखिताम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2213245, "chapter_id": 5552, "verse_number": "१५", "content_sanskrit": "अनित्याः खलु मर्त्यानां गतयो भरतर्षभ ।\nकुन्ती राजसुता यत्र वसत्यसुखिनी वने\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2213246, "chapter_id": 5552, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2213247, "chapter_id": 5552, "verse_number": "१६", "content_sanskrit": "सहदेववचः श्रुत्वा द्रौपदी योषितां वरा ।\nउवाच देवी राजानमभिपूज्याभिनन्द्य च\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2213248, "chapter_id": 5552, "verse_number": "", "content_sanskrit": "द्रौपदी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2213249, "chapter_id": 5552, "verse_number": "१७", "content_sanskrit": "द्रक्ष्यामि तां कदा देवीं यदि जीवति सा पृथा ।\nजीवन्त्या ह्यद्य नः प्रीतिर्भविष्यति नराधिप\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2213250, "chapter_id": 5552, "verse_number": "१८", "content_sanskrit": "एषा तेऽस्तु मतिर्नित्यं धर्मे ते रमतां मनः ।\nयोऽद्य त्वमस्मान् राजेन्द्र श्रेयसा योजयिष्यसि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2213251, "chapter_id": 5552, "verse_number": "१९", "content_sanskrit": "अग्रपादस्थितमिदं विद्धि राजन् वधूजनम् ।\nकाङ्क्षितं दर्शनं कुन्त्या गान्धार्याः श्वशुरस्य च\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2213252, "chapter_id": 5552, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2213253, "chapter_id": 5552, "verse_number": "२०", "content_sanskrit": "इत्युक्तः स नृपो देव्या पाञ्चाल्या भरतर्षभ ।\nसेनाध्यक्षान् समानाय्य सर्वानिदमथाब्रवीत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2213254, "chapter_id": 5552, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2213255, "chapter_id": 5552, "verse_number": "२१", "content_sanskrit": "निर्यापयत सेनां मे प्रभूतरथकुञ्जराम् ।\nद्रक्ष्यामो वनवासस्थं धृतराष्ट्रं महीपतिम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2213256, "chapter_id": 5552, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2213257, "chapter_id": 5552, "verse_number": "२२", "content_sanskrit": "अध्यक्षांश्चाब्रवीद् राजा यानानि विविधानि मे ।\nसज्जीक्रियन्तां सर्वाणि शिबिकाश्च सहस्रशः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2213258, "chapter_id": 5552, "verse_number": "२३", "content_sanskrit": "शकटापणवेशाश्च कोशाः शिल्पिन एव च ।\nनिर्यान्तु कोशपालाश्च कुरुक्षेत्राश्रमं प्रति\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2213259, "chapter_id": 5552, "verse_number": "२४", "content_sanskrit": "यश्च पौरजनः कश्चिद् द्रष्टुमिच्छति पार्थिवम् ।\nअनावृतः सुविहितः स च यातु सुरक्षितः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2213260, "chapter_id": 5552, "verse_number": "२५", "content_sanskrit": "सूदाः पौरोगवाश्चैव सर्वं चैव महानसम् ।\nविविधं भक्ष्यभोज्यं च शकटैरुह्यतां मम\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2213261, "chapter_id": 5552, "verse_number": "२६", "content_sanskrit": "प्रयाणं घुष्यतामद्य श्वोभूत इति मा चिरम् ।\nक्रियतां पथि चाप्यत्र वेश्मानि विविधानि च\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2213262, "chapter_id": 5552, "verse_number": "२७", "content_sanskrit": "एवमाज्ञाप्य राजा स भ्रातृभिः सह पाण्डवः ।\nश्वोभूते निर्ययौ राजा सस्त्रीबालपुरस्कृतः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2213263, "chapter_id": 5552, "verse_number": "२८", "content_sanskrit": "स बहिर्दिवसानेव जनौघं परिपालयन् ।\nन्यवसन्नृपतिः पञ्च ततोऽगच्छद्वनं प्रति\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2213264, "chapter_id": 5552, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्रमवासिकपर्वणि युधिष्ठिरवनप्रवेशो नाम अष्टाविंशोऽध्यायः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2213265, "chapter_id": 5552, "verse_number": "", "content_sanskrit": "आश्रमवासपर्वणि अष्टाविंशोऽध्यायः ॥२८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]