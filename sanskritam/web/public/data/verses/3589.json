[{"id": 2120893, "chapter_id": 3589, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2120894, "chapter_id": 3589, "verse_number": "१", "content_sanskrit": "तत आज्ञापयामास स राजा राजसत्तमः ।\nसहदेवं तदा सद्यो मन्त्रिणः कुरुसत्तम\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2120895, "chapter_id": 3589, "verse_number": "२", "content_sanskrit": "आमन्त्रणार्थं दूतांश्च प्रेषयस्वाशुगान् द्रुतम् ।\nउपश्रुत्य वचो राज्ञः स दूतान् प्राहिणोत् तदा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2120896, "chapter_id": 3589, "verse_number": "३", "content_sanskrit": "आमन्त्रयध्वं राष्ट्रेषु ब्राह्मणान् भूमिपानपि ।\nविशश्च मान्यान् शूद्रांश्च सर्वानानयतेति च\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2120897, "chapter_id": 3589, "verse_number": "४", "content_sanskrit": "ते सर्वान् पृथिवीपालान् पाण्डवेयस्य शासनात् ।\nआमन्त्रयाम्बभूवुस्ते प्रेषयामास चापरान्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2120898, "chapter_id": 3589, "verse_number": "५", "content_sanskrit": "दूताश्च वाहनैर्जग्मू राष्ट्राणि सुबहून्यपि ।\nततो युधिष्ठिरो राजा प्रेषयामास पाण्डवम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2120899, "chapter_id": 3589, "verse_number": "६", "content_sanskrit": "नकुलं हस्तिनपुरं भीष्माय भरतर्षभ ।\nबाह्लिकाय सपुत्राय भूरिश्रवसकर्णयोः ।\nभ्रातॄणां चैव सर्वेषां येऽनुरक्ता युधिष्ठिरे \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2120900, "chapter_id": 3589, "verse_number": "७", "content_sanskrit": "स गत्वा हस्तिनपुरं नकुलः समितिञ्जयः ।\nभीष्ममामन्त्रयामास धृतराष्ट्रं च पाण्डवः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2120901, "chapter_id": 3589, "verse_number": "८", "content_sanskrit": "ततस्ते तु यथाकालं कुन्तीपुत्रं युधिष्ठिरम् ।\nदीक्षयाञ्चक्रिरे विप्रा राजसूयाय भारत\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2120902, "chapter_id": 3589, "verse_number": "९", "content_sanskrit": "ज्येष्ठे मूले अमावास्यां महाजनसमावृतः ।\nरौरवाजिनसंवीतो नवनीताक्तदेहवान्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2120903, "chapter_id": 3589, "verse_number": "१०", "content_sanskrit": "दीक्षितः स तु धर्मात्मा धर्मराजो युधिष्ठिरः ।\nजगाम यज्ञायतनं वृतो विप्रैः सहस्रशः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2120904, "chapter_id": 3589, "verse_number": "", "content_sanskrit": "भ्रातृभिर्ज्ञातिभिश्चैव सुहृद्भिः सचिवैस्तथा ।\nक्षत्रियैश्च मनुष्यैश्च नानादेशसमागतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2120905, "chapter_id": 3589, "verse_number": "११", "content_sanskrit": "अमात्यैश्च नृपश्रेष्ठो धर्मो विग्रहवानिव\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2120906, "chapter_id": 3589, "verse_number": "१२", "content_sanskrit": "आजग्मुर्ब्राह्मणास्तत्र विषयेभ्यस्ततस्ततः ।\nसर्वविद्यासु निष्णाता वेदवेदाङ्गपारगाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2120907, "chapter_id": 3589, "verse_number": "१३", "content_sanskrit": "तेषामावसथांश्चक्रुर्धर्मराजस्य शासनात् ।\nबह्वन्नान् व्यञ्जनैर्युक्तान् सगणानां पृथक् पृथक्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2120908, "chapter_id": 3589, "verse_number": "१४", "content_sanskrit": "सर्वर्तुगुणसम्पन्नान् शिल्पिनोऽथ सहस्रशः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2120909, "chapter_id": 3589, "verse_number": "१५", "content_sanskrit": "तेषु ते न्यवसन् राजन् ब्राह्मणा भृशसत्कृताः ।\nकथयन्तः कथा बह्वीः पश्यन्तो नटनर्तकान्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2120910, "chapter_id": 3589, "verse_number": "१६", "content_sanskrit": "भुञ्जतां चाथ विप्राणां ददतां च महात्मनाम् ।\nअनिशं श्रूयते चात्र मुदितानां महास्वनः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2120911, "chapter_id": 3589, "verse_number": "१७", "content_sanskrit": "दीयतां दीयतामेषां भुज्यतां भुज्यतामिति ।\nएवंप्रकाराः सञ्जल्पाः श्रूयन्ते स्मात्र नित्यशः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2120912, "chapter_id": 3589, "verse_number": "१८", "content_sanskrit": "गवायुतसहस्राणि शयनानां शतानि च ।\nरुग्मस्य योषितां चैव धर्मराजः पृथग् ददौ\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2120913, "chapter_id": 3589, "verse_number": "१९", "content_sanskrit": "प्रावर्ततैवं यज्ञः स पाण्डवस्य महात्मनः ।\nपृथिव्यामेकवीरस्य शक्रस्येव त्रिविष्टपे\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2120914, "chapter_id": 3589, "verse_number": "२०", "content_sanskrit": "तत आमन्त्रिता राजन् राजानः सत्कृतास्तदा ।\nपुरेभ्यः प्रययुः स्वेभ्यो विमानेभ्य इवामराः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2120915, "chapter_id": 3589, "verse_number": "२१", "content_sanskrit": "ते वै दिग्भ्यः समापेतुः पार्थिवास्तत्र भारत ।\nसमादाय महार्हाणि रत्नानि विविधानि च\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2120916, "chapter_id": 3589, "verse_number": "२२", "content_sanskrit": "तच्छ्रुत्वा धर्मराजस्य यज्ञं यज्ञविदस्तदा ।\nराजानः शतशस्तुष्टैर्मनोभिर्भरतर्षभ\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2120917, "chapter_id": 3589, "verse_number": "२३", "content_sanskrit": "बहु वित्तं समादाय विविधाः पार्थिवा ययुः ।\nद्रष्टुकामाः सभां चैव धर्मराजं च पाण्डवम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2120918, "chapter_id": 3589, "verse_number": "२४", "content_sanskrit": "नकुलो हस्तिनपुरं गत्वा परपुरञ्जयः ।\nप्रयतः प्राञ्जलिर्भूत्वा भारतानानयत् तदा\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2120919, "chapter_id": 3589, "verse_number": "२५", "content_sanskrit": "भीष्मं च धृतराष्ट्रं च विदुरं च महामतिः ।\nदुर्योधनपुरोगांश्च भ्रातॄन् सर्वानथानयत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2120920, "chapter_id": 3589, "verse_number": "२६", "content_sanskrit": "सत्कृत्यामन्त्रिताः सर्वे कृपद्रोणमुखा नृपाः ।\nपुरेभ्यः प्रययुः सर्वे यज्ञं ब्रह्मपुरस्सराः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2120921, "chapter_id": 3589, "verse_number": "२७", "content_sanskrit": "गान्धारराजः शकुनिः सुबलश्च महाबलः ।\nअचलो वृषकश्चैव कर्णश्च ददतां वरः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2120922, "chapter_id": 3589, "verse_number": "२८", "content_sanskrit": "ऋतः शल्यो मद्रराजो बाह्लिकश्च महाबलः ।\nसोमदत्तोऽथ कौरव्यो भूरिर्भूरिश्रवाः शलः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2120923, "chapter_id": 3589, "verse_number": "२९", "content_sanskrit": "अश्वत्थामा कृपो द्रोणः सैन्धवश्च जयद्रथः ।\nयज्ञसेनः सपुत्रश्च साल्वश्च वसुधाधिपः ।\nप्राग्जोतिषश्च नृपतिर्भगदत्तो महायशाः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2120924, "chapter_id": 3589, "verse_number": "३०", "content_sanskrit": "सह सर्वैस्तथा म्लेच्छैः सागरानूपवासिभिः ।\nपार्वतीयाश्च राजानो राजा चैव बृहद्बलः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2120925, "chapter_id": 3589, "verse_number": "३१", "content_sanskrit": "पौण्ड्रको वासुदेवश्च वङ्गः काळिङ्गकस्तथा ।\nआकर्षाः कुन्तळाश्चैव वानप्रस्था वृकास्तथा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2120926, "chapter_id": 3589, "verse_number": "३२", "content_sanskrit": "द्रामिळाः सिंहळाः पाण्ड्या राजा काश्मीरकस्तथा\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2120927, "chapter_id": 3589, "verse_number": "३३", "content_sanskrit": "कुन्तिभोजो महातेजाः सुभ्रूश्च सुमहाबलः ।\nबाह्लिकाश्चापरे शूरा राजानः सर्व एव हि\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2120928, "chapter_id": 3589, "verse_number": "३४", "content_sanskrit": "विराटः सह पुत्राभ्यां पाञ्चालाश्च महारथाः ।\nराजानो राजपुत्राश्च नानाजनपदेश्वराः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2120929, "chapter_id": 3589, "verse_number": "३५", "content_sanskrit": "शिशुपालो महावीर्यः सह पुत्रेण भारत ।\nआगच्छत् पाण्डवेयस्य यज्ञं सङ्ग्रामदुर्मदः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2120930, "chapter_id": 3589, "verse_number": "३६", "content_sanskrit": "रामश्चैवानिरुद्धश्च बभ्रुश्च सहसारणः ।\nगदप्रद्युम्नसाम्बाश्च चारुदेष्णश्च वीर्यवान्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2120931, "chapter_id": 3589, "verse_number": "३७", "content_sanskrit": "उन्मुखो विपृथुश्चैव वीरः प्राद्युम्निरेव च ।\nवृष्णयो निखिलाश्चान्ये समाजग्मुर्महारथाः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2120932, "chapter_id": 3589, "verse_number": "३८", "content_sanskrit": "एते चान्ये च बहवो राजानो मध्यदेशजाः ।\nआजग्मुः पाण्डुपुत्रस्य राजसूयं महाक्रतुम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2120933, "chapter_id": 3589, "verse_number": "३९", "content_sanskrit": "ददुस्तेषामावसथान् धर्मराजस्य शासनात् ।\nबहुकक्षान्वितान् राज्ञां दीर्घिकावृक्षशोभितान्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2120934, "chapter_id": 3589, "verse_number": "४०", "content_sanskrit": "तदा धर्मात्मजस्तेषां चक्रे पूजामनुत्तमाम् ।\nसत्कृताश्च महीपालाः सुखमूषुर्नराधिपाः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2120935, "chapter_id": 3589, "verse_number": "४१", "content_sanskrit": "कैलासशिखरप्रख्यैर्नभःस्थलविलेखिभिः ।\nसर्वतः संवृतैर्नद्धैः प्राकारैः सुकृतैः सितैः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2120936, "chapter_id": 3589, "verse_number": "४२", "content_sanskrit": "सुवर्णजालविततैर्मणिकुट्टिमभूषितैः ।\nसुखारोहणसोपानैर्महासनपरिच्छदैः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2120937, "chapter_id": 3589, "verse_number": "४३", "content_sanskrit": "स्रग्दामभिरवच्छन्नैरगरूत्तमधूपितैः ।\nहंसवर्णैः सुबहुभिरायोजनसुदर्शनैः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2120938, "chapter_id": 3589, "verse_number": "४४", "content_sanskrit": "असम्बाधसुखद्वारैः शयनासनशोभितैः ।\nबहुधातुपिनद्धाङ्गैर्हिमवच्छिखरैरिव\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2120939, "chapter_id": 3589, "verse_number": "४५", "content_sanskrit": "विश्रान्तैस्तैस्ततः सर्वैर्भूमिपैर्भूरिदक्षिणैः ।\nवृतं सहस्रैर्बहुभिर्धर्मराजो युधिष्ठिरः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2120940, "chapter_id": 3589, "verse_number": "४६", "content_sanskrit": "तत् सदः पार्थिवैः कीर्णं ब्राह्मणैश्च महात्मभिः ।\nभ्राजते स्म महाराज नाकपृष्ठमिवामरैः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2120941, "chapter_id": 3589, "verse_number": "४७", "content_sanskrit": "ततस्त्वाज्ञापयामास पाण्डवोऽरिनिबर्हणः ।\nसहदेवं कुरुश्रेष्ठं मन्त्रिणश्चैव सर्वशः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2120942, "chapter_id": 3589, "verse_number": "४८", "content_sanskrit": "अस्मिन् क्रतौ यथोक्तानि यज्ञाङ्गानि द्विजातिभिः ।\nअभिसञ्ज्ञांश्च सम्भारान् धौम्योक्तान् भरतर्षभ ।\nसर्वमानय तान् क्षिप्रं सहदेव यथातथम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2120943, "chapter_id": 3589, "verse_number": "४९", "content_sanskrit": "इन्द्रसेनो विशोकश्च रुग्मश्चार्जुनसारथिः ।\nशमीको ध्वजसेनश्च पञ्चसारथिपुङ्गवाः ।\nअन्नाद्ये व्यापृताः सन्तु सहदेव तवाज्ञया\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2120944, "chapter_id": 3589, "verse_number": "५०", "content_sanskrit": "उपार्जितान् सर्वकामान् रसगन्धसमन्वितान् ।\nमनोहरान् प्रीतिकरान् अन्नाद्यांश्च सुसंस्कृतान्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2120945, "chapter_id": 3589, "verse_number": "५१", "content_sanskrit": "पितामहं गुरुं चाथ प्रत्युद्गम्य युधिष्ठिरः ।\nअभिवाद्योपसङ्गृह्य वाक्यमेतदुवाच ह\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2120946, "chapter_id": 3589, "verse_number": "५२", "content_sanskrit": "भीष्मो द्रौणिः कृपो द्रोणो दुर्योधनविविंशती ।\nअस्मिन् यज्ञे भवन्तो मामनुगृह्णन्तु सर्वशः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2120947, "chapter_id": 3589, "verse_number": "५३", "content_sanskrit": "इदं वः स्वमहं चैव यदिहास्ति धनं मम ।\nप्रीणयन्तु भवन्तो मां यथेष्टमनियन्त्रिताः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2120948, "chapter_id": 3589, "verse_number": "५४", "content_sanskrit": "एवमुक्त्वा स तान् राजा दीक्षितः पाण्डवाग्रजः ।\nन्ययोजयद् यथायोगमधिकारेष्वनन्तरम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2120949, "chapter_id": 3589, "verse_number": "५५", "content_sanskrit": "भक्ष्यभोज्याधिकारेषु युयुत्सुं समयोजयत् ।\nपाद्यारोपणकार्ये च१ उच्छिष्टापनये पुनः ।\nसात्यकिं भीमसेनं च महानसविचारणे\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2120950, "chapter_id": 3589, "verse_number": "५६", "content_sanskrit": "भोजनावेक्षणे चैव दुश्शासनमयोजयत् ।\nप्रतिग्रहे ब्राह्मणानामश्वत्थामानमुक्तवान्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2120951, "chapter_id": 3589, "verse_number": "५७", "content_sanskrit": "राज्ञां तु प्रतिपूजार्थं सञ्जयं स न्ययोजयत् ।\nकृताकृतपरिज्ञाने भीष्मद्रोणौ महामती\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2120952, "chapter_id": 3589, "verse_number": "५८", "content_sanskrit": "हिरण्यस्य सुवर्णस्य रत्नानां चान्ववेक्षणे ।\nदक्षिणानां च वै दाने कृपं राजा न्ययोजयत्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2120953, "chapter_id": 3589, "verse_number": "५९", "content_sanskrit": "तथाऽन्यान् पुरुषव्याघ्रांस्तस्मिंस्तस्मिन् न्ययोजयत्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2120954, "chapter_id": 3589, "verse_number": "६०", "content_sanskrit": "बाह्लीको धृतराष्ट्रश्च सोमदत्तो जयद्रथः ।\nनकुलेन समाहूताः स्वामिवत् तत्र मेनिरे\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2120955, "chapter_id": 3589, "verse_number": "६१", "content_sanskrit": "क्षत्ता सूक्ष्मव्ययं चक्रे घृतादि मधुरादिकम् ।\nचरणक्षाळने कृष्णो ब्राह्मणानां स्वयं ह्यभूत् ।\nदुर्योधनस्त्वर्हणानि प्रतिजग्राह सर्वशः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2120956, "chapter_id": 3589, "verse_number": "६२", "content_sanskrit": "सर्वलोकाः समावृत्ताः प्रहृष्टास्तत्र भारत ।\nद्रष्टुकामाः सभां चैव धर्मराजं च पाण्डवम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2120957, "chapter_id": 3589, "verse_number": "६३", "content_sanskrit": "न कश्चिदवहत् तत्र सहस्रावरमर्हणम् ।\nरत्नैश्च बहुभिस्तत्र धर्मराजमवर्धयन्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2120958, "chapter_id": 3589, "verse_number": "६४", "content_sanskrit": "कथं तु मम कौरव्यो रत्नदानैः समाप्नुयात् ।\nयज्ञमित्येव राजानः स्पर्धमानाः ददुर्धनम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2120959, "chapter_id": 3589, "verse_number": "६५", "content_sanskrit": "भवनैः सविमानाग्र्यैः सोदकैर्बहुसंवृतैः ।\nलोक्यै राजविमानैश्च ब्राह्मणावसथैः सह\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2120960, "chapter_id": 3589, "verse_number": "६६", "content_sanskrit": "कृतैरावसथैर्दिव्यैर्विमानप्रतिमैस्तथा ।\nविचित्रै रत्नवद्भिश्च ऋद्ध्या परमया युतैः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2120961, "chapter_id": 3589, "verse_number": "६७", "content_sanskrit": "राजभिश्च समावृत्तैरतीवश्रीसमृद्धिभिः ।\nअशोभत तदा राजन् यज्ञवाटो महात्मनः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2120962, "chapter_id": 3589, "verse_number": "६८", "content_sanskrit": "ऋद्ध्या च वरुणं देवं स्पर्धमानो युधिष्ठिरः ।\nषडग्निनाऽथ यज्ञेन सोऽयजद् दक्षिणावता ।\nसर्वान् जनान् सर्वकामैः समृद्धैः समतर्पयत्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2120963, "chapter_id": 3589, "verse_number": "६९", "content_sanskrit": "अन्नवान् बहुभक्ष्यश्च भुक्तवज्जनसंवृतः ।\nरत्नोपहारकर्मण्यो बभूव स महानृपः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2120964, "chapter_id": 3589, "verse_number": "७०", "content_sanskrit": "इध्माज्यसोमाहुतिभिः मन्त्राक्षरसमन्वितैः ।\nतस्मिन् हि ततृपुर्देवास्तते यज्ञे महर्षिभिः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2120965, "chapter_id": 3589, "verse_number": "७१", "content_sanskrit": "यथा देवास्तथा विप्रा दक्षिणाभिर्महाधनैः ।\nततृपुः सर्ववर्णाश्च तस्मिन् यज्ञे मुदाऽन्विताः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2120966, "chapter_id": 3589, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि एकत्रिंशोऽध्यायः ॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2120967, "chapter_id": 3589, "verse_number": "२", "content_sanskrit": "राजसूयपर्वणि द्वितीयोऽध्यायः ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2120968, "chapter_id": 3589, "verse_number": "", "content_sanskrit": "॥ समाप्तं राजसूययागपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2120969, "chapter_id": 3589, "verse_number": "", "content_sanskrit": "— ० —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]