[{"id": 7001972000, "chapter_id": 21972, "verse_number": "१७-१", "content_sanskrit": "अग्निरुवाच ।\nजगत्सर्गादिकां क्रीडां विष्णोर्वक्ष्येधुना श्रृणु ।\nस्वर्गादिकृत् स सर्गादिः सृष्ट्यादिः सगुणोगुणः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001972001, "chapter_id": 21972, "verse_number": "१७-२", "content_sanskrit": "ब्रह्माव्यक्तं सदाग्रेऽभूत् न खं रात्रिदिनादिकम् ।\nप्रकृतिं पुरुषं विष्णुः प्रविश्याक्षोभयत्ततः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001972002, "chapter_id": 21972, "verse_number": "१७-३", "content_sanskrit": "सर्गकाले महत्तत्त्वमहङ्कारस्ततोऽभवत् ।\nवैकारिकस्तैजसश्च भूतादिश्चैव तामसः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001972003, "chapter_id": 21972, "verse_number": "१७-४", "content_sanskrit": "अहङ्काराच्छब्दमात्रमाकाशमभवत्ततः ।\nस्पर्शमात्रोऽनिलस्तस्माद्रूपमात्रोऽनलस्ततः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001972004, "chapter_id": 21972, "verse_number": "१७-५", "content_sanskrit": "रसमात्रा आप इतो गन्धमात्रा मही स्मृता ।\nअहङ्कारात्तामसात्तु तैजसानी न्द्रियाणि च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001972005, "chapter_id": 21972, "verse_number": "१७-६", "content_sanskrit": "वैकारिका दशदेवा मन एकादशेन्द्रियम् ।\nततः स्वयम्भूर्भगवान् सिसृक्षुर्विविधाः प्रजाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001972006, "chapter_id": 21972, "verse_number": "१७-७", "content_sanskrit": "अप एव ससर्जादौ तासु वीर्यमवासृजत् ।\nआपो नारा इति प्रोक्ता आपो वै नरसूनवः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001972007, "chapter_id": 21972, "verse_number": "१७-८", "content_sanskrit": "अयनन्तस्य ताः पूर्वन्तेन नारायणः स्मृतः ।\nहिरण्यवर्णमभवत् तदण्डमुदकेशयम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001972008, "chapter_id": 21972, "verse_number": "१७-९", "content_sanskrit": "तस्मिन् जज्ञे स्वयं ब्रह्मा स्वयम्भूरिति नः श्रुतम् ।\nहिरण्यगर्भो भगवानुषित्वा परिवत्सरम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001972009, "chapter_id": 21972, "verse_number": "१७-१०", "content_sanskrit": "तदण्डमकरोद् द्वैधन्दिवं भुवमथापि च ।\nतयोः शकलयोर्म्मध्ये आकाशमसृजत् प्रभुः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001972010, "chapter_id": 21972, "verse_number": "१७-११", "content_sanskrit": "अप्सुं पारिप्लवां पृथ्वीं दिशश्च दशधा दधे ।\nतत्र कालंमनोवाचं कामं क्रोधमयो रतिम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001972011, "chapter_id": 21972, "verse_number": "१७-१२", "content_sanskrit": "ससर्ज सृष्टिन्तद्रूपां स्त्रष्टुमिच्छन् प्रजापतिः ।\nविद्युतोशनिमेघांश्च रोहितेन्द्रधनूंषि च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001972012, "chapter_id": 21972, "verse_number": "१७-१३", "content_sanskrit": "वयांसि च ससर्जादौ पर्जन्यञ्चाथ वक्त्रतः ।\nऋचो यजूंषि सामानि निर्ममे यज्ञासिद्धये ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001972013, "chapter_id": 21972, "verse_number": "१७-१४", "content_sanskrit": "साध्यास्तैरयजन्देवान् भूतमुच्चावचं भुजात् ।\nसनत्कुमारं रुद्रञ्च ससर्ज्ज क्रोधसम्भवम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001972014, "chapter_id": 21972, "verse_number": "१७-१५", "content_sanskrit": "मरीचिमत्र्यङ्गिरसं पुलस्त्यं पुलहं क्रतुम् ।\nवसिष्ठं मानसाः सप्त ब्रह्माण इति निश्चिताः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001972015, "chapter_id": 21972, "verse_number": "१७-१६", "content_sanskrit": "सप्तैते जनयन्ति स्म प्रजा रुद्रश्च सत्तम ।\nद्विधा कृत्वात्मनो देहमर्द्धेन पुरुषोऽभवत् ।\nअर्द्धेन नारी तस्यां स ब्रह्मा वै चासृजत् प्रजाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]