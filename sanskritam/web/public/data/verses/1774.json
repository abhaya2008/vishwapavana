[{"id": 2035730, "chapter_id": 1774, "verse_number": "५-१९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2035731, "chapter_id": 1774, "verse_number": "५-१९-१", "content_sanskrit": "युयुधानस्ततो वीरः सात्वतानां महारथः।\nमहता चतुरङ्गेण बलेनागाद्युधिष्ठिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2035732, "chapter_id": 1774, "verse_number": "५-१९-२", "content_sanskrit": "तस्य योधा महावीर्या नानादेशसमागताः।\nनानाप्रहरणा वीराः शोभयांचक्रिरे बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2035733, "chapter_id": 1774, "verse_number": "५-१९-३", "content_sanskrit": "परश्वथैर्भिण्डिपालैः शूलतोमरमुद्गरैः ।\nपरिघैर्यष्टिभिः पाशैः करवालैश्च निर्मलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2035734, "chapter_id": 1774, "verse_number": "५-१९-४", "content_sanskrit": "खङ्गकार्मुकनिर्यूहैः शरैश्च विविधैरपि ।\nतैलधौतैः प्रकाशद्भिस्तदशोभत वै बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2035735, "chapter_id": 1774, "verse_number": "५-१९-५", "content_sanskrit": "तस्य मेघप्रकाशस्य सौवर्णौः शोभितस्य च।\nबभूव रूपं सैन्यस्य मेघस्येव सविद्युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2035736, "chapter_id": 1774, "verse_number": "५-१९-६", "content_sanskrit": "अक्षौहिणी तु सा सेना तदा यौधिष्ठिरं बलम्।\nप्रविश्यान्तर्दधे राजन्सागरं कुनदी यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2035737, "chapter_id": 1774, "verse_number": "५-१९-७", "content_sanskrit": "तथैवाक्षौहिणीं गृह्य चेदीनामृषभो बली ।\nधृष्टकेतुरुपागच्चत्पाण्डवानमितौजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2035738, "chapter_id": 1774, "verse_number": "५-१९-८", "content_sanskrit": "मागधश्च जयत्सेनो जारासन्धिर्महाबलः ।\nअक्षौहिण्यैव सैन्यस्य धर्मराजमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2035739, "chapter_id": 1774, "verse_number": "५-१९-९", "content_sanskrit": "तथैव पाण्ड्यो राजेन्द्र सागरानूपवासिभिः।\nवृतो बहुविधैर्योधैर्युधिष्ठिरमुपागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2035740, "chapter_id": 1774, "verse_number": "५-१९-१०", "content_sanskrit": "तस्य सैन्यमतीवासीत्तस्मिन्बलसमागमे।\nप्रेक्षणीयतरं राजन्सुवेषं बलवत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2035741, "chapter_id": 1774, "verse_number": "५-१९-११", "content_sanskrit": "` केकयाश्च नरव्याघ्राः सोदराः पञ्च पार्थिवाः ।\nसंहर्षयन्तः कौन्तेयोनक्षौहिण्या समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2035742, "chapter_id": 1774, "verse_number": "५-१९-१२", "content_sanskrit": "द्रुपदस्याप्यभूत्सेना नानादेशसमागतैः।\nशोभिता पुरुषैः शूरैः पुत्रैश्चास्य महारथैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2035743, "chapter_id": 1774, "verse_number": "५-१९-१३", "content_sanskrit": "तथैव राजा मत्स्यानां विराटो वाहिनीपतिः ।\nपार्वतीयैर्महीपालैः सहितः पाण्डवानयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2035744, "chapter_id": 1774, "verse_number": "५-१९-१४", "content_sanskrit": "इतश्चेतश्च पाण्डूनां समाजग्मुर्महात्मनाम् ।\nअक्षौहिण्यस्तु सप्तैव विविधध्वजसङ्कुलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2035745, "chapter_id": 1774, "verse_number": "५-१९-१५", "content_sanskrit": "युयुत्समानाः कुरुभिः पाण्डवान्समहर्षयन् ।\nतथैव धार्तराष्ट्रस्य हर्षं समभिर्धयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2035746, "chapter_id": 1774, "verse_number": "५-१९-१६", "content_sanskrit": "भगदत्तो महीपालः सेनामक्षौहिणीं ददौ।\nतस्य चीनैः किरातैश्च काञ्चनैरिव संवृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2035747, "chapter_id": 1774, "verse_number": "५-१९-१७", "content_sanskrit": "बभौ बलमनाधृष्यं कर्णिकारवनं यथा।\nतथा भूरिश्रवाः शूरः शल्यश्च कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2035748, "chapter_id": 1774, "verse_number": "५-१९-१८", "content_sanskrit": "दुर्योधनमुपायातावक्षौहिण्या पृथक्पृथक् ।\nकृतवर्मा च हार्दिक्यो भोजान्धकुकुरैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2035749, "chapter_id": 1774, "verse_number": "५-१९-१९", "content_sanskrit": "अक्षौहिण्यैव सेनाया दुर्योधनमुपागमत्।\nतस्य तैः पुरुषव्याघ्रैर्वनमालाधरैर्बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2035750, "chapter_id": 1774, "verse_number": "५-१९-२०", "content_sanskrit": "अशोभत यथा मत्तैर्वनं प्रक्रीडितैर्गजैः ।\nजयद्रथमुखाश्चान्ये सिन्धुसौवीरवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2035751, "chapter_id": 1774, "verse_number": "५-१९-२१", "content_sanskrit": "आजग्मुः पृथिवीपालाः कम्पयन्त इवाचलान्।\nतेषामक्षौहिणी सेना बहुला विबभौ तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2035752, "chapter_id": 1774, "verse_number": "५-१९-२२", "content_sanskrit": "विधूयमानो वातेन बहुरूप इवाम्बुदः।\nसुदक्षिणश्च काम्भोजो यवनैश्च शकैस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2035753, "chapter_id": 1774, "verse_number": "५-१९-२३", "content_sanskrit": "उपाजगाम कौरव्यमक्षौहिण्या विशांपते ।\nतस्य सेनासमावायः शलभानामिवाबभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2035754, "chapter_id": 1774, "verse_number": "५-१९-२४", "content_sanskrit": "स च संप्राप्य कौरव्यं तत्रैवान्तर्दधे तदा।\nतथा महिष्मतीवासी नीलो नीलायुधैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2035755, "chapter_id": 1774, "verse_number": "५-१९-२५", "content_sanskrit": "महीपालो महावीर्यैर्दक्षिणापथवासिभिः ।\nआवन्त्यौ च महीपालौ महाबलसुसंवृतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2035756, "chapter_id": 1774, "verse_number": "५-१९-२६", "content_sanskrit": "पृथगक्षौहिणीभ्यां तावभियातौ सुयोधनम् ।\nततस्ततस्तु सर्वेषां भूमिपानां महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2035757, "chapter_id": 1774, "verse_number": "५-१९-२७", "content_sanskrit": "तिस्रोऽन्याः समवर्तन्त वाहिन्यो भरतर्षभ ।\nएवमेकादशावृत्ताः सेना दुर्योधनस्य ताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2035758, "chapter_id": 1774, "verse_number": "५-१९-२८", "content_sanskrit": "युयुत्समानाः कौन्तेयान्नानाध्वजसमाकुलाः ।\nन हास्तिनपुरे राजन्नवकाशोऽभवत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2035759, "chapter_id": 1774, "verse_number": "५-१९-२९", "content_sanskrit": "राज्ञां स्वबलमुख्यानां प्राधान्येनापि भारत ।\nततः प़ञ्चनदं चैव कृत्स्नं च कुरुजाङ्गलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2035760, "chapter_id": 1774, "verse_number": "५-१९-३०", "content_sanskrit": "तथा रोहितकारण्यं मरुभूमिश्च केवला।\nअहिच्छत्रं कालकूटं गङ्गाकूलं च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2035761, "chapter_id": 1774, "verse_number": "५-१९-३१", "content_sanskrit": "वारणं वाटधानं च यामुनश्चैव पर्वतः।\nएष देशः सुविस्तीर्णः प्रभूतधनधान्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2035762, "chapter_id": 1774, "verse_number": "५-१९-३२", "content_sanskrit": "बभूव कौरवेयाणां बलेनातीव संवृतः।\nतत्र सैन्यं तथा युक्तं ददर्श स पुरोहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2035763, "chapter_id": 1774, "verse_number": "५-१९-३३", "content_sanskrit": "यः स पाञ्चालराजेन प्रेषितः कौरवान्प्रति ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2035764, "chapter_id": 1774, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि सेनोद्योगपर्वणि एकोनविंशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]