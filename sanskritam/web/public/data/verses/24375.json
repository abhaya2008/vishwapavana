[{"id": 7004375000, "chapter_id": 24375, "verse_number": "५-३-६९-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततो गच्छेत्तु राजेन्द्र मङ्गलेश्वरमुत्तमम् ।\nस्थापितं भूमिपुत्रेण लोकानां हितकाम्यया॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004375001, "chapter_id": 24375, "verse_number": "५-३-६९-२", "content_sanskrit": "तोषितः परया भक्त्या शङ्करः शशिशेखरः ।\nचतुर्दश्यां गुरुर्देवः प्रत्यक्षो मङ्गलेश्वरः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004375002, "chapter_id": 24375, "verse_number": "५-३-६९-३", "content_sanskrit": "ब्रूहि पुत्र वरं शुभ्रं तं ते दास्यामि मङ्गल॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004375003, "chapter_id": 24375, "verse_number": "५-३-६९-४", "content_sanskrit": "मङ्गल उवाच ।\nप्रसादं कुरु मे शम्भो प्रतिजन्मनि शङ्कर ।\nत्वदङ्गस्वेदसम्भूतो ग्रहमध्ये वसाम्यहम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004375004, "chapter_id": 24375, "verse_number": "५-३-६९-५", "content_sanskrit": "त्वत्प्रसादेन ईशान पूज्योऽहं सर्वदैवतैः ।\nकृतार्थो ह्यद्य संजातस्तव दर्शनभाषणात्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004375005, "chapter_id": 24375, "verse_number": "५-३-६९-६", "content_sanskrit": "स्थानेऽस्मिन् देवदेवेश मम नाम्ना महेश्वरः ।\nएवं भवतु ते पुत्रेत्युक्त्वा चान्तरधीयत॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004375006, "chapter_id": 24375, "verse_number": "५-३-६९-७", "content_sanskrit": "मङ्गलोऽपि महात्मा वै स्थापयित्वा महेश्वरम् ।\nआत्मयोगबलेनैव शूलिनापूजयत्ततः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004375007, "chapter_id": 24375, "verse_number": "५-३-६९-८", "content_sanskrit": "सर्वदुःखहरं लिङ्गं नाम्ना वै मङ्गलेश्वरम् ।\nतत्र तीर्थे तु वै राजन्ब्राह्मणान्प्रीणयेत्सुधीः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004375008, "chapter_id": 24375, "verse_number": "५-३-६९-९", "content_sanskrit": "सपत्नीकान्नृपश्रेष्ठ चतुर्थ्यङ्गारके व्रते ।\nपत्नीभर्तारसंयुक्तं विद्वांसं श्रोत्रियं द्विजम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004375009, "chapter_id": 24375, "verse_number": "५-३-६९-१०", "content_sanskrit": "व्रतान्ते चैव गौर्धुर्यैः शिवमुद्दिश्य दीयते ।\nप्रीयतां मे महादेवः सपत्नीको वृषध्वजः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004375010, "chapter_id": 24375, "verse_number": "५-३-६९-११", "content_sanskrit": "वस्त्रयुग्मं प्रदातव्यं लोहितं पाण्डुनन्दन ।\nधूर्वहौ रक्तवर्णौ च शुभ्रं कृष्णं तथैव च॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004375011, "chapter_id": 24375, "verse_number": "५-३-६९-१२", "content_sanskrit": "छत्रं शय्यां शुभां चैव रक्तमाल्यानुलेपनम् ।\nदातव्यं पाण्डवश्रेष्ठ विशुद्धेनान्तरात्मना॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004375012, "chapter_id": 24375, "verse_number": "५-३-६९-१३", "content_sanskrit": "चतुर्थ्यां तु तथाष्टम्यां पक्षयोः शुक्लकृष्णयोः ।\nश्राद्धं तत्रैव कर्तव्यं वित्तशाठ्येन वर्जितः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004375013, "chapter_id": 24375, "verse_number": "५-३-६९-१४", "content_sanskrit": "प्रेता भवन्ति सुप्रीता युगमेकं महीपते ।\nसपुत्रो जायते मर्त्यः प्रतिजन्म नृपोत्तम॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004375014, "chapter_id": 24375, "verse_number": "५-३-६९-१५", "content_sanskrit": "तस्य तीर्थस्य भावेन सर्वाङ्गरुचिरो नृप ।\nमङ्गलं भवते वंशो नाशुभं विद्यते क्वचित्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004375015, "chapter_id": 24375, "verse_number": "५-३-६९-१६", "content_sanskrit": "भक्त्या यः कीर्तयेन्नित्यं तस्य पापं व्यपोहति॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]