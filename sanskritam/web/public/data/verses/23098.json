[{"id": 7003098000, "chapter_id": 23098, "verse_number": "४-३४-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nएतस्मिन्नन्तरे तत्र शंकरः समुपस्थितः ।\nसस्मितो वृषभेन्द्रस्थो विभूतिभूषणः स्वयम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003098001, "chapter_id": 23098, "verse_number": "४-३४-२", "content_sanskrit": "व्याघ्रचर्माम्बरधरो नागयज्ञोपवीतकः ।\nस्वर्णाकारजटाधारमर्धचन्द्रं च सन्दधत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003098002, "chapter_id": 23098, "verse_number": "४-३४-३", "content_sanskrit": "त्रिशूलपट्टिशकरो बिभ्रत्खट्वाङ्गमुत्तमम् ।\nसद्रत्नसाररचितस्वरयन्त्रकरो मुदा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003098003, "chapter_id": 23098, "verse_number": "४-३४-४", "content_sanskrit": "वाहनादवरुह्याशु भक्तिनम्रात्मकन्धरः ।\nप्रणम्य कमलाकान्तं वामे चोवास भक्तितः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003098004, "chapter_id": 23098, "verse_number": "४-३४-५", "content_sanskrit": "आजग्मुर्मुनयः सर्वे सुराः शक्रादयस्तथा। ।\nआदित्या वसवो रुद्रा मनवः सिद्धचारणाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003098005, "chapter_id": 23098, "verse_number": "४-३४-६", "content_sanskrit": "पुलकाञ्चितसर्वाङ्गास्तुष्टुवुः पुरुषोत्तमम् ।\nप्रणम्य तं शिवं सर्वे सुराश्च नम्रकन्ध राः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003098006, "chapter_id": 23098, "verse_number": "४-३४-७", "content_sanskrit": "एतस्मिन्नन्तरे तत्र संगीतं शंकरो जगौ ।\nकृत्वाऽतीव सुतालं च स्वरयन्त्रसमन्वितः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003098007, "chapter_id": 23098, "verse_number": "४-३४-८", "content_sanskrit": "आवयोश्च गुणाख्यानं राससंबन्धि सुन्दरम् ।\nसमयोचितरागेण मनोमोहनकारिणा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003098008, "chapter_id": 23098, "verse_number": "४-३४-९", "content_sanskrit": "यत्र कण्ठैकमानेन चैकतानेन चारुणा।\nपदभेदविरामेण गुरुणा लघुना क्रमात् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003098009, "chapter_id": 23098, "verse_number": "४-३४-१०", "content_sanskrit": "गमकेनातिदीर्घेण मदेन मधुरेण च ।\nभवेऽतिदुर्लभं सृष्टं प्रीत्या स्वेन विनिर्मितम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003098010, "chapter_id": 23098, "verse_number": "४-३४-११", "content_sanskrit": "पुलकाञ्चितसर्वाङ्गः साश्रुनेत्रः पुनःपुनः ।\nतदेव श्रुतिमात्रेण मूर्च्छां प्रापुर्विचेतनाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003098011, "chapter_id": 23098, "verse_number": "४-३४-१२", "content_sanskrit": "बभूवु रुद्ररूपाश्च मुनयः पुरतः प्रिये ।\nरुद्ररूपाः सुराः सर्वे विधातृहरिपार्षदाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003098012, "chapter_id": 23098, "verse_number": "४-३४-१३", "content_sanskrit": "नारायणश्च लक्ष्मीश्च गायकश्च शिवः स्वयम् ।\nजलपूर्णं च वैकुण्ठं दृष्ट्वा त्रस्तोऽहमीश्वरि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003098013, "chapter_id": 23098, "verse_number": "४-३४-१४", "content_sanskrit": "गत्वा मूर्तीर्विनिर्माय सर्वाश्च तादृशीरिति ।\nतत्स्वरूपास्तदस्त्राश्च तत्स्ववाहनभूषणाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003098014, "chapter_id": 23098, "verse_number": "४-३४-१५", "content_sanskrit": "तत्स्वभावास्तन्मनस्कास्तत्तद्विषयमानसाः ।\nस्थानं निर्माय परितो वैकुण्ठस्य चतुर्दिशि ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003098015, "chapter_id": 23098, "verse_number": "४-३४-१६", "content_sanskrit": "तदधिष्ठातृदेवी च आजगाम स्वमालयम् ।\nशरीरजा सुराणां सा बभूव सुरनिम्नगा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003098016, "chapter_id": 23098, "verse_number": "४-३४-१७", "content_sanskrit": "मुक्तिदा च मुमुक्षूणां भक्तानां हरिभक्तिदा ।\nकोटिजन्मार्जितं पापं विविधं पापिनामहो ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003098017, "chapter_id": 23098, "verse_number": "४-३४-१८", "content_sanskrit": "यस्याश्च स्पर्शवायोश्च संपर्केण विनश्यति ।\nकिं वा न जाने प्राणेशि स्पर्शदर्शनयोः फलम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003098018, "chapter_id": 23098, "verse_number": "४-३४-१९", "content_sanskrit": "किमुत स्नानजन्यं च कथयामि निरूपणम् ।\nसर्वतीर्थात्परं पृथ्व्यां पुष्करं परिकीर्तितम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003098019, "chapter_id": 23098, "verse_number": "४-३४-२०", "content_sanskrit": "वेदोक्तं च तदेवास्याः कलां नार्हंति षोडशीम् ।\nभगीरथेन चानीता तेन भागीरथी स्मृता ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003098020, "chapter_id": 23098, "verse_number": "४-३४-२१", "content_sanskrit": "गामागता स्रोतसोंऽशाद्गङ्गा तेन प्रकीर्तिता ।\nजानुद्वारा पुरा दत्ता जह्नुनाऽऽपीय कोपतः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003098021, "chapter_id": 23098, "verse_number": "४-३४-२२", "content_sanskrit": "तस्य कन्यास्वरूपा सा जाह्नवी तेन कीर्तिता ।\nभीष्मः स्वयं वसुर्जातस्तस्यांशात्तेन भीष्मसूः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003098022, "chapter_id": 23098, "verse_number": "४-३४-२३", "content_sanskrit": "धाराभिस्तिसृभिः स्वर्गं पृथिवीमतलं तथा ।\nममाज्ञया च गच्छन्ती तेन त्रिपथगामिनी ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003098023, "chapter_id": 23098, "verse_number": "४-३४-२४", "content_sanskrit": "प्रधानधारया स्वर्गे सा च मन्दाकिनी स्मृता ।\nयोजनायुतविस्तीर्णा प्रस्थे च योजना स्मृता ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003098024, "chapter_id": 23098, "verse_number": "४-३४-२५", "content_sanskrit": "क्षीरतुल्यजला शश्वदत्युत्तुङ्गतरङ्गिणी ।\nवैकुण्ठाद्ब्रह्मलोकं च ततः स्वर्गं समागता ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003098025, "chapter_id": 23098, "verse_number": "४-३४-२६", "content_sanskrit": "स्वर्गाद्धिमाद्रिमार्गेण पृथिवीमागता मुदा ।\nसा धाराऽलकनंदाख्या लवणोदेन मिश्रिता ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003098026, "chapter_id": 23098, "verse_number": "४-३४-२७", "content_sanskrit": "शुद्धस्फटिकसंकाशा बहुवेगवती सती ।\nपापिनां पापशुष्केन्धं दग्धुं पावकरूपिणी ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003098027, "chapter_id": 23098, "verse_number": "४-३४-२८", "content_sanskrit": "अहो सगरवंशेभ्यो निर्वाणमुक्तिदायिनी ।\nवैकुण्ठगामिगी सा च सोपानरूपिणी वरा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003098028, "chapter_id": 23098, "verse_number": "४-३४-२९", "content_sanskrit": "अतोऽपि मृत्युसमये सतां पुण्यस्वरूपिणाम् ।\nआदौ पादौ च संन्यस्य मुखे तोयं प्रदीयते ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003098029, "chapter_id": 23098, "verse_number": "४-३४-३०", "content_sanskrit": "गङ्गासोपानमारुह्य सन्तो यान्ति निरामयम् ।\nआब्रह्मलोकं संलंघ्य रथस्थाश्च निरापदः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003098030, "chapter_id": 23098, "verse_number": "४-३४-३१", "content_sanskrit": "दैवात्पुरा प्राक्तनेन मग्नं चेत्कृतपातकैः ।\nलोमप्रमाणवर्षं च मोदन्ते हरिमन्दिरे ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003098031, "chapter_id": 23098, "verse_number": "४-३४-३२", "content_sanskrit": "ततो भोगो भवेत्तेषां निश्चितं पापपुण्ययोः ।\nअतिस्वल्पेन कालेन कालव्यूहं च बिभ्रताम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003098032, "chapter_id": 23098, "verse_number": "४-३४-३३", "content_sanskrit": "ततः पुण्यवतां गेहे लब्ध्वा जन्म च भारते ।\nसंप्राप्य निश्चलां भक्तिं भवन्ति हरिरूपिणः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003098033, "chapter_id": 23098, "verse_number": "४-३४-३४", "content_sanskrit": "मृतद्विजानां देहांश्च दैवाच्छूद्रा वहन्ति चेत् ।\nपदप्रमाणवर्षं च तेषां च नरके स्थितिः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003098034, "chapter_id": 23098, "verse_number": "४-३४-३५", "content_sanskrit": "ततस्तेषां च साहाय्यं करोति हरिरूपिणी। ।\nददाति मुक्तिं तेभ्योऽपि क्रमेण च कृपामयी ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003098035, "chapter_id": 23098, "verse_number": "४-३४-३६", "content_sanskrit": "जन्म पुण्यवतां गेहे कारयित्वा च भारते।\nस्थलं ददाति वैकुण्ठे निश्चितं जन्मभिस्त्रिभिः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003098036, "chapter_id": 23098, "verse_number": "४-३४-३७", "content_sanskrit": "यात्रां कृत्वा तु यः शुद्धौ स्नातुं याति सुरेश्वरीम् ।\nपदप्रमाणवर्षं च वैकुण्ठे मोदते ध्रुवम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003098037, "chapter_id": 23098, "verse_number": "४-३४-३८", "content_sanskrit": "गङ्गां प्राप्यानुषङ्गेण स्नाति चेत्समलो नरः ।\nमुच्यते सर्वपापेभ्यः पुनर्यदि न लिप्यते ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003098038, "chapter_id": 23098, "verse_number": "४-३४-३९", "content_sanskrit": "कलौ पञ्च सहस्राब्दं स्थितिस्तस्याश्च भारते ।\nतस्यां च विद्यमानायां कः प्रभावः कलेरहो ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003098039, "chapter_id": 23098, "verse_number": "४-३४-४०", "content_sanskrit": "कलौ दशसहस्राणि वर्षाणि प्रतिमा मम।\nतिष्ठन्ति च पुराणानि प्रभावस्तत्र कः कलेः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003098040, "chapter_id": 23098, "verse_number": "४-३४-४१", "content_sanskrit": "अतलं याति या धारा सा च भोगवती स्मृता ।\nपयःफेननिभा शश्वदतिवेगवती सदा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003098041, "chapter_id": 23098, "verse_number": "४-३४-४२", "content_sanskrit": "आकरामूल्यरत्नानां मणीन्द्राणां च संततम् ।\nनागकन्याश्च यत्तीरे क्रीडन्ति स्थिरयौवनाः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003098042, "chapter_id": 23098, "verse_number": "४-३४-४३", "content_sanskrit": "स्वयं देवी च वैकुण्ठं वेष्टयित्वा च संततम् ।\nसहस्रयोजना प्रस्थे दैर्घ्ये च लक्षयोजना ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003098043, "chapter_id": 23098, "verse_number": "४-३४-४४", "content_sanskrit": "अस्या विनाशः प्रलये नास्त्येव दुहितुर्मम ।\nनानारत्नाकरं दिव्यं तत्तीरं सुमनोहरम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003098044, "chapter_id": 23098, "verse_number": "४-३४-४५", "content_sanskrit": "इत्येवं कथितं सर्वं जाह्नवीजन्म पुण्यदम् ।\nब्रह्मणश्च प्रतीकारो मोहिनीशापता शृणु ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]