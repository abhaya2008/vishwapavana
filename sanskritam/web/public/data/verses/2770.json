[{"id": 2083017, "chapter_id": 2770, "verse_number": "१२-२७५-०x", "content_sanskrit": "कपिल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2083018, "chapter_id": 2770, "verse_number": "१२-२७५-१", "content_sanskrit": "एतावदनुपश्यन्तो यतयो यान्ति मार्गगाः।\nनैषां सर्वेषु लोकेषु कश्चिदस्ति व्यतिक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2083019, "chapter_id": 2770, "verse_number": "१२-२७५-२", "content_sanskrit": "निर्द्वन्द्वा निर्नमस्कारा निराशीर्बन्धना बुधाः।\nविमुक्ताः सर्वपापेभ्यश्चरन्ति शुचयोऽमलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2083020, "chapter_id": 2770, "verse_number": "१२-२७५-३", "content_sanskrit": "अपवर्गेऽथ संत्यागे बुद्धौ च कृतनिश्चयाः।\nब्रह्मिष्ठा ब्रह्मभूताश्च ब्रह्मण्येव कृतालयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2083021, "chapter_id": 2770, "verse_number": "१२-२७५-४", "content_sanskrit": "येऽशोका नष्टरजसस्तेषां लोकाः सनातनाः।\nतेषां गतिं परां प्राप्य गार्हस्थ्ये किं प्रयोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2083022, "chapter_id": 2770, "verse_number": "१२-२७५-५x", "content_sanskrit": "स्यूमरश्मिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2083023, "chapter_id": 2770, "verse_number": "१२-२७५-५", "content_sanskrit": "यद्येषां परमा निष्ठा यद्येषां परमा गतिः।\nगृहस्थानव्यपाश्रित्य नाश्रमोऽन्यः प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2083024, "chapter_id": 2770, "verse_number": "१२-२७५-६", "content_sanskrit": "यथा मातरमाश्रित्य सर्वे जीवन्ति जन्तवः।\nएवं गार्हस्थ्यमाश्रित्य वर्तन्त इतराश्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2083025, "chapter_id": 2770, "verse_number": "१२-२७५-७", "content_sanskrit": "गृहस्थ एव यजते गृहस्थस्तप्यते तपः।\nगार्हस्थ्यमस्य धर्मस्य मूलं यत्किंचिदेव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2083026, "chapter_id": 2770, "verse_number": "१२-२७५-८", "content_sanskrit": "प्रजनाद्यभिनिर्वृत्ताः सर्वे प्राणभृतो मुनेः।\nप्रजनं चाप्युतान्यत्र न कथंचन विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2083027, "chapter_id": 2770, "verse_number": "१२-२७५-९", "content_sanskrit": "यास्तु स्युर्बहिरोषध्यो बहिरन्यास्तथाऽद्रिजाः।\nओषधिभ्यो बहिर्यस्मात्प्राणी कश्चिन्न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2083028, "chapter_id": 2770, "verse_number": "१२-२७५-१०", "content_sanskrit": "कस्यैषा वाग्भवेत्सत्या मोक्षो नास्ति गृहादिति।\nअश्रद्दधानैरप्राज्ञैः सूक्ष्मदर्शनवर्जितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2083029, "chapter_id": 2770, "verse_number": "१२-२७५-११", "content_sanskrit": "निराशैरलसैः श्रान्तैस्तप्यमानैः स्वकर्मभिः।\nशमस्योपरमो दृष्टः प्रव्रज्यायामपण़्डितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2083030, "chapter_id": 2770, "verse_number": "१२-२७५-१२", "content_sanskrit": "त्रैलोक्यस्येव हेतुर्हि मर्यादा शाश्वती ध्रुवा।\nब्राह्मणो नाम भगवाञ्जन्मप्रभृति पूज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2083031, "chapter_id": 2770, "verse_number": "१२-२७५-१३", "content_sanskrit": "प्राग्गर्भाघानमन्त्रा हि प्रवर्तन्ते द्विजातिषु।\nअविश्वस्तेषु वर्तन्ते विश्वस्तेष्वपि संश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2083032, "chapter_id": 2770, "verse_number": "१२-२७५-१४", "content_sanskrit": "दाहे पुनः संश्रयणे संश्रिते पात्रभोजने।\nदानं गवां पशूनां वा पिण्डानामप्सु मज्जनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2083033, "chapter_id": 2770, "verse_number": "१२-२७५-१५", "content_sanskrit": "अर्चिष्मन्तो बर्हिषदः क्रव्यादाः पितरस्तथा।\nमृतस्याप्यनुमन्यन्ते मन्त्रा मन्त्राश्च कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2083034, "chapter_id": 2770, "verse_number": "१२-२७५-१६", "content_sanskrit": "एवं क्रोशत्सु वेदेषु कुतो मोक्षोऽस्ति कस्यचित्।\nऋणवन्तो यदा मर्त्याः पितृदेवद्विजातिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2083035, "chapter_id": 2770, "verse_number": "१२-२७५-१७", "content_sanskrit": "श्रिया विहीनैरलसैः पण्डितैश्च पलायितम्।\nवेदवादापरिज्ञानं सत्याभासमिवानृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2083036, "chapter_id": 2770, "verse_number": "१२-२७५-१८", "content_sanskrit": "न वै पापैर्हियते कृष्यते वा\nयो ब्राह्मणो यजते वेदशास्त्रैः।\nऊर्ध्वं यजन्पशुभिः सार्धमेति\nततः पुनस्तर्कयते न कामान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2083037, "chapter_id": 2770, "verse_number": "१२-२७५-१९", "content_sanskrit": "न वेदानां परिभवान्न शाठ्येन न मायया।\nमहत्प्राप्नोति पुरुषो ब्राह्मणो ब्रह्म विन्दति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2083038, "chapter_id": 2770, "verse_number": "१२-२७५-२०x", "content_sanskrit": "कपिल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2083039, "chapter_id": 2770, "verse_number": "१२-२७५-२०", "content_sanskrit": "दर्शश्च पूर्णमासश्च अग्निहोत्रं च धीमताम्।\nचातुर्मास्यानि चैवासंस्तेषु यज्ञः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2083040, "chapter_id": 2770, "verse_number": "१२-२७५-२१", "content_sanskrit": "अनारम्भाः सुधृतयः शुचयो ब्रह्मसंज्ञिताः।\nब्राह्मणा एव ते देवांस्तर्पन्त्यमृतैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2083041, "chapter_id": 2770, "verse_number": "१२-२७५-२२", "content_sanskrit": "सर्वभूतात्मभूतस्य सर्वभूतानि पश्यतः।\nदेवाऽपि मार्गे मुह्यन्ति ह्यपदस्य पदैषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2083042, "chapter_id": 2770, "verse_number": "१२-२७५-२३", "content_sanskrit": "चतुर्द्वारं पुरुष चर्तुर्मुखं\nचतुर्मुखो नैनमुपैति निन्दा।\nबाहुभ्यां पद्भ्यामुदरादुपस्था\nत्तेषां द्वारं द्वारपालो बुभूषेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2083043, "chapter_id": 2770, "verse_number": "१२-२७५-२४", "content_sanskrit": "नाक्षैर्दीव्येन्नाददीतान्यवित्तं\nन वाऽयोनीयस्य शृतं प्रगृह्णात्।\nक्रुद्धो न चैव प्रहरेत धीमां\nस्तथास्य तत्पाणिपादं सुगुप्तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2083044, "chapter_id": 2770, "verse_number": "१२-२७५-२५", "content_sanskrit": "नाक्रोशमृच्छेन्न वृथा वदेच्च\nन पैशुनं जनवादं च कुर्यात्।\nसत्यव्रतो मितभाषोऽप्रमत्त\nस्तथाऽस्य वाग्द्वारमथो सुगुप्तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2083045, "chapter_id": 2770, "verse_number": "१२-२७५-२६", "content_sanskrit": "नानाशनः स्यान्न महाशनः स्या\nन्न लोलुपः साधुभिरागतः स्यात्।\nयात्रार्थमाहारमिहाददीत\nतथाऽस्य स्याज्जाठरद्वारगुप्तिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2083046, "chapter_id": 2770, "verse_number": "१२-२७५-२७", "content_sanskrit": "न वीरपत्नीं विहरेत नारीं\nन चापि नारीमनृतावाह्वयीत।\nभार्याव्रतं ह्यात्मनि धारयीत\nतथास्योपस्थद्वारगुप्तिर्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2083047, "chapter_id": 2770, "verse_number": "१२-२७५-२८", "content_sanskrit": "द्वाराणि यस्य सर्वाणि सुगुप्तानि मनीषिणः।\nउपस्थमुदरं पाणी वाक्चतुर्थी स वै द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2083048, "chapter_id": 2770, "verse_number": "१२-२७५-२९", "content_sanskrit": "मोघान्यगुप्तद्वारस्य सर्वाण्येव भवन्त्युत।\nकिं तस्य तपसा कार्यं किं यज्ञेन किमात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2083049, "chapter_id": 2770, "verse_number": "१२-२७५-३०", "content_sanskrit": "अनुत्तरीयवसनमनुपस्तीर्णशायिनम्।\nबाहूपधानं शाम्यन्तं तं देवा ब्राह्मणं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2083050, "chapter_id": 2770, "verse_number": "१२-२७५-३१", "content_sanskrit": "द्वन्द्वारामेषु सर्वेषु य एको रमते मुनिः।\nपरेषामननुध्यायंस्तं देवा ब्राह्मणं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2083051, "chapter_id": 2770, "verse_number": "१२-२७५-३२", "content_sanskrit": "येन सर्वमिदं बुद्धं प्रकृतिर्विकृतिश्च या।\nगतिज्ञः सर्वभूतानां तं देवा ब्राह्मणं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2083052, "chapter_id": 2770, "verse_number": "१२-२७५-३३", "content_sanskrit": "अभयं सर्वभूतेभ्यः सर्वेषामभयं यतः।\nसर्वभूतात्मभूतो यस्तं देवा ब्राह्मणं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2083053, "chapter_id": 2770, "verse_number": "१२-२७५-३४", "content_sanskrit": "नान्तरेणानुजानाति वेदानां यत्क्रियाफलम्।\nअविज्ञाय च तत्सर्वमन्यद्रोचयते फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2083054, "chapter_id": 2770, "verse_number": "१२-२७५-३५", "content_sanskrit": "स्वकर्मभिः संश्रितानां तपो घोरत्वमागमत्।\nतं सदाचारमाश्चर्यं पुराणं शाश्वतं ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2083055, "chapter_id": 2770, "verse_number": "१२-२७५-३६", "content_sanskrit": "अशक्नुवन्तश्चरितुं किंचिद्धर्मेषु सूत्रितम्।\nनिरापद्धर्म आचारो ह्यप्रमादो पराभवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2083056, "chapter_id": 2770, "verse_number": "१२-२७५-३७", "content_sanskrit": "फलवन्ति च कर्माणि व्युष्टिमन्ति ध्रवाणि च।\nविगुणानि च पश्यन्ति तथा नैकानि केन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2083057, "chapter_id": 2770, "verse_number": "१२-२७५-३८", "content_sanskrit": "गुणाश्चात्र सुदुर्ज्ञेया ज्ञाताश्चात्र सुदुष्कराः।\nअनुष्ठिताश्चान्तवन्त इति त्वमनुपश्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2083058, "chapter_id": 2770, "verse_number": "१२-२७५-३९x", "content_sanskrit": "स्यूमरश्मिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2083059, "chapter_id": 2770, "verse_number": "१२-२७५-३९", "content_sanskrit": "यथा च वेदप्रामाण्यं त्यागश्च सफलो यथा।\nतौ पन्थानावुभौ व्यक्तौ भगवंस्तद्ब्रवीहि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2083060, "chapter_id": 2770, "verse_number": "१२-२७५-४०x", "content_sanskrit": "कपिल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2083061, "chapter_id": 2770, "verse_number": "१२-२७५-४०", "content_sanskrit": "प्रत्यक्षमिह पश्यन्ति भवन्तः सत्पथे स्थिताः।\nप्रत्यक्षं तु किमत्रास्ति यद्भवन्त उपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2083062, "chapter_id": 2770, "verse_number": "१२-२७५-४१x", "content_sanskrit": "स्यूमरश्मिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2083063, "chapter_id": 2770, "verse_number": "१२-२७५-४१", "content_sanskrit": "स्यूमरश्मिरहं ब्रह्मञ्जिज्ञासार्थमिहागतः।\nश्रेयस्कामः प्रत्यवोचमार्जवान्न विवक्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2083064, "chapter_id": 2770, "verse_number": "१२-२७५-४२", "content_sanskrit": "इमं च संशयं घोरं भगवान्प्रब्रवीतु मे।\nप्रत्यक्षमिह पश्यन्तो भवन्तः सत्पथे स्थिताः।\nकिमत्र प्रत्यक्षतमं भवन्तो यदुपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2083065, "chapter_id": 2770, "verse_number": "१२-२७५-४३", "content_sanskrit": "अन्यत्र तर्कशास्त्रेभ्य आगमार्थं यथागमम्।\nआगमो वेदवादास्तु तर्कशास्त्राणि चागमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2083066, "chapter_id": 2770, "verse_number": "१२-२७५-४४", "content_sanskrit": "यथाश्रममुपासीत आगमस्तत्र सिध्यति।\nसिद्धिः प्रत्यक्षरूपा च दृश्यत्यागमनिश्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2083067, "chapter_id": 2770, "verse_number": "१२-२७५-४५", "content_sanskrit": "नौर्नावीव निबद्धा हि स्रोतसा सनिबन्धना।\nह्रियमाणा कथ विप्र कुबुद्धींस्तारयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2083068, "chapter_id": 2770, "verse_number": "१२-२७५-४६", "content_sanskrit": "एतद्ब्रवीतु भगवानुपपन्नोऽस्म्यधीहि भो।\nनैव त्यागी न संतुष्टो नाशोको न निरामयः।\nनानिर्विवित्सो नावृत्तो नापवृत्तोऽस्ति कश्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2083069, "chapter_id": 2770, "verse_number": "१२-२७५-४७", "content_sanskrit": "भवन्तोऽपि च हृष्यन्ति शोचन्ति च यथा वयम्।\nइन्द्रियार्थाश्च भवतां समानाः सर्वजन्तुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2083070, "chapter_id": 2770, "verse_number": "१२-२७५-४८", "content_sanskrit": "एवं चतुर्णां वर्णानामाश्रमाणां प्रवृत्तिषु।\nएकमालम्बमानानां निर्णये किं निरामयम्।\n`एतद्ब्रवीतु भगवानुपपन्नोस्य्यधीहि भो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2083071, "chapter_id": 2770, "verse_number": "१२-२७५-४९x", "content_sanskrit": "कपिल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2083072, "chapter_id": 2770, "verse_number": "१२-२७५-४९", "content_sanskrit": "यद्यदाचरते शास्त्रमर्थ्यं सर्वप्रवृत्तिषु।\nयस्य यत्र ह्यनुष्ठानं तस्य तत्तु निरामयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2083073, "chapter_id": 2770, "verse_number": "१२-२७५-५०", "content_sanskrit": "सर्वं प्रापयति ज्ञानं ये ज्ञानं ह्यनुवर्तते।\nज्ञानादपेत्य या वृत्तिः सा विनाशयति प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2083074, "chapter_id": 2770, "verse_number": "१२-२७५-५१", "content_sanskrit": "भवन्तो ज्ञानिनो नित्यं सर्वतश्च निरमयाः।\nऐकात्म्यं नाम कश्चिद्धि कदाचिदभिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2083075, "chapter_id": 2770, "verse_number": "१२-२७५-५२", "content_sanskrit": "शास्त्रं ह्यबुद्ध्वा तत्त्वेन केचिद्वादबलाज्जनाः।\nकामद्वेषाभिभूतत्वादहंकारवशं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2083076, "chapter_id": 2770, "verse_number": "१२-२७५-५३", "content_sanskrit": "याथातथ्यमविज्ञाय शास्त्राणां शास्त्रदस्यवः।\nब्रह्मस्तेना निरारम्भा अपक्वमनसोऽशिवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2083077, "chapter_id": 2770, "verse_number": "१२-२७५-५४", "content_sanskrit": "नैर्गुण्यमेव पश्यन्ति न गुणाननुयुञ्जते।\nतेषां तमः शरीराणां तम एव परायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2083078, "chapter_id": 2770, "verse_number": "१२-२७५-५५", "content_sanskrit": "यो यथाप्रकृतिर्जन्तुः प्रकृतेः स्याद्वशानुगः।\nतस्य द्वेषश्च कामश्च क्रोधो दम्भोऽनृतं मदः।\nनित्यमेवानुवर्तन्ते गुणाः प्रकृतिसंभवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2083079, "chapter_id": 2770, "verse_number": "१२-२७५-५६", "content_sanskrit": "ये तद्बुद्ध्वाऽनुपश्यन्तः संत्यजेयुः शुभाशुभम्।\nपरां गतिमभीप्सन्तो यतयः संयमे रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2083080, "chapter_id": 2770, "verse_number": "१२-२७५-५७x", "content_sanskrit": "स्यूमरश्मिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2083081, "chapter_id": 2770, "verse_number": "१२-२७५-५७", "content_sanskrit": "सर्वमेतत्त्वया ब्रह्मञ्शास्त्रतः परिकीर्तितम्।\nन ह्यविज्ञाय शास्त्रार्थं प्रवर्तन्ते प्रवृत्तयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2083082, "chapter_id": 2770, "verse_number": "१२-२७५-५८", "content_sanskrit": "यः कश्चिन्न्याय्य आचारः सर्वं शास्त्रमिति श्रुतिः।\nयदन्याय्यमशास्त्रं तदित्येषा श्रूयते श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2083083, "chapter_id": 2770, "verse_number": "१२-२७५-५९", "content_sanskrit": "न प्रवृत्तिर्ऋते शास्त्रात्काचिदस्तीति निश्चयः।\nयदन्यद्वेदवादेभ्यस्तदशास्त्रमिति श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2083084, "chapter_id": 2770, "verse_number": "१२-२७५-६०", "content_sanskrit": "शास्त्रादपेतं पश्यन्ति बहवोऽत्यर्थमानिनः।\nशास्त्रदोषान्न पश्यन्ति इह चामुत्र चापरे।\n[इन्द्रियार्थाश्च भवतां समानाः सर्वजन्तुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2083085, "chapter_id": 2770, "verse_number": "१२-२७५-६१", "content_sanskrit": "एवं चतुर्णां वर्णानामाश्रमाणां प्रवृत्तिषु।\nएकमालम्बमानानां निर्णये सर्वतो दिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2083086, "chapter_id": 2770, "verse_number": "१२-२७५-६२", "content_sanskrit": "आनन्त्यं वदमानेन शक्तेनावर्जितात्मना]।\nअविज्ञानहतप्रज्ञा हीनप्रज्ञास्तमोवृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2083087, "chapter_id": 2770, "verse_number": "१२-२७५-६३", "content_sanskrit": "शक्यं त्वेकेन युक्तेन कृतकृत्येन सर्वशः।\nपिण्डमात्रं व्यपाश्रित्य चरितुं सर्वतो दिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2083088, "chapter_id": 2770, "verse_number": "१२-२७५-६४", "content_sanskrit": "`नात्यन्तं वन्दमानेन शक्तेन विजितात्मना।\nवेदवादं व्यपाश्रित्य मोक्षोऽस्तीति प्रभापितुम्।\nअपेतन्यायशास्त्रेण सर्वलोकविगर्हिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2083089, "chapter_id": 2770, "verse_number": "१२-२७५-६५", "content_sanskrit": "इदं तु दुष्करं कर्म कुटुम्बमभिसंश्रितम्।\nदानमध्ययनं यज्ञः प्रजासंतानमार्जवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2083090, "chapter_id": 2770, "verse_number": "१२-२७५-६६", "content_sanskrit": "यद्येतदेवं कृत्वाऽपि न विमोक्षोऽस्ति कस्यचित्।\nधिक्कर्तारं च कार्यं च श्रमश्चायं निरर्थकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2083091, "chapter_id": 2770, "verse_number": "१२-२७५-६७", "content_sanskrit": "नास्तिक्यमन्यथा च स्याद्वेदानां पृष्ठतः क्रिया।\nएतस्यानन्त्यमिच्छामि भगवञ्श्रोतुमञ्जसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2083092, "chapter_id": 2770, "verse_number": "१२-२७५-६८", "content_sanskrit": "तत्त्वं वदस्व मे ब्रह्मन्नुपसन्नोस्म्यधीहि भोः।\nयथा ते विदितो मोक्षस्तथेच्छाम्युपशिक्षितुम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2083093, "chapter_id": 2770, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि पञ्चसप्तत्यधिकद्विशततमोऽध्यायः॥ २७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]