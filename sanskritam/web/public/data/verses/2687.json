[{"id": 2079220, "chapter_id": 2687, "verse_number": "१२-१९२-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2079221, "chapter_id": 2687, "verse_number": "१२-१९२-१", "content_sanskrit": "अध्यात्मं नाम यदिदं पुरुषस्येह चिन्त्यते।\nयदध्यात्मं यथा चैतत्तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2079222, "chapter_id": 2687, "verse_number": "१२-१९२-२", "content_sanskrit": "कुतः सृष्टमिदं सर्वं ब्रह्मन्स्थावरजङ्गमम्।\nप्रलये च कमभ्येति तन्मे वक्तुमिहार्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2079223, "chapter_id": 2687, "verse_number": "१२-१९२-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2079224, "chapter_id": 2687, "verse_number": "१२-१९२-३", "content_sanskrit": "अध्यात्ममिति मां पार्थ यदेतदनुपृच्छसि।\nतद्व्याख्यास्यामि ते तात श्रेयस्करतमं शुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2079225, "chapter_id": 2687, "verse_number": "१२-१९२-४", "content_sanskrit": "[सृष्टिप्रलयसंयुक्तमाचार्यैः परिदर्शितम्।]\nयज्ज्ञात्वा पुरुषो लेके प्रीतिं सौख्यं च विन्दति।\nफललाभश्च तस्य स्यात्सर्वभूतहितं च तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2079226, "chapter_id": 2687, "verse_number": "१२-१९२-५", "content_sanskrit": "`आत्मानममलं राजन्नावृत्यैवं व्यवस्थितम्।\nतस्मिन्प्रकाशते नित्यं तमः सोमो यथैव तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2079227, "chapter_id": 2687, "verse_number": "१२-१९२-६", "content_sanskrit": "तद्विद्वान्नष्टयाप्मैष ब्रह्मभूयाय कल्पते।\nअण्डावरणभूतानां पर्यन्तं हि यथा तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2079228, "chapter_id": 2687, "verse_number": "१२-१९२-७", "content_sanskrit": "पृथिवी वायुराकाशमापो ज्योतिश्च पञ्चमम्।\nमहाभूतानि भूतानां सर्वेषां प्रभवाप्ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2079229, "chapter_id": 2687, "verse_number": "१२-१९२-८", "content_sanskrit": "यतः सृष्टानि तत्रैव तानि यान्ति पुनःपुनः।\nमहाभूतानि भूतेभ्यः सागरस्योर्मयो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2079230, "chapter_id": 2687, "verse_number": "१२-१९२-९", "content_sanskrit": "प्रसार्य च यथाङ्गानि कूर्मः संहरते पुनः।\nतद्वद्भूतानि भूतात्मा सृष्ट्वा संहरते पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2079231, "chapter_id": 2687, "verse_number": "१२-१९२-१०", "content_sanskrit": "`स तेषां गुणसंघातः शरीरे भरतर्षभ।\nसततं प्रविलीयन्ते गुणास्ते प्रभवन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2079232, "chapter_id": 2687, "verse_number": "१२-१९२-११", "content_sanskrit": "यद्विना नैव शृणुते न पश्यति न दीप्यते।\nयदधीनं यतस्तस्मादध्यात्ममिति कथ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2079233, "chapter_id": 2687, "verse_number": "१२-१९२-१२", "content_sanskrit": "ज्ञानं तदेकरूपाख्यं नानाप्रज्ञान्वितं तदा।\nन तेवाचाऽनुरूपं स्याद्यया रासविवर्जितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2079234, "chapter_id": 2687, "verse_number": "१२-१९२-१३", "content_sanskrit": "आकाशात्खलु याज्येषु भवन्ति सुमहागुणाः।\nइति तन्मयमेवैतत्सर्वं स्थावरजङ्गमम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2079235, "chapter_id": 2687, "verse_number": "१२-१९२-१४", "content_sanskrit": "प्रलये च तमभ्येति तस्मादुत्सृज्यते पुनः।\nमहाभूतेषु भूतात्मा सृष्ट्वा संहरते पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2079236, "chapter_id": 2687, "verse_number": "१२-१९२-१५", "content_sanskrit": "महाभूतानि पञ्चैव सर्वभूतेषु भूतकृत्।\nअकरोत्तेषु वैषम्य तत्तु जीवो न पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2079237, "chapter_id": 2687, "verse_number": "१२-१९२-१६", "content_sanskrit": "शब्दः श्रोत्रं तथा खानि त्रयमाकाशसंभवम्।\nवायोः स्पर्शस्तथा चेष्टा त्वक्चैव त्रितयं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2079238, "chapter_id": 2687, "verse_number": "१२-१९२-१७", "content_sanskrit": "रूपं चक्षुस्तथा पाकस्त्रिविधं तेज उच्यते।\nरसः क्लेदश्च जिह्वा च त्रयो जलगुणाः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2079239, "chapter_id": 2687, "verse_number": "१२-१९२-१८", "content_sanskrit": "घ्रेयं घ्राणं शरीरं च एते भूमिगुणास्त्रयः।\nमहाभूतानि पञ्चैव षष्ठं च मन उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2079240, "chapter_id": 2687, "verse_number": "१२-१९२-१९", "content_sanskrit": "इन्द्रियाणि मनश्चैव विज्ञानान्यस्य भारत।\nसप्तमी बुद्धिरित्याहुः क्षेत्रज्ञः पुनरष्टमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2079241, "chapter_id": 2687, "verse_number": "१२-१९२-२०", "content_sanskrit": "चक्षुरालोचनायैव संशयं कुरुते मनः।\nबुद्धिरध्यवसानाय क्षेत्रज्ञः साक्षिवत्स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2079242, "chapter_id": 2687, "verse_number": "१२-१९२-२१", "content_sanskrit": "`चिच्छक्त्याधिष्ठिता बुद्धिश्चेतनेत्यभिविश्रुता।\nचेतनानन्तरो जीवस्तदा वेत्ति च लक्ष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2079243, "chapter_id": 2687, "verse_number": "१२-१९२-२२", "content_sanskrit": "नोत्सृजन्विसृजंश्चैव शरीरं दृश्यते तमः।\nतस्मिंश्चेतोपलब्धिः स्यात्तमो वा सारयन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2079244, "chapter_id": 2687, "verse_number": "१२-१९२-२३", "content_sanskrit": "ऊर्ध्वं पादतलाभ्यां यदर्वाक्चोर्ध्वं च पश्यति।\nएतेन सर्वमेवेदं बिद्ध्यभिव्याप्तमन्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2079245, "chapter_id": 2687, "verse_number": "१२-१९२-२४", "content_sanskrit": "पुरुषैरिन्द्रियाणीह विजेतव्यानि कृत्स्नशः।\nतमो रजश्च सत्वं च तेऽपि भावास्तदाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2079246, "chapter_id": 2687, "verse_number": "१२-१९२-२५", "content_sanskrit": "एतां बुद्ध्वा नरो बुद्ध्या भूतानामागतिं गतिम्।\nसमवेक्ष्य शनैश्चैव लभते शममुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2079247, "chapter_id": 2687, "verse_number": "१२-१९२-२६", "content_sanskrit": "गुणैर्नेनीयते बुद्धिर्बुद्धिरेवेन्द्रियाण्यपि।\nमनःषष्ठानि सर्वाणि बुद्ध्यभावे कुतो गुणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2079248, "chapter_id": 2687, "verse_number": "१२-१९२-२७", "content_sanskrit": "इति तन्मयमेवैतत्सर्वं स्थावरजङ्गमम्।\nप्रलीयते चोद्भवति तस्मान्निर्दिश्यते तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2079249, "chapter_id": 2687, "verse_number": "१२-१९२-२८", "content_sanskrit": "येन पश्यति तच्चक्षुः शृणोति श्रोत्रमुच्यते।\nजिघ्रति घ्राणमित्याहू रसं जानाति जिह्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2079250, "chapter_id": 2687, "verse_number": "१२-१९२-२९", "content_sanskrit": "त्वचा स्पर्शयते स्पर्शं बुद्धिर्विक्रियतेऽसकृत्।\nयेन संकल्पयत्यर्थं किंचिद्भवति तन्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2079251, "chapter_id": 2687, "verse_number": "१२-१९२-३०", "content_sanskrit": "अधिष्ठानानि बुद्धेर्हि पृथगर्थानि पञ्चधा।\nपञ्चेन्द्रियाणि यान्याहुस्तान्यदृश्योऽधितिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2079252, "chapter_id": 2687, "verse_number": "१२-१९२-३१", "content_sanskrit": "पुरुषाधिष्ठिता बुद्धिस्त्रिषु भावेषु वर्तते।\nकदाचिल्लभते प्रीतिं कदाचिदनुशोचति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2079253, "chapter_id": 2687, "verse_number": "१२-१९२-३२", "content_sanskrit": "न सुखेन न दुःखेन कदाचिदपि वर्तते।\nएवं नराणां मनसि त्रिषु भावेष्ववस्थिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2079254, "chapter_id": 2687, "verse_number": "१२-१९२-३३", "content_sanskrit": "सेयं भावात्मिका भावांस्त्रीनेतानतिवर्तते।\nसरितां सागरो भर्ता महावेलामिवोर्मिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2079255, "chapter_id": 2687, "verse_number": "१२-१९२-३४", "content_sanskrit": "अविभागगता बुद्धिर्भावे मनसि वर्तते।\nप्रवर्तमानं तु रजस्तद्भावमनुवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2079256, "chapter_id": 2687, "verse_number": "१२-१९२-३५", "content_sanskrit": "इन्द्रियाणि हि सर्वाणि प्रवर्तयति सा तदा।\nततः सत्वं तमो भावः प्रातियोगात्प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2079257, "chapter_id": 2687, "verse_number": "१२-१९२-३६", "content_sanskrit": "प्रीतिः सत्वं रजः शोकस्तमो मोहस्तु ते त्रयः।\nयेये च भावा लोकेऽस्मिन्सर्वेष्वेतेषु वै त्रिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2079258, "chapter_id": 2687, "verse_number": "१२-१९२-३७", "content_sanskrit": "इति बुद्धिगतिः सर्वा व्याख्याता तव भारत।\nइन्द्रियाणि च सर्वाणि विजेतव्यानि धीमता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2079259, "chapter_id": 2687, "verse_number": "१२-१९२-३८", "content_sanskrit": "सत्वं रजस्तमश्चैव प्राणिनां संश्रिताः सदा।\nत्रिविधा वेदना चैव सर्वसत्वेषु दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2079260, "chapter_id": 2687, "verse_number": "१२-१९२-३९", "content_sanskrit": "सात्विकी राजसी चैव तामसी चेति भारत।\nसुखस्पर्शः सत्त्वगुणो दुःखस्पर्शो रजोगुणः।\nतमोगुणेन संयुक्तौ भवतो व्यावहारिकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2079261, "chapter_id": 2687, "verse_number": "१२-१९२-४०", "content_sanskrit": "तत्र यत्प्रीतिसंयुक्तं काये मनसि वा भवेत्।\nवर्तते सात्विको भाव इत्युपेक्षेत तत्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2079262, "chapter_id": 2687, "verse_number": "१२-१९२-४१", "content_sanskrit": "अथ यद्दुःखसंयुक्तमप्रीतिकरमात्मनः।\nप्रवृत्तं रज इत्येव तन्न संरभ्य चिन्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2079263, "chapter_id": 2687, "verse_number": "१२-१९२-४२", "content_sanskrit": "अथ यन्मोहसंयुक्तमव्यक्तविषयं भवेत्।\nअप्रतर्क्यमविज्ञेयं तमस्तदुपधारयेत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2079264, "chapter_id": 2687, "verse_number": "१२-१९२-४३", "content_sanskrit": "प्रहर्षः प्रीतिरानन्दः सुखं संशान्तचित्तता।\nकथंचिदभिवर्तन्त इत्येते सात्विका गुणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2079265, "chapter_id": 2687, "verse_number": "१२-१९२-४४", "content_sanskrit": "अतुष्टिः परितापश्च शोको लोभस्तथाऽक्षमा।\nलिङ्गानि रजसस्तानि दृश्यन्ते हेत्वहेतुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2079266, "chapter_id": 2687, "verse_number": "१२-१९२-४५", "content_sanskrit": "अभिमानस्तथा मोहः प्रमादः स्वप्नतन्द्रिता।\nकथंचिदभिवर्तन्ते विविधास्तामसा गुणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2079267, "chapter_id": 2687, "verse_number": "१२-१९२-४६", "content_sanskrit": "दूरगं बहुधागामि प्रार्थनासंशयात्मकम्।\nमनः सुनियतं यस्य स सुखी प्रेत्य चेह च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2079268, "chapter_id": 2687, "verse_number": "१२-१९२-४७", "content_sanskrit": "सत्वक्षेत्रज्ञयोरेतदन्तरं पश्य सूक्ष्मयोः।\nसृजते तु गुणानेक एको न सृजते गुणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2079269, "chapter_id": 2687, "verse_number": "१२-१९२-४८", "content_sanskrit": "मशकोदुम्बरौ वाऽपि संप्रयुक्तौ यथा सदा।\nअन्योन्यमेतौ स्यातां च संप्रयोगस्तथा तयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2079270, "chapter_id": 2687, "verse_number": "१२-१९२-४९", "content_sanskrit": "पृथग्भूतौ प्रकृत्या तौ संप्रयुक्तौ च सर्वदा।\nयथा मत्स्यो जलं चैव संप्रयुक्तौ तथैव तौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2079271, "chapter_id": 2687, "verse_number": "१२-१९२-५०", "content_sanskrit": "न गुणा विदुरात्मानं स गुणान्वेति सर्वशः।\nपरिद्रष्टा गुणानां स संसृष्टान्मन्यते तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2079272, "chapter_id": 2687, "verse_number": "१२-१९२-५१", "content_sanskrit": "इन्द्रियैस्तु प्रदीपार्थं कुरुते बुद्धिसप्तमैः।\nनिर्विचेष्टैरजानद्भिः परमात्मा प्रदीपवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2079273, "chapter_id": 2687, "verse_number": "१२-१९२-५२", "content_sanskrit": "सृजते हि गुणान्सत्वं क्षेत्रज्ञः परिपश्यति।\nसंप्रयोगस्तयोरेष सत्वक्षेत्रज्ञयोर्ध्रुवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2079274, "chapter_id": 2687, "verse_number": "१२-१९२-५३", "content_sanskrit": "आश्रयो नास्ति सत्वस्य क्षेत्रज्ञस्य च कश्चन।\nसत्वं मनः संसृजते न गुणान्वै कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2079275, "chapter_id": 2687, "verse_number": "१२-१९२-५४", "content_sanskrit": "रश्मीस्तेषां स मनसा यदा सम्यङ्गियच्छति।\nतदा प्रकाशतेऽस्यात्मा घटे दीपो ज्वलन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2079276, "chapter_id": 2687, "verse_number": "१२-१९२-५५", "content_sanskrit": "त्यक्त्वा यः प्राकृतं कर्म नित्यमात्मरतिर्मुनिः।\nसर्वभूतात्मभूस्तस्मात्स गच्छेदुत्तमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2079277, "chapter_id": 2687, "verse_number": "१२-१९२-५६", "content_sanskrit": "यथा वारिचरः पक्षी सलिलेन न लिप्यते।\nएवमेव कृतप्रज्ञो भूतेषु परिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2079278, "chapter_id": 2687, "verse_number": "१२-१९२-५७", "content_sanskrit": "एवं स्वभावमेवैतत्स्वबुद्ध्या विहरेन्नरः।\nअशोचन्नप्रहृष्यंश्च चरेद्विगतमत्सरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2079279, "chapter_id": 2687, "verse_number": "१२-१९२-५८", "content_sanskrit": "स्वभावसिद्ध्या युक्तस्तु स नित्यं सृजत गुणान्।\nऊर्णनाभिर्यथा सूत्रं विज्ञेयास्तन्तुवद्गुणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2079280, "chapter_id": 2687, "verse_number": "१२-१९२-५९", "content_sanskrit": "प्रध्वस्ता न निवर्न्तते निवृत्तिर्नोपलभ्यते।\nप्रत्यक्षेण परोक्षं तदनुमानेन सिध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2079281, "chapter_id": 2687, "verse_number": "१२-१९२-६०", "content_sanskrit": "एवमेकेऽध्यवस्यन्ति निवृत्तिरिति चापरे।\nउभयं संप्रधार्यैतद्व्यवस्येत यथामति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2079282, "chapter_id": 2687, "verse_number": "१२-१९२-६१", "content_sanskrit": "इतीमं हृदयग्रत्थिं बुद्धिभेदमयं दृढम्।\nविमुच्य सुखमासीत न शोचेच्छिन्नसंशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2079283, "chapter_id": 2687, "verse_number": "१२-१९२-६२", "content_sanskrit": "मलिनाः प्राप्नुयुः शुद्धिं यथा पूर्णां नदीं नराः।\nअवगाह्य सुविद्वांसो विद्धि ज्ञानमिदं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2079284, "chapter_id": 2687, "verse_number": "१२-१९२-६३", "content_sanskrit": "महानद्या हि पारज्ञस्तप्यते न तदन्यथा।\nन तु तप्यति तत्त्वज्ञः फले ज्ञाते तरत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2079285, "chapter_id": 2687, "verse_number": "१२-१९२-६४", "content_sanskrit": "एवं ये विदुराध्यात्मं केवलं ज्ञानमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2079286, "chapter_id": 2687, "verse_number": "१२-१९२-६५", "content_sanskrit": "एतां बुद्धा नरः सर्वां भूतानामागतिं गतिम्।\nअवेक्ष्य च शनैर्बुद्ध्या लभते शममुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2079287, "chapter_id": 2687, "verse_number": "१२-१९२-६६", "content_sanskrit": "त्रिवर्गो यस्य विदितः प्रेक्ष्य तं स विमुच्यते।\nअन्वीक्ष्य मनसा युक्तस्तत्त्वदर्शी निरुत्सुकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2079288, "chapter_id": 2687, "verse_number": "१२-१९२-६७", "content_sanskrit": "न चात्मा शक्यते द्रष्टुमिन्द्रियेषु विभागशः।\nतत्रतत्र विसृष्टेषु दुर्वार्येष्वकृतात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2079289, "chapter_id": 2687, "verse_number": "१२-१९२-६८", "content_sanskrit": "एतद्बुद्धा भवेद्बुद्धः किमन्यद्बुद्धिलक्षणम्।\nप्रतिगृह्य च निह्नोति ह्यन्यथा च प्रदृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2079290, "chapter_id": 2687, "verse_number": "१२-१९२-६९", "content_sanskrit": "न सर्पति च यं प्राहुः सर्वत्र प्रतिहन्यते।\nधूमेन चाप्रसन्नोऽग्निर्यथाऽर्कं न प्रवर्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2079291, "chapter_id": 2687, "verse_number": "१२-१९२-७०", "content_sanskrit": "धिष्ण्याधिपे प्रसन्ने तु स्थितिमेतां निरीक्षते।\nअतिक्षूराच्च सूक्ष्मत्वात्प्रस्थानं न प्रकाशते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2079292, "chapter_id": 2687, "verse_number": "१२-१९२-७१", "content_sanskrit": "प्रपद्य तच्छ्रुताह्नानि चिन्मयं स्वीकृतं विना।\nविज्ञाय तद्धि मन्यन्ते कृतकृत्या मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2079293, "chapter_id": 2687, "verse_number": "१२-१९२-७२", "content_sanskrit": "न भवति विदुषां ततो भयं\nयदविदुषां सुमहद्भयं भवेत्।\nन हि गतिरधिकास्ति कस्यचि\nत्सति हि गुणे प्रवदन्त्यतुल्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2079294, "chapter_id": 2687, "verse_number": "१२-१९२-७३", "content_sanskrit": "यः करोत्यनभिसन्धिपूर्वकं\nतच्च निर्णुदति यत्पुरा कृतम्।\nनाप्रियं तदुभयं कुतः प्रियं\nतस्य तज्जनयतीह सर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2079295, "chapter_id": 2687, "verse_number": "१२-१९२-७४", "content_sanskrit": "लोकमातुरमसूयते जन\nस्तस्य तज्जनयतीह सर्वतः।\nलोक आतुरजनान्विराविण\nस्तत्तदेव बहु पश्य शोचतः।\nतत्र पश्य कुशलानशोचतो", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2079296, "chapter_id": 2687, "verse_number": "", "content_sanskrit": "१२-१९२-७४f\"\nये विदुस्तदुभयं पदं सताम्॥ ॥\nइति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि द्विनवत्यधिकशततमोऽध्यायः॥ १९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]