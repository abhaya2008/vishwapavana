[{"id": 2100937, "chapter_id": 3167, "verse_number": "१४-२३-१", "content_sanskrit": "ब्राह्मण उवाच।\nअत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nसुभगे सप्तहोतॄणां विधानमिह यादृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2100938, "chapter_id": 3167, "verse_number": "१४-२३-२", "content_sanskrit": "घ्राणश्चक्षुश्च जिह्वा च त्वक् श्रोत्रं चैव पञ्चमम्।\nमनो बुद्धिश्च सप्तैते होतारः पृथगाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2100939, "chapter_id": 3167, "verse_number": "१४-२३-३", "content_sanskrit": "सूक्ष्माकाशे समं प्राप्ते न पश्यन्तीतरेतरम्।\nएतद्वै सप्तहोतृत्वं स्वभावाद्विद्धि शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2100940, "chapter_id": 3167, "verse_number": "१४-२३-४x", "content_sanskrit": "ब्राह्मण्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2100941, "chapter_id": 3167, "verse_number": "१४-२३-४", "content_sanskrit": "सूक्ष्मे तु काशे सम्प्राप्ते कथं नान्योन्यदर्शिनः।\nकथं स्वभावाद्भगवन्नेतदाचक्ष्व मे प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2100942, "chapter_id": 3167, "verse_number": "१४-२३-५x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2100943, "chapter_id": 3167, "verse_number": "१४-२३-५", "content_sanskrit": "गुणज्ञानेषु विज्ञानं गुणज्ञानामभिज्ञता।\nपरस्परं गुणानेते नाभिजानन्ति कर्हिचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2100944, "chapter_id": 3167, "verse_number": "१४-२३-६", "content_sanskrit": "जिह्वा चक्षुस्तथा श्रोत्रं त्वङ्मनो बुद्धिरेव च।\nन गन्धानधिगच्छन्ति घ्राणस्तानधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2100945, "chapter_id": 3167, "verse_number": "१४-२३-७", "content_sanskrit": "घ्राणं चक्षुस्तथा क्षोत्रं त्वङ्मनो बुद्धिरेव च।\nन रसानधिगच्छन्ति जिह्वा तानधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2100946, "chapter_id": 3167, "verse_number": "१४-२३-८", "content_sanskrit": "घ्राणं जिह्वा तथा श्रोत्रं त्वङ्मनो बुद्धिरेव च।\nन रूपाण्यधिगच्छन्ति चक्षुस्तान्यधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2100947, "chapter_id": 3167, "verse_number": "१४-२३-९", "content_sanskrit": "घ्राणं जिह्वा ततश्चक्षुः श्रोत्रं बुद्धिर्मनस्तथा।\nन स्पर्शानधिगच्छन्ति त्वक्च तानधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2100948, "chapter_id": 3167, "verse_number": "१४-२३-१०", "content_sanskrit": "घ्राणं जिह्वा च चक्षुश्च त्वङ्मनो बुद्धिरेव च।\nन शब्दानधिगच्छन्ति श्रोत्रं तानधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2100949, "chapter_id": 3167, "verse_number": "१४-२३-११", "content_sanskrit": "घ्राणं जिह्वा च चक्षुश्च त्वक् श्रोत्रं बुद्धिरेव च।\nसङ्कल्पान्नाधिगच्छन्ति मनस्तानधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2100950, "chapter_id": 3167, "verse_number": "१४-२३-१२", "content_sanskrit": "घ्राणं जिह्वा च चक्षुश्च त्वक् श्रोत्रं मन एव च।\nन निष्ठामधिगच्छन्ति बुद्धिस्तामधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2100951, "chapter_id": 3167, "verse_number": "१४-२३-१३", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nइन्द्रियाणां च संवादं मनसश्चैव भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2100952, "chapter_id": 3167, "verse_number": "१४-२३-१४x", "content_sanskrit": "मन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2100953, "chapter_id": 3167, "verse_number": "१४-२३-१४", "content_sanskrit": "नाघ्राति मामृते घ्राणं रसं जिह्वा न वेत्ति च।\nरूपं चक्षुर्न गृह्णाति त्वक् स्पर्सं नावबुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2100954, "chapter_id": 3167, "verse_number": "१४-२३-१५", "content_sanskrit": "न श्रोत्रं बुध्यते शब्दं मया हीनं कथञ्चन।\nप्रवरं सर्वबूतानामहमस्मि सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2100955, "chapter_id": 3167, "verse_number": "१४-२३-१६", "content_sanskrit": "अगाराणीव शून्यानि शान्तार्चिष इवाग्नयः।\nइन्द्रियाणि न भासन्ते मया हीनानि नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2100956, "chapter_id": 3167, "verse_number": "१४-२३-१७", "content_sanskrit": "काष्ठानीवार्द्रशुष्काणि यतमानैरपीन्द्रियैः।\nगुणार्थान्नाधिगच्छन्ति मामृते सर्वजन्तवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2100957, "chapter_id": 3167, "verse_number": "१४-२३-१८x", "content_sanskrit": "इन्द्रियाण्यूचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2100958, "chapter_id": 3167, "verse_number": "१४-२३-१८", "content_sanskrit": "एवमेतद्भवेत्सत्यं यथैतन्मन्यते भवान्।\nऋतेऽस्मानस्मदर्थांस्त्वं भोगान्भुङ्क्ते भवान्यदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2100959, "chapter_id": 3167, "verse_number": "१४-२३-१९", "content_sanskrit": "यद्यस्मासु प्रलीनेषु तप्रणं प्राणधारणम्।\nभोगान्भुङ्क्ते भवान्सत्यं यथैतन्मन्यते तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2100960, "chapter_id": 3167, "verse_number": "१४-२३-२०", "content_sanskrit": "अथवाऽस्मासु लीनेषु तिष्ठत्सु विषयेषु च।\nयदि सङ्कल्पमात्रेण भुङ्क्ते भोगान्यथार्थवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2100961, "chapter_id": 3167, "verse_number": "१४-२३-२१", "content_sanskrit": "अथ चेन्मन्यसे सिद्धिमस्मदर्थेषु नित्यदा।\nघ्राणेन रूपमादत्स्व रसमादत्स्व चक्षुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2100962, "chapter_id": 3167, "verse_number": "१४-२३-२२", "content_sanskrit": "श्रोत्रेण गन्धानादत्स्व स्पर्शानादत्स्व जिह्वया।\nत्वचा च शब्दमादत्स्व बुद्ध्या स्पर्शमथापि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2100963, "chapter_id": 3167, "verse_number": "१४-२३-२३", "content_sanskrit": "बलवन्तो ह्यनियमा नियमा दुर्बलीयसाम्।\nभोगानपूर्वानादत्स्व नोच्छिष्टं भोक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2100964, "chapter_id": 3167, "verse_number": "१४-२३-२४", "content_sanskrit": "यथा हि शिष्यः शास्तारं श्रुत्यर्थमभिधावति।\nततः श्रुतमुपादाय श्रुतार्थमुपतिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2100965, "chapter_id": 3167, "verse_number": "१४-२३-२५", "content_sanskrit": "विषयानेवमस्माभिर्दर्शितानभिमन्यसे।\nअनुभूतानतीतांश्च स्वप्ने जागरणे तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2100966, "chapter_id": 3167, "verse_number": "१४-२३-२६", "content_sanskrit": "वैमनस्यं गतानां च जन्तूनामल्पचेतसाम्।\nअस्मदर्थे कृते दृश्यते प्राणधारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2100967, "chapter_id": 3167, "verse_number": "१४-२३-२७", "content_sanskrit": "बहूनपि हि सङ्कल्पान्मत्वा स्वप्नानुपास्य च।\nबुभुक्षया पीड्यमानो विषयानेन धावति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2100968, "chapter_id": 3167, "verse_number": "१४-२३-२८", "content_sanskrit": "अगारमद्वारमिव प्रविश्य\nसङ्कल्पभोगान्विषयानविन्दन्।\nप्राणक्षये शान्तिमुपैति नित्यं\nदारुक्षयेऽग्निर्ज्वलितो यथैव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2100969, "chapter_id": 3167, "verse_number": "१४-२३-२९", "content_sanskrit": "कामं तु नष्टेषु गुणेषु सङ्गः\nकामं च नान्योन्यगुणोपलब्धिः।\nअस्मान्विना नास्ति तपोपलब्धि-\nस्तामप्यृते त्वां न भजेत्प्रहर्षः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2100970, "chapter_id": 3167, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि त्रयोविंशोऽध्यायः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]