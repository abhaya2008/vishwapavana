[{"id": 2034918, "chapter_id": 1753, "verse_number": "४-७६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2034919, "chapter_id": 1753, "verse_number": "४-७६-१", "content_sanskrit": "विराटस्य वचः श्रुत्वा पार्थिवस्य महात्मनः।\nउत्तरः प्रत्युवाचेदमभिपन्नो युधिष्ठिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2034920, "chapter_id": 1753, "verse_number": "४-७६-२", "content_sanskrit": "प्रसादनं प्राप्तकालं पाण्डवस्याभिरोचये।\nतेजस्वी बलवाञ्शूरो राजराजेश्वरः प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2034921, "chapter_id": 1753, "verse_number": "४-७६-३", "content_sanskrit": "उत्तरां च स्वसारं मे पार्थस्यामित्रकर्शन।\nप्रणिपत्य प्रयच्छामस्ततः शिष्टा भवामहे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2034922, "chapter_id": 1753, "verse_number": "४-७६-४", "content_sanskrit": "वयं च सर्वे सामात्याः कुन्तीपुत्रं युधिष्ठिरम् ।\nप्रसाद्याभ्युपतिष्ठामो राजन्किं करवागहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2034923, "chapter_id": 1753, "verse_number": "४-७६-५", "content_sanskrit": "राजंस्त्वमसि संग्रामे गृहीतस्तेन मोक्षितः ।\nएतेषां बाहुवीर्येण गावश्च विजितास्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2034924, "chapter_id": 1753, "verse_number": "४-७६-६", "content_sanskrit": "कुरवो निर्जिता यस्मात्संग्रामेऽमिततेजसः ।\nएष तत्सर्वमकरोत्कुन्तीपुत्रो युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2034925, "chapter_id": 1753, "verse_number": "४-७६-७", "content_sanskrit": "अर्च्याः पूज्याश्च मान्याश्च प्रत्युत्थेयाश्च पाण्डवाः।\nअर्वार्हाश्चाभिवाद्याश्च प्राप्तकालं च मे मतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2034926, "chapter_id": 1753, "verse_number": "४-७६-८", "content_sanskrit": "पूज्यतां पूजनीयाश्च महाभागाश्च पाण्डवाः।\nन ह्येते कुपिता शेषं कुर्युराशीविषोपमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2034927, "chapter_id": 1753, "verse_number": "४-७६-९", "content_sanskrit": "तस्माच्छीघ्रं प्रपद्येम कुन्तीपुत्रं युधिष्ठिरम् ।\nप्रसादयाम्यहं तत्र सह पार्थेर्महात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2034928, "chapter_id": 1753, "verse_number": "४-७६-१०", "content_sanskrit": "उत्तरामग्रतः कृत्वा शिरःस्नातां कृताञ्जलिः ।\nजानाम्यहमिदं सर्वमेषां तु बलपौरुषम् ।\nकुले च जन्म महति फल्गुनस्य च विक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2034929, "chapter_id": 1753, "verse_number": "४-७५-११x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2034930, "chapter_id": 1753, "verse_number": "४-७६-११", "content_sanskrit": "उत्तरात्पाण्डवाञ्श्रुत्वा विराटो रिपुसूदनः।\nउत्तरं चापि संप्रेक्ष्य प्राप्तकालमचिन्तयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2034931, "chapter_id": 1753, "verse_number": "४-७६-१२", "content_sanskrit": "ततो विराटः सामात्यः सहपुत्रः सबान्धवः।\nउत्तरामग्रतः कृत्वा शिरःस्नातां कृताञ्जलिः।\nभूमौ निपतितस्तूर्णं पाण्डवस्य समीपतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2034932, "chapter_id": 1753, "verse_number": "४-७६-१३x", "content_sanskrit": "विराट उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2034933, "chapter_id": 1753, "verse_number": "४-७६-१३", "content_sanskrit": "प्रसीदतु महाराजो धर्मपुत्रो युधिष्ठिरः।\nप्रच्छन्नरूपवेषत्वान्नाग्निर्दृष्टस्तृणैर्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2034934, "chapter_id": 1753, "verse_number": "४-७६-१४", "content_sanskrit": "शिरसाऽभिप्रपन्नोस्मि सपुत्रपरिचारकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2034935, "chapter_id": 1753, "verse_number": "४-७६-१५", "content_sanskrit": "यदस्माभिरजानद्भिरधिक्षिप्तो महीपतिः ।\nअवमत्य कृतं सर्वमज्ञानात्प्राकृते यथा।\nक्षन्तुमर्हसि तत्सर्वं धर्मज्ञो धर्मवत्सल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2034936, "chapter_id": 1753, "verse_number": "४-७६-१६", "content_sanskrit": "यदिदं मामकं राष्ट्रं पुरं राज्यं च पार्थिव ।\nसदण्डकोशं विसृजे तव वश्योस्मि पार्थिव ।\nवयं च सर्वे सामात्या भवन्तं शरणं गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2034937, "chapter_id": 1753, "verse_number": "४-७६-१७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2034938, "chapter_id": 1753, "verse_number": "४-७६-१७", "content_sanskrit": "तं धर्मराजः पतितं महीतले\nसबन्धुवर्गं प्रसमीक्ष्य पार्थिवम् ।\nउवाच वाक्यं परलोकदर्शनः\nप्रनष्टमन्युर्गतशोकमत्सरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2034939, "chapter_id": 1753, "verse_number": "४-७६-१८", "content_sanskrit": "न मे भयं पार्थिव विद्यते मयि\nप्रतीतरूपोस्म्यनुचिन्त्य मानसम्।\nएतत्त्वया सम्यगिहोपपादितं\nद्विजैरमात्यैः सदृशैश्च पाण्डितैः ।\nइमां च कन्यां समलंकृतां भृशं\nसमीक्ष्य तुष्टोस्मि नरेन्द्रसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2034940, "chapter_id": 1753, "verse_number": "४-७६-१९", "content_sanskrit": "क्षान्तमेतन्महाबाहो यन्मां वदसि पार्थिव।\nन चैव किंचित्पश्यामि विकृतं ते नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2034941, "chapter_id": 1753, "verse_number": "४-७६-२०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2034942, "chapter_id": 1753, "verse_number": "४-७६-२०", "content_sanskrit": "ततो विराटः परमामितुष्टः\nसमेत्य राज्ञा समयं चकार।\nराज्यं च सर्वं विससर्ज तस्मै\nसदण्डकोशं सपुरं महात्मा ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2034943, "chapter_id": 1753, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि वैवाहिकपर्वणि षट्सप्ततितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]