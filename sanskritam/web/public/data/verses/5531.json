[{"id": 2212626, "chapter_id": 5531, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2212627, "chapter_id": 5531, "verse_number": "१", "content_sanskrit": "स्पृश मां पाणिना भूयः परिष्वज च पाण्डव ।\nजीवामीव हि संस्पर्शात् तव राजीवलोचन\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2212628, "chapter_id": 5531, "verse_number": "२", "content_sanskrit": "मूर्धानं च तवाघ्रातुमिच्छामि मनुजाधिप ।\nपाणिभ्यां च परिस्प्रष्टुं प्राणेन मम चात्मनि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2212629, "chapter_id": 5531, "verse_number": "३", "content_sanskrit": "अष्टमो ह्यद्य कालोऽयमाहारस्य कृतस्य मे ।\nयेनाहं कुरुशार्दूल न शक्नोमि विचेष्टितुम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2212630, "chapter_id": 5531, "verse_number": "४", "content_sanskrit": "व्यायामश्चायमत्यन्तं कृतस्त्वामभियाचता ।\nततो ग्लानमना राजन् नष्टसञ्ज्ञ इवाभवम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2212631, "chapter_id": 5531, "verse_number": "५", "content_sanskrit": "तवामृतसुखस्पर्शं हस्तस्पर्शमिमं प्रभो ।\nलब्ध्वा सञ्जीवितोऽस्मीति मन्ये कुरुकुलोद्वह\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2212632, "chapter_id": 5531, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2212633, "chapter_id": 5531, "verse_number": "६", "content_sanskrit": "एवमुक्तस्तु कौन्तेयः पित्रा ज्येष्ठेन भारत ।\nपस्पर्श सर्वगात्रेषु स्नेहार्द्रं तं शनैस्तथा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2212634, "chapter_id": 5531, "verse_number": "७", "content_sanskrit": "उपलभ्य ततः प्राणान् धृतराष्ट्रो महीपतिः ।\nबाहुभ्यां सम्परिष्वज्य मूर्ध्नि चाघ्राय पाण्डवम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2212635, "chapter_id": 5531, "verse_number": "८", "content_sanskrit": "विदुरादयश्च ते सर्वे रुरुदुर्दुःखिता भृशम् ।\nअतिदुःखात्तु राजानं नोचुः किञ्चन पाण्डवाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2212636, "chapter_id": 5531, "verse_number": "९", "content_sanskrit": "गान्धारी त्वेव धर्मज्ञा मनसोद्वहती तदा ।\nदुःखान्यवारयद् राजन् मैवमित्येव चाब्रवीत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2212637, "chapter_id": 5531, "verse_number": "१०", "content_sanskrit": "इतरास्तु स्त्रियः सर्वाः कुन्त्या सह सुदुःखिताः ।\nनेत्रैस्ताः सास्रविक्लेदैः परिवार्य स्थिता भवन्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2212638, "chapter_id": 5531, "verse_number": "११", "content_sanskrit": "तदाऽब्रवीत् पुनर्वाक्यं धृतराष्ट्रो युधिष्ठिरम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2212639, "chapter_id": 5531, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2212640, "chapter_id": 5531, "verse_number": "१२", "content_sanskrit": "अनुजानीहि मां राजन् तपसे भरतर्षभ\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2212641, "chapter_id": 5531, "verse_number": "१३", "content_sanskrit": "ग्लायते मे मनस्तात भूयो भूयः प्रजल्पतः ।\nन मामितः परं पुत्र परिक्लेष्टुमिहार्हसि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2212642, "chapter_id": 5531, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2212643, "chapter_id": 5531, "verse_number": "१४", "content_sanskrit": "तस्मिंस्तु कौरवश्रेष्ठे तथा ब्रुवति पाण्डवम् ।\nसर्वेषामवरोधानाम् आर्तनादो महानभूत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2212644, "chapter_id": 5531, "verse_number": "१५", "content_sanskrit": "दृष्ट्वा कृशं विवर्णं च राजानमतथोचितम् ।\nसर्वेषामवरोधानाम् आर्तनादो महानभूत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2212645, "chapter_id": 5531, "verse_number": "१६", "content_sanskrit": "उपवासपरिक्लान्तं त्वगस्थिपरिवारितम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2212646, "chapter_id": 5531, "verse_number": "१७", "content_sanskrit": "धर्मपुत्रः स्वपितरं परिष्वज्य महाभुजः ।\nशोकजं बाष्पमुत्सृज्य पुनर्वचनमब्रवीत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2212647, "chapter_id": 5531, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2212648, "chapter_id": 5531, "verse_number": "१८", "content_sanskrit": "न कामये नरश्रेष्ठ जीवितं पृथिवीं तथा ।\nयथा तव प्रियं राजन् चिकीर्षामि प्रयत्नतः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2212649, "chapter_id": 5531, "verse_number": "१९", "content_sanskrit": "यदि त्वहमनुग्राह्यो भवतो दयितोऽपि वा ।\nक्रियतां तावदाहारस्ततो वेत्स्यामहे परम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2212650, "chapter_id": 5531, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2212651, "chapter_id": 5531, "verse_number": "२०", "content_sanskrit": "ततोऽब्रवीन्महाराजो धर्मराजं स कौरवः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2212652, "chapter_id": 5531, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2212653, "chapter_id": 5531, "verse_number": "२१", "content_sanskrit": "अनुज्ञातस्त्वया पुत्र भुञ्जीयेति मतिर्मम\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2212654, "chapter_id": 5531, "verse_number": "", "content_sanskrit": "वेशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2212655, "chapter_id": 5531, "verse_number": "समाप्तिः", "content_sanskrit": "इति ब्रुवति राजेन्द्रे धृतराष्ट्रे युधिष्ठिरम् ।\nऋषिः सत्यवतीपुत्रे व्यासोऽभ्येत्य वचोऽब्रवीत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2212656, "chapter_id": 5531, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्रमवासिकपर्वणि व्यासागमनं नाम सप्तमोऽध्यायः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2212657, "chapter_id": 5531, "verse_number": "", "content_sanskrit": "आश्रमवासपर्वणि सप्तमोऽध्यायः ॥७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]