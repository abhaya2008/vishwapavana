[{"id": 7003660000, "chapter_id": 23660, "verse_number": "१-२-४७-१", "content_sanskrit": "नारद उवाच ।\nततो मयास्य तीर्थस्य रक्षणाय पुनर्जय ।\nसमाराध्य यथा देव्यः स्थापितास्तच्छृणुष्व भोः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003660001, "chapter_id": 23660, "verse_number": "१-२-४७-२", "content_sanskrit": "यथात्मा सर्वभूतेषु व्यापकः परमेश्वरः ।\nतथैव प्रकृतिर्नित्या व्यापका परमेश्वरी ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003660002, "chapter_id": 23660, "verse_number": "१-२-४७-३", "content_sanskrit": "शक्ति प्रसादादाप्नोति वीर्यं सर्वाश्च संपदः ।\nईश्वरी सर्वभूतेषु सा चैवं पार्थ संस्थिता ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003660003, "chapter_id": 23660, "verse_number": "१-२-४७-४", "content_sanskrit": "बुद्धिह्रीपुष्टिलज्जेति तुष्टिः शांतिः क्षमा स्पृहा ।\nश्रद्धा च चेतना शक्तिर्मंत्रोत्साहप्रभूद्भवा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003660004, "chapter_id": 23660, "verse_number": "१-२-४७-५", "content_sanskrit": "इयमेव च बंधाय मोक्षायेयं च सर्वदा ।\nएनामाराध्य चैश्वर्यमिन्द्राद्याः समवाप्नुयुः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003660005, "chapter_id": 23660, "verse_number": "१-२-४७-६", "content_sanskrit": "ये च शक्तिं न मन्यंते तिरस्कुर्वंति चाधमाः ।\nयोगीन्द्रा अपि ते व्यक्तं भ्रश्यंते काशिजा यथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003660006, "chapter_id": 23660, "verse_number": "१-२-४७-७", "content_sanskrit": "वाराणस्यां किल पुरा सिद्धयोगीश्वराः पुनः ।\nअवमन्य च ते शक्तिं पुनर्भ्रंशमुपागताः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003660007, "chapter_id": 23660, "verse_number": "१-२-४७-८", "content_sanskrit": "तस्मात्सदा देहिनेयं शक्तिः पूज्यैव नित्यदा ।\nतुष्टा ददाति सा कामान्रुष्टा संहरते क्षणात् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003660008, "chapter_id": 23660, "verse_number": "१-२-४७-९", "content_sanskrit": "परमा प्रकृतिः सा च बहुभेदैर्व्यवस्थिता ।\nतासां मध्ये महादेव्यो ह्यत्र संस्थापिताः शृणु ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003660009, "chapter_id": 23660, "verse_number": "१-२-४७-१०", "content_sanskrit": "चतस्रस्तु महाशक्त्यश्चतुर्दिक्षु व्यवस्थिताः ।\nसिद्धांबिका तु पूर्वस्यां स्थापिता सा गुहेन च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003660010, "chapter_id": 23660, "verse_number": "१-२-४७-११", "content_sanskrit": "जगदादौ मूलूप्रकृतेरुत्पन्ना सा प्रकीर्त्यते ।\nआराधिता यतः सिद्धैस्तस्मात्सिद्धांबिका च सा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003660011, "chapter_id": 23660, "verse_number": "१-२-४७-१२", "content_sanskrit": "दक्षिणस्यां तथा तारा संस्थिता स्थापिता मया ।\nतारणार्थाय देवानां यस्मात्कूर्मं समाश्रिता ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003660012, "chapter_id": 23660, "verse_number": "१-२-४७-१३", "content_sanskrit": "ययाविष्टः समुज्जह्रे वेदान्कूर्मो जगद्गुरुः ।\nअनयाविष्टदेहश्च बुधो बौद्धान्हनिष्यति ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003660013, "chapter_id": 23660, "verse_number": "१-२-४७-१४", "content_sanskrit": "कोटिशो वेदमार्गस्य ध्वंसकान्पापकर्मिणः ।\nइयं मया समाराध्य समानीता गिरेः सुता ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003660014, "chapter_id": 23660, "verse_number": "१-२-४७-१५", "content_sanskrit": "कोटिसंख्याभिरत्युग्रदेवीभिः संवृता च सा ।\nदक्षिणां दिशमाश्रित्य संस्थिता मम गौरवात् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003660015, "chapter_id": 23660, "verse_number": "१-२-४७-१६", "content_sanskrit": "पश्चिमायां तथा देवी संस्थिता भास्करा शुभा ।\nययाविष्टानि भासंते भास्करप्रमुखानि च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003660016, "chapter_id": 23660, "verse_number": "१-२-४७-१७", "content_sanskrit": "बिंबानि सर्वताराणां गच्छन्त्यायांति च द्रुतम् ।\nसैषा महाबला शक्तिर्भास्वरा कुरुनन्दन ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003660017, "chapter_id": 23660, "verse_number": "१-२-४७-१८", "content_sanskrit": "मयाराध्य समानीता कटाहादत्र संस्थिता ।\nकोटिकोटिवृता नित्यं त्रायते पश्चिमां दिशम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003660018, "chapter_id": 23660, "verse_number": "१-२-४७-१९", "content_sanskrit": "उत्तरस्यां तथा देवी संस्थिता योगनंदिनी ।\nपरमप्रकृतेर्देहात्पूर्वं निःसृतया यया ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003660019, "chapter_id": 23660, "verse_number": "१-२-४७-२०", "content_sanskrit": "दृष्ट्या दृष्टा निर्मलया योगमापुश्चतुःसनाः ।\nयोगीश्वरी च सा देवी सनकाद्यैः सुतोषिता ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003660020, "chapter_id": 23660, "verse_number": "१-२-४७-२१", "content_sanskrit": "सैव चांडकटाहान्मे समाराध्यात्र प्रापिता ।\nयोगिनीभिः परिवृता संस्थिता चोत्तरां दिशम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003660021, "chapter_id": 23660, "verse_number": "१-२-४७-२२", "content_sanskrit": "एवमेता महाशक्त्यश्चतस्रः संस्थिताः सदा ।\nपूजिताः कामदा नित्यं रुष्टाः संहरणक्षमाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003660022, "chapter_id": 23660, "verse_number": "१-२-४७-२३", "content_sanskrit": "ततश्च नव मे दुर्गाः समानीताः शृणुध्व ताः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003660023, "chapter_id": 23660, "verse_number": "१-२-४७-२४", "content_sanskrit": "त्रिपुरानाम परमा देवी स्थाणुर्यया पुरा ।\nआविष्टस्त्रिपुरं निन्ये भस्मत्वं जगदीश्वरः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003660024, "chapter_id": 23660, "verse_number": "१-२-४७-२५", "content_sanskrit": "त्रिपुरेति ततस्तां तु प्रोक्तवान्भगवान्हरः ।\nतुष्टाव च स्वयं तस्मात्पूज्या सा जगतामपि ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003660025, "chapter_id": 23660, "verse_number": "१-२-४७-२६", "content_sanskrit": "सा चाराध्य समानीता मयामरेश्वरपर्वतात् ।\nभक्तानां कामदा सास्ति भट्टादित्यसमीपतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003660026, "chapter_id": 23660, "verse_number": "१-२-४७-२७", "content_sanskrit": "अपरा चापि कोलंबा महाशक्तिः सनातनी ।\nकोलरूपी ययाविष्टः केशवश्चोज्जहार गाम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003660027, "chapter_id": 23660, "verse_number": "१-२-४७-२८", "content_sanskrit": "तस्मात्सा विष्णुना चोक्ता कोलंबेति स्तुतार्चिता ।\nसा च देवी मया पार्थ भक्तियोगेन तोषिता ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003660028, "chapter_id": 23660, "verse_number": "१-२-४७-२९", "content_sanskrit": "वाराहगिरिसंस्था मां समानीता च साब्रवीत् ।\nयत्राहं नारद सदा तिष्ठामि कृपयार्थिनाम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003660029, "chapter_id": 23660, "verse_number": "१-२-४७-३०", "content_sanskrit": "तत्र कूपेन संस्थेयं रुद्राणीसंस्थितेन वै ।\nतं हि कूपं विना मह्यं न रतिर्जायते क्वचित् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003660030, "chapter_id": 23660, "verse_number": "१-२-४७-३१", "content_sanskrit": "तस्माद्भवान्कूपवरं स्वयमत्र खन द्विज ।\nएवमुक्ते पार्थ देव्या दर्भमूलेन मे तदा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003660031, "chapter_id": 23660, "verse_number": "१-२-४७-३२", "content_sanskrit": "कूपोऽखनि यत्र साक्षाद्रुद्राणी कूप आबभौ ।\nततो मया तत्र देवाः स्नात्वा जप्त्वा च तर्पिताः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003660032, "chapter_id": 23660, "verse_number": "१-२-४७-३३", "content_sanskrit": "पूजिता च ततो दैवी कोलंबा जगदीश्वरी ।\nपरितुष्टा तदा देवी प्रणतं मा ततोऽब्रवीत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003660033, "chapter_id": 23660, "verse_number": "१-२-४७-३४", "content_sanskrit": "सदात्र चाहं स्थास्यामि प्रसादं प्रापिता त्वया ।\nये च कूपेत्र संस्नात्वा माघाष्टम्यां विशेषतः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003660034, "chapter_id": 23660, "verse_number": "१-२-४७-३५", "content_sanskrit": "पूजयिष्यंति मां मर्त्यास्तेषां छेत्स्यामि दुष्कृतम् ।\nसर्वतीर्थमयी यश्च सर्वर्तुकवनेस्थितः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003660035, "chapter_id": 23660, "verse_number": "१-२-४७-३६", "content_sanskrit": "मेरोः समीपे रुद्राण्याः कूप एष स एव च ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003660036, "chapter_id": 23660, "verse_number": "१-२-४७-३७", "content_sanskrit": "प्रयागादपि गंगाया गयायाश्च विशेषतः ।\nकूपेस्मिन्नधिकं स्नानं मया नारद कीर्तितम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003660037, "chapter_id": 23660, "verse_number": "१-२-४७-३८", "content_sanskrit": "तदहं तव वाक्येन संस्थितात्र तपोधन ।\nगुहेनाथ सरः पुण्यं पालयिष्याम्यतंद्रिता ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003660038, "chapter_id": 23660, "verse_number": "१-२-४७-३९", "content_sanskrit": "कुमारेशं पूजयित्वा पूजयिष्यंति ये च माम् ।\nदेवीभिः षष्टिकोटीभिर्युता तेषामभीष्टदा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003660039, "chapter_id": 23660, "verse_number": "१-२-४७-४०", "content_sanskrit": "नारद उवाच ।\nइत्युक्तोऽहं पार्थ देव्या तदानीं प्रीयमाणया ।\nप्रत्यब्रवं प्रमुदितः कोलंबां विश्वमातरम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003660040, "chapter_id": 23660, "verse_number": "१-२-४७-४१", "content_sanskrit": "अत्रास्य माता त्वं देवि गुप्तक्षेत्रस्यकारणम् ।\nतीर्थयात्रा वृथा तेषां नार्च्चयंतीह त्वां च ये ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003660041, "chapter_id": 23660, "verse_number": "१-२-४७-४२", "content_sanskrit": "इदं च यत्सरः पुण्यं त्वन्नाम्ना ख्यातिमेष्यति ।\nईश्वरी सरसोऽस्य त्वं तीर्थस्यास्य तथेश्वरी ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003660042, "chapter_id": 23660, "verse_number": "१-२-४७-४३", "content_sanskrit": "एवं दीर्घं तपस्तत्वा स्थापिता मयका शुभा ।\nमहादुर्गा नरैस्तस्मात्पूज्येयं सततं बुधैः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003660043, "chapter_id": 23660, "verse_number": "१-२-४७-४४", "content_sanskrit": "तृतीया च दिशि तस्यां स्थिता संस्थापिता मया ।\nगुहेन च कपालेश्याः प्रभावोस्याः पुरेरितः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003660044, "chapter_id": 23660, "verse_number": "१-२-४७-४५", "content_sanskrit": "धन्यास्ते ये प्रपश्यंति नित्यमेनां नरोत्तमाः ।\nकपालेश्वरमभ्यर्च्य विश्वशक्तिरियं यतः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003660045, "chapter_id": 23660, "verse_number": "१-२-४७-४६", "content_sanskrit": "एवमेतास्तिस्रो दुर्गाः पूर्वस्यां दिशि संस्थिताः ।\nपश्चिमायां प्रवक्ष्यामि तिस्रो दुर्गा महोत्तमा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003660046, "chapter_id": 23660, "verse_number": "१-२-४७-४७", "content_sanskrit": "सुवर्णाक्षी तु या देवी ब्रह्मांडपरिपालिनी ।\nसा मयात्र समाराध्य तीर्थे देवी निवेशिता ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003660047, "chapter_id": 23660, "verse_number": "१-२-४७-४८", "content_sanskrit": "ये चैनां प्रणमिष्यंति पूजयिष्यंति भक्तितः ।\nत्रयस्त्रिंशद्भिः कोटीभिर्देवीभिः पूजिता च तैः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003660048, "chapter_id": 23660, "verse_number": "१-२-४७-४९", "content_sanskrit": "अपरा च महादुर्गा चर्चिता चेति संस्थिता ।\nरसातलतलात्तत्र मयानीता सुभक्तितः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003660049, "chapter_id": 23660, "verse_number": "१-२-४७-५०", "content_sanskrit": "इयमर्च्या च चिंत्या च वीरत्वं समभीप्सुभिः ।\nबहुभिर्देवदैतेयैर्ददौ तेभ्यश्च वीरताम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003660050, "chapter_id": 23660, "verse_number": "१-२-४७-५१", "content_sanskrit": "इयमेव महादुर्गा शूद्रकं वीरसत्तमम् ।\nचौरैर्बद्धं कलौ चाग्रे मोक्षयिष्यति विक्रमात् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003660051, "chapter_id": 23660, "verse_number": "१-२-४७-५२", "content_sanskrit": "ततस्त्वेतां स चाराध्य वीरेंद्रत्वमवाप्स्यति ।\nनिहनिष्यति चाक्रम्य कालसेनमुखान्रिपून् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003660052, "chapter_id": 23660, "verse_number": "१-२-४७-५३", "content_sanskrit": "तस्मादियं समाराध्या वीर्यकामैर्नरैः सदा ।\nचर्चिता या महादुर्गा पश्चिमायां दिशि स्थिता ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003660053, "chapter_id": 23660, "verse_number": "१-२-४७-५४", "content_sanskrit": "तथा त्रैलोक्यविजया तृतीयस्यां दिशि स्थिता ।\nयामाराध्य जयं प्राप्तस्त्रिलोक्यां रोहिणीपतिः ।\nसोमलोकान्मयानीता पूजिता जयदा सदा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003660054, "chapter_id": 23660, "verse_number": "१-२-४७-५५", "content_sanskrit": "एवमेताः पश्चिमायामुत्तरस्यामतः शृणु ।\nतिस्रो देव्यश्चोत्तरस्यामेकवीरामुखाः स्थिताः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003660055, "chapter_id": 23660, "verse_number": "१-२-४७-५६", "content_sanskrit": "एकवीरेति या देवी साक्षात्सा शिवपूजिता ।\nययाविष्टो जगत्सर्वं संहरत्येष भूतराट् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003660056, "chapter_id": 23660, "verse_number": "१-२-४७-५७", "content_sanskrit": "वीर्येणाद्येकवीरायाः कृत्वा लोकांश्च भस्मसात् ।\nयुगैकादशपूर्णत्वे विलक्षोऽभूत्स भस्मनि ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003660057, "chapter_id": 23660, "verse_number": "१-२-४७-५८", "content_sanskrit": "एवंविधा त्वेकवीरा शक्तिरेषा सनातनी ।\nपूजिताराधिता चैव सर्वाभीप्सितदा नृणाम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003660058, "chapter_id": 23660, "verse_number": "१-२-४७-५९", "content_sanskrit": "ब्रह्मलोकात्समानीता मयाराध्यात्र भारत ।\nनामकीर्तनमप्यस्या दुष्टानां घातनं विदुः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003660059, "chapter_id": 23660, "verse_number": "१-२-४७-६०", "content_sanskrit": "द्वितीया हरसिद्ध्याख्या देवी दुर्गा महाबला ।\nशीकोत्तरात्समाराध्य मयानीतात्र पांडव ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003660060, "chapter_id": 23660, "verse_number": "१-२-४७-६१", "content_sanskrit": "यदा शीकोत्तरस्थेन पार्वत्या प्रार्थितेन च ।\nरुद्रेण डाकिनीमंत्रः प्रोक्तो देव्याः कृपालुना ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003660061, "chapter_id": 23660, "verse_number": "१-२-४७-६२", "content_sanskrit": "तदा मंत्रप्रभावेण मोहिता गिरिजा सती ।\nतमेवाक्रम्य मांसं च शोणितं च भवं पपौ ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003660062, "chapter_id": 23660, "verse_number": "१-२-४७-६३", "content_sanskrit": "ततो रुद्रशरीरात्तु विनिष्क्रांतार्तिनाशिनी ।\nहरसिद्धिर्महादुर्गा महामंत्रविशारदा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003660063, "chapter_id": 23660, "verse_number": "१-२-४७-६४", "content_sanskrit": "सा सहस्रभुजा देवी समाक्रम्याभिपीड्य च ।\nमोक्षयामास गिरिशमशापयत तां तथा ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003660064, "chapter_id": 23660, "verse_number": "१-२-४७-६५", "content_sanskrit": "ततः प्रभृति सा लोके हरसिद्धिः प्रकीर्त्यते ।\nदेवीनां षष्टिकोटीभिरावृता पूज्यते सुरैः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003660065, "chapter_id": 23660, "verse_number": "१-२-४७-६६", "content_sanskrit": "एतामाराध्य सुग्रीवप्रमुखा दोषनाशिनीम्॥  ।\nअभूवन्त्सुमहावीर्या डाकिनीसंघनाशनाः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003660066, "chapter_id": 23660, "verse_number": "१-२-४७-६७", "content_sanskrit": "तस्मादेतां पूजयेत्तु मनोवाक्कायकर्मभिः ।\nडाकिन्याद्या न सर्पंति हरसिद्धेरनंतरम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003660067, "chapter_id": 23660, "verse_number": "१-२-४७-६८", "content_sanskrit": "तृतीयेशानकोणस्था चंडिका नवमी स्थिता ।\nवागीशोऽपि लभेत्पारं नैव यस्याः प्रवर्णने ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003660068, "chapter_id": 23660, "verse_number": "१-२-४७-६९", "content_sanskrit": "या पुरा पार्वतीदेहाद्विनिःसृत्य महासुरौ ।\nचंडमुंडौ निहत्यैव भक्षयामास क्रोधतः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003660069, "chapter_id": 23660, "verse_number": "१-२-४७-७०", "content_sanskrit": "अक्षौहिणीशतं त्वेकं चंडमुंडौ च तावुभौ ।\nनापूर्यतैकग्रासोऽस्याः किंलक्ष्या यात्वियं हि सा ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003660070, "chapter_id": 23660, "verse_number": "१-२-४७-७१", "content_sanskrit": "इयमेवांधकानां च तृषिता शोणितं पुनः ।\nपपौ ततो निजग्राह चांधकं भगवान्भवः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003660071, "chapter_id": 23660, "verse_number": "१-२-४७-७२", "content_sanskrit": "इयं च रक्तबीजानां कृत्वा पानं च रक्तजम् ।\nअर्पयामास तं देव्याश्चामुण्डापीतशोणितम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003660072, "chapter_id": 23660, "verse_number": "१-२-४७-७३", "content_sanskrit": "एषा तृप्यति भक्तानां प्रणामेनापि भारत ।\nअर्बुदानां च कोटीभिर्दैत्यानां पापकर्मिणाम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003660073, "chapter_id": 23660, "verse_number": "१-२-४७-७४", "content_sanskrit": "कुण्डं चास्या मया देव्याः पुण्यं निष्पादितं शुभम् ।\nयत्र वै स्पर्शमात्रेण सर्वतीर्थफलं लभेत् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003660074, "chapter_id": 23660, "verse_number": "१-२-४७-७५", "content_sanskrit": "हरसिद्धिर्देवसिद्धिर्धर्मसिद्धिश्च भारत ।\nविविधा प्राप्यते सिद्धिस्तीर्थेऽस्मिंश्चंडिकारतैः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003660075, "chapter_id": 23660, "verse_number": "१-२-४७-७६", "content_sanskrit": "यश्च पूजयते देवीं स्वल्पेन बहुनापि वा ।\nकात्यायनी कोटिशतैर्वृता तस्य विभूतिदा ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003660076, "chapter_id": 23660, "verse_number": "१-२-४७-७७", "content_sanskrit": "एवमेता महादुर्गा नवतीर्थेऽत्र संस्थिताः ।\nचतस्रश्चापि दिग्देव्यो नित्यमर्च्याः शुभेप्सुभिः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003660077, "chapter_id": 23660, "verse_number": "१-२-४७-७८", "content_sanskrit": "आश्विनस्य च मासस्य नवरात्रे विशेषतः ।\nउपोष्य चैकभक्तैर्वा देवीस्त्वेताः प्रपूजयेत् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003660078, "chapter_id": 23660, "verse_number": "१-२-४७-७९", "content_sanskrit": "बलिपूपकनैवेद्यैस्तर्पणैर्धूपगंधिभिः ।\nतस्य रक्षां चरंत्येता रथ्यासु त्रिकचत्वरे ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003660079, "chapter_id": 23660, "verse_number": "१-२-४७-८०", "content_sanskrit": "भूतप्रेतपिशाचाद्या नोपकुर्युः प्रपीडनम् ।\nआपदो विद्रवंत्याशु योगिन्यो नंदयंति तम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003660080, "chapter_id": 23660, "verse_number": "१-२-४७-८१", "content_sanskrit": "पुत्रार्थी लभते पुत्रान्धनार्थी धनमाप्नुयात् ।\nरोगार्तो मुच्यते रोगाद्बद्धो मुच्येत बन्धनात् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003660081, "chapter_id": 23660, "verse_number": "१-२-४७-८२", "content_sanskrit": "आसां यः कुरुते भक्तिं नरो नारी च श्रद्धया ।\nसर्वान्कामानवाप्नोति यांश्चिंतयति चेतसि ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003660082, "chapter_id": 23660, "verse_number": "१-२-४७-८३", "content_sanskrit": "कामगव्य इमा देव्यश्चिन्तामणिनिभास्तथा ।\nकल्पवल्ल्योऽथ भक्तानां प्रतिच्छन्दोऽत्र नव हि ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003660083, "chapter_id": 23660, "verse_number": "१-२-४७-८४", "content_sanskrit": "तथात्र भूतमातास्ति हरसिद्धेस्तु दक्षिणे ।\nतस्या माहात्म्यमतुलं संक्षेपात्प्रब्रवीमि ते ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003660084, "chapter_id": 23660, "verse_number": "१-२-४७-८५", "content_sanskrit": "पूर्वं किल गुहो विद्वान्पुण्ये सारस्वते तटे ।\nभूतप्रेतपिशाचानामाधिराज्येऽभ्यषिच्यत ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003660085, "chapter_id": 23660, "verse_number": "१-२-४७-८६", "content_sanskrit": "स च सर्वाणि भूतानि मर्यादायामधारयत् ।\nएतदन्नं प्रदायैव कृपया भगवान्गुहः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003660086, "chapter_id": 23660, "verse_number": "१-२-४७-८७", "content_sanskrit": "यदमंत्रहुतं किंचिद्वेदबाह्यं च यत्कृतम् ।\nअश्रद्धया च क्रोधेन तद्वस्तृप्त्यै भविष्यति ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003660087, "chapter_id": 23660, "verse_number": "१-२-४७-८८", "content_sanskrit": "ततस्त्वनेन भोगेन तानि नंदंति कृत्स्नशः ।\nततः केनापि कालेन श्रद्धयाऽश्रद्धया कृतम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003660088, "chapter_id": 23660, "verse_number": "१-२-४७-८९", "content_sanskrit": "पुण्यं तान्येव भूतानि ग्रसंत्याक्रम्य देवताः ।\nततो देवाः क्षुधार्त्तास्ते गुहायैतन्न्यवेदयन् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003660089, "chapter_id": 23660, "verse_number": "१-२-४७-९०", "content_sanskrit": "स वै तदाकर्ण्य क्रुद्धो गुहः काल इवाभवत् ।\nतस्य क्रुद्धस्य भ्रूपद्ममध्यात्काचिद्विनिर्गता ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003660090, "chapter_id": 23660, "verse_number": "१-२-४७-९१", "content_sanskrit": "ज्वालामाला सुदुर्दर्शा नारी द्वादशलोचना ।\nसा च प्रणम्य तं प्राह तव शक्तिरहं प्रभो ।\nशीघ्रमादिश मां कृत्ये किं करोमि तवेप्सितम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003660091, "chapter_id": 23660, "verse_number": "१-२-४७-९२", "content_sanskrit": "स्कन्द उवाच ।\nएतैर्भूतगणैः पापैरुल्लंघ्य मम शासनम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003660092, "chapter_id": 23660, "verse_number": "१-२-४७-९३", "content_sanskrit": "मनुष्यदत्तं सकलं भुज्यते स्वेच्छयाधमैः ।\nशीघ्रमेतानि त्वं तस्मान्मर्यादायामुपानय ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003660093, "chapter_id": 23660, "verse_number": "१-२-४७-९४", "content_sanskrit": "एतास्त्वानुव्रजिष्यंति देव्यः कोटिशतं शुभे ।\nततस्तथेति सा चोक्ता देवीभिः संवृता तदा ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003660094, "chapter_id": 23660, "verse_number": "१-२-४७-९५", "content_sanskrit": "मयूरं समुपास्थाय गुहशक्तिः समागता ।\nसरोजवनमासाद्य भूतसंघानपश्यत ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003660095, "chapter_id": 23660, "verse_number": "१-२-४७-९६", "content_sanskrit": "जघान च समासाद्य देवी नानाविधायुधैः ।\nततः प्रेतपिशाचाद्या हन्यमाना महारणे ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003660096, "chapter_id": 23660, "verse_number": "१-२-४७-९७", "content_sanskrit": "प्रसादयंति तां देवीं नानावेषैः सुदीनवत् ।\nकेचिद्ब्राह्मणवेषैश्च तापसानां तथो क्तिभिः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003660097, "chapter_id": 23660, "verse_number": "१-२-४७-९८", "content_sanskrit": "नृत्यंति देवि पद्माक्षि प्रसीदेति पुनःपुनः ।\nततः प्रसन्ना सा देवी व्रियतां स्वेच्छयाऽह तान् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003660098, "chapter_id": 23660, "verse_number": "१-२-४७-९९", "content_sanskrit": "तां ते प्रोचुस्त्राहि नस्त्वं भूतमाता भवेश्वरि ।\nमर्यादां नैव त्यक्ष्यामो वयं स्कन्दविनिर्मिताम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003660099, "chapter_id": 23660, "verse_number": "१-२-४७-१००", "content_sanskrit": "ये चैवं त्वां तोषयन्ति तेषां देहि वरान्सदा ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003660100, "chapter_id": 23660, "verse_number": "१-२-४७-१०१", "content_sanskrit": "श्रीदेव्युवाच ।\nवैशाखे दर्शदिवसे ये चैवं तोषयंति माम् ।\nअरिष्टाभरणैः पुष्पैर्दधिभक्तैश्च पूजनैः ।\nतेषां सर्वोपसर्गा वै यास्यंति विलयं स्फुटम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003660101, "chapter_id": 23660, "verse_number": "१-२-४७-१०२", "content_sanskrit": "एवं दत्त्वा वरं देवी मुमुदे भूतसंवृता ।\nएवंप्रभावा सा देवी मयानीतात्र भारत ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003660102, "chapter_id": 23660, "verse_number": "१-२-४७-१०३", "content_sanskrit": "य एनां प्रणमेन्मर्त्यः सर्वारिष्टैर्विमुच्यते ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003660103, "chapter_id": 23660, "verse_number": "१-२-४७-१०४", "content_sanskrit": "एवं प्रभावाः परिकीर्तिता मया समासतस्तीर्थवरेऽत्र देव्यः ।\nचतुर्दशैवार्जुन पूजिता याश्चतुर्दशस्थानवरैर्नृमुख्यैः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003660104, "chapter_id": 23660, "verse_number": "१-२-४७-१०५", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां प्रथमे माहेश्वरखण्डे कौमारिकाखण्डे श्रीदेव्याख्यानवर्णनंनाम सप्तचत्वारिंशत्तमोऽध्यायः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}]