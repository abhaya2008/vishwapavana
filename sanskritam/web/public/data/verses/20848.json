[{"id": 7000848000, "chapter_id": 20848, "verse_number": "६-१९१-१", "content_sanskrit": "ईश्वर उवाच ।\nषोडशाध्यायसामर्थ्यं कथितं शृणु सांप्रतम् ।\nस्पष्टं सप्तदशाध्यायमहिमांभोनिधिं शिवे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000848001, "chapter_id": 20848, "verse_number": "६-१९१-२", "content_sanskrit": "खड्गबाहोः सुतस्यैव भृत्यो दुःशासनोऽभवत् ।\nतं गजं धर्तुमागत्य गजात्प्राप्तो यमक्षयम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000848002, "chapter_id": 20848, "verse_number": "६-१९१-३", "content_sanskrit": "तद्वासनानिबद्धात्मा गजयोनिमवाप्य च ।\nगीता सप्तदशाध्यायं श्रुत्वा प्राप्तः परं पदम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000848003, "chapter_id": 20848, "verse_number": "६-१९१-४", "content_sanskrit": "देव्युवाच ।\nदुःशासनो गजत्वं च प्राप्य मुक्त इति श्रुतम् ।\nतदेव वद कल्याण विस्तरेण मम प्रभो ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000848004, "chapter_id": 20848, "verse_number": "६-१९१-५", "content_sanskrit": "ईश्वर उवाच ।\nस्थितः कश्चन दुर्मेधा मंडलीककुमारकैः ।\nबहुमूल्यं पणं कृत्वा गजमारूढवांस्ततः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000848005, "chapter_id": 20848, "verse_number": "६-१९१-६", "content_sanskrit": "गत्वा कतिपयान्येव पदानि जनवारितः ।\nनाम्ना दुःशासनो मूढः प्रौढवाक्यमुदीरयन् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000848006, "chapter_id": 20848, "verse_number": "६-१९१-७", "content_sanskrit": "ततो निशम्य तद्वाक्यं क्रोधांधः सिंधुरोऽभवत् ।\nन्यपतच्च स्खलत्पादः कंपमानकुमारकैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000848007, "chapter_id": 20848, "verse_number": "६-१९१-८", "content_sanskrit": "ततो निपतितं किंचिदुच्छ्वसंतं गजो रुषा ।\nऊर्द्ध्वमुन्मूलयांचक्रे कृतांतकनिरंकुशः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000848008, "chapter_id": 20848, "verse_number": "६-१९१-९", "content_sanskrit": "गतासोरपि रोषेण तस्यास्थ्न्यां च गणं गजः ।\nविकीर्णवान्पृथक्कृत्वा मत्तो दंतावलस्ततः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000848009, "chapter_id": 20848, "verse_number": "६-१९१-१०", "content_sanskrit": "ततः कालेन संप्रेत्य गजयोनिमवाप सः ।\nमहांतं कालमनयत्सिंहलद्वीपभूपतेः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000848010, "chapter_id": 20848, "verse_number": "६-१९१-११", "content_sanskrit": "मैत्री गरीयसी सार्द्धं खड्गबाहुमहीभुजा ।\nततोऽयं जलमार्गेण प्रापितो वारुणो मतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000848011, "chapter_id": 20848, "verse_number": "६-१९१-१२", "content_sanskrit": "जयदेवेन खड्गबाहोः प्रीत्या नीतो महीभुजा ।\nजातिं स्मरन्स्वकीयां स पश्यन्बंधून्सहोदरान् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000848012, "chapter_id": 20848, "verse_number": "६-१९१-१३", "content_sanskrit": "दुःखेन महतास्तोकान्दिवसानत्यवाहयत् ।\nउवास खड्गबाहोश्च गृहे तूष्णीमनिर्दिशन् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000848013, "chapter_id": 20848, "verse_number": "६-१९१-१४", "content_sanskrit": "स कदाचित्तु संतुष्टः समस्याश्लोकपूरणे ।\nकस्मैचित्कवये प्रादात्तमुपायन हस्तिनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000848014, "chapter_id": 20848, "verse_number": "६-१९१-१५", "content_sanskrit": "शतेन तेन कविना रोगोपद्रवभीरुणा ।\nमालवक्षोणिपालस्य विक्रीतश्चैत्यकुंजरः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000848015, "chapter_id": 20848, "verse_number": "६-१९१-१६", "content_sanskrit": "कियत्यपि गते काले पाल्यमानोऽपि यत्नतः ।\nमुमूर्षुरभवत्तत्र कुंजरो दुर्जरज्वरः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000848016, "chapter_id": 20848, "verse_number": "६-१९१-१७", "content_sanskrit": "न जिघ्रति पयः शीतं नादत्ते कवलं गजः ।\nस्वपित्यपि न सौख्येन मुंचत्यश्रूणि केवलम् ।\nततो हस्तिपकाख्यातं वृत्तांतमवनीपतिः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000848017, "chapter_id": 20848, "verse_number": "६-१९१-१८", "content_sanskrit": "आकर्ण्य स समायातो यत्रास्ते ज्वरितो गजः ।\nस चावलोक्य भूपालं जगद्विस्मयकारिणीम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000848018, "chapter_id": 20848, "verse_number": "६-१९१-१९", "content_sanskrit": "वाचमूचे गजः सम्यग्विसृष्टज्वरवेदनः ।\nराजन्नशेषशास्त्रज्ञ राजनीतिपयोनिधे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000848019, "chapter_id": 20848, "verse_number": "६-१९१-२०", "content_sanskrit": "निर्जितारातिसंघात मुरारिचरणप्रिय ।\nकिमौषधैरलं वैद्यैः किं धानैः किं नु जापकैः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000848020, "chapter_id": 20848, "verse_number": "६-१९१-२१", "content_sanskrit": "गीतासप्तदशाध्यायजापकं द्विजमानय ।\nतेनायं मामको रोगः शाम्यत्यत्र न संशयः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000848021, "chapter_id": 20848, "verse_number": "६-१९१-२२", "content_sanskrit": "यथादिष्टं गजेनासौ तथा चक्रे नराधिपः ।\nततो गजत्वमुत्सृज्य मुक्तो दुःशासनोऽभवत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000848022, "chapter_id": 20848, "verse_number": "६-१९१-२३", "content_sanskrit": "तेन विप्रेणाभिमंत्र्य जले क्षिप्ते तदुत्तमे ।\nअथ दिव्यं समारूढं विमानमवनीपतिः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000848023, "chapter_id": 20848, "verse_number": "६-१९१-२४", "content_sanskrit": "तं दुःशासनमद्राक्षीत्पाकशासनतेजसम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000848024, "chapter_id": 20848, "verse_number": "६-१९१-२५", "content_sanskrit": "राजोवाच ।\nकिं जातीयः किमात्मा त्वं किं वृत्त इति मे वद ।\nकेन वा कर्मणा जातो गजः कथमिहागतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000848025, "chapter_id": 20848, "verse_number": "६-१९१-२६", "content_sanskrit": "पृष्टो राज्ञा विमुक्तोऽसौ विमानस्थः स्थिराक्षरम् ।\nवृत्तं यथा यदाचख्यौ निजं दुःशासनः क्रमात् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000848026, "chapter_id": 20848, "verse_number": "६-१९१-२७", "content_sanskrit": "गीतासप्तदशाध्यायं जपन्मालवभूपतिः ।\nनरवर्माभवन्मुक्तः कालेनाल्पीयसा ततः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]