[{"id": 7002007000, "chapter_id": 22007, "verse_number": "५२-१", "content_sanskrit": "भगवानुवाच ।\nयोगिन्यष्टाष्टकं वक्ष्ये ऐन्द्रादीशान्ततः क्रमात् ।\nअक्षोभ्या रूक्षकर्णी च राक्षसी कृपणाक्षया ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002007001, "chapter_id": 22007, "verse_number": "५२-२", "content_sanskrit": "पिङ्गाक्षी च क्षया क्षेमा इला लीलालया तथा ।\nलोला लक्ता बलाकेशी लालसा विमला पुनः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002007002, "chapter_id": 22007, "verse_number": "५२-३", "content_sanskrit": "हुताशा च विशालाक्षी हुङ्कारा वडवामुखी ।\nमहाक्रूरा क्रोधना तु भयङ्करी महानना ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002007003, "chapter_id": 22007, "verse_number": "५२-४", "content_sanskrit": "सर्वज्ञा तला तारा ऋग्वेदा तु हयानना ।\nसाराख्या रुद्रसङ्ग्रही सम्बरा तालजङ्घिका ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002007004, "chapter_id": 22007, "verse_number": "५२-५", "content_sanskrit": "रक्ताक्षी सुप्रसिद्धा तु विद्युज्जिह्वा कारङ्किणी ।\nमेघनादा प्रचण्डोग्रा कालकर्णी वरप्रदा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002007005, "chapter_id": 22007, "verse_number": "५२-६", "content_sanskrit": "चन्द्रा चन्द्रावली चैव प्रपञ्चा प्रलयान्तिका ।\nशिशुवक्त्रा पिशाची च पिशिताशा च लोलुपा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002007006, "chapter_id": 22007, "verse_number": "५२-७", "content_sanskrit": "धमनी तापनी चैव रागिणी विकृतानना ।\nवायुवेगा बृहत्कुक्षिर्विकृता विश्वरूपिका ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002007007, "chapter_id": 22007, "verse_number": "५२-८", "content_sanskrit": "यमजिह्वा जयन्ती च दुर्जया च जयन्तिका ।\nविडाली रेवती चैव पूतना विजयान्तिका ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002007008, "chapter_id": 22007, "verse_number": "५२-९", "content_sanskrit": "अष्टहस्ताश्चतुर्हस्ता इच्छास्त्राः ।\nसर्वसिद्धिदाः ।\nभैरवश्चार्कहस्तः स्यात् कूर्परास्यो जटेन्दुभृत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002007009, "chapter_id": 22007, "verse_number": "५२-१०", "content_sanskrit": "खड्गाङ्कुशकुठारेषुविश्वाभयभृदेकतः ।\nचापत्रिशूलखट्वाङ्गपाशकार्द्धवरोद्यतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002007010, "chapter_id": 22007, "verse_number": "५२-११", "content_sanskrit": "गजचर्मधरो द्वाभ्यां कृत्तिवासोहिभूषितः ।\nप्रेताशनो मातृमध्ये पूज्यः पञ्चाननोथवा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002007011, "chapter_id": 22007, "verse_number": "५२-१२", "content_sanskrit": "अविलोमाग्निपर्यन्तं दीर्घाष्टकैकभेदितम् ।\nतत्षडङ्गानि जात्यन्तैरन्वितं च क्रमाद् यजेत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002007012, "chapter_id": 22007, "verse_number": "५२-१३", "content_sanskrit": "मन्दिराग्निदलारुढं सुवर्णरसकान्वितम् ।\nनादविन्द्विन्दुसंयुक्तंमातृनाथाङ्गदीपितम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002007013, "chapter_id": 22007, "verse_number": "५२-१४", "content_sanskrit": "वीरभद्रो वृषारूढो मात्रग्रे स चतुर्मुखः ।\nगौरी तु द्विभुजा त्र्यक्षा शूलिनी दर्पणान्विता ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002007014, "chapter_id": 22007, "verse_number": "५२-१५", "content_sanskrit": "शूलं गलन्तिका कुण्डी वरदा च चतुर्भुजा ।\nअब्जस्था ललिता स्कन्दगणादर्शशलाकया ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002007015, "chapter_id": 22007, "verse_number": "५२-१६", "content_sanskrit": "चण्डिका दशहस्ता स्यात् खड्गशूलारिशक्तिधृक् ।\nदक्षे वामे नागपाश चर्माङ्कुशकुठारकम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002007016, "chapter_id": 22007, "verse_number": "५२-१७", "content_sanskrit": "धनुः सिंहे च महिषः शूलेन प्रहतोग्रतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]