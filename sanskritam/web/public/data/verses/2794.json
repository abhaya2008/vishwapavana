[{"id": 2084285, "chapter_id": 2794, "verse_number": "१२-२९९-०x", "content_sanskrit": "पराशर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2084286, "chapter_id": 2794, "verse_number": "१२-२९९-१", "content_sanskrit": "वृत्तिः सकाशाद्वर्णेभ्यस्त्रिभ्यो हीनस्य शोभना।\nप्रीत्योपनीता निर्दिष्टा धर्मिष्ठान्कुरुते सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2084287, "chapter_id": 2794, "verse_number": "१२-२९९-२", "content_sanskrit": "वृत्तिश्चेन्नास्ति शूद्रस्य पितृपैतामही ध्रुवा।\nन वृत्तिं परतो मार्गेच्छुश्रूषां तु प्रयोजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2084288, "chapter_id": 2794, "verse_number": "१२-२९९-३", "content_sanskrit": "सद्भिस्तु सह संसर्गः शोभते धर्मदर्शिभिः।\nनित्यं सर्वास्ववस्थासु नासद्भिरिति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2084289, "chapter_id": 2794, "verse_number": "१२-२९९-४", "content_sanskrit": "यथोदयगिरौ द्रव्यं सन्निकर्षेण दीप्यते।\nतथा सत्सन्निकर्षेण हीनवर्णोऽपि दीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2084290, "chapter_id": 2794, "verse_number": "१२-२९९-५", "content_sanskrit": "यादृशेन हि वर्णेन भाव्यते शुक्लमम्बरम्।\nतादृशं कुरुते रूपमेतदेवमवेहि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2084291, "chapter_id": 2794, "verse_number": "१२-२९९-६", "content_sanskrit": "तस्माद्गुणेषु रज्येथा मा दोषेषु कदाचन।\nअनित्यमिह मर्त्यानां जीवितं हि चलाचलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2084292, "chapter_id": 2794, "verse_number": "१२-२९९-७", "content_sanskrit": "सुखे वा यदि वा दुःखे वर्तमानो विचक्षणः।\nयश्चिनोति शुभान्येव स भद्राणीह पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2084293, "chapter_id": 2794, "verse_number": "१२-२९९-८", "content_sanskrit": "धर्मादपेतं यत्कर्म यद्यपि स्यान्महाफलम्।\nन तत्सेवेत मेधावी न तद्धितमिहोच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2084294, "chapter_id": 2794, "verse_number": "१२-२९९-९", "content_sanskrit": "`धर्मेण सहितं यत्तु भवेदल्पफलोदयम्।\nतत्कार्यमविशङ्केन कर्मात्यन्तं सुखावहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2084295, "chapter_id": 2794, "verse_number": "१२-२९९-१०", "content_sanskrit": "यो हृत्वा गोसहस्राणि नृपो दद्यादरक्षिता।\nस शब्दमात्रफलभाग्राजा भवति तस्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2084296, "chapter_id": 2794, "verse_number": "१२-२९९-११", "content_sanskrit": "स्वयंभूरसृजच्चाग्रे धातारं लोकसत्कृतम्।\nधाताऽसृजत्पुत्रमेकं लोकानां धारणे रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2084297, "chapter_id": 2794, "verse_number": "१२-२९९-१२", "content_sanskrit": "तमर्चयित्वा वैश्यस्तु कुर्यादत्यर्थमृद्धिमत्।\nरक्षितव्यं तु राजन्यैरुपयोज्यं द्विजातिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2084298, "chapter_id": 2794, "verse_number": "१२-२९९-१३", "content_sanskrit": "अजिह्नैरशठक्रोधैर्हव्यकव्यप्रयोक्तृभिः।\nशूर्दैर्निर्मार्जनं कार्यमेवं धर्मो न नश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2084299, "chapter_id": 2794, "verse_number": "१२-२९९-१४", "content_sanskrit": "अप्रनष्टे ततो धर्मे भवन्ति सुखिताः प्रजाः।\nसुखेन तासां राजेन्द्र मोदन्ते दिवि देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2084300, "chapter_id": 2794, "verse_number": "१२-२९९-१५", "content_sanskrit": "तस्माद्यो रक्षति नृपः स धर्मेणेति पूज्यते।\nअधीते चापि यो विप्रो वैश्यो यश्चार्जने रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2084301, "chapter_id": 2794, "verse_number": "१२-२९९-१६", "content_sanskrit": "यश्च शुश्रूषते शूद्रः सततं नियतेन्द्रियः।\nअतोऽन्यथा मनुष्येन्द्र स्वधर्मात्परिहीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2084302, "chapter_id": 2794, "verse_number": "१२-२९९-१७", "content_sanskrit": "प्राणसंतापनिर्दिष्टाः काकिण्योऽपि महाफलाः।\nन्यायेनोपार्जिता दत्ताः किमुतान्याः सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2084303, "chapter_id": 2794, "verse_number": "१२-२९९-१८", "content_sanskrit": "सत्कृत्य हि द्विजातिभ्यो यो ददाति नराधिपः।\nयादृशं तादृशं नित्यमश्नाति फलमूर्जितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2084304, "chapter_id": 2794, "verse_number": "१२-२९९-१९", "content_sanskrit": "अभिगम्य तु यद्दत्तं धर्म्यमाहुरभिष्टुतम्।\nयाचितेन तु यद्दत्तं तदाहुर्मध्यमं फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2084305, "chapter_id": 2794, "verse_number": "१२-२९९-२०", "content_sanskrit": "अवज्ञया दीयते यत्तथैवाश्रद्धयाऽपि वा।\nतदाहुरधमं दानं मुनयः सत्यवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2084306, "chapter_id": 2794, "verse_number": "१२-२९९-२१", "content_sanskrit": "अतिक्रामेन्मज्जमानो विविधेन नरः सदा।\nतथा प्रयत्नं कुर्वीत यथा मुच्येत संशयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2084307, "chapter_id": 2794, "verse_number": "१२-२९९-२२", "content_sanskrit": "दमेन शोभते विप्रः क्षत्रियो विजयेन तु।\nधनेन वैश्यः शृद्रस्तु नित्यं दाक्ष्येण शोभते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2084308, "chapter_id": 2794, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि एकोनत्रिशततमोऽध्यायः॥ २९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]