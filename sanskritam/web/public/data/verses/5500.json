[{"id": 2210401, "chapter_id": 5500, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2210402, "chapter_id": 5500, "verse_number": "१", "content_sanskrit": "यज्ञे सक्ता नृपतयस्तपः सक्ता महर्षयः ।\nशान्तिव्यवसिता विप्राः शमे दम इति प्रभो(?) ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2210403, "chapter_id": 5500, "verse_number": "२", "content_sanskrit": "तस्माद् यज्ञफलैस्तुल्यं न किञ्चिदिह विद्यते ।\nइति मे वर्तते बुद्धिस्तथा चैतन्न संशयः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2210404, "chapter_id": 5500, "verse_number": "३", "content_sanskrit": "यज्ञैरिष्ट्वा च बहवो राजानो द्विजसत्तमाः ।\nइह कीर्तिं परां प्राप्य प्रेत्य स्वर्गमितो गताः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2210405, "chapter_id": 5500, "verse_number": "४", "content_sanskrit": "देवराजः सहस्राक्षः क्रतुभिर्भूरिदक्षिणैः ।\nदेवराज्यं महातेजाः प्राप्तवानखिलं विभुः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2210406, "chapter_id": 5500, "verse_number": "५", "content_sanskrit": "अतो युधिष्ठिरो राजा भीमार्जुनपुरःसरः ।\nसदृशो देवराजेन समृद्ध्या विक्रमेण च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2210407, "chapter_id": 5500, "verse_number": "६", "content_sanskrit": "अथ कस्मात् स नकुलो गर्हयामास तं नृपम् ।\nअश्वमेधं महायज्ञं राज्ञस्तस्य महात्मनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2210408, "chapter_id": 5500, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2210409, "chapter_id": 5500, "verse_number": "७", "content_sanskrit": "यज्ञस्य विधिमग्र्यं वै फलं चैव नरर्षभ ।\nगदतः शृणु मे राजन् यथावदिह भारत ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2210410, "chapter_id": 5500, "verse_number": "८", "content_sanskrit": "पुरा शक्रस्य यजतः सर्व ऊचुर्महर्षयः ।\nऋत्विक्षु कर्म कुर्वत्सु वितते यज्ञकर्मणि ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2210411, "chapter_id": 5500, "verse_number": "९", "content_sanskrit": "हूयमाने तथा वह्नौ होत्रे गुणसमन्विते ।\nदेवेष्वाहूयमानेषु स्थितेषु परमर्षिषु ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2210412, "chapter_id": 5500, "verse_number": "१०", "content_sanskrit": "सुव्रतैस्तैस्तदा विप्रैः स्वागमैः सुस्वरैर्नृप ।\nअश्रान्तैश्चापि लघुभिरध्वर्युवृषभैस्तथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2210413, "chapter_id": 5500, "verse_number": "११", "content_sanskrit": "आलम्भसमये तस्मिन् गृहीतेषु पशुष्वथ ।\nमहर्षयो महाराज सम्बभूवुः कृपान्विताः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2210414, "chapter_id": 5500, "verse_number": "१२", "content_sanskrit": "ततो दीनान् पशून् दृष्ट्वा ऋषयस्ते तपोधनाः ।\nऊचुः शक्रं समागम्य नायं यज्ञविधिः शुभः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2210415, "chapter_id": 5500, "verse_number": "१३", "content_sanskrit": "अपरिज्ञानमेतत् ते महान्तं धर्ममिच्छतः ।\nन हि यज्ञे पशुवधो विधिदृष्टः पुरन्दर ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2210416, "chapter_id": 5500, "verse_number": "१४", "content_sanskrit": "धर्मोपघातकस्त्वेष समारम्भस्तव प्रभो ।\nनायं धर्मकृते यज्ञो न हिंसा धर्म उच्यते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2210417, "chapter_id": 5500, "verse_number": "१५", "content_sanskrit": "आगमेनैव ते यज्ञं कुर्वन्तु यदिहेच्छसि ।\nविधिदृष्टेन यज्ञेन धर्मस्ते सुमहान् भवेत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2210418, "chapter_id": 5500, "verse_number": "१६", "content_sanskrit": "यज बीजैः सहस्राक्ष त्रिवर्षपरमोत्थितैः ।\nएष धर्मो महान् शक्र महागुणफलोदयः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2210419, "chapter_id": 5500, "verse_number": "१७", "content_sanskrit": "शतक्रतुस्तु तद् वाक्यमृषिभिस्तत्त्वदर्शिभिः ।\nउक्तं न प्रतिजग्राह मानमोहवशानुगः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2210420, "chapter_id": 5500, "verse_number": "१८", "content_sanskrit": "तेषां विवादः सुमहान् जज्ञे शक्रमहर्षिणाम् ।\nजङ्गमैः स्थावरैश्चापि यष्टव्यमिति भारत ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2210421, "chapter_id": 5500, "verse_number": "१९", "content_sanskrit": "ते तु खिन्ना विवादेन ऋषयस्तत्त्वदर्शिनः ।\nअभिसन्धाय शक्रेण पप्रच्छुर्नृपतिं वसुम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2210422, "chapter_id": 5500, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2210423, "chapter_id": 5500, "verse_number": "२०", "content_sanskrit": "महाप्राज्ञ कथं यज्ञेष्वागमो नृपते स्मृतः ।\nयष्टव्यं पशुभिर्मेध्यैरथो बीजैरजैरिति ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2210424, "chapter_id": 5500, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2210425, "chapter_id": 5500, "verse_number": "२१", "content_sanskrit": "तच्छ्रुत्वा तु वसुस्तेषामविचार्य बलाबलम् ।\nयथोपनीतैर्यष्टव्यमिति प्रोवाच पार्थिवः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2210426, "chapter_id": 5500, "verse_number": "२२", "content_sanskrit": "धर्मसंशयमापन्नान् सत्यं ब्रूहि महामते ।\nमहाभाग कथं यज्ञेष्वागमे नृपतिस्थिते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2210427, "chapter_id": 5500, "verse_number": "२३", "content_sanskrit": "एवमुक्ते स नृपतिः प्रविवेश रसातलम् ।\nउक्त्वेह वितथं राजन् चेदीनामीश्वरः प्रभुः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2210428, "chapter_id": 5500, "verse_number": "२४", "content_sanskrit": "अन्यायोपगतं द्रव्यं सततं योऽह्यपण्डितः ।\nधर्माभिकाङ्क्षी त्यजति न धर्मफलमश्नुते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2210429, "chapter_id": 5500, "verse_number": "२५", "content_sanskrit": "धर्मवैतंसिको ह्येष पापात्मा पुरुषाधमः ।\nददाति दानं विप्रेभ्यो लोके विश्वासकारकम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2210430, "chapter_id": 5500, "verse_number": "२६", "content_sanskrit": "पापेन कर्मणा विप्रो धनं लब्ध्वा निरङ्कुशः ।\nरागमोहान्वितः सोऽन्ते कलुषां गतिमश्नुते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2210431, "chapter_id": 5500, "verse_number": "२७", "content_sanskrit": "तेन दानानि दत्तानि पापेन हतबुद्धिना ।\nतानि सत्वमनासाद्य नश्यन्ति विपुलान्यपि ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2210432, "chapter_id": 5500, "verse_number": "२८", "content_sanskrit": "तस्याधर्मे प्रवृत्तस्य हिंसकस्य दुरात्मनः ।\nएतेनाकीर्तिर्भवति प्रेत्य चेह च दुर्मतेः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2210433, "chapter_id": 5500, "verse_number": "२९", "content_sanskrit": "अपि संशयबुद्धिर्हि लोभमोहवशानुगः ।\nयज्ञं करोति भूतानि हिंसयन् पापचेतनः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2210434, "chapter_id": 5500, "verse_number": "३०", "content_sanskrit": "एवं लब्ध्वा धनं मोहाद् यजते यो ददाति च ।\nस कृत्वा कर्मणा तेन न सिद्ध्यति दुरागमात् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2210435, "chapter_id": 5500, "verse_number": "३१", "content_sanskrit": "इच्छन् मूलं फलं शाकमुदपानं तपोवनम् ।\nदानं विभवतो दत्त्वा ततः स्वर्याति धार्मिकः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2210436, "chapter_id": 5500, "verse_number": "३२", "content_sanskrit": "एष धर्मो महापुण्यो दानं भूतदया तथा ।\nब्रह्मचर्यं तथा सत्यमनुक्रोशो धृतिः क्षमा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2210437, "chapter_id": 5500, "verse_number": "३३", "content_sanskrit": "सनातनस्य धर्मस्य फलमेतत् सनातनम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2210438, "chapter_id": 5500, "verse_number": "३४", "content_sanskrit": "श्रूयन्ते हि पुरा विप्रा विश्वामित्रादयो नृपाः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2210439, "chapter_id": 5500, "verse_number": "३५", "content_sanskrit": "विश्वामित्रोऽसितश्चैव जनकश्च महीपतिः ।\nकक्षसेनार्ष्टिषेणौ च सिन्धुद्वीपश्च पार्थिवः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2210440, "chapter_id": 5500, "verse_number": "३६", "content_sanskrit": "एते चान्ये च बहवः सिद्धिं परमिकां गताः ।\nनृपाः सत्यैश्च दानैश्च न्यायलब्धैस्तपोधनाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2210441, "chapter_id": 5500, "verse_number": "३७", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्याः शूद्रा ये चाश्रितास्तपः ।\nदानधर्माश्रिताः शुद्धास्ते स्वर्गं यान्ति भारत ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2210442, "chapter_id": 5500, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि दानधर्मतपःप्रशंसनं नाम चतुर्नवतितमोऽध्यायः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]