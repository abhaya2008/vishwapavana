[{"id": 2124717, "chapter_id": 3672, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2124718, "chapter_id": 3672, "verse_number": "१", "content_sanskrit": "वासुदेव महाबाहो विस्तरेण महामते ।\nसौभस्य वधमाचक्ष्व न हि तृप्यामि कथ्यताम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2124719, "chapter_id": 3672, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2124720, "chapter_id": 3672, "verse_number": "२", "content_sanskrit": "हतं श्रुत्वा महाबाहो मया श्रौतश्रवं नृपम् ।\nउपायाद् भरतश्रेष्ठ साल्वो द्वारवतीं पुरीम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2124721, "chapter_id": 3672, "verse_number": "३", "content_sanskrit": "अरुधत् तां सुदुष्टात्मा सर्वतः पाण्डुनन्दन ।\nसाल्वो वैहायसं चापि तत् पुरं व्यूह्य विष्ठितः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2124722, "chapter_id": 3672, "verse_number": "४", "content_sanskrit": "तत्र सोऽथ महीपालो योधयामास तां पुरीम् ।\nअभिसारेण सर्वेण तत्र युद्धमवर्तत \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2124723, "chapter_id": 3672, "verse_number": "५", "content_sanskrit": "पुरी समन्ताद् विहिता सपताका सतोरणा ।\nसचक्रा सहुळा चैव सयन्त्रखनका तथा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2124724, "chapter_id": 3672, "verse_number": "६", "content_sanskrit": "सोपतल्पप्रतोलीका साट्टाट्टालकगोपुरा ।\nसचक्रग्राहिणी चैव सोल्कालातावपोथिका \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2124725, "chapter_id": 3672, "verse_number": "७", "content_sanskrit": "सोष्टिका भरतश्रेष्ठ सभेरीपणवानका ।\nसोष्टिका साङ्कुशा राजन् सशतघ्नी सलाङ्गला\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2124726, "chapter_id": 3672, "verse_number": "८", "content_sanskrit": "ससुतूणी सासिधरा सायुधा सपरश्वधा ।\nलोहचर्मवती चापि साग्निः सहुलशृङ्गिका ।\nशास्त्रदृष्टेन विधिना सुयुक्ता भरतर्षभ \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2124727, "chapter_id": 3672, "verse_number": "९", "content_sanskrit": "द्रव्यैरनेकैर्विविधैर्गदसाम्बोद्धवादिभिः ।\nपुरुषै राजशार्दूल सरथैः परिपालिता \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2124728, "chapter_id": 3672, "verse_number": "१०", "content_sanskrit": "अभिज्ञातबलैर्वीरैर्दृष्टवीर्यैश्च संयुगे ।\nमध्यमेन च गुल्मेन रक्षिता सा पुरी तदा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2124729, "chapter_id": 3672, "verse_number": "११", "content_sanskrit": "उत्क्षिप्तगुल्मैश्च तथा हयैश्च सपताकिभिः ।\nआघोषितं च नगरे न पातव्या सुरेति ह \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2124730, "chapter_id": 3672, "verse_number": "१२", "content_sanskrit": "प्रमादं परिरक्षद्भिरुग्रसेनोद्धवादिभिः ।\nप्रमत्तेष्वभिघातं हि कुर्यात् साल्वो नराधिपः ।\nइति कृत्वाऽप्रमत्तास्ते सर्वे वृष्ण्यन्धकाः स्थिताः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2124731, "chapter_id": 3672, "verse_number": "१३", "content_sanskrit": "आनर्ताश्च तथा सर्वे नटनर्तकगायकाः ।\nबहिर्निर्वासिताः क्षिप्रं रक्षद्भिर्वित्तसञ्चयान्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2124732, "chapter_id": 3672, "verse_number": "१४", "content_sanskrit": "सङ्क्रमा भेदिताः सर्वे नावश्च प्रतिषेधिताः ।\nपरिघाश्चापि कौरव्य कीलकैश्चसुकीलिताः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2124733, "chapter_id": 3672, "verse_number": "१५", "content_sanskrit": "उदपानाः कुरुश्रेष्ठ तथा वाप्यः क्षतास्तथा ।\nसमन्तान् क्रोशमात्रं तु कारिता विषमा च भूः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2124734, "chapter_id": 3672, "verse_number": "१६", "content_sanskrit": "प्रकृत्या विषमं दुर्गं प्रकृत्या च सुरक्षितम् ।\nप्रकृत्या चायुधोपेतं विशेषेण तदाऽनघ\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2124735, "chapter_id": 3672, "verse_number": "१७", "content_sanskrit": "सुरक्षितं सुगुप्तं च सर्वायुधसमन्वितम् ।\nतत् पुरं भरतश्रेष्ठ यथेन्द्रभवनं तथा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2124736, "chapter_id": 3672, "verse_number": "१८", "content_sanskrit": "न चामुद्रोऽभिनिर्याति न चामुद्रः प्रवेश्यते ।\nवृष्ण्यन्धकपुरे राजन् तदा सौभसमागमे \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2124737, "chapter_id": 3672, "verse_number": "१९", "content_sanskrit": "अनुरथ्यासु सर्वासु चत्वरेषु च कौरव ।\nबलं बभूव राजेन्द्र प्रभूतगजवाजिमत् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2124738, "chapter_id": 3672, "verse_number": "२०", "content_sanskrit": "दत्तवेतनभक्तं च दत्तायुधपरिच्छदम् ।\nकृतापदानं च तदा बलमासीद् विशाम्पते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2124739, "chapter_id": 3672, "verse_number": "२१", "content_sanskrit": "न कोऽप्यवेतनः कश्चिन्न चातिक्रान्तवेतनः\nनानुग्रहभृतः कश्चिन्न चादृष्टपराक्रमः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2124740, "chapter_id": 3672, "verse_number": "२२", "content_sanskrit": "एवं सुविहिता राजन् द्वारका भूरिदक्षिणैः ।\nआहुकेन सुगुप्ता च राज्ञा राजीवलोचन\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2124741, "chapter_id": 3672, "verse_number": "२३", "content_sanskrit": "तत्रापयात्वा राजेन्द्र साल्वः सौभपतिस्तदा ।\nप्रभूतनरनागेन बलेनोपविवेश ह\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2124742, "chapter_id": 3672, "verse_number": "२४", "content_sanskrit": "समे निविष्टा सा सेना प्रभूतसलिलाशये ।\nचतुरङ्गबलोपेता साल्वराजाभिरक्षिता\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2124743, "chapter_id": 3672, "verse_number": "२५", "content_sanskrit": "वर्जयित्वा श्मशानानि देवतायतनानि च ।\nवल्मीकांश्चैव चैत्यांश्च सन्निविष्टमभूद् बलम् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2124744, "chapter_id": 3672, "verse_number": "२६", "content_sanskrit": "अनीकानां विधानेन पन्थानः संवृताभवन् ।\nप्रवणानि च सर्वाणि साल्वस्य शिबिरे नृप\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2124745, "chapter_id": 3672, "verse_number": "२७", "content_sanskrit": "सर्वायुधसमोपेतं सर्वशस्त्रविशारदम् ।\nरथनागाश्वकलिलं पदातिध्वजसङ्कुलम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2124746, "chapter_id": 3672, "verse_number": "२८", "content_sanskrit": "तुष्टपुष्टजनोपेतं वीरलक्षणलक्षितम् ।\nविचित्रध्वजसन्नाहं विचित्ररथकार्मुकम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2124747, "chapter_id": 3672, "verse_number": "२९", "content_sanskrit": "संनिवेश्य तु कौरव्य द्वारकायां नरर्षभ ।\nअभिसारयामास तदा वेगेन पतगेन्द्रवत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2124748, "chapter_id": 3672, "verse_number": "३०", "content_sanskrit": "तदापतत्तु संदृश्य बलं साल्वपतेस्तदा ।\nनिर्याय योधयामासुः कुमारा वृष्णिनन्दनाः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2124749, "chapter_id": 3672, "verse_number": "३१", "content_sanskrit": "असहन्तोऽभियानं तत् साल्वराजेन कौरव ।\nचारुदेष्णश्च साम्बश्च प्रद्युम्नश्च महारथः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2124750, "chapter_id": 3672, "verse_number": "३२", "content_sanskrit": "ते रथैर्दंशिताः सर्वे विचित्राभरणध्वजाः ।\nसंसक्ताः साल्वराजस्य बहुभिर्योधपुङ्गवैः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2124751, "chapter_id": 3672, "verse_number": "३३", "content_sanskrit": "गृहीत्वा तु धनुः साम्बः साल्वस्य सचिवं रणे ।\nयोधयामास संहृष्टः क्षेमधूर्तिं चमूपतिम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2124752, "chapter_id": 3672, "verse_number": "३४", "content_sanskrit": "तस्य बाणमयं वर्षं जाम्बवत्याः सुतो महत् ।\nमुमोच भरतश्रेष्ठ यथा वर्षं सहस्रदृक् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2124753, "chapter_id": 3672, "verse_number": "३५", "content_sanskrit": "तद्बाणवर्षं तुमुलं विषेहे स चमूपतिः ।\nक्षेमधूर्तिर्महाराज हिमवानिव निश्चलः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2124754, "chapter_id": 3672, "verse_number": "३६", "content_sanskrit": "ततः साम्बाय राजेन्द्र क्षेमधूर्तिरपि स्म ह ।\nमुमोच मायाविहितं शरजालं महत्तरम् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2124755, "chapter_id": 3672, "verse_number": "३७", "content_sanskrit": "ततो मायामयं जालं माययैव विदार्य सः ।\nसाम्बः शरसहस्रेण रथमस्याभ्यवर्षत\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2124756, "chapter_id": 3672, "verse_number": "३८", "content_sanskrit": "ततः स विद्धः साम्बेन क्षेमधूर्तिश्चमूपतिः ।\nअपायाज्जवनैरश्वैः साम्बबाणप्रपीडितः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2124757, "chapter_id": 3672, "verse_number": "३९", "content_sanskrit": "तस्मिन् विप्रद्रुते शूरे साल्वस्याथ चमूपतौ ।\nवेगवान् नाम दैतेयः सुतं मेऽभ्यद्रवद् बली\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2124758, "chapter_id": 3672, "verse_number": "४०", "content_sanskrit": "अभिद्रुतस्तु राजेन्द्र साम्बो वृष्णिकुलोद्वहः ।\nवेगं वेगवतो राजन् तस्थौ वीरो विधारयन्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2124759, "chapter_id": 3672, "verse_number": "४१", "content_sanskrit": "स वेगवति कौन्तेय साम्बो वेगवतीं गदाम् ।\nचिक्षेप तरसा वीरो व्याविद्ध्यत् सत्यविक्रमः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2124760, "chapter_id": 3672, "verse_number": "४२", "content_sanskrit": "तया त्वभिहतो राजन् वेगवान् न्यपतद् भुवि ।\nवातरुग्ण इव क्षुण्णः शीर्णमूलो वनस्पतिः \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2124761, "chapter_id": 3672, "verse_number": "४३", "content_sanskrit": "तस्मिन् निपतिते वीरे गदया दानवाधमे ।\nप्रविश्य महतीं सेनां योधयामास मे सुतः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2124762, "chapter_id": 3672, "verse_number": "४४", "content_sanskrit": "चारुदेष्णेन संसक्तो विविन्ध्यो नाम दानवः ।\nमहारथः समाज्ञातो महाराज महाधनुः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2124763, "chapter_id": 3672, "verse_number": "४५", "content_sanskrit": "ततः सुतुमुलं युद्धं चारुदेष्णविविन्ध्ययोः ।\nवृत्रवासवयो राजन् यथापूर्वं तथाऽभवत् \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2124764, "chapter_id": 3672, "verse_number": "४६", "content_sanskrit": "अन्योन्यस्याभिसङ्क्रुद्धावन्योन्यं जघ्नतुः शरैः ।\nविनदन्तौ महाराज सिंहाविव महाबलौ\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2124765, "chapter_id": 3672, "verse_number": "४७", "content_sanskrit": "रौग्मिणेयस्ततो बाणमग्न्यर्कोपमवर्चसम् ।\nअभिमन्त्र्य महास्त्रेण सन्दधे शत्रुनाशनम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2124766, "chapter_id": 3672, "verse_number": "४८", "content_sanskrit": "स विविन्ध्याय सक्रोधः समाहूय महारथः ।\nचिक्षेप मे सुतो राजन् स गतासुरवापतत्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2124767, "chapter_id": 3672, "verse_number": "४९", "content_sanskrit": "विविन्ध्यं निहतं दृष्ट्वा तां च विक्षोभितां चमूम् ।\nकामगेन स सौभेन साल्वः पुनरुपागमत्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2124768, "chapter_id": 3672, "verse_number": "५०", "content_sanskrit": "ततो व्याकुलितं सर्वं द्वारकावासितं बलम् ।\nदृष्ट्वा साल्वं महाबाहो सौभस्थं भूपतिं तदा\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2124769, "chapter_id": 3672, "verse_number": "५१", "content_sanskrit": "ततो निर्याय कौन्तेय व्यवस्थाप्य च तद्बलम् ।\nआनर्तानां महाराज प्रद्युम्नो वाक्यमब्रवीत् \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2124770, "chapter_id": 3672, "verse_number": "५२", "content_sanskrit": "सर्वे भवन्तस्तिष्ठन्तु सर्वे पश्यन्तु मां युधि ।\nनिवारयन्तं सङ्ग्रामे बलात् सौभं सराजकम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2124771, "chapter_id": 3672, "verse_number": "५३", "content_sanskrit": "अयं सौभपतेः सेनामायसैर्भुजगोपमैः ।\nधनुर्मुक्तैश्च नाराचैर्नाशयाम्यद्य यादवाः \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2124772, "chapter_id": 3672, "verse_number": "५४", "content_sanskrit": "आश्वसध्वं न भीः कार्या सौभराडद्य नश्यति ।\nमयाऽभिपन्नो दुष्टात्मा ससौभः स पदानुगः \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2124773, "chapter_id": 3672, "verse_number": "५५", "content_sanskrit": "एवं ब्रुवति संहृष्टे प्रद्युम्ने पाण्डुनन्दन ।\nविष्ठितं तद्बलं द्वारि युयुधे च यथासुखम् \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2124774, "chapter_id": 3672, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां वनपर्वणि चतुर्दशोऽध्यायः ॥१४॥\n॥ कैरातपर्वणि चतुर्थोऽध्यायः ॥४॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]