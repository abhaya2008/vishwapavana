[{"id": 5000190000, "chapter_id": 9190, "verse_number": "२-११३-१", "content_sanskrit": "तत: शिरसि कृत्वा तु पादुके भरतस्तदा ।\nआरुरोह रथं हृष्ट: शत्रुघ्नेन समन्वित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000190001, "chapter_id": 9190, "verse_number": "२-११३-२", "content_sanskrit": "वसिष्ऺठो वामदेवश्च जाबालिश्च दृढव्रत: ।\nअग्रत: प्रययु: सर्वे मन्त्रिणो मन्त्रपूजिता: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000190002, "chapter_id": 9190, "verse_number": "२-११३-३", "content_sanskrit": "मन्दाकिनीं नदीं रम्यां प्राङ्मुखास्ते ययुस्तदा ।\nप्रदक्षिणं च कुर्वाणाश्चित्रकूटं महागिरिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000190003, "chapter_id": 9190, "verse_number": "२-११३-४", "content_sanskrit": "पश्यन् धातुसहस्राणि रम्याणि विविधानि च ।\nप्रययौ तस्य पार्श्वेन ससैन्यो भरतस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000190004, "chapter_id": 9190, "verse_number": "२-११३-५", "content_sanskrit": "अदूराच्चित्रकूटस्य ददर्श भरतस्तदा ।\nआश्रमं यत्र स मुनिर्भरद्वाज: कृतालय: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000190005, "chapter_id": 9190, "verse_number": "२-११३-६", "content_sanskrit": "स तमाश्रममागम्य भरद्वाजस्य बुद्धिमान् ।\nअवतीर्य रथात् पादौ ववन्दे भरतस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000190006, "chapter_id": 9190, "verse_number": "२-११३-७", "content_sanskrit": "ततो हृष्टो भरद्वाजो भरतं वाक्यमब्रवीत् ।\nअपि कृत्यं कृतं तात रामेण च समागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000190007, "chapter_id": 9190, "verse_number": "२-११३-८", "content_sanskrit": "एवमुक्त: स तु ततो भरद्वाजेन धीमता ।\nप्रत्युवाच भरद्वाजं भरतो भ्रातृवत्सल: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000190008, "chapter_id": 9190, "verse_number": "२-११३-९", "content_sanskrit": "स याच्यमानो गुरुणा मया च दृढविक्रम: ।\nराघव: परमप्रीतो वसिष्ठं वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000190009, "chapter_id": 9190, "verse_number": "२-११३-१०", "content_sanskrit": "पितु: प्रतिज्ञां तामेव पालयिष्यामि तत्त्वत: ।\nचतुर्दश हि वर्षाणि या प्रतिज्ञा पितुर्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000190010, "chapter_id": 9190, "verse_number": "२-११३-११", "content_sanskrit": "एवमुक्तो महाप्राज्ञो वसिष्ठ: प्रत्युवाच ह ।\nवाक्यज्ञो वाक्यकुशलं राघवं वचनं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000190011, "chapter_id": 9190, "verse_number": "२-११३-१२", "content_sanskrit": "एते प्रयच्छ संहृष्ट: पादुके हेमभूषिते ।\nअयोध्यायां महाप्राज्ञ योगक्षेमकरे तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000190012, "chapter_id": 9190, "verse_number": "२-११३-१३", "content_sanskrit": "एवमुक्तो वसिष्ठेन राघव: प्राङ्मुख: स्थित: ।\nपादुके अधिरुह्यैते मम राज्याय वै ददौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000190013, "chapter_id": 9190, "verse_number": "२-११३-१४", "content_sanskrit": "निवृत्तो ऽहमनुज्ञातो रामेण सुमहात्मना ।\nअयोध्यामेव गच्छामि गृहीत्वा पादुके शुभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000190014, "chapter_id": 9190, "verse_number": "२-११३-१५", "content_sanskrit": "एतच्छ्रुत्वा शुभं वाक्यं भरतस्य महात्मन: ।\nभरद्वाज: शुभतरं मुनिर्वाक्यमुवाच तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000190015, "chapter_id": 9190, "verse_number": "२-११३-१६", "content_sanskrit": "नैतच्चित्रं नरव्याघ्र शीलवृत्तवतां वर ।\nयदार्यं त्वयि तिष्ठेत्तु निम्ने सृष्टमिवोदकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000190016, "chapter_id": 9190, "verse_number": "२-११३-१७", "content_sanskrit": "अमृत: स महाबाहु: पिता दशरथस्तव ।\nयस्य त्वमीदृश: पुत्रो धर्मज्ञो धर्मवत्सल: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000190017, "chapter_id": 9190, "verse_number": "२-११३-१८", "content_sanskrit": "तमृषिं तु महात्मानमुक्तवाक्यं कृताञ्जलि: ।\nआमतन्त्रयितुमारेभे चरणावुपगृह्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000190018, "chapter_id": 9190, "verse_number": "२-११३-१९", "content_sanskrit": "तत: प्रदक्षिणं कृत्वा भरद्वाजं पुन:पुन: ।\nभरतस्तु ययौ श्रीमानयोध्यां सह मन्त्रिभि: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000190019, "chapter_id": 9190, "verse_number": "२-११३-२०", "content_sanskrit": "यानैश्च शकटैश्चैव हयैर्नागैश्च सा चमू: ।\nपुनर्निवृत्ता विस्तीर्णा भरतस्यानुयायिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000190020, "chapter_id": 9190, "verse_number": "२-११३-२१", "content_sanskrit": "ततस्ते यमुनां दिव्यां नदीं तीर्त्वोर्मिमालिनीम् ।\nददृशुस्तां पुन: सर्वे गङ्गां शुभजलां नदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000190021, "chapter_id": 9190, "verse_number": "२-११३-२२", "content_sanskrit": "तां रम्यजलसम्पूर्णां सन्तीर्य सहबान्धव: ।\nशृङ्गिबेरपुरं रम्यं प्रविवेश ससैनिक: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000190022, "chapter_id": 9190, "verse_number": "२-११३-२३", "content_sanskrit": "शृङ्गिबेरपुराद्भूयस्त्वयोध्यां संददर्श ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000190023, "chapter_id": 9190, "verse_number": "२-११३-२४", "content_sanskrit": "अयोध्यां च ततो दृष्ट्वा पित्रा भ्रात्रा विवर्जिताम् ।\nभरतो दु:खसन्तप्त: सारथिं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000190024, "chapter_id": 9190, "verse_number": "२-११३-२५", "content_sanskrit": "सारथे पश्य विध्वस्ता सायोध्या न प्रकाशते ।\nनिराकारा निरानन्दा दीना प्रतिहतस्वरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000190025, "chapter_id": 9190, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदयोध्याकाण्डे त्रयोदशोत्तरशततम: सर्ग: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]