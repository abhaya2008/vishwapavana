[{"id": 40014154, "chapter_id": 9190, "verse_number": "1", "content_sanskrit": "तंतुशोकपरिद्यूनंरामंदशरथात्मजम् । उवाचवचनंश्रीमान् सुग्रीवश्शोकनाशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40014155, "chapter_id": 9190, "verse_number": "2", "content_sanskrit": "किंत्वंसन्तप्यसेवीर यथान्यःप्राकृतस्तथा । मैवंभूस्त्यजसन्तापंकृतघ्नइवसौहृदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40014156, "chapter_id": 9190, "verse_number": "3", "content_sanskrit": "सन्तापस्यचतेस्थानंनहिपश्यामिराघव । प्रवृत्तावुपलब्धायांज्ञातेचनिलयेरिपोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40014157, "chapter_id": 9190, "verse_number": "4", "content_sanskrit": "मतिमान्शास्त्रवित्प्राज्ञःपण्डितश्चासिराघव । त्यजेमांपापिकांबुद्धिंकृतात्मेवार्थदूषणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40014158, "chapter_id": 9190, "verse_number": "5", "content_sanskrit": "समुद्रंलङ्घयित्वातुमहानक्रसमाकुलम् । लङ्कामारोहयिष्यामोहनिष्यामश्चतेरिपुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40014159, "chapter_id": 9190, "verse_number": "6", "content_sanskrit": "निरुत्साहस्यदीनस्यशोकपर्याकुलात्मनः । सर्वार्थाव्यवसीदन्तिव्यसनंचाधिगच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40014160, "chapter_id": 9190, "verse_number": "7", "content_sanskrit": "इमेशूरास्समर्थाश्चसर्वनोहरियूथपाः । त्वत्प्रियार्थंकृतोत्साहाःप्रवेष्टुमपिपावकम् । एषांहर्षेणजानामितर्कश्चास्मिन् दृढोमम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40014161, "chapter_id": 9190, "verse_number": "8", "content_sanskrit": "विक्रमेणसमानेष्येसीतांहत्वायथारिपुम् । रावणंपापकर्माणंतथात्वंकर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40014162, "chapter_id": 9190, "verse_number": "9", "content_sanskrit": "सेतुरत्रयथाबध्येद्यथापश्येमतांपुरीम् । तस्यराक्षसराजस्यतथात्वंकुरुराघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40014163, "chapter_id": 9190, "verse_number": "10", "content_sanskrit": "दृष्टवातांतुपुरींलङ्कांत्रिकूटशिखरेस्थिताम् । हतंचरावणंयुद्धेदर्शनावधारय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40014164, "chapter_id": 9190, "verse_number": "11", "content_sanskrit": "अबध्वासागरेसेतुंघोरेचतुवरुणालये । लङ्कांनमर्दितुंशक्यासेन्द्रैरपिसुरासुरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40014165, "chapter_id": 9190, "verse_number": "12", "content_sanskrit": "सेतुर्बद्धस्समुद्रेचयावल्लङ्कास्समीपतः ॥ सर्वंतीर्णंचमेसैन्यंजितमित्युपधारय । इमेहिसमरेवीराहरयःकामरूपिण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40014166, "chapter_id": 9190, "verse_number": "13", "content_sanskrit": "सेतुर्बद्धस्समुद्रेचयावल्लङ्कास्समीपतः ॥ सर्वंतीर्णंचमेसैन्यंजितमित्युपधारय । इमेहिसमरेवीराहरयःकामरूपिण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40014167, "chapter_id": 9190, "verse_number": "14", "content_sanskrit": "तदलंविक्लबांबुद्धिम् राजन सर्वार्थनाशनीम् । पुरुषस्यहिलोकेऽस्मिन् शोकश्शौर्यापकर्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40014168, "chapter_id": 9190, "verse_number": "15", "content_sanskrit": "यत्तुकार्यंमनुष्येणशौण्डीर्यमवलम्बता । अस्मिन् कालेमहाप्राज्ञसत्त्वमातिष्ठतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40014169, "chapter_id": 9190, "verse_number": "16", "content_sanskrit": "शूराणांहिमनुष्याणांत्वद्विधानांमहात्मनाम् । विनष्टेवाप्रणष्टेवाशोकस्सर्वार्थनाशनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40014170, "chapter_id": 9190, "verse_number": "17", "content_sanskrit": "तत्त्वंबुद्धिमतांश्रेष्ठस्सर्वशास्त्रार्थकोविदः । मद्विधैस्सचिवैस्सार्थमरिंजेतुमिहार्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40014171, "chapter_id": 9190, "verse_number": "18", "content_sanskrit": "नहिपश्याम्यहंकंचित् त्रिषुलोकेषुराघव । गृहीतधनुषेयस्तेतिष्ठेदभिमुखोरणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40014172, "chapter_id": 9190, "verse_number": "19", "content_sanskrit": "वानरेषुसमासक्तंनतेकार्यंविपत्स्यते । अचिराद्द्रक्ष्यसेसीतांतीर्त्वासागरमक्ष्यम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40014173, "chapter_id": 9190, "verse_number": "20", "content_sanskrit": "तदलंशोकमालम्ब्यक्रोधमालम्बभूपते । निश्चेष्टाःक्षत्रियामन्दास्सर्वेचण्डस्यबिभ्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40014174, "chapter_id": 9190, "verse_number": "21", "content_sanskrit": "लङ्घनार्थंचघोरस्यसमुद्रस्यनदींपतेः । सहास्माभिरिहोपेतस्सूक्ष्मबुद्धिर्विचारय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40014175, "chapter_id": 9190, "verse_number": "22", "content_sanskrit": "लङ्घितेतस्यतैस्सैन्यंजितमित्युपधारय । सर्वंतीर्णंचमेसैन्यंजितमित्यवधार्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40014176, "chapter_id": 9190, "verse_number": "23", "content_sanskrit": "इमेहिहरयश्शूरास्समरेकामरूपिणः । तानरीन्विधमिष्यन्तिशिलापादपवृष्टिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40014177, "chapter_id": 9190, "verse_number": "24", "content_sanskrit": "कथञ्चित्सन्तरिष्यामस्तेवयंवरुणालयम् । हतमित्येवतंमन्येयुद्धेशत्रुनिबर्हण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40014178, "chapter_id": 9190, "verse_number": "25", "content_sanskrit": "किमुक्त्वाबहुधाचापिसर्वथाविजयीभवान् । निमित्तानिचपश्यामिमनोमेसम्प्रहृष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]