[{"id": 2209620, "chapter_id": 5482, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2209621, "chapter_id": 5482, "verse_number": "१", "content_sanskrit": "एवं त्रिरात्रमभवत् तद्युद्धं भरतर्षभ ।\nअर्जुनस्य नरेन्द्रेण वृत्रेणेव शतक्रतोः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2209622, "chapter_id": 5482, "verse_number": "२", "content_sanskrit": "ततश्चतुर्थे दिवसे वज्रदत्तो महाबलः ।\nजहास सस्वनं हासं वाक्यं चेदमथाब्रवीत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2209623, "chapter_id": 5482, "verse_number": "", "content_sanskrit": "वज्रदत्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2209624, "chapter_id": 5482, "verse_number": "३", "content_sanskrit": "अर्जुनार्जुन तिष्ठ त्वं न मे जीवन् विमोक्ष्यसे ।\nत्वां निहत्य करिष्यामि पितुस्तोयं यथाविधि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2209625, "chapter_id": 5482, "verse_number": "४", "content_sanskrit": "त्वया वृद्धो मम पिता भगदत्तः पितुः सखा ।\nहतो वृद्धोऽपचायित्वा शिशुं मामद्य योधय ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2209626, "chapter_id": 5482, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2209627, "chapter_id": 5482, "verse_number": "५", "content_sanskrit": "इत्येवमुक्त्वा सङ्क्रुद्धो वज्रदत्तो नराधिपः ।\nप्रेषयामास कौरव्य वारणं पाण्डवं प्रति ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2209628, "chapter_id": 5482, "verse_number": "६", "content_sanskrit": "स प्रेष्यमाणो नागेन्द्रो वज्रदत्तेन धीमता ।\nउत्पतिष्यन्निवाकाशे ह्यभिदुद्राव पाण्डवम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2209629, "chapter_id": 5482, "verse_number": "७", "content_sanskrit": "अग्रहस्तप्रयुक्तेन शीकरेण स फल्गुनम् ।\nसमुक्षत महाराज शैलं नील इवाम्बुदः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2209630, "chapter_id": 5482, "verse_number": "८", "content_sanskrit": "स तेन प्रेषितो राज्ञा मेघवद् विनदन् मुहुः ।\nमुखाडम्बरघोषेण समाद्रवत फल्गुनम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2209631, "chapter_id": 5482, "verse_number": "९", "content_sanskrit": "स नृत्यन्निव नागेन्द्रो वज्रदत्तप्रचोदितः ।\nआससाद द्रुतं राजन् कौरवाणां महारथम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2209632, "chapter_id": 5482, "verse_number": "१०", "content_sanskrit": "तमापतन्तं सम्प्रेक्ष्य वज्रदत्तस्य वारणम् ।\nगाण्डीवमाश्रित्य बली न ह्यकम्पत शत्रुहा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2209633, "chapter_id": 5482, "verse_number": "११", "content_sanskrit": "चुक्रोध बलवच्चापि पाण्डवस्तस्य भूपतेः ।\nकार्यविघ्नमनुस्मृत्य पूर्ववैरं च भारत ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2209634, "chapter_id": 5482, "verse_number": "१२", "content_sanskrit": "ततस्तु वारणं क्रुद्धः शरजालेन पाण्डवः ।\nनिवारयामास तदा वेलेव मकरालयम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2209635, "chapter_id": 5482, "verse_number": "१३", "content_sanskrit": "स नागप्रवरो वीर्याद् अर्जुनेन निवारितः ।\nतस्थौ शरैर्विनुन्नाङ्गः श्वाविच्छललितो यथा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2209636, "chapter_id": 5482, "verse_number": "१४", "content_sanskrit": "निवारितं गजं दृष्ट्वा भगदत्तात्मजो नृपः ।\nउत्ससर्ज शितान् बाणान् अर्जुने क्रोधमूर्च्छितः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2209637, "chapter_id": 5482, "verse_number": "१५", "content_sanskrit": "अर्जुनस्तु महाराजः शरैः शरविघातिभिः ।\nवारयामास तान् बाणान् तदद्भुतमिवाभवत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2209638, "chapter_id": 5482, "verse_number": "१६", "content_sanskrit": "ततः पुनरपि क्रुद्धो राजा प्राग्ज्योतिषाधिपः ।\nप्रेषयामास नागेन्द्रं बलवत् पर्वतोपमम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2209639, "chapter_id": 5482, "verse_number": "१७", "content_sanskrit": "तमापतन्तं सम्प्रेक्ष्य बलवान् पाकशासनिः ।\nनाराचमग्निसङ्काशं प्राहिणोद् वारणं प्रति ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2209640, "chapter_id": 5482, "verse_number": "१८", "content_sanskrit": "तेन तद्वारणो राजन् मर्मण्यभिहतो भृशम् ।\nपपात भूमौ सहसा वज्राहत इवाचलः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2209641, "chapter_id": 5482, "verse_number": "१९", "content_sanskrit": "स पतन् शुशुभे नागो धनञ्जयशराहतः ।\nविशन्निव महाशैलो महीं वज्रप्रपीडितः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2209642, "chapter_id": 5482, "verse_number": "२०", "content_sanskrit": "तस्मिन् निपतिते नागे वज्रदत्तस्य पाण्डवः ।\nतं न भेतव्यमित्याह ततो भूमिगतं नृपम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2209643, "chapter_id": 5482, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2209644, "chapter_id": 5482, "verse_number": "२१", "content_sanskrit": "अब्रवीच्च महातेजाः प्रस्थितं मां युधिष्ठिरः ।\nराजानस्ते न हन्तव्याः तान् मोचय कथञ्चन ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2209645, "chapter_id": 5482, "verse_number": "२२", "content_sanskrit": "सर्वमेतन्नरव्याघ्र भवत्वेतावता कृतम् ।\nयोधाश्चापि न हन्तव्या कथञ्चन रणे त्वया ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2209646, "chapter_id": 5482, "verse_number": "२३", "content_sanskrit": "वक्तव्याश्चापि राजानः सर्वैः सह सुहृज्जनैः ।\nयुधिष्ठिरस्याश्वमेधो भवद्भिरनुभूयताम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2209647, "chapter_id": 5482, "verse_number": "समाप्तिः", "content_sanskrit": "इति भ्रातृवचः श्रुत्वा न हन्मि त्वां नराधिप ।\nउत्तिष्ठ न भयं तेऽस्ति स्वस्तिमान् भव पार्थिव ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2209648, "chapter_id": 5482, "verse_number": "२५", "content_sanskrit": "आगच्छेस्त्वं महाराज परां चैत्रीमुपस्थिताम् ।\nतदाऽश्वमेधो भविता धर्मराजस्य धीमतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2209649, "chapter_id": 5482, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2209650, "chapter_id": 5482, "verse_number": "२६", "content_sanskrit": "एवमुक्तः स राजा तु भगदत्तात्मजस्तदा ।\nतथेत्येवाब्रवीद् वाक्यं पाण्डवेनाभिनिर्जितः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2209651, "chapter_id": 5482, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अश्वसम्भरणे वज्रदत्तविसर्जनं नाम षट्सप्ततितमोऽध्यायः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]