[{"id": 7006344000, "chapter_id": 26344, "verse_number": "१-५४-१", "content_sanskrit": "वैशम्पायन उवाच कृतकार्ये गते काले जगत्यां च यथानयम् ।\nअंशावतरणे वृत्ते सुराणां भारते कुले ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006344001, "chapter_id": 26344, "verse_number": "१-५४-२", "content_sanskrit": "भागेऽवतीर्णे धर्मस्य शक्रस्य पवनस्य च ।\nअश्विनोर्देवभिषजोर्भागे वै भास्करस्य च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006344002, "chapter_id": 26344, "verse_number": "१-५४-३", "content_sanskrit": "पूर्वमेवावनिगते भागे देवपुरोधसः ।\nवसूनामष्टमे भागे प्रागेव धरणीं गते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006344003, "chapter_id": 26344, "verse_number": "१-५४-४", "content_sanskrit": "मृत्योर्भागे क्षितिगते कलेर्भागे तथैव च ।\nभागे शुक्रस्य सोमस्य वरुणस्य च गां गते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006344004, "chapter_id": 26344, "verse_number": "१-५४-५", "content_sanskrit": "शङ्करस्य गते भागे मित्रस्य धनदस्य च ।\nगन्धर्वोरगयक्षाणां भागांशेषु गतेषु च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006344005, "chapter_id": 26344, "verse_number": "१-५४-६", "content_sanskrit": "भागेष्वेतेषु गगनादवतीर्णेषु मेदिनीम् ।\nतिष्ठन्नारायणस्यांशे नारदः समदृश्यत ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006344006, "chapter_id": 26344, "verse_number": "१-५४-७", "content_sanskrit": "ज्वलिताग्निप्रतीकाशो बालार्कसदृशेक्षणः ।\nसव्यापवृत्तं विपुलं जटामण्डलमुद्वहन् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006344007, "chapter_id": 26344, "verse_number": "१-५४-८", "content_sanskrit": "चन्द्रांशुशुक्ले वसने वसानो रुक्मभूषितः ।\nवीणां गृहीत्वा महतीं कक्षासक्तां सखीमिव ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006344008, "chapter_id": 26344, "verse_number": "१-५४-९", "content_sanskrit": "कृष्णाजिनोत्तरासङ्गो हेमयज्ञोपवीतवान् ।\nदण्डी कमण्डलुधरः साक्षाच्छक्र इवापरः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006344009, "chapter_id": 26344, "verse_number": "१-५४-१०", "content_sanskrit": "भेत्ता जगति गुह्यानां विग्रहाणां ग्रहोपमः ।\nगाता चतुर्णां वेदानामुद्गाता प्रथमर्त्विजाम् ।\nमहर्षिर्विग्रहरुचिर्विद्वान् गान्धर्वकोविदः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006344010, "chapter_id": 26344, "verse_number": "१-५४-११", "content_sanskrit": "वैरिकेलिकिलो विप्रो ब्राह्मः कलिरिवापरः ।\nदेवगन्धर्वलोकानामादिवक्ता महामुनिः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006344011, "chapter_id": 26344, "verse_number": "१-५४-१२", "content_sanskrit": "स नारदोऽथ ब्रह्मर्षिर्ब्रह्मलोकचरोऽव्ययः ।\nस्थितो देवसभामध्ये संरब्धो विष्णुमब्रवीत् ॥१२", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006344012, "chapter_id": 26344, "verse_number": "१-५४-१३", "content_sanskrit": "अंशावतरणं विष्णो यदिदं त्रिदशैः कृतम् ।\nक्षयार्थे पृथिवीन्द्राणां सर्वमेतदकारणम्     ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006344013, "chapter_id": 26344, "verse_number": "१-५४-१४", "content_sanskrit": "यदेतत् पार्थिवं क्षत्रं स्थितं त्वयि यदीश्वर ।\nनृनारायणयुक्तोऽयं कार्यार्थः प्रतिभाति मे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006344014, "chapter_id": 26344, "verse_number": "१-५४-१५", "content_sanskrit": "न युक्तं जानता देव त्वया तत्त्वार्थदर्शिना ।\nदेवदेव पृथिव्यर्थे प्रयोक्तुं कार्यमीदृशम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006344015, "chapter_id": 26344, "verse_number": "१-५४-१६", "content_sanskrit": "त्वं हि चक्षुष्मतां चक्षुः श्लाघ्यः प्रभवतां प्रभुः ।\nश्रेष्ठो योगवतां योगी गतिर्गतिमतामपि ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006344016, "chapter_id": 26344, "verse_number": "१-५४-१७", "content_sanskrit": "देवभागान् गतान्दृष्ट्वा किं त्वं सर्वाश्रयो विभुः ।\nवसुन्धरायाः साह्यार्थमंशं स्वं नानुयुञ्जसे ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006344017, "chapter_id": 26344, "verse_number": "१-५४-१८", "content_sanskrit": "त्वया सनाथा देवांशास्त्वन्मयास्त्वत्परायणाः ।\nजगत्यां संचरिष्यन्ति कार्यात् कार्यान्तरं गताः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006344018, "chapter_id": 26344, "verse_number": "१-५४-१९", "content_sanskrit": "तदहं त्वरया विष्णो प्राप्तः सुरसभामिमाम् ।\nतव संचोदनार्थं वै शृणु चाप्यत्र कारणम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006344019, "chapter_id": 26344, "verse_number": "१-५४-२०", "content_sanskrit": "ये त्वया निहता दैत्याः संग्रामे तारकामये ।\nतेषां शृणु गतिं विष्णो ये गताः पृथिवीतलम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006344020, "chapter_id": 26344, "verse_number": "१-५४-२१", "content_sanskrit": "पुरी पृथिव्यां मुदिता मथुरानामतः श्रुता ।\nनिविष्टा यमुनातीरे स्फीता जनपदायुता ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006344021, "chapter_id": 26344, "verse_number": "१-५४-२२", "content_sanskrit": "मधुर्नाम महानासीद् दानवो युधि दुर्जयः ।\nत्रासनः सर्वभूतानां बलेन महतान्वितः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006344022, "chapter_id": 26344, "verse_number": "१-५४-२३", "content_sanskrit": "तस्य तत्र महच्चासीन्महापादपसंकुलम् ।\nघोरं मधुवनं नाम यत्रासौ न्यवसत् पुरा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006344023, "chapter_id": 26344, "verse_number": "१-५४-२४", "content_sanskrit": "तस्य पुत्रो महानासील्लवणो नाम दानवः ।\nत्रासनः सर्वभूतानां महाबलपराक्रमः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006344024, "chapter_id": 26344, "verse_number": "१-५४-२५", "content_sanskrit": "स तत्र दानवः क्रीडन् वर्षपूगाननेकशः ।\nस दैवतगणाँल्लोकानुद्वासयति दर्पितः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006344025, "chapter_id": 26344, "verse_number": "१-५४-२६", "content_sanskrit": "अयोध्यायामयोध्यायां रामे दाशरथौ स्थिते ।\nराज्यं शासति धर्मज्ञे राक्षसानां भयावहे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006344026, "chapter_id": 26344, "verse_number": "१-५४-२७", "content_sanskrit": "स दानवो बलश्लाघी घोरं वनमुपाश्रितः ।\nप्रेषयामास रामाय दूतं प्ररुषवादिनम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006344027, "chapter_id": 26344, "verse_number": "१-५४-२८", "content_sanskrit": "विषयासन्नभूतोऽस्मि तव राम रिपुश्च ह ।\nन च सामन्तमिच्छन्ति राजानो बलदर्पितम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006344028, "chapter_id": 26344, "verse_number": "१-५४-२९", "content_sanskrit": "राज्ञा राज्यव्रतस्थेन प्रजानां हितकाम्यया ।\nजेतव्या रिपवः सर्वे स्फीतं विषयमिच्छता ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006344029, "chapter_id": 26344, "verse_number": "१-५४-३०", "content_sanskrit": "अभिषेकार्द्रकेशेन राज्ञा रञ्जनकाम्यया ।\nजेतव्यानीन्द्रियाण्यादौ तज्जये हि ध्रुवो जयः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006344030, "chapter_id": 26344, "verse_number": "१-५४-३१", "content_sanskrit": "सम्यग् वर्तितुकामस्य विशेषेण महीपतेः ।\nनयानामुपदेशेन नास्ति लोकसमो गुरुः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006344031, "chapter_id": 26344, "verse_number": "१-५४-३२", "content_sanskrit": "व्यसनेषु जघन्यस्य धर्ममध्यस्य धीमतः ।\nबलज्येष्ठस्य नृपतेर्नास्ति सामन्तजं भयम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006344032, "chapter_id": 26344, "verse_number": "१-५४-३३", "content_sanskrit": "सहजैर्बाध्यते सर्वः प्रवृद्धैरिन्द्रियादिभिः ।\nअमित्राणां प्रियकरैर्मोहैरधृतिरीश्वरः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006344033, "chapter_id": 26344, "verse_number": "१-५४-३४", "content_sanskrit": "यत् त्वया स्त्रीकृते मोहात्सगणो रावणो हतः ।\nनैतदौपयिकं मन्ये महद् वै कर्म कुत्सिनम्॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006344034, "chapter_id": 26344, "verse_number": "१-५४-३५", "content_sanskrit": "वनवासप्रवृत्तेन यत् त्वया व्रतशालिना ।\nप्रहृतं राक्षसानीके नैव दृष्टः सतां विधिः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006344035, "chapter_id": 26344, "verse_number": "१-५४-३६", "content_sanskrit": "सतामक्रोधजो धर्मः शुभां नयति सद्गतिम् ।\nयत् त्वया निहता मोहाद् दूषिताश्चाश्रमौकसः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006344036, "chapter_id": 26344, "verse_number": "१-५४-३७", "content_sanskrit": "स एष रावणो धन्यो यस्त्वया व्रतचारिणा ।\nस्त्रीनिमित्ते हतो युद्धे ग्राम्यान् धर्मानवेक्षता ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006344037, "chapter_id": 26344, "verse_number": "१-५४-३८", "content_sanskrit": "यदि ते निहतः संख्ये दुर्बुद्धिरजितेन्द्रियः ।\nयुध्यस्वाद्य मया सार्धं मृधे यद्यसि वीर्यवान् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006344038, "chapter_id": 26344, "verse_number": "१-५४-३९", "content_sanskrit": "तस्य दूतस्य तच्छ्रुत्वा भाषितं रूक्षवादिनः ।\nधैर्यादसम्भ्रान्तवपुः सस्मितं राघवोऽब्रवीत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006344039, "chapter_id": 26344, "verse_number": "१-५४-४०", "content_sanskrit": "असदेतत् त्वया दूत भाषितं तस्य गौरवात् ।\nयन्मां क्षिपसि दोषेण वेदात्मानं च सुस्थिरम्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006344040, "chapter_id": 26344, "verse_number": "१-५४-४१", "content_sanskrit": "यद्यहं सत्पथे मूढो यदि वा रावणो हतः ।\nयदि वा मे हृता भार्या का तत्र परिदेवना ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006344041, "chapter_id": 26344, "verse_number": "१-५४-४२", "content_sanskrit": "न वाङ्मात्रेण दुष्यन्ति साधवः सत्पथे स्थिताः ।\nजागर्ति च यथा देवः सदा सत्स्वितरेषु च ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006344042, "chapter_id": 26344, "verse_number": "१-५४-४३", "content_sanskrit": "कृतं दूतेन यत्कार्यं गच्छ त्वं दूत मा चिरम् ।\nनात्मश्लाघिषु नीचेषु दृढे प्रहरन्तीह मद्विधाः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006344043, "chapter_id": 26344, "verse_number": "१-५४-४४", "content_sanskrit": "अयं ममानुजो भ्राता शत्रुघ्नः शत्रुतापनः ।\nतस्य दैत्यस्य दुर्बुद्धेर्मृधे प्रतिकरिष्यति ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006344044, "chapter_id": 26344, "verse_number": "१-५४-४५", "content_sanskrit": "एवमुक्तः स दूतस्तु ययौ सौमित्रिणा सह ।\nअनुज्ञातो नरेन्द्रेण राघवेण महात्मना ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006344045, "chapter_id": 26344, "verse_number": "१-५४-४६", "content_sanskrit": "स शीघ्रयानः सम्प्राप्तस्तद् दानवपुरं महत् ।\nचक्रे निवेशं सौमित्रिर्वनान्ते युद्धलालसः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006344046, "chapter_id": 26344, "verse_number": "१-५४-४७", "content_sanskrit": "ततो दूतस्य वचनात् स दैत्यः क्रोधमूर्च्छितः ।\nपृष्ठतस्तद्वनं कृत्वा युद्धायाभिमुखः स्थितः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006344047, "chapter_id": 26344, "verse_number": "१-५४-४८", "content_sanskrit": "तद् युद्धमभवद् घोरं सौमित्रेर्दानवस्य च ।\nउभयोरेव बलिनोः शूरयो रणमूर्धनि ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006344048, "chapter_id": 26344, "verse_number": "१-५४-४९", "content_sanskrit": "तौ शरैः साधु निशितैरन्योन्यमभिजघ्नतुः ।\nन च तौ युद्धवैमुख्यं श्रमं वाप्युपजग्मतुः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006344049, "chapter_id": 26344, "verse_number": "१-५४-५०", "content_sanskrit": "अथ सौमित्रिणा बाणैः पीडितो दानवो युधि ।\nततः स शूलरहितः पर्यहीयत दानवः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006344050, "chapter_id": 26344, "verse_number": "१-५४-५१", "content_sanskrit": "स गृहीत्वाङ्कुशं   चैव दैवैर्दत्तवरं रणे ।\nकर्षणं सर्वभूतानां लवणो विररास ह ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006344051, "chapter_id": 26344, "verse_number": "१-५४-५२", "content_sanskrit": "शिरोधरायां जग्राह सोऽङ्कुशेन  चकर्ष ह ।\nप्रवेशयितुमारब्धो लवणो राघवानुजम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006344052, "chapter_id": 26344, "verse_number": "१-५४-५३", "content_sanskrit": "स रुक्मत्सरुमुद्यम्य शत्रुघ्नः खड्गमुत्तमम्।\nशिरश्चिच्छेद खङ्गेन लवणस्य महामृधे ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006344053, "chapter_id": 26344, "verse_number": "१-५४-५४", "content_sanskrit": "स हत्वा दानवं संख्ये सौमित्रिर्मित्रवत्सलः ।\nतद् वनं तस्य दैत्यस्य चिच्छेदास्त्रेण बुद्धिमान् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006344054, "chapter_id": 26344, "verse_number": "१-५४-५५", "content_sanskrit": "छित्त्वा वनं तत् सौमित्रिर्निवेशं सोऽभ्यरोचयत् ।\nभवाय तस्य देशस्य पुर्याः प्ररूमधर्मवित् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006344055, "chapter_id": 26344, "verse_number": "१-५४-५६", "content_sanskrit": "तस्मिन् मधुवनस्थाने मथुरा नाम सा पुरी ।\nशत्रुघ्नेन पुरा सृष्टा हत्वा तं दानवं रणे ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006344056, "chapter_id": 26344, "verse_number": "१-५४-५७", "content_sanskrit": "सा पुरी परमोदारा साट्टप्राकारतोरणा ।\nस्फीता राष्ट्रसमाकीर्णा समृद्धबलवाहना ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006344057, "chapter_id": 26344, "verse_number": "१-५४-५८", "content_sanskrit": "उद्यानवनसम्पन्ना सुसीमा सुप्रतिष्ठिता ।\nप्रांशुप्राकारवसना परिखाकुलमेखला ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006344058, "chapter_id": 26344, "verse_number": "१-५४-५९", "content_sanskrit": "चयाट्टालककेयूरा प्रासादवरकुण्डला ।\nसुसंवृतद्वारमुखा चत्वरोद्गारहासिनी ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006344059, "chapter_id": 26344, "verse_number": "१-५४-६०", "content_sanskrit": "अरोगवीरपुरुषा हस्त्यश्वरथसंकुला ।\nअर्धचन्द्रप्रतीकाशा यमुनातीरशोभिता ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006344060, "chapter_id": 26344, "verse_number": "१-५४-६१", "content_sanskrit": "पुण्यापणवती दुर्गा रत्नसंचयगर्विता ।\nक्षेत्राणि सस्यवन्त्यस्याः काले देवश्च वर्षति ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006344061, "chapter_id": 26344, "verse_number": "१-५४-६२", "content_sanskrit": "नरनारीप्रमुदिता सा पुरी स्म प्रकाशते ।\nनिविष्टविषयश्चैव शूरसेनस्ततोऽभवत् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006344062, "chapter_id": 26344, "verse_number": "१-५४-६३", "content_sanskrit": "तस्य पुर्यां महावीर्यो राजा भोजकुलोद्वहः ।\nउग्रसेन इति ख्यातो महासेनपराक्रमः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006344063, "chapter_id": 26344, "verse_number": "१-५४-६४", "content_sanskrit": "तस्य पुत्रत्वमापन्नो योऽसौ विष्णो त्वया हतः ।\nकालनेमिर्महादैत्यः संग्रामे तारकामये ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006344064, "chapter_id": 26344, "verse_number": "१-५४-६५", "content_sanskrit": "कंसो नाम विशालाक्षो भोजवंशविवर्धनः ।\nराजा पृथिव्यां विख्यातः सिंहविस्पष्टविक्रमः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006344065, "chapter_id": 26344, "verse_number": "१-५४-६६", "content_sanskrit": "राज्ञां भयकरो घोरः शङ्कनीयो महीक्षिताम् ।\nभयदः सर्वभूतानां सत्पथाद् बाह्यतां गतः॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006344066, "chapter_id": 26344, "verse_number": "१-५४-६७", "content_sanskrit": "दारुणाभिनिवेशेन दारुणेनान्तरात्मना ।\nयुक्तस्तेनैव दर्पेण प्रजानां रोमहर्षणः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006344067, "chapter_id": 26344, "verse_number": "१-५४-६८", "content_sanskrit": "न राजधर्माभिरतो नात्मपक्षसुखावहः ।\nनात्मराज्ये प्रियकरश्चण्डः कररुचिः सदा ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006344068, "chapter_id": 26344, "verse_number": "१-५४-६९", "content_sanskrit": "स कंसस्तत्र सम्भूतस्त्वया युद्धे पराजितः ।\nक्रव्यादो बाधते लोकानासुरेणान्तरात्मना ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006344069, "chapter_id": 26344, "verse_number": "१-५४-७०", "content_sanskrit": "योऽप्यसौ हयविक्रान्तो हयग्रीव इति स्मृतः ।\nकेशी नाम हयो जातः स तस्यैव जघन्यजः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006344070, "chapter_id": 26344, "verse_number": "१-५४-७१", "content_sanskrit": "स दुष्टो ह्रेषितपटुः केसरी निरवग्रहः ।\nवृन्दावने वसत्येको नृणां मांसानि भक्षयन् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006344071, "chapter_id": 26344, "verse_number": "१-५४-७२", "content_sanskrit": "अरिष्टो बलिपुत्रश्च ककुद्मी वृषरूपधृक् ।\nगवामरित्वमापन्नः कामरूपी महासुरः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006344072, "chapter_id": 26344, "verse_number": "१-५४-७३", "content_sanskrit": "रिष्टो नाम दितेः पुत्रो वरिष्ठो दानवेषु यः ।\nस कुञ्जरत्वमापन्नो दैत्यः कंसस्य वाहनः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006344073, "chapter_id": 26344, "verse_number": "१-५४-७४", "content_sanskrit": "लम्बो नामेति विख्यातो योऽसौ दैत्येषु दर्पितः ।\nप्रलम्बो नाम दैत्योऽसौ वटं भाण्डीरमाश्रितः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006344074, "chapter_id": 26344, "verse_number": "१-५४-७५", "content_sanskrit": "खर इत्युच्यते दैत्यो धेनुकः सोऽसुरोत्तमः ।\nघोरं तालवनं दैत्यश्चरत्युद्वासयन् प्रजाः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006344075, "chapter_id": 26344, "verse_number": "१-५४-७६", "content_sanskrit": "वाराहश्च किशोरश्च दानवौ यो महाबलौ ।\nमल्लौ रङ्गगतौ तौ तु जातौ चाणूरमुष्टिकौ ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006344076, "chapter_id": 26344, "verse_number": "१-५४-७७", "content_sanskrit": "यौ तौ मयश्च तारश्च दानवौ दानवान्तक ।\nप्राग्ज्योतिषे तौ भौमस्य नरकस्य पुरे रतौ ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006344077, "chapter_id": 26344, "verse_number": "१-५४-७८", "content_sanskrit": "एते दैत्या विनिहतास्त्वया विष्णो निराकृताः ।\nमानुषं वपुरास्थाय बाधन्ते भुवि मानुषान् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006344078, "chapter_id": 26344, "verse_number": "१-५४-७९", "content_sanskrit": "त्वत्कथाद्वेषिणः सर्वे त्वद्भक्तान् घ्नन्ति मानुषान् ।\nतव प्रसादात् तेषां वै दानवानां क्षयो भवेत् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006344079, "chapter_id": 26344, "verse_number": "१-५४-८०", "content_sanskrit": "त्वत्तस्ते बिभ्यति दिवि त्वत्तो बिभ्यति सागरे ।\nपृथिव्यां तव बिभ्यन्ति नान्यतस्तु कदाचन ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006344080, "chapter_id": 26344, "verse_number": "१-५४-८१", "content_sanskrit": "दुर्वृत्तस्य हतस्यापि त्वया नान्येन श्रीधर ।\nदिवश्च्युतस्य दैत्यस्य गतिर्भवति मेदिनी ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006344081, "chapter_id": 26344, "verse_number": "१-५४-८२", "content_sanskrit": "व्युत्थितस्य च मेदिन्यां हतस्य नृशरीरिणः ।\nदुर्लभं स्वर्गगमनं त्वयि जाग्रति केशव ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006344082, "chapter_id": 26344, "verse_number": "१-५४-८३", "content_sanskrit": "तदागच्छ स्वयं विष्णो गच्छामः पृथिवीतलम् ।\nदानवानां विनाशाय विसृजात्मानमात्मना ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006344083, "chapter_id": 26344, "verse_number": "१-५४-८४", "content_sanskrit": "मूर्तयो हि तवाव्यक्ता दृश्यादृश्याः सुरोत्तमैः ।\nतासु सृष्टास्त्वया देवाः सम्भविष्यन्ति भूतले ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006344084, "chapter_id": 26344, "verse_number": "१-५४-८५", "content_sanskrit": "तवावतरणे विष्णो कंसः स विनशिष्यति ।\nसेत्स्यते च स कार्यार्थो यस्यार्थे भूमिरागता ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006344085, "chapter_id": 26344, "verse_number": "१-५४-८६", "content_sanskrit": "त्वं भारते कार्यगुरुस्त्वं चक्षुस्त्वं परायणम् ।\nतदागच्छ हृषीकेश क्षितौ ताञ्जहि दानवान् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}]