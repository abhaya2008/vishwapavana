[{"id": 2127386, "chapter_id": 3734, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2127387, "chapter_id": 3734, "verse_number": "१", "content_sanskrit": "धनञ्जयोत्सुकास्ते तु वने तस्मिन् महारथाः ।\nन्यवसन्त महाभागा द्रौपद्या सह कृष्णया\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2127388, "chapter_id": 3734, "verse_number": "२", "content_sanskrit": "अथापश्यन् महात्मानं देवर्षिं तत्र नारदम् ।\nदीप्यमानं श्रिया ब्राह्म्या सूर्याग्निसमतेजसम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2127389, "chapter_id": 3734, "verse_number": "३", "content_sanskrit": "द्विजैः परिवृतः श्रीमान् भ्रातृभिः कुरुनन्दन ।\nविबभावतिदीप्तौजा देवैरिव शतक्रतुः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2127390, "chapter_id": 3734, "verse_number": "४", "content_sanskrit": "यथा च वेदान् सावित्री याज्ञसेनी तथा सती ।\nन जहौ धर्मतः पार्थान् मेरुमर्कप्रभा यथा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2127391, "chapter_id": 3734, "verse_number": "५", "content_sanskrit": "अर्घ्यं पाद्यमथानीय त्वभ्यवादयदच्युतः ।\nनारदस्तु महातेजाः स्वस्त्यस्त्वित्यभ्यभाषत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2127392, "chapter_id": 3734, "verse_number": "६", "content_sanskrit": "प्रतिगृह्य च तां पूजां नारदो भगवानृषिः ।\nआश्वासयद् धर्मसुतं युक्तरूपमिवानघ\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2127393, "chapter_id": 3734, "verse_number": "७", "content_sanskrit": "उवाच च महाप्राज्ञं धर्मराजं युधिष्ठिरम् ।\nब्रूहि धर्मभृतां श्रेष्ठ केनार्थः किं ददामि ते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2127394, "chapter_id": 3734, "verse_number": "८", "content_sanskrit": "अथ धर्मसुतो राजा प्रणम्य भ्रातृभिः सह ।\nउवाच प्राञ्जलिर्वाक्यं नारदं देवसम्मितम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2127395, "chapter_id": 3734, "verse_number": "९", "content_sanskrit": "त्वयि तुष्टे महाभाग सर्वलोकाभिपूजिते ।\nकृतमित्येव मन्येऽहं प्रसादात् तव सुव्रत\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2127396, "chapter_id": 3734, "verse_number": "१०", "content_sanskrit": "यदि त्वहमनुग्राह्यो भ्रातृभिः सहितोऽनघ ।\nसन्देहं मे मुनिश्रेष्ठ हृदिस्थं छेत्तुमर्हसि \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2127397, "chapter_id": 3734, "verse_number": "११", "content_sanskrit": "प्रदक्षिणां यः पृथिवीं कुरुते तीर्थतत्परः ।\nकिं फलं तस्य कार्त्स्न्येन त्वं ब्रह्मन् वक्तुमर्हसि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2127398, "chapter_id": 3734, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2127399, "chapter_id": 3734, "verse_number": "१२", "content_sanskrit": "शृणु राजन्नवहितो यथा भीष्मेण धीमता ।\nपुलस्त्यस्य सकाशाद् वै सर्वमेतदुपश्रुतम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2127400, "chapter_id": 3734, "verse_number": "१३", "content_sanskrit": "पुरा भागीरथीतीरे भीष्मो धर्मभृतां वरः ।\nपित्र्यं व्रतं समास्थाय न्यवसन्मुनिवत् तदा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2127401, "chapter_id": 3734, "verse_number": "१४", "content_sanskrit": "शुभे देशे महाराज पुण्ये देवर्षिसेविते ।\nगङ्गाद्वारे महातेजा देवगन्धर्वसेविते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2127402, "chapter_id": 3734, "verse_number": "१५", "content_sanskrit": "स पितॄंस्तर्पयामास देवांश्च परमद्युतिः ।\nऋषींश्च तोषयामास विधिदृष्टेन कर्मणा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2127403, "chapter_id": 3734, "verse_number": "१६", "content_sanskrit": "कस्य चित्त्वथ कालस्य जपन्नेव महातपाः ।\nददर्शाद्भुतसङ्काशं पुलस्त्यमृषिसत्तमम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2127404, "chapter_id": 3734, "verse_number": "१७", "content_sanskrit": "स तं दृष्ट्वोग्रतपसं दीप्यमानमिव श्रिया ।\nप्रहर्षमतुलं लेभे विस्मयं च परं ययौ\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2127405, "chapter_id": 3734, "verse_number": "१८", "content_sanskrit": "उपस्थितं महाभागं पूजयामास भारत ।\nभीष्मो धर्मभृतां श्रेष्ठो विधिदृष्टेन कर्मणा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2127406, "chapter_id": 3734, "verse_number": "१९", "content_sanskrit": "शिरसा चार्घ्यमादाय शुचिः प्रयतमानसः ।\nनाम सङ्कीर्तयामास तस्मिन् ब्रह्मर्षिसत्तमे \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2127407, "chapter_id": 3734, "verse_number": "२०", "content_sanskrit": "भीष्मोऽहमस्मि भद्रं ते दासोऽस्मि तव सुव्रत ।\nतव सन्दर्शनादेव मुक्तोऽहं सर्वकिल्बिषैः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2127408, "chapter_id": 3734, "verse_number": "२१", "content_sanskrit": "एवमुक्त्वा महाराज भीष्मो धर्मभृतां वरः ।\nवाग्यतः प्राञ्जलिर्भूत्वा तूष्णीमासीद् युधिष्ठिर\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2127409, "chapter_id": 3734, "verse_number": "२२", "content_sanskrit": "तं दृष्ट्वा नियमेनाथ स्वाध्यायाम्नायकर्शितम् ।\nभीष्मं कुरुकुलश्रेष्ठं मुनिः प्रीतमनाऽभवत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2127410, "chapter_id": 3734, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि षट्सप्ततितमोऽध्यायः ॥७६॥\n॥ तीर्थयात्रापर्वणि द्वात्रिंशोऽध्यायः ॥३२॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]