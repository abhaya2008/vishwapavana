[{"id": 2129803, "chapter_id": 3796, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2129804, "chapter_id": 3796, "verse_number": "१", "content_sanskrit": "अन्तर्हितानि भूतानि बलवन्ति महान्ति च ।\nअग्निना तपसा चैव शक्यं गन्तुं वृकोदर\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2129805, "chapter_id": 3796, "verse_number": "२", "content_sanskrit": "सन्निवर्तय कौन्तेय क्षुत्पिपासे बलाश्रयात् ।\nततो बलं च दाक्ष्यं च संश्रयस्व वृकोदर\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2129806, "chapter_id": 3796, "verse_number": "३", "content_sanskrit": "ऋषेस्त्वया श्रुतं वाक्यं कैलासं पर्वतं प्रति ।\nबुद्ध्या प्रपश्य कौन्तेय कथं कृष्णा गमिष्यति\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2129807, "chapter_id": 3796, "verse_number": "४", "content_sanskrit": "अथवा सहदेवेन धौम्येन च समं विभो ।\nसूतैः पौरोगवैश्चैव सर्वैश्च परिचारकैः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2129808, "chapter_id": 3796, "verse_number": "५", "content_sanskrit": "रथैरश्वैश्च ये चान्ये विप्राः क्लेशासहाः पथि ।\nसर्वैस्त्वं सहितो भीम निवर्तस्वायतेक्षण\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2129809, "chapter_id": 3796, "verse_number": "६", "content_sanskrit": "त्रयो वयं गमिष्यामो लघ्वाहारा यतव्रताः ।\nअहं च नकुलश्चैव लोमशश्च महातपाः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2129810, "chapter_id": 3796, "verse_number": "७", "content_sanskrit": "ममागमनमाकाङ्क्षन् गङ्गाद्वारे समाहितः ।\nवसेह द्रौपदीं रक्षन् यावदागमनं मम\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2129811, "chapter_id": 3796, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2129812, "chapter_id": 3796, "verse_number": "८", "content_sanskrit": "राजपुत्री श्रमेणार्ता दुःखार्ता चैव भारत ।\nव्रजत्येव हि कल्याणी श्वेतवाहदिदृक्षया\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2129813, "chapter_id": 3796, "verse_number": "", "content_sanskrit": "अपश्यन्तीह तं वीरमेवमेषा सुदुःखिता ।\nकिं पुनर्नकुलं त्वां च तं च वीरं धनञ्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2129814, "chapter_id": 3796, "verse_number": "९", "content_sanskrit": "तव चाप्यरतिस्तीव्रा वर्तते तमपश्यतः ।\nगुडाकेशं महात्मानं सङ्ग्रामेष्वपलायिनम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2129815, "chapter_id": 3796, "verse_number": "", "content_sanskrit": "किं पुनः सहदेवं च मां च कृष्णां च भारत ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2129816, "chapter_id": 3796, "verse_number": "१०", "content_sanskrit": "द्विजाः कामं निवर्तन्तां सर्वे च परिचारकाः ।\nसूताः पौरोगवाश्चैव यं च मन्येत नो भवान्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2129817, "chapter_id": 3796, "verse_number": "११", "content_sanskrit": "न ह्यहं हातुमिच्छामि भवन्तमिह कर्हिचित् ।\nशैलेऽस्मिन् राक्षसाकीर्णे दुर्गेषु विषमेषु च \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2129818, "chapter_id": 3796, "verse_number": "१२", "content_sanskrit": "इयं चापि महाभागा राजपुत्री पतिव्रता ।\nत्वामृते पुरुषव्याघ्र नोत्सहेद् विनिवर्तितुम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2129819, "chapter_id": 3796, "verse_number": "१३", "content_sanskrit": "तथैव सहदेवोऽयं सततं त्वामनुव्रतः ।\nन जातु विनिवर्तेत मनोज्ञो ह्यहमस्य वै\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2129820, "chapter_id": 3796, "verse_number": "१४", "content_sanskrit": "अपि चात्र महाराज सव्यसाचिदिदृक्षया ।\nसर्वे लालसभूताः स्म तस्माद् यास्यामहे सह \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2129821, "chapter_id": 3796, "verse_number": "१५", "content_sanskrit": "यद्यशक्यो रथैर्गन्तुं शैलोऽयं बहुकन्दरः ।\nपद्भिरेव गमिष्यामो मा राजन् विमना भव \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2129822, "chapter_id": 3796, "verse_number": "१६", "content_sanskrit": "अहं वहिष्ये पाञ्चालीं यत्र यत्र न शक्ष्यति ।\nइति मे वर्तते बुद्धिर्मा राजन् विमना भव \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2129823, "chapter_id": 3796, "verse_number": "१७", "content_sanskrit": "सुकुमारौ तथा वीरौ माद्रीनन्दिकरावुभौ ।\nदुर्गे सन्तारयिष्यामि यत्राशक्तौ भविष्यतः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2129824, "chapter_id": 3796, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2129825, "chapter_id": 3796, "verse_number": "१८", "content_sanskrit": "एवं ते भाषमाणस्य बलं भीमाभिवर्धताम् ।\nयत् त्वमुत्सहसे वोढुं पाञ्चालीं च यशस्विनीम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2129826, "chapter_id": 3796, "verse_number": "१९", "content_sanskrit": "यमजौ चापि भद्रं ते नैतदन्यत्र विद्यते ।\nबलं तव यशश्चैव धर्मः कीर्तिश्च वर्धताम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2129827, "chapter_id": 3796, "verse_number": "२०", "content_sanskrit": "यत् त्वमुत्सहसे नेतुं भ्रातरौ सह कृष्णया ।\nमा ते ग्लानिर्महाबाहो मा च तेऽस्तु पराभवः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2129828, "chapter_id": 3796, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2129829, "chapter_id": 3796, "verse_number": "", "content_sanskrit": "ततः कृष्णाऽब्रवीद् वाक्यं प्रहसन्ती मनोरमा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2129830, "chapter_id": 3796, "verse_number": "", "content_sanskrit": "द्रौपदी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2129831, "chapter_id": 3796, "verse_number": "२१", "content_sanskrit": "गमिष्यामि न सन्तापः कार्यो मां प्रति भारत\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2129832, "chapter_id": 3796, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2129833, "chapter_id": 3796, "verse_number": "२२", "content_sanskrit": "तपसा शक्यते गन्तुं पर्वतो गन्धमादनः ।\nतपसा चैव कौन्तेय सर्वे योक्ष्यामहे वयम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2129834, "chapter_id": 3796, "verse_number": "२३", "content_sanskrit": "नकुलः सहदेवश्च भीमसेनश्च पार्थिव ।\nअहं च त्वं च कौन्तेय द्रक्ष्यामः श्वेतवाहनम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2129835, "chapter_id": 3796, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2129836, "chapter_id": 3796, "verse_number": "२४", "content_sanskrit": "एवं सम्भाषमाणास्ते सुबाहुविषयं महत् ।\nददृशुर्मुदिता राजन् प्रभूतगजवाजिमत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2129837, "chapter_id": 3796, "verse_number": "२५", "content_sanskrit": "किराततङ्कणाकीर्णं पुळिन्दशतसङ्कुलम् ।\nहिमवत्यमरैर्जुष्टं बह्वाश्चर्यसमाकुलम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2129838, "chapter_id": 3796, "verse_number": "२६", "content_sanskrit": "सुबाहुश्चापि तान् दृष्ट्वा पूजया प्रत्यगृह्णत ।\nविषयान्ते कुलिन्दानामीश्वरः प्रीतिपूर्वकम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2129839, "chapter_id": 3796, "verse_number": "२७", "content_sanskrit": "ततस्ते पूजितास्तेन सर्व एव सुखोषिताः ।\nप्रतस्थुर्विमले सूर्ये हिमवन्तं गिरिं प्रति\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2129840, "chapter_id": 3796, "verse_number": "२८", "content_sanskrit": "इन्द्रसेनमुखांश्चापि भृत्यान् पौरोगवांस्तथा ।\nसूदांश्च पारिबर्हांश्च द्रौपद्याः सर्वशो नृप\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2129841, "chapter_id": 3796, "verse_number": "२९", "content_sanskrit": "राज्ञः कुळिन्दाधिपतेः परिदाय महारथाः ।\nपद्भिरेव महावीर्या ययुः कौरवनन्दनाः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2129842, "chapter_id": 3796, "verse_number": "३०", "content_sanskrit": "ते शनैः प्राद्रवन् सर्वे कृष्णया सह पाण्डवाः ।\nतस्माद् देशात् सुसंहृष्टा द्रष्टुकामा धनञ्जयम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2129843, "chapter_id": 3796, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसाहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि सप्तत्रिंशदधिकशततमोऽध्यायः ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2129844, "chapter_id": 3796, "verse_number": "", "content_sanskrit": "॥ इति तीर्थयात्रापर्वणि त्रिनवतितमोऽध्यायः ॥९३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]