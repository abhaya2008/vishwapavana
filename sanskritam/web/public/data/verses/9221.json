[{"id": 5000221000, "chapter_id": 9221, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे पञ्चविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000221001, "chapter_id": 9221, "verse_number": "३-२५-१", "content_sanskrit": "अवष्टब्धधनुं रामं क्रुद्धं तं रिपुघातिनम्।\nददर्शाश्रममागम्य खरः सह पुरःसरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000221002, "chapter_id": 9221, "verse_number": "३-२५-२", "content_sanskrit": "तं दृष्ट्वा सगुणं चापमुद्यम्य खरनिःस्वनम्।\nरामस्याभिमुखं सूतं चोद्यतामित्यचोदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000221003, "chapter_id": 9221, "verse_number": "३-२५-३", "content_sanskrit": "स खरस्याज्ञया सूतस्तुरगान् समचोदयत्।\nयत्र रामो महाबाहुरेको धुन्वन् धनुः स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000221004, "chapter_id": 9221, "verse_number": "३-२५-४", "content_sanskrit": "तं तु निष्पतितं दृष्ट्वा सर्वतो रजनीचराः।\nमुञ्चमाना महानादं सचिवाः पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000221005, "chapter_id": 9221, "verse_number": "३-२५-५", "content_sanskrit": "स तेषां यातुधानानां मध्ये रथगतः खरः।\nबभूव मध्ये ताराणां लोहिताङ्ग इवोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000221006, "chapter_id": 9221, "verse_number": "३-२५-६", "content_sanskrit": "ततः शरसहस्रेण राममप्रतिमौजसम्।\nअर्दयित्वा महानादं ननाद समरे खरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000221007, "chapter_id": 9221, "verse_number": "३-२५-७", "content_sanskrit": "ततस्तं भीमधन्वानं क्रुद्धाः सर्वे निशाचराः।\nरामं नानाविधैः शस्त्रैरभ्यवर्षन्त दुर्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000221008, "chapter_id": 9221, "verse_number": "३-२५-८", "content_sanskrit": "मुद‍्गरैरायसैः शूलैः प्रासैः खड्गैः परश्वधैः।\nराक्षसाः समरे शूरं निजघ्नू रोषतत्पराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000221009, "chapter_id": 9221, "verse_number": "३-२५-९", "content_sanskrit": "ते बलाहकसंकाशा महाकाया महाबलाः।\nअभ्यधावन्त काकुत्स्थं रथैर्वाजिभिरेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000221010, "chapter_id": 9221, "verse_number": "३-२५-१०", "content_sanskrit": "गजैः पर्वतकूटाभै रामं युद्धे जिघांसवः।\nते रामे शरवर्षाणि व्यसृजन् रक्षसां गणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000221011, "chapter_id": 9221, "verse_number": "३-२५-११", "content_sanskrit": "शैलेन्द्रमिव धाराभिर्वर्षमाणा महाघनाः।\nसर्वैः परिवृतो रामो राक्षसैः क्रूरदर्शनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000221012, "chapter_id": 9221, "verse_number": "३-२५-१२", "content_sanskrit": "तिथिष्विव महादेवो वृतः पारिषदां गणैः।\nतानि मुक्तानि शस्त्राणि यातुधानैः स राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000221013, "chapter_id": 9221, "verse_number": "३-२५-१३", "content_sanskrit": "प्रतिजग्राह विशिखैर्नद्योघानिव सागरः।\nस तैः प्रहरणैर्घोरैर्भिन्नगात्रो न विव्यथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000221014, "chapter_id": 9221, "verse_number": "३-२५-१४", "content_sanskrit": "रामः प्रदीप्तैर्बहुभिर्वज्रैरिव महाचलः।\nस विद्धः क्षतजादिग्धः सर्वगात्रेषु राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000221015, "chapter_id": 9221, "verse_number": "३-२५-१५", "content_sanskrit": "बभूव रामः संध्याभ्रैर्दिवाकर इवावृतः।\nविषेदुर्देवगन्धर्वाः सिद्धाश्च परमर्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000221016, "chapter_id": 9221, "verse_number": "३-२५-१६", "content_sanskrit": "एकं सहस्रैर्बहुभिस्तदा दृष्ट्वा समावृतम्।\nततो रामस्तु संक्रुद्धो मण्डलीकृतकार्मुकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000221017, "chapter_id": 9221, "verse_number": "३-२५-१७", "content_sanskrit": "ससर्ज निशितान् बाणान् शतशोऽथ सहस्रशः।\nदुरावारान् दुर्विषहान् कालपाशोपमान् रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000221018, "chapter_id": 9221, "verse_number": "३-२५-१८", "content_sanskrit": "मुमोच लीलया कङ्कपत्रान् काञ्चनभूषणान्।\nते शराः शत्रुसैन्येषु मुक्ता रामेण लीलया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000221019, "chapter_id": 9221, "verse_number": "३-२५-१९", "content_sanskrit": "आददू रक्षसां प्राणान् पाशाः कालकृता इव।\nभित्त्वा राक्षसदेहांस्तांस्ते शरा रुधिराप्लुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000221020, "chapter_id": 9221, "verse_number": "३-२५-२०", "content_sanskrit": "अन्तरिक्षगता रेजुर्दीप्ताग्निसमतेजसः।\nअसंख्येयास्तु रामस्य सायकाश्चापमण्डलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000221021, "chapter_id": 9221, "verse_number": "३-२५-२१", "content_sanskrit": "विनिष्पेतुरतीवोग्रा रक्षःप्राणापहारिणः।\nतैर्धनूंषि ध्वजाग्राणि चर्माणि कवचानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000221022, "chapter_id": 9221, "verse_number": "३-२५-२२", "content_sanskrit": "बाहून् सहस्ताभरणानूरून् करिकरोपमान्।\nचिच्छेद रामः समरे शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000221023, "chapter_id": 9221, "verse_number": "३-२५-२३", "content_sanskrit": "हयान् काञ्चनसंनाहान् रथयुक्तान् ससारथीन्।\nगजांश्च सगजारोहान् सहयान् सादिनस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000221024, "chapter_id": 9221, "verse_number": "३-२५-२४", "content_sanskrit": "चिच्छिदुर्बिभिदुश्चैव रामबाणा गुणच्युताः।\nपदातीन् समरे हत्वा ह्यनयद् यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000221025, "chapter_id": 9221, "verse_number": "३-२५-२५", "content_sanskrit": "ततो नालीकनाराचैस्तीक्ष्णाग्रैश्च विकर्णिभिः।\nभीममार्तस्वरं चक्रुश्छिद्यमाना निशाचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000221026, "chapter_id": 9221, "verse_number": "३-२५-२६", "content_sanskrit": "तत्सैन्यं विविधैर्बाणैरर्दितं मर्मभेदिभिः।\nन रामेण सुखं लेभे शुष्कं वनमिवाग्निना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000221027, "chapter_id": 9221, "verse_number": "३-२५-२७", "content_sanskrit": "केचिद् भीमबलाः शूराः प्रासान् शूलान् परश्वधान्।\nचिक्षिपुः परमक्रुद्धा रामाय रजनीचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000221028, "chapter_id": 9221, "verse_number": "३-२५-२८", "content_sanskrit": "तेषां बाणैर्महाबाहुः शस्त्राण्यावार्य वीर्यवान्।\nजहार समरे प्राणांश्चिच्छेद च शिरोधरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000221029, "chapter_id": 9221, "verse_number": "३-२५-२९", "content_sanskrit": "ते छिन्नशिरसः पेतुश्छिन्नचर्मशरासनाः।\nसुपर्णवातविक्षिप्ता जगत्यां पादपा यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000221030, "chapter_id": 9221, "verse_number": "३-२५-३०", "content_sanskrit": "अवशिष्टाश्च ये तत्र विषण्णास्ते निशाचराः।\nखरमेवाभ्यधावन्त शरणार्थं शराहताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000221031, "chapter_id": 9221, "verse_number": "३-२५-३१", "content_sanskrit": "तान् सर्वान् धनुरादाय समाश्वास्य च दूषणः।\nअभ्यधावत् सुसंक्रुद्धः क्रुद्धं क्रुद्ध इवान्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000221032, "chapter_id": 9221, "verse_number": "३-२५-३२", "content_sanskrit": "निवृत्तास्तु पुनः सर्वे दूषणाश्रयनिर्भयाः।\nराममेवाभ्यधावन्त सालतालशिलायुधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000221033, "chapter_id": 9221, "verse_number": "३-२५-३३", "content_sanskrit": "शूलमुद‍्गरहस्ताश्च पाशहस्ता महाबलाः।\nसृजन्तः शरवर्षाणि शस्त्रवर्षाणि संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000221034, "chapter_id": 9221, "verse_number": "३-२५-३४", "content_sanskrit": "द्रुमवर्षाणि मुञ्चन्तः शिलावर्षाणि राक्षसाः।\nतद् बभूवाद्भुतं युद्धं तुमुलं रोमहर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000221035, "chapter_id": 9221, "verse_number": "३-२५-३५", "content_sanskrit": "रामस्यास्य महाघोरं पुनस्तेषां च रक्षसाम्।\nते समन्तादभिक्रुद्धा राघवं पुनरार्दयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000221036, "chapter_id": 9221, "verse_number": "३-२५-३६", "content_sanskrit": "ततः सर्वा दिशो दृष्ट्वा प्रदिशश्च समावृताः।\nराक्षसैः सर्वतः प्राप्तैः शरवर्षाभिरावृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000221037, "chapter_id": 9221, "verse_number": "३-२५-३७", "content_sanskrit": "स कृत्वा भैरवं नादमस्त्रं परमभास्वरम्।\nसमयोजयद् गान्धर्वं राक्षसेषु महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000221038, "chapter_id": 9221, "verse_number": "३-२५-३८", "content_sanskrit": "ततः शरसहस्राणि निर्ययुश्चापमण्डलात्।\nसर्वा दश दिशो बाणैरापूर्यन्त समागतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000221039, "chapter_id": 9221, "verse_number": "३-२५-३९", "content_sanskrit": "नाददानं शरान् घोरान् विमुञ्चन्तं शरोत्तमान्।\nविकर्षमाणं पश्यन्ति राक्षसास्ते शरार्दिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000221040, "chapter_id": 9221, "verse_number": "३-२५-४०", "content_sanskrit": "शरान्धकारमाकाशमावृणोत् सदिवाकरम्।\nबभूवावस्थितो रामः प्रक्षिपन्निव तान् शरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000221041, "chapter_id": 9221, "verse_number": "३-२५-४१", "content_sanskrit": "युगपत्पतमानैश्च युगपच्च हतैर्भृशम्।\nयुगपत्पतितैश्चैव विकीर्णा वसुधाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000221042, "chapter_id": 9221, "verse_number": "३-२५-४२", "content_sanskrit": "निहताः पतिताः क्षीणाश्छिन्ना भिन्ना विदारिताः।\nतत्र तत्र स्म दृश्यन्ते राक्षसास्ते सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000221043, "chapter_id": 9221, "verse_number": "३-२५-४३", "content_sanskrit": "सोष्णीषैरुत्तमाङ्गैश्च साङ्गदैर्बाहुभिस्तथा।\nऊरुभिर्बाहुभिश्छिन्नैर्नानारूपैर्विभूषणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000221044, "chapter_id": 9221, "verse_number": "३-२५-४४", "content_sanskrit": "हयैश्च द्विपमुख्यैश्च रथैर्भिन्नैरनेकशः।\nचामरव्यजनैश्छत्रैर्ध्वजैर्नानाविधैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000221045, "chapter_id": 9221, "verse_number": "३-२५-४५", "content_sanskrit": "रामेण बाणाभिहतैर्विच्छिन्नैः शूलपट्टिशैः।\nखड्गैः खण्डीकृतैः प्रासैर्विकीर्णैश्च परश्वधैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000221046, "chapter_id": 9221, "verse_number": "३-२५-४६", "content_sanskrit": "चूर्णिताभिः शिलाभिश्च शरैश्चित्रैरनेकशः।\nविच्छिन्नैः समरे भूमिर्विस्तीर्णाभूद् भयंकरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000221047, "chapter_id": 9221, "verse_number": "३-२५-४७", "content_sanskrit": "तान् दृष्ट्वा निहतान् सर्वे राक्षसाः परमातुराः।\nन तत्र चलितुं शक्ता रामं परपुरंजयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000221048, "chapter_id": 9221, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे पञ्चविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]