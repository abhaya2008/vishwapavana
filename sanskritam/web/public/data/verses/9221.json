[{"id": 40015322, "chapter_id": 9221, "verse_number": "1", "content_sanskrit": "सीतांतुमोहितांदृष्टवासरमानामराक्षसी । आससादाथवैदेहींप्रियांप्रणयिनींसखी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40015323, "chapter_id": 9221, "verse_number": "2", "content_sanskrit": "मोहितांराक्षसेन्द्रेणसीतांपरमदुःखिताम् । आश्वासयामासतदासरमामृदुभाषिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40015324, "chapter_id": 9221, "verse_number": "3", "content_sanskrit": "साहितत्रकृतामित्रंसीतयारक्ष्यमाणया । रक्षन्तीरावणादिष्टासानुक्रोशादृढव्रता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40015325, "chapter_id": 9221, "verse_number": "4", "content_sanskrit": "साददर्शसखीसीतांसरमानष्टचेतनाम् । उपावृत्त्योत्थितांध्वस्तांबडबामिवपांसुलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40015326, "chapter_id": 9221, "verse_number": "5", "content_sanskrit": "तांसमाश्वासयामाससखीस्नेहेनसुव्रता । समाश्वसिहिवैदेही माभूत्तेमवसोव्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40015327, "chapter_id": 9221, "verse_number": "6", "content_sanskrit": "उक्तायद्रावणेनत्वंप्रत्युक्तश्चस्वयंत्वया । सखीस्नेहेनतभदीरुमयासर्वंप्रतिश्रुतम् ॥ लीनयागहनेशून्येभयमुत्सृज्यरावणात् । तवहेतोर्विशालाक्षी नहिमेजीवितंप्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40015328, "chapter_id": 9221, "verse_number": "7", "content_sanskrit": "उक्तायद्रावणेनत्वंप्रत्युक्तश्चस्वयंत्वया । सखीस्नेहेनतभदीरुमयासर्वंप्रतिश्रुतम् ॥ लीनयागहनेशून्येभयमुत्सृज्यरावणात् । तवहेतोर्विशालाक्षी नहिमेजीवितंप्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40015329, "chapter_id": 9221, "verse_number": "8", "content_sanskrit": "ससम्भ्रान्तश्चनिष्क्रान्तोयत्कृतेराक्षसाधिपः । तच्चमेविदितंसर्वमभिनिष्क्रम्यमैथिलि: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40015330, "chapter_id": 9221, "verse_number": "9", "content_sanskrit": "नशक्यंसौप्तिकंकर्तुंरामस्यविदितात्मनः । वधश्चपुरुषव्याघ्रेतस्मिन्नैवोपपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40015331, "chapter_id": 9221, "verse_number": "10", "content_sanskrit": "नत्वेववानराहन्तुंशक्याःपादपयोधिपः । सुरादेवर्षभेणेवरामेणहिसुरक्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40015332, "chapter_id": 9221, "verse_number": "11", "content_sanskrit": "दीर्घवृत्तभुज्शीमान्महोरस्कःप्रतापवान् । धन्वीसंहननोपेतोधर्मात्माभुविविश्रुतः ॥ विक्रान्तोरक्षितानित्यमात्मनश्चपरस्यच । लक्ष्मणेनसहभ्रात्राकुशलीनयशास्त्रवित् ॥ हन्तापरबलौघनामचिन्त्यबलपौरुषः । नहतोराघवश्रशीमान्सीते: शत्रुनिबर्हणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40015333, "chapter_id": 9221, "verse_number": "12", "content_sanskrit": "दीर्घवृत्तभुज्शीमान्महोरस्कःप्रतापवान् । धन्वीसंहननोपेतोधर्मात्माभुविविश्रुतः ॥ विक्रान्तोरक्षितानित्यमात्मनश्चपरस्यच । लक्ष्मणेनसहभ्रात्राकुशलीनयशास्त्रवित् ॥ हन्तापरबलौघनामचिन्त्यबलपौरुषः । नहतोराघवश्रशीमान्सीते: शत्रुनिबर्हणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40015334, "chapter_id": 9221, "verse_number": "13", "content_sanskrit": "दीर्घवृत्तभुज्शीमान्महोरस्कःप्रतापवान् । धन्वीसंहननोपेतोधर्मात्माभुविविश्रुतः ॥ विक्रान्तोरक्षितानित्यमात्मनश्चपरस्यच । लक्