[{"id": 2062424, "chapter_id": 2330, "verse_number": "८-५१-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2062425, "chapter_id": 2330, "verse_number": "८-५१-१", "content_sanskrit": "भीमसेनं सपाञ्चालं चेदिकेकयसंवृतम्।\nसेनापतिः स्वयं क्रुद्धो वारयामास सायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2062426, "chapter_id": 2330, "verse_number": "८-५१-२", "content_sanskrit": "ततस्तु चेदिकारूशान्सृढ्जयांश्च महारथान्।\nकर्णो जघान समरे भीमसेनस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2062427, "chapter_id": 2330, "verse_number": "८-५१-३", "content_sanskrit": "भीमसेनस्ततः कर्णे विहाय रथसत्तमम्।\nप्रययौ कौरवं सैन्यं कक्षमग्निरिव ज्वलन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2062428, "chapter_id": 2330, "verse_number": "८-५१-४", "content_sanskrit": "सूतपुत्रोऽपि समरे पाञ्चालान्केकयांस्तथा।\nसृञ्जयांश्च महेष्वासान्निजघानं सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2062429, "chapter_id": 2330, "verse_number": "८-५१-५", "content_sanskrit": "संशप्तकेषु पार्थश्च कौरवेषु वृकोदरः।\nपाञ्चालेषु तथा कर्णः क्षयं चक्रुर्महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2062430, "chapter_id": 2330, "verse_number": "८-५१-६", "content_sanskrit": "ते क्षत्रिया दह्यामानास्त्रिभिस्तैः पावकोपमैः।\nजग्मुर्विनाशं समरे राजन्दुर्मन्त्रिते तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2062431, "chapter_id": 2330, "verse_number": "८-५१-७", "content_sanskrit": "ततो दुर्योधनः क्रुद्दो नकुलं नवभिः शरैः।\nविव्याध भरतश्रेष्ठ चतुरश्चास्य वाजिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2062432, "chapter_id": 2330, "verse_number": "८-५१-८", "content_sanskrit": "ततः परममेयात्मा तव पुत्रो जनाधिप।\nक्षुरेण सहदेवस्य ध्वजं चिच्छेद काञ्चनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2062433, "chapter_id": 2330, "verse_number": "८-५१-९", "content_sanskrit": "नकुलस्तु ततः क्रुद्धस्तव पुत्रं च सप्तभिः।\nजघान समरे राजन्सहदेवश्च पञ्चभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2062434, "chapter_id": 2330, "verse_number": "८-५१-१०", "content_sanskrit": "तावुभौ भरतश्रेष्ठौ ज्येष्ठौ सर्वधनुष्मताम्।\nविव्याधोरसि सङ्क्रुद्धः पञ्चभिः पञ्चभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2062435, "chapter_id": 2330, "verse_number": "८-५१-११", "content_sanskrit": "ततोऽपराभ्यां भल्लाब्यां धनुषी समकृन्तत।\nयमयोः प्रसभं वीरो विव्याधाशु त्रिभिस्त्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2062436, "chapter_id": 2330, "verse_number": "८-५१-१२", "content_sanskrit": "तावन्ये धनुषी श्रेष्ठे शक्रचापनिभे शुभे।\nप्रगृह्य रेजतुः शूरौ देवपुत्रसमौ युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2062437, "chapter_id": 2330, "verse_number": "८-५१-१३", "content_sanskrit": "ततस्तौ रभसौ युद्धे भ्रातरौ भ्रातरं युधि।\nशरैर्ववर्षतुर्घोरैर्महामेघौ यथाऽचलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2062438, "chapter_id": 2330, "verse_number": "८-५१-१४", "content_sanskrit": "ततः क्रुद्धो महाराज तव पुत्रो महारथः।\nपाण़्डुपुत्रौ महेष्वासौ वारयामास पत्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2062439, "chapter_id": 2330, "verse_number": "८-५१-१५", "content_sanskrit": "धनुर्मण्डलमेवास्य ददृशे युधि भारत।\nसायकाश्चाप्यदृश्यन्त निश्चरन्तः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2062440, "chapter_id": 2330, "verse_number": "८-५१-१६", "content_sanskrit": "`तस्य सायकसञ्छन्नौ माद्रेयौ न विरेजतुः।\nमेघच्छन्नौ यथा व्योम्नि चन्द्रसूर्यौ गतप्रभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2062441, "chapter_id": 2330, "verse_number": "८-५१-१७", "content_sanskrit": "ते तु बाणा महाराज स्वर्णपुङ्खाः शिलाशिताः।\nआच्छादयन्दिशः सर्वाः सूर्यस्येव मरीचयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2062442, "chapter_id": 2330, "verse_number": "८-५१-१८", "content_sanskrit": "वाणभूते ततस्तस्मिन्सञ्छन्ने च नभस्तले।\nराज्ञस्तु ददृशे रूपं कालान्तकयमोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2062443, "chapter_id": 2330, "verse_number": "८-५१-१९", "content_sanskrit": "पराक्रमं तु तं दृष्ट्वा तव सूनोर्महारथाः।\nमृत्योरुपान्तिकं प्राप्तौ माद्रीपुत्रौ स्म मेनिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2062444, "chapter_id": 2330, "verse_number": "८-५१-२०", "content_sanskrit": "ततः सेनापती राजन्पाण्डवानां महारथः।\nपार्षतः प्रययौ तत्र यत्र राजा सुयोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2062445, "chapter_id": 2330, "verse_number": "८-५१-२१", "content_sanskrit": "माद्रीपुत्रौ ततः शूरौ व्यतिक्रम्य महारथौ।\nधृष्टद्युम्नस्तव सुतं पीडयामास सायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2062446, "chapter_id": 2330, "verse_number": "८-५१-२२", "content_sanskrit": "तमविध्यदमेयात्मा तव पुत्रो ह्यमर्पणः।\nपाञ्चाल्यं पञ्चविंशत्या प्रहस्य पुरुषर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2062447, "chapter_id": 2330, "verse_number": "८-५१-२३", "content_sanskrit": "ततः पुनरमेयात्मा तव पुत्रो ह्यमर्षणः।\nविद्ध्वा ननाद पाञ्चाल्यं षष्ट्या पञ्चभिरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2062448, "chapter_id": 2330, "verse_number": "८-५१-२४", "content_sanskrit": "तथास्य सशरं चापं मुष्टिदेशे विशाम्पते।\nक्षुरप्रेण सुतीक्ष्णेन राजा चिच्छेद संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2062449, "chapter_id": 2330, "verse_number": "८-५१-२५", "content_sanskrit": "तदपास्य धनुश्छिन्नं पाञ्चाल्यः शत्रुकर्शनः।\nअन्यदादत्त वेगेन धनुर्भारसहं नवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2062450, "chapter_id": 2330, "verse_number": "८-५१-२६", "content_sanskrit": "क्रोधाद्रुधिररक्ताक्षः संरम्भात्प्रज्वलन्निव।\nअशोभत महेष्वासो धृष्टद्युम्नः कृतव्रणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2062451, "chapter_id": 2330, "verse_number": "८-५१-२७", "content_sanskrit": "स पञ्चदश नाराचाञ्श्वसतः पन्नगानिव।\nजिघांसुर्भरतश्रेष्ठं धृष्टद्युम्नो व्यपासृजत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2062452, "chapter_id": 2330, "verse_number": "८-५१-२८", "content_sanskrit": "ते वर्म हेमविकृतं भित्त्वा राज्ञः शिलीमुखाः।\nविविशुर्वसुधां वेगात्कङ्कबर्हिणवाससः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2062453, "chapter_id": 2330, "verse_number": "८-५१-२९", "content_sanskrit": "सोऽतिविद्धो महाराज पुत्रस्तेऽतिव्यराजत।\nवसन्तकाले सुमहान्प्रफुल्ल इव किंशुकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2062454, "chapter_id": 2330, "verse_number": "८-५१-३०", "content_sanskrit": "स च्छिन्नवर्मा नाराचप्रहारैर्झर्झरीकृतः।\nधृष्टद्युम्नस्य भल्लेन क्रुद्धश्चिच्छेद कार्मुकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2062455, "chapter_id": 2330, "verse_number": "८-५१-३१", "content_sanskrit": "अथैनं छिन्नधन्वानं त्वरमाणो महीपतिः।\nसायकैर्दशभी राजन्भ्रुवोर्मध्ये समार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2062456, "chapter_id": 2330, "verse_number": "८-५१-३२", "content_sanskrit": "तस्य तेऽशोभयन्वक्त्रं कर्मारपरिमार्जिताः।\nप्रफुल्लं पङ्कजं यद्वद्धमरा मधुलिप्सवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2062457, "chapter_id": 2330, "verse_number": "८-५१-३३", "content_sanskrit": "तदपास्य धनुश्छिन्नं दृष्टद्युम्नो महामनाः।\nअन्यदादत्त वेगेन धनुर्भल्लांश्च षोडश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2062458, "chapter_id": 2330, "verse_number": "८-५१-३४", "content_sanskrit": "ततो दुर्योधनस्याश्वान्हत्वा सूतं च पञ्चभिः।\nधनुश्चिच्छेद भल्लेन जातरूपपरिष्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2062459, "chapter_id": 2330, "verse_number": "८-५१-३५", "content_sanskrit": "रथं सोपस्करं छत्रं शक्तिं खङ्गं गदां ध्वजम्।\nभल्लैश्चिच्छेद दशभिः पुत्रस्य तव पार्षतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2062460, "chapter_id": 2330, "verse_number": "८-५१-३६", "content_sanskrit": "तपनीयाङ्गदं छत्रं नागं मणिमयं शुभम्।\nध्वजं कुरुपतेश्छिन्नं ददृशुः सर्वपार्थिवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2062461, "chapter_id": 2330, "verse_number": "८-५१-३७", "content_sanskrit": "दुर्योधनं तु विरथं छिन्नवर्मायुधध्वजम्।\nभ्रातरं समुदैक्षन्त सोदरा भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2062462, "chapter_id": 2330, "verse_number": "८-५१-३८", "content_sanskrit": "तमारोप्य रथे राजन्कुण्डधारो महारथम्।\nअपाहरदसम्भ्रान्तो धृष्टद्युम्नस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2062463, "chapter_id": 2330, "verse_number": "८-५१-३९", "content_sanskrit": "कर्णस्तु सात्यकिं हित्वा राजगृघ्नुरमर्षणः।\nद्रोमहन्तारमुग्रेषुं ससाराभिमुखो रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2062464, "chapter_id": 2330, "verse_number": "८-५१-४०", "content_sanskrit": "तं पृष्ठतोऽन्वयात्तूर्णं शैनेयोऽभिहतः शरैः।\nवारणं जघनोपान्ते विषाणाभ्यामिव द्विपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2062465, "chapter_id": 2330, "verse_number": "८-५१-४१", "content_sanskrit": "स भारतपुरोगानां राज्ञां च सुमहात्मनाम्।\nकर्णपार्षतयोर्युद्वे सङ्क्रद्धानां महारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2062466, "chapter_id": 2330, "verse_number": "८-५१-४२", "content_sanskrit": "न पाण्डवानां नास्माकं कश्चिदासीत्पराङ्मुखः।\nप्रत्यदृश्यत यत्कर्णः पाञ्चालांस्त्वरितो ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2062467, "chapter_id": 2330, "verse_number": "८-५१-४३", "content_sanskrit": "तस्मिन्क्षणे नरश्रेष्ठ गजवाजिरथक्षयः।\nप्रादुरासीदुभयतो राजन्मध्यगतेऽहनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2062468, "chapter_id": 2330, "verse_number": "८-५१-४४", "content_sanskrit": "पाञ्चालास्तु महाराज त्वरिता विजिगीषवः।\nसर्वतोऽभ्यद्रवन्कर्णं पतत्त्रिण इव द्रुमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2062469, "chapter_id": 2330, "verse_number": "८-५१-४५", "content_sanskrit": "तेषामाधिरथिः क्रुद्धः प्रधानान्वै तरस्विनः।\nविचिन्वन्निव बाणौघैः समासादयदग्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2062470, "chapter_id": 2330, "verse_number": "८-५१-४६", "content_sanskrit": "व्याघ्रकेतुः सुशर्मा च शुक्रश्चित्रायुधः क्रतुः।\nदुर्जयो रोचमानश्च सिंहसेनस्तथाऽष्टमः।\nमहता रथवंशेन परिवव्रुर्नरोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2062471, "chapter_id": 2330, "verse_number": "८-५१-४७", "content_sanskrit": "सृजन्तः सायकांस्तूर्णं कर्णमाहवशोभिनम्।\nयतमानांस्तु ताञ्शूरान्मनुजेन्द्रः शितैः शरैः।\nअष्टाभिरष्टौ राधेयः पाञ्चालान्न्यहनद्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2062472, "chapter_id": 2330, "verse_number": "८-५१-४८", "content_sanskrit": "अथापरान्महाराज सूतपुत्रः प्रतापवान्।\nजघान बहुसाहस्रान्योधान्युद्वविशारदान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2062473, "chapter_id": 2330, "verse_number": "८-५१-४९", "content_sanskrit": "विष्णुं च विष्णुवर्माणं देवापिं भद्रमेव च।\nदण्डधारं च समरे चित्रं चिंत्रायुधं हरिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2062474, "chapter_id": 2330, "verse_number": "८-५१-५०", "content_sanskrit": "सिंहकेतुं रोचमानं शलभं च महारथम्।\nनिजघान सुसङ्क्रुद्वश्चेदीनां च महारथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2062475, "chapter_id": 2330, "verse_number": "८-५१-५१", "content_sanskrit": "तेषामाददतः प्राणानासीदाधिरथेर्वपुः।\nशोणिताभ्युक्षिताङ्गस्य रुद्रस्यैवातिभैरवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2062476, "chapter_id": 2330, "verse_number": "८-५१-५२", "content_sanskrit": "तत्र भारत कर्णेन मातङ्गास्ताडिताः शरैः।\nसर्वतोऽभ्यद्रवन्भीताः कुर्वन्तो महदाकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2062477, "chapter_id": 2330, "verse_number": "८-५१-५३", "content_sanskrit": "निपेतुरुर्व्यां समरे कर्णसायकताडिताः।\nकुर्वन्तो विविधान्नादान्वज्रनुन्ना इवाचलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2062478, "chapter_id": 2330, "verse_number": "८-५१-५४", "content_sanskrit": "गजवाजिमनुष्यैश्च निपतद्भिः समन्ततः।\nरथैर्भग्नैर्ध्वजैश्चैव समास्तीर्यत मेदिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2062479, "chapter_id": 2330, "verse_number": "८-५१-५५", "content_sanskrit": "नैवं भाष्मो न च द्रोणो नान्ये युधि च तावकाः।\nचक्रुः स्म तादृशं कर्म यादृशं कृतवान्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2062480, "chapter_id": 2330, "verse_number": "८-५१-५६", "content_sanskrit": "मृगमध्ये यथा सिंहो दृश्यते निर्भयश्चरन्।\nपाञ्चालानां तथा मध्ये कर्णोऽचरदभीतवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2062481, "chapter_id": 2330, "verse_number": "८-५१-५७", "content_sanskrit": "सूतपुत्रोऽथ नागेषु हयेषु च रथेषु च।\nनरेषु च नरव्याघ्रश्चकार कदनं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2062482, "chapter_id": 2330, "verse_number": "८-५१-५८", "content_sanskrit": "यथा मृगगणांस्त्रस्तान्सिंहो द्रावयते दिशः।\nपाञ्चालानां रथव्रातान्कर्णो व्यद्रावयत्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2062483, "chapter_id": 2330, "verse_number": "८-५१-५९", "content_sanskrit": "सिंहं स्म हि यथा प्राप्य न जीवन्ति मृगाः क्वचित्।\nतथा कर्णमनुप्राप्ता न जीवन्ति स्म सृञ्जयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2062484, "chapter_id": 2330, "verse_number": "८-५१-६०", "content_sanskrit": "वैश्वानरमुखं प्राप्य दह्यन्ते शलभा यथा।\nकर्णाग्रिं समरे प्राप्य दग्धा भारत सृञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2062485, "chapter_id": 2330, "verse_number": "८-५१-६१", "content_sanskrit": "चेदिष्वेकेन कर्णेन पाञ्चालेषु च भारत।\nवेश्राव्य नाम निहता बहवः शूरसम्पताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2062486, "chapter_id": 2330, "verse_number": "८-५१-६२", "content_sanskrit": "मम चासीन्मती राजन्दृष्ट्वा कर्णस्य विक्रमम्।\nनैकोऽप्याधिरथेर्जीवन्पाञ्चाल्यो मोक्ष्यते युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2062487, "chapter_id": 2330, "verse_number": "८-५१-६३", "content_sanskrit": "सङ्ख्ये विमर्द्य पाञ्चालान्सूतपुत्रः पुनः पुनः।\nअभ्यधावत्सुसङ्क्रुद्धः कुन्तीपुत्रं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2062488, "chapter_id": 2330, "verse_number": "८-५१-६४", "content_sanskrit": "धृष्टद्युम्नश्च राजानं द्रौपदेयाश्च मारिष।\nपरिवव्रुरमित्रघ्नं शतशश्चापरे जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2062489, "chapter_id": 2330, "verse_number": "८-५१-६५", "content_sanskrit": "शिखण्डी सहदेवश्च नकुलो नाकुलिस्तथा।\nजनमेजयः शिनेर्नप्ता बहवश्च प्रभद्रकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2062490, "chapter_id": 2330, "verse_number": "८-५१-६६", "content_sanskrit": "एते पुरोगमा भूत्वा धृष्टद्युम्नश्च संयुगे।\nकर्णमस्यन्तमिष्वस्त्रैस्ततक्षुरमितौजसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2062491, "chapter_id": 2330, "verse_number": "८-५१-६७", "content_sanskrit": "तांस्तत्राधिरथिः सङ्ख्ये चेदिपाञ्चालपाण्डवान्।\nएको बहूनभ्यपतद्गरुत्मानिव पन्नगान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2062492, "chapter_id": 2330, "verse_number": "८-५१-६८", "content_sanskrit": "तैः कर्णस्याभवद्युद्धं घोररूपं विशाम्पते।\nतादृग्यादृक्पुरावृत्तं देवानां दानवैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2062493, "chapter_id": 2330, "verse_number": "८-५१-६९", "content_sanskrit": "तान्समेतान्महेष्वासाञ्शरवर्षौधवर्षिणः।\nएको व्यधमदव्यग्रस्तमांसीव दिवाकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2062494, "chapter_id": 2330, "verse_number": "८-५१-७०", "content_sanskrit": "भीमसेनस्तु संसक्ते राधेये पाण्डवैः सह।\nसर्वतोऽभ्यहनत्क्रुद्धो यमदण्डनिभैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2062495, "chapter_id": 2330, "verse_number": "८-५१-७१", "content_sanskrit": "बाह्लीकान्केकयान्मात्स्यान्वासात्यान्मद्रसैन्धवान्।\nएकः सङ्ख्ये महेष्वासो योधयन्बह्वशोभत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2062496, "chapter_id": 2330, "verse_number": "८-५१-७२", "content_sanskrit": "तत्र मर्मसु भीमेन नाराचैस्ताडिता गजाः।\nप्रपतन्तो हतारोहाः कम्पयन्ति स्म मेदिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2062497, "chapter_id": 2330, "verse_number": "८-५१-७३", "content_sanskrit": "वाजिनश्च हतारोहाः पत्तयश्च गतासवः।\nअशेरत महाराज वमन्तो रुधिरं बहु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2062498, "chapter_id": 2330, "verse_number": "८-५१-७४", "content_sanskrit": "ताडिताः सहसा नागा भीमसेनेन मारिष।\nनिपतन्ति महावेगा वज्ररुग्णा इवाचलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2062499, "chapter_id": 2330, "verse_number": "८-५१-७५", "content_sanskrit": "पतितैस्तैर्महाराज वेगवद्भिर्महारथैः।\nशुशुभे वसुधा राजन्विकीर्णैरिव पर्वतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2062500, "chapter_id": 2330, "verse_number": "८-५१-७६", "content_sanskrit": "सहस्रशश्च रथिनः पत्तयः पतितायुधाः।\nअक्षताः समदृश्यन्त भीमाद्भीता गतासवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2062501, "chapter_id": 2330, "verse_number": "८-५१-७७", "content_sanskrit": "रथिभिः सादिभिः सूतैः पादातैर्वाजिभिर्गजैः।\nभीमसेनशरैश्छिन्नैराच्छन्ना सुधाभवत्॥\nतत्स्तम्भितमिवातिष्ठद्भीमसेनभयार्दितम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2062502, "chapter_id": 2330, "verse_number": "८-५१-७८", "content_sanskrit": "दुर्योधनबलं सर्वं निरुत्साहं कृतं रणे।\nनिश्चेष्टं तुमुलं दीनं बभौ तस्मिन्महारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2062503, "chapter_id": 2330, "verse_number": "८-५१-७९", "content_sanskrit": "प्रसन्नसलिले काले यथा स्यात्सागरो नृप।\nतद्वत्तव बलं तद्वै निश्चलं समवस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2062504, "chapter_id": 2330, "verse_number": "८-५१-८०", "content_sanskrit": "मन्युवीर्यबलोपेतं दर्पात्प्रत्यवरोपितम्।\nअभवत्तव पुत्रस्य तत्सैन्यं निष्प्रभं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2062505, "chapter_id": 2330, "verse_number": "८-५१-८१", "content_sanskrit": "ते बले भरतश्रेष्ठ वध्यमाने परस्परम्।\nरुधिरौघपरिक्लिन्ने रुधिरार्द्रे बभूवतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2062506, "chapter_id": 2330, "verse_number": "८-५१-८२", "content_sanskrit": "सूतपुत्रोऽवधीत्क्रुद्वः पाण्डवानामनीकिनीम्।\nभीमसेनः कुरूणां च त्रिगर्तानां धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2062507, "chapter_id": 2330, "verse_number": "८-५१-८३", "content_sanskrit": "वर्तमाने तथा रोद्रे सङ्ग्रामेऽद्भुतदर्शने।\nनिहत्य पृतनामध्यं संशप्तकगणान्बहून्।\nअर्जुनो जयतां श्रेष्ठो वासुदेवमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2062508, "chapter_id": 2330, "verse_number": "८-५१-८४", "content_sanskrit": "प्रभग्नं बलमेतद्धि योत्स्यमानं मया सह।\nएते धावन्ति सगणाः संशप्तकमहारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2062509, "chapter_id": 2330, "verse_number": "८-५१-८५", "content_sanskrit": "`दुर्जया ह्येव समरे देवैरपि सवासवैः।\nअपारयन्तो मद्बाणान्सिंहशब्दं मृगा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2062510, "chapter_id": 2330, "verse_number": "८-५१-८६", "content_sanskrit": "दीर्यते च महत्सैन्यं सृञ्जयानां महारणे।\n`कुरवश्चाभिधावन्ति भीमसेनभयार्दिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2062511, "chapter_id": 2330, "verse_number": "८-५१-८७", "content_sanskrit": "हस्तिकक्ष्यो ह्यसौ कृष्ण केतुः कर्णस्य धीमतः।\nदृश्यते राजसैन्यस्य मध्ये विचरतो मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2062512, "chapter_id": 2330, "verse_number": "८-५१-८८", "content_sanskrit": "न च कर्णं रणे शक्ता जेतुमेते महारथाः।\nजानीते हि भवान्कर्णं वीर्यवन्तं पराक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2062513, "chapter_id": 2330, "verse_number": "८-५१-८९", "content_sanskrit": "तत्र याहि यतः कर्णो द्रावयत्येष नो बलम्।\nत्रिगर्तान्वर्जयन्याहि सूतपुत्रं महारथम्।\nएतन्मे रोचते कृष्ण यथा वा तव रोचते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2062514, "chapter_id": 2330, "verse_number": "८-५१-९०", "content_sanskrit": "एतच्छ्रुत्वा वचस्तस्य गोविन्दः प्रहसन्निव।\nअब्रवीदर्जुनं तूर्णं कौरवान्याहि पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2062515, "chapter_id": 2330, "verse_number": "८-५१-९१", "content_sanskrit": "ततस्तव महासैन्यं गोविन्दप्रेरिता हयाः।\nहंसवर्णा विशंस्तूर्णं वहन्तोऽर्जुनमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2062516, "chapter_id": 2330, "verse_number": "८-५१-९२", "content_sanskrit": "केशवप्रेरितैरश्वैः श्वेतैः काञ्चनभूषणैः।\nप्रविशद्भिस्तव बलं चतुर्दिशमदीर्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2062517, "chapter_id": 2330, "verse_number": "८-५१-९३", "content_sanskrit": "मेघस्तनितनिर्हादः स रथो वानरध्वजः।\nचलत्पताकस्तां सेनां विमानं द्यामिवाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2062518, "chapter_id": 2330, "verse_number": "८-५१-९४", "content_sanskrit": "तौ विदार्य महासेनां प्रविष्टौ केशवार्जुनो।\nक्रुद्धौ संरम्भरक्ताक्षौ विभ्राजेतां महाद्युती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2062519, "chapter_id": 2330, "verse_number": "८-५१-९५", "content_sanskrit": "युद्धशौण्डौ समाहूतावागतौ तौ रणाध्वरम्।\nयज्वभिर्विधिना हूतौ मखं देवाविवाश्विनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2062520, "chapter_id": 2330, "verse_number": "८-५१-९६", "content_sanskrit": "`क्रोधताम्रेक्षणौ शूरौ शुशुभाते महाबलौ।\nमदोत्कटौ यथा नागौ दृष्टिसञ्चारचारिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2062521, "chapter_id": 2330, "verse_number": "८-५१-९७", "content_sanskrit": "क्रुद्धौ तौ तु नरव्याघ्रो योगवन्तौ बभूवतुः।\nतलशब्देन रुषितौ महानागाविवोत्कटौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2062522, "chapter_id": 2330, "verse_number": "८-५१-९८", "content_sanskrit": "विगाह्य तु रथानीकमश्वसङ्घांश्च फल्गुनः।\nव्यचरत्पृतनामध्ये पाशहस्त इवानत्कः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2062523, "chapter_id": 2330, "verse_number": "८-५१-९९", "content_sanskrit": "तं दृष्ट्वा युधि विक्रान्तं सेनायां तव भारत।\nसंशप्तकगणान्भूयः पुत्रस्ते समचूचुदत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2062524, "chapter_id": 2330, "verse_number": "८-५१-१००", "content_sanskrit": "ततो रथसहस्रेण द्विरदानां त्रिभिः शतैः।\nचतुर्दशसहस्रैस्तु तुरगाणां महाहवे।\nद्वाभ्यां शतसहस्राभ्यां पदातीनां च धन्विनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2062525, "chapter_id": 2330, "verse_number": "८-५१-१००", "content_sanskrit": "शूराणां लब्धलक्षाणां विदितानां समन्ततः।\nअभ्यवर्तन्त कौन्तेयं छादयन्तो महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2062526, "chapter_id": 2330, "verse_number": "८-५१-१०१", "content_sanskrit": "शरवर्षैर्महाराज सर्वतः पाण्डुनन्दनम्।\nस च्छाद्यमानः समरे शरैः परबलार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2062527, "chapter_id": 2330, "verse_number": "८-५१-१०२", "content_sanskrit": "दर्शयन्रौद्रमात्मानं पाशहस्त इवान्तकः।\nनिघ्नन्संशप्तकान्पार्थः प्रेक्षणीयतरोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2062528, "chapter_id": 2330, "verse_number": "८-५१-१०३", "content_sanskrit": "ततो विद्युत्प्रभैर्बाणैः कार्तस्वरविभूषितैः।\nनिरन्तरमिवाकाशमासीच्छन्नं किरीटिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2062529, "chapter_id": 2330, "verse_number": "८-५१-१०४", "content_sanskrit": "किरीटिचापनिर्मुक्तैः सम्पतद्भिर्महाशरैः।\nसमाच्छन्नं बभौ सर्वं काद्रवेयैरिव प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2062530, "chapter_id": 2330, "verse_number": "८-५१-१०५", "content_sanskrit": "रुक्मपुङ्खाञ्शरान्घोरान्प्रसन्नान्नतपर्वणः।\nअवासृजदमेयात्मा दिक्षु सर्वासु पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2062531, "chapter_id": 2330, "verse_number": "८-५१-१०६", "content_sanskrit": "मही वियद्दिशः सर्वाः समुद्रा गिरयोऽपि वा।\nस्फुटन्तीति जना जज्ञुः पार्थस्य तलनिःस्वनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2062532, "chapter_id": 2330, "verse_number": "८-५१-१०७", "content_sanskrit": "हत्वा दशसहस्राणि पार्थिवानां महारथः।\nसंशप्तकानां कौन्तेयः प्रपक्षं त्वरितोभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2062533, "chapter_id": 2330, "verse_number": "८-५१-१०८", "content_sanskrit": "प्रपक्षं च समासाद्य पार्थः काम्भोजरक्षितम्।\nप्रममाथ बलं भल्लैर्दानवानिव वासवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2062534, "chapter_id": 2330, "verse_number": "८-५१-१०९", "content_sanskrit": "प्रचिच्छेदाशु भल्लेन द्विषतामाततायिनाम्।\nशस्त्रपाणींस्तथा बाहूंस्तथापि च शिरांस्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2062535, "chapter_id": 2330, "verse_number": "८-५१-११०", "content_sanskrit": "अङ्गांङ्गावयवैश्छिन्नैर्व्यायुधास्तेऽपतन्भुवि।\nविष्वग्वाताभिसम्भग्ना बहुशाखा इव द्रुमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2062536, "chapter_id": 2330, "verse_number": "८-५१-११२", "content_sanskrit": "हस्त्यश्वरथपत्तीनां व्रातान्निघ्नन्तमर्जुनम्।\nसुदक्षिणादवरजः शरवृष्ट्याभ्यवीवृषत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2062537, "chapter_id": 2330, "verse_number": "८-५१-११३", "content_sanskrit": "तस्यास्यतोऽर्धचन्द्राभ्यां स बाहू परिघोपमौ।\nपूर्णचन्द्राभवक्त्रं च क्षुरेणापाहरच्छिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2062538, "chapter_id": 2330, "verse_number": "८-५१-११४", "content_sanskrit": "तत्पपात ततो वेगात्स्वलोहितपरिष्कृतम्।\nमनः शिलागिरेः शृङ्गं व्ज्रेणेवावदारितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2062539, "chapter_id": 2330, "verse_number": "८-५१-११५", "content_sanskrit": "सुदक्षिणादवरजं काम्भोजा ददृशुर्हतम्।\nप्रांशुं कमलपत्राक्षमत्यर्थं प्रियदर्शनम्।\nकाञ्चनस्तम्भसदृशं भिन्नं हेमगिरिं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2062540, "chapter_id": 2330, "verse_number": "८-५१-११६", "content_sanskrit": "ततोऽभवत्पुनर्युद्धं घोरमत्यर्थमद्भुतम्।\nनानावस्थाश्च योधानां बभूवुस्तत्र युध्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2062541, "chapter_id": 2330, "verse_number": "८-५१-११७", "content_sanskrit": "पार्थेषुनिहतैरश्वैः काम्भोजैर्यवनैः शकैः।\nशोणिताक्तैस्तदा रक्तं सर्वामासीद्विशां पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2062542, "chapter_id": 2330, "verse_number": "८-५१-११८", "content_sanskrit": "रथैर्हताश्वसूतैश्च हतारोहैश्च वाजिभिः।\nद्विरदैश्च हतारोहैर्महामात्रैर्हतद्विपैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2062543, "chapter_id": 2330, "verse_number": "८-५१-११९", "content_sanskrit": "अन्योन्येन महाराज विनाशः पृथिवीक्षिताम्।\nआसीत्क्रुद्वेऽर्जुने कर्णे भीमसेने च दारुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2062544, "chapter_id": 2330, "verse_number": "८-५१-१२०", "content_sanskrit": "तस्पिन्प्रपक्षे पक्षे च वध्यमाने मदोत्कटः।\nअर्जुनं जयतां श्रेष्ठं त्वरितो द्रौणिरभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2062545, "chapter_id": 2330, "verse_number": "८-५१-१२१", "content_sanskrit": "विधुन्वानो महच्चापं कार्तस्वरविभूषितम्।\nआददानः शरान्घोरान्स्वरश्मीनिव भास्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2062546, "chapter_id": 2330, "verse_number": "८-५१-१२२", "content_sanskrit": "तयोरासीन्महद्युद्धं धर्मभ्रात्रोरनैष्ठिकम्।\nविस्मापयिषतोर्लोकं यशश्चोत्तममिच्छतोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2062547, "chapter_id": 2330, "verse_number": "८-५१-१२३", "content_sanskrit": "संशप्तकांस्तु कौन्तेयः कुरूंश्चापि वृकोदरः।\nसूतपुत्रस्तु पाञ्चालांस्त्रयोऽघ्नंस्त्वरिताः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2062548, "chapter_id": 2330, "verse_number": "८-५१-१२४", "content_sanskrit": "एवमेष महाराज विनाशः पृथिवीक्षिताम्।\nयुद्वं घोरं तथा त्वासीत्त्रिधाभूते चमूमुखे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2062549, "chapter_id": 2330, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे एकपञ्चाशोऽध्यायः॥ ५१ ॥ *.एतदनन्तरं झ.पुस्तके विद्यमाना कथा अस्मिन्पाठे---५७--५८ तमाध्याययोर्वर्तते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}]