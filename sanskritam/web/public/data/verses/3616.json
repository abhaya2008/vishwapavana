[{"id": 2121945, "chapter_id": 3616, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2121946, "chapter_id": 3616, "verse_number": "१", "content_sanskrit": "ततः सागरसङ्काशं दृष्ट्वा नृपतिसागरम् ।\nरोषात् प्रचलितं सर्वमिदमाह युधिष्ठिरः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2121947, "chapter_id": 3616, "verse_number": "२", "content_sanskrit": "भीष्मं मतिमतां श्रेष्ठं वृद्धं कुरुपितामहम् ।\nप्रजापतिं बृहत्तेजाः शतक्रतुरिवारिहन् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2121948, "chapter_id": 3616, "verse_number": "३", "content_sanskrit": "असौ रोषात् प्रचलितो महान् नृपतिसागरः ।\nअत्र यत् प्रतिवक्तव्यं तन्मे ब्रूहि पितामह ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2121949, "chapter_id": 3616, "verse_number": "४", "content_sanskrit": "यज्ञस्य च न विघ्नः स्यात् प्रजानां च हितं भवेत् ।\nयथा सर्वत्र तत्सर्वं ब्रूहि मह्यं पितामह ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2121950, "chapter_id": 3616, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2121951, "chapter_id": 3616, "verse_number": "५", "content_sanskrit": "इत्युक्तवति धर्मिष्ठे धर्मराजे युधिष्ठिरे ।\nउवाचेदं वचस्तदा भीष्मः कुरुपितामहः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2121952, "chapter_id": 3616, "verse_number": "६", "content_sanskrit": "मा भैस्त्वं कुरुशार्दूल श्वा सिंहं हन्तुमर्हति ।\nशिवः पन्थास्तु भीमोऽत्र मया पूर्वतरं वृतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2121953, "chapter_id": 3616, "verse_number": "७", "content_sanskrit": "प्रसुप्ते हि यथा सिंहे श्वानस्तात समागताः ।\nभषेयुः सहिताः सर्वे तथैव वसुधाधिपाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2121954, "chapter_id": 3616, "verse_number": "८", "content_sanskrit": "वृष्णिसिंहस्य सुप्तस्य तथेमेऽभिमुखाः स्थिताः ।\nभषन्ते मृगसङ्काशा श्वानः सिंहस्य सन्निधौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2121955, "chapter_id": 3616, "verse_number": "९", "content_sanskrit": "न हि सम्बुध्यते यावत् सुप्तः सिंह इवाच्युतः ।\nतदिदं ज्ञातपूर्वं हि तव संस्तोतुमिच्छतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2121956, "chapter_id": 3616, "verse_number": "१०", "content_sanskrit": "तेन सिंहीकरोत्येष असिंहांश्चेदिपुङ्गवः ।\nपार्थिवान् पार्थिवाध्यक्षः शिशुपालोऽल्पचेतनः ।\nसर्वान् सर्वात्मना तात नेतुकामो यमक्षयम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2121957, "chapter_id": 3616, "verse_number": "११", "content_sanskrit": "नूनमेतत् समादातुं पुनरिच्छत्यधोक्षजः ।\nयदत्र शिशुपालस्थं तेजस्तिष्ठति भारत ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2121958, "chapter_id": 3616, "verse_number": "१२", "content_sanskrit": "विप्लुता चास्य भद्रं ते बुद्धिर्बुद्धिमतां वर ।\nचेदिराजस्य कौन्तेय सर्वेषां च महीक्षिताम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2121959, "chapter_id": 3616, "verse_number": "१३", "content_sanskrit": "आदातुं पुण्डरीकाक्ष एष इच्छति यं यदा ।\nतस्य विप्लवते बुद्धिरेवं चेदिपतेर्यथा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2121960, "chapter_id": 3616, "verse_number": "१४", "content_sanskrit": "चतुर्विधानां भूतानां त्रिषु लोकेषु माधवः ।\nप्रभवश्चैव भूतानां निधनं च युधिष्ठिर ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2121961, "chapter_id": 3616, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2121962, "chapter_id": 3616, "verse_number": "समाप्तिः", "content_sanskrit": "इति तस्य वचः श्रुत्वा तथा चेदिपतिर्नृपः ।\nभीष्मं रूक्षाक्षरा वाचः श्रावयामास भारत ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2121963, "chapter_id": 3616, "verse_number": "२७", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां सभापर्वर्णि\nअष्टपञ्चाशोऽध्यायः ॥५८॥\n॥ अर्घाभिहरणपर्वणि सप्तविंशोऽध्यायः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2121964, "chapter_id": 3616, "verse_number": "", "content_sanskrit": "॥ समाप्तम् अर्घाहरणपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2121965, "chapter_id": 3616, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]