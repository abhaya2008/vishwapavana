[{"id": 2172694, "chapter_id": 4679, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2172695, "chapter_id": 4679, "verse_number": "१", "content_sanskrit": "तथा हिमवतः प्रस्थे सर्वे युद्धाभिनन्दिनः ।\nसर्वे एव महाराज योधास्तत्र समागताः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2172696, "chapter_id": 4679, "verse_number": "२", "content_sanskrit": "शल्यश्च चित्रसेनश्च शकुनिश्च महारथः ।\nअश्वत्थामा कृपश्चैव कृतवर्मा च सात्वतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2172697, "chapter_id": 4679, "verse_number": "३", "content_sanskrit": "सुषेणोऽरिष्टसेनश्च धृतसेनश्च वीर्यवान् ।\nजयत्सेनश्च राजानः ते रात्रिमुषितास्ततः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2172698, "chapter_id": 4679, "verse_number": "४", "content_sanskrit": "रणे कर्णे हते वीरे त्रासिता जितकाशिभिः ।\nनालभन् शर्म ते पुत्रा हिमवन्तमृते गिरिम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2172699, "chapter_id": 4679, "verse_number": "५", "content_sanskrit": "तेऽब्रुवन् सहितास्तत्र राजानं सैन्यसन्निधौ ।\nकृतयत्ना रणे राजन् सम्पूज्य विधिवद् तदा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2172700, "chapter_id": 4679, "verse_number": "", "content_sanskrit": "सैनिकाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2172701, "chapter_id": 4679, "verse_number": "६", "content_sanskrit": "कृत्वा सेनाप्रणेतारं परांस्त्वं योद्धुमर्हसि\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2172702, "chapter_id": 4679, "verse_number": "७", "content_sanskrit": "येनाभिगुप्ता यास्यामो जयेमासुहृदो वयम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2172703, "chapter_id": 4679, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2172704, "chapter_id": 4679, "verse_number": "८", "content_sanskrit": "ततो दुर्योधनः स्थित्वा रणे रथवरोत्तमे ।\nसर्वसत्त्वविभागज्ञमन्तकप्रतिमं रणे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2172705, "chapter_id": 4679, "verse_number": "९", "content_sanskrit": "स्वाङ्गप्रच्छन्नशिरसं कम्बुग्रीवं प्रियंवदम् ।\nव्याकोचपद्माभमुखं व्याघ्रास्यं मेरुगौरवम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2172706, "chapter_id": 4679, "verse_number": "१०", "content_sanskrit": "शम्भोर्वृषस्य सदृशं स्कन्धनेत्रगतिस्वरैः ।\nपुष्टश्लिष्टायतभुजं सुविस्तीर्णोरसं शुभम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2172707, "chapter_id": 4679, "verse_number": "११", "content_sanskrit": "जवे बले च सदृशमरुणानुजवातयोः ।\nआदित्यस्य त्विषा तुल्यं बुद्ध्या चोशनसा समम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2172708, "chapter_id": 4679, "verse_number": "१२", "content_sanskrit": "कान्तिरूपमुखैश्वर्यैः त्रिभिश्चन्द्रमसोपमम् ।\nकाञ्चनोपलसङ्घातसदृशं क्लिष्टसन्धिकम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2172709, "chapter_id": 4679, "verse_number": "१३", "content_sanskrit": "सुवृत्तोरुकटीजङ्घं सुपादं स्वङ्गुलीयकम् ।\nस्मृत्वा स्मृत्वैव च गुणान् धात्रा यत्नेन निर्मितम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2172710, "chapter_id": 4679, "verse_number": "१४", "content_sanskrit": "सर्वलक्षणसम्पूर्णं निपुणं श्रुतिसागरम् ।\nजेतारं तरसाऽरीणामजय्यं शत्रुभिर्बलात्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2172711, "chapter_id": 4679, "verse_number": "१५", "content_sanskrit": "प्रयोगबलसंहारप्रायश्चित्तं सुमङ्गलम् ।\nप्रयोगविनियोगौ च स्मृतिं यस्य गुणान् विदुः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2172712, "chapter_id": 4679, "verse_number": "१६", "content_sanskrit": "दशाङ्गं यश्चतुष्पादमिष्वस्त्रं वेद तत्त्वदः ।\nसाङ्गाश्च चतुरो वेदान् सम्यगाख्यानपञ्चमान्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2172713, "chapter_id": 4679, "verse_number": "१७", "content_sanskrit": "आराध्य त्र्यम्बकं यत्नाद् व्रतैरुग्रैर्महातपाः ।\nलब्धवानस्त्रजालं च शिक्षां च शशिशेखरात्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2172714, "chapter_id": 4679, "verse_number": "१८", "content_sanskrit": "अयोनिजायामुत्पन्नो द्रोणेनायोनिजेन यः ।\nतमप्रतिमकर्माणं रूपेणाप्रतिमं भुवि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2172715, "chapter_id": 4679, "verse_number": "१९", "content_sanskrit": "पारगं सर्वविद्यानां गुणवन्तमनिन्दितम् ।\nतं समेत्यात्मनस्तुल्यमश्वत्थामानमब्रवीत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2172716, "chapter_id": 4679, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2172717, "chapter_id": 4679, "verse_number": "२०", "content_sanskrit": "यं पुरस्कृत्य सहिता युधि जेष्याम पाण्डवान् ।\nगुरुपुत्रोऽद्य सर्वेषामस्माकं परमा गतिः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2172718, "chapter_id": 4679, "verse_number": "२१", "content_sanskrit": "भवांस्तस्मान्नियोगात् ते कोऽस्तु सेनापतिर्मम\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2172719, "chapter_id": 4679, "verse_number": "", "content_sanskrit": "दौणिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2172720, "chapter_id": 4679, "verse_number": "२२", "content_sanskrit": "अयं कुलेन वीर्येण तेजसा यशसा श्रिया ।\nसर्वैर्गुणैः समुदितः शल्यो नोऽस्तु चमूपतिः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2172721, "chapter_id": 4679, "verse_number": "२३", "content_sanskrit": "भागिनेयान् निजांस्त्यक्त्वा कृतज्ञोऽस्मानुपागतः ।\nमहासेनो महाबाहुः महासेन इवापरः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2172722, "chapter_id": 4679, "verse_number": "२४", "content_sanskrit": "तं तु सेनापतिं मन्ये नृपतिं नृपसत्तम ।\nशक्यः प्राप्तुं जयोऽस्माभिर्देवैः स्कन्दमिवोर्जितम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2172723, "chapter_id": 4679, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2172724, "chapter_id": 4679, "verse_number": "२५", "content_sanskrit": "तथोक्ते द्रोणपुत्रेण सर्व एव नराधिपाः ।\nपरिवार्य स्थिताः शल्यं जयशब्दं च चक्रिरे\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2172725, "chapter_id": 4679, "verse_number": "२६", "content_sanskrit": "युद्धाय च मनश्चक्रुरावेशं च परं ययुः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2172726, "chapter_id": 4679, "verse_number": "२७", "content_sanskrit": "ततो दुर्योधनः शल्यं भूमौ स्थित्वा रथे स्थितम् ।\nप्रोवाच प्राञ्जलिर्भूत्वा शल्यं भीष्मसमं रणे\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2172727, "chapter_id": 4679, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2172728, "chapter_id": 4679, "verse_number": "२८", "content_sanskrit": "अयं स कालः सम्प्राप्तो मित्राणां मित्रसत्तम ।\nयत्र मित्रममित्रं वा परीक्षन्ते बुधा जनाः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2172729, "chapter_id": 4679, "verse_number": "२९", "content_sanskrit": "स भवानस्तु नः शूरः प्रणेता वाहिनीमुखे\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2172730, "chapter_id": 4679, "verse_number": "३०", "content_sanskrit": "रणं तु याते भवति पाण्डवा मन्दचेतसः ।\nभविष्यन्ति सहामात्याः सबला अपि दुर्बलाः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2172731, "chapter_id": 4679, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2172732, "chapter_id": 4679, "verse_number": "३१", "content_sanskrit": "यत्तु मां मन्यसे राजन् कुरुराज करोमि तत् ।\nत्वत्प्रियार्थं हि मे सर्वं प्राणा राज्यं धनानि च\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2172733, "chapter_id": 4679, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2172734, "chapter_id": 4679, "verse_number": "३२", "content_sanskrit": "सेनापत्यं तु वरये त्वामहं मातुलातुलम् ।\nसोऽस्मान् पाहि युधां श्रेष्ठ स्कन्दो देवानिवाहवे\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2172735, "chapter_id": 4679, "verse_number": "३३", "content_sanskrit": "अभिषिञ्च(च्य)स्व राजेन्द्र देवानामिव पावकिः ।\nजहि शत्रून् रणे वीर महेन्द्रो दानवानिव\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2172736, "chapter_id": 4679, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशल्यपर्वणि षष्ठोऽध्यायः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2172737, "chapter_id": 4679, "verse_number": "", "content_sanskrit": "शल्यवधपर्वणि षष्ठोऽध्यायः ॥६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]