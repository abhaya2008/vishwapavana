[{"id": 2054909, "chapter_id": 2202, "verse_number": "७-१२९-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2054910, "chapter_id": 2202, "verse_number": "७-१२९-१", "content_sanskrit": "निनदन्तं तथा तं तु भीमसेनं महाबलम्।\nमेघस्तनितनिर्घोषं के वीराः पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2054911, "chapter_id": 2202, "verse_number": "७-१२९-२", "content_sanskrit": "न हि पश्याम्यहं तं वै त्रिषु लोकेषु कञ्चन।\nक्रुद्धस्य भीमसेनस्य यस्तिष्ठेदग्रतो रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2054912, "chapter_id": 2202, "verse_number": "७-१२९-३", "content_sanskrit": "गदां युयुत्समानस्य कालस्येवेह सञ्चय।\nन हि पश्याम्यहं युद्धे यस्तिष्ठेदग्रतः पुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2054913, "chapter_id": 2202, "verse_number": "७-१२९-४", "content_sanskrit": "रथं रथेन यो हन्यात्कुञ्जरं कुञ्चरेण च।\nकस्तस्य समरे स्थाता साक्षादपि पुरन्दरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2054914, "chapter_id": 2202, "verse_number": "७-१२९-५", "content_sanskrit": "क्रुद्धस्य भीमसेनस्य मम पुत्राञ्जिघांसतः।\nदुर्योधनहिते युक्ताः समतिष्ठन्त केऽग्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2054915, "chapter_id": 2202, "verse_number": "७-१२९-६", "content_sanskrit": "भीमसेनदवाग्नेस्तु मम पुत्रांस्तृणोलपम्।\nप्रधक्ष्यतो रणमुखे केऽतिष्ठन्नग्रतो नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2054916, "chapter_id": 2202, "verse_number": "७-१२९-७", "content_sanskrit": "काल्यमानांस्तु पुत्रान्मे दृष्ट्वा भीमस्य संयुगे।\nकालेनेव प्रजाः सर्वाः के भीमं पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2054917, "chapter_id": 2202, "verse_number": "७-१२९-८", "content_sanskrit": "न मेऽर्जुनाद्भयं तादृक्कृष्णान्नापि च सात्वतात्।\nहुतभुग्जन्मनो नैव यादृग्भीमाद्भयं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2054918, "chapter_id": 2202, "verse_number": "७-१२९-९", "content_sanskrit": "भीमवह्नेः प्रदीप्तस्य मम पुत्रान्दिधक्षतः।\nके शूराः पर्यवर्तन्त तन्ममाचक्ष्व सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2054919, "chapter_id": 2202, "verse_number": "७-१२९-१०x", "content_sanskrit": "सञ्चय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2054920, "chapter_id": 2202, "verse_number": "७-१२९-१०", "content_sanskrit": "तथा तु नर्दमानं तं भीमसेनं महाबलम्।\nतुमुलेनैव शब्देन कर्णोऽप्यभ्यद्रवद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2054921, "chapter_id": 2202, "verse_number": "७-१२९-११", "content_sanskrit": "व्याक्षिपन्सुमहच्चापमतिमात्रममर्षणः।\nकर्णः सुयुद्धमाकाङ्क्षन्दर्शयिष्यन्बलं मृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2054922, "chapter_id": 2202, "verse_number": "७-१२९-१२", "content_sanskrit": "रुरोध मार्गं भीमस्य वातस्येव महीरुहः।\nभीमोऽपि दृष्ट्वा सावेगं पुरो वैकर्तनं स्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2054923, "chapter_id": 2202, "verse_number": "७-१२९-१३", "content_sanskrit": "चुकोप बलवद्वीरश्चिक्षेपास्य शिलाशितान्।\nतान्प्रत्यगृह्णात्कर्णोऽपि प्रतीपं प्रापयच्छरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2054924, "chapter_id": 2202, "verse_number": "७-१२९-१४", "content_sanskrit": "ततस्तु सर्वयोधानां यतनां प्रेक्षतां तदा।\nप्रावेपन्निव गात्राणि कर्णभीमसमागमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2054925, "chapter_id": 2202, "verse_number": "७-१२९-१५", "content_sanskrit": "रथिनां सादिनां चैव तयोः श्रुत्वा तलस्वनम्।\nभीमसेनस्य निनदं श्रुत्वा घोरं रणाजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2054926, "chapter_id": 2202, "verse_number": "७-१२९-१६", "content_sanskrit": "खं च भूमिं च संरुद्धां मेनिरे क्षत्रियर्षभाः।\nपुनर्घोरेण नादेन पाण्डवस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2054927, "chapter_id": 2202, "verse_number": "७-१२९-१७", "content_sanskrit": "समरे सर्वयोधानां धनूंष्यभ्यपतन्क्षितौ।\nशस्त्राणि न्यपतन्दोर्भ्यः केषाञ्चिच्चासवोऽद्रवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2054928, "chapter_id": 2202, "verse_number": "७-१२९-१८", "content_sanskrit": "वित्रस्तानि च सर्वाणि शकृन्मूत्रं प्रसुस्रुवुः।\nवाहनानि च सर्वाणि बभूवुर्विमनांसि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2054929, "chapter_id": 2202, "verse_number": "७-१२९-१९", "content_sanskrit": "प्रादुरासन्निमित्तानि घोराणि सुबहून्युत।\nगृध्रकङ्कबलैश्चासीदन्तरिक्षं समावृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2054930, "chapter_id": 2202, "verse_number": "७-१२९-२०", "content_sanskrit": "तस्मिन्सुतुमुले राजन्कर्णभीमसमागमे।\nततः कर्णस्तु विंशत्या शराणां भीममार्दयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2054931, "chapter_id": 2202, "verse_number": "७-१२९-२१", "content_sanskrit": "विव्याध चास्य त्वरितः सूतं पञ्चभिराशुगैः।\nप्रहस्य भीमसेनोऽपि कर्णं प्रत्याद्रवद्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2054932, "chapter_id": 2202, "verse_number": "७-१२९-२२", "content_sanskrit": "सायकानां चतुः षष्ट्या क्षिप्रकारी महायशाः।\nतस्य कर्णो महेष्वासः सायकांश्चतुरोऽक्षिपत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2054933, "chapter_id": 2202, "verse_number": "७-१२९-२३", "content_sanskrit": "असम्प्राप्तांश्च तान्भीमः सायकैर्नतपर्वभिः।\nचिच्छेद बहुधा राजन्दर्शयन्पाणिलाघवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2054934, "chapter_id": 2202, "verse_number": "७-१२९-२४", "content_sanskrit": "तं कर्णश्चादयामास शरव्रातैरनेकशः।\nसञ्छाद्यमानः कर्णेन बहुधा पाण़्डुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2054935, "chapter_id": 2202, "verse_number": "७-१२९-२५", "content_sanskrit": "चिच्छेद चापं कर्णस्य मुष्टिदेशे महारथः।\nविव्याध चैनं बहुभिः सायकैर्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2054936, "chapter_id": 2202, "verse_number": "७-१२९-२६", "content_sanskrit": "अथान्यद्धनुरादाय सञ्यं कृत्वा च सूतजः।\nविव्याध समरे भीमं भीमकर्मा महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2054937, "chapter_id": 2202, "verse_number": "७-१२९-२७", "content_sanskrit": "तस्य बीमो भृशं क्रुद्धस्त्रीञ्शरान्नतपर्वणः।\nनिचखानोरसि क्रुद्धः सूतपुत्रस्य वेगतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2054938, "chapter_id": 2202, "verse_number": "७-१२९-२८", "content_sanskrit": "तैः कर्णोऽराजत शरैरुरोमध्यगतैः सदा।\nमहीधर इवोदग्रस्त्रिशृङ्गो भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2054939, "chapter_id": 2202, "verse_number": "७-१२९-२९", "content_sanskrit": "सुस्राव चास्य रुधिरं विद्धस्य परमेषुभिः।\nधातुप्रस्यन्दिनः शैलाद्यथा गैरिकधातवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2054940, "chapter_id": 2202, "verse_number": "७-१२९-३०", "content_sanskrit": "किञ्चिद्विचलितः कर्णः सुप्रहाराभिपीडितः।\nआकर्णपूर्णमाकृष्य भीमं विव्याध सायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2054941, "chapter_id": 2202, "verse_number": "७-१२९-३१", "content_sanskrit": "चिक्षेप च पुनर्बाणाञ्शतशोऽथ सहस्रशः।\nस शरैरर्दितस्तेन कर्णेन दृढधन्विना।\nधनुर्ज्यामच्छिनत्तूर्णं भीमस्तस्य क्षुरेण ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2054942, "chapter_id": 2202, "verse_number": "७-१२९-३२", "content_sanskrit": "सारथिं चास्य भल्लेन रथनीडादपातयत्।\nवाहांश्च चतुरस्तस्य व्यसूंश्चक्रे महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2054943, "chapter_id": 2202, "verse_number": "७-१२९-३३", "content_sanskrit": "हताश्वात्तु रथात्कर्णः समाप्लुत्य विशाम्पते।\nस्यन्दनं वृषसेनस्य तूर्णमापुप्लुवे भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2054944, "chapter_id": 2202, "verse_number": "७-१२९-३४", "content_sanskrit": "निर्जित्य तु रणे कर्णं भीमसेनः प्रतापवान्।\nननाद बलवान्नादं पर्जन्यनिनदोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2054945, "chapter_id": 2202, "verse_number": "७-१२९-३५", "content_sanskrit": "तस्य तं निनदं श्रुत्वा प्रहृष्टोऽभूद्युधिष्ठिरः।\nकर्णं पराजितं मत्वा भीमसेनेन संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2054946, "chapter_id": 2202, "verse_number": "७-१२९-३६", "content_sanskrit": "समन्ताच्छङ्खनिनदं पाण्डुसेनाऽकरोत्तदा।\nशत्रुसेनाध्वनिं श्रुत्वा तावका ह्यनदन्भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2054947, "chapter_id": 2202, "verse_number": "७-१२९-३७", "content_sanskrit": "स शङ्खबाणनिनदैर्हर्षाद्राजा स्ववाहिनीम्।\nचक्रे युधिष्ठिरः सङ्ख्ये हर्षनादैश्च सङ्कुलाम्॥\nगाण्डीवं व्याक्षिपत्पार्थः कृष्णोऽप्यब्जमवादयत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2054948, "chapter_id": 2202, "verse_number": "७-१२९-३८", "content_sanskrit": "तमन्तर्धाय निनदं भीमस्य नदतो ध्वनिः।\nअश्रूयत तदा राजन्सर्वसैन्येषु दारुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2054949, "chapter_id": 2202, "verse_number": "७-१२९-३९", "content_sanskrit": "ततो व्यायच्छतामस्त्रैः पृथक्पृथगजिह्मगैः।\nमृदुपूर्वं तु राधेयो दृढपूर्वं तु पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2054950, "chapter_id": 2202, "verse_number": "७-१२९-४०", "content_sanskrit": "`भीमोऽपि च महाराज वैकर्तनमुपाद्रवत्।\nआसुरे तु महासैन्ये तारकं पावकिर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2054951, "chapter_id": 2202, "verse_number": "७-१२९-४१", "content_sanskrit": "तयोरेवं महद्युद्धमभवद्भीमकर्णयोः।\nतं भीमसेनो महता शरवर्षेण वारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2054952, "chapter_id": 2202, "verse_number": "७-१२९-४२", "content_sanskrit": "विव्याध सारथिं चास्य हयांश्च चतुरः शरैः।\nध्वजं चास्य पताकां च भल्लैः सन्नतपर्वभिः।\nरथं च चक्ररक्षौ च भीमश्चिच्छेद मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2054953, "chapter_id": 2202, "verse_number": "७-१२९-४३", "content_sanskrit": "कर्णोऽपि रथिनां श्रेष्ठो भीमसेनेन कम्पितः।\nखङ्गचर्मधरो राजन्भीममभ्यद्रवद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2054954, "chapter_id": 2202, "verse_number": "७-१२९-४४", "content_sanskrit": "भीमश्चिच्छेद खङ्गं च चर्मणा सह मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2054955, "chapter_id": 2202, "verse_number": "७-१२९-४५", "content_sanskrit": "दृष्ट्वा कर्णं च पार्थेन बाधितं बहुभिः शरैः।\nदुर्योधनो महाराज दुश्शलं प्रत्यभाषत।\nकर्णं कृच्छ्रगतं पश्य शीघ्रं यानं प्रयच्छह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2054956, "chapter_id": 2202, "verse_number": "७-१२९-४६x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2054957, "chapter_id": 2202, "verse_number": "७-१२९-४६", "content_sanskrit": "एवमुक्तस्ततो राज्ञा दुश्शलः समुपाद्रवत्।\nदुश्शलस्य रथं कर्णश्चारुरोह महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2054958, "chapter_id": 2202, "verse_number": "७-१२९-४७", "content_sanskrit": "तौ पार्थः सहसा गत्वा विव्याध दशभिः शरैः।\nपुनश्च कर्णं विद्ध्वाऽपि दुश्शलस्य शिरोऽहरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2054959, "chapter_id": 2202, "verse_number": "७-१२९-४८", "content_sanskrit": "दुश्शलं निहतं दृष्ट्वा भीमसेनेन मारिष।\nतस्यैव धनुरादाय कर्णो विव्याध पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2054960, "chapter_id": 2202, "verse_number": "७-१२९-४९", "content_sanskrit": "अन्योन्यं समरे वीरौ युयुधाते महाबलौ।\nशत्रुघ्नौ शत्रुमध्ये तु बलवज्रभृताविव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2054961, "chapter_id": 2202, "verse_number": "७-१२९-५०", "content_sanskrit": "भीमो विद्धा हयांश्चैव सारथिं च पुनः पुनः।\nकर्णमभ्यद्रवत्पार्थः प्रहसंश्च महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2054962, "chapter_id": 2202, "verse_number": "७-१२९-५१", "content_sanskrit": "ततो व्यायच्छमानस्य भीमसेनस्य संयुगे।\nतत्सैन्यं कलिलीभूतं न प्राज्ञायत किञ्चन॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2054963, "chapter_id": 2202, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे एकोनत्रिंशदधिकशततमोऽध्यायः॥ १२९ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१२९-१ युयुत्समानस्य व्यापारयतः॥ ५-१२९- सावेगं सत्वरम्॥ ५-१२९- संरुद्धामेकतामापन्नाम्॥ ५-१२९- व्यायच्छतां प्रहरताम्॥ ५-१२९- एकोनत्रिंशदधिकशततमोऽध्यायः॥ १२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]