[{"id": 7006225000, "chapter_id": 26225, "verse_number": "२-५३-१", "content_sanskrit": "जैमिनिरुवाच तेषु तत्र निविष्टेषु वासवेन प्रचोदितः ।\nजहारं तुरगं वायुस्तत्क्षणेन रसातलम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006225001, "chapter_id": 26225, "verse_number": "२-५३-२", "content_sanskrit": "अदृष्टमश्वं तैः सर्वैरपहृत्य सदागतिः ।\nअनयत्तत्पथा राजन्कपिलस्यान्तिकं मुनेः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006225002, "chapter_id": 26225, "verse_number": "२-५३-३", "content_sanskrit": "ततः समाकुलाः सर्वे विनष्टेऽश्वे नृपात्मजाः ।\nपरीत्य वसुधां सर्वां प्रमार्गन्तस्तुरगमम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006225003, "chapter_id": 26225, "verse_number": "२-५३-४", "content_sanskrit": "विचित्य पृथिवीं ते तु स पुराचलकाननाम् ।\nअपश्यन्तो यज्ञपशुं दुःखं महदवाप्नुवन् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006225004, "chapter_id": 26225, "verse_number": "२-५३-५", "content_sanskrit": "ततोऽयोध्यां समासाद्य ऋषिभिः परिवारिताम् ।\nदृष्ट्वा प्रणम्य पितरं तस्मै सर्वं न्यवेदयन् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006225005, "chapter_id": 26225, "verse_number": "२-५३-६", "content_sanskrit": "परीत्य पृथ्वीमस्माभिर्निविष्टे वरुणालये ।\nरक्ष्यमाणोऽपि पश्यद्भिः केनापि तुरगो हृतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006225006, "chapter_id": 26225, "verse_number": "२-५३-७", "content_sanskrit": "इत्युक्तस्तै रुषाविष्टस्तानुवाच नृपोत्तमः ।\nप्रयास्यध्वमधर्मिष्ठाः सर्वेऽनावृत्तये पुनः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006225007, "chapter_id": 26225, "verse_number": "२-५३-८", "content_sanskrit": "कथं भवद्भिर्जीवद्भिर्विनष्टो वै दरात्मभिः ।\nतुरगेण विना सत्यं नेहाग मनमस्ति वः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006225008, "chapter_id": 26225, "verse_number": "२-५३-९", "content_sanskrit": "ततः समेत्य तस्मात्ते सप्रयाताः परस्परम् ।\nऊचुर्न दृश्यतेऽद्यापि तुरगः किं प्रकुमह ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006225009, "chapter_id": 26225, "verse_number": "२-५३-१०", "content_sanskrit": "वसुधा विचितास्माभिः सशैलवनकानना ।\nन चापि दृश्यते वाजी तद्वार्त्तापि न कुत्रचित् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006225010, "chapter_id": 26225, "verse_number": "२-५३-११", "content_sanskrit": "तस्मादब्धेः समारभ्य पातालावधि मेदिनीम् ।\nविभज्य रवात्वा पातालं विविशाम तुरङ्गमम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006225011, "chapter_id": 26225, "verse_number": "२-५३-१२", "content_sanskrit": "इति कृत्वा मतिं सर्वे सागराः क्रूरनिश्चयाः ।\nनिचख्नुर्भूमिमंबोधेस्तटा दारभ्य सर्वतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006225012, "chapter_id": 26225, "verse_number": "२-५३-१३", "content_sanskrit": "तैः खन्यमाना वसुधा ररास भृशविह्वला ।\nचुक्रुशुश्चापि भूतानि दृष्ट्वा तेषां विचेष्टितम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006225013, "chapter_id": 26225, "verse_number": "२-५३-१४", "content_sanskrit": "ततस्ते भारतं खण्डं खात्वा संक्षिब्य भूतले ।\nभूमेर्योजनसाहस्रं योजयामासुरंबुधौ ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006225014, "chapter_id": 26225, "verse_number": "२-५३-१५", "content_sanskrit": "आपातालतलं ते तु खनन्तो मेदिनीतलम् ।\nचरन्तमश्वं पाताले ददृशुर्नृपनन्दनाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006225015, "chapter_id": 26225, "verse_number": "२-५३-१६", "content_sanskrit": "संप्रहृष्टास्ततः सर्वे समेत्य च समन्ततः ।\nसंतोषाज्जहसुः केचिन्ननृतुश्च मुदान्विताः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006225016, "chapter_id": 26225, "verse_number": "२-५३-१७", "content_sanskrit": "ददृशुश्च महात्मानं कपिलं दीप्ततेजसम् ।\nवृद्धं पद्मासनासीनं नासाग्रन्यस्तलोचनम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006225017, "chapter_id": 26225, "verse_number": "२-५३-१८", "content_sanskrit": "ऋज्वायतशिरोग्रीवं पुरोविष्टब्धवक्षसम् ।\nस्वतेजसाभिसरता परिबूर्णेन सर्वतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006225018, "chapter_id": 26225, "verse_number": "२-५३-१९", "content_sanskrit": "प्रकाश्यमानं परितो निवातस्थप्रदीपवत् ।\nस्वान्तप्रकाशिताशेषविज्ञानमयविग्रहम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006225019, "chapter_id": 26225, "verse_number": "२-५३-२०", "content_sanskrit": "समाधिगतचित्तन्तु निभृतांभोधिसन्निभम् ।\nआरूढयोगं विधिवद्ध्येयसंलीनमानसम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006225020, "chapter_id": 26225, "verse_number": "२-५३-२१", "content_sanskrit": "च्दृदद्यत्दद्वड्ढ द्यदृ डद्धठ्ठण्थ्र्ठ्ठदड्डठ्ठथ्र्ठ्ठड्डण्न्र्ठ्ठडण्ठ्ठग्ठ्ठ योगीन्द्रप्रवरं शान्तं ज्वालामाल मिवानलम् ।\nविलोक्य तत्र तिष्ठन्तं विमृशन्तः परस्परम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006225021, "chapter_id": 26225, "verse_number": "२-५३-२२", "content_sanskrit": "मुहूर्त्तमिव ते राजन्साध्वसं परमं गताः ।\nततोऽयमश्वहर्त्तेति सागरा कालचोदिताः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006225022, "chapter_id": 26225, "verse_number": "२-५३-२३", "content_sanskrit": "परिवव्रुर्दुरात्मानः कपिलं मुनिसत्तमम् ।\nततस्तं परिवार्योचुश्वोरोऽयं नात्र संशयः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006225023, "chapter_id": 26225, "verse_number": "२-५३-२४", "content_sanskrit": "अश्वहर्त्ता ततोऽह्येष वध्योऽस्माभिर्दुराशयः ।\nतं प्राकृतवदासीनं ते सर्वे हतवुद्धयः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006225024, "chapter_id": 26225, "verse_number": "२-५३-२५", "content_sanskrit": "आसन्नमरणाश्चक्रुर्धर्षितं मुनिमञ्जसा ।\nजैमिनिरुवाच ततो मुनिरदीनात्मा ध्यानभङ्गप्रधर्षितः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006225025, "chapter_id": 26225, "verse_number": "२-५३-२६", "content_sanskrit": "क्रोधेन महताऽविष्टश्चुक्षुभे कपिलस्तदा ।\nप्रचचाल दुराधर्षो धर्षितस्तैर्दुरात्मभिः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006225026, "chapter_id": 26225, "verse_number": "२-५३-२७", "content_sanskrit": "व्यजृंभत च कल्पान्ते मरुद्भिरिव चानलः ।\nतस्य चार्णवगंभीराद्वपुषः कोपपावकः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006225027, "chapter_id": 26225, "verse_number": "२-५३-२८", "content_sanskrit": "दिधक्षुरिव पातालांल्लोकान्सांकर्षणोऽनलः ।\nशुशुभे धर्षणक्रोधपरामर्शविदीपितः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006225028, "chapter_id": 26225, "verse_number": "२-५३-२९", "content_sanskrit": "उन्मीलयत्तदा नेत्रे वह्निचक्रसमद्युतिः ।\nतदाक्षिणी क्षणं राजन्राजेतां सुभृशारुणे ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006225029, "chapter_id": 26225, "verse_number": "२-५३-३०", "content_sanskrit": "पूर्वसंव्यासमुदितौ पुष्पवन्ताविवांबरे ।\nततोऽप्युद्वर्त्तमानाभ्यां नेत्राभ्यां नृपनन्दनान् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006225030, "chapter_id": 26225, "verse_number": "२-५३-३१", "content_sanskrit": "अवैक्षत च गंभीरः कृतान्तः कालपर्यये ।\nक्रुद्धस्य तस्यनेत्राभ्यां सहसा पावकार्चिषः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006225031, "chapter_id": 26225, "verse_number": "२-५३-३२", "content_sanskrit": "निश्चेरुरभिलोदिक्षु कालाग्नेरिव संतताः ।\nसधूमकवलोदग्राः स्फुलिङ्गौघमुचो मुहुः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006225032, "chapter_id": 26225, "verse_number": "२-५३-३३", "content_sanskrit": "मुनिक्रोधानलज्वालाः समन्ताव्द्यानशुर्दिशः ।\nव्यालोदरौग्रकुहरा ज्वाला स्तन्नेत्रनिर्गताः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006225033, "chapter_id": 26225, "verse_number": "२-५३-३४", "content_sanskrit": "विरेजुर्निभृतांभोधेर्वडवाग्नेरिवार्चिषः ।\nक्रोधाग्निः सुमहाराज ज्वालावव्याप्तदिगन्तरः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006225034, "chapter_id": 26225, "verse_number": "२-५३-३५", "content_sanskrit": "दग्धांश्चकार तान्सर्वानावृण्वानो नभस्तलम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006225035, "chapter_id": 26225, "verse_number": "२-५३-३६", "content_sanskrit": "सशब्दमुद्भ्रान्तमरुत्प्रकोपविवर्त्तमानानलधूमजालैः ।\nमहीरजोभिश्च नितान्तमुद्धतैः समावृतं लोक मभूद्भृशातुरम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006225036, "chapter_id": 26225, "verse_number": "२-५३-३७", "content_sanskrit": "ततः स वह्निर्विलिखन्निवाभितः समीरवेगाभिहताभिरंबरम् ।\nशिखाभिरुर्वीशसुतानशेषतो ददाह सद्यः सुर विद्विषस्तान् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006225037, "chapter_id": 26225, "verse_number": "२-५३-३८", "content_sanskrit": "मिषतः सर्वलोकस्य क्तोधाग्निस्तमृते हयम् ।\nसागरांस्तानशेषेण भस्मसादकरोत्स तान् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006225038, "chapter_id": 26225, "verse_number": "२-५३-३९", "content_sanskrit": "एवं क्रोधाग्निना तेन सागराः पापचेतसः ।\nजज्वलुः सहसा दावे तरवो नीरसा इव ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006225039, "chapter_id": 26225, "verse_number": "२-५३-४०", "content_sanskrit": "दृष्ट्वा तेषां तु निधनं सागराणान्दुरात्मनाम् ।\nअन्योन्यमबुवन्देवा विस्मिता ऋषिभिः सह ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006225040, "chapter_id": 26225, "verse_number": "२-५३-४१", "content_sanskrit": "अहोदारुणपापानां विपाको न चिरायितः ।\nदुरन्तः खलु लोकेऽस्मिन्नराणामसदात्मनाम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006225041, "chapter_id": 26225, "verse_number": "२-५३-४२", "content_sanskrit": "यदि मे पर्वताकारा नृशंसाः क्रूरवुद्धयः ।\nयुगपद्विलयं प्राप्ताः सहसैव तृणाग्निवत् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006225042, "chapter_id": 26225, "verse_number": "२-५३-४३", "content_sanskrit": "उद्वेजनीया भूतानां सद्भिरत्यन्तगर्हिताः ।\nआजीवान्तमिमे हर्तु दिष्ट्या संक्षयमागताः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006225043, "chapter_id": 26225, "verse_number": "२-५३-४४", "content_sanskrit": "परोपतापि नितरां सर्वलोकजुगुप्सितम् ।\nइह कृत्वाशुभं कर्म कःपुमान्विन्दते सुखम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006225044, "chapter_id": 26225, "verse_number": "२-५३-४५", "content_sanskrit": "विक्रोश्य सर्वभूतानि संप्रयाताः स्वकर्मभिः ।\nब्रह्मदण्डहताः पापा निरयं शाश्वतीः समाः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006225045, "chapter_id": 26225, "verse_number": "२-५३-४६", "content_sanskrit": "तस्मात्सदैव कर्त्तव्यं कर्म पुंसां मनीपिणाम् ।\nदुरतश्च परित्याज्यमितरल्लोकनिन्दितम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006225046, "chapter_id": 26225, "verse_number": "२-५३-४७", "content_sanskrit": "कर्त्तव्यः श्रेयसे यत्नो यावज्जीवं विजानता ।\nनाचरेत्कस्यचिद्द्रोहमनित्यं जीवनं यतः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006225047, "chapter_id": 26225, "verse_number": "२-५३-४८", "content_sanskrit": "अनित्योऽयं सदा देहःसपदश्चातिचञ्चलाः ।\nसंसारश्चातिनिस्सारस्तत्कथं विश्वसेद्बुधः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006225048, "chapter_id": 26225, "verse_number": "२-५३-४९", "content_sanskrit": "एवं सुरमुनीन्द्रेषु कथयत्सु परस्परम् ।\nमुनिक्रोधेन्धनीभूता विनेशुः सगरात्मजाः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006225049, "chapter_id": 26225, "verse_number": "२-५३-५०", "content_sanskrit": "निर्दगधदेहाः सहसा भुवं विष्टभ्य भस्मना ।\nअवापुर्निरयं सद्यः सागरास्ते स्वकमभिः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006225050, "chapter_id": 26225, "verse_number": "२-५३-५१", "content_sanskrit": "सागरांस्तानशेषेण दग्धवातत्क्रोधजोऽनलः ।\nक्षणेन लोकानखिलानुद्यतो दग्धुमञ्जसा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006225051, "chapter_id": 26225, "verse_number": "२-५३-५२", "content_sanskrit": "भयभीतास्ततो देवाः समेत्य दिवि संस्थिताः ।\nतुष्टुवुस्ते महात्मानं क्रोधाग्निशमनार्थिनः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]