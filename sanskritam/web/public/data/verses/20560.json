[{"id": 7000560000, "chapter_id": 20560, "verse_number": "५-१९-१", "content_sanskrit": "ब्राह्मण उवाच ।\nइति श्रुत्वा तु तद्वाक्यं भिल्लानामहमद्भुतम् ।\nअत्याश्चर्यमिदं मत्वा प्रहृष्टोऽभवमित्युत ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000560001, "chapter_id": 20560, "verse_number": "५-१९-२", "content_sanskrit": "गंगासागरसंयोगे स्नात्वा पुण्यकलेवरः ।\nशृंगमारुरुहे तत्र मणिमाणिक्यचित्रितम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000560002, "chapter_id": 20560, "verse_number": "५-१९-३", "content_sanskrit": "तत्रापश्यं महाराज देवं देवादिवंदितम् ।\nनमस्कृत्वा कृतार्थोऽहं जातोन्नप्राशनेन च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000560003, "chapter_id": 20560, "verse_number": "५-१९-४", "content_sanskrit": "चतुर्भुजत्वं संप्राप्तः शंखचक्रादिचिह्नितम् ।\nपुरुषोत्तमदर्शनेन न पुनर्गर्भमाविशम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000560004, "chapter_id": 20560, "verse_number": "५-१९-५", "content_sanskrit": "राजंस्त्वमपि तत्राशु गच्छ नीलाभिधं गिरिम् ।\nकृतार्थं कुरु चात्मानं गर्भदुःखविवर्जितम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000560005, "chapter_id": 20560, "verse_number": "५-१९-६", "content_sanskrit": "इत्याकर्ण्य वचस्तस्य वाडवाग्र्यस्य धीमतः ।\nपप्रच्छ हृष्टगात्रस्तु तीर्थयात्राविधिं मुनिम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000560006, "chapter_id": 20560, "verse_number": "५-१९-७", "content_sanskrit": "राजोवाच ।\nसाधु विप्राग्र्य हे साधो त्वया प्रोक्तं ममानघ ।\nपुरुषोत्तममाहात्म्यं शृण्वतां पापनाशनम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000560007, "chapter_id": 20560, "verse_number": "५-१९-८", "content_sanskrit": "ब्रूहि तत्तीर्थयात्रायां विधिं श्रुतिसमन्वितम् ।\nविधिना केन संपूर्ण फलप्राप्तिर्नृणां भवेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000560008, "chapter_id": 20560, "verse_number": "५-१९-९", "content_sanskrit": "ब्राह्मण उवाच ।\nशृणु राजन्प्रवक्ष्यामि तीर्थयात्राविधिं शुभम् ।\nयेन संप्राप्यते देवः सुरासुरनमस्कृतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000560009, "chapter_id": 20560, "verse_number": "५-१९-१०", "content_sanskrit": "वलीपलितदेहो वा यौवनेनान्वितोऽपि वा ।\nज्ञात्वा मृत्युमनिस्तीर्यं हरिं शरणमाव्रजेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000560010, "chapter_id": 20560, "verse_number": "५-१९-११", "content_sanskrit": "तत्कीर्तने तच्छ्रवणे वंदने तस्य पूजने ।\nमतिरेव प्रकर्तव्या नान्यत्र वनितादिषु ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000560011, "chapter_id": 20560, "verse_number": "५-१९-१२", "content_sanskrit": "सर्वं नश्वरमालोक्य क्षणस्थायि सुदुःखदम् ।\nजन्ममृत्युजरातीतं भक्तिवल्लभमच्युतम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000560012, "chapter_id": 20560, "verse_number": "५-१९-१३", "content_sanskrit": "क्रोधात्कामाद्भयाद्द्वेषाल्लोभाद्दंभान्नरः पुनः ।\nयथाकथंचिद्विभजन्न स दुःखं समश्नुते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000560013, "chapter_id": 20560, "verse_number": "५-१९-१४", "content_sanskrit": "स हरिर्जायते साधुसंगमात्पापवर्जितात् ।\nयेषां कृपातः पुरुषा भवंत्यसुखवर्जिताः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000560014, "chapter_id": 20560, "verse_number": "५-१९-१५", "content_sanskrit": "ते साधवः शांतरागाः कामलोभविवर्जिताः ।\nब्रुवंति यन्महाराज तत्संसारनिवर्तकम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000560015, "chapter_id": 20560, "verse_number": "५-१९-१६", "content_sanskrit": "तीर्थेषु लभ्यते साधू रामचंद्र परायणः ।\nयद्दर्शनं नृणां पापराशिदाहाशुशुक्षणिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000560016, "chapter_id": 20560, "verse_number": "५-१९-१७", "content_sanskrit": "तस्मात्तीर्थेषु गंतव्यं नरैः संसारभीरुभिः ।\nपुण्योदकेषु सततं साधुश्रेणिविराजिषु ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000560017, "chapter_id": 20560, "verse_number": "५-१९-१८", "content_sanskrit": "तानि तीर्थानि विधिना दृष्टानि प्रहरंत्यघम् ।\nतं विधिं नृपशार्दूल कुरुष्व श्रुतिगोचरम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000560018, "chapter_id": 20560, "verse_number": "५-१९-१९", "content_sanskrit": "विरागं जनयेत्पूर्वं कलत्रादि कुटुंबके ।\nअसत्यभूतं तज्ज्ञात्वा हरिं तु मनसा स्मरेत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000560019, "chapter_id": 20560, "verse_number": "५-१९-२०", "content_sanskrit": "क्रोशमात्रं ततो गत्वा रामरामेति च ब्रुवन् ।\nतत्र तीर्थादिषु स्नात्वा क्षौरं कुर्याद्विधानवित् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000560020, "chapter_id": 20560, "verse_number": "५-१९-२१", "content_sanskrit": "मनुष्याणां च पापानि तीर्थानि प्रति गच्छताम् ।\nकेशानाश्रित्य तिष्ठंति तस्माद्वपनमाचरेत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000560021, "chapter_id": 20560, "verse_number": "५-१९-२२", "content_sanskrit": "ततो दंडं तु निर्ग्रन्थिं कमंडलुमथाजिनम् ।\nबिभृयाल्लोभनिर्मुक्तस्तीर्थवेषधरो नरः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000560022, "chapter_id": 20560, "verse_number": "५-१९-२३", "content_sanskrit": "विधिना गच्छतां नॄणां फलावाप्तिर्विशेषतः ।\nतस्मात्सर्वप्रयत्नेन तीर्थयात्राविधिं चरेत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000560023, "chapter_id": 20560, "verse_number": "५-१९-२४", "content_sanskrit": "यस्य हस्तौ च पादौ च मनश्चैव सुसंहितम् ।\nविद्या तपश्च कीर्तिश्च स तीर्थफलमश्नुते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000560024, "chapter_id": 20560, "verse_number": "५-१९-२५", "content_sanskrit": "हरेकृष्ण हरेकृष्ण भक्तवत्सल गोपते ।\nशरण्य भगवन्विष्णो मां पाहि बहुसंसृतेः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000560025, "chapter_id": 20560, "verse_number": "५-१९-२६", "content_sanskrit": "इति ब्रुवन्रसनया मनसा च हरिं स्मरन् ।\nपादचारी गतिं कुर्यात्तीर्थं प्रति महोदयः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000560026, "chapter_id": 20560, "verse_number": "५-१९-२७", "content_sanskrit": "यानेन गच्छन्पुरुषः समभागफलं लभेत् ।\nउपानद्भ्यां चतुर्थांशं गोयाने गोवधादिकम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000560027, "chapter_id": 20560, "verse_number": "५-१९-२८", "content_sanskrit": "व्यवहर्ता तृतीयांशं सेवयाष्टमभागभाक् ।\nअनिच्छया व्रजंस्तत्र तीर्थमर्धफलं लभेत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000560028, "chapter_id": 20560, "verse_number": "५-१९-२९", "content_sanskrit": "यथायथं प्रकर्तव्या तीर्थानामभियात्रिका ।\nपापक्षयो भवत्येव विधिदृष्ट्या विशेषतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000560029, "chapter_id": 20560, "verse_number": "५-१९-३०", "content_sanskrit": "तत्र साधून्नमस्कुर्यात्पादवंदनसेवनैः ।\nतद्द्वारा हरिभक्तिर्हि प्राप्यते पुरुषोत्तमे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000560030, "chapter_id": 20560, "verse_number": "५-१९-३१", "content_sanskrit": "इति तीर्थविधिः प्रोक्तः समासेन न विस्तरात् ।\nएवं विधिं समाश्रित्य गच्छ त्वं पुरुषोत्तमम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000560031, "chapter_id": 20560, "verse_number": "५-१९-३२", "content_sanskrit": "तुभ्यं तुष्टो महाराज दास्यते भक्तिमच्युतः ।\nयथा संसारनिर्वाहः क्षणादेव भविष्यति ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000560032, "chapter_id": 20560, "verse_number": "५-१९-३३", "content_sanskrit": "तीर्थयात्राविधिं श्रुत्वा सर्वपातकनाशनम् ।\nमुच्यते सर्वपापेभ्य उग्रेभ्यः पुरुषर्षभ ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000560033, "chapter_id": 20560, "verse_number": "५-१९-३४", "content_sanskrit": "सुमतिरुवाच ।\nइति वाक्यं समाकर्ण्य ववंदे चरणौ महान् ।\nतत्तीर्थदर्शनौत्सुक्य विह्वलीकृतमानसः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000560034, "chapter_id": 20560, "verse_number": "५-१९-३५", "content_sanskrit": "आदिदेश निजामात्यं मंत्रवित्तममुत्तमम् ।\nतीर्थयात्रेच्छया सर्वान्सह नेतुं मनो दधत् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000560035, "chapter_id": 20560, "verse_number": "५-१९-३६", "content_sanskrit": "मंत्रिन्पौरजनान्सर्वानादिश त्वं ममाज्ञया ।\nपुरुषोत्तमपादाब्जदर्शनप्रीतिहेतवे ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000560036, "chapter_id": 20560, "verse_number": "५-१९-३७", "content_sanskrit": "ये मदीये पुरे लोका ये च मद्वाक्यकारकाः ।\nसर्वे निर्यांतु मत्पुर्या मया सह नरोत्तमाः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000560037, "chapter_id": 20560, "verse_number": "५-१९-३८", "content_sanskrit": "ये तु मद्वाक्यमुल्लंघ्य स्थास्यंति पुरुषा गृहे ।\nते दंड्या यमदंडेन पापिनोऽधर्महेतवः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000560038, "chapter_id": 20560, "verse_number": "५-१९-३९", "content_sanskrit": "किं तेन सुतवृंदेन बांधवैः किं सुदुर्नयैः ।\nयैर्नदृष्टः स्वचक्षुर्भ्यां पुण्यदः पुरुषोत्तमः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000560039, "chapter_id": 20560, "verse_number": "५-१९-४०", "content_sanskrit": "सूकरीयूथवत्तेषां प्रसूतिर्विट्प्रभक्षिका ।\nयेषां पुत्राश्च पौत्रा वा हरिं न शरणं गताः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000560040, "chapter_id": 20560, "verse_number": "५-१९-४१", "content_sanskrit": "यो देवो नाममात्रेण सर्वान्पावयितुं क्षमः ।\nतं नमस्कुरुत क्षिप्रं मदीयाः प्रकृतिव्रजाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000560041, "chapter_id": 20560, "verse_number": "५-१९-४२", "content_sanskrit": "इति वाक्यं मनोहारि भगवद्गुणगुंफितम् ।\nप्रजहर्ष महामात्य उत्तमः सत्यनामधृक् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000560042, "chapter_id": 20560, "verse_number": "५-१९-४३", "content_sanskrit": "हस्तिनं वरमारोप्य पटहेन व्यघोषयत् ।\nयदादिष्टं नृपेणेह तीर्थयात्रां समिच्छता ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000560043, "chapter_id": 20560, "verse_number": "५-१९-४४", "content_sanskrit": "गच्छंतु त्वरिता लोका राज्ञा सह महागिरिम् ।\nदृश्यतां पापसंहारी पुरुषोत्तमनामधृक् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000560044, "chapter_id": 20560, "verse_number": "५-१९-४५", "content_sanskrit": "क्रियतां सर्वसंसारसागरो गोष्पदं पुनः ।\nभूष्यतां शंखचक्रादिचिह्नैः स्वस्व तनुर्नरैः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000560045, "chapter_id": 20560, "verse_number": "५-१९-४६", "content_sanskrit": "इत्यादिघोषयामास राज्ञादिष्टं यदद्भुतम् ।\nसचिवो रघुनाथांघ्रि ध्याननिर्वारितश्रमः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000560046, "chapter_id": 20560, "verse_number": "५-१९-४७", "content_sanskrit": "तच्छ्रुत्वा ताः प्रजाः सर्वा आनंदरससंप्लुताः ।\nमनो दधुः स्वनिस्तारे पुरुषोत्तमदर्शनात् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000560047, "chapter_id": 20560, "verse_number": "५-१९-४८", "content_sanskrit": "निर्ययुर्ब्राह्मणास्तत्र शिष्यैः सह सुवेषिणः ।\nआशिषं वरदानाढ्यां ददतो भूमिपं प्रति ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000560048, "chapter_id": 20560, "verse_number": "५-१९-४९", "content_sanskrit": "क्षत्त्रिया धन्विनो वीरा वैश्या वस्तुक्रयाञ्चिताः ।\nशूद्राः संसारनिस्तारहर्षित स्वीयविग्रहाः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000560049, "chapter_id": 20560, "verse_number": "५-१९-५०", "content_sanskrit": "रजकाश्चर्मकाः क्षौद्राः किराता भित्तिकारकाः ।\nसूचीवृत्त्या च जीवंतस्तांबूलक्रयकारकाः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000560050, "chapter_id": 20560, "verse_number": "५-१९-५१", "content_sanskrit": "तालवाद्यधरा ये च ये च रंगोपजीविनः ।\nतैलविक्रयिणश्चैव वस्त्रविक्रयिणस्तथा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000560051, "chapter_id": 20560, "verse_number": "५-१९-५२", "content_sanskrit": "सूता वदंतः पौराणीं वार्तां हर्षसमन्विताः ।\nमागधा बंदिनस्तत्र निर्गता भूमिपाज्ञया ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000560052, "chapter_id": 20560, "verse_number": "५-१९-५३", "content_sanskrit": "भिषग्वृत्त्या च जीवंतस्तथा पाशककोविदाः ।\nपाकस्वादुरसाभिज्ञा हास्यवाक्यानुरंजकाः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000560053, "chapter_id": 20560, "verse_number": "५-१९-५४", "content_sanskrit": "ऐंद्रजालिकविद्याध्रास्तथा वार्तासुकोविदाः ।\nप्रशंसंतो महाराजं निर्ययुः पुरमध्यतः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000560054, "chapter_id": 20560, "verse_number": "५-१९-५५", "content_sanskrit": "राजापि तत्र निर्वर्त्य प्रातःसंध्यादिकाः क्रियाः ।\nब्राह्मणं तापसश्रेष्ठमानिनाय सुनिर्मलम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000560055, "chapter_id": 20560, "verse_number": "५-१९-५६", "content_sanskrit": "तदाज्ञया महाराजो निर्जगाम पुराद्बहिः ।\nलोकैरनुगतो राजा बभौ चंद्र इवोडुभिः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000560056, "chapter_id": 20560, "verse_number": "५-१९-५७", "content_sanskrit": "क्रोशमात्रं स गत्वाथ क्षौरं कृत्वा विधानतः ।\nदंडं कमंडलुं बिभ्रन्मृगचर्म तथा शुभम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000560057, "chapter_id": 20560, "verse_number": "५-१९-५८", "content_sanskrit": "शुभवेषेण संयुक्तो हरिध्यानपरायणः ।\nकामक्रोधादिरहितं मनो बिभ्रन्महायशाः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000560058, "chapter_id": 20560, "verse_number": "५-१९-५९", "content_sanskrit": "तदा दुंदुभयो भेर्य आनकाः पणवास्तथा ।\nशंखवीणादिकाश्चैवाध्मातास्तद्वादकैर्मुहुः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000560059, "chapter_id": 20560, "verse_number": "५-१९-६०", "content_sanskrit": "जय देवेश दुःखघ्न पुरुषोत्तमसंज्ञित ।\nदर्शयस्व तनुं मह्यं वदंतो निर्ययुर्जनाः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]