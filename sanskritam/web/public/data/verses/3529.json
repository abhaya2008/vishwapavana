[{"id": 2117401, "chapter_id": 3529, "verse_number": "", "content_sanskrit": "द्रुपदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2117402, "chapter_id": 3529, "verse_number": "१", "content_sanskrit": "एवमेतन्महाप्राज्ञ यथाऽऽत्थ विदुराद्य माम् ।\nममापि परमो हर्षः सम्बन्धेऽस्मिन् कृते विभो \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2117403, "chapter_id": 3529, "verse_number": "२", "content_sanskrit": "गमनं चापि युक्तं स्याद् गृहमेषां महात्मनाम् ।\nन तु तावन्मया युक्तमेतद् वक्तुं स्वया गिरा \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2117404, "chapter_id": 3529, "verse_number": "३", "content_sanskrit": "यदा तु मन्यते वीरः कुन्तीपुत्रो युधिष्ठिरः ।\nभीमसेनार्जुनौ चैव यमौ च पुरुषर्षभौ \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2117405, "chapter_id": 3529, "verse_number": "४", "content_sanskrit": "रामकृष्णौ च धर्मज्ञौ तदा गच्छन्तु पाण्डवाः\nएतौ हि पुरुषव्याघ्रावेषां प्रियहिते रतौ \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2117406, "chapter_id": 3529, "verse_number": "", "content_sanskrit": "युधिष्टिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2117407, "chapter_id": 3529, "verse_number": "५", "content_sanskrit": "परवन्तो वयं राजंस्त्वयि सर्वे सहानुगाः ।\nयथा वक्ष्यसि नः प्रीत्या चरिष्यामस्तथा वयम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2117408, "chapter_id": 3529, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2117409, "chapter_id": 3529, "verse_number": "६", "content_sanskrit": "ततोऽब्रवीद् वासुदेवो गमनं मम रोचते ।\nयथाऽयं मन्यते राजा द्रुपदः सर्वधर्मवित् \t॥ ६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2117410, "chapter_id": 3529, "verse_number": "", "content_sanskrit": "द्रुपदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2117411, "chapter_id": 3529, "verse_number": "७", "content_sanskrit": "यथैतन्मन्यते वीरो दाशार्हः पुरुषोत्तमः ।\nप्राप्तकालं महाबाहुः सा बुद्धिर्निश्चिता मम \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2117412, "chapter_id": 3529, "verse_number": "८", "content_sanskrit": "यथैव हि महाभागाः कौन्तेया मम साम्प्रतम् ।\nतथैव वासुदेवस्य पाण्डुपुत्रा न संशयः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2117413, "chapter_id": 3529, "verse_number": "९", "content_sanskrit": "न तद् ध्यायति कौन्तेयः पाण्डुपुत्रो महामनाः ।\nयदैषां पुरुषव्याघ्रः श्रेयो धास्यति केशवः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2117414, "chapter_id": 3529, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2117415, "chapter_id": 3529, "verse_number": "१०", "content_sanskrit": "पृथायास्तु ततो वेश्म प्रविवेश महाद्युतिः ।\nपादौ स्पृष्ट्वा पृथायास्तु शिरसा च महीं गतः ।\nदृष्ट्वा तु देवरं कुन्ती शुशोच च मुहुर्मुहुः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2117416, "chapter_id": 3529, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2117417, "chapter_id": 3529, "verse_number": "११", "content_sanskrit": "वैचित्रवीर्य ते पुत्राः कथञ्चिज्जीवितास्त्वया ।\nत्वत्प्रसादाज्जतुगृहे त्राताः प्रत्यागतास्तव \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2117418, "chapter_id": 3529, "verse_number": "१२", "content_sanskrit": "कूर्मश्चिन्तयते पुत्रान् यत्र वा तत्र वा गतान् ।\nचिन्तया वर्धयेत् पुत्रान् यथा कुशलिनस्तथा \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2117419, "chapter_id": 3529, "verse_number": "१३", "content_sanskrit": "तव पुत्रास्तु जीवन्ति त्वद्भक्त्या भरतर्षभ ।\nयथा परभृतः पुत्रान् अरिष्टा वर्धयेत् सदा \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2117420, "chapter_id": 3529, "verse_number": "१४", "content_sanskrit": "तथैव तव पुत्रास्तु मया तात सुरक्षिताः ।\nदुःखास्तु बहवः प्राप्तास्तथा प्राणान्तिका मया ।\nअतः परं न जानामि कर्तव्यं ज्ञातुमर्हसि \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2117421, "chapter_id": 3529, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2117422, "chapter_id": 3529, "verse_number": "१५", "content_sanskrit": "इत्येवमुक्ता दुःखार्ता शुशोच परमातुरा ।\nप्रणिपत्याब्रवीत् क्षत्ता मा शोच इति भारत \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2117423, "chapter_id": 3529, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2117424, "chapter_id": 3529, "verse_number": "१६", "content_sanskrit": "न विनश्यन्ति लोकेषु तव पुत्रा महाबलाः ।\nनचिरेणैव कालेन स्वराज्यस्था भवन्ति ते ।\nबान्धवैः सहिताः सर्वैर्मा शोकं कुरु माधवि \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2117425, "chapter_id": 3529, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2117426, "chapter_id": 3529, "verse_number": "१७", "content_sanskrit": "ततस्तैः समनुज्ञाता द्रुपदेन महात्मना ।\nपाण्डवाश्चैव कृष्णश्च विदुरश्च महामतिः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2117427, "chapter_id": 3529, "verse_number": "१८", "content_sanskrit": "आदाय द्रौपदीं कृष्णां कुन्तीं चैव यशस्विनीम् ।\nसविहारं सुखं जग्मुर्नगरं नागसाह्वयम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2117428, "chapter_id": 3529, "verse_number": "१९", "content_sanskrit": "सुवर्णकक्ष्याग्रैवेयान् सुवर्णाङ्कुशभूषितान् ।\nजाम्बूनदपरिष्कारान् प्रभिन्नकरटामुखान् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2117429, "chapter_id": 3529, "verse_number": "२०", "content_sanskrit": "अधिष्ठितान् महामात्रैः सर्वशस्त्रसमन्वितान् ।\nसहस्रं प्रददौ राजा नागानां वरवर्णिनाम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2117430, "chapter_id": 3529, "verse_number": "२१", "content_sanskrit": "रथानां च सहस्रं वै सुवर्णमणिचित्रितम् ।\nचतुर्युजां भानुमच्च पञ्चानां प्रददौ तदा \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2117431, "chapter_id": 3529, "verse_number": "२२", "content_sanskrit": "पुनः सुवर्णबर्हाणां वरचामरमालिनाम् ।\nजात्यश्वानां च पञ्चाशत्सहस्रं प्रददौ नृपः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2117432, "chapter_id": 3529, "verse_number": "२३", "content_sanskrit": "दासीनामयुतं राजा प्रददौ वरभूषणम् ।\nततः सहस्रं दासानां प्रददौ वरधन्विनाम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2117433, "chapter_id": 3529, "verse_number": "२४", "content_sanskrit": "हैमानि शय्यासनभाजनानि\nद्रव्याणि चान्यानि च गोधनानि ।\nपृथक्पृथक् चैव ददौ स कोटिं\nपाञ्चालराजः परमप्रहृष्टः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2117434, "chapter_id": 3529, "verse_number": "२५", "content_sanskrit": "शिबिकानां शतं पूर्णं वाहान् पञ्चशतं वरान् ।\nएवमेतानि पाञ्चालो जन्यर्थे प्रददौ धनम् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2117435, "chapter_id": 3529, "verse_number": "२६", "content_sanskrit": "हरणं चापि पाञ्चाल्या ज्ञातिदेयं तु सौमकिः ।\nधृष्टद्युम्नो ययौ तत्र भगिनीं गृह्य भारत \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2117436, "chapter_id": 3529, "verse_number": "२७", "content_sanskrit": "नानद्यमाने बहुभिस्तूर्यशब्दैः सहस्रशः ।\nश्रुत्वा चोपस्थितान् वीरान् धृतराष्ट्रोऽम्बिकासुतः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2117437, "chapter_id": 3529, "verse_number": "२८", "content_sanskrit": "प्रतिग्रहाय पाण्डूनां प्रेषयामास कौरवान् ।\nविकर्णं च महेष्वासं चित्रसेनं च भारत \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2117438, "chapter_id": 3529, "verse_number": "२९", "content_sanskrit": "द्रोणं च परमेष्वासं गौतमं कृपमेव च ।\nतैस्तैः परिवृता वीराः शोभमाना महारथाः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2117439, "chapter_id": 3529, "verse_number": "३०", "content_sanskrit": "नगरं हस्तिनपुरं शनैः प्रविविशुस्तदा ।\nपाण्डवानागतान् श्रुत्वा नागरास्तु कुतूहलात् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2117440, "chapter_id": 3529, "verse_number": "३१", "content_sanskrit": "मण्डयाञ्चक्रिरे तत्र नगरं नागसाह्वयम् ।\nमुक्तापुष्पावकीर्णं तु जलसिक्तं च सर्वतः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2117441, "chapter_id": 3529, "verse_number": "३२", "content_sanskrit": "धूपितं दिव्यधूपेन मङ्गलैश्चाभिसंवृतम् ।\nपताकोच्छ्रितमाल्यं च पुरमप्रतिमं बभौ\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2117442, "chapter_id": 3529, "verse_number": "३३", "content_sanskrit": "शङ्खभेरीनिनादैश्च नानावादित्रनिस्वनैः ।\nकौतूहलेन नगरं पूज्यमानमिवाभवत् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2117443, "chapter_id": 3529, "verse_number": "३४", "content_sanskrit": "यत्र ते पुरुषव्याघ्राः शोकदुःखापकर्षकाः ।\nनिर्गताश्च पुरात् पूर्वं धृतराष्ट्रप्रबाधिताः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2117444, "chapter_id": 3529, "verse_number": "३५", "content_sanskrit": "पुनर्निवृत्ता दिष्ट्या वै सह मात्रा परन्तपाः ।\nइत्येवमीरिता वाचो जनैः प्रियचिकीर्षुभिः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2117445, "chapter_id": 3529, "verse_number": "३६", "content_sanskrit": "तत उच्चावचा वाचः प्रियाः सर्वत्र भारत ।\nउदीरिता अशृण्वन्त पाण्डवा हृदयङ्गमाः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2117446, "chapter_id": 3529, "verse_number": "", "content_sanskrit": "पौराः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2117447, "chapter_id": 3529, "verse_number": "३७", "content_sanskrit": "अयं स पुरुषव्याघ्रः पुनरायाति धर्मवित् ।\nयो नः स्वानिव दायादान् धर्मेण परिरक्षति \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2117448, "chapter_id": 3529, "verse_number": "३८", "content_sanskrit": "अद्य पाण्डुर्महाराजो वनादिह मनःप्रियः ।\nआगतः प्रियमस्माकं चिकीर्षुर्नात्र संशयः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2117449, "chapter_id": 3529, "verse_number": "३९", "content_sanskrit": "किं न्वद्य सुकृतं पुण्यं सर्वेषां नः प्रियं परम् ।\nयन्नः कुन्तीसुता वीरा भर्तारः पुनरागताः \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2117450, "chapter_id": 3529, "verse_number": "४०", "content_sanskrit": "यदि दत्तं यदि हुतं यदि वाऽप्यस्ति नस्तपः ।\nतेन तिष्ठन्तु नगरे पाण्डवाः शरदां शतम् \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2117451, "chapter_id": 3529, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2117452, "chapter_id": 3529, "verse_number": "४१", "content_sanskrit": "ततस्ते धृतराष्ट्रस्य भीष्मस्य च महात्मनः ।\nअन्येषां च तदर्हाणां चक्रुः पादाभिवन्दनम् \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2117453, "chapter_id": 3529, "verse_number": "४२", "content_sanskrit": "कृत्वा तु कुशलप्रश्नं सर्वस्य नगरस्य ते ।\nसमाविशन्त वेश्मानि धृतराष्ट्रस्य शासनात्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2117454, "chapter_id": 3529, "verse_number": "२०८", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nअष्टाधिकद्विशततमोऽध्यायः ॥२०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2117455, "chapter_id": 3529, "verse_number": "९", "content_sanskrit": "॥ इति विदुरागमनपर्वणि नवमोऽध्यायः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2117456, "chapter_id": 3529, "verse_number": "", "content_sanskrit": "॥ समाप्तं विदुरागमनपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]