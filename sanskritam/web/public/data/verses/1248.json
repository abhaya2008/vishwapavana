[{"id": 2012137, "chapter_id": 1248, "verse_number": "१-२४९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2012138, "chapter_id": 1248, "verse_number": "१-२४९-१", "content_sanskrit": "सोऽब्रवीदर्जुनं चैव वासुदेवं च सात्वतम्।\nलोकप्रवीरौ तिष्ठन्तौ काण्डवस्य समीपतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2012139, "chapter_id": 1248, "verse_number": "१-२४९-२", "content_sanskrit": "ब्राह्मणो बहुभोक्ताऽस्मि बुञ्जेऽपरिमितं सदा।\nभिक्षे वार्ष्णेयपार्थौ वामेकां तृप्तिं प्रयच्छतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2012140, "chapter_id": 1248, "verse_number": "१-२४९-३", "content_sanskrit": "एवमुक्तो तमब्रूतां ततस्तौ कृष्णपाण्डवौ।\nकेनान्नेन भवांस्तृप्येत्तस्यान्नस्य यतावहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2012141, "chapter_id": 1248, "verse_number": "१-२४९-४", "content_sanskrit": "एवमुक्तः स भगवानब्रवीत्तावुभौ ततः।\nभाषमाणौ तदा वीरौ किमन्नं क्रियतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2012142, "chapter_id": 1248, "verse_number": "१-२४९-५x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2012143, "chapter_id": 1248, "verse_number": "१-२४९-५", "content_sanskrit": "नाहमन्नं बुभुक्षे वै पावकं मां निबोधतम्।\nयदन्नमनुरूपं मे तद्युवां संप्रयच्छतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2012144, "chapter_id": 1248, "verse_number": "१-२४९-६", "content_sanskrit": "इदमिन्द्रः सदा दावं खाण्डवं परिरक्षति।\nन च शक्नोम्यहं दग्धुं रक्ष्यमाणं महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2012145, "chapter_id": 1248, "verse_number": "१-२४९-७", "content_sanskrit": "वसत्यत्र सखा तस्य तक्षकः पन्नगः सदा।\nसगणस्तत्कृते दावं परिरक्षति वज्रभृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2012146, "chapter_id": 1248, "verse_number": "१-२४९-८", "content_sanskrit": "तत्र भूतान्यनेकानि रक्ष्यन्तेऽस्य प्रसङ्गतः।\nतं दिधक्षुर्न शक्नोमि दग्धुं शक्रस्य तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2012147, "chapter_id": 1248, "verse_number": "१-२४९-९", "content_sanskrit": "स मां प्रज्वलितं दृष्ट्वा मेघाम्भोभिः प्रवर्षति।\nततो दग्धुं न शक्नोमि दिधक्षुर्दावमीप्सितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2012148, "chapter_id": 1248, "verse_number": "१-२४९-१०", "content_sanskrit": "स युवाभ्यां सहायाभ्यामस्त्रविद्भ्यां समागतः।\nदहेयं खाण्डवं दावमेतदन्नं वृतं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2012149, "chapter_id": 1248, "verse_number": "१-२४९-११", "content_sanskrit": "युवां ह्युदकधारास्ता भूतानि च समन्ततः।\nउत्तमास्त्रविदौ सम्यक्सर्वतो वारयिष्यथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2012150, "chapter_id": 1248, "verse_number": "१-२४९-१२x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2012151, "chapter_id": 1248, "verse_number": "१-२४९-१२", "content_sanskrit": "किमर्थं भगवानग्निः खाण्डवं दग्धुमिच्छति।\nरक्ष्यमाणं महेन्द्रेण नानासत्वसमायुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2012152, "chapter_id": 1248, "verse_number": "१-२४९-१३", "content_sanskrit": "न ह्येतत्कारणं ब्रह्मन्नल्पं संप्रतिभाति मे।\nयद्ददाह सुसंक्रुद्धः खाण्डवं हव्यवाहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2012153, "chapter_id": 1248, "verse_number": "१-२४९-१४", "content_sanskrit": "एतद्विस्तरशो ब्रह्मन्श्रोतुमिच्छामि तत्त्वतः।\nखाण्डवस्य पुरा दाहो यथा समभवन्मुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2012154, "chapter_id": 1248, "verse_number": "१-२४९-१५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2012155, "chapter_id": 1248, "verse_number": "१-२४९-१५", "content_sanskrit": "शृणु मे ब्रुवतो राजन्सर्वमेतद्यथातथम्।\nयन्निमित्तं ददाहाग्निः खाण्डवं पृथिवीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2012156, "chapter_id": 1248, "verse_number": "१-२४९-१६", "content_sanskrit": "हन्त ते कथयिष्यामि पौराणीमृषिसंस्तुताम्।\nकथामिमां नरश्रेष्ठ खाण्डवस्य विनाशिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2012157, "chapter_id": 1248, "verse_number": "१-२४९-१७", "content_sanskrit": "पौराणः श्रूयते राजन्राजा हरिहयोपमः।\nश्वेतकिर्नाम विख्यातो बलविक्रमसंयुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2012158, "chapter_id": 1248, "verse_number": "१-२४९-१८", "content_sanskrit": "यज्वा दानपतिर्धीमान्यथा नान्योऽस्ति कश्चन।\nजग्राह दीक्षां स नृपः तदा द्वादशवार्षिकीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2012159, "chapter_id": 1248, "verse_number": "१-२४९-१९", "content_sanskrit": "तस्य सत्रे सदा तस्मिन्समागच्छन्महर्षयः।\nवेदवेदाङ्गविद्वांसो ब्राह्मणाश्च सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2012160, "chapter_id": 1248, "verse_number": "१-२४९-२०", "content_sanskrit": "ईजे च स महायज्ञैः क्रतुभिश्चाप्तदक्षिणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2012161, "chapter_id": 1248, "verse_number": "१-२४९-२१", "content_sanskrit": "तस्य नान्याऽभवद्बुद्धिर्दिवसे दिवसे नृप।\nसत्रे क्रियासमारम्भे दानेषु विविधेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2012162, "chapter_id": 1248, "verse_number": "१-२४९-२२", "content_sanskrit": "ऋत्विग्भिः सहितो धीमानेवमीजे स भूमिपः।\nततस्तु ऋत्विजश्चास्य धूमव्याकुललोचनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2012163, "chapter_id": 1248, "verse_number": "१-२४९-२३", "content_sanskrit": "कालेन महता खिन्नास्तत्यजुस्ते नराधिपम्।\nततः प्रसादयामास ऋत्विजस्तान्महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2012164, "chapter_id": 1248, "verse_number": "१-२४९-२४", "content_sanskrit": "चक्षुर्विकलतां प्राप्ता न प्रपेदुश्च ते क्रतुम्।\nततस्तेषामनुमते तद्विप्रैस्तु नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2012165, "chapter_id": 1248, "verse_number": "१-२४९-२५", "content_sanskrit": "सत्रं समापयामास ऋत्विग्भिरपरैः सह।\nतस्यैवंवर्तमानस्य कदाचित्कालपर्यये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2012166, "chapter_id": 1248, "verse_number": "१-२४९-२६", "content_sanskrit": "सत्रमहार्तुकामस्य संवत्सरशतं किल।\nऋत्विजो नाभ्यपद्यन्त समाहर्तुं महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2012167, "chapter_id": 1248, "verse_number": "१-२४९-२७", "content_sanskrit": "स च राजाऽकरोद्यत्नं महान्तं ससुहृज्जनः।\nप्रणिपातेन सान्त्वेन दानेन च महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2012168, "chapter_id": 1248, "verse_number": "१-२४९-२८", "content_sanskrit": "ऋत्विजोऽनुनयामास भूयो भूयस्त्वतन्द्रितः।\nते चास्य तमभिप्रायं न चक्रुरमितौजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2012169, "chapter_id": 1248, "verse_number": "१-२४९-२९", "content_sanskrit": "स चाश्रमस्थान्राजर्षिस्तानुवाच रुषान्वितः।\nयद्यहं पतितो विप्राः शुश्रूषायां न च स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2012170, "chapter_id": 1248, "verse_number": "१-२४९-३०", "content_sanskrit": "आशु त्याज्योऽस्मि युष्माभिर्ब्राह्मणैश्च जुगुप्सितः।\nतन्नार्हथ क्रतुश्रद्धां व्याघातयितुमद्य ताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2012171, "chapter_id": 1248, "verse_number": "१-२४९-३१", "content_sanskrit": "अस्थाने वा परित्यागं कर्तुं मे द्विजसत्तमाः।\nप्रपन्न एव वो विप्राः प्रसादं कर्तुमर्हथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2012172, "chapter_id": 1248, "verse_number": "१-२४९-३२", "content_sanskrit": "सान्त्वदानादिभिर्वाक्यैस्तत्त्वतः कार्यवत्तया।\nप्रसादयित्वा वक्ष्यामि यन्नः कार्यं द्विजोत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2012173, "chapter_id": 1248, "verse_number": "१-२४९-३३", "content_sanskrit": "अथवाऽहं परित्यक्तो भवद्भिर्द्वेषकारणात्।\nऋत्विजोऽन्यान्गमिष्यामि याजनार्थं द्विजोत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2012174, "chapter_id": 1248, "verse_number": "१-२४९-३४", "content_sanskrit": "एतावदुक्त्वा वचनं विरराम स पार्थिवः।\nयदा न शेकू राजानं याजनार्थं परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2012175, "chapter_id": 1248, "verse_number": "१-२४९-३५", "content_sanskrit": "ततस्ते याजकाः क्रुद्धास्तमूचुर्नृपसत्तमम्।\nतव कर्माम्यजस्रं वै वर्तन्ते पार्थिवोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2012176, "chapter_id": 1248, "verse_number": "१-२४९-३६", "content_sanskrit": "ततो वयं परिश्रान्ताः सततं कर्मवाहिनः।\nश्रमादस्मात्परिश्रान्तान्स त्वं नस्त्यक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2012177, "chapter_id": 1248, "verse_number": "१-२४९-३७", "content_sanskrit": "बुद्धिमोहं समास्थाय त्वरासंभावितोऽनघ।\nगच्छ रुद्रसकाशं त्वं सहि त्वां याजयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2012178, "chapter_id": 1248, "verse_number": "१-२४९-३८", "content_sanskrit": "साधिक्षेपं वचः श्रुत्वा संक्रुद्धः श्वेतकिर्नृपः।\nकैलासं पर्वतं गत्वा तप उग्रं समास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2012179, "chapter_id": 1248, "verse_number": "१-२४९-३९", "content_sanskrit": "आराधयन्महादेवं नियतः संशितव्रतः।\nउपवासपरो राजन्दीर्घकालमतिष्ठत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2012180, "chapter_id": 1248, "verse_number": "१-२४९-४०", "content_sanskrit": "कदाचिद्द्वादशे काले कदाचिदपि षोडशे।\nआहारमकरोद्राजा मूलानि च फलानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2012181, "chapter_id": 1248, "verse_number": "१-२४९-४१", "content_sanskrit": "ऊर्ध्वबाहुस्त्वनिमिषस्तिष्ठन्स्थाणुरिवाचलः।\nषण्मासानभवद्राजा श्वेतकिः सुसमाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2012182, "chapter_id": 1248, "verse_number": "१-२४९-४२", "content_sanskrit": "तं तथा नृपशार्दूलं तप्यमानं महत्तपः।\nशङ्करः परमप्रीत्या दर्शयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2012183, "chapter_id": 1248, "verse_number": "१-२४९-४३", "content_sanskrit": "उवाच चैनं भगवान्स्निग्धगम्भीरया गिरा।\nप्रीतोऽस्मि नरशार्दूल तपसा ते परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2012184, "chapter_id": 1248, "verse_number": "१-२४९-४४", "content_sanskrit": "वरं वृणीष्व भद्रं ते यं त्वमिच्छसि पार्थिव।\nएतच्छ्रुत्वा तु वचनं रुद्रस्यामिततेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2012185, "chapter_id": 1248, "verse_number": "१-२४९-४५", "content_sanskrit": "प्रणिपत्य महात्मानं राजर्षिः प्रत्यभाषत।\nयदि मे भगवान्प्रीतः सर्वलोकनमस्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2012186, "chapter_id": 1248, "verse_number": "१-२४९-४६", "content_sanskrit": "स्वयं मां देवदेवेश याजयस्व सुरेश्वर।\nएतच्छ्रुत्वा तु वचनं राज्ञा तेन प्रभाषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2012187, "chapter_id": 1248, "verse_number": "१-२४९-४७", "content_sanskrit": "उवाच भगवान्प्रीतः स्मितपूर्वमिदं वचः।\nनास्माकमेतद्विषये वर्तते याजनं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2012188, "chapter_id": 1248, "verse_number": "१-२४९-४८", "content_sanskrit": "त्वया च सुमहत्तप्तं तपो राजन्वरार्थिना।\nयाजयिष्यामि राजंस्त्वां समयेन परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2012189, "chapter_id": 1248, "verse_number": "१-२४९-४९", "content_sanskrit": "समा द्वादश राजेन्द्र ब्रह्मचारी समाहितः।\nसततं त्वाज्यधाराभिर्यदि तर्पयसेऽनलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2012190, "chapter_id": 1248, "verse_number": "१-२४९-५०", "content_sanskrit": "कामं प्रार्थयसे यं त्वं मत्तः प्राप्स्यसि तं नृप।\nएवमुक्तश्च रुद्रेण श्वेतकिर्मनुजाधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2012191, "chapter_id": 1248, "verse_number": "१-२४९-५१", "content_sanskrit": "तथा चकार तत्सर्वं यथोक्तं शूलपाणिना।\nपूर्णे तु द्वादशे वर्षे पुनरायान्महेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2012192, "chapter_id": 1248, "verse_number": "१-२४९-५२", "content_sanskrit": "दृष्टैव च स राजानं शङ्करो लोकभावनः।\nउवाच परमप्रीतः श्वेतकिं नृपसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2012193, "chapter_id": 1248, "verse_number": "१-२४९-५३", "content_sanskrit": "तोषितोऽहं नृपश्रेष्ठ त्वयेहाद्येन कर्मणा॥\nयाजनं ब्राह्मणानां तु विधिदृष्टं परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2012194, "chapter_id": 1248, "verse_number": "१-२४९-५४", "content_sanskrit": "अतोऽहं त्वां स्वयं नाद्य याजयामि परन्तप।\nममांशस्तु क्षितितले महाभागो द्विजोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2012195, "chapter_id": 1248, "verse_number": "१-२४९-५५", "content_sanskrit": "दुर्वासा इति विख्यातः स हि त्वां याजयिष्यति।\nमन्नियोगान्महातेजाः संभाराः संभ्रियन्तु ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2012196, "chapter_id": 1248, "verse_number": "१-२४९-५६", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं रुद्रेण समुदाहृतम्।\nस्वपुरं पुनरागम्य संभारान्पुनरार्जयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2012197, "chapter_id": 1248, "verse_number": "१-२४९-५७", "content_sanskrit": "ततः संभृतसंभारो भूयो रुद्रमुपागमत्।\nउवाच च महिपालः प्राञ्जलिः प्रणतः स्थितः।\nसंभृता मम संभाराः सर्वोपकरणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2012198, "chapter_id": 1248, "verse_number": "१-२४९-५८", "content_sanskrit": "त्वत्प्रसादानमहादेव श्वो मे दीक्षा भवेदिति।\nएतच्छ्रुत्वा तु वचनं तस्य राज्ञो महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2012199, "chapter_id": 1248, "verse_number": "१-२४९-५९", "content_sanskrit": "दुर्वाससं समाहूय रुद्रो वचनमब्रवीत्।\nएष राजा महाभागः श्वेतकिर्द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2012200, "chapter_id": 1248, "verse_number": "१-२४९-६०", "content_sanskrit": "एनं याजय विप्रेन्द्र मन्नियोगेन भूमिपम्।\nबाढमित्येव वचनं रुद्रं त्वृषिरुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2012201, "chapter_id": 1248, "verse_number": "१-२४९-६१", "content_sanskrit": "ततः सत्रं समभवत्तस्य राज्ञो महात्मनः।\nयथाविधि यथाकालं यथोक्तं बहुदक्षिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2012202, "chapter_id": 1248, "verse_number": "१-२४९-६२", "content_sanskrit": "तस्मिन्परिसमाप्ते तु राज्ञः सत्रे महात्मनः।\nदुर्वाससाऽभ्यनुज्ञाता विप्रतस्थुः स्म याजकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2012203, "chapter_id": 1248, "verse_number": "१-२४९-६३", "content_sanskrit": "ये तत्र दीक्षिताः सर्वे सदस्याश्च महौजसः।\nसोऽपि राजन्महाभागः स्वपुरं प्राविशत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2012204, "chapter_id": 1248, "verse_number": "१-२४९-६४", "content_sanskrit": "पूज्यमानो महाभागैर्ब्राह्मणैर्वेदपारगैः।\nबन्दिभिः स्तूयमानश्च नागरैश्चाभिनन्दितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2012205, "chapter_id": 1248, "verse_number": "१-२४९-६५", "content_sanskrit": "एवंवृत्तः स राजर्षिः श्वेतकिर्नृपसत्तमः।\nकालेन महता चापि ययौ स्वर्गमभिष्टुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2012206, "chapter_id": 1248, "verse_number": "१-२४९-६६", "content_sanskrit": "ऋत्विग्भिः सहितः सर्वैः सदस्यैश्च समन्वितः।\nतस्य सत्रे पपौ वह्निर्हविद्वार्दशवत्सरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2012207, "chapter_id": 1248, "verse_number": "१-२४९-६७", "content_sanskrit": "सततं चाज्यधाराभिरैकात्म्ये तत्र कर्मणि।\nहविषा च ततो वह्निः परां तृप्तिमगच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2012208, "chapter_id": 1248, "verse_number": "१-२४९-६८", "content_sanskrit": "न चैच्छत्पुनरादातुं हविरन्यस्य कस्यचित्।\nपाण्डुवर्णो विवर्णश्च न यतावत्प्रकाशते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2012209, "chapter_id": 1248, "verse_number": "१-२४९-६९", "content_sanskrit": "ततो भघवतो वह्नेर्विकारः समजायत।\nतेजसा विप्रहीणश्च ग्लानिश्चैनं समाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2012210, "chapter_id": 1248, "verse_number": "१-२४९-७०", "content_sanskrit": "स लक्षयित्वा चात्मानं तेजोहीनं हुताशनः।\nजगाम सदनं पुण्यं ब्रह्मणो लोकपूजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2012211, "chapter_id": 1248, "verse_number": "१-२४९-७१", "content_sanskrit": "तत्र ब्रह्माणमासीनमिदं वचनमब्रवीत्।\nभगवन्परमा प्रीतिः कृता श्वेतकिना मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2012212, "chapter_id": 1248, "verse_number": "१-२४९-७२", "content_sanskrit": "अरुचिश्चाभवत्तीव्रा तां न शक्नोम्यपोहितुम्।\nतेजसा विप्रहीणोऽस्मि बलेन च जगत्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2012213, "chapter_id": 1248, "verse_number": "१-२४९-७३", "content_sanskrit": "इच्छेयं त्वत्प्रसादेन स्वात्मनः प्रकृतिं स्थिराम्।\nएतच्छ्रुत्वा हुतवहाद्भगवान्सर्वलोककृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2012214, "chapter_id": 1248, "verse_number": "१-२४९-७४", "content_sanskrit": "हव्यवाहमिदं वाक्यमुवाच प्रहसन्निव।\nत्वया द्वादश वर्षाणि वसोर्धाराहुतं हविः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2012215, "chapter_id": 1248, "verse_number": "१-२४९-७५", "content_sanskrit": "उपयुक्तं महाभाग तेन त्वां ग्लानिराविशत्।\nतेजसा विप्रहीणत्वात्सहसा हव्यवाहन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2012216, "chapter_id": 1248, "verse_number": "१-२४९-७६", "content_sanskrit": "मागमस्त्वं व्यथां वह्ने प्रकृतिस्थो भविष्यसि।\nअरुचिं नाशयिष्येऽहं समयं प्रतिपद्य ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2012217, "chapter_id": 1248, "verse_number": "१-२४९-७७", "content_sanskrit": "पुरा देवनियोगेन यत्त्वया भस्मसात्कृतम्।\nआलयं देवशत्रूणां सुघोरं खाण्डवं वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2012218, "chapter_id": 1248, "verse_number": "१-२४९-७८", "content_sanskrit": "तत्र सर्वाणि सत्वानि निवसन्ति विभावसो।\nतेषां त्वं मेदसा तृप्तः प्रकृतिस्थो भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2012219, "chapter_id": 1248, "verse_number": "१-२४९-७९", "content_sanskrit": "गच्छ शीघ्रं प्रदग्धुं त्वं ततो मोक्ष्यसि किल्विषात्।\nएतच्छुत्वा तु वचनं परमेष्ठिमुखाच्च्युतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2012220, "chapter_id": 1248, "verse_number": "१-२४९-८०", "content_sanskrit": "उत्तमं जवमास्थाय प्रदुद्राव हुताशनः।\nआगम्य खाण्डवं दावमुत्तमं वीर्यमास्थितः।\nसहसा प्राज्वलच्चाग्निः क्रुद्धो वायुसमीरितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2012221, "chapter_id": 1248, "verse_number": "१-२४९-८१", "content_sanskrit": "प्रदीप्तं खाण्डवं दृष्ट्वा ये स्युस्तत्र निवासिनः।\nपरमं यत्नेमातिष्ठन्पावकस्य प्रशान्तये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2012222, "chapter_id": 1248, "verse_number": "१-२४९-८२", "content_sanskrit": "करैस्तु करिणः शीघ्रं जलमादाय सत्वराः।\nसिषिचुः पावकं क्रुद्धाः शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2012223, "chapter_id": 1248, "verse_number": "१-२४९-८३", "content_sanskrit": "बहुशीर्षास्ततो नागाः शिरोभिर्जलसन्ततिम्।\nमुमुचुः पावकाभ्याशे सत्वराः क्रोधमूर्च्छिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2012224, "chapter_id": 1248, "verse_number": "१-२४९-८४", "content_sanskrit": "तथैवान्यानि सत्वानि नानाप्रहरणोद्यमैः।\nविलयं पावकं शीघ्रमनयन्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2012225, "chapter_id": 1248, "verse_number": "१-२४९-८५", "content_sanskrit": "अनेन तु प्रकारेण भूयोभूयश्च प्रज्वलन्।\nसप्तकृत्वः प्रशमितः खाण्डवे हव्यवाहनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2012226, "chapter_id": 1248, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि खाण्डवदाहपर्वणि ऊनपञ्चाशदधिकद्विशततमोऽध्यायः॥ २४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}]