[{"id": 7000377000, "chapter_id": 20377, "verse_number": "२-४९-१", "content_sanskrit": "ब्राह्मण्युवाच ।\nएकदा तु महाभाग गता सा पर्वतोत्तमे ।\nरमणीयं वनं दृष्ट्वा कदलीखंडमंडितम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000377001, "chapter_id": 20377, "verse_number": "२-४९-२", "content_sanskrit": "शालैस्तालैस्तमालैश्च नालिकेरैस्तथोत्कटैः ।\nपूगीफलैर्मातुलिगैर्नारंगैश्चारुजंबुकैः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000377002, "chapter_id": 20377, "verse_number": "२-४९-३", "content_sanskrit": "चंपकैः पाटलैः पुण्यैः पुष्पितैः कुटकैर्वटैः ।\nअशोकबकुलोपेतं नानावृक्षैरलंकृतम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000377003, "chapter_id": 20377, "verse_number": "२-४९-४", "content_sanskrit": "पर्वतं पुण्यवंतं तं पुष्पितैश्च नगोत्तमैः ।\nसर्वत्र दृश्यते रम्यो नानाधातुसमाकुलः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000377004, "chapter_id": 20377, "verse_number": "२-४९-५", "content_sanskrit": "तडागं सर्वतोभद्रं पुण्यतोयेन पूरितम् ।\nकमलैः पुष्पितैश्चान्यैः सुगंधैः कनकोत्पलैः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000377005, "chapter_id": 20377, "verse_number": "२-४९-६", "content_sanskrit": "श्वेतोत्पलैर्विभासंतं रक्तोत्पलसुपुष्पितैः ।\nनीलोत्पलैश्च कह्लारैर्हंसैश्च जलकुक्कुटैः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000377006, "chapter_id": 20377, "verse_number": "२-४९-७", "content_sanskrit": "पक्षिभिर्जलजैश्चान्यैर्नानाधातुसमाकुलः ।\nतडागं सर्वतः शुभ्रं नानापक्षिगणैर्युतम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000377007, "chapter_id": 20377, "verse_number": "२-४९-८", "content_sanskrit": "कोकिलानां रुतैः पुण्यैः सुस्वरैः परिशोभितः ।\nमधुराणां तथा शब्दैः सर्वत्र मधुरायते॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000377008, "chapter_id": 20377, "verse_number": "२-४९-९", "content_sanskrit": "षट्पदानां सुनादेन सर्वत्र परिशोभते ।\nएवंविधं गिरिं रम्यं तदेव वनमुत्तमम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000377009, "chapter_id": 20377, "verse_number": "२-४९-१०", "content_sanskrit": "तडागं सर्वतोभद्रं ददृशे नृपनंदिनी ।\nवैदर्भी क्रीडमाना सा सखीभिः सहिता तदा॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000377010, "chapter_id": 20377, "verse_number": "२-४९-११", "content_sanskrit": "समालोक्य वनं पुण्यं सर्वत्र कुसुमाकुलम् ।\nचापल्येन प्रभावेण स्त्रीभावेन च लीलया॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000377011, "chapter_id": 20377, "verse_number": "२-४९-१२", "content_sanskrit": "पद्मावती सरस्तीरे सखीभिः सहिता तदा ।\nजलक्रीडा समालीना हसते गायते पुनः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000377012, "chapter_id": 20377, "verse_number": "२-४९-१३", "content_sanskrit": "रममाणा च सा तस्मिंस्तस्मिन्सरसि भामिनी ।\nएवं विप्र तदा सा तु सुखेन परिवर्तयेत्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000377013, "chapter_id": 20377, "verse_number": "२-४९-१४", "content_sanskrit": "विष्णुरुवाच ।\nगोभिलो नाम वै दैत्यो भृत्यो वैश्रवणस्य च ।\nदिव्येनापि विमानेन सर्वभोगपरिप्लुतः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000377014, "chapter_id": 20377, "verse_number": "२-४९-१५", "content_sanskrit": "याति चाकाशमार्गेण गोभिलो दैत्यसत्तमः ।\nतेन दृष्टा विशालाक्षी वैदर्भी निर्भया तदा॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000377015, "chapter_id": 20377, "verse_number": "२-४९-१६", "content_sanskrit": "सर्वयोषिद्वरा सा हि उग्रसेनस्य वै प्रिया ।\nरूपेणाप्रतिमा लोके सर्वांगेषु विराजते॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000377016, "chapter_id": 20377, "verse_number": "२-४९-१७", "content_sanskrit": "रतिर्वै मन्मथस्यापि किं वापीयं हरिप्रिया ।\nकिं वापि पार्वती देवी शची किं वा भविष्यति॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000377017, "chapter_id": 20377, "verse_number": "२-४९-१८", "content_sanskrit": "यादृशी दृश्यते चेयं नारीणां प्रवरोत्तमा ।\nअन्यापि ईदृशी नास्ति द्वितीया क्षितिमंडले॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000377018, "chapter_id": 20377, "verse_number": "२-४९-१९", "content_sanskrit": "नक्षत्रेषु यथा चंद्रः संपूर्णो भाति शोभनः ।\nगुणरूपकलाभिस्तु तथा भाति वरानना॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000377019, "chapter_id": 20377, "verse_number": "२-४९-२०", "content_sanskrit": "पुष्करेषु यथा हंसस्तथेयं चारुहासिनी ।\nअहो रूपमहोभाव अस्यास्तु परिदृश्यते॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000377020, "chapter_id": 20377, "verse_number": "२-४९-२१", "content_sanskrit": "का कस्य शोभना बाला चारुवृत्तपयोधरा ।\nव्यमृशद्गोभिलो दैत्यः पद्मावतीं वराननाम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000377021, "chapter_id": 20377, "verse_number": "२-४९-२२", "content_sanskrit": "चिंतयित्वा क्षणं विप्र का कस्यापि भविष्यति ।\nज्ञानेन महता ज्ञात्वा वैदर्भीति न संशयः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000377022, "chapter_id": 20377, "verse_number": "२-४९-२३", "content_sanskrit": "दयिता उग्रसेनस्य पतिव्रतपरायणा ।\nआत्मबलेन तिष्ठंती दुष्प्राप्या पुरुषैरपि॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000377023, "chapter_id": 20377, "verse_number": "२-४९-२४", "content_sanskrit": "उग्रसेनो महामूर्खः प्रेषिता येन वै वरा ।\nपितुर्गेहमियं बाला स तु भाग्येन वर्जितः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000377024, "chapter_id": 20377, "verse_number": "२-४९-२५", "content_sanskrit": "अनया विना स जीवेच्च कथं कूटमतिः सदा ।\nकिं वा नपुंसको राजा एनां यो हि परित्यजेत्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000377025, "chapter_id": 20377, "verse_number": "२-४९-२६", "content_sanskrit": "तां दृष्ट्वा स तु कामात्मा संजातस्तत्क्षणादपि ।\nइयं पतिव्रता बाला दुष्प्राप्या पुरुषैरपि॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000377026, "chapter_id": 20377, "verse_number": "२-४९-२७", "content_sanskrit": "कथं भोक्ष्याम्यहं गत्वा कामो मामति पीडयेत् ।\nअभुक्त्वैनां यदा यास्ये तत्स्यान्मृत्युर्ममैव हि॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000377027, "chapter_id": 20377, "verse_number": "२-४९-२८", "content_sanskrit": "अद्यैव हि न संदेहो यतः कामो महाबलः ।\nइति चिंतापरो भूत्वा गोभिलो मनसैक्षत॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000377028, "chapter_id": 20377, "verse_number": "२-४९-२९", "content_sanskrit": "कृत्वा मायामयं रूपमुग्रसेनस्य भूपतेः ।\nयादृशस्तूग्रसेनश्च सांगोपांगो महानृपः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000377029, "chapter_id": 20377, "verse_number": "२-४९-३०", "content_sanskrit": "गोभिलस्तादृशो भूत्वा गत्या च स्वरभाषया ।\nयथावस्त्रो यथावेशो वयसा च तथा पुनः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000377030, "chapter_id": 20377, "verse_number": "२-४९-३१", "content_sanskrit": "दिव्यमाल्यांबरधरो दिव्यगंधानुलेपनः ।\nसर्वाभरणशोभांगो यादृशो माथुरेश्वरः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000377031, "chapter_id": 20377, "verse_number": "२-४९-३२", "content_sanskrit": "भूत्वाथ तादृशो दैत्य उग्रसेनमयस्तदा ।\nमायया परया युक्तो रूपलावण्यसंपदा॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000377032, "chapter_id": 20377, "verse_number": "२-४९-३३", "content_sanskrit": "पर्वताग्रे अशोकस्यच्छायामाश्रित्य संस्थितः ।\nशिलातलस्थो दुष्टात्मा वीणादंडेन वीरकः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000377033, "chapter_id": 20377, "verse_number": "२-४९-३४", "content_sanskrit": "सुस्वरं गायमानस्तु गीतं विश्वप्रमोहनम् ।\nतालमानक्रियोपेतं सप्तस्वरविभूषितम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000377034, "chapter_id": 20377, "verse_number": "२-४९-३५", "content_sanskrit": "गीतं गायति दुष्टात्मा तस्या रूपेण मोहितः ।\nपर्वताग्रे स्थितो विप्र हर्षेण महतान्वितः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000377035, "chapter_id": 20377, "verse_number": "२-४९-३६", "content_sanskrit": "सखीमध्यगता सा तु पद्मावती वरानना ।\nशुश्रुवे सुस्वरं गीतं तालमानलयान्वितम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000377036, "chapter_id": 20377, "verse_number": "२-४९-३७", "content_sanskrit": "कोऽयं गायति धर्मात्मा महत्सौख्यप्रदायकम् ।\nगीतं हि सत्क्रियोपेतं सर्वभावसमन्वितम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000377037, "chapter_id": 20377, "verse_number": "२-४९-३८", "content_sanskrit": "सखीभिः सहिता गत्वा औत्सुक्येन नृपात्मजा ।\nअशोकच्छायामाश्रित्य विमले सुशिलातले॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000377038, "chapter_id": 20377, "verse_number": "२-४९-३९", "content_sanskrit": "ददर्श भूपवेषेण गोभिलं दानवाधमम् ।\nपुष्पमालांबरधरं दिव्यगंधानुलेपनम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000377039, "chapter_id": 20377, "verse_number": "२-४९-४०", "content_sanskrit": "सर्वाभरणशोभांगं पद्मावती पतिव्रता ।\nमथुरेशः समायातः कदा धर्मपरायणः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000377040, "chapter_id": 20377, "verse_number": "२-४९-४१", "content_sanskrit": "मम नाथो महात्मा वै राज्यं त्यक्त्वा प्रदूरतः ।\nयावद्धि चिंतयेत्सा च तावत्पापेन तेन सा॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000377041, "chapter_id": 20377, "verse_number": "२-४९-४२", "content_sanskrit": "समाहूता तुरीभूय एहि त्वं हि प्रिये मम ।\nचकिताशंकितासाचकथंभर्त्तासमागतः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000377042, "chapter_id": 20377, "verse_number": "२-४९-४३", "content_sanskrit": "लज्जिता दुःखिता जाता अधःकृत्वा ततो मुखम् ।\nअहं पापा दुराचारा निःशंका परिवर्तिता॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000377043, "chapter_id": 20377, "verse_number": "२-४९-४४", "content_sanskrit": "कोपमेवं महाभागः करिष्यति न संशयः ।\nयावद्धि चिंतयेत्सा च तावत्तेनापि पापिना॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000377044, "chapter_id": 20377, "verse_number": "२-४९-४५", "content_sanskrit": "समाहूता तुरीभूय एह्येहि त्वं मम प्रिये ।\nत्वया विना कृतो देवि प्राणान्धर्तुं वरानने॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000377045, "chapter_id": 20377, "verse_number": "२-४९-४६", "content_sanskrit": "न हि शक्नोम्यहं कांते जीवितं प्रियमेव च ।\nतव स्नेहेन लुब्धोस्मि त्वां त्यक्त्वा नोत्सहे भृशम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000377046, "chapter_id": 20377, "verse_number": "२-४९-४७", "content_sanskrit": "ब्राह्मण्युवाच ।\nएवमुक्ता गतापश्यत्सुमुखं लज्जयान्विता ।\nसमालिंग्य ततो दैत्यः सतीं पद्मावतीं तदा॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000377047, "chapter_id": 20377, "verse_number": "२-४९-४८", "content_sanskrit": "एकांतं तु समानीता सुभुक्ता इच्छया ततः ।\nदैत्येन गोभिलेनापि सत्यकेतोः सुता तदा॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000377048, "chapter_id": 20377, "verse_number": "२-४९-४९", "content_sanskrit": "सुकलोवाच ।\nमुष्कस्थानेस्य संकेतं नाविंदत वरानना ।\nस्ववस्त्रं सा परिगृह्य शंकिता दुःखिता ह्यभूत्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000377049, "chapter_id": 20377, "verse_number": "२-४९-५०", "content_sanskrit": "सा सक्रोधा वचः प्राह गोभिलं दानवाधमम् ।\nकस्त्वं पापसमाचारो निर्घृणो दानवाकृतिः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000377050, "chapter_id": 20377, "verse_number": "२-४९-५१", "content_sanskrit": "शप्तुकामा समुद्युक्ता दुःखेनाकुलितेक्षणा ।\nवेपमाना तदा राजन्दुःखभारेण पीडिता॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000377051, "chapter_id": 20377, "verse_number": "२-४९-५२", "content_sanskrit": "मम कांतच्छलेनैव त्वयागत्य दुरात्मवन् ।\nनाशितं धर्ममेवाग्र्यं पातिव्रत्यमनुत्तमम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000377052, "chapter_id": 20377, "verse_number": "२-४९-५३", "content_sanskrit": "सुस्वरं रुदितं कृत्वा मम जन्म त्वया हृतम् ।\nपश्य मे बलमत्रैव शापं दास्ये सुदारुणम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000377053, "chapter_id": 20377, "verse_number": "२-४९-५४", "content_sanskrit": "एवं संभाषमाणा तं शप्तुकामा तु गोभिलम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]