[{"id": 5000281000, "chapter_id": 9281, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे नवमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000281001, "chapter_id": 9281, "verse_number": "४-९-१", "content_sanskrit": "वाली नाम मम भ्राता ज्येष्ठः शत्रुनिषूदनः।\nपितुर्बहुमतो नित्यं मम चापि तथा पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000281002, "chapter_id": 9281, "verse_number": "४-९-२", "content_sanskrit": "पितर्युपरते तस्मिन् ज्येष्ठोऽयमिति मन्त्रिभिः।\nकपीनामीश्वरो राज्ये कृतः परमसम्मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000281003, "chapter_id": 9281, "verse_number": "४-९-३", "content_sanskrit": "राज्यं प्रशासतस्तस्य पितृपैतामहं महत्।\nअहं सर्वेषु कालेषु प्रणतः प्रेष्यवत् स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000281004, "chapter_id": 9281, "verse_number": "४-९-४", "content_sanskrit": "मायावी नाम तेजस्वी पूर्वजो दुन्दुभेः सुतः।\nतेन तस्य महद्वैरं वालिनः स्त्रीकृतं पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000281005, "chapter_id": 9281, "verse_number": "४-९-५", "content_sanskrit": "स तु सुप्ते जने रात्रौ किष्किन्धाद्वारमागतः।\nनर्दति स्म सुसंरब्धो वालिनं चाह्वयद् रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000281006, "chapter_id": 9281, "verse_number": "४-९-६", "content_sanskrit": "प्रसुप्तस्तु मम भ्राता नर्दतो भैरवस्वनम्।\nश्रुत्वा न ममृषे वाली निष्पपात जवात् तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000281007, "chapter_id": 9281, "verse_number": "४-९-७", "content_sanskrit": "स तु वै निःसृतः क्रोधात् तं हन्तुमसुरोत्तमम्।\nवार्यमाणस्ततः स्त्रीभिर्मया च प्रणतात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000281008, "chapter_id": 9281, "verse_number": "४-९-८", "content_sanskrit": "स तु निर्धूय सर्वान् नो निर्जगाम महाबलः।\nततोऽहमपि सौहार्दान्निःसृतो वालिना सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000281009, "chapter_id": 9281, "verse_number": "४-९-९", "content_sanskrit": "स तु मे भ्रातरं दृष्ट्वा मां च दूरादवस्थितम्।\nअसुरो जातसंत्रासः प्रदुद्राव तदा भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000281010, "chapter_id": 9281, "verse_number": "४-९-१०", "content_sanskrit": "तस्मिन् द्रवति संत्रस्ते ह्यावां द्रुततरं गतौ।\nप्रकाशोऽपि कृतो मार्गश्चन्द्रेणोद‍्गच्छता तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000281011, "chapter_id": 9281, "verse_number": "४-९-११", "content_sanskrit": "स तृणैरावृतं दुर्गं धरण्या विवरं महत्।\nप्रविवेशासुरो वेगादावामासाद्य विष्ठितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000281012, "chapter_id": 9281, "verse_number": "४-९-१२", "content_sanskrit": "तं प्रविष्टं रिपुं दृष्ट्वा बिलं रोषवशं गतः।\nमामुवाच ततो वाली वचनं क्षुभितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000281013, "chapter_id": 9281, "verse_number": "४-९-१३", "content_sanskrit": "इह तिष्ठाद्य सुग्रीव बिलद्वारि समाहितः।\nयावदत्र प्रविश्याहं निहन्मि समरे रिपुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000281014, "chapter_id": 9281, "verse_number": "४-९-१४", "content_sanskrit": "मया त्वेतद् वचः श्रुत्वा याचितः स परंतपः।\nशापयित्वा च मां पद‍्भ्यां प्रविवेश बिलं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000281015, "chapter_id": 9281, "verse_number": "४-९-१५", "content_sanskrit": "तस्य प्रविष्टस्य बिलं साग्रः संवत्सरो गतः।\nस्थितस्य च बिलद्वारि स कालो व्यत्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000281016, "chapter_id": 9281, "verse_number": "४-९-१६", "content_sanskrit": "अहं तु नष्टं तं ज्ञात्वा स्नेहादागतसम्भ्रमः।\nभ्रातरं न प्रपश्यामि पापशङ्कि च मे मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000281017, "chapter_id": 9281, "verse_number": "४-९-१७", "content_sanskrit": "अथ दीर्घस्य कालस्य बिलात् तस्माद् विनिःसृतम्।\nसफेनं रुधिरं दृष्ट्वा ततोऽहं भृशदुःखितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000281018, "chapter_id": 9281, "verse_number": "४-९-१८", "content_sanskrit": "नर्दतामसुराणां च ध्वनिर्मे श्रोत्रमागतः।\nन रतस्य च संग्रामे क्रोशतोऽपि स्वनो गुरोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000281019, "chapter_id": 9281, "verse_number": "४-९-१९", "content_sanskrit": "अहं त्ववगतो बुद्ध्या चिह्नैस्तैर्भ्रातरं हतम्।\nपिधाय च बिलद्वारं शिलया गिरिमात्रया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000281020, "chapter_id": 9281, "verse_number": "४-९-२०", "content_sanskrit": "शोकार्तश्चोदकं कृत्वा किष्किन्धामागतः सखे।\nगूहमानस्य मे तत् त्वं यत्नतो मन्त्रिभिः श्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000281021, "chapter_id": 9281, "verse_number": "४-९-२१", "content_sanskrit": "ततोऽहं तैः समागम्य समेतैरभिषेचितः।\nराज्यं प्रशासतस्तस्य न्यायतो मम राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000281022, "chapter_id": 9281, "verse_number": "४-९-२२", "content_sanskrit": "आजगाम रिपुं हत्वा दानवं स तु वानरः।\nअभिषिक्तं तु मां दृष्ट्वा क्रोधात् संरक्तलोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000281023, "chapter_id": 9281, "verse_number": "४-९-२३", "content_sanskrit": "मदीयान् मन्त्रिणो बद्‍ध्वा परुषं वाक्यमब्रवीत्।\nनिग्रहे च समर्थस्य तं पापं प्रति राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000281024, "chapter_id": 9281, "verse_number": "४-९-२४", "content_sanskrit": "न प्रावर्तत मे बुद्धिर्भ्रातृगौरवयन्त्रिता।\nहत्वा शत्रुं स मे भ्राता प्रविवेश पुरं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000281025, "chapter_id": 9281, "verse_number": "४-९-२५", "content_sanskrit": "मानयंस्तं महात्मानं यथावच्चाभिवादयम्।\nउक्ताश्च नाशिषस्तेन प्रहृष्टेनान्तरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000281026, "chapter_id": 9281, "verse_number": "४-९-२६", "content_sanskrit": "नत्वा पादावहं तस्य मुकुटेनास्पृशं प्रभो।\nअपि वाली मम क्रोधान्न प्रसादं चकार सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000281027, "chapter_id": 9281, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्येकिष्किन्धाकाण्डे नवमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]