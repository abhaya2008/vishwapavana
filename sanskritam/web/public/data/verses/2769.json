[{"id": 2082969, "chapter_id": 2769, "verse_number": "१२-२७४-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082970, "chapter_id": 2769, "verse_number": "१२-२७४-१", "content_sanskrit": "अविरोधेन भूतानां त्यागः षाङ्गुण्यकारकः।\nयः स्यादुमयभाग्धर्मस्तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082971, "chapter_id": 2769, "verse_number": "१२-२७४-२", "content_sanskrit": "गार्हस्थ्यस्य च धर्मस्य योगधर्मस्य चोभयोः।\nअदूरसंप्रस्थितयोः किंस्विच्छ्रेयः पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082972, "chapter_id": 2769, "verse_number": "१२-२७४-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082973, "chapter_id": 2769, "verse_number": "१२-२७४-३", "content_sanskrit": "उभौ धर्मौ महाभागावृभौ परमदुश्चरौ।\nउभौ नहाफलौ तौ तु सद्भिराचरितावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2082974, "chapter_id": 2769, "verse_number": "१२-२७४-४", "content_sanskrit": "अव ते वर्तयिष्यासि प्रामाण्यमुभयोस्तयोः।\nशुणुष्वैकमताः पार्थ च्छिन्नधर्मार्थसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2082975, "chapter_id": 2769, "verse_number": "१२-२७४-५", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nकपिलस्य गोश्च संवादं तन्निबोध युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2082976, "chapter_id": 2769, "verse_number": "१२-२७४-६", "content_sanskrit": "आम्नायमनुपश्यन्हि पुराणं शाश्वतं ध्रुवम्।\nनहुषः पूर्वमालेभे त्वष्टुर्गामिति नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2082977, "chapter_id": 2769, "verse_number": "१२-२७४-७", "content_sanskrit": "तां नियुक्तामदीनात्मा सत्वस्थः संयमे रतः।\nज्ञानवान्नियताहारो ददर्श कपिलस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2082978, "chapter_id": 2769, "verse_number": "१२-२७४-८", "content_sanskrit": "स बुद्धिमुत्तमां प्राप्तो नैष्ठिकीमकुतोभयाम्।\nस्वरेण शिथिलां सत्यां वेदा ३ इत्यब्रवीत्सकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2082979, "chapter_id": 2769, "verse_number": "१२-२७४-९", "content_sanskrit": "तां गामृषिः स्यूमरश्मिः प्रविश्य यतिमब्रवीत्।\nहंहो वेदा ३ यदि मता धर्माः केनापरे मताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2082980, "chapter_id": 2769, "verse_number": "१२-२७४-१०", "content_sanskrit": "तपस्विनो धृतिमतः श्रुतिविज्ञानचक्षुषः।\nसर्वमार्षं हि मन्यन्ते व्याहृतं विदितात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2082981, "chapter_id": 2769, "verse_number": "१२-२७४-११", "content_sanskrit": "तस्यैवं गततृष्णस्य विज्वरस्य निराशिषः।\nका विवक्षाऽस्ति वेदेषु निरारम्भस्य सर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2082982, "chapter_id": 2769, "verse_number": "१२-२७४-१२x", "content_sanskrit": "कपिल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2082983, "chapter_id": 2769, "verse_number": "१२-२७४-१२", "content_sanskrit": "नाहं वेदान्विनिन्दामि न विवक्ष्यामि कर्हिचित्।\nपृथगाश्रमिणां कर्माण्येकार्थानीति नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2082984, "chapter_id": 2769, "verse_number": "१२-२७४-१३", "content_sanskrit": "गच्छत्येव परित्यागी वानप्रस्थश्च गच्छति।\nगृहस्थो ब्रह्मचारी च उभौ तावपि गच्छतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2082985, "chapter_id": 2769, "verse_number": "१२-२७४-१४", "content_sanskrit": "देवयाना हि पन्थानश्चत्वारः शाश्वता मताः।\nनैषां ज्यायः कनीयस्त्वं फलेषूक्तं बलाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2082986, "chapter_id": 2769, "verse_number": "१२-२७४-१५", "content_sanskrit": "एवं विदित्वा सर्वार्थानारभेतेति वैदिकम्।\nनारभेतेति चान्यत्र नैष्ठिकी श्रूयते श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2082987, "chapter_id": 2769, "verse_number": "१२-२७४-१६", "content_sanskrit": "अनारम्भे ह्यदोषः स्यादारम्भे दोष उत्तमः।\nएवं स्थितस्य शास्त्रस्य दुर्विज्ञेयं बलाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2082988, "chapter_id": 2769, "verse_number": "१२-२७४-१७", "content_sanskrit": "यदत्र किंचित्प्रत्यक्षमहिंसायाः परं मतम्।\nऋते त्वागमशास्त्रेभ्यो ब्रूहि तद्यदि पश्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2082989, "chapter_id": 2769, "verse_number": "१२-२७४-१८x", "content_sanskrit": "स्यूमरश्मिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2082990, "chapter_id": 2769, "verse_number": "१२-२७४-१८", "content_sanskrit": "स्वर्गकामो यजेतेति सततं श्रूयते श्रुतिः।\nफलं प्रकल्प्य पूर्वं हि ततो यज्ञः प्रतायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2082991, "chapter_id": 2769, "verse_number": "१२-२७४-१९", "content_sanskrit": "अजश्चाश्वश्च मेषश्च र्गौश्च पक्षिगणाश्च ये।\nग्राम्यारण्याश्चौषधयः प्राणस्यान्नमिति श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2082992, "chapter_id": 2769, "verse_number": "१२-२७४-२०", "content_sanskrit": "तथैवान्नं ह्यहरहः सायंप्रातर्निरूप्यते।\nपशवश्चाथ धान्यं च यज्ञस्याङ्गमिति श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2082993, "chapter_id": 2769, "verse_number": "१२-२७४-२१", "content_sanskrit": "एतानि सह यज्ञेन प्रजापतिरकल्पयत्।\nतेन प्रजापतिर्देवान्यज्ञेनायजत प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2082994, "chapter_id": 2769, "verse_number": "१२-२७४-२२", "content_sanskrit": "तदन्योन्यवराः सर्वे प्राणिनः सप्तसप्त च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2082995, "chapter_id": 2769, "verse_number": "१२-२७४-२३", "content_sanskrit": "`गौरजो मनुजः श्वा वा अश्वाश्वतरगर्दभाः।\nएते ग्राम्याः समाख्याताः पशवः सप्त साधुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2082996, "chapter_id": 2769, "verse_number": "१२-२७४-२४", "content_sanskrit": "सिंहा व्याघ्रा वराहाश्च महिषा वारणास्तथा।\nहरिणः शललाश्चैव सप्तारण्यास्तथा स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2082997, "chapter_id": 2769, "verse_number": "१२-२७४-२५", "content_sanskrit": "यज्ञेषूपाकृतं विश्वं प्राहुरुत्तमसंज्ञितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2082998, "chapter_id": 2769, "verse_number": "१२-२७४-२६", "content_sanskrit": "एतच्चैवाभ्यनुज्ञातं पूर्वैः पूर्वतरैस्तथा।\nको जातु न विचिन्वीत विद्वान्स्वां शक्तिमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2082999, "chapter_id": 2769, "verse_number": "१२-२७४-२७", "content_sanskrit": "पशवश्च मनुष्याश्च द्रुमाश्चौषधिभिः सह।\nस्वर्गमेवाभिकाङ्क्षन्ते न च स्वर्गोस्ति ते मखात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2083000, "chapter_id": 2769, "verse_number": "१२-२७४-२८", "content_sanskrit": "ओषध्यः पशवो वृक्षा वीरुदाज्यं पयो दधि।\nहविर्भूमिर्दिशः श्रद्धा कालश्चैतानि द्वादश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2083001, "chapter_id": 2769, "verse_number": "१२-२७४-२९", "content_sanskrit": "ऋचो यजूंषि सामानि ऋत्विजश्चापि षोडश।\nअग्निर्ज्ञेयो गृहपतिः स सप्तदश उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2083002, "chapter_id": 2769, "verse_number": "१२-२७४-३०", "content_sanskrit": "अङ्गान्येतानि यज्ञस्य यज्ञो मूलमिति श्रुतिः।\nआज्येन पयसा दध्ना शकृताऽऽमिक्षया त्वचा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2083003, "chapter_id": 2769, "verse_number": "१२-२७४-३१", "content_sanskrit": "बालैः शृङ्गेण पादेन संभवत्येव गौर्मखम्।\nएवं प्रत्यकेशः सर्वं यद्यदस्य विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2083004, "chapter_id": 2769, "verse_number": "१२-२७४-३२", "content_sanskrit": "यज्ञं वहन्ति संभूय सहत्विंग्भिः सदक्षिणैः।\nसंहृत्यैतानि सर्वाणि यज्ञं निर्वर्तयन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2083005, "chapter_id": 2769, "verse_number": "१२-२७४-३३", "content_sanskrit": "यज्ञार्थानि हि सृष्टानि यथार्था श्रूयते श्रुतिः।\nएवं पूर्वतराः पूर्वे प्रवृत्ताश्चैव मानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2083006, "chapter_id": 2769, "verse_number": "१२-२७४-३४", "content_sanskrit": "न हिनस्ति नारभते नाभिद्रुह्यति किंचन।\nयज्ञैर्यष्टव्यमित्येव यो यजत्यफलेप्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2083007, "chapter_id": 2769, "verse_number": "१२-२७४-३५", "content_sanskrit": "यज्ञाङ्गान्यपि चैतानि यथोक्तान्यपि सर्वशः।\nविधिना विधियुक्तानि तारयन्ति परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2083008, "chapter_id": 2769, "verse_number": "१२-२७४-३६", "content_sanskrit": "आम्नायमार्षं पश्यामि यस्मिन्वेदाः प्रतिष्ठिताः।\nतं विद्वांसोऽनुपश्यन्ति ब्राह्मणस्यानुदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2083009, "chapter_id": 2769, "verse_number": "१२-२७४-३७", "content_sanskrit": "ब्राह्मणप्रभवो यज्ञो ब्राह्मणार्पण एव च।\nअनुयज्ञं जगत्सर्वं यज्ञश्चानुजगत्सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2083010, "chapter_id": 2769, "verse_number": "१२-२७४-३८", "content_sanskrit": "ओमिति ब्रह्मणो योनिर्नमः स्वाहा स्वधा वषट्।\nयस्यैतानि प्रयुज्यन्ते यथाशक्ति कृतान्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2083011, "chapter_id": 2769, "verse_number": "१२-२७४-३९", "content_sanskrit": "न तस्य त्रिषु लोकेषु परलोकभयं विदुः।\nइति वेदा वदन्तीह सिद्धाश्च परमर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2083012, "chapter_id": 2769, "verse_number": "१२-२७४-४०", "content_sanskrit": "ऋचो यजूंहि सामानि स्तोत्राश्च विधिचोदिताः।\nयस्मिन्नेतानि सर्वाणि भवन्तीह स वै द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2083013, "chapter_id": 2769, "verse_number": "१२-२७४-४१", "content_sanskrit": "अग्न्याधेये यद्भवति यच्च सोमे सुते द्विज।\nयच्चेतरैर्महायज्ञैर्वेद तद्भगवांस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2083014, "chapter_id": 2769, "verse_number": "१२-२७४-४२", "content_sanskrit": "तस्माद्ब्रह्मन्यजेच्चैव याजयेच्चाविचारयन्।\nयजतो यज्ञविधिना प्रेत्य स्वर्गफलं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2083015, "chapter_id": 2769, "verse_number": "१२-२७४-४३", "content_sanskrit": "नायं लोकोस्त्ययज्ञानां परश्चेति विनिश्चयः।\nवेदवादविदश्चैव प्रमाणमुभयं तदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2083016, "chapter_id": 2769, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि चतुःसप्तत्यधिकद्विशततमोऽध्यायः॥ २७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]