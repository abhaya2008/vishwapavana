[{"id": 2027780, "chapter_id": 1596, "verse_number": "३-२३४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2027781, "chapter_id": 1596, "verse_number": "३-२३४-१", "content_sanskrit": "उपासीनेषु विप्रेषु पाण्डवेषु च भारत।\nद्रौपदी सत्यभामा च विविशाते तदा समम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2027782, "chapter_id": 1596, "verse_number": "३-२३४-२", "content_sanskrit": "`प्रविश्य चाश्रमं पुण्यमुभे ते परमस्त्रियौ।\nजाहस्यमाने सुप्रीते सुखं तत्र निषीदतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2027783, "chapter_id": 1596, "verse_number": "३-२३४-३", "content_sanskrit": "चिरस् दृष्ट्वा राजेन्द्र तेऽन्योन्यस्य प्रियंवदे।\nकथयामासतुश्चित्राः कथाः कुरुयदूचिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2027784, "chapter_id": 1596, "verse_number": "३-२३४-४", "content_sanskrit": "अथाब्रवीत्सत्यभामा कृष्णस् महिषी प्रिया।\nसात्राजिती याज्ञसेनीं रहसीदं सुमध्यमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2027785, "chapter_id": 1596, "verse_number": "३-२३४-५", "content_sanskrit": "केन द्रौपदि वृत्तेन पाण्डवानधितिष्ठसि।\nलोकपालोपमान्वीरान्नूनं परमसंमतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2027786, "chapter_id": 1596, "verse_number": "३-२३४-६", "content_sanskrit": "कथं च वशगस्तुभ्यं न कुप्यन्ति च ते शुभे।\nतव वश्या हि सतत पाण्डवाः प्रियदर्शने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2027787, "chapter_id": 1596, "verse_number": "३-२३४-७", "content_sanskrit": "`न चान्योन्यमसूयन्ते कथं वा ते सुमध्यमे।\nमुखप्रेक्षाश्च ते सर्वे तत्त्वमेतद्ब्रवीहि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2027788, "chapter_id": 1596, "verse_number": "३-२३४-८", "content_sanskrit": "व्रतचर्या तपो वाऽपि स्नानमन्त्रौषधानि वा।\nविद्यावीर्यं मूलवीर्यंजपहोमागदास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2027789, "chapter_id": 1596, "verse_number": "३-२३४-९", "content_sanskrit": "ममाद्याचक्ष्वपाञ्चालि यशस्यं भगवेतनम्।\nयेन कृष्णे भवेन्नित्यं मम कृष्णो वशानुगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2027790, "chapter_id": 1596, "verse_number": "३-२३४-१०", "content_sanskrit": "एवमुक्त्वासत्यभामा विरराम यशस्विनी।\nपतिव्रता महाभागा द्रौपदी प्रत्युवाच ताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2027791, "chapter_id": 1596, "verse_number": "३-२३४-११", "content_sanskrit": "असत्स्त्रीणां समाचरं सत्ये मामनुपृच्छसि।\nअसदाचरिते मार्गे कथं स्यादनुकीर्तनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2027792, "chapter_id": 1596, "verse_number": "३-२३४-१२", "content_sanskrit": "अनुप्रश्नः संशयो वा नैष त्वय्युपपद्यते।\nकथं ह्युपेता बुद्ध्या त्वंकृष्णस् महिषी प्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2027793, "chapter_id": 1596, "verse_number": "३-२३४-१३", "content_sanskrit": "यदैव भर्ता जानीयानमन्त्रमूलपरां स्त्रियम्।\nउद्विजेत तदैवास्याः सर्पाद्वेश्मगतादिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2027794, "chapter_id": 1596, "verse_number": "३-२३४-१४", "content_sanskrit": "उद्विग्नस्य कुतः शान्तिरशान्तस्य कुतः सुखम्।\nन जातु वशगो भर्ता स्त्रियाः स्यान्मन्त्रकारणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2027795, "chapter_id": 1596, "verse_number": "३-२३४-१५", "content_sanskrit": "किमत्रप्रहिताश्चापि गदाः परमदारुणाः।\nमूलप्रवादैर्हि विषं प्रयच्छन्ति जिघांसवः बब", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2027796, "chapter_id": 1596, "verse_number": "३-२३४-१६", "content_sanskrit": "जिह्वया यानि पुरुषस्त्वचा वाप्युपसेवते।\nतत्र चूर्णानि दत्तानि हन्युः क्षिप्रमसंशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2027797, "chapter_id": 1596, "verse_number": "३-२३४-१७", "content_sanskrit": "जलोदरसमायुक्ताः श्वित्रिणः पलितास्तथा।\nअपुमांसः कृताः स्त्रीभिर्जडान्धवधिरास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2027798, "chapter_id": 1596, "verse_number": "३-२३४-१८", "content_sanskrit": "पापानुगास्तु पापास्ताः पतीनुपसृजन्त्युत।\nन जातु विप्रियं भर्तुः स्त्रिया कार्यं कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2027799, "chapter_id": 1596, "verse_number": "३-२३४-१९", "content_sanskrit": "वर्ताम्यहं तु यां वृत्तिं पाण्डवेषु महात्मसु।\nतां सर्वां शृणु मे सत्यां सत्यभामे यशस्विनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2027800, "chapter_id": 1596, "verse_number": "३-२३४-२०", "content_sanskrit": "अहंकारं विहायाहं कामक्रोधौ च सर्वदा।\nसदारान्पाण्डवान्नित्यं प्रयतोपचराम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2027801, "chapter_id": 1596, "verse_number": "३-२३४-२१", "content_sanskrit": "प्रणयं प्रतिसंहृत्य निधायात्मानमात्मनि।\nशुश्रूषुर्निरभीमाना पतीनां चित्तरक्षिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2027802, "chapter_id": 1596, "verse_number": "३-२३४-२२", "content_sanskrit": "दुर्व्याहृताच्छङ्कमाना दुस्थिताद्दुरवेक्षितात्।\nदुरासिताद्दुर्व्रजितादिङ्गिताध्यासितादपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2027803, "chapter_id": 1596, "verse_number": "३-२३४-२३", "content_sanskrit": "सूर्यवैश्वानरसमान्सोमकल्पान्महारथान्।\nसेवे चक्षुर्हणः पार्थानुग्रवीर्यप्रतापिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2027804, "chapter_id": 1596, "verse_number": "३-२३४-२४", "content_sanskrit": "देवो मनुष्यो गन्धर्वो युवा चापि स्वलंकृतः।\nद्रव्यवानभिरूपो वा न मेऽन्यः पुरुषो मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2027805, "chapter_id": 1596, "verse_number": "३-२३४-२५", "content_sanskrit": "न भुक्तवति न स्नाते नासंविष्टे च भर्तरि।\nन संविशामि नाश्नामि न स्नाये कर्म कुर्वती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2027806, "chapter_id": 1596, "verse_number": "३-२३४-२६", "content_sanskrit": "क्षेत्राद्वनाद्वा ग्रामाद्वा भर्तारं गुहमागतम्।\nअभ्युत्थायाभिनन्दामि आसनेनोदकेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2027807, "chapter_id": 1596, "verse_number": "३-२३४-२७", "content_sanskrit": "प्रसन्नभाण्डा मृष्टान्ना काले भोजनदायिनी।\nसंयता गुप्तधान्या च सुसंमृष्टनिवेशना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2027808, "chapter_id": 1596, "verse_number": "३-२३४-२८", "content_sanskrit": "अतिरस्कृतसंभाषा दुःस्त्रियो नानुसेवती।\nअनुकूलवती नित्यं भवाम्यनलसा सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2027809, "chapter_id": 1596, "verse_number": "३-२३४-२९", "content_sanskrit": "अनर्म चापि हसितं द्वारि स्थानमभीक्ष्णशः।\nअवस्करे चिरस्थानं निष्कुटेषु च वर्जये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2027810, "chapter_id": 1596, "verse_number": "३-२३४-३०", "content_sanskrit": "`अत्यालापमसन्तोषं परव्यापारसंकथाः।\nअतिहासातिरोषौ च क्रोधस्थानं च वर्जये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2027811, "chapter_id": 1596, "verse_number": "३-२३४-३१", "content_sanskrit": "निरताऽहं सदा सत्ये पापानां च विवर्जने।\nसर्वथा भर्तुरहितं न ममेष्टं कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2027812, "chapter_id": 1596, "verse_number": "३-२३४-३२", "content_sanskrit": "यदा प्रवसते भर्ता कुटुम्बार्थेन केनचित्।\nसुमनोवर्णकापेता भवामि व्रतचारिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2027813, "chapter_id": 1596, "verse_number": "३-२३४-३३", "content_sanskrit": "यच्च भर्ता न पिबति यच्च भर्ता न सेवते।\nयच्च नाश्नाति मे भर्ता सर्वं तद्वर्जयाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2027814, "chapter_id": 1596, "verse_number": "३-२३४-३४", "content_sanskrit": "यथोपदेशं नियता वर्तमाना वराङ्गने।\nस्वलंकृता सुप्रयता भर्तुः प्रियहिते रता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2027815, "chapter_id": 1596, "verse_number": "३-२३४-३५", "content_sanskrit": "ये च धर्माः कुटुम्बेषु श्वश्र्वामे कथिताः पुरा।\n`अनुतिष्ठामि तान्सत्ये नित्यकालमतन्द्रिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2027816, "chapter_id": 1596, "verse_number": "३-२३४-३६", "content_sanskrit": "भिक्षाबलिश्राद्धविधिस्थालीपाकाश्च पर्वसु।\nमान्यानां मानसत्कारा ये चान्ये विदिता मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2027817, "chapter_id": 1596, "verse_number": "३-२३४-३७", "content_sanskrit": "तान्सर्वाननुवर्तामि दिवारात्रमतन्द्रिता।\nविनयाननियमांश्चैव सदा सर्वात्मना श्रिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2027818, "chapter_id": 1596, "verse_number": "३-२३४-३८", "content_sanskrit": "मृदून्सतः सत्यशीलान्सत्यधर्मानुपालिनः।\nस देवः सा गतिर्नार्यास्तस्य का विप्रियं चरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2027819, "chapter_id": 1596, "verse_number": "३-२३४-३९", "content_sanskrit": "पत्याश्रयो हि मे धर्मो मतः स्त्रीणां सनातनः।\nस देवः सा गतिर्नार्यास्तस्य काविप्रियं चरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2027820, "chapter_id": 1596, "verse_number": "३-२३४-४०", "content_sanskrit": "अहं पतीन्नातिशये नात्यश्ने नातिभूषये।\nनापि श्वश्रूं परिवदे सर्वदा परियन्त्रिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2027821, "chapter_id": 1596, "verse_number": "३-२३४-४१", "content_sanskrit": "अवधानेन सुभगे नित्योत्थिततयैव च।\nभर्तारो वशगा मह्यं गुरुशुश्रूषयैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2027822, "chapter_id": 1596, "verse_number": "३-२३४-४२", "content_sanskrit": "नित्यमार्यामहं कुन्तीं वीरसूं सत्यवादिनीम्।\nस्वयं परिचराम्यतां पानाच्छादनभोजनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2027823, "chapter_id": 1596, "verse_number": "३-२३४-४३", "content_sanskrit": "नैतामतिशये जातु वस्त्रभूषणभोजनैः।\nन वदे चाप्यतिवाचा तां पृथां पृथिवीसमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2027824, "chapter_id": 1596, "verse_number": "३-२३४-४४", "content_sanskrit": "अष्टावग्रे ब्राह्मणानां सहस्राणि स्म नित्यदा।\nभुञ्जते रुक्मपात्रीषु युधिष्ठिरनिवेशने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2027825, "chapter_id": 1596, "verse_number": "३-२३४-४५", "content_sanskrit": "अष्टाशीतिसहस्राणि स्नातका गृहमेधिनः।\nत्रिंशद्दासीक एकैको यान्विभर्ति युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2027826, "chapter_id": 1596, "verse_number": "३-२३४-४६", "content_sanskrit": "दशान्यानि सहस्राणि येषामन्नं सुसंस्कृतम्।\nह्रियते रुक्मपात्रीभिर्यतीनामूर्ध्वरेतसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2027827, "chapter_id": 1596, "verse_number": "३-२३४-४७", "content_sanskrit": "तान्सर्वानग्रहारेण ब्राह्मणान्वेदवादिनः।\nयथार्हं पूजयामि स्म पानाच्छादनभोजनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2027828, "chapter_id": 1596, "verse_number": "३-२३४-४८", "content_sanskrit": "शतं दासीसहस्राणि कौन्तेयस्य महात्मनः।\nकम्बुकेयूरधारिण्यो निष्ककण्ठ्यः स्वलंकृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2027829, "chapter_id": 1596, "verse_number": "३-२३४-४९", "content_sanskrit": "महार्हमाल्याभरणाः सुवर्णाश्चन्दनोक्षिताः।\nमणीन्हेम च विभ्रत्यो नृत्तगीतविशारदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2027830, "chapter_id": 1596, "verse_number": "३-२३४-५०", "content_sanskrit": "तासां नाम च रूपंच भोजनाच्छादनानि च।\nसर्वासामेव वेदाहं कर्म चैव कृताकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2027831, "chapter_id": 1596, "verse_number": "३-२३४-५१", "content_sanskrit": "शतं दासीसहस्राणि कुन्तीपुत्रस्य धीमतः।\nपात्रीपस्ता दिवारात्रमतिथीन्भोजयन्त्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2027832, "chapter_id": 1596, "verse_number": "३-२३४-५२", "content_sanskrit": "शतमश्वसहस्राणि दशनागायुतानि च।\nयुधिष्ठिरस्यानुयात्रमिन्द्रप्रस्थनिवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2027833, "chapter_id": 1596, "verse_number": "३-२३४-५३", "content_sanskrit": "एतदासीत्तदा राज्ञो यन्महीं पर्यपालयत्।\nयेषां सङ्ख्याविधिं चैव प्रदिशामि शृणोमि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2027834, "chapter_id": 1596, "verse_number": "३-२३४-५४", "content_sanskrit": "अन्तःपूराणां सर्वेषां भृत्यानां चैव सर्वशः।\nआगोपालाविपालेभ्यः सर्वं वेद कृताकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2027835, "chapter_id": 1596, "verse_number": "३-२३४-५५", "content_sanskrit": "सर्वं राज्ञः समुदयमायं च व्ययमेव च।\nएकाऽहंवेद्मि कल्याणि पाण्डवानां यशस्विनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2027836, "chapter_id": 1596, "verse_number": "३-२३४-५६", "content_sanskrit": "मयि सर्वं समासज्यकुटुम्बं भरतर्षभाः।\nउपासनरताः सर्वे घटयन्ति वरानने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2027837, "chapter_id": 1596, "verse_number": "३-२३४-५७", "content_sanskrit": "तमहं भारमासक्तमनाधृष्यं दुरात्मभिः।\nसुखं सर्वंपरित्यज्यरात्र्यहानि घटामि वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2027838, "chapter_id": 1596, "verse_number": "३-२३४-५८", "content_sanskrit": "अधृष्यं वरुणस्येव निधिपूर्णमिवोदधिम्।\nएकाहं वेद्मि कोशं वै पतीनां धर्मचारिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2027839, "chapter_id": 1596, "verse_number": "३-२३४-५९", "content_sanskrit": "अनिशायां निशायां च विहाय क्षुत्पिपासयोः।\nआराधयन्त्याः कौरव्यांस्तुल्या रात्रिरहश्च मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2027840, "chapter_id": 1596, "verse_number": "३-२३४-६०", "content_sanskrit": "प्रथमं प्रतिबुध्यामि चरमं संविशामि च।\nनित्यकालमहं सत्ये एतत्संवननं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2027841, "chapter_id": 1596, "verse_number": "३-२३४-६१", "content_sanskrit": "एतज्जानाम्यहं कर्तुं भर्तृसंवननं महत्।\nअसत्स्त्रीणां समाचारं नाहं कुर्यां न कामये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2027842, "chapter_id": 1596, "verse_number": "३-२३४-६२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2027843, "chapter_id": 1596, "verse_number": "३-२३४-६२", "content_sanskrit": "तच्छ्रुत्वा धर्मसहितं व्याहृतं कृष्णया तदा।\nउवाच सत्या सत्कृत्य पाञ्चालीं धर्मचारिणीं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2027844, "chapter_id": 1596, "verse_number": "३-२३४-६३", "content_sanskrit": "अभिपन्नाऽस्मि पाञ्चालि याज्ञसेनि क्षमस्व मे।\nकामकारः सखीनं हि सोपहासं प्रभाषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2027845, "chapter_id": 1596, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि द्रौपदीसत्यभामासंवादपर्वणि चतुस्त्रिंशदधिकद्विशततमोऽध्यायः ॥ २३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]