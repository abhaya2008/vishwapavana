[{"id": 2032185, "chapter_id": 1698, "verse_number": "४-२१-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2032186, "chapter_id": 1698, "verse_number": "४-२१-१", "content_sanskrit": "अहो दुःखतरं प्राप्ता कीचकेन पदा हता।\nपतिव्रता महाभागा द्रौपदी योषितांवरा ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2032187, "chapter_id": 1698, "verse_number": "४-२१-२", "content_sanskrit": "दुःशलां स्मारयन्ती सा भर्तॄणां भगिनीं शुभाम्।\nनाशपत्सिन्धुराजं सा बलात्कारेण वाहिता ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2032188, "chapter_id": 1698, "verse_number": "४-२१-३", "content_sanskrit": "किमर्थमिह संप्राप्ता कीचकेन दुरात्मना ।\nनाशपत्तं महाभागा कृष्णा पादेन ताडिता ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2032189, "chapter_id": 1698, "verse_number": "४-२१-४", "content_sanskrit": "तेजोराशिरियं देवी धर्मज्ञा सत्यवादिनी ।\nकेशपांशे परामृष्टा मर्षयन्ती ह्यशक्तवत् ॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2032190, "chapter_id": 1698, "verse_number": "४-२१-५", "content_sanskrit": "नैतत्कारणमल्पं हि श्रोतुकामोऽस्मि सत्तम।\nकृष्णायास्तु परिक्लेशान्मनो मे दूयते भृशम् ॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2032191, "chapter_id": 1698, "verse_number": "४-२१-६", "content_sanskrit": "कस्य वंशे समुद्भूतः स च दुर्ललितो मुने ।\nबलोन्मत्तः कथं चासीत्स्यालो मात्स्यस्य कीचकः ॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2032192, "chapter_id": 1698, "verse_number": "४-२१-७", "content_sanskrit": "दृष्ट्वापि तां प्रियां भार्यां सूतपुत्रेण ताडिताम् ।\nनैव चुक्षुभिरे वीराः किमकुर्वन्त तं प्रति ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2032193, "chapter_id": 1698, "verse_number": "४-२१-८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2032194, "chapter_id": 1698, "verse_number": "४-२१-८", "content_sanskrit": "त्वदुक्तोऽयमनुप्रश्नः कुरूणां कीर्तिवर्धनः।\nएतत्सर्वं यथा वक्ष्ये विस्तरेणेह पार्थिव ॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2032195, "chapter_id": 1698, "verse_number": "४-२१-९", "content_sanskrit": "ब्राह्मण्यां क्षत्रियाञ्जातः सूतो भवति पार्थिव ।\nप्रातिलोम्येन जातानां स ह्येको द्विज एव तु ॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2032196, "chapter_id": 1698, "verse_number": "४-२१-१०", "content_sanskrit": "रथकारमितीमं हि क्रियायुक्तं द्विजन्मनाम्।\nक्षत्रियादवरो वैश्याद्विशिष्ट इति चक्षते ॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2032197, "chapter_id": 1698, "verse_number": "४-२१-११", "content_sanskrit": "सह सूतेन संबन्धः कृतः पूर्वं नराधिपैः।\nतेन तु प्रातिलोम्येन राजशब्दो न लभ्यते ॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2032198, "chapter_id": 1698, "verse_number": "४-२१-१२", "content_sanskrit": "तेषां तु सूतविषयः सूतानां नामतः कृतः।\nउपजीव्यं च यत्क्षेत्रं राजन्सूतेन वै पुरा ॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2032199, "chapter_id": 1698, "verse_number": "४-२१-१३", "content_sanskrit": "सूतानामधिपो राजा केकयो नाम विश्रुतः।\nराजकन्यासमुद्भूतः सारथ्येऽनुपमोऽभवत् ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2032200, "chapter_id": 1698, "verse_number": "४-२१-१४", "content_sanskrit": "पुत्रास्तस्य कुरुश्रेष्ठ मालव्यां जझिरे तदा।\nकीचका इति विख्याताः शतं षट् चैव भारत ॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2032201, "chapter_id": 1698, "verse_number": "४-२१-१५", "content_sanskrit": "तेषामासीद्बलश्रेष्ठः कीचकः सर्वजित्प्रभो।\nअग्रजो बलसंमत्तस्तेनासीत्सूतषट्शतम् ॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2032202, "chapter_id": 1698, "verse_number": "४-२१-१६", "content_sanskrit": "मालव्या एव कौरव्य तत्र ह्यवरजाऽभवत्।\nतस्यां केकयराज्ञस्तु सुदेष्णा दुहिताऽभवत् ॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2032203, "chapter_id": 1698, "verse_number": "४-२१-१७", "content_sanskrit": "तां विराटस्य मात्स्यस्य केकयः प्रददौ मुदा।\nसुरथायां मृतायां तु कौसल्यां श्वेतमातरि ॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2032204, "chapter_id": 1698, "verse_number": "४-२१-१८", "content_sanskrit": "श्वेते विनष्टे शङ्खे च गते मातुलवेश्मनि ।\nसुदेष्णां महिषीं लब्ध्वा राज दुःखमपानुदत् ॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2032205, "chapter_id": 1698, "verse_number": "४-२१-१९", "content_sanskrit": "उत्तरं चोत्तरां चैव विराटात्पृथिवीपते।\nसुदेष्णा सुषुवे देवी कैकेयी कुलवृद्धये ॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2032206, "chapter_id": 1698, "verse_number": "४-२१-२०", "content_sanskrit": "मातृष्वसृसुतां राजन्कीचकस्तामनिन्दिताम्।\nसदा परिचरन्प्रीत्या विराटे न्यवसत्सुखी ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2032207, "chapter_id": 1698, "verse_number": "४-२१-२१", "content_sanskrit": "भ्रातरश्चास्य विक्रान्ताः सर्वे च तमनुव्रताः ।\nविराटस्यैव संहृष्टा बलं कोशं त्ववर्धयन् ॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2032208, "chapter_id": 1698, "verse_number": "४-२१-२२", "content_sanskrit": "कालेया नाम ते दैत्याः प्रायशो भुवि विश्रुताः।\nजझिरे कीचका राजन्बाणो ज्येष्ठस्तथाऽभवत् ॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2032209, "chapter_id": 1698, "verse_number": "४-२१-२३", "content_sanskrit": "स हि सर्वास्रसंपन्नो बलवान्भीमविक्रमः ।\nकीचको नष्टमर्यादो बभूव भयदो नृणाम् ॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2032210, "chapter_id": 1698, "verse_number": "४-२१-२४", "content_sanskrit": "तं प्राप्य बलसंमत्तं विराटः पृथिवीपतिः ।\nजिगाय सर्वांश्च रिपून्यथेन्द्रो दानवान्पुरा ॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2032211, "chapter_id": 1698, "verse_number": "४-२१-२५", "content_sanskrit": "मेखलांश्च त्रिगर्तांश्च दशार्णांश्च कशेरुकान्।\nमालवांश्चैव यवनान्सिलिन्दान्काशिकोसलान् ॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2032212, "chapter_id": 1698, "verse_number": "४-२१-२६", "content_sanskrit": "करदांश्च निषिद्धांश्च शिवान्मचुलकांस्तथा।\nपुलिन्दांश्च कलिङ्गांश्च तङ्कणान्परतङ्कणान् ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2032213, "chapter_id": 1698, "verse_number": "४-२१-२७", "content_sanskrit": "अन्ये च बहवः शूरा नानाजनपदेश्वराः।\nकीचकेन रणे भग्ना विद्रवन्ति दिशो दश ॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2032214, "chapter_id": 1698, "verse_number": "४-२१-२८", "content_sanskrit": "तमेवंवीर्यसंपन्नं नागायुतसमं बले।\nविराटस्तत्र सेनायाश्चकार पतिमात्मनः ॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2032215, "chapter_id": 1698, "verse_number": "४-२१-२९", "content_sanskrit": "विराटभ्रातरश्चैव दश दाशरथेः समाः।\nते चैनानन्ववर्तन्त कीचकान्बलवत्तरान् ॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2032216, "chapter_id": 1698, "verse_number": "४-२१-३०", "content_sanskrit": "एवंविधबलो भीमः कीचकस्ते च तद्विधाः।\nराज्ञः स्याला महात्मानो विराटस्य हितैषिणः ॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2032217, "chapter_id": 1698, "verse_number": "४-२१-३१", "content_sanskrit": "एतत्ते कथितं सर्वं कीचकस्य पराक्रमम्।\nद्रौपदी न शशापैनं यस्मात्तद्गदतः शृणु ॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2032218, "chapter_id": 1698, "verse_number": "४-२१-३२", "content_sanskrit": "रक्षन्ति हि तपः क्रोधादृषयो न शपन्ति च।\nजानन्ती तद्यथातत्त्वं द्रौपदी न शशाप तम् ॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2032219, "chapter_id": 1698, "verse_number": "४-२१-३३", "content_sanskrit": "क्षमा धर्मः क्षमा दानं क्षमा यज्ञः क्षमा तपः।\nक्षमा सत्यं क्षमा शीलं क्षमा सर्वमिति श्रुतिः ॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2032220, "chapter_id": 1698, "verse_number": "४-२१-३४", "content_sanskrit": "क्षमावतामयं लोकः परश्चैव क्षमावताम्।\nएतत्सर्वं विजानन्ती सा क्षमामन्वपद्यत ॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2032221, "chapter_id": 1698, "verse_number": "४-२१-३५", "content_sanskrit": "भर्तॄणां मतमाज्ञाय क्षमिणां धर्मचारिणाम्।\nनाशपत्तं विशालाक्षी सती शक्ताऽपि भारत ॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2032222, "chapter_id": 1698, "verse_number": "४-२१-३६", "content_sanskrit": "पाण्डवाश्चापि ते सर्वे द्रौपदीं प्रेक्ष्य दुःखिताम्।\nक्रोधाग्निनाऽप्यदह्यन्त तदा लञ्जाव्यपेक्षया ॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2032223, "chapter_id": 1698, "verse_number": "४-२१-३७", "content_sanskrit": "अथ भीमो महाबाहुः मूदयिष्यंस्तु कीचकम्।\nवारितो धर्मपुत्रेण वेलयेव महोदधिः ॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2032224, "chapter_id": 1698, "verse_number": "४-२१-३८", "content_sanskrit": "संधार्य मनसा रोषं दिवारात्रं विनिश्वसन्।\nमहानसे तदा कृच्छ्रात्सुष्वाप रजनीं च ताम् ॥ ३८ ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2032225, "chapter_id": 1698, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि कीचकवधपर्वणि एकविंशोऽध्यायः ॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]