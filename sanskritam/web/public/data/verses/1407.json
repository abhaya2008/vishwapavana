[{"id": 2019583, "chapter_id": 1407, "verse_number": "३-४५-०x", "content_sanskrit": "`वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2019584, "chapter_id": 1407, "verse_number": "३-४५-१", "content_sanskrit": "ततो देवाः सगन्धर्वाः समादायार्घ्यमुत्तमम्।\nशक्रस्य मतमाज्ञाय पार्थमानर्चुर्जसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2019585, "chapter_id": 1407, "verse_number": "३-४५-२", "content_sanskrit": "पाद्यमाचमनीयं च प्रतिग्राह्य नृपात्मजम्।\nप्रवेशयामासुरथो पुरन्दरनिवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2019586, "chapter_id": 1407, "verse_number": "३-४५-३", "content_sanskrit": "एवं संपूजितो जिष्णुरुवास भवने पितुः।\nउपशिक्षन्महास्त्राणि ससंहाराणि पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2019587, "chapter_id": 1407, "verse_number": "३-४५-४", "content_sanskrit": "स शक्रहस्ताद्दयितं वज्रमस्त्रं दुरुत्सहम्।\nअशनिं च महानादां मेघबृंहितलक्षणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2019588, "chapter_id": 1407, "verse_number": "३-४५-५", "content_sanskrit": "गृहीतास्त्रस्तु कौन्तेयो भ्रातॄन्सस्मार पाण्डवः।\nपुरन्दरनियोगाच्च पञ्चाब्दमवसत्सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2019589, "chapter_id": 1407, "verse_number": "३-४५-६", "content_sanskrit": "ततः शक्रोऽब्रवीत्पार्थं कृतास्त्रं काल आगते।\nनृत्तं गीतं च कौन्तेय चित्रसेनादवाप्नुहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2019590, "chapter_id": 1407, "verse_number": "३-४५-७", "content_sanskrit": "वादित्रं दैवविहितं नृलके यन्न विद्ते।\nमदाज्ञया च कौन्तेय श्रेयो वै ते भविष्ति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2019591, "chapter_id": 1407, "verse_number": "३-४५-८", "content_sanskrit": "सखायं प्रददौ चास्य चित्रसेनं पुरन्दरः।\nस तेन सह संगम्य रेमे पार्थो निरामयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2019592, "chapter_id": 1407, "verse_number": "३-४५-९", "content_sanskrit": "कदाचिदटमानस्तु महर्षिरथ लोमशः।\nजगाम शक्रभवनं पुरंदरदिदृक्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2019593, "chapter_id": 1407, "verse_number": "३-४५-१०", "content_sanskrit": "स समेत्य नमस्कृत्य देवराजं महामुनिः।\nददर्शार्धासनगतं पाण्डवं वासवस्य हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2019594, "chapter_id": 1407, "verse_number": "३-४५-११", "content_sanskrit": "ततः शक्राभ्यनुज्ञात आसने विष्टरोत्तरे।\nनिषसाद द्विजश्रेष्ठः पूज्यमानो महर्षिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2019595, "chapter_id": 1407, "verse_number": "३-४५-१२", "content_sanskrit": "तस्य दृष्ट्वाऽभवद्बुद्धिः पार्थमिन्द्रासने स्थितम्।\nकथं नु क्षत्रियः पार्थः शक्रासनमवाप्तवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2019596, "chapter_id": 1407, "verse_number": "३-४५-१३", "content_sanskrit": "किं त्वस्य सुकृतं कर्म के लोका वै विनिर्जिताः।\nस एवमनुसंप्राप्तः स्थानं देवनमस्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2019597, "chapter_id": 1407, "verse_number": "३-४५-१४", "content_sanskrit": "तस्य विज्ञाय संकल्पं शक्रो वृत्रविमर्दनः।\nलोमशं प्रहसन्वाक्यमिदमाह शचीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2019598, "chapter_id": 1407, "verse_number": "३-४५-१५", "content_sanskrit": "देवर्षे श्रूयतां यत्ते मनसैतद्विवक्षितम्।\nनायं केवलमर्त्योऽभूत्क्षत्रियत्वमुपागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2019599, "chapter_id": 1407, "verse_number": "३-४५-१६", "content_sanskrit": "महर्षे मम पुत्रोऽयं कुन्त्यां जातो महाभुजः।\nअस्त्रहेतोरिह प्राप्तः कस्माच्चित्कारणान्तरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2019600, "chapter_id": 1407, "verse_number": "३-४५-१७", "content_sanskrit": "अहो नैनं भवान्वेत्ति पुराणमृषिसत्तमम्।\nशृणु मे वदतो ब्रह्मन्योऽयं यच्चास्य कारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2019601, "chapter_id": 1407, "verse_number": "३-४५-१८", "content_sanskrit": "नरनारायणौ यौ तौ पुराणावृषिसत्तमौ।\nताविमावभिजानीहि हृषीकेशधनंजयौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2019602, "chapter_id": 1407, "verse_number": "३-४५-१९", "content_sanskrit": "विख्यातौ त्रिषु लोकेषु नरनारायणावृषी।\nकार्यार्थमवतीर्णौ तौ पृथ्वीं पुण्यप्रतिश्रयाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2019603, "chapter_id": 1407, "verse_number": "३-४५-२०", "content_sanskrit": "यन्न शक्यं शुरैर्द्रष्टुमृषिभिर्वा महात्मभिः।\nतदाश्रमपदं पुण्यं बदरीनाम विश्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2019604, "chapter_id": 1407, "verse_number": "३-४५-२१", "content_sanskrit": "स निवासोऽभवद्विप्र विष्णोर्जिष्णोस्तथैव च।\nयतः प्रववृते गङ्गा सिद्धचारणसेविता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2019605, "chapter_id": 1407, "verse_number": "३-४५-२२", "content_sanskrit": "तौ मन्नियोगाद्ब्रह्मर्षे क्षितौ जातौ महाद्युती।\nभूमेर्भारावतरणं महावीर्यौ करिष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2019606, "chapter_id": 1407, "verse_number": "३-४५-२३", "content_sanskrit": "उद्वृत्ता ह्यसुराः केचिन्निवातकवचा इति।\nविप्रियेषु स्थिताऽस्माकं वरदानेन मोहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2019607, "chapter_id": 1407, "verse_number": "३-४५-२४", "content_sanskrit": "तर्कयन्ते सुरान्हन्तुं बलदर्पसमन्विताः।\nदेवान्न गणयन्त्येते तथा दत्तवरा हि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2019608, "chapter_id": 1407, "verse_number": "३-४५-२५", "content_sanskrit": "पातालवासिनो रौद्रा दनोः पुत्रा महाबलाः।\nसर्वे देवनिकाया हि नालं योधयितुं हि तान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2019609, "chapter_id": 1407, "verse_number": "३-४५-२६", "content_sanskrit": "योसौ भूमिगतः श्रीमान्विष्णुर्मुधुनिषूदनः।\nकपिलो नाम देवोसौ भगवानजितो हरिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2019610, "chapter_id": 1407, "verse_number": "३-४५-२७", "content_sanskrit": "येन पूर्वंमहात्मानः खनमाना रसातलम्।\nदर्शनादेव निहताः सगरस्यात्मजा विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2019611, "chapter_id": 1407, "verse_number": "३-४५-२८", "content_sanskrit": "तेन कार्यं महत्कार्यमस्माकं द्विजसत्तम।\nपाथेन च महायुद्धे समेताभ्यामसंशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2019612, "chapter_id": 1407, "verse_number": "३-४५-२९", "content_sanskrit": "सोऽसुरान्दर्शनादेव शक्तो हन्तुं सहानुगान्।\nनिवातकवचान्सर्वान्नागानिव महाह्रदे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2019613, "chapter_id": 1407, "verse_number": "३-४५-३०", "content_sanskrit": "किंतु नाल्पेन कार्येण प्रबोध्यो मधुसूदनः।\nतेजसः सुमहाराशिः प्रबुद्धः प्रदहेज्जगत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2019614, "chapter_id": 1407, "verse_number": "३-४५-३१", "content_sanskrit": "अयं तेषां समस्तानां शक्तः प्रतिसमासने।\nतान्निहत्यरणे शूरः पुनर्यास्यति मानुषान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2019615, "chapter_id": 1407, "verse_number": "३-४५-३२", "content_sanskrit": "भवानस्मन्नियोगेन यातु तावन्महीतलम्।\nकाम्यके द्रक्ष्यसे वीरं निवसन्तं युधिष्ठिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2019616, "chapter_id": 1407, "verse_number": "३-४५-३३", "content_sanskrit": "सवाच्यो मम संदेशाद्धर्मात्मा सत्यसंगरः।\nनोत्कणअठा फल्गुने कार्या कृतास्त्रः शीघ्रमेष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2019617, "chapter_id": 1407, "verse_number": "३-४५-३४", "content_sanskrit": "नाशुद्बाहुवीर्येण नाकृतास्त्रेण वा रणे।\nभीष्मद्रोणादयो युद्धे शक्याः प्रतिसमासितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2019618, "chapter_id": 1407, "verse_number": "३-४५-३५", "content_sanskrit": "गृहीतास्त्रो गुडाकेशो महाबाहुर्महामनाः।\nनृत्तवादित्रगीतानां दिव्यानां पारमीयिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2019619, "chapter_id": 1407, "verse_number": "३-४५-३६", "content_sanskrit": "भवानपि विविक्तानि तीर्थानि मनुजेश्वर।\nभ्रातृभिः सहितः सर्वैर्द्रष्टुमर्हत्यरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2019620, "chapter_id": 1407, "verse_number": "३-४५-३७", "content_sanskrit": "तीर्थेष्वाप्लुत्य पुण्येषु विपाप्मा विगतज्वरः।\nराज्यं भोक्ष्यसि धर्मेण सुखी विगतकल्मपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2019621, "chapter_id": 1407, "verse_number": "३-४५-३८", "content_sanskrit": "भवांश्चैनं द्विजश्रेष्ठ पर्यटन्तं महीतलम्।\nत्रातुमर्हति विप्राग्र्य तपोबलसमन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2019622, "chapter_id": 1407, "verse_number": "३-४५-३९", "content_sanskrit": "गिरिदुर्गेषु च सदा देशेषु विषमेषु च।\nवसन्ति रासा रौद्रास्तेभ्योरक्षां विधास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2019623, "chapter_id": 1407, "verse_number": "३-४५-४०", "content_sanskrit": "एवमुक्ते महेन्द्रेण बीभत्सुरपि लोमशम्।\nउवाच प्रयतो वाक्यं रक्षेथाः पाण्डुनन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2019624, "chapter_id": 1407, "verse_number": "३-४५-४१", "content_sanskrit": "[यथा गुप्तस्त्वया राजा चरेत्तीर्थानि सत्तम।\nदानं दद्याद्यथा चैव तथा कुरु महामुने ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2019625, "chapter_id": 1407, "verse_number": "३-४४-४२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2019626, "chapter_id": 1407, "verse_number": "३-४५-४२", "content_sanskrit": "तथेति संप्रतिज्ञाय लोमशः सुमहातपाः।\nकामय्कं वनमुद्दिश्य समुपायान्महीतलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2019627, "chapter_id": 1407, "verse_number": "३-४५-४३", "content_sanskrit": "ददर्श तत्र कौन्तेयं धर्मराजमरिंदमम्।\nतापसैर्भ्रातृभिश्चैव सर्वतः परिवारितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2019628, "chapter_id": 1407, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि इन्द्रलोकाभिगमनपर्वणि पञ्चचत्वारिंशोऽध्यायः ॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]