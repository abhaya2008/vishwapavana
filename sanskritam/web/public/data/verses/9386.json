[{"id": 40022228, "chapter_id": 9386, "verse_number": "1", "content_sanskrit": "अथ रात्र्यां प्रवृत्तायां शत्रुघ्नो भृगुनन्दनम् । पप्रच्छ च्यवनं विप्रं लवणस्य यथा बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40022229, "chapter_id": 9386, "verse_number": "2", "content_sanskrit": "शूलस्य च बलं ब्रह्मन्के च पूर्वं विनाशिताः । अनेन शूलमुख्येन द्वन्द्वयुद्धमुपागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40022230, "chapter_id": 9386, "verse_number": "3", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा शत्रुघ्नस्य महात्मनः । प्रत्युवाच महातेजाश्च्यवनो रघुनन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40022231, "chapter_id": 9386, "verse_number": "4", "content_sanskrit": "असङ्ख्येयानि कर्माणि यान्यस्य रघुनन्दन । इक्ष्वाकुवंशप्रभवे यद्वृत्तं तच्छृणष्व मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40022232, "chapter_id": 9386, "verse_number": "5", "content_sanskrit": "अयोध्यायां पुरा राजा युवनाश्वसुतो बली । मान्धातेति स विख्यातस्त्रिषु लोकेषु वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40022233, "chapter_id": 9386, "verse_number": "6", "content_sanskrit": "स कृत्वा पृथिवीं कृत्स्नां शासने पृथिवीपतिः । सुरलोकमितो जेतुमुद्योगमकरोन्नृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40022234, "chapter_id": 9386, "verse_number": "7", "content_sanskrit": "इन्द्रस्य च भयं तीव्रं सुराणां च महात्मनाम् । मान्धातरि कृतोद्योगे देवलोकजिगीषया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40022235, "chapter_id": 9386, "verse_number": "8", "content_sanskrit": "अर्धासनेन शक्रस्य राज्यार्धेन च पार्थिवः । वन्द्यमानः सुरगणैः प्रतिज्ञामध्यरोहत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40022236, "chapter_id": 9386, "verse_number": "9", "content_sanskrit": "तस्य पापमभिप्रायं विदित्वा पाकशासनः । सान्त्वपूर्वमिदं वाक्यमुवाच युवनाश्वजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40022237, "chapter_id": 9386, "verse_number": "10", "content_sanskrit": "राजा त्वं मानुषे लोके न तावत्पुरुषर्षभ । अकृत्वा पृथिवीं वश्यां देवराज्यमिहेच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40022238, "chapter_id": 9386, "verse_number": "11", "content_sanskrit": "यदि वीर समग्रा ते मेदिनी निखिला वशे । देवराज्यं कुरुष्वेह सभृत्यबलवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40022239, "chapter_id": 9386, "verse_number": "12", "content_sanskrit": "इन्द्रमेवं ब्रुवाणं तं मान्धाता वाक्यमब्रवीत् । क्व मे शक्र प्रतिहतं शासनं पृथिवीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40022240, "chapter_id": 9386, "verse_number": "13", "content_sanskrit": "तमुवाच सहस्राक्षो लवणो नाम राक्षसः । मधुपुत्रो मधुवने न ते ऽ ऽज्ञां कुरुते ऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40022241, "chapter_id": 9386, "verse_number": "14", "content_sanskrit": "तच्छ्रुत्वा विप्रियं घोरं सहस्राक्षेण भाषितम् । व्रीडितो ऽवाङ्मुखो राजा व्याहर्तुं न शशाक ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40022242, "chapter_id": 9386, "verse_number": "15", "content_sanskrit": "आमन्त्र्य तु सहस्राक्षं ह्रिया किञ्चिदवाङ्मुखः । पुनरेवागमच्छ्रीमानिमं लोकं नरेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40022243, "chapter_id": 9386, "verse_number": "16", "content_sanskrit": "स कृत्वा हृदये ऽमर्षं सभृत्यबलवाहनः । आजगाम मधोः पुत्रं वशे कर्तुमरिन्दमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40022244, "chapter_id": 9386, "verse_number": "17", "content_sanskrit": "स काङ्क्षमाणो लवणं युद्धाय पुरुषर्षभः । दूतं सम्प्रेषयामास सकाशं लवणस्य हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40022245, "chapter_id": 9386, "verse_number": "18", "content_sanskrit": "स गत्वा विप्रियाण्याह बहूनि मधुनः सुतम् । वदन्तमेवं तं दूतं भक्षयामास राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40022246, "chapter_id": 9386, "verse_number": "19", "content_sanskrit": "चिरायमाणे दूते तु राजा क्रोधसमन्वितः । अर्दयामास तद्रक्षः शरवृष्ट्या समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40022247, "chapter_id": 9386, "verse_number": "20", "content_sanskrit": "ततः प्रहस्य तद्रक्षः शूलं जग्राह पाणिना । वधाय सानुबन्धस्य मुमोचायुधमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40022248, "chapter_id": 9386, "verse_number": "21", "content_sanskrit": "तच्छूलं दीप्यमानं तु सभृत्यबलवाहनम् । भस्मीकृत्वा नृपं भूयो लवणस्यागमत्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40022249, "chapter_id": 9386, "verse_number": "22", "content_sanskrit": "एवं स राजा सुमहान्हतः सबलवाहनः । शूलस्य तु बलं सौम्य अप्रमेयमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40022250, "chapter_id": 9386, "verse_number": "23", "content_sanskrit": "श्वः प्रभाते तु लवणं वधिष्यसि न संशयः । अगृहीतायुधं क्षिप्रं ध्रुवो हि विजयस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40022251, "chapter_id": 9386, "verse_number": "24", "content_sanskrit": "लोकानां स्वस्ति चैव स्यात्कृते कर्मणि च त्वया । एतत्ते सर्वमाख्यातं लवणस्य दुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40022252, "chapter_id": 9386, "verse_number": "25", "content_sanskrit": "शूलस्य च बलं घोरमप्रमेयं नरर्षभ । विनाशश्चैव मान्धातुर्यत्तेनाभूच्च पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40022253, "chapter_id": 9386, "verse_number": "26", "content_sanskrit": "त्वं श्वः प्रभाते लवणं महात्मन्वधिष्यसे नात्र तु संशयो मे । शूलं विना निर्गतमामिषार्थे ध्रुवो जयस्ते भविता नरेन्द्र ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]