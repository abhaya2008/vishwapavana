[{"id": 2044198, "chapter_id": 1993, "verse_number": "६-४२-०x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2044199, "chapter_id": 1993, "verse_number": "६-४२-१", "content_sanskrit": "संन्यासत्य महाबाहो तत्त्वमिच्छामि वेदितुम् ।\nत्यागस्य च हृषीकेश पृथक्केशिनिपूदन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2044200, "chapter_id": 1993, "verse_number": "६-४२-२x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2044201, "chapter_id": 1993, "verse_number": "६-४२-२", "content_sanskrit": "काम्यानां कर्मणां न्यासं संन्यासं कवयो विदुः।\nसर्वकर्मफलत्यागं प्राहुस्त्यागं विचक्षणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2044202, "chapter_id": 1993, "verse_number": "६-४२-३", "content_sanskrit": "त्याज्यं दोषवदित्येके कर्म प्राहुर्मनीषिणः ।\nयज्ञदानतपःकर्म न त्याज्यमिति चापरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2044203, "chapter_id": 1993, "verse_number": "६-४२-४", "content_sanskrit": "निश्चयं श्रृणु मे तत्र त्यागे भरतसत्तम।\nत्यागो हि पुरुषव्याघ्र त्रिविधः संप्रकीर्तितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2044204, "chapter_id": 1993, "verse_number": "६-४२-५", "content_sanskrit": "यज्ञदानतपःकर्म न त्याज्यं कार्यमेव तत्।\nयज्ञो दानं तपश्चैव पावनानि मनीषिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2044205, "chapter_id": 1993, "verse_number": "६-४२-६", "content_sanskrit": "एतान्यपि तु कर्माणि सङ्गं त्यक्त्वा फलानि च ।\nकर्तव्यानीति मे पार्थ निश्चितं मतमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2044206, "chapter_id": 1993, "verse_number": "६-४२-७", "content_sanskrit": "नियतस्य तु संन्यासः कर्मणो नोपपद्यते ।\nमोहात्तस्य परित्यागस्तामसः परिकीर्तितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2044207, "chapter_id": 1993, "verse_number": "६-४२-८", "content_sanskrit": "दुःखमित्येव यत्कर्म कायक्लेशभयात्त्यजेत् ।\nस कृत्वा राजसं त्यागं नैव त्यागफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2044208, "chapter_id": 1993, "verse_number": "६-४२-९", "content_sanskrit": "कार्यमित्येव यत्कर्म नियतं क्रियतेऽर्जुन ।\nसङ्गं त्यक्त्वा फलं चैव स त्यागः सात्विको मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2044209, "chapter_id": 1993, "verse_number": "६-४२-१०", "content_sanskrit": "न द्वेष्ट्यकुशलं कर्म कुशले नानुषज्जते ।\nत्यागी सत्त्वसमाविष्टो मेधावी छिन्नसंशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2044210, "chapter_id": 1993, "verse_number": "६-४२-११", "content_sanskrit": "न हि देहभृता शक्यं त्यक्तुं कर्माण्यशेषतः ।\nयस्तु कर्मफलत्यागी स त्यागीत्यभिधीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2044211, "chapter_id": 1993, "verse_number": "६-४२-१२", "content_sanskrit": "अनिष्टमिष्टं मिश्रं च त्रिविधं कर्मणः फलम् ।\nभवत्यत्यागिनीं प्रेत्य न तु संन्यासिनां क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2044212, "chapter_id": 1993, "verse_number": "६-४२-१३", "content_sanskrit": "पञ्चैतानि महाबाहो कारणानि निबोध मे।\nसाङ्ख्ये कृतान्ते प्रोक्तानि सिद्धये सर्वकर्मणां ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2044213, "chapter_id": 1993, "verse_number": "६-४२-१४", "content_sanskrit": "अधिष्ठानं तथा कर्ता करणं च पृथग्विधम्।\nविविधाश्च पृथक्केष्टा दैवं चैवात्र पञ्चमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2044214, "chapter_id": 1993, "verse_number": "६-४२-१५", "content_sanskrit": "शरीरवाङ्भनोभिर्यत्कर्म प्रारभते नरः।\nन्याय्यं वा विपरीतं वा पञ्चैते तस्य हेतवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2044215, "chapter_id": 1993, "verse_number": "६-४२-१६", "content_sanskrit": "तत्रैवं सति कर्तारमात्मानं केवलं तु यः ।\nपश्यत्यकृतबुद्धित्वान्न स पश्यति दुर्मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2044216, "chapter_id": 1993, "verse_number": "६-४२-१७", "content_sanskrit": "यस्य नाहंकृतो भवो बुद्धिर्यस्य न लिप्यते ।\nहत्वाऽपि स इमाँल्लोकान्न हन्ति न निबध्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2044217, "chapter_id": 1993, "verse_number": "६-४२-१८", "content_sanskrit": "ज्ञानं ज्ञेयं परिज्ञाता त्रिविधा कर्मचोदना ।\nकरणं कर्म कर्तेति त्रिविधः कर्मसंग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2044218, "chapter_id": 1993, "verse_number": "६-४२-१९", "content_sanskrit": "ज्ञानं कर्म च कर्ता च त्रिधैव गुणभेदतः ।\nप्रोच्यते गुणसंख्याने यथावच्छृणु तान्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2044219, "chapter_id": 1993, "verse_number": "६-४२-२०", "content_sanskrit": "सर्वभूतेषु येनैकं भावमव्ययमीक्षते ।\nअविभक्तं विभक्तेषु तज्ज्ञानं विद्धि सात्विकं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2044220, "chapter_id": 1993, "verse_number": "६-४२-२१", "content_sanskrit": "पृथक्त्वेन तु यज्ज्ञानं नानाभावान्पृथग्विधान् ।\nवेत्ति सर्वेषु भूतेषु तज्ज्ञानं विद्धि राजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2044221, "chapter_id": 1993, "verse_number": "६-४२-२२", "content_sanskrit": "यत्तु कृत्स्नवदेकस्मिन्कार्ये सक्तमहैतुकम् ।\nअतत्त्वार्थवदल्पं च तत्तासममुदाहृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2044222, "chapter_id": 1993, "verse_number": "६-४२-२३", "content_sanskrit": "नियतं सङ्गरहितमरागद्वेषतः कृतम् ।\nअफलप्रेप्सुना कर्म यत्तत्सात्विकमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2044223, "chapter_id": 1993, "verse_number": "६-४२-२४", "content_sanskrit": "यत्तु कामेप्सुना कर्म ताहङ्कारेण वा पुनः।\nक्रियते बहुलायासं तद्राजसमुदाहृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2044224, "chapter_id": 1993, "verse_number": "६-४२-२५", "content_sanskrit": "अनुबन्धं क्षयं हिंसामनपेक्ष्य च पौरुषम् ।\nमोहादारभ्यते कर्म यत्तत्तामसमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2044225, "chapter_id": 1993, "verse_number": "६-४२-२६", "content_sanskrit": "मुक्तसङ्गोनहंवादी धृत्युत्साहसमन्वितः । ६-४२-२६bसिद्ध्यसिद्ध्योर्निर्विकारः कर्ता सात्विक उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2044226, "chapter_id": 1993, "verse_number": "६-४२-२७", "content_sanskrit": "रागी कर्मफलप्रेप्सुर्लुब्धो हिंसात्मकोऽशुचिः ।\nहर्षशोकान्वितः कर्ता राजसः परिकीर्तितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2044227, "chapter_id": 1993, "verse_number": "६-४२-२८", "content_sanskrit": "अयुक्तः प्राकृतः स्तब्धः शठो नैकृतिकोऽलसः ।\nविषादी दीर्घसूत्री च कर्ता तामस उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2044228, "chapter_id": 1993, "verse_number": "६-४२-२९", "content_sanskrit": "बुद्धेर्भेदं धृतेश्चैव गुणतस्त्रिविधं श्रृणु ।\nप्रोच्यमानमशेषेण पृथक्त्वेन धनंजय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2044229, "chapter_id": 1993, "verse_number": "६-४२-३०", "content_sanskrit": "प्रवृत्तिं च निवृत्तिं च कार्याकार्ये भयाभये ।\nबन्धं मोक्षं च या वेत्ति बुद्धिः सा पार्थ सात्विकी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2044230, "chapter_id": 1993, "verse_number": "६-४२-३१", "content_sanskrit": "यया धर्ममधर्मं च कार्यं चाकार्यमेव च ।\nअयथावत्प्रजानाति बुद्धिः सा पार्थ राजसी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2044231, "chapter_id": 1993, "verse_number": "६-४२-३२", "content_sanskrit": "अधर्मं धर्ममिति या मन्यते तमसाऽऽवृता।\nसर्वार्थान्विपरीतांश्च बुद्धिः सा पार्थ तामसी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2044232, "chapter_id": 1993, "verse_number": "६-४२-३३", "content_sanskrit": "धृत्या यया धारयते मनःप्रणेन्द्रियक्रियाः ।\nयोगेनाव्यभिचारिण्या धृतिः सा पार्थ सात्विकी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2044233, "chapter_id": 1993, "verse_number": "६-४२-३४", "content_sanskrit": "यया तु धर्मकामार्धान्धृत्या धारयतेऽर्जुन ।\nप्रसङ्गेन फलाकाङ्क्षी धृतिः सा पार्थ राजसी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2044234, "chapter_id": 1993, "verse_number": "६-४२-३५", "content_sanskrit": "यथा स्वप्नं भयं शोकं विषादं भदेमेव च ।\nन विमुञ्चति दुर्मेधा धृतिः सा पार्थ तामसी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2044235, "chapter_id": 1993, "verse_number": "६-४२-३६", "content_sanskrit": "सुखं त्विदानीं त्रिविधं श्रुणु मे भारतर्षभ ।\nअभ्यासाद्रमते यत्र दुःखान्तं च निगच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2044236, "chapter_id": 1993, "verse_number": "६-४२-३७", "content_sanskrit": "यत्तदग्रे विषमिव परिणामेऽमृतोपमम्।\nतत्सुखं सात्विकं प्रोक्तमात्मबुद्धिप्रसादजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2044237, "chapter_id": 1993, "verse_number": "६-४२-३८", "content_sanskrit": "विषयेन्द्रियसंयोगाद्यत्तदग्रेऽमृतोपभम् ।\nपरिणामे विषमिव तत्सुखं राजसं स्मृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2044238, "chapter_id": 1993, "verse_number": "६-४२-३९", "content_sanskrit": "यदग्रे चानुबन्धे च सुखं मोहनमात्मनः ।\nनिद्रालस्यप्रमादोत्थं तत्ताभसमुदाहृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2044239, "chapter_id": 1993, "verse_number": "६-४२-४०", "content_sanskrit": "न तदस्ति पृथिव्यां वा दिवि देवेषु वा पुनः ।\nसत्त्वं प्रकृतिजैर्मुक्तं यदेमिः स्यात्रिभिर्गुणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2044240, "chapter_id": 1993, "verse_number": "६-४२-४१", "content_sanskrit": "ब्राह्मणक्षत्रियविशां शूद्राणां च परंतप ।\nकर्माणि प्रविभक्तानि स्वभावप्रभवैर्गुणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2044241, "chapter_id": 1993, "verse_number": "६-४२-४२", "content_sanskrit": "शमो दमस्तपः शौचं क्षान्तिरार्जवमेव च ।\nज्ञानं विज्ञानमास्तिक्यं ब्रह्मकर्म स्वभावजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2044242, "chapter_id": 1993, "verse_number": "६-४२-४३", "content_sanskrit": "शौर्यं तेजो धृतिर्दाक्ष्यं युद्धे चाप्यपलायनम् ।\nदानमीश्वरभावश्च क्षात्रं कर्म स्वभावजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2044243, "chapter_id": 1993, "verse_number": "६-४२-४४", "content_sanskrit": "कृषिगोरक्ष्यरभावश्च क्षात्रं कर्म स्वभावजम् ।\nपरिचर्यात्मकं कर्म शूद्रस्यापि स्वभावजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2044244, "chapter_id": 1993, "verse_number": "६-४२-४५", "content_sanskrit": "स्वे स्वे कर्मण्यभिरतः संसिद्धिं लभते नरः।\nस्वकर्मनिरत्तः सिद्धिं यथा विन्दति तच्छृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2044245, "chapter_id": 1993, "verse_number": "६-४२-४६", "content_sanskrit": "यतः प्रवृत्तिर्भूतानां योन सर्वमिदं ततम्।\nस्वकर्मणा तमभ्यर्च्य सिद्धिं विन्दति मानवःक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2044246, "chapter_id": 1993, "verse_number": "६-४२-४७", "content_sanskrit": "श्रेयान्स्वधर्मो विगुणः परधर्मात्स्वनुष्ठितात् ।\nस्वभावनियतं कर्म कुर्वन्नाप्नोति किल्विषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2044247, "chapter_id": 1993, "verse_number": "६-४२-४८", "content_sanskrit": "सहजं कर्म कौन्तेय सदोषमपि न त्यजेत् ।\nसर्वारम्भा हि दोषेण धूमेनाग्निरिवावृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2044248, "chapter_id": 1993, "verse_number": "६-४२-४९", "content_sanskrit": "असक्तबुद्धिः सर्वत्र जितात्मा विगतस्पृहः ।\nनैष्कर्म्यसिद्धिं परमां संन्यासेनाधिगच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2044249, "chapter_id": 1993, "verse_number": "६-४२-५०", "content_sanskrit": "सिद्धिं प्राप्तो यथा ब्रह्म तथाऽऽप्नेति निबोध मे ।\nसमासेनैव कौन्तेय निष्ठा ज्ञानस्य या परा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2044250, "chapter_id": 1993, "verse_number": "६-४२-५१", "content_sanskrit": "बुद्ध्या विशुद्धया युक्तो धृत्याऽऽत्मानं नियम्य च।\nशब्दादीन्विषयांस्त्यक्त्वा रागद्वेषौ व्युदस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2044251, "chapter_id": 1993, "verse_number": "६-४२-५२", "content_sanskrit": "विविक्तसेवी लध्वाशी यतकाक्कायमानसः।\nध्यानयोगपरो नित्यं वैराग्यं समुपाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2044252, "chapter_id": 1993, "verse_number": "६-४२-५३", "content_sanskrit": "अहङ्कारं बलं दर्पं कामं क्रोधं परिग्रहम् ।\nविमुच्य निर्ममः शान्तो ब्रह्मभूयाय कल्पते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2044253, "chapter_id": 1993, "verse_number": "६-४२-५४", "content_sanskrit": "ब्रह्मभूतः प्रसन्नात्मा न शोचतिक न काङ्क्षति ।\nसमः सर्वेषु भूतेषु मद्तभक्तिं लभते पराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2044254, "chapter_id": 1993, "verse_number": "६-४२-५५", "content_sanskrit": "भक्त्या मामभिजानाति यावान्यश्चास्मि तत्त्वतः।\nततो मां तत्त्वतो ज्ञात्वा विशते तदनन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2044255, "chapter_id": 1993, "verse_number": "६-४२-५६", "content_sanskrit": "सर्वकर्माण्यपि सदा कुर्वाणो मद्व्यपाश्रयः ।\nमत्प्रसादादवाप्नोति शाश्वतं पदमव्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2044256, "chapter_id": 1993, "verse_number": "६-४२-५७", "content_sanskrit": "चेतसा सर्वकर्माणि मयि संन्यस्य मत्परः ।\nबुद्धियोगमपाश्रित्य मच्चित्तः सततं भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2044257, "chapter_id": 1993, "verse_number": "६-४२-५८", "content_sanskrit": "मच्चित्तः सर्वदुर्गाणि मत्प्रसादात्तरिष्यसि ।\nअथ चेत्त्वमहङ्कारान्न श्रोष्यसि विनङ्क्ष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2044258, "chapter_id": 1993, "verse_number": "६-४२-५९", "content_sanskrit": "यदहङ्कारमाश्रित्य न योत्स्य इति मन्यसे ।\nमिथ्यैष व्यवसायस्ते प्रकृतिस्त्वां नियोक्ष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2044259, "chapter_id": 1993, "verse_number": "६-४२-६०", "content_sanskrit": "स्वभावजेन कौन्तेय निबद्धः स्वेन कर्मणा ।\nकर्तुं नेच्छसि यन्मोहात्करिष्यस्यवशोपि तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2044260, "chapter_id": 1993, "verse_number": "६-४२-६१", "content_sanskrit": "ईश्वरः सर्वभूतानां हृद्देशेऽर्जुन तिष्ठति।\nभ्रामयन्सर्वभूतानि यन्त्रारूढानि मायया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2044261, "chapter_id": 1993, "verse_number": "६-४२-६२", "content_sanskrit": "तमेव शरणं गच्छ सर्वभावेन भारत।\nतत्प्रसादात्परां शान्तिं स्थानं प्राप्स्यसि शाश्वतं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2044262, "chapter_id": 1993, "verse_number": "६-४२-६३", "content_sanskrit": "इति ते ज्ञानमाख्यातं गुह्याद्गुह्यतरं मया ।\nविमृश्यैतदशेषेण यथेच्छसि तथा कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2044263, "chapter_id": 1993, "verse_number": "६-४२-६४", "content_sanskrit": "सर्वगुह्यतमं भूयः श्रृणु मे परमं वचः ।\nइष्टेऽसि मे दृढमिति ततो वक्ष्यामि ते हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2044264, "chapter_id": 1993, "verse_number": "६-४२-६५", "content_sanskrit": "मन्मना भव मद्भक्तो मद्याजी मां नमस्कुरु ।\nमामेवैष्यसि सत्यं ते प्रतिजाने प्रियोऽसि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2044265, "chapter_id": 1993, "verse_number": "६-४२-६६", "content_sanskrit": "सर्वधर्मान्परित्यज्य मामेकं शरणं व्रज ।\nअहं त्वा सर्वपापेभ्यो मोक्षयिष्यामि मा शुचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2044266, "chapter_id": 1993, "verse_number": "६-४२-६७", "content_sanskrit": "इदं ते नातपस्काय नाभक्ताय कदाचन।\nन चाशुश्रूषवे वाच्यं न च मां योऽभ्यसूयति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2044267, "chapter_id": 1993, "verse_number": "६-४२-६८", "content_sanskrit": "य इदं परमं गुह्यं मद्भक्तेष्वभिधास्यति।\nभक्तिं मयि परां कृत्वा मामेवैष्यत्यसंशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2044268, "chapter_id": 1993, "verse_number": "६-४२-६९", "content_sanskrit": "न च तस्मान्मनुष्येषु कश्चिन्मे प्रियकृत्तमः ।\nभविता न च मे तस्मादन्यः प्रियतरो भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2044269, "chapter_id": 1993, "verse_number": "६-४२-७०", "content_sanskrit": "अध्येष्यते च य इमं धर्म्यं संवादमावयोः ।\nज्ञानयज्ञेन तेनाहमिष्टः स्यामिति मे मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2044270, "chapter_id": 1993, "verse_number": "६-४२-७१", "content_sanskrit": "श्रद्धावाननसूयश्च श्रृणुयादपि यो नरः।\nसोपि मुक्तः शुभाँल्लोकान्प्राप्नुयात्पुण्यकर्मणां ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2044271, "chapter_id": 1993, "verse_number": "६-४२-७२", "content_sanskrit": "कच्चिदेतच्छ्रुतं पार्थ त्वयैकाग्रेण चेतसा ।\nकच्चिदज्ञानसंमोहः प्रनष्टस्ते धनंजय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2044272, "chapter_id": 1993, "verse_number": "६-४२-७३x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2044273, "chapter_id": 1993, "verse_number": "६-४२-७३", "content_sanskrit": "नष्टो मोहः स्मृतिर्लब्धा त्वत्प्रसादान्मयाऽच्युत ।\nस्थितोऽस्मि गतसंदेहः करिष्ये वचनं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2044274, "chapter_id": 1993, "verse_number": "६-४२-७४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2044275, "chapter_id": 1993, "verse_number": "६-४२-७४", "content_sanskrit": "इत्यहं वासुदेवस्य पार्थस्य च महात्मनः।\nसंवादमिममश्रौषमद्भुतं रोमहर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2044276, "chapter_id": 1993, "verse_number": "६-४२-७५", "content_sanskrit": "व्यासप्रसादाच्छ्रुतवानेतद्गुह्यमहं परम्।\nयोगं योगेश्वरात्कृष्णात्साक्षात्कथयतः स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2044277, "chapter_id": 1993, "verse_number": "६-४२-७६", "content_sanskrit": "राजन्संस्मृत्य संस्मृत्य संवादमिममद्भुतम् ।\nकेशवार्जुवयोः पुण्यं हृष्यामि च मुहुर्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2044278, "chapter_id": 1993, "verse_number": "६-४२-७७", "content_sanskrit": "तच्च संस्मृत्य संस्मृत्य रूपमत्यद्भुतं हरेः।\nविस्मयो मे महान्राजन्हृष्यामि च पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2044279, "chapter_id": 1993, "verse_number": "६-४२-७८", "content_sanskrit": "यत्र योगेश्वरः कृष्णो यत्र पार्थो धनुर्धरः ।\nतत्र श्रीर्विजयो भूतिर्ध्रुवा नीतिर्मतिर्मम ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2044280, "chapter_id": 1993, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भगवद्गीतापर्वणि द्विचत्वारिंशोऽध्यायः ॥\nइति श्रीमद्भगवद्गीतासूपनिषत्सु ब्रह्मविद्यायां योगशास्त्रे श्रीकृष्णार्जुनसंवादे संन्यासयोगोनाम अष्टादशोऽध्यायः ॥ ॥ समाप्तं भगवद्गीतापर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}]