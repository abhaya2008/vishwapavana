[{"id": 7000544000, "chapter_id": 20544, "verse_number": "५-३-१", "content_sanskrit": "शेष उवाच ।\nदृष्ट्वा रामो राजधानीं निजलोकनिवासिनीम् ।\nजहर्ष मतिमान्वीरश्चिरदर्शनलालसः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000544001, "chapter_id": 20544, "verse_number": "५-३-२", "content_sanskrit": "भरतोऽपि स्वकं मित्रं सुमुखं नगरं प्रति ।\nप्रेषयामास सचिवं नगरोत्सवसिद्धये ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000544002, "chapter_id": 20544, "verse_number": "५-३-३", "content_sanskrit": "भरत उवाच ।\nकुर्वंतु लोकास्त्वरितं रघुनाथागमोत्सवम् ।\nमंदिरे मंदिरे रम्यं कृतकौतुकचित्रकम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000544003, "chapter_id": 20544, "verse_number": "५-३-४", "content_sanskrit": "विपांसुका राजमार्गाश्चंदनद्रवसिंचिताः ।\nप्रसूनभरसंकॢप्ता हृष्टपुष्टजनावृताः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000544004, "chapter_id": 20544, "verse_number": "५-३-५", "content_sanskrit": "विचित्रवर्णध्वजभा चित्रिताखिलस्वांगणाः ।\nमेघागमे धनुरिव पश्यंत्वेव वलीमुखाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000544005, "chapter_id": 20544, "verse_number": "५-३-६", "content_sanskrit": "प्रतिगेहं तु लोकानां कारयंत्वगरूक्षणम् ।\nयद्धूमं वीक्ष्य शिखिनो नृत्यं कुर्वंतु लीलया ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000544006, "chapter_id": 20544, "verse_number": "५-३-७", "content_sanskrit": "हस्तिनो मम शैलाभानाधोरणसुयंत्रितान् ।\nविचित्रयंतु बहुशो गैरिकाद्युपधातुभिः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000544007, "chapter_id": 20544, "verse_number": "५-३-८", "content_sanskrit": "वाजिनश्चित्रिता भूयः सुशोभंतु मनोजवाः ।\nयद्वेगवीक्षणादेव गर्वं त्यजति स्वर्हयः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000544008, "chapter_id": 20544, "verse_number": "५-३-९", "content_sanskrit": "कन्याः सहस्रशो रम्याः सर्वाभरणभूषिताः ।\nगजोपरि समारूढा मुक्ताभिर्विकिरंतु च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000544009, "chapter_id": 20544, "verse_number": "५-३-१०", "content_sanskrit": "ब्राह्मण्यः पात्रहस्ताश्च दूर्वाहारिद्रसंयुताः ।\nसुवासिन्यो महाराजं रामं नीराजयंतु ताः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000544010, "chapter_id": 20544, "verse_number": "५-३-११", "content_sanskrit": "कौसल्यापुत्रसंयोगसंदेश विधुरा सती ।\nहर्षं प्राप्नोतु सुकृशा तदीक्षणसुलालसा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000544011, "chapter_id": 20544, "verse_number": "५-३-१२", "content_sanskrit": "इत्येवमादिरचनाः पुरशोभाविधायिकाः ।\nकरोतु जनता हृष्टा रामस्यागमनं प्रति ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000544012, "chapter_id": 20544, "verse_number": "५-३-१३", "content_sanskrit": "शेष उवाच ।\nइति श्रुत्वा ततो वाक्यं सुमुखो मंत्रवित्तमः ।\nप्रययौ नगरीं कर्तुं कृतकौतुकतोरणाम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000544013, "chapter_id": 20544, "verse_number": "५-३-१४", "content_sanskrit": "गत्वाथ नगरीं तां वै मंत्री तु सुमुखाभिधः ।\nख्यापयामास लोकानां रामागममहोत्सवम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000544014, "chapter_id": 20544, "verse_number": "५-३-१५", "content_sanskrit": "लोकाः श्रुत्वा पुरीं प्राप्तं रघुनाथं सुहर्षिताः ।\nपूर्वं तदीय विरहत्यक्तभोगसुखादयः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000544015, "chapter_id": 20544, "verse_number": "५-३-१६", "content_sanskrit": "ब्राह्मणा वेदसंपन्नाः पवित्रा दर्भपाणयः ।\nधौतोत्तरीयवलिता जग्मुः श्रीरघुनायकम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000544016, "chapter_id": 20544, "verse_number": "५-३-१७", "content_sanskrit": "क्षत्रिया ये शूरतमा धनुर्बाणधरा वराः ।\nसंग्रामे बहुशो वीरा जेतारो ययुरप्यमुम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000544017, "chapter_id": 20544, "verse_number": "५-३-१८", "content_sanskrit": "वैश्या धनसमृद्धाश्च मुद्राशोभितपाणयः ।\nशुभ्रवस्त्रपरीधाना अभिजग्मुर्नरेश्वरम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000544018, "chapter_id": 20544, "verse_number": "५-३-१९", "content_sanskrit": "शूद्रा द्विजेषु ये भक्ताः स्वीयाचारसुनिष्ठिताः ।\nवेदाचाररता ये वै तेऽपिजग्मुः पुरीपतिम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000544019, "chapter_id": 20544, "verse_number": "५-३-२०", "content_sanskrit": "ये ये वृत्तिकरा लोकाः स्वे स्वे कर्मण्यधिष्ठिताः ।\nस्वकं वस्तु समादाय ययुः श्रीरामभूपतिम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000544020, "chapter_id": 20544, "verse_number": "५-३-२१", "content_sanskrit": "इत्थं भूपतिसंदेशात्प्रमोदाप्लवसंयुताः ।\nनाना कौतुकसंयुक्ता आजग्मुर्मनुजेश्वरम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000544021, "chapter_id": 20544, "verse_number": "५-३-२२", "content_sanskrit": "शेष उवाच ।\nरघुनाथोऽपि सकलैर्दैवतैः स्वस्वयानगैः ।\nपरीतः प्रविवेशोच्चैः पुरीं रचितमोहनाम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000544022, "chapter_id": 20544, "verse_number": "५-३-२३", "content_sanskrit": "प्लवंगाः प्लवनैर्युक्ता आकाशपथचारिणः ।\nस्वस्वशोभापरीतांगाश्चानुजग्मुः पुरोत्तमम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000544023, "chapter_id": 20544, "verse_number": "५-३-२४", "content_sanskrit": "पुष्पकादवरुह्याशु नरयानमथारुहत् ।\nसीतया सहितो रामः परिवारसमावृतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000544024, "chapter_id": 20544, "verse_number": "५-३-२५", "content_sanskrit": "अयोध्यां प्रविवेशाथ कृतकौतुकतोरणाम् ।\nहृष्टपुष्टजनाकीर्णामुत्सवैः परीभूषिताम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000544025, "chapter_id": 20544, "verse_number": "५-३-२६", "content_sanskrit": "वीणापणवभेर्यादिवादित्रैराहतैर्भृशम् ।\nशोभमानः स्तूयमानः सूतमागधबंदिभिः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000544026, "chapter_id": 20544, "verse_number": "५-३-२७", "content_sanskrit": "जय राघवरामेति जय सूर्यकुलांगद ।\nजय दाशरथे देव जयताल्लोकनायकः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000544027, "chapter_id": 20544, "verse_number": "५-३-२८", "content_sanskrit": "इति शृण्वञ्छुभां वाचं पौराणां हर्षितांगिनाम् ।\nरामदर्शनसंजात पुलकोद्भेद शोभिनाम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000544028, "chapter_id": 20544, "verse_number": "५-३-२९", "content_sanskrit": "प्रविवेश वरं मार्गं रथ्याचत्वरभूषितम् ।\nचंदनोदकसंसिक्तं पुष्पपल्लवसंयुतम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000544029, "chapter_id": 20544, "verse_number": "५-३-३०", "content_sanskrit": "तदा पौरांगनाः काश्चिद्गवाक्षबिलमाश्रिताः ।\nरघुनाथस्वरूपेक्षा जातकामा अथाब्रुवन् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000544030, "chapter_id": 20544, "verse_number": "५-३-३१", "content_sanskrit": "पौरांगना ऊचुः ।\nधन्या अभूवन्बत भिल्लकन्या वनेषु या राममुखारविंदम् ।\nस्वलोचनेंदीवरकैरथापिबन्स्वभाग्यसंजातमहोदया इमाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000544031, "chapter_id": 20544, "verse_number": "५-३-३२", "content_sanskrit": "धन्यं मुखं पश्यत वीरधाम्नः श्रीरामदेवस्य सरोजनेत्रम् ।\nयद्दर्शनं धातृमुखाः सुरा अपि प्रापुर्महद्भाग्ययुता वयंत्वहो ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000544032, "chapter_id": 20544, "verse_number": "५-३-३३", "content_sanskrit": "एतन्मुखं पश्यत चारुहासं किरीटसंशोभिनिजोत्तमांगम् ।\nबंधूकधिक्कारलसच्छविप्रदं दंतच्छदं बिभ्रतमुच्चनासम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]