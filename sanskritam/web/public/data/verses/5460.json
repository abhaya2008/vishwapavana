[{"id": 2208781, "chapter_id": 5460, "verse_number": "", "content_sanskrit": "उदङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2208782, "chapter_id": 5460, "verse_number": "१", "content_sanskrit": "ब्रूहि केशव तत्त्वेन त्वं मेऽध्यात्ममनिन्दितम् ।\nश्रुत्वा श्रेयो विधास्यामि न शापं ते जनार्दन ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2208783, "chapter_id": 5460, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2208784, "chapter_id": 5460, "verse_number": "२", "content_sanskrit": "तमो रजश्च सत्वं च विद्धि भावान् मदाश्रयान् ।\nस्थितिसृष्टिलयाध्यक्षो विष्णुब्रह्मेशसञ्ज्ञितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2208785, "chapter_id": 5460, "verse_number": "३", "content_sanskrit": "कदाचित् तमसा रुद्रो विष्णुः सत्वगुणे स्थितः ।\nरजस्यपि तथा ब्रह्मा स्वगुणान्यगुणावुभौ ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2208786, "chapter_id": 5460, "verse_number": "४", "content_sanskrit": "प्रवणात्मा च शब्दादि त्रिगुणात्मा चराचरम् ।\nतथा रुद्रान् वसून् वाऽपि विद्धि मत्प्रभवान् द्विज ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2208787, "chapter_id": 5460, "verse_number": "५", "content_sanskrit": "मयि सर्वाणि भूतानि सर्वभूतेषु चाप्यहम् ।\nस्थित इत्यभिजानीहि मा ते भूदत्र संशयः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2208788, "chapter_id": 5460, "verse_number": "६", "content_sanskrit": "तथा दैत्यगणान् सर्वान् यक्षगन्धर्वराक्षसान् ।\nविबुधाप्सरसश्चैव विद्धि मत्प्रभवान् द्विज ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2208789, "chapter_id": 5460, "verse_number": "७", "content_sanskrit": "सदसच्चैव यत् प्राहुरव्यक्तं व्यक्तमेव च ।\nअक्षरं च क्षरं चैव सर्वमेतन्मदाश्रयम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2208790, "chapter_id": 5460, "verse_number": "८", "content_sanskrit": "ये चाश्रमेषु वै धर्माश्चतुर्षु विहिता मुने ।\nदैवतानि च कर्माणि विद्धि सर्वान् गुणात्मकान् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2208791, "chapter_id": 5460, "verse_number": "९", "content_sanskrit": "असच्च सच्चैव च यद् विश्वं सदसतः परम् ।\nततः परतरं नास्ति देवदेवात् सनातनात् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2208792, "chapter_id": 5460, "verse_number": "१०", "content_sanskrit": "ओङ्कारप्रभवान् वेदान् विद्धि मा त्वं भृगूद्वह ।\nतथैव यूपं सोमं च त्रिदशाप्यायनं मखे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2208793, "chapter_id": 5460, "verse_number": "११", "content_sanskrit": "होतारमपि हव्यं च विद्धि मां भृगुनन्दन ।\nअध्वर्युः कल्पकृच्चापि हविः परमसंस्कृतम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2208794, "chapter_id": 5460, "verse_number": "१२", "content_sanskrit": "उद्गाता चापि मां स्तौति गीतघोषैर्महाध्वरे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2208795, "chapter_id": 5460, "verse_number": "१३", "content_sanskrit": "प्रायश्चित्तेषु मां ब्रह्मन् शान्तिमङ्गलवाचकाः ।\nस्तुवन्ति विश्वकर्माणं सततं द्विजसत्तमाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2208796, "chapter_id": 5460, "verse_number": "१४", "content_sanskrit": "विद्धि मेऽद्य सुतं धर्ममग्रजं द्विजसत्तम ।\nमानसं दयितं विप्र सर्वभूतगुणात्मकम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2208797, "chapter_id": 5460, "verse_number": "१५", "content_sanskrit": "अत्राहं वर्तमानैश्च निवृत्तैश्चापि मानवैः ।\nबहुधा जायमानो वै वर्तेय द्विजसत्तम ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2208798, "chapter_id": 5460, "verse_number": "१६", "content_sanskrit": "लोकसंरक्षणार्थाय धर्मसंस्थापनाय च ।\nतैस्तैर्वेषैश्च रूपैश्च त्रिषु लोकेषु भार्गव ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2208799, "chapter_id": 5460, "verse_number": "१७", "content_sanskrit": "अहं विष्णुरहं ब्रह्मा शक्रोऽहं प्रभवाप्ययः ।\nभूतग्रामस्य सर्वस्य स्रष्टा संहार एव च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2208800, "chapter_id": 5460, "verse_number": "१८", "content_sanskrit": "अधर्मे वर्तमानानां सर्वेषामहमच्युतः ।\nधर्मस्य सेतुं बध्नामि चलिते चलिते युगे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2208801, "chapter_id": 5460, "verse_number": "१९", "content_sanskrit": "तास्ता योनीः प्रविश्याहं प्रजानां हितकाम्यया ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2208802, "chapter_id": 5460, "verse_number": "२०", "content_sanskrit": "यदा त्वहं देवयोनौ वर्ते भृगुकुलोद्वह ।\nतदाऽहं देववत् सर्वमाचरामि न संशयः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2208803, "chapter_id": 5460, "verse_number": "२१", "content_sanskrit": "यदा गन्धर्वयोनौ तु वर्तेऽहं भृगुनन्दन ।\nतदा गन्धर्ववच्चेष्टाः सर्वाश्चेष्टामि भार्गव ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2208804, "chapter_id": 5460, "verse_number": "२२", "content_sanskrit": "नागयोनौ यदा वर्ते तदा चेष्टा तु नागवत् ।\nयक्षराक्षसयोनौ तु तथावृत्तिश्चराम्यहम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2208805, "chapter_id": 5460, "verse_number": "२३", "content_sanskrit": "मानुष्ये वर्तमाने तु कृपणं याचिता मया ।\nन च ते जातसम्मोहा वचो गृह्णन्ति मे हितम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2208806, "chapter_id": 5460, "verse_number": "२४", "content_sanskrit": "भयं च महदुद्दिश्य त्रासिताः कुरवो मया ।\nक्रुद्धेन भूत्वा तु पुनर्यथावदभिगर्हिताः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2208807, "chapter_id": 5460, "verse_number": "२५", "content_sanskrit": "तेऽधर्मेणेह संयुक्ताः परीताः कालधर्मणा ।\nधर्मेण निहता युद्धे गताः स्वर्गं न संशयः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2208808, "chapter_id": 5460, "verse_number": "२६", "content_sanskrit": "लोकेषु पाण्डवाः ख्यातिं गमिष्यन्ति द्विजोत्तम ।\nएतत् ते सर्वमाख्यानं यन्मां त्वं परिपृच्छसि ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2208809, "chapter_id": 5460, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि कौरवापराधकथनं नाम चतुःपञ्चाशोऽध्यायः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]