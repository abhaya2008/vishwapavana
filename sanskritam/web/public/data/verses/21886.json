[{"id": 7001886000, "chapter_id": 21886, "verse_number": "६५-१", "content_sanskrit": "मार्कण्डेय उवाच ।\nततः स ताभिः सहितः पत्नीभिरमरद्युतिः ।\nरराम तस्मिन् शैलेन्द्रे रम्यकानननिर्झरे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001886001, "chapter_id": 21886, "verse_number": "६५-२", "content_sanskrit": "सर्वोपभोगरत्नानि मधूनि मधुराणि च ।\nनिधयः समुपाजह्रुः पद्मिन्या वशवर्तिनः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001886002, "chapter_id": 21886, "verse_number": "६५-३", "content_sanskrit": "स्त्रजो वस्त्राण्यलङ्कारान् गन्धाढ्यमनुलेपनम् ।\nआसनान्यतिशुभ्राणि काञ्चनानि यथेच्छया ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001886003, "chapter_id": 21886, "verse_number": "६५-४", "content_sanskrit": "सौवर्णानि महाभाग! करकान् भाजनानि च ।\nतथा शय्याश्च विविधा दिव्यैरास्तरणैर्युताः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001886004, "chapter_id": 21886, "verse_number": "६५-५", "content_sanskrit": "एवं स ताभिः सहितो दिव्यगन्धाधिवासिते ।\nरराम स्वरुचिर्भाभिर्भासिते वरपर्वते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001886005, "chapter_id": 21886, "verse_number": "६५-६", "content_sanskrit": "ताश्चापि सह तेनेति लेभिरे मुदमुत्तमाम् ।\nरममाणा यथा स्वर्गे तथा तत्र शिलोच्चये ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001886006, "chapter_id": 21886, "verse_number": "६५-७", "content_sanskrit": "कलहंसी जगादैकां चक्रवाकीं जले सतीम् ।\nतस्य तासाञ्च ललिते सम्बन्धे च स्पृहावती ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001886007, "chapter_id": 21886, "verse_number": "६५-८", "content_sanskrit": "धन्योऽयमतिपुण्योऽयं योऽय यौवनगोचरः ।\nदयिताभिः सहैताभिर्भुङ्क्ते भोगानभीप्सितान् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001886008, "chapter_id": 21886, "verse_number": "६५-९", "content_sanskrit": "सन्ति यौवनिनः श्लाघ्यास्तत्पत्न्यो नातिशोभनाः ।\nजगत्यामल्पकाः पत्न्यः पतयश्चातिशोभनाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001886009, "chapter_id": 21886, "verse_number": "६५-१०", "content_sanskrit": "अभीष्टा कस्यचित् कान्ता कान्तः कस्याश्चिदीप्सितः ।\nपरस्परानुरागाढ्यं दाम्पत्यमतिदुर्लभम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001886010, "chapter_id": 21886, "verse_number": "६५-११", "content_sanskrit": "धन्योऽयं दयिताभीष्टो ह्येताश्चास्यातिवल्लभाः ।\nपरस्परानुरागो हि धन्यानामेव जायते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001886011, "chapter_id": 21886, "verse_number": "६५-१२", "content_sanskrit": "एतन्निशम्यवचनं कलहंसीसमीरितम् ।\nउवाच चक्रवाकी तां नातिविस्मितमानसा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001886012, "chapter_id": 21886, "verse_number": "६५-१३", "content_sanskrit": "नायं धन्यो यतो लज्जा नान्यस्त्रीसन्निकर्षतः ।\nअन्यां स्त्रियमयं भुङ्क्ते न सर्वास्वस्य मानसम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001886013, "chapter_id": 21886, "verse_number": "६५-१४", "content_sanskrit": "चित्तानुराग एकस्मिन्नधिष्ठाने यतः सखि ।\nततो हि प्रीतिमानेष भार्यासु भविता कथम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001886014, "chapter_id": 21886, "verse_number": "६५-१५", "content_sanskrit": "एता न दयिताः पत्युर्नैतासां दयितः पतिः ।\nविनोदमात्रमेवैता यथा परिजनोऽपरः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001886015, "chapter_id": 21886, "verse_number": "६५-१६", "content_sanskrit": "एतासाञ्च यदिष्टोऽयं तत् किं प्राणान्न मुञ्चति ।\nआलिङ्गत्यपरां कान्तां ध्यातो वै कान्तयान्यया ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001886016, "chapter_id": 21886, "verse_number": "६५-१७", "content_sanskrit": "विद्याप्रदानमूल्येन विक्रीतो ह्येष भृत्यवत् ।\nप्रवर्तते न हि प्रेम समं बह्वीषु तिष्ठति ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001886017, "chapter_id": 21886, "verse_number": "६५-१८", "content_sanskrit": "कलहंसि! पतिर्धन्यो मम धन्याहमेव च ।\nयस्यैकस्याञ्चिरं चित्तं यस्याश्चैकत्र संस्थितम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001886018, "chapter_id": 21886, "verse_number": "६५-१९", "content_sanskrit": "सर्वसत्त्वरुतज्ञोऽसौ स्वरोचिरपराजितः ।\nनिशम्य लज्जितो दध्यौ सत्यमेव हि नानृतम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001886019, "chapter_id": 21886, "verse_number": "६५-२०", "content_sanskrit": "ततो वर्षशते याते रममाणो महागिरौ ।\nरममाणः समं ताभिर्ददर्श पुरतो मृगम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001886020, "chapter_id": 21886, "verse_number": "६५-२१", "content_sanskrit": "सुस्निग्धपीनावयवं मृगयूथविहारिणम् ।\nवासिताभिः सुरूपाभिर्मृगीभिः परिवारितम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001886021, "chapter_id": 21886, "verse_number": "६५-२२", "content_sanskrit": "आकृष्टघ्राणपुटका जिघ्रन्तीस्तास्ततो मृगीः ।\nउवाच स मृगो रामा लज्जात्यागेन गम्यताम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001886022, "chapter_id": 21886, "verse_number": "६५-२३", "content_sanskrit": "नाहं स्वरोचिस्तच्छीलो न चैवाहं सुलोचनाः ।\nनिर्लज्जा बहवः सन्ति तादृशास्तत्र गच्छतः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001886023, "chapter_id": 21886, "verse_number": "६५-२४", "content_sanskrit": "एका त्वनेकानुगता यथा हासास्पदं जने ।\nअनेकाभिस्तथैवैको बोगदृष्ट्या निरीक्षितः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001886024, "chapter_id": 21886, "verse_number": "६५-२५", "content_sanskrit": "तस्य धर्मक्रियाहानिरहन्यहनि जायते ।\nसक्तोऽन्यभार्यया चान्यकामासक्तः सदैव सः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001886025, "chapter_id": 21886, "verse_number": "६५-२६", "content_sanskrit": "यस्तादृशोऽन्यस्तच्छीलः परलोकपराङ्मुखः ।\nतं कामयत भद्रं वो नाहं तुल्यः स्वरोचिषा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]