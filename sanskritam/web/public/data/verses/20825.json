[{"id": 7000825000, "chapter_id": 20825, "verse_number": "६-१६८-१", "content_sanskrit": "महादेव उवाच ।\nततोगच्छेन्महादेवि वार्त्रघ्न्या गिरिकन्यया ।\nशक्रश्चैव तया साध्व्या संगमं यत्र लब्धवान्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000825001, "chapter_id": 20825, "verse_number": "६-१६८-२", "content_sanskrit": "तत्र स्नानं प्रकुर्वंति नरा नियतमानसाः ।\nदशानामश्वमेधानां यत्फलं स्नानकृल्लभेत्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000825002, "chapter_id": 20825, "verse_number": "६-१६८-३", "content_sanskrit": "तत्र यः कुरुते श्राद्धं पिंडान्वै तिलचूर्णजान् ।\nपुनाति पुरुषो वंशान्सप्तसप्तपरावरान्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000825003, "chapter_id": 20825, "verse_number": "६-१६८-४", "content_sanskrit": "संपूज्य विधिवत्स्नात्वा संगमे गणनायकम् ।\nन विघ्नैरभिभूयेत लक्ष्म्या नैव विहीयते॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000825004, "chapter_id": 20825, "verse_number": "६-१६८-५", "content_sanskrit": "पार्वत्युवाच ।\nकस्मिन्कार्यसमारंभे समायातः पुरंदरः ।\nस्वर्गलोकादिमं लोकमेतदाख्यातुमर्हसि॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000825005, "chapter_id": 20825, "verse_number": "६-१६८-६", "content_sanskrit": "वार्त्रघ्नी च नदी केन निरुक्तेन निगद्यते ।\nपुरंदरपुरं देव ब्रह्मघोषनिनादितम् ।\nसंभावयति योऽजस्रं मम तत्संगमं वद॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000825006, "chapter_id": 20825, "verse_number": "६-१६८-७", "content_sanskrit": "महादेव उवाच ।\nअस्मिंश्चैव तु भूर्लोके प्रश्नोऽयं समभूत्पुरा ।\nयुधिष्ठिरेति विख्यातो राजा वै धार्मिको महान्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000825007, "chapter_id": 20825, "verse_number": "६-१६८-८", "content_sanskrit": "पृष्टवान्स तु भीष्माय धर्मिणे ज्ञानरूपिणे ।\nतेनोक्तं यत्तु तद्देवि प्रवक्ष्यामि तवाग्रतः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000825008, "chapter_id": 20825, "verse_number": "६-१६८-९", "content_sanskrit": "दशवर्षसहस्राणि दशवर्षशतानि च ।\nवृत्रवासवयोर्युद्धमभवल्लोमहर्षणम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000825009, "chapter_id": 20825, "verse_number": "६-१६८-१०", "content_sanskrit": "ततः पराजितः शक्रः कृत्वा वृत्रेण संविधम् ।\nअद्रोहे स रणं त्यक्त्वा जगाम शरणं मम॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000825010, "chapter_id": 20825, "verse_number": "६-१६८-११", "content_sanskrit": "वार्त्रघ्न्या संगमे पुण्ये तोषयामास शंकरम् ।\nअथांतरिक्षेऽहं देवि दर्शनं दत्तवांस्तदा॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000825011, "chapter_id": 20825, "verse_number": "६-१६८-१२", "content_sanskrit": "ममगात्रात्तु यद्भस्म पतितं काश्यपी तटे ।\nभस्मगात्रेति तत्पुण्यं लिंगं देवि विनिर्मितम्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000825012, "chapter_id": 20825, "verse_number": "६-१६८-१३", "content_sanskrit": "भूतेश्वरं भस्मगात्रं ब्रह्मणा संप्रतिष्ठितम् ।\nतस्य वै दर्शनादेव ब्रह्महत्या लयं व्रजेत्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000825013, "chapter_id": 20825, "verse_number": "६-१६८-१४", "content_sanskrit": "मुच्यते सर्वपापेभ्यः श्राद्धं कृत्वा युगादिषु ।\nतदहं सुप्रसन्नोऽभूदिन्द्राय सुमहात्मने॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000825014, "chapter_id": 20825, "verse_number": "६-१६८-१५", "content_sanskrit": "यद्यत्त्वं वांछसे देव तत्सर्वं हि ददामि ते ।\nअनेन वज्रयोगेन शीघ्रं वृत्रं हनिष्यसि॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000825015, "chapter_id": 20825, "verse_number": "६-१६८-१६", "content_sanskrit": "शक्र उवाच ।\nभगवंस्त्वत्प्रसादेन दितिजं च दुरासदम् ।\nवज्रेण निहनिष्यामि पश्यतस्ते सुरोत्तम॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000825016, "chapter_id": 20825, "verse_number": "६-१६८-१७", "content_sanskrit": "एवमुक्त्वा तदा इंद्रो गतवांश्चासुरं प्रति ।\nतदा दुंदुभयो नेदुर्देवसैन्ये विशेषतः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000825017, "chapter_id": 20825, "verse_number": "६-१६८-१८", "content_sanskrit": "मृदंग डिंडिमाश्चैव भेरी तूर्याण्यनेकशः ।\nअसुराणां च सर्वेषां वृत्तिलोभो महानभूत॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000825018, "chapter_id": 20825, "verse_number": "६-१६८-१९", "content_sanskrit": "बलवान्मघवा चैव क्षणेन समजायत् ।\nतमाविष्टं ततो ज्ञात्वा ऋषयः पन्नगास्तथा॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000825019, "chapter_id": 20825, "verse_number": "६-१६८-२०", "content_sanskrit": "स्तुवंति शक्रमीशानं स्तुत्या जयजयेति च ।\nगच्छतस्तस्य शक्रस्य युद्धकामस्य सन्निधौ ।\nऋषिभिः स्तूयमानस्य रूपमासीत्सुदुर्भरम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000825020, "chapter_id": 20825, "verse_number": "६-१६८-२१", "content_sanskrit": "महादेव उवाच ।\nवृत्रस्यसहसा देवि तदा संग्राममूर्द्धनि ।\nअभवन्यानि लिंगानि शरीरे तानि मे शृणु॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000825021, "chapter_id": 20825, "verse_number": "६-१६८-२२", "content_sanskrit": "ज्वलतास्योभवद्धोरो वैवर्ण्यमभवत्परम् ।\nगात्रकंपश्च सुमहान्श्वासः सोष्मा व्यजायत्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000825022, "chapter_id": 20825, "verse_number": "६-१६८-२३", "content_sanskrit": "रोमहर्षश्च तीव्रोऽभूच्छ्वासश्चैव महानभूत् ।\nनिष्पपात महाघोरा उल्काः पार्श्वं प्रपेदिरे॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000825023, "chapter_id": 20825, "verse_number": "६-१६८-२४", "content_sanskrit": "गृध्रा वटाः श्येन कंका वचो मुंचन्सुदारुणाः ।\nवृत्रस्योपरि ते सर्वे चक्रवत्परिबभ्रमुः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000825024, "chapter_id": 20825, "verse_number": "६-१६८-२५", "content_sanskrit": "ततः स गजमास्थाय इंद्रस्तत्र समागतः ।\nवज्रोद्यतकरस्तत्र शक्रस्तं दैत्यमासदत्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000825025, "chapter_id": 20825, "verse_number": "६-१६८-२६", "content_sanskrit": "अमानुषमथो नादं स मुमोच सुरेश्वरः ।\nवृत्रासुरस्य यततः शक्रो वज्रमपातयत्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000825026, "chapter_id": 20825, "verse_number": "६-१६८-२७", "content_sanskrit": "स वज्रः सुमहातेजाः कालाग्निसदृशो महान् ।\nसमुद्रस्य तटे वृत्रं शक्रो दैत्यमपातयत्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000825027, "chapter_id": 20825, "verse_number": "६-१६८-२८", "content_sanskrit": "ततो नादः समभवत्पुनरेव समंततः ।\nवृत्रं विनिहतं दृष्ट्वा सर्वदेवभयंकरम्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000825028, "chapter_id": 20825, "verse_number": "६-१६८-२९", "content_sanskrit": "पुष्पवृष्टिस्तु महती इंद्र मूर्ध्नि पपात ह ।\nवृत्रं हत्वा स भगवान्दानवेशं भयंकरम्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000825029, "chapter_id": 20825, "verse_number": "६-१६८-३०", "content_sanskrit": "स्तूयमानोऽमरैः सार्द्धं देवदानीं तमाविशत् ।\nअथ वृत्रशरीरात्तु निर्गतं तेज उत्तमम्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000825030, "chapter_id": 20825, "verse_number": "६-१६८-३१", "content_sanskrit": "ब्रह्महत्यामहाघोरा रौद्र लोकभयंकरी ।\nकरालवदना सा च विकृता कृष्णपिंगला॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000825031, "chapter_id": 20825, "verse_number": "६-१६८-३२", "content_sanskrit": "कपालमालिनी चैव सुकृशा नगनंदिनि ।\nरुधिराक्ता च पापिष्ठा मीनगंधातिभीषणा॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000825032, "chapter_id": 20825, "verse_number": "६-१६८-३३", "content_sanskrit": "सानिष्क्रम्य महादेवि तादृग्रूपा भयावहा ।\nइंद्रमन्वेषयामास तदा वै सुरसत्तमे॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000825033, "chapter_id": 20825, "verse_number": "६-१६८-३४", "content_sanskrit": "निर्धावती ततः सा तु दृष्ट्वा शक्रं महौजसम् ।\nकंठे जग्राह देवेंद्रं सुलग्ना साभवत्तदा॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000825034, "chapter_id": 20825, "verse_number": "६-१६८-३५", "content_sanskrit": "स च तस्मिन्समुद्भ्रांतो ब्रह्महत्याकृते भये ।\nनिलिल्य बिसमध्येऽसौ स्थितो वर्षगणान्बहून्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000825035, "chapter_id": 20825, "verse_number": "६-१६८-३६", "content_sanskrit": "तया गृहीतो भो देवि निश्चेष्टः समपद्यत ।\nतस्या व्यपोहने शक्रः प्रयत्नं च चकार ह॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000825036, "chapter_id": 20825, "verse_number": "६-१६८-३७", "content_sanskrit": "न शक्तोऽभून्महादेवि ब्रह्महत्यां व्यपोहितुम् ।\nतया गृहीतमात्रस्तु देवेंद्रो निष्ठरूपधृक्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000825037, "chapter_id": 20825, "verse_number": "६-१६८-३८", "content_sanskrit": "पितामहमुपागम्य शिरसा प्रत्यपूजयत् ।\nज्ञात्वा गृहीतं शक्रं तु द्विजप्रवरहत्यया॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000825038, "chapter_id": 20825, "verse_number": "६-१६८-३९", "content_sanskrit": "ब्रह्मा संचिंतयामास तदा वै सुरसत्तमे ।\nसा चिंत्यमाना ब्रह्माणमुपगम्याब्रवीद्वचः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000825039, "chapter_id": 20825, "verse_number": "६-१६८-४०", "content_sanskrit": "प्राप्तास्मि भगवन्देव त्वत्सकाशं हि मानद ।\nयत्कर्त्तव्यं मया देव तद्भवान्वक्तुमर्हति॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000825040, "chapter_id": 20825, "verse_number": "६-१६८-४१", "content_sanskrit": "तामुवाच महाभागे ब्रह्महत्यां पितामहः ।\nस्वरेण मधुरेणाथ संक्षेपेण यथातथम्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000825041, "chapter_id": 20825, "verse_number": "६-१६८-४२", "content_sanskrit": "मुच्यतां देवराजोऽयं मत्प्रियं कुरु भामिनि ।\nब्रूहि किं ते करोम्यद्य कामं त्वं किमिहेच्छसि॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000825042, "chapter_id": 20825, "verse_number": "६-१६८-४३", "content_sanskrit": "हत्योवाच ।\nशक्रादपगमिष्यामि वचनात्ते नरोत्तम ।\nदेवदेव नमस्तेस्तु निवासं च ददस्व मे॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000825043, "chapter_id": 20825, "verse_number": "६-१६८-४४", "content_sanskrit": "महादेव उवाच ।\nतथेति तां प्रतिज्ञाय हत्यां चापि पितामहः ।\nउपायमथ शक्रस्य ब्रह्महत्यापनोदने॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000825044, "chapter_id": 20825, "verse_number": "६-१६८-४५", "content_sanskrit": "ततो वह्निं समाहूय ब्रह्मा वचनमब्रवीत् ।\nशक्रहत्या चतुर्थांशं जातवेदो गृहाण भो॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000825045, "chapter_id": 20825, "verse_number": "६-१६८-४६", "content_sanskrit": "अग्निरुवाच ।\nमम मोक्षस्य को हेतुर्ब्रह्महत्याकृते प्रभो ।\nएतदिच्छामि विज्ञातुं तत्त्वतो लोकपूजित॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000825046, "chapter_id": 20825, "verse_number": "६-१६८-४७", "content_sanskrit": "ब्रह्मोवाच ।\nयस्त्वां ज्वलंतमासाद्य न होष्यति नरः क्वचित् ।\nबीजौषधितिलानग्रे फलमूलसमित्कुशान्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000825047, "chapter_id": 20825, "verse_number": "६-१६८-४८", "content_sanskrit": "तदैव त्यक्षति त्वां च तत्रैव च निवत्स्यति ।\nब्रह्महत्या हव्यवाह व्येतु ते मनसो ज्वरः॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000825048, "chapter_id": 20825, "verse_number": "६-१६८-४९", "content_sanskrit": "ततः स परिजग्राह तद्वचो हव्यकव्यभुक् ।\nपितामहश्च भगवान्तथा तदलभत्प्रियम्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000825049, "chapter_id": 20825, "verse_number": "६-१६८-५०", "content_sanskrit": "ततो वृक्षौषधितृणान्याहूय स पितामहः ।\nइममर्थं महाभागे वक्तुं समुपचक्रमे॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000825050, "chapter_id": 20825, "verse_number": "६-१६८-५१", "content_sanskrit": "ततो वृक्षौषधितृणैस्तथैवोक्तं यथातथम् ।\nव्यथितान्यग्निवद्देवि ब्रह्माणं वाक्यमब्रुवन्॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000825051, "chapter_id": 20825, "verse_number": "६-१६८-५२", "content_sanskrit": "अस्माकं ब्रह्महत्यायाः कथयंतः पितामह ।\nस्वभाव निहिता तस्मान्न पुनर्हंतुमर्हसि॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000825052, "chapter_id": 20825, "verse_number": "६-१६८-५३", "content_sanskrit": "वयमग्निं तथा शीतं वर्षं च पवनेरितम् ।\nसहामः सततं देव तथा छेदनभेदनम्॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000825053, "chapter_id": 20825, "verse_number": "६-१६८-५४", "content_sanskrit": "ब्रह्मोवाच ।\nअकारणं नरो यस्तु युष्मच्छेदनभेदनम् ।\nकरिष्यति महामोहात्तमेषानु प्रयास्यति॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000825054, "chapter_id": 20825, "verse_number": "६-१६८-५५", "content_sanskrit": "महादेव उवाच ।\nततो महौषधितृणैरोमित्युक्तं महात्मभिः ।\nब्रह्माणमपि संपूज्य जग्मुश्चाथ यथागतम्॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000825055, "chapter_id": 20825, "verse_number": "६-१६८-५६", "content_sanskrit": "आहूयाप्सरसो देवस्ततो लोकपितामहः ।\nवाचा मधुरया प्राह सांत्वयन्निव सत्तमे॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000825056, "chapter_id": 20825, "verse_number": "६-१६८-५७", "content_sanskrit": "इयं वृत्रादनुप्राप्ता ब्रह्महत्या वराङ्गनाः ।\nचतुर्थमस्या भागं च मयोक्तं संप्रतीच्छथ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000825057, "chapter_id": 20825, "verse_number": "६-१६८-५८", "content_sanskrit": "अप्सरा ऊचुः ।\nग्रहणे कृतबुद्धीनां देवेश तव शासनात् ।\nसंमोक्षसमयोऽस्माकं चिंतनीयः पितामह॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000825058, "chapter_id": 20825, "verse_number": "६-१६८-५९", "content_sanskrit": "पितामह उवाच ।\nरजस्वलासु नारीषु यो वै मैथुनमाचरेत् ।\nतमेषा यास्यति क्षिप्रं व्येतु वो मनसो ज्वरः॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000825059, "chapter_id": 20825, "verse_number": "६-१६८-६०", "content_sanskrit": "महादेव उवाच ।\nतथेति हृष्टमनसः प्रत्युक्ता ह्यप्सरोगणाः ।\nस्वानि स्थानानि संप्राप्य रेमिरे शैलजे तदा॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000825060, "chapter_id": 20825, "verse_number": "६-१६८-६१", "content_sanskrit": "ततश्च लोककृद्देवः पुनरेव पितामहः ।\nआपः संचिंतयामास ततस्ताश्च समागमन्॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000825061, "chapter_id": 20825, "verse_number": "६-१६८-६२", "content_sanskrit": "ताश्च सर्वाः समागम्य ब्रह्माणममितौजसम् ।\nइदमूचुर्वचो देवि प्रणिपत्य पितामहम्॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000825062, "chapter_id": 20825, "verse_number": "६-१६८-६३", "content_sanskrit": "इमाः स्म देव संप्राप्तास्त्वत्सकाशमरिंदम ।\nशासनात्तव देवेश समाज्ञापय तत्प्रभो॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000825063, "chapter_id": 20825, "verse_number": "६-१६८-६४", "content_sanskrit": "ब्रह्मोवाच ।\nइयं वृत्रादनुप्राप्ता पुरुहूतं भयानका ।\nब्रह्महत्या चतुर्थांशं यूयमस्याः प्रतीच्छथ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000825064, "chapter_id": 20825, "verse_number": "६-१६८-६५", "content_sanskrit": "आप ऊचुः ।\nएवं भवतु लोकेश यत्त्वं वदसि नः प्रभोः ।\nमोक्षस्य समयं नस्त्वं संचिंतयितुमर्हसि॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000825065, "chapter_id": 20825, "verse_number": "६-१६८-६६", "content_sanskrit": "त्वं हि देवेंद्र सर्वस्य जगतः परमा गतिः ।\nकोऽन्येभ्यो हि प्रसादोऽपि यः कृच्छ्रान्नः समुद्धरेत्॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000825066, "chapter_id": 20825, "verse_number": "६-१६८-६७", "content_sanskrit": "ब्रह्मोवाच ।\nअल्पमेव मतिं कृत्वा यो नरो बुद्धिमोहितः॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000825067, "chapter_id": 20825, "verse_number": "६-१६८-६८", "content_sanskrit": "श्लेष्ममूत्रपुरीषाणि युष्मासु प्रतिमोक्षति ।\nतमेव यास्यति क्षिप्रं तत्रैव च निवत्स्यति ।\nततो वै भविता मोक्ष इति सत्यं ब्रवीमि वः॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000825068, "chapter_id": 20825, "verse_number": "६-१६८-६९", "content_sanskrit": "महादेव उवाच ।\nततो विमुच्य देवेंद्रं ब्रह्महत्या सुरेश्वरि ।\nगतातिहृष्टो देवेशो ह्यभवद्देवशासनात्॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000825069, "chapter_id": 20825, "verse_number": "६-१६८-७०", "content_sanskrit": "एवं शक्रेण संप्राप्ता ब्रह्महत्या पुरा युगे ।\nअस्मिंस्तीर्थे तपस्तप्त्वा शुद्धात्मा त्रिदिवं ययौ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000825070, "chapter_id": 20825, "verse_number": "६-१६८-७१", "content_sanskrit": "अश्वमेधं ततः कृत्वा विपाप्मा समपद्यत ।\nइति साभ्रमती तीर्थे वार्त्रघ्नीयं नगात्मजे॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]