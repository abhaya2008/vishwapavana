[{"id": 7000599000, "chapter_id": 20599, "verse_number": "५-५८-१", "content_sanskrit": "शेष उवाच ।\nभरतं मूर्च्छितं दृष्ट्वा रघुनाथः सुदुःखितः ।\nप्रतीहारमुवाचेदं शत्रुघ्नं प्रापयाशु माम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000599001, "chapter_id": 20599, "verse_number": "५-५८-२", "content_sanskrit": "तद्वाक्यं प्रोक्तमाकर्ण्य क्षणाच्छत्रुघ्नमानयत् ।\nयत्र रामो निजभ्राता भरतेन सह स्थितः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000599002, "chapter_id": 20599, "verse_number": "५-५८-३", "content_sanskrit": "भरतं मूर्च्छितं दृष्ट्वा रघुनाथं च दुःखितम् ।\nप्रणम्य दुःखितोऽवोचत्किमिदं दारुणं महत्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000599003, "chapter_id": 20599, "verse_number": "५-५८-४", "content_sanskrit": "तदा रामोंऽत्यजप्रोक्तं वाक्यं लोकविगर्हितम् ।\nतं प्रत्युवाच रामोऽसौ शत्रुघ्नं पदसेवकम्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000599004, "chapter_id": 20599, "verse_number": "५-५८-५", "content_sanskrit": "अधोमुखो दीनरवो गद्गदाक्षरवेपथुः ।\nशृणु भ्रातर्वचो मेऽद्य कुरु तत्क्षिप्रमादरात्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000599005, "chapter_id": 20599, "verse_number": "५-५८-६", "content_sanskrit": "यथा स्याद्विमलाकीर्तिर्गंगेव पृथिवीं गता ।\nसीताया वाच्यमतुलं लोके श्रुत्वांत्यजोदितम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000599006, "chapter_id": 20599, "verse_number": "५-५८-७", "content_sanskrit": "हातुमिच्छामि देहं स्वमेनां वा जानकीं किल ।\nइति वाक्यं समाकर्ण्य रामस्य किल शत्रुहा॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000599007, "chapter_id": 20599, "verse_number": "५-५८-८", "content_sanskrit": "सवेपथुः पपातोर्व्यां दुःखितः परदारणः ।\nसंज्ञां प्राप्य मुहूर्तेन रघुनाथमवोचत॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000599008, "chapter_id": 20599, "verse_number": "५-५८-९", "content_sanskrit": "शत्रुघ्न उवाच ।\nकिमेतदुच्यते स्वामिञ्जानकीं प्रति दारुणम् ।\nपाखंडैर्दुष्टचित्तैश्च सर्वधर्मबहिष्कृतैः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000599009, "chapter_id": 20599, "verse_number": "५-५८-१०", "content_sanskrit": "निंदिता श्रुतिरग्राह्या भवति त्वग्र्यजन्मनाम् ।\nजाह्नवी सर्वलोकानां पापघ्नी दुरितापहा॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000599010, "chapter_id": 20599, "verse_number": "५-५८-११", "content_sanskrit": "निस्पृष्टा पापिभिः पुंभिः सा स्पर्शेनार्हिता सताम् ।\nसूर्यो जगत्प्रकाशाय समुदेति जगत्यहो॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000599011, "chapter_id": 20599, "verse_number": "५-५८-१२", "content_sanskrit": "उलूकानां रुचिकरो न भवेत्तत्र का क्षतिः ।\nतस्मात्त्वमेनां गृह्णीष्व मा त्यजानिंदितां स्त्रियम्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000599012, "chapter_id": 20599, "verse_number": "५-५८-१३", "content_sanskrit": "श्रीरामभद्रकृपया कुरुष्व वचनं मम ।\nएतच्छ्रुत्वा वचस्तस्य शत्रुघ्नस्य महात्मनः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000599013, "chapter_id": 20599, "verse_number": "५-५८-१४", "content_sanskrit": "पुनःपुनर्जगादेदं यदुक्तं भरतं प्रति ।\nतन्निशम्य वचो भ्रातुर्दुःखपूरपरिप्लुतः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000599014, "chapter_id": 20599, "verse_number": "५-५८-१५", "content_sanskrit": "पपात मूर्च्छितो भूमौ छिन्नमूल इव द्रुमः ।\nभ्रातरं पतितं वीक्ष्य शत्रुघ्नं दुःखितो भृशम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000599015, "chapter_id": 20599, "verse_number": "५-५८-१६", "content_sanskrit": "प्रतीहारमुवाचेदं लक्ष्मणं त्वानयांतिकम् ।\nस लक्ष्मणगृहं गत्वा न्यवेदयदिदं वचः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000599016, "chapter_id": 20599, "verse_number": "५-५८-१७", "content_sanskrit": "प्रतीहार उवाच ।\nस्वामिन्रामो भवंतं तु समाह्वयति वेगतः ।\nस तच्छ्रुत्वा समाह्वानं रामचंद्रेण वेगतः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000599017, "chapter_id": 20599, "verse_number": "५-५८-१८", "content_sanskrit": "जगाम तरसा तत्र यत्र स भ्रातृकोऽनघः ।\nभरतं मूर्च्छितं दृष्ट्वा शत्रुघ्नमपि मूर्च्छितम्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000599018, "chapter_id": 20599, "verse_number": "५-५८-१९", "content_sanskrit": "श्रीरामचंद्रं दुःखार्तं दुःखितो वाक्यमब्रवीत् ।\nकिमेतद्दारुणं राजन्दृश्यते मूर्च्छनादिकम्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000599019, "chapter_id": 20599, "verse_number": "५-५८-२०", "content_sanskrit": "तदाशु शंस मां सर्वं कारणं मुख्यतोऽनघ ।\nएवं वदंतं नृपतिर्वृत्तांतं सर्वमादितः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000599020, "chapter_id": 20599, "verse_number": "५-५८-२१", "content_sanskrit": "शशंस लक्ष्मणं क्षिप्रं दुःखपूरपरिप्लुतम् ।\nलक्ष्मणस्तद्वचः श्रुत्वा सीतायास्त्यागसंभवम्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000599021, "chapter_id": 20599, "verse_number": "५-५८-२२", "content_sanskrit": "निःश्वसन्मुहुरुच्छ्वासं स्तब्धगात्र इवाभवत् ।\nभ्रातरं स्तब्धगात्रं च कंपमानं मुहुर्मुहुः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000599022, "chapter_id": 20599, "verse_number": "५-५८-२३", "content_sanskrit": "न किंचन वदन्तं तं वीक्ष्य शोकार्दितोऽब्रवीत् ।\nकिं करिष्याम्यहं भूमौ स्थित्वा दुर्यशसांकितः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000599023, "chapter_id": 20599, "verse_number": "५-५८-२४", "content_sanskrit": "त्यजामीदं वपुः श्रीमल्लोकभीत्या च शोकवान् ।\nसर्वदा भ्रातरो मह्यं मद्वाक्यकरणोत्सुकाः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000599024, "chapter_id": 20599, "verse_number": "५-५८-२५", "content_sanskrit": "इदानीं तेपि दैवेन प्रतिकूलवचः कराः ।\nकुत्र गच्छामि कं यामि हसिष्यंति नृपा भुवि॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000599025, "chapter_id": 20599, "verse_number": "५-५८-२६", "content_sanskrit": "दुर्यशो लांछितं मां वै कुष्ठिनं रूपवन्नराः ।\nमनोर्वंशे पुरा भूपा जाता जाता गुणाधिकाः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000599026, "chapter_id": 20599, "verse_number": "५-५८-२७", "content_sanskrit": "इदानीं मयि जाते तु विपरीतं बभूव तत् ।\nइति संभाषमाणं तं रामभद्रं समीक्ष्य सः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000599027, "chapter_id": 20599, "verse_number": "५-५८-२८", "content_sanskrit": "संस्तभ्याश्रूणि विपुलान्युवाच विकल स्वरः ।\nस्वामिन्विषादं मा कार्षीः कथं तव मतिर्हृता॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000599028, "chapter_id": 20599, "verse_number": "५-५८-२९", "content_sanskrit": "सीतामनिंदितां को नु त्यजति श्रुतवान्भवान् ।\nआकारयामि रजकं परिपृच्छामि तं प्रति॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000599029, "chapter_id": 20599, "verse_number": "५-५८-३०", "content_sanskrit": "कथं त्वयानिंदिता सा जानकी योषितां वरा ।\nतव देशे बलात्कश्चिद्बाध्यते न जनोऽल्पकः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000599030, "chapter_id": 20599, "verse_number": "५-५८-३१", "content_sanskrit": "तस्मात्तस्य यथास्वांते प्रतीतिः स्यात्तथाचर ।\nकिमर्थं त्यज्यते भीरुः पतिव्रतपरायणा॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000599031, "chapter_id": 20599, "verse_number": "५-५८-३२", "content_sanskrit": "मनसा वचसा नान्यं जानाति जनकात्मजा ।\nतस्मादेनां गृहाण त्वमेतां मा त्यज जानकीम्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000599032, "chapter_id": 20599, "verse_number": "५-५८-३३", "content_sanskrit": "ममोपरि कृपां कृत्वा मदुक्तं संश्रयाशु तत् ।\nएवं वदंतं प्रत्यूचे रामः शोकेन कर्षितः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000599033, "chapter_id": 20599, "verse_number": "५-५८-३४", "content_sanskrit": "लक्ष्मणं धर्मवाक्येन बोधयंस्त्यजनोद्यमः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000599034, "chapter_id": 20599, "verse_number": "५-५८-३५", "content_sanskrit": "राम उवाच ।\nकथं तु मां ब्रवीषि त्वं मा त्यजैनामनिंदिताम् ।\nलोकापवादात्त्यक्ष्येऽहं जानन्नपि विपापिनीम्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000599035, "chapter_id": 20599, "verse_number": "५-५८-३६", "content_sanskrit": "स्वयशः कारणेऽहं स्वं देहं त्यक्ष्याम्यशोभनम् ।\nत्वामपि भ्रातरं त्यक्ष्ये लोकवादाद्विगर्हितम्॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000599036, "chapter_id": 20599, "verse_number": "५-५८-३७", "content_sanskrit": "किमुतान्ये गृहाः पुत्रा मित्राणि वसुशोभनम् ।\nस्वयशःकारणे सर्वं त्यजामि किमु मैथिलीम्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000599037, "chapter_id": 20599, "verse_number": "५-५८-३८", "content_sanskrit": "न तथा मे प्रियो भ्राता न कलत्रं न बांधवाः ।\nयथा मे विमलाकीर्तिर्वल्लभा लोकविश्रुता॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000599038, "chapter_id": 20599, "verse_number": "५-५८-३९", "content_sanskrit": "इदानीं रजको नैव प्रष्टव्यो भवति ध्रुवम् ।\nकालेन सर्वं भविता लोकचित्तस्य रंजनम्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000599039, "chapter_id": 20599, "verse_number": "५-५८-४०", "content_sanskrit": "आमयो यद्वदामस्तु न चिकित्स्यो भवेत्क्षितौ ।\nसकालेन परीपाकाद्भेषजादेव नश्यति॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000599040, "chapter_id": 20599, "verse_number": "५-५८-४१", "content_sanskrit": "तथा कालेन संभावि सांप्रतं मा विलंबय ।\nत्यजैनां विपिने साध्वीं मां वा खड्गेन घातय॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000599041, "chapter_id": 20599, "verse_number": "५-५८-४२", "content_sanskrit": "इत्युक्तं वाक्यमाकर्ण्य दुःखितोऽभूत्तदा महान् ।\nचिंतयामास च स्वांते लक्ष्मणः शोककर्षितः॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000599042, "chapter_id": 20599, "verse_number": "५-५८-४३", "content_sanskrit": "पित्राज्ञप्तो जामदग्न्यो मातरं चाप्यघातयत् ।\nगुरोराज्ञा नैव लंघ्या युक्ताऽयुक्तापि सर्वथा॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000599043, "chapter_id": 20599, "verse_number": "५-५८-४४", "content_sanskrit": "तस्मादेनां त्यजाम्येव रामस्य प्रियकाम्यया ।\nइति संचिंत्य मनसि भ्रातरं प्रत्युवाच सः॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000599044, "chapter_id": 20599, "verse_number": "५-५८-४५", "content_sanskrit": "लक्ष्मणौवाच ।\nअकृत्यमपि कार्यं वै गुर्वाज्ञां नैव लंघयेत् ।\nतस्मात्कुर्वे भवद्वाक्यं यत्त्वं वदसि सुव्रत॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000599045, "chapter_id": 20599, "verse_number": "५-५८-४६", "content_sanskrit": "इत्येवं भाषमाणं तं लक्ष्मणं प्रत्युवाच सः ।\nसाधुसाधु महाप्राज्ञ त्वया मे तोषितं मनः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000599046, "chapter_id": 20599, "verse_number": "५-५८-४७", "content_sanskrit": "अद्यैव रात्रौ जानक्या दोहदस्तापसी क्षणे ।\nतन्मिषेण रथे स्थाप्य मोचयैनां महावने॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000599047, "chapter_id": 20599, "verse_number": "५-५८-४८", "content_sanskrit": "इत्थं भाषितमाकर्ण्य विशुष्यद्वदनोऽभितः ।\nरुदन्बाष्पकलां मुंचञ्जगाम स्वं निवेशनम्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000599048, "chapter_id": 20599, "verse_number": "५-५८-४९", "content_sanskrit": "सुमंत्रं तु समाहूय वचनं तमथाब्रवीत् ।\nरथं मे कुरु सज्जं वै सदश्ववरभूषितम्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000599049, "chapter_id": 20599, "verse_number": "५-५८-५०", "content_sanskrit": "स तद्वाक्यं समाकर्ण्य रथमानीतवांस्तदा ।\nआनीतं तं रथं दृष्ट्वा लक्ष्मणः शोककर्षितः॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000599050, "chapter_id": 20599, "verse_number": "५-५८-५१", "content_sanskrit": "परमं दुःखमापन्नः संरुह्य स्यंदनं वरम् ।\nनिःश्वसञ्जानकीगेहं प्रतस्थे भ्रातृसेवकः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000599051, "chapter_id": 20599, "verse_number": "५-५८-५२", "content_sanskrit": "गत्वा चांतःपुरे भ्राता रामस्य मिथिलात्मजाम् ।\nप्रत्यूचे निःश्वसन्वाक्यं दुःखपूरपरिप्लुतः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000599052, "chapter_id": 20599, "verse_number": "५-५८-५३", "content_sanskrit": "मातर्जानकि रामेण प्रेषितो भवनं तव ।\nतापसीः प्रति याहि त्वं दोहदप्राप्तिहेतवे॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000599053, "chapter_id": 20599, "verse_number": "५-५८-५४", "content_sanskrit": "इति वाक्यं समाकर्ण्य लक्ष्मणस्य विदेहजा ।\nपरमं हर्षमापन्ना लक्ष्मणं प्रत्यभाषत॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000599054, "chapter_id": 20599, "verse_number": "५-५८-५५", "content_sanskrit": "जानक्युवाच ।\nधन्याहं मैथिली राज्ञी रामस्य चरणस्मरा ।\nयस्या दोहदपूर्त्यर्थं प्रेषयामास लक्ष्मणम्॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000599055, "chapter_id": 20599, "verse_number": "५-५८-५६", "content_sanskrit": "अद्याहं ता वनचरीस्तापसीः पतिदेवताः ।\nनमस्कुर्यां च वासोभिः पूजयामि मनोहराः॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000599056, "chapter_id": 20599, "verse_number": "५-५८-५७", "content_sanskrit": "इत्युक्त्वा रम्यवस्त्राणि महार्हाभरणानि च ।\nमणीन्विमलमुक्ताश्च कर्पूरादिसुगंधिमत्॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000599057, "chapter_id": 20599, "verse_number": "५-५८-५८", "content_sanskrit": "चंदनादिकवस्तूनि विचित्राणि सहस्रधा ।\nजग्राह रघुनाथस्य पत्नी स्वप्रियकाम्यया॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000599058, "chapter_id": 20599, "verse_number": "५-५८-५९", "content_sanskrit": "सीता गृहीत्वा सर्वाणि दासीनां करयोर्मुहुः ।\nलक्ष्मणं प्रतिगच्छंती देहल्यां चास्खलत्तदा॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000599059, "chapter_id": 20599, "verse_number": "५-५८-६०", "content_sanskrit": "अविचार्य तदौत्सुक्याल्लक्ष्मणं प्रियकारिणम् ।\nउवाच कुत्र सरथो येन मां प्रापयिष्यसि॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000599060, "chapter_id": 20599, "verse_number": "५-५८-६१", "content_sanskrit": "स निःश्वसन्रथं हैमं जानक्या सह निर्विशत् ।\nसुमंत्रं प्रत्युवाचासौ चालयाश्वान्मनोजवान्॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000599061, "chapter_id": 20599, "verse_number": "५-५८-६२", "content_sanskrit": "स सुयुक्तं रथं वाक्याल्लक्ष्मणस्य तु चाह्वयत् ।\nअश्रुपूर्णमुखं पश्यंल्लक्ष्मणं स मुहुर्मुहुः॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000599062, "chapter_id": 20599, "verse_number": "५-५८-६३", "content_sanskrit": "आहतास्तेन कशया वाहास्तस्यापतन्पथि ।\nन चलंति यदा वाहास्तदा लक्ष्मणमब्रवीत्॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000599063, "chapter_id": 20599, "verse_number": "५-५८-६४", "content_sanskrit": "सुमंत्र उवाच ।\nस्वामिंश्चलंति नो वाहा यत्नेन परिचालिताः ।\nकिं करोमि न जानेऽत्र कारणं वाहपातने॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000599064, "chapter_id": 20599, "verse_number": "५-५८-६५", "content_sanskrit": "एवं ब्रुवंतं प्रत्यूचे लक्ष्मणो गद्गदस्वरः ।\nसारथिं धैर्यमास्थाय ताडयैतान्कशादिभिः॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000599065, "chapter_id": 20599, "verse_number": "५-५८-६६", "content_sanskrit": "एतच्छ्रुत्वोदितं यंता कथंचित्समचालयत् ।\nतदा स्फुरद्दक्षनेत्रं जानक्या दुःखशंसकम्॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000599066, "chapter_id": 20599, "verse_number": "५-५८-६७", "content_sanskrit": "तदैव हृदये शोकः समभूद्दुःखशंसकः ।\nतदैव पक्षिणः पुण्याः कुर्वंति परिवर्तनम्॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000599067, "chapter_id": 20599, "verse_number": "५-५८-६८", "content_sanskrit": "एवं वीक्ष्यैव वैदेही प्रत्युवाचाथ देवरम् ।\nकथं मे तापसीक्षायै यातुमिच्छा रघूद्वह॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000599068, "chapter_id": 20599, "verse_number": "५-५८-६९", "content_sanskrit": "रामे भूयाद्धि कल्याणं भरते वा तथानुजे ।\nतत्प्रजासु च सर्वत्र मा भवंतु विपर्ययाः॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000599069, "chapter_id": 20599, "verse_number": "५-५८-७०", "content_sanskrit": "एवं ब्रुवंतीं संवीक्ष्य जानकीं च स लक्ष्मणः ।\nन किंचिदुक्तवान्रुद्ध कंठो बाष्पप्रपूरितः॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000599070, "chapter_id": 20599, "verse_number": "५-५८-७१", "content_sanskrit": "सा गच्छंती मृगान्वामं परिवर्तनकारकान् ।\nअपश्यद्दुःखसंघातकारकान्समभाषत॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000599071, "chapter_id": 20599, "verse_number": "५-५८-७२", "content_sanskrit": "अद्य यन्मे मृगा वामं वर्तयंति तदिष्यते ।\nश्रीरामचरणौ मुक्त्वा गच्छंत्यायुक्तमेव तत्॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000599072, "chapter_id": 20599, "verse_number": "५-५८-७३", "content_sanskrit": "महिलानां परोधर्मः स्वभर्तृचरणार्चनम् ।\nतन्मुक्त्वान्यत्र यांत्या मे यद्भवेद्युक्तमेव तत्॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000599073, "chapter_id": 20599, "verse_number": "५-५८-७४", "content_sanskrit": "एवं पथि विचारं तु कुर्वंत्या परमार्थतः ।\nजाह्नवी ददृशे देव्या मुनिवृंदैकसेविता॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000599074, "chapter_id": 20599, "verse_number": "५-५८-७५", "content_sanskrit": "यस्यां जलस्य कल्लोला दृश्यंते दुग्धसंनिभाः ।\nतरंगो दृश्यते यत्र स्वर्गसोपानमूर्तिभृत्॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000599075, "chapter_id": 20599, "verse_number": "५-५८-७६", "content_sanskrit": "यस्या वारिकणस्पर्शान्महापातकसंचयः ।\nपलायते न कुत्रापि स्थानमीक्षन्समंततः॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000599076, "chapter_id": 20599, "verse_number": "५-५८-७७", "content_sanskrit": "गंगां प्राप्याथ सौमित्रिर्जानकीं स्यंदने स्थिताम् ।\nउवाच निर्गलद्बाष्प एहि सीते रथाद्भुवि॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000599077, "chapter_id": 20599, "verse_number": "५-५८-७८", "content_sanskrit": "सीता तद्वाक्यमाकर्ण्य क्षणादवततार सा ।\nलक्ष्मणेन धृता बाहौ स्खलंती पथि कंटकैः॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]