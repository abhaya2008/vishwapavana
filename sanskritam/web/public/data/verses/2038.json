[{"id": 2046779, "chapter_id": 2038, "verse_number": "६-८७-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2046780, "chapter_id": 2038, "verse_number": "६-८७-१", "content_sanskrit": "परिणाम्य निशां तां तु सुखसुप्ता जनेश्वराः।\nकुरवः पाण्डवाश्चैव पुनर्युद्धाय निर्ययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2046781, "chapter_id": 2038, "verse_number": "६-८७-२", "content_sanskrit": "ततः शब्दो महानासीत्सेनयोरुभयोर्नृप ।\nनिर्गच्छमानयोः सङ्ख्ये यथा सागरयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2046782, "chapter_id": 2038, "verse_number": "६-८७-३", "content_sanskrit": "ततो दुर्योधनो राजा चित्रसेनो विविंशतिः।\nभीष्मश्च रथिनां श्रेष्ठो भारद्वाजश्च वै द्विजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2046783, "chapter_id": 2038, "verse_number": "६-८७-४", "content_sanskrit": "एकीभूताः सुसंयत्ताः कौरवाणां महाचमूम् ।\nव्यूहाय विदधू राजन्पाण्डवान्प्रतिदंशितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2046784, "chapter_id": 2038, "verse_number": "६-८७-५", "content_sanskrit": "कूर्मव्यूहं ततः कृत्वा पिता तव विशांपते ।\nसागरप्रतिमं घोरं वाहनोर्मितरङ्गिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2046785, "chapter_id": 2038, "verse_number": "६-८७-६", "content_sanskrit": "अग्रतः सर्वसैन्यानां भीष्मः शान्तनवो ययौ ।\nमालवैर्दाक्षिणात्यैश्च आवन्त्यैश्च समन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2046786, "chapter_id": 2038, "verse_number": "६-८७-७", "content_sanskrit": "ततोऽनन्तरमेवासीद्भारद्वाजः प्रतापवान ।\nपुलिन्दैः पारदैश्चैव तथा क्षुद्रकमालवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2046787, "chapter_id": 2038, "verse_number": "६-८७-८", "content_sanskrit": "द्रोणादनन्तरं यत्तो भगदत्तः प्रतापवान् ।\nमगधैश्च कलिङ्गैश्च पिशाचैश्च विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2046788, "chapter_id": 2038, "verse_number": "६-८७-९", "content_sanskrit": "प्राग्ज्योतिषादनु नृपः कौसल्योऽथ बृहद्बलः ।\nमेकलैः कुरुविन्दैश्च त्रैपुरैश्च समन्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2046789, "chapter_id": 2038, "verse_number": "६-८७-१०", "content_sanskrit": "बृहद्बलादनु नृपस्त्रिगर्तः प्रस्थलाधिपः।\nकाम्भोजैर्बहुभिः सार्धं यवनैश्च सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2046790, "chapter_id": 2038, "verse_number": "६-८७-११", "content_sanskrit": "द्रौणिस्तु रभसः शूरस्त्रैगर्तादनु भारत।\nप्रययौ सिंहनादेन नादयानो धरातलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2046791, "chapter_id": 2038, "verse_number": "६-८७-१२", "content_sanskrit": "तथा सर्वेण सैन्येन राजा दुर्योधनस्तदा।\nद्रौणेरनन्तरं प्रायात्सोदर्यैः परिवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2046792, "chapter_id": 2038, "verse_number": "६-८७-१३", "content_sanskrit": "दुर्योधनादनु ततः कृपः शारद्वतो ययौ।\nएवमेष महाव्यूहः प्रययौ सागरोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2046793, "chapter_id": 2038, "verse_number": "६-८७-१४", "content_sanskrit": "रेजुस्तत्र पताकाश्च श्वेतच्छत्राणि भारत ।\nअङ्गदान्यत्र चित्राणि महार्हाणि धनूंषि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2046794, "chapter_id": 2038, "verse_number": "६-८७-१५", "content_sanskrit": "तं तु दृष्ट्वा महाव्यूहं तावकानां महारथः ।\nयुधिष्ठिरोऽब्रवीत्तूर्णं पार्षतं पृतनापतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2046795, "chapter_id": 2038, "verse_number": "६-८७-१६", "content_sanskrit": "पश्य व्यूहं महेष्वास निर्मितं सागरोपमम् ।\nप्रतिव्यूहं रणे शूर कुरु क्षिप्रं महारथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2046796, "chapter_id": 2038, "verse_number": "६-८७-१७", "content_sanskrit": "ततः स पार्षतः क्रूरो व्यूहं चक्रे सुदारुणम् ।\nश्रृङ्गाटकं महाराज परव्यूहविनाशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2046797, "chapter_id": 2038, "verse_number": "६-८७-१८", "content_sanskrit": "श्रृङ्गाभ्यां भीमसेनश्च सात्यकिश्च महारथः ।\nरथैरनेकसाहस्रैस्तथा हयपदातिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2046798, "chapter_id": 2038, "verse_number": "६-८७-१९", "content_sanskrit": "नाभावभून्नरश्रेष्ठः श्वेताश्वः कृष्णसारथिः ।\nमध्ये युधिष्ठिरो राजा माद्रीपुत्रौ च पाण्डवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2046799, "chapter_id": 2038, "verse_number": "६-८७-२०", "content_sanskrit": "अथेतरे महेष्वासाः सहसैन्या नराधिपाः ।\nव्यूहं तं पूरयामासुर्व्यूहशास्त्रविशारदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2046800, "chapter_id": 2038, "verse_number": "६-८७-२१", "content_sanskrit": "एवमेतं महाव्यूहं व्यूह्य भारत पाण्डवाः ।\nअतिष्ठन्समरे शूरा योद्धुकामा जयैषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2046801, "chapter_id": 2038, "verse_number": "६-८७-२२", "content_sanskrit": "भेरीशब्दैश्च विमलैर्विमिश्रैः शङ्खनिःस्वनैः ।\nक्ष्वेडितास्फोटितोत्क्रुष्टैर्नादिताः सर्वतो दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2046802, "chapter_id": 2038, "verse_number": "६-८७-२३", "content_sanskrit": "ततः शूराः समासाद्य समरे ते परस्परम।\nनेत्रैरनिमिषै राजन्नवैक्षन्त परस्परम् ॥ ६-८७-२४a`मनोभिस्ते मनुष्येन्द्र युद्धं योधाः प्रचक्रिरे ।\nपुनराहूय तेऽन्योन्यं शरीरैरपि चक्रिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2046803, "chapter_id": 2038, "verse_number": "६-८७-२५", "content_sanskrit": "ततः प्रववृते युद्धं घोररूपं भयावहम् ।\nतावकानां परेषां च निघ्नतामितरेतरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2046804, "chapter_id": 2038, "verse_number": "६-८७-२६", "content_sanskrit": "नाराचा निशिताः सङ्ख्ये संपतन्ति स्म भारत ।\nव्यात्तानना भयकरा उरगा इव सङ्घशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2046805, "chapter_id": 2038, "verse_number": "६-८७-२७", "content_sanskrit": "निष्पेतुर्विमलाः शक्त्यस्तैलधौताः सुतेजनाः ।\nअम्बुदेभ्यो यथा राजन्भ्राजमानाः शतह्रदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2046806, "chapter_id": 2038, "verse_number": "६-८७-२८", "content_sanskrit": "गदाश्च विमलैः पट्टैः पिनद्धाः स्वर्णभूषिताः।\nपतन्त्यस्तत्र दृस्यन्ते गिरिशृङ्गोपमाः शुभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2046807, "chapter_id": 2038, "verse_number": "६-८७-२९", "content_sanskrit": "निस्त्रिंशाश्च व्यदृश्यन्त विमलाम्बरसन्निभाः ।\nआर्षभाणि च चर्माणि शतचन्द्राणि भारतत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2046808, "chapter_id": 2038, "verse_number": "६-८७-३०", "content_sanskrit": "अशोभन्त रणे राजन्पात्यमानानि सर्वशः ।\nतेऽन्योन्यं समरे सेने युध्यमाने नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2046809, "chapter_id": 2038, "verse_number": "६-८७-३१", "content_sanskrit": "अशोभेतां यथा देवदैत्यसेने समुद्यते।\nअभ्यद्रवन्त समरे तेऽन्योन्यं वै समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2046810, "chapter_id": 2038, "verse_number": "६-८७-३२", "content_sanskrit": "रथास्तु रथिभिस्तूर्णं प्रेषिताः परमाहवे।\nयुगैर्युगानि संश्लिष्य युयुधुः पार्थिवर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2046811, "chapter_id": 2038, "verse_number": "६-८७-३३", "content_sanskrit": "दन्तिनां युध्यमानानां संघर्षात्पावकोऽभवत् ।\nदन्तेषु भरतश्रेष्ठ सधूमः सर्वतो दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2046812, "chapter_id": 2038, "verse_number": "६-८७-३४", "content_sanskrit": "प्रासैरभिहताः केचिद्गजयोधाः समन्ततः ।\nपतमानाः स्म दृश्यन्ते गिरिशृङ्गान्नगा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2046813, "chapter_id": 2038, "verse_number": "६-८७-३५", "content_sanskrit": "पादाताश्चाप्यदृश्यन्त निघ्नन्तोऽथ परस्परम् ।\nचित्ररूपधराः शूरा नखरप्रासयोधिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2046814, "chapter_id": 2038, "verse_number": "६-८७-३६", "content_sanskrit": "अन्योन्यं ते समासाद्य कुरुपाण्डवसैनिकाः ।\nअस्त्रैर्नानाविधैर्घोरै रणे निन्युर्यमक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2046815, "chapter_id": 2038, "verse_number": "६-८७-३७", "content_sanskrit": "ततः शान्तनवो भीष्मो रथघोषेण नादयन् ।\nअभ्यागमद्रणे पार्थान्धनुःशब्देन मोहयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2046816, "chapter_id": 2038, "verse_number": "६-८७-३८", "content_sanskrit": "पाण्डवानां रथाश्चापि नदन्तो भैरवं स्वनम् ।\nअभ्यद्रवन्त संयत्ता धृष्टद्युम्नपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2046817, "chapter_id": 2038, "verse_number": "६-८७-३९", "content_sanskrit": "ततः प्रववृते युद्धं तव तेषां च भारत।\nनराश्वरथनागानां व्यतिषक्तं परस्परम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2046818, "chapter_id": 2038, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि अष्टमदिवसयुद्धे सप्ताशीतितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]