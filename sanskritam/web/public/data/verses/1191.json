[{"id": 2009693, "chapter_id": 1191, "verse_number": "१-१९२-०x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2009694, "chapter_id": 1191, "verse_number": "१-१९२-१", "content_sanskrit": "ऋष्योस्तु यत्कृते वैरं विश्वामित्रवसिष्ठयोः।\nबभूव गन्धर्वपते शंस तत्सर्वमेव मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2009695, "chapter_id": 1191, "verse_number": "१-१९२-२", "content_sanskrit": "माहात्म्यं च वसिष्ठस्य ब्राह्मण्यं ब्रह्मतेजसः।\nविश्वामित्रस्य च तथा क्षत्रस्य च महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2009696, "chapter_id": 1191, "verse_number": "१-१९२-३", "content_sanskrit": "न शृण्वानस्त्वहं तृप्तिमुपगच्छामि खेचर।\nआख्याहि गन्धर्वपते शंस तत्सर्वमेव मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2009697, "chapter_id": 1191, "verse_number": "१-१९२-४", "content_sanskrit": "माहात्म्यं च वसिष्ठस्य विश्वामित्रस्य भाषते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2009698, "chapter_id": 1191, "verse_number": "१-१९२-५x", "content_sanskrit": "गन्धर्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2009699, "chapter_id": 1191, "verse_number": "१-१९२-५", "content_sanskrit": "इदं वासिष्ठमाख्यानं पुराणं पुण्यमुत्तमम्।\nपार्थ सर्वेषु लोकेषु विश्रुतं तन्निबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2009700, "chapter_id": 1191, "verse_number": "१-१९२-६", "content_sanskrit": "कल्माषपाद इत्येवं लोके राजा बभूव ह।\nइक्ष्वाकुवंशजः पार्थ तेजसाऽसदृशो भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2009701, "chapter_id": 1191, "verse_number": "१-१९२-७", "content_sanskrit": "स कदाचिद्वनं राजा मृगयां निर्ययौ पुरात्।\nमृगान्विध्यन्वराहांश्च चचार रिपुमर्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2009702, "chapter_id": 1191, "verse_number": "१-१९२-८", "content_sanskrit": "तस्मिन्वने महाघोरे खङ्गांश्च बहुशोऽहनत्।\nहत्वा च सुचिरं श्रान्तो राजा निववृते ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2009703, "chapter_id": 1191, "verse_number": "१-१९२-९", "content_sanskrit": "अकामयत्तं याज्यार्थे विश्वामित्रः प्रतापवान्।\nस तु राजा महात्मानं वासिष्ठमृषिसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2009704, "chapter_id": 1191, "verse_number": "१-१९२-१०", "content_sanskrit": "तृषार्तश्च क्षुधार्तश्च एकायनगतः पथि।\nअपश्यदजितः सङ्ख्ये मुनिं प्रतिमुखागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2009705, "chapter_id": 1191, "verse_number": "१-१९२-११", "content_sanskrit": "शक्तिं नाम महाभागं वसिष्ठकुलवर्धनम्।\nज्येष्ठं पुत्रं पुत्रशताद्वसिष्ठस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2009706, "chapter_id": 1191, "verse_number": "१-१९२-१२", "content_sanskrit": "अपगच्छ पथोऽस्माकमित्येवं पार्थिवोऽब्रवीत्।\nतथा ऋषिरुवाचैनं सान्त्वयञ्श्लक्ष्णया गिरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2009707, "chapter_id": 1191, "verse_number": "१-१९२-१३", "content_sanskrit": "मम पन्था महाराज धर्म एष सनातनः।\nवृद्धभीरुनृपस्नातस्त्रीरोगिवरचक्रिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2009708, "chapter_id": 1191, "verse_number": "१-१९२-१४", "content_sanskrit": "पन्था देयो नृपैस्तेषामन्यैस्तैस्तस्य भूपतेः।\nराज्ञा सर्वेषा धर्मेषु देयः पन्था द्विजातये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2009709, "chapter_id": 1191, "verse_number": "१-१९२-१५", "content_sanskrit": "एवं परस्परं तौ तु पथोऽर्थं वाक्यमूचतुः।\nअपसर्पापसर्पेति वागुत्तरमकुर्वताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2009710, "chapter_id": 1191, "verse_number": "१-१९२-१६", "content_sanskrit": "ऋषिस्तु नापचक्राम तस्मिन्धर्मपथे स्थितः।\nअपि राजा मुनेर्मार्गात्क्रोधान्नापजगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2009711, "chapter_id": 1191, "verse_number": "१-१९२-१७", "content_sanskrit": "अमुञ्चन्तं तु पन्थानं तमृषिं नृपसत्तमः।\nजगाम कशया मोहात्तदा राक्षसन्मुनिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2009712, "chapter_id": 1191, "verse_number": "१-१९२-१८", "content_sanskrit": "कशाप्रहाराभिहतस्ततः स मुनिसत्तमः।\nतं शशाप नृपश्रेष्ठं वासिष्ठः क्रोधमूर्च्छितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2009713, "chapter_id": 1191, "verse_number": "१-१९२-१९", "content_sanskrit": "हंसि राक्षसवद्यस्माद्राजापशद तापसम्।\nतस्मात्त्वमद्यप्रभृति पुरुषादो भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2009714, "chapter_id": 1191, "verse_number": "१-१९२-२०", "content_sanskrit": "मनुष्यपिशिते सक्तश्चरिष्यसि महीमिमाम्।\nगच्छ राजाधमेत्युक्तः शक्तिना वीर्यशक्तिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2009715, "chapter_id": 1191, "verse_number": "१-१९२-२१", "content_sanskrit": "ततो याज्यनिमित्तं तु विश्वामित्रवसिष्ठयोः।\nवैरमासीत्तदा तं तु विश्वामित्रोऽन्वपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2009716, "chapter_id": 1191, "verse_number": "१-१९२-२२", "content_sanskrit": "तयोर्विवदतोरेवं समीपमुपचक्रमे।\nऋषिरुग्रतपाः पार्थ विश्वामित्रः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2009717, "chapter_id": 1191, "verse_number": "१-१९२-२३", "content_sanskrit": "ततः स बुबुधे पश्चात्तमृषिं नृपसत्तमः।\nऋषेः पुत्रं वसिष्ठस्य वसिष्ठमिव तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2009718, "chapter_id": 1191, "verse_number": "१-१९२-२४", "content_sanskrit": "अन्तर्धाय ततोऽत्मानं विश्वामित्रोऽपि भारत।\nतावुभावतिचक्राम चिकीर्षन्नात्मनः प्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2009719, "chapter_id": 1191, "verse_number": "१-१९२-२५", "content_sanskrit": "स तु शप्तस्तदा तेन शक्तिना वै नृपोत्तमः।\nजगाम शरणं शक्तिं प्रसादयितुमर्हयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2009720, "chapter_id": 1191, "verse_number": "१-१९२-२६", "content_sanskrit": "तस्य भावं विदित्वा स नृपतेः कुरुसत्तम।\nविश्वामित्रस्ततो रक्ष आदिदेश नृपं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2009721, "chapter_id": 1191, "verse_number": "१-१९२-२७", "content_sanskrit": "शापात्तस्य तु विप्रर्षेर्विश्वामित्रस्य चाज्ञया।\nराक्षसः किङ्करो नाम विवेश नृपतिं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2009722, "chapter_id": 1191, "verse_number": "१-१९२-२८", "content_sanskrit": "रक्षसा तं गृहीतं तु विदित्वा मुनिसत्तमः।\nविश्वामित्रोऽप्यपाक्रामत्तस्माद्देशादरिन्दम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2009723, "chapter_id": 1191, "verse_number": "१-१९२-२९", "content_sanskrit": "ततः स नृपतिर्विद्वान्रक्षन्नात्मानमात्मना।\nबलवत्पीड्यमानोऽपि रक्षसान्तर्गतेन ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2009724, "chapter_id": 1191, "verse_number": "१-१९२-३०", "content_sanskrit": "ददर्शाथ द्विजः कश्चिद्राजानं प्रस्थितं वनम्।\nअयाचत क्षुधापन्नः समांसं भोजनं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2009725, "chapter_id": 1191, "verse_number": "१-१९२-३१", "content_sanskrit": "तमुवाचाथ राजर्षिर्द्विजं मित्रसहस्तदा।\nआस्स्व ब्रह्मंस्त्वमत्रैव मुहूर्तं प्रतिपालयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2009726, "chapter_id": 1191, "verse_number": "१-१९२-३२", "content_sanskrit": "निवृत्तः प्रतिदास्यामि भोजनं ते यथेप्सितम्।\nइत्युक्त्वा प्रययौ राजा तस्थौ च द्विजसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2009727, "chapter_id": 1191, "verse_number": "१-१९२-३३", "content_sanskrit": "ततो राजा परिक्रम्य यथाकामं यथासुखम्।\nनिवृत्तोऽन्तःपुरं पार्थ प्रविवेश महामनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2009728, "chapter_id": 1191, "verse_number": "१-१९२-३४", "content_sanskrit": "अन्तर्गतस्तदा राजा श्रुत्वा ब्राह्मणभाषितम्।\nसोऽन्तःपुरं प्रविश्याथ न सस्मार नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2009729, "chapter_id": 1191, "verse_number": "१-१९२-३५", "content_sanskrit": "ततोऽर्धरात्र उत्थाय सूदमानाय्य सत्वरम्।\nउवाच राजा संस्मृत्य ब्राह्मणस्य प्रतिश्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2009730, "chapter_id": 1191, "verse_number": "१-१९२-३६", "content_sanskrit": "गच्छामुष्मिन्वनोद्देशे ब्राह्मणो मां प्रतीक्षते।\nअन्नार्थी तं त्वमन्नेन समांसेनोपपादय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2009731, "chapter_id": 1191, "verse_number": "१-१९२-३७x", "content_sanskrit": "गन्धर्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2009732, "chapter_id": 1191, "verse_number": "१-१९२-३७", "content_sanskrit": "एवमुक्तस्ततः सूदः सोऽनासाद्यामिषं क्वचित्।\nनिवेदयामास तदा तस्मै राज्ञे व्यथान्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2009733, "chapter_id": 1191, "verse_number": "१-१९२-३८", "content_sanskrit": "राजा तु रक्षसाविष्टः सूदमाह गतव्यथः।\nअप्येनं नरमांसेन भोजयेति पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2009734, "chapter_id": 1191, "verse_number": "१-१९२-३९", "content_sanskrit": "तथेत्युक्त्वा ततः सूदः संस्थानं वध्यघातिनाम्।\nगत्वाऽऽजहार त्वरितो नरमांसमपेतभीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2009735, "chapter_id": 1191, "verse_number": "१-१९२-४०", "content_sanskrit": "एतत्संस्कृत्य विधिवदन्नोपहितमाशु वै।\nतस्मै प्रादाद्ब्राह्मणाय क्षुधिताय तपस्विने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2009736, "chapter_id": 1191, "verse_number": "१-१९२-४१", "content_sanskrit": "स सिद्धचक्षुषा दृष्ट्वा तदन्नं द्विजसत्तमः।\nअभोज्यमिदमित्याह क्रोधपर्याकुलेक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2009737, "chapter_id": 1191, "verse_number": "१-१९२-४२x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2009738, "chapter_id": 1191, "verse_number": "१-१९२-४२", "content_sanskrit": "यस्मादभोज्यमन्नं मे ददाति स नृपाधमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2009739, "chapter_id": 1191, "verse_number": "१-१९२-४३", "content_sanskrit": "सक्तो मानुषमांसेषु यथोक्तः शक्तिना पुरा।\nउद्वेजनीयो भूतानां चरिष्यति महीमिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2009740, "chapter_id": 1191, "verse_number": "१-१९२-४४x", "content_sanskrit": "गन्धर्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2009741, "chapter_id": 1191, "verse_number": "१-१९२-४४", "content_sanskrit": "द्विरनुव्याहृते राज्ञः स शापो बलवानभूत्।\nरक्षोबलसमाविष्टो विसंज्ञश्चाभवन्नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2009742, "chapter_id": 1191, "verse_number": "१-१९२-४५", "content_sanskrit": "ततः स नृपतिश्रेष्ठो रक्षसापहृतेन्द्रियः।\nउवाच शख्तिं तं दृष्ट्वा न चिरादिव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2009743, "chapter_id": 1191, "verse_number": "१-१९२-४६", "content_sanskrit": "यस्मादसदृशः शापः प्रयुक्तोऽयं मयि त्वया।\nतस्मात्त्वत्तः प्रवर्तिष्ये खादितुं पुरुषानहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2009744, "chapter_id": 1191, "verse_number": "१-१९२-४७", "content_sanskrit": "एवमुक्त्वा ततः सद्यस्तं प्राणैर्विप्रयोज्य च।\nशक्तिं तं भक्षयामास व्याघ्रः पशुमिवेप्सितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2009745, "chapter_id": 1191, "verse_number": "१-१९२-४८", "content_sanskrit": "शक्तिनं तु मृतं दृष्ट्वा विश्वामित्रः पुनःपुनः।\nवसिष्ठस्यैव पुत्रेषु तद्रक्षः संदिदेश ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2009746, "chapter_id": 1191, "verse_number": "१-१९२-४९", "content_sanskrit": "स ताञ्शक्त्यवरान्पुत्रान्वसिष्ठस्य महात्मनः।\nभक्षयामास संक्रुद्धः सिंहः क्षुद्रमृगानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2009747, "chapter_id": 1191, "verse_number": "१-१९२-५०", "content_sanskrit": "वसिष्ठो घातिताञ्श्रुत्वा विश्वामित्रेण तान्सुतान्।\nधारयामास तं शोकं महाद्रिरिव मेदिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2009748, "chapter_id": 1191, "verse_number": "१-१९२-५१", "content_sanskrit": "चक्रे चात्मविनाशाय बुद्धिं स मुनिसत्तमः।\nन त्वेव कौशिकोच्छेदं मेने मतिमतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2009749, "chapter_id": 1191, "verse_number": "१-१९२-५२", "content_sanskrit": "स मेरुकूटादात्मानं मुमोच भगवानृषिः।\nगिरेस्तस्य शिलायां तु तूलराशाविवापतत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2009750, "chapter_id": 1191, "verse_number": "१-१९२-५३", "content_sanskrit": "न ममार च पातेन स यदा तेन पाण्डव।\nतदाग्निमिद्धं भगवान्संविवेश महावने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2009751, "chapter_id": 1191, "verse_number": "१-१९२-५४", "content_sanskrit": "तं तदा सुसमिद्धोऽपि न ददाह हुताशनः।\nदीप्यमानोऽप्यमित्रघ्न शीतोऽग्निरभवत्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2009752, "chapter_id": 1191, "verse_number": "१-१९२-५५", "content_sanskrit": "स समुद्रमभिप्रेक्ष्य शोकाविष्टो महामुनिः।\nबद्ध्वा कण्ठे शिलां गुर्वीं निपपात तदाम्भसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2009753, "chapter_id": 1191, "verse_number": "१-१९२-५६", "content_sanskrit": "स समुद्रोर्मिवेगेन स्थले न्यस्तो महामुनिः।\nन ममार यदा विप्रः कथंचित्संशितव्रतः।\nजगाम स ततः खिन्नः पुनरेवाश्रमं प्रति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2009754, "chapter_id": 1191, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि चैत्ररथपर्वणि द्विनवत्यधिकशततमोऽध्यायः॥ १९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]