[{"id": 7004254000, "chapter_id": 24254, "verse_number": "५-२-३२-१", "content_sanskrit": "ईश्वर उवाच ।\nत्रिषु लोकेषु विख्यातं द्वात्रिंशत्तममुत्तमम् ।\nविद्धि सिद्धिप्रदं पुंसां पत्तनेश्वरमीश्वरम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004254001, "chapter_id": 24254, "verse_number": "५-२-३२-२", "content_sanskrit": "पुराऽहं पर्वते देवि मंदरे चारुकन्दर् ।\nक्रीडन्सार्द्धं त्वया पृष्टः कदाचिद्रहसि स्थितः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004254002, "chapter_id": 24254, "verse_number": "५-२-३२-३", "content_sanskrit": "किमर्थं पर्वतं त्यक्त्वा कैलासं रमणीयकम् ।\nमुक्ता फलशिलाशुभ्रं शङ्खचन्द्रांशुनिर्मलम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004254003, "chapter_id": 24254, "verse_number": "५-२-३२-४", "content_sanskrit": "सिद्धचारणगन्धर्वकिंनरोद्गीतनादितम् ।\nसदा पुष्पद्रुमच्छन्नं कदलीवनराजितम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004254004, "chapter_id": 24254, "verse_number": "५-२-३२-५", "content_sanskrit": "अथ कोकिलचक्राह्वचकोरकुरराकुलम् ।\nपुऽण्यलोकोपमं स्थानं त्रिविष्टपविभूषणम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004254005, "chapter_id": 24254, "verse_number": "५-२-३२-६", "content_sanskrit": "महाकालवने शून्ये नानागुल्मलतावृते ।\nगजेंद्रगजशार्दूल सिंहशम्बरसंकुले॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004254006, "chapter_id": 24254, "verse_number": "५-२-३२-७", "content_sanskrit": "ऋक्षवानरगोमायुजन्तुकादिविराजिते ।\nमयूरसर्पमार्जारमूषिकादिविराजिते॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004254007, "chapter_id": 24254, "verse_number": "५-२-३२-८", "content_sanskrit": "कथं वासः कृतो देव कौतूहलमिदं मम॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004254008, "chapter_id": 24254, "verse_number": "५-२-३२-९", "content_sanskrit": "इति पृष्टस्त्वया देवि मंदरे चारुकन्दरे ।\nमया प्रोक्तं प्रसन्नेन पत्तनं च मम प्रिये॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004254009, "chapter_id": 24254, "verse_number": "५-२-३२-१०", "content_sanskrit": "महाकालवनं रम्यं स्वर्गात्सुखकरं परम् ।\nस्मशानपीठसत्क्षेत्रवनोपरसमाश्रितम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004254010, "chapter_id": 24254, "verse_number": "५-२-३२-११", "content_sanskrit": "अनौपम्यगुणं विद्धि पत्तनं पर्वतात्मजे ।\nएवं पत्तनदेवो वै न दृष्टो भुवनत्रये ।\nगीतवादित्रचातुर्यैः स्पर्द्धते यः सुरालयम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004254011, "chapter_id": 24254, "verse_number": "५-२-३२-१२", "content_sanskrit": "एतस्मिन्नंतरे देवि देवर्षिर्नारदो मुनिः ।\nद्रष्टुकामः समायातो मन्दरे मां यशस्विनि॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004254012, "chapter_id": 24254, "verse_number": "५-२-३२-१३", "content_sanskrit": "विनोदार्थं मया पृष्टस्त्वत्प्रियार्थं कुतूहलात् ।\nक्व त्वया गमितः कालः कल्पसंख्यो महामुने॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004254013, "chapter_id": 24254, "verse_number": "५-२-३२-१४", "content_sanskrit": "कस्मिन्नाश्रमसंस्थाने तपसः संचयः कृतः ।\nतीर्थानि कानि भ्रांतानि क्व ते रतिरभूच्चिरम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004254014, "chapter_id": 24254, "verse_number": "५-२-३२-१५", "content_sanskrit": "कौतुकं दृष्टपूर्वं तु वद मे मुनिसत्तम ।\nइति पृष्टो मया देवि ब्रह्मपुत्रो महामुनिः ।\nकथयामास वृत्तांतं पत्तनस्य प्रयत्नतः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004254015, "chapter_id": 24254, "verse_number": "५-२-३२-१६", "content_sanskrit": "बहूनि संपरिक्रम्य तीर्थान्यायतनानि च ।\nपत्तनानि विचित्राणि देशाश्च नगराणि च॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004254016, "chapter_id": 24254, "verse_number": "५-२-३२-१७", "content_sanskrit": "अटनार्थं महादेव जंबूद्वीपे मनोरमे ।\nदृष्टः पत्तनराजश्च सदानंदकरः परः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004254017, "chapter_id": 24254, "verse_number": "५-२-३२-१८", "content_sanskrit": "स्वेच्छाकल्पितविन्यासः प्रासादशतकल्पितः ।\nइच्छाकामफलावाप्तिर निर्देश्यसुखावहः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004254018, "chapter_id": 24254, "verse_number": "५-२-३२-१९", "content_sanskrit": "सर्वर्तुकुसुमामोदसुखस्पर्शानिलावृतः ।\nवीणावेणुरवैर्घुष्टो मनःप्रह्लादकारकः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004254019, "chapter_id": 24254, "verse_number": "५-२-३२-२०", "content_sanskrit": "वज्रेंद्रनीलवैडूर्यचन्द्रकांतादिदी पितः ।\nजरामृत्युभयोपेतः सर्वव्याधिविवर्जितः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004254020, "chapter_id": 24254, "verse_number": "५-२-३२-२१", "content_sanskrit": "शक्राग्नियमरक्षोब्धिवायुसोमेशसेवितः ।\nऊर्द्धाधः सप्तलोकेषु पुण्येषु निवसंति हि॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004254021, "chapter_id": 24254, "verse_number": "५-२-३२-२२", "content_sanskrit": "सदा प्रमुदिता देवास्तेऽपि कांक्षंति पत्तनन्न् ।\nतत्र शांता महात्मानो निवसंते महेश्वर॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004254022, "chapter_id": 24254, "verse_number": "५-२-३२-२३", "content_sanskrit": "विद्योतितदिशो दांताः सूर्य वैश्वानरप्रभाः ।\nदिव्यांबरधरा धीरा जगमुकुटधारिणः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004254023, "chapter_id": 24254, "verse_number": "५-२-३२-२४", "content_sanskrit": "विप्रा माहेश्वराः पुण्याः क्षत्रिया हरतत्पराः ।\nमुमुक्षवस्तपोनिष्ठा वैश्या शूद्राश्चिरायुपः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004254024, "chapter_id": 24254, "verse_number": "५-२-३२-२५", "content_sanskrit": "स शुभ्ररूपः स च लोहिताकृतिः स चापि पीतः ससितेतरः क्वचित् ।\nस नामधेयः स च नामवर्ज्यः सोऽदृ श्यरूपः स च दृष्टरूपः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004254025, "chapter_id": 24254, "verse_number": "५-२-३२-२६", "content_sanskrit": "क्वचिद्रविसहस्राक्षः क्वचिदेकरविप्रभः ।\nक्वचिच्चन्द्राद्विशिष्येत क्वचिदंगुलिकांतिमान्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004254026, "chapter_id": 24254, "verse_number": "५-२-३२-२७", "content_sanskrit": "जन्म मृत्युजरारोगैर्दुःखानि विविधानि च ।\nप्रयाति विलयं तानि प्रसन्ने पत्तनेश्वरे॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004254027, "chapter_id": 24254, "verse_number": "५-२-३२-२८", "content_sanskrit": "एष ते कथितो देवि प्रभावः पापनाशनः ।\nपत्तनेशस्य देवस्य आनंदेशमतः शृणु॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]