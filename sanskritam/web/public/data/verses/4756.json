[{"id": 2177825, "chapter_id": 4756, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2177826, "chapter_id": 4756, "verse_number": "१", "content_sanskrit": "ततो देवयुगेऽतीते देवा वै समकल्पयन् ।\nयज्ञं वेदप्रमाणेन विधिवद् यष्टुमीप्सवः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2177827, "chapter_id": 4756, "verse_number": "२", "content_sanskrit": "कल्पयामासुरथ ते साधनानि हवींषि च ।\nभागार्हा देवताश्चैव यज्ञियं द्रव्यमेव च\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2177828, "chapter_id": 4756, "verse_number": "३", "content_sanskrit": "ते वै रुद्रमजानन्तो यथातथ्येन भारत ।\nनाकल्पयन्त देवस्य स्थाणोर्भागं नराधिप\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2177829, "chapter_id": 4756, "verse_number": "४", "content_sanskrit": "सोऽकल्प्यमाने भागे तु कृत्तिवासा मखेऽमरैः ।\nततः साधनमन्विच्छन् धनुरग्रे ससर्ज ह\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2177830, "chapter_id": 4756, "verse_number": "५", "content_sanskrit": "लोकयज्ञः क्रियायज्ञो गृहयज्ञः सनातनः ।\nपञ्चभूतनृयज्ञश्च यज्ञे सर्वमिदं जगत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2177831, "chapter_id": 4756, "verse_number": "६", "content_sanskrit": "लोकयज्ञनृयज्ञैश्च कपर्दी विदधे धनुः ।\nधनुः सृष्टमभूत् तस्य षष्टिकिष्कुप्रमाणतः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2177832, "chapter_id": 4756, "verse_number": "७", "content_sanskrit": "वषट्कारोऽभवज्ज्या तु धनुषस्तस्य भारत ।\nयज्ञाङ्गानि च चत्वारि तस्य संनहनेऽभवन्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2177833, "chapter_id": 4756, "verse_number": "८", "content_sanskrit": "ततः क्रुद्धो महादेवस्तदुपादाय कार्मुकम् ।\nआजगामाथ तत्रैव यत्र देवाः समीजिरे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2177834, "chapter_id": 4756, "verse_number": "९", "content_sanskrit": "तमात्तकार्मुकं दृष्ट्वा ब्रह्मचारिणमव्ययम् ।\nविव्यथे पृथिवी देवी पर्वताश्च चकम्पिरे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2177835, "chapter_id": 4756, "verse_number": "१०", "content_sanskrit": "न ववौ पवनश्चैव नाग्निर्जज्वाल वैधितः ।\nव्यभ्रमच्चापि संविग्नं दिवि नक्षत्रमण्डलम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2177836, "chapter_id": 4756, "verse_number": "११", "content_sanskrit": "न बभौ भास्करश्चापि सोमः श्रीमुक्तमण्डलः ।\nतिमिरेणावृतं सर्वमाकाशं चाभवत् तदा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2177837, "chapter_id": 4756, "verse_number": "१२", "content_sanskrit": "अभिभूतास्ततो देवा विषयान् न प्रजज्ञिरे ।\nन प्रत्यभाच्च यज्ञः स देवतास्त्रेसिरे तथा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2177838, "chapter_id": 4756, "verse_number": "१३", "content_sanskrit": "ततः स यज्ञं विव्याध रौद्रेण हृदि पत्रिणा ।\nअपक्रान्तस्ततो यज्ञो मृगो भूत्वा सपावकः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2177839, "chapter_id": 4756, "verse_number": "१४", "content_sanskrit": "स तु तेनैव रूपेण दिविस्थो वै व्यराजत ।\nअन्वीयमानो रुद्रेण युधिष्ठिर नभस्थळे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2177840, "chapter_id": 4756, "verse_number": "१५", "content_sanskrit": "अपक्रान्ते ततो यज्ञे सञ्ज्ञा न प्रत्यभात् सुरान् ।\nनष्टसञ्ज्ञेषु देवेषु न प्राज्ञायत किञ्चन\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2177841, "chapter_id": 4756, "verse_number": "१६", "content_sanskrit": "त्र्यम्बकः सवितुर्बाहू भगस्य नयने तथा ।\nपूष्णश्च दशनान् सर्वान् धनुष्कोट्या व्यशातयत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2177842, "chapter_id": 4756, "verse_number": "१७", "content_sanskrit": "प्राद्रवन्त ततो देवा यज्ञाङ्गानि च सर्वशः ।\nकेचित् तत्रैव घूर्णन्तो गतासव इवाभवन्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2177843, "chapter_id": 4756, "verse_number": "१८", "content_sanskrit": "स तु विद्राव्य तत् सर्वं शितिकण्ठोऽपहस्य तु ।\nअवष्टभ्य धनुष्कोटिं रुरोध विबुधांस्ततः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2177844, "chapter_id": 4756, "verse_number": "१९", "content_sanskrit": "ततो वागमरैरुक्ता ज्यां तस्य धनुषोऽच्छिनत् ।\nअथ तत् सहसा राजन् छिन्नज्यं विष्फुरद्धनुः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2177845, "chapter_id": 4756, "verse_number": "२०", "content_sanskrit": "ततो विधनुषं देवा देवश्रेष्ठमुपागमन् ।\nशरणं सह यज्ञेन प्रसादं चाकरोत् प्रभुः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2177846, "chapter_id": 4756, "verse_number": "२१", "content_sanskrit": "ततः प्रसन्नो भगवान् प्रास्यत् कोपं जलाशये ।\nस जलं पावको भूत्वा शोषयत्यखिलं विभो\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2177847, "chapter_id": 4756, "verse_number": "२२", "content_sanskrit": "भगस्य नयने चैव बाहू च सवितुस्तथा ।\nप्रादात् पूष्णश्च दशनान् पुनर्यज्ञं च पाण्डव\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2177848, "chapter_id": 4756, "verse_number": "२३", "content_sanskrit": "ततः स्वस्थमिदं सर्वं बभूव पुनरेव हि ।\nसर्वाणि च हवींष्यस्य देवा भागमकल्पयन्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2177849, "chapter_id": 4756, "verse_number": "२४", "content_sanskrit": "तस्मिन् क्रुद्धेऽभवत् सर्वमस्वस्थं भुवनं प्रभो ।\nप्रसन्ने च पुनःस्वस्थं जगद्भवति भारत\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2177850, "chapter_id": 4756, "verse_number": "२५", "content_sanskrit": "ततस्ते निहता तेन तव पुत्रा महारथाः ।\nअन्ये च बहवः शूराः पाञ्चालाः सपदानुगाः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2177851, "chapter_id": 4756, "verse_number": "२६", "content_sanskrit": "न तन्मनसि कर्तव्यं न हि तद् द्रौणिना कृतम् ।\nमहादेवप्रसादः स कुरु कार्यमनन्तरम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2177852, "chapter_id": 4756, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nऐषीकपर्वणि ईश्वरमाहात्म्यं नाम दशमोऽध्यायः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2177853, "chapter_id": 4756, "verse_number": "", "content_sanskrit": "॥ समाप्तम् ऐषीकपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2177854, "chapter_id": 4756, "verse_number": "", "content_sanskrit": "॥ समाप्तं सौप्तिकपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]