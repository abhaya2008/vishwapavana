[{"id": 7004005000, "chapter_id": 24005, "verse_number": "३-२-१६-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nरक्षसां चैव दैत्यानां यक्षणामथ पक्षिणाम् ।\nभयनाशाय काजेशैर्धर्मारण्यनिवासिनाम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004005001, "chapter_id": 24005, "verse_number": "३-२-१६-२", "content_sanskrit": "शक्तीः संस्थापिता नृनं नानारूपा ह्यनेकशः ।\nतासां स्थानानि नामा नि यथारूपाणि मे वद॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004005002, "chapter_id": 24005, "verse_number": "३-२-१६-३", "content_sanskrit": "व्यास उवाच ।\nशृणु पार्थ महाबाहो धर्ममूर्ते नृपोत्तम ।\nस्थाने वै स्थापिता शक्तिः काजेशैश्चैव गोत्रपा॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004005003, "chapter_id": 24005, "verse_number": "३-२-१६-४", "content_sanskrit": "श्रीमाता मदारिकायां शांता नंदापुरे वरे ।\nरक्षार्थं द्विजमुख्यानां चतुर्दिक्षु स्थिताश्च ताः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004005004, "chapter_id": 24005, "verse_number": "३-२-१६-५", "content_sanskrit": "युक्ताश्चैव सुरैः सर्वैः स्वस्वस्थाने नृपोत्तम ।\nवनमध्ये स्थिताः सर्वा द्विजानां रक्षणाय वै॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004005005, "chapter_id": 24005, "verse_number": "३-२-१६-६", "content_sanskrit": "सा बभूव महाराज सावित्रीति प्रथा शिवा ।\nअसुराणां वधार्थाय ज्ञानजा स्थापिता सुरैः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004005006, "chapter_id": 24005, "verse_number": "३-२-१६-७", "content_sanskrit": "गात्रायी पक्षिणी देवी छत्रजा द्वारवासिनी ।\nशीहोरी चूटसंज्ञा या पिप्पलाशापुरी तथा ।\nअन्याश्च बहवश्चैव स्थापिता भयरक्षणे॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004005007, "chapter_id": 24005, "verse_number": "३-२-१६-८", "content_sanskrit": "प्रतीच्योदीच्यां याम्यां वै विबुधैः स्थापिता हि सा ।\nनानायुधधरा सा च नानाभरणभूषिता॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004005008, "chapter_id": 24005, "verse_number": "३-२-१६-९", "content_sanskrit": "नानावाहनमारूढा नानारूपधरा च सा ।\nनानाकोपसमायुक्ता नानाभयविना शिनी॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004005009, "chapter_id": 24005, "verse_number": "३-२-१६-१०", "content_sanskrit": "स्थाप्या मातर्यथास्थाने यथायोग्या दिशोदिश ।\nगरुडेन समारूढा त्रिशूलवरधारिणी॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004005010, "chapter_id": 24005, "verse_number": "३-२-१६-११", "content_sanskrit": "सिंहारूढा शुद्धरूपा वारुणी पानदर्पिता ।\nखड्गखेटकबाणाढ्यैः करैर्भाति शुभानना॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004005011, "chapter_id": 24005, "verse_number": "३-२-१६-१२", "content_sanskrit": "रक्तवस्त्रावृता चैव पीनोन्नतपयोधरा ।\nउद्यदादित्यबिंबाभा मदाघूर्णितलोचना॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004005012, "chapter_id": 24005, "verse_number": "३-२-१६-१३", "content_sanskrit": "एवमेषा महादिव्या काजेशैः स्थापिता तदा ।\nरक्षार्थं सर्वजंतूनां सत्यमंदिरवासिनाम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004005013, "chapter_id": 24005, "verse_number": "३-२-१६-१४", "content_sanskrit": "सा देवी नृपशार्दूल स्तुता संपूजिता सह ।\nददाति सकलान्कामान्वांछितान्नृपमत्तम॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004005014, "chapter_id": 24005, "verse_number": "३-२-१६-१५", "content_sanskrit": "धर्मारण्यात्पश्चिमतः स्थापिता छत्रजा शुभा ।\nतत्रस्था रक्षते विप्रान्कियच्छक्तिसम न्विता॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004005015, "chapter_id": 24005, "verse_number": "३-२-१६-१६", "content_sanskrit": "भैरवं रूपमास्थाय राक्षसानां वधाय च ।\nधारयंत्यायुधानीत्थं विप्राणामभयाय च॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004005016, "chapter_id": 24005, "verse_number": "३-२-१६-१७", "content_sanskrit": "सरश्चकार तस्याग्रे उत्तमं जल पूरितम् ।\nसरस्यस्मिन्महाभाग कृत्वा स्नानादितर्पणम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004005017, "chapter_id": 24005, "verse_number": "३-२-१६-१८", "content_sanskrit": "पिंडदानादिकं सर्वमक्षयं चैव जायते ।\nभूमौ क्षिप्तांजलीन्दिव्यान्धूपदीपादिकं सदा॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004005018, "chapter_id": 24005, "verse_number": "३-२-१६-१९", "content_sanskrit": "तस्य नो बाधते व्याधिः शत्रूणां नाश एव च ।\nबलिदानादिकं तत्र कुर्याद्भूयः स्वशक्तितः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004005019, "chapter_id": 24005, "verse_number": "३-२-१६-२०", "content_sanskrit": "शत्रवो नाशमायांति धनं धान्यं विवर्धते ।\nआनंदा स्थापिता राजञ्छक्त्यंशा च मनोरमा॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004005020, "chapter_id": 24005, "verse_number": "३-२-१६-२१", "content_sanskrit": "रक्षणार्थं द्विजातीनां माहात्म्यं शृणु भूपते ।\nशुक्लांबरधरा दिव्या हेमभूषणभूषिता॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004005021, "chapter_id": 24005, "verse_number": "३-२-१६-२२", "content_sanskrit": "सिंहारूढा चतुर्हस्ता शशांककृतशेखरा ।\nमुक्ताहारलतोपेता पीतोन्नतपयोधरा॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004005022, "chapter_id": 24005, "verse_number": "३-२-१६-२३", "content_sanskrit": "अक्षमालासिहस्ता च गुण तोमरधारिणी ।\nदिव्यगंधवराधारा दिव्यमालाविभूषिता॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004005023, "chapter_id": 24005, "verse_number": "३-२-१६-२४", "content_sanskrit": "सात्त्विकी शक्तिरानंदा स्थिता तस्मिन्पुरे पुरा ।\nपूजयेत्तां च वै राजन्कर्पूरारक्त चंदनैः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004005024, "chapter_id": 24005, "verse_number": "३-२-१६-२५", "content_sanskrit": "भोजयेत्पायसैः शुभ्रैर्मध्वाज्यसितया सह ।\nभवान्याः प्रीतये राजन्कुमार्याः पूजनं तथा॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004005025, "chapter_id": 24005, "verse_number": "३-२-१६-२६", "content_sanskrit": "तत्र जप्तं हुतं दत्तं ध्यातं च नृपसत्तम ।\nतत्सर्वं चाक्षयं तत्र जायते नात्र संशयः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004005026, "chapter_id": 24005, "verse_number": "३-२-१६-२७", "content_sanskrit": "त्रिगुणे त्रिगुणा वृद्धिस्तस्मिन्स्थाने नृपोत्तम ।\nसाधकस्य भवेन्नूनं धनदारादिसं पदः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004005027, "chapter_id": 24005, "verse_number": "३-२-१६-२८", "content_sanskrit": "न हानिर्न च रोगश्च न शत्रुर्न च दुष्कृतम् ।\nगावस्तस्य विवर्द्धंते धनधान्यादिसंकुलम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004005028, "chapter_id": 24005, "verse_number": "३-२-१६-२९", "content_sanskrit": "न शाकिन्या भयं तस्य न च राज्ञश्च वैरिणः ।\nन च व्याधिभयं चैव सर्वत्र विजयी भवेत्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004005029, "chapter_id": 24005, "verse_number": "३-२-१६-३०", "content_sanskrit": "विद्याश्चतुर्द्दशास्यैव भासंते पठिता इव ।\nसूर्यवद्द्योतते भूमावानंदमा श्रितो नरः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]