[
  {
    "id": 20011115,
    "chapter_id": 6680,
    "verse_number": "8.1",
    "content_sanskrit": "अथाराध्य यथाशास्त्रं पाण्डयः पाण्डवमब्रवीत् । प्ररोहान् प्रेमसस्यस्य दशनांशून् प्रकाशयन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20011116,
    "chapter_id": 6680,
    "verse_number": "8.2",
    "content_sanskrit": "सत्येयं जनवाग्जीवन् सुखमासादयेदिति । जरद्भूयाद्य पश्यामि यत्त्वां पुरुषचन्दन ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20011117,
    "chapter_id": 6680,
    "verse_number": "8.3",
    "content_sanskrit": "समृद्धोप्यनपत्यत्वात् सुखायेहं न जातुचित् । कल्पद्रुकल्प, कल्पस्व तस्य त्वं मम शर्मणे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20011118,
    "chapter_id": 6680,
    "verse_number": "8.4",
    "content_sanskrit": "आक्षिकोप्याक्षिको वृद्धिं'प्राप्तोऽर्थैराक्षिकैरपि । क्षैरिकायन्नतृप्तोपि नाकुमारः प्रमोदते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20011119,
    "chapter_id": 6680,
    "verse_number": "8.5",
    "content_sanskrit": "उत्तिष्ठमानोपि सदा कुले दैवविरोधिनि । पुत्रं न पश्यामि मरौ खानित्रिक इवोदकम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20011120,
    "chapter_id": 6680,
    "verse_number": "8.6",
    "content_sanskrit": "गौपुच्छिको वा पुच्छेन घटेन घटिको यथा । नावेव नाविकस्तोयं नापत्येन तरत्यघम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20011121,
    "chapter_id": 6680,
    "verse_number": "8.7",
    "content_sanskrit": "अहमाकर्षिकेणेव शातकुंभोपलं त्वया । योगेन करणीयोऽस्तपुत्रशोकमलोऽधुना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20011122,
    "chapter_id": 6680,
    "verse_number": "8.8",
    "content_sanskrit": "मत्का दाण्डिकधानुष्कक्रयविक्रयिका यथा । मयि वीवधिकाश्चाहं तथाधीनोऽधुना त्वयि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20011123,
    "chapter_id": 6680,
    "verse_number": "8.9",
    "content_sanskrit": "अकृत्रिमप्रजास्नेहः कच्चिद्राजा युधिष्ठिरः? आक्षद्यूतिकमुख्यैर्न व्यसनै'रभिभूयते? ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20011124,
    "chapter_id": 6680,
    "verse_number": "8.10",
    "content_sanskrit": "'कच्चिद्याचितकैर्वर्णा उप्तिमैरपमित्यकैः । दत्रिमैः कृत्रिमैश्चार्थैरेधन्ते कुरुषु स्थिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20011125,
    "chapter_id": 6680,
    "verse_number": "8.11",
    "content_sanskrit": "टलन्ति नागराः कच्चिद्दाधिकं शार्ङ्गवेरिकम्? लवणं मौद्गमप्यन्नमपूपानपि चूर्णिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20011126,
    "chapter_id": 6680,
    "verse_number": "8.12",
    "content_sanskrit": "दाधिकाद्यन्नसन्तुष्टः कच्चिदौजसिकोऽश्नुते? सुखं साहसिको भीमस्सदांभसिकमत्स्यवत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20011127,
    "chapter_id": 6680,
    "verse_number": "8.13",
    "content_sanskrit": "कच्चित् कौन्तेयमाद्रेयास्सदान्योन्यानुकूलिकाः? न पारिमुखिकाः पापा भृत्याः कच्चिद् भवन्ति वः? ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20011128,
    "chapter_id": 6680,
    "verse_number": "8.14",
    "content_sanskrit": "कच्चित्कुसीदिका मर्त्या दशैकादशिकादयः । दण्डयन्ते पाण्डवैः पाङ्किर्द्विजान् बादरिकानपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20011129,
    "chapter_id": 6680,
    "verse_number": "8.15",
    "content_sanskrit": "कच्चित्सामाजिका विप्रा दोषान्न गणयन्ति वः । शाब्दिकाद्या बुधाः कच्चिन्महीयन्ते गृहेषु वः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20011130,
    "chapter_id": 6680,
    "verse_number": "8.16",
    "content_sanskrit": "पाक्षिका मैनिकशूद्रास्तथा सौकरिकादयः । कच्चिद्दार्दरिकाद्याश्च वश्याएव भवन्ति वः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20011131,
    "chapter_id": 6680,
    "verse_number": "8.17",
    "content_sanskrit": "ये पारिपन्थिकाश्चोराः कृतपादविकापदः । हथ बाणैः स्वयं कच्चिद्यूयं तान् वानमाथिकाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20011132,
    "chapter_id": 6680,
    "verse_number": "8.18",
    "content_sanskrit": "नॄन् प्रातिपथिकान् पार्थाः पान्त्यनैर्धामिकार्थिकाः । इति स्तुवन्ति वः कञ्चित् ब्राह्मणास्सामवायिकाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20011133,
    "chapter_id": 6680,
    "verse_number": "8.19",
    "content_sanskrit": "कच्चित्पृच्छथ शास्त्रार्थान् पारिषद्यान् विपश्चितः । पूजां कुरुध्वे सैन्यानामुत्तमानाञ्च कञ्चन ? ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20011134,
    "chapter_id": 6680,
    "verse_number": "8.20",
    "content_sanskrit": "कच्चिल्लालाटिकान् भृत्यान् विज्ञायाशु निरस्यथ । कच्चित्कौक्कुटिकान् भिक्षून् भक्तिमन्तस्समर्चथ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20011135,
    "chapter_id": 6680,
    "verse_number": "8.21",
    "content_sanskrit": "कच्चिदापणिकैरर्थैरवक्रीयापणं पुरे । कुर्वन्त्यापणिकं कर्म वणिजश्शासनेन वः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20011136,
    "chapter_id": 6680,
    "verse_number": "8.22",
    "content_sanskrit": "महिष्यो माहिषं कच्चित् कर्म हौत्रादि चर्त्विजः । पौरौहितञ्च युष्माकं न मुञ्चन्ति पुरोहिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20011137,
    "chapter_id": 6680,
    "verse_number": "8.23",
    "content_sanskrit": "पूर्यते वः पुरं कच्चित् सदा गुल्गुलुकादिभिः । मार्दङ्गिकैर्झार्झरिकैर्मार्डडुकैश्शांखिकैरपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20011138,
    "chapter_id": 6680,
    "verse_number": "8.24",
    "content_sanskrit": "रक्षन्ति कच्चिद्राजानं पार्श्वस्थाः ख्वाङ्गिकास्सदा । सहशाक्तीकयाष्टीकास्सपारश्वधिका भटाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20011139,
    "chapter_id": 6680,
    "verse_number": "8.25",
    "content_sanskrit": "सुवृत्तैरास्तिकैः कच्चिदमात्यैर्नास्तिकेततरः । राजा परिवृतो भाति कामैश्च परिचारकैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20011140,
    "chapter_id": 6680,
    "verse_number": "8.26",
    "content_sanskrit": "द्विजास्सम्यगधीयानाः कच्चिन्नैकान्त्यका अपि । भवन्ति युष्मत्सौराज्ये किमुत द्वादशान्त्यकाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20011141,
    "chapter_id": 6680,
    "verse_number": "8.27",
    "content_sanskrit": "अचातुष्पथिकाः कच्चिच्चातुर्दशिका द्विजाः । अधीयते सदा युष्मदत्तसंवसथाश्रयाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20011142,
    "chapter_id": 6680,
    "verse_number": "8.28",
    "content_sanskrit": "कच्चिदापूपिकान्नित्यमपूपैर्धिनुथ द्विजान् ? प्रसन्ना हि महीदेवाः कल्पन्ते कल्पपादपाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20011143,
    "chapter_id": 6680,
    "verse_number": "8.29",
    "content_sanskrit": "सन्तुष्यमांसौदनिकाः कच्चिन्मांसौदनैर्भटाः । भक्तैर्भाक्ताश्च वो दासास्सुष्ठु कर्माणि कुर्वते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20011144,
    "chapter_id": 6680,
    "verse_number": "8.30",
    "content_sanskrit": "कच्चिन्नैकटिकान् भिक्षून्गन्तॄन्नगरं वनात् । संरक्षयथ भृत्यैस्स्वैः परिचर्याविशारदैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20011145,
    "chapter_id": 6680,
    "verse_number": "8.31",
    "content_sanskrit": "किमुक्तैर्बहुभिः कच्चिद्ध्रिया चाजातविद्विषः । भुजस्तंभैश्च युष्माकं भूस्सर्वापरिपाल्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20011146,
    "chapter_id": 6680,
    "verse_number": "8.32",
    "content_sanskrit": "धौरेयपाण्डुपुत्राणां प्राप्तेरस्याः पुरस्त्वया । आस्माकात् सुकृतादस्तिकिमन्यदपि कारणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20011147,
    "chapter_id": 6680,
    "verse_number": "8.33",
    "content_sanskrit": "चित्रवाहनमित्युक्तस्सस्नेहं सितवाहनः । स्फुटाभ्यां नेत्रपद्माभ्यां त्रिवर्णाभ्यामभाषत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20011148,
    "chapter_id": 6680,
    "verse_number": "8.34",
    "content_sanskrit": "पर्याप्तान्येव सर्वाणि साम्प्रतं कुशलानि नः । इच्छन् पृच्छसियेषां त्वं तानीमानि महीपते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20011149,
    "chapter_id": 6680,
    "verse_number": "8.35",
    "content_sanskrit": "कच्चित् कुशलिनोऽश्वास्ते रथ्या युग्यास्तथर्षभाः । राष्ट्रे ते वणिजः कच्चित् शाकटान् वर्धयन्ति गाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20011150,
    "chapter_id": 6680,
    "verse_number": "8.36",
    "content_sanskrit": "कृषन्ति सैरिकाः कच्चित् केदार्यं विषये तव । काले काले समुन्नम्रघनमुक्तजलाविलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20011151,
    "chapter_id": 6680,
    "verse_number": "8.37",
    "content_sanskrit": "सपद्यशर्करान् गत्वा पथस्सोर्व्यकण्टकान् । स्वयमेव शरैश्शूरान् निपातयसि कच्चन? ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20011152,
    "chapter_id": 6680,
    "verse_number": "8.38",
    "content_sanskrit": "कान्तसंकेतवेश्मानि यान्ति कच्चित् पुरे तव ? आन्ना धन्याः स्त्रियो वश्याः पद्यैः पांसुलवर्त्मभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20011153,
    "chapter_id": 6680,
    "verse_number": "8.39",
    "content_sanskrit": "फलमर्थस्य गृह्णीषे मूलमुत्सृज्य कच्चन ? मूल्यानामिव मुद्गानां समूलं न पुनः फलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20011154,
    "chapter_id": 6680,
    "verse_number": "8.40",
    "content_sanskrit": "सदाग्नीन् गार्हपत्यादीन् धर्म्यापूर्वेप्सयार्चत: । कच्चिद्विद्याधमर्णस्य धेनुष्येवाफलानते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20011155,
    "chapter_id": 6680,
    "verse_number": "8.41",
    "content_sanskrit": "मूल्यमूलहितं कच्चिल्लभन्ते ते विशः पुरे । मूलायनहितं यत्तु मूल्यं लब्धेव तेनकिम् ? ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20011156,
    "chapter_id": 6680,
    "verse_number": "8.42",
    "content_sanskrit": "तीर्णनाव्यसमुद्रांभो लब्धसद्रत्नराशयः । कच्चित्तव पुरे यान्ति विशो वित्तेशतुल्यताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20011157,
    "chapter_id": 6680,
    "verse_number": "8.43",
    "content_sanskrit": "कच्चित् क्षेत्रेषु सीत्येषु बीजान्युप्तानि हालिकैः । मण्डले ते यथाकालं प्ररोहन्ति फलानि च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20011158,
    "chapter_id": 6680,
    "verse_number": "8.44",
    "content_sanskrit": "सपत्नानायुधैवध्यान् विष्यान् कच्चिन्न मन्यसे । कच्चिद्वन्धून् वयस्यांश्च सदात्मानमिवार्चसि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20011159,
    "chapter_id": 6680,
    "verse_number": "8.45",
    "content_sanskrit": "कच्चिद्वर्णाश्रमाचारन्याय्यं पासि पुरातनम् । कच्चिदन्नानि पथ्यानि भिषगुक्तानि सेवसे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20011160,
    "chapter_id": 6680,
    "verse_number": "8.46",
    "content_sanskrit": "छन्दस्यहृद्यनिश्शेषपरिच्छदगुहश्रितः । द्विजान् हृद्यादिमन्त्रज्ञान् कच्चिदृग्यजुषोऽर्चसि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20011161,
    "chapter_id": 6680,
    "verse_number": "8.47",
    "content_sanskrit": "पण्डितान् मत्यशास्त्रज्ञान् हल्यदक्षांश्च पामरान् । कच्चिदाराधयन् जन्ये सर्वत्र त्वं महीयसे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20011162,
    "chapter_id": 6680,
    "verse_number": "8.48",
    "content_sanskrit": "कच्चित् प्रातिजनीनांस्त्वं सभ्यानर्चसि पण्डितान् । अन्वहं शालिभिर्भक्तैस्सांयुगीनांश्च सैनिकान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20011163,
    "chapter_id": 6680,
    "verse_number": "8.49",
    "content_sanskrit": "कच्चन स्वापतेयं ते वासतेयं वसूपम । पाथेयञ्चातिथेयस्य प्रस्थाने यमसद्मनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20011164,
    "chapter_id": 6680,
    "verse_number": "8.50",
    "content_sanskrit": "द्विजेभ्यः प्रेप्सितान् ग्रामान् विश्राणयसि कच्चन । गौडिकेक्ष्वादिसम्पूर्णानुरस्यतनयेप्सया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20011165,
    "chapter_id": 6680,
    "verse_number": "8.51",
    "content_sanskrit": "सुस्थौ समानोदर्यौ मे युधिष्ठिरवृकोदरौ । तौ च सोदर्यदेशीयौ माद्रीपुत्रौ यशस्विनौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20011166,
    "chapter_id": 6680,
    "verse_number": "8.52",
    "content_sanskrit": "अहं स्वात्मविशुद्ध्यर्थं सतीर्थ्यैर्ब्रह्मिष्ठैस्सह । तीर्थानि सेवमानोद्य त्वत्सङ्गमसुखं भजे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20011167,
    "chapter_id": 6680,
    "verse_number": "8.53",
    "content_sanskrit": "गव्यास्सुशीला ब्रह्मण्या यव्यमाष्यादिभूमिदाः । कस्य विश्वजनीनाःस्यु र्न सुखाय भवादृशाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20011168,
    "chapter_id": 6680,
    "verse_number": "8.54",
    "content_sanskrit": "पृथुक्यशाल्यपूपीयचरव्योत्तमण्डलान् । जनेन क्रीणता पूर्णमङ्गारीयेन्धनानि च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20011169,
    "chapter_id": 6680,
    "verse_number": "8.55",
    "content_sanskrit": "प्राकारीयेष्टकापूर्णं प्रासादीयमहीतलम् । मण्ळूरपुरञ्चेदं मुदे कस्य न जायते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20011170,
    "chapter_id": 6680,
    "verse_number": "8.56",
    "content_sanskrit": "कार्षापणाढ्या वणिजश्शत्यान् दधतिशाटकान् । शातिकांश्च परिष्कारान् केयूरप्रभृतीनिह ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20011171,
    "chapter_id": 6680,
    "verse_number": "8.57",
    "content_sanskrit": "एतन्नगरसंयोगं को न कामयते पुमान् । धीमान् धन्यं परिस्पन्दं दक्षिणस्येव चक्षुषः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20011172,
    "chapter_id": 6680,
    "verse_number": "8.58",
    "content_sanskrit": "पार्थश्च पार्थिवश्चैवं सल्लापैस्सार्वलौकिकौ । नीत्वा मुहूर्तं संहृष्टौ सहस्रानादि चक्रतुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20011173,
    "chapter_id": 6680,
    "verse_number": "8.59",
    "content_sanskrit": "लक्षणैरर्जुनं राजा सार्वभौमममन्यत । राज्यं प्रीत्या च भीत्या च तदधीनं चकार च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20011174,
    "chapter_id": 6680,
    "verse_number": "8.60",
    "content_sanskrit": "निरन्तरालं केदारैः प्रास्थिकद्रौणिकादिभिः । पाण्ड्येन सहितो राष्ट्रं पाण्डवः प्रशशास तत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20011175,
    "chapter_id": 6680,
    "verse_number": "8.61",
    "content_sanskrit": "शत्येभ्य आयस्थानेभ्यो'दत्तानधिकृतैर्नरैः । ददौकार्षापणान् लब्ध्वास नृपाय शतं शतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20011176,
    "chapter_id": 6680,
    "verse_number": "8.62",
    "content_sanskrit": "स वांशभारिकान् भृत्यानैक्षुकादींश्च कर्मठान् । कुलालांश्चाढकीनादिपात्रदानधिनोद्धनैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20011177,
    "chapter_id": 6680,
    "verse_number": "8.63",
    "content_sanskrit": "साहस्रान् सर्वशास्त्रज्ञान् शातिकांवरभूषणान् । कार्षापणसहस्रैस्स सुभटान् पर्यतोषयत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20011178,
    "chapter_id": 6680,
    "verse_number": "8.64",
    "content_sanskrit": "स वार्षशतिकान्स्तत्र सेवमानो विपश्चितः । परं प्रपेदे पाण्डित्यं विद्यास्वष्टादशस्वपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20011179,
    "chapter_id": 6680,
    "verse_number": "8.65",
    "content_sanskrit": "स दण्ड्यान् दण्डयन् पापान् मधुपर्क्यान् सतोऽर्चयन् । पारायणिकपूजावान् राष्ट्रे तत्रामहीयत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20011180,
    "chapter_id": 6680,
    "verse_number": "8.66",
    "content_sanskrit": "दृष्ट्वा पान्थानतिश्रान्तान् स श्रान्तान् पथिकानपि । भुक्तिकाले गृहं प्राप्तान् क्षुत्तर्षार्तानभोजयत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20011181,
    "chapter_id": 6680,
    "verse_number": "8.67",
    "content_sanskrit": "तं वारिपथिका गत्वा वणिजस्सत्तमान् मणीन् । तस्मै समुद्रजान् वारिपथिकान् वत्सला ददुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20011182,
    "chapter_id": 6680,
    "verse_number": "8.68",
    "content_sanskrit": "समीनैस्संवृतो भृत्यैस्समीने निवसन् गृहे । ससूरिभिस्समं रेमे समीनाचार्यशिक्षितैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20011183,
    "chapter_id": 6680,
    "verse_number": "8.69",
    "content_sanskrit": "स मासिकादिसंसर्गमुदितः स्म समर्चति । समीनैरंबरैस्सूक्ष्मैर्भूषणैश्च मनीषिणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20011184,
    "chapter_id": 6680,
    "verse_number": "8.70",
    "content_sanskrit": "सुमृष्टषष्टिकाद्यन्नसन्तुष्टास्तस्य वेश्मनि । मासिकादीनि काव्यानि बबन्धुः कविकुञ्जराः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20011185,
    "chapter_id": 6680,
    "verse_number": "8.71",
    "content_sanskrit": "मासिकादीन् गदान् वैद्याः परिजिग्युस्तदाज्ञया । आतुराणामनाथानामाश्रितानां विचक्षणाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20011186,
    "chapter_id": 6680,
    "verse_number": "8.72",
    "content_sanskrit": "मासिकादितपःपूतैर्गुप्तो विप्रैर्भटैरपि । मासिकारिजयप्राप्तैः सोऽजय्योभूदरातिभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20011187,
    "chapter_id": 6680,
    "verse_number": "8.73",
    "content_sanskrit": "ब्रह्मचर्यैर्द्विजातिभ्यः पूतेभ्यो मासिकादिभिः । वैयुष्टं कर्म कृत्वादाद्वैयुष्टं वसु फल्गुनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20011188,
    "chapter_id": 6680,
    "verse_number": "8.74",
    "content_sanskrit": "ब्रह्मचारिण आदाय वैयुष्टम्मासिकादयः । धनमर्जुनमाशीर्भिरमोघाभिरवर्धयन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20011189,
    "chapter_id": 6680,
    "verse_number": "8.75",
    "content_sanskrit": "तत्राग्निष्टोमिकीं पार्थो द्विजेभ्यो दक्षिणां ददौ । आग्निष्टोमिकभक्तादिसाधनानि धनानि च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "avatarnika": ""
  },
  {
    "id": 20011190,
    "chapter_id": 6680,
    "verse_number": "8.76",
    "content_sanskrit": "साङ्गार्थे निगमे निष्णास्संशिता ये द्विजातयः । तानयाथाकथाचेन हस्त्येनार्थेन सोऽधिनोत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20011191,
    "chapter_id": 6680,
    "verse_number": "8.77",
    "content_sanskrit": "कर्म याथाकथाचं स नातिलघ्वप्यमन्यत । हस्त्याद्यत्यन्तदक्षोपि सा खलु प्रकृतिस्सताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20011192,
    "chapter_id": 6680,
    "verse_number": "8.78",
    "content_sanskrit": "मणिमञ्जीरकैर्मञ्जुशिञ्जानैः पादपल्लवैः । मेखलागुणिकैर्मध्येरुरोजैर्हारयष्टिकैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "avatarnika": ""
  },
  {
    "id": 20011193,
    "chapter_id": 6680,
    "verse_number": "8.79",
    "content_sanskrit": "कार्णवेष्टकिकैः कर्णैर्नैष्किर्कैश्चारुभिर्गलैः । त्वालसन् सहाभीकैर्वालयिक्यं पुराङ्गनाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20011194,
    "chapter_id": 6680,
    "verse_number": "8.80",
    "content_sanskrit": "स कर्मण्यवपुर्वेष्यो योषित्सान्तापिकी तनुः । युद्यौगिकौ दधद्बाहू कार्मुकज्याकिणाङ्कितौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20011195,
    "chapter_id": 6680,
    "verse_number": "8.81",
    "content_sanskrit": "क्रीडां सामयिकीं कर्तुं प्रविष्टो जातु निष्कुटम् । कुसुमैरार्तवैः पूर्णमामोदाकृष्टषट्पदैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20011196,
    "chapter_id": 6680,
    "verse_number": "8.82",
    "content_sanskrit": "कालिक्यां विहृतौ लग्नां काल्यकान्तसमागमाम् । माहोत्सविकपुष्पापचयाकुलसखीवृताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "avatarnika": ""
  },
  {
    "id": 20011197,
    "chapter_id": 6680,
    "verse_number": "8.83",
    "content_sanskrit": "चञ्चलाकालिकीं ह्रीतां चञ्चलाश्रितलोचनाम् । काञ्चनालोकयत् कन्यां काञ्चनाभरणोज्ज्वलाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20011198,
    "chapter_id": 6680,
    "verse_number": "8.84",
    "content_sanskrit": "दूर्वाकिसलयच्छायगर्वैकागारिकीद्युतिम् । तनुं दधानां तां दृष्ट्वा चिन्तयामास वासविः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20011199,
    "chapter_id": 6680,
    "verse_number": "8.85",
    "content_sanskrit": "सुरालयकुमारीवत् भान्तीयं का नु कन्यका ? मृदुत्वमस्यां नागीवच्छ्रीवदस्यास्सुरूपता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "avatarnika": ""
  },
  {
    "id": 20011200,
    "chapter_id": 6680,
    "verse_number": "8.86",
    "content_sanskrit": "ह्रीच्छतीयं कुलीनावत् स्निग्धावद्वीक्षते च मा । नमते च विनीतावद्दक्षजन्या सुशिक्षिता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "avatarnika": ""
  },
  {
    "id": 20011201,
    "chapter_id": 6680,
    "verse_number": "8.87",
    "content_sanskrit": "प्रथिम्ना जघने मध्ये तनिम्नासौ विराजते । दार्ढ्यनैस्तल्यवैपुल्यपैवर्यादौदार्यवत्स्तनी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 87,
    "avatarnika": ""
  },
  {
    "id": 20011202,
    "chapter_id": 6680,
    "verse_number": "8.88",
    "content_sanskrit": "सन्नह्यतोस्यास्तेयार्थमूरू करिकराकृतेः । पादौ पल्लवसख्याय ज्ञातेयौ चाब्जयोः करौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 88,
    "avatarnika": ""
  },
  {
    "id": 20011203,
    "chapter_id": 6680,
    "verse_number": "8.89",
    "content_sanskrit": "हरिणाक्षी हरत्येषा कामनीयकमैन्दवम् । स्मितज्योत्स्नावदातेन मुखेनाब्ज'मदच्छिदा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 89,
    "avatarnika": ""
  },
  {
    "id": 20011204,
    "chapter_id": 6680,
    "verse_number": "8.90",
    "content_sanskrit": "कच्चित् क्षेत्रेषु मुद्रा वो मौद्गीनेषु चकासति । पचेलिमाश्शरत्काले शालेयेषु च शालयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 90,
    "avatarnika": ""
  },
  {
    "id": 20011205,
    "chapter_id": 6680,
    "verse_number": "8.91",
    "content_sanskrit": "सस्यादिभिरनाक्रान्ता षष्टिक्येषु च षष्टिकाः । तिलास्तिल्येषु मापाश्च मापीणेषु विचक्षणाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 91,
    "avatarnika": ""
  },
  {
    "id": 20011206,
    "chapter_id": 6680,
    "verse_number": "8.92",
    "content_sanskrit": "इत्येषामूर्महाशूद्रीः कुशलं पृच्छति श्रिताः । सुभ्रूगलोकयन्ती मामपाङ्गैरन्तरान्तरा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 92,
    "avatarnika": ""
  },
  {
    "id": 20011207,
    "chapter_id": 6680,
    "verse_number": "8.93",
    "content_sanskrit": "बिभर्ति सर्वचर्मीणं काचित्तांबूलभाजनम् । चेख्यस्यास्सार्वचर्मीणमन्यात्ददति शुभम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 93,
    "avatarnika": ""
  },
  {
    "id": 20011208,
    "chapter_id": 6680,
    "verse_number": "8.94",
    "content_sanskrit": "यथामुखीनं सम्मृष्टमपरा मणिदर्पणम् । अयानयीनशाराणां पूर्णमन्या तु भाजनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 94,
    "avatarnika": ""
  },
  {
    "id": 20011209,
    "chapter_id": 6680,
    "verse_number": "8.95",
    "content_sanskrit": "सर्वान्नीनादिमे मन्वे प्रियादपि सखीजनात् । धन्ये अनुपदीने ये वहतेऽसावुपानहौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 95,
    "avatarnika": ""
  },
  {
    "id": 20011210,
    "chapter_id": 6680,
    "verse_number": "8.96",
    "content_sanskrit": "सर्वाङ्गीणानि बिभ्राणा लक्षणानि शुभान्यसौ । कुमारी सर्वकर्मीणा मम चित्ताय रोचते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 96,
    "avatarnika": ""
  },
  {
    "id": 20011211,
    "chapter_id": 6680,
    "verse_number": "8.97",
    "content_sanskrit": "इति सिश्चिन्तयन्नेव तत्समीपं जगाम सः । लज्जया वलमाना तु सा निलिल्ये सखीजने ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 97,
    "avatarnika": ""
  },
  {
    "id": 20011212,
    "chapter_id": 6680,
    "verse_number": "8.98",
    "content_sanskrit": "तं केयमिति पृच्छन्तं काचिदूचे पटुस्सखी । अञ्जलि'ग्रथनोदस्तहस्तविस्तारितस्तनी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 98,
    "avatarnika": ""
  },
  {
    "id": 20011213,
    "chapter_id": 6680,
    "verse_number": "8.99",
    "content_sanskrit": "असावपत्यसर्वस्व'मास्माकस्य महीपतेः । नन्दतः पुत्त्रपौत्त्रीणं दृष्ट्वा लोकमपुत्रिणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 99,
    "avatarnika": ""
  },
  {
    "id": 20011214,
    "chapter_id": 6680,
    "verse_number": "8.100",
    "content_sanskrit": "नाम्ना चित्त्राङ्गदामेनां विद्धि त्वं चैतवाहिनीम् । अस्याः पतिमिवान्विच्छन्दश धावति यद्दिशः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 100,
    "avatarnika": ""
  },
  {
    "id": 20011215,
    "chapter_id": 6680,
    "verse_number": "8.101",
    "content_sanskrit": "नौरिवावारपारीणा समुत्पाद्य सुरक्षिता । पुत्त्रशोकार्णवादेषा तातमुत्तारयिष्यति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 101,
    "avatarnika": ""
  },
  {
    "id": 20011216,
    "chapter_id": 6680,
    "verse_number": "8.102",
    "content_sanskrit": "लभते पुरुषेन्द्रोस्य योद्यश्वीनं करग्रहम् । शुल्कं प्रथमजं पुत्रं पित्रे सोऽस्याः प्रदास्यति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 102,
    "avatarnika": ""
  },
  {
    "id": 20011217,
    "chapter_id": 6680,
    "verse_number": "8.103",
    "content_sanskrit": "आगवीनो यथा भर्तुरुत्पादयति सम्मदम् । तथा करोति भूपस्य शुल्कदोऽस्याः पतिर्मुदम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 103,
    "avatarnika": ""
  },
  {
    "id": 20011218,
    "chapter_id": 6680,
    "verse_number": "8.104",
    "content_sanskrit": "गुणरत्नसमुद्राय गुणमुक्ता तरङ्गिणी । सेयं प्रदास्यते पित्रा त्वादृशे भरतर्षभ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 104,
    "avatarnika": ""
  },
  {
    "id": 20011219,
    "chapter_id": 6680,
    "verse_number": "8.105",
    "content_sanskrit": "इत्युक्त्वा फाल्गुनायासौ सखी सख्यस्तथापराः । तस्थिरेऽनुगवीनाय गोविन्दायैव गोपिकाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 105,
    "avatarnika": ""
  },
  {
    "id": 20011220,
    "chapter_id": 6680,
    "verse_number": "8.106",
    "content_sanskrit": "वदन्तीमिति तां पार्थः प्रीतिमानानुकीलिकीम् । अनुगृह्णन् मृदुस्मित्वा प्रत्युवाच विचक्षणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 106,
    "avatarnika": ""
  },
  {
    "id": 20011221,
    "chapter_id": 6680,
    "verse_number": "8.107",
    "content_sanskrit": "सख्यं साप्तपदीनत्वे रोचतेद्य सहानया । तदस्याः पितरं द्रष्टुं यामि वो यदि रोचते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 107,
    "avatarnika": ""
  },
  {
    "id": 20011222,
    "chapter_id": 6680,
    "verse_number": "8.108",
    "content_sanskrit": "इत्युक्तानुमतास्ताभिर्विहिताञ्जलिभिर्गिरा । ययौ नृपालयं जिष्णुः कटाक्षैरपि कान्तया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 108,
    "avatarnika": ""
  },
  {
    "id": 20011223,
    "chapter_id": 6680,
    "verse_number": "8.109",
    "content_sanskrit": "स गत्वा नृपतिं दृष्ट्वा रहसीदमभाषत । ह्रियेव स्थगयन्नर्थी मुखेन्दुदशनांशुभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 109,
    "avatarnika": ""
  },
  {
    "id": 20011224,
    "chapter_id": 6680,
    "verse_number": "8.110",
    "content_sanskrit": "प्रत्यक्षस्तवमार्याणां लपाकरमजानती । रसज्ञा मम नौति त्वा चपलेयं जडात्मिका ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 110,
    "avatarnika": ""
  },
  {
    "id": 20011225,
    "chapter_id": 6680,
    "verse_number": "8.111",
    "content_sanskrit": "अध्वन्या गृहमायान्ति क्षुधितास्तृषिताश्च ते । धिनोषि चान्नपानैस्त्वमध्वनीनान् दिवानिशम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 111,
    "avatarnika": ""
  },
  {
    "id": 20011226,
    "chapter_id": 6680,
    "verse_number": "8.112",
    "content_sanskrit": "अभ्यमित्रं निशम्य त्वां द्रवन्त्याशा दश द्विषः । निशाम्य त्वभ्यमित्रीणं सहसा विजहत्यसून् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 112,
    "avatarnika": ""
  },
  {
    "id": 20011227,
    "chapter_id": 6680,
    "verse_number": "8.113",
    "content_sanskrit": "यदा त्वमभ्यमित्रीयश्चलसि ध्वजिनीवृतः । द्रुतामित्रे पुरे याति गोष्ठं गोष्ठीनतां तदा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 113,
    "avatarnika": ""
  },
  {
    "id": 20011228,
    "chapter_id": 6680,
    "verse_number": "8.114",
    "content_sanskrit": "शालीना धृतकौपीना धावन्ति त्वद्वियारायः । एकाह एव ही वर्त्मान्याश्वीनानि सहस्रशः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 114,
    "avatarnika": ""
  },
  {
    "id": 20011229,
    "chapter_id": 6680,
    "verse_number": "8.115",
    "content_sanskrit": "वर्तन्ते मुनयोऽरण्ये ये कर्कन्धुकुणादिभिः । तान् व्रातीनांश्च पासि त्वं वने घ्नन् व्याघ्रतस्करान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 115,
    "avatarnika": ""
  },
  {
    "id": 20011230,
    "chapter_id": 6680,
    "verse_number": "8.116",
    "content_sanskrit": "विशङ्कटः प्रतापस्ते सङ्कटं कुरुते द्विषाम् । गुणैरवकुटारैस्ते निबिडैः पूर्यते जगत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 116,
    "avatarnika": ""
  },
  {
    "id": 20011231,
    "chapter_id": 6680,
    "verse_number": "8.117",
    "content_sanskrit": "उपत्यकासु शैलानां कर्मठास्ते रिपुस्त्रियः । पिपासितास्सहाभीकैर्भ्रम्यन्ते बुभुक्षिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 117,
    "avatarnika": ""
  },
  {
    "id": 20011232,
    "chapter_id": 6680,
    "verse_number": "8.118",
    "content_sanskrit": "सहस्रं द्वादशं नॄणां सहस्रं त्रिंशमर्वताम् । दन्तिनाञ्च शतं विंशं हत्वा शस्त्रै रणक्षितौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 118,
    "avatarnika": ""
  },
  {
    "id": 20011233,
    "chapter_id": 6680,
    "verse_number": "8.119",
    "content_sanskrit": "जङ्घादघ्नीरकार्षीस्त्वं शूरशोणितनिम्नगाः । यावन्ति तेऽपदानानि तानि तावन्ति को वदेत् ? ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 119,
    "avatarnika": ""
  },
  {
    "id": 20011234,
    "chapter_id": 6680,
    "verse_number": "8.120",
    "content_sanskrit": "विश्राणयत नोऽमीषां शालीनां द्विमयं पयः । नेत्यादि जातु जल्पन्ति पौरास्ते गोमिनः परान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 120,
    "avatarnika": ""
  },
  {
    "id": 20011235,
    "chapter_id": 6680,
    "verse_number": "8.121",
    "content_sanskrit": "वसूनां नवमो नु त्वं रुद्राणां द्वादशोऽथवा । पाण्ड्याधिपतयाहोस्विदादित्यानां त्रयोदश ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 121,
    "avatarnika": ""
  },
  {
    "id": 20011236,
    "chapter_id": 6680,
    "verse_number": "8.122",
    "content_sanskrit": "सूक्तैः 'कयाशुभीयाद्यैर्यज्ञायज्ञीयभूषितैः । सामभिश्च वितन्वन्ति सप्त तन्तूंस्तवर्त्विजः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 122,
    "avatarnika": ""
  },
  {
    "id": 20011237,
    "chapter_id": 6680,
    "verse_number": "8.123",
    "content_sanskrit": "आकर्षक इव स्वर्णविशेपान् विदुषो विदन् । 'धनकं हरसि त्यागैस्तेषां त्वं सहिरण्यकम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 123,
    "avatarnika": ""
  },
  {
    "id": 20011238,
    "chapter_id": 6680,
    "verse_number": "8.124",
    "content_sanskrit": "राष्ट्रे नौदरिकः कश्चिच्छीतको वास्ति तावके । उष्णकास्त्वेव सर्वेत्र सुखिनो नखकेशकाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 124,
    "avatarnika": ""
  },
  {
    "id": 20011239,
    "chapter_id": 6680,
    "verse_number": "8.125",
    "content_sanskrit": "एवं सर्वगुणाढ्योपि नाधिकं भासि भूपते । अंशकेन कुमारेण सस्यकेन विनाकृतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 125,
    "avatarnika": ""
  },
  {
    "id": 20011240,
    "chapter_id": 6680,
    "verse_number": "8.126",
    "content_sanskrit": "प्राप्य ब्राह्मणकादेशादुष्णिका वा द्विजातयः । आश्रित्याढ्यं भवन्ति त्वामायुधीयास्सुतन्वकाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 126,
    "avatarnika": ""
  },
  {
    "id": 20011241,
    "chapter_id": 6680,
    "verse_number": "8.127",
    "content_sanskrit": "अपार्श्वको नरेन्द्र त्वमनायश्शूलिकस्सदा । द्रविणान्यार्जयस्यार्यैर्दण्डाजनिकैर्वृतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 127,
    "avatarnika": ""
  },
  {
    "id": 20011242,
    "chapter_id": 6680,
    "verse_number": "8.128",
    "content_sanskrit": "भवत्का पृथिवीपालभृत्याः कार्यभरान् सदा । आज्ञासिकाः शृङ्खलकाः करभा इव बिभ्रति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 128,
    "avatarnika": ""
  },
  {
    "id": 20011243,
    "chapter_id": 6680,
    "verse_number": "8.129",
    "content_sanskrit": "द्वितीयकोष्णकप्रष्ठव्याधिहीना नरास्तव । सुखायन्तोऽभिका राष्ट्रे स्युद्वास्सोत्कानुकाः प्रियाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 129,
    "avatarnika": ""
  },
  {
    "id": 20011244,
    "chapter_id": 6680,
    "verse_number": "8.130",
    "content_sanskrit": "आशीर्भिर्वर्धयन्ति त्वां श्राद्धेषु श्राद्धिका द्विजाः । अग्निष्टोमादियज्ञेषु श्रोत्रिया इष्टिनो बुधाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 130,
    "avatarnika": ""
  },
  {
    "id": 20011245,
    "chapter_id": 6680,
    "verse_number": "8.131",
    "content_sanskrit": "अधीतपूर्विणो वेदानर्थानुपदिनो बुधान् । त्वमर्चसि सदेशश्च साक्षिणं सर्वकर्मणाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 131,
    "avatarnika": ""
  },
  {
    "id": 20011246,
    "chapter_id": 6680,
    "verse_number": "8.132",
    "content_sanskrit": "उत्पाद्यन्ते खला राष्ट्राद्राजन्नार्यद्रुहस्त्वया । क्षेत्रियाणि तृणानीव क्षेत्रकृन्ति क्षमातलात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 132,
    "avatarnika": ""
  },
  {
    "id": 20011247,
    "chapter_id": 6680,
    "verse_number": "8.133",
    "content_sanskrit": "स त्वं सत्तनयं प्राप्तं दातुं कन्यां च जागृहि । महीपाल महाबुद्धे मा स्म हासीरनेहसम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 133,
    "avatarnika": ""
  },
  {
    "id": 20011248,
    "chapter_id": 6680,
    "verse_number": "8.134",
    "content_sanskrit": "इष्टीमखेषु निगमान् समधीतपूर्वी सन्तर्पितार्थिनिवहोऽन्वहमन्नपानैः । पृथ्वीश धारयसि यत् त्वमृणं पितृभ्यस्तद्दातुमाशु मतिमन् प्रवयो यतस्व ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 134,
