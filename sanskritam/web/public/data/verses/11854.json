[{"id": 50024381, "chapter_id": 11854, "verse_number": "1", "content_sanskrit": "॥ मेधातिथिः काण्वः। १ वायुः, २-३ इन्द्रवायू, ४-६ मित्रावरुणौ, ७-९ मरुतः (मरुत्वानिन्द्रो वा), १०-१२ विश्वेदेवाः, १३-१५ पूषा, १६-२२ आपः, २३ पूर्वार्धः - आपः, २३ उत्तरार्धः - अग्निः, २४- अग्निः। १-१८ गायत्री, १९ पुरउष्णिक्, २० अनुष्टुप्, २१ प्रतिष्ठा, २२-२४ अनुष्टुभः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024382, "chapter_id": 11854, "verse_number": "2", "content_sanskrit": "ती॒व्राः सोमा॑स॒ आ ग॑ह्या॒शीर्व॑न्तः सु॒ता इ॒मे। वायो॒ तान्प्रस्थि॑तान्पिब॥ २३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024383, "chapter_id": 11854, "verse_number": "3", "content_sanskrit": "उ॒भा दे॒वा दि॑वि॒स्पृशे॑न्द्रवा॒यू ह॑वामहे। अ॒स्य सोम॑स्य पी॒तये॑॥ २३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024384, "chapter_id": 11854, "verse_number": "4", "content_sanskrit": "इ॒न्द्र॒वा॒यू म॑नो॒जुवा॒ विप्रा॑ हवन्त ऊ॒तये॑। स॒ह॒स्रा॒क्षा धि॒यस्पती॑॥ २३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024385, "chapter_id": 11854, "verse_number": "5", "content_sanskrit": "मि॒त्रं व॒यं ह॑वामहे॒ वरु॑णं॒ सोम॑पीतये। ज॒ज्ञा॒ना पू॒तद॑क्षसा॥ २३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024386, "chapter_id": 11854, "verse_number": "6", "content_sanskrit": "ऋ॒तेन॒ यावृ॑ता॒वृधा॑वृ॒तस्य॒ ज्योति॑ष॒स्पती॑। ता मि॒त्रावरु॑णा हुवे॥ २३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024387, "chapter_id": 11854, "verse_number": "7", "content_sanskrit": "वरु॑णः प्रावि॒ता भु॑वन्मि॒त्रो विश्वा॑भिरू॒तिभि॑ः। कर॑तां नः सु॒राध॑सः॥ २३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024388, "chapter_id": 11854, "verse_number": "8", "content_sanskrit": "म॒रुत्व॑न्तं हवामह॒ इन्द्र॒मा सोम॑पीतये। स॒जूर्ग॒णेन॑ तृम्पतु॥ २३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50024389, "chapter_id": 11854, "verse_number": "9", "content_sanskrit": "इन्द्र॑ज्येष्ठा॒ मरु॑द्गणा॒ देवा॑स॒ः पूष॑रातयः। विश्वे॒ मम॑ श्रुता॒ हव॑म्॥ २३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50024390, "chapter_id": 11854, "verse_number": "10", "content_sanskrit": "ह॒त वृ॒त्रं सु॑दानव॒ इन्द्रे॑ण॒ सह॑सा यु॒जा। मा नो॑ दु॒ःशंस॑ ईशत॥ २३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50024391, "chapter_id": 11854, "verse_number": "11", "content_sanskrit": "विश्वा॑न्दे॒वान्ह॑वामहे म॒रुत॒ः सोम॑पीतये। उ॒ग्रा हि पृश्नि॑मातरः॥ २३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50024392, "chapter_id": 11854, "verse_number": "12", "content_sanskrit": "जय॑तामिव तन्य॒तुर्म॒रुता॑मेति धृष्णु॒या। यच्छुभं॑ या॒थना॑ नरः॥ २३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50024393, "chapter_id": 11854, "verse_number": "13", "content_sanskrit": "ह॒स्का॒राद्वि॒द्युत॒स्पर्यतो॑ जा॒ता अ॑वन्तु नः। म॒रुतो॑ मृळयन्तु नः॥ २३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50024394, "chapter_id": 11854, "verse_number": "14", "content_sanskrit": "आ पू॑षञ्चि॒त्रब॑र्हिष॒माघृ॑णे ध॒रुणं॑ दि॒वः। आजा॑ न॒ष्टं यथा॑ प॒शुम्॥ २३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50024395, "chapter_id": 11854, "verse_number": "15", "content_sanskrit": "पू॒षा राजा॑न॒माघृ॑णि॒रप॑गूळ्हं॒ गुहा॑ हि॒तम्। अवि॑न्दच्चि॒त्रब॑र्हिषम्॥ २३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50024396, "chapter_id": 11854, "verse_number": "16", "content_sanskrit": "उ॒तो स मह्य॒मिन्दु॑भि॒ः षड्यु॒क्ताँ अ॑नु॒सेषि॑धत्। गोभि॒र्यवं॒ न च॑र्कृषत्॥ २३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50024397, "chapter_id": 11854, "verse_number": "17", "content_sanskrit": "अ॒म्बयो॑ य॒न्त्यध्व॑भिर्जा॒मयो॑ अध्वरीय॒ताम्। पृ॒ञ्च॒तीर्मधु॑ना॒ पय॑ः॥ २३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50024398, "chapter_id": 11854, "verse_number": "18", "content_sanskrit": "अ॒मूर्या उप॒ सूर्ये॒ याभि॑र्वा॒ सूर्य॑ः स॒ह। ता नो॑ हिन्वन्त्वध्व॒रम्॥ २३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50024399, "chapter_id": 11854, "verse_number": "19", "content_sanskrit": "अ॒पो दे॒वीरुप॑ ह्वये॒ यत्र॒ गाव॒ः पिब॑न्ति नः। सिन्धु॑भ्य॒ः कर्त्वं॑ ह॒विः॥ २३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50024400, "chapter_id": 11854, "verse_number": "20", "content_sanskrit": "अ॒प्स्व१॒॑न्तर॒मृत॑म॒प्सु भे॑ष॒जम॒पामु॒त प्रश॑स्तये। देवा॒ भव॑त वा॒जिन॑ः॥ २३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50024401, "chapter_id": 11854, "verse_number": "21", "content_sanskrit": "अ॒प्सु मे॒ सोमो॑ अब्रवीद॒न्तर्विश्वा॑नि भेष॒जा। अ॒ग्निं च॑ वि॒श्वश॑म्भुव॒माप॑श्च वि॒श्वभे॑षजीः॥ २३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50024402, "chapter_id": 11854, "verse_number": "22", "content_sanskrit": "आप॑ः पृणी॒त भे॑ष॒जं वरू॑थं त॒न्वे॒३॒॑ मम॑। ज्योक्च॒ सूर्यं॑ दृ॒शे॥ २३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50024403, "chapter_id": 11854, "verse_number": "23", "content_sanskrit": "इ॒दमा॑प॒ः प्र व॑हत॒ यत्किं च॑ दुरि॒तं मयि॑। यद्वा॒हम॑भिदु॒द्रोह॒ यद्वा॑ शे॒प उ॒तानृ॑तम्॥ २३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50024404, "chapter_id": 11854, "verse_number": "24", "content_sanskrit": "आपो॑ अ॒द्यान्व॑चारिषं॒ रसे॑न॒ सम॑गस्महि। पय॑स्वानग्न॒ आ ग॑हि॒ तं मा॒ सं सृ॑ज॒ वर्च॑सा॥ २३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50024405, "chapter_id": 11854, "verse_number": "25", "content_sanskrit": "सं मा॑ग्ने॒ वर्च॑सा सृज॒ सं प्र॒जया॒ समायु॑षा। वि॒द्युर्मे॑ अस्य दे॒वा इन्द्रो॑ विद्यात्स॒ह ऋषि॑भिः॥ २३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]