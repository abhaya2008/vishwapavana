[{"id": 2186936, "chapter_id": 4975, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2186937, "chapter_id": 4975, "verse_number": "१", "content_sanskrit": "कीदृशो निरयं याति जापको वर्णयस्व मे ।\nकौतूहलं हि मे जातं तद् भवान् वक्तुमर्हति\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2186938, "chapter_id": 4975, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2186939, "chapter_id": 4975, "verse_number": "२", "content_sanskrit": "धर्मस्यांशः प्रसूतोऽसि धर्मिष्ठोऽसि स्वभावतः ।\nधर्ममूलाश्रयं वाक्यं शृणुष्वावहितोऽनघ\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2186940, "chapter_id": 4975, "verse_number": "३", "content_sanskrit": "अमूनि यानि स्थानानि देवानां परमात्मनाम् ।\nनानासंस्थानवर्णानि नानारूपफलानि च\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2186941, "chapter_id": 4975, "verse_number": "४", "content_sanskrit": "दिव्यानि कामचारीणि विमानानि सभास्तथा ।\nआक्रीडा विविधा राजन् पद्मिन्यश्चामलोदकाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2186942, "chapter_id": 4975, "verse_number": "५", "content_sanskrit": "चतुर्णां लोकपालानां शुक्रस्याथ बृहस्पतेः ।\nमरुतां विश्वदेवानां साध्यानामश्विनोरपि\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2186943, "chapter_id": 4975, "verse_number": "६", "content_sanskrit": "रुद्रादित्यवसूनां च तथान्येषां दिवौकसाम् ।\nएते वै निरयास्तात स्थानस्य परमात्मनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2186944, "chapter_id": 4975, "verse_number": "७", "content_sanskrit": "अभयं चानिमित्तं च न च क्लेशभयावृतम् ।\nद्वाभ्यां युक्तं त्रिभिर्मुक्तमष्टाभिस्त्रिभिरेव च\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2186945, "chapter_id": 4975, "verse_number": "८", "content_sanskrit": "चतुर्लक्षणवर्जं तु चतुष्कारणवर्जितम् ।\nअप्रहर्षमनानन्दमशोकं विगतक्लमम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2186946, "chapter_id": 4975, "verse_number": "९", "content_sanskrit": "कालः संवहते तत्र न कालस्तत्र वै प्रभुः ।\nस कालस्य प्रभू राजन् स्वर्गस्यापि तथेश्वरः ।\nएतद्वै ब्रह्मणः स्थानं जापकस्य महात्मनः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2186947, "chapter_id": 4975, "verse_number": "१०", "content_sanskrit": "तत्रस्थं परमात्मानं ध्यायन् वै सुसमाहितः ।\nहिरण्यगर्भः सायुज्यं प्राप्नुयाद्वा नृपोत्तम \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2186948, "chapter_id": 4975, "verse_number": "११", "content_sanskrit": "आत्मकेवलतां प्राप्तस्तत्र गत्वा न शोचति ।\nईदृशं परमं स्थानं निरयास्ते च तादृशाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2186949, "chapter_id": 4975, "verse_number": "१२", "content_sanskrit": "एते ते निरयाः प्रोक्ताः सर्व एव यथातथम् ।\nतस्य स्थानवरस्येह सर्वे निरयसञ्ज्ञिताः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2186950, "chapter_id": 4975, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे चतुर्विंशोऽध्यायः ॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]