[{"id": 2047005, "chapter_id": 2042, "verse_number": "६-९१-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2047006, "chapter_id": 2042, "verse_number": "६-९१-१", "content_sanskrit": "इरावन्तं तु निहतं दृष्ट्वा पार्था महारथाः ।\nसंग्रामे किमकुर्वन्त तन्ममाचक्ष्व सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2047007, "chapter_id": 2042, "verse_number": "६-९१-२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2047008, "chapter_id": 2042, "verse_number": "६-९१-२", "content_sanskrit": "इरावन्तं तु निहतं संग्रामे वीक्ष्य राक्षसः।\nव्यनदत्सुमहानादं भैमसेनिर्घटोत्कचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2047009, "chapter_id": 2042, "verse_number": "६-९१-३", "content_sanskrit": "नदतस्तस्य शब्देन पृथिवी सागराम्बरा ।\nसपर्वतवना राजंश्चचाल सुभृशं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2047010, "chapter_id": 2042, "verse_number": "६-९१-४", "content_sanskrit": "अन्तरिक्षं दिशश्चैव सर्वाश्च प्रदिशस्तथा ।\n`चेलुश्च सहसा तत्र तेन नादेन नादिताः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2047011, "chapter_id": 2042, "verse_number": "६-९१-५", "content_sanskrit": "तं श्रुत्वा सुमहानादं तव सैन्यस्य भारत ॥\nऊरुस्तम्भः समभवद्वेपथुः स्वेद एव च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2047012, "chapter_id": 2042, "verse_number": "६-९१-६", "content_sanskrit": "सर्व एव महाराज तावका दीनचेतसः ॥\nसर्वतः समचेष्टन्त सिंहभीता गजा इव ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2047013, "chapter_id": 2042, "verse_number": "६-९१-७", "content_sanskrit": "नर्दित्वा सुमहानादं निर्घातमिव राक्षसः ॥\nज्वलितं शूलमुद्यम्य रूपं कृत्वा विभीषणम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2047014, "chapter_id": 2042, "verse_number": "६-९१-८", "content_sanskrit": "नानारूपप्रहरणैर्वृतो राक्षसपुङ्गवैः ॥\nआजघान सुसंक्रुद्धः कालान्तकयमोपभः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2047015, "chapter_id": 2042, "verse_number": "६-९१-९", "content_sanskrit": "तमापतन्तं संप्रेक्ष्य संक्रुद्धं भीमदर्शनम् ॥\nस्वबलं च भयात्तस्य प्रायशो विमुखीकृतम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2047016, "chapter_id": 2042, "verse_number": "६-९१-१०", "content_sanskrit": "ततो दुर्योधनो राजा घटोत्कचमुपाद्रवत् ॥\nप्रगृह्य विपुलं चापं सिंहवद्विनदन्मुहुः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2047017, "chapter_id": 2042, "verse_number": "६-९१-११", "content_sanskrit": "पृष्ठतोऽनुययौ चैनं स्रवद्भिः पर्वतोपमैः ॥\nकुञ्जरैर्दशसाहस्रैर्वङ्गानामधिपः स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2047018, "chapter_id": 2042, "verse_number": "६-९१-१२", "content_sanskrit": "पुत्रं तव महाराज चुकोप स निशाचरः ।\nततः प्रववृते युद्धं तुमुलं रोमहर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2047019, "chapter_id": 2042, "verse_number": "६-९१-१३", "content_sanskrit": "राक्षसानां च राजेन्द्र दुर्योधनबलस्य च।\nगजानीकं च संप्रेक्ष्य मेघबृन्दमिवोदितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2047020, "chapter_id": 2042, "verse_number": "६-९१-१४", "content_sanskrit": "अभ्यधावन्त संक्रुद्धा राक्षसाः शस्त्रपाणयः ।\nनदन्तो विविधान्नादान्मेघा इव सविद्युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2047021, "chapter_id": 2042, "verse_number": "६-९१-१५", "content_sanskrit": "शरशक्त्यृष्टिनाराचैर्निघ्नन्तो गजयोधिनः ।\nभिण्डिपालैस्तथा शूलैर्मुद्गरैः सपरश्वथैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2047022, "chapter_id": 2042, "verse_number": "६-९१-१६", "content_sanskrit": "पर्वताग्रैश्च वृक्षैश्च निजघ्नुस्ते महागजान् ।\nभिन्नकुम्भान्विरुधिरान्भिन्नगात्रांश्च वारणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2047023, "chapter_id": 2042, "verse_number": "६-९१-१७", "content_sanskrit": "अपश्याम महाराज वध्यमानान्निशाचरैः ।\nतेषु प्रक्षीयमाणेषु भग्नेषु गजयोधिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2047024, "chapter_id": 2042, "verse_number": "६-९१-१८", "content_sanskrit": "दुर्योधनो महाराज राक्षसान्समुपाद्रवत्।\nअमर्षवशमापन्नस्त्यक्त्वा जीवितात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2047025, "chapter_id": 2042, "verse_number": "६-९१-१९", "content_sanskrit": "मुमोच निशितान्बाणान्राक्षसेषु परंतप ।\nजघान च महेष्वासः प्रधानांस्तत्र राक्षसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2047026, "chapter_id": 2042, "verse_number": "६-९१-२०", "content_sanskrit": "संक्रुद्धो भरतश्रेष्ठ पुत्रो दुर्योधनस्तव ।\nवेगवन्तं महारौद्रं विद्युज्जिह्वं प्रमाथिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2047027, "chapter_id": 2042, "verse_number": "६-९१-२१", "content_sanskrit": "शरैश्चतुर्भिश्चतुरो निजघान महाबलः ।\nततः पुनरमेयात्मा शरवर्षं दुरासदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2047028, "chapter_id": 2042, "verse_number": "६-९१-२२", "content_sanskrit": "मुमोच भरतश्रेष्ठो निशाचरबलं प्रति।\nतत्तु दृष्ट्वा महत्कर्म पुत्रस्य तव मारिष ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2047029, "chapter_id": 2042, "verse_number": "६-९१-२३", "content_sanskrit": "क्रोधेनाभिप्रजज्वाल भैमसेनिर्महाबलः ।\nस विष्फार्य महच्चापमिन्द्राशनिसमप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2047030, "chapter_id": 2042, "verse_number": "६-९१-२४", "content_sanskrit": "अभिदुद्राव वेगेन दुर्योधनमरिन्दमम् ।\nतमापतन्तमुद्वीक्ष्य कालसृष्टमिवान्तकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2047031, "chapter_id": 2042, "verse_number": "६-९१-२५", "content_sanskrit": "न विव्यथे महाराज पुत्रो दुर्योधनस्तव।\nअथैनमब्रवीत्क्रुद्धः क्रूरः संरक्तलोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2047032, "chapter_id": 2042, "verse_number": "६-९१-२६x", "content_sanskrit": "घटोत्कच उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2047033, "chapter_id": 2042, "verse_number": "६-९१-२६", "content_sanskrit": "अद्यानृण्यं गमिष्यामि पितॄणां मातुरेव च।\nये त्वया सुनृशंसेन दीर्घकालं प्रवासिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2047034, "chapter_id": 2042, "verse_number": "६-९१-२७", "content_sanskrit": "यच्च ते पाण्डवा राजंश्छलद्यूते पराजिताः ।\nयच्चैव द्रौपदी कृष्णा एववस्त्रा रजस्वला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2047035, "chapter_id": 2042, "verse_number": "६-९१-२८", "content_sanskrit": "सभामानीय दुर्बुद्धे बहुधा क्लेशिता त्वया।\nतव च प्रियकामेन आश्रमस्था दुरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2047036, "chapter_id": 2042, "verse_number": "६-९१-२९", "content_sanskrit": "सैन्धवेन परामृष्टा परिभूय पितॄन्मम ।\nएतेषामपमानानामन्येषां च कुलाधम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2047037, "chapter_id": 2042, "verse_number": "६-९१-३०", "content_sanskrit": "अन्तमद्य गमिष्यामि यदि नोत्सृजसे रणम्।\nएवमुक्त्वा तु हैडिम्बो महद्विष्फार्य कार्मुकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2047038, "chapter_id": 2042, "verse_number": "६-९१-३१", "content_sanskrit": "संदश्य दशनैरोष्ठं सृकिणी परिसंलिहन्।\nशरवर्षेण महता दुर्योधनमवाकिरत्।\nपर्वतं वारिधाराभिः प्रावृषीव बलाहकः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2047039, "chapter_id": 2042, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि अष्टमदिवसयुद्धे एकनवतितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]