[{"id": 40019904, "chapter_id": 9322, "verse_number": "1", "content_sanskrit": "अथ पुत्रः पुलस्त्यस्य विश्रवा मुनिपुङ्गवः । अचिरेणैव कालेन पितेव तपसि स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40019905, "chapter_id": 9322, "verse_number": "2", "content_sanskrit": "सत्यवाञ्छीलवाञ्छान्तः स्वाध्यायनिरतः शुचिः । सर्वभोगेष्वसंसक्तो नित्यं धर्मपरायणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40019906, "chapter_id": 9322, "verse_number": "3", "content_sanskrit": "ज्ञात्वा तस्य तु तद्वृत्तं भरद्वाजो महामुनिः । ददौ विश्रवसे भार्यां स्वसुतां देववर्णिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40019907, "chapter_id": 9322, "verse_number": "4", "content_sanskrit": "प्रतिगृह्य तु धर्मेण भरद्वाजसुतां तदा । प्रजान्वेक्षिकया बुद्ध्या श्रेयो ह्यस्य विचिन्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40019908, "chapter_id": 9322, "verse_number": "5", "content_sanskrit": "मुदा परमया युक्तो विश्रवा मुनिपुङ्गवः । स तस्यां वीर्यसम्पन्नमपत्यं परमाद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40019909, "chapter_id": 9322, "verse_number": "6", "content_sanskrit": "जनयामास धर्मज्ञः सर्वैर्ब्रह्मगुणैर्युतम् । तस्मिञ्जाते तु संहृष्टः सम्बभूव पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40019910, "chapter_id": 9322, "verse_number": "7", "content_sanskrit": "दृष्ट्वा श्रेयस्करीं बुद्धिं धनाध्यक्षो भविष्यति । नाम तस्याकरोत्प्रीतः सार्धं देवर्षिभिस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40019911, "chapter_id": 9322, "verse_number": "8", "content_sanskrit": "यस्माद्विश्रवसो ऽपत्यं सादृश्याद्विश्रवा इव । तस्माद्वैश्रवणो नाम भविष्यत्वेष विश्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40019912, "chapter_id": 9322, "verse_number": "9", "content_sanskrit": "स तु वैश्रवणस्तत्र तपोवनगतस्तदा । अवर्धताहुतिहुतो महातेजा यथानलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40019913, "chapter_id": 9322, "verse_number": "10", "content_sanskrit": "तस्याश्रमपदस्थस्य बुद्धिर्जज्ञे महात्मनः । चरिष्ये परमं धर्मं धर्मो हि परमा गतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40019914, "chapter_id": 9322, "verse_number": "11", "content_sanskrit": "स तु वर्षसहस्राणि तपस्तप्त्वा महावने । यन्त्रितो नियमैरुग्रैश्चकार सुमहत्तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40019915, "chapter_id": 9322, "verse_number": "12", "content_sanskrit": "पूर्णे वर्षसहस्रान्ते तं तं विधिमकल्पयत् । जलाशी मारुताहारो निराहारस्तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40019916, "chapter_id": 9322, "verse_number": "13", "content_sanskrit": "एवं वर्षसहस्राणि जग्मुस्तान्येकवर्षवत् । अथ प्रीतो महातेजाः सेन्द्रैः सुरगणैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40019917, "chapter_id": 9322, "verse_number": "14", "content_sanskrit": "गत्वा तस्याश्रमपदं ब्रह्मेदं वाक्यमब्रवीत् । परितुष्टो ऽस्मि ते वत्स कर्मणानेन सुव्रत । वरं वृणीष्व भद्रं ते वरार्हस्त्वं महामते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40019918, "chapter_id": 9322, "verse_number": "15", "content_sanskrit": "अथाब्रवीद्वैश्रवणः पितामहमुपस्थितम् । भगवँल्लोकपालत्वमिच्छेयं वित्तरक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40019919, "chapter_id": 9322, "verse_number": "16", "content_sanskrit": "अथाब्रवीद्वैश्रवणं परितुष्टेन चेतसा । ब्रह्मा सुरगणैः सार्धं बाढमित्येव हृष्टवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40019920, "chapter_id": 9322, "verse_number": "17", "content_sanskrit": "अहं वै लोकपालानां चतुर्थं स्रष्टुमुद्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40019921, "chapter_id": 9322, "verse_number": "18", "content_sanskrit": "यमेन्द्रवरुणानां च पदं यत्तव चेप्सितम् । तद्गच्छ त्वं हि धर्मज्ञ निधीशत्वमवाप्नुहि । शक्राम्बुपयमानां च चतुर्थस्त्वं भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40019922, "chapter_id": 9322, "verse_number": "19", "content_sanskrit": "एतच्च पुष्पकं नाम विमानं सूर्यसन्निभम् । प्रतिगृह्णीष्व यानार्थं त्रिदशैः समतां व्रज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40019923, "chapter_id": 9322, "verse_number": "20", "content_sanskrit": "स्वस्ति ते ऽस्तु गमिष्यामः सर्व एव यथागतम् । कृतकृत्या वयं तात दत्त्वा तव वरद्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40019924, "chapter_id": 9322, "verse_number": "21", "content_sanskrit": "इत्युक्त्वा स गतो ब्रह्मा स्वस्थानं त्रिदशैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40019925, "chapter_id": 9322, "verse_number": "22", "content_sanskrit": "गतेषु ब्रह्मपूर्वेषु देवेष्वथ नभस्थलम् । वने स पितरं प्राह प्राञ्जलिः प्रयतात्मवान् । निवासनं न मे देवो विदधे स प्रजापतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40019926, "chapter_id": 9322, "verse_number": "23", "content_sanskrit": "भगवँल्लब्धवानस्मि वरमिष्टं पितामहात् । तं पश्य भगवन्कञ्चिन्निवासं साधु मे प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40019927, "chapter_id": 9322, "verse_number": "24", "content_sanskrit": "न च पीडा भवेद्यत्र प्राणिनो यस्य कस्यचित् । एवमुक्तस्तु पुत्रेण विश्रवा मुनिपुङ्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40019928, "chapter_id": 9322, "verse_number": "25", "content_sanskrit": "वचनं प्राह धर्मज्ञः श्रूयतामिति सत्तमः । दक्षिणस्योदधेस्तीरे त्रिकूटो नाम पर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40019929, "chapter_id": 9322, "verse_number": "26", "content_sanskrit": "तस्याग्रे तु विशाला सा महेन्द्रस्य पुरी यथा । लङ्का नाम पुरी रम्या निर्मिता विश्वकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40019930, "chapter_id": 9322, "verse_number": "27", "content_sanskrit": "राक्षसानां निवासार्थं यथेन्द्रस्यामरावती । तत्र त्वं वस भद्रं ते लङ्कायां नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40019931, "chapter_id": 9322, "verse_number": "28", "content_sanskrit": "हेमप्राकारपरिघा यन्त्रशस्त्रसमावृता । रमणीया पुरी सा हि रुक्मवैडूर्यतोरणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40019932, "chapter_id": 9322, "verse_number": "29", "content_sanskrit": "राक्षसैः सा परित्यक्ता पुरा विष्णुभयार्दितैः । शून्या रक्षोगणैः सर्वै रसातलतलं गतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40019933, "chapter_id": 9322, "verse_number": "30", "content_sanskrit": "शून्या सम्प्रति लङ्का सा प्रभुस्तस्या न विद्यते । स त्वं तत्र निवासाय गच्छ पुत्र यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40019934, "chapter_id": 9322, "verse_number": "31", "content_sanskrit": "निर्दोषस्तत्र ते वासो न बाधास्तत्र कस्यचित् । एतच्छुत्वा स धर्मात्मा धर्मिष्ठं वचनं पितुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40019935, "chapter_id": 9322, "verse_number": "32", "content_sanskrit": "निवासयामास तदा लङ्कां पर्वतमूर्धनि । नैर्ऋतानां सहस्रैस्तु हृष्टैः प्रमुदुतैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40019936, "chapter_id": 9322, "verse_number": "33", "content_sanskrit": "अचिरेणैव कालेन सम्पूर्णा तस्य शासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40019937, "chapter_id": 9322, "verse_number": "34", "content_sanskrit": "स तु तत्रावसत्प्रीतो धर्मात्मा नैर्ऋतर्षभः । समुद्रपरिघायां तु लङ्कायां विश्रवात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40019938, "chapter_id": 9322, "verse_number": "35", "content_sanskrit": "काले काले तु धर्मात्मा पुष्पकेण धनेश्वरः । अभ्यागच्छद्विनीतात्मा पितरं मातरं च हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40019939, "chapter_id": 9322, "verse_number": "36", "content_sanskrit": "स देवगन्धर्वगणैरभिष्टुतस्तथाप्सरोनृत्यविभूषितालयः । गभस्तिभिः सूर्य इवावभासयन्पितुः समीपं प्रययौ स वित्तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]