[{"id": 5000322000, "chapter_id": 9322, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे पञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000322001, "chapter_id": 9322, "verse_number": "४-५०-१", "content_sanskrit": "सह ताराङ्गदाभ्यां तु संगम्य हनुमान् कपिः।\nविचिनोति च विन्ध्यस्य गुहाश्च गहनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000322002, "chapter_id": 9322, "verse_number": "४-५०-२", "content_sanskrit": "सिंहशार्दूलजुष्टाश्च गुहाश्च परितस्तदा।\nविषमेषु नगेन्द्रस्य महाप्रस्रवणेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000322003, "chapter_id": 9322, "verse_number": "४-५०-३", "content_sanskrit": "आसेदुस्तस्य शैलस्य कोटिं दक्षिणपश्चिमाम्।\nतेषां तत्रैव वसतां स कालो व्यत्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000322004, "chapter_id": 9322, "verse_number": "४-५०-४", "content_sanskrit": "स हि देशो दुरन्वेष्यो गुहागहनवान् महान्।\nतत्र वायुसुतः सर्वं विचिनोति स्म पर्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000322005, "chapter_id": 9322, "verse_number": "४-५०-५", "content_sanskrit": "परस्परेण रहिता अन्योन्यस्याविदूरतः।\nगजो गवाक्षो गवयः शरभो गन्धमादनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000322006, "chapter_id": 9322, "verse_number": "४-५०-६", "content_sanskrit": "मैन्दश्च द्विविदश्चैव हनूमान् जाम्बवानपि।\nअङ्गदो युवराजश्च तारश्च वनगोचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000322007, "chapter_id": 9322, "verse_number": "४-५०-७", "content_sanskrit": "गिरिजालावृतान् देशान् मार्गित्वा दक्षिणां दिशम्।\nविचिन्वन्तस्ततस्तत्र ददृशुर्विवृतं बिलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000322008, "chapter_id": 9322, "verse_number": "४-५०-८", "content_sanskrit": "दुर्गमृक्षबिलं नाम दानवेनाभिरक्षितम्।\nक्षुत्पिपासापरीतास्तु श्रान्तास्तु सलिलार्थिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000322009, "chapter_id": 9322, "verse_number": "४-५०-९", "content_sanskrit": "अवकीर्णं लतावृक्षैर्ददृशुस्ते महाबिलम्।\nतत्र क्रौञ्चाश्च हंसाश्च सारसाश्चापि निष्क्रमन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000322010, "chapter_id": 9322, "verse_number": "४-५०-१०", "content_sanskrit": "जलार्द्राश्चक्रवाकाश्च रक्ताङ्गाः पद्मरेणुभिः।\nततस्तद् बिलमासाद्य सुगन्धि दुरतिक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000322011, "chapter_id": 9322, "verse_number": "४-५०-११", "content_sanskrit": "विस्मयव्यग्रमनसो बभूवुर्वानरर्षभाः।\nसंजातपरिशङ्कास्ते तद् बिलं प्लवगोत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000322012, "chapter_id": 9322, "verse_number": "४-५०-१२", "content_sanskrit": "अभ्यपद्यन्त संहृष्टास्तेजोवन्तो महाबलाः।\nनानासत्त्वसमाकीर्णं दैत्येन्द्रनिलयोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000322013, "chapter_id": 9322, "verse_number": "४-५०-१३", "content_sanskrit": "दुर्दर्शमिव घोरं च दुर्विगाह्यं च सर्वशः।\nततः पर्वतकूटाभो हनूमान् मारुतात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000322014, "chapter_id": 9322, "verse_number": "४-५०-१४", "content_sanskrit": "अब्रवीद् वानरान् घोरान् कान्तारवनकोविदः।\nगिरिजालावृतान् देशान् मार्गित्वा दक्षिणां दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000322015, "chapter_id": 9322, "verse_number": "४-५०-१५", "content_sanskrit": "वयं सर्वे परिश्रान्ता न च पश्याम मैथिलीम्।\nअस्माच्चापि बिलाद्धंसाः क्रौञ्चाश्च सह सारसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000322016, "chapter_id": 9322, "verse_number": "४-५०-१६", "content_sanskrit": "जलार्द्राश्चक्रवाकाश्च निष्पतन्ति स्म सर्वशः।\nनूनं सलिलवानत्र कूपो वा यदि वा ह्रदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000322017, "chapter_id": 9322, "verse_number": "४-५०-१७", "content_sanskrit": "तथा चेमे बिलद्वारे स्निग्धास्तिष्ठन्ति पादपाः।\nइत्युक्तास्तद् बिलं सर्वे विविशुस्तिमिरावृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000322018, "chapter_id": 9322, "verse_number": "४-५०-१८", "content_sanskrit": "अचन्द्रसूर्यं हरयो ददृशू रोमहर्षणम्।\nनिशाम्य तस्मात् सिंहांश्च तांस्तांश्च मृगपक्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000322019, "chapter_id": 9322, "verse_number": "४-५०-१९", "content_sanskrit": "प्रविष्टा हरिशार्दूला बिलं तिमिरसंवृतम्।\nन तेषां सज्जते दृष्टिर्न तेजो न पराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000322020, "chapter_id": 9322, "verse_number": "४-५०-२०", "content_sanskrit": "वायोरिव गतिस्तेषां दृष्टिस्तमसि वर्तते।\nते प्रविष्टास्तु वेगेन तद् बिलं कपिकुञ्जराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000322021, "chapter_id": 9322, "verse_number": "४-५०-२१", "content_sanskrit": "प्रकाशं चाभिरामं च ददृशुर्देशमुत्तमम्।\nततस्तस्मिन् बिले भीमे नानापादपसंकुले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000322022, "chapter_id": 9322, "verse_number": "४-५०-२२", "content_sanskrit": "अन्योन्यं सम्परिष्वज्य जग्मुर्योजनमन्तरम्।\nते नष्टसंज्ञास्तृषिताः सम्भ्रान्ताः सलिलार्थिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000322023, "chapter_id": 9322, "verse_number": "४-५०-२३", "content_sanskrit": "परिपेतुर्बिले तस्मिन् कंचित् कालमतन्द्रिताः।\nते कृशा दीनवदनाः परिश्रान्ताः प्लवङ्गमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000322024, "chapter_id": 9322, "verse_number": "४-५०-२४", "content_sanskrit": "आलोकं ददृशुर्वीरा निराशा जीविते यदा।\nततस्तं देशमागम्य सौम्या वितिमिरं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000322025, "chapter_id": 9322, "verse_number": "४-५०-२५", "content_sanskrit": "ददृशुः काञ्चनान् वृक्षान् दीप्तवैश्वानरप्रभान्।\nसालांस्तालांस्तमालांश्च पुंनागान् वञ्जुलान् धवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000322026, "chapter_id": 9322, "verse_number": "४-५०-२६", "content_sanskrit": "चम्पकान् नागवृक्षांश्च कर्णिकारांश्च पुष्पितान्।\nस्तबकैः काञ्चनैश्चित्रै रक्तैः किसलयैस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000322027, "chapter_id": 9322, "verse_number": "४-५०-२७", "content_sanskrit": "आपीडैश्च लताभिश्च हेमाभरणभूषितान्।\nतरुणादित्यसंकाशान् वैदूर्यमयवेदिकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000322028, "chapter_id": 9322, "verse_number": "४-५०-२८", "content_sanskrit": "बिभ्राजमानान् वपुषा पादपांश्च हिरण्मयान्।\nनीलवैदूर्यवर्णाश्च पद्मिनीः पतगैर्वृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000322029, "chapter_id": 9322, "verse_number": "४-५०-२९", "content_sanskrit": "महद्भिः काञ्चनैर्वृक्षैर्वृता बालार्कसंनिभैः।\nजातरूपमयैर्मत्स्यैर्महद्भिश्चाथ पङ्कजैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000322030, "chapter_id": 9322, "verse_number": "४-५०-३०", "content_sanskrit": "नलिनीस्तत्र ददृशुः प्रसन्नसलिलायुताः।\nकाञ्चनानि विमानानि राजतानि तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000322031, "chapter_id": 9322, "verse_number": "४-५०-३१", "content_sanskrit": "तपनीयगवाक्षाणि मुक्ताजालावृतानि च।\nहैमराजतभौमानि वैदूर्यमणिमन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000322032, "chapter_id": 9322, "verse_number": "४-५०-३२", "content_sanskrit": "ददृशुस्तत्र हरयो गृहमुख्यानि सर्वशः।\nपुष्पितान् फलिनो वृक्षान् प्रवालमणिसंनिभान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000322033, "chapter_id": 9322, "verse_number": "४-५०-३३", "content_sanskrit": "काञ्चनभ्रमरांश्चैव मधूनि च समन्ततः।\nमणिकाञ्चनचित्राणि शयनान्यासनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000322034, "chapter_id": 9322, "verse_number": "४-५०-३४", "content_sanskrit": "विविधानि विशालानि ददृशुस्ते समन्ततः।\nहैमराजतकांस्यानां भाजनानां च राशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000322035, "chapter_id": 9322, "verse_number": "४-५०-३५", "content_sanskrit": "अगुरूणां च दिव्यानां चन्दनानां च संचयान्।\nशुचीन्यभ्यवहाराणि मूलानि च फलानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000322036, "chapter_id": 9322, "verse_number": "४-५०-३६", "content_sanskrit": "महार्हाणि च यानानि मधूनि रसवन्ति च।\nदिव्यानामम्बराणां च महार्हाणां च संचयान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000322037, "chapter_id": 9322, "verse_number": "४-५०-३७", "content_sanskrit": "कम्बलानां च चित्राणामजिनानां च संचयान्।\nतत्र तत्र च विन्यस्तान् दीप्तान् वैश्वानरप्रभान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000322038, "chapter_id": 9322, "verse_number": "४-५०-३८", "content_sanskrit": "ददृशुर्वानराः शुभ्राञ्जातरूपस्य संचयान्।\nतत्र तत्र विचिन्वन्तो बिले तत्र महाप्रभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000322039, "chapter_id": 9322, "verse_number": "४-५०-३९", "content_sanskrit": "ददृशुर्वानराः शूराः स्त्रियं कांचिददूरतः।\nतां च ते ददृशुस्तत्र चीरकृष्णाजिनाम्बराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000322040, "chapter_id": 9322, "verse_number": "४-५०-४०", "content_sanskrit": "तापसीं नियताहारां ज्वलन्तीमिव तेजसा।\nविस्मिता हरयस्तत्र व्यवतिष्ठन्त सर्वशः।\nपप्रच्छ हनुमांस्तत्र कासि त्वं कस्य वा बिलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000322041, "chapter_id": 9322, "verse_number": "४-५०-४१", "content_sanskrit": "ततो हनूमान् गिरिसंनिकाशः\nकृताञ्जलिस्तामभिवाद्य वृद्धाम्।\nपप्रच्छ का त्वं भवनं बिलं च\nरत्नानि चेमानि वदस्व कस्य ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000322042, "chapter_id": 9322, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे पञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]