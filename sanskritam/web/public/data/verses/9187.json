[{"id": 40014090, "chapter_id": 9187, "verse_number": "1", "content_sanskrit": "एवमुक्तस्तु हनुमान् राघवेण महात्मना। सीताया भाषितं सर्वं न्यवेदयत राघवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40014091, "chapter_id": 9187, "verse_number": "2", "content_sanskrit": "इदमुक्तवती देवी जानकी पुरुषर्षभ। पूर्व वृत्तमभिज्ञानं चित्रकूटे यथातथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40014092, "chapter_id": 9187, "verse_number": "3", "content_sanskrit": "सुखसुप्ता त्वया सार्धं जानकी पूर्वमुत्थिता। वायस स्सहसोत्पत्य विददार स्तनान्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40014093, "chapter_id": 9187, "verse_number": "4", "content_sanskrit": "पर्यायेण च सुप्तस्त्वं देव्यङ्के भरताग्रज। पुनश्च किल पक्षी स देव्या जनयति व्यथाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40014094, "chapter_id": 9187, "verse_number": "5", "content_sanskrit": "पुनः पुनरुपागम्य विददार भृशं किल। ततस्त्वं बोधितस्तस्याश्शोणितेन समुक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40014095, "chapter_id": 9187, "verse_number": "6", "content_sanskrit": "वायसेन च तेनैव सततं बाध्यमानया। बोधितः किल देव्या त्वं सुखसुप्तः परन्तप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40014096, "chapter_id": 9187, "verse_number": "7", "content_sanskrit": "तां तु दृष्ट्वा महाबाहो दारितां च स्तनान्तरे। आशीविष इव क्रुद्धो निश्वसन्नभ्यभाषथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40014097, "chapter_id": 9187, "verse_number": "8", "content_sanskrit": "नखाग्रैः केन ते भीरु दारितं तु स्तनान्तरम्। कः क्रीडति सरोषेण पञ्चवक्त्रेण भोगिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40014098, "chapter_id": 9187, "verse_number": "9", "content_sanskrit": "निरीक्षमाणस्सहसा वायसं समवैक्षथाः। नखै स्सरुधिरैस्तीक्ष्णैस्तामेवाभिमुखं स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40014099, "chapter_id": 9187, "verse_number": "10", "content_sanskrit": "सुतः किल स शक्रस्य वायसः पततां वरः। धरान्तरचरश्शीघ्रं पवनस्य गतौ समः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40014100, "chapter_id": 9187, "verse_number": "11", "content_sanskrit": "ततस्तस्मिन्महाबाहो कोपसंवर्तितेक्षणः। वायसे त्वं कृथाः क्रूरां मतिं मतिमतां वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40014101, "chapter_id": 9187, "verse_number": "12", "content_sanskrit": "स दर्भं संस्तराद्गृह्य ब्रह्मास्त्रेण ह्ययोजयः। स दीप्त इव कालाग्निर्जज्वालाभिमुखः खगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40014102, "chapter_id": 9187, "verse_number": "13", "content_sanskrit": "क्षिप्तवांस्त्वं प्रदीप्तं हि दर्भं तं वायसं प्रति। ततस्तु वायसं दीप्तस्स दर्भोऽनुजगाम ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40014103, "chapter_id": 9187, "verse_number": "14", "content_sanskrit": "स पित्रा च परित्यक्तस्सुरैश्च समहर्षिभिः। त्रीन् लोकान् सम्परिक्रम्य त्रातारं नाधिगच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40014104, "chapter_id": 9187, "verse_number": "15", "content_sanskrit": "पुनरेवागतस्त्रस्तस्त्वत्सकाशमरिंदम। स तं निपतितं भूमौ शरण्यश्शरणागतम् ॥ वधार्हमपि काकुत्स्थ कृपया पर्यपालयः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40014105, "chapter_id": 9187, "verse_number": "16", "content_sanskrit": "मोघमस्त्रं न शक्यं तु कर्तुमित्येव राघव ॥ भवांस्तस्याक्षि काकस्य हिनस्ति स्म स दक्षिणम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]