[{"id": 2034094, "chapter_id": 1736, "verse_number": "४-५९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2034095, "chapter_id": 1736, "verse_number": "४-५९-१", "content_sanskrit": "जितं वैकर्तनं दृष्ट्वा पार्थो वैराटिमब्रवीत्।\nस्थिरो भव त्वं संग्रामे जयोऽस्माकं नृपात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2034096, "chapter_id": 1736, "verse_number": "४-५९-२", "content_sanskrit": "यावच्छङ्खमुपाध्यास्ये द्विषतां रोमहर्षणम्।\nअविक्लबमसंभ्रान्तमव्यक्तहृदयेक्षणम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2034097, "chapter_id": 1736, "verse_number": "४-५९-३", "content_sanskrit": "याहि शीघ्रं यतो द्रोणो ममाचार्यो रणे स्थितः ॥\nतथा संक्रीडमानस्य अर्जुनस्य रणाजिरे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2034098, "chapter_id": 1736, "verse_number": "४-५९-४", "content_sanskrit": "बलं सत्वं च तेजश्च लाघवं च व्यवर्धत ॥\nतच्चाद्भुतमभिप्रेक्ष्य भयमुत्तरमाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2034099, "chapter_id": 1736, "verse_number": "४-५९-५x", "content_sanskrit": "उत्तर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2034100, "chapter_id": 1736, "verse_number": "४-५९-५", "content_sanskrit": "अस्त्राणां तव दिव्यानां शरौघान्क्षिपतः शितान्।\nमनो मे मुह्यतेऽत्यर्थं तव दृष्ट्वा पराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2034101, "chapter_id": 1736, "verse_number": "४-५९-६", "content_sanskrit": "द्वैधीभूतं मनो मह्यं भयाद्भरतसत्तम ।\nअदृष्टपूर्वं पश्यामि तव गाण्डीवनिस्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2034102, "chapter_id": 1736, "verse_number": "४-५९-७", "content_sanskrit": "तव बाहुबलं चैव धनुः कर्षयतो बहु।\nतव तेजो दुराधर्षं यथा विष्णोस्त्रिविक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2034103, "chapter_id": 1736, "verse_number": "४-५९-८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2034104, "chapter_id": 1736, "verse_number": "४-५९-८", "content_sanskrit": "तमुत्तरश्चित्रमवेक्ष्य गाण्डिवं शरांश्च मुक्तान्सहसा किरीटिना ।\nभीतोऽब्रवीदर्जुनमाजिमध्ये नाहं तवाश्वान्विषहे नियन्तुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2034105, "chapter_id": 1736, "verse_number": "४-५९-९", "content_sanskrit": "तमब्रवीत्किंचिदिव प्रहस्य गाण्डीवधन्वा द्विषतां निहन्ता ।\nमया सहायेन कुतोऽस्ति ते भयं प्रेह्युत्तराश्वाननुमन्त्र्य वाहय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2034106, "chapter_id": 1736, "verse_number": "४-५९-१०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2034107, "chapter_id": 1736, "verse_number": "४-५९-१०", "content_sanskrit": "आश्वासितस्तेन धनंजयेन वैराटिरश्वान्प्रतुतोदय शीघ्रम्।\nधनंजयश्चापि विकृष्य चापं विष्फारयामास महेन्द्रकल्पः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2034108, "chapter_id": 1736, "verse_number": "४-५९-११", "content_sanskrit": "उत्तरं चैव बीभत्सुरब्रवीत्पुनरर्जुनः ।\nन भेतव्यं मया सार्धं तात संग्राममूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2034109, "chapter_id": 1736, "verse_number": "४-५९-१२", "content_sanskrit": "राजपुत्रोऽसि ते भद्रं कुले महति मात्स्यके।\nजातस्त्वं क्षत्रियकुले न विषीदितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2034110, "chapter_id": 1736, "verse_number": "४-५९-१३", "content_sanskrit": "धृतिं कृत्वा सुविपुलां राजपुत्र रथं मम।\nयुध्यमानस्य संग्रामे राजभिः सह वाहय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2034111, "chapter_id": 1736, "verse_number": "४-५९-१४", "content_sanskrit": "उक्त्वा तमेवं बीभत्सुरर्जुनः पुनरब्रवीत्।\nपाण्डवो रथिनां श्रेष्ठो भारद्वाजं समीक्ष्य तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2034112, "chapter_id": 1736, "verse_number": "४-५९-१५", "content_sanskrit": "यत्रैषा काञ्चनी वेदिर्दृश्यतेऽग्निशिखोपमा ।\nउच्छ्रिता काञ्चने दण्डे पताकाभिरलंकृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2034113, "chapter_id": 1736, "verse_number": "४-५९-१६", "content_sanskrit": "तत्र मां वह भद्रं ते द्रोणं योत्स्यामि सत्तमम्।\nभारद्वाजेन योत्स्येऽहमाचार्येण महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2034114, "chapter_id": 1736, "verse_number": "४-५९-१७", "content_sanskrit": "अमी शोणाः प्रकाशन्ते तुरगाः साधुवाहिनः ।\nमुक्ता रथवरे तस्य सर्वशिक्षाविशारदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2034115, "chapter_id": 1736, "verse_number": "४-५९-१८", "content_sanskrit": "यतो रथवरे शूरः सर्वशस्त्रभृतांवरः।\nस्निग्धवैडूर्यसंकाशस्ताम्राक्षः प्रियदर्शनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2034116, "chapter_id": 1736, "verse_number": "४-५९-१९", "content_sanskrit": "आदित्य इव तेजस्वी बलवीर्यसमन्वितः।\nसर्वलोकधनुःश्रेष्ठः सर्वलोकेषु पूजितः।\nअङ्गिरोशनसोस्तुल्यो नये बुद्धिमतांवरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2034117, "chapter_id": 1736, "verse_number": "४-५९-२०", "content_sanskrit": "चत्वारो निखिला वेदाः साङ्गोपाङ्गाः सलक्षणाः ।\nधनुर्वेदश्च कार्त्स्न्येन ब्राह्मं चास्त्रं प्रतिष्ठितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2034118, "chapter_id": 1736, "verse_number": "४-५९-२१", "content_sanskrit": "पुराणमितिहासश्च अर्थविद्या च मानवम् ।\nभारद्वाजे समस्तानि सर्वाण्येतानि सांप्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2034119, "chapter_id": 1736, "verse_number": "४-५९-२२", "content_sanskrit": "क्षमा दमश्च सत्यं च तेजो मार्दवमार्जवम् ।\nप्रतिष्ठिता गुणा यस्मिन्बहवो द्विजसत्तमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2034120, "chapter_id": 1736, "verse_number": "४-५९-२३", "content_sanskrit": "यस्याहमिष्टः सततं मम चेष्टः सदा च सः।\nक्षत्रधर्मं पुरस्कृत्य तेन योत्स्ये हि सांप्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2034121, "chapter_id": 1736, "verse_number": "४-५९-२४", "content_sanskrit": "आचार्यं प्रापयेदानीं ममोत्तर महारथम्।\nअपरं पश्य संग्राममद्भुतं मम तस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2034122, "chapter_id": 1736, "verse_number": "४-५९-२५", "content_sanskrit": "उत्तरस्त्वेवमुक्तोऽश्वांश्चोदयामास तं प्रति ।\nआजगामार्जुनरथो भारद्वाजरथं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2034123, "chapter_id": 1736, "verse_number": "४-५९-२६", "content_sanskrit": "तमापतन्तं वेगेन पाण्डवं सरथं रणे।\nद्रोणोप्यभ्यद्रवत्पार्थं मतो मत्तमिव द्विपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2034124, "chapter_id": 1736, "verse_number": "४-५९-२७", "content_sanskrit": "स तु रुक्मरथं दृष्ट्वा कौन्तेयः समभिद्रुतम्।\nआचार्यं तं महाबाहुः प्राञ्जलिर्वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2034125, "chapter_id": 1736, "verse_number": "४-५९-२८", "content_sanskrit": "उषिताः स्मो वने वासं प्रतिकर्मचिकीर्षवः ।\nकोपं नार्हसि नः कर्तुं सदा समरदुर्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2034126, "chapter_id": 1736, "verse_number": "४-५९-२९", "content_sanskrit": "अहं तु ताडितः पूर्वं प्रहरेयं तवानघ ।\nइति मे वर्तते बुद्धिस्तद्भवान्क्षन्तुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2034127, "chapter_id": 1736, "verse_number": "४-५९-३०", "content_sanskrit": "ततः प्राध्मापयच्छङ्खं भेरीपटहवादितम् ।\nव्यक्षोभत बलं सर्वमुद्धूतमिव सागरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2034128, "chapter_id": 1736, "verse_number": "४-५९-३१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2034129, "chapter_id": 1736, "verse_number": "४-५९-३१", "content_sanskrit": "ततस्तु प्राहिणोद्द्रोणः शरानथ स विंशतिम्।\nअप्राप्तानेव तान्पार्थश्चिच्छेद कृतहस्तवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2034130, "chapter_id": 1736, "verse_number": "४-५९-३२", "content_sanskrit": "ततः शरसहस्रेण रथं पार्थस्य वीर्यवान् ।\nअवाकिरत्ततो द्रोणः शीघ्रहस्तं प्रदर्शयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2034131, "chapter_id": 1736, "verse_number": "४-५९-३३", "content_sanskrit": "एवं प्रववृते युद्धं भारज्वाजकिरीटिनोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2034132, "chapter_id": 1736, "verse_number": "४-५९-३४", "content_sanskrit": "अश्वाञ्शोणान्महावेगान्हंसवर्णैस्तु वाजिभिः ।\nमिश्रितान्समरे दृष्ट्वा व्यस्मयन्त पृथग्जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2034133, "chapter_id": 1736, "verse_number": "४-५९-३५", "content_sanskrit": "रथं रथेन पार्थस्य समाहत्य परंतपः ।\nहर्षयुक्तस्तदाऽऽचार्यः प्रत्यगृह्णात्स पाण्डवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2034134, "chapter_id": 1736, "verse_number": "४-५९-३६", "content_sanskrit": "समाश्लिष्टाविवान्योन्यं द्रोणपाण्डवयोर्ध्वजौ ।\nदृष्ट्वा प्राकम्पत मुहुर्भारतानां महाचमूः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2034135, "chapter_id": 1736, "verse_number": "४-५९-३७", "content_sanskrit": "तत्तु युद्धं प्रववृते ह्याचार्यस्यार्जुनस्य च।\nविमुञ्चतोः शरानुग्रान्विशिखान्दीप्ततेजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2034136, "chapter_id": 1736, "verse_number": "४-५९-३८", "content_sanskrit": "तौ वीरौ वीर्यसंपन्नौ दृष्ट्वा समरमूर्धनि।\nआचार्यशिष्यौ रथिनौ कृतवीर्यौ तरस्विनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2034137, "chapter_id": 1736, "verse_number": "४-५९-३९", "content_sanskrit": "उभौ विश्रुतकर्माणावुभौ श्रमगतौ जये।\nउभावतिरथौ लोके ह्युभौ परपुंरजयौ।\nक्षिपन्तौ शरजालानि क्षत्रियान्मोह आविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2034138, "chapter_id": 1736, "verse_number": "४-५९-४०", "content_sanskrit": "व्यस्मयन्त नराः सर्वे द्रोणार्जुनसमागमे।\nनराणां ब्रुवतां वाक्यं श्रूयते स महास्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2034139, "chapter_id": 1736, "verse_number": "४-५९-४१", "content_sanskrit": "द्रोणं हि समरे कोऽन्यो योद्धुमर्हत्यथार्जुनात्।\nरौद्रः क्षत्रियधर्मोऽयं गुरं वै यदयोधयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2034140, "chapter_id": 1736, "verse_number": "४-५९-४२", "content_sanskrit": "इत्यब्रुवञ्जनास्तत्र संग्रामशिरसि स्थिताः ।\nतौ समीक्ष्य तु संरब्धौ सन्निकृष्टौ महारथौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2034141, "chapter_id": 1736, "verse_number": "४-५९-४३", "content_sanskrit": "छाद्येतां शरौघैस्तावन्योन्यमुपराजितौ ।\nसंयुगे संचकाशेतां कालसूर्याविवोदितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2034142, "chapter_id": 1736, "verse_number": "४-५९-४४", "content_sanskrit": "विष्फार्य च महाचापं हेमपृष्ठं दुरासदम्।\nसंरब्धस्तु तदा द्रोणः प्रत्ययुध्यत फल्गुनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2034143, "chapter_id": 1736, "verse_number": "४-५९-४५", "content_sanskrit": "स सायकमयैर्जालैरर्जुनस्य रथं प्रति।\nभानुमद्भिः शिलाधौतैर्बाणैः प्राच्छादयद्दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2034144, "chapter_id": 1736, "verse_number": "४-५९-४६", "content_sanskrit": "अर्जुनस्तु तदा द्रोणं महावेगैर्महारथः।\nविव्याध शतशो बाणैर्धाराभिरिव पर्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2034145, "chapter_id": 1736, "verse_number": "४-५९-४७", "content_sanskrit": "कालमेघ इवोष्णान्ते फल्गुनः समवाकिरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2034146, "chapter_id": 1736, "verse_number": "४-५९-४८", "content_sanskrit": "तस्य जाम्बूनदमयैश्चितरैश्चापच्युतैः शरैः।\nप्राच्छादयद्रथश्रेष्ठं भारद्वाजोऽर्जुनस्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2034147, "chapter_id": 1736, "verse_number": "४-५९-४९", "content_sanskrit": "तथैव दिव्यं गाण्डीवं धनुरानम्य चार्जुनः ।\nशत्रुघ्नं वेगवत्सृष्टं भारसाधनमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2034148, "chapter_id": 1736, "verse_number": "४-५९-५०", "content_sanskrit": "शोभते स्म महावाहुर्गाण्डीवं विक्षिपन्धनुः।\nशरांश्च विसृजंश्चित्रान्सुवर्णविकृतान्बहून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2034149, "chapter_id": 1736, "verse_number": "४-५९-५१", "content_sanskrit": "प्राच्छादयदमेयात्मा भारद्वाजरथं प्रति।\nद्रोणचापविनिर्मुक्तान्बाणान्बाणैरवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2034150, "chapter_id": 1736, "verse_number": "४-५९-५२", "content_sanskrit": "सरथोऽप्यचरत्पार्थः प्रेक्षणीयो महारथः ।\nयुगपद्दिक्षु सर्वासु सर्वतोऽस्त्राण्यवासृजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2034151, "chapter_id": 1736, "verse_number": "४-५९-५३", "content_sanskrit": "आददानं शरान्घोरान्संदधानं च पाण्डवम् ।\nविसृजन्तं च क्रौन्तेयं न स्म पश्यन्ति लाघवाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2034152, "chapter_id": 1736, "verse_number": "४-५९-५४", "content_sanskrit": "एकच्छायमिवाकाशं बाणैश्चक्रे समन्ततः।\nनादृश्यत ततो द्रोणो नीहारेणेव पर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2034153, "chapter_id": 1736, "verse_number": "४-५९-५५", "content_sanskrit": "मरीचिविकचस्येव राजन्भानुमतो वपुः।\nआसीत्पार्थस्य सुमहद्वपुः शरशतार्चितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2034154, "chapter_id": 1736, "verse_number": "४-५९-५६", "content_sanskrit": "क्षिपतः शरजालानि कौन्तेयस्य महात्मनः ।\nतान्विधूय शरान्घोरान्द्रोणोऽपि समितिंजयः ।\nबभासे तिमिरं व्योम्नि विधूय सविता यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2034155, "chapter_id": 1736, "verse_number": "४-५९-५७", "content_sanskrit": "अग्निचक्रोपमं घोरं मण्डलीकृतमाहवे।\nविकृष्य सुमहच्चापं मेघस्तनितनिस्वनम् ।\nअसकृत्मुञ्चतो बाणान्ददृशुः कुरवो युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2034156, "chapter_id": 1736, "verse_number": "४-५९-५८", "content_sanskrit": "दिक्षु सर्वासु विपुलः शुश्रुवेऽथ जनैस्तदा।\nद्रोणस्यापि धनुर्घोषो विद्युत्स्तनितनिस्वनः ।\nअभवद्विस्मयकरः सैन्यानां भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2034157, "chapter_id": 1736, "verse_number": "४-५९-५९", "content_sanskrit": "तप्तजाम्बूनदमयैर्दीप्तैरग्निसमैः शरैः।\nप्राच्छादयदमेयात्मा दिशः सूर्यस्य च प्रभाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2034158, "chapter_id": 1736, "verse_number": "४-५९-६०", "content_sanskrit": "ततः काञ्चनपङ्खानां शराणां नतपर्वणाम्।\nवियद्गतानां चरतां दृश्यन्ते बहवो व्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2034159, "chapter_id": 1736, "verse_number": "४-५९-६१", "content_sanskrit": "शरासनात्तु द्रोणस्य प्रभवन्ति स्म सायकाः।\nएको दीर्घ इवाभान्तः प्रदृश्यन्ते महाशराः ।\nआकाशे समदृश्यन्त हंसानामिव पङ्क्तयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2034160, "chapter_id": 1736, "verse_number": "४-५९-६२", "content_sanskrit": "एवं सुवर्णविकृतान्विमुञ्चन्तौ शरान्बहून्।\nआकाशं संवृतं वीरावुल्काभिरिव चक्रतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2034161, "chapter_id": 1736, "verse_number": "४-५९-६३", "content_sanskrit": "तयोः शराश्च विबभुः कङ्कबर्हिणवाससः ।\nपङ्क्त्यः शरदि मत्तानां सारसानामिवाम्बरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2034162, "chapter_id": 1736, "verse_number": "४-५९-६४", "content_sanskrit": "तत्तु युद्धं महाघोरं तयोः संरब्धयोरभूत्।\nअत्यद्भुतमचिन्त्यं च वृत्रवासवयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2034163, "chapter_id": 1736, "verse_number": "४-५९-६५", "content_sanskrit": "महागजाविवासाद्य विषाणाग्रैः परस्परम्।\nशरैः पूर्णायतोत्सृष्टैरन्योन्यमभिजघ्नतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2034164, "chapter_id": 1736, "verse_number": "४-५९-६६", "content_sanskrit": "अथ त्वाचार्यमुख्येन शरान्सृष्टाञ्शिलाशितान्।\nअवारयच्छितैर्बाणैरर्जुनो जयतांवरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2034165, "chapter_id": 1736, "verse_number": "४-५९-६७", "content_sanskrit": "दर्शयन्नैन्द्रमात्मानमुग्रमुग्रुपराक्रमः।\nइषुभिस्तूर्णमाकाशं बहुभिश्च समावृणोत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2034166, "chapter_id": 1736, "verse_number": "४-५९-६८", "content_sanskrit": "जिघांसन्तं नरव्याघ्रमर्जुनं भीमदर्शनम् ।\nविव्याध निशितैर्द्रोणः शरैः सन्नतपर्वभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2034167, "chapter_id": 1736, "verse_number": "४-५९-६९", "content_sanskrit": "हृष्टः समभवद्द्रोणो रणशौण्डः प्रतापवान् ।\nअर्जुनेन समं क्रीडञ्शरैः सन्नतपर्वभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2034168, "chapter_id": 1736, "verse_number": "४-५९-७०", "content_sanskrit": "तौ व्यदारयतां शूरौ सन्नद्धौ रणशोभिनौ ।\nउदीरयन्तौ दिव्यानि ब्राह्माद्यस्त्राणि भागशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2034169, "chapter_id": 1736, "verse_number": "४-५९-७१", "content_sanskrit": "पार्थस्तु समरे शूरो दर्शयन्वीर्यमात्मनः।\nस मह्यस्त्रैर्महात्मानं द्रोणं प्राच्छादयच्छरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2034170, "chapter_id": 1736, "verse_number": "४-५९-७२", "content_sanskrit": "अस्त्रैरस्त्राणि संवार्य पार्थो द्रोणमवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2034171, "chapter_id": 1736, "verse_number": "४-५९-७३", "content_sanskrit": "तयोरासीत्संप्रहारः क्रुद्धयोर्नरसिंहयोः।\nअमृष्यमाणयोः सङ्ख्ये बलिवासवयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2034172, "chapter_id": 1736, "verse_number": "४-५९-७४", "content_sanskrit": "दर्शयेतां महास्राणि भारद्वाजार्जुनौ रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2034173, "chapter_id": 1736, "verse_number": "४-५९-७५", "content_sanskrit": "ऐन्द्रं वायव्यमाग्नेयमस्त्रमस्त्रेण पाण्डवः ।\nमुक्तंमुक्तं द्रोणचापाद्ग्रमते स्म पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2034174, "chapter_id": 1736, "verse_number": "४-५९-७६", "content_sanskrit": "एवं शूरौ महेष्वासौ विसृजन्तौ शिलाशितान्।\nएकच्छायमकुर्वातां गगनं शरवृष्टिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2034175, "chapter_id": 1736, "verse_number": "४-५९-७७", "content_sanskrit": "ततोऽर्जुनेन मुक्तानां पततां च शरीरिपु।\nपर्वतेष्विव वज्राणां शराणां श्रूयते स्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2034176, "chapter_id": 1736, "verse_number": "४-५९-७८", "content_sanskrit": "ततो नागा रथाश्वाश्च सादिनश्च विशांपते।\nशोणिताक्ताश्च दृश्यन्ते पुष्पिता इव किंशुकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2034177, "chapter_id": 1736, "verse_number": "४-५९-७९", "content_sanskrit": "बाहुभिश्च सकेयूरैर्निकृत्तैश्च महारथैः ।\nसुवर्णाचित्रैः कवचैर्ध्वजैश्च विनिपातितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2034178, "chapter_id": 1736, "verse_number": "४-५९-८०", "content_sanskrit": "योधैश्च निहतैस्तत्र पार्थबाणाभिपीडितैः।\nबलमासीत्सुसंभ्रान्तं द्रोणार्जुनसमागमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2034179, "chapter_id": 1736, "verse_number": "४-५९-८१", "content_sanskrit": "विधृन्वानौ तु तौ वीरौ धनुषी भारसाधने।\nप्राच्छादयेतामन्योन्यं दिधक्षन्तौ वरेषुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2034180, "chapter_id": 1736, "verse_number": "४-५९-८२", "content_sanskrit": "अथान्तरिक्षे नादोऽभूद्द्रोणं तत्र प्रशंसताम् ।\nदुष्करं कृतवान्द्रोणो यदर्जुनमयोधयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2034181, "chapter_id": 1736, "verse_number": "४-५९-८३", "content_sanskrit": "प्रमाथिनं महावीर्यं दृढमुष्टिं दुरासदम्।\nजेतारं सर्वदैत्यानां सर्वेषां च महारथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2034182, "chapter_id": 1736, "verse_number": "४-५९-८४", "content_sanskrit": "अविभ्रमं च शिक्षां च लाघवं दूरपातनम् ।\nपार्थस्य समरे दृष्ट्वा द्रोणस्यासीच्च विस्मयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2034183, "chapter_id": 1736, "verse_number": "४-५९-८५", "content_sanskrit": "तत्प्रवृत्तं चिरं घोरं तयोर्युद्धं महात्मनोः ।\nअवर्तत महारौद्रं लोकसंक्षोभकरकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2034184, "chapter_id": 1736, "verse_number": "४-५९-८६", "content_sanskrit": "अथ गाण्डीवमुद्यम्य दिव्यं धनुरमर्षणः ।\nविचकर्ष रणे पार्थो बाहुभ्यां भरतर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2034185, "chapter_id": 1736, "verse_number": "४-५९-८७", "content_sanskrit": "तस्य बाणमयं वर्षे शलभानामिवाभवत् ।\nन च बाणान्तरे तस्य वायुः शक्नोति सर्पितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2034186, "chapter_id": 1736, "verse_number": "४-५९-८८", "content_sanskrit": "अभीक्ष्णं संदधानस्य बाणानुत्सृजतस्तथा।\nनान्तरं ददृशे किंचित्पार्थस्यापततोपी च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2034187, "chapter_id": 1736, "verse_number": "४-५९-८९", "content_sanskrit": "युद्धे तु कृतशीघ्रास्त्रे वर्तमाने सुदारुणे।\nशीघ्राच्छीघ्रतरं पार्थः शरानन्यानुदैरयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2034188, "chapter_id": 1736, "verse_number": "४-५९-९०", "content_sanskrit": "ततः शरसहस्राणि शराणां नतपर्वणाम्।\nयुगपत्प्रापतंस्तत्र द्रोणस्य रथमन्तिकात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2034189, "chapter_id": 1736, "verse_number": "४-५९-९१", "content_sanskrit": "विकीर्यमाणे द्रोणे तु शरैर्गाण्डीवधन्वना ॥\nहाहाकारो महानासीत्सैन्यानां भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2034190, "chapter_id": 1736, "verse_number": "४-५९-९२", "content_sanskrit": "पाण्डवस्य तु शीघ्रास्त्रं मघवा समपूजयत्।\nगन्धर्वाप्सरसश्चैव ये च तत्र समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2034191, "chapter_id": 1736, "verse_number": "४-५९-९३", "content_sanskrit": "द्रोणं युद्धार्णवे मग्नं दृष्ट्वा पुत्रः प्रतापवान्।\nततो वृन्देन महता रथिनां रथियूथपः ।\nआचार्यपुत्रस्तु शरैः पाण्डवं प्रत्यवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2034192, "chapter_id": 1736, "verse_number": "४-५९-९४", "content_sanskrit": "अश्वत्थामा तु तत्कर्म हृदयेन महात्मनः।\nपूजयामास पार्थस्य कोपं चास्य तदाऽकरोत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2034193, "chapter_id": 1736, "verse_number": "४-५९-९५", "content_sanskrit": "स भन्युवशमापन्नः पार्थमभ्यद्रवद्रणे ।\nकिरञ्शरसहस्राणि पर्जन्य इव वृष्टिमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2034194, "chapter_id": 1736, "verse_number": "४-५९-९६", "content_sanskrit": "आवृत्य च महाबाहुर्यतो द्रोणस्ततोऽभवत्।\nअन्तरं प्रददौ पार्थो द्रोणस्य व्यपसर्पितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2034195, "chapter_id": 1736, "verse_number": "४-५९-९७", "content_sanskrit": "स तु लब्धान्तरस्तूर्णमपायाञ्जवनैर्हयैः ।\nछिन्नवर्मध्वजरथो निकृत्तः परमेषुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2034196, "chapter_id": 1736, "verse_number": "४-५९-९८", "content_sanskrit": "पराजिते तदा द्रोणे द्रोणपुत्रः समागतः।\nसदण्ड इव रक्ताक्षः कृतान्तः समरे स्थितः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2034197, "chapter_id": 1736, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि एकोनषष्टितमोऽध्यायः ॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}]