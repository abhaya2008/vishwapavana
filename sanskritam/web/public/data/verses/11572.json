[{"id": 50016201, "chapter_id": 11572, "verse_number": "1", "content_sanskrit": "राजोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50016202, "chapter_id": 11572, "verse_number": "2", "content_sanskrit": "कथ्यतां भगवन्नेतत् तयोः शापस्य कारणम्। यत् तद् विगर्हितं कर्म येन देवऋषेस्तमः॥ १०/११/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50016203, "chapter_id": 11572, "verse_number": "3", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50016204, "chapter_id": 11572, "verse_number": "4", "content_sanskrit": "रुद्रस्यानुचरौ भूत्वा सुदृप्तौ धनदात्मजौ। कैलासोपवने रम्ये मन्दाकिन्यां मदोत्कटौ॥ १०/११/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50016205, "chapter_id": 11572, "verse_number": "5", "content_sanskrit": "वारुणीं मदिरां पीत्वा मदाघूर्णितलोचनौ। स्त्रीजनैरनुगायद्भिश्चेरतुः पुष्पिते वने॥ १०/११/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50016206, "chapter_id": 11572, "verse_number": "6", "content_sanskrit": "अन्तः प्रविश्य गङ्गायामम्भोजवनराजिनि। चिक्राडतुर्युवतिभिर्गजाविव करेणुभिः॥ १०/११/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50016207, "chapter_id": 11572, "verse_number": "7", "content_sanskrit": "यदृच्छया च देवर्षिर्भगवांस्तत्र कौरव। अपश्यन्नारदो देवौ क्षीबाणौ समबुद्ध्यत॥ १०/११/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50016208, "chapter_id": 11572, "verse_number": "8", "content_sanskrit": "तं दृष्ट्वा व्रीळिता देव्यो विवस्त्राः शापशङ्किताः। वासांसि पर्यधुः शीघ्रं विवस्त्रौ नैव गुह्यकौ॥ १०/११/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50016209, "chapter_id": 11572, "verse_number": "9", "content_sanskrit": "तौ दृष्ट्वा मदिरामत्तौ श्रीमदान्धौ सुरात्मजौ। तयोरनुग्रहार्थाय शापं दास्यन्निदं जगौ॥ १०/११/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50016210, "chapter_id": 11572, "verse_number": "10", "content_sanskrit": "नारद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50016211, "chapter_id": 11572, "verse_number": "11", "content_sanskrit": "न ह्यन्यो जुषतो जोष्याद् बुद्धिभ्रंशो रजोगुणः। श्रीमदादाभिजात्यादेर्यत्र स्त्रीद्यूतमासवम्॥ १०/११/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50016212, "chapter_id": 11572, "verse_number": "12", "content_sanskrit": "हन्यन्ते पशवो यत्र निर्दयैरजितात्मभिः। मन्यमानैरिमं देहमजरामृत्यु नश्वरम्॥ १०/११/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50016213, "chapter_id": 11572, "verse_number": "13", "content_sanskrit": "देवसञ्ज्ञितमप्यन्ते कृमिविड्भस्मसञ्ज्ञितम्। भूतध्रुक् कुरुते स्वार्थं किं वेद निरयो यतः॥ १०/११/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50016214, "chapter_id": 11572, "verse_number": "14", "content_sanskrit": "देहः किमन्नदातुः स्यान्निषेक्तुर्मातुरेव वा। मातुः पितुर्वा विक्रेतुर्बलिनोऽग्नेः शुनोऽपि वा॥ १०/११/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50016215, "chapter_id": 11572, "verse_number": "15", "content_sanskrit": "एवं साधारणं देहमव्यक्तप्रभवाप्ययम्। को विद्वानात्मसात् कृत्वा हन्ति जन्तून् ऋतेऽसतः॥ १०/११/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50016216, "chapter_id": 11572, "verse_number": "16", "content_sanskrit": "असतः श्रीमदान्धस्य दारिद्र्यं परमाञ्जनम्। आत्मौपम्येन भूतानि दरिद्रः परमीक्षते॥ १०/११/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50016217, "chapter_id": 11572, "verse_number": "17", "content_sanskrit": "यथा कण्टकविद्धाङ्गो जन्तोर्नेच्छति तां व्यथाम्। जीवसाम्यं गतो लिङ्गैर्न तथाऽविद्धकण्टकः॥१०/११/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50016218, "chapter_id": 11572, "verse_number": "18", "content_sanskrit": "दरिद्रो निरहंस्तम्भो मुक्तः सर्वमदैरिह। कृच्छ्रं यदृच्छयाऽऽप्नोति तद्धि तस्य परं तपः॥ १०/११/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50016219, "chapter_id": 11572, "verse_number": "19", "content_sanskrit": "नित्यं क्षुत्क्षामदेहस्य दरिद्रस्यान्नकाङ्क्ष्णिः। इन्द्रियाण्यनुशुष्यन्ति हिंसाऽपि विनिवर्तते॥ १०/११/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50016220, "chapter_id": 11572, "verse_number": "20", "content_sanskrit": "दरिद्रस्यैव युज्यन्ते साधवः समदर्शिनः। सद्भिः क्षिणोति तत्तर्षं तत आराच्च सिद्ध्यति॥ १०/११/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50016221, "chapter_id": 11572, "verse_number": "21", "content_sanskrit": "साधूनां समचित्तानां मुकुन्दचरणैषिणाम्। उपेक्ष्यैः किं धनस्तम्भैरसद्भिरसदाश्रयैः॥ १०/११/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50016222, "chapter_id": 11572, "verse_number": "22", "content_sanskrit": "तदहं मत्तयोर्माध्व्या वारुण्या श्रीमदान्धयोः। तमोमदं हनिष्यामि स्त्रैणयोरजितन्मनोः॥ १०/११/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50016223, "chapter_id": 11572, "verse_number": "23", "content_sanskrit": "यदिमौ लोकपालस्य पुत्रौ भूत्वा तमःप्लुतौ। न विवाससमात्मानं विजानीतः सुदुर्मदौ॥ १०/११/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50016224, "chapter_id": 11572, "verse_number": "24", "content_sanskrit": "अतोऽर्हतः स्थावरतां नैवं स्यातां यथा पुनः। स्मृतिः स्यान्मत्प्रसादेन तत्रापि मदनुग्रहात्॥ १०/११/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50016225, "chapter_id": 11572, "verse_number": "25", "content_sanskrit": "वासुदेवस्य सान्निध्यं लब्ध्वा दिव्यशरच्छते। वृत्ते स्वर्लोकतां भूयो लब्ध्वा भक्तौ भविष्यतः॥ १०/११/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50016226, "chapter_id": 11572, "verse_number": "26", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50016227, "chapter_id": 11572, "verse_number": "27", "content_sanskrit": "स एवमुक्त्वा देवर्षिर्गतो नारायणाश्रमम्। नळकूबरमणिग्रीवावासतुर्यमळार्जुनौ॥ १०/११/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50016228, "chapter_id": 11572, "verse_number": "28", "content_sanskrit": "तद् भागवतमुख्यस्य सत्यं कर्तुं वचो हरिः। जगाम शनकैस्तत्र यत्रास्तां यमळार्जुनौ॥ १०/११/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50016229, "chapter_id": 11572, "verse_number": "29", "content_sanskrit": "देवर्षिर्मे प्रियतमो यदिमौ धनदात्मजौ। तत् तथा साधयिष्यामि यद् गीतं तन्महात्मना॥ १०/११/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50016230, "chapter_id": 11572, "verse_number": "30", "content_sanskrit": "इत्यन्तरेणार्जुनयोः कृष्णस्तु यमयोर्ययौ। आत्मनिर्वेशमात्रेण तिर्यग्गतमुलूखलम्॥ १०/११/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50016231, "chapter_id": 11572, "verse_number": "31", "content_sanskrit": "बालेन निष्कृष्टमुलूखलं तद् दामोदरेण तरसोत्कलिताङ्घ्रिबन्धौ। निष्पेततुः पवनविक्रमितातिवेलस्कन्धप्रवाळविटपौ कृतचण्डशब्दौ॥ १०/११/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50016232, "chapter_id": 11572, "verse_number": "32", "content_sanskrit": "तत्र श्रिया परमया ककुभः स्फुरन्तौ सिद्धावुपेत्य कुजयोरिव जातवेदौ। कृष्णं प्रणम्य शिरसाऽखिललोकनाथं बद्धाञ्जली विरजसाविदमूचतुः स्म॥ १०/११/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50016233, "chapter_id": 11572, "verse_number": "33", "content_sanskrit": "यक्षावूचतुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50016234, "chapter_id": 11572, "verse_number": "34", "content_sanskrit": "कृष्णकृष्ण महायोगिन् त्वमाद्यः पुरुषः परः। व्यक्ताव्यक्तमिदं विश्वं रूपं ते ब्राह्मणा विदुः॥ १०/११/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50016235, "chapter_id": 11572, "verse_number": "35", "content_sanskrit": "त्वमेकः सर्वभूतानां देह आत्मेन्द्रियेश्वरः। त्वमेव कालो भगवान् विष्णुरव्यय ईश्वरः॥ १०/११/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50016236, "chapter_id": 11572, "verse_number": "36", "content_sanskrit": "त्वं महान् प्रकृतिः सूक्ष्मा रजस्सत्त्वतमोमयौ। त्वमेव पुरुषोऽध्यक्षः सर्वक्षेत्रविकारवित्॥ १०/११/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50016237, "chapter_id": 11572, "verse_number": "37", "content_sanskrit": "गृह्यमाणस्त्वमग्राह्यो विकारैः प्राकृतैर्गुणैः। को न्विहार्हति विज्ञातुं प्राक् सिद्धं गुणसंस्थितेः॥१०/११/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50016238, "chapter_id": 11572, "verse_number": "38", "content_sanskrit": "तस्मै तुभ्यं भगवते वासुदेवाय वेधसे। आत्मद्योतैर्गुणैश्छन्नमहिम्ने ब्रह्मणे नमः॥ १०/११/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50016239, "chapter_id": 11572, "verse_number": "39", "content_sanskrit": "यस्यावतारा ज्ञायन्ते शरीरेष्वशरीरिणः। तैस्तैरतुल्यातिशयैस्तिर्यग्योनिष्वसङ्गतैः॥ १०/११/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50016240, "chapter_id": 11572, "verse_number": "40", "content_sanskrit": "स भवान् सर्वलोकस्य भवाय प्रभवाय च। अवतीर्णोंऽशभागेन साम्प्रतं पतिराशिषाम्॥ १०/११/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50016241, "chapter_id": 11572, "verse_number": "41", "content_sanskrit": "नमः परमकल्याण नमस्ते विश्वमङ्गळ। वासुदेवाय शान्ताय यदूनां पतये नमः॥ १०/११/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50016242, "chapter_id": 11572, "verse_number": "42", "content_sanskrit": "अनुजानीहि नौ भूमन् सदाऽनुचरकिङ्करौ। दर्शनं नौ भगवत ऋषेरासीदनुग्रहात्॥ १०/११/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50016243, "chapter_id": 11572, "verse_number": "43", "content_sanskrit": "वाणी गुणानुकथने श्रवणौ कथायां हस्तौ च कर्मसु मनस्तव पादयोर्नौ। स्मृत्यां शिरस्तव सुरप्रवर प्रणामे दृष्टिः सतां दर्शनेऽस्तु भवत्तनूनाम्॥ १०/११/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50016244, "chapter_id": 11572, "verse_number": "44", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50016245, "chapter_id": 11572, "verse_number": "45", "content_sanskrit": "इत्थं सङ्कीर्तितस्ताभ्यां भगवान् गोकुलेश्वरः। दाम्ना चोलूखले बद्धः प्रहसन्नाह गुह्यकौ॥ १०/११/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50016246, "chapter_id": 11572, "verse_number": "46", "content_sanskrit": "श्रीभगवानुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50016247, "chapter_id": 11572, "verse_number": "47", "content_sanskrit": "ज्ञातं मया पुरैवैतद् ऋषिणा करुणात्मना। यच्छ्रीमदान्धयोर्वाग्भिः शापः सानुग्रहः कृतः॥ १०/११/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50016248, "chapter_id": 11572, "verse_number": "48", "content_sanskrit": "साधूनां समचित्तानां सुतरां मत्कृतात्मनाम्। दर्शनान्नो भवेद् बन्धः पुंसोऽक्ष्णोः सवितुर्यथा॥१०/११/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 50016249, "chapter_id": 11572, "verse_number": "49", "content_sanskrit": "तद् गच्छतं मत्परमौ नरवाहनिकेतनम्। सञ्जातो मयि भावो वामीप्सितः परमोत्सवः॥ १०/११/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 50016250, "chapter_id": 11572, "verse_number": "50", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 50016251, "chapter_id": 11572, "verse_number": "51", "content_sanskrit": "इत्युक्तौ तौ परिक्रम्य प्रणम्य च पुनःपुनः। बद्धोलूखलमामन्त्र्य जग्मतुर्दिशमुत्तराम्॥ १०/११/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 50016252, "chapter_id": 11572, "verse_number": "52", "content_sanskrit": "इति श्रीमद्भागवते दशमस्कन्धे एकादशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]