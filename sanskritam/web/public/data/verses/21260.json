[{"id": 7001260000, "chapter_id": 21260, "verse_number": "२-५-३३-१", "content_sanskrit": "उपमन्युरुवाच ।\nअतः परं प्रवक्ष्यामि केवलामुष्मिकं विधिम् ।\nनैतेन सदृशं किंचित्कर्मास्ति भुवनत्रये॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001260001, "chapter_id": 21260, "verse_number": "२-५-३३-२", "content_sanskrit": "पुण्यातिशयसंयुक्तः सर्वैर्देवैरनुष्ठितः ।\nब्रह्मणा विष्णुना चैव रुद्रेण च विशेषतः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001260002, "chapter_id": 21260, "verse_number": "२-५-३३-३", "content_sanskrit": "इंद्रादिलोकपारैश्च सूर्याद्यैर्नवभिर्ग्रहैः ।\nविश्वामित्रवसिष्ठाद्यैर्ब्रह्मविद्भिर्महर्षिभिः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001260003, "chapter_id": 21260, "verse_number": "२-५-३३-४", "content_sanskrit": "श्वेतागस्त्यदधीचाद्यैरस्माभिश्च शिवाश्रितैः ।\nनंदीश्वरमहाकालभृंगीशाद्यैर्गणेश्वरैः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001260004, "chapter_id": 21260, "verse_number": "२-५-३३-५", "content_sanskrit": "पातालवासिभिर्दैत्यैः शेषाद्यैश्च महोरगैः ।\nसिद्धैर्यक्षैश्च गंधर्वै रक्षोभूतपिशाचकैः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001260005, "chapter_id": 21260, "verse_number": "२-५-३३-६", "content_sanskrit": "स्वंस्वं पदमनुप्राप्तं सर्वैरयमनुष्ठितः ।\nअनेन विधिना सर्वे देवा देवत्वमागताः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001260006, "chapter_id": 21260, "verse_number": "२-५-३३-७", "content_sanskrit": "ब्रह्मा ब्रह्मत्वमापन्नो विष्णुर्विष्णुत्वमागतः ।\nरुद्रो रुद्रत्वमापन्न इंद्रश्चेन्द्रत्वमागतः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001260007, "chapter_id": 21260, "verse_number": "२-५-३३-८", "content_sanskrit": "गणेशश्च गणेशत्वमनेन विधिना गतः ।\nसितचंदनतोयेन लिंगं स्नाप्य शिवं शिवाम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001260008, "chapter_id": 21260, "verse_number": "२-५-३३-९", "content_sanskrit": "श्वेतैर्विकसितैः पद्मैः संपूज्य प्रणिपत्य च ।\nतत्र पद्मासनं रम्यं कृत्वा लक्षणसंयुतम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001260009, "chapter_id": 21260, "verse_number": "२-५-३३-१०", "content_sanskrit": "विभवे सति हेमाद्यै रत्नाद्यैर्वा स्वशक्तितः ।\nमध्ये केसरजालास्य स्थाप्य लिंगं कनीयसम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001260010, "chapter_id": 21260, "verse_number": "२-५-३३-११", "content_sanskrit": "अंगुष्ठप्रतिमं रम्यं सर्वगन्धमयं शुभम् ।\nदक्षिणे स्थापयित्वा तु बिल्वपत्रैः समर्चयेत्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001260011, "chapter_id": 21260, "verse_number": "२-५-३३-१२", "content_sanskrit": "अगुरुं दक्षिणे पार्श्वे पश्चिमे तु मनःशिलाम् ।\nउत्तरे चंदनं दद्याद्धरितालं तु पूर्वतः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001260012, "chapter_id": 21260, "verse_number": "२-५-३३-१३", "content_sanskrit": "सुगन्धैः कुसुमै रम्यैर्विचित्रैश्चापि पूजयेत् ।\nधूपं कृष्णागुरुं दद्यात्सर्वतश्च सगुग्गुलम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001260013, "chapter_id": 21260, "verse_number": "२-५-३३-१४", "content_sanskrit": "वासांसि चातिसूक्ष्माणि विकाशानि निवेदयेत् ।\nपायसं घृतसंमिश्रं घृतदीपांश्च दापयेत्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001260014, "chapter_id": 21260, "verse_number": "२-५-३३-१५", "content_sanskrit": "सर्वं निवेद्य मन्त्रेण ततो गच्छेत्प्रदक्षिणाम् ।\nप्रणम्य भक्त्या देवेशं स्तुत्वा चान्ते क्षमापयेत्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001260015, "chapter_id": 21260, "verse_number": "२-५-३३-१६", "content_sanskrit": "सर्वोपहारसंमिश्रं ततो लिंगं निवेदयेत् ।\nशिवाय शिवमन्त्रेण दक्षिणामूर्तिमाश्रितः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001260016, "chapter_id": 21260, "verse_number": "२-५-३३-१७", "content_sanskrit": "एवं यो ऽर्चयते नित्यं पञ्चगन्धमयं शुभम् ।\nसर्वपापविनिर्मुक्तः शिवलोके महीयते॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001260017, "chapter_id": 21260, "verse_number": "२-५-३३-१८", "content_sanskrit": "एतद्व्रतोत्तमं गुह्यं शिवलिंगमहाव्रतम् ।\nभक्तस्य ते समाख्यातं न देयं यस्य कस्यचित्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001260018, "chapter_id": 21260, "verse_number": "२-५-३३-१९", "content_sanskrit": "देयं च शिवभक्तेभ्यः शिवेन कथितं पुरा॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]