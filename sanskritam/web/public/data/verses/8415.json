[{"id": 900005048, "chapter_id": 8415, "verse_number": "2.1", "content_sanskrit": "न च जडत्वहेतुरपि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900005049, "chapter_id": 8415, "verse_number": "2.2", "content_sanskrit": "न द्वितीयः । आत्मत्वस्य..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900005050, "chapter_id": 8415, "verse_number": "2.3", "content_sanskrit": "आत्मनो ज्ञानस्वरूपता न निर्वाह्यतामारो-हति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900005051, "chapter_id": 8415, "verse_number": "2.4", "content_sanskrit": "न चतुर्थः । स्वकर्मकसंविद्रूपतामन्तरेण..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900005052, "chapter_id": 8415, "verse_number": "2.5", "content_sanskrit": "परिच्छिन्नत्वहेतुरपि न साध्यसाधकता-मध्यास्ते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900005053, "chapter_id": 8415, "verse_number": "2.6", "content_sanskrit": "कुतश्चाकाशादेः कालपरिच्छेदाध्यवसायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900005054, "chapter_id": 8415, "verse_number": "2.7", "content_sanskrit": "सन्घट इत्यादिप्रत्यक्षेण बाधितविषयत्वा-त्कालात्ययापदिष्टश्च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900005055, "chapter_id": 8415, "verse_number": "2.8", "content_sanskrit": "मैवम् । अबाध्यतायाः प्रत्यक्षग्राह्यत्वात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900005056, "chapter_id": 8415, "verse_number": "2.9", "content_sanskrit": "अस्त्वनुमानमेव बाधकं प्रत्यक्षस्येति चेन्न", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900005057, "chapter_id": 8415, "verse_number": "2.10", "content_sanskrit": "प्रत्यक्षत्वाद्गन्धर्वनगरप्रत्यक्षवद्विप्रतिपन्नमपि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900005058, "chapter_id": 8415, "verse_number": "2.11", "content_sanskrit": "विश्वं सत्यमित्याद्यागमविरोधश्च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900005059, "chapter_id": 8415, "verse_number": "2.12", "content_sanskrit": "किञ्चासदेवेदमग्र आसीदित्यादि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900005060, "chapter_id": 8415, "verse_number": "2.13", "content_sanskrit": "असत्यमप्रतिष्ठं ये जगदाहुरनीश्वर’’मित्यादि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900005061, "chapter_id": 8415, "verse_number": "2.14", "content_sanskrit": "विप्रतिपन्नं सत्यं प्रमाणदृष्टत्वाद्ब्रह्मवदित्यनु-मानविरोधश्च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900005062, "chapter_id": 8415, "verse_number": "2.15", "content_sanskrit": "मैवम् । प्रत्यक्षादिप्रमाणानामतत्त्वावेदकत्वे मानाभावात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900005063, "chapter_id": 8415, "verse_number": "2.16", "content_sanskrit": "किञ्च तत्त्वावेदकत्वादिविशेषानवधूय..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900005064, "chapter_id": 8415, "verse_number": "2.17", "content_sanskrit": "अर्थक्रियाकारित्वाच्च सत्यत्वसाधनं सम्भवति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900005065, "chapter_id": 8415, "verse_number": "2.18", "content_sanskrit": "ननु ज्ञानमात्रमेव भयकम्पादिजनकमर्थ-विशेषितं वा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900005066, "chapter_id": 8415, "verse_number": "2.19", "content_sanskrit": "किञ्च विशिष्टस्याप्यात्मनोऽर्थक्रियाभ्युपगमा-दात्मांशस्य..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900005067, "chapter_id": 8415, "verse_number": "2.20", "content_sanskrit": "दोषगम्यत्वमुपाधिश्च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900005068, "chapter_id": 8415, "verse_number": "2.21", "content_sanskrit": "अनिर्वचनीयत्वाविद्यातत्कार्ययोरन्यतरत्वस्य मिथ्यात्वाभिप्राये..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900005069, "chapter_id": 8415, "verse_number": "2.22", "content_sanskrit": "किञ्च यदि जगत् भ्रान्तिकल्पितं स्यात्तर्हि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900005070, "chapter_id": 8415, "verse_number": "2.23", "content_sanskrit": "ननु यदुक्तं यद्भ्रन्तिकल्पितं तत्साधिष्ठानमिति तन्न", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900005071, "chapter_id": 8415, "verse_number": "2.24", "content_sanskrit": "ननु सत्यत्वे बाधकमुक्तम् । मैवम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900005072, "chapter_id": 8415, "verse_number": "2.25", "content_sanskrit": "निरधिष्ठानत्वमसिद्धम् । आत्मनोऽधिष्ठान-त्वादिति चेन्न", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900005073, "chapter_id": 8415, "verse_number": "2.26", "content_sanskrit": "किञ्च ब्रह्मणि प्रपञ्चस्यारोपितत्वं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900005074, "chapter_id": 8415, "verse_number": "2.27", "content_sanskrit": "ननु निष्प्रधानत्वमसिद्धम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900005075, "chapter_id": 8415, "verse_number": "2.28", "content_sanskrit": "एवमनेकानुमानप्रतिहतत्वान्न दृश्यत्वानुमानं समञ्जसमिति सिद्धम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]