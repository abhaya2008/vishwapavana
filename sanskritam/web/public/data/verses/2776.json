[{"id": 2083292, "chapter_id": 2776, "verse_number": "१२-२८१-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2083293, "chapter_id": 2776, "verse_number": "१२-२८१-१", "content_sanskrit": "अत्रैवोदाहरन्तीममितिहासं पुरातनम्।\nनारदस्य च संवादं देवलस्यासितस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2083294, "chapter_id": 2776, "verse_number": "१२-२८१-२", "content_sanskrit": "आसीनं देवलं वृद्धं बुद्ध्वा बुद्धिमतां वरम्।\nनारदः परिपप्रच्छ भूतानां प्रभवाप्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2083295, "chapter_id": 2776, "verse_number": "१२-२८१-३x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2083296, "chapter_id": 2776, "verse_number": "१२-२८१-३", "content_sanskrit": "कुतः सृष्टमिदं विश्वं ब्रह्मन्स्थावरजङ्गमम्।\nप्रलये च कमभ्येति तद्भवान्प्रब्रवीतु मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2083297, "chapter_id": 2776, "verse_number": "१२-२८१-४x", "content_sanskrit": "असित उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2083298, "chapter_id": 2776, "verse_number": "१२-२८१-४", "content_sanskrit": "येभ्यः सृजति भूतानि कालो भावप्रचोदितः।\nमहाभूतानि पञ्चेति तान्याहुर्भूतचिन्तकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2083299, "chapter_id": 2776, "verse_number": "१२-२८१-५", "content_sanskrit": "तेभ्यः सृजति भूतानि काल आत्मप्रचोदितः।\nएतेभ्यो यः परं ब्रूयादसद्ब्रूयादसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2083300, "chapter_id": 2776, "verse_number": "१२-२८१-६", "content_sanskrit": "विद्धि नारद पञ्चैताञ्शाश्वतानचलान्ध्रुवान्।\nमहतस्तेजसो राशीन्कालषष्ठान्स्वभावतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2083301, "chapter_id": 2776, "verse_number": "१२-२८१-७", "content_sanskrit": "आपश्चैवान्तरिक्षं च पृथिवी वायुपावकौ।\nअसिद्धिः परमेतेभ्यो भूतेभ्यो मुक्तसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2083302, "chapter_id": 2776, "verse_number": "१२-२८१-८", "content_sanskrit": "नोपपत्त्या न वा युक्त्या त्वसद्ब्रूयादसंशयम्।\nवेत्थैतानभिनिर्वृत्तान्षडेते यस्य राशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2083303, "chapter_id": 2776, "verse_number": "१२-२८१-९", "content_sanskrit": "पञ्चैव तानि कालश्च भावाभावौ च केवलौ।\nअष्टौ भूतानि भूतानां शाश्वतानि भवाव्ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2083304, "chapter_id": 2776, "verse_number": "१२-२८१-१०", "content_sanskrit": "अभावभावितेष्वेव तेभ्यश्च प्रभवन्त्यपि।\nविनष्टोऽप्यनुतान्येव जन्तुर्भवति पञ्चधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2083305, "chapter_id": 2776, "verse_number": "१२-२८१-११", "content_sanskrit": "तस्य भूमिमयो देहः श्रोत्रमाकाशसंभवम्।\nसूर्याच्चक्षुरसुर्वायोरद्भ्यस्तु खलु शोणितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2083306, "chapter_id": 2776, "verse_number": "१२-२८१-१२", "content_sanskrit": "चक्षुषी नासिकाकर्णौ त्वक् जिह्वेति च प़ञ्चमी।\nइन्द्रियाणीन्द्रियार्थानां ज्ञानानि कवयो विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2083307, "chapter_id": 2776, "verse_number": "१२-२८१-१३", "content_sanskrit": "दर्शनं श्रवणं घ्राणं स्पर्शनं रसनं तथा।\nउपपत्त्या गुणान्विद्धि पञ्च पञ्चसु धातुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2083308, "chapter_id": 2776, "verse_number": "१२-२८१-१४", "content_sanskrit": "रूपं गन्धो रसः स्पर्शः शब्दश्चैवाथ तद्गुणाः।\nइन्द्रियैरुपलभ्यन्ते पञ्चधा पञ्च पञ्चभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2083309, "chapter_id": 2776, "verse_number": "१२-२८१-१५", "content_sanskrit": "रूपं गन्धं रसं स्पर्शं शब्दं चैवाथ तद्गुणान्।\nइन्द्रियाणि न बुध्यन्ते क्षेत्रज्ञस्तैस्तु बुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2083310, "chapter_id": 2776, "verse_number": "१२-२८१-१६", "content_sanskrit": "चित्तमिन्द्रियसंघातात्परं तस्मात्परं मनः।\nमनसस्तु परा बुद्धिः क्षेत्रज्ञो बुद्धितः परः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2083311, "chapter_id": 2776, "verse_number": "१२-२८१-१७", "content_sanskrit": "पूर्वं चेतयते जन्तुरिन्द्रियैर्विषयान्पृथक्।\nविचार्य मनसा पश्चादथ बुद्ध्या व्यवस्यति।\nइन्द्रियैरुपसृष्टार्थान्मत्वा यस्त्वध्यवस्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2083312, "chapter_id": 2776, "verse_number": "१२-२८१-१८", "content_sanskrit": "चित्तमिन्द्रियसंघातं मनो बुद्धिस्तथाऽष्टमी।\nअष्टौ ज्ञानेन्द्रियाण्याहुरेतान्यध्यात्मचिन्तकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2083313, "chapter_id": 2776, "verse_number": "१२-२८१-१९", "content_sanskrit": "पाणिं पादं च पायुं च मेहनं पञ्चमं मुखम्।\nइति संशब्द्यमानानि शृणु कर्मेन्द्रियाण्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2083314, "chapter_id": 2776, "verse_number": "१२-२८१-२०", "content_sanskrit": "जल्पनाभ्यवहारार्थं मुखमिन्द्रियमुच्यते।\nगमनेन्द्रियं तथा पादौ कर्मणः करणे करौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2083315, "chapter_id": 2776, "verse_number": "१२-२८१-२१", "content_sanskrit": "पायूपस्थं विसर्गार्थमिन्द्रिये तुल्यकर्मणी।\nविसर्गे च पुरीषस्य विसर्गे चापि कामिके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2083316, "chapter_id": 2776, "verse_number": "१२-२८१-२२", "content_sanskrit": "मनः षष्ठान्यथैतानि वाचा सम्यग्यथागमम्।\nज्ञानचेष्टेन्द्रियगुणाः सर्वेषां शब्दिता मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2083317, "chapter_id": 2776, "verse_number": "१२-२८१-२३", "content_sanskrit": "इन्द्रियाणां स्वकर्मभ्यः श्रमादुपरमो यदा।\nभवतीन्द्रियसंन्यासादथ स्वपिति वै नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2083318, "chapter_id": 2776, "verse_number": "१२-२८१-२४", "content_sanskrit": "इन्द्रियाणां व्युपरमे मनोऽव्युपरतं यदि।\nसेवते विषयानेव तं विद्यात्स्वप्नदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2083319, "chapter_id": 2776, "verse_number": "१२-२८१-२५", "content_sanskrit": "सात्विकाश्चैव ये भावास्तथा राजसतामसाः।\nकर्मयुक्ताः प्रशंसन्ति सात्विकान्नेतरांस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2083320, "chapter_id": 2776, "verse_number": "१२-२८१-२६", "content_sanskrit": "आनन्दः कर्मणां सिद्धिः प्रतिपत्तिः परा गतिः।\nसात्विकस्य निमित्तानि भावान्संश्रयसे स्मृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2083321, "chapter_id": 2776, "verse_number": "१२-२८१-२७", "content_sanskrit": "जन्तुष्वेकतमेष्वेवं भावं यो वा समास्थितः।\nभावयोरीप्सितं नित्यं प्रत्यक्षं गमनं द्वयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2083322, "chapter_id": 2776, "verse_number": "१२-२८१-२८", "content_sanskrit": "इन्द्रियाणि च भावाश्च गुणाः सप्तदश स्मृताः।\nतेषामष्टादशो देही यः शरीरे स शाश्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2083323, "chapter_id": 2776, "verse_number": "१२-२८१-२९", "content_sanskrit": "अथवा सशरीरास्ते गुणाः सर्वे शरीरिणाम्।\nसंश्रितास्तद्वियोगे हि सशरीरा न सन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2083324, "chapter_id": 2776, "verse_number": "१२-२८१-३०", "content_sanskrit": "अथवा संविभागेन शरीरं पाञ्चभौतिकम्।\nएकश्च दश चाष्टौ च गुणाः सह शरीरिणाम्।\nऊष्मणा सह विशो वा संघातः पाञ्चभौतिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2083325, "chapter_id": 2776, "verse_number": "१२-२८१-३१", "content_sanskrit": "महान्संधारयत्येतच्छरीरं वायुना सह।\nसत्यप्रभावयुक्तस्य निमित्तं देहभेदने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2083326, "chapter_id": 2776, "verse_number": "१२-२८१-३२", "content_sanskrit": "तथैवोत्पद्यते किंचित्पञ्चत्वं गच्छते तथा।\nपुण्यपापविनाशान्ते पुण्यपापसमीरितः।\nदेहं विशति कालेन ततोऽयं कर्मसंभवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2083327, "chapter_id": 2776, "verse_number": "१२-२८१-३३", "content_sanskrit": "हित्वाहित्वा ह्ययं प्रैति देहाद्देहं कृताश्रयः।\nकालसंचोदितः क्षेत्री विशीर्णाद्वा गृहाद्गृहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2083328, "chapter_id": 2776, "verse_number": "१२-२८१-३४", "content_sanskrit": "तं तु नैवानुतप्यन्ते प्राज्ञा निश्चितनिश्चयाः।\nकृपणास्त्वनुतप्यन्ते जनाः संबन्धिमानिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2083329, "chapter_id": 2776, "verse_number": "१२-२८१-३५", "content_sanskrit": "न ह्ययं कस्यचित्कश्चिन्नास्य कश्चन विद्यते।\nभवत्येको ह्ययं नित्यं शरीरे सुखदुःखकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2083330, "chapter_id": 2776, "verse_number": "१२-२८१-३६", "content_sanskrit": "नैव संजायते जन्तुर्न च जातु विपद्यते।\nयाति देहमयं मुक्त्वा कदाचित्परमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2083331, "chapter_id": 2776, "verse_number": "१२-२८१-३७", "content_sanskrit": "पुण्यपापमयं देहं क्षपयन्कर्मसंक्षयात्।\nक्षीणदेहः पुनर्देही ब्रह्मत्वमुपगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2083332, "chapter_id": 2776, "verse_number": "१२-२८१-३८", "content_sanskrit": "पुण्यपापक्षयार्थं हि साङ्ख्यज्ञानं विधीयते।\nतत्क्षये हृदि पश्यन्ति ब्रह्मभावे परां गतिम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2083333, "chapter_id": 2776, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि एकाशीत्यधिकद्विशततमोऽध्यायः॥ २८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]