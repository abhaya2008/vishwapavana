[{"id": 2020783, "chapter_id": 1436, "verse_number": "३-७४-०x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2020784, "chapter_id": 1436, "verse_number": "३-७४-१", "content_sanskrit": "सर्वं विकारं दृष्ट्वा तु पुण्यश्लोकस्य धीमतः।\nआगत्य केशिनी क्षिप्रं दमयन्त्यै न्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2020785, "chapter_id": 1436, "verse_number": "३-७४-२", "content_sanskrit": "दमयन्ती ततो भूयः प्रेषयामास केशिनीम्।\nमातुः सकाशं दुःखार्ता नलशङ्कासमुत्सुका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2020786, "chapter_id": 1436, "verse_number": "३-७४-३", "content_sanskrit": "परीक्षितो मे बहुशो बाहुको नलशङ्कया।\nरूपे मे संशयस्त्वेकः स्वयमिच्छमि वेदितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2020787, "chapter_id": 1436, "verse_number": "३-७४-४", "content_sanskrit": "स वा प्रवेश्यतां मातर्मां वाऽनुज्ञातुमर्हसि।\nविदितं वाऽथवाऽज्ञातं पितुर्मे संविधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2020788, "chapter_id": 1436, "verse_number": "३-७४-५", "content_sanskrit": "एवमुक्ता तु वैदर्भ्या सा देवी भीममब्रवीत्।\nदुहितुस्तमभिप्रायमन्वजानात्स पार्थिवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2020789, "chapter_id": 1436, "verse_number": "३-७४-६", "content_sanskrit": "सा चै पित्राऽभ्यनुज्ञाता मात्रा च भरतर्षभ।\n`तयोर्नियोगात्कौरव्य केशिनीमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2020790, "chapter_id": 1436, "verse_number": "३-७४-७", "content_sanskrit": "गच्छ केशिनि शीघ्रं त्वंबाहुकं पितृशासनात्।\nआनयस्व यथा माता त्वं तथा कुरु मे प्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2020791, "chapter_id": 1436, "verse_number": "३-७४-८", "content_sanskrit": "गत्वा तु केशिनी शिघ्रं बाहुकं वाक्यमब्रवीत्।\nभीमस्य शासनात्सूतागताहं विद्धि बाहुक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2020792, "chapter_id": 1436, "verse_number": "३-७४-९", "content_sanskrit": "प्रविश्यतां राजवेश्म इत्युक्तो भरतर्षभ।\nबाहुकस्तु चिरं ध्यात्वा केशिन्या सह भारत।\nप्रविवेश महाबाहुर्दमयन्तीनिवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2020793, "chapter_id": 1436, "verse_number": "३-७४-१०", "content_sanskrit": "नलं प्रवेशयामास यत्रतस्याः प्रतिश्रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2020794, "chapter_id": 1436, "verse_number": "३-७४-११", "content_sanskrit": "तां स्म दृष्ट्वैव सहसा दमयन्तीं नलो नृपः।\nआविष्टः शोकदुःखाभ्यां बभूवाश्रुपरिप्लुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2020795, "chapter_id": 1436, "verse_number": "३-७४-१२", "content_sanskrit": "तं तु दृष्ट्वातथायुक्तं दमयन्ती नलं तदा।\nतीव्रशोकसमाविष्टा बभूव वरवर्णिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2020796, "chapter_id": 1436, "verse_number": "३-७४-१३", "content_sanskrit": "ततः काषायवसना जटिला मलपङ्किनी।\nदमयन्ती महाराज बाहुकं वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2020797, "chapter_id": 1436, "verse_number": "३-७४-१४", "content_sanskrit": "पूर्वं दृष्टस्त्वया कश्चिद्धर्मज्ञो नाम बाहुक।\nसुप्तामुत्सृज्यविपिने गतो यः पुरुषः स्त्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2020798, "chapter_id": 1436, "verse_number": "३-७४-१५", "content_sanskrit": "अनागसं प्रियां भार्यां विजने श्रममोहिताम्।\nअपहाय तु को गच्चेत्पुण्यश्लोकमृतेनलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2020799, "chapter_id": 1436, "verse_number": "३-७४-१६", "content_sanskrit": "किमु तस्य मया बाल्यादपराद्धं महीपतेः।\nयो मामुत्सृज्य विपिने गतवान्निद्रयाऽर्दिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2020800, "chapter_id": 1436, "verse_number": "३-७४-१७", "content_sanskrit": "साक्षाद्देवानपाहाय वृतो यः स पुरा मया।\nअनुव्रतामभिमतां पुत्रिणीं त्यक्तवान्कथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2020801, "chapter_id": 1436, "verse_number": "३-७४-१८", "content_sanskrit": "अग्नौ पाणिगृहीता च हंसानां वचने स्थिताम्।\nभरिष्यामीति सत्यं तु प्रतिश्रुत्य क्व तद्गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2020802, "chapter_id": 1436, "verse_number": "३-७४-१९x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2020803, "chapter_id": 1436, "verse_number": "३-७४-१९", "content_sanskrit": "दमयन्त्या ब्रुवन्त्यास्तु सर्वमेतदरिदम।\nशोकजं वारिनेत्राभ्यामसुखं प्रास्रवद्बहु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2020804, "chapter_id": 1436, "verse_number": "३-७४-२०", "content_sanskrit": "अतीव कृष्णताराभ्यां रक्तान्ताभ्यां जलंतु तत्।\nपरिस्रवन्नलो राजा शोकार्तइदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2020805, "chapter_id": 1436, "verse_number": "३-७४-२१", "content_sanskrit": "`नलोऽहं विपुलश्रोणि त्वामुत्सृज्य यतो गतः।\nआविष्टः कलिना भद्रे तेन मोहवशं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2020806, "chapter_id": 1436, "verse_number": "३-७४-२२", "content_sanskrit": "मम राज्यं प्रनष्टं यन्नाहं तत्कृतवान्स्वयम्।\nकलिना तत्कृतं भीरु यच्च त्वामहमत्यजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2020807, "chapter_id": 1436, "verse_number": "३-७४-२३", "content_sanskrit": "यत्त्वया धर्मकृच्छ्रे तु शापेनाभिहतः पुरा।\nवनस्थया दुःखितया शोचन्त्या मांदिवानिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2020808, "chapter_id": 1436, "verse_number": "३-७४-२४", "content_sanskrit": "स मच्छरीरे त्वच्छापाद्दह्यमानोऽवसत्कलिः।\nत्वच्छापदग्धः सततं सोऽग्नावग्निरिवाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2020809, "chapter_id": 1436, "verse_number": "३-७४-२५", "content_sanskrit": "मम च व्यवसायेन तपसा चैव निर्जितः।\nदुःखस्यान्तेन चानेन भवितव्यं हि नौ शुभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2020810, "chapter_id": 1436, "verse_number": "३-७४-२६", "content_sanskrit": "विमुच्य मां गतः पापस्ततोऽहमिह चागतः।\nत्वदर्थं विपुलश्रोणि न हि मेऽन्यत्प्रयोजनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2020811, "chapter_id": 1436, "verse_number": "३-७४-२७", "content_sanskrit": "कथं नु नारी भर्तारमनुरक्तमनुव्रतम्।\nउत्सृज्य वरयेदन्यं यथा त्वं भीरु कर्हिचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2020812, "chapter_id": 1436, "verse_number": "३-७४-२८", "content_sanskrit": "दूताश्चरन्ति पृथिवीं कृत्स्नां नृपतिशासनात्।\nभैमी किल स्म भर्तारं द्वितीयं वरयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2020813, "chapter_id": 1436, "verse_number": "३-७४-२९", "content_sanskrit": "स्वैरवृत्ता यथाकाममनुरूपमिवात्मनः।\nश्रुत्वैव चैवं त्वरितो भागस्वरिरुपस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2020814, "chapter_id": 1436, "verse_number": "३-७४-३०", "content_sanskrit": "दमयन्ती तु तच्छ्रुत्वा नलस्य परिदेवितम्।\nप्राञ्जलिर्वेपमाना च भीता वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2020815, "chapter_id": 1436, "verse_number": "३-७४-३१", "content_sanskrit": "न मामर्हसि कल्याण पापेन परिशङ्कितुम्।\nमया हि देवानुत्सृज्य वृतस्त्वं निषधाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2020816, "chapter_id": 1436, "verse_number": "३-७४-३२", "content_sanskrit": "तवाभिगमनार्थं तु सर्वतो ब्राह्मणा गताः।\nवाक्यानि मम गाथाभिर्गायमाना दिशो दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2020817, "chapter_id": 1436, "verse_number": "३-७४-३३", "content_sanskrit": "ततस्त्वां ब्राह्मणो विद्वान्पर्णादो नाम पार्थिव।\nअभ्यगच्छत्कोसलायामृतुपर्णनिवेशने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2020818, "chapter_id": 1436, "verse_number": "३-७४-३४", "content_sanskrit": "तेन वाक्ये कृतेसम्यक्प्रतिवाक्ये तथा हृते।\nउपायोऽयंमया दृष्टो नैषधानयने तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2020819, "chapter_id": 1436, "verse_number": "३-७४-३५", "content_sanskrit": "त्वामृते नहि लोकेऽन्य एकाह्ना पृथिवीपते।\nसमर्थो योजनशतं गन्तुमश्वैर्नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2020820, "chapter_id": 1436, "verse_number": "३-७४-३६", "content_sanskrit": "`तथापि मां महीपाल भजेतां चरणौ तव।\nस्पृशेयं तेन सत्येन पादावेतौ महीपते।\nयथा नासत्कृतं किंचिन्मनसाऽपि चराम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2020821, "chapter_id": 1436, "verse_number": "३-७४-३७", "content_sanskrit": "अयं चरति लोकेऽस्मिन्भूतसाक्षी सदागतिः।\nएष मे मुञ्चतु प्राणान्यदि पापं चराम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2020822, "chapter_id": 1436, "verse_number": "३-७४-३८", "content_sanskrit": "यथा चरति तिग्मांशुः परितो भुवनं सदा।\nस मुञ्चतु मम प्राणान्यदि पापं चराम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2020823, "chapter_id": 1436, "verse_number": "३-७४-३९", "content_sanskrit": "चन्द्रमाः सर्वभूतानामन्तश्चरति साक्षिवत्।\nस मुञ्चतु मम प्राणान्यदि पापं चराम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2020824, "chapter_id": 1436, "verse_number": "३-७४-४०", "content_sanskrit": "एते देवास्त्रयः कृत्स्नं त्रैलोक्यं धारयन्ति वै।\nविब्रुवन्तु यथा सत्यमेतद्देवास्त्यजन्तु माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2020825, "chapter_id": 1436, "verse_number": "३-७४-४१", "content_sanskrit": "एवमुक्ते ततो वायुरन्तरिक्षादभाषत।\nनैषा कृतवती पापं नल सत्यं ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2020826, "chapter_id": 1436, "verse_number": "३-७४-४२", "content_sanskrit": "राजञ्शीलनिधिः स्फीतो दमयन्त्या सुरक्षितः।\nसाक्षिणो रक्षिणश्चास्या वयं त्रीन्परिवत्सरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2020827, "chapter_id": 1436, "verse_number": "३-७४-४३", "content_sanskrit": "उपायो विहितश्चायं त्वदर्थमतुलोऽनया।\nन ह्येकाह्ना शतं गन्ता त्वामृतेऽन्यः पुमानिह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2020828, "chapter_id": 1436, "verse_number": "३-७४-४४", "content_sanskrit": "उपपन्ना त्वया भैमी त्वं च भैम्या महीपते।\nनात्र शङ्का त्वया कार्या संगच्छ सह भार्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2020829, "chapter_id": 1436, "verse_number": "३-७४-४५", "content_sanskrit": "तथा ब्रुवति वायौ तु पुष्पवृष्टिः पपात ह।\nदेवदुन्दुभयो नेदुर्ववौ च पवनः शिवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2020830, "chapter_id": 1436, "verse_number": "३-७४-४६", "content_sanskrit": "तदद्भुतमयं दृष्ट्वा नलो राजाऽथ भारत।\nदमयन्त्यां विशङ्कां तामुपाकर्षदरिंदमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2020831, "chapter_id": 1436, "verse_number": "३-७४-४७", "content_sanskrit": "ततस्तद्वस्त्रमरजः प्रावृणोद्वसुधाधिपः।\nसंस्मृत्य नागराजं तं ततो लेभे स्वकं वपुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2020832, "chapter_id": 1436, "verse_number": "३-७४-४८", "content_sanskrit": "स्वरूपिणं तु भर्तारं दृष्ट्वा भीमसुता तदा।\nप्राक्रोशदुच्चैरालिङ्ग्य पुण्यश्लोकमनिन्दिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2020833, "chapter_id": 1436, "verse_number": "३-७४-४९", "content_sanskrit": "भैमीमपि नलो राजा भ्राजमानो यथा पुरा।\nसस्वजे स्वसुतौ चापि यथावत्प्रत्यनन्दत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2020834, "chapter_id": 1436, "verse_number": "३-७४-५०", "content_sanskrit": "ततः स्वोरसि विन्यस्य वक्रं तस्य शुभानना।\nपरीता तेन दुःखेन निशश्वासायतेक्षणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2020835, "chapter_id": 1436, "verse_number": "३-७४-५१", "content_sanskrit": "तथैव मलदिग्धाङ्गीं परिष्वज्य शुचिस्मिताम्।\nसुचिरं पुरुषव्याघ्रस्तस्थौ शोकपरिप्लुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2020836, "chapter_id": 1436, "verse_number": "३-७४-५२", "content_sanskrit": "ततः सर्वं यथावृत्तं दमयन्त्या नलस्य च।\nभीमायाकथयत्प्रीत्या वैदर्भ्या जननी नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2020837, "chapter_id": 1436, "verse_number": "३-७४-५३", "content_sanskrit": "ततोऽब्रवीन्महाराजः कृतशौचमहंनलम्।\nदमयन्त्या सहोपेतं कल्ये द्रष्टा सुखोषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2020838, "chapter_id": 1436, "verse_number": "३-७४-५४", "content_sanskrit": "ततस्तौ सहितौ रात्रिं कथयन्तौ पुरातनम्।\nवने विचरितं सर्वमूषतुर्मुदितौ नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2020839, "chapter_id": 1436, "verse_number": "३-७४-५५", "content_sanskrit": "गृहे भीमस्य नृपतेः परस्परसुखैषिणौ।\nवसेतां हृष्टसंकल्पौ वैदर्भी च नलश् ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2020840, "chapter_id": 1436, "verse_number": "३-७४-५६", "content_sanskrit": "स चतुर्थे ततो वर्षे संगम्य सह भार्यया।\nसर्वकामैः सुसिद्धार्थो लब्धवान्परमां मुदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2020841, "chapter_id": 1436, "verse_number": "३-७४-५७", "content_sanskrit": "दमयन्त्यपि भर्तारमासाद्याप्यायिता भृशम्।\nअर्धसंजातसस्येव तोयं प्राप्य वसुंधरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2020842, "chapter_id": 1436, "verse_number": "३-७४-५८", "content_sanskrit": "सैवं समेत्य व्यपनीय तन्द्रां\nशान्तज्वरा हर्षविवृद्धसत्त्वा।\nरराज भैमी समवाप्तकामा\nशीतांशुना रात्रिरिवोदितेन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2020843, "chapter_id": 1436, "verse_number": "", "content_sanskrit": "॥ इतिश्रीमन्महाभारते अरण्यपर्वणि नलोपाख्यानपर्वणि चतुःसप्ततितमोऽध्यायः ॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]