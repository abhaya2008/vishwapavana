[{"id": 2145764, "chapter_id": 4140, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2145765, "chapter_id": 4140, "verse_number": "१", "content_sanskrit": "एवमुक्तः प्रत्युवाच धर्मराजं जनार्दनः ।\nउभयोरेव शान्त्यर्थं यास्यामि कुरुसंसदम्\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2145766, "chapter_id": 4140, "verse_number": "२", "content_sanskrit": "शमं तत्र लभेयं चेद् युष्मदर्थमहापयन् ।\nपुण्यं मे सुमहद् राजन् चरितं स्यान्महाफलम्\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2145767, "chapter_id": 4140, "verse_number": "३", "content_sanskrit": "मोचयेयं मृत्युपाशात् संरब्धान् कुरुसृञ्जयान् ।\nपाण्डवान् धार्तराष्ट्रांश्च सर्वां च पृथिवीमिमाम्\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2145768, "chapter_id": 4140, "verse_number": "४", "content_sanskrit": "एवमुक्तः प्रत्युवाच धर्मराजो जनार्दनम् ।\nभ्रातॄणां समवेतानां सकाशे पुरुषोत्तमम्\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2145769, "chapter_id": 4140, "verse_number": "५", "content_sanskrit": "न ममैतन्मतं कृष्ण यत् त्वं यायाः कुरून् प्रति ।\nसुयोधनः सूक्तमपि न करिष्यति ते वचः\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2145770, "chapter_id": 4140, "verse_number": "६", "content_sanskrit": "सुयोधनो हि दुष्टात्मा कर्णश्च सहसौबलः ।\nसमेतं पार्थिवं क्षत्रं दुर्योधनवशानुगम्\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2145771, "chapter_id": 4140, "verse_number": "७", "content_sanskrit": "तेषां मध्येऽवतरणं तव कृष्ण न रोचये\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2145772, "chapter_id": 4140, "verse_number": "८", "content_sanskrit": "न हि नः प्रीणयेद् द्रव्यं न देवत्वं कुतः सुखम् ।\nन च सर्वामरैश्वर्यं तव रोधेन माधव\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2145773, "chapter_id": 4140, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2145774, "chapter_id": 4140, "verse_number": "९", "content_sanskrit": "जानाम्येतां महाराज धार्तराष्ट्रस्य पापताम् ।\nअवाच्यास्तु भविष्यामः सर्वलोके महीक्षिताम्\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2145775, "chapter_id": 4140, "verse_number": "१०", "content_sanskrit": "न चापि मम पर्याप्ताः सहिताः सर्वपार्थिवाः ।\nक्रुद्धस्य संयुगे स्थातुं सिंहस्येवेतरे मृगाः\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2145776, "chapter_id": 4140, "verse_number": "११", "content_sanskrit": "अथ चैते प्रवर्तन्ते मयि किञ्चिदसाम्प्रतम् ।\nनिर्दहेयं कुरून् सर्वानिति मे धीयते मतिः\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2145777, "chapter_id": 4140, "verse_number": "१२", "content_sanskrit": "न जातु गमनं पार्थ भवेत् तत्र निरर्थकम् ।\nअर्थप्राप्तिः कदाचित् स्यादन्ततो वाऽप्यवाच्यता\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2145778, "chapter_id": 4140, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2145779, "chapter_id": 4140, "verse_number": "१३", "content_sanskrit": "यत् तुभ्यं रोचते कृष्ण स्वस्ति प्राप्नुहि कौरवान् ।\nकृतार्थं स्वस्तिमन्तं त्वां द्रक्ष्यामि पुनरागतम्\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2145780, "chapter_id": 4140, "verse_number": "१४", "content_sanskrit": "विष्वक्सेन कुरून् गत्वा भरतान् शमय प्रभो ।\nयथा सर्वे सुमनसः सह स्याम सुचेतसः\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2145781, "chapter_id": 4140, "verse_number": "१५", "content_sanskrit": "भ्राता चासि सखा चासि बीभत्सोर्मम च प्रियः ।\nसौहृदेनाविशङ्क्योऽसि स्वस्ति प्राप्नुहि भूतये\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2145782, "chapter_id": 4140, "verse_number": "१६", "content_sanskrit": "अस्मान् वेत्थ परान् वेत्थ वेत्थार्थान् वेत्थ भाषितुम् ।\nयद्यदस्मद्धितं कृष्ण तत्तद् वाच्यः सुयोधनः\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2145783, "chapter_id": 4140, "verse_number": "१७", "content_sanskrit": "यद्यद् धर्मेण संयुक्तमुपपद्येद्धितं वचः ।\nतत्तत् केशव भाषेथाः सान्त्वं वा यदि वेतरत्\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2145784, "chapter_id": 4140, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकसप्ततितमोऽध्यायः ॥७१॥\nभगवद्यानपर्वणि द्वितीयोऽध्यायः ॥२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]