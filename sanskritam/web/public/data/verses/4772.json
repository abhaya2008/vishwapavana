[{"id": 2178380, "chapter_id": 4772, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2178381, "chapter_id": 4772, "verse_number": "१", "content_sanskrit": "एवमुक्त्वा तु गान्धारी कुरूणामवकर्तनम् ।\nअपश्यत् तत्र तिष्ठन्ती सर्वं दिव्येन चक्षुषा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2178382, "chapter_id": 4772, "verse_number": "२", "content_sanskrit": "गान्धारी च महाभागा समानव्रतचारिणी ।\nउग्रेण तपसा युक्ता सततं सत्यवादिनी\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2178383, "chapter_id": 4772, "verse_number": "३", "content_sanskrit": "वरदानेन कृष्णस्य महर्षेः पुण्यकर्मणः ।\nदिव्यज्ञानबलोपेता विविधं पर्यदेवयत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2178384, "chapter_id": 4772, "verse_number": "४", "content_sanskrit": "ददर्श सा बुद्धिमती दूरादेव यथाऽन्तिके ।\nरणाजिरं तद्वीराणामद्भुतं रोमहर्षणम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2178385, "chapter_id": 4772, "verse_number": "५", "content_sanskrit": "अस्थिकेशपरिस्तीर्णं रुधिरौघपरिप्लुतम् ।\nशरीरैर्बहुसाहस्रैर्विनिकीर्णं समन्ततः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2178386, "chapter_id": 4772, "verse_number": "६", "content_sanskrit": "यूनां गजानामश्वानामावृतं रुधिराशनैः ।\nशरीरैरशिरस्कैश्च विदेहैश्च शिरोगणैः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2178387, "chapter_id": 4772, "verse_number": "७", "content_sanskrit": "गजाश्वनरवीराणां निःसत्त्वैरभिसंवृतम् ।\nसृगालवलगोमायुकङ्ककाकनिषेवितम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2178388, "chapter_id": 4772, "verse_number": "८", "content_sanskrit": "मोदनं पुरुषादानां रक्षसां कुलसङ्कुलम् ।\nअशिवाभिः शिवाभिश्च सेवितं गृध्रनादितम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2178389, "chapter_id": 4772, "verse_number": "९", "content_sanskrit": "ततो व्यासाभ्यनुज्ञातो धृतराष्ट्रो महीपतिः ।\nपाण्डुपुत्राश्च ते सर्वे युधिष्ठिरपुरोगमाः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2178390, "chapter_id": 4772, "verse_number": "१०", "content_sanskrit": "(वासुदेवं पुरस्कृत्य हतबन्धुं च पार्थिवम् ।)\nकुरुस्त्रियः समासाद्य जग्मुरायोधनं प्रति\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2178391, "chapter_id": 4772, "verse_number": "११", "content_sanskrit": "समासाद्य कुरुक्षेत्रं ताः स्त्रियो निहतेश्वराः ।\nअपश्यन्त हतांस्तत्र पुत्रान् भ्रातॄन् प्रियान् सखीन्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2178392, "chapter_id": 4772, "verse_number": "१२", "content_sanskrit": "क्रव्यादैर्भक्ष्यमाणांश्च कङ्कगोमायुवायसैः ।\nभूतैः पिशाचै रक्षोभिर्विविधैश्च निशाचरैः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2178393, "chapter_id": 4772, "verse_number": "१३", "content_sanskrit": "रुद्राक्रीडनिभं दृष्ट्वा तदा विशसनं स्त्रियः ।\nकुरर्य इव शोकार्ता विक्रोशन्त्यो निपेतिरे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2178394, "chapter_id": 4772, "verse_number": "१४", "content_sanskrit": "अदृष्टपूर्वं पश्यन्त्यो दुःखार्ता भरतस्त्रियः ।\nशरीरेषु स्खलन्त्यश्च न्यपतंश्चापरा भुवि\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2178395, "chapter_id": 4772, "verse_number": "१५", "content_sanskrit": "श्रान्तानां चाप्यनाथानां क्रन्दन्तीनां भृशं तथा ।\nपाञ्चालकुरुयोषाणां कृपणं तदभून्महत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2178396, "chapter_id": 4772, "verse_number": "१६", "content_sanskrit": "दुःखाभिहतचित्ताभिः समन्तादनुनादितम् ।\nदृष्ट्वाऽऽयोधनमत्युग्रं धर्मज्ञा सुबलात्मजा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2178397, "chapter_id": 4772, "verse_number": "१७", "content_sanskrit": "ततः सा पुण्डरीकाक्षमामन्त्र्य पुरुषोत्तमम् ।\nकुरूणां वैशसं दृष्ट्वा दुःखाद् वचनमब्रवीत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2178398, "chapter_id": 4772, "verse_number": "", "content_sanskrit": "गान्धारी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2178399, "chapter_id": 4772, "verse_number": "१८", "content_sanskrit": "पश्यैताः पुण्डरीकाक्ष स्नुषा मे निहतेश्वराः ।\nप्रकीर्णकेश्यः क्रोशन्त्यः कुरर्य इव माधव\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2178400, "chapter_id": 4772, "verse_number": "१९", "content_sanskrit": "अमूस्त्वभिसमागम्य स्मरन्त्यो भरतर्षभान् ।\nपृथगेवानुपद्यन्ते पुत्रान् भ्रातॄन् पितॄन् पतीन्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2178401, "chapter_id": 4772, "verse_number": "२०", "content_sanskrit": "वीरसूभिर्महाबाहो हतपुत्राभिरावृतम् ।\nक्वचिच्च वीरपत्नीभिर्हतवीराभिरावृतम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2178402, "chapter_id": 4772, "verse_number": "२१", "content_sanskrit": "शोभितं पुरुषव्याघ्रैर्भीष्मकर्णाभिमन्युभिः ।\nद्रोणद्रुपदशल्यैश्च ज्वलद्भिरिव पावकैः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2178403, "chapter_id": 4772, "verse_number": "२२", "content_sanskrit": "काञ्चनैः कवचैर्निष्कैर्मणिभिश्च महाघनैः ।\nअद्भुतैर्हस्तकेयूरैः स्रग्भिश्च समलङ्कृतम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2178404, "chapter_id": 4772, "verse_number": "२३", "content_sanskrit": "वीरबाहुविसृष्टाभिः शक्तिभिः परिघैरपि ।\nखड्गैश्च विमलैस्तीक्ष्णैः सशरैश्च शरासनैः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2178405, "chapter_id": 4772, "verse_number": "२४", "content_sanskrit": "क्रव्यादसङ्घैर्मुदितैः तिष्ठद्भिः सहितैः क्वचित् ।\nक्वचिदाक्रीडमानैश्च शयानैश्चापरैः क्वचित्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2178406, "chapter_id": 4772, "verse_number": "२५", "content_sanskrit": "एतदेवंविधं वीर सम्पश्यायोधनं महत् ।\nत्वया तु साधितं कर्म पुष्कराक्ष महाद्युते\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2178407, "chapter_id": 4772, "verse_number": "२६", "content_sanskrit": "पश्यमाना च दह्यामि शोकेनाहं जनार्दन\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2178408, "chapter_id": 4772, "verse_number": "२७", "content_sanskrit": "पाञ्चालानां कुरूणां च विनाशं मधुसूदन ।\nपञ्चानामिव भूतानामहं वधमचिन्तयम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2178409, "chapter_id": 4772, "verse_number": "२८", "content_sanskrit": "तान् सुपर्णाश्च गृध्राश्च विकर्षन्त्यसृगुक्षितान् ।\nनिगृह्य कवचानुग्रान् भक्षयन्ति सहस्रशः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2178410, "chapter_id": 4772, "verse_number": "२९", "content_sanskrit": "जयद्रथस्य कर्णस्य तथैव द्रोणभीष्मयोः ।\nअभिमन्योर्विनाशं च कश्चिन्तयितुमर्हति\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2178411, "chapter_id": 4772, "verse_number": "३०", "content_sanskrit": "अवध्यकल्पान् निहतान् गतसत्वानचेतसः ।\nगृध्रकङ्कवलश्येनश्वसृगालसमावृतान्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2178412, "chapter_id": 4772, "verse_number": "३१", "content_sanskrit": "अमर्षवशमापन्नान् दुर्योधनवशे स्थितान् ।\nपश्येमान् पुरुषव्याघ्रान् संशान्तानिव पावकान्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2178413, "chapter_id": 4772, "verse_number": "३२", "content_sanskrit": "शयनान्युचिताः सर्वे मृदूनि विमलानि च ।\nविपन्नास्तेऽद्य वसुधां विवृतामधिशेरते\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2178414, "chapter_id": 4772, "verse_number": "३३", "content_sanskrit": "वन्दिभिश्चाधिकं काले स्तुवद्भिरभिनन्दिताः ।\nशिवानामशिवा घोराः शृण्वन्ति विविधा गिरः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2178415, "chapter_id": 4772, "verse_number": "३४", "content_sanskrit": "ये पुरा शेरते वीराः शयनेषु यशस्विनः ।\nचन्दनागरुदिग्धाङ्गास्तेऽद्य पांसुषु शेरते\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2178416, "chapter_id": 4772, "verse_number": "३५", "content_sanskrit": "तेषामाभरणान्येते गृध्रगोमायुवायसाः ।\nआक्षिपन्ति शिवा दृष्ट्वा विनदन्ति पुनः पुनः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2178417, "chapter_id": 4772, "verse_number": "३६", "content_sanskrit": "बाणान् विशितान् पीतान् निस्त्रिंशान् विमला गदाः ।\nयुद्धाभिपातिनः शूरा जीवन्त इव बिभ्रति\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2178418, "chapter_id": 4772, "verse_number": "३७", "content_sanskrit": "आपीतवर्णा बहवः क्रव्यादैरभिघातिताः ।\nऋषभप्रतिरूपाक्षाः शेरते च सहस्रशः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2178419, "chapter_id": 4772, "verse_number": "३८", "content_sanskrit": "अपरे पुनरालिङ्ग्य गदाः परिघबाहवः ।\nशेरतेऽभिमुखाः शूरा दयिता इव योषितः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2178420, "chapter_id": 4772, "verse_number": "३९", "content_sanskrit": "बिभ्रतः कवचान्यन्ये विमलान्यायुधानि च ।\nन धर्षयन्ति क्रव्यादा जीवन्तीति जनार्दन\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2178421, "chapter_id": 4772, "verse_number": "४०", "content_sanskrit": "क्रव्यादैः कृष्यमाणानामपरेषां महात्मनाम् ।\nशातकुम्भस्रजश्चित्रा विप्रकीर्णाः सहस्रशः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2178422, "chapter_id": 4772, "verse_number": "४१", "content_sanskrit": "एते गोमायवोऽभीता निहतानां यशस्विनाम् ।\nकण्ठान्तरगतान् दिव्यान् आक्षिपन्ति महामणीन्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2178423, "chapter_id": 4772, "verse_number": "४२", "content_sanskrit": "सर्वेष्वपररात्रेषु यानवन्दन्त वन्दिनः ।\nस्तुतिभिश्च परार्थ्याभिरुपचारैश्च शिक्षिताः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2178424, "chapter_id": 4772, "verse_number": "४३", "content_sanskrit": "तानद्य परिदेवन्ति दुःखिताः परमाङ्गनाः ।\nकृपणा वृष्णिशार्दूल दुःखशोकान्विता भृशम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2178425, "chapter_id": 4772, "verse_number": "४४", "content_sanskrit": "नीलोत्पलवनानीव विभान्ति रुचिराणि वै ।\nमुखानि परमस्त्रीणां परिशुष्काणि केशव\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2178426, "chapter_id": 4772, "verse_number": "४५", "content_sanskrit": "रुदित्वा विरता ह्येता ध्यायन्तः सपरिक्लमाः ।\nकुरुस्त्रियोऽभिगच्छन्ति तेन तेनैव दुःखिताः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2178427, "chapter_id": 4772, "verse_number": "४६", "content_sanskrit": "एतान्यादित्यवर्णानि पुण्डरीकनिभानि च ।\nपश्य रोदनताम्राणि वदनानीह योषिताम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2178428, "chapter_id": 4772, "verse_number": "४७", "content_sanskrit": "श्यामानां वरवर्णानां गौरीणामेकवाससाम् ।\nदुर्योधनवरस्त्रीणां पश्य वृन्दानि केशव\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2178429, "chapter_id": 4772, "verse_number": "४८", "content_sanskrit": "आसामपरिपूर्णार्थं निशम्य परिदेवितम् ।\nइतरेतरसङ्क्रन्दात् न विजानन्ति योषितः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2178430, "chapter_id": 4772, "verse_number": "४९", "content_sanskrit": "एता दीर्घमिवोच्छ्वस्य निःश्वस्य च विलप्य च ।\nविस्पन्दमाना दुःखेन जीवितं नाजहुः स्त्रियः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2178431, "chapter_id": 4772, "verse_number": "५०", "content_sanskrit": "बह्वदृष्ट्वा शरीराणि क्रोशन्ति विलपन्ति च ।\nपाणिभिश्चापरा घ्नन्ति शिरांसि मृदुपाणयः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2178432, "chapter_id": 4772, "verse_number": "५१", "content_sanskrit": "शिरोभिः पतितैर्हस्तैः सर्वाङ्गैः खण्डशः कृतैः ।\nइतरेतरसङ्क्रान्तैरास्तीर्णा भाति मेदिनी\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2178433, "chapter_id": 4772, "verse_number": "५२", "content_sanskrit": "विशिरस्कान् अधःकायान् दृष्ट्वा घोराननिन्दितान् ।\nमुह्यन्त्यनुचिता नार्यो विदेहानि शिरांसि च\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2178434, "chapter_id": 4772, "verse_number": "५३", "content_sanskrit": "शिरः कायेन सन्धाय वीक्षमाणा विचेतसः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2178435, "chapter_id": 4772, "verse_number": "५४", "content_sanskrit": "अपश्यन्त्योऽपरं तत्र नेदमस्येति दुःखिताः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2178436, "chapter_id": 4772, "verse_number": "५५", "content_sanskrit": "बाहूरुचरणानन्यान् विशिखोन्मथितान् पृथक् ।\nसन्दधत्योऽसुखाविष्टा मूर्छन्तीह पुनः पुनः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2178437, "chapter_id": 4772, "verse_number": "५६", "content_sanskrit": "उत्कृत्तशिरसश्चान्यान् विजग्धान् मृगपक्षिभिः ।\nदृष्ट्वाऽपि न विजानन्ति भर्तॄन् भारतयोषितः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2178438, "chapter_id": 4772, "verse_number": "५७", "content_sanskrit": "पाणिभिश्चापरा घ्नन्ति शिरांसि मधुसूदन ।\nप्रेक्ष्य भ्रातॄन् पितॄन् वाऽपि पतींश्च निहतान् परैः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2178439, "chapter_id": 4772, "verse_number": "५८", "content_sanskrit": "बाहुभिः कार्मुकैः खड्गैः शिरोभिश्च सकुण्डलैः ।\nअगम्यकल्पा पृथिवी मांसशोणितकर्दमा\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2178440, "chapter_id": 4772, "verse_number": "५९", "content_sanskrit": "न दुःखेषूचिताः पूर्वं दुःखं गाहन्त्यनिन्दिताः ।\nभ्रातृभिः पितृभिः पुत्रैरुपस्तीर्णां वसुन्धराम्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2178441, "chapter_id": 4772, "verse_number": "६०", "content_sanskrit": "यूथानीव किशोरीणां सुकेशीनां जनार्दन ।\nस्नुषाणां धृतराष्ट्रस्य पश्य बृन्दान्यनेकशः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2178442, "chapter_id": 4772, "verse_number": "६१", "content_sanskrit": "नातो दुःखतरं किंस्वित् केशव प्रतिभाति मे ।\nयदिमाः कुर्वते सर्वा रवमुच्चावचं स्त्रियः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2178443, "chapter_id": 4772, "verse_number": "६२", "content_sanskrit": "नूनं वै चरितं पापं मया पूर्वेषु जन्मसु ।\nयान् पश्यामि हतान् पुत्रान् पौत्रान् भ्रातॄंश्च केशव\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2178444, "chapter_id": 4772, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2178445, "chapter_id": 4772, "verse_number": "६३", "content_sanskrit": "एवमार्ता विलपती समाभाष्य जनार्दनम् ।\nगान्धारी पुत्रशोकार्ता ददर्श निहतं सुतम्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2178446, "chapter_id": 4772, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां स्त्रीपर्वणि\nस्त्रीप्रलापो नाम षोडशोऽध्यायः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2178447, "chapter_id": 4772, "verse_number": "", "content_sanskrit": "स्त्रीपर्वणि प्रथमोऽध्यायः ॥१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]