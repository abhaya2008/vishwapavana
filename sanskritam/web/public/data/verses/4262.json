[{"id": 2150370, "chapter_id": 4262, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2150371, "chapter_id": 4262, "verse_number": "१", "content_sanskrit": "ततः शिखण्डिनो माता यथातत्त्वं नराधिप ।\nआचचक्षे महाबाहो भर्त्रे कन्यां शिखण्डिनीम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2150372, "chapter_id": 4262, "verse_number": "२", "content_sanskrit": "अपुत्रया मया राजन् सपत्नीनां भयादियम् ।\nकन्या शिखण्डिनी जाता पुरुषो वै निवेदितः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2150373, "chapter_id": 4262, "verse_number": "३", "content_sanskrit": "त्वया चैव नरश्रेष्ठ मम प्रीत्याऽनुमोदितम् ।\nपुत्रकर्म कृतं चैव कन्यायाः पार्थिवर्षभ\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2150374, "chapter_id": 4262, "verse_number": "४", "content_sanskrit": "भार्योढा वै त्वया राजन् दशार्णाधिपतेः सुता ।\nमया च प्रत्यभिहितं देवकार्यार्थदर्शनात्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2150375, "chapter_id": 4262, "verse_number": "५", "content_sanskrit": "कन्या भूत्वा पुमान् भावीत्युक्तं चैतदुपेक्षितम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2150376, "chapter_id": 4262, "verse_number": "६", "content_sanskrit": "तच्छ्रुत्वा वै द्रुपदो याज्ञसेनः\nसर्वं तत्त्वं मन्त्रविद्भ्यो निवेद्य ।\nमन्त्रं राजा मन्त्रयामास राजन्\nयथायुक्तं रक्षणेऽथ प्रजानाम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2150377, "chapter_id": 4262, "verse_number": "७", "content_sanskrit": "सम्बन्धकं चैव समर्थ्य तस्मिन्\nदाशार्णके वै नृपतौ नरेन्द्रः ।\nस्वयं कृत्वा विप्रलम्भं यथावत्\nमन्त्रैकाग्रो निश्चयं वै जगाम\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2150378, "chapter_id": 4262, "verse_number": "८", "content_sanskrit": "स्वभावयुक्तं नगरमापत्काले तु भारत ।\nगोपयामास राजेन्द्र सर्वतः समलङ्कृतम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2150379, "chapter_id": 4262, "verse_number": "९", "content_sanskrit": "आर्तिं च परमां राजा जगाम सह भार्यया ।\nदशार्णपतिना सार्धं विरोधे भरतर्षभ\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2150380, "chapter_id": 4262, "verse_number": "१०", "content_sanskrit": "कथं सम्बन्धिना सार्धं न मे स्याद् विग्रहो महान् ।\nइति सञ्चिन्त्य मनसा देवतामर्चयत् तदा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2150381, "chapter_id": 4262, "verse_number": "११", "content_sanskrit": "तं तु दृष्ट्वा तदा राजन् देवी देवपरं तदा ।\nअर्चां प्रयुञ्जानमथो भार्या वचनमब्रवीत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2150382, "chapter_id": 4262, "verse_number": "१२", "content_sanskrit": "देवानां प्रतिपत्तिश्च सत्या साधुमता तदा ।\nदैवतानि च सर्वाणि पूज्यन्तां भूरिदक्षिणैः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2150383, "chapter_id": 4262, "verse_number": "१३", "content_sanskrit": "अग्नयश्चापि हूयन्तां दाशार्णप्रतिषेधने\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2150384, "chapter_id": 4262, "verse_number": "१४", "content_sanskrit": "अयुद्धेन निवृत्तिं च मनसा चिन्तय प्रभो ।\nदेवतानां प्रसादेन सर्वमेतद् भविष्यति\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2150385, "chapter_id": 4262, "verse_number": "१५", "content_sanskrit": "मन्त्रिभिर्मन्त्रितं सार्धं त्वया पृथुललोचन ।\nपुरस्यास्याविनाशाय यच्च राजंस्तथा कुरु\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2150386, "chapter_id": 4262, "verse_number": "१६", "content_sanskrit": "दैवं हि मानुषोपेतं भृशं सिद्ध्यति पार्थिव ।\nपरस्परविरोधात्तु नानयोः सिद्धिरस्ति वै\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2150387, "chapter_id": 4262, "verse_number": "१७", "content_sanskrit": "तस्माद् विधाय नगरे विधानं सचिवैः सह ।\nअर्चयस्व यथाकामं दैवतानि विशाम्पते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2150388, "chapter_id": 4262, "verse_number": "१८", "content_sanskrit": "एवं सम्भाषमाणौ तु दृष्ट्वा शोकपरायणौ ।\nशिखण्डिनी तदा कन्या व्रीडितेव तपस्विनी\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2150389, "chapter_id": 4262, "verse_number": "१९", "content_sanskrit": "ततः सा चिन्तयामास मत्कृते दुःखितावुभौ ।\nइमाविति ततश्चक्रे मतिं प्राणविनाशने\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2150390, "chapter_id": 4262, "verse_number": "२०", "content_sanskrit": "एवं सा निश्चयं कृत्वा भृशं शोकपरायणा ।\nनिर्जगाम गृहं त्यक्त्वा गहनं निर्जनं वनम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2150391, "chapter_id": 4262, "verse_number": "२१", "content_sanskrit": "यक्षेणर्द्धिमता राजन् स्थूणाकर्णेन पालितम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2150392, "chapter_id": 4262, "verse_number": "२२", "content_sanskrit": "तद्भयादेव च जनो विसर्जयति तद्वनम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2150393, "chapter_id": 4262, "verse_number": "२३", "content_sanskrit": "तत्र स्थूणस्य भवनं सुधामृत्तिकलेपनम् ।\nलाजोत्थापितधूमाढ्यमुच्चप्राकारतोरणम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2150394, "chapter_id": 4262, "verse_number": "२४", "content_sanskrit": "तत् प्रविश्य शिखण्डी सा द्रुपदस्यात्मजा नृप ।\nअनश्नती बहुतिथं शरीरमुदशोषयत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2150395, "chapter_id": 4262, "verse_number": "२५", "content_sanskrit": "दर्शयामास तां यक्षः स्थूणो मध्वक्षसंयुतः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2150396, "chapter_id": 4262, "verse_number": "२६", "content_sanskrit": "किमर्थोऽयं तवारम्भः करिष्ये ब्रूहि माचिरम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2150397, "chapter_id": 4262, "verse_number": "२७", "content_sanskrit": "अशक्यमिति सा यक्षं पुनः पुनरुवाच ह ।\nकरिष्यामीति वै क्षिप्रं प्रत्युवाचाथ गुह्यकः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2150398, "chapter_id": 4262, "verse_number": "२८", "content_sanskrit": "धनेश्वरस्यानुचरो वरदोऽस्मि नृपात्मजे ।\nअदेयमपि दास्यामि ब्रूहि यत् ते विवक्षितम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2150399, "chapter_id": 4262, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2150400, "chapter_id": 4262, "verse_number": "२९", "content_sanskrit": "ततः शिखण्डी तत् सर्वमखिलेन न्यवेदयत् ।\nतस्मै यक्षप्रधानाय स्थूणाकर्णाय भारत\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2150401, "chapter_id": 4262, "verse_number": "३०", "content_sanskrit": "आपन्नो मे पिता यक्ष नचिराद् विनशिष्यति ।\nअभियास्यति सक्रोधो दशार्णाधिपतिर्हि तम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2150402, "chapter_id": 4262, "verse_number": "३१", "content_sanskrit": "मन्निमित्तं महाबाहो स हेमकवचो नृपः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2150403, "chapter_id": 4262, "verse_number": "३२", "content_sanskrit": "तस्माद् रक्षस्व मां यक्ष मातरं पितरं च मे\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2150404, "chapter_id": 4262, "verse_number": "३३", "content_sanskrit": "प्रतिज्ञातो हि भवता दुःखप्रतिशमो मम ।\nभवेयं पुरुषो यक्ष त्वत्प्रसादादनिन्दितः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2150405, "chapter_id": 4262, "verse_number": "३४", "content_sanskrit": "यावदेव स राजा वै नोपयाति पुरं मम ।\nतावदेव महायक्ष प्रसादं कुरु गुह्यक\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2150406, "chapter_id": 4262, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि त्रिनवत्युत्तरशततमोऽध्यायः ॥१९३॥\nअम्बोपाख्यानपर्वणि त्रयोविंशोऽध्यायः ॥२३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]