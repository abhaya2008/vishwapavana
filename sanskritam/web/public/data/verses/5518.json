[{"id": 2212042, "chapter_id": 5518, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2212043, "chapter_id": 5518, "verse_number": "१", "content_sanskrit": "चक्रायुध नमस्तेऽस्तु देवेश गरुडध्वज ।\nचान्द्रायणविधिं पुण्यमाख्याहि भगवन् मम ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2212044, "chapter_id": 5518, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2212045, "chapter_id": 5518, "verse_number": "२", "content_sanskrit": "शृणु पाण्डव तत्त्वेन सर्वपापप्रणाशनम् ।\nपापिनो येन शुद्ध्यन्ति तत् ते वक्ष्यामि सर्वशः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2212046, "chapter_id": 5518, "verse_number": "३", "content_sanskrit": "ब्राह्मणः क्षत्रियो वाऽपि वैश्यो वा चरितव्रतः ।\nयथावत् कर्तुकामो यः तस्येयं प्रथमा क्रिया ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2212047, "chapter_id": 5518, "verse_number": "४", "content_sanskrit": "शोधयेत्तु शरीरं स्वं पञ्चगव्येन यन्त्रितम् ।\nसशिरः कृष्णपक्षे तु ततः कुर्वीत वापनम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2212048, "chapter_id": 5518, "verse_number": "५", "content_sanskrit": "शुद्धवासाः शुचिर्भूत्वा मौञ्जीं बध्नीत मेखलाम् ।\nपालाशदण्डमादाय ब्रह्मचारिव्रते स्थितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2212049, "chapter_id": 5518, "verse_number": "६", "content_sanskrit": "कृतोपवासः पूर्वं तु शुक्लप्रतिपदि द्विजः ।\nनदीसङ्गमतीर्थेषु शुचौ देशे गृहेऽपि वा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2212050, "chapter_id": 5518, "verse_number": "७", "content_sanskrit": "गोमयेनोपलिप्तेऽथ स्थण्डिलेऽग्निं निधापयेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2212051, "chapter_id": 5518, "verse_number": "८", "content_sanskrit": "आघारावाज्यभागौ च प्रणवं व्याहृतिं तथा ।\nवारुणं चापि पञ्चैव हुत्वा सर्वान् यथाक्रमम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2212052, "chapter_id": 5518, "verse_number": "९", "content_sanskrit": "सत्याय विष्णवे चापि ब्रह्मर्षिभ्योऽथ ब्रह्मणे ।\nविश्वेभ्यश्चैव देवेभ्यः सप्रजापतये तथा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2212053, "chapter_id": 5518, "verse_number": "१०", "content_sanskrit": "षट्कृत्वो जुहुयात् पश्चात् प्रायश्चित्ताहुतीर्द्विजः ।\nततः समापयेदग्निं शान्तिं कृत्वाऽथ पौष्टिकम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2212054, "chapter_id": 5518, "verse_number": "११", "content_sanskrit": "प्रणम्य चाग्निं सोमं च भस्म धृत्वा तथात्मनि ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2212055, "chapter_id": 5518, "verse_number": "१२", "content_sanskrit": "नदीं गत्वा विमुक्ताय सोमाय वरुणाय च ।\nआदित्याय नमस्कृत्वा ततः स्नायात् समाहितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2212056, "chapter_id": 5518, "verse_number": "१३", "content_sanskrit": "उत्तीर्योदकमाचम्य त्वासीनः पूर्वतोमुखः ।\nप्राणायामं ततः कृत्वा पवित्रैरभिषेचनम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2212057, "chapter_id": 5518, "verse_number": "१४", "content_sanskrit": "आचान्तस्त्वभिवीक्षेत चोर्ध्वबाहुर्दिवाकरम् ।\nकृताञ्जलिपुटः पश्चात् कुर्याच्चैव प्रदक्षिणम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2212058, "chapter_id": 5518, "verse_number": "१५", "content_sanskrit": "नारायणं वा रुद्रं वा ब्रह्माणमथवाऽपि वा ।\nआरण्यं मम सूक्तं वा प्राग्भोजनमथापि वा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2212059, "chapter_id": 5518, "verse_number": "१६", "content_sanskrit": "वीरघ्नमृषभं वाऽपि तथा चाप्यघमर्षणम् ।\nगायत्रीं मम देवीं वा सावित्रीं वा जपेत् ततः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2212060, "chapter_id": 5518, "verse_number": "१७", "content_sanskrit": "शतं वाऽष्टशतं वाऽपि सहस्रमथवा परम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2212061, "chapter_id": 5518, "verse_number": "१८", "content_sanskrit": "ततो मध्याह्नकाले वै पायसं पावकं हि वा ।\nवाचयित्वा प्रयत्नेन प्रयतः सुसमाहितः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2212062, "chapter_id": 5518, "verse_number": "१९", "content_sanskrit": "पात्रं ततः समादाय सौवर्णं राजतं तु वा ।\nताम्रं वा मृन्मयं वाऽपि औदुम्बरमथापि वा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2212063, "chapter_id": 5518, "verse_number": "२०", "content_sanskrit": "वृक्षाणां याज्ञियानां तु पर्णैरार्द्रैरकुत्सितैः ।\nपुटकेन तु गुप्तेन चरेद् भैक्षं समाहितः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2212064, "chapter_id": 5518, "verse_number": "२१", "content_sanskrit": "ब्राह्मणानां गृहाणां तु सप्तानां नापरं व्रजेत् ।\nगोदोहमात्रं तिष्ठेत् तु वाग्यतः संयतेन्द्रियः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2212065, "chapter_id": 5518, "verse_number": "२२", "content_sanskrit": "न हसेच्च न वीक्षेच्च नाभिभाषेत वा स्त्रिया ।\nदृष्ट्वा मूत्रपुरीषं वा चण्डालं वा रजस्वलाम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2212066, "chapter_id": 5518, "verse_number": "२३", "content_sanskrit": "पतितं च यथा श्वानमादित्यमवलोकयेत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2212067, "chapter_id": 5518, "verse_number": "२४", "content_sanskrit": "यो हि पादुकामारुह्य सर्वदा प्रचरेद् द्विजः ।\nतं दृष्ट्वा पापकर्माणमादित्यमवलोकयेत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2212068, "chapter_id": 5518, "verse_number": "२५", "content_sanskrit": "ततस्त्वावसथं प्राप्तो भिक्षां निक्षिप्य भूतळे ।\nप्रक्षाल्य पादावाजानु हस्तावाकूर्परं पुनः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2212069, "chapter_id": 5518, "verse_number": "२६", "content_sanskrit": "आचम्य वारिणा तेन वह्निं विप्रांश्च पूजयेत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2212070, "chapter_id": 5518, "verse_number": "२७", "content_sanskrit": "पञ्च सप्ताथवा कुर्याद् भागान् भैक्षस्य तस्य वै ।\nतेषामन्यतमं पिण्डमादित्याय निवेदयेत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2212071, "chapter_id": 5518, "verse_number": "२८", "content_sanskrit": "ब्रह्मणे चाग्नये चैव सोमाय वरुणाय च ।\nविश्वेभ्यश्चैव देवेभ्यो दद्यादन्नं यथाक्रमम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2212072, "chapter_id": 5518, "verse_number": "२९", "content_sanskrit": "अवशिष्टमथैकं तु वक्त्रमात्रं प्रकल्पयेत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2212073, "chapter_id": 5518, "verse_number": "३०", "content_sanskrit": "अङ्गुल्यग्रे स्थितं पिण्डं गायत्र्या चाभिमन्त्रयेत् ।\nअङ्गुलीभिस्त्रिभिः पिण्डं प्राश्नीयात् प्राङ्मुखः शुचिः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2212074, "chapter_id": 5518, "verse_number": "३१", "content_sanskrit": "यथा च वर्धते सोमो ह्रसते च यथा पुनः ।\nतथा पिण्डाश्च वर्धन्ते ह्रसन्ते च दिने दिने ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2212075, "chapter_id": 5518, "verse_number": "३२", "content_sanskrit": "त्रिकालं स्नानमस्योक्तं द्विकालमथवा सकृत् ।\nब्रह्मचारी सदा वाऽपि न च वस्त्रं प्रपीडयेत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2212076, "chapter_id": 5518, "verse_number": "३३", "content_sanskrit": "स्थाने न दिवसं तिष्ठेद् रात्रौ वीरासनं व्रजेत् ।\nभवेत् स्थण्डिलशायी वाऽप्यथवा वृक्षमूलकः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2212077, "chapter_id": 5518, "verse_number": "३४", "content_sanskrit": "वल्कलं यदि वा क्षौमं शाणं कार्पासकं तथा ।\nआच्छादनं भवेत् तस्य वस्त्रार्थं पाण्डुनन्दन ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2212078, "chapter_id": 5518, "verse_number": "३५", "content_sanskrit": "एवं चान्द्रायणे पूर्णे मासस्यान्ते प्रयत्नवान् ।\nब्राह्मणान् भोजयेद् भक्त्या दद्याच्चैव तु दक्षिणाम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2212079, "chapter_id": 5518, "verse_number": "३६", "content_sanskrit": "चान्द्रायणेन चीर्णेन यत् कृतं तेन दुष्कृतम् ।\nतत्सर्वं तत्क्षणादेव भस्मीभवति काष्ठवत् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2212080, "chapter_id": 5518, "verse_number": "३७", "content_sanskrit": "ब्रह्महत्या च गोहत्या सुवर्णस्तैन्यमेव च ।\nभ्रूणहत्या सुरापानं गुरोर्दारव्यतिक्रमः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2212081, "chapter_id": 5518, "verse_number": "३८", "content_sanskrit": "एवमन्यानि पापानि पातकीयानि यानि च ।\nचान्द्रायणेन नश्यन्ति वायुना पांसवो यथा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2212082, "chapter_id": 5518, "verse_number": "३९", "content_sanskrit": "अनिर्दशाया गोः क्षीरमौष्ट्रमाविकमेव च ।\nमृतसूतकयोश्चान्नं भुक्त्वा चान्द्रायणं चरेत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2212083, "chapter_id": 5518, "verse_number": "४०", "content_sanskrit": "उपपातकिनश्चान्नं पतितान्नं तथैव च ।\nशूद्रस्योच्छेषणं चैव भुक्त्वा चान्द्रायणं चरेत् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2212084, "chapter_id": 5518, "verse_number": "४१", "content_sanskrit": "आकाशस्थं तु हस्तस्थमधः स्रस्तं तथैव च ।\nपरहस्तस्थितं चैव भुक्त्वा चान्द्रायणं चरेत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2212085, "chapter_id": 5518, "verse_number": "४२", "content_sanskrit": "अथाग्रे दिधिषोरन्नं दिधिषूपपतेस्तथा ।\nपरिवेत्तुस्तथा चान्नं परिवित्तान्नमेव च ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2212086, "chapter_id": 5518, "verse_number": "४३", "content_sanskrit": "कुण्डान्नं गोलकान्नं च देवलान्नं तथैव च ।\nतथा पुरोहितस्यान्नं भुक्त्वा चान्द्रायणं चरेत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2212087, "chapter_id": 5518, "verse_number": "४४", "content_sanskrit": "सुरासवं विषं सर्पिर्लाक्षा लवणमेव च ।\nतैलं चापि च विक्रीणन् द्विजश्चान्द्रायणं चरेत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2212088, "chapter_id": 5518, "verse_number": "४५", "content_sanskrit": "एकोद्दिष्टं तु यो भुङ्क्ते जनमध्यगतोऽपि यः ।\nभिन्नभाण्डेषु यो भुङ्क्ते द्विजश्चान्द्रायणं चरेत् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2212089, "chapter_id": 5518, "verse_number": "४६", "content_sanskrit": "यो भुङ्क्तेऽनुपनीतेन यो भुङ्क्ते च स्त्रिया सह ।\nयो भुङ्क्ते कन्यया सार्धं द्विजश्चान्द्रायणं चरेत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2212090, "chapter_id": 5518, "verse_number": "४७", "content_sanskrit": "उच्छिष्टं स्थापयेद् विप्रो यो मोहाद् भोजनान्तरे ।\nदद्याद् वा यदि सम्मोहाद् द्विजश्चान्द्रायणं चरेत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2212091, "chapter_id": 5518, "verse_number": "४८", "content_sanskrit": "तुम्बीं कोशतकीं चैव पलाण्डुं गृञ्जनं तथा ।\nछत्राकं लशुनं चैव भुक्त्वा चान्द्रायणं चरेत् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2212092, "chapter_id": 5518, "verse_number": "४९", "content_sanskrit": "द्विजः पर्युषितं चान्नं पक्वं परगृहागतम् ।\nविपक्वं च तथा मांसं भुक्त्वा चान्द्रायणं चरेत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2212093, "chapter_id": 5518, "verse_number": "५०", "content_sanskrit": "उदक्यया शुना वाऽपि चण्डालैर्वा द्विजोत्तमः ।\nदृष्टमन्नं तु भुञ्जानो द्विजश्चान्द्रायणं चरेत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2212094, "chapter_id": 5518, "verse_number": "५१", "content_sanskrit": "एतत्पुरा विशुद्ध्यर्थमृषिभिश्चरितव्रतम् ।\nपावनं सर्वभूतानां पुण्यं पाण्डव चोदितम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2212095, "chapter_id": 5518, "verse_number": "५२", "content_sanskrit": "एतेन वसवो रुद्राश्चादित्याश्च दिवं गताः ।\nएतदद्य परं गुह्यं पवित्रं पापनाशनम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2212096, "chapter_id": 5518, "verse_number": "५३", "content_sanskrit": "यथोक्तमेतद् यः कुर्याद् द्विजः पापप्रणाशनम् ।\nस दिवं याति पूतात्मा निर्मलादित्यसन्निभः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2212097, "chapter_id": 5518, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि वैष्णवधर्मशास्त्रे चान्द्रायणविधिर्नाम द्वादशोत्तरशततमोऽध्यायः ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]