[{"id": 2031964, "chapter_id": 1695, "verse_number": "४-१८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2031965, "chapter_id": 1695, "verse_number": "४-१८-१", "content_sanskrit": "प्रत्याख्यातश्च पाञ्चाल्या कीचकः काममोहितः।\nप्रविश्य राजभवनं भगिन्या अग्रतः स्थितः ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2031966, "chapter_id": 1695, "verse_number": "४-१८-२", "content_sanskrit": "सोभिवीक्ष्य सुकेशान्तां सुदेष्णां भगिनीं प्रियाम् ।\nअमर्यादेन कामेन घोरेणाभिपरिप्लुतः ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2031967, "chapter_id": 1695, "verse_number": "४-१८-३", "content_sanskrit": "स तु मूर्ध्र्यञ्जलिं कृत्वा भगिन्याश्चरणावुभौ ।\nसंमोहाभिहतस्तूर्णं वातोद्धृत इवार्णवः ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2031968, "chapter_id": 1695, "verse_number": "४-१८-४", "content_sanskrit": "स प्रोवाच सुदुःखार्तो भगिनीं निश्वसन्मुहुः ।\nअव्यक्तमृदुना साम्ना शुष्यता च पुनःपुनः ॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2031969, "chapter_id": 1695, "verse_number": "४-१८-५", "content_sanskrit": "यथा सुदेष्णे सैरन्ध्र्या संगच्छेयं सकामया ।\nतथा शीघ्रं कुरुष्वाद्य माऽहं प्राणान्प्रहासिषम् ॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2031970, "chapter_id": 1695, "verse_number": "४-१८-६", "content_sanskrit": "यदीयमनवद्याङ्गी न मामद्यापि काङ्क्षते ।\nचेतसाऽभिप्रसन्नेन गतोस्मि यमसादनम् ॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2031971, "chapter_id": 1695, "verse_number": "४-१८-७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2031972, "chapter_id": 1695, "verse_number": "४-१८-७", "content_sanskrit": "तमुवाच परिष्वज्य सुदेष्णा भ्रातरं प्रियम्।\nभ्रातुर्जीवितरक्षार्थं समाश्वास्यासितेक्षणा ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2031973, "chapter_id": 1695, "verse_number": "४-१८-८", "content_sanskrit": "शरणागतेयं सुश्रोणी मया दत्ताभया च सा।\nशुभाचारा च भद्रं ते नैनां वक्तुमिहोत्सहे ॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2031974, "chapter_id": 1695, "verse_number": "४-१८-९", "content_sanskrit": "एषा हि शक्या नान्येन स्प्रष्टुं पापेन चेतसा।\nगन्धर्वाः किल पञ्चेमां रक्षन्ति रमयन्ति च ॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2031975, "chapter_id": 1695, "verse_number": "४-१८-१०", "content_sanskrit": "एवमेषा ममाचष्टे तथा प्रथमसंगमे।\nतथैव गजनासोरूः सत्यमाह ममान्तिके।\nते हि क्रुद्धा महात्मानो नाशयेयुर्हि जीवितम् ॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2031976, "chapter_id": 1695, "verse_number": "४-१८-११", "content_sanskrit": "राजा चैव समीक्ष्यैनां संमोहं गतवानिह ।\nमया च सत्यवचनैरनुनीतो महीपतिः ॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2031977, "chapter_id": 1695, "verse_number": "४-१८-१२", "content_sanskrit": "सोप्येनामनिशं दृष्ट्वा मनसैवाभ्यनन्दत।\nभयाद्गन्धर्वमुख्यानां जीवितस्योपघातिनाम्।\nमनसाऽपि ततस्त्वेनां न चिन्तयति पार्थिवः ॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2031978, "chapter_id": 1695, "verse_number": "४-१८-१३", "content_sanskrit": "ते हि क्रुद्धा महात्मानो गरुडानिलतेजसः।\nदहेयुरपि लोकांस्त्रीन्युगान्तेष्विव भास्करः ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2031979, "chapter_id": 1695, "verse_number": "४-१८-१४", "content_sanskrit": "सैनन्ध्र्या ह्येतदाख्यातं मम तेषां महद्बलम्।\nतव चाहमिदं गुह्यं स्नेहाद्वक्ष्यामि बन्धुवत् ॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2031980, "chapter_id": 1695, "verse_number": "४-१८-१५", "content_sanskrit": "मा गमिष्यसि वै कृच्छ्रां गतिं परमदुर्गमाम्।\nबलिनस्ते रुजं कुर्युः कुलस्य च धनस्य च ॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2031981, "chapter_id": 1695, "verse_number": "४-१८-१६", "content_sanskrit": "तस्मान्नास्यां मनः कर्तुं यदि प्राणा प्रियास्तव।\nन चिन्तयेथा मागास्त्वं मत्प्रियं च यदीच्छसि ॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2031982, "chapter_id": 1695, "verse_number": "४-१८-१७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2031983, "chapter_id": 1695, "verse_number": "४-१८-१७", "content_sanskrit": "एवमुक्तस्तु दुष्टात्मा भगिनीं कीचकोऽब्रवीत्।\nगन्धर्वाणां शतं वाऽपि सहस्रमयुतानि वा ।\nअहमेको वधिष्यामि गन्धर्वान्पञ्च किं पुनः ॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2031984, "chapter_id": 1695, "verse_number": "४-१८-१८", "content_sanskrit": "न च त्वमभिजानीषे स्त्रीणां गुह्यमनुत्तमम् ।\nपुत्रं वा किल पौत्रं वा भ्रातरं वा मनस्विनम् ॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2031985, "chapter_id": 1695, "verse_number": "४-१८-१९", "content_sanskrit": "रहसीह नरं दृष्ट्वा नानागन्धविभूषितम्।\nयोनिरुत्स्विद्यते स्त्रीणां सतीनामपि च श्रुतम् ॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2031986, "chapter_id": 1695, "verse_number": "४-१८-२०", "content_sanskrit": "मां निरीक्ष्यानुलिप्ताङ्गं सर्वाभरणभूषितम्।\nवशमेष्यति सैरन्ध्री मन्मथेनाभिपीडिता।\nसा त्वं दृष्ट्वा ब्रूहि चैनां मम चेञ्जीवितं प्रियं ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2031987, "chapter_id": 1695, "verse_number": "४-१८-२१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2031988, "chapter_id": 1695, "verse_number": "४-१८-२१", "content_sanskrit": "एवमुक्ता सुदेष्णा तु शोकेनाभिप्रपीडिता।\nअहो दुःखमहो कृच्छ्रमहो पापमिति स्मह ॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2031989, "chapter_id": 1695, "verse_number": "४-१८-२२", "content_sanskrit": "प्रारुदद्भृशदुःखार्ता विपाकं तस्य वीक्ष्य सा।\nपातालेषु पतत्येष विलपन्बडवामुखे ॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2031990, "chapter_id": 1695, "verse_number": "४-१८-२३", "content_sanskrit": "त्वत्कृते विनशिष्यन्ति भ्रातरः सुहृदश्च मे।\nकिंनु शक्यं मया कर्तुं यत्त्वमेवमभिप्लुतः ॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2031991, "chapter_id": 1695, "verse_number": "४-१८-२४", "content_sanskrit": "न च श्रेयोऽभिजानीषे काममेवानुवर्तसे।\nध्रुवं गतायुस्त्वं पाप यदेवं काममोहितः ।\nअकर्तव्ये हि मां पापे नियुनङ्क्षि नराधम ॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2031992, "chapter_id": 1695, "verse_number": "४-१८-२५", "content_sanskrit": "अपि चैतत्पुरा प्रोक्तं निपुणैर्मनुजोत्तमैः ।\nएकस्तु कुरुते पापं स्वजातिस्तेन हन्यते ॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2031993, "chapter_id": 1695, "verse_number": "४-१८-२६", "content_sanskrit": "गतस्त्वं धर्मराजस्य विषयं नात्र संशयः।\nअदूषितमिदं सर्वं स्वजनं घातयिष्यसि ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2031994, "chapter_id": 1695, "verse_number": "४-१८-२७", "content_sanskrit": "एतत्तु मे दुःखतरं येनाहं भ्रातृसौहृदात्।\nविदितार्था करिष्यामि तुष्टो भव कुलक्षये ॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2031995, "chapter_id": 1695, "verse_number": "४-१८-२८", "content_sanskrit": "गच्छ शीघ्रमितस्त्वं हि स्वमेव भवनं शुभम्।\nकिंचित्कार्यं समुद्दिश्य सुरामन्नं च कारय ॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2031996, "chapter_id": 1695, "verse_number": "४-१८-२९", "content_sanskrit": "कृते चान्ने सुरायां च प्रेषयिष्यसि मे पुनः ।\nतामहं प्रेषयिष्यामि मध्वन्नार्थं तवान्तिकम् ॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2031997, "chapter_id": 1695, "verse_number": "४-१८-३०", "content_sanskrit": "ततः संप्रेषितामेनां विजने निरवग्रहाम्।\nसान्त्वयेथा यथान्यायं यदि साम सहिष्यति ॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2031998, "chapter_id": 1695, "verse_number": "४-१८-३१", "content_sanskrit": "सद्यः कृतमिदं सर्वं शेषमत्रानुचिन्तय ॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2031999, "chapter_id": 1695, "verse_number": "४-१८-३२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2032000, "chapter_id": 1695, "verse_number": "४-१८-३२", "content_sanskrit": "सुदेष्णयैवमुक्तस्तु कीचकः कालचोदितः।\nत्वरमाणः प्रचक्राम स्वगृहं राजवेश्मनः ॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2032001, "chapter_id": 1695, "verse_number": "४-१८-३३", "content_sanskrit": "आगम्य च गृहं रम्यं सुरामन्नं चकार ह।\nअजैडकं च सुकृतं बहु चोच्चावचान्मृगान् ॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2032002, "chapter_id": 1695, "verse_number": "४-१८-३४", "content_sanskrit": "भक्षांश्च विविधाकारान्बहूंश्चोच्चावचांस्तदा।\nकारयामास कुशलैरन्नपानैः सुसंस्कृतम् ॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2032003, "chapter_id": 1695, "verse_number": "४-१८-३५", "content_sanskrit": "त्वरावान्कालपाशेन कण्ठे बद्धः पशुर्यथा ।\nनावबुध्यत मूढात्मा मरणं समुपस्थितम् ॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2032004, "chapter_id": 1695, "verse_number": "४-१८-३६", "content_sanskrit": "आनीतायां सुरायां तु कृते चान्ने सुसंस्कृते।\nकीचकः पुनरागम्य सुदेष्णां वाक्यमब्रवीत् ॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2032005, "chapter_id": 1695, "verse_number": "४-१८-३७", "content_sanskrit": "मधु मांसं च बहुधा भक्ष्याश्च बहुधा कृताः।\nसुदेष्णे ब्रूहि सैरन्ध्रीं यथा सा मे गृहं व्रजेत् ॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2032006, "chapter_id": 1695, "verse_number": "४-१८-३८", "content_sanskrit": "केनचित्त्वद्य कार्येण त्वर शीघ्रं मम प्रियम्।\nअहं हि शरणं देवं प्रतिपद्ये वृषध्वजम्।\nसमागमं मे सैरन्ध्र्या मरणं वा दिशेति वै ॥ ३८ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2032007, "chapter_id": 1695, "verse_number": "४-१८-३९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2032008, "chapter_id": 1695, "verse_number": "४-१८-३९", "content_sanskrit": "सा तमाह विनिःश्वस्य प्रतिगच्छ स्वकं गृहम्।\nएषाऽहमपि सैरन्ध्रीं सुरार्थे तूर्णमादिशे ॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2032009, "chapter_id": 1695, "verse_number": "४-१८-४०", "content_sanskrit": "एवमुक्तस्तु पापात्मा कीचकस्त्वरितः पुनः ।\nस्वगृहं प्राविशत्तूर्णं सैरन्ध्रीगतमानसः ॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2032010, "chapter_id": 1695, "verse_number": "४-१८-४१", "content_sanskrit": "कीचकं तु गतं ज्ञात्वा त्वरमाणं स्वकं गृहम्।\nसैरन्ध्रीं तत आहूय सदेष्णा वाक्यमब्रवीत् ॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2032011, "chapter_id": 1695, "verse_number": "४-१८-४२", "content_sanskrit": "गच्छ सैरन्ध्रि मत्प्रीत्यै कीचकस्य निवेशनम् ।\nसुरामानय सुश्रोणि तृषिताऽहं विलासिनि ॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2032012, "chapter_id": 1695, "verse_number": "४-१८-४३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2032013, "chapter_id": 1695, "verse_number": "४-१८-४३", "content_sanskrit": "सुदेष्णयैवमुक्ता सा निःश्वसन्ती नृपात्मजा।\nअब्रवीच्छोकसन्तप्ता नाहं तत्र व्रजामि वैः ॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2032014, "chapter_id": 1695, "verse_number": "४-१८-४४", "content_sanskrit": "सूतपुत्रो हि मां भद्रे कामात्मा चाभिमन्यते ।\nन गच्छेयमहं तस्य राजपुत्रि निवेशनम् ।\nत्वमेव भद्रे जानासि यथा स निरपत्रपः ॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2032015, "chapter_id": 1695, "verse_number": "४-१८-४५", "content_sanskrit": "समयश्च कृतो भद्रे यथा प्रथमसंगमे।\nतथा निवसमानायां यथाऽहं नान्यचारिणी ॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2032016, "chapter_id": 1695, "verse_number": "४-१८-४६", "content_sanskrit": "कीचकश्च सुकेशान्ते मूढो मदनगर्वितः ।\nस मामिह गतां दृष्ट्वा व्यवस्यति निराकृतिम्।\nकथं नु वै तत्र गतां मर्षयेन्मामबान्धवाम् ॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2032017, "chapter_id": 1695, "verse_number": "४-१८-४७", "content_sanskrit": "बह्व्यः सन्ति तव प्रेष्या राजपुत्रि वशानुगाः।\nअन्यां प्रेषय कैकेयि संरक्ष्याऽहमिह त्वया ॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2032018, "chapter_id": 1695, "verse_number": "४-१८-४८", "content_sanskrit": "कीचकस्यालयं देवि न यामि भयकम्पिता।\nयद्यदन्यच्च मे कर्म करोमि च सुदुष्करम् ॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2032019, "chapter_id": 1695, "verse_number": "४-१८-४९", "content_sanskrit": "एवमुक्ता तु पाञ्चाल्या दैवयोगेन कैकयी ।\nतां विराटस्य माहिषी क्रुद्धा भूयोऽन्वशासत ॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2032020, "chapter_id": 1695, "verse_number": "४-१८-५०", "content_sanskrit": "कीचकं चैव गच्छ त्वं बलात्कारे चोदिता।\nनास्ति मेऽन्या त्वया तुल्या सा त्वं शीघ्रतरं व्रज ॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2032021, "chapter_id": 1695, "verse_number": "४-१८-५१", "content_sanskrit": "अवश्यं त्वेव गन्तव्यं किमर्थं मां विवक्षसि।\nशीघ्रं गच्छ त्वरस्वेति मत्प्रीतिवशमाचर ॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2032022, "chapter_id": 1695, "verse_number": "४-१८-५२", "content_sanskrit": "न हीदृशो मम भ्राता किं त्वं समभिशङ्कसे।\nउक्त्वा चैनां बलाच्चैव विनियुज्य प्रभुत्वतः ॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2032023, "chapter_id": 1695, "verse_number": "४-१८-५३", "content_sanskrit": "भाजनं प्रददौ चास्यै सपिधानं हिरण्मयम्।\nया सुजाता सुगन्धा च तामानय सुरामिति ॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2032024, "chapter_id": 1695, "verse_number": "४-१८-५४", "content_sanskrit": "सा शङ्कमाना रुदती वेपन्ती द्रुपदात्मजा।\nदैवतेभ्यो नमस्कृत्वा श्वशुरेभ्यस्तथाऽब्रवीत् ॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2032025, "chapter_id": 1695, "verse_number": "४-१८-५५", "content_sanskrit": "यथाऽहमन्यं पार्थेभ्यो नाभिजानापि मानवम्।\nतेन सत्येन मां दृष्ट्वा कीचको मा वशं नयेत् ॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2032026, "chapter_id": 1695, "verse_number": "४-१८-५६", "content_sanskrit": "यथाऽहं पाण्डुपुत्रेभ्यः पञ्चभ्यो नान्यगामिनी।\nतेन सत्येन मां दृष्ट्वा कीचको मा वशं नयेत् ॥ ५६ ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2032027, "chapter_id": 1695, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि कीचकवधपर्वणि अष्टादशोऽध्यायः ॥ १८ ॥ ---------", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]