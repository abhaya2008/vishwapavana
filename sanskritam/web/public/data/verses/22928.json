[{"id": 7002928000, "chapter_id": 22928, "verse_number": "१-५-१", "content_sanskrit": "॥शौनक उवाच॥।\nगोगोपगोप्यो गोलोके किं नित्याः किंनु कल्पिताः ।\nमम संदेहभेदार्थं तन्मे व्याख्यातुमर्हसि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002928001, "chapter_id": 22928, "verse_number": "१-५-२", "content_sanskrit": "॥सौतिरुवाच॥।\nसर्वादिसृष्टौ ताः क्लृप्ताः प्रलये प्रलये स्थिताः ।\nसर्वादिसृष्टिकथनं यन्मया कथितं द्विज ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002928002, "chapter_id": 22928, "verse_number": "१-५-३", "content_sanskrit": "सर्वादिसृष्टौ क्लृप्तौ च नारायणमहेश्वरौ ।\nप्रलये प्रलये व्यक्तौ स्थितौ तौ प्रकृतिश्च सा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002928003, "chapter_id": 22928, "verse_number": "१-५-४", "content_sanskrit": "सर्वादौ ब्रह्मकल्पस्य चरितं कथितं द्विज ।\nवाराहपाद्मकल्पौ द्वौ कथयिष्यामि श्रोष्यसि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002928004, "chapter_id": 22928, "verse_number": "१-५-५", "content_sanskrit": "ब्राह्मवाराहपाद्माश्च कल्पाश्च त्रिविधा मुने ।\nयथायुगानि चत्वारि क्रमेण कथितानि च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002928005, "chapter_id": 22928, "verse_number": "१-५-६", "content_sanskrit": "सत्यं त्रेता द्वापरं च कलिश्चेति चतुर्युगम् ।\nत्रिशतैश्च षष्ट्यधिकैर्युगैर्दिव्यं युगं स्मृतम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002928006, "chapter_id": 22928, "verse_number": "१-५-७", "content_sanskrit": "मन्वन्तरं तु दिव्यानां युगानामेकसप्ततिः ।\nचतुर्दशेषु मनुषु गतेषु ब्रह्मणो दिनम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002928007, "chapter_id": 22928, "verse_number": "१-५-८", "content_sanskrit": "त्रिशतैश्च षष्ट्यधिकैर्दिनैर्वर्षं च ब्रह्मणः ।\nअष्टोत्तरं वर्षशतं विधेरायुर्निरूपितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002928008, "chapter_id": 22928, "verse_number": "१-५-९", "content_sanskrit": "एतन्निमेषकालस्तु कृष्णस्य परमात्मनः ।\nब्रह्मणश्चायुषा कल्पः कालविद्भिर्निरूपितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002928009, "chapter_id": 22928, "verse_number": "१-५-१०", "content_sanskrit": "क्षुद्रकल्पा बहुतरास्ते संवर्तादयः स्मृताः ।\nसप्तकल्पांतजीवी स मार्कण्डेयश्च तन्मतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002928010, "chapter_id": 22928, "verse_number": "१-५-११", "content_sanskrit": "ब्रह्मणश्च दिनेनैव स कल्पः परिकीर्तितः ।\nविधेश्च सप्तदिवसे मुनेरायुर्निरूपितम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002928011, "chapter_id": 22928, "verse_number": "१-५-१२", "content_sanskrit": "ब्राह्मवाराहपाद्माश्च त्रयः कल्पा निरूपिताः ।\nकल्पत्रये यथा सृष्टिः कथयामि निशामय ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002928012, "chapter_id": 22928, "verse_number": "१-५-१३", "content_sanskrit": "ब्राह्मे च मेदिनीं सृष्ट्वा स्रष्टा सृष्टिं चकार सः ।\nमधुकैटभयोश्चैव मेदसा चाज्ञया प्रभोः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002928013, "chapter_id": 22928, "verse_number": "१-५-१४", "content_sanskrit": "वाराहे तां समुद्धृत्य लुप्तां मग्नां रसातलात् ।\nविष्णोर्वराहरूपस्य द्वारा चातिप्रयत्नतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002928014, "chapter_id": 22928, "verse_number": "१-५-१५", "content_sanskrit": "पाद्मे विष्णोर्नाभिपद्मे स्रष्टा सृष्टिं विनिर्ममे ।\nत्रिलोकीं ब्रह्मलोकान्तां नित्यलोकत्रयं विना ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002928015, "chapter_id": 22928, "verse_number": "१-५-१६", "content_sanskrit": "एतत्तु कालसंख्यानमुक्तं सृष्टिनिरूपणे ।\nकिंचिन्निरूपणं सृष्टे किं भूयः श्रोतुमिच्छसि ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002928016, "chapter_id": 22928, "verse_number": "१-५-१७", "content_sanskrit": "॥शौनक उवाच॥।\nअतः परं किं चकार भगवान्सात्वतांपतिः ।\nएतान्सृष्ट्वा किं चकार तन्मे व्याख्यातुमर्हसि ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002928017, "chapter_id": 22928, "verse_number": "१-५-१८", "content_sanskrit": "॥सौतिरुवाच॥।\nअतः परं तु गोलोके गोलोकेशो महान्प्रभुः ।\nएतान्सृष्ट्वा जगामासौ सुरम्यं रासमण्डलम् ।\nएतैः समेतैर्भगवानतीव कमनीयकम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002928018, "chapter_id": 22928, "verse_number": "१-५-१९", "content_sanskrit": "रम्याणां कल्पवृक्षाणां मध्येऽतीव मनोहरम् ।\nसुविस्तीर्णं च सुसमं सुस्निग्धं मण्डलीकृतम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002928019, "chapter_id": 22928, "verse_number": "१-५-२०", "content_sanskrit": "चन्दनागुरुकस्तूरीकुङ्कुमैश्च सुसंस्कृतम् ।\nदधिलाजसक्तुधान्यदूर्वापर्णपरिप्लुतम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002928020, "chapter_id": 22928, "verse_number": "१-५-२१", "content_sanskrit": "पट्टसूत्रग्रन्थियुक्तं नवचन्दनपल्लवैः ।\nसंयुक्तरम्भास्तम्भानां समूहैः परिवेष्टितम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002928021, "chapter_id": 22928, "verse_number": "१-५-२२", "content_sanskrit": "सद्रत्नसारनिर्माणमण्डपानां त्रिकोटिभिः ।\nरत्नप्रदीपज्वलितैः पुष्पधूपादिवासितैः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002928022, "chapter_id": 22928, "verse_number": "१-५-२३", "content_sanskrit": "शृंगारार्हभोगवस्तुसमूहपरिवेष्टितम् ।\nअतीव ललिताकल्पतल्पयुक्तैः सुशोभितम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002928023, "chapter_id": 22928, "verse_number": "१-५-२४", "content_sanskrit": "तत्र गत्वा च तैः सार्धं समुवास जगत्पतिः ।\nदृष्ट्वा रासं विस्मितास्ते बभूवुर्मुनिसत्तम ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002928024, "chapter_id": 22928, "verse_number": "१-५-२५", "content_sanskrit": "आविर्बभूव कन्यैका कृष्णस्य वामपार्श्वतः ।\nधावित्वा पुष्पमानीय ददावर्घ्यं प्रभोः पदे ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002928025, "chapter_id": 22928, "verse_number": "१-५-२६", "content_sanskrit": "रासे संभूय गोलोके सा दधाव हरेः पुरः ।\nतेन राधा समाख्याता पुराविद्भिर्द्विजोत्तम ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002928026, "chapter_id": 22928, "verse_number": "१-५-२७", "content_sanskrit": "प्राणाधिष्ठातृदेवी सा कृष्णस्य परमात्मनः ।\nआविर्बभूव प्राणेभ्यः प्राणेभ्योऽपि गरीयसी ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002928027, "chapter_id": 22928, "verse_number": "१-५-२८", "content_sanskrit": "देवी षोडशवर्षीया नवयौवनसंयुता ।\nवह्निशुद्धांशुकाधाना सस्मिता सुमनोहरा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002928028, "chapter_id": 22928, "verse_number": "१-५-२९", "content_sanskrit": "सुकोमलांगी ललिता सुन्दरीषु च सुन्दरी ।\nबृहन्नितम्बभारार्त्ता पीनश्रोणिपयोधरा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002928029, "chapter_id": 22928, "verse_number": "१-५-३०", "content_sanskrit": "बन्धुजीवजिता रक्तसुन्दरोष्ठा धरावरा ।\nमुक्तापङ्क्तिजिता चारुदन्तपंक्तिर्मनोहरा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002928030, "chapter_id": 22928, "verse_number": "१-५-३१", "content_sanskrit": "शरत्पार्वणकोटीन्दुशोभामृष्टशुभानना ।\nचारुसीमन्तिनीचारुशरत्पङ्कजलोचना ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002928031, "chapter_id": 22928, "verse_number": "१-५-३२", "content_sanskrit": "खगेन्द्रचञ्चुविजितचारुनासा मनोहरा ।\nस्वर्णगण्डूकविजिते गण्डयुग्मे च बिभ्रती ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002928032, "chapter_id": 22928, "verse_number": "१-५-३३", "content_sanskrit": "दधती चारुकर्णे च रत्नाभरणभूषिते ।\nचन्दनागुरुकस्तूरीयुक्तकुंकुमबिन्दुभिः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002928033, "chapter_id": 22928, "verse_number": "१-५-३४", "content_sanskrit": "सिन्दूरबिन्दुसंयुक्तसुकपोला मनोहरा ।\nसुसंस्कृतं केशपाशं मालतीमाल्यभूषितम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002928034, "chapter_id": 22928, "verse_number": "१-५-३५", "content_sanskrit": "सुगन्धकबरीभारं सुन्दरं दधती सती ।\nस्थलपद्मप्रभामुष्टं पादयुग्मं च बिभ्रती ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002928035, "chapter_id": 22928, "verse_number": "१-५-३६", "content_sanskrit": "गमनं कुर्वती सा च हंसखञ्जनगञ्जनम् ।\nसद्रत्नसारनिर्माणां वनमाली मनोहराम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002928036, "chapter_id": 22928, "verse_number": "१-५-३७", "content_sanskrit": "हारं हीरकनिर्माणं रत्नकेयूरकङ्कणम् ।\nसद्रत्नसारनिर्माणं पाशकं सुमनोहरम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002928037, "chapter_id": 22928, "verse_number": "१-५-३८", "content_sanskrit": "अमूल्यरत्ननिर्माणं क्वणन्मञ्जीररञ्जितम् ।\nनानाप्रकारचित्राढ्यं सुन्दरं परिबिभ्रती ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002928038, "chapter_id": 22928, "verse_number": "१-५-३९", "content_sanskrit": "सा च सम्भाष्य गोविन्दं रत्नसिंहासने वरे ।\nउवास सस्मिता भर्तुः पश्यन्ती मुखपङ्कजम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002928039, "chapter_id": 22928, "verse_number": "१-५-४०", "content_sanskrit": "तस्याश्च लोमकूपेभ्यः सद्य ।\nगोपाङ्गनागणः॥आविर्बभूव रूपेण वेशेनैव च तत्समः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002928040, "chapter_id": 22928, "verse_number": "१-५-४१", "content_sanskrit": "लक्षकोटीपरिमितः शश्वत्सुस्थिरयौवनः ।\nसंख्याविद्भिश्च संख्यातो गोलोके गोपिकागणः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002928041, "chapter_id": 22928, "verse_number": "१-५-४२", "content_sanskrit": "कृष्णस्य लोमकूपेभ्यः सद्यो गोपगणो मुने ।\nआविर्बभूव रूपेण वेषेणैव च तत्समः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002928042, "chapter_id": 22928, "verse_number": "१-५-४३", "content_sanskrit": "त्रिंशत्कोटिपरिमितः कमनीयो मनोहरः ।\nसंख्याविद्भिश्च संख्यातो बल्लवानां गणः श्रुतौ ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002928043, "chapter_id": 22928, "verse_number": "१-५-४४", "content_sanskrit": "कृष्णस्य लोमकूपेभ्यः सद्यश्चाविर्बभूव ह ।\nनानावर्णो गोगणश्च शश्वत्सुस्थिरयौवनः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002928044, "chapter_id": 22928, "verse_number": "१-५-४५", "content_sanskrit": "बलीवर्दाः सुरभ्यश्च वत्सा नानाविधाः शुभाः ।\nअतीव ललिताः श्यामा बह्व्यो वै कामधेनवः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002928045, "chapter_id": 22928, "verse_number": "१-५-४६", "content_sanskrit": "तेषामेकं बलीवर्दं कोटिसिंहसमं बले ।\nशिवाय प्रददौ कृष्णो वाहनाय मनोहरम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002928046, "chapter_id": 22928, "verse_number": "१-५-४७", "content_sanskrit": "कृष्णांघ्रिनखरन्धेभ्यो हंसपङ्क्तिर्मनोहरा ।\nआविर्बभूव सहसा स्त्रीपुंवत्ससमन्विता ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002928047, "chapter_id": 22928, "verse_number": "१-५-४८", "content_sanskrit": "तेषामेकं राजहंसं महाबलपराक्रमम् ।\nवाहनाय ददौ कृष्णो ब्रह्मणे च तपस्विने ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002928048, "chapter_id": 22928, "verse_number": "१-५-४९", "content_sanskrit": "वामकर्णस्य विवरात्कृष्णस्य परमात्मनः ।\nगणः श्वेततुरङ्गाणामाविर्भूतो मनोहरः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002928049, "chapter_id": 22928, "verse_number": "१-५-५०", "content_sanskrit": "तेषामेकं च श्वेताश्वं धर्मार्थं वाहनाय च ।\nददौ गोपाङ्गनेशश्च संप्रीत्या सुरसंसदि ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002928050, "chapter_id": 22928, "verse_number": "१-५-५१", "content_sanskrit": "दक्षकर्णस्य विवरात्पुंसश्च सुरसंसदि ।\nआविर्भूता सिंहपङ्क्तिर्महाबलपराक्रमा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002928051, "chapter_id": 22928, "verse_number": "१-५-५२", "content_sanskrit": "तेषामेकं ददौ कृष्णः प्रकृत्यै परमादरम् ।\nअमूल्यरत्नमाल्यं च वरं यदभिवाञ्छितम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002928052, "chapter_id": 22928, "verse_number": "१-५-५३", "content_sanskrit": "कृष्णो योगेन योगीन्द्रश्चकार रथपञ्चकम् ।\nशुद्धरत्नेन्द्रनिर्माणं मनोयायि मनोहरम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002928053, "chapter_id": 22928, "verse_number": "१-५-५४", "content_sanskrit": "लक्षयोजनमूर्ध्वे च प्रस्थे च शतयोजनम् ।\nलक्षचक्रं वायुरहं लक्षक्रीडागृहान्वितम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002928054, "chapter_id": 22928, "verse_number": "१-५-५५", "content_sanskrit": "शृङ्गारार्हं भोगवस्तुतल्पासंख्यसमन्वितम् ।\nरत्नप्रदीपलक्षाणां वाजिभिश्च विराजितम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002928055, "chapter_id": 22928, "verse_number": "१-५-५६", "content_sanskrit": "नानाचित्रविचित्राढथं सद्रत्नकलशोज्ज्वलम् ।\nरत्नदर्पणभूषाढ्यं शोभितं श्वेतचामरैः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002928056, "chapter_id": 22928, "verse_number": "१-५-५७", "content_sanskrit": "वह्निशुद्धांशुकैश्चित्रैर्मुक्ताजालैर्विभूषितम् ।\nमणीन्द्रमुक्तामाणिक्यहीरहारविराजितम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002928057, "chapter_id": 22928, "verse_number": "१-५-५८", "content_sanskrit": "आरक्तवर्णरत्नेन्द्रसारनिर्माणकृत्रिमैः ।\nपङ्कजानामसंख्यैश्च सुन्दरैश्च सुशोभितम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002928058, "chapter_id": 22928, "verse_number": "१-५-५९", "content_sanskrit": "ददौ नारायणायैकं तेषां मध्ये द्विजोत्तमः ।\nएकं दत्त्वा राधिकायै ररक्षाशेषमात्मने॥ ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002928059, "chapter_id": 22928, "verse_number": "१-५-६०", "content_sanskrit": "आविर्बभूव कृष्णस्य गुह्यदेशात्ततः परम् ।\nपिङ्गलश्च पुमानेकः पिङ्गलैश्च गणैः सह ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002928060, "chapter_id": 22928, "verse_number": "१-५-६१", "content_sanskrit": "आविर्भूता यतो गुह्यात्तेन ते गुह्यकाः स्मृताः ।\nयः पुमान् स कुबेरश्च धनेशो गुह्यकेश्वरः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002928061, "chapter_id": 22928, "verse_number": "१-५-६२", "content_sanskrit": "बभूव कन्यका चैका कुबेरे वामपार्श्वतः ।\nकुबेरपत्नी सा देवी सुन्दरीणां मनोरमा ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002928062, "chapter_id": 22928, "verse_number": "१-५-६३", "content_sanskrit": "भूतप्रेतपिशाचाश्च कूष्माण्डब्रह्मराक्षसाः ।\nवेताला विकृतास्तस्याविर्भूता गुह्यदेशतः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002928063, "chapter_id": 22928, "verse_number": "१-५-६४", "content_sanskrit": "शङ्खचक्रगदापद्मधारिणो वनमालिनः ।\nपीतवस्त्रपरीधानाः सर्वे श्यामचतुर्भुजाः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002928064, "chapter_id": 22928, "verse_number": "१-५-६५", "content_sanskrit": "किरीटिनः कुण्डलिनो रत्नभूषणभूषिताः ।\nआविर्भूताः पार्षदाश्च कृष्णस्य मुखतो मुने ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002928065, "chapter_id": 22928, "verse_number": "१-५-६६", "content_sanskrit": "चतुर्भुजान्पार्षदांश्च ददौ नारायणाय च ।\nगुह्यकान्गुह्यकेशाय भूतादीञ्छङ्कराय च ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002928066, "chapter_id": 22928, "verse_number": "१-५-६७", "content_sanskrit": "द्विभुजाः श्यामवर्णाश्च जपमालाकरा वराः ।\nध्यायन्तश्चरणाम्भोजं कृष्णस्य सततं मुदा ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002928067, "chapter_id": 22928, "verse_number": "१-५-६८", "content_sanskrit": "दास्यो नियुक्ता दसाश्चैवार्घ्यमादाय यत्नतः ।\nआविर्भूता वैष्णवाश्च सर्वे कृष्णपरायणाः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002928068, "chapter_id": 22928, "verse_number": "१-५-६९", "content_sanskrit": "पुलकाङ्कितसर्वाङ्गाः साश्रुनेत्राः सगद्गदा ।\nआविर्भूताः पादपद्मात्पादपद्मैकमानसाः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002928069, "chapter_id": 22928, "verse_number": "१-५-७०", "content_sanskrit": "आविर्बभूवुः कृष्णस्य दक्षनेत्राद्भयङ्कराः ।\nत्रिशूलपट्टिशधरास्त्रिनेत्राश्चन्द्रशेखराः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002928070, "chapter_id": 22928, "verse_number": "१-५-७१", "content_sanskrit": "दिगम्बरा महाकाया ज्वलदग्निशिखोपमाः ।\nते भैरवा महाभागाः शिवतुल्याश्च तेजसा ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002928071, "chapter_id": 22928, "verse_number": "१-५-७२", "content_sanskrit": "रुरुसंहारकालाख्या असितक्रोधभीषणाः ।\nमहाभैरवखट्वाङ्गावित्यष्टौ भैरवाः स्मृताः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002928072, "chapter_id": 22928, "verse_number": "१-५-७३", "content_sanskrit": "आविर्बभूव कृष्णस्य वामनेत्राद्भयङ्करः ।\nत्रिशूलपट्टिशव्याघ्रचर्माम्बरगदाधरः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002928073, "chapter_id": 22928, "verse_number": "१-५-७४", "content_sanskrit": "दिगम्बरो महाकायस्त्रिणेत्रश्चन्द्रशेखरः ।\nस ईशानो महाभागो दिक्पालानामधीश्वरः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002928074, "chapter_id": 22928, "verse_number": "१-५-७५", "content_sanskrit": "डाकिन्यश्चैव योगिन्यः क्षेत्रपालाः सहस्रशः ।\nआविर्बभूवुः कृष्णस्य नासिकाविवरोदरात् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7002928075, "chapter_id": 22928, "verse_number": "१-५-७६", "content_sanskrit": "सुरास्त्रिकोटिसंख्याता दिव्यमूर्तिधरावराः ।\nआविर्बर्भूवुः सहसा पुंसो वै पृष्ठदेशतः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]