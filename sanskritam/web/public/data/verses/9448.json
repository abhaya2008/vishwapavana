[{"id": 5000448000, "chapter_id": 9448, "verse_number": "६-४१-१", "content_sanskrit": "अथ तस्मिन् निमित्तानि दृष्ट्वा लक्ष्मणपूर्वजः।\nसुग्रीवं सम्परिष्वज्य रामो वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000448001, "chapter_id": 9448, "verse_number": "६-४१-२", "content_sanskrit": "असम्मन्त्र्य मया सार्धं तदिदं साहसं कृतम्।\nएवं साहसयुक्तानि न कुर्वन्ति जनेश्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000448002, "chapter_id": 9448, "verse_number": "६-४१-३", "content_sanskrit": "संशये स्थाप्य मां चेदं बलं चेमं विभीषणम्।\nकष्टं कृतमिदं वीर साहसं साहसप्रिय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000448003, "chapter_id": 9448, "verse_number": "६-४१-४", "content_sanskrit": "इदानीं मा कृथा वीर एवंविधमरिंदम।\nत्वयि किंचित्समापन्ने किं कार्यं सीतया मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000448004, "chapter_id": 9448, "verse_number": "६-४१-५", "content_sanskrit": "भरतेन महाबाहो लक्ष्मणेन यवीयसा।\nशत्रुघ्नेन च शत्रुघ्न स्वशरीरेण वा पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000448005, "chapter_id": 9448, "verse_number": "६-४१-६", "content_sanskrit": "त्वयि चानागते पूर्वमिति मे निश्चिता मतिः।\nजानतश्चापि ते वीर्यं महेन्द्रवरुणोपम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000448006, "chapter_id": 9448, "verse_number": "६-४१-७", "content_sanskrit": "हत्वाहं रावणं युद्धे सपुत्रबलवाहनम्।\nअभिषिच्य च लङ्कायां विभीषणमथापि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000448007, "chapter_id": 9448, "verse_number": "६-४१-८", "content_sanskrit": "भरते राज्यमारोप्य त्यक्ष्ये देहं महाबल।\nतमेवं वादिनं रामं सुग्रीवः प्रत्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000448008, "chapter_id": 9448, "verse_number": "६-४१-९", "content_sanskrit": "तव भार्यापहर्तारं दृष्ट्वा राघव रावणम्।\nमर्षयामि कथं वीर जानन् विक्रममात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000448009, "chapter_id": 9448, "verse_number": "६-४१-१०", "content_sanskrit": "इत्येवं वादिनं वीरमभिनन्द्य च राघवः।\nलक्ष्मणं लक्ष्मिसम्पन्नमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000448010, "chapter_id": 9448, "verse_number": "६-४१-११", "content_sanskrit": "परिगृह्योदकं शीतं वनानि फलवन्ति च।\nबलौघं संविभज्येमं व्यूह्य तिष्ठाम लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000448011, "chapter_id": 9448, "verse_number": "६-४१-१२", "content_sanskrit": "लोकक्षयकरं भीमं भयं पश्याम्युपस्थितम्।\nनिबर्हणं प्रवीराणामृक्षवानररक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000448012, "chapter_id": 9448, "verse_number": "६-४१-१३", "content_sanskrit": "वाता हि परुषं वान्ति कम्पते च वसुंधरा।\nपर्वताग्राणि वेपन्ते नदन्ति धरणीधराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000448013, "chapter_id": 9448, "verse_number": "६-४१-१४", "content_sanskrit": "मेघाः क्रव्यादसंकाशाः परुषाः परुषस्वराः।\nक्रूराः क्रूरं प्रवर्षन्ते मिश्रं शोणितबिन्दुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000448014, "chapter_id": 9448, "verse_number": "६-४१-१५", "content_sanskrit": "रक्तचन्दनसंकाशा संध्या परमदारुणा।\nज्वलच्च निपतत्येतदादित्यादग्निमण्डलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000448015, "chapter_id": 9448, "verse_number": "६-४१-१६", "content_sanskrit": "आदित्यमभिवाश्यन्ति जनयन्तो महद्भयम्।\nदीना दीनस्वरा घोरा अप्रशस्ता मृगद्विजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000448016, "chapter_id": 9448, "verse_number": "६-४१-१७", "content_sanskrit": "रजन्यामप्रकाशश्च संतापयति चन्द्रमाः।\nकृष्णरक्तांशुपर्यन्तो यथा लोकस्य संक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000448017, "chapter_id": 9448, "verse_number": "६-४१-१८", "content_sanskrit": "ह्रस्वो रूक्षोऽप्रशस्तश्च परिवेषः सुलोहितः।\nआदित्यमण्डले नीलं लक्ष्म लक्ष्मण दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000448018, "chapter_id": 9448, "verse_number": "६-४१-१९", "content_sanskrit": "दृश्यन्ते न यथावच्च नक्षत्राण्यभिवर्तते।\nयुगान्तमिव लोकस्य पश्य लक्ष्मण शंसति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000448019, "chapter_id": 9448, "verse_number": "६-४१-२०", "content_sanskrit": "काकाः श्येनास्तथा गृध्रा नीचैः परिपतन्ति च।\nशिवाश्चाप्यशुभा वाचः प्रवदन्ति महास्वनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000448020, "chapter_id": 9448, "verse_number": "६-४१-२१", "content_sanskrit": "शैलैः शूलैश्च खड्गैश्च विमुक्तैः कपिराक्षसैः।\nभविष्यत्यावृता भूमिर्मांसशोणितकर्दमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000448021, "chapter_id": 9448, "verse_number": "६-४१-२२", "content_sanskrit": "क्षिप्रमद्य दुराधर्षां पुरीं रावणपालिताम्।\nअभियाम जवेनैव सर्वतो हरिभिर्वृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000448022, "chapter_id": 9448, "verse_number": "६-४१-२३", "content_sanskrit": "इत्येवं तु वदन् वीरो लक्ष्मणं लक्ष्मणाग्रजः।\nतस्मादवातरच्छीघ्रं पर्वताग्रान्महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000448023, "chapter_id": 9448, "verse_number": "६-४१-२४", "content_sanskrit": "अवतीर्य तु धर्मात्मा तस्माच्छैलात् स राघवः।\nपरैः परमदुर्धर्षं ददर्श बलमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000448024, "chapter_id": 9448, "verse_number": "६-४१-२५", "content_sanskrit": "संनह्य तु ससुग्रीवः कपिराजबलं महत्।\nकालज्ञो राघवः काले संयुगायाभ्यचोदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000448025, "chapter_id": 9448, "verse_number": "६-४१-२६", "content_sanskrit": "ततः काले महाबाहुर्बलेन महता वृतः।\nप्रस्थितः पुरतो धन्वी लङ्कामभिमुखः पुरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000448026, "chapter_id": 9448, "verse_number": "६-४१-२७", "content_sanskrit": "तं विभीषणसुग्रीवौ हनूमाञ्जाम्बवान् नलः।\nऋक्षराजस्तथा नीलो लक्ष्मणश्चान्वयुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000448027, "chapter_id": 9448, "verse_number": "६-४१-२८", "content_sanskrit": "ततः पश्चात् सुमहती पृतनर्क्षवनौकसाम्।\nप्रच्छाद्य महतीं भूमिमनुयाति स्म राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000448028, "chapter_id": 9448, "verse_number": "६-४१-२९", "content_sanskrit": "शैलशृङ्गाणि शतशः प्रवृद्धांश्च महीरुहान्।\nजगृहुः कुञ्जरप्रख्या वानराः परवारणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000448029, "chapter_id": 9448, "verse_number": "६-४१-३०", "content_sanskrit": "तौ त्वदीर्घेण कालेन भ्रातरौ रामलक्ष्मणौ।\nरावणस्य पुरीं लङ्कामासेदतुररिंदमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000448030, "chapter_id": 9448, "verse_number": "६-४१-३१", "content_sanskrit": "पताकामालिनीं रम्यामुद्यानवनशोभिताम्।\nचित्रवप्रां सुदुष्प्रापामुच्चैः प्राकारतोरणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000448031, "chapter_id": 9448, "verse_number": "६-४१-३२", "content_sanskrit": "तां सुरैरपि दुर्धर्षां रामवाक्यप्रचोदिताः।\nयथानिदेशं सम्पीड्य न्यविशन्त वनौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000448032, "chapter_id": 9448, "verse_number": "६-४१-३३", "content_sanskrit": "लङ्कायास्तूत्तरद्वारं शैलशृङ्गमिवोन्नतम्।\nरामः सहानुजो धन्वी जुगोप च रुरोध च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000448033, "chapter_id": 9448, "verse_number": "६-४१-३४", "content_sanskrit": "लङ्कामुपनिविष्टस्तु रामो दशरथात्मजः।\nलक्ष्मणानुचरो वीरः पुरीं रावणपालिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000448034, "chapter_id": 9448, "verse_number": "६-४१-३५", "content_sanskrit": "उत्तरद्वारमासाद्य यत्र तिष्ठति रावणः।\nनान्यो रामाद्धि तद् द्वारं समर्थः परिरक्षितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000448035, "chapter_id": 9448, "verse_number": "६-४१-३६", "content_sanskrit": "रावणाधिष्ठितं भीमं वरुणेनेव सागरम्।\nसायुधै राक्षसैर्भीमैरभिगुप्तं समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000448036, "chapter_id": 9448, "verse_number": "६-४१-३७", "content_sanskrit": "लघूनां त्रासजननं पातालमिव दानवैः।\nविन्यस्तानि च योधानां बहूनि विविधानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000448037, "chapter_id": 9448, "verse_number": "६-४१-३८", "content_sanskrit": "ददर्शायुधजालानि तथैव कवचानि च।\nपूर्वं तु द्वारमासाद्य नीलो हरिचमूपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000448038, "chapter_id": 9448, "verse_number": "६-४१-३९", "content_sanskrit": "अतिष्ठत् सह मैन्देन द्विविदेन च वीर्यवान्।\nअङ्गदो दक्षिणद्वारं जग्राह सुमहाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000448039, "chapter_id": 9448, "verse_number": "६-४१-४०", "content_sanskrit": "ऋषभेण गवाक्षेण गजेन गवयेन च।\nहनूमान् पश्चिमद्वारं ररक्ष बलवान् कपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000448040, "chapter_id": 9448, "verse_number": "६-४१-४१", "content_sanskrit": "प्रमाथिप्रघसाभ्यां च वीरैरन्यैश्च संगतः।\nमध्यमे च स्वयं गुल्मे सुग्रीवः समतिष्ठत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000448041, "chapter_id": 9448, "verse_number": "६-४१-४२", "content_sanskrit": "सह सर्वैर्हरिश्रेष्ठैः सुपर्णपवनोपमैः।\nवानराणां तु षट‍‍्त्रिंशत्कोट्यः प्रख्यातयूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000448042, "chapter_id": 9448, "verse_number": "६-४१-४३", "content_sanskrit": "निपीड्योपनिविष्टाश्च सुग्रीवो यत्र वानरः।\nशासनेन तु रामस्य लक्ष्मणः सविभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000448043, "chapter_id": 9448, "verse_number": "६-४१-४४", "content_sanskrit": "द्वारे द्वारे हरीणां तु कोटिं कोटीर्न्यवेशयत्।\nपश्चिमेन तु रामस्य सुषेणः सहजाम्बवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000448044, "chapter_id": 9448, "verse_number": "६-४१-४५", "content_sanskrit": "अदूरान्मध्यमे गुल्मे तस्थौ बहुबलानुगः।\nते तु वानरशार्दूलाः शार्दूला इव दंष्ट्रिणः।\nगृहीत्वा द्रुमशैलाग्रान् हृष्टा युद्धाय तस्थिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000448045, "chapter_id": 9448, "verse_number": "६-४१-४६", "content_sanskrit": "सर्वे विकृतलाङ्गूलाः सर्वे दंष्ट्रानखायुधाः।\nसर्वे विकृतचित्राङ्गाः सर्वे च विकृताननाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000448046, "chapter_id": 9448, "verse_number": "६-४१-४७", "content_sanskrit": "दशनागबलाः केचित् केचिद् दशगुणोत्तराः।\nकेचिन्नागसहस्रस्य बभूवुस्तुल्यविक्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000448047, "chapter_id": 9448, "verse_number": "६-४१-४८", "content_sanskrit": "सन्ति चौघबलाः केचित् केचिच्छतगुणोत्तराः।\nअप्रमेयबलाश्चान्ये तत्रासन् हरियूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000448048, "chapter_id": 9448, "verse_number": "६-४१-४९", "content_sanskrit": "अद्भुतश्च विचित्रश्च तेषामासीत् समागमः।\nतत्र वानरसैन्यानां शलभानामिवोद‍्गमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000448049, "chapter_id": 9448, "verse_number": "६-४१-५०", "content_sanskrit": "परिपूर्णमिवाकाशं सम्पूर्णेव च मेदिनी।\nलङ्कामुपनिविष्टैश्च सम्पतद्भिश्च वानरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000448050, "chapter_id": 9448, "verse_number": "६-४१-५१", "content_sanskrit": "शतं शतसहस्राणां पृतनर्क्षवनौकसाम्।\nलङ्काद्वाराण्युपाजग्मुरन्ये योद्धुं समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000448051, "chapter_id": 9448, "verse_number": "६-४१-५२", "content_sanskrit": "आवृतः स गिरिः सर्वैस्तैः समन्तात् प्लवङ्गमैः।\nअयुतानां सहस्रं च पुरीं तामभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000448052, "chapter_id": 9448, "verse_number": "६-४१-५३", "content_sanskrit": "वानरैर्बलवद्भिश्च बभूव द्रुमपाणिभिः।\nसर्वतः संवृता लङ्का दुष्प्रवेशापि वायुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000448053, "chapter_id": 9448, "verse_number": "६-४१-५४", "content_sanskrit": "राक्षसा विस्मयं जग्मुः सहसाभिनिपीडिताः।\nवानरैर्मेघसंकाशैः शक्रतुल्यपराक्रमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000448054, "chapter_id": 9448, "verse_number": "६-४१-५५", "content_sanskrit": "महाञ्छब्दोऽभवत् तत्र बलौघस्याभिवर्ततः।\nसागरस्येव भिन्नस्य यथा स्यात् सलिलस्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000448055, "chapter_id": 9448, "verse_number": "६-४१-५६", "content_sanskrit": "तेन शब्देन महता सप्राकारा सतोरणा।\nलङ्का प्रचलिता सर्वा सशैलवनकानना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000448056, "chapter_id": 9448, "verse_number": "६-४१-५७", "content_sanskrit": "रामलक्ष्मणगुप्ता सा सुग्रीवेण च वाहिनी।\nबभूव दुर्धर्षतरा सर्वैरपि सुरासुरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000448057, "chapter_id": 9448, "verse_number": "६-४१-५८", "content_sanskrit": "राघवः संनिवेश्यैवं स्वसैन्यं रक्षसां वधे।\nसम्मन्त्र्य मन्त्रिभिः सार्धं निश्चित्य च पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000448058, "chapter_id": 9448, "verse_number": "६-४१-५९", "content_sanskrit": "आनन्तर्यमभिप्रेप्सुः क्रमयोगार्थतत्त्ववित् ।\nविभीषणस्यानुमते राजधर्ममनुस्मरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000448059, "chapter_id": 9448, "verse_number": "६-४१-६०", "content_sanskrit": "अङ्गदं वालितनयं समाहूयेदमब्रवीत्।\nगत्वा सौम्य दशग्रीवं ब्रूहि मद्वचनात् कपे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000448060, "chapter_id": 9448, "verse_number": "६-४१-६१", "content_sanskrit": "लङ्घयित्वा पुरीं लङ्कां भयं त्यक्त्वा गतव्यथः।\nभ्रष्टश्रीकं गतैश्वर्यं मुमूर्षानष्टचेतनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000448061, "chapter_id": 9448, "verse_number": "६-४१-६२", "content_sanskrit": "ऋषीणां देवतानां च गन्धर्वाप्सरसां तथा।\nनागानामथ यक्षाणां राज्ञां च रजनीचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000448062, "chapter_id": 9448, "verse_number": "६-४१-६३", "content_sanskrit": "यच्च पापं कृतं मोहादवलिप्तेन राक्षस।\nनूनं ते विगतो दर्पः स्वयंभूवरदानजः।\nतस्य पापस्य सम्प्राप्ता व्युष्टिरद्य दुरासदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000448063, "chapter_id": 9448, "verse_number": "६-४१-६४", "content_sanskrit": "यस्य दण्डधरस्तेऽहं दाराहरणकर्शितः।\nदण्डं धारयमाणस्तु लङ्काद्वारे व्यवस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000448064, "chapter_id": 9448, "verse_number": "६-४१-६५", "content_sanskrit": "पदवीं देवतानां च महर्षीणां च राक्षस।\nराजर्षीणां च सर्वेषां गमिष्यसि युधि स्थिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000448065, "chapter_id": 9448, "verse_number": "६-४१-६६", "content_sanskrit": "बलेन येन वै सीतां मायया राक्षसाधम।\nमामतिक्रमयित्वा त्वं हृतवांस्तन्निदर्शय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000448066, "chapter_id": 9448, "verse_number": "६-४१-६७", "content_sanskrit": "अराक्षसमिमं लोकं कर्तास्मि निशितैः शरैः।\nन चेच्छरणमभ्येषि तामादाय तु मैथिलीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000448067, "chapter_id": 9448, "verse_number": "६-४१-६८", "content_sanskrit": "धर्मात्मा राक्षसश्रेष्ठः सम्प्राप्तोऽयं विभीषणः।\nलङ्कैश्वर्यमिदं श्रीमान् ध्रुवं प्राप्नोत्यकण्टकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000448068, "chapter_id": 9448, "verse_number": "६-४१-६९", "content_sanskrit": "नहि राज्यमधर्मेण भोक्तुं क्षणमपि त्वया।\nशक्यं मूर्खसहायेन पापेनाविदितात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000448069, "chapter_id": 9448, "verse_number": "६-४१-७०", "content_sanskrit": "युध्यस्व मा धृतिं कृत्वा शौर्यमालम्ब्य राक्षस।\nमच्छरैस्त्वं रणे शान्तस्ततः पूतो भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 5000448070, "chapter_id": 9448, "verse_number": "६-४१-७१", "content_sanskrit": "यद्याविशसि लोकांस्त्रीन् पक्षीभूतो निशाचर।\nमम चक्षुःपथं प्राप्य न जीवन् प्रतियास्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 5000448071, "chapter_id": 9448, "verse_number": "६-४१-७२", "content_sanskrit": "ब्रवीमि त्वां हितं वाक्यं क्रियतामौर्ध्वदेहिकम्।\nसुदृष्टा क्रियतां लङ्का जीवितं ते मयि स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 5000448072, "chapter_id": 9448, "verse_number": "६-४१-७३", "content_sanskrit": "इत्युक्तः स तु तारेयो रामेणाक्लिष्टकर्मणा।\nजगामाकाशमाविश्य मूर्तिमानिव हव्यवाट् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 5000448073, "chapter_id": 9448, "verse_number": "६-४१-७४", "content_sanskrit": "सोऽतिपत्य मुहूर्तेन श्रीमान् रावणमन्दिरम्।\nददर्शासीनमव्यग्रं रावणं सचिवैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 5000448074, "chapter_id": 9448, "verse_number": "६-४१-७५", "content_sanskrit": "ततस्तस्याविदूरेण निपत्य हरिपुंगवः।\nदीप्ताग्निसदृशस्तस्थावङ्गदः कनकाङ्गदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 5000448075, "chapter_id": 9448, "verse_number": "६-४१-७६", "content_sanskrit": "तद् रामवचनं सर्वमन्यूनाधिकमुत्तमम्।\nसामात्यं श्रावयामास निवेद्यात्मानमात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 5000448076, "chapter_id": 9448, "verse_number": "६-४१-७७", "content_sanskrit": "दूतोऽहं कोसलेन्द्रस्य रामस्याक्लिष्टकर्मणः।\nवालिपुत्रोऽङ्गदो नाम यदि ते श्रोत्रमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 5000448077, "chapter_id": 9448, "verse_number": "६-४१-७८", "content_sanskrit": "आह त्वां राघवो रामः कौसल्यानन्दवर्धनः।\nनिष्पत्य प्रतियुध्यस्व नृशंस पुरुषो भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 5000448078, "chapter_id": 9448, "verse_number": "६-४१-७९", "content_sanskrit": "हन्तास्मि त्वां सहामात्यं सपुत्रज्ञातिबान्धवम्।\nनिरुद्विग्नास्त्रयो लोका भविष्यन्ति हते त्वयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 5000448079, "chapter_id": 9448, "verse_number": "६-४१-८०", "content_sanskrit": "देवदानवयक्षाणां गन्धर्वोरगरक्षसाम्।\nशत्रुमद्योद्धरिष्यामि त्वामृषीणां च कण्टकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 5000448080, "chapter_id": 9448, "verse_number": "६-४१-८१", "content_sanskrit": "विभीषणस्य चैश्वर्यं भविष्यति हते त्वयि।\nन चेत् सत्कृत्य वैदेहीं प्रणिपत्य प्रदास्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 5000448081, "chapter_id": 9448, "verse_number": "६-४१-८२", "content_sanskrit": "इत्येवं परुषं वाक्यं ब्रुवाणे हरिपुङ्गवे।\nअमर्षवशमापन्नो निशाचरगणेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 5000448082, "chapter_id": 9448, "verse_number": "६-४१-८३", "content_sanskrit": "ततः स रोषमापन्नः शशास सचिवांस्तदा।\nगृह्यतामिति दुर्मेधा वध्यतामिति चासकृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 5000448083, "chapter_id": 9448, "verse_number": "६-४१-८४", "content_sanskrit": "रावणस्य वचः श्रुत्वा दीप्ताग्निमिव तेजसा।\nजगृहुस्तं ततो घोराश्चत्वारो रजनीचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 5000448084, "chapter_id": 9448, "verse_number": "६-४१-८५", "content_sanskrit": "ग्राहयामास तारेयः स्वयमात्मानमात्मवान्।\nबलं दर्शयितुं वीरो यातुधानगणे तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 5000448085, "chapter_id": 9448, "verse_number": "६-४१-८६", "content_sanskrit": "स तान् बाहुद्वयासक्तानादाय पतगानिव।\nप्रासादं शैलसंकाशमुत्पपाताङ्गदस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 5000448086, "chapter_id": 9448, "verse_number": "६-४१-८७", "content_sanskrit": "तस्योत्पतनवेगेन निर्धूतास्तत्र राक्षसाः।\nभूमौ निपतिताः सर्वे राक्षसेन्द्रस्य पश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 5000448087, "chapter_id": 9448, "verse_number": "६-४१-८८", "content_sanskrit": "ततः प्रासादशिखरं शैलशृङ्गमिवोन्नतम्।\nचक्राम राक्षसेन्द्रस्य वालिपुत्रः प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 5000448088, "chapter_id": 9448, "verse_number": "६-४१-८९", "content_sanskrit": "पफाल च तदाक्रान्तं दशग्रीवस्य पश्यतः।\nपुरा हिमवतः शृङ्गं वज्रेणेव विदारितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 5000448089, "chapter_id": 9448, "verse_number": "६-४१-९०", "content_sanskrit": "भङ्‍क्त्वा प्रासादशिखरं नाम विश्राव्य चात्मनः।\nविनद्य सुमहानादमुत्पपात विहायसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 5000448090, "chapter_id": 9448, "verse_number": "६-४१-९१", "content_sanskrit": "व्यथयन् राक्षसान् सर्वान् हर्षयंश्चापि वानरान्।\nस वानराणां मध्ये तु रामपार्श्वमुपागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 5000448091, "chapter_id": 9448, "verse_number": "६-४१-९२", "content_sanskrit": "रावणस्तु परं चक्रे क्रोधं प्रासादधर्षणात्।\nविनाशं चात्मनः पश्यन् निःश्वासपरमोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 5000448092, "chapter_id": 9448, "verse_number": "६-४१-९३", "content_sanskrit": "रामस्तु बहुभिर्हृष्टैर्विनदद्भिः प्लवङ्गमैः।\nवृतो रिपुवधाकाङ्क्षी युद्धायैवाभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 5000448093, "chapter_id": 9448, "verse_number": "६-४१-९४", "content_sanskrit": "सुषेणस्तु महावीर्यो गिरिकूटोपमो हरिः।\nबहुभिः संवृतस्तत्र वानरैः कामरूपिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 5000448094, "chapter_id": 9448, "verse_number": "६-४१-९५", "content_sanskrit": "स तु द्वाराणि संयम्य सुग्रीववचनात् कपिः।\nपर्यक्रामत दुर्धर्षो नक्षत्राणीव चन्द्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 5000448095, "chapter_id": 9448, "verse_number": "६-४१-९६", "content_sanskrit": "तेषामक्षौहिणिशतं समवेक्ष्य वनौकसाम्।\nलङ्कामुपनिविष्टानां सागरं चाभिवर्तताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 5000448096, "chapter_id": 9448, "verse_number": "६-४१-९७", "content_sanskrit": "राक्षसा विस्मयं जग्मुस्त्रासं जग्मुस्तथापरे।\nअपरे समरे हर्षाद्धर्षमेवोपपेदिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 5000448097, "chapter_id": 9448, "verse_number": "६-४१-९८", "content_sanskrit": "कृत्स्नं हि कपिभिर्व्याप्तं प्राकारपरिखान्तरम्।\nददृशू राक्षसा दीनाः प्राकारं वानरीकृतम्।\nहाहाकारमकुर्वन्त राक्षसा भयमागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 5000448098, "chapter_id": 9448, "verse_number": "६-४१-९९", "content_sanskrit": "तस्मिन् महाभीषणके प्रवृत्ते\nकोलाहले राक्षसराजयोधाः।\nप्रगृह्य रक्षांसि महायुधानि\nयुगान्तवाता इव संविचेरुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 5000448099, "chapter_id": 9448, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमद्युद्धकाण्डे एकचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}]