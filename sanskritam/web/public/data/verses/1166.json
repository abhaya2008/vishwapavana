[{"id": 2008601, "chapter_id": 1166, "verse_number": "१-१६७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2008602, "chapter_id": 1166, "verse_number": "१-१६७-१", "content_sanskrit": "सा तानेवापतत्तूर्णं भगिनी तस्य रक्षसः।\nअब्रुवाणा हिडिम्बा तु राक्षसी पाण्डवान्प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2008603, "chapter_id": 1166, "verse_number": "१-१६७-२", "content_sanskrit": "अभिवाद्य ततः कुन्तीं धर्मराजं च पाण्डवम्।\nअभिपूज्य ततः सर्वान्भीमसेनमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2008604, "chapter_id": 1166, "verse_number": "१-१६७-३", "content_sanskrit": "अहं ते दर्शादेव मन्मथस्य वशं गता।\nक्रूरं भ्रातृवचो हित्वा सा त्वामेवानिरुन्धती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2008605, "chapter_id": 1166, "verse_number": "१-१६७-४", "content_sanskrit": "राक्षसे रौद्रसङ्काशे तवापश्यं विचेष्टितम्।\nअहं शुश्रूषुरिच्छेयं तव गात्रं निषेवितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2008606, "chapter_id": 1166, "verse_number": "१-१६७-५x", "content_sanskrit": "भीमसेन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2008607, "chapter_id": 1166, "verse_number": "१-१६७-५", "content_sanskrit": "स्मरन्ति वैरं रक्षांसि मायामाश्रित्य मोहिनीम्।\nहिडिम्बे व्रज पन्थानं त्वमिमं भ्रातृसेवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2008608, "chapter_id": 1166, "verse_number": "१-१६७-६x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2008609, "chapter_id": 1166, "verse_number": "१-१६७-६", "content_sanskrit": "क्रुद्धोऽपि पुरुषव्याघ्र भीम मा स्म स्त्रियं वधीः।\nशरीरगुप्त्यभ्यधिकं धर्मं गोपाय पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2008610, "chapter_id": 1166, "verse_number": "१-१६७-७", "content_sanskrit": "वधाभिप्रायमायान्तमवधीस्त्वं महाबलम्।\nरक्षसस्तस्य भगिनी किं नः क्रुद्धा करिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2008611, "chapter_id": 1166, "verse_number": "१-१६७-८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2008612, "chapter_id": 1166, "verse_number": "१-१६७-८", "content_sanskrit": "हिडिम्बा तु ततः कुन्तीमभिवाद्य कृताञ्जलिः।\nयुधिष्ठिरं तु कौन्तेयमिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2008613, "chapter_id": 1166, "verse_number": "१-१६७-९", "content_sanskrit": "आर्ये जानासि यद्दुःखमिह स्त्रीणामनङ्गजम्।\nतदिदं मामनुप्राप्तं भीमसेनकृते शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2008614, "chapter_id": 1166, "verse_number": "१-१६७-१०", "content_sanskrit": "सोढं तत्परमं दुःखं मया कालप्रतीक्षया।\nसोऽयमभ्यागतः कालो भविता मे सुखोदयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2008615, "chapter_id": 1166, "verse_number": "१-१६७-११", "content_sanskrit": "मया ह्युत्सृज्य सुहृदः स्वधर्मं स्वजनं तथा।\nवृतोऽयं पुरुषव्याघ्रस्तव पुत्रः पतिः शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2008616, "chapter_id": 1166, "verse_number": "१-१६७-१२", "content_sanskrit": "वीरेणाऽहं तथाऽनेन त्वया चापि यशस्विनी।\nप्रत्याख्याता न जीवामि सत्यमेतद्ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2008617, "chapter_id": 1166, "verse_number": "१-१६७-१३", "content_sanskrit": "यदर्हसि कृपां कर्तुं मयि त्वं वरवर्णिनि।\nमत्वा मूढेति तन्मां त्वं भक्ता वाऽनुगतेति वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2008618, "chapter_id": 1166, "verse_number": "१-१६७-१४", "content_sanskrit": "भर्त्राऽनेन महाभागे संयोजय सुतेन ह।\nसमुपादाय गच्छेयं यथेष्टं देवरूपिणम्।\nपुनश्चैवानयिष्यामि विस्रम्भं कुरु मे शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2008619, "chapter_id": 1166, "verse_number": "१-१६७-१५", "content_sanskrit": "अहं हि समये लप्स्ये प्राग्भ्रातुरपर्वजनात्।\nततः सोऽभ्यपतद्रात्रौ भीमसेनजिघांसया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2008620, "chapter_id": 1166, "verse_number": "१-१६७-१६", "content_sanskrit": "यथायथा विक्रमते यथारिमधितिष्ठति।\nतथातथा समासाद्य पाण्डवं काममोहिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2008621, "chapter_id": 1166, "verse_number": "१-१६७-१७", "content_sanskrit": "न यातुधान्यहं त्वार्ये न चास्मि रजनीचरी।\nईशा रक्षस्स्वसा ह्यस्मि राज्ञि सालकटङ्कटी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2008622, "chapter_id": 1166, "verse_number": "१-१६७-१८", "content_sanskrit": "पुत्रेण तव संयुक्ता युवतिर्देववर्णिनी।\nसर्वान्वोऽहमुपस्थास्ये पुरस्कृत्य वृकोदरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2008623, "chapter_id": 1166, "verse_number": "१-१६७-१९", "content_sanskrit": "अप्रमत्ता प्रमत्तेषु शुश्रूषुरसकृत्त्वहम्।\nवृजिने तारयिष्यामि दासीवच्च नरर्षभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2008624, "chapter_id": 1166, "verse_number": "१-१६७-२०", "content_sanskrit": "पृष्ठेन वो वहिष्यामि विमानं सुकृतानिव।\nयूयं प्रसादं कुरुत भीमसेनो भजेत माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2008625, "chapter_id": 1166, "verse_number": "१-१६७-२१", "content_sanskrit": "एवं ब्रुवन्ती ह तथा प्रत्याख्याता क्रियां प्रति।\nभूम्यां दुष्कृतिनो लोकान्गमिष्येऽहं न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2008626, "chapter_id": 1166, "verse_number": "१-१६७-२२", "content_sanskrit": "अहं हि मनसा ध्यात्वा सर्वं वेत्स्यामि सर्वदा।\nआपन्निस्तरणे प्राणान्धारयिष्ये न केनचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2008627, "chapter_id": 1166, "verse_number": "१-१६७-२३", "content_sanskrit": "सर्वमावृत्य कर्तव्यं धर्मं समनुपश्यता।\nआपत्सु यो धारयति स वै धर्मविदुत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2008628, "chapter_id": 1166, "verse_number": "१-१६७-२४", "content_sanskrit": "व्यसनं ह्येव धर्मस्य धर्मिणामापदुच्यते।\nपुम्यात्प्राणान्धारयति पुण्यं वै प्राणधारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2008629, "chapter_id": 1166, "verse_number": "१-१६७-२५", "content_sanskrit": "येन केनाचरेद्धर्मं तस्मिन्गर्हा न विद्यते।\nमहतोऽत्र स्त्रियं कामाद्वाधितां त्राहि मामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2008630, "chapter_id": 1166, "verse_number": "१-१६७-२६", "content_sanskrit": "धर्मार्थकाममोक्षेषु दयां कुर्वन्ति साधवः।\nतत्तु धर्ममिति प्राहुर्मुनयो धर्मवत्सलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2008631, "chapter_id": 1166, "verse_number": "१-१६७-२७", "content_sanskrit": "दिव्यज्ञानेन जानामि व्यतीतानागतानहम्।\nतस्माद्वक्ष्यामि वः श्रेय आसन्नं सर उत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2008632, "chapter_id": 1166, "verse_number": "१-१६७-२८", "content_sanskrit": "अद्यासाद्य सरः स्नात्वा विश्रम्य च वनस्पतौ।\nश्वः प्रभाते महद्भूतं प्रादुर्भूतं जगत्पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2008633, "chapter_id": 1166, "verse_number": "१-१६७-२९", "content_sanskrit": "व्यासं कमलपत्राक्षं दृष्ट्वा शोकं विहास्यथ।\nधार्तराष्ट्राद्विवासं च दहनं वारणावते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2008634, "chapter_id": 1166, "verse_number": "१-१६७-३०", "content_sanskrit": "त्राणं च विदुरात्तुभ्यं विदितं ज्ञानचक्षुषा।\nआवासे शालिहोत्रस्य स वो वासं विधास्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2008635, "chapter_id": 1166, "verse_number": "१-१६७-३१", "content_sanskrit": "वर्षवातातपसहो ह्ययं पुण्यो वनस्पतिः।\nपीतमात्रे तु पानीये क्षुत्पिपासे विनश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2008636, "chapter_id": 1166, "verse_number": "१-१६७-३२", "content_sanskrit": "तपसा शालिहोत्रेण सरो वृक्षश्च निर्मितः।\nकादम्बाः सारसा हंसाः कुरर्यः कुररैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2008637, "chapter_id": 1166, "verse_number": "१-१६७-३३", "content_sanskrit": "रुवन्ति मधुरं गीतं गान्धर्वस्वनमिश्रितम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2008638, "chapter_id": 1166, "verse_number": "१-१६७-३३x", "content_sanskrit": "वैशम्पायन उवाच।\nतस्यास्तद्वचनं श्रुत्वा कुन्ती वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2008639, "chapter_id": 1166, "verse_number": "१-१६७-३४", "content_sanskrit": "युधिष्ठिरं महाप्राज्ञं सर्वधर्मविशारदम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2008640, "chapter_id": 1166, "verse_number": "१-१६७-३४x", "content_sanskrit": "कुन्त्युवाच।\nत्वं हि धर्मभृतां श्रेष्ठो मयोक्तं शृणु भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2008641, "chapter_id": 1166, "verse_number": "१-१६७-३५", "content_sanskrit": "राक्षस्येषा हि वाक्येन धर्मं वदति साधु वै।\nभावेन दुष्टा भीमं वै किं करिष्यति राक्षसी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2008642, "chapter_id": 1166, "verse_number": "१-१६७-३६", "content_sanskrit": "भजतां पाण्डवं वीरमपत्यार्थं यदीच्छसि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2008643, "chapter_id": 1166, "verse_number": "१-१६७-३६x", "content_sanskrit": "युधिष्ठिर उवाच।\nएवमेतद्यथाऽऽत्थ त्वं हिडिम्बे नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2008644, "chapter_id": 1166, "verse_number": "१-१६७-३७", "content_sanskrit": "स्थातव्यं तु त्वया धर्मे यथा ब्रूयां सुमध्यमे।\nनित्यं कृताह्निका स्नाता कृतशौचा सुरूपिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2008645, "chapter_id": 1166, "verse_number": "१-१६७-३८", "content_sanskrit": "स्नातं कृताह्निकं भद्रे कृतकौतुकमङ्गलम्।\nभीमसेनं भजेथास्त्वमुदिते वै दिवाकरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2008646, "chapter_id": 1166, "verse_number": "१-१६७-३९", "content_sanskrit": "अहस्सु विहरानेन यथाकामं मनोजवा।\nअयं त्वानयितव्यस्ते भीमसेनः सदा निशि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2008647, "chapter_id": 1166, "verse_number": "१-१६७-४०", "content_sanskrit": "प्राक्सन्ध्यातो विमोक्तव्यो रक्षितव्यश्च नित्यशः।\nएवं रमस्व भीमेन यावद्गर्भस्य वेदनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2008648, "chapter_id": 1166, "verse_number": "१-१६७-४१", "content_sanskrit": "एष ते समयो भद्रे शुश्रूषा चाप्रमत्तया।\nनित्यानुकूलया भूत्वा कर्तव्यं शोभनं त्वया॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2008649, "chapter_id": 1166, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि हिडिम्बवधपर्वणि सप्तषष्ट्यधिकशततमोऽध्यायः॥ १६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]