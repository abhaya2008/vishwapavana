[{"id": 2090479, "chapter_id": 2922, "verse_number": "१३-५२-१", "content_sanskrit": "युधिष्ठिर उवाच।\nन बिभेति कथं सा स्त्री शापाच्च परमद्युते।\nकथं निवृत्तो भगवांस्तद्भवान्प्रब्रवीतु मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2090480, "chapter_id": 2922, "verse_number": "१३-५२-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2090481, "chapter_id": 2922, "verse_number": "१३-५२-२", "content_sanskrit": "अष्टावक्रोऽन्वपृच्छत्तां रूपं विकुरुषे कथम्।\nन चानृतं ते वक्तव्यं ब्रूहि ब्राह्मणकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2090482, "chapter_id": 2922, "verse_number": "१३-५२-३x", "content_sanskrit": "स्त्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2090483, "chapter_id": 2922, "verse_number": "१३-५२-३", "content_sanskrit": "द्यावापृथिव्योर्यत्रैषा काम्या ब्राह्मणसत्तम।\nशृणुष्वावहितः सर्वं यदिदं सत्यविक्रम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2090484, "chapter_id": 2922, "verse_number": "१३-५२-४", "content_sanskrit": "जिज्ञासेयं प्रयुक्ता मे स्थैर्यं कर्तुं तवानघ।\nअव्युत्थानेन ते लोका जिताः सत्यपराक्रम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2090485, "chapter_id": 2922, "verse_number": "१३-५२-५", "content_sanskrit": "उत्तरां मां दिशं विद्धि दृष्टं स्त्रीचापलं च ते।\nस्थविराणामपि स्त्रीणां बाधते मैथुनज्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2090486, "chapter_id": 2922, "verse_number": "१३-५२-६", "content_sanskrit": "`अविश्वासो न व्यसनी नातिसक्तोऽप्रवासकः।\nविद्वान्सुशीलः पुरुषः सदारः सुखमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2090487, "chapter_id": 2922, "verse_number": "१३-५२-७", "content_sanskrit": "तुष्टः पितामहस्तेऽद्य तथा देवाः सवासवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2090488, "chapter_id": 2922, "verse_number": "१३-५२-८", "content_sanskrit": "सत्वं येन च कार्येण सम्प्राप्तो भगवानिह।\nप्रेषितस्तेन विप्रेण कन्यापित्रा द्विजर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2090489, "chapter_id": 2922, "verse_number": "१३-५२-९", "content_sanskrit": "प्रेषितश्चोपदेशाय तच्च सर्वं श्रुतं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2090490, "chapter_id": 2922, "verse_number": "१३-५२-१०", "content_sanskrit": "`नितान्तं स्त्री भोगपरा प्रियवादाप्रवासनात्।\nरक्ष्यते चाकुचेलाद्यैरप्रसङ्गानुवर्तनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2090491, "chapter_id": 2922, "verse_number": "१३-५२-११", "content_sanskrit": "अपर्वस्वनिषिद्धासु रात्रिष्वप्यनृतौ व्रजेत्।\nरात्रौ च नातिनियमो न वै ह्यनियमो भवेत्॥॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2090492, "chapter_id": 2922, "verse_number": "१३-५२-१२", "content_sanskrit": "क्षेमैर्गमिष्यसि गृहं श्रमश्च न भविष्यति।\nकन्यां प्राप्स्यसि तां विप्र पुत्रिणी च भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2090493, "chapter_id": 2922, "verse_number": "१३-५२-१३", "content_sanskrit": "काम्यया पृष्टवांस्त्वं मां ततो व्याहृतमुत्तरम्।\nअनतिक्रमणीया साकृत्स्नैर्लोकैस्त्रिभिः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2090494, "chapter_id": 2922, "verse_number": "१३-५२-१४", "content_sanskrit": "गच्छस्व कृतकृत्यस्त्वं किं वाऽन्यच्छ्रोतुमिच्छसि।\nयावद्ब्रवीमि विप्रर्षे अष्टावक्र यथातथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2090495, "chapter_id": 2922, "verse_number": "१३-५२-१५", "content_sanskrit": "ऋषिणा प्रसादिता चास्मि तव हेतोर्द्विजर्षभ।\nतस्य सम्माननार्थं मे त्वयि वाक्यं प्रभाषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2090496, "chapter_id": 2922, "verse_number": "१३-५२-१६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2090497, "chapter_id": 2922, "verse_number": "१३-५२-१६", "content_sanskrit": "श्रुत्वा तु वचनं तस्याः स विप्रः प्राञ्जलिः स्थितः।\nअनुज्ञातस्तया चापि स्वगृहं पुनराव्रजत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2090498, "chapter_id": 2922, "verse_number": "१३-५२-१७", "content_sanskrit": "गृहमागत्य विश्रान्तः स्वजनं परिपृच्छ्य च।\nअभ्यागच्छच्च तं विप्रं न्यायतः कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2090499, "chapter_id": 2922, "verse_number": "१३-५२-१८", "content_sanskrit": "पृष्टश्च तेन विप्रेण दृष्टं त्वेतन्निदर्शनम्।\nप्राह विप्रं तदा विप्रः सुप्रीतेनान्तरात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2090500, "chapter_id": 2922, "verse_number": "१३-५२-१९", "content_sanskrit": "भवताऽहमनुज्ञातः प्रास्थितो गन्धमादनम्।\nतस्य चोत्तरतो देशे दृष्टं मे दैवतं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2090501, "chapter_id": 2922, "verse_number": "१३-५२-२०", "content_sanskrit": "तया चाहमनुज्ञातो भवांश्चापि प्रकीर्तितः।\nश्रावितश्चापि तद्वाक्यं गृहं चाभ्यागतः प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2090502, "chapter_id": 2922, "verse_number": "१३-५२-२१", "content_sanskrit": "तमुवाच तदा विप्रः सुतां प्रतिगृहाण मे।\nनक्षत्रतिथिसंयोगे पात्रं हि परमं भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2090503, "chapter_id": 2922, "verse_number": "१३-५२-२२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2090504, "chapter_id": 2922, "verse_number": "१३-५२-२२", "content_sanskrit": "अष्टावक्रस्तथेत्युक्त्वा प्रतिगृह्य च तां प्रभो।\nकन्यां परमधर्मात्मा प्रीतिमांश्चाभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2090505, "chapter_id": 2922, "verse_number": "१३-५२-२३", "content_sanskrit": "कन्यां तां प्रतिगृह्यैव भार्यां परमशोभनाम्।\nउवास मुदितस्तत्र श्वाश्रमे विगतज्वरः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2090506, "chapter_id": 2922, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणिः द्विपञ्चाशोऽध्यायः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]