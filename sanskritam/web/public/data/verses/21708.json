[{"id": 7001708000, "chapter_id": 21708, "verse_number": "१-९४-१", "content_sanskrit": "श्रीब्रह्मोवाच ।\nश्रृणु वत्स प्रवक्ष्यामि पुराणं वैष्णवं महत् ।\nत्रयोविंशतिसहस्रं सर्वपातकनाशनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001708001, "chapter_id": 21708, "verse_number": "१-९४-२", "content_sanskrit": "यत्रादिभागे निर्विष्टाः षडंशाः शक्तिजेन ह ।\nमैत्रेयायादिमे तत्र पुराणस्यावतारिकाम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001708002, "chapter_id": 21708, "verse_number": "१-९४-३", "content_sanskrit": "आदिकारणसर्गश्च देवादीनां च संभवः ।\nसमुद्रमथनाख्यानं दक्षादीनां ततोऽन्वयः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001708003, "chapter_id": 21708, "verse_number": "१-९४-४", "content_sanskrit": "ध्रुवस्य चरितं चैव पृथोश्चरितमेव च ।\nप्रचेतसं तथाख्यानं प्रह्लादस्य कथानकम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001708004, "chapter_id": 21708, "verse_number": "१-९४-५", "content_sanskrit": "पृथग्राज्याधिकाराख्या प्रथमोंऽशइतीरितः ।\nप्रियव्रताऽन्वयाख्याख्यानं द्वीपवर्षनिरूपणम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001708005, "chapter_id": 21708, "verse_number": "१-९४-६", "content_sanskrit": "पातालनरकाख्यानं सप्तस्वर्गनिरूपणम् ।\nसूर्यादिवारकथनं पृथग्लक्षणसंयुतम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001708006, "chapter_id": 21708, "verse_number": "१-९४-७", "content_sanskrit": "चरितं भरतस्याथ मुक्तिमार्गनिदर्शनम् ।\nनिदाघऋभुसंवादो द्वितीयोंश उदाहृतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001708007, "chapter_id": 21708, "verse_number": "१-९४-८", "content_sanskrit": "मन्वन्तरसमाख्यानं वेदव्यासावतारकम् ।\nनरकोद्धारकं कर्म गदितं च ततः परम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001708008, "chapter_id": 21708, "verse_number": "१-९४-९", "content_sanskrit": "सगरस्यौर्वसंवादे सर्वधर्मनिरूपणम् ।\nश्राद्धकल्पं तथोद्दिष्टं वर्णाश्रमनिबन्धनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001708009, "chapter_id": 21708, "verse_number": "१-९४-१०", "content_sanskrit": "सदाचारश्च कथितो मायामोहकथा ततः ।\nतृतीयोंऽशोऽयमुदितः सर्वपापप्रणाशनः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001708010, "chapter_id": 21708, "verse_number": "१-९४-११", "content_sanskrit": "सूर्यवंशकथ पुण्या सोमवंशाऽनुकीर्तनम् ।\nचतुर्थेंऽशेमुनिश्रेष्ठ नानाराजकथान्वितम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001708011, "chapter_id": 21708, "verse_number": "१-९४-१२", "content_sanskrit": "कृष्णावतारसंप्रश्नो गोकुलीया कथा ततः ।\nपूतनादिवधो बाल्ये कौमारेऽघादिहिंसनम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001708012, "chapter_id": 21708, "verse_number": "१-९४-१३", "content_sanskrit": "कैशोरे कंसहननं माथुरं चरितं तथा ।\nततस्तु यौवने प्रोक्ता लीला द्वारवतीभवा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001708013, "chapter_id": 21708, "verse_number": "१-९४-१४", "content_sanskrit": "सर्वदैत्यवधो यत्र विवाहाश्च पृथग्विधाः ।\nयत्र स्थित्वाजगन्नाथः कृष्णो योगेश्वरेश्वरः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001708014, "chapter_id": 21708, "verse_number": "१-९४-१५", "content_sanskrit": "भूभारहरणं चक्रे परेषां हननादिभिः ।\nअष्टावक्रीयमाख्यानं पंचमोंऽश इतीरितः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001708015, "chapter_id": 21708, "verse_number": "१-९४-१६", "content_sanskrit": "कलिजं चरितं प्रोक्तं चातुर्विध्यं लयस्य च ।\nब्रह्मज्ञानसमुद्देशः खांडिक्यस्य निरूपितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001708016, "chapter_id": 21708, "verse_number": "१-९४-१७", "content_sanskrit": "केशिध्वजेन चेत्येष षष्ठोंऽशः परिकीर्तितः ।\nअतः परं तु सूतेन शौनकादिभिरादरात् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001708017, "chapter_id": 21708, "verse_number": "१-९४-१८", "content_sanskrit": "पृष्टेन चोदिताः शश्वद्विष्णुधर्मोत्तराह्वयाः ।\nनानाधर्मकथाः पुण्या व्रतानि नियमा यमाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001708018, "chapter_id": 21708, "verse_number": "१-९४-१९", "content_sanskrit": "धर्मशास्त्रं चार्थशास्त्रं वेदांतं ज्योतिषं तथा ।\nवंशाख्यानं प्रकरणात् स्तोत्राणि मनवस्तथा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001708019, "chapter_id": 21708, "verse_number": "१-९४-२०", "content_sanskrit": "नानाविद्यास्तथा प्रोक्ताः सर्वलोकोपकारिकाः ।\nएतद्विष्णुपुराणं वै सर्वशास्त्रार्थसंग्रहम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001708020, "chapter_id": 21708, "verse_number": "१-९४-२१", "content_sanskrit": "वाराहकल्पवृत्तांतं व्यासेन कथितं त्विह ।\nयो नरः पठते भक्त्या यः श्रृणोति च सादरम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001708021, "chapter_id": 21708, "verse_number": "१-९४-२२", "content_sanskrit": "तावुभौ विष्णुलोकं हि व्रजेतां भुक्तभोगकौ ।\nतल्लिखित्वा च यो दद्यादाषाढ्यां घृतधेनुना ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001708022, "chapter_id": 21708, "verse_number": "१-९४-२३", "content_sanskrit": "सहितं विणुभक्ताय पुराणार्थविदेद्विज ।\nस याति वैष्णवं धाम विमानेनार्कवर्चसा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001708023, "chapter_id": 21708, "verse_number": "१-९४-२४", "content_sanskrit": "यश्च विष्णुपुराणस्य समनुक्रमणीं द्विज ।\nकथयेच्छृणुयाद्वापि स पुराणफलं लभेत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]