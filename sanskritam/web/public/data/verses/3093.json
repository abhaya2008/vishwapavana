[{"id": 2097769, "chapter_id": 3093, "verse_number": "१३-२२३-१", "content_sanskrit": "उमोवाच।\nभगवन्मानुषेष्वेव मानुषाः समदर्शनाः।\nचण्डाला इव दृश्यन्ते स्पर्शमात्रविदूषिताइः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2097770, "chapter_id": 3093, "verse_number": "१३-२२३-२", "content_sanskrit": "नीचकर्मरता देव सर्वेषां मलहारकाः।\nदुर्गताः क्लेशभूयिष्ठा विरूपा दुष्टचेतसः।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2097771, "chapter_id": 3093, "verse_number": "१३-२२३-३x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2097772, "chapter_id": 3093, "verse_number": "१३-२२३-३", "content_sanskrit": "तदहं ते प्रवक्ष्यामि तदेकाग्रमनाः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2097773, "chapter_id": 3093, "verse_number": "१३-२२३-४", "content_sanskrit": "ये पुरा मनुजा देवि अतिमानयुता भृशम्।\nआत्मसम्भावनायुक्ताः स्तब्धा दर्पसमन्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2097774, "chapter_id": 3093, "verse_number": "१३-२२३-५", "content_sanskrit": "प्रणामं तु न कुर्वन्ति गुरूणामपि पामराः।\nये स्वधर्मार्पणं कार्यमतिमानान्न कुर्वते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2097775, "chapter_id": 3093, "verse_number": "१३-२२३-६", "content_sanskrit": "परान्संनामयन्त्येव आज्ञयात्मनि ये बलात्।\nऋद्धियोगात्परान्नित्यमवमन्यन्ति मानवान्।\nपानपाः सर्वभक्षाश्च परुषाः कटुका नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2097776, "chapter_id": 3093, "verse_number": "१३-२२३-७", "content_sanskrit": "एवंयुक्तसमाचाराक दण्डिता यमशासनैः।\nकथंचित्प्राप्य मानुष्यं चण्डालाः सम्भवन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2097777, "chapter_id": 3093, "verse_number": "१३-२२३-८", "content_sanskrit": "नीचकर्मरताश्चैव सर्वेषां मलहारकाः।\nपरेषां वन्दनपरास्ते भवन्त्येव मानिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2097778, "chapter_id": 3093, "verse_number": "१३-२२३-९", "content_sanskrit": "विरूपाः पापयोनिस्थाः स्पर्शनादिविवर्जिताः।\nकुवृत्तिमुपजीवन्ति भुत्वा ते रजकादयः।\nपुराऽतिमानदोषात्तु भुञ्जते स्वकृतं फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2097779, "chapter_id": 3093, "verse_number": "१३-२२३-१०", "content_sanskrit": "तानप्यवस्ताकृपणांश्चण्डालानपि बुद्धिमान्।\nन च निन्देन्नापि कुप्येद्भुञ्जते स्वकृतं फलम्।\nचण्डाला अपि तां जातिं शोचन्तः शुद्धिमाप्नुयुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2097780, "chapter_id": 3093, "verse_number": "१३-२२३-११x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2097781, "chapter_id": 3093, "verse_number": "१३-२२३-११", "content_sanskrit": "भगवन्मानुषाः केचिदाशापाशशतैर्वृताः।\nपरेषां द्वारि तिष्ठन्ति प्रतिषिद्धाः प्रवेशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2097782, "chapter_id": 3093, "verse_number": "१३-२२३-१२", "content_sanskrit": "द्रष्टुं ज्ञापयितुं चैव न लभन्ते च यत्नतः।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2097783, "chapter_id": 3093, "verse_number": "१३-२२३-१३x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2097784, "chapter_id": 3093, "verse_number": "१३-२२३-१३", "content_sanskrit": "ये पुरा मानुषा देवि ऐश्वर्यस्थानसंयुताः।\nसंवादं तु न कुर्वन्ति परैरैश्वर्यमोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2097785, "chapter_id": 3093, "verse_number": "१३-२२३-१४", "content_sanskrit": "द्वाराणि न ददत्येव लोभमोहादिभिर्वृताः।\nअवस्थामोहसंयुक्ताः स्वार्थमात्रपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2097786, "chapter_id": 3093, "verse_number": "१३-२२३-१५", "content_sanskrit": "सर्वभोगयुता वाऽपि सर्वेषां निष्फला भृशम्।\nअपि शक्ता न कुर्युस्ते परानुग्रहकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2097787, "chapter_id": 3093, "verse_number": "१३-२२३-१६", "content_sanskrit": "निर्दयाश्चैव निर्द्वारा भोगैश्वर्यगतिं प्रति।\nएवंयुक्तसमाचाराः पुनर्जन्मनि शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2097788, "chapter_id": 3093, "verse_number": "१३-२२३-१७", "content_sanskrit": "यदि चेन्मानुषं जन्म लभेरंस्ते तथाविधाः।\nदुर्गता दुरवस्थाश्च कर्मव्याक्षेपसंयुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2097789, "chapter_id": 3093, "verse_number": "१३-२२३-१८", "content_sanskrit": "अभिधावन्ति ते सर्वे तमर्थमभिवेदिनः।\nराज्ञां वा राजमात्राणां द्वारि तिष्ठन्ति वारिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2097790, "chapter_id": 3093, "verse_number": "१३-२२३-१९", "content_sanskrit": "कर्म विज्ञापितुं द्रष्टुं न लभन्ते कथञ्चन।\nप्रवेष्टुमपि ते द्वारं बहिस्तिष्ठन्ति काङ्क्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2097791, "chapter_id": 3093, "verse_number": "१३-२२३-२०x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2097792, "chapter_id": 3093, "verse_number": "१३-२२३-२०", "content_sanskrit": "भगवन्मानुषाः केचिन्मनुष्येषु बहुष्वपि।\nसहसा नष्टसर्वस्वा भ्रष्टकोशपरिग्रहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2097793, "chapter_id": 3093, "verse_number": "१३-२२३-२१", "content_sanskrit": "दृश्यन्ते मानुषाः केचिद्राजचोरोदकादिभिः।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2097794, "chapter_id": 3093, "verse_number": "१३-२२३-२२x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2097795, "chapter_id": 3093, "verse_number": "१३-२२३-२२", "content_sanskrit": "ये पुरा मानुषा देवि आसुरं भावमाश्रिताः।\nपरेषां वृत्तिनाशं तु कुर्वते द्वेषलोभतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2097796, "chapter_id": 3093, "verse_number": "१३-२२३-२३", "content_sanskrit": "उत्कोचनपराश्चैव पिशुनाश्च तथाविधाः।\nपरद्रव्यहरा घोराश्चौर्याद्वाऽन्येन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2097797, "chapter_id": 3093, "verse_number": "१३-२२३-२४", "content_sanskrit": "निर्दया निरनुक्रोशाः परेषां वृत्तिनाशकाः।\nनास्तिकाऽनृतभूयिष्ठाः परद्रव्यापहारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2097798, "chapter_id": 3093, "verse_number": "१३-२२३-२५", "content_sanskrit": "एवंयुक्तसमाचारा दण्डिता यमशासनैः।\nनिरयस्थाश्चिरं कालं तत्र दुःखसमन्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2097799, "chapter_id": 3093, "verse_number": "१३-२२३-२६", "content_sanskrit": "यदि चेन्मानुषं जन्म लभेरंस्ते तथाविधाः।\nतत्रस्थाः प्राप्नुवन्त्येव सहसा द्रव्यवाशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2097800, "chapter_id": 3093, "verse_number": "१३-२२३-२७", "content_sanskrit": "कष्टं तत्प्राप्नुवन्त्येव कारणाकारणादपि।\nनाशं विनाशं द्रव्याणामुपघातं च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2097801, "chapter_id": 3093, "verse_number": "१३-२२३-२८x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2097802, "chapter_id": 3093, "verse_number": "१३-२२३-२८", "content_sanskrit": "भगवन्मानुषाः केचिद्बान्धवैः सहसा पृथक्।\nकारणादेव सहसा सर्वेषां प्राणनाशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2097803, "chapter_id": 3093, "verse_number": "१३-२२३-२९", "content_sanskrit": "शस्त्रेण वाऽन्यथा वाऽपि प्राप्नुवन्ति वधं नराः।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2097804, "chapter_id": 3093, "verse_number": "१३-२२३-३०x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2097805, "chapter_id": 3093, "verse_number": "१३-२२३-३०", "content_sanskrit": "ये पुरा मनुजा देवि घोरकर्मरतानृताः।\nआसुराः प्रायशो मूर्खाः प्राणिहिंसाप्रिया भृशं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2097806, "chapter_id": 3093, "verse_number": "१३-२२३-३१", "content_sanskrit": "निर्दयाः प्राणिहिंसायां तथा प्राणिविघातकाः।\nविश्वस्तघातकाश्चैव तथा सुप्तविघातकाः।\nप्रायशोऽनृतभूयिष्ठा नास्तिका मांसभोजनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2097807, "chapter_id": 3093, "verse_number": "१३-२२३-३२", "content_sanskrit": "एवंयुक्तसमाचाराः कालधर्मं गताः पुनः।\nदण्डिता यमदण्डेन निरयस्थाश्चिरं प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2097808, "chapter_id": 3093, "verse_number": "१३-२२३-३३", "content_sanskrit": "तिर्यग्योनिं पुनः प्राप्य तत्र दुःखपरिक्षयात्।\nयदि चेन्मानुपं जन्म लभेरंस्ते तथाविधाः।\nतत्र ते प्राप्नुवन्त्येव वधबन्धान्यथा तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2097809, "chapter_id": 3093, "verse_number": "१३-२२३-३४", "content_sanskrit": "आढ्या वा दुर्गता वाऽपि भुञ्जते स्वकृतं फलम्।\nसुप्ता मत्ताश्च विश्वस्तास्तथा ते प्राप्नुवन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2097810, "chapter_id": 3093, "verse_number": "१३-२२३-३५", "content_sanskrit": "प्राणवाधकृतं दुःखं बान्धवैः सहसा पृथक्।\nपुत्रदारविनाशं वा शस्त्रेणान्येन वा वधम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2097811, "chapter_id": 3093, "verse_number": "१३-२२३-३६x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2097812, "chapter_id": 3093, "verse_number": "१३-२२३-३६", "content_sanskrit": "भगवन्मानुषाः केचिद्राजनीतिविशार दैः।\nदण्ड्यन्ते मानुषे लोके मानुषाः सर्वतोभयाः।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2097813, "chapter_id": 3093, "verse_number": "१३-२२३-३७x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2097814, "chapter_id": 3093, "verse_number": "१३-२२३-३७", "content_sanskrit": "ये पुरा मनुजा देवि मानुषांश्चेतराणि वा।\nक्लिष्टघातेन निघ्नन्ति प्राणान्प्राणिषु निर्दयाः।\nआसुर घोरकर्माणः क्रूरदण्डवधप्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2097815, "chapter_id": 3093, "verse_number": "१३-२२३-३८", "content_sanskrit": "ये दण्डयन्त्यदण्ड्यांश्च राजानः कोपमोहिताः।\nहिंसाहङ्कारपरुषा मांसादा नास्तिकाशुभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2097816, "chapter_id": 3093, "verse_number": "१३-२२३-३९", "content_sanskrit": "केचित्स्त्रीपुरुषघ्नाश्च गुरुघ्नाश्च तथा प्रिये।\nएवंयुक्तसमाचारा प्राणिधर्मं गताः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2097817, "chapter_id": 3093, "verse_number": "१३-२२३-४०", "content_sanskrit": "दण्डिता यमदण्डेन निरयस्थाश्चिरं प्रिये।\nपूर्वजन्मकृतं कर्म भुञ्जते तदिह प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2097818, "chapter_id": 3093, "verse_number": "१३-२२३-४१", "content_sanskrit": "इहैव यत्कर्म कृतं तत्परत्र फलत्युत।\nएषा व्यवस्थितिर्देवि मानुषेष्वेव दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2097819, "chapter_id": 3093, "verse_number": "१३-२२३-४२", "content_sanskrit": "न चर्षीणां न देवानाममृतत्वात्तपोबलात्।\nतैरेकेन शरीरेण भुज्यते कर्मणः फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2097820, "chapter_id": 3093, "verse_number": "१३-२२३-४३", "content_sanskrit": "न तथा मानुषाणां स्यादन्तर्धाय भवेद्धि तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2097821, "chapter_id": 3093, "verse_number": "१३-२२३-४४x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2097822, "chapter_id": 3093, "verse_number": "१३-२२३-४४", "content_sanskrit": "किमर्थं मानुषा लोके दण्ड्यन्ते पृथिवीश्वरैः।\nकृतापराधमुद्दिश्य हन्ता हर्ताऽयमित्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2097823, "chapter_id": 3093, "verse_number": "१३-२२३-४५", "content_sanskrit": "पुत्रार्थी पुत्रकामेष्ट्या इहैव लभते सुतान्।\nतैरेव हि शरीरेण भुञ्जन्ते कर्मणां फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2097824, "chapter_id": 3093, "verse_number": "१३-२२३-४६", "content_sanskrit": "दृश्यन्ते मानुषे लोके तद्भवान्नानुमन्यते।\nएतन्मे संशयस्थानं तन्मे त्वं छेत्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2097825, "chapter_id": 3093, "verse_number": "१३-२२३-४७x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2097826, "chapter_id": 3093, "verse_number": "१३-२२३-४७", "content_sanskrit": "स्थाने संशयितं देवि तत्त्वं शृणु समाहिता।\nकर्म कर्मफलं चेति युगपद्भुवि नेष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2097827, "chapter_id": 3093, "verse_number": "१३-२२३-४८", "content_sanskrit": "ये त्वयाऽभिहिता देवि हन्ता हर्ताऽयमित्यपि।\nतेषां तत्पूर्वकं कर्म दण्ड्यते यत्र राजभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2097828, "chapter_id": 3093, "verse_number": "१३-२२३-४९", "content_sanskrit": "देवि कर्म कृतं चैषां हेतुर्भवति शासने।\nअपराधापरेशेन राजा दण्डयति प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2097829, "chapter_id": 3093, "verse_number": "१३-२२३-५०", "content_sanskrit": "इह लोके व्यवस्थार्थं राजभिर्दण्डनं स्मृतम्।\nउद्वेजनार्थं शेषाणामपराधं तमुद्दिशन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2097830, "chapter_id": 3093, "verse_number": "१३-२२३-५१", "content_sanskrit": "पुराकृतफलं दण्डो दण्ड्यमानस्य तद्ध्रुवम्।\nप्रागेव च मया प्रोक्तं तत्र निःसंशया भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2097831, "chapter_id": 3093, "verse_number": "१३-२२३-५२x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2097832, "chapter_id": 3093, "verse_number": "१३-२२३-५२", "content_sanskrit": "भगवन्भुवि मर्त्यानां दण्डितानां नरेश्वरैः।\nदण्डेनैव तु तेनेह पापनाशो भवेन्न वा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2097833, "chapter_id": 3093, "verse_number": "१३-२२३-५३", "content_sanskrit": "एतन्मया संशयितं तद्भवांश्छेत्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2097834, "chapter_id": 3093, "verse_number": "१३-२२३-५३x", "content_sanskrit": "महेश्वर उवाच।\nस्थाने संशयितं देवि शृणु तत्वं समाहिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2097835, "chapter_id": 3093, "verse_number": "१३-२२३-५४", "content_sanskrit": "ये नृपैर्दण्डिता भूमावपराधापदेशतः।\nयमलोके न दण्ड्यन्ते तत्र ते यमदण्डनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2097836, "chapter_id": 3093, "verse_number": "१३-२२३-५५", "content_sanskrit": "अदण्डिता वा ये मिथ्या मिथ्या वा दण्डिता भुवि।\nतान्यमो दण्डयत्येव स हि वेद कृताकृतम्।\nनातिक्रमेद्यमं कश्चित्कर्म कृत्वेह मानुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2097837, "chapter_id": 3093, "verse_number": "१३-२२३-५६", "content_sanskrit": "राजा यमश्च कुर्वाते दण्डमात्रं तु शोभने।\nउभाभ्यां यमराजभ्यां दण्डितोऽदण्डितोपि वा।\nपश्चात्कर्मफलं भुङ्क्ते नरके मानुषेषु वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2097838, "chapter_id": 3093, "verse_number": "१३-२२३-५७", "content_sanskrit": "नास्ति कर्मफलच्छेत्ता कश्चिल्लोकत्रयेऽपि च।\nइति ते कथितं सर्वं निर्विशङ्का भव प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2097839, "chapter_id": 3093, "verse_number": "१३-२२३-५८x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2097840, "chapter_id": 3093, "verse_number": "१३-२२३-५८", "content_sanskrit": "किमर्थं दुष्कृतं कृत्वा मानुषा भुवि नित्यशः।\nपुनस्तत्कर्मनाशाय प्रायश्चित्तानि कुर्वते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2097841, "chapter_id": 3093, "verse_number": "१३-२२३-५९", "content_sanskrit": "सर्वपापहरं चेति हयमेधं वदन्ति च।\nप्रायश्चित्तानि चान्यानि पापनाशाय कुर्वते।\nतस्मान्मया संशयितं त्वं तच्छेत्तुमिहार्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2097842, "chapter_id": 3093, "verse_number": "१३-२२३-६०x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2097843, "chapter_id": 3093, "verse_number": "१३-२२३-६०", "content_sanskrit": "स्थाने संशयितं देवि शृणु तत्वं समाहिता।\nसंशयो हि महानेव पूर्वेषां च मनीषिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2097844, "chapter_id": 3093, "verse_number": "१३-२२३-६१", "content_sanskrit": "द्विधा तु क्रियते पापं सद्भिश्चासद्भिरेव च।\nअभिसन्धाय वा नित्यमन्यथा वा यदृच्छया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2097845, "chapter_id": 3093, "verse_number": "१३-२२३-६२", "content_sanskrit": "केवलं चाभिसन्धाय संरम्भाच्च करोति यत्।\nकर्मणस्तस्य नाशस्तु न कथंचन विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2097846, "chapter_id": 3093, "verse_number": "१३-२२३-६३", "content_sanskrit": "अभिसन्धिकृतस्यैव नैव नाशोस्ति कर्मणः।\nअश्वमेधसहस्रैश्च प्रायश्चित्तशतैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2097847, "chapter_id": 3093, "verse_number": "१३-२२३-६४", "content_sanskrit": "अन्यथा यत्कृतं पापं प्रमादाद्वा यदृच्छया।\nप्रायश्चित्ताश्वमेधाब्यां श्रेयसा तत्प्रणश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2097848, "chapter_id": 3093, "verse_number": "१३-२२३-६५", "content_sanskrit": "लोकसंव्यवहारार्थं प्रायश्चित्तादिरिष्यते।\nविद्ध्येवं पापके कार्ये निर्विशङ्का भव प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2097849, "chapter_id": 3093, "verse_number": "१३-२२३-६६", "content_sanskrit": "इति ते कथितं देवि भूयः श्रोतुं किमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2097850, "chapter_id": 3093, "verse_number": "१३-२२३-६७x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2097851, "chapter_id": 3093, "verse_number": "१३-२२३-६७", "content_sanskrit": "भगवन्देवदेवेश मानुषाश्चेतरा अपि।\nम्रियन्ते मानुषा लोके कारणाकारणादपि।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2097852, "chapter_id": 3093, "verse_number": "१३-२२३-६८x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2097853, "chapter_id": 3093, "verse_number": "१३-२२३-६८", "content_sanskrit": "ये पुरा मनुजा देवि कारणाकारणादपि।\nयथाऽसुभिर्वियुज्यन्ते प्राणिनः प्राणिनिर्दर्यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2097854, "chapter_id": 3093, "verse_number": "१३-२२३-६९", "content_sanskrit": "तथैव ते प्राप्नुवन्ति यथैवात्मकृतं फलम्।\nविषदास्तु विषेणैव शस्त्रैः शस्त्रेण घातकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2097855, "chapter_id": 3093, "verse_number": "१३-२२३-७०", "content_sanskrit": "एवमेव यथा लोके मानुषान्घ्नन्ति मानुषाः।\nकारणेनैव तेनाथ तता स्वप्राणनाशनम्।\nप्राप्नुवन्ति पुनर्देवि नास्ति तत्र विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2097856, "chapter_id": 3093, "verse_number": "१३-२२३-७१", "content_sanskrit": "इति ते कथितं सर्वं कर्मपाकफलं प्रिये।\nभूयस्तव समासेन कथयिष्यामि तच्छृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2097857, "chapter_id": 3093, "verse_number": "१३-२२३-७२", "content_sanskrit": "सत्यप्रमाणकरणान्नित्यमव्यभिचारि च।\nयैः पुरा मनुजैर्देवि यस्मिन्काले यथा कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2097858, "chapter_id": 3093, "verse_number": "१३-२२३-७३", "content_sanskrit": "येनैव कारणेनापि कर्म यत्तु शुभाशुभम्।\nतस्मन्काले तथा देवि कारणेनैव तेन तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2097859, "chapter_id": 3093, "verse_number": "१३-२२३-७४", "content_sanskrit": "प्राप्नुवन्ति नराः प्रेत्य निःसन्देहं शुभाशुभम्।\nइति सत्यं प्रजानीहि लोके तत्र विधिं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2097860, "chapter_id": 3093, "verse_number": "१३-२२३-७५", "content_sanskrit": "कर्मकर्ता नरो भोक्ता स नास्ति दिवि वा भुवि।\nन शक्यं कर्म चाभोक्तुं सदेवासुरमानुषैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2097861, "chapter_id": 3093, "verse_number": "१३-२२३-७६", "content_sanskrit": "कर्मणा ग्रथितो लोक आदिप्रभृति वर्तते।\nएतदुद्देशतः प्रोक्तं कर्मपाकफलं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2097862, "chapter_id": 3093, "verse_number": "१३-२२३-७७", "content_sanskrit": "यदन्यच्च मया नोक्तं यस्मिंस्ते कर्मसङ्ग्रहे।\nबुद्धितर्केण तत्सर्वं तथा वेदितुमर्हसि।\nकथितं श्रोतुकामाया भूयः श्रोतुं किमिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2097863, "chapter_id": 3093, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि त्रयोविंशत्यधिकद्विशततमोऽध्यायः॥ २२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}]