[{"id": 2092594, "chapter_id": 2970, "verse_number": "१३-१००-१", "content_sanskrit": "भीष्म उवाच।\nसर्वान्कामान्प्रयच्छन्ति ये प्रयच्छन्ति काञ्चनम्।\nइत्येवं भगवानत्रिः पितामहसुतोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2092595, "chapter_id": 2970, "verse_number": "१३-१००-२", "content_sanskrit": "पवित्रं शुच्यथायुष्यं पितृणामक्ष्यं च तत्।\nसुवर्णं मनुजेन्द्रेण हरिश्चन्द्रेण कीर्तितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2092596, "chapter_id": 2970, "verse_number": "१३-१००-३", "content_sanskrit": "पानीयपरमं दानं दानानां मनुरब्रवीत्।\nतस्मात्कूपांश्च वापीश्च तटाकानि च स्वानयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2092597, "chapter_id": 2970, "verse_number": "१३-१००-४", "content_sanskrit": "सर्वं विनाशयेत्पापं पुरुषस्येह कर्मणः।\nकूपः प्रवृत्तपानीयः सुप्रवृत्तश्च नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2092598, "chapter_id": 2970, "verse_number": "१३-१००-५", "content_sanskrit": "सर्वं तारयते वंशं यस्य खाते जलाशये।\nगावः पिबन्ति विप्राश्च साधवश्च नराः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2092599, "chapter_id": 2970, "verse_number": "१३-१००-६", "content_sanskrit": "निदाघकाले पानीयं यस्य तिष्ठत्यवारितम्।\nस दुर्गं विषमं कृत्स्नं न कदाचिदवाप्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2092600, "chapter_id": 2970, "verse_number": "१३-१००-७", "content_sanskrit": "बृहस्पतेर्भगवतः पूष्णश्चैव भगस्य च।\nअश्विनोश्चैव वह्नेश्च प्रीतिर्भवति सर्पिषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2092601, "chapter_id": 2970, "verse_number": "१३-१००-८", "content_sanskrit": "परमं भेषजं ह्येतद्यज्ञानामेतदुत्तमम्।\nरसानामुत्तमं चैतत्फलानां चैतदुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2092602, "chapter_id": 2970, "verse_number": "१३-१००-९", "content_sanskrit": "फलकामो यशस्कामः पुष्टिकामश्च नित्यदा।\nघृतं दद्याद्द्विजातिभ्यः पुरुषः शुचिरात्मवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2092603, "chapter_id": 2970, "verse_number": "१३-१००-१०", "content_sanskrit": "घृतं मासे आश्वयुजि विप्रभ्यो यः प्रयच्छति।\nतस्मै प्रयच्छतो रूपं प्रीतौ देवाविहाश्विनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2092604, "chapter_id": 2970, "verse_number": "१३-१००-११", "content_sanskrit": "पायसं सर्पिषा मिश्रं द्विजेभ्यो यः प्रयच्छति।\nगृहं तस्य न रक्षांसि धर्षयन्ति कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2092605, "chapter_id": 2970, "verse_number": "१३-१००-१२", "content_sanskrit": "पिपासया न म्रियते सोपच्छन्दश्च जायते।\nन प्राप्नुयाच्च व्यसनं करकान्यः प्रयच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2092606, "chapter_id": 2970, "verse_number": "१३-१००-१३", "content_sanskrit": "प्रयतो ब्राह्मणाग्रे यः श्रद्धया परया युतः।\nउपस्पर्शनषड्भागं लभते पुरुषः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2092607, "chapter_id": 2970, "verse_number": "१३-१००-१४", "content_sanskrit": "यः साधनार्थं काष्ठानि ब्राह्मणेभ्यः प्रयच्छति।\nप्रतापनार्थं राजेन्द्र वृत्तवद्भ्यः सदा नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2092608, "chapter_id": 2970, "verse_number": "१३-१००-१५", "content_sanskrit": "सिद्ध्यन्त्यर्थाः सदा तस्य कार्याणि विविधानि च।\nउपर्युपरि शत्रूणां वपुषा दीप्यते च सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2092609, "chapter_id": 2970, "verse_number": "१३-१००-१६", "content_sanskrit": "भगवांश्चापि सम्प्रतो वह्निर्भवति नित्यशः।\nन तं त्यजन्ति पशवः सङ्ग्रामे च जयत्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2092610, "chapter_id": 2970, "verse_number": "१३-१००-१७", "content_sanskrit": "पुत्राञ्श्रियं च लभते यश्छत्रं सम्प्रच्छति।\nन चक्षुर्व्याधिं लभते यज्ञभागमथाश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2092611, "chapter_id": 2970, "verse_number": "१३-१००-१८", "content_sanskrit": "निदाघकाले वर्षे वा यश्छत्रं सम्प्रयच्छति।\nनास्य कश्चिन्मनोदाहः कदाचिदपि जायते।\nकृच्छ्रात्स विषमाच्चैव क्षिप्रं मोक्षमवाप्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2092612, "chapter_id": 2970, "verse_number": "१३-१००-१९", "content_sanskrit": "प्रदानं सर्वदानानां शकटस्य विशाम्पते।\nएवमाह महाभागः शाण्डिल्यो भगवानृषिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2092613, "chapter_id": 2970, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि शततमोऽध्यायः॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]