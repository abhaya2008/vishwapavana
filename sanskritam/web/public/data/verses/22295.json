[{"id": 7002295000, "chapter_id": 22295, "verse_number": "३४०-१", "content_sanskrit": "अग्निरुवाच ।\nवाग्विद्यासम्प्रतिज्ञने रीतिः सापि चतुर्विधा ।\nपाञ्चली गौड़देशीया वैदर्भी लाटजा तथा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002295001, "chapter_id": 22295, "verse_number": "३४०-२", "content_sanskrit": "उपचारयुता मृद्वी पाञ्चाली ह्रस्वविग्रहा ।\nअनवस्थितसन्दर्भा गौडीया दीर्घविग्रहा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002295002, "chapter_id": 22295, "verse_number": "३४०-३", "content_sanskrit": "उपचारैर्न्न बहुभिरुपचारैर्विवर्ज्जिता ।\nनातिकोमलसन्दर्भा वैदर्भी मुक्तविंग्रहा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002295003, "chapter_id": 22295, "verse_number": "३४०-४", "content_sanskrit": "लाजीया स्फुजसन्दर्भा नातिविस्फुरविग्राहा ।\nपरित्यक्तापि भूयोभिरुपचारैरुदाहृता ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002295004, "chapter_id": 22295, "verse_number": "३४०-५", "content_sanskrit": "क्रियास्वविषमा वृत्तिर्भारत्यारभटी तथा ।\nकौशिकी सात्वती चैति सा चतुर्द्धा प्रतिष्ठिता ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002295005, "chapter_id": 22295, "verse_number": "३४०-६", "content_sanskrit": "वाक्प्रधाना नरप्राया स्त्रीयुक्ता प्राकृतोक्तिता ।\nभरतेन प्रणीतत्वात् भारती रीतिरुच्यते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002295006, "chapter_id": 22295, "verse_number": "३४०-७", "content_sanskrit": "चत्वार्य्यङ्गानि भारत्या वीथी प्रहसनन्तथा ।\nप्रस्तावना नाटकादेर्व्वीथ्यङ्गाश्च त्रयोदश ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002295007, "chapter_id": 22295, "verse_number": "३४०-८", "content_sanskrit": "उद्घातकं तथैव स्याल्लपितं स्याद्द्वितीयकम् ।\nअसत्प्रलापो वाक्श्रेणी नांनिका विपणन्तथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002295008, "chapter_id": 22295, "verse_number": "३४०-९", "content_sanskrit": "व्याहारस्रिमतञ्चैव छलावस्कन्दिते तथा ।\nगण्डोऽथ मृदवश्चैव त्रयोदशमथाचितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002295009, "chapter_id": 22295, "verse_number": "३४०-१०", "content_sanskrit": "तापसादेः प्रहसनं परिहासपरं वचः ।\nमायेन्द्रजालयुद्धादिबहुलारभटी स्मृता ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002295010, "chapter_id": 22295, "verse_number": "३४०-११", "content_sanskrit": "सङ्क्षिप्तकारपातौ च वस्तूत्थापनमेव च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]