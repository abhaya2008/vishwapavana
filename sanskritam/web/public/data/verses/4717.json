[{"id": 2175278, "chapter_id": 4717, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2175279, "chapter_id": 4717, "verse_number": "१", "content_sanskrit": "सा शप्ता तेन क्रुद्धेन विश्वामित्रेण धीमता ।\nतस्मिंस्तीर्थवरे शुभ्रे शोणितं समुपावहत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2175280, "chapter_id": 4717, "verse_number": "२", "content_sanskrit": "अथाजग्मुस्ततो राजन् राक्षसास्तत्र भारत ।\nततस्ते शोणितं सर्वे पिबन्तः समुपासते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2175281, "chapter_id": 4717, "verse_number": "३", "content_sanskrit": "तृप्ताश्च सुभृशं तेन सुखिनो विगतज्वराः ।\nनृत्यन्तश्च हसन्तश्च यथा स्वर्गजितो नराः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2175282, "chapter_id": 4717, "verse_number": "४", "content_sanskrit": "कस्यचित्त्वथ कालस्य ऋषयः सुतपोधनाः ।\nतीर्थयात्रां समाजग्मुः सरस्वत्यां महीपते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2175283, "chapter_id": 4717, "verse_number": "५", "content_sanskrit": "तेषु सर्वेषु तीर्थेषु आप्लुत्य मुनिपुङ्गवाः ।\nप्राप्य प्रीतिं परां चापि तपोलुब्धा विशारदाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2175284, "chapter_id": 4717, "verse_number": "६", "content_sanskrit": "प्रययुर्हि ततो राजन् येन तीर्थं तु तत् तदा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2175285, "chapter_id": 4717, "verse_number": "७", "content_sanskrit": "अथागम्य महाभागाः तत्तीर्थं दारुणं प्रभो ।\nदृष्ट्वा तोयं सरस्वत्याः शोणितेन समुत्थितम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2175286, "chapter_id": 4717, "verse_number": "८", "content_sanskrit": "पीयमानं च रक्षोभिः बहुभी राजसत्तम\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2175287, "chapter_id": 4717, "verse_number": "९", "content_sanskrit": "तान् दृष्ट्वा राक्षसान् राजन् मुनयः संशितव्रताः ।\nपरित्राणे सरस्वत्याः परं यत्नं प्रचक्रिरे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2175288, "chapter_id": 4717, "verse_number": "१०", "content_sanskrit": "ते तु सर्वे महाभागाः समागम्य महाव्रताः ।\nआहूय सरितां श्रेष्ठामिदं वचनमब्रवुन्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2175289, "chapter_id": 4717, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2175290, "chapter_id": 4717, "verse_number": "११", "content_sanskrit": "कारणं ब्रूहि कल्याणि किमर्थं ते ह्रदो ह्ययम् ।\nएवमग्राह्यतां यातः श्रुत्वा ध्यास्यामहे वयम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2175291, "chapter_id": 4717, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2175292, "chapter_id": 4717, "verse_number": "१२", "content_sanskrit": "ततः सा सर्वमाचष्ट यथावृत्तं प्रवेपती ।\nदुःखितामथ तां दृष्ट्वा त ऊचुर्वै तपोधनाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2175293, "chapter_id": 4717, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2175294, "chapter_id": 4717, "verse_number": "१३", "content_sanskrit": "कारणं श्रुतमस्माभिः शापश्चैव श्रुतोऽनघे ।\nकरिष्यामस्तु यत्प्राप्तं सर्व एव तपोधनाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2175295, "chapter_id": 4717, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2175296, "chapter_id": 4717, "verse_number": "१४", "content_sanskrit": "एवमुक्त्वा सरिच्छ्रेष्ठामूचुस्तेऽथ परस्परम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2175297, "chapter_id": 4717, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2175298, "chapter_id": 4717, "verse_number": "१५", "content_sanskrit": "विमोक्षयामहे सर्वे शापादेनां सरस्वतीम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2175299, "chapter_id": 4717, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2175300, "chapter_id": 4717, "verse_number": "१६", "content_sanskrit": "ते सर्वे ब्राह्मणा राजंस्तपोभिर्नियमैस्तथा ।\nउपवासैश्च विविधैर्यमैः कष्टव्रतैस्तथा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2175301, "chapter_id": 4717, "verse_number": "१७", "content_sanskrit": "आराध्य पशुभर्तारं महादेवं जगत्पतिम् ।\nमोक्षयामासुस्तां देवीं सरिच्छ्रेष्ठां सरस्वतीम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2175302, "chapter_id": 4717, "verse_number": "१८", "content_sanskrit": "तेषां तु सा प्रभावेण प्रकृतिस्था सरस्वती ।\nप्रसन्नसलिला जज्ञे यथा पूर्वं तथैव हि ।\nनिर्मुक्ता च सरिच्छ्रेष्ठा विबभौ सा यथा पुरा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2175303, "chapter_id": 4717, "verse_number": "१९", "content_sanskrit": "दृष्ट्वा तोयं सरस्वत्या मुनिभिस्तैस्तथा कृतम् ।\nतानेव शरणं जग्मू राक्षसाः क्षुधितास्तथा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2175304, "chapter_id": 4717, "verse_number": "२०", "content_sanskrit": "कृत्वाञ्जलिं ततो राजन् राक्षसाः क्षुधयाऽर्दिताः ।\nऊचुस्तान् वै मुनीन् सर्वान् कृपायुक्तान् पुनः पुनः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2175305, "chapter_id": 4717, "verse_number": "२१", "content_sanskrit": "वयं च क्षुधिताश्चैव धर्माद्धीनाश्च शाश्वतात् ।\nन च नः कामकारोऽयं यद्वयं पापकारिणा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2175306, "chapter_id": 4717, "verse_number": "२२", "content_sanskrit": "युष्माकं चाप्रसादेन दुष्कृतेन च कर्मणा ।\nपक्षोऽयं वर्धतेऽस्माकं यतः स्मो ब्रह्मराक्षसाः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2175307, "chapter_id": 4717, "verse_number": "२३", "content_sanskrit": "योषितां चैव पापेन योनिदोषकृतेन च\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2175308, "chapter_id": 4717, "verse_number": "२४", "content_sanskrit": "एवं हि वैश्यशूद्राणां क्षत्रियाणां तथैव च ।\nये ब्राह्मणान् प्रद्विषन्ति ते भवन्तीह राक्षसाः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2175309, "chapter_id": 4717, "verse_number": "२५", "content_sanskrit": "शक्तिमन्तोऽपि ये केचिदाश्रितानां च रक्षणम् ।\nन कुर्वन्ति मनुष्यास्ते सम्भवन्तीह राक्षसाः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2175310, "chapter_id": 4717, "verse_number": "२६", "content_sanskrit": "आचार्यमृत्विजं चैव गुरुं वृद्धजनं तथा ।\nप्राणिनो येऽवमन्यन्ते ते भवन्तीह राक्षसाः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2175311, "chapter_id": 4717, "verse_number": "२७", "content_sanskrit": "तत्कुरुध्वमिहास्माकं तारणं द्विजसत्तमाः ।\nशक्ता भवन्तः सर्वेषां लोकानामपि तारणे\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2175312, "chapter_id": 4717, "verse_number": "२८", "content_sanskrit": "तेषां तु वचनं श्रुत्वा तुष्टुवुस्तां महानदीम् ।\nमोक्षार्थं रक्षसां तेषामूचुः प्रयतमानसाः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2175313, "chapter_id": 4717, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2175314, "chapter_id": 4717, "verse_number": "२९", "content_sanskrit": "हुतं कीटावपन्नं च यच्चोच्छिष्टाचितं भवेत् ।\nसकेशमवधूतं च रुदितोपहतं च यत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2175315, "chapter_id": 4717, "verse_number": "३०", "content_sanskrit": "श्वभिः संसृष्टमन्नं च भागोऽसौ रक्षसामिह ।\nतस्माज्ज्ञात्वा सदा विद्वानेतान् यत्नाद् विवर्जयेत् ।\nराक्षसान्नमसौ भुङ्क्ते यो भुङ्क्ते ह्यन्नमीदृशम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2175316, "chapter_id": 4717, "verse_number": "३१", "content_sanskrit": "शोधयित्वा ततस्तीर्थमृषयस्ते तपोधनाः ।\nमोक्षार्थं राक्षसानां च नदीं तां प्रत्यचोदयन्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2175317, "chapter_id": 4717, "verse_number": "३२", "content_sanskrit": "महर्षीणां मतं ज्ञात्वा ततः सा सरितां वरा ।\nअरुणामानयामास स्वां तनुं पुरुषर्षभ\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2175318, "chapter_id": 4717, "verse_number": "३३", "content_sanskrit": "तस्यान्ते राक्षसाः स्नात्वा तनूस्त्यक्त्वा दिवं गताः ।\nअरुणायां महाराज ब्रह्मवध्यापहा हि सा\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2175319, "chapter_id": 4717, "verse_number": "३४", "content_sanskrit": "एतमर्थमभिज्ञाय देवराजः शतक्रतुः ।\nतस्मिंस्तीर्थे वरे स्नात्वा विमुक्तः पाप्मना किल\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2175320, "chapter_id": 4717, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2175321, "chapter_id": 4717, "verse_number": "३५", "content_sanskrit": "किमर्थं भगवान् शक्रो ब्रह्मवध्यामवाप्तवान् ।\nकथमस्मिंश्च तीर्थे वै आप्लुत्याकल्मषोऽभवत्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2175322, "chapter_id": 4717, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2175323, "chapter_id": 4717, "verse_number": "३६", "content_sanskrit": "शृणुष्वैतदुपाख्यानं यथावृत्तं जनेश्वर ।\nयथा बिभेद समयं नमुचेर्वासवः पुरा\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2175324, "chapter_id": 4717, "verse_number": "३७", "content_sanskrit": "नमुचिर्वासवाद् भीतः सूर्यरश्मिं समाविशत् ।\nतेनेन्द्रः सख्यमकरोत् समयं चेदमब्रवीत्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2175325, "chapter_id": 4717, "verse_number": "३८", "content_sanskrit": "न चार्द्रेण न शुष्केण न रात्रौ नापि चाहनि ।\nवधिष्याम्यसुरश्रेष्ठ सखे सत्येन ते शपे\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2175326, "chapter_id": 4717, "verse_number": "३९", "content_sanskrit": "एवं स कृत्वा समयं सृ(दृ)ष्ट्वा नीहारमीश्वरः ।\nचिच्छेदास्य शिरो राजन्नपां फेनेन वासवः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2175327, "chapter_id": 4717, "verse_number": "४०", "content_sanskrit": "तच्छिरो नमुचेच्छिन्नं पृष्ठतः शक्रमन्वियात् ।\nभोभो मित्रह पापेति ब्रुवाणं शक्रमन्तिकात्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2175328, "chapter_id": 4717, "verse_number": "४१", "content_sanskrit": "एवं स शिरसा तेन चोद्यमानः पुनः पुनः ।\nपितामहाय सन्तप्त एतमर्थं न्यवेदयत्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2175329, "chapter_id": 4717, "verse_number": "४२", "content_sanskrit": "तमब्रवील्लोकगुरुररुणायां यथाविधि ।\nइष्ट्वोपस्पृह देवेन्द्र तीर्थे पापभयापहे\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2175330, "chapter_id": 4717, "verse_number": "४३", "content_sanskrit": "एषा पुण्यजला शक्र कृता मुनिभिरेव तु ।\nनिगूढमस्यागमनमिहासीत् पूर्वमेव तु\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2175331, "chapter_id": 4717, "verse_number": "४४", "content_sanskrit": "ततोऽभ्येत्यारुणां देवीं प्लावयामास वारिणा ।\nसरस्वत्यारुणायाश्च पुण्योऽयं सङ्गमो महान्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2175332, "chapter_id": 4717, "verse_number": "४५", "content_sanskrit": "इह त्वं यज देवेन्द्र दद दानान्यनेकशः ।\nअत्राप्लुत्य सुघोरात्त्वं पातकाद् विप्रमोक्ष्यसे\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2175333, "chapter_id": 4717, "verse_number": "४६", "content_sanskrit": "इत्युक्तः स सरस्वत्याः कुञ्जे वै जनमेजय ।\nइष्ट्वा यथावद् बलभिदरुणायामुपास्पृशत्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2175334, "chapter_id": 4717, "verse_number": "४७", "content_sanskrit": "स मुक्तः पाप्मना तेन ब्रह्मवध्याकृतेन च ।\nजगाम संहृष्टमनास्त्रिदिवं त्रिदशेश्वरः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2175335, "chapter_id": 4717, "verse_number": "४८", "content_sanskrit": "शिरस्तच्चापि नमुचेस्तत्रैवाप्लुत्य भारत ।\nलोकान् कामदुघान् प्राप्तमक्षयान् राजसत्तम\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2175336, "chapter_id": 4717, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2175337, "chapter_id": 4717, "verse_number": "४९", "content_sanskrit": "तत्राप्युपस्पृश्य बलो महात्मा\nदत्त्वा च दानानि पृथग्विधानि ।\nअवाप्य धर्मं परमार्यकर्मा\nजगाम सोमस्य महत्सुतीर्थम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2175338, "chapter_id": 4717, "verse_number": "५०", "content_sanskrit": "यत्रायजद् राजसूयेन सोमः\nसाक्षात् पुरा विधिवत् पार्थिवेन्द्र ।\nअत्रिर्धीमान् ब्रह्मपुत्रो बभूव\nहोता यस्मिन् क्रतुमुख्ये महात्मा\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2175339, "chapter_id": 4717, "verse_number": "५१", "content_sanskrit": "यस्यान्तेऽभूत्सुमहद् दानवानां\nदैतेयानां राक्षसानां च देवैः ।\nसङ्ग्रामो वै तारकाख्यः सुतीव्रो\nयत्र स्कन्दस्तारकाख्यं जघान\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2175340, "chapter_id": 4717, "verse_number": "५२", "content_sanskrit": "सैनापत्यं लब्धवान् दैवतानां\nमहासेनो यत्र दैत्यान्तकर्ता ।\nसाक्षाच्चैवं न्यवसत् कार्तिकेयः\nसदा कुमारो यत्र स प्लक्षराजः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2175341, "chapter_id": 4717, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि पञ्चदशोऽध्यायः ॥१५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]