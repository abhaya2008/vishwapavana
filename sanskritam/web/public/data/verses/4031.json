[{"id": 2140539, "chapter_id": 4031, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2140540, "chapter_id": 4031, "verse_number": "१", "content_sanskrit": "तं दृष्ट्वा क्लीबरूपेण रथस्थं रथिपुङ्गवम् ।\nशमीमभिमुखं यान्तं रथमारोप्य चोत्तरम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2140541, "chapter_id": 4031, "verse_number": "२", "content_sanskrit": "द्रोणभीष्मादयः शूराः कुरूणां रथिसत्तमाः ।\nवित्रस्तमनसश्चासन् धनञ्जयकृताद् भयात्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2140542, "chapter_id": 4031, "verse_number": "३", "content_sanskrit": "तानवेक्ष्य महोत्पातान् उत्पातानपि चाद्भुतान् ।\nगुरुः शस्त्रभृतां श्रेष्ठो भारद्वाजोऽभ्यभाषत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2140543, "chapter_id": 4031, "verse_number": "४", "content_sanskrit": "खराश्च वाताः संवान्ति रूक्षाः परुषनिस्वनाः ।\nभस्मवर्षप्रकाशेन तमसा संवृतं नभः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2140544, "chapter_id": 4031, "verse_number": "५", "content_sanskrit": "रूक्षवर्णाश्च जलदा दृश्यन्तेऽद्भुतदर्शनाः ।\nनिःसरन्ति च कोशेभ्यः शस्त्राणि विविधानि च\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2140545, "chapter_id": 4031, "verse_number": "६", "content_sanskrit": "शिवाश्च विनदन्त्येता दीप्तायां दिशि दक्षिणाः ।\nहयाश्चाश्रूणि मुञ्चन्ति ध्वजाः कम्पन्त्यकम्पिताः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2140546, "chapter_id": 4031, "verse_number": "७", "content_sanskrit": "यादृशानीह दृश्यन्ते रूपाणि विविधानि च ।\nएकैकमेषां पर्याप्तमखिलक्षयकारणम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2140547, "chapter_id": 4031, "verse_number": "८", "content_sanskrit": "एते भयं च तिष्ठन्ति युद्धं स्यात् समुपस्थितम् ।\nरक्षध्वमपि चात्मानं व्यूहध्वं वाहिनीमपि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2140548, "chapter_id": 4031, "verse_number": "९", "content_sanskrit": "वैशसं च प्रतीक्षध्वं रक्षध्वं चापि गोधनम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2140549, "chapter_id": 4031, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2140550, "chapter_id": 4031, "verse_number": "१०", "content_sanskrit": "एतावदुक्त्वा वचनं भीष्ममालोक्य चाब्रवीत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2140551, "chapter_id": 4031, "verse_number": "११", "content_sanskrit": "नदीज लङ्केशवनारिकेतुः नगाह्वयो नाम नगारिसूनुः ।\nगत्या सुरेशः क्वचिदङ्गनेव गुरुर्बभाषे वचनं तदानीम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2140552, "chapter_id": 4031, "verse_number": "१२", "content_sanskrit": "इत्युक्त्वा सञ्ज्ञया द्रोणः तूष्णीमासीद् विशाम्पते ।\nभारद्वाजवचः श्रुत्वा गाङ्गेयः सञ्ज्ञयाऽब्रवीत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2140553, "chapter_id": 4031, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2140554, "chapter_id": 4031, "verse_number": "१३", "content_sanskrit": "अतीतं चक्रमस्माकं विषयान्तरमागताः ।\nअतीतः समयश्चोक्तो ह्यस्माभिर्यत् सभातळे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2140555, "chapter_id": 4031, "verse_number": "१४", "content_sanskrit": "न भयं शत्रुतः कार्यं शङ्कां त्यज नरर्षभ\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2140556, "chapter_id": 4031, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2140557, "chapter_id": 4031, "verse_number": "१५", "content_sanskrit": "देवव्रतेनैवमुक्ते वचने हितकारिणा ।\nदुर्योधनमथालोक्य सञ्ज्ञया द्रोण अब्रवीत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2140558, "chapter_id": 4031, "verse_number": "१६", "content_sanskrit": "एष वीरो महेष्वासः सर्वशस्त्रभृतां वरः ।\nआगतः क्लीबरूपेण पार्थो नास्त्यत्र संशयः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2140559, "chapter_id": 4031, "verse_number": "१७", "content_sanskrit": "एष पार्थो हि विक्रान्तः सव्यसाची परन्तपः ।\nनाजित्वा विनिवर्तेत सर्वानपि मरुद्गणान्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2140560, "chapter_id": 4031, "verse_number": "१८", "content_sanskrit": "क्लेशितश्च वने शूरो वासवेन च शिक्षितः ।\nअमर्षवशमापन्नो योत्स्यते नात्र संशयः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2140561, "chapter_id": 4031, "verse_number": "१९", "content_sanskrit": "न ह्यस्य प्रतियोद्धारमन्यं पश्यामि कौरवम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2140562, "chapter_id": 4031, "verse_number": "२०", "content_sanskrit": "महादेवोपि पार्थेन श्रूयते युद्धतोषितः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2140563, "chapter_id": 4031, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2140564, "chapter_id": 4031, "verse_number": "२१", "content_sanskrit": "इत्येवंवादिनं द्रोणं कर्णः क्रुद्धोऽभ्यभाषत\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2140565, "chapter_id": 4031, "verse_number": "२२", "content_sanskrit": "सदा भवानर्जुनस्य गुणानस्मासु कत्थते ।\nन चार्जुनः किलापूर्णो मम दुर्योधनस्य च\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2140566, "chapter_id": 4031, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2140567, "chapter_id": 4031, "verse_number": "२३", "content_sanskrit": "यद्येष पार्थो राधेय कृतं कार्यं महन्मम ।\nज्ञाताः पुनश्चरिष्यन्ति द्वादशान्यांश्च वत्सरान्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2140568, "chapter_id": 4031, "verse_number": "२४", "content_sanskrit": "अथैष कश्चिदेवान्यः क्लीबरूपेण देवराट् ।\nशरैरेनं सुनिशितैः पातयिष्यामि भूतळे\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2140569, "chapter_id": 4031, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2140570, "chapter_id": 4031, "verse_number": "२५", "content_sanskrit": "तस्मिन् वदति तां वाचं धार्तराष्ट्रे परन्तपे ।\nभीष्मो द्रोणः कृपो द्रौणिः पौरुषं तदवमर्शताम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2140571, "chapter_id": 4031, "verse_number": "२६", "content_sanskrit": "तां शमीमभिसङ्गम्य पार्थो वैराटिमब्रवीत् ।\nसुखसंवर्धितं पित्रा समराणामकोविदम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2140572, "chapter_id": 4031, "verse_number": "२७", "content_sanskrit": "एहि भूमिञ्जयारुह्य वैराटे महतीं शमीम् ।\nसमादिष्टो मया क्षिप्रं धनुर्गाण्डीवमानय\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2140573, "chapter_id": 4031, "verse_number": "२८", "content_sanskrit": "अनेन धनुषा चेह सोढुं शक्ष्यन्ति मे बलम् ।\nनालं भारं गुरुं भर्तुं कुञ्जरं वा प्रमर्दितुम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2140574, "chapter_id": 4031, "verse_number": "२९", "content_sanskrit": "मम वा बाहुविक्षेपं शत्रूनिह विजेष्यतः ।\nनैभिः काममलं कर्तुं कर्म वैजयिकं त्विह\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2140575, "chapter_id": 4031, "verse_number": "३०", "content_sanskrit": "अतिसूक्ष्माणि ह्रस्वानि सर्वाणि च मृदूनि च ।\nआयुधानि महाबाहो तवैतानि परन्तप\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2140576, "chapter_id": 4031, "verse_number": "३१", "content_sanskrit": "तस्माद् भूमिञ्जयारोह शमीमेनां पलाशिनीम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2140577, "chapter_id": 4031, "verse_number": "३२", "content_sanskrit": "अस्माभिः पाण्डुपुत्राणां धनूंषि निहितान्युत ।\nयुधिष्ठिरस्य भीमस्य बीभत्सोर्यमयोस्तथा\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2140578, "chapter_id": 4031, "verse_number": "३३", "content_sanskrit": "ध्वजाः शराश्च शूराणां दिव्यानि कवचानि च\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2140579, "chapter_id": 4031, "verse_number": "३४", "content_sanskrit": "अत्र चैव महावीर्यं धनुः पार्थस्य गाण्डिवम् ।\nएकं शतसहस्रेण सम्मितं राष्ट्रवर्धनम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2140580, "chapter_id": 4031, "verse_number": "३५", "content_sanskrit": "व्यायामसहमत्यर्थं तृणराजसमं महत् ।\nसर्वायुधमहामात्रं सर्वारिक्षयकारणम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2140581, "chapter_id": 4031, "verse_number": "३६", "content_sanskrit": "सुवर्णविकृतं दिव्यं श्लक्ष्णमायतमव्रणम् ।\nअलं भारं गुरु चैतद् वारुणं चारुदर्शनम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2140582, "chapter_id": 4031, "verse_number": "३७", "content_sanskrit": "तादृशान्येव सर्वाणि दर्शनानि दृढानि च ।\nप्रधानानि निविष्टानि दुर्दर्शानि भवन्ति च\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2140583, "chapter_id": 4031, "verse_number": "", "content_sanskrit": "उत्तरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2140584, "chapter_id": 4031, "verse_number": "३८", "content_sanskrit": "शरीरमिव चासक्तं शम्यां शुष्कं पुरातनम् ।\nतदहं राजपुत्रः सन् स्पृशेयं पाणिना कथम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2140585, "chapter_id": 4031, "verse_number": "३९", "content_sanskrit": "न मामेवंविधं कर्म कारयस्व बृहन्नळे ।\nकथं वा शक्यते कर्तुं बुद्ध्या त्वं मन्यसे कथम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2140586, "chapter_id": 4031, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2140587, "chapter_id": 4031, "verse_number": "४०", "content_sanskrit": "तमुवाच ततः शूरः पार्थः परपुरञ्जयः ।\nदायादं सर्वमत्स्यानां कुले जातं विशारदम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2140588, "chapter_id": 4031, "verse_number": "४१", "content_sanskrit": "जानामि त्वां महाप्राज्ञ कुले जातं मनस्विनम् ।\nकथं नु पापकं कर्म ब्रूयां चाहं परन्तप\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2140589, "chapter_id": 4031, "verse_number": "४२", "content_sanskrit": "व्यवहार्यश्च राजेन्द्र शुद्धश्चैव भविष्यसि ।\nधनूंष्येतानि मा भैस्त्वं शरीरं नात्र विद्यते\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2140590, "chapter_id": 4031, "verse_number": "४३", "content_sanskrit": "दायादं मत्स्यराजस्य कुले जातं मनस्विनम् ।\nकथं वा निन्दितं कर्म्म कारये त्वां नृपात्मज\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2140591, "chapter_id": 4031, "verse_number": "४४", "content_sanskrit": "एवमुक्तः स पार्थेन रथात् प्रस्कन्द्य कुण्डली ।\nआरुरोह शमीवृक्षं वैराटिरवशस्तदा\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2140592, "chapter_id": 4031, "verse_number": "४५", "content_sanskrit": "तमन्वशासच्छत्रुघ्नो रथे तिष्ठन् धनञ्जयः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2140593, "chapter_id": 4031, "verse_number": "४६", "content_sanskrit": "परिवेष्टनमेतेषां सर्वं मुञ्चस्व मा चिरम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2140594, "chapter_id": 4031, "verse_number": "४७", "content_sanskrit": "तेषां सन्नहनीयानि विप्रमुच्य परन्तपः ।\nअपश्यत् तत्र गाण्डीवं चतुर्भिरपरैः सह\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2140595, "chapter_id": 4031, "verse_number": "४८", "content_sanskrit": "तेषां विमुच्यमानानां धनुषामर्कवर्चसाम् ।\nविनिश्चेरुः प्रभा दिव्या ग्रहाणामुदयेष्विव\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2140596, "chapter_id": 4031, "verse_number": "४९", "content_sanskrit": "स तेषां रूपमालोक्य भोगिनामिव जृम्भताम् ।\nहृष्टरोमा भयोद्विग्नः प्रवेपिततनुस्तदा\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2140597, "chapter_id": 4031, "verse_number": "५०", "content_sanskrit": "अर्जुनेन समाश्वस्तः किञ्चिद् धृष्टो नृपात्मजः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2140598, "chapter_id": 4031, "verse_number": "५१", "content_sanskrit": "आमील्य पुनरुन्मील्य स्पृष्ट्वा स्पृष्ट्वा चकार सः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2140599, "chapter_id": 4031, "verse_number": "५२", "content_sanskrit": "सम्यग् धृष्टस्तदाऽऽश्वस्तः क्षणेन समपद्यत\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2140600, "chapter_id": 4031, "verse_number": "५३", "content_sanskrit": "संस्पृश्य तानि चापानि भानुमन्ति बृहन्ति च ।\nवैराटिरर्जुनं राजन्निदं वचनमब्रवीत्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2140601, "chapter_id": 4031, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि एकोनचत्वारिंशोऽध्यायः ॥३९॥\nगोग्रहणपर्वणि द्वादशोऽध्यायः ॥१२॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]