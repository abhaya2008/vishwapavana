[{"id": 2139509, "chapter_id": 4015, "verse_number": "", "content_sanskrit": "द्रौपदी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2139510, "chapter_id": 4015, "verse_number": "१", "content_sanskrit": "अहं सैरन्ध्रिवेषेण वसन्ती राजवेश्मनि ।\nवशगाऽस्मि सुदेष्णाया ह्यक्षधूर्तस्य कारणात्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2139511, "chapter_id": 4015, "verse_number": "२", "content_sanskrit": "विक्रियां पश्य मे तीव्रां राजपुत्र्याः परन्तप ।\nआसे कालं परीक्षन्ती सर्वदुःखसहा पुनः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2139512, "chapter_id": 4015, "verse_number": "३", "content_sanskrit": "अनित्याः किल मर्त्यानामर्थाश्च व्यसनानि च ।\nचक्रवत् परिवर्तन्ते ह्यर्थाश्च व्यसनानि च\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2139513, "chapter_id": 4015, "verse_number": "समाप्तिः", "content_sanskrit": "इति मत्वा प्रतीक्षामि भर्तॄणामुदयं पुनः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2139514, "chapter_id": 4015, "verse_number": "५", "content_sanskrit": "य एव हेतुर्भवति पुरुषस्य जयावहः ।\nपराजये च हेतुः स इति च प्रतिपालये\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2139515, "chapter_id": 4015, "verse_number": "६", "content_sanskrit": "दत्त्वा याचन्ति पुरुषा हत्वा वध्यन्ति चापरे ।\nमानयित्वा न मान्यन्ते परैरिति च मे श्रुतम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2139516, "chapter_id": 4015, "verse_number": "७", "content_sanskrit": "न दैवस्यातिभारोऽस्ति न दैवस्यातिवर्तनम् ।\nइति मत्वाऽऽगमं भूयो दैवस्य प्रतिपालयेत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2139517, "chapter_id": 4015, "verse_number": "८", "content_sanskrit": "स्थितं पूर्वं जलं यत्र पुनस्तत्रैव तिष्ठति ।\nइति पर्यायमिच्छन्ती प्रतीच्छाम्युदयं पुनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2139518, "chapter_id": 4015, "verse_number": "९", "content_sanskrit": "दैवेन किल यस्यार्थः सुनीतोऽपि विपद्यते ।\nदैवस्यैवागमे यत्नः तेन कार्यो विजानता\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2139519, "chapter_id": 4015, "verse_number": "१०", "content_sanskrit": "किं नु मे वचनस्याद्य कथितस्य प्रयोजनम् ।\nपृच्छ मां दुःखितामेनां पृष्टा चात्र ब्रवीमि ते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2139520, "chapter_id": 4015, "verse_number": "११", "content_sanskrit": "महिषी पाण्डुपुत्राणां दुहिता द्रुपदस्य च ।\nइमामवस्थां सम्प्राप्ता का मदन्या जिजीविषेत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2139521, "chapter_id": 4015, "verse_number": "१२", "content_sanskrit": "कुरून् परिभवेत् सर्वान् पाञ्चालानपि भारत ।\nपाण्डवेयांश्च सम्प्राप्तो मम क्लेशो ह्यरिन्दम\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2139522, "chapter_id": 4015, "verse_number": "१३", "content_sanskrit": "भ्रातृभिः श्वशुरैः पुत्रैः बहुभिः परवीरहन् ।\nएवं समुदिता नारी का त्वेवं दुःखभागिनी\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2139523, "chapter_id": 4015, "verse_number": "१४", "content_sanskrit": "नूनं बालतया धातुर्मया वै विप्रियं कृतम् ।\nयस्य प्रभावाद् दुर्नीतं प्राप्ताऽस्मि भरतर्षभ\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2139524, "chapter_id": 4015, "verse_number": "१५", "content_sanskrit": "वर्ण(र्णं)विकारमपि मे पश्य पाण्डव पाण्डरम् ।\nईदृशो मे न तत्रासीद् दुःखे परमिते पुरा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2139525, "chapter_id": 4015, "verse_number": "१६", "content_sanskrit": "त्वमेव भीम जानीषे ह्यनुभूतं सुखं पुरा ।\nसाऽहं दासीत्वमापन्ना न शान्तिं मनसा लभे\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2139526, "chapter_id": 4015, "verse_number": "१७", "content_sanskrit": "न दैविकमिदं मन्ये यत्र पार्थो धनञ्जयः ।\nभीमधन्वा महारङ्गे चास्ते शान्त इवानलः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2139527, "chapter_id": 4015, "verse_number": "१८", "content_sanskrit": "अशक्या वेदितुं पार्थ प्राणिनां वै गतिर्नरैः ।\nविनिपातमिमं पश्य युष्माकमविचिन्तितम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2139528, "chapter_id": 4015, "verse_number": "१९", "content_sanskrit": "यस्या मम मुखप्रेक्षा यूयमिन्द्रसमाः सदा ।\nसा प्रेक्षे मुखमन्यासाम् अवराणां वरा सती\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2139529, "chapter_id": 4015, "verse_number": "२०", "content_sanskrit": "पश्य पाण्डव मेऽवस्थां यथा नार्हामि वै तथा ।\nयुष्मासु ध्रियमाणेषु पाञ्चालेषु च मानद\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2139530, "chapter_id": 4015, "verse_number": "२१", "content_sanskrit": "यस्याः सागरपर्यन्ता पृथिवी वशवर्तिनी ।\nआसीत् साऽद्य सुदेष्णायाः भीताऽहं वशवर्तिनी\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2139531, "chapter_id": 4015, "verse_number": "२२", "content_sanskrit": "यस्याः पुरस्सरा आसन् पृष्ठतश्चानुगामिनः ।\nसाऽहमद्य सुदेष्णायाः पश्चाद् यामि भयार्दिता\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2139532, "chapter_id": 4015, "verse_number": "२३", "content_sanskrit": "इदं तु दुःखं कौन्तेय ममासीद् यन्निबोध तत् ।\nया न जातु स्वयं पिङ्क्षे गात्रोद्वर्तनमात्मनः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2139533, "chapter_id": 4015, "verse_number": "२४", "content_sanskrit": "अन्यत्र कुन्त्या भद्रं ते साऽद्य पिङ्क्षामि चन्दनम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2139534, "chapter_id": 4015, "verse_number": "२५", "content_sanskrit": "पश्य कौन्तेय मे पाणी नैवाभूतां हि यौ पुरा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2139535, "chapter_id": 4015, "verse_number": "२६", "content_sanskrit": "इत्यस्मै दर्शयामास किणवन्तौ करावुभौ\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2139536, "chapter_id": 4015, "verse_number": "२७", "content_sanskrit": "बिभेमि कुन्त्या या नाऽहं युष्माकं वा कदाचन ।\nसाऽद्याग्रतो विराटस्य भीता तिष्ठामि किङ्करी\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2139537, "chapter_id": 4015, "verse_number": "२८", "content_sanskrit": "किं नु वक्ष्यति सम्राण्मां वर्णकः सुकरो न वा ।\nनान्यपिष्टं विराटस्य चन्दनं किल रोचते\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2139538, "chapter_id": 4015, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2139539, "chapter_id": 4015, "verse_number": "२९", "content_sanskrit": "सा कीर्तयन्ती दुःखानि भीमसेनस्य भामिनी ।\nरुरोद शनकैः कृष्णा भीमस्योरः समाश्रिता\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2139540, "chapter_id": 4015, "verse_number": "३०", "content_sanskrit": "सा बाष्पकलया वाचा निःश्वसन्ती पुनः पुनः ।\nहृदये भीमसेनस्य घट्टयन्तीदमब्रवीत्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2139541, "chapter_id": 4015, "verse_number": "३१", "content_sanskrit": "नाल्पं कृतं मया भीम देवानां किल्बिषं पुरा ।\nअभाग्या यत्र जीवामि मर्तव्ये सति पाण्डव\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2139542, "chapter_id": 4015, "verse_number": "३२", "content_sanskrit": "कीचकं चेन्न हन्यास्त्वमात्मानं नाशयाम्यहम् ।\nविषमालोड्य पास्यामि प्रवेक्ष्याम्यथवाऽनलम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2139543, "chapter_id": 4015, "verse_number": "३३", "content_sanskrit": "अभाग्याऽहमपुण्याऽहं नित्यंदुःखा च विक्लवा ।\nपापे निपतितायाश्च किं फलं जीवितेन मे\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2139544, "chapter_id": 4015, "verse_number": "३४", "content_sanskrit": "इत्यस्मै दर्शयामास किण्व(ण)वन्तौ करावुभौ\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2139545, "chapter_id": 4015, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2139546, "chapter_id": 4015, "verse_number": "३५", "content_sanskrit": "ततस्तस्याः करौ पीनौ किणबद्धौ वृकोदरः ।\nमुखमानाय्य वेपन्त्या रुरोद परवीरहा\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2139547, "chapter_id": 4015, "verse_number": "३६", "content_sanskrit": "तौ गृहीत्वा च कौन्तेयो बाष्पमुत्सृज्य वीर्यवान् ।\nततः परमदुःखार्त इदं वचनमब्रवीत्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2139548, "chapter_id": 4015, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां विराटपर्वणि त्रयोविंशोऽध्यायः ॥२३॥\nकीचकवधपर्वणि अष्टमोऽध्यायः ॥८॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]