[{"id": 2176367, "chapter_id": 4732, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2176368, "chapter_id": 4732, "verse_number": "१", "content_sanskrit": "अधर्मेण हतं दृष्ट्या राजानं माधवोत्तमः ।\nकिमब्रवीत् तदा सूत बलदेवो महाबलः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2176369, "chapter_id": 4732, "verse_number": "२", "content_sanskrit": "गदायुद्धविशेषज्ञो गदायुद्धस्य पारगः ।\nकृतवान् रौहिणेयो यत् तन्ममाचक्ष्व सञ्जय\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2176370, "chapter_id": 4732, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2176371, "chapter_id": 4732, "verse_number": "३", "content_sanskrit": "शिरस्यभिहतं दृष्ट्वा भीमसेनेन ते सुतम् ।\nरामः प्रहरतां श्रेष्ठश्चुकोप बलवद् बली\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2176372, "chapter_id": 4732, "verse_number": "४", "content_sanskrit": "ततो मध्ये नरेन्द्राणामूर्ध्वबाहुर्हलायुधः ।\nकुर्वन्नार्तस्वरं धिग्धिगिति चाब्रवीत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2176373, "chapter_id": 4732, "verse_number": "", "content_sanskrit": "बलदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2176374, "chapter_id": 4732, "verse_number": "५", "content_sanskrit": "अहो धिग्धिगधो नाभेः प्रहृतं सत्यविक्रमे ।\nनैतद् दृष्टं गदायुद्धे कृतवान् यद् वृकोदरः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2176375, "chapter_id": 4732, "verse_number": "६", "content_sanskrit": "अधो नाभ्या न हन्तव्यमिति शास्त्रस्य निश्चयः ।\nअयं तु शास्त्रमूढस्तु स्वच्छन्दात् परिवर्तते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2176376, "chapter_id": 4732, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2176377, "chapter_id": 4732, "verse_number": "७", "content_sanskrit": "तस्य तत्तद् ब्रुवाणस्य रोषः समभवन्महान् ।\nततो लाङ्गलमुद्यम्य भीममभ्यद्रवद् बली\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2176378, "chapter_id": 4732, "verse_number": "८", "content_sanskrit": "तस्योर्ध्वबाहोः सदृशं रूपमासीन्महात्मनः ।\nबहुधातुविचित्रस्य श्वेतस्येव महागिरेः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2176379, "chapter_id": 4732, "verse_number": "९", "content_sanskrit": "भ्रातृभिः सहितो भीमः सार्जुनैरस्त्रकोविदैः ।\nन विव्यथे महाराज दृष्ट्वा हलधरं बली\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2176380, "chapter_id": 4732, "verse_number": "१०", "content_sanskrit": "अथ रामं निजग्राह केशवो विनयान्वितः ।\nबाहुभ्यां पीनवृत्ताभ्यां प्रयत्नाद् बलिनं बली\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2176381, "chapter_id": 4732, "verse_number": "११", "content_sanskrit": "सितासितौ यदुवरौ शुशुभातेऽधिकं ततः ।\nसङ्गताविव राजेन्द्र कैलासाञ्जनपर्वतौ\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2176382, "chapter_id": 4732, "verse_number": "१२", "content_sanskrit": "नभोगतौ यथा राजन् चन्द्रसूर्यौ दिनक्षये\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2176383, "chapter_id": 4732, "verse_number": "१३", "content_sanskrit": "उवाच चैनं संरब्धं शमयन्निव केशवः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2176384, "chapter_id": 4732, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2176385, "chapter_id": 4732, "verse_number": "१४", "content_sanskrit": "आत्मवृद्धिर्मित्रवृद्धिर्मित्रमित्रोदयस्तथा ।\nविपरीतं द्विषत्स्वेतत् षड्विधा वृद्धिरात्मनः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2176386, "chapter_id": 4732, "verse_number": "१५", "content_sanskrit": "आत्मन्यपि च मित्रे च विपरीतं यदा भवेत् ।\nतदा विद्वान् मनोज्ञाभिस्तदा शान्तिकरो भवेत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2176387, "chapter_id": 4732, "verse_number": "१६", "content_sanskrit": "अस्माकं सहजं मित्रं पाण्डवाः शुद्धपौरुषाः ।\nस्वकाः पितृष्वसुः पुत्राः परैश्च निकृता भृशम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2176388, "chapter_id": 4732, "verse_number": "१७", "content_sanskrit": "प्रतिज्ञापालनं धर्मः क्षत्रियस्येति वेत्थ तत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2176389, "chapter_id": 4732, "verse_number": "१८", "content_sanskrit": "सुयोधनस्य गदया भङ्क्त्वास्म्यूरू महाहवे ।\nइति पूर्वं प्रतिज्ञातं भीमेन हि सभातळे\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2176390, "chapter_id": 4732, "verse_number": "१९", "content_sanskrit": "मैत्रेयेणाभिशप्तश्च पूर्वमेव महर्षिणा ।\nऊरू भङ्क्ष्यति ते वीरो गदयेति परन्तप\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2176391, "chapter_id": 4732, "verse_number": "२०", "content_sanskrit": "अतो दोषं न पश्यामि मा क्रुधस्त्वं प्रलम्बहन्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2176392, "chapter_id": 4732, "verse_number": "२१", "content_sanskrit": "योनैर्हार्दैश्च सम्बन्धैः सम्बद्धाः स्मेह पाण्डवैः ।\nतेषां वृद्ध्या हि वृद्धिर्नो मा क्रुधस्त्वं नरर्षभ\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2176393, "chapter_id": 4732, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2176394, "chapter_id": 4732, "verse_number": "२२", "content_sanskrit": "वासुदेववचः श्रुत्वा सीरभृत् प्राह धर्मवित्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2176395, "chapter_id": 4732, "verse_number": "", "content_sanskrit": "श्रीरामः(बलरामः)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2176396, "chapter_id": 4732, "verse_number": "२३", "content_sanskrit": "धर्मश्च धारितः सद्भिः सह द्वाभ्यां नियच्छति ।\nअर्थश्चाप्यतिलुब्धस्य कामश्चातिप्रसङ्गिणः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2176397, "chapter_id": 4732, "verse_number": "२४", "content_sanskrit": "धर्मार्थौ धर्मकामौ च कामार्थौ चाप्यपीडयन् ।\nधमार्थकामान् योऽभ्येति सोऽत्यन्तं सुखमेधते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2176398, "chapter_id": 4732, "verse_number": "२५", "content_sanskrit": "तदिदं व्याकुलं सर्वं कृतं धर्मस्य पीडनात् ।\nभीमसेनेन गोविन्द कामं त्वं तु यथाऽऽत्थ माम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2176399, "chapter_id": 4732, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2176400, "chapter_id": 4732, "verse_number": "२६", "content_sanskrit": "अरोषणोऽथ धर्मात्मा सततं धर्मवत्सलः ।\nभवान् प्रख्यायते लोके तस्मात् संशाम्य मा क्रुधः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2176401, "chapter_id": 4732, "verse_number": "२७", "content_sanskrit": "प्राप्तं कलियुगं विद्धि प्रतिज्ञां पाण्डवस्य च ।\nआनृण्यं यातु वैरस्य प्रतिज्ञायाश्च पाण्डवः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2176402, "chapter_id": 4732, "verse_number": "२८", "content_sanskrit": "गतः पुरुषशार्दूलो हत्वा नैकृतिकं रणे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2176403, "chapter_id": 4732, "verse_number": "२९", "content_sanskrit": "निकृत्या निकृतिप्रज्ञं यो हन्याद् वैरिणं रणे ।\nअधर्मो विद्यते नात्र यद् भीमो हतवान् रिपुम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2176404, "chapter_id": 4732, "verse_number": "३०", "content_sanskrit": "युध्यन्तं समरे वीरं कुरुवृष्णियशस्करम् ।\nअनेन कर्णः सन्दिष्टः पृष्ठतो धनुरच्छिनत्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2176405, "chapter_id": 4732, "verse_number": "३१", "content_sanskrit": "ततः सञ्छिन्नधन्वानं विरथं पौरुषे स्थितम् ।\nव्यायुधीकृत्य हतवान् सौभद्रमपलायिनम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2176406, "chapter_id": 4732, "verse_number": "३२", "content_sanskrit": "जन्मप्रभृति लुब्धश्च पापश्चैष दुरात्मवान् ।\nनिहतो भीमसेनेन दुर्बुद्धिः कुलपांसनः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2176407, "chapter_id": 4732, "verse_number": "३३", "content_sanskrit": "प्रतिज्ञां भीमसेनस्य त्रयोदशसमार्जिताम् ।\nकिमर्थं नाभिजानाति युध्यमानो हि विश्रुताम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2176408, "chapter_id": 4732, "verse_number": "३४", "content_sanskrit": "ऊर्ध्वमुत्क्रम्य वेगेन जिघांसन्तं वृकोदरः ।\nबभञ्ज गदया चोरू न स्थाने न च मण्डले\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2176409, "chapter_id": 4732, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2176410, "chapter_id": 4732, "verse_number": "३५", "content_sanskrit": "धर्मच्छलमिमं श्रुत्वा केशवात् स विशाम्पते ।\nनैव प्रीतमना रामो वचनं प्राह संसदि\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2176411, "chapter_id": 4732, "verse_number": "", "content_sanskrit": "रामः(बलभद्रः)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2176412, "chapter_id": 4732, "verse_number": "३६", "content_sanskrit": "हत्वाऽधर्मेण राजानं धर्मात्मानं सुयोधनम् ।\nजिह्मयोधीति लोकेऽस्मिन् ख्यातिं यास्यति पाण्डवः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2176413, "chapter_id": 4732, "verse_number": "३७", "content_sanskrit": "दुर्योधनोऽपि धर्मज्ञो लोकान् यास्यति शाश्वतान् ।\nऋजुयोधी हतो राजा धार्तराष्ट्रः सुदुर्मदः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2176414, "chapter_id": 4732, "verse_number": "३८", "content_sanskrit": "युद्धदीक्षां प्रविश्याजौ रणयज्ञं वितत्य च ।\nहुत्वाऽऽत्मानममित्राग्नौ प्राप्तश्चावभृथं यशः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2176415, "chapter_id": 4732, "verse_number": "३९", "content_sanskrit": "स्वर्गं गन्ता महाराजः ससुहृज्ज्ञातिबान्धवः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2176416, "chapter_id": 4732, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2176417, "chapter_id": 4732, "verse_number": "४०", "content_sanskrit": "इत्युक्त्वा रथमास्थाय रौहिणेयः प्रतापवान् ।\nश्वेताभ्रशिखरप्रख्यः प्रययौ द्वारकां प्रति\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2176418, "chapter_id": 4732, "verse_number": "४१", "content_sanskrit": "पाञ्चालाश्च सवार्ष्णेयाः पाण्डवाश्च विशाम्पते ।\nरामे द्वारवतीं याते नातिप्रमनसोऽभवन्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2176419, "chapter_id": 4732, "verse_number": "४२", "content_sanskrit": "ततो युधिष्ठिरं दीनं चिन्तापरमधोमुखम् ।\nशोकोपहतसन्तप्तं वासुदेवोऽब्रवीदिदम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2176420, "chapter_id": 4732, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2176421, "chapter_id": 4732, "verse_number": "४३", "content_sanskrit": "धर्मराज किमर्थं त्वमधर्ममनुपश्यसि ।\nहतबन्धोर्यदेतस्य पतितस्य विचेतसः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2176422, "chapter_id": 4732, "verse_number": "४४", "content_sanskrit": "सुयोधनस्य भीमेन मृद्यमानं पदा शिरः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2176423, "chapter_id": 4732, "verse_number": "४५", "content_sanskrit": "उपप्रेक्षसि कस्मात् त्वं धर्मज्ञस्त्वं नराधिप\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2176424, "chapter_id": 4732, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2176425, "chapter_id": 4732, "verse_number": "४६", "content_sanskrit": "न ममैतत् प्रियं कृष्ण यद् राजानं वृकोदरः ।\nपदा मूर्ध्न्यस्पृशत् क्रोधान्न च हृष्ये कुलक्षये\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2176426, "chapter_id": 4732, "verse_number": "४७", "content_sanskrit": "निकृत्या निकृता नित्यं धृतराष्ट्रसुतैर्वयम् ।\nबहूनि परुषाण्युक्त्वा वनं प्रस्थापिता वयम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2176427, "chapter_id": 4732, "verse_number": "४८", "content_sanskrit": "भीमसेनस्य तद् दुःखमतीव हृदि वर्तते ।\nइति सञ्चिन्त्य वार्ष्णेय मयैतत् समुपेक्षितम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2176428, "chapter_id": 4732, "verse_number": "४९", "content_sanskrit": "तस्माद्धत्वाऽकृतप्रज्ञं लुब्धं कामवशानुगम् ।\nलभतां पाण्डवः कामं धर्मोऽधर्मोऽपि वा कृतः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2176429, "chapter_id": 4732, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2176430, "chapter_id": 4732, "verse_number": "५०", "content_sanskrit": "इत्युक्तवति कौन्तेये वासुदेवोब्रवीदिदम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2176431, "chapter_id": 4732, "verse_number": "५१", "content_sanskrit": "काममस्त्वेवमिति वै कृच्छ्रात् कुरुकुलोद्वहम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2176432, "chapter_id": 4732, "verse_number": "५२", "content_sanskrit": "इत्युक्त्वा वासुदेवोऽपि भीमसेनप्रियेप्सया ।\nअन्वमोदत तत्सर्वं यद्भीमेन कृतं रणे\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2176433, "chapter_id": 4732, "verse_number": "५३", "content_sanskrit": "अर्जुनोऽपि महाबाहुरप्रीतेनान्तरात्मना ।\nनोवाच वचनं किञ्चित् भ्रातरं साध्वसाधु वा\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2176434, "chapter_id": 4732, "verse_number": "५४", "content_sanskrit": "भीमसेनोऽपि हत्वाऽऽजौ तव पुत्रममर्षणः ।\nअभिवाद्य ततो राजन् सम्प्रहृष्टः कृताञ्जलिः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2176435, "chapter_id": 4732, "verse_number": "५५", "content_sanskrit": "प्रोवाच सुमहातेजा धर्मपुत्रं युधिष्ठिरम् ।\nहर्षादुत्फुल्लनयनो जितकाशी विशाम्पते\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2176436, "chapter_id": 4732, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2176437, "chapter_id": 4732, "verse_number": "५६", "content_sanskrit": "तवाद्य पृथिवी राजन् क्षेमा निहतकण्टका ।\nतां प्रशाधि नरव्याघ्र स्वधर्ममनुपालयन्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2176438, "chapter_id": 4732, "verse_number": "५७", "content_sanskrit": "यस्तु कर्ताऽस्य वैरस्य निकृत्या निकृतिप्रियः ।\nसोऽयं विनिहतः शेते पृथिव्यां पृथिवीपते\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2176439, "chapter_id": 4732, "verse_number": "५८", "content_sanskrit": "दुःशासनप्रभृतयः सर्वे ते चोग्रवादिनः ।\nराधेयः शकुनिश्चैव निहतास्तव शत्रवः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2176440, "chapter_id": 4732, "verse_number": "५९", "content_sanskrit": "सेयं रत्नसमाकीर्णा मही सवनपर्वता ।\nउपावृत्ता महाराज त्वामद्य निहतद्विषम्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2176441, "chapter_id": 4732, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2176442, "chapter_id": 4732, "verse_number": "६०", "content_sanskrit": "गतो वैरस्य निलयं हतो दुर्योधनस्त्वया ।\nकृष्णस्य मतमाज्ञाय विजितेयं वसुन्धरा\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2176443, "chapter_id": 4732, "verse_number": "६१", "content_sanskrit": "दिष्ट्या गतस्त्वमानृण्यं मातुः कोपस्य चोभयोः ।\nदिष्ट्या जयसि दुर्धर्ष दिष्ट्या शत्रुर्निपातितः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2176444, "chapter_id": 4732, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि दुर्योधनप्रहरणो नाम त्रिंशोऽध्यायः ॥३०॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]