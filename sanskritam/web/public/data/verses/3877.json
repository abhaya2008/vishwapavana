[{"id": 2133421, "chapter_id": 3877, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2133422, "chapter_id": 3877, "verse_number": "१", "content_sanskrit": "एवमुक्तः स विप्रस्तु धर्मव्याधेन भारत ।\nकथामकथयद् भूयो मनसः प्रीतिवर्धनीम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2133423, "chapter_id": 3877, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2133424, "chapter_id": 3877, "verse_number": "२", "content_sanskrit": "महाभूतानि यान्याहुः पञ्च धर्मभृतां वर ।\nएकैकस्य गुणान् सम्यक् पञ्चानामपि मे वद\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2133425, "chapter_id": 3877, "verse_number": "", "content_sanskrit": "व्याधः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2133426, "chapter_id": 3877, "verse_number": "३", "content_sanskrit": "भूमिरापस्तथा ज्योतिर्वायुराकाशमेव च ।\nगुणोत्तराणि सर्वाणि तेषां वक्ष्यामि ते गुणान्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2133427, "chapter_id": 3877, "verse_number": "४", "content_sanskrit": "भूमिः पञ्चगुणा ब्रह्मन्नुदकं च चतुर्गुणम् ।\nगुणास्त्रयस्तेजसि च त्रयश्चाकाशवातयोः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2133428, "chapter_id": 3877, "verse_number": "५", "content_sanskrit": "शब्दः स्पर्शश्च रूपं च रसो गन्धश्च पञ्चमः ।\nएते गुणाः पञ्च भूमेः सर्वेभ्यो गुणवत्तरा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2133429, "chapter_id": 3877, "verse_number": "६", "content_sanskrit": "शब्दः स्पर्शश्च रूपं च रसश्चापि द्विजोत्तम ।\nअपामेते गुणा ब्रह्मन् कीर्तितास्तव सुव्रत\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2133430, "chapter_id": 3877, "verse_number": "७", "content_sanskrit": "शब्दः स्पर्शश्च रूपं च तेजसोऽथ गुणास्त्रयः ।\nशब्दः स्पर्शश्च वायौ तु शब्दश्चाकाश एव तु\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2133431, "chapter_id": 3877, "verse_number": "८", "content_sanskrit": "एते पञ्चदश ब्रह्मन् गुणा भूतेषु पञ्चसु ।\nवर्तन्ते सर्वभूतेषु येषु लोकाः प्रतिष्ठिताः ।\nअन्योन्यं नातिवर्तन्ते सम्यक्च भवति द्विज \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2133432, "chapter_id": 3877, "verse_number": "९", "content_sanskrit": "यदा तु विषमं भावमाचरन्ति चराचराः ।\nतदा देही देहमन्यं व्यतिरोहति कालतः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2133433, "chapter_id": 3877, "verse_number": "१०", "content_sanskrit": "प्रातिलोम्याद् विनश्यन्ति जायन्ते चानुपूर्वशः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2133434, "chapter_id": 3877, "verse_number": "११", "content_sanskrit": "तत्र तत्र हि दृश्यन्ते धातवः पाञ्चभौतिकाः ।\nयैरावृतमिदं सर्वं जगत् स्थावरजङ्गमम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2133435, "chapter_id": 3877, "verse_number": "१२", "content_sanskrit": "इन्द्रियैः गृह्यते यद्यत् तत्तद् व्यक्तमिति स्मृतम् ।\nतदव्यक्तमिति ज्ञेयं लिङ्गग्राह्यमतीन्द्रियम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2133436, "chapter_id": 3877, "verse_number": "१३", "content_sanskrit": "यथास्वं ग्राहकान्येषां शब्दादीनामिमानि तु ।\nइन्द्रियाणि यदा देही धारयन्निह तप्यते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2133437, "chapter_id": 3877, "verse_number": "१४", "content_sanskrit": "लोके विततमात्मानं लोकं चात्मनि पश्यति ।\nपरावरज्ञो यः शक्तः स तु भूतानि पश्यति\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2133438, "chapter_id": 3877, "verse_number": "१५", "content_sanskrit": "पश्यतः सर्वभूतानि सर्वावस्थासु सर्वदा ।\nब्रह्मभूतेन संयोगो नाशुभेनोपपद्यते\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2133439, "chapter_id": 3877, "verse_number": "१६", "content_sanskrit": "ज्ञानमूलात्मकं क्लेशमतिवृत्तस्य मोहजम् ।\nलोक(कः)बुद्धिप्रकाशेन ज्ञेयमार्गेण गम्यते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2133440, "chapter_id": 3877, "verse_number": "१७", "content_sanskrit": "अनादिनिधनं जन्तुमात्मयोनिं सदाव्ययम् ।\nअनौपम्यममूर्तं च भगवानाह बुद्धिमान्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2133441, "chapter_id": 3877, "verse_number": "१८", "content_sanskrit": "तपोमूलमिदं सर्वं यन्मां विप्रानुपृच्छसि ।\nतपसा हि समाप्नोति यद्यदेवाभिवाञ्छितम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2133442, "chapter_id": 3877, "verse_number": "१९", "content_sanskrit": "इन्द्रियाण्येव तत्सर्वं यत्स्वर्गनरकावुभौ ।\nनिगृहीतविसृष्टानि स्वर्गाय नरकाय च \t॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2133443, "chapter_id": 3877, "verse_number": "२०", "content_sanskrit": "तदिन्द्रियाणि संयम्य तपो भवति नान्यथा ।\nएष योगविधिः कृत्स्नो यावदिन्द्रियधारणम् ।\nएतन्मूलं हि तपसः स्वर्गस्य नरकस्य च \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2133444, "chapter_id": 3877, "verse_number": "२१", "content_sanskrit": "इन्द्रियाणां प्रसङ्गेन दोषमार्च्छन्त्यसंशयम्।\nसंनियम्य तु तान्येव ततः सिद्धिं समाप्नुयात्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2133445, "chapter_id": 3877, "verse_number": "२२", "content_sanskrit": "षण्णामात्मनि योज्यानामैश्वर्यं योऽधिगच्छति ।\nन स पापैः कुतोऽनर्थैर्युज्यते विजितेन्द्रियः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2133446, "chapter_id": 3877, "verse_number": "२३", "content_sanskrit": "रथं शरीरं पुरुषस्य दृष्टमात्मा नियन्तेन्द्रियाण्याहुरश्वान् ।\nतैरप्रमत्तः कुशली सदश्वैर्दान्तैः सुखं याति रथीव धीरः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2133447, "chapter_id": 3877, "verse_number": "२४", "content_sanskrit": "षण्णामात्मनि युक्तानामिन्द्रियाणां प्रमाथिनाम् ।\nयो धीरो धारयेद् रश्मीन् स स्यात् परमसारथिः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2133448, "chapter_id": 3877, "verse_number": "२५", "content_sanskrit": "इन्द्रियाणां प्रसृष्टानां हयानामिव वर्त्मसु ।\nधृतिं कुर्वीत सारथ्ये धृत्या तानि जयेद् ध्रुवम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2133449, "chapter_id": 3877, "verse_number": "२६", "content_sanskrit": "इन्द्रियाणां विचरतां यन्मनोऽनु विधीयते ।\nतदस्य हरते बुद्धिं नावं वायुरिवाम्भसि\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2133450, "chapter_id": 3877, "verse_number": "२७", "content_sanskrit": "येषु विप्रतिपद्यन्ते षट्स्वमोहात् फलागमम् ।\nज्ञात्वैष्वध्यासितो ध्यायी विन्दते ध्यानजं फलम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2133451, "chapter_id": 3877, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि मार्कण्डेयसमास्यापर्वणि ब्राह्मणव्याधसंवादे अष्टनवत्यधिकशततमोऽध्यायः ॥१९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2133452, "chapter_id": 3877, "verse_number": "२३", "content_sanskrit": "॥ इति मार्कण्डेयसमस्यापर्वणि त्रयोविंशोऽध्यायः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2133453, "chapter_id": 3877, "verse_number": "", "content_sanskrit": "* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]