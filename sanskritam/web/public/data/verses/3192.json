[{"id": 2101637, "chapter_id": 3192, "verse_number": "१४-४८-१", "content_sanskrit": "ब्रह्मोवाच।\nकेचिद्ब्रह्ममयं वृक्षं केचिद्ब्रह्ममयं वनम्।\nकेचित्परममव्यक्तं केचित्परमनामयम्।\nमन्यन्ते सर्वमप्येतदव्यक्तप्रभवाव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101638, "chapter_id": 3192, "verse_number": "१४-४८-२", "content_sanskrit": "उच्छ्वासमात्रमपि चेद्योऽन्तकाले समो भवेत्।\nआत्मानमुपसङ्म्य सोमृतत्वाय कल्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101639, "chapter_id": 3192, "verse_number": "१४-४८-३", "content_sanskrit": "निमेषमात्रमपि चेत्संयम्यात्मानमात्मनि।\nगच्छत्यात्मप्रसादेन विदुषां प्राप्तिमव्ययाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101640, "chapter_id": 3192, "verse_number": "१४-४८-४", "content_sanskrit": "प्राणायामैरथ प्राणान्संयम्य स पुनःपुनः।\nदशद्वादशभिर्वापि चतुर्विंशात्समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101641, "chapter_id": 3192, "verse_number": "१४-४८-५", "content_sanskrit": "एवं पूर्वं प्रसन्नात्मा लभते यद्यदिच्छति।\nअव्यक्तात्सत्वमुद्रिक्तममृतत्वाय कल्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101642, "chapter_id": 3192, "verse_number": "१४-४८-६", "content_sanskrit": "सत्वात्परतरं नान्यत्प्रशंसन्तीह तद्विदः।\nअनुमानाद्विजानीमः पुरुषं सत्वसंश्रयम्।\nन शक्यमन्यथा गन्तुं पुरुषं द्विजसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101643, "chapter_id": 3192, "verse_number": "१४-४८-७", "content_sanskrit": "क्षमा धृतिरहिंसा च समता सत्यमार्जवम्।\nज्ञानं त्यागोथ संन्यासः सात्विकं वृत्तमिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101644, "chapter_id": 3192, "verse_number": "१४-४८-८", "content_sanskrit": "एतेनैवानुमानेन मन्यन्ते वै मनीषिणः।\nसत्वं च पुरुषश्चैव तत्र नास्ति विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101645, "chapter_id": 3192, "verse_number": "१४-४८-९", "content_sanskrit": "आहुरेके च विद्वांसो ये ज्ञाने सुप्रतिष्ठिताः।\nक्षेत्रज्ञसत्वयोरैक्यमित्येतन्नोपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2101646, "chapter_id": 3192, "verse_number": "१४-४८-१०", "content_sanskrit": "पृथग्भूतस्तथा नित्यमित्येतदविचारितम्।\nपृथग्भावश्च विज्ञेयः सहजश्चापि तत्त्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2101647, "chapter_id": 3192, "verse_number": "१४-४८-११", "content_sanskrit": "तथैवैकत्वनानात्वमिष्यते विदुषां नयः।\nमशकोदुम्बरे चैक्यं पृथक्त्वमपि दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2101648, "chapter_id": 3192, "verse_number": "१४-४८-१२", "content_sanskrit": "मत्स्यो यथाऽन्यः स्यादप्सु सम्प्रयोगस्तथा तयोः।\nसम्बन्धस्तोयबिन्दूनां पर्णैः कोकनदस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2101649, "chapter_id": 3192, "verse_number": "१४-४८-१३x", "content_sanskrit": "गुरुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2101650, "chapter_id": 3192, "verse_number": "१४-४८-१३", "content_sanskrit": "इत्युक्तवन्तस्ते विप्रास्तदा लोकपितामहम्।\nपुनः संशयमापन्नाः पप्रच्छुर्मुनिसत्तमाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2101651, "chapter_id": 3192, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि अष्टचत्वारिंशोऽध्यायः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]