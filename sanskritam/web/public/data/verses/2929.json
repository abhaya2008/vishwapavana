[{"id": 2090683, "chapter_id": 2929, "verse_number": "१३-५९-१", "content_sanskrit": "`मार्कण्डेय उवाच।\nश्रुतं बलं प्रभावश्च योषितां मुनिसत्तम।\nएकस्य बहुभार्यस्य धर्ममिच्छामि वेदितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2090684, "chapter_id": 2929, "verse_number": "१३-५९-२x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2090685, "chapter_id": 2929, "verse_number": "१३-५९-२", "content_sanskrit": "बहुभार्यासु सक्तस्य नारीभोगेषु गेहिनः।\nऋतौ विमुञ्चमानस्य सांनिध्ये भ्रूणहा स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2090686, "chapter_id": 2929, "verse_number": "१३-५९-३", "content_sanskrit": "वृद्धां वन्ध्यां सुव्रता च मृतापत्यामपुष्पिणीम्।\nकन्यां च बहुपुत्रां च वर्जयन्मुच्यते भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2090687, "chapter_id": 2929, "verse_number": "१३-५९-४", "content_sanskrit": "व्याधितो बन्धनस्थो वा प्रवासेष्वथ पर्वसु।\nऋतुकाले तु नारीणां भ्रूणहत्यां प्रमुञ्चति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2090688, "chapter_id": 2929, "verse_number": "१३-५९-५x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2090689, "chapter_id": 2929, "verse_number": "१३-५९-५", "content_sanskrit": "वैश्यनारीषु वै जाताः परप्रेष्यासु वा सुताः।\nकस्य ते बन्धुदायादा भवन्ति हि महामुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2090690, "chapter_id": 2929, "verse_number": "१३-५९-६x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2090691, "chapter_id": 2929, "verse_number": "१३-५९-६", "content_sanskrit": "पण्यस्त्रीषु प्रसूता ये यस्य स्त्री तस्य ते सुताः।\nक्रयाच्च कृत्रिमाः पुत्रा प्रदानाच्चैव दत्रिमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2090692, "chapter_id": 2929, "verse_number": "१३-५९-७x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2090693, "chapter_id": 2929, "verse_number": "१३-५९-७", "content_sanskrit": "पण्यनारीष्वनियतः पुंसोऽर्थो वर्तते ध्रुवम्।\nअत्र चाहितगर्भायाः कस्य पुत्रं वदन्ति तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2090694, "chapter_id": 2929, "verse_number": "१३-५९-८x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2090695, "chapter_id": 2929, "verse_number": "१३-५९-८", "content_sanskrit": "तीर्थभूतासु नारीषु ज्ञायते योऽभिगच्छति।\nऋतौ तस्य भवेद्गर्भो यं वा नारी न शङ्कते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2090696, "chapter_id": 2929, "verse_number": "१३-५९-९x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2090697, "chapter_id": 2929, "verse_number": "१३-५९-९", "content_sanskrit": "नराणां त्यजतां भार्यां कामक्रोधाद्गुणान्विताम्।\nअप्रसूतां प्रसूतां वा तेषां पृच्छामि निष्कृतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2090698, "chapter_id": 2929, "verse_number": "१३-५९-१०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2090699, "chapter_id": 2929, "verse_number": "१३-५९-१०", "content_sanskrit": "अपापां त्यजमानस्य साध्वीं मत्वा यमादितः।\nआत्मवंशस्वधर्मो वा त्यजतो निष्कृतिर्न तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2090700, "chapter_id": 2929, "verse_number": "१३-५९-११", "content_sanskrit": "यो नरस्त्यजते भार्या पुष्पिणीमप्रसूतिकाम्।\nस नष्टवंशः पितृभिर्युक्तस्त्यज्येत दैवतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2090701, "chapter_id": 2929, "verse_number": "१३-५९-१२", "content_sanskrit": "भार्यामपत्यसञ्जातां प्रसूतां पुत्रपौत्रिणीम्।\nपुत्रदारपरित्यागी न स प्राप्नोति निष्कृतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2090702, "chapter_id": 2929, "verse_number": "१३-५९-१३", "content_sanskrit": "एवं हि भार्यां त्यजतां नराणां नास्ति निष्कृतिः।\nनार्हन्ति प्रमदास्त्यक्तुं पुत्रपौत्रप्रतिष्ठिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2090703, "chapter_id": 2929, "verse_number": "१३-५९-१४x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2090704, "chapter_id": 2929, "verse_number": "१३-५९-१४", "content_sanskrit": "कीदृशीं संत्यजन्भार्यां नरो दोषैर्न लिप्यते।\nएतदिच्छामि तत्वेन विज्ञातुमृषिसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2090705, "chapter_id": 2929, "verse_number": "१३-५९-१५x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2090706, "chapter_id": 2929, "verse_number": "१३-५९-१५", "content_sanskrit": "मोक्षधर्मस्थितानां तु अन्योन्यमनुजानताम्।\nभार्यापतीनां मुक्तानामधर्मो न विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2090707, "chapter_id": 2929, "verse_number": "१३-५९-१६", "content_sanskrit": "अन्यसङ्गां गतापत्यां शूद्रगां परगामिनीम्।\nपरीक्ष्य त्यजमानानां नराणां नास्ति पातकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2090708, "chapter_id": 2929, "verse_number": "१३-५९-१७", "content_sanskrit": "पातकेऽपि तु भर्तव्यौ द्वौ तु माता पिता तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2090709, "chapter_id": 2929, "verse_number": "१३-५९-१८x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2090710, "chapter_id": 2929, "verse_number": "१३-५९-१८", "content_sanskrit": "भार्यायां व्यभिचारिण्यां नरस्य त्यजतो रुषा।\nकथं धर्मोऽप्यधर्मो वा भवतीह महामते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2090711, "chapter_id": 2929, "verse_number": "१३-५९-१९x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2090712, "chapter_id": 2929, "verse_number": "१३-५९-१९", "content_sanskrit": "अनृतेऽपि हि सत्ये वा यो नारीं दूषितां त्यजेत्।\nअरक्षमाणः स्वां भार्यां नरो भवति भ्रूणहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2090713, "chapter_id": 2929, "verse_number": "१३-५९-२०", "content_sanskrit": "अपत्यहेतोर्या नारी भर्तारमतिलङ्घयेत्।\nलोलेन्द्रियेति सा रक्ष्या न सन्त्याज्या कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2090714, "chapter_id": 2929, "verse_number": "१३-५९-२१", "content_sanskrit": "नद्यश्च नार्यश्च समस्वभावा\nनैताः प्रमुञ्चन्ति नरावगाढाः।\nस्रोतांसि नद्यो वहते निपातं\nनारी रजोभिः पुनरेति शौचम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2090715, "chapter_id": 2929, "verse_number": "१३-५९-२२", "content_sanskrit": "एवं नार्यो न दुष्यन्ति व्यभिचारेऽपि भर्तृणाम्।\nमासिमासि भवेद्रागस्ततः शुद्धा भवन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2090716, "chapter_id": 2929, "verse_number": "१३-५९-२३x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2090717, "chapter_id": 2929, "verse_number": "१३-५९-२३", "content_sanskrit": "कानि तीर्थानि भगवन्नृणां देहाश्रितानि वै।\nतानि वै शंस भगवन्याथातथ्येन पृच्छतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2090718, "chapter_id": 2929, "verse_number": "१३-५९-२४", "content_sanskrit": "सर्वतीर्थेषु सर्वज्ञ किं तीर्थं परमं नृणाम्।\nयत्रोपस्पृश्य पूतो यो नरो भवति नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2090719, "chapter_id": 2929, "verse_number": "१३-५९-२५x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2090720, "chapter_id": 2929, "verse_number": "१३-५९-२५", "content_sanskrit": "देवर्षिपितृतीर्थानि ब्राह्मं मध्येऽथं वैष्णवम्।\nनृणां तीर्थानि पञ्चाहुः पाणौ सन्निहितानि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2090721, "chapter_id": 2929, "verse_number": "१३-५९-२६", "content_sanskrit": "आद्यतीर्थं तु तीर्थानां वैष्णवो भाग उच्यते।\nयत्रोपस्पृश्य वर्णानां चतुर्णां वर्धते कुलम्।\nपितृदैवतकार्याणि वर्धन्ते प्रेत्य चेह च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2090722, "chapter_id": 2929, "verse_number": "१३-५९-२७x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2090723, "chapter_id": 2929, "verse_number": "१३-५९-२७", "content_sanskrit": "नराणां कामवृत्तानां या नार्यो निरवग्रहाः।\nयासामभिग्रहो नास्ति ता मे कथय नारद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2090724, "chapter_id": 2929, "verse_number": "१३-५९-२८x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2090725, "chapter_id": 2929, "verse_number": "१३-५९-२८", "content_sanskrit": "पाशुर्वैश्या नटी गोपी तान्तुकी तुन्नवायिकी।\nनारी किराती शबरी नर्तकी चानवग्रहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2090726, "chapter_id": 2929, "verse_number": "१३-५९-२९x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2090727, "chapter_id": 2929, "verse_number": "१३-५९-२९", "content_sanskrit": "एतासु जाता नारीषु सर्ववर्णेषु ये सुताः।\nकेषु के बन्धुदायादा भवन्ति ऋषिसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2090728, "chapter_id": 2929, "verse_number": "१३-५९-३०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2090729, "chapter_id": 2929, "verse_number": "१३-५९-३०", "content_sanskrit": "य एताः परिगृह्णन्ति तेषामेव हि ते सुताः।\nसर्वत्र तु प्रवृत्तासु बीजं नश्यति देहिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2090730, "chapter_id": 2929, "verse_number": "१३-५९-३१x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2090731, "chapter_id": 2929, "verse_number": "१३-५९-३१", "content_sanskrit": "सर्वस्त्रीषु प्रवृत्ताश्च साधुवेदविवर्जिताः।\nमानवाः काण्डपृष्ठाश्च वेदमन्त्रबहिष्कृताः।\nनियुक्ता हव्यकव्येषु तेषां दत्तं कथं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2090732, "chapter_id": 2929, "verse_number": "१३-५९-३२x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2090733, "chapter_id": 2929, "verse_number": "१३-५९-३२", "content_sanskrit": "नार्हन्ति हव्यकव्यानि सावित्रीवर्जिता द्विजाः।\nव्रात्येष्वन्नप्रदानं तद्यथा शूद्रेषु वै तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2090734, "chapter_id": 2929, "verse_number": "१३-५९-३३x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2090735, "chapter_id": 2929, "verse_number": "१३-५९-३३", "content_sanskrit": "धर्मेष्वधिकृतानां तु नराणां मुह्यते मनः।\nकथं न विघ्नो भवति एतदिच्छामि वेदितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2090736, "chapter_id": 2929, "verse_number": "१३-५९-३४x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2090737, "chapter_id": 2929, "verse_number": "१३-५९-३४", "content_sanskrit": "अर्थाश्च नार्यश्च समानमेन-\nच्छ्रेयांसि पुंसामिह मोहयन्ति।\nरतिप्रमोदात्प्रमदा हरन्ति\nभोगैर्धनं चाप्युपहन्ति धर्मान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2090738, "chapter_id": 2929, "verse_number": "१३-५९-३५", "content_sanskrit": "हव्यं कव्यं च धर्मात्मा सर्वं तच्छ्रोत्रियोऽर्हति।\nदत्तं हि श्रोत्रिये साधौ ज्वलिताग्नाविवाहुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2090739, "chapter_id": 2929, "verse_number": "१३-५९-३६x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2090740, "chapter_id": 2929, "verse_number": "१३-५९-३६", "content_sanskrit": "श्रोत्रियाणां कुले जाता वेदार्थविदितात्मनाम्।\nहित्वा कस्मात्त्रयीं विद्यां वार्तां वृत्तिमुपाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2090741, "chapter_id": 2929, "verse_number": "१३-५९-३७x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2090742, "chapter_id": 2929, "verse_number": "१३-५९-३७", "content_sanskrit": "चातुर्वर्ण्यं पुरा न्यस्तं सुविद्वत्सु द्विजातिषु।\nतस्माद्वर्णौः संविभज्या वृत्तिः सङ्करवर्जिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2090743, "chapter_id": 2929, "verse_number": "१३-५९-३८", "content_sanskrit": "ये चान्ये श्रोत्रिया जाताः संस्कृताः पुत्रगृध्नुभिः।\nपूर्वनिर्वाणनिर्वृत्तां जातां वृत्तिमुपाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2090744, "chapter_id": 2929, "verse_number": "१३-५९-३९x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2090745, "chapter_id": 2929, "verse_number": "१३-५९-३९", "content_sanskrit": "असंस्कृताः श्रोत्रियजाः संस्कृता ज्ञानिजाः कथम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2090746, "chapter_id": 2929, "verse_number": "१३-५९-४०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2090747, "chapter_id": 2929, "verse_number": "१३-५९-४०", "content_sanskrit": "असंस्कारो वैदिकश्च स मान्यः श्रोत्रियात्मजः।\nशुद्धान्वयः श्रोत्रियस्तु सुविद्वद्भिः समोऽन्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2090748, "chapter_id": 2929, "verse_number": "१३-५९-४१", "content_sanskrit": "अनधीयानपुत्राश्च वेदसंस्कारवर्जिताः।\nतस्मात्ते वेदविज्ञाऽपि विप्राः श्रुतिनिकारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2090749, "chapter_id": 2929, "verse_number": "१३-५९-४२", "content_sanskrit": "ब्रह्मराशौ पुरा सृष्टा वेदसंस्कारसंस्कृताः।\nतस्मात्तेष्वेव ते जाताः साधवः कुलधारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2090750, "chapter_id": 2929, "verse_number": "१३-५९-४३x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2090751, "chapter_id": 2929, "verse_number": "१३-५९-४३", "content_sanskrit": "स्वयं क्रीतासु प्रेष्यासु प्रसूयन्ते तु ये नराः।\nकस्य नार्यः सुताश्चैव भवन्ति ऋषिसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2090752, "chapter_id": 2929, "verse_number": "१३-५९-४४x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2090753, "chapter_id": 2929, "verse_number": "१३-५९-४४", "content_sanskrit": "स्वदास्यां यो नरो मोहात्प्रसूयेत स पापकृत्।\nइहाभिनिन्दितः प्रेत्य अपत्यं प्रेष्यतां नयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2090754, "chapter_id": 2929, "verse_number": "१३-५९-४५", "content_sanskrit": "सा तस्य भार्या पुत्रा ये हव्यकव्यप्रदास्तु ते।\nतस्या ये बान्धवाः केचिद्विषक्ताः प्रेष्यतां गताः।\nसर्वे तस्यास्तु सम्बन्धा मुच्यन्ते प्रेष्यकर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2090755, "chapter_id": 2929, "verse_number": "१३-५९-४६", "content_sanskrit": "एतत्ते कथितं सर्वं यदभिव्याहृतं त्वया।\nअथवा संशयः कश्चिद्भूयः सम्प्रष्टुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2090756, "chapter_id": 2929, "verse_number": "१३-५९-४७x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2090757, "chapter_id": 2929, "verse_number": "१३-५९-४७", "content_sanskrit": "अमिथ्यादर्शनालोके नारदः सर्वकोविदः।\nप्रत्यक्षदर्शी लोकानां स्वयंभुरिव सत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2090758, "chapter_id": 2929, "verse_number": "१३-५९-४८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2090759, "chapter_id": 2929, "verse_number": "१३-५९-४८", "content_sanskrit": "इति सम्भाष्य ऋषिभिर्मार्कण्डेयो महातपाः।\nनारदं चापि सत्कृत्य तेन चैवाभिसत्कृतः।\nआमन्त्रयित्वा ऋषिभिः प्रययावाश्रमं मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2090760, "chapter_id": 2929, "verse_number": "१३-५९-४९", "content_sanskrit": "ऋषयश्चापि तीर्थानां परिचर्यां प्रचक्रमुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2090761, "chapter_id": 2929, "verse_number": "१३-५९-५०", "content_sanskrit": "सुक्षेत्रबीजसंस्कारविशुद्धो ब्रह्मिचर्यया।\nनित्यनैमित्तिकात्स्नातो मनश्शुद्ध्या च शुद्ध्यति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2090762, "chapter_id": 2929, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकोनषष्टितमोऽध्यायः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]