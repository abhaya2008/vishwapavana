[{"id": 2033669, "chapter_id": 1726, "verse_number": "४-४९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2033670, "chapter_id": 1726, "verse_number": "४-४९-१", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा नीतिशास्त्रविशारदः।\nआचार्यः कुरुवीराणां कृपः शारद्वतोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2033671, "chapter_id": 1726, "verse_number": "४-४९-२", "content_sanskrit": "सदैव तव राधेय युद्धे क्रूरतरा मतिः।\nनार्थानां प्रकृतिं वेत्सि नानुबन्धमवेक्षसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2033672, "chapter_id": 1726, "verse_number": "४-४९-३", "content_sanskrit": "नया हि बहवः सन्ति शास्त्राण्याश्रित्य चिन्तिताः ।\nतेषां युद्धं सुपापिष्ठं वेदयन्ति पुराविदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2033673, "chapter_id": 1726, "verse_number": "४-४९-४", "content_sanskrit": "देशकालेन संयुक्तं युद्धं विजयदं भवेत्।\nहीनकालं तदेवेह अनर्थायोपकल्पते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2033674, "chapter_id": 1726, "verse_number": "४-४९-५", "content_sanskrit": "देशे काले च विक्रान्तं कल्याणाय विधीयते।\nआनुकूल्येन कार्याणामुत्तरं तु विधीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2033675, "chapter_id": 1726, "verse_number": "४-४९-६", "content_sanskrit": "भारं हि रथकारस्य न व्यवस्यन्ति पण्डिताः।\nपरिचिन्त्य तु पार्थेन संनिपातो न नः क्षमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2033676, "chapter_id": 1726, "verse_number": "४-४९-७", "content_sanskrit": "एको हि शत्रून्समरे समर्थः प्रतिबाधितुम् ।\nएकः कुरूनभ्यरक्षदेकश्चाग्निमतर्पयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2033677, "chapter_id": 1726, "verse_number": "४-४९-८", "content_sanskrit": "एकश्च पञ्च वर्षाणि ब्रह्मचर्यमधारयत् ।\nएकः सुभद्रामारोप्य द्वैरथे कृष्णमाह्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2033678, "chapter_id": 1726, "verse_number": "४-४९-९", "content_sanskrit": "सैन्धवं वनवासे तु जित्वा कृष्णामथानयत् ।\nएकश्च पञ्च वर्षाणि शक्रादस्राण्यशिक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2033679, "chapter_id": 1726, "verse_number": "४-४९-१०", "content_sanskrit": "एकः सपत्नाञ्जित्वा तु कुरूणामकरोद्यशः ।\nएको गन्धर्वराजानं चित्रसेनमरिन्दमः ।\nविजिग्ये तरसा सङ्ख्ये सेनां चास्य सुदुर्जयाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2033680, "chapter_id": 1726, "verse_number": "४-४९-११", "content_sanskrit": "पाञ्चाली श्रीमती प्राप्ता क्षत्रं जित्वा स्वयंवरे ।\nआदाय गतवान्पार्थो भवान्क्वनु गतस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2033681, "chapter_id": 1726, "verse_number": "४-४९-१२", "content_sanskrit": "तथा निवातकवचाः कालकेयाश्च दानवाः ।\nदैवतैरप्यवध्यास्ते एकेन युधि पातिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2033682, "chapter_id": 1726, "verse_number": "४-४९-१३", "content_sanskrit": "एकेन हि त्वया कर्ण किं नामेह कृतं पुरा।\nएकैकेन यथा तेषां भूमिपाला वशे कृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2033683, "chapter_id": 1726, "verse_number": "४-४९-१४", "content_sanskrit": "इन्द्रोपि हि न पार्थेन संयुगे योद्धुमर्हति ।\nयस्तेनाशंसते योद्धुं कर्तव्यं तस्य भेषजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2033684, "chapter_id": 1726, "verse_number": "४-४९-१५", "content_sanskrit": "आशीविषस्य क्रुद्धस्य पाणिमुद्यम्य दक्षिणम्।\nअवमुच्य प्रदेशिन्या दंष्ट्रामादातुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2033685, "chapter_id": 1726, "verse_number": "४-४९-१६", "content_sanskrit": "अथवा कुञ्जरं मत्तमेकमेकचरं वने।\nनिरङ्कुशं समारुह्य नगरं यातुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2033686, "chapter_id": 1726, "verse_number": "४-४९-१७", "content_sanskrit": "समिद्धं पावकं चापि घृतमेदोवसाहुतम्।\nघृताक्तश्चीरवासास्त्वं मध्येनोत्सर्तुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2033687, "chapter_id": 1726, "verse_number": "४-४९-१८", "content_sanskrit": "आत्मानं यः समाबध्य कण्ठे बद्ध्वा तथा शिलाम् ।\nसमुद्रं प्रतरेद्दोर्भ्यां तत्र किं कर्ण पौरुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2033688, "chapter_id": 1726, "verse_number": "४-४९-१९", "content_sanskrit": "अकृतास्त्रः कृतास्त्रं वै बलवन्तं सुदुर्बलः।\nतादृशं कर्ण यः पार्थं योद्धुमिच्छेत्स दुर्मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2033689, "chapter_id": 1726, "verse_number": "४-४९-२०", "content_sanskrit": "अस्माभिरेव निकृतो वर्षाणीह त्रयोदश।\nसिंहः पाशविनिर्मुक्तो न नः शेषं करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2033690, "chapter_id": 1726, "verse_number": "४-४९-२१", "content_sanskrit": "एकान्ते पार्थमासीनं कूपेऽग्निमिव संवृतम् ।\nअज्ञानादभ्यवस्कन्द्य प्राप्ताः स्मो भयमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2033691, "chapter_id": 1726, "verse_number": "४-४९-२२", "content_sanskrit": "उत्सृष्टं तूलराशौ तु एकोऽग्निं शमयेत्कथम् ।\nसह युद्ध्यामहे पार्थमागतं युद्धदुर्मदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2033692, "chapter_id": 1726, "verse_number": "४-४९-२३", "content_sanskrit": "यत्ता वयं पराक्रान्ता व्यूढानीकाः प्रहारिणः।\nयुद्धायावस्थितं पार्थमागतं पाकशासनिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2033693, "chapter_id": 1726, "verse_number": "४-४९-२४", "content_sanskrit": "यत्ताः सर्वे रथश्रेष्ठं परिवार्य समन्ततः।\nषड्रथाः परिकीर्यन्तां वज्रपाणिमिवासुराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2033694, "chapter_id": 1726, "verse_number": "४-४९-२५", "content_sanskrit": "द्रोणो दुर्योधनो भीष्मो भवान्द्रौणिस्तथा वयम्।\nसर्वे युद्ध्यामहे पार्थं कर्ण मा साहसं कृथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2033695, "chapter_id": 1726, "verse_number": "४-४९-२६", "content_sanskrit": "न ह्यसंगत्य समरे पार्थं जेष्यामहे वयम्।\nसंगत्य समरे पार्थं सर्वे जेष्यमाहे वयम् ॥ २६ ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2033696, "chapter_id": 1726, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि एकोनपञ्चाशोऽध्यायः ॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]