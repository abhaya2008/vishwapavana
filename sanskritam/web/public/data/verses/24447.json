[{"id": 7004447000, "chapter_id": 24447, "verse_number": "५-३-१४१-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततो गच्छेन्महीपाल तापेश्वरमनुत्तमम् ।\nयत्र सा हरिणी सिद्धा व्याधभीता नरेश्वर॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004447001, "chapter_id": 24447, "verse_number": "५-३-१४१-२", "content_sanskrit": "जले प्रक्षिप्य गात्राणि ह्यन्तरिक्षं गता तु सा ।\nव्याधो विस्मितचित्तस्तु तां मृगीमवलोक्य च॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004447002, "chapter_id": 24447, "verse_number": "५-३-१४१-३", "content_sanskrit": "विमुच्य सशरं चापं प्रारेभे तप उत्तमम् ।\nदिव्यं वर्षसहस्रं तु व्याधेनाचरितं तपः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004447003, "chapter_id": 24447, "verse_number": "५-३-१४१-४", "content_sanskrit": "अतीते तु ततः काले परितुष्टो महेश्वरः ।\nवरं ब्रूहि महाव्याध यत्ते मनसि रोचते॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004447004, "chapter_id": 24447, "verse_number": "५-३-१४१-५", "content_sanskrit": "व्याध उवाच ।\nयदि तुष्टोऽसि देवेश यदि देयो वरो मम ।\nतव पार्श्वे महादेव वासो मे प्रतिदीयताम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004447005, "chapter_id": 24447, "verse_number": "५-३-१४१-६", "content_sanskrit": "ईश्वर उवाच ।\nएवं भवतु ते व्याध यस्त्वया काङ्क्षितो वरः ।\nदैवदेवो महादेव इत्युक्त्वान्तरधीयत ।\nगते चादर्शनं देवे स्थापयित्वा महेश्वरम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004447006, "chapter_id": 24447, "verse_number": "५-३-१४१-७", "content_sanskrit": "पूजयित्वा विधानेन गतो व्याधस्ततो दिवम् ।\nतदाप्रभृति तत्तीर्थं त्रिषु लोकेषु विश्रुतम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004447007, "chapter_id": 24447, "verse_number": "५-३-१४१-८", "content_sanskrit": "व्याधानुतापसंजातं तापेश्वरमिति श्रुतम् ।\nतत्र तीर्थे तु यः स्नात्वा सम्पूजयति शङ्करम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004447008, "chapter_id": 24447, "verse_number": "५-३-१४१-९", "content_sanskrit": "शिवलोकमवाप्नोति मामुवाच महेश्वरः ।\nये स्नाता नर्मदातोये तीर्थे तापेश्वरे नराः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004447009, "chapter_id": 24447, "verse_number": "५-३-१४१-१०", "content_sanskrit": "तापत्रयविमुक्तास्ते नात्र कार्या विचारणा ।\nअष्टम्यां च चतुर्दश्यां तृतीयायां विशेषतः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004447010, "chapter_id": 24447, "verse_number": "५-३-१४१-११", "content_sanskrit": "स्नानं समाचरेन्नित्यं सर्वपातकशान्तये॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]