[{"id": 2179004, "chapter_id": 4787, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2179005, "chapter_id": 4787, "verse_number": "१", "content_sanskrit": "कर्णस्तु समवाप्यैतदस्त्रं भार्गवनन्दनात् ।\nदुर्योधनेन सहितो मुमुदे भरतर्षभ\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2179006, "chapter_id": 4787, "verse_number": "२", "content_sanskrit": "ततः कदाचिद् राजानः समाजग्मुः स्वयंवरे ।\nकलिङ्गविषये राजन् राज्ञश्चित्राङ्गदस्य च\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2179007, "chapter_id": 4787, "verse_number": "३", "content_sanskrit": "श्रीमद् राजपुरं नाम नगरं तत्र भारत ।\nराजानः शतशस्तत्र कन्यार्थं समुपागमन्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2179008, "chapter_id": 4787, "verse_number": "४", "content_sanskrit": "श्रुत्वा दुर्योधनस्तत्र समेतान् सर्वपार्थिवान् ।\nरथेन काञ्चनाङ्गेन कर्णेन सहितो ययौ\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2179009, "chapter_id": 4787, "verse_number": "५", "content_sanskrit": "ततः स्वयंवरे तस्मिन् सम्प्रवृत्ते महोत्सवे ।\nसमापेतुर्नृपतयः कन्यार्थे नृपसत्तम\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2179010, "chapter_id": 4787, "verse_number": "६", "content_sanskrit": "शिशुपालो जरासन्धो भीष्मको चक्र एव च ।\nकपोतरोमा नीलश्च रुक्मी च दृढविक्रमः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2179011, "chapter_id": 4787, "verse_number": "७", "content_sanskrit": "सृगालश्च महाराज स्त्रीराज्याधिपतिश्च यः ।\nअशोकः शतधन्वा च भोजो वीरश्च नामतः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2179012, "chapter_id": 4787, "verse_number": "८", "content_sanskrit": "एते चान्ये च बहवो दक्षिणां दिशमाश्रिताः ।\nम्लेच्छाचार्याश्च राजानः प्राच्योदीच्याश्च भारत\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2179013, "chapter_id": 4787, "verse_number": "९", "content_sanskrit": "काञ्चनाङ्गदिनः सर्वे बद्धजाम्बूनदस्रजः ।\nसर्वे भास्वरदेहाश्च व्याघ्रा इव मदोत्कटाः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2179014, "chapter_id": 4787, "verse_number": "१०", "content_sanskrit": "ततः समुपविष्टेषु तेषु राजसु भारत ।\nविवेश रङ्गं सा कन्या धात्रीवर्षधरान्विता\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2179015, "chapter_id": 4787, "verse_number": "११", "content_sanskrit": "ततः संश्राव्यमाणेषु राज्ञा नामसु भारत ।\nअत्यक्रामद् धार्तराष्ट्रं सा कन्या वरवर्णिनी\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2179016, "chapter_id": 4787, "verse_number": "१२", "content_sanskrit": "दुर्योधनस्तु कौरव्यो नामर्षयत लङ्घनम् ।\nप्रत्यषेधच्च तां कन्यामसत्कृत्य नराधिपान्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2179017, "chapter_id": 4787, "verse_number": "१३", "content_sanskrit": "स वीर्यमदमत्तत्ववाद् भीष्मद्रोणावुपाश्रितः ।\nरथमारोप्य ता कन्यामाजुहाव नराधिपान्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2179018, "chapter_id": 4787, "verse_number": "१४", "content_sanskrit": "तमन्वयाद् रथी खड्गी बद्घगोधाङ्गुलित्रवान् ।\nर्णः शस्त्रभृतां श्रेष्ठः पृष्ठतः पुरुषर्षभ\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2179019, "chapter_id": 4787, "verse_number": "१५", "content_sanskrit": "ततो विमर्दः सुहान् राज्ञामासीद् युधिष्ठिर ।\nसन्नह्यतां तनुत्राणि रथान् योजयतामपि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2179020, "chapter_id": 4787, "verse_number": "१६", "content_sanskrit": "तेऽभ्यधावन्त सङ्क्रुद्धाः क्रणदुर्योधनावुभौ ।\nशरवर्षाणि मुञ्चन्तो मेघाः पर्वतयोरिव\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2179021, "chapter_id": 4787, "verse_number": "१७", "content_sanskrit": "कर्णस्तेषामापततामेकैकेन क्षुरेण ह ।\nधनूंषि सशरावापा न्यपातयत भूतले\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2179022, "chapter_id": 4787, "verse_number": "१८", "content_sanskrit": "ततो विधनुषः कांश्चित् कांश्चिद् उद्यतकार्मुकान् ।\nकांश्चिदुद्वहतो बाणान् रथशक्तिगदास्तथा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2179023, "chapter_id": 4787, "verse_number": "१९", "content_sanskrit": "लाघवादाकुलीकृत्य कर्णः प्रहरतां वरः ।\nहतसूतांश्च भूयिष्ठानवजिग्ये नराधिपान्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2179024, "chapter_id": 4787, "verse_number": "२०", "content_sanskrit": "ते स्वयं त्वरयन्तोऽश्वान् याहि याहीति वादिनः ।\nव्यपेयुस्ते रणं हित्वा राजानो भग्नमानसाः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2179025, "chapter_id": 4787, "verse_number": "२१", "content_sanskrit": "दुर्योधनस्तु कर्णेन पाल्यमानोऽभ्ययात् तदा ।\nहृष्टः कन्यामुपादाय नगरं नागसाह्वयम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2179026, "chapter_id": 4787, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे चतुर्थोऽध्यायः ॥ ४ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]