[{"id": 7006168000, "chapter_id": 26168, "verse_number": "१-२-२९-१", "content_sanskrit": "वायुरुवाच ।\nऋषयस्तद्वचः श्रुत्वा सूतमाहुस्तदुत्तरम् ।\nकथं वेदाः पुनर्व्यस्तास्तन्नो ब्रूहि महामते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006168001, "chapter_id": 26168, "verse_number": "१-२-२९-२", "content_sanskrit": "सूत उवाच ।\nद्वापरे तु पुरावृत्ते मनोः स्वायंभुवांतरे ।\nब्रह्मा मनुमुवाचेदं रक्षवेदं महामते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006168002, "chapter_id": 26168, "verse_number": "१-२-२९-३", "content_sanskrit": "परिवृत्तं युगं तात स्वल्पवीर्या द्विजातयः ।\nसंवृता युगदोषेण सर्वे चैव यथाक्रमम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006168003, "chapter_id": 26168, "verse_number": "१-२-२९-४", "content_sanskrit": "तस्य मानं युगवशादल्पं चैव हि दृश्यते ।\nदशसाहस्रभागेन ह्यवशिष्टं कृतोदितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006168004, "chapter_id": 26168, "verse_number": "१-२-२९-५", "content_sanskrit": "वाय तेजो बलं चाल्पं सर्वं चैव प्रणश्यति ।\nवेदक्रिया हि कार्याः स्युर्माभूद्वेदविनाशनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006168005, "chapter_id": 26168, "verse_number": "१-२-२९-६", "content_sanskrit": "वेदे नाशमनुप्राप्ते यज्ञो नाशं गमिष्यति ।\nयज्ञे नष्टे वेदनाशस्ततः सर्वं प्रणश्यति ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006168006, "chapter_id": 26168, "verse_number": "१-२-२९-७", "content_sanskrit": "आद्यो वेदश्च तुष्पादः शतसाहस्रसंमितः ।\nपुनर्दशगुणः कृष्णो यज्ञो वै सर्वकामधुक् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006168007, "chapter_id": 26168, "verse_number": "१-२-२९-८", "content_sanskrit": "एवमुक्तस्तथेत्युक्त्वा मनुर्लौकहिते रतः ।\nवेदमेकं चतुष्पादं चतुर्द्धा व्यभजत्प्रभुः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006168008, "chapter_id": 26168, "verse_number": "१-२-२९-९", "content_sanskrit": "ब्रह्मणो वचनात्तात लोकानां हितकाम्यया ।\nतदहं वर्त्तमानेन युष्माकं वेदकल्पनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006168009, "chapter_id": 26168, "verse_number": "१-२-२९-१०", "content_sanskrit": "मन्वंतरेण वक्ष्यमि व्यतीतानां प्रकल्पनम् ।\nप्रत्यक्षेण वरोक्षंवै तन्निबोधत सत्तमाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006168010, "chapter_id": 26168, "verse_number": "१-२-२९-११", "content_sanskrit": "अस्मिन्युगे तदा व्यासः पाराशर्यः परंतपः ।\nद्वैपायन इति ख्यातो विष्णोरंशः सनातनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006168011, "chapter_id": 26168, "verse_number": "१-२-२९-१२", "content_sanskrit": "ब्रह्मणा चोदितः सोऽस्मिन् वेदं वक्तुं प्रचक्रमे ।\nअथ शिष्यान्सजग्राह चतुरो वेदकारणात् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006168012, "chapter_id": 26168, "verse_number": "१-२-२९-१३", "content_sanskrit": "जैमिनिं च सुमन्तुं च वैशंपायनमेव च ।\nचतुर्थं पैलमेतेषां पंचमं लोमहर्षणम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006168013, "chapter_id": 26168, "verse_number": "१-२-२९-१४", "content_sanskrit": "ऋग्वेदश्रावकं पैलमग्रहीद्विधिवद्द्विजाः ।\nयजुर्वेदप्रवक्तारं वैशंपायनमेव च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006168014, "chapter_id": 26168, "verse_number": "१-२-२९-१५", "content_sanskrit": "जैमिनिं सामवेदार्थश्रावकं सोऽन्वपद्यत ।\nतथैवाथ र्ववेदस्य सुमंतुमृषिसत्तमम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006168015, "chapter_id": 26168, "verse_number": "१-२-२९-१६", "content_sanskrit": "इतिहासपुराणस्य कलपवाक्यस्य चैव हि ।\nमां चैव प्रतिजग्राह भगवानीश्वरः प्रभुः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006168016, "chapter_id": 26168, "verse_number": "१-२-२९-१७", "content_sanskrit": "एक आसीद्यजुर्वेदस्तं चतुर्द्धा व्यकल्पयत् ।\nचातुर्होत्रमभूत्तस्मिंस्तेन यज्ञमकल्पयत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006168017, "chapter_id": 26168, "verse_number": "१-२-२९-१८", "content_sanskrit": "आध्वर्यवं यजुर्भिस्तु ऋग्भिर्होत्रं तथैव च ।\nऔद्गात्रं सामभिश्चक्रे ब्रह्मत्वं चाप्यथर्वभिः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006168018, "chapter_id": 26168, "verse_number": "१-२-२९-१९", "content_sanskrit": "ततः स ऋच उद्धृत्य ऋग्वेदं समकल्पयत् ।\nहोतृकं कल्पयत्तेन यजुर्वेदं जगत्पतिः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006168019, "chapter_id": 26168, "verse_number": "१-२-२९-२०", "content_sanskrit": "सामभिः सामवेदं च तेनौद्गात्रमकल्पयत् ।\nरा५स्त्वथर्ववेदेन सर्वकर्माण्यकारयत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006168020, "chapter_id": 26168, "verse_number": "१-२-२९-२१", "content_sanskrit": "आख्यानैश्चाप्युपाख्यानैर्गाथाभिः कल्पजोक्तिभिः ।\nपुरामसंहितां चक्रे पुराणार्थविशारदः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006168021, "chapter_id": 26168, "verse_number": "१-२-२९-२२", "content_sanskrit": "यच्छिष्टं तु यजुर्वेदे तेन य५मयुंजत ।\nयजनात्स यजुर्वेद इति शास्त्रविनिश्चयः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006168022, "chapter_id": 26168, "verse_number": "१-२-२९-२३", "content_sanskrit": "पादानामुद्धतत्वाच्च यजूंषि विषमाणि च ।\nशतेनोद्धतवीर्यस्तु ऋत्विग्भिर्वेदपारगैः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006168023, "chapter_id": 26168, "verse_number": "१-२-२९-२४", "content_sanskrit": "प्रयुज्यते ह्यश्वमेधस्तेन वा पुष्यते तु सः ।\nऋचो गृहीत्वा पैलस्तु व्यभजत्तु द्विधा पुनः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006168024, "chapter_id": 26168, "verse_number": "१-२-२९-२५", "content_sanskrit": "द्वे कृत्वा संहिते चैव शिष्याभ्या मददाद्विबुः ।\nइंद्रप्रमत्तये चैकां द्वितीयां बाष्कलाय च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006168025, "chapter_id": 26168, "verse_number": "१-२-२९-२६", "content_sanskrit": "चतस्रः संहिताः कृत्वा बाष्कलो द्विजसत्तमः ।\nशिष्यानध्यापया मास शुश्रुषाभिरतान्हितान् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006168026, "chapter_id": 26168, "verse_number": "१-२-२९-२७", "content_sanskrit": "बोध्यां तु प्रथमां शाखां द्वितीयामग्निमातरम् ।\nपाराशरीं तृतीयां तु या५वल्क्यामथापराम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006168027, "chapter_id": 26168, "verse_number": "१-२-२९-२८", "content_sanskrit": "इंद्रप्रमतिरेकां तु संहितामृषिसत्तमः ।\nअध्यापयन्महाभागं मांडूकेयं यशस्विनम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006168028, "chapter_id": 26168, "verse_number": "१-२-२९-२९", "content_sanskrit": "स्त्यस्रवसमग्र्यं तु पुत्रं स तु महायशाः ।\nसत्यस्रवाः सत्यहितं पुत्रमध्यापयद्विभुः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006168029, "chapter_id": 26168, "verse_number": "१-२-२९-३०", "content_sanskrit": "सोऽपि सत्यहितः पुत्रं पुनरध्यापयद्द्विजाः ।\nसत्यश्रियं महात्मानं सत्य धर्मपरायणम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006168030, "chapter_id": 26168, "verse_number": "१-२-२९-३१", "content_sanskrit": "अभवंस्तस्य शिष्या वै त्रयस्तु सुमहौजसः ।\nसत्यश्रियाश्च विद्वांसः शास्त्रग्रहणतत्पराः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006168031, "chapter_id": 26168, "verse_number": "१-२-२९-३२", "content_sanskrit": "शाकल्यः प्रथमस्तेषां तस्मादन्यो रथीतरः ।\nबाष्कलिश्च भरद्वाज इति शाखाप्रवर्त्तकाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006168032, "chapter_id": 26168, "verse_number": "१-२-२९-३३", "content_sanskrit": "देवमित्रस्तु शाकल्यो ज्ञानाहंकारगर्वितः ।\nजनकस्य स यज्ञे वै विनाशामगमद्द्विजाः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006168033, "chapter_id": 26168, "verse_number": "१-२-२९-३४", "content_sanskrit": "शांशपायन उवाच ।\nकथं विनाशमगमत्स मुनिर्ज्ञानगर्वितः ।\nजनकस्याश्वमेधे तु कथ वादाऽभ्यजायत ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006168034, "chapter_id": 26168, "verse_number": "१-२-२९-३५", "content_sanskrit": "किमर्थं वाऽभवद्वादः केन सार्द्धमथापि वा ।\nएतत्सर्वं यथा वृत्तमाचक्ष्त्र विदितं तव ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006168035, "chapter_id": 26168, "verse_number": "१-२-२९-३६", "content_sanskrit": "सूत उवाच ।\nजनकस्याश्वमेधे तु महानासीत्समागमः ।\nऋषीणां हि सहस्राणि तत्राजग्मुरनेकशः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006168036, "chapter_id": 26168, "verse_number": "१-२-२९-३७", "content_sanskrit": "राजर्षेर्जनकस्याथ तं यज्ञं हि दिदृक्षवः ।\nआगतान्ब्राह्मणान्दृष्ट्वा जिज्ञासास्याभवत्ततः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006168037, "chapter_id": 26168, "verse_number": "१-२-२९-३८", "content_sanskrit": "को न्वेषां ब्राह्मणश्रेष्ठः कथं मे निश्चयो भवेत् ।\nइति निश्चित्य मनसा बुद्धिं चक्रे जनाधिपः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006168038, "chapter_id": 26168, "verse_number": "१-२-२९-३९", "content_sanskrit": "गवां सहस्रमादाय सुवर्णमधिकं ततः ।\nग्रामान्रत्नानि दासीस्छ मुनीन्प्राह नराधिपः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006168039, "chapter_id": 26168, "verse_number": "१-२-२९-४०", "content_sanskrit": "सर्वानहं प्रपन्नो वः शिरसा श्रेष्ठभागिनः ।\nयदेतदाहृतं वित्तं यो वा श्रेष्ठतमो भवेत् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006168040, "chapter_id": 26168, "verse_number": "१-२-२९-४१", "content_sanskrit": "तस्मै तदुपनीतं मे वित्त वित्तं द्विजोत्तमाः ।\nजनकस्य वचः श्रुत्वा ऋषयस्ते श्रुतिक्षमाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006168041, "chapter_id": 26168, "verse_number": "१-२-२९-४२", "content_sanskrit": "दृष्ट्वा धनं महासारं धनगृध्ना जिघृक्षवः ।\nआह्वयांचक्रिरेऽन्योन्यं वेदज्ञानमदोल्बणान् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006168042, "chapter_id": 26168, "verse_number": "१-२-२९-४३", "content_sanskrit": "मनसा गतवित्तास्ते ममैतद्धनमित्युत ।\nममैतन्न तवेत्यन्यो ब्रूहि वा किं विकत्थसे ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006168043, "chapter_id": 26168, "verse_number": "१-२-२९-४४", "content_sanskrit": "इत्येवं धनदोषेण वादांश्चकुरनेकशः ।\nअथान्यस्तत्रवै विद्वान्ब्रह्मणस्तु सुतः कविः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006168044, "chapter_id": 26168, "verse_number": "१-२-२९-४५", "content_sanskrit": "याज्ञवल्क्यो महातेजास्तपस्वी ब्रह्मवित्तमः ।\nब्रह्मणोंऽशसमुत्पन्नो वाक्यं प्रोवाच सुस्वरम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006168045, "chapter_id": 26168, "verse_number": "१-२-२९-४६", "content_sanskrit": "शिष्यं ब्रह्मविदां श्रेष्ठं धनमेतद्गृहाण वै ।\nनयस्व च गृहंवत्स ममैतन्नात्र संशयः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006168046, "chapter_id": 26168, "verse_number": "१-२-२९-४७", "content_sanskrit": "सर्ववादेष्वहं वक्ता नान्यः कश्चित्तु मत्समः ।\nयो वा न प्रीयते विद्वान्समाह्वयतु माचिरम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006168047, "chapter_id": 26168, "verse_number": "१-२-२९-४८", "content_sanskrit": "ततो ब्रह्मार्णवः क्षुब्दः समुद्र इव संप्लवे ।\nतानुवाच ततः स्वस्थो याज्ञवल्क्यो हसन्निव ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006168048, "chapter_id": 26168, "verse_number": "१-२-२९-४९", "content_sanskrit": "क्रोधं मा कार्ष्ट विद्वांसो भवंतः सत्यवादिनः ।\nवदामहे यथाशक्ति जिज्ञासंतः परस्परम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006168049, "chapter_id": 26168, "verse_number": "१-२-२९-५०", "content_sanskrit": "ततोऽभ्युपगतास्तेषां वादाः शब्दैरनेकशः ।\nसहस्रधा शुभैरर्थैः सुक्ष्मदर्शनसंभवैः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006168050, "chapter_id": 26168, "verse_number": "१-२-२९-५१", "content_sanskrit": "लोके वेदे तथाऽध्यात्मविद्यास्थानैरलंकृतैः ।\nसंत्युत्तमगुणैर्युक्ता नृपस्यापि परीक्षकाः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006168051, "chapter_id": 26168, "verse_number": "१-२-२९-५२", "content_sanskrit": "वादाः समभवंस्तत्र धनहेतोर्महात्मनाम् ।\nऋषयस्त्वेकतः सर्वे याज्ञवल्क्यस्तथैकतः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006168052, "chapter_id": 26168, "verse_number": "१-२-२९-५३", "content_sanskrit": "सर्वे ते मुनयस्तेन याज्ञवल्क्येन धीमता ।\nएकैकशस्ततः पृष्टा नैवोत्तरमथाब्रुवन् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006168053, "chapter_id": 26168, "verse_number": "१-२-२९-५४", "content_sanskrit": "स विजित्य मुनीन्सर्वान् ब्रह्मराशिर्महामतिः ।\nशाकल्यमिति होवाच वादकर्त्तारमंजसा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006168054, "chapter_id": 26168, "verse_number": "१-२-२९-५५", "content_sanskrit": "शाकल्य वद वक्तव्यं किं ध्यायन्नवतिष्ठसे ।\nपणस्तु यजमानेन बद्धो नीतो यथा धृतः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006168055, "chapter_id": 26168, "verse_number": "१-२-२९-५६", "content_sanskrit": "एवं स धर्षितस्तेन रोषात्ताम्रास्यलोचनः ।\nप्रोवाच याज्ञवल्क्यं सपुरुषं मुनिसन्निधौ ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006168056, "chapter_id": 26168, "verse_number": "१-२-२९-५७", "content_sanskrit": "त्वमस्मास्तृणवत्कृत्वा तथैवान्यान्द्विजोत्तमान् ।\nविद्याधनं महासारं स्वयंग्राहं जिघृक्षसि ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006168057, "chapter_id": 26168, "verse_number": "१-२-२९-५८", "content_sanskrit": "शाकल्येनैवमुक्तस्तु याज्ञवल्क्यस्तमब्रवीत् ।\nब्रह्मिष्ठानां बलं विद्धि विद्यातत्त्वार्थदर्शनम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006168058, "chapter_id": 26168, "verse_number": "१-२-२९-५९", "content_sanskrit": "कामस्यार्थेन संबंधस्तेनार्थं कामयामहे ।\nकामप्रश्र्नधना विप्राः कामप्रश्नं वदामहे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006168059, "chapter_id": 26168, "verse_number": "१-२-२९-६०", "content_sanskrit": "पणश्चैवास्य राजर्षेस्तस्मान्नीतं धनं मया ।\nएतच्छ्रुत्वा वचस्तस्य शाकल्यः क्रोधमूर्च्छितः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006168060, "chapter_id": 26168, "verse_number": "१-२-२९-६१", "content_sanskrit": "या५वल्क्यमथोवाच कामप्रश्नार्थकृद्वचः ।\nब्रूहीदानीं मयोद्दिष्टान्कामप्रश्नान्यथार्थतः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006168061, "chapter_id": 26168, "verse_number": "१-२-२९-६२", "content_sanskrit": "ततः समभवद्वादस्तयोर्ब्रह्मविदोर्महान् ।\nसाग्रं प्रश्नसहस्रं तु शाकल्यः सोऽकरोत्तदा ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006168062, "chapter_id": 26168, "verse_number": "१-२-२९-६३", "content_sanskrit": "याज्ञवल्क्योऽब्रवीत्सर्वमृषीणां श्रृण्वतां तदा ।\nशाकल्यस्त्वास निर्वादो याज्ञवल्क्यस्तमब्रवीत् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006168063, "chapter_id": 26168, "verse_number": "१-२-२९-६४", "content_sanskrit": "प्रश्नमेकं ममापि त्वं शाकल्य वद कामिकम् ।\nपणप्राप्यस्य वादस्य ब्रुवतोर्मृत्युरत्र वै ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006168064, "chapter_id": 26168, "verse_number": "१-२-२९-६५", "content_sanskrit": "सुसूक्ष्मज्ञानसंयुक्तं सांख्यंयोगमथापि वा ।\nअध्यात्मस्य गतिं मुख्यां ध्यानमार्गमथापि वा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006168065, "chapter_id": 26168, "verse_number": "१-२-२९-६६", "content_sanskrit": "अथ संचोदितः प्रश्नो याज्ञवल्क्येन धीमता ।\nशाकल्यस्तमविज्ञाय तथा मृत्युमवाप्तवान् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006168066, "chapter_id": 26168, "verse_number": "१-२-२९-६७", "content_sanskrit": "एवं स्मृतः स शाकल्यः प्रश्नव्याख्यानपीडितः ।\nएवं विवादः सुमहानासीत्तेषां धनार्थिनाम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006168067, "chapter_id": 26168, "verse_number": "१-२-२९-६८", "content_sanskrit": "ऋषीणामृषिभिः सार्द्धं याज्ञवल्क्यस्य चैव हि ।\nयाज्ञवल्क्यो धनं गृह्य यशो विख्याय चात्मनः ।\nजगाम वै गृहं स्वच्छं शिष्यैः परिवृतो वशी ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]