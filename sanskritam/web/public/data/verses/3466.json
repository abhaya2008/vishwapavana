[{"id": 2114712, "chapter_id": 3466, "verse_number": "", "content_sanskrit": "वारणावतं प्रति युधिष्ठिरादीनां प्रस्थानम् । पौराणामनुगमनम् । युथिष्ठिर-\nप्रार्थनया पौराणां प्रतिनिवृत्तिः । म्लेच्छभाषया विदुरस्योपदेशश्च ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2114713, "chapter_id": 3466, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2114714, "chapter_id": 3466, "verse_number": "१", "content_sanskrit": "पाण्डवास्तु रथान् युक्त्वा सदश्वैरनिलोपमैः ।\nप्रयास्यन्तस्तु भीष्मस्य पादौ जगृहुरार्तवत् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2114715, "chapter_id": 3466, "verse_number": "२", "content_sanskrit": "राज्ञश्च धृतराष्ट्रस्य द्रोणस्य च महात्मनः ।\nअन्येषां चैव वृद्धानां विदुरस्य कृपस्य च \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2114716, "chapter_id": 3466, "verse_number": "३", "content_sanskrit": "एवं सर्वान् कुरून् वृद्धानभिवाद्य धृतव्रताः ।\nसमालिङ्ग्य समांश्चापि बालैश्चाप्यभिवादिताः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2114717, "chapter_id": 3466, "verse_number": "४", "content_sanskrit": "सर्वानन्यांस्तथाऽऽपृच्छ्य यथार्हममितौजसः ।\nशोचन्तः कृपणाः सर्वे कुरून् कृत्वा प्रदक्षिणम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2114718, "chapter_id": 3466, "verse_number": "५", "content_sanskrit": "प्रकृतीरपि सर्वाश्च प्रययुर्वारणावतम् ।\nविदुरश्च महाप्राज्ञस्तथाऽन्ये कुरुपुङ्गवाः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2114719, "chapter_id": 3466, "verse_number": "६", "content_sanskrit": "पौराश्च पुरुषव्याघ्रानन्वयुः शोककर्शिताः ।\nशोचमानाः पाण्डुपुत्रानतीव भरतर्षभ \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2114720, "chapter_id": 3466, "verse_number": "७", "content_sanskrit": "ततः केचिच्चावदन् स्म ब्राह्मणा निर्भयास्तदा ।\nधृतराष्ट्रो महीपालो न च धर्मं प्रपश्यति \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2114721, "chapter_id": 3466, "verse_number": "८", "content_sanskrit": "न हि पापमपापात्मा रोचयिष्यति पाण्डवः ।\nभीमो वा बलिनां श्रेष्ठः कौन्तेयो वा धनञ्जयः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2114722, "chapter_id": 3466, "verse_number": "९", "content_sanskrit": "कुत एव महाप्राज्ञौ माद्रीपुत्रौ करिष्यतः ।\nयद् राज्यं पितृतः प्राप्तं धृतराष्ट्रः प्रबाधते \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2114723, "chapter_id": 3466, "verse_number": "१०", "content_sanskrit": "अधर्मविपुलं किन्तु भीष्मोऽयमनुवर्तते ।\nविवास्यमानानस्थाने स कौन्तेयान् नरर्षभान् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2114724, "chapter_id": 3466, "verse_number": "११", "content_sanskrit": "पितेव हि समोऽस्माकमभूच्छान्तनवः पुरा ।\nविचित्रवीर्यो राजर्षिः पाण्डुश्च कुरुनन्दनः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2114725, "chapter_id": 3466, "verse_number": "१२", "content_sanskrit": "स तस्मिन् पुरुषव्याघ्रेऽदृष्टभावं गते सति ।\nराजपुत्रानिमान् बालान् धृतराष्ट्रो न मृष्यति \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2114726, "chapter_id": 3466, "verse_number": "१३", "content_sanskrit": "ते वयं सर्वमेवेदं त्यक्त्वा ह्माशु पुरोत्तमम् ।\nदारानादाय गच्छामो यत्र याति युधिष्ठिरः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2114727, "chapter_id": 3466, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2114728, "chapter_id": 3466, "verse_number": "१४", "content_sanskrit": "तांस्तथावादिनः पौरान् दुःखितान् शोककर्शितान् ।\nउवाच परमप्रीतो धर्मराजो युधिष्ठिरः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2114729, "chapter_id": 3466, "verse_number": "१५", "content_sanskrit": "पिता मान्यो गुरुः श्रेष्ठो यदाह पृथिवीपतिः ।\nअशङ्कमानैस्तत्कार्यमस्माभिरिति नो व्रतम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2114730, "chapter_id": 3466, "verse_number": "१६", "content_sanskrit": "भवन्तः सुहृदोऽस्माकमस्मान् कृत्वा प्रदक्षिणम् ।\nआशीर्भिरभिनन्द्यास्मान् निवर्तध्वं यथागृहम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2114731, "chapter_id": 3466, "verse_number": "१७", "content_sanskrit": "यदा तु कार्यमस्माकं भवद्भिरुपपद्यते ।\nतदा करिष्यथ मम प्रियाणि च हितानि च \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2114732, "chapter_id": 3466, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2114733, "chapter_id": 3466, "verse_number": "१८", "content_sanskrit": "ते तथेति प्रतिज्ञाय कृत्वा वै तान् प्रदक्षिणम् ।\nअशीर्भिश्चाभिनन्द्यैतान् जम्मुर्नगरमेव ह \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2114734, "chapter_id": 3466, "verse_number": "१९", "content_sanskrit": "पौरेषु तु निवृत्तेषु विदुरः सर्वधर्मवित् ।\nअनुगच्छन् स कौन्तेयं बोधयंश्चेदमब्रवीत् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2114735, "chapter_id": 3466, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2114736, "chapter_id": 3466, "verse_number": "२०", "content_sanskrit": "प्राज्ञः प्राज्ञप्रलापज्ञः सम्यग्धर्मार्थदर्शिवान् ।\nविज्ञायेदं तथा कुर्याद् आपदं निस्तरेद् यया \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2114737, "chapter_id": 3466, "verse_number": "२१", "content_sanskrit": "अलोहं निशितं शस्त्रं शरीरपरिकृन्तनम् ।\nये विदन्ति न तान् घ्नन्ति प्रतिघातविदस्तथा \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2114738, "chapter_id": 3466, "verse_number": "२२", "content_sanskrit": "कक्षघ्नं शिशिरघ्नं च महाकुक्षिबलौजसम् ।\nन सहेतेति चात्मानं यो रक्षति स जीवति \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2114739, "chapter_id": 3466, "verse_number": "२३", "content_sanskrit": "नाचक्षुर्वेत्ति पन्थानं नाचक्षुर्वेत्ति वै दिशः ।\nनाधृतिर्भूतिमाप्नोति बुध्यस्वैनं प्रबोधितः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2114740, "chapter_id": 3466, "verse_number": "२४", "content_sanskrit": "नानाप्तैर्दत्तमादत्ते धीरः शस्त्रमलोहजम् ।\nश्वाविट्छरणमासाद्य प्रमुच्येत हुताशनात् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2114741, "chapter_id": 3466, "verse_number": "२५", "content_sanskrit": "चरन् मार्गान् विजानाति नक्षत्रैर्विन्दते दिशः ।\nआत्मना चात्मनः पञ्च पीडयन् न स पीड्यते \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2114742, "chapter_id": 3466, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2114743, "chapter_id": 3466, "verse_number": "२६", "content_sanskrit": "अनुशिष्ट्वा च गत्वा च कृत्वा चैतान् प्रदक्षिणम् ।\nअभिवाद्य पुनः कुन्तीं रुदन् पाण्डुमचिन्तयत् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2114744, "chapter_id": 3466, "verse_number": "२७", "content_sanskrit": "पाण्डवानाभ्यनुज्ञाय विदुरः प्रत्ययाद् गृहान् ।\nनिवृत्ते विदुरे चापि भीष्मे पौरजने तथा \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2114745, "chapter_id": 3466, "verse_number": "२८", "content_sanskrit": "अजातशत्रुमामन्त्र्य कुन्ती वचनमब्रवीत् ।\nक्षत्ता यदब्रवीद् वाक्यं जनमध्येऽबुवन्निव \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2114746, "chapter_id": 3466, "verse_number": "२९", "content_sanskrit": "त्वया च तत्तथेत्युक्तं जानीमो न च तद् वयम् ।\nयदि तच्छक्यमस्माभिः श्रोतुं न च न दोषवत् ।\nश्रोतुमिच्छामि तत् सर्वं संवादं तव तस्य च \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2114747, "chapter_id": 3466, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2114748, "chapter_id": 3466, "verse_number": "३०", "content_sanskrit": "विषादग्रेश्च बोद्धव्यमिति मां विदुरोऽबवीत् ।\nपन्थाश्च विदितः कश्चित् स्यात् शुद्ध इति चाब्रवीत् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2114749, "chapter_id": 3466, "verse_number": "३१", "content_sanskrit": "जितेन्द्रियश्च वसुधां प्राप्स्यतीति वचोऽब्रवीत् ।\nविज्ञातमिति तत् सर्वं प्रत्युक्तो विदुरो मया \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2114750, "chapter_id": 3466, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2114751, "chapter_id": 3466, "verse_number": "३२", "content_sanskrit": "अष्टमेऽहनि रोहिण्यां प्रयाताः फाल्गुनस्य ते ।\nवारणावतमासाद्य ददृशुर्नागरं जनम् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2114752, "chapter_id": 3466, "verse_number": "१४५", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि पञ्चचत्वारिंशत्यधिकशततमोऽध्यायः ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2114753, "chapter_id": 3466, "verse_number": "", "content_sanskrit": "॥ इति जतुगृहदाहपर्वणि तृतीयोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2114754, "chapter_id": 3466, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]