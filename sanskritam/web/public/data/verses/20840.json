[{"id": 7000840000, "chapter_id": 20840, "verse_number": "६-१८३-१", "content_sanskrit": "श्रीमहादेव उवाच ।\nअतः परं प्रवक्ष्यामि नवमाध्यायमादरात् ।\nसंशृणुष्व स्थिरीभूय तुहिनाचल कन्यके ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000840001, "chapter_id": 20840, "verse_number": "६-१८३-२", "content_sanskrit": "अस्ति माहिष्मतीनाम नगरी नर्मदातटे ।\nतत्रासीन्माधवो नाम द्विजन्मा स शिवो द्विजः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000840002, "chapter_id": 20840, "verse_number": "६-१८३-३", "content_sanskrit": "वेदवेदांगतत्वज्ञः कालेकालेऽतिथिप्रियः ।\nअर्जयित्वा बहुधनं विद्ययैव विशुद्धधीः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000840003, "chapter_id": 20840, "verse_number": "६-१८३-४", "content_sanskrit": "महांतमध्वरं कर्तुं समारेभे कदाचन ।\nआलंभनार्थमानीतश्छागः पूजितविग्रहः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000840004, "chapter_id": 20840, "verse_number": "६-१८३-५", "content_sanskrit": "वाचमूचे हसन्नुच्चैर्जगद्विस्मयकारकः ।\nकिमेतैर्बहुभिर्यागैर्विधिवद्विहितैरपि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000840005, "chapter_id": 20840, "verse_number": "६-१८३-६", "content_sanskrit": "विनश्वरफलैर्जन्म जरामरणहेतुभिः ।\nएतावत्यपि मे विप्र दशेयं दृश्यतामिति ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000840006, "chapter_id": 20840, "verse_number": "६-१८३-७", "content_sanskrit": "छागस्यैवं वचोतीव कुतूहलपरं जनाः ।\nनिशम्यविस्मयं याताः कृतमंडपवासिनः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000840007, "chapter_id": 20840, "verse_number": "६-१८३-८", "content_sanskrit": "ततो बद्धांजलिपुटो द्विजातिस्तिमितेक्षणः ।\nप्रणम्य श्रद्दधानस्तमपृच्छच्छागमादरात् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000840008, "chapter_id": 20840, "verse_number": "६-१८३-९", "content_sanskrit": "द्विज उवाच ।\nकिं जातीयः किमात्मा त्वं किं वृत्तमिति मे वद ।\nकेन वा कर्मणा वासीच्छागत्वमिति कारणम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000840009, "chapter_id": 20840, "verse_number": "६-१८३-१०", "content_sanskrit": "छाग उवाच ।\nआसं पुरा द्विजातीनामन्वये चातिनिर्मले ।\nआहर्ता क्रतुसंघानां वेदविद्याविशारदः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000840010, "chapter_id": 20840, "verse_number": "६-१८३-११", "content_sanskrit": "एकदा मम गेहिन्या पुत्ररोगप्रशांतये ।\nछागः प्रयाचितो मत्तः चंडिकाभक्तिनम्रया ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000840011, "chapter_id": 20840, "verse_number": "६-१८३-१२", "content_sanskrit": "ततो निहन्यमानस्य चंडिकामंडपस्थले ।\nछागस्य जननी मां तु शशाप ब्रह्मवादिनी ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000840012, "chapter_id": 20840, "verse_number": "६-१८३-१३", "content_sanskrit": "अशास्त्रीयाध्वना पाप मत्सुतं यज्जिघांससि ।\nद्विजात्यधमतेन त्वमजा योनिमवाप्स्यसि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000840013, "chapter_id": 20840, "verse_number": "६-१८३-१४", "content_sanskrit": "ततोऽहं प्रेत्यकालेन छागोऽभूवं द्विजोत्तम ।\nनिस्तीर्य चानेकविधा योनिसंतापयातनाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000840014, "chapter_id": 20840, "verse_number": "६-१८३-१५", "content_sanskrit": "विप्र उवाच ।\nजातिस्मरत्वमप्यस्ति पशुयोनिमुपेयुषः ।\nत्वदीयजन्मशुश्रूषा कुतूहलरसोन्मुखम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000840015, "chapter_id": 20840, "verse_number": "६-१८३-१६", "content_sanskrit": "छाग उवाच ।\nमनः सर्वान्द्विजानेतानपि तत्कथयाखिलम् ।\nकदाचिन्मर्कटो भूवमाहितुंडिकशिक्षया ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000840016, "chapter_id": 20840, "verse_number": "६-१८३-१७", "content_sanskrit": "क्रीडद्भिर्वीक्षितो डिंभैर्नृत्यन्प्रतिगृहांगणे ।\nउदारानात्मनो दारान्विलोक्य तनयानपि ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000840017, "chapter_id": 20840, "verse_number": "६-१८३-१८", "content_sanskrit": "क्रियापराङ्मुखो जातस्त्यक्तनर्तनसंभ्रमः ।\nततो वर्तुलदंडैश्च दुःसहैराहितुंडिकः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000840018, "chapter_id": 20840, "verse_number": "६-१८३-१९", "content_sanskrit": "मामुच्चैस्ताडयांचक्रे रुषा लोहितलोचनः ।\nततोऽहं मूर्च्छितोऽभूवं क्षरत्क्षतजसंततिः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000840019, "chapter_id": 20840, "verse_number": "६-१८३-२०", "content_sanskrit": "आजिघ्रन्नन्नमुदकमगमं कालधर्मताम् ।\nततोऽहमासीच्छुनकः परिभ्राम्यन्गृहे गृहे ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000840020, "chapter_id": 20840, "verse_number": "६-१८३-२१", "content_sanskrit": "कुक्षिं भरिरहं मार्गे त्यक्तोच्छिष्टान्नभक्षकः ।\nकदाचिदाविशं स्वांतरात्मवेश्ममहानसम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000840021, "chapter_id": 20840, "verse_number": "६-१८३-२२", "content_sanskrit": "बुभुक्षितो भक्षयितुं स्थाली स्थापितमोदनम् ।\nजिघ्रन्भूमितलं पश्यन्दिशो दश शनैर्भयात् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000840022, "chapter_id": 20840, "verse_number": "६-१८३-२३", "content_sanskrit": "शंकमानो जनरवात्पार्श्वे च विलिहन्निव ।\nततः कदाचिदागत्य वीक्षितस्तनुजैर्निजैः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000840023, "chapter_id": 20840, "verse_number": "६-१८३-२४", "content_sanskrit": "जायया च जरत्याहं ताडितो लकुटादिभिः ।\nततो भग्नकटिर्यातो बहुशोणितमुद्वहन् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000840024, "chapter_id": 20840, "verse_number": "६-१८३-२५", "content_sanskrit": "निर्जगाम बहिर्गेहात्कथंचिन्मूर्च्छयाकुलः ।\nअंगेषु पूतिगंधेषु क्रिमिगर्भेषु कालतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000840025, "chapter_id": 20840, "verse_number": "६-१८३-२६", "content_sanskrit": "ततः कदश्वतां प्राप्तः शौंडिकस्य च वेश्मनि ।\nअश्वोभवमहं विद्वन्मृतः कालक्रमादिह ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000840026, "chapter_id": 20840, "verse_number": "६-१८३-२७", "content_sanskrit": "कदाचिच्चत्वरे तेन समानीतो जनाकुले ।\nविक्रयाय जरालीढ पतयालुरदावलि ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000840027, "chapter_id": 20840, "verse_number": "६-१८३-२८", "content_sanskrit": "जायया द्वारकायात्रां कर्तुमुद्यतयासकृत् ।\nमौल्येनाल्पीयसा क्रेतुं तुरंगं चेष्टमानया ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000840028, "chapter_id": 20840, "verse_number": "६-१८३-२९", "content_sanskrit": "जगृहेहं तया दाम्ना अल्पेन वसुना जरन् ।\nगंतुं चारभतद्वित्रैः पुत्रैरारुह्य मां समम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000840029, "chapter_id": 20840, "verse_number": "६-१८३-३०", "content_sanskrit": "शनैः शनै सरस्तीरे मग्नोऽहं गाढकर्दमे ।\nतत्राहं कुटिलग्रीवश्चापतन्कर्दमान्तरे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000840030, "chapter_id": 20840, "verse_number": "६-१८३-३१", "content_sanskrit": "ताड्यमानो मुहुः पुत्रैः लकुटोपलपाणिभिः ।\nउत्थाप्यमानो बहुधा प्राणान्मोचितवानहम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000840031, "chapter_id": 20840, "verse_number": "६-१८३-३२", "content_sanskrit": "ततो निश्चित्य मां तत्र मृतं भग्नोद्यमाः सुताः ।\nआक्रुश्य मातरं दीनां प्रावृत्य निर्ययुर्गृहम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000840032, "chapter_id": 20840, "verse_number": "६-१८३-३३", "content_sanskrit": "ततः संप्रेत्य बहुना कालेन छागतां गतः ।\nनिस्तीर्णानेकहीनोच्च योनिसंतापयातनः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000840033, "chapter_id": 20840, "verse_number": "६-१८३-३४", "content_sanskrit": "द्विज उवाच ।\nकिमनेन महाछाग दुःखजातेन नित्यशः ।\nयथावदंजसा मह्यं सुखमात्यंतिकं भवेत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000840034, "chapter_id": 20840, "verse_number": "६-१८३-३५", "content_sanskrit": "छाग उवाच ।\nआश्चर्यं कथयिष्यामि पुनरन्यदपि द्विज ।\nस्वस्थमापृच्छमानस्य तवास्ति यदि कौतुकम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000840035, "chapter_id": 20840, "verse_number": "६-१८३-३६", "content_sanskrit": "अस्ति नाम्ना कुरुक्षेत्रं नगरं मोक्षदायकम् ।\nसूर्यवंशोऽभवत्तत्र चंद्रशर्मा महीपतिः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000840036, "chapter_id": 20840, "verse_number": "६-१८३-३७", "content_sanskrit": "सूर्योपरागसमये श्रद्धया परयान्वितः ।\nदानं स कालपुरुषं दातुं समुपचक्रमे ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000840037, "chapter_id": 20840, "verse_number": "६-१८३-३८", "content_sanskrit": "समाहूय द्विजन्मानं वेदवेदांगपारगम् ।\nस्नातुं पुण्योदकैः पुण्यैर्ययौ सार्द्धं पुरोधसा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000840038, "chapter_id": 20840, "verse_number": "६-१८३-३९", "content_sanskrit": "अथोच्चैः कालपुरुषो वाचमूचे हसन्निव ।\nअन्येनैव प्रगृह्णंति क्षेत्रे चाण्वपि किंचन ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000840039, "chapter_id": 20840, "verse_number": "६-१८३-४०", "content_sanskrit": "सूर्योपरागसमये कुरुक्षेत्राभिधे स्थले ।\nदानं च कालपुरुषं जिघृक्षसि कथं द्विज ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000840040, "chapter_id": 20840, "verse_number": "६-१८३-४१", "content_sanskrit": "ज्ञात्वापि निश्चितं सर्वमेतत्पातककारकम् ।\nप्रवर्तसे कथं कर्तुं धनलोभान्धया धिया ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000840041, "chapter_id": 20840, "verse_number": "६-१८३-४२", "content_sanskrit": "इत्थमाकर्ण्य तद्वाक्यं जगद्विस्मयकारकम् ।\nकिमनेन महादानभयेनेत्यवदद्द्विजः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000840042, "chapter_id": 20840, "verse_number": "६-१८३-४३", "content_sanskrit": "एवंविध महादान पातकागाधवारिधिम् ।\nजानामि तरितुं सम्यगुपायमहमेव हि ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000840043, "chapter_id": 20840, "verse_number": "६-१८३-४४", "content_sanskrit": "ततः स्नात्वा महीपालः परिधाय च वाससी ।\nशुचिः प्रसन्नहृदयः सितमाल्यानुलेपनः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000840044, "chapter_id": 20840, "verse_number": "६-१८३-४५", "content_sanskrit": "अवलंब्य करांभोजं पार्श्ववर्तिपुरोधसः ।\nसमाययौ सेव्यमानः स तत्कालोचितैर्जनैः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000840045, "chapter_id": 20840, "verse_number": "६-१८३-४६", "content_sanskrit": "समागत्य च भूपालः संप्रादात्कालपूरुषम् ।\nयथोचितेन विधिना तस्मै भक्त्या द्विजन्मने ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000840046, "chapter_id": 20840, "verse_number": "६-१८३-४७", "content_sanskrit": "निर्भिद्य कालपुरुषहृदयं निर्दयोदयः ।\nपापात्मा निर्ययौ कश्चिच्चांडालो रक्तलोचनः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000840047, "chapter_id": 20840, "verse_number": "६-१८३-४८", "content_sanskrit": "किंच प्रापितकालस्य परनिंदारसोत्सवे ।\nनिंदा चांडालिका देहपार्श्वमागाद्द्विजन्मनः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000840048, "chapter_id": 20840, "verse_number": "६-१८३-४९", "content_sanskrit": "एतच्चांडालयुगलं निर्गत्यारुणलोचनम् ।\nततः संचरितं चक्रे प्रसह्यांगे द्विजन्मनः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000840049, "chapter_id": 20840, "verse_number": "६-१८३-५०", "content_sanskrit": "गीतानां नवमाध्यायं जपन्नेव हृदिस्थितः ।\nकंपमानं द्विजं किंचित्तूष्णीं पश्यति भूपतौ ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000840050, "chapter_id": 20840, "verse_number": "६-१८३-५१", "content_sanskrit": "अंतर्निद्राणगोविंदं कंपमानमिवांबुधिम् ।\nमरुदांदोलनैर्विद्वान्द्विजन्मा पापसंश्रयम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000840051, "chapter_id": 20840, "verse_number": "६-१८३-५२", "content_sanskrit": "ततो गीताक्षरोद्भूतैर्वैष्णवैः परिपीडितम् ।\nपलायमानं चांडालयुगलं निष्फलोद्यमम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000840052, "chapter_id": 20840, "verse_number": "६-१८३-५३", "content_sanskrit": "तन्निश्चक्राम वेगेन द्विजातेः पार्श्ववर्ति यत् ।\nशरीरे वर्त्तमानं च परनिंदारसोत्सवे ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000840053, "chapter_id": 20840, "verse_number": "६-१८३-५४", "content_sanskrit": "इत्थं कलितवृत्तांतः प्रत्यक्षं क्षितिवल्लभः ।\nपर्यपृच्छद्द्विजन्मानं विस्मयस्मेरलोचनः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000840054, "chapter_id": 20840, "verse_number": "६-१८३-५५", "content_sanskrit": "कथमापदियं घोरा निस्तीर्णा महती त्वया ।\nकं मंत्रं जपता विप्र कं वासं स्मरतासुरम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000840055, "chapter_id": 20840, "verse_number": "६-१८३-५६", "content_sanskrit": "कः पुमान्का च सा योषित्कथमेतावुपस्थितौ ।\nकथं च शांतिमापन्नावित्युदीरय मे द्विज ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000840056, "chapter_id": 20840, "verse_number": "६-१८३-५७", "content_sanskrit": "द्विज उवाच ।\nचांडालमूर्तिमासाद्य मूर्तिकिल्बिषमुल्बणम् ।\nयोषिन्मूर्त्तिमयीं निंदाद्वयमेतदवैम्यहम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000840057, "chapter_id": 20840, "verse_number": "६-१८३-५८", "content_sanskrit": "गीताया नवमाध्यायमंत्रमाला मया स्मृता ।\nतन्माहात्म्यमिदं सर्वं त्वमवेहि महीपते ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000840058, "chapter_id": 20840, "verse_number": "६-१८३-५९", "content_sanskrit": "गीताया नवमाध्यायं जपामि प्रत्यहं नृप ।\nनिस्तीर्णाश्चापदस्तेन कुप्रतिग्रहसंभवाः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000840059, "chapter_id": 20840, "verse_number": "६-१८३-६०", "content_sanskrit": "अभ्यस्य नवामाध्यायं राजा तस्माद्द्विजन्मनः ।\nतावुभावपि लेभाते परां निर्वृतिमुत्तमाम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]