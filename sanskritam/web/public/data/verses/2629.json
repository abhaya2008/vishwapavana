[{"id": 2076726, "chapter_id": 2629, "verse_number": "१२-१३४-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2076727, "chapter_id": 2629, "verse_number": "१२-१३४-१", "content_sanskrit": "`अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nअत्र कामन्दवचनं कीर्तयन्ति पुराविदः।\nप्रत्यक्षावेव धर्मार्थौ क्षत्रियस्य विजानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2076728, "chapter_id": 2629, "verse_number": "१२-१३४-२", "content_sanskrit": "तौ तु न व्यवधातव्यौ परोक्षा धर्मयातना।\nअधर्मो धर्म इत्येतद्यथा वृक्षफलं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2076729, "chapter_id": 2629, "verse_number": "१२-१३४-३", "content_sanskrit": "धर्माधर्मफले जातु ददर्शेह न कश्चन।\nवुभूषेद्बलमेवैतत्सर्वं बलवतो वशे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2076730, "chapter_id": 2629, "verse_number": "१२-१३४-४", "content_sanskrit": "श्रियं बलममात्यांश्च बलवानिह विन्दति।\nयो ह्यनाढ्यः स पतितस्तदुच्छिष्टं यदल्पकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2076731, "chapter_id": 2629, "verse_number": "१२-१३४-५", "content_sanskrit": "बह्वपथ्ये बलवति न किंचित्क्रियते भयात्।\nउभौ सत्याधिकारौ तौ त्रायेते महतो भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2076732, "chapter_id": 2629, "verse_number": "१२-१३४-६", "content_sanskrit": "अति धर्माद्बलं मन्ये बलाद्धर्मः प्रवर्तते।\nबले प्रतिष्ठितो धर्मो धरण्यामिव जंगमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2076733, "chapter_id": 2629, "verse_number": "१२-१३४-७", "content_sanskrit": "धूमो वायोरिव वशे बलं धर्मोऽनुवर्तते।\nअनीश्वरो बलं धर्मो द्रुमं वल्लीव संश्रिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2076734, "chapter_id": 2629, "verse_number": "१२-१३४-८", "content_sanskrit": "वशे बलवतां धर्मः सुखं भोगवतामिव।\nनास्त्यसाध्यं बलवतां सर्वं बलवता जितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2076735, "chapter_id": 2629, "verse_number": "१२-१३४-९", "content_sanskrit": "दुराचारः क्षीणबलः परिमाणं न गच्छति।\nअथ तस्मादुद्विजते सर्वो लोको वृकादिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2076736, "chapter_id": 2629, "verse_number": "१२-१३४-१०", "content_sanskrit": "अपध्वस्तो ह्यवमतो दुःखं जीवति जीवितम्।\nजीवितं यदधिक्षिप्तं यथैव मरणं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2076737, "chapter_id": 2629, "verse_number": "१२-१३४-११", "content_sanskrit": "यदेवमाहुः पापेन चारित्रेण विवक्षितम्।\nसुभृशं तप्यते तेन वाक्शल्येन परिक्षतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2076738, "chapter_id": 2629, "verse_number": "१२-१३४-१२", "content_sanskrit": "अत्रैतदाहुराचार्याः पापस्य परिमोक्षणे।\nत्रयीं विद्यामुपासीत तथोपासीत वै द्विजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2076739, "chapter_id": 2629, "verse_number": "१२-१३४-१३", "content_sanskrit": "प्रसादयेन्मधुरया वाचा चाप्यथ कर्मणा।\nमहामनाश्चैव भवेद्विवहेच्च महाकुले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2076740, "chapter_id": 2629, "verse_number": "१२-१३४-१४", "content_sanskrit": "इत्यस्तीति वदेदेव परेषां कीर्तयेद्गुणान्।\nजपेदुदकशीलः स्यात्पेशलो नातिजल्पकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2076741, "chapter_id": 2629, "verse_number": "१२-१३४-१५", "content_sanskrit": "ब्रह्म क्षत्रं संप्रविशेद्बहु कृत्वा सुदुष्करम्।\nउच्यमानो हि लोकेन बहु तत्तदचिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2076742, "chapter_id": 2629, "verse_number": "१२-१३४-१६", "content_sanskrit": "उपप्राप्यैवमाचारं क्षिप्रं बहुमतो भवेत्।\nसुखं च वित्तं भुञ्जीत वृत्तेनैकेन गोपयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2076743, "chapter_id": 2629, "verse_number": "१२-१३४-१७", "content_sanskrit": "`अपि तेभ्यो मृगान्हत्वा नयेच्च सततं वने।\nयस्मिन्न प्रतिगृह्णन्ति दस्युभोजनशङ्कया।\nलोके च लभते पूजां परत्रेह महत्फलम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2076744, "chapter_id": 2629, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि चतुस्त्रिंशदधिशततमोऽध्यायः॥ १३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]