[{"id": 2099927, "chapter_id": 3139, "verse_number": "१३-२६९-१", "content_sanskrit": "युधिष्ठिर उवाच।\nनाभागधेयः प्राप्नोति धनं सुबलवानपि।\nभागधेयान्वितस्त्वर्थान्कृशो बालश्च विन्दति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2099928, "chapter_id": 3139, "verse_number": "१३-२६९-२", "content_sanskrit": "नालाभकाले लभते प्रयत्नेऽपि कृते सति।\nलाभकालेऽप्रयत्नेन लभते विपुलं धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2099929, "chapter_id": 3139, "verse_number": "१३-२६९-३", "content_sanskrit": "कृतयत्नाफलाश्चैव दृश्यन्ते शतशो नराः।\nअयत्नेनैधमानाश्च दृश्यन्ते बहवो जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2099930, "chapter_id": 3139, "verse_number": "१३-२६९-४", "content_sanskrit": "यदि यत्नो भवेन्मर्त्यः स सर्वं फलमाप्नुयात्।\nनालभ्यं चोपलभ्येत नृणां भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2099931, "chapter_id": 3139, "verse_number": "१३-२६९-५", "content_sanskrit": "प्रयत्नं कृतवन्तोपि दृश्यन्ते ह्यफला नराः।\nमार्गत्यागशतैरर्थानमार्गश्चापरः सुखी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2099932, "chapter_id": 3139, "verse_number": "१३-२६९-६", "content_sanskrit": "अकार्यमसकृत्कृत्वा दृश्यन्ते ह्यधना नराः।\nधनयुक्ताः स्वकर्मस्था दृश्यन्ते चापरेऽधनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2099933, "chapter_id": 3139, "verse_number": "१३-२६९-७", "content_sanskrit": "अधीत्य नीतिशास्त्राणि नीतियुक्तो न दृश्यते।\nअनभिज्ञश्च साचिव्यं गमितः केन हेतुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2099934, "chapter_id": 3139, "verse_number": "१३-२६९-८", "content_sanskrit": "विद्यायुक्तो ह्यविद्यश्च धनवान्दुर्मतिस्तथा।\nयदि विद्यामुपाश्रित्य नरः सुखमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2099935, "chapter_id": 3139, "verse_number": "१३-२६९-९", "content_sanskrit": "न विद्वान्विद्यया हीनं वृत्त्यर्थमुपसंश्रयेत्।\nयथा पिपासां जयति पुरुषः प्राप्य वै जलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2099936, "chapter_id": 3139, "verse_number": "१३-२६९-१०", "content_sanskrit": "इष्टार्थो विद्यया ह्येव न विद्यां प्रजहेन्नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2099937, "chapter_id": 3139, "verse_number": "१३-२६९-११", "content_sanskrit": "नाप्राप्तकालो म्रियते विद्धः शरशतैरपि।\nतृणाग्रेणापि संस्पृष्टः प्राप्तकालो न जीवति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2099938, "chapter_id": 3139, "verse_number": "१३-२६९-१२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2099939, "chapter_id": 3139, "verse_number": "१३-२६९-१२", "content_sanskrit": "ईहमानः समारम्भान्यदि नासादयेद्धनम्।\nउग्रं तपः समारोहेन्न ह्यनुप्तं प्ररोहति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2099940, "chapter_id": 3139, "verse_number": "१३-२६९-१३", "content_sanskrit": "दानेन भोगी भवति मेधावी वृद्धसेवया।\nअहिंसया च दीर्घायुरिति प्राहुर्मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2099941, "chapter_id": 3139, "verse_number": "१३-२६९-१४", "content_sanskrit": "तस्माद्दद्यान्न याचेत पूजयेद्धार्मिकानपि।\nसुभाषी प्रियकृच्छान्तः सर्वसत्वाविहिंसकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2099942, "chapter_id": 3139, "verse_number": "१३-२६९-१५", "content_sanskrit": "यदा प्रमाणं प्रसवः स्वभावश्च सुखासुखे।\nदंशकीटपिपीलानां स्थिरो भव युधिष्ठिर॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2099943, "chapter_id": 3139, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकोनसप्तत्यधिकद्विशततमोऽध्यायः॥ २६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]