[{"id": 2004483, "chapter_id": 1090, "verse_number": "१-९१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2004484, "chapter_id": 1090, "verse_number": "१-९१-१", "content_sanskrit": "ततो मृगसहस्राणि हत्वा सबलवाहनः।\nतत्र मेघघनप्रख्यं सिद्धचारणसेवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2004485, "chapter_id": 1090, "verse_number": "१-९१-२", "content_sanskrit": "वनमालोकयामास नगराद्योजनद्वये।\nमृगाननुचरन्वन्याञ्श्रमेण परिपीडितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2004486, "chapter_id": 1090, "verse_number": "१-९१-३", "content_sanskrit": "मृगाननुचरन्राजा वेगेनाश्वानचोदयत्।\nराजा मृगप्रसङ्गेन वनमन्यद्विवेश ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2004487, "chapter_id": 1090, "verse_number": "१-९१-४", "content_sanskrit": "एक एवोत्तमबलः क्षुत्पिपासाश्रमान्वितः।\nस वनस्यान्तमासाद्य महच्छून्यं समासदत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2004488, "chapter_id": 1090, "verse_number": "१-९१-५", "content_sanskrit": "तच्चाप्यतीत्य नृपतिरुत्तमाश्रमसंयुतम्।\nमनःप्रह्लादजननं दृष्टिकान्तमतीव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2004489, "chapter_id": 1090, "verse_number": "१-९१-६", "content_sanskrit": "सीतमारुतसंयुक्तं जगामान्यन्महद्वनम्।\nपुष्पितैः पादपैः कीर्णमतीव सुखशाद्वलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2004490, "chapter_id": 1090, "verse_number": "१-९१-७", "content_sanskrit": "विपुलं मधुरारावैर्नादितं विहगैस्तथा।\nपुंस्कोकिलनिनादैश्च झिल्लीकगणनादितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2004491, "chapter_id": 1090, "verse_number": "१-९१-८", "content_sanskrit": "प्रवृद्धविटपैर्वृक्षैः सुखच्छायैः समावृतम्।\nषट्पदाघूर्णिततलं लक्ष्म्या परमया युतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2004492, "chapter_id": 1090, "verse_number": "१-९१-९", "content_sanskrit": "नापुष्पः पादपः कश्चिन्नाफलो नापि कण्टकी।\nषट्पदैर्नाप्यपाकीर्णस्तस्मिन्वै काननेऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2004493, "chapter_id": 1090, "verse_number": "१-९१-१०", "content_sanskrit": "विगहैर्नादितं पुष्पैरलङ्कृतमतीव च।\nसर्वर्तुकुसुमैर्वृक्षैः सुखच्छायैः समावृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2004494, "chapter_id": 1090, "verse_number": "१-९१-११", "content_sanskrit": "मनोरमं सहेष्वासो विवेश वनमुत्तमम्।\nमारुता कलितास्तत्र द्रुमाः कुसुमशाखिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2004495, "chapter_id": 1090, "verse_number": "१-९१-१२", "content_sanskrit": "पुष्पवृष्टिं विचित्रां तु व्यसजंस्ते पुनः पुनः।\nदिवस्पृशोऽथ संघुष्टाः पक्षिभिर्मधुरस्वनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2004496, "chapter_id": 1090, "verse_number": "१-९१-१३", "content_sanskrit": "विरेजुः पादपास्तत्र विचित्रकुसुमाम्बराः।\nतेषां तत्र प्रवालेषु पुष्पभारावनामिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2004497, "chapter_id": 1090, "verse_number": "१-९१-१४", "content_sanskrit": "रुवन्ति रावान्मधुरान्षट्पदा मधुलिप्सवः।\nतत्र प्रदेशांश्च बहून्कुसुमोत्करमण्डितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2004498, "chapter_id": 1090, "verse_number": "१-९१-१५", "content_sanskrit": "लतागृहपरिक्षिप्तान्मनसः प्रीतिवर्धनान्।\nसंपश्यन्सुमहातेजा बभूव मुदितस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2004499, "chapter_id": 1090, "verse_number": "१-९१-१६", "content_sanskrit": "परस्पराश्लिष्टशाखैः पादपैः कुसुमान्वितैः।\nअशोभत वनं तत्तु महेन्द्रध्वजसन्निभैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2004500, "chapter_id": 1090, "verse_number": "१-९१-१७", "content_sanskrit": "सिद्धचारणसङ्घैश्च गन्धर्वाप्सरसां गणैः।\nसेवितं वनमत्यर्थं मत्तवानरकिन्नरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2004501, "chapter_id": 1090, "verse_number": "१-९१-१८", "content_sanskrit": "सुखः शीतः सुगन्धी च पुष्परेणुवहोऽनिलः।\nपरिक्रामन्वने वृक्षानुपैतीव रिरंसया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2004502, "chapter_id": 1090, "verse_number": "१-९१-१९", "content_sanskrit": "एवंगुणसमायुक्तं ददर्श स वनं नृपः।\nनदीकच्छोद्भं कान्तमुच्छ्रितध्वजसन्निभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2004503, "chapter_id": 1090, "verse_number": "१-९१-२०", "content_sanskrit": "प्रेक्षमाणो वनं तत्तु सुप्रहृष्टविहङ्गमम्।\nआश्रमप्रवरं रम्यं ददर्श च मनोरमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2004504, "chapter_id": 1090, "verse_number": "१-९१-२१", "content_sanskrit": "नानावृक्षसमाकीर्णं संप्रज्वलितपावकम्।\nतं तदाऽप्रतिमं श्रीमानाश्रमं प्रत्यपूजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2004505, "chapter_id": 1090, "verse_number": "१-९१-२२", "content_sanskrit": "यतिभिर्वालखिल्यैश्च वृतं मुनिगणान्वितम्।\nअग्न्यगारैश्च बहुभिः पुष्पसंस्तरसंस्तृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2004506, "chapter_id": 1090, "verse_number": "१-९१-२३", "content_sanskrit": "महाकच्छैर्बृहद्भिश्च विभ्राजितमतीव च।\nमालिनीमभितो राजन्नदीं पुण्यां सुखोदकाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2004507, "chapter_id": 1090, "verse_number": "१-९१-२४", "content_sanskrit": "नैकपक्षिगणाकीर्णां तपोवनमनोरमाम्।\nतत्रव्यालमृगान्सैम्यान्पश्यन्प्रीतिमवाप सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2004508, "chapter_id": 1090, "verse_number": "१-९१-२५", "content_sanskrit": "तं चाप्रतिरथः श्रीमानाश्रमं प्रत्यपद्यत।\nदेवलोकप्रतीकाशं सर्वतः सुमनोहरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2004509, "chapter_id": 1090, "verse_number": "१-९१-२६", "content_sanskrit": "नदीं चाश्रमसंश्लिष्टां पुण्यतोयां ददर्श सः।\nसर्वप्राणभृतां तत्र जननीमिव धिष्ठिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2004510, "chapter_id": 1090, "verse_number": "१-९१-२७", "content_sanskrit": "सचक्रवाकपुलिनां पुष्पफेनप्रवाहिनीम्।\nसकिन्नरगणावासां वारनर्क्षनिषेविताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2004511, "chapter_id": 1090, "verse_number": "१-९१-२८", "content_sanskrit": "पुण्यस्वाध्यायसंघुष्टा पुलिनैरुपशोभिताम्।\nमत्तवारणशार्दूलभुजगेन्द्रनिषेविताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2004512, "chapter_id": 1090, "verse_number": "१-९१-२९", "content_sanskrit": "तस्यास्तीरे भगवतः काश्यपस्य महात्मनः।\nआश्रमप्रवरं रम्यं महर्षिगणसेवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2004513, "chapter_id": 1090, "verse_number": "१-९१-३०", "content_sanskrit": "नदीमाश्रमसंबद्धां दृष्ट्वाश्रमपदं तथा।\nचकाराभिप्रवेशाय मतिं स नृपतिस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2004514, "chapter_id": 1090, "verse_number": "१-९१-३१", "content_sanskrit": "अलङ्कृतं द्वीपवत्या मालिन्या रम्यतीरया।\nनरनारायणस्थानं गङ्गयेवोपशोभितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2004515, "chapter_id": 1090, "verse_number": "१-९१-३२", "content_sanskrit": "मत्तबर्हिणसंघुष्टं प्रविवेश महद्वनम्।\nतत्स चैत्ररथप्रख्यं समुपेत्य नरर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2004516, "chapter_id": 1090, "verse_number": "१-९१-३३", "content_sanskrit": "अतीव गुणसंपन्नमनिर्देश्यं च वर्चसा।\nमहर्षिं काश्यपं द्रष्टुमथ कण्वं तपोधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2004517, "chapter_id": 1090, "verse_number": "१-९१-३४", "content_sanskrit": "ध्वजिनीमश्वसंबाधां पदातिगजसङ्कुलाम्।\nअवस्थाप्य वनद्वारि सेनामिदमुवाच सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2004518, "chapter_id": 1090, "verse_number": "१-९१-३५", "content_sanskrit": "मुनिं विरजसं द्रष्टुं गमिष्यामि तपोधनम्।\nकाश्यपं स्थीयतामत्र यावदागमनं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2004519, "chapter_id": 1090, "verse_number": "१-९१-३६", "content_sanskrit": "तद्वनं नन्दनप्रख्यमासाद्य मनुजेश्वरः॥\nक्षुत्पिपासे जहौ राजा मुदं चावाप पुष्कलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2004520, "chapter_id": 1090, "verse_number": "१-९१-३७", "content_sanskrit": "सामात्यो राजलिङ्गानि सोपनीय नराधिपः।\nपुरोहितसहायश्च जगामाश्रममुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2004521, "chapter_id": 1090, "verse_number": "१-९१-३८", "content_sanskrit": "दिदृक्षुस्तत्र तमृषिं तपोराशिमथाव्ययम्।\nब्रह्मलोकप्रतीकाशमाश्रमं सोऽभिवीक्ष्य ह।\nषट्पदोद्गीतसंघुष्टं नानाद्विजगणायुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2004522, "chapter_id": 1090, "verse_number": "१-९१-३९", "content_sanskrit": "विस्मयोत्फुल्लनयनो राजा प्रीतो बभूवह।\nऋचो बह्वृचमुख्यैश्च प्रेर्यमाणाः पदक्रमैः।\nशुश्राव मनुजव्याघ्रो विततेष्विह कर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2004523, "chapter_id": 1090, "verse_number": "१-९१-४०", "content_sanskrit": "यज्ञविद्याङ्गविद्भिश्च यजुर्विद्भिश्च शोभितम्।\nमधुरैः सामगीतैश्च ऋषिभिर्नियतव्रतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2004524, "chapter_id": 1090, "verse_number": "१-९१-४१", "content_sanskrit": "भारुण्डसामगीताभिरथर्वशिरसोद्गतैः।\nयतात्मभिः सुनियतैः शुशुभे स तदाश्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2004525, "chapter_id": 1090, "verse_number": "१-९१-४२", "content_sanskrit": "अथर्ववेदप्रवराः पूगयज्ञियसामगाः।\nसंहितामीरयन्ति स्म पदक्रमयुतां तु ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2004526, "chapter_id": 1090, "verse_number": "१-९१-४३", "content_sanskrit": "शब्दसंस्कारसंयुक्तर्ब्रुवद्भिश्चापरैर्द्विजैः।\nनादितः स बभौ श्रीमान्ब्रह्मलोक इवापरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2004527, "chapter_id": 1090, "verse_number": "१-९१-४४", "content_sanskrit": "यज्ञसंस्तरविद्भिश्च क्रमशिक्षाविशारदैः।\nन्यायतत्त्वात्मविज्ञानसंपन्नैर्वेदपारगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2004528, "chapter_id": 1090, "verse_number": "१-९१-४५", "content_sanskrit": "नानावाक्यसमाहारसमवायविशारदैः।\nविशेषकार्यविद्भिश्च मोक्षधर्मपरायणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2004529, "chapter_id": 1090, "verse_number": "१-९१-४६", "content_sanskrit": "स्तापनाक्षेपसिद्धान्तपरमार्थज्ञतां गतैः।\nशब्दच्छन्दोनिरुक्तज्ञैः कालज्ञानविशारदैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2004530, "chapter_id": 1090, "verse_number": "१-९१-४७", "content_sanskrit": "द्रव्यकर्मगुणज्ञैश्च कार्यकारणवेदिभिः।\nपक्षिवानररुतज्ञैश्च व्यासग्रन्थसमाश्रितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2004531, "chapter_id": 1090, "verse_number": "१-९१-४८", "content_sanskrit": "नानाशास्त्रेषु मुख्यैश्च शुश्राव स्वनमीरितम्।\nलोकायतिकमुख्यैश्च समन्तादनुनादितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2004532, "chapter_id": 1090, "verse_number": "१-९१-४९", "content_sanskrit": "तत्रतत्र च विप्रेन्द्रान्नियतान्संशितव्रतान्।\nजपहोमपरान्विप्रान्ददर्श परवीरहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2004533, "chapter_id": 1090, "verse_number": "१-९१-५०", "content_sanskrit": "आसनानि विचित्राणि रुचिराणि महीपतिः।\nप्रयत्नोपहितानि स्म दृष्ट्वा विस्मयमागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2004534, "chapter_id": 1090, "verse_number": "१-९१-५१", "content_sanskrit": "देवतायतनानां च प्रेक्ष्य पूजां कृतां द्विजैः।\nब्रह्मलोकस्थमात्मानं मेने स नृपसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2004535, "chapter_id": 1090, "verse_number": "१-९१-५२", "content_sanskrit": "स काश्यपतपोगुप्तमाश्रमप्रवरं शुभम्।\nनातृप्यत्प्रेक्षमाणो वै तपोवनगुणैर्युतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2004536, "chapter_id": 1090, "verse_number": "१-९१-५३", "content_sanskrit": "स काश्यपस्यायतनं महाव्रतै-\nर्वृतं समान्तादृषिभिस्तपोधनैः।\nविवेश सामात्यपुरोहितोऽरिहा\nविविक्तमत्यर्थमनोहरं शुभम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2004537, "chapter_id": 1090, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि एकनवतितमोऽध्यायः॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]