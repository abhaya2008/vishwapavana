[{"id": 5000379000, "chapter_id": 9379, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000379001, "chapter_id": 9379, "verse_number": "५-४०-१", "content_sanskrit": "श्रुत्वा तु वचनं तस्य वायुसूनोर्महात्मनः।\nउवाचात्महितं वाक्यं सीता सुरसुतोपमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000379002, "chapter_id": 9379, "verse_number": "५-४०-२", "content_sanskrit": "त्वां दृष्ट्वा प्रियवक्तारं सम्प्रहृष्यामि वानर।\nअर्धसंजातसस्येव वृष्टिं प्राप्य वसुंधरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000379003, "chapter_id": 9379, "verse_number": "५-४०-३", "content_sanskrit": "यथा तं पुरुषव्याघ्रं गात्रैः शोकाभिकर्शितैः।\nसंस्पृशेयं सकामाहं तथा कुरु दयां मयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000379004, "chapter_id": 9379, "verse_number": "५-४०-४", "content_sanskrit": "अभिज्ञानं च रामस्य दद्या हरिगणोत्तम।\nक्षिप्तामिषीकां काकस्य कोपादेकाक्षिशातनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000379005, "chapter_id": 9379, "verse_number": "५-४०-५", "content_sanskrit": "मनःशिलायास्तिलको गण्डपार्श्वे निवेशितः।\nत्वया प्रणष्टे तिलके तं किल स्मर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000379006, "chapter_id": 9379, "verse_number": "५-४०-६", "content_sanskrit": "स वीर्यवान् कथं सीतां हृतां समनुमन्यसे।\nवसन्तीं रक्षसां मध्ये महेन्द्रवरुणोपम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000379007, "chapter_id": 9379, "verse_number": "५-४०-७", "content_sanskrit": "एष चूडामणिर्दिव्यो मया सुपरिरक्षितः।\nएतं दृष्ट्वा प्रहृष्यामि व्यसने त्वामिवानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000379008, "chapter_id": 9379, "verse_number": "५-४०-८", "content_sanskrit": "एष निर्यातितः श्रीमान् मया ते वारिसम्भवः।\nअतः परं न शक्ष्यामि जीवितुं शोकलालसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000379009, "chapter_id": 9379, "verse_number": "५-४०-९", "content_sanskrit": "असह्यानि च दुःखानि वाचश्च हृदयच्छिदः।\nराक्षसैः सह संवासं त्वत्कृते मर्षयाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000379010, "chapter_id": 9379, "verse_number": "५-४०-१०", "content_sanskrit": "धारयिष्यामि मासं तु जीवितं शत्रुसूदन।\nमासादूर्ध्वं न जीविष्ये त्वया हीना नृपात्मज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000379011, "chapter_id": 9379, "verse_number": "५-४०-११", "content_sanskrit": "घोरो राक्षसराजोऽयं दृष्टिश्च न सुखा मयि।\nत्वां च श्रुत्वा विषज्जन्तं न जीवेयमपि क्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000379012, "chapter_id": 9379, "verse_number": "५-४०-१२", "content_sanskrit": "वैदेह्या वचनं श्रुत्वा करुणं साश्रुभाषितम्।\nअथाब्रवीन्महातेजा हनूमान् मारुतात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000379013, "chapter_id": 9379, "verse_number": "५-४०-१३", "content_sanskrit": "त्वच्छोकविमुखो रामो देवि सत्येन ते शपे।\nरामे शोकाभिभूते तु लक्ष्मणः परितप्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000379014, "chapter_id": 9379, "verse_number": "५-४०-१४", "content_sanskrit": "दृष्टा कथंचिद् भवती न कालः परिदेवितुम्।\nइमं मुहूर्तं दुःखानामन्तं द्रक्ष्यसि भामिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000379015, "chapter_id": 9379, "verse_number": "५-४०-१५", "content_sanskrit": "तावुभौ पुरुषव्याघ्रौ राजपुत्रावनिन्दितौ।\nत्वद्दर्शनकृतोत्साहौ लङ्कां भस्मीकरिष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000379016, "chapter_id": 9379, "verse_number": "५-४०-१६", "content_sanskrit": "हत्वा तु समरे रक्षो रावणं सहबान्धवैः।\nराघवौ त्वां विशालाक्षि स्वां पुरीं प्रति नेष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000379017, "chapter_id": 9379, "verse_number": "५-४०-१७", "content_sanskrit": "यत्तु रामो विजानीयादभिज्ञानमनिन्दिते।\nप्रीतिसंजननं भूयस्तस्य त्वं दातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000379018, "chapter_id": 9379, "verse_number": "५-४०-१८", "content_sanskrit": "साब्रवीद् दत्तमेवाहो मयाभिज्ञानमुत्तमम्।\nएतदेव हि रामस्य दृष्ट्वा यत्नेन भूषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000379019, "chapter_id": 9379, "verse_number": "५-४०-१९", "content_sanskrit": "श्रद्धेयं हनुमन् वाक्यं तव वीर भविष्यति।\nस तं मणिवरं गृह्य श्रीमान् प्लवगसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000379020, "chapter_id": 9379, "verse_number": "५-४०-२०", "content_sanskrit": "प्रणम्य शिरसा देवीं गमनायोपचक्रमे।\nतमुत्पातकृतोत्साहमवेक्ष्य हरियूथपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000379021, "chapter_id": 9379, "verse_number": "५-४०-२१", "content_sanskrit": "वर्धमानं महावेगमुवाच जनकात्मजा।\nअश्रुपूर्णमुखी दीना बाष्पगद‍्गदया गिरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000379022, "chapter_id": 9379, "verse_number": "५-४०-२२", "content_sanskrit": "हनूमन् सिंहसंकाशौ भ्रातरौ रामलक्ष्मणौ।\nसुग्रीवं च सहामात्यं सर्वान् ब्रूया अनामयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000379023, "chapter_id": 9379, "verse_number": "५-४०-२३", "content_sanskrit": "यथा च स महाबाहुर्मां तारयति राघवः।\nअस्माद् दुःखाम्बुसंरोधात् त्वं समाधातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000379024, "chapter_id": 9379, "verse_number": "५-४०-२४", "content_sanskrit": "इदं च तीव्रं मम शोकवेगं\nरक्षोभिरेभिः परिभर्त्सनं च।\nब्रूयास्तु रामस्य गतः समीपं\nशिवश्च तेऽध्वास्तु हरिप्रवीर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000379025, "chapter_id": 9379, "verse_number": "५-४०-२५", "content_sanskrit": "स राजपुत्र्या प्रतिवेदितार्थः\nकपिः कृतार्थः परिहृष्टचेताः।\nतदल्पशेषं प्रसमीक्ष्य कार्यं\nदिशं ह्युदीचीं मनसा जगाम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000379026, "chapter_id": 9379, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]