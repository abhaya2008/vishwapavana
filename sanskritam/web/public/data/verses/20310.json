[{"id": 7000310000, "chapter_id": 20310, "verse_number": "१-६४-१", "content_sanskrit": "व्यास उवाच ।\nपुनरन्यत्प्रवक्ष्यामि स्तोत्रं गणाधिपस्य च ।\nसर्वसिद्धिकरं पूतं सर्वाभीष्टफलप्रदं॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000310001, "chapter_id": 20310, "verse_number": "१-६४-२", "content_sanskrit": "एकदंतं महाकायं तप्तकांचनसन्निभम् ।\nलंबोदरं विशालाक्षं वंदेहं गणनायकं॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000310002, "chapter_id": 20310, "verse_number": "१-६४-३", "content_sanskrit": "मुंजकृष्णाजिनधरं नागयज्ञोपवीतकम् ।\nबालेंदुकलिकामौलिं वंदेहं गणनायकं॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000310003, "chapter_id": 20310, "verse_number": "१-६४-४", "content_sanskrit": "सर्वविघ्नहरं देवं सर्वविघ्नविवर्जितम् ।\nमूषकोत्तममारुह्य देवासुरमहाहवे॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000310004, "chapter_id": 20310, "verse_number": "१-६४-५", "content_sanskrit": "योद्धुकामं महाबाहुं वंदेहं गणनायकम् ।\nअंबिकाहृदयानंदं मातृकापरिवेष्टितम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000310005, "chapter_id": 20310, "verse_number": "१-६४-६", "content_sanskrit": "भक्तिप्रियं मदोन्मत्तं वंदेहं गणनायकम् ।\nचित्ररत्नविचित्रांगं चित्रमालाविभूषणम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000310006, "chapter_id": 20310, "verse_number": "१-६४-७", "content_sanskrit": "कामरूपधरं देवं वंदेहं गणनायकम् ।\nगजवक्त्रं सुरश्रेष्ठं चारुकर्णविभूषितम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000310007, "chapter_id": 20310, "verse_number": "१-६४-८", "content_sanskrit": "पाशांकुशधरं देवं वंदेहं गणनायकम् ।\nयक्षकिन्नरगंधर्वैः सिद्धविद्याधरैस्सदा॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000310008, "chapter_id": 20310, "verse_number": "१-६४-९", "content_sanskrit": "स्तूयमानं महादेहं वंदेहं गणनायकम् ।\nगणाष्टकमिदं पुण्यं भक्तितो यः पठेन्नरः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000310009, "chapter_id": 20310, "verse_number": "१-६४-१०", "content_sanskrit": "सर्वसिद्धिमवाप्नोति रुद्रलोके महीयते ।\nन निःस्वतां तथाभ्येति सप्तजन्मसु मानवः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000310010, "chapter_id": 20310, "verse_number": "१-६४-११", "content_sanskrit": "य इदं पठते नित्यं महाराजो भवेन्नरः ।\nवश्यं करोति त्रैलोक्यं पठनाच्छ्रवणादपि ।\nस्तोत्रं परं महापुण्यं गणपस्य महात्मनः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]