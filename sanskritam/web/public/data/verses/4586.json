[{"id": 2166927, "chapter_id": 4586, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2166928, "chapter_id": 4586, "verse_number": "१", "content_sanskrit": "आख्याता मामकास्तात निहता युधि पाण्डवैः ।\nमामकैर्निहतान् ब्रूहि पाण्डवेयांस्तु सञ्जय\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2166929, "chapter_id": 4586, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2166930, "chapter_id": 4586, "verse_number": "२", "content_sanskrit": "कृतिनो युधि विक्रान्ता महासत्त्वा महाबलाः ।\nसानुबन्धाः सहामात्या भीष्मेण युधि पातिताः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2166931, "chapter_id": 4586, "verse_number": "३", "content_sanskrit": "नारायणा वल्लवाश्च शूराश्च शतशोऽपरे ।\nअनुरक्ताश्च वीरेण भीष्मेण निहता रणे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2166932, "chapter_id": 4586, "verse_number": "४", "content_sanskrit": "समः किरीटिना सङ्खे वीर्येण च बलेन च ।\nसत्यजित् सत्यसन्धेन द्रोणेन निहतो युधि\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2166933, "chapter_id": 4586, "verse_number": "५", "content_sanskrit": "पाञ्चालाश्च महेष्वासाः प्रायो राजन्नमर्षिणः ।\nद्रोणेन सह सङ्गम्य गता वैवस्वतक्षयम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2166934, "chapter_id": 4586, "verse_number": "६", "content_sanskrit": "तथा विराटद्रुपदौ वृद्धौ सहसुतौ नृप ।\nपराक्रान्तौ च मित्रार्थे द्रोणेन निहतौ युधि\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2166935, "chapter_id": 4586, "verse_number": "७", "content_sanskrit": "यो बाल एव समरे सम्मितः सव्यसाचिना ।\nकेशवेन च दुर्धर्षो बलदेवेन चाभिभूः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2166936, "chapter_id": 4586, "verse_number": "८", "content_sanskrit": "परेषां कदनं कृत्वा महद् रणविशारदः ।\nपरिवार्य महामात्रैः षड्भिः परमकैः रथैः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2166937, "chapter_id": 4586, "verse_number": "९", "content_sanskrit": "अशक्नुवद्भिर्बीभत्सुमभिमन्युरभिद्रुतः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2166938, "chapter_id": 4586, "verse_number": "१०", "content_sanskrit": "तं कृतं विरथं वीरं क्षत्रधर्मे व्यवस्थितम् ।\nदौःशासनिर्महाराज सौभद्रं हतवान् रणे\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2166939, "chapter_id": 4586, "verse_number": "११", "content_sanskrit": "पाटच्चरान् निहन्ता तु महत्या सेनया वृतः ।\nअम्बष्ठस्य सुतः श्रीमान् मित्रहेतोः पराक्रमन्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2166940, "chapter_id": 4586, "verse_number": "१२", "content_sanskrit": "आसाद्य लक्षणं वीरं दुर्योधनसुतं रणे ।\nसुमहत् कदनं कृत्वा गतो वैवस्वतक्षयम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2166941, "chapter_id": 4586, "verse_number": "१३", "content_sanskrit": "बृहन्तस्तु महाराज कृतास्त्रो युद्धदुर्मदः ।\nदुःशासनेन विक्रम्य गमितो यमसादनम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2166942, "chapter_id": 4586, "verse_number": "१४", "content_sanskrit": "मणिमान् दण्डधारश्च राजानौ युद्धदुर्मदौ ।\nपराक्रान्तौ तु मित्रार्थे द्रोणेन युधि पातितौ\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2166943, "chapter_id": 4586, "verse_number": "१५", "content_sanskrit": "अंशुमान् भोजराजश्च सहसैन्यौ महारथौ ।\nभारद्वाजेन विक्रम्य गमितौ यमसादनम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2166944, "chapter_id": 4586, "verse_number": "१६", "content_sanskrit": "सामुद्रश्चित्रसेनश्च सह पुत्रेण भारत ।\nसमुद्रसेनेन बलाद् गमितो यमसादनम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2166945, "chapter_id": 4586, "verse_number": "", "content_sanskrit": "(अनूपवासी नीलश्च व्याघ्रदत्तश्च वीर्यवान् ।\nअश्वत्थाम्ना विकर्णेन गमितौ यमसादनम्\t॥१७॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2166946, "chapter_id": 4586, "verse_number": "१८", "content_sanskrit": "चित्रायुधश्चित्रवर्मा कृत्वाऽऽजौ कदनं महत् ।\nचित्रमार्गेण विक्रम्य विकर्णेन हतौ युधि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2166947, "chapter_id": 4586, "verse_number": "१९", "content_sanskrit": "आतपग्रासी वीरश्च व्याघ्रदन्तः सुवीर्यवान् ।\nअश्वत्थाम्ना महाराज गमितो यमसादनम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2166948, "chapter_id": 4586, "verse_number": "२०", "content_sanskrit": "वृकोदरसमो युद्धे वृकः केकयजो युधि ।\nकेकयेन च विक्रम्य भ्राता भ्रात्रा निपातितः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2166949, "chapter_id": 4586, "verse_number": "२१", "content_sanskrit": "जनमेजयो हि विक्रान्तः पार्वतीयः प्रतापवान् ।\nदुर्मुखेन महाराज तव पुत्रेण पातितः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2166950, "chapter_id": 4586, "verse_number": "२२", "content_sanskrit": "रोचमानौ नृपश्रेष्ठौ रोचमानौ ग्रहाविव ।\nद्रोणेन युगपद् राजन् दिवं सम्प्रापितौ शरैः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2166951, "chapter_id": 4586, "verse_number": "२३", "content_sanskrit": "नृपाश्चान्ये प्रयुध्यन्तः पराक्रान्ता महीपते ।\nकृत्वा ह्यसुकरं कर्म गता वैवस्वतक्षयम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2166952, "chapter_id": 4586, "verse_number": "२४", "content_sanskrit": "पुरुजित् कुन्तिभोजश्च मातुलौ सव्यसाचिनः ।\nसङ्ग्रामे निर्जितान् लोकान् गमितौ द्रोणसायकैः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2166953, "chapter_id": 4586, "verse_number": "२५", "content_sanskrit": "अभिभूः काशिराजश्च काशिकैर्बहुभिर्वृतः ।\nवसुदानस्य पुत्रेण त्याजितो देहमाहवे\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2166954, "chapter_id": 4586, "verse_number": "२६", "content_sanskrit": "अमितौजा जयत्सेनो जयानीकश्च वीर्यवान् ।\nलक्ष्मणेन हतौ राजन् तव पौत्रेण मारिष\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2166955, "chapter_id": 4586, "verse_number": "२७", "content_sanskrit": "वृद्धक्षत्रो महेष्वासः क्षत्रदेवश्च वीर्यवान् ।\nनिहत्य शात्रवान् शूरान् परैः विनिहतौ युधि\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2166956, "chapter_id": 4586, "verse_number": "२८", "content_sanskrit": "क्षत्रधर्मश्च पाञ्चाल्यः मित्रधर्मश्च भारत ।\nद्रोणेन परमेष्वासौ गमितौ यमसादनम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2166957, "chapter_id": 4586, "verse_number": "२९", "content_sanskrit": "शिखण्डितनयो युद्धे क्षत्रदेवो युधाम्पतिः ।\nलक्ष्मणेन हतो राजन् तव पौत्रेण मारिष\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2166958, "chapter_id": 4586, "verse_number": "३०", "content_sanskrit": "सुचित्रश्चित्रवर्मा च पितापुत्रौ महारथौ ।\nप्रहरन्तौ रणे वीरौ द्रोणेन निहतौ नृप\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2166959, "chapter_id": 4586, "verse_number": "३१", "content_sanskrit": "वार्धक्षेमिर्महाराज समुद्र इव पर्वणि ।\nआयुधक्षयमासाद्य प्रशान्तिं परमां गतः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2166960, "chapter_id": 4586, "verse_number": "३२", "content_sanskrit": "सेनाबिन्दुर्नृपश्रेष्ठः शात्रवान् प्रतपन् युधि ।\nबाह्लिकेन महाराज कौरवेन्द्रेण पातितः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2166961, "chapter_id": 4586, "verse_number": "३३", "content_sanskrit": "धृष्टकेतुर्महाराज चेदीनां प्रवरो रणे ।\nकृत्वा नसुकरं कर्म गतो वैवस्वतक्षयम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2166962, "chapter_id": 4586, "verse_number": "३४", "content_sanskrit": "तथा सत्यधृतिर्वीरः कृत्वा कदनमाहवे ।\nपाण्डवार्थे पराक्रान्तो गमितो यमसादनम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2166963, "chapter_id": 4586, "verse_number": "३५", "content_sanskrit": "पुत्रश्च शिशुपालस्य सुकेतुः पृथिवीपतिः ।\nनिहत्य शात्रवान् सङ्खे द्रोणेन निहतो रणे\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2166964, "chapter_id": 4586, "verse_number": "", "content_sanskrit": "(विराटपुत्रः शङ्खस्तु उत्तरश्च महारथः ।\nकुर्वन्तौ सुमहत् कर्म गतौ वैवस्वतक्षयम्\t॥३६॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2166965, "chapter_id": 4586, "verse_number": "३७", "content_sanskrit": "तथा सत्यधृतिर्मात्स्यो मदिराश्वश्च वीर्यवान् ।\nसूर्यदत्तश्च विक्रान्तो निहतो द्रोणसायकैः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2166966, "chapter_id": 4586, "verse_number": "३८", "content_sanskrit": "(मात्स्यादवरजः श्रीमान् शतानीको निपातितः ।)\nश्रेणिमांस्तु महाराज युध्यमानः पराक्रमी ।\nकृत्वा नसुकरं कर्म गतो वैवस्वतक्षयम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2166967, "chapter_id": 4586, "verse_number": "३९", "content_sanskrit": "तथैव युधि विक्रान्तो बलवानतिवीर्यवान् ।\n(मागधः परमास्त्रज्ञो गमितो यमसादनम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2166968, "chapter_id": 4586, "verse_number": "४०", "content_sanskrit": "द्रोणेन निहतो राजन् सहदेवः प्रतापवान् ।)\nभीष्मेण निहतो राजन् शेतेऽद्य परवीरहा\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2166969, "chapter_id": 4586, "verse_number": "४१", "content_sanskrit": "वसुदानश्च कदनं कुर्वाणो दिवसं रणे ।\nभारद्वाजेन विक्रम्य गमितो वै यमक्षयम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2166970, "chapter_id": 4586, "verse_number": "", "content_sanskrit": "(पाण्ड्यराजश्च विक्रान्तो बलवान् बाहुशालिना ।\nअश्वत्थाम्ना हतस्तत्र गमितो वै यमक्षयम्\t॥४२॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2166971, "chapter_id": 4586, "verse_number": "४३", "content_sanskrit": "एते चान्ये च बहवः पाण्डवानां महारथाः ।\nहता द्रोणेन भूयिष्ठं यन्मां त्वं परिपृच्छसि\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2166972, "chapter_id": 4586, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nषष्ठोऽध्यायः ॥६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]