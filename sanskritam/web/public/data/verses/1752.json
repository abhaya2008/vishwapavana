[{"id": 2034875, "chapter_id": 1752, "verse_number": "४-७५-०x", "content_sanskrit": "विराट उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2034876, "chapter_id": 1752, "verse_number": "४-७५-१", "content_sanskrit": "यद्येष राजा कौरव्यः कुन्तीपुत्रो युधिष्ठिरः।\nकतमोऽस्यार्जुनो भ्राता भीमश्च कतमो बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2034877, "chapter_id": 1752, "verse_number": "४-७५-२", "content_sanskrit": "नकुलः सहदेवो वा द्रौपदी वा यशस्विनी ।\nयदा ह्यक्षैर्जिता ह्येते नान्तरा श्रूयते कथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2034878, "chapter_id": 1752, "verse_number": "४-७५-३x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2034879, "chapter_id": 1752, "verse_number": "४-७५-३", "content_sanskrit": "य एष बललोऽभूत्ते सूपकारश्च ते नृप।\nएष भीमो महाभाग भीमवेगपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2034880, "chapter_id": 1752, "verse_number": "४-७५-४", "content_sanskrit": "एष क्रोधवशान्हत्वा पर्वते गन्धमादने।\nसौगन्धिकानि पुष्पाणि कृष्णार्थे समुपानयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2034881, "chapter_id": 1752, "verse_number": "४-७५-५", "content_sanskrit": "गन्धर्व एष वै हन्ता कीचकानां दुरात्मनाम्।\nव्याघ्रानृक्षान्गजांश्चैव हतवांश्च पुरे तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2034882, "chapter_id": 1752, "verse_number": "४-७५-६", "content_sanskrit": "हिडिम्बं च बकं चैव किर्मीरं च जटासुरम्।\nहत्वा निष्कण्टकं चक्रे अरण्यं सर्वतः शुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2034883, "chapter_id": 1752, "verse_number": "४-७५-७", "content_sanskrit": "यश्चासीदश्वबन्धस्ते नकुलोऽयं परन्तप।\nगोसङ्ख्यः सहदेवश्च माद्रीपुत्रौ महाबलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2034884, "chapter_id": 1752, "verse_number": "४-७५-८", "content_sanskrit": "शृङ्गारवेषारणौ रूपवन्तौ मनस्विनौ ।\nनानारथसहस्राणां समर्थौ भरतर्षभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2034885, "chapter_id": 1752, "verse_number": "४-७५-९", "content_sanskrit": "एषा पद्मपलाशाक्षी सुमध्या चारुहासिनी ।\nसैरन्ध्री द्रौपदी राजन्यकृते कीचका हताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2034886, "chapter_id": 1752, "verse_number": "४-७५-१०", "content_sanskrit": "द्रुपदस्य प्रिया पुत्री धृष्ट्युम्नस्य चानुजा ।\nअग्निकुण्डात्समुद्भूता द्रौपदी त्ववगम्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2034887, "chapter_id": 1752, "verse_number": "४-७५-११x", "content_sanskrit": "भीम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2034888, "chapter_id": 1752, "verse_number": "४-७५-११", "content_sanskrit": "अस्त्रज्ञो दुर्लभः कश्चित्केवलं पृथिवीमनु।\nधनुर्भृतामतिश्रेष्ठः कौन्तेयोयं धनंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2034889, "chapter_id": 1752, "verse_number": "४-७५-१२", "content_sanskrit": "एतेन खाण्डवं तस्य ह्यकामस्य शतक्रतोः।\nदग्धं नागवनं चैव सह नागैर्नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2034890, "chapter_id": 1752, "verse_number": "४-७५-१३", "content_sanskrit": "वर्षं च शरवर्षेण वारितं दुर्जयेन वै।\nकरमाहारिताः सर्वे पार्थिवाः पृथिवीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2034891, "chapter_id": 1752, "verse_number": "४-७५-१४", "content_sanskrit": "स्त्रीवेषं कृतवानेष तव राजन्निवेशने।\nबृहन्नलेति यामाहुरर्जुनं जयतांवरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2034892, "chapter_id": 1752, "verse_number": "४-७५-१५", "content_sanskrit": "उषिताःस्म सुखं सर्वे तव राजन्निवेशने।\nअज्ञातवासे निभृता गर्भवास इव प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2034893, "chapter_id": 1752, "verse_number": "४-७५-१६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2034894, "chapter_id": 1752, "verse_number": "४-७५-१६", "content_sanskrit": "यदाऽर्जुनेन ते वीराः कथिताः पञ्च पाण्डवाः।\nपुनरेव च तान्पार्थान्दर्शयामास चोत्तरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2034895, "chapter_id": 1752, "verse_number": "४-७५-१७x", "content_sanskrit": "उत्तर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2034896, "chapter_id": 1752, "verse_number": "४-७५-१७", "content_sanskrit": "य एष जाम्बूनदशुद्धगौर-\nतनुर्महान्सिंह इव प्रवद्धः ।\nप्रचण्डघोणः पृथुदीर्घनेत्र-\nस्ताम्रायताक्षः कुरुराज एषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2034897, "chapter_id": 1752, "verse_number": "४-७५-१८", "content_sanskrit": "अयं पुनर्मत्तगजेन्द्रगामी\nप्रतप्तचामीकरशुद्धगौरः।\nपृथ्वायतांसो गुरुदीर्घबाहु-\nर्वृकोदरः पश्यत पश्यतैनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2034898, "chapter_id": 1752, "verse_number": "४-७५-१९", "content_sanskrit": "यस्त्वेव पार्श्वेऽस्य महाधनुष्मा-\nञ्श्यामो युवा वारणयूथपोपमः ।\nसिंहोन्नतांसो गजराजगामी\nपद्मायताक्षोऽर्जुन एष वीरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2034899, "chapter_id": 1752, "verse_number": "४-७५-२०", "content_sanskrit": "राज्ञः समीपे पुरुषोत्तमौ तु\nयमाविमौ विष्णुमहेन्द्रकलौ।\nमनुष्यलोके सकले समोऽस्ति\nययोर्न रूपे न बले न शीले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2034900, "chapter_id": 1752, "verse_number": "४-७५-२१", "content_sanskrit": "आभ्यां तु पार्श्वे कनकोत्तमाङ्गी\nयैषा प्रभा मूर्तिमतीव गौरी।\nनीलोत्पलाभा सुरदेवतेव\nकृष्णा स्थिता मूर्तिमतीव लक्ष्मीः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2034901, "chapter_id": 1752, "verse_number": "४-७५-२२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2034902, "chapter_id": 1752, "verse_number": "४-७५-२२", "content_sanskrit": "एवं निवेद्य तान्पार्थान्पाण्डवान्पञ्च भूपतेः।\nततोऽर्जुनस्य वैराटिः कथयामास विक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2034903, "chapter_id": 1752, "verse_number": "४-७५-२३", "content_sanskrit": "अयं स द्विषतां मध्ये मृगाणामिव केसरी।\nअचरद्रथबृन्देषु निघ्नंस्तेषां परावरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2034904, "chapter_id": 1752, "verse_number": "४-७५-२४", "content_sanskrit": "अनेन विद्धा मातङ्गा महामेघोपमास्तदा।\nहिरण्यकक्ष्याः संग्रामे दन्ताभ्यामगमन्महीम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2034905, "chapter_id": 1752, "verse_number": "४-७५-२५", "content_sanskrit": "अनेन विजिता गावो निर्जिताः कुरवो युधि।\nअस्य शङ्खस्य शब्देन कर्णौ मे बधिरीकृतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2034906, "chapter_id": 1752, "verse_number": "४-७५-२६", "content_sanskrit": "जायते रोमर्षो मे संस्मृत्यास्य धनुर्ध्वनिम्।\nध्वजस्य वानरं भूतैराक्रोशन्तं सहानुगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2034907, "chapter_id": 1752, "verse_number": "४-७५-२७", "content_sanskrit": "नाददानं शरान्घोरान्न मुञ्चन्तं शरोत्करान्।\nन कार्मुकं विकर्षन्तमेनं पश्यामि संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2034908, "chapter_id": 1752, "verse_number": "४-७५-२८", "content_sanskrit": "एतद्धनुःप्रमुक्ताश्च शराः पुङ्खानुपुङ्खिनः ।\nनालक्ष्येषु रणे पेतुर्नाराचा रक्तभोजनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2034909, "chapter_id": 1752, "verse_number": "४-७५-२९", "content_sanskrit": "तीक्ष्णनाराचसंकृत्तशिरोबाहूरुवक्षसाम्।\nकलेबराणि दृश्यन्ते योधानां साश्वसादिनां ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2034910, "chapter_id": 1752, "verse_number": "४-७५-३०", "content_sanskrit": "अनेन तटिनी तत्र शोणिताम्बुप्रवाहिनी।\nप्रवर्तिता भीमरूपा यां स्मृत्वाऽद्यापि मे मनः।\nप्रकम्पते चण्डवायुकम्पिता कदली यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2034911, "chapter_id": 1752, "verse_number": "४-७५-३१", "content_sanskrit": "अनेन राजन्वीरेण भीष्मद्रोणमुखा रथाः।\nदुर्योधनेन सहिता निर्जिता भीमकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2034912, "chapter_id": 1752, "verse_number": "४-७५-३२", "content_sanskrit": "अयं भीतं द्रवन्तं मां देवपुत्रो न्यवारयत्।\nयस्य बाहुबलेनास्मि जीवन्प्रत्यागतः पुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2034913, "chapter_id": 1752, "verse_number": "४-७५-३३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2034914, "chapter_id": 1752, "verse_number": "४-७५-३३", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा मात्स्यराजः प्रतापवान्।\nधनंजयं परिष्वज्य पाण्डवानथ सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2034915, "chapter_id": 1752, "verse_number": "४-७५-३४", "content_sanskrit": "धर्मराजं नमस्कृत्य राजा राज्येऽभिषेचितम्।\nनातृप्यद्दर्शने तेषां विराटो वाहिनीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2034916, "chapter_id": 1752, "verse_number": "४-७५-३५", "content_sanskrit": "संप्रीयमाणो राजानां युधिष्ठिरमथाब्रवीत्।\nदिष्ट्या भवन्तः संप्राप्ताः सर्वे कुशलिनो वनात्।\nदिष्ट्या विचरितं कृच्छ्रमज्ञातं च दुरात्मभिः ॥\nइदं राज्यं च वः सर्वं यच्चापि वसु किंचन ।\nविभक्तमेतद्भवतां नोत्कण्ठां कर्तुमर्हथ।\nअविभक्तं भवद्भिर्मे न सन्देहो नराधिपाः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2034917, "chapter_id": 1752, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि वैवाहिकपर्वणि पञ्चसप्ततितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]