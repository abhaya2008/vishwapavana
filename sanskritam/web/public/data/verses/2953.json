[{"id": 2091772, "chapter_id": 2953, "verse_number": "१३-८३-१", "content_sanskrit": "युधिष्ठिर उवाच।\nअर्थाश्रयाद्वा कामाद्वा वर्णानां चाप्यनिश्चयात्।\nअज्ञानाद्वापि वर्णानां जायते वर्णसङ्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2091773, "chapter_id": 2953, "verse_number": "१३-८३-२", "content_sanskrit": "तेषामेतेन विधिना जातानां वर्णसङ्करे।\nको धर्मः कानि कर्माणि तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2091774, "chapter_id": 2953, "verse_number": "१३-८३-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2091775, "chapter_id": 2953, "verse_number": "१३-८३-३", "content_sanskrit": "चातुर्वर्ण्यस्य कर्माणि चातुर्वर्ण्यं च केवलम्।\nअसृजत्स हि यज्ञार्थे पूर्वमेव प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2091776, "chapter_id": 2953, "verse_number": "१३-८३-४", "content_sanskrit": "भार्याश्चतस्नो विप्रस्य द्वयोरात्मा प्रजायते।\nआनुपूर्व्याद्द्वयोर्हीनौ मातृजात्यौ प्रसूयतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2091777, "chapter_id": 2953, "verse_number": "१३-८३-५", "content_sanskrit": "परं शवाद्ब्राह्मणस्यैव पुत्रः\nशूद्रापुत्रं पारशवं तमाहुः।\nशुश्रूषकः स्वस्य कुलस्य स स्या-\nत्स्वचारित्रं नित्यमथो न जह्यात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2091778, "chapter_id": 2953, "verse_number": "१३-८३-६", "content_sanskrit": "सर्वानुपायानथ सम्प्रधार्य\nसमुद्धरेत्स्वस्य कुलस्य तन्त्रम्।\nज्येष्ठो यवीयानपि यो द्विजस्य\nशुश्रूषया दानपरायणः स्यात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2091779, "chapter_id": 2953, "verse_number": "१३-८३-७", "content_sanskrit": "तिस्रः क्षत्रियसम्बन्धाद्द्वयोरात्माऽस्य जायते।\nहीनवर्णास्तृतीयायां शूद्रा उग्रा इति स्मृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2091780, "chapter_id": 2953, "verse_number": "१३-८३-८", "content_sanskrit": "द्वे चापि भार्ये वैश्यस्य द्वयोरात्माऽस्व जायते।\nशूद्रा शूद्रस्य चाप्येका शूद्रमेव प्रजायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2091781, "chapter_id": 2953, "verse_number": "१३-८३-९", "content_sanskrit": "अतोऽविशिष्टस्त्वधमो गुरुदारप्रधर्षकः।\nब्राह्यं वर्णं जनयति चातुर्वर्ण्यविगर्हितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2091782, "chapter_id": 2953, "verse_number": "१३-८३-१०", "content_sanskrit": "अयाज्यं क्षत्रियो व्रात्यंक सूतं स्तोत्रक्रियापरम्।\nवैश्यो वैदेहकं चापि मौद्गल्यमपवर्जितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2091783, "chapter_id": 2953, "verse_number": "१३-८३-११", "content_sanskrit": "शूद्रश्चण्डालमत्युग्रं वध्यघ्नं बाह्यवासिनम्।\nब्राह्मण्यां सम्प्रजायन्त इत्येते कुलपांसनाः।\nएते मतिमतांश्रेष्ठ वर्णसङ्करजाः प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2091784, "chapter_id": 2953, "verse_number": "१३-८३-१२", "content_sanskrit": "बन्दी तु जायते वैश्यान्मागधो वाक्यजीवनः।\nशूद्रान्निषादो मत्स्यघ्नः क्षत्रियायां व्यतिक्रमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2091785, "chapter_id": 2953, "verse_number": "१३-८३-१३", "content_sanskrit": "शूद्रादायोगवश्चापि वैश्यायां ग्राम्यधर्मिणः।\nब्राह्मणैरप्रतिग्राह्यस्तक्षा स्वधनजीवनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2091786, "chapter_id": 2953, "verse_number": "१३-८३-१४", "content_sanskrit": "एतेऽपि सदृशान्वर्णाञ्जनयन्ति स्वयोनिषु।\nमातृजात्या प्रसूयन्ते ह्यवरा हीनयोनिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2091787, "chapter_id": 2953, "verse_number": "१३-८३-१५", "content_sanskrit": "यथा चतुर्षु वर्णेषु द्वयोरात्माऽस्य जायते।\nआनन्तर्यात्प्रजायन्ते यथा बाह्या प्रधानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2091788, "chapter_id": 2953, "verse_number": "१३-८३-१६", "content_sanskrit": "ते चापि सदृशं वर्णं जनयन्ति स्वयोनिषु।\nपरस्परस्य दारेषु जनयन्ति विगर्हितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2091789, "chapter_id": 2953, "verse_number": "१३-८३-१७", "content_sanskrit": "यथा शूद्रोऽपि ब्राह्मण्यां जन्तुं बाह्यं प्रसूयते।\nएवं बाह्यतराद्बाह्यश्चातुर्वर्ण्यात्प्रजायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2091790, "chapter_id": 2953, "verse_number": "१३-८३-१८", "content_sanskrit": "प्रतिलोमं तु वर्धन्ते बाह्योद्बाह्यतरात्पुनः।\nहीनाद्धीनाः प्रसूयन्ते वर्णाः पञ्चदशैव तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2091791, "chapter_id": 2953, "verse_number": "१३-८३-१९", "content_sanskrit": "अगम्यागमनाच्चैव जायते वर्णसङ्करः।\nबाह्यानामनुजायन्ते सैरन्ध्र्यां मागधेषु च।\nप्रसाधनोपचारज्ञमदासं दासजीवनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2091792, "chapter_id": 2953, "verse_number": "१३-८३-२०", "content_sanskrit": "क्षत्रा ह्यायोगवं सूते वागुराबन्धजीवनम्।\nमैरेयकं च वैदेहः सम्प्रसूतेऽथ माधुकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2091793, "chapter_id": 2953, "verse_number": "१३-८३-२१", "content_sanskrit": "निषादो मद्गुरं सूते दासं नावोपजीविनम्।\nमृतपं चापि चाण्डालः श्वपाकमिति विश्रुतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2091794, "chapter_id": 2953, "verse_number": "१३-८३-२२", "content_sanskrit": "चतुरो मागधी सूते क्रूरान्मायोपजीविनः।\nमांसं स्वादुकरं क्षौद्रं सौगन्धमिति विश्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2091795, "chapter_id": 2953, "verse_number": "१३-८३-२३", "content_sanskrit": "वैदेहकाच्च पापिष्ठा क्रूरं मायोपजीविनम्।\nनिषादान्मद्रनाभं च खरयानप्रयायिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2091796, "chapter_id": 2953, "verse_number": "१३-८३-२४", "content_sanskrit": "चण्डालात्पुल्कसं चापि खराश्वगजभोजिनम्।\nभृतचैलप्रतिच्छन्नं भिन्नभाजनभोजिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2091797, "chapter_id": 2953, "verse_number": "१३-८३-२५", "content_sanskrit": "आयोगवीषु जायन्ते हीनवर्णास्तु ते त्रयः।\nक्षुद्रो वैदेहकादन्धो बहिर्ग्रामप्रतिश्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2091798, "chapter_id": 2953, "verse_number": "१३-८३-२६", "content_sanskrit": "कारावरो निषाद्यां तु चर्मकारः प्रसूयते।\nचाण्डालात्पाण्डुसौपाकस्त्वक्सारव्यवहारवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2091799, "chapter_id": 2953, "verse_number": "१३-८३-२७", "content_sanskrit": "आहिण्कों निषादेन वैदेह्यां सम्प्रसूयते।\nचण्डालेन तु सौपाकश्चण्डालसमवृत्तिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2091800, "chapter_id": 2953, "verse_number": "१३-८३-२८", "content_sanskrit": "निषादी चापि चण्डालात्पुत्रमन्तेवसायिनम्।\nश्मशानगोचरं सूते बाह्यैरपि बहिष्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2091801, "chapter_id": 2953, "verse_number": "१३-८३-२९", "content_sanskrit": "इत्येते सङ्करे जाताः पितृमातृव्यतिक्रमात्।\nप्रच्छन्नान्वा प्रकाशा वा वेदितव्याः स्वकर्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2091802, "chapter_id": 2953, "verse_number": "१३-८३-३०", "content_sanskrit": "चतुर्णामेव वर्णानां धर्मो नान्यस्य विद्यते।\nवर्णानां धर्महीनेषु सङ्ख्या नास्तीह कस्यचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2091803, "chapter_id": 2953, "verse_number": "१३-८३-३१", "content_sanskrit": "यदृच्छयोपसम्पन्नैर्यज्ञसाधुबहिष्कृतैः।\nबाह्या बाह्यैश्च जायन्ते यथावृत्ति यथाश्रयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2091804, "chapter_id": 2953, "verse_number": "१३-८३-३२", "content_sanskrit": "चतुष्पथश्मशानानि शैलांश्चान्यान्वनस्पतीन्।\nकार्ष्णायसमलङ्कारं परिगृह्य च नित्यशः।\nवसेयुरेते विज्ञाता वर्तयन्तः स्वकर्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2091805, "chapter_id": 2953, "verse_number": "१३-८३-३३", "content_sanskrit": "युञ्जन्तो वाऽप्यलङ्कारांस्तथोपकरणानि च।\nगोब्राह्मणाय साहय्यं कुर्वाणा वै न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2091806, "chapter_id": 2953, "verse_number": "१३-८३-३४", "content_sanskrit": "आनृशंस्यमनुक्रोशः सत्यवाक्यं तथा क्षमा।\nस्वशरीरैरपि त्राणं बाह्यानां सिद्धिकारणम्।\nभवन्ति मनुजव्याघ्र तत्र मे नास्ति संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2091807, "chapter_id": 2953, "verse_number": "१३-८३-३५", "content_sanskrit": "यथोपदेशं परिकीर्तितासु\nनरः प्रजायेत विचार्य बुद्धिमान्।\nनिहीनयोनिर्हि सुतोऽवसादये-\nत्तितीर्षमाणं हि यथोपलो जले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2091808, "chapter_id": 2953, "verse_number": "१३-८३-३६", "content_sanskrit": "अविद्वांसमलं लोके विद्वांसमपि वा पुनः।\nनयन्ति ह्यपथं नार्यः कामक्रोधवशानुगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2091809, "chapter_id": 2953, "verse_number": "१३-८३-३७", "content_sanskrit": "स्वभावश्चैव नारीणां नराणामिह दूषणम्।\nअत्यर्थं न प्रसज्जन्ते प्रमदासु विपश्चितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2091810, "chapter_id": 2953, "verse_number": "१३-८३-३८x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2091811, "chapter_id": 2953, "verse_number": "१३-८३-३८", "content_sanskrit": "वर्णापेतमविज्ञाय नरं कलुषयोनिजम्।\nआर्यरूपमिवानार्यं कथं विद्यामहे वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2091812, "chapter_id": 2953, "verse_number": "१३-८३-३९x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2091813, "chapter_id": 2953, "verse_number": "१३-८३-३९", "content_sanskrit": "योनिसङ्कलुषे जातं नानाभावसमन्वितम्।\nकर्मभिः सज्जनाचीर्णैर्विज्ञेयाः शुद्धयोनिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2091814, "chapter_id": 2953, "verse_number": "१३-८३-४०", "content_sanskrit": "अनार्यत्वमनाचारः क्रूरत्वं निष्क्रियात्मता।\nपुरुषं व्यञ्जयन्तीह लोके कलुषयोनिजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2091815, "chapter_id": 2953, "verse_number": "१३-८३-४१", "content_sanskrit": "पित्र्यं वा भजते शीलं मातृजं वा तथोभयम्।\nन कथञ्च सङ्कीर्णः प्रवृतिं स्वां नियच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2091816, "chapter_id": 2953, "verse_number": "१३-८३-४२", "content_sanskrit": "यथैव सदृसो रूपे मातावित्रोर्हि जायते।\nव्याघ्रबिन्दोस्तथा योनिं पुरुषः स्वां नियच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2091817, "chapter_id": 2953, "verse_number": "१३-८३-४३", "content_sanskrit": "कुले स्रोतसि संच्छन्ने यस्य स्याद्योनिसङ्करः।\nसंश्रयत्येव तच्छीलं नरोऽल्पमथवा बहु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2091818, "chapter_id": 2953, "verse_number": "१३-८३-४४", "content_sanskrit": "आर्यरूपसमाचारं चरन्तं कृतके पथि।\nसवर्णमन्यवर्णं वा स्वशीलं सास्ति निश्चये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2091819, "chapter_id": 2953, "verse_number": "१३-८३-४५", "content_sanskrit": "नानावृत्तेषु भूतेषु नानाक्रमरतेषु च।\nजन्मवृत्तसमं लोके सुश्लिष्टं न विरज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2091820, "chapter_id": 2953, "verse_number": "१३-८३-४६", "content_sanskrit": "शरीरमिह सत्वेन न तस्य परिकृष्यते।\nज्येष्ठमध्यावरं सत्वं तुल्यसत्वं प्रमोदते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2091821, "chapter_id": 2953, "verse_number": "१३-८३-४७", "content_sanskrit": "ज्यायांसमपि शीलेन विहीनं नैव पूजयेत्।\nअपि शूद्रं च धर्मज्ञं सद्वृत्तमभिपूजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2091822, "chapter_id": 2953, "verse_number": "१३-८३-४८", "content_sanskrit": "आत्मानमाख्याति हि कर्मभिर्नरः\nसुशीलचारित्रकुलैः शुभाशुभैः।\nप्रनष्टमप्यात्मकुलं तथा नरः\nपुनः प्रकाशं कुरुते स्वकर्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2091823, "chapter_id": 2953, "verse_number": "१३-८३-४९", "content_sanskrit": "योनिष्वेतासु सर्वासु सङ्कीर्णास्वितरासु च।\nयत्रात्मानं न जनयेद्बुधस्तां परिवर्जयेत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2091824, "chapter_id": 2953, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि त्र्यशीतितमोऽध्यायः॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]