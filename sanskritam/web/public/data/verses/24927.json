[{"id": 7004927000, "chapter_id": 24927, "verse_number": "७-१-११०-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेद्वरारोहे प्रभासेश्वरमुत्तमम् ।\nगौरीतपोवनाद्देवि पश्चिमे समुदाहृतम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004927001, "chapter_id": 24927, "verse_number": "७-१-११०-२", "content_sanskrit": "धनुषां सप्तके देवि नातिदूरे व्यवस्थितम् ।\nस्थापितं तन्महालिंगं वसूनामष्टमेन हि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004927002, "chapter_id": 24927, "verse_number": "७-१-११०-३", "content_sanskrit": "प्रभास इति नाम्ना हि शिवपूजारतेन वै ।\nस पुत्रकामो देवेशि प्रभासक्षेत्रमागतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004927003, "chapter_id": 24927, "verse_number": "७-१-११०-४", "content_sanskrit": "प्रतिष्ठाप्य महालिङ्गं चचार विपुलं तपः ।\nआग्नेयमिति विख्यातं दिव्याब्दानां शतं प्रिये ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004927004, "chapter_id": 24927, "verse_number": "७-१-११०-५", "content_sanskrit": "ततस्तस्य महादेवि सम्यक्छ्रद्धान्वि तस्य वै ।\nतुतोष भगवान्रुद्रो ददौ यन्मनसीप्सितम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004927005, "chapter_id": 24927, "verse_number": "७-१-११०-६", "content_sanskrit": "बृहस्पतेस्तु भगिनी भुवना ब्रह्मवादिनी ।\nप्रभासस्य तु सा भार्या वसूनामष्टमस्य च ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004927006, "chapter_id": 24927, "verse_number": "७-१-११०-७", "content_sanskrit": "विश्वकर्मा सुतस्तस्याः सृष्टिकर्ता प्रजापतिः ।\nदेवानां तक्षको विद्वान्मनोर्मातामहः स्मृतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004927007, "chapter_id": 24927, "verse_number": "७-१-११०-८", "content_sanskrit": "तक्षकः सूर्यबिंबस्य तेजसः शातनो महान् ।\nएवं तस्याऽभवत्पुत्रो वसूनामष्टमस्य वै ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004927008, "chapter_id": 24927, "verse_number": "७-१-११०-९", "content_sanskrit": "प्रभासनाम्नो देवेशि तल्लिंगाराधनोद्यतः ।\nइति ते कथितं देवि प्रभासेश्वरसूचकम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004927009, "chapter_id": 24927, "verse_number": "७-१-११०-१०", "content_sanskrit": "माहात्म्यं सर्वपापघ्नं सर्वकामप्रदं शुभम् ।\nयस्तं पूजयते भक्त्या सम्यक्छ्रद्धासमन्वितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004927010, "chapter_id": 24927, "verse_number": "७-१-११०-११", "content_sanskrit": "भूमिशायी निराहारो जपन्वै शतरुद्रियम् ।\nमाघे मासि चतुर्दश्यां स्नात्वा सागरसंगमे ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004927011, "chapter_id": 24927, "verse_number": "७-१-११०-१२", "content_sanskrit": "पंचामृतेन संस्नाप्य पूजयित्वा विधानतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004927012, "chapter_id": 24927, "verse_number": "७-१-११०-१३", "content_sanskrit": "य एवं कुरुते देवि सम्यग्यात्रामहोत्सवम् ।\nस मुक्तः पातकैः सर्वैः सर्वकामैः समृद्ध्यते ।\nवृषस्तत्रैव दातव्यः सम्यग्यात्राफलेप्सुभिः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004927013, "chapter_id": 24927, "verse_number": "७-१-११०-१४", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये प्रभासेश्वरमाहात्म्यवर्णनंनाम दशोत्तरशततमोऽध्यायः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]