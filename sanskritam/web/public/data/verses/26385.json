[{"id": 7006385000, "chapter_id": 26385, "verse_number": "२-४२-१", "content_sanskrit": "वैशम्पायन उवाच\nजरासंधस्ततः प्राप्तो नृपः सर्वमहीक्षिताम् ।\nनराधिपैर्बलयुतैरनुयातो महाद्युतिः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006385001, "chapter_id": 26385, "verse_number": "२-४२-२", "content_sanskrit": "व्यायतोदग्रतुरगैर्विस्पष्टार्थसमाहितैः ।\nरथैः साङ्ग्रामिकैर्युक्तैरसङ्गगतिभिः क्वचित् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006385002, "chapter_id": 26385, "verse_number": "२-४२-३", "content_sanskrit": "हेमकक्षैर्महाघण्टैर्वारणैर्वारिदोपमैः ।\nमहामात्रोत्तमारूढैः कल्पितै रणगर्वितैः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006385003, "chapter_id": 26385, "verse_number": "२-४२-४", "content_sanskrit": "स्वारूढैः सादिभिर्युक्तैः प्रेङ्खमाणैः प्रवल्गितैः ।\nवाजिभिर्वायुसंकाशैः प्ल्रवद्भिरिव पत्रिभिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006385004, "chapter_id": 26385, "verse_number": "२-४२-५", "content_sanskrit": "खङ्गचर्मबलोदग्रैः पत्तिभिर्बलिनां वरैः ।\nसहस्त्रसंख्यैर्निर्मुक्तैरुत्पतद्भिरिवोरगैः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006385005, "chapter_id": 26385, "verse_number": "२-४२-६", "content_sanskrit": "एवं चतुर्विधैः सैन्यैः प्रचलद्भिरिवाम्बुदैः ।\nनृपोऽभियातो बलवाञ्जरासंधो धृतव्रतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006385006, "chapter_id": 26385, "verse_number": "२-४२-७", "content_sanskrit": "स रथैनेमिघोषैश्च गजैश्च मदसंयुतैः ।\nहेषद्भिश्चापि तुरगैः क्ष्वेडितोग्रैश्च पत्तिभिः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006385007, "chapter_id": 26385, "verse_number": "२-४२-८", "content_sanskrit": "संनादयन् दिशः सर्वाः सर्वाश्चापि गुहाशयान् ।\nस राजा सागराकारः ससैन्यः प्रत्यदृश्यत ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006385008, "chapter_id": 26385, "verse_number": "२-४२-९", "content_sanskrit": "तद्बलं पृथिवीशानां हृष्टयोधजनाकुलम् ।\nक्ष्वेडितास्फोटितरवं मेघसैन्यमिवाबभौ ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006385009, "chapter_id": 26385, "verse_number": "२-४२-१०", "content_sanskrit": "रथैः पवनसंपातैर्गजैश्च जलदोपमैः ।\nतुरगैश्च सिताभ्राभैः पत्तिभिश्चापि दंशितैः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006385010, "chapter_id": 26385, "verse_number": "२-४२-११", "content_sanskrit": "व्यामिश्रं तद्बलं भाति मत्तद्विपसमाकुलम् ।\nघर्मान्ते सागरगतं यथाभ्रपटलं तथा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006385011, "chapter_id": 26385, "verse_number": "२-४२-१२", "content_sanskrit": "सबलास्ते महीपाला जरासंधपुरोगमाः ।\nपरिवार्य गिरिं सर्वे निवेशायोपचक्रमुः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006385012, "chapter_id": 26385, "verse_number": "२-४२-१३", "content_sanskrit": "बभौ तस्य निविष्टस्य बलश्रीः शिविरस्य वै ।\nशुक्ले पर्वणि पूर्णस्य यथा रूपं महोदधेः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006385013, "chapter_id": 26385, "verse_number": "२-४२-१४", "content_sanskrit": "वीतरात्रे ततः काले नृपास्ते कृतकौतुकाः ।\nआरोहणार्थं शैलस्य समेता युद्धलालसाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006385014, "chapter_id": 26385, "verse_number": "२-४२-१५", "content_sanskrit": "समवायीकृताः सर्वे गिरिप्रस्थेषु ते नृपाः ।\nनिविष्टा मन्त्रयामासुर्युद्धकालकुतूहलाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006385015, "chapter_id": 26385, "verse_number": "२-४२-१६", "content_sanskrit": "एषां तु तुमुलः शब्दः शुश्रुवे पृथिवीक्षिताम् ।\nयुगान्ते भिद्यमानानां सागराणां यथा स्वनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006385016, "chapter_id": 26385, "verse_number": "२-४२-१७", "content_sanskrit": "तेषां सकञ्चुकोष्णीषाः स्थविरा वेत्रपाणयः ।\nचेरुर्मा शब्द इत्येवं ब्रुवन्तो राजशासनात् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006385017, "chapter_id": 26385, "verse_number": "२-४२-१८", "content_sanskrit": "तस्य रूपं बलस्यासीन्निःशब्दस्तिमितस्य वै ।\nलीनमीनभुजङ्गस्य निःशब्दस्य पयोदधेः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006385018, "chapter_id": 26385, "verse_number": "२-४२-१९", "content_sanskrit": "तस्मिन् स्तिमितनिदशब्दे योगादिव महार्णवे ।\nजरासन्धो बृहद्वाक्यं बृहस्पतिरिवाददे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006385019, "chapter_id": 26385, "verse_number": "२-४२-२०", "content_sanskrit": "शीघ्रं समभिवर्तन्तां बलानीह महीक्षिताम् ।\nसर्वतः पर्वतश्चायं बलौघैः परिवार्यताम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006385020, "chapter_id": 26385, "verse_number": "२-४२-२१", "content_sanskrit": "अश्मयन्त्राणि युज्यन्तां क्षेपणीयाश्च मुद्गराः ।\nऊर्ध्वं चापि प्रवाह्यन्तां प्रासा वै तोमराणि च ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006385021, "chapter_id": 26385, "verse_number": "२-४२-२२", "content_sanskrit": "ऊर्ध्व प्रक्षेपणार्थाय दृढानि च लधूनि च ।\nशस्त्रपातविघातानि क्रियन्तामाशु शिल्पिभिः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006385022, "chapter_id": 26385, "verse_number": "२-४२-२३", "content_sanskrit": "शूराणां युद्ध्यमानानां प्रमत्तानां परस्परम् ।\nयथा नरपतिः प्राह तथा शीघ्रं विधीयताम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006385023, "chapter_id": 26385, "verse_number": "२-४२-२४", "content_sanskrit": "दार्यतामेष टङ्कौघैः खनित्रैश्च नगोत्तमः ।\nनृपाश्च युद्धमार्गज्ञा विन्यस्यन्तामदूरतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006385024, "chapter_id": 26385, "verse_number": "२-४२-२५", "content_sanskrit": "अद्यप्रभृति सैन्यैर्मे गिरिरोधः प्रवर्त्यताम् ।\nयावदेतौ पातयामो वसुदेवसुतावुभौ ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006385025, "chapter_id": 26385, "verse_number": "२-४२-२६", "content_sanskrit": "अचलोऽयं शिलायोनिः क्रियतां निश्चलाण्डजः ।\nआकाशमपि बाणोर्घैर्निःसम्पातं विधीयताम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006385026, "chapter_id": 26385, "verse_number": "२-४२-२७", "content_sanskrit": "मयानुशिष्टास्तिष्ठन्तु गिरिभूमिषु भूमिपाः ।\nतेषु तेष्ववकाशेषु शीघ्रमारुह्यतां गिरिः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006385027, "chapter_id": 26385, "verse_number": "२-४२-२८", "content_sanskrit": "मद्रः कलिङ्गाधिपतिश्चेकितानश्च बाह्लिकः ।\nकाश्मीरराजो गोनर्दः करूषाधिपतिस्तथा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006385028, "chapter_id": 26385, "verse_number": "२-४२-२९", "content_sanskrit": "द्रुमः किंपुरुषश्चैव पर्वतीयाश्च मानवाः ।\nपर्वतस्यापरं पार्श्वं क्षिप्रमारोहयन्त्वमी ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006385029, "chapter_id": 26385, "verse_number": "२-४२-३०", "content_sanskrit": "पौरवो वेणुदारिश्च वैदर्भः सोमकस्तथा ।\nरुक्मी च भोजाधिपतिः सूर्याक्षश्चैव मालवः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006385030, "chapter_id": 26385, "verse_number": "२-४२-३१", "content_sanskrit": "पाञ्चालाधिपतिश्चैव द्रुपदश्च नराधिपः ।\nविन्दानुविन्दावावन्त्यौ दन्तवक्त्रश्च वीर्यवान् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006385031, "chapter_id": 26385, "verse_number": "२-४२-३२", "content_sanskrit": "छागलिः पुरमित्रश्च विराटश्च महीपतिः ।\nकौशाम्ब्यो मालवश्चैव शतधन्वा विदूरथः ॥ ३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006385032, "chapter_id": 26385, "verse_number": "२-४२-३३", "content_sanskrit": "भूरिश्रवास्त्रिगर्तश्च बाणः पञ्चनदस्तथा ।\nउत्तरं पर्वतोद्देशमेते दुर्गसहा नृपाः ।\nआरोहन्तु विमर्दन्तो वज्रप्रतिमगौरवाः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006385033, "chapter_id": 26385, "verse_number": "२-४२-३४", "content_sanskrit": "उलूकः कैतवेयश्च वीरश्चांशुमतः सुतः ।\nएकलव्यो दृढाश्वश्च क्षत्रधर्मा जयद्रथः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006385034, "chapter_id": 26385, "verse_number": "२-४२-३५", "content_sanskrit": "उत्तमौजास्तथा शाल्वः कैरलेयश्च कैशिकः ।\nवैदिशो वामदेवश्च सुकेतुश्चापि वीर्यवान् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006385035, "chapter_id": 26385, "verse_number": "२-४२-३६", "content_sanskrit": "पूर्वपर्वतनिर्व्युहमेतेष्वायतमस्तु नः ।\nविदारयन्तो धावन्तो वाता इत बलाहकान् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006385036, "chapter_id": 26385, "verse_number": "२-४२-३७", "content_sanskrit": "अहं च दरदश्चैव चेदिराजश्च वीर्यवान् ।\nदक्षिणं शैलनिचयं दारयिष्याम दंशिताः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006385037, "chapter_id": 26385, "verse_number": "२-४२-३८", "content_sanskrit": "एवमेष गिरिः क्षिप्रं समन्ताद् वेष्टितो बलैः ।\nवज्रप्रपातप्रतिमं प्राप्नोतु तुमुलं भयम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006385038, "chapter_id": 26385, "verse_number": "२-४२-३९", "content_sanskrit": "गदिनो वै गदाभिश्च परिघैः परिघायुधाः ।\nअपरे विविधैः शस्त्रैर्दारयन्तु नगोत्तमम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006385039, "chapter_id": 26385, "verse_number": "२-४२-४०", "content_sanskrit": "एष भूमिधरोऽद्यैव विषमोच्चशिलान्वितः ।\nकार्यो भूमिसमः सर्वो भवद्भिर्वसुधाधिपैः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006385040, "chapter_id": 26385, "verse_number": "२-४२-४१", "content_sanskrit": "जरासंधवचः श्रुत्वा पार्थिवा राजशासनात् ।\nगोमन्तं वेष्टयामासुः सागराः पृथिवीमिव ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006385041, "chapter_id": 26385, "verse_number": "२-४२-४२", "content_sanskrit": "उवाच राजा चेदीनां देवानां मघवानिव ।\nकिं ते युद्धेन दुर्गे ऽस्मिन् गोमन्ते च नगोत्तमे ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006385042, "chapter_id": 26385, "verse_number": "२-४२-४३", "content_sanskrit": "दुरारोहश्च शिखरे प्रांशुपादपकण्टके ।\nकाष्ठैस्तृणैश्च बहुभिः परिवार्य समन्ततः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006385043, "chapter_id": 26385, "verse_number": "२-४२-४४", "content_sanskrit": "अद्यैव दीप्यतां क्षिप्रमलमन्येन कर्मणा ।\nक्षत्रियाः सुकुमारा हि रणे सायकयोधिनः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006385044, "chapter_id": 26385, "verse_number": "२-४२-४५", "content_sanskrit": "नियुक्ताः पर्वते दुर्गे नियोक्तुं पादयोधिनः ।\nननाम प्रतिबन्धेन न चावस्कन्दकर्मणा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006385045, "chapter_id": 26385, "verse_number": "२-४२-४६", "content_sanskrit": "शक्य एष गिरिस्तात देवैरप्यवमर्दितुम् ।\nदुर्गयुद्धे क्रमः श्रेयान् रोधयुद्धेन पार्थिवाः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006385046, "chapter_id": 26385, "verse_number": "२-४२-४७", "content_sanskrit": "भक्तोदकेन्धनैः क्षीणाः पात्यन्ते गिरिसंश्रिताः ।\nवयं बहव इत्येवं नाप्येष निपुणो नयः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006385047, "chapter_id": 26385, "verse_number": "२-४२-४८", "content_sanskrit": "यादवौ नावमन्तव्यौ द्वावप्येतौ रणे स्थितौ ।\nअविज्ञातबलावेतौ श्रूयेते देवसम्मितौ ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006385048, "chapter_id": 26385, "verse_number": "२-४२-४९", "content_sanskrit": "कर्मभिस्त्वमरौ विद्मो वालावतिबलान्वितौ ।\nदुष्कराणीह कर्माणि कृतवन्तौ यदूत्तमौ ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006385049, "chapter_id": 26385, "verse_number": "२-४२-५०", "content_sanskrit": "शुष्ककाष्ठैस्तृणैर्वेष्ट्य सर्वतः पर्वतोत्तमम् ।\nअग्निना दीपयिष्यामो दह्येतां गतचेतनौ ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006385050, "chapter_id": 26385, "verse_number": "२-४२-५१", "content_sanskrit": "यदि चेन्निष्क्रमिष्येते दह्यमानावितोऽन्तिके ।\nसमेत्य पातयिष्यामस्त्यक्ष्यतो जीवितं ततः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006385051, "chapter_id": 26385, "verse_number": "२-४२-५२", "content_sanskrit": "वाक्यमेतत्तु रुरुचे सबलानां महीक्षिताम् ।\nयदुक्तं चेदिराजेन नृपाणां हितशंसिना ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006385052, "chapter_id": 26385, "verse_number": "२-४२-५३", "content_sanskrit": "ततः काष्ठैस्तृणैर्वंशैः शुष्कशाखैश्च पादपैः ।\nउपादीप्यत शैलेन्द्रः सृर्यपादैरिवाम्बुदः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006385053, "chapter_id": 26385, "verse_number": "२-४२-५४", "content_sanskrit": "ददुस्ते सर्वतस्तूर्णं पावकं तत्र पार्थिवाः ।\nयथोद्देशं यथावातं शैलस्य लघुविक्रमाः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006385054, "chapter_id": 26385, "verse_number": "२-४२-५५", "content_sanskrit": "स वायुदीपितो वह्निरुत्पपात समन्ततः ।\nसधूमज्वालमालाभिर्भाभिः खमिव शोभयन् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006385055, "chapter_id": 26385, "verse_number": "२-४२-५६", "content_sanskrit": "सोऽनलः पवनायस्तः काष्ठसंचयमूलवान् ।\nददाह शैलं श्रीमन्तं गोमन्तं कान्तपादपम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006385056, "chapter_id": 26385, "verse_number": "२-४२-५७", "content_sanskrit": "स दह्यमानः शैलेन्द्रो मुमोच विपुलाः शिलाः ।\nशतशः शतधा भूत्वा महोल्काकारदर्शनाः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006385057, "chapter_id": 26385, "verse_number": "२-४२-५८", "content_sanskrit": "स चित्रभानुः शैलेन्द्रं भाभिर्भानुरिवाम्बुदम् ।\nआलिम्पतीव विधिवत् समन्तादर्चिरुद्धतः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006385058, "chapter_id": 26385, "verse_number": "२-४२-५९", "content_sanskrit": "धातुभिः पच्यमानैश्च ज्वलद्भिश्चैव पादपैः ।\nउद्भ्रान्तश्वापदो रौति तुद्यमान इवाद्रिराट् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006385059, "chapter_id": 26385, "verse_number": "२-४२-६०", "content_sanskrit": "प्रतप्तो दह्यमानस्तु स शैलः कृष्णवर्त्मना ।\nरीतीर्निर्वर्तयामास काञ्चनाञ्जनराजतीः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006385060, "chapter_id": 26385, "verse_number": "२-४२-६१", "content_sanskrit": "वह्निना चापि दीप्ताङ्गो गिरिर्नातिविराजते ।\nधूमान्धकारोर्ध्वतनुर्मज्जमान इवाम्बुदः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006385061, "chapter_id": 26385, "verse_number": "२-४२-६२", "content_sanskrit": "विश्लिष्टोपलसंघातः कर्कशाङ्गारवर्षणः ।\nगिरिर्भात्यनलोद्गारैरुल्कावृष्टिरिवाम्बुदः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006385062, "chapter_id": 26385, "verse_number": "२-४२-६३", "content_sanskrit": "प्रपातप्रस्रपोत्क्षिप्तो धूमसंवर्द्धितोदरः ।\nस गिरिर्भस्मतां यातो युगान्ताग्निहतोपमः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006385063, "chapter_id": 26385, "verse_number": "२-४२-६४", "content_sanskrit": "विह्वलास्तस्य पार्श्वेभ्यः सर्पा दग्धार्धदेहिनः ।\nश्वसन्तः पृथुमूर्धानो निश्चेरुरशिवेक्षणाः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006385064, "chapter_id": 26385, "verse_number": "२-४२-६५", "content_sanskrit": "उत्पत्योत्पत्य गगनात् पुनः पुनरवाङ्मुखाः ।\nरेसुश्चोद्वेजिताः सिंहाः शार्दूलाश्चानलाविलाः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006385065, "chapter_id": 26385, "verse_number": "२-४२-६६", "content_sanskrit": "मुमुचुः पादपाश्चैव दाहनिर्यासजं जलम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006385066, "chapter_id": 26385, "verse_number": "२-४२-६७", "content_sanskrit": "वहत्यूर्ध्वगतिर्वातो भस्माङ्गारातिपिङ्गलः ।\nधूमच्छाया च गगने दर्पिताम्भोददर्शना ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006385067, "chapter_id": 26385, "verse_number": "२-४२-६८", "content_sanskrit": "व्यज्यमानो महासानुर्विहगै- श्वापदैरपि ।\nगिरिर्वैकल्यमायाति प्रागल्भ्यात्कृष्णवर्त्मनः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006385068, "chapter_id": 26385, "verse_number": "२-४२-६९", "content_sanskrit": "स मुमोच शिलाः शैलश्चलोदग्रशिलोच्चयः ।\nवज्रेण पुरुहूतस्य यथा स्याद् दारितस्तथा ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006385069, "chapter_id": 26385, "verse_number": "२-४२-७०", "content_sanskrit": "आदीप्य तं तु शैलेन्द्रं क्षत्रिया व्यूहदंशिताः ।\nअर्धक्रोशमपक्रान्ताः पावकेनाभितापिताः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006385070, "chapter_id": 26385, "verse_number": "२-४२-७१", "content_sanskrit": "दह्यमाने नगश्रेष्ठे सीदमानैर्महाद्रुमैः ।\nधूमभारैरनालक्ष्ये मूले शिथिलतां गते ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006385071, "chapter_id": 26385, "verse_number": "२-४२-७२", "content_sanskrit": "सरोषं हि तदा रामो वचनं केशिसूदनम् ।\nबभाषे पद्मपत्राक्षं स साक्षान्मधुसूदनम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006385072, "chapter_id": 26385, "verse_number": "२-४२-७३", "content_sanskrit": "दह्यतेऽयं गिरिस्तात ससानुशिखरद्रुमः ।\nआवयोः कृष्ण वैरेण बलिभिर्वसुधाधिपैः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006385073, "chapter_id": 26385, "verse_number": "२-४२-७४", "content_sanskrit": "पश्य कृष्णानलौष्णानां सधूमानां समन्ततः ।\nवनानां विरसन्तीव नगाभ्याशे द्विपोत्तमाः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006385074, "chapter_id": 26385, "verse_number": "२-४२-७५", "content_sanskrit": "अयं यद्यावयोरर्थे गोमन्तस्तात दह्यते ।\nअयशस्यमिदं लोके कौलीनं च भविष्यति ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006385075, "chapter_id": 26385, "verse_number": "२-४२-७६", "content_sanskrit": "तदस्यानृण्यहेतोर्हि नगस्य नगसंनिभ ।\nक्षत्रियान्निहनिष्यामो दोर्भ्यामेव युधां वर ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006385076, "chapter_id": 26385, "verse_number": "२-४२-७७", "content_sanskrit": "एते ते क्षत्रियाः सर्वे गिरिमादीप्य दंशिताः ।\nरथिनस्तात दृश्यन्ते यथादेशं युयुत्सवः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006385077, "chapter_id": 26385, "verse_number": "२-४२-७८", "content_sanskrit": "एवमुक्त्वा गिरेः शृङ्गान्मेरुशृङ्गादिवोडुराट् ।\nनिपपात बलः श्रीमान् वनमालाधरो युवा ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006385078, "chapter_id": 26385, "verse_number": "२-४२-७९", "content_sanskrit": "कादम्बरीमदक्षीबो नीलवासाः सिताननः ।\nस शारदेन्दुसंकाशो वनमालाञ्चितोदरः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006385079, "chapter_id": 26385, "verse_number": "२-४२-८०", "content_sanskrit": "कान्तैककुण्डलधरश्चारुमौलिरवाङमुखः ।\nनिपपात नरेन्द्राणां मध्ये केशवपूर्वजः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006385080, "chapter_id": 26385, "verse_number": "२-४२-८१", "content_sanskrit": "अवप्लुते ततो रामे कृष्णः कृष्णाम्बुदोपमः ।\nगोमन्तशिखराच्छ्रीमानाप्लुतोऽमितविक्रमः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006385081, "chapter_id": 26385, "verse_number": "२-४२-८२", "content_sanskrit": "ततस्तं पीडयामास पद्भ्यां गिरिवरं हरिः ।\nस पीडितो गिरिस्तेन निर्ममज्ज समन्ततः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006385082, "chapter_id": 26385, "verse_number": "२-४२-८३", "content_sanskrit": "जलाकुलोपलस्तत्र प्रस्रुतो द्विरदो यथा ।\nस तेन वारिणा वह्निस्तत्क्षणात् प्रशमं ययौ ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006385083, "chapter_id": 26385, "verse_number": "२-४२-८४", "content_sanskrit": "कल्पान्ते वारिधाराभिर्मेघजालैरिवांशुमान् ।\nसिंहारसितनिर्घोषः पीतवासा घनाकृतिः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006385084, "chapter_id": 26385, "verse_number": "२-४२-८५", "content_sanskrit": "किरीटमूर्द्धा सौम्यास्यः पुण्डरीकनिभेक्षणः ।\nश्रीवत्सवक्षाः सुमुखः सहस्राक्षसमद्युतिः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006385085, "chapter_id": 26385, "verse_number": "२-४२-८६", "content_sanskrit": "रामादनन्तरं कृष्णः प्लुतो वै वीर्यवांस्ततः ।\nताभ्यामेव प्लुताभ्यां च चरणैः पीडितो गिरिः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006385086, "chapter_id": 26385, "verse_number": "२-४२-८७", "content_sanskrit": "मुमोच सलिलोत्पीडांस्तीव्रपावकशान्तये ।\nसलिलोत्पीडनं दृष्ट्वा पार्थिवा भयमाविशन् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}]