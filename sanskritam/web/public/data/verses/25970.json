[{"id": 7005970000, "chapter_id": 25970, "verse_number": "१-१५३-१", "content_sanskrit": "धन्वन्तरिरुदाच ।\nअरोचकनिदान्ते वक्ष्येऽहं सुश्रुताधुना। ।\nअरोचको भवेद्दोषैर्जिह्वाहृदयसंश्रयैः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005970001, "chapter_id": 25970, "verse_number": "१-१५३-२", "content_sanskrit": "सन्निपातेन मनसः सन्तापेन च पञ्चमः। ।\nकषायतिक्तमधुरं वातादिषु मुखं क्रमात् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005970002, "chapter_id": 25970, "verse_number": "१-१५३-३", "content_sanskrit": "सर्वं वीतरसं शोकक्रोधादिषु यथा मनः ।\nछर्दिदोषैः पृथक्सर्वैर्दुष्टैरन्यैश्च पञ्चमः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005970003, "chapter_id": 25970, "verse_number": "१-१५३-४", "content_sanskrit": "उदानोऽधिकृतान्दोषान्सर्वं सन्ध्यर्हमस्यति ।\nआशु क्लेशोऽस्य लावण्यप्रसेकारुचयः क्रमात् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005970004, "chapter_id": 25970, "verse_number": "१-१५३-५", "content_sanskrit": "नाभिपृष्ठं रुजत्याशु पार्श्वे चाहारमुत्क्षिपेत ।\nततो विच्छ्रिन्नल्पाल्पकषायं फेनिलं वमेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005970005, "chapter_id": 25970, "verse_number": "१-१५३-६", "content_sanskrit": "शब्दोद्गरयुतः कृच्छ्रमनुकृच्छ्रेण वेगत् ।\nकासास्यशोषकं वातात्स्वरपीडासमन्वितम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005970006, "chapter_id": 25970, "verse_number": "१-१५३-७", "content_sanskrit": "पित्तात्क्षारोदकनिभं धूम्रं हरितपीतकम् ।\nसासृगम्लं कटुतिक्तं तृण्मूर्छादाहपाकवत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005970007, "chapter_id": 25970, "verse_number": "१-१५३-८", "content_sanskrit": "कफात्स्निग्धं घनं पीतं श्लेष्मतस्तु समाक्षकम् ।\nमधुरं लवणं भूरि प्रसक्तं लोमहर्षणम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005970008, "chapter_id": 25970, "verse_number": "१-१५३-९", "content_sanskrit": "मखश्वयथुमाधुर्यतन्द्राहृल्लासकासवान् ।\nसर्वैर्लिङ्गैः समापन्नस्त्याज्यो भवति सर्वथा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005970009, "chapter_id": 25970, "verse_number": "१-१५३-१०", "content_sanskrit": "सर्वं यस्य च विद्विष्टं दर्शनश्रवणादिभिः ।\nवातादिनैव संक्रुद्धकृमिदुष्टान्नजे गदे ।\nशूलवेपतुहृल्लासो विशेषात्कृमिजे भवेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]