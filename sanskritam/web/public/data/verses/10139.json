[{"id": 6000139000, "chapter_id": 10139, "verse_number": null, "content_sanskrit": "भगवद्बादरायणप्रणीतं श्रीमद्भागवतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000139001, "chapter_id": 10139, "verse_number": null, "content_sanskrit": "अथ प्रथमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2, "topics": [{"text": "सर्वसमस्य भगवतो वैषम्यं कथमिति परीक्षिता पृष्टेन शुकाचार्येण तदुत्तरदानार्थं", "range": null}]}, {"id": 6000139002, "chapter_id": 10139, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.001.m4a", "display_order": 3}, {"id": 6000139003, "chapter_id": 10139, "verse_number": "७-१-१", "content_sanskrit": "समः प्रियः सुहृद् ब्रह्मन् भूतानां भगवान् स्वयम्।\nइन्द्रस्यार्थे कथं दैत्यानवधीद्विषमो यथा॥ ७/१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.002.m4a", "display_order": 4, "topics": [{"text": "युधिष्ठिरनारदसंवादकथनम्", "range": "१–२२"}]}, {"id": 6000139004, "chapter_id": 10139, "verse_number": "७-१-२", "content_sanskrit": "न ह्यस्यार्थः सुरगणैः साक्षान्निःश्रेयसात्मनः।\nनैवासुरेभ्यो विद्वेषो नोद्वेगश्चागुणस्य हि॥ ७/१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.003.m4a", "display_order": 5}, {"id": 6000139005, "chapter_id": 10139, "verse_number": "७-१-३", "content_sanskrit": "इति नः सुमहाभाग नारायणगुणान् प्रति।\nसंशयः सुमहान् जातस्तद्भवान् छेत्तुमर्हति॥ ७/१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.004.m4a", "display_order": 6}, {"id": 6000139006, "chapter_id": 10139, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.005.m4a", "display_order": 7}, {"id": 6000139007, "chapter_id": 10139, "verse_number": "७-१-४", "content_sanskrit": "साधु पृष्टं महाराज हरेश्चरितमद्भुतम्।\nतत्र भागवतमाहात्म्यं भगवद्भक्तिवर्धनम्॥ ७/१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.006.m4a", "display_order": 8}, {"id": 6000139008, "chapter_id": 10139, "verse_number": "७-१-५", "content_sanskrit": "गीयते परमं पुण्यं ऋषिभिर्नारदादिभिः।\nनत्वा कृष्णाय मुनये कथयिष्ये हरेः कथाम्॥ ७/१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.007.m4a", "display_order": 9}, {"id": 6000139009, "chapter_id": 10139, "verse_number": "७-१-६", "content_sanskrit": "निर्गुणोऽपि ह्यजोऽव्यक्तो भगवान् प्रकृतेः परः।\nस्वमायागुणमाविश्य बाध्यबाधकतां गतः॥ ७/१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.008.m4a", "display_order": 10}, {"id": 6000139010, "chapter_id": 10139, "verse_number": "७-१-७", "content_sanskrit": "सत्त्वं रजस्तम इति प्रकृतेर्नात्मनो गुणाः।\nन तेषां युगपद् राजन् ह्रास उन्नाह एव च॥ ७/१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.009.m4a", "display_order": 11}, {"id": 6000139011, "chapter_id": 10139, "verse_number": "७-१-८", "content_sanskrit": "जयकाले तु सत्त्वस्य देवर्षीन् रजसोऽसुरान्।\nतमसो यक्षरक्षांसि तत्कालानुगुणो भजन्॥ ७/१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.010.m4a", "display_order": 12}, {"id": 6000139012, "chapter_id": 10139, "verse_number": "७-१-९", "content_sanskrit": "ज्योतिरादिरिवाभाति सङ्घातान्न विविच्यते।\nविन्दन्त्यात्मानमात्मस्थं मथित्वा कवयोऽन्ततः॥ ७/१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.011.m4a", "display_order": 13}, {"id": 6000139013, "chapter_id": 10139, "verse_number": "७-१-१०", "content_sanskrit": "यदा सिसृक्षुः पुर आत्मनः परो रजः सृजत्येष पृथक् स्वमायया।\nसत्वं विचित्रासु रिरंसुरीश्वरः शयिष्यमाणस्तम ईरयत्यसौ॥ ७/१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.012.m4a", "display_order": 14}, {"id": 6000139014, "chapter_id": 10139, "verse_number": "७-१-११", "content_sanskrit": "कालं चरन्तं सृजतीश आश्रयः प्रधानपुंभ्यां नरदेव सत्यकृत्।\nस तत्र तत्रोभयसिद्धिमाप्नुयात् लिङ्गात्मनो लिङ्गगुणाश्च सन्ति॥ ७/१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.013.m4a", "display_order": 15}, {"id": 6000139015, "chapter_id": 10139, "verse_number": "७-१-१२", "content_sanskrit": "य एष राजन्नपि काल ईशिता सत्त्वं सुरानीकमिवैधयत्यजः।\nतत्प्रत्यनीकानसुरान् सुरप्रियो रजस्तमस्कान् प्रमिणोत्युरुश्रवाः॥ ७/१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.014.m4a", "display_order": 16}, {"id": 6000139016, "chapter_id": 10139, "verse_number": "७-१-१३", "content_sanskrit": "स वै पुनः स्वसृष्टस्य स्थितिरक्षानुवृत्तये।\nसत्वं सुरगणान् विष्णुरुपबृंहयते मुहुः॥ ७/१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.015.m4a", "display_order": 17}, {"id": 6000139017, "chapter_id": 10139, "verse_number": "७-१-१४", "content_sanskrit": "अत्रैवोदाहृतः पूर्वमितिहासः सुरर्षिणा।\nप्रीत्या महाक्रतौ राजन् पृच्छतेऽजातशत्रवे॥ ७/१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.016.m4a", "display_order": 18}, {"id": 6000139018, "chapter_id": 10139, "verse_number": "७-१-१५", "content_sanskrit": "दृष्ट्वा महाद्भुतं राजा राजसूये महाक्रतौ।\nवासुदेवे भगवति सायुज्यं चेदिभूभुजः॥ ७/१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.017.m4a", "display_order": 19}, {"id": 6000139019, "chapter_id": 10139, "verse_number": "७-१-१६", "content_sanskrit": "तत्रासीनं सुरऋषिं राजा पाण्डुसुतः क्रतौ।\nपप्रच्छ विस्मितमना मुनीनां शृृण्वतामिदम्॥ ७/१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.018.m4a", "display_order": 20}, {"id": 6000139020, "chapter_id": 10139, "verse_number": null, "content_sanskrit": "युधिष्ठिर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.019.m4a", "display_order": 21}, {"id": 6000139021, "chapter_id": 10139, "verse_number": "७-१-१७", "content_sanskrit": "अहो ह्यत्यद्भुतं ह्येतद् दुर्लभैकान्तिनामपि।\nवासुदेवे परे तत्त्वे प्राप्तिश्चैद्यस्य विद्विषः॥ ७/१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.020.m4a", "display_order": 22}, {"id": 6000139022, "chapter_id": 10139, "verse_number": "७-१-१८", "content_sanskrit": "एतद् वेदितुमिच्छामः सर्व एव वयं मुने।\nभगवन्निन्दया वेनो द्विजैस्तमसि पातितः॥ ७/१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.021.m4a", "display_order": 23}, {"id": 6000139023, "chapter_id": 10139, "verse_number": "७-१-१९", "content_sanskrit": "दमघोषसुतः पाप आरभ्य कलभाषणात्।\nसम्प्रत्यमर्षी गोविन्दे दन्तवक्रश्च दुर्मतिः॥ ७/१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.022.m4a", "display_order": 24}, {"id": 6000139024, "chapter_id": 10139, "verse_number": "७-१-२०", "content_sanskrit": "शपतोरसकृद् विष्णुं यद् ब्रह्म परमव्ययम्।\nश्वित्रो न जातो जिह्वायां नान्धं विविशतुस्तमः॥ ७/१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.023.m4a", "display_order": 25}, {"id": 6000139025, "chapter_id": 10139, "verse_number": "७-१-२१", "content_sanskrit": "कथं तस्मिन् भगवति दुरवग्राह्यधामनि।\nपश्यतां सर्वलोकानां लयमीयतुरञ्जसा॥ ७/१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.024.m4a", "display_order": 26}, {"id": 6000139026, "chapter_id": 10139, "verse_number": "७-१-२२", "content_sanskrit": "एतद् भ्राम्यति मे बुद्धिर्दीपार्चिरिव वायुना।\nब्रूह्येतदद्भुततमं भगवन्नत्र कारणम्॥ ७/१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.025.m4a", "display_order": 27}, {"id": 6000139027, "chapter_id": 10139, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.026.m4a", "display_order": 28}, {"id": 6000139028, "chapter_id": 10139, "verse_number": "७-१-२३", "content_sanskrit": "राज्ञस्तद्वच आकर्ण्य नारदो भगवान् ऋषिः।\nतुष्टः प्राह तमाभाष्य शृण्वन्त्याः सदसः कथाः॥ ७/१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.027.m4a", "display_order": 29, "topics": [{"text": "कलभाषणमारभ्य श्रीकृष्णं द्विषतः शिशुपालस्य कथं सायुज्यप्राप्तिरिति युधिष्ठिरपृष्टेन नारदेन भगवत्पार्षदयोर्जयविजययोः सनकादिशापेनासुरयोनौ हिरण्यकशिपुहिरण्याक्षनाम्ना जननकथनम्", "range": "२३–४१"}]}, {"id": 6000139029, "chapter_id": 10139, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.028.m4a", "display_order": 30}, {"id": 6000139030, "chapter_id": 10139, "verse_number": "७-१-२४", "content_sanskrit": "निन्दनस्तवसत्कारन्यक्कारार्थं कलेवरम्।\nप्रधानपरयो राजन् अविवेकेन कल्पितम्॥ ७/१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.029.m4a", "display_order": 31}, {"id": 6000139031, "chapter_id": 10139, "verse_number": "७-१-२५", "content_sanskrit": "हिंसा तदभिमानेन दण्डपारुष्ययोर्यथा।\nवैषम्यमिह भूतानां ममाहमिति पार्थिव॥ ७/१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.030.m4a", "display_order": 32}, {"id": 6000139032, "chapter_id": 10139, "verse_number": "७-१-२६", "content_sanskrit": "यन्निबन्धोऽभिमानोऽयं तद्वधात् प्राणिनां वधः। तथा न यस्य कैवल्यादभिमानोऽखिलात्मनः।\nपरस्येदमकर्तुर्हि हिंसा केनास्य कल्प्यते॥ ७/१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.031.m4a", "display_order": 33}, {"id": 6000139033, "chapter_id": 10139, "verse_number": "७-१-२७", "content_sanskrit": "तस्माद् वैरानुबन्धेन निर्वैरेण भयेन वा।\nस्नेहात् कामेन वा युञ्ज्यात् कथञ्चिन्नेक्षते पृथक्॥ ७/१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.032.m4a", "display_order": 34}, {"id": 6000139034, "chapter_id": 10139, "verse_number": "७-१-२८", "content_sanskrit": "यथा वैरानुबन्धेन मर्त्यस्तन्मयतामियात्।\nन तथा भक्तियोगेन इति मे निश्चिता मतिः॥ ७/१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.033.m4a", "display_order": 35}, {"id": 6000139035, "chapter_id": 10139, "verse_number": "७-१-२९", "content_sanskrit": "कीटः पेशस्कृता रुद्धः कुड्ये यान्तमनुस्मरन्।\nसंरम्भभययोगेन विन्दते तत्सरूपताम्॥ ७/१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.034.m4a", "display_order": 36}, {"id": 6000139036, "chapter_id": 10139, "verse_number": "७-१-३०", "content_sanskrit": "एवं कृष्णे भगवति मायामनुज ईश्वरे।\nवैरेण धूतपाप्मानः तमापुरनुचिन्तया॥ ७/१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.035.m4a", "display_order": 37}, {"id": 6000139037, "chapter_id": 10139, "verse_number": "७-१-३१", "content_sanskrit": "कामात् स्नेहाद् भयाद् द्वेषाद् यथाभक्त्येश्वरे मनः।\nआवेश्य तदघं हित्वा बहवस्तद्गतिं गताः॥ ७/१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.036.m4a", "display_order": 38}, {"id": 6000139038, "chapter_id": 10139, "verse_number": "७-१-३२", "content_sanskrit": "गोप्यः कामाद् भयात्कंसो द्वेषाच्चैद्यादयो नृपाः।\nसम्बन्धाद् वृष्णयः स्नेहाद् यूयं भक्त्या वयं विभो॥ ७/१/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.037.m4a", "display_order": 39}, {"id": 6000139039, "chapter_id": 10139, "verse_number": "७-१-३३", "content_sanskrit": "कतमोऽपि न वेनस्य पञ्चानां पुरुषं प्रति।\nतस्मात् केनाप्युपायेन मनः कृष्णे निवेशयेत्॥ ७/१/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.038.m4a", "display_order": 40}, {"id": 6000139040, "chapter_id": 10139, "verse_number": "७-१-३४", "content_sanskrit": "मातृष्वस्रेयो वश्चैद्यो दन्तवक्रश्च पार्थिव।\nपार्षदप्रवरौ विष्णोर्विप्रशापात् पदच्युतौ॥ ७/१/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.039.m4a", "display_order": 41}, {"id": 6000139041, "chapter_id": 10139, "verse_number": null, "content_sanskrit": "युधिष्ठिर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.040.m4a", "display_order": 42}, {"id": 6000139042, "chapter_id": 10139, "verse_number": "७-१-३५", "content_sanskrit": "कीदृशः कस्य वा शापो हरिदासाभिमर्शनः।\nअश्रद्धेय इवाभाति हरेरेकान्तिनां भवः॥ ७/१/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.041.m4a", "display_order": 43}, {"id": 6000139043, "chapter_id": 10139, "verse_number": "७-१-३६", "content_sanskrit": "देहेन्द्रियासुहीनानां वैकुण्ठपुरवासिनाम्।\nदेहसम्बन्धसम्बन्धमेतदाख्यातुमर्हसि॥ ७/१/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.042.m4a", "display_order": 44}, {"id": 6000139044, "chapter_id": 10139, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.043.m4a", "display_order": 45}, {"id": 6000139045, "chapter_id": 10139, "verse_number": "७-१-३७", "content_sanskrit": "एकदा ब्रह्मणः पुत्रा विष्णोर्लोकं यदृच्छया।\nसनन्दनादयो जग्मुश्चरन्तो भुवनत्रयम्॥ ७/१/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.044.m4a", "display_order": 46}, {"id": 6000139046, "chapter_id": 10139, "verse_number": "७-१-३८", "content_sanskrit": "पञ्चषड्ढायनार्भाभाः पूर्वेषामपि पूर्वजाः।\nदिग्वाससः शिशून् मत्वा द्वाःस्थौ तान् प्रत्यषेधताम्॥ ७/१/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.045.m4a", "display_order": 47}, {"id": 6000139047, "chapter_id": 10139, "verse_number": "७-१-३९", "content_sanskrit": "अशपन् कुपिता एवं युवां वासं न चार्हथः।\nरजस्तमोभ्यां रहिते पादमूले मधुद्विषः॥ ७/१/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.046.m4a", "display_order": 48}, {"id": 6000139048, "chapter_id": 10139, "verse_number": "७-१-४०", "content_sanskrit": "पापिष्ठामासुरीं योनिं बालिशौ यातमाश्वतः।\nएवं शप्तौ स्वभवनात् पतन्तौ तैः कृपालुभिः॥ ७/१/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.047.m4a", "display_order": 49}, {"id": 6000139049, "chapter_id": 10139, "verse_number": "७-१-४१", "content_sanskrit": "प्रोक्तौ पुनर्जन्मभिर्वां त्रिभिर्लोकाय कल्पताम्। जज्ञाते तौ दितेः पुत्रौ दैत्यदानववन्दितौ।\nहिरण्यकशिपुर्ज्येष्ठो हिरण्याक्षोऽनुजस्ततः॥ ७/१/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.048.m4a", "display_order": 50}, {"id": 6000139050, "chapter_id": 10139, "verse_number": "७-१-४२", "content_sanskrit": "हतो हिरण्यकशिपुर्हरिणा सिंहरूपिणा।\nहिरण्याक्षो धरोद्धारे बिभ्रता सौकरं वपुः॥ ७/१/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.049.m4a", "display_order": 51, "topics": [{"text": "तयोः स्वपुत्रं द्विषन् हिरण्यकशिपुर्नृसिंहरूपिणा हरिणा हतः। हिरण्याक्षो वराहरूपिणा हरिणा हत इति च कथनम्", "range": "४१–४९"}]}, {"id": 6000139051, "chapter_id": 10139, "verse_number": "७-१-४३", "content_sanskrit": "हिरण्यकशिपुः पुत्रं प्रह्लादं भगवत्प्रियम्।\nजिघांसुरकरोन्नाना यातना मृत्युहेतवे॥ ७/१/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.050.m4a", "display_order": 52}, {"id": 6000139052, "chapter_id": 10139, "verse_number": "७-१-४४", "content_sanskrit": "तं सर्वभूतात्मभूतं प्रशान्तं समदर्शनम्।\nभगवत्तेजसा स्पृष्टं नाशक्नोद्धन्तुमुद्यमैः॥ ७/१/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.051.m4a", "display_order": 53}, {"id": 6000139053, "chapter_id": 10139, "verse_number": "७-१-४५", "content_sanskrit": "ततस्तौ राक्षसौ जातौ केशिन्यां विश्रवःसुतौ।\nरावणः कुम्भकर्णश्च सर्वलोकप्रतापिनौ॥ ७/१/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.052.m4a", "display_order": 54}, {"id": 6000139054, "chapter_id": 10139, "verse_number": "७-१-४६", "content_sanskrit": "तत्रापि राघवो भूत्वा न्यहनच्छापमुक्तये।\nरामवीर्यं श्रोष्यसि त्वं मार्कण्डेयमुखात् प्रभो॥ ७/१/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.053.m4a", "display_order": 55}, {"id": 6000139055, "chapter_id": 10139, "verse_number": "७-१-४७", "content_sanskrit": "तावद्य क्षत्रियौ जातौ मातृष्वस्रात्मजौ तव।\nअधुना शापनिर्मुक्तौ कृष्णचक्रहतांहसौ॥ ७/१/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.054.m4a", "display_order": 56}, {"id": 6000139056, "chapter_id": 10139, "verse_number": "७-१-४८", "content_sanskrit": "वैरानुबन्धतीव्रेण ध्यानेनाच्युतसाम्यताम्।\nनीतौ पुनर्हरेः पार्श्वं जग्मतुर्विष्णुपार्षदौ॥ ७/१/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.055.m4a", "display_order": 57}, {"id": 6000139057, "chapter_id": 10139, "verse_number": null, "content_sanskrit": "युधिष्ठिर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.056.m4a", "display_order": 58}, {"id": 6000139058, "chapter_id": 10139, "verse_number": "७-१-४९", "content_sanskrit": "विद्वेषो दयिते पुत्रे कथमासीन्महात्मनि।\nब्रूहि मे भगवन् येन प्रह्लादेऽप्यच्युतात्मनि॥ ७/१/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_001/BhP_07.001.057.m4a", "display_order": 59}, {"id": 6000139059, "chapter_id": 10139, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां सप्तमस्कन्धे प्रथमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]