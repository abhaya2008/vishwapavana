[{"id": 2030590, "chapter_id": 1669, "verse_number": "३-३०७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2030591, "chapter_id": 1669, "verse_number": "३-३०७-१", "content_sanskrit": "गते तस्मिन्द्विजश्रेष्ठे कस्मिंश्चित्कालपर्यये।\nचिन्तयामास सा कन्या मन्त्रग्रामबलाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2030592, "chapter_id": 1669, "verse_number": "३-३०७-२", "content_sanskrit": "अयं वै कीदृशस्तेन मम दत्तो हमात्मना।\nमन्त्रग्रामो बलं तस्य ज्ञास्ये नातिचिरादिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2030593, "chapter_id": 1669, "verse_number": "३-३०७-३", "content_sanskrit": "एवं संचिन्तयन्ती सा ददर्शर्तुं यदृच्छया।\nव्रीडिता साऽभवद्बाला कन्याभावे रजस्वला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2030594, "chapter_id": 1669, "verse_number": "३-३०७-४", "content_sanskrit": "ततो हर्म्यतलस्था सा महार्हशयनोचिता।\nप्राच्यां दिशि समुद्यन्तं ददर्शादित्यमण्डलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2030595, "chapter_id": 1669, "verse_number": "३-३०७-५", "content_sanskrit": "तत्र बद्धमनोदृष्टिरभवत्सा सुमध्यमा।\nन चातप्यत रूपेण भानोः सन्ध्यागतस्य सा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2030596, "chapter_id": 1669, "verse_number": "३-३०७-६", "content_sanskrit": "तस्या दृष्टिरभूद्दिव्या साऽपश्यद्दिव्यदर्शनम्।\nआमुक्तकवचं देवं कुण्डलाभ्यां विभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2030597, "chapter_id": 1669, "verse_number": "३-३०७-७", "content_sanskrit": "तस्याः कौतूहरलं त्वासीन्मन्त्रं प्रति नराधिप।\nआह्वानमकरोत्साऽथ तस्य देवस्य भामिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2030598, "chapter_id": 1669, "verse_number": "३-३०७-८", "content_sanskrit": "प्राणानुपस्पृश्य तदा ह्याजुहाव दिवाकरम्।\nआजगाम ततो राजंस्त्वरमाणो दिवाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2030599, "chapter_id": 1669, "verse_number": "३-३०७-९", "content_sanskrit": "मधुपिङ्गो महाबाहुः कम्बुग्रीवो हसन्निव।\nअङ्गदी बद्धमुकुटो दिशः प्रज्वालयन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2030600, "chapter_id": 1669, "verse_number": "३-३०७-१०", "content_sanskrit": "योगात्कृत्वा द्विधाऽऽत्मानमाजगाम तताप च।\nआबभाषे ततः कुन्तीं साम्ना परमबल्गुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2030601, "chapter_id": 1669, "verse_number": "३-३०७-११", "content_sanskrit": "आगतोस्मि वशं भद्रे तव मन्त्रबलात्कृतः।\nकिं करोमि वशो राज्ञि ब्रूहि कर्ता तदस्मि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2030602, "chapter_id": 1669, "verse_number": "३-३०७-१२x", "content_sanskrit": "कुन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2030603, "chapter_id": 1669, "verse_number": "३-३०७-१२", "content_sanskrit": "गम्यतां भगवंस्तत्र यत एवागतो ह्यसि।\nकौतूहलात्समाहूतः प्रसीद भगवन्निति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2030604, "chapter_id": 1669, "verse_number": "३-३०७-१३x", "content_sanskrit": "सूर्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2030605, "chapter_id": 1669, "verse_number": "३-३०७-१३", "content_sanskrit": "गमिष्येऽहं यथा मा त्वं ब्रवीषि तनुमध्यमे।\nन तु देवं समाहूय न्याय्यं प्रेषयितुं वृथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2030606, "chapter_id": 1669, "verse_number": "३-३०७-१४", "content_sanskrit": "तवाभिसन्धि सुभगे रसूर्यात्पुत्रो भवेदिति।\nवीर्येणाप्रतिमो लोके कवची कुण्डलीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2030607, "chapter_id": 1669, "verse_number": "३-३०७-१५", "content_sanskrit": "सा त्वमात्मप्रदानं वै कुरुष्व गजगामिनि।\nउत्पत्स्यति हि पुत्रस्ते यथासंकल्पमङ्गने।\nअथ गच्छाम्यहं भद्रे त्वया संगम्य सुस्मिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2030608, "chapter_id": 1669, "verse_number": "३-३०७-१६", "content_sanskrit": "यदि त्वंवचनं नाद्य करिष्यसि मम प्रियम्।\nशप्स्ये कन्येऽन्यथा क्रुद्धो ब्राह्मणं पितरं च ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2030609, "chapter_id": 1669, "verse_number": "३-३०७-१७", "content_sanskrit": "त्वत्कृते तान्प्रधक्ष्यामि सर्वानपि न संशयः।\nपितरं चैव ते मूढं यो न वेत्ति तवानयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2030610, "chapter_id": 1669, "verse_number": "३-३०७-१८", "content_sanskrit": "तस् च ब्राह्मणस्याद्य योसौ मन्त्रमदात्तव।\nशीलवृत्तमविज्ञाय धास्यामि विनयं परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2030611, "chapter_id": 1669, "verse_number": "३-३०७-१९", "content_sanskrit": "एते हि विबुधाः सर्वेपुरंदरमुखा दिवि।\nत्वया प्रलब्धं पश्यन्ति स्मयन्त इव मां शुभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2030612, "chapter_id": 1669, "verse_number": "३-३०७-२०", "content_sanskrit": "पश्य चैनान्सुरगणान्दिव्यं चक्षुरिदं हि ते।\nपूर्वमेव मया दत्तं दृष्टवत्यसि येन माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2030613, "chapter_id": 1669, "verse_number": "३-३०७-२१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2030614, "chapter_id": 1669, "verse_number": "३-३०७-२१", "content_sanskrit": "ततोऽपश्यत्रिदशान्राजपुत्री\nसर्वानव स्वेषु धिष्ण्येषु खस्थान्।\nप्रभावन्तं भानुमन्तं महान्तं\nयथाऽऽदित्यं रोचमानांस्तथैव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2030615, "chapter_id": 1669, "verse_number": "३-३०७-२२", "content_sanskrit": "सा तान्दृष्ट्वा त्रिदशानेव बाला\nसूर्यं देवी वचनं प्राह भीता।\nगच्छ त्वं वै गोपते स्वं विमानं\nकन्याभावाद्दुःख एवापचारः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2030616, "chapter_id": 1669, "verse_number": "३-३०७-२३", "content_sanskrit": "पिता माता गुरवश्चैवयेऽन्ये\nदेहस्यास्य प्रभवन्ति प्रदाने।\nनाहं धर्मं लोपयिष्यामि लोके\nस्त्रीणां वृत्तं पूज्यते देहरक्षा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2030617, "chapter_id": 1669, "verse_number": "३-३०७-२४", "content_sanskrit": "मया मन्त्रबलं ज्ञातुमाहूतस्त्वं विभावसो।\nबाल्याद्बालेति तत्कृत्वा क्षन्तुमर्हसि मे विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2030618, "chapter_id": 1669, "verse_number": "३-३०७-२५x", "content_sanskrit": "सूर्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2030619, "chapter_id": 1669, "verse_number": "३-३०७-२५", "content_sanskrit": "बालेति कृत्वाऽनुनयं तवाहं\nददानि नान्यानुनयं लभेत।\nआत्मप्रदानं कुरु कुन्तिकन्ये\nशान्तिस्तवैवं हि भवेच्च भीरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2030620, "chapter_id": 1669, "verse_number": "३-३०७-२६", "content_sanskrit": "न चापि गन्तुं युक्तं हि मया मिथ्याकृतेन वै।\nअसमेत्य त्वया भीरु मन्त्राहूतेन भामिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2030621, "chapter_id": 1669, "verse_number": "३-३०७-२७", "content_sanskrit": "गमिष्याम्यनवद्याङ्गि लोके समवहास्यताम्।\n`गच्छेयमेव सुश्रोणि गतोऽहं वै निराकृतः।\nसर्वेषां विबुधानां च वक्तव्यः स्यां तथा शुभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2030622, "chapter_id": 1669, "verse_number": "", "content_sanskrit": "सा त्वं मया समागच्छ पुत्रं लप्स्यसि माध्शम्।\nविशिष्टा सर्वलोकेषु भविष्यसि न संशय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]