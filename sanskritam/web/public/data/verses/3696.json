[{"id": 2125856, "chapter_id": 3696, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2125857, "chapter_id": 3696, "verse_number": "१", "content_sanskrit": "गतेषु लोकपालेषु पार्थः शत्रुनिबर्हणः ।\nचिन्तयामास राजेन्द्र देवराजरथागमम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2125858, "chapter_id": 3696, "verse_number": "२", "content_sanskrit": "ततश्चिन्तयमानस्य गुडाकेशस्य धीमतः ।\nरथो मातलिसंयुक्त आजगाम महाप्रभः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2125859, "chapter_id": 3696, "verse_number": "३", "content_sanskrit": "नभो वितिमिरं कुर्वन् जलदान् पाटयन्निव ।\nदिशः सम्पूरयन् नादैर्महामेघरवोपमैः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2125860, "chapter_id": 3696, "verse_number": "४", "content_sanskrit": "असयः शक्तयो भीमा गदाश्चोग्रप्रदर्शनाः ।\nदिव्यप्रभावाः प्रासाश्च विद्युतश्च महाप्रभाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2125861, "chapter_id": 3696, "verse_number": "५", "content_sanskrit": "तथैवाशनयस्तत्र चक्रयुक्ता हुलाहुलाः ।\nवायुस्फोटाः सनिर्घाताः शङ्खमेघनिभास्तथा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2125862, "chapter_id": 3696, "verse_number": "६", "content_sanskrit": "तत्र नागा महाकाया ज्वलितास्याः सुदारुणाः ।\nसिताभ्रकूटप्रतिमाः संहताश्च यथोपलाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2125863, "chapter_id": 3696, "verse_number": "७", "content_sanskrit": "दशवाजिसहस्राणि हरीणां वातरंहसाम् ।\nवहन्ति यं नेत्रमुषं दिव्यं मायामयं रथम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2125864, "chapter_id": 3696, "verse_number": "८", "content_sanskrit": "तत्रापश्यन्महीपालो वैजयन्तं महाप्रभम् ।\nध्वजमिन्दीवरश्यामं वंशं कनकभूषितम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2125865, "chapter_id": 3696, "verse_number": "९", "content_sanskrit": "तस्मिन् रथे स्थितं सूतं हेमजालविभूषितम् ।\nदृष्ट्वा पार्थो महाबाहुर्देवराजमतर्कयत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2125866, "chapter_id": 3696, "verse_number": "१०", "content_sanskrit": "तथा तर्कयतस्तस्य फल्गुनस्य स मातलिः ।\nसन्नतः प्रश्रितो भूत्वा वाक्यमर्जुनमब्रवीत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2125867, "chapter_id": 3696, "verse_number": "११", "content_sanskrit": "भो भो शक्रात्मज श्रीमन् शक्रस्त्वां द्रष्टुमिच्छति ।\nआरोहतु भवान् शीघ्रं रथमिन्द्रस्य सम्मतम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2125868, "chapter_id": 3696, "verse_number": "१२", "content_sanskrit": "आह माममरश्रेष्ठः पिता तव शतक्रतुः ।\nकुन्तीमातरिह प्राप्तं पश्यन्तु त्रिदशालयाः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2125869, "chapter_id": 3696, "verse_number": "१३", "content_sanskrit": "एष शक्रः परिवृतो देवैः सर्षिगणैस्तथा ।\nगन्धवैरप्सरोभिश्च त्वां दिदृक्षुः प्रतीक्षते \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2125870, "chapter_id": 3696, "verse_number": "१४", "content_sanskrit": "अस्माल्लोकाद्देवलोकं पाकशासनशासनात् ।\nआरोह त्वं मया सार्धं लब्धास्त्रः पुनरेष्यसि \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2125871, "chapter_id": 3696, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2125872, "chapter_id": 3696, "verse_number": "१५", "content_sanskrit": "मातले गच्छ शीघ्रं त्वमारोहस्व रथोत्तमम् ।\nराजसूयाश्वमेधानां शतैरपि सुदुर्लभम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2125873, "chapter_id": 3696, "verse_number": "१६", "content_sanskrit": "पार्थिवैः सुमहाभागैर्यज्वभिर्भूरिदक्षिणैः ।\nदैवतैर्वा समारोढुं दानवैर्वा महारथम् ।\nद्रष्टुं वाऽप्यथवा स्प्रष्टुमारोढुं कुत एव तत् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2125874, "chapter_id": 3696, "verse_number": "१७", "content_sanskrit": "त्वयि प्रतिष्ठिते साधो रथस्थे स्थिरवाजिनि ।\nपश्चादहमथारोक्ष्ये सुकृती सत्पथं यथा \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2125875, "chapter_id": 3696, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2125876, "chapter_id": 3696, "verse_number": "१८", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा मातलिः शक्रसारथिः ।\nआरुरोह रथं शीघ्रं हयाञ्जग्राह रश्मिभिः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2125877, "chapter_id": 3696, "verse_number": "१९", "content_sanskrit": "ततोऽर्जुनो हृष्टमना गङ्गायामाप्लुतः शुचिः ।\nजजाप जप्यं कौन्तेय विधिवत् कुरुनन्दनः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2125878, "chapter_id": 3696, "verse_number": "२०", "content_sanskrit": "ततः पितॄन् यथान्यायं तर्पयित्वा यथाविधि ।\nमन्दरं शैलराजं तमाप्रष्टुमुपचक्रमे\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2125879, "chapter_id": 3696, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2125880, "chapter_id": 3696, "verse_number": "२१", "content_sanskrit": "साधूनां पुण्यशीलानां मुनीनां पुण्यकर्मणाम् ।\nत्वं सदा संश्रयः शैलं तथा स्वर्गाभिकाङ्क्षिणाम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2125881, "chapter_id": 3696, "verse_number": "२२", "content_sanskrit": "त्वत्प्रसादान्महाशैल ब्राह्मणाः क्षत्रिया विशः ।\nस्वर्गं प्राप्ताश्चरन्ति स्म देवैः सह गतव्यथाः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2125882, "chapter_id": 3696, "verse_number": "२३", "content_sanskrit": "अद्रिराज महाशैल मुनिसंश्रय तीर्थवन् ।\nगच्छाम्यामन्त्रयामि त्वां सुखमस्म्युषितस्त्वयि\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2125883, "chapter_id": 3696, "verse_number": "२४", "content_sanskrit": "तव सानूनि कुञ्जाश्च नद्यः प्रस्रवणानि च ।\nतीर्थानि च सुपुण्यानि मया दृष्टान्यनेकशः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2125884, "chapter_id": 3696, "verse_number": "२५", "content_sanskrit": "फलानि च सुगन्धीनि भक्षितानि ततस्त्वयि ।\nसुसुगन्धाश्च वार्योघाः त्वच्छरीरविनिस्सृताः ।\nअमृतास्वादनीया मे पीताः प्रस्रवणोदकाः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2125885, "chapter_id": 3696, "verse_number": "२६", "content_sanskrit": "शिशुर्यथा पितुश्चाङ्के सुखं शेते नगे तथा ।\nमया चैव तवाङ्केऽत्र लळितं नगसत्तम \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2125886, "chapter_id": 3696, "verse_number": "२७", "content_sanskrit": "अप्सरोगणसङ्कीर्णे ब्रह्मघोषानुनादिते ।\nसुखमध्युषितः शैल तव सानुनि नित्यदा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2125887, "chapter_id": 3696, "verse_number": "२८", "content_sanskrit": "एवमुक्त्वाऽर्जुनः शैलमामन्त्रयत शत्रुहा ।\nआरुरोह रथं दिव्यं द्योतयन्निव भास्करः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2125888, "chapter_id": 3696, "verse_number": "२९", "content_sanskrit": "स तेनादित्यवर्णेन दिव्येनाद्भुतकर्मणा ।\nऊर्ध्वमाचक्रमे धीमान् प्रहृष्टः कुरुनन्दनः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2125889, "chapter_id": 3696, "verse_number": "३०", "content_sanskrit": "सोऽदर्शनपथं गत्वा मर्त्यानां भूमिचारिणाम् ।\nददर्शाद्भुतरूपाणि विमानानि सहस्रशः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2125890, "chapter_id": 3696, "verse_number": "३१", "content_sanskrit": "न तत्र सूर्यः सोमो न द्योतते नोत पावकः ।\nस्वयैव प्रभया युक्ता द्योतन्ते पुण्यलक्षणाः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2125891, "chapter_id": 3696, "verse_number": "३२", "content_sanskrit": "तारारूपाणि यानीह दृश्यन्ते द्युतिमन्ति वै ।\nदीपवद् विप्रकृष्टत्वाद् अणूनि सुमहान्त्यपि \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2125892, "chapter_id": 3696, "verse_number": "३३", "content_sanskrit": "तानि तत्र च भास्वन्ति रूपवन्ति च पाण्डवः ।\nददर्श तेषु धिष्ण्येषु दीप्तिमन्ति स्वयाऽर्चिषा \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2125893, "chapter_id": 3696, "verse_number": "३४", "content_sanskrit": "तत्र राजर्षयस्सिद्धा धीराश्च निहता युधि ।\nतपसा च जितस्वर्गाः सम्पेतुः शतसङ्घशः \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2125894, "chapter_id": 3696, "verse_number": "३५", "content_sanskrit": "गन्धर्वाणां सहस्राणि सूर्यज्वलिततेजसाम् ।\nगुह्यकानामृषीणां च तथैवाप्सरसां गणान्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2125895, "chapter_id": 3696, "verse_number": "३६", "content_sanskrit": "लोकानात्मप्रभान् पश्यन् फल्गुनो विस्मयान्वितः ।\nपप्रच्छ मातलिं प्रीत्या स चाप्येनमुवाच ह\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2125896, "chapter_id": 3696, "verse_number": "३७", "content_sanskrit": "एते सुकृतिनः पार्थ स्वेषु धिष्ण्येषु विष्ठिताः ।\nयान् दृष्टवानसि विभो तारारूपाणि भूतले\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2125897, "chapter_id": 3696, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2125898, "chapter_id": 3696, "verse_number": "३८", "content_sanskrit": "ततोऽपश्यत् स्थितं द्वारि सितं विजयिनं गजम् ।\nऐरावतं चतुर्दन्तं कैलासमिव शृङ्गिणम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2125899, "chapter_id": 3696, "verse_number": "३९", "content_sanskrit": "स सिद्धमार्गमाक्रम्य कुरुपाण्डवसत्तमः ।\nव्यरोचत यथापूर्वं मान्धाता पार्थिवोत्तमः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2125900, "chapter_id": 3696, "verse_number": "४०", "content_sanskrit": "अतिचक्राम लोकान् स राज्ञां राजीवलोचनः ।\nततो ददर्श शक्रस्य पुरीं नाम्नाऽमरावतीम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2125901, "chapter_id": 3696, "verse_number": "१", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि अष्टत्रिंशोऽध्यायः ॥३८॥\n॥ इन्द्रलोकाभिगमनपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]