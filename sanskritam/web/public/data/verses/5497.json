[{"id": 2210193, "chapter_id": 5497, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2210194, "chapter_id": 5497, "verse_number": "१", "content_sanskrit": "श्रपयित्वा पशूनन्यान् विधिवद् द्विजसत्तमाः ।\nतुरगं तं यथाशास्त्रमालभन्त द्विजातयः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2210195, "chapter_id": 5497, "verse_number": "२", "content_sanskrit": "ततः सञ्ज्ञप्य तुरगं विधिवद्याजकर्षभाः ।\nउपसंवेशयाञ्चक्रुस्ततस्तां द्विजसत्तमाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2210196, "chapter_id": 5497, "verse_number": "३", "content_sanskrit": "कलाभिस्तिसृभी राजन् यथाविधि समन्विताम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2210197, "chapter_id": 5497, "verse_number": "४", "content_sanskrit": "उद्धृत्य तु वपां तत्र यथाशास्त्रं द्विजर्षभाः ।\nश्रपयामासुरपराः शास्त्रवद् भरतर्षभ ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2210198, "chapter_id": 5497, "verse_number": "५", "content_sanskrit": "तं वपाधूमगन्धं तु धर्मराजः सहानुजः ।\nउपाजिघ्रद् यथान्यायं सर्वपाप्मापहं तदा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2210199, "chapter_id": 5497, "verse_number": "६", "content_sanskrit": "शिष्टान्यङ्गानि यान्यासन् तस्याश्वस्य नराधिप ।\nतान्यग्नौ जुहुवुर्धीराः समस्ताः षोडशर्त्विजः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2210200, "chapter_id": 5497, "verse_number": "७", "content_sanskrit": "संस्थाप्यैवं तस्य राज्ञस्तं क्रतुं शक्रतेजसः ।\nयथाशास्त्रं महाराज ऋषयः शक्रतेजसः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2210201, "chapter_id": 5497, "verse_number": "८", "content_sanskrit": "व्यासः सशिष्यो भगवान् वर्धयामास तं नृपम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2210202, "chapter_id": 5497, "verse_number": "९", "content_sanskrit": "ततो युधिष्ठिरः प्रादात् सदस्येभ्यो यथाविधि ।\nकोटीः सहस्रं निष्काणां व्यासाय तु वसुन्धराम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2210203, "chapter_id": 5497, "verse_number": "१०", "content_sanskrit": "प्रतिगृह्य धरां राजन् व्यासः सत्यवतीसुतः ।\nअब्रवीद् भरतश्रेष्ठं धर्मात्मानं युधिष्ठिरम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2210204, "chapter_id": 5497, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2210205, "chapter_id": 5497, "verse_number": "११", "content_sanskrit": "पृथिवी भवतस्त्वेषा सन्न्यस्ता राजसत्तम ।\nनिष्क्रयो दीयतां मह्यं ब्राह्मणा हि धनार्थिनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2210206, "chapter_id": 5497, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2210207, "chapter_id": 5497, "verse_number": "१२", "content_sanskrit": "युधिष्ठिरस्तु तान् विप्रान् प्रत्युवाच महामनाः ।\nभ्रातृभिः सहितो धीमान् मध्ये राज्ञां महात्मनाम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2210208, "chapter_id": 5497, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2210209, "chapter_id": 5497, "verse_number": "१३", "content_sanskrit": "अश्वमेधे महायज्ञे पृथिवी दक्षिणा स्मृता ।\nअर्जुनेन जिता सेयमृत्विग्भ्यः प्रापिता मया ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2210210, "chapter_id": 5497, "verse_number": "१४", "content_sanskrit": "वनं यास्यामि विप्रेन्द्रा विभज्यध्वं महीमिमाम् ।\nचतुर्धा पृथिवीं कृत्वा चातुर्होत्रप्रमाणतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2210211, "chapter_id": 5497, "verse_number": "१५", "content_sanskrit": "नाहमादातुमिच्छामि ब्रह्मस्वं मुनिसत्तमाः ।\nइदं मतं हि मे नित्यं भ्रातॄणां च ममानघाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2210212, "chapter_id": 5497, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2210213, "chapter_id": 5497, "verse_number": "१६", "content_sanskrit": "इत्युक्तवति तस्मिंस्ते भ्रातरो द्रौपदी च सा ।\nएवमेतदिति प्राहुस्तदभूद् रोमहर्षणम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2210214, "chapter_id": 5497, "verse_number": "१७", "content_sanskrit": "ततोऽन्तरिक्षे वागासीत् साधु साध्विति भारत ।\nतथैव द्विजसङ्घानां शंसतां विबभौ स्वनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2210215, "chapter_id": 5497, "verse_number": "१८", "content_sanskrit": "द्वैपायनस्तथोक्तस्तु पुनरेव युधिष्ठिरम् ।\nउवाच मध्ये विप्राणामिदं सम्पूजयन् मुनिः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2210216, "chapter_id": 5497, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2210217, "chapter_id": 5497, "verse_number": "१९", "content_sanskrit": "दत्तैषा भवता मह्यं तां ते प्रतिददाम्यहम् ।\nहिरण्यं दीयतामेभ्यो द्विजातिभ्यो धराऽस्तु ते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2210218, "chapter_id": 5497, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2210219, "chapter_id": 5497, "verse_number": "२०", "content_sanskrit": "ततोऽब्रवीद् वासुदेवो धर्मराजं युधिष्ठिरम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2210220, "chapter_id": 5497, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2210221, "chapter_id": 5497, "verse_number": "२१", "content_sanskrit": "यथाऽऽह भगवान् व्यासस्तथा त्वं कर्तुमर्हसि ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2210222, "chapter_id": 5497, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2210223, "chapter_id": 5497, "verse_number": "२२", "content_sanskrit": "इत्युक्तः स कुरुश्रेष्ठः प्रीतात्मा भ्रातृभिः सह ।\nकोटिं कोटिं गवां प्रादाद् दक्षिणां त्रिगुणां क्रतौ ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2210224, "chapter_id": 5497, "verse_number": "२३", "content_sanskrit": "न करिष्यति तल्लोके कश्चिदन्यो नराधिप ।\nयत्कृतं कुरुसिंहेन मरुत्तमनुकुर्वता ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2210225, "chapter_id": 5497, "verse_number": "२४", "content_sanskrit": "प्रतिगृह्य तु तद्रत्नं कृष्णद्वैपायनः प्रभुः ।\nऋत्विग्भ्यः प्रददौ विद्वान् चतुर्धा व्यभजंश्च ते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2210226, "chapter_id": 5497, "verse_number": "२५", "content_sanskrit": "पृथिव्या निष्क्रयं दत्त्वा तद्धिरण्यं युधिष्ठिरः ।\nधूतपाप्मा जितस्वर्गो मुमुदे भ्रातृभिः सह ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2210227, "chapter_id": 5497, "verse_number": "२६", "content_sanskrit": "ऋत्विजस्तमपर्यन्तं सुवर्णनिचयं तदा ।\nव्यभजन्त द्विजातिभ्यो यथोत्साहं यथाविधि ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2210228, "chapter_id": 5497, "verse_number": "२७", "content_sanskrit": "यज्ञवाटे तु यत् किञ्चिद्धिरण्यमपि भूषणम् ।\nतोरणानि च यूपांश्च घटान् पात्रीस्तथेष्टकाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2210229, "chapter_id": 5497, "verse_number": "२८", "content_sanskrit": "युधिष्ठिराभ्यनुज्ञातास्तत् सर्वं व्यभजन् द्विजाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2210230, "chapter_id": 5497, "verse_number": "२९", "content_sanskrit": "अनन्तरं ब्राह्मणेभ्यः क्षत्रिया जह्रिरे वसु ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2210231, "chapter_id": 5497, "verse_number": "३०", "content_sanskrit": "तथा विट्शूद्रसङ्घाश्च तथाऽन्ये म्लेच्छजातयः ।\nकालेन महता जह्रुस्तत् सुवर्णं ततस्ततः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2210232, "chapter_id": 5497, "verse_number": "३१", "content_sanskrit": "ततस्ते ब्राह्मणाः सर्वे मुदिता जग्मुरालयान् ।\nतर्पिता वसुना चैव धर्मराज्ञा महात्मना ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2210233, "chapter_id": 5497, "verse_number": "३२", "content_sanskrit": "स्वमंशं भगवान् व्यासः कुन्त्यै पादाभिवादितः ।\nप्रददौ तस्य महतो हिरण्यस्य महाद्युतिः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2210234, "chapter_id": 5497, "verse_number": "३३", "content_sanskrit": "श्वशुरात् प्रीतिदानं तत् प्राप्य सा प्रीतमानसा ।\nचकार पुण्यं कालेन सुमहद्धि पृथा तथा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2210235, "chapter_id": 5497, "verse_number": "३४", "content_sanskrit": "गत्वा त्ववभृथं राजा विपाप्मा भ्रातृभिः सह ।\nसभाज्यमानः शुशुभे महेन्द्रो दैवतैरिव ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2210236, "chapter_id": 5497, "verse_number": "३५", "content_sanskrit": "पाण्डवाश्च महीपालैः समेतैः संवृतास्तदा ।\nअशोभन्त महाराज ग्रहास्तारागणैर्यथा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2210237, "chapter_id": 5497, "verse_number": "३६", "content_sanskrit": "राजभ्योऽपि ततः प्रादाद् रत्नानि विविधानि च ।\nगजानश्वानलङ्कारान् स्त्रीश्च रत्नानि काञ्चनम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2210238, "chapter_id": 5497, "verse_number": "३७", "content_sanskrit": "तद्धनौघमपर्यन्तं पार्थः पार्थिवमण्डले ।\nविसृजन् शुशुभे राजन् यथा वैश्रवणस्तथा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2210239, "chapter_id": 5497, "verse_number": "३८", "content_sanskrit": "आनीय च तथा वीरं राजानं बभ्रुवाहनम् ।\nप्रदाय बहुलं वित्तं गृहान् प्रास्थापयत् तदा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2210240, "chapter_id": 5497, "verse_number": "३९", "content_sanskrit": "दुःशलायाश्च तं पौत्रं बालकं भरतर्षभ ।\nस्वराज्ये पितृभिर्भुक्ते प्रीत्या समभिषेचयत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2210241, "chapter_id": 5497, "verse_number": "४०", "content_sanskrit": "राज्ञश्चैवापि तान् सर्वान् सुविभक्तान् सुपूजितान् ।\nप्रस्थापयामास वशी कुरुराजो युधिष्ठिरः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2210242, "chapter_id": 5497, "verse_number": "४१", "content_sanskrit": "एवं बभूव यज्ञः स धर्मराजस्य धीमतः ।\nबह्वन्नधनरत्नौघः सुरामैरेयसागरः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2210243, "chapter_id": 5497, "verse_number": "४२", "content_sanskrit": "सर्पिषश्च ह्रदा यत्र बहवश्चान्नपर्वताः ।\nरसालकर्दमाः कुल्या बभूवुर्भरतर्षभ ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2210244, "chapter_id": 5497, "verse_number": "४३", "content_sanskrit": "भक्ष्याः षडवराङ्गानां क्रियतां भुज्यतामिति ।\nपशूनां वध्यमानानां नान्तं ददृशिरे जनाः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2210245, "chapter_id": 5497, "verse_number": "४४", "content_sanskrit": "मत्तोन्मत्तप्रमुदितं प्रगीतवनिताजनम् ।\nमृदङ्गशङ्खनादैश्च मनोरममभूत् तदा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2210246, "chapter_id": 5497, "verse_number": "४५", "content_sanskrit": "दीयतां भुज्यतां चेति तत्र शब्दो महानभूत् ।\nपीयतां दीयतां चेति दिवारात्रमवारिताः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2210247, "chapter_id": 5497, "verse_number": "४६", "content_sanskrit": "तं महोत्सवसङ्काशमतिहृष्टजनाकुलम् ।\nकथयन्ति स्म पुरुषा नानादेशनिवासिनः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2210248, "chapter_id": 5497, "verse_number": "४७", "content_sanskrit": "वर्षित्वा धनधाराभिः कामै रत्नैर्धनैस्तथा ।\nविपाप्मा भरतश्रेष्ठः कृतार्थं प्राविशत् पुरीम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2210249, "chapter_id": 5497, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि पाण्डवानां पुरप्रवेशो नाम एकनवतितमोऽध्यायः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]