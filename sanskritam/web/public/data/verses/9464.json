[{"id": 5000464000, "chapter_id": 9464, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे सप्तपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000464001, "chapter_id": 9464, "verse_number": "६-५७-१", "content_sanskrit": "अकम्पनवधं श्रुत्वा क्रुद्धो वै राक्षसेश्वरः।\nकिंचिद् दीनमुखश्चापि सचिवांस्तानुदैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000464002, "chapter_id": 9464, "verse_number": "६-५७-२", "content_sanskrit": "स तु ध्यात्वा मुहूर्तं तु मन्त्रिभिः संविचार्य च।\nततस्तु रावणः पूर्वदिवसे राक्षसाधिपः।\nपुरीं परिययौ लङ्कां सर्वान् गुल्मानवेक्षितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000464003, "chapter_id": 9464, "verse_number": "६-५७-३", "content_sanskrit": "तां राक्षसगणैर्गुप्तां गुल्मैर्बहुभिरावृताम्।\nददर्श नगरीं राजा पताकाध्वजमालिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000464004, "chapter_id": 9464, "verse_number": "६-५७-४", "content_sanskrit": "रुद्धां तु नगरीं दृष्ट्वा रावणो राक्षसेश्वरः।\nउवाचात्महितं काले प्रहस्तं युद्धकोविदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000464005, "chapter_id": 9464, "verse_number": "६-५७-५", "content_sanskrit": "पुरस्योपनिविष्टस्य सहसा पीडितस्य ह।\nनान्ययुद्धात् प्रपश्यामि मोक्षं युद्धविशारद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000464006, "chapter_id": 9464, "verse_number": "६-५७-६", "content_sanskrit": "अहं वा कुम्भकर्णो वा त्वं वा सेनापतिर्मम।\nइन्द्रजिद् वा निकुम्भो वा वहेयुर्भारमीदृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000464007, "chapter_id": 9464, "verse_number": "६-५७-७", "content_sanskrit": "स त्वं बलमतः शीघ्रमादाय परिगृह्य च।\nविजयायाभिनिर्याहि यत्र सर्वे वनौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000464008, "chapter_id": 9464, "verse_number": "६-५७-८", "content_sanskrit": "निर्याणादेव तूर्णं च चलिता हरिवाहिनी।\nनर्दतां राक्षसेन्द्राणां श्रुत्वा नादं द्रविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000464009, "chapter_id": 9464, "verse_number": "६-५७-९", "content_sanskrit": "चपला ह्यविनीताश्च चलचित्ताश्च वानराः।\nन सहिष्यन्ति ते नादं सिंहनादमिव द्विपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000464010, "chapter_id": 9464, "verse_number": "६-५७-१०", "content_sanskrit": "विद्रुते च बले तस्मिन् रामः सौमित्रिणा सह।\nअवशस्ते निरालम्बः प्रहस्त वशमेष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000464011, "chapter_id": 9464, "verse_number": "६-५७-११", "content_sanskrit": "आपत्संशयिता श्रेयो नात्र निःसंशयीकृता।\nप्रतिलोमानुलोमं वा यत् तु नो मन्यसे हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000464012, "chapter_id": 9464, "verse_number": "६-५७-१२", "content_sanskrit": "रावणेनैवमुक्तस्तु प्रहस्तो वाहिनीपतिः।\nराक्षसेन्द्रमुवाचेदमसुरेन्द्रमिवोशना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000464013, "chapter_id": 9464, "verse_number": "६-५७-१३", "content_sanskrit": "राजन् मन्त्रितपूर्वं नः कुशलैः सह मन्त्रिभिः।\nविवादश्चापि नो वृत्तः समवेक्ष्य परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000464014, "chapter_id": 9464, "verse_number": "६-५७-१४", "content_sanskrit": "प्रदानेन तु सीतायाः श्रेयो व्यवसितं मया।\nअप्रदाने पुनर्युद्धं दृष्टमेव तथैव नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000464015, "chapter_id": 9464, "verse_number": "६-५७-१५", "content_sanskrit": "सोऽहं दानैश्च मानैश्च सततं पूजितस्त्वया।\nसान्त्वैश्च विविधैः काले किं न कुर्यां हितं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000464016, "chapter_id": 9464, "verse_number": "६-५७-१६", "content_sanskrit": "नहि मे जीवितं रक्ष्यं पुत्रदारधनानि च।\nत्वं पश्य मां जुहूषन्तं त्वदर्थे जीवितं युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000464017, "chapter_id": 9464, "verse_number": "६-५७-१७", "content_sanskrit": "एवमुक्त्वा तु भर्तारं रावणं वाहिनीपतिः।\nउवाचेदं बलाध्यक्षान् प्रहस्तः पुरतः स्थितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000464018, "chapter_id": 9464, "verse_number": "६-५७-१८", "content_sanskrit": "समानयत मे शीघ्रं राक्षसानां महाबलम्।\nमद‍्बाणानां तु वेगेन हतानां च रणाजिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000464019, "chapter_id": 9464, "verse_number": "६-५७-१९", "content_sanskrit": "अद्य तृप्यन्तु मांसादाः पक्षिणः काननौकसाम्।\nतस्य तद् वचनं श्रुत्वा बलाध्यक्षा महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000464020, "chapter_id": 9464, "verse_number": "६-५७-२०", "content_sanskrit": "बलमुद्योजयामासुस्तस्मिन् राक्षसमन्दिरे।\nसा बभूव मुहूर्तेन भीमैर्नानाविधायुधैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000464021, "chapter_id": 9464, "verse_number": "६-५७-२१", "content_sanskrit": "लङ्का राक्षसवीरैस्तैर्गजैरिव समाकुला।\nहुताशनं तर्पयतां ब्राह्मणांश्च नमस्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000464022, "chapter_id": 9464, "verse_number": "६-५७-२२", "content_sanskrit": "आज्यगन्धप्रतिवहः सुरभिर्मारुतो ववौ।\nस्रजश्च विविधाकारा जगृहुस्त्वभिमन्त्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000464023, "chapter_id": 9464, "verse_number": "६-५७-२३", "content_sanskrit": "संग्रामसज्जाः संहृष्टा धारयन् राक्षसास्तदा।\nसधनुष्काः कवचिनो वेगादाप्लुत्य राक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000464024, "chapter_id": 9464, "verse_number": "६-५७-२४", "content_sanskrit": "रावणं प्रेक्ष्य राजानं प्रहस्तं पर्यवारयन्।\nअथामन्त्र्य तु राजानं भेरीमाहत्य भैरवाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000464025, "chapter_id": 9464, "verse_number": "६-५७-२५", "content_sanskrit": "आरुरोह रथं युक्तः प्रहस्तः सज्जकल्पितम्।\nहयैर्महाजवैर्युक्तं सम्यक्सूतं सुसंयतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000464026, "chapter_id": 9464, "verse_number": "६-५७-२६", "content_sanskrit": "महाजलदनिर्घोषं साक्षाच्चन्द्रार्कभास्वरम्।\nउरगध्वजदुर्धर्षं सुवरूथं स्वपस्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000464027, "chapter_id": 9464, "verse_number": "६-५७-२७", "content_sanskrit": "सुवर्णजालसंयुक्तं प्रहसन्तमिव श्रिया।\nततस्तं रथमास्थाय रावणार्पितशासनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000464028, "chapter_id": 9464, "verse_number": "६-५७-२८", "content_sanskrit": "लङ्काया निर्ययौ तूर्णं बलेन महता वृतः।\nततो दुन्दुभिनिर्घोषः पर्जन्यनिनदोपमः।\nवादित्राणां च निनदः पूरयन्निव मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000464029, "chapter_id": 9464, "verse_number": "६-५७-२९", "content_sanskrit": "शुश्रुवे शङ्खशब्दश्च प्रयाते वाहिनीपतौ।\nनिनदन्तः स्वरान् घोरान् राक्षसा जग्मुरग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000464030, "chapter_id": 9464, "verse_number": "६-५७-३०", "content_sanskrit": "भीमरूपा महाकायाः प्रहस्तस्य पुरःसराः।\nनरान्तकः कुम्भहनुर्महानादः समुन्नतः।\nप्रहस्तसचिवा ह्येते निर्ययुः परिवार्य तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000464031, "chapter_id": 9464, "verse_number": "६-५७-३१", "content_sanskrit": "व्यूढेनैव सुघोरेण पूर्वद्वारात् स निर्ययौ।\nगजयूथनिकाशेन बलेन महता वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000464032, "chapter_id": 9464, "verse_number": "६-५७-३२", "content_sanskrit": "सागरप्रतिमौघेन वृतस्तेन बलेन सः।\nप्रहस्तो निर्ययौ क्रुद्धः कालान्तकयमोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000464033, "chapter_id": 9464, "verse_number": "६-५७-३३", "content_sanskrit": "तस्य निर्याणघोषेण राक्षसानां च नर्दताम्।\nलङ्कायां सर्वभूतानि विनेदुर्विकृतैः स्वरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000464034, "chapter_id": 9464, "verse_number": "६-५७-३४", "content_sanskrit": "व्यभ्रमाकाशमाविश्य मांसशोणितभोजनाः।\nमण्डलान्यपसव्यानि खगाश्चक्रू रथं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000464035, "chapter_id": 9464, "verse_number": "६-५७-३५", "content_sanskrit": "वमन्त्यः पावकज्वालाः शिवा घोरा ववाशिरे।\nअन्तरिक्षात् पपातोल्का वायुश्च परुषं ववौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000464036, "chapter_id": 9464, "verse_number": "६-५७-३६", "content_sanskrit": "अन्योन्यमभिसंरब्धा ग्रहाश्च न चकाशिरे।\nमेघाश्च खरनिर्घोषा रथस्योपरि रक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000464037, "chapter_id": 9464, "verse_number": "६-५७-३७", "content_sanskrit": "ववर्षू रुधिरं चास्य सिषिचुश्च पुरःसरान्।\nकेतुमूर्धनि गृध्रस्तु विलीनो दक्षिणामुखः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000464038, "chapter_id": 9464, "verse_number": "६-५७-३८", "content_sanskrit": "नदन्नुभयतः पार्श्वं समग्रां श्रियमाहरत्।\nसारथेर्बहुशश्चास्य संग्राममवगाहतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000464039, "chapter_id": 9464, "verse_number": "६-५७-३९", "content_sanskrit": "प्रतोदो न्यपतद्धस्तात् सूतस्य हयसादिनः।\nनिर्याणश्रीश्च या च स्याद् भास्वरा च सुदुर्लभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000464040, "chapter_id": 9464, "verse_number": "६-५७-४०", "content_sanskrit": "सा ननाश मुहूर्तेन समे च स्खलिता हयाः।\nप्रहस्तं तं हि निर्यान्तं प्रख्यातगुणपौरुषम्।\nयुधि नानाप्रहरणा कपिसेनाभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000464041, "chapter_id": 9464, "verse_number": "६-५७-४१", "content_sanskrit": "अथ घोषः सुतुमुलो हरीणां समजायत।\nवृक्षानारुजतां चैव गुर्वीर्वै गृह्णतां शिलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000464042, "chapter_id": 9464, "verse_number": "६-५७-४२", "content_sanskrit": "नदतां राक्षसानां च वानराणां च गर्जताम्।\nउभे प्रमुदिते सैन्ये रक्षोगणवनौकसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000464043, "chapter_id": 9464, "verse_number": "६-५७-४३", "content_sanskrit": "वेगितानां समर्थानामन्योन्यवधकाङ्क्षिणाम्।\nपरस्परं चाह्वयतां निनादः श्रूयते महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000464044, "chapter_id": 9464, "verse_number": "६-५७-४४", "content_sanskrit": "ततः प्रहस्तः कपिराजवाहिनी-\nमभिप्रतस्थे विजयाय दुर्मतिः।\nविवृद्धवेगां च विवेश तां चमूं\nयथा मुमूर्षुः शलभो विभावसुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000464045, "chapter_id": 9464, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे सप्तपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]