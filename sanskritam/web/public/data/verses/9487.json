[{"id": 5000487000, "chapter_id": 9487, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे त्रिसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000487001, "chapter_id": 9487, "verse_number": "६-८०-१", "content_sanskrit": "मकराक्षं हतं श्रुत्वा रावणः समितिंजयः।\nरोषेण महताविष्टो दन्तान् कटकटाय्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000487002, "chapter_id": 9487, "verse_number": "६-८०-२", "content_sanskrit": "कुपितश्च तदा तत्र किं कार्यमिति चिन्तयन्।\nआदिदेशाथ संक्रुद्धो रणायेन्द्रजितं सुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000487003, "chapter_id": 9487, "verse_number": "६-८०-३", "content_sanskrit": "जहि वीर महावीर्यौ भ्रातरौ रामलक्ष्मणौ।\nअदृश्यो दृश्यमानो वा सर्वथा त्वं बलाधिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000487004, "chapter_id": 9487, "verse_number": "६-८०-४", "content_sanskrit": "त्वमप्रतिमकर्माणमिन्द्रं जयसि संयुगे।\nकिं पुनर्मानुषौ दृष्ट्वा न वधिष्यसि संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000487005, "chapter_id": 9487, "verse_number": "६-८०-५", "content_sanskrit": "तथोक्तो राक्षसेन्द्रेण प्रतिगृह्य पितुर्वचः।\nयज्ञभूमौ स विधिवत् पावकं जुहुवेन्द्रजित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000487006, "chapter_id": 9487, "verse_number": "६-८०-६", "content_sanskrit": "जुह्वतश्चापि तत्राग्निं रक्तोष्णीषधराः स्त्रियः।\nआजग्मुस्तत्र सम्भ्रान्ता राक्षस्यो यत्र रावणिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000487007, "chapter_id": 9487, "verse_number": "६-८०-७", "content_sanskrit": "शस्त्राणि शरपत्राणि समिधोऽथ बिभीतकाः।\nलोहितानि च वासांसि स्रुवं कार्ष्णायसं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000487008, "chapter_id": 9487, "verse_number": "६-८०-८", "content_sanskrit": "सर्वतोऽग्निं समास्तीर्य शरपत्रैः सतोमरैः।\nछागस्य सर्वकृष्णस्य गलं जग्राह जीवतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000487009, "chapter_id": 9487, "verse_number": "६-८०-९", "content_sanskrit": "सकृद्धोमसमिद्धस्य विधूमस्य महार्चिषः।\nबभूवुस्तानि लिङ्गानि विजयं दर्शयन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000487010, "chapter_id": 9487, "verse_number": "६-८०-१०", "content_sanskrit": "प्रदक्षिणावर्तशिखस्तप्तहाटकसंनिभः।\nहविस्तत् प्रतिजग्राह पावकः स्वयमुत्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000487011, "chapter_id": 9487, "verse_number": "६-८०-११", "content_sanskrit": "हुत्वाग्निं तर्पयित्वाथ देवदानवराक्षसान्।\nआरुरोह रथश्रेष्ठमन्तर्धानगतं शुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000487012, "chapter_id": 9487, "verse_number": "६-८०-१२", "content_sanskrit": "स वाजिभिश्चतुर्भिस्तु बाणैस्तु निशितैर्युतः।\nआरोपितमहाचापः शुशुभे स्यन्दनोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000487013, "chapter_id": 9487, "verse_number": "६-८०-१३", "content_sanskrit": "जाज्वल्यमानो वपुषा तपनीयपरिच्छदः।\nमृगैश्चन्द्रार्धचन्द्रैश्च स रथः समलंकृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000487014, "chapter_id": 9487, "verse_number": "६-८०-१४", "content_sanskrit": "जाम्बूनदमहाकम्बुर्दीप्तपावकसंनिभः।\nबभूवेन्द्रजितः केतुर्वैदूर्यसमलंकृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000487015, "chapter_id": 9487, "verse_number": "६-८०-१५", "content_sanskrit": "तेन चादित्यकल्पेन ब्रह्मास्त्रेण च पालितः।\nस बभूव दुराधर्षो रावणिः सुमहाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000487016, "chapter_id": 9487, "verse_number": "६-८०-१६", "content_sanskrit": "सोऽभिनिर्याय नगरादिन्द्रजित् समितिंजयः।\nहुत्वाग्निं राक्षसैर्मन्त्रैरन्तर्धानगतोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000487017, "chapter_id": 9487, "verse_number": "६-८०-१७", "content_sanskrit": "अद्य हत्वा रणे यौ तौ मिथ्या प्रव्रजितौ वने।\nजयं पित्रे प्रदास्यामि रावणाय रणेऽधिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000487018, "chapter_id": 9487, "verse_number": "६-८०-१८", "content_sanskrit": "अद्य निर्वानरामुर्वीं हत्वा रामं च लक्ष्मणम्।\nकरिष्ये परमां प्रीतिमित्युक्त्वान्तरधीयत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000487019, "chapter_id": 9487, "verse_number": "६-८०-१९", "content_sanskrit": "आपपाताथ संक्रुद्धो दशग्रीवेण चोदितः।\nतीक्ष्णकार्मुकनाराचैस्तीक्ष्णस्त्विन्द्ररिपू रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000487020, "chapter_id": 9487, "verse_number": "६-८०-२०", "content_sanskrit": "स ददर्श महावीर्यौ नागौ त्रिशिरसाविव।\nसृजन्ताविषुजालानि वीरौ वानरमध्यगौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000487021, "chapter_id": 9487, "verse_number": "६-८०-२१", "content_sanskrit": "इमौ ताविति संचिन्त्य सज्यं कृत्वा च कार्मुकम्।\nसंततानेषुधाराभिः पर्जन्य इव वृष्टिमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000487022, "chapter_id": 9487, "verse_number": "६-८०-२२", "content_sanskrit": "स तु वैहायसरथो युधि तौ रामलक्ष्मणौ।\nअचक्षुर्विषये तिष्ठन् विव्याध निशितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000487023, "chapter_id": 9487, "verse_number": "६-८०-२३", "content_sanskrit": "तौ तस्य शरवेगेन परीतौ रामलक्ष्मणौ।\nधनुषी सशरे कृत्वा दिव्यमस्त्रं प्रचक्रतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000487024, "chapter_id": 9487, "verse_number": "६-८०-२४", "content_sanskrit": "प्रच्छादयन्तौ गगनं शरजालैर्महाबलौ।\nतमस्त्रैः सूर्यसंकाशैर्नैव पस्पर्शतुः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000487025, "chapter_id": 9487, "verse_number": "६-८०-२५", "content_sanskrit": "स हि धूमान्धकारं च चक्रे प्रच्छादयन्नभः।\nदिशश्चान्तर्दधे श्रीमान् नीहारतमसा वृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000487026, "chapter_id": 9487, "verse_number": "६-८०-२६", "content_sanskrit": "नैव ज्यातलनिर्घोषो न च नेमिखुरस्वनः।\nशुश्रुवे चरतस्तस्य न च रूपं प्रकाशते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000487027, "chapter_id": 9487, "verse_number": "६-८०-२७", "content_sanskrit": "घनान्धकारे तिमिरे शिलावर्षमिवाद्भुतम्।\nस ववर्ष महाबाहुर्नाराचशरवृष्टिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000487028, "chapter_id": 9487, "verse_number": "६-८०-२८", "content_sanskrit": "स रामं सूर्यसंकाशैः शरैर्दत्तवरैर्भृशम्।\nविव्याध समरे क्रुद्धः सर्वगात्रेषु रावणिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000487029, "chapter_id": 9487, "verse_number": "६-८०-२९", "content_sanskrit": "तौ हन्यमानौ नाराचैर्धाराभिरिव पर्वतौ।\nहेमपुङ्खान् नरव्याघ्रौ तिग्मान् मुमुचतुः शरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000487030, "chapter_id": 9487, "verse_number": "६-८०-३०", "content_sanskrit": "अन्तरिक्षे समासाद्य रावणिं कङ्कपत्रिणः।\nनिकृत्य पतगा भूमौ पेतुस्ते शोणिताप्लुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000487031, "chapter_id": 9487, "verse_number": "६-८०-३१", "content_sanskrit": "अतिमात्रं शरौघेण दीप्यमानौ नरोत्तमौ।\nतानिषून् पततो भल्लैरनेकैर्विचकर्ततुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000487032, "chapter_id": 9487, "verse_number": "६-८०-३२", "content_sanskrit": "यतो हि ददृशाते तौ शरान् निपतिताञ्छितान्।\nततस्तु तौ दाशरथी ससृजातेऽस्त्रमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000487033, "chapter_id": 9487, "verse_number": "६-८०-३३", "content_sanskrit": "रावणिस्तु दिशः सर्वा रथेनातिरथोऽपतत्।\nविव्याध तौ दाशरथी लघ्वस्त्रो निशितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000487034, "chapter_id": 9487, "verse_number": "६-८०-३४", "content_sanskrit": "तेनातिविद्धौ तौ वीरौ रुक्मपुङ्खैः सुसंहतैः।\nबभूवतुर्दाशरथी पुष्पिताविव किंशुकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000487035, "chapter_id": 9487, "verse_number": "६-८०-३५", "content_sanskrit": "नास्य वेगगतिं कश्चिन्न च रूपं धनुः शरान्।\nन चास्य विदितं किंचित् सूर्यस्येवाभ्रसम्प्लवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000487036, "chapter_id": 9487, "verse_number": "६-८०-३६", "content_sanskrit": "तेन विद्धाश्च हरयो निहताश्च गतासवः।\nबभूवुः शतशस्तत्र पतिता धरणीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000487037, "chapter_id": 9487, "verse_number": "६-८०-३७", "content_sanskrit": "लक्ष्मणस्तु ततः क्रुद्धो भ्रातरं वाक्यमब्रवीत्।\nब्राह्ममस्त्रं प्रयोक्ष्यामि वधार्थं सर्वरक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000487038, "chapter_id": 9487, "verse_number": "६-८०-३८", "content_sanskrit": "तमुवाच ततो रामो लक्ष्मणं शुभलक्षणम्।\nनैकस्य हेतो रक्षांसि पृथिव्यां हन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000487039, "chapter_id": 9487, "verse_number": "६-८०-३९", "content_sanskrit": "अयुध्यमानं प्रच्छन्नं प्राञ्जलिं शरणागतम्।\nपलायमानं मत्तं वा न हन्तुं त्वमिहार्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000487040, "chapter_id": 9487, "verse_number": "६-८०-४०", "content_sanskrit": "तस्यैव तु वधे यत्नं करिष्यामि महाभुज।\nआदेक्ष्यावो महावेगानस्त्रानाशीविषोपमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000487041, "chapter_id": 9487, "verse_number": "६-८०-४१", "content_sanskrit": "तमेनं मायिनं क्षुद्रमन्तर्हितरथं बलात्।\nराक्षसं निहनिष्यन्ति दृष्ट्वा वानरयूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000487042, "chapter_id": 9487, "verse_number": "६-८०-४२", "content_sanskrit": "यद्येष भूमिं विशते दिवं वा\nरसातलं वापि नभस्तलं वा।\nएवं विगूढोऽपि ममास्त्रदग्धः\nपतिष्यते भूमितले गतासुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000487043, "chapter_id": 9487, "verse_number": "६-८०-४३", "content_sanskrit": "इत्येवमुक्त्वा वचनं महार्थं\nरघुप्रवीरः प्लवगर्षभैर्वृतः।\nवधाय रौद्रस्य नृशंसकर्मण-\nस्तदा महात्मा त्वरितं निरीक्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000487044, "chapter_id": 9487, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे अशीतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]