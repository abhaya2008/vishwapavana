[{"id": 2098389, "chapter_id": 3105, "verse_number": "१३-२३५-१", "content_sanskrit": "उमोवाच।\nभगवन्कानि देयानि धर्ममुद्दिश्य मानवैः।\nतान्यहं श्रोतुमिच्छामि तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2098390, "chapter_id": 3105, "verse_number": "१३-२३५-२x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2098391, "chapter_id": 3105, "verse_number": "१३-२३५-२", "content_sanskrit": "अजस्रं धर्मकार्यं च तथा नैमित्तिकं प्रिये।\nअन्नं प्रतिश्रयो दीपः पानीयं तृणमिन्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2098392, "chapter_id": 3105, "verse_number": "१३-२३५-३", "content_sanskrit": "स्नेहो गन्धश्च भैषज्यं तिलाश्च लवणं तथा।\nएवमादि तथाऽन्यश्च दानमाजस्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2098393, "chapter_id": 3105, "verse_number": "१३-२३५-४", "content_sanskrit": "अजस्रदानात्सततमाजस्रमिति निश्चितम्।\nसामान्यं सर्ववर्णानां दानं शृणु समाहिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2098394, "chapter_id": 3105, "verse_number": "१३-२३५-५", "content_sanskrit": "अन्नं प्राणो मनुष्याणामन्नदः प्राणदो भवेत्।\nतस्माकदन्नं विशेषेण दातुमिच्छति मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2098395, "chapter_id": 3105, "verse_number": "१३-२३५-६", "content_sanskrit": "ब्राह्मणायाभिरूपाय यो दद्यादन्नमीप्सितम्।\nनिदधाति निधिं श्रेष्ठं सोऽनन्तं पारलौकिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2098396, "chapter_id": 3105, "verse_number": "१३-२३५-७", "content_sanskrit": "श्रान्तमध्वपरिश्रान्तमतिथिं गृहमागतम्।\nअर्चयीत प्रयत्नेन स हि यज्ञो वरप्रदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2098397, "chapter_id": 3105, "verse_number": "१३-२३५-८", "content_sanskrit": "कृत्वा तु पातकं कर्म यो दद्यादन्नमर्थिनाम्।\nब्राह्मणानां विशेषेण सोपहन्ति स्वकं तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2098398, "chapter_id": 3105, "verse_number": "१३-२३५-९", "content_sanskrit": "पितरस्तस्य नन्दन्ति सुवृष्ट्या कर्षका इव।\nपुत्रो यस्य तु पौत्रो वा श्रोत्रियं भोजयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2098399, "chapter_id": 3105, "verse_number": "१३-२३५-१०", "content_sanskrit": "अपि चण्डालशूद्राणामन्नदानं न गर्हते।\nतस्मात्सर्वप्रयत्नेन दद्यादन्नममत्सरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2098400, "chapter_id": 3105, "verse_number": "१३-२३५-११", "content_sanskrit": "कलत्रं पीडयित्वाऽपि पोषयेदतिथीन्सदा।\nजन्मापि मानुषे लोके तदर्थं हि विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2098401, "chapter_id": 3105, "verse_number": "१३-२३५-१२", "content_sanskrit": "अन्नदानाच्च लोकांस्तान्सम्प्रवक्ष्याम्यनिन्दिते।\nभवनानि प्रकाशन्ते दिवि तेषां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2098402, "chapter_id": 3105, "verse_number": "१३-२३५-१३", "content_sanskrit": "अनेकशतभौमानि सान्तर्जलवनानि च।\nवैडूर्यार्चिःप्रकाशपनि हेमरूप्यमयानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2098403, "chapter_id": 3105, "verse_number": "१३-२३५-१४", "content_sanskrit": "नानारूपाणि संस्थानां नानारत्नमयानि च।\nचन्द्रमण्डलशुभ्राणि किङ्किणीजालवन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2098404, "chapter_id": 3105, "verse_number": "१३-२३५-१५", "content_sanskrit": "तरुणादित्यवर्णानि स्थावराणि चराणि च।\nयथेष्टभक्ष्यभोज्यानि शयनासनवन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2098405, "chapter_id": 3105, "verse_number": "१३-२३५-१६", "content_sanskrit": "सर्वकामफलाश्चात्र वृक्षा भवनसंस्थिताः।\nवाप्यो बह्व्यश्च कूपाश्च दीर्घिकाश्च सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2098406, "chapter_id": 3105, "verse_number": "१३-२३५-१७", "content_sanskrit": "अरुजानि विशोकानि नित्यानि विविधानि च।\nभवनानि विचित्राणि प्राणदानां त्रिविष्टपे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2098407, "chapter_id": 3105, "verse_number": "१३-२३५-१८", "content_sanskrit": "विवस्वतश्च सोमस्य ब्रह्मणश्च प्रजापतेः।\nविशन्ति लोकांस्ते नित्यं जगत्यन्नोदकप्रदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2098408, "chapter_id": 3105, "verse_number": "१३-२३५-१९", "content_sanskrit": "तत्र ते सुचिरं कालं विहृत्याप्सरसां गणैः।\nजायन्ते मानुषे लोके सर्वकल्याणसंयुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2098409, "chapter_id": 3105, "verse_number": "१३-२३५-२०", "content_sanskrit": "बलसंहननोपेता नीरोगाश्चिरजीविनः।\nकुलीना मतिमन्तश्च भवन्त्यन्नप्रदा नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2098410, "chapter_id": 3105, "verse_number": "१३-२३५-२१", "content_sanskrit": "तस्मादन्नं विशेषेण दातव्यं भूतिमिच्छता।\nसर्वकालं च सर्वस्य सर्वत्र च सदैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2098411, "chapter_id": 3105, "verse_number": "१३-२३५-२२", "content_sanskrit": "सुवर्णदानं परमं स्वर्ग्यं स्वस्त्ययनं महत्।\nतस्मात्ते वर्णयिष्यामि यथावदनुपूर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2098412, "chapter_id": 3105, "verse_number": "१३-२३५-२३", "content_sanskrit": "अपि पापकृतं क्रूरं दत्तं रुक्मं प्रकाशयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2098413, "chapter_id": 3105, "verse_number": "१३-२३५-२४", "content_sanskrit": "सुवर्णं ये प्रयच्छन्ति श्रोत्रिभेभ्यः सुचेतसः।\nदेवतास्ते तर्पयन्ति समस्ता इति वैदिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2098414, "chapter_id": 3105, "verse_number": "१३-२३५-२५", "content_sanskrit": "अग्निर्हि देवताः सर्वाः सुवर्णं चाग्निरुच्यते।\nतस्मात्सुवर्णदानेन तृप्ताः स्युः सर्वदेवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2098415, "chapter_id": 3105, "verse_number": "१३-२३५-२६", "content_sanskrit": "अग्न्यभावे तु कुर्वन्ति वह्निस्थानेषु काञ्चनम्।\nतस्मात्सुवर्णदातारः सर्वान्कामानवाप्नुयुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2098416, "chapter_id": 3105, "verse_number": "१३-२३५-२७", "content_sanskrit": "आदित्यस्य हुताशस्य लोकान्नानाविधाञ्शुभान्।\nकाञ्चनं सम्प्रदायाशु प्रविशन्ति न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2098417, "chapter_id": 3105, "verse_number": "१३-२३५-२८", "content_sanskrit": "अलङ्कारं कृतं चापि केवलान्प्रविशिष्यते।\nसौवर्णैर्ब्राह्मणं काले तैरलङ्कृत्य भोजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2098418, "chapter_id": 3105, "verse_number": "१३-२३५-२९", "content_sanskrit": "य एतत्परमं दानं दत्त्वा सौवर्णमद्भुतम्।\nद्युतिं मेधां वपुः कीर्तिं पुनर्जाते लबेद्ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2098419, "chapter_id": 3105, "verse_number": "१३-२३५-३०", "content_sanskrit": "तस्मात्स्वशक्त्या दातव्यं काञ्चनं भुवि मानवैः।\nन ह्येतस्मात्परं लोकेष्वन्यत्पापात्प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2098420, "chapter_id": 3105, "verse_number": "१३-२३५-३१", "content_sanskrit": "अत ऊर्ध्वं प्रवक्ष्यामि गवां दानमनिन्दिते।\nनहि गोभ्यः परं दानं विद्यते जगति प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2098421, "chapter_id": 3105, "verse_number": "१३-२३५-३२", "content_sanskrit": "लोकान्सिसृक्षुणा पूर्वं गावः सृष्टाः स्वयंभुवा।\nवृत्त्यर्थं सर्वभूतानां तस्मात्ता मातरः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2098422, "chapter_id": 3105, "verse_number": "१३-२३५-३३", "content_sanskrit": "लोकज्येष्ठा लोकवृत्त्या प्रवृत्ता\nमय्यायत्ताः सोमनिष्यन्दभूताः।\nसौम्याः पुण्याः प्राणदाः कामदाश्च\nतस्मात्पूज्याः पुण्यकामैर्मनुष्यैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2098423, "chapter_id": 3105, "verse_number": "१३-२३५-३४", "content_sanskrit": "धेनुं दत्त्वा निभृतां सुशीलां\nकल्याणवत्सां च पयस्विनीं च।\nयावन्ति रोमाणि भवन्ति तस्या-\nस्तावत्समाः स्वर्गफलानि भुङ्क्ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2098424, "chapter_id": 3105, "verse_number": "१३-२३५-३५", "content_sanskrit": "प्रयच्छते यः कपिलां सचेलां\nसकांस्यदोहां कनकाग्र्यशृङ्गीम्।\nपुत्राश्च पौत्रांश्च कुलं च सर्व-\nमासप्तमं तारयते परत्र च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2098425, "chapter_id": 3105, "verse_number": "१३-२३५-३६", "content_sanskrit": "अन्तर्जाताः क्रीतका द्यूतलब्धाः।\nप्राणक्रीताः सोदकाश्चौजसा वा।\nकृच्छ्रोत्सृष्टाः पोषणार्थागताश्च\nद्वारैरेतैस्ताः प्रलब्धाः प्रदद्यात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2098426, "chapter_id": 3105, "verse_number": "१३-२३५-३७", "content_sanskrit": "कृसाय बहुपुत्राय श्रोत्रियायाहिताग्नये।\nप्रदाय नीरुजां धेनुं लोकान्प्राप्नोत्यनुत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2098427, "chapter_id": 3105, "verse_number": "१३-२३५-३८", "content_sanskrit": "नृशंसस्य कृतघ्नस्य लुब्धस्यानृतवादिनः।\nहव्यकव्यव्यपेतस्य न दद्याद्गाः कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2098428, "chapter_id": 3105, "verse_number": "१३-२३५-३९", "content_sanskrit": "समानवत्सां यो दद्याद्धेर्नुं विप्रे पयस्विनीम्।\nसुवृत्तां वस्त्रसंछन्नां सोमलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2098429, "chapter_id": 3105, "verse_number": "१३-२३५-४०", "content_sanskrit": "समानवत्सां यो दद्यात्कृष्णां धेनुं पयस्विनीम्।\nसुवृत्तां वस्त्रसंछन्नां लोकान्प्राप्नोत्यपांपतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2098430, "chapter_id": 3105, "verse_number": "१३-२३५-४१", "content_sanskrit": "हिरण्यवर्णां पिङ्गाक्षीं सवत्सां कांस्यदोहनाम्।\nप्रदाय वस्त्रसम्पन्नां यान्ति कौकबेरसद्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2098431, "chapter_id": 3105, "verse_number": "१३-२३५-४२", "content_sanskrit": "वायुरेणुसवर्मां च सवत्सां कांस्यदोहनाम्।\nप्रदाय वस्त्रसम्पन्नां वायुलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2098432, "chapter_id": 3105, "verse_number": "१३-२३५-४३", "content_sanskrit": "समानवत्सां यो धेनुं दत्त्वा गौरीं पयस्विनीम्।\nसुवृत्तां वस्त्रसंछन्नामग्निलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2098433, "chapter_id": 3105, "verse_number": "१३-२३५-४४", "content_sanskrit": "युवानं बलिनं श्यामं शतेन सह यूथपम्।\nगवेन्द्रं ब्राह्मणेन्द्राय भूरिशृङ्गमलंकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2098434, "chapter_id": 3105, "verse_number": "१३-२३५-४५", "content_sanskrit": "ऋषभं ये प्रयच्छन्ति श्रोत्रियाणां महात्मनाम्।\nऐश्वर्यमभिजायन्ते जायमानाः पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2098435, "chapter_id": 3105, "verse_number": "१३-२३५-४६", "content_sanskrit": "गवां मूत्रपुरीषाणि नोद्विजेन कदाचन।\nन चासां मांसमश्नीयाद्गोषु भक्तः सदा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2098436, "chapter_id": 3105, "verse_number": "१३-२३५-४७", "content_sanskrit": "ग्रासमुष्टिं परगवे दद्यात्संवत्सरं शुचि।\nअकृत्वा स्वयमाहारं व्रतं तत्सार्वकामिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2098437, "chapter_id": 3105, "verse_number": "१३-२३५-४८", "content_sanskrit": "गवामुभयतः काले नित्यं स्वस्त्ययनं वदेत्।\nन चासां चिन्तयेत्पापमिति धर्मविदो विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2098438, "chapter_id": 3105, "verse_number": "१३-२३५-४९", "content_sanskrit": "गावः पवित्रं परमं गोषु लोकाः प्रतिष्ठिताः।\nकथञ्चिन्नावमन्तव्या गावो लोकस्य मातरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2098439, "chapter_id": 3105, "verse_number": "१३-२३५-५०", "content_sanskrit": "तस्मादेव गवां दानं विशिष्टमिति कथ्यते।\nगोषु पूजा च भक्तिश्च नरस्यायुष्यतां वहेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2098440, "chapter_id": 3105, "verse_number": "१३-२३५-५१", "content_sanskrit": "अतःपरं प्रवक्ष्यामि भूमिदानं महाफलम्।\nभूमिदानसमं दानं लोके नास्तीति निश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2098441, "chapter_id": 3105, "verse_number": "१३-२३५-५२", "content_sanskrit": "गृहयुक्क्षेत्रयुग्वाऽपि भूमिभागः प्रदीयते।\nसुखभोगं निराक्रोशं वास्तुपूर्वं प्रकल्प्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2098442, "chapter_id": 3105, "verse_number": "१३-२३५-५३", "content_sanskrit": "ग्रहीतारमलङ्कृत्य वस्त्रपुष्पानुलोपनैः।\nसभृत्यं सपरीवारं भोजयित्वा यथेष्टतः।\nयो दद्याद्दक्षिणां काले त्रिरद्भिर्गृह्यतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2098443, "chapter_id": 3105, "verse_number": "१३-२३५-५४", "content_sanskrit": "एवं भूम्यां प्रदत्तायां श्रद्धया वीतमत्सरैः।\nयावत्तिष्ठति सा भूमिस्तावद्दत्तफलं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2098444, "chapter_id": 3105, "verse_number": "१३-२३५-५५", "content_sanskrit": "भूमिदः स्वर्गमारुह्य रमते शाश्वतीः समाः।\nअचला ह्यक्षया भूमिः सर्वकामान्दुधुक्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2098445, "chapter_id": 3105, "verse_number": "१३-२३५-५६", "content_sanskrit": "यत्किञ्चित्कुरुते पापं पुरुषो वृत्तिकर्शितः।\nअपि गोकर्णमात्रेण भूमिदानन मुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2098446, "chapter_id": 3105, "verse_number": "१३-२३५-५७", "content_sanskrit": "सुवर्णं रजतं वस्त्रं मणिमुक्तावसूनि च।\nसर्वमेतन्महाभागे भूमिदाने प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2098447, "chapter_id": 3105, "verse_number": "१३-२३५-५८", "content_sanskrit": "भर्तुर्निः श्रेयसे युक्तास्त्यक्तात्मानो रणे हताः।\nब्रह्मलोकाय संसिद्धा नातिक्रामन्ति भूमिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2098448, "chapter_id": 3105, "verse_number": "१३-२३५-५९", "content_sanskrit": "हलकृष्टां महीं दद्यात्सर्वबीजफलान्विताम्।\nसुकूपशरणां वाऽपि सा भवेत्सर्वकामदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2098449, "chapter_id": 3105, "verse_number": "१३-२३५-६०", "content_sanskrit": "निष्पन्नसस्यां पृथिवीं यो ददाति द्विजन्मनाम्।\nविमुक्तः कलुषैः सर्वैः शकलोकं स गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2098450, "chapter_id": 3105, "verse_number": "१३-२३५-६१", "content_sanskrit": "यथा जनित्री क्षीरेणि स्वपुत्रमभिवर्धयेत्।\nएवं सर्वफलैर्भूमिर्दातारमभिवर्धयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2098451, "chapter_id": 3105, "verse_number": "१३-२३५-६२", "content_sanskrit": "ब्राह्मणं वृत्तसम्पन्नमाहिताग्निं शुचिव्रतम्।\nग्राहयित्वा निजां भूमिं न यान्ति यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2098452, "chapter_id": 3105, "verse_number": "१३-२३५-६३", "content_sanskrit": "यथा चन्द्रमसो वृद्धिरहन्यहनि दृश्यते।\nतथा भूमेः कृतं दानं सस्येसस्ये विवर्धते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2098453, "chapter_id": 3105, "verse_number": "१३-२३५-६४", "content_sanskrit": "यथा बीजानि रोहन्ति प्रकीर्णानि महीतले।\nतथा कामाः प्ररोहन्ति भूमिदानगुणार्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2098454, "chapter_id": 3105, "verse_number": "१३-२३५-६५", "content_sanskrit": "पितरः पितृलोकस्था देवताश्च दिवि स्थिताः।\nसन्तर्पयन्ति भोगैस्तं यो ददाति वसुन्धराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2098455, "chapter_id": 3105, "verse_number": "१३-२३५-६६", "content_sanskrit": "दीर्घायुष्यं वराङ्गत्वं स्फीतां च श्रियमुत्तमाम्।\nपरत्र लभते मर्त्यः सम्प्रदाय वसुन्धराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2098456, "chapter_id": 3105, "verse_number": "१३-२३५-६७", "content_sanskrit": "एतत्सर्वं मयोद्दिष्टं भूमिदानस्य यत्फलम्।\nश्रद्दधानैर्नरैर्नित्यं श्राव्यमेतत्सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2098457, "chapter_id": 3105, "verse_number": "१३-२३५-६८", "content_sanskrit": "अतः परं प्रवक्ष्यामि कन्यादानं यथाविधि।\nकन्या देया महादेवि परेषामात्मनोपि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2098458, "chapter_id": 3105, "verse_number": "१३-२३५-६९", "content_sanskrit": "कन्यां शुद्धव्रताचारां कुलरूपसमन्विताम्।\nयस्मै दित्सति पात्राय तेनापि भृशकामिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2098459, "chapter_id": 3105, "verse_number": "१३-२३५-७०", "content_sanskrit": "प्रथमं तत्समाकल्प्य बन्धुभिः कृतनिश्चयः।\nकारयित्वा गृहं पूर्वं दासीदासपरिच्छदैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2098460, "chapter_id": 3105, "verse_number": "१३-२३५-७१", "content_sanskrit": "गृहोपकरणैश्चैव पशुधान्येन संयुताम्।\nतदर्थिने तदर्हाय कन्यां तां समलङ्कृताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2098461, "chapter_id": 3105, "verse_number": "१३-२३५-७२", "content_sanskrit": "सविवाहं यथान्यायं प्रचच्छेदग्निसाक्षिकम्।\nवृत्त्यातीं यथा कृत्वा सद्गृहे तौ निवेशयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2098462, "chapter_id": 3105, "verse_number": "१३-२३५-७३", "content_sanskrit": "एवं कृत्वा वधूदानं तस्य दानस्य गौरवात्।\nप्रेत्यभावे महीयेत स्वर्गलोके यथासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2098463, "chapter_id": 3105, "verse_number": "१३-२३५-७४", "content_sanskrit": "पुनर्जातस्य सौभाग्यं कुलवृद्धिं तथाऽऽप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2098464, "chapter_id": 3105, "verse_number": "१३-२३५-७५", "content_sanskrit": "विद्यादानं तथा देवि पात्रभूताय वै ददत्।\nप्रेत्यभावे लभेन्मर्त्यो मेधां वृद्धिं धृतिं स्मृतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2098465, "chapter_id": 3105, "verse_number": "१३-२३५-७६", "content_sanskrit": "अनुरूपाय शिष्याय यश्च विद्यां प्रयच्छति।\nयथोक्तस्य प्रदानस्य फलमानन्त्यमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2098466, "chapter_id": 3105, "verse_number": "१३-२३५-७७", "content_sanskrit": "दापनं त्वथ विद्यानां दरिद्रेभ्योऽर्थवेदनैः।\nस्वयं दत्तेन तुल्यं स्यादिति विद्धि शुभानने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2098467, "chapter_id": 3105, "verse_number": "१३-२३५-७८", "content_sanskrit": "एवं ते कथितान्येव महादानानि मानिनि।\nत्वत्प्रियार्थं मया देवि भूयः श्रोतुं किमिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2098468, "chapter_id": 3105, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि पञ्चत्रिंशदधिकद्विशततमोऽध्यायः॥ २३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]