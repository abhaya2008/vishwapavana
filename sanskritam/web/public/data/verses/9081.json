[{"id": 5000081000, "chapter_id": 9081, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे चतुर्थः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000081001, "chapter_id": 9081, "verse_number": "२-४-१", "content_sanskrit": "गतेष्वथ नृपो भूयः पौरेषु सह मन्त्रिभिः।\nमन्त्रयित्वा ततश्चक्रे निश्चयज्ञः स निश्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000081002, "chapter_id": 9081, "verse_number": "२-४-२", "content_sanskrit": "श्व एव पुष्यो भविता श्वोऽभिषेच्यस्तु मे सुतः।\nरामो राजीवपत्राक्षो युवराज इति प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000081003, "chapter_id": 9081, "verse_number": "२-४-३", "content_sanskrit": "अथान्तर्गृहमाविश्य राजा दशरथस्तदा।\nसूतमामन्त्रयामास रामं पुनरिहानय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000081004, "chapter_id": 9081, "verse_number": "२-४-४", "content_sanskrit": "प्रतिगृह्य तु तद्वाक्यं सूतः पुनरुपाययौ।\nरामस्य भवनं शीघ्रं राममानयितुं पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000081005, "chapter_id": 9081, "verse_number": "२-४-५", "content_sanskrit": "द्वाःस्थैरावेदितं तस्य रामायागमनं पुनः।\nश्रुत्वैव चापि रामस्तं प्राप्तं शङ्कान्वितोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000081006, "chapter_id": 9081, "verse_number": "२-४-६", "content_sanskrit": "प्रवेश्य चैनं त्वरितो रामो वचनमब्रवीत्।\nयदागमनकृत्यं ते भूयस्तद‍्ब्रूह्यशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000081007, "chapter_id": 9081, "verse_number": "२-४-७", "content_sanskrit": "तमुवाच ततः सूतो राजा त्वां द्रष्टुमिच्छति।\nश्रुत्वा प्रमाणं तत्र त्वं गमनायेतराय वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000081008, "chapter_id": 9081, "verse_number": "२-४-८", "content_sanskrit": "इति सूतवचः श्रुत्वा रामोऽपि त्वरयान्वितः।\nप्रययौ राजभवनं पुनर्द्रष्टुं नरेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000081009, "chapter_id": 9081, "verse_number": "२-४-९", "content_sanskrit": "तं श्रुत्वा समनुप्राप्तं रामं दशरथो नृपः।\nप्रवेशयामास गृहं विवक्षुः प्रियमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000081010, "chapter_id": 9081, "verse_number": "२-४-१०", "content_sanskrit": "प्रविशन्नेव च श्रीमान् राघवो भवनं पितुः।\nददर्श पितरं दूरात् प्रणिपत्य कृताञ्जलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000081011, "chapter_id": 9081, "verse_number": "२-४-११", "content_sanskrit": "प्रणमन्तं तमुत्थाप्य सम्परिष्वज्य भूमिपः।\nप्रदिश्य चासनं चास्मै रामं च पुनरब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000081012, "chapter_id": 9081, "verse_number": "२-४-१२", "content_sanskrit": "राम वृद्धोऽस्मि दीर्घायुर्भुक्ता भोगा यथेप्सिताः।\nअन्नवद्भिः क्रतुशतैर्यथेष्टं भूरिदक्षिणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000081013, "chapter_id": 9081, "verse_number": "२-४-१३", "content_sanskrit": "जातमिष्टमपत्यं मे त्वमद्यानुपमं भुवि।\nदत्तमिष्टमधीतं च मया पुरुषसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000081014, "chapter_id": 9081, "verse_number": "२-४-१४", "content_sanskrit": "अनुभूतानि चेष्टानि मया वीर सुखान्यपि।\nदेवर्षिपितृविप्राणामनृणोऽस्मि तथाऽऽत्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000081015, "chapter_id": 9081, "verse_number": "२-४-१५", "content_sanskrit": "न किंचिन्मम कर्तव्यं तवान्यत्राभिषेचनात्।\nअतो यत्त्वामहं ब्रूयां तन्मे त्वं कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000081016, "chapter_id": 9081, "verse_number": "२-४-१६", "content_sanskrit": "अद्य प्रकृतयः सर्वास्त्वामिच्छन्ति नराधिपम्।\nअतस्त्वां युवराजानमभिषेक्ष्यामि पुत्रक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000081017, "chapter_id": 9081, "verse_number": "२-४-१७", "content_sanskrit": "अपि चाद्याशुभान् राम स्वप्नान् पश्यामि राघव।\nसनिर्घाता दिवोल्काश्च पतन्ति हि महास्वनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000081018, "chapter_id": 9081, "verse_number": "२-४-१८", "content_sanskrit": "अवष्टब्धं च मे राम नक्षत्रं दारुणग्रहैः।\nआवेदयन्ति दैवज्ञाः सूर्याङ्गारकराहुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000081019, "chapter_id": 9081, "verse_number": "२-४-१९", "content_sanskrit": "प्रायेण च निमित्तानामीदृशानां समुद्भवे।\nराजा हि मृत्युमाप्नोति घोरां चापदमृच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000081020, "chapter_id": 9081, "verse_number": "२-४-२०", "content_sanskrit": "तद् यावदेव मे चेतो न विमुह्यति राघव।\nतावदेवाभिषिञ्चस्व चला हि प्राणिनां मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000081021, "chapter_id": 9081, "verse_number": "२-४-२१", "content_sanskrit": "अद्य चन्द्रोऽभ्युपगमत् पुष्यात् पूर्वं पुनर्वसुम्।\nश्वः पुष्ययोगं नियतं वक्ष्यन्ते दैवचिन्तकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000081022, "chapter_id": 9081, "verse_number": "२-४-२२", "content_sanskrit": "तत्र पुष्येऽभिषिञ्चस्व मनस्त्वरयतीव माम्।\nश्वस्त्वाहमभिषेक्ष्यामि यौवराज्ये परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000081023, "chapter_id": 9081, "verse_number": "२-४-२३", "content_sanskrit": "तस्मात् त्वयाद्यप्रभृति निशेयं नियतात्मना।\nसह वध्वोपवस्तव्या दर्भप्रस्तरशायिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000081024, "chapter_id": 9081, "verse_number": "२-४-२४", "content_sanskrit": "सुहृदश्चाप्रमत्तास्त्वां रक्षन्त्वद्य समन्ततः।\nभवन्ति बहुविघ्नानि कार्याण्येवंविधानि हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000081025, "chapter_id": 9081, "verse_number": "२-४-२५", "content_sanskrit": "विप्रोषितश्च भरतो यावदेव पुरादितः।\nतावदेवाभिषेकस्ते प्राप्तकालो मतो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000081026, "chapter_id": 9081, "verse_number": "२-४-२६", "content_sanskrit": "कामं खलु सतां वृत्ते भ्राता ते भरतः स्थितः।\nज्येष्ठानुवर्ती धर्मात्मा सानुक्रोशो जितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000081027, "chapter_id": 9081, "verse_number": "२-४-२७", "content_sanskrit": "किं नु चित्तं मनुष्याणामनित्यमिति मे मतम्।\nसतां च धर्मनित्यानां कृतशोभि च राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000081028, "chapter_id": 9081, "verse_number": "२-४-२८", "content_sanskrit": "इत्युक्तः सोऽभ्यनुज्ञातः श्वोभाविन्यभिषेचने।\nव्रजेति रामः पितरमभिवाद्याभ्ययाद् गृहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000081029, "chapter_id": 9081, "verse_number": "२-४-२९", "content_sanskrit": "प्रविश्य चात्मनो वेश्म राज्ञाऽऽदिष्टेऽभिषेचने।\nतत्क्षणादेव निष्क्रम्य मातुरन्तःपुरं ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000081030, "chapter_id": 9081, "verse_number": "२-४-३०", "content_sanskrit": "तत्र तां प्रवणामेव मातरं क्षौमवासिनीम्।\nवाग्यतां देवतागारे ददर्शायाचतीं श्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000081031, "chapter_id": 9081, "verse_number": "२-४-३१", "content_sanskrit": "प्रागेव चागता तत्र सुमित्रा लक्ष्मणस्तथा।\nसीता चानयिता श्रुत्वा प्रियं रामाभिषेचनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000081032, "chapter_id": 9081, "verse_number": "२-४-३२", "content_sanskrit": "तस्मिन् कालेऽपि कौसल्या तस्थावामीलितेक्षणा।\nसुमित्रयान्वास्यमाना सीतया लक्ष्मणेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000081033, "chapter_id": 9081, "verse_number": "२-४-३३", "content_sanskrit": "श्रुत्वा पुष्ये च पुत्रस्य यौवराज्येऽभिषेचनम्।\nप्राणायामेन पुरुषं ध्यायमाना जनार्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000081034, "chapter_id": 9081, "verse_number": "२-४-३४", "content_sanskrit": "तथा सनियमामेव सोऽभिगम्याभिवाद्य च।\nउवाच वचनं रामो हर्षयंस्तामिदं वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000081035, "chapter_id": 9081, "verse_number": "२-४-३५", "content_sanskrit": "अम्ब पित्रा नियुक्तोऽस्मि प्रजापालनकर्मणि।\nभविता श्वोऽभिषेको मे यथा मे शासनं पितुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000081036, "chapter_id": 9081, "verse_number": "२-४-३६", "content_sanskrit": "सीतयाप्युपवस्तव्या रजनीयं मया सह।\nएवमुक्तमुपाध्यायैः स हि मामुक्तवान् पिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000081037, "chapter_id": 9081, "verse_number": "२-४-३७", "content_sanskrit": "यानि यान्यत्र योग्यानि श्वोभाविन्यभिषेचने।\nतानि मे मङ्गलान्यद्य वैदेह्याश्चैव कारय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000081038, "chapter_id": 9081, "verse_number": "२-४-३८", "content_sanskrit": "एतच्छ्रुत्वा तु कौसल्या चिरकालाभिकांक्षितम्।\nहर्षबाष्पाकुलं वाक्यमिदं राममभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000081039, "chapter_id": 9081, "verse_number": "२-४-३९", "content_sanskrit": "वत्स राम चिरं जीव हतास्ते परिपन्थिनः।\nज्ञातीन् मे त्वं श्रिया युक्तः सुमित्रायाश्च नन्दय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000081040, "chapter_id": 9081, "verse_number": "२-४-४०", "content_sanskrit": "कल्याणे बत नक्षत्रे मया जातोऽसि पुत्रक।\nयेन त्वया दशरथो गुणैराराधितः पिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000081041, "chapter_id": 9081, "verse_number": "२-४-४१", "content_sanskrit": "अमोघं बत मे क्षान्तं पुरुषे पुष्करेक्षणे।\nयेयमिक्ष्वाकुराजश्रीः पुत्र त्वां संश्रयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000081042, "chapter_id": 9081, "verse_number": "२-४-४२", "content_sanskrit": "इत्येवमुक्तो मात्रा तु रामो भ्रातरमब्रवीत्।\nप्राञ्जलिं प्रह्वमासीनमभिवीक्ष्य स्मयन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000081043, "chapter_id": 9081, "verse_number": "२-४-४३", "content_sanskrit": "लक्ष्मणेमां मया सार्धं प्रशाधि त्वं वसुंधराम्।\nद्वितीयं मेऽन्तरात्मानं त्वामियं श्रीरुपस्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000081044, "chapter_id": 9081, "verse_number": "२-४-४४", "content_sanskrit": "सौमित्रे भुङ्क्ष्व भोगांस्त्वमिष्टान् राज्यफलानिच।\nजीवितं चापि राज्यं च त्वदर्थमभिकामये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000081045, "chapter_id": 9081, "verse_number": "२-४-४५", "content_sanskrit": "इत्युक्त्वा लक्ष्मणं रामो मातरावभिवाद्य च।\nअभ्यनुज्ञाप्य सीतां च ययौ स्वं च निवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000081046, "chapter_id": 9081, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे चतुर्थः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]