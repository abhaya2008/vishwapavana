[{"id": 2071158, "chapter_id": 2499, "verse_number": "१२-४-०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2071159, "chapter_id": 2499, "verse_number": "१२-४-१", "content_sanskrit": "कर्णस्तु समवाप्यैवमस्त्रं भार्गवनन्दनात्।\nदुर्योधनेन सहितो मुमुदे भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2071160, "chapter_id": 2499, "verse_number": "१२-४-२", "content_sanskrit": "ततः कदाचिदाजातः समाजग्मुः स्वयंवरे।\nकलिङ्गविषये राजन्राज्ञश्चित्राङ्गदस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2071161, "chapter_id": 2499, "verse_number": "१२-४-३", "content_sanskrit": "श्रीमद्राजपुरं नाम नगरं तत्र भारत।\nराजानः शतशस्तत्र कन्यार्थे समुपागमन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2071162, "chapter_id": 2499, "verse_number": "१२-४-४", "content_sanskrit": "श्रुत्वा दुर्योधनस्तत्र समेतान्सर्वपार्थिवान्।\nरथेन काञ्चनाङ्गेन कर्णेन सहितो ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2071163, "chapter_id": 2499, "verse_number": "१२-४-५", "content_sanskrit": "ततः स्वयंवरे तस्मिन्नानादेश्या महारथाः।\nसमाजग्मुर्नृपतयः कन्यार्थे नृपसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2071164, "chapter_id": 2499, "verse_number": "१२-४-६", "content_sanskrit": "शिशुपालो जरासन्धो भीष्मको वक्र एव च।\nकपोतरोमा नीलश्च रुक्मी च दृढविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2071165, "chapter_id": 2499, "verse_number": "१२-४-७", "content_sanskrit": "सृगालश्च महाराजः स्त्रीराज्याधिपतिश्च यः।\nविशोकः शतधन्वा च भोजो वीरश्च नामतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2071166, "chapter_id": 2499, "verse_number": "१२-४-८", "content_sanskrit": "एते चान्ये च बहवो दक्षिणां दिशमाश्रिताः।\nम्लेच्छाश्चार्याश्च राजानः प्राच्योदीच्यास्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2071167, "chapter_id": 2499, "verse_number": "१२-४-९", "content_sanskrit": "काञ्चनाङ्गदिनः सर्वे शुद्धजाम्बूनदप्रभाः।\nसर्वे भास्वरदेहाश्च व्याघ्रा इव बलोत्कटाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2071168, "chapter_id": 2499, "verse_number": "१२-४-१०", "content_sanskrit": "ततः समुपविष्टेषु तेषु राजसु भारत।\nविवेश रङ्गं सा कन्या धात्रीवर्षवरान्विता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2071169, "chapter_id": 2499, "verse_number": "१२-४-११", "content_sanskrit": "ततः संश्राव्यमाणेषु राज्ञां नामसु भारत।\nअत्यक्रामद्धार्तराष्ट्रं सा कन्या वरवर्णिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2071170, "chapter_id": 2499, "verse_number": "१२-४-१२", "content_sanskrit": "दुर्योधनस्तु कौरव्यो नामर्षयत लङ्घनम्।\nप्रत्यपेधच्च तां कन्यामसत्कृत्य नराधिपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2071171, "chapter_id": 2499, "verse_number": "१२-४-१३", "content_sanskrit": "स वीर्यमदमत्तत्वाद्भीष्मद्रोणावुपाश्रितः।\nरथमारोप्य तां कन्यामाजुहाव नराधिपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2071172, "chapter_id": 2499, "verse_number": "१२-४-१४", "content_sanskrit": "तमन्वगाद्रथी खङ्गी बद्धगोधाङ्गुलित्रवान्।\nकर्णः शस्त्रभृतां श्रेष्ठः पृष्ठतः पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2071173, "chapter_id": 2499, "verse_number": "१२-४-१५", "content_sanskrit": "ततो विमर्दः सुमहान्राज्ञामासीद्युयुत्सताम्।\nसन्नह्यतां तनुत्राणि रथान्योजयतामपि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2071174, "chapter_id": 2499, "verse_number": "१२-४-१६", "content_sanskrit": "तेऽभ्यधावन्त संक्रुद्धाः कर्णदुर्योधनावुभौ।\nशरवर्षाणि मुञ्चन्तो मेघाः पर्वतयोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2071175, "chapter_id": 2499, "verse_number": "१२-४-१७", "content_sanskrit": "कर्णस्तेषामापततामेकैकेन शरेण ह।\nधनूंषि च शरव्रातान्पातयामास भूतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2071176, "chapter_id": 2499, "verse_number": "१२-४-१८", "content_sanskrit": "ततो विधनुषः कांश्चित्कांश्चिदुद्यतकार्मुकान्।\nकांश्चिदुत्सृजतो बाणान्रथशक्तिगदास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2071177, "chapter_id": 2499, "verse_number": "१२-४-१९", "content_sanskrit": "लाघवाव्द्याकुलीकृत्य कर्णः प्रहरतां वरः।\nहतसूतांश्च भूयिष्ठान्स विजिग्ये नराधिपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2071178, "chapter_id": 2499, "verse_number": "१२-४-२०", "content_sanskrit": "ते स्वयं वाहयन्तोऽश्वान्याहि याहीति वादिनः।\nव्यपेयुस्ते रणं हित्वा राजानो भग्नमानसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2071179, "chapter_id": 2499, "verse_number": "१२-४-२१", "content_sanskrit": "दुर्योधनस्तु कर्णेन पाल्यमानोऽभ्ययात्तदा।\nहृष्टः कन्यामुपादाय नगरं नागसाह्वयम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2071180, "chapter_id": 2499, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि चतुर्थोऽध्यायः॥ ४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]