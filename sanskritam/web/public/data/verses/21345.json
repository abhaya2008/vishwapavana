[{"id": 7001345000, "chapter_id": 21345, "verse_number": "४-३५-१", "content_sanskrit": "सूत उवाच ।\nश्रूयतामृषयः श्रेष्ठाः कथयामि यथा श्रुतम् ।\nविष्णुना प्रार्थितो येन संतुष्टः परमेश्वरः ।\nतदाहं कथयाम्यद्य पुण्यं नाम सहस्रकम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001345001, "chapter_id": 21345, "verse_number": "४-३५-२", "content_sanskrit": "श्रीविष्णुरुवाच ।\nशिवो हरो मृडो रुद्रः पुष्करः पुष्पलोचनः ।\nअर्थिगम्यः सदाचारः शर्वः शंभुर्महेश्वरः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001345002, "chapter_id": 21345, "verse_number": "४-३५-३", "content_sanskrit": "चंद्रापीडश्चंद्रमौलिर्विश्वं विश्वंभरेश्वरः ।\nवेदांतसारसंदोहः कपाली नीललोहितः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001345003, "chapter_id": 21345, "verse_number": "४-३५-४", "content_sanskrit": "ध्यानाधारोऽपरिच्छेद्यो गौरीभर्त्ता गणेश्वरः ।\nअष्टमूर्तिर्विश्वमूर्तिस्त्रिवर्गस्वर्गसाधनः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001345004, "chapter_id": 21345, "verse_number": "४-३५-५", "content_sanskrit": "ज्ञानगम्यो दृढप्रज्ञो देवदेवस्त्रिलोचनः ।\nवामदेवो महादेवः पटुः परिवृढो दृढः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001345005, "chapter_id": 21345, "verse_number": "४-३५-६", "content_sanskrit": "विश्वरूपो विरूपाक्षो वागीशः शुचिसत्तमः ।\nसर्वप्रमाणसंवादी वृषाङ्को वृषवाहनः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001345006, "chapter_id": 21345, "verse_number": "४-३५-७", "content_sanskrit": "ईशः पिनाकी खट्वांगी चित्रवेषश्चिरंतनः ।\nतमोहरो महायोगी गोप्ता ब्रह्मा च धूर्जटिः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001345007, "chapter_id": 21345, "verse_number": "४-३५-८", "content_sanskrit": "कालकालः कृत्तिवासाः सुभगः प्रणवात्मकः ।\nउन्नध्रः पुरुषो जुष्यो दुर्वासाः पुरशासनः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001345008, "chapter_id": 21345, "verse_number": "४-३५-९", "content_sanskrit": "दिव्यायुधः स्कंदगुरुः परमेष्ठीः परात्परः ।\nअनादिमध्यनिधनो गिरीशो गिरिजाधवः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001345009, "chapter_id": 21345, "verse_number": "४-३५-१०", "content_sanskrit": "कुबेरबंधुः श्रीकंठो लोकवर्णोत्तमो मृदुः ।\nसमाधिवेद्यः कोदंडी नीलकंठः परस्वधीः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001345010, "chapter_id": 21345, "verse_number": "४-३५-११", "content_sanskrit": "विशालाक्षो मृगव्याधः सुरेशः सूर्यतापनः ।\nधर्मधाम क्षमाक्षेत्रं भगवान्भगनेत्रभित्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001345011, "chapter_id": 21345, "verse_number": "४-३५-१२", "content_sanskrit": "उग्रः पशुपतिस्तार्क्ष्यः प्रियभक्तः परंतपः ।\nदाता दयाकरो दक्षः कर्मंदीः कामशासनः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001345012, "chapter_id": 21345, "verse_number": "४-३५-१३", "content_sanskrit": "श्मशाननिलयः सूक्ष्मः श्मशानस्थो महेश्वरः ।\nलोककर्त्ता मृगपतिर्महाकर्त्ता महौषधिः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001345013, "chapter_id": 21345, "verse_number": "४-३५-१४", "content_sanskrit": "उत्तरो गोपतिर्गोप्ता ज्ञानगम्यः पुरातनः ।\nनीतिः सुनीतिः शुद्धात्मा सोमः सोमरतः सुखी॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001345014, "chapter_id": 21345, "verse_number": "४-३५-१५", "content_sanskrit": "सोमपोऽमृतपः सौम्यो महातेजा महाद्युतिः ।\nतेजोमयोऽमृतमयोऽन्नमयश्च सुधापतिः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001345015, "chapter_id": 21345, "verse_number": "४-३५-१६", "content_sanskrit": "अजातशत्रुरालोकः संभाव्यो हव्यवाहनः ।\nलोककरो वेदकरः सूत्रकारः सनातनः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001345016, "chapter_id": 21345, "verse_number": "४-३५-१७", "content_sanskrit": "महर्षिकपिलाचार्यो विश्वदीप्तिस्त्रिलोचनः ।\nपिनाकपाणिर्भूदेवः स्वस्तिदः स्वस्तिकृत्सुधीः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001345017, "chapter_id": 21345, "verse_number": "४-३५-१८", "content_sanskrit": "धातृधामा धामकरः सर्वगः सर्वगोचरः ।\nब्रह्मसृग्विश्वसृक्सर्गः कर्णिकारः प्रियः कविः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001345018, "chapter_id": 21345, "verse_number": "४-३५-१९", "content_sanskrit": "शाखो विशाखो गोशाखः शिवो भिषगनुत्तमः ।\nगंगाप्लवोदको भव्यः पुष्कलः स्थपतिः स्थिरः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001345019, "chapter_id": 21345, "verse_number": "४-३५-२०", "content_sanskrit": "विजितात्मा विधेयात्मा भूतवाहनसारथिः ।\nसगणो गणकायश्च सुकीर्तिच्छिन्नसंशयः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001345020, "chapter_id": 21345, "verse_number": "४-३५-२१", "content_sanskrit": "कामदेवः कामपालो भस्मोद्धूलितविग्रहः ।\nभस्मप्रियो भस्मशायी कामी कांतः कृतागमः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001345021, "chapter_id": 21345, "verse_number": "४-३५-२२", "content_sanskrit": "समावर्तोऽनिवृत्तात्मा धर्मपुंजः सदाशिवः ।\nअकल्मषश्च पुण्यात्मा चतुर्बाहुर्दुरासदः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001345022, "chapter_id": 21345, "verse_number": "४-३५-२३", "content_sanskrit": "दुर्लभो दुर्गमो दुर्गः सर्वायुधविशारदः ।\nअध्यात्मयोगनिलयः सुतंतुस्तंतुवर्धनः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001345023, "chapter_id": 21345, "verse_number": "४-३५-२४", "content_sanskrit": "शुभांगो लोकसारंगो जगदीशो जनार्दनः ।\nभस्मशुद्धिकरो मेरुरोजस्वी शुद्धविग्रहः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001345024, "chapter_id": 21345, "verse_number": "४-३५-२५", "content_sanskrit": "असाध्यः साधुसाध्यश्च भृत्यमर्कटरूपधृक् ।\nहिरण्यरेताः पौराणो रिपुजीवहरो बली॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001345025, "chapter_id": 21345, "verse_number": "४-३५-२६", "content_sanskrit": "महाह्रदो महागर्तस्सिद्धोवृंदारवंदितः ।\nव्याघ्रचर्मांबरो व्याली महाभूतो महानिधिः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001345026, "chapter_id": 21345, "verse_number": "४-३५-२७", "content_sanskrit": "अमृतोऽमृवपुः श्रीमान्पाञ्चजन्यः प्रभंजनः ।\nपंचविंशतितत्त्वस्थः पारिजातः परात्परः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001345027, "chapter_id": 21345, "verse_number": "४-३५-२८", "content_sanskrit": "सुलभस्सुव्रतश्शूरो वाङ्मयैकनिधिर्निधिः ।\nवर्णाश्रमगुरुर्वर्णी शत्रुजिच्छत्रुतापनः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001345028, "chapter_id": 21345, "verse_number": "४-३५-२९", "content_sanskrit": "आश्रमः क्षपणः क्षामो ज्ञानवानचलेश्वरः ।\nप्रमाणभूतो दुर्ज्ञेयः सुपर्णो वायुवाहनः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001345029, "chapter_id": 21345, "verse_number": "४-३५-३०", "content_sanskrit": "धनुर्धरो धनुर्वेदो गुणः शशिगुणाकरः ।\nसत्यस्सत्यपरोऽदीनो धर्मो गोधर्मशासनः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001345030, "chapter_id": 21345, "verse_number": "४-३५-३१", "content_sanskrit": "अनंतदृष्टिरानंदो दंडो दमयिता दमः ।\nअभिचार्य्यो महामायो विश्वकर्म विशारदः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001345031, "chapter_id": 21345, "verse_number": "४-३५-३२", "content_sanskrit": "वीतरागो विनीतात्मा तपस्वीभूतभावनः ।\nउन्मत्तवेषः प्रच्छन्नो जितकामोऽजितप्रियः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001345032, "chapter_id": 21345, "verse_number": "४-३५-३३", "content_sanskrit": "कल्याणप्रकृतिः कल्पः सर्वलोकप्रजापतिः ।\nतरस्वी तारको धीमान्प्रधानः प्रभुरव्ययः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001345033, "chapter_id": 21345, "verse_number": "४-३५-३४", "content_sanskrit": "लोकपालोंऽतर्हितात्मा कल्पादिः कमलेक्षणः ।\nवेदशास्त्रार्थतत्त्वज्ञोऽनियमो नियताश्रयः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001345034, "chapter_id": 21345, "verse_number": "४-३५-३५", "content_sanskrit": "चंद्रः सूर्यः शनिः केतुर्वरांगो विद्रुमच्छविः ।\nभक्तिवश्यः परं ब्रह्म मृगबाणापर्णोऽनघः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001345035, "chapter_id": 21345, "verse_number": "४-३५-३६", "content_sanskrit": "अद्रिरद्र्यालयः कांतः परमात्मा जगद्गुरुः ।\nसर्वकर्मालयस्तुष्टो मंगल्यो मंगलावृतः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001345036, "chapter_id": 21345, "verse_number": "४-३५-३७", "content_sanskrit": "महातपा दीर्घतपाः स्थविष्ठ स्थविरो ध्रुवः ।\nअहः संवत्सरो व्याप्तिः प्रमाणं परमं तपः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001345037, "chapter_id": 21345, "verse_number": "४-३५-३८", "content_sanskrit": "संवत्सरकरो मंत्रः प्रत्ययः सर्वतापनः ।\nअजः सर्वेश्वरस्सिद्धो महातेजा महाबलः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001345038, "chapter_id": 21345, "verse_number": "४-३५-३९", "content_sanskrit": "योगी योग्यो महारेता सिद्धिः सर्वादिरग्रहः ।\nवसुर्वसुमनाः सत्यः सर्वपापहरो हरः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001345039, "chapter_id": 21345, "verse_number": "४-३५-४०", "content_sanskrit": "सुकीर्ति शोभनस्स्रग्वी वेदांगो वेदविन्मुनिः ।\nभ्राजिष्णुर्भोजनं भोक्ता लोकनाथो दुराधरः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001345040, "chapter_id": 21345, "verse_number": "४-३५-४१", "content_sanskrit": "अमृतश्शाश्वतश्शांतो बाणहस्तः प्रतापवान् ।\nकमंडलुधरो धन्वी ह्यवाङ्मनसगोचरः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001345041, "chapter_id": 21345, "verse_number": "४-३५-४२", "content_sanskrit": "अतींद्रियो महामायस्सर्ववासश्चतुष्पथः ।\nकालयोगी महानादो महोत्साहो महाबलः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001345042, "chapter_id": 21345, "verse_number": "४-३५-४३", "content_sanskrit": "महाबुद्धिर्महावीर्यो भूतचारी पुरं दरः ।\nनिशाचरः प्रेतचारी महाशक्तिर्महाद्युतिः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001345043, "chapter_id": 21345, "verse_number": "४-३५-४४", "content_sanskrit": "अनिर्देश्यवपुः श्रीमान्सर्वाचार्यमनोगतिः ।\nबहुश्रुतिर्महामायो नियतात्मा ध्रुवोऽध्रुवः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001345044, "chapter_id": 21345, "verse_number": "४-३५-४५", "content_sanskrit": "तेजस्तेजो द्युतिधरो जनकः सर्वशासकः ।\nनृत्यप्रियो नृत्यनित्यः प्रकाशात्मा प्रकाशकः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001345045, "chapter_id": 21345, "verse_number": "४-३५-४६", "content_sanskrit": "स्पष्टाक्षरो बुधो मंत्रः समानः सारसंप्लवः ।\nयुगादिकृद्युगावर्तो गंभीरो वृषवाहनः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001345046, "chapter_id": 21345, "verse_number": "४-३५-४७", "content_sanskrit": "इष्टो विशिष्टः शिष्टेष्टः सुलभः सारशो धनः ।\nतीर्थरूपस्तीर्थनामा तीर्थादृश्यस्तु तीर्थदः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001345047, "chapter_id": 21345, "verse_number": "४-३५-४८", "content_sanskrit": "अपांनिधिरधिष्ठानं विजयो जयकालवित् ।\nप्रतिष्ठितः प्रमाणज्ञो हिरण्यकवचो हरिः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001345048, "chapter_id": 21345, "verse_number": "४-३५-४९", "content_sanskrit": "विमोचनस्सुरगणो विद्येशो बिंदुसंश्रयः ।\nवातरूपोऽमलोन्मायी विकर्ता गहनो गुहः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001345049, "chapter_id": 21345, "verse_number": "४-३५-५०", "content_sanskrit": "करणं कारणं कर्ता सर्वबंधविमोचनः ।\nव्यवसायो व्यवस्थानः स्थानदो जगदादिजः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001345050, "chapter_id": 21345, "verse_number": "४-३५-५१", "content_sanskrit": "गुरुदो ललितोऽभेदो भावात्मात्मनि संस्थितः ।\nवीरेश्वरो वीरभद्रो वीरासनविधिर्गुरुः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001345051, "chapter_id": 21345, "verse_number": "४-३५-५२", "content_sanskrit": "वीरचूडामणिर्वेत्ता चिदानंदो नदीधरः ।\nआज्ञाधारस्त्रिशूली च शिपिविष्टः शिवालयः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001345052, "chapter_id": 21345, "verse_number": "४-३५-५३", "content_sanskrit": "बालखिल्यो महावीरस्तिग्मांशुर्बधिरः खगः ।\nअभिरामः सुशरणः सुब्रह्मण्यः सुधापतिः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001345053, "chapter_id": 21345, "verse_number": "४-३५-५४", "content_sanskrit": "मघवान्कौशिको गोमान्विरामः सर्वसाधनः ।\nललाटाक्षो विश्वदेहः सारः संसारचक्रभृत्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001345054, "chapter_id": 21345, "verse_number": "४-३५-५५", "content_sanskrit": "अमोघदंडी मध्यस्थो हिरण्यो ब्रह्मवर्चसः ।\nपरमार्थः परोमायी शंबरो व्याघ्रलोचनः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001345055, "chapter_id": 21345, "verse_number": "४-३५-५६", "content_sanskrit": "रुचिर्बहुरुचिर्वेद्यो वाचस्पतिरहस्पतिः ।\nरविर्विरोचनः स्कंदः शास्ता वैवस्वतो यमः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001345056, "chapter_id": 21345, "verse_number": "४-३५-५७", "content_sanskrit": "युक्तिरुन्नतकीर्तिश्च सानुरागः पुरंजयः ।\nकैलासाधिपतिः कांतः सविता रविलोचनः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001345057, "chapter_id": 21345, "verse_number": "४-३५-५८", "content_sanskrit": "विश्वोत्तमो वीतभयो विश्वभर्त्ताऽनिवारितः ।\nनित्यो नियतकल्याणः पुण्यश्रवणकीर्त्तनः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001345058, "chapter_id": 21345, "verse_number": "४-३५-५९", "content_sanskrit": "दूरश्रवो विश्वसहो ध्येयो दुःस्वप्ननाशनः ।\nउत्तारणो दुष्कृतिहा विज्ञेयो दुःसहोऽभवः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001345059, "chapter_id": 21345, "verse_number": "४-३५-६०", "content_sanskrit": "अनादिर्भूर्भुवो लक्ष्मीः किरीटी त्रिदशाधिपः ।\nविश्वगोप्ता विश्वकर्त्ता सुवीरो रुचिरांगदः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001345060, "chapter_id": 21345, "verse_number": "४-३५-६१", "content_sanskrit": "जननो जनजन्मादिः प्रीतिमान्नीतिमान्ध्रुवः ।\nवशिष्ठः कश्यपो भानुर्भीमो भीमपराक्रमः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001345061, "chapter_id": 21345, "verse_number": "४-३५-६२", "content_sanskrit": "प्रणवः सत्पथाचारो महाकोशो महाधनः ।\nजन्माधिपो महा देवः सकलागमपारगः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001345062, "chapter_id": 21345, "verse_number": "४-३५-६३", "content_sanskrit": "तत्त्वं तत्त्वविदेकात्मा विभुर्विष्णुर्विभूषणः ।\nऋषिर्ब्राह्मण ऐश्वर्यजन्ममृत्युजरातिगः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001345063, "chapter_id": 21345, "verse_number": "४-३५-६४", "content_sanskrit": "पंचयज्ञसमुत्पत्तिर्विश्वेशो विमलोदयः ।\nआत्मयोनिरनाद्यंतो वत्सलो भक्तलोकधृक्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001345064, "chapter_id": 21345, "verse_number": "४-३५-६५", "content_sanskrit": "गायत्रीवल्लभः प्रांशुर्विश्वावासः प्रभाकरः ।\nशिशुर्गिरिरतः सम्राट् सुषेणः सुरशत्रुहा॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001345065, "chapter_id": 21345, "verse_number": "४-३५-६६", "content_sanskrit": "अनेमिरिष्टनेमिश्च मुकुन्दो विगतज्वरः ।\nस्वयंज्योतिर्महाज्योतिस्तनुज्योतिरचंचलः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001345066, "chapter_id": 21345, "verse_number": "४-३५-६७", "content_sanskrit": "पिंगलः कपिलश्मश्रुर्भालनेत्रस्त्रयीतनुः ।\nज्ञानस्कंदो महानीतिर्विश्वोत्पत्तिरुपप्लवः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001345067, "chapter_id": 21345, "verse_number": "४-३५-६८", "content_sanskrit": "भगो विवस्वानादित्यो गतपारो बृहस्पतिः ।\nकल्याणगुणनामा च पापहा पुण्यदर्शनः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001345068, "chapter_id": 21345, "verse_number": "४-३५-६९", "content_sanskrit": "उदारकीर्तिरुद्योगी सद्योगी सदसत्त्रपः ।\nनक्षत्रमाली नाकेशः स्वाधिष्ठानः षडाश्रयः॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001345069, "chapter_id": 21345, "verse_number": "४-३५-७०", "content_sanskrit": "पवित्रः पापहारी च मणिपूरो नभोगतिः ।\nहृत्पुंडरीकमासीनः शक्रः शांतो वृषाकपिः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001345070, "chapter_id": 21345, "verse_number": "४-३५-७१", "content_sanskrit": "उष्णो गृहपतिः कृष्णः समर्थोऽनर्थनाशनः ।\nअधर्मशत्रुरज्ञेयः पुरुहूतः पुरुश्रुतः॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001345071, "chapter_id": 21345, "verse_number": "४-३५-७२", "content_sanskrit": "ब्रह्मगर्भो बृहद्गर्भो धर्मधेनुर्धनागमः ।\nजगद्धितैषी सुगतः कुमारः कुशलागमः॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001345072, "chapter_id": 21345, "verse_number": "४-३५-७३", "content_sanskrit": "हिरण्यवर्णो ज्योतिष्मान्नानाभूतरतो ध्वनिः ।\nआरोग्यो नमनाध्यक्षो विश्वामित्रो धनेश्वरः॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001345073, "chapter_id": 21345, "verse_number": "४-३५-७४", "content_sanskrit": "ब्रह्मज्योतिर्वसुधामा महाज्योतिरनुत्तमः ।\nमातामहो मातरिश्वा नभस्वान्नागहारधृक्॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001345074, "chapter_id": 21345, "verse_number": "४-३५-७५", "content_sanskrit": "पुलस्त्यः पुलहोऽगस्त्यो जातूकर्ण्यः पराशरः ।\nनिरावरणनिर्वारो वैरंच्यो विष्टरश्रवाः॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001345075, "chapter_id": 21345, "verse_number": "४-३५-७६", "content_sanskrit": "आत्मभूरनिरुद्धोऽत्रिर्ज्ञानमूर्तिर्महायशाः ।\nलोकवीराग्रणीर्वीरश्चण्डः सत्यपराक्रमः॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001345076, "chapter_id": 21345, "verse_number": "४-३५-७७", "content_sanskrit": "व्यालकल्पो महाकल्पः कल्पवृक्षः कलाधरः ।\nअलंकरिष्णुरचलो रोचिष्णुर्विक्रमोन्नतः॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001345077, "chapter_id": 21345, "verse_number": "४-३५-७८", "content_sanskrit": "आयुः शब्दपतिर्वाग्मी प्लवनश्शिखिसारथिः ।\nअसंसृष्टोऽतिथिश्शत्रुः प्रमाथी पादपासनः॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001345078, "chapter_id": 21345, "verse_number": "४-३५-७९", "content_sanskrit": "वसुश्रवा कव्यवाहः प्रतप्तो विश्वभोजनः ।\nजप्यो जरादिशमनो लोहितश्च तनूनपात्॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001345079, "chapter_id": 21345, "verse_number": "४-३५-८०", "content_sanskrit": "पृषदश्वो नभोयोनिः सुप्रतीकस्तमिस्रहा ।\nनिदाघस्तपनो मेघभक्षः परपुरंजयः॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001345080, "chapter_id": 21345, "verse_number": "४-३५-८१", "content_sanskrit": "सुखानिलस्सुनिष्पन्नस्सुरभिश्शिशिरात्मकः ।\nवसंतो माधवो ग्रीष्मो नभस्यो बीजवाहनः॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001345081, "chapter_id": 21345, "verse_number": "४-३५-८२", "content_sanskrit": "अंगिरा गुरुरात्रेयो विमलो विश्वपावनः ।\nपावनः पुरजिच्छक्रस्त्रैविद्यो नववारण॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001345082, "chapter_id": 21345, "verse_number": "४-३५-८३", "content_sanskrit": "मनोबुद्धिरहंकारः क्षेत्रज्ञः क्षेत्रपालकः ।\nजमदग्निर्बलनिधिर्विगालो विश्वगालवः॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001345083, "chapter_id": 21345, "verse_number": "४-३५-८४", "content_sanskrit": "अघोरोऽनुत्तरो यज्ञः श्रेयो निःश्रेयसप्रदः ।\nशैलो गगनकुंदाभो दानवारिररिंदमः॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001345084, "chapter_id": 21345, "verse_number": "४-३५-८५", "content_sanskrit": "चामुण्डो जनकश्चारुर्निश्शल्यो लोकशल्यधृक् ।\nचतुर्वेदश्चतुर्भावश्चतुरश्चतुर प्रियः॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001345085, "chapter_id": 21345, "verse_number": "४-३५-८६", "content_sanskrit": "आम्नायोऽथ समाम्नायस्तीर्थदेवशिवालयः ।\nबहुरूपो महारूपस्सर्वरूपश्चराचरः॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001345086, "chapter_id": 21345, "verse_number": "४-३५-८७", "content_sanskrit": "न्यायनिर्मायको नेयो न्यायगम्यो निरंजनः ।\nसहस्रमूर्द्धा देवेंद्रस्सर्वशस्त्रप्रभंजनः॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001345087, "chapter_id": 21345, "verse_number": "४-३५-८८", "content_sanskrit": "मुंडी विरूपो विकृतो दंडी नादी गुणोत्तमः ।\nपिंगलाक्षो हि बह्वयो नीलग्रीवो निरामयः॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001345088, "chapter_id": 21345, "verse_number": "४-३५-८९", "content_sanskrit": "सहस्रबाहुस्सर्वेशश्शरण्यस्सर्वलोकधृक् ।\nपद्मासनः परं ज्योतिः पारम्पर्य्यफलप्रदः॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7001345089, "chapter_id": 21345, "verse_number": "४-३५-९०", "content_sanskrit": "पद्मगर्भो महागर्भो विश्वगर्भो विचक्षणः ।\nपरावरज्ञो वरदो वरेण्यश्च महास्वनः॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7001345090, "chapter_id": 21345, "verse_number": "४-३५-९१", "content_sanskrit": "देवासुरगुरुर्देवो देवासुरनमस्कृतः ।\nदेवासुरमहा मित्रो देवासुरमहेश्वरः॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7001345091, "chapter_id": 21345, "verse_number": "४-३५-९२", "content_sanskrit": "देवासुरेश्वरो दिव्यो देवासुरमहाश्रयाः ।\nदेवदेवोऽनयोऽचिंत्यो देवतात्मात्मसंभवः॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7001345092, "chapter_id": 21345, "verse_number": "४-३५-९३", "content_sanskrit": "सद्यो महासुरव्याधो देवसिंहो दिवाकरः ।\nविबुधामचरः श्रेष्ठः सर्वदेवोत्तमोत्तम॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7001345093, "chapter_id": 21345, "verse_number": "४-३५-९४", "content_sanskrit": "शिवज्ञानरतः श्रीमाञ्शिखी श्रीपर्वतप्रियः ।\nवज्रहस्तस्सिद्धखङ्गो नरसिंहनिपातनः॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7001345094, "chapter_id": 21345, "verse_number": "४-३५-९५", "content_sanskrit": "ब्रह्मचारी लोकचारी धर्मचारी धनाधिपः ।\nनन्दी नंदीश्वरोऽनंतो नग्नव्रतधरश्शुचिः॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7001345095, "chapter_id": 21345, "verse_number": "४-३५-९६", "content_sanskrit": "लिंगाध्यक्षः सुराध्यक्षो युगाध्यक्षो युगापहः ।\nस्वधामा स्वगतः स्वर्गी स्वरः स्वरमयः स्वनः॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7001345096, "chapter_id": 21345, "verse_number": "४-३५-९७", "content_sanskrit": "बाणाध्यक्षो बीजकर्ता कर्मकृद्धर्मसंभवः ।\nदंभो लोभोऽथ वै शंभुस्सर्व भूतमहेश्वरः॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7001345097, "chapter_id": 21345, "verse_number": "४-३५-९८", "content_sanskrit": "श्मशाननिलयस्त्र्यक्षस्स तुरप्रतिमाकृतिः ।\nलोकोत्तरस्फुटोलोकः त्र्यंबको नागभूषणः॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7001345098, "chapter_id": 21345, "verse_number": "४-३५-९९", "content_sanskrit": "अंधकारि मखद्वेषी विष्णुकंधरपातनः ।\nहीनदोषोऽक्षयगुणो दक्षारिः पूषदंतभित्॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7001345099, "chapter_id": 21345, "verse_number": "४-३५-१००", "content_sanskrit": "पूर्णः पूरयिता पुण्यः सुकुमारः सुलोचनः ।\nसन्मार्गमप्रियो धूर्त्तः पुण्यकीर्तिरनामयः॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7001345100, "chapter_id": 21345, "verse_number": "४-३५-१०१", "content_sanskrit": "मनोजवस्तीर्थकरो जटिलो नियमेश्वरः ।\nजीवितांतकरो नित्यो वसुरेता वसुप्रदः॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7001345101, "chapter_id": 21345, "verse_number": "४-३५-१०२", "content_sanskrit": "सद्गतिः सिद्धिदः सिद्धिः सज्जातिः खलकंटकः ।\nकलाधरो महाकालभूतः सत्यपरायणः॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7001345102, "chapter_id": 21345, "verse_number": "४-३५-१०३", "content_sanskrit": "लोकलावण्यकर्ता च लोकोत्तरसुखालयः ।\nचंद्रसंजीवनश्शास्ता लोकग्राहो महाधिपः॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7001345103, "chapter_id": 21345, "verse_number": "४-३५-१०४", "content_sanskrit": "लोकबंधुर्लोकनाथः कृतज्ञः कृतिभूषितः ।\nअनपायोऽक्षरः कांतः सर्वशस्त्रभृतां वरः॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7001345104, "chapter_id": 21345, "verse_number": "४-३५-१०५", "content_sanskrit": "तेजोमयो श्रुतिधरो लोकमानी घृणार्णवः ।\nशुचिस्मितः प्रसन्नात्मा ह्यजेयो दुरतिक्रमः॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7001345105, "chapter_id": 21345, "verse_number": "४-३५-१०६", "content_sanskrit": "ज्योतिर्मयो जगन्नाथो निराकारो जलेश्वरः ।\nतुम्बवीणो महाकायो विशोकश्शोकनाशनः॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7001345106, "chapter_id": 21345, "verse_number": "४-३५-१०७", "content_sanskrit": "त्रिलोकपस्त्रिलोकेशः सर्वशुद्धिरधोक्षजः ।\nअव्यक्तलक्षणो देवो व्यक्तोऽव्यक्तो विशांपतिः॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7001345107, "chapter_id": 21345, "verse_number": "४-३५-१०८", "content_sanskrit": "परः शिवो वसुर्नासासारो मानधरो यमः ।\nब्रह्मा विष्णुः प्रजापालो हंसो हंसगतिर्वयः॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7001345108, "chapter_id": 21345, "verse_number": "४-३५-१०९", "content_sanskrit": "वेधा विधाता धाता च स्रष्टा हर्त्ता चतुर्मुखः ।\nकैलासशिखरावासी सर्वावासी सदागति॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7001345109, "chapter_id": 21345, "verse_number": "४-३५-११०", "content_sanskrit": "हिरण्यगर्भो द्रुहिणो भूतपालोऽथ भूपतिः ।\nसद्योगी योगविद्योगीवरदो ब्राह्मणप्रिय॥ ११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7001345110, "chapter_id": 21345, "verse_number": "४-३५-१११", "content_sanskrit": "देवप्रियो देवनाथो देवको देवचिंतकः ।\nविषमाक्षो विरूपाक्षो वृषदो वृषवर्धनः॥ १११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7001345111, "chapter_id": 21345, "verse_number": "४-३५-११२", "content_sanskrit": "निर्ममो निरहंकारो निर्मोहो निरुपद्रवः ।\nदर्पहा दर्पदो दृप्तः सर्वार्थपरिवर्त्तकः॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7001345112, "chapter_id": 21345, "verse_number": "४-३५-११३", "content_sanskrit": "सहस्रार्चिर्भूतिभूषः स्निग्धाकृतिरदक्षिणः ।\nभूतभव्यभवन्नाथो विभवो भूतिनाशनः॥ ११३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7001345113, "chapter_id": 21345, "verse_number": "४-३५-११४", "content_sanskrit": "अर्थोऽनर्थो महाकोश परकायैकपंडित ।\nनिष्कंटकः कृतानंदो निर्व्याजो व्याजमर्दनः॥ ११४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7001345114, "chapter_id": 21345, "verse_number": "४-३५-११५", "content_sanskrit": "सत्त्ववान्सात्त्विकः सत्यः कृतस्नेहः कृतागमः ।\nअकंपितो गुणग्राही नैकात्मानैककर्मकृत्॥ ११५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7001345115, "chapter_id": 21345, "verse_number": "४-३५-११६", "content_sanskrit": "सुप्रीतः सुखदः सूक्ष्मः सुकरो दक्षिणानिलः ।\nनंदिस्कंदो धरो धुर्यः प्रकटः प्रीतिवर्धनः॥ ११६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7001345116, "chapter_id": 21345, "verse_number": "४-३५-११७", "content_sanskrit": "अपराजितः सर्वसहो गोविंदः सत्त्ववाहनः ।\nअधृतः स्वधृतः सिद्धः पूतमूर्तिर्यशोधनः॥ ११७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7001345117, "chapter_id": 21345, "verse_number": "४-३५-११८", "content_sanskrit": "वाराहशृंगधृक् शृंगी बलवानेकनायकः ।\nश्रुतिप्रकाशः श्रुतिमाने कबंधुरनेकधृक्॥ ११८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7001345118, "chapter_id": 21345, "verse_number": "४-३५-११९", "content_sanskrit": "श्रीवत्सलः शिवारंभः शांतभद्रः समो यशः ।\nभूयशो भूषणो भूतिर्भूतिकृद्भूतभावनः॥ ११९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7001345119, "chapter_id": 21345, "verse_number": "४-३५-१२०", "content_sanskrit": "अकंपो भक्तिकायस्तु कालहानिः कलाविभुः ।\nसत्यव्रती महात्यागी नित्यशांतिपरायणः॥ १२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7001345120, "chapter_id": 21345, "verse_number": "४-३५-१२१", "content_sanskrit": "परार्थवृत्तिर्वरदो विरक्तस्तु विशारदः ।\nशुभदः शुभकर्ता च शुभनामा शुभः स्वयम्॥ १२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7001345121, "chapter_id": 21345, "verse_number": "४-३५-१२२", "content_sanskrit": "अनर्थितो गुणग्राही ह्यकर्ता कनकप्रभः ।\nस्वभावभद्रो मध्यस्थ शत्रुघ्नो विघ्ननाशनः॥ १२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7001345122, "chapter_id": 21345, "verse_number": "४-३५-१२३", "content_sanskrit": "शिखंडी कवची शूली जटी मुंडी च कुंडली ।\nअमृत्युः सर्वदृक् सिंहस्तेजोराशिर्महामणिः॥ १२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7001345123, "chapter_id": 21345, "verse_number": "४-३५-१२४", "content_sanskrit": "असंख्येयोऽप्रमेयात्मा वीर्यवान् वीर्यकोविदः ।\nवेद्यश्च वै वियोगात्मा सप्तावरमुनीश्वरः॥ १२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7001345124, "chapter_id": 21345, "verse_number": "४-३५-१२५", "content_sanskrit": "अनुत्तमो दुराधर्षो मधुरः प्रियदर्शनः ।\nसुरेश स्मरणः सर्वः शब्दः प्रतपतां वरः॥ १२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7001345125, "chapter_id": 21345, "verse_number": "४-३५-१२६", "content_sanskrit": "कालपक्षः कालकालः सुकृती कृतवासुकिः ।\nमहेष्वासो महीभर्ता निष्कलंको विशृंखल॥ १२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7001345126, "chapter_id": 21345, "verse_number": "४-३५-१२७", "content_sanskrit": "द्युमणिस्तरणिर्धन्यः सिद्धिदः सिद्धिसाधनः ।\nविश्वतस्संवृतस्तु व्यूढोरस्को महाभुजः॥ १२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7001345127, "chapter_id": 21345, "verse_number": "४-३५-१२८", "content_sanskrit": "सर्वयोनिर्निरातंको नरनारायणप्रियः ।\nनिर्लेपो यतिसंगात्मा निर्व्यंगो व्यंगनाशनः॥ १२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7001345128, "chapter_id": 21345, "verse_number": "४-३५-१२९", "content_sanskrit": "स्तव्यः स्तवप्रियः स्तोता व्यासमूर्तिर्निरंकुलः ।\nनिरवद्यमयोपायो विद्याराशिश्च सत्कृतः॥ १२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7001345129, "chapter_id": 21345, "verse_number": "४-३५-१३०", "content_sanskrit": "प्रशांतबुद्धिरक्षुण्णः संग्रहो नित्यसुंदरः ।\nवैयाघ्रधुर्यो धात्रीशः संकल्पः शर्वरीपतिः॥ १३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7001345130, "chapter_id": 21345, "verse_number": "४-३५-१३१", "content_sanskrit": "परमार्थगुरुर्दत्तः सूरिराश्रितवत्सलः ।\nसोमो रसज्ञो रसदः सर्वसत्त्वावलंबनः॥ १३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7001345131, "chapter_id": 21345, "verse_number": "४-३५-१३२", "content_sanskrit": "एवं नाम्नां सहस्रेण तुष्टाव हि हरं हरिः ।\nप्रार्थयामास शम्भुं वै पूजयामास पंकजः॥ १३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7001345132, "chapter_id": 21345, "verse_number": "४-३५-१३३", "content_sanskrit": "ततः स कौतुकी शम्भुश्चकार चरितं द्विजाः ।\nमहाद्भुतं सुखकरं तदेव शृणुतादरात्॥ १३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}]