[{"id": 2207377, "chapter_id": 5422, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2207378, "chapter_id": 5422, "verse_number": "१", "content_sanskrit": "सभायां वसतोस्तस्यां निहत्यारीन् महात्मनोः ।\nकेशवार्जुनयोः का नु कथा समभवद् द्विज\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2207379, "chapter_id": 5422, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2207380, "chapter_id": 5422, "verse_number": "२", "content_sanskrit": "कृष्णेन सहितः पार्थः स्वराज्यं प्राप्य केवलम् ।\nतस्यां सभायां रम्यायां विजहार मुदा युतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2207381, "chapter_id": 5422, "verse_number": "३", "content_sanskrit": "ततः कञ्चित् सभोद्देशं स्वर्गोद्देशोपमं नृप ।\nयदृच्छया तौ मुदितौ जग्मतुः स्वजनावृतौ\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2207382, "chapter_id": 5422, "verse_number": "४", "content_sanskrit": "तत्र प्रतीतः कृष्णेन सहितः पाण्डवोऽर्जुनः ।\nनिरीक्ष्य तां सभां रम्यामिदं वचनमब्रवीत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2207383, "chapter_id": 5422, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2207384, "chapter_id": 5422, "verse_number": "५", "content_sanskrit": "विदितं मे महाबाहो सङ्ग्रामे समुपस्थिते ।\nमाहात्म्यं देवकीपुत्र तच्च ते रूपमैश्वरम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2207385, "chapter_id": 5422, "verse_number": "६", "content_sanskrit": "यत्तु तद् भवता प्रोक्तं तदा केशव सौहृदात् ।\nतत्सर्वं पुरुषव्याघ्र नष्टं मे व्यग्रचेतसः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2207386, "chapter_id": 5422, "verse_number": "७", "content_sanskrit": "मम कौतूहलं त्वस्ति तेष्वर्थेषु पुनः प्रभो ।\nभवांस्तु द्वारकां गन्ता न चिरादिव केशव\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2207387, "chapter_id": 5422, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2207388, "chapter_id": 5422, "verse_number": "८", "content_sanskrit": "एवमुक्तस्ततः कृष्णः फल्गुनं प्रत्यभाषत ।\nपरिष्वज्य महातेजा वचनं वदतां वरः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2207389, "chapter_id": 5422, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2207390, "chapter_id": 5422, "verse_number": "९", "content_sanskrit": "श्रावितस्त्वं मया गुह्यं ज्ञापितश्च सनातनम् ।\nधर्मस्वरूपिणं पार्थ सर्वलोकांश्च शाश्वतान्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2207391, "chapter_id": 5422, "verse_number": "१०", "content_sanskrit": "अबुद्ध्या यन्न गृह्णीथास्तन्मे सुमहदप्रियम् ।\nनूनमश्रद्दधानोऽसि दुर्मेधाश्चासि पाण्डव\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2207392, "chapter_id": 5422, "verse_number": "११", "content_sanskrit": "स हि धर्मः सुपर्याप्तो ब्रह्मणः पदवेदने ।\nन शक्यं तन्मया भूयस्तथा वक्तुमशेषतः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2207393, "chapter_id": 5422, "verse_number": "१२", "content_sanskrit": "परं हि ब्रह्म कथितं योगयुक्तेन तन्मया ।\nइतिहासं तु वक्ष्यामि तस्मिन्नर्थे पुरातनम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2207394, "chapter_id": 5422, "verse_number": "१३", "content_sanskrit": "यथा तां बुद्धिमास्थाय गतिमग्र्यां गमिष्यसि ।\nशृणु धर्मभृतां श्रेष्ठ गदतः सर्वमेव मे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2207395, "chapter_id": 5422, "verse_number": "१४", "content_sanskrit": "आगच्छद् ब्राह्मणः कश्चित् स्वर्गलोकादरिन्दम ।\nब्रह्मलोकाच्च दुर्धर्षः सोऽस्माभिः पूजितोऽवसत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2207396, "chapter_id": 5422, "verse_number": "१५", "content_sanskrit": "परिपृष्टश्च स तदा यदाह द्विजसत्तमः ।\nदिव्येन विधिना पार्थ तच्छृणुष्वाविचारयन्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2207397, "chapter_id": 5422, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2207398, "chapter_id": 5422, "verse_number": "१६", "content_sanskrit": "मोक्षधर्मं समाश्रित्य कृष्ण यन्माऽनुपृच्छसि ।\nभूतानामनुकम्पार्थं मन्मोहच्छेदनं प्रभो\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2207399, "chapter_id": 5422, "verse_number": "१७", "content_sanskrit": "तत् तेऽहं सम्प्रवक्ष्यामि यथावन्मधुसूदन ।\nशृणुष्वावहितो भूत्वा गदतो मम माधव\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2207400, "chapter_id": 5422, "verse_number": "१८", "content_sanskrit": "कश्चिद् विप्रस्तपोयुक्तः काश्यपो नाम धर्मवित् ।\nआससाद द्विजं कञ्चिद् धर्माणामागमागमम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2207401, "chapter_id": 5422, "verse_number": "१९", "content_sanskrit": "गतागमं सुबहुशो ज्ञानविज्ञानपारगम् ।\nलोकतत्त्वार्थकुशलं ज्ञातारं सुखदुःखयोः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2207402, "chapter_id": 5422, "verse_number": "२०", "content_sanskrit": "जातिस्मरणतत्त्वज्ञं कोविदं पापपुण्ययोः ।\nद्रष्टारमुच्चनीचानां कर्मभिर्देहिनां गतिम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2207403, "chapter_id": 5422, "verse_number": "२१", "content_sanskrit": "चरन्तं मुक्तवत् सिद्धं प्रशान्तं संयतेन्द्रियम् ।\nदीप्यमानं श्रिया ब्राह्म्या क्रममाणं च सर्वशः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2207404, "chapter_id": 5422, "verse_number": "२२", "content_sanskrit": "अन्तर्धानगतिज्ञं च श्रुत्वा तत्त्वेन काश्यपः ।\nतथैवान्तर्हितैः सिद्धैर्यात चक्रधरैः सह\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2207405, "chapter_id": 5422, "verse_number": "२३", "content_sanskrit": "सम्भाषमाणमेकान्ते समासीनं च तैः सह ।\nयदृच्छया च गच्छन्तमसक्तं पवनं यथा\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2207406, "chapter_id": 5422, "verse_number": "२४", "content_sanskrit": "तं समासाद्य मेधावी स तदा द्विजसत्तमः ।\nचरणौ धर्मकामो वै स तस्य सुसमाहितः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2207407, "chapter_id": 5422, "verse_number": "२५", "content_sanskrit": "प्रतिपेदे यथान्यायं भक्त्या परमया युतः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2207408, "chapter_id": 5422, "verse_number": "२६", "content_sanskrit": "विस्मितश्चाद्भुतं दृष्ट्वा काश्यपस्तं द्विजोत्तमम् ।\nपरिचारेण महता गुरुं वै पर्यतोषयत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2207409, "chapter_id": 5422, "verse_number": "२७", "content_sanskrit": "उपसन्नश्च धर्मात्मा श्रुतचारित्रसंयुतः ।\nभावेनातोषयत् तं वै गुरुवृत्तिं समाश्रितः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2207410, "chapter_id": 5422, "verse_number": "२८", "content_sanskrit": "तस्मै तुष्टः स शिष्याय यत् प्रसन्नोऽब्रवीद् गुरुः ।\nसिद्धिं परामभिप्रेक्ष्य शृणु तन्मे जनार्दन\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2207411, "chapter_id": 5422, "verse_number": "", "content_sanskrit": "सिद्धः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2207412, "chapter_id": 5422, "verse_number": "२९", "content_sanskrit": "विविधैः कर्मभिस्तात पुण्ययोगैश्च केवलैः ।\nगच्छन्तीह गतिं मर्त्या देवलोके च वा स्थितिम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2207413, "chapter_id": 5422, "verse_number": "३०", "content_sanskrit": "न क्वचित् सुखमत्यन्तं न क्वचिच्छाश्वती स्थितिः ।\nस्थानाच्च महतो भ्रंशो दुःखलब्धात् पुनः पुनः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2207414, "chapter_id": 5422, "verse_number": "३१", "content_sanskrit": "अशुभा गतयः प्राप्ताः कष्टा मे पापसेवनात् ।\nकाममन्युपरीतेन तृष्णया मोहितेन च\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2207415, "chapter_id": 5422, "verse_number": "३२", "content_sanskrit": "पुनः पुनश्च मरणं जन्म चैव पुनः पुनः ।\nआहारा विविधा भुक्ताः पीता नानाविधाः स्तनाः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2207416, "chapter_id": 5422, "verse_number": "३३", "content_sanskrit": "मातरो विविधा दृष्टाः पितरश्च पृथग् विधाः ।\nसुखानि च विचित्राणि दुःखानि च मयाऽनघ\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2207417, "chapter_id": 5422, "verse_number": "३४", "content_sanskrit": "प्रियैर्विवासो बहुशः संवासश्चाप्रियैः सह ।\nधननाशश्च सम्प्राप्तो लब्ध्वा दुःखेन तद्धनम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2207418, "chapter_id": 5422, "verse_number": "३५", "content_sanskrit": "अवमानाः सुकष्टाश्च परतः स्वजनात् तथा ।\nशारीरा मानसाश्चापि वेदना भृशदारुणाः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2207419, "chapter_id": 5422, "verse_number": "३६", "content_sanskrit": "पतनं निरये चैव यातनाश्च यमक्षये ।\nप्राप्ता विमाननाश्चोग्रा वधं बन्धाश्च दारुणाः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2207420, "chapter_id": 5422, "verse_number": "३७", "content_sanskrit": "जरा रोगाश्च सततं व्यसनानि च भूरिशः ।\nलोकेऽस्मिन्ननुभूतानि द्वन्द्वजानि भृशं मया\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2207421, "chapter_id": 5422, "verse_number": "३८", "content_sanskrit": "ततः कदाचिन्निर्वेदान्निकाराश्रितेन च ।\nलोकतन्त्रं परित्यक्तं दुःखार्तेन भृशं मया\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2207422, "chapter_id": 5422, "verse_number": "३९", "content_sanskrit": "ततः सिद्धिरियं प्राप्ता प्रसादादात्मनो मया\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2207423, "chapter_id": 5422, "verse_number": "४०", "content_sanskrit": "नाहं पुनरिहागन्ता लोकानालोकयाम्यहम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2207424, "chapter_id": 5422, "verse_number": "४१", "content_sanskrit": "आसिद्धेराप्रजासर्गादात्मनोऽपि गतीः शुभाः ।\nउपलब्धा द्विजश्रेष्ठ तथेयं सिद्धिरुत्तमा\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2207425, "chapter_id": 5422, "verse_number": "४२", "content_sanskrit": "इतः परं गमिष्यामि ततः परतरं महत् ।\nब्रह्मणः पदमव्यग्रं मां तेऽभूदत्र संशयः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2207426, "chapter_id": 5422, "verse_number": "४३", "content_sanskrit": "नाहं पुनरिहागन्ता मर्त्यलोकं द्विजोत्तम ।\nप्रीतोऽस्मि ते महाप्राज्ञ ब्रूहि किं करवाणि ते\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2207427, "chapter_id": 5422, "verse_number": "४४", "content_sanskrit": "यदीप्सुरुपसम्पन्नं तस्य कालोऽयमागतः ।\nअभिजाने च तदहं यदर्थं मां त्वमागतः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2207428, "chapter_id": 5422, "verse_number": "४५", "content_sanskrit": "अचिरात् तु गमिष्यामि येनाहं त्वामचूचुदम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2207429, "chapter_id": 5422, "verse_number": "४६", "content_sanskrit": "भृशं प्रीतोऽस्मि भवतः चारित्रेऽथ विचक्षण ।\nपरिपृच्छ यावद् भवतो भाषे यद्यत् तवेप्सितम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2207430, "chapter_id": 5422, "verse_number": "४७", "content_sanskrit": "बहु मन्ये च बुद्धिं ते भृशं सम्पूजयामि च ।\nयेनाहं भवता बुद्धो मेधावी ह्यसि काश्यप\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2207431, "chapter_id": 5422, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि\nकाश्यपब्राह्मणसमागमो नाम षोडशोऽध्यायः ॥१६॥\nअनुगीतापर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]