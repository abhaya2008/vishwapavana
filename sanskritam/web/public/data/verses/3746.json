[{"id": 2128169, "chapter_id": 3746, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2128170, "chapter_id": 3746, "verse_number": "१", "content_sanskrit": "ततः प्रयान्तं कौन्तेयं ब्राह्मणा वनवासिनः ।\nअभिगम्य तदा राजन्निदं वचनमब्रुवन्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2128171, "chapter_id": 3746, "verse_number": "२", "content_sanskrit": "राजंस्तीर्थानि गन्तासि पुण्यानि भ्रातृभिः सह ।\nदेवर्षिणा च सहितो लोमशेन महात्मना\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2128172, "chapter_id": 3746, "verse_number": "३", "content_sanskrit": "अस्मानपि महाराज नेतुमर्हसि पाण्डव ।\nअस्माभिर्हि न शक्यानि त्वामृते कुरुनन्दन\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2128173, "chapter_id": 3746, "verse_number": "४", "content_sanskrit": "श्वापदैरुपसृष्टानि दुर्गाणि विषमाणि च ।\nअगम्यानि नरैरल्पैस्तीर्थानि मनुजेश्वर \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2128174, "chapter_id": 3746, "verse_number": "५", "content_sanskrit": "भवतो भ्रातरः शूरा धनुर्धरवरास्तथा ।\nभवद्भिः पालिताः शूरैर्गच्छामो वयमप्युत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2128175, "chapter_id": 3746, "verse_number": "६", "content_sanskrit": "भवत्प्रसादाद्धि वयं प्राप्नुयाम फलं शुभम् ।\nतीर्थानां पृथिवीपाल वनानां च विशांपते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2128176, "chapter_id": 3746, "verse_number": "७", "content_sanskrit": "तव वीर्यपरित्राताः शुद्धास्तीर्थपरिप्लुताः ।\nभवेम धूतपाप्मानः तीर्थसंदर्शनान्नृप\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2128177, "chapter_id": 3746, "verse_number": "८", "content_sanskrit": "भवानपि नरेन्द्रस्य कार्तवीर्यस्य चानघ ।\nअष्टकस्य च राजर्षेर्लोमपादस्य चैव ह \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2128178, "chapter_id": 3746, "verse_number": "९", "content_sanskrit": "भरतस्य च वीरस्य सार्वभौमस्य पार्थिव ।\nत्वं हि प्राप्स्यति दुष्प्रापाँल्लोकांस्तीर्थपरिप्लुतः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2128179, "chapter_id": 3746, "verse_number": "१०", "content_sanskrit": "प्रभासादीनि तीर्थानि महेन्द्रादींश्च पर्वतान् ।\nगङ्गाद्याः सरितश्चैव प्लक्षादींश्च वनस्पतीन्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2128180, "chapter_id": 3746, "verse_number": "११", "content_sanskrit": "त्वया सह महीपाल द्रष्टुमिच्छामहे वयम् ।\nभवद्भिः पालिताः शूरैः तीर्थान्यायतनानि च \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2128181, "chapter_id": 3746, "verse_number": "१२", "content_sanskrit": "यदि ते ब्राह्मणेष्वस्ति काचित् प्रीतिर्जनाधिप ।\nकुरु क्षिप्रं वचोऽस्माकं ततः श्रेयोऽभिपत्स्यसे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2128182, "chapter_id": 3746, "verse_number": "१३", "content_sanskrit": "तीर्थानि हि महाबाहो तपोविघ्नकरैः सदा ।\nअनुकीर्णानि रक्षोभिः तेभ्यो नस्त्रातुमर्हसि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2128183, "chapter_id": 3746, "verse_number": "१४", "content_sanskrit": "तीर्थान्युक्तानि धौम्येन नारदेन च धीमता ।\nयान्युवाच च देवर्षिर्लोमशः सुमहातपाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2128184, "chapter_id": 3746, "verse_number": "१५", "content_sanskrit": "विधिवत् तानि सर्वाणि पर्यटस्व नराधिप ।\nधूतपाप्मा सहास्माभिर्लोमशेनाभिपालितः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2128185, "chapter_id": 3746, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2128186, "chapter_id": 3746, "verse_number": "१६", "content_sanskrit": "स तथा पूज्यमानस्तैर्हर्षादश्रुपरिप्लुतः ।\nभीमसेनादिभिर्वीरैर्भ्रातृभिः परिवारितः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2128187, "chapter_id": 3746, "verse_number": "१७", "content_sanskrit": "बाढमित्यब्रवीत् सर्वान् तानृषीन् पाण्डवर्षभः ।\nलोमशं समनुज्ञाप्य धौम्यं चैव पुरोहितम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2128188, "chapter_id": 3746, "verse_number": "१८", "content_sanskrit": "ततः स पाण्डवश्रेष्ठो भ्रातृभिः सहितो वशी ।\nद्रौपद्या चानवद्याङ्ग्या गमनाय मनो दधे\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2128189, "chapter_id": 3746, "verse_number": "१९", "content_sanskrit": "अथ व्यासो महाभागः तथा नारदपर्वतौ ।\nकाम्यके पाण्डवं द्रष्टुं समाजग्मुर्मनीषिणः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2128190, "chapter_id": 3746, "verse_number": "२०", "content_sanskrit": "तेषां युधिष्ठिरो राजा पूजां चक्रे यथाविधि ।\nसत्कृतास्ते महाभागा युधिष्ठिरमथाब्रुवन्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2128191, "chapter_id": 3746, "verse_number": "२१", "content_sanskrit": "युधिष्ठिर यमौ भीम मनसा कुरुतार्जवम् ।\nमनसा कृतशौचा वै शुद्धास्तीर्थानि गच्छत\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2128192, "chapter_id": 3746, "verse_number": "२२", "content_sanskrit": "शरीरनियमं प्राहुर्ब्राह्मणा मानुषं व्रतम् ।\nमनोविशुद्धां बुद्धिं च दैवमाहुर्व्रतं द्विजाः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2128193, "chapter_id": 3746, "verse_number": "२३", "content_sanskrit": "मनो ह्यदुष्टं शौचाय पर्याप्तं वै नराधिप ।\nमैत्रीं बुद्धिं समास्थाय शुद्धास्तीर्थानि गच्छत\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2128194, "chapter_id": 3746, "verse_number": "२४", "content_sanskrit": "ते यूयं मानसैः शुद्धाः शरीरनियमव्रतैः ।\nदैवं व्रतं समास्थाय यथोक्तं फलमाप्स्यथ\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2128195, "chapter_id": 3746, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2128196, "chapter_id": 3746, "verse_number": "२५", "content_sanskrit": "ते तथेति प्रतिज्ञाय कृष्णया सह पाण्डवाः ।\nकृतस्वस्त्ययनाः सर्वे मुनिभिर्दिव्यमानुषैः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2128197, "chapter_id": 3746, "verse_number": "२६", "content_sanskrit": "लोमशस्योपसङ्गृह्य पादौ द्वैपायनस्य च ।\nनारदस्य च राजेन्द्र देवर्षेः पर्वतस्य च\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2128198, "chapter_id": 3746, "verse_number": "२७", "content_sanskrit": "धौम्येन सहिता वीरास्तथा तैर्वनवासिभिः ।\nमार्गशीर्ष्यामतीतायां पुष्येण प्रययुस्ततः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2128199, "chapter_id": 3746, "verse_number": "२८", "content_sanskrit": "कठिनानि समादाय चीराजिनजटाधराः ।\nप्रययुः पाण्डवाः सर्वे काम्यकाद् गुरुवत्सलाः ।\nअभेद्यैः कवचैर्युक्ताः तीर्थान्यन्वचरंस्ततः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2128200, "chapter_id": 3746, "verse_number": "२९", "content_sanskrit": "इन्द्रसेनादिभिर्भृत्यै रथैः परिचतुर्दशैः ।\nमहानसव्यापृतैश्च तथाऽन्यैः परिचारकैः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2128201, "chapter_id": 3746, "verse_number": "३०", "content_sanskrit": "सायुधा बद्धनिस्त्रिंशाः तूणवन्तः समार्गणाः ।\nप्राङ्मुखाः प्रययुर्वीराः पाण्डवा जनमेजय\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2128202, "chapter_id": 3746, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि अष्टाशीतितमोऽध्यायः ॥८८॥\n॥ तीर्थयात्रापर्वणि चतुःचत्वारिंशोऽध्यायः ॥४४॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]