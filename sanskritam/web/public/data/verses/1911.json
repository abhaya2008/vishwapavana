[{"id": 2041009, "chapter_id": 1911, "verse_number": "५-१५६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2041010, "chapter_id": 1911, "verse_number": "५-१५६-१", "content_sanskrit": "ततः शान्तनवं भीष्मं प्राञ्जलिर्धृतराष्ट्रजः।\nसह सर्वैर्महीपालैरिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2041011, "chapter_id": 1911, "verse_number": "५-१५६-२", "content_sanskrit": "ऋते सेनाप्रणेतारं पृतना सुमहत्यपि ।\nदीर्यते युद्धमासाद्य पिपीलिकपुटं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2041012, "chapter_id": 1911, "verse_number": "५-१५६-३", "content_sanskrit": "नहि जातु द्वयोर्बुद्धिः समा भवति कर्हिचित् ।\nशौर्यं च वलनेतॄणां स्पर्धते च परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2041013, "chapter_id": 1911, "verse_number": "५-१५६-४", "content_sanskrit": "श्रूयते च महाप्राज्ञ हैहयानमितौजसः ।\nअभ्ययुर्ब्राह्मणाः सर्वे समुच्छ्रितकुशध्वजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2041014, "chapter_id": 1911, "verse_number": "५-१५६-५", "content_sanskrit": "तानभ्ययुस्तदा वैश्याः शूद्राश्चैव पितामह ।\nएकतस्तु त्रयो वर्णा एकतः क्षत्रियर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2041015, "chapter_id": 1911, "verse_number": "५-१५६-६", "content_sanskrit": "ते स्म युद्धे प्रभज्यन्ते त्रयो वर्णाः पुनः पुनः ।\nक्षत्रियाश्च जयन्त्येव बहुलं चैकतो बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2041016, "chapter_id": 1911, "verse_number": "५-१५६-७", "content_sanskrit": "ततस्ते क्षत्रियानेव पप्रच्छुर्द्विचसत्तमाः ।\nतेभ्यः शशंसुर्धर्मज्ञा याथातथ्यं पितामह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2041017, "chapter_id": 1911, "verse_number": "५-१५६-८", "content_sanskrit": "वयमेकस्य श्रृणुमो महाबुद्धिमतो रणे ।\nभवन्तस्तु पृथक्सर्वे स्वबुद्धिवशवर्तिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2041018, "chapter_id": 1911, "verse_number": "५-१५६-९", "content_sanskrit": "ततस्ते ब्राह्मणाश्चक्रुरेकं सेनापतिं द्विजम्।\nनये सुकुशलं शूरमजयन्क्षत्रियांस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2041019, "chapter_id": 1911, "verse_number": "५-१५६-१०", "content_sanskrit": "एवं ये कुशलं शूरं हितेप्सितमकल्पषम्।\nसेनापतिं प्रकुर्वन्ति ते जयन्ति रणे रिपून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2041020, "chapter_id": 1911, "verse_number": "५-१५६-११", "content_sanskrit": "भवानुशनसा तुल्यो हितैषी च सदा मम।\nअसंहार्थः स्थितो धर्मे स नः सेनापतिर्भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2041021, "chapter_id": 1911, "verse_number": "५-१५६-१२", "content_sanskrit": "रश्मीवतामिवादित्यो वीरुधामिव चन्द्रमाः ।\nकुबेर इव यक्षाणां देवानामिव वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2041022, "chapter_id": 1911, "verse_number": "५-१५६-१३", "content_sanskrit": "पर्वतानां यथा मेरुः सुपर्णः पक्षिणां यथा।\nकुमार इव देवानां वसूनामिव हव्यवाट् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2041023, "chapter_id": 1911, "verse_number": "५-१५६-१४", "content_sanskrit": "भवता हि वयं गुप्ताः शत्रेणेव दिवौकसः ।\nअनाधृष्या भविष्यामस्त्रिदशानामपि ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2041024, "chapter_id": 1911, "verse_number": "५-१५६-१५", "content_sanskrit": "प्रयातु नो भवानग्रे देवानामिव पावकिः ।\nवयं त्वामनुयास्यामः सौरभेया इवर्षभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2041025, "chapter_id": 1911, "verse_number": "६-१५६-१६x", "content_sanskrit": "भीष्म उवाच। a", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2041026, "chapter_id": 1911, "verse_number": "५-१५६-१६", "content_sanskrit": "एवमेतन्महाबाहो यथा वदसि भारत।\nयथैव हि भवन्तो मे तथैव मम पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2041027, "chapter_id": 1911, "verse_number": "५-१५६-१७", "content_sanskrit": "अपि चैव मया श्रोयो वाच्यं तेषां नराधिप ।\nसंयोद्धव्यं तवार्थाय यथा मे समयः कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2041028, "chapter_id": 1911, "verse_number": "५-१५६-१८", "content_sanskrit": "न तु पश्यामि योद्धारमात्मनः सदृशं भुवि ।\nऋते तस्मान्नरव्याघ्रात्कुन्तीपुत्राद्धनञ्जयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2041029, "chapter_id": 1911, "verse_number": "५-१५६-१९", "content_sanskrit": "स हि वेद महाबुद्धिर्दिव्यान्यस्त्राण्यनेकशः ।\nन तु मां विवृतो युद्धे जातु युध्येत पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2041030, "chapter_id": 1911, "verse_number": "५-१५६-२०", "content_sanskrit": "अहं स च क्षणेनैव निर्मनुष्यमिदं जगत्।\nकुर्यावास्त्रबलेनैव ससुरासुरराक्षसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2041031, "chapter_id": 1911, "verse_number": "५-१५६-२१", "content_sanskrit": "न त्वेवोत्सादनीया मे पाण्डोः पुत्रा जनाधिप ।\nतस्माद्योधान्हनिष्यामि प्रयोगेणायुतं सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2041032, "chapter_id": 1911, "verse_number": "५-१५६-२२", "content_sanskrit": "एवमेषां फरिष्यामि निधनं कुरुनन्दन ।\nन चेत्ते मां हनिष्यन्ति पूर्वमेव समागमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2041033, "chapter_id": 1911, "verse_number": "५-१५६-२३", "content_sanskrit": "सेनापतिस्त्वहं राजन्समयेनापरेण ते।\nभविष्यामि यथाकामं तन्मे श्रोतुमिहार्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2041034, "chapter_id": 1911, "verse_number": "५-१५६-२४", "content_sanskrit": "कर्णो वा युध्यतां पूर्वमहं वा पृथिवीपते ।\nस्पर्धते हि सदात्यर्थं सूतपुत्रो मया रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2041035, "chapter_id": 1911, "verse_number": "५-१५६-२५x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2041036, "chapter_id": 1911, "verse_number": "५-१५६-२५", "content_sanskrit": "नाहं जीवति गाङ्गेये राजन्योत्स्ये कथंचन।\nहते भीष्मे तु योत्स्यामि सह गाण्डीवधन्वना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2041037, "chapter_id": 1911, "verse_number": "५-१५६-२६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2041038, "chapter_id": 1911, "verse_number": "५-१५६-२६", "content_sanskrit": "ततः सेनापतिं चक्रे विधिवद्भूरिदक्षिणम्।\nधृतराष्ट्रात्मजो भीष्मं सोऽभिषिक्तो व्यरोचत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2041039, "chapter_id": 1911, "verse_number": "५-१५६-२७", "content_sanskrit": "ततो भेरीश्च शङ्खांश्च शतशोऽथ सहस्रशः।\nवादयामासुव्यग्रा वादका राजशासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2041040, "chapter_id": 1911, "verse_number": "५-१५६-२८", "content_sanskrit": "सिंहनादाश्च विविधा वाहनानां च निःस्वनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2041041, "chapter_id": 1911, "verse_number": "५-१५६-२९", "content_sanskrit": "निर्घार्ताः पृथिवीकम्पा गजबृंहितनिःस्वनाः।\nआसंश्च सर्वयोधानां पातयन्तो मनांस्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2041042, "chapter_id": 1911, "verse_number": "५-१५६-३०", "content_sanskrit": "वाचश्चाप्यशरीरिण्यो दिवश्चोल्काः प्रपेदिरे।\nशिवाश्च भयवेदिन्यो नेदुर्दीप्ततरा भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2041043, "chapter_id": 1911, "verse_number": "५-१५६-३१", "content_sanskrit": "सैनापत्ये यदा राजा गाङ्गेयमभिषिक्तवान् ।\nतदैतान्युग्ररूपाणि बभूवुः शतशो नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2041044, "chapter_id": 1911, "verse_number": "५-१५६-३२", "content_sanskrit": "ततः सेनापतिं कृत्वा भीष्मं परबलार्दनम् ।\nवाचयित्वा द्विजश्रेष्ठान्गोभिर्निष्कैश्च भूरिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2041045, "chapter_id": 1911, "verse_number": "५-१५६-३३", "content_sanskrit": "वर्धमानो जयाशीर्भिर्निर्ययौ सैनिकैर्वृतः।\nआपगेयं पुरस्कृत्य भ्रातृभिः सहितस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2041046, "chapter_id": 1911, "verse_number": "५-१५६-३४", "content_sanskrit": "स्कन्धावारेण महता कुरुक्षेत्रं जगाम ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2041047, "chapter_id": 1911, "verse_number": "५-१५६-३५", "content_sanskrit": "परिक्रम्य कुरुक्षेत्रं कर्णेन सह कौरवः ।\nशिबिरं मापयामास समे देशे जनाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2041048, "chapter_id": 1911, "verse_number": "५-१५६-३६", "content_sanskrit": "मधुरानूषरे देशे प्रभूतयवसेन्धने।\nयथैव हास्तिनपुरं तद्वच्छिबिरमाबभौ ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2041049, "chapter_id": 1911, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि सैन्यनिर्याणपर्वणि षट्पञ्चाशदधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]