[{"id": 7000926000, "chapter_id": 20926, "verse_number": "७-१४-१", "content_sanskrit": "व्यास उवाच ।\nमार्गशीर्षे द्विजश्रेष्ठ महालक्ष्म्या समन्वितम् ।\nपूजयेदव्ययं विष्णुं भक्तिभावेन वैष्णवः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000926001, "chapter_id": 20926, "verse_number": "७-१४-२", "content_sanskrit": "म्लेच्छदेशे च विप्रेंद्र तथैव पतितालये ।\nदुर्गंधैश्च परिव्याप्ते स्थाने विष्णुं न पूज्येत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000926002, "chapter_id": 20926, "verse_number": "७-१४-३", "content_sanskrit": "पाखंडानां समीपे च महापातकिनां तथा ।\nअसत्यभाषिणां चैव न कुर्याद्विष्णुपूजनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000926003, "chapter_id": 20926, "verse_number": "७-१४-४", "content_sanskrit": "क्रंदतां सन्निधौ चापि कलहानपि कुर्वताम् ।\nतथोपहसतां स्थाने न कुर्यात्पूजनं हरेः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000926004, "chapter_id": 20926, "verse_number": "७-१४-५", "content_sanskrit": "प्रतिग्रहरतानां च स्थाने विष्णुं न पूजयेत् ।\nकृपणानां गृहे चैव परवित्ताभिलाषिणाम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000926005, "chapter_id": 20926, "verse_number": "७-१४-६", "content_sanskrit": "तथा कपटवृत्तीनां न कुर्याद्विष्णुपूजनम् ।\nनारायणार्चने विप्र परं भक्तिपरायणः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000926006, "chapter_id": 20926, "verse_number": "७-१४-७", "content_sanskrit": "अन्यचित्तं परित्यज्य हरिध्यानपरो भवेत् ।\nहाहाकारं च निश्वासं विस्मयं स द्विजोत्तम ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000926007, "chapter_id": 20926, "verse_number": "७-१४-८", "content_sanskrit": "पाखंडजनसंभाषं न कुर्याद्धरिपूजनम् ।\nअनन्यमानसो भूत्वा देवदेवं जगद्गुरुम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000926008, "chapter_id": 20926, "verse_number": "७-१४-९", "content_sanskrit": "भस्मन्यपि च यत्पुष्पं दीयते लभते हरौ ।\nचिंतागमशतश्रांतः शिलाचक्रेष्वपि द्विज ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000926009, "chapter_id": 20926, "verse_number": "७-१४-१०", "content_sanskrit": "पुष्पं ददाति यन्मर्त्यो न लभेदथ तत्प्रभुः ।\nअनन्यमानसो भूत्वा भक्त्या विष्णुं यजेद्बुधः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000926010, "chapter_id": 20926, "verse_number": "७-१४-११", "content_sanskrit": "भ्रांतचित्तेन यत्कर्म क्रियते तच्च निष्फलम् ।\nसर्वकर्म मनोधीनं मनोधीनं जगत्त्रयम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000926011, "chapter_id": 20926, "verse_number": "७-१४-१२", "content_sanskrit": "तस्मान्मनो दृढीकृत्य पूजयेत्कमलापतिम् ।\nपूजान्यत्र मनोऽन्यत्र भवेद्यस्य द्विजोत्तम ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000926012, "chapter_id": 20926, "verse_number": "७-१४-१३", "content_sanskrit": "न च तस्य फलेत्कार्यं कल्पकोटिशतैरपि ।\nयत्नाद्विहितशौचोऽपि विष्णुपूजापरोऽपि च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000926013, "chapter_id": 20926, "verse_number": "७-१४-१४", "content_sanskrit": "मनःशुद्धिविहीनश्चेच्चांडाल इव गम्यते ।\nअभक्त्या यत्तपस्तप्तं सुचिरं विधिना द्विज ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000926014, "chapter_id": 20926, "verse_number": "७-१४-१५", "content_sanskrit": "भवेन्निरर्थकं सर्वं केवलं कायशोधनम् ।\nमेरुप्रमाणकं स्वर्णं ब्राह्मणाय कुटुंबिने ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000926015, "chapter_id": 20926, "verse_number": "७-१४-१६", "content_sanskrit": "दत्तमभ्यर्थनाशाय अभक्त्या श्रेयसेऽपि च ।\nतस्मादेकमना भूत्वा भक्तिश्रद्धासमन्वितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000926016, "chapter_id": 20926, "verse_number": "७-१४-१७", "content_sanskrit": "सवास्तुकादि शाकं च दद्यात्सदसि वैष्णवे ।\nनारंगस्य फलं दिव्यं सुपक्वं यस्तु यच्छति ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000926017, "chapter_id": 20926, "verse_number": "७-१४-१८", "content_sanskrit": "केशवाय द्विजश्रेष्ठ सोऽस्माभिरभिपूज्यते ।\nयत्नेन नूतनं वस्तु प्रियं भगवतो हरेः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000926018, "chapter_id": 20926, "verse_number": "७-१४-१९", "content_sanskrit": "तदेवाग्रयणे मासि भक्त्या दद्यान्मुरारये ।\nपौषे मासि समायाते श्रीकृष्णं वरदं प्रभुम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000926019, "chapter_id": 20926, "verse_number": "७-१४-२०", "content_sanskrit": "देवमिक्षुरसैर्दिव्यैः स्नापयेद्वैष्णवो जनः ।\nयः स्नापयति विप्रेन्द्र विष्णुमिक्षुरसैः प्रभुम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000926020, "chapter_id": 20926, "verse_number": "७-१४-२१", "content_sanskrit": "इह भुंक्ते सुखं सर्वं मृतो यातीक्षुसागरम् ।\nयो दद्यादिक्षुनैवेद्यं देवदेवाय विष्णवे ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000926021, "chapter_id": 20926, "verse_number": "७-१४-२२", "content_sanskrit": "सोऽपि तत्फलमाप्नोति किमन्यैर्बहुभाषितैः ।\nसुदुग्धपृथुकं पौषे दधिभिर्वा समन्वितम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000926022, "chapter_id": 20926, "verse_number": "७-१४-२३", "content_sanskrit": "दत्वा मुरारये मर्त्यः सर्वान्कामानवाप्नुयात् ।\nसर्वैः पुरातनं वस्त्रं दूरीकृत्य मुरारये ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000926023, "chapter_id": 20926, "verse_number": "७-१४-२४", "content_sanskrit": "शीतस्य वारणार्थाय दद्याद्वस्त्रं च नूतनम् ।\nपौषसंक्रमणे विप्र सलक्ष्मीकाय विष्णवे ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000926024, "chapter_id": 20926, "verse_number": "७-१४-२५", "content_sanskrit": "दद्यान्मुमुक्षुर्मनुजो दशवर्णं च पीठकम् ।\nयस्तु शङ्खध्वनिं कुर्यात्संपूज्य कमलापतिम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000926025, "chapter_id": 20926, "verse_number": "७-१४-२६", "content_sanskrit": "तस्य पुण्यफलं वच्मि शृणु वत्स समाहितः ।\nअगम्यागमनाद्यैश्च विमुक्तः सर्वपातकैः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000926026, "chapter_id": 20926, "verse_number": "७-१४-२७", "content_sanskrit": "अंते विष्णुपुरं गत्वा विष्णुना सह मोदते ।\nवैनतेयांकितां घंण्टां यस्तु वादयते हरेः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000926027, "chapter_id": 20926, "verse_number": "७-१४-२८", "content_sanskrit": "पूजाकाले द्विजश्रेष्ठ तस्य पुण्यं वदाम्यहम् ।\nअभक्ष्यभक्षणाद्यैश्च विमुक्तः सर्वपातकैः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000926028, "chapter_id": 20926, "verse_number": "७-१४-२९", "content_sanskrit": "प्रयाति मंदिरं विष्णो रथमारुह्य शोभनम् ।\nतत्र भुक्त्वाखिलान्कामान्कल्पकोटिशतावधि ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000926029, "chapter_id": 20926, "verse_number": "७-१४-३०", "content_sanskrit": "पुनरागत्य धरणीं चतुर्वेदी द्विजोत्तमः ।\nतत्र भुक्त्वाखिलान्कामान्कल्पकोटिशतावधि ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000926030, "chapter_id": 20926, "verse_number": "७-१४-३१", "content_sanskrit": "पुनर्विष्णुपुरं गत्वा मोक्षं प्राप्नोत्यनुत्तमम् ।\nवीणां वादयते यस्तु पूजाकाले जगत्पतेः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000926031, "chapter_id": 20926, "verse_number": "७-१४-३२", "content_sanskrit": "पंडितानामग्रणीः स्यात्स मर्त्यः प्रतिजन्मनि ।\nमृदंगवाद्यकृद्यस्तु पूजायां कैटभद्विषः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000926032, "chapter_id": 20926, "verse_number": "७-१४-३३", "content_sanskrit": "तस्य प्रसन्नो भगवान्ददात्यभिमतं फलम् ।\nडमरुं डिडिमं चैव झर्झरीं मधुरीं तथा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000926033, "chapter_id": 20926, "verse_number": "७-१४-३४", "content_sanskrit": "पटहं दुंदुभिं चैव काहलं सिंधुवारकम् ।\nकांस्यं च करतालं च वेणुं वादयते तु यः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000926034, "chapter_id": 20926, "verse_number": "७-१४-३५", "content_sanskrit": "पूजाकाले महाविष्णोस्तस्य पुण्यं निशामय ।\nस्तेयार्थैः पातकैर्मुक्तो मंदिरं याति चक्रिणः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000926035, "chapter_id": 20926, "verse_number": "७-१४-३६", "content_sanskrit": "परमं ज्ञानमासाद्य तत्रैव परिमुच्यते ।\nकलशब्दं च यः कुर्यात्पूजाकाले जगद्गुरोः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000926036, "chapter_id": 20926, "verse_number": "७-१४-३७", "content_sanskrit": "मुखवाद्यं च विप्रेन्द्र तस्य पुण्यं मयोच्यते ।\nकोटिकोटिकुलैर्युक्तः प्रयाति मन्दिरं हरेः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000926037, "chapter_id": 20926, "verse_number": "७-१४-३८", "content_sanskrit": "ज्ञानमासाद्य तत्रैव मोक्षमक्षय्यमाप्नुयात् ।\nविष्णोरायतने यस्तु भक्तियुक्तः प्रनृत्यति ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000926038, "chapter_id": 20926, "verse_number": "७-१४-३९", "content_sanskrit": "स याति ब्राह्मणश्रेष्ठ तद्विष्णोः परमं पदम् ।\nयस्तु गायति गीतानि भक्त्या नारायणाग्रतः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000926039, "chapter_id": 20926, "verse_number": "७-१४-४०", "content_sanskrit": "स नृपत्वमवाप्नोति गन्धर्वाणां पुरेषु च ।\nस्तौति स्तोत्रैर्जगन्नाथं भक्त्या च वैष्णवो जनः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000926040, "chapter_id": 20926, "verse_number": "७-१४-४१", "content_sanskrit": "तस्य प्रसन्नो भगवान्सर्वान्कामान्प्रयच्छति ।\nमासेमासे हरिं यस्तु विधिनानेन पूजयेत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000926041, "chapter_id": 20926, "verse_number": "७-१४-४२", "content_sanskrit": "अचिरेणैव विप्रर्षे प्रसादयति सोऽच्युतः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000926042, "chapter_id": 20926, "verse_number": "७-१४-४३", "content_sanskrit": "जगदुदधिमिमं ये तर्तुमिच्छंति मर्त्याः प्रचुरतरगभीरं सर्वदुःखप्रदं च ।\nपरमपुरुषपादांभोजयुग्मं मनोज्ञं त्रिदशनिवह सेव्यंते च सर्वे यजंतु ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]