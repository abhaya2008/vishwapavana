[{"id": 7006314000, "chapter_id": 26314, "verse_number": "१-२४-१", "content_sanskrit": "मार्कण्डेय उवाच ब्रह्मदत्तस्य तनयः स विभ्राजस्त्वजायत ।\nयोगात्मा तपसा युक्तो विष्वक्सेन इति श्रुतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006314001, "chapter_id": 26314, "verse_number": "१-२४-२", "content_sanskrit": "कदाचिद् ब्रह्मदत्तस्तु भार्यया सहितो वने ।\nविजहार प्रहृष्टात्मा यथा शच्या शचीपतिः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006314002, "chapter_id": 26314, "verse_number": "१-२४-३", "content_sanskrit": "ततः पिपीलिकरुतं स शुश्राव नराधिपः ।\nकामिनीं कामिनस्तस्य याचतः क्रोशतो भृशम्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006314003, "chapter_id": 26314, "verse_number": "१-२४-४", "content_sanskrit": "श्रुत्वा तु याच्यमाना तां क्रुद्धां सूक्ष्मां पिपीलिकाम ।\nब्रह्मदत्तो महाहासमकस्मादेव चाहसत्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006314004, "chapter_id": 26314, "verse_number": "१-२४-५", "content_sanskrit": "ततः सा संनतिर्दीना व्रीडितेवाभवत्तदा ।\nनिराहारा बहुतिथं बभूव वरवर्णिनी ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006314005, "chapter_id": 26314, "verse_number": "१-२४-६", "content_sanskrit": "प्रसाद्यमाना भर्त्रा सा तमुवाच शुचिस्मिता ।\nत्वया च हसिता राजन् नाहं जीवितुमुत्सहे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006314006, "chapter_id": 26314, "verse_number": "१-२४-७", "content_sanskrit": "स तत्कारणमाचख्यौ न च सा श्रद्दधाति तत ।\nउवाच चैनं कुपिता नैष भावोऽस्ति मानुषे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006314007, "chapter_id": 26314, "verse_number": "१-२४-८", "content_sanskrit": "को वै पिपीलिकरुतं मानुषो वेत्तुमर्हति ।\nऋते देवप्रसादाद् वा पूर्वजातिकृतेन वा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006314008, "chapter_id": 26314, "verse_number": "१-२४-९", "content_sanskrit": "तपोबलेन वा राजन् विद्यया वा नराधिप ।\nयद्येष वै प्रभावस्ते सर्वसत्त्वरुतज्ञता ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006314009, "chapter_id": 26314, "verse_number": "१-२४-१०", "content_sanskrit": "यथाहमेतज्जानीयां तथा प्रत्याययस्व माम ।\nप्राणान् वापि परित्यक्ष्ये राजन् सत्येन ते शपे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006314010, "chapter_id": 26314, "verse_number": "१-२४-११", "content_sanskrit": "तत् तस्या वचनं श्रुत्वा महिष्याः परुषाक्षरम् ।\nस राजा परमापन्नो देवश्रेष्ठमगात् ततः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006314011, "chapter_id": 26314, "verse_number": "१-२४-१२", "content_sanskrit": "शरण्यं सर्वभूतेशं भक्त्या नारायणं हरिम् ।\nसमाहितो निराहारः षड्रात्रेण महायशाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006314012, "chapter_id": 26314, "verse_number": "१-२४-१३", "content_sanskrit": "ददर्श दर्शने राजा देवं नारायणं प्रभुम ।\nउवाच चैनं भगवान् सर्वभूतानुकम्पकः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006314013, "chapter_id": 26314, "verse_number": "१-२४-१४", "content_sanskrit": "ब्रह्मदत्त प्रभाते त्वं कल्याणं समवाप्स्यसि ।\nइत्युक्त्वा भगवान् देवस्तत्रैवान्तरधीयत ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006314014, "chapter_id": 26314, "verse_number": "१-२४-१५", "content_sanskrit": "चतुर्णां तु पिता योऽसौ ब्राह्मणानां महात्मनाम ।\nश्लोकं सोऽधीत्य पुत्रेभ्यः कृतकृत्य इवाभवत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006314015, "chapter_id": 26314, "verse_number": "१-२४-१६", "content_sanskrit": "स राजानमथान्विच्छन्सहमन्त्रिणमच्युतम ।\nन ददर्शान्तरं किंचिच्छ्लोकं श्रावयितुं तदा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006314016, "chapter_id": 26314, "verse_number": "१-२४-१७", "content_sanskrit": "अथ राजा सरःस्नातो लब्ध्वा लब्ध्वा नारायणाद्वरम ।\nप्रविवेश पुरीं प्रीतो रथमारुह्य काञ्चनम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006314017, "chapter_id": 26314, "verse_number": "१-२४-१८", "content_sanskrit": "तस्य रश्मीन्प्रत्यगृह्णात्कण्डरीको द्विजर्षभः ।\nचामरं व्यजनं चापि बाभ्रव्यः समवाक्षिपत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006314018, "chapter_id": 26314, "verse_number": "१-२४-१९", "content_sanskrit": "इदमन्तरमित्येव ततः स ब्राह्मणस्तदा ।\nश्रावयामास राजानं श्लोकं तं सचिवौ च तौ ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006314019, "chapter_id": 26314, "verse_number": "१-२४-२०", "content_sanskrit": "सप्त व्याधा दशार्णेषु मृगाः कालञ्जरे गिरौ ।\nचक्रवाकाः शरद्वीपे हंसाः सरसि मानसे ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006314020, "chapter_id": 26314, "verse_number": "१-२४-२१", "content_sanskrit": "तेऽभिजाताः कुरुक्षेत्रे ब्राह्मणा वेदपारगाः ।\nप्रस्थिता दीर्घमध्वानं यूयं किमवसीदथ ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006314021, "chapter_id": 26314, "verse_number": "१-२४-२२", "content_sanskrit": "तच्छ्रुत्वा मोहमगमद् ब्रह्मदत्तो नराधिपः ।\nसचिवश्चास्य पाञ्चाल्यः कण्डरीकश्च भारत ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006314022, "chapter_id": 26314, "verse_number": "१-२४-२३", "content_sanskrit": "स्रस्तरश्मिप्रतोदौ तौ पतितव्यञ्जनावुभौ ।\nदृष्ट्वा बभूवुरस्वस्थाः पौराश्च सुहृदस्तथा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006314023, "chapter_id": 26314, "verse_number": "१-२४-२४", "content_sanskrit": "मुहूर्तमेव राजा स सह ताभ्यां रथे स्थितः ।\nप्रतिलभ्य ततः संगं प्रत्यागच्छदरिंदमः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006314024, "chapter_id": 26314, "verse_number": "१-२४-२५", "content_sanskrit": "ततस्ते तत्सरः स्मृत्वा योगं तमुपलभ्य च ।\nब्राह्मणं विपुलैरर्थैर्भोगैश्च समयोजयन् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006314025, "chapter_id": 26314, "verse_number": "१-२४-२६", "content_sanskrit": "अभिषिच्य स्वराज्ये तु विष्वक्सेनमरिंदमम् ।\nजगाम ब्रह्मदत्तोऽथ सदारो वनमेव ह ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006314026, "chapter_id": 26314, "verse_number": "१-२४-२७", "content_sanskrit": "अथैनं संनतिर्धीरा देवलस्य सुता तदा ।\nउवाच परमप्रीता योगाद् वनगतं नृपम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006314027, "chapter_id": 26314, "verse_number": "१-२४-२८", "content_sanskrit": "जानन्त्या ते महाराज पिपीलिकरुतज्ञताम् ।\nचोदितः क्रोधमुद्दिश्य सक्तः कामेषु वै मया ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006314028, "chapter_id": 26314, "verse_number": "१-२४-२९", "content_sanskrit": "इतो वयं गमिष्यामो गतिमिष्टामनुत्तमाम् ।\nतव चान्तर्हितो योगस्ततः संस्मारितो मया ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006314029, "chapter_id": 26314, "verse_number": "१-२४-३०", "content_sanskrit": "स राजा परमप्रीतः पत्न्याः श्रुत्वा वचस्तदा ।\nप्राप्य योगं बलादेव गतिं प्राप सुदुर्लभाम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006314030, "chapter_id": 26314, "verse_number": "१-२४-३१", "content_sanskrit": "कण्डरीकोऽपि धर्मात्मा सांख्ययोगमनुत्तमम् ।\nप्राप्य योगगतिं सिद्धो विशुद्धस्तेन कर्मणा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006314031, "chapter_id": 26314, "verse_number": "१-२४-३२", "content_sanskrit": "क्रमं प्रणीय पाञ्चाल्यः शिक्षां चोत्पाद्य केवलाम् ।\nयोगाचार्यगतिं प्राप यशश्चाग्र्यं महातपाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006314032, "chapter_id": 26314, "verse_number": "१-२४-३३", "content_sanskrit": "एवमेतत् पुरावृत्तं मम प्रत्यक्षमच्युत ।\nतद् धारयस्व गाङ्गेय श्रेयसा योक्ष्यसे ततः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006314033, "chapter_id": 26314, "verse_number": "१-२४-३४", "content_sanskrit": "ये चान्ये धारयिष्यन्ति तेषां चरितमुत्तमम् ।\nतिर्यग्योनिषु ते जातु न गमिष्यन्ति कर्हिचित् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006314034, "chapter_id": 26314, "verse_number": "१-२४-३५", "content_sanskrit": "श्रुत्वा चेदमुपाख्यानं महार्थं महतां गतिम् ।\nयोगधर्मो हृदि सदा परिवर्तति भारत ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006314035, "chapter_id": 26314, "verse_number": "१-२४-३६", "content_sanskrit": "स तेनैवानुबन्धेन कदाचिल्लभते शमम् ।\nततो योगगतिं याति शुद्धां तां भुवि दुर्लभाम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006314036, "chapter_id": 26314, "verse_number": "१-२४-३७", "content_sanskrit": "वैशम्पायन उवाच एवमेतत् पुरा गीतं मार्कण्डेयेन धीमता ।\nश्राद्धस्य फलमुद्दिश्य सोमस्याप्यायनाय वै ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006314037, "chapter_id": 26314, "verse_number": "१-२४-३८", "content_sanskrit": "सोमो हि भगवान् देवो लोकस्याप्यायनं परम् ।\nवृष्णिवंशप्रसङ्गेन तस्य वंशं निबोध मे ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]