[{"id": 2013117, "chapter_id": 1270, "verse_number": "२-११-१", "content_sanskrit": "नारद उवाच॥\nपितामहसभां तात कथ्यमानां निबोध मे।\nशक्यते या न निर्देष्टुमेवंरूपेति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2013118, "chapter_id": 1270, "verse_number": "२-११-२", "content_sanskrit": "पुरा देवयुगे राजन्नादित्यो भगवान्दिवः।\nआगच्छन्मानुषं लोकं दिदृक्षुर्विगतक्लमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2013119, "chapter_id": 1270, "verse_number": "२-११-३", "content_sanskrit": "चरन्मानुषरूपेण सभां दृष्ट्वा स्वयम्भुवः।\nस तामकथयन्मह्यं दृष्ट्वा तत्त्वेन पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2013120, "chapter_id": 1270, "verse_number": "२-११-४", "content_sanskrit": "अप्रमेयां सभां दिव्यां मानसीं भरतर्षभ।\nअनिर्देश्यां प्रभावेण सर्वभूतमनोरमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2013121, "chapter_id": 1270, "verse_number": "२-११-५", "content_sanskrit": "श्रुत्वा गुणानहं तस्याः सभायाः पाण्डवर्षभ।\nदर्शनेप्सुस्तथा राजन्नादित्यमिदमब्रुवम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2013122, "chapter_id": 1270, "verse_number": "२-११-६", "content_sanskrit": "भगवन्द्रष्टुमिच्छामि पितामहसभां शुभाम्।\nयेन वा तपसा शक्या कर्मणा वाऽपि गोपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2013123, "chapter_id": 1270, "verse_number": "२-११-७", "content_sanskrit": "औषधैर्या तथा युक्तैरुत्तमा पापनाशिनी।\nतन्ममाचक्ष्व भगवन्पश्येयं तां सभां यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2013124, "chapter_id": 1270, "verse_number": "२-११-८", "content_sanskrit": "स तन्मम वचः श्रुत्वा सहस्रांशुर्दिवाकरः।\nप्रोवाच भारतश्रेष्ठ व्रतं वर्षसहस्रकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2013125, "chapter_id": 1270, "verse_number": "२-११-९", "content_sanskrit": "ब्रह्मव्रतमुपास्स्व त्वं प्रयतेनान्तरात्मना।\nततोऽहं हिमवत्पृष्ठे समारब्दो महाव्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2013126, "chapter_id": 1270, "verse_number": "२-११-१०", "content_sanskrit": "ततः स भगवान्सूर्यो मामुपादाय वीर्यवान्।\nआगच्छत्तां सभां ब्राह्मीं विपाप्मा विगतक्लमः ?", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2013127, "chapter_id": 1270, "verse_number": "२-११-११", "content_sanskrit": "एवंरूपेति सा शक्या न निर्देष्टुं नराधिप।\nक्षणेन हि बिभर्त्यन्यदनिर्देश्यं वपुस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2013128, "chapter_id": 1270, "verse_number": "२-११-१२", "content_sanskrit": "न वेद परिमाणं वा संस्थानं चापि भारत।\nन च रूपं मया तादृक् दृष्टपूर्वं कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2013129, "chapter_id": 1270, "verse_number": "२-११-१३", "content_sanskrit": "सुसुखा सा सदा राजन्न शीता न च घर्मदा।\nन क्षुत्पिपासे न ग्लानिं प्राप्यतां प्राप्तुवन्त्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2013130, "chapter_id": 1270, "verse_number": "२-११-१४", "content_sanskrit": "नानारूपैरिव कृता मणिभिः सा सुभास्वरैः।\nस्तम्भैर्न च धृता सा तु शाश्वती न च सा क्षरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2013131, "chapter_id": 1270, "verse_number": "२-११-१५", "content_sanskrit": "दिव्यैर्नानाविधैर्भावैर्भासद्भिरमितप्रभैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2013132, "chapter_id": 1270, "verse_number": "२-११-१६", "content_sanskrit": "अति चन्द्रं च सूर्यं च शिखिनं च स्वयम्प्रभा।\nदीप्यते नाकपृष्ठस्था भर्त्सयन्वीव भास्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2013133, "chapter_id": 1270, "verse_number": "२-११-१७", "content_sanskrit": "तस्यां स भगवानास्ते विदधद्देवमायया।\nस्वयमेकोऽनिशं राजन्सर्वलोकपितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2013134, "chapter_id": 1270, "verse_number": "२-११-१८", "content_sanskrit": "उपतिष्ठन्ति चाप्येनं प्रजानां पतयः प्रभुम्।\nदक्षः प्रचेताः पुलहो मरीचिः कश्यपः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2013135, "chapter_id": 1270, "verse_number": "२-११-१९", "content_sanskrit": "भृगुरत्रिर्वसिष्ठश्च गौतमोऽथ तथाङ्गिराः।\nपुलस्त्यश्च कतुश्चैव प्रह्लादः कर्दमस्तथा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2013136, "chapter_id": 1270, "verse_number": "२-११-२०", "content_sanskrit": "अथर्वाङ्गिरसश्चैव वालखिल्या सरीचिपाः।\nमनोऽन्तरिक्षं विद्याश्च वायुस्तेजो जलं मही॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2013137, "chapter_id": 1270, "verse_number": "२-११-२१", "content_sanskrit": "शब्दस्पर्शौ तथा रूपं रसो गन्धश्च भारत।\nप्रकृतिश्च विकारश्च यच्चान्यत्कारणं भुवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2013138, "chapter_id": 1270, "verse_number": "२-११-२२", "content_sanskrit": "अगस्त्यश्च महातेजा मार्कण्डेयश्च वीर्यवान्।\nजमदग्निर्भरद्वाजः संवर्तश्च्यवनस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2013139, "chapter_id": 1270, "verse_number": "२-११-२३", "content_sanskrit": "दुर्वासाश्च महाभाग ऋष्णशृङ्गश्च धार्मिकः।\nसनत्कुमारो भगवान्योगाचार्यो महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2013140, "chapter_id": 1270, "verse_number": "२-११-२४", "content_sanskrit": "असितो देवलश्चैव जैगीषव्यश्च तत्त्ववित्।\nऋषभो जितशत्रुश्च महावीर्यस्तथा मणिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2013141, "chapter_id": 1270, "verse_number": "२-११-२५", "content_sanskrit": "आयुर्वेदस्तथाऽष्टाङ्गो देहवांस्तत्र भारत।\nचन्द्रमाः सह नक्षत्रैरादित्यश्च गभस्तिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2013142, "chapter_id": 1270, "verse_number": "२-११-२६", "content_sanskrit": "वायवः क्रतवश्चैव सङ्कल्पः प्राण एव च।\nमूर्तिमन्तो महात्मानो महाव्रतपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2013143, "chapter_id": 1270, "verse_number": "२-११-२७", "content_sanskrit": "एते चान्ये च बहवो ब्रह्माणं समुपस्थिताः।\nअर्थो धर्मश्च कामश्च हर्षो द्वेषस्तपो दमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2013144, "chapter_id": 1270, "verse_number": "२-११-२८", "content_sanskrit": "आयान्ति तस्यां सहिता गन्धर्वाप्सरसां गणाः।\nविंशतिः सप्त चैवान्ये लोकपालाश्च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2013145, "chapter_id": 1270, "verse_number": "२-११-२९", "content_sanskrit": "शुक्रो बृहस्पतिश्चैव बुधोऽङ्कारक एव च।\nशनैश्चरश्च राहुश्च ग्रहाः सर्वे तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2013146, "chapter_id": 1270, "verse_number": "२-११-३०", "content_sanskrit": "मन्त्रो रथन्तरं चैव हरिमान्वसुमानपि।\nआदित्याः साधिराजानो नामद्वन्द्वैरुदाहृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2013147, "chapter_id": 1270, "verse_number": "२-११-३१", "content_sanskrit": "मरुतो विश्वकर्मा च वसवश्चैव भारत।\nतथा पितृगणाः सर्वे सर्वाणि च हवींष्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2013148, "chapter_id": 1270, "verse_number": "२-११-३२", "content_sanskrit": "ऋग्वेदः सामवेदश्च यजुर्वेदश्च पाण्डव।\nअथर्ववेदश्च तथा सर्वशास्त्राणि चैव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2013149, "chapter_id": 1270, "verse_number": "२-११-३३", "content_sanskrit": "इतिहासोपवेदाश्च वेदाङ्गानि च सर्वशः।\nग्रहा यज्ञाश्च सोमश्च देवताश्चापि सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2013150, "chapter_id": 1270, "verse_number": "२-११-३४", "content_sanskrit": "सावित्री दुर्गतरणी वाणी सप्तविधा तथा।\nमेधा धृतिः श्रुतिश्चैव प्रज्ञा बुद्धिर्यशः क्षमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2013151, "chapter_id": 1270, "verse_number": "२-११-३५", "content_sanskrit": "सामानि स्तुतिशस्त्राणि गाथाश्च विविधास्तथा।\nभाष्याणि तर्कयुक्तानि देहवन्ति विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2013152, "chapter_id": 1270, "verse_number": "२-११-३६", "content_sanskrit": "नाटका विविधाः काव्याः कथाख्यायिकारिकाः ।\nतत्रतिष्ठन्ति ते पुण्या ये चान्ये गुरुपूजकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2013153, "chapter_id": 1270, "verse_number": "२-११-३७", "content_sanskrit": "क्षणा लवा मुहूर्ताश्च दिवा रात्रिस्तथैव च।\nअर्धमासाश्च मासाश्च ऋतवः षट् च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2013154, "chapter_id": 1270, "verse_number": "२-११-३८", "content_sanskrit": "संवत्सराः पञ्ययुगमहोरात्रश्चतुर्विधः।\nकालचक्रं च तद्दिव्यं नित्यमक्षयमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2013155, "chapter_id": 1270, "verse_number": "२-११-३९", "content_sanskrit": "धर्मचक्रं तथा चापि नित्यमास्ते युधिष्ठिर।\nअदितिर्दितिर्दनुश्चैव सुरसा विनता इरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2013156, "chapter_id": 1270, "verse_number": "२-११-४०", "content_sanskrit": "कालिका सुरभी देवी सरमा चाथ गौतमी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2013157, "chapter_id": 1270, "verse_number": "२-११-४१", "content_sanskrit": "प्रभा कद्रूश्च वै देव्यौ देवतानां च मातरः।\nरुद्राणी श्रीश्च लक्ष्मीश्च भद्रा षष्ठी तथाऽपरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2013158, "chapter_id": 1270, "verse_number": "२-११-४२", "content_sanskrit": "पृथिवी गां गता देवी ह्रीः स्वाहा कीर्तिरेव च।\nसुरा देवी शची चैव तथा पुष्टिररुन्धती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2013159, "chapter_id": 1270, "verse_number": "२-११-४३", "content_sanskrit": "संवृत्तिराशा नियतिः सृष्टिर्देवी रतिस्तथा।\nएताश्चान्याश्चवै देव्य उपतस्थुः प्रजापतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2013160, "chapter_id": 1270, "verse_number": "२-११-४४", "content_sanskrit": "आदित्या वसवो रुद्रा मरुतश्चास्विनावपि।\nविश्वेदेवाश्च साध्याश्च पितरश्च मनोजवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2013161, "chapter_id": 1270, "verse_number": "२-११-४५", "content_sanskrit": "पितृणां च गणान्विद्धि सप्तैव पुरुषर्षभ।\nमूर्तिमन्तो वै चत्वारस्त्रयश्चापि शरीरिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2013162, "chapter_id": 1270, "verse_number": "२-११-४६", "content_sanskrit": "वैराजश्च महाभागा अग्निष्वात्ताश्च भारत।\nगार्हपत्या नाकचराः पितरो लोकविश्रुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2013163, "chapter_id": 1270, "verse_number": "२-११-४७", "content_sanskrit": "सोमपा एकशृङ्गाश्च चतुर्वेदाः कलास्तथा।\nएते चतुर्षु वर्णेषु पूज्यन्ते पितरो नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2013164, "chapter_id": 1270, "verse_number": "२-११-४८", "content_sanskrit": "एतैराप्यायितैः पुर्वं सोमश्चाप्याय्यते पुनः।\nत एते पितरः सर्वे प्रजापतिमुपस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2013165, "chapter_id": 1270, "verse_number": "२-११-४९", "content_sanskrit": "उपासते च संहृष्टा ब्रह्माणममितौजसम्।\nराक्षसाश्च पिशाचाश्च दानवा गुह्यकास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2013166, "chapter_id": 1270, "verse_number": "२-११-५०", "content_sanskrit": "नागाः सुपर्णाः पशवः पितामहमुपासते।\nस्थावरा जङ्गमाश्चैव महाभूतास्तथाऽपरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2013167, "chapter_id": 1270, "verse_number": "२-११-५१", "content_sanskrit": "पुरन्दरश्च देवेन्द्रो वरुणो धनदो यमः।\nमहादेवः सहोमोऽत्र सदा गच्छति सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2013168, "chapter_id": 1270, "verse_number": "२-११-५२", "content_sanskrit": "महासेनश्च राजेन्द्र सदोपास्ते पितामहम्।\nदेवो नारायणस्तस्यां तथा देवर्षयश्च ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2013169, "chapter_id": 1270, "verse_number": "२-११-५३", "content_sanskrit": "ऋषयो वालखिल्याश्च योनिजायोनिजास्तथा।\nयच्च किञ्चित्रिलोकेऽस्मिन्दृश्यते स्थाणु जङ्गमम्।\nसर्वं तस्यां मया दृष्टमिति विद्धि नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2013170, "chapter_id": 1270, "verse_number": "२-११-५४", "content_sanskrit": "अष्टाशीतिसहस्राणि ऋषीणामूर्ध्वरेतसाम्।\nप्रजावतां च पञ्चाशदृषीणामपि पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2013171, "chapter_id": 1270, "verse_number": "२-११-५५", "content_sanskrit": "ते स्म तत्र यथाकामं दृष्ट्वा सर्वे दिवौकसः।\nप्रणम्य शिरसा तस्मै सर्वे यान्ति यथागमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2013172, "chapter_id": 1270, "verse_number": "२-११-५६", "content_sanskrit": "अतिथीनागतान्देवान्दैत्यान्नागांस्तथा द्विजान्।\nयक्षान्मुपर्णान्कालेयान्गन्धर्वाप्सरसस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2013173, "chapter_id": 1270, "verse_number": "२-११-५७", "content_sanskrit": "महाभागानमितधीर्ब्रह्मा लोकपितामहः।\nदयावान्सर्वभूतेषु यथार्हं प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2013174, "chapter_id": 1270, "verse_number": "२-११-५८", "content_sanskrit": "प्रतिगृह्य तु विश्वात्मा स्वयं स्वयम्भूरमितद्युतिः।\nसान्त्वमानार्थसम्भोगैर्युनक्ति मनुजाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2013175, "chapter_id": 1270, "verse_number": "२-११-५९", "content_sanskrit": "तथा तैरुपयातैश्च प्रतियद्भिश्च भारत।\nआकुला सा सभातात भवति स्म सुखप्रदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2013176, "chapter_id": 1270, "verse_number": "२-११-६०", "content_sanskrit": "सर्वतेजोमयी दिव्या ब्रह्मर्षिगणसेविता।\nब्राहया श्रिया दीप्यमाना शुशुभे विगतक्लमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2013177, "chapter_id": 1270, "verse_number": "२-११-६१", "content_sanskrit": "सा सभा तादृशी दृष्टा मया लोकेषु दुर्लभा।\nसभेयं राजशार्दूल मनुष्येषु यथा तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2013178, "chapter_id": 1270, "verse_number": "२-११-६२", "content_sanskrit": "एता मया दृष्टपूर्वाः सभा देवेषु भारत।\nसभेयं मानुषे लोके सर्वश्रेष्ठतमा तव॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2013179, "chapter_id": 1270, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि मन्त्रपर्वणि एकादशोऽध्यायः॥ ११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]