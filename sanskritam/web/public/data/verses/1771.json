[{"id": 2035625, "chapter_id": 1771, "verse_number": "५-१६-०x", "content_sanskrit": "बृहस्पतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2035626, "chapter_id": 1771, "verse_number": "५-१६-१", "content_sanskrit": "त्वमग्रे सर्वदेवानां मुखं त्वमसि हव्यवाट्।\nत्वमन्तः सर्वभूतानां गूढश्चरसि साक्षिवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2035627, "chapter_id": 1771, "verse_number": "५-१६-२", "content_sanskrit": "त्वामाहुरेकं कवयस्त्वामाहुस्त्रिविधं पुनः।\nत्वया त्यक्तं जगच्चेदं सद्यो नश्येद्धुताशन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2035628, "chapter_id": 1771, "verse_number": "५-१६-३", "content_sanskrit": "कृत्वा तुभ्यं नमो विप्राः स्वकर्मविजितां गतिम्।\nगच्छन्ति सह पत्नीभिः सुतैरपि च शाश्वतीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2035629, "chapter_id": 1771, "verse_number": "५-१६-४", "content_sanskrit": "त्वमेवाग्ने हव्यवाहस्त्वमेव परमं हविः।\nयजन्ति सत्रैस्त्वामेव यज्ञैश्च परमाध्वरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2035630, "chapter_id": 1771, "verse_number": "५-१६-५", "content_sanskrit": "सृष्ट्वा लोकांस्त्रीमिमान्हव्यवाह\nप्राप्ते काले पचसि पुनः समिद्धः ।\nत्वं सर्वस्य भुवनस्य प्रसूति-\nस्त्वमेवाग्रे भवसि पुनः प्रतिष्ठा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2035631, "chapter_id": 1771, "verse_number": "५-१६-६", "content_sanskrit": "त्वामग्ने जलदानाहुर्विद्युतश्च मनीषिणः।\nवहन्ति सर्वभूतानि त्वत्तो निष्क्रम्य हेतयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2035632, "chapter_id": 1771, "verse_number": "५-१६-७", "content_sanskrit": "त्वय्यापो निहिताः सर्वास्त्वयि सर्वमिदं जगत्।\nन तेऽस्त्यविदितं किचित्रिषु लोकेषु पावक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2035633, "chapter_id": 1771, "verse_number": "५-१६-८", "content_sanskrit": "स्वयोर्नि भजते सर्वो विशस्वापोऽविशङ्कितः।\nअहं त्वां वर्धयिष्यामि ब्राह्मैर्मन्त्रैः सनातनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2035634, "chapter_id": 1771, "verse_number": "५-१६-९", "content_sanskrit": "एवं स्तुतो हव्यवाट् स भगवान्कविरुत्तमः ।\nबृहस्पतिमथोवाच प्रीतिमान्वाक्यमुत्तमम्।\nदर्शयिष्यामि ते शक्रं सत्यमेतद्ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2035635, "chapter_id": 1771, "verse_number": "५-१६-१०x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2035636, "chapter_id": 1771, "verse_number": "५-१६-१०", "content_sanskrit": "प्रविष्यापस्ततो वह्निः ससमुद्राः सपल्वलाः।\nआससाद सरस्तच्च गूढो यत्र शतक्रतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2035637, "chapter_id": 1771, "verse_number": "५-१६-११", "content_sanskrit": "अथ तत्रापि पद्मानि विचिन्वन्भरतर्षभ ।\nअपश्यत्स तु देवेन्द्रं बिसमध्यगतं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2035638, "chapter_id": 1771, "verse_number": "५-१६-१२", "content_sanskrit": "आगत्य च ततस्तूर्णं तमाचष्ट बृहस्पतेः।\nअणुमात्रेण वपुषा पद्मतन्त्वाश्रितं प्रभुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2035639, "chapter_id": 1771, "verse_number": "५-१६-१३", "content_sanskrit": "गत्वा देवर्षिगन्धर्वैः सहितोऽथ बृहस्पतिः ।\nपुराणैः कर्मभिर्देवं तुष्टाव बलसूदनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2035640, "chapter_id": 1771, "verse_number": "५-१६-१४", "content_sanskrit": "महाऽसुरो हतः शक्र नमुचिर्दारुणस्त्वया ।\nशम्बरश्च बलश्चैव तथोभौ घोरविक्रमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2035641, "chapter_id": 1771, "verse_number": "५-१६-१५", "content_sanskrit": "शतक्रतो विवर्धस्व सर्वाञ्शत्रून्निषूदय ।\nउत्तिष्ठ शक्र संपश्य देवर्षीश्च समागतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2035642, "chapter_id": 1771, "verse_number": "५-१६-१६", "content_sanskrit": "महेन्द्र दानवान्हत्वा लोकास्त्रातास्त्वया विभो।\nअपां फेनं समासाद्य विष्णुतेजोतिबृंहितम्।\nत्वया वृत्रो हतः पूर्वं देवराज जगत्पते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2035643, "chapter_id": 1771, "verse_number": "५-१६-१७", "content_sanskrit": "त्वं सर्वभूतेषु शरण्य ईड्य-\nस्त्वया समं विद्यते नेह भूतम्।\nत्वया धार्यन्ते सर्वभूतानि शक्र\nत्वं देवानां महिमानं चकर्थ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2035644, "chapter_id": 1771, "verse_number": "५-१६-१८", "content_sanskrit": "पाहि सर्वांश्च लोकांश्च महेन्द्र बलमाप्नुहि ।\nएवं संस्तूयमानश्च सोऽवर्धत शनैः शनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2035645, "chapter_id": 1771, "verse_number": "५-१६-१९", "content_sanskrit": "स्वं चैव वपुरास्थाय बभूव स बलान्वितः।\nअब्रवीच्च गुरं देवो बृहस्पतिमवस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2035646, "chapter_id": 1771, "verse_number": "५-१६-२०", "content_sanskrit": "किं कार्यमवशिष्टं वो हतस्त्वाष्ट्रो महासुरः ।\nवृत्रश्च सुमहाकायो यो वै लोकाननाशयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2035647, "chapter_id": 1771, "verse_number": "५-१६-२१x", "content_sanskrit": "बृहस्पतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2035648, "chapter_id": 1771, "verse_number": "५-१६-२१", "content_sanskrit": "मानुषो नहुषो राजा देवर्षिगणतेजसा।\nदेवराज्यमनुप्राप्तः सर्वान्नो बाधते भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2035649, "chapter_id": 1771, "verse_number": "५-१६-२२x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2035650, "chapter_id": 1771, "verse_number": "५-१६-२२", "content_sanskrit": "कथं च नहुषो राज्यं देवानां प्राप दुर्लभम्।\nतपसा केन वा युक्तः किंवीर्यो वा बृहस्पते ।\n` तत्सर्वं कथय त्वं मे यथेन्द्रत्वमुपेयिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2035651, "chapter_id": 1771, "verse_number": "५-१६-२३x", "content_sanskrit": "बृहस्पतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2035652, "chapter_id": 1771, "verse_number": "५-१६-२३", "content_sanskrit": "त्वयि प्रनष्टे देवेश विश्वं प्रव्यथितं जगत्।\nपरस्परभयोद्विग्नं बभूवार्तमराजकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2035653, "chapter_id": 1771, "verse_number": "५-१६-२४", "content_sanskrit": "ततो देवैः सगन्धर्वैः सर्षिसङ्घैः सपावकैः ।\nमानुषो नहुषो राजा देवराज्येऽभिषेचितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2035654, "chapter_id": 1771, "verse_number": "५-१६-२५", "content_sanskrit": "देवा भीताः शक्रमकामयन्त\nत्वया त्यक्तं महदैन्द्रं पदं तत्।\nतदा देवाः पितरोऽथर्षयश्च\nगन्धर्वमुख्याश्च समेत्य सर्वे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2035655, "chapter_id": 1771, "verse_number": "५-१६-२६", "content_sanskrit": "गत्वाऽब्रुवन्नहुषं तत्र शक्र\nत्वं नो राजा भव भुवनस्य गोप्ता।\nतानब्रवीन्नहुषो नास्मि शक्त\nआप्यायध्वं तपसा तेजसा माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2035656, "chapter_id": 1771, "verse_number": "५-१६-२७", "content_sanskrit": "एवमुक्तैर्वर्द्धितश्चापि देवै\nराजाऽभवन्नहुषो घोरवीर्यः।\nत्रैलोक्ये च प्राप्य राज्यं महर्षी-\nन्कृत्वा वाहान्याति लोकान्दुरात्मा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2035657, "chapter_id": 1771, "verse_number": "५-१६-२८", "content_sanskrit": "तेजोहरं दृष्टिविषं सुघोरं\nमा त्वं पश्येर्नहुषं वै कदाचित्।\nदेवाश्च सर्वे नहुषं भृशार्ता\nन पश्यन्ते गूढरूपाश्चरन्तः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2035658, "chapter_id": 1771, "verse_number": "५-१६-२९x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2035659, "chapter_id": 1771, "verse_number": "५-१६-२९", "content_sanskrit": "एवं वदत्यङ्गिरसां वरिष्ठे\nबृहस्पतौ लोकपालः कुबेरः।\nवैवस्वतश्चैव यमः पुराणो\nदवेश्च सोमो वरुणश्चाजगाम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2035660, "chapter_id": 1771, "verse_number": "५-१६-३०", "content_sanskrit": "ते वै समागम्य महेन्द्रमूचु-\nर्दिष्ट्या त्वाष्ट्रो निहतश्चैव वृत्रः।\nदिष्ट्या च त्वां कुशलिनमक्षतं च\nपश्यामो वै निहतारिं च शक्र ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2035661, "chapter_id": 1771, "verse_number": "५-१६-३१", "content_sanskrit": "स तान्यथावच्च हि लोकपाला-\nन्समेत्स वै प्रीतमना महेन्द्रः।\nउवाच चैनान्प्रतिभाष्य शक्रः\nसंचोदयिष्यन्नहुषस्यान्तरेण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2035662, "chapter_id": 1771, "verse_number": "५-१६-३२", "content_sanskrit": "राजा देवानां नहुषो घोररूप-\nस्तत्र साह्यं दीयतां मे भवद्भिः ।\nते चाब्रुवन्नहुषो घोररूपो\nदृष्टीविषस्तस्य बिभीम ईश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2035663, "chapter_id": 1771, "verse_number": "५-१६-३३", "content_sanskrit": "त्वं चेद्राजानं नहुषं पराजये-\nस्ततो वयं भागमर्हाम शक्र।\nइन्द्रोऽब्रवीद्भवतु भवानपां पति-\nर्यमः कुबेरश्च मयाभिषेकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2035664, "chapter_id": 1771, "verse_number": "५-१६-३४", "content_sanskrit": "संप्राप्नुवन्त्वद्य सहैव दैवतै\nरिपुं जयाम तं नहुषं घोरदृष्टिम्।\nततः शक्रं ज्वलनोऽप्याह भाग\nप्रयच्छ मह्यं तव साह्यं करिष्ये।\nतमाह शक्रो भविताऽग्ने तवापि\nचेन्द्राग्न्योर्वै भाग एको महाक्रतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2035665, "chapter_id": 1771, "verse_number": "५-१६-३५x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2035666, "chapter_id": 1771, "verse_number": "५-१६-३५", "content_sanskrit": "एवं संचिन्त्य भगवान्महेन्द्रः पाकशासनः।\nकुबेरं सर्वयक्षाणां धनानां च प्रभुं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2035667, "chapter_id": 1771, "verse_number": "५-१६-३६", "content_sanskrit": "वैवस्वतं पितॄणां च वरुणं चाप्यपां तथा।\nआधिपत्यं ददौ शक्रः सत्कृत्य वरदस्तथा ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2035668, "chapter_id": 1771, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि सेनोद्योगपर्वणि षोडशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]