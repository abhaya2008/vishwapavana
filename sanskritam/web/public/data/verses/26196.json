[{"id": 7006196000, "chapter_id": 26196, "verse_number": "२-२४-१", "content_sanskrit": "वसिष्ठ उवाच इत्युक्तस्तेन भूपाल रामो मतिमतां वरः ।\nनिरूप्य मनसा भूयस्तमुवाचाभिविस्मितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006196001, "chapter_id": 26196, "verse_number": "२-२४-२", "content_sanskrit": "राम उवाच कस्त्वं ब्रूहि महाभाग न वै प्राकृतपूरुषः ।\nइन्द्रस्येवानुभावेन वपुरालक्ष्यते तव ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006196002, "chapter_id": 26196, "verse_number": "२-२४-३", "content_sanskrit": "विचित्रार्थपदौदार्यगुणगांभीर्यजातिभिः ।\nसर्वज्ञस्यैव ते वाणी श्रूयतेऽतिमनोहरा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006196003, "chapter_id": 26196, "verse_number": "२-२४-४", "content_sanskrit": "इन्द्रो वह्निर्यमो धाता वरुणो वा धनाधिपः ।\nईशानस्तपनो ब्रह्मा वायुः सोमो गुरुर्गुहः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006196004, "chapter_id": 26196, "verse_number": "२-२४-५", "content_sanskrit": "एषामन्यतमः प्रायो भवान्भवितुमर्हति ।\nअनुभावेन जातिस्ते हृदिशङ्कां तनोति मे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006196005, "chapter_id": 26196, "verse_number": "२-२४-६", "content_sanskrit": "मायावी भगवान्विष्णुः श्रूयते पुरुषोत्तमः ।\nको वा त्वं वपुषानेन ब्रूहि मां समुपागतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006196006, "chapter_id": 26196, "verse_number": "२-२४-७", "content_sanskrit": "अथ वा जगतां नाथः सर्वज्ञः परमेश्वरः ।\nपरमात्मात्मसंभूतिरात्मारामः सनातनः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006196007, "chapter_id": 26196, "verse_number": "२-२४-८", "content_sanskrit": "स्वच्छन्दचारी भगवाञ्छिवः सर्वजगन्मयः ।\nवपुषानेन संयुक्ते भवान्भवितुमर्हति ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006196008, "chapter_id": 26196, "verse_number": "२-२४-९", "content_sanskrit": "नान्यस्येदृग्भवेल्लोके प्रभावानुगतं वपुः ।\nजात्यर्थसौष्ठवोपेता वाणी चौदार्यशालिनी ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006196009, "chapter_id": 26196, "verse_number": "२-२४-१०", "content_sanskrit": "मन्येऽहं भक्तवात्सल्याद्वानेन वपुषाहरः ।\nप्रत्यक्षतामुपगतो संदेहोऽस्मत्परीक्षया ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006196010, "chapter_id": 26196, "verse_number": "२-२४-११", "content_sanskrit": "न केवलं भवान् व्याधस्तेषां नेदृग्विधाकृतिः ।\nतस्मात्तुभ्यं नमस्तस्मै सुरुपं संप्रदर्शय ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006196011, "chapter_id": 26196, "verse_number": "२-२४-१२", "content_sanskrit": "आविष्कुर्वन्प्रसीदात्ममहिमानुगुणं वपुः ।\nममानेकविधा शङ्कामुच्येत येन मानसी ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006196012, "chapter_id": 26196, "verse_number": "२-२४-१३", "content_sanskrit": "प्रसीद सर्वभावेन बुद्धिमोहौ ममाधुना ।\nप्रणाशय स्वरूपस्य ग्रहणादेव केवलम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006196013, "chapter_id": 26196, "verse_number": "२-२४-१४", "content_sanskrit": "प्रार्थयेत्वां महाभाग प्रणम्य शिरसासकृत् ।\nकस्त्वं मे दर्शयात्मानं बद्धोऽयं ते मयाञ्जलिः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006196014, "chapter_id": 26196, "verse_number": "२-२४-१५", "content_sanskrit": "इत्युक्त्वा तं महाभाग ज्ञातुमिच्छन्भृगूद्वहः ।\nउपविश्य ततो भूमौ ध्यानमास्ते समाहितः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006196015, "chapter_id": 26196, "verse_number": "२-२४-१६", "content_sanskrit": "बद्धपद्मासनो मौनी यतवाक्कायमानसः ।\nनिरुद्धप्राणसंचारो दध्यौ चिरमुदारधीः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006196016, "chapter_id": 26196, "verse_number": "२-२४-१७", "content_sanskrit": "सन्नियम्येन्द्रियग्रामं मनो हृदि निरुध्य च ।\nचिन्तयामास देवेशं ध्यानदृष्ट्या जगद्गुरुम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006196017, "chapter_id": 26196, "verse_number": "२-२४-१८", "content_sanskrit": "अपश्यच्च जगन्नाथमात्मसंधानचक्षुषा ।\nस्वभक्तानुग्रहकरं मृगव्याधस्वरूपिणम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006196018, "chapter_id": 26196, "verse_number": "२-२४-१९", "content_sanskrit": "तत उन्मील्य नयने शीघ्रमुत्थाय भार्गवः ।\nददर्श देवं तेनैव वपुषा पुरतः स्थितम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006196019, "chapter_id": 26196, "verse_number": "२-२४-२०", "content_sanskrit": "आत्मनोऽनुग्रहार्थाय शरण्यं भक्तवत्सलम् ।\nआविर्भूतं महाराज दृष्ट्वा रामः ससंभ्रमम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006196020, "chapter_id": 26196, "verse_number": "२-२४-२१", "content_sanskrit": "रोमाञ्छोद्भिन्नसर्वाङ्गो हर्षाश्रुप्लुतलोचनः ।\nपपात पादयोर्भूमौ भक्त्या तस्य महामतिः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006196021, "chapter_id": 26196, "verse_number": "२-२४-२२", "content_sanskrit": "स गद्गदमुवाचैनं संभ्रमाकुलया गिरा ।\nशरणं भव शर्वेति शङ्करेत्यसकृन्नृप ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006196022, "chapter_id": 26196, "verse_number": "२-२४-२३", "content_sanskrit": "ततः स्वरुपधृक्शंभुस्तद्भक्तिपरितोषितः ।\nराममुत्थापयामास प्रणा मावनतं भुवि ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006196023, "chapter_id": 26196, "verse_number": "२-२४-२४", "content_sanskrit": "उत्थापितो जगद्धात्रा स्वहस्ताभ्यां भृगूद्वहः ।\nतुष्टाव देवदेवेशं पुरः स्थित्वा कृताजलिः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006196024, "chapter_id": 26196, "verse_number": "२-२४-२५", "content_sanskrit": "राम उवाच नमस्ते देवदेवाय शङ्करायादिमूर्त्तये ।\nनमः शर्वाय शान्ताय शाश्वताय नमोनमः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006196025, "chapter_id": 26196, "verse_number": "२-२४-२६", "content_sanskrit": "नमस्ते नीलकण्ठाय नीललोहितमूर्त्तये ।\nनमस्ते भूतनाथाय भूतवासाय ते नमः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006196026, "chapter_id": 26196, "verse_number": "२-२४-२७", "content_sanskrit": "व्यक्ताव्यक्तस्वरूपाय महादेवाय मीढुषे ।\nशिवाय बहुरूपाय त्रिनेत्राय नमोनमः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006196027, "chapter_id": 26196, "verse_number": "२-२४-२८", "content_sanskrit": "शरणं भव मे शर्व त्वद्भक्तस्य जगत्पते ।\nभूयोऽनन्याश्रयाणां तु त्वमेव हि परायणम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006196028, "chapter_id": 26196, "verse_number": "२-२४-२९", "content_sanskrit": "यन्मयापकृतं देव दुरुक्तं वापि शङ्कर ।\nअजानता त्वां भगवन्मम तत्क्षन्तुमर्हसि ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006196029, "chapter_id": 26196, "verse_number": "२-२४-३०", "content_sanskrit": "अनन्यवेद्यरुपस्य सद्भावमिहकः पुमान् ।\nत्वामृते तव सर्वेश सम्यक्शक्रोति वेदितुम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006196030, "chapter_id": 26196, "verse_number": "२-२४-३१", "content_sanskrit": "तस्मात्त्वं सर्वभावेन प्रसीद मम शङ्कर ।\nनान्यास्ति मे गतिस्तुभ्यं नमो भूयो नमो नमः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006196031, "chapter_id": 26196, "verse_number": "२-२४-३२", "content_sanskrit": "वसिष्ठ उवाच इति संस्तूयमानस्तु कृताञ्जलिपुटं पुरः ।\nतिष्ठन्तमाह भगवान्प्रसन्नात्मा जगन्मयः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006196032, "chapter_id": 26196, "verse_number": "२-२४-३३", "content_sanskrit": "भगवानुवाच प्रीतोऽस्मि भवते तात तपसानेन सांप्रतम् ।\nभक्त्या चैवानपायिन्या ह्यपि भार्गवसत्तम ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006196033, "chapter_id": 26196, "verse_number": "२-२४-३४", "content_sanskrit": "दास्ये चाभि मतं सवे भवतेऽहं त्वया वृतम् ।\nभक्तो हि मे त्वमत्यर्थं नात्र कार्या विचारणा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006196034, "chapter_id": 26196, "verse_number": "२-२४-३५", "content_sanskrit": "मयैवावगतं सर्वं त्दृदि वत्तेऽद्यवर्त्तते ।\nतस्माद्ब्रवीमि यत्त्वाहं तत्कुरुष्वाविशङ्कितम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006196035, "chapter_id": 26196, "verse_number": "२-२४-३६", "content_sanskrit": "नास्त्राणां धारणे वत्स विद्यते शक्तिरद्य ते ।\nरौद्राणां तेन भूयोऽपि तपो घोरं समाचर ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006196036, "chapter_id": 26196, "verse_number": "२-२४-३७", "content_sanskrit": "परीत्य पृथिवीं सर्वां सर्वतीर्थेषु च क्रमात् ।\nस्रात्वा पवित्रदेहस्त्तवं सर्वाण्यस्त्राण्यवाप्स्यसि ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006196037, "chapter_id": 26196, "verse_number": "२-२४-३८", "content_sanskrit": "इत्युक्त्वान्तर्दधे देवस्तेनैव वपुषा विभुः ।\nरामस्य पश्यतो राजन्क्षणेन भवभागकृत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006196038, "chapter_id": 26196, "verse_number": "२-२४-३९", "content_sanskrit": "अन्तर्हिते जगन्नाथे रामो नत्वा तु शङ्करम् ।\nपरीत्यवसुधां सर्वां तीर्थस्नानेऽकरोन्मनः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006196039, "chapter_id": 26196, "verse_number": "२-२४-४०", "content_sanskrit": "ततः स पृथिवीं सर्वां परिक्रम्य यथाक्रमम् ।\nचकार सर्वतीर्थेषु स्नानं विधिवदात्मवान् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006196040, "chapter_id": 26196, "verse_number": "२-२४-४१", "content_sanskrit": "तीर्थेषु क्षेत्रमुख्येषु तथा देवालयेषु च ।\nपितॄन्देवांश्च विधिवदतर्पयदतन्द्रितः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006196041, "chapter_id": 26196, "verse_number": "२-२४-४२", "content_sanskrit": "उपवासतपोहोमजपस्नानादिसुक्रियाः ।\nतीर्थेषु विधिवत्कुर्वन्परिचक्राम मेदिनीम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006196042, "chapter_id": 26196, "verse_number": "२-२४-४३", "content_sanskrit": "एवं क्रमेण तीर्थेषु स्नात्वा चैव वसुंधराम् ।\nप्रदक्षिणीकृत्य शनैः शुद्धदेहोऽभवन्नृप ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006196043, "chapter_id": 26196, "verse_number": "२-२४-४४", "content_sanskrit": "परीत्यैवं वसुमतीं भार्गवः शंभुशासनात् ।\nजगां भूयस्तं देशं यत्र पूर्वमुवास सः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006196044, "chapter_id": 26196, "verse_number": "२-२४-४५", "content_sanskrit": "गत्वा राजन्सतत्रैव स्थित्वा देवमुमापतिम् ।\nभक्त्या संपूजयामास तपोभिर्न्नियमैरपि ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006196045, "chapter_id": 26196, "verse_number": "२-२४-४६", "content_sanskrit": "एतस्मिन्नेव काले तु देवानामसुरैः सह ।\nबभूव सुचिरं राजन्संग्रामो रोमहर्षणः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006196046, "chapter_id": 26196, "verse_number": "२-२४-४७", "content_sanskrit": "ततो देवान्पराजित्य युद्धेऽतिबलिनोऽसुराः ।\nअवापुरमरैश्वर्यमशेषमकुतोभयाः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006196047, "chapter_id": 26196, "verse_number": "२-२४-४८", "content_sanskrit": "युद्धे पराजिता देवाः सकला वासवादयः ।\nशङ्करं शरणं चग्मुर्हतैश्वर्या ह्यरातिभिः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006196048, "chapter_id": 26196, "verse_number": "२-२४-४९", "content_sanskrit": "तोषयित्वा जगन्नाथं प्रणामजय संस्तवैः ।\nप्रार्थयामासुरसुरान्हन्तुं देवाः पिनाकिनम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006196049, "chapter_id": 26196, "verse_number": "२-२४-५०", "content_sanskrit": "ततस्तेषां प्रतिश्रुत्य दानवानां वधं नृप ।\nदेवानां वरदः शंभुर्महो दरमुवाच ह ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006196050, "chapter_id": 26196, "verse_number": "२-२४-५१", "content_sanskrit": "हिमद्रेर्दक्षिणे भागे रामो नाम महातपाः ।\nमुनिपुत्रोऽतितेजस्वी मामुद्दिश्य तपस्यति ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006196051, "chapter_id": 26196, "verse_number": "२-२४-५२", "content_sanskrit": "तत्र गत्वात्वमद्यैव निवेद्य मम शासनम् ।\nमहोदर तपस्यन्तं तमिहानय माचिरम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006196052, "chapter_id": 26196, "verse_number": "२-२४-५३", "content_sanskrit": "इत्याज्ञप्रस्तथेत्युक्त्वा प्रणभ्येशं महोदरः ।\nजगाम वायुवेगेन यत्र रामो व्यवस्थितः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006196053, "chapter_id": 26196, "verse_number": "२-२४-५४", "content_sanskrit": "समासाद्य स तं देशं दृष्ट्वा रामं महामुनिम् ।\nतपस्यन्तमिदं वाक्यमुवाच विनयान्वितः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006196054, "chapter_id": 26196, "verse_number": "२-२४-५५", "content_sanskrit": "द्रष्टुमिच्छति शम्भुस्त्वां भृगुवर्यं तदाज्ञया ।\nआगतोऽहं तदागच्छ तत्पादांबुजसन्निधिम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006196055, "chapter_id": 26196, "verse_number": "२-२४-५६", "content_sanskrit": "तच्छ्रुत्वा वचनं तस्य शीघ्रमुत्थाय भार्गवः ।\nतदाज्ञां शिरसानन्द्य तथेति प्रत्यभाषत ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006196056, "chapter_id": 26196, "verse_number": "२-२४-५७", "content_sanskrit": "ततो रामं त्वरोपेतः शंभुपार्श्वं महोदरः ।\nप्रापयामास सहसा कैलासे नागसत्तमे ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006196057, "chapter_id": 26196, "verse_number": "२-२४-५८", "content_sanskrit": "सहितं सकलैर्भूतैरिन्द्राद्यैश्च सहामरैः ।\nददर्श भार्गवश्रेष्ठः शङ्करं भक्तवत्सलम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006196058, "chapter_id": 26196, "verse_number": "२-२४-५९", "content_sanskrit": "संस्तूयमानं मुनिभिर्नारदाद्यैस्तपोधनैः ।\nगन्धर्वैरुपगायद्भिर्नृत्यद्भिश्चाप्सरोगणैः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006196059, "chapter_id": 26196, "verse_number": "२-२४-६०", "content_sanskrit": "उपास्यमानं देवेशं गजचर्मधृताम्बरम् ।\nभस्मोद्धूलितसर्वाङ्गं त्रिनेत्रं चन्द्रशेखरम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006196060, "chapter_id": 26196, "verse_number": "२-२४-६१", "content_sanskrit": "धृतपिङ्गजटाभारं नागाभरमभूषितम् ।\nप्रलम्बोष्ठभुजं सौम्यं प्रसन्नमुखपङ्कजम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006196061, "chapter_id": 26196, "verse_number": "२-२४-६२", "content_sanskrit": "आस्थितं काञ्चने पट्टे गीर्वाणसमितौ नृप ।\nउपासर्पत्तु देवेशं भृगुवर्यः कृताञ्जलिः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006196062, "chapter_id": 26196, "verse_number": "२-२४-६३", "content_sanskrit": "श्रीकण्ठदर्शनोद्वत्तरोमाञ्चाञ्चितविग्रहः ।\nबाष्पत्तु सिक्तकायेन स तु गत्वा हरान्तिकम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006196063, "chapter_id": 26196, "verse_number": "२-२४-६४", "content_sanskrit": "भक्त्या ससंभ्रमं वाचा हर्षगद्गदयासकृत् ।\nनमस्ते देवदेवेति व्यालपन्नाकुलाक्षरम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006196064, "chapter_id": 26196, "verse_number": "२-२४-६५", "content_sanskrit": "पपात संस्पृशन्मूर्ध्ना चरणौ पुरविद्विषः ।\nपश्यतां देववृन्दानां मध्ये भृगुकुलोद्वहम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006196065, "chapter_id": 26196, "verse_number": "२-२४-६६", "content_sanskrit": "तमुत्थाप्य शिवः प्रीतः प्रसन्नमुखपङ्कजम् ।\nरामं मधुरया वाचा प्रहसन्नाह सादरम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006196066, "chapter_id": 26196, "verse_number": "२-२४-६७", "content_sanskrit": "इमे दैत्यगणैः क्रान्ताः स्वाधिष्ठानात्परिच्युताः ।\nअशक्रुवन्तस्तान्हन्तुं गीर्वाणा मामुपागताः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006196067, "chapter_id": 26196, "verse_number": "२-२४-६८", "content_sanskrit": "तस्मान्ममाज्ञया राम देवानां च प्रियेप्सया ।\nजहि दैत्यगणान्सर्वान्समर्थस्त्वं हि मे मतः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006196068, "chapter_id": 26196, "verse_number": "२-२४-६९", "content_sanskrit": "ततो रामोऽब्रवीच्छर्वं प्रणिपत्य कृताञ्जलिः ।\nशृण्वतां सर्वदेवानां सप्रश्रयमिदं वचः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006196069, "chapter_id": 26196, "verse_number": "२-२४-७०", "content_sanskrit": "स्वामिन्न विदितं किं ते सर्वज्ञस्याखिलात्मनः ।\nतथापि विज्ञापयतो वचनं मेऽवधारय ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006196070, "chapter_id": 26196, "verse_number": "२-२४-७१", "content_sanskrit": "यदि शक्रादिभिर्देवैरखिलैरमरारयः ।\nन शक्या हन्तुमेकस्य शक्याः स्यस्ते कथं मम ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006196071, "chapter_id": 26196, "verse_number": "२-२४-७२", "content_sanskrit": "अनस्त्रज्ञोऽस्मि देवेश युद्धानामप्यकोविदः ।\nकथं हनिष्ये सकलान्सुरशत्रूननायुधः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006196072, "chapter_id": 26196, "verse_number": "२-२४-७३", "content_sanskrit": "इत्युक्तस्तेन देवेशः सितं कालाग्निसप्रभम् ।\nशैवमस्त्रमयं तेजो ददौ तस्मै महात्मने ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006196073, "chapter_id": 26196, "verse_number": "२-२४-७४", "content_sanskrit": "आत्मीयं परशुं दत्वा सर्वशस्त्राभिभावकम् ।\nरामपाह प्रसन्नात्मा गीर्वाणानां तु शृण्वतम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006196074, "chapter_id": 26196, "verse_number": "२-२४-७५", "content_sanskrit": "मत्प्रसादेन सकलान्सुरशत्रून्विनिघ्नतः ।\nशक्तिर्भवतु ते सौम्य समस्तारिदुरासदा ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006196075, "chapter_id": 26196, "verse_number": "२-२४-७६", "content_sanskrit": "अनेनैवायुधेन त्वं गच्छ युध्यस्व शत्रुभिः ।\nस्वयमेव च वेत्सि त्वं यथावद्युद्धकौशलम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006196076, "chapter_id": 26196, "verse_number": "२-२४-७७", "content_sanskrit": "वसिष्ठ उवाच एवमुक्तस्ततो रामः शंभुना तं प्रणम्य च ।\nजग्राह परशुं शैव विबुधारिवधोद्यतः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006196077, "chapter_id": 26196, "verse_number": "२-२४-७८", "content_sanskrit": "ततः स शुशुभे रामो विष्णुतेर्ञ्जोऽशसंभवः ।\nरुद्रभक्त्या समायुक्तो द्युत्येव सवितुर्महः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006196078, "chapter_id": 26196, "verse_number": "२-२४-७९", "content_sanskrit": "सोऽनुज्ञातस्त्रिनेत्रेण देवैः सर्वैः समन्वितः ।\nजगाम हन्तुमसुरान्युद्धाय कृतनिश्चयः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006196079, "chapter_id": 26196, "verse_number": "२-२४-८०", "content_sanskrit": "ततोऽभवत्पुनर्युद्धं देवानामसुरैः सह ।\nत्रैलोक्यविजयोद्युक्तै राजन्नतिभयङ्करम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006196080, "chapter_id": 26196, "verse_number": "२-२४-८१", "content_sanskrit": "अथ रामो महाबाहुस्तस्मिन्युद्धे सुदारुणे ।\nकुद्धः परशुना तेन निजघान महासुरान् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006196081, "chapter_id": 26196, "verse_number": "२-२४-८२", "content_sanskrit": "प्रहारैरशनिप्रख्यैर्निघ्नन्दैत्यान्सहस्रशः ।\nचचार समरे रामः क्रुद्धः काल इवापरः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006196082, "chapter_id": 26196, "verse_number": "२-२४-८३", "content_sanskrit": "हत्वा तु सकलान्दैत्यान्देवान्सर्वानहर्षयत् ।\nक्षणेन नाशयामास रामः प्रहरतां वरः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006196083, "chapter_id": 26196, "verse_number": "२-२४-८४", "content_sanskrit": "रामेण हन्यमा नास्तु समस्ता दैत्यदानवाः ।\nददृशुः सर्वतो रामं हतशेषा भयान्विताः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006196084, "chapter_id": 26196, "verse_number": "२-२४-८५", "content_sanskrit": "हतेष्वसुरसंघेषु विद्रुतेषु च कृत्स्नशः ।\nराममामन्त्र्य विबुधाः प्रययुस्त्रिदिवं पुनः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006196085, "chapter_id": 26196, "verse_number": "२-२४-८६", "content_sanskrit": "रामोऽपि हत्वा दितिजानभ्यनुज्ञाप्य चामरान् ।\nस्वमाश्रमं समापेदे तपस्यासक्तमानसः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006196086, "chapter_id": 26196, "verse_number": "२-२४-८७", "content_sanskrit": "मृगव्याधप्रतिकृतिं कृत्वा शम्भोर्महामतिः ।\nभक्त्या संपूजयामास स तस्मिन्नाश्रमेवशी ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006196087, "chapter_id": 26196, "verse_number": "२-२४-८८", "content_sanskrit": "गन्धैः पुष्पैस्तथा हृद्यैर्नैवेद्यैरभिवन्दनैः ।\nस्तोत्रैश्च विधिवद्भक्त्या परां प्रीतिमुपानयत् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}]