[{"id": 40004445, "chapter_id": 8916, "verse_number": "1", "content_sanskrit": "कथयित्वा सुदुःखार्तस्सुमन्त्रेण चिरं सह। रामे दक्षिणकूलस्थे जगाम स्वगृहं गुहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40004446, "chapter_id": 8916, "verse_number": "2", "content_sanskrit": "भरद्वाजाभिगमनं प्रयागे च सहाऽसनम्। आगिरेर्गमनं तेषां तत्रस्थैरुपलक्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40004447, "chapter_id": 8916, "verse_number": "3", "content_sanskrit": "अनुज्ञातस्सुमन्त्रोऽथ योजयित्वा हयोत्तमान्। अयोध्यामेव नगरीं प्रययौ गाढदुर्मनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40004448, "chapter_id": 8916, "verse_number": "4", "content_sanskrit": "स वनानि सुगन्धीनि सरितश्च सरांसि च। पश्यन्नतिययौ शीघ्रं ग्रामाणि नगराणि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40004449, "chapter_id": 8916, "verse_number": "5", "content_sanskrit": "तत स्सायाह्न समये तृतीयेऽहनि सारथिः। अयोध्यां समनुप्राप्य निरानन्दां ददर्श ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40004450, "chapter_id": 8916, "verse_number": "6", "content_sanskrit": "स शून्यामिव निश्शब्दां दृष्ट्वा परमदुर्मनाः। सुमन्त्रश्चिन्तयामास शोकवेगसमाहतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40004451, "chapter_id": 8916, "verse_number": "7", "content_sanskrit": "कच्चिन्न सगजा साऽश्वा सजना सजनाधिपा। रामसन्तापदुःखेन दग्धा शोकाग्निना पुरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40004452, "chapter_id": 8916, "verse_number": "8", "content_sanskrit": "इति चिन्तापरस्सूतो वाजिभिश्शीघ्रपातिभिः। नगरद्वारमासाद्य त्वरितः प्रविवेश ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40004453, "chapter_id": 8916, "verse_number": "9", "content_sanskrit": "सुमन्त्रमभियान्तं तं शतशोऽथ सहस्रशः। क्व राम इति पृच्छन्तस्सूतमभ्यद्रवन्नराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40004454, "chapter_id": 8916, "verse_number": "10", "content_sanskrit": "तेषां शशंस गङ्गायामहमापृच्छ्य राघवम्। अनुज्ञातो निवृत्तोऽस्मि धार्मिकेण महात्माना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40004455, "chapter_id": 8916, "verse_number": "11", "content_sanskrit": "ते तीर्णा इति विज्ञाय बाष्पपूर्णमुखा जनाः। अहो धिगिति निश्श्वस्य हा रामेति च चुक्रुशुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40004456, "chapter_id": 8916, "verse_number": "12", "content_sanskrit": "शुश्राव च वचस्तेषां बृन्दं बृन्दं च तिष्ठताम्। हतास्म खलु ये नेह पश्याम इति राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40004457, "chapter_id": 8916, "verse_number": "13", "content_sanskrit": "दानयज्ञविवाहेषु समाजेषु महत्सु च। न द्रक्ष्यामः पुन र्जातु धार्मिकं राममन्तरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40004458, "chapter_id": 8916, "verse_number": "14", "content_sanskrit": "किं समर्थं जनस्यास्य किं प्रियं किं सुखावहम्। इति रामेण नगरं पितृवत्परिपालितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40004459, "chapter_id": 8916, "verse_number": "15", "content_sanskrit": "वातायनगतानां च स्त्रीणामन्वन्तरापणम्। रामशोकाभितप्तानां शुश्राव परिदेवनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40004460, "chapter_id": 8916, "verse_number": "16", "content_sanskrit": "स राजमार्गमध्येन सुमन्त्रः पिहिताननः। यत्र राजा दशरथस्तदेवोपययौ गृहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40004461, "chapter_id": 8916, "verse_number": "17", "content_sanskrit": "सोऽवतीर्य रथाच्छीघ्रं राजवेश्म प्रविश्य च। कक्ष्या स्सप्ताभिचक्राम महाजनसमाकुलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40004462, "chapter_id": 8916, "verse_number": "18", "content_sanskrit": "हर्म्यै र्विमानैः प्रासादैरवेक्ष्याथ समागतम्। हाहाकारकृता नार्यो रामदर्शनकर्शिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40004463, "chapter_id": 8916, "verse_number": "19", "content_sanskrit": "आयतैर्विमलैर्नेत्रैरश्रुवेगपरिप्लुतैः। अन्योन्यमभिवीक्षन्तेऽव्यक्तमार्ततराः स्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40004464, "chapter_id": 8916, "verse_number": "20", "content_sanskrit": "ततो दशरथस्त्रीणां प्रासादेभ्य स्तत स्ततः। रामशोकाभितप्तानां मन्दं शुश्राव जल्पितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40004465, "chapter_id": 8916, "verse_number": "21", "content_sanskrit": "सह रामेण निर्यातो विना राम मिहागतः। सूतः किन्नाम कौसल्यां शोचन्तीं प्रतिवक्ष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40004466, "chapter_id": 8916, "verse_number": "22", "content_sanskrit": "यथा च मन्ये दुर्जीवमेवं न सुकरं ध्रुवम्। आच्छिद्य पुत्रे निर्याते कौसल्या यत्र जीवति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40004467, "chapter_id": 8916, "verse_number": "23", "content_sanskrit": "सत्यरूपं तु तद्वाक्यं राज्ञ: स्त्रीणां निशामयन्। प्रदीप्तमिव शोकेन विवेश सहसा गृहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40004468, "chapter_id": 8916, "verse_number": "24", "content_sanskrit": "स प्रविश्याष्टमीं कक्ष्यां राजानं दीनमातुरम्। पुत्रशोकपरिम्लानमपश्यत्पाण्डुरे गृहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40004469, "chapter_id": 8916, "verse_number": "25", "content_sanskrit": "अभिगम्य तमासीनं नरेन्द्रे मभिवाद्य च। सुमन्त्रो रामवचनं यथोक्तं प्रत्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40004470, "chapter_id": 8916, "verse_number": "26", "content_sanskrit": "स तूष्णीमेव तच्छ्रुत्वा राजा विभ्रान्तचेतनः। मूर्छितो न्यपतद्भूमौ रामशोकाभिपीडितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40004471, "chapter_id": 8916, "verse_number": "27", "content_sanskrit": "ततोऽन्तःपुरमाविद्धं मूर्छिते पृथिवीपतौ। उद्धृत्य बाहू चुक्रोश नृपतौ पतितेक्षितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40004472, "chapter_id": 8916, "verse_number": "28", "content_sanskrit": "सुमित्रया तु सहिता कौसल्या पतितं पतिम्। उत्थापयामास तदा वचनं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40004473, "chapter_id": 8916, "verse_number": "29", "content_sanskrit": "इमं तस्य महाभाग दूतं दुष्करकारिणः। वनवासादनुप्राप्तं कस्मान्न प्रतिभाषसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40004474, "chapter_id": 8916, "verse_number": "30", "content_sanskrit": "अद्यैवमनयं कृत्वा व्यपत्रपसि राघव। उत्तिष्ठ सुकृतं तेस्तु शोके नस्या त्सहायता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40004475, "chapter_id": 8916, "verse_number": "31", "content_sanskrit": "देव यस्या भयाद्रामं नानुपृच्छसि सारथिम्। नेह तिष्ठिति कैकेयी विस्रब्धं प्रतिभाष्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40004476, "chapter_id": 8916, "verse_number": "32", "content_sanskrit": "सा तथोक्त्वा महाराजं कौसल्या शोकलालसा। धरण्यां निपपाताऽशु बाष्पविप्लुतभाषिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40004477, "chapter_id": 8916, "verse_number": "33", "content_sanskrit": "एवं विलपतीं दृष्ट्वा कौसल्यां पतितां भुवि। पतिं चावेक्ष्य ता स्सर्वा सुस्वरं रुरुदुः स्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40004478, "chapter_id": 8916, "verse_number": "34", "content_sanskrit": "तत स्तमन्तःपुरनादमुत्थितं समीक्ष्य वृद्धा स्तरुणाश्च मानवाः। स्त्रियश्च सर्वा रुरुदु स्समन्ततः पुरं तदासीत्पुनरेव सङ्कुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]