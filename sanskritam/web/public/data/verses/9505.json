[{"id": 5000505000, "chapter_id": 9505, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे अष्टनवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000505001, "chapter_id": 9505, "verse_number": "६-९८-१", "content_sanskrit": "महोदरे तु निहते महापार्श्वो महाबलः।\nसुग्रीवेण समीक्ष्याथ क्रोधात् संरक्तलोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000505002, "chapter_id": 9505, "verse_number": "६-९८-२", "content_sanskrit": "अङ्गदस्य चमूं भीमां क्षोभयामास मार्गणैः।\nस वानराणां मुख्यानामुत्तमाङ्गानि राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000505003, "chapter_id": 9505, "verse_number": "६-९८-३", "content_sanskrit": "पातयामास कायेभ्यः फलं वृन्तादिवानिलः।\nकेषांचिदिषुभिर्बाहूंश्चिच्छेदाथ स राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000505004, "chapter_id": 9505, "verse_number": "६-९८-४", "content_sanskrit": "वानराणां सुसंरब्धः पार्श्वं केषांचिदाक्षिपत्।\nतेऽर्दिता बाणवर्षेण महापार्श्वेन वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000505005, "chapter_id": 9505, "verse_number": "६-९८-५", "content_sanskrit": "विषादविमुखाः सर्वे बभूवुर्गतचेतसः।\nनिशम्य बलमुद्विग्नमङ्गदो राक्षसार्दितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000505006, "chapter_id": 9505, "verse_number": "६-९८-६", "content_sanskrit": "वेगं चक्रे महावेगः समुद्र इव पर्वसु।\nआयसं परिघं गृह्य सूर्यरश्मिसमप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000505007, "chapter_id": 9505, "verse_number": "६-९८-७", "content_sanskrit": "समरे वानरश्रेष्ठो महापार्श्वे न्यपातयत्।\nस तु तेन प्रहारेण महापार्श्वो विचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000505008, "chapter_id": 9505, "verse_number": "६-९८-८", "content_sanskrit": "ससूतः स्यन्दनात् तस्माद् विसंज्ञश्चापतद् भुवि।\nतस्यर्क्षराजस्तेजस्वी नीलाञ्जनचयोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000505009, "chapter_id": 9505, "verse_number": "६-९८-९", "content_sanskrit": "निष्पत्य सुमहावीर्यः स्वयूथान्मेघसंनिभात्।\nप्रगृह्य गिरिशृङ्गाभां क्रुद्धः स विपुलां शिलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000505010, "chapter_id": 9505, "verse_number": "६-९८-१०", "content_sanskrit": "अश्वाञ्जघान तरसा बभञ्ज स्यन्दनं च तम्।\nमुहूर्ताल्लब्धसंज्ञस्तु महापार्श्वो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000505011, "chapter_id": 9505, "verse_number": "६-९८-११", "content_sanskrit": "अङ्गदं बहुभिर्बाणैर्भूयस्तं प्रत्यविध्यत।\nजाम्बवन्तं त्रिभिर्बाणैराजघान स्तनान्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000505012, "chapter_id": 9505, "verse_number": "६-९८-१२", "content_sanskrit": "ऋक्षराजं गवाक्षं च जघान बहुभिः शरैः।\nगवाक्षं जाम्बवन्तं च स दृष्ट्वा शरपीडितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000505013, "chapter_id": 9505, "verse_number": "६-९८-१३", "content_sanskrit": "जग्राह परिघं घोरमङ्गदः क्रोधमूर्च्छितः।\nतस्याङ्गदः सरोषाक्षो राक्षसस्य तमायसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000505014, "chapter_id": 9505, "verse_number": "६-९८-१४", "content_sanskrit": "दूरस्थितस्य परिघं रविरश्मिसमप्रभम्।\nद्वाभ्यां भुजाभ्यां संगृह्य भ्रामयित्वा च वेगवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000505015, "chapter_id": 9505, "verse_number": "६-९८-१५", "content_sanskrit": "महापार्श्वस्य चिक्षेप वधार्थं वालिनः सुतः।\nस तु क्षिप्तो बलवता परिघस्तस्य रक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000505016, "chapter_id": 9505, "verse_number": "६-९८-१६", "content_sanskrit": "धनुश्च सशरं हस्ताच्छिरस्त्राणं च पातयत्।\nतं समासाद्य वेगेन वालिपुत्रः प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000505017, "chapter_id": 9505, "verse_number": "६-९८-१७", "content_sanskrit": "तलेनाभ्यहनत् क्रुद्धः कर्णमूले सकुण्डले।\nस तु क्रुद्धो महावेगो महापार्श्वो महाद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000505018, "chapter_id": 9505, "verse_number": "६-९८-१८", "content_sanskrit": "करेणैकेन जग्राह सुमहान्तं परश्वधम्।\nतं तैलधौतं विमलं शैलसारमयं दृढम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000505019, "chapter_id": 9505, "verse_number": "६-९८-१९", "content_sanskrit": "राक्षसः परमक्रुद्धो वालिपुत्रे न्यपातयत्।\nतेन वामांसफलके भृशं प्रत्यवपातितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000505020, "chapter_id": 9505, "verse_number": "६-९८-२०", "content_sanskrit": "अङ्गदो मोक्षयामास सरोषः स परश्वधम्।\nस वीरो वज्रसंकाशमङ्गदो मुष्टिमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000505021, "chapter_id": 9505, "verse_number": "६-९८-२१", "content_sanskrit": "संवर्तयत् सुसंक्रुद्धः पितुस्तुल्यपराक्रमः।\nराक्षसस्य स्तनाभ्याशे मर्मज्ञो हृदयं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000505022, "chapter_id": 9505, "verse_number": "६-९८-२२", "content_sanskrit": "इन्द्राशनिसमस्पर्शं स मुष्टिं विन्यपातयत्।\nतेन तस्य निपातेन राक्षसस्य महामृधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000505023, "chapter_id": 9505, "verse_number": "६-९८-२३", "content_sanskrit": "पफाल हृदयं चास्य स पपात हतो भुवि।\nतस्मिन् विनिहते भूमौ तत् सैन्यं सम्प्रचुक्षुभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000505024, "chapter_id": 9505, "verse_number": "६-९८-२४", "content_sanskrit": "अभवच्च महान् क्रोधः समरे रावणस्य तु।\nवानराणां प्रहृष्टानां सिंहनादः सुपुष्कलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000505025, "chapter_id": 9505, "verse_number": "६-९८-२५", "content_sanskrit": "स्फोटयन्निव शब्देन लङ्कां साट्टालगोपुराम्।\nसहेन्द्रेणेव देवानां नादः समभवन्महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000505026, "chapter_id": 9505, "verse_number": "६-९८-२६", "content_sanskrit": "अथेन्द्रशत्रुस्त्रिदशालयानां\nवनौकसां चैव महाप्रणादम्।\nश्रुत्वा सरोषं युधि राक्षसेन्द्रः\nपुनश्च युद्धाभिमुखोऽवतस्थे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000505027, "chapter_id": 9505, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे अष्टनवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]