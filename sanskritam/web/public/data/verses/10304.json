[{"id": 6000304000, "chapter_id": 10304, "verse_number": null, "content_sanskrit": "तृतीयाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000304001, "chapter_id": 10304, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.001.m4a", "display_order": 2}, {"id": 6000304002, "chapter_id": 10304, "verse_number": "११-३-१", "content_sanskrit": "परस्य विष्णोरीशस्य मायिनामपि मोहिनीम्।\nमायां वेदितुमिच्छामो भगवन्तो ब्रुवन्तु नः॥ ११/३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.002.m4a", "display_order": 3, "topics": [{"text": "निमिराजेन अन्तरिक्ष-प्रबुद्ध-पिप्पयलायन-आविर्होत्रान्प्रति कृतानां माया-तत्तरणोपाय-ब्रह्मस्वरूप-कर्मस्वरूप-विषयकाणां चतुर्णां प्रश्नानां तैः पृथक् पृथग् उत्तरदानम्", "range": "१–४८"}]}, {"id": 6000304003, "chapter_id": 10304, "verse_number": "११-३-२", "content_sanskrit": "नानुतृप्ये जुषन् युष्मद्वचो हरिकथामृतम्।\nसंसारतापनिष्टप्तो मर्त्यस्तत्तापभेषजम्॥ ११/३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.003.m4a", "display_order": 4}, {"id": 6000304004, "chapter_id": 10304, "verse_number": null, "content_sanskrit": "अन्तरिक्ष उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.004.m4a", "display_order": 5}, {"id": 6000304005, "chapter_id": 10304, "verse_number": "११-३-३", "content_sanskrit": "एभिर्भूतानि भूतात्मा महाभूतैर्महाभुज।\nससर्जोच्चावचान्यादौ स्वयमात्मप्रसिद्धये॥ ११/३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.005.m4a", "display_order": 6}, {"id": 6000304006, "chapter_id": 10304, "verse_number": "११-३-४", "content_sanskrit": "एवं सृष्ट्वा स भूतानि स्थविष्ठैः पञ्चधातुभिः।\nएकधा दशधाऽऽत्मानं विभजन् जुषते गुणान्॥ ११/३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.006.m4a", "display_order": 7}, {"id": 6000304007, "chapter_id": 10304, "verse_number": "११-३-५", "content_sanskrit": "गुणैर्गुणान् स भुञ्जान आत्मप्रद्योतितैः प्रभुः।\nमन्यमान इदं सृष्टमात्मानमिह सज्जते॥ ११/३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.007.m4a", "display_order": 8}, {"id": 6000304008, "chapter_id": 10304, "verse_number": "११-३-६", "content_sanskrit": "कर्माणि कर्मभिः कुर्वन् सनिमित्तानि देहभृत्।\nतत्तत्कर्मफलं गृह्णन् भ्रमतीह सुखेतरम्॥ ११/३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.008.m4a", "display_order": 9}, {"id": 6000304009, "chapter_id": 10304, "verse_number": "११-३-७", "content_sanskrit": "इत्थं कर्मगतीर्गच्छन् बह्वभद्रावहः पुमान्।\nआभूतसंप्लवात् स्वर्गप्रलयावश्नुतेऽवशः॥ ११/३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.009.m4a", "display_order": 10}, {"id": 6000304010, "chapter_id": 10304, "verse_number": "११-३-८", "content_sanskrit": "धातूपप्लव आसन्ने व्यक्तं द्रव्यगुणात्मकम्।\nअनादिनिधनः कालो ह्यव्यक्ताय विकर्षति॥ ११/३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.010.m4a", "display_order": 11}, {"id": 6000304011, "chapter_id": 10304, "verse_number": "११-३-९", "content_sanskrit": "शतवर्षमनावृष्टिर्भविष्यत्युल्बणा भुवि।\nतत्कालोपचितोष्णार्को लोकांस्‍त्रीन् प्रतपिष्यति॥ ११/३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.011.m4a", "display_order": 12}, {"id": 6000304012, "chapter_id": 10304, "verse_number": "११-३-१०", "content_sanskrit": "पातालतलमारभ्य सङ्कर्षणमुखानलः।\nदहन्नूर्ध्वशिखो विष्वग्वर्धते वायुनेरितः॥ ११/३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.012.m4a", "display_order": 13}, {"id": 6000304013, "chapter_id": 10304, "verse_number": "११-३-११", "content_sanskrit": "संवर्तको मेघगणो वर्षति स्म शतं समाः।\nधाराभिर्हस्तिहस्ताभिर्लीयते सलिले विराट्॥ ११/३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.013.m4a", "display_order": 14}, {"id": 6000304014, "chapter_id": 10304, "verse_number": "११-३-१२", "content_sanskrit": "ततो विराजमुत्सृज्य वैराजः पुरुषो नृप।\nअव्यक्तं विशति सूक्ष्मं निरिन्धन इवानलः॥ ११/३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.014.m4a", "display_order": 15}, {"id": 6000304015, "chapter_id": 10304, "verse_number": "११-३-१३", "content_sanskrit": "वारिणा हृतगन्धा भूः सलिलत्वाय कल्पते।\nसलिलं तद् हृतरसं ज्योतिष्ट्वायोपकल्पते॥ ११/३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.015.m4a", "display_order": 16}, {"id": 6000304016, "chapter_id": 10304, "verse_number": "११-३-१४", "content_sanskrit": "हृतरूपं तु तमसा वायौ ज्योतिः प्रलीयते।\nहृतस्पर्शोऽवकाशेन वायुर्नभसि लीयते॥ ११/३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.016.m4a", "display_order": 17}, {"id": 6000304017, "chapter_id": 10304, "verse_number": "११-३-१५", "content_sanskrit": "कालात्मना हृतगुणं नभ आत्मनि लीयते।\nइन्द्रियाणि मनो बुद्धिः सह वैकारिकैर्नृप॥ ११/३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.017.m4a", "display_order": 18}, {"id": 6000304018, "chapter_id": 10304, "verse_number": "११-३-१६", "content_sanskrit": "प्रविशन्ति ह्यहंकारं स्वगुणैरहमात्मनि॥ ११/३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.018.m4a", "display_order": 19}, {"id": 6000304019, "chapter_id": 10304, "verse_number": "११-३-१७", "content_sanskrit": "एषा माया भगवतः सर्गस्थित्यन्तकारिणी।\nत्रिवर्णा वर्णिताऽस्माभिः किं भूयः श्रोतुमिच्छसि॥ ११/३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.019.m4a", "display_order": 20}, {"id": 6000304020, "chapter_id": 10304, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.020.m4a", "display_order": 21}, {"id": 6000304021, "chapter_id": 10304, "verse_number": "११-३-१८", "content_sanskrit": "यथैतामैश्वरीं मायां दुस्तरामकृतात्मभिः।\nतरन्त्यञ्जः स्थूलधियो महर्ष इदमुच्यताम्॥ ११/३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.021.m4a", "display_order": 22}, {"id": 6000304022, "chapter_id": 10304, "verse_number": null, "content_sanskrit": "प्रबुद्ध उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.022.m4a", "display_order": 23}, {"id": 6000304023, "chapter_id": 10304, "verse_number": "११-३-१९", "content_sanskrit": "कर्माण्यारभमाणानां दुःखहत्यै सुखाय च।\nपश्येत् पाकविपर्यासं मिथुनीचारिणां नृणाम्॥ ११/३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.023.m4a", "display_order": 24}, {"id": 6000304024, "chapter_id": 10304, "verse_number": "११-३-२०", "content_sanskrit": "नित्यार्तिदेन वित्तेन दुर्लभेनात्ममृत्युना।\nगृहापत्याप्तपशुभिः का प्रीतिः साधितैश्चलैः॥ ११/३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.024.m4a", "display_order": 25}, {"id": 6000304025, "chapter_id": 10304, "verse_number": "११-३-२१", "content_sanskrit": "एवं लोकं परं विद्यान्नश्वरं कर्मनिर्मितम्।\nअतुल्यातिशयध्वंसाद् यथा मण्डलवर्तिनाम्॥ ११/३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.025.m4a", "display_order": 26}, {"id": 6000304026, "chapter_id": 10304, "verse_number": "११-३-२२", "content_sanskrit": "तस्माद् गुरुं प्रपद्येत जिज्ञासुः श्रेय उत्तमम्।\nशब्दे परे च निष्णातं ब्रह्मण्युपशमाश्रयम्॥ ११/३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.026.m4a", "display_order": 27}, {"id": 6000304027, "chapter_id": 10304, "verse_number": "११-३-२३", "content_sanskrit": "तत्र भागवतान् धर्मान् शिक्षेद् गुर्वात्मदैवतः।\nअमाययाऽनुवृत्त्या च तुष्येदात्माऽऽत्मदो हरिः॥ ११/३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.027.m4a", "display_order": 28}, {"id": 6000304028, "chapter_id": 10304, "verse_number": "११-३-२४", "content_sanskrit": "सर्वतो मनसोऽसङ्गमादौ सङ्गं च साधुषु।\nदयां मैत्रीं प्रश्रयं च भूतेष्वद्धा यथोचितम्॥ ११/३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.028.m4a", "display_order": 29}, {"id": 6000304029, "chapter_id": 10304, "verse_number": "११-३-२५", "content_sanskrit": "शौचं तपस्तितिक्षां च मौनं स्वाध्यायमार्जवम्।\nब्रह्मचर्यमहिंसां च समत्वं द्वन्द्वसंज्ञयोः॥ ११/३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.029.m4a", "display_order": 30}, {"id": 6000304030, "chapter_id": 10304, "verse_number": "११-३-२६", "content_sanskrit": "सर्वत्रात्मेश्वरान्वीक्षां कैवल्यमनिकेतताम्।\nविविक्तचीरवसनं सन्तोषं येन केनचित्॥ ११/३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.030.m4a", "display_order": 31}, {"id": 6000304031, "chapter_id": 10304, "verse_number": "११-३-२७", "content_sanskrit": "श्रद्धां भागवते शास्‍त्रेऽनिन्दामन्यत्र चापि हि।\nमनोवाक्कायदण्डं च सत्यं शमदमावपि॥ ११/३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.031.m4a", "display_order": 32}, {"id": 6000304032, "chapter_id": 10304, "verse_number": "११-३-२८", "content_sanskrit": "श्रवणं कीर्तनं ध्यानं हरेरद्भुतकर्मणः।\nजन्मकर्मगुणानां च तदर्थेऽखिलचेष्टितम्॥ ११/३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.032.m4a", "display_order": 33}, {"id": 6000304033, "chapter_id": 10304, "verse_number": "११-३-२९", "content_sanskrit": "इष्टं दत्तं तपो जप्तं पूर्तं यच्चात्मनः प्रियम्।\nदारान् सुतान् गृहान् प्राणान् परस्मै सन्निवेदयेत्॥ ११/३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.033.m4a", "display_order": 34}, {"id": 6000304034, "chapter_id": 10304, "verse_number": "११-३-३०", "content_sanskrit": "एवं कृष्णात्मनाथेषु मनुष्येषु च सौहृदम्।\nपरिचर्यां चोभयत्र महत्सु नृषु साधुषु॥ ११/३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.034.m4a", "display_order": 35}, {"id": 6000304035, "chapter_id": 10304, "verse_number": "११-३-३१", "content_sanskrit": "परस्परानुकथनं पावनं भगवद्यशः।\nमिथो रतिर्मिथस्तुष्टिर्निवृत्तिर्मिथ आत्मनः॥ ११/३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.035.m4a", "display_order": 36}, {"id": 6000304036, "chapter_id": 10304, "verse_number": "११-३-३२", "content_sanskrit": "स्मरन्तः स्मारयन्तश्च मिथोऽघौघहरं हरिम्।\nभक्ताः सञ्जातया भक्त्या बिभ्रत्युत्पुलकां तनुम्॥ ११/३/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.036.m4a", "display_order": 37}, {"id": 6000304037, "chapter_id": 10304, "verse_number": "११-३-३३", "content_sanskrit": "क्‍वचिद् रुदन्त्यच्युतचिन्तया क्‍वचिद्धसन्ति नन्दन्ति वदन्त्यलौकिकाः।\nनृत्यन्ति गायन्त्यनुशीलयन्त्यजं भवन्ति तूष्णीं परमेत्य निर्वृताः॥ ११/३/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.037.m4a", "display_order": 38}, {"id": 6000304038, "chapter_id": 10304, "verse_number": "११-३-३४", "content_sanskrit": "इति भागवतान् धर्मान् शिक्षन् भक्त्या तदुत्थया।\nनारायणपरो मायामञ्जस्तरति दुस्तराम्॥ ११/३/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.038.m4a", "display_order": 39}, {"id": 6000304039, "chapter_id": 10304, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.039.m4a", "display_order": 40}, {"id": 6000304040, "chapter_id": 10304, "verse_number": "११-३-३५", "content_sanskrit": "नारायणाभिधानस्य ब्रह्मणः परमात्मनः।\nनिष्ठामर्हथ नो वक्तुं यूयं हि ब्रह्मवित्तमाः॥ ११/३/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.040.m4a", "display_order": 41}, {"id": 6000304041, "chapter_id": 10304, "verse_number": null, "content_sanskrit": "पिप्पलायन उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.041.m4a", "display_order": 42}, {"id": 6000304042, "chapter_id": 10304, "verse_number": "११-३-३६", "content_sanskrit": "स्थित्युद्भवप्रलयहेतुरहेतुरस्य यः स्वप्नजागरसुषुप्तिषु सन् बहिश्च।\nदेहेन्द्रियासुहृदयानि चरन्ति येन सञ्जीवितानि तदवैहि परं नरेन्द्र॥ ११/३/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.042.m4a", "display_order": 43}, {"id": 6000304043, "chapter_id": 10304, "verse_number": "११-३-३७", "content_sanskrit": "नैनं मनो विशति वागुत चक्षुरात्मा प्राणेन्द्रियाणि च यथाऽनलमर्चिषः स्वाः।\nशब्दोऽप्यबोधकनिषेधतयाऽऽत्ममूलमर्थोक्तमाह यदृते न निषेध्यसिद्धिः॥ ११/३/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.043.m4a", "display_order": 44}, {"id": 6000304044, "chapter_id": 10304, "verse_number": "११-३-३८", "content_sanskrit": "सत्त्वं रजस्तम इति त्रिवृदेकमादौ सूत्रं महानहमिति प्रवदन्ति जीवम्।\nज्ञानक्रियार्थफलरूपतयोरुशक्ति ब्रह्मैव भाति सदसच्च तयोः परं यत्॥ ११/३/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.044.m4a", "display_order": 45}, {"id": 6000304045, "chapter_id": 10304, "verse_number": "११-३-३९", "content_sanskrit": "नासौ जजान न मरिष्यति नैधतेऽसौ न क्षीयते स च न विध्यति चारिणा हि।\nसर्वत्र शश्वदनपाय्युपलब्धिमात्रं प्राणो यथेन्द्रियबलेन विकल्पितं सत्॥ ११/३/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.045.m4a", "display_order": 46}, {"id": 6000304046, "chapter_id": 10304, "verse_number": "११-३-४०", "content_sanskrit": "अण्डेषु पेशिषु तरुष्ववनिस्थितेषु प्राणेन जीव उपधावति तत्र तत्र।\nछन्ने मतीन्द्रियगुणेऽहमि च प्रसुप्ते कूटस्थ आस यमृते तदनुस्मृतिर्न॥ ११/३/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.046.m4a", "display_order": 47}, {"id": 6000304047, "chapter_id": 10304, "verse_number": "११-३-४१", "content_sanskrit": "यर्ह्यब्जनाभचरणेषणयोरुभक्त्या चेतो मलानि विधमेद् गुणकर्मजानि।\nतस्मिन् विशुद्ध उपलभ्यत आत्मतत्वं साक्षाद् यथाऽमलदृशौ सवितृप्रकाशः॥ ११/३/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.047.m4a", "display_order": 48}, {"id": 6000304048, "chapter_id": 10304, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.048.m4a", "display_order": 49}, {"id": 6000304049, "chapter_id": 10304, "verse_number": "११-३-४२", "content_sanskrit": "कर्मयोगं वदत नः पुरुषो येन संस्कृतः।\nविधूयेहाशु कर्माणि नैष्कर्म्यं विन्दते परम्॥ ११/३/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.049.m4a", "display_order": 50}, {"id": 6000304050, "chapter_id": 10304, "verse_number": "११-३-४३", "content_sanskrit": "एवं प्रश्नमृषीन् पूर्वमपृच्छं पितुरन्तिके।\nनाब्रुवन् ब्रह्मणः पुत्रास्तत्र कारणमुच्यताम्॥ ११/३/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.050.m4a", "display_order": 51}, {"id": 6000304051, "chapter_id": 10304, "verse_number": null, "content_sanskrit": "आविर्होत्र उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.051.m4a", "display_order": 52}, {"id": 6000304052, "chapter_id": 10304, "verse_number": "११-३-४४", "content_sanskrit": "कर्माकर्मविकर्मेति वेदवादो न लौकिकः।\nवेदस्य चेश्वरात्मत्वात् तत्र मुह्यन्ति सूरयः॥ ११/३/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.052.m4a", "display_order": 53}, {"id": 6000304053, "chapter_id": 10304, "verse_number": "११-३-४५", "content_sanskrit": "परोक्षवादो वेदोऽयं बालानामनुशासनम्।\nकर्ममोक्षाय कर्माणि विधत्ते ह्यगदं यथा॥ ११/३/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.053.m4a", "display_order": 54}, {"id": 6000304054, "chapter_id": 10304, "verse_number": "११-३-४६", "content_sanskrit": "नाऽऽचरेद् यस्तु वेदोक्तं स्वयमज्ञोऽजितेन्द्रियः।\nविकर्मणा ह्यधर्मेण मृत्योर्मृत्युमुपैति सः॥ ११/३/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.054.m4a", "display_order": 55}, {"id": 6000304055, "chapter_id": 10304, "verse_number": "११-३-४७", "content_sanskrit": "वेदोक्तमेव कुर्वाणो निःसङ्गोऽर्पितमीश्वरे।\nनैष्कर्म्यां लभते सिद्धिं रोचनार्थं फलश्रुतिः॥ ११/३/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.055.m4a", "display_order": 56}, {"id": 6000304056, "chapter_id": 10304, "verse_number": "११-३-४८", "content_sanskrit": "य आशु हृदयग्रन्थिं निर्जिहीर्षुः परात्मनः।\nविधिनोपचरेद् देवं तन्त्रोक्तेन च केशवम्॥ ११/३/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.056.m4a", "display_order": 57}, {"id": 6000304057, "chapter_id": 10304, "verse_number": "११-३-४९", "content_sanskrit": "लब्ध्वा चाव्यग्रमाचार्यं तेन सन्दर्शितागमः।\nमहापुरुषमभ्यर्चेन्मूर्त्याऽभिमतयाऽऽत्मनः॥ ११/३/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.057.m4a", "display_order": 58, "topics": [{"text": "तान्त्रिकभगवत्पूजाप्रकारकथनम्", "range": "४९–५६"}]}, {"id": 6000304058, "chapter_id": 10304, "verse_number": "११-३-५०", "content_sanskrit": "शुचिः संमुख आसीनः प्राणसंयमनादिभिः।\nपिण्डं संशोध्य संन्यासकृतरक्षोऽर्चयेद् हरिम्॥ ११/३/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.058.m4a", "display_order": 59}, {"id": 6000304059, "chapter_id": 10304, "verse_number": "११-३-५१", "content_sanskrit": "अर्चादौ हृदये वापि यथालब्धोपचारकैः।\nद्रव्यक्षित्यात्मलिङ्गानि निष्पाद्य प्रोक्ष्य चासनम्॥ ११/३/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.059.m4a", "display_order": 60}, {"id": 6000304060, "chapter_id": 10304, "verse_number": "११-३-५२", "content_sanskrit": "पाद्यादीनुपकल्प्याथ सन्निधाय समाहितः।\nहृदयादिकृतन्यासो मूलमन्त्रेण चार्चयेत्॥ ११/३/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.060.m4a", "display_order": 61}, {"id": 6000304061, "chapter_id": 10304, "verse_number": "११-३-५३", "content_sanskrit": "साङ्गोपाङ्गां सपार्षदां तां तां मूर्तिं स्वमन्त्रतः।\nपाद्यार्घ्याचमनीयाद्यैः स्नानवासोविभूषणैः॥ ११/३/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.061.m4a", "display_order": 62}, {"id": 6000304062, "chapter_id": 10304, "verse_number": "११-३-५४", "content_sanskrit": "गन्धमाल्याक्षतस्रग्भिर्धूपदीपोपहारकैः।\nसाङ्गं सम्पूज्य विधिवत् स्तवैः स्तुत्वा नमेद् हरिम्॥ ११/३/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.062.m4a", "display_order": 63}, {"id": 6000304063, "chapter_id": 10304, "verse_number": "११-३-५५", "content_sanskrit": "आत्मानं तन्मयं ध्यायन् मूर्तिं सम्पूजयेद् हरेः।\nशेषमाधाय शिरसि स्वधाम्न्युद्वास्य सत्कृतम्॥ ११/३/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.063.m4a", "display_order": 64}, {"id": 6000304064, "chapter_id": 10304, "verse_number": "११-३-५६", "content_sanskrit": "एवमग्न्यर्कतोयादावर्चयेद् हृदये च यः।\nयज्ञेश्वरं स्वमात्मानमचिरान्मुच्यते हि सः॥ ११/३/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_003/BhP_11.003.064.m4a", "display_order": 65}, {"id": 6000304065, "chapter_id": 10304, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे तृतीयाध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]