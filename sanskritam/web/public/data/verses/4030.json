[{"id": 2140435, "chapter_id": 4030, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2140436, "chapter_id": 4030, "verse_number": "१", "content_sanskrit": "स राजधान्या निर्याय वैराटिः पृथिवीञ्जयः ।\nप्रयाहीत्यब्रवीत् सूतं यत्र ते कुरवो गताः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2140437, "chapter_id": 4030, "verse_number": "२", "content_sanskrit": "समवेतान् कुरून् यावद् जिगीषूनवजित्य च ।\nगाश्चैताः क्षिप्रमादाय पुनरायामि मत्पुरम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2140438, "chapter_id": 4030, "verse_number": "३", "content_sanskrit": "ततस्तांश्चोदयामास सदश्वान् पाण्डुनन्दनः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2140439, "chapter_id": 4030, "verse_number": "४", "content_sanskrit": "ते हया नरसिंहेन चोदिताः शीघ्रगामिनः ।\nआलिखन्त इवाकाशमूहुः काञ्चनमालिनः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2140440, "chapter_id": 4030, "verse_number": "५", "content_sanskrit": "नातिदूरमथो यात्वा मात्स्यपुत्रधनञ्जयौ ।\nअवैक्षेतामवित्रस्तौ कुरूणामुत्तमं बलम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2140441, "chapter_id": 4030, "verse_number": "६", "content_sanskrit": "स्मशानमभितो गत्वा शूरौ ददृशतुः कुरून्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2140442, "chapter_id": 4030, "verse_number": "७", "content_sanskrit": "तदनीकं महत् तेषां विबभौ सागरस्वनम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2140443, "chapter_id": 4030, "verse_number": "८", "content_sanskrit": "संसर्पमाणमाकाशे वनं बहुलपादपम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2140444, "chapter_id": 4030, "verse_number": "९", "content_sanskrit": "ददृशे पार्थिवो रेणुर्जनितस्तेन सर्वतः ।\nदृष्टिप्रणाशो भूतानां दिवःस्पृक् नरसत्तम\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2140445, "chapter_id": 4030, "verse_number": "१०", "content_sanskrit": "तदनीकमथ प्रेक्ष्य गजाश्वरथसङ्कुलम् ।\nकर्णदुर्योधनकृपैर्गुप्तं शान्तनवेन च\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2140446, "chapter_id": 4030, "verse_number": "११", "content_sanskrit": "द्रोणेन च सपुत्रेण महेष्वासेन धीमता ।\nहृष्टरोमा भयोद्विग्नः पार्थं वैराटिरब्रवीत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2140447, "chapter_id": 4030, "verse_number": "१२", "content_sanskrit": "नोत्सहे कुरुभिर्योद्धुं रोमहर्षं च पश्य मे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2140448, "chapter_id": 4030, "verse_number": "१३", "content_sanskrit": "बहुप्रवीरमत्युग्रं देवैरपि दुरासदम् ।\nप्रतियोद्धुं न शक्नोमि कुरुसैन्यं भयानकम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2140449, "chapter_id": 4030, "verse_number": "१४", "content_sanskrit": "नाशंसे भारतीं सेनां प्रवेष्टुं भीमकार्मुकम् ।\nदेवैरपि सहेन्द्रेण न शक्यं किम्पुनर्नरैः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2140450, "chapter_id": 4030, "verse_number": "१५", "content_sanskrit": "रथनागाश्वकलिलं पत्तिध्वजसमाकुलम् ।\nदृष्ट्वैव हि परानीकं मनः प्रव्यथतीव मे\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2140451, "chapter_id": 4030, "verse_number": "१६", "content_sanskrit": "यत्र भीष्मश्च द्रोणश्च कृपः कर्णो विविंशतिः ।\nअश्वत्थामा विकर्णश्च सोमदत्तश्च बाह्लिकः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2140452, "chapter_id": 4030, "verse_number": "१७", "content_sanskrit": "दुर्योधनस्तथा राजा वीरो दुर्मर्षणः पटुः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2140453, "chapter_id": 4030, "verse_number": "१८", "content_sanskrit": "धृतिमन्तो महेष्वासा सर्वे युद्धविशारदाः ।\nमत्ता इव महानागा युक्तध्वजपताकिनः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2140454, "chapter_id": 4030, "verse_number": "१९", "content_sanskrit": "नीतिमन्तो महेष्वासाः सर्वास्त्रकृतनिश्चयाः ।\nदुर्जयाः सर्वसैन्यानां देवैरपि सवासवैः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2140455, "chapter_id": 4030, "verse_number": "२०", "content_sanskrit": "पताकिनश्च मातङ्गाः सध्वजाश्च महारथाः ।\nविप्रकीर्णाः कृतोद्योगा वाजिनश्चित्रभूषिताः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2140456, "chapter_id": 4030, "verse_number": "२१", "content_sanskrit": "तान् जेतुं समरे शूरान् दुर्बुद्धिरहमागतः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2140457, "chapter_id": 4030, "verse_number": "२२", "content_sanskrit": "दृष्ट्वैव हि कुरून् सर्वान् व्यूढानीकान् प्रहारिणः ।\nहृषितानि च रोमाणि कश्मलं चागमन्महत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2140458, "chapter_id": 4030, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2140459, "chapter_id": 4030, "verse_number": "२३", "content_sanskrit": "दृष्ट्वा च महतीं सेनां कुरूणां दृढधन्विनाम् ।\nपरिदेवयते मन्दः सकाशे सव्यसाचिनः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2140460, "chapter_id": 4030, "verse_number": "२४", "content_sanskrit": "त्रिगर्तान् मे पिता यातः शून्ये वै प्रणिधाय माम् ।\nसर्वां सेनां समादाय न मे सन्तीह सैनिकाः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2140461, "chapter_id": 4030, "verse_number": "२५", "content_sanskrit": "अहमेको बहून् बालः कृतास्त्रानकृतश्रमः ।\nप्रतियोद्धुं न शक्नोमि निवर्तय बृहन्नळे\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2140462, "chapter_id": 4030, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2140463, "chapter_id": 4030, "verse_number": "२६", "content_sanskrit": "तं तथावादिनं तत्र बीभत्सुः प्रत्यभाषत ।\nसम्प्रहस्य पुनस्तं वै सर्वलोकमहारथः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2140464, "chapter_id": 4030, "verse_number": "२७", "content_sanskrit": "भयादुदीर्णरूपोऽसि द्विषतां हर्षवर्धनः ।\nन च तावत् कृतं किञ्चित् परैः कर्म रणाजिरे\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2140465, "chapter_id": 4030, "verse_number": "२८", "content_sanskrit": "स्वयमेव च मामात्थ वह मां कौरवान् प्रति ।\nसोऽहं त्वां तत्र नेष्यामि यत्रैते बहुला ध्वजाः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2140466, "chapter_id": 4030, "verse_number": "२९", "content_sanskrit": "मध्यमामिषगृध्राणां कुरूणामाततायिनाम् ।\nनेष्यामि त्वां महाबाहो मा त्वं हि विमना भव\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2140467, "chapter_id": 4030, "verse_number": "३०", "content_sanskrit": "समुद्रमिव गम्भीरं कुरुसैन्यमरिन्दम\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2140468, "chapter_id": 4030, "verse_number": "३१", "content_sanskrit": "स्त्रीसकाशे प्रतिज्ञाय पुरुषाणां हि शृण्वताम् ।\nविकत्थमानो निर्यात्वा ब्रूषि किं नात्र युद्ध्यसे\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2140469, "chapter_id": 4030, "verse_number": "३२", "content_sanskrit": "तथा स्त्रीषु प्रतिश्रुत्य पौरुषं पुरुषेषु च ।\nरथमारुह्य निर्याय किमर्थं न च योत्स्यसे\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2140470, "chapter_id": 4030, "verse_number": "३३", "content_sanskrit": "न चेद् विजित्य गास्त्वं हि नगरं प्रतियास्यसि ।\nप्रहसिष्यन्ति धीरास्त्वां नरा नार्यश्च सङ्गताः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2140471, "chapter_id": 4030, "verse_number": "३४", "content_sanskrit": "अहमप्यस्मि सैरन्ध्र्या स्तुतः सारथ्यकर्मणि ।\nनाहं शक्नोम्यनिर्जित्य गाः प्रयातुं पुरं प्रति\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2140472, "chapter_id": 4030, "verse_number": "३५", "content_sanskrit": "स्तोत्रेण चैव सैरन्ध्र्यास्तव वाक्येन चोदितः ।\nकथं न युद्ध्येयमहं कुरूनेतान् स्थिरो भव\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2140473, "chapter_id": 4030, "verse_number": "", "content_sanskrit": "उत्तरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2140474, "chapter_id": 4030, "verse_number": "३६", "content_sanskrit": "कामं हरन्तु मत्स्यानां भूयांसः कुरवो धनम् ।\nप्रहसन्तु च मां नार्यो नराश्चापि बृहन्नळे\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2140475, "chapter_id": 4030, "verse_number": "३७", "content_sanskrit": "सङ्ग्रामेण न मे कार्यं गावो गच्छन्तु चापि मे ।\nनगरं च प्रवेक्ष्यामि पश्यतस्ते बृहन्नळे\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2140476, "chapter_id": 4030, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2140477, "chapter_id": 4030, "verse_number": "३८", "content_sanskrit": "इत्युक्त्वा प्राद्रवद् भीतो रथात् प्रस्कन्द्य कुण्डली ।\nत्यक्त्वा मानं सुसन्त्रस्तो विसृज्य सशरं धनुः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2140478, "chapter_id": 4030, "verse_number": "३९", "content_sanskrit": "नैष शूरैः स्मृतो धर्मः क्षत्रियस्य पलायनम् ।\nश्रेयो हि मरणं युद्धे क्षत्रियस्य पलायनात्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2140479, "chapter_id": 4030, "verse_number": "समाप्तिः", "content_sanskrit": "इति चोक्त्वा तु कौन्तेयो रथादवततार ह ।\nदीर्घां वैणीं विधून्वानः साधु रक्ते च वाससी\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2140480, "chapter_id": 4030, "verse_number": "४१", "content_sanskrit": "अन्वधावन्महाबाहू राजपुत्रं धनञ्जयः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2140481, "chapter_id": 4030, "verse_number": "४२", "content_sanskrit": "विक्रमन्तं पदन्यासैः कम्पयन्तं च मेदिनीम् ।\nविधूय वेणीं धावन्तमजानन्तोऽर्जुनं तदा\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2140482, "chapter_id": 4030, "verse_number": "४३", "content_sanskrit": "सैनिकाः प्राहसन् केचित् तस्य रूपमवेक्ष्य च\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2140483, "chapter_id": 4030, "verse_number": "४४", "content_sanskrit": "तं च शीघ्रं प्रधावन्तं सम्प्रेक्ष्य कुरवोऽब्रुवन्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2140484, "chapter_id": 4030, "verse_number": "४५", "content_sanskrit": "कोऽयं धावत्यसङ्गेन पूर्वं मुक्त्वा रथोत्तमम् ।\nक एष वेषप्रच्छन्नो भस्मच्छन्न इवानलः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2140485, "chapter_id": 4030, "verse_number": "४६", "content_sanskrit": "किञ्चत् तस्य यथा पुंसः किञ्चित् तस्य यथा स्त्रियः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2140486, "chapter_id": 4030, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2140487, "chapter_id": 4030, "verse_number": "४७", "content_sanskrit": "इत्येवं सैनिकाः प्राहुर्द्रोणस्तानिदमब्रवीत् ।\nआचार्यः कुरुपाण्डूनां मतौ शुक्राङ्गिरोपमः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2140488, "chapter_id": 4030, "verse_number": "४८", "content_sanskrit": "किं विचारणया कार्यमेतेनानुसृतेन वै\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2140489, "chapter_id": 4030, "verse_number": "४९", "content_sanskrit": "धावन्तमनुधावंश्च निर्भयो भयविप्लुतम् ।\nवेणीकलापं निर्धूय प्रतिभाति नरर्षभः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2140490, "chapter_id": 4030, "verse_number": "५०", "content_sanskrit": "आकारमर्जुनस्यैतत् क्लीबरूपं बिभर्ति च ।\nरूपेण पार्थसदृशः स्त्रीवेषसमलङ्कृतः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2140491, "chapter_id": 4030, "verse_number": "५१", "content_sanskrit": "नटे वैतच्छिरोग्रीवं तौ बाहू परिघोपमौ ।\nतत्तदेवास्य विक्रान्तं नायमन्यो धनञ्जयात्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2140492, "chapter_id": 4030, "verse_number": "५२", "content_sanskrit": "अमरेष्विव देवेन्द्रो मानुषेषु धनञ्जयः ।\nएकोऽस्माननुयात्येष नायमन्यो धनञ्जयात्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2140493, "chapter_id": 4030, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2140494, "chapter_id": 4030, "verse_number": "५३", "content_sanskrit": "द्रोणेन चैवमुक्तस्तु कर्णः प्रोवाच बुद्धिमान्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2140495, "chapter_id": 4030, "verse_number": "५४", "content_sanskrit": "एकः पुत्रो विराटस्य शून्ये सन्निहितः पुरे ।\nस एष किल निर्यातो बालभावान्न पौरुषात्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2140496, "chapter_id": 4030, "verse_number": "५५", "content_sanskrit": "क्लीबं वै सारथिं कृत्वा निर्यातो नगराद् बहिः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2140497, "chapter_id": 4030, "verse_number": "५६", "content_sanskrit": "छन्नं गात्रेण वा नूनं जानीध्वं यान्तमर्जुनम् ।\nते हि नः प्रतिसंयातुं सङ्ग्रामे न हि शक्नुयुः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2140498, "chapter_id": 4030, "verse_number": "५७", "content_sanskrit": "कथमेकतरस्तेषां समस्तान् योधयेत् कुरून्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2140499, "chapter_id": 4030, "verse_number": "५८", "content_sanskrit": "उत्तरः सारथिं कृत्वा निर्यातो नगराद् बहिः ।\nस नो मनो ध्वजान् दृष्ट्वा भीत एष पलायते\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2140500, "chapter_id": 4030, "verse_number": "", "content_sanskrit": "कृपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2140501, "chapter_id": 4030, "verse_number": "५९", "content_sanskrit": "नूनं तमेव धावन्तं जिघृक्षति धनञ्जयः ।\nउत्तरं सारथिं कृत्वा स्वयं योद्धुमिहेच्छति\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2140502, "chapter_id": 4030, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2140503, "chapter_id": 4030, "verse_number": "समाप्तिः", "content_sanskrit": "इति स्म कुरवः सर्वे विमृशन्तः पुनः पुनः ।\nन च व्यवसितुं वीरा अर्जुनं शक्नुवन्ति ते\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2140504, "chapter_id": 4030, "verse_number": "६१", "content_sanskrit": "दुर्योधन उवाचेदं सैनिकान् रथसत्तमान्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2140505, "chapter_id": 4030, "verse_number": "६२", "content_sanskrit": "अर्जुनो वासुदेवो वा रामः प्रद्युम्न एव वा ।\nते हि नः प्रतिसंयातुं सङ्ग्रामे न च शक्नुयुः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2140506, "chapter_id": 4030, "verse_number": "६३", "content_sanskrit": "अन्यो वा क्लीबरूपेण यद्यागच्छेद् गवां पदम् ।\nअर्पयित्वा शरैस्तीक्ष्णैः पातयिष्यामि भूतळे\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2140507, "chapter_id": 4030, "verse_number": "६४", "content_sanskrit": "कथमेकतरस्तेषां समस्तान् योधयेत् कुरून्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2140508, "chapter_id": 4030, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2140509, "chapter_id": 4030, "verse_number": "६५", "content_sanskrit": "छन्नं तथागतं सर्वे पाण्डवं प्रेक्ष्य सैनिकाः ।\nअर्जुनो नेति चेत्येनं न व्यवस्यन्ति ते पुनः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2140510, "chapter_id": 4030, "verse_number": "समाप्तिः", "content_sanskrit": "इति स्म कुरवः सर्वे मन्त्रयन्तो महारथाः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2140511, "chapter_id": 4030, "verse_number": "६७", "content_sanskrit": "दृढवेधी महासत्त्वः शक्रतुल्यपराक्रमः ।\nअद्यागच्छति चेद् योद्धुं सर्वं संशयितं बलम्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2140512, "chapter_id": 4030, "verse_number": "६८", "content_sanskrit": "न चाप्यन्यं नरं तत्र व्यवस्यन्ति धनञ्जयात्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2140513, "chapter_id": 4030, "verse_number": "६९", "content_sanskrit": "उत्तरं तु प्रधावन्तमनुद्रुत्य धनञ्जयः ।\nगत्वा शतपदं तूर्णं केशपक्षे परामृशत्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2140514, "chapter_id": 4030, "verse_number": "७०", "content_sanskrit": "विराटपुत्रं बीभत्सुर्बलवानरिमर्दनः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2140515, "chapter_id": 4030, "verse_number": "७१", "content_sanskrit": "मा मा गृहाण भद्रं ते दासोऽहं ते बृहन्नळे ।\nइति वादिनमेवाशु धावन्तं तरसाऽग्रहीत्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2140516, "chapter_id": 4030, "verse_number": "७२", "content_sanskrit": "सोऽर्जुनेन परामृष्टः पर्यदेवयदार्तवत् ।\nबहुलं कृपणं चैव वित्तं प्रावेदयद् बहु\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2140517, "chapter_id": 4030, "verse_number": "७३", "content_sanskrit": "मा मा मारय भद्रं ते मुञ्च मामेव मे गृहम् ।\nमुञ्च मां मुञ्च मुञ्चेति तत्पादावग्रहीद् ब्रुवन्\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2140518, "chapter_id": 4030, "verse_number": "७४", "content_sanskrit": "सुवर्णमणिमुक्तानां यद्यदिच्छसि दद्मि ते ।\nहस्तिनोऽश्वान् रथान् गावः स्त्रियश्च समलङ्कृताः\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2140519, "chapter_id": 4030, "verse_number": "७५", "content_sanskrit": "शातकुम्भस्य शुद्धस्य श्रेष्ठस्य रजतस्य च ।\nददामि शतनिष्कं ते मुञ्च मां त्वं बृहन्नळे\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2140520, "chapter_id": 4030, "verse_number": "७६", "content_sanskrit": "मणीनष्टौ च वैडूर्यान् हेमबद्धान् महाप्रभान् ।\nहेमदण्डप्रतिच्छन्नं रथं युक्तं तु वाजिभिः\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2140521, "chapter_id": 4030, "verse_number": "७७", "content_sanskrit": "मत्तांश्च दश मातङ्गान् मुञ्च मां त्वं बृहन्नळे\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2140522, "chapter_id": 4030, "verse_number": "७८", "content_sanskrit": "षष्टिं स्वलङ्कृताः कन्या ग्राममेकं ददामि ते\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2140523, "chapter_id": 4030, "verse_number": "७९", "content_sanskrit": "मुञ्च मां त्वं भृशं दीनं विह्वलं भयकम्पितम् ।\nगमिष्यामि पुरं शीघ्रं द्रष्टुं मातरमर्दिताम्\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2140524, "chapter_id": 4030, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2140525, "chapter_id": 4030, "verse_number": "८०", "content_sanskrit": "एवमादीनि वाक्यानि विलपन्तमचेतनम् ।\nप्रहस्य पुरुषव्याघ्रो रथस्यान्तिकमानयत्\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2140526, "chapter_id": 4030, "verse_number": "८१", "content_sanskrit": "अथैनमब्रवीत् पार्थो भयार्तं नष्टचेतसम्\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2140527, "chapter_id": 4030, "verse_number": "८२", "content_sanskrit": "सङ्गच्छामि पदान्यस्य न स भीतः पलायति\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2140528, "chapter_id": 4030, "verse_number": "८३", "content_sanskrit": "यदि नोत्सहसे योद्धुं शत्रुभिः शत्रुकर्शन ।\nएहि मे त्वं हयान् यच्छ युद्ध्यमानस्य शत्रुभिः\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2140529, "chapter_id": 4030, "verse_number": "८४", "content_sanskrit": "प्रयाह्येतद् रथानीकं मद्बाहुपरिरक्षितः ।\nअप्रधृष्यतमं घोरं गुप्तं घोरैर्महारथैः\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2140530, "chapter_id": 4030, "verse_number": "८५", "content_sanskrit": "मा भैस्त्वं राजपुत्राग्र्य क्षत्रियोऽसि परन्तप ।\nअहं तैः कुरुभिर्योत्से प्रत्यानेष्यामि ते पशून्\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2140531, "chapter_id": 4030, "verse_number": "८६", "content_sanskrit": "प्रविशैतद् रथानीकमप्रधृष्यं दुरासदम् ।\nयन्ता भूस्त्वं नरश्रेष्ठ योत्स्येऽहं कुरुभिः सह\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2140532, "chapter_id": 4030, "verse_number": "८७", "content_sanskrit": "शूरान् समरचण्डांश्च नेष्यामि यमसादनम्\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2140533, "chapter_id": 4030, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2140534, "chapter_id": 4030, "verse_number": "८८", "content_sanskrit": "एवं ब्रुवाणो बीभत्सुर्वैराटिमपराजितः ।\nसमाश्वास्य भयार्तं तमुत्तरं भरतर्षभ\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2140535, "chapter_id": 4030, "verse_number": "८९", "content_sanskrit": "तत एनं विचेष्टन्तमकामं भयपीडितम् ।\nरथमारोपयामास पार्थः परपुरञ्जयः\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2140536, "chapter_id": 4030, "verse_number": "९०", "content_sanskrit": "तमारोप्य रथोपस्थे विलपन्तं धनञ्जयः ।\nगाण्डीवं पुनरादातुं समायातां शमीं प्रति\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2140537, "chapter_id": 4030, "verse_number": "९१", "content_sanskrit": "उत्तरं स समाश्वास्य कृत्वा सारथिमर्जुनः\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2140538, "chapter_id": 4030, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां विराटपर्वणि अष्टत्रिंशोऽध्यायः ॥३८॥\nगोग्रहणपर्वणि एकादशोऽध्यायः ॥११॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}]