[{"id": 2084260, "chapter_id": 2793, "verse_number": "१२-२९८-०x", "content_sanskrit": "पराशर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2084261, "chapter_id": 2793, "verse_number": "१२-२९८-१", "content_sanskrit": "कः कस्य चोपकुरुते कश्च कस्मै प्रयच्छति।\nप्राणी करोत्ययं कर्म सर्वमात्मार्थमात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2084262, "chapter_id": 2793, "verse_number": "१२-२९८-२", "content_sanskrit": "गौरवेण परित्यक्तं निःस्नेहं परिवर्जयेत्।\nसोदर्यं भ्रातरमपि किमुतान्यं पृथग्जनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2084263, "chapter_id": 2793, "verse_number": "१२-२९८-३", "content_sanskrit": "विशिष्टस्य विशिष्टाच्च तुल्यौ दानप्रतिग्रहौ।\nतयोः पुण्यतरं दानं तद्द्विजस्य प्रयच्छतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2084264, "chapter_id": 2793, "verse_number": "१२-२९८-४", "content_sanskrit": "न्यायागतं धनं वर्णैर्न्यायेनैव विवर्धितम्।\nसंरक्ष्यं यत्नमास्थाय धर्मार्थमिति निश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2084265, "chapter_id": 2793, "verse_number": "१२-२९८-५", "content_sanskrit": "न धर्मार्थी नृशंसेन कर्मणा धनमार्जयेत्।\nशक्तितः सर्वकार्याणि कुर्यान्नर्द्धिमनुस्मरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2084266, "chapter_id": 2793, "verse_number": "१२-२९८-६", "content_sanskrit": "अपो हि प्रयताः शीतास्तापिता ज्वलनेन वा।\nशक्तितोऽतिथये दत्त्वा क्षुधार्तायाऽश्नुते फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2084267, "chapter_id": 2793, "verse_number": "१२-२९८-७", "content_sanskrit": "रन्तिदेवेन लोकेष्टा सिद्धिः प्राप्ता महात्मना।\nफलपत्रैरथो मूलैर्मुनीनचिंतवांश्च सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2084268, "chapter_id": 2793, "verse_number": "१२-२९८-८", "content_sanskrit": "तैरेव फलपत्रैश्च स माठरमतोषयत्।\nतस्माल्लेभे परं स्थानं शैब्योऽपि पृथिवीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2084269, "chapter_id": 2793, "verse_number": "१२-२९८-९", "content_sanskrit": "देवतातिथिभृत्येभ्यः पितृभ्यश्चात्मनस्तथा।\nऋणवाञ्जायते मर्त्यस्तस्मादनृणतां व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2084270, "chapter_id": 2793, "verse_number": "१२-२९८-१०", "content_sanskrit": "स्वाध्यायेन महर्षिभ्यो देवेभ्यो यज्ञकर्मणा।\nपितृभ्यः श्राद्धदानेन नृणामभ्यर्चनेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2084271, "chapter_id": 2793, "verse_number": "१२-२९८-११", "content_sanskrit": "पाकशेपावहार्येण पालनेनात्मनोऽपि च।\nयथावद्भृत्यवर्गस्य चिकीर्षेत्कर्म आदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2084272, "chapter_id": 2793, "verse_number": "१२-२९८-१२", "content_sanskrit": "प्रयत्नेन च संसिद्धा धनैरपि विवर्जिताः।\nसम्यग्घृत्वा हुतवहं मुनयः सिद्धिमागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2084273, "chapter_id": 2793, "verse_number": "१२-२९८-१३", "content_sanskrit": "विश्वामित्रस्य पुत्रत्वमृचीकतनयोऽगमत्।\nऋग्भिः स्तुत्वा महाबाहो देवान्वै यज्ञभागिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2084274, "chapter_id": 2793, "verse_number": "१२-२९८-१४", "content_sanskrit": "गतः शुक्रत्वमुशना देवदेवप्रसादनात्।\nदेवीं स्तुत्वा तु गगने मोदते तेजसा वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2084275, "chapter_id": 2793, "verse_number": "१२-२९८-१५", "content_sanskrit": "असितो देवलश्चैव तथा नारदपर्वतौ।\nकक्षीवाञ्जामदग्न्यश्च रामस्ताण्ड्यस्तथाऽऽत्मवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2084276, "chapter_id": 2793, "verse_number": "१२-२९८-१६", "content_sanskrit": "वसिष्ठो जमदग्निश्च विश्वामित्रोऽत्रिरेव च।\nभरद्वाजो हरिश्मश्रुः कुण्डधारः श्रुतश्रवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2084277, "chapter_id": 2793, "verse_number": "१२-२९८-१७", "content_sanskrit": "एते महर्षयः स्तुत्वा विष्णुमृग्भिः समाहिताः।\nलेभिरे तपसा सिद्धिं प्रसादात्तस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2084278, "chapter_id": 2793, "verse_number": "१२-२९८-१८", "content_sanskrit": "अनर्हाश्चार्हतां प्राप्ताः सन्तः स्तुत्वा तमेव ह।\nन तु वृद्धिमिहान्विच्छेत्कर्म कृत्वा जुगुप्सितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2084279, "chapter_id": 2793, "verse_number": "१२-२९८-१९", "content_sanskrit": "येऽर्था धर्मेण ते सत्या येऽधर्मेण धिगस्तु तान्।\nधर्मं वै शाश्वतं लोके न जह्याद्धनकाङ्क्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2084280, "chapter_id": 2793, "verse_number": "१२-२९८-२०", "content_sanskrit": "आहिताग्निर्हि धर्मात्मा यः स पुण्यकृदुत्तमः।\nवेदा हि सर्वे राजेन्द्र स्थितास्त्रिष्वग्निषु प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2084281, "chapter_id": 2793, "verse_number": "१२-२९८-२१", "content_sanskrit": "च चाप्यग्न्याहितो विप्रः क्रिया यस्य न हीयते।\nश्रेयो ह्यनाहिताग्नित्वमग्निहोत्रं न निष्क्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2084282, "chapter_id": 2793, "verse_number": "१२-२९८-२२", "content_sanskrit": "अग्निरात्मा च माता च पिता जनयिता तथा।\nगुरुश्च नरशार्दूल परिचर्या यथातथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2084283, "chapter_id": 2793, "verse_number": "१२-२९८-२३", "content_sanskrit": "मानं त्यक्त्वा यो नरो वृद्धसेवी\nविद्वान्क्लीबः पश्यति प्रीतियोगात्।\nदाक्ष्येण हीनो धर्मयुक्तो न दान्तो\nलोकेऽस्मिन्वै पूज्यते सद्भिरार्यः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2084284, "chapter_id": 2793, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि अष्टनवत्यधिकद्विशततमोऽध्यायः॥ २९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]