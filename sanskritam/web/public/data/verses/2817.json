[{"id": 2085307, "chapter_id": 2817, "verse_number": "१२-३२२-०x", "content_sanskrit": "याज्ञवल्क्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2085308, "chapter_id": 2817, "verse_number": "१२-३२२-१", "content_sanskrit": "तथैवोत्क्रमतां स्थानं शृणुष्वावहितो नृप।\nपद्भ्यामुत्क्रममाणस्य वैष्णवं स्थानमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2085309, "chapter_id": 2817, "verse_number": "१२-३२२-२", "content_sanskrit": "जङ्घाभ्यां तु वसून्देवानाप्नुयादिति नः श्रुतम्।\nजानुभ्यां च महाभागान्साध्यान्देवानवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2085310, "chapter_id": 2817, "verse_number": "१२-३२२-३", "content_sanskrit": "पायुनोत्क्रममाणस्तु मैत्रं स्थानमवाप्नुयात्।\nपृथिवीं जघनेनाथ ऊरुभ्यां च प्रजापतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2085311, "chapter_id": 2817, "verse_number": "१२-३२२-४", "content_sanskrit": "पार्श्वाभ्यां मरुतो देवान्नासाभ्यामिन्दुमेव च।\nबाहुभ्यामिन्द्रमित्याहुरुरसा रुद्रमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2085312, "chapter_id": 2817, "verse_number": "१२-३२२-५", "content_sanskrit": "ग्रीवया तु मुनिश्रेष्ठं नरमाप्नोत्यनुत्तमम्।\nविश्वेदेवान्मुखेनाथ दिशः श्रोत्रेण चाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2085313, "chapter_id": 2817, "verse_number": "१२-३२२-६", "content_sanskrit": "घ्राणेन गन्धवहनं नेत्राभ्यां सूर्यमेव च।\nभ्रूभ्यां चैवाश्विनौ देवौ ललाटेन पितृनथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2085314, "chapter_id": 2817, "verse_number": "१२-३२२-७", "content_sanskrit": "ब्रह्माणमाप्नोति विभुं मूर्ध्ना देवाग्रजं तथा।\nएतान्युत्क्रमणस्थानान्युक्तानि मिथिलेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2085315, "chapter_id": 2817, "verse_number": "१२-३२२-८", "content_sanskrit": "अरिगनि प्रवक्ष्यामि विहितानि मनीषिभिः।\nसंवत्सराद्धिमोक्षस्तु संभवेत शरीरिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2085316, "chapter_id": 2817, "verse_number": "१२-३२२-९", "content_sanskrit": "योऽरुन्धतीं न पश्येत दृष्टपूर्वा कदाचन।\nतथैव ध्रुवमतित्याहुः पूर्णेन्दुं दीपमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2085317, "chapter_id": 2817, "verse_number": "१२-३२२-१०", "content_sanskrit": "खण्डाभासं दक्षिणतस्तेऽपि संवत्सरायुषः।\nपरचक्षुषि चात्मानं ये न पश्यन्ति पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2085318, "chapter_id": 2817, "verse_number": "१२-३२२-११", "content_sanskrit": "आत्मच्छायाकृतीभूतं तेऽपि संवत्सरायुषः।\nअतिद्युतिरतिप्रज्ञा अप्रज्ञा चाद्युतिस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2085319, "chapter_id": 2817, "verse_number": "१२-३२२-१२", "content_sanskrit": "प्रकृतेर्विक्रियापत्तिः षण्मासान्मृत्युलक्षणम्।\nदैवतान्यवजानाति ब्राह्मणैश्च विरुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2085320, "chapter_id": 2817, "verse_number": "१२-३२२-१३", "content_sanskrit": "कृष्णश्यावच्छविच्छायः षण्मासान्मृत्युलक्षणम्।\nशीर्णनाभिं यथा चक्रं छिद्रं सोमं प्रपश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2085321, "chapter_id": 2817, "verse_number": "१२-३२२-१४", "content_sanskrit": "तथैव च सहस्रांशुं सप्तरात्रेण मृत्युभाक्।\nशवगन्धमुपाघ्राति सप्तरात्रेण मृत्युभाक्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2085322, "chapter_id": 2817, "verse_number": "१२-३२२-१५", "content_sanskrit": "कर्णनासावनमनं दन्तदृष्टिविरागितां॥\nकर्णनासावनमनं दन्तदृष्टिविरागिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2085323, "chapter_id": 2817, "verse_number": "१२-३२२-१६", "content_sanskrit": "संज्ञालोपो निरूष्मत्वं सद्योमृत्युनिदर्शनम्।\nअकस्माच्च स्रवेद्यस्य वाममक्षि नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2085324, "chapter_id": 2817, "verse_number": "१२-३२२-१७", "content_sanskrit": "मूर्ध्रतश्चोत्पतेद्धूमः सद्योमृत्युनिदर्शनम्।\nएतावन्ति त्वरिष्टानि विदित्वा मानवोऽऽत्मवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2085325, "chapter_id": 2817, "verse_number": "१२-३२२-१८", "content_sanskrit": "निशि चाहनि चात्मानं योजयेत्परमात्मनि।\nप्रतीक्षमाणस्तत्कालं यः कालः प्रकृतो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2085326, "chapter_id": 2817, "verse_number": "१२-३२२-१९", "content_sanskrit": "अथास्य नेष्टं मरणं स्थातुमिच्छेदिमां क्रियाम्।\nसर्वगन्धान्रसांश्चैव धारयीत समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2085327, "chapter_id": 2817, "verse_number": "१२-३२२-२०", "content_sanskrit": "`तथा मृत्युमुपादाय तत्परेणान्दरात्मना।\nस साङ्ख्यधारणं चैव विदित्वा मनुजर्षभ।\nजयेच्च मृत्युं योगेन तत्परेणान्तरात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2085328, "chapter_id": 2817, "verse_number": "१२-३२२-२१", "content_sanskrit": "गच्छेत्प्राप्याक्षयं कृत्स्नमजन्म शिवमव्ययम्।\nशाश्वतं स्थानमचलं दुष्प्रापमकृतात्मभिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2085329, "chapter_id": 2817, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि द्वाविंशत्यधिकत्रिशततमोऽध्यायः॥ ३२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]