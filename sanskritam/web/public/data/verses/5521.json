[{"id": 2212231, "chapter_id": 5521, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2212232, "chapter_id": 5521, "verse_number": "१", "content_sanskrit": "केशवेनैवमाख्याते धर्मपुत्रः पुनः प्रभुम् ।\nपप्रच्छ दानकालस्य विशेषं च विधिं नृप ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2212233, "chapter_id": 5521, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2212234, "chapter_id": 5521, "verse_number": "२", "content_sanskrit": "देव किं फलमाख्यातं दानस्य विषुवेषु च ।\nसूर्येन्दूपप्लवे चैव दत्ते दाने च यत् फलम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2212235, "chapter_id": 5521, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2212236, "chapter_id": 5521, "verse_number": "३", "content_sanskrit": "शृणुष्व राजन् विषुवे सोमार्कग्रहणेषु च ।\nव्यतीपातेऽयने चैव दानं स्यादक्षयं नृप ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2212237, "chapter_id": 5521, "verse_number": "४", "content_sanskrit": "राजन् नयनोर्मध्यं विषुवं सम्प्रचक्षते ।\nसमे रात्रिदिने तत्र सन्ध्यायां विषुवे नृप ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2212238, "chapter_id": 5521, "verse_number": "५", "content_sanskrit": "ब्रह्माऽहं शङ्करश्चापि तिष्ठामः सहिताः सकृत् ।\nक्रियाकारणकार्याणामेकीभावत्वकारणात् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2212239, "chapter_id": 5521, "verse_number": "६", "content_sanskrit": "अस्माकमेकीभूतानां निष्कलं तत्पदं परम् ।\nतन्मुहूर्तं परं पुण्यं राजन् विषुवसञ्ज्ञितम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2212240, "chapter_id": 5521, "verse_number": "७", "content_sanskrit": "तदेवाद्यक्षरं ब्रह्म परं ब्रह्मेति कीर्तितम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2212241, "chapter_id": 5521, "verse_number": "८", "content_sanskrit": "तस्मिन् मुहूर्ते सर्वेऽपि चिन्तयन्तः परं पदम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2212242, "chapter_id": 5521, "verse_number": "९", "content_sanskrit": "देवाश्च पितरो रुद्राः वसवश्चाश्विनौ तथा ।\nसाध्याश्च विश्वे गन्धर्वाः सिद्धा ब्रह्मर्षयस्तथा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2212243, "chapter_id": 5521, "verse_number": "१०", "content_sanskrit": "सोमादयो ग्रहाश्चैव सरितः सागरास्तथा ।\nमरुतोऽप्सरसो नागा यक्षराक्षसगुह्यकाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2212244, "chapter_id": 5521, "verse_number": "११", "content_sanskrit": "एते चान्ये च राजेन्द्र विषुवे संयतेन्द्रियाः ।\nसोपवासाः प्रयत्नेन भवन्ति ध्यानतत्पराः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2212245, "chapter_id": 5521, "verse_number": "१२", "content_sanskrit": "अन्नं गावस्तिलान् भूमिं कन्यादानं तथैव च ।\nगृहमायतनं धान्यं वाहनं शयनं तथा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2212246, "chapter_id": 5521, "verse_number": "१३", "content_sanskrit": "यच्चान्यच्च मया प्रोक्तं तत्प्रयच्छ युधिष्ठिर ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2212247, "chapter_id": 5521, "verse_number": "१४", "content_sanskrit": "दीयते विषुवेष्वेवं श्रोत्रियेभ्यो विशेषतः ।\nतस्य दानस्य कौन्तेय क्षयो नैवोपपद्यते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2212248, "chapter_id": 5521, "verse_number": "१५", "content_sanskrit": "वर्धतेऽहरहः पुण्यं तद्दानं कोटिसम्मितम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2212249, "chapter_id": 5521, "verse_number": "१६", "content_sanskrit": "विषुवे स्नपनं यस्तु मम कुर्याद्धरस्य वा ।\nअर्चनां च यथान्यायं तस्य पुण्यफलं शृणु ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2212250, "chapter_id": 5521, "verse_number": "१७", "content_sanskrit": "दशजन्मकृतं पापं तस्य सद्यो विनश्यति ।\nदशानामश्वमेधानामिष्टानां लभते फलम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2212251, "chapter_id": 5521, "verse_number": "१८", "content_sanskrit": "विमानं दिव्यमारूढः कामरूपी यथासुखम् ।\nस याति मामकं लोकं रुद्रलोकमथापि वा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2212252, "chapter_id": 5521, "verse_number": "१९", "content_sanskrit": "तत्रस्थैर्देवगन्धर्वैर्गीयमानो यथासुखम् ।\nदिव्यवर्षसहस्राणि कोटिमेकं तु मोदते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2212253, "chapter_id": 5521, "verse_number": "२०", "content_sanskrit": "ततश्चापि च्युतः कालादिह लोके द्विजोत्तमः ।\nचतुर्णामपि वेदानां पारगो ब्रह्मविद् भवेत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2212254, "chapter_id": 5521, "verse_number": "२१", "content_sanskrit": "चन्द्रसूर्यग्रहे वाऽपि मम वा शङ्करस्य वा ।\nगायत्रीं मामिकां वाऽपि जपेद् यः शङ्करस्य वा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2212255, "chapter_id": 5521, "verse_number": "२२", "content_sanskrit": "शङ्खतूर्यनिनादैश्च कांस्यघण्टास्वनैरपि ।\nकारयेत्तु ध्वनिं भक्त्या तस्य पुण्यफलं शृणु ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2212256, "chapter_id": 5521, "verse_number": "२३", "content_sanskrit": "गान्धर्वैर्होमजप्यैश्च शब्दैरुत्कृष्टनादिभिः ।\nदुर्बलोऽपि भवेद्राहुः सोमश्च बलवान् भवेत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2212257, "chapter_id": 5521, "verse_number": "२४", "content_sanskrit": "सूर्येन्दूपप्लवे चैव श्रोत्रियेभ्यः प्रदीयते ।\nतत् सहस्रसमं भूत्वा दातारमुपतिष्ठति ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2212258, "chapter_id": 5521, "verse_number": "२५", "content_sanskrit": "महापातकयुक्तोऽपि यद्यपि स्यान्नरो नृप ।\nनिर्लेपस्तत्क्षणादेव तेन दानेन जायते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2212259, "chapter_id": 5521, "verse_number": "२६", "content_sanskrit": "चन्द्रसूर्यप्रकाशेन विमानेन विराजता ।\nयाति सोमपुरं रम्यं सेव्यमानोऽप्सरोगणैः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2212260, "chapter_id": 5521, "verse_number": "२७", "content_sanskrit": "यावदृक्षाणि तिष्ठन्ति गगने शशिना सह ।\nतावत्कालं स राजेन्द्र सोमलोके महीयते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2212261, "chapter_id": 5521, "verse_number": "२८", "content_sanskrit": "ततश्चापि च्युतः कालादिह लोके युधिष्ठिर ।\nवेदवेदाङ्गविद् विप्रः कोटीधनपतिर्भवेत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2212262, "chapter_id": 5521, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2212263, "chapter_id": 5521, "verse_number": "२९", "content_sanskrit": "भगवंस्तव गायत्री जप्यते च कथं नृभिः ।\nकिं वा तस्य फलं देव ममाचक्ष्व सुरेश्वर ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2212264, "chapter_id": 5521, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2212265, "chapter_id": 5521, "verse_number": "३०", "content_sanskrit": "द्वादश्यां विषुवे चैव चन्द्रसूर्यग्रहे तथा ।\nअयने श्रवणे चैव व्यतीपाते तथैव च ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2212266, "chapter_id": 5521, "verse_number": "३१", "content_sanskrit": "अश्वत्थदर्शने चैव तथा मद्दर्शनेऽपि च ।\nजप्त्वा तु मम गायत्रीमथवाऽष्टाक्षरं नृप ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2212267, "chapter_id": 5521, "verse_number": "३२", "content_sanskrit": "आर्जितं दुष्कृतं तस्य नाशयेन्नात्र संशयः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2212268, "chapter_id": 5521, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2212269, "chapter_id": 5521, "verse_number": "३३", "content_sanskrit": "अश्वत्थदर्शनं चैव किं त्वद्दर्शनसम्मितम् ।\nएतत् कथय देवेश परं कौतूहलं हि मे ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2212270, "chapter_id": 5521, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2212271, "chapter_id": 5521, "verse_number": "३४", "content_sanskrit": "अहमश्वत्थरूपेण पालयामि जगत्त्रयम् ।\nअश्वत्थो न स्थितो यत्र नाहं तत्र प्रतिष्ठितः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2212272, "chapter_id": 5521, "verse_number": "३५", "content_sanskrit": "यत्राहं संस्थितो राजनन्नश्वत्थश्चापि तत्र वै ।\nयस्त्वेनमर्चयेद् भक्त्या स मां साक्षात् समर्चति ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2212273, "chapter_id": 5521, "verse_number": "३६", "content_sanskrit": "यस्त्वेनं प्रहरेत् कोपान्मामेव प्रहरेत्तु सः ।\nतस्मात् प्रदक्षिणं कुर्यान्न च्छिन्द्यादेनमन्वहम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2212274, "chapter_id": 5521, "verse_number": "३७", "content_sanskrit": "व्रतस्य पारणं तीर्थं सर्वतीर्थेषु पाण्डव ।\nदेवशुश्रूषणं तीर्थं गुरुशुश्रूषणं तथा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2212275, "chapter_id": 5521, "verse_number": "३८", "content_sanskrit": "पुत्रस्य पारणं तीर्थमार्जवं तीर्थमुच्यते ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2212276, "chapter_id": 5521, "verse_number": "३९", "content_sanskrit": "(देवशुश्रूषणं तीर्थमर्थं ज्ञानस्य पारणम् ।)\nनराणां तोषणं तीर्थं गार्हस्थ्यं तीर्थमुच्यते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2212277, "chapter_id": 5521, "verse_number": "४०", "content_sanskrit": "आतिथेयं परं तीर्थमतिथिस्तीर्थमुच्यते ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2212278, "chapter_id": 5521, "verse_number": "४१", "content_sanskrit": "ब्रह्मचर्यं परं तीर्थं त्रेताग्निस्तीर्थमुच्यते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2212279, "chapter_id": 5521, "verse_number": "४२", "content_sanskrit": "मूलधर्मं तु विज्ञाय मनस्तत्रावधार्यताम् ।\nगच्छ तीर्थानि कौन्तेय धर्मो धर्मेण वर्धते ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2212280, "chapter_id": 5521, "verse_number": "४३", "content_sanskrit": "द्विविधं तीर्थमित्याहुः स्थावरं जङ्गमं तथा ।\nस्थावराज्जङ्गमं श्रेष्ठं ततो ज्ञानपरिग्रहः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2212281, "chapter_id": 5521, "verse_number": "४४", "content_sanskrit": "कर्मणा हि विशुद्धस्य पुरुषस्येह भारत ।\nहृदये सर्वतीर्थानि तीर्थभूतः स उच्यते ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2212282, "chapter_id": 5521, "verse_number": "४५", "content_sanskrit": "गुरुतीर्थं परं ज्ञानमतस्तीर्थं न विद्यते ।\nज्ञानं तीर्थं तपस्तीर्थं ब्रह्म तीर्थं सनातनम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2212283, "chapter_id": 5521, "verse_number": "४६", "content_sanskrit": "क्षमा तु परमं तीर्थं सर्वतीर्थेषु पाण्डव ।\nक्षमावतामयं लोकः परश्चैव क्षमावताम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2212284, "chapter_id": 5521, "verse_number": "४७", "content_sanskrit": "मानितोऽमानितो वाऽपि पूजितोऽपूजितोपि वा ।\nआक्रुष्टस्तर्जितो वाऽपि क्षमावांस्तीर्थमुच्यते ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2212285, "chapter_id": 5521, "verse_number": "४८", "content_sanskrit": "क्षमा यशः क्षमा दानं क्षमा सत्यं क्षमा तपः ।\nक्षमाऽहिंसा क्षमा धर्मः क्षमा चेन्द्रियनिग्रहः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2212286, "chapter_id": 5521, "verse_number": "४९", "content_sanskrit": "क्षमा दया क्षमा यज्ञः क्षमयैव धृतं जगत् ।\nक्षमावान् ब्राह्मणो देवः क्षमावान् ब्राह्मणो वरः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2212287, "chapter_id": 5521, "verse_number": "५०", "content_sanskrit": "क्षमावान् प्राप्नुयात् स्वर्गं क्षमावान् प्राप्नुयाद् यशः ।\nक्षमावान् प्राप्नुयान्मोक्षं तस्मात् तीर्थं स उच्यते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2212288, "chapter_id": 5521, "verse_number": "५१", "content_sanskrit": "आत्मा नदी भारतपुण्यतीर्थम्\nआत्मा तीर्थं सर्वतीर्थप्रधानम् ।\nआत्मा यज्ञः सर्वमात्मन्यथो वै\nस्वर्गो मोक्षः सर्वमात्मन्यधीनम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2212289, "chapter_id": 5521, "verse_number": "५२", "content_sanskrit": "आचारवस्त्रान्तरक्षालितेन\nसत्यप्रसन्नक्षमशीतलेन ।\nज्ञानाम्बुना स्नाति हि यो हि नित्यं\nकिं तस्य भूयः सलिलेन कृत्यम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2212290, "chapter_id": 5521, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2212291, "chapter_id": 5521, "verse_number": "५३", "content_sanskrit": "भगवन् सर्वपापघ्नं प्रायश्चित्तमदुष्करम् ।\nत्वद्भक्तस्य सुरश्रेष्ठ मम वक्तुं त्वमर्हसि ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2212292, "chapter_id": 5521, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2212293, "chapter_id": 5521, "verse_number": "५४", "content_sanskrit": "रहस्यमिदमत्यर्थमश्राव्यं पापकर्मणाम् ।\nअधार्मिकाणामश्राव्यं प्रायश्चित्तं ब्रवीमि ते ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2212294, "chapter_id": 5521, "verse_number": "५५", "content_sanskrit": "पावनं ब्राह्मणं दृष्ट्वा मद्गतेनान्तरात्मना ।\nनमो ब्रह्मण्यदेवायेत्यभिवादनमाचरेत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2212295, "chapter_id": 5521, "verse_number": "५६", "content_sanskrit": "प्रदक्षिणं च यः कुर्यात् पुनरष्टाक्षरेण तु ।\nतेन तुष्टो नरश्रेष्ठ तत् पापं क्षपयाम्यहम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2212296, "chapter_id": 5521, "verse_number": "५७", "content_sanskrit": "यत्र कृष्टां वराहस्य मृत्तिकां शिरसा वहन् ।\nप्राणायामशतं कृत्वा नरः पापैः प्रमुच्यते ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2212297, "chapter_id": 5521, "verse_number": "५८", "content_sanskrit": "दक्षिणावर्तशङ्खाद्वा कपिलाशृङ्गतोऽपि वा ।\nप्राक्स्रोतसं नदीं गत्वा ममायतनसन्निधौ ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2212298, "chapter_id": 5521, "verse_number": "५९", "content_sanskrit": "सलिलेन च विग्रहे (तु यः) स्नायात् सकृदेव रविग्रहे ।\nतस्य यत् सञ्चितं पापं तत्क्षणादेव नश्यति ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2212299, "chapter_id": 5521, "verse_number": "६०", "content_sanskrit": "मस्तकान्निःसृतैस्तोयैः कपिलाया युधिष्ठिर ।\nगोमूत्रेणापि यः स्नायाद् रोहिण्यां मम वा दिने ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2212300, "chapter_id": 5521, "verse_number": "६१", "content_sanskrit": "विप्रपादच्युतैर्वाऽपि तोयैः पापं प्रणश्यति ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2212301, "chapter_id": 5521, "verse_number": "६२", "content_sanskrit": "नमस्येद्यस्तु मद्भक्त्या शिंशुमारं प्रजापतिम् ।\nचतुर्दशाङ्गसंयुक्तं तस्य पापं प्रणश्यति ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2212302, "chapter_id": 5521, "verse_number": "६३", "content_sanskrit": "ततश्चतुर्दशाङ्गानि शृणु तस्य नराधिप ।\nशिरो धर्मो हनुर्ब्रह्मा पुच्छावुत्तरदक्षिणौ ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2212303, "chapter_id": 5521, "verse_number": "६४", "content_sanskrit": "हृदयं तु भवेद् विष्णुर्हस्तौ स्यातां तथाऽश्विनौ ।\nअत्रिर्मध्यं भवेद् राजन् लिङ्गं संवत्सरं भवेत् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2212304, "chapter_id": 5521, "verse_number": "६५", "content_sanskrit": "मित्रावरुणकौ पादौ पुच्छमूलं हुताशनः ।\nततः पश्चाद् भवेदिन्द्रस्ततः पश्चात् प्रजापतिः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2212305, "chapter_id": 5521, "verse_number": "६६", "content_sanskrit": "अभयं च ततः पश्चात् स एष ध्रुवसञ्ज्ञितः ।\nएतान्यङ्गानि सर्वाणि शिंशुमारप्रजापतेः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2212306, "chapter_id": 5521, "verse_number": "६७", "content_sanskrit": "पिबेत्तु पञ्चगव्यं यः पौर्णमास्यामुपोष्य तु ।\nतस्य नश्यति यत्पापं तत्पापं पूर्वसञ्चितम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2212307, "chapter_id": 5521, "verse_number": "६८", "content_sanskrit": "तथैव ब्रह्मकूर्चं तु समन्त्रं तु पृथक् पृथक् ।\nमासि मासि पिबेद्यस्तु तस्य पापं प्रणश्यति ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2212308, "chapter_id": 5521, "verse_number": "६९", "content_sanskrit": "पात्रं च ब्रह्मकूर्चं च शृणु मन्त्रं च भारत ।\nपालाशं पद्मपत्रं च ताम्रं वाऽथ हिरण्मयम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2212309, "chapter_id": 5521, "verse_number": "७०", "content_sanskrit": "सादयित्वा तु गृह्णीयात् तत्तु पात्रमुदाहृतम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2212310, "chapter_id": 5521, "verse_number": "७१", "content_sanskrit": "गायत्र्या गृह्य गोमूत्रं गन्धद्वारेति गोमयम् ।\nआप्यायस्वेति च क्षीरं दधिक्राविण्णेति वै दधि ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2212311, "chapter_id": 5521, "verse_number": "७२", "content_sanskrit": "तेजोऽसि शुक्रमित्याज्यं देवस्य त्वेति कुशोदकम् ।\nआपोहिष्ठेति सङ्गृह्य यवपूर्वं यथाविधि ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2212312, "chapter_id": 5521, "verse_number": "७३", "content_sanskrit": "ब्रह्मणे च यथा हुत्वा समिद्धे च हुताशने ।\nआलोड्य प्रणवेनैव निर्मथ्य प्रणवेन तु ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2212313, "chapter_id": 5521, "verse_number": "७४", "content_sanskrit": "उद्धृत्य प्रणवेनैव पिबेत्तु प्रणवेन तु ।\nमहताऽपि स पापेन त्वचेवाहिर्विमुच्यते ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2212314, "chapter_id": 5521, "verse_number": "७५", "content_sanskrit": "भद्रं त इति यः पादं पठेदृक्संहितां तदा ।\nअन्तर्जले वाऽभ्यादित्ये तस्य पापं प्रणश्यति ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2212315, "chapter_id": 5521, "verse_number": "७६", "content_sanskrit": "मम सूक्तं जपेद्यस्तु नित्यं मद्गतमानसः ।\nन स पापेन लिप्येत पद्मपत्रमिवाम्भसा ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2212316, "chapter_id": 5521, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि वैष्णवधर्मशास्त्रे बहुधर्मकथनं नाम पञ्चदशोत्तरशततमोऽध्यायः ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}]