[{"id": 2195714, "chapter_id": 5169, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2195715, "chapter_id": 5169, "verse_number": "१", "content_sanskrit": "तात कद्रूर्हसन्तीव विनतां धर्मचारिणीम् ।\nदासीवत् प्रेषयामास सा च सर्वं चकार तत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2195716, "chapter_id": 5169, "verse_number": "२", "content_sanskrit": "न विवर्णा न सङ्क्षुब्धा न च क्रुद्धा न दुःखिता ।\nप्रेष्यकर्म चकारास्या विनता कमलेक्षणा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2195717, "chapter_id": 5169, "verse_number": "३", "content_sanskrit": "इमा दिशश्चतस्रोऽस्याः प्रेष्यभावेन वर्तिताः ।\nअथ स्म वैनतेयं वै बलदर्पौ समीयतुः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2195718, "chapter_id": 5169, "verse_number": "४", "content_sanskrit": "तं दर्पवशमापन्नं परिधावन्तमन्तिकात् ।\nददर्श नारदो राजन् देवर्षिर्दर्पसंयुतम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2195719, "chapter_id": 5169, "verse_number": "५", "content_sanskrit": "तमब्रवीच्च देवर्षिर्नारदः प्रहसन्निव ।\nकिं दर्पवशमापन्नो न वै पश्यसि मातरम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2195720, "chapter_id": 5169, "verse_number": "६", "content_sanskrit": "बलेन च पुनः स्तब्धो योऽहंमानकृता सदा ।\nदासीं पन्नगराजस्य मातुरन्तर्गृहे सतीम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2195721, "chapter_id": 5169, "verse_number": "७", "content_sanskrit": "तमब्रवीद् वैनतेयो कर्म किं तन्महामते ।\nजनयित्री मयि सुते जाता दासी तपस्विनी\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2195722, "chapter_id": 5169, "verse_number": "८", "content_sanskrit": "अथाब्रवीदृषिर्वाक्यं दीव्यती विजिता खग ।\nनिकृत्या पन्नगेन्द्रस्य मात्रा पुत्रैः पुरा सह\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2195723, "chapter_id": 5169, "verse_number": "", "content_sanskrit": "गरुडः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2195724, "chapter_id": 5169, "verse_number": "९", "content_sanskrit": "कथं जिता निकृत्या सा भगवन् जननी मम ।\nब्रूहि तन्मे यथावृत्तं श्रुत्वा वेत्स्ये ततः परम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2195725, "chapter_id": 5169, "verse_number": "१०", "content_sanskrit": "ततस्तस्य यथावृत्तं सर्वं तन्नारदस्तदा ।\nआचख्यौ भरतश्रेष्ठ यथावृत्तं पतत्रिणः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2195726, "chapter_id": 5169, "verse_number": "११", "content_sanskrit": "तच्छ्रुत्वा वैनतेयस्य कोपो हृदि समाविशत् ।\nजगर्हे पन्नगान् सर्वान् मात्रा सह परन्तपः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2195727, "chapter_id": 5169, "verse_number": "१२", "content_sanskrit": "ततस्तु रोषाद् दुःखाच्च तूर्णमुत्पत्य पक्षिराट् ।\nजगाम यत्र माताऽस्य कृच्छ्रे महति वर्तते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2195728, "chapter_id": 5169, "verse_number": "१३", "content_sanskrit": "तत्रापश्यत् ततो दीनां जटिलां मलिनां कृशाम् ।\nतोयदेन प्रतिच्छन्नां सूर्याभामिव मातरम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2195729, "chapter_id": 5169, "verse_number": "१४", "content_sanskrit": "तस्य दुःखाच्च रोषाच्च नेत्राभ्यामश्रु चास्रवत् ।\nप्रवृत्तिं च निवृत्तिं च पौरुषे पथि तस्थुषः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2195730, "chapter_id": 5169, "verse_number": "१५", "content_sanskrit": "अनुक्त्वा मातरं किञ्चित् पतत्रिवरपुङ्गवः ।\nकद्रूमेव स धर्मात्मा वचनं प्रत्यभाषत\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2195731, "chapter_id": 5169, "verse_number": "१६", "content_sanskrit": "यदि धर्मेण मे माता जिता यद्यप्यधर्मतः ।\nज्येष्ठा त्वमसि मे माता धर्मः सर्वः स मे मतः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2195732, "chapter_id": 5169, "verse_number": "१७", "content_sanskrit": "इयं तु मे स्यात् कृपणा मयि पुत्रेऽम्ब दुःखिता ।\nअनुजानीहि तां साधु मत्कृते धर्मदर्शिनि\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2195733, "chapter_id": 5169, "verse_number": "१८", "content_sanskrit": "कद्रूः श्रुत्वाऽस्य तद्वाक्यं वैनतेयस्य धीमतः ।\nउवाच वाक्यं दुष्प्रज्ञा परीता दुःखमूर्च्छिता\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2195734, "chapter_id": 5169, "verse_number": "१९", "content_sanskrit": "नाहं तव न ते मातुर्वैनतेय कथञ्चन ।\nकुर्यां प्रियमनिष्टात्मा मां ब्रवीषि खग द्विज\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2195735, "chapter_id": 5169, "verse_number": "२०", "content_sanskrit": "तां तदा ब्रुवतीं वाक्यमनिष्टां क्रूरभाषिणीम् ।\nदारुणां सूनृताभिस्तामनुनेतुं प्रचक्रमे\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2195736, "chapter_id": 5169, "verse_number": "", "content_sanskrit": "गरुडः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2195737, "chapter_id": 5169, "verse_number": "२१", "content_sanskrit": "ज्येष्ठा त्वमसि कल्याणि मातुर्मे भामिनि प्रिया ।\nसोदर्यी मम चासि त्वं ज्येष्ठा माता न संशयः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2195738, "chapter_id": 5169, "verse_number": "", "content_sanskrit": "कद्रूः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2195739, "chapter_id": 5169, "verse_number": "२२", "content_sanskrit": "विहङ्गम यथाकामं गच्छ कामगम द्विज ।\nसूनृताभिस्त्वया माता नादासी शक्यमण्डज\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2195740, "chapter_id": 5169, "verse_number": "२३", "content_sanskrit": "अमृतं यद्याहरेस्त्वं विहङ्ग जननीं तव ।\nअदासीं मम पश्येमां वैनतेय न संशयः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2195741, "chapter_id": 5169, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे गरुडोपाख्याने कद्रूगरुडसंवादो नाम विंशोऽध्यायः ॥२०॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]