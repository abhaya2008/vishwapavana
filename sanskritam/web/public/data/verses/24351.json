[{"id": 7004351000, "chapter_id": 24351, "verse_number": "५-३-४५-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nएष एव पुरा प्रश्नः परिपृष्टो महेश्वरम् ।\nराज्ञा चोत्तानपादेन ऋषिदेवसमागमे॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004351001, "chapter_id": 24351, "verse_number": "५-३-४५-२", "content_sanskrit": "उत्तानपाद उवाच ।\nइदं तीर्थं महापुण्यं सर्वदेवमयं परम् ।\nगुह्याद्गुह्यतरं स्थानं न दृष्टं न श्रुतं हर॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004351002, "chapter_id": 24351, "verse_number": "५-३-४५-३", "content_sanskrit": "शूलभेदं कथं जातं केनैवोत्पादितं पुरा ।\nमाहात्म्यं तस्य तीर्थस्य विस्तराच्छंस मे प्रभो॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004351003, "chapter_id": 24351, "verse_number": "५-३-४५-४", "content_sanskrit": "ईश्वर उवाच ।\nआसीत्पुरा महावीर्यो दानवो बलदर्पितः ।\nमर्त्ये न तादृशः कश्चिद्विक्रमेण बलेन वा॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004351004, "chapter_id": 24351, "verse_number": "५-३-४५-५", "content_sanskrit": "सूनुर्ब्रह्मसुतस्यायमन्धको नाम दुर्मदः ।\nनिजस्थाने वसन् पापः कुर्वन् राज्यमकण्टकम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004351005, "chapter_id": 24351, "verse_number": "५-३-४५-६", "content_sanskrit": "हृष्टपुष्टो वसन्मर्त्ये स सुरैर्नाभिभूयते ।\nभवनं तस्य पापस्य वह्नेरुपवनं यथा॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004351006, "chapter_id": 24351, "verse_number": "५-३-४५-७", "content_sanskrit": "एतस्मिन्नन्धकः काले चिन्तयामास भारत ।\nतोषयामि महादेवं येन सानुग्रहो भवेत्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004351007, "chapter_id": 24351, "verse_number": "५-३-४५-८", "content_sanskrit": "प्रार्थयामि वरं दिव्यं यो मे मनसि वर्तते ।\nपरं स निश्चयं कृत्वा सोऽन्धको निर्गतो गृहात्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004351008, "chapter_id": 24351, "verse_number": "५-३-४५-९", "content_sanskrit": "रेवातटं समासाद्य दानवस्तपसि स्थितः ।\nउग्रं तपश्चचारासौ दारुणं लोमहर्षणम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004351009, "chapter_id": 24351, "verse_number": "५-३-४५-१०", "content_sanskrit": "दिव्यं वर्षसहस्रं स निराहारोऽभवत्ततः ।\nद्वितीयं तु सहस्रं स न्यवसद्वारिभोजनः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004351010, "chapter_id": 24351, "verse_number": "५-३-४५-११", "content_sanskrit": "तृतीयं तु सहस्रं स धूमपानरतोऽभवत् ।\nचतुर्थं वर्षसाहस्रं योगाभ्यासेन संस्थितः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004351011, "chapter_id": 24351, "verse_number": "५-३-४५-१२", "content_sanskrit": "कोपीह नेदृश चक्रे तपः परमदारुणम् ।\nअस्थिचर्मावशेषोऽसौ यावत्तिष्ठति भारत॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004351012, "chapter_id": 24351, "verse_number": "५-३-४५-१३", "content_sanskrit": "तस्य मूर्ध्नि ततो राजन् धूमवार्त्तिर्विनिःसृता ।\nदेवलोकमतीत्यासौ कैलासं व्याप्य संस्थिता॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004351013, "chapter_id": 24351, "verse_number": "५-३-४५-१४", "content_sanskrit": "तावद्देवसमीपस्था उमा वचनमब्रवीत् ।\nकोऽस्त्ययं मानुषे लोके तपसोग्रेण संस्थितः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004351014, "chapter_id": 24351, "verse_number": "५-३-४५-१५", "content_sanskrit": "चतुर्वर्षसहस्राणि व्यतीयुः परमेश्वर ।\nन केनापीदृशं तप्तं तपो दृष्टं श्रुतं तथा॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004351015, "chapter_id": 24351, "verse_number": "५-३-४५-१६", "content_sanskrit": "अवज्ञां कुरुषे देव किमत्र नियमान्विते ।\nसर्वस्य दत्से शीघ्रं त्वमल्पेन तपसा विभो॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004351016, "chapter_id": 24351, "verse_number": "५-३-४५-१७", "content_sanskrit": "नाक्षक्रीडां करिष्येऽद्य त्वया सह महेश्वर ।\nयावन्नोत्थाप्यते ह्येष दानवो भक्तवत्सल॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004351017, "chapter_id": 24351, "verse_number": "५-३-४५-१८", "content_sanskrit": "ईश्वर उवाच ।\nसाधु साधु महादेवि सर्वलक्षणलक्षिते ।\nअहं तं न विजानामि क्लिश्यन्तं दानवेश्वरम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004351018, "chapter_id": 24351, "verse_number": "५-३-४५-१९", "content_sanskrit": "योगाभ्यासे स्थितो भद्रे ध्यायंस्तत्परमं पदम् ।\nतत्रागच्छ मया सार्द्धं यत्र तप्यत्यसौ तपः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004351019, "chapter_id": 24351, "verse_number": "५-३-४५-२०", "content_sanskrit": "उमया सहितो देवो गतस्तत्र महेश्वरः ।\nअस्थिचर्मावशेषस्तु दृष्टो देवेन शम्भुना॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004351020, "chapter_id": 24351, "verse_number": "५-३-४५-२१", "content_sanskrit": "प्रत्युवाच प्रसन्नोऽसौ देवदेवो महेश्वरः ।\nभोभोः कष्टं कृतं भीमं दारुणं लोमहर्षणम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004351021, "chapter_id": 24351, "verse_number": "५-३-४५-२२", "content_sanskrit": "ईदृशं च तपो घोरं कस्माद्वत्स त्वया कृतम् ।\nवरं दास्याम्यहं वत्स यस्ते मनसि वर्तते॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004351022, "chapter_id": 24351, "verse_number": "५-३-४५-२३", "content_sanskrit": "अन्धक उवाच ।\nयदि तुष्टोऽसि मे देव वरदो यदि शङ्कर ।\nसुरान् सर्वान् विजेष्यामि त्वत्प्रसादान्महेश्वर॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004351023, "chapter_id": 24351, "verse_number": "५-३-४५-२४", "content_sanskrit": "ईश्वर उवाच ।\nस्वप्नेऽपि त्रिदशाः सर्वे न योद्धव्याः कदाचन ।\nअसंभाव्यं न वक्तव्यं मनसो यन्न रोचते॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004351024, "chapter_id": 24351, "verse_number": "५-३-४५-२५", "content_sanskrit": "अन्यं किमपि याचस्व यस्ते मनसि वर्तते ।\nस्वर्गे वा यदि वा मर्त्ये पातालेषु च संस्थितान्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004351025, "chapter_id": 24351, "verse_number": "५-३-४५-२६", "content_sanskrit": "मर्त्येषु विविधान् भोगान् भोक्ष्यसि त्वं यथेप्सितान् ।\nकुरु निष्कण्टकं राज्यं स्वर्गे देवपतिर्यथा॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004351026, "chapter_id": 24351, "verse_number": "५-३-४५-२७", "content_sanskrit": "देवस्य वचनं श्रुत्वा सोऽन्धको विमनाः स्थितः ।\nवृथा क्लेशश्च मे जातो न किंचित्साधितं मया॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004351027, "chapter_id": 24351, "verse_number": "५-३-४५-२८", "content_sanskrit": "निश्वासं परमं मुक्त्वा निपपात धरातले ।\nमूलच्छिन्नो यथा वृक्षो निरुच्छ्वासस्तदाभवत्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004351028, "chapter_id": 24351, "verse_number": "५-३-४५-२९", "content_sanskrit": "मूर्च्छापन्नं ततो दृष्ट्वा देवी वचनमब्रवीत् ।\nयं कामं कामयत्येष तमस्मै देहि शङ्कर॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004351029, "chapter_id": 24351, "verse_number": "५-३-४५-३०", "content_sanskrit": "भक्तानुपेक्षमाणस्य तवाकीर्तिर्भविष्यति॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004351030, "chapter_id": 24351, "verse_number": "५-३-४५-३१", "content_sanskrit": "ईश्वर उवाच ।\nयदि दास्ये वरं देवि इच्छाभूतं कदाचन ।\nततो न मंस्यते विष्णुं न ब्रह्माणं न मामपि॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004351031, "chapter_id": 24351, "verse_number": "५-३-४५-३२", "content_sanskrit": "उच्चत्वमाप्तो देवेशि अन्यानपि सुरासुरान्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004351032, "chapter_id": 24351, "verse_number": "५-३-४५-३३", "content_sanskrit": "देव्युवाच ।\nकमप्युपायमाश्रित्य उत्थापय महेश्वर ।\nविष्णुवर्जं सुरान्सर्वाञ्जयस्वेति वरं वद॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004351033, "chapter_id": 24351, "verse_number": "५-३-४५-३४", "content_sanskrit": "ईश्वर उवाच ।\nउपायः शोभनो देवि यो मे मनसि वर्तते ।\nतमेवास्मै प्रदास्यामि यस्त्वया कथितो वरः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004351034, "chapter_id": 24351, "verse_number": "५-३-४५-३५", "content_sanskrit": "ततोऽमृतेन संसिक्तः स्वस्थोऽभूत्तत्क्षणादयम् ।\nतथा पुनर्नवो जातः सर्वावयवशोभितः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004351035, "chapter_id": 24351, "verse_number": "५-३-४५-३६", "content_sanskrit": "शृणुष्वैकमना भूत्वा गृहाण वरमुत्तमम् ।\nविष्णुवर्जं प्रदास्यामि यत्तवाभिमतं प्रियम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004351036, "chapter_id": 24351, "verse_number": "५-३-४५-३७", "content_sanskrit": "सर्वं च सफलं तुभ्यं मा धर्मस्तेऽन्यथा भवेत् ।\nददामीति वरं तुभ्यं मन्यसे यदि चासुर॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004351037, "chapter_id": 24351, "verse_number": "५-३-४५-३८", "content_sanskrit": "विष्णुवर्जं सुरान् सर्वाञ्जेष्यसि त्वं च मां विना॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004351038, "chapter_id": 24351, "verse_number": "५-३-४५-३९", "content_sanskrit": "अन्धक उवाच ।\nभवत्वेवमिति प्राह बलमास्थाय केवलम् ।\nविष्णुवर्जं विजेष्येऽहं स्वबलेन महेश्वर॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004351039, "chapter_id": 24351, "verse_number": "५-३-४५-४०", "content_sanskrit": "कृतार्थोऽहं हि संजात इत्युक्त्वा प्रणतिं गतः ।\nगच्छ देवोमयासार्द्धं कैलासशिखरं वरम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004351040, "chapter_id": 24351, "verse_number": "५-३-४५-४१", "content_sanskrit": "वृषपुंगवमारुह्य देवोऽसावुमया सह ।\nवरं दत्त्वा स तस्यैवं तत्रैवान्तरधीयत॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]