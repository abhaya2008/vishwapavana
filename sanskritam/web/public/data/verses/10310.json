[{"id": 6000310000, "chapter_id": 10310, "verse_number": null, "content_sanskrit": "नवमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000310001, "chapter_id": 10310, "verse_number": null, "content_sanskrit": "ब्राह्मण उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.001.m4a", "display_order": 2}, {"id": 6000310002, "chapter_id": 10310, "verse_number": "११-९-१", "content_sanskrit": "परिग्रहोऽयं दुःखाय यद्यत् प्रियतमं नृणाम्।\nअन्ततः सुखमाप्नोति तद् विद्वान् यस्त्वकिञ्चनः॥ ११/९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.002.m4a", "display_order": 3, "topics": [{"text": "अवधूतस्य कुररादिसप्तगुरुभ्यः प्राप्तबुद्धिकथनम्", "range": "१–२३"}]}, {"id": 6000310003, "chapter_id": 10310, "verse_number": "११-९-२", "content_sanskrit": "सामिषं कुररं जघ्नुर्बलिनो ये निरामिषाः।\nतदामिषं परित्यज्य स सुखं समविन्दत॥ ११/९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.003.m4a", "display_order": 4}, {"id": 6000310004, "chapter_id": 10310, "verse_number": "११-९-३", "content_sanskrit": "न मे मानावमानौ स्तो न चिन्ता गेहपुत्रिणाम्।\nआत्मक्रीड आत्मरतो विचरामीह बालवत्॥ ११/९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.004.m4a", "display_order": 5}, {"id": 6000310005, "chapter_id": 10310, "verse_number": "११-९-४", "content_sanskrit": "द्वावेव चिन्तया मुक्तौ परमानन्द आप्लुतौ।\nयो विमूढो जडो बालो यो गुणेभ्यः परं गतः॥ ११/९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.005.m4a", "display_order": 6}, {"id": 6000310006, "chapter_id": 10310, "verse_number": "११-९-५", "content_sanskrit": "क्‍वचित् कुमारी त्वात्मानं वृण्वानान् गृहमागतान्।\nस्वयं तानर्हयामास क्‍वापि यातेषु बन्धुषु॥ ११/९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.006.m4a", "display_order": 7}, {"id": 6000310007, "chapter_id": 10310, "verse_number": "११-९-६", "content_sanskrit": "तेषामभ्यवहारार्थं शालीन् दृषदि पार्थिव।\nअवघ्नन्त्याः प्रकोष्ठस्थाश्चक्रुः शङ्खाः स्वनं महत्॥ ११/९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.007.m4a", "display_order": 8}, {"id": 6000310008, "chapter_id": 10310, "verse_number": "११-९-७", "content_sanskrit": "सा तं जुगुप्सितं मत्वा महती व्रीडिता ततः।\nबभञ्जैकैकशः शङ्खान् द्वौ द्वौ पाण्योरशेषयत्॥ ११/९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.008.m4a", "display_order": 9}, {"id": 6000310009, "chapter_id": 10310, "verse_number": "११-९-८", "content_sanskrit": "उभयोरप्यभूद् घोषो अवघ्नन्त्याः स्म शङ्खयोः।\nतत्राप्येकं निरभिनदेकस्मान्न भवेत् ध्वनिः॥ ११/९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.009.m4a", "display_order": 10}, {"id": 6000310010, "chapter_id": 10310, "verse_number": "११-९-९", "content_sanskrit": "अन्वशिक्षमिमं तस्या उपदेशमरिन्दम।\nलोकाननुचरन्नेताल्लोकतत्त्वविवित्सया॥ ११/९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.010.m4a", "display_order": 11}, {"id": 6000310011, "chapter_id": 10310, "verse_number": "११-९-१०", "content_sanskrit": "वासो बहूनां कलहो भवेद् वार्ता द्वयोरपि।\nएक एव चरेत् तस्मात् कुमार्या इव कङ्कणः॥ ११/९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.011.m4a", "display_order": 12}, {"id": 6000310012, "chapter_id": 10310, "verse_number": "११-९-११", "content_sanskrit": "मन एकत्र संयुज्याज्जितश्वासो जितासनः।\nवैराग्याभ्यासयोगेन ध्रियमाणमतन्द्रितः॥ ११/९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.012.m4a", "display_order": 13}, {"id": 6000310013, "chapter_id": 10310, "verse_number": "११-९-१२", "content_sanskrit": "यस्मिन् मनो लब्धपदं यदेतच्छनैः शनैर्मुञ्चति कर्मरेणून्।\nसत्त्वेन वृद्धेन रजस्तमश्च विधूय निर्वाणमुपैत्यनिन्धनम्॥ ११/९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.013.m4a", "display_order": 14}, {"id": 6000310014, "chapter_id": 10310, "verse_number": "११-९-१३", "content_sanskrit": "तदेवमात्मन्यवरुद्धचित्तो न वेद किञ्चिद् बहिरन्तरं वा।\nयथेषुकारो नृपतिं व्रजन्तमिषौ गतात्मा न ददर्श पार्श्वे॥ ११/९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.014.m4a", "display_order": 15}, {"id": 6000310015, "chapter_id": 10310, "verse_number": "११-९-१४", "content_sanskrit": "एकचार्यनिकेतः स्यादप्रमत्तो गुहाशयः।\nअलक्ष्यमाण आचारैर्मुनिरेकोऽल्पतोषणः॥ ११/९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.015.m4a", "display_order": 16}, {"id": 6000310016, "chapter_id": 10310, "verse_number": "११-९-१५", "content_sanskrit": "गृहारम्भो हि दुःखाय विफलश्चाध्रुवात्मनः।\nसर्पः परकृतं वेश्म प्रविश्य सुखमेधते॥ ११/९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.016.m4a", "display_order": 17}, {"id": 6000310017, "chapter_id": 10310, "verse_number": "११-९-१६", "content_sanskrit": "एको नारायणो देवः पूर्वसृष्टं स्वमायया।\nसंहृत्य कालकलया कल्पान्त इदमीश्वरः॥ ११/९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.017.m4a", "display_order": 18}, {"id": 6000310018, "chapter_id": 10310, "verse_number": "११-९-१७", "content_sanskrit": "एक एवाद्वितीयोऽभूदात्माधारोऽखिलाश्रयः।\nकालेनात्मानुभावेन साम्यं नीतासु शक्तिषु॥ ११/९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.018.m4a", "display_order": 19}, {"id": 6000310019, "chapter_id": 10310, "verse_number": "११-९-१८", "content_sanskrit": "सत्त्वादिष्वादिपुरुषः प्रधानपुरुषेश्वरः।\nपरावराणां परम आस्ते कैवल्यसंज्ञितः॥ ११/९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.019.m4a", "display_order": 20}, {"id": 6000310020, "chapter_id": 10310, "verse_number": "११-९-१९", "content_sanskrit": "केवलानुभवानन्दसन्दोहो निरुपाधिकः।\nकालेनात्मानुभावेन स्वमायां त्रिगुणात्मिकाम्॥ ११/९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.020.m4a", "display_order": 21}, {"id": 6000310021, "chapter_id": 10310, "verse_number": "११-९-२०", "content_sanskrit": "संक्षोभयन् सृजत्यादौ तया सूत्रमरिन्दम। तामाहुस्‍त्रिगुणां व्यक्तिं सृजतीं विश्वतोमुखम्।\nयस्मिन् प्रोतमिदं विश्वं येन संसरते पुमान्॥ ११/९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.021.m4a", "display_order": 22}, {"id": 6000310022, "chapter_id": 10310, "verse_number": "११-९-२१", "content_sanskrit": "यथोर्णनाभिर्हृदयादूर्णां सन्तत्य वक्त्रतः।\nतया विहृत्य भूयस्तां ग्रसत्येवं महेश्वरः॥ ११/९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.022.m4a", "display_order": 23}, {"id": 6000310023, "chapter_id": 10310, "verse_number": "११-९-२२", "content_sanskrit": "यत्र यत्र मनो देही धारयेत् सकलं धिया।\nस्नेहाद् द्वेषाद् भयाद् वापि याति तत्तत्सरूपताम्॥ ११/९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.023.m4a", "display_order": 24}, {"id": 6000310024, "chapter_id": 10310, "verse_number": "११-९-२३", "content_sanskrit": "कीटः पेशस्करं ध्यायन् कुड्यां तेन प्रवेशितः।\nयाति तत्साम्यतां राजन् पूर्वरूपमसंत्यजन्॥ ११/९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.024.m4a", "display_order": 25}, {"id": 6000310025, "chapter_id": 10310, "verse_number": "११-९-२४", "content_sanskrit": "एवं गुरुभ्य एतेभ्य एषा मे शिक्षिता मतिः।\nस्वात्मोपशिक्षितां बुद्धिं शृणु मे वदतः प्रभो॥ ११/९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.025.m4a", "display_order": 26, "topics": [{"text": "अवधूतेतिहाससमाप्तिः", "range": "२४–२९"}]}, {"id": 6000310026, "chapter_id": 10310, "verse_number": "११-९-२५", "content_sanskrit": "देहो गुरुर्मम विरक्तिविवेकहेतुर्बिभ्रत् स्म सत्त्वनिधनं सततात्युदर्कम्।\nतत्वान्यनेन विमृशामि यथा तथापि पारक्यमित्यवसितो विचराम्यसङ्गः॥ ११/९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.026.m4a", "display_order": 27}, {"id": 6000310027, "chapter_id": 10310, "verse_number": "११-९-२६", "content_sanskrit": "जायात्मजार्थपशुभृत्यगृहाप्तवर्गान् पुष्णाति यः प्रियचिकीर्षया वितन्वन्।\nसोऽन्ते सुकृच्छ्रमवरुद्धमनाः स्वदेहं सृष्ट्वा स्वबीजमवसीदति वृक्षधर्मा॥ ११/९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.027.m4a", "display_order": 28}, {"id": 6000310028, "chapter_id": 10310, "verse_number": "११-९-२७", "content_sanskrit": "जिह्वैकतोऽमुमपकर्षति कर्हि तर्षा शिश्नोऽन्यतस्त्वगुदरं श्रवणं कुतश्चित्।\nघ्राणोऽन्यतश्चपलदृक् क्‍व च कर्मशक्तिर्बह्व्यः सपत्न्य इव गेहपतिं लुनन्ति॥ ११/९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.028.m4a", "display_order": 29}, {"id": 6000310029, "chapter_id": 10310, "verse_number": "११-९-२८", "content_sanskrit": "सृष्ट्वा पुराणि विविधान्यजयाऽऽत्मशक्त्या वृक्षान् सरीसृपपशून् खगदंशमत्स्यान्।\nतैस्तैरतुष्टहृदयः पुरुषं विधाय ब्रह्मावबोधधिषणं मुदमाप देवः॥ ११/९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.029.m4a", "display_order": 30}, {"id": 6000310030, "chapter_id": 10310, "verse_number": "११-९-२९", "content_sanskrit": "लब्ध्वा सुदुर्लभमिदं बहुसम्भवान्ते मानुष्यमर्थदमनित्यमपीह धीरः।\nतूर्णं यतेत न पतेदनुमृत्यु यावन्निःश्रेयसाय विषयः खलु सर्वतः स्यात्॥ ११/९/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.030.m4a", "display_order": 31}, {"id": 6000310031, "chapter_id": 10310, "verse_number": "११-९-३०", "content_sanskrit": "एवं सञ्जातवैराग्यो विज्ञानालोक आत्मनि।\nविचरामि महीमेतां मुक्तसङ्गोऽनहङ्कृतिः॥ ११/९/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.031.m4a", "display_order": 32}, {"id": 6000310032, "chapter_id": 10310, "verse_number": "११-९-३१", "content_sanskrit": "न ह्येकस्माद् गुरोर्ज्ञानं सुस्थिरं स्यात् सुपुष्कलम्।\nब्रह्मैतदद्वितीयं वै गीयते बहुधर्षिभिः॥ ११/९/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.032.m4a", "display_order": 33}, {"id": 6000310033, "chapter_id": 10310, "verse_number": null, "content_sanskrit": "श्री भगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.033.m4a", "display_order": 34}, {"id": 6000310034, "chapter_id": 10310, "verse_number": "११-९-३२", "content_sanskrit": "इत्युक्त्वा स यदुं विप्रस्तमामन्त्र्याङ्ग धीरधीः।\nवन्दितोऽभ्यर्चितो राज्ञा ययौ प्रीतो यथागतम्॥ ११/९/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.034.m4a", "display_order": 35}, {"id": 6000310035, "chapter_id": 10310, "verse_number": "११-९-३३", "content_sanskrit": "अवधूतवचः श्रुत्वा सर्वेषां नः स पूर्वजः।\nसर्वसङ्गविनिर्मुक्तः समचित्तो बभूव ह॥ ११/९/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_009/BhP_11.009.035.m4a", "display_order": 36}, {"id": 6000310036, "chapter_id": 10310, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे नवमाध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]