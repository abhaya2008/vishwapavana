[{"id": 7003494000, "chapter_id": 23494, "verse_number": "१३४-१", "content_sanskrit": "अथ पूजादिसामयिकापराधेषु प्रायश्चित्तानि ।\nश्रीवराह उवाच ।\nमुक्त्वा तु मम कर्माणि मम कर्मपरायणः ।\nप्रायश्चित्तविधिं देवि यस्तु वाक्यं प्रभाषते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003494001, "chapter_id": 23494, "verse_number": "१३४-२", "content_sanskrit": "मूर्खो भवति सुश्रोणि मम कर्मपरायणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003494002, "chapter_id": 23494, "verse_number": "१३४-३", "content_sanskrit": "प्रायश्चित्तविधिं देवि येन मुच्येत किल्बिषात् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003494003, "chapter_id": 23494, "verse_number": "१३४-४", "content_sanskrit": "आकाशशयनं कृत्वा दिनानि दश पञ्च च ।\nमुच्यते किल्बिषात्तत्र देवि चैव न संशयः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003494004, "chapter_id": 23494, "verse_number": "१३४-५", "content_sanskrit": "इति मौनत्यागप्रायश्चित्तम् ।\nश्रीवराह उवाच ।\nभूषितो नीलवस्त्रेण यो हि मामुपपद्यते ।\nवर्षाणां हि शतं पञ्च कृमिर्भूत्वा स तिष्ठति ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003494005, "chapter_id": 23494, "verse_number": "१३४-६", "content_sanskrit": "तस्य वक्ष्यामि सुश्रोणि अपराधविशोधनम् ।\nप्रायश्चित्तं विशालाक्षि येन मुच्येत किल्बिषात् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003494006, "chapter_id": 23494, "verse_number": "१३४-७", "content_sanskrit": "व्रतं चान्द्रायणं कृत्वा विधिदृष्टेन कर्मणा ।\nमुच्यते किल्बिषाद्भूमे एवमेतन्न संशयः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003494007, "chapter_id": 23494, "verse_number": "१३४-८", "content_sanskrit": "अविधानेन संस्पृश्य यो हि मामुपसर्पति ।\nस मूर्खः पापकर्मा च मम विप्रियकारकः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003494008, "chapter_id": 23494, "verse_number": "१३४-९", "content_sanskrit": "तेन दत्तं वरारोहे गन्धमाल्यसुगन्धितम् ।\nप्रापणं च न गृह्णामि मृष्टं चापि कदाचन ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003494009, "chapter_id": 23494, "verse_number": "१३४-१०", "content_sanskrit": "ततो नारायणवचः श्रुत्वा सा संशितव्रता ।\nउवाच मधुरं वाक्यं धर्मकामा वसुन्धरा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003494010, "chapter_id": 23494, "verse_number": "१३४-११", "content_sanskrit": "धरण्युवाच ।\nयन्मां त्वं भाषसे नाथ आचारस्य व्यतिक्रमम् ।\nउपस्पृश्य समाचारं रहस्यं वक्तुमर्हसि ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003494011, "chapter_id": 23494, "verse_number": "१३४-१२", "content_sanskrit": "केन कर्मविधानेन भूत्वा भागवता भुवि ।\nउपस्पृश्योपसर्पन्ति तव कर्मपरायणाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003494012, "chapter_id": 23494, "verse_number": "१३४-१३", "content_sanskrit": "एतन्मे संशयं देव परं कौतूहलं हि मे ।\nतव भक्तसुखार्थाय निष्कलं वक्तुमर्हसि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003494013, "chapter_id": 23494, "verse_number": "१३४-१४", "content_sanskrit": "श्रीवराह उवाच ।\nशृणु तत्त्वेन मे देवि यन्मां त्वं भीरु भाषसे ।\nकथितं मम तत्त्वेन गुह्यमेतत्परं महत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003494014, "chapter_id": 23494, "verse_number": "१३४-१५", "content_sanskrit": "विमुच्य सर्वकर्माणि यो हि मामुपसर्पति ।\nतस्य वै शृणु सुश्रोणि उपस्पृश्य च या क्रिया ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003494015, "chapter_id": 23494, "verse_number": "१३४-१६", "content_sanskrit": "भूत्वा पूर्वमुखस्तत्र पादौ प्रक्षाल्य चाम्बुभिः ।\nउपस्पृश्य यथान्यायं तिस्रो वै गृह्य मृत्तिकाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003494016, "chapter_id": 23494, "verse_number": "१३४-१७", "content_sanskrit": "ततः प्रक्षालितं हस्तं जलेन तदनन्तरम् ।\nसप्तकोशं ततो गृह्य जलेन क्षालयेत्ततः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003494017, "chapter_id": 23494, "verse_number": "१३४-१८", "content_sanskrit": "पादमेकैकशस्तद्वत्पंच पञ्च वदेत्ततः ।\nकोशौ संमृज्यतां तत्र यदीच्छेत्तु मम प्रियम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003494018, "chapter_id": 23494, "verse_number": "१३४-१९", "content_sanskrit": "त्रीणि कोशान्पिबेत्तत्र सर्वपापविशोधनम् ।\nमुखं कराभ्यां मार्जेत सर्वमिन्द्रियनिग्रहम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003494019, "chapter_id": 23494, "verse_number": "१३४-२०", "content_sanskrit": "प्राणायामं ततः कृत्वा मम चिन्तापरायणः ।\nकर्मणा विधिदृष्टेन कुर्यात्संसारमोक्षणम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003494020, "chapter_id": 23494, "verse_number": "१३४-२१", "content_sanskrit": "त्रीणि वारान्स्पृशेत्तत्र शिरो ब्रह्मणि संस्थितः ।\nत्रीणि वारान्पुनस्तत्र उभे ते कर्णनासिके ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003494021, "chapter_id": 23494, "verse_number": "१३४-२२", "content_sanskrit": "स्पृशेत्तु निष्कलस्तत्र यो हि यत्र प्रतिष्ठितः ।\nविक्षिपेत्त्रीणि वाराणि सलिलं प्रवरं त्रयम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003494022, "chapter_id": 23494, "verse_number": "१३४-२३", "content_sanskrit": "एवमुक्तस्य कर्त्तव्यं ममाभिगमनेषु च ।\nउपस्पृश्य तनुं वामे यदीक्षेत प्रियं मम ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003494023, "chapter_id": 23494, "verse_number": "१३४-२४", "content_sanskrit": "एवं च कुर्वतस्तस्य मम कर्मव्यवस्थितः ।\nअपराधं न विन्देत एवं देवि न संशयः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003494024, "chapter_id": 23494, "verse_number": "१३४-२५", "content_sanskrit": "ततो नारायणवचः श्रुत्वा देवी वसुन्धरा ।\nउवाच मधुरं वाक्यं सर्वभागवतप्रियम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003494025, "chapter_id": 23494, "verse_number": "१३४-२६", "content_sanskrit": "धरण्युवाच ।\nउपस्पृश्य विधानेन यस्तु कर्माणि चाप्नुयात्।\nतापनं शोधनं चैव तद्भवान्वक्तुमर्हति ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003494026, "chapter_id": 23494, "verse_number": "१३४-२७", "content_sanskrit": "श्रीवराह उवाच ।\nशृणु तत्त्वेन मे भूमे इमं गुह्यमनिन्दिते ।\nयां गतिं च प्रपद्यन्ते मम कर्मबहिष्कृताः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003494027, "chapter_id": 23494, "verse_number": "१३४-२८", "content_sanskrit": "व्यभिचारं च मे कृत्वा यश्च मामुपसर्पति ।\nदशवर्षसहस्राणि दशवर्षशतानि च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003494028, "chapter_id": 23494, "verse_number": "१३४-२९", "content_sanskrit": "कृमिर्भूत्वा यथान्याय्यं तिष्ठते नात्र संशयः ।\nप्रायश्चित्तं प्रवक्ष्यामि तस्य मूर्खस्य माधवि ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003494029, "chapter_id": 23494, "verse_number": "१३४-३०", "content_sanskrit": "यच्च कृत्वा महाभागे कृतकृत्यः पुनर्भवेत् ।\nमहासान्तपनं कृत्वा तप्तकृच्छ्रं च निष्कलम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003494030, "chapter_id": 23494, "verse_number": "१३४-३१", "content_sanskrit": "ब्राह्मणः क्षत्रियो वैश्यो मम ये च मते स्थिताः ।\nअनेन विधिना कृत्वा प्रायश्चित्तं यशस्विनि ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003494031, "chapter_id": 23494, "verse_number": "१३४-३२", "content_sanskrit": "किल्बिषात्तु प्रमुक्तास्ते गच्छन्ति परमां गतिम् ।\nयस्तु क्रोधसमाविष्टो मम भक्तिपरायणः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003494032, "chapter_id": 23494, "verse_number": "१३४-३३", "content_sanskrit": "स्पृशेत मम गात्राणि चित्तं कृत्वा चलाचलम् ।\nन चाहं रागमिच्छामि क्रुद्धमेव यशस्विनि ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003494033, "chapter_id": 23494, "verse_number": "१३४-३४", "content_sanskrit": "इच्छामि च सदा दान्तं शुभं भागवतं शुचिम् ।\nपंचेन्द्रियसमायुक्तं लाभालाभविवर्जितम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003494034, "chapter_id": 23494, "verse_number": "१३४-३५", "content_sanskrit": "अहङ्कारविनिर्मुक्तं कमर्ण्यभिरतं मम ।\nअन्यच्च ते प्रवक्ष्यामि तच्छृणुष्व वरानने ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003494035, "chapter_id": 23494, "verse_number": "१३४-३६", "content_sanskrit": "मां यदा लभते क्रुद्धः शुद्धो भागवतः शुचिः ।\nचिल्ली जातो वर्षशतं श्येनो वर्षशतं पुनः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003494036, "chapter_id": 23494, "verse_number": "१३४-३७", "content_sanskrit": "भेकस्त्रिशतवर्षाणि यातुधानः पुनर्दश ।\nअपुमान्षट् च वर्षाणि रेतोभक्षस्तु जायते ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003494037, "chapter_id": 23494, "verse_number": "१३४-३८", "content_sanskrit": "अन्धो जायेत सुश्रोणि पंच सप्त तथा नव ।\nगृध्रो द्वात्रिंशवर्षाणि चक्रवाको दशैव तु ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003494038, "chapter_id": 23494, "verse_number": "१३४-३९", "content_sanskrit": "शैवालभक्षिता चैव ह्याकाशगमनं तथा ।\nब्राह्मणो जायते भूमे क्रोधस्य च पथे स्थितः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003494039, "chapter_id": 23494, "verse_number": "१३४-४०", "content_sanskrit": "आत्मकर्मापराधेन प्राप्तः संसारसागरे ।\nधरण्युवाच ।\nअहो वै परमं गुह्यं यत्त्वया पूर्वभाषितम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003494040, "chapter_id": 23494, "verse_number": "१३४-४१", "content_sanskrit": "जातं मे विह्वलं चित्तं न स्थिरं जायते क्वचित् ।\nयत्त्वया भाषितं हीदं भक्तानां च दुरासदम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003494041, "chapter_id": 23494, "verse_number": "१३४-४२", "content_sanskrit": "श्रुत्वा सुदुस्तरं सारं भीतास्मि परिदेविता ।\nनाहमाज्ञापयामि त्वां देवदेव जगत्पते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003494042, "chapter_id": 23494, "verse_number": "१३४-४३", "content_sanskrit": "मम चैव प्रियार्थाय सर्वलोकसुखावहम् ।\nयेन मुच्यन्ति संशुद्धा बुधाः कर्मपरायणाः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003494043, "chapter_id": 23494, "verse_number": "१३४-४४", "content_sanskrit": "अल्पसत्त्वा गतभया लोभमोहसमन्विताः ।\nतरन्ति येन दुर्गाणि प्रायश्चित्तं च मे वद ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003494044, "chapter_id": 23494, "verse_number": "१३४-४५", "content_sanskrit": "ततः कमलपत्राक्षो वराहः सम्मुखे स्थितः।\nसनत्कुमारो मे भक्तो पुनर्नारायणोऽब्रवीत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003494045, "chapter_id": 23494, "verse_number": "१३४-४६", "content_sanskrit": "ततो भूम्या वचः श्रुत्वा ब्रह्मणश्च सुतो मुनिः ।\nसनत्कुमारो योगज्ञः प्रत्युवाच वसुन्धराम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003494046, "chapter_id": 23494, "verse_number": "१३४-४७", "content_sanskrit": "धन्या चैव सुभाग्या च यत्त्वया परिपृच्छितम् ।\nवराहरूपी भगवान्सर्वमायाकरण्डकः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003494047, "chapter_id": 23494, "verse_number": "१३४-४८", "content_sanskrit": "किं त्वया भाषितो देवि सर्वयोगाङ्गयोगवित् ।\nदेवो नारायणस्तत्र सर्वधर्मविदां वरः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003494048, "chapter_id": 23494, "verse_number": "१३४-४९", "content_sanskrit": "कुमारवचनं श्रुत्वा तं मही प्रत्यभाषत ।\nशृणु  तत्त्वेन मे ब्रह्मन्यन्मया परिपृच्छितम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003494049, "chapter_id": 23494, "verse_number": "१३४-५०", "content_sanskrit": "कार्यं क्रियां च योगं च आध्यात्म्यं पार्थिवस्थितम् ।\nएतन्मे पृच्छते ब्रह्मन्देवो नारायणः प्रभुः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003494050, "chapter_id": 23494, "verse_number": "१३४-५१", "content_sanskrit": "ततो मां भाषते ब्रह्मन्विष्णुर्मायाकरण्डकः ।\nक्रुद्धा भागवता ब्रह्मन्येन शुद्ध्यन्ति किल्बिषात् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003494051, "chapter_id": 23494, "verse_number": "१३४-५२", "content_sanskrit": "कृत्वा तेन व्रतं चैव मम कर्मपरायणः ।\nषष्ठे काले तु भुञ्जीत गृहभिक्षामनिन्दिताम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003494052, "chapter_id": 23494, "verse_number": "१३४-५३", "content_sanskrit": "अष्टौ भिक्षा यथान्यायं शुद्धभागवतां गृहे ।\nय एतेन विधानेन ब्रह्मकर्माणि कारयेत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003494053, "chapter_id": 23494, "verse_number": "१३४-५४", "content_sanskrit": "मुच्यते किल्बिषात्तस्मादेवमाह जनार्दनः ।\nयदीच्छसि परां सिद्धिं विष्णुलोकं जनार्दनात् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003494054, "chapter_id": 23494, "verse_number": "१३४-५५", "content_sanskrit": "शीघ्रमाराधयेद्विष्णुं द्विजमुख्यो न संशयः ।\nततो भूमेर्वचः श्रुत्वा ब्रह्मणश्च सुतो मुनिः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003494055, "chapter_id": 23494, "verse_number": "१३४-५६", "content_sanskrit": "प्रत्युवाच विशालाक्षीं धर्मकामो वसुन्धराम् ।\nअहो गुह्यं रहस्यं च यत्त्वया देवि भाषितम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003494056, "chapter_id": 23494, "verse_number": "१३४-५७", "content_sanskrit": "तस्य ये मुखनिष्क्रान्ता धर्मास्तान्वक्तुमर्हसि ।\nधरण्युवाच ।\nततः स पुण्डरीकाक्षः शङ्खचक्रगदाधरः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003494057, "chapter_id": 23494, "verse_number": "१३४-५८", "content_sanskrit": "वराहरूपी भगवाँल्लोकनाथो जनार्दनः ।\nउवाच मधुरं वाक्यं मेघदुन्दुभिनिःस्वनः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003494058, "chapter_id": 23494, "verse_number": "१३४-५९", "content_sanskrit": "भक्तकर्मसुखार्थाय गुणवित्तसमन्विताम् ।\nअनेनैव  विधानेन आचारेण समन्वितः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003494059, "chapter_id": 23494, "verse_number": "१३४-६०", "content_sanskrit": "देवि कारयते कर्म मम लोकं स गच्छति ।\nक्रुद्धेन  न च कर्त्तव्यं लोभेन त्वरया न च ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003494060, "chapter_id": 23494, "verse_number": "१३४-६१", "content_sanskrit": "मत्पूजनं विधानेन यदीच्छेत्परमां गतिम् ।\nये मां देवि यजिष्यन्ति क्रोधं त्यक्त्वा जितेन्द्रियाः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003494061, "chapter_id": 23494, "verse_number": "१३४-६२", "content_sanskrit": "संसारं ते न गच्छन्ति अपराधविवर्ज्जिताः ।\nश्रीवराह उवाच ।\nअकर्मण्येन पुष्पेण यो मामर्चयते भुवि ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003494062, "chapter_id": 23494, "verse_number": "१३४-६३", "content_sanskrit": "पातनं तस्य वक्ष्यामि तच्छृणुष्व वसुन्धरे ।\nनाहं तत्प्रतिगृह्णामि न च ते वै मम प्रियाः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003494063, "chapter_id": 23494, "verse_number": "१३४-६४", "content_sanskrit": "मूर्खा भागवता देवि मम विप्रियकारिणः ।\nपतन्ति नरके घोरे रौरवे तदनन्तरम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003494064, "chapter_id": 23494, "verse_number": "१३४-६५", "content_sanskrit": "अज्ञानस्य च दोषेण दुःखान्यनुभवन्ति च ।\nवानरो दश वर्षाणि मार्जारश्च त्रयोदश ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003494065, "chapter_id": 23494, "verse_number": "१३४-६६", "content_sanskrit": "मूकः पञ्च च वर्षाणि बलीवर्दश्च द्वादश ।\nछागश्चैवाष्टवर्षाणि मासं वै ग्रामकुक्कुटः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003494066, "chapter_id": 23494, "verse_number": "१३४-६७", "content_sanskrit": "त्रीणि वर्षाणि महिषो भवत्येव न संशयः ।\nएतत्ते कथितं भद्रे पुष्पं यन्मे न रोचते ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003494067, "chapter_id": 23494, "verse_number": "१३४-६८", "content_sanskrit": "अकर्मण्यं विशालाक्षि पुष्पं ये च ददन्ति वै ।\nधरण्युवाच ।\nभगवन्यदि तुष्टोऽसि विशुद्धेनान्तरान्मना ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003494068, "chapter_id": 23494, "verse_number": "१३४-६९", "content_sanskrit": "येन शुध्यन्ति ते भक्तास्तव कर्मपरायणाः ।\nश्रीवराह उवाच ।\nशृणु तत्त्वेन मे देवि यन्मां त्वं परिपृच्छसि ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003494069, "chapter_id": 23494, "verse_number": "१३४-७०", "content_sanskrit": "प्रायश्चित्तं महाभागे येन शुध्यन्ति मानवाः ।\nएकाहारं ततः कृत्वा मासमेकं वरानने ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003494070, "chapter_id": 23494, "verse_number": "१३४-७१", "content_sanskrit": "वीरासनविधींश्चैव कारयेत्सप्त सप्त च ।\nचतुर्थं भक्ष्यमेकेन मासेन घृतपायसम्॥॥ 134.७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003494071, "chapter_id": 23494, "verse_number": "१३४-७२", "content_sanskrit": "यावकान्नं त्रीण्यहानि वायुभक्षो दिनत्रयम् ।\nय एतेन विधानेन देवि कर्माणि कारयेत् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003494072, "chapter_id": 23494, "verse_number": "१३४-७३", "content_sanskrit": "सवर्पापप्रमुक्तश्च मम लोकं स गच्छति ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]