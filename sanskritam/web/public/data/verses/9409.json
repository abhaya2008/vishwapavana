[{"id": 40022790, "chapter_id": 9409, "verse_number": "1", "content_sanskrit": "तथोक्तवति रामे तु तस्य जन्म तदद्भुतम् । उवाच लक्ष्मणो भूयो भरतश्च महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40022791, "chapter_id": 9409, "verse_number": "2", "content_sanskrit": "इला सा सोमपुत्रस्य संवत्सरमथोषिता । अकरोत्किं नरश्रेष्ठ तत्त्वं शंसितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40022792, "chapter_id": 9409, "verse_number": "3", "content_sanskrit": "तयोस्तद्वाक्यमाधुर्यं निशम्य परिपृच्छतोः । रामः पुनरुवाचेमां प्रजापतिसुते कथाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40022793, "chapter_id": 9409, "verse_number": "4", "content_sanskrit": "पुरुषत्वं गते शूरे बुधः परमबुद्धिमान् । संवर्तं परमोदारमाजुहाव महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40022794, "chapter_id": 9409, "verse_number": "5", "content_sanskrit": "च्यवनं भृगुपुत्रं च मुनिं चारिष्टनेमिनम् । प्रमोदनं मोदकरं ततो दुर्वाससं मुनिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40022795, "chapter_id": 9409, "verse_number": "6", "content_sanskrit": "एतान्सर्वान्समानीय वाक्यज्ञस्तत्त्वदर्शनः । उवाच सर्वान्सुहृदो धैर्येण सुसमाहितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40022796, "chapter_id": 9409, "verse_number": "7", "content_sanskrit": "अयं राजा महाबाहुः कर्दमस्य इलः सुतः । जानीतैनं यथाभूतं श्रेयो ह्यत्र विधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40022797, "chapter_id": 9409, "verse_number": "8", "content_sanskrit": "तेषां संवदतामेव तमाश्रममुपागमत् । कर्दमस्तु महातेजा द्विजैः सह महात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40022798, "chapter_id": 9409, "verse_number": "9", "content_sanskrit": "पुलस्त्यश्च क्रतुश्चैव वषट्कारस्तथैव च । ओङ्कारश्च महातेजास्तमाश्रममुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40022799, "chapter_id": 9409, "verse_number": "10", "content_sanskrit": "ते सर्वे हृष्टमनसः परस्परसमागमे । हितैषिणो बाल्हिपतेः पृथग्वाक्यान्यथाब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40022800, "chapter_id": 9409, "verse_number": "11", "content_sanskrit": "कर्दमस्त्वब्रवीद्वाक्यं सुतार्थं परमं हितम् । द्विजाः शृणुत मद्वाक्यं यच्छ्रेयः पार्थिवस्य हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40022801, "chapter_id": 9409, "verse_number": "12", "content_sanskrit": "नान्यं पश्यामि भैषज्यमन्तरा वृषभध्वजम् । नाश्वमेधात्परो यज्ञः प्रियश्चैव महात्मनः । तस्माद्यजामहे सर्वे पार्थिवार्थे दुरासदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40022802, "chapter_id": 9409, "verse_number": "13", "content_sanskrit": "कर्दमेनैवमुक्तास्तु सर्व एव द्विजर्षभाः । रोचयन्ति स्म तं यज्ञं रुद्रस्याराधनं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40022803, "chapter_id": 9409, "verse_number": "14", "content_sanskrit": "संवर्तस्य तु राजर्षेः शिष्यः पुरपुरञ्जयः । मरुत्त इति विख्यातस्तं यज्ञं समुपाहरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40022804, "chapter_id": 9409, "verse_number": "15", "content_sanskrit": "ततो यज्ञो महानासीद्बुधाश्रमसमीपतः । रुद्रश्च परमं तोषमाजगाम महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40022805, "chapter_id": 9409, "verse_number": "16", "content_sanskrit": "अथ यज्ञे समाप्ते तु प्रीतः परमया मुदा । उमापतिर्द्विजान्सर्वानुवाच इलसन्निधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40022806, "chapter_id": 9409, "verse_number": "17", "content_sanskrit": "प्रीतो ऽस्मि हयमेधेन भक्त्या च द्विजसत्तमाः । अस्य बाह्लिपतेश्चैव किं करोमि प्रियं शुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40022807, "chapter_id": 9409, "verse_number": "18", "content_sanskrit": "तथा वदति देवेशे द्विजास्ते सुसमाहिताः । प्रसादयन्ति देवेशं यथा स्यात्पुरुषस्त्विला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40022808, "chapter_id": 9409, "verse_number": "19", "content_sanskrit": "ततः प्रीतो महादेवः पुरुषत्वं ददौ पुनः । इलायै सुमहातेजा दत्त्वा चान्तरधीयत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40022809, "chapter_id": 9409, "verse_number": "20", "content_sanskrit": "निवृत्ते हयमेधे च गतश्चादर्शनं हरः । यथागतं द्विजाः सर्वे ह्यगच्छन्दीर्घदर्शिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40022810, "chapter_id": 9409, "verse_number": "21", "content_sanskrit": "राजा तु बाह्लिमुत्सृज्य मध्यदेशे ह्यनुत्तमम् । निवेशयामास पुरं प्रतिष्ठानं यशस्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40022811, "chapter_id": 9409, "verse_number": "22", "content_sanskrit": "शशबिन्दुश्च राजर्षिर्बाह्लिं पुरपुरञ्जयः । प्रतिष्ठाने इलो राजा प्रजापतिसुतो बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40022812, "chapter_id": 9409, "verse_number": "23", "content_sanskrit": "स काले प्राप्तवाँल्लोकमिलो ब्राह्ममनुत्तमम् । ऐलः पुरूरवा राजा प्रतिष्ठानमवाप्तवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40022813, "chapter_id": 9409, "verse_number": "24", "content_sanskrit": "ईदृशो ह्यश्वमेधस्य प्रभावः पुरुषर्षभौ । स्त्रीभूतः पौरुषं लेभे यच्चान्यदपि दुर्लभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]