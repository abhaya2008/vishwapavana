[{"id": 2075274, "chapter_id": 2593, "verse_number": "१२-९८-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2075275, "chapter_id": 2593, "verse_number": "१२-९८-१", "content_sanskrit": "के लोका युध्यमानानां शूराणामनिवर्तिनाम्।\nभवन्ति निधनं प्राप्य तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2075276, "chapter_id": 2593, "verse_number": "१२-९८-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2075277, "chapter_id": 2593, "verse_number": "१२-९८-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nअम्बरीपस्य संवादमिन्द्रस्य च युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2075278, "chapter_id": 2593, "verse_number": "१२-९८-३", "content_sanskrit": "अम्बरीषो हि नाभागः स्वर्गं गत्वा सुदुर्लभम्।\nददर्श सुर--कस्थं शक्रेण सचिवैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2075279, "chapter_id": 2593, "verse_number": "१२-९८-४", "content_sanskrit": "सर्वतेजोमयं दिव्यं विमानवरमास्थितम्।\nउ---गच्छन्तं स्थानं सेनापतिं शुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2075280, "chapter_id": 2593, "verse_number": "१२-९८-५", "content_sanskrit": "स दष्ट्वापरि गच्छन्तं सेनापतिमुदारधीः।\n`शूरस्थानमनुप्राप्तं सुदेवं नाम नामतः।\nऋद्धिं दृष्ट्वा सुदेवस्य विस्मितः प्राह वासवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2075281, "chapter_id": 2593, "verse_number": "१२-९८-६x", "content_sanskrit": "अम्बरीप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2075282, "chapter_id": 2593, "verse_number": "१२-९८-६", "content_sanskrit": "सागरान्तां महीं कृत्स्नामनुशास्य यथाविधि।\nचातुर्वर्ण्ये यथाशास्त्रं प्रवृत्तो धर्मकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2075283, "chapter_id": 2593, "verse_number": "१२-९८-७", "content_sanskrit": "ब्रह्मचर्येण घोरेण गुर्वाचारेण सेवया।\nवेदानधीत्य धर्मेण राजशास्त्रं च केवलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2075284, "chapter_id": 2593, "verse_number": "१२-९८-८", "content_sanskrit": "अतिथीनन्नपानेन पितॄंश्च स्वधया तथा।\nऋषीन्स्वाध्यायदीक्षाभिर्देवान्यज्ञैरनुत्तमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2075285, "chapter_id": 2593, "verse_number": "१२-९८-९", "content_sanskrit": "क्षत्रध--स्थितो भूत्वा यथाशास्त्रं यथाविधि।\nउदीक्षमाणः पृतनां जयामि युधि वासव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2075286, "chapter_id": 2593, "verse_number": "१२-९८-१०", "content_sanskrit": "दे--ज सुदेवोऽयं मम सेनापतिः पुरा।\nआसाद्योधः प्रशान्तात्मा सोऽयं कस्मादतीव माम्।\nविमानं सूर्यसङ्काशमास्थितो मोदते दिवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2075287, "chapter_id": 2593, "verse_number": "१२-९८-११", "content_sanskrit": "अनेन ऋतुभिर्मुख्यैर्नेष्टं नापि द्विजातयः।\nतर्पिता विधिवच्छक्र सोऽयं कस्मादतीत्य माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2075288, "chapter_id": 2593, "verse_number": "१२-९८-१२", "content_sanskrit": "ऐश्वर्यमीदृशं प्राप्तः सर्वदेवैः सुदुर्लभम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2075289, "chapter_id": 2593, "verse_number": "१२-९८-१२x", "content_sanskrit": "इन्द्र उवाच।\n`यदनेन कृतं कर्म प्रत्यक्षं ते महीपते।\nपुरा पालयतः सम्यक्पृथिवीं धर्मतो नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2075290, "chapter_id": 2593, "verse_number": "१२-९८-१३", "content_sanskrit": "शत्रवो निर्जिताः सर्वे ये तवाहितकारिणः।\nसंयमो वियमश्चैव सुयमश्च नहाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2075291, "chapter_id": 2593, "verse_number": "१२-९८-१४", "content_sanskrit": "राक्षसा दुर्जया लोके त्रयस्ते युद्धदुर्मदाः।\nपुत्रास्ते शतशृङ्गस्य राक्षसस्य महीपतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2075292, "chapter_id": 2593, "verse_number": "१२-९८-१५", "content_sanskrit": "तथा तस्मिञ्शुभे काले तव यज्ञं वितन्वतः।\nअश्वमेधं महायागं देवानां हितकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2075293, "chapter_id": 2593, "verse_number": "१२-९८-१६", "content_sanskrit": "तस्य ते खलु विघ्नार्थमागता राक्षसास्त्रयः।\nकोटीशतपरीवारां राक्षसानां महाचमूम्।\nपरिगृह्य ततः सर्वाः प्रजा वन्दीकृतास्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2075294, "chapter_id": 2593, "verse_number": "१२-९८-१७", "content_sanskrit": "विह्वलाश्च प्रजाः सर्वाः सर्वे च तव सैनिकाः।\nनिराकृतस्तु यच्चासीत्सुदेवः सैन्यनायकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2075295, "chapter_id": 2593, "verse_number": "१२-९८-१८", "content_sanskrit": "तत्रामात्यवचः श्रुत्वा निरस्तः सर्वकर्मसु।\nश्रुत्वा तेषां वचो भूयः सोपधं वसुधाधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2075296, "chapter_id": 2593, "verse_number": "१२-९८-१९", "content_sanskrit": "सर्वसैन्यसमायुक्तः सुदेवः प्रेरितस्त्वया।\nसाक्षसानां वधार्थाय दुर्जयानां नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2075297, "chapter_id": 2593, "verse_number": "१२-९८-२०", "content_sanskrit": "नाजित्वा राक्षसीं सेनां पुनरागमनं तव।\nबन्दीमोक्षमकृत्वा च न चागमनमिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2075298, "chapter_id": 2593, "verse_number": "१२-९८-२१", "content_sanskrit": "सुदेवस्तद्वचः श्रुत्वा प्रस्थानमकरोन्नृप।\nसंप्राप्तश्च स तं देशं यत्र बन्दीकृताः प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2075299, "chapter_id": 2593, "verse_number": "१२-९८-२२", "content_sanskrit": "पश्यति स्म महाघोरां राक्षसानां महाचमूम्।\nदृष्ट्वा सुचिन्तयामास सुदेवो वाहिनीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2075300, "chapter_id": 2593, "verse_number": "१२-९८-२३", "content_sanskrit": "नेयं शक्या चमूर्जेतुमपि सेन्द्रैः सुरासुरैः।\nनाम्बरीषः कलामेकामेषां क्षपयितुं क्षमः।\nदिव्यास्त्रबलभूयिष्ठः किमहं पुनरीदृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2075301, "chapter_id": 2593, "verse_number": "१२-९८-२४", "content_sanskrit": "ततः सेनां पुनः सर्वां प्रेषयामास पार्थिव।\nयत्र त्वं सचिवैः सर्वैर्मन्त्रिभिः सोपधैर्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2075302, "chapter_id": 2593, "verse_number": "१२-९८-२५", "content_sanskrit": "ततो रुद्रं महादेवं प्रपन्नो जगतः पतिम्।\nश्मशाननिलयं देवं तुष्टाव वृषभध्वजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2075303, "chapter_id": 2593, "verse_number": "१२-९८-२६", "content_sanskrit": "स्तुत्वा शस्त्रं समादाय स्वशिरश्छेत्तुमुद्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2075304, "chapter_id": 2593, "verse_number": "१२-९८-२७", "content_sanskrit": "कारुण्याद्देवदेवेन गृहीतस्तस्य दक्षिणः।\nस पाणिः सह शस्त्रेण दृष्ट्वा चेदमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2075305, "chapter_id": 2593, "verse_number": "१२-९८-२८", "content_sanskrit": "किमिदं साहसं पुत्र कुर्तकामो वदस्व मे।\nस उवाच महादेवं शिरसा त्ववनीं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2075306, "chapter_id": 2593, "verse_number": "१२-९८-२९", "content_sanskrit": "भगवन्वाहिनीमेनां राक्षसानां सुरेश्वर।\nअशक्तोऽहं रणे जेतुं तस्मात्त्यक्ष्यामि जीवितम्।\nगतिर्भव महादेव ममार्तस्य जगत्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2075307, "chapter_id": 2593, "verse_number": "१२-९८-३०", "content_sanskrit": "नागन्तव्यमजित्वा च मामाह जगतीपतिः।\nअम्बरीषो महादेव क्षारितः सचिवैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2075308, "chapter_id": 2593, "verse_number": "१२-९८-३१", "content_sanskrit": "तमुवाच महादेवः सुदेवं पतितं क्षितौ।\nअधोमुखं महात्मानं सत्वानां हितकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2075309, "chapter_id": 2593, "verse_number": "१२-९८-३२", "content_sanskrit": "धनुर्वेदं समाहूय सगणं सहविग्रहम्।\nरथनागाश्वकलिलं दिव्यास्त्रसमलंकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2075310, "chapter_id": 2593, "verse_number": "१२-९८-३३", "content_sanskrit": "रथं च सुमहाभागं येन तन्त्रिपुरं हतम्।\nधनुः पिनाकं खङ्गं च रौद्रमस्त्रं च शंकरः।\nनिजघानासुरान्सर्वान्येन देवस्त्रियम्बकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2075311, "chapter_id": 2593, "verse_number": "१२-९८-३४", "content_sanskrit": "उवाच च महादेवः सुदेवं वाहिनीपतिम्।\nरथादस्मात्सुदेव त्वं दुर्जयः स सुरासुरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2075312, "chapter_id": 2593, "verse_number": "१२-९८-३५", "content_sanskrit": "मायया मोहितो भूमौ न पदं कर्तुमर्हसि।\nरथस्थस्त्रिदशान्सर्वाञ्जेष्यसि त्वं सदानवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2075313, "chapter_id": 2593, "verse_number": "१२-९८-३६", "content_sanskrit": "राक्षसाश्च पिशाचाश्च न शक्ता द्रष्टुमीदृशम्।\nरथं सूर्यसहस्राभं किमु योद्धुं त्वया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2075314, "chapter_id": 2593, "verse_number": "१२-९८-३७", "content_sanskrit": "स जित्वा राक्षसान्सर्वान्कृत्वा बन्दीविमोक्षणम्।\nघातयित्वा च तान्सर्वान्बाहुयुद्धे त्वयं हतः।\nवियमं प्राप्य भूपाल वियमश्च निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2075315, "chapter_id": 2593, "verse_number": "१२-९८-३८", "content_sanskrit": "तस्य विक्रमतस्तात सुदेवस्य बभूव ह।\nसंग्रामयज्ञः सुमहान्यश्चान्यो युध्यते नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2075316, "chapter_id": 2593, "verse_number": "१२-९८-३९", "content_sanskrit": "सन्नद्धो दीक्षितः सर्वो योधः प्राप्य चमूमुखम्।\nयुद्धयज्ञाधिकारस्थो भवतीति विनिश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2075317, "chapter_id": 2593, "verse_number": "१२-९८-४०x", "content_sanskrit": "अम्बरीष उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2075318, "chapter_id": 2593, "verse_number": "१२-९८-४०", "content_sanskrit": "कानि यज्ञे हवींष्यस्मिन्किमाज्यं का च दक्षिणा।\nऋत्विजश्चात्र क्रे प्रोक्तास्तन्मे ब्रूहि शतक्रतो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2075319, "chapter_id": 2593, "verse_number": "१२-९८-४१x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2075320, "chapter_id": 2593, "verse_number": "१२-९८-४१", "content_sanskrit": "ऋत्विजः कुञ्जरास्तत्र वाजिनोऽध्वर्यवस्तथा।\nहवींषि परमांसानि रुधिरं त्वाज्यमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2075321, "chapter_id": 2593, "verse_number": "१२-९८-४२", "content_sanskrit": "शृगालगृध्रकाकोलाः सदस्यास्तत्र पन्त्रिणः।\nआज्यशेषं पिबन्त्येते हविः प्राश्नन्ति चाध्वरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2075322, "chapter_id": 2593, "verse_number": "१२-९८-४३", "content_sanskrit": "प्रासतोमरसंघाताः खङ्गशक्तिपरश्वथाः।\nज्वलन्तो निशिताः पीताः स्रुचस्तस्याथ सत्रिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2075323, "chapter_id": 2593, "verse_number": "१२-९८-४४", "content_sanskrit": "चापवेगायतस्तीक्ष्णः परकायावभेदनः।\nऋजुः सुनिशितः पीतः सायकश्च स्रुवो म--॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2075324, "chapter_id": 2593, "verse_number": "१२-९८-४५", "content_sanskrit": "द्वीपिचर्मावनद्धश्च नागदन्तकृतत्सरुः।\nहस्तिहस्तहरः खङ्गः स्फयो भवेत्तस्य संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2075325, "chapter_id": 2593, "verse_number": "१२-९८-४६", "content_sanskrit": "ज्वलितैर्निशितैः प्रासशक्त्यृष्टिसपरश्वथैः।\nशैक्यायसमयैस्तीक्ष्णैरभिघातो भवेद्वसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2075326, "chapter_id": 2593, "verse_number": "१२-९८-४७", "content_sanskrit": "[सङ्ख्यासमयविस्तीर्णमभिजातोद्भवं बहु।]\nआवेधाद्यच्च रुधिरं संग्रामे स्रवते भुवि।\nसाऽस्य पूर्णाहुतिर्होत्रैः समृद्धा सर्वकामधुक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2075327, "chapter_id": 2593, "verse_number": "१२-९८-४८", "content_sanskrit": "छिन्धि भिन्धीति यः शब्दः श्रूयते वाहिनीमुखे।\nसामानि सामगास्तस्य गायन्ति यमसादने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2075328, "chapter_id": 2593, "verse_number": "१२-९८-४९", "content_sanskrit": "हविर्धानं तु तस्याहुः परेषां वाहिनीमुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2075329, "chapter_id": 2593, "verse_number": "१२-९८-५०", "content_sanskrit": "कुञ्जराणां हयानां च वर्मिणां च समुच्चय।\nअग्निः श्येनचितो नाम यज्ञे तस्य विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2075330, "chapter_id": 2593, "verse_number": "१२-९८-५१", "content_sanskrit": "उत्तिष्ठते कबन्धोऽत्र सहस्रे पतिते तु यः।\nस यूपस्तस्य शूरस्य खादिरोऽष्टाश्रिरुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2075331, "chapter_id": 2593, "verse_number": "१२-९८-५२", "content_sanskrit": "इडोपहूताः क्रोशन्ति कुञ्जरास्त्वङ्कुशेरिताः।\nज्याघुष्टतलतालेन वषट्कारेण पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2075332, "chapter_id": 2593, "verse_number": "१२-९८-५३", "content_sanskrit": "उद्गाता तत्र संग्रामे त्रिसामा दुन्दुभिर्नृप।\nब्रह्मस्वे ह्रियमाणे तु त्यक्त्वा युद्धे प्रियां तनुम्।\nआत्मानं यूपमुच्छ्रित्य स यज्ञोऽनन्तदक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2075333, "chapter_id": 2593, "verse_number": "१२-९८-५४", "content_sanskrit": "भर्तुरर्थे च यः शूरो निष्क्रामेद्वाहिनीमुखात्।\nन भयाद्विनिवर्तेत तस्य लोका यथा मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2075334, "chapter_id": 2593, "verse_number": "१२-९८-५५", "content_sanskrit": "द्वीपिचर्मावृतैः खङ्गैर्बाहुभिः परिघोपमैः।\nयस्य वेदिरुपस्तीर्णा तस्य लोका यथा मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2075335, "chapter_id": 2593, "verse_number": "१२-९८-५६", "content_sanskrit": "यस्तु नापेक्षते कंचित्सहायं विषमे स्थितः।\nविगाह्य वाहिनीमध्यं तस्य लोका यथा मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2075336, "chapter_id": 2593, "verse_number": "१२-९८-५७", "content_sanskrit": "यस्य शोणितसंघट्टा भेरीमण्डूककच्छपा।\nवीरास्थिशर्करा दुर्गा मांसशोणितकर्दमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2075337, "chapter_id": 2593, "verse_number": "१२-९८-५८", "content_sanskrit": "असिचर्मप्लवा घोरा केशशैवलशाद्वला।\nअश्वनागरथैश्चैव संछिन्नैः कृतसंक्रमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2075338, "chapter_id": 2593, "verse_number": "१२-९८-५९", "content_sanskrit": "पताकाध्वजवानीरा हतवाहनवारणा।\nशोणितोदकसंपूर्णा दुस्तरा पारगैर्नरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2075339, "chapter_id": 2593, "verse_number": "१२-९८-६०", "content_sanskrit": "रहतनागमहानक्रा परलोकवहाऽशिवा।\nऋष्टिखङ्गमहामीना गृध्रकङ्कबलप्लवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2075340, "chapter_id": 2593, "verse_number": "१२-९८-६१", "content_sanskrit": "पुरुषादानुचरिता भीरूणां कश्मलावहा।\nनदी योधस्य संग्रामे तदस्यावभृथं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2075341, "chapter_id": 2593, "verse_number": "१२-९८-६२", "content_sanskrit": "वेदिर्यस्य त्वमित्राणां शिरोभिर्व्यवकीर्यते।\nअश्वस्कन्धैर्गजस्कन्धैस्तस्य लोका यथा मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2075342, "chapter_id": 2593, "verse_number": "१२-९८-६३", "content_sanskrit": "पत्नी शालाकृता यस्य परेषां वाहिनीमुखम्।\nहविर्धानं स्ववाहिन्यास्तदस्याहुर्मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2075343, "chapter_id": 2593, "verse_number": "१२-९८-६४", "content_sanskrit": "सदस्या दक्षिणा योधा आग्नीध्रश्चोत्तरां दिशम्।\nशत्रुसेना अलत्रस्य सर्वलोकानदूरतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2075344, "chapter_id": 2593, "verse_number": "१२-९८-६५", "content_sanskrit": "यस्य भयतो व्यूहे भवत्याकाशमग्रतः।\nसास्य वेदिस्तदा यज्ञैर्नित्यं व्यूहास्त्रयोऽग्नयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2075345, "chapter_id": 2593, "verse_number": "१२-९८-६६", "content_sanskrit": "यस्तु योधः परावृत्तः संत्रस्तो हन्यते परैः।\nअप्रतिष्ठः स नरकं याति नास्त्यत्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2075346, "chapter_id": 2593, "verse_number": "१२-९८-६७", "content_sanskrit": "यस्य शोणितवेगेण वेदिः स्यात्संपरिप्लुता।\nकेशमांसास्थिसंपूर्णा स गच्छेत्परमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2075347, "chapter_id": 2593, "verse_number": "१२-९८-६८", "content_sanskrit": "यस्तु सेनापतिं हत्वा तद्यानमधिरोहति।\nस विष्णुविक्रमक्रामी बृहस्पतिसमः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2075348, "chapter_id": 2593, "verse_number": "१२-९८-६९", "content_sanskrit": "नायकं तत्कुमारं वा यो वा स्यात्तत्र पूजितः।\nजीवग्राहं प्रगृह्णाति तस्य लोका यथा मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2075349, "chapter_id": 2593, "verse_number": "१२-९८-७०", "content_sanskrit": "आहवे तु हतं शूरं न शोचेत कथंचन।\nअशोच्यो हि हतः शूरः स्वर्गलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2075350, "chapter_id": 2593, "verse_number": "१२-९८-७१", "content_sanskrit": "न ह्यन्नं नोदकं तस्य न स्नानं नाप्यशौचकम्।\nहतस्य कर्तुमिच्छन्ति तस्य लोकाञ्शृणुष्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2075351, "chapter_id": 2593, "verse_number": "१२-९८-७२", "content_sanskrit": "वराप्सरः सहस्राणि शूरमत्योधने हतम्।\nत्वरमाणानि धावन्ति मम भर्ता भवेदिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2075352, "chapter_id": 2593, "verse_number": "१२-९८-७३", "content_sanskrit": "एतत्तपश्च पुण्यं च धर्मश्चैव सनातनः।\nचत्वारश्चाश्रमास्तस्य यो युद्धे न पलायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2075353, "chapter_id": 2593, "verse_number": "१२-९८-७४", "content_sanskrit": "वृद्धबालौ न हन्तव्यौ न च स्त्री नैव पृष्ठतः।\nतृणपूर्णमुखश्चैव तवास्मीति च यो वदेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2075354, "chapter_id": 2593, "verse_number": "१२-९८-७५", "content_sanskrit": "अहं वृत्रं बलं पाकं महाकायं विरोचनम्।\nदुरावारं च नमुचिं शतमायं च शम्बरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2075355, "chapter_id": 2593, "verse_number": "१२-९८-७६", "content_sanskrit": "विप्रचित्तिं च दैतेयं दनोः पुत्रांश्च सर्वशः।\nप्रह्वादं च निहत्याजौ ततो देवाधिपोऽभवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2075356, "chapter_id": 2593, "verse_number": "१२-९८-७७", "content_sanskrit": "इत्येतच्छक्रवचनं निशम्य प्रतिपूज्य च।\nयोधानामात्मनः सिद्धिमम्बरीषोऽभिपन्नवान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2075357, "chapter_id": 2593, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि अष्टनवतितमोऽध्यायः॥ ९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}]