[{"id": 2204350, "chapter_id": 5355, "verse_number": "१", "content_sanskrit": "भगवन् देवदेवेश शूलपाणे वृषध्वज ।\nपुंश्चल्य इव या स्त्रीषु नीचवृत्तिरताः स्मृताः ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2204351, "chapter_id": 5355, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2204352, "chapter_id": 5355, "verse_number": "२", "content_sanskrit": "याः पुरा मनुजा देवि बुद्धिमोहसमन्विताः ।\nकामरागसमायुक्ताः पतीनतिचरन्ति वै\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2204353, "chapter_id": 5355, "verse_number": "३", "content_sanskrit": "प्रतिकूलपरा यास्तु पतीन् प्रति यथा तथा ।\nशौचं लज्जां तु विस्मृत्य यथेष्टपरिचारकाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2204354, "chapter_id": 5355, "verse_number": "४", "content_sanskrit": "एवंयुक्तसमाचारा यमलोके सुदण्डिताः ।\nयदि वै मानुषं जन्म लभेरंस्तास्तथाविधाः ।\nबहुसाधारणा एवं पुंश्चल्यश्च भवन्ति ताः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2204355, "chapter_id": 5355, "verse_number": "५", "content_sanskrit": "पौंश्चल्यं यत्तु तद्वृत्तं स्त्रीणां कष्टतमं स्मृतम् ।\nततःप्रभृति ता देवि पतन्त्येव न संशयः ।\nशोचन्ति चेत्तु तद्वृत्तं मनसा हितमाप्नुयुः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2204356, "chapter_id": 5355, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2204357, "chapter_id": 5355, "verse_number": "६", "content_sanskrit": "भगवन् देवदेवेश प्रमदा विधवा भृशम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2204358, "chapter_id": 5355, "verse_number": "७", "content_sanskrit": "दृश्यन्ते मानुषा लोके सर्वकल्याणवर्जिताः ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2204359, "chapter_id": 5355, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2204360, "chapter_id": 5355, "verse_number": "८", "content_sanskrit": "याः पुरा मनुजा देवि बुद्धिमोहसमन्विताः ।\nकुटुम्बं तत्र वै पत्युर्नाशयन्ति वृथा तथा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2204361, "chapter_id": 5355, "verse_number": "९", "content_sanskrit": "विषदाश्चाग्निदाश्चैव पतीन् प्रति सुनिर्दयाः ।\nअन्यासां हि पतीन् यान्ति स्वपतिद्वेषकारणात्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2204362, "chapter_id": 5355, "verse_number": "१०", "content_sanskrit": "एवंयुक्तसमाचारा यमलोके सुदण्डिताः ।\nनिरयस्थाश्चिरं कालं कथञ्चित्प्राप्य मानुषम् ।\nतत्र ता भोगरहिता विधवास्तु भवन्ति वै\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2204363, "chapter_id": 5355, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2204364, "chapter_id": 5355, "verse_number": "११", "content_sanskrit": "भगवन् प्रमदास्त्वन्याः पतौ ज्ञातिषु सत्स्वपि ।\nलिङ्गिन्यः सम्प्रदृश्यन्ते पाषण्डं मतमाश्रिताः ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2204365, "chapter_id": 5355, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2204366, "chapter_id": 5355, "verse_number": "१२", "content_sanskrit": "याः पुरा भावदोषेण लोभमोहसमन्विताः ।\nपरद्रव्यपरा लोभात् परेषां द्रव्यहारकाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2204367, "chapter_id": 5355, "verse_number": "१३", "content_sanskrit": "अभ्यसूयापरा यास्तु सपत्नीनां प्रदूषकाः ।\nईर्ष्यापराः कोपनाश्च बन्धूनां विफलाः सदा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2204368, "chapter_id": 5355, "verse_number": "१४", "content_sanskrit": "एवंयुक्तसमाचाराः पुनर्जन्मनि ताः प्रिये ।\nअपलक्षणसम्पन्नाः पाषण्डं धर्ममाश्रिताः ।\nस्त्रियः प्रव्राजशीलाश्च भवन्त्येव न संशयः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2204369, "chapter_id": 5355, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2204370, "chapter_id": 5355, "verse_number": "१५", "content_sanskrit": "भगवन् मानुषाः केचित् कारुवृत्तिं समाश्रिताः ।\nप्रदृश्यन्ते मनुष्येषु नीचकर्मरता जनाः ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हति\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2204371, "chapter_id": 5355, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2204372, "chapter_id": 5355, "verse_number": "१६", "content_sanskrit": "ये पुरा मनुजा देवि स्तब्धा मानयुता भृशम् ।\nदर्पाहङ्कारसंयुक्ताः केवलात्मपरायणाः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2204373, "chapter_id": 5355, "verse_number": "१७", "content_sanskrit": "तादृशा मानुषा देवि पुनर्जन्मनि शोभने ।\nकारवो नटगन्धर्वाः सम्भवन्ति यथा तथा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2204374, "chapter_id": 5355, "verse_number": "१८", "content_sanskrit": "नापिता बन्दिनश्चैव तथा वैतालिकाः प्रिये ।\nएवंभूतास्त्वधोवृत्तिं जीवन्त्याश्रित्य मानवाः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2204375, "chapter_id": 5355, "verse_number": "१९", "content_sanskrit": "परप्रसाधनकरास्ते परैः कृतवेतनाः ।\nपरावमानस्य फलं भुञ्जते पौर्वदैहिकम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2204376, "chapter_id": 5355, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2204377, "chapter_id": 5355, "verse_number": "२०", "content_sanskrit": "भगवन् देवदेवेश मानुषेष्वेव केचन ।\nदासभूताः प्रदृश्यन्ते सर्वकर्मकरा भृशम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2204378, "chapter_id": 5355, "verse_number": "२१", "content_sanskrit": "आघातभर्त्सनसहाः पीड्यमानाश्च सर्वशः ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2204379, "chapter_id": 5355, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2204380, "chapter_id": 5355, "verse_number": "२२", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु कल्याणि कारणम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2204381, "chapter_id": 5355, "verse_number": "२३", "content_sanskrit": "ये पुरा मनुजा देवि परेषां वित्तहारकाः ।\nऋणवृद्धिकरं कुर्यान्न्यासदत्तं तथैव च\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2204382, "chapter_id": 5355, "verse_number": "२४", "content_sanskrit": "निक्षेपकारणाद् दत्तं परेषां द्रव्यहारिणः ।\nप्रमादाद् विस्मृतं नष्टं परेषां धनहारकाः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2204383, "chapter_id": 5355, "verse_number": "२५", "content_sanskrit": "वधबन्धपरिक्लेशैर्दासत्वे कुर्वतेऽपरान् ।\nतादृशा मरणं प्राप्ता दण्डिता यमशासनैः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2204384, "chapter_id": 5355, "verse_number": "२६", "content_sanskrit": "कथञ्चित् प्राप्य मानुष्यं तत्र ते देवि सर्वथा ।\nदासभूता भविष्यन्ति जन्मप्रभृति मानवाः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2204385, "chapter_id": 5355, "verse_number": "२७", "content_sanskrit": "तेषां कर्माणि कुर्वन्ति येषां ते धनहारकाः ।\nआसमाप्तेः स्वपापस्य कुर्वन्तीति विनिश्चयः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2204386, "chapter_id": 5355, "verse_number": "२८", "content_sanskrit": "पशुभूतास्तथा चान्ये भवन्ति धनहारकाः ।\nतत्तथा क्षीयते कर्म तेषां पूर्वापराधजम् ।\nअतोऽन्यथा न तच्छक्यं कर्म हातुं सुरासुरैः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2204387, "chapter_id": 5355, "verse_number": "२९", "content_sanskrit": "किन्तु मोक्षविधिस्तेषां सर्वथा तत्प्रसादजः ।\nअयथावन्मोक्षकामः पुनर्जन्मनि चेष्यते\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2204388, "chapter_id": 5355, "verse_number": "३०", "content_sanskrit": "मोक्षकामी यथान्यायं कुर्वन् कर्माणि सर्वशः ।\nभर्तुः प्रसादमाकाङ्क्षेदाघातान् सर्वथा सहन्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2204389, "chapter_id": 5355, "verse_number": "३१", "content_sanskrit": "प्रीतिपूर्वं तु यो भर्त्रा मुक्तो मुक्तः स्वपापतः ।\nतथाभूतान् कर्मकरान् सदा सन्तोषयेत् पतिः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2204390, "chapter_id": 5355, "verse_number": "३२", "content_sanskrit": "यथाहं कारयेत् कर्म दण्डं कारणतः क्षिपेत् ।\nवृद्धान् बालांस्तथा क्षीणान् पालयन् धर्ममाप्नुयात्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2204391, "chapter_id": 5355, "verse_number": "समाप्तिः", "content_sanskrit": "इति ते कथितं देवि किं भूयः श्रोतुमिच्छसि॥\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2204392, "chapter_id": 5355, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे उमामहेश्वरसंवादे मानुषाणां वैधव्यदास्यादि निमित्तकथनं नाम षडधिकद्विशततमोऽध्यायः ॥२०६॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]