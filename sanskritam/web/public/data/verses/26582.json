[{"id": 7006582000, "chapter_id": 26582, "verse_number": "३-१२१-१", "content_sanskrit": "हंसडिम्भकयोः सेनयोः पुष्करतीर्थे प्रवेशः वैशम्पायन उवाच अथ तौ हंसडिम्भकौ जग्मतुः पुष्करं प्रति ।\nप्रगृहीतमहाचापौ सरथौ सध्वजौ नृप ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006582001, "chapter_id": 26582, "verse_number": "३-१२१-२", "content_sanskrit": "पुरःसरमहाभूतौ संहरन्ताविवोल्बणौ ।\nप्रकुर्वन्तौ सिंहरवं भस्मना परिलेपितौ ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006582002, "chapter_id": 26582, "verse_number": "३-१२१-३", "content_sanskrit": "त्रिपुण्ड्रकललाटान्तौ रुद्राक्षपरिशोभितौ ।\nअन्यौ द्वाविव रुद्रौ तौ लोकसंहारकारकौ ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006582003, "chapter_id": 26582, "verse_number": "३-१२१-४", "content_sanskrit": "ततोऽनुजग्मुः शतशः सैन्यानि नृपसत्तम ।\nअक्षौहिण्यो दशैवासंस्तयोरथ समागताः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006582004, "chapter_id": 26582, "verse_number": "३-१२१-५", "content_sanskrit": "विचक्रस्तु महाराज दानवो नगसंनिभः ।\nतयोरेव सखा पूर्वमासीच्च बलशालिनोः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006582005, "chapter_id": 26582, "verse_number": "३-१२१-६", "content_sanskrit": "शक्रो यस्य पुरःसरः स्थातुं शक्तो न वज्रभृत् ।\nयो हि वीरो महाराज देवदैत्यसमागमे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006582006, "chapter_id": 26582, "verse_number": "३-१२१-७", "content_sanskrit": "देवान् निघ्नंस्तथा राजन् देवेन्द्रमजयन्महान् ।\nअकरोच्च पुरा युद्धं विष्णुना प्रभविष्णुना ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006582007, "chapter_id": 26582, "verse_number": "३-१२१-८", "content_sanskrit": "यो हि द्वारवतीं प्राप्य बबाधे यदुपुङ्गवान् ।\nस तदानीं महाराज श्रुत्वा युद्धमुपस्थितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006582008, "chapter_id": 26582, "verse_number": "३-१२१-९", "content_sanskrit": "अनेकशतसाहस्रैर्दानवैः परिघायुधैः ।\nवृतः समभवद् दैत्यो वृष्णिद्वेषान् नृपोत्तम ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006582009, "chapter_id": 26582, "verse_number": "३-१२१-१०", "content_sanskrit": "हंसस्य डिम्भकस्याथ साहाय्यं कर्तुमुद्यतः ।\nविचक्रस्याथ दैत्यस्य हिडिम्बो राक्षसेश्वरः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006582010, "chapter_id": 26582, "verse_number": "३-१२१-११", "content_sanskrit": "अतीव मित्रतां यातो दद्यात् प्राणांश्च संयति ।\nराक्षसैरपरैः सार्धं शिलाशूलासिपाणिभिः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006582011, "chapter_id": 26582, "verse_number": "३-१२१-१२", "content_sanskrit": "ययौ तस्य सहायार्थं हिडिम्बः पुरुषादपः ।\nअष्टाशीति सहस्राणि राक्षसास्तस्य चाभवन् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006582012, "chapter_id": 26582, "verse_number": "३-१२१-१३", "content_sanskrit": "अनुयाता महाराज शिलापरिघबाहवः ।\nतयोस्तत्र महासैन्यं गच्छतोः केशवं प्रति ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006582013, "chapter_id": 26582, "verse_number": "३-१२१-१४", "content_sanskrit": "मिश्रितं दैत्यसंघैश्च राक्षसैश्च समन्ततः ।\nअत्यद्भुतं महारौद्रं त्रैलौक्यभयदायकम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006582014, "chapter_id": 26582, "verse_number": "३-१२१-१५", "content_sanskrit": "दैत्येन सहितौ तौ हि जग्मतुः पुष्करं प्रति ।\nतावेतौ हंसडिम्भकौ हन्तुं केशवमञ्जसा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006582015, "chapter_id": 26582, "verse_number": "३-१२१-१६", "content_sanskrit": "ततः श्रुत्वा जरासंधो विग्रहं यदुभिः सह ।\nनाकरोन्नृपसाहाय्यं पापं मे भवितेति ह ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006582016, "chapter_id": 26582, "verse_number": "३-१२१-१७", "content_sanskrit": "गच्छतोः समितिं राजन्हंसस्य डिम्भकस्य च ।\nअतित्वरितविक्रान्तास्ते ययुः पुष्करं प्रति ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006582017, "chapter_id": 26582, "verse_number": "३-१२१-१८", "content_sanskrit": "सिंहनादं विमुञ्चन्तः कथयन्तः परस्परम् ।\nअहमेव नृपा युद्धं करोमि प्रथमं हरेः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006582018, "chapter_id": 26582, "verse_number": "३-१२१-१९", "content_sanskrit": "इत्यब्रुवन् नृपा राजञ्छतशः केशवं प्रति ।\nसम्प्राप्तास्ते नृपश्रेष्ठाः पुष्करं पुण्यवर्धनम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006582019, "chapter_id": 26582, "verse_number": "३-१२१-२०", "content_sanskrit": "मुनिजुष्टं तपोवृद्धैर्ऋषिभिश्च निषेवितम् ।\nअत्यन्तभद्रं लोकेषु पुष्करं प्रथमं नृप ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006582020, "chapter_id": 26582, "verse_number": "३-१२१-२१", "content_sanskrit": "पुष्करं पुण्डरीकाक्षो द्वावेव जगतीपते ।\nदर्शनात् स्पर्शनाच्चैव किल्विषच्छेदिनौ नृप॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006582021, "chapter_id": 26582, "verse_number": "३-१२१-२२", "content_sanskrit": "पुष्करं पुण्डरीकाक्षो द्वावेव नृपसत्तम ।\nसेव्यमानौ मुनिश्रेष्ठैरमरौघैर्महात्मभिः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006582022, "chapter_id": 26582, "verse_number": "३-१२१-२३", "content_sanskrit": "द्वावेव हि नृपश्रेष्ठ सर्वपापप्रणाशकौ ।\nतावुभौ यत्र सहितौ तत्र ते संस्थिता नृपाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006582023, "chapter_id": 26582, "verse_number": "३-१२१-२४", "content_sanskrit": "दृष्टवन्तो हरिं विष्णुं विष्टरश्रवसं परम् ।\nपुष्करं पुण्यनिलयं तीर्थं ब्रह्मनिषेवितम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006582024, "chapter_id": 26582, "verse_number": "३-१२१-२५", "content_sanskrit": "ताभ्यां कुरु नमस्कारं मनसा नृपसत्तम ।\nअहो निःशेषमभवत् तत्र भूयो न संशयः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006582025, "chapter_id": 26582, "verse_number": "३-१२१-२६", "content_sanskrit": "सैन्यं तत्र च सम्प्राप्तं दैत्यरक्षःसमाकुलम् ।\nअनेकभेरीपणवझर्झरीडिण्डिमाकुलम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006582026, "chapter_id": 26582, "verse_number": "३-१२१-२७", "content_sanskrit": "नानापणवसम्मिश्रं रक्षोनादविनादितम् ।\nप्रविश्य सरसस्तीरं पुष्करस्य विशाम्पते ।\nदर्शयामास देवेशं युद्धाय समुपस्थितम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]