[{"id": 5000038000, "chapter_id": 9038, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे अष्टात्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000038001, "chapter_id": 9038, "verse_number": "१-३८-१", "content_sanskrit": "तां कथां कौशिको रामे निवेद्य मधुराक्षराम् ।\nपुनरेवापरं वाक्यं काकुत्स्थमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000038002, "chapter_id": 9038, "verse_number": "१-३८-२", "content_sanskrit": "अयोध्याधिपतिर्वीर पूर्वमासीन्नराधिपः ।\nसगरो नाम धर्मात्मा प्रजाकामः स चाप्रजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000038003, "chapter_id": 9038, "verse_number": "१-३८-३", "content_sanskrit": "वैदर्भदुहिता राम केशिनी नाम नामतः ।\nज्येष्ठा सगरपत्नी सा धर्मिष्ठा सत्यवादिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000038004, "chapter_id": 9038, "verse_number": "१-३८-४", "content_sanskrit": "अरिष्टनेमेर्दुहिता सुपर्णभगिनी तु सा ।\nद्वितीया सगरस्यासीत् पत्नी सुमतिसंज्ञिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000038005, "chapter_id": 9038, "verse_number": "१-३८-५", "content_sanskrit": "ताभ्यां सह महाराजः पत्नीभ्यां तप्तवांस्तपः ।\nहिमवन्तं समासाद्य भृगुप्रस्रवणे गिरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000038006, "chapter_id": 9038, "verse_number": "१-३८-६", "content_sanskrit": "अथ वर्षशते पूर्णे तपसाऽऽराधितो मुनिः ।\nसगराय वरं प्रादाद् भृगुः सत्यवतां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000038007, "chapter_id": 9038, "verse_number": "१-३८-७", "content_sanskrit": "अपत्यलाभः सुमहान् भविष्यति तवानघ ।\nकीर्तिं चाप्रतिमां लोके प्राप्स्यसे पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000038008, "chapter_id": 9038, "verse_number": "१-३८-८", "content_sanskrit": "एका जनयिता तात पुत्रं वंशकरं तव ।\nषष्टिं पुत्रसहस्राणि अपरा जनयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000038009, "chapter_id": 9038, "verse_number": "१-३८-९", "content_sanskrit": "भाषमाणं महात्मानं राजपुत्र्यौ प्रसाद्य तम् ।\nऊचतुः परमप्रीते कृताञ्जलिपुटे तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000038010, "chapter_id": 9038, "verse_number": "१-३८-१०", "content_sanskrit": "एकः कस्याः सुतो ब्रह्मन् का बहूञ्जनयिष्यति ।\nश्रोतुमिच्छावहे ब्रह्मन् सत्यमस्तु वचस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000038011, "chapter_id": 9038, "verse_number": "१-३८-११", "content_sanskrit": "तयोस्तद् वचनं श्रुत्वा भृगुः परमधार्मिकः ।\nउवाच परमां वाणीं स्वच्छन्दोऽत्र विधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000038012, "chapter_id": 9038, "verse_number": "१-३८-१२", "content_sanskrit": "एको वंशकरो वास्तु बहवो वा महाबलाः ।\nकीर्तिमन्तो महोत्साहाः का वा कं वरमिच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000038013, "chapter_id": 9038, "verse_number": "१-३८-१३", "content_sanskrit": "मुनेस्तु वचनं श्रुत्वा केशिनी रघुनन्दन ।\nपुत्रं वंशकरं राम जग्राह नृपसंनिधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000038014, "chapter_id": 9038, "verse_number": "१-३८-१४", "content_sanskrit": "षष्टिं पुत्रसहस्राणि सुपर्णभगिनी तदा ।\nमहोत्साहान् कीर्तिमतो जग्राह सुमतिः सुतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000038015, "chapter_id": 9038, "verse_number": "१-३८-१५", "content_sanskrit": "प्रदक्षिणमृषिं कृत्वा शिरसाभिप्रणम्य तम् ।\nजगाम स्वपुरं राजा सभार्यो रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000038016, "chapter_id": 9038, "verse_number": "१-३८-१६", "content_sanskrit": "अथ काले गते तस्य ज्येष्ठा पुत्रं व्यजायत ।\nअसमञ्ज इति ख्यातं केशिनी सगरात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000038017, "chapter_id": 9038, "verse_number": "१-३८-१७", "content_sanskrit": "सुमतिस्तु नरव्याघ्र गर्भतुम्बं व्यजायत ।\nषष्टिः पुत्रसहस्राणि तुम्बभेदाद् विनिःसृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000038018, "chapter_id": 9038, "verse_number": "१-३८-१८", "content_sanskrit": "घृतपूर्णेषु कुम्भेषु धात्र्यस्तान् समवर्धयन् ।\nकालेन महता सर्वे यौवनं प्रतिपेदिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000038019, "chapter_id": 9038, "verse_number": "१-३८-१९", "content_sanskrit": "अथ दीर्घेण कालेन रूपयौवनशालिनः ।\nषष्टिः पुत्रसहस्राणि सगरस्याभवंस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000038020, "chapter_id": 9038, "verse_number": "१-३८-२०", "content_sanskrit": "स च ज्येष्ठो नरश्रेष्ठ सगरस्यात्मसम्भवः ।\nबालान् गृहीत्वा तु जले सरय्वा रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000038021, "chapter_id": 9038, "verse_number": "१-३८-२१", "content_sanskrit": "प्रक्षिप्य प्राहसन्नित्यं मज्जतस्तान् निरीक्ष्य वै ।\nएवं पापसमाचारः सज्जनप्रतिबाधकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000038022, "chapter_id": 9038, "verse_number": "१-३८-२२", "content_sanskrit": "पौराणामहिते युक्तः पित्रा निर्वासितः पुरात् ।\nतस्य पुत्रोंऽशुमान् नाम असमञ्जस्य वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000038023, "chapter_id": 9038, "verse_number": "१-३८-२३", "content_sanskrit": "सम्मतः सर्वलोकस्य सर्वस्यापि प्रियंवदः ।\nततः कालेन महता मतिः समभिजायत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000038024, "chapter_id": 9038, "verse_number": "१-३८-२४", "content_sanskrit": "सगरस्य नरश्रेष्ठ यजेयमिति निश्चिता ।\nस कृत्वा निश्चयं राजा सोपाध्यायगणस्तदा ।\nयज्ञकर्मणि वेदज्ञो यष्टुं समुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000038025, "chapter_id": 9038, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे अष्टात्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]