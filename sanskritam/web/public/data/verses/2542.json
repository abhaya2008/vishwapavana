[{"id": 2073023, "chapter_id": 2542, "verse_number": "१२-४७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2073024, "chapter_id": 2542, "verse_number": "१२-४७-१", "content_sanskrit": "ततः स च हृषीकेशः स च राजा युधिष्ठिरः।\nकृपादयश्च ते सर्वे चत्वारः पाण्डवाश्च ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2073025, "chapter_id": 2542, "verse_number": "१२-४७-२", "content_sanskrit": "रथैस्तैर्नगरप्रख्यैः पताकाध्वजशोभितैः।\nययुराशु कुरुक्षेत्रं वाजिभिः शीघ्रगामिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2073026, "chapter_id": 2542, "verse_number": "१२-४७-३", "content_sanskrit": "तेऽवतीर्य कुरुक्षेत्रे केशमढज्जास्थिसंकुले।\nदेहन्यासः कृंतो यत्र क्षत्रियैस्तैर्महारथैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2073027, "chapter_id": 2542, "verse_number": "१२-४७-४", "content_sanskrit": "गजाश्वदेहास्थिचयैः पर्वतैरिव संचितम्।\nनरशीर्षकपालैश्च हंसैरिव च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2073028, "chapter_id": 2542, "verse_number": "१२-४७-५", "content_sanskrit": "चितासहस्रैर्निचितं वर्मशस्त्रसमाकुलम्।\nआपानभूमिं कालस्य तदा भुक्तोज्झितामिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2073029, "chapter_id": 2542, "verse_number": "१२-४७-६", "content_sanskrit": "भूतसङ्घानुचरितं रक्षोगणनिषेवितम्।\nपश्यन्तस्ते कुरुक्षेत्रं ययुराशु महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2073030, "chapter_id": 2542, "verse_number": "१२-४७-७", "content_sanskrit": "गच्छन्नेव महाबाहुः सर्वं यादवनन्दनः।\nयुधिष्ठिराय प्रोवाच जामदग्न्यस्य विक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2073031, "chapter_id": 2542, "verse_number": "१२-४७-८", "content_sanskrit": "अमी रामह्रदाः पञ्च दृश्यन्ते पार्थ दूरतः।\nयेषु संतर्पयामास पितॄन्क्षत्रियशोणितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2073032, "chapter_id": 2542, "verse_number": "१२-४७-९", "content_sanskrit": "त्रिःसप्तकृत्वो वसुधां कृत्वा निःक्षत्रियां प्रभुः।\nइहेदानीं ततो रामः कर्मणो विरराम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2073033, "chapter_id": 2542, "verse_number": "१२-४७-१०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2073034, "chapter_id": 2542, "verse_number": "१२-४७-१०", "content_sanskrit": "त्रिःसप्तकृत्वः पृथिवी कृता निःक्षत्रिया पुरा।\nरामेणेति यदात्थ त्वमत्र मे संशयो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2073035, "chapter_id": 2542, "verse_number": "१२-४७-११", "content_sanskrit": "क्षत्रबीजं यथा दग्धं रामेण यदुपुङ्गव।\nकथं भूयः समुत्यत्तिः क्षत्रस्यामितविक्रम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2073036, "chapter_id": 2542, "verse_number": "१२-४७-१२", "content_sanskrit": "महात्मना भगवता रामेण यदुपुङ्गव।\nकथमुत्सादित्तं क्षत्रं कथमृद्धिगतं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2073037, "chapter_id": 2542, "verse_number": "१२-४७-१३", "content_sanskrit": "महता रथयुद्धेन कोटिशः क्षत्रिया हताः।\nतथाऽभूच्च मही कीर्णा क्षत्रियैर्वदतां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2073038, "chapter_id": 2542, "verse_number": "१२-४७-१४", "content_sanskrit": "किमर्थं भार्गवेणेदं क्षत्रमुत्सादितं पुरा।\nरामेण यदुशार्दूल कुरुक्षेत्रे महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2073039, "chapter_id": 2542, "verse_number": "१२-४७-१५", "content_sanskrit": "एतन्मे छिन्धि वार्ष्णेय संशयं तार्क्ष्यकेतन।\nआगमो हि परः कृष्ण त्वत्तो नो वासवानुज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2073040, "chapter_id": 2542, "verse_number": "१२-४७-१६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2073041, "chapter_id": 2542, "verse_number": "१२-४७-१६", "content_sanskrit": "ततो व्रजन्नेव गदाग्रजः प्रभुः\nशशंस तस्मै निखिलेन तत्त्वतः।\nयुधिष्ठिरायाप्रतिमौजसे तदा\nयथाऽभवत्क्षत्रियसंकुला मही॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2073042, "chapter_id": 2542, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि सप्तचत्वारिंशोऽध्यायः॥ ४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]