[{"id": 7004364000, "chapter_id": 24364, "verse_number": "५-३-५८-१", "content_sanskrit": "उत्तानपाद उवाच ।\nअथातो देवदेवेश भानुमत्यकरोच्च किम् ।\nएष मे संशयो देव कथयस्व प्रसादतः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004364001, "chapter_id": 24364, "verse_number": "५-३-५८-२", "content_sanskrit": "ईश्वर उवाच ।\nचिन्तयित्वा मुहूर्तं सा गता कुण्डस्य सन्निधौ ।\nदृष्ट्वा कुण्डस्य माहात्म्यं राज्ञी हर्षेण पूरिता॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004364002, "chapter_id": 24364, "verse_number": "५-३-५८-३", "content_sanskrit": "विप्रान् बहून् समाहूय पूजयामास तत्क्षणात् ।\nदत्त्वा तु विधिवद्दानं ब्राह्मणेभ्यो नृपात्मज॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004364003, "chapter_id": 24364, "verse_number": "५-३-५८-४", "content_sanskrit": "निश्चयं परमं कृत्वा स्थिता शान्तेन चेतसा ।\nततः सम्पूज्य विधिवत्पितॄन्देवान्नराधिप॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004364004, "chapter_id": 24364, "verse_number": "५-३-५८-५", "content_sanskrit": "क्षपयित्वा पक्षमेकं मधुमासस्य सा स्थिता ।\nअमावास्यां ततो राज्ञी गता पर्वतसन्निधौ॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004364005, "chapter_id": 24364, "verse_number": "५-३-५८-६", "content_sanskrit": "नगशृङ्गं समारुह्य कृत्वा मुकुलितौ करौ ।\nविज्ञाप्य ब्राह्मणान् सर्वानिदं वचनमब्रवीत्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004364006, "chapter_id": 24364, "verse_number": "५-३-५८-७", "content_sanskrit": "मम माता पिता भ्राता ये चान्ये सखिबान्धवाः ।\nक्षमापयित्वा सर्वांस्तान्वचनं मम कथ्यताम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004364007, "chapter_id": 24364, "verse_number": "५-३-५८-८", "content_sanskrit": "त्वत्पुत्री शूलभेदे तु तपः कृत्वा स्वशक्तितः ।\nविसृज्य चैव सात्मानं तस्मिंस्तीर्थे दिवं ययौ॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004364008, "chapter_id": 24364, "verse_number": "५-३-५८-९", "content_sanskrit": "ब्राह्मणा ऊचुः ।\nसंदेशं कथयिष्यामस्त्वयोक्तं शोभनव्रते ।\nमातापितृभ्यां सुश्रोणि मा तेऽभूदत्र संशयः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004364009, "chapter_id": 24364, "verse_number": "५-३-५८-१०", "content_sanskrit": "ततो विसृज्य तांल्लोकान् स्थिता पर्वतमूर्धनि ।\nअर्धोत्तरीयवस्त्रेण गाढं बद्धा पुनःपुनः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004364010, "chapter_id": 24364, "verse_number": "५-३-५८-११", "content_sanskrit": "ततश्चिक्षेप सात्मानमेकचित्ता नराधिप ।\nनगार्द्धे पतिता यावत्तावद्दृष्टाः सुराङ्गनाः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004364011, "chapter_id": 24364, "verse_number": "५-३-५८-१२", "content_sanskrit": "भोभो वत्से महाभागे भानुमत्यतितापसि ।\nदिव्यं विमानमारुह्य कैलासं प्रति गम्यताम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004364012, "chapter_id": 24364, "verse_number": "५-३-५८-१३", "content_sanskrit": "ततः सा पश्यतां तेषां जनानां त्रिदिवं गता॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004364013, "chapter_id": 24364, "verse_number": "५-३-५८-१४", "content_sanskrit": "मार्कण्डेय उवाच ।\nइति ते कथितः सर्वः शूलभेदस्य विस्तरः ।\nयः श्रुतः शङ्करात्पूर्वमृषिदेवसमागमे॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004364014, "chapter_id": 24364, "verse_number": "५-३-५८-१५", "content_sanskrit": "य इदं पठते भक्त्या तीर्थे देवकुलेऽपि वा ।\nस मुच्यते महापापादपि जन्मशतार्जितात्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004364015, "chapter_id": 24364, "verse_number": "५-३-५८-१६", "content_sanskrit": "ब्रह्महा च सुरापी च स्तेयी च गुरुतल्पगः ।\nगोघाती स्त्रीविघाती च देवब्रह्मस्वहारकः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004364016, "chapter_id": 24364, "verse_number": "५-३-५८-१७", "content_sanskrit": "स्वामिद्रोही मित्रघाती तथा विश्वासघातकः ।\nपरन्यासापहारी च परनिक्षेपलोपकः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004364017, "chapter_id": 24364, "verse_number": "५-३-५८-१८", "content_sanskrit": "रसभेदी तुलाभेदी तथा वार्द्धुषिकस्तु यः ।\nयः कन्याविघ्नकर्ता च तथा विक्रयकारकः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004364018, "chapter_id": 24364, "verse_number": "५-३-५८-१९", "content_sanskrit": "परभार्या भ्रातृभार्या गौः स्नुषा कन्यका तथा ।\nअभिगामी परद्वेषी तथा धर्मप्रदूषकः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004364019, "chapter_id": 24364, "verse_number": "५-३-५८-२०", "content_sanskrit": "मुच्यन्ते सर्वे एवैते शूलभेदप्रभावतः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004364020, "chapter_id": 24364, "verse_number": "५-३-५८-२१", "content_sanskrit": "य इदं श्रावयेच्छ्राद्धे विप्राणां भुञ्जतां नृप ।\nमुदं प्रयान्ति संहृष्टाः पितरस्तस्य सर्वशः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004364021, "chapter_id": 24364, "verse_number": "५-३-५८-२२", "content_sanskrit": "यश्चेदं शृणुयाद्भक्त्या पठ्यमानं नरो वशी ।\nस मुक्तः सर्वपापेभ्यः सर्वकल्याणभाग्भवेत्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004364022, "chapter_id": 24364, "verse_number": "५-३-५८-२३", "content_sanskrit": "इदं यशस्यमायुष्यमिदं पावनमुत्तमम् ।\nपठतां शृण्वतां नृणामायुःकीर्तिविवर्धनम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]