[{"id": 7004166000, "chapter_id": 24166, "verse_number": "५-१-१५-१", "content_sanskrit": "सनत्कुमार उवाच ।\nशृणु व्यास महातीर्थं नाम्ना शंकरवापिका ।\nक्रीडमानेन देवेन निर्मितं तीर्थमुत्तमम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004166001, "chapter_id": 24166, "verse_number": "५-१-१५-२", "content_sanskrit": "प्रक्षिप्तं देवदेवेन कपालक्षालनं जलम् ।\nवापीगतं कृतं यस्मादतः शंकरवापिका॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004166002, "chapter_id": 24166, "verse_number": "५-१-१५-३", "content_sanskrit": "अर्काष्टम्यां नरः स्नात्वा दिशासु विदिशासु च ।\nपूर्वादिक्रमतो यावद्वापीमध्ये तथैव च॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004166003, "chapter_id": 24166, "verse_number": "५-१-१५-४", "content_sanskrit": "हविष्यान्नयुतान्व्यास दद्याच्च करका न्नवान् ।\nशाकमूलांश्च विप्रेभ्यस्तस्य पुण्यफलं शृणु॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004166004, "chapter_id": 24166, "verse_number": "५-१-१५-५", "content_sanskrit": "परत्र चेह ये लोकाः सर्वभावसमन्विताः ।\nतत्रतत्र समायाति भुनक्त्यैश्वर्यमुत्तमम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004166005, "chapter_id": 24166, "verse_number": "५-१-१५-६", "content_sanskrit": "ये नरा कीर्तयिष्यंति माहात्म्यमतिभाविकाः ।\nरुद्रलोकेऽपि ते पूज्यास्तेभ्योऽपि सततं नमः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004166006, "chapter_id": 24166, "verse_number": "५-१-१५-७", "content_sanskrit": "सनत्कुमार उवाच ।\nततो वै देवदेवेशः पिनाकी वृषभध्वजः ।\nतुष्टाव प्रयतो भूत्वा देवदेवं दिवाकरम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004166007, "chapter_id": 24166, "verse_number": "५-१-१५-८", "content_sanskrit": "आजगाम दिवानाथः संतुष्टः प्राह शंकरम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004166008, "chapter_id": 24166, "verse_number": "५-१-१५-९", "content_sanskrit": "सूर्य उवाच ।\nवरं वरय भूतेश वरदोऽस्मि ददामि ते ।\nतमाह वरदश्चेत्त्वं याच्यमानं कुरुष्व मे॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004166009, "chapter_id": 24166, "verse_number": "५-१-१५-१०", "content_sanskrit": "अंशेन स्थीयतामत्र हितार्थं सर्वदेहिनाम् ।\nअवतीर्णो रविस्तत्र श्रुत्वा माहेश्वरं वचः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004166010, "chapter_id": 24166, "verse_number": "५-१-१५-११", "content_sanskrit": "ततो देवाधिदेवस्य शंकरस्य महौजसः ।\nवाक्येन भास्करस्तत्र ययौ ख्यातिं महाद्युतिः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004166011, "chapter_id": 24166, "verse_number": "५-१-१५-१२", "content_sanskrit": "शंकरादित्यनामेति लोकानुग्रहकारकः ।\nदेवा दैत्याश्च गंधर्वा विस्मिताः सह किन्नरैः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004166012, "chapter_id": 24166, "verse_number": "५-१-१५-१३", "content_sanskrit": "अहो धन्यमिदं स्थानं यत्रास्ते त्रिपुरांतकः ।\nभास्करोऽपि च तत्रस्थस्तीर्थमध्ये च वर्तते॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004166013, "chapter_id": 24166, "verse_number": "५-१-१५-१४", "content_sanskrit": "ततस्तुष्टाश्च ते सर्वे ब्रह्माद्याः सुरसत्तमाः ।\nदेवेशं पूजयामासुरादित्यं शंकरं तथा॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004166014, "chapter_id": 24166, "verse_number": "५-१-१५-१५", "content_sanskrit": "मूर्तिमंतश्च ते देवा अवतीर्य च शोभनम् ।\nस्थापयित्वाऽब्रवीद्वाक्यं येऽत्र स्नास्यंति मानवाः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004166015, "chapter_id": 24166, "verse_number": "५-१-१५-१६", "content_sanskrit": "न दुःखं जायते तेषां जरामरण शोकजम् ।\nसर्वयज्ञेषु यत्पुण्यं सर्वदानेषु यत्फलम् ।\nतस्माच्चैवाधिकं ह्यत्र शंकरादित्यदर्शनात्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004166016, "chapter_id": 24166, "verse_number": "५-१-१५-१७", "content_sanskrit": "व्याधयो नाधयश्चैव दारिद्र्यं न कदाचन ।\nऐश्वर्यं चातुलं तेषां जायते भुवि सर्वदा॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004166017, "chapter_id": 24166, "verse_number": "५-१-१५-१८", "content_sanskrit": "न रोगो न च दारिद्र्यं वियोगो न च बन्धुभिः ।\nजायते मुनिशार्दूल शंकरादित्यदर्शनात्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004166018, "chapter_id": 24166, "verse_number": "५-१-१५-१९", "content_sanskrit": "इत्येवं देवदेवेन पुरा वै शूलपाणिना ।\nशंकरादित्यनाम्ना च स्थापितं परमं पदम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]