[{"id": 5000335000, "chapter_id": 9335, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे त्रिषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000335001, "chapter_id": 9335, "verse_number": "४-६३-१", "content_sanskrit": "एतैरन्यैश्च बहुभिर्वाक्यैर्वाक्यविशारदः।\nमां प्रशस्याभ्यनुज्ञाप्य प्रविष्टः स स्वमालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000335002, "chapter_id": 9335, "verse_number": "४-६३-२", "content_sanskrit": "कन्दरात् तु विसर्पित्वा पर्वतस्य शनैः शनैः।\nअहं विन्ध्यं समारुह्य भवतः प्रतिपालये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000335003, "chapter_id": 9335, "verse_number": "४-६३-३", "content_sanskrit": "अद्य त्वेतस्य कालस्य वर्षं साग्रशतं गतम्।\nदेशकालप्रतीक्षोऽस्मि हृदि कृत्वा मुनेर्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000335004, "chapter_id": 9335, "verse_number": "४-६३-४", "content_sanskrit": "महाप्रस्थानमासाद्य स्वर्गते तु निशाकरे।\nमां निर्दहति संतापो वितर्कैर्बहुभिर्वृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000335005, "chapter_id": 9335, "verse_number": "४-६३-५", "content_sanskrit": "उदितां मरणे बुद्धिं मुनिवाक्यैर्निवर्तये।\nबुद्धिर्या तेन मे दत्ता प्राणानां रक्षणे मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000335006, "chapter_id": 9335, "verse_number": "४-६३-६", "content_sanskrit": "सा मेऽपनयते दुःखं दीप्तेवाग्निशिखा तमः।\nबुध्यता च मया वीर्यं रावणस्य दुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000335007, "chapter_id": 9335, "verse_number": "४-६३-७", "content_sanskrit": "पुत्रः संतर्जितो वाग्भिर्न त्राता मैथिली कथम्।\nतस्या विलपितं श्रुत्वा तौ च सीतावियोजितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000335008, "chapter_id": 9335, "verse_number": "४-६३-८", "content_sanskrit": "न मे दशरथस्नेहात् पुत्रेणोत्पादितं प्रियम्।\nतस्य त्वेवं ब्रुवाणस्य संहतैर्वानरैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000335009, "chapter_id": 9335, "verse_number": "४-६३-९", "content_sanskrit": "उत्पेततुस्तदा पक्षौ समक्षं वनचारिणाम्।\nस दृष्ट्वा स्वां तनुं पक्षैरुद‍्गतैररुणच्छदैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000335010, "chapter_id": 9335, "verse_number": "४-६३-१०", "content_sanskrit": "प्रहर्षमतुलं लेभे वानरांश्चेदमब्रवीत्।\nनिशाकरस्य राजर्षेः प्रसादादमितौजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000335011, "chapter_id": 9335, "verse_number": "४-६३-११", "content_sanskrit": "आदित्यरश्मिनिर्दग्धौ पक्षौ पुनरुपस्थितौ।\nयौवने वर्तमानस्य ममासीद् यः पराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000335012, "chapter_id": 9335, "verse_number": "४-६३-१२", "content_sanskrit": "तमेवाद्यावगच्छामि बलं पौरुषमेव च।\nसर्वथा क्रियतां यत्नः सीतामधिगमिष्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000335013, "chapter_id": 9335, "verse_number": "४-६३-१३", "content_sanskrit": "पक्षलाभो ममायं वः सिद्धिप्रत्ययकारकः।\nइत्युक्त्वा तान् हरीन् सर्वान् सम्पातिः पतगोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000335014, "chapter_id": 9335, "verse_number": "४-६३-१४", "content_sanskrit": "उत्पपात गिरेः शृङ्गाज्जिज्ञासुः खगमो गतिम्।\nतस्य तद् वचनं श्रुत्वा प्रतिसंहृष्टमानसाः।\nबभूवुर्हरिशार्दूला विक्रमाभ्युदयोन्मुखाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000335015, "chapter_id": 9335, "verse_number": "४-६३-१५", "content_sanskrit": "अथ पवनसमानविक्रमाः\nप्लवगवराः प्रतिलब्धपौरुषाः।\nअभिजिदभिमुखां दिशं ययु-\nर्जनकसुतापरिमार्गणोन्मुखाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000335016, "chapter_id": 9335, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे त्रिषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]