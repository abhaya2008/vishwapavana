[{"id": 40020471, "chapter_id": 9335, "verse_number": "1", "content_sanskrit": "स जित्वा धनदं राम भ्रातरं राक्षसाधिपः । महासेनप्रसूतिं तद्ययौ शरवणं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40020472, "chapter_id": 9335, "verse_number": "2", "content_sanskrit": "अथापश्यदृशग्रीवो रौक्मं शरवणं महत् । गभस्तिजालसंवीतं द्वितीयमिव भास्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40020473, "chapter_id": 9335, "verse_number": "3", "content_sanskrit": "स पर्वतं समारुह्य कञ्चिद्रम्यवनान्तरम् । अपश्यत् पुष्पकं तत्र रामविष्टम्भितं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40020474, "chapter_id": 9335, "verse_number": "4", "content_sanskrit": "विष्टब्धं पुष्पकं दृष्ट्वा ह्यगमं कामागं कृतम् । अचिन्तयद्राक्षसेन्द्रः सचिवैस्तैः समावृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40020475, "chapter_id": 9335, "verse_number": "5", "content_sanskrit": "किन्निमित्तं चेच्छया मे नेदं गच्छति पुष्पकम् । पर्वतस्योपरिष्ठस्य कर्मेदं कस्यचिद्भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40020476, "chapter_id": 9335, "verse_number": "6", "content_sanskrit": "ततो ऽब्रवीत्तदा राम मारीचो बुद्धिकोविदः । नेदं निष्कारणं राजन्पुष्पकं यन्न गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40020477, "chapter_id": 9335, "verse_number": "7", "content_sanskrit": "अथवा पुष्पकमिदं धनदान्नान्यवाहनम् । अतो निष्पन्दमभवद्धनाध्यक्षविनाकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40020478, "chapter_id": 9335, "verse_number": "8", "content_sanskrit": "इति वाक्यान्तरे तस्य करालः कृष्णपिङ्गलः । वामनो विकटो मुण्डी नन्दी प्रह्वभुजो बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40020479, "chapter_id": 9335, "verse_number": "9", "content_sanskrit": "ततः पार्श्वमुपागम्य भवस्यानुचरो ऽब्रवीत् । नन्दीश्वरो वचश्चेदं राक्षसेन्द्रमशङ्कितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40020480, "chapter_id": 9335, "verse_number": "10", "content_sanskrit": "निवर्तस्व दशग्रीव शैले क्रीडति शङ्करः । सुपर्णनागयक्षाणां देवगन्धर्वरक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40020481, "chapter_id": 9335, "verse_number": "11", "content_sanskrit": "सर्वेषामेव भूतानामगम्यः पर्वतः कृतः । इति नन्दिवचः श्रुत्वा क्रोधात्कम्पितकुण्डलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40020482, "chapter_id": 9335, "verse_number": "12", "content_sanskrit": "रोषात्तु ताम्रनयनः पुष्पकादवरुह्य सः । को ऽयं शङ्कर इत्युक्त्वा शैलमूलमुपागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40020483, "chapter_id": 9335, "verse_number": "13", "content_sanskrit": "सो ऽपश्यन्नन्दिनं तत्र देवस्यादूरतः स्थितम् । दीप्तं शूलमवष्टभ्य द्वितीयमिव शङ्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40020484, "chapter_id": 9335, "verse_number": "14", "content_sanskrit": "तं दृष्ट्वा वानरमुखमवज्ञाय स राक्षसः । प्रहासं मुमुचे तत्र सतोय इव तोयदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40020485, "chapter_id": 9335, "verse_number": "15", "content_sanskrit": "तं क्रुद्धो भगवान्नन्दी शङ्करस्यापरा तनुः । अब्रवीत्तत्र तद्रक्षो दशाननमुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40020486, "chapter_id": 9335, "verse_number": "16", "content_sanskrit": "यस्माद्वानररूपं मामवज्ञाय दशानन । अशनीपातसङ्काशमपहासं प्रमुक्तवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40020487, "chapter_id": 9335, "verse_number": "17", "content_sanskrit": "तस्मान्मद्रूपसम्पन्ना मद्वीर्यसमतेजसः । उत्पत्स्यन्ति वधार्थं हि कुलस्य तव वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40020488, "chapter_id": 9335, "verse_number": "18", "content_sanskrit": "नखदंष्ट्रायुधाः क्रूरा मनःसम्पातरंहसः । युद्धोन्मत्ता बलोद्रिक्ताः शैला इव विसर्पिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40020489, "chapter_id": 9335, "verse_number": "19", "content_sanskrit": "ते तव प्रबलं दर्पमुत्सेधं च पृथग्विधम् । व्यपनेष्यन्ति सम्भूय सहामात्यसुतस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40020490, "chapter_id": 9335, "verse_number": "20", "content_sanskrit": "किं त्विदानीं मया शक्यं हन्तुं त्वां हे निशाचर । न हन्तव्यो हतस्त्वं हि पूर्वमेव स्वकर्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40020491, "chapter_id": 9335, "verse_number": "21", "content_sanskrit": "इत्युदीरितवाक्ये तु देवे तस्मिन्महात्मनि । देवदुन्दुभयो नेदुः पुष्पवृष्टिश्च खाच्च्युता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40020492, "chapter_id": 9335, "verse_number": "22", "content_sanskrit": "अचिन्तयित्वा स तदा नन्दिवाक्यं महाबलः । पर्वतं तु समासाद्य वाक्यमाह दशाननः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40020493, "chapter_id": 9335, "verse_number": "23", "content_sanskrit": "पुष्पकस्य गतिश्छिन्ना यत्कृते मम गच्छतः । तमिमं शैलमुन्मूलं करोमि तव गोपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40020494, "chapter_id": 9335, "verse_number": "24", "content_sanskrit": "केन प्रभावेण भवो नित्यं क्रीडति राजवत् । विज्ञातव्यं न जानीते भयस्थानमुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40020495, "chapter_id": 9335, "verse_number": "25", "content_sanskrit": "एवमुक्त्वा ततो राम भुजान्विक्षिप्य पर्वते । तोलयामास तं शीघ्रं स शैलं समकम्पत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40020496, "chapter_id": 9335, "verse_number": "26", "content_sanskrit": "चालनात्पर्वतस्यैव गणा देवस्य कम्पिताः । चचाल पार्वती चापि तदा ऽ ऽश्लिष्टा महेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40020497, "chapter_id": 9335, "verse_number": "27", "content_sanskrit": "ततो राम महादवो देवानां प्रवरो हरः । पादाङ्गुष्ठेन तं शैलं पीडयामास लीलया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40020498, "chapter_id": 9335, "verse_number": "28", "content_sanskrit": "पीडितास्तु ततस्तस्य शैलस्याधोगता भुजाः । विस्मिताश्चाभवंस्तत्र सचिवास्तस्य रक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40020499, "chapter_id": 9335, "verse_number": "29", "content_sanskrit": "रक्षसा तेन रोषाच्च भुजानां पीडनात्तदा । मुक्तो विरावः सहसा त्रैलोक्यं येन कम्पितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40020500, "chapter_id": 9335, "verse_number": "30", "content_sanskrit": "मेनिरे वज्रनिष्पेषं तस्यामात्या युगक्षये । तदा वर्त्मस्थचलिता देवा इन्द्रपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40020501, "chapter_id": 9335, "verse_number": "31", "content_sanskrit": "समुद्राश्चापि सङ्क्षुब्धाश्चलिताश्चापि पर्वताः । यक्षा विद्याधराः सिद्धाः किमेतदिति चाब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40020502, "chapter_id": 9335, "verse_number": "32", "content_sanskrit": "अथ ते मन्त्रिणस्तस्य विक्रोशन्तमथाब्रुवन् । तोषयस्व महादेवं नीलकण्ठमुमापतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40020503, "chapter_id": 9335, "verse_number": "33", "content_sanskrit": "तमृते शरणं नान्यं पश्यामो ऽत्र दशानन । स्तुतिभिः प्रणतो भूत्वा तमेव शरणं व्रज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40020504, "chapter_id": 9335, "verse_number": "34", "content_sanskrit": "कृपालुः शङ्करस्तुष्टः प्रसादं ते विधास्यति । एवमुक्तस्तदामात्यैस्तुष्टाव वृषभध्वजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40020505, "chapter_id": 9335, "verse_number": "35", "content_sanskrit": "सामभिर्विविधैः स्तोत्रैः प्रणम्य स दशाननः । संवत्सरसहस्रं तु रुदतो रक्षसो गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40020506, "chapter_id": 9335, "verse_number": "36", "content_sanskrit": "ततः प्रीतो महादेवः शैलाग्रे विष्ठितः प्रभुः । मुक्त्वा चास्य भुजान्राम प्राह वाक्यं दशाननम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40020507, "chapter_id": 9335, "verse_number": "37", "content_sanskrit": "प्रीतो ऽस्मि तव वीर्यस्य शौण्डार्याच्च दशानन । शैलाक्रान्तेन यो मुक्तस्त्वया रावः सुदारुणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40020508, "chapter_id": 9335, "verse_number": "38", "content_sanskrit": "यस्माल्लोकत्रयं चैतद्रावितं भयमागतम् । तस्मात्त्वं रावणो नाम नाम्ना राजन्भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40020509, "chapter_id": 9335, "verse_number": "39", "content_sanskrit": "देवता मानुषा यक्षा ये चान्ये जगतीतले । एवं त्वामभिधास्यन्ति रावणं लोकरावणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40020510, "chapter_id": 9335, "verse_number": "40", "content_sanskrit": "गच्छ पौलस्त्य विस्रब्धं पथा येन त्वमिच्छसि । मया चैवाभ्यनुज्ञातो राक्षसाधिप गम्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40020511, "chapter_id": 9335, "verse_number": "41", "content_sanskrit": "एवमुक्तस्तु लङ्केशः शम्भुना स्वयमब्रवीत् । प्रीतो यदि महादेव वरं मे देहि याचतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40020512, "chapter_id": 9335, "verse_number": "42", "content_sanskrit": "अवध्यत्वं मया प्राप्तं देवगन्धर्वदानवैः । राक्षसैर्गुह्यकैर्नागैर्ये चान्ये बलवत्तराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40020513, "chapter_id": 9335, "verse_number": "43", "content_sanskrit": "मानुषान्न गणे देव स्वल्पास्ते मम सम्मताः । दीर्घमायुश्च मे प्राप्तं ब्रह्मणस्त्रिपुरान्तक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40020514, "chapter_id": 9335, "verse_number": "44", "content_sanskrit": "वाञ्छितं चायुषः शेषं शस्त्रं त्वं च प्रयच्छ मे । एवमुक्तस्ततस्तेन रावणेन स शङ्करः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40020515, "chapter_id": 9335, "verse_number": "45", "content_sanskrit": "ददौ खड्गं महादीप्तं चन्द्रहासमिति श्रुतम् । आयुषश्चावशेषं च स्थित्वा भूतपतिस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40020516, "chapter_id": 9335, "verse_number": "46", "content_sanskrit": "दत्त्वोवाच ततः शम्भुर्नावज्ञेयमिदं त्वया । अवज्ञातं यदि हि ते मामेवैष्यत्यसंशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40020517, "chapter_id": 9335, "verse_number": "47", "content_sanskrit": "एवं महेश्वरेणैव कृतनामा स रावणः । अभिवाद्य महादेवमारुरोहाथ पुष्पकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 40020518, "chapter_id": 9335, "verse_number": "48", "content_sanskrit": "ततो महीतले राम पर्यक्रामत रावणः । क्षत्ऺित्रयान्सुमहावीर्यान्बाधमान इतस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 40020519, "chapter_id": 9335, "verse_number": "49", "content_sanskrit": "केचित्तेजस्विनः शूराः क्षत्ऺित्रया युद्धदुर्मदाः । तच्छासनमकुर्वन्तो विनेशुः सपरिच्छदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 40020520, "chapter_id": 9335, "verse_number": "50", "content_sanskrit": "अपरे दुर्जयं रक्षो जानन्तः प्राज्ञसम्मताः । जिताः स्म इत्यभाषन्त राक्षसं बलदर्पितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]