[{"id": 2149861, "chapter_id": 4247, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2149862, "chapter_id": 4247, "verse_number": "१", "content_sanskrit": "एवमुक्तस्तदा रामो जहि भीष्ममिति प्रभो ।\nउवाच रुदतीं कन्यां चोदयन्तीं पुनः पुनः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2149863, "chapter_id": 4247, "verse_number": "२", "content_sanskrit": "काश्ये कामं न गृह्णामि शस्त्रं वै वरवर्णिनि ।\nऋते ब्रह्मविदां हेतोः किमन्यत् करवाणि ते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2149864, "chapter_id": 4247, "verse_number": "३", "content_sanskrit": "वाचा भीष्मश्च साल्वश्च मम राज्ञि वशानुगौ ।\nभविष्यतोऽनवद्याङ्गि तत् करिष्यामि मा शुचः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2149865, "chapter_id": 4247, "verse_number": "४", "content_sanskrit": "न तु शस्त्रं ग्रहीष्यामि कथञ्चिदपि भामिनि ।\nऋते नियोगाद् विप्राणामेष मे समयः कृतः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2149866, "chapter_id": 4247, "verse_number": "", "content_sanskrit": "अम्बा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2149867, "chapter_id": 4247, "verse_number": "५", "content_sanskrit": "मम दुःखं भगवता व्यपनेयं यतस्ततः ।\nतच्च भीष्मप्रसूतं मे तं जहीश्वर माचिरम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2149868, "chapter_id": 4247, "verse_number": "", "content_sanskrit": "रामः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2149869, "chapter_id": 4247, "verse_number": "६", "content_sanskrit": "काशिकन्ये पुनर्ब्रूहि भीष्मस्ते चरणावुभौ ।\nशिरसा वन्दनार्होऽपि ग्रहीष्यति गिरा मम\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2149870, "chapter_id": 4247, "verse_number": "", "content_sanskrit": "अम्बा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2149871, "chapter_id": 4247, "verse_number": "७", "content_sanskrit": "जहि भीष्मं रणे वीर मम चेदिच्छसि प्रियम् ।\nप्रतिश्रुतं च यदिदं तत् सत्यं कर्तुमर्हसि\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2149872, "chapter_id": 4247, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2149873, "chapter_id": 4247, "verse_number": "८", "content_sanskrit": "तयोः संवदतोरेवं राजन् रामाम्बयोस्तदा ।\nअकृतव्रणो जामदग्न्यमिदं वचनमब्रवीत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2149874, "chapter_id": 4247, "verse_number": "९", "content_sanskrit": "शरणागतां महाबाहो कन्यां न त्यक्तुमर्हसि ।\nजहि भीष्मं रणे राम गर्जन्तमसुरं यथा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2149875, "chapter_id": 4247, "verse_number": "१०", "content_sanskrit": "यदि भीष्मो रणे राम समाहूतस्त्वया मृधे ।\nनिर्जितोऽस्मीति वा ब्रूयात् कुर्याद्वा वचनं तव\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2149876, "chapter_id": 4247, "verse_number": "११", "content_sanskrit": "कृतमस्या भवेत् कार्यं कन्याया भृगुनन्दन ।\nवाक्यं सत्यं च ते वीर भविष्यति कृतं विभो\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2149877, "chapter_id": 4247, "verse_number": "१२", "content_sanskrit": "इयं चापि प्रतिज्ञा ते तदा राम महामुने\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2149878, "chapter_id": 4247, "verse_number": "१३", "content_sanskrit": "जित्वा वै क्षत्रियान् सर्वान् ब्राह्मणेषु प्रतिश्रुता\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2149879, "chapter_id": 4247, "verse_number": "१४", "content_sanskrit": "ब्राह्मणः क्षत्रियो वैश्यः शूद्रश्चैव रणे यदि ।\nब्रह्मद्विड् भविता तं वै हनिष्यामीति भार्गव\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2149880, "chapter_id": 4247, "verse_number": "१५", "content_sanskrit": "शरणं हि प्रपन्नानां भीतानां जीवितार्थिनाम् ।\nन शक्ष्यामि परित्यागं कर्तुं जीवन् कथञ्चन\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2149881, "chapter_id": 4247, "verse_number": "१६", "content_sanskrit": "यश्च क्षत्रं रणे कृत्स्नं विजेष्यति समागतम् ।\nदृप्तात्मानमहं तं च हनिष्यामीति भार्गव\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2149882, "chapter_id": 4247, "verse_number": "१७", "content_sanskrit": "स एष विजयी राम भीष्मः कुरुकुलोद्वहः ।\nतेन युध्यस्व सङ्ग्रामे समेत्य भृगुनन्दन\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2149883, "chapter_id": 4247, "verse_number": "", "content_sanskrit": "रामः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2149884, "chapter_id": 4247, "verse_number": "१८", "content_sanskrit": "स्मराम्यहं पूर्वकृतां प्रतिज्ञामृषिसत्तम ।\nतथैव च करिष्यामि यथा साम्नैव लप्स्यते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2149885, "chapter_id": 4247, "verse_number": "१९", "content_sanskrit": "कार्यमेतन्महद् ब्रह्मन् काशिकन्यामनोगतम् ।\nगमिष्यामि स्वयं तत्र कन्यामादाय यत्र सः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2149886, "chapter_id": 4247, "verse_number": "२०", "content_sanskrit": "यदि भीष्मो रणश्लाघी न करिष्यति मद्वचः ।\nहनिष्याम्यहमुद्रिक्तमिति मे निश्चिता मतिः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2149887, "chapter_id": 4247, "verse_number": "२१", "content_sanskrit": "न हि बाणा मयोत्सृष्टाः सज्जन्तीह शरीरिणाम् ।\nकायेषु विदितं तुभ्यं पुरा क्षत्रियसङ्गरे\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2149888, "chapter_id": 4247, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2149889, "chapter_id": 4247, "verse_number": "२२", "content_sanskrit": "एवमुक्त्वा ततो रामः सह तैर्ब्रह्मवादिभिः ।\nप्रयाणाय मतिं कृत्वा समुत्तस्थौ महातपाः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2149890, "chapter_id": 4247, "verse_number": "२३", "content_sanskrit": "ततस्ते तामुषित्वा तु रजनीं तत्र तापसाः ।\nहुताग्नयो जप्तजप्याः प्रतस्थुर्मज्जिघांसया\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2149891, "chapter_id": 4247, "verse_number": "२४", "content_sanskrit": "अभ्यागच्छत् ततो रामः सह तैर्ब्रह्मवादिभिः ।\nकुरुक्षेत्रं महाराज कन्यया सह भार्गवः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2149892, "chapter_id": 4247, "verse_number": "२५", "content_sanskrit": "न्यविशन्त ततः सर्वे परिगृह्य सरस्वतीम् ।\nतापसास्ते महात्मानो भृगुश्रेष्ठपुरस्कृताः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2149893, "chapter_id": 4247, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि अष्टसप्तत्युत्तरशततमोऽध्यायः ॥१७८॥\nअम्बोपाख्यानपर्वणि अष्टमोऽध्यायः ॥८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]