[{"id": 2105844, "chapter_id": 3289, "verse_number": "१६-१८-१", "content_sanskrit": "कुन्त्युवाच।\nएवमेतन्महाबाहो यथा वदसि पाण्डवः।\nकृतमुद्धरणं पूर्वं मया वः सीदतां नृपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2105845, "chapter_id": 3289, "verse_number": "१६-१८-२", "content_sanskrit": "द्यूतापहृतराज्यानां पतितानां सुखादपि।\nज्ञातिभिः परिभूतानां कृतमुद्धरणं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2105846, "chapter_id": 3289, "verse_number": "१६-१८-३", "content_sanskrit": "कथं पाण्डोर्न नश्येत संततिः पुरुषर्षभाः।\nयशश्च वो न नश्येत इति चोद्धरणं कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2105847, "chapter_id": 3289, "verse_number": "१६-१८-४", "content_sanskrit": "यूयमिन्द्रसमाः सर्वे देवतुल्यपराक्रमाः।\nमा परेषां मुखप्रेक्षाः स्थेत्येवं तत्कृतं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2105848, "chapter_id": 3289, "verse_number": "१६-१८-५", "content_sanskrit": "कथं धर्मभृतां श्रेष्ठो राजा त्वं वासवोपमः।\nपुनर्वने न दुःखी स्या इति चोद्धरणं कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2105849, "chapter_id": 3289, "verse_number": "१६-१८-६", "content_sanskrit": "नागायुतसमप्राणः ख्यातविक्रमपौरुषः।\nनायं भीमोत्ययं गच्छेदिति चोद्धरणं कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2105850, "chapter_id": 3289, "verse_number": "१६-१८-७", "content_sanskrit": "भीमसेनादवरजस्तथाऽयं वासवोपमः।\nविजयो नावसीदेत इति चोद्धरणं कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2105851, "chapter_id": 3289, "verse_number": "१६-१८-८", "content_sanskrit": "नकुलः सहदेवश्च तथेमौ गुरुवर्तिनौ।\nक्षुधा कथं न सीदेतामिति चोद्धरणं कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2105852, "chapter_id": 3289, "verse_number": "१६-१८-९", "content_sanskrit": "इयं च बृहती श्यामा तथाऽत्यायतलोचना।\nवृथा सभातले क्लिष्टा मा भूदिति च तत्कृतं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2105853, "chapter_id": 3289, "verse_number": "१६-१८-१०", "content_sanskrit": "अपेक्षतामेव वो भीम वेपन्तीं कदलीमिव।\nस्त्रीधर्मिणीमरिष्टाङ्गीं तथा द्यूतपराजिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2105854, "chapter_id": 3289, "verse_number": "१६-१८-११", "content_sanskrit": "दुःशासनो यदा मौर्ख्याद्दासीवत्पर्यकर्षत।\nतदैव विदितं मह्यं पराभूतमिदं कुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2105855, "chapter_id": 3289, "verse_number": "१६-१८-१२", "content_sanskrit": "निषण्णाः कुरवश्चैव तदा मे श्वशुरादयः।\nसा दैवं नाथमिच्छन्ती व्यलपत्कुररी यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2105856, "chapter_id": 3289, "verse_number": "१६-१८-१३", "content_sanskrit": "केशपक्षे परामृष्टा पापेन् हतबुद्धिना।\nयदा दुःशासनेनैषा तदा मुह्याम्यहं नृपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2105857, "chapter_id": 3289, "verse_number": "१६-१८-१४", "content_sanskrit": "युष्मत्तेजोविवृद्ध्यर्तं मया ह्युद्धरणं कृतम्।\nतदानीं विदुलावाक्यैरिति तद्वित्त पुत्रकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2105858, "chapter_id": 3289, "verse_number": "१६-१८-१५", "content_sanskrit": "कथं न राजवंशोऽयं नश्येत्प्राप्य सुतान्मम।\nपाण्डोरिति मया पुत्रस्तस्मादुद्धरणं कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2105859, "chapter_id": 3289, "verse_number": "१६-१८-१६", "content_sanskrit": "न तस्य पुत्राः पौत्रा वा क्षतवंशस्य पार्थिव।\nलभ्ते सुकृताँल्लोकान्यस्माद्वंशः प्रणश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2105860, "chapter_id": 3289, "verse_number": "१६-१८-१७", "content_sanskrit": "भुक्तं राज्यफलं पुत्रा भर्तुर्मे विपुलं पुरा।\nमहादानानि दत्तानि पीतः सोमो यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2105861, "chapter_id": 3289, "verse_number": "१६-१८-१८", "content_sanskrit": "नाहमात्मफलार्थं वै वासुदेवमचूचुदम्।\nविदुलायाः प्रलापैस्तैः पालनार्थं च तत्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2105862, "chapter_id": 3289, "verse_number": "१६-१८-१९", "content_sanskrit": "नाहं राज्यफलं पुत्राः कामये पुत्रनिर्जितम्।\nपतिलोकानहं पुण्यान्कामये तपसा पिभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2105863, "chapter_id": 3289, "verse_number": "१६-१८-२०", "content_sanskrit": "श्वश्रूश्वशुरयोः कृत्वा शुश्रूषां वनवासिनोः।\nतपसा शोषयिष्यामि युधिष्ठिर कलेवरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2105864, "chapter_id": 3289, "verse_number": "१६-१८-२१", "content_sanskrit": "निवर्तस्व कुरुश्रेष्ठ भीमसेनादिभिः सह।\nधर्मे ते धीयतां बुद्धिर्मनस्तु महदस्तु च॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2105865, "chapter_id": 3289, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि आश्रमवासपर्वणि अष्टादशोऽध्यायः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]