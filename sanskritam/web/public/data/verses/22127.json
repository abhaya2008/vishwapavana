[{"id": 7002127000, "chapter_id": 22127, "verse_number": "१७२-१", "content_sanskrit": "सर्वपापप्रायश्चित्तानि ।\nपुष्कर उवाच ।\nपरदारपरद्रव्यजीवहिंसादिके यदा ।\nप्रवर्तते नृणां चित्तं प्रायश्चित्तं स्तुतिस्तदा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002127001, "chapter_id": 22127, "verse_number": "१७२-२", "content_sanskrit": "विष्णवे विष्णवे नित्यं विष्णवे विष्णवे नमः ।\nनमामि विष्णुं चित्तस्थमहङ्कारगतिं हरिं ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002127002, "chapter_id": 22127, "verse_number": "१७२-३", "content_sanskrit": "चित्तस्थमीशमव्यक्तमनन्तमपराजितं ।\nविष्णुमीड्यमशेषेण अनादिनिधनं विभुं ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002127003, "chapter_id": 22127, "verse_number": "१७२-४", "content_sanskrit": "विष्णुश्चित्तगतो यन्मे विष्णुर्बुद्धिगतश्च यत् ।\nयच्चाहङ्कारगो विष्णुर्यद्विष्णुर्मयि संस्थितः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002127004, "chapter_id": 22127, "verse_number": "१७२-५", "content_sanskrit": "करोति कर्मभूतोऽसौ स्थवरस्य चरस्य च ।\nतत्पापन्नाशमायातु तस्मिन्नेव हि चिन्तिते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002127005, "chapter_id": 22127, "verse_number": "१७२-६", "content_sanskrit": "ध्यातो हरति यत्पापं स्वप्ने दृष्टस्तु भावनात् ।\nतमुपेन्द्रमहं विष्णुं प्रणतार्तिहरं हरिं ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002127006, "chapter_id": 22127, "verse_number": "१७२-७", "content_sanskrit": "जगत्यस्मिन्निराधारे मज्जमाने तमस्यधः ।\nहस्तावलम्बनं विष्णुं प्रणमामि परात्परं ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002127007, "chapter_id": 22127, "verse_number": "१७२-८", "content_sanskrit": "सर्वेश्वरेश्वर विभो परमात्मन्नधोक्षज ।\nहृषीकेश हृषीकेश हृषीकेश नमोऽस्तु ते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002127008, "chapter_id": 22127, "verse_number": "१७२-९", "content_sanskrit": "नृसिंहानन्त गोविन्द भूतभवन केशव ।\nदुरुक्तं दुष्कृतं ध्यातं शमयाघन्नमोऽस्तु ते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002127009, "chapter_id": 22127, "verse_number": "१७२-१०", "content_sanskrit": "यन्मया चिन्तितं दुष्टं स्वचित्तवशवर्तिना ।\nअकार्यमहदत्युग्रन्तच्छमन्नय केशव ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002127010, "chapter_id": 22127, "verse_number": "१७२-११", "content_sanskrit": "ब्रह्मण्यदेव गोविन्द परमार्थपरायण ।\nजगन्नाथ जगद्धातः पापं प्रशमयाच्युत ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002127011, "chapter_id": 22127, "verse_number": "१७२-१२", "content_sanskrit": "यथापराह्णे सायाह्णे मध्याह्णे च तथा निशि ।\nकायेन मनसा वाचा कृतं पापमजानता ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002127012, "chapter_id": 22127, "verse_number": "१७२-१३", "content_sanskrit": "जानता च हृषीकेश पुण्डरीकाक्ष माधव ।\nनामत्रयोच्चारणतः स्वप्ने यातु मम क्षयं ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002127013, "chapter_id": 22127, "verse_number": "१७२-१४", "content_sanskrit": "शारीरं मे हृषीकेश पुण्डरीकाक्ष माधव ।\nपापं प्रशमयाद्य त्वं बाक्कृतं मम माधव ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002127014, "chapter_id": 22127, "verse_number": "१७२-१५", "content_sanskrit": "यद्भुञ्जन्यत्स्वपंस्तिष्ठन् गच्छन् जाग्रद्यदास्थितः ।\nकृतवान् पापमद्याहं कायेन मनसा गिरा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002127015, "chapter_id": 22127, "verse_number": "१७२-१६", "content_sanskrit": "यत्स्वल्पमपि यत्स्थूलं कुयोनिनरकाबहं ।\nतद्यातु प्रशमं सर्वं वासुदेवानुकीर्तनात् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002127016, "chapter_id": 22127, "verse_number": "१७२-१७", "content_sanskrit": "परं ब्रह्म परं धाम पवित्रं परमञ्च यत् ।\nतस्मिन् प्रकीर्तिते विष्णौ यत्पापं तत्प्रणश्यतु ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002127017, "chapter_id": 22127, "verse_number": "१७२-१८", "content_sanskrit": "यत्प्राप्य न निवर्तन्ते गन्धस्पर्शदिवर्जितं ।\nसूरयस्तत्पदं विष्णोस्तत्सर्वं शमयत्वघं ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002127018, "chapter_id": 22127, "verse_number": "१७२-१९", "content_sanskrit": "पापप्रणाशनं स्तोत्रं यः पठेच्छृणुयादपि ।\nशारीरैर्मानसैर्वाग्जैः कृतैः पपैः प्रमुच्यते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002127019, "chapter_id": 22127, "verse_number": "१७२-२०", "content_sanskrit": "सर्वपापग्रहादिभ्यो याति विष्णोः परं पदं ।\nतस्मात्पापे कृते जप्यं स्तोत्रं सर्वाघमर्दनं ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002127020, "chapter_id": 22127, "verse_number": "१७२-२१", "content_sanskrit": "प्रायश्चित्तमघौघानां स्तोत्रं व्रतकृते वरं ।\nप्रायश्चित्तैः स्तोत्रजपैर्व्रतैर्नश्यति पातकं ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002127021, "chapter_id": 22127, "verse_number": "१७२-२२", "content_sanskrit": "ततः कार्याणि संसिद्ध्यै तानि वै भुक्तिमुक्तये ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]