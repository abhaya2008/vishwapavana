[{"id": 7003394000, "chapter_id": 23394, "verse_number": "३४-१", "content_sanskrit": "महातपा उवाच ।\nपितॄणां संभवं राजन् कथ्यमानं निबोध मे ।\nपूर्वं प्रजापतिर्ब्रह्मा सिसृक्षुर्विविधाः प्रजाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003394001, "chapter_id": 23394, "verse_number": "३४-२", "content_sanskrit": "एकाग्रमनसा सर्वास्तन्मात्रा मनसा बहिः ।\nकृत्वा परमकं ब्रह्म ध्यायन् सर्गेप्सुरुच्चकैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003394002, "chapter_id": 23394, "verse_number": "३४-३", "content_sanskrit": "तस्यात्मनि तदा योगं गतस्य परमेष्ठिनः ।\nतन्मात्रा निर्ययुर्देहाद् धूमवर्णाकृतित्विषः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003394003, "chapter_id": 23394, "verse_number": "३४-४", "content_sanskrit": "पिबाम इति भाषन्तः सुरान् सोम इति स्म ह ।\nऊर्ध्वं जिगमिषन्तो वै वियत्संस्थास्तपस्विनः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003394004, "chapter_id": 23394, "verse_number": "३४-५", "content_sanskrit": "तान् दृष्ट्वा सहसा ब्रह्मा तिर्यक्संस्थान उन्मुखान् ।\nभवन्तः पितरः सन्तु सर्वेषां गृहमेधिनाम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003394005, "chapter_id": 23394, "verse_number": "३४-६", "content_sanskrit": "ऊर्ध्ववक्त्रास्तु ये तत्र ते नान्दीमुखसंज्ञिताः ।\nवृद्धिश्राद्धेषु सतत पूज्या श्रुतिविधानतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003394006, "chapter_id": 23394, "verse_number": "३४-७", "content_sanskrit": "अग्निं पुरस्कृतो यैस्तु ते द्विजा अग्निहोत्रिणः ।\nनित्यैर्नैमित्तिकैः काम्यैः पार्वणैस्तर्पयन्तु तान् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003394007, "chapter_id": 23394, "verse_number": "३४-८", "content_sanskrit": "बहिःप्रवरणा ये च क्षत्रियास्तर्पयन्तु तान् ।\nआज्यं पिबन्ति ये चात्र तानर्चयन्तु विशः सदा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003394008, "chapter_id": 23394, "verse_number": "३४-९", "content_sanskrit": "ब्राह्मणैरभ्यनुज्ञाताः शूद्राः स्वपितृनामतः ।\nतानेवार्चयतां सम्यग्विधिमन्त्रबहिष्कृताः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003394009, "chapter_id": 23394, "verse_number": "३४-१०", "content_sanskrit": "अनाहिताग्नयो ये च ब्रह्मक्षत्रविशो नराः ।\nस्वकालिनस्तेऽर्चयन्तु लोकाग्निपुरतः सदा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003394010, "chapter_id": 23394, "verse_number": "३४-११", "content_sanskrit": "इत्येवं पूजिता यूयमिष्टान् कामान् प्रयच्छत ।\nआयुः कीर्तिं धनं पुत्रान् विद्यामभिजनं स्मृतिम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003394011, "chapter_id": 23394, "verse_number": "३४-१२", "content_sanskrit": "इत्युक्त्वा तु तदा ब्रह्मा तेषां पन्थानमाकरोत् ।\nदक्षिणायनसंज्ञं तु पितॄणां च पितामहः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003394012, "chapter_id": 23394, "verse_number": "३४-१३", "content_sanskrit": "तूष्णीं ससर्ज भूतानि तमूचुः पितरस्ततः ।\nवृत्तिं नो देहि भगवन् यया विन्दामहे सुखम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003394013, "chapter_id": 23394, "verse_number": "३४-१४", "content_sanskrit": "ब्रह्मा उवाच ।\nअमावास्यादिनं वोऽस्तु तस्यां कुशतिलोदकैः ।\nतर्पिता मानुषैस्तृप्तिं परां गच्छथ नान्यथा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003394014, "chapter_id": 23394, "verse_number": "३४-१५", "content_sanskrit": "तिला देयास्तथैतस्यामुपोष्य पितृभक्तितः ।\nपरमं तस्य संतुष्टा वरं यच्छत मा चिरम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]