[{"id": 2087678, "chapter_id": 2860, "verse_number": "१२-३६५-०x", "content_sanskrit": "अतिथिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2087679, "chapter_id": 2860, "verse_number": "१२-३६५-१", "content_sanskrit": "उपदेशं तु ते विप्र करिष्येऽहं यथाक्रमम्।\nगुरुणा मे यथाख्यातमर्थतत्त्वं तु मे शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2087680, "chapter_id": 2860, "verse_number": "१२-३६५-२", "content_sanskrit": "यत्र पूर्वाभिसर्गे वै धर्मचक्रं प्रवर्तितम्।\nनैमिषे गोमतीतीरे तत्र नागह्रदो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2087681, "chapter_id": 2860, "verse_number": "१२-३६५-३", "content_sanskrit": "समग्रैस्रिदशैस्तत्र इष्टमासीद्द्विजर्षभ।\nयत्रेन्द्रातिक्रमं चक्रे माधाता राजसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2087682, "chapter_id": 2860, "verse_number": "१२-३६५-४", "content_sanskrit": "कृताधिवासो धर्मात्मा तत्र चक्षुःश्रवा महान्।\nपद्मनाभो महानागः पद्म इत्येव विश्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2087683, "chapter_id": 2860, "verse_number": "१२-३६५-५", "content_sanskrit": "स वाचा कर्मणा चैव मनसा च द्विजर्षभः।\nप्रसादयति भूतानि त्रिविधे वर्त्मनि स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2087684, "chapter_id": 2860, "verse_number": "१२-३६५-६", "content_sanskrit": "साम्ना भेदेन दानेन दणडेनेति चतुर्विधम्।\nपिपमस्थं समस्थं च चक्षुर्ध्यानेन रक्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2087685, "chapter_id": 2860, "verse_number": "१२-३६५-७", "content_sanskrit": "तमतिक्रम्य विधिना प्रष्टुमर्हसि काङ्क्षित्तम्।\nस ते परमकं धर्मं न मिथ्या दर्शयिष्यरति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2087686, "chapter_id": 2860, "verse_number": "१२-३६५-८", "content_sanskrit": "स हि सर्वातिथिर्नाणो बुद्धिशास्त्रविशारदः।\nगुणैरनुपमैर्युक्तः समस्तैराभिकामिकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2087687, "chapter_id": 2860, "verse_number": "१२-३६५-९", "content_sanskrit": "प्रकृत्या नित्यसलिलो नित्यमध्ययने रतः।\nतपोदमाभ्यां संयुक्तो वृत्तेनानवरेण च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2087688, "chapter_id": 2860, "verse_number": "१२-३६५-१०", "content_sanskrit": "यज्वा दानपतिः क्षान्तो वृत्ते च परमे स्थितः।\nसत्यवागनसूयुश्च शीलवान्नियतेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2087689, "chapter_id": 2860, "verse_number": "१२-३६५-११", "content_sanskrit": "शेषान्नभोक्ता वचनानुकूलो\nहितार्जवोत्कृष्टकृताकृतज्ञः।\nअवैरकृद्भूतहिते नियुक्तो\nगङ्गाह्रदाम्भोभिजनोपपन्नः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2087690, "chapter_id": 2860, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि पञ्चषष्ट्यधिकत्रिशततमोऽध्यायः॥ ३६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]