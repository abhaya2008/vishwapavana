[{"id": 2194770, "chapter_id": 5136, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2194771, "chapter_id": 5136, "verse_number": "१", "content_sanskrit": "धर्माः पितामहेनोक्ता मोक्षधर्माश्रिताः शुभाः ।\nधर्ममाश्रमिणां श्रेष्ठं वक्तुमर्हति मे भवान्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2194772, "chapter_id": 5136, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2194773, "chapter_id": 5136, "verse_number": "२", "content_sanskrit": "सर्वत्र विहितो धर्मः स्वर्ग्यः सत्यफलोदयः ।\nबहुद्वारस्य धर्मस्य नेहास्ति विफला क्रिया\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2194774, "chapter_id": 5136, "verse_number": "३", "content_sanskrit": "यस्मिन्यस्मिंस्तु विषये यो यो याति विनिश्चयम् ।\nस तमेवाभिजानाति नान्यं भरतसत्तम\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2194775, "chapter_id": 5136, "verse_number": "४", "content_sanskrit": "अपि च त्वं नरव्याघ्र श्रोतुमर्हसि मे कथाम् ।\nपुरा शक्रस्य कथितां नारदेन सुरर्षिणा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2194776, "chapter_id": 5136, "verse_number": "५", "content_sanskrit": "सुरर्षिर्नारदो राजन् सिद्धस्त्रैलोक्यसम्मतः ।\nपर्येति क्रमशो लोकान् वायुरव्याहतो यथा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2194777, "chapter_id": 5136, "verse_number": "६", "content_sanskrit": "स कदाचिन्महेष्वास देवराजालयं गतः ।\nसत्कृतश्च महेन्द्रेण प्रत्यासन्नगतोऽभवत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2194778, "chapter_id": 5136, "verse_number": "७", "content_sanskrit": "तं कृतक्षणमासीनं पर्यपृच्छच्छचीपतिः ।\nब्रह्मर्षे किञ्चिदाश्चर्यमस्ति दृष्टं त्वयानघ\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2194779, "chapter_id": 5136, "verse_number": "८", "content_sanskrit": "यथा त्वमपि विप्रर्षे त्रैलोक्यं सचराचरम् ।\nजातकौतूहलो नित्यं सिद्धश्चरसि साक्षिवत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2194780, "chapter_id": 5136, "verse_number": "९", "content_sanskrit": "न ह्यस्त्यविदितं लोके देवर्षे तव किञ्चन ।\nश्रुतं वाप्यनुभूतं वा दृष्टं वा कथयस्व मे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2194781, "chapter_id": 5136, "verse_number": "१०", "content_sanskrit": "तस्मै राजन् सुरेन्द्राय नारदो वदतां वरः ।\nआसीनायोपपन्नाय प्रोक्तवान् विपुलां कथाम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2194782, "chapter_id": 5136, "verse_number": "११", "content_sanskrit": "यथा येन च कल्पेन स तस्मै द्विजसत्तमः ।\nकथां कथितवान् पृष्टस्तथा त्वमपि मे शृणु\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2194783, "chapter_id": 5136, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे पञ्चाशीत्युत्तरशततमोऽध्यायः ॥१८५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]