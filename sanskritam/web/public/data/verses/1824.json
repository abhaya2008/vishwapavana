[{"id": 2037947, "chapter_id": 1824, "verse_number": "५-६९-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2037948, "chapter_id": 1824, "verse_number": "५-६९-१", "content_sanskrit": "भूयो मे पुण्डरीकाक्षं सञ्जयाचक्ष्व पृच्छतः।\nनामकर्मार्थवित्तात प्राप्नुयां पुरुषोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2037949, "chapter_id": 1824, "verse_number": "५-६९-२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2037950, "chapter_id": 1824, "verse_number": "५-६९-२", "content_sanskrit": "श्रुतं मे वासुदेवस्य नामनिर्वचनं शुभम्।\nयावत्तत्राभिजानेऽहमप्रमेयो हि केशवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2037951, "chapter_id": 1824, "verse_number": "५-६९-३", "content_sanskrit": "वसनात्सर्वभूतानां वसुत्वाद्देवयोनितः।\nवासुदेवस्ततो वेद्यो बृहत्त्वाद्विष्णुरुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2037952, "chapter_id": 1824, "verse_number": "५-६९-४", "content_sanskrit": "मौनाद्ध्यानाच्च योगाच्च विद्दि भारत माधवम्।\nसर्वतत्त्वलयाच्चैव मधुहा मधुसूदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2037953, "chapter_id": 1824, "verse_number": "५-६९-५", "content_sanskrit": "कृषिर्भूवाचकः शब्दो गश्च निर्वृतिवाचकः।\nविष्णुस्तद्भावयोगाच्च कृष्णो भवति सात्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2037954, "chapter_id": 1824, "verse_number": "५-६९-६", "content_sanskrit": "पुण्डरीकं परं धाम नित्यमक्षयमव्ययम् ।\nतद्भावात्पुण्डरीकाक्षो दस्युत्रासाज्जानार्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2037955, "chapter_id": 1824, "verse_number": "५-६९-७", "content_sanskrit": "यतः सत्वं न च्यवते यच्च यत्वान्न हीयते।\nसात्वतः सात्वतस्तस्मादार्षभाद्वृषभेक्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2037956, "chapter_id": 1824, "verse_number": "५-६९-८", "content_sanskrit": "न जायते जनित्राऽयमजस्तस्मादनीकजित् ।\nदेवानां स्वप्रकाशत्वाद्दमाद्दामोदरो विभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2037957, "chapter_id": 1824, "verse_number": "५-६९-९", "content_sanskrit": "हर्षात्सुखात्सुखैश्वर्याद्धृषीकेशत्वमश्रुते ।\nबाहुभ्यां रोदसी बिभ्रन्महाबाहुरिति स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2037958, "chapter_id": 1824, "verse_number": "५-६९-१०", "content_sanskrit": "अघो न क्षीयते जातु यस्मात्तस्मादधोक्षजः।\nनराणामयनाच्चापि ततो नारायणः स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2037959, "chapter_id": 1824, "verse_number": "५-६९-११", "content_sanskrit": "पूरणात्सदनाच्चापि ततोऽसौपुरुषोत्तमः।\nअसतश्च सतश्चैव सर्वस्य प्रभवाप्ययात्।\nसर्वस्य च सदा ज्ञानात्सर्वमेतं प्रचक्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2037960, "chapter_id": 1824, "verse_number": "५-६९-१२", "content_sanskrit": "सत्ये प्रतिष्ठितः कृष्णः सत्यमत्र प्रतिष्ठितम्।\nसत्यात्सत्यं तु गोविन्दस्तस्मात्सत्योपि नामतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2037961, "chapter_id": 1824, "verse_number": "५-६९-१३", "content_sanskrit": "विष्णुर्विक्रमणाद्देवो जयनाञ्जिष्णुरुच्यते।\nशाश्वतत्वादनन्तश्च गोविन्दो वेदनाद्भवाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2037962, "chapter_id": 1824, "verse_number": "५-६९-१४", "content_sanskrit": "अतत्त्वं कुरुते तत्त्वं तेन मोहयते प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2037963, "chapter_id": 1824, "verse_number": "५-६९-१५", "content_sanskrit": "एवंविधो धर्मनित्यो भगवान्मधुसूदनः ।\nआगन्ता हि महाबाहुरानृशंस्यार्थमच्युतः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2037964, "chapter_id": 1824, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि तयानसन्धिपर्वणि ऊनसस्ततितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]