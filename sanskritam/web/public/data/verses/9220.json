[{"id": 40015278, "chapter_id": 9220, "verse_number": "1", "content_sanskrit": "सासीतातच्छिरोदृष्टवातच्चकार्मुकमुत्तमम् । सुग्रीवप्रतिसंपर्गमाख्यातंचहनूमता ॥ नयनेमुखवर्णंचभर्तुस्तत्सदृशंमुखम् । केशान् केशान्तदेशंचतंचचूडामणिंशुभम् ॥ एतैस्सर्वेरभिज्ञानैरभिज्ञायसुदुःखिता । निजगर्हेचकैकेयींक्रोशन्तीकुररीयथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40015279, "chapter_id": 9220, "verse_number": "2", "content_sanskrit": "सासीतातच्छिरोदृष्टवातच्चकार्मुकमुत्तमम् । सुग्रीवप्रतिसंपर्गमाख्यातंचहनूमता ॥ नयनेमुखवर्णंचभर्तुस्तत्सदृशंमुखम् । केशान् केशान्तदेशंचतंचचूडामणिंशुभम् ॥ एतैस्सर्वेरभिज्ञानैरभिज्ञायसुदुःखिता । निजगर्हेचकैकेयींक्रोशन्तीकुररीयथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40015280, "chapter_id": 9220, "verse_number": "3", "content_sanskrit": "सासीतातच्छिरोदृष्टवातच्चकार्मुकमुत्तमम् । सुग्रीवप्रतिसंपर्गमाख्यातंचहनूमता ॥ नयनेमुखवर्णंचभर्तुस्तत्सदृशंमुखम् । केशान् केशान्तदेशंचतंचचूडामणिंशुभम् ॥ एतैस्सर्वेरभिज्ञानैरभिज्ञायसुदुःखिता । निजगर्हेचकैकेयींक्रोशन्तीकुररीयथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40015281, "chapter_id": 9220, "verse_number": "4", "content_sanskrit": "सकामाभवकैकेयीहतोऽयंकुलनन्दनः । कुलमुत्सादितंसर्वंत्वयाकलहशीलया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40015282, "chapter_id": 9220, "verse_number": "5", "content_sanskrit": "आर्येणकिंतेकैकेयी कृतंरामेणविप्रियम् । यन्मयाचीरवसनस्त्वयाप्रस्थापितोवनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40015283, "chapter_id": 9220, "verse_number": "6", "content_sanskrit": "एवमुक्त्वातुवैदेहीवेपमानातपस्विनी । जगामजगतींबालाछिन्नातुकदळीयथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40015284, "chapter_id": 9220, "verse_number": "7", "content_sanskrit": "सामुहूर्तात्समाश्वास्यप्रतिलभ्यचचेतनाम् । तच्छिरस्समुपाघ्रायविललासायतेक्षणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40015285, "chapter_id": 9220, "verse_number": "8", "content_sanskrit": "हाहताऽस्मिमहाबाहो वीरव्रतमनुव्रत । इमांतेपश्चिमावस्थांगताऽस्मिविधवाकृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40015286, "chapter_id": 9220, "verse_number": "9", "content_sanskrit": "प्रथमंमरणंनार्याभर्तुर्वैगुण्यमुच्यते । सुवृत्त: स्साधुवृत्तायास्सम्वृत्तस्त्वंममाग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40015287, "chapter_id": 9220, "verse_number": "10", "content_sanskrit": "दुःखाद्दुःखंप्रपन्नायामग्नायाश्शोकसागरे । योहिमामुद्यतनिस्त्रातुंसोऽपित्वंविनिपातितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40015288, "chapter_id": 9220, "verse_number": "11", "content_sanskrit": "साश्वश्रूर्ममकौसल्यात्वयापुत्रेणराघव: । वत्सेनेवयथाधेनुर्विवत्सावत्सलाकृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40015289, "chapter_id": 9220, "verse_number": "12", "content_sanskrit": "आद्दिष्टंदीर्घमायुस्तेयैरचिन्त्यपराक्रम । अनृतंवचनंतेषामल्पायुरपिराघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40015290, "chapter_id": 9220, "verse_number": "13", "content_sanskrit": "अथवानश्यतिप्रज्ञाप्राज्ञस्यापिसतस्तव । पचत्येनंयथाकालोभूतानांप्रभवोऽह्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40015291, "chapter_id": 9220, "verse_number": "14", "content_sanskrit": "अदृष्टंमृत्युमापन्नःकस्मात्त्वंनयशास्त्रवित् । व्यसनानामुपायज्ञःकुशलोह्यसिवर्जने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40015292, "chapter_id": 9220, "verse_number": "15", "content_sanskrit": "तथात्वंसम्परिष्वज्यरौद्रयाऽतिनृशंसया । काळरात्य्राममाच्छिद्यहृतःकमललोचन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40015293, "chapter_id": 9220, "verse_number": "16", "content_sanskrit": "उपशेषेमहाबाहो: मांविहायतपस्विनीम् । प्रियामिवसमालशिष्यपृथिवींपुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40015294, "chapter_id": 9220, "verse_number": "17", "content_sanskrit": "अर्चितंसततंयत्तद्गन्धमाल्यैर्मयातव । इदंतेमप्रतियंवीरधनुःकाञ्चानभूषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40015295, "chapter_id": 9220, "verse_number": "18", "content_sanskrit": "पित्रादशरथेनत्वंश्वशुरेणममानघ: । सर्वैश्चपितृभिस्सार्थंनूनंस्वर्गेसमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40015296, "chapter_id": 9220, "verse_number": "19", "content_sanskrit": "दिविनक्षत्रभूतस्त्वंमहात्कर्मकृतप्रियम् । पुण्यंराजर्षिवंशंत्वमात्मनस्समुपेक्षसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40015297, "chapter_id": 9220, "verse_number": "20", "content_sanskrit": "किंमांनप्रेक्षसेराजन् किंमांनप्रतिभाषसे । बालांबाल्येनसम्प्राप्तांभार्यांमांसहचारिणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40015298, "chapter_id": 9220, "verse_number": "21", "content_sanskrit": "संश्रुतंगृह्णतापाणिंचरिष्यामीतियत्त्वया । स्मरतन्ममकाकुत्स्थनयमामपिदुःखिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40015299, "chapter_id": 9220, "verse_number": "22", "content_sanskrit": "कस्मान्मामपहायत्वंगतोगतिमतांवर । अस्माल्लोकादमुंलोकंत्यक्त्वामामपिदुःखिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40015300, "chapter_id": 9220, "verse_number": "23", "content_sanskrit": "कल्याणैरुचितंयत्तत्परिष्वक्तंमयैवतु । क्रव्यादैस्तच्छरीरंतेमानंविपरिकृष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40015301, "chapter_id": 9220, "verse_number": "24", "content_sanskrit": "अग्निष्टोमादिभिर्यज्ञैरिष्टवानाप्तदक्षिणैः । अग्निहोत्रेणसंस्कारंकेनत्वंनतुलप्स्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40015302, "chapter_id": 9220, "verse_number": "25", "content_sanskrit": "प्रव्रज्यामुपपन्नानांत्रयाणामेकमागतम् । परिप्रक्ष्यतिकौसल्यालक्ष्मणंशोकलालसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40015303, "chapter_id": 9220, "verse_number": "26", "content_sanskrit": "सतस्याःपरिपृच्छन्त्यावधंमित्रबलस्यते । तवचाख्यास्यतेनूनंनिशायांराक्षसैर्वधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40015304, "chapter_id": 9220, "verse_number": "27", "content_sanskrit": "सात्वांसुप्तंहतंश्रुत्वामांचरक्षोगृहंगताम् । हृदयेनविदीर्णेननभविष्यतिराघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40015305, "chapter_id": 9220, "verse_number": "28", "content_sanskrit": "ममहेतोरनार्यायाह्यनर्हःपार्थिवात्म: । रामस्सागरमुततीर्यसत्त्ववान् गोष्पदेहतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40015306, "chapter_id": 9220, "verse_number": "29", "content_sanskrit": "अहंदाशरथेनोढामोहात्स्वकुलपांसनी । आर्यपुत्रस्यरामस्यभार्यामृत्युरजायत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40015307, "chapter_id": 9220, "verse_number": "30", "content_sanskrit": "नूनमन्यांमयाजातिंवारितंदानमुत्तमम् । याहमद्येहशोचामिभार्यासर्वतिथेरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40015308, "chapter_id": 9220, "verse_number": "31", "content_sanskrit": "साधुपातयमांक्षिप्रंरामस्योपरिरावण । समानयपतिंपन्त्याकुरुकल्याणमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40015309, "chapter_id": 9220, "verse_number": "32", "content_sanskrit": "शिरसामेशिरश्चास्यकायंकायेनयोजय । रावणानुगमिष्यामिगतिंभर्तुर्महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40015310, "chapter_id": 9220, "verse_number": "33", "content_sanskrit": "इतिसदुःखसन्तप्ताविललापायतेक्षणा । भर्तुश्शिरोधनुस्तत्रसमीक्ष्यचपुनःपुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40015311, "chapter_id": 9220, "verse_number": "34", "content_sanskrit": "एवंलालप्यमानायांसीतायांतत्रराक्षसः । अभिचक्रामभर्तारमनीकस्थःकृताञ्जलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40015312, "chapter_id": 9220, "verse_number": "35", "content_sanskrit": "विजयस