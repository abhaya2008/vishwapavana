[{"id": 5000220000, "chapter_id": 9220, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे चतुर्विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000220001, "chapter_id": 9220, "verse_number": "३-२४-१", "content_sanskrit": "आश्रमं प्रतियाते तु खरे खरपराक्रमे।\nतानेवौत्पातिकान् रामः सह भ्रात्रा ददर्श ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000220002, "chapter_id": 9220, "verse_number": "३-२४-२", "content_sanskrit": "तानुत्पातान् महाघोरान् रामो दृष्ट्वात्यमर्षणः।\nप्रजानामहितान् दृष्ट्वा वाक्यं लक्ष्मणमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000220003, "chapter_id": 9220, "verse_number": "३-२४-३", "content_sanskrit": "इमान् पश्य महाबाहो सर्वभूतापहारिणः।\nसमुत्थितान् महोत्पातान् संहर्तुं सर्वराक्षसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000220004, "chapter_id": 9220, "verse_number": "३-२४-४", "content_sanskrit": "अमी रुधिरधारास्तु विसृजन्ते खरस्वनाः।\nव्योम्नि मेघा निवर्तन्ते परुषा गर्दभारुणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000220005, "chapter_id": 9220, "verse_number": "३-२४-५", "content_sanskrit": "सधूमाश्च शराः सर्वे मम युद्धाभिनन्दिताः।\nरुक्मपृष्ठानि चापानि विचेष्टन्ते विचक्षण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000220006, "chapter_id": 9220, "verse_number": "३-२४-६", "content_sanskrit": "यादृशा इह कूजन्ति पक्षिणो वनचारिणः।\nअग्रतो नोऽभयं प्राप्तं संशयो जीवितस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000220007, "chapter_id": 9220, "verse_number": "३-२४-७", "content_sanskrit": "सम्प्रहारस्तु सुमहान् भविष्यति न संशयः।\nअयमाख्याति मे बाहुः स्फुरमाणो मुहुर्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000220008, "chapter_id": 9220, "verse_number": "३-२४-८", "content_sanskrit": "संनिकर्षे तु नः शूर जयं शत्रोः पराजयम्।\nसुप्रभं च प्रसन्नं च तव वक्त्रं हि लक्ष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000220009, "chapter_id": 9220, "verse_number": "३-२४-९", "content_sanskrit": "उद्यतानां हि युद्धार्थं येषां भवति लक्ष्मण।\nनिष्प्रभं वदनं तेषां भवत्यायुः परिक्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000220010, "chapter_id": 9220, "verse_number": "३-२४-१०", "content_sanskrit": "रक्षसां नर्दतां घोरः श्रूयतेऽयं महाध्वनिः।\nआहतानां च भेरीणां राक्षसैः क्रूरकर्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000220011, "chapter_id": 9220, "verse_number": "३-२४-११", "content_sanskrit": "अनागतविधानं तु कर्तव्यं शुभमिच्छता।\nआपदं शङ्कमानेन पुरुषेण विपश्चिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000220012, "chapter_id": 9220, "verse_number": "३-२४-१२", "content_sanskrit": "तस्माद् गृहीत्वा वैदेहीं शरपाणिर्धनुर्धरः।\nगुहामाश्रय शैलस्य दुर्गां पादपसंकुलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000220013, "chapter_id": 9220, "verse_number": "३-२४-१३", "content_sanskrit": "प्रतिकूलितुमिच्छामि न हि वाक्यमिदं त्वया।\nशापितो मम पादाभ्यां गम्यतां वत्स मा चिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000220014, "chapter_id": 9220, "verse_number": "३-२४-१४", "content_sanskrit": "त्वं हि शूरश्च बलवान् हन्या एतान् न संशयः।\nस्वयं निहन्तुमिच्छामि सर्वानेव निशाचरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000220015, "chapter_id": 9220, "verse_number": "३-२४-१५", "content_sanskrit": "एवमुक्तस्तु रामेण लक्ष्मणः सह सीतया।\nशरानादाय चापं च गुहां दुर्गां समाश्रयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000220016, "chapter_id": 9220, "verse_number": "३-२४-१६", "content_sanskrit": "तस्मिन् प्रविष्टे तु गुहां लक्ष्मणे सह सीतया।\nहन्त निर्युक्तमित्युक्त्वा रामः कवचमाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000220017, "chapter_id": 9220, "verse_number": "३-२४-१७", "content_sanskrit": "स तेनाग्निनिकाशेन कवचेन विभूषितः।\nबभूव रामस्तिमिरे महानग्निरिवोत्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000220018, "chapter_id": 9220, "verse_number": "३-२४-१८", "content_sanskrit": "स चापमुद्यम्य महच्छरानादाय वीर्यवान्।\nसम्बभूवास्थितस्तत्र ज्यास्वनैः पूरयन् दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000220019, "chapter_id": 9220, "verse_number": "३-२४-१९", "content_sanskrit": "ततो देवाः सगन्धर्वाः सिद्धाश्च सह चारणैः।\nसमेयुश्च महात्मानो युद्धदर्शनकांक्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000220020, "chapter_id": 9220, "verse_number": "३-२४-२०", "content_sanskrit": "ऋषयश्च महात्मानो लोके ब्रह्मर्षिसत्तमाः।\nसमेत्य चोचुः सहितास्तेऽन्योन्यं पुण्यकर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000220021, "chapter_id": 9220, "verse_number": "३-२४-२१", "content_sanskrit": "स्वस्ति गोब्राह्मणानां च लोकानां चेति संस्थिताः।\nजयतां राघवो युद्धे पौलस्त्यान् रजनीचरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000220022, "chapter_id": 9220, "verse_number": "३-२४-२२", "content_sanskrit": "चक्रहस्तो यथा युद्धे सर्वानसुरपुंगवान्।\nएवमुक्त्वा पुनः प्रोचुरालोक्य च परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000220023, "chapter_id": 9220, "verse_number": "३-२४-२३", "content_sanskrit": "चतुर्दश सहस्राणि रक्षसां भीमकर्मणाम्।\nएकश्च रामो धर्मात्मा कथं युद्धं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000220024, "chapter_id": 9220, "verse_number": "३-२४-२४", "content_sanskrit": "इति राजर्षयः सिद्धाः सगणाश्च द्विजर्षभाः।\nजातकौतूहलास्तस्थुर्विमानस्थाश्च देवताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000220025, "chapter_id": 9220, "verse_number": "३-२४-२५", "content_sanskrit": "आविष्टं तेजसा रामं संग्रामशिरसि स्थितम्।\nदृष्ट्वा सर्वाणि भूतानि भयाद् विव्यथिरे तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000220026, "chapter_id": 9220, "verse_number": "३-२४-२६", "content_sanskrit": "रूपमप्रतिमं तस्य रामस्याक्लिष्टकर्मणः।\nबभूव रूपं क्रुद्धस्य रुद्रस्येव महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000220027, "chapter_id": 9220, "verse_number": "३-२४-२७", "content_sanskrit": "इति सम्भाष्यमाणे तु देवगन्धर्वचारणैः।\nततो गम्भीरनिर्ह्रादं घोरचर्मायुधध्वजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000220028, "chapter_id": 9220, "verse_number": "३-२४-२८", "content_sanskrit": "अनीकं यातुधानानां समन्तात् प्रत्यपद्यत।\nवीरालापान् विसृजतामन्योन्यमभिगच्छताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000220029, "chapter_id": 9220, "verse_number": "३-२४-२९", "content_sanskrit": "चापानि विस्फारयतां जृम्भतां चाप्यभीक्ष्णशः।\nविप्रघुष्टस्वनानां च दुन्दुभींश्चापि निघ्नताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000220030, "chapter_id": 9220, "verse_number": "३-२४-३०", "content_sanskrit": "तेषां सुतुमुलः शब्दः पूरयामास तद् वनम्।\nतेन शब्देन वित्रस्ताः श्वापदा वनचारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000220031, "chapter_id": 9220, "verse_number": "३-२४-३१", "content_sanskrit": "दुद्रुवुर्यत्र निःशब्दं पृष्ठतो नावलोकयन्।\nतच्चानीकं महावेगं रामं समनुवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000220032, "chapter_id": 9220, "verse_number": "३-२४-३२", "content_sanskrit": "धृतनानाप्रहरणं गम्भीरं सागरोपमम्।\nरामोऽपि चारयंश्चक्षुः सर्वतो रणपण्डितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000220033, "chapter_id": 9220, "verse_number": "३-२४-३३", "content_sanskrit": "ददर्श खरसैन्यं तद् युद्धायाभिमुखो गतः।\nवितत्य च धनुर्भीमं तूण्याश्चोद्‍धृत्य सायकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000220034, "chapter_id": 9220, "verse_number": "३-२४-३४", "content_sanskrit": "क्रोधमाहारयत् तीव्रं वधार्थं सर्वरक्षसाम्।\nदुष्प्रेक्ष्यश्चाभवत् क्रुद्धो युगान्ताग्निरिव ज्वलन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000220035, "chapter_id": 9220, "verse_number": "३-२४-३५", "content_sanskrit": "तं दृष्ट्वा तेजसाऽऽविष्टं प्राव्यथन् वनदेवताः।\nतस्य रुष्टस्य रूपं तु रामस्य ददृशे तदा।\nदक्षस्येव क्रतुं हन्तुमुद्यतस्य पिनाकिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000220036, "chapter_id": 9220, "verse_number": "३-२४-३६", "content_sanskrit": "तत्कार्मुकैराभरणै रथैश्च\nतद्वर्मभिश्चाग्निसमानवर्णैः।\nबभूव सैन्यं पिशिताशनानां\nसूर्योदये नीलमिवाभ्रजालम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000220037, "chapter_id": 9220, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे चतुर्विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]