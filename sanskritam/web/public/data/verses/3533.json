[{"id": 2117682, "chapter_id": 3533, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2117683, "chapter_id": 3533, "verse_number": "१", "content_sanskrit": "उत्सवे वर्तमाने तु त्रैलोक्याकाङ्क्षिणावुभौ ।\nमन्त्रयित्वा ततः सेनां तावाज्ञापयतां तदा \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2117684, "chapter_id": 3533, "verse_number": "२", "content_sanskrit": "सुहृद्भिरभ्यनुज्ञातौ दैत्यवृद्धैश्च मन्त्रिभिः ।\nकृत्वा प्रास्थानिकीं यात्रामसुरौ ययतुस्तदा \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2117685, "chapter_id": 3533, "verse_number": "३", "content_sanskrit": "गदापट्टसधारिण्या शूलमुद्गरहस्तया ।\nप्रस्थितौ सहधर्मिण्या महत्या दैत्यसेनया \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2117686, "chapter_id": 3533, "verse_number": "४", "content_sanskrit": "मङ्गलैः स्तुतिभिश्चापि विजयं प्रतिसंहितौ ।\nचारणैः स्तूयमानौ तौ जग्मतुः परया मुदा \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2117687, "chapter_id": 3533, "verse_number": "५", "content_sanskrit": "तावन्तरिक्षमुत्पत्य दैत्यौ कामगमावुभौ ।\nदेवानामेव भवनं जग्मतुर्युद्धदुर्मदौ \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2117688, "chapter_id": 3533, "verse_number": "६", "content_sanskrit": "तयोरागमनं ज्ञात्वा वरदानं च तत् प्रभोः ।\nहित्वा त्रिविष्टपं जग्मुर्ब्रह्मलोकं ततः सुराः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2117689, "chapter_id": 3533, "verse_number": "७", "content_sanskrit": "ताविन्द्रलोकं निर्जित्य यक्षरक्षोगणांस्तथा ।\nखेचराण्यपि भूतानि जिग्यतुस्तीव्रविक्रमौ \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2117690, "chapter_id": 3533, "verse_number": "८", "content_sanskrit": "अन्तर्भूमिचरान् नागान् जित्वा तौ तु महासुरौ ।\nसमुद्रवासिनीः सर्वा म्लेच्छजातीर्विजिग्यतुः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2117691, "chapter_id": 3533, "verse_number": "९", "content_sanskrit": "ततः सर्वां महीं जेतुमारब्धावुग्रतेजसौ ।\nसैनिकांश्च समाहूय सुतीक्ष्णां वाचमूचतुः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2117692, "chapter_id": 3533, "verse_number": "१०", "content_sanskrit": "राजर्षयो महायज्ञैर्हव्यकव्यैर्द्विजातयः ।\nतेजो बलं च देवानां वर्धयन्ते श्रियं तथा \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2117693, "chapter_id": 3533, "verse_number": "११", "content_sanskrit": "तेषामेवं प्रवृद्धानां सर्वेषामसुरद्विषाम् ।\nसम्भूय सर्वैरस्माभिः कार्यः सर्वात्मना वधः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2117694, "chapter_id": 3533, "verse_number": "१२", "content_sanskrit": "एवं सर्वान् समादिश्य पूर्वतीरे महोदधेः ।\nक्रूरां मतिं समास्थाय जग्मतुः सर्वतोदिशः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2117695, "chapter_id": 3533, "verse_number": "१३", "content_sanskrit": "यज्ञैर्यजन्ते ये केचिद् याजयन्ति च ये द्विजाः ।\nतान् सर्वानसुरौ दृष्ट्वा बलिनौ जघ्नतुस्ततः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2117696, "chapter_id": 3533, "verse_number": "१४", "content_sanskrit": "आश्रमेष्वग्निहोत्राणि ऋषीणां भावितात्मनाम् ।\nगृहीत्वा प्रक्षिपन्त्यप्सु विस्रब्धाः सैनिकास्तदा \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2117697, "chapter_id": 3533, "verse_number": "१५", "content_sanskrit": "तपोधनैश्च ये शप्ताः क्रुद्धैरुक्ता महात्मभिः ।\nनाक्रामन्ति तयोस्तेन वरदानेन च प्रभोः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2117698, "chapter_id": 3533, "verse_number": "१६", "content_sanskrit": "नाक्रामन्ति यदा शापा बाणा मुक्ताः शिलास्विव ।\nनियमांस्तु परित्यज्य विद्रवन्ति द्विजातयः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2117699, "chapter_id": 3533, "verse_number": "१७", "content_sanskrit": "पृथिव्यां ये तपःसिद्धाः शान्ता दमपरायणाः ।\nतयोर्भयाद् दुद्रुविरे वैनतेयादिवोरगाः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2117700, "chapter_id": 3533, "verse_number": "१८", "content_sanskrit": "मथितैराश्रमैर्भग्नैर्विकीर्णैः कलशैः स्रुवैः ।\nशून्यमासीज्जगत्सर्वं कालेनेव हतं यथा \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2117701, "chapter_id": 3533, "verse_number": "१९", "content_sanskrit": "राजर्षिभिरदृश्यद्भिर्ऋषिभिश्च तपोधनैः ।\nउभौ विनिश्चयं कृत्वा विकुर्वाणौ वधैषिणौ \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2117702, "chapter_id": 3533, "verse_number": "२०", "content_sanskrit": "प्रभिन्नकरटौ मत्तौ भूत्वा कुञ्जररूपिणौ ।\nसँल्लीनानपि दुर्गेषु निन्यतुर्यमसादनम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2117703, "chapter_id": 3533, "verse_number": "२१", "content_sanskrit": "सिंहौ भूत्वा पुनर्व्याघ्रौ पुनश्चान्तर्हितावुभौ ।\nतैरुपायैस्तु तान् क्रुद्धान् ऋषीन् दृष्ट्वा निजघ्नतुः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2117704, "chapter_id": 3533, "verse_number": "२२", "content_sanskrit": "निवृत्तनित्यस्वाध्याया प्रनष्टनृपतिद्विजा ।\nउत्सन्नोत्सवयज्ञा च बभूव वसुधा तदा \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2117705, "chapter_id": 3533, "verse_number": "२३", "content_sanskrit": "हाहाभूता भयार्ता च निवृत्तविपणापणा ।\nनिवृत्तदेवकार्या च पुण्योद्वाहविवर्जिता \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2117706, "chapter_id": 3533, "verse_number": "२४", "content_sanskrit": "निवृत्तकृषिगोरक्षा विध्वस्तनगराश्रया ।\nअस्थिकङ्कालसङ्कीर्णा बभूव ह्युग्रदर्शना \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2117707, "chapter_id": 3533, "verse_number": "२५", "content_sanskrit": "निवृत्तपितृकार्यं च निर्वषट्कारमङ्गलम् ।\nजगत् प्रतिभयाकारं दुष्प्रेक्ष्यमभवत् तदा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2117708, "chapter_id": 3533, "verse_number": "२६", "content_sanskrit": "चन्द्रादित्यौ ग्रहास्तारा नक्षत्राणि दिवौकसः ।\nजग्मुर्विषादं तत् कर्म दृष्ट्वा सुन्दोपसुन्दयोः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2117709, "chapter_id": 3533, "verse_number": "२७", "content_sanskrit": "एवं सर्वा दिशो दैत्यौ जित्वा क्रूरेण कर्मणा ।\nनिःसपत्नौ कुरुक्षेत्रे निवेशमभिचक्रतुः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2117710, "chapter_id": 3533, "verse_number": "२१२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nद्वादशाधिकद्विशततमोऽध्यायः ॥२१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2117711, "chapter_id": 3533, "verse_number": "४", "content_sanskrit": "॥ इति राज्यलाभपर्वणि चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2117712, "chapter_id": 3533, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]