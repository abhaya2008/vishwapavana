[{"id": 7001007000, "chapter_id": 21007, "verse_number": "४-१३-१", "content_sanskrit": "श्रीपराशर उवाच ।\nभजनभजमानदिव्यांधकदेवावृधमहाभोजवृष्णिसंज्ञास्सत्वतस्य पुत्रा बभूवुः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001007001, "chapter_id": 21007, "verse_number": "४-१३-२", "content_sanskrit": "भजमानस्य निमिकृकणवृष्णयस्तथान्ये द्वैमात्राः शतजित्सहस्रजिदयुतजित्संज्ञास्त्रयः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001007002, "chapter_id": 21007, "verse_number": "४-१३-३", "content_sanskrit": "देवावृधस्यापि बभ्रुः पुत्रोऽभवत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001007003, "chapter_id": 21007, "verse_number": "४-१३-४", "content_sanskrit": "तयोश्चायं श्लोको गीयते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001007004, "chapter_id": 21007, "verse_number": "४-१३-५", "content_sanskrit": "यथैव शृणुमो दूरात्संपश्यामस्तथांतिकात् ।\nबभ्रुः श्रेष्ठो मनुष्याणां देवैर्देवावृधस्समः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001007005, "chapter_id": 21007, "verse_number": "४-१३-६", "content_sanskrit": "पुरुषाः षट् च षष्टिश्च सहस्राणि तथाऽष्ट ये ।\nतेऽमृतत्वमनुप्राप्ता बभ्रोर्देवावृधादपि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001007006, "chapter_id": 21007, "verse_number": "४-१३-७", "content_sanskrit": "महाभोजस्त्वतिधर्मात्मा तस्यान्वये भोजाः मृत्तिकावरपुरनिवासिनो मार्त्तिकावरा बभूवुः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001007007, "chapter_id": 21007, "verse_number": "४-१३-८", "content_sanskrit": "वृष्णे सुमित्रो युधाजिच्च पुत्रावभूताम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001007008, "chapter_id": 21007, "verse_number": "४-१३-९", "content_sanskrit": "ततश्चानमित्रः तथानमित्रान्निघ्नः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001007009, "chapter_id": 21007, "verse_number": "४-१३-१०", "content_sanskrit": "निघ्नस्य प्रसेन सत्राजितौ ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001007010, "chapter_id": 21007, "verse_number": "४-१३-११", "content_sanskrit": "तस्य च सत्राजितो भगवानादित्यः सखाऽभवत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001007011, "chapter_id": 21007, "verse_number": "४-१३-१२", "content_sanskrit": "एकदा त्वंभोनिधितीरसंश्रयः सूर्यं सत्राजित्तुष्टाव तन्मनस्कतया च भास्वानभिष्टूयमानोऽग्रतस्तस्थौ ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001007012, "chapter_id": 21007, "verse_number": "४-१३-१३", "content_sanskrit": "ततस्त्वस्पष्टमूर्त्तिधरं चैनमालोक्य सत्राजित्सूर्यमाह ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001007013, "chapter_id": 21007, "verse_number": "४-१३-१४", "content_sanskrit": "यथैव व्योम्नि वह्निपिंडोपमं त्वामहमपश्यं तथैवाद्याग्रतो गतमप्यत्र भगवता किंचिन्न प्रसादीकृतं विश्षोमुपलक्षयामीत्येवमुक्ते भगवता सूर्येण निजकंठादुन्मुच्य स्यमंतकं नाम महामणिवरमवतार्यैकान्ते न्यस्तम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001007014, "chapter_id": 21007, "verse_number": "४-१३-१५", "content_sanskrit": "ततस्तमाताम्रोज्ज्वलं ह्रस्ववपुषमीषदापिंगलनयनमादित्यमद्रा क्षीत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001007015, "chapter_id": 21007, "verse_number": "४-१३-१६", "content_sanskrit": "कृतप्रणिपातस्तवादिकं च सत्राजितमाह भगवानादित्यस्सहस्रदीधितिः वरमस्मत्तोभिमतं वृणीष्वेति ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001007016, "chapter_id": 21007, "verse_number": "४-१३-१७", "content_sanskrit": "स च तदेव मणिरत्नमयाचत ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001007017, "chapter_id": 21007, "verse_number": "४-१३-१८", "content_sanskrit": "स चापि तस्मै तद्दत्त्वा दीधितिपतिर्वियति स्वधिष्ण्यमारुरोह ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001007018, "chapter_id": 21007, "verse_number": "४-१३-१९", "content_sanskrit": "सत्राजितोऽप्यमलमणिरत्नसनाथकंठतया सूर्य इव तेजोभिरश्षोदिगंतराण्युद्भासयन् द्वारकां विवेश ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001007019, "chapter_id": 21007, "verse_number": "४-१३-२०", "content_sanskrit": "द्वारकावासी जनस्तु तमायांतमवेक्ष्य भगवंतमादिपुरुषं पुरुषोत्तममवनिभारावतरणायांश्नो मानुषरूपधारिणं प्रणिपत्याह ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001007020, "chapter_id": 21007, "verse_number": "४-१३-२१", "content_sanskrit": "भगवन् भवंतं द्र ष्ट्रं नूनमयमादित्य आयातीत्युक्तो भगवानुवाच ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001007021, "chapter_id": 21007, "verse_number": "४-१३-२२", "content_sanskrit": "भगवान्नायमादित्यः सत्राजितोऽयमादित्यदत्तस्यमंतकाख्यं महामणिरत्नं बिभ्रदत्रोपयाति ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001007022, "chapter_id": 21007, "verse_number": "४-१३-२३", "content_sanskrit": "तदेनं विस्त्रब्धाः पश्यतेत्युक्तास्ते तथैव ददृशुः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001007023, "chapter_id": 21007, "verse_number": "४-१३-२४", "content_sanskrit": "स च तं स्यमंतकमणिमात्मनिवेशने चक्रे ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001007024, "chapter_id": 21007, "verse_number": "४-१३-२५", "content_sanskrit": "प्रतिदिनं तन्मणिरत्नमष्टौ कनकभारान्स्त्रवति ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001007025, "chapter_id": 21007, "verse_number": "४-१३-२६", "content_sanskrit": "तत्प्रभावाच्च सकलस्यैव राष्ट्रस्योपसर्गानावृष्टिव्यालाग्नितो यद्दुर्भिक्षादिभयं न भवति ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001007026, "chapter_id": 21007, "verse_number": "४-१३-२७", "content_sanskrit": "अच्युतोऽपि तद्दिव्यं रत्नमुग्रसेनस्य भूपतेर्योग्यमेतदिति लिप्सां चक्रे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001007027, "chapter_id": 21007, "verse_number": "४-१३-२८", "content_sanskrit": "गोत्रभेदभयाच्छक्तोपि न जहार ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001007028, "chapter_id": 21007, "verse_number": "४-१३-२९", "content_sanskrit": "सत्राजिदप्यच्युतो मामेतद्याचयिष्यतीत्यवगम्य रत्नलोभाद्भ्रात्रे प्रसेनाय तद्र त्नमदात् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001007029, "chapter_id": 21007, "verse_number": "४-१३-३०", "content_sanskrit": "तच्च शुचिना ध्रियमाणमश्षोमेव सुवर्णस्रवादिकं गुणजातमुत्पादयति अन्यथा धारयंतमेव हंतीत्यजानन्नसावपि प्रसेनस्तेन कंठसक्तेन स्यमंतकेनाश्वमारुह्याटव्यां मृगयामगच्छत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001007030, "chapter_id": 21007, "verse_number": "४-१३-३१", "content_sanskrit": "तत्र च सिंहाद्वधमवाप ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001007031, "chapter_id": 21007, "verse_number": "४-१३-३२", "content_sanskrit": "साश्वं च तं निहत्य सिंहोप्यमलमणिरत्नमास्याग्रेणादाय गंतुमभ्युद्यतः ऋक्षाधिपतिना जांबवता दृष्टो घातितश्च ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001007032, "chapter_id": 21007, "verse_number": "४-१३-३३", "content_sanskrit": "जांबवानप्यमलमणिरत्नमादाय स्वबिलं प्रविवेश ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001007033, "chapter_id": 21007, "verse_number": "४-१३-३४", "content_sanskrit": "सुकुमारसंज्ञाय बालकाय च क्रीडनकमकरोत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001007034, "chapter_id": 21007, "verse_number": "४-१३-३५", "content_sanskrit": "अनागच्छति तस्मिन्प्रसेने कृष्णो मणिरत्नमभिलषितवान्स च प्राप्तनान्नूनमेतदस्य कर्मेत्यखिल एव यदुलोकः परस्परं कर्णाकर्ण्याऽकथयत् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001007035, "chapter_id": 21007, "verse_number": "४-१३-३६", "content_sanskrit": "विदितलोकापवादवृत्तांतश्च भगवान् सर्वयदुसैन्यपरिवारपरिवृतः प्रसेनाश्वपदवीमनुससार ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001007036, "chapter_id": 21007, "verse_number": "४-१३-३७", "content_sanskrit": "ददर्श चाश्वसमवेतं प्रसेनं सिंहेन विनिहतम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001007037, "chapter_id": 21007, "verse_number": "४-१३-३८", "content_sanskrit": "अखिलजनमध्ये सिंहपददर्शनकृतपरिशुद्धः सिंहपदमनुससार ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001007038, "chapter_id": 21007, "verse_number": "४-१३-३९", "content_sanskrit": "ऋक्षपतिनिहतं च सिंहमप्यल्पे भूमिभागे दृष्ट्वा ततश्च तद्र त्नगौरवादृक्षस्यापि पदान्यनुययौ ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001007039, "chapter_id": 21007, "verse_number": "४-१३-४०", "content_sanskrit": "गिरितटे च सकलमेव तद्यदुसैन्यमवस्थाप्य तत्पदानुसारी ऋक्षबिलं प्रविवेश ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001007040, "chapter_id": 21007, "verse_number": "४-१३-४१", "content_sanskrit": "अन्तः प्रविष्टश्च धात्र्! याः सुकुमारकमुल्लालयन्त्या वाणीं शुश्राव ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001007041, "chapter_id": 21007, "verse_number": "४-१३-४२", "content_sanskrit": "अत्र श्लोकः।\nसिंहः प्रसेनमवधीत्सिंहो जाम्बवता हतः ।\nसुकुमारकमा रोदीस्तव ह्येष स्यमंतकः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001007042, "chapter_id": 21007, "verse_number": "४-१३-४३", "content_sanskrit": "इत्याकर्ण्योपलब्धस्यमंतकॐतःप्रविष्टः कुमारक्रीडनकीकृतं च धात्र्! या हस्ते तेजोभिर्जाज्वल्यमानं स्यमंतकं ददर्श ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001007043, "chapter_id": 21007, "verse_number": "४-१३-४४", "content_sanskrit": "तं च स्यमंतकाभिलषितचक्षुषमपूर्वपुरुषमागतं समवेक्ष्य धात्री त्राहित्राहीति व्याजहार ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001007044, "chapter_id": 21007, "verse_number": "४-१३-४५", "content_sanskrit": "तदार्त्तरवश्रवणानंतरं चामर्षपूर्णहृदयः स जांबवानाजगाम ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001007045, "chapter_id": 21007, "verse_number": "४-१३-४६", "content_sanskrit": "तयोश्च परस्परमुद्धतामर्षयोर्युद्धमेकविंशतिदिनान्यभवत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001007046, "chapter_id": 21007, "verse_number": "४-१३-४७", "content_sanskrit": "ते च यदुसैनिकास्तत्र सप्ताष्टादिनानि तन्निष्क्रांतिमुदीक्षमाणास्तस्थुः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001007047, "chapter_id": 21007, "verse_number": "४-१३-४८", "content_sanskrit": "अनिष्क्रमणे च मधुरिपुरसाववश्यमत्र बिलेऽत्यंतं नाशमवाप्तो भविष्यत्यन्यथा तस्य जीवतः कथमेतावंति दिनानि शत्रुजये व्याक्षेपो भविष्यतीति कृताध्यवसाया द्वारकामागम्य हतः कृष्ण इति कथयामासुः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001007048, "chapter_id": 21007, "verse_number": "४-१३-४९", "content_sanskrit": "तद्बांधवाश्च तत्कालोचितमखिलमुत्तरक्रियाकलापं चक्रुः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001007049, "chapter_id": 21007, "verse_number": "४-१३-५०", "content_sanskrit": "ततश्चास्य युद्ध्यमानस्यातिश्रद्धादत्तविशिष्टोपपात्रयुक्तान्नतोयादिना श्रीकृष्णस्य बलप्राणपुष्टिरभूत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001007050, "chapter_id": 21007, "verse_number": "४-१३-५१", "content_sanskrit": "इतरस्यानुदिनमतिगुरुपुरुषभेद्यमानस्य अतिनिष्ठुरप्रहारपातपीडिताखिलावयवस्य निराहारतया बलहानिरभूत् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001007051, "chapter_id": 21007, "verse_number": "४-१३-५२", "content_sanskrit": "निर्जितश्च भगवता जांबवान्प्रणिपत्य व्याजहार ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001007052, "chapter_id": 21007, "verse_number": "४-१३-५३", "content_sanskrit": "सुरासुरगंधर्वयक्षराक्षसादिभिरप्यखिलैर्भवान्न जेतुं शक्यः किमुतावनिगोचरैरल्पवीर्यैर्नरैर्नरावयवभूतैश्च तिर्यग्योन्यनुसृतिभिः किं पुनरस्मद्विधैरवश्यं भवताऽस्मत्स्वामिना रामेणेव नारायणस्य सकलजगत्परायणस्यांश्नो भगवता भवितव्यमित्युक्तस्तस्मै भगवानखिलावनिभारावतरणार्थमवतरणमाचचक्षे ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001007053, "chapter_id": 21007, "verse_number": "४-१३-५४", "content_sanskrit": "प्रीत्यभिव्यंजितकरतलस्पर्शनेन चैनमपगतयुद्धखेदं चकार ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001007054, "chapter_id": 21007, "verse_number": "४-१३-५५", "content_sanskrit": "स च प्रणिपत्य पुनरप्येनं प्रसाद्य जांबवतीं नाम कन्यां गृहागतायार्घ्यभूतां ग्राहयामास ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001007055, "chapter_id": 21007, "verse_number": "४-१३-५६", "content_sanskrit": "स्यमंतकमणिरत्नमपि प्रणिपत्य तस्मै प्रददौ ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001007056, "chapter_id": 21007, "verse_number": "४-१३-५७", "content_sanskrit": "अच्युतोप्यतिप्रणतात्तस्मादग्राह्यमपि तन्मणिरत्नमात्मसंशोधनाय जग्राह ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001007057, "chapter_id": 21007, "verse_number": "४-१३-५८", "content_sanskrit": "सह जांबवत्या स द्वारकामाजगाम ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001007058, "chapter_id": 21007, "verse_number": "४-१३-५९", "content_sanskrit": "भगवदागमनोद्भूतहर्षोत्कर्षस्य द्वारकावासिजनस्य कृष्णावलोकनात्तत्क्षणमेवातिपरिणतवयसोपि नवयौवनमिवाभवत् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001007059, "chapter_id": 21007, "verse_number": "४-१३-६०", "content_sanskrit": "दिष्ट्यादिष्ट्येति सकलयादवाः स्त्रियश्च सभाजयामासुः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001007060, "chapter_id": 21007, "verse_number": "४-१३-६१", "content_sanskrit": "भगवानपि यथानुभूतमश्षॐ यादवसमाजे यथावदाचचक्षे ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001007061, "chapter_id": 21007, "verse_number": "४-१३-६२", "content_sanskrit": "स्यमंतकं च सत्राजिताय दत्त्वा मिथ्याभिशस्तिपरिशुद्धिमवाप ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001007062, "chapter_id": 21007, "verse_number": "४-१३-६३", "content_sanskrit": "जांबवतीं चांतःपुरे निवेशयामास ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001007063, "chapter_id": 21007, "verse_number": "४-१३-६४", "content_sanskrit": "सत्राजितोपि मयास्याभूतमलिनमारोपितमिति जातसंत्रासात्स्वसुतां सत्यभामां भगवते भार्यार्थं ददौ ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001007064, "chapter_id": 21007, "verse_number": "४-१३-६५", "content_sanskrit": "तां चाक्रूरकृतवर्मशतधन्वप्रमुखा यादवाः प्राग्वरयाम्बभूवुः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001007065, "chapter_id": 21007, "verse_number": "४-१३-६६", "content_sanskrit": "ततस्तत्प्रदानादवज्ञातमेवात्मानं मन्यमानाः सत्राजिते वैरानुबंधं चक्रुः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001007066, "chapter_id": 21007, "verse_number": "४-१३-६७", "content_sanskrit": "अक्रूरकृतवर्मप्रमुखाश्च शतधन्वानमूचुः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001007067, "chapter_id": 21007, "verse_number": "४-१३-६८", "content_sanskrit": "अयमतीव दुरात्मा सत्राजितो योऽस्माभिर्भवता च प्रार्थितोऽप्यात्मजामस्मान् भवंतं चाविगणय्य कृष्णाय दत्तवान् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001007068, "chapter_id": 21007, "verse_number": "४-१३-६९", "content_sanskrit": "तदलमनेन जीवता घातयित्वैनं तन्महारत्नं स्यमंतकाख्यं त्वया किं न गृह्यते वयमभ्युपपत्स्यामो यद्यच्युतस्तवोपरि वैरानुबंधं करिष्यतीत्येवमुक्तस्तथेत्यसावप्याह ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001007069, "chapter_id": 21007, "verse_number": "४-१३-७०", "content_sanskrit": "जतुगृहदग्धानां पांडुतनयानां विदितपरमार्थोऽपि भगवान् दुर्योधनप्रयत्नशैथिल्यकरणार्थं पार्थानुकूल्यकरणाय वारणावतं गतः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001007070, "chapter_id": 21007, "verse_number": "४-१३-७१", "content_sanskrit": "गते च तस्मिन् सुप्तमेव सत्राजितं शतधन्वा जघान मणिरत्नं चाददात् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001007071, "chapter_id": 21007, "verse_number": "४-१३-७२", "content_sanskrit": "पितृवधामर्षपूर्णा च सत्यभामा शीघ्रं स्यंदनमारूढा वारणावतं गत्वा भगवतेऽहं प्रतिपादितेत्यक्षांतिमता शतधन्वनाऽस्मत्पिता व्यापादितः तच्च स्यमंतकमणिरत्नमपहृतं यस्यावभासनेनापहृततिमिरं त्रैलोक्यं भविष्यति ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001007072, "chapter_id": 21007, "verse_number": "४-१३-७३", "content_sanskrit": "तदियं त्वदीयापहासना तदालोच्य यदत्र युक्तं तत्क्रियतामिति कृष्णमाह ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001007073, "chapter_id": 21007, "verse_number": "४-१३-७४", "content_sanskrit": "तया चैवमुक्तः परितुष्टांतः करणोऽपि कृष्णः सत्यभामाममर्षताम्रनयनः प्राह ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001007074, "chapter_id": 21007, "verse_number": "४-१३-७५", "content_sanskrit": "सत्ये सत्यं ममैवैषापहासना नाहमेतां तस्य दुरात्मनस्सहिष्ये ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001007075, "chapter_id": 21007, "verse_number": "४-१३-७६", "content_sanskrit": "न ह्यनुल्लंघ्य परपादपं तत्कृतनीडाश्रयिणो विहंगमा वध्यंते तदलममुनास्मत्पुरतः सौकप्रोरितवाक्यपरिकरेणेत्युक्त्वा द्वारकामभ्येत्यैकांते बलदेवं वासुदेवः प्राह ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001007076, "chapter_id": 21007, "verse_number": "४-१३-७७", "content_sanskrit": "मृगयागतं प्रसेनमटव्यां मृगपतिर्जघान ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001007077, "chapter_id": 21007, "verse_number": "४-१३-७८", "content_sanskrit": "सत्राजितोऽप्यधुना शतधन्वना निधनं प्रापितः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001007078, "chapter_id": 21007, "verse_number": "४-१३-७९", "content_sanskrit": "तदुभयविनाशात्तन्मणिरत्नमावाभ्यां सामान्यं भविष्यति ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001007079, "chapter_id": 21007, "verse_number": "४-१३-८०", "content_sanskrit": "तदुत्तिष्ठारुह्यतां रथः शतधन्वनिधनायोद्यमं कुर्वित्यभिहितस्तथेति समन्विच्छितवान् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001007080, "chapter_id": 21007, "verse_number": "४-१३-८१", "content_sanskrit": "कृतोद्यमौ च तावुभावुपलभ्य शतधन्वा कृतवर्माणमुपेत्य पार्ष्णिपूरणकर्मनिमित्तमचोदयत् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001007081, "chapter_id": 21007, "verse_number": "४-१३-८२", "content_sanskrit": "आह चैनं कृतवर्मा ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001007082, "chapter_id": 21007, "verse_number": "४-१३-८३", "content_sanskrit": "नाऽहं बलदेववासुदेवाभ्यां सह विरोधायालमित्युक्तश्चाक्रूरमचोदयत् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001007083, "chapter_id": 21007, "verse_number": "४-१३-८४", "content_sanskrit": "असावप्याह ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001007084, "chapter_id": 21007, "verse_number": "४-१३-८५", "content_sanskrit": "न हि कश्चिद्भगवता पादप्रहारपरिकंपितजगत्त्रयेण सुररिषुवनितावैधव्यकारिणा प्रबलरिपुचक्राप्रतिहतचक्रेण चक्रिणा मदमुदितनयनावलोकनाखिलनिशातनेनातिगुरुवैरिवारणापकर्षणा-विकृतमहिमोरुसीरेम सीरिणा च सह सकलजगद्वंद्यानाममरवराणामपि योद्धुं समर्थः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001007085, "chapter_id": 21007, "verse_number": "४-१३-८६", "content_sanskrit": "किमुताहं तदन्यश्शरणमभिलष्यतामित्युक्तश्शतधनुराह ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001007086, "chapter_id": 21007, "verse_number": "४-१३-८७", "content_sanskrit": "यद्यस्मत्परित्राणासमर्थं भवानात्मानमधिगच्छति तदयमस्मत्तस्तावन्मणिः संगृह्य रक्ष्यतामिति ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001007087, "chapter_id": 21007, "verse_number": "४-१३-८८", "content_sanskrit": "एकमुक्तः सोऽप्याह ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001007088, "chapter_id": 21007, "verse_number": "४-१३-८९", "content_sanskrit": "यद्यंत्ययामप्यवस्थायां न कस्मैचिद्भवान् कथयिष्यति तदहमेतं ग्रहीष्यामीति ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7001007089, "chapter_id": 21007, "verse_number": "४-१३-९०", "content_sanskrit": "तथेत्युक्ते चाक्रूरस्तन्मणिरत्नं जग्राह ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7001007090, "chapter_id": 21007, "verse_number": "४-१३-९१", "content_sanskrit": "शतधनुरप्य तुलवेगां शतयोजनवाहिनीं वडवामारुह्यापक्रांतः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7001007091, "chapter_id": 21007, "verse_number": "४-१३-९२", "content_sanskrit": "शैव्यसुग्रीवमेघपुष्पबलाहकाश्वचतुष्टययुक्तरथस्थितौ बलदेववासुदेवौ तमनुप्रयातौ ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7001007092, "chapter_id": 21007, "verse_number": "४-१३-९३", "content_sanskrit": "सा च वडवा शतयोजनप्रमाणमार्गमतीता पुनरपि वाह्यमाना मिथिलावनोद्देशो! प्राणानुत्ससर्ज ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7001007093, "chapter_id": 21007, "verse_number": "४-१३-९४", "content_sanskrit": "शतधनुरपि तां परित्यज्य पदातिरेवाद्र वत् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7001007094, "chapter_id": 21007, "verse_number": "४-१३-९५", "content_sanskrit": "कृष्णोपि बलभद्र माह ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7001007095, "chapter_id": 21007, "verse_number": "४-१३-९६", "content_sanskrit": "तावदत्र स्यंदने भवता स्थेयमहमेनमधमाचारं पदातिरेव पदातिमनुगम्य यावद्घातयामि अत्र हि भूभागे दृष्टदोषास्सभया अतो नैतेश्वा भवतेमं भूमिभागमुल्लंघनीयाः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7001007096, "chapter_id": 21007, "verse_number": "४-१३-९७", "content_sanskrit": "तथेत्युक्त्वा बलदेवो रथ एव तस्थौ ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7001007097, "chapter_id": 21007, "verse_number": "४-१३-९८", "content_sanskrit": "कृष्णोपि द्विक्रोशमात्रं भूमिभागमनुसृत्य दूरस्थितस्यैव चक्रं क्षिप्त्वा शतधनुषश्शिरश्चिच्छेद ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7001007098, "chapter_id": 21007, "verse_number": "४-१३-९९", "content_sanskrit": "तच्छरीरांबरादिषु च बहुप्रकारमन्विच्छन्नपि स्यमंतकमणिं नावाप पदा तदोपगम्य बलभद्र माह ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7001007099, "chapter_id": 21007, "verse_number": "४-१३-१००", "content_sanskrit": "वृथैवास्माभिः शतधनुर्घातितः न प्राप्तमखिलजगत्सारभूतं तन्महारत्नं स्यमंतकाख्यमित्याकर्ण्योद्भूतकोपो बलदेवो वासुदेवमाह ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7001007100, "chapter_id": 21007, "verse_number": "४-१३-१०१", "content_sanskrit": "धिक्त्वां यस्त्वमेवमर्थलिप्सुरेतच्च ते भ्रातृत्वान्मया क्षांतं तदयं पंथास्स्वेच्छया गम्यतां न मे द्वारकया न त्वया न चाश्षोबंधुभिः कार्य्यमलमलमेभिर्ममाग्रतोऽलीकशपथैरित्याक्षिप्य तत्कथां कथंचित्प्रसाद्यमानोपि न तस्थौ ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7001007101, "chapter_id": 21007, "verse_number": "४-१३-१०२", "content_sanskrit": "स विदेहपुरीं प्रविवेश ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7001007102, "chapter_id": 21007, "verse_number": "४-१३-१०३", "content_sanskrit": "जनकराजश्चार्घ्यपूर्वकमेनं गृहं प्रवेशयामास ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7001007103, "chapter_id": 21007, "verse_number": "४-१३-१०४", "content_sanskrit": "स तत्रैव च तस्थौ ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7001007104, "chapter_id": 21007, "verse_number": "४-१३-१०५", "content_sanskrit": "वासुदेवोऽपि द्वारकामाजगाम ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7001007105, "chapter_id": 21007, "verse_number": "४-१३-१०६", "content_sanskrit": "यावच्च जनकराजगृहे बलभद्रो ऽवतस्थे तावद्धार्त्तराष्ट्रो दुर्योधनस्तत्सकाशाद्गदाशिक्षामशिक्षयत् ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7001007106, "chapter_id": 21007, "verse_number": "४-१३-१०७", "content_sanskrit": "वर्षत्रयांते च बभ्रूग्रसेनप्रभृतिभिर्यादवैर्न तद्र त्नं कृष्णेनाऽपहृतमिति कृतावगतिभिर्विदेहनगरीं गत्वा बलदेवस्संप्रत्याय्य द्वारकामानीतः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7001007107, "chapter_id": 21007, "verse_number": "४-१३-१०८", "content_sanskrit": "अक्रूरोप्युत्तममणिसमुद्भूतसुवर्णेन भगवद्ध्यानपरोऽनवरतं यज्ञानियाज ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7001007108, "chapter_id": 21007, "verse_number": "४-१३-१०९", "content_sanskrit": "सवनगतौ हि क्षत्रियवैश्यौ निघ्नन्ब्रह्महा भवतीत्येवंप्रकारं दीक्षाकवचं प्रविष्ट एव तस्थौ ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7001007109, "chapter_id": 21007, "verse_number": "४-१३-११०", "content_sanskrit": "द्विषष्टिवर्षाण्येवं तन्मणिप्रभावात्तत्रोपसर्गदुर्भिक्षमारिकामरणादिकं नाभूत् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7001007110, "chapter_id": 21007, "verse_number": "४-१३-१११", "content_sanskrit": "अथाक्रूरपक्षीयैर्भोजैश्शत्रुघ्ने सात्वतस्य प्रपौत्रे व्यापादिते भोजैस्सहाक्रूरो द्वारकामपहायापक्रान्तः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7001007111, "chapter_id": 21007, "verse_number": "४-१३-११२", "content_sanskrit": "तदपक्रांतिदिनादारभ्य तत्रोपसर्गदुर्भिक्षव्यालानावृष्टिमारिकाद्युपद्र वा बभूवुः ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7001007112, "chapter_id": 21007, "verse_number": "४-१३-११३", "content_sanskrit": "अथ यादवा बलभद्रो ग्रसेनसमवेता मंत्रममंत्रयन् ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7001007113, "chapter_id": 21007, "verse_number": "४-१३-११४", "content_sanskrit": "भगवानुरगारिकेतनः किमिदमेकदैव प्रचुरोपद्र वागमनमेतदालोच्यतामित्युक्तेंधकनामा यदुवृद्धः प्राह ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7001007114, "chapter_id": 21007, "verse_number": "४-१३-११५", "content_sanskrit": "अस्याक्रूरस्य पितृश्वफल्को यत्र यत्राभूत्तत्रतत्र दुर्भिक्षमारिकानावृष्ट्यादिकं नाभूत् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7001007115, "chapter_id": 21007, "verse_number": "४-१३-११६", "content_sanskrit": "काशीराजस्य विषये त्वनावृष्ट्या च श्वफल्को नीतः ततश्च तत्क्षणाद्देवो ववर्ष ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7001007116, "chapter_id": 21007, "verse_number": "४-१३-११७", "content_sanskrit": "काशीराजपत्न्याश्च गर्भे कन्यारत्नं पूर्वमासीत् ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7001007117, "chapter_id": 21007, "verse_number": "४-१३-११८", "content_sanskrit": "सा च कन्या पूर्णेपि प्रसूतिकाले नैव निश्चक्राम ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7001007118, "chapter_id": 21007, "verse_number": "४-१३-११९", "content_sanskrit": "एवं च तस्य गर्भस्य द्वादशवर्षाण्यनिष्क्रामतो ययुः ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7001007119, "chapter_id": 21007, "verse_number": "४-१३-१२०", "content_sanskrit": "काशीराजश्च तामात्मजां गर्भस्थामाह ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7001007120, "chapter_id": 21007, "verse_number": "४-१३-१२१", "content_sanskrit": "पुत्रि कस्मान्न जायसे निष्क्रम्य तामास्यं ते द्र ष्टुमिच्छामि एतां च मातरं किमिति चिरं क्लेशयिष्यसीत्युक्ता गर्भस्थैव व्याजहार ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7001007121, "chapter_id": 21007, "verse_number": "४-१३-१२२", "content_sanskrit": "तात यद्येकैकां गां दिनेदिने ब्राह्मणाय प्रयच्छसि तदहमन्यैस्त्रिभिर्वर्षैरस्माद्गर्भात्ततोऽवश्यं निष्क्रमिष्यामीत्येद्वचनमाकर्ण्य राजा दिनेदिने ब्राह्मणाय गां प्रादात् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7001007122, "chapter_id": 21007, "verse_number": "४-१३-१२३", "content_sanskrit": "सापि तावता कालेन जाता ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7001007123, "chapter_id": 21007, "verse_number": "४-१३-१२४", "content_sanskrit": "ततस्तस्याः पिता गांदिनीति नाम चकार ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7001007124, "chapter_id": 21007, "verse_number": "४-१३-१२५", "content_sanskrit": "तां च गांदिनीं कन्यां श्वफल्कायोपकारिणे गृहमागतायार्घ्यभूतां प्रादात् ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7001007125, "chapter_id": 21007, "verse_number": "४-१३-१२६", "content_sanskrit": "तस्यामयमक्रूरः श्वफल्काज्जज्ञे ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7001007126, "chapter_id": 21007, "verse_number": "४-१३-१२७", "content_sanskrit": "तस्यैवंगुणमिथुनादुत्पत्तिः ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7001007127, "chapter_id": 21007, "verse_number": "४-१३-१२८", "content_sanskrit": "तत्कथमस्मिन्नपक्रान्ते अत्र दुर्भिक्षमारिकाद्युपद्र वा न भविष्यंति ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7001007128, "chapter_id": 21007, "verse_number": "४-१३-१२९", "content_sanskrit": "तदयमत्रानीयतामलमतिगुणवत्यपराधान्वेषणेनेति यदुवृद्धस्यांधकस्यैतद्वचनमाकर्ण्य केशवोग्रसेनबलभद्र पुरोगमैर्यदुभिः कृतापराधतितिक्षुभिरभयं दत्त्वा श्वफल्कपुत्रः स्वपुरमानीतः ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7001007129, "chapter_id": 21007, "verse_number": "४-१३-१३०", "content_sanskrit": "तत्र चागतमात्र एव तस्य स्यमंतकमणेः प्रभावादनावृष्टिमारिकादुर्भिक्षव्यालाद्युपद्र वोपशमा बभूवुः ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7001007130, "chapter_id": 21007, "verse_number": "४-१३-१३१", "content_sanskrit": "कृष्णश्चिंतयामास ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7001007131, "chapter_id": 21007, "verse_number": "४-१३-१३२", "content_sanskrit": "स्वल्पमेतत्कारणं यदयं गांदिन्यां श्वफल्केनाक्रूरो जनितः ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7001007132, "chapter_id": 21007, "verse_number": "४-१३-१३३", "content_sanskrit": "सुमहांश्चायमनावृष्टिदुर्भिक्षमारिकाद्युपद्र वाप्रतिषेधकारी प्रभावः ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7001007133, "chapter_id": 21007, "verse_number": "४-१३-१३४", "content_sanskrit": "तन्नूनमस्य सकाशो! स महामणिः स्यमंतकाख्यस्तिष्ठति ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7001007134, "chapter_id": 21007, "verse_number": "४-१३-१३५", "content_sanskrit": "तस्य ह्येवंविधाः प्रभावाः श्रूयन्ते ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7001007135, "chapter_id": 21007, "verse_number": "४-१३-१३६", "content_sanskrit": "अयमपि च यज्ञादनंतरमन्यत्क्रत्वंतरं तस्यानंतरमन्यद्यज्ञांतरं चाजस्रमविच्छिन्नं यजतीति ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7001007136, "chapter_id": 21007, "verse_number": "४-१३-१३७", "content_sanskrit": "अनल्पोपादानं चास्यासंशयमत्राऽसौ मणिवरस्तिष्ठितीति कृताध्यवसायोऽन्यत्प्रयोजनमुद्दिश्य सकलयादवसमाजमात्मगृह एवाचीकरत् ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7001007137, "chapter_id": 21007, "verse_number": "४-१३-१३८", "content_sanskrit": "तत्र चोपविष्टेष्वखिलेषु यदुषु पूर्वं प्रयोजनमुपन्यस्य पर्यवसिते च तस्मिन् प्रसंगांतरपरिहासकथामक्रूरेण कृत्वा जनार्दनस्तमक्रूरमाह ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7001007138, "chapter_id": 21007, "verse_number": "४-१३-१३९", "content_sanskrit": "दानपते जानीम एव वयं यथा शतधन्वना तदिदमखिलजगत्सारभूतं स्यमंतकं रत्नं भवतः तदश्षोराष्ट्रोपकरकं भवत्सकाशो! तिष्ठति तिष्ठतु सर्व एव वयं तत्प्रभावफलभुजः किं त्वेष बलभद्रो ऽस्मानाशंकितवांश्तदस्मत्प्रीतये दर्शयस्वेत्यभिधाय जोषं स्थिते भगवति वासुदेवे सरत्नस्सोचिंतयत् ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7001007139, "chapter_id": 21007, "verse_number": "४-१३-१४०", "content_sanskrit": "किमत्रानुष्ठेयमन्यथा चेद्ब्रवीम्यहं तत्केवलांबरतिरोधानमन्विष्यंतो रत्नमेते द्र क्ष्यंति अतिविरोधो न क्षम इति संचिंत्य तमखिलजगत्कारणभूतं नारायणमाहक्रूरः ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7001007140, "chapter_id": 21007, "verse_number": "४-१३-१४१", "content_sanskrit": "भगवन्ममैतत्स्यमंतकरत्नं शतधनुषा समर्पितमपगते च तस्मिन्नद्य श्वः परश्वो वा भगवान् याचयिष्यतीति कृतमतिरतिकृच्छ्रेणैतावंतं कालमधारयम् ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7001007141, "chapter_id": 21007, "verse_number": "४-१३-१४२", "content_sanskrit": "तस्य च धारणश्क्लोए!नाहमश्षोओ!पभोगेष्वसंगिमानसो न वेद्मि स्वसुखकलामपि ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7001007142, "chapter_id": 21007, "verse_number": "४-१३-१४३", "content_sanskrit": "एतावन्मात्रमप्यश्षोराष्ट्रोपकारी धारयितुं न शक्नोति भवान्मन्यत इत्यात्मना न चोदितवान् ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7001007143, "chapter_id": 21007, "verse_number": "४-१३-१४४", "content_sanskrit": "तदिदं स्यमंतकरत्नं गृह्यतामिच्छया यस्याभिमतं तस्य समर्प्यताम् ॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7001007144, "chapter_id": 21007, "verse_number": "४-१३-१४५", "content_sanskrit": "ततः स्वोदरवस्त्रनिगोपितमतिलघुकनकसमुद्गकगतं प्रकटीकृतवान् ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7001007145, "chapter_id": 21007, "verse_number": "४-१३-१४६", "content_sanskrit": "ततश्च निष्क्राम्य स्यमंतकमणिं तस्मिन्यदुकुलसमाजे मुमोच ॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7001007146, "chapter_id": 21007, "verse_number": "४-१३-१४७", "content_sanskrit": "मुक्तमात्रे च तस्मिन्नतिकान्त्या तदखिलमास्थानमुद्योतितम् ॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7001007147, "chapter_id": 21007, "verse_number": "४-१३-१४८", "content_sanskrit": "अथाहाक्रुरः स एष मणिः शतधन्वनास्माकं समर्पितः यस्यायं स एनं गृह्णातु इति ॥१४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 7001007148, "chapter_id": 21007, "verse_number": "४-१३-१४९", "content_sanskrit": "तमालोक्य सर्वयादवानां साधुसाध्विति विस्मितमनसां वाचोऽश्रूयंत ॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 7001007149, "chapter_id": 21007, "verse_number": "४-१३-१५०", "content_sanskrit": "तमालोक्यातीव बलभद्रो ममायमच्युतेनैव सामान्यस्समन्विच्छित इति कृतस्पृहोऽभूत् ॥१५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 7001007150, "chapter_id": 21007, "verse_number": "४-१३-१५१", "content_sanskrit": "ममैवायं पितृधनमित्यतीव च सत्यभामापि स्पृहयांचकार ॥१५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 7001007151, "chapter_id": 21007, "verse_number": "४-१३-१५२", "content_sanskrit": "बलसत्यावलोकनात्कृष्णोप्यात्मानं गोचक्रांतरावस्थितमिव मेने ॥१५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 7001007152, "chapter_id": 21007, "verse_number": "४-१३-१५३", "content_sanskrit": "सकलयादवसमक्षं चाक्रूरमाह ॥१५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}, {"id": 7001007153, "chapter_id": 21007, "verse_number": "४-१३-१५४", "content_sanskrit": "एतद्धि मणिरत्नमात्मसंशोधनाय एतेषां यदूनां मया दर्शितम् एतच्च मम बलभद्र स्य च सामान्यं पितृधनं चैतत्सत्यभामाया नान्यस्यैतत् ॥१५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 154}, {"id": 7001007154, "chapter_id": 21007, "verse_number": "४-१३-१५५", "content_sanskrit": "एतच्च सर्वकालं शुचिना ब्रह्मचर्यादिगुणवता ध्रियमाणमश्षोराष्ट्रस्योपकारकमशुचिना ध्रियमाणमाधारमेव हंति ॥१५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 155}, {"id": 7001007155, "chapter_id": 21007, "verse_number": "४-१३-१५६", "content_sanskrit": "अतोहमस्य षोडशस्त्रीसहस्रपरिग्रहादसमर्थो धारणे कथमेतत्सत्यभामा स्वीकरोति ॥१५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 156}, {"id": 7001007156, "chapter_id": 21007, "verse_number": "४-१३-१५७", "content_sanskrit": "आर्यबलभद्रेणापि मदिरापानाद्यश्षोओ!पभोगपरित्यागः कार्यः ॥१५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 157}, {"id": 7001007157, "chapter_id": 21007, "verse_number": "४-१३-१५८", "content_sanskrit": "तदलं यदुलोकोयं बलभद्रः अहं च सत्या च त्वां दानपते प्रार्थयामः ॥१५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 158}, {"id": 7001007158, "chapter_id": 21007, "verse_number": "४-१३-१५९", "content_sanskrit": "तद्भवानेव धारयितुं समर्थः ॥१५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 159}, {"id": 7001007159, "chapter_id": 21007, "verse_number": "४-१३-१६०", "content_sanskrit": "त्वद्धृतं चास्य राष्ट्रस्योपकारकं तद्भवानश्षोराष्ट्रनिमित्तमेतत्पूर्ववद्धारयत्वन्यन्न वक्तव्यमित्युक्तो दानपतिस्तथेत्याह जग्राह च तन्महारत्नम् ॥१६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 160}, {"id": 7001007160, "chapter_id": 21007, "verse_number": "४-१३-१६१", "content_sanskrit": "ततःप्रभृत्यक्रूरः प्रकटेनैव तेनातिजाज्ज्वल्यमानेनात्मकंठावसक्तेनादित्य इवांशुमाली चचार ॥१६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 161}, {"id": 7001007161, "chapter_id": 21007, "verse_number": "४-१३-१६२", "content_sanskrit": "इत्येतद्भगवतो मिथ्याभिशस्तिक्षालनं यः स्मरति न तस्य कदाचिदल्पापि मिथ्याभिशस्तिर्भवति अव्याहताखिलेंद्रि यश्चाखिलपापमोक्षमवाप्नोति ॥१६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 162}]