[{"id": 2093902, "chapter_id": 3008, "verse_number": "१३-१३८-१", "content_sanskrit": "युधिष्ठिर उवाच।\nकेन सङ्कल्पितं श्राद्धं कस्मिन्काले किमात्मकम्।\nभृग्वङ्गिरसिके काले मुनिना कतरेण वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2093903, "chapter_id": 3008, "verse_number": "१३-१३८-२", "content_sanskrit": "`येन सङ्कल्पितं चैव तन्मे ब्रूहि पितामह।\nकानि श्राद्धेषु वर्ज्यानि कानि मूलफलानि च।\nधान्यजात्यश्च का वर्ज्यास्तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2093904, "chapter_id": 3008, "verse_number": "१३-१३८-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2093905, "chapter_id": 3008, "verse_number": "१३-१३८-३", "content_sanskrit": "यथा श्राद्धं सम्प्रवृत्तं यस्मिन्काले सदात्मकम्।\nयेन सङ्कल्पितं चैव तन्मे शृणु जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2093906, "chapter_id": 3008, "verse_number": "१३-१३८-४", "content_sanskrit": "स्वायम्भुवोऽत्रिः कौरव्य परमर्षिः प्रतापवान्।\nतस्य वंशे महाराज दत्तात्रेय इति स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2093907, "chapter_id": 3008, "verse_number": "१३-१३८-५", "content_sanskrit": "दत्तात्रेयस्य पुत्रोऽभून्निमिर्नाम तपोधनः।\nनिमेश्चाप्यभवत्पुत्रः श्रीमान्नाम श्रिया वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2093908, "chapter_id": 3008, "verse_number": "१३-१३८-६", "content_sanskrit": "पूर्णो वर्षसहस्रान्ते स कृत्वा दुष्करं तपः।\nकालधर्मपरीतात्मा निधनं समुपागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2093909, "chapter_id": 3008, "verse_number": "१३-१३८-७", "content_sanskrit": "निमिस्तु कृत्वा शौचानि विधिदृष्टेन कर्मणा।\nसन्तापमगमत्तीप्रं पुत्रशोकपरायणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2093910, "chapter_id": 3008, "verse_number": "१३-१३८-८", "content_sanskrit": "अथ कृत्वोपकार्याणि चतुर्दश्यां महामतिः।\nतमेव गणयञ्शोकं विरात्रे प्रत्यबुध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2093911, "chapter_id": 3008, "verse_number": "१३-१३८-९", "content_sanskrit": "तस्यासीत्प्रतिबुद्धस्य शोकेन व्यथितात्मनः।\nमनः संहृत्य विषये बुद्धिर्विस्तारगामिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2093912, "chapter_id": 3008, "verse_number": "१३-१३८-१०", "content_sanskrit": "ततः सञ्चिन्तयामास श्राद्धकल्पं समाहितः।\nयानि तस्यैव भोज्यानि मूलानि च फलानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2093913, "chapter_id": 3008, "verse_number": "१३-१३८-११", "content_sanskrit": "उक्तानि यानि चान्यानि यानि चेष्टानि तस्य ह।\nतानि सर्वाणि मनसा विनिश्चित्य तपोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2093914, "chapter_id": 3008, "verse_number": "१३-१३८-१२", "content_sanskrit": "अमावास्यां महाप्राज्ञो विप्रानानाय्य पूजितान्।\nदक्षिणावर्तिकाः सर्वा बृसीः स्वयमथाकरोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2093915, "chapter_id": 3008, "verse_number": "१३-१३८-१३", "content_sanskrit": "सप्त विप्रांस्ततो भोज्ये युगपत्समुपानयत्।\nऋते च लवणं भोज्यं श्यामाकान्नं ददौ प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2093916, "chapter_id": 3008, "verse_number": "१३-१३८-१४", "content_sanskrit": "दक्षिणाग्रास्ततो दर्भा विष्टरेषु निवेशिताः।\nपादयोश्चैव विप्राणां ये त्वन्नमुपभुञ्जते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2093917, "chapter_id": 3008, "verse_number": "१३-१३८-१५", "content_sanskrit": "कृत्वा च दक्षिणाग्नान्वै दर्भान्स प्रयतः शुचिः।\nप्रददौ श्रीमते पिण्डान्नामगोत्रमुदाहरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2093918, "chapter_id": 3008, "verse_number": "१३-१३८-१६", "content_sanskrit": "तत्कृत्वा स मुनिश्रेष्ठो धर्मसङ्करमात्मनः।\nपश्चात्तापेन महता तप्यमानोऽभ्यचिन्तयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2093919, "chapter_id": 3008, "verse_number": "१३-१३८-१७", "content_sanskrit": "अकृतं मुनिभिः पूर्वं किं मयेदमनुष्ठितम्।\nकथं नु शापेन न मां दहेयुर्ब्राह्मणा इति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2093920, "chapter_id": 3008, "verse_number": "१३-१३८-१८", "content_sanskrit": "ततः सञ्चिन्तयामास वंशकर्तारमात्मनः।\n`बुद्ध्वाऽत्रिं मनसा दध्यौ भगवन्तं समाहितः।\nध्यातमात्रस्तथा चात्रिराजगाम तपोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2093921, "chapter_id": 3008, "verse_number": "१३-१३८-१९", "content_sanskrit": "अथात्रिस्तं तथा दृष्ट्वा पुत्रशोकेन कर्शितम्।\nभृशमाश्वासयामास वाग्भिरिष्टाभिरव्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2093922, "chapter_id": 3008, "verse_number": "१३-१३८-२०", "content_sanskrit": "निमे सङ्कल्पितस्तेऽयं पितृयज्ञस्तपोधन।\nमतो मे पूर्वदृष्टोऽत्र धर्मोऽयं ब्रह्मणा स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2093923, "chapter_id": 3008, "verse_number": "१३-१३८-२१", "content_sanskrit": "सोयं स्वयभुविहितो धर्मः सङ्कल्पितस्त्वया।\nऋते स्वयम्भुवः कोऽन्यः श्राद्धे संविधिमाहरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2093924, "chapter_id": 3008, "verse_number": "१३-१३८-२२", "content_sanskrit": "अथाख्यास्यामि ते पुत्र श्राद्दे यं विधिमुत्तमम्।\nस्वयम्भुविहितं पुत्र तत्कुरुष्व निबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2093925, "chapter_id": 3008, "verse_number": "१३-१३८-२३", "content_sanskrit": "कृत्वाऽग्निशरणं पूर्वं मन्त्रपूर्वं तपोधन।\nततोऽग्नयेऽथ सोमाय वरुणाय च नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2093926, "chapter_id": 3008, "verse_number": "१३-१३८-२४", "content_sanskrit": "विश्वेदवाश्च यि नित्यं पितृभिः सह गोचराः।\nतेभ्यः सङ्कल्पिता भागाः स्वयमेव स्वयम्भुवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2093927, "chapter_id": 3008, "verse_number": "१३-१३८-२५", "content_sanskrit": "स्तोतव्या चेह पृथिवी लोकस्यैव तु धारिणी।\nवैष्णवी काश्यपि चेति तथैवेहाक्षयेति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2093928, "chapter_id": 3008, "verse_number": "१३-१३८-२६", "content_sanskrit": "उदकानयने चैव स्तोतव्यो वरुणो विभुः।\nततोऽग्निश्चैव सोमश्च आराध्याविह तेऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2093929, "chapter_id": 3008, "verse_number": "१३-१३८-२७", "content_sanskrit": "देवास्तु पितरो नाम निर्मिता ये स्वयम्भुवा।\nऊष्मपा ये महाभागास्तेषां भागः प्रकल्पितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2093930, "chapter_id": 3008, "verse_number": "१३-१३८-२८", "content_sanskrit": "ते श्राद्धेनार्च्यमाना वै विमुच्यन्ते ह किल्बिषात्।\nसप्तकाः पितृवंशास्तु पूर्वदृष्टाः स्वयंभुवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2093931, "chapter_id": 3008, "verse_number": "१३-१३८-२९", "content_sanskrit": "विश्वे चाग्निमुखा देवाः संख्याताः पूर्वमेव ते।\nतेषां नामानि वक्ष्यामि भागार्हाणां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2093932, "chapter_id": 3008, "verse_number": "१३-१३८-३०", "content_sanskrit": "सहः कृतिर्विपाप्मा च पुण्यकृत्पावनस्तथा।\nग्राम्यः क्षेम्यः समूहश्च दिव्यसानुस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2093933, "chapter_id": 3008, "verse_number": "१३-१३८-३१", "content_sanskrit": "विवस्वान्वीर्यवाञ्श्रीमान्कीर्तिमान्कृत एव च।\nजितात्मा मुनिवीर्यश्च दीप्तरोमा भयङ्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2093934, "chapter_id": 3008, "verse_number": "१३-१३८-३२", "content_sanskrit": "अनुकर्मा प्रतीतश्च प्रदाताऽप्यंशुमांस्तथा।\nशैलाभः परमक्रोधी धीरोष्णी भूपतिस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2093935, "chapter_id": 3008, "verse_number": "१३-१३८-३३", "content_sanskrit": "स्रजो वज्रीवरी चैव विश्वेदेवाः सनातनाः।\nविद्युद्वर्चाः सोमवर्चाः सूर्यश्रीश्चेति नामतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2093936, "chapter_id": 3008, "verse_number": "१३-१३८-३४", "content_sanskrit": "सोमपः सूर्यसावित्रो दत्तात्मा पुण्डरीयकः।\nउष्णीनाभो नभोदश्च विश्वायुर्दीप्तिरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2093937, "chapter_id": 3008, "verse_number": "१३-१३८-३५", "content_sanskrit": "चमूहरः सुरेशश्च व्योमारिः शङ्करो भवः।\nईशः कर्ता कृतिर्दक्षो भुवनो दिव्यकर्मकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2093938, "chapter_id": 3008, "verse_number": "१३-१३८-३६", "content_sanskrit": "गणितः पञ्चवीर्यश्च आदित्यो रश्मिवांस्तथा।\nसप्तकृत्सोमवर्चाश्च विश्वकृत्कविरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2093939, "chapter_id": 3008, "verse_number": "१३-१३८-३७", "content_sanskrit": "अनुगोप्ता सुगोप्ता च नप्ता चेश्वर एव च।\nकीर्तितास्ते महाभागाः कालस्य गतिगोचराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2093940, "chapter_id": 3008, "verse_number": "१३-१३८-३८", "content_sanskrit": "अश्राद्धेयानि धान्यानि कोद्रवाः पुलकास्तथा।\nहिङ्गुद्रवेषु शाकेषु मूलानां लशुनं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2093941, "chapter_id": 3008, "verse_number": "१३-१३८-३९", "content_sanskrit": "पलाण्डुः सौभाञ्जनकस्तथा गृञ्जनकादयः।\nकूश्माण्डजात्यलाबुं च कृष्णं लवणमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2093942, "chapter_id": 3008, "verse_number": "१३-१३८-४०", "content_sanskrit": "ग्राम्यवाराहमांसं च यच्चैवाप्रोक्षितं भवेत्।\nकृष्णाजं जीरकं चैव शीतपाकी तथैव च।\nअङ्कुराद्यास्तथा वर्ज्या इह शृङ्गाटकानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2093943, "chapter_id": 3008, "verse_number": "१३-१३८-४१", "content_sanskrit": "वर्जयेल्लवणं सर्वं तथा जम्बूफलानि च।\nअवक्षुतावरुदितं तथा श्राद्धे च वर्जयेत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2093944, "chapter_id": 3008, "verse_number": "१३-१३८-४२", "content_sanskrit": "निवापे हव्यकव्ये वा गर्हितं च सुदर्शनम्।\nपितरश्च हि देवाश्च नाभिनन्दन्ति तद्धविः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2093945, "chapter_id": 3008, "verse_number": "१३-१३८-४३", "content_sanskrit": "चण्डालश्वपचौ वर्ज्यौ निवापे समुपस्थिते।\nकाषायवासाः कुष्ठी वा पतितो ब्रह्महाऽपि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2093946, "chapter_id": 3008, "verse_number": "१३-१३८-४४", "content_sanskrit": "सङ्कीर्णयोनिर्विप्रश्च सम्बन्धी पतितश्च यः।\nवर्जनीय बुधैरेते निवापे समुपस्थिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2093947, "chapter_id": 3008, "verse_number": "१३-१३८-४५", "content_sanskrit": "इत्येवमुक्त्वा भगवान्स्ववंश्यं तमृषिं पुरा।\nपितामहसभां दिव्या जगामात्रिस्तपोधनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2093948, "chapter_id": 3008, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि अष्टत्रिंशदधिकशततमोऽध्यायः॥ १३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]