[{"id": 2015076, "chapter_id": 1315, "verse_number": "२-५६-१", "content_sanskrit": "भीष्ण उवाच॥\nनिहत्य नरकं भौमं सत्यभामासहायवान्।\nसहितो लोकपालैश्च ददर्श नरकालयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2015077, "chapter_id": 1315, "verse_number": "२-५६-२", "content_sanskrit": "अथास्य गृहमासाद्य नारकस्य महात्मनः।\nददर्श धनमक्षय्यं रत्नानि विविधानि च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2015078, "chapter_id": 1315, "verse_number": "२-५६-३", "content_sanskrit": "मणिमुक्ताप्रवालानि वैडूर्यविकृतानि च।\nविस्ताराल्पांश्चार्कमणीन्विपुलान्स्फाटिकानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2015079, "chapter_id": 1315, "verse_number": "२-५६-४", "content_sanskrit": "जाम्बूनदमयान्येव शातकुम्भमयानि च।\nप्रदीप्तज्वलनाभानि शीतरश्मिप्रभाणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2015080, "chapter_id": 1315, "verse_number": "२-५६-५", "content_sanskrit": "हिरण्यवर्णं रुचिरं श्वेतमभ्यन्तरं गृहम्।\nतदक्षय्यं गृहे दृष्टं नरकस्य धनं बहु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2015081, "chapter_id": 1315, "verse_number": "२-५६-६", "content_sanskrit": "न हि राज्ञः कुबेरस्य तावद्धनसमुच्छ्रयः।\nदृष्टपूर्वः पुरा साक्षान्महेन्द्रभवनेष्वपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2015082, "chapter_id": 1315, "verse_number": "२-५६-७", "content_sanskrit": "हते भौमे निशुम्भे च वासवः सगणोऽब्रवीत्।\nदाशार्हपतिमासीनमाहृत्य मणिकुण्डले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2015083, "chapter_id": 1315, "verse_number": "२-५६-८", "content_sanskrit": "हेमसूत्रा महाकक्ष्यास्तोमरैर्वीर्यशालिनः।\nविमलानि पताकानि वासांसि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2015084, "chapter_id": 1315, "verse_number": "२-५६-९", "content_sanskrit": "भीमरूपाश्च मातङ्गाः प्रवालविकृताः कुथाः।\nते च विंशतिसाहस्रा द्वास्तावत्यः करेणवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2015085, "chapter_id": 1315, "verse_number": "२-५६-१०", "content_sanskrit": "अष्टौ शतसहस्राणि देशजाश्चोत्तमा हयाः।\nगोभिश्चाविकृतैर्यावत्कामात्तव जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2015086, "chapter_id": 1315, "verse_number": "२-५६-११", "content_sanskrit": "एतत्ते प्रापयिष्याणि वृष्ण्यावासमरिन्दम।\nवसु यत्रिषु लोकेषु धर्मेणावर्जितं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2015087, "chapter_id": 1315, "verse_number": "२-५६-१२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2015088, "chapter_id": 1315, "verse_number": "२-५६-१२", "content_sanskrit": "देवगन्धर्वरत्नानि दैतेयासुरजानि च।\nयानि सन्ति हिरण्यानि नरकस्य निवेशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2015089, "chapter_id": 1315, "verse_number": "२-५६-१३", "content_sanskrit": "एतत्तु गरुडे सर्वं क्षिप्रमारोप्य वासवः।\nदार्शार्हपतिना सार्धमुपायान्मणिपर्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2015090, "chapter_id": 1315, "verse_number": "२-५६-१४", "content_sanskrit": "चित्रग्रथितमेघाभः प्रबभौ मणिपर्वतः।\nहेमचित्रवितानैश्च प्रासादैरुपशोभितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2015091, "chapter_id": 1315, "verse_number": "२-५६-१५", "content_sanskrit": "हर्म्याणि च विशालानि मणिसोपानवन्ति च।\nतत्रस्था वरवर्णिन्यो ददृशुर्मधुसूदनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2015092, "chapter_id": 1315, "verse_number": "२-५६-१६", "content_sanskrit": "गन्धर्वसुरमुख्यानां प्रिया दुहितरस्तदा।\nत्रिविष्टपसमे देशे तिष्ठन्तमपराजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2015093, "chapter_id": 1315, "verse_number": "२-५६-१७", "content_sanskrit": "परिवव्रुर्महाबाहुमेकवेणीधराः स्त्रियः।\nपर्वाः काषायवासिन्यः सर्वाश्च नियतेन्द्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2015094, "chapter_id": 1315, "verse_number": "२-५६-१८", "content_sanskrit": "व्रतसन्तापजः शोके नात्र कश्चिदपीडयत्।\nअरजांसि च वासांसि बिभ्रत्यः कौशिकान्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2015095, "chapter_id": 1315, "verse_number": "२-५६-१९", "content_sanskrit": "समेत्य यदुसिंहस्य चक्रुरस्याञ्जलिं स्त्रियः।\nऊचुश्चैनं हृषीकेशं सर्वास्ताः कमलेक्षणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2015096, "chapter_id": 1315, "verse_number": "२-५६-२०", "content_sanskrit": "नारदेन समाख्यातमस्माकं पुरुषोत्तम।\nआगमिष्यति गोविन्दः सुरकार्यार्थसिद्धये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2015097, "chapter_id": 1315, "verse_number": "२-५६-२१", "content_sanskrit": "सोऽसुरं नरकं हत्वा निशुम्भं मुरमेव च।\nभौमं च सपरीवारं हयग्रीवं च दानवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2015098, "chapter_id": 1315, "verse_number": "२-५६-२२", "content_sanskrit": "तथा पञ्चजनं चैव प्राप्स्यते धनमक्षयम्।\nसोऽचिरेणैव कालेन युष्मन्मोक्ता भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2015099, "chapter_id": 1315, "verse_number": "२-५६-२३", "content_sanskrit": "एवमुक्त्वागमद्धीरो देवर्षिर्नारदस्तथा।\nत्वां चिन्तयानाः सततं तपो घोरमुपास्महे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2015100, "chapter_id": 1315, "verse_number": "२-५६-२४", "content_sanskrit": "कालेऽतीते महाबाहुं कदा द्रक्ष्याम माधवम्।\nइत्येवं हृदि सङ्कल्पं कृत्वा पुरुषसत्तम।\nतपश्चराम सततं रक्ष्यमाणा हि दानवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2015101, "chapter_id": 1315, "verse_number": "२-५६-२५", "content_sanskrit": "ततोऽस्मत्प्रियकामार्थं भगवान्मारुतोऽब्रवीत्।\nयथोक्तं नारदेनाथ न चिरात्तद्भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2015102, "chapter_id": 1315, "verse_number": "२-५६-२६x", "content_sanskrit": "भीष्ण उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2015103, "chapter_id": 1315, "verse_number": "२-५६-२६", "content_sanskrit": "तासां परमनारीणामृषभाक्षं पुरः स्थितम्।\nददृशुर्देवगन्धर्वा गृष्टीनामिव गोपतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2015104, "chapter_id": 1315, "verse_number": "२-५६-२७", "content_sanskrit": "तस्य चन्द्रोपमं वक्त्रमुदीक्ष्य मुदितेन्द्रियाः।\nसम्प्रहृष्टा महाबाहुमिदं वचनमब्रुवन्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2015105, "chapter_id": 1315, "verse_number": "२-५६-२८", "content_sanskrit": "सत्यव्रत पुरा वायुरिदमस्मानिहाब्रवीत्।\nसर्वभूतहितज्ञश्च महर्षिरपि नारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2015106, "chapter_id": 1315, "verse_number": "२-५६-२९", "content_sanskrit": "विष्णुर्नारायणो देवः शङ्खचक्रगदासिभृत्।\nस भौमं नरकं हत्वा भर्ता वो भविता ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2015107, "chapter_id": 1315, "verse_number": "२-५६-३०", "content_sanskrit": "दिष्ट्या तस्यर्षिमुख्यस्य नारदस्य महात्मनः।\nवचनादेव सत्यं नो भर्ता भवितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2015108, "chapter_id": 1315, "verse_number": "२-५६-३१", "content_sanskrit": "यत्प्रियं बत पश्याम श्रुतं प्रियमरिन्दम।\nदर्शनेन कृतार्थाः स्मो वयमस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2015109, "chapter_id": 1315, "verse_number": "२-५६-३२", "content_sanskrit": "उवाच हि यदुश्रेष्ठः सर्वास्ता जातमन्मथाः।\nयथा ब्रूत विशालाक्ष्यस्तत्सर्वं वो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2015110, "chapter_id": 1315, "verse_number": "२-५६-३३", "content_sanskrit": "ततस्ता गरुडे सर्वाः सरत्नधनसञ्चयाः।\nक्षिप्रमारोपयाञ्चक्रे भगवान्देवकीसुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2015111, "chapter_id": 1315, "verse_number": "२-५६-३४", "content_sanskrit": "सपक्षिगणमातङ्गं सव्यालमृगपन्नगम्।\nशाखामृगगणैर्जुष्टं सप्रस्तरशिलातलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2015112, "chapter_id": 1315, "verse_number": "२-५६-३५", "content_sanskrit": "न्यङ्कुभिश्च वराहैश्च रुरुभिश्च निषेवितम्।\nसप्रपातमहासानुं विचित्रशिखिसङ्कुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2015113, "chapter_id": 1315, "verse_number": "२-५६-३६", "content_sanskrit": "स महेन्द्रानुजः शौरिश्चकार गुरुडोपरि।\nपश्यतां सर्वभूतानामुत्पाट्य मणिपर्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2015114, "chapter_id": 1315, "verse_number": "२-५६-३७", "content_sanskrit": "उपेन्द्रं बलदेवं च वासवं च महाबलम्।\nस्वपक्षबलविक्षेपैर्महाद्रिशिखरोपमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2015115, "chapter_id": 1315, "verse_number": "२-५६-३८", "content_sanskrit": "दिक्षु सर्वासु संरावं स चक्रे गरुडो वहन्।\nआरुजन्पर्वताग्राणि पादपांश्च समुत्क्षिपन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2015116, "chapter_id": 1315, "verse_number": "२-५६-३९", "content_sanskrit": "सञ्जहार महाभ्राणि वैश्वानरपथं गतः।\nग्रहनक्षत्रताराणां सप्तर्षीणां स्वतेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2015117, "chapter_id": 1315, "verse_number": "२-५६-४०", "content_sanskrit": "प्रभाजालमतिक्रम्य चाश्विनोश्च परन्तप।\nप्राप्य पुण्यतमं स्थानं देवलोकमरिन्दमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2015118, "chapter_id": 1315, "verse_number": "२-५६-४१", "content_sanskrit": "शक्रसद्म समासाद्य चावरुह्य जनार्दनः।\nसोऽभिवाद्यादितेः पादावर्चितः सर्वदैवतैः।\nब्रह्मदक्षपुरोगैश्च प्रजापतिभिरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2015119, "chapter_id": 1315, "verse_number": "२-५६-४२", "content_sanskrit": "अदितेः कुण्डले दिव्ये ददावथ तदा विभुः।\nरत्नान च परार्घ्याणि रामेण सह केशवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2015120, "chapter_id": 1315, "verse_number": "२-५६-४३", "content_sanskrit": "प्रतिगृह्य च तत्सर्वमदितिर्वासवानुजम्।\nपूजयामास दाशार्हं रामं च विगतज्वरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2015121, "chapter_id": 1315, "verse_number": "२-५६-४४", "content_sanskrit": "शची महेन्द्रमहिषी कृष्णस्य महिषीं तदा।\nसत्यभामां तु सङ्गृह्य अदित्यै सा न्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2015122, "chapter_id": 1315, "verse_number": "२-५६-४५", "content_sanskrit": "सा तस्याः सत्यभामायाः कृष्णाप्रियचिकीर्षया।\nवरं प्रादाद्देवमाता सत्यायै विगतज्वरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2015123, "chapter_id": 1315, "verse_number": "२-५६-४६", "content_sanskrit": "जरां न यास्यसि शुभे यावत्कृष्णोऽस्ति भूतले।\nसर्वगन्धगुणोपेता भविष्यसि वरानने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2015124, "chapter_id": 1315, "verse_number": "२-५६-४७", "content_sanskrit": "विसृज्य सत्यभामा वै पौलोमीं च सुमध्यमा।\nशच्यापि समनुज्ञाता ययौ कृष्णनिवेशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2015125, "chapter_id": 1315, "verse_number": "२-५६-४८", "content_sanskrit": "सम्पूज्यमानस्त्रिदशैर्महर्षिगणसेवितः।\nद्वारकां प्रययौ कृष्णो देवलोकादरिन्दमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2015126, "chapter_id": 1315, "verse_number": "२-५६-४९", "content_sanskrit": "शीघ्रादेत्य महाबाहुर्दीर्घमध्वानमच्युतः।\nवर्घमानपुरद्वारमाससाद सुरोत्तमः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2015127, "chapter_id": 1315, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि अर्घाहरणपर्वणि षट्पञ्चाशोऽध्यायः॥ ५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]