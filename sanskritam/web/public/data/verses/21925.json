[{"id": 7001925000, "chapter_id": 21925, "verse_number": "१०४-१", "content_sanskrit": "सूर्यस्तवनवर्णनम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001925001, "chapter_id": 21925, "verse_number": "१०४-२", "content_sanskrit": "मार्कण्डेय उवाच ।\nलिख्यमाने ततो भानौ विश्वकर्मा प्रजापतिः ।\nउद्भूतपुलकः स्तोत्रमिदं चक्रे विवस्वतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001925002, "chapter_id": 21925, "verse_number": "१०४-३", "content_sanskrit": "विवस्वते प्रणतहितानुकम्पिने महात्मने समजवसप्तसप्तये ।\nसुतेजसे कमलकुलावबोधिने नमस्तमः पटलपटावपाटिने ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001925003, "chapter_id": 21925, "verse_number": "१०४-४", "content_sanskrit": "पावनातिशयपुण्यकर्मणे नैककामविषयप्रदायिने ।\nभास्वरानलमयूखशायिने सर्वलोकहितकारिणे नमः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001925004, "chapter_id": 21925, "verse_number": "१०४-५", "content_sanskrit": "अजाय लोकत्रयकारणाय भूतात्मने गोपतये वृषाय ।\nनमो महाकारुणिकोत्तमाय सूर्याय चक्षुःप्रभवालयाय ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001925005, "chapter_id": 21925, "verse_number": "१०४-६", "content_sanskrit": "विवस्वते ज्ञानमृतेंऽतरात्मने जगत्प्रतिष्ठाय जगद्धितैषिणे ।\nस्वयम्भुवे लोकसमस्तचक्षुषे सुरोत्तमायामिततेजसे नमः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001925006, "chapter_id": 21925, "verse_number": "१०४-७", "content_sanskrit": "क्षणमुदयाचलमौलिमणिः सुरगणमहित हितो जगतः ।\nत्वमु मयूखसहस्रवपुर्जगति विभासि तमांसि नुदन् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001925007, "chapter_id": 21925, "verse_number": "१०४-८", "content_sanskrit": "भवतिमिरासवपानमदाद्भवति विलोहितविग्रहता ।\nमिहिर विभासि यतः सुतरां त्रिभुवनभावनभानिकरैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001925008, "chapter_id": 21925, "verse_number": "१०४-९", "content_sanskrit": "रथमधिरुह्य समावयवं चारुविकम्पितमुरुरुचिरम् ।\nसततमखिन्नहयैर्भगवंश्चरसि जगद्धिताय विततम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001925009, "chapter_id": 21925, "verse_number": "१०४-१०", "content_sanskrit": "अमृतमयेन रसेन समं विबुधपितॄनपि तर्पयसे ।\nअरिगणसूदन तेन तव प्रणतिमुपेत्य लिखामि वपुः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001925010, "chapter_id": 21925, "verse_number": "१०४-११", "content_sanskrit": "शुकसमवर्णह्यप्रथितं तव पदपांसुपवित्रतमम् ।\nनतजनवत्सल मां प्रणतं त्रिभुवनपावन पाहि रवे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001925011, "chapter_id": 21925, "verse_number": "१०४-१२", "content_sanskrit": "इति सकलजगप्रसूतिभूतं त्रिभुवनभावनधामहेतुमेकम् ।\nरविमखिलजगत्प्रदीपभूतं त्रिदशवर प्रणतोऽस्मि सर्वदा त्वाम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]