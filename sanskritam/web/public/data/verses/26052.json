[{"id": 7006052000, "chapter_id": 26052, "verse_number": "१-२३६-१", "content_sanskrit": "श्रीभगवानुवाच ।\nआत्मज्ञानं प्रवक्ष्यामि शृणु नारद तत्त्वत ।\nअद्वैतं साङ्ख्यमित्याहुर्योगस्तत्रैकचित्तता ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006052001, "chapter_id": 26052, "verse_number": "१-२३६-२", "content_sanskrit": "अद्वैतयोगसम्पन्नास्ते मुच्यन्तेऽतिबन्नात् ।\nअतीतारब्धमागामि कर्म नश्यति बोधतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006052002, "chapter_id": 26052, "verse_number": "१-२३६-३", "content_sanskrit": "सद्विचारकुठारेण च्छिन्नसंसारपादपः ।\nज्ञानवैराग्यतीर्थेन लभते वैष्णवं पदम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006052003, "chapter_id": 26052, "verse_number": "१-२३६-४", "content_sanskrit": "जाग्रत्स्वप्नसुषुप्तं च माया त्रिपुरमुच्यते ।\nअत्रैवान्तर्गतं सर्वं शाश्वते नाद्वये पदे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006052004, "chapter_id": 26052, "verse_number": "१-२३६-५", "content_sanskrit": "नामरूपक्रियाहीनं सर्वं तत्परमं पदम् ।\nजगत्कृत्वेश्वरोऽनन्तं स्वयमत्र प्रविष्टवान् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006052005, "chapter_id": 26052, "verse_number": "१-२३६-६", "content_sanskrit": "वेदाहमेतं पुरुषं चिद्रूपं तमसः परम् ।\nसोऽहमस्मीति मोक्षाय नान्यः पन्था विमुक्तये ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006052006, "chapter_id": 26052, "verse_number": "१-२३६-७", "content_sanskrit": "श्रवणं मननं ध्यानं ज्ञानानां चैव साधनम्। ।\nयज्ञदानतपस्तीर्थवेदैर्मुक्तिर्न लभ्यते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006052007, "chapter_id": 26052, "verse_number": "१-२३६-८", "content_sanskrit": "त्यागेन केनचिद्ध्यानपूजाकर्मादिभिर्यथा ।\nद्विविधं वेदवचनं कुरु कर्म त्यजेति च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006052008, "chapter_id": 26052, "verse_number": "१-२३६-९", "content_sanskrit": "यज्ञादयो विमुक्तानां निष्कामानां विमुक्तये ।\nअन्तः करणशुद्ध्यर्थमूचुरेवात्र केचन ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006052009, "chapter_id": 26052, "verse_number": "१-२३६-१०", "content_sanskrit": "एकेन जन्मना ज्ञानन्मुक्तिर्न द्वैतभाविनाम। ।\nयोगभ्रष्टाः कुयोगाश्च विप्रा योगिकुलोद्भवाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006052010, "chapter_id": 26052, "verse_number": "१-२३६-११", "content_sanskrit": "कर्मणा बध्यते जन्तुर्ज्ञानान्मुक्तो भवाद्भवेत् ।\nआत्मज्ञानन्त्वाश्रयेद्वै अज्ञानं यदतोऽन्यथा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006052011, "chapter_id": 26052, "verse_number": "१-२३६-१२", "content_sanskrit": "यदा सर्वे विमुच्यन्ते कामा येस्यहृदि सथताः ।\nतदामृतत्वमाप्नोति जीवन्नेव न संशयः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006052012, "chapter_id": 26052, "verse_number": "१-२३६-१३", "content_sanskrit": "व्यापकत्वात्कथं याति को याति क्व स याति च ।\nअनन्तत्वान्नदेशोऽस्ति अमूर्तित्वाद्गतिः कुतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006052013, "chapter_id": 26052, "verse_number": "१-२३६-१४", "content_sanskrit": "अद्वयत्वान्न कोऽप्यस्ति बोधत्वाज्जडता कुतः ।\nएकोद्दिष्टं यदन्यस्य मतिवाग्गतिसंस्थिति (म्) ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006052014, "chapter_id": 26052, "verse_number": "१-२३६-१५", "content_sanskrit": "कथमाकाशकल्पस्य गतिरागतिसंस्थिति ।\nजाग्रत्स्वप्नसुषुप्तं च मायया परिकल्पितम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006052015, "chapter_id": 26052, "verse_number": "१-२३६-१६", "content_sanskrit": "वस्तु तैजसकं प्राज्ञे यत्तु पुण्यमखण्डकम् ।\nयथा ते प्रियात्मा नः सर्वेषां च तथा प्रियः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006052016, "chapter_id": 26052, "verse_number": "१-२३६-१७", "content_sanskrit": "बोधमार्गे यथा चित्तं सर्वेषां च तथा मते ।\nसर्वदा सर्वभूतानां सर्वस्य च महामुने ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006052017, "chapter_id": 26052, "verse_number": "१-२३६-१८", "content_sanskrit": "नाहमत्रात्मविज्ञानं तस्मात्पूर्णं निरन्तरम् ।\nजाग्रत्स्वप्नं तथा वृत्तं सौषुप्तसुखमेव च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006052018, "chapter_id": 26052, "verse_number": "१-२३६-१९", "content_sanskrit": "स्मरणं विस्मृतार्थस्य नास्ति चेत्कस्य जते ।\nसत्यमस्तु तथा वाणु अशरीरं परं तथा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006052019, "chapter_id": 26052, "verse_number": "१-२३६-२०", "content_sanskrit": "नास्ति चेत्सुखदुः खानां सर्वेषां वेदनं कथम् ।\nसदा सर्वत्र सर्वज्ञः सर्वस्य हृदये न येत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006052020, "chapter_id": 26052, "verse_number": "१-२३६-२१", "content_sanskrit": "साक्षिभूतः समाश्रित्य को जानाति विचेष्टितम् ।\nसत्य ज्ञानानन्त भिन्नं स्यान्नसत्यं ज्ञानतः पृथक् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006052021, "chapter_id": 26052, "verse_number": "१-२३६-२२", "content_sanskrit": "नानन्त्यात्पृथगानन्दं नाप्यमानन्दतः पृथक् ।\nत्वमेव परमं ब्रह्म सत्यज्ञानादिलक्षणम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006052022, "chapter_id": 26052, "verse_number": "१-२३६-२३", "content_sanskrit": "अहं ब्रह्म परं तत्त्वं ज्ञात्वा त्वखिवद्भवेत् ।\nयथैकमृन्मये ज्ञाते सर्वमेतच्चराचरम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006052023, "chapter_id": 26052, "verse_number": "१-२३६-२४", "content_sanskrit": "यथैकहेममणिना सर्वं हेममयं भवेत् ।\nज्ञानं तथैवमीशेन ज्ञानिनाप्यखिलं जगत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006052024, "chapter_id": 26052, "verse_number": "१-२३६-२५", "content_sanskrit": "यथान्धकारदोषेण रज्जुः सम्यङ्नदृश्यते ।\nयथा संमोहदोषेण चात्मा सम्यङ्नदृश्यते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006052025, "chapter_id": 26052, "verse_number": "१-२३६-२६", "content_sanskrit": "सर्पधारादिभिर्भेदरैन्यथा वस्तुकल्पनम् ।\nव्योमादिना सरूपाद्यैरन्यथात्मा प्रकल्प्यते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006052026, "chapter_id": 26052, "verse_number": "१-२३६-२७", "content_sanskrit": "प्रत्यक्षमपि यद्द्रव्यन्दुर्दर्शमिति भते ।\nव्योमादिना सरूपाद्यैरन्यथा कल्पितैस्तथा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006052027, "chapter_id": 26052, "verse_number": "१-२३६-२८", "content_sanskrit": "तथा हि रज्जुरुरगः शुक्तिः कारजतं यथा ।\nमृगतृष्णापथायाम्भस्तृप्तिं विष्णो तथा जगत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006052028, "chapter_id": 26052, "verse_number": "१-२३६-२९", "content_sanskrit": "हाहिष्णोद्विजा कथि द्भोहमितिदृ ।\nग्रहनाशात्पुनर्ध्यायन्ब्राह्मण्यं मन्यते यथा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006052029, "chapter_id": 26052, "verse_number": "१-२३६-३०", "content_sanskrit": "मायाविष्टस्तथा जीवो देहोहमिति मन्यते ।\nमायानाशात्पुनः स्वीयरूपं ब्रह्मास्मि मन्यते ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006052030, "chapter_id": 26052, "verse_number": "१-२३६-३१", "content_sanskrit": "ग्रहनाशाद्यथा मान्यजनोक्रूरमवेक्षते ।\nस्वरूपदर्शनाच्चायं माया नाशन्तया विना ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006052031, "chapter_id": 26052, "verse_number": "१-२३६-३२", "content_sanskrit": "अनादित्वं समं द्वाभ्यां स्वरूपं तद्विलक्म् ।\nएकः सत्यं तथा भागी विचारेण परं मृषा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006052032, "chapter_id": 26052, "verse_number": "१-२३६-३३", "content_sanskrit": "अजोपि हि सकृत्प्रेत्य संभवाम्यात्ममायया ।\nमायेच्छया द्विधा स स्यात्पतिः पत्नी सुखं जगत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006052033, "chapter_id": 26052, "verse_number": "१-२३६-३४", "content_sanskrit": "अष्टाविंशतिभेदैस्तु त्रैगुण्यं विद्यते पृथक। ।\nचतुरशीतिर्लक्ष्यन्ते नरनार्याकृतीनि च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006052034, "chapter_id": 26052, "verse_number": "१-२३६-३५", "content_sanskrit": "एषुविश्वं प्रभवति खण्डजं मायया यथा ।\nआदावन्ते च सन्त्येते नामरूपक्रियादयः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006052035, "chapter_id": 26052, "verse_number": "१-२३६-३६", "content_sanskrit": "सत्तावकल्पनं काले न सन्ति परमार्थतः ।\nयथा रथादयः स्वप्ने सन्तो नैव च सत्यतः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006052036, "chapter_id": 26052, "verse_number": "१-२३६-३७", "content_sanskrit": "तथा जाग्रदवस्थायां भूतानि न तु सन्निधौ ।\nद्वैरूप्यं मायया याति जाग्रत्स्वप्नपदज्ञ (क्ष) योः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006052037, "chapter_id": 26052, "verse_number": "१-२३६-३८", "content_sanskrit": "एवमेतत्परं ब्रह्म स्वप्नजाग्रत्पदवये ।\nसुषुप्तमचलं रूपमद्वयं पदमुच्यते ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006052038, "chapter_id": 26052, "verse_number": "१-२३६-३९", "content_sanskrit": "मायाविचारसिद्धैव विचारेण विलीयते ।\nआपातरहिता सापि कल्पना कालवर्तिनी ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006052039, "chapter_id": 26052, "verse_number": "१-२३६-४०", "content_sanskrit": "एवं तस्या (दात्या) त्मनादित्यं सिद्धमेकस सत्यजा ।\nसतोस्तित्वं वसातित्वादस्तित्वासत्यतां ततः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006052040, "chapter_id": 26052, "verse_number": "१-२३६-४१", "content_sanskrit": "ज्ञानं ततोप्यनन्तो नः पूर्णोन्तः शुकमात्मना ।\nन नित्यभावाज्जातोहमकृत्वादमृतोस्म्यहम् ।\nदीपवद्धृदये ज्योतिरहं ब्रह्मास्मि मुक्तये ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]