[{"id": 2007990, "chapter_id": 1153, "verse_number": "१-१५३४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2007991, "chapter_id": 1153, "verse_number": "१-१५४-१", "content_sanskrit": "कणिकस्य मतं श्रुत्वा कार्त्स्न्येन भरतर्षभ।\nदुर्योधनश्च कर्णश्च शकुनिश्चापि सौबलः।\nदुशासनचतुर्थास्ते मन्त्रयामासुरेकदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2007992, "chapter_id": 1153, "verse_number": "१-१५४-२", "content_sanskrit": "ते कौरव्यमनुज्ञाप्य धृतराष्ट्रं नराधिपम्।\nदहने तु सपुत्रायाः कुन्त्या बुद्धिमकारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2007993, "chapter_id": 1153, "verse_number": "१-१५४-३", "content_sanskrit": "तेषामिङ्गितभावज्ञो विदुरस्तत्त्वदर्शिवान्।\nआकारेण च तं मन्त्रं बुबुधे दुष्टचेतसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2007994, "chapter_id": 1153, "verse_number": "१-१५४-४", "content_sanskrit": "ततो विदितवेद्यात्मा पाण्डवानां हिते रतः।\nपलायने मतिं चक्रे कुन्त्याः पुत्रैः सहानघः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2007995, "chapter_id": 1153, "verse_number": "१-१५४-५", "content_sanskrit": "ततो वातसहां नावं यन्त्रयुक्तां पताकिनीम्।\nऊर्मिक्षमां दृढां कृत्वा कुन्तीमिदमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2007996, "chapter_id": 1153, "verse_number": "१-१५४-६", "content_sanskrit": "एष जातः कुलस्यास्य कीर्तिवंशप्रणाशनः।\nधृतराष्ट्रः परीतात्मा धर्मं त्यजति शाश्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2007997, "chapter_id": 1153, "verse_number": "१-१५४-७", "content_sanskrit": "इयं वारिपथे युक्ता तरङ्गपवनक्षमा।\nनौर्यया मृत्युपाशात्त्वं सपुत्रा मोक्ष्यसे शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2007998, "chapter_id": 1153, "verse_number": "१-१५४-८", "content_sanskrit": "तच्छ्रुत्वा व्यथिता कुन्ती पुत्रैः सह यशस्विनी।\nनावमारुह्य गङ्गायां प्रययौ भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2007999, "chapter_id": 1153, "verse_number": "१-१५४-९", "content_sanskrit": "ततो विदुरवाक्येन नावं विक्षिप्य पाण्डवाः।\nधनं चादाय तैर्दत्तमरिष्टं प्राविशन्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2008000, "chapter_id": 1153, "verse_number": "१-१५४-१०", "content_sanskrit": "निषादी पञ्चपुत्रा तु जातेषु तत्र वेश्मनि।\nकारणाभ्यागता दग्धा सह पुत्रैरनागसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2008001, "chapter_id": 1153, "verse_number": "१-१५४-११", "content_sanskrit": "स च म्लेच्छाधमः पापो दग्धस्तत्र पुरोचनः।\nवञ्चिताश्च दुरात्मानो धार्तराष्ट्राः सहानुगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2008002, "chapter_id": 1153, "verse_number": "१-१५४-१२", "content_sanskrit": "अविज्ञाता महात्मनो जनानामक्षतास्तथा।\nजनन्या सह कौन्तेया मुक्ता विदुरमन्त्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2008003, "chapter_id": 1153, "verse_number": "१-१५४-१३", "content_sanskrit": "ततस्तस्मिन्पुरे लोका नगरे वारणावते।\nदृष्ट्वा जतुगृहं दग्धमन्वशोचन्त दुःखिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2008004, "chapter_id": 1153, "verse_number": "१-१५४-१४", "content_sanskrit": "प्रेषयामासू राजानं यथावृत्तं निवेदितुम्।\nसंवृतस्ते महान्कामः पाण्डवान्दग्धवानसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2008005, "chapter_id": 1153, "verse_number": "१-१५४-१५", "content_sanskrit": "सकामो भव कौरव्य भुङ्क्ष्व राज्यं सपुत्रकः।\nतच्छ्रुत्वा धृतराष्ट्रस्तु सहपुत्रेण शोचयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2008006, "chapter_id": 1153, "verse_number": "१-१५४-१६", "content_sanskrit": "प्रेतकार्याणि च तथा चकार सह बान्धवैः।\nपाण्डवानां तथा क्षत्ता भीष्मश्च कुरुसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2008007, "chapter_id": 1153, "verse_number": "१-१५४-१७x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2008008, "chapter_id": 1153, "verse_number": "१-१५४-१७", "content_sanskrit": "पुनर्विस्तरशः श्रोतुमिच्छामि द्विजसत्तम।\nदाहं जतुगृहस्यैव पाण्डवानां च मोक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2008009, "chapter_id": 1153, "verse_number": "१-१५४-१८", "content_sanskrit": "सुनृशंसमिदं कर्म तेषां क्रूरोपसंहितम्।\nकीर्तयस्व यथावृत्तं परं कौतूहलं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2008010, "chapter_id": 1153, "verse_number": "१-१५४-१९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2008011, "chapter_id": 1153, "verse_number": "१-१५४-१९", "content_sanskrit": "शृणु विस्तरशो राजन्वदतो मे परन्तप।\nदाहं जतुगृहस्यैतत्पाण्डवानां च मोक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2008012, "chapter_id": 1153, "verse_number": "१-१५४-२०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2008013, "chapter_id": 1153, "verse_number": "१-१५४-२०", "content_sanskrit": "ततो दुर्योधनो राजा धृतराष्ट्रमभाषत।\nपाण्डवेभ्यो भयं नः स्यात्तान्विवासयतां भवान्।\nनिपुणेनाभ्युपायेन नगरं वारणावतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2008014, "chapter_id": 1153, "verse_number": "१-१५४-२१", "content_sanskrit": "धृतराष्ट्रस्तु पुत्रेण श्रुत्वा वचनमीरितम्।\nमुहूर्तमिव संचिन्त्य दुर्योधनमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2008015, "chapter_id": 1153, "verse_number": "१-१५४-२२", "content_sanskrit": "धर्मनित्यः सदा पाण्डुस्तथा धर्मपरायणः।\nसर्वेषु ज्ञातिषु तथा मयि त्वासीद्विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2008016, "chapter_id": 1153, "verse_number": "१-१५४-२३", "content_sanskrit": "नासौ किंचिद्विजानाति भोजनादिचिकीर्षितम्।\nनिवेदयति नित्यं हि मम राज्यं धृतव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2008017, "chapter_id": 1153, "verse_number": "१-१५४-२४", "content_sanskrit": "तस्य पुत्रो यथा पाण्डुस्तथा धर्मपरायणः।\nगुणवान्लोकविख्यातः पौरवाणां सुसंमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2008018, "chapter_id": 1153, "verse_number": "१-१५४-२५", "content_sanskrit": "स कथं शक्यतेऽस्माभिरपाकर्तुं बलादितः।\nपितृपैतामाहाद्राज्यात्ससहायो विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2008019, "chapter_id": 1153, "verse_number": "१-१५४-२६", "content_sanskrit": "भृता हि पाण्डुनाऽमात्या बलं च सततं भृतम्।\nभृताः पुत्राश्च पौत्राश्च तेषामपि विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2008020, "chapter_id": 1153, "verse_number": "१-१५४-२७", "content_sanskrit": "ते पुरा सत्कृतास्तात पाण्डुना नागरा जनाः।\nकथं युधिष्ठिरस्यार्थे न नो हन्युः सबान्धवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2008021, "chapter_id": 1153, "verse_number": "१-१५४-२८x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2008022, "chapter_id": 1153, "verse_number": "१-१५४-२८", "content_sanskrit": "एवमेतन्मया तात भावितं दोषमात्मनि।\nदृष्ट्वा प्रकृतयः सर्वा अर्थमानेन पूजिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2008023, "chapter_id": 1153, "verse_number": "१-१५४-२९", "content_sanskrit": "ध्रुवमस्मत्सहायास्ते भविष्यन्ति प्रधानतः।\nअर्थवर्गः सहामात्यो मत्संस्थोऽद्य महीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2008024, "chapter_id": 1153, "verse_number": "१-१५४-३०", "content_sanskrit": "स भवान्पाण्डवानाशु विवासयितुमर्हति।\nमृदुनैवाभ्युपायेन नगरं वारणावतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2008025, "chapter_id": 1153, "verse_number": "१-१५४-३१", "content_sanskrit": "यदा प्रतिष्ठितं राज्यं मयि राजन्भविष्यति।\nतदा कुन्ती सहापत्या पुनरेष्यति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2008026, "chapter_id": 1153, "verse_number": "१-१५४-३२x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2008027, "chapter_id": 1153, "verse_number": "१-१५४-३२", "content_sanskrit": "दुर्योधन ममाप्येतद्धृदि संपरिवर्तते।\nअभिप्रायस्य पापत्वान्नैवं तु विवृणोम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2008028, "chapter_id": 1153, "verse_number": "१-१५४-३३", "content_sanskrit": "न च भीष्मो न च द्रोणो न च क्षत्ता न गौतमः।\nविवास्यमानान्कौन्तेयाननुमंस्यन्ति कर्हिचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2008029, "chapter_id": 1153, "verse_number": "१-१५४-३४", "content_sanskrit": "समा हि कौरवेयाणां वयं ते चैव पुत्रक।\nनैते विषममिच्छेयुर्धर्मयुक्ता मनस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2008030, "chapter_id": 1153, "verse_number": "१-१५४-३५", "content_sanskrit": "ते वयं कौरवेयाणामेतेषां च महात्मनाम्।\nकथं न वध्यतां तात गच्छाम जगतस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2008031, "chapter_id": 1153, "verse_number": "१-१५४-३६x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2008032, "chapter_id": 1153, "verse_number": "१-१५४-३६", "content_sanskrit": "मध्यस्थः सततं भीष्मो द्रोणपुत्रो मयि स्थितः।\nयतः पुत्रस्ततो द्रोणो भविता नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2008033, "chapter_id": 1153, "verse_number": "१-१५४-३७", "content_sanskrit": "कृपः शारद्वतश्चैव यत एतौ ततो भवेत्।\nद्रोणं च भागिनेयं च न स त्यक्ष्यति कर्हिचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2008034, "chapter_id": 1153, "verse_number": "१-१५४-३८", "content_sanskrit": "क्षत्ताऽर्थबद्धस्त्वस्माकं प्रच्छन्नं संयतः परैः।\nन चैकः स समर्थोऽस्मान्पाम्डवार्थेऽधिबाधितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2008035, "chapter_id": 1153, "verse_number": "१-१५४-३९", "content_sanskrit": "सुविस्रब्धः पाण्डुपुत्रान्सह मात्रा प्रवासय।\nवारणावतमद्यैव यथा यान्ति यथा कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2008036, "chapter_id": 1153, "verse_number": "१-१५४-४०", "content_sanskrit": "विनिद्रकरणं घोरं हृदि शल्यमिवार्पितम्।\nशोकपावकमुद्भूतं कर्मणैतेन नाशय॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2008037, "chapter_id": 1153, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि जतुगृहपर्वणि चतुःपञ्चाशदधिकशततमोऽध्यायः॥ १५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]