[{"id": 2001126, "chapter_id": 1011, "verse_number": "१-१२-०x", "content_sanskrit": "रुरुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001127, "chapter_id": 1011, "verse_number": "१-१२-१", "content_sanskrit": "कथं हिंसितवान्सर्पान्स राजा जनमेजयः।\nसर्पा वा हिंसितास्तत्र किमर्थं द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001128, "chapter_id": 1011, "verse_number": "१-१२-२", "content_sanskrit": "किमर्थं मोक्षिताश्चैव पन्नगास्तेन धीमता।\nआस्तीकेन द्विजश्रेष्ठ श्रोतुमिच्छाम्यशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001129, "chapter_id": 1011, "verse_number": "१-१२-३x", "content_sanskrit": "ऋषिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001130, "chapter_id": 1011, "verse_number": "१-१२-३", "content_sanskrit": "श्रोष्यसि त्वं रुरो सर्वमास्तीकचरितं महत्।\nब्राह्मणानां कथयतां त्वरावान्गमने ह्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001131, "chapter_id": 1011, "verse_number": "१-१२-४x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001132, "chapter_id": 1011, "verse_number": "१-१२-४", "content_sanskrit": "इत्युक्त्वान्तर्हिते योगात्तस्मिन्नृषिवरे प्रभौ।\nसंभ्रमाविष्टहृदयो रुरुर्मेने तदद्भुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001133, "chapter_id": 1011, "verse_number": "१-१२-५", "content_sanskrit": "बलं परममास्थाय पर्यधावत्समन्ततः।\nतमृषिं नष्टमन्विच्छन्संश्रान्तो न्यपतद्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001134, "chapter_id": 1011, "verse_number": "१-१२-६", "content_sanskrit": "स मोहे परमं गत्वा नष्टसंज्ञ इवाभवत्।\nतदृषेर्वचनं तथ्यं चिन्तयानः पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001135, "chapter_id": 1011, "verse_number": "१-१२-७", "content_sanskrit": "लब्धसंज्ञो रुरुश्चायात्तदाचख्यौ पितुस्तदा।\nपित्रे तु सर्वमाख्याय डुण्डुभस्य वचोऽर्थवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001136, "chapter_id": 1011, "verse_number": "१-१२-८", "content_sanskrit": "अपृच्छत्पितरं भूयः सोस्तीकस्य वचस्तदा।\nआख्यापयत्तदाऽऽख्यानं डुण्डुभेनाथ कीर्तितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001137, "chapter_id": 1011, "verse_number": "१-१२-९", "content_sanskrit": "तत्कीर्त्यमानं भगवञ्श्रोतुमिच्छामि तत्त्वतः।\nपिता चास्य तदाख्यानं पृष्टः सर्वं न्यवेदयत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001138, "chapter_id": 1011, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि पौलोमपर्वणि द्वादशोऽध्यायः॥ १२ ॥\n॥ समाप्तं पौलोमपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]