[{"id": 2105035, "chapter_id": 3264, "verse_number": "१५-२-१", "content_sanskrit": "जनमेजय उवाच।\nकथं विनष्टा भगवन्नन्धका वृष्णिभिः सह।\nपश्यतो वासुदेवस्य भोजश्चैवक महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2105036, "chapter_id": 3264, "verse_number": "१५-२-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2105037, "chapter_id": 3264, "verse_number": "१५-२-२", "content_sanskrit": "षट्त्रिंशेऽथ ततो वर्षे वृष्णीनामनयो महान्।\nअन्योन्यं मुसलैस्ते तु निजघ्नुः कालचोदिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2105038, "chapter_id": 3264, "verse_number": "१५-२-३x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2105039, "chapter_id": 3264, "verse_number": "१५-२-३", "content_sanskrit": "केनानुशप्तास्ते वीराः क्षयं वृष्ण्यन्धका गताः।\nभोजाश्च द्विजवर्य त्वं विस्तरेण वदस्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2105040, "chapter_id": 3264, "verse_number": "१५-२-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2105041, "chapter_id": 3264, "verse_number": "१५-२-४", "content_sanskrit": "विश्वामित्रं च कण्वं च नारदं च तपोधनम्।\nसारणप्रमुखा वीरा ददृशुर्द्वारकां गतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2105042, "chapter_id": 3264, "verse_number": "१५-२-५", "content_sanskrit": "ते वै सांबं पुरस्कृत्य भूषयित्वा स्त्रियं यथा।\nअब्रुवन्नुपसङ्गम्य् दैवदण्डिनिपीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2105043, "chapter_id": 3264, "verse_number": "१५-२-६", "content_sanskrit": "इयं स्त्री पुत्रकामस्य बभ्रोरमिततेजसः।\nऋषयः साधु जानीत किमियं जनयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2105044, "chapter_id": 3264, "verse_number": "१५-२-७", "content_sanskrit": "इत्युक्तास्ते तदा राजन्विप्रलम्भप्रधर्षिताः।\nप्रत्यबुवंस्तान्मुनयो यत्तच्छृणु नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2105045, "chapter_id": 3264, "verse_number": "१५-२-८", "content_sanskrit": "वृष्ण्यन्धकविनाशाय मुसलं घोरमायसम्।\nवासुदेवस्य दायादः सांबोऽयं जनयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2105046, "chapter_id": 3264, "verse_number": "१५-२-९", "content_sanskrit": "येन यूयं सुदुर्वृत्ता नृशंसा जातमन्यवः।\nउच्छेत्तारः कुलं कृत्स्नमृते रामजनार्दनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2105047, "chapter_id": 3264, "verse_number": "१५-२-१०", "content_sanskrit": "समुद्रं यास्यति श्रीमांस्त्यक्त्वा देहं हलायुधः।\nजरःकृष्णं महात्मानं शयानं भुवि भेत्स्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2105048, "chapter_id": 3264, "verse_number": "१५-२-११", "content_sanskrit": "इत्यब्रुवंस्ततो राजन्प्रलब्धास्तैर्दुरात्मभिः।\nमुनयः क्रोधरक्ताक्षाः समीक्ष्याथ परस्परम्।\nतथोक्त्वा मुनयस्ते तु यथागतमथो ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2105049, "chapter_id": 3264, "verse_number": "१५-२-१२", "content_sanskrit": "अथाब्रवीत्तदा वृष्णीञ्श्रुत्वैतन्मधुसूदनः।\nअन्तज्ञो मतिमांस्तस्य भवितव्यं तथेति तान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2105050, "chapter_id": 3264, "verse_number": "१५-२-१३", "content_sanskrit": "एवमुक्त्वा हृषीकेशः प्रविवेश पुरं तदा।\nकृतान्तमन्यथा नैच्छत्कर्तुं स जगतः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2105051, "chapter_id": 3264, "verse_number": "१५-२-१४", "content_sanskrit": "श्वोभूतेऽथ ततः सांबो मुसलं तदसूकत वै।\nयेन वृष्णन्धककुले पुरुषा भस्मसात्कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2105052, "chapter_id": 3264, "verse_number": "१५-२-१५", "content_sanskrit": "वृष्ण्यन्धकविनाशाय किंकरप्रतिमं महत्।\nअसूत सापजं घोरं तच्च राज्ञे न्यवेदयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2105053, "chapter_id": 3264, "verse_number": "१५-२-१६", "content_sanskrit": "विषण्णरूपस्तद्राजा सूक्ष्मं चूर्णमकारयत्।\nतच्चूर्णं सागरे चापि प्राक्षिपन्पुरुषा नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2105054, "chapter_id": 3264, "verse_number": "१५-२-१७", "content_sanskrit": "अघोषयंश्च नगरे वचनादाहुकस्य ते।\nजनार्दनस्य रामस्य बभ्रोश्चैव महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2105055, "chapter_id": 3264, "verse_number": "१५-२-१८", "content_sanskrit": "अद्यप्रभृति सर्वेषु वृष्ण्यन्धककुलेष्विह।\nसुरासवो न कर्तव्यः, सर्वैर्नगरवासिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2105056, "chapter_id": 3264, "verse_number": "१५-२-१९", "content_sanskrit": "यश्च नो विदितं कुर्यात्पेयं कश्चिन्नरः क्वचित्।\nजीवन्स शूलमारोहेत्स्वयं कृत्वा सबान्धवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2105057, "chapter_id": 3264, "verse_number": "१५-२-२०", "content_sanskrit": "ततो राजभयात्सर्वे नियमं चक्रिरे तदा।\nनराः सासनमाज्ञाय तस्य राज्ञो महात्मनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2105058, "chapter_id": 3264, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते मौसलपर्वणि द्वितीयोऽध्यायः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]