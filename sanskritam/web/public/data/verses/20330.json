[{"id": 7000330000, "chapter_id": 20330, "verse_number": "२-२-१", "content_sanskrit": "सूत उवाच ।\nतदादाय महात्माऽसौ निर्जगाम त्वरान्वितः ।\nपितृभक्त्या तपोभिश्च सत्यार्जवबलेन सः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000330001, "chapter_id": 20330, "verse_number": "२-२-२", "content_sanskrit": "धर्ममाकृष्टवांश्चैव धर्मशर्मा ततस्तदा ।\nसमाकृष्टस्तु वै धर्मस्तपसा तस्य धीमतः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000330002, "chapter_id": 20330, "verse_number": "२-२-३", "content_sanskrit": "धर्मशर्माणमायातं इदं वचनमब्रवीत् ।\nकस्मात्त्वया समाहूतो धर्मशर्मन्समागतः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000330003, "chapter_id": 20330, "verse_number": "२-२-४", "content_sanskrit": "तन्मे कथय कार्यं त्वं तत्करोमि न संशयः ।\nधर्मशर्मोवाच ।\nयद्यस्ति गुरुशुश्रूषा यदि निष्ठाऽचलं तपः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000330004, "chapter_id": 20330, "verse_number": "२-२-५", "content_sanskrit": "तेन सत्येन मे धर्म वेदशर्मा स जीवतु ।\nधर्म उवाच ।\nदमशौचेन सत्येन तपसा तव सुव्रत॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000330005, "chapter_id": 20330, "verse_number": "२-२-६", "content_sanskrit": "पितृभक्त्या तव भ्राता वेदशर्मा महाभुजः ।\nपुनरेव महात्मासौ जीवनं च लभिष्यति॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000330006, "chapter_id": 20330, "verse_number": "२-२-७", "content_sanskrit": "तपसानेन तुष्टोस्मि पितृभक्त्या महामते ।\nवरं वरय भद्रं ते दुर्लभं धर्मवित्तमैः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000330007, "chapter_id": 20330, "verse_number": "२-२-८", "content_sanskrit": "एवमाकर्णितं तेन सुवाक्यं धर्मशर्मणा ।\nवैवस्वतं महात्मानं समुवाच महायशाः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000330008, "chapter_id": 20330, "verse_number": "२-२-९", "content_sanskrit": "देहि मे त्वचलां भक्तिं पितुः पादार्हणे पुनः ।\nधर्मे रतिं तथा मोक्षं सुप्रसन्नो यदा मम॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000330009, "chapter_id": 20330, "verse_number": "२-२-१०", "content_sanskrit": "तमुवाच ततो धर्मो मत्प्रसादाद्भविष्यति ।\nएवमुक्ते महावाक्ये वेदशर्मा तदोत्थितः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000330010, "chapter_id": 20330, "verse_number": "२-२-११", "content_sanskrit": "प्रसुप्तवन्महाप्राज्ञो धर्मशर्माणमब्रवीत् ।\nक्व सा देवी गता भ्रातः क्व स तातो भवेदिति॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000330011, "chapter_id": 20330, "verse_number": "२-२-१२", "content_sanskrit": "समासेन समाख्यातं यथा पित्रा नियोजितः ।\nसमाज्ञाय ततो हृष्टो धर्मशर्मा तमब्रवीत्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000330012, "chapter_id": 20330, "verse_number": "२-२-१३", "content_sanskrit": "ममाद्यैव महाभाग शिरसा जीवितेन च ।\nसंमुखी भव वै भ्रातः कोन्यो मे त्वादृशो भुवि॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000330013, "chapter_id": 20330, "verse_number": "२-२-१४", "content_sanskrit": "भ्रातरं चैवमाभाष्य उत्सुकः पितरं प्रति ।\nगमनाय मतिं चक्रे भ्रात्रा च धर्मशर्मणा॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000330014, "chapter_id": 20330, "verse_number": "२-२-१५", "content_sanskrit": "द्वावेतौ तु गतौ तत्र पितरं हृष्टमानसौ ।\nद्वाभ्यां तत्र समास्थाय शिवशर्माणमुत्तमम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000330015, "chapter_id": 20330, "verse_number": "२-२-१६", "content_sanskrit": "धर्मशर्मा तदोवाच पितरं दीप्तिसंयुतम् ।\nममाद्यैव महाभाग तपसा जीवितेन च॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000330016, "chapter_id": 20330, "verse_number": "२-२-१७", "content_sanskrit": "वेदशर्मा समानीतस्तं पुत्रं प्रगृहाण भोः ।\nशिवशर्मा ततो हृष्टो भक्तिं विज्ञाय तस्य च॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000330017, "chapter_id": 20330, "verse_number": "२-२-१८", "content_sanskrit": "न किंचिदब्रवीत्तं तु पुनश्चिंतामुपेयिवान् ।\nपुरतो विनयेनापि वर्तमानं महामतिम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000330018, "chapter_id": 20330, "verse_number": "२-२-१९", "content_sanskrit": "विष्णुशर्माणमाभाषीद्वत्स मे वचनं कुरु ।\nइंद्रलोकं व्रजस्वाद्य तस्मादानय चामृतम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000330019, "chapter_id": 20330, "verse_number": "२-२-२०", "content_sanskrit": "अनया कान्तया सार्द्धं स्थातुमिच्छामि सांप्रतम् ।\nसागराद्यत्समुत्पन्नममृतं व्याधिनाशनम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000330020, "chapter_id": 20330, "verse_number": "२-२-२१", "content_sanskrit": "साधुनेच्छति मामेषा यथैनां तु लभाम्यहम् ।\nतथा कुरुष्व शीघ्रं त्वमन्यथान्यं प्रयास्यति॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000330021, "chapter_id": 20330, "verse_number": "२-२-२२", "content_sanskrit": "वृद्धं ज्ञात्वावमन्येत इयं बाला सुरूपिणी ।\nअद्य देव्यानया सार्द्धं प्रियया भुवनत्रये॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000330022, "chapter_id": 20330, "verse_number": "२-२-२३", "content_sanskrit": "निर्दोषो व्याधिनिर्मुक्तो यथा तात भवाम्यहम् ।\nतथा कुरुष्व मे वत्स मद्भक्तोसि यदा भुवि॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000330023, "chapter_id": 20330, "verse_number": "२-२-२४", "content_sanskrit": "एवमाकर्ण्य तद्वाक्यं पितुस्तस्य महात्मनः ।\nविष्णुशर्मा तदोवाच पितरं दीप्ततेजसम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000330024, "chapter_id": 20330, "verse_number": "२-२-२५", "content_sanskrit": "सर्वमेतत्करिष्यामि भवतः सुखमुत्तमम् ।\nएवमाभाष्य धर्मात्मा विष्णुशर्मा महामतिः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000330025, "chapter_id": 20330, "verse_number": "२-२-२६", "content_sanskrit": "पितरं तं नमस्कृत्य पुनः कृत्वा प्रदक्षिणम् ।\nबलेन महता सोपि तपसा नियमेन च॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000330026, "chapter_id": 20330, "verse_number": "२-२-२७", "content_sanskrit": "अंतरिक्षगतश्चासीद्गच्छमानस्य धीमतः ।\nस महावायुवेगेन ऐंद्रं संप्रतिगच्छति॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]