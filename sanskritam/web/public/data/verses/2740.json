[{"id": 2082067, "chapter_id": 2740, "verse_number": "१२-२४५-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082068, "chapter_id": 2740, "verse_number": "१२-२४५-१", "content_sanskrit": "इत्युक्तोऽभिप्रशस्यैतत्परमर्षेस्तु शासनम्।\nमोक्षधर्मार्थसंयुक्तमिदं प्रष्टुं प्रचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082069, "chapter_id": 2740, "verse_number": "१२-२४५-२x", "content_sanskrit": "शुक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082070, "chapter_id": 2740, "verse_number": "१२-२४५-२", "content_sanskrit": "प्रजावाञ्श्रोत्रियो यज्वा कृतप्रज्ञोऽनसूयकः।\nअनागतमनैतिह्यं कथं ब्रह्माधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082071, "chapter_id": 2740, "verse_number": "१२-२४५-३", "content_sanskrit": "तपसा ब्रह्मचर्येण सर्वत्यागेन मेधया।\nसाङ्ख्ये वा यदि वा योग एतत्पृष्टो वदस्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2082072, "chapter_id": 2740, "verse_number": "१२-२४५-४", "content_sanskrit": "मनसश्चेन्द्रियाणां च यथैकाग्र्यमवाप्यते।\nयेनोपायेन पुरुषैस्तत्त्वं व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2082073, "chapter_id": 2740, "verse_number": "१२-२४५-५x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2082074, "chapter_id": 2740, "verse_number": "१२-२४५-५", "content_sanskrit": "नान्यत्र विद्यातपसोर्नान्यत्रेन्द्रियनिग्रहात्।\nनान्यत्र लोभसंत्यागात्सिद्धिं विन्दति कश्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2082075, "chapter_id": 2740, "verse_number": "१२-२४५-६", "content_sanskrit": "महाभूतानि सर्वाणि पूर्वसृष्टिः स्वयंभुवः।\nभूयिष्ठं प्राणभृत्काये निविष्टानि शरीरिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2082076, "chapter_id": 2740, "verse_number": "१२-२४५-७", "content_sanskrit": "भूमेर्देहो जलास्त्रोतो ज्योतिषश्चक्षुषी स्मृते।\nप्राणापानाश्रयो वायुः स्वेष्वाकाशं शरीरिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2082077, "chapter_id": 2740, "verse_number": "१२-२४५-८", "content_sanskrit": "क्रान्ते विष्णुर्बले शक्रः कोष्ठेऽग्निर्भोक्तुमिच्छति।\nकर्णयोः प्रदिशः श्रोत्रे जिह्वायां वाक् सरस्वती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2082078, "chapter_id": 2740, "verse_number": "१२-२४५-९", "content_sanskrit": "कर्णौ त्वक्चक्षुषी जिह्वा नासिका चैव पञ्चमी।\nदश तानीन्द्रियोक्तानि द्वाराण्याहारसिद्धये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2082079, "chapter_id": 2740, "verse_number": "१२-२४५-१०", "content_sanskrit": "शब्दः स्पर्शस्तथा रूपं रसो गन्धश्च पञ्चमः।\nइन्द्रियाणि पृथक्स्वार्थान्मनसा दर्शयन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2082080, "chapter_id": 2740, "verse_number": "१२-२४५-११", "content_sanskrit": "इन्द्रियाणि मनो युङ्क्ते वश्यान्यन्तेव वाजिनः।\nमनश्चापि सदा भुक्ते भूतात्मा हृदयाश्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2082081, "chapter_id": 2740, "verse_number": "१२-२४५-१२", "content_sanskrit": "इन्द्रियाणां तथैवैषां सर्वेषामीश्वरं मनः।\nनियमे च विसर्गे च भूतात्मा मानसस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2082082, "chapter_id": 2740, "verse_number": "१२-२४५-१३", "content_sanskrit": "इन्द्रियाणीन्द्रियार्थाश्च स्वभावश्चेतना मनः।\nप्राणापानौ च जीवश्च नित्यं देहेषु देहिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2082083, "chapter_id": 2740, "verse_number": "१२-२४५-१४", "content_sanskrit": "आश्रयो नास्ति सत्वस्य गुणः सत्त्वस्य चेतना।\nसत्वं हि तेजः सृजति न गुणान्वै कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2082084, "chapter_id": 2740, "verse_number": "१२-२४५-१५", "content_sanskrit": "एवं सप्तदशं देहे वृतं षोडशभिर्गुणैः।\nमनीषीमनसा विप्रः पश्यत्यात्मानमात्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2082085, "chapter_id": 2740, "verse_number": "१२-२४५-१६", "content_sanskrit": "न ह्ययं चक्षुषा दृश्यो न च सर्वैरपीन्द्रियैः।\nमनसा दीपभूतेन महानात्मा प्रकाशते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2082086, "chapter_id": 2740, "verse_number": "१२-२४५-१७", "content_sanskrit": "अशब्दस्पर्शरूपं तदरसागन्धमव्ययम्।\nअशरीरं शरीरेषु निरीक्षते निरिन्द्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2082087, "chapter_id": 2740, "verse_number": "१२-२४५-१८", "content_sanskrit": "अव्यक्तं सर्वदेहेषु मर्त्येष्वमृतमाहितम्।\nयोऽनुपश्यति स प्रेत्य कल्पते ब्रह्मभूयसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2082088, "chapter_id": 2740, "verse_number": "१२-२४५-१९", "content_sanskrit": "विद्याभिजनसंपन्ने ब्राह्मणे गवि हस्तिनि।\nशुनि चैव श्वपाके च पण्डिताः समदर्शिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2082089, "chapter_id": 2740, "verse_number": "१२-२४५-२०", "content_sanskrit": "स हि सर्वेषु भूतेषु जङ्गमेषु ध्रुवेषु च।\nवसत्येको महानात्मा येन सर्वमिदं ततम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2082090, "chapter_id": 2740, "verse_number": "१२-२४५-२१", "content_sanskrit": "सर्वभूतेषु चात्मानं सर्वभूतानि चात्मनि।\nयदा पश्यति भूतात्मा ब्रह्म संपद्यते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2082091, "chapter_id": 2740, "verse_number": "१२-२४५-२२", "content_sanskrit": "यावानात्मनि मे ह्यात्मा तावानात्मा परात्मनि।\nय एवं सततं वेद सोऽमृतत्वाय कल्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2082092, "chapter_id": 2740, "verse_number": "१२-२४५-२३", "content_sanskrit": "सर्वभूतात्मभूतस्य सर्वभूतहितस्य च।\nदेवाऽपि मार्गे मुह्यन्ति अपदस्य पदैषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2082093, "chapter_id": 2740, "verse_number": "१२-२४५-२४", "content_sanskrit": "शकुन्तानामिवाकाशे मत्स्यानामिव चोदके।\nयथा गतिर्न दृश्येत तथा ज्ञानविदां गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2082094, "chapter_id": 2740, "verse_number": "१२-२४५-२५", "content_sanskrit": "कालः पचति भूतानि सर्वाण्येवात्मनाऽऽत्मनि।\nयस्मिंस्तु पच्यते कालस्तं वेदेह न कश्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2082095, "chapter_id": 2740, "verse_number": "१२-२४५-२६", "content_sanskrit": "न स ऊर्ध्वं न तिर्यक्च नाधश्चरति यः पुनः।\nन मध्ये प्रतिगृह्णीते नैव किंचित्कुतश्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2082096, "chapter_id": 2740, "verse_number": "१२-२४५-२७", "content_sanskrit": "सर्वेऽन्तस्था इमे लोका बाह्यमेषां न किंचन।\nयः सहस्र समा गच्छेद्यथा बाणो गुणच्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2082097, "chapter_id": 2740, "verse_number": "१२-२४५-२८", "content_sanskrit": "नैवान्तं कारणस्येयाद्यद्यपि स्यान्मनोजवः।\nतस्मात्सूक्ष्मात्सूक्ष्मतरं नास्ति स्थूलतरं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2082098, "chapter_id": 2740, "verse_number": "१२-२४५-२९", "content_sanskrit": "सर्वतः पाणिपादं तत्सर्वतोक्षिशिरोमुखम्।\nसर्वतः श्रुतिमल्लोके सर्वमावृरत्य तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2082099, "chapter_id": 2740, "verse_number": "१२-२४५-३०", "content_sanskrit": "तदेवाणोरणुतरं तन्महद्भ्यो महत्तरम्।\nतदन्तः सर्वभूतानां ध्रुवं तिष्ठन्न दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2082100, "chapter_id": 2740, "verse_number": "१२-२४५-३१", "content_sanskrit": "अक्षरं च क्षरं चैव द्वैधीभावोऽयमात्मनः।\nक्षरः सर्वेषु भूतेषु दिवि ह्यमृतमक्षरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2082101, "chapter_id": 2740, "verse_number": "१२-२४५-३२", "content_sanskrit": "नवद्वारं पुरं गत्वा हंसो हि नियतो वशी।\nईशः सर्वस्य भूतस्य स्थावरस्य चरस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2082102, "chapter_id": 2740, "verse_number": "१२-२४५-३३", "content_sanskrit": "हानिभङ्गविकल्पानां नवानां संचयेन च।\nशरीराणामजस्याहुर्हंसत्वं पारदर्शिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2082103, "chapter_id": 2740, "verse_number": "१२-२४५-३४", "content_sanskrit": "हंसोक्तं चाक्षरं चैव कूटस्थं यत्तदक्षरम्।\nतद्विद्वानक्षरं प्राप्य जहाति प्राणजन्मनी॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2082104, "chapter_id": 2740, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि पञ्चचत्वारिंशदधिकद्विशततमोऽध्यायः॥ २४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]