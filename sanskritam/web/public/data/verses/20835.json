[{"id": 7000835000, "chapter_id": 20835, "verse_number": "६-१७८-१", "content_sanskrit": "श्रीभगवानुवाच ।\nचतुर्थस्यापि माहात्म्यमाख्यास्याम्यधुना शृणु ।\nबदरीत्वं समुत्सृज्य येन कन्ये दिवं गते॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000835001, "chapter_id": 20835, "verse_number": "६-१७८-२", "content_sanskrit": "श्रीरुवाच ।\nकथं कन्ये दिवं याते बदरीत्वं विसृज्य वै ।\nते कचास्तां पुरा देव कथं प्राप्ते तु मुख्यताम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000835002, "chapter_id": 20835, "verse_number": "६-१७८-३", "content_sanskrit": "एतद्वेदितुमिच्छामि नाथ वक्तुं त्वमर्हसि ।\nन तु तृप्यामि शृण्वंती परमां च कथामिमाम्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000835003, "chapter_id": 20835, "verse_number": "६-१७८-४", "content_sanskrit": "श्रीभगवानुवाच ।\nअस्ति भागीरथी तीरे नाम्ना वाराणसी पुरी ।\nभरतो नाम युक्तात्मा तत्र विश्वेश्वरालये॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000835004, "chapter_id": 20835, "verse_number": "६-१७८-५", "content_sanskrit": "नित्यमात्मरतस्तुर्यं जपत्यध्यायमादरात् ।\nतदभ्यासाददुष्टात्मा न द्वंद्वैरभिभूयते॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000835005, "chapter_id": 20835, "verse_number": "६-१७८-६", "content_sanskrit": "काले कदाचन क्रीडन्ययौ स नगराद्बहिः ।\nउपांत्यवर्तिनो देवान्दिदृक्षुः स तपोधनः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000835006, "chapter_id": 20835, "verse_number": "६-१७८-७", "content_sanskrit": "विशश्राम तयोर्मूले बदर्योर्न्यपतत्फले ।\nउपधाय तयोरेकामन्यामालंब्य चांघ्रिणा॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000835007, "chapter_id": 20835, "verse_number": "६-१७८-८", "content_sanskrit": "तपस्विनि ततो याते बदर्योश्च तथार्द्वयम् ।\nशुष्कं निष्पत्रशाखं च दिवसैः पंचषैरभूत्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000835008, "chapter_id": 20835, "verse_number": "६-१७८-९", "content_sanskrit": "गृहे क्वचन विप्राणां जज्ञाते कन्यके ततः ।\nवर्द्धमानं तयोर्युग्मं सप्तभिः परिवत्सरैः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000835009, "chapter_id": 20835, "verse_number": "६-१७८-१०", "content_sanskrit": "विहृत्य दूरदेशेभ्यो यतिमायांत मैक्ष्यत ।\nगृहीत्वा चरणौ तस्य वचः सूनृतमब्रवीत्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000835010, "chapter_id": 20835, "verse_number": "६-१७८-११", "content_sanskrit": "त्वत्प्रसादादेव मुने मोचितं द्वंद्वमावयोः ।\nउत्सृज्य बदरीभावं मानुष्यं प्रतिपद्यते॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000835011, "chapter_id": 20835, "verse_number": "६-१७८-१२", "content_sanskrit": "एवमुक्तो मुनिस्ताभ्यां विस्मृतः प्रत्युवाच सः ।\nकदा वत्से युवां केन हेतुना मोचिते मया॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000835012, "chapter_id": 20835, "verse_number": "६-१७८-१३", "content_sanskrit": "युवयोर्बदरीत्वे च हेतुं ब्रूतां न वेद्म्यहम् ।\nऊचतुः कन्यके तस्मै बादर्ये हेतुमात्मनः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000835013, "chapter_id": 20835, "verse_number": "६-१७८-१४", "content_sanskrit": "आदौ विमोचने तस्माद्दुस्त्यजादपि कारणम् ।\nअस्ति गोदावरी तीरे तीर्थं पुण्यप्रदं नृणाम्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000835014, "chapter_id": 20835, "verse_number": "६-१७८-१५", "content_sanskrit": "च्छिन्नपापमिति ख्यातं परां कोटिमवापयत् ।\nतत्र सत्यतपा नाम तपस्तेपे सुदारुणम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000835015, "chapter_id": 20835, "verse_number": "६-१७८-१६", "content_sanskrit": "ग्रीष्मे महति दीप्तानां मध्यगो जातवेदसाम् ।\nवर्षासु जलधाराभिर्नित्यमासिक्तमूर्द्धजः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000835016, "chapter_id": 20835, "verse_number": "६-१७८-१७", "content_sanskrit": "शिशिरे च वसन्नप्सु बिभ्रत्कंटकितां तनुम् ।\nविशुद्धः सततं काले तपस्तप्त्वा स संयमी॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000835017, "chapter_id": 20835, "verse_number": "६-१७८-१८", "content_sanskrit": "आत्मन्येव मतिं चक्रे परां प्राप्य सुनिर्वृतिम् ।\nसदा फलानि बिभ्रत्सु सांद्रच्छायेषु शाखिषु॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000835018, "chapter_id": 20835, "verse_number": "६-१७८-१९", "content_sanskrit": "निर्मत्सरेषु सत्वेषु बध्वा प्रीतिपरामपि ।\nतपःफलानुसंधाने वैदुष्येनोपपादितम्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000835019, "chapter_id": 20835, "verse_number": "६-१७८-२०", "content_sanskrit": "ब्रह्माप्येनं स्वयं पृच्छन्नुपतस्थे तमन्वहम् ।\nतेन संकोचहीनत्वाद्ब्रह्यण्यनुगतेन्वहम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000835020, "chapter_id": 20835, "verse_number": "६-१७८-२१", "content_sanskrit": "तद्ध्यानानुगतव्यक्ति ववृधे तस्य तत्तपः ।\nविमुक्तकल्पं मन्वानः समृद्धादात्मनः पदात्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000835021, "chapter_id": 20835, "verse_number": "६-१७८-२२", "content_sanskrit": "अंतरायशतं चक्रे ततो भीतः पुरंदरः ।\nआहूयाप्सरसां मध्यादावां तुल्यं समादिशत्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000835022, "chapter_id": 20835, "verse_number": "६-१७८-२३", "content_sanskrit": "कुरुतं तत्तपोविघ्नमनेनाचरितं युवाम् ।\nयो मां पदादवष्टभ्य स्वराज्यं भोक्तुमिच्छति॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000835023, "chapter_id": 20835, "verse_number": "६-१७८-२४", "content_sanskrit": "इति संदेशमापन्ने पुरस्ताच्च बिडौजसः ।\nगोदावरीमगच्छावः स मुनिर्यत्र वर्तते॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000835024, "chapter_id": 20835, "verse_number": "६-१७८-२५", "content_sanskrit": "मृदंगैर्मंदगंभीरैर्वेणुभिः कलवादिभिः ।\nकलं गीतं समारब्धं तन्वंगीभिः समन्वितम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000835025, "chapter_id": 20835, "verse_number": "६-१७८-२६", "content_sanskrit": "उद्वहंत्यौ पृथुश्रोणीं घनपीनपयोधरे ।\nस्मयस्मेरमुखांभोजे किंचिदाकुंचितालके॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000835026, "chapter_id": 20835, "verse_number": "६-१७८-२७", "content_sanskrit": "मणिकुंडलदृष्टांसे पुंडरीकोज्ज्वलेक्षणे ।\nतनुमध्ये सुवृत्तोरु वहंत्यौ च समे पदे॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000835027, "chapter_id": 20835, "verse_number": "६-१७८-२८", "content_sanskrit": "आनर्तां यो वनस्यार्थे स्वरताललयानुगाम् ।\nदर्शयंत्यौ स्वतः कृत्स्नां गतिं भावानुगामिनीम्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000835028, "chapter_id": 20835, "verse_number": "६-१७८-२९", "content_sanskrit": "मृदूपक्रममुत्पन्नं मंदं मंदं विवर्द्धनम् ।\nगर्जयामास दिक्चक्रं तत्तयोर्नृत्यमानयोः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000835029, "chapter_id": 20835, "verse_number": "६-१७८-३०", "content_sanskrit": "ततोंगहारवेगेन वायुर्वासः सुशीतलः ।\nईषदुच्छ्वसिते चैले दर्शयंत्यौ पयोधरौ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000835030, "chapter_id": 20835, "verse_number": "६-१७८-३१", "content_sanskrit": "उद्वर्धयंती कंदर्प्पमुल्बणा गतिरावयोः ।\nकोपमुत्पादयामासु मुने रविकृतात्मनः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000835031, "chapter_id": 20835, "verse_number": "६-१७८-३२", "content_sanskrit": "ततः शापं ददौ कोपाज्जलमुत्सृज्य पाणिना ।\nबदरीत्वं प्रपद्येथां जाह्नवी रोधसीति नौ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000835032, "chapter_id": 20835, "verse_number": "६-१७८-३३", "content_sanskrit": "आवाभ्यां पारतंत्र्येण यद्दुश्चरितमास्थितम् ।\nतत्क्षमस्व विनम्राभ्यां मुनिः पश्चात्प्रसादितः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000835033, "chapter_id": 20835, "verse_number": "६-१७८-३४", "content_sanskrit": "ततः शापविमोक्षं नौ कल्पयामास पुण्यधीः ।\nभरतागमनांतोयमिति सत्यतया मुनिः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000835034, "chapter_id": 20835, "verse_number": "६-१७८-३५", "content_sanskrit": "मर्त्येषु जन्मलाभश्च स्मृतिश्चातीतजन्मनाम् ।\nआवयोरंतिकं गत्वा बदरीभूतयोस्ततः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000835035, "chapter_id": 20835, "verse_number": "६-१७८-३६", "content_sanskrit": "स्मरता तुर्यमध्यायं भवता निष्कृतिः कृता ।\nतत्तावत्प्रणमावस्त्वां शापादेव न केवलात॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000835036, "chapter_id": 20835, "verse_number": "६-१७८-३७", "content_sanskrit": "घोरादेव तु संसारात्त्वयैतेन विमोचिते ।\nश्रीभगवानुवाच ।\nएवमुक्तो मुनिस्ताभ्यामतिप्रीतमनास्ततः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000835037, "chapter_id": 20835, "verse_number": "६-१७८-३८", "content_sanskrit": "पूजितस्ते समामंत्र्य यथागतमसौ ययौ ।\nकन्ये चतुर्थमध्यायं जपेतां नित्यमादरात्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]