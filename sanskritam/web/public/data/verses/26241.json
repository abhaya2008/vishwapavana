[{"id": 7006241000, "chapter_id": 26241, "verse_number": "२-६९-१", "content_sanskrit": "सूत उवाच यदोर्वंशं प्रवक्ष्यामि ज्येष्ठस्योत्तमतेजसः ।\nविस्तरेणानुपूर्व्या च गदतो मे निबोधत ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006241001, "chapter_id": 26241, "verse_number": "२-६९-२", "content_sanskrit": "यदोः पुत्रा बभूवुर्हि पञ्च देवसुतोपमाः ।\nसहस्रजिदथ श्रेष्ठः क्रोष्टुर्नीलोञ्जिको लघुः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006241002, "chapter_id": 26241, "verse_number": "२-६९-३", "content_sanskrit": "सहस्रजित्सुतः श्रीमाञ्छतजिन्नाम पार्थिवः ।\nशतजित्तनयाः ख्यातस्त्रयः परमधार्मिकाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006241003, "chapter_id": 26241, "verse_number": "२-६९-४", "content_sanskrit": "हैहयश्च हयस्छैव राजा वेणु हयस्तथा ।\nहैहयस्य तु दायादो धर्मनेत्र इति श्रुतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006241004, "chapter_id": 26241, "verse_number": "२-६९-५", "content_sanskrit": "धर्मनेत्रस्य कुन्तिस्तु संक्षेयस्तस्य चात्मजः ।\nसंज्ञेयस्य तु दायादो महिष्मान्नाम पार्थिवः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006241005, "chapter_id": 26241, "verse_number": "२-६९-६", "content_sanskrit": "आसीन्महिष्मतः पुत्रो भद्रमेनः प्रतापवान् ।\nवाराणस्यधिपो राजा कथितः पूर्व एव हि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006241006, "chapter_id": 26241, "verse_number": "२-६९-७", "content_sanskrit": "भद्र सेनस्य दायादो दुर्मदो नाम पार्थिवः ।\nदुर्मदस्यसुतो धीमान्कनको नाम विश्रुतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006241007, "chapter_id": 26241, "verse_number": "२-६९-८", "content_sanskrit": "कनकस्य तु दायादाश्चत्वारो लोकविश्रुताः ।\nकृतवीर्यः कृताग्निश्च कृतवर्मा तथैव च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006241008, "chapter_id": 26241, "verse_number": "२-६९-९", "content_sanskrit": "कृतौजाश्च चतुर्थोऽभूत्कृतवीर्यात्मजोर्ऽजुनः ।\nजज्ञे बाहुसहस्रेण सप्तद्वीपेश्वरो नृपः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006241009, "chapter_id": 26241, "verse_number": "२-६९-१०", "content_sanskrit": "स हि वर्षायुतं तप्त्वा तपः परमदुश्चरम् ।\nदत्तमाराधयामास कार्त्तवीर्योऽत्रिसंभवम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006241010, "chapter_id": 26241, "verse_number": "२-६९-११", "content_sanskrit": "तस्मै दत्तो वरान्प्रादाच्च तुरो भूरितेजसः ।\nपूर्वं बाहुसहस्रं तु स वव्रे प्रथमं वरम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006241011, "chapter_id": 26241, "verse_number": "२-६९-१२", "content_sanskrit": "अधर्मं ध्यायमानस्य सहसास्मान्निवारणम् ।\nधर्मेण पृथिवीं जित्वा धर्मेणैवानुपालनम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006241012, "chapter_id": 26241, "verse_number": "२-६९-१३", "content_sanskrit": "संग्रामांस्तु बहुञ्जित्वा हत्वा चारीन्सहस्रशः ।\nसंग्रामे युध्यमानस्य वधः स्यात्प्रधने मम ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006241013, "chapter_id": 26241, "verse_number": "२-६९-१४", "content_sanskrit": "तेनेयं पृथिवी कृत्स्ना सप्तद्वीपा सपत्तना ।\nसप्तोदधिपरिक्षिप्ता क्षत्रेण विधिना जिता ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006241014, "chapter_id": 26241, "verse_number": "२-६९-१५", "content_sanskrit": "तस्य बाहुसहस्रं तु युध्यतः किलयोगतः ।\nयोगो योगेश्वरस्येव प्रादुर्भवति मायया ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006241015, "chapter_id": 26241, "verse_number": "२-६९-१६", "content_sanskrit": "तेन सप्तसु द्वीपेषु सप्तयज्ञशतानि वै ।\nकृतानि विधिना राज्ञा श्रूयते मुनिसत्तमाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006241016, "chapter_id": 26241, "verse_number": "२-६९-१७", "content_sanskrit": "सर्वे यज्ञा महाबाहोस्तस्यामन्भूरितेजसः ।\nसर्वे काञ्चनवेदीकाः सर्वे यूपैश्च काञ्चनैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006241017, "chapter_id": 26241, "verse_number": "२-६९-१८", "content_sanskrit": "सर्वैर्देवैर्महाभागै र्विमानस्थैरलङ्कृताः ।\nगन्धर्वैरप्सरोभिश्च नित्यमेवोपशोभिताः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006241018, "chapter_id": 26241, "verse_number": "२-६९-१९", "content_sanskrit": "तस्य राज्ञो जगौ गाथां गन्धर्वो नारदस्तदा ।\nचरितं तस्य राजर्षेर्महिमानं निरीक्ष्य च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006241019, "chapter_id": 26241, "verse_number": "२-६९-२०", "content_sanskrit": "न नूनं कार्त्तवीर्यस्य गतिं यास्यन्ति मानवाः ।\nयज्ञैर्दानैस्तपोभिश्च विक्रमेण श्रुतेन च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006241020, "chapter_id": 26241, "verse_number": "२-६९-२१", "content_sanskrit": "द्वीपेषु सप्तसु स वै धन्वी खड्गी शारासनी ।\nरथी राजा सानुचरो योगाच्चैवानुदृश्यते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006241021, "chapter_id": 26241, "verse_number": "२-६९-२२", "content_sanskrit": "अनष्टद्रव्यता चासीन्न क्लेशो न च विभ्रमः ।\nप्रभावेण महाराज्ञः प्रजा धर्मेण रक्षितः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006241022, "chapter_id": 26241, "verse_number": "२-६९-२३", "content_sanskrit": "पञ्चाशीतिसहस्राणि वर्षाणां स नराधिपः ।\nस सर्वरत्नभाक्स म्राट्चक्रवर्ती बभूव ह ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006241023, "chapter_id": 26241, "verse_number": "२-६९-२४", "content_sanskrit": "स एष पशुपालोऽभूत्क्षेत्रपालस्तथै व च ।\nस एव वृष्ट्या पर्जन्यो योगित्वादर्जुनोऽभवत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006241024, "chapter_id": 26241, "verse_number": "२-६९-२५", "content_sanskrit": "स वे बाहुसहस्रेण ज्याघातकठिनेन च ।\nभाति रश्मिसहस्रेण शारदेनैव भास्करः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006241025, "chapter_id": 26241, "verse_number": "२-६९-२६", "content_sanskrit": "स हि नागसहक्रेण माहिष्मत्यां नराधिपः ।\nकर्कोटकसभां जित्वा पुरीं तत्र न्यवेशयत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006241026, "chapter_id": 26241, "verse_number": "२-६९-२७", "content_sanskrit": "स वै वेगं समुद्रस्य प्रावृट्कालेंबुजेक्षणः ।\nक्रीडन्नेव सुखोद्विग्नः प्रावृट्कालं चकार ह ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006241027, "chapter_id": 26241, "verse_number": "२-६९-२८", "content_sanskrit": "लुलिता क्रीडता तेन हेमस्रग्दाममालिनी ।\nऊर्मिमुक्तार्त्तसन्नादा शङ्किताभ्येति नर्मदा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006241028, "chapter_id": 26241, "verse_number": "२-६९-२९", "content_sanskrit": "पुरा भुज सहस्रेण स जगाहे महार्मवम् ।\nचकारोद्वृत्तवेलं तमकाले मारुतोद्धतम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006241029, "chapter_id": 26241, "verse_number": "२-६९-३०", "content_sanskrit": "तस्य बाहुसहस्रेण क्षोभ्यमाणे महोदधौ ।\nभवन्ति लीना निश्चेष्टाः पातालस्था महासुराः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006241030, "chapter_id": 26241, "verse_number": "२-६९-३१", "content_sanskrit": "चूर्णीकृतमहावीचिलीनमीनमहाविषम् ।\nपतिताविद्धफेनौघमावर्त्तक्षिप्तदुस्सहम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006241031, "chapter_id": 26241, "verse_number": "२-६९-३२", "content_sanskrit": "चकार क्षोभयन्राजा दोःसहस्रेण सागरम् ।\nदेवासुरपरिक्षिप्तं क्षीरोदमिव सागरम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006241032, "chapter_id": 26241, "verse_number": "२-६९-३३", "content_sanskrit": "मन्दरक्षोभणभ्रान्तममृतोत्पत्ति हेतवे ।\nसहसा विद्रुता भीता भीमं दृष्ट्वा नृपोत्तमम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006241033, "chapter_id": 26241, "verse_number": "२-६९-३४", "content_sanskrit": "निश्चितं नतमूर्द्धानो बभूवुश्च महोरगाः ।\nसायाह्ने कदलीखञ्च निवातेस्तमिता इव ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006241034, "chapter_id": 26241, "verse_number": "२-६९-३५", "content_sanskrit": "ज्यामारोप्य दृढे चापे सायकैः पञ्चभिः शतैः ।\nलङ्केशं मोहयित्वा तु सबलं रावणं बलात् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006241035, "chapter_id": 26241, "verse_number": "२-६९-३६", "content_sanskrit": "निर्जित्य वशमानीय माहिष्मत्यां बबन्ध तम् ।\nततो गत्वा पुलस्त्यस्तमर्जुनं च प्रसाधयत् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006241036, "chapter_id": 26241, "verse_number": "२-६९-३७", "content_sanskrit": "मुमोच राजा पौलस्त्यं पुलस्त्येना नुयाचितः ।\nतस्य बाहुसहस्रस्य बभूव ज्यातलस्वनः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006241037, "chapter_id": 26241, "verse_number": "२-६९-३८", "content_sanskrit": "युगान्तेंबुदवृन्दस्य स्फुटितस्याशनेरिव ।\nअहो मृधे महावीर्यो भार्गवस्तस्य योऽच्छिनत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006241038, "chapter_id": 26241, "verse_number": "२-६९-३९", "content_sanskrit": "मृधे सहस्रं बाहुनां हेमतालवनं यथा ।\nतृषितेन कदाचित्स भिक्षितश्चित्रभानुना ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006241039, "chapter_id": 26241, "verse_number": "२-६९-४०", "content_sanskrit": "सप्तद्वीपांश्चित्रभानोः प्रादद्भिक्षां विशांपतिः ।\nपुराणि घोषान्ग्रामांश्च पत्तनानि च सर्वशः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006241040, "chapter_id": 26241, "verse_number": "२-६९-४१", "content_sanskrit": "जज्वाल तस्य बाणेषु चित्राभानुर्दिधक्षया ।\nस तस्य पुरुषेन्द्रस्य प्रतापेन महायशाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006241041, "chapter_id": 26241, "verse_number": "२-६९-४२", "content_sanskrit": "ददाह कार्त्तवीर्यस्य शैलांश्चापि वनानि च ।\nस शून्यमाश्रमं सर्वं वरुणस्यात्मजस्य वै ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006241042, "chapter_id": 26241, "verse_number": "२-६९-४३", "content_sanskrit": "ददाह सवनाटोपं चित्रभानुः स हैहयः ।\nयं लेभे वरुणः पुत्रं पुरा भास्वन्तमुत्तमम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006241043, "chapter_id": 26241, "verse_number": "२-६९-४४", "content_sanskrit": "वसिष्ठनामा स मुनिः ख्यात आपव इत्युत ।\nतत्रापवस्तदा क्रोधादर्जुनं शप्तवान्विभुः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006241044, "chapter_id": 26241, "verse_number": "२-६९-४५", "content_sanskrit": "यस्मान्नवर्जितमिदं वनं ते मम हैहय ।\nतस्मात्ते दुष्करं कर्म कृतमन्यो हनिष्यति ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006241045, "chapter_id": 26241, "verse_number": "२-६९-४६", "content_sanskrit": "अर्जुनो नाम कैन्तेयः स च राजा भविष्यति ।\nअर्जुनं च महावीर्यो रामः प्रहरतां वरः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006241046, "chapter_id": 26241, "verse_number": "२-६९-४७", "content_sanskrit": "छित्त्वा बाहुसहस्रं वै प्रमथ्य तरसा बली ।\nतपस्वी ब्राह्मणश्चैव वधिष्यति महाबलः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006241047, "chapter_id": 26241, "verse_number": "२-६९-४८", "content_sanskrit": "तस्य रामस्तदा ह्यासीन्मृत्युः शापेन धीमतः ।\nराज्ञा तेन वरश्चैव स्वयमेव वृतः पुरा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006241048, "chapter_id": 26241, "verse_number": "२-६९-४९", "content_sanskrit": "तस्य पुत्रशतं त्वासीत्पञ्च तत्र महारथाः ।\nकृतास्त्रा बलिनः शूरा धर्मात्मानो यशस्विनः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006241049, "chapter_id": 26241, "verse_number": "२-६९-५०", "content_sanskrit": "शूरश्च शूरसेनश्च वृषास्यो वृष एव च ।\nजयध्वजो वंशकर्त्ता अवन्तिषु विशांपतिः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006241050, "chapter_id": 26241, "verse_number": "२-६९-५१", "content_sanskrit": "जयध्वजस्य पुत्रस्तु तालजङ्घः प्रतापवान् ।\nतस्य पुत्रशतं त्वेवं तालजङ्घा इतिश्रुतम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006241051, "chapter_id": 26241, "verse_number": "२-६९-५२", "content_sanskrit": "तेषां पञ्च गणाः ख्याता हैहयानां महात्मनाम् ।\nवीतिहोत्राश्च संजाता भोजाश्चावन्तयस्तथा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006241052, "chapter_id": 26241, "verse_number": "२-६९-५३", "content_sanskrit": "तुण्डिकेराश्च विक्रान्तास्तालजङ्घास्तथैव च ।\nवीतिहोत्रसुतश्चापि अनन्तो नाम पार्थिवः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006241053, "chapter_id": 26241, "verse_number": "२-६९-५४", "content_sanskrit": "दुर्जयस्तस्य पुत्रस्तु बभूवामित्रकर्शनः ।\nअनष्ट द्रव्यता चैव तस्य राज्ञो बभूव ह ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006241054, "chapter_id": 26241, "verse_number": "२-६९-५५", "content_sanskrit": "प्रभावेण महाराजः प्रजास्ताः पर्यपालयत् ।\nन तस्य वित्तनाशः स्यान्नष्टं प्रतिलभेच्च सः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006241055, "chapter_id": 26241, "verse_number": "२-६९-५६", "content_sanskrit": "कार्त्तवीर्यस्य यो जन्म कथयेदिह धीमतः ।\nवर्द्धन्ते विभवाश्शश्वद्धर्मश्चास्य विवर्द्धते ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006241056, "chapter_id": 26241, "verse_number": "२-६९-५७", "content_sanskrit": "यथा यष्टा यथा दाता तथा स्वर्गे महीपते ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]