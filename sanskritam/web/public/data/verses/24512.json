[{"id": 7004512000, "chapter_id": 24512, "verse_number": "५-३-२०६-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nगच्छेत्ततः क्षोणिनाथ तीर्थं परमशोभनम् ।\nसर्वपापहरं पुण्यं दशकन्येति विश्रुतम् ।\nमहादेवकृतं पुण्यं सर्वकामफलप्रदम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004512001, "chapter_id": 24512, "verse_number": "५-३-२०६-२", "content_sanskrit": "तत्र तीर्थे महादेवो दशकन्या गुणान्विताः ।\nब्रह्मणो वरयामास ह्युद्वाहेन युयोज ह॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004512002, "chapter_id": 24512, "verse_number": "५-३-२०६-३", "content_sanskrit": "तदाप्रभृति तत्तीर्थं दशकन्येति विश्रुतम् ।\nसर्वपापहरं पुण्यमक्षयं कीर्तितं फलम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004512003, "chapter_id": 24512, "verse_number": "५-३-२०६-४", "content_sanskrit": "तत्र तीर्थे तु यः कन्यां ददाति समलंकृताम् ।\nप्राप्नोति पुरुषो दत्त्वा यथाशक्त्या स्वलंकृताम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004512004, "chapter_id": 24512, "verse_number": "५-३-२०६-५", "content_sanskrit": "तेन दानोत्थपुण्येन पूतात्मानो नराधिप ।\nवसन्ति रोमसंख्यानि वर्षाणि शिवसन्निधौ॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004512005, "chapter_id": 24512, "verse_number": "५-३-२०६-६", "content_sanskrit": "ततः कालेन महता त्विह लोके नरेश्वर ।\nमानुष्यं प्राप्य दुष्प्राप्यं धनकोटीपतिर्भवेत्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004512006, "chapter_id": 24512, "verse_number": "५-३-२०६-७", "content_sanskrit": "तत्र तीर्थे तु यो भक्त्या स्नात्वा विप्राय काञ्चनम् ।\nसम्प्रयच्छति शान्ताय सोऽत्यन्तं सुखमश्नुते॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004512007, "chapter_id": 24512, "verse_number": "५-३-२०६-८", "content_sanskrit": "वाचिकं मानसं वापि कर्मजं यत्पुरा कृतम् ।\nतत्सर्वं विलयं याति स्वर्णदानेन भारत॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004512008, "chapter_id": 24512, "verse_number": "५-३-२०६-९", "content_sanskrit": "नरो दत्त्वा सुवर्णं चापि वालाग्रमात्रकम् ।\nतत्र तीर्थे दिवं याति मृतो नास्त्यत्र संशयः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004512009, "chapter_id": 24512, "verse_number": "५-३-२०६-१०", "content_sanskrit": "तत्र विद्याधरैः सिद्धैर्विमानवरमास्थितः ।\nपूज्यमानो वसेत्तावद्यावदाभूतसम्प्लवम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]