[{"id": 7005485000, "chapter_id": 25485, "verse_number": "२-२-१", "content_sanskrit": "आत्मतत्त्वके स्वरुपका निरुपण सांख्य, एवं योगके ज्ञानका अभेद आत्मसाक्षात्कारके साधनोंका वर्णन", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005485001, "chapter_id": 25485, "verse_number": "२-२-२", "content_sanskrit": "ईश्वर उवाच ।\nअवाच्यमेतद विज्ञानमात्मगुह्मां सनातनम ।\nयन्न देवा विजानन्ति यतन्तोऽपि द्विजतयः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005485002, "chapter_id": 25485, "verse_number": "२-२-३", "content_sanskrit": "इदं ज्ञानं समाश्रित्य ब्रह्माभुता द्विजोत्तमाः ।\nन संसारं प्रपद्यन्ते पूर्वेऽति ब्रह्मावादिनः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005485003, "chapter_id": 25485, "verse_number": "२-२-४", "content_sanskrit": "गुह्माद गुह्मातमं साक्षद गोपनीय प्रयत्नत ।\nवक्ष्ये भक्तिमतामद्य युष्माकं ब्रह्मवादिनाम ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005485004, "chapter_id": 25485, "verse_number": "२-२-५", "content_sanskrit": "आत्मा यः केवल स्वस्थ शान्त सुक्ष्मः सनातनः ।\nअस्ति सर्वान्तरह साक्शच्चित्रस्तमसः परः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005485005, "chapter_id": 25485, "verse_number": "२-२-६", "content_sanskrit": "सोऽन्तर्यामी स पुरुषः स प्रणः स महेश्वरः ।\nस कालोऽग्निस्तद्वयक्तं स एवेदमिति श्रुतिः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005485006, "chapter_id": 25485, "verse_number": "२-२-७", "content_sanskrit": "अस्माद विजायते विश्वमत्रैव प्रविलीययते ।\nस मायी मायाय बद्ध करोति विविधास्तनुः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005485007, "chapter_id": 25485, "verse_number": "२-२-८", "content_sanskrit": "न चाप्ययं संसरति न च संसारयेत प्रभुः ।\nनायं पृथ्वी न सलिलं न तेजः पवनो नभः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005485008, "chapter_id": 25485, "verse_number": "२-२-९", "content_sanskrit": "न प्राणो न मनो‍ऽव्यक्तं न शब्दः स्पर्श एव च ।\nन रुपर्सन्धाश्च नाहं कर्ता न वागापि ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005485009, "chapter_id": 25485, "verse_number": "२-२-१०", "content_sanskrit": "न पाणीपादौ नो पयुर्न चोपस्थं द्विजोत्तमाः ।\nन कर्ता न च भोक्ता वा न च प्रकृतिपुरुषौ ।\nन माया नैव च प्राणश्‍चैवन्य परमार्थतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005485010, "chapter_id": 25485, "verse_number": "२-२-११", "content_sanskrit": "यथा प्रकाशतमसोः सम्बन्धो नोपपद्यते ।\nतद्वदैक्यं न सम्बन्धः प्रपच्चपमात्मनो ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005485011, "chapter_id": 25485, "verse_number": "२-२-१२", "content_sanskrit": "छयापतौ यथा लोके परस्पविलक्षणौ ।\nतद्वत प्रपचंपुरुषौ विभिन्नौ परमार्थतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005485012, "chapter_id": 25485, "verse_number": "२-२-१३", "content_sanskrit": "यद्यात्मा मलिनोऽस्वस्थो विकारी स्यात स्वभावतः ।\nनही तस्य भवेन्मुक्तिर्जन्मान्तरशतैरपि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005485013, "chapter_id": 25485, "verse_number": "२-२-१४", "content_sanskrit": "पश्यन्ति मुनयो युक्ता स्वात्मानं परमार्थतः ।\nविकराहिनं निर्दुःखमानन्दाम्त्मानमव्ययम ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005485014, "chapter_id": 25485, "verse_number": "२-२-१५", "content_sanskrit": "अहं कर्ता सुखी दुःखी कृशः स्थुलेति या मतिः ।\nसा चाहंकारकर्तृतादात्मन्यारोप्यते जनैः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005485015, "chapter_id": 25485, "verse_number": "२-२-१६", "content_sanskrit": "वदन्ति वेदविद्वंसा साक्षिणं प्रकृते परम ।\nभोक्ता रमक्षरं शुद्धं सर्वत्र समावस्थित ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005485016, "chapter_id": 25485, "verse_number": "२-२-१७", "content_sanskrit": "तस्मादज्ञानमुलो हि संसारः सर्वदेहिनाम ।\nअज्ञानादन्यथा ज्ञानं तच्च प्रकृतिसंगतम ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005485017, "chapter_id": 25485, "verse_number": "२-२-१८", "content_sanskrit": "नित्योदितः स्वयं ज्योति सर्वगः पुरुषः परः ।\nअहंकाराविवेकेन कर्ताहमिति मन्यते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005485018, "chapter_id": 25485, "verse_number": "२-२-१९", "content_sanskrit": "पश्यन्ति ऋषयोंऽव्यक्तं नित्यं सदसदत्मकम ।\nप्रधानं प्रकृति बुद्धवां कारणं ब्रह्मावादिनः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005485019, "chapter_id": 25485, "verse_number": "२-२-२०", "content_sanskrit": "तेनायं संगतो ह्यत्मा कुटस्थोऽपि निरत्र्जनः ।\nस्वात्मानमक्षरं ब्रह्मा नावबुद्धयेत तत्वतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005485020, "chapter_id": 25485, "verse_number": "२-२-२१", "content_sanskrit": "अनात्मन्यात्मविज्ञानं तस्माद दुखःअं तथेतरम ।\nरागद्वेषादयो दोषाः सर्वे भ्रान्तिनिबन्धनाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005485021, "chapter_id": 25485, "verse_number": "२-२-२२", "content_sanskrit": "कर्मण्यस्य भवेद दोषः पुण्यापुण्यमिति स्थितिः ।\nतद्वशादेव सर्वेषां सर्वेदेहसमुद्धवः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005485022, "chapter_id": 25485, "verse_number": "२-२-२३", "content_sanskrit": "नित्यः सर्वत्रयो ह्मात्मा कुटस्थो दोषवर्जितः ।\nएकः स भिद्यते शक्या मायया न स्वभावतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005485023, "chapter_id": 25485, "verse_number": "२-२-२४", "content_sanskrit": "तस्मादवैतमैवाहुर्मुनयः परमार्थतः ।\nभेदो व्यक्तस्वभावेन सा च मायात्मसंश्रया ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005485024, "chapter_id": 25485, "verse_number": "२-२-२५", "content_sanskrit": "यथा ही धुमसम्पर्कान्नाकाशो मलिनो भवेत ।\nअन्तः करणजैर्भावैरात्मा तवन्न लिप्यते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005485025, "chapter_id": 25485, "verse_number": "२-२-२६", "content_sanskrit": "यथा स्वप्रभया भाति केवलः स्फटिकोऽमलः ।\nउपाधिहीनो विमलस्तथैवात्मा प्रकाशते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005485026, "chapter_id": 25485, "verse_number": "२-२-२७", "content_sanskrit": "ज्ञानस्वरुपमेवाहुर्जगदेतद विचक्षणाः ।\nअर्थस्वरुपमेवाज्ञाः पश्यन्त्यन्ये कुदुष्तयः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005485027, "chapter_id": 25485, "verse_number": "२-२-२८", "content_sanskrit": "कुटस्थो निर्गुणा व्यापी चैतन्यात्मा स्वभावतः ।\nदृश्यते ह्रार्थररुपेण पुरुषैर्भ्रान्तदृष्टिभिः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005485028, "chapter_id": 25485, "verse_number": "२-२-२९", "content_sanskrit": "यथा संलक्ष्यते रक्तः केवलः स्फटिको जनैः ।\nरक्तिकाद्युपधानेन तद्वत परमपुरुषच ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005485029, "chapter_id": 25485, "verse_number": "२-२-३०", "content_sanskrit": "तस्मादात्माक्षरं शुद्धो नित्यः सर्वगतोऽव्ययः ।\nउपासितव्यों मन्तव्यः श्रोतव्यश्च मुमुक्षुभिः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005485030, "chapter_id": 25485, "verse_number": "२-२-३१", "content_sanskrit": "यदा मनासि चैतन्य भाति सर्वत्रगं सदा ।\nयोगिनोऽव्यवधानेन तदा सम्पद्यते स्वयम ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005485031, "chapter_id": 25485, "verse_number": "२-२-३२", "content_sanskrit": "यदा सर्वाणि भुतानि स्वात्मन्येवाभिपस्याति ।\nसर्वभुतेषु चात्मानं ब्रह्मां सम्पद्यते तदा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005485032, "chapter_id": 25485, "verse_number": "२-२-३३", "content_sanskrit": "यदा सर्वाणि भुताणि स्स्माधिस्थो न पश्यन्ति ।\nएकीभुतः परेणासौ तदा भवाति केवलः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005485033, "chapter_id": 25485, "verse_number": "२-२-३४", "content_sanskrit": "यदा सर्व प्रमुच्यते कामा येऽस्य ह्रदि स्थिताः ।\nतद्सासाममृतीभूतः क्षेमं गच्छति पण्डितः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005485034, "chapter_id": 25485, "verse_number": "२-२-३५", "content_sanskrit": "यदा भूतपृथग्भावमेकस्थमनुपश्यति ।\nतत एव च विस्तारं ब्रह्मा सम्पद्यते तदा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005485035, "chapter_id": 25485, "verse_number": "२-२-३६", "content_sanskrit": "यदा पश्यति चात्मानं केवलं परमार्थतः ।\nमायामात्रं जगत कृत्स्नं तदा भवति निर्वृतः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005485036, "chapter_id": 25485, "verse_number": "२-२-३७", "content_sanskrit": "यदा जन्मजरादुःक्ल्हव्याधीनामेक भेषजम ।\nकेवलं ब्रह्माविज्ञनं जायतेऽसौ तदा शिवः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005485037, "chapter_id": 25485, "verse_number": "२-२-३८", "content_sanskrit": "यथा नदीनदा लोके सागरेणैकतां ययुः ।\nतद्वदात्माक्शरेणासौ निष्कलेनैकतां व्रजेत ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005485038, "chapter_id": 25485, "verse_number": "२-२-३९", "content_sanskrit": "तस्माद विज्ञानमेवास्ति न प्रपचों न संसृतिः ।\nअज्ञानेनावृतं लोको विज्ञानं तेन मुह्माति ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005485039, "chapter_id": 25485, "verse_number": "२-२-४०", "content_sanskrit": "तत्ज्ञानं निर्मलं सुक्ष्मं निर्विकाल्पं यदव्ययम ।\nअज्ञानमितरत सर्वं विज्ञानमिति मे मतम ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005485040, "chapter_id": 25485, "verse_number": "२-२-४१", "content_sanskrit": "एतद वः परमं साख्यं भाषितं ज्ञनमुत्तमम ।\nसर्ववेदान्तसारं हि योगस्तत्रैकचित्तता ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005485041, "chapter_id": 25485, "verse_number": "२-२-४२", "content_sanskrit": "योगात सत्र्जायते ज्ञानं ज्ञानात योगः प्रवर्तते ।\nयोगज्ञनाभिउक्तस्य नावाप्यं विद्यते क्वचितः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005485042, "chapter_id": 25485, "verse_number": "२-२-४३", "content_sanskrit": "यदेव योगिनो यान्ति सांख्येंस्तदधिगम्यते ।\nएकं सांख्य च योग च यः पश्यति स तत्ववित ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005485043, "chapter_id": 25485, "verse_number": "२-२-४४", "content_sanskrit": "अन्ये च योगिनो विप्रा ऐस्वर्यसक्तचेतसः ।\nमज्जन्ति तत्र तत्रैव न त्वात्मैषामिति श्रुतिः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005485044, "chapter_id": 25485, "verse_number": "२-२-४५", "content_sanskrit": "यत्तत सर्वगतं दिव्यमैश्वर्यमचलं महत ।\nज्ञानयोगाभियुक्त देहान्ते तदवाप्नुयात ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005485045, "chapter_id": 25485, "verse_number": "२-२-४६", "content_sanskrit": "एष आत्माहमव्यक्तो मायावी परमेश्वरः ।\nकीर्तितः सर्ववेदेषु सर्वात्मा सर्वतोमुखः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005485046, "chapter_id": 25485, "verse_number": "२-२-४७", "content_sanskrit": "सर्वकामः सर्वरसः सर्वगन्धोऽजरोऽमरः ।\nसर्वतः पाणिपादोऽहमन्तर्यामी सनातनः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005485047, "chapter_id": 25485, "verse_number": "२-२-४८", "content_sanskrit": "अपाणीपादो जवनो ग्रहीत ह्रुदि संस्थितः ।\nअचक्षुरपि पश्यामि तथाकर्नः श्रृणोम्यहम ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005485048, "chapter_id": 25485, "verse_number": "२-२-४९", "content_sanskrit": "वेदाहं सर्वमेवंद न मां जानाति कश्चन ।\nप्राहुर्महान्तं पुरुषं मामेकं तत्वदर्शिनः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005485049, "chapter_id": 25485, "verse_number": "२-२-५०", "content_sanskrit": "पश्यन्ति ऋषयो हेतुमात्मनः सुक्ष्मदशिनः ।\nनिर्गुणामलरुपस्य यत्तदैश्वर्यमुत्तमम ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005485050, "chapter_id": 25485, "verse_number": "२-२-५१", "content_sanskrit": "यन्न देवो विजनन्ति मोहिता मम मायया ।\nवक्ष्ये समाहिता युयं श्रुणुध्वं ब्रह्मवादिनः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005485051, "chapter_id": 25485, "verse_number": "२-२-५२", "content_sanskrit": "नाहं प्रशास्तां सर्वस्य मायतीतः स्वभावतः ।\nप्रेरयामि तथापीदं कारण सुरयो विदुः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005485052, "chapter_id": 25485, "verse_number": "२-२-५३", "content_sanskrit": "यन्मे गुह्मतमं देहं सर्वगं तत्वदर्शिनः ।\nप्रविष्टा मम सायुज्यं लभत्ये योगिनोऽव्ययम ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005485053, "chapter_id": 25485, "verse_number": "२-२-५४", "content_sanskrit": "तेषां हि वशमापन्ना माया मे विश्वरुपिणी ।\nलभन्ते परमां शुद्धिं निर्वाणं ते मया सह ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005485054, "chapter_id": 25485, "verse_number": "२-२-५५", "content_sanskrit": "न तेषां पुनरवृत्तिः कल्पकोटिशतैरपि ।\nप्रसादान्मम योगीन्द्रा एतद वेदानुशासनम ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005485055, "chapter_id": 25485, "verse_number": "२-२-५६", "content_sanskrit": "नापुत्र्शिष्ययोगिभ्यो दातव्यं ब्रह्मावादिभिः ।\nमदुक्तमेतद विज्ञानं सांख्ययोगसमाश्रयम ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]