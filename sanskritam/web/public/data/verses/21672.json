[{"id": 7001672000, "chapter_id": 21672, "verse_number": "१-५८-१", "content_sanskrit": "नारद उवाच ।\nअनूचानप्रसंगेन वेदांगान्यखिलानि च ।\nश्रुतानि त्वन्मुखांभोजात्समासव्यासयोगतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001672001, "chapter_id": 21672, "verse_number": "१-५८-२", "content_sanskrit": "शुकोत्पत्तिं समाचक्ष्व विस्तरेण महामते ।\nसनंदन उवाच ।\nमेरुश्रृङ्गे किल पुरा कर्णिकारवनायते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001672002, "chapter_id": 21672, "verse_number": "१-५८-३", "content_sanskrit": "विजहार महोदेवो भौमैभूतगणैवृतः ।\nशैलराजसुता चैव देवी तत्राभवत्पुरा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001672003, "chapter_id": 21672, "verse_number": "१-५८-४", "content_sanskrit": "तत्र दिव्यं तपस्तेपे कृष्णद्वैपायनः प्रभुः ।\nयोगेनात्मानमाविश्य योगधर्मपरायणः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001672004, "chapter_id": 21672, "verse_number": "१-५८-५", "content_sanskrit": "धारयन्स तपस्तेपे पुत्रार्थं सुनिसंत्तमः ।\nअग्नेर्भूमेस्तथा वायोरंतरिक्षस्य चाभितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001672005, "chapter_id": 21672, "verse_number": "१-५८-६", "content_sanskrit": "वीर्येण संमतः पुत्रो मम भूयादिति स्म ह ।\nसंकल्पेनाथ सोऽनेन दुष्प्रापमकगृतात्मभिः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001672006, "chapter_id": 21672, "verse_number": "१-५८-७", "content_sanskrit": "वरयामास देवेशमास्थितस्तप उत्तमम् ।\nअतिष्टन्मारुताहारः शतं किल समाः प्रभुः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001672007, "chapter_id": 21672, "verse_number": "१-५८-८", "content_sanskrit": "आराधयन्महादेवं बहुरूपमुमापतिम् ।\nतत्र ब्रह्मर्षयश्चैव सर्वे देवर्षयस्तथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001672008, "chapter_id": 21672, "verse_number": "१-५८-९", "content_sanskrit": "लोकपालाश्च साध्याश्च वसुभिश्चाष्टभिः सह ।\nआदित्याश्चैव रुद्राश्च दिवाकरनिशाकरौ ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001672009, "chapter_id": 21672, "verse_number": "१-५८-१०", "content_sanskrit": "विश्वा वसुश्च गंधर्वः सिद्धाश्चाप्सरासांगणाः ।\nतत्र रुद्रो महादेवः कर्णिकारमयीं शुभाम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001672010, "chapter_id": 21672, "verse_number": "१-५८-११", "content_sanskrit": "धारयानः स्रजं भाति शारदीव निशाकरः ।\nतस्निन् दिव्ये वने रम्ये देवदेवर्षिसंकुले ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001672011, "chapter_id": 21672, "verse_number": "१-५८-१२", "content_sanskrit": "आस्थितः परमं योगं व्यासः पुत्रार्थमुद्यतः ।\nन चास्य हीयते वर्णो न ग्लानिरुपजायते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001672012, "chapter_id": 21672, "verse_number": "१-५८-१३", "content_sanskrit": "त्रयाणामपिलोकानां तदद्भुतमिवाभवत् ।\nजटाश्च तेजसा तस्य वैश्वानरशिखोपमाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001672013, "chapter_id": 21672, "verse_number": "१-५८-१४", "content_sanskrit": "प्रज्वलंत्यः स्म दृश्यंते युक्तस्यामिततेजसः ।\nएवं विधेन तपसा तस्य भक्त्या च नारद ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001672014, "chapter_id": 21672, "verse_number": "१-५८-१५", "content_sanskrit": "महेश्वरः प्रसन्नात्मा चकार मनसा मतिम् ।\nउवाच चैनं भगवांस्त्र्यंबकः प्रहसन्निव ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001672015, "chapter_id": 21672, "verse_number": "१-५८-१६", "content_sanskrit": "यथा ह्यग्नियथा वायुर्यथा भूमिर्यथा जलम् ।\nयथा खे च तथा शुद्धो भविष्यति सुतस्तंव ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001672016, "chapter_id": 21672, "verse_number": "१-५८-१७", "content_sanskrit": "तद्भावभागी तद्बुद्धिस्तदात्मा तदुपाश्रयः ।\nतेजसा तस्य लोकांस्त्रीन्यशः प्राप्स्यति केवलम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001672017, "chapter_id": 21672, "verse_number": "१-५८-१८", "content_sanskrit": "एवं लब्ध्वा वरं देवो व्यासः सत्यवतीसुतः ।\nअरणिं त्वथ संगृह्य ममंथाग्निचिकीर्षया ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001672018, "chapter_id": 21672, "verse_number": "१-५८-१९", "content_sanskrit": "अथ रूपं परं विप्र बिभ्रतीं स्वेन तेजसा ।\nघृताचीं नामाप्सरसं ददर्श भगवान्नृषिः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001672019, "chapter_id": 21672, "verse_number": "१-५८-२०", "content_sanskrit": "स तामप्सरसं दृष्ट्वा सहसा काममोहितः ।\nअभवद्भगवान्व्यासो वने तस्मिन्मुनीश्वर ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001672020, "chapter_id": 21672, "verse_number": "१-५८-२१", "content_sanskrit": "सा तु कृत्वा तदा व्यासं कामसंविग्नमानसम् ।\nशुकीभूया महारम्या घृताची समुपागमत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001672021, "chapter_id": 21672, "verse_number": "१-५८-२२", "content_sanskrit": "स तामप्सरसं दृष्ट्वा रूपेणान्येनसंवृताम् ।\nस्मरराजेनानुगतः सर्वगात्रातिगेन ह ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001672022, "chapter_id": 21672, "verse_number": "१-५८-२३", "content_sanskrit": "स तु महता निगृह्णन् हृच्छयं मुनिः ।\nन शशाक नियंतुं तं व्यासः प्रविसृतं मनः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001672023, "chapter_id": 21672, "verse_number": "१-५८-२४", "content_sanskrit": "भावित्वाञ्चैव भाव्यस्य घृताच्या वपुषा ।\nहृतम् यत्नान्नियच्छतश्चापि मुने एतञ्चिकीर्षया ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001672024, "chapter_id": 21672, "verse_number": "१-५८-२५", "content_sanskrit": "अरण्यामेव सहसा तस्य शुक्रमवापतत् ।\nशुक्रे निर्मथ्यमानेऽस्यां शुको जज्ञे महातपाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001672025, "chapter_id": 21672, "verse_number": "१-५८-२६", "content_sanskrit": "परमर्षिर्महायोगी अरणीगर्भसंभवः ।\nयथैव हि समिद्धोऽग्निर्भाति हव्यमुपात्तवान् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001672026, "chapter_id": 21672, "verse_number": "१-५८-२७", "content_sanskrit": "तथा रूपः शुको जज्ञे प्रज्वलन्निव तेजसा ।\nबिभ्रञ्चित्रं च विप्रेंद्र रूपवर्णमनुत्तमम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001672027, "chapter_id": 21672, "verse_number": "१-५८-२८", "content_sanskrit": "तं गंगां सरितां श्रेष्ठां मेरुपृष्ठे स्वरूपिणीम् ।\nअभ्येत्य स्नापयामास वारिणा स्वेन नारद ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001672028, "chapter_id": 21672, "verse_number": "१-५८-२९", "content_sanskrit": "कृष्णाजिनं चांतरिक्षाच्छुकार्थे भुव्यवापतत् ।\nजगीयंत च गंधर्वा ननृतुञ्चाप्सरोगणाः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001672029, "chapter_id": 21672, "verse_number": "१-५८-३०", "content_sanskrit": "देवदुन्दुभयश्चैव प्रावाद्यंत महास्वनाः ।\nविश्वावसुश्च गंधर्वस्तथा तुंबुरुनारदौ ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001672030, "chapter_id": 21672, "verse_number": "१-५८-३१", "content_sanskrit": "हाहाहूहूश्च गंधर्वौ तुष्टुवुः शुकसंभवम् ।\nतत्र शक्रपुरोगाश्च लोकपालाः समागताः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001672031, "chapter_id": 21672, "verse_number": "१-५८-३२", "content_sanskrit": "देवा देवर्षथयश्चटैव तथा ब्रह्मर्षयोऽपि च ।\nदिव्यानि सर्वपुष्पाणि प्रववर्ष च मारुतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001672032, "chapter_id": 21672, "verse_number": "१-५८-३३", "content_sanskrit": "जंगमं स्थावरं चैव प्रहृष्टमभवज्जगत् ।\nतं महात्मा स्वयं प्रीत्या देव्या सह महाद्युतिः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001672033, "chapter_id": 21672, "verse_number": "१-५८-३४", "content_sanskrit": "जातमात्रं मुनेः पुत्रं विधिनोपानयत्तदा ।\nतस्य देवेश्वरः शक्तो दिव्यमद्भुतदर्शनम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001672034, "chapter_id": 21672, "verse_number": "१-५८-३५", "content_sanskrit": "ददौ कमंडलुं प्रीत्या देवा वासांसि चाभितः ।\nहंसाश्च शतपत्राश्च सारसाश्च सहस्रशः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001672035, "chapter_id": 21672, "verse_number": "१-५८-३६", "content_sanskrit": "प्रदक्षिणमवर्तंत शुकाश्चाषाश्च नारद ।\nआरणे यस्तदा दिव्यं प्राप्य जन्म महामुनिः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001672036, "chapter_id": 21672, "verse_number": "१-५८-३७", "content_sanskrit": "तत्रैवोवास मेधावी व्रतचारी समाहितः ।\nउत्पन्नमात्रं तं वेदाः सरहस्याः ससंग्रहाः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001672037, "chapter_id": 21672, "verse_number": "१-५८-३८", "content_sanskrit": "उपतस्थुर्मुनिश्रेष्टं यथास्य पितरं तथा ।\nबृहस्पतिं स वव्रे च वेदवेदांगभाष्यवित् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001672038, "chapter_id": 21672, "verse_number": "१-५८-३९", "content_sanskrit": "उपाध्यायं द्विजश्रेष्ट धर्ममेवानुचिंतयन् ।\nसोऽधीत्य वेदानखिलान्सरहस्यान्ससंग्रहान् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001672039, "chapter_id": 21672, "verse_number": "१-५८-४०", "content_sanskrit": "इतिहासं च कार्त्स्न्येन वेदशास्त्राणि चाभितः ।\nगुरवे दक्षिणां दत्त्वा समावृत्तो महामुनिः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001672040, "chapter_id": 21672, "verse_number": "१-५८-४१", "content_sanskrit": "उग्रं तपः समारेभे ब्रह्मचारी समाहिताः ।\nदेवतानामृषीणां च बाल्येऽपि सुमहातपाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001672041, "chapter_id": 21672, "verse_number": "१-५८-४२", "content_sanskrit": "संमत्रणीयो जन्यश्च ज्ञानेन तपसा तथा ।\nन त्वस्य रमते बुद्धिराश्रमेषु मुनीश्वर ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001672042, "chapter_id": 21672, "verse_number": "१-५८-४३", "content_sanskrit": "त्रिषु गार्हस्थ्यमूलेषु मोक्षधर्मानुदर्शिनः ।\nस मोक्षमनुचिंत्यैव शुकः पितरमभ्यगात् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001672043, "chapter_id": 21672, "verse_number": "१-५८-४४", "content_sanskrit": "प्राहाभिवाद्य च तदा श्रेयोऽर्थी विनयान्वितः ।\nमोक्षधर्मेषु कुशलो भगवान् प्रब्रवीतु मे ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001672044, "chapter_id": 21672, "verse_number": "१-५८-४५", "content_sanskrit": "यथैव मनसः शांतिः परमा संभवेन्मुने ।\nश्रृत्वा पुत्रस्य वचनं परमर्षिरुवाच तम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001672045, "chapter_id": 21672, "verse_number": "१-५८-४६", "content_sanskrit": "अधीष्व मोक्षशास्त्रं वै धर्मांश्च विविधानपि ।\nपितुर्निदेशाज्जग्राह शुको ब्रह्मविदां वरः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001672046, "chapter_id": 21672, "verse_number": "१-५८-४७", "content_sanskrit": "योगशास्त्रं च निखिलं कापिलं चैव नारद ।\nशतं ब्राह्म्या श्रिया युक्तं ब्रह्मतुल्यपराक्रमम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001672047, "chapter_id": 21672, "verse_number": "१-५८-४८", "content_sanskrit": "मेने पुत्रं यथा व्यासो मोक्षशास्त्रविशारदम् ।\nउवाच गच्छेति तदा जनकं मिथिलेश्वरम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001672048, "chapter_id": 21672, "verse_number": "१-५८-४९", "content_sanskrit": "स ते वक्ष्यति मोक्षार्थं निखिलेन नराधिपः ।\nपितुर्नियोगादगमज्जनकं मेथखिलं नृपम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001672049, "chapter_id": 21672, "verse_number": "१-५८-५०", "content_sanskrit": "प्रष्टुं धर्मस्य निष्टां वै मोक्षस्य च परायणम् ।\nउक्तश्च मानुषेण त्वं तथा गच्छेत्यविस्मितः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001672050, "chapter_id": 21672, "verse_number": "१-५८-५१", "content_sanskrit": "न प्रभावेण गंतव्यमंतरिक्षचरेण वै ।\nआर्जवेनैव गंतव्यं न सुखाय क्षणात्त्वया ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001672051, "chapter_id": 21672, "verse_number": "१-५८-५२", "content_sanskrit": "न द्रष्टव्या विशेषा हि विशेषा हि प्रसंगिनः ।\nअहंकारो न कर्तव्यो याज्ये तस्मिन्नराधिपे ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001672052, "chapter_id": 21672, "verse_number": "१-५८-५३", "content_sanskrit": "स्थातव्यं वसथे तस्य स ते छेत्स्यति संशयम् ।\nस धर्मकुशलो राजा मोक्षशास्त्रविशारदः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001672053, "chapter_id": 21672, "verse_number": "१-५८-५४", "content_sanskrit": "यथा यथा च ते ब्रूयात्तत्कार्यमविशंकया ।\nएवमुक्तः स धर्मात्मा जगाम मिथिलां मुनिः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001672054, "chapter_id": 21672, "verse_number": "१-५८-५५", "content_sanskrit": "पभ्द्यां शक्तोंतरिक्षेण क्रांतुं भूमिं ससागराम् ।\nसगिरीं श्चाप्यतिक्रम्य भारतं वर्षमासदत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001672055, "chapter_id": 21672, "verse_number": "१-५८-५६", "content_sanskrit": "स देशान्विविधान्स्फीतानतिक्रम्य महामुनिः ।\nविदेहान्वै समासाद्य जनकेन समागमत् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001672056, "chapter_id": 21672, "verse_number": "१-५८-५७", "content_sanskrit": "राजद्वारं समासाद्य द्वारपालैर्निवारितः ।\nतस्थौ तत्र महायोगी क्षुत्पिपासादिवर्जितः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001672057, "chapter_id": 21672, "verse_number": "१-५८-५८", "content_sanskrit": "आतपे ग्लानिरहितो ध्यानयुक्तश्च नारद ।\nतेषां तु द्वारपालानामेकस्तत्र व्यवस्थितः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001672058, "chapter_id": 21672, "verse_number": "१-५८-५९", "content_sanskrit": "मध्यंगतमिवादित्यं दृष्ट्वा शुकमवस्थितम् ।\nजूजयित्वा यथान्यायमभिवाद्य कृताञ्जलिः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001672059, "chapter_id": 21672, "verse_number": "१-५८-६०", "content_sanskrit": "प्रावेशयत्ततः कक्षां द्वितीयां राजवेश्मनः ।\nतत्रांतःपुरसंबद्धं महच्चैत्रग्थोपमम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001672060, "chapter_id": 21672, "verse_number": "१-५८-६१", "content_sanskrit": "सुविभक्तजलाक्रीडं रम्यं पुष्पितपादपम् ।\nदर्शयित्वासने स्थाप्य राजानं च व्यजिज्ञपत् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001672061, "chapter_id": 21672, "verse_number": "१-५८-६२", "content_sanskrit": "श्रुत्वा राजा शुकं प्राप्तं वारस्त्रीः स न्ययुंक्त च ।\nसेवायै तस्य भावस्य ज्ञानाय मुनिसतम ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001672062, "chapter_id": 21672, "verse_number": "१-५८-६३", "content_sanskrit": "तं चारुकेश्यः शुश्रेण्यस्तरुण्यः प्रियदर्शनाः ।\nसूक्ष्मरक्तांबरधरास्तप्तकांचनभूषणाः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001672063, "chapter_id": 21672, "verse_number": "१-५८-६४", "content_sanskrit": "संलापालापकुशाला भावज्ञाः सर्वकोविदाः ।\nपरं पंचाशतस्तस्य पाद्यादीनि व्यकल्पयन् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001672064, "chapter_id": 21672, "verse_number": "१-५८-६५", "content_sanskrit": "देश कालोपपन्नेन साध्वन्नेनाप्यतर्पयन् ।\nतस्य भुक्तवतस्तात तास्ततः पुरकाननम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001672065, "chapter_id": 21672, "verse_number": "१-५८-६६", "content_sanskrit": "सुरम्यं दर्शयामासुरेकैकत्वेन नारद ।\nक्रीडंत्यश्च हसंत्यश्च गायंत्यश्चैव ताः शुकम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001672066, "chapter_id": 21672, "verse_number": "१-५८-६७", "content_sanskrit": "उदारसत्वं सत्वज्ञास्सर्वाः पर्य्यचरंस्तदा ।\nआरणेयस्तु शुद्धात्मा जितक्रोधो जितेंद्रियः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001672067, "chapter_id": 21672, "verse_number": "१-५८-६८", "content_sanskrit": "ध्यानस्थ एव सततं न हृष्यति न कुप्यति ।\nपादशौचं तु कृत्वा वै शुकः संध्यामुपास्य च ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001672068, "chapter_id": 21672, "verse_number": "१-५८-६९", "content_sanskrit": "निषसादासने पुण्ये तमेवार्थं व्यचिंतयत् ।\nपूर्वरात्रे तु तत्रासौ भूत्वा ध्यानपरायणः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001672069, "chapter_id": 21672, "verse_number": "१-५८-७०", "content_sanskrit": "मध्यरात्रे यथान्याय्यं निद्रामाहारयत्प्रभुः ।\nततः प्रातः समुत्थाय कृत्वा शौचमनंतरम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001672070, "chapter_id": 21672, "verse_number": "१-५८-७१", "content_sanskrit": "स्त्रीभिः परिवृत्तो धीमान्ध्यानमेवान्वपद्यत ।\nअनेन विधिना तत्र तदहःशेषमप्युत ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001672071, "chapter_id": 21672, "verse_number": "१-५८-७२", "content_sanskrit": "तां च रात्रिं नृपकुले वर्तयामास नारद ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]