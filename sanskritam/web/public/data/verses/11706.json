[{"id": 50022499, "chapter_id": 11706, "verse_number": "1", "content_sanskrit": "सूत उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50022500, "chapter_id": 11706, "verse_number": "2", "content_sanskrit": "स एवमनुभूयेदं नारायणविनिर्मितम्। वैभवं योगमायायास्तमेव शरणं ययौ॥ १२/९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50022501, "chapter_id": 11706, "verse_number": "3", "content_sanskrit": "ऋषिरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50022502, "chapter_id": 11706, "verse_number": "4", "content_sanskrit": "प्रपन्नोऽस्म्यङ्घ्रिमूलं तत् प्रपन्नाभयदं हरेः। यन्माययाऽपि विबुधा मुह्यन्त्यज्ञानकातराः॥ १२/९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50022503, "chapter_id": 11706, "verse_number": "5", "content_sanskrit": "सूत उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50022504, "chapter_id": 11706, "verse_number": "6", "content_sanskrit": "तमित्थं निभृतात्मानं वृषेण दिवि पर्यटन्। रुद्राण्या भगवान् रुद्रो ददर्श स्वगणैर्वृतः॥ १२/९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50022505, "chapter_id": 11706, "verse_number": "7", "content_sanskrit": "अथोमा तमृषिं वीक्ष्य गिरिशं समभाषत। पश्येमं भगवन् विप्रं निर्भृतास्वेन्द्रियाशयम् (???)॥ १२/९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50022506, "chapter_id": 11706, "verse_number": "8", "content_sanskrit": "निभृतो नन्वृषिव्रातस्तपापाये यथाऽर्णवः। कुर्वस्य तपसः साक्षात् संसिद्धिं सिद्धिदो भवान्॥ १२/९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50022507, "chapter_id": 11706, "verse_number": "9", "content_sanskrit": "श्रीमहादेव उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50022508, "chapter_id": 11706, "verse_number": "10", "content_sanskrit": "नैवेच्छत्याशिषः क्वापि ब्रह्मर्षिर्मोक्षमप्युत। भक्तिं परां भगवति लब्धवान् पुरुषेऽव्यये॥ १२/९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50022509, "chapter_id": 11706, "verse_number": "11", "content_sanskrit": "अथापि संवदिष्यामो भवान्येतेन साधुना। अयं हि परमो लाभो नृणां साधुसमागमः॥ १२/९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50022510, "chapter_id": 11706, "verse_number": "12", "content_sanskrit": "इत्युक्त्वा समुपेयाय भगवान् स सतां गतिः। ईशानः सर्वविद्यानामीश्वरः सर्वदेहिनाम्॥ १२/९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50022511, "chapter_id": 11706, "verse_number": "13", "content_sanskrit": "तयोरागमनं साक्षादीशयोर्जगदात्मनोः। न वेद रुध्दधीवृत्तिरात्मानं विश्वमेव च॥ १२/९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50022512, "chapter_id": 11706, "verse_number": "14", "content_sanskrit": "भगवांस्तदभिज्ञाय गिरिशो योगमायया। आविशत् तद्गुहाकाशं वायुश्छिद्रमिवेश्वरः॥ १२/९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50022513, "chapter_id": 11706, "verse_number": "15", "content_sanskrit": "आत्मन्यपि शिवं प्राप्तं तडित्पिङ्गजटाधरम्। त्र्यक्षमष्टभुजं प्रांशुमुद्यन्तमिव भास्करम्॥ १२/९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50022514, "chapter_id": 11706, "verse_number": "16", "content_sanskrit": "व्याघ्रचर्माम्बरं शूलधनुरिष्वसिचर्मभिः। अक्षमालां डमरुगं कपालं परशुं सह॥ १२/९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50022515, "chapter_id": 11706, "verse_number": "17", "content_sanskrit": "बिभ्राणं सहसा भान्तं व्यचष्ट हृदि विस्मितः। किमिदं कुत एवेति समाधेर्विरतो मुनिः॥ १२/९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50022516, "chapter_id": 11706, "verse_number": "18", "content_sanskrit": "नेत्रे उन्मील्य ददृशे सगणं सोमयागतम्। रुद्रं त्रिलोकैकगुरुं ननाम शिरसा मुनिः॥ १२/९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50022517, "chapter_id": 11706, "verse_number": "19", "content_sanskrit": "तस्मै सपर्यां व्यदधात् सगणाय सहोमया। स्वागतासनपाद्यार्घ्यगन्धस्रग्धूपदीपकैः॥ १२/९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50022518, "chapter_id": 11706, "verse_number": "20", "content_sanskrit": "आह चात्मानुभावेन पूर्णकामस्य ते विभो। करवाम किमीशान येनेदं निर्वृतं जगत्॥ १२/९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50022519, "chapter_id": 11706, "verse_number": "21", "content_sanskrit": "नमः शिवाय शान्ताय सत्वाय प्रमृडाय च। रजोजुषेऽथ घोराय नमस्तुभ्यं तमोजुषे॥ १२/९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50022520, "chapter_id": 11706, "verse_number": "22", "content_sanskrit": "सूत उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50022521, "chapter_id": 11706, "verse_number": "23", "content_sanskrit": "एवं स्तुतः स भगवान् महादेवः सतां पतिः। परितुष्टः प्रसन्नात्मा प्रहसंस्तमभाषत॥ १२/९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50022522, "chapter_id": 11706, "verse_number": "24", "content_sanskrit": "श्रीमहादेव उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50022523, "chapter_id": 11706, "verse_number": "25", "content_sanskrit": "वरं वृणीष्व मत् कामं वरदेशा वयं त्रयः। अमोघं दर्शनं येषां मर्त्यो यद् विन्दतेऽमृतम्॥ १२/९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50022524, "chapter_id": 11706, "verse_number": "26", "content_sanskrit": "ब्राह्मणाः साधवः शान्ता निस्सङ्गा भूतवत्सलाः। एकान्तभक्ता अस्मासु निर्वैराः समदर्शनाः॥ १२/९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50022525, "chapter_id": 11706, "verse_number": "27", "content_sanskrit": "सलोका लोकपालास्तान् वदन्त्यर्चन्त्युपासते। अहं च भगवान् ब्रह्मा स्वयं च हरिरीश्वरः॥ १२/९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50022526, "chapter_id": 11706, "verse_number": "28", "content_sanskrit": "न ते मय्यच्युतेऽजे च भिदामण्वपि चक्षते। नात्मनश्च जनस्यापि तद् युष्मान् वयमीमहि॥ १२/९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50022527, "chapter_id": 11706, "verse_number": "29", "content_sanskrit": "न ह्यम्मयानि तीर्थानि न देवा मृच्छिलामयाः। ते पुनन्त्युरुकालेन यूयं दर्शनमात्रतः॥ १२/९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50022528, "chapter_id": 11706, "verse_number": "30", "content_sanskrit": "ब्राह्मणेभ्यो नमस्यामो येऽस्मद्रूपं त्रयीमयम्। बिभ्रत्यात्मसमाधानं५ तपःस्वाध्यायसंयमैः॥ १२/९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50022529, "chapter_id": 11706, "verse_number": "31", "content_sanskrit": "श्रवणाद् दर्शनाद् येषां महापातकिनोऽपि वः। शुद्ध्येरन्नन्त्यजाश्चापि किमु सम्भाषणादिभिः॥ १२/९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50022530, "chapter_id": 11706, "verse_number": "32", "content_sanskrit": "इति चन्द्रललामस्य धर्मगुह्योपबृंहितम्। वचोऽमृतायनमृषिर्नातृप्यत् कर्णयोः पिबन्॥ १२/९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50022531, "chapter_id": 11706, "verse_number": "33", "content_sanskrit": "स चिरं मायया विष्णोर्भ्रामितः कर्शितो भृशम्। शिववागमृतध्वस्तक्लेशपुञ्जस्तमब्रवीत्॥ १२/९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50022532, "chapter_id": 11706, "verse_number": "34", "content_sanskrit": "ऋषिरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50022533, "chapter_id": 11706, "verse_number": "35", "content_sanskrit": "अहो ईश्वरचर्येयं दुर्विभाव्या शरीरिणाम्। यन्नमन्तीशितव्यानि स्तुवन्ति जगदीश्वराः॥ १२/९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50022534, "chapter_id": 11706, "verse_number": "36", "content_sanskrit": "धर्मं ग्राहयितुं प्रायः प्रवक्तारश्च देहिनाम्। आचरन्त्यनुमोदन्ते क्रियमाणं स्तुवन्ति च॥ १२/९/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50022535, "chapter_id": 11706, "verse_number": "37", "content_sanskrit": "नैतावता भगवतः स्वमायामयवृत्तिभिः। प्रदुष्येतानुभावस्ते मायिनः कुहकैर्यथा॥ १२/९/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50022536, "chapter_id": 11706, "verse_number": "38", "content_sanskrit": "सृष्ट्वेदं मनसा विश्वमात्मनाऽन्तःप्रविश्य यः। गुणैः कुर्वद्भिराभाति कर्तेव स्वप्नदृग् यथा॥ १२/९/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50022537, "chapter_id": 11706, "verse_number": "39", "content_sanskrit": "तस्मै नमो भगवते त्रिगुणाय महात्मने। केवलायाद्वितीयाय गुरवे ब्रह्ममूर्तये॥ १२/९/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50022538, "chapter_id": 11706, "verse_number": "40", "content_sanskrit": "कं वृणेऽतः परं भूमन् वरं त्वद् वरदर्षभात्। यद्दर्शनात् पूर्णकामः सत्यकामः पुमान् भवेत्॥ १२/९/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50022539, "chapter_id": 11706, "verse_number": "41", "content_sanskrit": "वरमेतं वृणेऽथापि पूर्णकामाभिवर्षणात्। भगवत्यच्युतां भक्तिं तत्परेषु तथा त्वयि॥ १२/९/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50022540, "chapter_id": 11706, "verse_number": "42", "content_sanskrit": "सूत उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50022541, "chapter_id": 11706, "verse_number": "43", "content_sanskrit": "इत्यर्थितोऽभिष्टुतश्च मुनिना सूक्तया गिरा। तमाह भगवान् शर्वः शर्वया चाभिनन्दितः॥ १२/९/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50022542, "chapter_id": 11706, "verse_number": "44", "content_sanskrit": "कामस्तेऽस्तु महर्षेस्तु भक्तिमांस्त्वमधोक्षजे। आकल्पान्तं यशः पुण्यमजरामरता तथा॥ १२/९/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50022543, "chapter_id": 11706, "verse_number": "45", "content_sanskrit": "ज्ञानं त्रैकालिकं ब्रह्मन् विज्ञानं च विरक्तिमत्। ब्रह्मवर्चस्विता भूयात् पुराणाचार्यताऽस्तु ते॥ १२/९/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50022544, "chapter_id": 11706, "verse_number": "46", "content_sanskrit": "सूत उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50022545, "chapter_id": 11706, "verse_number": "47", "content_sanskrit": "एवं वरान् स मुनये दत्त्वाऽगात् त्र्यक्ष ईश्वरः। देव्यै तत् कर्म कथयदनुभूतं पुराऽमुना॥ १२/९/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50022546, "chapter_id": 11706, "verse_number": "48", "content_sanskrit": "सोऽप्यवाप्तमहायोगमहिमा भार्गवोत्तमः। विचरत्यधुनाप्यद्धा हरावेकान्ततां गतः॥ १२/९/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 50022547, "chapter_id": 11706, "verse_number": "49", "content_sanskrit": "अनुवर्णितमेतत् ते मार्कण्डेयस्य धीमतः। अनुभूतं भगवतो मायावैभवमद्भुतम्॥ १२/९/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 50022548, "chapter_id": 11706, "verse_number": "50", "content_sanskrit": "एतत् केचिदविद्वांसो मायासंसृतिमात्मनः। अनाद्यावर्तितं नॄणां कादाचित्कं प्रचक्षते॥ १२/९/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 50022549, "chapter_id": 11706, "verse_number": "51", "content_sanskrit": "य एवमेतद् भृगुवर्य वर्णितं रथाङ्गपाणेरनुभावभावितम्। संश्रावयेत् संशृणुयादुतोभयोस्तयोर्न कर्माशयसंसृतिर्भवेत्॥ १२/९/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 50022550, "chapter_id": 11706, "verse_number": "52", "content_sanskrit": "इति श्रीमद्भागवते द्वादशस्कन्धे नवमोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]