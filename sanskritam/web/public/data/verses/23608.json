[{"id": 7003608000, "chapter_id": 23608, "verse_number": "१-१-३०-१", "content_sanskrit": "लोमश उवाच ।\nवल्गमानं तमायांतं तारका सुरमोजसा ।\nआजघान च वज्रेण इंद्रो मतिमतां वरः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003608001, "chapter_id": 23608, "verse_number": "१-१-३०-२", "content_sanskrit": "तेन वज्रप्रहारेण तारको विह्वलीकृतः ।\nपतितोऽपि समुत्थाय शक्त्या तं प्राहरद्द्विपम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003608002, "chapter_id": 23608, "verse_number": "१-१-३०-३", "content_sanskrit": "पुरंदरं गजस्थं हि अपातया भूतले ।\nहाहाकारो महानासीत्पतिते च पुरंदरे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003608003, "chapter_id": 23608, "verse_number": "१-१-३०-४", "content_sanskrit": "तारकेणापि तत्रैव यत्कृतं तच्छृणु प्रभो ।\nपतितं च पदाक्रम्य हस्ताद्वज्रं प्रगृह्य च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003608004, "chapter_id": 23608, "verse_number": "१-१-३०-५", "content_sanskrit": "हतं देवेंद्रमालोक्य तारको रिपुसूदनः ।\nवज्रघातेन महताऽताडयत्तु पुरंदरम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003608005, "chapter_id": 23608, "verse_number": "१-१-३०-६", "content_sanskrit": "त्रिशूलमुद्यम्य महाबलस्तदा स वीरभद्रो रुषितः पुरंदरम् ।\nसंरक्षमाणो हि जघान तारकं शूलेन दैत्यं च महाप्रभेण ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003608006, "chapter_id": 23608, "verse_number": "१-१-३०-७", "content_sanskrit": "शूलप्रहाराभिहतो निपपात महीतले ।\nपतितोऽपि महातेजास्तारकः पुनरुत्थितः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003608007, "chapter_id": 23608, "verse_number": "१-१-३०-८", "content_sanskrit": "जघान परया शक्त्या वीरभद्रं तदोरसि ।\nवीरभद्रोपि पतितः शक्तिघातेन तस्य वै ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003608008, "chapter_id": 23608, "verse_number": "१-१-३०-९", "content_sanskrit": "सगणाश्चैव देवाश्च गंधर्वोरगराक्षसाः ।\nहाहाकारेण महता चुक्रुशुश्च पुनःपुनः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003608009, "chapter_id": 23608, "verse_number": "१-१-३०-१०", "content_sanskrit": "तदोत्थितः सहसा महाबलः स वीरभद्रो द्विषतां निहंता ।\nत्रिशूलमुद्यम्य तडित्प्रकाशं जाज्वल्यमानं प्रभया निरंतरम् ।\nस्वरोचिषा भासितदिग्वितानं सूयदुबिंबाग्न्युडुमण्डलाभम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003608010, "chapter_id": 23608, "verse_number": "१-१-३०-११", "content_sanskrit": "त्रिशूलेन तदा यावद्धंतुकामो महाबलः ।\nनिवारितः कुमारेण मावधीस्त्वं महामते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003608011, "chapter_id": 23608, "verse_number": "१-१-३०-१२", "content_sanskrit": "जगर्ज च महातेजाः कार्त्तिकेयो महाबलः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003608012, "chapter_id": 23608, "verse_number": "१-१-३०-१३", "content_sanskrit": "तदा जयेत्यभिहितो भूतैराकाशसंस्थितैः ।\nशक्त्या परमया वीरस्तारकं हंतुमुद्यतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003608013, "chapter_id": 23608, "verse_number": "१-१-३०-१४", "content_sanskrit": "तारकस्य कुमारस्य संग्रामस्तत्र दुःसहः ।\nजातस्ततो महाघोरः सर्वभूतभयंकरः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003608014, "chapter_id": 23608, "verse_number": "१-१-३०-१५", "content_sanskrit": "शक्तिहस्तौ च तौ वीरौ युयुधाते परस्परम् ।\nशक्तिभ्यां भिन्नहस्तौ तौ महासाहससंयुतौ ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003608015, "chapter_id": 23608, "verse_number": "१-१-३०-१६", "content_sanskrit": "परस्परं वंचयंतौ सिंहाविव महाबलौ ।\nवैतालिकीं समाश्रित्य तथा वै खेचरीं गतिम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003608016, "chapter_id": 23608, "verse_number": "१-१-३०-१७", "content_sanskrit": "पार्वतं मतमाश्रित्य शक्त्या शक्तिं निजघ्नतुः ।\nएभिर्मतैर्महावीरौ चक्रतुर्युद्धमुत्तमम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003608017, "chapter_id": 23608, "verse_number": "१-१-३०-१८", "content_sanskrit": "अन्योन्यसाधकौ भूत्वा महाबलपराक्रमौ ।\nजघ्नतुः शक्तिधाराभी रणे रणविशारदौ ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003608018, "chapter_id": 23608, "verse_number": "१-१-३०-१९", "content_sanskrit": "मूर्ध्नि कण्ठे तथा बाह्वोर्जान्वोश्चैव कटीतटे ।\nवक्षस्युरसि पृष्ठे च चिच्छिदतुः परस्परम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003608019, "chapter_id": 23608, "verse_number": "१-१-३०-२०", "content_sanskrit": "तदा तौ युध्यमानौ च हन्तुकामौ महाबलौ ।\nप्रेक्षका ह्यभवन्सर्वे देवगन्धर्वगुह्यकाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003608020, "chapter_id": 23608, "verse_number": "१-१-३०-२१", "content_sanskrit": "ऊचुः परस्परं सर्वे कोऽस्मिन्युद्धे विजेष्यते ।\nतदा नभोगता वाणी उवाच परिसांत्व्य वै ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003608021, "chapter_id": 23608, "verse_number": "१-१-३०-२२", "content_sanskrit": "तारकं हि सुराश्चाद्य कुमारोऽयं हनिष्यति ।\nमा शोच्यतां सुराः सर्वैः सुखेन स्थीयतां दिवि ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003608022, "chapter_id": 23608, "verse_number": "१-१-३०-२३", "content_sanskrit": "श्रुत्वा तदा तां गगने समीरितां तदैव वाचं प्रमथैः परीतः ।\nकुमारकस्तं प्रति हंतुकामो दैत्याधिपं तारकमुग्ररूपम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003608023, "chapter_id": 23608, "verse_number": "१-१-३०-२४", "content_sanskrit": "शक्त्या तया महाबाहुराजघान स्तनांतरे ।\nतारकं ह्यसुरश्रेष्ठं कुमारो बलवत्तरः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003608024, "chapter_id": 23608, "verse_number": "१-१-३०-२५", "content_sanskrit": "तं प्रहारमना दृत्य तारको दैत्यपुंगवः ।\nकुमारं चाऽपि संक्रुद्धः स्वशक्त्या चाजघान वै ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003608025, "chapter_id": 23608, "verse_number": "१-१-३०-२६", "content_sanskrit": "तेन शक्तिप्रहारेण शांकरिर्मूर्च्छितोऽभवत् ।\nमुहूर्ताच्चेतनां प्राप्तः स्तूयमानो महर्षिभिः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003608026, "chapter_id": 23608, "verse_number": "१-१-३०-२७", "content_sanskrit": "यथा सिंहो मदोन्मत्तो हंतुकामस्तथैव च ।\nकुमारस्तारकं दैत्यमाजघान प्रतापवान् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003608027, "chapter_id": 23608, "verse_number": "१-१-३०-२८", "content_sanskrit": "एवं परस्परेणैव कुमारश्चैव तारकः ।\nयुयुधातेऽतिसंरब्धौ शक्तियुद्धपरायणौ ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003608028, "chapter_id": 23608, "verse_number": "१-१-३०-२९", "content_sanskrit": "अभ्यासपरमावास्तामन्योन्यविजिगीषया ।\nतथा तौ युध्यमानौ च चित्ररूपौ तपस्विनौ ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003608029, "chapter_id": 23608, "verse_number": "१-१-३०-३०", "content_sanskrit": "धाराभिश्च अणीभीश्च सुप्रयुक्तौ च जघ्नतुः ।\nअवलोकपराः सर्वे देवगन्धर्वकिन्नराः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003608030, "chapter_id": 23608, "verse_number": "१-१-३०-३१", "content_sanskrit": "विस्मयं परमं प्राप्ता नोचुः किंचन तस्य वै ।\nन ववौ च तदावायुर्निष्प्रभोऽभूद्दिवाकरः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003608031, "chapter_id": 23608, "verse_number": "१-१-३०-३२", "content_sanskrit": "हिमालयोऽथ मेरुश्च श्वेतकूटश्च दर्दुरः ।\nमलयोऽथ महाशैलो मैनाको विंध्यपर्वतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003608032, "chapter_id": 23608, "verse_number": "१-१-३०-३३", "content_sanskrit": "लोकालोकौ महाशैलौ मानसोत्तरपर्वतः ।\nकैलासो मन्दरो माल्यो गन्धमादन एव च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003608033, "chapter_id": 23608, "verse_number": "१-१-३०-३४", "content_sanskrit": "उदयाद्रिर्महेंद्रश्च तथैवास्तगिरिर्महान् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003608034, "chapter_id": 23608, "verse_number": "१-१-३०-३५", "content_sanskrit": "एते चान्ये च बहवः पर्वताश्च महाप्रभाः ।\nस्नेहार्द्दितास्तदाजग्मुः कुमारं च परीप्सवः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003608035, "chapter_id": 23608, "verse_number": "१-१-३०-३६", "content_sanskrit": "ततः स दृष्ट्वा तान्सर्वान्भयभीतांश्च शांकरिः ।\nपर्वतान्गिरिजापुत्रो बभाषे प्रतिबोधयन् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003608036, "chapter_id": 23608, "verse_number": "१-१-३०-३७", "content_sanskrit": "कुमार उवाच ।\nमा खिद्यत महाभागा मा चिंता क्रियतां नगाः ।\nघातयाम्यद्य पापिष्ठं सर्वेषामिह पश्यताम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003608037, "chapter_id": 23608, "verse_number": "१-१-३०-३८", "content_sanskrit": "एवं समाश्वास्य तदा मनस्वी तान्पर्वतान्देवगणैः समेतान् ।\nप्रणम्य शंभुं मनसा हरिप्रियः स्वां मातरं चैव नतः कुमारः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003608038, "chapter_id": 23608, "verse_number": "१-१-३०-३९", "content_sanskrit": "कार्त्तिकेयस्ततः शक्त्या निचकर्त रिपोः शिरः ।\nतच्छिरो निपपातोर्व्यां तारकस्य च तत्क्षणात् ।\nएवं स जयमापेदे कार्त्तिकेयो महाप्रभुः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003608039, "chapter_id": 23608, "verse_number": "१-१-३०-४०", "content_sanskrit": "ददृशुस्तं सुरगणा ऋषयो गुह्यकाः खगाः ।\nकिंनराश्चारणाः सर्पास्तथा चैवाप्सरो गणाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003608040, "chapter_id": 23608, "verse_number": "१-१-३०-४१", "content_sanskrit": "हर्षेण महताविष्टास्तुष्टुवुस्तं कुमारकम् ।\nविद्याधर्यश्च ननृतुर्गायकाश्च जगुस्तदा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003608041, "chapter_id": 23608, "verse_number": "१-१-३०-४२", "content_sanskrit": "एवं विजयमापन्नं दृष्ट्वा सर्वे मुदा युताः ।\nततो हर्षात्समागम्य स्वांकमारोप्य चात्मजम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003608042, "chapter_id": 23608, "verse_number": "१-१-३०-४३", "content_sanskrit": "परिष्वज्य तु गाढेन गिरिजापि तुतोष वै ।\nस्वोत्संगे च समारोप्य कुमारं सूर्यवर्चसम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003608043, "chapter_id": 23608, "verse_number": "१-१-३०-४४", "content_sanskrit": "लालयामास तन्वंगी पार्वती रुचिरेक्षणा ।\nऋषीभिः सत्कृतः शंभुः पार्वत्या सहितस्तदा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003608044, "chapter_id": 23608, "verse_number": "१-१-३०-४५", "content_sanskrit": "आर्यासनगता साध्वी शुशुभे मितभाषिणी ।\nसंस्तूयमाना मुनिभिः सिद्धचारणपन्नगैः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003608045, "chapter_id": 23608, "verse_number": "१-१-३०-४६", "content_sanskrit": "नीराजिता तदा देवैः पार्वती शंभुना सह ।\nकुमारेण सहैवाथ शोममाना तदा सती ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003608046, "chapter_id": 23608, "verse_number": "१-१-३०-४७", "content_sanskrit": "हिमालयस्तदागत्य पुत्रैश्च परिवारितः ।\nमेर्वाद्यैः पर्वतैश्चैव स्तूयमानः परोऽभवत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003608047, "chapter_id": 23608, "verse_number": "१-१-३०-४८", "content_sanskrit": "तदा देवगणाः सर्व इन्द्राद्य ऋषिभिः सह ।\nपुष्पवर्षेण महात ववर्षुरमितद्युतिम् ।\nकुमारमग्रतः कृत्वा नीराजनपरा बभुः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003608048, "chapter_id": 23608, "verse_number": "१-१-३०-४९", "content_sanskrit": "गीतवादित्रघोषेण ब्रह्मघोषेण भूयसा ।\nसंस्तूयमानो विविधैः सूक्तैर्वेदविदां वरैः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003608049, "chapter_id": 23608, "verse_number": "१-१-३०-५०", "content_sanskrit": "कुमारविजयंनाम चरित्रं परमाद्भुतम् ।\nसर्वपापहरं दिव्यं सर्वकामप्रदं नृणाम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003608050, "chapter_id": 23608, "verse_number": "१-१-३०-५१", "content_sanskrit": "ये कीर्त्तयंति शुचयोऽमितभाग्ययुक्ताश्चानंत्यरूपमजरामरमादधानाः ।\nकौमारविक्रममहात्म्यमुदारमेतदानंददायकमनोर्थकरं नृणां हि ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003608051, "chapter_id": 23608, "verse_number": "१-१-३०-५२", "content_sanskrit": "यः पठेच्छृणुयाद्वापि कुमारस्य महात्मनः ।\nचरितं तारकाख्यं च सर्वपापैः समुच्यते ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003608052, "chapter_id": 23608, "verse_number": "१-१-३०-५३", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां प्रथमे माहेश्वरखण्डे केदारखंडे शिवशास्त्रे तारकासुरवधपूर्वकं स्वामिकार्त्तिकेयविजयोत्सववर्णनं नाम त्रिंशोऽध्यायः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]