[{"id": 2095577, "chapter_id": 3039, "verse_number": "१३-१६९-१", "content_sanskrit": "`सनत्कुमार उवाच।\nअरिष्टानि प्रवक्ष्यामि तत्वेन शृणु तद्भवान्।\nमध्य उत्तरतस्तात दक्षिणामुखनिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2095578, "chapter_id": 3039, "verse_number": "१३-१६९-२", "content_sanskrit": "विद्युत्संस्थानपुरुषं यदि पश्येत मानवः।\nवर्षत्रयेण जानीयाद्देहन्यासमुपस्थितम्।\nएतत्फलमंरिष्टस्य शङ्कराहुर्मनीषिणः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2095579, "chapter_id": 3039, "verse_number": "१३-१६९-३", "content_sanskrit": "शुद्धमण्डमादित्यमरश्मिमथ पश्यतः।\nवर्षार्धकेन जानीयाद्देहन्यासमुपस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2095580, "chapter_id": 3039, "verse_number": "१३-१६९-४", "content_sanskrit": "छिद्रां चन्द्रमसश्छायां पादावप्यनपश्यतः।\nसंवत्सरेण जानीयाद्देहन्यासमुपस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2095581, "chapter_id": 3039, "verse_number": "१३-१६९-५", "content_sanskrit": "कनीनिकायामशिरःपुरुषं यदि पश्यति।\nजानीयात्षट्सु मासेषु देहन्यासमुपस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2095582, "chapter_id": 3039, "verse_number": "१३-१६९-६", "content_sanskrit": "कर्णौ पिधाय हस्ताभ्यां शब्दं न शृणुयाद्यदि।\nविजानीयात्तु मासेन देहन्यासमुपस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2095583, "chapter_id": 3039, "verse_number": "१३-१६९-७", "content_sanskrit": "आमगन्धमुपाघ्राति सुरभिं प्राप्य भास्वरम्।\nदेवतायतनस्थोपि सप्तरात्रेण मृत्युभाक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2095584, "chapter_id": 3039, "verse_number": "१३-१६९-८", "content_sanskrit": "सर्वाङ्गधारणावस्थां धारयेत समाहितः।\nयथा स मृत्युं जयति नान्यथेह महेश्वर।\nयदि जीवितुमिच्छेत चिरकालं महामुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2095585, "chapter_id": 3039, "verse_number": "१३-१६९-९", "content_sanskrit": "अथ नेच्छेच्चिरं कालं त्यजेदात्मानमात्मना।\nकेवलं चिन्तयानस्तु निष्कलं स निरामयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2095586, "chapter_id": 3039, "verse_number": "१३-१६९-१०", "content_sanskrit": "अथ तं निर्विकारं तु प्रकृते परमं शुचिः।\nपुरुषं देहसाधर्म्यं देहन्यासमुपाश्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2095587, "chapter_id": 3039, "verse_number": "१३-१६९-११", "content_sanskrit": "जाग्रतो हि मयोक्तानि तवारिष्टानि तत्वतः।\nधारणाच्चैव सर्वाङ्गे मृत्यु जीयात्सुरर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2095588, "chapter_id": 3039, "verse_number": "१३-१६९-१२", "content_sanskrit": "एकत्वदर्शनं भूयो नानात्वं च निबोध मे।\nअक्षरं च क्षरं चैव चतुष्टयविधानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2095589, "chapter_id": 3039, "verse_number": "१३-१६९-१३", "content_sanskrit": "अव्यक्तादीनि तत्वानि सर्वाण्येव महाद्युते।\nआहुश्चतुर्विंशतितमं विकारपुरुषान्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2095590, "chapter_id": 3039, "verse_number": "१३-१६९-१४", "content_sanskrit": "एकत्वदर्शनं चैव नानात्वेन वरं स्मृतम्।\nपञ्चविंशतिवर्गः स्यादपवर्गोऽजरामरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2095591, "chapter_id": 3039, "verse_number": "१३-१६९-१५", "content_sanskrit": "स निर्विकारः पुरुषस्तत्वेनैवोपदिश्यते।\nस एव पञ्चविंशस्तु विकारः पुरुषः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2095592, "chapter_id": 3039, "verse_number": "१३-१६९-१६", "content_sanskrit": "यद्येष निर्विकारः स्यात्तत्वं न तु भवेद्भव।\nविकारो विद्यमानस्तु तत्वसंज्ञकमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2095593, "chapter_id": 3039, "verse_number": "१३-१६९-१७", "content_sanskrit": "यद्योषोऽव्यक्ततां नैति व्यतिरेकान्न संशयः।\nतथा भवति निस्तत्वस्तथा सत्वस्तथागुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2095594, "chapter_id": 3039, "verse_number": "१३-१६९-१८", "content_sanskrit": "विकारगुणसंत्यागात्प्रकृत्यन्यत्वता शुचिः।\nतदा नानात्वतामेति सर्गहीनोऽपवर्गभाक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2095595, "chapter_id": 3039, "verse_number": "१३-१६९-१९", "content_sanskrit": "बोध्यमानः प्रबुध्येत समो भवति बुद्धिमान्।\nअक्षरश्च भवत्येष यथावा च्युतवान्क्षणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2095596, "chapter_id": 3039, "verse_number": "१३-१६९-२०", "content_sanskrit": "अव्यक्ताव्यक्तिरुक्ता स्यान्निर्गुणस्य गुणाकरात्।\nएतदेकत्वनानात्वमक्षरः क्षर एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2095597, "chapter_id": 3039, "verse_number": "१३-१६९-२१", "content_sanskrit": "व्याख्यातं तव शूलाङ्क तथारिष्टानि चैव हि।\nविमोक्षलक्षणं शेषं तदपीह ब्रवीमि ते।\nयं ज्ञात्वा यतयः प्राप्ताः केवलत्वमनामयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2095598, "chapter_id": 3039, "verse_number": "१३-१६९-२२", "content_sanskrit": "साङ्ख्याश्चाप्यथ योगाश्च दग्धपङ्का गतज्वराः।\nअमूर्तित्वमनुप्राप्ता निर्गुणा निर्भया भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2095599, "chapter_id": 3039, "verse_number": "१३-१६९-२३", "content_sanskrit": "विपाप्मानो महादेव मुक्ताः संसारसागरात्।\nसरणे प्रजनादाने गुणानां प्रकृतिः सदा।\nपरा प्रमत्ता सततमेतावत्कार्यकारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2095600, "chapter_id": 3039, "verse_number": "१३-१६९-२४", "content_sanskrit": "असच्चैव च सच्चैव कुरुते स पुनः पुनः।\nचैतन्येन पुराणेन चेतनाचेतनात्परः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2095601, "chapter_id": 3039, "verse_number": "१३-१६९-२५", "content_sanskrit": "यस्तु चेतयते चेतो मनसा चैकबुद्धिकम्।\nस नैव सन्न चैवासन्सदसन्न च संस्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2095602, "chapter_id": 3039, "verse_number": "१३-१६९-२६", "content_sanskrit": "व्यतिरिक्तश्च शुद्धश्च सोऽन्यश्चाप्रकृतिस्तथा।\nउपेक्षकश्च प्रकृतेर्विकारपुरुषः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2095603, "chapter_id": 3039, "verse_number": "१३-१६९-२७", "content_sanskrit": "विकारपुरुषेणैषा संयुक्ता सृजते जगत्।\nपुनराददते चैव गुणानामन्यथात्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2095604, "chapter_id": 3039, "verse_number": "१३-१६९-२८", "content_sanskrit": "मत्स्योदकात्ससंज्ञातः प्रकृतेरेव कर्मणः।\nतद्वत्क्षेत्रसहस्राणि स एव प्रकरिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2095605, "chapter_id": 3039, "verse_number": "१३-१६९-२९", "content_sanskrit": "क्षेत्रप्रलयतज्ज्ञस्तु क्षेत्रज्ञ इति चोच्यते।\nसयोगो नित्य इत्याहुर्ये जनास्तत्वदर्शिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2095606, "chapter_id": 3039, "verse_number": "१३-१६९-३०", "content_sanskrit": "एवमेष ह्यसत्सच्च विकारपुरुषः स्मृतः।\nविकारापद्यमानं तु विकृतिं प्रवदन्ति नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2095607, "chapter_id": 3039, "verse_number": "१३-१६९-३१", "content_sanskrit": "यदा त्वेष विकारस्य प्रकृतानिति मन्यते।\nतदा विकारतामेति विकारान्यत्वतां व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2095608, "chapter_id": 3039, "verse_number": "१३-१६९-३२", "content_sanskrit": "प्रकृत्या च विकारैश्च व्यतिरिक्तो यदा भवेत्।\nशुचि यत्परमं शुद्धं प्रतिबुद्धं सनातनम्।\nअयुक्तं निष्कलं शुद्धमव्ययं चाजरामरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2095609, "chapter_id": 3039, "verse_number": "१३-१६९-३३", "content_sanskrit": "समेत्य तेन शुद्धेन बुध्यमानः स भास्वरः।\nविमोक्षं भजते व्यक्तादप्रबुद्धादचेतनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2095610, "chapter_id": 3039, "verse_number": "१३-१६९-३४", "content_sanskrit": "उदुम्बराद्वा मशकः प्रलयान्निर्गतो यथा।\nतथाऽव्यक्तस्य संत्यागान्निर्ममः पञ्च विंशकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2095611, "chapter_id": 3039, "verse_number": "१३-१६९-३५", "content_sanskrit": "यथा पुष्करपर्णस्थो जलबिन्दुर्न संश्लिषेत्।\nतथैवाव्यक्तविषये न लिप्येत्पञ्चविंशकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2095612, "chapter_id": 3039, "verse_number": "१३-१६९-३६", "content_sanskrit": "आकाश इव निःसङ्गस्तथा सङ्गस्त्था वरः।\nपञ्चविंशतिमो बुद्धो बुद्धेनि समतां गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2095613, "chapter_id": 3039, "verse_number": "१३-१६९-३७", "content_sanskrit": "एतद्धि प्रकृतं ज्ञानं तत्वतश्च समुत्थितम्।\nपूर्वजेभ्यस्तथोत्पन्नं ब्रह्मजेभ्यस्तथानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2095614, "chapter_id": 3039, "verse_number": "१३-१६९-३८", "content_sanskrit": "आदिसर्गो महाबाहो तामसेनावृतं परम्।\nप्रतिष्टावयवंदेवमभेद्यमजरामरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2095615, "chapter_id": 3039, "verse_number": "१३-१६९-३९", "content_sanskrit": "सनकः सनन्दनश्चैवि तृतीयश्च सनातनः।\nते विदुः परमं धर्ममव्ययं व्ययधर्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2095616, "chapter_id": 3039, "verse_number": "१३-१६९-४०", "content_sanskrit": "अव्यक्तात्परमात्सूक्ष्मादव्रणान्मूर्तिसंज्ञकात्।\nक्षेत्रज्ञो भगवानास्ते नरायणपरायणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2095617, "chapter_id": 3039, "verse_number": "१३-१६९-४१", "content_sanskrit": "अस्माकं सहजातानामुत्पन्नं ज्ञानमुत्तमम्।\nएते हि मूर्तिमन्तो वै लोकान्प्रविचरामहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2095618, "chapter_id": 3039, "verse_number": "१३-१६९-४२", "content_sanskrit": "पुनःपुनः प्रजाता वै तत्रतत्र पिनाकधृक्।\nद्वन्द्वैर्विरज्यमानस्य ज्ञानमुत्पन्नमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2095619, "chapter_id": 3039, "verse_number": "१३-१६९-४३", "content_sanskrit": "कपिलान्मूलआचार्यात्तत्वबुद्धिविनिश्चयम्।\nयोगसांख्यमवाप्तं मे कार्त्स्न्येन मुनिसत्तमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2095620, "chapter_id": 3039, "verse_number": "१३-१६९-४४", "content_sanskrit": "तेन संबोधिताः शिष्या बहवस्तत्वदर्शिनः।\nतद्बुद्ध्वा बहवः शिष्या मयाप्येतन्निदर्शिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2095621, "chapter_id": 3039, "verse_number": "१३-१६९-४५", "content_sanskrit": "जन्ममृत्युहरं तथ्यं ज्ञानं ज्ञेयं सनातनम्।\nयज्ज्ञात्वा नानुशोचन्ति तत्वज्ञाना निरिन्द्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2095622, "chapter_id": 3039, "verse_number": "१३-१६९-४६", "content_sanskrit": "शुद्धबीजमलाश्चैव विपङ्का वै निरक्षराः।\nस्वतन्त्रास्ते स्वतन्त्रेण सम्मिता निष्कलाः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2095623, "chapter_id": 3039, "verse_number": "१३-१६९-४७", "content_sanskrit": "शाश्वताश्चाव्ययाश्चैव तमोग्राह्याश्च भास्वर।\nविपाप्मानस्तथा सर्वे सत्वस्थाश्चापि निर्व्रणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2095624, "chapter_id": 3039, "verse_number": "१३-१६९-४८", "content_sanskrit": "विमुक्ताः केवलाश्चैव वीतमोहभयास्तथा।\nअमूर्तास्ते महाभाग सर्वे च विगतज्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2095625, "chapter_id": 3039, "verse_number": "१३-१६९-४९", "content_sanskrit": "हिरण्यनाभस्त्रिशिरास्तथा प्रह्लादभास्करौ।\nवसुर्विश्वावसुश्चैव सार्धं पञ्चशिखस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2095626, "chapter_id": 3039, "verse_number": "१३-१६९-५०", "content_sanskrit": "गार्ग्योऽथासुरिरावन्त्यो गौतमो वृत एव च।\nकात्यायनोऽथ नमुचिर्हरिश्च दमनश्चि ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2095627, "chapter_id": 3039, "verse_number": "१३-१६९-५१", "content_sanskrit": "एते चान्ये च बहवस्तत्वमेवोपदर्शिताः।\nकेचिन्मुक्ताः स्थिताः केचिच्छन्दतश्चापरे मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2095628, "chapter_id": 3039, "verse_number": "१३-१६९-५२", "content_sanskrit": "दर्शितास्त्रिविधं बन्धं विमोक्षं त्रिविधं तथा।\nअज्ञानं चैव रागश्च संयोगं प्राकृतं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2095629, "chapter_id": 3039, "verse_number": "१३-१६९-५३", "content_sanskrit": "एतेभ्यो बन्धनं प्रोक्तं विमोक्षमपि मे शृणु।\nपरितस्तावता सम्यक्सम्बन्धो यावता कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2095630, "chapter_id": 3039, "verse_number": "१३-१६९-५४", "content_sanskrit": "कृत्स्नक्षयपरित्यागाद्विमोक्ष इति नः श्रुतिः।\nनिवृत्तः सर्वसङ्गेभ्यः केवलः पुरुषोऽमलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2095631, "chapter_id": 3039, "verse_number": "१३-१६९-५५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2095632, "chapter_id": 3039, "verse_number": "", "content_sanskrit": "इत्येवमुक्त्वा भगवानीश्वराय महात्मने।\nसनत्कुमारः प्रययावाकाशं समुपाश्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]