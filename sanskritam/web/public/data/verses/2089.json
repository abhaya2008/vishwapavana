[{"id": 2049588, "chapter_id": 2089, "verse_number": "७-१६-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2049589, "chapter_id": 2089, "verse_number": "७-१६-१", "content_sanskrit": "तद्बलं सुमहद्दीर्णं त्वदीयं प्रेक्ष्य वीर्यवान्।\nदधारैको रणे पाण्डून्वृषसेनोऽस्त्रमायया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2049590, "chapter_id": 2089, "verse_number": "७-१६-२", "content_sanskrit": "शरा दश दिशो मुक्ता वृषसेनेन संयुगे।\nविचेरुस्ते विनिर्भिद्य नरवाजिरथद्विपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2049591, "chapter_id": 2089, "verse_number": "७-१६-३", "content_sanskrit": "तस्य दीप्ता महाबाणा विविश्चेरुः सहस्रशः।\nभानोरिव महाराज घर्मकाले मरीचयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2049592, "chapter_id": 2089, "verse_number": "७-१६-४", "content_sanskrit": "तेनार्दिता महाराज रथिनः सादिनस्तथा।\nनिपेतुरुर्व्यां सहसा वातभग्ना इव द्रुमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2049593, "chapter_id": 2089, "verse_number": "७-१६-५", "content_sanskrit": "हयौघांश्च रथौघांश्च गजौघांश्च महारथः।\nअपातयद्रणे राजञ्शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2049594, "chapter_id": 2089, "verse_number": "७-१६-६", "content_sanskrit": "दृष्ट्वा तमेकं समरे विचरन्तमभीतवत्।\nसहिताः सर्वराजानः परिवव्रुः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2049595, "chapter_id": 2089, "verse_number": "७-१६-७", "content_sanskrit": "नाकुलिस्तु शतानीको वृषसेनं समभ्ययात्।\nविव्याध चैनं दशभिर्नाराचैर्मर्मभेदिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2049596, "chapter_id": 2089, "verse_number": "७-१६-८", "content_sanskrit": "तस्य कर्णात्मजश्चापं छित्त्वा केतुमपातयत्।\nतं भ्रातरं परीप्सन्तो द्रौपदेयाः समभ्ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2049597, "chapter_id": 2089, "verse_number": "७-१६-९", "content_sanskrit": "कर्णात्मजं शरव्रातैरदृश्यं चक्रुरञ्जसा।\nतान्नदन्तोऽभ्यधावन्त द्रोणपुत्रमुखा रथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2049598, "chapter_id": 2089, "verse_number": "७-१६-१०", "content_sanskrit": "छादयन्तो महाराज द्रौपदेयान्महारथान्।\nशरैर्नानाविधैस्तूर्णं पर्वताञ्जलदा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2049599, "chapter_id": 2089, "verse_number": "७-१६-११", "content_sanskrit": "तान्पाण्डवाः प्रत्यगृह्णंस्त्वरिताः पुत्रगृद्धिनः।\nपाञ्चालाः केकया मत्स्याः सृञ्जयाश्चोद्यतायुधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2049600, "chapter_id": 2089, "verse_number": "७-१६-१२", "content_sanskrit": "तद्युद्धमभवद्धोरं सुमहद्रोमहर्षणम्।\nत्वदीयैः पाण्डुपुत्राणां देवानामिव दानवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2049601, "chapter_id": 2089, "verse_number": "७-१६-१३", "content_sanskrit": "एवं युयुधिरे वीराः संरब्धाः कुरुपाण्डवाः।\nपरस्परमुदीक्षन्तः परस्परकृतागसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2049602, "chapter_id": 2089, "verse_number": "७-१६-१४", "content_sanskrit": "तेषां ददृशिरे कोपाद्वपूम्ष्यमिततेजसाम्।\nयुयुत्सूनामिवाकाशे पतत्त्रिवरभोगिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2049603, "chapter_id": 2089, "verse_number": "७-१६-१५", "content_sanskrit": "भीमकर्णकृपद्रोणद्रौणिपार्षतसात्यकैः।\nबभासे स रणोद्देशः कालसूर्यैरिवोदितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2049604, "chapter_id": 2089, "verse_number": "७-१६-१६", "content_sanskrit": "`प्रजानां संक्षये घोरे यथा सूर्योदयो भवेत्।\nशूराणामुदयस्तद्वदासीत्पुरुषसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2049605, "chapter_id": 2089, "verse_number": "७-१६-१७", "content_sanskrit": "तदासीत्तुमुलं युद्धं निघ्नतामितरेतरम्।\nमहाबलानां बलिभिर्दानवानां यथा सुरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2049606, "chapter_id": 2089, "verse_number": "७-१६-१८", "content_sanskrit": "ततो युधिष्ठिरानीकमुद्धूतार्णवनिःस्वनम्।\nत्वदीयमवधीत्सैन्यं संप्रद्रुतमहारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2049607, "chapter_id": 2089, "verse_number": "७-१६-१९", "content_sanskrit": "तत्प्रभग्नं बलं दृष्ट्वा शत्रुभिर्भृशमर्दितम्।\nअलं द्रुतेन वः शूरा इति द्रोणोऽभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2049608, "chapter_id": 2089, "verse_number": "७-१६-२०", "content_sanskrit": "`भारद्वाजममर्षश्च विक्रमश्च समाविशत्।\nसमुद्धृत्य निषङ्गाच्च धनुर्ज्यामवमृज्य च।\nमहाशरधनुष्पाणिर्यन्तारमिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2049609, "chapter_id": 2089, "verse_number": "७-१६-२१", "content_sanskrit": "सारथे याहि यत्रैष पाण्डरेण विराजता।\nध्रियमाणेन च्छेण राजा तिष्ठति धर्मराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2049610, "chapter_id": 2089, "verse_number": "७-१६-२२", "content_sanskrit": "तदेतद्दीर्यते सैन्यं धार्तराष्ट्रमनेकधा।\nएतत्संस्तम्भयिष्यामि प्रतिवार्य युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2049611, "chapter_id": 2089, "verse_number": "७-१६-२३", "content_sanskrit": "न हि मामभिवर्षन्तं संयुगे तात पाण्डवाः।\nमात्स्यपाञ्चालराजानः सर्वे च सहसोमकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2049612, "chapter_id": 2089, "verse_number": "७-१६-२४", "content_sanskrit": "अर्जुनो मत्प्रसादाद्धि महास्त्राणि समाप्तवान्।\nन मामुत्सहते तात न भीमो न च सात्यकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2049613, "chapter_id": 2089, "verse_number": "७-१६-२५", "content_sanskrit": "मत्प्रसादाद्धि बीभत्सुः परमेष्वासतां गतः।\nममैवास्त्रं विजानाति धृष्टद्युम्नोऽपि पार्षतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2049614, "chapter_id": 2089, "verse_number": "७-१६-२६", "content_sanskrit": "नायं संरक्षितुं कालः प्राणांस्तात जयैषिणा।\nयाहि सर्गं पुरस्कृत्य यशसे च जयाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2049615, "chapter_id": 2089, "verse_number": "७-१६-२७x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2049616, "chapter_id": 2089, "verse_number": "७-१६-२७", "content_sanskrit": "एवं सञ्चोदितो यन्ता द्रोणमभ्यवहत्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2049617, "chapter_id": 2089, "verse_number": "७-१६-२८", "content_sanskrit": "तदाऽश्वहृदयेनाश्वानभिमन्त्र्याशु हर्षयन्।\nरथेन सवरूथेन भास्वरेण विराजता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2049618, "chapter_id": 2089, "verse_number": "७-१६-२९", "content_sanskrit": "तं करूशाश्च मात्स्याश्च चेदयश्च ससात्वताः।\nपाण्डवाश्च सपाञ्चालाः सहिताः पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2049619, "chapter_id": 2089, "verse_number": "७-१६-३०", "content_sanskrit": "ततः शोणहयः क्रुद्धश्चतुर्दन्त इव द्विपः।\nप्रविश्य पाण्डवानीकं युधिष्ठिरमुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2049620, "chapter_id": 2089, "verse_number": "७-१६-३१", "content_sanskrit": "तमाविध्यच्छितैर्बाणैः कङ्कपत्रैर्युधिष्ठिरः।\nतस्य द्रोणो धनुश्छित्वा तं द्रुतं समुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2049621, "chapter_id": 2089, "verse_number": "७-१६-३२", "content_sanskrit": "चक्ररक्षः कुमारस्तु पाञ्चालानां यशस्करः।\nदधार द्रोणमायान्तं वेलेव सरितां पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2049622, "chapter_id": 2089, "verse_number": "७-१६-३३", "content_sanskrit": "द्रोणं निवारितं दृष्ट्वा कुमारेण द्विजर्षभम्।\nसिंहनादरवो ह्यासीत्साधुसाध्विति भाषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2049623, "chapter_id": 2089, "verse_number": "७-१६-३४", "content_sanskrit": "कुमारस्तु ततो द्रोणं सायकेन महाहवे।\nविव्याधोरसि सङ्क्रुद्धः सिंहवच्च नदन्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2049624, "chapter_id": 2089, "verse_number": "७-१६-३५", "content_sanskrit": "संवार्य च रणे द्रोणं कुमारस्तु महाबलः।\nशरैरनेकसाहस्रैः कृतहस्तो जितश्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2049625, "chapter_id": 2089, "verse_number": "७-१६-३६", "content_sanskrit": "तं शूरमार्यव्रतिनं मन्त्रास्त्रेषु कृतश्चमम्।\nचक्ररक्षतं परामृद्रात्कुमारं द्विजपुङ्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2049626, "chapter_id": 2089, "verse_number": "७-१६-३७", "content_sanskrit": "स मध्यं प्राप्य सैन्यानां सर्वाः प्रविचरन्दिशः।\nतव सैन्यस्य गोप्तासीद्भारद्वाजो द्विजर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2049627, "chapter_id": 2089, "verse_number": "७-१६-३८", "content_sanskrit": "शिखण्डिनं द्वादशभिर्विंशत्या चोत्तमौजसम्।\nनकुलं पञ्चभिर्विद्ध्वा सहदेवं च सप्तभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2049628, "chapter_id": 2089, "verse_number": "७-१६-३९", "content_sanskrit": "युधिष्ठिरं द्वादशभिर्द्रौपदेयांस्त्रिभिस्त्रिभिः।\nसात्यकिं पञ्चभिर्विद्ध्वा मत्स्यं च दशभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2049629, "chapter_id": 2089, "verse_number": "७-१६-४०", "content_sanskrit": "व्यक्षोभयद्रणे योधान्यथामुख्यमभिद्रवन्।\nअभ्यवर्ततं सम्प्रेप्सुः कुन्तीपुत्रं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2049630, "chapter_id": 2089, "verse_number": "७-१६-४१", "content_sanskrit": "युगन्धरस्ततो राजन्भारद्वाजं महारथम्।\nवारयामास सङ्क्रुद्वं वातोद्धतमिवार्णवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2049631, "chapter_id": 2089, "verse_number": "७-१६-४२", "content_sanskrit": "युधिष्ठिरं स विद्ध्वा तु शरैः सन्नतपर्वभिः।\nयुगन्धरं तु भल्लने रथनीडादपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2049632, "chapter_id": 2089, "verse_number": "७-१६-४३", "content_sanskrit": "`तं विजित्य महातेजा भारद्वाजो महामनाः।\nअभ्यवर्तत सम्प्रेप्सुः कुन्तीपुत्रं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2049633, "chapter_id": 2089, "verse_number": "७-१६-४४", "content_sanskrit": "ततो विराटद्रुपदौ केकयाः सात्यकिः शिबिः।\nव्याघ्रदत्तश्च पाञ्चल्यः सिंहसेनश्च वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2049634, "chapter_id": 2089, "verse_number": "७-१६-४५", "content_sanskrit": "एते चान्ये च बहवः परीप्सन्तो युधिष्ठिरम्।\nआवव्रुस्तस्य पन्थानं किरन्तः सायकान्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2049635, "chapter_id": 2089, "verse_number": "७-१६-४६", "content_sanskrit": "व्याघ्रदत्तस्तु पाञ्चाल्यो द्रोणं विव्याध मार्गणैः।\nपञ्चाशता शितै राजंस्तत उच्चुक्रुशुर्जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2049636, "chapter_id": 2089, "verse_number": "७-१६-४७", "content_sanskrit": "त्वरितं सिंहसेनस्तु द्रोणं विद्ध्वा महारथम्।\nप्राहसत्सहसा हृष्टस्त्रासयन्वै महारथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2049637, "chapter_id": 2089, "verse_number": "७-१६-४८", "content_sanskrit": "ततो विष्फार्य नयने धनुर्ज्यामवमृज्य च।\nतलशब्दं महत्कृत्वा द्रोणस्तं समुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2049638, "chapter_id": 2089, "verse_number": "७-१६-४९", "content_sanskrit": "ततस्तु सिंहसेनस्य शिरः कायात्सकुण्डलम्।\nव्याघ्रदत्तस्य चाक्रम्य भल्लाभ्यामाहरद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2049639, "chapter_id": 2089, "verse_number": "७-१६-५०", "content_sanskrit": "तान्प्रमृज्य शरव्रातैः पाण्डवानां महारथान्।\nयुधिष्ठिररथाभ्याशे तस्थौ मृत्युरिवान्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2049640, "chapter_id": 2089, "verse_number": "७-१६-५१", "content_sanskrit": "ततोऽभवन्महाशब्दो राजन्यौधिष्ठिरे बले।\nहृतो राजेति योधानां समीपस्थे यतव्रते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2049641, "chapter_id": 2089, "verse_number": "७-१६-५२", "content_sanskrit": "अब्रुवन्सैनिकास्तत्र दृष्ट्वा द्रोणस्य विक्रमम्।\nअद्य राजा धार्तराष्ट्रः कृतार्थो वै भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2049642, "chapter_id": 2089, "verse_number": "७-१६-५३", "content_sanskrit": "अस्मिन्महूर्ते द्रोणस्तु पाण्डवं गृह्य हर्षितः।\nआगमिष्यति नो नूनं धार्तराष्ट्रस्य संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2049643, "chapter_id": 2089, "verse_number": "७-१६-५४", "content_sanskrit": "एवं सञ्जल्पतां तेषां तावकानां महारथः।\nआयाज्जवेन कौन्तेयो रथघोषेण नादयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2049644, "chapter_id": 2089, "verse_number": "७-१६-५५", "content_sanskrit": "शोणितोदां रथावर्तां कृत्वा विशसने नदीम्।\nशूरास्थिचयसङ्कीर्णां प्रेतकूलापहारिणीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2049645, "chapter_id": 2089, "verse_number": "७-१६-५६", "content_sanskrit": "तां शरौघमहाफेनां प्रासमत्स्यसमाकुलाम्।\nनदीमुत्तीर्य वेगेन कुरून्विद्राव्य पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2049646, "chapter_id": 2089, "verse_number": "७-१६-५७", "content_sanskrit": "ततः किरीटि सहसा द्रोणानीकमुपाद्रवत्।\nछादयन्निषुजालेन महता मोहयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2049647, "chapter_id": 2089, "verse_number": "७-१६-५८", "content_sanskrit": "शीघ्रमभ्यस्यतो बाणान्सन्दधानस्य चानिशम्।\nनान्तरं ददृशे कश्चित्कौन्तेयस्य यशस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2049648, "chapter_id": 2089, "verse_number": "७-१६-५९", "content_sanskrit": "न दिशो नान्तरिक्षं च न द्यौर्नैव च मेदिनी।\nअदृश्यन्त महाराज बाणभूता इवाभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2049649, "chapter_id": 2089, "verse_number": "७-१६-६०", "content_sanskrit": "नादृश्यत तदा राजंस्तत्र किञ्चन संयुगे।\nबाणान्धकारे महति कृते गाण्डीवधन्वना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2049650, "chapter_id": 2089, "verse_number": "७-१६-६१", "content_sanskrit": "सूर्ये चास्तमनुप्राप्ते तमसा चाभिसंवृते।\nनाज्ञायत तदा शत्रुर्न सुहृन्न च कश्चन।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2049651, "chapter_id": 2089, "verse_number": "७-१६-६२", "content_sanskrit": "ततोऽवहारं चक्रुस्ते द्रोणदुर्योधनादयः।\nतान्विदित्वा पुनस्त्रस्ता न युद्धमनसः परान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2049652, "chapter_id": 2089, "verse_number": "७-१६-६३", "content_sanskrit": "स्वान्यनीकानि बीभत्सुः शनकैरवहारयत्।\nततोऽभितुष्टुवुः पार्थं प्रहृष्टाः पाण्डुसृञ्जयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2049653, "chapter_id": 2089, "verse_number": "७-१६-६४", "content_sanskrit": "पाञ्चालाश्च मनोज्ञाभिर्वाग्भिः सूर्यमिवर्षयः।\nएं स्वशिबिरं प्रायाज्जित्वा शत्रून्धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2049654, "chapter_id": 2089, "verse_number": "७-१६-६५", "content_sanskrit": "पृष्ठतः सर्वसैन्यानां मुदितो वै सकेशवः॥\nमसारगल्वर्कमुवर्णरूपैर्वज्रप्रवालस्फटिकैश्च मुख्यैः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2049655, "chapter_id": 2089, "verse_number": "७-१६-६६", "content_sanskrit": "चित्रे रथे पाण्डुसुतो बभासे नक्षत्रचित्रे वियतीव चन्द्रः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2049656, "chapter_id": 2089, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि द्रोणाभिषेकपर्वणि एकादशदिवसयुद्धे षोडशोऽध्यायः॥ १६ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१६-१ अस्त्रमायया अस्त्रकौशलेन॥ ५-१६-१४ पतत्त्रिवरभोगिनामिव पतत्त्रिवरो गरुडः। भोगिनः सर्पाः॥ ५-१६-१९ द्रुतेन पलायितेन॥ ५-१६-५५ विशसने युद्धे॥ ५-१६-६६ मसारः इन्द्रनीलः। गल्वर्कः पद्मरागः॥ ५-१६-१६ षोडशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]