[{"id": 2027484, "chapter_id": 1591, "verse_number": "३-२२९-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2027485, "chapter_id": 1591, "verse_number": "३-२२९-१", "content_sanskrit": "ततः प्रकल्प्य पुत्रत्वे स्कन्दं मातृगणोऽगमत्।\nकाकी च हलिमा चैव माता चाथ हली तथा।\nआर्या बाला च धात्री च सप्तैता शिशुमातरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2027486, "chapter_id": 1591, "verse_number": "३-२२९-२", "content_sanskrit": "एतासां वीर्यसंपन्नः शिशुर्नामातिदारुणः।\nस्कन्दप्रसादजः पुत्रो लोहिताक्षो भयंकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2027487, "chapter_id": 1591, "verse_number": "३-२२९-३", "content_sanskrit": "एष वीरोऽष्टमः प्रोक्तः स्कन्दो मातृगणोद्भवः।\nछागवक्रेण सहितो नवमः परिकीर्त्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2027488, "chapter_id": 1591, "verse_number": "३-२२९-४", "content_sanskrit": "षष्ठं छागमयं वक्रं स्कन्दस्यैवेति विद्धि तम्।\nषट्शिरोभ्यन्तरं राजन्नित्यं मातृगणार्चितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2027489, "chapter_id": 1591, "verse_number": "३-२२९-५", "content_sanskrit": "षण्णां तु प्रवरं तस्य शीर्षाणामिह शब्द्यते।\nशक्तिं येनासृजद्दिव्यां भद्रशाख इति स्म ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2027490, "chapter_id": 1591, "verse_number": "३-२२९-६", "content_sanskrit": "इत्येतद्द्विविधाकारं वृत्तं शुक्लस्य पञ्चमीम्।\nतत्र युद्धं महाघोरं वृत्तं षष्ठ्यां जनाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2027491, "chapter_id": 1591, "verse_number": "३-२२९-७", "content_sanskrit": "उपविष्टं तु तं स्कन्दमामुक्तकवचस्रजम्।\nहिरण्यचूडमुकुटं हिरण्यांक्षं महाप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2027492, "chapter_id": 1591, "verse_number": "३-२२९-८", "content_sanskrit": "लोहिताम्बरसंवीतं तीक्ष्णदंष्ट्रं मनोरमम्।\nसर्वलक्षणसंपन्नं त्रैलोक्यस्यापि सुप्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2027493, "chapter_id": 1591, "verse_number": "३-२२९-९", "content_sanskrit": "ततस्तं वरदं शूरं युवानं मृष्टकुण्डलम्।\nअभजत्पद्मरूपा श्रीः स्वयमेव शरीरिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2027494, "chapter_id": 1591, "verse_number": "३-२२९-१०", "content_sanskrit": "श्रिया जुष्टः पृथुयशाः स कुमारो वरस्तदा।\nनिषण्णो दृश्यते भूतैः पौर्णमास्यां यथा शशी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2027495, "chapter_id": 1591, "verse_number": "३-२२९-११", "content_sanskrit": "अपूजयन्महात्मानो ब्राह्मणास्तं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2027496, "chapter_id": 1591, "verse_number": "३-२२९-१२", "content_sanskrit": "इदमाहुस्तदा चैव स्कन्दं तत्र महर्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2027497, "chapter_id": 1591, "verse_number": "३-२२९-१३", "content_sanskrit": "हिरण्यवर्ण भद्रं ते लोकानां शंकरो भव।\nत्वया षड्रात्रजातेन सर्वे लोका वशीकृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2027498, "chapter_id": 1591, "verse_number": "३-२२९-१४", "content_sanskrit": "अभयंच पुनर्दत्तं त्वयैवैषां सुरोत्तम।\nतस्मादिन्द्रो भवानस्तु त्रैलोक्यस्याभयंकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2027499, "chapter_id": 1591, "verse_number": "३-२२९-१५x", "content_sanskrit": "स्कन्द उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2027500, "chapter_id": 1591, "verse_number": "३-२२९-१५", "content_sanskrit": "किमिन्द्रः सर्वलोकानां करोतीह तपोधनाः।\nकथं देवगणांश्चैव पाति नित्यं सुरेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2027501, "chapter_id": 1591, "verse_number": "३-२२९-१६x", "content_sanskrit": "ऋषय ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2027502, "chapter_id": 1591, "verse_number": "३-२२९-१६", "content_sanskrit": "इन्द्रो दधाति भूतानां बलं तेजः प्रजाः सुखम्।\nतुष्टः प्रयच्छति तथा सर्वान्कामान्सुरेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2027503, "chapter_id": 1591, "verse_number": "३-२२९-१७", "content_sanskrit": "दुर्वृत्तानां संहरति व्रतस्थानां प्रयच्छति।\nअनुशास्ति च भूतानि कार्येषु बलसूदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2027504, "chapter_id": 1591, "verse_number": "३-२२९-१८", "content_sanskrit": "असूर्ये च भवेत्सूर्यस्तथाऽचनद्रे च चन्द्रमाः।\nभवत्यग्निश्च वायुश्च पृथिव्यापश्च स्वं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2027505, "chapter_id": 1591, "verse_number": "३-२२९-१९", "content_sanskrit": "एतदिन्द्रेण कर्तव्यमिन्द्रे हि विपुलं बलम्।\nत्वं च वीर बली श्रेष्ठस्तस्मादिन्द्रो भवस्व न ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2027506, "chapter_id": 1591, "verse_number": "३-२२९-२०x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2027507, "chapter_id": 1591, "verse_number": "३-२२९-२०", "content_sanskrit": "भवस्वेन्द्रो महाबाहो सर्वेषां नः सुखावहः।\nअभिषिच्यस्व चैवाद्य प्राप्तरूपोऽसि सत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2027508, "chapter_id": 1591, "verse_number": "३-२२९-२१x", "content_sanskrit": "स्कन्द उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2027509, "chapter_id": 1591, "verse_number": "३-२२९-२१", "content_sanskrit": "शाधि त्वमेव त्रैलोक्यमव्याग्रे निजये रतः।\nअहं ते किंकरः शक्र न ममेन्द्रत्वमीप्सितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2027510, "chapter_id": 1591, "verse_number": "३-२२९-२२x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2027511, "chapter_id": 1591, "verse_number": "३-२२९-२२", "content_sanskrit": "बलंतवाद्भुतं वीर त्वं देवानामरीञ्जहि।\nअवज्ञास्यन्ति मां लोका वीर्यण तव विस्मिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2027512, "chapter_id": 1591, "verse_number": "३-२२९-२३", "content_sanskrit": "इन्द्रत्वे तु स्थितं वीर बलहीनं पराजितम्।\n`त्वत्तेजसाऽवमंस्यन्ति लोका मां सुरसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2027513, "chapter_id": 1591, "verse_number": "३-२२९-२४", "content_sanskrit": "आवयोश्च मिथो भेदे प्रयतिष्यन्त्यतन्द्रिताः।\nभेदिते च त्वयि विभो लोको द्वैधमुपेष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2027514, "chapter_id": 1591, "verse_number": "३-२२९-२५", "content_sanskrit": "द्विधाभूतेषु लोकेषु निश्चितेष्वावयोस्तथा।\nविग्रहः संप्रवर्तेत भूतभेदान्महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2027515, "chapter_id": 1591, "verse_number": "३-२२९-२६", "content_sanskrit": "तत्र त्वं मां रणे तात यथाश्रद्धं विजेष्यसि।\nतस्मादिन्द्रो भवानेव भविता मा विचारय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2027516, "chapter_id": 1591, "verse_number": "३-२२९-२७x", "content_sanskrit": "स्कन्द उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2027517, "chapter_id": 1591, "verse_number": "३-२२९-२७", "content_sanskrit": "त्वमेव राजा भद्रं ते त्रैलोक्यस्य ममैव च।\nकरोमि किं च तेशक्र शासनात्तद्ब्रवीहि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2027518, "chapter_id": 1591, "verse_number": "३-२२९-२८x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2027519, "chapter_id": 1591, "verse_number": "३-२२९-२८", "content_sanskrit": "अहमिन्द्रो भविष्यामि तव वाक्यान्महाबल।\nयदि सत्यमिदं वाक्यं निश्चयाद्भाषितं त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2027520, "chapter_id": 1591, "verse_number": "३-२२९-२९", "content_sanskrit": "यदि वा शासनं स्कन्द कर्तुमिच्छसि मे शृणु।\nअभिषिच्यस्व देवानां सैनापत्ये महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2027521, "chapter_id": 1591, "verse_number": "३-२२९-३०x", "content_sanskrit": "स्कन्द उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2027522, "chapter_id": 1591, "verse_number": "३-२२९-३०", "content_sanskrit": "दानवानां विनाशाय देवानामर्थसिद्धये।\nगोब्राह्मणहितार्थाय सैनापत्येऽभिषिञ्च माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2027523, "chapter_id": 1591, "verse_number": "३-२२९-३१x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2027524, "chapter_id": 1591, "verse_number": "३-२२९-३१", "content_sanskrit": "सोऽभिषिक्तो मघवता सर्वैर्देवगणैः सह।\nअतीव शुशुभे तत्र पूज्यमानो महर्षिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2027525, "chapter_id": 1591, "verse_number": "३-२२९-३२", "content_sanskrit": "तत्र तत्काञ्चनं छत्रं ध्रियमाणं व्यरोचत।\nतथैव सुसमिद्धस्य पावकस्यात्ममण्डलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2027526, "chapter_id": 1591, "verse_number": "३-२२९-३३", "content_sanskrit": "विश्वकर्मकृता चास्य दिव्या माला हिरण्मयी।\nआबद्धा त्रिपुरघ्नेन स्वयमेव यशस्विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2027527, "chapter_id": 1591, "verse_number": "३-२२९-३४", "content_sanskrit": "आगम्य मनुजव्याघ्र सह देव्या परंतप।\nअर्चयामास सुप्रीतो भगवान्गोवृषध्वजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2027528, "chapter_id": 1591, "verse_number": "३-२२९-३५", "content_sanskrit": "रुद्रमग्निं द्विजाः प्राहू रुद्रसूनुस्ततस्तु सः।\n`कीर्त्यते सुमहातेजाः कुमारोऽद्भुतदर्शनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2027529, "chapter_id": 1591, "verse_number": "३-२२९-३६", "content_sanskrit": "रुद्रेण शुक्रमुत्सृष्टं तच्छ्वेतः पर्वतोऽभवत्।\nपावकस्येनद्रियं श्वेते कृत्तिकाभिः कृतं नगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2027530, "chapter_id": 1591, "verse_number": "३-२२९-३७", "content_sanskrit": "पूज्यमानं तु रुद्रेण दृष्ट्वा सर्वेदिवौकसः।\nरुद्रसूनुं ततः प्राहुर्गुहं गुणवतांवरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2027531, "chapter_id": 1591, "verse_number": "३-२२९-३८", "content_sanskrit": "अनुप्रविश्य रुद्रेण वह्निं जातो ह्ययं शिशुः।\nतत्र जातस्ततः स्कन्दो रुद्रसूनुस्ततोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2027532, "chapter_id": 1591, "verse_number": "३-२२९-३९", "content_sanskrit": "रुद्रस्य वह्नेः स्वाहायाः षण्णां स्त्रीणां च तेजसा।\nजातः स्कन्दः सुरश्रेष्ठो रुद्रसूनुस्ततोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2027533, "chapter_id": 1591, "verse_number": "३-२२९-४०", "content_sanskrit": "अरजे वाससी रक्ते वसानः पावकात्मजः।\nभाति दीप्तवपुः श्रमान्रक्ताभ्राभ्यामिवांशुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2027534, "chapter_id": 1591, "verse_number": "३-२२९-४१", "content_sanskrit": "कुक्कुटश्चाग्निना दत्तस्तस् केतुरलंकृतः।\nरथे समुच्छितो भाति कालाग्निरव लोहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2027535, "chapter_id": 1591, "verse_number": "३-२२९-४२", "content_sanskrit": "या चेष्टा सर्वभूतानां प्रभा शक्तिर्बलं तथा।\nअग्रतस्तस्य सा शक्तिर्देवानां जयवर्धनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2027536, "chapter_id": 1591, "verse_number": "३-२२९-४३", "content_sanskrit": "विवेश कवचं चास्य शरीरं सहजं तथा।\nयुध्यमानस्य देवस्य प्रादुर्भवति तत्सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2027537, "chapter_id": 1591, "verse_number": "३-२२९-४४", "content_sanskrit": "शक्तिर्धर्मो बलं तेजः कान्तत्वं सत्यमुन्नतिः।\nब्रह्मण्यत्वमसंमोहो भक्तानां परिरक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2027538, "chapter_id": 1591, "verse_number": "३-२२९-४५", "content_sanskrit": "निकृन्तनं च शत्रूणां लोकानां चाभिरक्षणम्।\nस्कन्देन सह जातानि सर्वाण्येव जनाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2027539, "chapter_id": 1591, "verse_number": "३-२२९-४६", "content_sanskrit": "एवं देवगणैः सर्वैः सोऽभिषिक्तः स्वलंकृतः।\nबभौ प्रतीतः सुमनाः परिपूर्णेन्दुदर्शनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2027540, "chapter_id": 1591, "verse_number": "३-२२९-४७", "content_sanskrit": "इष्टैः स्वाध्यायघोषैश्च देवतूर्यवरैरपि।\nदेवगन्धर्वगीतैश्च सर्वैरप्सरसां गणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2027541, "chapter_id": 1591, "verse_number": "३-२२९-४८", "content_sanskrit": "एतैश्चान्यैश्च बहुभिस्तुष्टैर्हृष्टैः स्वलंकृतः।\n[सुसंवृतः पिशाचानां गणैर्देवगणैस्तथा।]\nक्रीडन्भाति तदा देवैरभिषिक्तश्च पावकिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2027542, "chapter_id": 1591, "verse_number": "३-२२९-४९", "content_sanskrit": "अभिषिक्तं महासेनमपश्यन्त दिवौकसः।\nविनिहत्य तमः सूर्यं यथैवाभ्युदितं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2027543, "chapter_id": 1591, "verse_number": "३-२२९-५०", "content_sanskrit": "अथैनमभ्ययुः सर्वा देवसेनाः सहस्रशः।\nअस्माकं त्वं पतिरिति ब्रुवाणाः सर्वतो दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2027544, "chapter_id": 1591, "verse_number": "३-२२९-५१", "content_sanskrit": "ताः समासाद्य भगवान्सर्वभूतगणैर्वृतः।\nअर्चितस्तु स्तुतश्चैव सान्त्वयामास ता अपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2027545, "chapter_id": 1591, "verse_number": "३-२२९-५२", "content_sanskrit": "शतक्रतुश्चाभिषिच्य स्कन्दं सेनापतिं तदा।\nसस्मार तां देवसेनां या सा तेन विमोक्षिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2027546, "chapter_id": 1591, "verse_number": "३-२२९-५३", "content_sanskrit": "अयं तस्याः पतिर्नूनं विहितो ब्रह्मणा स्वयम्।\nसंचिन्त्य त्वानयामास देवसेनां ह्यलंकृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2027547, "chapter_id": 1591, "verse_number": "३-२२९-५४", "content_sanskrit": "स्कन्दं प्रोवाच बलभिदियं कन्या सुरोत्तम।\nअजाते त्वयि निर्दिष्टा तव पत्नी स्वयंभुवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2027548, "chapter_id": 1591, "verse_number": "३-२२९-५५", "content_sanskrit": "तस्मात्त्वमस्या विधिवत्पाणिं मन्त्रपुरस्कृतम्।\nगृहाण दक्षिणं देव्याः पाणिना पद्मवर्चसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2027549, "chapter_id": 1591, "verse_number": "३-२२९-५६", "content_sanskrit": "एवमुक्तः स जग्राह तस्याः पाणिं यथाविधि।\nबृहस्पतिर्मन्त्रविद्धि जजाप च जुहाव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2027550, "chapter_id": 1591, "verse_number": "३-२२९-५७", "content_sanskrit": "एवं स्कन्दस्य महिषीं देवसेनां विदुर्जनाः।\nषष्ठीं यां ब्राह्मणाः प्राहुर्लक्ष्मीमासां सुखप्रदाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2027551, "chapter_id": 1591, "verse_number": "३-२२९-५८", "content_sanskrit": "सिनीबालीं कुहूं चैव सद्वृत्तिमपराजिताम्।\n`इत्येवमादिभिर्देवी नामभिः परिकीर्त्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2027552, "chapter_id": 1591, "verse_number": "३-२२९-५९", "content_sanskrit": "यदा स्कन्दः पतिर्लब्धः शाश्वतो देवसेनया।\nतदा तमाश्रयल्लक्ष्मीः स्वयं देवी शरीरिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2027553, "chapter_id": 1591, "verse_number": "३-२२९-६०", "content_sanskrit": "श्रीजुष्टः पञ्चमीस्कन्दस्तस्माच्छ्रीः पञ्चमी स्मृता।\nषष्ठ्यां कृतार्थोऽभूद्यस्थात्तस्मात्षष्ठी महातिधिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2027554, "chapter_id": 1591, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि एकोनत्रिंशदधिद्विशततमोऽध्यायः ॥ २२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]