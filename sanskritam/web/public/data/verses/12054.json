[{"id": 50026091, "chapter_id": 12054, "verse_number": "1", "content_sanskrit": "स्वयमुद्देशसंयुक्तस्तदाद्यर्णपुरःसरः। सनतिः षडक्षरो मन्त्रो वर्णैरङ्गक्रिया मता॥ ३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50026092, "chapter_id": 12054, "verse_number": "2", "content_sanskrit": "अङ्गारवर्णमभितोऽण्डबहिःप्रभाभिर्व्याप्तं परश्वधधनुर्धरमेकवीरम्। ध्यायेदजेशपुरुहूतमुखैः स्तुवद्भिरावीतमात्मपदवीं प्रतिपादयन्तम्॥ ३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50026093, "chapter_id": 12054, "verse_number": "3", "content_sanskrit": "श्यामं रवीन्द्वमितदीधितिकान्तियुक्तं ज्ञानं शरं च दधतं प्रियया समेतम्। स्वात्मस्वरूपममितं हनुमन्मुखेषु सन्दर्शयन्तमजितं स्मरतोरुगीर्भिः॥ ३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}]