[{"id": 2195627, "chapter_id": 5165, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2195628, "chapter_id": 5165, "verse_number": "१", "content_sanskrit": "युधिष्ठिर महाबाहो शृणु राजन् यथातथम् ।\nगरुडं पक्षिणां श्रेष्ठं वैनतेयं महाबलम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2195629, "chapter_id": 5165, "verse_number": "२", "content_sanskrit": "तथा च गरुडो राजन् सुपर्णश्च यथाऽभवत् ।\nयथा च भुजगान् हन्ति तथा मे ब्रुवतः शृणु\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2195630, "chapter_id": 5165, "verse_number": "३", "content_sanskrit": "पुराऽहं तात रामेण जामदग्न्येन धीमता ।\nकैलासशिखरे रम्ये मृगान् निघ्नन् सहस्रशः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2195631, "chapter_id": 5165, "verse_number": "४", "content_sanskrit": "तमहं तात दृष्ट्वैव शस्त्रान्युत्सृज्य सर्वशः ।\nअभिवाद्य पूर्वं रामाय विनयेनोपतस्थिवान्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2195632, "chapter_id": 5165, "verse_number": "५", "content_sanskrit": "तमहं कथान्ते वरदं सुपर्णस्य बलौजसी ।\nअपृच्छं स च मां प्रीतः प्रत्युवाच युधिष्ठिर\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2195633, "chapter_id": 5165, "verse_number": "६", "content_sanskrit": "कद्रूश्च विनता चास्तां प्रजापतिसुते उभे ।\nते धर्मेणोपयेमेऽथ मारीचः कश्यपः प्रभुः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2195634, "chapter_id": 5165, "verse_number": "७", "content_sanskrit": "प्रादात् ताभ्यां वरं प्रीतो भार्याभ्यां सुमहातपाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2195635, "chapter_id": 5165, "verse_number": "८", "content_sanskrit": "तत्र कद्रूर्वरं वव्रे पुत्राणां दशतः शतम् ।\nतुल्यतेजःप्रभावानां सर्वेषां तुल्यजन्मनाम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2195636, "chapter_id": 5165, "verse_number": "९", "content_sanskrit": "विनता तु वव्रे द्वौ पुत्रौ वीरौ भरतसत्तम ।\nकद्रूपुत्रसहस्रेण तुल्यवेगपराक्रमौ\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2195637, "chapter_id": 5165, "verse_number": "१०", "content_sanskrit": "स तु ताभ्यां वरं प्रादात् तथेत्युक्त्वा महातपाः ।\nजनयामास तान् पुत्रांस्ताभ्यामासीद् यथा पुरा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2195638, "chapter_id": 5165, "verse_number": "११", "content_sanskrit": "कद्रूः प्रजज्ञे त्वण्डानां तथैव दशतः शतम् ।\nअण्डे द्वे विनता चैव दर्शनीयतरे शुभे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2195639, "chapter_id": 5165, "verse_number": "१२", "content_sanskrit": "तानि त्वण्डानि तु तयोः कद्रूविनतयोर्द्वयोः ।\nसोपस्वेदेषु पात्रेषु निदधुः परिचारिणः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2195640, "chapter_id": 5165, "verse_number": "१३", "content_sanskrit": "निःसरन्ति तदाऽण्डेभ्यः कद्रूपुत्रा भुजङ्गमाः ।\nपञ्चवर्षशते काले दृष्टिश्वासामलौजसः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2195641, "chapter_id": 5165, "verse_number": "१४", "content_sanskrit": "विनता तेषु जातेषु पन्नगेषु महात्मसु ।\nविपुत्रा पुत्रसन्तापादण्डमेकं बिभेद ह\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2195642, "chapter_id": 5165, "verse_number": "१५", "content_sanskrit": "किमनेन करिष्येऽहमिति वाक्यमभाषत ।\nन हि पञ्चशते काले पुरा पुत्रौ ददर्श सा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2195643, "chapter_id": 5165, "verse_number": "१६", "content_sanskrit": "सापश्यदण्डान्निष्क्रान्तं नता पुत्रं मनस्विनम् ।\nपूर्वकायोपसम्पन्नं वियुक्तमितरेण ह\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2195644, "chapter_id": 5165, "verse_number": "१७", "content_sanskrit": "दृष्ट्वा तु तं तथारूपमसमग्रशरीरिणम् ।\nपुत्रदुःखान्विताऽऽशोचत् स च पक्षी तथा गतः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2195645, "chapter_id": 5165, "verse_number": "१८", "content_sanskrit": "अब्रवीच्च मुदाऽयुक्तः पर्यश्रुनयनस्तदा ।\nमातरं चपलासीति हतोऽहमिति चासकृत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2195646, "chapter_id": 5165, "verse_number": "१९", "content_sanskrit": "न मया काङ्क्षितः यो वा नेष्योऽभ्यगात् पुरा ।\nआवां भवाव पुत्रौ ते श्वसनाद् बलवत्तरौ\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2195647, "chapter_id": 5165, "verse_number": "२०", "content_sanskrit": "ईर्ष्याक्रोधाभिभूतत्वाद् योऽहमेवं कृतस्त्वया ।\nतस्मात् त्वमपि मे मातर्दासीभावं गमिष्यसि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2195648, "chapter_id": 5165, "verse_number": "२१", "content_sanskrit": "पञ्चवर्षशतानि त्वं स्पर्धसे वै यया सह ।\nदासी तस्या भवित्रीति साश्रुपातमुवाच ह\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2195649, "chapter_id": 5165, "verse_number": "२२", "content_sanskrit": "एष चैव महाभागे बली बलवतांवरः ।\nमोक्षयिष्यति ते मातर्दासीभावान्ममानुजः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2195650, "chapter_id": 5165, "verse_number": "१६", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे गरुडोपाख्याने अरुणोत्पत्तिर्नाम षोडशोऽध्यायः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2195651, "chapter_id": 5165, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]