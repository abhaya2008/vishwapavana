[{"id": 40006323, "chapter_id": 8974, "verse_number": "1", "content_sanskrit": "ततो निक्षिप्य मातृ़ स्स अयोध्यायां दृढ व्रतः। भरत श्शोकसन्तप्तो गुरूनिदमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40006324, "chapter_id": 8974, "verse_number": "2", "content_sanskrit": "नन्दिग्रामं गमिष्यामि सर्वानामन्त्रयेऽद्य वः। तत्र दुःखमिदं सर्वं सहिष्ये राघवं विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40006325, "chapter_id": 8974, "verse_number": "3", "content_sanskrit": "गतश्च वा दिवं राजा वनस्थश्च गुरुर्मम। रामं प्रतीक्षे राज्याय स हि राजा महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40006326, "chapter_id": 8974, "verse_number": "4", "content_sanskrit": "एतच्छ्रुत्वा शुभं वाक्यं भरतस्य महात्मनः। अब्रुवन्मन्त्रिणस्सर्वे वसिष्ठश्च पुरोहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40006327, "chapter_id": 8974, "verse_number": "5", "content_sanskrit": "सुभृशं श्लाघनीयं च यदुक्तं भरत त्वया। वचनं भ्रातृवात्सल्यादनुरूपं तवैव तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40006328, "chapter_id": 8974, "verse_number": "6", "content_sanskrit": "नित्यं ते बन्धुलुब्धस्य तिष्ठतो भ्रातृसौहृदे। आर्यमार्गं प्रपन्नस्य नानुमन्येत कः पुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40006329, "chapter_id": 8974, "verse_number": "7", "content_sanskrit": "मन्त्रिणां वचनं श्रुत्वा यथाभिलषितं प्रियम्। अब्रवीत्सारथिं वाक्यं रथो मे युज्यतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40006330, "chapter_id": 8974, "verse_number": "8", "content_sanskrit": "प्रहृष्टवदन स्सर्वा मातृ़ स्समभिवाद्य सः। आरुरोह रथं श्रीमान् शत्रुघ्नेन समन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40006331, "chapter_id": 8974, "verse_number": "9", "content_sanskrit": "आरुह्य च रथं शीघ्रं शत्रुघ्नभरतावुभौ। ययतुः परमप्रीतौ वृतौ मन्त्रिपुरोहितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40006332, "chapter_id": 8974, "verse_number": "10", "content_sanskrit": "अग्रतो गुरव: सर्वे वसिष्ठप्रमुखा द्विजाः। प्रययुः प्राङ्ग्मुखा स्सर्वे नन्दिग्रामो यतोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40006333, "chapter_id": 8974, "verse_number": "11", "content_sanskrit": "बलं च तदनाहूतं गजाश्वरथसङ्कुलम्। प्रययौ भरते याते सर्वे च पुरवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40006334, "chapter_id": 8974, "verse_number": "12", "content_sanskrit": "रथस्थः स तु धर्मात्मा भरतो भ्रातृवत्सलः। नन्दिग्रामं ययौ तूर्णं शिरस्यादाय पादुके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40006335, "chapter_id": 8974, "verse_number": "13", "content_sanskrit": "ततस्तु भरतः क्षिप्रं नन्दिग्रामं प्रविश्य सः। अवतीर्य रथात्तूर्णं गुरूनिदमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40006336, "chapter_id": 8974, "verse_number": "14", "content_sanskrit": "एतद्राज्यं मम भ्रात्रा दत्तं सन्नयासवत्स्वयम्। योगक्षेमवहे चेमे पादुके हेमभूषिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40006337, "chapter_id": 8974, "verse_number": "15", "content_sanskrit": "भरत श्शिरसा कृत्वा सन्न्यासं पादुके ततः। अब्रवीद्धुःखसंतप्त स्सर्वं प्रकृतिमण्डलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40006338, "chapter_id": 8974, "verse_number": "16", "content_sanskrit": "छत्रं धारयत क्षिप्रमार्यपादाविमौ मतौ। आभ्यां राज्ये स्थितो धर्मः पादुकाभ्यां गुरोर्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40006339, "chapter_id": 8974, "verse_number": "17", "content_sanskrit": "भ्रात्रा हि मयि संन्यासो निक्षिप्त स्सौहृदादयम्। तमिमं पालयिष्यामि राघवागमनं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40006340, "chapter_id": 8974, "verse_number": "18", "content_sanskrit": "क्षिप्रं संयोजयित्वातु राघवस्य पुनस्स्वयम्। चरणौ तौ तु रामस्य द्रक्ष्यामि सहपादुकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40006341, "chapter_id": 8974, "verse_number": "19", "content_sanskrit": "ततो निक्षिप्तभारोऽहं राघवेण समागतः। निवेद्य गुरवे राज्यं भजिष्ये गुरुवृत्तिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40006342, "chapter_id": 8974, "verse_number": "20", "content_sanskrit": "राघवाय च सन्यासं दत्त्वेमे वरपादुके। राज्यं चेदमयोध्यां च धूतपापो भवामि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40006343, "chapter_id": 8974, "verse_number": "21", "content_sanskrit": "अभिषिक्ते तु काकुत्स्थे प्रहृष्टमुदिते जने। प्रीतिर्मम यशश्चैव भवेद्राज्याच्चतुर्गुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40006344, "chapter_id": 8974, "verse_number": "22", "content_sanskrit": "एवं तु विलपन्दीनो भरत स्समहायशाः। नन्दिग्रामेऽकरोद्राज्यं दुःखितो मन्त्रिभिस्सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40006345, "chapter_id": 8974, "verse_number": "23", "content_sanskrit": "स वल्कलजटाधारी मुनिवेषधरः प्रभुः। नन्दिग्रामेऽवसद्वीर स्ससैन्यो भरतस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40006346, "chapter_id": 8974, "verse_number": "24", "content_sanskrit": "रामागमनमाकाङ्क्षन्भरतो भ्रातृवत्सलः। भ्रातुर्वचनकारी च प्रतिज्ञापारगस्तथा ॥ पादुके त्वभिषिच्याथ नन्दिग्रामेऽवसत्तदा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40006347, "chapter_id": 8974, "verse_number": "25", "content_sanskrit": "स वालव्यजनं छत्रं धारयामास स स्वयं। भरत श्शासनं सर्वं पादुकाभ्यां निवेदयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40006348, "chapter_id": 8974, "verse_number": "26", "content_sanskrit": "ततस्तु भरत शश्रीमानभिषिच्याऽऽर्यपादुके। तदधीनस्तदा राज्यं कारयामास सर्वदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40006349, "chapter_id": 8974, "verse_number": "27", "content_sanskrit": "तदा हि यत्कार्यमुपैति किञ्चिदुपायनं चोपहृतं महार्हम्। स पादुकाभ्यां प्रथमं निवेद्य चकार पश्चाद्भरतो यथावत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]