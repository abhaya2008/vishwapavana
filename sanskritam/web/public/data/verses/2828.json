[{"id": 2085887, "chapter_id": 2828, "verse_number": "१२-३३३-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2085888, "chapter_id": 2828, "verse_number": "१२-३३३-१", "content_sanskrit": "स मोक्षमनुचिन्त्यैव शुकः पितरमभ्यगात्।\nप्राहाभिवाद्य च गुरुं श्रेयोर्थी विनयान्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2085889, "chapter_id": 2828, "verse_number": "१२-३३३-२", "content_sanskrit": "मोक्षधर्मेषु कुशलो भगवान्प्रब्रवीतु मे।\nयथा मे मनसः शान्तिः परमा संभवेत्प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2085890, "chapter_id": 2828, "verse_number": "१२-३३३-३", "content_sanskrit": "श्रुत्वा पुत्रस्य तु वचः परमर्षिरुवाच तम्।\nअधीहि पुत्र मोक्षं वै धर्मांश्च विविधानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2085891, "chapter_id": 2828, "verse_number": "१२-३३३-४", "content_sanskrit": "पितुर्नियोगाज्जग्राह शुको धर्मभृतां वरः।\nयोगशास्त्रं च निखिलं कापिलं चैव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2085892, "chapter_id": 2828, "verse_number": "१२-३३३-५", "content_sanskrit": "स तं ब्राह्नया श्रियः युक्तं ब्रह्मतुल्यपराक्रमम्।\nमेने पुत्रं यदा व्यासो मोक्षधर्मविशारदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2085893, "chapter_id": 2828, "verse_number": "१२-३३३-६", "content_sanskrit": "उवाच गच्छेति तदा जनकं मिथिलेश्वरम्।\nस ते वक्ष्यति मोक्षार्थं निखिलं मिथिलेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2085894, "chapter_id": 2828, "verse_number": "१२-३३३-७", "content_sanskrit": "पितुर्नियोगादगमन्मैथिलं जनकं नृपम्।\nप्रष्टुं धर्मस्य निष्ठां वै मोक्षस्य च परायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2085895, "chapter_id": 2828, "verse_number": "१२-३३३-८", "content_sanskrit": "उक्तश्च मानुषेण त्वं पथा गच्छेत्यविस्मितः।\nन प्रभावेण गन्तव्यमन्तरिक्षचरेण वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2085896, "chapter_id": 2828, "verse_number": "१२-३३३-९", "content_sanskrit": "आर्जवेनैव गन्तव्यं न सुखान्वेषिणा तथा।\nनान्वेष्टव्या विशेषास्तु विशेषा हि प्रसङ्गिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2085897, "chapter_id": 2828, "verse_number": "१२-३३३-१०", "content_sanskrit": "अहंकारो न कर्तव्यो याज्ये तस्मिन्नराधिपे।\nस्यातव्यं च वशे तस्य स ते छेत्स्यति संशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2085898, "chapter_id": 2828, "verse_number": "१२-३३३-११", "content_sanskrit": "स धर्मकुशलो राजा मोक्षशास्त्रविशारदः।\nयाज्यो मम स यद्ब्रूयात्तत्कार्यमविशङ्कया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2085899, "chapter_id": 2828, "verse_number": "१२-३३३-१२", "content_sanskrit": "एवमुक्तः स धर्मात्मा जगाम मिथिलां मुनिः।\nपद्भ्यां शक्तोन्तरिक्षेण क्रान्तुं पृथ्वीं ससागराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2085900, "chapter_id": 2828, "verse_number": "१२-३३३-१३", "content_sanskrit": "स गिरींश्चाप्यतिक्रम्य नदीतीर्थसरांसि च।\nबहुव्यालमृगाकीर्णा ह्यटवीश्च वनानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2085901, "chapter_id": 2828, "verse_number": "१२-३३३-१४", "content_sanskrit": "मेहोर्हरेश्च द्वे वर्षे वर्षं हैमवतं ततः।\nक्रमेणैवं व्यतिक्रम्य भारतं वर्षमासदत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2085902, "chapter_id": 2828, "verse_number": "१२-३३३-१५", "content_sanskrit": "स देशान्विविधान्पश्यंश्चीनहूणनिषेवितान्।\nआर्यावर्तमिमं देशमाजगाम महामुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2085903, "chapter_id": 2828, "verse_number": "१२-३३३-१६", "content_sanskrit": "पितुर्वचनमाज्ञाय तमेवार्थं विचिन्तयन्।\nअध्वानं सोऽतिचक्राम खचरः खे पतविव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2085904, "chapter_id": 2828, "verse_number": "१२-३३३-१७", "content_sanskrit": "पत्तनानि च रम्याणि स्फीतानि नगराणि च।\nरत्नानि च विचित्राणि पश्यन्नपि न पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2085905, "chapter_id": 2828, "verse_number": "१२-३३३-१८", "content_sanskrit": "उद्यावानि च रम्याणि तथैवायतनानि च।\nपुण्यानि चैव तीर्थानि सोत्यक्रामदथाध्वगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2085906, "chapter_id": 2828, "verse_number": "१२-३३३-१९", "content_sanskrit": "सोचिरेणैव कालेन विदेहानाससाद ह।\nरक्षितान्धर्मराजेन जनकेन महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2085907, "chapter_id": 2828, "verse_number": "१२-३३३-२०", "content_sanskrit": "तत्र ग्रामान्बहून्पश्यन्बह्वन्नरसभोजनान्।\nपल्लीघोषान्समृद्धांश्च बहुगोकुलसंकुलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2085908, "chapter_id": 2828, "verse_number": "१२-३३३-२१", "content_sanskrit": "स्फीतांश्च शालियवसर्हंससारससेवितान्।\nपद्मिनीभिश्च शतशः श्रीमतीभिरलकृतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2085909, "chapter_id": 2828, "verse_number": "१२-३३३-२२", "content_sanskrit": "स विदेहानतिक्रम्य समृद्धजनसेवितान्।\nमिथिलोपवनं रम्यमाससाद समृद्धिमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2085910, "chapter_id": 2828, "verse_number": "१२-३३३-२३", "content_sanskrit": "हस्त्यश्वरथसंकीर्णं नरनारीसमाकुलम्।\nपश्यन्नपश्यन्निव तत्समतिक्रामदच्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2085911, "chapter_id": 2828, "verse_number": "१२-३३३-२४", "content_sanskrit": "मनसा तं बहन्भारं तमेवार्थं विचिन्तयन्।\nआत्मारामः प्रसन्नात्मा मिथिलामाससाद ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2085912, "chapter_id": 2828, "verse_number": "१२-३३३-२५", "content_sanskrit": "तस्या द्वारं समासाद्य द्वारपालैर्निवारितः।\nस्थितो ध्यानपरो मुक्तो विदितः प्रविवेश ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2085913, "chapter_id": 2828, "verse_number": "१२-३३३-२६", "content_sanskrit": "स राजमार्गमासाद्य समृद्धजनकसंकुलम्।\nपार्थिवक्षयमासाद्य निःशङ्कः प्रविवेश ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2085914, "chapter_id": 2828, "verse_number": "१२-३३३-२७", "content_sanskrit": "तत्रापि द्वारपलास्तमुग्रवाचा न्यषेधयन्।\nतथैव च शुक्रस्तत्र निर्मन्युः समतिष्ठत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2085915, "chapter_id": 2828, "verse_number": "१२-३३३-२८", "content_sanskrit": "न चातपाध्वसंतप्तः क्षुत्पिपासाश्रमान्वितः।\nप्रताम्यति ग्लायति वा नापैति च तथाऽऽतपात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2085916, "chapter_id": 2828, "verse_number": "१२-३३३-२९", "content_sanskrit": "तेषां तु द्वारपालानामेकः शोकसमन्वितः।\nमध्यंगतमिवादित्यं दृष्ट्वा शुकमवस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2085917, "chapter_id": 2828, "verse_number": "१२-३३३-३०", "content_sanskrit": "पूजयित्वा यथान्यायमभिवाद्य कृताञ्जलिः।\nप्रावेशयत्ततः कक्ष्यां प्रथमां राजवेश्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2085918, "chapter_id": 2828, "verse_number": "१२-३३३-३१", "content_sanskrit": "तत्रासीनः शुकस्तात मोक्षमेवान्वचिन्तयत्।\nछायायामातपे चैव समदर्शी समद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2085919, "chapter_id": 2828, "verse_number": "१२-३३३-३२", "content_sanskrit": "तं मुहूर्तादिवागम्य राज्ञो मन्त्री कृताञ्जलिः।\nप्रावेशयत्ततः कक्ष्यां द्वितीयां राजवेश्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2085920, "chapter_id": 2828, "verse_number": "१२-३३३-३३", "content_sanskrit": "तत्रान्तः पुरसंबद्धं महच्चैत्ररथोपमम्।\nसुविभक्तजलाक्रीडं रम्यं पुष्पितपादपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2085921, "chapter_id": 2828, "verse_number": "१२-३३३-३४", "content_sanskrit": "तं दर्शयित्वा स शुकं मन्त्री जनकमुत्तमम्।\nअर्हमासनमादिश्य निश्चक्रामः ततः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2085922, "chapter_id": 2828, "verse_number": "१२-३३३-३५", "content_sanskrit": "तं चारुवेषाः सुश्रोण्यस्तरुण्यः प्रियदर्शनाः।\nसूक्ष्मरक्ताम्बरधरास्तप्तकाञ्चनभूषणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2085923, "chapter_id": 2828, "verse_number": "१२-३३३-३६", "content_sanskrit": "संलापालापकुशला नृत्तगीतविशारदाः।\nस्मितपूर्वाभिभाषिण्यो रूपेणाप्सरसां समाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2085924, "chapter_id": 2828, "verse_number": "१२-३३३-३७", "content_sanskrit": "भावोपचारकुशला भावज्ञाः सत्वकोविदाः।\nपरं पञ्चाशतं नार्यो वारमुख्याः समाद्रवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2085925, "chapter_id": 2828, "verse_number": "१२-३३३-३८", "content_sanskrit": "पाद्यादीनि प्रतिग्राह्य पूजया परयाऽर्चयन्।\nकालोपपन्नेन तदा स्वाद्वन्नेनाभ्यतर्पयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2085926, "chapter_id": 2828, "verse_number": "१२-३३३-३९", "content_sanskrit": "तस्य भुक्तवतस्तात तदन्तः पुरकाननम्।\nसुरम्यं दर्शयामासुरेकैकश्येन भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2085927, "chapter_id": 2828, "verse_number": "१२-३३३-४०", "content_sanskrit": "क्रीडन्त्यश्च हसन्त्यश्च गायन्त्यश्चापि ताः शुभम्।\nउदारसत्वं सत्वज्ञाः स्त्रियः पर्यचरंस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2085928, "chapter_id": 2828, "verse_number": "१२-३३३-४१", "content_sanskrit": "आरणेयस्तु शुद्धात्मा निःसंदेहस्त्रिकर्मकृत्।\nवश्येन्द्रियो जितक्रोधो न हृष्यति न कुप्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2085929, "chapter_id": 2828, "verse_number": "१२-३३३-४२", "content_sanskrit": "तस्मै शय्यासनं दिव्यं वरार्हः रत्नभूषितम्।\nस्पर्ध्यास्तरणसंकीर्णं ददुस्ताः परमस्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2085930, "chapter_id": 2828, "verse_number": "१२-३३३-४३", "content_sanskrit": "पादशौचं तु कृत्वैव शुक्रः संध्यामुपास्य च।\nनिषसादासने पुण्ये तमेवार्थं विचिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2085931, "chapter_id": 2828, "verse_number": "१२-३३३-४४", "content_sanskrit": "पूर्वरात्रे तु तत्रासौ हुत्वा ध्यानपरायणः।\nमध्यरात्रे यथान्यायं निद्रामाहारयत्प्रभुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2085932, "chapter_id": 2828, "verse_number": "१२-३३३-४५", "content_sanskrit": "ततो मुहूर्तादुत्थाय कृत्वा शौचमनन्तरम्।\nस्त्रीभिः परिवृतो धीमान्ध्यानमेवान्वपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2085933, "chapter_id": 2828, "verse_number": "१२-३३३-४६", "content_sanskrit": "अनेन विधिना कर्ष्णिस्तदहः शेषमच्युतः।\nतां च रात्रिं नृपकुले वर्तयामास भारत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2085934, "chapter_id": 2828, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिप्रवणि मोक्षधर्मपर्वणि त्रयस्त्रिंशदधिकत्रिशततमोऽध्यायः॥ ३३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]