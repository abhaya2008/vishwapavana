[{"id": 2075716, "chapter_id": 2603, "verse_number": "१२-१०८-०x", "content_sanskrit": "युधिष्ठिर उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2075717, "chapter_id": 2603, "verse_number": "१२-१०८-१", "content_sanskrit": "महानयं धर्मपथो बहुशाखश्च भारत।\nकिंस्विदेवेह धर्माणामनुष्ठेयतमं मतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2075718, "chapter_id": 2603, "verse_number": "१२-१०८-२", "content_sanskrit": "किं कार्यं सर्वभूतानां गरीयो भवतो मतम्।\nयथाऽहं परमं धर्ममिह च प्रेत्य चाप्नुयाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2075719, "chapter_id": 2603, "verse_number": "१२-१०८-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2075720, "chapter_id": 2603, "verse_number": "१२-१०८-३", "content_sanskrit": "मातापित्रोर्गुरूणां च पूजा बहुमता मम।\nअत्र वर्तन्नरो लोकान्यशश्च महदश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2075721, "chapter_id": 2603, "verse_number": "१२-१०८-४", "content_sanskrit": "यदेते ह्यनुजानीयुः कर्म तात सुपूजिताः।\nधर्मं धर्मविरुद्धं वा तत्कर्तव्यं युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2075722, "chapter_id": 2603, "verse_number": "१२-१०८-५", "content_sanskrit": "न तैरभ्यननुज्ञातो धर्ममन्यं समाचरेत्।\nयं मे तेऽभ्यनुजानीयुः स धर्म इति निश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2075723, "chapter_id": 2603, "verse_number": "१२-१०८-६", "content_sanskrit": "एत एव त्रयो लोका एत एवाश्रमास्त्रयः।\nएत एव त्रयो वेदा एत एव त्रयोऽग्नयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2075724, "chapter_id": 2603, "verse_number": "१२-१०८-७", "content_sanskrit": "पितावै गार्हपत्योऽग्निर्माताऽग्निर्दक्षणः स्मृतः।\nगुरु वनीयस्तु साऽग्नित्रेता गरीयसी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2075725, "chapter_id": 2603, "verse_number": "१२-१०८-८", "content_sanskrit": "त्रिष्वप्रमाद्यन्नेतेषु त्रील्लोँकानपि जेष्यसि।\nपितृवृत्त्या त्विमं लोकं मातृवृत्त्या तथा परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2075726, "chapter_id": 2603, "verse_number": "१२-१०८-९", "content_sanskrit": "ब्रह्मलोकं गुरोर्वृत्त्या नियमेन तरिष्यसि।\nस--गेतेषु वर्तस्व त्रिषु लोकेषु भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2075727, "chapter_id": 2603, "verse_number": "१२-१०८-१०", "content_sanskrit": "यशः प्राप्स्यसि भद्रं ते धर्मं च सुमहाफलम्।\nनैतानतिशयीथास्त्वं नात्यश्नीथा न दूषयेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2075728, "chapter_id": 2603, "verse_number": "१२-१०८-११", "content_sanskrit": "हियं परिचरेश्चैव तद्वै सुकृतमुत्तमम्।\nकीर्ति पुण्यं यशो लोकान्प्राप्स्यसे त्वं जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2075729, "chapter_id": 2603, "verse_number": "१२-१०८-१२", "content_sanskrit": "सर्वे तस्यादृता लोका यस्यैते त्रय आदृताः।\nअनादृतास्तु यस्यैते सर्वास्तस्याफलाः क्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2075730, "chapter_id": 2603, "verse_number": "१२-१०८-१३", "content_sanskrit": "न चायं न परो लोको न यशस्तस्य भारत।\nअमानिता नित्यमेव यस्यैते गुरवस्त्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2075731, "chapter_id": 2603, "verse_number": "१२-१०८-१४", "content_sanskrit": "न चास्मिन्न परे लोके यशस्तस्य प्रकाशते।\nयच्चान्यदपि कल्याणं पारत्रं समुदाहृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2075732, "chapter_id": 2603, "verse_number": "१२-१०८-१५", "content_sanskrit": "तेभ्य एव हि यत्सर्वं कृत्यं यन्निसृजाम्यहम्।\nतदासीन्मे शतगुणं सहस्रगुणमेव च।\nतस्मान्मे संप्रकाशन्ते त्रयो लोका युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2075733, "chapter_id": 2603, "verse_number": "१२-१०८-१६", "content_sanskrit": "दशैव तु सदाऽऽचार्यः श्रोत्रियानधितिष्ठति।\nदशाचार्यानुपाध्याय उपाध्यायान्पिता दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2075734, "chapter_id": 2603, "verse_number": "१२-१०८-१७", "content_sanskrit": "पितॄन्दश तु मातैका सर्वां वा पृथिवीमपि।\nगुरुत्वेनाभिभवति नास्ति मातृसमो गुरुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2075735, "chapter_id": 2603, "verse_number": "१२-१०८-१८", "content_sanskrit": "गुरुर्गरीयान्पितृतो मातृतश्चेति मे मतिः।\nउभौ हि मातापितरौ जन्मन्येवोपयुज्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2075736, "chapter_id": 2603, "verse_number": "१२-१०८-१९", "content_sanskrit": "शरीरमेतौ सृजतः पिता माता च भारत।\nआचार्यशिष्टा या जातिः सासम्यगजरामरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2075737, "chapter_id": 2603, "verse_number": "१२-१०८-२०", "content_sanskrit": "अवध्या हि सदा माता पिता चाप्युपचारिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2075738, "chapter_id": 2603, "verse_number": "१२-१०८-२१", "content_sanskrit": "न स दुष्यति तत्कृत्वा न च ते दूषयन्ति तम्।\nधर्माय यतमानानां विदुर्देवाः सहर्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2075739, "chapter_id": 2603, "verse_number": "१२-१०८-२२", "content_sanskrit": "य आवृणोत्यवितथेन कर्मणा\nऋतं ब्रुवन्नमृतं संप्रयच्छन्।\nतं मन्येथाः पितरं मातरं च\nतस्मै न द्रुह्येत्कृतमस्य जानन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2075740, "chapter_id": 2603, "verse_number": "१२-१०८-२३", "content_sanskrit": "विद्यां श्रुत्वा ये गुरुं नाद्रियन्ते\nप्रत्युत्पन्ना मनसा कर्मणा वा।\nतेषां पापं भ्रूणहत्याविशिष्टं\nनान्यस्तेभ्यः पापकृदस्ति लोके।\nयथैव ते गुरुभिर्भावनीया\nस्तथैव तेषां गुरवोऽभ्यर्चनीयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2075741, "chapter_id": 2603, "verse_number": "१२-१०८-२४", "content_sanskrit": "तस्मात्पूजयितव्याश्च संविभज्याश्च यत्नतः।\nगुरवोऽर्चयितव्याश्च पुराणं धर्ममिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2075742, "chapter_id": 2603, "verse_number": "१२-१०८-२५", "content_sanskrit": "येन प्रीणन्ति पितरस्तेन प्रीतः प्रजापतिः।\nप्रीणाति जननीयेन पृथिवी तेन पूजिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2075743, "chapter_id": 2603, "verse_number": "१२-१०८-२६", "content_sanskrit": "येन प्रीणात्युपाध्यायस्तेन स्याद्ब्रह्म पूजितम्।\nमातृतः पितृतश्चैव तस्मात्पूज्यतमो गुरुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2075744, "chapter_id": 2603, "verse_number": "१२-१०८-२७", "content_sanskrit": "ऋषयश्च हि देवाश्च प्रीयन्ते पितृभिः सह।\nपूज्यमानेषु गुरुषु तस्मात्पूज्यतमो गुरुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2075745, "chapter_id": 2603, "verse_number": "१२-१०८-२८", "content_sanskrit": "केनचिन्न च वृत्तेन ह्यवज्ञेयो गुरुर्भवेत्।\nन च माता न च पितो तादृशो यादृशो गुरुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2075746, "chapter_id": 2603, "verse_number": "१२-१०८-२९", "content_sanskrit": "न तेऽवमानमर्हन्ति न तेषां दूषयेत्कृतम्।\nगुरूणामेव सत्कारं विदुर्देवाः सहर्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2075747, "chapter_id": 2603, "verse_number": "१२-१०८-३०", "content_sanskrit": "उपाध्यायं पितरं मातरं च\nये विद्रुह्यन्ते मनसा कर्मणा वा।\nतेषां पापं भ्रूणहत्याविशिष्टं\nतस्मान्नान्यः पापकृदस्ति लोके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2075748, "chapter_id": 2603, "verse_number": "१२-१०८-३१", "content_sanskrit": "भृतो भर्तारं यो न विभिर्ति पुत्रः\nस्वयोनिजः पितरं मातरं च।\nतस्य पापं भ्रूणहत्याविषिष्टं\nतस्मान्नान्यः पापकृदस्ति लोके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2075749, "chapter_id": 2603, "verse_number": "१२-१०८-३२", "content_sanskrit": "मित्रद्रुहः कृतघ्नस्य स्त्रीघ्नस्य पिशुनस्य च।\nचतुर्णामपि चैतेषां निष्कृतिं नानुशुश्रुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2075750, "chapter_id": 2603, "verse_number": "१२-१०८-३३", "content_sanskrit": "एतत्सर्वं मनुनिर्देशदृष्टं\nयत्कर्तव्यं पुरुषेणेह किंचित्।\nएतच्छ्रेयो नान्यदस्माद्विशिष्टं\nसर्वान्धर्माननुसृत्यैतदुक्तम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2075751, "chapter_id": 2603, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि अष्टाधिकशततमोऽध्यायः॥ १०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]