[{"id": 7005486000, "chapter_id": 25486, "verse_number": "२-३-१", "content_sanskrit": "ईश्वर उवाच ।\nअव्यक्तदभवत कालः प्रधान पुरुषः परः ।\nतेभ्यः सर्वमिदं जातं तस्माद ब्रह्मामयं जगत ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005486001, "chapter_id": 25486, "verse_number": "२-३-२", "content_sanskrit": "सर्वतः पाणिपादं तत सर्वतोऽक्षिशिरोमुखम ।\nसर्वतः श्रुतिमल्लोके सर्वमावृत्य तिष्ठति ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005486002, "chapter_id": 25486, "verse_number": "२-३-३", "content_sanskrit": "सर्वोन्द्रियगुणाभासं सर्वेन्द्रियविवर्जितम ।\nसर्वाधारं सदानन्दमव्यक्त द्वैतवर्जितम ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005486003, "chapter_id": 25486, "verse_number": "२-३-४", "content_sanskrit": "सर्वोपमानरहितं प्रमाणतीतगोचरम ।\nनिर्विकल्पं निराभासं सर्वावांस परामृतम ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005486004, "chapter_id": 25486, "verse_number": "२-३-५", "content_sanskrit": "अभिन्नं भिन्नसंस्थानं शाश्वंत ध्रुवमव्ययम ।\nनिर्गुणं परमं व्योम तज्ज्ञानं सुरयो विदुः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005486005, "chapter_id": 25486, "verse_number": "२-३-६", "content_sanskrit": "स आत्मा सर्वभुतानां स ब्राह्मभ्यन्तरं परः ।\nसोऽहं सर्वत्रगः शान्तो ज्ञानात्मा परमेश्वरः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005486006, "chapter_id": 25486, "verse_number": "२-३-७", "content_sanskrit": "मया ततामिदं विश्‍वं जगदव्यक्तमुर्तिना ।\nमत्स्थानि सर्वभुतानि यस्तं वेद वेदवित ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005486007, "chapter_id": 25486, "verse_number": "२-३-८", "content_sanskrit": "प्रधानं पुरुषं चैव तत्त्वद्वयमुदाहृतम ।\nतयोदनादिरुद्दिष्ट कालः संयोजकः परः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005486008, "chapter_id": 25486, "verse_number": "२-३-९", "content_sanskrit": "त्रयमेदनाद्यन्त्मव्यक्ते समवस्थितम ।\nतदात्मकं तदन्यत स्यात तद्रूपं मामकं विदुः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005486009, "chapter_id": 25486, "verse_number": "२-३-१०", "content_sanskrit": "महादाद्यं विशेषन्तं सम्प्रसुतेऽखिलं जगत ।\nया स प्रकृतिरुद्दिष्टा मोहिनी सर्वदेहिनम ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005486010, "chapter_id": 25486, "verse_number": "२-३-११", "content_sanskrit": "पुरुषः प्रकृतिस्थो हि भुंक्ते यः प्राकृतान गुणान ।\nअहंकारविमुक्तत्वात प्रोच्यते पंचविशंकः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005486011, "chapter_id": 25486, "verse_number": "२-३-१२", "content_sanskrit": "आद्यो विकारः प्रकृतेर्महानत्मेति कथ्यते ।\nविज्ञानशोक्तिर्विज्ञाता ह्राहंकरस्तदुत्थितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005486012, "chapter_id": 25486, "verse_number": "२-३-१३", "content_sanskrit": "एक एव महानात्मा सोऽहंकारोऽभिधीयते ।\nस जीवः सोऽन्तरात्मोत गीयते तत्त्वचिन्तकैः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005486013, "chapter_id": 25486, "verse_number": "२-३-१४", "content_sanskrit": "तेन वेदयते सर्व सुखं दुःखं च जन्मसु ।\nस विज्ञानात्मकस्तस्य मनः स्यादुपकारकम ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005486014, "chapter_id": 25486, "verse_number": "२-३-१५", "content_sanskrit": "तेनाविविएकतस्तस्मात संसारःपुरुषस्य तु ।\nस चाविवेकः प्रकृतौ संगात कालेन सोऽभवत ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005486015, "chapter_id": 25486, "verse_number": "२-३-१६", "content_sanskrit": "कालः सृजति भूतानि कालः संहरति प्रजाः ।\nसर्व कालस्य वंशगा न कालः कस्याचिद वशे ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005486016, "chapter_id": 25486, "verse_number": "२-३-१७", "content_sanskrit": "सोऽन्तरा सर्वर्मवेदं नियच्छति सनातनः ।\nप्रोच्यते भगवान प्राणः सर्वज्ञ पुरुषोत्तम ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005486017, "chapter_id": 25486, "verse_number": "२-३-१८", "content_sanskrit": "सर्वेन्द्रियेभ्यः परमं मन आहुर्मनीषिणः ।\nमनसश्चाप्यहंकारमहंकारान्महान परः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005486018, "chapter_id": 25486, "verse_number": "२-३-१९", "content_sanskrit": "महतः परमव्यक्तमव्यक्तात पुरुषः परः ।\nपुरुषाद भगवान प्रणस्तस्य सर्वमिदं जगत ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005486019, "chapter_id": 25486, "verse_number": "२-३-२०", "content_sanskrit": "प्राणात परतरं व्योम व्य्मातीतोऽग्निरीश्वरः ।\nसोऽहं सर्वत्रगः शान्तो ज्ञानात्मा परमेश्वरः ।\nनास्ति मत्तः परं भूतं मां विज्ञाया विमुच्यते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005486020, "chapter_id": 25486, "verse_number": "२-३-२१", "content_sanskrit": "नित्य ही नास्ति जगति भूतं स्थावजंगमम ।\nऋते मामेकमव्यक्तं व्योमरुपं महेश्वरम ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005486021, "chapter_id": 25486, "verse_number": "२-३-२२", "content_sanskrit": "सोऽहं सृजामि सकलं संहारामि सदा जगत ।\nमायी मायामयो देवः कालेन सह संगतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005486022, "chapter_id": 25486, "verse_number": "२-३-२३", "content_sanskrit": "मत्संनिधावेष कालः करोति सकलं जगत ।\nनियोजयत्यनन्तात्मा ह्योतद वेदानुशासनम ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]