[{"id": 2015128, "chapter_id": 1316, "verse_number": "२-५७-१", "content_sanskrit": "भीष्ण उवाच॥\nतां पुरी द्वारकीं दृष्ट्वा विभुर्नारायणो हरिः।\nहृष्टः सर्वार्थसम्पन्नः प्रवेष्टुमुपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2015129, "chapter_id": 1316, "verse_number": "२-५७-२", "content_sanskrit": "सोऽपश्यद्वृक्षषण्डांश्च रम्यान्नानाजनान्वहून्।\nसमन्ततो द्वारवत्यां नानापुष्पफलान्वितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2015130, "chapter_id": 1316, "verse_number": "२-५७-३", "content_sanskrit": "अर्कचन्द्रप्रतीकाशैर्मेरुकूटनिभैर्गृहैः।\nद्वारकामावृतां रम्यां सुकृतां विश्वकर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2015131, "chapter_id": 1316, "verse_number": "२-५७-४", "content_sanskrit": "पद्मषण्डाकुलाभिश्च हंससेवितवारिभिः।\nगङ्गासिन्धुप्रकाशाभिः परिघाभिरलङ्कृताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2015132, "chapter_id": 1316, "verse_number": "२-५७-५", "content_sanskrit": "प्राकारेणार्कवर्णेन पाण्डरेण विराजिताम्।\nवियन्मूर्ध्नि निविष्टेन द्यामिवाभ्रपरिच्छदाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2015133, "chapter_id": 1316, "verse_number": "२-५७-६", "content_sanskrit": "नन्दनप्रतिमैश्वापि मिश्रकप्रतिमैर्वनैः।\nतत्र सा विहिता साक्षान्नगरी विश्वकर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2015134, "chapter_id": 1316, "verse_number": "२-५७-७", "content_sanskrit": "काञ्चनैर्मणिसोपानैरुपेता जनहर्षिणी।\nगीतघोषमहाघोषैः प्रसादप्रवरैः शुभा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2015135, "chapter_id": 1316, "verse_number": "२-५७-८", "content_sanskrit": "तस्मिन्पुरवारश्रेष्ठे दाशार्हाणां यशस्विनाम्।\nनेश्मानि जहृषे दृष्ट्वा भगवान्पाकशासनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2015136, "chapter_id": 1316, "verse_number": "२-५७-९", "content_sanskrit": "समुच्छ्रितपताकानि पारिप्लवनिभानि च।\nकाञ्चनाभानि भाखन्ति मेरुकूटनिभानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2015137, "chapter_id": 1316, "verse_number": "२-५७-१०", "content_sanskrit": "सुधापाण्डरशृङ्गैश्च शातकुम्भपरिच्छदैः।\nरत्नसानुमहाशृङ्गैः सर्वरत्नसमन्वितैः?", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2015138, "chapter_id": 1316, "verse_number": "२-५७-११", "content_sanskrit": "सहर्म्यैः सार्धचन्द्रैश्च सनिर्यूहैः सपञ्जरैः।\nसयन्त्रगृहसंबाधैः सधातुभिरिवाद्रिभिः॥ २-५७-११\nमणिकाञ्चनभोमेश्च सुधामृष्टतलैस्तथा।\nजाम्बूनदमयद्वारैर्वैडूर्यविकृतार्गलैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2015139, "chapter_id": 1316, "verse_number": "२-५७-१३", "content_sanskrit": "सर्वर्तुसुखसंस्यर्शैर्महाधनपरिच्छदैः।\nरम्यसानुगृहैः शृङ्गैर्विचित्रैरिव पर्वतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2015140, "chapter_id": 1316, "verse_number": "२-५७-१४", "content_sanskrit": "पञ्चवर्णसवर्णैश्च पुष्पवृष्टिसमप्रभैः।\nतुल्यैः पर्जन्यनिर्घोषैर्ह्रादैर्भोगवती यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2015141, "chapter_id": 1316, "verse_number": "२-५७-१५", "content_sanskrit": "कृष्णध्वजोपवाह्यैश्च दाशार्हायुधरोहितैः।\nवृष्णिवीरमयूरैश्च स्त्रीसहस्रप्रजाकुलैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2015142, "chapter_id": 1316, "verse_number": "२-५७-१६", "content_sanskrit": "वासुदेवैन्द्रपर्जन्यैर्गृहमेघैरलङ्कृता।\nददृशे द्वारकाऽतीव मेघैर्द्यैरिव संवृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2015143, "chapter_id": 1316, "verse_number": "२-५७-१७", "content_sanskrit": "साक्षाद्भगवतो वेश्म विहितं विश्वकर्मणा।\nददृशुर्वासुदेवस्य चतुर्योजनमायतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2015144, "chapter_id": 1316, "verse_number": "२-५७-१८", "content_sanskrit": "तावदेव सुविस्तीर्णं सुसम्पूर्णं महाधनैः।\nप्रासादवरसम्पन्नं युक्तं जगति पर्वतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2015145, "chapter_id": 1316, "verse_number": "२-५७-१९", "content_sanskrit": "यं चकार महाभागस्त्वष्टा वासवचोदितः।\nप्रासादं हेमनाभस्य सर्वतो योजनायतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2015146, "chapter_id": 1316, "verse_number": "२-५७-२०", "content_sanskrit": "मेरोरिव गिरेः शृङ्गमुच्छ्रितं काञ्चनालयम्।\nरुक्मिण्याः प्रवरो वासो निर्मितः सुमहात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2015147, "chapter_id": 1316, "verse_number": "२-५७-२१", "content_sanskrit": "सत्यभामा पुनर्वेश्म सदा वसति पाण्डरम्।\nविचित्रमणिसोपानं यं विदुः शीतवानिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2015148, "chapter_id": 1316, "verse_number": "२-५७-२२", "content_sanskrit": "विमलादित्यवर्णाभिः पताकाभिरलङ्कृतम्।\nव्यक्तबद्धं यथोद्देशे चतुर्दशमहाध्वजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2015149, "chapter_id": 1316, "verse_number": "२-५७-२३", "content_sanskrit": "सर्वप्रासादमुख्योऽत्र जाम्बवत्या विभूषितः।\nप्रभाया जृम्भणैश्चित्रैस्त्रैलोक्यमिव भासयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2015150, "chapter_id": 1316, "verse_number": "२-५७-२४", "content_sanskrit": "यस्तु पाण्डरवर्णाभस्तयोरन्तरमाश्रितः।\nविश्वकर्माकरोदेनं कैलासशिखरोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2015151, "chapter_id": 1316, "verse_number": "२-५७-२५", "content_sanskrit": "जाम्बूनदप्रदीप्ताग्रः प्रदीप्तज्वलनोपमः।\nसागरप्रतिमोऽतिष्ठन्मेरुरित्यभिविश्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2015152, "chapter_id": 1316, "verse_number": "२-५७-२६", "content_sanskrit": "तस्मिन्गान्धारराजस्य दुहिता कुलशालिनी।\nसुकेशी नाम विख्याता केशवेन निवेशिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2015153, "chapter_id": 1316, "verse_number": "२-५७-२७", "content_sanskrit": "पद्मकूट इति ख्यातः पद्मवर्णो महाप्रभः।\nसुप्रभाया महाबाहो वासः स परमोच्छ्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2015154, "chapter_id": 1316, "verse_number": "२-५७-२८", "content_sanskrit": "यस्तु सूर्यप्रभो नाम प्रासादवर उच्यते।\nलक्षणायाः कुरुश्रेष्ठ स दत्तः शार्ङ्गधन्वना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2015155, "chapter_id": 1316, "verse_number": "२-५७-२९", "content_sanskrit": "वैडूर्यवरवर्णाभः प्रासादो हरितप्रभः।\nश्वेतजाला हि यत्रैव यत्रैव च निवेशिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2015156, "chapter_id": 1316, "verse_number": "२-५७-३०", "content_sanskrit": "यं विदुः सर्वभूतानि हरिरित्येव भारत।\nसुमित्रविजयावासो देवर्षिगणपूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2015157, "chapter_id": 1316, "verse_number": "२-५७-३१", "content_sanskrit": "महिष्या वासुदेवस्य भूषणं सर्ववेश्मनाम्।\nयस्तु प्रासादमुख्योऽत्र विहितः सर्वशिल्पिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2015158, "chapter_id": 1316, "verse_number": "२-५७-३२", "content_sanskrit": "महिष्या वासुदेवस्य केतुमानिति विश्रुतः।\nप्रसादो विरजो नाम विरजस्को महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2015159, "chapter_id": 1316, "verse_number": "२-५७-३३", "content_sanskrit": "उपस्थानगृहं तात केशवस्य महात्मनः।\nयस्तु प्रासादमुख्योऽत्र यं त्वष्टा व्यदधात्स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2015160, "chapter_id": 1316, "verse_number": "२-५७-३४", "content_sanskrit": "योजनायतविष्कम्भं सर्वरत्नमयं विभोः।\nतेषां तु विहिताः सर्वे रुक्मदण्डाः पताकिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2015161, "chapter_id": 1316, "verse_number": "२-५७-३५", "content_sanskrit": "सदने वासुदेवस्य मार्गसञ्जनना ध्वजाः।\nघण्टाजालानि तत्रैव सर्वेषां निवेशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2015162, "chapter_id": 1316, "verse_number": "२-५७-३६", "content_sanskrit": "आहृत्य यदुसिंहेन वैजयन्तच्छलो महात्।\nहंसकूटस्य यच्छ्रङ्गमिन्द्रद्युम्नसरो महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2015163, "chapter_id": 1316, "verse_number": "२-५७-३७", "content_sanskrit": "षष्टितालसमुत्सेधमर्धयोजनविस्तृतम्।\nसकिन्नरमहानादं तदप्यमिततेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2015164, "chapter_id": 1316, "verse_number": "२-५७-३८", "content_sanskrit": "पश्यतां सर्वभूतानां त्रिषु लोकेषु विश्रुतम्।\nआदित्यपथगं यत्तन्मेरोः शिखरमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2015165, "chapter_id": 1316, "verse_number": "२-५७-३९", "content_sanskrit": "जाम्बूनदमयं दिव्यं त्रिषु लोकेषु विश्रुतम्।\nतदप्युत्पाट्य कुच्छ्रेण स्वं निवेशनमाहृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2015166, "chapter_id": 1316, "verse_number": "२-५७-४०", "content_sanskrit": "भ्राजमानं पुरा तत्र सर्वौषधिविदीपितम्।\nयमिन्द्रभवनाच्छौरिराजहार परन्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2015167, "chapter_id": 1316, "verse_number": "२-५७-४१", "content_sanskrit": "पारिजातः स तत्रैव केशवेन निवेशितः।\nलेपहस्तशतैर्जुष्टो विमानैश्च हिरण्मयैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2015168, "chapter_id": 1316, "verse_number": "२-५७-४२", "content_sanskrit": "विहिता वासुदेवेन तत्रैव च महाद्रुमाः।\nपद्माकुलजलोपेता रक्तसौगन्धिकोत्पलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2015169, "chapter_id": 1316, "verse_number": "२-५७-४३", "content_sanskrit": "मणिमौक्तिकवालूकाः पुष्करिण्यः सरांसि च।\nतासां परमकूलि शोभयन्ति महाद्रुमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2015170, "chapter_id": 1316, "verse_number": "२-५७-४४", "content_sanskrit": "सालतालाश्वकर्णाश्च शतशाखाश्च रोहिणः।\nभल्लातककपित्थाश्च इन्द्रवृक्षाश्च चम्पकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2015171, "chapter_id": 1316, "verse_number": "२-५७-४५", "content_sanskrit": "खादिरा मृतकाश्चैव समन्तात्परिरोपिताः।\nये च हैमवता वृक्षा ये च नन्दनजास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2015172, "chapter_id": 1316, "verse_number": "२-५७-४६", "content_sanskrit": "आहृत्य यदुसिंहेन तेऽपि तत्र निवेशिताः।\nरत्नपीतारुणप्रख्याः सितपुष्पाश्च पादपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2015173, "chapter_id": 1316, "verse_number": "२-५७-४७", "content_sanskrit": "सर्वर्तुफलपूर्णोस्ते ते च काननसिन्धुषु।\nसहस्रपत्रपद्माश्च मन्दराश्च सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2015174, "chapter_id": 1316, "verse_number": "२-५७-४८", "content_sanskrit": "अशोकाः कर्णिकाराश्च तिलका नाग मल्लिकाः।\nकुरका नागपुष्पाश्च चम्पकास्तृणपुल्लिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2015175, "chapter_id": 1316, "verse_number": "२-५७-४९", "content_sanskrit": "सप्तवर्णाः कबन्धाश्च नीपाः कुरवकास्तथा।\nकेतकाः केसराश्चैव हिनतालतलताटकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2015176, "chapter_id": 1316, "verse_number": "२-५७-५०", "content_sanskrit": "तालाः प्रलम्बा वकुलाः पिण्डिका बीजपूरकाः।\nद्रुतामलकखर्जूरा महिता जम्बुकास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2015177, "chapter_id": 1316, "verse_number": "२-५७-५१", "content_sanskrit": "आम्राः पनसवृक्षाश्च चम्पकास्तिलतिन्दुकाः।\nलिकुचामृताश्चैव क्षीरिका कर्णिका तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2015178, "chapter_id": 1316, "verse_number": "२-५७-५२", "content_sanskrit": "नालिकेरेङ्गुदाश्चैव उत्क्रोशकवनानि च।\nकदली जातमल्ली च पाटली कुमुदोत्पलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2015179, "chapter_id": 1316, "verse_number": "२-५७-५३", "content_sanskrit": "नीलोत्पलकपूर्णाश्च वाप्यः कूपाः सहस्रशः।\nफुल्लाशाककपित्थाश्च तैस्तीर्त्वा बन्धुजीवकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2015180, "chapter_id": 1316, "verse_number": "२-५७-५४", "content_sanskrit": "प्रियालाशोकवादिर्याः प्राचीनाश्चापि सर्वशः।\nप्रियङ्गुबदरीभिश्च यवैः स्यन्दनचन्दनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2015181, "chapter_id": 1316, "verse_number": "२-५७-५५", "content_sanskrit": "शचीपीलुपलाश्चैश्च पलाशवधपिप्लैः।\nउदुम्बरैश्च बिल्वैश्च पालाशैः पारिभद्रकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2015182, "chapter_id": 1316, "verse_number": "२-५७-५६", "content_sanskrit": "इन्द्रवृक्षार्जुनैश्चैव अश्वत्थैश्चिरबिल्वकैः।\nभौमगञ्जनवृक्षैश्च भल्लाभैरश्वसाह्वयैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2015183, "chapter_id": 1316, "verse_number": "२-५७-५७", "content_sanskrit": "सज्जैस्ताम्बूलवल्लीभिर्लवङ्गैः क्रमुकैस्तथा।\nवंशैश्च विविधैस्तत्र समन्तात्परिरोपितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2015184, "chapter_id": 1316, "verse_number": "२-५७-५८", "content_sanskrit": "ये च नन्दनजा वृक्षा ये च चैत्ररथे वने।\nसर्वे ते यदुनाथेन समन्तात्परिरोपिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2015185, "chapter_id": 1316, "verse_number": "२-५७-५९", "content_sanskrit": "समाहिता महानद्यः पीतलोहितवालुकाः।\nतस्मिन्गृहवरे रम्ये मणिशक्रसवालुकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2015186, "chapter_id": 1316, "verse_number": "२-५७-६०", "content_sanskrit": "मत्तबर्हिणनादाश्च कोकिलाश्च मदावहाः।\nबभूवुः परमोपेताः सर्वे जगति पर्वताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2015187, "chapter_id": 1316, "verse_number": "२-५७-६१", "content_sanskrit": "तत्रैव गजयूथानि तत्र गोमहिषास्तथा।\nनिवासाश्च कृतास्तत्र वराहा मृगपक्षिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2015188, "chapter_id": 1316, "verse_number": "२-५७-६२", "content_sanskrit": "विश्वकर्मकृतः शैलः प्राकारस्तत्र वेश्मनि।\nव्यक्तकिष्कुशतोद्यामः सुधारससमप्रभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2015189, "chapter_id": 1316, "verse_number": "२-५७-६३", "content_sanskrit": "तेन ते च महाशैलाः सरितश्च सरांसि च।\nपरिक्षिप्तानि वै तस्य वनान्युपवनानि च॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2015190, "chapter_id": 1316, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वण अर्घाहरणपर्वणि सप्तपञ्चाशोऽध्यायः॥ ५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]