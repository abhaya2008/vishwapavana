[{"id": 50015988, "chapter_id": 11567, "verse_number": "1", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50015989, "chapter_id": 11567, "verse_number": "2", "content_sanskrit": "नन्दस्त्वात्मज उत्पन्ने जाताह्लादो महामनाः। आहूय विप्रान् वेदज्ञान् स्नातः शुचिरलङ्कृतः॥ १०/६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50015990, "chapter_id": 11567, "verse_number": "3", "content_sanskrit": "वाचयित्वा स्वस्त्ययनं जातकर्मात्मजस्य वै। कारयामास विधिना पितृदेवार्चनं तथा॥ १०/६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50015991, "chapter_id": 11567, "verse_number": "4", "content_sanskrit": "धेनूनां नियुते प्रादाद् विप्रेभ्यः समलङ्कृते। तिलाद्रीन् सप्त रत्नाउघान् शातकुम्भान्तरावृतान्॥ १०/६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50015992, "chapter_id": 11567, "verse_number": "5", "content_sanskrit": "कालेन स्नानशौचाभ्यां संस्कारैस्तपसेज्यया। शुद्ध्यन्ति दानैः सन्तुष्ट्या द्रव्याण्यात्माऽऽत्मविद्यया॥१०/६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50015993, "chapter_id": 11567, "verse_number": "6", "content_sanskrit": "सौमङ्गल्यगिरो विप्राः सूतमागधबन्दिनः। गायकाश्च जगुर्नेदुर्भेर्यो दुन्दुभयो मुहुः॥ १०/६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50015994, "chapter_id": 11567, "verse_number": "7", "content_sanskrit": "प्रजाः सम्मृष्टसंसिक्तद्वाराजिरगृहान्तराः। चित्रध्वजपताकास्रक्चैलपल्लवतोरणाः॥ १०/६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50015995, "chapter_id": 11567, "verse_number": "8", "content_sanskrit": "गावो वृषाश्च वत्साश्च हरिद्रातैलरूषिताः। विचित्रधातुबर्हस्रग्वस्त्रकाञ्चनमालिनः॥ १०/६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50015996, "chapter_id": 11567, "verse_number": "9", "content_sanskrit": "महार्हवस्त्राभरणकञ्चुकोष्णीषभूषणाः। गोपाः समाययू राजन् नानोपायनपाणयः॥ १०/६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50015997, "chapter_id": 11567, "verse_number": "10", "content_sanskrit": "गोप्यश्चाकर्ण्य मुदिता यशोदायाः सुतोद्भवम्। आत्मानं भूषयाञ्चक्रुर्वस्त्राकल्पाञ्जनादिभिः॥ १०/६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50015998, "chapter_id": 11567, "verse_number": "11", "content_sanskrit": "नवकुङ्कुमकिञ्जल्कमुखपङ्कजभूतयः। बलिभिस्त्वरितं जग्मुः पृथुश्रोण्यश्चलत्कुचाः॥ १०/६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50015999, "chapter_id": 11567, "verse_number": "12", "content_sanskrit": "गोप्यः सुमृष्टमणिकुण्डलनिष्ककण्ठ्यः चित्राम्बराः पथि शिखाच्युतमाल्यवर्षाः। नन्दालयं सवलया व्रजतीर्विरेजुः व्यालोलकुण्डलपयोधरहारशोभाः॥ १०/६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50016000, "chapter_id": 11567, "verse_number": "13", "content_sanskrit": "ता आशिषः प्रयुञ्जानाश्चिरं पाहीति बालके। हरिद्राचूर्णतैलाद्भिः सिञ्चन्त्योऽजनमुज्जगुः॥ १०/६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50016001, "chapter_id": 11567, "verse_number": "14", "content_sanskrit": "अवाद्यन्त विचित्राणि वादित्राणि महोत्सवे। कृष्णे विश्वेश्वरेंऽशेन नन्दव्रजमुपेयुषि॥ १०/६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50016002, "chapter_id": 11567, "verse_number": "15", "content_sanskrit": "गोपाः परस्परं हृष्टा दधिक्षीरघृताम्बुभिः। आसिञ्चन्तो विलिम्पन्तो नवनीतैश्च चिक्षिपुः॥ १०/६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50016003, "chapter_id": 11567, "verse_number": "16", "content_sanskrit": "नन्दो महामनास्तेभ्यो वासोलङ्कारगोधनैः। सूतमागधबन्दिभ्यो येऽन्ये विद्योपजीविनः॥ १०/६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50016004, "chapter_id": 11567, "verse_number": "17", "content_sanskrit": "तैस्तैः कामैरदीनात्मा यथोचितमपूजयत्। विष्णोराराधनार्थाय स्वपुत्रस्योदयाय च॥ १०/६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50016005, "chapter_id": 11567, "verse_number": "18", "content_sanskrit": "रोहिणी च महाभागा नन्दगोपाभिनन्दिता। व्यचरद् दिव्ववासःस्रक्कण्ठाभरणभूषिता॥ १०/६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50016006, "chapter_id": 11567, "verse_number": "19", "content_sanskrit": "तत आरभ्य नन्दस्य व्रजः सर्वसमृद्धिमान्। हरेर्निवासानुगुणै रमाक्राडमभून्नृप॥ १०/६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50016007, "chapter_id": 11567, "verse_number": "20", "content_sanskrit": "गोपान् गोकुलरक्षायां निरूप्य मधुरां गतः। नन्दः कंसस्य वार्षिक्यं करं दातुं कुरूद्वह॥ १०/६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50016008, "chapter_id": 11567, "verse_number": "21", "content_sanskrit": "वसुदेव उपश्रुत्य भ्रातरं नन्दमागतम्। ज्ञात्वा दत्तकरं राज्ञे ययौ तदवलोकनः॥ १०/६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50016009, "chapter_id": 11567, "verse_number": "22", "content_sanskrit": "तं दृष्ट्वा सहसोत्थाय देहः प्राणमिवागतम्। प्रीतः प्रियतमं दोर्भ्यां सस्वजे प्रेमविह्वलः॥ १०/६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50016010, "chapter_id": 11567, "verse_number": "23", "content_sanskrit": "पूजितः सुखमासीनः पृष्ट्वाऽनामयमादृतः। प्रसक्तधीः स्वात्मजयोरिदमाह विशाम्पते॥ १०/६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50016011, "chapter_id": 11567, "verse_number": "24", "content_sanskrit": "दिष्ट्या भ्रातः प्रवयस इदानीमप्रजस्य ते। प्रजाशाया निवृत्तस्य प्रजा यत् समजायत॥ १०/६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50016012, "chapter_id": 11567, "verse_number": "25", "content_sanskrit": "दिष्ट्या संसारचक्रेऽस्मिन् वर्तमानः पुनर्भवे। उपलब्धो भवानद्य दुर्लभं प्रियदर्शनम्॥ १०/६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50016013, "chapter_id": 11567, "verse_number": "26", "content_sanskrit": "नैकत्र प्रियसंवासः सुहृदां चित्रकर्मणाम्। ओघेन व्यूह्यमानानां प्लवानां स्रोतसो यथा॥ १०/६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50016014, "chapter_id": 11567, "verse_number": "27", "content_sanskrit": "कच्चित् पशव्यं निरुजं भूर्यम्बुतृणवीरुधम्। बृहद्वनं तदधुना यत्रास्से त्वं सुहृद्वृतः॥ १०/६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50016015, "chapter_id": 11567, "verse_number": "28", "content_sanskrit": "भ्रातर्मम सुतः कच्चिन्मात्रा सह भवद्व्रजे। तातं भवन्तं मन्वानो भवद्भ्यामुपलाळितः॥ १०/६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50016016, "chapter_id": 11567, "verse_number": "29", "content_sanskrit": "पुंसस्त्रिवर्गो विहितः सुहृदां ह्यनुभावतः। न तेषु क्ल्श्यिमानेषु त्रिवर्गोऽर्थाय कल्पते॥ १०/६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50016017, "chapter_id": 11567, "verse_number": "30", "content_sanskrit": "नन्द उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50016018, "chapter_id": 11567, "verse_number": "31", "content_sanskrit": "अहो ते देवकापुत्राः कंसेन बहवो हताः। एकाऽवशिष्टाऽवरजा कन्या सापि दिवं गता॥ १०/६/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50016019, "chapter_id": 11567, "verse_number": "32", "content_sanskrit": "नूनं हि दृष्टनिष्ठोऽयं नादृष्टपरमो जनः। अदृष्टमात्मनस्तत्वं यो वेद न स मुह्यति॥ १०/६/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50016020, "chapter_id": 11567, "verse_number": "33", "content_sanskrit": "वसुदेव उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50016021, "chapter_id": 11567, "verse_number": "34", "content_sanskrit": "करो वै वार्षिको दत्तो राज्ञे दृष्टा वयं च वः। नेह स्थेयं बहुदिनं सन्त्युत्पाताश्च गोकुले॥ १०/६/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50016022, "chapter_id": 11567, "verse_number": "35", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50016023, "chapter_id": 11567, "verse_number": "36", "content_sanskrit": "इति नन्दादयो गोपाः प्रोक्तास्ते शौरिणा ययुः। अनोभिरनडुद्युक्तैस्तमनुज्ञाय गोकुलम्॥ १०/६/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50016024, "chapter_id": 11567, "verse_number": "37", "content_sanskrit": "इति श्रीमद्भागवते दशमस्कन्धे षष्ठोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]