[{"id": 2191552, "chapter_id": 5073, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2191553, "chapter_id": 5073, "verse_number": "१", "content_sanskrit": "तिष्ठते मे सदा तात कौतूहलमिदं हृदि ।\nतदहं श्रोतुमिच्छामि त्वत्तः कुरुपितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2191554, "chapter_id": 5073, "verse_number": "२", "content_sanskrit": "कथं देवर्षिरुशना सदा काव्यो महामतिः ।\nअसुराणां प्रियकरः सुराणामप्रिये रतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2191555, "chapter_id": 5073, "verse_number": "३", "content_sanskrit": "वर्धयामास तेजश्च किमर्थममितौजसाम् ।\nनित्यं वैरनिबद्धाश्च दानवाः सुरसत्तमैः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2191556, "chapter_id": 5073, "verse_number": "४", "content_sanskrit": "कथं चाप्युशना प्राप शुक्रत्वममरद्युतिः ।\nऋद्धिं च स कथं प्राप्तः सर्वमेतद् ब्रवीहि मे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2191557, "chapter_id": 5073, "verse_number": "५", "content_sanskrit": "न याति च स तेजस्वी मध्येन नभसः कथम् ।\nएतदिच्छामि विज्ञातुं निखिलेन पितामह\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2191558, "chapter_id": 5073, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2191559, "chapter_id": 5073, "verse_number": "६", "content_sanskrit": "शृणु राजन्नवहितः सर्वमेतद्यथातथम् ।\nयथामति यथा चैतच्छ्रुतपूर्वं मयानघ\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2191560, "chapter_id": 5073, "verse_number": "७", "content_sanskrit": "एष भार्गवदायादो मुनिः सत्यो दृढव्रतः ।\nअसुराणां प्रियकरो निमित्ते करुणात्मके\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2191561, "chapter_id": 5073, "verse_number": "८", "content_sanskrit": "इन्द्रोऽथ धनदो राजा यक्षरक्षोधिपः स च ।\nप्रभविष्णुश्च कोशस्य जगतश्च तथा प्रभुः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2191562, "chapter_id": 5073, "verse_number": "९", "content_sanskrit": "तस्यात्मानमथाविश्य योगसिद्धो महामुनिः ।\nरुद्ध्वा धनपतिं देवं योगेन हृतवान्वसु\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2191563, "chapter_id": 5073, "verse_number": "१०", "content_sanskrit": "हृते धने ततः शर्म न लेभे धनदस्तथा ।\nआपन्नमन्युः संविग्नः सोऽभ्यगात् सुरसत्तमम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2191564, "chapter_id": 5073, "verse_number": "११", "content_sanskrit": "निवेदयामास तदा शिवायामिततेजसे ।\nदेवश्रेष्ठाय रुद्राय सौम्याय बहुरूपिणे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2191565, "chapter_id": 5073, "verse_number": "", "content_sanskrit": "कुबेरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2191566, "chapter_id": 5073, "verse_number": "१२", "content_sanskrit": "योगात्मकेनोशनसा रुद्ध्वा मम हृतं वसु ।\nयोगेनात्मगतिं कृत्वा निःसृतश्च महातपाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2191567, "chapter_id": 5073, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2191568, "chapter_id": 5073, "verse_number": "१३", "content_sanskrit": "एतच्छ्रुत्वा ततः क्रुद्धो महायोगी महेश्वरः ।\nसंरक्तनयनो राजन् शूलमादाय तस्थिवान्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2191569, "chapter_id": 5073, "verse_number": "१४", "content_sanskrit": "क्वास्वौ क्वासाविति प्राह गृहीत्वा परमायुधम् ।\nउशना दूरतस्तस्य बभौ ज्ञात्वा चिकीर्षितम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2191570, "chapter_id": 5073, "verse_number": "१५", "content_sanskrit": "स महायोगिनो बुद्ध्वा तं रोषं वै महात्मनः ।\nगतिमागमनं वेत्ति स्थानं वेत्ति ततः प्रभुः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2191571, "chapter_id": 5073, "verse_number": "१६", "content_sanskrit": "सञ्चिन्त्योग्रेण तपसा महात्मानं महेश्वरम् ।\nउशना योगसिद्धात्मा शूलाग्रे प्रत्यदृश्यत\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2191572, "chapter_id": 5073, "verse_number": "१७", "content_sanskrit": "विज्ञातरूपः स तदा तपःसिद्धेन धन्विना ।\nज्ञात्वा शूलं च देवेशः पाणिना समनामयत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2191573, "chapter_id": 5073, "verse_number": "१८", "content_sanskrit": "आनतेनाथ शूलेन पाणिनामिततेजसा ।\nपिनाकमिति चोवाच शूलमुग्रायुधः प्रभुः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2191574, "chapter_id": 5073, "verse_number": "१९", "content_sanskrit": "पाणिमध्यगतं दृष्ट्वा भार्गवं तमुमापतिः ।\nआस्यं विवृत्य ककुदी पाणिं सम्प्राक्षिपच्छनैः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2191575, "chapter_id": 5073, "verse_number": "२०", "content_sanskrit": "स तु प्रविष्ट उशना कोष्ठं माहेश्वरं प्रभुः ।\nव्यचरच्चापि तत्रासौ महात्मा भृगुनन्दनः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2191576, "chapter_id": 5073, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2191577, "chapter_id": 5073, "verse_number": "२१", "content_sanskrit": "किमर्थं व्यचरद्राजन्नुशना तस्य धीमतः ।\nजठरे देवदेवस्य किं चाकार्षीन्महाद्युतिः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2191578, "chapter_id": 5073, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2191579, "chapter_id": 5073, "verse_number": "२२", "content_sanskrit": "पुरा सोऽन्तर्जलगतः स्थाणुभूतो महाव्रतः ।\nवर्षाणामभवद् राजन् प्रयुतान्यर्बुदानि च\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2191580, "chapter_id": 5073, "verse_number": "२३", "content_sanskrit": "उदतिष्ठत्तपस्तप्त्वा दुश्चरं स महाह्रदात् ।\nततो देवातिदेवस्तं ब्रह्मा समुपसर्पत\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2191581, "chapter_id": 5073, "verse_number": "२४", "content_sanskrit": "तपोवृद्धिमपृच्छच्च कुशलं चैनमव्ययम् ।\nतपः सुचीर्णमिति च प्रोवाच वृषभध्वजः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2191582, "chapter_id": 5073, "verse_number": "२५", "content_sanskrit": "तत्संयोगेन वृद्धिं चाप्यपश्यत् स तु शङ्करः ।\nमहामतिरचिन्त्यात्मा सत्यधर्मरतः सदा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2191583, "chapter_id": 5073, "verse_number": "२६", "content_sanskrit": "स तेनाढ्यो महायोगी तपसा च धनेन च ।\nव्यराजत महाराज त्रिषु लोकेषु वीर्यवान्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2191584, "chapter_id": 5073, "verse_number": "२७", "content_sanskrit": "ततः पिनाकी योगात्मा ध्यानयोगं समाविशत् ।\nउशना तु समुद्विग्नो निलिल्ये जठरे ततः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2191585, "chapter_id": 5073, "verse_number": "२८", "content_sanskrit": "तुष्टाव च महायोगी देवं तत्रस्थ एव च ।\nनिःसारं काङ्क्षमाणस्तु तेजसा प्रत्यहन्यत\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2191586, "chapter_id": 5073, "verse_number": "२९", "content_sanskrit": "उशना तु तदोवाच जठरस्थो महामुनिः ।\nप्रसादं मे कुरुष्वेति पुनः पुनररिन्दम\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2191587, "chapter_id": 5073, "verse_number": "३०", "content_sanskrit": "तमुवाच महादेवो गच्छ शिश्नेन मोक्षणम् ।\nइति स्रोतांसि सर्वाणि रुद्ध्वा त्रिदशपुङ्गवः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2191588, "chapter_id": 5073, "verse_number": "३१", "content_sanskrit": "अपश्यमानः स द्वारं सर्वतःपिहितो मुनिः ।\nपर्यक्रामद् दह्यमान इतश्चेतश्च तेजसा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2191589, "chapter_id": 5073, "verse_number": "३२", "content_sanskrit": "स विनिष्क्रम्य शिश्नेन शुक्रत्वमभिपेदिवान् ।\nकार्येण तेन नभसो नागच्छत च मध्यतः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2191590, "chapter_id": 5073, "verse_number": "३३", "content_sanskrit": "निष्क्रान्तमथ तं दृष्ट्वा ज्वलन्तमिव तेजसा ।\nभवो रोषसमाविष्टः शूलोद्यतकरः स्थितः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2191591, "chapter_id": 5073, "verse_number": "३४", "content_sanskrit": "न्यवारयत तं देवी क्रुद्धं पशुपतिं पतिम् ।\nपुत्रत्वमगमद्देव्या वारिते शङ्करे च सः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2191592, "chapter_id": 5073, "verse_number": "", "content_sanskrit": "देवी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2191593, "chapter_id": 5073, "verse_number": "३५", "content_sanskrit": "हिंसनीयस्त्वया नैष मम पुत्रत्वमागतः ।\nन हि देवोदरात् कश्चिन्निःसृतो नाशमर्छति\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2191594, "chapter_id": 5073, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2191595, "chapter_id": 5073, "verse_number": "३६", "content_sanskrit": "ततः प्रीतोऽभवद्देव्याः प्रहसंश्चेदमब्रवीत् ।\nगच्छत्वेष यथाकाममिति राजन् पुनः पुनः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2191596, "chapter_id": 5073, "verse_number": "३७", "content_sanskrit": "ततः प्रणम्य वरदं देवं देवीमुमां तथा ।\nउशना प्राप तद्धीमान् गतिमिष्टां महामुनिः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2191597, "chapter_id": 5073, "verse_number": "३८", "content_sanskrit": "एतत्ते कथितं तात भार्गवस्य महात्मनः ।\nचरितं भरतश्रेष्ठ यन्मां त्वं परिपृच्छसि\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2191598, "chapter_id": 5073, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे द्वाविंशोत्तरशततमोऽध्यायः ॥१२२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]