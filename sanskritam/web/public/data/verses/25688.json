[{"id": 7005688000, "chapter_id": 25688, "verse_number": "१६१-१", "content_sanskrit": "ऋषय ऊचुः ।\nइदानीं श्रोतुमिच्छामो हिरण्यकशिपोर्वधम् ।\nनरसिंहस्य माहात्म्यं तथा पापविनाशनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005688001, "chapter_id": 25688, "verse_number": "१६१-२", "content_sanskrit": "सूत उवाच ।\nपुरा कृतयुगे विप्रा हिरण्यकशिपुः प्रभुः ।\nदैत्यानामादिपुरुषश्चकार स महत्तपः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005688002, "chapter_id": 25688, "verse_number": "१६१-३", "content_sanskrit": "दशवर्षसहस्राणि दशवर्ष शतानि च ।\nजलवासी समभवत् स्नानमौन घृतव्रतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005688003, "chapter_id": 25688, "verse_number": "१६१-४", "content_sanskrit": "ततः शमदमाभ्याञ्च ब्रह्मचर्येण चैव हि ।\nब्रह्मा प्रीतोऽभवत्तस्य तपसा नियमेन च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005688004, "chapter_id": 25688, "verse_number": "१६१-५", "content_sanskrit": "ततः स्वयम्भूर्भगवान् स्वयमागम्य तत्र ह ।\nविमानेनार्कवर्णेन हंसयुक्तेन भास्वता ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005688005, "chapter_id": 25688, "verse_number": "१६१-६", "content_sanskrit": "आदित्यैर्वसुभिः साध्यैर्मरुद्भिर्दैवतैस्तथा ।\nरुद्रैर्विश्वसहायैश्च यक्षराक्षस पन्नगैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005688006, "chapter_id": 25688, "verse_number": "१६१-७", "content_sanskrit": "दिग्भिश्चैव विदिग्भिश्च नदीभिः सागरैस्तथा ।\nनक्षत्रैश्च मुहूर्तैश्च खेचरैश्च महाग्रहैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005688007, "chapter_id": 25688, "verse_number": "१६१-८", "content_sanskrit": "देवैर्ब्रह्मर्षिभिः सार्द्धं सिद्धैः सप्तर्षिभिस्तथा ।\nराजर्षिभिः पुण्यकृद्भिर्गन्धर्वाप्सरसाङ्गणैः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005688008, "chapter_id": 25688, "verse_number": "१६१-९", "content_sanskrit": "चराचरगुरुः श्रीमान् वृतः सर्वैर्दिवौकसैः ।\nब्रह्मा ब्रह्मविदां श्रेष्ठो दैत्यं वचनमब्रवीत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005688009, "chapter_id": 25688, "verse_number": "१६१-१०", "content_sanskrit": "प्रीतोऽस्मि तव भक्तस्य तपसाऽनेन सुव्रत! ।\nवरं वरय भद्रं ते यथेष्टं काममाप्नुहि ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005688010, "chapter_id": 25688, "verse_number": "१६१-११", "content_sanskrit": "हिरण्यकशिपुरुवाच ।\nन देवासुरगन्धर्वा न यक्षोरगरक्षसाः ।\nन मानुषाः पिशाचा वा हन्युर्मां देव सत्तम! ॥ ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005688011, "chapter_id": 25688, "verse_number": "१६१-१२", "content_sanskrit": "ऋषयो वा न मा शापैः शपेयुः प्रपितामह ।\nयदि मे भगवान्प्रीतो वर एष वृतो मया ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005688012, "chapter_id": 25688, "verse_number": "१६१-१३", "content_sanskrit": "न चास्त्रेण न शस्त्रेण गिरिणा पादपेन च ।\nन शुष्केण न चार्द्रेण न दिवा न निशाऽथवा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005688013, "chapter_id": 25688, "verse_number": "१६१-१४", "content_sanskrit": "भवेयमहमेवार्कः सोमो वायुर्हुताशनः ।\nसलिलञ्चान्तरिक्षञ्च नक्षत्राणि दिशो दश ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005688014, "chapter_id": 25688, "verse_number": "१६१-१५", "content_sanskrit": "अहं क्रोधश्च कामश्च वरुणो वासवो यमः ।\nधनदश्च धनाध्यक्षो यक्षः किंपुरुषाधिपः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005688015, "chapter_id": 25688, "verse_number": "१६१-१६", "content_sanskrit": "ब्रह्मोवाच ।\nएते दिव्या वरास्तात! मया दत्तास्तवाद्भुताः ।\nसर्वान् कामान् सदा वत्स! प्राप्स्यसे त्वं न संशयः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005688016, "chapter_id": 25688, "verse_number": "१६१-१७", "content_sanskrit": "एवमुक्त्वा स भगवान् जगामाकाश एव हि ।\nवैराजं ब्रह्मसदनं ब्रह्मर्षि गणसेवितम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005688017, "chapter_id": 25688, "verse_number": "१६१-१८", "content_sanskrit": "ततो देवाश्च नागाश्च गन्धर्वा ऋषिभिः सह ।\nवरप्रदानं श्रुत्वैव पितामहमुपस्थिताः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005688018, "chapter_id": 25688, "verse_number": "१६१-१९", "content_sanskrit": "देवा ऊचुः ।\nवरप्रदानाद् भगवन्! वधिष्यति स नोऽसुरः ।\nतत्प्रसीदाशु भगवन्! वदोऽप्यस्य विचिन्त्यताम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005688019, "chapter_id": 25688, "verse_number": "१६१-२०", "content_sanskrit": "भगवन् ।\nसर्वभूतानां आदिकर्ता स्वयं प्रभुः ।\nस्रष्टा त्वं हव्यकव्यानामव्यक्त प्रकृतिर्बुधः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005688020, "chapter_id": 25688, "verse_number": "१६१-२१", "content_sanskrit": "सर्वलोकहितं वाक्यं श्रुत्वा देवः प्रजापतिः ।\nआश्वासयामास सुरान् सुशीतैर्वचनाम्बुभिः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005688021, "chapter_id": 25688, "verse_number": "१६१-२२", "content_sanskrit": "अवश्यं त्रिदशास्तेन प्राप्तव्यं तपसः फलम् ।\nतपसोऽन्तेऽस्य भगवान् वधं विष्णुः करिष्यति ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005688022, "chapter_id": 25688, "verse_number": "१६१-२३", "content_sanskrit": "तच्छ्रुत्वा विबुधा वाक्यं सर्वे पङ्कज जन्मनः ।\nस्वानि स्तानानि दिव्यानि विप्रा जग्मुर्मुदान्विताः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005688023, "chapter_id": 25688, "verse_number": "१६१-२४", "content_sanskrit": "लब्धमात्रे वरे चाथ सर्वाः सोऽबाधत प्रजाः ।\nहिरण्यकशिपुर्दैत्यो वरदानेन दर्पितः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005688024, "chapter_id": 25688, "verse_number": "१६१-२५", "content_sanskrit": "आश्रमेषु महाभागान् स मुनीन्शंसितव्रतान् ।\nसत्यधर्मपरान् दान्तान् धर्षयामासदानवः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005688025, "chapter_id": 25688, "verse_number": "१६१-२६", "content_sanskrit": "देवांस्त्रिभुवनस्थांश्च पराजित्य महासुरः ।\nत्रैलोक्यं वशमानीय स्वर्गे वसति दानवः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005688026, "chapter_id": 25688, "verse_number": "१६१-२७", "content_sanskrit": "यदा वरमदोत्सिक्तश्चोदितः कालधर्मतः ।\nयज्ञियानकरोद्दैत्यानयज्ञियांश्च देवताः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005688027, "chapter_id": 25688, "verse_number": "१६१-२८", "content_sanskrit": "तदादित्याश्च साध्याश्च विश्वे च वसवस्तथा ।\nसेन्द्रा देवगणा यक्षाः सिद्ध द्विजमहर्षयः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005688028, "chapter_id": 25688, "verse_number": "१६१-२९", "content_sanskrit": "शरणं शरणं विष्णुमुपतस्थुर्महाबलम् ।\nदेवदेवं यज्ञमयं वासुदेवं सनातनम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005688029, "chapter_id": 25688, "verse_number": "१६१-३०", "content_sanskrit": "देवा ऊचुः ।\nनारायण! महाभाग! देवास्त्वां शरणं गताः ।\nत्रायस्व जहि दैत्येन्द्रं हिरण्यकशिपुं प्रभो! ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005688030, "chapter_id": 25688, "verse_number": "१६१-३१", "content_sanskrit": "त्वं हि नः परमो धाता त्वं हि न परमो गुरुः ।\nत्वं हि नः परमो देवो ब्रह्मादीनां सुरोत्तम ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005688031, "chapter_id": 25688, "verse_number": "१६१-३२", "content_sanskrit": "विष्णुरुवाच ।\nभयन्त्यजध्वममरा अभयं वो ददाम्यहम् ।\nतथैव त्रिदिवं देवाः प्रतिपद्यत मा चिरम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005688032, "chapter_id": 25688, "verse_number": "१६१-३३", "content_sanskrit": "एषोऽहं सगणं दैत्यं वरदानेन दर्पितम् ।\nअवध्यममरेन्द्राणां दानवेन्द्रं निहन्म्यहम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005688033, "chapter_id": 25688, "verse_number": "१६१-३४", "content_sanskrit": "एवमुक्त्वा तु भगवान् विसृज्य त्रिदशेश्वरान् ।\nवधं सङ्कल्पयामास हिरण्यकशिपोः प्रभुः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005688034, "chapter_id": 25688, "verse_number": "१६१-३५", "content_sanskrit": "सहायश्च महाबाहुरोङ्कारं गृह्य सत्वरम् ।\nअथोङ्कारसहायस्तु भगवान् विष्णुरव्ययः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005688035, "chapter_id": 25688, "verse_number": "१६१-३६", "content_sanskrit": "हिरण्यकशिपुस्थानं जगाम हरिरीश्वरः ।\nतेजसा भास्कराकारः शशी कान्त्येव चापरः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005688036, "chapter_id": 25688, "verse_number": "१६१-३७", "content_sanskrit": "नरस्य कृत्वार्द्धतनुं सिंहस्यार्द्धतनुं तथा ।\nनारसिंहेन वपुषा पाणिं संस्पृश्य पाणिना ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005688037, "chapter_id": 25688, "verse_number": "१६१-३८", "content_sanskrit": "ततोऽपश्यत विस्तीर्णां दिव्यां रम्यां मनोरमाम् ।\nसर्वकामयुतां शुभ्रां हिरण्यकशिपोः सभाम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005688038, "chapter_id": 25688, "verse_number": "१६१-३९", "content_sanskrit": "विस्तीर्णां योजनशतं शतमध्यर्द्धमायताम् ।\nवैहायसीङ्कामगमां पञ्चयोजनविस्तृताम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005688039, "chapter_id": 25688, "verse_number": "१६१-४०", "content_sanskrit": "जराशोकक्लमोपेतां निष्प्रकम्पां शिवां सुखाम् ।\nवेश्महर्म्यवतीं रम्यां ज्वलन्तीमिव तेजसा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005688040, "chapter_id": 25688, "verse_number": "१६१-४१", "content_sanskrit": "अन्तः सलिल संयुक्तां विहितां विश्वकर्म्मणा ।\nदिव्यरत्नमयैर्वृक्षैः फलपुष्पप्रदैर्युताम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005688041, "chapter_id": 25688, "verse_number": "१६१-४२", "content_sanskrit": "नीलपीतसितश्यामैः कृष्णैर्लोहितकैरपि ।\nअवतानैस्तथा गुल्मैर्मञ्जरी शतधारिभिः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005688042, "chapter_id": 25688, "verse_number": "१६१-४३", "content_sanskrit": "सिताभ्रघनसङ्काशा प्लवन्तीव व्यदृश्यत ।\nरश्मिवती भास्वरा च दिव्यगन्ध मनोरमा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005688043, "chapter_id": 25688, "verse_number": "१६१-४४", "content_sanskrit": "सुसुखा न च दुखा स न शीता न च घर्मदा ।\nन क्षुत्पिपासे ग्लानिं वा प्राप्यतां प्राप्नुवन्ति ते ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005688044, "chapter_id": 25688, "verse_number": "१६१-४५", "content_sanskrit": "नानारूपैरुपकृतां विचित्रैरति भास्वरैः ।\nस्तम्भैर्न विभृता सा वै शाश्वती चाक्षपा सदा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005688045, "chapter_id": 25688, "verse_number": "१६१-४६", "content_sanskrit": "सर्वे च कामाः प्रचुरा ये दिव्या ये च मानुषाः ।\nरसयुक्तं प्रभूतञ्च भक्ष्य भोज्यमनन्तकम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005688046, "chapter_id": 25688, "verse_number": "१६१-४७", "content_sanskrit": "पुण्यगन्ध स्रजश्चात्र नित्यपुष्पफलद्रुमाः ।\nउष्णे शीतानि तोयानि शीते चोष्णानि संति च ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005688047, "chapter_id": 25688, "verse_number": "१६१-४८", "content_sanskrit": "पुष्पिताग्रा महाशाखाः प्रवालाङ्कुरदारिणः ।\nलतावितानसंच्छन्ना नदीषु च सरःसु च ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005688048, "chapter_id": 25688, "verse_number": "१६१-४९", "content_sanskrit": "वृक्षान् बहुविधांस्तत्र मृगेन्द्रो ददृशे प्रभुः ।\nगन्धवन्ति च पुष्पाणि रसवन्ति फलानि च ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005688049, "chapter_id": 25688, "verse_number": "१६१-५०", "content_sanskrit": "नातिशीतानि नोष्णानि तत्र तत्र सरांसि च ।\nअपश्यत् सर्वतीर्थानि सभायां तस्य सो विभुः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005688050, "chapter_id": 25688, "verse_number": "१६१-५१", "content_sanskrit": "नलिनैः पुण्डरीकैश्च शतपत्रैः सुगन्धिभिः ।\nरक्तैः कुवलयैर्नींलैः कुमुदैः संवृतानि च ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005688051, "chapter_id": 25688, "verse_number": "१६१-५२", "content_sanskrit": "सुकान्तैर्धार्तराष्ट्रैश्च राजहंसैश्च सुप्रियः ।\nकारण्डवैश्चक्रवाकैः सारसैः कुररैरपि ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005688052, "chapter_id": 25688, "verse_number": "१६१-५३", "content_sanskrit": "विमलैः स्फाटिकाभैश्च पाण्डुरैश्च दनैर्द्विजैः ।\nबहु हंसोपगीतानि सारसाभिरुतानि च ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005688053, "chapter_id": 25688, "verse_number": "१६१-५४", "content_sanskrit": "गन्धवत्यः शुभास्तत्र पुष्टमञ्जरि धारिणीः ।\nदृष्टवान् पर्वताग्नेषु नागपुष्पधरा लताः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005688054, "chapter_id": 25688, "verse_number": "१६१-५५", "content_sanskrit": "केतक्यशोकसरलाः पुन्नाग तिलकार्जुनाः ।\nचूता नीपाः प्रस्थपुष्पाः कदम्वा बकुलाधवाः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005688055, "chapter_id": 25688, "verse_number": "१६१-५६", "content_sanskrit": "प्रियङ्गु पाटलावृक्षाः शाल्मल्यः सहरिद्रकाः ।\nसालास्तालास्तमालाश्च पञ्चकाश्च मनोरमाः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005688056, "chapter_id": 25688, "verse_number": "१६१-५७", "content_sanskrit": "तथैवान्ये व्यराजन्त सभायां पुष्पिता द्रुमाः ।\nविद्रुमाश्च द्रुमाश्चैव ज्वलिताग्निसमप्रभाः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005688057, "chapter_id": 25688, "verse_number": "१६१-५८", "content_sanskrit": "स्कन्धवन्तः सुशाखाश्च बहुतालसमुच्छ्रयाः ।\nअर्जुनाशोकवर्णाश्च बहवश्चित्रका द्रुमाः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005688058, "chapter_id": 25688, "verse_number": "१६१-५९", "content_sanskrit": "वरुणो वत्सनाभश्च पनसाः सह चन्दनैः ।\nनीलाः सुमनसश्चैव निम्बा अश्वत्थतिन्दुकाः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7005688059, "chapter_id": 25688, "verse_number": "१६१-६०", "content_sanskrit": "पारिजाताश्च लोघ्राश्च मल्लिका भद्रदारवः ।\nआमलक्यस्तथाजम्बु लकुचाः शैलवालुकाः ॥ ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7005688060, "chapter_id": 25688, "verse_number": "१६१-६१", "content_sanskrit": "कालीयकाद्रुकालाश्च हिङ्गवः पारियात्रकाः ।\nमन्दारकुन्दलक्ताश्च पतङ्गाः कुटजास्तथा ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7005688061, "chapter_id": 25688, "verse_number": "१६१-६२", "content_sanskrit": "रक्ताः कुरण्टकाश्चैव नीलाश्चागरुभिः सह ।\nकदम्बाश्चैव भव्याश्च दाडिमा वीजपूरकाः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7005688062, "chapter_id": 25688, "verse_number": "१६१-६३", "content_sanskrit": "सप्तपर्णाश्च बिल्वाश्च मधुपैरावतास्तथा ।\nअशोकाश्च तमालाश्च नाना गुल्मलतावृताः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7005688063, "chapter_id": 25688, "verse_number": "१६१-६४", "content_sanskrit": "मधूकाः सप्तपर्णाश्च बहवस्तीरगा द्रुमाः ।\nलताश्च विविधाकाराः पत्रपुष्पफलोपगाः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7005688064, "chapter_id": 25688, "verse_number": "१६१-६५", "content_sanskrit": "एते चान्ये च बहवस्तत्र काननजा द्रुमाः ।\nनानापुष्पफलोपेता व्यराजन्त समन्ततः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7005688065, "chapter_id": 25688, "verse_number": "१६१-६६", "content_sanskrit": "चकोराः शतपत्राश्च मत्तकोकिल सारिकाः ।\nपुष्पिताः पुष्पिताग्रैश्च सम्पतन्ति महाद्रुमाः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7005688066, "chapter_id": 25688, "verse_number": "१६१-६७", "content_sanskrit": "रक्तपीतारुणास्तत्र पादपाग्रगताः खगाः ।\nपरस्परमवेक्षन्ते प्रहृष्टा जीवजीवकाः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7005688067, "chapter_id": 25688, "verse_number": "१६१-६८", "content_sanskrit": "तस्यां सभायां दैत्येन्द्रो हिरण्यकशिपुस्तदा ।\nस्त्रीसहस्रैः परिवृतो विचित्राभरणाम्वरः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7005688068, "chapter_id": 25688, "verse_number": "१६१-६९", "content_sanskrit": "अनर्घ्यमणिवज्रार्चि शिखा ज्वलितकुण्डलः ।\nआसीनश्चासने चित्रे दश नल्वप्रमाणतः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7005688069, "chapter_id": 25688, "verse_number": "१६१-७०", "content_sanskrit": "दिवाकरनिभे दिव्ये दिव्यास्तरण संस्तृते ।\nदिव्यगन्धवहस्तत्र मारुतः सुसुखो ववौ ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7005688070, "chapter_id": 25688, "verse_number": "१६१-७१", "content_sanskrit": "हिरण्यकशिपुर्दैत्य आस्ते ज्वलितकुण्डलः ।\nउपचेरुर्महार्दैत्यं हिरण्यकशिपुं तदा ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7005688071, "chapter_id": 25688, "verse_number": "१६१-७२", "content_sanskrit": "दिव्यतानेन गीतानि जगुर्गन्धर्वसत्तमाः ।\nविश्वाची सहजन्याच प्रम्लोचेत्यभिविश्रुता ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7005688072, "chapter_id": 25688, "verse_number": "१६१-७३", "content_sanskrit": "दिव्याथ सौरभेयीच समीची पुञ्चिकस्थली ।\nमिश्रकेशीचरम्भा च चित्रलेखा शुचिस्मिता ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7005688073, "chapter_id": 25688, "verse_number": "१६१-७४", "content_sanskrit": "चारुकेशी घृताची च मेनका चोर्वशी तथा ।\nएताः सहस्रशश्चान्या नृत्यगीत विशारदाः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7005688074, "chapter_id": 25688, "verse_number": "१६१-७५", "content_sanskrit": "उपतिष्ठन्त राजानं हिरण्यकशिपुं प्रभुम् ।\nतत्रासीनं महाबाहुं हिरण्यकशिपुं प्रभुम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7005688075, "chapter_id": 25688, "verse_number": "१६१-७६", "content_sanskrit": "उपासन्त दितेः पुत्राः सर्वे लब्धवरास्तथा ।\nतमप्रतिमकर्माणं शतशोऽथ सहस्रशः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7005688076, "chapter_id": 25688, "verse_number": "१६१-७७", "content_sanskrit": "बलिर्विरोचनस्तत्र नरकः पृथिवीसुतः ।\nप्रह्लादो विप्रचित्तिश्च गविष्ठश्च महासुरः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7005688077, "chapter_id": 25688, "verse_number": "१६१-७८", "content_sanskrit": "सुरहन्ता दुःखहन्ता सुनामा सुमतिर्वरः ।\nघटोदरो महापार्श्वः क्रथनः कठिनस्तथा ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7005688078, "chapter_id": 25688, "verse_number": "१६१-७९", "content_sanskrit": "विश्वरूपः सुरूपश्च स्वबलश्च महाबलः ।\nदशग्रीवश्च वालीच मेघवासा महासुरः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7005688079, "chapter_id": 25688, "verse_number": "१६१-८०", "content_sanskrit": "घटास्यो कम्पनश्चैव प्रजनश्चेन्द्र तापनः ।\nदैत्यदानवसंघास्ते सर्वे ज्वलितकुण्डलाः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7005688080, "chapter_id": 25688, "verse_number": "१६१-८१", "content_sanskrit": "स्रग्विणो वाग्मिनः सर्वे सदैव चरितव्रताः ।\nसर्वे लब्धवराः शूराः सर्वे विगतमृत्यवः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7005688081, "chapter_id": 25688, "verse_number": "१६१-८२", "content_sanskrit": "एते चान्ये च बहवो हिरण्यकशिपुं प्रभुम् ।\nउपासन्ति महात्मानं सर्वे दिव्यपरिच्छदाः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7005688082, "chapter_id": 25688, "verse_number": "१६१-८३", "content_sanskrit": "विमानैर्विविधाकारैर्भ्राजमानैरिवाग्निभिः ।\nमहेन्द्रवपुषः सर्वे विचित्राङ्गदवाहवः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7005688083, "chapter_id": 25688, "verse_number": "१६१-८४", "content_sanskrit": "भूषिताङ्गा दितेः पुत्रास्तमुपासन्त सर्वशः ।\nतस्यां सभायान्दिव्यायामसुराः पर्वतोपमाः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7005688084, "chapter_id": 25688, "verse_number": "१६१-८५", "content_sanskrit": "हिरण्यवपुषः सर्वे दिवाकरसमप्रभाः ।\nन श्रुतन्नैव दृष्टं हि हिरण्यकशिपोर्यथा ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7005688085, "chapter_id": 25688, "verse_number": "१६१-८६", "content_sanskrit": "ऐश्वर्यं दैत्यसिंहस्य यथा तस्य महात्मनः ।\nकनकरजतचित्रवेदिकायां परिहृतरत्न विचित्रवीथिकायाम् ।\n॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7005688086, "chapter_id": 25688, "verse_number": "१६१-८७", "content_sanskrit": "स ददर्श मृगाधिपः सभायां सुरचितरत्न गवाक्षशोभितायाम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7005688087, "chapter_id": 25688, "verse_number": "१६१-८८", "content_sanskrit": "कनकविमलहारविभूषिताङ्गं दितितनयं स मृगाधिपो ददर्श ।\nदिवसकर महाप्रभालसं तन्दितिजसहस्रशतैः निषेव्यमाणम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}]