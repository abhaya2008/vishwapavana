[{"id": 2169836, "chapter_id": 4630, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2169837, "chapter_id": 4630, "verse_number": "१", "content_sanskrit": "वर्तमाने तदा युद्धे क्षत्रियाणां निमज्जने ।\nगाण्डीवस्य महान् घोषः शुश्रुवे युधि मारिष\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2169838, "chapter_id": 4630, "verse_number": "२", "content_sanskrit": "संशप्तकानां कदनमकरोद् यत्र पाण्डवः ।\nकोसलानां तथा राजन् नारायणबलस्य च\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2169839, "chapter_id": 4630, "verse_number": "३", "content_sanskrit": "संशप्तकास्तु समरे शरवृष्टिं समन्ततः ।\nअपातयन् पार्थमूर्ध्नि जयगृद्धाः प्रमन्यवः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2169840, "chapter_id": 4630, "verse_number": "४", "content_sanskrit": "तां वृष्टिं सहसा राजन् तरसा धारयन् प्रभुः ।\nव्यगाहत रणे पार्थो विनिघ्नन् रथिनां वरः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2169841, "chapter_id": 4630, "verse_number": "५", "content_sanskrit": "निगृह्य तु रथानीकं कङ्कपत्रैः शिलाशितैः ।\nआससाद रणे पार्थः सुशर्माणं महारथम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2169842, "chapter_id": 4630, "verse_number": "६", "content_sanskrit": "स तस्य शरवर्षाणि ववर्ष रथिनां वरः ।\nतथा संशप्तकाश्चैव पार्थं बाणै समार्पयन्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2169843, "chapter_id": 4630, "verse_number": "७", "content_sanskrit": "सुशर्मा तु ततः पार्थं विद्ध्वा नवभिराशुगैः ।\nजनार्दनं त्रिभिर्बाणैरभ्यहन् दक्षिणे भुजे\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2169844, "chapter_id": 4630, "verse_number": "८", "content_sanskrit": "ततोऽपरेण भल्लेन केतुं विव्याध मारिष\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2169845, "chapter_id": 4630, "verse_number": "९", "content_sanskrit": "स वानरवरो राजन् विश्वकर्मकृतो महान् ।\nननाद सुमहन्नादं भीषयन् वै ननर्त च\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2169846, "chapter_id": 4630, "verse_number": "१०", "content_sanskrit": "कपेस्तु निनदं श्रुत्वा सन्त्रस्ता तव वाहिनी ।\nभयं विपुलमादाय निश्चेष्टा समपद्यत\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2169847, "chapter_id": 4630, "verse_number": "११", "content_sanskrit": "ततः सा शुशुभे सेना निश्चेष्टावस्थिता नृप ।\nनानापुष्पसमाकीर्णं यथा चैत्ररथं वनम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2169848, "chapter_id": 4630, "verse_number": "१२", "content_sanskrit": "प्रतिलभ्य ततः सञ्ज्ञां योधास्ते कुरुसत्तम ।\nअर्जुनं सिषिचुर्वाणैः पर्वतं जलदा इव\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2169849, "chapter_id": 4630, "verse_number": "१३", "content_sanskrit": "परिवव्रुस्तदा सर्वे पाण्डवस्य महारथम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2169850, "chapter_id": 4630, "verse_number": "१४", "content_sanskrit": "ते हयान् रथचक्रे च रथेषाश्चापि भारत ।\nनिगृह्य बलवत्तूर्णं सिंहनादमथानदन्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2169851, "chapter_id": 4630, "verse_number": "१५", "content_sanskrit": "अपरे जगृहुश्चैव केशवस्य महाभुजौ ।\nपार्थमन्ये महाराज रथस्थं जगृहुर्मुदा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2169852, "chapter_id": 4630, "verse_number": "१६", "content_sanskrit": "केशवस्तु तदा बाहू विधुन्वन् रणमूर्धनि ।\nपातयामास तान् सर्वान् दुष्टहस्तीव हस्तिपान्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2169853, "chapter_id": 4630, "verse_number": "१७", "content_sanskrit": "ततः क्रुद्धो रणे पार्थः संवृतस्तैर्महारथैः ।\nनिगृहीतं रथं दृष्ट्वा केशवं चाप्यभिद्रुतम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2169854, "chapter_id": 4630, "verse_number": "१८", "content_sanskrit": "रथारूढांश्च सुबहून् पदातींश्चाप्यपातयत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2169855, "chapter_id": 4630, "verse_number": "१९", "content_sanskrit": "आसन्नांश्च ततो योधान् शरैरासन्नयोधिभिः ।\nद्रावयामास समरे केशवं चेदमब्रवीत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2169856, "chapter_id": 4630, "verse_number": "२०", "content_sanskrit": "पश्य कृष्ण महाबाहो संशप्तकगणान् बहून् ।\nकुर्वाणान् दारुणं कर्म वध्यमानान् सहस्रशः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2169857, "chapter_id": 4630, "verse_number": "२१", "content_sanskrit": "रथबन्धमिमं घोरं पृथिव्यां नास्ति कश्चन ।\nयः सहेत पुमान् लोके मदन्यो यदुपुङ्गव\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2169858, "chapter_id": 4630, "verse_number": "२२", "content_sanskrit": "इत्येवमुक्त्वा बीभत्सुर्देवदत्तमथाधमत् ।\nपाञ्चजन्यं च कृष्णोऽपि पूरयन्निव रोदसी\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2169859, "chapter_id": 4630, "verse_number": "२३", "content_sanskrit": "तं तु शङ्खस्वनं श्रुत्वा संशप्तकवरूथिनी ।\nसञ्चचाल महाराज वित्रस्ता चाभवद् भृशम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2169860, "chapter_id": 4630, "verse_number": "२४", "content_sanskrit": "पादबन्धं ततश्चक्रे पाण्डवः परवीरहा ।\nनागमस्त्रं महाराज सम्प्रोदीर्य मुहुर्मुहुः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2169861, "chapter_id": 4630, "verse_number": "२५", "content_sanskrit": "यानुद्दिश्य रणे पार्थः पादबन्धं चकार ह ।\nते बद्धाः पादबन्धेन पाण्डवेन महात्मना\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2169862, "chapter_id": 4630, "verse_number": "२६", "content_sanskrit": "निश्चेष्टा अभवन् राजन् अश्मसारमया इव\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2169863, "chapter_id": 4630, "verse_number": "२७", "content_sanskrit": "निश्चेष्टांस्तु ततो योधानवधीत् पाण्डुनन्दनः ।\nयथेन्द्रः समरे दैत्यांस्तारकस्य वधे पुरा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2169864, "chapter_id": 4630, "verse_number": "२८", "content_sanskrit": "ते वध्यमानाः समरे मुमुचुस्तं रथोत्तमम् ।\nआयुधानि च सर्वाणि विस्रष्टुमुपचक्रमुः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2169865, "chapter_id": 4630, "verse_number": "२९", "content_sanskrit": "ततः सुशर्मा राजेन्द्र गृहीतां वीक्ष्य वाहिनीम् ।\nसौपर्णमस्त्रं त्वरितः प्रादुश्चक्रे महारथः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2169866, "chapter_id": 4630, "verse_number": "३०", "content_sanskrit": "ततः सुपर्णाः सम्पेतुर्भक्षयन्तो भुजङ्गमान् ।\nते वै विदुद्रुवुर्नागा दृष्ट्वा तान् खचरान् नृप\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2169867, "chapter_id": 4630, "verse_number": "३१", "content_sanskrit": "बभौ बलं तद्विमुक्तं पादबन्धाद् विशाम्पते ।\nमेघवृन्दाद् यथा मुक्तो भास्करस्तापयन् प्रजाः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2169868, "chapter_id": 4630, "verse_number": "३२", "content_sanskrit": "विप्रमुक्तास्तु ते योधाः फल्गुनस्य रथं प्रति ।\nससृजुर्बाणसङ्घांश्च शस्त्रसङ्घांश्च मारिष\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2169869, "chapter_id": 4630, "verse_number": "३३", "content_sanskrit": "तां महास्त्रमयीं वृष्टिं सञ्छिद्य शरवृष्टिभिः ।\nन्यवधीच्च ततो योधान् वासविः परवीरहा\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2169870, "chapter_id": 4630, "verse_number": "३४", "content_sanskrit": "सुशर्मा तु ततो राजन् बाणेनानतपर्वणा ।\nअर्जुनं हृदये विद्ध्वा विव्याधान्यैस्त्रिभिः शरैः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2169871, "chapter_id": 4630, "verse_number": "३५", "content_sanskrit": "स गाढविद्धो व्यथितो रथोपस्थ उपाविशत्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2169872, "chapter_id": 4630, "verse_number": "३६", "content_sanskrit": "प्रतिलभ्य ततः सञ्ज्ञां श्वेताश्वः कृष्णसारथिः ।\nऐन्द्रमस्त्रममेयात्मा प्रादुश्चक्रे त्वरान्वितः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2169873, "chapter_id": 4630, "verse_number": "३७", "content_sanskrit": "ततो बाणसहस्राणि समुत्पन्नानि मारिष\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2169874, "chapter_id": 4630, "verse_number": "३८", "content_sanskrit": "सर्वदिक्षु व्यदृश्यन्त सूदयन्तो नृप द्विपान् ।\nहयान् रथांश्च समरे शस्त्रैः शतसहस्रशः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2169875, "chapter_id": 4630, "verse_number": "३९", "content_sanskrit": "वध्यमाने ततः सैन्ये विपुला भीः समाविशत् ।\nसंशप्तकगणानां च गोपालानां च भारत\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2169876, "chapter_id": 4630, "verse_number": "४०", "content_sanskrit": "न हि कश्चित्पुमांस्तत्र योऽर्जुनं प्रत्ययुध्यत\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2169877, "chapter_id": 4630, "verse_number": "४१", "content_sanskrit": "पश्यतां तत्र वीराणामहन्यत महद् बलम् ।\nहन्यमानमपश्यंश्च निश्चेष्टाः स्म पराक्रमे\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2169878, "chapter_id": 4630, "verse_number": "४२", "content_sanskrit": "अयुतं तत्र योधानां हत्वा पाण्डुसुतो रणे ।\nव्यभ्राजत रणे राजन् विधूमोऽग्निरिव ज्वलन्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2169879, "chapter_id": 4630, "verse_number": "४३", "content_sanskrit": "चतुर्दश सहस्राणि यानि शिष्टानि भारत ।\nरथानामयुतं चैव त्रिसाहस्राश्च दन्तिनः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2169880, "chapter_id": 4630, "verse_number": "४४", "content_sanskrit": "ततः संशप्तका भूयः परिवव्रुर्धनञ्जयम् ।\nमर्तव्यमिति निश्चित्य जयं वाप्यनिवर्तनम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2169881, "chapter_id": 4630, "verse_number": "४५", "content_sanskrit": "आसीत् तत्र महद् युद्धं तावकानां विशाम्पते ।\nशूरेण बलिना सार्धं पाण्डवेन किरीटिना\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2169882, "chapter_id": 4630, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nसङ्कुलयुद्धे पञ्चाशोऽध्यायः ॥५०॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]