[{"id": 7004434000, "chapter_id": 24434, "verse_number": "५-३-१२८-१", "content_sanskrit": "मार्कण्डेय उवाच ।\nततो गच्छेत्तु राजेन्द्र भृकुटेश्वरमुत्तमम् ।\nयत्र सिद्धो महाभागो भृगुः परमकोपनः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004434001, "chapter_id": 24434, "verse_number": "५-३-१२८-२", "content_sanskrit": "तेन वर्षशतं साग्रं तपश्चीर्णं पुरानघ ।\nपुत्रार्थं वरयामास पुत्रं पुत्रवतां वरः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004434002, "chapter_id": 24434, "verse_number": "५-३-१२८-३", "content_sanskrit": "वरो दत्तो महाभाग देवेनान्धकघातिना ।\nतत्र तीर्थे तु यः स्नात्वा पूजयेत्परमेश्वरम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004434003, "chapter_id": 24434, "verse_number": "५-३-१२८-४", "content_sanskrit": "अग्निष्टोमस्य यज्ञस्य फलमष्टगुणं लभेत् ।\nभृकुटेशं तु यः कश्चिद्घृतेन मधुना सह॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004434004, "chapter_id": 24434, "verse_number": "५-३-१२८-५", "content_sanskrit": "पुत्रार्थी स्नापयेद्भक्त्या स लभेत्पुत्रमीप्सितम् ।\nतत्र तीर्थे तु यः स्नात्वा दद्याद्विप्राय काञ्चनम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004434005, "chapter_id": 24434, "verse_number": "५-३-१२८-६", "content_sanskrit": "गोदानं वा महीं वापि तस्य पुण्यफलं शृणु॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004434006, "chapter_id": 24434, "verse_number": "५-३-१२८-७", "content_sanskrit": "ससमुद्रगुहा तेन सशैलवनकानना ।\nदत्ता पृथ्वी न सन्देहस्तेन सर्वा नृपोत्तम॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004434007, "chapter_id": 24434, "verse_number": "५-३-१२८-८", "content_sanskrit": "तेन दानेन स स्वर्गे क्रीडयित्वा यथासुखम् ।\nमर्त्ये भवति राजेन्द्रो ब्राह्मणो वा सुपूजितः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}]