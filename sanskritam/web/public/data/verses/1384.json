[{"id": 2018436, "chapter_id": 1384, "verse_number": "३-२२-०x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2018437, "chapter_id": 1384, "verse_number": "३-२२-१", "content_sanskrit": "ततोऽहं भरतश्रेष्ठ प्रगृह्यरुचिरं धनुः।\nशरैरपातयं सौभाच्छिरांसि विबुधद्विषाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2018438, "chapter_id": 1384, "verse_number": "३-२२-२", "content_sanskrit": "शरांश्चाशीविषाकारानूर्ध्वगांस्तिग्मतेजसः।\nप्रैषयं साल्वराजाय शार्ङ्गमुक्तान्सुवाससः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2018439, "chapter_id": 1384, "verse_number": "३-२२-३", "content_sanskrit": "ततो नादृश्यत तदा सौभं कुरुकुलोद्वह।\nअन्तर्हितं माययाऽभूत्ततोऽहं विस्मितोऽभवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2018440, "chapter_id": 1384, "verse_number": "३-२२-४", "content_sanskrit": "अथ दानवसङ्घास्ते विकृताननमूर्धजाः।\nउदक्रोशन्महाराज धिष्ठिते मयि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2018441, "chapter_id": 1384, "verse_number": "३-२२-५", "content_sanskrit": "ततोऽस्त्रं शब्दसाहं वै त्वरमाणो महारणे।\nअयोजयं तद्वधाय ततः शब्द उपारमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2018442, "chapter_id": 1384, "verse_number": "३-२२-६", "content_sanskrit": "हतास्ते दानवाः सर्वे यैः स शब्द उदीरितः।\nशरैरादित्यसंकशैर्ज्वलितैः शब्दसाधनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2018443, "chapter_id": 1384, "verse_number": "३-२२-७", "content_sanskrit": "तस्मिन्नुपरते शब्दे पुनरेवान्यतोऽभवत्।\nशब्दोऽपरो महाराज तत्रापि प्राहरं शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2018444, "chapter_id": 1384, "verse_number": "३-२२-८", "content_sanskrit": "एवं दश दिशः सर्वास्तिर्यगूर्ध्वं च भारत।\nनादयामासुरसुरास्ते चापि निहता मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2018445, "chapter_id": 1384, "verse_number": "३-२२-९", "content_sanskrit": "ततः प्राग्ज्योतिषं गत्वा पुनरेव व्यदृश्यत।\nसौभं कामगमं वीर मोहयन्मम चक्षुषी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2018446, "chapter_id": 1384, "verse_number": "३-२२-१०", "content_sanskrit": "ततो लोकान्तकरणो दानवो दारुणाकृतिः।\nशिलावर्षेण महता सहसा मां समावृणोत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2018447, "chapter_id": 1384, "verse_number": "३-२२-११", "content_sanskrit": "सोहं पर्वतवर्षेण वध्यमानः समन्ततः।\nवल्मीक इव राजेन्द्र पर्वतोपचितोऽभवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2018448, "chapter_id": 1384, "verse_number": "३-२२-१२", "content_sanskrit": "ततोऽहं पर्वतचितः सहयः सहसारथिः।\nअप्रख्यातिमियां राजन्सध्वजः पर्वतैश्चितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2018449, "chapter_id": 1384, "verse_number": "३-२२-१३", "content_sanskrit": "ततो वृष्णिप्रवीरा ये ममासन्सैनिकास्तदा।\nते भयर्ता दिशः सर्वे सहसा विप्रदुद्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2018450, "chapter_id": 1384, "verse_number": "३-२२-१४", "content_sanskrit": "ततो हाहाकृतमभूत्सर्वं किल विशांपते।\nद्यौश्च भूमिश्च खं चैवादृश्यमाने तथा मयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2018451, "chapter_id": 1384, "verse_number": "३-२२-१५", "content_sanskrit": "ततो विषण्णमनसो मम राजन्सुहृज्जनाः।\nरुरुदुश्चुक्रुशुश्चैव दुःखशोकसमन्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2018452, "chapter_id": 1384, "verse_number": "३-२२-१६", "content_sanskrit": "द्विषतां च प्रहर्षोऽभूदार्तिश्च सुहृदामपि।\nएवं विजितवान्वीर पश्चादश्रौषमच्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2018453, "chapter_id": 1384, "verse_number": "३-२२-१७", "content_sanskrit": "ततोऽहमिन्द्रदयितं सर्वपाषाणभेदनम्।\nवज्रमुद्यम्य तान्सर्वान्पर्वतान्समशातयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2018454, "chapter_id": 1384, "verse_number": "३-२२-१८", "content_sanskrit": "ततः पर्वतभारार्ता मन्दप्राणविचेष्टिताः।\nहया मम महाराज वेपमाना इवाभवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2018455, "chapter_id": 1384, "verse_number": "३-२२-१९", "content_sanskrit": "मेघजाल इवाकाशे विदार्याभ्युदितं रविम्।\nदृष्ट्वा मां बान्धवाः सर्वे हर्षमाहारयन्पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2018456, "chapter_id": 1384, "verse_number": "३-२२-२०", "content_sanskrit": "ततः पर्वतभारार्तान्मन्दप्राणविचेष्टितान्।\nहयान्संदृश्य मां सूतः प्राह तात्कालिकं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2018457, "chapter_id": 1384, "verse_number": "३-२२-२१", "content_sanskrit": "साधु संपश्य वार्ष्णेय साल्वं सौभपतिं स्थितम्।\nअलं कृष्णावमन्यैनं साधु यत्नं समाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2018458, "chapter_id": 1384, "verse_number": "३-२२-२२", "content_sanskrit": "मार्दवं सखितां चैव साल्वादद्य व्यपाहर।\nजहि साल्वं महाबाहो मैनं जीवय केशव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2018459, "chapter_id": 1384, "verse_number": "३-२२-२३", "content_sanskrit": "सर्वैः पराक्रमैर्वीर वध्यः शत्रुरमित्रहन्।\nन शत्रुरवमन्तव्यो दुर्बलोऽपि बलीयसा।\nयोपिस्यात्पीठगः कश्चित्किं पुनः समरे स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2018460, "chapter_id": 1384, "verse_number": "३-२२-२४", "content_sanskrit": "स त्वं पुरुषशार्दूल सर्वयत्नैरिमं प्रभो।\nजहि वृष्णिकुलश्रेष्ठ मा त्वां कालोऽत्यगात्पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2018461, "chapter_id": 1384, "verse_number": "३-२२-२५", "content_sanskrit": "जितवाञ्जामदग्न्यं यः कोटिवर्षगणान्बहून्।\nस एष नान्यैर्वध्यो हि त्वामृते नास्ति कश्चन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2018462, "chapter_id": 1384, "verse_number": "३-२२-२६", "content_sanskrit": "नैष मार्दवसाध्यो वै मतो नापि सखा तव।\nयेन त्वं योधितो वीर द्वारका चावमर्दिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2018463, "chapter_id": 1384, "verse_number": "३-२२-२७", "content_sanskrit": "एवमादि तु कौन्तेय श्रुत्वाऽहं सारथेर्वचः।\nतत्वमेतदिति ज्ञात्वा युद्धे मतिमधारयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2018464, "chapter_id": 1384, "verse_number": "३-२२-२८", "content_sanskrit": "वधाय साल्वराजस्य सौभस्य च निपातने।\nदारुकं चाब्रुवं वीर मुहूर्तं स्थीयतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2018465, "chapter_id": 1384, "verse_number": "३-२२-२९", "content_sanskrit": "ततोऽप्रतिहतं दिव्यमभोद्यमतिवीर्यवत्।\nआग्नेयमस्त्रं दयितं सर्वसाहं महाप्रभम्।\nयोजयं तत्रधनुषा दानवान्तकरं रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2018466, "chapter_id": 1384, "verse_number": "३-२२-३०", "content_sanskrit": "यक्षाणां राक्षसानां च दानवानां च संयुगे।\nराज्ञां च प्रतिलोमानां भस्मान्तकरणं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2018467, "chapter_id": 1384, "verse_number": "३-२२-३१", "content_sanskrit": "क्षुरान्तममलं चक्रं कालान्तकयमोपमम्।\nअनुमन्त्र्याहमतुलं द्विषतां विनिबर्हणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2018468, "chapter_id": 1384, "verse_number": "३-२२-३२", "content_sanskrit": "जहि सौभं स्ववीर्येण ये चात्र रिपवो मम।\nइत्युक्त्वा भुजवीर्येण तस्मै प्राहिणवं रुषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2018469, "chapter_id": 1384, "verse_number": "३-२२-३३", "content_sanskrit": "रूपं सुदर्शनस्यासीदाकाशे पततस्तदा।\nद्वितीयस्येव सूर्यस् युगान्ते प्रतपिष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2018470, "chapter_id": 1384, "verse_number": "३-२२-३४", "content_sanskrit": "तत्समासाद्य नगरं सौभं व्यपगतत्विषम्।\nमध्येन पाटयामास क्रकचो दार्विवोच्छ्रितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2018471, "chapter_id": 1384, "verse_number": "३-२२-३५", "content_sanskrit": "द्विधा कृतं ततः सौभं सुदर्शनबलाद्धतम्।\nमहेश्वरशरोद्धूतं पपात त्रिपुरं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2018472, "chapter_id": 1384, "verse_number": "३-२२-३६", "content_sanskrit": "तस्मिन्निपतिते सौभे चक्रमागात्करं मम।\nपुनश्चादाय वेगेन साल्वायेत्यहमब्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2018473, "chapter_id": 1384, "verse_number": "३-२२-३७", "content_sanskrit": "ततः साल्वं गदां गुर्वीमाविध्यन्ते महाहवे।\nद्विधा चकार सहसा प्रजज्वाल च तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2018474, "chapter_id": 1384, "verse_number": "३-२२-३८", "content_sanskrit": "तस्मिन्विनिहते वीरे दानवास्त्रस्तचेतसः।\nहाहाभूता दिशो जग्मुरर्दिता मम सायकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2018475, "chapter_id": 1384, "verse_number": "३-२२-३९", "content_sanskrit": "ततोऽहंसमवस्थाप्यरथं सौभसमीपतः।\nशङ्खं प्रध्माप्य हर्षेण सुहृदः पर्यहर्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2018476, "chapter_id": 1384, "verse_number": "३-२२-४०", "content_sanskrit": "तन्मेरुशिखराकारं विध्वस्ताट्टालगोपुरम्।\nदह्यमानमभिप्रेक्ष्य स्त्रियस्ताः संप्रदुद्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2018477, "chapter_id": 1384, "verse_number": "३-२२-४१", "content_sanskrit": "एवं निहत्य समरे सौभं साल्वं निपात्य च।\nआनर्तात्पुनरागम्य सुहृदां प्रीतिमावहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2018478, "chapter_id": 1384, "verse_number": "३-२२-४२", "content_sanskrit": "तदेतत्कारणं राजन्नागमं नागसाह्वयम्।\nयद्यागां परवीरघ्न न हि जीवेत्सुयोधनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2018479, "chapter_id": 1384, "verse_number": "३-२२-४३", "content_sanskrit": "मय्यागतेऽथवा वीर द्यूतं न भविता तथा।\nअद्याहं किं करिष्यामि भिन्नसेतुरिवोदकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2018480, "chapter_id": 1384, "verse_number": "३-२२-४४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2018481, "chapter_id": 1384, "verse_number": "३-२२-४४", "content_sanskrit": "एवमुक्त्वा महाबाहुः कौरवं पुरुषोत्तमः।\nआमन्त्र्य प्रययौ श्रीमान्पाण्डवान्मधुसूदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2018482, "chapter_id": 1384, "verse_number": "३-२२-४५", "content_sanskrit": "अभिवाद्य महाबाहुर्धर्मराजं युधिष्ठिरम्।\nराज्ञा मूर्धन्युपाघ्रातो भीमेन च महाभुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2018483, "chapter_id": 1384, "verse_number": "३-२२-४६", "content_sanskrit": "परिष्वक्तश्चार्जुनेन यमाभ्यां चाभिवादितः।\nसंमानितश्च धौम्येन द्रौपद्या चार्चितोश्रुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2018484, "chapter_id": 1384, "verse_number": "३-२२-४७", "content_sanskrit": "सुभद्रामभिमन्युं च रथमारोप्य काञ्चनम्।\nआरुरोह रथं कृष्णः पाण्डवैरभिपूजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2018485, "chapter_id": 1384, "verse_number": "३-२२-४८", "content_sanskrit": "शैब्यसुग्रीवयुक्तेन रथेनादित्यवर्चसा।\nद्वारकां प्रययौ कृष्णः समाश्वास्य युधिष्ठिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2018486, "chapter_id": 1384, "verse_number": "३-२२-४९", "content_sanskrit": "ततः प्रयते दाशार्हे धृष्टद्युम्नोपि पार्षतः।\nद्रौपदेयानुपादाय प्रययौ स्वपुरं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2018487, "chapter_id": 1384, "verse_number": "३-२२-५०", "content_sanskrit": "धृष्टकेतुः स्वसारं च समादायाथ चेदिराट्।\nजगाम पाण्डवान्दृष्ट्वा रम्यां शुक्तिमतीं पुरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2018488, "chapter_id": 1384, "verse_number": "३-२२-५१", "content_sanskrit": "केकयाश्चाप्यनुज्ञाताः कौन्तेयेनामितौजसा।\nआमन्त्र्य पाण्डवान्सर्वान्प्रययुस्तेऽपि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2018489, "chapter_id": 1384, "verse_number": "३-२२-५२", "content_sanskrit": "ब्राह्मणाश्च विशश्चैव तथाविषयवासिनः।\nविसृज्यमानाः सुभृशं न त्यजन्ति स्म पाण्डवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2018490, "chapter_id": 1384, "verse_number": "३-२२-५३", "content_sanskrit": "समवायः स राजेन्द्र सुमहाद्भुतदर्शनः।\nआसीन्महात्मनां तेषां काम्यके भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2018491, "chapter_id": 1384, "verse_number": "३-२२-५४", "content_sanskrit": "युधिष्ठिरस्तु विप्रांस्ताननुमान्य महामनाः।\nशशास पुरुषान्काले रथान्योजयतेति वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2018492, "chapter_id": 1384, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि अर्जुनाभिगमनपर्वणि द्वाविंशोऽध्यायः ॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]