[{"id": 2136454, "chapter_id": 3957, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2136455, "chapter_id": 3957, "verse_number": "१", "content_sanskrit": "प्रभूतान्नोदके तस्मिन् बहुमूलफले वने ।\nसेनां निवेश्य काकुत्स्थो विधिवत् पर्यरक्षत \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2136456, "chapter_id": 3957, "verse_number": "२", "content_sanskrit": "रावणः संविधं चक्रे लङ्कायां शास्त्रनिर्मिताम् ।\nप्रकृत्यैव दुराधर्षा दृढप्राकारतोरणा \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2136457, "chapter_id": 3957, "verse_number": "३", "content_sanskrit": "अगाधतोयाः परिखा मीननक्रसमाकुलाः ।\nबभूवुः सप्त दुर्धर्षाः खादिरैः शङ्कुभिश्चिताः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2136458, "chapter_id": 3957, "verse_number": "४", "content_sanskrit": "कर्णाट्टयन्त्रैदुर्धर्षा बभूवुः सगुलोपलाः ।\nसाशीविषघटायोधाः ससर्जरसपांसवः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2136459, "chapter_id": 3957, "verse_number": "५", "content_sanskrit": "मुसलालातनाराचतोमरासिपरश्वधैः ।\nअन्विताश्च शतघ्नीभिः समधूच्छिष्टमुद्गराः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2136460, "chapter_id": 3957, "verse_number": "६", "content_sanskrit": "पुरद्वारेषु सर्वेषु गुल्माः स्थावरजङ्गमाः ।\nबभूवुः पत्तिबहुलाः प्रभूतगजवाजिनः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2136461, "chapter_id": 3957, "verse_number": "७", "content_sanskrit": "अङ्गदस्त्वथ लङ्काया द्वारदेशमुपागतः ।\nविदितो राक्षसेन्द्रस्य प्रविवेश गतव्यथः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2136462, "chapter_id": 3957, "verse_number": "८", "content_sanskrit": "मध्ये राक्षसकोटीनां बह्वीनां सुमहाबलः ।\nशुशुभे मेघमालाभिरादित्य इव संवृतः\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2136463, "chapter_id": 3957, "verse_number": "९", "content_sanskrit": "स समासाद्य पौलस्त्यममात्यैरभिसंवृतम् ।\nरामसन्देशमामन्त्र्य वाग्मी वक्तुं प्रचक्रमे \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2136464, "chapter_id": 3957, "verse_number": "", "content_sanskrit": "अङ्गदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2136465, "chapter_id": 3957, "verse_number": "१०", "content_sanskrit": "आह त्वां राघवो राजन् कोसलेन्द्रो महायशाः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2136466, "chapter_id": 3957, "verse_number": "", "content_sanskrit": "श्रीरामः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2136467, "chapter_id": 3957, "verse_number": "११", "content_sanskrit": "प्राप्तकालमिदं वाक्यं तदादत्स्व कुरुष्व च \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2136468, "chapter_id": 3957, "verse_number": "१२", "content_sanskrit": "अकृतात्मानमासाद्य राजानमनये रतम् ।\nविनश्यन्त्यनयाविष्टा देशाश्च नगराणि च \t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2136469, "chapter_id": 3957, "verse_number": "१३", "content_sanskrit": "त्वयैकेनापराद्धं मे सीतामाहरता बलात् ।\nवधायानपराद्धानामन्येषां तद् भविष्यति \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2136470, "chapter_id": 3957, "verse_number": "१४", "content_sanskrit": "ये त्वया बलदर्पाभ्यामाविष्टेन वनेचराः ।\nऋषयो हिंसिताः पूर्वं देवाश्चाप्यवमानिताः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2136471, "chapter_id": 3957, "verse_number": "१५", "content_sanskrit": "राजर्षयश्च निहता रुदत्यश्च हृताः स्त्रियः ।\nतदिदं समनुप्राप्तं फलं तस्यानयस्य ते \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2136472, "chapter_id": 3957, "verse_number": "१६", "content_sanskrit": "हन्तास्मि त्वां सहामात्यैर्युध्यस्व पुरुषो भव ।\nपश्य मे धनुषो वीर्यं मानुषस्य निशाचर \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2136473, "chapter_id": 3957, "verse_number": "१७", "content_sanskrit": "मुच्यतां जानकी सीता न मे मोक्ष्यसि कर्हिचित् ।\nअराक्षसमिमं लोकं कर्तास्मि निशितैः शरैः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2136474, "chapter_id": 3957, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2136475, "chapter_id": 3957, "verse_number": "समाप्तिः", "content_sanskrit": "इति तस्य ब्रुवाणस्य दूतस्य परुषं वचः ।\nश्रुत्वा न ममृषे राजा रावणः क्रोधमूर्च्छितः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2136476, "chapter_id": 3957, "verse_number": "१९", "content_sanskrit": "इङ्गितज्ञास्ततो भर्तुश्चत्वारो रजनीचराः ।\nचतुर्ष्वङ्गेषु जगृहुः शार्दूलमिव पक्षिणः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2136477, "chapter_id": 3957, "verse_number": "२०", "content_sanskrit": "तांस्तथाङ्गेषु संसक्तानङ्गदो रजनीचरान् ।\nआदायैव खमुत्पत्य प्रासादतळमाविशत् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2136478, "chapter_id": 3957, "verse_number": "२१", "content_sanskrit": "वेगेनोत्पततस्तस्य पेतुस्ते रजनीचराः ।\nभुवि सम्भिन्नहृदयाः प्रहारवरपीडिताः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2136479, "chapter_id": 3957, "verse_number": "२२", "content_sanskrit": "संसक्तो हर्म्यशिखरात् तस्मात् पुनरवापतत् ।\nलङ्घयित्वा पुरीं लङ्कां स्वब(सुवे)लस्य समीपतः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2136480, "chapter_id": 3957, "verse_number": "२३", "content_sanskrit": "कोसलेन्द्रमथागम्य सर्वमावेद्य वानरः ।\nविश्राम स तेजस्वी राघवेणाभिनन्दितः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2136481, "chapter_id": 3957, "verse_number": "२४", "content_sanskrit": "ततः सर्वाभिसारेण हरीणां वातरंहसाम् ।\nभेदयामास लङ्कायाः प्राकारं रघुनन्दनः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2136482, "chapter_id": 3957, "verse_number": "२५", "content_sanskrit": "विभीषणर्क्षाधिपती पुरस्कृत्याथ लक्ष्मणः ।\nदक्षिणं नगरद्वारमवामृद्नाद् दुरासदम् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2136483, "chapter_id": 3957, "verse_number": "२६", "content_sanskrit": "करभारुणगात्राणां(पाण्डूनां) हरीणां युद्धशालिनाम् ।\nकोटीशतसहस्रेण लङ्कामभ्यपपत् तदा \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2136484, "chapter_id": 3957, "verse_number": "२७", "content_sanskrit": "प्रलम्बबाहूरुकरजङ्घान्तरविलम्बिनाम् ।\nऋक्षाणां धूम्रवर्णानां तिस्रः कोट्यो व्यवस्थिताः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2136485, "chapter_id": 3957, "verse_number": "२८", "content_sanskrit": "उत्पतद्भिः पतद्भिश्च निपतद्भिश्च वानरैः ।\nनादृश्यत तदा सूर्यो रजसा नाशितप्रभः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2136486, "chapter_id": 3957, "verse_number": "२९", "content_sanskrit": "शालिप्रसूनसदृशैः शिरीषकुसुमप्रभैः ।\nतरुणादित्यसदृशैः शणगौरैश्च वानरैः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2136487, "chapter_id": 3957, "verse_number": "३०", "content_sanskrit": "प्राकारं ददृशुस्ते तु समन्तात् कपिलीकृतम् ।\nराक्षसा विस्मिता राजन् सस्त्रीवृद्धाः समन्ततः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2136488, "chapter_id": 3957, "verse_number": "३१", "content_sanskrit": "बिभिदुस्ते मणिस्तम्भान् कर्णाट्टशिखराणि च ।\nभग्नोन्मथितशृङ्गाणि यन्त्राणि च विचिक्षिपुः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2136489, "chapter_id": 3957, "verse_number": "३२", "content_sanskrit": "परिगृह्य शतघ्नीश्च सचक्राः सहुडोपलाः ।\nचिक्षिपुर्भुजवेगेन लङ्कामध्ये महास्वनाः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2136490, "chapter_id": 3957, "verse_number": "३३", "content_sanskrit": "प्राकारस्थाश्च ये केचिन्निशाचरगणास्तथा ।\nप्रदुद्रुवुस्ते शतशः कपिभिः समभिद्रुताः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2136491, "chapter_id": 3957, "verse_number": "३४", "content_sanskrit": "ततस्तु राजवचनाद् राक्षसाः कामरूपिणः ।\nनिर्ययुर्विकृताकाराः सहस्रशतसङ्घशः \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2136492, "chapter_id": 3957, "verse_number": "३५", "content_sanskrit": "शस्त्रवर्षाणि वर्षन्तो द्रावयित्वा वनौकसः ।\nप्राकारं शोभयन्तस्ते परं विक्रममास्थिताः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2136493, "chapter_id": 3957, "verse_number": "३६", "content_sanskrit": "स माषराशिसदृशैर्बभूव क्षणदाचरैः।\nकृतो निर्वानरो भूयः प्राकारो भीमदर्शनैः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2136494, "chapter_id": 3957, "verse_number": "३७", "content_sanskrit": "पेतुः शूलविभिन्नाङ्गा बहवो वानरर्षभाः ।\nस्तम्भतोरणभग्नाश्च पेतुस्तत्र निशाचराः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2136495, "chapter_id": 3957, "verse_number": "३८", "content_sanskrit": "केशाकेश्यभवद् युद्धं रक्षसां वानरैः सह ।\nनखैर्दन्तैश्च वीराणां खादतां वै परस्परम् \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2136496, "chapter_id": 3957, "verse_number": "३९", "content_sanskrit": "निष्टनन्तो ह्युभयतस्तत्र वानरराक्षसाः ।\nहता निपतिता भूमौ न मुञ्चन्ति परस्परम् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2136497, "chapter_id": 3957, "verse_number": "४०", "content_sanskrit": "रामस्तु शरजालानि ववर्ष जलदो यथा ।\nतानि लङ्कां समासाद्य जघ्नुस्तान् रजनीचरान् \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2136498, "chapter_id": 3957, "verse_number": "४१", "content_sanskrit": "सौमित्रिरपि नाराचैर्दृढधन्वा जितक्लमः ।\nआदिश्यादिश्य दुर्गस्थान् पातयामास राक्षसान् \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2136499, "chapter_id": 3957, "verse_number": "४२", "content_sanskrit": "ततः प्रत्यवहारोऽभूत् सैन्यानां राघवाज्ञया ।\nकृते विमर्दे लङ्कायां लब्धलक्ष्यो जयोत्तरः \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2136500, "chapter_id": 3957, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि त्रिसप्तत्यधिकद्विशततमोऽध्यायः ॥२७३॥\nरामोपाख्यानपर्वणि लङ्काप्रवेशे त्रयोदशोऽध्यायः ॥१३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]