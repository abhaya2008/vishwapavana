[{"id": 7000508000, "chapter_id": 20508, "verse_number": "३-५५-१", "content_sanskrit": "व्यास उवाच ।\nन हिंस्यात्सर्वभूतानि नानृतं वावदेत्क्वचित् ।\nनाहितं नाप्रिंयं वाच्यं न स्तेनः स्यात्कदाचन॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000508001, "chapter_id": 20508, "verse_number": "३-५५-२", "content_sanskrit": "तृणं वा यदि वा शाकं मृदं वा जलमेव च ।\nपरस्यापहरञ्जंतुर्नरकं प्रतिपद्यते॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000508002, "chapter_id": 20508, "verse_number": "३-५५-३", "content_sanskrit": "न राज्ञः प्रतिगृह्णीयान्न शूद्रात्पतितादपि ।\nन चान्यस्मादशक्तश्चेन्निंदितान्वर्जयेद्बुधः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000508003, "chapter_id": 20508, "verse_number": "३-५५-४", "content_sanskrit": "नित्यं याचनको न स्यात्पुनस्तं नैव याचयेत् ।\nप्राणानपहरत्येवं याचकस्तस्य दुर्मतेः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000508004, "chapter_id": 20508, "verse_number": "३-५५-५", "content_sanskrit": "न देवद्रव्यहारी स्याद्विशेषेण द्विजोत्तमः ।\nब्रह्मस्वं वा नापहरेदापत्स्वपि कदाचन॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000508005, "chapter_id": 20508, "verse_number": "३-५५-६", "content_sanskrit": "न विषं विषमित्याहुर्ब्रह्मस्वं विषमुच्यते ।\nदेवस्वं चापि यत्नेन सदा परिहरेत्ततः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000508006, "chapter_id": 20508, "verse_number": "३-५५-७", "content_sanskrit": "पुष्पं शाकोदकं काष्ठं तथा मूलं फलं तृणम् ।\nअदत्तानि च न स्तेयं मनुः प्राह प्रजापतिः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000508007, "chapter_id": 20508, "verse_number": "३-५५-८", "content_sanskrit": "गृहीतव्यानि पुष्पाणि देवार्चनविधौ द्विजः ।\nनैकस्मादेव नियतमननुज्ञाय केवलम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000508008, "chapter_id": 20508, "verse_number": "३-५५-९", "content_sanskrit": "तृणं काष्ठं फलं पुष्पं प्रकाशं वै हरेद्बुधः ।\nधर्मार्थं केवलं प्राहुरन्यथा पतितो भवेत्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000508009, "chapter_id": 20508, "verse_number": "३-५५-१०", "content_sanskrit": "तिलमुद्गयवादीनां मुष्टिर्ग्राह्या पथिस्थितैः ।\nक्षुधितैर्नान्यथा विप्रा धर्मादिभिरिति स्थितिः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000508010, "chapter_id": 20508, "verse_number": "३-५५-११", "content_sanskrit": "न धर्मस्यापदेशेन पापं कृत्वा व्रतं चरेत् ।\nव्रतेन पापं व्यागुह्य कुर्वन्स्त्रीशूद्र दंभनम्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000508011, "chapter_id": 20508, "verse_number": "३-५५-१२", "content_sanskrit": "प्रेत्येह चेदृशो विप्रो गर्ह्यते ब्रह्मवादिभिः ।\nछद्मनाचरितं यच्च व्रतं रक्षांसि गच्छति॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000508012, "chapter_id": 20508, "verse_number": "३-५५-१३", "content_sanskrit": "अलिंगी लिंगिवेषेण यो वृत्तिमुपतिष्ठति ।\nसलिगिंनो हरेदेनस्तिर्यग्योनौ च जायते॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000508013, "chapter_id": 20508, "verse_number": "३-५५-१४", "content_sanskrit": "याचनं योनिसंबंधं सहवासं च भाषणम् ।\nकुर्वाणः पतते नित्यं तस्माद्यत्नेन वर्जयेत्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000508014, "chapter_id": 20508, "verse_number": "३-५५-१५", "content_sanskrit": "देवद्रोहं न कुर्वीत गुरुद्रोहं तथैव च ।\nदेवद्रोहाद्गुरुद्रोहः कोटिकोटिगुणाधिकः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000508015, "chapter_id": 20508, "verse_number": "३-५५-१६", "content_sanskrit": "जनापवादो नास्तिक्यं तस्मात्कोटिगुणाधिकम् ।\nगोभिश्च दैवतैर्विप्रैः कृष्या राजोपसेवया॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000508016, "chapter_id": 20508, "verse_number": "३-५५-१७", "content_sanskrit": "कुलान्यकुलतां यांति यानि हीनानि धर्म्मतः ।\nकुविचारैः क्रियालोपैर्वेदानध्ययनेन च॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000508017, "chapter_id": 20508, "verse_number": "३-५५-१८", "content_sanskrit": "कुलान्यकुलतां यांति ब्राह्मणाऽतिक्रमेण च ।\nअनृतात्पारदार्याच्च तथाऽभक्ष्यस्य भक्षणात्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000508018, "chapter_id": 20508, "verse_number": "३-५५-१९", "content_sanskrit": "अगोत्रधर्म्माचरणात्क्षिप्रं नश्यति वै कुलम् ।\nअश्रोत्रियेषु दानाच्चा वृषलेषु तथैव च॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000508019, "chapter_id": 20508, "verse_number": "३-५५-२०", "content_sanskrit": "विहिताचारहीनेषु क्षिप्रं नश्यति वै कुलम् ।\nअधार्मिकैर्वृते ग्रामे न व्याधिबहुले वसेत्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000508020, "chapter_id": 20508, "verse_number": "३-५५-२१", "content_sanskrit": "शूद्रराज्ये च न वसेन्न पाखंडजनैर्वृते ।\nहिमवद्विंध्ययोर्मध्यं पूर्वपश्चिमयोः शुभम्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000508021, "chapter_id": 20508, "verse_number": "३-५५-२२", "content_sanskrit": "मुक्त्वा समुद्रयोर्देशं नान्यत्र निवसेद्द्विजः ।\nकृष्णो वा यत्र चरति मृगो नित्यं स्वभावतः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000508022, "chapter_id": 20508, "verse_number": "३-५५-२३", "content_sanskrit": "पुण्या वा विश्रुता नद्यस्तत्र वा निवसेद्द्विजः ।\nअर्द्धकोशं नदीकूलं वर्जयित्वा द्विजोत्तमः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000508023, "chapter_id": 20508, "verse_number": "३-५५-२४", "content_sanskrit": "नान्यत्र निवसेत्पुण्यं नांत्यजग्रामसन्निधौ ।\nन संवसेच्च पतितैर्न चांडालैर्न पुल्कसैः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000508024, "chapter_id": 20508, "verse_number": "३-५५-२५", "content_sanskrit": "न मूर्खैर्नावलिप्तैश्च नान्यैर्जायावसायिभिः ।\nएकशय्यासने पंक्तिर्भांडे पक्वान्नमिश्रणम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000508025, "chapter_id": 20508, "verse_number": "३-५५-२६", "content_sanskrit": "यजनाध्यापने योनिस्तथैव सहभोजनम् ।\nसहाध्यायस्तु दशमः सहयाजनमेव च॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000508026, "chapter_id": 20508, "verse_number": "३-५५-२७", "content_sanskrit": "एकादश समुद्दिष्टा दोषाः सांकर्यसंस्थिताः ।\nसमीपे चाप्यवस्थानात्पापं संक्रमते नृणाम्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000508027, "chapter_id": 20508, "verse_number": "३-५५-२८", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन सांकर्य्यं परिवर्जयेत् ।\nएकपंक्त्युपविष्टा ये न स्पृशंति परस्परम्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000508028, "chapter_id": 20508, "verse_number": "३-५५-२९", "content_sanskrit": "भस्मना कृतमर्य्यादा न तेषां संकरो भवेत् ।\nअग्निना भस्मना चैव सलिलेन विलेखतः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000508029, "chapter_id": 20508, "verse_number": "३-५५-३०", "content_sanskrit": "द्वारेण स्तंभमार्गेण षड्भिः पंक्तिर्विभिद्यते ।\nन कुर्याच्छुष्कवैराणि विवादं न च पैशुनम्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000508030, "chapter_id": 20508, "verse_number": "३-५५-३१", "content_sanskrit": "परक्षेत्रे गां चरंतीं न चाचक्षीत कर्हिचित् ।\nन संवसेत्सूचकेन न कं वै मर्मणि स्पृशेत्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000508031, "chapter_id": 20508, "verse_number": "३-५५-३२", "content_sanskrit": "न सूर्यपरिवेषं वा नेंद्रचापं पराह्निकम् ।\nपरस्मै कथयेद्विद्वान्शशिनं वाथ कांचनम्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000508032, "chapter_id": 20508, "verse_number": "३-५५-३३", "content_sanskrit": "न कुर्याद्बहुभिः सार्द्धं विरोधं बंधुभिस्तथा ।\nआत्मनः प्रतिकूलानि परेषां न समाचरेत्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000508033, "chapter_id": 20508, "verse_number": "३-५५-३४", "content_sanskrit": "तिथिं पक्षस्य न ब्रूयान्नक्षत्राणि न निर्दिशेत् ।\nनोदक्यामभिभाषेत नाशुचिं वा द्विजोत्तमः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000508034, "chapter_id": 20508, "verse_number": "३-५५-३५", "content_sanskrit": "न देवगुरुविप्राणां दीयमानं तु वारयेत् ।\nन चात्मानं प्रशंसेद्वा परनिंदां च वर्जयेत्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000508035, "chapter_id": 20508, "verse_number": "३-५५-३६", "content_sanskrit": "वेदनिंदां देवनिंदां प्रयत्नेन विवर्जयेत् ।\nयस्तु देवानृषींश्चैव वेदान्वा निंदते द्विजः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000508036, "chapter_id": 20508, "verse_number": "३-५५-३७", "content_sanskrit": "न तस्य निष्कृतिर्दृष्टा शास्त्रेष्विह मुनीश्वराः ।\nनिंदयेद्वा गुरुं देवं वेदं वासोपबृंहणम्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000508037, "chapter_id": 20508, "verse_number": "३-५५-३८", "content_sanskrit": "कल्पकोटिशतं साग्रं रौरवे पच्यते नरः ।\nतूष्णीमासीत निंदायां न ब्रूयात्किंचिदुत्तरम्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000508038, "chapter_id": 20508, "verse_number": "३-५५-३९", "content_sanskrit": "कर्णौ पिधाय गंतव्यं न चैनमवलोकयेत् ।\nवर्ज्जयेद्वै रहस्यानि परेषां गर्हणं बुधः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000508039, "chapter_id": 20508, "verse_number": "३-५५-४०", "content_sanskrit": "विवादं स्वजनैः सार्द्धं नकुर्य्याद्वै कदाचन ।\nन पापं पापिनां ब्रूयादपापं वा द्विजोत्तमः॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000508040, "chapter_id": 20508, "verse_number": "३-५५-४१", "content_sanskrit": "सत्येन तुल्यो दोषः स्यादसत्याद्दोषवान्भवेत् ।\nनृणां मिथ्याभिशस्तानां पतंत्यश्रूणि रोदनात्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000508041, "chapter_id": 20508, "verse_number": "३-५५-४२", "content_sanskrit": "तानि पुत्रान्पशून्घ्नंति तेषां मिथ्याभिशंसिनाम् ।\nब्रह्महत्या सुरापाने स्तेये गुर्वंगनागमे॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000508042, "chapter_id": 20508, "verse_number": "३-५५-४३", "content_sanskrit": "दृष्टं वै शोधनं वृद्धैर्नास्ति मिथ्याभिशंसने ।\nनेक्षेतोद्यंतमादित्यं शशिनं वाऽनिमित्ततः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000508043, "chapter_id": 20508, "verse_number": "३-५५-४४", "content_sanskrit": "नास्तं यांतं न वारिस्थं नोपस्पृष्टं न मध्यगम् ।\nतिरोहितं समीक्षेत नादर्शाद्यनुगामिनम्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000508044, "chapter_id": 20508, "verse_number": "३-५५-४५", "content_sanskrit": "न नग्नां स्त्रियमीक्षेत पुरुषं वा कदाचन ।\nन च मूत्रं पुरीषं वा न च संसृष्टमैथुनम्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000508045, "chapter_id": 20508, "verse_number": "३-५५-४६", "content_sanskrit": "नाशुचिः सूर्यसोमादीन्ग्रहानालोकयेद्बुधः ।\nनाभिभाषेत च परमुच्छिष्टो वावगुंठितः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000508046, "chapter_id": 20508, "verse_number": "३-५५-४७", "content_sanskrit": "न पश्येत्प्रेतसंस्पर्शं न क्रुद्धस्य गुरोर्मुखम् ।\nन तैलोदकयोश्छायां न पंक्तिं भोजने सति॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000508047, "chapter_id": 20508, "verse_number": "३-५५-४८", "content_sanskrit": "न मुक्तबंधनं पश्येन्नोन्मत्तं गजमेव वा ।\nनाश्नीयाद्भार्यया सार्द्धं नैनामीक्षेत चाश्नतीम्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000508048, "chapter_id": 20508, "verse_number": "३-५५-४९", "content_sanskrit": "क्षुवतीं जृंभमाणां वा नासनस्थां यथासुखम् ।\nनोदके चात्मनो रूपं शुभं वाशुभमेव वा॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000508049, "chapter_id": 20508, "verse_number": "३-५५-५०", "content_sanskrit": "न लंघयेच्च मतिमान्नाधितिष्ठेत्कदाचन ।\nन शूद्राय मतिं दद्यात्कृसरं पायसं दधि॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000508050, "chapter_id": 20508, "verse_number": "३-५५-५१", "content_sanskrit": "नोच्छिष्टं वा मधु घृतं न च कृष्णाजिनं हविः ।\nन चैवास्मै व्रतं ब्रूयान्न च धर्मं वदेद्बुधः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000508051, "chapter_id": 20508, "verse_number": "३-५५-५२", "content_sanskrit": "न च क्रोधवशं गच्छेद्द्वेषं रागं च वर्जयेत् ।\nलोभं दंभं तथा शाठ्यं ह्यसूयां ज्ञानकुत्सनम्॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000508052, "chapter_id": 20508, "verse_number": "३-५५-५३", "content_sanskrit": "ईर्ष्यां मदं तथाशोकं मोहं च परिवर्जयेत् ।\nन कुर्यात्कस्यचित्पीडां सुतं शिष्यं तु ताडयेत्॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000508053, "chapter_id": 20508, "verse_number": "३-५५-५४", "content_sanskrit": "न हीनानुपसेवेत न च तृष्णामतिः क्वचित् ।\nनात्मानं चावमन्येत दैन्यं यत्नेन वर्जयेत्॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000508054, "chapter_id": 20508, "verse_number": "३-५५-५५", "content_sanskrit": "न विशिष्टमसत्कुर्यान्नात्मानं वासनाद्बुधः ।\nन नखेन लिखेद्भूमिं गां च संवेशयन्नहि॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000508055, "chapter_id": 20508, "verse_number": "३-५५-५६", "content_sanskrit": "न नदीषु नदीं ब्रूयात्पर्वतेषु च पर्वतान् ।\nआवासे भोजने वापि न त्यजेत्सहयायिनम्॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000508056, "chapter_id": 20508, "verse_number": "३-५५-५७", "content_sanskrit": "नावगाहेदपो नग्नो वह्निं नातिव्रजेत्तथा ।\nशिरोभ्यंगावशिष्टेन तैलेनांगं न लेपयेत्॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000508057, "chapter_id": 20508, "verse_number": "३-५५-५८", "content_sanskrit": "न सर्प शस्त्रैः क्रीडेत स्वानि खानि न संस्पृशेत् ।\nरोमाणि च रहस्यानि नाशिष्टेन सह व्रजेत्॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000508058, "chapter_id": 20508, "verse_number": "३-५५-५९", "content_sanskrit": "न पाणि पाद वाङ्नेत्र चापल्यं समुपाश्रयेत् ।\nन शिश्नोदरचापल्यं न च श्रवणयोः क्वचित्॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000508059, "chapter_id": 20508, "verse_number": "३-५५-६०", "content_sanskrit": "न चांगनखवाद्यं वै कुर्यान्नांजलिना पिबेत् ।\nनाभिहन्याज्जलं पद्भ्यां पाणिना वा कदाचन॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000508060, "chapter_id": 20508, "verse_number": "३-५५-६१", "content_sanskrit": "न शातयेदिष्टिकाभिर्मूलानि च फलानि च ।\nन म्लेच्छभाषणं शिक्षेन्नाकर्षेच्च पदासनम्॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000508061, "chapter_id": 20508, "verse_number": "३-५५-६२", "content_sanskrit": "नखभेदनमास्फोटं छेदनं वा विलेखनम् ।\nकुर्य्याद्विमर्द्दनं धीमान्नाकस्मादेव निष्फलम्॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000508062, "chapter_id": 20508, "verse_number": "३-५५-६३", "content_sanskrit": "नोत्संगे भक्षयेद्भक्ष्यं वृथा चेष्टां न चाचरेत् ।\nन नृत्येदथवा गायेन्न वादित्राणि वादयेत्॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000508063, "chapter_id": 20508, "verse_number": "३-५५-६४", "content_sanskrit": "न संहताभ्यां पाणिभ्यां कंडूयेदात्मनः शिरः ।\nन लौकिकैस्तवैर्देवांस्तोषयेद्वाक्पतेरपि॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000508064, "chapter_id": 20508, "verse_number": "३-५५-६५", "content_sanskrit": "नाक्षैः क्रीडेन्न धावेत नाप्सु विण्मूत्रमाचरेत् ।\nनोच्छिष्टः संविशेन्नित्यं न नग्नः स्नानमाचरेत्॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000508065, "chapter_id": 20508, "verse_number": "३-५५-६६", "content_sanskrit": "न गच्छंस्तु पठेद्वापि न चैव स्वशिरः स्पृशेत् ।\nन दंतैर्नखरोमाणि च्छिंद्यात्सुप्तं न बोधयेत्॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000508066, "chapter_id": 20508, "verse_number": "३-५५-६७", "content_sanskrit": "नाबालातपमासेवेत्प्रेतधूमं विवर्जयेत् ।\nनैव स्वप्याच्छून्यगेहे स्वयं नोपानहौ हरेत्॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000508067, "chapter_id": 20508, "verse_number": "३-५५-६८", "content_sanskrit": "नाकारणाद्वा निष्ठीवेन्न बाहुभ्यां नदीं तरेत् ।\nन पादक्षालनं कुर्यात्पादेनैव कदाचन॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000508068, "chapter_id": 20508, "verse_number": "३-५५-६९", "content_sanskrit": "नाग्नौ प्रतापयेत्पादौ न कांस्ये धावयेद्बुधः ।\nनाभिप्रसारयेद्देवं ब्राह्मणान्गामथापि वा॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000508069, "chapter_id": 20508, "verse_number": "३-५५-७०", "content_sanskrit": "वाय्वग्निनृपविप्रान्वा सूर्यं वा शशिनं प्रति ।\nअशुद्धः शयनं पानं स्वाध्यायं स्नान भोजनम्॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000508070, "chapter_id": 20508, "verse_number": "३-५५-७१", "content_sanskrit": "बहिर्निष्क्रमणं चैव न कुर्वीत कदाचन ।\nस्वप्नमध्ययनं स्नानमुद्वर्तं भोजनं गतिम्॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000508071, "chapter_id": 20508, "verse_number": "३-५५-७२", "content_sanskrit": "उभयोः संध्ययोर्नित्यं मध्याह्ने चैव वर्जयेत् ।\nन स्पृशेत्पाणिनोच्छिष्टो विप्रो गो ब्राह्मणानलान्॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000508072, "chapter_id": 20508, "verse_number": "३-५५-७३", "content_sanskrit": "न चालनं पदा वापि न देवप्रतिमां स्पृशेत् ।\nनाशुद्धोग्निं परिचरेन्न देवान्कीर्तयेदृषीन्॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000508073, "chapter_id": 20508, "verse_number": "३-५५-७४", "content_sanskrit": "नावगाहेदगाधांबु धावयेन्नाऽनिमित्ततः ।\nन वामहस्तेनोद्धृत्य पिबेद्वक्त्रेण वा जलम्॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000508074, "chapter_id": 20508, "verse_number": "३-५५-७५", "content_sanskrit": "नोत्तरेदनुपस्पृश्य नाप्सु रेतः समुत्सृजेत् ।\nअमेध्यालिप्तमर्हं वा लोहितं वा विषाणि वा॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000508075, "chapter_id": 20508, "verse_number": "३-५५-७६", "content_sanskrit": "व्यतिक्रामेन्न स्रवंतीं नाप्सु मैथुनमाचरेत् ।\nचैत्यवृक्षं न वै छिंद्यान्नाप्सु ष्ठीवनमाचरेत्॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000508076, "chapter_id": 20508, "verse_number": "३-५५-७७", "content_sanskrit": "नास्थिभस्मकपालानि न केशान्न च कंटकान् ।\nतुषांगारकरीषं वा नाधितिष्ठेत्कदाचन॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000508077, "chapter_id": 20508, "verse_number": "३-५५-७८", "content_sanskrit": "न चाग्निं लंघयेद्धीमान्नोपदध्यादधः क्वचित् ।\nन चैनं पादतः कुर्य्याच्छूर्पेण न धमेद्बुधः॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000508078, "chapter_id": 20508, "verse_number": "३-५५-७९", "content_sanskrit": "न वृक्षमवरोहेत नावेक्षेताशुचिः क्वचित् ।\nअग्नौ न च क्षिपेदग्निं नाद्भिः प्रशमयेत्तथा॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000508079, "chapter_id": 20508, "verse_number": "३-५५-८०", "content_sanskrit": "सुहृन्मरणमात्रं वा स्वयं न श्रावयेत्परान् ।\nअपण्यं कूटपण्यं वा विक्रयेन प्रयोजयेत्॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000508080, "chapter_id": 20508, "verse_number": "३-५५-८१", "content_sanskrit": "न वह्निं मुखनिःश्वासैर्ज्वालयेन्नाशुचिर्बुधः ।\nपुण्यस्थानोदकस्थाने सीमांतं वाहयेन्न तु॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000508081, "chapter_id": 20508, "verse_number": "३-५५-८२", "content_sanskrit": "न भिंद्यात्पूर्वसमयमभ्युपेतं कदाचन ।\nपरस्परं पशून्व्याघ्रान्पक्षिणो न च योधयेत्॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000508082, "chapter_id": 20508, "verse_number": "३-५५-८३", "content_sanskrit": "परबाधां न कुर्वीत जलवातातपादिभिः ।\nकारयित्वा सुकर्माणि गुरून्पश्चान्न वंचयेत्॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000508083, "chapter_id": 20508, "verse_number": "३-५५-८४", "content_sanskrit": "सायंप्रातर्गृहद्वारान्रक्षार्थं परिघट्टयेत् ।\nबहिर्माल्यं सुगंधिं वा भार्यया सह भोजनम्॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000508084, "chapter_id": 20508, "verse_number": "३-५५-८५", "content_sanskrit": "विगृह्य वादं कृत्वा वा प्रवेशं च विवर्जयेत् ।\nनखादन्ब्राह्मणस्तिष्ठेन्न जल्पेद्वा हसेद्बुधः॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000508085, "chapter_id": 20508, "verse_number": "३-५५-८६", "content_sanskrit": "स्वमग्निं चैव हस्तेन स्पृशेन्नाप्सुचिरं वसेत् ।\nन पक्षकेणोपधमेन्न शूर्पेण च पाणिना॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000508086, "chapter_id": 20508, "verse_number": "३-५५-८७", "content_sanskrit": "मुखेनाग्निं समिंधीत मुखादग्निरजायत ।\nपरस्त्रियं न भाषेत नायाज्यं याजयेद्बुधः॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000508087, "chapter_id": 20508, "verse_number": "३-५५-८८", "content_sanskrit": "नैकश्चरेत्सदा विप्रः समुदायं च वर्जयेत् ।\nन देवायतनं गच्छेत्कदाचिद्वाऽप्रदक्षिणम्॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000508088, "chapter_id": 20508, "verse_number": "३-५५-८९", "content_sanskrit": "न पीडयेद्वा वस्त्राणि न देवायतने स्वपेत् ।\nनैकोध्वानं प्रपद्येत नाधार्मिकजनै सह॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000508089, "chapter_id": 20508, "verse_number": "३-५५-९०", "content_sanskrit": "न व्याधिदूषितैर्वापि न शूद्रैः पतितेन वा ।\nनोपानद्वर्जितो वाथ जलादिरहितस्तथा॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000508090, "chapter_id": 20508, "verse_number": "३-५५-९१", "content_sanskrit": "न वर्त्मनि चितिं वाममतिक्रामेत्क्वचिद्द्विजः ।\nन निंदेद्योगिनः सिद्धान्व्रतिनो वा यतींस्तथा॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000508091, "chapter_id": 20508, "verse_number": "३-५५-९२", "content_sanskrit": "देवतायतनं प्राज्ञा देवानां चैव सत्रिणाम् ।\nनाक्रामेत्कामतश्छायां ब्राह्मणानां च गोरपि॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000508092, "chapter_id": 20508, "verse_number": "३-५५-९३", "content_sanskrit": "स्वां तु नाक्रामयेच्छायां पतिताद्यैर्न रोगिभिः ।\nनांगारभस्मकेशादिष्वधितिष्ठेत्कदाचन॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000508093, "chapter_id": 20508, "verse_number": "३-५५-९४", "content_sanskrit": "वर्जयेन्मार्जनी रेणुं स्नानवस्त्र घटोदकम् ।\nन भक्षयेदभक्ष्याणि नापेयं च पिबेद्द्विजः॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}]