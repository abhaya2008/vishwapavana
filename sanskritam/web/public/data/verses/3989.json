[{"id": 2137996, "chapter_id": 3989, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2137997, "chapter_id": 3989, "verse_number": "१", "content_sanskrit": "ततस्ते यक्षवचनादुदतिष्ठन्त पाण्डवाः ।\nक्षुत्पिपासे च सर्वेषां क्षणेन व्यपगच्छताम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2137998, "chapter_id": 3989, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2137999, "chapter_id": 3989, "verse_number": "२", "content_sanskrit": "सरस्येकेन पादेन तिष्ठन्तमपराजितम् ।\nपृच्छामि को भवान् देवो न मे यक्षो मतो भवान् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2138000, "chapter_id": 3989, "verse_number": "३", "content_sanskrit": "वसूनां वा भवानेको रुद्राणामथवा भवान् ।\nअथवा मरुतां श्रेष्ठो वज्री वा त्रिदशेश्वरः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2138001, "chapter_id": 3989, "verse_number": "४", "content_sanskrit": "मम हि भ्रातर इमे सहस्रशतयोधिनः ।\nतं योधं न प्रपश्यामि येन सर्वे निपातिताः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2138002, "chapter_id": 3989, "verse_number": "५", "content_sanskrit": "सुखप्रतिमबुद्धानाम् इन्द्रियाण्युपलक्षये ।\nस भवान् सुहृदोऽस्माकमथवा नः पिता भवान् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2138003, "chapter_id": 3989, "verse_number": "", "content_sanskrit": "यक्षः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2138004, "chapter_id": 3989, "verse_number": "६", "content_sanskrit": "अहं ते जनकस्तात धर्मोऽमृदुपराक्रम ।\nत्वां दिदृक्षुरनुप्राप्तो विद्धि मां भरतर्षभ \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2138005, "chapter_id": 3989, "verse_number": "७", "content_sanskrit": "यशः सत्यं दमः शौचमार्जवं ह्रीरचापलम् ।\nदानं तपो ब्रह्मचर्यमित्येतास्तनवो मम \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2138006, "chapter_id": 3989, "verse_number": "८", "content_sanskrit": "अहिंसा समता शान्तिरानृशंस्यममत्सरः ।\nद्वाराण्येतानि मे विद्धि प्रियो ह्यसि सदा मम \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2138007, "chapter_id": 3989, "verse_number": "९", "content_sanskrit": "दिष्ट्या पञ्चसु रक्तोऽसि दिष्ट्या ते षट् सदा जिता ।\nद्वे पूर्वे मध्यमे द्वे च द्वे चान्तेऽसाम्परायके \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2138008, "chapter_id": 3989, "verse_number": "१०", "content_sanskrit": "धर्मोऽहमिति भद्रं ते जिज्ञासुस्त्वामिहागतः ।\nआनृशंस्येन तुष्टोऽस्मि वरं दास्यामि तेऽनघ \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2138009, "chapter_id": 3989, "verse_number": "११", "content_sanskrit": "(कामक्रोधौ तु प्रथमौ लोभमोहौ तु मध्यमौ ।\nअन्ते भयविषादौ च एषा सा षट्पदी स्मृता ॥) ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2138010, "chapter_id": 3989, "verse_number": "१२", "content_sanskrit": "वरं वृणीष्व राजेन्द्र दाता ह्यस्मि तवानघ ।\nये हि मे पुरुषा भक्ता न तेषामस्ति दुर्गतिः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2138011, "chapter_id": 3989, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2138012, "chapter_id": 3989, "verse_number": "१३", "content_sanskrit": "अरणीसहितं यस्य मृगो ह्यादाय गच्छति ।\nतस्याग्नयो न लुप्येरन्प्रथमोऽस्तु वरो मम \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2138013, "chapter_id": 3989, "verse_number": "", "content_sanskrit": "यक्षः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2138014, "chapter_id": 3989, "verse_number": "१४", "content_sanskrit": "अरणीसहितं ह्यस्य ब्राह्मणस्य हृतं मया ।\nमृगवेषेण कौन्तेय जिज्ञासार्थं तव प्रभो \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2138015, "chapter_id": 3989, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2138016, "chapter_id": 3989, "verse_number": "१५", "content_sanskrit": "ददानीत्येव भगवानुत्तरं प्रत्यपद्यत ।\nअन्यं वरय भद्रं ते वरं त्वममरोपमम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2138017, "chapter_id": 3989, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2138018, "chapter_id": 3989, "verse_number": "१६", "content_sanskrit": "वर्षाणि द्वादशारण्ये त्रयोदशमुपस्थितम् ।\nतत्र नो नाभिजानीयुर्वसतो मनुजाः क्वचित् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2138019, "chapter_id": 3989, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2138020, "chapter_id": 3989, "verse_number": "१७", "content_sanskrit": "ददानीत्येव भगवानुत्तरं प्रत्यपद्यत ।\nभूयश्चाश्वासयामास कौन्तेयं सत्यविक्रमम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2138021, "chapter_id": 3989, "verse_number": "", "content_sanskrit": "यक्षः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2138022, "chapter_id": 3989, "verse_number": "१८", "content_sanskrit": "यद्यपि स्वेन रूपेण चरिष्यथ महीमिमाम् ।\nन वो विज्ञास्यते कश्चित्त्रिषु लोकेषु भारत \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2138023, "chapter_id": 3989, "verse_number": "१९", "content_sanskrit": "वर्षं त्रयोदशमिदं मत्प्रसादात् कुरूद्वहाः ।\nविराटनगरे गूढा अविज्ञाताश्चरिष्यथ \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2138024, "chapter_id": 3989, "verse_number": "२०", "content_sanskrit": "यद्वः सङ्कल्पितं रूपं मनसा यस्य यादृशम् ।\nतादृशं तादृशं सर्वे छन्दतो धारयिष्यथ \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2138025, "chapter_id": 3989, "verse_number": "२१", "content_sanskrit": "अरणीसहितं चेदं ब्राह्मणाय प्रयच्छत ।\nजिज्ञासार्थं मया ह्येतदाहृतं मृगरूपिणा \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2138026, "chapter_id": 3989, "verse_number": "२२", "content_sanskrit": "प्रवृणीष्वापरं सौम्य वरमिष्टं ददानि ते ।\nन तृप्यामि नरश्रेष्ठ प्रयच्छन् वै वरांस्तथा \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2138027, "chapter_id": 3989, "verse_number": "२३", "content_sanskrit": "तृतीयं गृह्यतां पुत्र वरमप्रतिमं महत् ।\nत्वं हि मत्प्रभवो राजन् विदुरश्च ममांशजः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2138028, "chapter_id": 3989, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2138029, "chapter_id": 3989, "verse_number": "२४", "content_sanskrit": "देवदेवो मया दृष्टो भवान् साक्षात् सनातनः ।\nयं ददासि वरं तुष्टस्तं ग्रहीष्याम्यहं पितः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2138030, "chapter_id": 3989, "verse_number": "२५", "content_sanskrit": "जयेयं लोभमोहौ च क्रोधं चाहं सदा विभो ।\nदाने तपसि सत्ये च मनो मे सततं भवेत् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2138031, "chapter_id": 3989, "verse_number": "", "content_sanskrit": "धर्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2138032, "chapter_id": 3989, "verse_number": "२६", "content_sanskrit": "उपपन्नो गुणैरेतैः स्वभावेनापि पाण्डव ।\nभवान् धर्मः पुनश्चैव यथोक्तं ते भविष्यति \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2138033, "chapter_id": 3989, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2138034, "chapter_id": 3989, "verse_number": "२७", "content_sanskrit": "इत्युक्त्वान्तर्दधे धर्मो भगवाँल्लोकभावनः ।\nसमेताः पाण्डवाश्चैव सुखं प्राप्ता मनस्विनः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2138035, "chapter_id": 3989, "verse_number": "२८", "content_sanskrit": "उपेत्य चाश्रमं वीराः सर्व एव गतक्लमाः ।\nआरणेयं ददुस्तस्मै ब्राह्मणाय तपस्विने \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2138036, "chapter_id": 3989, "verse_number": "२९", "content_sanskrit": "इदं समुत्थानसमागतं महत्\nपितुश्च पुत्रस्य च कीर्तिवर्धनम् ।\nपठन् नरः स्याद् विजितेन्द्रियो धनी\nसपुत्रपौत्रः शतवर्षभाग्भवेत् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2138037, "chapter_id": 3989, "verse_number": "३०", "content_sanskrit": "न चाप्यधर्मे न सुहृद् विभेदने\nपरस्वहारे परदारमर्शने ।\nकदर्यभावे न रमेन्मनः सदा\nनृणां सदाख्यानमिदं विजानताम् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2138038, "chapter_id": 3989, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि त्र्यधिकत्रिशततमोऽध्यायः ॥३०३॥\nआरणेयपर्वणि नकुलादिजीवनादिवरप्राप्तौ चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]