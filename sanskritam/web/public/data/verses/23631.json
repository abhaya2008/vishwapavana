[{"id": 7003631000, "chapter_id": 23631, "verse_number": "१-२-१८-१", "content_sanskrit": "नारद उवाच ।\nधनाधिपस्य जंभेन सायकैर्मर्मभेदिभिः ।\nदिशोपरुद्धाः क्रुद्धेन सैन्यं चाभ्यर्दितं भृशम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003631001, "chapter_id": 23631, "verse_number": "१-२-१८-२", "content_sanskrit": "तद्दृष्ट्वा कर्म दैत्यस्य धनाध्यक्षः प्रतापवान् ।\nआकर्णाकृष्टचापस्तु जंभमाजौ महाबलम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003631002, "chapter_id": 23631, "verse_number": "१-२-१८-३", "content_sanskrit": "हृदि विव्याध बाणानां सहस्रेणाग्निवर्चसाम् ।\nस प्रहस्य ततो वीरो बाणानामयुतत्रयम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003631003, "chapter_id": 23631, "verse_number": "१-२-१८-४", "content_sanskrit": "नियुतं च तथा कोटिमर्बुदं चाक्षिपत्क्षणात् ।\nतस्य तल्लाघ्रवं दृषट्वा क्रुद्धो गृह्य महागदाम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003631004, "chapter_id": 23631, "verse_number": "१-२-१८-५", "content_sanskrit": "धनाध्यक्षः प्रचिक्षेप स्वर्गेप्सुः स्वधनं यथा ।\nमुक्तायां वै नादोऽभूत्प्रलये यथा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003631005, "chapter_id": 23631, "verse_number": "१-२-१८-६", "content_sanskrit": "भूतानां बहुधा रावा जज्ञिरे खे महाभयाः ।\nवायुश्च सुमहाञ्जज्ञे खमायान्मेघसंकुलम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003631006, "chapter_id": 23631, "verse_number": "१-२-१८-७", "content_sanskrit": "सा हि वैश्रवणस्यास्ते त्रैलोक्याभ्यर्चिता गदा ।\nआयांतीं तां समालोक्य तडित्संघातदुर्द्दशाम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003631007, "chapter_id": 23631, "verse_number": "१-२-१८-८", "content_sanskrit": "दैत्यो गदाविघातार्थं शस्त्रवृष्टिं मुमोच ह ।\nचक्राणि कुणपान्प्रासाञ्छतघ्नीः पट्टिशांस्तथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003631008, "chapter_id": 23631, "verse_number": "१-२-१८-९", "content_sanskrit": "परिघान्मुशलान्वृक्षान्गिरींश्चातुलविक्रमः ।\nकदर्थीकृत्य शस्त्राणि तानि सर्वाणि सा गदा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003631009, "chapter_id": 23631, "verse_number": "१-२-१८-१०", "content_sanskrit": "कल्पांतभास्करो यद्वन्न्यपतद्दैत्यवक्षसि ।\nस तया गाढभिन्नः सन्सफेनरुधिरं वमन् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003631010, "chapter_id": 23631, "verse_number": "१-२-१८-११", "content_sanskrit": "निःपपात रथाज्जंभो वसुधां गतचेतनः ।\nजंभं निपतितं दृष्ट्वा कुजंभो घोरनिश्चयः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003631011, "chapter_id": 23631, "verse_number": "१-२-१८-१२", "content_sanskrit": "धनाधिपस्य संक्रुद्धो नादेनापूरयन्दिशः ।\nचक्रे बाणमयं जालं शकुंतस्येव पंजरम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003631012, "chapter_id": 23631, "verse_number": "१-२-१८-१३", "content_sanskrit": "विच्छिद्य बाणजालं च मायाजालमिवोत्कटम् ।\nमुमोच बाणानपरांस्तस्य यक्षाधिपो बली ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003631013, "chapter_id": 23631, "verse_number": "१-२-१८-१४", "content_sanskrit": "चिच्छेद लीलया तांश्च दैत्यः क्रोधीव सद्वचः ।\nनिष्फलांस्तांस्ततो दृष्ट्वा बाणान्क्रुद्धो धनाधिपः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003631014, "chapter_id": 23631, "verse_number": "१-२-१८-१५", "content_sanskrit": "शक्तिं जग्राह दुर्धर्षां शतघंटामहास्वनाम् ।\nप्रेषिता सा तदा शक्तिर्दारयामास तं हृति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003631015, "chapter_id": 23631, "verse_number": "१-२-१८-१६", "content_sanskrit": "यथाल्पबोधं पुरुषं दुःखं संसारसंभवम् ।\nतथास्य हृदयं भित्त्वा जगाम धरणीतलम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003631016, "chapter_id": 23631, "verse_number": "१-२-१८-१७", "content_sanskrit": "निमेषात्सोभिसंस्तम्भ्य दानवो दारुणाकृतिः ।\nजग्राह पट्टिशं दैत्यो गिरीणामपि भेदनम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003631017, "chapter_id": 23631, "verse_number": "१-२-१८-१८", "content_sanskrit": "स तेन पट्टिसेनाजौ धनदस्य स्तनांतरम् ।\nवाक्येन तीक्ष्णरूपेण मर्माक्षरविसर्पिणा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003631018, "chapter_id": 23631, "verse_number": "१-२-१८-१९", "content_sanskrit": "निर्बिभेदाभिजातस्य हृदयं दुर्जनो यथा ।\nतेन पट्टिश घातेन धनेशः ।\nपरिमूर्छितः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003631019, "chapter_id": 23631, "verse_number": "१-२-१८-२०", "content_sanskrit": "निषसाद रथोपस्थे दुर्वाचा सुजनो यथा ।\nतथागतं तु तं दृष्ट्वा धनेशं वै मृतं यथा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003631020, "chapter_id": 23631, "verse_number": "१-२-१८-२१", "content_sanskrit": "राक्षसो निरृतिर्देवो निशाचरबलानुगः ।\nअभिदुद्राव वेगेन कुजंभं भीमविक्रमम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003631021, "chapter_id": 23631, "verse_number": "१-२-१८-२२", "content_sanskrit": "अथ दृष्ट्वातिदुर्धर्षं कुजंभो राक्षसेश्वरम् ।\nनोदयामास दैत्यान्स राक्षसेशरथं प्रति ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003631022, "chapter_id": 23631, "verse_number": "१-२-१८-२३", "content_sanskrit": "स दृष्ट्वा नोदितां सेनां प्रबलास्त्रां सुभीषणाम् ।\nरथादाप्लुत्य वेगेन निरृती राक्षसेश्वरम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003631023, "chapter_id": 23631, "verse_number": "१-२-१८-२४", "content_sanskrit": "खड्गेन तीक्ष्णधारेण चर्मपाणिरधावत ।\nप्रविश्य दानवानीकं गजः पद्मसरो यथा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003631024, "chapter_id": 23631, "verse_number": "१-२-१८-२५", "content_sanskrit": "लोडयामास बहुधा विनिष्कृत्य सहस्रशः ।\nचिच्छेद कांश्चिच्छतशो बिभेदान्यान्वरासिना ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003631025, "chapter_id": 23631, "verse_number": "१-२-१८-२६", "content_sanskrit": "संदष्टौष्ठमुखैः पृथ्वीं दैत्यानां सोऽभ्यपूरयत् ।\nततो निःशेषितप्रायां विलोक्य स्वां चमूं तदा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003631026, "chapter_id": 23631, "verse_number": "१-२-१८-२७", "content_sanskrit": "मुक्त्वा धनपतिं दैत्यः कुजंभो निरृतिं ययौ ।\nलब्धसंज्ञस्तु जंभोऽपि धनाध्यक्षपदानुगान् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003631027, "chapter_id": 23631, "verse_number": "१-२-१८-२८", "content_sanskrit": "जीवग्राहं स जग्राह बद्धा पाशैः सहस्रधा ।\nमूर्तिमंति च रत्ननि पद्मादींश्च निधींस्तथा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003631028, "chapter_id": 23631, "verse_number": "१-२-१८-२९", "content_sanskrit": "वाहनानि च दिव्यानि विमानानि च सर्वशः ।\nधनेशो लब्धसंज्ञस्तु तामवस्थां विलोक्य सः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003631029, "chapter_id": 23631, "verse_number": "१-२-१८-३०", "content_sanskrit": "निःश्वसन्दीर्घमुष्णं च रोषात्ताम्रविलोचनः ।\nध्यात्वास्त्रं गारुडं दिव्यं बाणं संधाय कार्मुके ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003631030, "chapter_id": 23631, "verse_number": "१-२-१८-३१", "content_sanskrit": "मुमोच दानवानीके तं बाणं शत्रुदारणम् ।\nप्रथमं कार्मुकं तस्य वह्निज्वालमदृश्यत ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003631031, "chapter_id": 23631, "verse_number": "१-२-१८-३२", "content_sanskrit": "निश्चेरुर्विस्फुलिंगानां कोटयो धनुषस्तथा ।\nततो ज्वालाकुलं व्योम चक्रे चास्त्रं समंततः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003631032, "chapter_id": 23631, "verse_number": "१-२-१८-३३", "content_sanskrit": "तदस्त्रं सहसा दृष्ट्वा जंभो भीमपराक्रमः ।\nसंवर्तं मुमुचे तेन प्रशांतं गारुडं तदा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003631033, "chapter_id": 23631, "verse_number": "१-२-१८-३४", "content_sanskrit": "ततस्तं दानवो दृष्ट्वा कुबेरं रोषविह्वलः ।\nअभिदुद्राव वेगेन पदातिर्धनदं नदन् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003631034, "chapter_id": 23631, "verse_number": "१-२-१८-३५", "content_sanskrit": "अथाभिमुखमायांतं दैत्यं दृष्ट्वा धनाधिपः ।\nबभूव संभ्रमाविष्टः पलायनपरायणः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003631035, "chapter_id": 23631, "verse_number": "१-२-१८-३६", "content_sanskrit": "ततः पलायतस्तस्य मुकुटो रत्नमंडितः ।\nपपात भूतले दीप्तो रविबिंबमिवांबरात् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003631036, "chapter_id": 23631, "verse_number": "१-२-१८-३७", "content_sanskrit": "यक्षणामभिजातानां भग्नं प्रववृते रणात् ।\nमर्तुं संग्राम शिरसि युक्तं नो भूषणाय तत् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003631037, "chapter_id": 23631, "verse_number": "१-२-१८-३८", "content_sanskrit": "इति व्यवस्य दुर्धर्षा नानाशस्त्रास्त्रपाणयः ।\nयुयुत्सवस्तथा यक्षा मुकुटं परिवार्य ते ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003631038, "chapter_id": 23631, "verse_number": "१-२-१८-३९", "content_sanskrit": "अभिमान धना वीरा धनस्य पदानुगाः ।\nतानमर्षाच्च संप्रेक्ष्य दानवश्चंडपौरुषः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003631039, "chapter_id": 23631, "verse_number": "१-२-१८-४०", "content_sanskrit": "भुशुण्डीं भीषणाकारां गृहीत्वा शैलगौरवाम् ।\nरक्षिणो मुकुटस्याथ निष्पिपेष निशाचरान् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003631040, "chapter_id": 23631, "verse_number": "१-२-१८-४१", "content_sanskrit": "तान्प्रमथ्याथ नियुतं मुकुटं तं स्वके रथे ।\nसमारोप्यामररिपुर्जित्वा धनदमाहवे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003631041, "chapter_id": 23631, "verse_number": "१-२-१८-४२", "content_sanskrit": "धनानि च निधीन्गृह्य स्वसैन्येन समावृतः ।\nनादेन महता देवान्द्रावयामास सर्वशः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003631042, "chapter_id": 23631, "verse_number": "१-२-१८-४३", "content_sanskrit": "धनदोऽपि धनं सर्वं गृहीतो मुक्तमूर्धजः ।\nपदातिरेकः सन्त्रस्तः प्राप्यैवं दीनवत्स्थितः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003631043, "chapter_id": 23631, "verse_number": "१-२-१८-४४", "content_sanskrit": "कुजंभेनाथ संसक्तो रजनीचरनंदनः ।\nमायाममोघामाश्रित्य तामसीं राक्षसेश्वरः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003631044, "chapter_id": 23631, "verse_number": "१-२-१८-४५", "content_sanskrit": "मोहयामास दैत्येन्द्रो जगत्कृत्वा तमोमयम् ।\nततो विफलनेत्राणि दानवानां बलानि च ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003631045, "chapter_id": 23631, "verse_number": "१-२-१८-४६", "content_sanskrit": "न शेकुश्चलितुं तत्र पदादपि पदं तदा ।\nततो नानास्त्रवर्षेण दानवानां महाचमूः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003631046, "chapter_id": 23631, "verse_number": "१-२-१८-४७", "content_sanskrit": "जघान निरृतिर्देवस्तमसा संवृता भृशम् ।\nहन्यमानेषु दैत्येषु कुजंभे मूढचेतसि ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003631047, "chapter_id": 23631, "verse_number": "१-२-१८-४८", "content_sanskrit": "महिषो दानवेन्द्रस्तु कल्पांतां भोदसन्निभः ।\nअस्त्रं चकार सावित्रमुल्कासंघातमंडितम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003631048, "chapter_id": 23631, "verse_number": "१-२-१८-४९", "content_sanskrit": "विजृंभत्यथ सावित्रे परमास्त्रे प्रातपिनि ।\nप्रणासमगमत्तीव्रं तमो घोरमनंतरम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003631049, "chapter_id": 23631, "verse_number": "१-२-१८-५०", "content_sanskrit": "ततोऽस्त्रविस्फुलिंगांकं तमः शुक्लं व्यजायत ।\nप्रोत्फुल्लारुणपद्मौघं शरदीवामलं सरः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003631050, "chapter_id": 23631, "verse_number": "१-२-१८-५१", "content_sanskrit": "ततस्तमसि संशांते दैत्येन्द्राः प्राप्तचक्षुषः ।\nचक्रुः क्रुरेण तमसा देवानीकं महाद्भुतम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003631051, "chapter_id": 23631, "verse_number": "१-२-१८-५२", "content_sanskrit": "अथादाय धनुर्घोरमिषुं चाशीविषोपमम् ।\nकुजंभोऽधावत क्षिप्रं रक्षोदेवबलं प्रति ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003631052, "chapter_id": 23631, "verse_number": "१-२-१८-५३", "content_sanskrit": "राक्षसेन्द्रस्तथायांतं दृषट्वा तं स पदानुगः ।\nविव्याध निशितैर्बाणैः कालाशनिसमस्वनैः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003631053, "chapter_id": 23631, "verse_number": "१-२-१८-५४", "content_sanskrit": "नादानं न च सन्धानं न मोक्षो वास्य लक्ष्यते ।\nचिच्छेदोग्रैः शरव्रातैस्ताञ्छरानतिलाघवात् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003631054, "chapter_id": 23631, "verse_number": "१-२-१८-५५", "content_sanskrit": "ध्वजं शरेण तीक्ष्णेन निचकर्तामरद्विषः ।\nसारथिं चास्य भल्लेन रथनीडादपाहरत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003631055, "chapter_id": 23631, "verse_number": "१-२-१८-५६", "content_sanskrit": "कालकल्पेन बाणेन तं च वक्षस्याताडयत् ।\nस तु तेन प्रहारेण चकम्पे पीडितो भृशम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003631056, "chapter_id": 23631, "verse_number": "१-२-१८-५७", "content_sanskrit": "दैत्येंद्रो राक्षसेन्द्रेण क्षितिकंपेनगो यथा ।\nस सुहूर्तात्समाश्वास्य मत्वा तं दुर्जयं रणे ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003631057, "chapter_id": 23631, "verse_number": "१-२-१८-५८", "content_sanskrit": "पदातिरासाद्य रथं रक्षो वामकरेण च ।\nकेशेषु निरृतिं गृह्य जानुनाक्रम्य च स्थितः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003631058, "chapter_id": 23631, "verse_number": "१-२-१८-५९", "content_sanskrit": "ततः खड्गेन च शिरश्छेत्तुमैच्छदमर्षणः ।\nततः कलकलो जज्ञे देवानां सुमहांस्तदा ।\nकुजंभस्य वशं प्राप्तं दृष्ट्वा निरृतिमाहवे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003631059, "chapter_id": 23631, "verse_number": "१-२-१८-६०", "content_sanskrit": "एतस्मिन्नन्तरे देवो वरुणः पाशभृद्धृतः ।\nपाशेन दानवेंद्रस्य बबन्धाशु भुजद्वयम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003631060, "chapter_id": 23631, "verse_number": "१-२-१८-६१", "content_sanskrit": "ततो बद्धभुजं दैत्यं विफलीकृतपौरुषम् ।\nताडयामास गदया दयामुत्सृज्य पाशभृत् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003631061, "chapter_id": 23631, "verse_number": "१-२-१८-६२", "content_sanskrit": "स तु तेन प्रहारेण स्रोतोभिः क्षतजं स्रवन् ।\nदधार कालमेघस्य रूपं विद्युल्लताभृतम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003631062, "chapter_id": 23631, "verse_number": "१-२-१८-६३", "content_sanskrit": "तदवस्थागतं दृष्ट्वा कुजंभं महिषासुरः ।\nव्यावृत्तवदनारावो भोक्तुमैच्छत्सुरावुभौ ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003631063, "chapter_id": 23631, "verse_number": "१-२-१८-६४", "content_sanskrit": "निरृति वरुणं चैव तीक्ष्णदंष्ट्रोत्कटाननः ।\nतावभिप्रायमा लोक्य तस्य दैत्यस्य दूषितम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003631064, "chapter_id": 23631, "verse_number": "१-२-१८-६५", "content_sanskrit": "त्यक्त्वा रथावुभौ भीतौ पदाती प्रद्रुतौ द्रुतम् ।\nजग्मतुर्महिषाद्भीतौ शरणं पाकशासनम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003631065, "chapter_id": 23631, "verse_number": "१-२-१८-६६", "content_sanskrit": "क्रुद्धोऽथ महिषो दैत्यो वरुणं समुपाद्रवत् ।\nतमंतकमुखासन्नमालोक्य हिमदीधितिः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003631066, "chapter_id": 23631, "verse_number": "१-२-१८-६७", "content_sanskrit": "चक्रे शस्त्रं विसृष्टं हि हिमसंघातमुल्बणम् ।\nवायव्यं चास्त्र मतुलं चंद्रश्चक्रे द्वितीयकम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003631067, "chapter_id": 23631, "verse_number": "१-२-१८-६८", "content_sanskrit": "वायुना तेन चंडंन संशुष्केण हिमेन च ।\nमहाहिमनिपातेन शस्त्रैश्चंद्रप्रणोदितैः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003631068, "chapter_id": 23631, "verse_number": "१-२-१८-६९", "content_sanskrit": "गात्राण्यसुरसैन्यानामदह्यंत समंततः ।\nव्यथिता दानवाः सर्वे सीतच्छादितपौरुषाः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003631069, "chapter_id": 23631, "verse_number": "१-२-१८-७०", "content_sanskrit": "न शेकुश्चलिंतुं तत्र नास्त्राण्यादातुमेव च ।\nमहिषो निष्प्रयत्नश्च शीतेनाकंपिताननः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003631070, "chapter_id": 23631, "verse_number": "१-२-१८-७१", "content_sanskrit": "अंसमालिंग्य पाणिभ्यामुपविष्टो ह्यधोमुखः ।\nसर्वे ते निष्प्रतीकारा दैत्याश्चंद्रमसा जिताः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003631071, "chapter_id": 23631, "verse_number": "१-२-१८-७२", "content_sanskrit": "रणेच्छां दूरतस्त्यक्त्वा तस्थुस्ते जीवितार्थिनः ।\nतत्राब्रवीत्कालनेमिर्दैत्यान्क्रोधविदीपितः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003631072, "chapter_id": 23631, "verse_number": "१-२-१८-७३", "content_sanskrit": "भोभोः श्रृंगारिणः क्रूराः सर्वशस्त्रास्त्रपारगाः ।\nएकैकोऽपि जगत्कृस्नं शक्तस्तुलयितुं भुजैः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003631073, "chapter_id": 23631, "verse_number": "१-२-१८-७४", "content_sanskrit": "एकैकोऽपि क्षमो ग्रस्तुं जगत्सर्वं चराचरम् ।\nएकैकस्यापि पर्याप्ता न सर्वेऽपि दिवौकसः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003631074, "chapter_id": 23631, "verse_number": "१-२-१८-७५", "content_sanskrit": "किं त्रस्तनयनाश्चैव समरे परिनिर्जिताः ।\nन युक्तमेतच्छूराणां विशेषाद्दैत्यजन्मनाम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003631075, "chapter_id": 23631, "verse_number": "१-२-१८-७६", "content_sanskrit": "राज्ञश्च तारकस्यापि दर्शयिष्यथ किं मुखम् ।\nविरतानां रणाच्चासौ क्रुद्धः प्राणान्हरिष्यति ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003631076, "chapter_id": 23631, "verse_number": "१-२-१८-७७", "content_sanskrit": "इति ते प्रोच्यमानापि नोचुः किंचिन्महासुराः ।\nशीतेन नष्टश्रुतयो भ्रष्टवाक्याश्च ते तथा ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003631077, "chapter_id": 23631, "verse_number": "१-२-१८-७८", "content_sanskrit": "मूकास्तथाभवन्दैत्या मृतकल्पा महारणे ।\nतान्दृष्ट्वा नष्टचेतस्कान्दैत्याञ्छीतेन पीडितान् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003631078, "chapter_id": 23631, "verse_number": "१-२-१८-७९", "content_sanskrit": "मत्वा कालक्षमं कार्यं कालनेमिर्महासुरः ।\nआश्रित्य मानवीं मायां वितत्य च महावपुः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003631079, "chapter_id": 23631, "verse_number": "१-२-१८-८०", "content_sanskrit": "पूरयामास गगनं विदिश एव च ।\nनिर्ममे दानवेन्द्रोऽसौ शरीरेभास्करायुतम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003631080, "chapter_id": 23631, "verse_number": "१-२-१८-८१", "content_sanskrit": "दिशश्च विदिशश्चैव पूरयामास पावकैः ।\nततो ज्वालाकुलं सर्वं त्रैलोक्यमभवत्क्षणात् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003631081, "chapter_id": 23631, "verse_number": "१-२-१८-८२", "content_sanskrit": "तेन ज्वालासमूहेन हिमां शुरगमद्द्रुतम् ।\nततः क्रमेण विभ्रष्टं शीतदुर्दिनमाबभौ ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003631082, "chapter_id": 23631, "verse_number": "१-२-१८-८३", "content_sanskrit": "तद्बलं दानवेंद्राणां मायया कालनेमिनः ।\nतद्दृष्ट्वा दानवानीकं लब्धसंज्ञं दिवाकरः ।\nउवाचारुणमत्यर्थं कोपरक्तांतलोचनः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003631083, "chapter_id": 23631, "verse_number": "१-२-१८-८४", "content_sanskrit": "दिवाकर उवाच ।\nनयारुण रथं शीघ्रं कालनेमिरथो यतः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003631084, "chapter_id": 23631, "verse_number": "१-२-१८-८५", "content_sanskrit": "विमर्दे तत्र विषमे भविता भूतसंक्षयः ।\nजित एषशशांकोऽथ वयं यद्बलमाश्रिताः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003631085, "chapter_id": 23631, "verse_number": "१-२-१८-८६", "content_sanskrit": "इत्युक्तश्चोदयामास रथं गरुडपूर्वजः ।\nरथे स्थितोऽपि तैरश्वैः सितचामरधारिभिः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003631086, "chapter_id": 23631, "verse_number": "१-२-१८-८७", "content_sanskrit": "जगद्दीपोऽथ भगवाञ्जग्राह विततं धनुः ।\nशरौघो वै पांडुपुत्र क्षिप्रमासीद्विषद्युतिः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003631087, "chapter_id": 23631, "verse_number": "१-२-१८-८८", "content_sanskrit": "शंबरास्त्रेण संधाय बाणमेकं ससर्ज ह ।\nद्वितीयं चेन्द्रजालेनायोजितं प्रमुमोच ह ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003631088, "chapter_id": 23631, "verse_number": "१-२-१८-८९", "content_sanskrit": "शंबरास्त्रं क्षणाच्चक्रे तेषांरूपविपर्ययम् ।\nदेवानां दानवं रूपं दानवानां च दैविकम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003631089, "chapter_id": 23631, "verse_number": "१-२-१८-९०", "content_sanskrit": "मत्वा सुरान्स्वकानेव जघ्ने घोरास्त्रलाघवात् ।\nकालनेमी रुषाविष्टः कृतांत इव संक्षये ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003631090, "chapter_id": 23631, "verse_number": "१-२-१८-९१", "content_sanskrit": "कांश्चित्खड्गेन तीक्ष्णेन कांश्चिन्नाराचवृष्टिभिः ।\nकांश्चिद्गदाभिर्घोराभिः कांश्चिद्धोरैः परश्वधैः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003631091, "chapter_id": 23631, "verse_number": "१-२-१८-९२", "content_sanskrit": "शिरांसि केषाचिदपातयद्रथाद्भुजांस्तथा सारथींस्चोग्रवेगान् ।\nकांश्चित्पिपेषाथरथस्य वेगात्कांश्चित्तथात्यद्भुतमुष्टिपातैः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}]