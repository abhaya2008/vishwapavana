[{"id": 7003963000, "chapter_id": 23963, "verse_number": "३-१-२६-१", "content_sanskrit": "श्रीसूत उवाच ।\nविधायाभिषवं मर्त्याः शंखतीर्थे द्विजोत्तमाः ।\nयमुनां चैव गंगां च गयां चापि क्रमाद्व्रजेत्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003963001, "chapter_id": 23963, "verse_number": "३-१-२६-२", "content_sanskrit": "यमुनाख्यं महातीर्थं गंगातीर्थमनुत्तमम् ।\nगयातीर्थं च मर्त्यानां महापातकनाशनम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003963002, "chapter_id": 23963, "verse_number": "३-१-२६-३", "content_sanskrit": "एतत्तीर्थत्रयं पुण्यं सर्वलोकेषु विश्रुतम् ।\nसर्वविघ्नप्रशमनं सर्वरोगनिबर्हणम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003963003, "chapter_id": 23963, "verse_number": "३-१-२६-४", "content_sanskrit": "एतद्धि तीर्थत्रितयं सकलाज्ञाननाशनम् ।\nअविद्यायां विनष्टायां तथा ज्ञानप्रदं नृणाम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003963004, "chapter_id": 23963, "verse_number": "३-१-२६-५", "content_sanskrit": "जानश्रुतिर्महाराज एषु तीर्थेषु वै पुरा ।\nस्नात्वा रैक्वाद्द्विजश्रेष्ठात्प्राप्तवाञ्ज्ञानमुत्तमम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003963005, "chapter_id": 23963, "verse_number": "३-१-२६-६", "content_sanskrit": "ऋषय ऊचुः ।\nसूत सर्वार्थतत्त्वज्ञ व्यासशिष्य महामते ।\nयमुना चैव गंगा च गया चैवेति विश्रुतम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003963006, "chapter_id": 23963, "verse_number": "३-१-२६-७", "content_sanskrit": "एतत्तीर्थत्रयं कस्मादागतं गंधमादने ।\nजानश्रुतेश्च राजर्षेः स्नानात्तीर्थत्रयेऽपि च ।\nज्ञानावाप्तिः कथं रैक्वादस्माकं सूत तद्वद॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003963007, "chapter_id": 23963, "verse_number": "३-१-२६-८", "content_sanskrit": "श्रीसूत उवाच ।\nरैक्वनामा महर्षिस्तु पुरा वै गन्धमादने॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003963008, "chapter_id": 23963, "verse_number": "३-१-२६-९", "content_sanskrit": "तपस्सुदुश्चरं कुर्वन्न्यवसत्तपसां निधिः ।\nदीर्घकालं तपः कुर्वन्स वै रैक्वो महामुनिः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003963009, "chapter_id": 23963, "verse_number": "३-१-२६-१०", "content_sanskrit": "तपोबलेन महता दीर्घमायुरवाप्तवान् ।\nजन्मना पंगुरेवासीद्रैक्वनामा महामुनिः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003963010, "chapter_id": 23963, "verse_number": "३-१-२६-११", "content_sanskrit": "पंगुत्वादसमर्थोऽभूद्गंतुं तीर्थान्यसौ मुनिः ।\nसंति यानि तु तीर्थानि गन्धमादनपर्वते॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003963011, "chapter_id": 23963, "verse_number": "३-१-२६-१२", "content_sanskrit": "तानि गच्छति सामीप्याच्छकटेनैव संचरन् ।\nस यद्रैक्वो मुनिवरो युग्वेन सह वर्तते॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003963012, "chapter_id": 23963, "verse_number": "३-१-२६-१३", "content_sanskrit": "तपस्वी वैदिकैर्लोके सयुग्वैत्यभिधीयते ।\nयुग्वेति शकटं प्रोक्तं स तेन सह वर्तते॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003963013, "chapter_id": 23963, "verse_number": "३-१-२६-१४", "content_sanskrit": "स खल्वेवं मुनिश्रेष्ठः सयुग्वानाम वै मुनिः ।\nपूर्णज्ञानस्तपस्तेपे गन्धमादनपर्वते॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003963014, "chapter_id": 23963, "verse_number": "३-१-२६-१५", "content_sanskrit": "ग्रीष्मे पञ्चाग्निमध्यस्थः सोऽतप्यत महत्तपः ।\nवर्षायां कण्ठदघ्नेषु जलेषु समवर्तत॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003963015, "chapter_id": 23963, "verse_number": "३-१-२६-१६", "content_sanskrit": "तपसा शोषिते गात्रे पामा तस्य व्यजायत ।\nकण्डूयत स पामानं दिवारात्रं मुनीश्वरः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003963016, "chapter_id": 23963, "verse_number": "३-१-२६-१७", "content_sanskrit": "कण्डूयमान एवायं पामानं न तपोऽत्यजत् ।\nअजायत मनस्त्वेवं तस्य सयुग्वनो मुनेः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003963017, "chapter_id": 23963, "verse_number": "३-१-२६-१८", "content_sanskrit": "यमुनायां च गंगायां गयायां चाधुनैव हि ।\nअस्मिंस्तीर्थे त्रये पुण्ये स्नातव्यं हि मया त्विति॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003963018, "chapter_id": 23963, "verse_number": "३-१-२६-१९", "content_sanskrit": "एवं विचिंत्य स मुनिरन्यां चिंतामथाकरोत् ।\nअहं हि जन्मना पंगुरतः स्नानं हि दुर्लभम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003963019, "chapter_id": 23963, "verse_number": "३-१-२६-२०", "content_sanskrit": "अतिदूरं मया गन्तुं शकटेन न शक्यते ।\nकिं करोम्यधुनेत्येवं स वितर्क्य महामतिः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003963020, "chapter_id": 23963, "verse_number": "३-१-२६-२१", "content_sanskrit": "तीर्थत्रयेषु स्नानार्थं कर्तव्यं निश्चिकाय वै ।\nअप्रसह्यमनाधृष्यं विद्यते मे तपोबलम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003963021, "chapter_id": 23963, "verse_number": "३-१-२६-२२", "content_sanskrit": "तेनैवावाहयिष्यामि तद्धि तीर्थत्रयं त्विह ।\nइति निश्चित्य मनसा प्राङ्मुखो नियतेंद्रियः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003963022, "chapter_id": 23963, "verse_number": "३-१-२६-२३", "content_sanskrit": "त्रिराचम्य च सयुग्वान्दध्यौ क्षणमतंद्रितः ।\nतस्य मंत्रप्रभावेन यमुना सा महानदी॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003963023, "chapter_id": 23963, "verse_number": "३-१-२६-२४", "content_sanskrit": "गंगा च जह्नुतनया गया सा पापनाशिनी ।\nभूमिं निर्भिद्य तिस्रोपि पातालात्सहसोत्थिताः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003963024, "chapter_id": 23963, "verse_number": "३-१-२६-२५", "content_sanskrit": "मानुषं रूपमास्थाय सयुग्वानमुपेत्य च ।\nऊचुः परमसंहृष्टा हर्षयंत्यश्च तं मुनिम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003963025, "chapter_id": 23963, "verse_number": "३-१-२६-२६", "content_sanskrit": "सयुग्वन्रैक्व भद्रं ते ध्यानादस्मादुपारम ।\nत्वन्मत्रेण समाकृष्टा वयमत्र समागताः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003963026, "chapter_id": 23963, "verse_number": "३-१-२६-२७", "content_sanskrit": "कि कर्तव्यं तवास्माभिस्तद्वदस्व मुनीश्वर ।\nइति तासां वचः श्रुत्वा सयुग्वान्हि महामुनिः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003963027, "chapter_id": 23963, "verse_number": "३-१-२६-२८", "content_sanskrit": "ध्यानादुपारमत्तूर्णं ताश्चापश्यत्पुरः स्थिताः ।\nस ताः संपूज्य विधिवद्रैक्वो वाचमभाषत॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003963028, "chapter_id": 23963, "verse_number": "३-१-२६-२९", "content_sanskrit": "यमुने देवि हे गंगे हे गये पापनाशिनि ।\nसन्निधानं कुरुध्वं मे गन्धमादनपर्वते॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003963029, "chapter_id": 23963, "verse_number": "३-१-२६-३०", "content_sanskrit": "यत्र भूमिं विनिर्भिद्य भवत्य इह निर्गताः ।\nतानि पुण्यानि तीर्थानि भवेयुर्वोऽभिधानतः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003963030, "chapter_id": 23963, "verse_number": "३-१-२६-३१", "content_sanskrit": "सहसांतरधीयंत तथास्त्वित्येव तत्र ताः ।\nतदाप्रभृति तीर्थानि तानि त्रीण्यपि भूतले॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003963031, "chapter_id": 23963, "verse_number": "३-१-२६-३२", "content_sanskrit": "तेनतेनाभिधानेन गीयन्ते सर्वदा जनैः ।\nयत्र भूमिं विनिर्भिद्य यमुना निर्गता तदा॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003963032, "chapter_id": 23963, "verse_number": "३-१-२६-३३", "content_sanskrit": "यमुनातीर्थमिति वै तज्जनैरभिधीयते ।\nयतो वै पृथिवीरंध्राज्जाह्नवी सहसोत्थिता॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003963033, "chapter_id": 23963, "verse_number": "३-१-२६-३४", "content_sanskrit": "गंगातीर्थमिति ख्यातं तल्लोके पापनाशनम् ।\nगया हि मानुषं रूपं यत आस्थाय निर्ययौ॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003963034, "chapter_id": 23963, "verse_number": "३-१-२६-३५", "content_sanskrit": "तदेव भूमिविवरं गयातीर्थं प्रचक्षते ।\nएवमेतन्महापुण्यं तीर्थत्रयमनुत्तमम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003963035, "chapter_id": 23963, "verse_number": "३-१-२६-३६", "content_sanskrit": "रैक्वमंत्रप्रभावेण पृथिव्याः सहसोत्थितम् ।\nअत्र तीर्थत्रये स्नानं ये कुर्वंति नरोत्तमाः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003963036, "chapter_id": 23963, "verse_number": "३-१-२६-३७", "content_sanskrit": "तेषामज्ञाननाशः स्याज्ज्ञानमप्युदयं लभेत् ।\nस्वमंत्रेण समाकृष्टे तत्र तीर्थत्रये मुनिः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003963037, "chapter_id": 23963, "verse_number": "३-१-२६-३८", "content_sanskrit": "स्नानं समाचरन्नित्यं स कालानत्यवाहयत् ।\nएतस्मिन्नेव काले तु राजा जानश्रुतिर्महान्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003963038, "chapter_id": 23963, "verse_number": "३-१-२६-३९", "content_sanskrit": "पुत्रसंज्ञस्य राजर्षेः पौत्रो धर्मैकतत्परः ।\nदेयमन्नादि स तदा ह्यर्थिभ्यः श्रद्धयैव यत्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003963039, "chapter_id": 23963, "verse_number": "३-१-२६-४०", "content_sanskrit": "तस्मादेनं नजालोके श्रद्धादेयं प्रचक्षते ।\nयतो बहुतरं वाक्यमन्नाद्यस्य महीपतेः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003963040, "chapter_id": 23963, "verse_number": "३-१-२६-४१", "content_sanskrit": "अर्थिनां क्षुधितानां तु तृप्त्यर्थं वर्तते गृहे ।\nअतोयमर्थिभिः सर्वैर्बहुवाक्य इतीर्यते॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003963041, "chapter_id": 23963, "verse_number": "३-१-२६-४२", "content_sanskrit": "स वै पौत्रायणो राजा जानश्रुतसुतो बली ।\nप्रियातिथिर्बभूवासौ बहुदायी तथाऽभवत्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003963042, "chapter_id": 23963, "verse_number": "३-१-२६-४३", "content_sanskrit": "नगरेषु च राष्ट्रेषु ग्रामेषु च वनेषु च ।\nचतुष्पथेषु सर्वेषु महामार्गेषु सर्वशः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003963043, "chapter_id": 23963, "verse_number": "३-१-२६-४४", "content_sanskrit": "बह्वन्नपान संयुक्तं सूपशाकादिसंयुतम् ।\nआतिथ्यं कल्पयामास तृप्तयेऽर्थिजनस्य वै॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003963044, "chapter_id": 23963, "verse_number": "३-१-२६-४५", "content_sanskrit": "अन्नपानादिकं सर्वमुपयुड्ध्वमिहार्थिनः ।\nइत्यसौ घोषयामास तत्र तत्र जनास्पदे॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003963045, "chapter_id": 23963, "verse_number": "३-१-२६-४६", "content_sanskrit": "तस्य प्रियातिथेरेव नृपस्य बहुदायिनः ।\nअर्थिभ्यो दानशौंडस्य गुणाः सर्वत्र विश्रुताः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003963046, "chapter_id": 23963, "verse_number": "३-१-२६-४७", "content_sanskrit": "अथ पौत्रायणस्यास्य गुण ग्रामेण वर्ततः ।\nदेवर्षयो महाभागास्तस्यानुग्रहकांक्षिणः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003963047, "chapter_id": 23963, "verse_number": "३-१-२६-४८", "content_sanskrit": "हंसरूपं समास्थाय निदाघसमये निशि ।\nरमणीयां विधायाशु श्रेणीमाकाशमागतः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003963048, "chapter_id": 23963, "verse_number": "३-१-२६-४९", "content_sanskrit": "सौधवातायनस्थस्य तस्योपरि महीपतेः ।\nउड्डीयोड्डीय वेगेन तरसा जग्मुरुच्चकैः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003963049, "chapter_id": 23963, "verse_number": "३-१-२६-५०", "content_sanskrit": "तरसा पततां तेषां हंसानां पृष्ठतो व्रजन् ।\nएको हंसस्तु संबोध्य हंसमग्रेसरं तदा॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003963050, "chapter_id": 23963, "verse_number": "३-१-२६-५१", "content_sanskrit": "सोपहासमिदं वाक्यं प्राह शृण्वति राजनि ।\nभोभो भल्लाक्ष भल्लाक्ष पुरो गच्छन्मरालक॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003963051, "chapter_id": 23963, "verse_number": "३-१-२६-५२", "content_sanskrit": "सौधमध्ये पुरस्ताद्वै जानश्रुतसुतो नृपः ।\nवर्तते पूजनीयोऽयं न पश्यसि किमंधवत्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003963052, "chapter_id": 23963, "verse_number": "३-१-२६-५३", "content_sanskrit": "यस्य तेजो दुराधर्षमाब्रह्म भवनादिदम् ।\nअनंतादित्यसंकाशं ज्वलते पुरतो भृशम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003963053, "chapter_id": 23963, "verse_number": "३-१-२६-५४", "content_sanskrit": "तमतिक्रम्य राजर्षिं मा गास्त्वमुपरि द्रुतम् ।\nयदि गच्छसि तत्तेजस्सांप्रतं त्वां प्रधक्ष्यति॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003963054, "chapter_id": 23963, "verse_number": "३-१-२६-५५", "content_sanskrit": "इत्युक्तवंतं तं हंसमग्रतः प्रत्यभाषत ।\nअहो भवानभिज्ञोऽसि श्लाघनीयोऽसि सूरिभिः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003963055, "chapter_id": 23963, "verse_number": "३-१-२६-५६", "content_sanskrit": "अश्लाघनीयं कितवं यत्त्वमेनं प्रशंससे ।\nप्रशंससे किमर्थं त्वमल्पं संतमिमं जनम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003963056, "chapter_id": 23963, "verse_number": "३-१-२६-५७", "content_sanskrit": "भस्रावत्पशुवच्चैव केवलं श्वासधारिणम् ।\nन ह्ययं वेत्ति धर्माणां रहस्यं पृथिवी पतिः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003963057, "chapter_id": 23963, "verse_number": "३-१-२६-५८", "content_sanskrit": "तत्त्वज्ञानी यथा रैक्वः सयुग्वान्ब्राह्मणोत्तमः ।\nरैक्वस्य हि महज्ज्योतीरहस्यं दैवतैरपि॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003963058, "chapter_id": 23963, "verse_number": "३-१-२६-५९", "content_sanskrit": "न ह्यस्य प्राणमात्रस्य तेजस्तादृशमस्ति वै ।\nरैक्वस्य पुण्यराशीनामियत्ता नैव विद्यते॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003963059, "chapter_id": 23963, "verse_number": "३-१-२६-६०", "content_sanskrit": "गण्यते पांसवो भूमेर्गण्यंते दिवि तारकाः ।\nरैक्वपुण्यमहामेरुसमूहो नैव गण्यते॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003963060, "chapter_id": 23963, "verse_number": "३-१-२६-६१", "content_sanskrit": "किं च तिष्ठंत्विमे धर्मा नश्वरास्तस्य वै मुनेः ।\nब्रह्मज्ञानमबाध्यं यत्तेन स श्लाघ्यते मुनिः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003963061, "chapter_id": 23963, "verse_number": "३-१-२६-६२", "content_sanskrit": "जानश्रुतेस्तु तादृक्षो धर्म एव न विद्यते ।\nदुर्लभं यत्तु योगीन्द्रैः कुतस्तज्ज्ञानवैभवम्॥ ०६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003963062, "chapter_id": 23963, "verse_number": "३-१-२६-६३", "content_sanskrit": "परित्यज्य दुरात्मानं तद्वराकमिमं जनम् ।\nस एव रैक्वः सयुग्वाञ्छ्लाघ्यतां भवता मुनिः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003963063, "chapter_id": 23963, "verse_number": "३-१-२६-६४", "content_sanskrit": "जन्मना पंगुरपि यः स्वस्य स्नानचिकीर्षया ।\nगंगां च यमुनां चापि गयामपि मुनीश्वरः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003963064, "chapter_id": 23963, "verse_number": "३-१-२६-६५", "content_sanskrit": "आह्वयामास मन्त्रेण निजाश्रमसमीपतः ।\nतस्य ब्रह्मविदो रैक्वमहर्षेर्धर्मसंचये॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003963065, "chapter_id": 23963, "verse_number": "३-१-२६-६६", "content_sanskrit": "अंतर्भवंति धर्मौघास्त्रैलोक्योदरवर्तिनाम् ।\nरैक्वस्य धर्मकक्षा तु न हि त्रैलोक्यवर्तिनाम्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003963066, "chapter_id": 23963, "verse_number": "३-१-२६-६७", "content_sanskrit": "प्राणिनां धर्मकक्षायामन्तर्भवति कर्हिचित ।\nएवमग्रेसरे हंसे कथित्वोपरते सति॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003963067, "chapter_id": 23963, "verse_number": "३-१-२६-६८", "content_sanskrit": "हंसरूपा मुनींद्रास्ते ब्रह्मलोकं ययुः पुनः ।\nअथ पौत्रायणो राजा जानश्रुतिररिंदमः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003963068, "chapter_id": 23963, "verse_number": "३-१-२६-६९", "content_sanskrit": "रैक्वं चोत्कर्षकाष्ठायां निशम्य परमावधिम् ।\nविषण्णोऽभवदत्यर्थं वराकोऽक्षजितो यथा॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003963069, "chapter_id": 23963, "verse_number": "३-१-२६-७०", "content_sanskrit": "चिंतयामास स नृपः पौनःपुन्येन निःश्वसन् ।\nहंस उत्कर्षयन्रैक्वं निकृष्टं मामिहाब्रवीत्॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003963070, "chapter_id": 23963, "verse_number": "३-१-२६-७१", "content_sanskrit": "अहो रैक्वस्य माहात्म्यं यं प्रशंसंति पक्षिणः ।\nतत्परित्यज्य संसारं सर्वं राज्यमिहाधुना॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003963071, "chapter_id": 23963, "verse_number": "३-१-२६-७२", "content_sanskrit": "सयुग्वानं महात्मानं तमेव शरणं व्रजे ।\nकृपानिधिः स वै रैक्वः शरणं मामु पागतम्॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003963072, "chapter_id": 23963, "verse_number": "३-१-२६-७३", "content_sanskrit": "प्रतिगृह्यात्मविज्ञानं मह्यं समुपदेक्ष्यति ।\nइत्यसौ चिंतयन्नेव कथंकथमपि द्विजाः॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003963073, "chapter_id": 23963, "verse_number": "३-१-२६-७४", "content_sanskrit": "जाग्रन्नेवायमुद्वेलां रात्रिं तामत्यवाह यत् ।\nनिशावसाने संप्राप्ते बंदिवृन्दप्रवर्तितम्॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003963074, "chapter_id": 23963, "verse_number": "३-१-२६-७५", "content_sanskrit": "अशृणोन्मंगलरवं तूर्यघोषसमन्वितम् ।\nतदाकर्ण्य महाराजस्तदा तल्पस्थ एव सन्॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003963075, "chapter_id": 23963, "verse_number": "३-१-२६-७६", "content_sanskrit": "सारथिं शीघ्रमाहूय बभाषे सादरं वचः ।\nसारथे सत्वरं गत्वा रथमारुह्य वेगवत्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003963076, "chapter_id": 23963, "verse_number": "३-१-२६-७७", "content_sanskrit": "आश्रमेषु महर्षीणां पुण्येषु विपिनेषु च ।\nविविक्तेषु प्रदेशेषु सतामावासभूमिषु॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003963077, "chapter_id": 23963, "verse_number": "३-१-२६-७८", "content_sanskrit": "तीर्थानां च नदीनां च कूलेषु पुलिनेषु च ।\nअन्येषु च प्रदेशेषु यत्र संति मुनीश्वराः॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003963078, "chapter_id": 23963, "verse_number": "३-१-२६-७९", "content_sanskrit": "तेषु सर्वेषु योगींद्रं पंगुं शकटसंस्थितम् ।\nरैक्वाभिधानं सर्वेषां धर्माणामेकसंश्रयम्॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003963079, "chapter_id": 23963, "verse_number": "३-१-२६-८०", "content_sanskrit": "ब्रह्मज्ञानैकनिलयं सयुग्वानं गवेषय ।\nअन्विष्य तूर्णं मत्प्रीत्यै पुनरागच्छ सारथे॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003963080, "chapter_id": 23963, "verse_number": "३-१-२६-८१", "content_sanskrit": "स तथेति विनिर्गत्य वेगवद्रथसंस्थितः ।\nसर्वत्रान्वेषयामास रैक्वं ब्रह्मविदं मुनिम्॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003963081, "chapter_id": 23963, "verse_number": "३-१-२६-८२", "content_sanskrit": "गुहासु पर्वतानां च मुनीनामाश्रमेषु च ।\nसंचचार महीं कृत्स्नां तत्र तत्र गवेषयन्॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003963082, "chapter_id": 23963, "verse_number": "३-१-२६-८३", "content_sanskrit": "अन्विष्य विविधान्देशान्सारथिस्त्वरया सह ।\nक्रमान्महर्षिसंबाधं गंधमादनमन्वगात्॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003963083, "chapter_id": 23963, "verse_number": "३-१-२६-८४", "content_sanskrit": "मार्गमाणः स तत्रापि तं ददर्श मुनीश्वरम् ।\nकंडूयमानं पामानं शकटीयस्थलस्थि तम्॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003963084, "chapter_id": 23963, "verse_number": "३-१-२६-८५", "content_sanskrit": "अद्वैतनिष्कलं ब्रह्म चिंतयंतं निरन्तरम् ।\nतं दृष्ट्वा सारथिस्तत्र सयुग्वानं महामुनिम्॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003963085, "chapter_id": 23963, "verse_number": "३-१-२६-८६", "content_sanskrit": "रैक्वोऽयमिति संचिंत्य तमासाद्य प्रणम्य च ।\nविनयान्मुनिमप्राक्षीदुपविश्य तदन्तिके॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003963086, "chapter_id": 23963, "verse_number": "३-१-२६-८७", "content_sanskrit": "सयुग्वान्रैक्वनामा च ब्रह्मन्किं वै भवानिति ।\nतस्य वाक्यं समाकर्ण्य स मुनिः प्रत्यभाषत॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003963087, "chapter_id": 23963, "verse_number": "३-१-२६-८८", "content_sanskrit": "अहमेव सयुग्वान्वै रैक्वनामेति वै तदा ।\nइत्याकर्ण्य मुने र्वाक्यमिंगितैर्बहुभिस्तथा॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003963088, "chapter_id": 23963, "verse_number": "३-१-२६-८९", "content_sanskrit": "कुटुम्बभरणार्थाय धनेच्छामवगम्य च ।\nसर्वं न्यवेदयद्राज्ञे निवृत्तो गंधमादनात्॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003963089, "chapter_id": 23963, "verse_number": "३-१-२६-९०", "content_sanskrit": "जानश्रुतिर्निशम्याथ सारथेर्वाक्यमादरात् ।\nषट्शतानि गवां चापि निष्कभारं धनस्य च॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003963090, "chapter_id": 23963, "verse_number": "३-१-२६-९१", "content_sanskrit": "रथं चाश्वतरीयुक्तं समादाय त्वरान्वितः ।\nपौत्रायणः स राजर्षिस्तं रैक्वं प्रतिचक्रमे॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003963091, "chapter_id": 23963, "verse_number": "३-१-२६-९२", "content_sanskrit": "गत्वा च वचनं प्राह तं रैक्वं स महीपतिः ।\nभगवन्रैक्व सयुग्वन्मद्दत्तं प्रतिगृह्यताम्॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003963092, "chapter_id": 23963, "verse_number": "३-१-२६-९३", "content_sanskrit": "षट्शतानि गवां चापि निष्कभारं धनस्य च ।\nरथं चाश्वतरीयुक्तं प्रतिगृह्णीष्व मामकम्॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003963093, "chapter_id": 23963, "verse_number": "३-१-२६-९४", "content_sanskrit": "गृहीत्वा सवमेतत्तु भो ब्रह्मन्ननुशाधि माम् ।\nअद्वैतब्रह्मविज्ञानं मह्यं समुपदिश्यताम्॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003963094, "chapter_id": 23963, "verse_number": "३-१-२६-९५", "content_sanskrit": "इति तस्य वचः श्रुत्वा सस्पृहं च संसभ्रम् ।\nरैक्वः प्रत्याह सयुग्वाञ्जानश्रुतिमरिंदमम्॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003963095, "chapter_id": 23963, "verse_number": "३-१-२६-९६", "content_sanskrit": "रैक्व उवाच ।\nएता गावस्तवैवास्तु निष्कभारस्तथा रथः ।\nकिमल्पेन ममानेन बहुकल्पेषु जीवतः॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003963096, "chapter_id": 23963, "verse_number": "३-१-२६-९७", "content_sanskrit": "न मे कुटुंब निर्वाहे पर्याप्तमिदमंजसा ।\nएवं शतगुणं चापि यदि दत्तं त्वया मम॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003963097, "chapter_id": 23963, "verse_number": "३-१-२६-९८", "content_sanskrit": "नालं तदपि राजेंद्र कुटुंबभरणाय वै ।\nइति रैक्ववचः श्रुत्वा जानश्रुतिरभाषत॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003963098, "chapter_id": 23963, "verse_number": "३-१-२६-९९", "content_sanskrit": "जानश्रुतिरुवाच ।\nत्वयोपदिश्यमानस्य ब्रह्मज्ञानस्य वै मुने ।\nन हि मूल्यमिदं ब्रह्मन्गोधनं रथ एव च॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003963099, "chapter_id": 23963, "verse_number": "३-१-२६-१००", "content_sanskrit": "प्रतिगृह्णीष्व वा मा वा ममैतत्तु गवादिकम् ।\nनिष्कलाद्वैतविज्ञानं ब्रह्मन्नुपदिशस्व मे ।\nतदाकर्ण्य वचस्तस्य सयुग्वान्वाक्य मब्रवीत्॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003963100, "chapter_id": 23963, "verse_number": "३-१-२६-१०१", "content_sanskrit": "रैक्व उवाच ।\nनिर्वेदो यस्य संसारे तथा वै पुण्यपापयोः॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003963101, "chapter_id": 23963, "verse_number": "३-१-२६-१०२", "content_sanskrit": "प्रारब्धयोर्विनाशश्च स वै ज्ञानोपदेशभाक् ।\nतव यद्यपि संसारे निर्वेदः समजायत॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003963102, "chapter_id": 23963, "verse_number": "३-१-२६-१०३", "content_sanskrit": "तथापि पुण्यपापानां न हि नाशो व्याजयत ।\nपुण्यपापौघसंघाश्च पुनर्जन्मनि हेतवः॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003963103, "chapter_id": 23963, "verse_number": "३-१-२६-१०४", "content_sanskrit": "न हि भोगं विना तेषां नाशो भवति भूपते ।\nतन्नाशोपायमद्याहं तथापि प्रब्रवीमि ते॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003963104, "chapter_id": 23963, "verse_number": "३-१-२६-१०५", "content_sanskrit": "यतो मां शरणं प्राप्तस्तच्छृणुष्व समाहितः ।\nअत्र तीर्थत्रयं पुण्यं वर्ततेऽभीष्टदायकम्॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003963105, "chapter_id": 23963, "verse_number": "३-१-२६-१०६", "content_sanskrit": "मुमुक्षूणां हि सर्वेषां सर्वप्रारब्धनाशनम् ।\nएतद्धि यमुनातीर्थं गंगातीर्थं तथैव च॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003963106, "chapter_id": 23963, "verse_number": "३-१-२६-१०७", "content_sanskrit": "गयातीर्थमिदं चापि तदेषु स्नाहि मा चिरम् ।\nसर्वप्रारब्धनाशः स्यात्तदा नैवात्र संशयः॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003963107, "chapter_id": 23963, "verse_number": "३-१-२६-१०८", "content_sanskrit": "ततस्ते शुद्धचित्तस्य ज्ञानं चैव दिशाम्यहम् ।\nइत्युक्ते रैक्वमुनिना हर्षसंफुल्ललोचनः॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003963108, "chapter_id": 23963, "verse_number": "३-१-२६-१०९", "content_sanskrit": "ससंभ्रममुपागम्य सस्नौ तीर्थत्रयेऽपि सः ।\nतत्तीर्थस्नानमात्रेण शुद्धचित्तोऽभवन्नृपः॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003963109, "chapter_id": 23963, "verse_number": "३-१-२६-११०", "content_sanskrit": "उपातिष्ठत राजासौ सयुग्वानं गुरुं पुनः ।\nसयुग्वा स च रैक्वोऽपि मुनींद्रैरपि दुर्लभम्॥ ११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003963110, "chapter_id": 23963, "verse_number": "३-१-२६-१११", "content_sanskrit": "तज्जानश्रुतये ज्ञानं कृपया समुपादिशत् ।\nतेनोपदिष्टमात्रे तु विज्ञाने ब्रह्मरूपिणि॥ १११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003963111, "chapter_id": 23963, "verse_number": "३-१-२६-११२", "content_sanskrit": "अबाधितानुभववानभवद्राजसत्तमः ।\nब्रह्मरूपं गतस्यास्य प्रसादाद्रैक्वयोगिनः॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003963112, "chapter_id": 23963, "verse_number": "३-१-२६-११३", "content_sanskrit": "घटकुड्यकुसूलात्मा न प्रपंचस्समस्फुरत् ।\nनिर्भिद्य सहसा मायामभूद्ब्रह्मैव केवलम्॥ ११३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003963113, "chapter_id": 23963, "verse_number": "३-१-२६-११४", "content_sanskrit": "इत्थं तीर्थत्रये स्नानाज्जानश्रुतिरहो नृपः ।\nदुर्लभं योगिवृंदैश्च ब्रह्मभूयत्वमाप्तवान्॥ ११४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003963114, "chapter_id": 23963, "verse_number": "३-१-२६-११५", "content_sanskrit": "एवं वः कथितं विप्रास्तत्तीर्थत्रयवैभवम् ।\nयस्त्विमं पठतेऽध्यायं तीर्थत्रितयवैभवम्॥ ११५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003963115, "chapter_id": 23963, "verse_number": "३-१-२६-११६", "content_sanskrit": "निर्भिद्याज्ञानतिमिरं ब्रह्मभूयाय कल्पते॥ ११६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}]