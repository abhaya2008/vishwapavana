[{"id": 7000141000, "chapter_id": 20141, "verse_number": "१४१-१", "content_sanskrit": "कपिलासंगमाख्यानवर्णनम् ब्रह्मोवाच कपिलासंगमं नाम तीर्थं त्रैलोक्यविश्रुतम् ।\nतत्र नारद वक्ष्यामि कथां पुण्यामनुत्तमाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000141001, "chapter_id": 20141, "verse_number": "१४१-२", "content_sanskrit": "कपिलो नाम तत्त्वज्ञो मुनिरासीन्महायशाः ।\nक्रूरश्चापि प्रसन्नश्च तपोव्रतपरायणः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000141002, "chapter_id": 20141, "verse_number": "१४१-३", "content_sanskrit": "तपस्यन्तं मुनिश्रेष्ठं गौतमीतीरमाश्रितम् ।\nतमागत्य महात्मानं वामदेवादयोऽब्रुवन् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000141003, "chapter_id": 20141, "verse_number": "१४१-४", "content_sanskrit": "हत्वा वेनं ब्रह्मशापैर्नष्टधर्मे त्वराजके ।\nकपिलं सिद्धमाचार्यमूचुर्मुनिगणास्तदा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000141004, "chapter_id": 20141, "verse_number": "१४१-५", "content_sanskrit": "मुनिगणा ऊचुः गते वेदे गते धर्मे किं कर्तव्यं मुनीश्वर ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000141005, "chapter_id": 20141, "verse_number": "१४१-६", "content_sanskrit": "ब्रह्मोवाच ततोऽब्रवीन्मुनिर्ध्यात्वा कपिलस्त्वागतान्मुनीन् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000141006, "chapter_id": 20141, "verse_number": "१४१-७", "content_sanskrit": "कपिल उवाच वेनस्योरुर्विमथ्योऽभूत्ततः कश्चिद्भविष्यति ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000141007, "chapter_id": 20141, "verse_number": "१४१-८", "content_sanskrit": "ब्रह्मोवाच तथैव चक्रुर्मुनयो वेनस्योरुं विमथ्य वै ।\nतत्रोत्पन्नो महापाप कृष्णो रौद्रपराक्रमः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000141008, "chapter_id": 20141, "verse_number": "१४१-९", "content_sanskrit": "तं दृष्ट्वा मुनयो भीता निषीदस्वेति चाब्रुवन् ।\nनिषादः सोऽभवत्तस्मान्निषादश्चाभवंस्ततः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000141009, "chapter_id": 20141, "verse_number": "१४१-१०", "content_sanskrit": "वेनबाहुं ममन्थुस्ते दक्षिणं धर्मसंहितम् ।\nततः पृथुस्वरश्चैव सर्वलक्षमलक्षितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000141010, "chapter_id": 20141, "verse_number": "१४१-११", "content_sanskrit": "राजाऽभवत्पृथुः श्रीमान्ब्रह्मसामर्थ्यसंयुतः ।\nतमागत्य सुराः सर्वे अभिनन्द्य वराञ्शुभान् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000141011, "chapter_id": 20141, "verse_number": "१४१-१२", "content_sanskrit": "तस्मै ददुस्तथाऽस्त्राणि मन्त्राणि गुणवन्ति च ।\nततोऽब्रुवन्मुनिगणास्तं पृथुं कपिलेन च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000141012, "chapter_id": 20141, "verse_number": "१४१-१३", "content_sanskrit": "मुनय ऊचुः आहारं देहि जीवेभ्यो भुवा ग्रस्तौषधीरपि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000141013, "chapter_id": 20141, "verse_number": "१४१-१४", "content_sanskrit": "ब्रह्मोवाच ततः स धनुरादाय भुवमाह नृपोत्तमः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000141014, "chapter_id": 20141, "verse_number": "१४१-१५", "content_sanskrit": "पृथुरुवाच ओषधीर्देहि या ग्रस्ताः प्रजानां हितकाम्यया ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000141015, "chapter_id": 20141, "verse_number": "१४१-१६", "content_sanskrit": "ब्रह्मोवाच तमुवाच मही भीता पृथुं तं पृथुलोचनम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000141016, "chapter_id": 20141, "verse_number": "१४१-१७", "content_sanskrit": "मह्‌युवाच मयि जीर्णा महौषध्यः कथं दातुमहं क्षमा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000141017, "chapter_id": 20141, "verse_number": "१४१-१८", "content_sanskrit": "ब्रह्मोवाच ततः सकोपो नृपतिस्तामाह पृथिवीं पुनः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000141018, "chapter_id": 20141, "verse_number": "१४१-१९", "content_sanskrit": "पृथुरुवाच नो चेद्ददास्यद्य त्वां वै हत्वा दास्ये महौषधीः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000141019, "chapter_id": 20141, "verse_number": "१४१-२०", "content_sanskrit": "भूमिरुवाच कथं हंसि स्त्रियं राजञ्ज्ञानी भूत्वा नृपोत्तम ।\nविना मया कथं चेमाः प्रजाः संधारयिष्यसि ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000141020, "chapter_id": 20141, "verse_number": "१४१-२१", "content_sanskrit": "पृथुरुवाच यत्रोपकारोऽनेकानामेकनासे भविष्यति ।\nन दोषस्तत्र पृथिवी तपसा धारये प्रजाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000141021, "chapter_id": 20141, "verse_number": "१४१-२२", "content_sanskrit": "न दोषमत्र पश्यामि नाऽऽचक्षेऽनर्थकं वचः ।\nयस्मिन्निपातिते सौख्यं बहूनामुपजायते ।\nमुनयस्तद्वधं प्राहुरश्वमेधशताधिकम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000141022, "chapter_id": 20141, "verse_number": "१४१-२३", "content_sanskrit": "देवा ऊचुः ततो देवाश्च ऋषयः सान्त्वयित्वा नृपोत्तमम् ।\nमहीं च मातरं देवीमूचुः सुरगणास्तदा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000141023, "chapter_id": 20141, "verse_number": "१४१-२४", "content_sanskrit": "ब्रह्मोवाच भूमे गोरूपिणी भूत्वा पयोरूपा महौषधीः ।\nदेही त्वं पृथवे राज्ञे ततः प्रीतो भवेन्नृपः ।\nप्रजासंरक्षणं च स्यात्ततः क्षेमं भविष्यति ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000141024, "chapter_id": 20141, "verse_number": "१४१-२५", "content_sanskrit": "देवा ऊचुः ततो गोरूपमास्थाय भूम्यासीत्कपिलान्तिके ।\nदुदोह च महौषध्यो(धी)राजा वेनकरोद्भवः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000141025, "chapter_id": 20141, "verse_number": "१४१-२६", "content_sanskrit": "यत्र देवाः सगन्धर्वा ऋषयः कपिलो मुनिः ।\nमहीं गोरूपमापन्नां नर्मदायां महामुनेः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000141026, "chapter_id": 20141, "verse_number": "१४१-२७", "content_sanskrit": "सरस्वत्यां भागीरथ्यां गोदावर्यां विशेषतः ।\nमहानदीषु सर्वासु दुदुहेऽसौ पयो महत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000141027, "chapter_id": 20141, "verse_number": "१४१-२८", "content_sanskrit": "सा दुह्‌यमाना पृथुना पुण्यतोयाऽभवन्नदी ।\nगौतम्या संगता चाभूत्तदद्‌भुतमिवाभवत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000141028, "chapter_id": 20141, "verse_number": "१४१-२९", "content_sanskrit": "ततः प्रभृति तत्तीर्थं कपिलासंगमं विदुः ।\nतत्राष्टाशीतिः पूज्यानि सहस्राणि महामते ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000141029, "chapter_id": 20141, "verse_number": "१४१-३०", "content_sanskrit": "तीर्थान्याहुर्मुनिगणाः स्मरणादपि नारद ।\nपावनानि जगत्यस्मिंस्तानि सर्वाण्यनुक्रमात् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]