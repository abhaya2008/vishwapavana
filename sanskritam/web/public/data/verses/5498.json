[{"id": 2210250, "chapter_id": 5498, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2210251, "chapter_id": 5498, "verse_number": "१", "content_sanskrit": "पितामहस्य मे यज्ञे धर्मपुत्रस्य धीमतः ।\nयदाश्चर्यमभूत् किञ्चिद् तद्भवान् वक्तुमर्हति ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2210252, "chapter_id": 5498, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2210253, "chapter_id": 5498, "verse_number": "२", "content_sanskrit": "श्रूयतां राजशार्दूल महदाश्चर्यमुत्तमम् ।\nअश्वमेधे महायज्ञे निवृत्ते यदभूद् विभो ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2210254, "chapter_id": 5498, "verse_number": "३", "content_sanskrit": "तर्पितेषु द्विजाग्र्येषु ज्ञातिसम्बन्धिबन्धुषु ।\nदीनान्धकृपणे चाऽपि तदा भरतसत्तम ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2210255, "chapter_id": 5498, "verse_number": "४", "content_sanskrit": "घुष्यमाणे महानादे दिक्षु सर्वासु भारत ।\nपतत्सु पुष्पवर्षेषु धर्मराजस्य मूर्धनि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2210256, "chapter_id": 5498, "verse_number": "५", "content_sanskrit": "बिलान्निसृत्य नकुलो रुग्मपार्श्वस्तदा नृप ।\nवज्राशनिसमं नादममुञ्चत विशाम्पते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2210257, "chapter_id": 5498, "verse_number": "६", "content_sanskrit": "सकृदुत्सृज्य तं नादं त्रासयानो मृगद्विजान् ।\nमानुषं वचनं प्राह धृष्टो बिलशयो महान् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2210258, "chapter_id": 5498, "verse_number": "", "content_sanskrit": "नकुलः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2210259, "chapter_id": 5498, "verse_number": "७", "content_sanskrit": "सक्तुप्रस्थेन वो नायं यज्ञस्तुल्यो नराधिपाः ।\nउञ्छवृत्तेर्वदान्यस्य कुरुक्षेत्रनिवासिनः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2210260, "chapter_id": 5498, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2210261, "chapter_id": 5498, "verse_number": "८", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा नकुलस्य विशाम्पते ।\nविस्मयं परमं जग्मुः सर्वे ते ब्राह्मणर्षभाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2210262, "chapter_id": 5498, "verse_number": "९", "content_sanskrit": "ततः समेत्य नकुलं पर्यपृच्छत ते द्विजाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2210263, "chapter_id": 5498, "verse_number": "", "content_sanskrit": "द्विजाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2210264, "chapter_id": 5498, "verse_number": "१०", "content_sanskrit": "कुतस्त्वं समनुप्राप्तो यज्ञं साधुसमागमम् ।\nकिं बलं परमं ते ह किं श्रुतं किं परायणम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2210265, "chapter_id": 5498, "verse_number": "११", "content_sanskrit": "कथं भवन्तं विद्याम यो नो यज्ञं विगर्हते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2210266, "chapter_id": 5498, "verse_number": "१२", "content_sanskrit": "अविलुप्यागमं कृत्स्नं विविधैर्याकैर्हुतम् ।\nयथागमं यथान्यायं कर्तव्यं च तथा कृतम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2210267, "chapter_id": 5498, "verse_number": "१३", "content_sanskrit": "पूजार्हाः पूजिताश्चात्र विधिवज्ज्ञानचक्षुषः ।\nमन्त्रपूतं हुतश्चाग्निर्दत्तं देयममत्सरम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2210268, "chapter_id": 5498, "verse_number": "१४", "content_sanskrit": "तुष्टा द्विजर्षभाश्चात्र दानैर्बहुविधैरपि ।\nक्षत्रियाश्च सुयुद्धेन श्राद्धैरपि पितामहाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2210269, "chapter_id": 5498, "verse_number": "१५", "content_sanskrit": "पालनेन विशस्तुष्टाः कामैस्तुष्टा वरस्त्रियः ।\nअनुक्रोशैस्तथा शूद्रा दानैः शेषा पृथग् जनाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2210270, "chapter_id": 5498, "verse_number": "१६", "content_sanskrit": "ज्ञातिसम्बन्धिनस्तुष्टाः शौचेन च नृपस्य नः ।\nदेवा हविर्भिः पुण्यैश्च रक्षणैः शरणागताः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2210271, "chapter_id": 5498, "verse_number": "१७", "content_sanskrit": "यदत्र तथ्यं तद् ब्रूहि सत्यसन्ध द्विजातिषु ।\nयथाश्रुतं यथादृष्टं पृष्टो ब्राह्मणकाम्यया ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2210272, "chapter_id": 5498, "verse_number": "१८", "content_sanskrit": "श्रद्धेयवाक्यः प्राज्ञस्त्वं दिव्यरूपं बिभर्षि च ।\nसमागतश्च विप्रेस्त्वं तत्त्वतो वक्तुमर्हसि ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2210273, "chapter_id": 5498, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2210274, "chapter_id": 5498, "verse_number": "१९", "content_sanskrit": "एवं पृष्टो द्विजैस्तैः स प्रहस्य नकुलोऽब्रवीत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2210275, "chapter_id": 5498, "verse_number": "", "content_sanskrit": "नकुलः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2210276, "chapter_id": 5498, "verse_number": "२०", "content_sanskrit": "नैषा मृषा मया वाणी प्रोक्ता दर्पेण वा द्विजाः ।\nयन्मयोक्तमिदं किञ्चिद् युष्माभिश्चाप्युपश्रुतम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2210277, "chapter_id": 5498, "verse_number": "२१", "content_sanskrit": "सक्तुप्रस्थेन वो नायं यज्ञस्तुल्यो द्विजर्षभाः ।\nउञ्छवृत्तेर्वदान्यस्य कुरुक्षेत्रनिवासिनः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2210278, "chapter_id": 5498, "verse_number": "२२", "content_sanskrit": "यद्यवश्यं मयैवैतद् वक्तव्यं द्विजपुङ्गवाः ।\nश्रुणुताव्यग्रमनसस्तन्मे सर्वं द्विजर्षभाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2210279, "chapter_id": 5498, "verse_number": "२३", "content_sanskrit": "अनुभूतं च दृष्टं च यन्मयाऽद्भुतमुत्तमम् ।\nउञ्छवृत्तेर्यथा वृत्तं दानधर्मं च यादृशम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2210280, "chapter_id": 5498, "verse_number": "२४", "content_sanskrit": "स्वर्गं स्थानं च सम्प्राप्तः सभार्यः ससुतस्नुषः ।\nयथा चार्धं शरीरस्य ममेदं काञ्चनीकृतम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2210281, "chapter_id": 5498, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि नकुलशरीरदर्शनं नाम द्विनवतितमोऽध्यायः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]