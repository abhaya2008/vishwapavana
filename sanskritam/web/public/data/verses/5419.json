[{"id": 2207285, "chapter_id": 5419, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2207286, "chapter_id": 5419, "verse_number": "१", "content_sanskrit": "न बाह्यं द्रव्यमुत्सृज्य सिद्धिर्भवति भारत ।\nशारीरं द्रव्यमुत्सृज्य सिद्धिर्भवति वा न वा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2207287, "chapter_id": 5419, "verse_number": "२", "content_sanskrit": "बाह्यद्रव्यविमुक्तस्य शारीरेषु च गृध्यतः ।\nयो धर्मो यत्सुखं चैव द्विषतामस्तु तत् तव\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2207288, "chapter_id": 5419, "verse_number": "३", "content_sanskrit": "द्व्यक्षरस्तु भवेन्मृत्युः त्र्यक्षरं ब्रह्म शाश्वतम् ।\nममेति द्व्यक्षरो मृत्युः न ममेति च शाश्वतम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2207289, "chapter_id": 5419, "verse_number": "४", "content_sanskrit": "जन्ममृत्यू ततो राजन्नात्मन्येव व्यवस्थितौ ।\nअदृश्यमानौ भूतानि योधयेतामसंशयम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2207290, "chapter_id": 5419, "verse_number": "५", "content_sanskrit": "अविनाशोऽस्य तत्त्वस्य नियतो यदि भारत ।\nहत्वा शरीरं भूतानामहिंसा प्रतिपद्यते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2207291, "chapter_id": 5419, "verse_number": "६", "content_sanskrit": "लब्ध्वाऽपि पृथिवीं सर्वां सहस्थावरजङ्गमाम् ।\nममत्वं यस्य नैव स्यात् किं तया स करिष्यति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2207292, "chapter_id": 5419, "verse_number": "७", "content_sanskrit": "अथवा वसतः पार्थ वने वन्येन जीवतः ।\nममता यस्य वित्तेषु मृत्योरास्ये स वर्तते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2207293, "chapter_id": 5419, "verse_number": "८", "content_sanskrit": "बाह्यान्तराणां शत्रूणां स्वभावं पश्य भारत ।\nयोऽनुपश्यति तद्भूतं मुच्यते स महाभयात्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2207294, "chapter_id": 5419, "verse_number": "९", "content_sanskrit": "कामात्मानं न प्रशंसन्ति सर्वे\nन चाकामात् काचिदस्ति प्रवृत्तिः ।\nदानं हि वेदाध्ययनं तपश्च\nकामेन कर्माणि च वैदिकानि\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2207295, "chapter_id": 5419, "verse_number": "१०", "content_sanskrit": "व्रतं यज्ञान् नियमान् ध्यानयोगान्\nकामेन यो नारभते विदित्वा ।\nयदव्ययं कामयते स धर्मो\nयोऽयं धर्मो नियमस्तस्य मूलम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2207296, "chapter_id": 5419, "verse_number": "११", "content_sanskrit": "अत्र गाथाः कामगीताः कीर्तयन्ति पुराविदः ।\nशृणु सङ्कीर्त्यमानास्ता निखिलेन नराधिप\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2207297, "chapter_id": 5419, "verse_number": "", "content_sanskrit": "कामः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2207298, "chapter_id": 5419, "verse_number": "१२", "content_sanskrit": "नाहं शक्योऽनुपायेन हन्तुं भूतेन केनचित्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2207299, "chapter_id": 5419, "verse_number": "१३", "content_sanskrit": "यो मां प्रयतते हन्तुं ज्ञात्वा प्रहरणे बलम् ।\nतस्य तस्मिन् प्रहरणे पुनः प्रादुर्भवाम्यहम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2207300, "chapter_id": 5419, "verse_number": "१४", "content_sanskrit": "यो मां प्रयतते हन्तुं यज्ञैर्विविधदक्षिणैः ।\nजङ्गमेष्विव कर्मात्मा पुनः प्रादुर्भवाम्यहम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2207301, "chapter_id": 5419, "verse_number": "१५", "content_sanskrit": "यो मां प्रयतते हन्तुं वेदैर्वेद्यं न साधकैः ।\nस्थावरेष्विव शान्तात्मा पुनः प्रादुर्भवाम्यहम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2207302, "chapter_id": 5419, "verse_number": "१६", "content_sanskrit": "यो मां प्रयतते हन्तुं धृत्या सत्यपराक्रमः ।\nभावो भवामि तस्याहं स च मां नावबुद्ध्यते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2207303, "chapter_id": 5419, "verse_number": "१७", "content_sanskrit": "यो मां प्रयतते हन्तुं तपसा संशितव्रतः ।\nततस्तपसि तस्याथ पुनः प्रादुर्भवाम्यहम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2207304, "chapter_id": 5419, "verse_number": "१८", "content_sanskrit": "यो मां प्रयतते हन्तुं मोक्षमास्थाय पण्डितः ।\nतस्य मोक्षमतिस्थस्य नृत्यामि च हसामि च\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2207305, "chapter_id": 5419, "verse_number": "१९", "content_sanskrit": "अवध्यः सर्वभूतानामहमेकः सनातनः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2207306, "chapter_id": 5419, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2207307, "chapter_id": 5419, "verse_number": "२०", "content_sanskrit": "तस्मात् त्वमपि तं कामं यज्ञैर्विविधदक्षिणैः ।\nधर्मे कुरु महाराज तत्र ते न भविष्यति\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2207308, "chapter_id": 5419, "verse_number": "२१", "content_sanskrit": "यजस्व वाजिमेधेन विधिवद् दक्षिणावता ।\nअन्यैश्च विविधैर्यज्ञैः समृद्धैराप्तदक्षिणैः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2207309, "chapter_id": 5419, "verse_number": "२२", "content_sanskrit": "मा ते व्यथा भून्निहतान् बन्धून् वीक्ष्य पुनः पुनः ।\nन शक्यास्ते पुनर्द्रष्टुं हता येऽस्मिन् रणाजिरे\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2207310, "chapter_id": 5419, "verse_number": "२३", "content_sanskrit": "स त्वमिष्ट्वा महायज्ञैः समृद्धैराप्तदक्षिणैः ।\nलोके कीर्तिं परां प्राप्य गतिमग्र्यां गमिष्यसि\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2207311, "chapter_id": 5419, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि कामविचारो नाम त्रयोदशोऽध्यायः ॥१३॥\nअश्वमेधपर्वणि त्रयोदशोऽध्यायः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]