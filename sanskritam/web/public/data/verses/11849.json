[{"id": 50024323, "chapter_id": 11849, "verse_number": "1", "content_sanskrit": "॥ मेधातिथिः काण्वः। अग्निः। १-३ ब्रह्मणस्पतिः, ४ - इन्द्रसोमब्रह्मणस्पतयः, ५ - इन्द्रसोमब्रह्मणस्पतयो दक्षिणा च, ६-८ - सदसस्पतिः, ९ - सदसस्पतिर्नराशंसो वा। गायत्री॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024324, "chapter_id": 11849, "verse_number": "2", "content_sanskrit": "सो॒मानं॒ स्वर॑णं कृणु॒हि ब्र॑ह्मणस्पते। क॒क्षीव॑न्तं॒ य औ॑शि॒जः॥ १८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024325, "chapter_id": 11849, "verse_number": "3", "content_sanskrit": "यो रे॒वान्यो अ॑मीव॒हा व॑सु॒वित्पु॑ष्टि॒वर्ध॑नः। स न॑ः सिषक्तु॒ यस्तु॒रः॥ १८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024326, "chapter_id": 11849, "verse_number": "4", "content_sanskrit": "मा न॒ः शंसो॒ अर॑रुषो धू॒र्तिः प्रण॒ङ्मर्त्य॑स्य। रक्षा॑ णो ब्रह्मणस्पते॥ १८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024327, "chapter_id": 11849, "verse_number": "5", "content_sanskrit": "स घा॑ वी॒रो न रि॑ष्यति॒ यमिन्द्रो॒ ब्रह्म॑ण॒स्पति॑ः। सोमो॑ हि॒नोति॒ मर्त्य॑म्॥ १८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024328, "chapter_id": 11849, "verse_number": "6", "content_sanskrit": "त्वं तं ब्र॑ह्मणस्पते॒ सोम॒ इन्द्र॑श्च॒ मर्त्य॑म्। दक्षि॑णा पा॒त्वंह॑सः॥ १८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024329, "chapter_id": 11849, "verse_number": "7", "content_sanskrit": "सद॑स॒स्पति॒मद्भु॑तं प्रि॒यमिन्द्र॑स्य॒ काम्य॑म्। स॒निं मे॒धाम॑यासिषम्॥ १८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024330, "chapter_id": 11849, "verse_number": "8", "content_sanskrit": "यस्मा॑दृ॒ते न सिध्य॑ति य॒ज्ञो वि॑प॒श्चित॑श्च॒न। स धी॒नां योग॑मिन्वति॥१८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50024331, "chapter_id": 11849, "verse_number": "9", "content_sanskrit": "आदृ॑ध्नोति ह॒विष्कृ॑तिं॒ प्राञ्चं॑ कृणोत्यध्व॒रम्। होत्रा॑ दे॒वेषु॑ गच्छति॥ १८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50024332, "chapter_id": 11849, "verse_number": "10", "content_sanskrit": "नरा॒शंसं॑ सु॒धृष्ट॑म॒मप॑श्यं स॒प्रथ॑स्तमम्। दि॒वो न सद्म॑मखसम्॥ १८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]