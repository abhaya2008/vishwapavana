[{"id": 2065422, "chapter_id": 2384, "verse_number": "९-२-०x", "content_sanskrit": "[सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2065423, "chapter_id": 2384, "verse_number": "९-२-१", "content_sanskrit": "शृणु राजन्नवहितो यथावृत्तो महान्क्षयः।\nकुरूणां पाण्डवानां च समासाद्य परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2065424, "chapter_id": 2384, "verse_number": "९-२-२", "content_sanskrit": "निहते सूतपुत्रे तु पाण्डवेन महात्मना।\nविद्रुतेषु च सैन्येषु समानीतेषु चासकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2065425, "chapter_id": 2384, "verse_number": "९-२-३", "content_sanskrit": "घोरे मनुष्यदेहानामाजौ नरवरक्षये।\nयत्तत्कर्णे हते पार्थः कसिंहनादमथाकरोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2065426, "chapter_id": 2384, "verse_number": "९-२-४", "content_sanskrit": "तदा तव सुतान्राजन्प्राविशत्सुमहद्भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2065427, "chapter_id": 2384, "verse_number": "९-२-५", "content_sanskrit": "न सन्धातुमनीकानि न चैवाथ पराक्रमे।\nआसीद्बुद्धिर्हते कर्णे तव योधस्य कस्यचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2065428, "chapter_id": 2384, "verse_number": "९-२-६", "content_sanskrit": "वणिजो नावि भिन्नायामगाधे विप्लुवा इव।\nअपारे पारमिच्छन्तो हते द्वीपे किरीटिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2065429, "chapter_id": 2384, "verse_number": "९-२-७", "content_sanskrit": "सूतपुत्रो हते राजन्वित्रस्ताः शरविक्षताः।\nअनाथा नाथमिच्छन्तो मृगाः सिंहार्दिता इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2065430, "chapter_id": 2384, "verse_number": "९-२-८", "content_sanskrit": "भग्नशृङ्गा इव वृषा शीर्णदंष्ट्रा इवोरगाः।\nप्रत्युपायाम सायाह्ने निर्जिताः सव्यसाचिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2065431, "chapter_id": 2384, "verse_number": "९-२-९", "content_sanskrit": "हतप्रवीरा विध्वस्ता निकृत्ता निशितैः शरैः।\nसूतपुत्रे हते राजन्पुत्रास्ते प्राद्रवंस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2065432, "chapter_id": 2384, "verse_number": "९-२-१०", "content_sanskrit": "विध्वस्तकवचनाः सर्वे कान्दिशीका विचेतसः।\nअन्योन्यमभिनिघ्नन्तो वीक्षमाणा भयाद्दिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2065433, "chapter_id": 2384, "verse_number": "९-२-११", "content_sanskrit": "मामेव नूनं बीभत्सुर्मामेव च वृकोदरः।\nअभियातीति मन्वानाः पेतुर्मम्लुश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2065434, "chapter_id": 2384, "verse_number": "९-२-१२", "content_sanskrit": "अश्वानन्ये गजानन्ये रथानन्ये महारथाः।\nआरुह्य जवसम्पन्नाः पादातान्प्रजहुर्भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2065435, "chapter_id": 2384, "verse_number": "९-२-१३", "content_sanskrit": "कुञ्जरैः स्यन्दना भग्नाः सादिनश्च महारथैः।\nपदातिसङ्घाश्चाश्वौघैः पलायद्भिर्भृशं हताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2065436, "chapter_id": 2384, "verse_number": "९-२-१४", "content_sanskrit": "व्यालतस्करसङ्कीर्णे सार्थहीना यथा वने।\nतथा त्वदीया निहते सूतपुत्रे पदाऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2065437, "chapter_id": 2384, "verse_number": "९-२-१५", "content_sanskrit": "हतारोहास्तथा नागाश्छिन्नहस्तास्तथाऽपरे।\nसर्वं पार्थमयं लोकमपश्यन्वै भयार्दिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2065438, "chapter_id": 2384, "verse_number": "९-२-१६", "content_sanskrit": "तान्प्रेक्ष्य द्रवतः सर्वान्भीमसेनभयार्दितान्।\nदुर्योधनोऽथ स्वं सूतं हाहाकृत्वैवमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2065439, "chapter_id": 2384, "verse_number": "९-२-१७", "content_sanskrit": "नातिक्रमिष्यते पार्थो धनुष्पाणिमवस्थितम्।\nजघने युध्यमानं मां तूर्णमश्वान्प्रचोदय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2065440, "chapter_id": 2384, "verse_number": "९-२-१८", "content_sanskrit": "समरे युध्यमानं हि कौन्तेयो मां धनञ्जयः।\nनोत्सहेताप्यतिक्रान्तुं वेलामिव महार्णवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2065441, "chapter_id": 2384, "verse_number": "९-२-१९", "content_sanskrit": "अद्यार्जुनं सगोविन्दं मानिनं च वृकोदरम्।\nनिहत्य शिष्टाञ्शत्रूंश्च कर्णस्यानृण्यमाप्नुयाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2065442, "chapter_id": 2384, "verse_number": "९-२-२०", "content_sanskrit": "तच्छ्रुत्वा कुरुराजस्य शूरार्यसदृशं वचः।\nसूतो हेमपरिच्छन्नाञ्शनैरश्वानचोदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2065443, "chapter_id": 2384, "verse_number": "९-२-२१", "content_sanskrit": "गजाश्वरथहीनास्तु पादाताश्चैव मारिष।\nपञ्चविंशतिसाहस्राः प्राद्रवञ्शनकैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2065444, "chapter_id": 2384, "verse_number": "९-२-२२", "content_sanskrit": "तान्भीमसेनः सङ्क्रुद्धो धृष्टद्युम्नश्च पार्षतः।\nबलेन चतुरङ्गेण परिक्षिप्याहनच्छरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2065445, "chapter_id": 2384, "verse_number": "९-२-२३", "content_sanskrit": "प्रत्ययुध्यंस्तु ते सर्वे भीमसेनं सपार्षतम्।\nपार्थपार्षतयोश्चान्ये जगृहुस्तत्र नामनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2065446, "chapter_id": 2384, "verse_number": "९-२-२४", "content_sanskrit": "अक्रुध्यत रणे भीमस्तैर्मृधे प्रत्यवस्थितैः।\nसोऽवतीर्य रथात्तूर्णं गदापाणिरयुध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2065447, "chapter_id": 2384, "verse_number": "९-२-२५", "content_sanskrit": "न तान्रथस्थो भूमिष्ठान्धर्मापेक्षी वृकोदरः।\nयोधयामास कौन्तेयो भुजवीर्यमुपाश्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2065448, "chapter_id": 2384, "verse_number": "९-२-२६", "content_sanskrit": "जातरूपपरिच्छन्नां प्रगृह्य महतीं गदाम्।\nन्यवधीत्तावकान्सर्वान्दण्डपाणिरिवान्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2065449, "chapter_id": 2384, "verse_number": "९-२-२७", "content_sanskrit": "पदातयो हि संरब्धास्त्यक्तजीवितबान्धवाः।\nभीममभ्यद्रवन्सङ्ख्ये पतङ्गा इव पावकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2065450, "chapter_id": 2384, "verse_number": "९-२-२८", "content_sanskrit": "आसाद्य भीमसेनं ते संरब्धा युद्धदुर्मदाः।\nविनेदुः सहसा दृष्ट्वा भूतग्रामा इवान्तकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2065451, "chapter_id": 2384, "verse_number": "९-२-२९", "content_sanskrit": "श्येनवद्व्यचरद्भीमः खङ्गेन गदया तथा।\nपञ्चविंशतिसाहस्रांस्तावकानां व्यपोथयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2065452, "chapter_id": 2384, "verse_number": "९-२-३०", "content_sanskrit": "हत्वा तत्पुरुषानीकं भीमः सत्यपराक्रमः।\nधृष्टद्युम्नं पुरस्कृत्य पुनस्तस्थौ महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2065453, "chapter_id": 2384, "verse_number": "९-२-३१", "content_sanskrit": "धनञ्जयो रथानीकमन्वपद्यत वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2065454, "chapter_id": 2384, "verse_number": "९-२-३२", "content_sanskrit": "माद्रीपुत्रौ च शकुनिं सात्यकिश्च महाबलः।\nजवेनाभ्यपतन्हृष्टा घ्नन्तो दौर्योधनं बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2065455, "chapter_id": 2384, "verse_number": "९-२-३३", "content_sanskrit": "तस्याश्ववाहान्सुबहूंस्ते निहत्य शितैः शरैः।\nतमन्वधावंस्त्वरितास्तत्र युद्धमवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2065456, "chapter_id": 2384, "verse_number": "९-२-३४", "content_sanskrit": "ततो धनञ्जयो राजन्रथानीकमगाहत।\nविश्रुतं त्रिषु लोकेषु गाण्डीवं व्याक्षिपन्धनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2065457, "chapter_id": 2384, "verse_number": "९-२-३५", "content_sanskrit": "कृष्णसारथिमायान्तं दृष्ट्वा श्वेतहयं रथम्।\nअर्जुनं चापि योद्वारं त्वदीयाः प्राद्रावन्भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2065458, "chapter_id": 2384, "verse_number": "९-२-३६", "content_sanskrit": "विप्रहीनरथाश्वाश्च शरैश्च परिवारिताः।\nपञ्चविंशतिसाहस्राः पार्थमार्च्छन्पदातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2065459, "chapter_id": 2384, "verse_number": "९-२-३७", "content_sanskrit": "हत्वा तत्पुरुषानीकं पाञ्चालानां महारथः।\nभीमसेनं पुरस्कृत्य न चिरात्प्रत्यदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2065460, "chapter_id": 2384, "verse_number": "९-२-३८", "content_sanskrit": "महाधनुर्धरः श्रीमानमित्रगणमर्दनः।\nपुत्रः पाञ्चालराजस्य धृष्टद्युम्नो महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2065461, "chapter_id": 2384, "verse_number": "९-२-३९", "content_sanskrit": "पारावतसवर्णाश्वं कोविदारवरध्वजम्।\nधृष्टद्युम्नं रणे दृष्ट्वा त्वदीयाः प्राद्रवन्भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2065462, "chapter_id": 2384, "verse_number": "९-२-४०", "content_sanskrit": "गान्धारराजं श्रीघ्रास्त्रमनुसृत्य यशस्विनौ।\nअचिरात्प्रत्यदृश्येतां माद्रीपुत्रौ ससात्यकी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2065463, "chapter_id": 2384, "verse_number": "९-२-४१", "content_sanskrit": "चेकितानः शिखण्डी च द्रौपदेयाश्च मारिष।\nहत्वा त्वदीयं सुमहत्सैन्यं शङ्खानथाधमन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2065464, "chapter_id": 2384, "verse_number": "९-२-४२", "content_sanskrit": "ते सर्वे तावकान्प्रेक्ष्य द्रवतो वै पराङ्मुखान्।\nअभ्यधावन्त निघ्नन्तो वृषाञ्चित्वा वृषा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2065465, "chapter_id": 2384, "verse_number": "९-२-४३", "content_sanskrit": "सेनावशेषं तं दृष्ट्वा तव पुत्रस्य पाण्डवः।\nअवस्थितं सव्यसाची चुक्रोध बलवन्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2065466, "chapter_id": 2384, "verse_number": "९-२-४४", "content_sanskrit": "तत एनं शरै राजन्सहसा समवाकिरत्।\nरजसा चोद्गतेनाथ न स्म किञ्चन दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2065467, "chapter_id": 2384, "verse_number": "९-२-४५", "content_sanskrit": "अन्धकारीकृते लोके शरीभूते महीतले।\nदिशः सर्वा महाराज तावकाः प्राद्रवन्भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2065468, "chapter_id": 2384, "verse_number": "९-२-४६", "content_sanskrit": "भज्यमानेषु सर्वेषु कुरुराजो विशाम्पते।\nपरेषामात्मनश्चैव सैन्ये ते समुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2065469, "chapter_id": 2384, "verse_number": "९-२-४७", "content_sanskrit": "ततो दुर्योधनः सर्वानाजुहावाथ पाण्डवान्।\nयुद्धाय भरतश्रेष्ठ देवानिव पुरा बलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2065470, "chapter_id": 2384, "verse_number": "९-२-४८", "content_sanskrit": "त एनमभिगर्जन्तं सहिताः समुपाद्रवन्।\nनानाशस्त्रसृजः क्रुद्धा भर्त्सयन्तो मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2065471, "chapter_id": 2384, "verse_number": "९-२-४९", "content_sanskrit": "दुर्योधनोऽप्यसम्भ्रान्तस्तानरीन्व्यधमच्छरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2065472, "chapter_id": 2384, "verse_number": "९-२-५०", "content_sanskrit": "तत्राद्भुतमपरश्याम तव पुत्रस्य पौरुषम्।\nयदेनं पाण्डवाः सर्वे न शेकुरतिवर्तितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2065473, "chapter_id": 2384, "verse_number": "९-२-५१", "content_sanskrit": "नातिदूरापयातं च कृतबुद्धि पलायने।\nदुर्योधनः स्वकं सैन्यमपश्यकद्भृशविक्षतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2065474, "chapter_id": 2384, "verse_number": "९-२-५२", "content_sanskrit": "ततोऽवस्थाप्य राजेन्द्र कृतबुद्धिस्तवात्मजः।\nहर्षयन्निव तान्योधांस्ततो वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2065475, "chapter_id": 2384, "verse_number": "९-२-५३", "content_sanskrit": "न तं देशं प्रपश्यामि पृथिव्यां पर्वतेषु च।\nयत्र यातान्न वो हन्युः पाण्डवाः किं सृतेन वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2065476, "chapter_id": 2384, "verse_number": "९-२-५४", "content_sanskrit": "स्वल्पं चैव बलं तेषां कृष्णौ च भृशविक्षतौ।\nयदि सर्वेऽपि तिष्ठामो ध्रुवं नो विजयो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2065477, "chapter_id": 2384, "verse_number": "९-२-५५", "content_sanskrit": "विप्लयातांस्तु वो भिन्नान्पाण्डवाः कृतकिल्पिषान्।\nअनुसृत्य हनिष्यन्ति श्रेयोः न समरे वधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2065478, "chapter_id": 2384, "verse_number": "९-२-५६", "content_sanskrit": "सुखः साङ्ग्रामिको मृत्युः क्षत्रधर्मेण युध्यताम्।\nमृतो दुःखं न जानीते प्रेत्य चानन्त्यमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2065479, "chapter_id": 2384, "verse_number": "९-२-५७", "content_sanskrit": "शृण्वन्तु क्षत्रियाः सर्वे यावन्तोऽत्र समागताः।\nद्विषतो भीमसेनस्य वशमेष्यथ विद्रुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2065480, "chapter_id": 2384, "verse_number": "९-२-५८", "content_sanskrit": "पितामहैराचरितं न धर्मं हातुमर्हथ।\nनान्यत्कर्मास्ति पापीयः क्षत्रियस्य पलायनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2065481, "chapter_id": 2384, "verse_number": "९-२-५९", "content_sanskrit": "न युद्वधर्माच्छ्रेयान्हि पन्थाः स्वर्गस्य कौरवाः।\nसुचिरेणार्जिताँलोकान्सद्यो युद्धात्समश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2065482, "chapter_id": 2384, "verse_number": "९-२-६०", "content_sanskrit": "तस्य तद्वचनं राज्ञः पूजयित्वा महारथाः।\nपुनरेवाभ्यवर्तन्त क्षत्रियाः पाण्डवान्प्रति।\nपराजयममृष्यन्त कृतचित्ताश्च विक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2065483, "chapter_id": 2384, "verse_number": "९-२-६१", "content_sanskrit": "ततः प्रववृते युद्धं पुनरेव सुदारुणम्।\nतावकानां परेषां च देवासुररणोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2065484, "chapter_id": 2384, "verse_number": "९-२-६२", "content_sanskrit": "युधिष्ठिरपुरोगांश्च सर्वसैन्येन पाण्डवान्।\nअन्वधावन्महाराज पुत्रो दुर्योधनस्तव॥] ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2065485, "chapter_id": 2384, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि शल्यवधपर्वणि अध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]