[{"id": 2050931, "chapter_id": 2118, "verse_number": "७-४५-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2050932, "chapter_id": 2118, "verse_number": "७-४५-१", "content_sanskrit": "आददानस्तु शूराणामायुंष्यभवदार्जुनिः।\nअन्तकः सर्वभूतानां प्राणान्काल इवागते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2050933, "chapter_id": 2118, "verse_number": "७-४५-२", "content_sanskrit": "स शक्र इव विक्रान्तः शक्रसूनोः सुतो बली।\nअभिमन्युस्तदानीकं लोडयन्समदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2050934, "chapter_id": 2118, "verse_number": "७-४५-३", "content_sanskrit": "प्रविश्यैव तु राजेन्द्र क्षत्रियेन्द्रान्तकोपमः।\nसत्यश्रवसमादत्त व्याघ्रो मृगमिवोल्बणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2050935, "chapter_id": 2118, "verse_number": "७-४५-४", "content_sanskrit": "सत्यश्रवसि चाक्षिप्ते त्वरमाणा महारथाः।\nप्रगृह्य विपुलं शस्त्रमभिमन्युमुपाद्रवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2050936, "chapter_id": 2118, "verse_number": "७-४५-५", "content_sanskrit": "अहंपूर्वमहंपूर्वमिति क्षत्रियपुङ्गवाः।\nस्पर्धमानाः समाजग्मुर्जिघांसन्तोऽर्जुनात्मजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2050937, "chapter_id": 2118, "verse_number": "७-४५-६", "content_sanskrit": "क्षत्रियाणामनीकानि प्रद्रुतान्यभिधावताम्।\nजग्राह तिमिरासाद्य क्षुद्रमत्स्यानिवार्णिवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2050938, "chapter_id": 2118, "verse_number": "७-४५-७", "content_sanskrit": "ये केचन गतास्तस्य समीपमपलायिनः।\nन ते प्रतिन्यवर्तन्त समुद्रादिव सिन्धवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2050939, "chapter_id": 2118, "verse_number": "७-४५-८", "content_sanskrit": "महाग्रहगृहीतेव वातवेगभयार्दिता।\nसमकम्पत सा सेना विभ्रष्टा नौरिवार्णवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2050940, "chapter_id": 2118, "verse_number": "७-४५-९", "content_sanskrit": "अथ रुक्मरथो नाम मद्रेश्वरसुतो बली।\nत्रस्तामाश्वासयन्सेनामत्रस्तो वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2050941, "chapter_id": 2118, "verse_number": "७-४५-१०", "content_sanskrit": "अलं त्रासेन वः शूरा नैष कश्चिन्मयि स्थिते।\nअहमेनं ग्रीहष्यामि जीवग्राहं न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2050942, "chapter_id": 2118, "verse_number": "७-४५-११", "content_sanskrit": "एवमुक्त्वा तु सौभद्रमभिदुद्राव वीर्यवान्।\nसुकल्पितेनोह्यमानः स्यन्दनेन विराजता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2050943, "chapter_id": 2118, "verse_number": "७-४५-१२", "content_sanskrit": "सोऽभिमन्युं त्रिभिर्बाणैर्विद्ध्वा वक्षस्यथानदत्।\nत्रिभिश्च दक्षिणे बाहौ सव्ये च निशितैस्त्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2050944, "chapter_id": 2118, "verse_number": "७-४५-१३", "content_sanskrit": "स तस्येष्वसनं छित्त्वा फाल्गुनिः सव्यदक्षिणौ।\nभुजौ शिरश्च स्वक्षिभ्रु क्षितौ क्षिप्रमपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2050945, "chapter_id": 2118, "verse_number": "७-४५-१४", "content_sanskrit": "दृष्ट्वा रुक्मरथं रुग्णं पुत्रं शल्यस्य मानिनम्।\nजीवग्राहं जिघृक्षन्तं सौभद्रेण यशस्विना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2050946, "chapter_id": 2118, "verse_number": "७-४५-१५", "content_sanskrit": "सङ्ग्रामदुर्मदा राजन्राजपुत्राः प्रहारिणः।\nवयस्याः शल्यपुत्रस्य सुवर्णविकृतध्वजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2050947, "chapter_id": 2118, "verse_number": "७-४५-१६", "content_sanskrit": "तालमात्राणि चापानि विकर्षन्तो महाबलाः।\nआर्जुनिं शरवर्षेण समन्तात्पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2050948, "chapter_id": 2118, "verse_number": "७-४५-१७", "content_sanskrit": "शूरैः निक्षाबलोपेतैस्तरुणैरत्यमर्षणैः।\nदृष्ट्वैकं समरे शूरं सौभद्रमपराजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2050949, "chapter_id": 2118, "verse_number": "७-४५-१८", "content_sanskrit": "छाद्यमानं शरव्रातैर्हृष्टो दुर्योधनोऽभवत्।\nवैवस्वतस्य भवनं गतं ह्येममन्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2050950, "chapter_id": 2118, "verse_number": "७-४५-१९", "content_sanskrit": "सुवर्णपुङ्खैरिषुभिर्नानालिङ्गैः सुतेजनैः।\nअदृश्यमार्जुनिं चक्रुर्निमेषात्ते नृपात्मजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2050951, "chapter_id": 2118, "verse_number": "७-४५-२०", "content_sanskrit": "ससूताश्वध्वजं तस्य स्यन्दनं तं च मारिष।\nआचितं समपश्याम श्वाविधं शललैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2050952, "chapter_id": 2118, "verse_number": "७-४५-२१", "content_sanskrit": "स गाढविद्धः क्रुद्धश्च तोत्रैर्गज इवार्दितः।\nगान्धर्वमस्त्रमायच्छद्रथमायां च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2050953, "chapter_id": 2118, "verse_number": "७-४५-२२", "content_sanskrit": "अर्जुनो तपस्तप्त्वा गन्धर्वेभ्यो यदाहृतम्।\nतुम्बुरुप्रमुखेभ्यो वै तेनामोहयताहितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2050954, "chapter_id": 2118, "verse_number": "७-४५-२३", "content_sanskrit": "एकधा शतधा राजन्दृश्यते स्म सहस्रधा।\nअलातचक्रवत्सङ्ख्ये क्षिप्रमस्त्राणि दर्शयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2050955, "chapter_id": 2118, "verse_number": "७-४५-२४", "content_sanskrit": "रथचर्यास्त्रमायाभिर्मोहयित्वा परन्तपः।\nबिभेद शतधा राजञ्शरीराणि महीक्षिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2050956, "chapter_id": 2118, "verse_number": "७-४५-२५", "content_sanskrit": "प्राणाः प्राणभृतां सङ्ख्ये प्रेषिता निशितैः शरैः।\nराजन्प्रापुरसुं लोकं शरीराण्यवनिं ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2050957, "chapter_id": 2118, "verse_number": "७-४५-२६", "content_sanskrit": "धनूंष्यश्वान्नियन्तॄंश्च ध्वजान्बाहूंश्च साङ्गदान्।\nसिरांसि च शितैर्बाणैस्तेषां चिच्छेद फाल्गुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2050958, "chapter_id": 2118, "verse_number": "७-४५-२७", "content_sanskrit": "चूतारामो यथा भग्नः पञ्चवर्षः फलोपगः।\nराजपुत्रशतं तद्वत्सौभद्रेण निपातितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2050959, "chapter_id": 2118, "verse_number": "७-४५-२८", "content_sanskrit": "क्रुद्धाशीविषसङ्काशान्सुकुमारान्सुखोचितान्।\nएकेन निहतान्दृष्ट्वा भीतो दुर्योधनोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2050960, "chapter_id": 2118, "verse_number": "७-४५-२९", "content_sanskrit": "रथिनः कुञ्जरानश्वान्पदातींश्चावमर्दितान्।\nदृष्ट्वा दुर्योधनः क्षिप्रमुपायात्तममर्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2050961, "chapter_id": 2118, "verse_number": "७-४५-३०", "content_sanskrit": "तयोः क्षणमिवापूर्वः सङ्ग्रामः समपद्यत।\nअथाभवत्ते विमुखः पुत्रः शरशताहतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2050962, "chapter_id": 2118, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि अभिमन्युवधपर्वणि त्रयोदशदिसयुद्धे पञ्चत्वारिंशोऽध्यायः॥ ४५ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-४५- आयच्छत्प्रयुक्तवान्। रथमायां दुर्लक्ष्यां रथशिक्षाम्॥ ५-४५- फलोपगः फलोन्मुखः॥ ५-४५- पञ्चचत्वारिंशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]