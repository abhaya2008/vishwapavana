[{"id": 7005660000, "chapter_id": 25660, "verse_number": "१३३-१", "content_sanskrit": "देवेभ्यो महादेवस्य वरदानम् ।\nसूत उवाच ।\nब्रह्माद्यैस्तूयमानस्तु देर्वैर्देवो महेश्वरः ।\nप्रजापतिमुवाचेदं देवानां क्व भयं महत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005660001, "chapter_id": 25660, "verse_number": "१३३-२", "content_sanskrit": "भो देवः! स्वागतं वोऽस्तु ब्रूत यद्वो मनोगतम् ।\nतावदेव प्रयच्छामि नास्त्यदेयं मया हि वः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005660002, "chapter_id": 25660, "verse_number": "१३३-३", "content_sanskrit": "युष्माकं नितरां शं वै कर्ताऽहं विबुधर्षभाः ।\nचरामि महदत्युग्रं यच्चापि परमं तपः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005660003, "chapter_id": 25660, "verse_number": "१३३-४", "content_sanskrit": "विद्विष्टा वो मम द्विष्टाः कष्टाः कष्टपराक्रमाः ।\nतेषामभावः सम्पाद्यो युस्माकं भव एव च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005660004, "chapter_id": 25660, "verse_number": "१३३-५", "content_sanskrit": "एवमुक्तास्तु देवेन प्रेम्णा सब्रह्मकाः सुराः ।\nरुद्रमाहुर्महाभागं भागार्हाः सर्व एव ते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005660005, "chapter_id": 25660, "verse_number": "१३३-६", "content_sanskrit": "भगवंस्तैस्तपस्तप्तं रौद्रं रौद्रपराक्रमैः ।\nअसुरैर्वध्यमानाः स्म वयं त्वां शरणं गताः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005660006, "chapter_id": 25660, "verse_number": "१३३-७", "content_sanskrit": "मयो नाम दितेः पुत्रस्त्रिनेत्रकलहप्रियः ।\nत्रिपुरं येन तद्दुर्गं कृतं पाण्डुरगोपुरम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005660007, "chapter_id": 25660, "verse_number": "१३३-८", "content_sanskrit": "तदाश्रित्य पुरं दुर्गं दानवा वरनिर्भयाः ।\nबाधन्तेऽस्मान् महादेव प्रेष्यमस्वामिनं यथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005660008, "chapter_id": 25660, "verse_number": "१३३-९", "content_sanskrit": "उद्यानानि च भग्नानि नन्दनादीनि यानि च ।\nवराश्चाप्सरसः सर्वा रम्भाद्या दनुजैर्हृताः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005660009, "chapter_id": 25660, "verse_number": "१३३-१०", "content_sanskrit": "इन्द्रस्य बाह्याश्च गजाः कुमुदाञ्जनवामनाः ।\nऐरावताद्यापहृता देवतानां महेश्वर! ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005660010, "chapter_id": 25660, "verse_number": "१३३-११", "content_sanskrit": "ये चेन्द्ररथमुख्याश्च हरयोऽपहृतासुरैः ।\nजाताश्च दानवानान्ते रथयोग्यास्तुरङ्गमाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005660011, "chapter_id": 25660, "verse_number": "१३३-१२", "content_sanskrit": "ये रथा ये गजाश्चैव याः स्त्रियो वसु यच्च न ।\nतन्नो व्यपहृतं दैत्यैः संशयो जीविते पुनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005660012, "chapter_id": 25660, "verse_number": "१३३-१३", "content_sanskrit": "त्रिनेत्र एव मुक्तस्तु देवैः शक्रपुरोगमैः ।\nउवाच देवान् देवेशो वरदो वृषवाहनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005660013, "chapter_id": 25660, "verse_number": "१३३-१४", "content_sanskrit": "व्यपगच्छतु वो देवा महद्दानवजम्भयम् ।\nतदहं त्रिपुरन्धक्ष्ये क्रियतां यद्ब्रवीमि तत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005660014, "chapter_id": 25660, "verse_number": "१३३-१५", "content_sanskrit": "यदीच्छथ मया दग्धुं तत्पुरं सह दानवम् ।\nरथमौपयिकं मह्यं सज्जयध्वं किलास्यते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005660015, "chapter_id": 25660, "verse_number": "१३३-१६", "content_sanskrit": "दिग्वाससा तथोक्तास्ते सपितामहकाः सुराः ।\nतथेत्युक्त्वा महादेवञ्चक्रुस्ते रथमुत्तमम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005660016, "chapter_id": 25660, "verse_number": "१३३-१७", "content_sanskrit": "धरां कूवरकौ तु द्वौ रुद्रपार्श्वचरावुभौ ।\nअधिष्ठानं शिरो मेरोरक्षो मन्दर एव च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005660017, "chapter_id": 25660, "verse_number": "१३३-१८", "content_sanskrit": "चक्रुश्चन्द्रञ्च सूर्य्यञ्च चक्रे काञ्चनराजते ।\nकृष्णपक्षं शुक्लपक्षं पक्षद्वयमपीश्वराः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005660018, "chapter_id": 25660, "verse_number": "१३३-१९", "content_sanskrit": "रथनेमिद्वयं चक्रुर्देवा ब्रह्मपुरः सराः ।\nआदिद्वयं पक्षयन्त्रं यन्त्रमेताश्च देवताः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005660019, "chapter_id": 25660, "verse_number": "१३३-२०", "content_sanskrit": "कम्बलाश्वतराभ्याञ्च नागाभ्यां समवेष्टितम् ।\nभार्गवश्चाङ्गिराश्चैव बुधोऽङ्गारक एव च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005660020, "chapter_id": 25660, "verse_number": "१३३-२१", "content_sanskrit": "शनैश्चरस्तथा चात्र सर्वे ते देवसत्तमाः ।\nवरूथं गगनं चक्रुश्चारुरूपं रथस्य ते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005660021, "chapter_id": 25660, "verse_number": "१३३-२२", "content_sanskrit": "कृतं द्विजिह्वनयनं त्रिवेणुं शातकौम्भिकम् ।\nमणिमुक्तेन्द्रनीलैश्च वृतं हृष्टमुखैः सुरैः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005660022, "chapter_id": 25660, "verse_number": "१३३-२३", "content_sanskrit": "गङ्गा सिन्धुः शतद्रुश्च चन्द्रभागा सरस्वती ।\nवितस्ता च विपाशा च यमुना गण्डकी तथा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005660023, "chapter_id": 25660, "verse_number": "१३३-२४", "content_sanskrit": "सरस्वती देविका च तथा च सरयूरपि ।\nएताः सरिद्वराः सर्वा वेणुसञ्ज्ञाः कृता रथे ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005660024, "chapter_id": 25660, "verse_number": "१३३-२५", "content_sanskrit": "धृतराष्ट्रश्च ये नागास्ते च वेश्यात्मकाः कृताः ।\nवासुके कुलजा ये च ये च रैवतवंशजाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005660025, "chapter_id": 25660, "verse_number": "१३३-२६", "content_sanskrit": "ते सर्पा दर्पसम्पूर्णाश्चापतूणेष्वनूनगाः ।\nअवतस्थुः शरा भूत्वा नानाजातिशुभाननाः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005660026, "chapter_id": 25660, "verse_number": "१३३-२७", "content_sanskrit": "सुरसा सरमा कद्रुर्विनता शुचिरेव च ।\nतृषा बुभुक्षा सर्वोग्रा मृत्युः सर्वशमस्तथा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005660027, "chapter_id": 25660, "verse_number": "१३३-२८", "content_sanskrit": "ब्रह्मवध्या च गोवध्या बालवध्याः प्रजाभयाः ।\nगदा भूत्वा शक्तयश्च तदा देवरथेऽभ्ययुः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005660028, "chapter_id": 25660, "verse_number": "१३३-२९", "content_sanskrit": "युगं कृतयुगञ्चात्र चातुर्होत्रप्रयोजकाः ।\nचतुर्वर्णाः सलीलाश्च बभूवुः स्वर्णकुण्डलाः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005660029, "chapter_id": 25660, "verse_number": "१३३-३०", "content_sanskrit": "तद्युगं युगसङ्काशं रथशीर्षे प्रतिष्ठितम् ।\nधृतराष्ट्रेण नागेन बद्धं बलवता महत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005660030, "chapter_id": 25660, "verse_number": "१३३-३१", "content_sanskrit": "ऋग्वेदः सामवेदश्च यजुर्वेदस्तथापरः ।\nवेदाश्चत्वार एवैते चत्वारस्तुरगा भवन् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005660031, "chapter_id": 25660, "verse_number": "१३३-३२", "content_sanskrit": "अन्नदानपुरोगाणि यानि दानानि कानिचित् ।\nतान्यासन्वाजिनां तेषां भूषणानि सहस्रशः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005660032, "chapter_id": 25660, "verse_number": "१३३-३३", "content_sanskrit": "पद्मद्वयं तक्षकश्च कर्कोटकधनञ्जयौ ।\nनागा बभूवुरेवैते हयानां बालबन्धनाः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005660033, "chapter_id": 25660, "verse_number": "१३३-३४", "content_sanskrit": "ओङ्कारप्रभवास्ता वा मन्त्रयज्ञक्रतुक्रियाः ।\nउपद्रवाः प्रतीकाराः पशुबन्धेष्टयस्तथा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005660034, "chapter_id": 25660, "verse_number": "१३३-३५", "content_sanskrit": "यज्ञोपवाहान्येतानि तस्मिन् लोकरथे शुभे ।\nमणिमुक्ताप्रवालैस्तु भूषितानि सहस्रशः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005660035, "chapter_id": 25660, "verse_number": "१३३-३६", "content_sanskrit": "प्रतोदोङ्कार एवासीत्तदग्रञ्च वषट्कृतम् ।\nसिनीवाली कुहूराका तथा चानुमती शुभा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005660036, "chapter_id": 25660, "verse_number": "१३३-३७", "content_sanskrit": "योक्त्राण्यासंस्तुरङ्गाणामपसर्पणविग्रहाः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005660037, "chapter_id": 25660, "verse_number": "१३३-३८", "content_sanskrit": "कृष्णान्यथ च पीतानि श्वेतमाञ्जिष्ठकानि च ।\nअवदाताः पताकास्तु बभूवुः पवनेरिताः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005660038, "chapter_id": 25660, "verse_number": "१३३-३९", "content_sanskrit": "ऋतुभिश्च कृतः षड्भिर्धनुः सम्वत्सरोऽभवत् ।\nअजराज्याभवच्चापि साम्बका धनुषो द्रृढा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005660039, "chapter_id": 25660, "verse_number": "१३३-४०", "content_sanskrit": "कालो हि भगवान् रुद्रः तं च सम्वतसरं विदुः ।\nतस्मादुमाकालरात्रिर्दनुषोज्या जराभवत् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005660040, "chapter_id": 25660, "verse_number": "१३३-४१", "content_sanskrit": "सगर्भं त्रिपुरं येन दग्धवान् स त्रिलोचनः ।\nस इषुर्विष्णुसोमाग्नित्रिदैवतमयोऽभवत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005660041, "chapter_id": 25660, "verse_number": "१३३-४२", "content_sanskrit": "आननं ह्यग्निरभवच्छल्यं सोमस्तमोनुदः ।\nतेजसः समवायोऽथ चेषोस्तेजो रथाङ्गधृत् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005660042, "chapter_id": 25660, "verse_number": "१३३-४३", "content_sanskrit": "तस्मिंश्च वीर्य्यवृद्ध्यर्थं वासुकिर्नागपार्थिवः ।\nतेजः सम्वसनार्थं वै मुमोचातिविषो विषम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005660043, "chapter_id": 25660, "verse_number": "१३३-४४", "content_sanskrit": "कृत्वा देवा रथञ्चापि दिव्यं दिव्यप्रभावतः ।\nलोकाधिपतिमभ्येत्य इदं वचनमब्रुवन् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005660044, "chapter_id": 25660, "verse_number": "१३३-४५", "content_sanskrit": "संस्कृतोऽयं रथोऽस्माभिस्तव दानवशत्रुजित् ।\nइदमापत्परित्राणं देवान् सेन्द्रपुरोगमान् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005660045, "chapter_id": 25660, "verse_number": "१३३-४६", "content_sanskrit": "तं मेरुशिखराकारं त्रेलोक्यरथमुत्तमम् ।\nप्रशस्य देवान् साध्विति रथं पश्यति शङ्करः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005660046, "chapter_id": 25660, "verse_number": "१३३-४७", "content_sanskrit": "मुहुर्द्रृष्ट्वा रथं साधु साध्वित्युक्त्वा मुहुर्मुहुः ।\nउवाच सेन्द्रानमरानमराधिपतिः स्वयम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005660047, "chapter_id": 25660, "verse_number": "१३३-४८", "content_sanskrit": "याद्रृशोऽयं रथः क्लृप्तो युष्माभिर्ममसत्तमाः ।\nईद्रृशो रथसम्पत्त्या यन्ता शीघ्रं विधीयताम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005660048, "chapter_id": 25660, "verse_number": "१३३-४९", "content_sanskrit": "इत्युक्त्वा देवदेवेन देवाविद्धा इवेषुभिः ।\nअवापुर्महतीं चिन्तां कथं कार्यमिति ब्रुवन् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005660049, "chapter_id": 25660, "verse_number": "१३३-५०", "content_sanskrit": "महादेवस्य देवोऽन्यः को नाम सद्रशौ भवेत् ।\nमुक्त्वा चक्रायुधं देवं सोपास्य इषुमाश्रितः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005660050, "chapter_id": 25660, "verse_number": "१३३-५१", "content_sanskrit": "धुरि युक्ता इवोक्षाणो घटन्त इव पर्वतैः ।\nनिःश्वसन्तः सुराः सर्वे कथमेतदिति ब्रुवन् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005660051, "chapter_id": 25660, "verse_number": "१३३-५२", "content_sanskrit": "देवोऽद्रृश्यत देवांस्तु लोकनाथस्य धूर्गतान् ।\nअहं सारथिरित्युक्त्वा जग्राहाश्वांस्ततोऽग्रजः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005660052, "chapter_id": 25660, "verse_number": "१३३-५३", "content_sanskrit": "ततो देवैः सगन्धर्वैः सिंहनादो महान् कृतः ।\nप्रतोदहस्तं सम्प्रेक्ष्य ब्रह्माणं सूततां गतम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005660053, "chapter_id": 25660, "verse_number": "१३३-५४", "content_sanskrit": "भगवानपि विश्वेशो रथस्थे वै पितामहे ।\nसद्रृशः सूत इत्युक्त्वा चारुरोह रथं हरः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005660054, "chapter_id": 25660, "verse_number": "१३३-५५", "content_sanskrit": "आरोहति रथं देवे ह्यश्वा हरभरातुराः ।\nजानुभिः पतिता भूमौ रजोग्रासश्च ग्रासितः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005660055, "chapter_id": 25660, "verse_number": "१३३-५६", "content_sanskrit": "देवो द्रृष्ट्वाथ वेदांस्तानभीरुग्रहयान् भयात् ।\nउज्जहार पितॄनार्तान् सुपुत्र इव दुःखितान् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005660056, "chapter_id": 25660, "verse_number": "१३३-५७", "content_sanskrit": "ततः सिंहरवो भूयो बभूव रथभैरवः ।\nजयशब्दश्च देवानां सम्बभूवार्णवोपमः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005660057, "chapter_id": 25660, "verse_number": "१३३-५८", "content_sanskrit": "तदोङ्कारमयं गृह्य प्रतोदं वरदः प्रभुः ।\nस्वयम्भूः प्रययौ वाहाननुमन्त्र्य यथाजवम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005660058, "chapter_id": 25660, "verse_number": "१३३-५९", "content_sanskrit": "ग्रसमाना इवाकाशं मुष्णन्त इव मेदिनीम् ।\nमुखेभ्यः ससृजुः श्वासानुच्छ्वसन्त इवोरगाः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7005660059, "chapter_id": 25660, "verse_number": "१३३-६०", "content_sanskrit": "स्वयम्भुवा चोद्यमानाश्चोदितेन कपर्दिना ।\nव्रजन्ति तेऽश्वा जवनाः क्षयकाल इवानिलाः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7005660060, "chapter_id": 25660, "verse_number": "१३३-६१", "content_sanskrit": "ध्वजोच्छ्रयविनिर्माणे ध्वजयष्टिमनुत्तमाम् ।\nआक्रम्य नन्दीवृषभं तस्थौ तस्मिञ्शिवेच्छया ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7005660061, "chapter_id": 25660, "verse_number": "१३३-६२", "content_sanskrit": "भार्गवाङ्गिरसौ देवौ दण्डहस्तौ रविप्रभौ ।\nरथचक्रे तु रक्षेते रुद्रस्य प्रियकाङिक्षणौ ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7005660062, "chapter_id": 25660, "verse_number": "१३३-६३", "content_sanskrit": "शेषश्च भगवान्नागः अनन्तोऽन्तकरोऽपिणाम् ।\nशरहस्तो रथम्पाति शयनं ब्रह्मणस्तदा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7005660063, "chapter_id": 25660, "verse_number": "१३३-६४", "content_sanskrit": "यमस्तूर्णसमास्थाय महिषञ्चातिदारुणम् ।\nद्रविणाधिपतिर्व्यालं सुराणामधिपो द्विपम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7005660064, "chapter_id": 25660, "verse_number": "१३३-६५", "content_sanskrit": "अरक्षत मयूरं निकूजन्तं किन्नरं यथा ।\nगुह आस्थाय वरदो युगोपमरथं पितुः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7005660065, "chapter_id": 25660, "verse_number": "१३३-६६", "content_sanskrit": "नन्दीश्वरश्च भगवान् शूलमादाय दीप्तिमान् ।\nपृष्ठतश्चापि पार्श्वाभ्यां लोकस्य क्षयकृद्यथा ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7005660066, "chapter_id": 25660, "verse_number": "१३३-६७", "content_sanskrit": "प्रमथाश्चाग्निवर्णाभाः साग्निज्वाला इवाचलाः ।\nअनुजग्मू रथं शार्वं नक्रा इव महार्णवम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7005660067, "chapter_id": 25660, "verse_number": "१३३-६८", "content_sanskrit": "भृगुर्भरद्वाजवसिष्ठगौतमाः क्रतुः पुलस्त्यः पुलहस्तपोधनाः ।\nमरीचिरत्रिर्भगवानथाङ्गिराः पराशरागस्त्यमुखा महर्षयः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7005660068, "chapter_id": 25660, "verse_number": "१३३-६९", "content_sanskrit": "हरमजितमजं प्रतुष्टुवुर्वचनविषैर्विचित्रभूषणैः ।\nरथस्त्रिपुरे सकाञ्चनाचलो व्रजतिसपक्ष इवाद्रिरम्बरे ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7005660069, "chapter_id": 25660, "verse_number": "१३३-७०", "content_sanskrit": "करिगिरिरविमेघसन्निभाः सजलपयोदनिनादनादिनः ।\nप्रमथगणाः परिवार्य्य देवगुप्तं रथममरापि ययुः स्म दर्पयुक्ताः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7005660070, "chapter_id": 25660, "verse_number": "१३३-७१", "content_sanskrit": "मकरतिमितिमिङ्गिलावृतः प्रलय इवातिसमुद्धतोऽर्णवः ।\nव्रजति रथवरोऽति भास्वरो ह्यशनिनिपातपयोद-निःस्वनः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]