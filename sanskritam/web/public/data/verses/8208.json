[{"id": 900001066, "chapter_id": 8208, "verse_number": "7.1", "content_sanskrit": "द्वा सुपर्णा सयुजा सखाया समानं वृक्षं परिषस्वजाते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900001067, "chapter_id": 8208, "verse_number": "7.2", "content_sanskrit": "समाने वृक्षे पुरुषो निमग्नोऽनीशया शोचति मुह्यमानः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900001068, "chapter_id": 8208, "verse_number": "7.3", "content_sanskrit": "यदा पश्यः पश्यते रुग्मवर्णं कर्त्तारमीशं पुरुषं ब्रह्मयोनिम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900001069, "chapter_id": 8208, "verse_number": "7.4", "content_sanskrit": "यदा पश्यः पश्यते रुग्मवर्णं कर्त्तारमीशं पुरुषं ब्रह्मयोनिम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900001070, "chapter_id": 8208, "verse_number": "7.5", "content_sanskrit": "प्राणो ह्येष सर्वभूतैर्विभाति विजानन् विद्वान् भवते नातिवादी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900001071, "chapter_id": 8208, "verse_number": "7.6", "content_sanskrit": "सत्येन लभ्यस्तपसा ह्येष आत्मा सम्यग्ज्ञानेन ब्रह्मचर्येण नित्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900001072, "chapter_id": 8208, "verse_number": "7.7", "content_sanskrit": "सत्यमेव जयति नानृतं सत्येन पन्था विततो देवयानः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900001073, "chapter_id": 8208, "verse_number": "7.8", "content_sanskrit": "बृहच्च तद् दिव्यमचिन्त्यरूपं सूक्ष्माच्च तत् सूक्ष्मतरं विभाति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900001074, "chapter_id": 8208, "verse_number": "7.9", "content_sanskrit": "न चक्षुषा गृह्यते नापि वाचा नान्यैर्देवैस्तपसा कर्म्मणा वा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900001075, "chapter_id": 8208, "verse_number": "7.10", "content_sanskrit": "एषोऽणुरात्मा चेतसा वेदितव्यो यस्मिन् प्राणः पञ्चधा संविवेश", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900001076, "chapter_id": 8208, "verse_number": "7.11", "content_sanskrit": "यं यं लोकं मनसा संविभाति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]