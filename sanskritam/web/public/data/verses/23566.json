[{"id": 7003566000, "chapter_id": 23566, "verse_number": "२०६-१", "content_sanskrit": "अथ शुभकर्मफलोदय प्रकरणम् ।\nऋषिरुवाच ।\nचित्रगुप्तस्य सन्देशो वदतो यो मया श्रुतः ।\nश्रूयतां वै महाभागास्तपःसिद्धा द्विजोत्तमाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003566001, "chapter_id": 23566, "verse_number": "२०६-२", "content_sanskrit": "इमं सर्वातिथिं दान्तं सर्वभूतानुकम्पकम् ।\nसमान्नदानदातारं शेषभोजनभोजिनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003566002, "chapter_id": 23566, "verse_number": "२०६-३", "content_sanskrit": "मुञ्च मुञ्च महाभृत्य चैष धर्मस्य निर्णयः ।\nअहं कालेन सार्द्धं हि मृत्युना प्रकृतस्तथा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003566003, "chapter_id": 23566, "verse_number": "२०६-४", "content_sanskrit": "मम स्थास्यन्ति पार्श्वेषु पापा वै विकृतास्तथा ।\nएनं गास्यन्ति गन्धर्वा गगनेऽप्सरसस्तथा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003566004, "chapter_id": 23566, "verse_number": "२०६-५", "content_sanskrit": "दीयतामासनं दिव्यं तथान्यद्यानमेव च ।\nअन्यान्यान्कामयेत्कामान्मनसा यानि चेच्छति ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003566005, "chapter_id": 23566, "verse_number": "२०६-६", "content_sanskrit": "तत्तु शीघ्रं प्रदातव्यं धर्मराजस्य शासनात् ।\nअक्रियाणि तु दानानि पूर्वं दत्तानि धीमता ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003566006, "chapter_id": 23566, "verse_number": "२०६-७", "content_sanskrit": "प्रेक्षतां च महाभागो भोक्तुं चैव सहानुगः ।\nतिष्ठत्येषोऽत्र वै वीरो ममादेशान्महायशाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003566007, "chapter_id": 23566, "verse_number": "२०६-८", "content_sanskrit": "यावत्स्वर्गाद्विमानानि समागच्छन्ति कृत्स्नशः ।\nततः स प्रवरैर्यानैः सानुगः सपरिच्छदः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003566008, "chapter_id": 23566, "verse_number": "२०६-९", "content_sanskrit": "देवानां भवनं यातु दैवतैरभिपूजितः ।\nतत्रैव रमतां वीरो यावल्लोको हि धार्यते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003566009, "chapter_id": 23566, "verse_number": "२०६-१०", "content_sanskrit": "स कृतार्थः सदा लोके यत्रैषोऽभिप्रयास्यति ।\nतत्र मेध्यं पवित्रं च यत्र स्थास्यत्ययं शुचिः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003566010, "chapter_id": 23566, "verse_number": "२०६-११", "content_sanskrit": "नैककन्याप्रदातारं नैकयज्ञकृतं तथा ।\nपूज्यतां सर्वकामैस्तु पदं गच्छतु वैष्णवम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003566011, "chapter_id": 23566, "verse_number": "२०६-१२", "content_sanskrit": "तत्रैष रमतां धीरः सहस्रमयुतं समाः ।\nततो वै मानुषे लोके आद्ये वै जायतां कुले ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003566012, "chapter_id": 23566, "verse_number": "२०६-१३", "content_sanskrit": "भूतानुकम्पको ह्येष क्रियतामस्य चार्च्चनम् ।\nवर्षाणामयुतं चायं तत्र तिष्ठतु देववत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003566013, "chapter_id": 23566, "verse_number": "२०६-१४", "content_sanskrit": "जायते तु ततः पश्चात्सर्वमानुषपूजितः ।\nउपानहौ च छत्रं च जलभाजनमेव च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003566014, "chapter_id": 23566, "verse_number": "२०६-१५", "content_sanskrit": "असकृद्येन दत्तानि तस्मै पूजां प्रयच्छथ ।\nसभा यत्र प्रवर्त्तन्ते यस्मिन्देशे सहस्रशः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003566015, "chapter_id": 23566, "verse_number": "२०६-१६", "content_sanskrit": "हस्तेन संस्पृशत्येष मृदुना शीतलेन च ।\nविद्याधरस्तथा ह्येष नित्यं मुदितमानसः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003566016, "chapter_id": 23566, "verse_number": "२०६-१७", "content_sanskrit": "महापद्मानि चत्वारि तस्मिंस्तिष्ठन्तु नित्यशः ।\nततश्च्युतश्च कालेन मानुषं लोकमास्थितः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003566017, "chapter_id": 23566, "verse_number": "२०६-१८", "content_sanskrit": "बहुसुन्दरनारीके कुले जन्म समाप्नुयात् ।\nदधि क्षीरं घृतं चैव येन दत्तं द्विजातिषु ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003566018, "chapter_id": 23566, "verse_number": "२०६-१९", "content_sanskrit": "एष वा यातु नः पार्श्वमस्मै पूजां प्रयच्छथ ।\nनीयतां नीयतां शीघ्रं यत्रयत्र न चालयेत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003566019, "chapter_id": 23566, "verse_number": "२०६-२०", "content_sanskrit": "गोरसस्य तु पूर्णानि भाजनानि सहस्रशः ।\nयत्र दत्त्वा च पीत्वा च बान्धवेभ्यो विभागशः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003566020, "chapter_id": 23566, "verse_number": "२०६-२१", "content_sanskrit": "ततः पश्चादयं यातु यत्र लोकोऽनसूयकः ।\nतत्रैव रमतां धीरो बहुवर्षशतान्ययम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003566021, "chapter_id": 23566, "verse_number": "२०६-२२", "content_sanskrit": "बहुसुन्दरनारीभिः सेव्यमानो महातपाः ।\nअमराख्यो भवेत्तत्र गोलोकेषु समाहितः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003566022, "chapter_id": 23566, "verse_number": "२०६-२३", "content_sanskrit": "इदमेवापरं चैव चित्रगुप्तस्य भाषितम् ।\nसर्वदेवमया देव्यः सर्ववेदमयास्तथा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003566023, "chapter_id": 23566, "verse_number": "२०६-२४", "content_sanskrit": "अमृतं धारयन्त्यश्च प्रचरन्ति महीतले ।\nतीर्थानां परमं तीर्थमतस्तीर्थं न विद्यते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003566024, "chapter_id": 23566, "verse_number": "२०६-२५", "content_sanskrit": "पवित्रं च पवित्राणां पुष्टीनां पुष्टिरेव च ।\nतस्मात्पुरस्तु दातव्यं गवां वै मेध्यकारणात् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003566025, "chapter_id": 23566, "verse_number": "२०६-२६", "content_sanskrit": "दघ्ना हि त्रिदशाः सर्वे क्षीरेण च महेश्वरः ।\nघृतेन पावको नित्यं पायसेन पितामहः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003566026, "chapter_id": 23566, "verse_number": "२०६-२७", "content_sanskrit": "सकृद्दत्तेन प्रीयन्ते वर्षाणां हि त्रयोदश ।\nतां दत्त्वा चैव पीत्वा च प्रीतो मेध्यस्तु जायते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003566027, "chapter_id": 23566, "verse_number": "२०६-२८", "content_sanskrit": "पंचगव्येन पीतेन वाजिमेधफलं लभेत् ।\nगव्यं तु परमं मेध्यं गव्यादन्यन्न विद्यते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]