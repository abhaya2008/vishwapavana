[{"id": 2063441, "chapter_id": 2351, "verse_number": "८-७२-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2063442, "chapter_id": 2351, "verse_number": "८-७२-१", "content_sanskrit": "युधिष्ठिरेणैxxxxक्तः कौन्तेयः श्वेतवाहनः।\nअसिं जग्राह सङ्क्रुद्धो जिघांसुर्भरतर्षभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2063443, "chapter_id": 2351, "verse_number": "८-७२-२", "content_sanskrit": "तस्य कोपं समाज्ञाय चित्तज्ञः केशवस्तदा।\nउवाच किमिदं खङ्गं गृह्णास्यर्जुन शंम मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2063444, "chapter_id": 2351, "verse_number": "८-७२-३", "content_sanskrit": "नेह पश्यामि योद्धव्यं त्वया किञ्चिद्वनञ्जय।\nनेहागता धार्तराष्ट्राः सर्वे भीमेन वारिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2063445, "chapter_id": 2351, "verse_number": "८-७२-४", "content_sanskrit": "उपागतोऽसि कौन्तेय राजा द्रष्टव्य इत्यसौ।\nस राजा भवता दृष्टः कुशली च युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2063446, "chapter_id": 2351, "verse_number": "८-७२-५", "content_sanskrit": "तं दृष्ट्वा नृपशार्दूलं शार्दूलसमविक्रमम्।\nहर्षकाले च सम्प्राप्ते कस्मात्त्वां मन्युराविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2063447, "chapter_id": 2351, "verse_number": "८-७२-६", "content_sanskrit": "न तं पश्यामि कौन्तेय यस्ते वध्यो भवेदिह।\nप्रहर्तुमिच्छसे कस्मात्किं वा ते चित्तविभ्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2063448, "chapter_id": 2351, "verse_number": "८-७२-७", "content_sanskrit": "कस्माद्भवान्महाखङ्गं परिगृह्णात्यकारणात्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2063449, "chapter_id": 2351, "verse_number": "८-७२-८", "content_sanskrit": "तत्त्वां पृच्छामि कौन्तेय किमिदं ते चिकीर्षितम्।\nपरामृशसि यत्क्रुद्धः खङ्गमद्भुतविक्रम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2063450, "chapter_id": 2351, "verse_number": "८-७२-९", "content_sanskrit": "एवमुक्तः कटाक्षेण प्रेक्षमाणो युधिष्ठिरम्।\nअर्जुनः प्राह गोविन्दं क्रुद्धः सर्प इव श्वसन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2063451, "chapter_id": 2351, "verse_number": "८-७२-१०", "content_sanskrit": "अन्यस्मै देहि गाण्डीवमिति मां यः प्रचोदयेत्।\nभिन्द्यामहं तस्य शिर इत्युपांशु व्रतं मम।\nयुधिष्ठिरेण तेनाहमुक्तश्चास्मि जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2063452, "chapter_id": 2351, "verse_number": "८-७२-११", "content_sanskrit": "यदुक्तोऽहमदीनार्थं राज्ञाऽनेन यशस्विना।\nसमक्षं तव गोविन्द न तत्क्षन्तुमिहोत्सहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2063453, "chapter_id": 2351, "verse_number": "८-७२-१२", "content_sanskrit": "तस्मादेनं विधिष्यामि राजानं धर्मचारिणाम्।\nप्रतिज्ञां पालयिष्यामि हत्वैनं नरसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2063454, "chapter_id": 2351, "verse_number": "८-७२-१३", "content_sanskrit": "एतदर्थं मया खह्गो गृहीतो यदुनन्दन।\nसोऽहं युधिष्ठिरं हत्वा सत्यस्यानृण्यतां गतः।\nविशोको विज्वरश्चापि भविष्यामि जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2063455, "chapter_id": 2351, "verse_number": "८-७२-१४", "content_sanskrit": "किं वा त्वं मन्यसे प्राप्तमस्मिन्कार्य उपस्थिते।\nत्वमस्य जगतस्तात वेत्थ सर्वं गतागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2063456, "chapter_id": 2351, "verse_number": "८-७२-१५", "content_sanskrit": "`जातस्त्वत्तो हि धर्मश्चाधर्मश्चेति परा श्रुतिः।\nतत्तथा प्रकरिष्यामि यथा मां वक्ष्यते भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2063457, "chapter_id": 2351, "verse_number": "८-७२-१६x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2063458, "chapter_id": 2351, "verse_number": "८-७२-१६", "content_sanskrit": "धिग्धिगित्येव गोविन्दः पार्थमुक्त्वाब्रवीत्पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2063459, "chapter_id": 2351, "verse_number": "८-७२-१७x", "content_sanskrit": "कृष्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2063460, "chapter_id": 2351, "verse_number": "८-७२-१७", "content_sanskrit": "इदानीं पार्थ जानामि न वृद्धाः सेवितास्त्वया।\nअकाले पुरुषव्याघ्र संरम्भं यद्भवानगात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2063461, "chapter_id": 2351, "verse_number": "८-७२-१८", "content_sanskrit": "न हि धर्मविगज्ञैरेवं कार्यं धनञ्जय।\nयथा त्वं पाण्डवाद्येह धर्मभीरुरण्डितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2063462, "chapter_id": 2351, "verse_number": "८-७२-१९", "content_sanskrit": "योऽकार्याणां क्रियायाश्च संयोगं नावबुध्यते।\nकार्याणामक्रियायाश्च स पार्थ पुरुषाधमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2063463, "chapter_id": 2351, "verse_number": "८-७२-२०", "content_sanskrit": "अनुसृत्य तु ये धर्मं कवयः समुपस्थिताः।\nसमासविस्तरविदां न तेषां वेत्सि निश्चयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2063464, "chapter_id": 2351, "verse_number": "८-७२-२१", "content_sanskrit": "अनिश्चयज्ञो हि नरः कार्याकार्यविनिश्चये।\nएवं स मुह्यत्यवशो यथा त्वं पार्थ मुह्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2063465, "chapter_id": 2351, "verse_number": "८-७२-२२", "content_sanskrit": "न हि कार्यमकार्यं वा सुखं ज्ञातुं कथञ्चन।\nश्रुतेन ज्ञायते सर्वं तच्च त्वं नावहुध्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2063466, "chapter_id": 2351, "verse_number": "८-७२-२३", "content_sanskrit": "अविज्ञानादिह भवान्सत्यं रक्षति धर्मवित्।\nप्राणिनां त्वं वधं पार्थ धार्मिको नावबुध्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2063467, "chapter_id": 2351, "verse_number": "८-७२-२४", "content_sanskrit": "प्राणिनां हि वधात्तात वृथा धर्मो मतो मम।\nअनृतं तु भवेद्वाच्यं न तु हिंसा कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2063468, "chapter_id": 2351, "verse_number": "८-७२-२५", "content_sanskrit": "स कथं भ्रातरं ज्येष्ठं राजानं धर्मकोविदम्।\nहन्याद्भवान्नरश्रेष्ठ प्राकृतोऽन्यः पुमानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2063469, "chapter_id": 2351, "verse_number": "८-७२-२६", "content_sanskrit": "अयुध्यमानस्य गुरोस्तथाऽशत्रोश्च मानद।\nपराङ्मुखस्य द्रवतः शरणं चापि गच्छतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2063470, "chapter_id": 2351, "verse_number": "८-७२-२७", "content_sanskrit": "कृताञ्जलेः प्रपन्नस्य प्रमत्तस्य तथैव च।\nन वधः पूज्यते सद्भिस्तच्च सर्वं गुरौ तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2063471, "chapter_id": 2351, "verse_number": "८-७२-२८", "content_sanskrit": "त्वया चैतद्व्रतं पार्थ बालेनेव कृतं पुरा।\nतस्मादधर्मसंयुक्तं मौर्ख्यादेव व्यवस्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2063472, "chapter_id": 2351, "verse_number": "८-७२-२९", "content_sanskrit": "स्वगुरुं पार्थ कस्मात्त्वं हन्तुकामोऽभिधावसि।\nअसम्प्रधार्य धर्माणां गतिं सूक्ष्मां दुरत्ययाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2063473, "chapter_id": 2351, "verse_number": "८-७२-३०", "content_sanskrit": "इदं धर्मरहस्यं च तव वक्ष्यामि पाण्डव।\nयद्ब्रूयात्तव भीष्मो वा राजा वापि युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2063474, "chapter_id": 2351, "verse_number": "८-७२-३१", "content_sanskrit": "विदुरो वा पुनः क्षत्ता गान्धारी वा यशस्विनी।\nकुन्ती वा भरतश्रेष्ठ द्रौपदी वा यशस्विनी।\nतत्ते वक्ष्यामि तत्त्वेन निबोधैतद्धनञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2063475, "chapter_id": 2351, "verse_number": "८-७२-३२", "content_sanskrit": "सत्यस्यं वचनं साधु न सत्याद्विद्यते परम्।\nसुदुर्विदं हि तत्त्वेन तत्सत्यमिति मे सतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2063476, "chapter_id": 2351, "verse_number": "८-७२-३३", "content_sanskrit": "भवेत्सत्यमवक्तव्यं वक्तव्यमनृतं भवेत्।\nयत्रानृतं भवेत्सत्यं सत्यं चाप्यनृतं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2063477, "chapter_id": 2351, "verse_number": "८-७२-३४", "content_sanskrit": "विवाहकाले रतिसम्प्रयोगे\nप्राणात्यये सर्वत्रनापहारे।\nविप्रस्य चार्थे ह्यनृतं वदेत\nपञ्चानृतान्याहुरपातकानि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2063478, "chapter_id": 2351, "verse_number": "८-७२-३५", "content_sanskrit": "सर्वस्वस्यापहारे तु वक्तव्यमनृतं भवेत्॥\nतत्रानृतं भवेत्सत्यं सत्यं चाप्यनृतं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2063479, "chapter_id": 2351, "verse_number": "८-७२-३६", "content_sanskrit": "तादृशो हन्यते बालो यस्य सत्यमनिश्चितम्।\nसत्यानृते विनिश्चित्य ततो भवति धर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2063480, "chapter_id": 2351, "verse_number": "८-७२-३७", "content_sanskrit": "किमाश्चर्यं कृतप्रज्ञः पुरुषोऽपि सुदारुणः।\nसुमहत्प्राप्नुयात्पुण्यं बलाकोऽन्धवधादिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2063481, "chapter_id": 2351, "verse_number": "८-७२-३८", "content_sanskrit": "किमाश्चर्यं पुनर्मूढो धर्मकामो ह्यपण्डितः।\nसुमहत्प्राप्नुयात्पापमापगास्विव कौशिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2063482, "chapter_id": 2351, "verse_number": "८-७२-३९x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2063483, "chapter_id": 2351, "verse_number": "८-७२-३९", "content_sanskrit": "आचक्ष्व भगवन्नेतद्यथा विन्दाम्यहं तथा।\nवलाकस्यानुसम्बद्धं नदीनां कौशिकस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2063484, "chapter_id": 2351, "verse_number": "८-७२-४०x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2063485, "chapter_id": 2351, "verse_number": "८-७२-४०", "content_sanskrit": "मृगव्याधोऽभवत्कश्चिद्बलाको नाम भारत।\nयात्रार्थं पुत्रदाराणां मृगान्हन्ति न कामतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2063486, "chapter_id": 2351, "verse_number": "८-७२-४१", "content_sanskrit": "वृद्धौ च मातापितरौ बिभर्त्यन्यांश्च संश्रितान्।\nस्वधर्मनिरतो नित्यं संविभज्यानसूयकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2063487, "chapter_id": 2351, "verse_number": "८-७२-४२", "content_sanskrit": "स कदाचिन्मृगप्रेप्सुर्नान्वविन्दन्मृगं क्वचित्।\nअथापश्यत्स पीवानं श्वापदं घ्राणचक्षुषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2063488, "chapter_id": 2351, "verse_number": "८-७२-४३", "content_sanskrit": "अदृष्टपूर्वमपि तत्सत्वं तेन हतं तदा।\nअन्धे हते ततो व्योम्नः पुष्पवर्षं पपात च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2063489, "chapter_id": 2351, "verse_number": "८-७२-४४", "content_sanskrit": "अप्सरोगीतवादित्रैर्नादितं च मनोरमम्।\nविमानमगमत्स्वर्गान्मृगव्याधनिनीषया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2063490, "chapter_id": 2351, "verse_number": "८-७२-४५", "content_sanskrit": "तद्भूतं सर्वभूतानामभावाय किलार्जुन।\nतपस्तप्त्वा वरं प्राप्तं कृतमन्धं स्वयम्भुवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2063491, "chapter_id": 2351, "verse_number": "८-७२-४६", "content_sanskrit": "तद्धत्वा सर्वभूतानामभावकृतनिश्चयम्।\nबलाकोऽगात्स्वर्गलोकमेवं धर्मः सुदुर्विदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2063492, "chapter_id": 2351, "verse_number": "८-७२-४७", "content_sanskrit": "कौशिकोऽप्यभवद्विप्रस्तपस्वीनो बहुश्रुतः।\nनदीनां सङ्गमे ग्रामाददूरे स किलावसत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2063493, "chapter_id": 2351, "verse_number": "८-७२-४८", "content_sanskrit": "सत्यं मया सदा वाच्यमिति तस्याभवद्द्वतम्।\nसत्यवादीति विख्यातः स तदासीद्धनञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2063494, "chapter_id": 2351, "verse_number": "८-७२-४९", "content_sanskrit": "अथ दस्युभयात्केचित्तदा तद्वनमाविशन्।\nतत्रापि दस्यवः क्रुद्धास्तानमार्गन्त यत्नतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2063495, "chapter_id": 2351, "verse_number": "८-७२-५०", "content_sanskrit": "अथ कौशिकमभ्येत्य प्रोचुस्ते सत्यवादिनम्।\nकतरेण पथा याता भगवन्निति वै जनाः।\nसत्येन पृष्टः प्रब्रूहि यदि तद्वेत्थ शंस नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2063496, "chapter_id": 2351, "verse_number": "८-७२-५१x", "content_sanskrit": "श्रीकृष्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2063497, "chapter_id": 2351, "verse_number": "८-७२-५१", "content_sanskrit": "सत्यस्य त्वविभागज्ञः सत्यं तेभ्यः शशंस ह।\nबहुवृक्षलतागुल्ममेतद्गहनमाश्रिताः।\nइति तान्ख्यापयामास तेभ्यस्तत्त्वं स कौशिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2063498, "chapter_id": 2351, "verse_number": "८-७२-५२", "content_sanskrit": "ततस्ते तान्समासाद्य क्रूरा जघ्नुरिति श्रुतिः।\nततोऽधर्मेण महता वाग्दुरुक्तेन कौशिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2063499, "chapter_id": 2351, "verse_number": "८-७२-५३", "content_sanskrit": "गतः सुकष्टं निरयं धर्मसूक्ष्मेष्वतत्त्ववित्।\nदृष्टपूर्वश्रुतो मूढो धर्माणामविशारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2063500, "chapter_id": 2351, "verse_number": "८-७२-५४", "content_sanskrit": "वृद्धानपृच्छन्सन्देहानन्धः श्वभ्रमिवर्च्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2063501, "chapter_id": 2351, "verse_number": "८-७२-५५", "content_sanskrit": "तत्र ते लक्षणोद्देशः कश्चिदेव भविष्यति।\nदुष्करं प्रतिसंख्यानं कार्त्स्न्येनात्र व्यवस्थितिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2063502, "chapter_id": 2351, "verse_number": "८-७२-५६", "content_sanskrit": "सत्यं धर्म इति ह्येके वदन्ति बहवो जनाः।\nन च पार्थाभ्यसूयामि नैतत्सर्वत्र शिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2063503, "chapter_id": 2351, "verse_number": "८-७२-५७", "content_sanskrit": "श्रुतिस्तु धार्या इत्येके वदन्ति बहवो जनाः।\nन त्वेतत्प्रत्यसूयामि तत्र सर्वं विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2063504, "chapter_id": 2351, "verse_number": "८-७२-५८", "content_sanskrit": "यत्स्यादहिंसासंयुक्तं स धर्म इति निश्चयः।\nअहिंसार्थाय हिंस्राणां धर्मप्रवचनं कृतम्।\nधारणाद्धर्ममित्याहुर्धर्मो धारयते प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2063505, "chapter_id": 2351, "verse_number": "८-७२-५९", "content_sanskrit": "प्रभवार्थाय भूतानां धर्मप्रवचनं कृतम्।\nयस्मात्प्रभवसंयुक्तः स धर्म इति निश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2063506, "chapter_id": 2351, "verse_number": "८-७२-६०", "content_sanskrit": "येऽन्यायेन जिगीषन्तो धर्मं पृच्छन्ति मानवाः।\nअकूजनेन चेन्मोक्षो नात्र कूजेत्कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2063507, "chapter_id": 2351, "verse_number": "८-७२-६१", "content_sanskrit": "अवश्यं कूजितव्ये ह शङ्केरन्वाप्यकूजनात्।\nयेऽन्यायेन जिहीर्षन्तो धर्मं पृच्छन्ति कस्यचित्।\nश्रेयस्तत्रानृतं वक्तुं सत्यादिति विनिश्चित्म्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2063508, "chapter_id": 2351, "verse_number": "८-७२-६२", "content_sanskrit": "प्राणात्यये विवाहे वा सर्वजात्या महाभये।\nसर्वस्वस्य च लोपे वा वक्तव्यमनृतं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2063509, "chapter_id": 2351, "verse_number": "८-७२-६३", "content_sanskrit": "अधर्मं हि न पश्यन्ति मृषोद्यं तत्र पण्डिताः।\nसर्वथाऽभिवदेत्तत्तु नानृतं स्याद्विचक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2063510, "chapter_id": 2351, "verse_number": "८-७२-६४", "content_sanskrit": "यः स्तेनैः सह सम्बन्धो मुच्यते शपथादपि।\nभवेत्तत्रानृतं श्रेयः सत्यादिति विचारितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2063511, "chapter_id": 2351, "verse_number": "८-७२-६५", "content_sanskrit": "न च तेभ्यो धनं देयं सत्यादिति कथञ्चन।\nपापेभ्योऽपि धनं दत्तं दातारमपि पीडयेत्।\nतस्माद्धर्मार्थमनृतमुक्त्वा नानृतवाग्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2063512, "chapter_id": 2351, "verse_number": "८-७२-६६", "content_sanskrit": "एष ते लक्षणोद्देशो मयोद्दिष्टो यथाविधि।\nएतज्ज्ञात्वा ब्रूहि पार्थ यदि वध्यो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2063513, "chapter_id": 2351, "verse_number": "८-७२-६७x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2063514, "chapter_id": 2351, "verse_number": "८-७२-६७", "content_sanskrit": "यथा ब्रूयान्महाप्राज्ञो यथा ब्रूयान्महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2063515, "chapter_id": 2351, "verse_number": "८-७२-६८", "content_sanskrit": "सुहृद्ब्रूयाद्यथाऽस्माकं तथोक्तं वचनं त्वया।\nभवान्मातृसमोऽस्माकं भवान्पितृसमोऽपि च।\nगतिश्च परमा कृष्ण त्वमेव च परायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2063516, "chapter_id": 2351, "verse_number": "८-७२-६९", "content_sanskrit": "न हि ते त्रिषु लोकेषु विद्यतेऽविदितं क्वचित्।\nतस्माद्भवान्परं धर्मं वेद सर्वं यथातथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2063517, "chapter_id": 2351, "verse_number": "८-७२-७०", "content_sanskrit": "अवध्यं पाण्डवं मन्ये धर्मराजं युधिष्ठिरम्।\nअधर्मयुक्ते संयोगे ब्रूहि किञ्चिदनुग्रहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2063518, "chapter_id": 2351, "verse_number": "८-७२-७१", "content_sanskrit": "इदं चापरमत्रैव ब्रूहि तत्त्वं विवक्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2063519, "chapter_id": 2351, "verse_number": "८-७२-७२", "content_sanskrit": "जानासि दाशार्ह मम व्रतं तु\nयो मां ब्रूयात्कश्चन मानुषेषु।\nअन्यस्मै त्वं गाण्डिवं देहि पार्थ\nयो मत्तोऽस्त्रे वीर्यतो वा विशिष्टः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2063520, "chapter_id": 2351, "verse_number": "८-७२-७३", "content_sanskrit": "हन्यामहं केशव तं प्रसह्य\nभीमो हन्यात्तूवरकेति चोक्तः।\nवन्मां राजा ह्युक्तवांस्ते समक्षं\nधनुर्देहीत्यसकृद्वृष्णिवीरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2063521, "chapter_id": 2351, "verse_number": "८-७२-७४", "content_sanskrit": "तं हन्यां चेत्केशव जीवलोके\nस्थाता नाहं कालमप्यल्पमात्रम्।\nध्यात्वा नूनं ह्येनसा चापि मुक्तो\nवधं राज्ञो भ्रष्टवीर्यो विचेताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2063522, "chapter_id": 2351, "verse_number": "८-७२-७५", "content_sanskrit": "यथा प्रतिज्ञा मम लोकबुद्धौ\nभवेत्सत्या धर्मभृतां वरिष्ठ।\nयथा जीवत्पाण्डवोऽहं च कृष्ण\nतथा बुद्धिं दातुमप्यर्हसि त्वम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2063523, "chapter_id": 2351, "verse_number": "८-७२-७६x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2063524, "chapter_id": 2351, "verse_number": "८-७२-७६", "content_sanskrit": "राजा श्रान्तो विक्षतो दुःखितश्च\nकर्णेन सह्ख्ये निशितैर्बाणसङ्घैः।\nयश्चानिशं सूतपुत्रेण वीर\nशरैर्भृशं ताडितो युध्यमानः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2063525, "chapter_id": 2351, "verse_number": "८-७२-७७", "content_sanskrit": "अतस्त्वमेतेन सरोषमुक्तो\nदुःखान्वितेनेदमयुक्तरूपम्।\nअकोपितो ह्येष यदि स्म सङ्ख्ये\nकर्णं न हन्यादिति चाब्रवीत्सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2063526, "chapter_id": 2351, "verse_number": "८-७२-७८", "content_sanskrit": "जानाति तं पाण्डव एष चापि\nपापं लोके कर्णमसह्यमन्यैः।\nततस्त्वमुक्तो भृशरोषितेन\nराज्ञा समक्षं परुषाणि पार्थ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2063527, "chapter_id": 2351, "verse_number": "८-७२-७९", "content_sanskrit": "नित्योद्युक्ते सततं चाप्रसह्ये\nकर्णे द्यूतं ह्यद्य रणे निबद्धम्।\nतस्मिन्हते कुरवो निर्जिताः स्यु--\nरेवं बुद्धिः पार्थिवे धर्मपुत्रे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2063528, "chapter_id": 2351, "verse_number": "८-७२-८०", "content_sanskrit": "ततो बधं नार्हति धर्मपुत्र--\nस्त्वया प्रतिज्ञाऽर्जुन पालनीया।\nजीवन्नयं येन मृतो भवेद्धि\nतन्मे निबोधेह तवानुरूपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2063529, "chapter_id": 2351, "verse_number": "८-७२-८१", "content_sanskrit": "यदा मानं लभते माननार्ह--\nस्तदा स वै जीवति जीवलोके।\nयदाऽवमानं लभते महान्तं\nतदा जीवन्मृत इत्युच्यते सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2063530, "chapter_id": 2351, "verse_number": "८-७२-८२", "content_sanskrit": "सम्मानितः पार्थिवोऽयं सदैव\nत्वया च भीमेन तथा यमाभ्याम्।\nवृद्धैश्च लोके पुरुषैश्च शूरै--\nस्तस्यापमानं कलया प्रयुङ्क्ष्व॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2063531, "chapter_id": 2351, "verse_number": "८-७२-८३", "content_sanskrit": "त्वमित्यत्रभवन्तं हि ब्रूहि पार्थ युधिष्ठिरम्।\nत्वमित्युक्तो हि निहतो गुरुर्भवति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2063532, "chapter_id": 2351, "verse_number": "८-७२-८४", "content_sanskrit": "एवमाचर कौन्तेय धर्मराजे युधिष्ठिरे।\nअधर्मयुक्तं संयोगं कुरुष्वैनं कुरूद्वह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2063533, "chapter_id": 2351, "verse_number": "८-७२-८५", "content_sanskrit": "अथर्वाङ्गिरसी ह्येषा श्रुतीनामुत्तमा श्रुतिः।\nअविचार्यैव कार्यैषा श्रेयस्कामैर्नरैः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2063534, "chapter_id": 2351, "verse_number": "८-७२-८६", "content_sanskrit": "अवधेन वधः प्रोक्तो यद्गुरुस्त्वमिति प्रभुः।\nतद्ब्रूहि त्वं यन्मयोक्तं धर्मराजस्य धर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2063535, "chapter_id": 2351, "verse_number": "८-७२-८७", "content_sanskrit": "यदा ह्यं पाण्डव धर्मराज--\nसत्वत्तोऽयुक्तं लप्स्यते चैव साधु।\nततोऽस्य पादावभिवाद्य पश्चा--\nच्छ्रेयो ब्रूयात्सान्त्वयुक्तं हितं च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2063536, "chapter_id": 2351, "verse_number": "८-७२-८८", "content_sanskrit": "भ्राता प्राज्ञस्तव कोपं न जातु\nकुर्याद्राजा धर्ममार्गानुसारी।\nमुक्तोऽनृताद्वातृवधाच्च पापा--\nद्धृष्टः कर्णं त्वं जहि पार्थ पश्चात्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2063537, "chapter_id": 2351, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे द्विसप्ततितमोऽध्यायः॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}]