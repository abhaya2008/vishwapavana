[{"id": 2213980, "chapter_id": 5573, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2213981, "chapter_id": 5573, "verse_number": "१", "content_sanskrit": "दारुकोऽपि कुरून् गत्वा दृष्ट्वा पार्थान् महारथान् ।\nआचष्ट मौसले वृष्णीनन्योन्येनोपसंहृतान्\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2213982, "chapter_id": 5573, "verse_number": "२", "content_sanskrit": "श्रुत्वा विनष्टान् वार्ष्णेयान् सभोजान्धककौकुरान् ।\nपाण्डवाः शोकसन्तप्ता वित्रस्तमनसोऽभवन्\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2213983, "chapter_id": 5573, "verse_number": "३", "content_sanskrit": "ततोऽर्जुनस्तानामन्त्र्य केशवस्य प्रियः सखा ।\nप्रययौ मातुलं द्रष्टुं नैतदस्तीति चाब्रवीत्\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2213984, "chapter_id": 5573, "verse_number": "४", "content_sanskrit": "स वृष्णिनिलयं गत्वा दारुकेण सह प्रभो ।\nददर्श द्वारकां वीरो मृतनाथामिव स्त्रियम्\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2213985, "chapter_id": 5573, "verse_number": "५", "content_sanskrit": "याः तु ता लोकनाथेन नाथवत्यः पुराऽभवन् ।\nतास्त्वनाथास्तदा नाथं पार्थं दृष्ट्वा विचुक्रुशुः\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2213986, "chapter_id": 5573, "verse_number": "६", "content_sanskrit": "षोडशस्त्रीसहस्राणि वासुदेवपरिग्रहाः ।\nतासामासीन्महान्नादो दृष्ट्वैवार्जुनमागतम्\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2213987, "chapter_id": 5573, "verse_number": "७", "content_sanskrit": "तास्तु दृष्ट्वैव कौरव्यो बाष्पेणापिहितेक्षणः ।\nहीनाः कृष्णेन पुत्रैश्च नाशकत् सोभिवीक्षितुम्\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2213988, "chapter_id": 5573, "verse_number": "८", "content_sanskrit": "स तां वृष्ण्यन्धकजलां हयमीनां रथोडुपाम् ।\nवादित्ररथघोषौघां वेश्मतीर्थमहाग्रहाम्\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2213989, "chapter_id": 5573, "verse_number": "९", "content_sanskrit": "रत्नशैवलसङ्घातां वज्रप्राकारमालिनीम् ।\nरथ्यास्रोतोजलावर्तां चत्वरस्तिमितह्रदाम्\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2213990, "chapter_id": 5573, "verse_number": "१०", "content_sanskrit": "रामकृष्णमहाग्राहां द्वारकां सरितं तदा ।\nकालपाशग्रहां भीमां नदीं वैतरणीमिव\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2213991, "chapter_id": 5573, "verse_number": "११", "content_sanskrit": "ददर्श वासविर्धीमान् विहीनां वृष्णिपुङ्गवैः ।\nगतश्रियं निरानन्दां पद्मिनीं शिशिरे यथा\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2213992, "chapter_id": 5573, "verse_number": "१२", "content_sanskrit": "तां दृष्ट्वा द्वारकां पार्थस्ताश्च कृष्णस्य योषितः ।\nसस्वनं बाष्पमुत्सृज्य निपपात महीतळे\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2213993, "chapter_id": 5573, "verse_number": "१३", "content_sanskrit": "सात्राजिती सत्यभामा रुग्मिणी च विशाम्पते ।\nअभिपत्य प्ररुरुदुः परिवार्य धनञ्जयम्\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2213994, "chapter_id": 5573, "verse_number": "१४", "content_sanskrit": "ततस्तं काञ्चने पीठे समुत्थाप्योपवेश्य च ।\nअभिनन्द्य महात्मानं परिवार्योपतस्थिरे\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2213995, "chapter_id": 5573, "verse_number": "१५", "content_sanskrit": "ततः संस्तूय गोविन्दं कथयित्वा च पाण्डवः ।\nआश्वास्य ताः स्त्रियश्चापि मातुलं द्रष्टुमभ्यगात्\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2213996, "chapter_id": 5573, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् मौसलपर्वणि\nअर्जुनस्य द्वारकागमनं नाम षष्ठोऽध्यायः ॥६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]