[{"id": 2097205, "chapter_id": 3083, "verse_number": "१३-२१३-१", "content_sanskrit": "उमोवाच।\nदेवदेव महादेव सर्वदेवनमस्कृत।\nयानि धर्मरहस्यानि श्रोतुमिच्छामि तान्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2097206, "chapter_id": 3083, "verse_number": "१३-२१३-२x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2097207, "chapter_id": 3083, "verse_number": "१३-२१३-२", "content_sanskrit": "रहस्यं श्रूयतां देवि मानुषाणां सुखावहम्।\nनपुंसकेषु वन्ध्यासु वियोनौ पृथिवीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2097208, "chapter_id": 3083, "verse_number": "१३-२१३-३", "content_sanskrit": "उत्सर्गो रेतसस्तेषु न कार्यो धर्मकाङ्क्षिभिः।\nएतेषु बीजं प्रक्षिप्तं न च रोहति वै प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2097209, "chapter_id": 3083, "verse_number": "१३-२१३-४", "content_sanskrit": "यत्र वा तत्र वा बीजं धर्मार्थीं नोत्सृजेत्पुनः।\nनरो बीजविनाशेन लिप्यते ब्रह्महत्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2097210, "chapter_id": 3083, "verse_number": "१३-२१३-५", "content_sanskrit": "अहिंसा परमो धर्म अहिंसा परमं सुखम्।\nअहिंसा धर्मशास्त्रेषु सर्वेषु परमं पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2097211, "chapter_id": 3083, "verse_number": "१३-२१३-६", "content_sanskrit": "देवतातिथिशुश्रूषा सततं धर्मशीलता।\nवेदाध्ययनयज्ञाश्च तपो दानं दमस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2097212, "chapter_id": 3083, "verse_number": "१३-२१३-७", "content_sanskrit": "आचार्यगुरुशुश्रूषा तीर्थाभिगमनं तथा।\nअहिंसाया वरारोहे कलां नार्हन्ति षोडशीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2097213, "chapter_id": 3083, "verse_number": "१३-२१३-८", "content_sanskrit": "एतत्ते परमं गुह्यमाख्यातं परमार्चितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2097214, "chapter_id": 3083, "verse_number": "१३-२१३-९x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2097215, "chapter_id": 3083, "verse_number": "१३-२१३-९", "content_sanskrit": "यद्यधर्मस्तु हिंसायां किमर्थममरोत्तम।\nयज्ञेषु पशुबन्धेषु हन्यन्ते पशवो द्विजैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2097216, "chapter_id": 3083, "verse_number": "१३-२१३-१०", "content_sanskrit": "कथं च भगवन्भूयो हिंसमाना नराधिपाः।\nस्वर्गं सुदुर्गमं यान्ति तदा स्म रिपुसूदन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2097217, "chapter_id": 3083, "verse_number": "१३-२१३-११", "content_sanskrit": "यस्यैव गोसहस्राणि विंशतिः स्वादिकानि तु।\nअहन्यहनि हन्यन्ते द्विजानां मांसकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2097218, "chapter_id": 3083, "verse_number": "१३-२१३-१२", "content_sanskrit": "समांसं तु स दत्त्वाऽन्नं रन्तिदेवो नराधिपः।\nकथं स्वर्गमनुप्राप्तः परं कौतूहलं हि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2097219, "chapter_id": 3083, "verse_number": "१३-२१३-१३", "content_sanskrit": "किन्तु धर्मं न शृण्वन्ति न श्रद्दधति वा श्रुतम्।\nमृयां वै विनिर्गत्य मृगान्हन्ति नराधिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2097220, "chapter_id": 3083, "verse_number": "१३-२१३-१४", "content_sanskrit": "एतत्सर्वं विशेषेण विस्तरेण वृषध्वज।\nश्रोतुमिच्छामि सर्वज्ञ तत्त्वमद्य ममोच्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2097221, "chapter_id": 3083, "verse_number": "१३-२१३-१५x", "content_sanskrit": "ईश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2097222, "chapter_id": 3083, "verse_number": "१३-२१३-१५", "content_sanskrit": "बहुमान्यमिदं देवि नास्ति कश्चिदहिंसकः।\nश्रूयतां कारणं चात्र यथाऽनेकविधं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2097223, "chapter_id": 3083, "verse_number": "१३-२१३-१६", "content_sanskrit": "दृश्यते चापि लोकेऽस्मिन्न हि कश्चिदहिंसकः।\nधरणीसंश्रिता देवि सुसूक्ष्मांश्चैव मध्यमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2097224, "chapter_id": 3083, "verse_number": "१३-२१३-१७", "content_sanskrit": "सञ्चरंश्चरणाभ्यां च हन्ति जीवाननेकशः।\nअज्ञानाज्ज्ञानतो वाऽपि यो जीवः शयनासनात्।\nउपाविशञ्शयानश्च हन्ति जीवाननेकशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2097225, "chapter_id": 3083, "verse_number": "१३-२१३-१८", "content_sanskrit": "शिरोवस्त्रेषु ये जीवा नरणां स्वेदसम्भवाः।\nतांश्च हिंसन्ति सततं दंशांश्च मशकानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2097226, "chapter_id": 3083, "verse_number": "१३-२१३-१९", "content_sanskrit": "जले जीवास्तथाऽऽकाशे पृथिवी जीवमालिनी।\nएवं जीवाकुले लोके कोसौ स्याद्यस्त्वहिंसकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2097227, "chapter_id": 3083, "verse_number": "१३-२१३-२०", "content_sanskrit": "स्थूलमध्यमसूक्ष्मैश्च स्वेदवारिमहीरुहैः।\nदृश्यरूपैरदृश्यैश्च नानारूपैश्च भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2097228, "chapter_id": 3083, "verse_number": "१३-२१३-२१", "content_sanskrit": "जीवैस्ततमिदं सर्वमाकाशं पृथिवी तथा।\nअन्योन्यं ते च हिंसन्ति दुर्बलान्बलवत्तराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2097229, "chapter_id": 3083, "verse_number": "१३-२१३-२२", "content_sanskrit": "मत्स्या मत्स्यान्ग्रसन्तीह खगाश्चैव खगांस्तथा।\nसरीसृपैश्च जीवन्ति कपोताद्या विहङ्गमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2097230, "chapter_id": 3083, "verse_number": "१३-२१३-२३", "content_sanskrit": "भूचराः खेचराश्चान्ये क्रव्यादा मांसगृद्धिनः।\nसमृद्धाः परमांसैस्तु भक्षेरंस्तेऽपि चापरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2097231, "chapter_id": 3083, "verse_number": "१३-२१३-२४", "content_sanskrit": "सत्वैः सत्वानि जीवन्ति शतशोथ सहस्रशः।\nअपीडयित्वा नैवान्यं जीवा जीवन्ति सुन्दरि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2097232, "chapter_id": 3083, "verse_number": "१३-२१३-२५", "content_sanskrit": "स्थूलकायस्य सत्वस्य खरस्य महिषस्य च।\nजीवस्यैकस्य मांसेन पयसा रुधिरेण वा।\nतृप्यन्ते बहवो जीवाः क्रव्यादा मांसजीविनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2097233, "chapter_id": 3083, "verse_number": "१३-२१३-२६", "content_sanskrit": "एको जीवसहस्राणि सदा खादति मानवः।\nअन्नाद्यस्य च भोगेन दान्यसंज्ञानि यानि तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2097234, "chapter_id": 3083, "verse_number": "१३-२१३-२७", "content_sanskrit": "मांसधान्यैः सबीजैश्च भोजनं परिवर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2097235, "chapter_id": 3083, "verse_number": "१३-२१३-२८", "content_sanskrit": "त्रिरात्रं पञ्चरात्रं वा सप्तरात्रं तथाऽपि वा।\nधान्यानि यो न हिंसेताहिंसकः परिकीर्तितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2097236, "chapter_id": 3083, "verse_number": "१३-२१३-२९", "content_sanskrit": "नाश्नाति यावतो जीवस्तावत्पुण्येन युज्यते।\nआहारस्य वियोगेन शरीरं परितप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2097237, "chapter_id": 3083, "verse_number": "१३-२१३-३०", "content_sanskrit": "तप्यमाने शरीरे तु शरीरे चेन्द्रियाणि तु।\nवशे तिष्ठन्ति सुश्रोणि नृपाणामिव किंकराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2097238, "chapter_id": 3083, "verse_number": "१३-२१३-३१", "content_sanskrit": "निरुणद्धीन्द्रियाण्येव स सुखी स विचक्षणः।\nइन्द्रियाणां निरोधेन दानेन च दमेन च।\nनरः सर्वमवाप्नोति मनसा यद्यधिच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2097239, "chapter_id": 3083, "verse_number": "१३-२१३-३२", "content_sanskrit": "एवं मूलमर्हिसाया उपवासः प्रकीर्तितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2097240, "chapter_id": 3083, "verse_number": "१३-२१३-३३", "content_sanskrit": "आहारं कुरुते यस्तु भूमिमाक्रमते च यः।\nसर्वे ते हिंसका देवि यथा धर्मेषु दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2097241, "chapter_id": 3083, "verse_number": "१३-२१३-३४", "content_sanskrit": "यथैवाहिंसको देवि तत्वतो ज्ञायते नरः।\nतथा ते सम्प्रवक्ष्यामि श्रूयतां धर्मचारिणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2097242, "chapter_id": 3083, "verse_number": "१३-२१३-३५", "content_sanskrit": "फलानि मूलपर्णानि भस्म वा योपि भक्षयेत्।\nअलेख्यमिव निश्चेष्टं तं मन्येऽहमहिंसकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2097243, "chapter_id": 3083, "verse_number": "१३-२१३-३६", "content_sanskrit": "आरम्भा हिंसया युक्ता धूमेनाग्निरिवावृताः।\nतस्माद्यस्तु निराहारस्तं मन्येऽहमहिंसकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2097244, "chapter_id": 3083, "verse_number": "१३-२१३-३७", "content_sanskrit": "यस्तु सर्वं समुत्सृज्य दीक्षित्वा नियतः शुचिः।\nकृत्वा मण्डलमर्यादां सङ्कल्पं कुरुते नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2097245, "chapter_id": 3083, "verse_number": "१३-२१३-३८", "content_sanskrit": "यावज्जीवमनाशित्वा कालकाङ्क्षी दृढव्रतः।\nध्यानेन तपसा युक्तस्तं मन्येऽहमहिंसकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2097246, "chapter_id": 3083, "verse_number": "१३-२१३-३९", "content_sanskrit": "अन्यथा हि न पश्यामि नरो यः स्यादहिंसकः।\nबहु चिन्त्यमिदं देवि नास्ति कश्चिदहिंसकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2097247, "chapter_id": 3083, "verse_number": "१३-२१३-४०", "content_sanskrit": "यतो यतो महाभागे हिंसा स्यान्महती ततः।\nनिवृत्तो मधुमांसाभ्यां हिंसा त्वल्पतरा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2097248, "chapter_id": 3083, "verse_number": "१३-२१३-४१", "content_sanskrit": "निवृत्तिः परमो धर्मो निवृत्तिः परमं सुखम्।\nमनसा विनिवृत्तानां धर्मस्य निचयो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2097249, "chapter_id": 3083, "verse_number": "१३-२१३-४२", "content_sanskrit": "मनःपूर्वागमा धर्मा अधर्माश्च न संशयः।\nमनसा बध्यते चापि मुच्यते चापि मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2097250, "chapter_id": 3083, "verse_number": "१३-२१३-४३", "content_sanskrit": "निगृहीते भवेत्स्वर्गो विसृष्टे नरको ध्रुवः।\nघातकः शस्त्रमुद्यम्य मनसा चिन्तयेद्यदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2097251, "chapter_id": 3083, "verse_number": "१३-२१३-४४", "content_sanskrit": "आयुःक्षयं गतेऽन्येषां मृते तु प्रहराम्यहम्।\nइति यो घातको हन्यान्न स पापेन लिप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2097252, "chapter_id": 3083, "verse_number": "१३-२१३-४५", "content_sanskrit": "विधिना निहताः पूर्वं निमित्तं स तु घातकः।\nविधिर्हि बलवान्देवि दुस्त्यजं वै पुराकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2097253, "chapter_id": 3083, "verse_number": "१३-२१३-४६", "content_sanskrit": "जीवाः पुराकृतेनैव तिर्यग्योनिसरीसृपाः।\nनानायोनिषु जायन्ते स्वकर्मपरिवेष्टिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2097254, "chapter_id": 3083, "verse_number": "१३-२१३-४७", "content_sanskrit": "नानाविधविचित्राङ्गा नानाशौर्यपराक्रमाः।\nनानाभूमिप्रदेशेषु नानाहारश्च जन्तवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2097255, "chapter_id": 3083, "verse_number": "१३-२१३-४८", "content_sanskrit": "जायमानस्य जीवस्य मृत्युः पूर्वं प्रजायते।\nसुखं वा यदि वा दुःखं यथापूर्वं कृतं तु वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2097256, "chapter_id": 3083, "verse_number": "१३-२१३-४९", "content_sanskrit": "प्राप्नुवन्ति नरा मृत्युं यदा यत्र च येन च।\nनातिक्रान्तुं हि शक्यः स्यान्निदेशः पूर्वकर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2097257, "chapter_id": 3083, "verse_number": "१३-२१३-५०", "content_sanskrit": "अप्रमत्तः प्रमत्तेषु विधिर्जागर्ति जन्तुषु।\nन हि तस्य प्रियः कश्चिन्न द्वेष्यो न च मध्यमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2097258, "chapter_id": 3083, "verse_number": "१३-२१३-५१", "content_sanskrit": "समः सर्वेषु भूतेषु कालः कालं निरीक्षते।\nगतायुषो ह्याक्षिपते जीवः सर्वस्य देहिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2097259, "chapter_id": 3083, "verse_number": "१३-२१३-५२", "content_sanskrit": "यथा येन च मर्तव्यं नान्यथा म्रियते हि सः।\nदृश्यते न च लोकेऽस्मिन्भूतो भव्यो द्विधा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2097260, "chapter_id": 3083, "verse_number": "१३-२१३-५३", "content_sanskrit": "विज्ञानैर्विक्रमैर्वाऽपि नानामन्त्रौषधैरपि।\nयो हि वञ्चयितुं शक्तो विधेस्तु नियतां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2097261, "chapter_id": 3083, "verse_number": "१३-२१३-५४", "content_sanskrit": "एष तेऽभिहितो देवि जीवहिंसाविधिक्रमः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2097262, "chapter_id": 3083, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि त्रयोदसाधिकद्विशततमोऽध्यायः॥ २१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]