[{"id": 2209806, "chapter_id": 5486, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2209807, "chapter_id": 5486, "verse_number": "१", "content_sanskrit": "ततो बहुविधं भीरुर्विलप्य कमलेक्षणा ।\nमुमोह दुःखाद् दुर्धर्षा निपपात च भूतले ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2209808, "chapter_id": 5486, "verse_number": "२", "content_sanskrit": "प्रतिलभ्य च सा सञ्ज्ञां देवी दिव्यवपुर्धरा ।\nउलूपीं पन्नगसुतां दृष्ट्वेदं वाक्यमब्रवीत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2209809, "chapter_id": 5486, "verse_number": "", "content_sanskrit": "चित्राङ्गदा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2209810, "chapter_id": 5486, "verse_number": "३", "content_sanskrit": "उलूपि पश्य भर्तारं शयानं निहतं रणे ।\nत्वत्कृते मम पुत्रेण बाणेन समितिञ्जयम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2209811, "chapter_id": 5486, "verse_number": "४", "content_sanskrit": "ननु त्वमार्या धर्मज्ञा ननु चासि पतिव्रता ।\nयत् त्वत्कृतेऽयं पतितः पतिस्ते निहतो रणे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2209812, "chapter_id": 5486, "verse_number": "५", "content_sanskrit": "किं नु मन्दोऽपराद्धोऽयं यदि तेऽद्य धनञ्जयः ।\nउलूपि याच्यमाना मे सञ्जीवय धनञ्जयम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2209813, "chapter_id": 5486, "verse_number": "६", "content_sanskrit": "ननु त्वमार्या धर्मज्ञा त्रैलोक्यविदितं शुभे ।\nयद् घातयित्वा भर्तारं पुत्रेण न हि शोचसि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2209814, "chapter_id": 5486, "verse_number": "७", "content_sanskrit": "नाहं शोचामि तनयं निहतं पन्नगात्मजे ।\nपतिमेव तु शोचामि यस्यातिथ्यमिदं कृतम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2209815, "chapter_id": 5486, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2209816, "chapter_id": 5486, "verse_number": "८", "content_sanskrit": "इत्युक्त्वा सा तदा देवीमुलूपीं पन्नगात्मजाम् ।\nभर्तारमभिगम्येदमित्युवाच यशस्विनी ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2209817, "chapter_id": 5486, "verse_number": "", "content_sanskrit": "चित्राङ्गदा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2209818, "chapter_id": 5486, "verse_number": "९", "content_sanskrit": "उत्तिष्ठ कुरुमुख्य त्वं प्रियकाम मम प्रिय ।\nअयमश्वो महाबाहो मया ते परिमोक्षितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2209819, "chapter_id": 5486, "verse_number": "१०", "content_sanskrit": "ननु नाम त्वया वीर धर्मराजस्य याज्ञियः ।\nअयमश्वोऽनुसर्तव्यः संशेषे किं महीतले ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2209820, "chapter_id": 5486, "verse_number": "११", "content_sanskrit": "त्वयि प्राणाः समायत्ताः कुरूणां कुरुवर्धन ।\nस कस्मात् प्राणदोऽन्येषां प्राणान् सन्त्यक्तवानसि ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2209821, "chapter_id": 5486, "verse_number": "१२", "content_sanskrit": "उलूपि साधु सम्पश्य भर्तारं निहतं रणे ।\nपुत्रं चैनं समुत्साह्य पातयित्वा न शोचसि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2209822, "chapter_id": 5486, "verse_number": "१३", "content_sanskrit": "कामं स्वपितु बालोऽयं भूमौ प्रेतगतिं गतः ।\nलोहिताक्षो गुडाकेशो विजयः साधु जीवतु ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2209823, "chapter_id": 5486, "verse_number": "१४", "content_sanskrit": "नापराधोऽस्ति सुभगे नराणां बहुभार्यता ।\nनारीणां न भवत्येतन्मा ते भूद् बुद्धिरीदृशी ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2209824, "chapter_id": 5486, "verse_number": "१५", "content_sanskrit": "सख्यं चैतत् कृतं धात्रा शाश्वतं चाव्ययं च तत् ।\nसख्यं समभिजानीहि सत्यं सङ्गतमस्तु ते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2209825, "chapter_id": 5486, "verse_number": "१६", "content_sanskrit": "पुत्रेण पातयित्वेमं पतिं यदि न लज्जसे ।\nजीवितं दर्शयस्वाद्य परित्यक्ष्यामि जीवितम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2209826, "chapter_id": 5486, "verse_number": "१७", "content_sanskrit": "साऽहं दुःखान्विता भीरुः पतिपुत्रविनाकृता ।\nइहैव प्रायमासिष्ये पश्यन्त्यास्ते न संशयः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2209827, "chapter_id": 5486, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2209828, "chapter_id": 5486, "verse_number": "१८", "content_sanskrit": "इत्युक्त्वा पन्नगसुतां सपत्नी चैत्रवाहिनी ।\nततः प्रायमुपासीना तूष्णीमासीज्जनाधिप ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2209829, "chapter_id": 5486, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अश्वसञ्चरणे चित्राङ्गदाप्रायोपवेशो नाम अशीतितमोऽध्यायः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]