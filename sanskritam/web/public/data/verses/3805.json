[{"id": 2130085, "chapter_id": 3805, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2130086, "chapter_id": 3805, "verse_number": "१", "content_sanskrit": "तत्र ते पुरुषव्याघ्राः परमं शौचमास्थिताः ।\nषड्रात्रमवसन् वीरा धनञ्जयदिदृक्षवः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2130087, "chapter_id": 3805, "verse_number": "२", "content_sanskrit": "तस्मिन् विहरमाणाश्च रममाणाश्च पाण्डवाः ।\nमनोज्ञे काननवरे सर्वभूतमनोरमे\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2130088, "chapter_id": 3805, "verse_number": "३", "content_sanskrit": "पादपैः पुष्पविकचैः फलभारावनामितैः ।\nशोभितं सर्वतो रम्यं पुंस्कोकिलविराजितम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2130089, "chapter_id": 3805, "verse_number": "४", "content_sanskrit": "स्निग्धपत्रैरविरळैः शीतच्छायैर्मनोरमैः ।\nसरांसि च विचित्राणि प्रसन्नसलिलानि च\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2130090, "chapter_id": 3805, "verse_number": "५", "content_sanskrit": "कमलैः सोत्पलैस्तत्र भ्राजमानानि सर्वशः ।\nपश्यन्तश्चारुरूपाणि रेमिरे तत्र पाण्डवाः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2130091, "chapter_id": 3805, "verse_number": "६", "content_sanskrit": "पुण्यगन्धः सुखस्पर्शो ववौ तत्र समीरणः ।\nह्लादयन् पाण्डवान् सर्वान् सकृष्णान् सद्विजर्षभान्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2130092, "chapter_id": 3805, "verse_number": "७", "content_sanskrit": "ततः पूर्वोत्तरे वायुः प्लवमानो यदृच्छया ।\nसहस्रपत्रमर्काभं दिव्यं पद्ममुपाहरत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2130093, "chapter_id": 3805, "verse_number": "८", "content_sanskrit": "तदवैक्षत पाञ्चाली दिव्यगन्धं मनोरमम् ।\nअनिलेनाहृतं भूमौ पतितं जलजं शुचि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2130094, "chapter_id": 3805, "verse_number": "९", "content_sanskrit": "तच्छुभा शुभमासाद्य सौगन्धिकमनुत्तमम् ।\nअतीव मुदिता राजन् भीमसेनमथाब्रवीत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2130095, "chapter_id": 3805, "verse_number": "१०", "content_sanskrit": "पश्य दिव्यं सुरुचिरं भीम पुष्पमनुत्तमम् ।\nगन्धसंस्थानसम्पन्नं मनसो मम नन्दनम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2130096, "chapter_id": 3805, "verse_number": "११", "content_sanskrit": "इदं च धर्मराजाय प्रदास्यामि परन्तप ।\nहरेदं मम कामाय काम्यके पुनराश्रमे ।\nगृह्यापराणि पुष्पाणि बहूनि पुरुषर्षभ\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2130097, "chapter_id": 3805, "verse_number": "१२", "content_sanskrit": "यदि तेऽहं प्रिया पार्थ बहूनीमान्युपाहर ।\nतान्यहं नेतुमिच्छामि काम्यकं पुनराश्रमम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2130098, "chapter_id": 3805, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2130099, "chapter_id": 3805, "verse_number": "१३", "content_sanskrit": "एवमुक्त्वा शुभापाङ्गी भीमसेनमनिन्दिता ।\nजगाम पुष्पमादाय धर्मराजाय तत् तदा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2130100, "chapter_id": 3805, "verse_number": "१४", "content_sanskrit": "अभिप्रायं तु विज्ञाय महिष्याः पुरुषर्षभः ।\nप्रियायाः प्रियकामः स प्रायाद् भीमो महाबलः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2130101, "chapter_id": 3805, "verse_number": "१५", "content_sanskrit": "वातं तमेवाभिमुखो यतस्तत्पुष्पमागतम् ।\nआजिहीर्षुर्जगामाशु स पुष्पाण्यपराण्यपि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2130102, "chapter_id": 3805, "verse_number": "१६", "content_sanskrit": "रुक्मपृष्ठं धनुर्गृह्य शरांश्चाशीविषोपमान् ।\nमृगराडिव सङ्क्रुद्धः प्रभिन्न इव कुञ्जरः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2130103, "chapter_id": 3805, "verse_number": "", "content_sanskrit": "व्यनदत् स महानादं भीमसेनो महाबलः ।\nददृशुः सर्वभूतानि महाबाणधनुर्धरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2130104, "chapter_id": 3805, "verse_number": "", "content_sanskrit": "न ग्लानिर्न च वैक्लव्यं न भयं न च सम्भ्रमः ।\nकदाचिज्जुषते पार्थमात्मजं मातरिश्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2130105, "chapter_id": 3805, "verse_number": "१७", "content_sanskrit": "द्रौपद्याः प्रियमन्विच्छन् स बाहुबलमाश्रितः ।\nव्यपेतभयसम्मोहः शैलमभ्यपतद् बली\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2130106, "chapter_id": 3805, "verse_number": "१८", "content_sanskrit": "लतागुल्मतृणच्छन्नम् इन्द्रनीलशिलातळम् ।\nगिरिं चचारारिहरः किन्नराचरितं शुभम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2130107, "chapter_id": 3805, "verse_number": "१९", "content_sanskrit": "नानावर्णधरैश्चित्रं धातुद्रुममृगाण्डजैः ।\nसर्वभूषणसम्पूर्णं भूमेर्भुजमिवोच्छ्रितम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2130108, "chapter_id": 3805, "verse_number": "२०", "content_sanskrit": "सर्वत्र रमणीयेषु गन्धमादनसानुषु ।\nसक्तचक्षुरभिप्रायान् हृदयेनानुचिन्तयन्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2130109, "chapter_id": 3805, "verse_number": "२१", "content_sanskrit": "पुंस्कोकिलनिनादेषु षट्पदाचरितेषु च ।\nबद्धश्रोत्रमनश्चक्षुर्जगामामितविक्रमः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2130110, "chapter_id": 3805, "verse_number": "२२", "content_sanskrit": "आजिघ्रन् स महातेजाः सर्वर्तुकुसुमोद्भवम् ।\nगन्धमुद्धतमुद्दामो वने मत्त इव द्विपः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2130111, "chapter_id": 3805, "verse_number": "२३", "content_sanskrit": "पितुः संस्पर्शशीतेन गन्धमादनवायुना ।\nह्रियमाणश्रमः पित्रा सम्प्रहृष्टतनूरुहः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2130112, "chapter_id": 3805, "verse_number": "२४", "content_sanskrit": "स यक्षगन्धर्वसुरब्रह्मर्षिगणसेवितम् ।\nविलोकयामास तदा पुष्पहेतोररिन्दमः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2130113, "chapter_id": 3805, "verse_number": "२५", "content_sanskrit": "विषमच्छदैरचितैरनुलिप्त इवाङ्गुलैः ।\nवलिभिर्धातुविच्छेदैः काञ्चनाञ्जनराजतैः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2130114, "chapter_id": 3805, "verse_number": "२६", "content_sanskrit": "सपक्षमिव नृत्यन्तं पार्श्वलग्नैः पयोधरैः ।\nमुक्ताहारैरिव चितं च्युतैः प्रस्रवणोदकैः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2130115, "chapter_id": 3805, "verse_number": "२७", "content_sanskrit": "अभिरामदरीकुञ्जनिर्झरोदककन्दरम् ।\nअप्सरोनूपुररवैः प्रनृत्तवरबर्हिणम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2130116, "chapter_id": 3805, "verse_number": "२८", "content_sanskrit": "दिग्वारणविषाणाग्रैर्घृष्टोपलशिलातलम् ।\nस्रस्तांशुकमिवाक्षोभ्यैर्निम्नगानिःसृतैर्जलैः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2130117, "chapter_id": 3805, "verse_number": "२९", "content_sanskrit": "सशष्पकवलैः स्वस्थैरदूरपरिवर्तिभिः ।\nभयानभिज्ञैर्हरिणैः कौतूहलनिरीक्षितः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2130118, "chapter_id": 3805, "verse_number": "३०", "content_sanskrit": "चालयानः स्व(यन्नुरु)वेगेन लताजालान्यनेकशः ।\nआक्रीडमानो हृष्टात्मा श्रीमान् वायुसुतो ययौ\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2130119, "chapter_id": 3805, "verse_number": "३१", "content_sanskrit": "प्रियामनोरथं कर्तुमुद्यतश्चारुलोचनः ।\nप्रांशुः कनकवर्णाभः सिंहसंहननो युवा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2130120, "chapter_id": 3805, "verse_number": "३२", "content_sanskrit": "मत्तवारणविक्रान्तो मत्तवारणवेगवान् ।\nमत्तवारणताम्राक्षो मत्तवारणवारणः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2130121, "chapter_id": 3805, "verse_number": "३३", "content_sanskrit": "प्रियपार्श्वोपविष्टाभिर्व्यावृत्ताभिर्विचेष्टितैः ।\nयक्षगन्धर्वयोषाभिरदृश्याभिर्निरीक्षितः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2130122, "chapter_id": 3805, "verse_number": "३४", "content_sanskrit": "नवावतारो रूपस्य विक्रीडन्निव पाण्डवः ।\nचचार रमणीयेषु गन्धमादनसानुषु\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2130123, "chapter_id": 3805, "verse_number": "३५", "content_sanskrit": "संस्मरन् विविधान् क्लेशान् दुर्योधनकृतान् बहून् ।\nद्रौपद्या वनवासिन्याः प्रियं कर्तुं समुद्यतः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2130124, "chapter_id": 3805, "verse_number": "३६", "content_sanskrit": "सोऽचिन्तयद् गते स्वर्गमर्जुने मयि चागते ।\nपुष्पहेतोः कथं त्वार्यः करिष्यति युधिष्ठिरः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2130125, "chapter_id": 3805, "verse_number": "३७", "content_sanskrit": "स्नेहात् नरवरो नूनमविश्वासाद् बलस्य च ।\nनकुलं सहदेवं च न मोक्ष्यति युधिष्ठिरः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2130126, "chapter_id": 3805, "verse_number": "३८", "content_sanskrit": "कथं तु कुसुमावाप्तिः स्याच्छीघ्रमिति चिन्तयन् ।\nप्रतस्थे नरशार्दूलः पक्षिराडिव वेगितः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2130127, "chapter_id": 3805, "verse_number": "३९", "content_sanskrit": "सज्जमानमनोदृष्टिः फुल्लेषु गिरिसानुषु ।\nद्रौपदीवाक्यपाथेयो भीमः शीघ्रतरं ययौ\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2130128, "chapter_id": 3805, "verse_number": "४०", "content_sanskrit": "कम्पयन् मेदिनीं पद्भ्यां निर्घात इव पर्वसु ।\nत्रासयन् गजयूथानि वातरंहा वृकोदरः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2130129, "chapter_id": 3805, "verse_number": "", "content_sanskrit": "सिंहव्याघ्रमृगांश्चैव मर्दयानो महाबलः ।\nउन्मूलयन्महावृक्षान्पोथयंस्तरसा बली।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2130130, "chapter_id": 3805, "verse_number": "४१", "content_sanskrit": "लतावल्लीश्च वेगेन विकर्षन् पाण्डुनन्दनः ।\nउपर्युपरि शैलाग्रमारुरुक्षुरिव द्विपः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2130131, "chapter_id": 3805, "verse_number": "४२", "content_sanskrit": "जलावलम्बो(विनर्दमानो)ऽतिभृशं सविद्युदिव तोयदः ।\nव्यनदत् सुमहानादं भीमसेनो महाबलः \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2130132, "chapter_id": 3805, "verse_number": "४३", "content_sanskrit": "तेन शब्देन महता भीमस्य प्रतिबोधिताः ।\nगुहाः सन्तत्यजुर्व्याघ्रा निलिल्युर्बिलवासिनः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2130133, "chapter_id": 3805, "verse_number": "४४", "content_sanskrit": "समुत्पेतुः खगास्त्रस्ता मृगयूथानि दुद्रुवुः ।\nऋक्षाश्चोत्ससृजुर्वृक्षांस्तत्यजुर्हरयो गुहाम् \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2130134, "chapter_id": 3805, "verse_number": "४५", "content_sanskrit": "व्यजृम्भन्त महासिंहा महिषाश्चावलोकयन्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2130135, "chapter_id": 3805, "verse_number": "४६", "content_sanskrit": "तेन वित्रासिता नागाः करेणुपरिवारिताः ।\nतद्वनं ते परित्यज्य जग्मुरन्यन्महावनम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2130136, "chapter_id": 3805, "verse_number": "४७", "content_sanskrit": "वराहमृगसङ्घाश्च महिषाश्च वनेचराः ।\nव्याघ्रगोमायुसङ्घाश्च प्रणेदुर्गवयैः सह \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2130137, "chapter_id": 3805, "verse_number": "४८", "content_sanskrit": "रथाङ्गसाह्वदात्यूहा हंसकारण्डवप्लवाः ।\nशुकाः पुंस्कोकिलाः क्रौञ्चा विसञ्ज्ञा भेजिरे दिशः ।\nतथान्ये दर्पिता नागाः करेणुशरपीडिताः \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2130138, "chapter_id": 3805, "verse_number": "४९", "content_sanskrit": "सिंहव्याघ्राश्च सङ्क्रुद्धा भीमसेनमथाद्रवन् ।\nशकृन्मूत्रं च मुञ्चाना भयविभ्रान्तमानसाः ।\nव्यादितास्या महारौद्रा व्यनदन् भीषणान् रवान्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2130139, "chapter_id": 3805, "verse_number": "५०", "content_sanskrit": "ततो वायुसुतः क्रोधात् स्वबाहुबलमाश्रितः ।\nगजेनान्यान् गजान् श्रीमान् सिंहं सिंहेन वा विभुः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2130140, "chapter_id": 3805, "verse_number": "५१", "content_sanskrit": "तळप्रहारैरन्यांश्च व्यहनत् पाण्डवो बली\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2130141, "chapter_id": 3805, "verse_number": "५२", "content_sanskrit": "ते वध्यमाना भीमेन सिंहव्याघ्रतरक्षवः ।\nभयाद् विससृपुः सर्वे शकृन्मूत्रं च सुस्रुवुः \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2130142, "chapter_id": 3805, "verse_number": "५३", "content_sanskrit": "प्रविवेश ततः क्षिप्रं तानपास्य महाबलः ।\nवनं पाण्डुसुतः श्रीमान् शब्देनापूरयन् दिशः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2130143, "chapter_id": 3805, "verse_number": "५४", "content_sanskrit": "अथापश्यन्महाबाहुर्गन्धमादनसानुषु ।\nसुरम्यं कदळीषण्डं बहुयोजनविस्तृतम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2130144, "chapter_id": 3805, "verse_number": "५५", "content_sanskrit": "तमभ्यगच्छद् वेगेन क्षोभयिष्यन् महाबलः ।\nमहागज इवास्रावी प्रभञ्जन् विविधान् द्रुमान्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2130145, "chapter_id": 3805, "verse_number": "५६", "content_sanskrit": "उत्पाट्य कदळीस्तम्भान् बहुताळसमुच्छ्रयान् ।\nचिक्षेप तरसा भीमः समन्ताद् बलिनां वरः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2130146, "chapter_id": 3805, "verse_number": "५७", "content_sanskrit": "महान्तमकरोत् तत्र कुरूणामृषभो बली ।\nविमर्दं सुमहातेजा नृसिंह इव दर्पितः \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2130147, "chapter_id": 3805, "verse_number": "५८", "content_sanskrit": "ततः सन्न्यपतंस्तत्र सुबहूनि सुमहान्ति च ।\nरुरुवारणसिंहांश्च महिषांश्च जलाश्रयाः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2130148, "chapter_id": 3805, "verse_number": "५९", "content_sanskrit": "प्रविवेश ततः क्षिप्रं तानपास्य महाबलः ।\nवनं पाण्डुसुतः श्रीमान् नादेनापूरयन् दिशः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2130149, "chapter_id": 3805, "verse_number": "६०", "content_sanskrit": "तेन शब्देन चैवाथ भीमसेनरवेण च ।\nवनान्तरगताश्चापि वित्रेसुर्मृगपक्षिणः \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2130150, "chapter_id": 3805, "verse_number": "६१", "content_sanskrit": "तं शब्दं सहसा श्रुत्वा मृगपक्षिसमीरितम् ।\nजलार्द्रपक्षा विहगाः समुत्पेतुः सहस्रशः \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2130151, "chapter_id": 3805, "verse_number": "६२", "content_sanskrit": "तानौदकान् पक्षिगणान् निरीक्ष्य भरतर्षभः ।\nतानेवानुसरन् रम्यं ददर्श सुमहत्सरः \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2130152, "chapter_id": 3805, "verse_number": "६३", "content_sanskrit": "काञ्चनैः कदळीषण्डैर्मन्दमारुतकम्पितैः ।\nवीज्यमानमिवाक्षोभ्यं तीरात् तीरविसर्पिभिः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2130153, "chapter_id": 3805, "verse_number": "६४", "content_sanskrit": "तत्सरोऽथावतीर्यैव प्रभूतनळिनोत्पलम् ।\nमहागज इवोद्दामश्चिक्रीड बलवद् बली\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2130154, "chapter_id": 3805, "verse_number": "६५", "content_sanskrit": "विक्रीड्य तस्मिन् सुचिरमुत्ततारामितद्युतिः ।\nक्षोभयन् सलिलं भीमः प्रभिन्न इव वारणः \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2130155, "chapter_id": 3805, "verse_number": "६६", "content_sanskrit": "ततो जगाहे वेगेन तद्वनं बहुपादपम् ।\nदध्मौ च शङ्खं स्वनवत् सर्वप्राणेन पाण्डवः \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2130156, "chapter_id": 3805, "verse_number": "", "content_sanskrit": "आस्फोटयच्च बलवान् भीमः संनादयन् दिशः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2130157, "chapter_id": 3805, "verse_number": "६७", "content_sanskrit": "तस्य शङ्खस्य शब्देन भीमसेनरवेण च ।\nबाहुशब्देन चोग्रेण नदन्तीव गिरेर्गुहाः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2130158, "chapter_id": 3805, "verse_number": "", "content_sanskrit": "ततः शङ्खस्वनं श्रुत्वा नर्दितं च मुहुर्मुहुः ।\nवृक्षाणां भज्यमानानां शब्दं श्रुत्वा तदा गिरौ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2130159, "chapter_id": 3805, "verse_number": "", "content_sanskrit": "गन्धमादनपार्श्वस्थो रामस्याभिमतः सखा ।\nहनूमान्नाम स कपिर्लाङ्गूलमधुनोत्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2130160, "chapter_id": 3805, "verse_number": "", "content_sanskrit": "तस्य दोधूयमानस्य लाङ्गूलं लीलया मुहुः ।\nतेन लाङ्गूलशब्देन स्वनन्तीव दिशो दश ।\nततः पृथ्वी च शैलाश्च प्रकम्पितमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2130161, "chapter_id": 3805, "verse_number": "६८", "content_sanskrit": "तं वज्रनिष्पेषसममास्फोटितमहारवम् ।\nश्रुत्वा शैलगुहासुप्तैः सिंहैर्मुक्तो महास्वनः \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2130162, "chapter_id": 3805, "verse_number": "६९", "content_sanskrit": "सिंहनादभयत्रस्तैः कुञ्जरैरपि भारत ।\nमुक्तो विरावः सुमहान् पर्वतो येन पूरितः \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2130163, "chapter_id": 3805, "verse_number": "७०", "content_sanskrit": "तं तु नादं ततः श्रुत्वा मुक्तं वानरपुङ्गवः ।\nप्राजृम्भत महाकायो हनूमान्नाम वानरः \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2130164, "chapter_id": 3805, "verse_number": "", "content_sanskrit": "दिवङ्गमं रुरोधाथ मार्गं भीमस्य कारणात् ।\nअनेन हि पथा मा वै गच्छेदिति विचार्य सः ।\nआस्त एकायने मार्गे कदळीषण्डमण्डिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2130165, "chapter_id": 3805, "verse_number": "", "content_sanskrit": "भ्रातुर्भीमस्य रक्षार्थं तं मार्गमवरुघ्य वै ।\nमाऽत्र प्राप्स्यति शापं वा धर्षणां वेति पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2130166, "chapter_id": 3805, "verse_number": "७१", "content_sanskrit": "कदळीषण्डमध्यस्थो ह्येवं सञ्चिन्त्य वानरः ।\nभ्रातरं भीमसेनं तु विज्ञाय हनुमान् कपिः \t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2130167, "chapter_id": 3805, "verse_number": "७२", "content_sanskrit": "जृम्भमाणः सुविपुलं शक्रध्वजमिवोच्छ्रितम् ।\nआस्फोटयच्च लाङ्गूलमिन्द्राशनिसमस्वनम्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2130168, "chapter_id": 3805, "verse_number": "७३", "content_sanskrit": "तस्य लाङ्गूलनिनदं पर्वतः सुगुहामुखैः ।\nहुङ्कारमिव गौर्नर्दन्नुत्ससर्ज समन्ततः \t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2130169, "chapter_id": 3805, "verse_number": "७४", "content_sanskrit": "स लाङ्गूलरवस्तस्य मत्तवारणनिस्वनम् ।\nअन्तर्धाय विचित्रेषु चचार गिरिसानुषु\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2130170, "chapter_id": 3805, "verse_number": "", "content_sanskrit": "तस्य श्रुत्वा तु निनदं महामेघरवस्वनम् ।\nप्रतिनेदुर्गजाः सिंहा वित्रेसुश्च मृगद्विजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2130171, "chapter_id": 3805, "verse_number": "७५", "content_sanskrit": "स भीमसेनस्तच्छ्रुत्वा सम्प्रहृष्टतनूरुहः ।\nशब्दप्रभवमन्विच्छंश्चचार कदळीवनम्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2130172, "chapter_id": 3805, "verse_number": "७६", "content_sanskrit": "लाङ्गूलास्फोटशब्दाच्च चलितः स महागिरिः ।\nविघूर्णमानः सहसा समन्ताच्च व्यशीर्यत \t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2130173, "chapter_id": 3805, "verse_number": "७७", "content_sanskrit": "कदळीवनमध्यस्थविपिने सशिलातळे ।\nददर्श सुमहाबाहुर्वानराधिपतिं तदा\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2130174, "chapter_id": 3805, "verse_number": "७८", "content_sanskrit": "विद्युत्सम्पातनिनदं विद्युत्सम्पातचञ्चलम्\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2130175, "chapter_id": 3805, "verse_number": "७९", "content_sanskrit": "बाहुस्वस्तिकविन्यस्तपीनह्रस्वशिरोधरम् ।\nस्कन्धभूयिष्ठकायत्वात् तनुमध्यकटीतटम्\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2130176, "chapter_id": 3805, "verse_number": "८०", "content_sanskrit": "किञ्चिच्चाभुग्नशीर्षेण दीर्घरोमाञ्चितेन च ।\nलाङ्गूलेनोर्ध्वगतिना ध्वजेनेव विराजितम्\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2130177, "chapter_id": 3805, "verse_number": "८१", "content_sanskrit": "ह्रस्वौष्ठं ताम्रजिह्वास्यं रक्तकर्णं चलद्भ्रुवम् ।\nअपश्यद् वदनं तस्य रश्मिवन्तमिवोडुपम्\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2130178, "chapter_id": 3805, "verse_number": "८२", "content_sanskrit": "वदनाभ्यन्तरगतैः शुक्लैर्दन्तैरलङ्कृतम् ।\nकेसरोत्करसम्मिश्रमशोकानामिवोत्करम्\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2130179, "chapter_id": 3805, "verse_number": "८३", "content_sanskrit": "हिरण्मयीनां मध्यस्थं कदलीनां महाद्युतिम् ।\nदीप्यमानेन वपुषा स्वर्चिष्मन्तमिवानलम्\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2130180, "chapter_id": 3805, "verse_number": "८४", "content_sanskrit": "निरीक्षन्तममित्रघ्नं लोचनैर्मधुपिङ्गलैः\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2130181, "chapter_id": 3805, "verse_number": "८५", "content_sanskrit": "तं वानरवरं धीमानतिकायं महाबलम्\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2130182, "chapter_id": 3805, "verse_number": "८६", "content_sanskrit": "भीमो भीमबलस्तत्र प्रविष्टः कदलीवनम् ।\nअपश्यद् वानरं सुप्तमेकायनगते पथि ।\nतस्य प्रबोधनार्थाय सिंहनादमथाकरोत्\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2130183, "chapter_id": 3805, "verse_number": "८७", "content_sanskrit": "अथोपसृत्य तरसा विभीर्भीमस्ततो बली ।\nसिंहनादं चकारोग्रं वज्राशनिसमं बली ।\nतेन शब्देन भीमस्य वित्रेसुर्मृगपक्षिणः\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2130184, "chapter_id": 3805, "verse_number": "८८", "content_sanskrit": "हनूमांश्च महासत्त्व ईषदुन्मील्य लोचने ।\nदृष्ट्वा तमथ सावज्ञं लोचनैर्मधुपिङ्गलैः\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2130185, "chapter_id": 3805, "verse_number": "८९", "content_sanskrit": "ततः पवनजः श्रीमानन्तिकस्थं महौजसम् ।\nस्मितेन चैनमासाद्य हनूमानिदमब्रवीत्\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2130186, "chapter_id": 3805, "verse_number": "९०", "content_sanskrit": "किमर्थं सरुजस्तेऽहं सुखसुप्तः प्रबोधितः ।\nननु नाम त्वया कार्या दया भूतेषु जानता\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2130187, "chapter_id": 3805, "verse_number": "९१", "content_sanskrit": "वयं धर्मं न जानीमस्तिर्यग्योनिमुपाश्रिताः ।\nनरास्तु बुद्धिसम्पन्ना दयां कुर्वन्ति जन्तुषु\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2130188, "chapter_id": 3805, "verse_number": "९२", "content_sanskrit": "क्रूरेषु कर्मसु कथं देहवाक्चित्तदूषिषु ।\nधर्मघातिषु सज्जन्ते बुद्धिमन्तो भवद्विधाः \t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2130189, "chapter_id": 3805, "verse_number": "९३", "content_sanskrit": "न त्वं धर्मं विजानासि बुधा नोपासितास्त्वया ।\nअल्पबुद्धितया बाल्यादुत्सादयसि यन्मृगान्\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2130190, "chapter_id": 3805, "verse_number": "९४", "content_sanskrit": "ब्रूहि कस्त्वं किमर्थं वा किमिदं वनमागतः ।\nवर्जितं मानुषैर्भावैस्तथैव पुरुषैरपि\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2130191, "chapter_id": 3805, "verse_number": "९५", "content_sanskrit": "क्व च त्वयाद्य गन्तव्यं प्रब्रूहि पुरुषर्षभ ।\nअतः परमगम्योऽयं पर्वतः सुदुरारुहः \t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2130192, "chapter_id": 3805, "verse_number": "", "content_sanskrit": "विना सिद्धगतिं वीर गतिरत्र न विद्यते ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2130193, "chapter_id": 3805, "verse_number": "", "content_sanskrit": "देवलोकस्य मार्गोऽयमगम्यो मानुषैः सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2130194, "chapter_id": 3805, "verse_number": "९६", "content_sanskrit": "कारुण्यात् त्वामहं वीर वारयामि निबोध मे \t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2130195, "chapter_id": 3805, "verse_number": "९७", "content_sanskrit": "नातः परं त्वया शक्यं गन्तुमाश्वसिहि प्रभो ।\nस्वागतं सर्वथैवेह तवाद्य मनुजर्षभ\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2130196, "chapter_id": 3805, "verse_number": "९८", "content_sanskrit": "इमान्यमृतकल्पानि मूलानि च फलानि च ।\nभक्षयित्वा निवर्तस्व मा वृथा प्राप्स्यसे वधम्\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2130197, "chapter_id": 3805, "verse_number": "", "content_sanskrit": "ग्राह्यं यदि वचो मह्यं हितं मनुजपुङ्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2130198, "chapter_id": 3805, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि\nत्रिचत्वारिंशदधिकशततमोऽध्यायः ॥१४३॥\n॥ इति तीर्थयात्रापर्वणि एकोनशततमोऽध्यायः ॥९९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}]