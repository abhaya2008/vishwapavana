[{"id": 40023085, "chapter_id": 9422, "verse_number": "1", "content_sanskrit": "कस्यचित्त्वथ कालस्य रामे धर्मपरे स्थिते । कालस्तापसरूपेण राजद्वारमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40023086, "chapter_id": 9422, "verse_number": "2", "content_sanskrit": "सो ऽब्रवील्लक्ष्मणं वाक्यं धृतिमन्तं यशश्विनम् । मां निवेदय रामाय सम्प्राप्तं कार्यगौरवात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40023087, "chapter_id": 9422, "verse_number": "3", "content_sanskrit": "दूतो ऽस्म्यतिबलस्याहं महर्षेरमितौजसः । रामं दिदृक्षुरायातः कार्येण हि महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40023088, "chapter_id": 9422, "verse_number": "4", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा सौमित्रिस्त्वरया ऽन्वितः । न्यवेदयत रामाय तापसं तं समागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40023089, "chapter_id": 9422, "verse_number": "5", "content_sanskrit": "जयस्व राम धर्मेण उभौ लोकौ महाद्युते । दूतस्त्वां द्रष्टुमायातस्तपसा भास्करप्रभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40023090, "chapter_id": 9422, "verse_number": "6", "content_sanskrit": "तद्वाक्यं लक्ष्मणेनोक्तं श्रुत्वा राम उवाच ह । प्रवेश्यतां मुनिस्तात महौजास्तस्य वाक्यधृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40023091, "chapter_id": 9422, "verse_number": "7", "content_sanskrit": "सौमित्रिस्तु तथेत्युक्त्वा प्रावेशयत तं मुनिम् । ज्वलन्तमेव तेजोभिः प्रदहन्तमिवांशुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40023092, "chapter_id": 9422, "verse_number": "8", "content_sanskrit": "सो ऽभिगम्य रघुश्रेष्ठं दीप्यपानं स्वतेजसा । ऋषिर्मधुरया वाचा वर्धस्वेत्याह राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40023093, "chapter_id": 9422, "verse_number": "9", "content_sanskrit": "तस्मै रामो महातेजाः पूजामर्घ्यपुरोगमाम् । ददौ कुशलमव्यग्रं प्रष्टुमेवोपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40023094, "chapter_id": 9422, "verse_number": "10", "content_sanskrit": "पृष्टश्च कुशलं तेन रामेण वदतां वरः । आसने काञ्चने दिव्ये निषसाद महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40023095, "chapter_id": 9422, "verse_number": "11", "content_sanskrit": "तमुवाच ततो रामः स्वागतं ते महामुने । प्रापयास्य च वाक्यानि यतो दूतस्त्वमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40023096, "chapter_id": 9422, "verse_number": "12", "content_sanskrit": "चोदितो राजसिंहेन मुनिर्वाक्यमभाषत । द्वन्द्वमेतत्प्रवक्तव्यं हितं वै यद्यपेक्षसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40023097, "chapter_id": 9422, "verse_number": "13", "content_sanskrit": "यः शृणोति निरीक्षेद्वा स वध्यो भविता तव । भवेद्वै मुनिमुख्यस्य वचनं यद्यपेक्षसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40023098, "chapter_id": 9422, "verse_number": "14", "content_sanskrit": "स तथेति प्रतिज्ञाय रामो लक्ष्मणमब्रवीत् । द्वारि तिष्ठ महाबाहो प्रतिहारं विसर्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40023099, "chapter_id": 9422, "verse_number": "15", "content_sanskrit": "स मे वध्यः खलु भवेत् कथाद्वन्द्वं समीरितम् । ऋषेर्मम च सौमित्रे पश्येद्वा शृणुयाच्च यः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40023100, "chapter_id": 9422, "verse_number": "16", "content_sanskrit": "ततो निक्षिप्य काकुत्स्थो लक्ष्मणं द्वारि सङ्ग्रहम् । तमुवाच मुने वाक्यं कथयस्वेति राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40023101, "chapter_id": 9422, "verse_number": "17", "content_sanskrit": "यत्ते मनीषितं वाक्यं येन वा ऽसि समाहितः । कथयस्वाविशङ्कस्त्वं ममापि हृदि वर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]