[{"id": 6000214000, "chapter_id": 10214, "verse_number": null, "content_sanskrit": "अथ अष्टादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000214001, "chapter_id": 10214, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.001.m4a", "display_order": 2}, {"id": 6000214002, "chapter_id": 10214, "verse_number": "१०-१८-१", "content_sanskrit": "ततः प्रावर्तत प्रावृट् सर्वसत्त्वसमुद्भवा।\nविद्योतमानपरिधिर्विस्फूर्जितनभःस्थला॥ १०/१८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.002.m4a", "display_order": 3, "topics": [{"text": "वर्षाकालशरत्कालयोर्वर्णनम्", "range": "१–४७"}]}, {"id": 6000214003, "chapter_id": 10214, "verse_number": "१०-१८-२", "content_sanskrit": "सान्द्रनीलाम्बुदैर्व्योम सविद्युत्स्तनयित्नुभिः।\nअस्पष्टज्योतिराच्छन्नं ब्रह्मेव सगुणं बभौ॥ १०/१८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.003.m4a", "display_order": 4}, {"id": 6000214004, "chapter_id": 10214, "verse_number": "१०-१८-३", "content_sanskrit": "अष्टौ मासान् निपीतं यद् भूम्यामुदमयं वसु।\nस्वगोभिर्मोक्तुमारेभे पर्जन्यः काल आगते॥ १०/१८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.004.m4a", "display_order": 5}, {"id": 6000214005, "chapter_id": 10214, "verse_number": "१०-१८-४", "content_sanskrit": "तटित्वन्तो महामेघाश्चण्डश्वसनवेपिताः।\nप्राणिनां जीवनं ह्यम्बु मुमुचुः करुणा इव॥ १०/१८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.005.m4a", "display_order": 6}, {"id": 6000214006, "chapter_id": 10214, "verse_number": "१०-१८-५", "content_sanskrit": "तपःकृशा देवमीढा आसीद् वर्षीयसी मही।\nयथैव काम्यतपसस्तनुः सम्प्राप्य तत्फलम्॥ १०/१८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.006.m4a", "display_order": 7}, {"id": 6000214007, "chapter_id": 10214, "verse_number": "१०-१८-६", "content_sanskrit": "निशामुखेषु खद्योतास्तमसा भान्ति न ग्रहाः।\nयथा पापेन पाखण्डा, न हि वेदाः कलौ युगे॥ १०/१८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.007.m4a", "display_order": 8}, {"id": 6000214008, "chapter_id": 10214, "verse_number": "१०-१८-७", "content_sanskrit": "श्रुत्वा पर्जन्यनिनदं मण्डूका व्यसृजन् गिरः।\nतूष्णीं शयानाः प्राग्, यद्वद् ब्राह्मणा नियमात्यये॥ १०/१८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.008.m4a", "display_order": 9}, {"id": 6000214009, "chapter_id": 10214, "verse_number": "१०-१८-८", "content_sanskrit": "आसन्नुत्पथवाहिन्यः क्षुद्रनद्योऽनुशुष्यतीः।\nपुंसो यथाऽस्वतन्त्रस्य देहो द्रविणसम्पदा॥ १०/१८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.009.m4a", "display_order": 10}, {"id": 6000214010, "chapter_id": 10214, "verse_number": "१०-१८-९", "content_sanskrit": "हरिता हरिभिः शष्पैरिन्द्रगोपैश्च लोहिता।\nउच्छिलीन्ध्रकृतच्छाया नृणां श्रीरिव भूरभूत्॥ १०/१८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.010.m4a", "display_order": 11}, {"id": 6000214011, "chapter_id": 10214, "verse_number": "१०-१८-१०", "content_sanskrit": "क्षेत्राणि सस्यसम्पद्भिः कर्षकाणां मुदं ददुः।\nमानिनामनुतापं वा विपत्तिं तदजानताम्॥ १०/१८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.011.m4a", "display_order": 12}, {"id": 6000214012, "chapter_id": 10214, "verse_number": "१०-१८-११", "content_sanskrit": "जलस्थलौकसः सर्वे नववारिनिषेवया।\nअबिभ्रन् रुचिरं रूपं यथा हरिनिषेवया॥ १०/१८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.012.m4a", "display_order": 13}, {"id": 6000214013, "chapter_id": 10214, "verse_number": "१०-१८-१२", "content_sanskrit": "सरिद्भिः सङ्गतः सिन्धुश्चुक्षोभ श्वसनोर्मिमान्।\nअपक्‍वयोगिनश्चित्तं कामार्तं गुणयुग् यथा॥ १०/१८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.013.m4a", "display_order": 14}, {"id": 6000214014, "chapter_id": 10214, "verse_number": "१०-१८-१३", "content_sanskrit": "गिरयो वर्षधाराभिर्हन्यमाना न विव्यथुः।\nअभिभूयमाना व्यसनैर्यथाऽधोक्षजचेतसः॥ १०/१८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.014.m4a", "display_order": 15}, {"id": 6000214015, "chapter_id": 10214, "verse_number": "१०-१८-१४", "content_sanskrit": "मार्गा बभूवुः सन्दिग्धास्तृणैश्छन्ना असंश्रिताः।\nनाभ्यस्यमानाः श्रुतयो द्विजैः कालहता इव॥ १०/१८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.015.m4a", "display_order": 16}, {"id": 6000214016, "chapter_id": 10214, "verse_number": "१०-१८-१५", "content_sanskrit": "लोकबन्धुषु मेघेषु विद्युतश्चलसौहृदाः।\nस्थैर्यं न चक्रुः कामिन्यः पुरुषेषु गुणिष्विव॥ १०/१८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.016.m4a", "display_order": 17}, {"id": 6000214017, "chapter_id": 10214, "verse_number": "१०-१८-१६", "content_sanskrit": "धनुर्वियति माहेन्द्रं निर्गुणं च गुणिन्यभात्।\nव्यक्ते गुणव्यतिकरेऽगुणवान् पुरुषो यथा॥ १०/१८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.017.m4a", "display_order": 18}, {"id": 6000214018, "chapter_id": 10214, "verse_number": "१०-१८-१७", "content_sanskrit": "न रराजोडुपश्छन्नः स्वज्योत्स्नाराजितैर्घनैः।\nअहंमत्या भासितया स्वभासा पुरुषो यथा॥ १०/१८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.018.m4a", "display_order": 19}, {"id": 6000214019, "chapter_id": 10214, "verse_number": "१०-१८-१८", "content_sanskrit": "मेघागमोत्सवा हृष्टाः प्रत्यनन्दन् शिखण्डिनः।\nगृहेषु तप्ता निर्विण्णा यथाऽच्युतजनागमे॥ १०/१८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.019.m4a", "display_order": 20}, {"id": 6000214020, "chapter_id": 10214, "verse_number": "१०-१८-१९", "content_sanskrit": "पीत्वाऽपः पादपाः पद्भिरासन् नम्रात्ममूर्तयः।\nप्राक् क्षामास्तपसा श्रान्ता यथा कामानुसेवया॥ १०/१८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.020.m4a", "display_order": 21}, {"id": 6000214021, "chapter_id": 10214, "verse_number": "१०-१८-२०", "content_sanskrit": "सरस्स्वशान्तरोधस्सु ह्यूषुरङ्गापि सारसाः।\nगृहेष्वशान्तकृत्येषु ग्राम्या इव दुराशयाः॥ १०/१८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.021.m4a", "display_order": 22}, {"id": 6000214022, "chapter_id": 10214, "verse_number": "१०-१८-२१", "content_sanskrit": "जलौघैर्निरभिद्यन्त सेतवो वर्षतीश्वरे।\nपाखण्डवामशैवाद्यैर्वेदमार्गाः कलौ युगे॥ १०/१८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.022.m4a", "display_order": 23}, {"id": 6000214023, "chapter_id": 10214, "verse_number": "१०-१८-२२", "content_sanskrit": "व्यमुञ्चन् वायुभिर्नुन्ना भूतेभ्यो ह्यमृतं घनाः।\nयथा विशो विट्‍पतयः काले काले द्विजेरिताः॥ १०/१८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.023.m4a", "display_order": 24}, {"id": 6000214024, "chapter_id": 10214, "verse_number": "१०-१८-२३", "content_sanskrit": "एवं वनं तद् वर्षिष्ठं पक्‍वखर्जूरजम्बुमत्।\nगोगोपालैर्वृतो रन्तुं सबलः प्राविशद् हरिः॥ १०/१८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.024.m4a", "display_order": 25}, {"id": 6000214025, "chapter_id": 10214, "verse_number": "१०-१८-२४", "content_sanskrit": "धेनवो मन्दगामिन्य ऊधोभारेण भूयसा।\nययुर्भगवताऽऽहूता द्रुतं प्रीत्या स्नुतस्तनीः॥ १०/१८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.025.m4a", "display_order": 26}, {"id": 6000214026, "chapter_id": 10214, "verse_number": "१०-१८-२५", "content_sanskrit": "वनौकसः प्रमुदिता वनराजीर्मधुश्च्युतः।\nगिरेर्गम्भीरसन्नादसन्नादा ददृशुर्गुहाः॥ १०/१८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.026.m4a", "display_order": 27}, {"id": 6000214027, "chapter_id": 10214, "verse_number": "१०-१८-२६", "content_sanskrit": "क्‍वचिद् वनस्पतिक्रोडे गुहायां चाभिवर्षति।\nनिर्विशन् भगवान् रेमे कन्दमूलफलाशनैः॥ १०/१८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.027.m4a", "display_order": 28}, {"id": 6000214028, "chapter_id": 10214, "verse_number": "१०-१८-२७", "content_sanskrit": "दध्योदनमुपानीतं शिलायां सलिलान्तिके।\nसम्भोजनीयैर्बुभुजे गोपैः सङ्कर्षणान्वितः॥ १०/१८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.028.m4a", "display_order": 29}, {"id": 6000214029, "chapter_id": 10214, "verse_number": "१०-१८-२८", "content_sanskrit": "शाद्वलोपरि संविश्य चर्वतो मीलितेक्षणान्।\nतृप्तान् वृषान् वत्सतरान् गाश्च स्वोधोभरश्रमाः॥ १०/१८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.029.m4a", "display_order": 30}, {"id": 6000214030, "chapter_id": 10214, "verse_number": "१०-१८-२९", "content_sanskrit": "प्रावृट्श्रियं च तां वीक्ष्य सर्वभूतमुदावहाम्।\nभगवान् पूजयाञ्चक्रे आत्मशक्त्युपबृंहिताम्॥ १०/१८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.030.m4a", "display_order": 31}, {"id": 6000214031, "chapter_id": 10214, "verse_number": "१०-१८-३०", "content_sanskrit": "एवं निवसतोस्तत्र रामकेशवयोर्व्रजे।\nशरत् समभवद् व्यभ्रा स्वच्छाम्बुप्लुषितानिला॥ १०/१८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.031.m4a", "display_order": 32}, {"id": 6000214032, "chapter_id": 10214, "verse_number": "१०-१८-३१", "content_sanskrit": "शारद्या नीरजोत्पत्त्या नीराणि प्रकृतिं ययुः।\nभ्रष्टानामिव चेतांसि पुनर्योगनिषेवया॥ १०/१८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.032.m4a", "display_order": 33}, {"id": 6000214033, "chapter_id": 10214, "verse_number": "१०-१८-३२", "content_sanskrit": "व्योम्नोऽब्दमभ्रशाबल्यं भुवः पङ्कमपां मलम्।\nशरज्जहाराश्रमिणां कृष्णभक्तिर्यथाऽशुभम्॥ १०/१८/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.033.m4a", "display_order": 34}, {"id": 6000214034, "chapter_id": 10214, "verse_number": "१०-१८-३३", "content_sanskrit": "सर्वस्वं जलदा हित्वा विरेजुः शुभ्रवर्चसः।\nयथा त्यक्तैषणाः शान्ता मुनयो मुक्तकल्मषाः॥ १०/१८/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.034.m4a", "display_order": 35}, {"id": 6000214035, "chapter_id": 10214, "verse_number": "१०-१८-३४", "content_sanskrit": "गिरयो मुमुचुस्तोयं क्‍वचिन्न मुमुचुः शिवम्।\nयथा ज्ञानामृतं काले ज्ञानिनो ददते न वा॥ १०/१८/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.035.m4a", "display_order": 36}, {"id": 6000214036, "chapter_id": 10214, "verse_number": "१०-१८-३५", "content_sanskrit": "नैवाविदन् क्षीयमाणं जलं गाधजलेचराः।\nयथाऽऽयुरन्वहं क्षय्यं नरा मूढाः कुटुम्बिनः॥ १०/१८/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.036.m4a", "display_order": 37}, {"id": 6000214037, "chapter_id": 10214, "verse_number": "१०-१८-३६", "content_sanskrit": "गाधवारिचरास्तापमविन्दन् शरदर्कजम्।\nयथा दरिद्रः कृपणः कुटुम्ब्यविजितेन्द्रियः॥ १०/१८/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.037.m4a", "display_order": 38}, {"id": 6000214038, "chapter_id": 10214, "verse_number": "१०-१८-३७", "content_sanskrit": "शनैश्शनैर्जहुः पङ्कं स्थलान्यासंश्च वीरुधः।\nयथाऽहंममतां धीराः शरीरादिष्वनात्मसु॥ १०/१८/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.038.m4a", "display_order": 39}, {"id": 6000214039, "chapter_id": 10214, "verse_number": "१०-१८-३८", "content_sanskrit": "निश्चलाम्बुरभूत् तूष्णीं समुद्रः शरदागमे।\nआत्मन्युपरते यद्वन्मुनिर्व्युपरतागमः॥ १०/१८/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.039.m4a", "display_order": 40}, {"id": 6000214040, "chapter_id": 10214, "verse_number": "१०-१८-३९", "content_sanskrit": "केदारेभ्यस्त्वपोऽगृह्णन् कर्षका दृढसेतुभिः।\nयथा प्राणैः स्वविज्ञानं तन्निरोधेन योगिनः॥ १०/१८/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.040.m4a", "display_order": 41}, {"id": 6000214041, "chapter_id": 10214, "verse_number": "१०-१८-४०", "content_sanskrit": "शरदर्कांशुजं तापं भूतानामुडुपोऽहरत्।\nदेहाभिमानजं बोधो मुकुन्दो व्रजयोषिताम्॥ १०/१८/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.041.m4a", "display_order": 42}, {"id": 6000214042, "chapter_id": 10214, "verse_number": "१०-१८-४१", "content_sanskrit": "खमशोभत निर्मेघं शरद्विमलतारकम्।\nसत्त्वयुक्तं यथा चित्तं शब्दब्रह्मार्थदर्शनम्॥ १०/१८/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.042.m4a", "display_order": 43}, {"id": 6000214043, "chapter_id": 10214, "verse_number": "१०-१८-४२", "content_sanskrit": "अखण्डमण्डलं व्योम्नि रराजोडुगणैः शशी।\nयथा यदुपतिः कृष्णो वृष्णिचक्रैर्वृतो भुवि॥ १०/१८/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.043.m4a", "display_order": 44}, {"id": 6000214044, "chapter_id": 10214, "verse_number": "१०-१८-४३", "content_sanskrit": "आश्लिष्य समशीतोष्णं प्रसूनवनमारुतम्।\nजनास्तापं जहुर्गोप्यो न कृष्णाहृतचेतसः॥ १०/१८/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.044.m4a", "display_order": 45}, {"id": 6000214045, "chapter_id": 10214, "verse_number": "१०-१८-४४", "content_sanskrit": "गावो मृगाः खगा नार्यः पुष्पिण्यः शरदाऽभवन्।\nअन्वीयमाना वृषभैः फलैरीषत्क्रिया इव॥ १०/१८/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.045.m4a", "display_order": 46}, {"id": 6000214046, "chapter_id": 10214, "verse_number": "१०-१८-४५", "content_sanskrit": "उदहृष्यन् वारिजानि सूर्येण कुमुदं विना।\nराज्ञा तु निर्भयो लोको यथा दस्यून् विना नृप॥ १०/१८/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.046.m4a", "display_order": 47}, {"id": 6000214047, "chapter_id": 10214, "verse_number": "१०-१८-४६", "content_sanskrit": "पुरग्रामेष्वाश्रमिणामिन्द्रयागमहोत्सवैः।\nबभौ भूः पक्‍वसस्याढ्या कलाभ्यां नितरां हरेः॥ १०/१८/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.047.m4a", "display_order": 48}, {"id": 6000214048, "chapter_id": 10214, "verse_number": "१०-१८-४७", "content_sanskrit": "वणिजो नगरात् स्वीयान्निर्गत्यार्थान् प्रपेदिरे।\nवर्षरुद्धा यथा सिद्धाः स्वपिण्डान् काल आगते॥ १०/१८/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_018/BhP_10.018.048.m4a", "display_order": 49}, {"id": 6000214049, "chapter_id": 10214, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे अष्टादशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]