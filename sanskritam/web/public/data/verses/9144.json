[{"id": 5000144000, "chapter_id": 9144, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे सप्तषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000144001, "chapter_id": 9144, "verse_number": "२-६७-१", "content_sanskrit": "आक्रन्दितनिरानन्दा सास्रकम्ठजनाविला ।\nआयोध्यायामतितता सा व्यतीयाय शर्वरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000144002, "chapter_id": 9144, "verse_number": "२-६७-२", "content_sanskrit": "व्यतीतायाम् तु शर्वर्याम् आदित्यस्य उदये ततः ।\nसमेत्य राज कर्तारः सभाम् ईयुर् द्विजातयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000144003, "chapter_id": 9144, "verse_number": "२-६७-३", "content_sanskrit": "मार्कण्डेयो अथ मौद्गल्यो वामदेवः च काश्यपः ।\nकात्ययनो गौतमः च जाबालिः च महा यशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000144004, "chapter_id": 9144, "verse_number": "२-६७-४", "content_sanskrit": "एते द्विजाः सह अमात्यैः पृथग् वाचम् उदीरयन् ।\nवसिष्ठम् एव अभिमुखाः श्रेष्ठः राज पुरोहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000144005, "chapter_id": 9144, "verse_number": "२-६७-५", "content_sanskrit": "अतीता शर्वरी दुह्खम् या नो वर्ष शत उपमा ।\nअस्मिन् पन्चत्वम् आपन्ने पुत्र शोकेन पार्थिवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000144006, "chapter_id": 9144, "verse_number": "२-६७-६", "content_sanskrit": "स्वर् गतः च महा राजो रामः च अरण्यम् आश्रितः ।\nलक्ष्मणः च अपि तेजस्वी रामेण एव गतः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000144007, "chapter_id": 9144, "verse_number": "२-६७-७", "content_sanskrit": "उभौ भरत शत्रुघ्नौ क्केकयेषु परम् तपौ ।\nपुरे राज गृहे रम्ये मातामह निवेशने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000144008, "chapter_id": 9144, "verse_number": "२-६७-८", "content_sanskrit": "इक्ष्वाकूणाम् इह अद्य एव कश्चित् राजा विधीयताम् ।\nअराजकम् हि नो राष्ट्रम् न विनाशम् अवाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000144009, "chapter_id": 9144, "verse_number": "२-६७-९", "content_sanskrit": "न अराजले जन पदे विद्युन् माली महा स्वनः ।\nअभिवर्षति पर्जन्यो महीम् दिव्येन वारिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000144010, "chapter_id": 9144, "verse_number": "२-६७-१०", "content_sanskrit": "न अराजके जन पदे बीज मुष्टिः प्रकीर्यते ।\nन अराकके पितुः पुत्रः भार्या वा वर्तते वशे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000144011, "chapter_id": 9144, "verse_number": "२-६७-११", "content_sanskrit": "अराजके धनम् न अस्ति न अस्ति भार्या अपि अराजके ।\nइदम् अत्याहितम् च अन्यत् कुतः सत्यम् अराजके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000144012, "chapter_id": 9144, "verse_number": "२-६७-१२", "content_sanskrit": "न अराजके जन पदे कारयन्ति सभाम् नराः ।\nउद्यानानि च रम्याणि हृष्टाः पुण्य गृहाणि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000144013, "chapter_id": 9144, "verse_number": "२-६७-१३", "content_sanskrit": "न अराजके जन पदे यज्ञ शीला द्विजातयः ।\nसत्राणि अन्वासते दान्ता ब्राह्मणाः सम्शित व्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000144014, "chapter_id": 9144, "verse_number": "२-६७-१४", "content_sanskrit": "न अराजके जनपदे महायज्ञेषु यज्वनः ।\nब्राह्मणा वसुसम्पन्ना विसृजन्त्याप्तदक्षिणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000144015, "chapter_id": 9144, "verse_number": "२-६७-१५", "content_sanskrit": "न अराजके जन पदे प्रभूत नट नर्तकाः ।\nउत्सवाः च समाजाः च वर्धन्ते राष्ट्र वर्धनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000144016, "chapter_id": 9144, "verse_number": "२-६७-१६", "content_sanskrit": "न अरजके जन पदे सिद्ध अर्था व्यवहारिणः ।\nकथाभिर् अनुरज्यन्ते कथा शीलाः कथा प्रियैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000144017, "chapter_id": 9144, "verse_number": "२-६७-१७", "content_sanskrit": "न अराजके जनपदे उद्यानानि समागताः ।\nसायाह्ने क्रीडितुम् यान्ति कुमार्यो हेमभूषिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000144018, "chapter_id": 9144, "verse_number": "२-६७-१८", "content_sanskrit": "न अराजके जन पदे वाहनैः शीघ्र गामिभिः ।\nनरा निर्यान्ति अरण्यानि नारीभिः सह कामिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000144019, "chapter_id": 9144, "verse_number": "२-६७-१९", "content_sanskrit": "न अराकजे जन पदे धनवन्तः सुरक्षिताः ।\nशेरते विवृत द्वाराः कृषि गो रक्ष जीविनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000144020, "chapter_id": 9144, "verse_number": "२-६७-२०", "content_sanskrit": "न अराजके जनपदे बद्दघण्टा विषाणीनः ।\nआटन्ति राजमार्गेषु कुञ्जराः षष्टिहायनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000144021, "chapter_id": 9144, "verse_number": "२-६७-२१", "content_sanskrit": "न अराजके जनपदे शरान् सम्ततमस्यताम् ।\nश्रूयते तलनिर्घोष इष्वस्त्राणामुपासने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000144022, "chapter_id": 9144, "verse_number": "२-६७-२२", "content_sanskrit": "न अराजके जन पदे वणिजो दूर गामिनः ।\nगच्चन्ति क्षेमम् अध्वानम् बहु पुण्य समाचिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000144023, "chapter_id": 9144, "verse_number": "२-६७-२३", "content_sanskrit": "न अराजके जन पदे चरति एक चरः वशी ।\nभावयन्न् आत्मना आत्मानम् यत्र सायम् गृहो मुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000144024, "chapter_id": 9144, "verse_number": "२-६७-२४", "content_sanskrit": "न अराजके जन पदे योग क्षेमम् प्रवर्तते ।\nन च अपि अराजके सेना शत्रून् विषहते युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000144025, "chapter_id": 9144, "verse_number": "२-६७-२५", "content_sanskrit": "न अराजके जनपदे हृष्टैः परमवाजिभिः ।\nनराः सम्यान्ति सहसा रथैश्च परिमण्डिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000144026, "chapter_id": 9144, "verse_number": "२-६७-२६", "content_sanskrit": "न अराजके जनपदे नराः शास्त्रविशारदाः ।\nसम्पदन्तोऽवतिष्ठन्ते वनेषूपवनेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000144027, "chapter_id": 9144, "verse_number": "२-६७-२७", "content_sanskrit": "न अराजके जनपदे माल्यमोदकदक्षिणाः ।\nदेवताभ्यर्चनार्थय कल्प्यन्ते नियतैर्जनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000144028, "chapter_id": 9144, "verse_number": "२-६७-२८", "content_sanskrit": "न अराजके जनपदे चन्दनागुरुरूषिताः ।\nराजपुत्रा विराजन्ते वसन्त इव शाखिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000144029, "chapter_id": 9144, "verse_number": "२-६७-२९", "content_sanskrit": "यथा हि अनुदका नद्यो यथा वा अपि अतृणम् वनम् ।\nअगोपाला यथा गावः तथा राष्ट्रम् अराजकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000144030, "chapter_id": 9144, "verse_number": "२-६७-३०", "content_sanskrit": "ध्वजो रथस्य प्रज्ञानम् धूमो ज्ञानम् विभावसोः ।\nतेषाम् यो नो ध्वजो राज स देवत्वमितो गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000144031, "chapter_id": 9144, "verse_number": "२-६७-३१", "content_sanskrit": "न अराजके जन पदे स्वकम् भवति कस्यचित् ।\nमत्स्याइव नरा नित्यम् भक्षयन्ति परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000144032, "chapter_id": 9144, "verse_number": "२-६७-३२", "content_sanskrit": "येहि सम्भिन्न मर्यादा नास्तिकाः चिन्न सम्शयाः ।\nते अपि भावाय कल्पन्ते राज दण्ड निपीडिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000144033, "chapter_id": 9144, "verse_number": "२-६७-३३", "content_sanskrit": "यथा दृष्टिः शरीरस्य नित्यमेवप्रवर्तते ।\nतथा नरेन्द्रो राष्ट्रस्य प्रभवः सत्यधर्मयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000144034, "chapter_id": 9144, "verse_number": "२-६७-३४", "content_sanskrit": "राजा सत्यम् च धर्मश्च राजा कुलवताम् कुलम् ।\nराजा माता पिता चैव राजा हितकरो नृणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000144035, "chapter_id": 9144, "verse_number": "२-६७-३५", "content_sanskrit": "यमो वैश्रवणः शक्रो वरुणश्च महाबलः ।\nविशेष्यन्ते नरेन्द्रेण वृत्तेन महाता ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000144036, "chapter_id": 9144, "verse_number": "२-६७-३६", "content_sanskrit": "अहो तमैव इदम् स्यान् न प्रज्ञायेत किम्चन ।\nराजा चेन् न भवेन् लोके विभजन् साध्व् असाधुनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000144037, "chapter_id": 9144, "verse_number": "२-६७-३७", "content_sanskrit": "जीवति अपि महा राजे तव एव वचनम् वयम् ।\nन अतिक्रमामहे सर्वे वेलाम् प्राप्य इव सागरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000144038, "chapter_id": 9144, "verse_number": "२-६७-३८", "content_sanskrit": "स नः समीक्ष्य द्विज वर्य वृत्तम् ।\nनृपम् विना राज्यम् अरण्य भूतम् ।\nकुमारम् इक्ष्वाकु सुतम् वदान्यम् ।\nत्वम् एव राजानम् इह अभिषिन्चय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000144039, "chapter_id": 9144, "verse_number": null, "content_sanskrit": "इति वाल्मीकि रामायणे आदि काव्ये अयोध्याकाण्डे सप्तषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]