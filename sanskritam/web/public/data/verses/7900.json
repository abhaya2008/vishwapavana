[{"id": 33000421, "chapter_id": 7900, "verse_number": "1", "content_sanskrit": "भवतीत्येष सत्तायां प्राप्तिसम्पत्तिजन्मसु । आद्योपलम्भे पर्याप्तौ सामर्थ्ये प्रभवत्ययम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "avatarnika": ""}, {"id": 33000422, "chapter_id": 7900, "verse_number": "2", "content_sanskrit": "सम्भावनायां माने च साहित्ये सम्भवत्यसौ । शक्तिप्राप्त्योर्विभवति प्राकट्ये व्युद्भवत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2, "avatarnika": ""}, {"id": 33000423, "chapter_id": 7900, "verse_number": "3", "content_sanskrit": "ग्रन्थप्रतिष्ठालिप्सासु गाधते नाथतीति तु । याञ्चोपतापैश्वर्येषु तेष्वाशिषि च नाथते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3, "avatarnika": ""}, {"id": 33000424, "chapter_id": 7900, "verse_number": "4", "content_sanskrit": "स्तवेऽभिवादने चाऽपि वन्दते भन्दते पुनः । सौख्यकल्याणयोर्मोदमदस्वप्नगतिस्तुतीः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4, "avatarnika": ""}, {"id": 33000425, "chapter_id": 7900, "verse_number": "5", "content_sanskrit": "आह मन्दत इत्येतद्‌ ददते दानधारणे । क्रीडायामूर्दते माने ह्लादते ह्लादशब्दयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5, "avatarnika": ""}, {"id": 33000426, "chapter_id": 7900, "verse_number": "6", "content_sanskrit": "कुन्थति पुन्थति लुन्थति मन्थति मान्थत्यमी पञ्च । हिंसासङ्क्लेशनयोश्चन्दत्याह्लाददीपनयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6, "avatarnika": ""}, {"id": 33000427, "chapter_id": 7900, "verse_number": "7", "content_sanskrit": "गतिमाङ्गल्यशास्त्रेषु सेधति स्थैर्यहिंसयोः। खदत्यथाऽर्दति गतियाञ्चाहिंसासु सम्मतम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7, "avatarnika": ""}, {"id": 33000428, "chapter_id": 7900, "verse_number": "8", "content_sanskrit": "कन्दति क्रन्दति क्लन्दत्याह्वाने रोदने त्रयम्‌ । द्रेकते ध्रेकते शब्दोत्साहयोश्चकते पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8, "avatarnika": ""}, {"id": 33000429, "chapter_id": 7900, "verse_number": "9", "content_sanskrit": "तृप्तौ च प्रतिघाते च गत्याक्षेपे तु मङ्घते । कैतवे द्राघते त्वेतत्‌ सामर्थ्याऽऽयामयोर्मतम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9, "avatarnika": ""}, {"id": 33000430, "chapter_id": 7900, "verse_number": "10", "content_sanskrit": "गतौ लङ्घत्‌ इत्येतन्निवृत्तौ भोजनस्य च ।शोषणे चाऽलमर्थ च राखत्योखति लाखति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10, "avatarnika": ""}, {"id": 33000431, "chapter_id": 7900, "verse_number": "11", "content_sanskrit": "द्राखति ध्राखतीत्येते गतौ त्वङ्गति कम्पने । मञ्चते धारणोच्छ्रायपूजनेष्वथ कञ्चते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11, "avatarnika": ""}, {"id": 33000432, "chapter_id": 7900, "verse_number": "12", "content_sanskrit": "दीप्ति-बन्धनयोर्गत्याम् ईजते कुत्सनेऽपि च ।शाठ्यमेदनदम्भेषु मुञ्चते मचते पदम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12, "avatarnika": ""}, {"id": 33000433, "chapter_id": 7900, "verse_number": "13", "content_sanskrit": "स्थानाऽर्जनोपार्जनगतिष्वृजेः स्याद्‌ अर्जतेपदम्‌ । स्यात् सम्पर्चनकौटिल्यप्रतिष्टम्भविलेखने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13, "avatarnika": ""}, {"id": 33000434, "chapter_id": 7900, "verse_number": "14", "content_sanskrit": "तारे शब्दे कोचतीति याञ्चागत्योस्तथाऽञ्चते । तयोश्च पृजने चाञ्चत्यजति क्षेपणे गतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14, "avatarnika": ""}, {"id": 33000435, "chapter_id": 7900, "verse_number": "15", "content_sanskrit": "कौटिल्याऽल्पीभवनयोः कुञ्चपि क्रुञ्चतीत्युभे । मूर्च्छत्येष समुच्छ्राये मोहे स्यात् खर्जतीति तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15, "avatarnika": ""}, {"id": 33000436, "chapter_id": 7900, "verse_number": "16", "content_sanskrit": "व्यथने पूजने हिंसात्राणयोस्तुञ्जतीत्ययम् । शब्दे गजति मादे च हिण्डतेऽनादरे गतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16, "avatarnika": ""}, {"id": 33000437, "chapter_id": 7900, "verse_number": "17", "content_sanskrit": "अतिक्रमे च हिंसायाम्‌ अट्टते मुण्ठते शुचौ । पलायने च कटति वर्षावरणयोर्गतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17, "avatarnika": ""}, {"id": 33000438, "chapter_id": 7900, "verse_number": "18", "content_sanskrit": "शटत्ययं विशरणे गतौ रुज्यवसादने ।बाल्ये च परिभाषायां लटतीत्यथ पेटति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18, "avatarnika": ""}, {"id": 33000439, "chapter_id": 7900, "verse_number": "19", "content_sanskrit": "शब्दसङ्घातयोर्मादे निवासे च मठत्यदः। हठतीति बलात्कारे प्लुतौ शङ्क्वन्दनेऽपि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19, "avatarnika": ""}, {"id": 33000440, "chapter_id": 7900, "verse_number": "20", "content_sanskrit": "हिंसासङ्क्लेशयोः पेठत्यथो शठति कैतवे । तयोश्चाऽथो लुण्ठतीति गतावालस्य एव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20, "avatarnika": ""}, {"id": 33000441, "chapter_id": 7900, "verse_number": "21", "content_sanskrit": "तेपते क्षरणे कम्पे ग्लेपते दैन्यकम्पयोः । अवस्रंसे प्रमादे च स्रंसते लम्बते पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21, "avatarnika": ""}, {"id": 33000442, "chapter_id": 7900, "verse_number": "22", "content_sanskrit": "शब्दे चाऽवस्रंसने च मानसे च जपत्ययम्‌ । हिंसाभाषणयोः शोभत्यत्र दीप्तौ च शुम्भति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22, "avatarnika": ""}, {"id": 33000443, "chapter_id": 7900, "verse_number": "23", "content_sanskrit": "शब्दे रणति गत्यां तु घटादावेव पठ्यते ।पैणति प्रेरणाऽऽश्लेषगमनेषु पदं त्रिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23, "avatarnika": ""}, {"id": 33000444, "chapter_id": 7900, "verse_number": "24", "content_sanskrit": "लौहित्ये शोणति गतौ सम्भक्तौ वनति ध्वनौ । दीप्तिकान्तिगतित्विष्टं त्रिष्वर्थेषु कनत्यदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24, "avatarnika": ""}, {"id": 33000445, "chapter_id": 7900, "verse_number": "25", "content_sanskrit": "गतौ च शब्दसम्भक्त्योरमतीति प्रयुज्यते । क्रमते क्रम्यते स्यातां तायनोत्साहवृत्तिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25, "avatarnika": ""}, {"id": 33000446, "chapter_id": 7900, "verse_number": "26", "content_sanskrit": "नयते रक्षणे गत्यां दयते तु तयोरपि । आदानदानहिंसासु क्नूयते क्लेदशब्दयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26, "avatarnika": ""}, {"id": 33000447, "chapter_id": 7900, "verse_number": "27", "content_sanskrit": "पूयते स्याद्‌ विशरणे दुर्गन्धे चाऽथ तायते । पालने स्फीततायां च प्रेप्सागत्योश्च हर्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27, "avatarnika": ""}, {"id": 33000448, "chapter_id": 7900, "verse_number": "28", "content_sanskrit": "भ्रंशेऽदने गलति च शब्दसङ्ख्यानयोर्द्वयोः । कलते शलते त्वेष चलने संवृतावपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28, "avatarnika": ""}, {"id": 33000449, "chapter_id": 7900, "verse_number": "29", "content_sanskrit": "भलते भल्लते हिंसादानयोः परिभाषणे । चलने सञ्चये चोक्तः खलतीति फलत्यदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29, "avatarnika": ""}, {"id": 33000450, "chapter_id": 7900, "verse_number": "30", "content_sanskrit": "आादितश्रेद्‌ विशरणे निष्पत्तौ स्याद्‌ अनादितः। अलतेऽलति भूषायां पर्याप्तौ वारणे द्वयम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30, "avatarnika": ""}, {"id": 33000451, "chapter_id": 7900, "verse_number": "31", "content_sanskrit": "गतौ जग्धौ च चरति सङ्घाते रुजि शूलति । हिंसाकरणयोः कृण्वेः कृणोति प्रापणेऽपि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31, "avatarnika": ""}, {"id": 33000452, "chapter_id": 7900, "verse_number": "32", "content_sanskrit": "पराभिभूतावुत्कर्षे  जयत्यन्ते त्वकर्मकः । स्वाम्यर्थदानावगतिप्रवेशयाञ्चागतीच्छाश्रुतितृप्त्यवाप्तीः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32, "avatarnika": ""}, {"id": 33000453, "chapter_id": 7900, "verse_number": "33", "content_sanskrit": "आलिङ्गरक्षाद्युतिभागवृद्धिहिंसाक्रियाश्चाऽवतिरेष वक्ति । धुक्षते धिक्षते सन्दीपनक्लेशनजीवने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33, "avatarnika": ""}, {"id": 33000454, "chapter_id": 7900, "verse_number": "34", "content_sanskrit": "हिंसाविश्राणनगतिष्वीषते स्यात्‌ तु दक्षते । शैघ्र्यवृद्ध्योर्घटादौ तु तदेव गतिहिंसयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34, "avatarnika": ""}, {"id": 33000455, "chapter_id": 7900, "verse_number": "35", "content_sanskrit": "स्यान्मौण्ड्येज्योपनयन व्रतादेशेषु दीक्षते । जिज्ञासने च विद्याया ग्रहणे चाऽपि शिक्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35, "avatarnika": ""}, {"id": 33000456, "chapter_id": 7900, "verse_number": "36", "content_sanskrit": "कासते कफजे शब्दे दीप्तौ चाऽयं प्रयोगतः । द्राङ्‍क्षति ध्राङ्क्षति ध्वाङ्क्षतीच्छायां घोरवाशिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36, "avatarnika": ""}, {"id": 33000457, "chapter_id": 7900, "verse_number": "37", "content_sanskrit": "अक्षत्यक्ष्णोति सङ्घाते व्याप्तावप्यथ मर्षति । सहने सेचने श्लेषक्रीडयोर्लसतीत्यदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37, "avatarnika": ""}, {"id": 33000458, "chapter_id": 7900, "verse_number": "38", "content_sanskrit": "जर्जति द्वे चर्चति सन्तर्जने परिभाषणे । उरसा गमने दाने वृद्धावपि च मोहते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38, "avatarnika": ""}, {"id": 33000459, "chapter_id": 7900, "verse_number": "39", "content_sanskrit": "क्ष्वेदते स्नेहने मोक्षे दीप्तौ स्वादे च रोचते । प्रमादे स्रंसते चाऽवस्रंसने ध्वंसने गतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39, "avatarnika": ""}, {"id": 33000460, "chapter_id": 7900, "verse_number": "40", "content_sanskrit": "क्षञ्जते दानगत्योः स्याद्‍ व्यथते चलने भये । कम्पे विलसने चाऽर्थे कम्पते चलतीत्यम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40, "avatarnika": ""}, {"id": 33000461, "chapter_id": 7900, "verse_number": "41", "content_sanskrit": "ह्वलतीति पदं गत्यां तदेव चलने मितम् । हर्षग्लेपनयोर्मित्त्वान्मदेर्मदयतीति णौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41, "avatarnika": ""}, {"id": 33000462, "chapter_id": 7900, "verse_number": "42", "content_sanskrit": "बलतीत्येष धान्यस्याऽवरोधे प्राणनेऽपि च । बन्धुक्रियायां संस्त्याने कोलतीत्यथ होलति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42, "avatarnika": ""}, {"id": 33000463, "chapter_id": 7900, "verse_number": "43", "content_sanskrit": "स्याद्धिंसासंवरणयोः क्रोशत्याह्वानरोदने । सीदति स्याद्‌ विशरणे गतावप्यवसादने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43, "avatarnika": ""}, {"id": 33000464, "chapter_id": 7900, "verse_number": "44", "content_sanskrit": "सम्पर्चने तु कौटिल्ये प्रतिष्टम्भे विलेखने । तारे शब्दे कोचतीति ज्वलादेरितरस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44, "avatarnika": ""}, {"id": 33000465, "chapter_id": 7900, "verse_number": "45", "content_sanskrit": "मिथ्याज्ञानेऽनवस्थाने भ्रमति भ्राम्यतीत्युभे। स्त्यायतेः प्राग्‌ आत्मनेऽपि गतिशुद्ध्योस्तु धावति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45, "avatarnika": ""}, {"id": 33000466, "chapter_id": 7900, "verse_number": "46", "content_sanskrit": "पदं भूषणपर्याप्तिवारणेष्वलतीत्यदः। दीप्त्यादानगतिष्विष्टम्‌ असतीत्यथ चीवति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46, "avatarnika": ""}, {"id": 33000467, "chapter_id": 7900, "verse_number": "47", "content_sanskrit": "स्याददाने संवरणेऽप्यथ हिंसनमेधयोः। मेदत्येतन्मेधति तु सङ्गमे च तयोरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47, "avatarnika": ""}, {"id": 33000468, "chapter_id": 7900, "verse_number": "48", "content_sanskrit": "कुत्सायां सन्निकर्षे च नेदतीत्यथ वेणति । चिन्तानिशामनगतिवादित्रग्रहबुद्धिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48, "avatarnika": ""}, {"id": 33000469, "chapter_id": 7900, "verse_number": "49", "content_sanskrit": "निशामनेऽर्चने चायत्यथ स्पशति बाधने । स्पर्शने वहतीत्येतत्‌ स्यन्दने प्रापणे धृतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49, "avatarnika": ""}, {"id": 33000470, "chapter_id": 7900, "verse_number": "50", "content_sanskrit": "झषत्यादानसंवृत्योः हिंसायां चेन्न चाऽत्मने । यजतीति तु देवाऽर्चादानसङ्गतिकर्मसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50, "avatarnika": ""}, {"id": 33000471, "chapter_id": 7900, "verse_number": "51", "content_sanskrit": "ह्वयति स्पर्धने शब्दे वपत्युप्तौ च मुण्डने । दाने निरसने दीप्तावप्यवात्त्वेषतीत्यदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51, "avatarnika": ""}, {"id": 33000472, "chapter_id": 7900, "verse_number": "52", "content_sanskrit": "शब्दसङ्घातयोर्धात्वोः स्त्यायत्यथ धमत्यदः । कृशानुफूत्कृतौ शब्देऽप्युपतापे स्वरत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52, "avatarnika": ""}, {"id": 33000473, "chapter_id": 7900, "verse_number": "53", "content_sanskrit": "ॠच्छेर्गतीन्द्रियलयमूर्तिभावेषु ॠच्छति। ऋच्छाऽऽदेशे तदेवाऽर्तेः शिति स्यात्‌ प्रापणे गतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53, "avatarnika": ""}, {"id": 33000474, "chapter_id": 7900, "verse_number": "54", "content_sanskrit": "सवतीति पदं धात्वोः प्रसवैश्वर्ययोर्गतौ । प्लवे तरत्युत्तरणे स्कन्दतीति तु शोषणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54, "avatarnika": ""}, {"id": 33000475, "chapter_id": 7900, "verse_number": "55", "content_sanskrit": "गत्यामथो नमत्येतन्नमस्कारेऽपि शब्दने । सेवने सचते तद्वत् समवाये सचत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55, "avatarnika": ""}, {"id": 33000476, "chapter_id": 7900, "verse_number": "56", "content_sanskrit": "वदते तूक्तिविषयभासनोत्साहवृत्तिषु । सहतेऽभिभवे क्षान्तौ गतिवृद्ध्योः श्वयत्ययम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56, "avatarnika": ""}, {"id": 33000477, "chapter_id": 7900, "verse_number": "57", "content_sanskrit": "पवते रक्षणाऽऽदौ च सोमस्य मरुतो गतौ । निर्णेतृत्वेन भजने तिष्ठते स्वप्रकाशने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57, "avatarnika": ""}, {"id": 33000478, "chapter_id": 7900, "verse_number": "58", "content_sanskrit": "देवाऽर्चासङ्गतिकृतिमैत्रीषु पथिकर्तुके । धात्वर्थे मन्त्रकरणेऽकर्मके चोपतिष्ठते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58, "avatarnika": ""}, {"id": 33000479, "chapter_id": 7900, "verse_number": "59", "content_sanskrit": "परस्मैपदमन्यत्र लिप्सयोपस्थितौ न वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59, "avatarnika": ""}, {"id": 33000480, "chapter_id": 7900, "verse_number": "60", "content_sanskrit": "गतिगन्धनयोर्वाति हन्तीति गतिहिंसयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60, "avatarnika": ""}, {"id": 33000481, "chapter_id": 7900, "verse_number": "61", "content_sanskrit": "ग्रहणेऽप्युपहन्त्येतद्‌ अशुचीकरणेऽपि च । वेतीति कान्तिगमनप्रजनाऽसनखादने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61, "avatarnika": ""}, {"id": 33000482, "chapter_id": 7900, "verse_number": "62", "content_sanskrit": "गतिशासनयोः कस्त ईर्ते तु गतिकम्पयोः। ईट्टे स्तुतौ गतिनायां याज्ञप्रेरणभोजने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62, "avatarnika": ""}, {"id": 33000483, "chapter_id": 7900, "verse_number": "63", "content_sanskrit": "व्यक्तवाचि भवेच्चष्टे दृष्टौ यौति तु मिश्रणे । अमिश्रणेऽपि सौतीति प्रसवैश्वर्ययोर्मतम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63, "avatarnika": ""}, {"id": 33000484, "chapter_id": 7900, "verse_number": "64", "content_sanskrit": "ज्ञानविश्वासयोः प्रत्येत्यध्येत्यधिगमे स्मृतौ । भक्षे जक्षिति हसने दीधीते भासि देवने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64, "avatarnika": ""}, {"id": 33000485, "chapter_id": 7900, "verse_number": "65", "content_sanskrit": "वेवीते वेति तुल्यार्थश्छान्दसाविति भाष्यकृत्‌ । तवीति तौति वृद्ध्यर्थे हिंसायां पूरणे गतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65, "avatarnika": ""}, {"id": 33000486, "chapter_id": 7900, "verse_number": "66", "content_sanskrit": "जुहोति हविरासेके दानेऽप्येके पिपर्ति तु। पालने पूरणे दीप्तौ क्षरणाऽर्थे जिघर्त्यदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66, "avatarnika": ""}, {"id": 33000487, "chapter_id": 7900, "verse_number": "67", "content_sanskrit": "बभस्ति भर्त्सने दीप्तौ मिमीते मानशब्दयोः। नेनेक्ति पोषणे शौचे बिभर्ति धृतिपौषयौः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67, "avatarnika": ""}, {"id": 33000488, "chapter_id": 7900, "verse_number": "68", "content_sanskrit": "तयोर्दधाति दाने चाऽभिदधात्युक्तिबन्धयोः । श्रद्दधाति तु विस्रम्भस्पृहयोः पञ्च चाऽऽत्मने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68, "avatarnika": ""}, {"id": 33000489, "chapter_id": 7900, "verse_number": "69", "content_sanskrit": "विजिगीषागतिक्रीडाव्यवहारद्युतिस्तुतीः । दीव्यतीत्याह गत्यां तु शोषणे स्रीव्यतीत्यदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69, "avatarnika": ""}, {"id": 33000490, "chapter_id": 7900, "verse_number": "70", "content_sanskrit": "क्नस्यति ह्वरणे दीप्तौ व्रीडतीत्येष चोदने । लज्जायां चाऽथ हिंसायां त्वरणे चाऽपि तूर्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70, "avatarnika": ""}, {"id": 33000491, "chapter_id": 7900, "verse_number": "71", "content_sanskrit": "धूर्यते गूर्यते चोभे गतिहिंसनयोर्मते । हिंसायां च वयोहानौ घूर्यते जूर्यते पदे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71, "avatarnika": ""}, {"id": 33000492, "chapter_id": 7900, "verse_number": "72", "content_sanskrit": "हिंसायां शूर्यते स्तम्भेऽप्यथ संराद्धिहिंसयोः। रध्यत्युपक्रमज्ञानस्वीकारे प्रतिपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72, "avatarnika": ""}, {"id": 33000493, "chapter_id": 7900, "verse_number": "73", "content_sanskrit": "विक्लित्तिक्षणवृद्ध्यादौ राध्यत्येतद्‌ अकर्मकम्‌ । हर्षणे मोचने दृप्यत्यथ ग्लानौ च ताम्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73, "avatarnika": ""}, {"id": 33000494, "chapter_id": 7900, "verse_number": "74", "content_sanskrit": "काङ्क्षायाम्​​ अपि खेदे तु श्राम्यत्येष तपस्यति । मोचने क्ष्विद्यति स्नेहे गात्रस्थौल्येऽपि मेद्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74, "avatarnika": ""}, {"id": 33000495, "chapter_id": 7900, "verse_number": "75", "content_sanskrit": "पीडने मन्थने स्नाने सन्धानेऽभिषुणोत्यदः। आत्मनेऽप्यथ वृद्धौ च हिनोतीति गतावपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75, "avatarnika": ""}, {"id": 33000496, "chapter_id": 7900, "verse_number": "76", "content_sanskrit": "सङ्घाते चाऽश्रुत व्याप्तौ स्पृणोति प्रीतिपालने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76, "avatarnika": ""}, {"id": 33000497, "chapter_id": 7900, "verse_number": "77", "content_sanskrit": "जुषते सेवने प्रीतौ विजते चलने भये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77, "avatarnika": ""}, {"id": 33000498, "chapter_id": 7900, "verse_number": "78", "content_sanskrit": "युद्धनिन्दादानहिंसाकत्थनेषु रिफत्यदः। शब्दोपकृत्योः कुणति चृतति ग्रन्थहिंसयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78, "avatarnika": ""}, {"id": 33000499, "chapter_id": 7900, "verse_number": "79", "content_sanskrit": "गतिकौटिल्यहिंसासु द्रुणतीत्यथ खण्डने । छेदे खुरति भीमाऽर्थशब्दयोर्घुरतीत्यदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79, "avatarnika": ""}, {"id": 33000500, "chapter_id": 7900, "verse_number": "80", "content_sanskrit": "ऐश्वर्यदीप्त्योः सुरति किलति श्वैत्यखेलयोः। इलति प्रेरणे स्वप्नेऽप्यथाऽऽक्षेपप्रमर्दयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80, "avatarnika": ""}, {"id": 33000501, "chapter_id": 7900, "verse_number": "81", "content_sanskrit": "मुटत्यथ कुडत्येतद्‌ बाल्ये च घसने मतम्‌ । निवासगत्योः क्षियति गतौ स्थैर्ये ध्रुवत्यदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81, "avatarnika": ""}, {"id": 33000502, "chapter_id": 7900, "verse_number": "82", "content_sanskrit": "दीप्तिदेवनयोश्छृन्ते छृणत्तीति तृणत्यदः। तृन्ते हिंसाऽनादरयोर्विनक्ति चलने भये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82, "avatarnika": ""}, {"id": 33000503, "chapter_id": 7900, "verse_number": "83", "content_sanskrit": "अनक्ति म्रक्षणगतिकान्तिव्यक्तिषु कीर्तितम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83, "avatarnika": ""}, {"id": 33000504, "chapter_id": 7900, "verse_number": "84", "content_sanskrit": "साहसिक्यप्रकथनोपयोगेषु च सेवने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84, "avatarnika": ""}, {"id": 33000505, "chapter_id": 7900, "verse_number": "85", "content_sanskrit": "पदं प्रकुरुतेऽथाऽधिकुरुतेऽभिभवे तथा । क्षान्तौ विकुरुते शब्दकर्मकेऽर्थेऽप्यकर्मकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85, "avatarnika": ""}, {"id": 33000506, "chapter_id": 7900, "verse_number": "86", "content_sanskrit": "ऊर्युरर्यूररीभ्यश्च करोति कुरुते पदे । विस्ताराऽङ्गीकरणयोः प्रतियत्ने तु वैकृते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86, "avatarnika": ""}, {"id": 33000507, "chapter_id": 7900, "verse_number": "87", "content_sanskrit": "उपस्कुरुत इत्येतद्‌वाक्याऽध्याहारयोरपि । हृष्टभक्षाऽर्थिनीडाऽर्थिविहङ्गमचतुष्पदाम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87, "avatarnika": ""}, {"id": 33000508, "chapter_id": 7900, "verse_number": "88", "content_sanskrit": "आलेखनेऽपस्किरत आत्मनेपदसुङि्वधेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88, "avatarnika": ""}, {"id": 33000509, "chapter_id": 7900, "verse_number": "89", "content_sanskrit": "कान्तितर्पणयोः प्रीणात्यथ श्रीणाति मिश्रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89, "avatarnika": ""}, {"id": 33000510, "chapter_id": 7900, "verse_number": "90", "content_sanskrit": "पाके चाऽथ पृणातीति पालने पूरणेऽपि च । श्रथ्नाति प्रतिहर्षेऽपि मोचने चाऽथ पूरणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90, "avatarnika": ""}, {"id": 33000511, "chapter_id": 7900, "verse_number": "91", "content_sanskrit": "प्रुष्णाति द्वे च प्लुष्णाति मोचने स्नेहने त्रिषु । गृह्णात्येतदुपादाने ज्ञाने गृह्णीत इत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91, "avatarnika": ""}, {"id": 33000512, "chapter_id": 7900, "verse_number": "92", "content_sanskrit": "अवष्टभ्नात्यवष्टभ्नोत्यन्तिकालम्बनाऽर्थकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92, "avatarnika": ""}, {"id": 33000513, "chapter_id": 7900, "verse_number": "93", "content_sanskrit": "दर्शनाऽङ्कनयोर्लक्षयत्यथोर्जयतीति तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93, "avatarnika": ""}, {"id": 33000514, "chapter_id": 7900, "verse_number": "94", "content_sanskrit": "बलप्राणनयोः कुट्टरयति च्छेदनभर्त्सने । गत्यसंस्कारयोः शाठयति श्वठयति द्वयम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94, "avatarnika": ""}, {"id": 33000515, "chapter_id": 7900, "verse_number": "95", "content_sanskrit": "भाषाहिंसाबलाऽऽदाननिकेतेषु च पञ्चसु । पदं तुञ्जयतीत्याह तथा पिञ्जयतीत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95, "avatarnika": ""}, {"id": 33000516, "chapter_id": 7900, "verse_number": "96", "content_sanskrit": "मण्डयत्येश भूाषायां हर्षे पुस्तयतीत्यपि । म्याद्‍ आदराऽनादरयोस्तथा बुस्तयतीत्यदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96, "avatarnika": ""}, {"id": 33000517, "chapter_id": 7900, "verse_number": "97", "content_sanskrit": "मार्गसंस्कारगत्यः स्याद्‌वाजयत्येतदर्थयोः । ज्ञापने मारणाऽऽदौ च ज्ञपयत्येतद्‌ ईरितम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97, "avatarnika": ""}, {"id": 33000518, "chapter_id": 7900, "verse_number": "98", "content_sanskrit": "छेदने पूरणे चाऽपि वर्धयत्येतदर्थयोः। संश्लेषणे च ग्रहणे पदं स्पाशयते भवेत्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98, "avatarnika": ""}, {"id": 33000519, "chapter_id": 7900, "verse_number": "99", "content_sanskrit": "चेतनायां वेदयते तथाऽऽख्याने विवासने । निकारे चाऽप्युपस्कारे यातयत्येतद्‌ ईरितम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99, "avatarnika": ""}, {"id": 33000520, "chapter_id": 7900, "verse_number": "100", "content_sanskrit": "निर्यातयति वैरस्य शुद्धौ न्यासाऽर्पणे हृतौ । छेदने स्नेहने चाऽपि हरणे वासयत्यदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100, "avatarnika": ""}, {"id": 33000521, "chapter_id": 7900, "verse_number": "101", "content_sanskrit": "सम्पर्चने मोहने च रेचयत्यपि रेचति । श्रद्धायां चोपकरणे तानयत्युपतापने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101, "avatarnika": ""}, {"id": 33000522, "chapter_id": 7900, "verse_number": "102", "content_sanskrit": "शौचाऽलङ्कारयोर्मार्जयति मार्जति चरितम्‌ । लवने क्षालने चाऽर्थे स्यात्‌ पल्पूलयतीत्यदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102, "avatarnika": ""}, {"id": 33000523, "chapter_id": 7900, "verse_number": "103", "content_sanskrit": "वर्णक्रियायां विस्तारे गुणोक्तौ वर्णयत्यदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103, "avatarnika": ""}, {"id": 33000524, "chapter_id": 7900, "verse_number": "104", "content_sanskrit": "ॠतीयते धिग्घृणयोः पूजावृद्ध्योर्महीयते । भोजने तन्निवृत्तौ च पदं व्रतयतीत्यदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104, "avatarnika": ""}, {"id": 33000525, "chapter_id": 7900, "verse_number": "105", "content_sanskrit": "रोषे च वैमनस्ये च मन्तूयतिपदं विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105, "avatarnika": ""}, {"id": 33000526, "chapter_id": 7900, "verse_number": "106", "content_sanskrit": "माधर्यपूजयोर्वल्गूयति स्यात्‌तु हृणीयते । रोषमन्दाक्षयोः स्वप्रे धौर्त्ये लेट्यति लोट्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106, "avatarnika": ""}]