[{"id": 900008484, "chapter_id": 8640, "verse_number": "21.1", "content_sanskrit": "अत्र यद्यपि भूमशब्दो बहुशब्दात् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008485, "chapter_id": 8640, "verse_number": "21.2", "content_sanskrit": "यद्वा विष्णौ प्राणशब्दसमन्वयस्योक्तत्वेनोपक्रमस्य ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008486, "chapter_id": 8640, "verse_number": "21.3", "content_sanskrit": "पूर्वपक्षस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008487, "chapter_id": 8640, "verse_number": "21.4", "content_sanskrit": "सिद्धान्तस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008488, "chapter_id": 8640, "verse_number": "21.5", "content_sanskrit": "न च भेदपक्षे प्राणाद्भूयसोऽनुक्तिर्बाधिका", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008489, "chapter_id": 8640, "verse_number": "21.6", "content_sanskrit": "नन्वत्र ‘‘प्राणो वा आशाया’’ इत्यत्र ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008490, "chapter_id": 8640, "verse_number": "21.7", "content_sanskrit": "तत्वप्रदीपे तु ‘‘अभ्युपगम्यवादत्वा’’दित्यादिनाऽयं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900008491, "chapter_id": 8640, "verse_number": "21.8", "content_sanskrit": "यद्वा पूर्वदेशसंयोगानभिव्यक्तिरुत्तरदेशसंयोगाभिव्यक्तिश्च..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900008492, "chapter_id": 8640, "verse_number": "21.9", "content_sanskrit": "अन्ये तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900008493, "chapter_id": 8640, "verse_number": "21.10", "content_sanskrit": "यच्चोक्तं सम्यक्प्रसीदत्यस्मिन्निति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900008494, "chapter_id": 8640, "verse_number": "21.11", "content_sanskrit": "केचित्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]