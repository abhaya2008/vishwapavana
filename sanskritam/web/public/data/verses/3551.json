[{"id": 2118577, "chapter_id": 3551, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2118578, "chapter_id": 3551, "verse_number": "१", "content_sanskrit": "विहारदेशं सम्प्राप्य नानाद्रुमलताकुलम् ।\nगृहैरुच्चावचैर्युक्तं पुरन्दरपुरोपमम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2118579, "chapter_id": 3551, "verse_number": "२", "content_sanskrit": "भक्ष्यैर्भोज्यैश्च पेयैश्च रसवद्भिर्महाधनैः ।\nमाल्यैश्च विविधैर्युक्तं गृहं वार्ष्णेयपाण्डवौ \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2118580, "chapter_id": 3551, "verse_number": "३", "content_sanskrit": "आविविशतुरापूर्णं रत्नैरुच्चावचैः शुभैः ।\nयथोपजोषं सर्वश्च जनश्चिक्रीड भारत \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2118581, "chapter_id": 3551, "verse_number": "४", "content_sanskrit": "वने काश्चिज्जले काश्चित् काश्चिद् वेश्मसु चाङ्गनाः ।\nयथाजोषं यथाप्रीति चिक्रीडुः कृष्णपार्थयोः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2118582, "chapter_id": 3551, "verse_number": "५", "content_sanskrit": "वासुदेवप्रिया नित्यं सत्यभामा च भामिनी ।\nद्रौपदी च सुभद्रा च वासांस्याभरणानि च \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2118583, "chapter_id": 3551, "verse_number": "६", "content_sanskrit": "प्रायच्छतां महार्हाणि स्त्रीणां ताः स्म मदोत्कटाः ।\nकाश्चित् प्रहृष्टा ननृतुश्चुक्रुशुश्च तथाऽपराः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2118584, "chapter_id": 3551, "verse_number": "७", "content_sanskrit": "जहसुश्च परा नार्यः पपुश्चान्या वरासवम् ।\nरुरुधुश्चापरास्तत्र प्रजल्पुश्च परस्परम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2118585, "chapter_id": 3551, "verse_number": "८", "content_sanskrit": "मन्त्रयामासुरन्याश्च रहस्यानि परस्परम् ।\nकाश्चिन्माल्यानि चिन्वन्तीः काश्चिन्माल्यानि दध्रिरे \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2118586, "chapter_id": 3551, "verse_number": "९", "content_sanskrit": "वेणुवीणामृदङ्गानां मनोज्ञानां च सर्वशः ।\nशब्देन पूर्यते ह स्म तद्वनं सुमहर्द्धिमत् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2118587, "chapter_id": 3551, "verse_number": "१०", "content_sanskrit": "तस्मिंस्तदा वर्तमाने कुरुदाशार्हनन्दनौ ।\nसमीपं जग्मतुः कञ्चिदुद्देशं सुमनोहरम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2118588, "chapter_id": 3551, "verse_number": "११", "content_sanskrit": "तत्र गत्वा महात्मानौ कृष्णौ परपुरञ्जयौ ।\nमहार्हासनयो राजंस्ततस्तौ सन्निषीदतुः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2118589, "chapter_id": 3551, "verse_number": "१२", "content_sanskrit": "तत्र पूर्वव्यतीतानि विक्रान्तानि महान्ति च ।\nबहूनि कथयित्वा तौ रेमाते पार्थमाधवौ\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2118590, "chapter_id": 3551, "verse_number": "१३", "content_sanskrit": "तत्रोपविष्टौ मुदितौ नाकपृष्ठेऽश्विनाविव ।\nअभ्यागच्छत् तदा विप्रो वासुदेवधनञ्जयौ \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2118591, "chapter_id": 3551, "verse_number": "१४", "content_sanskrit": "बृहत्सालप्रतीकाशः प्रतप्तकनकप्रभः ।\nहरिपिङ्गोज्ज्वलश्मश्रुः प्रमाणायामतः समः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2118592, "chapter_id": 3551, "verse_number": "१५", "content_sanskrit": "अरुणादित्यसङ्काशश्चीरवासा जटाधरः ।\nपद्मपत्राननः पिङ्गस्तेजसा प्रज्वलन्निव \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2118593, "chapter_id": 3551, "verse_number": "१६", "content_sanskrit": "जगाम तौ कृष्णपार्थौ दिधक्षन् खाण्डवं वनम् ।\nउपसृष्टं तु तं कृष्णो भ्राजमानं द्विजोत्तमम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2118594, "chapter_id": 3551, "verse_number": "१७", "content_sanskrit": "दृष्ट्वा जगाम मनसा पावकोऽयमिति प्रभुः ।\nअर्जुनो वासुदेवश्च तूर्णमुत्पत्य तस्थतुः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2118595, "chapter_id": 3551, "verse_number": "१८", "content_sanskrit": "सोऽब्रवीदर्जुनं चैव वासुदेवं च माधवम् ।\nलोकप्रवीरौ तिष्ठन्तौ खाण्डवस्य समीपतः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2118596, "chapter_id": 3551, "verse_number": "", "content_sanskrit": "ब्राह्मणो बहुभोक्ताऽस्मि भुञ्जेऽपरिमितं सदा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2118597, "chapter_id": 3551, "verse_number": "१९", "content_sanskrit": "भिक्षे वार्ष्णेयपाथौं वामेकां तृप्तिं प्रयच्छताम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2118598, "chapter_id": 3551, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2118599, "chapter_id": 3551, "verse_number": "२०", "content_sanskrit": "एवमुक्तौ तमब्रूतां ततस्तौ कृष्णपाण्डवौ ।\nकेनान्नेन भवांस्तृप्येत् तस्यान्नस्य यतावहे \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2118600, "chapter_id": 3551, "verse_number": "२१", "content_sanskrit": "एवमुक्तः स भगवान् अब्रवीत् तावुभौ ततः ।\nभाषमाणौ तदा वीरौ किमन्नं क्रियतामिति \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2118601, "chapter_id": 3551, "verse_number": "२२", "content_sanskrit": "नाहमन्नं बुभुक्षे वै पावकं मां निबोधतम् ।\nयदन्नमनुरूपं मे तद् युवां सम्प्रयच्छतम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2118602, "chapter_id": 3551, "verse_number": "२३", "content_sanskrit": "इदमिन्द्रः सदा दावं खाण्डवं परिरक्षति ।\nन च शक्नोम्यहं दग्धुं रक्ष्यमाणं महात्मना \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2118603, "chapter_id": 3551, "verse_number": "२४", "content_sanskrit": "वसत्यस्य सखा चात्र तक्षकः पन्नगः सदा ।\nसगणस्तत्कृते दावं परिरक्षति वज्रभृत् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2118604, "chapter_id": 3551, "verse_number": "२५", "content_sanskrit": "तत्र भूतान्यनेकानि रक्ष्यन्ते स्म प्रसङ्गतः ।\nतं निर्दग्धुं न शक्नोमि दावं शक्रस्य तेजसा \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2118605, "chapter_id": 3551, "verse_number": "२६", "content_sanskrit": "स मां प्रज्वलितं दृष्ट्वा मेघेनैवाभिवर्षति ।\nअतो दग्धुं न शक्नोमि दिधक्षुर्दावमीप्सितम् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2118606, "chapter_id": 3551, "verse_number": "२७", "content_sanskrit": "स युवाभ्यां सहायाभ्यामस्त्रविद्भ्यां समागतः ।\nदहेयं खाण्डवं दावमेतदन्नं वृतं मया \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2118607, "chapter_id": 3551, "verse_number": "२८", "content_sanskrit": "युवां ह्युदकधारास्ता भूतानि च महाभुजौ ।\nउत्तमास्त्रविदौ सम्यक् सर्वतो वारयिष्यथः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2118608, "chapter_id": 3551, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2118609, "chapter_id": 3551, "verse_number": "२९", "content_sanskrit": "किमर्थं भगवानग्निः खाण्डवं दग्धुमिच्छति ।\nकस्य वा विप्रियं कुर्वन् कस्य वा प्रियमेव च\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2118610, "chapter_id": 3551, "verse_number": "३०", "content_sanskrit": "रक्ष्यमाणं महेन्द्रेण नानासत्त्वसमायुतम् ।\nन ह्येतत्कारणं ब्रह्मन्नल्पं सम्प्रति भाति मे \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2118611, "chapter_id": 3551, "verse_number": "३१", "content_sanskrit": "न ह्यल्पे कारणे वह्निर्निर्बन्धं कर्तुमर्हति ।\nयद् ददाह सुसङ्क्रुद्धः खाण्डवं हव्यवाहनः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2118612, "chapter_id": 3551, "verse_number": "३२", "content_sanskrit": "एतत् विस्तरशो ब्रह्मन् श्रोतुमिच्छामि तत्वतः ।\nखाण्डवस्य पुरा दाहो यथा समभवन्मुने ।\nतथा मे कारणं ब्रूहि परं कौतूहलं हि मे \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2118613, "chapter_id": 3551, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2118614, "chapter_id": 3551, "verse_number": "३३", "content_sanskrit": "शृणु मे ब्रुवतो राजन् सर्वमेतद् यथातथम् ।\nयन्निमित्तं ददाहाग्निः खाण्डवं पृथिवीपते \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2118615, "chapter_id": 3551, "verse_number": "३४", "content_sanskrit": "हन्त ते कथयिष्यामि पौराणीमृषिसंस्तुताम् ।\nकथामिमां नरश्रेष्ठ खाण्डवस्य विनाशनीम् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2118616, "chapter_id": 3551, "verse_number": "३५", "content_sanskrit": "पौराणः श्रूयते तात राजा हरिहयोपमः ।\nइक्ष्वाकूणामतिरथो यज्वा विपुळदक्षिणः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2118617, "chapter_id": 3551, "verse_number": "३६", "content_sanskrit": "श्वेतकिर्नाम विख्यातो बलविक्रमसंयुतः ।\nयज्वा दानपतिर्धीमान् यथा नान्योऽस्ति कश्चन \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2118618, "chapter_id": 3551, "verse_number": "३७", "content_sanskrit": "ईजे च स महासत्रैः क्रतुभिश्चाप्तदक्षिणैः ।\nतस्य नान्याऽभवद् बुद्धिर्दिवसेदिवसे नृप\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2118619, "chapter_id": 3551, "verse_number": "३८", "content_sanskrit": "सत्ये क्रियासमारम्भे दानेषु विविधेषु च ।\nऋषिभिः सहितो धीमान् कल्पज्ञैः सह भूमिपः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2118620, "chapter_id": 3551, "verse_number": "३९", "content_sanskrit": "ततस्तु ऋत्विजस्तस्य धूमव्याकुललोचनाः ।\nकालेन महता खिन्नास्तत्यजुस्तं नराधिपम् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2118621, "chapter_id": 3551, "verse_number": "४०", "content_sanskrit": "ततः प्रचोदयामास ऋत्विजस्तान् महीपतिः ।\nचक्षुर्वैफल्यतां प्राप्तान् न प्रपेदुश्च ते तु तम् \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2118622, "chapter_id": 3551, "verse_number": "४१", "content_sanskrit": "ततस्तेषामनुमते विघ्नितस्तु नराधिपः ।\nसत्रं समापयामास ऋत्विग्भिरपरैः सह \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2118623, "chapter_id": 3551, "verse_number": "४२", "content_sanskrit": "तस्यैवं वर्तमानस्य कदाचित् कालपर्यये ।\nसत्रमाहर्तुकामस्य संवत्सरशतं किल \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2118624, "chapter_id": 3551, "verse_number": "४३", "content_sanskrit": "ऋत्विजो नाभ्यपद्यन्त समाहर्तुं महात्मनः ।\nस तु राजाऽकरोद् यत्नं महान्तं ससुहृज्जनः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2118625, "chapter_id": 3551, "verse_number": "४४", "content_sanskrit": "प्रणिपातेन सान्त्वेन दानेन च महायशाः ।\nऋत्विजोऽनुनयामास भूयोभूयस्त्वतन्द्रितः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2118626, "chapter_id": 3551, "verse_number": "४५", "content_sanskrit": "ते चास्य तमभिप्रायं न चक्रुरमितौजसः ।\nस चाश्रमस्थान् राजर्षिस्तानुवाच रुषाऽन्वितः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2118627, "chapter_id": 3551, "verse_number": "४६", "content_sanskrit": "यद्यहं पतितो विप्राः शुश्रूषायां न च स्थितः ।\nआशु त्याज्योऽस्मि युष्माभिर्ब्राह्मणैश्च जुगुप्सितः \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2118628, "chapter_id": 3551, "verse_number": "४७", "content_sanskrit": "तन्नार्हत क्रतुश्रद्धां व्याघातयितुमुत्तमाम् ।\nसान्त्वदानादिभिर्वाक्यैर्भवन्तः कार्यवत्तया \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2118629, "chapter_id": 3551, "verse_number": "४८", "content_sanskrit": "प्रसादयित्वा वक्ष्यामि यन्नः कार्यं द्विजोत्तमाः ।\nअथवाऽहं परित्यक्तो भवद्भिर्द्वेषकारणात् \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2118630, "chapter_id": 3551, "verse_number": "४९", "content_sanskrit": "ऋत्विजोऽन्यान् गमिष्यामि याजनार्थं द्विजोत्तमाः ।\nएतावदुक्त्वा वचनं विरराम स पार्थिवः \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2118631, "chapter_id": 3551, "verse_number": "५०", "content_sanskrit": "यदा न शेकू राजानं याजनार्थं परन्तपाः ।\nततस्ते याजकाः क्रुद्धास्तमूचुर्नृपसत्तमम् \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2118632, "chapter_id": 3551, "verse_number": "५१", "content_sanskrit": "तव कर्माण्यजस्रं वै वर्तन्ते पार्थिवोत्तम ।\nततो वयं परिश्रान्ताः सततं कर्मवाहिनः \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2118633, "chapter_id": 3551, "verse_number": "५२", "content_sanskrit": "श्रमादस्मात् परिश्रान्तान् स त्वं नस्त्यक्तुमर्हसि ।\nबुद्धिमोहं समास्थाय त्वरासम्भावितोऽनघ ।\nगच्छ रुद्रसकाशं त्वं स हि त्वां योजयिष्यति \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2118634, "chapter_id": 3551, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2118635, "chapter_id": 3551, "verse_number": "५३", "content_sanskrit": "साधिक्षेपं वचः श्रुत्वा सङ्क्रुद्धः श्वेतकिर्नृपः ।\nकैलासपर्वतं गत्वा तप उग्रं समास्थितः \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2118636, "chapter_id": 3551, "verse_number": "५४", "content_sanskrit": "आराधयन् महादेवं नियतः संशितव्रतः ।\nउपवासपरो राजन् दीर्घकालमतिष्ठत \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2118637, "chapter_id": 3551, "verse_number": "५५", "content_sanskrit": "कदाचिद् द्वादशे काले कदाचिदपि षोडशे ।\nआहारमकरोद् राजा मूलानि च फलानि च \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2118638, "chapter_id": 3551, "verse_number": "५६", "content_sanskrit": "ऊर्ध्वबाहुस्त्वनिमिषस्तिष्ठन् स्थाणुरिवाचलः ।\nषण्मासानभवद् राजा श्वेताकिः सुसमाहितः \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2118639, "chapter_id": 3551, "verse_number": "५७", "content_sanskrit": "तं तथा नृपशार्दूलं तप्यमानं महत्तपः ।\nशङ्करः परमप्रीत्या दर्शयामास भारत \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2118640, "chapter_id": 3551, "verse_number": "५८", "content_sanskrit": "उवाच चैनं भगवान् स्निग्धगम्भीरया गिरा ।\nप्रीतोऽस्मि नरशार्दूल तपसा ते परन्तप ।\nवरं वृणीष्व भद्रं ते यं त्वमिच्छसि पार्थिव \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2118641, "chapter_id": 3551, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2118642, "chapter_id": 3551, "verse_number": "५९", "content_sanskrit": "एतच्छ्रुत्त्वा तु वचनं रुद्रस्यामिततेजसः ।\nप्रणिपत्य महात्मानं राजर्षिः प्रत्यभाषत \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2118643, "chapter_id": 3551, "verse_number": "६०", "content_sanskrit": "यदि मे भगवन् प्रीतः सर्वलोकनमत्कृतः ।\nस्वयं मां देवदेवेश याजयस्व सुरेश्वर \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2118644, "chapter_id": 3551, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2118645, "chapter_id": 3551, "verse_number": "६१", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं राज्ञा तेन प्रभाषितम् ।\nउवाच भगवान् प्रीतः स्मितपूर्वमिदं वचः \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2118646, "chapter_id": 3551, "verse_number": "६२", "content_sanskrit": "नास्माकमेतद्विषयो वर्तते याजनं प्रति ।\nत्वया च सुमहत् तप्तं तपो राजन् वरार्थिना \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2118647, "chapter_id": 3551, "verse_number": "६३", "content_sanskrit": "याजयिष्यामि राजंस्त्वां समयेन परन्तप ।\nसमा द्वादश राजेन्द्र ब्रह्यचारी समाहितः \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2118648, "chapter_id": 3551, "verse_number": "६४", "content_sanskrit": "सततं त्वाज्यधाराभिर्यदि तर्पयसेऽनलम् ।\nकामं प्रार्थयसे यं त्वं मत्तः प्राप्स्यसि तं नृप \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2118649, "chapter_id": 3551, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2118650, "chapter_id": 3551, "verse_number": "६५", "content_sanskrit": "एवमुक्तस्तु रुद्रेण श्वेतकिर्मनुजाघिपः ।\nतथा चकार तत् सर्वं यथोक्तं शूलपाणिना \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2118651, "chapter_id": 3551, "verse_number": "६६", "content_sanskrit": "पूर्णे तु द्वादशे वर्षे पुनरायान्महेश्वरम् ।\nदृष्ट्वैव स च राजानं शङ्करो लोकभावनः \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2118652, "chapter_id": 3551, "verse_number": "६७", "content_sanskrit": "उवाच परमप्रीतः श्वेतकिं नृपसत्तमम् ।\nतोषितोऽहं नृपश्रेष्ठ त्वयेहाद्येन कर्मणा \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2118653, "chapter_id": 3551, "verse_number": "६८", "content_sanskrit": "याजनं ब्राह्मणानां तु विधिदृष्टं परन्तप ।\nअतोऽहं त्वां स्वयं नाद्य याजयामि परन्तप \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2118654, "chapter_id": 3551, "verse_number": "६९", "content_sanskrit": "ममांशस्तु क्षितितळे महाभागो द्विजोत्तमः ।\nदुर्वासा इति विख्यातः स हि त्वां याजयिष्यति ।\nमन्नियोगान्महातेजाः सम्भाराः सम्भ्रियन्तु ते \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2118655, "chapter_id": 3551, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2118656, "chapter_id": 3551, "verse_number": "७०", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं रुद्रेण समुदाहृतम् ।\nस्वपुरं पुनरागम्य सम्भारान् पुनरार्जयत् \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2118657, "chapter_id": 3551, "verse_number": "७१", "content_sanskrit": "ततः सम्भृतसम्भारो भूयो रुद्रमुपागमत् ।\nसम्भृता मम सम्भाराः सर्वोपकरणानि च \t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2118658, "chapter_id": 3551, "verse_number": "७२", "content_sanskrit": "त्वत्प्रसादान्महादेव श्वो मे दीक्षा भवेदिति ।\nएतच्छ्रुत्वा तु वचनं तस्य राज्ञो महात्मनः \t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2118659, "chapter_id": 3551, "verse_number": "७३", "content_sanskrit": "दुर्वाससं समाहूय रुद्रो वचनमब्रवीत् ।\nएष राजा महाभागः श्वेतकिर्द्विजसत्तम ।\nएनं याजय विप्रेन्द्र मन्नियोगेन भूमिपम् \t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2118660, "chapter_id": 3551, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2118661, "chapter_id": 3551, "verse_number": "७४", "content_sanskrit": "बाढमित्येव वचनं रुद्रं त्वृषिरुवाच ह ।\nततः सत्रं समभवत् तस्य राज्ञो महात्मनः \t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2118662, "chapter_id": 3551, "verse_number": "७५", "content_sanskrit": "यथाकामं यथोक्तं च सत्रं सुबहुदक्षिणम् ।\nतस्मिन् परिसमाप्ते तु राज्ञः सत्रे महात्मनः \t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2118663, "chapter_id": 3551, "verse_number": "७६", "content_sanskrit": "दुर्वाससाऽभ्यनुज्ञाता विप्रतस्थुः स्म याजकाः ।\nये तत्र दीक्षिताः सर्वे सदस्याश्च महौजसः \t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2118664, "chapter_id": 3551, "verse_number": "७७", "content_sanskrit": "सोऽपि राजा महाभागः स्वपुरं प्राविशत् तदा ।\nततो भगवतो वह्नेर्विकारः समजायत \t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2118665, "chapter_id": 3551, "verse_number": "७८", "content_sanskrit": "तेजसा विप्रहीणश्च ग्लानिश्चैनं समाविशत् ।\nस लक्षयित्वा चात्मानं तेजोहीनं हुताशनः \t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2118666, "chapter_id": 3551, "verse_number": "७९", "content_sanskrit": "जगाम सदनं पुण्यं ब्रह्मणो लोकपूजितम् ।\nतत्र ब्रह्माणमासीनमिदं वचनमब्रवीत् \t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2118667, "chapter_id": 3551, "verse_number": "८०", "content_sanskrit": "तेजसा विप्रहीणोऽस्मि बलेन च जगत्पते ।\nइच्छेयं त्वत्प्रसादेन आत्मनः प्रकृतिं स्थिराम् \t॥ ८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2118668, "chapter_id": 3551, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2118669, "chapter_id": 3551, "verse_number": "८१", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं भगवांत्सर्वलोककृत् ।\nहव्यवाहमिदं वाक्यमुवाच प्रहसन्निव \t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2118670, "chapter_id": 3551, "verse_number": "८२", "content_sanskrit": "त्वया द्वादशवर्षाणि वसोर्धाराहृतं हविः ।\nउपयुक्तं महाभाग तेन त्वां ग्लानिराविशत् \t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2118671, "chapter_id": 3551, "verse_number": "८३", "content_sanskrit": "तेजसा विप्रहीणस्त्वं सहसा हव्यवाहन ।\nमा गमस्त्वं व्यथां वह्ने प्रकृतिस्थो भविष्यसि \t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2118672, "chapter_id": 3551, "verse_number": "८४", "content_sanskrit": "अरुचिं नाशयिष्ये ते समयं प्रतिपद्य तु ।\nपुरा देवनियोगेन न त्वया भस्मसात्कृतम् \t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2118673, "chapter_id": 3551, "verse_number": "८५", "content_sanskrit": "आलयं देवशत्रूणां सुघोरः खाण्डवं वनम् ।\nतत्र सर्वाणि सत्त्वानि निवसन्ति विभावसो \t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2118674, "chapter_id": 3551, "verse_number": "८६", "content_sanskrit": "तेषां त्वं मेदसा तृप्तः प्रकृतिस्थो भविष्यसि ।\nमत्प्रसादाच्छविः सम्यक् त्वयि वह्ने भविष्यति ।\nगच्छ शीघ्रं वनं दग्धुं तत्र मोक्ष्यसि किल्बिषात् \t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2118675, "chapter_id": 3551, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2118676, "chapter_id": 3551, "verse_number": "८७", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं परमेष्ठिमुखाच्च्युतम् ।\nउत्तमं जवमास्थाय प्रदुद्राव हुताशनः \t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2118677, "chapter_id": 3551, "verse_number": "८८", "content_sanskrit": "आगम्य खाण्डवं दावमुत्तमं जवमास्थितः ।\nसहसा प्रज्वलत्यग्निः क्रुद्धो वायुसमीरितः \t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2118678, "chapter_id": 3551, "verse_number": "८९", "content_sanskrit": "प्रदीप्तं खाण्डवं दृष्ट्वा ये स्युस्तत्र निवासिनः ।\nपरमं यत्नमातिष्ठन् पावकस्य प्रशान्तये \t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2118679, "chapter_id": 3551, "verse_number": "९०", "content_sanskrit": "करैस्तु करिणः शीघ्रं जलमादाय सत्वराः ।\nसिषिचुः पावकं क्रुद्धाः शतशोऽथ सहस्रशः \t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2118680, "chapter_id": 3551, "verse_number": "९१", "content_sanskrit": "बहुशीर्षास्तथा नागाः शिरोभिर्जलसन्ततिम् ।\nमुमुचुः पावकाभ्याशे सत्वराः क्रोधमूर्च्छिताः \t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2118681, "chapter_id": 3551, "verse_number": "९२", "content_sanskrit": "तथैवान्यानि सत्त्वानि नानाप्रहरणोद्यमैः ।\nविलयं पावकं शीघ्रमनयन् भरतर्षभ \t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2118682, "chapter_id": 3551, "verse_number": "९३", "content_sanskrit": "अनेन तु प्रकारेण भूयो भूयश्च प्रज्वलन् ।\nसप्तजिह्वः प्रशमितः खाण्डवे हव्यवाहनः \t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2118683, "chapter_id": 3551, "verse_number": "९४", "content_sanskrit": "स तु नैराश्यमापन्नः सदा ग्लानिसमन्वितः ।\nपितामहमुपागच्छत् सङ्क्रुद्धो हव्यवाहनः \t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2118684, "chapter_id": 3551, "verse_number": "९५", "content_sanskrit": "तच्च सर्वं यथान्यायं ब्रह्मणे स न्यवेदयत् ।\nउवाच चैनं भगवान् मुहूर्तं स विचिन्त्य तु \t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2118685, "chapter_id": 3551, "verse_number": "९६", "content_sanskrit": "उपायः परिदृष्टो मे यथा त्वं धक्ष्यसेऽनघ ।\nकालं च कञ्चित् क्षमतां ततस्तं धक्ष्यते भवान् \t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2118686, "chapter_id": 3551, "verse_number": "९७", "content_sanskrit": "भविष्यतः सहायौ तौ नरनारायणावृषी ।\nताभ्यां त्वं रक्षितो दावं धक्ष्यसे हव्यवाहन \t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2118687, "chapter_id": 3551, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2118688, "chapter_id": 3551, "verse_number": "९८", "content_sanskrit": "एवमस्त्विति तं वह्निर्ब्रह्माणं समभाषत ।\nकालस्य सहनो राजन् तस्य वाक्यं स्वयम्भुवः\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2118689, "chapter_id": 3551, "verse_number": "९९", "content_sanskrit": "अनुस्मृत्य जगामाथ पुनरेव पितामहम् ।\nअब्रवीच्च तदा ब्रह्म यथा त्वं धक्ष्यसेऽनल \t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2118690, "chapter_id": 3551, "verse_number": "१००", "content_sanskrit": "स्वाण्डवं दावमद्यैव मिषतोऽस्य शचीपतेः ।\nनरनारायणौ यौ तौ पूर्वदेवौ विभावसो \t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2118691, "chapter_id": 3551, "verse_number": "१०१", "content_sanskrit": "सम्प्राप्तौ मानुषं देहं कार्यार्थं हि दिवौकसाम् ।\nअर्जुनं वासुदेवं च यौ तौ लोकोऽभिमन्यते \t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2118692, "chapter_id": 3551, "verse_number": "१०२", "content_sanskrit": "तावैतौ सहितौ वह्ने खाण्डवस्य समीपतः ।\nतौ त्वं याचस्व साहाय्ये दाहार्थं खाण्डवस्य च\t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2118693, "chapter_id": 3551, "verse_number": "१०३", "content_sanskrit": "ततो धक्ष्यसि तं दावं रक्षितं त्रिदशैरपि ।\nतौ तु सत्त्वानि सर्वाणि यत्नतो वारयिष्यतः ।\nदेवराजं च सहितौ तत्र मे नास्ति संशयः \t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2118694, "chapter_id": 3551, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2118695, "chapter_id": 3551, "verse_number": "१०४", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं त्वरितो हव्यवाहनः ।\nकृष्णपार्थावुपागम्य यत् पार्थं प्रत्यभाषत \t॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2118696, "chapter_id": 3551, "verse_number": "१०५", "content_sanskrit": "तत् ते कथितवानस्मि पूर्वमेव नृपोत्तम ।\nतच्छ्रुत्वा वचनं त्वग्नेर्बीभत्सुर्जातवेदसम्\t॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2118697, "chapter_id": 3551, "verse_number": "१०६", "content_sanskrit": "अब्रवीन्नृपशार्दूल तत्कालसदृशं वचः ।\nदिधक्षुं खाण्डवं दावमकामस्य शतक्रतोः \t॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2118698, "chapter_id": 3551, "verse_number": "१०७", "content_sanskrit": "उत्तमास्त्राणि मे सन्ति दिव्यानि च बहूनि च ।\nयैरहं शक्नुयां योद्धुमपि वज्रभृतो बहून् \t॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2118699, "chapter_id": 3551, "verse_number": "१०८", "content_sanskrit": "धनुर्मे नास्ति भगवन् बाहुवीर्येण सम्मितम् ।\nकुर्वतः समरे यत्नं वेगं यद् विषहेत वा \t॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2118700, "chapter_id": 3551, "verse_number": "१०९", "content_sanskrit": "शरैस्त्वदर्थे बहुभिरक्षयैः क्षिप्रमस्यतः ।\nन हि वोढुं रथः शक्तः शरान् मम यथेप्सितान् \t॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2118701, "chapter_id": 3551, "verse_number": "११०", "content_sanskrit": "अश्वांश्च दिव्यानिच्छेयं पाण्डरान् वातरंहसः ।\nरथं च मेघनिर्घोषं सूर्यप्रतिमतेजसम् \t॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2118702, "chapter_id": 3551, "verse_number": "१११", "content_sanskrit": "तथा कृष्णस्य वीर्येण नायुधं विद्यते समम् ।\nयेन नागान् पिशाचांश्च निहन्यान्माधवो रणे \t॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2118703, "chapter_id": 3551, "verse_number": "११२", "content_sanskrit": "उपायं कर्मणः सिद्धौ भगवन् वक्तुमर्हसि ।\nनिवारयेयं येनेन्द्रं वर्षमाणं महाशनिम् \t॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2118704, "chapter_id": 3551, "verse_number": "११३", "content_sanskrit": "पौरुषेण तु यत् कार्यं तत् कर्तारौ स्व पावक ।\nकरणानि समर्थानि भगवन् दातुमर्हसि \t॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2118705, "chapter_id": 3551, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2118706, "chapter_id": 3551, "verse_number": "११४", "content_sanskrit": "एवमुक्तस्तु भगवान् धूमकेतुर्हुताशनः ।\nचिन्तयामास वरुणं लोकपालं दिदृक्षया \t॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2118707, "chapter_id": 3551, "verse_number": "११५", "content_sanskrit": "श्वेतकुण्डलिनं देवं सर्वाभरणभूषितम् ।\nस च सञ्चिन्तितं ज्ञात्वा दर्शयामास पावकम् \t॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2118708, "chapter_id": 3551, "verse_number": "११६", "content_sanskrit": "तमब्रवीद् धूमकेतुः प्रतिपूज्य जलेश्वरम् ।\nचतुर्थं लोकपालानां रक्षितारं महेश्वरम्\t॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2118709, "chapter_id": 3551, "verse_number": "११७", "content_sanskrit": "सोमेन राज्ञा यद् दत्तं धनुश्चैवेषुधी च ये ।\nतत् प्रयच्छोभयं दिव्यं त्वमस्मै सव्यसाचिने \t॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2118710, "chapter_id": 3551, "verse_number": "११८", "content_sanskrit": "दिव्यैरश्वैः समायुक्तं रथं च कपिलक्षणम् ।\nकार्यं च सुमहत् पार्थो गाण्डीवेन करिष्यति ।\nचक्रेण वासुदेवश्च तन्मदर्थे प्रदीयताम् \t॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2118711, "chapter_id": 3551, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2118712, "chapter_id": 3551, "verse_number": "११९", "content_sanskrit": "ददानीत्येव वरुणः पावकं प्रत्यभाषत ।\nतदद्भुतं महावीर्यं यशःकीर्तिविवर्धनम् \t॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2118713, "chapter_id": 3551, "verse_number": "१२०", "content_sanskrit": "सर्वशस्त्रैरनाधृष्यं सर्वशस्त्रप्रमाथिनम् ।\nसर्वायुधमहामात्रं परसेनाप्रधर्षणम् \t॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2118714, "chapter_id": 3551, "verse_number": "१२१", "content_sanskrit": "एकं शतसहस्रेण सम्मितं राष्ट्रवर्धनम् ।\nचित्रमुच्चावचैर्वर्णैः शोभितं श्लक्ष्णमव्रणम् \t॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2118715, "chapter_id": 3551, "verse_number": "१२२", "content_sanskrit": "देवगन्धर्वऋषिभिः पूजितं शाश्वतीः समाः ।\nप्रादाच्चैव धनूरत्नमक्षय्ये च महेषुधी \t॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2118716, "chapter_id": 3551, "verse_number": "१२३", "content_sanskrit": "रथं च दिव्यास्त्रयुजं कपिप्रवरलक्षणम् ।\nउपेतं कामगैरश्वैर्गान्धर्वैर्हेममालिभिः \t॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 2118717, "chapter_id": 3551, "verse_number": "१२४", "content_sanskrit": "पाण्डराभ्रप्रतीकाशैर्मनोवायुसमैर्जवे ।\nसर्वोपकरणैर्युक्तमजय्यं देवदानवैः \t॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 2118718, "chapter_id": 3551, "verse_number": "१२५", "content_sanskrit": "भानुमन्तं महाघोषं सर्वभूतमनोहरम् ।\nससर्ज यं सुतपसा भुवने भुवनप्रभुः \t॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 2118719, "chapter_id": 3551, "verse_number": "१२६", "content_sanskrit": "प्रजापतिरनिर्देश्यं यस्य रूपं रवेरिव ।\nयं स्म सोमः समारुह्य दानवानजयत् प्रभुः \t॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 2118720, "chapter_id": 3551, "verse_number": "१२७", "content_sanskrit": "नवमेघप्रतीकाशं ज्वलन्तमिव च श्रिया ।\nआश्रिता तं रथश्रेष्ठं शक्रायुधसमा बभौ \t॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 2118721, "chapter_id": 3551, "verse_number": "१२८", "content_sanskrit": "तापनीया सुरुचिरा ध्वजयष्टिरनुत्तमा ।\nतस्यां तु वानरो दिव्यः सिंहलाङ्गूललक्षणः \t॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 2118722, "chapter_id": 3551, "verse_number": "१२९", "content_sanskrit": "भीमो ननर्द तत्रस्थः संस्थितो मूर्ध्न्थशोभत ।\nध्वजे भूतानि तत्रासन् विविधानि महान्ति च \t॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 2118723, "chapter_id": 3551, "verse_number": "१३०", "content_sanskrit": "नादेन परसैन्यानां येषां प्रज्ञा प्रणश्यति ।\nस तं नानापताकाभिः शोभितं रथसत्तमम् \t॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 2118724, "chapter_id": 3551, "verse_number": "१३१", "content_sanskrit": "प्रदक्षिणमुपावृत्य दैवतेभ्यः प्रणम्य च ।\nसन्नद्धः कवची खङ्गी बद्धगोधाङ्गुलित्रवान् \t॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 2118725, "chapter_id": 3551, "verse_number": "१३२", "content_sanskrit": "आरुरोह तदा पार्थो विमानं सुकृती यथा ।\nतच्च दिव्यं धनुश्श्रेष्ठं ब्रह्मणा निर्मितं पुरा \t॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 2118726, "chapter_id": 3551, "verse_number": "१३३", "content_sanskrit": "गाण्डीवमुपसङ्गृह्य बभूव मुदितोऽर्जुनः ।\nहुताशनं नमस्कृत्य ततस्तदतिवीर्यवान् \t॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 2118727, "chapter_id": 3551, "verse_number": "१३४", "content_sanskrit": "जग्राह बलमास्थाय ज्यया च युयुजे धनुः ।\nमौर्व्यां तु युज्यमानायां पाण्डवेन बलीयसा\t॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 2118728, "chapter_id": 3551, "verse_number": "१३५", "content_sanskrit": "येऽशृण्वन् कूजितं तत्र तेषां तु व्यथते मनः ।\nलब्ध्वा धनू रथं चैव तथाऽक्षय्ये महेषुधी \t॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 2118729, "chapter_id": 3551, "verse_number": "१३६", "content_sanskrit": "बभूव कल्यः कौन्तेयः प्रहृष्टः साह्यकर्मणि ।\nवज्रनाभं पुनश्चक्रं ददौ कृष्णाय पावकः \t॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}, {"id": 2118730, "chapter_id": 3551, "verse_number": "१३७", "content_sanskrit": "आग्नेयमस्त्रं दयितं स च कल्योऽभवत् तदा ।\nअब्रवीत् पावकश्चैतदेतेन मधुसूदन \t॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 154}, {"id": 2118731, "chapter_id": 3551, "verse_number": "१३८", "content_sanskrit": "अमानुषानपि रणे विजेष्यसि न संशयः ।\nअनेन त्वं मनुष्याणां देवानामपि चाहवे \t॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 155}, {"id": 2118732, "chapter_id": 3551, "verse_number": "१३९", "content_sanskrit": "रक्षःपिशाचदैत्यानां नागानां चाधिकस्तथा ।\nभविष्यसि न सन्देहः प्रवीरारीन् निहन् रणे \t॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 156}, {"id": 2118733, "chapter_id": 3551, "verse_number": "१४०", "content_sanskrit": "तवैतच्चक्रमस्त्रं यत् सुदर्शनं नाम नामतः ।\nतच्चास्मिन्नर्पय विभो दैत्यघाते यथा पुरा \t॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 157}, {"id": 2118734, "chapter_id": 3551, "verse_number": "१४१", "content_sanskrit": "क्षिप्तं क्षिप्तं रणे चैतत् त्वया माधव शत्रुषु ।\nहत्वाऽप्रतिहतं सङ्खे पाणिमेष्यति ते पुनः \t॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 158}, {"id": 2118735, "chapter_id": 3551, "verse_number": "१४२", "content_sanskrit": "वरुणश्च ददौ तस्मै गदामशनिनिस्वनाम् ।\nदैत्यान्तकरणीं घोरां गदां कौमोदकीं हरेः\t॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 159}, {"id": 2118736, "chapter_id": 3551, "verse_number": "१४३", "content_sanskrit": "ततः पावकमब्रूतां प्रहृष्टावर्जुनाच्युतौ ।\nकृतास्त्रौ शस्त्रसम्पन्नौ रथिनौ ध्वजिनावपि \t॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 160}, {"id": 2118737, "chapter_id": 3551, "verse_number": "१४४", "content_sanskrit": "कल्यौ स्वो भगवन् योद्धुमपि सर्वैः सुरासुरैः ।\nकिं पुनर्वज्रिणैकेन पन्नगार्थे युयुत्सता \t॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 161}, {"id": 2118738, "chapter_id": 3551, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 162}, {"id": 2118739, "chapter_id": 3551, "verse_number": "१४५", "content_sanskrit": "चक्रमस्त्रं च वार्ष्णेयो विसृजन् युधि वीर्यवान् ।\nत्रिषु लोकेषु तन्नास्ति यन्न जीयाज्जनार्दनः \t॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 163}, {"id": 2118740, "chapter_id": 3551, "verse_number": "१४६", "content_sanskrit": "गाण्डीवं धनुरादाय तथाऽक्षय्ये महेषुधी ।\nअहमप्युत्सहे लोकान् विजेतुं युधि पावक \t॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 164}, {"id": 2118741, "chapter_id": 3551, "verse_number": "१४७", "content_sanskrit": "सर्वतः परिवार्यैनं नादेन महता प्रभो ।\nकामं सम्प्रज्वलाद्यैव कल्यौ स्वः साह्यकर्मणि \t॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 165}, {"id": 2118742, "chapter_id": 3551, "verse_number": "१४८", "content_sanskrit": "यदि स्वाण्डवमेष्यति प्रमादात्\nसगणो वा परिरक्षितुं महेन्द्रः ।\nशरताडितकण्ठकुण्डलानां\nव्यसनं द्रक्ष्यति देववाहिनीनाम् \t॥१४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 166}, {"id": 2118743, "chapter_id": 3551, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 167}, {"id": 2118744, "chapter_id": 3551, "verse_number": "१४९", "content_sanskrit": "एवमुक्तः स भगवान् दाशार्हेणर्जुनेन ह ।\nतैजसं रूपमास्थाय दग्धुं दावं प्रचक्रमे \t॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 168}, {"id": 2118745, "chapter_id": 3551, "verse_number": "१५०", "content_sanskrit": "सर्वतः परिवार्यैनं दावं सुविततं प्रभो ।\nददाह खाण्डवं क्रुद्धो युगान्तमिव दर्शयन् \t॥१५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 169}, {"id": 2118746, "chapter_id": 3551, "verse_number": "१५२", "content_sanskrit": "परिगृह्य समाविष्टस्तद्वनं मनुजर्षभ ।\nमेघस्तनितनिर्घोषः सर्वभूतानि निर्दहन् \t॥१५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 170}, {"id": 2118747, "chapter_id": 3551, "verse_number": "१५३", "content_sanskrit": "दह्यतस्तस्य च बभौ रुपं दावस्य भारत ।\nमेरोरिव महीध्रस्य काञ्चनस्य महाद्युतेः \t॥१५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 171}, {"id": 2118748, "chapter_id": 3551, "verse_number": "२३०", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nत्रिंशत्यधिकद्विशततमोऽध्यायः ॥२३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 172}, {"id": 2118749, "chapter_id": 3551, "verse_number": "२", "content_sanskrit": "॥ इति खाण्डवदाहपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 173}, {"id": 2118750, "chapter_id": 3551, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 174}]