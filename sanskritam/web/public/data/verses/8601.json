[{"id": 900007911, "chapter_id": 8601, "verse_number": "182.1", "content_sanskrit": "तस्मात्सुखाभावाय को यतेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900007912, "chapter_id": 8601, "verse_number": "182.2", "content_sanskrit": "अल्पाच्च सुखनाशाद्धि बिभेत्यतितरां जनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900007913, "chapter_id": 8601, "verse_number": "182.3", "content_sanskrit": "न च रागनिमित्तं तत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900007914, "chapter_id": 8601, "verse_number": "182.4", "content_sanskrit": "विमतो दुःखयुग्यस्माच्चेतनः सन्त्सुखोख्खितः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900007915, "chapter_id": 8601, "verse_number": "182.5", "content_sanskrit": "सर्वश्रुतिपुराणेषु सुखभावोक्तितस्तथा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900007916, "chapter_id": 8601, "verse_number": "182.6", "content_sanskrit": "शिरःकराद्यभावश्च न मुक्तस्य भवेत् क्वचित्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900007917, "chapter_id": 8601, "verse_number": "182.7", "content_sanskrit": "न वर्तते यत्र रजस्तमस्तयोः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900007918, "chapter_id": 8601, "verse_number": "182.8", "content_sanskrit": "शिरः कराद्यैरपि मुक्तिभाजो युक्ता यतस्ते पुरुषा इदानीम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900007919, "chapter_id": 8601, "verse_number": "182.9", "content_sanskrit": "न ब्रह्मरूपत्वममुष्यदेहिनो मुक्तावपि स्यात्प्रमया कथञिचत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900007920, "chapter_id": 8601, "verse_number": "182.10", "content_sanskrit": "कालोऽप्यसौ नैक्ययुतः परेण जीवस्य कालो यत एष यद्वत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900007921, "chapter_id": 8601, "verse_number": "182.11", "content_sanskrit": "न चैव मुक्तेन हरेः पृथक्त्वमैक्यं तथा स्यादिति युक्तिमेति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900007922, "chapter_id": 8601, "verse_number": "182.12", "content_sanskrit": "इत्थं मतानि भ्रमजानि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900007923, "chapter_id": 8601, "verse_number": "182.13", "content_sanskrit": "औदार्यमुच्चावचशक्तिरात्मस्वरूपदार्ढ्यं च निजस्वभावः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]