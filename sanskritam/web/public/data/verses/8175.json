[{"id": 900000599, "chapter_id": 8175, "verse_number": "2.1", "content_sanskrit": "रुद्रादीनां सकाशात् विष्ण्वादीामेवाप्तत्वम् । श्रुत्यनुसारित्वात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900000600, "chapter_id": 8175, "verse_number": "2.2", "content_sanskrit": "उक्तविरोधिनस्तत्तत्समयसिद्धाः पूर्वपक्षन्यायाः तद्विरोधिनोन्ये इति प्रसिद्धा एव", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900000601, "chapter_id": 8175, "verse_number": "2.3", "content_sanskrit": "न च वियतः उत्पत्तिमत्वेनुभूतियुक्तिबहुवाग्विरोधोस्ति व्यवस्थायोगात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900000602, "chapter_id": 8175, "verse_number": "2.4", "content_sanskrit": "न च प्राणानामुत्पत्यङ्गीकारे \"प्राणा एवानादयः' इत्यादिस्पष्टार्थवद्विशेषश्रुतिविरोधः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]