[{"id": 2099203, "chapter_id": 3123, "verse_number": "१३-२५३-१", "content_sanskrit": "युधिष्ठिर उवाच।\nकृपया परया प्रोक्तः सर्वेषां पापकर्मणाम्।\nज्ञानस्य च परस्येह तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2099204, "chapter_id": 3123, "verse_number": "१३-२५३-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2099205, "chapter_id": 3123, "verse_number": "१३-२५३-२", "content_sanskrit": "उपायोऽयं परप्राप्तौ परमः परिकीर्तितः।\nनारायणास्यानुध्यानमर्चनं यजनं स्तुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2099206, "chapter_id": 3123, "verse_number": "१३-२५३-३", "content_sanskrit": "श्रवणं तत्कथानां च विद्वत्संरक्षणं तथा।\nविद्वच्छुश्रूषणप्रीतिरुपदेशानुपालनम्।\nस ध्यानेन जपेननाशु मुच्यते प्राकृतोपि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2099207, "chapter_id": 3123, "verse_number": "१३-२५३-४", "content_sanskrit": "जपश्चतुर्विधः प्रोक्तो वैदिकस्तान्त्रिकोपि च।\nपौराणिकोथ विद्वद्भिः कथितः स्मार्त एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2099208, "chapter_id": 3123, "verse_number": "१३-२५३-५", "content_sanskrit": "विद्वच्छुश्रूषया ज्ञानं विद्वत्संरक्षणेन च।\nनासाध्यं ज्ञानिनां किञ्चित्तस्माद्रक्ष्यास्त्वया द्विजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2099209, "chapter_id": 3123, "verse_number": "१३-२५३-६", "content_sanskrit": "सुव्रता बन्धुहीनैका वने पूर्वं यमेन तु।\nआसीदाश्वासिता विद्वत्संरक्षणफलात्किल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2099210, "chapter_id": 3123, "verse_number": "१३-२५३-७", "content_sanskrit": "विप्रस्य मरणे हेतुस्तत्पत्नी पितृशोकदा।\nवैश्या त्वमतिलाभोऽयं विप्रकन्येति साम्प्रतम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2099211, "chapter_id": 3123, "verse_number": "१३-२५३-८", "content_sanskrit": "इत्युक्ताऽऽश्वासिताऽपृच्छत्केनैवं पापसंयुता।\nजाता विप्रकुले सम्यक् श्रेयश्चापि ब्रवीहि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2099212, "chapter_id": 3123, "verse_number": "१३-२५३-९x", "content_sanskrit": "यम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2099213, "chapter_id": 3123, "verse_number": "१३-२५३-९", "content_sanskrit": "अन्यजन्मनि विद्वांसं प्रहारैरभिपीडितम्।\nचोरशङ्काविमोक्षेण मोक्षयित्वा सुजन्मिका॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2099214, "chapter_id": 3123, "verse_number": "१३-२५३-१०", "content_sanskrit": "इत्युक्ताऽष्टाक्षरध्यानजपादिश्रेयसंयुता।\nयमेनानुगृहीताऽभूत्पुण्यलोकनिवासिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2099215, "chapter_id": 3123, "verse_number": "१३-२५३-११", "content_sanskrit": "तन्नित्यं विदुषां रक्षा तत्परोऽभूर्महीपते।\nतेषां संरक्षणात्सद्यः सर्वपापैः प्रमुच्यते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2099216, "chapter_id": 3123, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि त्रिपञ्चशदधिकद्विशततमोऽध्यायः॥ २५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]