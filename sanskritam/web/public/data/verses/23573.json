[{"id": 7003573000, "chapter_id": 23573, "verse_number": "२१३-१", "content_sanskrit": "सूत उवाच ।\nपुरा देवैर्विनिहते संग्रामे तारकामये ।\nअत्युच्छ्रिते प्रतिबले दानवानां बले तथा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003573001, "chapter_id": 23573, "verse_number": "२१३-२", "content_sanskrit": "सहस्राक्षे लब्धपदे क्षीणशत्रौ गतास्पदे ।\nसम्यक्प्रसूतिमापन्ने त्रैलोक्ये सचराचरे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003573002, "chapter_id": 23573, "verse_number": "२१३-३", "content_sanskrit": "शृङ्गे चैवाचलेन्द्रस्य मेरोः सर्वहिरण्यये ।\nमणिविद्रुमविद्धे च विपुले पंकजासने ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003573003, "chapter_id": 23573, "verse_number": "२१३-४", "content_sanskrit": "सुखोपविष्टमेकाग्रं स्थिरचित्तं कृतेक्षणम् ।\nनिवृत्तकार्यं मुदितं सूर्यवैश्वानरद्युतिम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003573004, "chapter_id": 23573, "verse_number": "२१३-५", "content_sanskrit": "प्रणम्य मूर्ध्ना चरणावुपगृह्य समाहितः ।\nब्रह्माणं परिपप्रच्छ कुमारो नतिपूर्वकः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003573005, "chapter_id": 23573, "verse_number": "२१३-६", "content_sanskrit": "सनत्कुमार उवाच ।\nभगवञ्छ्रोतुमिच्छामि पुराणमृषिसंस्तुतम् ।\nपुराणं तु महाभाग त्वत्तस्तत्त्वविदां वर ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003573006, "chapter_id": 23573, "verse_number": "२१३-७", "content_sanskrit": "कथमुत्तर गोकर्णं दक्षिणं च कथं विभो।\nशृङ्गेश्वरस्य परमं कथं सम्यक्प्रतिष्ठितम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003573007, "chapter_id": 23573, "verse_number": "२१३-८", "content_sanskrit": "क्षेत्रस्य कि प्रमाणं स्यात्किञ्च तीर्थफलं स्मृतम्।\nकथं पशुपतिस्तत्र भगवान्मृगरूपधृक् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003573008, "chapter_id": 23573, "verse_number": "२१३-९", "content_sanskrit": "सर्वैस्त्वत्प्रमुखैर्देवैः कथमासादितं पुनः ।\nमृगरूपं कथं चास्य शरीरं क्व प्रतिष्ठितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003573009, "chapter_id": 23573, "verse_number": "२१३-१०", "content_sanskrit": "यथा यत्र च यस्तत्र विधिः सम्यगनुष्ठितः ।\nतत्सर्वं निखिलेनाशु ब्रूहि मे वाग्विदां वर ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003573010, "chapter_id": 23573, "verse_number": "२१३-११", "content_sanskrit": "एवमुक्तः स भगवान्ब्रह्मा ब्रह्मविदां वरः ।\nउवाच तस्मै पुत्राय गुह्यमेतत्पुरातनम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003573011, "chapter_id": 23573, "verse_number": "२१३-१२", "content_sanskrit": "ब्रह्मोवाच ।\nशृणु वत्स महाभाग यथातत्त्वं ब्रवीमि ते ।\nपुराणमेतद्ब्रह्मर्षे सरहस्यं यथाश्रुतम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003573012, "chapter_id": 23573, "verse_number": "२१३-१३", "content_sanskrit": "अस्ति भूधरराजस्य मन्दरस्योत्तरे शुचौ ।\nमुञ्जवान्नाम शिखरो नन्दनोपवनद्युतिः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003573013, "chapter_id": 23573, "verse_number": "२१३-१४", "content_sanskrit": "वज्रस्फटिकपाषाणः प्रवालांकुरशर्क्करः ।\nनीलामलशिलावर्णो गुहानिर्झरकन्दरः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003573014, "chapter_id": 23573, "verse_number": "२१३-१५", "content_sanskrit": "विचित्रकुसुमोपेतैर्लतामञ्जीरधारिभिः ।\nरेजे यः प्रांशुभिः शृङ्गैरुल्लिखद्भिरिवाम्बरम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003573015, "chapter_id": 23573, "verse_number": "२१३-१६", "content_sanskrit": "दर्यस्तत्राधिकं रेजुर्नानाधातुपरिस्रवैः  ।\nशिलीन्ध्रकुसुमोपेताश्चित्रिता इव सर्वतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003573016, "chapter_id": 23573, "verse_number": "२१३-१७", "content_sanskrit": "तेऽत्र केतकिखण्डाश्च कुंदखंडाश्च पुष्पिताः ।\nउन्मीलिता इवाभान्ति धातकीवनराजिभिः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003573017, "chapter_id": 23573, "verse_number": "२१३-१८", "content_sanskrit": "भिन्नेन्द्रनीलविमलैर्धौतैः प्रस्रवणाम्बुभिः ।\nचित्रैः कुसुमसंछन्नैः शिलाप्रस्तरविस्तरैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003573018, "chapter_id": 23573, "verse_number": "२१३-१९", "content_sanskrit": "शक्रचापनिभै रम्यैः कुबेरभवनद्युतौ ।\nतस्मिन्नगवरे रम्ये महोरगनिषेविते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003573019, "chapter_id": 23573, "verse_number": "२१३-२०", "content_sanskrit": "क्रीडद्भिर्देवमिथुनेर्नृत्यद्भिश्चाप्सरोगणैः ।\nकूजद्भिः शिखिभिर्मत्तैः सेविते च नगोत्तमे ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003573020, "chapter_id": 23573, "verse_number": "२१३-२१", "content_sanskrit": "कल्हारकुसुमोपेते हंससारससेविते ।\nप्रसन्नसलिलाकीर्णे सरोभिः फुल्लपंकजैः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003573021, "chapter_id": 23573, "verse_number": "२१३-२२", "content_sanskrit": "गजयूथानुकीर्णाभिर्जुष्टाभिर्मृगपक्षिभिः ।\nसेविताभिर्मुनिगणैः सरिद्भिरुपशोभिते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003573022, "chapter_id": 23573, "verse_number": "२१३-२३", "content_sanskrit": "किन्नरोद्गीतकुहरे परपुष्टनिनादिते ।\nविद्याधरशताकीर्णे देवगन्धर्व सेविते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003573023, "chapter_id": 23573, "verse_number": "२१३-२४", "content_sanskrit": "धारापातैश्च तोयानां विस्फुलिङ्गैः सहस्रशः ।\nप्रज्वालितेऽतुले शृङ्गे रम्ये हरितशाद्वले ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003573024, "chapter_id": 23573, "verse_number": "२१३-२५", "content_sanskrit": "सर्वर्तुकवनोद्याने पुष्पाकरसुशोभिते ।\nयज्ञकिम्पुरुषावासे गुह्यकानामथाश्रये ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003573025, "chapter_id": 23573, "verse_number": "२१३-२६", "content_sanskrit": "तस्मिन्गिरिवरे रम्ये सेवितव्ये सुशोभने ।\nधर्मारण्ये तपःक्षेत्रे मुनिसिद्धनिषेविते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003573026, "chapter_id": 23573, "verse_number": "२१३-२७", "content_sanskrit": "वरदस्तत्र भगवान्स्थाणुर्नाम महेश्वरः ।\nसर्वामरगुरुर्देवो नित्यं सन्निहितः प्रभुः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003573027, "chapter_id": 23573, "verse_number": "२१३-२८", "content_sanskrit": "भक्तानुकम्पी स श्रीमान्गिरीन्द्रसुतया सह ।\nस ह्यध्यास्ते गिरिवरं पार्षदैश्च गुहेन च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003573028, "chapter_id": 23573, "verse_number": "२१३-२९", "content_sanskrit": "विमानयायिनः सर्वे तं देवमजमव्ययम् ।\nआजग्मुः सेवितुं देवा वरेण्यमजमव्ययम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003573029, "chapter_id": 23573, "verse_number": "२१३-३०", "content_sanskrit": "अन्ये देवनिकायाश्च सेवितुं प्रपतन्ति तम् ।\nततस्त्रेतायुगे काले नन्दी नाम महामुनिः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003573030, "chapter_id": 23573, "verse_number": "२१३-३१", "content_sanskrit": "आरिराधयिषुः शर्वं तपस्तेपे सुदारुणम् ।\nग्रीष्मे पंचतपास्तिष्ठेच्छिशिरे सलिलाश्रयः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003573031, "chapter_id": 23573, "verse_number": "२१३-३२", "content_sanskrit": "ऊर्ध्वबाहुर्निरालम्बस्तोयाऽनिलहुताशनैः ।\nव्रतैश्च विविधैरुग्रै स्तपोभिर्नियमैस्तथा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003573032, "chapter_id": 23573, "verse_number": "२१३-३३", "content_sanskrit": "जपपुष्पोपहारैश्च कालेकाले मुनिः सदा ।\nशङ्करं विधिवद्भक्त्या सोऽर्च्चयद्द्विजपुङ्गवः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003573033, "chapter_id": 23573, "verse_number": "२१३-३४", "content_sanskrit": "उग्रेण तपसात्मानं योजयामास सुव्रतः ।\nकाष्ठभूतो यदा विप्रः कृशो धर्मसुसन्ततः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003573034, "chapter_id": 23573, "verse_number": "२१३-३५", "content_sanskrit": "क्षामोऽभूत्कृष्णवर्णश्च ततः प्रीतश्च शङ्करः ।\nसम्यगाराधितो भक्त्या नियमेन च तोषितः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003573035, "chapter_id": 23573, "verse_number": "२१३-३६", "content_sanskrit": "तदात्मदर्शनं प्रादात्स मुनेर्वृषभध्वजः ।\nउक्तवांश्च मुनिं शर्वश्चक्षुर्दिव्यं ददामि ते   ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003573036, "chapter_id": 23573, "verse_number": "२१३-३७", "content_sanskrit": "अदृश्यं पश्य मे रूपं वत्स प्रीतोऽस्मि ते मुने ।\nयत्पश्यन्तीह विद्वांसो रूपमप्रतिमौजसम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003573037, "chapter_id": 23573, "verse_number": "२१३-३८", "content_sanskrit": "सहस्रसूर्यकिरणं ज्वालामालिनमूर्जितम्।\nबालार्क मण्डलाकारं प्रभामण्डलमण्डितम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003573038, "chapter_id": 23573, "verse_number": "२१३-३९", "content_sanskrit": "जटाजूटतटाश्लिष्टं चन्द्रालंकृतशेखरम् ।\nजगदालोचनं श्रीमत्प्रदीप्तस्वत्रिलोचनम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003573039, "chapter_id": 23573, "verse_number": "२१३-४०", "content_sanskrit": "प्रादेशमात्रं रुचिरं शतशीर्षं शतोदरम्।\nसहस्रबाहुचरणं सहस्राक्षिशिरोमुखम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003573040, "chapter_id": 23573, "verse_number": "२१३-४१", "content_sanskrit": "अणीयसामणीयांसं बृहतां तु बृहत्तरम् ।\nअक्षमालापवित्राङ्गं कमण्डलु करोद्यतम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003573041, "chapter_id": 23573, "verse_number": "२१३-४२", "content_sanskrit": "सिंहचर्माम्बरधरं व्यालयज्ञोपवीतिनम् ।\nदृष्ट्वा देवं महादेवं हृष्टरोमा महातपाः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003573042, "chapter_id": 23573, "verse_number": "२१३-४३", "content_sanskrit": "प्राञ्जलिः प्रणतो भूत्वाऽगृणाद्ब्रह्म सनातनम् ।\nनमो धात्रे विधात्रे च संभवे वरदाय च ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003573043, "chapter_id": 23573, "verse_number": "२१३-४४", "content_sanskrit": "जगद्भोक्त्रे त्रिनेत्राय शंकराय शिवाय च ।\nभवाय भवगोप्त्रे च मुनये कृत्तिवाससे ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003573044, "chapter_id": 23573, "verse_number": "२१३-४५", "content_sanskrit": "नीलकण्ठाय भीमाय भूतभव्यभवाय च ।\nलम्बभ्रुवे करालाय हरिनेत्राय मीढुषे ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003573045, "chapter_id": 23573, "verse_number": "२१३-४६", "content_sanskrit": "कपर्दिने विशालाय मुञ्जकेशाय धीमते ।\nशूलिने पशुपतये विभवे स्थाणवे तथा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003573046, "chapter_id": 23573, "verse_number": "२१३-४७", "content_sanskrit": "गणानां पतये स्रष्ट्रे संक्षेप्त्रे भीषणाय च ।\nसौम्याय सौम्यतपसे भीमाय त्र्यम्बकाय च ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003573047, "chapter_id": 23573, "verse_number": "२१३-४८", "content_sanskrit": "प्रेतावासनिवासाय रुद्राय वरदाय च ।\nकपालमालिने तस्मै हरिश्मश्रुधराय च ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003573048, "chapter_id": 23573, "verse_number": "२१३-४९", "content_sanskrit": "भक्तप्रियाय सततं नमोऽस्तु परमात्मने ।\nएवं नन्दी भवं स्तुत्वा नमस्कृत्य च सर्वशः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003573049, "chapter_id": 23573, "verse_number": "२१३-५०", "content_sanskrit": "प्रणम्य शिरसा देवं पुनः पुनरवन्दत ।\nततस्तु भगवान्प्रीतस्तस्मै विप्राय शंकरः। ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003573050, "chapter_id": 23573, "verse_number": "२१३-५१", "content_sanskrit": "उवाच च वचः साक्षात्तमृषिं वरदः प्रभुः ।\nवरान्वृणीष्व विप्रेन्द्र यानिच्छसि महामुने ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003573051, "chapter_id": 23573, "verse_number": "२१३-५२", "content_sanskrit": "तांस्ते सर्वान्प्रयच्छामि दुर्ल्लभानपि मारिष ।\nप्रभुत्वममरत्वं वा शक्रत्वमपि वा प्रभो ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003573052, "chapter_id": 23573, "verse_number": "२१३-५३", "content_sanskrit": "ब्रह्मत्वं लोकपालत्वमपवर्गमथापि वा ।\nअथाष्टगुणमैश्वर्यं गाणपत्यमथापि वा ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003573053, "chapter_id": 23573, "verse_number": "२१३-५४", "content_sanskrit": "यदिच्छसि मुने शीघ्रं तद्ब्रूहि द्विजपुङ्गव ।\nइत्युक्तोऽसौ भगवता शर्वेण मुनिपुङ्गवः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003573054, "chapter_id": 23573, "verse_number": "२१३-५५", "content_sanskrit": "प्रोवाच वरदं देवं प्रहृष्टेनान्तरात्मना ।\nन प्रभुत्वं न देवत्वं नेन्द्रत्वमपि वा प्रभो ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003573055, "chapter_id": 23573, "verse_number": "२१३-५६", "content_sanskrit": "ब्रह्मत्वं लोकपालत्वं नापवर्गं वरप्रद ।\nनैवाष्टगुणमैश्वर्यं गाणपत्यं न च प्रभो ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003573056, "chapter_id": 23573, "verse_number": "२१३-५७", "content_sanskrit": "स्पृहये देवदेवेश प्रसन्ने त्वयि शंकर ।\nयदि प्रीतोऽसि भगवन्ननुक्रोशतया मम ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003573057, "chapter_id": 23573, "verse_number": "२१३-५८", "content_sanskrit": "अनुग्राह्यो ह्ययं देव त्वयावश्यं सुराधिप ।\nयथान्ये न भवेद्भक्तिस्त्वत्तो नित्यं महेश्वर ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003573058, "chapter_id": 23573, "verse_number": "२१३-५९", "content_sanskrit": "तथाहं भक्तिमिच्छामि सर्वभूताशये त्वयि ।\nयथा च न भवेद्विघ्नं तपस्यानिरतस्य मे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003573059, "chapter_id": 23573, "verse_number": "२१३-६०", "content_sanskrit": "कोटिजप्येन रुद्राणामाराधनपरस्य च ।\nएतत्तु वचनं श्रुत्वा नन्दिनः स महेश्वरः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003573060, "chapter_id": 23573, "verse_number": "२१३-६१", "content_sanskrit": "प्रहस्योवाच तं प्रीत्या ततो मधुरया गिरा ।\nप्रीतोऽस्म्युत्तिष्ठ विप्रर्षे तप्यमानेन सुव्रत ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003573061, "chapter_id": 23573, "verse_number": "२१३-६२", "content_sanskrit": "आराधितश्च भक्त्याहं त्वया शुद्धेन चेतसा ।\nपर्याप्तं ते महाभाग तपः कर्तुं तपोधन ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003573062, "chapter_id": 23573, "verse_number": "२१३-६३", "content_sanskrit": "निवर्त्तयति मां वत्स मत्पादाराधने रतः ।\nजप्ता ते त्रिगुणा कोटी रुद्राणां पुरतो मम ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003573063, "chapter_id": 23573, "verse_number": "२१३-६४", "content_sanskrit": "पूर्णं वर्षसहस्रं च तपस्तीव्रं महामुने ।\nन कृतं यत्पुरा देवैर्नासुरैर्ऋषिभिर्न च ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003573064, "chapter_id": 23573, "verse_number": "२१३-६५", "content_sanskrit": "कृतं सुमहदाश्चर्यं त्वया कर्म सुदुष्करम् ।\nसंक्षोभितमिदं सर्वं त्रैलोक्यं सचराचरम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003573065, "chapter_id": 23573, "verse_number": "२१३-६६", "content_sanskrit": "आगमिष्यन्ति ते द्रष्टुं देवाः सर्वे सवासवाः ।\nअक्षयश्चाव्ययश्च त्वमतर्क्यः ससुरासुरैः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003573066, "chapter_id": 23573, "verse_number": "२१३-६७", "content_sanskrit": "दिव्यतेजोवपूः श्रीमान्दिव्याभरणभूषितः ।\nमत्तुल्यो मत्प्रभावश्च त्वमेकः ससुरासुरैः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003573067, "chapter_id": 23573, "verse_number": "२१३-६८", "content_sanskrit": "मद्रूपधारी मत्तेजास्त्र्यक्षः सर्वगुणोत्तमः ।\nभविष्यसि न सन्देहो देवदानवपूजितः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003573068, "chapter_id": 23573, "verse_number": "२१३-६९", "content_sanskrit": "अनेनैव शरीरेण जरामरणवर्जितः ।\nदुष्प्राप्येयमवाप्ता ते देवैर्गाणेश्वरी गतिः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003573069, "chapter_id": 23573, "verse_number": "२१३-७०", "content_sanskrit": "पार्षदानां वरिष्ठस्त्वं मामकानां द्विजोत्तम ।\nनन्दीश्वर इति ख्यातो भविष्यसि न संशयः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003573070, "chapter_id": 23573, "verse_number": "२१३-७१", "content_sanskrit": "प्राप्तमष्टगुणं सत्यमैश्वर्यं ते तपोधन ।\nद्वितीयां मे तनुं त्वां तु नमस्यन्ति च देवताः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003573071, "chapter_id": 23573, "verse_number": "२१३-७२", "content_sanskrit": "अद्यप्रभृति देवाग्र्य देवकार्येषु सर्वतः ।\nप्रभुस्त्वं भविता लोके मत्प्रसादान्मुनीश्वर ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003573072, "chapter_id": 23573, "verse_number": "२१३-७३", "content_sanskrit": "त्वामेवाभ्यर्च्चयिष्यन्ति सर्वभूतानि सर्वतः ।\nमत्तः समभिवाञ्छन्ति प्रसादं पार्षदाधिप ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003573073, "chapter_id": 23573, "verse_number": "२१३-७४", "content_sanskrit": "वरान्वरार्थिनां दाता विधाता जगतः सदा ।\nभविष्यसि च धर्मज्ञ भीतानामभयप्रदः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003573074, "chapter_id": 23573, "verse_number": "२१३-७५", "content_sanskrit": "यस्त्वां द्वेष्टि स मां द्वेष्टि यस्त्वामनु स मामनु ।\nनावयोरन्तरं किंचिदम्बरानिलयोरिव ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003573075, "chapter_id": 23573, "verse_number": "२१३-७६", "content_sanskrit": "द्वारे तु दक्षिणे नित्यं त्वया स्थेयं गणाधिप ।\nवामे तु विभुना चापि महाकालेन सर्वदा ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003573076, "chapter_id": 23573, "verse_number": "२१३-७७", "content_sanskrit": "प्रतीहारो भवानद्य सर्वदा त्रिदशोत्तमः ।\nशिरो मे रक्षतु भवान्महाकालेऽपि मे गणः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003573077, "chapter_id": 23573, "verse_number": "२१३-७८", "content_sanskrit": "न वज्रेण न दण्डेन न चक्रेण न चाग्निना ।\nकांचिच्छक्नोति वै बाधां कर्त्तुं वै भुवनत्रये ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003573078, "chapter_id": 23573, "verse_number": "२१३-७९", "content_sanskrit": "देवदानवगन्धर्वा यक्षराक्षसपन्नगाः ।\nत्वामेव संश्रयिष्यन्ति मद्भक्ताः पुरुषाश्च ये ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003573079, "chapter_id": 23573, "verse_number": "२१३-८०", "content_sanskrit": "त्वयि तुष्टे ह्यहं तुष्टः कुपिते कुपितस्त्वहम् ।\nत्वत्तः प्रियतरो नास्ति ममान्यो द्विजपुंगव ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003573080, "chapter_id": 23573, "verse_number": "२१३-८१", "content_sanskrit": "एवं तस्मै वरान्दत्त्वा प्रीतः स्वयमुमापतिः ।\nउवाच भूयः स्पष्टेन स्वरेणाम्बरचारिणा ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003573081, "chapter_id": 23573, "verse_number": "२१३-८२", "content_sanskrit": "आगतान्विद्धि सर्वान्वै त्रिदशान्समरुद्गणान् ।\nदिदृक्षया च भद्रं ते कृतकृत्यश्च साम्प्रतम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003573082, "chapter_id": 23573, "verse_number": "२१३-८३", "content_sanskrit": "यदीरितं मया वत्स वरं प्रतिवचस्त्वयि ।\nप्रविष्टं न श्रुतिपथं दिवि सर्वदिवौकसाम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003573083, "chapter_id": 23573, "verse_number": "२१३-८४", "content_sanskrit": "नारायणं पुरस्कृत्य सेन्द्रास्ते समरुद्गणाः।\nप्रेमार्थे चागमिष्यन्ति वरार्थं तपसाऽमराः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003573084, "chapter_id": 23573, "verse_number": "२१३-८५", "content_sanskrit": "यक्षविद्याधरगणाः सिद्धगन्धर्वपन्नगाः ।\nमुनयश्च महात्मानस्तपोलब्धाः सहस्रशः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003573085, "chapter_id": 23573, "verse_number": "२१३-८६", "content_sanskrit": "ते बुद्ध्वा त्वद्गतामृद्धि प्रतप्ताः परमेर्ष्यया ।\nतपांसि विविधान्यत्र विविधान्नियमांस्तथा ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003573086, "chapter_id": 23573, "verse_number": "२१३-८७", "content_sanskrit": "चर्तुं समभिवाञ्छन्ति सदाभ्यासे वरार्थिनः ।\nवरदं यामभिज्ञाय गिरौ मौञ्जवति स्थितम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003573087, "chapter_id": 23573, "verse_number": "२१३-८८", "content_sanskrit": "अत्रैते यावदागम्य न मां पश्यन्ति मानवाः ।\nतावदेव त्वितः शीघ्रं गमिष्यामि महामुने ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003573088, "chapter_id": 23573, "verse_number": "२१३-८९", "content_sanskrit": "अद्य ते तु मया सर्वे देवा ब्रह्मपुरोगमाः ।\nद्रष्टव्याश्चानुमन्तव्या मत्तोऽनुग्रहकांक्षिणः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003573089, "chapter_id": 23573, "verse_number": "२१३-९०", "content_sanskrit": "अभिप्रायं च सर्वेषां जानामि द्विजसत्तम ।\nअनुगुह्य वरैस्तैश्च तत्रैवान्तरधीयत ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}]