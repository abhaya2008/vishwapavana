[{"id": 6000045000, "chapter_id": 10045, "verse_number": null, "content_sanskrit": "अथ पञ्चदशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000045001, "chapter_id": 10045, "verse_number": null, "content_sanskrit": "शुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.001.m4a", "display_order": 2}, {"id": 6000045002, "chapter_id": 10045, "verse_number": "३-१५-१", "content_sanskrit": "निशम्य कौषारविणोपवर्णितां हरेः कथां कारणसूकरात्मनः।\nपुनः स पप्रच्छ समुद्यताञ्जलिर्न चातितृप्तो विदुरो धृतव्रतः॥ ३/१५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.002.m4a", "display_order": 3}, {"id": 6000045003, "chapter_id": 10045, "verse_number": null, "content_sanskrit": "विदुर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.003.m4a", "display_order": 4}, {"id": 6000045004, "chapter_id": 10045, "verse_number": "३-१५-२", "content_sanskrit": "तेनैव च मुनिश्रेष्ठ हरिणा यज्ञमूर्तिना।\nआदिदैत्यो हिरण्याक्षो हत इत्यनुशुश्रुम॥ ३/१५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.004.m4a", "display_order": 5, "topics": [{"text": "विदुरेण मैत्रेयं प्रति हिरण्याक्षवधकारणप्रश्नः", "range": "२–३"}]}, {"id": 6000045005, "chapter_id": 10045, "verse_number": "३-१५-३", "content_sanskrit": "तस्य चोद्धरतः क्षोणीं स्वदंष्ट्राग्रेण लीलया।\nदैत्यराजस्य च ब्रह्मन् कस्माद्धेतोरभून्मृधः॥ ३/१५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.005.m4a", "display_order": 6}, {"id": 6000045006, "chapter_id": 10045, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.006.m4a", "display_order": 7}, {"id": 6000045007, "chapter_id": 10045, "verse_number": "३-१५-४", "content_sanskrit": "साधु वीर त्वया पृष्टमवतारकथां हरेः।\nयत् त्वं पृच्छसि मर्त्यानां मृत्युपाशविनाशनीम्॥ ३/१५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.007.m4a", "display_order": 8, "topics": [{"text": "दित्याः कश्यपाद् असमये सन्ध्याकाले गर्भधारणादिकथाकथनम्", "range": "४–३१"}]}, {"id": 6000045008, "chapter_id": 10045, "verse_number": "३-१५-५", "content_sanskrit": "ययोत्तानपदः पुत्रो मुनिना गीतयाऽर्भकः।\nमृत्योः कृत्वेह मूर्ध्न्र्यङ्घ्रिमारुरोह हरेः पदम्॥ ३/१५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.008.m4a", "display_order": 9}, {"id": 6000045009, "chapter_id": 10045, "verse_number": "३-१५-६", "content_sanskrit": "अथात्रापीतिहासोऽयं श्रुतो मे वर्णितः पुरा।\nब्रह्मणा देवदेवेन देवानामनुपृच्छताम्॥ ३/१५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.009.m4a", "display_order": 10}, {"id": 6000045010, "chapter_id": 10045, "verse_number": "३-१५-७", "content_sanskrit": "दितिर्दाक्षायणी क्षत्तर्मारीचं कश्यपं पतिम्।\nअपत्यकामा चकमे सन्ध्यायां हृच्छयार्दिता॥ ३/१५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.010.m4a", "display_order": 11}, {"id": 6000045011, "chapter_id": 10045, "verse_number": "३-१५-८", "content_sanskrit": "इष्ट्वाऽग्निजिह्वं पयसा पुरुषं यजुषां पतिम्।\nनिम्लोचत्यर्क आसीनमग्न्यागारे समाहितम्॥ ३/१५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.011.m4a", "display_order": 12}, {"id": 6000045012, "chapter_id": 10045, "verse_number": null, "content_sanskrit": "दितिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.012.m4a", "display_order": 13}, {"id": 6000045013, "chapter_id": 10045, "verse_number": "३-१५-९", "content_sanskrit": "एष मां त्वत्कृते विद्वन् काम आत्तशरासनः।\nदुनोति दीनां विक्रम्य रम्भामिव मतङ्गजः॥ ३/१५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.013.m4a", "display_order": 14}, {"id": 6000045014, "chapter_id": 10045, "verse_number": "३-१५-१०", "content_sanskrit": "तद् भवान् दह्यमानायां सपत्नीनां समृद्धिभिः।\nप्रजावतीनां भद्रं ते मय्यायुङ्क्तामनुग्रहम्॥ ३/१५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.014.m4a", "display_order": 15}, {"id": 6000045015, "chapter_id": 10045, "verse_number": "३-१५-११", "content_sanskrit": "भर्तर्याप्तोरुमानानां लोकानाविशते यशः।\nपतिर्भवद्विधो यासां प्रजया ननु जायते॥ ३/१५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.015.m4a", "display_order": 16}, {"id": 6000045016, "chapter_id": 10045, "verse_number": "३-१५-१२", "content_sanskrit": "पुरा पिता नो भगवान् दक्षो दुहितृवत्सलः।\nकं वृणीत वरं वत्सा इत्यपृच्छत नः पृथक्॥ ३/१५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.016.m4a", "display_order": 17}, {"id": 6000045017, "chapter_id": 10045, "verse_number": "३-१५-१३", "content_sanskrit": "स विदित्वाऽऽत्मजानां नो भावं सन्तानभावनः।\nत्रयोदशाददात् तासां यास्ते शीलमनुव्रताः॥ ३/१५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.017.m4a", "display_order": 18}, {"id": 6000045018, "chapter_id": 10045, "verse_number": "३-१५-१४", "content_sanskrit": "अथ मे कुरु कल्याण कामं कञ्जविलोचन।\nआप्तोपसर्पणं भूमन्न मोघं हि महीयसि॥ ३/१५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.018.m4a", "display_order": 19}, {"id": 6000045019, "chapter_id": 10045, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.019.m4a", "display_order": 20}, {"id": 6000045020, "chapter_id": 10045, "verse_number": "३-१५-१५", "content_sanskrit": "इति तां वीर मारीचः कृपणां बहुभाषिणीम्।\nप्रत्याहानुनयन् वाचा प्रवृद्धानङ्गकश्मलाम्॥ ३/१५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.020.m4a", "display_order": 21}, {"id": 6000045021, "chapter_id": 10045, "verse_number": "३-१५-१६", "content_sanskrit": "एष तेऽहं विधास्यामि प्रियं भीरु यदिच्छसि।\nतस्याः कामं न कः कुर्यात् सिद्धिस्‍त्रैवर्गिकी यतः॥ ३/१५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.021.m4a", "display_order": 22}, {"id": 6000045022, "chapter_id": 10045, "verse_number": "३-१५-१७", "content_sanskrit": "सर्वाश्रमानुपादाय स्वाश्रमेण कलत्रवान्।\nव्यसनार्णवमत्येति जलयानैर्यथाऽर्णवम्॥ ३/१५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.022.m4a", "display_order": 23}, {"id": 6000045023, "chapter_id": 10045, "verse_number": "३-१५-१८", "content_sanskrit": "यामाहुरात्मनो ह्यर्धं श्रेयस्कामस्य भामिनि।\nयस्यां स्वधुरमध्यस्य पुमांश्चरति विज्वरः॥ ३/१५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.023.m4a", "display_order": 24}, {"id": 6000045024, "chapter_id": 10045, "verse_number": "३-१५-१९", "content_sanskrit": "यामाश्रित्येन्द्रियारातीन् दुर्जयानितराश्रमैः।\nवयं जयेम हेलाभिर्दस्यून् दुर्गपतिर्यथा॥ ३/१५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.024.m4a", "display_order": 25}, {"id": 6000045025, "chapter_id": 10045, "verse_number": "३-१५-२०", "content_sanskrit": "न वयं प्रभवस्तां त्वामनु कर्तुं गृहेश्वरि।\nअप्यायुषा वा कार्त्स्न्येन ये चान्ये गुणगृध्नवः॥ ३/१५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.025.m4a", "display_order": 26}, {"id": 6000045026, "chapter_id": 10045, "verse_number": "३-१५-२१", "content_sanskrit": "अथापि काममेनं ते प्रजायै करवाण्यलम्।\nयथा मां नातिवाचन्ति मुहूर्तं प्रतिपालय॥ ३/१५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.026.m4a", "display_order": 27}, {"id": 6000045027, "chapter_id": 10045, "verse_number": "३-१५-२२", "content_sanskrit": "एषा घोरतमा वेला घोराणां घोरदर्शना।\nचरन्ति यस्यां भूतानि भूतेशानुचराणि ह॥ ३/१५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.027.m4a", "display_order": 28}, {"id": 6000045028, "chapter_id": 10045, "verse_number": "३-१५-२३", "content_sanskrit": "एतस्यां साध्वि सन्ध्यायां भगवान् भूतभावनः।\nपरीतो भूतपार्षद्भिर्वृषेणाटति भूतराट्॥ ३/१५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.028.m4a", "display_order": 29}, {"id": 6000045029, "chapter_id": 10045, "verse_number": "३-१५-२४", "content_sanskrit": "श्मशानचक्रानिलधूलिधूम्रविकीर्णविद्योतजटाकलापः।\nभस्मावकुण्ठामलरुक्मदेहो देवस्‍त्रिभिः पश्यति देवरस्ते॥ ३/१५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.029.m4a", "display_order": 30}, {"id": 6000045030, "chapter_id": 10045, "verse_number": "३-१५-२५", "content_sanskrit": "न यस्य लोके स्वजनः परो वा नात्यादृतो नोत कश्चिद्विगर्ह्यः।\nवयं व्रतैर्यच्चरणापविद्धामाशास्महेऽजां बत भुक्तभोगाम्॥ ३/१५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.030.m4a", "display_order": 31}, {"id": 6000045031, "chapter_id": 10045, "verse_number": "३-१५-२६", "content_sanskrit": "यस्यानवद्याचरितं मनीषिणो गृह्णन्त्यविद्यापटलं बिभित्सवः।\nनिरस्तसाम्यातिशयोऽपि यः स्वयं पिशाचचर्यामचरत् सतां गतिः॥ ३/१५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.031.m4a", "display_order": 32}, {"id": 6000045032, "chapter_id": 10045, "verse_number": "३-१५-२७", "content_sanskrit": "हसन्ति यस्याचरितं हि दुर्भगाः स्वात्मन् रतस्याविदुषः समीहितम्।\nयैर्वस्‍त्रमाल्याभरणानुलेपनैः श्वभोजनं स्वात्मतयोपलालितम्॥ ३/१५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.032.m4a", "display_order": 33}, {"id": 6000045033, "chapter_id": 10045, "verse_number": "३-१५-२८", "content_sanskrit": "ब्रह्मादयो यत्कृतसेतुपाला यत्कारणं विश्वमिदं च मायया।\nआज्ञाकरी तस्य पिशाचचर्या अहो विभूम्नश्चरितं विडम्बनम्॥ ३/१५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.033.m4a", "display_order": 34}, {"id": 6000045034, "chapter_id": 10045, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.034.m4a", "display_order": 35}, {"id": 6000045035, "chapter_id": 10045, "verse_number": "३-१५-२९", "content_sanskrit": "एवं संवेदिता भर्त्रा मन्मथोन्मथितेन्द्रिया।\nजग्राह वासो ब्रह्मर्षेर्वृषलीव गतत्रपा॥ ३/१५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.035.m4a", "display_order": 36}, {"id": 6000045036, "chapter_id": 10045, "verse_number": "३-१५-३०", "content_sanskrit": "संविदित्वाऽथ भार्यायास्तन्निर्बन्धं विकर्मणि।\nनत्वा दिष्टाय रहसि तया चोपविवेश ह॥ ३/१५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.036.m4a", "display_order": 37}, {"id": 6000045037, "chapter_id": 10045, "verse_number": "३-१५-३१", "content_sanskrit": "अथोपस्पृश्य सलिलं प्राणानायम्य वाग्यतः।\nध्यायन् जजाप विरजं ब्रह्म ज्योतिः सनातनम्॥ ३/१५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.037.m4a", "display_order": 38}, {"id": 6000045038, "chapter_id": 10045, "verse_number": "३-१५-३२", "content_sanskrit": "दितिस्तु व्रीडिता तेन कर्मावद्येन भारत।\nउपसङ्गम्य विप्रर्षिमधोमुख्यभ्यभाषत॥ ३/१५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.038.m4a", "display_order": 39, "topics": [{"text": "दित्याः स्वदोषज्ञानम्, भगवदनुग्रहप्रार्थना कश्यपेन सान्‍त्वनं च", "range": "३२–५०"}]}, {"id": 6000045039, "chapter_id": 10045, "verse_number": null, "content_sanskrit": "दितिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.039.m4a", "display_order": 40}, {"id": 6000045040, "chapter_id": 10045, "verse_number": "३-१५-३३", "content_sanskrit": "न मे गर्भमिमं ब्रह्मन् भूतानामृषभोऽवधीत्।\nरुद्रः पतिर्हि भूतानां यस्याकरवमंहसम्॥ ३/१५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.040.m4a", "display_order": 41}, {"id": 6000045041, "chapter_id": 10045, "verse_number": "३-१५-३४", "content_sanskrit": "नमो रुद्राय महते देवायोग्राय मीढुषे।\nशिवाय न्यस्तदण्डाय धृतदण्डाय मन्यवे॥ ३/१५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.041.m4a", "display_order": 42}, {"id": 6000045042, "chapter_id": 10045, "verse_number": "३-१५-३५", "content_sanskrit": "स नः प्रसीदताद् भीमो भगवानुर्वनुग्रहः।\nव्याधस्याप्यनुकम्प्यानां स्‍त्रीणां देवः सतीपतिः॥ ३/१५/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.042.m4a", "display_order": 43}, {"id": 6000045043, "chapter_id": 10045, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.043.m4a", "display_order": 44}, {"id": 6000045044, "chapter_id": 10045, "verse_number": "३-१५-३६", "content_sanskrit": "स्वगर्भस्याशिषं लोक्यामाशासानां प्रवेपतीम्।\nनिवृत्तसन्ध्यानियमो भार्यामाह प्रजापतिः॥ ३/१५/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.044.m4a", "display_order": 45}, {"id": 6000045045, "chapter_id": 10045, "verse_number": null, "content_sanskrit": "कश्यप उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.045.m4a", "display_order": 46}, {"id": 6000045046, "chapter_id": 10045, "verse_number": "३-१५-३७", "content_sanskrit": "अप्रायत्यादात्मनस्ते दोषान्मौहूर्तिकादुत।\nमन्निर्देशातिचारेण देवानां चैव हेलनात्॥ ३/१५/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.046.m4a", "display_order": 47}, {"id": 6000045047, "chapter_id": 10045, "verse_number": "३-१५-३८", "content_sanskrit": "भविष्यतस्तवाभद्रावभद्रे जाठराधमौ।\nलोकान् सपालांस्‍त्रींश्चण्डि मुहुराक्रन्दयिष्यतः॥ ३/१५/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.047.m4a", "display_order": 48}, {"id": 6000045048, "chapter_id": 10045, "verse_number": "३-१५-३९", "content_sanskrit": "प्राणिनां हन्यमानानां दीनानामकृतागसाम्।\nस्‍त्रीणां निगृह्यमाणानां कोपितेषु महात्मसु॥ ३/१५/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.048.m4a", "display_order": 49}, {"id": 6000045049, "chapter_id": 10045, "verse_number": "३-१५-४०", "content_sanskrit": "तदा विश्वेश्वरः क्रुद्धो भगवान् लोकभावनः।\nहनिष्यत्यवतीर्यासौ यथाद्रींश्छतपर्वधृक्॥ ३/१५/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.049.m4a", "display_order": 50}, {"id": 6000045050, "chapter_id": 10045, "verse_number": null, "content_sanskrit": "दितिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.050.m4a", "display_order": 51}, {"id": 6000045051, "chapter_id": 10045, "verse_number": "३-१५-४१", "content_sanskrit": "वधं भगवता साक्षात् सुनाभोदारबाहुना।\nआशासे पुत्रयोर्मह्यं मा क्रुद्धाद् ब्राह्मणात् प्रभो॥ ३/१५/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.051.m4a", "display_order": 52}, {"id": 6000045052, "chapter_id": 10045, "verse_number": "३-१५-४२", "content_sanskrit": "न ब्रह्मदण्डदग्धस्य न भूतभयदस्य च।\nनारक्यश्चानुगृह्णन्ति यां यां योनिमसौ गतः॥ ३/१५/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.052.m4a", "display_order": 53}, {"id": 6000045053, "chapter_id": 10045, "verse_number": null, "content_sanskrit": "कश्यप उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.053.m4a", "display_order": 54}, {"id": 6000045054, "chapter_id": 10045, "verse_number": "३-१५-४३", "content_sanskrit": "कृतशोकानुतापेन सद्यः प्रत्यवमर्शनात्।\nभगवत्युरुमानाच्च भवे मय्यपि चादरात्॥ ३/१५/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.054.m4a", "display_order": 55}, {"id": 6000045055, "chapter_id": 10045, "verse_number": "३-१५-४४", "content_sanskrit": "पुत्रस्यैव च पुत्राणां भवितैकः सतां मतः।\nगायन्ति यद् यशः शुद्धं भगवद्यशसा समम्॥ ३/१५/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.055.m4a", "display_order": 56}, {"id": 6000045056, "chapter_id": 10045, "verse_number": "३-१५-४५", "content_sanskrit": "योगैर्हेमेव दुर्वर्णं भावयिष्यन्ति साधवः।\nनिर्वैरादिभिरात्मानं यच्छीलमनुवर्तितुम्॥ ३/१५/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.056.m4a", "display_order": 57}, {"id": 6000045057, "chapter_id": 10045, "verse_number": "३-१५-४६", "content_sanskrit": "यत्प्रसादादिदं विश्वं प्रसीदति यदात्मकम्।\nशश्वद्दृक् भगवान् यस्य तोष्यतेऽनन्यया दृशा॥ ३/१५/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.057.m4a", "display_order": 58}, {"id": 6000045058, "chapter_id": 10045, "verse_number": "३-१५-४७", "content_sanskrit": "स वै महाभागवतो महात्मा महानुभावो महतां महिष्ठः।\nप्रवृद्धभक्त्या ह्यनुभाविताशये निवेश्य वैकुण्ठमतद् विहास्यति॥ ३/१५/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.058.m4a", "display_order": 59}, {"id": 6000045059, "chapter_id": 10045, "verse_number": "३-१५-४८", "content_sanskrit": "अलम्पटः शीलधरो गुणाकरो हृष्टः परार्थे व्यथितेषु दुःखितः।\nअभूतशत्रुर्जगतः शोकहर्ता नैदाघिकं तापमिवोडुराजः॥ ३/१५/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.059.m4a", "display_order": 60}, {"id": 6000045060, "chapter_id": 10045, "verse_number": "३-१५-४९", "content_sanskrit": "अन्तर्बहिश्चानिलवच्चरन्तं स्वपूरुषेच्छानुगृहीतरूपम्।\nपौत्रस्तव श्रीललनाललामं द्रष्टा स्फुरत्कुण्डलमण्डिताननम्॥ ३/१५/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.060.m4a", "display_order": 61}, {"id": 6000045061, "chapter_id": 10045, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.061.m4a", "display_order": 62}, {"id": 6000045062, "chapter_id": 10045, "verse_number": "३-१५-५०", "content_sanskrit": "श्रुत्वा भागवतं पौत्रममोदत दितिर्भृशम्।\nपुत्रयोश्च वधं कृष्णाद् विदित्वाऽऽसीन्महामनाः॥ ३/१५/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_015/BhP_03.015.062.m4a", "display_order": 63}, {"id": 6000045063, "chapter_id": 10045, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे पञ्चदशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]