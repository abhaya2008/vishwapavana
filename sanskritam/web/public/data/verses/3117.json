[{"id": 2098947, "chapter_id": 3117, "verse_number": "१३-२४७-१", "content_sanskrit": "उमोवाच।\nत्रियक्ष त्रिदशश्रेष्ठ त्र्यम्बक त्रिदशाधिप।\nत्रिपुरान्तक कामाङ्गहर त्रिपथगाधर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2098948, "chapter_id": 3117, "verse_number": "१३-२४७-२", "content_sanskrit": "दक्षयज्ञप्रशमन सूलपाणेऽरिसूदन।\nनमस्ते लोकपालेश लोकपालवरप्रद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2098949, "chapter_id": 3117, "verse_number": "१३-२४७-३", "content_sanskrit": "नैकशाखमपर्यन्तमध्यात्मज्ञानमुत्तमम्।\nअप्रतर्क्यमविज्ञेयं साङ्ख्ययोगसमन्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2098950, "chapter_id": 3117, "verse_number": "१३-२४७-४", "content_sanskrit": "भवता परिपृष्टेन शृण्वन्त्या मम भाषितम्।\nइदानीं श्रोतुमिच्छामि सायुज्यं त्वद्गतं विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2098951, "chapter_id": 3117, "verse_number": "१३-२४७-५", "content_sanskrit": "कथं परिचरन्त्येते भक्तास्त्वां परमेष्ठिनम्।\nआचारः कीदृशस्तेषां केन तुष्टो भवेद्भवान्।\nवर्ण्यमानं त्वया साक्षात्प्रीणयत्यधिकं हि मा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2098952, "chapter_id": 3117, "verse_number": "१३-२४७-६x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2098953, "chapter_id": 3117, "verse_number": "१३-२४७-६", "content_sanskrit": "हन्त ते कथयिष्यामि मम सायुज्यमद्भुतम्।\nयेन ते न निवर्तन्ते युक्ताः परमयोगिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2098954, "chapter_id": 3117, "verse_number": "१३-२४७-७", "content_sanskrit": "अव्यक्तोऽहमचिन्त्योऽहं पूर्वैरपि मुमुक्षुभिः।\nसाङ्ख्ययोगौ मया सृष्टौ सर्वं चापि चराचरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2098955, "chapter_id": 3117, "verse_number": "१३-२४७-८", "content_sanskrit": "अर्चनीयोऽहमीशोऽहमव्ययोऽहं सनातनः।\nअहं प्रसन्नो भक्तानां ददाम्यमरतामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2098956, "chapter_id": 3117, "verse_number": "१३-२४७-९", "content_sanskrit": "न मां विदुः सुरगणा मुनयश्च तपोधनाः।\nत्वत्प्रियार्थमहं देवि मद्विभूतिं ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2098957, "chapter_id": 3117, "verse_number": "१३-२४७-१०", "content_sanskrit": "आश्रमेभ्यश्चतुर्भ्योऽहं चतुरो ब्राह्मणाञ्शुभे।\nमद्भक्तान्निर्मलान्पुण्यान्समानीय तपस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2098958, "chapter_id": 3117, "verse_number": "१३-२४७-११", "content_sanskrit": "व्याचख्येऽहं तथा देवि योगं पाशुपतं महत्।\nगृहीतं तच्च तैः सर्वं मुखाच्च मम दक्षिणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2098959, "chapter_id": 3117, "verse_number": "१३-२४७-१२", "content_sanskrit": "श्रुत्वा तत्त्रिषु लोकेषु स्थापितं चापि तैः पुनः।\nइदानीं च त्वया पृष्टो वदाम्येकमनाः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2098960, "chapter_id": 3117, "verse_number": "१३-२४७-१३", "content_sanskrit": "अहं पसुपतिर्नाम मद्भक्ता ये च मानवाः।\nसर्वे पाशुपता ज्ञेया भस्मदिग्धतनूरुहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2098961, "chapter_id": 3117, "verse_number": "१३-२४७-१४", "content_sanskrit": "रक्षार्थं मङ्गलार्थं न पवित्रार्थं च भामिनि।\nलिङ्गार्थं चैव भक्तानां भस्म दत्तं मया पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2098962, "chapter_id": 3117, "verse_number": "१३-२४७-१५", "content_sanskrit": "तेन संदिग्धसर्वाङ्गा भस्मना ब्रह्मचारिणः।\nजटिला मुण्डिता वाऽपि नानाकारशिखण्डिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2098963, "chapter_id": 3117, "verse_number": "१३-२४७-१६", "content_sanskrit": "विकृताः पिङ्गलाभिस्च नग्ना नानाप्रकारिणः।\nभैक्षं चरन्तः सर्वत्र निःस्पृहा निष्परिग्रहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2098964, "chapter_id": 3117, "verse_number": "१३-२४७-१७", "content_sanskrit": "मृत्पात्रहस्ता मद्भक्ता मन्निवेशितबुद्ध्यः।\nचरन्तो निखिलं लोकं मम हर्षविवर्धनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2098965, "chapter_id": 3117, "verse_number": "१३-२४७-१८", "content_sanskrit": "मम पाशुपतं दिव्यं योगशास्त्रमनुत्तमम्।\nसूक्ष्मं सर्वेषु लोकेषु विमृशन्तश्चरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2098966, "chapter_id": 3117, "verse_number": "१३-२४७-१९", "content_sanskrit": "एवं नित्याभियुक्तानां मद्भक्तानां तपस्विनाम्।\nउपायं चिन्तयाम्याशु येन मामुपयान्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2098967, "chapter_id": 3117, "verse_number": "१३-२४७-२०", "content_sanskrit": "स्थापितं त्रिषु लोकेषु शिवलिङ्गं मया मम।\nनमस्कारेण वा तस्य मुच्यन्ते सर्वकिल्बिषैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2098968, "chapter_id": 3117, "verse_number": "१३-२४७-२१", "content_sanskrit": "इष्टं दत्तमधीतं च यज्ञाश्च बहुदक्षिणाः।\nशिवलिङ्गप्रणामस्य कलां नार्हन्ति षोडशीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2098969, "chapter_id": 3117, "verse_number": "१३-२४७-२२", "content_sanskrit": "अर्चया शिवलिङ्गस्य परितुष्याम्यहं प्रिये।\nशिवलिङ्गार्चनायां तु विदानमपि मे शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2098970, "chapter_id": 3117, "verse_number": "१३-२४७-२३", "content_sanskrit": "गोक्षीरनवनीताभ्यामर्चयेद्यः शिवं मम।\nइष्टस्य हयमेधस्य यत्फलं तत्फलं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2098971, "chapter_id": 3117, "verse_number": "१३-२४७-२४", "content_sanskrit": "घृतमण्डेन यो नित्यमर्चयेद्यः शिवं मम।\nस फलं प्राप्नुयान्मर्त्यो ब्राह्मणस्याग्निहोत्रिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2098972, "chapter_id": 3117, "verse_number": "१३-२४७-२५", "content_sanskrit": "केवलेनापि तोयेन स्नापयेद्यः शिवं मम।\nस चापि लभते पुण्यं प्रियं च लभते नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2098973, "chapter_id": 3117, "verse_number": "१३-२४७-२६", "content_sanskrit": "सघृतं गुग्गुलु सम्यग्धूपयेद्यः शिवान्तिके।\nगोसवस्य तु यज्ञस्य यत्फलं तस्य तद्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2098974, "chapter_id": 3117, "verse_number": "१३-२४७-२७", "content_sanskrit": "यस्तु गुग्गुलपिण्डेन केवलेनापि धूपयेत्।\nतस्य रुक्मप्रधानस्य यत्फलं तस्य तद्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2098975, "chapter_id": 3117, "verse_number": "१३-२४७-२८", "content_sanskrit": "यस्तु नानाविधैः पुष्पैर्मम लिङ्गं समर्चयेत्।\nस हि धेनुसहस्रस्य दत्तस्य फलमाप्नुयात्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2098976, "chapter_id": 3117, "verse_number": "१३-२४७-२९", "content_sanskrit": "यस्तु देशान्तरं गत्वा शिवलिङ्गं समर्चयेत्।\nतस्मात्सर्वमनुष्येषु नास्ति मे प्रियकृत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2098977, "chapter_id": 3117, "verse_number": "१३-२४७-३०", "content_sanskrit": "एवं नानाविधैर्द्रव्यैः शिवलिङ्गं समर्चयेत्।\nमत्समानो मनुष्येषु न पुनर्जायते नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2098978, "chapter_id": 3117, "verse_number": "१३-२४७-३१", "content_sanskrit": "अर्चनाभिर्नमस्कारैरुपहारैः स्तवैरपि।\nभक्तो मामर्चयेन्नित्यं शिवलिङ्गेष्वतन्द्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2098979, "chapter_id": 3117, "verse_number": "१३-२४७-३२", "content_sanskrit": "पलाशबिल्वपत्राणि राजवृक्षस्रजं तथा।\nअर्कपुष्पाणि मेध्यानि मत्प्रियाणि विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2098980, "chapter_id": 3117, "verse_number": "१३-२४७-३३", "content_sanskrit": "फलं वा यदि वा शाकं पुष्पं वा यदि वा जलम्।\nदत्तं सम्प्रीणयेद्देवि भक्तैर्मद्गतमानसैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2098981, "chapter_id": 3117, "verse_number": "१३-२४७-३४", "content_sanskrit": "ममाभिपरितुष्टस्य नास्ति लोकेषु दुर्लभम्।\nतस्मात्ते सततं भक्ता मामेवाभ्यर्चयन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2098982, "chapter_id": 3117, "verse_number": "१३-२४७-३५", "content_sanskrit": "मद्भक्ता न विनश्यन्ति मद्भक्ता वीतकल्मषाः।\nमद्भक्ताः सर्वलोकेषु पूजनीया विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2098983, "chapter_id": 3117, "verse_number": "१३-२४७-३६", "content_sanskrit": "मद्द्वेषिणश्चि ये मर्त्या मद्भक्तद्वेषिणश्च वा।\nयान्ति ते नरकं घोरमिष्ट्वा क्रतुशतैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2098984, "chapter_id": 3117, "verse_number": "१३-२४७-३७", "content_sanskrit": "एतत्ते सर्वमाख्यातं योगं पाशुपतं महत्।\nमद्भक्तैर्मनुजैर्देवि श्राव्यमेतद्दिनेदिने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2098985, "chapter_id": 3117, "verse_number": "१३-२४७-३८", "content_sanskrit": "शृणुयाद्यः पठेद्वाऽपि ममेदं धर्मनिश्चयम्।\nस्वर्गं कीर्तिं धनं धान्यं स लभेत नरोत्तमः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2098986, "chapter_id": 3117, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि सप्तचत्वारिंशदधिकद्विशततमोऽध्यायः॥ २४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]