[{"id": 2142078, "chapter_id": 4062, "verse_number": "", "content_sanskrit": "जनमेयजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2142079, "chapter_id": 4062, "verse_number": "१", "content_sanskrit": "सभाज्यमानः पौरैश्च स्त्रीभिर्जानपदैरपि ।\nआसाद्यान्तःपुरद्वारं पित्रे सम्प्रत्यहारयत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2142080, "chapter_id": 4062, "verse_number": "२", "content_sanskrit": "ततो द्वाःस्थः समागम्य प्रणिपत्य कृताञ्जलिः ।\nवर्धयित्वा जयाशीर्भिरिदं वचनमब्रवीत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2142081, "chapter_id": 4062, "verse_number": "३", "content_sanskrit": "राजन् पृथुयशाः पुत्रो जित्वा शत्रून् समागतः ।\nउत्तरः सह सूतेन द्वारि तिष्ठति वारितः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2142082, "chapter_id": 4062, "verse_number": "४", "content_sanskrit": "कुमारैर्योधमुख्यैश्च गणिकाभिश्च संवृतः ।\nपौरजानपदैर्युक्तः पूज्यमानो जयाशिषा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2142083, "chapter_id": 4062, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2142084, "chapter_id": 4062, "verse_number": "५", "content_sanskrit": "ततो हृष्टो महीपालः क्षत्रारमिदमब्रवीत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2142085, "chapter_id": 4062, "verse_number": "६", "content_sanskrit": "प्रवेशयोभौ तूर्णं तौ दर्शनेप्सुरहं तयोः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2142086, "chapter_id": 4062, "verse_number": "७", "content_sanskrit": "क्षत्तारं कुरुराजस्तु शनैः कर्ण उवाच ह\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2142087, "chapter_id": 4062, "verse_number": "८", "content_sanskrit": "उत्तरः प्रविशत्वेको न प्रवेश्या बृहन्नळा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2142088, "chapter_id": 4062, "verse_number": "९", "content_sanskrit": "एतस्य हि महाबाहोर्व्रतं नित्यं महात्मनः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2142089, "chapter_id": 4062, "verse_number": "१०", "content_sanskrit": "यो ममाङ्गे व्रणं कुर्यात् शोणितं वा प्रदर्शयेत् ।\nअन्यत्र सङ्ग्रामगतान्न स जीवेत् कथञ्चन\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2142090, "chapter_id": 4062, "verse_number": "११", "content_sanskrit": "व्यक्तं भृशं सुसङ्क्रुद्धो मां दृष्ट्वैव सशोणितम् ।\nविराटं हि सहामात्यं हन्यात् सबलवाहनम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2142091, "chapter_id": 4062, "verse_number": "१२", "content_sanskrit": "इन्द्रं वाऽपि कुबेरं वा यमं वा वरुणं तथा ।\nमम शोणितकर्तारं मृद्नीयात् किं पुनर्नरम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2142092, "chapter_id": 4062, "verse_number": "१३", "content_sanskrit": "क्षणमात्रं स तत्रैव द्वारि तिष्ठतु वीर्यवान्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2142093, "chapter_id": 4062, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2142094, "chapter_id": 4062, "verse_number": "समाप्तिः", "content_sanskrit": "इति प्रोवाच धर्मात्मा युधिष्ठिर उदारधीः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2142095, "chapter_id": 4062, "verse_number": "१५", "content_sanskrit": "इत्युक्त्वा क्षमया युक्तो धर्मराजो युधिष्ठिरः ।\nसभायां सह मात्स्येन तूष्णीमुपविवेश ह\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2142096, "chapter_id": 4062, "verse_number": "१६", "content_sanskrit": "ततो राजसुतो ज्येष्ठः प्राविशत् पृथिवीञ्जयः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2142097, "chapter_id": 4062, "verse_number": "१७", "content_sanskrit": "सोऽभिवाद्य पितुः पादौ धर्मराजस्य पश्यतः ।\nततो रुधिरासिक्ताङ्गं धर्मराजमपश्यत\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2142098, "chapter_id": 4062, "verse_number": "१८", "content_sanskrit": "भूमावेकान्त आसीनं सैरन्ध्र्या समुपस्थितम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2142099, "chapter_id": 4062, "verse_number": "१९", "content_sanskrit": "ततः पप्रच्छ राजानं त्वरमाण इवोत्तरः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2142100, "chapter_id": 4062, "verse_number": "२०", "content_sanskrit": "केनायं ताडितो विप्रः केन पापमिदं कृतम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2142101, "chapter_id": 4062, "verse_number": "२१", "content_sanskrit": "श्रोत्रियो ब्राह्मणश्रेष्ठ इन्द्राभिनवलक्षणः ।\nपूजनीयोऽभिवाद्यश्च न प्रवध्योऽयमीदृशः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2142102, "chapter_id": 4062, "verse_number": "", "content_sanskrit": "विराटः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2142103, "chapter_id": 4062, "verse_number": "२२", "content_sanskrit": "मयाऽयं ताडितो जिह्मो न चाप्येतावदर्हति ।\nमया प्रशस्यमानेऽपि त्वयि षण्डं प्रशंसति\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2142104, "chapter_id": 4062, "verse_number": "२३", "content_sanskrit": "ताडितोऽयं मया पुत्र दुरात्मा शत्रुकर्शन ।\nबृहन्नळाप्रशंसाभिरसूया मे महत्तमा\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2142105, "chapter_id": 4062, "verse_number": "", "content_sanskrit": "उत्तरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2142106, "chapter_id": 4062, "verse_number": "२४", "content_sanskrit": "अकार्यं ते कृतं राजन् क्षिप्रमेष प्रसाद्यताम् ।\nमा त्वां ब्रह्मद्विषं घोरं समूलमुपनिर्दहेत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2142107, "chapter_id": 4062, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2142108, "chapter_id": 4062, "verse_number": "२५", "content_sanskrit": "पुत्रस्य वचनं श्रुत्वा विराटो राष्ट्रवर्धनः ।\nक्षमयामास कौन्तेयं छन्नं ब्राह्मणवर्चसा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2142109, "chapter_id": 4062, "verse_number": "२६", "content_sanskrit": "क्षमयन्तं तु राजानं पाण्डवः प्रत्यभाषत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2142110, "chapter_id": 4062, "verse_number": "२७", "content_sanskrit": "चिरं क्षान्तं मया राजन् मन्युर्मम न विद्यते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2142111, "chapter_id": 4062, "verse_number": "२८", "content_sanskrit": "यदि स्म तत् पतेद् भूमौ रुधिरं मम पार्थिव ।\nसराष्ट्रस्त्वमिहोच्छेदमापद्येथा नरर्षभ\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2142112, "chapter_id": 4062, "verse_number": "२९", "content_sanskrit": "न दूषयामि राजेन्द्र यस्तु हन्याददूषकम् ।\nफलं तस्य महाराज क्षिप्रं दारुणमाप्नुयात्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2142113, "chapter_id": 4062, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2142114, "chapter_id": 4062, "verse_number": "३०", "content_sanskrit": "शोणिते तु व्यतिक्रान्ते प्रविवेश बृहन्नळा ।\nअभिवाद्य महाराजं कङ्कं चाप्युपतिष्ठत\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2142115, "chapter_id": 4062, "verse_number": "३१", "content_sanskrit": "क्षमयित्वा तु कौरव्यं रणादुत्तरमागतम् ।\nपरिष्वज्य दृढं राजा प्रवेश्य भवनोत्तमम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2142116, "chapter_id": 4062, "verse_number": "३२", "content_sanskrit": "प्रशशंस ततो मात्स्यः शृण्वतः सव्यसाचिनः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2142117, "chapter_id": 4062, "verse_number": "", "content_sanskrit": "विराटः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2142118, "chapter_id": 4062, "verse_number": "३३", "content_sanskrit": "त्वया दायादवानस्मि कैकेय्यानन्दवर्धन ।\nत्वया मे सदृशः पुत्रो न भूतो न भविष्यति\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2142119, "chapter_id": 4062, "verse_number": "३४", "content_sanskrit": "पदं पदसहस्रेण यश्चरन्नापराध्नुयात्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2142120, "chapter_id": 4062, "verse_number": "३५", "content_sanskrit": "शूरश्च लघुहस्तश्च कर्णो लघुपराक्रमः ।\nतेन कर्णेन ते तात कथमासीत् समागमः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2142121, "chapter_id": 4062, "verse_number": "३६", "content_sanskrit": "पर्वतं यो विभिन्द्यात् तु राजपुत्रो वरेषुभिः ।\nदुर्योधनेन ते तात कथमासीत् समागमः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2142122, "chapter_id": 4062, "verse_number": "३७", "content_sanskrit": "आचार्यो वृष्णिवीराणां पाञ्चालानां च यः प्रभुः ।\nसर्वक्षत्रस्य चाचार्यः सर्वशस्त्रभृतां वरः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2142123, "chapter_id": 4062, "verse_number": "३८", "content_sanskrit": "तेन द्रोणेन ते तात कथमासीत् समागमः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2142124, "chapter_id": 4062, "verse_number": "३९", "content_sanskrit": "रणे यं प्रेक्ष्य सीदन्ति हतवीर्यपराक्रमाः ।\nकृपेण तेन ते तात कथमासीत् समागमः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2142125, "chapter_id": 4062, "verse_number": "४०", "content_sanskrit": "यस्य तद्विश्रुतं लोके ब्रह्मचर्यं सुदुष्करम् ।\nपितुः कृते कृतं घोरं महद्व्रतमनुत्तमम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2142126, "chapter_id": 4062, "verse_number": "४१", "content_sanskrit": "येन युद्धं कृतं पूर्वं जामदग्न्येन वै सह ।\nभीष्मेण पुरुषव्याघ्र न च युद्धे पराजितः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2142127, "chapter_id": 4062, "verse_number": "४२", "content_sanskrit": "पराक्रमी च दुर्धर्षो विद्वान् शूरो जितेन्द्रियः ।\nक्षिप्रकारी दृढावेधी विश्रुतः सर्वकर्मसु\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2142128, "chapter_id": 4062, "verse_number": "४३", "content_sanskrit": "तेन ते सह भीष्मेण कुरुवृद्धेन संयुगे ।\nयुद्धमासीत् कथं तेन सर्वमेतद् ब्रवीहि मे\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2142129, "chapter_id": 4062, "verse_number": "४४", "content_sanskrit": "आचार्यपुत्रो यः शूरः सर्वशस्त्रभृतां वरः ।\nतेन वीरेण ते तात कथमासीत् समागमः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2142130, "chapter_id": 4062, "verse_number": "४५", "content_sanskrit": "सर्वे चैव महावीर्या धार्तराष्ट्रा महाबलाः ।\nतैश्च वीरैश्च ते तात कथमासीत् समागमः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2142131, "chapter_id": 4062, "verse_number": "", "content_sanskrit": "उत्तरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2142132, "chapter_id": 4062, "verse_number": "४६", "content_sanskrit": "न मया निर्जिता गावो न मया कुरवो जिताः ।\nकृतं च कर्म तत् सर्वं देवपुत्रेण केनचित्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2142133, "chapter_id": 4062, "verse_number": "४७", "content_sanskrit": "स हि भीत्या द्रवन्तं मां भीष्मद्रोणमुखान् कुरून् ।\nदृष्ट्वा विषण्णं सङ्ग्रामे देवपुत्रो न्यवारयत्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2142134, "chapter_id": 4062, "verse_number": "४८", "content_sanskrit": "स ह्यतिष्ठद् रथोपस्थे वज्रहस्तनिभो युवा ।\nतेन ता निर्जिता गावः कुरवस्तेन निर्जिताः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2142135, "chapter_id": 4062, "verse_number": "४९", "content_sanskrit": "तस्य तत् कर्म वीरस्य न मया तात तत् कृतम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2142136, "chapter_id": 4062, "verse_number": "५०", "content_sanskrit": "स हि शारद्वतं द्रोणं द्रोणपुत्रं च वीर्यवान् ।\nसूतपुत्रं च भीष्मं च चकार विमुखान् शरैः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2142137, "chapter_id": 4062, "verse_number": "५१", "content_sanskrit": "दुर्योधनं च समरे प्रभिन्नमिव कुञ्जरम् ।\nप्रभग्नमब्रवीद् भीतं राजपुत्रं महाबलम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2142138, "chapter_id": 4062, "verse_number": "", "content_sanskrit": "देवपुत्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2142139, "chapter_id": 4062, "verse_number": "५२", "content_sanskrit": "न हस्तिनपुरे त्राणं तव पश्यामि किञ्चन ।\nव्यायामेन परीप्सस्व जीवितं कौरवात्मज\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2142140, "chapter_id": 4062, "verse_number": "५३", "content_sanskrit": "न हस्तिनपुरे शक्या भोक्तुं भोगाः पलायता ।\nन मोक्ष्यसे पलायंस्त्वं राजन् युद्धमना भव\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2142141, "chapter_id": 4062, "verse_number": "५४", "content_sanskrit": "पृथिवीं भोक्ष्यसे जित्वा हतो वा स्वर्गमाप्स्यसि\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2142142, "chapter_id": 4062, "verse_number": "", "content_sanskrit": "उत्तरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2142143, "chapter_id": 4062, "verse_number": "५५", "content_sanskrit": "स निवृत्तो नरव्याघ्रो मुञ्चन् वज्रनिभान् शरान् ।\nसचिवैः संवृतो राजा भीष्मद्रोणकृपादिभिः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2142144, "chapter_id": 4062, "verse_number": "५६", "content_sanskrit": "तं दृष्ट्वा रोमहर्षोऽभूद् दूरात् स्तम्भश्च मेऽभवत् ।\nयदभ्रघनसङ्काशमनीकं व्यधमच्छरैः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2142145, "chapter_id": 4062, "verse_number": "५७", "content_sanskrit": "तत् प्रणुद्य रथानीकं सिंहर्षभसमो युवा ।\nतान् कुरून् द्रावयद् राजन् रणे नाग इव श्वसन्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2142146, "chapter_id": 4062, "verse_number": "५८", "content_sanskrit": "एकेन तेन शूरेण षड्रथाः परिनिर्जिताः ।\nशार्दूलेनेव मत्तेन मृगास्तृणचरा यथा\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2142147, "chapter_id": 4062, "verse_number": "५९", "content_sanskrit": "हयानां च गजानां च शूराणां च धनुष्मताम् ।\nनिहतानि सहस्राणि भग्ना च कुरुवाहिनी\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2142148, "chapter_id": 4062, "verse_number": "६०", "content_sanskrit": "सूतपुत्रं शरैर्विद्ध्वा हयान् हत्वा महारथः ।\nदेवपुत्रसमः सङ्खे रक्तं वस्त्रं समाददे\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2142149, "chapter_id": 4062, "verse_number": "६१", "content_sanskrit": "चतुर्भिः पुनरानर्च्छद् भीष्मं शान्तनवं रणे ।\nस तं विद्ध्वा हयांस्तस्य नास्य वस्त्रं समाददे\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2142150, "chapter_id": 4062, "verse_number": "६२", "content_sanskrit": "दुर्योधनं च बलवान् बाणैर्विव्याध सप्तभिः ।\nतं स विद्ध्वा हयांश्चास्य शुक्लवस्त्रमथाददे\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2142151, "chapter_id": 4062, "verse_number": "६३", "content_sanskrit": "द्रोणं कृपं च बलवान् सोमदत्तं जयद्रथम् ।\nभूरिश्रवसमिन्द्राभं शकुनिं च महारथम्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2142152, "chapter_id": 4062, "verse_number": "६४", "content_sanskrit": "त्रिभिस्त्रिभिः शरैर्विद्ध्वा दुःशासनमुखानपि ।\nविविधानि च वस्त्राणि महार्हाण्याजहार सः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2142153, "chapter_id": 4062, "verse_number": "६५", "content_sanskrit": "द्वाभ्यां शराभ्यां विद्ध्वा तु तथाऽऽचार्यसुतं रणे ।\nचापं छित्त्वा विकर्णस्य नीले चादत्त वाससी\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2142154, "chapter_id": 4062, "verse_number": "", "content_sanskrit": "विराटः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2142155, "chapter_id": 4062, "verse_number": "६६", "content_sanskrit": "क्व स वीरो महाबाहुर्देवपुत्रो महायशाः ।\nयो ममामोचयत् पुत्रं कुरुभिर्ग्रस्तमाहवे\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2142156, "chapter_id": 4062, "verse_number": "६७", "content_sanskrit": "इच्छामि तममित्रघ्नं द्रष्टुमर्चितुमेव च ।\nयेन हि त्वं च गावश्च मोचिता देवसूनुना\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2142157, "chapter_id": 4062, "verse_number": "६८", "content_sanskrit": "तस्मै दास्यामि तां पुत्रीं शुभ्रवस्त्रां सुहाटकाम् ।\nस्फुरितं कटिसूत्रं च स्त्रीसहस्रशतानि च\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2142158, "chapter_id": 4062, "verse_number": "", "content_sanskrit": "उत्तरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2142159, "chapter_id": 4062, "verse_number": "६९", "content_sanskrit": "अन्तर्धाय गतस्तात देवपुत्रः प्रतापवान् ।\nअद्य श्वो वा परश्वो वा मन्ये प्रादुर्भविष्यति\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2142160, "chapter_id": 4062, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2142161, "chapter_id": 4062, "verse_number": "७०", "content_sanskrit": "एवमाख्यायमानस्तु छन्नं वस्त्रेण पाण्डवम् ।\nवसन्तं तत्र नाज्ञासीद् विराटः पार्थमर्जुनम्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2142162, "chapter_id": 4062, "verse_number": "७१", "content_sanskrit": "ततः पार्थोऽभ्यनुज्ञातो विराटेन महात्मना ।\nसह पुत्रेण मात्स्यस्य मन्त्रयित्वा धनञ्जयः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2142163, "chapter_id": 4062, "verse_number": "७२", "content_sanskrit": "इत्येवं ब्रूहि राजानं विराटं च युधिष्ठिरम्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2142164, "chapter_id": 4062, "verse_number": "७३", "content_sanskrit": "इत्युक्त्वा सहसा पार्थः प्रविश्यान्तःपुरं शुभम् ।\nददौ रत्नानि वस्त्राणि विराटदुहितुः स्वयम्\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2142165, "chapter_id": 4062, "verse_number": "७४", "content_sanskrit": "उत्तरा तु महार्हाणि वस्त्राण्याभरणानि च ।\nप्रगृह्य तानि सर्वाणि प्रीता सानुचराऽभवत्\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2142166, "chapter_id": 4062, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि सप्ततितमोऽध्यायः ॥७०॥\nगोग्रहणपर्वणि त्रिचत्वारिंशोऽध्यायः ॥४३॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}]