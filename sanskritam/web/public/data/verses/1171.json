[{"id": 2008831, "chapter_id": 1171, "verse_number": "१-१७२-०x", "content_sanskrit": "ब्राह्मण्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2008832, "chapter_id": 1171, "verse_number": "१-१७२-१", "content_sanskrit": "न सन्तापस्त्वया कार्यः प्राकृतेनेव कर्हिचित्।\nन हि सन्तापकालोऽयं वैद्यस्य तव विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2008833, "chapter_id": 1171, "verse_number": "१-१७२-२", "content_sanskrit": "अवश्यं निधनं सर्वैर्गन्तव्यमिह मानवैः।\nअवश्यभाविन्यर्थे वै संतापो नेह विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2008834, "chapter_id": 1171, "verse_number": "१-१७२-३", "content_sanskrit": "भार्या पुत्रोऽथ दुहिता सर्वमात्मार्थमिष्यते।\nव्यथां जहि सुबुद्ध्या त्वं स्वयं यास्यामि तत्र च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2008835, "chapter_id": 1171, "verse_number": "१-१७२-४", "content_sanskrit": "एतद्धि परमं नार्याः कार्यं लोके सनातनम्।\nप्राणानपि परित्यज्य यद्भर्तुर्हितमाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2008836, "chapter_id": 1171, "verse_number": "१-१७२-५", "content_sanskrit": "तच्च तत्र कृतं कर्म तवापीदं सुखावहम्।\nभवत्यमुत्र चाक्षय्यं लोकेऽस्मिंश्च यशस्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2008837, "chapter_id": 1171, "verse_number": "१-१७२-६", "content_sanskrit": "एष चैव गुरुर्धर्मो यं प्रवक्ष्याम्यहं तव।\nअर्थश्च तव धर्मश्च भूयानत्र प्रदृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2008838, "chapter_id": 1171, "verse_number": "१-१७२-७", "content_sanskrit": "यदर्थमिष्यते भार्या प्राप्तः सोऽर्थस्त्वया मयि।\nकन्या चैका कुमारश्च कृताहमनृणा त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2008839, "chapter_id": 1171, "verse_number": "१-१७२-८", "content_sanskrit": "समर्थः पोषणे चासि सुतयो रक्षणे तथा।\nन त्वहं सुतयोः शक्ता तथा रक्षणपोषणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2008840, "chapter_id": 1171, "verse_number": "१-१७२-९", "content_sanskrit": "मम हि त्वद्विहीनायाः सर्वप्राणधनेश्वर।\nकथं स्यातां सुतौ बालौ भरेयं च कथं त्वहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2008841, "chapter_id": 1171, "verse_number": "१-१७२-१०", "content_sanskrit": "कथं हि विधवाऽनाथा बालपुत्रा विना त्वया।\nमिथुनं जीवयिष्यामि स्थिता साधुगते पथि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2008842, "chapter_id": 1171, "verse_number": "१-१७२-११", "content_sanskrit": "अहं कृतावलेपैश्च प्रार्थ्यमानामिमां सुताम्।\nअयुक्तैस्तव संबन्धे कथं शक्ष्यामि रक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2008843, "chapter_id": 1171, "verse_number": "१-१७२-१२", "content_sanskrit": "उत्सृष्टमामिषं भूमौ प्रार्थयन्ति यथा खगाः।\nप्रार्थयन्ति जनाः सर्वे पतिहीनां तथा स्त्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2008844, "chapter_id": 1171, "verse_number": "१-१७२-१३", "content_sanskrit": "साऽहं विचाल्यमाना वै प्रार्थ्यमाना दुरात्मभिः।\nस्थातुं पथि न शक्ष्यामि सज्जनेष्टे द्विजोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2008845, "chapter_id": 1171, "verse_number": "१-१७२-१४", "content_sanskrit": "स्त्रीजन्म गर्हितं नाथ लोके दुष्टजनाकुले।\nमातापित्रोर्वशे कन्या प्रौढा भर्तृवशे तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2008846, "chapter_id": 1171, "verse_number": "१-१७२-१५", "content_sanskrit": "अभावे चानयोः पुत्रे खतन्त्रा स्त्री विगर्हिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2008847, "chapter_id": 1171, "verse_number": "१-१७२-१६", "content_sanskrit": "अनाथत्वं स्त्रियो द्वारं दुष्टानां विवृतं हि तत्।\nवस्त्रखण्डं घृताक्तं हि यथा संकृष्यते श्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2008848, "chapter_id": 1171, "verse_number": "१-१७२-१७", "content_sanskrit": "कथं तव कुलस्यैकमिमं बालमनागसम्।\nपितृपैतामहे मार्गे नियोक्तुमहमुत्सहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2008849, "chapter_id": 1171, "verse_number": "१-१७२-१८", "content_sanskrit": "कथं शक्ष्यामि बालेऽस्मिन्गुणानाधातुमीप्सितान्।\nअनाथे सर्वतो लुप्ते यथा त्वं धर्मदर्शिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2008850, "chapter_id": 1171, "verse_number": "१-१७२-१९", "content_sanskrit": "इमामपि च ते बालामनाथां परिभूय माम्।\nअनर्हाः प्रार्थयिष्यन्ति शूद्रा वेदश्रुतिं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2008851, "chapter_id": 1171, "verse_number": "१-१७२-२०", "content_sanskrit": "तां चेदहं न दित्सेयं सद्गुणैरुपबृंहिताम्।\nप्रमथ्यैनां हरेयुस्ते हविर्ध्वाङ्क्षा इवाध्वरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2008852, "chapter_id": 1171, "verse_number": "१-१७२-२१", "content_sanskrit": "संप्रेक्षमाणा पुत्रीं ते नानुरूपमिवात्मनः।\nअनर्हवशमापन्नामिमां चापि सुतां तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2008853, "chapter_id": 1171, "verse_number": "१-१७२-२२", "content_sanskrit": "अवज्ञाता च लोकेषु तथान्मानमजानती।\nअवलिप्तैरैर्ब्रह्मन्मरिष्यामि न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2008854, "chapter_id": 1171, "verse_number": "१-१७२-२३", "content_sanskrit": "तौ च हीनौ मया बालौ त्वया चैव तथात्मजौ।\nविनश्येतां न सन्देहो मत्स्याविव जलक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2008855, "chapter_id": 1171, "verse_number": "१-१७२-२४", "content_sanskrit": "त्रितयं सर्वथाप्येवं विनशिष्यत्यसंशयम्।\nत्वया विहीनं तस्मात्त्वं मां परित्यक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2008856, "chapter_id": 1171, "verse_number": "१-१७२-२५", "content_sanskrit": "व्युष्टिरेषा परा स्त्रीणां पूर्वं भर्तुः परा गतिः।\nननु ब्रह्मन्सपुत्राणामिति धर्मविदो विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2008857, "chapter_id": 1171, "verse_number": "१-१७२-२६", "content_sanskrit": "अनिष्टमिह पुत्राणां विषये परिवर्तितुम्।\nहरिद्राञ्जनपुष्पादिसौमङ्गल्ययुता सती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2008858, "chapter_id": 1171, "verse_number": "१-१७२-२७", "content_sanskrit": "मरणं याति या भर्तुस्तद्दत्तजलपायिनी।\nभर्तृपादार्पितमनाः सा याति गिरिजापदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2008859, "chapter_id": 1171, "verse_number": "१-१७२-२८", "content_sanskrit": "गिराजायाः सखी भूत्वा मोदते नगकन्यया।\nमितं ददाति हि पिता मितं माता मितं सुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2008860, "chapter_id": 1171, "verse_number": "१-१७२-२९", "content_sanskrit": "अमितस्य हि दातारं का पतिं नाभिनन्दति।\nआश्रमाश्चाग्निसंस्कारा जपहोमव्रतानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2008861, "chapter_id": 1171, "verse_number": "१-१७२-३०", "content_sanskrit": "स्त्रीणां नैते विधातव्या विना पतिमनिन्दितम्।\nक्षमा शौचमनाहारमेतावद्विहितं स्त्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2008862, "chapter_id": 1171, "verse_number": "१-१७२-३१", "content_sanskrit": "परित्यक्तः सुतश्चायं दुहितेयं तथा मया।\nबान्धवाश्च परित्यक्तास्त्वदर्थं जीवितं च मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2008863, "chapter_id": 1171, "verse_number": "१-१७२-३२", "content_sanskrit": "यज्ञैस्तपोभिर्नियमैर्दानैश्च विविधैस्तथा।\nविशिष्यते स्त्रिया भर्तुर्नित्यं प्रियहिते स्थितिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2008864, "chapter_id": 1171, "verse_number": "१-१७२-३३", "content_sanskrit": "तदिदं यच्चिकीर्षामि धर्मं परमसंमतम्।\nइष्टं चैव हितं चैव तव चैव कुलस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2008865, "chapter_id": 1171, "verse_number": "१-१७२-३४", "content_sanskrit": "इष्टानि चाप्यपत्यानि द्रव्याणि सुहृदः प्रियाः।\nआपद्धर्मप्रमोक्षाय भार्या चापि सतां मतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2008866, "chapter_id": 1171, "verse_number": "१-१७२-३५", "content_sanskrit": "आपदर्थे धनं रक्षेद्दारान्रक्षेद्धनैरपि।\nआत्मानं सततं रक्षेद्दारैरपि धनैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2008867, "chapter_id": 1171, "verse_number": "१-१७२-३६", "content_sanskrit": "दृष्टादृष्टफलार्थं हि भार्या पुत्रो धनं गृहम्।\nसर्वमेतद्विधातव्यं बुधानामेष निश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2008868, "chapter_id": 1171, "verse_number": "१-१७२-३७", "content_sanskrit": "एकतो वा कुलं कृत्स्नमात्मा वा कुलवर्धनः।\nउभयोः कोधिको विद्वन्नात्मा चैवाधिकः कुलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2008869, "chapter_id": 1171, "verse_number": "१-१७२-३८", "content_sanskrit": "आत्मनो विद्यमानत्वाद्भुवनानि चतुर्दश।\nविद्यन्ते द्विजशार्दूल आतमा रक्ष्यस्ततस्त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2008870, "chapter_id": 1171, "verse_number": "१-१७२-३९", "content_sanskrit": "आत्मन्यविद्यमाने चेदस्य नास्तीह किंचन।\nएतज्जगदिदं सर्वमात्मना न समं किल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2008871, "chapter_id": 1171, "verse_number": "१-१७२-४०", "content_sanskrit": "स कुरुष्व मया कार्यं तारयात्मानमात्मना।\nअनुजानीही मामार्य सुतौ मे परिपालय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2008872, "chapter_id": 1171, "verse_number": "१-१७२-४१", "content_sanskrit": "अवध्याः स्त्रिय इत्याहुर्धर्मज्ञा धर्मनिश्चये।\nधर्मज्ञान्राक्षसानाहुर्न हन्यात्स च मामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2008873, "chapter_id": 1171, "verse_number": "१-१७२-४२", "content_sanskrit": "निःसंशयं वधः पुंसां स्त्रीणां संशयितो वधः।\nअतो मामेव धर्मज्ञ प्रस्थापयितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2008874, "chapter_id": 1171, "verse_number": "१-१७२-४३", "content_sanskrit": "भुक्तं प्रियाण्यवाप्तानि धर्मश्च चरितो मया।\nत्वच्छुश्रूषणसंभूता कीर्तिश्चाप्यतुला मम।\nत्वत्प्रसूतिः प्रिया प्राप्ता न मां तप्स्यत्यजीवितं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2008875, "chapter_id": 1171, "verse_number": "१-१७२-४४", "content_sanskrit": "जातपुत्रा च वृद्धा च प्रियकामा च ते सदा।\nसमीक्ष्यैतदहं सर्वं व्यवसायं करोम्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2008876, "chapter_id": 1171, "verse_number": "१-१७२-४५", "content_sanskrit": "उत्सृज्यापि हि मामार्य प्राप्स्यस्यन्यामपि स्त्रियम्।\nततः प्रतिष्ठितो धर्मो भविष्यति पुनस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2008877, "chapter_id": 1171, "verse_number": "१-१७२-४६", "content_sanskrit": "न चाप्यधर्मः कल्याण बहुपत्नीकता नृणाम्।\nस्त्रीणामधर्मः सुमहान्भर्तुः पूर्वस्य लङ्घने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2008878, "chapter_id": 1171, "verse_number": "१-१७२-४७", "content_sanskrit": "एतत्सर्वं समीक्ष्य त्वमात्मत्यागं च गर्हितम्।\nआत्मानं तारयाद्याशु कुलं चेमौ च दारकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2008879, "chapter_id": 1171, "verse_number": "१-१७२-४८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2008880, "chapter_id": 1171, "verse_number": "१-१७२-४८", "content_sanskrit": "एवमुक्तस्तया भर्ता तां समालिङ्ग्य भारत।\nमुमोच बाष्पं शनकैः सभार्यो भृशदुःखितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2008881, "chapter_id": 1171, "verse_number": "१-१७२-४९", "content_sanskrit": "मैवं वद त्वं कल्याणि तिष्ठ चेह सुमध्यमे।\nन तु भार्यां त्यजेत्प्राज्ञः पुत्रान्वापि कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2008882, "chapter_id": 1171, "verse_number": "१-१७२-५०", "content_sanskrit": "विशेषतः स्त्रियं रक्षेत्पुरुषो बुद्धिमानिह।\nत्यक्त्वा तु पुरुषो जीवेन्न हातव्यानिमान्सदा।\nन वेत्ति कामं धर्मं च अर्थं मोक्षं च तत्त्वतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2008883, "chapter_id": 1171, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि बकवधपर्वणि द्विसप्तत्यधिकशततमोऽध्यायः॥ १७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]