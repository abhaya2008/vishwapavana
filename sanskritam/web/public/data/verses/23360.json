[{"id": 7003360000, "chapter_id": 23360, "verse_number": "२-५५-१", "content_sanskrit": "ऋषय ऊचुः    ।\nकथं त्रियंबको देवो देवदेवो वृषध्वजः ।\nध्येयः सर्वार्थासिद्ध्यर्थं योगमार्गेण सुव्रत ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003360001, "chapter_id": 23360, "verse_number": "२-५५-२", "content_sanskrit": "पूर्वमेवापि निखिलं श्रुतं श्रुतिसमं पुनः ।\nविस्तरेण च तत्सर्वं संक्षेपाद्वक्तुमर्हसि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003360002, "chapter_id": 23360, "verse_number": "२-५५-३", "content_sanskrit": "सूत उवाच  ।\nएवं पैतामहेनैव नंदी दिनकरप्रभः ।\nमेरुपृष्ठे पुरा पृष्टो मुनिसंघैः समावृतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003360003, "chapter_id": 23360, "verse_number": "२-५५-४", "content_sanskrit": "सोऽपि तस्मै कुमाराय ब्रह्मपुत्राय सुव्रताः ।\nमिथः प्रोवाच  ।\nगवान्प्रणताय समाहितः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003360004, "chapter_id": 23360, "verse_number": "२-५५-५", "content_sanskrit": "नंदिकेश्वर उवाच  ।\nएवं पुरा महादेवो भगवान्नीललोहितः ।\nगिरिपुत्र्यांबया देव्या भगवत्यैकशय्या ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003360005, "chapter_id": 23360, "verse_number": "२-५५-६", "content_sanskrit": "पृष्टः कैलासशिखरे हृष्टपुष्टतनूरुहः  ।\nश्रीदेव्युवाच  ।\nयोगः कतिविधः प्रोक्तस्तत्कथं चैव कीदृशम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003360006, "chapter_id": 23360, "verse_number": "२-५५-७", "content_sanskrit": "ज्ञानं च मोक्षदं दिव्यं मुच्यंते येन जंतवः  ।\nश्रीभगवानुवाच  ।\nप्रथमो मंत्रयोगश्च स्पर्शयोगो द्वितीयकः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003360007, "chapter_id": 23360, "verse_number": "२-५५-८", "content_sanskrit": "भावयोगस्तृतीयः स्याभावश्च चतुर्थकः ।\nसर्वोत्तमो महायोगः पंचमः परिकीर्तितः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003360008, "chapter_id": 23360, "verse_number": "२-५५-९", "content_sanskrit": "ध्यानयुक्तो जपाभ्यासो मंत्रयोगः प्रकीर्तितः ।\nनाडीशुद्ध्यधिको यस्तु रेचकादिक्रमान्वितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003360009, "chapter_id": 23360, "verse_number": "२-५५-१०", "content_sanskrit": "समस्तव्यस्तयोगेन जयो वायोः प्रकीर्तितः ।\nबलस्थिरक्रियायुक्तो धारणाद्यैश्च शोभनैः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003360010, "chapter_id": 23360, "verse_number": "२-५५-११", "content_sanskrit": "धारणात्रयसंदीप्तो भेदत्रयविशोधकः ।\nकुंभकावस्थितोऽभ्यासः स्पर्शयोगः प्रकीर्तितः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003360011, "chapter_id": 23360, "verse_number": "२-५५-१२", "content_sanskrit": "मंत्रस्पर्शविनिर्मुक्तो महादेवं समाश्रितः ।\nबहिरंतर्विभागस्थस्फुरत्संहरणात्मकः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003360012, "chapter_id": 23360, "verse_number": "२-५५-१३", "content_sanskrit": "भावयोगः समाख्याताश्चित्तशुद्धिप्रदायकः ।\nविलिनावयवं सर्वं जगत्स्थावरजंगमम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003360013, "chapter_id": 23360, "verse_number": "२-५५-१४", "content_sanskrit": "शून्यं सर्वं निराभासं स्वरूपं यत्र चिंत्यते ।\nअभावयोगः संप्रोक्तश्चित्तनिर्वाणकारकः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003360014, "chapter_id": 23360, "verse_number": "२-५५-१५", "content_sanskrit": "नीरूपः केवलः शुद्धः स्वच्छंदं च सुशोभनः ।\nअनिर्देश्यः सदालोकः स्वयंवेद्यः समं ततः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003360015, "chapter_id": 23360, "verse_number": "२-५५-१६", "content_sanskrit": "स्वभावो भासते यत्र महायोगः प्रकीर्तितः ।\nनित्योदितः स्वयंज्योतिः सर्वचित्तसमुत्थितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003360016, "chapter_id": 23360, "verse_number": "२-५५-१७", "content_sanskrit": "निर्मलः केवलो ह्यात्मा महायोग इति स्मृतः ।\nअणिमादिप्रदाः सर्वे सर्वे ज्ञानस्य दायकाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003360017, "chapter_id": 23360, "verse_number": "२-५५-१८", "content_sanskrit": "उत्तरोत्तरवैशिष्ट्यमेषु योगेष्वनुक्रमात् ।\nअहं संगविनिर्मुक्तो महाकाशोपमः परः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003360018, "chapter_id": 23360, "verse_number": "२-५५-१९", "content_sanskrit": "सर्वावरणनिर्मुक्तो ह्यचिंत्यः स्वरसेन तु ।\nज्ञेयमेतत्समाख्यातमग्राह्यमपि दैवतैः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003360019, "chapter_id": 23360, "verse_number": "२-५५-२०", "content_sanskrit": "प्रविलीनो महान्सम्यक् स्वयंवेद्यः स्वसाक्षिकः ।\nचकारस्त्यानंदवपुषा तेन ज्ञेयमिदं मतम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003360020, "chapter_id": 23360, "verse_number": "२-५५-२१", "content_sanskrit": "परीक्षिताय शिष्याय ब्राह्मणायाहिताग्नये ।\nधार्मिकायाकृतघ्नाय दातव्यं क्रमपूर्वकम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003360021, "chapter_id": 23360, "verse_number": "२-५५-२२", "content_sanskrit": "गुरुदैवतभक्ताय अन्यथा नैव दापयेत् ।\nनिंदितो व्याधितोल्पायुस्तथा चैव प्रजायते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003360022, "chapter_id": 23360, "verse_number": "२-५५-२३", "content_sanskrit": "दातुरप्येवमनघे तस्माज्ञात्वैव दापयेत् ।\nसर्वसंगविनिर्मुक्तो मद्भक्तो मत्परायणः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003360023, "chapter_id": 23360, "verse_number": "२-५५-२४", "content_sanskrit": "साधको ज्ञानसंयुक्तः श्रौतस्मार्तविशारदः ।\nगुरुभक्तश्च पुण्यात्मा योग्यो योगरतः सदा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003360024, "chapter_id": 23360, "verse_number": "२-५५-२५", "content_sanskrit": "एव देवि समाख्यातो योगमार्गः सनातनः ।\nसर्ववेदागमांभोजमकरंदः सुमध्यमे ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003360025, "chapter_id": 23360, "verse_number": "२-५५-२६", "content_sanskrit": "पीत्वा योगामृतं योगी मुच्यते ब्रह्मवित्तमः ।\nएवं पाशुपतं योगं योगैश्वर्यमनुत्तमम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003360026, "chapter_id": 23360, "verse_number": "२-५५-२७", "content_sanskrit": "अत्याश्रममिदं ज्ञेयं मुक्तये केन लभ्यते ।\nतस्मादिष्टैः समाचारैः शिवार्चनरतैः प्रिये ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003360027, "chapter_id": 23360, "verse_number": "२-५५-२८", "content_sanskrit": "इत्युक्त्वा भगवान्देवीमनुज्ञाप्य वृषध्वजः ।\nशंकुकर्णं समासाद्य युयोजात्मानमात्मनि ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003360028, "chapter_id": 23360, "verse_number": "२-५५-२९", "content_sanskrit": "शैलादिरुवाच  ।\nतस्मात्त्वमपि योगींद्र योगाभ्यासरतो भव ।\nस्वंयभुव परा मूर्तिर्नूनं ब्रह्ममयी वरा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003360029, "chapter_id": 23360, "verse_number": "२-५५-३०", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन मोक्षार्थो पुरुषोत्तमः ।\nभस्मस्नायी भवेन्नित्यं योगे पाशुपते रतः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003360030, "chapter_id": 23360, "verse_number": "२-५५-३१", "content_sanskrit": "ध्येया यथाक्रमेणैव वैष्णवी च ततः परा ।\nमाहेश्वरी परा पश्चात्सैव ध्येया यथाक्रमम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003360031, "chapter_id": 23360, "verse_number": "२-५५-३२", "content_sanskrit": "योगेश्वरस्य या निष्ठा सैषा संहृत्य वर्णिता ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003360032, "chapter_id": 23360, "verse_number": "२-५५-३३", "content_sanskrit": "सूत उवाच  ।\nएवं शिलादपुत्रेण नंदिना कुलनन्दिना ।\nयोगः पाशुपतः प्रोक्तो भस्मनिष्ठेन धीमता ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003360033, "chapter_id": 23360, "verse_number": "२-५५-३४", "content_sanskrit": "सनत्कुमारो भगवान्व्यासायामिततेजसे ।\nतस्मादहमपि श्रुत्वा नियोगात्सत्रिणामपि ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003360034, "chapter_id": 23360, "verse_number": "२-५५-३५", "content_sanskrit": "कृतकृत्योऽस्मि विप्रेभ्यो नमो यज्ञेभ्य एव च ।\nनमः शिवाय शांताय व्यासाय मुनये नमः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003360035, "chapter_id": 23360, "verse_number": "२-५५-३६", "content_sanskrit": "ग्रंथैकादशसाहस्रं पुराणं लैंगमुत्तमम् ।\nअष्टोत्तरसताध्याय मादिमांशमतः परम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003360036, "chapter_id": 23360, "verse_number": "२-५५-३७", "content_sanskrit": "षट्चत्वारींशदध्यायं धर्मकामार्थमोक्षदम् ।\nअथ ते मुनयः सर्वे नैमिषेयाः समाहिताः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003360037, "chapter_id": 23360, "verse_number": "२-५५-३८", "content_sanskrit": "प्रणेमुर्देवमीशानं प्रीतिकंटकितत्वचः ।\nशाखां पौराणिकीमेवं कृत्वैकादशिकां प्रभुः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003360038, "chapter_id": 23360, "verse_number": "२-५५-३९", "content_sanskrit": "ब्रह्मा स्वयंभूर्भगवानिदं वचनमब्रवीत् ।\nलैंगमाद्यंतमखिलं यः पठेच्छृणुयादपि ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003360039, "chapter_id": 23360, "verse_number": "२-५५-४०", "content_sanskrit": "द्विजेभ्यः श्रावयेद्वापि स याति परमां गतिम् ।\nतपसा चैव यज्ञेन दानेनाध्ययनेन च ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003360040, "chapter_id": 23360, "verse_number": "२-५५-४१", "content_sanskrit": "या गतिस्तस्य विपुला शास्त्रविद्या च वैदिकी ।\nकर्मणा चापि मिश्रेण केवलं विद्ययापि वा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003360041, "chapter_id": 23360, "verse_number": "२-५५-४२", "content_sanskrit": "निवृत्तिश्चास्य विप्रस्य भवेद्भक्तिश्च शाश्वती ।\nमयि नारायणे देवे श्रद्धा चास्तु महात्मनः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003360042, "chapter_id": 23360, "verse_number": "२-५५-४३", "content_sanskrit": "वंशस्य चाक्षया विद्या चाप्रमादश्च सर्वतः ।\nइत्याज्ञा ब्रह्मणस्तस्मात्तस्य सर्वं महात्मनः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003360043, "chapter_id": 23360, "verse_number": "२-५५-४४", "content_sanskrit": "ऋषयः प्रोचुः  ।\nऋषेः सूतस्य चास्माकमेतेषाभपि चास्य च ।\nनारदस्य च या सिद्धिस्तीर्थयात्रारतस्य च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003360044, "chapter_id": 23360, "verse_number": "२-५५-४५", "content_sanskrit": "प्रीतिश्च विपुला यस्मा दस्माकं रोमहर्षण ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003360045, "chapter_id": 23360, "verse_number": "२-५५-४६", "content_sanskrit": "सा सदास्तु विरूपाक्षप्रसादात्तु समंततः ।\nएवमुक्तेषु विप्रेषु नारदो भगवानपि ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003360046, "chapter_id": 23360, "verse_number": "२-५५-४७", "content_sanskrit": "कराभ्यां सुशुभाग्राभ्यां सूतं पस्पर्शिवांस्त्वचि ।\nस्वस्त्यस्तु सूत भद्रं ते महादेवे वृषध्वजे ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003360047, "chapter_id": 23360, "verse_number": "२-५५-४८", "content_sanskrit": "श्रद्धा तवास्तु चास्माकं नमस्तस्मै शिवाय च ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]