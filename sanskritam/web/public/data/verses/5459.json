[{"id": 2208746, "chapter_id": 5459, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2208747, "chapter_id": 5459, "verse_number": "१", "content_sanskrit": "तथा प्रयान्तं वार्ष्णेयं द्वारकां भरतर्षभाः ।\nपरिष्वज्य न्यवर्तन्त सानुयात्राः परन्तपाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2208748, "chapter_id": 5459, "verse_number": "२", "content_sanskrit": "पुनः पुनश्च वार्ष्णेयं पर्यष्वजत फल्गुनः ।\nआचक्षुर्विषयादेनं ददर्श स पुनः पुनः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2208749, "chapter_id": 5459, "verse_number": "३", "content_sanskrit": "कृच्छ्रेणैव च तां पार्थो गोविन्दे विनिवेशिताम् ।\nसञ्जहार ततो दृष्टिं कृष्णश्चाप्यपराजितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2208750, "chapter_id": 5459, "verse_number": "४", "content_sanskrit": "तत्र प्रयाणे यान्यासन् निमित्तानि महात्मनः ।\nबहून्यद्भुतरूपाणि तानि मे गदतः शृणु ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2208751, "chapter_id": 5459, "verse_number": "५", "content_sanskrit": "वायुर्वेगेन महता रथस्य पुरतो ववौ ।\nकुर्वन् निःशर्करं मार्गं विरजस्कमकण्टकम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2208752, "chapter_id": 5459, "verse_number": "६", "content_sanskrit": "ववर्ष वासवश्चैव तोयं शुचि सुगन्धि च ।\nदिव्यानि चैव पुष्पाणि पुरतः शार्ङ्गधन्वनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2208753, "chapter_id": 5459, "verse_number": "७", "content_sanskrit": "सम्प्रयातो महाबाहुः समेषु मरुधन्वसु ।\nआगच्छन्तमपश्यद्वै उदङ्कं नाम नामतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2208754, "chapter_id": 5459, "verse_number": "८", "content_sanskrit": "महर्षिं सिद्धतपसं त्रिषु लोकेषु विश्रुतम् ।\nस तं सम्पूज्य तेजस्वी मुनिं कमललोचनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2208755, "chapter_id": 5459, "verse_number": "९", "content_sanskrit": "पूजितस्तेन च तदा पर्यपृच्छदनामयम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2208756, "chapter_id": 5459, "verse_number": "१०", "content_sanskrit": "स पृष्टः कुशलं तेन सम्पूज्य मधुसूदनम् ।\nउदङ्को ब्राह्मणश्रेष्ठः ततः पप्रच्छ माधवम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2208757, "chapter_id": 5459, "verse_number": "", "content_sanskrit": "उदङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2208758, "chapter_id": 5459, "verse_number": "११", "content_sanskrit": "कच्चिच्छौरे त्वया गत्वा कुरुपाण्डवसद्म तत् ।\nकृतं सौभ्रात्रममलं तन्मे व्याख्यातुमर्हसि ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2208759, "chapter_id": 5459, "verse_number": "१२", "content_sanskrit": "अपि सन्धाय तान् वीरान् उपावृत्तोऽसि केशव ।\nसम्बन्धिनः सुदयितान् सततं वृष्णिपुङ्गव ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2208760, "chapter_id": 5459, "verse_number": "१३", "content_sanskrit": "कच्चित् पाण्डुसुताः पञ्च धृतराष्ट्रस्य चात्मजाः ।\nलोकेषु विहरिष्यन्ति त्वया सह परन्तपाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2208761, "chapter_id": 5459, "verse_number": "१४", "content_sanskrit": "स्वराष्ट्रेषु च राजानः कच्चित् प्राप्स्यन्ति वै सुखम् ।\nकौरवेषु प्रशान्तेषु त्वया नाथेन माधव ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2208762, "chapter_id": 5459, "verse_number": "१५", "content_sanskrit": "या मे सम्भावना तात त्वयि नित्यमवर्तत ।\nअपि सा सफला कृष्ण कृता ते भारतान् प्रति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2208763, "chapter_id": 5459, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2208764, "chapter_id": 5459, "verse_number": "१६", "content_sanskrit": "कृतो यत्नो मया ब्रह्मन् सौशाम्ये कौरवान् प्रति ।\nन चाशक्यन्त सन्धातुमधर्मरुचयो मया ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2208765, "chapter_id": 5459, "verse_number": "१७", "content_sanskrit": "ततस्ते निधनं प्राप्ताः सर्वे ससुतबान्धवाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2208766, "chapter_id": 5459, "verse_number": "१८", "content_sanskrit": "न दिष्टमप्यतिक्रान्तुं शक्यं बुद्ध्या बलेन वा ।\nमहर्षे विदितं नूनं सर्वमेतत् तवानघ ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2208767, "chapter_id": 5459, "verse_number": "१९", "content_sanskrit": "अत्यक्रामन् वचो मह्यं भीष्मस्य विदुरस्य च ।\nततो यमक्षयं जग्मुः समासाद्येतरेतरम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2208768, "chapter_id": 5459, "verse_number": "२०", "content_sanskrit": "पञ्चैव पाण्डवाः शिष्टा हतामित्रा हतात्मजाः ।\nधार्तराष्ट्राश्च निहताः सर्वे ससुतबान्धवाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2208769, "chapter_id": 5459, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2208770, "chapter_id": 5459, "verse_number": "२१", "content_sanskrit": "इत्युक्तवचने कृष्णे भृशं क्रोधसमन्वितः ।\nउदङ्कः प्रत्युवाचेदं क्रोधादुद्धृत्य लोचने ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2208771, "chapter_id": 5459, "verse_number": "", "content_sanskrit": "उदङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2208772, "chapter_id": 5459, "verse_number": "२२", "content_sanskrit": "यस्माच्छक्तेन ते कृष्ण न त्राताः कुरुपाण्डवाः ।\nसम्बन्धिनः प्रियास्तस्मात् शप्स्येऽहं त्वां न संशयः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2208773, "chapter_id": 5459, "verse_number": "२३", "content_sanskrit": "न च वै प्रसभं यस्मात् ते निगृह्य निवर्तिताः ।\nतस्मान्मन्युपरीतस्त्वां शप्स्यामि मधुसूदन ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2208774, "chapter_id": 5459, "verse_number": "२४", "content_sanskrit": "त्वया शक्तेन हि सता मिथ्याचारेण माधव ।\nप्रमापिताः कुरुश्रेष्ठा यत् त्वया समुपेक्षिताः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2208775, "chapter_id": 5459, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2208776, "chapter_id": 5459, "verse_number": "२५", "content_sanskrit": "शृणु मे विस्तरेणेदं यद् वक्ष्ये भृगुनन्दन ।\nगृहाणानुनयं चैव तपस्वी ह्यसि भार्गव ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2208777, "chapter_id": 5459, "verse_number": "२६", "content_sanskrit": "श्रुत्वा तु मे तदध्यात्मं मुञ्चेथाः शापमद्य वै ।\nन च मां तपसाऽल्पेन शक्नोति शपितुं भवान् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2208778, "chapter_id": 5459, "verse_number": "२७", "content_sanskrit": "न च ते तपसो नाशमिच्छामि तपतां वर ।\nतपस्ते सुमहत् तप्तं गुरवश्चापि तोषिताः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2208779, "chapter_id": 5459, "verse_number": "२८", "content_sanskrit": "कौमारं ब्रह्मचर्यं ते जानामि द्विजसत्तम ।\nदुःखार्जितस्य तपसः तस्मान्नेच्छामि ते व्ययम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2208780, "chapter_id": 5459, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि उदङ्कदर्शनं नाम त्रिपञ्चाशोऽध्यायः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]