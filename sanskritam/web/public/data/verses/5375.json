[{"id": 2205331, "chapter_id": 5375, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2205332, "chapter_id": 5375, "verse_number": "१", "content_sanskrit": "मानुषेष्वेव जीवत्सु गतिर्विज्ञायते न वा ।\nयथा शुभगतिर्जीवो नासौ त्वशुभभागिति\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2205333, "chapter_id": 5375, "verse_number": "२", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं तन्मे शंसितुमर्हसि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2205334, "chapter_id": 5375, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2205335, "chapter_id": 5375, "verse_number": "३", "content_sanskrit": "तदहं ते प्रवक्ष्यामि जीवतां विद्यते यथा ।\nद्विविधाः प्राणिनो लोके दैवमासुरमाश्रिताः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2205336, "chapter_id": 5375, "verse_number": "४", "content_sanskrit": "मनसा कर्मणा वाचा प्रतिकूला भवन्ति ये ।\nतादृशानासुरान् विद्धि मर्त्यास्ते नरकालयाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2205337, "chapter_id": 5375, "verse_number": "५", "content_sanskrit": "रागद्वेषयुता ये तु निर्लज्जा निरपत्रपाः ।\nदर्पाहङ्कारसंयुक्ता नरा नरकगामिनः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2205338, "chapter_id": 5375, "verse_number": "६", "content_sanskrit": "नास्तिकाश्च शठा घोराः परेषामुपतापिनः ।\nयथेष्टवृत्तयश्चैव नरा नरकगामिनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2205339, "chapter_id": 5375, "verse_number": "७", "content_sanskrit": "दुष्प्रतीपमना यस्तु चलचित्तो निराकृतिः ।\nशिश्नोदररतिर्मूढो निरयं याति सोऽधमः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2205340, "chapter_id": 5375, "verse_number": "८", "content_sanskrit": "मांसपानप्रिया नित्यं कठोरा नीचवृत्तयः ।\nतादृशानासुरान् विद्धि सर्वे ते नरकालयाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2205341, "chapter_id": 5375, "verse_number": "९", "content_sanskrit": "हिंसाविहारा ये नित्यं निर्दयाः प्राणिनाशने ।\nस्वधर्मविमुखाश्चैव परस्वेष्वभिकाङ्क्षिणः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2205342, "chapter_id": 5375, "verse_number": "१०", "content_sanskrit": "युद्धमात्सर्यसंयुक्ता ग्राम्यभोगपरायणाः ।\nतादृशानासुरान् विद्धि नरान् नरकगामिनः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2205343, "chapter_id": 5375, "verse_number": "११", "content_sanskrit": "दर्पोत्सेकसमायुक्ता मूर्खास्तत्त्वबहिष्कृताः ।\nश्रुतिविद्वेषिणो नित्यं ते नरा नरकालयाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2205344, "chapter_id": 5375, "verse_number": "१२", "content_sanskrit": "नित्यं वदन्ति ये मोहादनृतं कटुकं वचः ।\nकृतघ्नाः पिशुना घोरा भवन्ति नरकालयाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2205345, "chapter_id": 5375, "verse_number": "१३", "content_sanskrit": "हिंस्राश्चोराश्च धूर्ताश्च परदाराभिमर्शिनः ।\nनीचकर्मरता ये च शौचमङ्गलवर्जिताः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2205346, "chapter_id": 5375, "verse_number": "१४", "content_sanskrit": "शुचिविद्वेषिणः पापा लोकचारित्रदूषकाः ।\nएवं युक्तसमाचारा जीवन्तो नरकालयाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2205347, "chapter_id": 5375, "verse_number": "१५", "content_sanskrit": "लोकोद्वेगकराश्चान्ये पशवश्च सरीसृपाः ।\nवृक्षाः कण्टकिनो रूक्षास्तादृशान् विद्धि चासुरान्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2205348, "chapter_id": 5375, "verse_number": "१६", "content_sanskrit": "अपरान् देवपक्षांस्तु शृणु देवि समाहिता\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2205349, "chapter_id": 5375, "verse_number": "१७", "content_sanskrit": "मनोवाक्कर्मभिर्नित्यमनुकूला भवन्ति ये ।\nतादृशानमरान् विद्धि ते नराः स्वर्गगामिनः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2205350, "chapter_id": 5375, "verse_number": "१८", "content_sanskrit": "शौचार्जवपराधीनाः परार्थं न हरन्ति ये ।\nये समाः सर्वभूतेषु ते नराः स्वर्गगामिनः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2205351, "chapter_id": 5375, "verse_number": "१९", "content_sanskrit": "भयाद्वा वृत्तिहेतोर्वा अनृतं न ब्रुवन्ति ये ।\nसत्यं वदन्ति सततं ते नराः स्वर्गगामिनः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2205352, "chapter_id": 5375, "verse_number": "२०", "content_sanskrit": "धार्मिकाः शौचसम्पन्नाः शुक्ला मधुरवादिनः ।\nनाकार्यं मनसेच्छन्ति ते नराः स्वर्गगामिनः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2205353, "chapter_id": 5375, "verse_number": "२१", "content_sanskrit": "दरिद्रा अपि ये केचिद् याचिताः प्रीतिपूर्वकम् ।\nददत्येव च यत्किञ्चित् ते नराः स्वर्गगामिनः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2205354, "chapter_id": 5375, "verse_number": "२२", "content_sanskrit": "आस्तिका मङ्गलपराः सततं वृद्धसेविनः ।\nपुण्यकर्मपरा नित्यं ते नराः स्वर्गगामिनः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2205355, "chapter_id": 5375, "verse_number": "२३", "content_sanskrit": "व्रतिनो दानशीलाश्च सुखशीलाश्च मानवाः।\nऋजवो मृदवो नित्यं ते नराः स्वर्गगामिनः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2205356, "chapter_id": 5375, "verse_number": "२४", "content_sanskrit": "गुरुशुश्रूषणपरा देवब्राह्मणपूजकाः ।\nकृतज्ञाः कृतविद्याश्च ते नराः स्वर्गगामिनः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2205357, "chapter_id": 5375, "verse_number": "२५", "content_sanskrit": "जितेन्द्रिया जितक्रोधा जितमानमदस्पृहाः ।\nलोभमात्सर्यहीना ये ते नराः स्वर्गगामिनः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2205358, "chapter_id": 5375, "verse_number": "२६", "content_sanskrit": "निर्ममा निरहङ्काराः सानुक्रोशाः स्वबन्धुषु ।\nदीनानुकम्पिनो नित्यं ते नराः स्वर्गगामिनः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2205359, "chapter_id": 5375, "verse_number": "२७", "content_sanskrit": "ऐहिकेन तु वृत्तेन पारत्रमनुमीयते ।\nएवंविधा नरा लोके जीवन्तः स्वर्गगामिनः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2205360, "chapter_id": 5375, "verse_number": "२८", "content_sanskrit": "यदन्यच्च शुभं लोके प्रजानुग्रहकारि च ।\nपशवश्चैव वृक्षाश्च प्रजानां हितकारिणः ।\nतादृशान् देवपक्षस्थानिति विद्धि शुभानने\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2205361, "chapter_id": 5375, "verse_number": "२९", "content_sanskrit": "शुभाशुभमयं लोके सर्वं स्थावरजङ्गमम् ।\nदैवं शुभमिति प्राहुरासुरं ह्यशुभं प्रिये \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2205362, "chapter_id": 5375, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्यहाभारते अनुशासनपर्वणि दानधर्मपर्वणि शुभाशुभगत्यनुमानकथनं नाम षड्विंशोत्तरद्विशततमोऽध्यायः ॥२२६॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]