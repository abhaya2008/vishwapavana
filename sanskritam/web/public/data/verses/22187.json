[{"id": 7002187000, "chapter_id": 22187, "verse_number": "२३२-१", "content_sanskrit": "पुष्कर उवाच ।\nविशन्ति येन मार्गेण वायसा बहवः पुरं ।\nतेन मार्गेण रुद्धस्य पुरस्य ग्रहणं भवेत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002187001, "chapter_id": 22187, "verse_number": "२३२-२", "content_sanskrit": "सेनायां यदि वासार्थे निविष्टो वायसो रुवन् ।\nवामो भयातुरस्त्रस्तो भयं वदति दुस्तरं ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002187002, "chapter_id": 22187, "verse_number": "२३२-३", "content_sanskrit": "छायाङ्गवाहनोपानच्छत्रवस्त्रादिकुट्टने ।\nमृत्युस्तत्पूजने पूजा तदिष्टकरणे शुभं ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002187003, "chapter_id": 22187, "verse_number": "२३२-४", "content_sanskrit": "प्रोषितागमकृत्काकः कुर्वन् द्वारि गतागतं ।\nरक्तं दग्धं गृहे द्रव्यं क्षिपन्वह्निवेदकः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002187004, "chapter_id": 22187, "verse_number": "२३२-५", "content_sanskrit": "न्यसेद्रक्तं पुरस्ताच्च निवेदयति बन्धनं ।\nपीतं द्रव्यं तथा रुक्म रूप्यमेव तु भार्गव ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002187005, "chapter_id": 22187, "verse_number": "२३२-६", "content_sanskrit": "यच्चैवोपनयेद्द्रव्यं तस्य लब्धिं विनिर्दिशेत् ।\nद्रव्यं वापनयेद्यत्तु तस्य हानिं विनिर्दिशेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002187006, "chapter_id": 22187, "verse_number": "२३२-७", "content_sanskrit": "पुरतो धनलब्धिः स्यादाममांसस्य छर्दने ।\nभूलब्धिः स्यान्मृदः क्षेपे राज्यं रत्नार्पणे महत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002187007, "chapter_id": 22187, "verse_number": "२३२-८", "content_sanskrit": "यातुः काकोऽनुकूलस्तु क्षेमः कर्मक्षमो भवेत् ।\nन त्वर्थसाधको ज्ञेयः प्रतिकूलो भयावहः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002187008, "chapter_id": 22187, "verse_number": "२३२-९", "content_sanskrit": "सम्मुखेऽभ्येति विरुवन् यात्राघातकरो भवेत् ।\nवामः काकः स्मृतो धन्यो दक्षिणोऽर्थविनाशकृत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002187009, "chapter_id": 22187, "verse_number": "२३२-१०", "content_sanskrit": "वामोऽनुलोमगः श्रेष्ठो मध्यमो दक्षिणः स्मृतः ।\nप्रतिलोमगतिर्वामो गमनप्रतिषेधकृत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002187010, "chapter_id": 22187, "verse_number": "२३२-११", "content_sanskrit": "निवेदयति यात्रार्थमभिप्रेतं गृहे गतः ।\nएकाक्षरचरणस्त्वर्कं वीक्षमाणो भयावहः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002187011, "chapter_id": 22187, "verse_number": "२३२-१२", "content_sanskrit": "कोटरे वासमानश्च महानर्थकरो भवेत् ।\nन शुभस्तूषरे काकः पङ्काङ्कः स तु शस्यते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002187012, "chapter_id": 22187, "verse_number": "२३२-१३", "content_sanskrit": "अमेध्यपूर्णवदनः काकः सर्वार्थसाधकः ।\nज्ञेयाः पतत्रिणोऽन्येऽपि काकवद्भृगुनन्दन ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002187013, "chapter_id": 22187, "verse_number": "२३२-१४", "content_sanskrit": "स्कन्धावारापसव्यस्थाः श्वानो विप्रविनाशकाः ।\nइन्द्रस्थाने नरेन्द्रस्य पुरेशस्य तु गोपुरे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002187014, "chapter_id": 22187, "verse_number": "२३२-१५", "content_sanskrit": "अन्तर्गृहे गृहेशस्य मरणाय भवेद्भषन् ।\nयस्य जिघ्रति वामाङ्गं तस्य स्यादर्थसिद्धये ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002187015, "chapter_id": 22187, "verse_number": "२३२-१६", "content_sanskrit": "भयाय दक्षिणं चाङ्गं तथा भुजमदक्षिणं ।\nयात्राघातकरो यातुर्भवेत्प्रतिमुखागतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002187016, "chapter_id": 22187, "verse_number": "२३२-१७", "content_sanskrit": "मार्गावरोधको मार्गे चौरान् वदति भार्गव ।\nअलाभोऽस्थिमुखः पापो रज्जुचीरमुखस्तथा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002187017, "chapter_id": 22187, "verse_number": "२३२-१८", "content_sanskrit": "सोपानत्कमुखो धन्यो मांसपूर्णमुखोऽपि च ।\nअमङ्गल्यमुखद्रव्यं केशञ्चैवाशुभं तथा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002187018, "chapter_id": 22187, "verse_number": "२३२-१९", "content_sanskrit": "अवमूत्र्याग्रतो याति यस्य तस्य भयं भवेत् ।\nयस्यावमूत्र्य व्रजति शुभं देशन्तथा द्रुमं ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002187019, "chapter_id": 22187, "verse_number": "२३२-२०", "content_sanskrit": "मङ्गलञ्च तथा द्रव्यं तस्य स्यादर्थसिद्धये ।\nश्ववच्च राम विज्ञेयास्तथा वै जम्बुकादयः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002187020, "chapter_id": 22187, "verse_number": "२३२-२१", "content_sanskrit": "भयाय स्वामिनि ज्ञेयमनिमित्तं रुतङ्गवां ।\nनिशि चौरभयाय स्याद्विकृतं मृत्यवे तथा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002187021, "chapter_id": 22187, "verse_number": "२३२-२२", "content_sanskrit": "शिवाय स्वामिनो रात्रौ बलीवर्दो नदन् भवेत् ।\nउत्सृष्टवृषभो राज्ञो विजयं सम्प्रयच्छति ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002187022, "chapter_id": 22187, "verse_number": "२३२-२३", "content_sanskrit": "अभयं भक्षयन्त्यश्च गावो दत्तास्तथा स्वकाः ।\nत्यक्तस्नेहाः स्ववत्सेषु गर्भक्षयकरा मताः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002187023, "chapter_id": 22187, "verse_number": "२३२-२४", "content_sanskrit": "भूमिं पादैर्विनिघ्नन्त्यो दीना भीता भयावहाः ।\nआर्द्राङ्ग्यो हृष्टरोमाश्च शृगलग्नमृदः शुभाः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002187024, "chapter_id": 22187, "verse_number": "२३२-२५", "content_sanskrit": "महिष्यादिषु चाप्येतत्सर्वं वाच्यं विजानता ।\nआरोहणं तथान्येन सपर्याणस्य वाजिनः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002187025, "chapter_id": 22187, "verse_number": "२३२-२६", "content_sanskrit": "जलोपवेशनं नेष्टं भूमौ च परिवर्तनं ।\nविपत्करन्तुरङ्गस्य सुप्तं वाप्यनिमित्ततः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002187026, "chapter_id": 22187, "verse_number": "२३२-२७", "content_sanskrit": "यवमोदकयोर्द्वेषस्त्वकस्माच्च न शस्यते ।\nवदनाद्रुधिरोत्पत्तिर्वेपनं न च शस्यते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002187027, "chapter_id": 22187, "verse_number": "२३२-२८", "content_sanskrit": "क्रीडन् वैकः कपोतैश्च सारिकाभिर्मृतिं वदेत् ।\nसाश्रुनेत्रो जिह्वया च पादलेही विनष्टये ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002187028, "chapter_id": 22187, "verse_number": "२३२-२९", "content_sanskrit": "वामपादेन च तथा विलिखंश्च वसुन्धरां ।\nस्वपेद्वा वामपार्श्वेन दिवा वा न शुभप्रदः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002187029, "chapter_id": 22187, "verse_number": "२३२-३०", "content_sanskrit": "भयाय स्यात्सकृन्मूत्री तथा निद्राविलाननः ।\nआरोहणं न चेद्दद्यात्प्रतीपं वा गृहं व्रजेत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002187030, "chapter_id": 22187, "verse_number": "२३२-३१", "content_sanskrit": "यात्राविघातमाचष्टे वामपार्श्वं तथा स्पृशन् ।\nहेषमाणः शत्रुयोधं पादस्पर्शी जयावहः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002187031, "chapter_id": 22187, "verse_number": "२३२-३२", "content_sanskrit": "ग्रामे व्रजति नागश्चेन्मैथुनं देशहा भवेत् ।\nप्रसूता नागवनिता मत्ता चान्ताय भूपतेः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002187032, "chapter_id": 22187, "verse_number": "२३२-३३", "content_sanskrit": "आरोहणं न चेद्दद्यात्प्रतीपं वा गृहं व्रजेत् ।\nमदं वा वारणो जह्याद्राजघातकरो भवेत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002187033, "chapter_id": 22187, "verse_number": "२३२-३४", "content_sanskrit": "वामं दक्षिणपादेन पादमाक्रमते शुभः ।\nदक्षिणञ्च तथा दन्तं परिमार्ष्टि करेण च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002187034, "chapter_id": 22187, "verse_number": "२३२-३५", "content_sanskrit": "वृषोऽश्वः कुञ्जरो वापि रिपुसैन्यगतोऽशुभः ।\nखण्डमेघातिवृष्ट्या तु सेना नाशमवाप्नुयात् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002187035, "chapter_id": 22187, "verse_number": "२३२-३६", "content_sanskrit": "प्रतिकूलग्रहर्क्षात्तु तथा सम्मुखमारुतात् ।\nयात्राकाले रणे वापि छत्रादिपतनं भयं ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002187036, "chapter_id": 22187, "verse_number": "२३२-३७", "content_sanskrit": "हृष्टा नराश्चानुलोमा ग्रहा वै जयलक्षणं ।\nकाकैर्योधाभिभवनं क्रव्याद्भिर्मण्डलक्षयः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002187037, "chapter_id": 22187, "verse_number": "२३२-३८", "content_sanskrit": "प्राचीपश्चिमकैशानी शौम्या प्रेष्ठा शुभा च दिक् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]