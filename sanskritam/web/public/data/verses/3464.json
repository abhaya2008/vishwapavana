[{"id": 2114629, "chapter_id": 3464, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2114630, "chapter_id": 3464, "verse_number": "१", "content_sanskrit": "कणिङ्कस्य मतं ज्ञात्वा कार्त्स्न्येन भरतर्षभ ।\nदुर्योधनश्च कर्णश्च शकुनिः सौबलस्तथा \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2114631, "chapter_id": 3464, "verse_number": "२", "content_sanskrit": "दुःशासनचतुर्थास्ते मन्त्रयामासुरेकतः ।\nततो दुर्योधनो राजन् धृतराष्ट्रमभाषत ।\nपाण्डवेभ्यो भयं नास्ति विधत्स्व यदनन्तरम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2114632, "chapter_id": 3464, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2114633, "chapter_id": 3464, "verse_number": "३", "content_sanskrit": "धृतराष्ट्रस्तु पुत्रस्य श्रुत्वा वाक्यमुवाच ह ।\nयथा न वाच्यतां पुत्र गच्छेम कुरु तत्तथा \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2114634, "chapter_id": 3464, "verse_number": "४", "content_sanskrit": "धर्मनित्यः सदा पाण्डुस्तथा धर्मपरायणः ।\nसर्वेषु ज्ञातिषु तथा ममासीत् प्रियकृद् हितः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2114635, "chapter_id": 3464, "verse_number": "५", "content_sanskrit": "नास्य किञ्चिन्न जानामि भोजनादि चिकीर्षितम् ।\nनिवेदयति नित्यं हि मम राज्यं धृतव्रतः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2114636, "chapter_id": 3464, "verse_number": "६", "content_sanskrit": "तस्य पुत्रो यथा पाण्डुस्तथा धर्मपरायणः ।\nगुणवान् लोकविख्यातः पौराणां च सुसम्मतः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2114637, "chapter_id": 3464, "verse_number": "७", "content_sanskrit": "स कथं शक्यतेऽस्माभिरपाकर्तुं बलादितः ।\nपितृपर्यागताद् राज्यात् ससहायो विशेषतः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2114638, "chapter_id": 3464, "verse_number": "८", "content_sanskrit": "भृता हि पाण्डुनाऽमात्या बलं च सततं भृतम् ।\nभृताः पुत्राश्च पौत्राश्च तेषामपि विशेषतः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2114639, "chapter_id": 3464, "verse_number": "९", "content_sanskrit": "तेनैव सत्कृतास्त्राताः पाण्डुना पौरवा जनाः ।\nकथं युधिष्ठिरस्यार्थे न नो हन्युः सबान्धवान् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2114640, "chapter_id": 3464, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2114641, "chapter_id": 3464, "verse_number": "१०", "content_sanskrit": "एवमेव त्वया तात भावितं दोषमात्मनि ।\nदृष्ट्वा प्रकृतयो नित्यमर्थदानैश्च पूजिताः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2114642, "chapter_id": 3464, "verse_number": "११", "content_sanskrit": "ध्रुवमस्मत्सहायास्ते भविष्यन्ति न संशयः ।\nअर्थवर्गः सहामात्यो मत्संस्थोऽद्य महीपते \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2114643, "chapter_id": 3464, "verse_number": "१२", "content_sanskrit": "स भवान् पाण्डवानाशु विवासयितुमर्हसि ।\nमृदुनैवाभ्युपायेन नगरं वारणावतम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2114644, "chapter_id": 3464, "verse_number": "१३", "content_sanskrit": "यदा प्रतिष्ठितं राज्यं मयि राजन् भविष्यति ।\nतदा कुन्ती सहापत्या पुनरेष्यति पार्थिव \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2114645, "chapter_id": 3464, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2114646, "chapter_id": 3464, "verse_number": "१४", "content_sanskrit": "दुर्योधन ममाप्येतत् सततं हृदि वर्तते ।\nअभिप्रायस्य पापत्वान्न ते विवृतवानहम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2114647, "chapter_id": 3464, "verse_number": "१५", "content_sanskrit": "नहि भीष्मो न विदुरो न द्रोणो नच गौतमः ।\nविवास्यमानान् कौन्तेयाननुमंस्यन्ति कथञ्चन१ \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2114648, "chapter_id": 3464, "verse_number": "१६", "content_sanskrit": "समा हि कौरवेयाणामेते पुरुषसत्तमाः ।\nनैते विषममिच्छेयुर्धर्मनित्या यशस्विनः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2114649, "chapter_id": 3464, "verse_number": "१७", "content_sanskrit": "ते वयं कौरवेयाणामेतेषां च महात्मनाम् ।\nकथं न वाच्यतां तात गच्छाम जगतस्तथा \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2114650, "chapter_id": 3464, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2114651, "chapter_id": 3464, "verse_number": "१८", "content_sanskrit": "मध्यस्थः सततं भीष्मो द्रोणपुत्रो मयि स्थितः ।\nयतः पुत्रस्ततो द्रोणो भविता नात्र संशयः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2114652, "chapter_id": 3464, "verse_number": "१९", "content_sanskrit": "कृपः शारद्वतश्चैव यत एतौ ततो भवेत् ।\nभागिनेयं तथा द्रोणं न त्यक्ष्यति कथञ्चन \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2114653, "chapter_id": 3464, "verse_number": "२०", "content_sanskrit": "क्षत्ताऽऽर्तबन्धुस्त्वस्माकं प्रच्छन्नस्तु यतः परे ।\nन चैकः स समर्थोऽस्मान् पाण्डवार्थे विबाधितुम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2114654, "chapter_id": 3464, "verse_number": "२१", "content_sanskrit": "सुविस्रब्धान् पाण्डुपुत्रान् सह मात्रा प्रवासय ।\nवारणावतमद्यैव नात्र दोषो भविष्यति \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2114655, "chapter_id": 3464, "verse_number": "२१", "content_sanskrit": "विनिद्राकरणं घोरं हृदि शल्यमिवार्पितम् ।\nशोकपावकमुद्भूतं कर्मणाऽनेन नाशय \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2114656, "chapter_id": 3464, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2114657, "chapter_id": 3464, "verse_number": "२२", "content_sanskrit": "ततस्तु दुर्योधनवचः कुत्सयित्वा जनेश्वरः ।\nहृदयेन तु संश्रित्य चिन्तयामास नैकधा \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2114658, "chapter_id": 3464, "verse_number": "२३", "content_sanskrit": "ततो दुर्योधनो राजन् सर्वास्तु प्रकृतीः शनैः ।\nअर्थमानप्रदानेन सञ्जग्राह सहानुजः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2114659, "chapter_id": 3464, "verse_number": "२४", "content_sanskrit": "धार्तराष्ट्रप्रयुक्तास्ते केचित् कुशलमन्त्रिणः ।\nकथयाञ्चक्रिरे रम्यं नगरं वारणावतम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2114660, "chapter_id": 3464, "verse_number": "२५", "content_sanskrit": "अयं समाजः सुमहान् रमणीयतरो भुवि ।\nउपस्थितः पशुपतेर्नगरे वारणावते \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2114661, "chapter_id": 3464, "verse_number": "२६", "content_sanskrit": "सर्वरत्नसमाकीर्णे पुण्ये देशे मनोरमे ।\nइत्येवं धार्तराष्ट्रस्य वचनाच्चक्रिरे कथाः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2114662, "chapter_id": 3464, "verse_number": "२७", "content_sanskrit": "कथ्यमाने तदा रम्ये नगरे वारणावते ।\nगमने पाण्डुपुत्राणां जज्ञे तत्र मतिर्नृप \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2114663, "chapter_id": 3464, "verse_number": "२८", "content_sanskrit": "यदा त्वशङ्कितान् राजन् कृतकौतूहलानिव ।\nउवाचैनानिति तदा पाण्डवानम्बिकासुतः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2114664, "chapter_id": 3464, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2114665, "chapter_id": 3464, "verse_number": "२९", "content_sanskrit": "अधीतानि च शास्त्राणि युष्माभिरिह कृत्स्नशः ।\nअस्त्राणि च तथा द्रोणाद् गौतमाच्च शरद्वतात् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2114666, "chapter_id": 3464, "verse_number": "३०", "content_sanskrit": "सोहमेवं गते ताताश्चिन्तयामि समन्ततः ।\nरक्षणे व्यवहारे च राज्यस्य सततं हिते \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2114667, "chapter_id": 3464, "verse_number": "३१", "content_sanskrit": "इमे हि पुरुषास्तात कथयन्ति पुनः पुनः ।\nरमणीयतरं लोके नगरं वारणावतम् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2114668, "chapter_id": 3464, "verse_number": "३२", "content_sanskrit": "ते ताता यदि मन्यध्वमुत्सवं वारणावते ।\nसगणाः सानुयात्राश्च विहरध्वं यथाऽमराः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2114669, "chapter_id": 3464, "verse_number": "३३", "content_sanskrit": "ब्राह्मणेभ्यश्च रत्नानि नटेभ्यश्च विशेषतः ।\nसम्प्रदध्वं यथाकामं देवा इव सुवर्चसः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2114670, "chapter_id": 3464, "verse_number": "३४", "content_sanskrit": "कञ्चित्कालं विहृत्यैवमवाप्य च परां मुदम् ।\nइहैव हस्तिनपुरे सुखेन पुनरेष्यथ \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2114671, "chapter_id": 3464, "verse_number": "३५", "content_sanskrit": "निवसध्वं च तत्रैव पुरेषणपरायणाः ।\nवैलक्षण्यं हि वस्तत्र भविष्यति परन्तपाः ।\nनगरं पुनरेवेदमुपयास्यथ पाण्डवाः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2114672, "chapter_id": 3464, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2114673, "chapter_id": 3464, "verse_number": "३६", "content_sanskrit": "धृतराष्ट्रस्य तं काममबुध्यत युधिष्ठिरः ।\nआत्मनश्चासहायत्वं तथेति प्रत्युवाच ह\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2114674, "chapter_id": 3464, "verse_number": "३७", "content_sanskrit": "ततो भीष्मं महाप्राज्ञं विदुरं च महामतिम् ।\nद्रौणं च बाह्लिकं चैव सोमदत्तं च कौरवम् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2114675, "chapter_id": 3464, "verse_number": "३८", "content_sanskrit": "कृपमाचार्यपुत्रं च गान्धारीं च यशस्विनीम् ।\nयुधिष्ठिरः शनैर्दीनमुवाचेदं वचस्तथा \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2114676, "chapter_id": 3464, "verse_number": "३९", "content_sanskrit": "रमणीये जनाकीर्णे नगरे वारणावते ।\nसगणास्तात यास्यामो धृतराष्ट्रस्य शासनात् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2114677, "chapter_id": 3464, "verse_number": "४०", "content_sanskrit": "प्रसन्नवदनाः सर्वे पुण्या वाचो विमुञ्चत ।\nआशीर्भिर्वर्धितानस्मान् न पापान् वै प्रवक्ष्यथ \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2114678, "chapter_id": 3464, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2114679, "chapter_id": 3464, "verse_number": "४१", "content_sanskrit": "एवमुक्तास्तु ते सर्वे पाण्डुपुत्रेण कौरवाः ।\nप्रसन्नवदना भूत्वा तेऽभ्यवर्धन्त पाण्डवान् \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2114680, "chapter_id": 3464, "verse_number": "४२", "content_sanskrit": "स्वस्त्यस्तु वः पथि सदा भूतेभ्यश्चैव सर्वशः ।\nमा वोचंस्त्वशुभं किञ्चित् सर्वतः पाण्डुनन्दनान् \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2114681, "chapter_id": 3464, "verse_number": "४३", "content_sanskrit": "ते तथा वर्धिता वृद्धै राज्यलाभाय पाण्डवाः ।\nकृत्वा सर्वाणि कार्याणि प्रययुर्वारणावतम् \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2114682, "chapter_id": 3464, "verse_number": "१४३", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nत्रिचत्वारिंशत्यधिकशततमोऽध्यायः ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2114683, "chapter_id": 3464, "verse_number": "१", "content_sanskrit": "॥ इति जतुगृहदाहपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2114684, "chapter_id": 3464, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]