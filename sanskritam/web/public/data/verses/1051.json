[{"id": 2002425, "chapter_id": 1051, "verse_number": "१-५२-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2002426, "chapter_id": 1051, "verse_number": "१-५२-१", "content_sanskrit": "ततः कर्म प्रववृते सर्पसत्रविधानतः।\nपर्यक्रामंश्च विदिवत्स्वे स्वे कर्मणि याजकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2002427, "chapter_id": 1051, "verse_number": "१-५२-२", "content_sanskrit": "प्रावृत्य कृष्णवासांसि धूम्रसंरक्तलोचनाः।\nजुहुवुर्मन्त्रवच्चैव समिद्धं जातवेदसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2002428, "chapter_id": 1051, "verse_number": "१-५२-३", "content_sanskrit": "कम्पयन्तश्च सर्वेषामुरगाणां मनांसि च।\nसर्पानाजुहुवुस्तत्र सर्वानग्निमुखे तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2002429, "chapter_id": 1051, "verse_number": "१-५२-४", "content_sanskrit": "ततः सर्पाः समापेतुः प्रदीप्ते हव्यवाहने।\nविचेष्टमानाः कृपणमाह्वयन्तः परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2002430, "chapter_id": 1051, "verse_number": "१-५२-५", "content_sanskrit": "विस्फुरन्तः श्वसन्तश्च वेष्टयन्तः परस्परम्।\nपुच्छैः शिरोभिश्च भृशं चित्रभानुं प्रपेदिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2002431, "chapter_id": 1051, "verse_number": "१-५२-६", "content_sanskrit": "श्वेताः कृष्णाश्च नीलाश्च स्थविराः शिशवस्तथा।\nनदन्तो विविधान्नादान्पेतुर्दीप्ते विभावसौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2002432, "chapter_id": 1051, "verse_number": "१-५२-७", "content_sanskrit": "क्रोशयोजनमात्रा हि गोकर्णस्य प्रमाणतः।\nपतन्त्यजस्रं वेगेन वह्नावग्निमतां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2002433, "chapter_id": 1051, "verse_number": "१-५२-८", "content_sanskrit": "एवं शतसहस्राणि प्रयुतान्यर्बुदानि च।\nअवशानि विनष्टानि पन्नगानां तु तत्र वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2002434, "chapter_id": 1051, "verse_number": "१-५२-९", "content_sanskrit": "तुरगा इव तत्रान्ये हस्तिहस्ता इवापरे।\nमत्ता इव च मातङ्गा महाकाया महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2002435, "chapter_id": 1051, "verse_number": "१-५२-१०", "content_sanskrit": "उच्चावचाश्च बहवो नानावर्णा विषोल्बणाः।\nघोराश्च परिघप्रख्या दन्दशूका महाबलाः।\nप्रपेतुरग्नावुरगा मातृवाग्दण्डपीडिताः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2002436, "chapter_id": 1051, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्माहाभारते आदिपर्वणि आस्तीकपर्वणि द्विपञ्चाशत्तमोऽध्यायः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]