[{"id": 2122829, "chapter_id": 3636, "verse_number": "", "content_sanskrit": "शकुनिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2122830, "chapter_id": 3636, "verse_number": "१", "content_sanskrit": "यां त्वमेतां श्रियं दृष्ट्वा पाण्डुपुत्रे युधिष्ठिरे ।\nतप्यसे तां हरिष्यामि द्यूतेनाहूयतां परम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2122831, "chapter_id": 3636, "verse_number": "२", "content_sanskrit": "अगत्वा संशयमहमयुद्ध्वा च चमूमुखे ।\nअक्षान् क्षिपन्नक्षतस्तान् विद्वानविदुषो जये ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2122832, "chapter_id": 3636, "verse_number": "३", "content_sanskrit": "ग्लहं धनूंषि मे विद्धि शरानक्षांश्च भारत ।\nअक्षाणां हृदयं मे ज्यां रथं विद्धि समास्तरम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2122833, "chapter_id": 3636, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2122834, "chapter_id": 3636, "verse_number": "४", "content_sanskrit": "अयमुत्सहते राजन् श्रियमाहर्तुमक्षवित् ।\nद्यूतेन पाण्डुपुत्रेभ्यस्तत् तुभ्यं तात रोचताम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2122835, "chapter_id": 3636, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2122836, "chapter_id": 3636, "verse_number": "५", "content_sanskrit": "स्थितोऽस्मि शासने भ्रातुर्विदुरस्य महामतेः ।\nतेन सङ्गम्य वेत्स्यामि मन्त्रस्यास्य विनिश्चयम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2122837, "chapter_id": 3636, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2122838, "chapter_id": 3636, "verse_number": "६", "content_sanskrit": "कृष्णादभ्यधिकः सोऽपि बुद्ध्या क्षत्ता विशाम्पते ।\nकेवलं धर्ममेवाह न तद् विजयसाधनम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2122839, "chapter_id": 3636, "verse_number": "७", "content_sanskrit": "जयश्च धर्मतपनस्तथैव भरतर्षभ ।\nतस्माद् विनयतो जेता तावुभौ न विरोधिनौ ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2122840, "chapter_id": 3636, "verse_number": "८", "content_sanskrit": "निहनिष्यति ते बुद्धिं विदुरो मुक्तसंशयः ।\nपाण्डवानां हिते युक्तो न तथा मम कौरव ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2122841, "chapter_id": 3636, "verse_number": "९", "content_sanskrit": "नारभेत् परसामर्थ्यात् पुरुषः कार्यमात्मनः ।\nमतिसाम्यं द्वयोर्नास्ति कार्येषु कुरुनन्दन ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2122842, "chapter_id": 3636, "verse_number": "१०", "content_sanskrit": "भयं परिहरन् मत्त आत्मानं परिपालयन् ।\nवर्षासु क्लिन्नवटवत् तिष्ठन् नैवावसीदति ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2122843, "chapter_id": 3636, "verse_number": "११", "content_sanskrit": "न व्याधयो नापि यमः श्रेयःप्राप्तिं प्रतीक्षते ।\nयावदेव भवेत् कल्यस्तावच्छ्रेयः समाचरेत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2122844, "chapter_id": 3636, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2122845, "chapter_id": 3636, "verse_number": "१२", "content_sanskrit": "सर्वथा पुत्र बलिभिर्विग्रहस्तैर्न रोचते ।\nवैरं विकोशं सृजति तद्वै शस्त्रमनायसम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2122846, "chapter_id": 3636, "verse_number": "", "content_sanskrit": "अनर्थमर्थं मन्यसे राजपुत्र सङ्ग्रन्थितं कलहं चापि घोरम् ।\nतद्वै प्रवृत्तं तु यथाकथञ्चित् विमोक्षयेच्चाप्यसिसायकांश्च ॥१३", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2122847, "chapter_id": 3636, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2122848, "chapter_id": 3636, "verse_number": "१४", "content_sanskrit": "द्यूते पुराणैर्व्यवहारः प्रणीतः\nतत्रात्ययो नास्ति न सम्प्रहारः ।\nतद् रोचतां ते शकुनेर्वाक्यमद्य\nसभां क्षिप्रं त्वमिहाज्ञापयस्व ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2122849, "chapter_id": 3636, "verse_number": "१५", "content_sanskrit": "स्वर्गद्वारं दीव्यतां नो विशिष्टं\nतद्वर्तिनां चापि तथैव युक्तम् ।\nभवेदेवं ह्यात्मना तुल्यमेव\nदुरोदरं पाण्डवैस्त्वं कुरुष्व ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2122850, "chapter_id": 3636, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2122851, "chapter_id": 3636, "verse_number": "१६", "content_sanskrit": "वाक्यं न मे रोचते यत् त्वयोक्तं\nयत् ते प्रियं क्रियतां तन्नरेन्द्र ।\nपश्चात् त्वं तप्यसे चातिक्रम्य\nवाक्यं न हीदृशंभावि चाद्य प्रयुक्तम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2122852, "chapter_id": 3636, "verse_number": "१७", "content_sanskrit": "दृष्टं ह्येतद् विदुरेणैव सर्वं\nविपश्चिता बुद्धिविद्यानुगेन ।\nतदेवैतदयशस्याभ्युपैति\nमहद् भयं क्षत्रियबीजघाति ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2122853, "chapter_id": 3636, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2122854, "chapter_id": 3636, "verse_number": "१८", "content_sanskrit": "इत्येवमुक्त्वा धृतराष्ट्रो मनीषी\nदैवं मत्वा परमं दुस्तरं च ।\nशशासोच्चैः पुरुषान् पुत्रवाक्ये\nस्थितो राजा दैवसम्मूढचेताः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2122855, "chapter_id": 3636, "verse_number": "१९", "content_sanskrit": "सहस्रस्थूणां हेमवैडूर्यचित्रां\nशतद्वारां स्फाटिकतोरणाग्राम् ।\nसभामग्र्यां क्रोशमात्रायतां मे\nएतद्विस्तारामाशु कुर्वन्तु युक्ताः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2122856, "chapter_id": 3636, "verse_number": "२०", "content_sanskrit": "श्रुत्वा तस्य त्वरिता निर्विशङ्काः\nप्राज्ञा दक्षास्तां तथा चक्रुराज्ञाम् ।\nसर्वद्रव्याण्युपजह्रुः सभायाः\nसहस्रशः शिल्पिनश्चापि युक्ताः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2122857, "chapter_id": 3636, "verse_number": "२१", "content_sanskrit": "कालेनाल्पेनाथ निष्ठां गतां तां\nसभां रम्यां बहुरत्नां विचित्राम् ।\nचित्रैर्हैमैरासनैरभ्युपेताम्\nआचख्युस्ते तस्य राज्ञः प्रतीताः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2122858, "chapter_id": 3636, "verse_number": "२२", "content_sanskrit": "ततो विद्वान् विदुरं मन्त्रिमुख्यम्\nउवाचेदं धृतराष्ट्रो नरेन्द्रः ।\nयुधिष्ठिरं राजपुत्रं हि गत्वा\nमद्वाक्येन क्षिप्रमिहानयस्व ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2122859, "chapter_id": 3636, "verse_number": "२३", "content_sanskrit": "सभेयं मे बहुरत्ना विचित्रा ।\nशय्यासनैरुपपन्ना महार्हैः ।\nसा दृश्यतां भ्रातृभिः सार्धमेत्य\nसुहृद्द्यूतं वर्ततामत्र चैत्य ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2122860, "chapter_id": 3636, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2122861, "chapter_id": 3636, "verse_number": "२४", "content_sanskrit": "मतमाज्ञाय पुत्रस्य धृतराष्ट्रः प्रतापवान् ।\nमत्वा च दुस्तरं दैवमेतद् राजा चकार ह ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2122862, "chapter_id": 3636, "verse_number": "२५", "content_sanskrit": "अग्रजेन तथोक्तस्तु विदुरो विदुषां वरः ।\nनाभ्यनन्दद् वचो भ्रातुर्वचनं चेदमब्रवीत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2122863, "chapter_id": 3636, "verse_number": "२६", "content_sanskrit": "नाभिनन्दामि नृपते प्रेषणं ते\nमैवं कृथाः कुलनाशाद् विभेमि ।\nपुत्रैर्भिन्नैः कलहस्ते ध्रुवं स्यात्\nएवं शङ्के द्यूतकृते नरेन्द्र ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2122864, "chapter_id": 3636, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2122865, "chapter_id": 3636, "verse_number": "२७", "content_sanskrit": "नैव क्षत्तः कलहस्तस्य वै मे\nन चेद् दैवं प्रतिलोमं भविष्यत् ।\nधात्रा तु दिष्टस्य वशे किलेदं\nसर्वं जगच्चेष्टते न स्वतन्त्रम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2122866, "chapter_id": 3636, "verse_number": "२८", "content_sanskrit": "तदद्य विदुर प्राप्य राजानं मम शासनात् ।\nक्षिप्रमानय दुर्धर्षं कुन्तीपुत्रं युधिष्ठिरम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2122867, "chapter_id": 3636, "verse_number": "१०", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि अष्टसप्ततितमोऽध्यायः ॥७८॥\n॥ द्यूतपर्वणि दशमोऽध्यायः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2122868, "chapter_id": 3636, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]