[{"id": 7001036000, "chapter_id": 21036, "verse_number": "५-१८-१", "content_sanskrit": "चिन्तयन्निति गोविन्दमुपागम्य स यादवः ।\nअक्रूरोऽस्मीति चरणौ ननाम शिरसा हरेः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001036001, "chapter_id": 21036, "verse_number": "५-१८-२", "content_sanskrit": "सोऽप्येनं ध्वजवज्राब्ज-कृतचिह्नने पाणिना ।\nसंस्पृश्याकृष्य च प्रीत्या सुगाढं परिषस्वजे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001036002, "chapter_id": 21036, "verse_number": "५-१८-३", "content_sanskrit": "कृतसंवादनौ तेन यथावदू बल-केशवौ ।\nततः प्रविष्टौ संह्टष्टौ तमादायात्ममन्दिरम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001036003, "chapter_id": 21036, "verse_number": "५-१८-४", "content_sanskrit": "सह ताभ्यां तदाक्रूरः कृतसंवादनादिकः ।\nभुक्तभोज्यो यथान्यायमाचचक्षे ततस्तयोः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001036004, "chapter_id": 21036, "verse_number": "५-१८-५", "content_sanskrit": "यथा निर्भर्तूस्यते तेन कसेनानकदुन्दुभिः ।\nयथा च देवकी देवी दानवेन दुरात्मना ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001036005, "chapter_id": 21036, "verse_number": "५-१८-६", "content_sanskrit": "उग्रसेने यथा कंसः सुदुरात्मा च वर्त्तते।\nयं चैवार्थं समुद्दिश्य स ससेन विसर्ज्जितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001036006, "chapter_id": 21036, "verse_number": "५-१८-७", "content_sanskrit": "तत् सर्व्वं विस्तराच्छ्रु त्वा भगवान् केशिसूदनः ।\nउवाचाखिलमप्येतजूज्ञातं दानपते!मया ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001036007, "chapter_id": 21036, "verse_number": "५-१८-८", "content_sanskrit": "करिष्ये च महाभाग!यदत्रौपयिकं मतम् ।\nविचिन्त्यं नान्यथैतत् ते विद्धि कंसं हतं मया ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001036008, "chapter_id": 21036, "verse_number": "५-१८-९", "content_sanskrit": "अहं रामश्व मथुरा श्वो यास्यावः समं त्वया ।\nगोपवृद्धाश्व यास्यन्ति आदायोपायनं बहु ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001036009, "chapter_id": 21036, "verse_number": "५-१८-१०", "content_sanskrit": "निशेयं नीयतां वीर!न चिन्तां कर्त्तुमर्हसि ।\nत्रिरात्राभ्यन्तरे कंसं हनिष्यामि सहानुगम ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001036010, "chapter_id": 21036, "verse_number": "५-१८-११", "content_sanskrit": "समादिश्य ततो गोपानक्रु रोऽपि सकेशवः ।\nसुष्वाप बलभद्रश्व नन्दगोपगृहे सुखम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001036011, "chapter_id": 21036, "verse_number": "५-१८-१२", "content_sanskrit": "ततः प्रभाते विमले कृष्ण-रामौ महामती ।\nअक्रूरेण समं गन्तुमुद्यतौ मथुरां प्रित ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001036012, "chapter_id": 21036, "verse_number": "५-१८-१३", "content_sanskrit": "दृष्ट्वा गोपीजनः सास्त्रः श्लथदूवलयबाहुकः ।\nनिः श्वस्य चातिदुः खार्त्तः प्राह चेदं परस्परम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001036013, "chapter_id": 21036, "verse_number": "५-१८-१४", "content_sanskrit": "मथुरां प्राप्य गोविन्दः कथं गोकुलमेष्यति ।\nनागरस्त्री-कलालापमधु श्रोत्रेण पास्यति ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001036014, "chapter_id": 21036, "verse_number": "५-१८-१५", "content_sanskrit": "विलासिवाक्यपानेषु नागरीणां कृतास्पदम् ।\nचित्तमस्य कथ भूयो ग्राम्यगोपीषु यास्यति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001036015, "chapter_id": 21036, "verse_number": "५-१८-१६", "content_sanskrit": "सारं समस्तगोष्ठस्य विधिना हरता हरिम् ।\nप्रह्टतं गोपयोषितूसु निर्गुणेन दुरात्मना ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001036016, "chapter_id": 21036, "verse_number": "५-१८-१७", "content_sanskrit": "भावगर्भस्मितं वाक्यं विलासललिता गतिः ।\nनागरीणामतीवैतत् कटाक्षैक्षितमेव च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001036017, "chapter_id": 21036, "verse_number": "५-१८-१८", "content_sanskrit": "ग्राम्यो हरिरयं तासां विलासनिगड़ैर्युतः ।\nभवतीनां पुनः पाश्व कया युत्तया समेष्यति ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001036018, "chapter_id": 21036, "verse_number": "५-१८-१९", "content_sanskrit": "एषैष रथमारुह्य मथुरां याति केशवः ।\nक्रूरेणाक्रू रकेणात्र निराशेन प्रतारितः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001036019, "chapter_id": 21036, "verse_number": "५-१८-२०", "content_sanskrit": "किं न वेत्ति नृशंसोऽत्र अनुरागपरं जनम् ।\nयेनेममक्ष्णोराह्लादं नयत्यन्यत्र नो हरिम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001036020, "chapter_id": 21036, "verse_number": "५-१८-२१", "content_sanskrit": "एश रामेण सहितः प्रयात्यत्यन्तनिर्घृणः ।\nरथमारुह्य गोविन्दस्त्वर्य्यतामस्य वारणो ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001036021, "chapter_id": 21036, "verse_number": "५-१८-२२", "content_sanskrit": "गुरूणामग्रतो वक्तुं किं ब्रवपीषि न नः क्षमम् ।\nगुरवः किं करिष्यन्ति दग्धानां विरहाग्रिना ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001036022, "chapter_id": 21036, "verse_number": "५-१८-२३", "content_sanskrit": "नन्दगोपमुखा गोपा गन्तुमेते समुद्यताः ।\nनोद्यमं कुरुते कश्विदू गोविन्दविनिवर्त्तने ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001036023, "chapter_id": 21036, "verse_number": "५-१८-२४", "content_sanskrit": "सुप्रभाताद्य रजनी मथुरावासियोषिताम् ।\nपास्यन्त्यच्युतवक्ताब्जां यासां नेत्रालिपङूक्तयः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001036024, "chapter_id": 21036, "verse_number": "५-१८-२५", "content_sanskrit": "धन्यास्ते पथि ये कृष्णामितो यान्त्यनिवारिताः ।\nउदूहिष्यन्ति पश्यन्तः स्वदेहं पुलकाञ्चितम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001036025, "chapter_id": 21036, "verse_number": "५-१८-२६", "content_sanskrit": "मथुरानगरीपौरनयनानां महोतूसवः ।\nगोविन्दावयवैर्दृष्टरतीवाद्य भविष्यति ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001036026, "chapter_id": 21036, "verse_number": "५-१८-२७", "content_sanskrit": "को नु स्वप्रः सुभाग्याभिर्दृष्टस्ताभिरधोक्षजम् ।\nविस्तारिकान्तिनयना या द्रक्ष्यन्त्यनिवारितम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001036027, "chapter_id": 21036, "verse_number": "५-१८-२८", "content_sanskrit": "अहो गोपीजनस्यास्य दर्शयित्वा महानिधिम् ।\nउद्धृतान्यत्र नेत्राणि विधात्राकरुणात्मना ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001036028, "chapter_id": 21036, "verse_number": "५-१८-२९", "content_sanskrit": "अनुरागेण शैथिल्यमस्मासु व्रजता हरेः!\nशैथिल्यमुपयान्त्याशु करेषु वलयान्यपि ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001036029, "chapter_id": 21036, "verse_number": "५-१८-३०", "content_sanskrit": "अक्रूरः क्रूरह्टदयः शीघ्र प्रेरयते हयान् ।\nएवमार्त्तासु योषित्सु घृणा कस्य न जायते ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001036030, "chapter_id": 21036, "verse_number": "५-१८-३१", "content_sanskrit": "हा हा कृष्णरथस्योच्चैश्व क्ररेणुर्निरीक्ष्यताम् ।\nदूरीकृतो हरिर्येन सोऽपि रेणुर्न लक्ष्यते ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001036031, "chapter_id": 21036, "verse_number": "५-१८-३२", "content_sanskrit": "इत्येवमतिहार्द्दन गोपीजननिरीक्षितः ।\nतत्याज व्रजभूभागं सह रामेण केशवः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001036032, "chapter_id": 21036, "verse_number": "५-१८-३३", "content_sanskrit": "गच्छन्तो जविताश्वेन रथेन यमुनातटम् ।\nप्राप्ता मध्याह्नसमये रामाक्रू रजनार्द्दनाः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001036033, "chapter_id": 21036, "verse_number": "५-१८-३४", "content_sanskrit": "अथाह कृष्णमक्रूरो भवद्भयां तावदास्यताम् ।\nयावत् करोमि कालिन्द्यामाह्निकार्हणमम्भसि ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001036034, "chapter_id": 21036, "verse_number": "५-१८-३५", "content_sanskrit": "तथेत्युक्तं ततः स्त्रातः स्वाचान्तः स महामतिः ।\nदध्यौ ब्रह्म परं विप्र!प्रविश्य यमुनाजले ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001036035, "chapter_id": 21036, "verse_number": "५-१८-३६", "content_sanskrit": "फणासहस्त्रमालाञय बलभद्र ददर्श सः ।\nकुन्दमालाङ्गमुन्निद्र-पद्मपत्रारुणोक्षणम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001036036, "chapter_id": 21036, "verse_number": "५-१८-३७", "content_sanskrit": "वृतं वासुकिरम्भाद्यैर्महद्भिः पवनाशिभिः ।\nसंस्तूयमानं गन्धर्वैर्वनमालाविभूषितम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001036037, "chapter_id": 21036, "verse_number": "५-१८-३८", "content_sanskrit": "दधानमसिते वस्त्रे चारुपद्मावतंसकम् ।\nचारुकुण्डलिनं भान्तमन्तर्जलतले स्थितम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001036038, "chapter_id": 21036, "verse_number": "५-१८-३९", "content_sanskrit": "तस्योतूसङ्ग घनश्याममाताम्रायतलोचनम् ।\nचतुर्बाहुमुदाराङ्ग चक्राद्यायुधभूषणम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001036039, "chapter_id": 21036, "verse_number": "५-१८-४०", "content_sanskrit": "पीते वसानं वसने चित्रमाल्य-विभूषणाम् ।\nशक्रचापतड़िन्माला-विचित्रमिव तोयदम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001036040, "chapter_id": 21036, "verse_number": "५-१८-४१", "content_sanskrit": "श्रीवत्सवक्षसञ्चारुकेयूरमुकुटोज्जवलम् ।\nददर्श कृष्णमक्लिष्ट-पुण्डरीकावतंसकम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001036041, "chapter_id": 21036, "verse_number": "५-१८-४२", "content_sanskrit": "सनन्दनाद्यैर्मुनिभिः सिद्धयोगैरकल्मषैः ।\nविचिन्त्यमानं तत्रस्थैर्नासाग्रन्यस्तलोचनैः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001036042, "chapter_id": 21036, "verse_number": "५-१८-४३", "content_sanskrit": "बल-कृष्णौ तथाक्रूरः प्रत्यभिज्ञाय विस्मितः ।\nसोऽचिन्तयदू रथाच्छीघ्रं कथमत्रागताविति ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001036043, "chapter_id": 21036, "verse_number": "५-१८-४४", "content_sanskrit": "विवक्षोः स्तम्भयामास वाचं तस्य जनार्द्दनः ।\nततो निष्कम्य सलिलादू रथमभ्यागतः पुनः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001036044, "chapter_id": 21036, "verse_number": "५-१८-४५", "content_sanskrit": "ददर्श तत्र चैवोभौ रथस्योपर्य्यधिष्ठितौ ।\nराम-कृष्णौ यथापूर्व्वं मनुष्यवपुषान्वितौ ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001036045, "chapter_id": 21036, "verse_number": "५-१८-४६", "content_sanskrit": "निमग्रश्व ततस्तोये स ददर्ख तथैव तौ ।\nसंस्तूयमानौ गन्धर्व्व-मुनि-सिद्ध-महोरगैः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001036046, "chapter_id": 21036, "verse_number": "५-१८-४७", "content_sanskrit": "ततो विज्ञातसद्भावः स तु दानपतिस्तथा ।\nतुष्टाव सर्व्वविज्ञानमयमच्युतमीश्वरम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001036047, "chapter_id": 21036, "verse_number": "५-१८-४८", "content_sanskrit": "सन्मात्ररूपिणेऽचिन्त्यमहिम्ने परमात्मने ।\nव्यापिने नैकरूपैकखरूपाय नमो नमः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001036048, "chapter_id": 21036, "verse_number": "५-१८-४९", "content_sanskrit": "सत्त्वरूपाय तेऽचिन्त्य! हविर्भूताय ते नमः ।\nनमोऽविज्ञातपाराय पराय प्रकृतेः प्रभो ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001036049, "chapter_id": 21036, "verse_number": "५-१८-५०", "content_sanskrit": "भूतात्मा चेन्द्रियात्मा च प्रधानात्मा तथा भवान् ।\nआत्मा च परमात्मा च त्वमेकः पञ्चधा स्थितः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001036050, "chapter_id": 21036, "verse_number": "५-१८-५१", "content_sanskrit": "प्रसीद सर्व्व सर्व्वात्मन् क्षराक्षरमयेश्वर ।\nब्रह्म-विष्णु-शिव्राद्याभिः कल्पनाभिरुदीरितः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001036051, "chapter_id": 21036, "verse_number": "५-१८-५२", "content_sanskrit": "अनाख्येयखरूपात्मन्!अनाख्येयप्रयोजन!\nअनाख्येयाभिधानं त्वां नतोऽस्मि परमेश्वर ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001036052, "chapter_id": 21036, "verse_number": "५-१८-५३", "content_sanskrit": "न यत्र-नाथ!विद्यन्ते नामजात्यादिकल्पनाः ।\nतदू ब्रह्म परमं नित्यमविकारि भवानजः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001036053, "chapter_id": 21036, "verse_number": "५-१८-५४", "content_sanskrit": "न कल्पनामृतेऽर्थस्य सर्व्वस्याधिगमो यतः ।\nततः कृष्णाच्युतानन्तबिष्णुसंज्ञाभिरीडयसे ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001036054, "chapter_id": 21036, "verse_number": "५-१८-५५", "content_sanskrit": "सर्व्वार्थस्त्वमज! विकल्पनाभिरेतदू दवाद्य जगदखिलं त्वमेव विश्वम् ।\nविश्वात्मंस्त्वमिति विकारभावहीनः सर्व्वस्मिन् न हि भबतोऽस्ति ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001036055, "chapter_id": 21036, "verse_number": "५-१८-५६", "content_sanskrit": "न्यत् त्वं ब्रह्मा पशुपतिरर्य्यमा विधाता धाता त्वं त्रिदशपतिः समीरणोऽग्रिः ।\nतोयेशो धनपतिरन्तकस्त्वमेको भिन्नार्थैर्जगदपि पासि शक्तिभेदैः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001036056, "chapter_id": 21036, "verse_number": "५-१८-५७", "content_sanskrit": "विश्वं भवान् सृजति सूर्य्यगभस्तिरूपोविश्वञ्च ते गुणमयोऽयमज! प्रपञ्चः ।\nरूपं परं सदितिवाचकमक्षरं यजज्ञानात्मने सदसते प्रणातोऽस्मि तस्मै ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001036057, "chapter_id": 21036, "verse_number": "५-१८-५८", "content_sanskrit": "अँनमो वासुदेवाय नमः सङ्कर्षणाय ते ।\nप्रद्यु म्राय नमस्तुभ्यमनिरुद्धाय ते नमः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]