[{"id": 7000400000, "chapter_id": 20400, "verse_number": "२-७२-१", "content_sanskrit": "पिप्पल उवाच ।\nमातलेश्च वचः श्रुत्वा स राजा नहुषात्मजः ।\nकिं चकार महाप्राज्ञस्तन्मे विस्तरतो वद॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000400001, "chapter_id": 20400, "verse_number": "२-७२-२", "content_sanskrit": "सर्वपुण्यमयी पुण्या कथेयं पापनाशिनी ।\nश्रोतुमिच्छाम्यहं प्राज्ञ नैव तृप्यामि सर्वदा॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000400002, "chapter_id": 20400, "verse_number": "२-७२-३", "content_sanskrit": "सुकर्मोवाच ।\nसर्वधर्मभृतां श्रेष्ठो ययातिर्नृपसत्तमः ।\nतमुवाचागतं दूतं मातलिं शक्रसारथिम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000400003, "chapter_id": 20400, "verse_number": "२-७२-४", "content_sanskrit": "ययातिरुवाच ।\nशरीरं नैव त्यक्ष्यामि गमिष्ये न दिवं पुनः ।\nशरीरेण विना दूत पार्थिवेन न संशयः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000400004, "chapter_id": 20400, "verse_number": "२-७२-५", "content_sanskrit": "यद्यप्येवं महादोषाः कायस्यैव प्रकीर्तिताः ।\nपूर्वं चापि समाख्यातं त्वया सर्वं गुणागुणम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000400005, "chapter_id": 20400, "verse_number": "२-७२-६", "content_sanskrit": "नाहं त्यक्ष्ये शरीरं वै नागमिष्ये दिवं पुनः ।\nइत्याचक्ष्व इतो गत्वा देवदेवं पुरंदरम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000400006, "chapter_id": 20400, "verse_number": "२-७२-७", "content_sanskrit": "एकाकिना हि जीवेन कायेनापि महामते ।\nनैव सिद्धिं प्रयात्येवं सांसारिकमिहैव हि॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000400007, "chapter_id": 20400, "verse_number": "२-७२-८", "content_sanskrit": "नैव प्राणं विना कायो जीवः कायं विना नहि ।\nउभयोश्चापि मित्रत्वं नयिष्ये नाशमिंद्र न॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000400008, "chapter_id": 20400, "verse_number": "२-७२-९", "content_sanskrit": "यस्य प्रसादभावाद्वै सुखमश्नाति केवलम् ।\nशरीरस्याप्ययं प्राणो भोगानन्यान्मनोनुगान्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000400009, "chapter_id": 20400, "verse_number": "२-७२-१०", "content_sanskrit": "एवं ज्ञात्वा स्वर्गभोग्यं न भोज्यं देवदूतक ।\nसंभवंति महादुष्टा व्याधयो दुःखदायकाः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000400010, "chapter_id": 20400, "verse_number": "२-७२-११", "content_sanskrit": "मातले किल्बिषाच्चैव जरादोषात्प्रजायते ।\nपश्य मे पुण्यसंयुक्तं कायं षोडशवार्षिकम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000400011, "chapter_id": 20400, "verse_number": "२-७२-१२", "content_sanskrit": "जन्मप्रभृति मे कायः शतार्धाब्दं प्रयाति च ।\nतथापि नूतनो भावः कायस्यापि प्रजायते॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000400012, "chapter_id": 20400, "verse_number": "२-७२-१३", "content_sanskrit": "मम कालो गतो दूत अब्दा प्रनंत्यमनुत्तमम् ।\nयथा षोडशवर्षस्य कायः पुंसः प्रशोभते॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000400013, "chapter_id": 20400, "verse_number": "२-७२-१४", "content_sanskrit": "तथा मे शोभते देहो बलवीर्यसमन्वितः ।\nनैव ग्लानिर्न मे हानिर्न श्रमो व्याधयो जरा॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000400014, "chapter_id": 20400, "verse_number": "२-७२-१५", "content_sanskrit": "मातले मम कायेपि धर्मोत्साहेन वर्द्धते ।\nसर्वामृतमयं दिव्यमौषधं परमौषधम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000400015, "chapter_id": 20400, "verse_number": "२-७२-१६", "content_sanskrit": "पापव्याधिप्रणाशार्थं धर्माख्यं हि कृतम्पुरा ।\nतेन मे शोधितः कायो गतदोषस्तु जायते॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000400016, "chapter_id": 20400, "verse_number": "२-७२-१७", "content_sanskrit": "हृषीकेशस्य संध्यानं नामोच्चारणमुत्तमम् ।\nएतद्रसायनं दूत नित्यमेवं करोम्यहम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000400017, "chapter_id": 20400, "verse_number": "२-७२-१८", "content_sanskrit": "तेन मे व्याधयो दोषाः पापाद्याः प्रलयं गताः ।\nविद्यमाने हि संसारे कृष्णनाम्नि महौषधे॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000400018, "chapter_id": 20400, "verse_number": "२-७२-१९", "content_sanskrit": "मानवा मरणं यांति पापव्याधि प्रपीडिताः ।\nन पिबंति महामूढाः कृष्ण नाम रसायनम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000400019, "chapter_id": 20400, "verse_number": "२-७२-२०", "content_sanskrit": "तेन ध्यानेन ज्ञानेन पूजाभावेन मातले ।\nसत्येन दानपुण्येन मम कायो निरामयः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000400020, "chapter_id": 20400, "verse_number": "२-७२-२१", "content_sanskrit": "पापर्द्धेरामयाः पीडाः प्रभवंति शरीरिणः ।\nपीडाभ्यो जायते मृत्युः प्राणिनां नात्र संशयः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000400021, "chapter_id": 20400, "verse_number": "२-७२-२२", "content_sanskrit": "तस्माद्धर्मः प्रकर्तव्यः पुण्यसत्याश्रयैर्नरैः ।\nपंचभूतात्मकः कायः शिरासंधिविजर्जरः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000400022, "chapter_id": 20400, "verse_number": "२-७२-२३", "content_sanskrit": "एवं संधीकृतो मर्त्यो हेमकारीव टंकणैः ।\nतत्र भाति महानग्निर्द्धातुरेव चरः सदा॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000400023, "chapter_id": 20400, "verse_number": "२-७२-२४", "content_sanskrit": "शतखंडमये विप्र यः संधत्ते सबुद्धिमान् ।\nहरेर्नाम्ना च दिव्येन सौभाग्येनापि पिप्पल॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000400024, "chapter_id": 20400, "verse_number": "२-७२-२५", "content_sanskrit": "पंचात्मका हि ये खंडाः शतसंधिविजर्जराः ।\nतेन संधारिताः सर्वे कायो धातुसमो भवेत्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000400025, "chapter_id": 20400, "verse_number": "२-७२-२६", "content_sanskrit": "हरेः पूजोपचारेण ध्यानेन नियमेन च ।\nसत्यभावेन दानेन नूत्नः कायो विजायते॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000400026, "chapter_id": 20400, "verse_number": "२-७२-२७", "content_sanskrit": "दोषा नश्यंति कायस्य व्याधयः शृणु मातले ।\nबाह्याभ्यंतरशौचं हि दुर्गंधिर्नैव जायते॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000400027, "chapter_id": 20400, "verse_number": "२-७२-२८", "content_sanskrit": "शुचिस्ततो भवेत्सूत प्रसादात्तस्य चक्रिणः ।\nनाहं स्वर्गं गमिष्यामि स्वर्गमत्र करोम्यहम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000400028, "chapter_id": 20400, "verse_number": "२-७२-२९", "content_sanskrit": "तपसा चैव भावेन स्वधर्मेण महीतलम् ।\nस्वर्गरूपं करिष्यामि प्रसादात्तस्य चक्रिणः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000400029, "chapter_id": 20400, "verse_number": "२-७२-३०", "content_sanskrit": "एवं ज्ञात्वा प्रयाहि त्वं कथयस्व पुरंदरम् ।\nसुकर्मोवाच ।\nसमाकर्ण्य ततः सूतो नृपतेः परिभाषितम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000400030, "chapter_id": 20400, "verse_number": "२-७२-३१", "content_sanskrit": "आशीर्भिरभिनंद्याथ आमंत्र्य नृपतिं गतः ।\nसर्वं निवेदयामास इंद्राय च महात्मने॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000400031, "chapter_id": 20400, "verse_number": "२-७२-३२", "content_sanskrit": "समाकर्ण्य सहस्राक्षो ययातेस्तु महात्मनः ।\nतस्याथ चिंतयामासानयनार्थं दिवं प्रति॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]