[{"id": 40016590, "chapter_id": 9249, "verse_number": "1", "content_sanskrit": "ततोरामोमहातेजाधनुरादायवीर्यवान् । किरीटिनंमहाकायंकुम्भकर्णंददर्श ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40016591, "chapter_id": 9249, "verse_number": "2", "content_sanskrit": "तंदृष्टवाराक्षसश्रेष्ठंपर्वताकारदर्शनम् । क्रममाणमिवाकाशंपुरानारायणंप्रभुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40016592, "chapter_id": 9249, "verse_number": "3", "content_sanskrit": "सतोयाम्बुदसङ्काशंकाञ्चनाङ्गदभूषणम् । दृष्टवापुनःप्रदुद्रवावानराणांमहाचमूः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40016593, "chapter_id": 9249, "verse_number": "4", "content_sanskrit": "विद्रुतांवाहिनींदृष्टवावर्धमानं च राक्षसम् । सविस्मयमिदंरामोविभीषणमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40016594, "chapter_id": 9249, "verse_number": "5", "content_sanskrit": "कोऽसौपर्वतसङ्काशःकिरीटीहरिलोचनः । लङ्कायांदृश्यतेवीरःसविद्युदिवतोयदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40016595, "chapter_id": 9249, "verse_number": "6", "content_sanskrit": "पृथिव्यांकेतुभूतोऽसौमहानेकोऽत्रदृश्यते । यंदृष्टवावानरास्सर्वेविद्रवन्तिततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40016596, "chapter_id": 9249, "verse_number": "7", "content_sanskrit": "आचक्षवसुमहान् कोऽसौरक्षोवायदिवाऽसुरः । न मयैवंविधंभूतंदृष्टपूर्वंकदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40016597, "chapter_id": 9249, "verse_number": "8", "content_sanskrit": "संपृष्टोराजपुत्रेणरामेणाक्लिष्टकर्मणा । विभीषणोमहाप्राज्ञःकाकुत्थ्समिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40016598, "chapter_id": 9249, "verse_number": "9", "content_sanskrit": "येनवैवस्वतोयुद्धेवासवश्चपराजितः । सैषविश्रवसःपुत्रःकुम्भकर्णःप्रतापवान् ॥ अस्यप्रमाणसदृशोराक्षसाऽन्यो न विद्यते ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40016599, "chapter_id": 9249, "verse_number": "10", "content_sanskrit": "एतेनदेवायुधिदानवाश्चयक्षाभुजङ्गाःपिशिताशनाश्च । गन्धर्वविद्याधरकिन्नरैश्चसहस्रशोराघवसम्प्रभग्नाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40016600, "chapter_id": 9249, "verse_number": "11", "content_sanskrit": "शूलपाणिंविरूपाक्षंकुम्भकर्णंमहाबलम् । हन्तुं न शेकुस्त्रिदशाःकालोऽयमितिमोहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40016601, "chapter_id": 9249, "verse_number": "12", "content_sanskrit": "प्रकृत्याह्येषतेजस्वीकुम्भकर्णोमहाबलः । अन्येषांराक्षसेन्द्राणांवरदानकृतंबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40016602, "chapter_id": 9249, "verse_number": "13", "content_sanskrit": "एतेनजातमात्रेणक्षुधार्तेनमहात्मना । भक्षितानिसहस्राणिसत्त्वानांसुबहून्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40016603, "chapter_id": 9249, "verse_number": "14", "content_sanskrit": "तेषुसंभक्षयमाणेषुप्रजाभयनिपीडिताः । यान्तिस्मशरणंशक्रंतमप्यर्थंन्यवेदयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40016604, "chapter_id": 9249, "verse_number": "15", "content_sanskrit": "सकुन्भकर्णंकुपितोमहेन्द्रोजघानवज्रेणशितेनवज्री । सशक्रवज्राभिहतोमहात्माचचालकोपाच्चभृशंननाद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40016605, "chapter_id": 9249, "verse_number": "16", "content_sanskrit": "तस्यनानद्यमानस्यकुम्भकर्णस्यरक्षसः । श्रुत्वानिनादंवित्रस्ताःभूमिभूयोवितत्रसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40016606, "chapter_id": 9249, "verse_number": "17", "content_sanskrit": "तत्रकोपान्महेन्द्रस्यकुम्भकर्णोमहाबलः । विकृष्यैरावताद्धन्तंजघानोरसिवासवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40016607, "chapter_id": 9249, "verse_number": "18", "content_sanskrit": "कुम्भकर्णप्रहारार्तोविजज्वाल स वासवः । ततोविषेदुस्सहसादेवाब्रह्मर्षिदानवाः ॥ प्रजाभिस्सहशक्रश्चययौस्थानंस्वयम्भुवः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40016608, "chapter_id": 9249, "verse_number": "19", "content_sanskrit": "कुम्भकर्णस्यदौरात्म्यंशशंसुस्तेप्रजापतेः ॥ प्रजानांभक्षणंचापिधर्षणं च दिवौकसाम् । आश्रमध्वंसनंचापिपरस्त्रीहरणंभृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40016609, "chapter_id": 9249, "verse_number": "20", "content_sanskrit": "कुम्भकर्णस्यदौरात्म्यंशशंसुस्तेप्रजापतेः ॥ प्रजानांभक्षणंचापिधर्षणं च दिवौकसाम् । आश्रमध्वंसनंचापिपरस्त्रीहरणंभृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40016610, "chapter_id": 9249, "verse_number": "21", "content_sanskrit": "एवंप्रजायदित्वेषभक्षयिष्यतिनित्यशः । अचिरेणैवकालेनशून्योलोकोभविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40016611, "chapter_id": 9249, "verse_number": "22", "content_sanskrit": "वासवस्यवचश्श्रुत्वासर्वलोकपितामहः । रक्षांस्यावाहयामासकुम्भकर्णंददर्श ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40016612, "chapter_id": 9249, "verse_number": "23", "content_sanskrit": "कुम्भकर्णंसमीक्ष्यैववितत्रासप्रजापतिः । दृष्टवाविश्वास्यचैवैनंस्वयम्भूरिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40016613, "chapter_id": 9249, "verse_number": "24", "content_sanskrit": "ध्रुवंलोकविनाशायपौलस्त्येनासिनिर्मितः । तस्मात्त्वमद्यप्रभृतिमृतकल्पःशयिष्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40016614, "chapter_id": 9249, "verse_number": "25", "content_sanskrit": "ब्रह्मशापाभिभूतोऽथनिपपाताग्रतःप्रभोः । ततःपरमसम्भ्रान्तोरावणोवाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40016615, "chapter_id": 9249, "verse_number": "26", "content_sanskrit": "विवृद्धःकाञ्चनोवृक्षःफलकालेनिकृत्यते । न नप्तारंस्वकंन्यायंशप्तुमेवंप्रजापते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40016616, "chapter_id": 9249, "verse_number": "27", "content_sanskrit": "न मिथ्यावचनश्चत्वंस्वप्स्यत्येष न संशयः । कालस्तुक्रियतामस्यशयनेजागरेतथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40016617, "chapter_id": 9249, "verse_number": "28", "content_sanskrit": "रावणस्यवचश्श्रुत्वास्वयम्भूरिदमब्रवीत् । शयिताह्येषषण्मासानेकाहंजागरिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40016618, "chapter_id": 9249, "verse_number": "29", "content_sanskrit": "एकेनाह्नात्वसौवीरश्चरन् भूमिंबुभुक्षितः । व्यात्तास्योभक्षयेल्लोकान् सङ्कृद्धइवपावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40016619, "chapter_id": 9249, "verse_number": "30", "content_sanskrit": "सोऽसौव्यसमापन्नःकुम्भकर्णमबोधयत् । त्वत्पराक्रमभीतश्चराजासम्प्रतिरावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40016620, "chapter_id": 9249, "verse_number": "31", "content_sanskrit": "स एषनिर्गतोवीरःशिबिराद्भीमविक्रमः । वानरान्भृशसङ्कृद्धोभक्षयन्परिधावति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40016621, "chapter_id": 9249, "verse_number": "32", "content_sanskrit": "कुम्भकर्णंसमीक्ष्यैवहरयोऽद्यप्रविद्रुतुः । कथमेनंरणेक्रुद्धंवारयिष्यन्तिवानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40016622, "chapter_id": 9249, "verse_number": "33", "content_sanskrit": "उच्यन्तांवानराःसर्वेयन्त्रमेतत्समुच्छ्रितम् । इतिविज्ञायहरयोभविष्यन्तीहनिर्भयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40016623, "chapter_id": 9249, "verse_number": "34", "content_sanskrit": "विभीषणवचश्श्रुत्वाहेतुमत्सुमुखेरितम् । उवाचराघवोवाक्यंनीलंसेनापतिंतदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40016624, "chapter_id": 9249, "verse_number": "35", "content_sanskrit": "गच्छसैन्यानिसर्वाणिव्यूह्यतिष्ठस्वपावके । द्वाराण्यादायलङ्कायाश्चर्याश्चाप्यथसङ्क्रमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40016625, "chapter_id": 9249, "verse_number": "36", "content_sanskrit": "शैलशृङ्गाणिवृक्षांश्चशिलाश्चाप्युपसंहर । तिष्ठन्तुसायुधास्सर्वेसायुधाश्शैलपाणयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40016626, "chapter_id": 9249, "verse_number": "37", "content_sanskrit": "राघवेणसमादिष्टोनीलोहरिचमूपतिः । शशासवानरानीकंयथावत्कपिकुञ्जरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40016627, "chapter_id": 9249, "verse_number": "38", "content_sanskrit": "ततोगवाक्षश्शरभोहनूमानङ्गदस्तथा । शैलशृङ्गाणिशैलाभागृहीत्वाद्वारमभ्ययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40016628, "chapter_id": 9249, "verse_number": "39", "content_sanskrit": "रामवाक्यमुपश्रुत्य हरयो जितकाशिनः । पादपैरर्दयवनीरावानराःपरवाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40016629, "chapter_id": 9249, "verse_number": "40", "content_sanskrit": "ततोहरीणांतदनीकमुग्रंरराजशैलोद्यतदीप्तहस्तम् । गिरेःसमीपानुगतंयथैवहन्महाम्भोधरजालमुग्रम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]