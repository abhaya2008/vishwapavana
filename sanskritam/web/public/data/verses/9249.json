[{"id": 5000249000, "chapter_id": 9249, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे त्रिपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000249001, "chapter_id": 9249, "verse_number": "३-५३-१", "content_sanskrit": "खमुत्पतन्तं तं दृष्ट्वा मैथिली जनकात्मजा।\nदुःखिता परमोद्विग्ना भये महति वर्तिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000249002, "chapter_id": 9249, "verse_number": "३-५३-२", "content_sanskrit": "रोषरोदनताम्राक्षी भीमाक्षं राक्षसाधिपम्।\nरुदती करुणं सीता ह्रियमाणा तमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000249003, "chapter_id": 9249, "verse_number": "३-५३-३", "content_sanskrit": "न व्यपत्रपसे नीच कर्मणानेन रावण।\nज्ञात्वा विरहितां यो मां चोरयित्वा पलायसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000249004, "chapter_id": 9249, "verse_number": "३-५३-४", "content_sanskrit": "त्वयैव नूनं दुष्टात्मन् भीरुणा हर्तुमिच्छता।\nममापवाहितो भर्ता मृगरूपेण मायया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000249005, "chapter_id": 9249, "verse_number": "३-५३-५", "content_sanskrit": "यो हि मामुद्यतस्त्रातुं सोऽप्ययं विनिपातितः।\nगृध्रराजः पुराणोऽसौ श्वशुरस्य सखा मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000249006, "chapter_id": 9249, "verse_number": "३-५३-६", "content_sanskrit": "परमं खलु ते वीर्यं दृश्यते राक्षसाधम।\nविश्राव्य नामधेयं हि युद्धे नास्मि जिता त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000249007, "chapter_id": 9249, "verse_number": "३-५३-७", "content_sanskrit": "ईदृशं गर्हितं कर्म कथं कृत्वा न लज्जसे।\nस्त्रियाश्चाहरणं नीच रहिते च परस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000249008, "chapter_id": 9249, "verse_number": "३-५३-८", "content_sanskrit": "कथयिष्यन्ति लोकेषु पुरुषाः कर्म कुत्सितम्।\nसुनृशंसमधर्मिष्ठं तव शौटीर्यमानिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000249009, "chapter_id": 9249, "verse_number": "३-५३-९", "content_sanskrit": "धिक् ते शौर्यं च सत्त्वं च यत्त्वया कथितं तदा।\nकुलाक्रोशकरं लोके धिक् ते चारित्रमीदृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000249010, "chapter_id": 9249, "verse_number": "३-५३-१०", "content_sanskrit": "किं शक्यं कर्तुमेवं हि यज्जवेनैव धावसि।\nमुहूर्तमपि तिष्ठ त्वं न जीवन् प्रतियास्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000249011, "chapter_id": 9249, "verse_number": "३-५३-११", "content_sanskrit": "नहि चक्षुःपथं प्राप्य तयोः पार्थिवपुत्रयोः।\nससैन्योऽपि समर्थस्त्वं मुहूर्तमपि जीवितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000249012, "chapter_id": 9249, "verse_number": "३-५३-१२", "content_sanskrit": "न त्वं तयोः शरस्पर्शं सोढुं शक्तः कथंचन।\nवने प्रज्वलितस्येव स्पर्शमग्नेर्विहंगमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000249013, "chapter_id": 9249, "verse_number": "३-५३-१३", "content_sanskrit": "साधु कृत्वाऽऽत्मनः पथ्यं साधु मां मुञ्च रावण।\nमत्प्रधर्षणसंक्रुद्धो भ्रात्रा सह पतिर्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000249014, "chapter_id": 9249, "verse_number": "३-५३-१४", "content_sanskrit": "विधास्यति विनाशाय त्वं मां यदि न मुञ्चसि।\nयेन त्वं व्यवसायेन बलान्मां हर्तुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000249015, "chapter_id": 9249, "verse_number": "३-५३-१५", "content_sanskrit": "व्यवसायस्तु ते नीच भविष्यति निरर्थकः।\nनह्यहं तमपश्यन्ती भर्तारं विबुधोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000249016, "chapter_id": 9249, "verse_number": "३-५३-१६", "content_sanskrit": "उत्सहे शत्रुवशगा प्राणान् धारयितुं चिरम्।\nन नूनं चात्मनः श्रेयः पथ्यं वा समवेक्षसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000249017, "chapter_id": 9249, "verse_number": "३-५३-१७", "content_sanskrit": "मृत्युकाले यथा मर्त्यो विपरीतानि सेवते।\nमुमूर्षूणां तु सर्वेषां यत् पथ्यं तन्न रोचते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000249018, "chapter_id": 9249, "verse_number": "३-५३-१८", "content_sanskrit": "पश्यामीह हि कण्ठे त्वां कालपाशावपाशितम्।\nयथा चास्मिन् भयस्थाने न बिभेषि निशाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000249019, "chapter_id": 9249, "verse_number": "३-५३-१९", "content_sanskrit": "व्यक्तं हिरण्मयांस्त्वं हि सम्पश्यसि महीरुहान्।\nनदीं वैतरणीं घोरां रुधिरौघविवाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000249020, "chapter_id": 9249, "verse_number": "३-५३-२०", "content_sanskrit": "खड्गपत्रवनं चैव भीमं पश्यसि रावण।\nतप्तकाञ्चनपुष्पां च वैदूर्यप्रवरच्छदाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000249021, "chapter_id": 9249, "verse_number": "३-५३-२१", "content_sanskrit": "द्रक्ष्यसे शाल्मलीं तीक्ष्णामायसैः कण्टकैश्चिताम्।\nनहि त्वमीदृशं कृत्वा तस्यालीकं महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000249022, "chapter_id": 9249, "verse_number": "३-५३-२२", "content_sanskrit": "धारितुं शक्ष्यसि चिरं विषं पीत्वेव निर्घृण।\nबद्धस्त्वं कालपाशेन दुर्निवारेण रावण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000249023, "chapter_id": 9249, "verse_number": "३-५३-२३", "content_sanskrit": "क्व गतो लप्स्यसे शर्म मम भर्तुर्महात्मनः।\nनिमेषान्तरमात्रेण विना भ्रातरमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000249024, "chapter_id": 9249, "verse_number": "३-५३-२४", "content_sanskrit": "राक्षसा निहता येन सहस्राणि चतुर्दश।\nकथं स राघवो वीरः सर्वास्त्रकुशलो बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000249025, "chapter_id": 9249, "verse_number": "३-५३-२५", "content_sanskrit": "न त्वां हन्याच्छरैस्तीक्ष्णैरिष्टभार्यापहारिणम्।\nएतच्चान्यच्च परुषं वैदेही रावणाङ्कगा।\nभयशोकसमाविष्टा करुणं विललाप ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000249026, "chapter_id": 9249, "verse_number": "३-५३-२६", "content_sanskrit": "तदा भृशार्तां बहु चैव भाषिणीं\nविलापपूर्वं करुणं च भामिनीम्।\nजहार पापस्तरुणीं विचेष्टतीं\nनृपात्मजामागतगात्रवेपथुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000249027, "chapter_id": 9249, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे त्रिपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]