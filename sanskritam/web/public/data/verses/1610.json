[{"id": 2028237, "chapter_id": 1610, "verse_number": "३-२४८-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2028238, "chapter_id": 1610, "verse_number": "३-२४८-१", "content_sanskrit": "शत्रुभिर्जितबद्धस् पाण्डवैश्च महात्मभिः।\nमोक्षितस्य युधा पश्चान्मानिनः सुदुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2028239, "chapter_id": 1610, "verse_number": "३-२४८-२", "content_sanskrit": "कत्थनस्यावलिप्तस्य गर्वितस् च नित्यशः।\nसदा च पौरुषौदार्यैः पाण्डवानवमन्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2028240, "chapter_id": 1610, "verse_number": "३-२४८-३", "content_sanskrit": "दुर्योधनस् पापस्य नित्याहंकारवादिनः।\nप्रवेशो हास्तिनपुरे दुष्करः प्रतिभाति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2028241, "chapter_id": 1610, "verse_number": "३-२४८-४", "content_sanskrit": "तस्य लज्जानवितस्यैव शोकव्याकुलचेतसः।\nप्रवेशं विस्तरेण रत्वं वैशम्पायन कीर्तय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2028242, "chapter_id": 1610, "verse_number": "३-२४८-५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2028243, "chapter_id": 1610, "verse_number": "३-२४८-५", "content_sanskrit": "धर्मराजनिसृष्स्तु धार्तराष्ट्रः सुयोधनः।\nलज्जयाऽधोमुखः सीदन्नुपासर्पत्सुदुःखितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2028244, "chapter_id": 1610, "verse_number": "३-२४८-६", "content_sanskrit": "स्वपुरं प्रययौ राजा चतुरङ्गबलानुगः।\nशोकोदहतया बुद्ध्या चिन्तयानः पराभवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2028245, "chapter_id": 1610, "verse_number": "३-२४८-७", "content_sanskrit": "विमुच्य पथि यानानि देशे सुयवसोदके।\nसन्निविष्टः शुभे रम्ये भूमिभागे यथेप्सितम्।\nहस्त्यश्वरथपादातं यथास्थानं न्यवेशयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2028246, "chapter_id": 1610, "verse_number": "३-२४८-८", "content_sanskrit": "अथोपविष्टं राजानं पर्यङ्के ज्वलनप्रभे।\nउपप्लुतं यथा सोमं राहुणा रात्रिसंक्षये।\nउपागम्याब्रवीत्कर्णो दुर्योधनमिदं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2028247, "chapter_id": 1610, "verse_number": "३-२४८-९", "content_sanskrit": "दिष्ट्या जीवसि गान्धारे दिष्ठ्या नः संगमः पुनः।\nदिष्ट्या त्वया जिताश्चैव गन्धर्वाः कामरूपिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2028248, "chapter_id": 1610, "verse_number": "३-२४८-१०", "content_sanskrit": "दिष्ट्या समग्रान्पश्यामि भ्रातॄस्ते कुरुनन्दन।\nविजिगीषून्रणे युक्तान्निर्जितारीन्महारथान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2028249, "chapter_id": 1610, "verse_number": "३-२४८-११", "content_sanskrit": "अहं त्वभिद्रुतः सर्वैर्गन्धर्वैः पश्यतस्व।\nनाशक्नुवं स्थापयितुं दीर्यमाणां च वाहिनीम्।\nशरक्षताङ्गश्च भृशं व्यपयातोऽभिपीडितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2028250, "chapter_id": 1610, "verse_number": "३-२४८-१२", "content_sanskrit": "इदं त्वत्यद्भुतं मन्ये यद्युष्मानिह भारत।\nअरिष्टानक्षसांश्चापि सदारबलवाहनान्।\nविमुक्तान्संप्रपश्यामि युद्धात्तस्मादमानुषात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2028251, "chapter_id": 1610, "verse_number": "३-२४८-१३", "content_sanskrit": "नैतस्य कर्ता लोकेऽस्मिन्पुमान्विद्यति भारत।\nयत्कृतं ते महाराज सह भ्रातृभिराहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2028252, "chapter_id": 1610, "verse_number": "", "content_sanskrit": "एवमुक्तस्तु कर्णेन राजा दुर्योधनस्तदा।\nउवाचावाक्शिरा राजन्बाष्पगद्गदया गिरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]