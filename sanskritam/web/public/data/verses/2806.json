[{"id": 2084944, "chapter_id": 2806, "verse_number": "१२-३११-०x", "content_sanskrit": "जनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2084945, "chapter_id": 2806, "verse_number": "१२-३११-१", "content_sanskrit": "मानात्वैकत्वमित्युक्तं त्वयैतदृषिसत्तम।\nपश्यामि वाभिसंदिग्धमेतयोर्वै निदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2084946, "chapter_id": 2806, "verse_number": "१२-३११-२", "content_sanskrit": "तथाऽबुद्धप्रबुद्धाभ्यां बुध्यमानस्य चानघ।\nस्थूलबुद्ध्या न पश्यामि तत्त्वमेतन्न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2084947, "chapter_id": 2806, "verse_number": "१२-३११-३", "content_sanskrit": "अक्षरक्षरयोर्युक्तं त्वया यदपि कारणम्।\nतदप्यस्थिरबुद्धित्वात्प्रनष्टमिव मेऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2084948, "chapter_id": 2806, "verse_number": "१२-३११-४", "content_sanskrit": "तदेत्तच्छ्रोतुमिच्छामि नानात्वैकत्वदर्शनम्।\nप्रबुद्धमप्रबुद्धं च बुध्यमानं च तत्त्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2084949, "chapter_id": 2806, "verse_number": "१२-३११-५", "content_sanskrit": "विद्याविद्ये च भगवन्नक्षरं क्षरमेव च।\nसाङ्ख्यं योगं च कार्त्स्न्येन पृथक्चैवापृथक्च ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2084950, "chapter_id": 2806, "verse_number": "१२-३११-६x", "content_sanskrit": "वसिष्ठ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2084951, "chapter_id": 2806, "verse_number": "१२-३११-६", "content_sanskrit": "हन्त ते संप्रवक्ष्यामि यदेतदनुपृच्छसि।\nयोगकृत्यं महाराज पृथगेव शृणुष्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2084952, "chapter_id": 2806, "verse_number": "१२-३११-७", "content_sanskrit": "योगकृत्यं तु योगानां ध्यानमेव परं बलम्।\nतच्चापि द्विविधं ध्यानमाहुर्वेदविदो जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2084953, "chapter_id": 2806, "verse_number": "१२-३११-८", "content_sanskrit": "एकाग्रता च मनसः प्राणायामस्तथैव च।\nप्राणायामस्तु सगुणो निर्गुणो मनसस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2084954, "chapter_id": 2806, "verse_number": "१२-३११-९", "content_sanskrit": "मूत्रोत्सर्गपुरीषे च भोजने च नराधिप।\nद्विकालं नाभियुज्जीत शेषं युञ्जीत तत्परः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2084955, "chapter_id": 2806, "verse_number": "१२-३११-१०", "content_sanskrit": "इन्द्रियाणीन्द्रियार्थेभ्यो निवर्त्य मनसा मुनिः।\nदशद्वादशभिर्वापि चतुर्विशात्परं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2084956, "chapter_id": 2806, "verse_number": "१२-३११-११", "content_sanskrit": "तं चोदनाभिर्मतिमानात्मानं चोदयेदथ।\nतिष्ठन्तमजरं यं तु यत्तदुक्तं मनीषिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2084957, "chapter_id": 2806, "verse_number": "१२-३११-१२", "content_sanskrit": "तैश्चात्मा सततं योज्य इत्येवमनुशुश्रुम्।\nद्रुतं ह्यहीनमनसो नान्यथेति विनिश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2084958, "chapter_id": 2806, "verse_number": "१२-३११-१३", "content_sanskrit": "विमुक्तः सर्वसङ्गेभ्यो लध्वाहारो जितेन्द्रियः॥\nपूर्वरात्रेऽपररात्रे च धारयेत मनोऽऽत्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2084959, "chapter_id": 2806, "verse_number": "१२-३११-१४", "content_sanskrit": "स्थिरीकृत्येन्द्रियग्रामं मनसा मिथिलेश्वर।\nमनो बुद्ध्या स्थिरं कृत्वा पाषाण इव निश्चलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2084960, "chapter_id": 2806, "verse_number": "१२-३११-१५", "content_sanskrit": "स्थाणुवच्चाप्यकम्पः स्याद्दारुवच्चापि निश्चलः।\nबुधा विधिविधानज्ञास्तदा युक्तं प्रचक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2084961, "chapter_id": 2806, "verse_number": "१२-३११-१६", "content_sanskrit": "न शृणोति न चाघ्राति न रस्यति न पश्यति।\nन च स्पर्शं विजानाति न संकल्पयते मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2084962, "chapter_id": 2806, "verse_number": "१२-३११-१७", "content_sanskrit": "न चाभिमन्यते किंचिन्न च बुध्यति काष्ठवत्।\nतदा प्रकृतिमापन्नं युक्तमाहुर्मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2084963, "chapter_id": 2806, "verse_number": "१२-३११-१८", "content_sanskrit": "निर्वाते हि यथा दीप्यन्दीपस्तद्वत्प्रकाशते।\nनिर्लिङ्गो विचलश्चोर्ध्वं न तिर्यग्गतिमाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2084964, "chapter_id": 2806, "verse_number": "१२-३११-१९", "content_sanskrit": "तदा तमनुपश्येत यस्मिन्दृष्टे तु कथ्यते।\nहृदयस्थोऽन्तरात्मेति ज्ञेयो ज्ञस्तात मद्विधैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2084965, "chapter_id": 2806, "verse_number": "१२-३११-२०", "content_sanskrit": "विधूम इव सप्तार्चिरादित्य इव रश्मिमान्।\nवैद्युतोऽग्निरिवाकाशे दृश्यतेऽऽत्मा तथाऽऽत्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2084966, "chapter_id": 2806, "verse_number": "१२-३११-२१", "content_sanskrit": "संपश्यन्ति महात्मानो धृतिमन्तो मनीषिणः।\nब्राह्मणा ब्रह्मयोनिस्था ह्ययोनिममृतात्मकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2084967, "chapter_id": 2806, "verse_number": "१२-३११-२२", "content_sanskrit": "तदेवाहुरणुभ्योऽणु तन्महद्भ्यो महत्तरम्।\nतत्तत्र सर्वभूतेषु ध्रुवं तिष्ठन्न दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2084968, "chapter_id": 2806, "verse_number": "१२-३११-२३", "content_sanskrit": "बुद्धिद्रव्येण दृश्येत मनोदीपेन लोककृत्।\nमहतस्तमसस्तात पारे तिष्ठन्न तामसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2084969, "chapter_id": 2806, "verse_number": "१२-३११-२४", "content_sanskrit": "स च मानस इत्युक्तस्तत्वज्ञैर्वेदपारगैः।\nविमलो वितमस्कश्च निर्लिङ्गोऽलिङ्गसंज्ञकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2084970, "chapter_id": 2806, "verse_number": "१२-३११-२५", "content_sanskrit": "योगमेतत्तु योगानां मन्ये योगस्य लक्षणम्।\nएवं पश्यं प्रपश्यन्ति आत्मस्थमजरं परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2084971, "chapter_id": 2806, "verse_number": "१२-३११-२६", "content_sanskrit": "योगदर्शनमेतावदुक्तं ते तत्वतो मया।\nसाङ्ख्याज्ञानं प्रवक्ष्यामि परिसंख्यानदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2084972, "chapter_id": 2806, "verse_number": "१२-३११-२७", "content_sanskrit": "अव्यक्तमाहुः प्रकृतिं परां प्रकृतिवादिनः।\nतस्मान्महत्समुत्पन्नं द्वितीयं राजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2084973, "chapter_id": 2806, "verse_number": "१२-३११-२८", "content_sanskrit": "अहंकारस्तु महतस्तृतीय इति नः श्रुतम्।\nपञ्चभूतान्यहंकारादाहुः साङ्ख्यनिदर्शिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2084974, "chapter_id": 2806, "verse_number": "१२-३११-२९", "content_sanskrit": "एताः प्रकृतयश्चाष्टौ विकाराश्चापि षोडश।\nपञ्च चैव विशेषा वै तथा पञ्चेन्द्रियाणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2084975, "chapter_id": 2806, "verse_number": "१२-३११-३०", "content_sanskrit": "एतावदेव तत्त्वानां साङ्ख्या आहुर्मनीषिणः।\nसाङ्ख्ये विधिविधानज्ञा नित्यं साङ्ख्यपथे रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2084976, "chapter_id": 2806, "verse_number": "१२-३११-३१", "content_sanskrit": "यस्माद्यदभिजायेत तत्तत्रैव प्रलीयते।\nलीयन्ते प्रतिलोमानि सृज्यन्ते चान्तरात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2084977, "chapter_id": 2806, "verse_number": "१२-३११-३२", "content_sanskrit": "अनुलोमेन जायन्ते लीयन्ते प्रतिलोमतः।\nगुणा गुणेषु सततं सागरस्योर्मयो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2084978, "chapter_id": 2806, "verse_number": "१२-३११-३३", "content_sanskrit": "सर्वप्रलय एतावान्प्रकृतेर्नृपसत्तम।\nएकत्वं प्रलये चास्य बहुत्वं च यदाऽसृजत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2084979, "chapter_id": 2806, "verse_number": "१२-३११-३४", "content_sanskrit": "एवमेव च राजेन्द्र विज्ञेयं ज्ञेयचिन्तकैः।\nअधिष्ठाता य इत्युक्तस्तस्याप्येतन्निदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2084980, "chapter_id": 2806, "verse_number": "१२-३११-३५", "content_sanskrit": "एकत्वं च बहुत्वं च प्रकृतेरनुतत्त्ववान्।\nएकत्वं प्रलये चास्य बहुत्वं च प्रवर्तनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2084981, "chapter_id": 2806, "verse_number": "१२-३११-३६", "content_sanskrit": "बहुधाऽऽत्मानमकरोत्प्रकृतिः प्रसावत्मिका।\nतच्च क्षेत्रं महानात्मा पञ्चविंशोऽधितिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2084982, "chapter_id": 2806, "verse_number": "१२-३११-३७", "content_sanskrit": "अधिष्ठातेति राजेन्द्र प्रोच्यते यतिसत्तमैः।\nअधिष्ठानादधिष्ठाता क्षेत्राणामिति नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2084983, "chapter_id": 2806, "verse_number": "१२-३११-३८", "content_sanskrit": "क्षेत्रं जानाति चाव्यक्तं क्षेत्रज्ञ इति चोच्यते।\nअव्यक्तके पुरे शेते पुरुषश्चेति कथ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2084984, "chapter_id": 2806, "verse_number": "१२-३११-३९", "content_sanskrit": "अन्यदेव च क्षेत्रं स्यादन्यः क्षेत्रज्ञ उच्यते।\nक्षेत्रमव्यक्तमित्युक्तं ज्ञाता वै पञ्चविंशकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2084985, "chapter_id": 2806, "verse_number": "१२-३११-४०", "content_sanskrit": "अन्यदेव वचो ज्ञानं स्यादन्यज्ज्ञेयमुच्यते।\nज्ञानमव्यक्तमित्युक्तं ज्ञेयो वै पञ्चविंशकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2084986, "chapter_id": 2806, "verse_number": "१२-३११-४१", "content_sanskrit": "अव्यक्तं क्षेत्रमित्युक्तं यथासत्वं तथेश्वरम्।\nअनीश्वरमतत्त्वं च तत्त्वं तत्पञ्चविंशकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2084987, "chapter_id": 2806, "verse_number": "१२-३११-४२", "content_sanskrit": "साङ्ख्यदर्शनमेतावत्परिसङ्ख्यानदर्शनम्।\nसाङ्ख्याः प्रकुर्वते चैव प्रकृतिं च प्रचक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2084988, "chapter_id": 2806, "verse_number": "१२-३११-४३", "content_sanskrit": "तत्त्वानि च चतुर्विशत्परिसंख्याय तत्त्वतः।\nसाङ्ख्याः सह प्रकृत्या तु निस्तत्त्वः पञ्चविंशकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2084989, "chapter_id": 2806, "verse_number": "१२-३११-४४", "content_sanskrit": "पञ्चविंशो प्रबुद्धात्मा बुध्यमान इति स्मृतः।\nयदा तु बुध्यतेऽऽत्मानं तदा भवति केवलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2084990, "chapter_id": 2806, "verse_number": "१२-३११-४५", "content_sanskrit": "सम्यग्दर्शनमेतावद्भाषितं तव तत्त्वतः।\nएवमेतद्विजानन्तः साम्यतां प्रतियान्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2084991, "chapter_id": 2806, "verse_number": "१२-३११-४६", "content_sanskrit": "सम्यङ्गिदर्शनं नाम प्रत्यक्षं प्रकृतेस्तथा।\nगुणतत्त्वाद्यथैतानि निर्गुणोऽन्यस्तथा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2084992, "chapter_id": 2806, "verse_number": "१२-३११-४७", "content_sanskrit": "न त्वेवं वर्तमानानामवृत्तिर्विद्यते पुनः।\nविद्यतेऽक्षरभावत्वे स परात्परमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2084993, "chapter_id": 2806, "verse_number": "१२-३११-४८", "content_sanskrit": "पश्येरन्नेकमतयो न सम्पक्तेषु दर्शनम्।\nतेऽव्यक्तं प्रतिपद्यन्ते पुनः पुनररिंदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2084994, "chapter_id": 2806, "verse_number": "१२-३११-४९", "content_sanskrit": "सर्वमेतद्विजानन्तो नासर्वस्य प्रबोधनात्।\nव्यक्तीभूता भविष्यन्ति व्यक्तस्य वशवर्तिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2084995, "chapter_id": 2806, "verse_number": "१२-३११-५०", "content_sanskrit": "सर्वमवर्यक्तमित्युक्तमसर्वः पञ्चविंशकः।\nय एनमभिजानन्ति न भयं तेषु विद्यते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2084996, "chapter_id": 2806, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि एकादशाधिकत्रिशततमोऽध्यायः॥ ३११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]