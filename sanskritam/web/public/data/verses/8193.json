[{"id": 900000892, "chapter_id": 8193, "verse_number": "1.1", "content_sanskrit": "उशन् ह वै वाजश्रवसः सर्ववेदसं ददौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900000893, "chapter_id": 8193, "verse_number": "1.2", "content_sanskrit": "अन्यच्छ्रेयोऽन्यदुतेव प्रेयः ते उभे नानार्थे पुरुषं सिनीतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900000894, "chapter_id": 8193, "verse_number": "1.3", "content_sanskrit": "ऋतं पिबन्तौ सुकृतस्य लोके गुहां प्रविष्टौ परमे परार्द्धे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}]