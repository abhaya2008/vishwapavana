[{"id": 7000403000, "chapter_id": 20403, "verse_number": "२-७५-१", "content_sanskrit": "सुकर्मोवाच ।\nविष्णुं कृष्णं हरिं रामं मुकुंदं मधुसूदनम् ।\nनारायणं विष्णुरूपं नारसिंहं तमच्युतम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000403001, "chapter_id": 20403, "verse_number": "२-७५-२", "content_sanskrit": "केशवं पद्मनाभं च वासुदेवं च वामनम् ।\nवाराहं कमठं मत्स्यं हृषीकेशं सुराधिपम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000403002, "chapter_id": 20403, "verse_number": "२-७५-३", "content_sanskrit": "विश्वेशं विश्वरूपं च अनंतमनघं शुचिम् ।\nपुरुषं पुष्कराक्षं च श्रीधरं श्रीपतिं हरिम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000403003, "chapter_id": 20403, "verse_number": "२-७५-४", "content_sanskrit": "श्रीनिवासं पीतवासं माधवं मोक्षदं प्रभुम् ।\nइत्येवं हि समुच्चारं नामभिर्मानवाः सदा॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000403004, "chapter_id": 20403, "verse_number": "२-७५-५", "content_sanskrit": "प्रकुर्वंति नराः सर्वे बालवृद्धाः कुमारिकाः ।\nस्त्रियो हरिं सुगायंति गृहकर्मरताः सदा॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000403005, "chapter_id": 20403, "verse_number": "२-७५-६", "content_sanskrit": "आसने शयने याने ध्याने वचसि माधवम् ।\nक्रीडमानास्तथा बाला गोविंदं प्रणमंति ते॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000403006, "chapter_id": 20403, "verse_number": "२-७५-७", "content_sanskrit": "दिवारात्रौ सुमधुरं ब्रुवंति हरिनाम च ।\nविष्णूच्चारो हि सर्वत्र श्रूयते द्विजसत्तम॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000403007, "chapter_id": 20403, "verse_number": "२-७५-८", "content_sanskrit": "वैष्णवेन प्रभावेण मर्त्या वर्तंति भूतले ।\nप्रासादकलशाग्रेषु देवतायतनेषु च॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000403008, "chapter_id": 20403, "verse_number": "२-७५-९", "content_sanskrit": "यथा सूर्यस्य बिंबानि तथा चक्राणि भांति च ।\nवैकुंठे दृश्यते भावस्तद्भावं जगतीतले॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000403009, "chapter_id": 20403, "verse_number": "२-७५-१०", "content_sanskrit": "तेन राज्ञा कृतं विप्र पुण्यं चापि महात्मना ।\nविष्णुलोकस्य समतां तथानीतं महीतलम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000403010, "chapter_id": 20403, "verse_number": "२-७५-११", "content_sanskrit": "नहुषस्यापि पुत्रेण वैष्णवेन ययातिना ।\nउभयोर्लोकयोर्भावमेकीभूतं महीतलम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000403011, "chapter_id": 20403, "verse_number": "२-७५-१२", "content_sanskrit": "भूतलस्यापि विष्णोश्च अंतरं नैव दृश्यते ।\nविष्णूच्चारं तु वैकुंठे यथा कुर्वंति वैष्णवाः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000403012, "chapter_id": 20403, "verse_number": "२-७५-१३", "content_sanskrit": "भूतले तादृशोच्चारं प्रकुर्वंति च मानवाः ।\nउभयोर्लोकयोर्विप्र एकभावः प्रदृश्यते॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000403013, "chapter_id": 20403, "verse_number": "२-७५-१४", "content_sanskrit": "जरारोगभयं नास्ति मृत्युहीना नरा बभुः ।\nदानभोगप्रभावश्च अधिको दृश्यते भुवि॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000403014, "chapter_id": 20403, "verse_number": "२-७५-१५", "content_sanskrit": "पुत्राणां तु सुखं पुण्यमधिकं पौत्रजं नराः ।\nप्रभुंजंति सुखेनापि मानवा भुवि सत्तम॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000403015, "chapter_id": 20403, "verse_number": "२-७५-१६", "content_sanskrit": "विष्णोः प्रसाददानेन उपदेशेन तस्य च ।\nसर्वव्याधिविनिर्मुक्ता मानवा वैष्णवाः सदा॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000403016, "chapter_id": 20403, "verse_number": "२-७५-१७", "content_sanskrit": "स्वर्गलोकप्रभावो हि कृतो राज्ञा महीतले ।\nपंचविंशप्रमाणेन वर्षाणि नृपसत्तम॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000403017, "chapter_id": 20403, "verse_number": "२-७५-१८", "content_sanskrit": "गदैर्हीना नराः सर्वे ज्ञानध्यानपरायणाः ।\nयज्ञदानपराः सर्वे दयाभावाश्च मानवाः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000403018, "chapter_id": 20403, "verse_number": "२-७५-१९", "content_sanskrit": "उपकाररताः पुण्या धन्यास्ते कीर्तिभाजनाः ।\nसर्वे धर्मपरा विप्र विष्णुध्यानपरायणाः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000403019, "chapter_id": 20403, "verse_number": "२-७५-२०", "content_sanskrit": "राज्ञा तेनोपदिष्टास्ते संजाता वैष्णवा भुवि ।\nविष्णुरुवाच ।\nश्रूयतां नृपशार्दूल चरित्रं तस्य भूपतेः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000403020, "chapter_id": 20403, "verse_number": "२-७५-२१", "content_sanskrit": "सर्वधर्मपरो नित्यं विष्णुभक्तश्च नाहुषिः ।\nअब्दानां तत्र लक्षं हि तस्याप्येवं गतं भुवि॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000403021, "chapter_id": 20403, "verse_number": "२-७५-२२", "content_sanskrit": "नूतनो दृश्यते कायः पंचविंशाब्दिको यथा ।\nपंचविंशाब्दिको भाति रूपेण वयसा तदा॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000403022, "chapter_id": 20403, "verse_number": "२-७५-२३", "content_sanskrit": "प्रबलः प्रौढिसंपन्नः प्रसादात्तस्य चक्रिणः ।\nमानुषा भुवमास्थाय यमं नैव प्रयांति ते॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000403023, "chapter_id": 20403, "verse_number": "२-७५-२४", "content_sanskrit": "रागद्वेषविनिर्मुक्ताः क्लेशपाशविवर्जिताः ।\nसुखिनो दानपुण्यैश्च सर्वधर्मपरायणाः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000403024, "chapter_id": 20403, "verse_number": "२-७५-२५", "content_sanskrit": "विस्तारं तेजनाः सर्वे संतत्यापि गता नृप ।\nयथा दूर्वावटाश्चैव विस्तारं यांति भूतले॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000403025, "chapter_id": 20403, "verse_number": "२-७५-२६", "content_sanskrit": "यथा ते मानवाः सर्वे पुत्रपौत्रैः प्रविस्तृताः ।\nमृत्युदोषविहीनास्ते चिरं जीवंति वै जनाः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000403026, "chapter_id": 20403, "verse_number": "२-७५-२७", "content_sanskrit": "स्थिरकायाश्च सुखिनो जरारोगविवर्जिताः ।\nपंचविंशाब्दिकाः सर्वे नरा दृश्यंति भूतले॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000403027, "chapter_id": 20403, "verse_number": "२-७५-२८", "content_sanskrit": "सत्याचारपराः सर्वे विष्णुध्यानपरायणाः ।\nएवं सर्वे च मर्त्यास्ते प्रसादात्तस्य चक्रिणः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000403028, "chapter_id": 20403, "verse_number": "२-७५-२९", "content_sanskrit": "संजाता मानवाः सर्वे दानभोगपरायणाः ।\nमृतो न श्रूयते लोके मर्त्यः कोपि नरोत्तम॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000403029, "chapter_id": 20403, "verse_number": "२-७५-३०", "content_sanskrit": "शोकं नैव प्रपश्यंति दोषं नैव प्रयांति ते ।\nयद्रूपं स्वर्गलोकस्य तद्रूपं भूतलस्य च॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000403030, "chapter_id": 20403, "verse_number": "२-७५-३१", "content_sanskrit": "संजातं मानवश्रेष्ठ प्रसादात्तस्य चक्रिणः ।\nविभ्रष्टा यमदूतास्ते विष्णुदूतैश्च ताडिताः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000403031, "chapter_id": 20403, "verse_number": "२-७५-३२", "content_sanskrit": "रुदमाना गताः सर्वे धर्मराजं परस्परम् ।\nतत्सर्वं कथितं दूतैश्चेष्टितं भूपतेस्तु तैः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000403032, "chapter_id": 20403, "verse_number": "२-७५-३३", "content_sanskrit": "अमृत्युभूतलं जातं दानभोगेन भास्करे ।\nनहुषस्यात्मजेनापि कृतं देवययातिना॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000403033, "chapter_id": 20403, "verse_number": "२-७५-३४", "content_sanskrit": "विष्णुभक्तेन पुण्येन स्वर्गरूपं प्रदर्शितम् ।\nएवमाकर्णितं सर्वं धर्मराजेन वै तदा॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000403034, "chapter_id": 20403, "verse_number": "२-७५-३५", "content_sanskrit": "धर्मराजस्तदा तत्र दूतेभ्यः श्रुतविस्तरः ।\nचिंतयामास सर्वार्थं श्रुत्वैवंनृपचेष्टितम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]