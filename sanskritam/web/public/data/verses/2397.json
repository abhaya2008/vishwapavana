[{"id": 2066117, "chapter_id": 2397, "verse_number": "९-१५-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2066118, "chapter_id": 2397, "verse_number": "९-१५-१", "content_sanskrit": "ततः सेना तव विभो मद्रराजपुरस्कृता।\nपुनरभ्यद्रवत्पार्थान्वेगेन महता रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2066119, "chapter_id": 2397, "verse_number": "९-१५-२", "content_sanskrit": "पीडितास्तावकाः सर्वे प्रधावन्तो रणोत्कटाः।\nक्षणेन चैव पार्थांस्ते बहुत्वात्समलोडयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2066120, "chapter_id": 2397, "verse_number": "९-१५-३", "content_sanskrit": "ते वध्यमानाः समरे पाण्डवा नावतस्थिरे।\nक्षणेनैव महाराज पश्यतोः कृष्णपार्थयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2066121, "chapter_id": 2397, "verse_number": "९-१५-४", "content_sanskrit": "ततो धनञ्जयः क्रुद्धः कृपं सह पदानुगैः।\nअवाकिरच्छरौघेण कृतवर्माणमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2066122, "chapter_id": 2397, "verse_number": "९-१५-५", "content_sanskrit": "शकुनिं सहदेवस्तु सहसैन्यमवाकिरत्।\nनकुलः पार्श्वतः स्थित्वा मद्रराजमयोधयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2066123, "chapter_id": 2397, "verse_number": "९-१५-६", "content_sanskrit": "द्रौपदेया नरेन्द्राश्च भूयिष्ठान्समवारयन्।\nद्रोणपुत्रं च पाञ्चाल्यः शिखण्डी समवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2066124, "chapter_id": 2397, "verse_number": "९-१५-७", "content_sanskrit": "भीमसेनस्तु राजानं गदापाणिरवारयत्।\nशल्यं तु सह सैन्येन कुन्तीपुत्रो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2066125, "chapter_id": 2397, "verse_number": "९-१५-८", "content_sanskrit": "ततः समभवद्युद्धं संसक्तं तत्रतत्र ह।\nतावकानां परेषां च सङ्ग्रामेष्वनिवर्तिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2066126, "chapter_id": 2397, "verse_number": "९-१५-९", "content_sanskrit": "तत्र पश्यामहे कर्म शल्यस्यातिमहद्रणे।\nयदेकः सर्वसैन्यानि पाण्डवानामयोधयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2066127, "chapter_id": 2397, "verse_number": "९-१५-१०", "content_sanskrit": "व्यदृश्यत तदा शल्यो युधिष्ठिरसमीपतः।\nक्रूरश्चन्द्रमसोऽभ्याशे शनैश्चर इव ग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2066128, "chapter_id": 2397, "verse_number": "९-१५-११", "content_sanskrit": "पीडयित्वा तु राजानं शरैराशीविषोपमैः।\nअभ्यधावत्पुनर्भीमं शरवर्षैरवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2066129, "chapter_id": 2397, "verse_number": "९-१५-१२", "content_sanskrit": "तस्य तल्लाघवं दृष्ट्वा तथैव च कृतास्त्रताम्।\nअपूजयन्ननीकानि परेषां तावकानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2066130, "chapter_id": 2397, "verse_number": "९-१५-१३", "content_sanskrit": "पीड्यमानास्तु शल्येन पाण्डवा भृशाविक्षताः।\nप्राद्रवन्त रणं हित्वा क्रोशमाने युधिष्ठिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2066131, "chapter_id": 2397, "verse_number": "९-१५-१४", "content_sanskrit": "वध्यमानेष्वनीकेषु मद्रराजेन पाण्डवः।\nअमर्षवशमापन्नो धर्मराजो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2066132, "chapter_id": 2397, "verse_number": "९-१५-१५", "content_sanskrit": "ततः पौरुषमास्थाय मद्रराजमताडयत्।\nजयो वाऽस्तु वधो वेति कृतबुद्धिर्महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2066133, "chapter_id": 2397, "verse_number": "९-१५-१६", "content_sanskrit": "समाहूयाब्रवीत्सर्वान्भ्रातॄन्कृष्णं च पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2066134, "chapter_id": 2397, "verse_number": "९-१५-१७", "content_sanskrit": "भीष्मो द्रोणश्च कर्णश्च ये चान्ये पृथिवीक्षितः।\nकौरवार्थे पराक्रान्ताः सङ्ग्रामे निधनं गताः।\nयथाभागं यथोत्साहं भवन्तः कृतपौरुषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2066135, "chapter_id": 2397, "verse_number": "९-१५-१८", "content_sanskrit": "भागोऽवशिष्ट एकोऽयं मम शल्यो महारथः।\nसोऽहमद्य युधा जेतुमाशंसे मद्रकाधिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2066136, "chapter_id": 2397, "verse_number": "९-१५-१९", "content_sanskrit": "तत्र यन्मानसं मह्यं तत्सर्वं निगदामि वः।\nचक्ररक्षाविमौ वीरौ मम माद्रवतीसुतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2066137, "chapter_id": 2397, "verse_number": "९-१५-२०", "content_sanskrit": "अजेयौ वासवेनापि समरे शूरसम्मतौ।\nसाध्विमौ मातुलं युद्धे क्षत्रधर्मपुरस्कृतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2066138, "chapter_id": 2397, "verse_number": "९-१५-२१", "content_sanskrit": "मदर्थे प्रतियुध्येतां मानार्हौ सत्यसङ्गरौ।\nमां वा शल्यो रणे हन्ता तं वाऽहं भद्रमस्तु वः।\nइति सत्यामिमां वाणीं लोकवीरा निबोधत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2066139, "chapter_id": 2397, "verse_number": "९-१५-२२", "content_sanskrit": "योत्स्येऽहं मातुलेनाद्य क्षात्रधर्मेण पार्थिवाः।\nस्वमंशमभिसन्धाय विजयायेतराय वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2066140, "chapter_id": 2397, "verse_number": "९-१५-२३", "content_sanskrit": "तस्य मेऽप्यधिकं शस्त्रं सर्वोपकरणानि च।\nसंयुज्यन्तां रथे क्षिप्रं शास्त्रवद्रथयोजकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2066141, "chapter_id": 2397, "verse_number": "९-१५-२४", "content_sanskrit": "शैनेयो दक्षिणं चक्रं धृष्टद्युम्नस्तथोत्तरम्।\nपृष्ठगोपो भवत्वद्य मम पार्थो धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2066142, "chapter_id": 2397, "verse_number": "९-१५-२५", "content_sanskrit": "पुरःसरो ममाद्यास्तु भीमः शस्त्रभृतां वरः।\nएवमभ्यधिकः शल्याद्भविष्यामि महामृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2066143, "chapter_id": 2397, "verse_number": "९-१५-२६", "content_sanskrit": "एवमुक्तास्तथा चक्रुस्तदा राज्ञः प्रियैषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2066144, "chapter_id": 2397, "verse_number": "९-१५-२७", "content_sanskrit": "ततः प्रहर्षः सैव्यानां पुनरासीत्तदाः मृधे।\nपाञ्चालानां सोमकानां मात्स्यानां च विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2066145, "chapter_id": 2397, "verse_number": "९-१५-२८", "content_sanskrit": "प्रतिज्ञातं च सङ्ग्रामे धर्मराजस्य पूजयन्।\nततः शङ्खांश्च भेरीश्च शतशश्चैव पुष्करान्।\nअवादयन्त पाञ्चालाः सिंहनादांश्च नेदिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2066146, "chapter_id": 2397, "verse_number": "९-१५-२९", "content_sanskrit": "तेऽभ्यधावन्त संरब्धा मद्रराजं तरस्विनम्।\nमहता हर्षजेनाथ नादेन कुरुपुङ्गवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2066147, "chapter_id": 2397, "verse_number": "९-१५-३०", "content_sanskrit": "हादेन गजघण्टानां शङ्खानां निनदेन च।\nतूर्यशब्देन महता नादयन्तश्च मेदिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2066148, "chapter_id": 2397, "verse_number": "९-१५-३१", "content_sanskrit": "तान्प्रत्यगृह्णात्पुत्रस्ते मद्रराजश्च वीर्यवान्।\nमहामेघानिव बहूञ्शैलावस्तोदयावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2066149, "chapter_id": 2397, "verse_number": "९-१५-३२", "content_sanskrit": "शल्यस्तु समरश्लाघी धर्मराजमरिन्दमम्।\nववर्ष शरवर्षेण शम्बरं मघवा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2066150, "chapter_id": 2397, "verse_number": "९-१५-३३", "content_sanskrit": "तथैव कुरुराजोऽपि प्रगृह्य रुचिरं धनुः।\nद्रोणोपदेशान्विविधान्दर्शयानो महामनाः।\nववर्ष शरवर्षाणि चित्रं लघु च सुष्ठु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2066151, "chapter_id": 2397, "verse_number": "९-१५-३४", "content_sanskrit": "न चास्य विवरं कश्चिद्ददर्श चरतो रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2066152, "chapter_id": 2397, "verse_number": "९-१५-३५", "content_sanskrit": "तावुभौ विविधैर्बाणैस्ततक्षाते परस्परम्।\nशार्दूलावामिषप्रेप्सू पराक्रान्ताविवाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2066153, "chapter_id": 2397, "verse_number": "९-१५-३६", "content_sanskrit": "भीमस्तु तव पुत्रेण युद्धशौण्डेन सङ्गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2066154, "chapter_id": 2397, "verse_number": "९-१५-३७", "content_sanskrit": "पाञ्चाल्यः सात्यकिश्चैव माद्रीपुत्रौ च पाण्डवौ।\nशकुनिप्रमुखान्वीरान्प्रत्यगृह्णन्समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2066155, "chapter_id": 2397, "verse_number": "९-१५-३८", "content_sanskrit": "तदासीत्तुमुलं युद्धं पुनरेव जयैषिणाम्।\nतावकानां परेषां च राजन्दुर्मन्त्रिते तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2066156, "chapter_id": 2397, "verse_number": "९-१५-३९", "content_sanskrit": "दुर्योधनस्तु भीमस्य शरेणानतपर्वणा।\nचिच्छेदादिश्य सङ्ग्रामे ध्वजं हेमपरिष्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2066157, "chapter_id": 2397, "verse_number": "९-१५-४०", "content_sanskrit": "स किङ्किणीकजालेन महता चारुदर्शनः।\nपपात रुचिरः सिंहो भीमसेनस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2066158, "chapter_id": 2397, "verse_number": "९-१५-४१", "content_sanskrit": "पुनश्चास्य धनुश्चित्रं गजराजकरोपमम्।\nक्षुरेण शितधारेण प्रचकर्त नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2066159, "chapter_id": 2397, "verse_number": "९-१५-४२", "content_sanskrit": "स च्छिन्नधन्वा तेजस्वी रथशक्त्या सुतं तव।\nबिभेदोरसि विक्रम्य स रथोपस्थ आविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2066160, "chapter_id": 2397, "verse_number": "९-१५-४३", "content_sanskrit": "तस्मिन्मोहमनुप्राप्ते पुनरेव वृकोदरः।\nयन्तुरेव शिरः कायात्क्षुरप्रेणाहरत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2066161, "chapter_id": 2397, "verse_number": "९-१५-४४", "content_sanskrit": "हतसूता हयास्तस्य रथमादाय भारत।\nव्यद्रवन्त दिशो राजन्हाहाकारस्तदाऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2066162, "chapter_id": 2397, "verse_number": "९-१५-४५", "content_sanskrit": "तमभ्यधावंस्त्राणार्थं द्रोणपुत्रो महारथः।\nकृपश्च कृतवर्मां च पुत्रं ते हि परीप्सवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2066163, "chapter_id": 2397, "verse_number": "९-१५-४६", "content_sanskrit": "तस्मिन्विलुलिते सैन्ये त्रस्तांस्तस्य पदानुगान्।\nगाण्डीवधन्वा विस्फार्य धनुस्तानहनच्छरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2066164, "chapter_id": 2397, "verse_number": "९-१५-४७", "content_sanskrit": "युधिष्ठिरस्तु मद्रेशमभ्यधावदमर्षितः।\nस्वयं सन्नोदयन्नश्वान्दन्तवर्णान्मनोजवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2066165, "chapter_id": 2397, "verse_number": "९-१५-४८", "content_sanskrit": "तत्राश्चर्यपमश्याम कुन्तीपुत्रे युधिष्ठिरे।\nपुरा भूत्वा मृदुर्दान्तो यत्तदा दारुणोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2066166, "chapter_id": 2397, "verse_number": "९-१५-४९", "content_sanskrit": "विवृताक्षश्च कौन्तेयो वेपमानश्च मन्युना।\nचिच्छेद योधान्निशितैः शरैः शतसहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2066167, "chapter_id": 2397, "verse_number": "९-१५-५०", "content_sanskrit": "यांयां प्रत्युद्ययौ सेनां तांतां ज्येष्ठः स पाण्डवः।\nशरैरपातयद्राजन्गिरीन्वज्रैरिवोत्तमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2066168, "chapter_id": 2397, "verse_number": "९-१५-५१", "content_sanskrit": "साश्वसूतध्वजरथान्रथिनः पातयन्बहून्।\nअक्रीडदेको बलवान्पवनस्तोयदानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2066169, "chapter_id": 2397, "verse_number": "९-१५-५२", "content_sanskrit": "साश्वारोहांश्च तुरगान्पत्तींश्चैव सहस्रधा।\nव्यपोथयत सङ्ग्रामे क्रुद्धो रुद्रः पशूनिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2066170, "chapter_id": 2397, "verse_number": "९-१५-५३", "content_sanskrit": "शून्यमायोधनं कृत्वा शरवर्षैः समन्ततः।\nअभ्यद्रवत मद्रेशं तिष्ठतिष्ठेति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2066171, "chapter_id": 2397, "verse_number": "९-१५-५४", "content_sanskrit": "तस्य तच्चरितं दृष्ट्वा संग्रामे भीमकर्मणः।\nवित्रेसुस्तावकाः सर्वे शल्यस्त्वेनं समभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2066172, "chapter_id": 2397, "verse_number": "९-१५-५५", "content_sanskrit": "ततस्तौ भृशसङ्क्रुद्धौ प्रध्माय सलिलोद्भवौ।\nसमाहूय तदाऽन्योन्यं भर्त्सयन्तौ समीयतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2066173, "chapter_id": 2397, "verse_number": "९-१५-५६", "content_sanskrit": "शल्यस्तु शरवर्षेण पीडयामास पाण्डवम्।\nमद्रराजं तु कौन्तेयः शरवर्षैरवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2066174, "chapter_id": 2397, "verse_number": "९-१५-५७", "content_sanskrit": "अदृश्येतां तदा राजन्कङ्कपत्रिभिराचितौ।\nउद्भिन्नरुधिरौ शूरौ मद्रराजयुधिष्ठिरौ।\nपुष्पिताविव रेजाते वने शाल्मलिकिंशुकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2066175, "chapter_id": 2397, "verse_number": "९-१५-५८", "content_sanskrit": "दीव्यमानौ महात्मानौ प्राणद्यूतेन दुर्मदौ।\nदृष्ट्वा सर्वाणि सैन्यानि नाध्यवस्यंस्तयोर्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2066176, "chapter_id": 2397, "verse_number": "९-१५-५९", "content_sanskrit": "हत्वा मद्राधिपं पार्थो भोक्ष्यतेऽद्य वसुन्धराम्।\nशल्यो वा पाण्डवं हत्वा दद्याद्दुर्योधनाय गाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2066177, "chapter_id": 2397, "verse_number": "९-१५-६०", "content_sanskrit": "इतीव निश्चयो नाभूद्योधानां तत्र भारत।\nप्रदक्षिणमभूत्सर्वं धर्मराजस्य युध्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2066178, "chapter_id": 2397, "verse_number": "९-१५-६१", "content_sanskrit": "ततः शरशतं शल्यो मुमोचाशु युधिष्ठिरे।\nधनुश्चास्य शिताग्रेण बाणेन निरुकृन्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2066179, "chapter_id": 2397, "verse_number": "९-१५-६२", "content_sanskrit": "सोऽन्यत्कार्मुकमादाय शल्यं शरशतैस्त्रिभिः।\nअविध्यत्कार्मुकं चास्य क्षुरेण निरकृन्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2066180, "chapter_id": 2397, "verse_number": "९-१५-६३", "content_sanskrit": "अथास्य निजघानाश्वांश्चतुरो नतपर्वभिः।\nद्वाभ्यामतिशिताग्राभ्यामुभौ तत्पार्ष्णिसारथी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2066181, "chapter_id": 2397, "verse_number": "९-१५-६४", "content_sanskrit": "ततोऽस्य दीप्यमानेन पीतेन निशितेन च।\nप्रमुखे वर्तमानस्य भल्लेनापाहरद्वृजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2066182, "chapter_id": 2397, "verse_number": "९-१५-६५", "content_sanskrit": "ततः प्रभग्नं तत्सैन्यं दौर्योधनमरिन्दम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2066183, "chapter_id": 2397, "verse_number": "९-१५-६६", "content_sanskrit": "ततो मद्राधिपं द्रौणिरभ्यधावत्तथा कृतम्।\nआरोप्य चैनं स्वरथं त्वरमाणः प्रदुद्रुवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2066184, "chapter_id": 2397, "verse_number": "९-१५-६७", "content_sanskrit": "मुहूर्तमिव तौ गत्वा नर्दमाने युधिष्ठिरे।\nगत्वा ततो मद्रपतिरन्यं स्यन्दनमास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2066185, "chapter_id": 2397, "verse_number": "९-१५-६८", "content_sanskrit": "विधिवत्कल्पितं शुभ्रं महाम्बुदनिनादिनम्।\nसज्जयन्त्रोपकरणं द्विषतां रोमहर्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2066186, "chapter_id": 2397, "verse_number": "९-१५-६९", "content_sanskrit": "तथान्यद्धनुरादाय बलवान्वेगवत्तरम्॥\nयुधिष्ठिरं मद्रपतिर्भित्त्वा सिंह इवानदत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2066187, "chapter_id": 2397, "verse_number": "९-१५-७०", "content_sanskrit": "ततः स शरवर्षेण पर्जन्य इव वृष्टिमान्।\nअभ्यवर्षदमेयात्मा क्षत्रियान्क्षत्रियर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2066188, "chapter_id": 2397, "verse_number": "९-१५-७१", "content_sanskrit": "सात्यकिं दशभिर्विद्ध्वा भीमसेनं त्रिभिः शरैः।\nसहदेवं त्रिभिर्विद्धा युधिष्ठिरमपीडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2066189, "chapter_id": 2397, "verse_number": "९-१५-७२", "content_sanskrit": "तांस्तानन्यान्महेष्वासान्साश्वान्सरथकूबरान्।\nअर्दयामास विशिखैरुल्काभिरिव कुञ्जरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2066190, "chapter_id": 2397, "verse_number": "९-१५-७३", "content_sanskrit": "कुञ्जरान्कुञ्जरारोहानश्वप्रयायिनः।\nरथांश्च रथिभिः सार्धं जघान रथिनां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2066191, "chapter_id": 2397, "verse_number": "९-१५-७४", "content_sanskrit": "बाहूंश्चिच्छेद तरसा सायुधान्केतनानि च।\nचकार च महीं योधैः स्तीर्णां वेदीं कुशैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2066192, "chapter_id": 2397, "verse_number": "९-१५-७५", "content_sanskrit": "तथा तमरिसैन्यानि घ्नन्तं मृत्युमिवान्तकम्।\nपरिवव्रुर्भृशं क्रुद्धाः पाण्डुपाञ्चालसोमकाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2066193, "chapter_id": 2397, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि शल्यवधपर्वणि अष्टादशदिवसयुद्धे पञ्चदशोऽध्यायः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]