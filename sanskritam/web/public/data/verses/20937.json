[{"id": 7000937000, "chapter_id": 20937, "verse_number": "७-२५-१", "content_sanskrit": "जैमिनिरुवाच ।\nभूय एव महाभाग तुलस्याः पापनाशनम् ।\nअतिथेः पूजनस्यापि माहात्म्यं ब्रूहि विस्तरात् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000937001, "chapter_id": 20937, "verse_number": "७-२५-२", "content_sanskrit": "सूत उवाच ।\nततो व्यासो महातेजास्तुलस्या द्विजसत्तम ।\nमाहात्म्यं वक्तुमारेभे शृण्वतां पापनाशनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000937002, "chapter_id": 20937, "verse_number": "७-२५-३", "content_sanskrit": "व्यास उवाच ।\nइयं साक्षान्महालक्ष्मीस्तुलसी भगवत्प्रिया ।\nतस्मादिमां न पश्यंति वृक्षज्ञानेन जैमिने ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000937003, "chapter_id": 20937, "verse_number": "७-२५-४", "content_sanskrit": "सदैव तुलसीं मर्त्यो यथैव भुवि सेवते ।\nतथैव सेन्द्रा विबुधाः सेवंते तं सुरालये ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000937004, "chapter_id": 20937, "verse_number": "७-२५-५", "content_sanskrit": "परब्रह्मस्वरूपेयं तुलसी यत्र तिष्ठति ।\nतत्रैव कुशलं सर्वं सुदृढं प्रोच्यते मया ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000937005, "chapter_id": 20937, "verse_number": "७-२५-६", "content_sanskrit": "प्राप्नोति मृत्युकाले यस्तोयं पातकवानपि ।\nतुलसीपत्रगलितं स याति हरिसन्निधिम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000937006, "chapter_id": 20937, "verse_number": "७-२५-७", "content_sanskrit": "तुलसीमृत्तिकापुण्ड्रं यो मृत्युसमये वहेत् ।\nस मुक्तः सकलैः पापैः पुरं गच्छति चक्रिणः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000937007, "chapter_id": 20937, "verse_number": "७-२५-८", "content_sanskrit": "यस्य स्यात्तुलसीपत्रं मुखे शिरसि कर्णयोः ।\nमृत्युकाले द्विजश्रेष्ठ तस्य स्वामी न भास्करिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000937008, "chapter_id": 20937, "verse_number": "७-२५-९", "content_sanskrit": "पवित्रनामा सुमतिर्बभूव परमार्थवित् ।\nबभूव ब्राह्मणी तस्य बहुला नाम धारिणी ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000937009, "chapter_id": 20937, "verse_number": "७-२५-१०", "content_sanskrit": "सद्वंशप्रभवा साध्वी पतिसेवापरायणा ।\nअनपत्यपतिर्नाम तत्रैकोस्ति द्विजोत्तमः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000937010, "chapter_id": 20937, "verse_number": "७-२५-११", "content_sanskrit": "सख्यं तेन पवित्रोऽसौ चकार द्विजसेविना ।\nततोऽनपत्यपतिना कथालोभेन सत्तमः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000937011, "chapter_id": 20937, "verse_number": "७-२५-१२", "content_sanskrit": "उपविष्टः पवित्रोऽसौ स्नेहादेकवरासने ।\nतत्रांतरे महातेजा लोमशो नाम स द्विजः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000937012, "chapter_id": 20937, "verse_number": "७-२५-१३", "content_sanskrit": "कथयंतौ कथाश्चित्राः समागत्य ददर्श तौ ।\nअथ तं लोमशं विप्रं विप्रावुत्थाय पीठतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000937013, "chapter_id": 20937, "verse_number": "७-२५-१४", "content_sanskrit": "पाद्यार्घ्याचमनीयाद्यैः पूजयामासतुश्च तौ ।\nसुप्रीतो लोमशस्ताभ्यां नारायणपरायणः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000937014, "chapter_id": 20937, "verse_number": "७-२५-१५", "content_sanskrit": "उवास ब्राह्मणश्रेष्ठ आसने कीर्तयन्हरिम् ।\nआसनस्थं महात्मानं लोमशं तं कृताञ्जलिम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000937015, "chapter_id": 20937, "verse_number": "७-२५-१६", "content_sanskrit": "पवित्रानापत्यमुनी भक्त्या प्राहतुर्लोमशम् ।\nभगवन्सर्वधर्मज्ञ त्वत्पादयुगलैर्नृभिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000937016, "chapter_id": 20937, "verse_number": "७-२५-१७", "content_sanskrit": "सद्भिर्ग्राह्यैराश्रमोऽयं पूतोऽभून्नूनमावयोः ।\nकृतानि यानि पापानि आवाभ्यां मोहतः पुरा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000937017, "chapter_id": 20937, "verse_number": "७-२५-१८", "content_sanskrit": "तानि सर्वाणि नष्टानि त्वत्पादयुगदर्शनात् ।\nभवान्नारायणः साक्षात्पूजनीयोऽमरैरपि ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000937018, "chapter_id": 20937, "verse_number": "७-२५-१९", "content_sanskrit": "सम्यक्ते पूजनं कर्तुं किमावां मानुषौ क्षमौ ।\nअतिथेर्या कृता पूजा तेऽस्माभिर्निजशक्तितः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000937019, "chapter_id": 20937, "verse_number": "७-२५-२०", "content_sanskrit": "अनया भव सुप्रीतः क्षमस्व दोषमावयोः ।\nइत्युक्त्वा तौ महात्मानौ तस्यागंतोः पदद्वये ।\nनिपेततुर्द्विजश्रेष्ठ वयस्यौ गृहमेधिनौ ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000937020, "chapter_id": 20937, "verse_number": "७-२५-२१", "content_sanskrit": "व्यास उवाच ।\nततो भक्त्या सुसंतुष्टो लोमशो विदुषांवरः ।\nयुवां विनयिनां श्रेष्ठौ द्विजाग्र्यौ धर्मतत्परौ ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000937021, "chapter_id": 20937, "verse_number": "७-२५-२२", "content_sanskrit": "आप्यायितोऽस्मि सुतरां युवयोर्विनयोक्तिभिः ।\nसाक्षाद्ब्रह्मा शिवो विष्णुरतिथिः प्रोच्यते बुधैः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000937022, "chapter_id": 20937, "verse_number": "७-२५-२३", "content_sanskrit": "तस्मिन्नेतावतीभक्तिर्युवयोरस्तु मङ्गलम् ।\nआराधितोऽस्म्यहंसम्यगतिथिर्भूरिभोजनैः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000937023, "chapter_id": 20937, "verse_number": "७-२५-२४", "content_sanskrit": "व्यास उवाच ।\nतत उत्थाय तौ विप्रौ तत्पादकमलद्वये ।\nभूयोऽपि तं नमस्कृत्य प्राहतुर्लोमशं मुनिम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000937024, "chapter_id": 20937, "verse_number": "७-२५-२५", "content_sanskrit": "ब्राह्मणावूचतुः ।\nब्रह्मन्नतिथिपूजाया माहात्म्यं वक्तुमर्हसि ।\nयां कृत्वा प्राप्यते मुक्तिर्दुःखलभ्यापि मानवैः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000937025, "chapter_id": 20937, "verse_number": "७-२५-२६", "content_sanskrit": "कोऽतिथिः प्रोच्यते लोके तस्य पूजा च कीदृशी ।\nआतिथेयोऽतिथिश्चेमौ लभेते कामुभौ गतिम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000937026, "chapter_id": 20937, "verse_number": "७-२५-२७", "content_sanskrit": "लोमश उवाच ।\nवानप्रस्थो ब्रह्मचारी भिक्षुश्चैषां प्रपूजनात् ।\nनिरुच्यते गृहं श्रेष्ठमाश्रमेषु चतुर्ष्वपि ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000937027, "chapter_id": 20937, "verse_number": "७-२५-२८", "content_sanskrit": "चतुराश्रममध्येषु प्रधाना गृहिणो मताः ।\nतैश्चातिथीनां कर्तव्या पूजा भक्तिसमन्वितैः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000937028, "chapter_id": 20937, "verse_number": "७-२५-२९", "content_sanskrit": "गृहिणां परमो धर्मः प्रोक्तश्चातिथिपूजनम् ।\nआश्रमाचारतोऽभ्रष्टास्ततस्ते गृहिणो मताः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000937029, "chapter_id": 20937, "verse_number": "७-२५-३०", "content_sanskrit": "वंहत्यतिथिपूजायां दक्षतां गृहिणो यदि ।\nतदा प्रयोजनं तेषां किमन्यैः पुण्यकर्मभिः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000937030, "chapter_id": 20937, "verse_number": "७-२५-३१", "content_sanskrit": "यस्य न श्रूयते नाम न च गोत्रं न च स्थितिः ।\nअकस्माद्गृहमागच्छेत्सोऽतिथिः प्रोच्यते बुधैः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000937031, "chapter_id": 20937, "verse_number": "७-२५-३२", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वापि वैश्या वा वृषलास्तथा ।\nगृहागताः पूजिताश्च विष्णुवत्तत्त्वदर्शिभिः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000937032, "chapter_id": 20937, "verse_number": "७-२५-३३", "content_sanskrit": "चाण्डालप्रमुखा येऽन्ये हीनवर्णसमुद्भवाः ।\nविष्णुवत्पूजितव्यास्ते पाद्यार्घ्यैर्भूरिभोजनैः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000937033, "chapter_id": 20937, "verse_number": "७-२५-३४", "content_sanskrit": "समागतेष्वतिथिषु प्रयाणं कुरुते गृही ।\nअपि स त्वरया दद्यात्पाद्यार्घ्यादीनि च द्विजः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000937034, "chapter_id": 20937, "verse_number": "७-२५-३५", "content_sanskrit": "कुर्याच्च कुशलं प्रश्नं वचनैः कोमलाक्षरैः ।\nकारयेद्भोजनं वापि दिव्यरत्नैर्मुदा गृही ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000937035, "chapter_id": 20937, "verse_number": "७-२५-३६", "content_sanskrit": "सुखदे मन्दिरे तस्य शयनं कारयेद्बुधः ।\nप्रातर्जिगमिषुं दृष्ट्वा तमायांतं विवर्जयेत् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000937036, "chapter_id": 20937, "verse_number": "७-२५-३७", "content_sanskrit": "यदि कर्मविपाकेन गृही भवति वित्तवान् ।\nअतिथ्येनातिथिः पूज्यस्तदहं वच्मि सत्तमौ ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000937037, "chapter_id": 20937, "verse_number": "७-२५-३८", "content_sanskrit": "समागतेष्वतिथिषु भक्त्या दद्यात्तृणादिकम् ।\nतृणाभावेन वै ब्रूयाद्भूमौ तिष्ठेति भक्तितः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000937038, "chapter_id": 20937, "verse_number": "७-२५-३९", "content_sanskrit": "पादप्रक्षालनार्थं तुदद्यादुदकमुत्तमम् ।\nअतो मधुरया वाचा पृच्छेच्च कुशलादिकम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000937039, "chapter_id": 20937, "verse_number": "७-२५-४०", "content_sanskrit": "फलादिकं ततो दद्याद्भक्त्या भोजनहेतवे ।\nतदभावेन मतिमान्मुदा विप्र प्रकाशयेत् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000937040, "chapter_id": 20937, "verse_number": "७-२५-४१", "content_sanskrit": "वदेच्चाहं महापापी दरिद्र प्रवरोऽतिथे ।\nकर्त्तुमिच्छामि भक्तिं ते दैवतंत्रंविरोधकम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000937041, "chapter_id": 20937, "verse_number": "७-२५-४२", "content_sanskrit": "अनेन विधिना दीनः सत्यक्त्वातिथिपूजनम् ।\nस्वाचारपतितो नान्यो यथोक्तं फलमाप्नुयात् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000937042, "chapter_id": 20937, "verse_number": "७-२५-४३", "content_sanskrit": "अनर्चितोऽतिथिर्यस्य गच्छेद्वै गृहिणो गृहात् ।\nजन्मकोट्यर्जितं पुण्यं तस्य गच्छति संक्षयम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000937043, "chapter_id": 20937, "verse_number": "७-२५-४४", "content_sanskrit": "एक एवातिथिर्येन भक्तिभावेन पूज्यते ।\nहरेत्तस्य हरिः सद्यो पातकं कोटिजन्मजम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000937044, "chapter_id": 20937, "verse_number": "७-२५-४५", "content_sanskrit": "सत्यं वच्मि हितं वच्मि दृढं वच्मि प्रयत्नतः ।\nविनातिथिसपर्याभिर्गृहिणो नास्ति वा गतिः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000937045, "chapter_id": 20937, "verse_number": "७-२५-४६", "content_sanskrit": "सत्यं सत्यं पुनः सत्यमागंतुपूजया विना ।\nगतिर्नास्त्येव नास्त्येव नास्त्येव गृहिधर्मिणाम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000937046, "chapter_id": 20937, "verse_number": "७-२५-४७", "content_sanskrit": "ज्ञातिधर्म इति ख्यातो वल्लभो द्वापरे युगे ।\nबभूव सर्वधर्मज्ञस्तस्य श्रीवल्लभाह्वया ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000937047, "chapter_id": 20937, "verse_number": "७-२५-४८", "content_sanskrit": "तेन सर्वाणि कर्माणि कृतानि ज्ञातिसेविना ।\nसौराष्ट्रे वसतिं चक्रे तया सह सभार्यया ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000937048, "chapter_id": 20937, "verse_number": "७-२५-४९", "content_sanskrit": "तत्र दुर्ग्रहसंचाराद्द्वादशाब्दं च वासवः ।\nन ववर्षांबु तेनासीद्दुर्भिक्षं सुमहद्द्विजौ ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000937049, "chapter_id": 20937, "verse_number": "७-२५-५०", "content_sanskrit": "तस्मिन्महति दुर्भिक्षे लोकास्तद्देशवासिनः ।\nबभूवुर्दुःखिताः सर्वे मर्यादामपि तत्यजुः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000937050, "chapter_id": 20937, "verse_number": "७-२५-५१", "content_sanskrit": "ज्ञानभद्रो महायोगी युगे द्वापर संज्ञके ।\nदुर्भिक्षहृतसंपत्तिर्बभूवात्यन्तदुःखितः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000937051, "chapter_id": 20937, "verse_number": "७-२५-५२", "content_sanskrit": "क्षुधाकुलान्सुतान्दृष्ट्वा दारांश्च द्विजसंमतौ ।\nफलमूलादनार्थाय जगामोत्पत्यकां गिरेः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000937052, "chapter_id": 20937, "verse_number": "७-२५-५३", "content_sanskrit": "गिरेरुपत्यकाप्रांते चिरायुः स बुभुक्षितः ।\nकूष्माण्डफलमेकं च लेभे ब्राह्मणसत्तमौ ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000937053, "chapter_id": 20937, "verse_number": "७-२५-५४", "content_sanskrit": "समादाय फलं तच्च हर्षितोऽसौ निजालयम् ।\nजवैर्जगाम विप्रेन्द्रो ज्ञानभद्रो महायशाः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000937054, "chapter_id": 20937, "verse_number": "७-२५-५५", "content_sanskrit": "एतस्मिन्नन्तरे विप्र मेघैर्न्नीलपदैरिव ।\nआवृते गगने वृष्टिर्महासारैर्बभूव ह ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000937055, "chapter_id": 20937, "verse_number": "७-२५-५६", "content_sanskrit": "स मुनिश्च तया वृष्ट्या प्लाविताखिलविग्रह ।\nवनाद्वनचरः कश्चिच्छीतार्तश्चाययौ गृहम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000937056, "chapter_id": 20937, "verse_number": "७-२५-५७", "content_sanskrit": "दृष्ट्वातिथिं तु शीतार्तं ववंदे शिरसा ततः ।\nददौ तृणासनं भक्त्या तस्मै पाद्यादिकं ततः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000937057, "chapter_id": 20937, "verse_number": "७-२५-५८", "content_sanskrit": "ततो मधुरया वाचा तेनैवातिथिना सह ।\nतस्थौ स्वस्थेन मनसा प्रज्ञालापं प्रकुर्वता ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000937058, "chapter_id": 20937, "verse_number": "७-२५-५९", "content_sanskrit": "गृहिण्या सह गोपेन स्वामिसेवा सुदक्षया ।\nततः कूष्माण्डकं नव्यं पक्वमत्यंत यत्नतः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000937059, "chapter_id": 20937, "verse_number": "७-२५-६०", "content_sanskrit": "संप्राप्य हर्षिता साध्वी ददौ भागं विधाय सा ।\nअथासौ दुर्बलो गोपो दिनविंशमुपोषणात् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000937060, "chapter_id": 20937, "verse_number": "७-२५-६१", "content_sanskrit": "आतिथेयो महाभागं ददौ चातिथये मुदा ।\nततस्तद्गृहिणी साध्वी स्वामिभक्तिपरायणा ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000937061, "chapter_id": 20937, "verse_number": "७-२५-६२", "content_sanskrit": "ददौ सा पतितं भागं तस्मै चातिथये मुदा ।\nअथातिथेस्तयोस्तत्र दंपत्योः सुमहात्मनोः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000937062, "chapter_id": 20937, "verse_number": "७-२५-६३", "content_sanskrit": "अभूद्भागद्वयं भुक्त्वा सुप्रीतो द्विजसत्तम ।\nविष्णुवत्पूजितस्ताभ्यां सोऽतिथिर्दृढभक्तितः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000937063, "chapter_id": 20937, "verse_number": "७-२५-६४", "content_sanskrit": "विश्रामं रात्रौ तत्रैव प्रातः स्नात्वा चिरं ययौ ।\nगतैवमुपवासेन दिनानामेकविंशतिः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000937064, "chapter_id": 20937, "verse_number": "७-२५-६५", "content_sanskrit": "दंपती तौ महात्मानौ पंचतां ययतुस्ततः ।\nतेन पुण्यप्रभावेण दंपती तौ महाशयौ ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000937065, "chapter_id": 20937, "verse_number": "७-२५-६६", "content_sanskrit": "प्रापतुर्विष्णुसायुज्यं दुर्ल्लभं योगिनामपि ।\nतयोः पुण्यप्रभावेण विहितातिथिपूजया ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000937066, "chapter_id": 20937, "verse_number": "७-२५-६७", "content_sanskrit": "तस्मिन्राज्ये तु दुर्भिक्षं विनष्टमभवत्ततः ।\nअत्यंतसुखिनोलोकाः शोकव्याधिविवर्जिताः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000937067, "chapter_id": 20937, "verse_number": "७-२५-६८", "content_sanskrit": "धनधान्यादिसम्पन्ना बभूवुर्धर्मतत्पराः ।\nविनष्टा दस्यवस्तत्र नृपोऽभूल्लोकपालकः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000937068, "chapter_id": 20937, "verse_number": "७-२५-६९", "content_sanskrit": "निजाचाररतालोका जलदाः कामवर्षिणः ।\nपूर्वजाः कोटिपुरुषास्तथैवापरजास्तयोः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000937069, "chapter_id": 20937, "verse_number": "७-२५-७०", "content_sanskrit": "तेनैव कर्मणा मुक्तिं जग्मुः पापविवर्जिताः ।\nनिर्दोषा धनसंपन्नाः सर्वलोकैकपूजिताः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000937070, "chapter_id": 20937, "verse_number": "७-२५-७१", "content_sanskrit": "शोकव्याधिविहीना च ववृधे संततिस्तयोः ।\nलोमश उवाच ।\nआगंतुपूजामाहात्म्यं सेतिहासं मयोदितम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000937071, "chapter_id": 20937, "verse_number": "७-२५-७२", "content_sanskrit": "युवयोः प्रीतयोर्विप्रौ किमन्यच्छ्रोतुमिच्छथ ।\nव्यास उवाच ।\nइति ब्रुवति वै तस्मिंल्लोमशे तपसां धने ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000937072, "chapter_id": 20937, "verse_number": "७-२५-७३", "content_sanskrit": "कालग्रस्तः कृष्णआखुस्तत्रोत्तस्थौ बिलान्निजात् ।\nतमुत्थितं बिलात्कृष्णमूषकं क्रोधविह्वलः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000937073, "chapter_id": 20937, "verse_number": "७-२५-७४", "content_sanskrit": "पवित्रस्तत्र चोत्तस्थौ वदन्निति मुहुर्मुहुः ।\nअयं पापाशयो दुष्टो मूषको निशि चाश्रमम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000937074, "chapter_id": 20937, "verse_number": "७-२५-७५", "content_sanskrit": "खनते तीक्ष्णदंतौघैर्गृहद्रव्यं च कृंतति ।\nसर्वेषामेव वर्णानां कृपा श्रेष्ठा प्रकीर्तिता ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000937075, "chapter_id": 20937, "verse_number": "७-२५-७६", "content_sanskrit": "सा च सर्वेषु कर्तव्या न च दुष्टेषु जंतुषु ।\nइत्युक्त्वासौ मूषिकं तं द्विजश्रेष्ठ कृतैनसम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000937076, "chapter_id": 20937, "verse_number": "७-२५-७७", "content_sanskrit": "नाराचेनातितीक्ष्णेन प्राप्तकालं जघान ह ।\nस्रवच्छोणितधाराभिः प्लाविताङ्गः स मूषकः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000937077, "chapter_id": 20937, "verse_number": "७-२५-७८", "content_sanskrit": "पपात भूमौ विप्रर्षे व्यथया हतचेतनः ।\nआखौ निपतिते तस्मिन्दयालुर्द्विजसत्तमः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000937078, "chapter_id": 20937, "verse_number": "७-२५-७९", "content_sanskrit": "हाहाकारं ततः कृत्वा समुत्तस्थौ जवेन सः ।\nनिजकर्णात्समानीय तुलसीपत्रमुत्तमम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000937079, "chapter_id": 20937, "verse_number": "७-२५-८०", "content_sanskrit": "तस्याखोर्वदने शीर्षे कर्णयोश्च प्रदत्तवान् ।\nमातस्तु तुलसीदेवि गोगिन्दह्लादकारिणि ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000937080, "chapter_id": 20937, "verse_number": "७-२५-८१", "content_sanskrit": "अस्याखोः कृतपापस्य कुरु त्वं गतिमुत्तमाम् ।\nइत्युक्त्वा सद्विजश्रेष्ठ सर्वलोकोपकारकः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000937081, "chapter_id": 20937, "verse_number": "७-२५-८२", "content_sanskrit": "हरेनारायणानन्त इत्युच्चैरकरोद्ध्वनिम् ।\nतुलसीपत्रसंस्पर्शान्मूषको वीतकल्मषः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000937082, "chapter_id": 20937, "verse_number": "७-२५-८३", "content_sanskrit": "श्रवणाद्धरिनाम्नश्च मुक्तोऽभूद्भवबंधनात् ।\nततो दूता महाविष्णोः सर्वलक्षणसंयुताः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000937083, "chapter_id": 20937, "verse_number": "७-२५-८४", "content_sanskrit": "आजग्मुः सुरथैः शीघ्रं नेतुं तं गतकल्मषम् ।\nसमारुह्य रथं दिव्यं विष्णुदूतगणैर्वृताः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000937084, "chapter_id": 20937, "verse_number": "७-२५-८५", "content_sanskrit": "जगाम परमं स्थानं मूषको द्विजसत्तम ।\nयुगकोटिसहस्राणि स्थित्वा नारायणाश्रमे ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000937085, "chapter_id": 20937, "verse_number": "७-२५-८६", "content_sanskrit": "ज्ञानमासाद्य तत्रैव मोक्षमाखुर्जगाम सः ।\nव्यास उवाच ।\nमाहात्म्यं तुलसीदेव्याः कथितं ते द्विजोत्तम ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000937086, "chapter_id": 20937, "verse_number": "७-२५-८७", "content_sanskrit": "इदानीं ब्रूहि किं श्रोतुं महाभागत्वमिच्छसि ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}]