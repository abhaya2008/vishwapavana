[{"id": 2167147, "chapter_id": 4590, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2167148, "chapter_id": 4590, "verse_number": "१", "content_sanskrit": "हते द्रोणे महेष्वासे तस्मिन्नहनि भारत ।\nकृते च मोघसङ्कल्पे द्रोणपुत्रे महारथे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2167149, "chapter_id": 4590, "verse_number": "२", "content_sanskrit": "त्रासयित्वा महाराज कौरवाणामनीकिनीम् ।\nव्यूह्य पार्थः स्वकं सैन्यमतिष्ठद् भ्रातृभिः सह\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2167150, "chapter_id": 4590, "verse_number": "३", "content_sanskrit": "तमवस्थितमाज्ञाय पुत्रस्ते भरतर्षभ ।\nद्रवमाणं बलं दृष्ट्वा पौरुषेण न्यवारयत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2167151, "chapter_id": 4590, "verse_number": "४", "content_sanskrit": "स्वमनीकमवस्थाप्य बाहुवीर्यमुपाश्रितः ।\nसंयुद्ध्य सुचिरं कालं पाण्डवैः सह भारत\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2167152, "chapter_id": 4590, "verse_number": "५", "content_sanskrit": "लब्धलक्षैः परैर्हृष्टैः व्यायच्छद्भिश्चिरं तदा ।\nसन्ध्याकालं समासाद्य प्रत्याहारमकारयत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2167153, "chapter_id": 4590, "verse_number": "६", "content_sanskrit": "(निवेश्य बलवद्घोरक्षुत्पिपासाभयैर्युतम् ।\nश्रमेण महता युक्तं तथा द्रोणवधेन च\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2167154, "chapter_id": 4590, "verse_number": "", "content_sanskrit": "दीनरूपा रणे कर्म कृत्वा घोरां च शर्वरीम् ।\nनिवेशं प्राप्य सा सेना विश्रम्य मुदिताऽभवत्\t॥७॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2167155, "chapter_id": 4590, "verse_number": "८", "content_sanskrit": "कृत्वाऽपहारं सैन्यानां प्रविश्य शिबिरं स्वकम् ।\nकुरवः सहिता मन्त्रं मन्त्रयाञ्चक्रिरे मिथः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2167156, "chapter_id": 4590, "verse_number": "९", "content_sanskrit": "पर्यङ्केषु परार्ध्येषु वरास्तरणवत्सु च ।\nउपविष्टेषु तेष्वेवं राजपुत्रेषु भारत\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2167157, "chapter_id": 4590, "verse_number": "१०", "content_sanskrit": "तत्र दुर्योधनो राजा साम्ना परमवल्गुना ।\nतानाभाष्य महेष्वासान् प्राप्तकालमभाषत\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2167158, "chapter_id": 4590, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2167159, "chapter_id": 4590, "verse_number": "११", "content_sanskrit": "मतं मतिमतां श्रेष्ठाः सर्वे प्रब्रूत मा चिरम् ।\nएवं गतेन यत्कार्यं भवेत् कार्यतरं नृपाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2167160, "chapter_id": 4590, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2167161, "chapter_id": 4590, "verse_number": "१२", "content_sanskrit": "एवमुक्ता नरेन्द्रेण नरसिंहा युयुत्सवः ।\nचक्रुर्नानाविधाश्चेष्टाः सिंहासनगतास्तदा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2167162, "chapter_id": 4590, "verse_number": "१३", "content_sanskrit": "इङ्गितानि निशाम्यैषां प्राणान् युद्धे जुहूषताम् ।\nसमुद्वीक्ष्य मुखं राज्ञो बालार्कसमवर्चसम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2167163, "chapter_id": 4590, "verse_number": "१४", "content_sanskrit": "आचार्यपुत्रो मेधावी वाक्यमर्थवदाददे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2167164, "chapter_id": 4590, "verse_number": "", "content_sanskrit": "अश्वत्थामा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2167165, "chapter_id": 4590, "verse_number": "१५", "content_sanskrit": "रागो योगस्तथा दाक्ष्यं नयश्चेत्यर्थसाधकाः ।\nउपायाः पण्डितैः प्रोक्ताः ते तु दैवं समाश्रिताः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2167166, "chapter_id": 4590, "verse_number": "१६", "content_sanskrit": "लोकप्रवीरा येऽस्माकं देवकल्पा महारथाः ।\nनीतिमन्तस्तथा युक्ता रक्ता दक्षाश्च ते हताः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2167167, "chapter_id": 4590, "verse_number": "१७", "content_sanskrit": "न त्वेव कार्यं नैराश्यमस्माभिर्विजयं प्रति ।\nसुनीतैरिह सर्वार्थैर्दैवमप्यनुलोम्यते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2167168, "chapter_id": 4590, "verse_number": "१८", "content_sanskrit": "ते वयं प्रवरं नॄणां सर्वैर्योधगुणैर्युतम् ।\nकर्णमेवाभिषेक्ष्यामः सैनापत्येन भारत ।\nकर्णं सेनापतिं कृत्वा प्रमथिष्यामहे रिपून्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2167169, "chapter_id": 4590, "verse_number": "१९", "content_sanskrit": "एष ह्यतिबलः शूरः कृतास्त्रो युद्धदुर्मदः ।\nवैवस्वत इवासह्यः शक्तो जेतुं रणे रिपून्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2167170, "chapter_id": 4590, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2167171, "chapter_id": 4590, "verse_number": "", "content_sanskrit": "एतदाचार्यतनयाच्छ्रुत्वा राजंस्तवात्मजः ।\n(दुर्योधनो महाराज भृशं प्रीतमनास्तदा\t॥२०॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2167172, "chapter_id": 4590, "verse_number": "२१", "content_sanskrit": "आशां बलवतीं चक्रे कर्णं प्रति महारथम् ।\nहते भीष्मे मृते द्रोणे कर्णो जेष्यति पाण्डवान्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2167173, "chapter_id": 4590, "verse_number": "२२", "content_sanskrit": "तामेवमाशां हृदये कृत्वाऽऽश्वस्य च भारत\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2167174, "chapter_id": 4590, "verse_number": "२३", "content_sanskrit": "ततो दुर्योधनः प्रीतः प्रियं श्रुत्वाऽस्य तद्वचः ।\nप्रीतिसत्कारसंयुक्तं तथ्यमात्महितं शुभम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2167175, "chapter_id": 4590, "verse_number": "२४", "content_sanskrit": "स्वमनश्च व्यवस्थाप्य बाहुवीर्यमुपाश्रितः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2167176, "chapter_id": 4590, "verse_number": "२५", "content_sanskrit": "(प्रियसत्कारसंयुक्तं तथ्यमात्महिते रतम् ।)\nदुर्योधनो युधां श्रेष्ठो राधेयमिदमब्रवीत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2167177, "chapter_id": 4590, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2167178, "chapter_id": 4590, "verse_number": "२६", "content_sanskrit": "कर्ण जानामि ते वीर्यं सौहृदं च परं मयि ।\nतथाऽपि त्वां महाबाहो प्रवक्ष्यामि हितं वचः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2167179, "chapter_id": 4590, "verse_number": "२७", "content_sanskrit": "श्रुत्वा यथेष्टं कुरु वै वीर यत् तव रोचते ।\nभवान् प्राज्ञतमो नित्यं मम चैव परा गतिः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2167180, "chapter_id": 4590, "verse_number": "२८", "content_sanskrit": "भीष्मद्रोणौ त्वतिरथौ हतौ सेनापती मम ।\nसेनापतिर्भवानस्तु ताभ्यां द्रविणवत्तरः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2167181, "chapter_id": 4590, "verse_number": "२९", "content_sanskrit": "वृद्धौ च तौ महेष्वासौ सापेक्षौ च धनञ्जये ।\nमानितौ च मया वीरौ राधेय वचनात् तव\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2167182, "chapter_id": 4590, "verse_number": "३०", "content_sanskrit": "पितामहत्वं सम्प्रेक्ष्य पाण्डुपुत्रा महारणे ।\nरक्षितास्तात भीष्मेण दिवसानि दशैव तु\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2167183, "chapter_id": 4590, "verse_number": "३१", "content_sanskrit": "न्यस्तशस्त्रे तु भवति हतो भीष्मः पितामहः ।\nशिखण्डिनं पुरस्कृत्य फल्गुनेन महारणे\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2167184, "chapter_id": 4590, "verse_number": "३२", "content_sanskrit": "हते तस्मिन् महेष्वासे शरतल्पगते पुनः ।\nत्वयोक्तः पुरुषव्याघ्रो द्रोणो ह्यासीत् पुरस्सरः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2167185, "chapter_id": 4590, "verse_number": "३३", "content_sanskrit": "तेनापि रक्षिताः पार्थाः शिष्यत्वादिह संयुगे ।\nस चापि निहतो वृद्धो धृष्टद्युम्नेन सत्वरम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2167186, "chapter_id": 4590, "verse_number": "३४", "content_sanskrit": "निहताभ्यां प्रधानाभ्यां ताभ्यामतुलविक्रम ।\nत्वत्समं समरे योधं नान्यं पश्यामि चिन्तयन्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2167187, "chapter_id": 4590, "verse_number": "३५", "content_sanskrit": "भवानेव च नः शक्तो विजयाय न संशयः ।\nपूर्वं मध्ये तु पश्चाच्च विहितं च स्वकं हितम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2167188, "chapter_id": 4590, "verse_number": "३६", "content_sanskrit": "स भवान् धुर्यवत् सङ्खे धुरमुद्वोढुमर्हति ।\nअभिषेचय सैनान्ये स्वयमात्मानमात्मना\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2167189, "chapter_id": 4590, "verse_number": "३७", "content_sanskrit": "देवतानां यथा स्कन्दः सेनानीः प्रभुरव्ययः ।\nतथा भवानिमां सेनां धार्तराष्ट्रीं बिभर्तु वै\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2167190, "chapter_id": 4590, "verse_number": "३८", "content_sanskrit": "जहि शत्रुगणान् सर्वान् महेन्द्रो दानवानिव\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2167191, "chapter_id": 4590, "verse_number": "३९", "content_sanskrit": "अवस्थितं रणे ज्ञात्वा पाण्डवास्त्वां महारथाः ।\nद्रविष्यन्ति सपाञ्चाला विष्णुं दृष्ट्वेव दानवाः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2167192, "chapter_id": 4590, "verse_number": "४०", "content_sanskrit": "तस्मात् त्वं पुरुषव्याघ्र प्रकर्षेथा महाचमूम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2167193, "chapter_id": 4590, "verse_number": "४१", "content_sanskrit": "भवत्यवस्थिते यत्ते पाण्डवा मन्दचेतसः ।\nद्रविष्यन्ति सहामात्याः पाञ्चालाश्च सकेकयाः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2167194, "chapter_id": 4590, "verse_number": "४२", "content_sanskrit": "यथा ह्यभ्युदितः सूर्यः प्रतपन् स्वेन तेजसा ।\nव्यपोहति तमस्तीव्रं तथा शत्रून् व्यपोहय\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2167195, "chapter_id": 4590, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2167196, "chapter_id": 4590, "verse_number": "४३", "content_sanskrit": "एवमुक्तस्तु राधेयो राज्ञा दुर्योधनेन ह ।\nराज्ञां मध्ये महाबाहुः प्रीतात्मा स महाबलः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2167197, "chapter_id": 4590, "verse_number": "४४", "content_sanskrit": "हर्षयन्नब्रवीत् कर्णो दुर्योधनमिदं वचः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2167198, "chapter_id": 4590, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2167199, "chapter_id": 4590, "verse_number": "४५", "content_sanskrit": "उक्तमेतन्मया पूर्वं गान्धारे तव सन्निधौ ।\nजेष्यामि पाण्डवान् राजन् सपुत्रान् सजनार्दनान्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2167200, "chapter_id": 4590, "verse_number": "४६", "content_sanskrit": "सेनापतिर्भविष्यामि तवाहं नात्र संशयः ।\nस्थिरो भव महाराज जितान् विद्धि च पाण्डवान्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2167201, "chapter_id": 4590, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2167202, "chapter_id": 4590, "verse_number": "४७", "content_sanskrit": "एवमुक्तो महातेजास्तदा दुर्योधनो नृप ।\nउत्तस्थे राजभिः सार्धं देवैरिव शतक्रतुः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2167203, "chapter_id": 4590, "verse_number": "४८", "content_sanskrit": "सैनापत्येन सत्कर्तुं कर्णं स्कन्दमिवामराः ।\nततोऽभिषिषिचुः कर्णं विधिदृष्टेन कर्मणा\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2167204, "chapter_id": 4590, "verse_number": "४९", "content_sanskrit": "दुर्योधनमुखा राजन् राजानो विजयैषिणः ।\nशातकुम्भमयैः कुम्भैः ब्राह्मणैश्चाभिमन्त्रितैः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2167205, "chapter_id": 4590, "verse_number": "५०", "content_sanskrit": "तोयपूर्णैर्विषाणैश्च द्विपखड्गमहर्षभैः ।\nमणिमुक्तामयैर्धान्यैः पुण्यैर्गन्धैस्तथौषधैः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2167206, "chapter_id": 4590, "verse_number": "५१", "content_sanskrit": "औदुम्बरे समासीनमासने क्षौमसंवृते ।\nशास्त्रदृष्टेन विधिना सम्भारैश्च सुसम्भृतैः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2167207, "chapter_id": 4590, "verse_number": "५२", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्यास्तथा शूद्राश्च सम्मताः ।\nतुष्टुवुस्तं महात्मानमभिषिक्तं वरासने\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2167208, "chapter_id": 4590, "verse_number": "५३", "content_sanskrit": "ततोऽभिषिक्तो राजेन्द्र गोभिर्निष्कैर्धनेन च ।\nवाचयामास विप्राग्र्यान् राधेयः परवीरहा\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2167209, "chapter_id": 4590, "verse_number": "५४", "content_sanskrit": "(स व्यरोचत राधेयः सूतमागधवन्दिभिः ।\nस्तूयमानो यथा भानुरुदये ब्रह्मवादिभिः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2167210, "chapter_id": 4590, "verse_number": "५५", "content_sanskrit": "ततः पुण्याहघोषेण वादित्रनिनदेन च ।\nजयशब्देन शूराणां तुमुलः सर्वतोऽभवत्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2167211, "chapter_id": 4590, "verse_number": "५६", "content_sanskrit": "जयेत्यूचुर्नृपाः सर्वे राधेयं तत्र सङ्गताः ।)\nजय पार्थान् सगोविन्दान् सानुबन्धान् महाहवे\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2167212, "chapter_id": 4590, "verse_number": "समाप्तिः", "content_sanskrit": "इति तं वन्दिनः प्राहुर्द्विजाश्च भरतर्षभ\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2167213, "chapter_id": 4590, "verse_number": "", "content_sanskrit": "वन्दिनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2167214, "chapter_id": 4590, "verse_number": "५८", "content_sanskrit": "जय पार्थान् सपाञ्चालान् राधेय विजयाय नः ।\nउद्यन्निव यथाऽऽदित्यः तमांस्युग्रैर्गभस्तिभिः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2167215, "chapter_id": 4590, "verse_number": "५९", "content_sanskrit": "न ह्यलं त्वद्विसृष्टानां शराणां ते सकेशवाः ।\nउलूकाः सूर्यरश्मीनां ज्वलतामिव दर्शने\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2167216, "chapter_id": 4590, "verse_number": "६०", "content_sanskrit": "न च पार्थाः सपाञ्चालाः शक्तास्थातुं तवाग्रतः ।\nआत्तवज्रस्य समरे महेन्द्रस्येव दानवाः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2167217, "chapter_id": 4590, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2167218, "chapter_id": 4590, "verse_number": "६१", "content_sanskrit": "(स सत्कृतः स्तूयमानः सुहृद्गणवृतो वृषा ।\nकर्णो दुर्योधनं वाक्यमब्रवीत् प्रहसन् प्रियम्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2167219, "chapter_id": 4590, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2167220, "chapter_id": 4590, "verse_number": "६२", "content_sanskrit": "दुर्योधनाद्य सगणं पाण्डूनां प्रवरैः सह ।\nफल्गुनं सूदयिष्यामि त्वत्प्रियार्थं सबान्धवम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2167221, "chapter_id": 4590, "verse_number": "६३", "content_sanskrit": "सपर्वतार्णवद्वीपां शाधि गां गतपाण्डवाम् ।\nपुत्रपौत्रप्रपौत्रेषु प्रतिष्ठां गमयिष्यसि\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2167222, "chapter_id": 4590, "verse_number": "", "content_sanskrit": "नासह्यं विद्यते मह्यं त्वत्प्रियार्थमरिन्दम ।\nसत्यधर्मानुरक्तस्य सिद्धिरात्मवतो यथा\t॥६४॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2167223, "chapter_id": 4590, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2167224, "chapter_id": 4590, "verse_number": "६५", "content_sanskrit": "अभिषिक्तस्तु राधेयः प्रभया सोऽमितप्रभः ।\nव्यत्यरिच्यत रूपेण दिवाकर इवापरः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2167225, "chapter_id": 4590, "verse_number": "६६", "content_sanskrit": "सैनापत्ये तु राधेयमभिषिच्य सुतस्तव ।\nअमन्यत तदात्मानं कृतार्थं कालचोदितः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2167226, "chapter_id": 4590, "verse_number": "६७", "content_sanskrit": "कर्णोऽपि राज्ञः सम्प्राप्य सैनापत्यमरिन्दमः ।\nयोगमाज्ञापयामास सूर्यस्योदयनादधि\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2167227, "chapter_id": 4590, "verse_number": "६८", "content_sanskrit": "तव पुत्रैर्वृतः कर्णः शुशुभे तत्र भारत ।\nदेवैरिव यथा स्कन्दः सङ्ग्रामे तारकामये\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2167228, "chapter_id": 4590, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nदशमोऽध्यायः ॥१०॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}]