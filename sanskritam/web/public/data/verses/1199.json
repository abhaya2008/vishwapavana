[{"id": 2009977, "chapter_id": 1199, "verse_number": "१-२००-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2009978, "chapter_id": 1199, "verse_number": "१-२००-१", "content_sanskrit": "ततस्ते नरशार्दूला भ्रातरः पञ्च पाण्डवाः।\nतं ब्राह्मणं पुरस्कृत्य पाञ्चाल्याश्च स्वयंवरम्।\nप्रययुर्द्रौपदीं द्रष्टुं तं च देशं महोत्सवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2009979, "chapter_id": 1199, "verse_number": "१-२००-२", "content_sanskrit": "ततस्ते तं महात्मानं शुद्धात्मानमकल्मषम्।\nददृशुः पाण्डवा वीराः पथि द्वैपायनं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2009980, "chapter_id": 1199, "verse_number": "१-२००-३", "content_sanskrit": "तस्मै यथावत्सत्कारं कृत्वा तेन च सत्कृताः।\nकथान्ते चाभ्यनुज्ञाताः प्रययुर्द्रुपदक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2009981, "chapter_id": 1199, "verse_number": "१-२००-४", "content_sanskrit": "पश्यन्तो रमणीयानि वनानि च सरांसि च।\nतत्रतत्र वसन्तश्च शनैर्जग्मुर्महराथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2009982, "chapter_id": 1199, "verse_number": "१-२००-५", "content_sanskrit": "स्वाध्यायवन्तः शुचयो मधुराः प्रियवादिनः।\nआनुपूर्व्येण संप्राप्ताः पाञ्चालान्पाण्डुनन्दनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2009983, "chapter_id": 1199, "verse_number": "१-२००-६", "content_sanskrit": "ते तु दृष्ट्वा पुरं तच्च स्कन्धावारं च पाण्डवाः।\nकुम्भकारस्य शालायां निवासं चक्रिरे तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2009984, "chapter_id": 1199, "verse_number": "१-२००-७", "content_sanskrit": "तत्र भैक्षं समाजह्रुर्ब्राह्मणीं वृत्तिमाश्रिताः।\nतान्संप्राप्तांस्तथा वीराञ्जज्ञिरे न नराः क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2009985, "chapter_id": 1199, "verse_number": "१-२००-८", "content_sanskrit": "यज्ञसेनस्तु पाञ्चालो भीष्मद्रोमकृतागसम्।\nज्ञात्वाऽऽत्मानं तदारेभे त्राणायात्मक्रियां क्षमां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2009986, "chapter_id": 1199, "verse_number": "१-२००-९", "content_sanskrit": "अवाप्य धृष्टद्युम्नं हि न स द्रोणमचिन्तयत्।\nस तु वैरप्रसङ्गाच्च भीष्माद्भयमचिन्तयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2009987, "chapter_id": 1199, "verse_number": "१-२००-१०", "content_sanskrit": "कन्यादानात्तु शरणं सोऽमन्यत महीपतिः।\nयज्ञसेनस्य कामस्तु पाण्डवाय किरीटिने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2009988, "chapter_id": 1199, "verse_number": "१-२००-११", "content_sanskrit": "दास्यामि कृष्मामिति वै न चैनं विवृणोति सः।\nजामातृबलसंयोगं मेने हि बलवत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2009989, "chapter_id": 1199, "verse_number": "१-२००-१२", "content_sanskrit": "सोऽन्वेषमाणः कौन्तेयान्पाञ्चालो जनमेजय।\nदृढं धनुरथानम्यं कारयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2009990, "chapter_id": 1199, "verse_number": "१-२००-१३", "content_sanskrit": "वैयाघ्रपद्यस्योग्रं वै सृञ्जयस्य महीपतिः।\nतद्धनुः किन्धुरं नाम देवदत्तमुपानयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2009991, "chapter_id": 1199, "verse_number": "१-२००-१४", "content_sanskrit": "आयसी तस्य च ज्याऽऽसीत्प्रतिबद्धा महाबला।\nन तु ज्यां प्रसहेदन्यस्तद्धनुःप्रवरं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2009992, "chapter_id": 1199, "verse_number": "१-२००-१५", "content_sanskrit": "शङ्करेण वरं दत्तं प्रीतेन च महात्मना।\nतन्निष्फलं स्यान्न तु मे इति प्रामाण्यमागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2009993, "chapter_id": 1199, "verse_number": "१-२००-१६", "content_sanskrit": "मया कर्तव्यमधुना दुष्करं लक्ष्यवेधनम्।\nइति निश्चित्य मनसा कारितं लक्ष्यमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2009994, "chapter_id": 1199, "verse_number": "१-२००-१७", "content_sanskrit": "यन्त्रं वैहायसं चापि कारयामास कृत्रिमम्।\nतेन यन्त्रेण सहितं राजँल्लक्ष्यं च काञ्चनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2009995, "chapter_id": 1199, "verse_number": "१-२००-१८x", "content_sanskrit": "द्रुपद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2009996, "chapter_id": 1199, "verse_number": "१-२००-१८", "content_sanskrit": "इदं सज्यं धनुः कृत्वा सज्जैरेभिश्च सायकैः।\nअतीत्य लक्ष्य यो वेद्धा स लब्धा मत्सुतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2009997, "chapter_id": 1199, "verse_number": "१-२००-१९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2009998, "chapter_id": 1199, "verse_number": "१-२००-१९", "content_sanskrit": "इति स द्रुपदो राजा स्वयंवरमघोषयत्।\nतच्छ्रुत्वा पार्थिवाः सर्वे समीयुस्तत्र भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2009999, "chapter_id": 1199, "verse_number": "१-२००-२०", "content_sanskrit": "ऋषयश्च महात्मानः स्वयंवरदिदृक्षवः।\nदुर्योधनपुरोगाश्च सकर्णाः कुरवो नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2010000, "chapter_id": 1199, "verse_number": "१-२००-२१", "content_sanskrit": "यादवा वासुदेवेन सार्धमन्धकवृष्णयः।\nततोऽर्चिता राजगुणा द्रुपदेन महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2010001, "chapter_id": 1199, "verse_number": "१-२००-२२", "content_sanskrit": "उपोपविष्टा मञ्चेषु द्रष्टुकामाः स्वयंवरम्।\nब्राह्मणाश्च महाभागा देशेभ्यः समुपागमन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2010002, "chapter_id": 1199, "verse_number": "१-२००-२३", "content_sanskrit": "ब्राह्मणैरेव सहिताः पाण्डवाः समुपाविशन्।\nत्रयस्त्रिंशत्सुराः सर्वे विमानैर्व्योम्न्यवस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2010003, "chapter_id": 1199, "verse_number": "१-२००-२४", "content_sanskrit": "ततः पौरजनाः सर्वे सागरोद्धूतनिःस्वनाः।\nशिंशुमारशिरः प्राप्य न्यविशंस्ते स्म पार्थिवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2010004, "chapter_id": 1199, "verse_number": "१-२००-२५", "content_sanskrit": "प्रागुत्तरेण नगराद्भूमिभागे समे शुभे।\nसमाजवाटः शुशुभे भवनैः सर्वतो वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2010005, "chapter_id": 1199, "verse_number": "१-२००-२६", "content_sanskrit": "प्राकारपरिखोपेतो द्वारतोरणमण्डितः।\nवितानेन विचित्रेण सर्वतः समलङ्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2010006, "chapter_id": 1199, "verse_number": "१-२००-२७", "content_sanskrit": "तूर्यौघशतसङ्कीर्णः परार्ध्यागुरुधूपितः।\nचन्दनोदकसिक्तश्च माल्यदामोपशोभितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2010007, "chapter_id": 1199, "verse_number": "१-२००-२८", "content_sanskrit": "कैलासशिखरप्रख्यैर्नभस्तलविलेखिभिः।\nसर्वतः संवृतः शुभ्रैः प्रासादैः सुकृतोच्छ्रयै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2010008, "chapter_id": 1199, "verse_number": "१-२००-२९", "content_sanskrit": "सुवर्णजालसंवीतैर्मणिकुट्टिमभूषणैः।\nसुखारोहणसोपानैर्महासनपरिच्छदैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2010009, "chapter_id": 1199, "verse_number": "१-२००-३०", "content_sanskrit": "स्रग्दामसमवच्छन्नैरगुरूत्तमवासितैः।\nहंसांशुवर्णैर्बहुभिरायोजनसुगन्धिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2010010, "chapter_id": 1199, "verse_number": "१-२००-३१", "content_sanskrit": "असंबाधशतद्वारैः शयनासनशोभितैः।\nबहुधातुपिनद्धाङ्गैर्हिमवच्छिखरैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2010011, "chapter_id": 1199, "verse_number": "१-२००-३२", "content_sanskrit": "तत्र नानाप्रकारेषु विमानेषु स्वलङ्कृताः।\nस्पर्धमानास्तदाऽन्योन्यं निषेदुः सर्वपार्थिवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2010012, "chapter_id": 1199, "verse_number": "१-२००-३३", "content_sanskrit": "तत्रोपविष्टान्ददृशुर्महासत्वान्पृथग्जनाः।\nराजसिंहान्महाभागान्कृष्णागुरुविभूषितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2010013, "chapter_id": 1199, "verse_number": "१-२००-३४", "content_sanskrit": "महाप्रसादान्ब्राह्मण्यान्स्वराष्ट्रपरिरक्षिणः।\nप्रियान्सर्वस्य लोकस्य सुकृतैः कर्मभिः शुभैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2010014, "chapter_id": 1199, "verse_number": "१-२००-३५", "content_sanskrit": "मञ्चेषु च परार्द्ध्येषु पौरजानपदा जनाः।\nकृष्णादर्शनसिद्ध्यर्थं सर्वतः समुपाविशन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2010015, "chapter_id": 1199, "verse_number": "१-२००-३६", "content_sanskrit": "ब्राह्मणैस्ते च सहिताः पाण्डवाः समुपाविशन्।\nऋद्धिं पञ्चालराजस्य पश्यन्तस्तामनुत्तमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2010016, "chapter_id": 1199, "verse_number": "१-२००-३७", "content_sanskrit": "ततः समाजो ववृधे स राजन्दिवसान्बहून्।\nरत्नप्रदानबहुलः शोभितो नटनर्तकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2010017, "chapter_id": 1199, "verse_number": "१-२००-३८", "content_sanskrit": "वर्तमाने समाजे तु रमणीयेऽह्नि षोडशे।\nमैत्रे मुहूर्ते तस्याश्च राजदाराः पुराविदः।\nपुत्रवत्यः सुवसनाः प्रतिकर्मोपचक्रमुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2010018, "chapter_id": 1199, "verse_number": "१-२००-३९", "content_sanskrit": "वैडूर्यमयपीठे तु निविष्टां द्रौपदीं तदा।\nसतूर्यं स्नापयाञ्चक्रुः स्वर्णकुम्भस्थितैर्जलैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2010019, "chapter_id": 1199, "verse_number": "१-२००-४०", "content_sanskrit": "तां निवृत्ताभिषेकां च दुकूलद्वयधारिणीम्।\nनिन्युर्मणिस्तम्भवतीं वेदिं वै सुपरिष्कृताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2010020, "chapter_id": 1199, "verse_number": "१-२००-४१", "content_sanskrit": "निवेश्य प्राङ्मुखीं हृष्टां विस्मिताक्ष्यः प्रसाधिकाः।\nकेनालङ्करणेनेमामित्यन्योन्यं व्यलोकयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2010021, "chapter_id": 1199, "verse_number": "१-२००-४२", "content_sanskrit": "धूपोष्मणा च केशानामार्द्रभावं व्यपोहयन्।\nबबन्धुरस्या धम्मिल्लं माल्यैः सुरभिगन्धिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2010022, "chapter_id": 1199, "verse_number": "१-२००-४३", "content_sanskrit": "दूर्वामधूकरचितं माल्यं तस्या ददुः करे।\nचक्रुश्च कृष्णागरुणा पत्रसङ्गं कुचद्वये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2010023, "chapter_id": 1199, "verse_number": "१-२००-४४", "content_sanskrit": "रेजे सा चक्रवाकाङ्का स्वर्णदीर्घा सरिद्वरा।\nअलकैः कुटिलैस्तस्या मुखं विकसितं बभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2010024, "chapter_id": 1199, "verse_number": "१-२००-४५", "content_sanskrit": "आसक्तभृङ्गं कुसुमं शशिम्बिम्बं जिगाय तत्।\nकालाञ्जनं नयनयोराचारार्थं समादधुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2010025, "chapter_id": 1199, "verse_number": "१-२००-४६", "content_sanskrit": "भूषणं रत्नखचितैरलंचक्रुर्यथोचितम्।\nमाता च तस्याः पृषती हरितालमनश्शिलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2010026, "chapter_id": 1199, "verse_number": "१-२००-४७", "content_sanskrit": "अङ्गुलीभ्यामुपादाय तिलकं विदधे मुखे।\nअलङ्कृतां वधूं दृष्ट्वा योषितो मुदमाययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2010027, "chapter_id": 1199, "verse_number": "१-२००-४८", "content_sanskrit": "माता न मुमुदे तस्याः पतिः कीदृग्भविष्यति।\nसौविदल्लाः समागम्य द्रुपदस्याज्ञया ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2010028, "chapter_id": 1199, "verse_number": "१-२००-४९", "content_sanskrit": "एनामारोपयामासुः करिणीं कुचभूषिताम्।\nततोऽवाद्यन्त वाद्यानि मङ्गलानि दिवि स्पृशन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2010029, "chapter_id": 1199, "verse_number": "१-२००-५०", "content_sanskrit": "विलासिनीजनाश्चापि प्रवरं करिणीशतम्।\nमाङ्गल्यगीतं गायन्त्यः पार्स्वयोरुभयोर्ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2010030, "chapter_id": 1199, "verse_number": "१-२००-५१", "content_sanskrit": "जनापसरणे व्यग्राः प्रतिहार्यः पुरा ययुः।\nकोलाहलो महानासीत्तस्मिन्पुरवरे तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2010031, "chapter_id": 1199, "verse_number": "१-२००-५२", "content_sanskrit": "धृष्टद्युम्नो ययावग्रे हयमारुह्य भारत।\nद्रुपदो रङ्गदेशे तु बलेन महता युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2010032, "chapter_id": 1199, "verse_number": "१-२००-५३", "content_sanskrit": "तस्थौ व्यूह्य महानीकं पालितं दृढधन्विभिः।\nआप्लुताङ्गीं सुवसनां सर्वाभरणभूषिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2010033, "chapter_id": 1199, "verse_number": "१-२००-५४", "content_sanskrit": "मालां च समुपादाय काञ्चनीं समलङ्कृताम्।\nआगतां ददृशुः सर्वे रङ्गभूमिमलङ्कृताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2010034, "chapter_id": 1199, "verse_number": "१-२००-५५", "content_sanskrit": "अवतीर्णा ततो रङ्गं द्रौपदी भरतर्षभ।\nतस्थौ प्रमुदितान्सर्वान्नृपतीन्रङ्गमण्डले।\nप्रेक्षन्ती व्रीडितापाङ्गी द्रष्टृणां सुमनोहरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2010035, "chapter_id": 1199, "verse_number": "१-२००-५६", "content_sanskrit": "पुरोहितः सोमकानां मन्त्रविद्ब्राह्मणः शुचिः।\nपरिस्तीर्य जुहावाग्निमाज्येन विधिवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2010036, "chapter_id": 1199, "verse_number": "१-२००-५७", "content_sanskrit": "संतर्पयित्वा ज्वलनं ब्राह्मणान्स्वस्ति वाच्य च।\nवारयामास सर्वाणि वादित्राणि समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2010037, "chapter_id": 1199, "verse_number": "१-२००-५८", "content_sanskrit": "निःशब्दे तु कृते तस्मिन्धृष्टद्युम्नो विशांपते।\nकृष्णामादाय विधिवन्मेघदुन्दुभिनिःस्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2010038, "chapter_id": 1199, "verse_number": "१-२००-५९", "content_sanskrit": "रङ्गमध्यं गतस्तत्र मेघगम्भीरया गिरा।\nवाक्यमुच्चैर्जगादेदं श्लक्ष्णमर्थवदुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2010039, "chapter_id": 1199, "verse_number": "१-२००-६०", "content_sanskrit": "इदं धनुर्लक्ष्यमिमे च बाणाः\nशृण्वन्तु मे भूपतयः समेताः।\nछिद्रेण यन्त्रस्य मसर्पयध्वं\nशरैः शितैर्व्योमचरैर्दशार्धैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2010040, "chapter_id": 1199, "verse_number": "१-२००-६१", "content_sanskrit": "एतन्महत्कर्म करोति यो वै\nकुलेन रूपेण बलेन युक्तः।\nतस्याद्य भार्या भगिनी ममेयं\nकृष्णा भवित्री न मृषा ब्रवीमि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2010041, "chapter_id": 1199, "verse_number": "१-२००-६२", "content_sanskrit": "तानेवमुक्त्वा द्रुपदस्य पुत्रः\nपश्चादिदं तां भगिनीमुवाच।\nनाम्ना च गोत्रेण च कर्मणा च\nसंकीर्तयन्भूमिपतीन्समेतान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2010042, "chapter_id": 1199, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि स्वयंवरपर्वणि द्विशततमोऽध्यायः॥ २०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]