[{"id": 7003193000, "chapter_id": 23193, "verse_number": "४-१२९-१", "content_sanskrit": "अथैकोनत्रिंशदधिकशततमोऽध्यायः ।\nनारायण उवाच ।\nश्रीकृष्णो भगवांस्तत्र परिपूर्णतमः प्रभुः ।\nदृष्ट्वा सारोक्यमोक्षं च सद्यो गोकुलवासिनाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003193001, "chapter_id": 23193, "verse_number": "४-१२९-२", "content_sanskrit": "उवास पञ्चभिर्गोपैर्भाण्डीरे वटमूलके ।\nददर्श गोकुलं सर्व गोकुलं व्याकुलं तथा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003193002, "chapter_id": 23193, "verse_number": "४-१२९-३", "content_sanskrit": "अरक्षकं च व्यस्तं च शून्यं वृन्दावनं वनम् ।\nयोगेनामृतवृष्ट्या च कृपया च कृपानिधिः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003193003, "chapter_id": 23193, "verse_number": "४-१२९-४", "content_sanskrit": "गोपीभिश्च तथा गोपैः परिपूर्णं चकार सः ।\nतथा वृन्दावनं चैव सुरम्यं च मनोहरम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003193004, "chapter_id": 23193, "verse_number": "४-१२९-५", "content_sanskrit": "गोकुलस्थाश्च गोपाश्च समाश्वासं चकार सः ।\nउवाच मधुरं वाक्यं हितं नीतं च दुर्लभम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003193005, "chapter_id": 23193, "verse_number": "४-१२९-६", "content_sanskrit": "श्री भगवानुवाच ।\nहे गोपगण हे बन्धो सुखं तिष्ठ स्थिरो भव ।\nरमणं प्रियया सार्धं सुरम्यं रासमण्डलम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003193006, "chapter_id": 23193, "verse_number": "४-१२९-७", "content_sanskrit": "तावत्प्रभृति कृष्णस्य पुण्ये वृन्दावने वने ।\nअधिष्ठानं च सततं यावच्चन्द्रदिवाकरौ ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003193007, "chapter_id": 23193, "verse_number": "४-१२९-८", "content_sanskrit": "तथा जगाम भाण्डीरं विधाता जगतामपि ।\nस्वयं शेषश्च धर्मश्च भवान्या च भवःस्वयम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003193008, "chapter_id": 23193, "verse_number": "४-१२९-९", "content_sanskrit": "सूर्यश्चापि महेन्द्रश्च चन्द्रश्चापि हुनाशनः ।\nकुबेरो वरुणश्चैव पवनश्च यमस्तथा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003193009, "chapter_id": 23193, "verse_number": "४-१२९-१०", "content_sanskrit": "ईशानश्चापि देवाश्च वसवोऽष्टौ तथैव च ।\nसर्वे ग्रहाश्च रुद्राश्च मुनयो मनवस्तथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003193010, "chapter_id": 23193, "verse_number": "४-१२९-११", "content_sanskrit": "त्वरिताश्चाऽऽययुः सर्वे यत्राऽऽस्ते भगवान्प्रभुः ।\nप्रणम्य दण्डवद्भूभौ तमुवाच विधिः स्वयम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003193011, "chapter_id": 23193, "verse_number": "४-१२९-१२", "content_sanskrit": "ब्रह्मवाच ।\nपरिबूर्णतम् ब्रह्मस्वरूप नित्यविग्रह ।\nज्योतिःस्वरूप परम नमोऽस्तु प्रकृतेः पर ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003193012, "chapter_id": 23193, "verse_number": "४-१२९-१३", "content_sanskrit": "सुनिर्लिप्त निराकार साकार ध्यानहेतुना ।\nस्वेच्छामय परं धाम परमात्मन्नमोऽस्तु ते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003193013, "chapter_id": 23193, "verse_number": "४-१२९-१४", "content_sanskrit": "सर्वकार्यस्वरूपेश कारणानां च कारण ।\nब्रह्मेशशेषदेवेश सर्वेश ते नमः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003193014, "chapter_id": 23193, "verse_number": "४-१२९-१५", "content_sanskrit": "सरस्वतीश पद्मेश पार्वतीश परात्पर ।\nहे सावित्रीश राधेश रासेश्वर नमः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003193015, "chapter_id": 23193, "verse_number": "४-१२९-१६", "content_sanskrit": "सर्वेषामादिभूतर्स्त्वं सर्वः सर्वेश्वरस्तथा ।\nसर्वपाता च संहर्ता सृष्टिरूप नमः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003193016, "chapter_id": 23193, "verse_number": "४-१२९-१७", "content_sanskrit": "त्वत्पादपद्मरजसा धन्या पूता वसुंधरा ।\nशून्यरूपा त्वयि गते हे नाथ परमं पदम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003193017, "chapter_id": 23193, "verse_number": "४-१२९-१८", "content_sanskrit": "यत्पञ्चविंशत्यधिकं वर्षाणां शतकं गतम् ।\nत्यक्त्वेमां स्वपदं यासि रुदतीं विरहातुराम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003193018, "chapter_id": 23193, "verse_number": "४-१२९-१९", "content_sanskrit": "महादेव उवाच ।\nब्रह्मणा प्रार्थितस्त्वं च समागत्य वसुंधराम् ।\nभूभारहरणं कृत्वा प्रयासि स्वपदं विभो ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003193019, "chapter_id": 23193, "verse_number": "४-१२९-२०", "content_sanskrit": "त्रैलोक्ये पृथिवी धन्या सद्यः पूता पदाङ्किता ।\nवयं च मुनयो धन्याः साक्षाद्दृष्ट्वा पदाम्बुजम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003193020, "chapter_id": 23193, "verse_number": "४-१२९-२१", "content_sanskrit": "ध्यानासाध्यो दुराराध्यो मुनीनामूर्ध्वरेतसाम् ।\nअस्माकमपि यश्चेशः सोऽधुना चाक्षुषो भुवि ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003193021, "chapter_id": 23193, "verse_number": "४-१२९-२२", "content_sanskrit": "वासुः सर्वनिवासश्च विश्वनि यस्य लोमसु ।\nदेवस्तस्य महाविष्णुर्वासुदेवो महीतले ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003193022, "chapter_id": 23193, "verse_number": "४-१२९-२३", "content_sanskrit": "सुचिरं तपसा लब्धं सिद्धेन्द्राणां सुदुर्लभम् ।\nयत्पादपद्ममतुलं चाक्षुषं सर्वजीविनाम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003193023, "chapter_id": 23193, "verse_number": "४-१२९-२४", "content_sanskrit": "अनन्त उवाच ।\nत्वमनन्तो हि भगवन्नाहमेव कलांशकः ।\nविश्वैकस्थे क्षुद्रकूर्मे मशकोऽहं गजे यथा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003193024, "chapter_id": 23193, "verse_number": "४-१२९-२५", "content_sanskrit": "असंख्यशेषाः कूर्माश्च ब्रह्मविषणुशिवात्मकाः ।\nअसंख्यानि च विश्वानि तेषामीशः स्वयं भवान् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003193025, "chapter_id": 23193, "verse_number": "४-१२९-२६", "content_sanskrit": "अस्माकमीदृशं नाथ सुदिनं क्व भविष्यति ।\nस्वप्नादृष्टश्चयश्चेशः स दृष्टः सर्वजीविनाम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003193026, "chapter_id": 23193, "verse_number": "४-१२९-२७", "content_sanskrit": "नाथ प्रयासि गोलोकं पूतां कृत्वा वसुंधराम् ।\nतामनाथां रुदन्तीं च निमग्नां शोकसागरे ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003193027, "chapter_id": 23193, "verse_number": "४-१२९-२८", "content_sanskrit": "देवा ऊचुः ।\nवेदाःस्तोतुं न शक्ता यं ब्रह्मेशानादयस्तथा ।\nतमेव स्तवनं किं वा वयं कुर्मो नमोऽस्तु ते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003193028, "chapter_id": 23193, "verse_number": "४-१२९-२९", "content_sanskrit": "इत्येवमुक्त्वा देवास्ते प्रययुर्द्वारकां पुरीम् ।\nतत्रस्थं भगवन्तं च द्रष्टुं शीघ्रं मुदाऽन्विताः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003193029, "chapter_id": 23193, "verse_number": "४-१२९-३०", "content_sanskrit": "अथ तेषां च गोपाला ययुर्गोलोकमुत्तमम् ।\nपृथिवी कम्पिता भीता चलन्तः सप्तसागराः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003193030, "chapter_id": 23193, "verse_number": "४-१२९-३१", "content_sanskrit": "हतश्रियं द्वारकां च त्यक्त्वा च ब्रह्मशापतः ।\nमूर्तिं कदम्बमूलस्थां विवेश राधिकेश्वरः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003193031, "chapter_id": 23193, "verse_number": "४-१२९-३२", "content_sanskrit": "ते सर्वे चैरकायुद्धे निपेतुर्यादवास्तथा ।\nचितामारुह्य देव्यश्च प्रययुः स्वामिभिः सह ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003193032, "chapter_id": 23193, "verse_number": "४-१२९-३३", "content_sanskrit": "अर्जुनः स्वपुरं गत्वा समुवाच युधिष्ठिरम् ।\nस राजा भ्रातृभिः सार्धं ययौ स्वर्गं च भार्यया ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003193033, "chapter_id": 23193, "verse_number": "४-१२९-३४", "content_sanskrit": "दृष्ट्वा कदम्बमूलस्थं तिष्ठन्तं परमेश्वरम् ।\nदेवा ब्रह्मादयस्ते च प्रणेमुर्भक्तिपूर्वकम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003193034, "chapter_id": 23193, "verse_number": "४-१२९-३५", "content_sanskrit": "तुष्टुवुः परमात्मानं देवं नारायणं प्रभुम् ।\nश्यामं किशोरवयसं भूषितं रत्नभूषणैः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003193035, "chapter_id": 23193, "verse_number": "४-१२९-३६", "content_sanskrit": "वह्निशुद्धांशुकाधानं शोभितं वनमालया ।\nअतीव सुन्दरं शान्तं लक्ष्मीकान्तं मनोहरम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003193036, "chapter_id": 23193, "verse_number": "४-१२९-३७", "content_sanskrit": "व्याधास्त्रसंयुतं पादपद्मं पद्मादिवन्दितम् ।\nदृष्ट्वा ब्रह्मादिदेवांस्तानभयं सस्मितं ददौ ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003193037, "chapter_id": 23193, "verse_number": "४-१२९-३८", "content_sanskrit": "पृथिवीं तां समाश्वास्य रुदतीं प्रेमविह्वलाम् ।\nव्याधं प्रस्थापयामास परं स्वपदमुत्तमम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003193038, "chapter_id": 23193, "verse_number": "४-१२९-३९", "content_sanskrit": "बलस्य तेजः शेषे च विवेश परमाद्भुतम् ।\nप्रद्युम्नस्य च कामे वै वाऽनिरुद्धस्य ब्रह्मणि ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003193039, "chapter_id": 23193, "verse_number": "४-१२९-४०", "content_sanskrit": "अयोनिसंभवा देवी महालक्ष्मीश्च रुक्मिणी ।\nवैकुण्ठं प्रययौ साक्षात्स्वशरीरेण नारद ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003193040, "chapter_id": 23193, "verse_number": "४-१२९-४१", "content_sanskrit": "सत्यभामा पृथिव्यां च विवेश कमलालया ।\nस्वयं जाम्बवती देवी पार्वत्यां विश्वमातरि ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003193041, "chapter_id": 23193, "verse_number": "४-१२९-४२", "content_sanskrit": "या या देव्यश्च यासां चाप्यंशरुपाश्च भूतले ।\nतस्यां तस्यां प्रविविशुस्ता एव च पृथक्पृथक् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003193042, "chapter_id": 23193, "verse_number": "४-१२९-४३", "content_sanskrit": "साम्बस्य तेजः स्कन्दे च विवेश परमाद्भुतम् ।\nकश्यपे वसुदेवश्चाप्यदिव्यां देवकी तथा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003193043, "chapter_id": 23193, "verse_number": "४-१२९-४४", "content_sanskrit": "रुक्मिणीमन्दिरं त्यकत्वा समस्तां द्वारकां पुरीम् ।\nस जग्राह समुद्रश्च प्रफुल्लवदनेक्षणः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003193044, "chapter_id": 23193, "verse_number": "४-१२९-४५", "content_sanskrit": "लपणोदः समागत्य तुष्टाव पुरुषोत्तमम् ।\nरुरोद तद्वियोगेन साश्रुनेत्रश्च विह्वलः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003193045, "chapter_id": 23193, "verse_number": "४-१२९-४६", "content_sanskrit": "गङ्गा सरस्वती पद्मावती च यमुना तथा ।\nगोदावरी स्वर्णरेखा कावेरी नर्मदा मुने ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003193046, "chapter_id": 23193, "verse_number": "४-१२९-४७", "content_sanskrit": "शरावती बाहृदा च कृतमाला च पुण्यदा ।\nसमाययुश्च ताः सर्वाः प्रणेमुः परमेश्वरम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003193047, "chapter_id": 23193, "verse_number": "४-१२९-४८", "content_sanskrit": "उवाच जाह्नवी देवी रुदती परमेश्वरम् ।\nसाश्रुनेत्राऽतिदीना सा विरहज्वरकातरा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003193048, "chapter_id": 23193, "verse_number": "४-१२९-४९", "content_sanskrit": "भागीरथयुवाच ।\nहे नाथ रमणश्रेष्ठ यासि गोलोकमुत्तमम् ।\nअस्माकं का गतिश्चात्र भविष्यति कलौ युगे ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003193049, "chapter_id": 23193, "verse_number": "४-१२९-५०", "content_sanskrit": "श्रीभगवानुवाच ।\nकलेः पञ्चसहस्राणि वर्षाणि तिष्ठ भूतले ।\nपापानि पापिनो यानि तुभ्यं दास्यन्ति स्नानत ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003193050, "chapter_id": 23193, "verse_number": "४-१२९-५१", "content_sanskrit": "मन्मन्त्रोपासकस्पर्शाद्भस्मीभूतानि तत्क्षणात् ।\nभविष्यन्ति दर्शनाच्च स्नानादेव हि जाह्नवि ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003193051, "chapter_id": 23193, "verse_number": "४-१२९-५२", "content_sanskrit": "हरेर्नामानि यत्रैव पुराणानि भवन्ति हि ।\nतत्र गत्वा सावधानमाभिः सार्धं च श्रोष्यसि ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003193052, "chapter_id": 23193, "verse_number": "४-१२९-५३", "content_sanskrit": "पुराणश्रवणाच्चैव हरेर्नामानुकीर्तनात् ।\nभस्मीभूतानि पापानि ब्रह्महत्यादिकानि च ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003193053, "chapter_id": 23193, "verse_number": "४-१२९-५४", "content_sanskrit": "भस्मीभूतानि तान्येव वैष्णवालिङ्गनेन च ।\nतृणानि शुष्ककाष्ठानि दहन्ति पावका यथा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003193054, "chapter_id": 23193, "verse_number": "४-१२९-५५", "content_sanskrit": "तथाऽपि वैष्णवा लोके पापानि पापिनामपि ।\nपृथिव्यां यानि तीर्थानि पुण्यान्यपि च जाह्नवि ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003193055, "chapter_id": 23193, "verse_number": "४-१२९-५६", "content_sanskrit": "मद्भक्तानां शरीरेषु सन्ति पूतेषु संततम् ।\nमद्भक्तपादरजसा सद्यः पूता वसुंधरा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003193056, "chapter_id": 23193, "verse_number": "४-१२९-५७", "content_sanskrit": "सद्यः पूतानि तीर्थानि सद्याः पूतं जगत्तथा ।\nमन्मन्त्रोपासका विप्रा ये मदुच्छिष्टभोजिनः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003193057, "chapter_id": 23193, "verse_number": "४-१२९-५८", "content_sanskrit": "मामेव नित्यं ध्यायन्ते ते मत्प्राणाधिकाः प्रियाः ।\nतदुपस्पर्शमात्रेण पूतो वायुश्च पावकः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003193058, "chapter_id": 23193, "verse_number": "४-१२९-५९", "content_sanskrit": "कलेर्दशसहस्राणि मद्भक्ताः सन्ति भूतले ।\nएकवर्णा भविष्यन्ति मद्भक्तेषु गतेषु च ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003193059, "chapter_id": 23193, "verse_number": "४-१२९-६०", "content_sanskrit": "मद्भक्तशून्या पृथिवी कलिग्रस्ता भविष्यति ।\nएतस्मिन्नन्तरे तत्र कृष्णदेहाद्विनिर्गतः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003193060, "chapter_id": 23193, "verse_number": "४-१२९-६१", "content_sanskrit": "चतुर्भुजश्च पुरुषः शतचन्द्रसमप्रभः ।\nशङ्खचक्रगदापद्मधरः श्रीवत्सलाञ्छनः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003193061, "chapter_id": 23193, "verse_number": "४-१२९-६२", "content_sanskrit": "सुन्दरं रथमारुह्य श्रीरोदं स जगाम ह ।\nसिन्धुकन्या च प्रययौ स्वयं मूर्तिमती सती ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003193062, "chapter_id": 23193, "verse_number": "४-१२९-६३", "content_sanskrit": "श्रीकृष्णमनसा जाता मर्त्यलक्ष्मीर्मनोहरा ।\nश्वेतद्वीपं गते विष्णौ जगत्पालनकर्तरि ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003193063, "chapter_id": 23193, "verse_number": "४-१२९-६४", "content_sanskrit": "शुद्धसत्त्वस्वरूपे च द्विधारूपो बभूव सः ।\nदक्षिणांशश्च द्विभुजो गोपबारकरूपकः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003193064, "chapter_id": 23193, "verse_number": "४-१२९-६५", "content_sanskrit": "नपीनजलदश्यामः शोभितः पीतवाससा ।\nश्रीवंशवदनः श्रीमान्सस्मितः पद्मलोचनः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003193065, "chapter_id": 23193, "verse_number": "४-१२९-६६", "content_sanskrit": "शतकोटीन्दुसौन्दर्यं शतकोटिस्मरप्रभाम् ।\nदधानः परमानन्दः परिबूर्णतमः प्रभुः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003193066, "chapter_id": 23193, "verse_number": "४-१२९-६७", "content_sanskrit": "परं धाम परं ब्रह्मस्वरूपो निर्गुणः स्वयम् ।\nपरमात्मा च सर्वेषां भक्तानुग्रहविग्रहः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003193067, "chapter_id": 23193, "verse_number": "४-१२९-६८", "content_sanskrit": "नित्यदेहश्च भगवानीश्वरः प्रकृतेः परः ।\nयोगिनो यं वदन्त्येवं ज्योतीरूपं सनातनम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003193068, "chapter_id": 23193, "verse_number": "४-१२९-६९", "content_sanskrit": "ज्योतिरम्यन्तरे नित्यरूपं भक्ता विदन्ति यम् ।\nवेदा वदन्ति सत्यं यं नित्यमाद्यं विचक्षणाः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003193069, "chapter_id": 23193, "verse_number": "४-१२९-७०", "content_sanskrit": "यं वदन्ति सुराः सर्वे परं स्वेच्छामयं प्रभूम् ।\nसिद्धेन्द्रा मुनयः सर्वे सर्वरूपं वदन्ति यम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003193070, "chapter_id": 23193, "verse_number": "४-१२९-७१", "content_sanskrit": "यमनिर्वचनीयं च योगीन्द्रः शंकरो वदेत् ।\nस्वयं विधाता प्रवदेत्कारणानां च कारणम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003193071, "chapter_id": 23193, "verse_number": "४-१२९-७२", "content_sanskrit": "शेषो वदेदनन्तं यं नवधारूपमीश्वरम् ।\nतर्काणामेव षण्णां च षड्विधं रूपमीप्सितम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003193072, "chapter_id": 23193, "verse_number": "४-१२९-७३", "content_sanskrit": "वैष्णवानामेकरूपं वेदानामेकमेव च ।\nपुराणानामेकरूपं तस्मान्नवविधं स्मृतम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003193073, "chapter_id": 23193, "verse_number": "४-१२९-७४", "content_sanskrit": "न्यायोऽनिर्वचनीयं च यं मतं शंकरो वदेत् ।\nनित्यं वैशेषिकाश्चाऽऽद्यं तं वदन्ति विचक्षणाः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003193074, "chapter_id": 23193, "verse_number": "४-१२९-७५", "content_sanskrit": "सांख्य वदन्ति तं देवं ज्योतीरूपं सनातनम् ।\nमीमांसा सर्वरूपं च वेदान्तः सर्वकारणम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003193075, "chapter_id": 23193, "verse_number": "४-१२९-७६", "content_sanskrit": "पातञ्जलोऽप्यनन्तं च वेदाः सत्यस्वरूपकम् ।\nस्वेच्छामयं पुराणं च भक्ताश्च नित्यविग्रहम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003193076, "chapter_id": 23193, "verse_number": "४-१२९-७७", "content_sanskrit": "सोऽयं गोलोकनाथश्च राधेशो नन्दनन्दनः ।\nगोकुले गोपवेषश्च पुण्ये वृन्दावने वने ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003193077, "chapter_id": 23193, "verse_number": "४-१२९-७८", "content_sanskrit": "चतुर्भुजश्च वैकुण्ठे महालक्ष्मीपतिः स्वयम् ।\nनारायणश्च भगवान्यन्नाम मुक्तिकारणम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003193078, "chapter_id": 23193, "verse_number": "४-१२९-७९", "content_sanskrit": "सकृन्नारायणेत्युक्त्वा पुमान्कल्पशतत्रयम् ।\nगङ्गादिसर्वतीर्थेषु स्नातो भवति नारद ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003193079, "chapter_id": 23193, "verse_number": "४-१२९-८०", "content_sanskrit": "सुनन्दनन्दकुमुदैः पार्षदैः परिवारितः ।\nशङ्खचक्रगदापद्मधरः श्रीवत्सलाञ्छनः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003193080, "chapter_id": 23193, "verse_number": "४-१२९-८१", "content_sanskrit": "कौस्तुभेन मणीन्द्रेण भूषितो वनमालया ।\nदेवैः स्तुतश्च यानेन वैकुण्ठं स्वपदं ययौ ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003193081, "chapter_id": 23193, "verse_number": "४-१२९-८२", "content_sanskrit": "गते वैकुण्ठनाथे च राधेशश्च स्वयं प्रभुः ।\nचकार वंशीशब्दं च त्रैलोक्यमोहनं परम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003193082, "chapter_id": 23193, "verse_number": "४-१२९-८३", "content_sanskrit": "मूर्च्छांप्रापुर्देवगणा मुनयश्चापि नारद ।\nअचेतना बभूवुश्च मायया पार्वतीं विना ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003193083, "chapter_id": 23193, "verse_number": "४-१२९-८४", "content_sanskrit": "उवाच पार्वती देवी भगवन्तं सनातनम् ।\nविष्णुमाया भगवती सर्वरूपा सनातनी ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003193084, "chapter_id": 23193, "verse_number": "४-१२९-८५", "content_sanskrit": "परब्रह्मस्वरूपा या परमात्मस्वरूपिणी ।\nसगुणा निर्गुणा सा च परा स्वेच्छामयी सती ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003193085, "chapter_id": 23193, "verse_number": "४-१२९-८६", "content_sanskrit": "पार्वत्युवाच ।\nएकाऽहं राधिकारूपा गोलोके रासमण्डले ।\nरासशून्यं च गोलोकं परिपूर्ण कुरु प्रभो ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003193086, "chapter_id": 23193, "verse_number": "४-१२९-८७", "content_sanskrit": "गच्छ त्वं रथमारुह्य मुक्तामाणिक्यभूषितम् ।\nपरिबूर्णतमाऽहं च तव वङः स्थलस्थिता ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003193087, "chapter_id": 23193, "verse_number": "४-१२९-८८", "content_sanskrit": "तवाऽऽज्ञया महालक्ष्मीरहं वैकुण्ठगामिनी ।\nसरस्वती च तत्रैव वामे पार्श्वे हरेरपि ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003193088, "chapter_id": 23193, "verse_number": "४-१२९-८९", "content_sanskrit": "तवाहं मनसा जाता सिन्धुकन्या तवाऽऽज्ञया ।\nसावित्री वेदमाताऽहं कलया विधिसंनिधौ ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003193089, "chapter_id": 23193, "verse_number": "४-१२९-९०", "content_sanskrit": "तैजःसु सर्वदेवानां पुरा सत्ये तवाऽऽज्ञया ।\nअधिष्ठानं कृत तत्र धृतं देव्या शरीरकम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003193090, "chapter_id": 23193, "verse_number": "४-१२९-९१", "content_sanskrit": "शुम्भादयश्च दैत्याश्च निहताश्चावलीलया ।\nदुर्ग निहत्य तुर्गाऽहं त्रिपुरा त्रिपुरे वधे ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003193091, "chapter_id": 23193, "verse_number": "४-१२९-९२", "content_sanskrit": "निहत्य रक्तबीजं च रक्तबीजविनाशिनी ।\nतवाऽऽज्ञया दक्षकन्या सती सत्यस्वरूपिणी ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003193092, "chapter_id": 23193, "verse_number": "४-१२९-९३", "content_sanskrit": "योगेन त्यक्त्वा देहं च शैलजाऽहं तवाऽऽज्ञया ।\nत्वया दत्तवा (त्ताः शंकराय गोलोके रासमण्डले ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003193093, "chapter_id": 23193, "verse_number": "४-१२९-९४", "content_sanskrit": "विष्णुभक्तिरहं तेन विष्णुमाया च वैष्णवी ।\nनारायणस्य मायाऽहं तेन नारायणी स्मृता ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003193094, "chapter_id": 23193, "verse_number": "४-१२९-९५", "content_sanskrit": "कृष्णप्राणाधिकाऽहं च प्राणाधिष्ठातृदेवता ।\nमहाविष्णोश्च वासोश्च जननी राधिका स्वयम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003193095, "chapter_id": 23193, "verse_number": "४-१२९-९६", "content_sanskrit": "तवाऽऽज्ञया पञ्चधाऽहं पञ्चप्रकृतिरूपिणी ।\nकलाकलांशयाऽहं च देवपत्नयो गृहे गृहे ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003193096, "chapter_id": 23193, "verse_number": "४-१२९-९७", "content_sanskrit": "शीघ्रं गच्छ महाभाग तत्राऽहं विरहातुरा ।\nगोवीभिः सहिता रासं भ्रमन्ती परितः सदा ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003193097, "chapter_id": 23193, "verse_number": "४-१२९-९८", "content_sanskrit": "पार्वतीवचनं श्रुत्वा प्रहस्य रसिकेश्वरः ।\nरत्नयानं समारुह्य ययौ गोलोकमुत्तमम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003193098, "chapter_id": 23193, "verse_number": "४-१२९-९९", "content_sanskrit": "पार्वती बोधयामास स्वयं देवगणं तथा ।\nमायावंशीरवाच्छन्नं विष्णुमाया सनातनी ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003193099, "chapter_id": 23193, "verse_number": "४-१२९-१००", "content_sanskrit": "कृत्वा ते हरिशब्दं च स्वगृहं विस्मयं ययुः ।\nशिवेन सार्धं दुर्गा सा प्रहृष्टा स्वपुरं ययौ ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003193100, "chapter_id": 23193, "verse_number": "४-१२९-१०१", "content_sanskrit": "अथ कृष्णं समायान्तं राधा गोपीगणैः सह ।\nअनुव्रजं ययौ हृष्टा सर्वज्ञा प्राणवल्लभम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003193101, "chapter_id": 23193, "verse_number": "४-१२९-१०२", "content_sanskrit": "दृष्ट्वा समीपमायान्तमवरुह्य रथात्सती ।\nप्रणनाम जगन्नाथं सिरसा सखिभिः सह ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003193102, "chapter_id": 23193, "verse_number": "४-१२९-१०३", "content_sanskrit": "गोपा गोप्यश्च मुदिताः प्रफुल्लवदनेक्षणाः ।\nदुंदुभिं वादयामासुरीश्वरागमनोत्सुकाः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003193103, "chapter_id": 23193, "verse_number": "४-१२९-१०४", "content_sanskrit": "विरजां च समुत्तीर्य दृष्ट्वा राधां जगत्पतिः ।\nअवरुह्य रथात्तूर्णं गृहीत्वा राधिकाकरम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003193104, "chapter_id": 23193, "verse_number": "४-१२९-१०५", "content_sanskrit": "शतशृङ्गं च बभ्राम सुरम्यं रासमण्डलम् ।\nदृष्ट्वाऽक्षयवटं पुण्यं पुण्यं वृन्दावनं ययौ ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003193105, "chapter_id": 23193, "verse_number": "४-१२९-१०६", "content_sanskrit": "तुलसीकाननं दृष्ट्वा प्रययौ मालतीवनम् ।\nवामे कृत्वा कुन्दवनं माधवीकाननं तथा ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003193106, "chapter_id": 23193, "verse_number": "४-१२९-१०७", "content_sanskrit": "चकार दक्षिणे कृष्णश्चम्पकारण्यमीप्सिनम् ।\nचकार पश्चात्तूर्णं च चारुचन्दनकाननम् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003193107, "chapter_id": 23193, "verse_number": "४-१२९-१०८", "content_sanskrit": "ददर्श पुरतो रम्यं राधिकाभवनं परम् ।\nउवास राधया सार्धं रत्नसिंहासने वरे ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003193108, "chapter_id": 23193, "verse_number": "४-१२९-१०९", "content_sanskrit": "सकर्पूरं च ताम्बूलं बुभुजे वासितं जलम् ।\nसुष्वाप पुष्पतल्पे च सुगन्धिचन्दनार्चिते ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003193109, "chapter_id": 23193, "verse_number": "४-१२९-११०", "content_sanskrit": "स रेमे रामया सार्धं निमग्नो रससागरे ।\nइत्येवं कथितं सर्वं धर्मवक्त्राच्च यच्छ्रुतम् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003193110, "chapter_id": 23193, "verse_number": "४-१२९-१११", "content_sanskrit": "गोलोकारोहणं रम्यं किं भूयः श्रोतुमिच्छसि ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}]