[{"id": 2040891, "chapter_id": 1907, "verse_number": "५-१५२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2040892, "chapter_id": 1907, "verse_number": "५-१५२-१", "content_sanskrit": "ततो देशे समे स्निग्धे प्रभूतयवसेन्धने।\nनिवेशयामास तदा सेनां राजा युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2040893, "chapter_id": 1907, "verse_number": "५-१५२-२", "content_sanskrit": "परिहृत्य श्मशानानि देवतायतनानि च।\nआश्रमांश्च महर्षीणां तीर्थान्यायतनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2040894, "chapter_id": 1907, "verse_number": "५-१५२-३", "content_sanskrit": "मधुरानूषरे देशे शुचौ पुण्ये महामतिः ।\nनिवेशं कारयामास कुन्तीपुत्रो युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2040895, "chapter_id": 1907, "verse_number": "५-१५२-४", "content_sanskrit": "ततश्च पुनरुत्थाय सुखी विश्रान्तवाहनः ।\nप्रययौ पृथिवीपालैर्वृतः शतसहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2040896, "chapter_id": 1907, "verse_number": "५-१५२-५", "content_sanskrit": "विद्राव्य शतशो गुल्मान्धार्तराष्ट्रस्य सैनिकान् ।\nपर्यक्रामत्समन्ताच्च पार्थेन सह केशवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2040897, "chapter_id": 1907, "verse_number": "५-१५२-६", "content_sanskrit": "शिबिरं मापयामास धृष्टद्युम्नश्च पार्षतः।\nसात्यकिश्च रथोदारो युयुधानश्च वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2040898, "chapter_id": 1907, "verse_number": "५-१५२-७", "content_sanskrit": "आसाद्य सरितं पुण्यां कुरुक्षेत्रे हिरण्वतीम् ।\nसूपतीर्थां शुचिजलां शर्करापङ्कवर्जिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2040899, "chapter_id": 1907, "verse_number": "५-१५२-८", "content_sanskrit": "खानयामास परिखां केशवस्त्रत्र भारत ।\nगुप्त्यर्थमपि चादिश्य बलं तत्र न्यवेशयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2040900, "chapter_id": 1907, "verse_number": "५-१५२-९", "content_sanskrit": "विधिर्यः शिबिरस्यासीत्पाण्डवानां महात्मनाम् ।\nतद्विधानि नरेन्द्राणां कारयामास केशवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2040901, "chapter_id": 1907, "verse_number": "५-१५२-१०", "content_sanskrit": "प्रभूततरकाष्ठानि दुराधर्षतराणि च।\nभक्ष्यभोज्यान्नपानानि शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2040902, "chapter_id": 1907, "verse_number": "५-१५२-११", "content_sanskrit": "शिबिराणि महार्हाणि राज्ञां तत्र पृथक्पृथक् ।\nविमानानीव राजेन्द्र निविष्टानि महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2040903, "chapter_id": 1907, "verse_number": "५-१५२-१२", "content_sanskrit": "तत्रासञ्शिल्पिनः प्राज्ञाः शतशो दत्तवेतनाः।\nसर्वापकरणैर्युक्ता वैद्याः शास्त्रविशारदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2040904, "chapter_id": 1907, "verse_number": "५-१५२-१३", "content_sanskrit": "ज्याधनुर्वर्मशस्त्राणां तथैव मधुसर्पिषोः ।\nससर्जरकसपांसूनां राशयः पर्वतोपमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2040905, "chapter_id": 1907, "verse_number": "५-१५२-१४", "content_sanskrit": "बहूदकं सुयवसं तुषाङ्गारसमन्वितम् ।\nशिबिरे शिबिरे राजा सञ्चकार युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2040906, "chapter_id": 1907, "verse_number": "५-१५२-१५", "content_sanskrit": "महायन्त्राणि नाराचास्तोमराणि परश्वधाः।\nधनूंषि कवचादीनि ऋष्टयस्तूणसंयुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2040907, "chapter_id": 1907, "verse_number": "५-१५२-१६", "content_sanskrit": "गजाः कण्टकसन्नाहा लोहवर्मोत्तरच्छदाः।\nदृश्यन्ते तत्र गिर्याभाः सहस्रशतयोधिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2040908, "chapter_id": 1907, "verse_number": "५-१५२-१७", "content_sanskrit": "निविष्टान्पाण्डवांस्तत्र ज्ञात्वा मित्राणि भारत ।\nअभिसस्रुर्यथादेशं सबलाः सहवाहनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2040909, "chapter_id": 1907, "verse_number": "५-१५२-१८", "content_sanskrit": "चरितब्रह्मचर्यास्ते सोमपा भूरिदक्षिणाः।\nजयाय पाण्डुपुत्राणां समाजग्मुर्महीक्षितः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2040910, "chapter_id": 1907, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि सैन्यनिर्याणपर्वणि द्विपञ्चशदधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]