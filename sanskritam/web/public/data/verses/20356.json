[{"id": 7000356000, "chapter_id": 20356, "verse_number": "२-२८-१", "content_sanskrit": "ऋषय ऊचुः ।\nविस्तरेण समाख्याहि जन्म तस्य महात्मनः ।\nपृथोश्चैव महाभाग श्रोतुकामा वयं पुनः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000356001, "chapter_id": 20356, "verse_number": "२-२८-२", "content_sanskrit": "राज्ञा तेन यथा दुग्धा इयं धात्री महात्मना ।\nपुनर्देवैश्च पितृभिर्मुनिभस्तत्त्ववेदिभिः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000356002, "chapter_id": 20356, "verse_number": "२-२८-३", "content_sanskrit": "यथा दैत्यैश्च नागैश्च यथा यक्षैर्यथा द्रुमैः ।\nशैलैश्चैव पिशाचैश्च गंधर्वैः पुण्यकर्मभिः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000356003, "chapter_id": 20356, "verse_number": "२-२८-४", "content_sanskrit": "ब्राह्मणैश्च तथा सिद्धै राक्षसैर्भीमविक्रमैः ।\nपूर्वमेव यथा दुग्धा अन्यैश्च सुमहात्मभिः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000356004, "chapter_id": 20356, "verse_number": "२-२८-५", "content_sanskrit": "तेषामेव हि सर्वेषां विशेषं पात्रधारणम् ।\nक्षीरस्यापि विधिं ब्रूहि विशेषं च महामते॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000356005, "chapter_id": 20356, "verse_number": "२-२८-६", "content_sanskrit": "वेनस्यापि नृपस्यैव पाणिरेव महात्मनः ।\nऋषिभिर्मथितः पूर्वं स कस्मादिह कारणात्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000356006, "chapter_id": 20356, "verse_number": "२-२८-७", "content_sanskrit": "क्रुद्धश्चैव महापुण्यैः सूतपुत्र वदस्व नः ।\nविचित्रेयं कथा पुण्या सर्वपापप्रणाशिनी॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000356007, "chapter_id": 20356, "verse_number": "२-२८-८", "content_sanskrit": "श्रोतुकामा महाभाग तृप्तिर्नैव प्रजायते ।\nसूत उवाच ।\nवैन्यस्य हि पृथोश्चैव तस्य विस्तरमेव च॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000356008, "chapter_id": 20356, "verse_number": "२-२८-९", "content_sanskrit": "जन्मवीर्यं तथा क्षेत्रं पौरुषं द्विजसत्तमाः ।\nप्रवक्ष्यामि यथा सर्वं चरित्रं तस्य धीमतः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000356009, "chapter_id": 20356, "verse_number": "२-२८-१०", "content_sanskrit": "शुश्रूषध्वं महाभागा मामेवं द्विजसत्तमाः ।\nअभक्ताय न वक्तव्यमश्रद्धाय शठाय च॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000356010, "chapter_id": 20356, "verse_number": "२-२८-११", "content_sanskrit": "सुमूर्खाय सुमोहाय कुशिष्याय तथैव च ।\nश्रद्धाहीनाय कूटाय सर्वनाशाय मा द्विजाः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000356011, "chapter_id": 20356, "verse_number": "२-२८-१२", "content_sanskrit": "अन्यथा पठते यो हि निरयं च प्रयाति हि ।\nभवंतो भावसंयुक्ताः सत्यधर्मपरायणाः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000356012, "chapter_id": 20356, "verse_number": "२-२८-१३", "content_sanskrit": "भवतामग्रतः सर्वं चरित्रं पापनाशनम् ।\nसंप्रवक्ष्याम्यशेषेण शृणुध्वं द्विजसत्तमाः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000356013, "chapter_id": 20356, "verse_number": "२-२८-१४", "content_sanskrit": "स्वर्ग्यं यशस्यमायुष्यं धन्यं वेदैश्च संमितम् ।\nरहस्यमृषिभिः प्रोक्तं प्रवक्ष्यामि द्विजोत्तमाः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000356014, "chapter_id": 20356, "verse_number": "२-२८-१५", "content_sanskrit": "यश्चैनं कीर्तयेन्नित्यं पृथोर्वैन्यस्य विस्तरम् ।\nब्राह्मणेभ्यो नमस्कृत्वा न स शोचेत्कृताकृतम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000356015, "chapter_id": 20356, "verse_number": "२-२८-१६", "content_sanskrit": "सप्तजन्मार्जितं पापं श्रुतमात्रेण नश्यति ।\nब्राह्मणो वेदविद्वांश्च क्षत्रियो विजयी भवेत्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000356016, "chapter_id": 20356, "verse_number": "२-२८-१७", "content_sanskrit": "वैश्यो धनसमृद्धः स्याच्छूद्रः सुखमवाप्नुयात् ।\nएवं फलं समाप्नोति पठनाच्छ्रवणादपि॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000356017, "chapter_id": 20356, "verse_number": "२-२८-१८", "content_sanskrit": "पृथोर्जन्मचरित्रं च पवित्रं पापनाशनम् ।\nधर्मगोप्ता महाप्राज्ञो वेदशास्त्रार्थकोविदः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000356018, "chapter_id": 20356, "verse_number": "२-२८-१९", "content_sanskrit": "अत्रिवंशसमुत्पन्नः पूर्वमत्रिसमः प्रभुः ।\nस्रष्टा सर्वस्य धर्मस्य अंगो नाम प्रजापतिः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000356019, "chapter_id": 20356, "verse_number": "२-२८-२०", "content_sanskrit": "य आसीत्तस्य पुत्रो वै वेनो नाम प्रजापतिः ।\nधर्ममेवं परित्यज्य सर्वदैव प्रवर्तते॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000356020, "chapter_id": 20356, "verse_number": "२-२८-२१", "content_sanskrit": "मृत्योः कन्या महाभागा सुनीथा नाम नामतः ।\nतां तु अंगो महाभागः सुनीथामुपयेमिवान्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000356021, "chapter_id": 20356, "verse_number": "२-२८-२२", "content_sanskrit": "तस्यामुत्पादयामास वेनं धर्मप्रणाशनम् ।\nमातामहस्य दोषेण वेनः कालात्मजात्मजः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000356022, "chapter_id": 20356, "verse_number": "२-२८-२३", "content_sanskrit": "निजधर्मं परित्यज्य अधर्मनिरतोभवत् ।\nकामाल्लोभान्महामोहात्पापमेव समाचरत्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000356023, "chapter_id": 20356, "verse_number": "२-२८-२४", "content_sanskrit": "वेदाचारमयं धर्मं परित्यज्य नराधिपः ।\nअन्ववर्तत पापेन मदमत्सरमोहितः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000356024, "chapter_id": 20356, "verse_number": "२-२८-२५", "content_sanskrit": "वेदाध्यायं विना लोके प्रावर्तंत तदा जनाः ।\nनिःस्वाध्यायवषट्काराः प्रजास्तस्मिन्प्रजापतौ॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000356025, "chapter_id": 20356, "verse_number": "२-२८-२६", "content_sanskrit": "प्रवृत्तं न पपुः सोमं हुतं यज्ञेषु देवताः ।\nइत्युवाच स दुष्टात्मा ब्राह्मणान्प्रति नित्यशः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000356026, "chapter_id": 20356, "verse_number": "२-२८-२७", "content_sanskrit": "नाध्येतव्यं न होतव्यं न देयं दानमेव च ।\nन यष्टव्यं न होतव्यमिति तस्य प्रजापतेः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000356027, "chapter_id": 20356, "verse_number": "२-२८-२८", "content_sanskrit": "आसीत्प्रतिज्ञा क्रूरेयं विनाशे प्रत्युपस्थिते ।\nअहमिज्यश्च यष्टा च यज्ञश्चेति पुनः पुनः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000356028, "chapter_id": 20356, "verse_number": "२-२८-२९", "content_sanskrit": "मयि यज्ञा विधातव्या मयि होतव्यमित्यपि ।\nइत्यब्रवीत्सदा वेनो ह्यहं विष्णुः सनातनः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000356029, "chapter_id": 20356, "verse_number": "२-२८-३०", "content_sanskrit": "अहं ब्रह्मा अहं रुद्रो मित्र इंद्रः सदागतिः ।\nअहमेव प्रभोक्ता च हव्यं कव्यं न संशयः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000356030, "chapter_id": 20356, "verse_number": "२-२८-३१", "content_sanskrit": "अथ ते मुनयः क्रुद्धा वेनं प्रति महाबलाः ।\nऊचुस्ते संगताः सर्वे राजानं पापचेतनम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000356031, "chapter_id": 20356, "verse_number": "२-२८-३२", "content_sanskrit": "ऋषय ऊचुः ।\nराजा हि पृथिवीनाथः प्रजां पालयते सदा ।\nधर्ममूर्तिः स राजेंद्र तस्माद्धर्मं हि रक्षयेत्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000356032, "chapter_id": 20356, "verse_number": "२-२८-३३", "content_sanskrit": "वयं दीक्षां प्रवेक्ष्यामो यज्ञे द्वादशवार्षिकीम् ।\nअधर्मं कुरु मा यागे नैष धर्मः सतां गतिः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000356033, "chapter_id": 20356, "verse_number": "२-२८-३४", "content_sanskrit": "कुरु धर्मं महाराज सत्यं पुण्यं समाचर ।\nप्रजाहं पालयिष्यामि इति ते समयः कृतः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000356034, "chapter_id": 20356, "verse_number": "२-२८-३५", "content_sanskrit": "तांस्तथाब्रुवतः सर्वान्महर्षीनब्रवीत्तदा ।\nवेनः प्रहस्य दुर्बुद्धिरिममर्थमनर्थकम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000356035, "chapter_id": 20356, "verse_number": "२-२८-३६", "content_sanskrit": "वेन उवाच ।\nस्रष्टा धर्मस्य कश्चान्यः श्रोतव्यं कस्य वा मया ।\nश्रुतवीर्यतपः सत्ये मया वा कः समो भुवि॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000356036, "chapter_id": 20356, "verse_number": "२-२८-३७", "content_sanskrit": "प्रभवं सर्वभूतानां धर्माणां च विशेषतः ।\nसंमूढा न विदुर्नूनं भवंतो मां विचेतसः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000356037, "chapter_id": 20356, "verse_number": "२-२८-३८", "content_sanskrit": "इच्छन्दहेयं पृथिवीं प्लावयेयं जलैस्तथा ।\nद्यां भुवं चैव रुंधेयं नात्र कार्या विचारणा॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000356038, "chapter_id": 20356, "verse_number": "२-२८-३९", "content_sanskrit": "यदा न शक्यते मोहादवलेपाच्च पार्थिव ।\nअपनेतुं तदा वेनं ततः क्रुद्धा महर्षयः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000356039, "chapter_id": 20356, "verse_number": "२-२८-४०", "content_sanskrit": "विस्फुरंतं तदा वेनं बलाद्गृह्य ततो रुषा ।\nवेनस्य तस्य सव्योरुं ममंथुर्जातमन्यवः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000356040, "chapter_id": 20356, "verse_number": "२-२८-४१", "content_sanskrit": "कृष्णांजनचयोपेतमतिह्रस्वं विलक्षणम् ।\nदीर्घास्यं च विरूपाक्षं नीलकंचुकवर्चसम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000356041, "chapter_id": 20356, "verse_number": "२-२८-४२", "content_sanskrit": "लंबोदरं व्यूढकर्णमतिभीतं दुरोदरम् ।\nददृशुस्ते महात्मानो निषीदेत्यब्रुवंस्ततः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000356042, "chapter_id": 20356, "verse_number": "२-२८-४३", "content_sanskrit": "तेषां तद्वचनं श्रुत्वा निषसाद भयातुरः ।\nपर्वतेषु वनेष्वेव तस्य वंशः प्रतिष्ठितः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000356043, "chapter_id": 20356, "verse_number": "२-२८-४४", "content_sanskrit": "निषादाश्च किराताश्च भिल्लानाहलकास्तथा ।\nभ्रमराश्च पुलिंदाश्च ये चान्ये म्लेच्छजातयः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000356044, "chapter_id": 20356, "verse_number": "२-२८-४५", "content_sanskrit": "पापाचारास्तु ते सर्वे तस्मादंगात्प्रजज्ञिरे ।\nअथ ते ऋषयः सर्वे प्रसन्नमनसस्ततः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000356045, "chapter_id": 20356, "verse_number": "२-२८-४६", "content_sanskrit": "गतकल्मषमेवं तं जातं वेनं नृपोत्तमम् ।\nममंथुर्दक्षिणं पाणिं तस्यैव च महात्मनः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000356046, "chapter_id": 20356, "verse_number": "२-२८-४७", "content_sanskrit": "मथिते तस्य पाणौ तु संजातं स्वेदमेव हि ।\nपुनर्ममंथुस्ते विप्रा दक्षिणं पाणिमेव च॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000356047, "chapter_id": 20356, "verse_number": "२-२८-४८", "content_sanskrit": "सुकरात्पुरुषो जज्ञे द्वादशादित्यसन्निभः ।\nतप्तकांचनवर्णांगो दिव्यमाल्यांबरावृतः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000356048, "chapter_id": 20356, "verse_number": "२-२८-४९", "content_sanskrit": "दिव्याभरणशोभांगो दिव्यगंधानुलेपनः ।\nमुकुटेनार्कवर्णेन कुंडलाभ्यां विराजते॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000356049, "chapter_id": 20356, "verse_number": "२-२८-५०", "content_sanskrit": "महाकायो महाबाहू रूपेणाप्रतिमो भुवि ।\nखड्गबाणधरो धन्वी कवची च महाप्रभुः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000356050, "chapter_id": 20356, "verse_number": "२-२८-५१", "content_sanskrit": "सर्वलक्षणसंपन्नः सर्वालंकारभूषणः ।\nतेजसा रूपभावेन सुवर्णैश्च महामतिः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000356051, "chapter_id": 20356, "verse_number": "२-२८-५२", "content_sanskrit": "दिवि इंद्रो यथा भाति भुवि वेनात्मजस्तथा ।\nतस्मिञ्जाते महाभागे देवाश्च ऋषयोमलाः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000356052, "chapter_id": 20356, "verse_number": "२-२८-५३", "content_sanskrit": "उत्सवं चक्रिरे सर्वे वेनस्य तनयं प्रति ।\nदीप्यमानः स्ववपुषा साक्षादग्निरिवोज्ज्वलः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000356053, "chapter_id": 20356, "verse_number": "२-२८-५४", "content_sanskrit": "आद्यमाजगवं नाम धनुर्गृह्य महावरम् ।\nशरान्दिव्यांश्च रक्षार्थे कवचं च महाप्रभम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000356054, "chapter_id": 20356, "verse_number": "२-२८-५५", "content_sanskrit": "जाते सति महाभागे पृथौ वीरे महात्मनि ।\nसंप्रह्रष्टानि भूतानि समस्तानि द्विजोत्तम॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000356055, "chapter_id": 20356, "verse_number": "२-२८-५६", "content_sanskrit": "सर्वतीर्थानि तोयानि पुण्यानि विविधानि च ।\nतस्याभिषेके विप्रेंद्राः सर्व एव प्रतस्थिरे॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000356056, "chapter_id": 20356, "verse_number": "२-२८-५७", "content_sanskrit": "पितामहाद्या देवास्तु भूतानि विविधानि च ।\nस्थावराणि चराण्येव अभ्यषिंचन्नराधिपम्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000356057, "chapter_id": 20356, "verse_number": "२-२८-५८", "content_sanskrit": "महावीरं प्रजापालं पृथुमेव द्विजोत्तम ।\nपृथुर्वैन्यो राजराज्ये अभिगम्य चराचरैः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000356058, "chapter_id": 20356, "verse_number": "२-२८-५९", "content_sanskrit": "देवैर्विप्रैस्तथा सर्वैरभिषिक्तो महामनाः ।\nराज्ञां समधिराज्ये वै पृथुर्वैन्यः प्रतापवान्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000356059, "chapter_id": 20356, "verse_number": "२-२८-६०", "content_sanskrit": "तस्य पित्रा प्रजाः सर्वाः कदा नैवानुरंजिताः ।\nतेनानुरंजिताः सर्वा मुमुदिरे सुखेन वै॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000356060, "chapter_id": 20356, "verse_number": "२-२८-६१", "content_sanskrit": "अनुरागात्तस्य वीरस्य नाम राजेत्यजायत ।\nप्रयातस्य सुवीरस्य समुद्रस्य द्विजोत्तम॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000356061, "chapter_id": 20356, "verse_number": "२-२८-६२", "content_sanskrit": "आपस्तस्तंभिरे सर्वा भयात्तस्य महात्मनः ।\nदुर्गं मार्गं विलोप्यैव सुमार्गं पर्वता ददुः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000356062, "chapter_id": 20356, "verse_number": "२-२८-६३", "content_sanskrit": "ध्वजभंगं न चक्रुस्ते गिरयः सर्व एव ते ।\nअकृष्टपच्या पृथिवी सर्वत्र कामधेनवः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000356063, "chapter_id": 20356, "verse_number": "२-२८-६४", "content_sanskrit": "पर्जन्यः कामवर्षी च वेदयज्ञान्महोत्सवान् ।\nकुर्वंति ब्राह्मणाः सर्वे क्षत्रियाश्च तथा परे॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000356064, "chapter_id": 20356, "verse_number": "२-२८-६५", "content_sanskrit": "सर्वकामफला वृक्षास्तस्मिञ्छासति पार्थिवे ।\nन दुर्भिक्षं न च व्याधिर्नाकालमरणं नृणाम्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000356065, "chapter_id": 20356, "verse_number": "२-२८-६६", "content_sanskrit": "सर्वे सुखेन जीवंति लोका धर्मपरायणाः ।\nतस्मिञ्छासति दुर्धर्षे राजराजे महात्मनि॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000356066, "chapter_id": 20356, "verse_number": "२-२८-६७", "content_sanskrit": "एतस्मिन्नेव काले तु यज्ञे पैतामहे शुभे ।\nसूत सूत्यां समुत्पन्नः सौम्येहनि महात्मनि॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000356067, "chapter_id": 20356, "verse_number": "२-२८-६८", "content_sanskrit": "तस्मिन्नेव महायज्ञे जज्ञे प्राज्ञोऽथ मागधः ।\nपृथोःस्तवार्थं तौ तत्र समाहूतौ महर्षिभिः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000356068, "chapter_id": 20356, "verse_number": "२-२८-६९", "content_sanskrit": "सूतस्य लक्षणं वक्ष्ये महापुण्यं द्विजोत्तमाः ।\nशिखासूत्रेण संयुक्तो वेदाध्ययनतत्परः॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000356069, "chapter_id": 20356, "verse_number": "२-२८-७०", "content_sanskrit": "सर्वशास्त्रार्थवेत्तासावग्निहोत्रमुपासते ।\nदानाध्ययनसंपन्नो ब्रह्माचारपरायणः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000356070, "chapter_id": 20356, "verse_number": "२-२८-७१", "content_sanskrit": "देवानां ब्राह्मणानां च पूजनाभिरतः सदा ।\nयाचकस्तावकैः पुण्यैर्वेदमंत्रैर्यजेत्किल॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000356071, "chapter_id": 20356, "verse_number": "२-२८-७२", "content_sanskrit": "ब्रह्माचारपरो नित्यं संबंधं ब्राह्मणैः सह ।\nएवं स मागधो जज्ञे वेदाध्ययनवर्जितः॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000356072, "chapter_id": 20356, "verse_number": "२-२८-७३", "content_sanskrit": "बंदिनश्चारणाः सर्वे ब्रह्माचारविवर्जिताः ।\nज्ञेयास्ते च महाभागाः स्तावकाः प्रभवंति ते॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000356073, "chapter_id": 20356, "verse_number": "२-२८-७४", "content_sanskrit": "स्तवनार्थमुभौ सृष्टौ निपुणौ सूतमागधौ ।\nतावूचुरृषयः सर्वे स्तूयतामेष पार्थिवः॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000356074, "chapter_id": 20356, "verse_number": "२-२८-७५", "content_sanskrit": "कर्मैतदनुरूपं च यादृशोयं नराधिपः ।\nतावूचतुस्तदा सर्वांस्तानृषीन्बंदिमागधौ॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000356075, "chapter_id": 20356, "verse_number": "२-२८-७६", "content_sanskrit": "आवां देवानृषींश्चैव प्रीणयावः स्वकर्मभिः ।\nन चास्य विद्वो वै कर्म न तथा लक्षणं यशः॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000356076, "chapter_id": 20356, "verse_number": "२-२८-७७", "content_sanskrit": "कर्मणा येन कुर्यावः स्तोत्रमस्य महात्मनः ।\nजानीवस्तन्न विप्रेंद्रा अविज्ञातगुणस्य हि॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000356077, "chapter_id": 20356, "verse_number": "२-२८-७८", "content_sanskrit": "भविष्यैस्तैर्गुणैः पुण्यैः स्तोतव्योयं नरोत्तमः ।\nकृतवान्यानि कर्माणि पृथुरेव महायशाः॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000356078, "chapter_id": 20356, "verse_number": "२-२८-७९", "content_sanskrit": "ऊचुस्ते मुनयः सर्वे गुणान्दिव्यान्महात्मनः ।\nसत्यवाञ्ज्ञानसंपन्नो बुद्धिमान्ख्यातविक्रमः॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000356079, "chapter_id": 20356, "verse_number": "२-२८-८०", "content_sanskrit": "सदा शूरो गुणग्राही पुण्यवांस्त्यागवान्गुणी ।\nधार्मिकः सत्यवादी च यज्ञानां याजकोत्तमः॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000356080, "chapter_id": 20356, "verse_number": "२-२८-८१", "content_sanskrit": "प्रियवाक्सत्यवादी च धान्यवान्धनवान्गुणी ।\nगुणज्ञः सगुणग्राही धर्मज्ञः सत्यवत्सलः॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000356081, "chapter_id": 20356, "verse_number": "२-२८-८२", "content_sanskrit": "सर्वगः सर्ववेत्ता च ब्रह्मण्यो वेदवित्सुधीः ।\nप्रज्ञावान्सुस्वरश्चैव वेदवेदांगपारगः॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000356082, "chapter_id": 20356, "verse_number": "२-२८-८३", "content_sanskrit": "धाता गोप्ता प्रजानां स विजयी समरांगणे ।\nराजसूयादिकानां तु यज्ञानां राजसत्तमः॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000356083, "chapter_id": 20356, "verse_number": "२-२८-८४", "content_sanskrit": "आहर्ता भूतले चैकः सर्वधर्मसमन्वितः ।\nएते गुणा अस्य चांगे भविष्यंति महात्मनः॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000356084, "chapter_id": 20356, "verse_number": "२-२८-८५", "content_sanskrit": "ऋषिभिस्तौ नियुक्तौ तु कुर्वाणौ सूतमागधौ ।\nगुणैश्चैव भविष्यैश्च स्तोत्रं तस्य महात्मनः॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000356085, "chapter_id": 20356, "verse_number": "२-२८-८६", "content_sanskrit": "तदा प्रभृति वै लोकास्तवैस्तुष्टा महामते ।\nपुरतश्च भविष्यंति दातारः स्तावनैर्गुणैः॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000356086, "chapter_id": 20356, "verse_number": "२-२८-८७", "content_sanskrit": "ततः प्रभृति लोकेस्मिन्स्तवेषु द्विजसत्तमाः ।\nआशीर्वादाः प्रयुज्यंते तेषां द्रविणमुत्तमम्॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000356087, "chapter_id": 20356, "verse_number": "२-२८-८८", "content_sanskrit": "सूताय मागधायैव बंदिने च महोदयम् ।\nचारणाय ततः प्रादात्तैलंगं देशमुत्तमम्॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000356088, "chapter_id": 20356, "verse_number": "२-२८-८९", "content_sanskrit": "पृथुः प्रसादाद्धर्मात्मा हैहयं देशमेव च ।\nरेवातीरे पुरं कृत्वा स्वनाम्ना नृपनंदनः॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000356089, "chapter_id": 20356, "verse_number": "२-२८-९०", "content_sanskrit": "ब्राह्मणेभ्यो द्विजश्रेष्ठ यजन्दाता पृथुः पुरा ।\nसर्वज्ञं सर्वदातारं धर्मवीर्यं नरोत्तमम्॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000356090, "chapter_id": 20356, "verse_number": "२-२८-९१", "content_sanskrit": "तं ददृशुः प्रजाः सर्वा मुनयश्च तपोमलाः ।\nऊचुः परस्परं पुण्या एष राजा महामतिः॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000356091, "chapter_id": 20356, "verse_number": "२-२८-९२", "content_sanskrit": "देवादीनां वृत्तिदाता अस्माकं च विशेषतः ।\nप्रजानां पालकश्चैव वृत्तिदो हि भविष्यति॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000356092, "chapter_id": 20356, "verse_number": "२-२८-९३", "content_sanskrit": "इयं धात्री महाप्राज्ञा उप्तं बीजं पुरा किल ।\nजीवनार्थं प्रजाभिस्तु ग्रासयित्वा स्थिराभवत्॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000356093, "chapter_id": 20356, "verse_number": "२-२८-९४", "content_sanskrit": "ततः पृथुं द्विजश्रेष्ठ प्रजाः समभिदुद्रुवुः ।\nविधत्स्वेति सुवृत्तिं नो मुनीनां वचनं तदा॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000356094, "chapter_id": 20356, "verse_number": "२-२८-९५", "content_sanskrit": "ग्रासयित्वा तदान्नानि पृथ्वी जाता सुनिश्चला ।\nभयं प्रजानां सुमहत्स दृष्ट्वा राजसत्तमः॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000356095, "chapter_id": 20356, "verse_number": "२-२८-९६", "content_sanskrit": "महर्षिवचनात्सोपि प्रगृह्य सशरं धनुः ।\nअभ्यधावत वेगेन पृथ्वीं क्रुद्धो नराधिपः॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000356096, "chapter_id": 20356, "verse_number": "२-२८-९७", "content_sanskrit": "कौंजरं रूपमास्थाय भयात्तस्य तु मेदिनी ।\nवनेषु दुर्गदेशेषु गुप्ता भूत्वा चचार सा॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000356097, "chapter_id": 20356, "verse_number": "२-२८-९८", "content_sanskrit": "न पश्यति महाप्राज्ञः कुरूपं द्विजसत्तमाः ।\nआचचक्षुर्महाप्राज्ञं कुंजरं रूपमास्थिता॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000356098, "chapter_id": 20356, "verse_number": "२-२८-९९", "content_sanskrit": "ततः कुंजररूपांतामभिदुद्राव पार्थिवः ।\nताड्यमाना च सा तेन निशितैर्मार्गणैस्ततः॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000356099, "chapter_id": 20356, "verse_number": "२-२८-१००", "content_sanskrit": "हरिरूपं समास्थाय पलायनपराभवत् ।\nहरेरूपं समास्थाय अभिदुद्राव पार्थिवः॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000356100, "chapter_id": 20356, "verse_number": "२-२८-१०१", "content_sanskrit": "सोतिक्रुद्धो महाप्राज्ञो रोषारुणसुलोचनः ।\nसुबाणैर्निशितैस्तीक्ष्णैराजघान स मेदिनीम्॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000356101, "chapter_id": 20356, "verse_number": "२-२८-१०२", "content_sanskrit": "आकुलव्याकुला जाता बाणाघातहता तदा ।\nमाहिषं रूपमास्थाय पलायनपराभवत्॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000356102, "chapter_id": 20356, "verse_number": "२-२८-१०३", "content_sanskrit": "अभ्यधावत वेगेन बाणपाणिर्धनुर्धरः ।\nसा गौर्भूत्वा द्विजश्रेष्ठा स्वर्गमेव गता ध्रुवम्॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000356103, "chapter_id": 20356, "verse_number": "२-२८-१०४", "content_sanskrit": "ब्रह्मणः शरणं प्राप्ता विष्णोश्चैव महात्मनः ।\nरुद्रादीनां च देवानां त्राणस्थानं न विंदति॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000356104, "chapter_id": 20356, "verse_number": "२-२८-१०५", "content_sanskrit": "अलभंती भृशं त्राणं वैन्यमेवान्वविंदत ।\nतस्य पार्श्वं पुनः प्राप्ता बाणघातसमाकुला॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000356105, "chapter_id": 20356, "verse_number": "२-२८-१०६", "content_sanskrit": "बद्धांजलिपुटाभूत्वा तं पृथुं वाक्यमब्रवीत् ।\nत्राहित्राहीति राजेंद्र सा राजानमभाषत॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000356106, "chapter_id": 20356, "verse_number": "२-२८-१०७", "content_sanskrit": "अहं धात्री महाभाग सर्वाधारा वसुंधरा ।\nनिहतायां मयि नृप निहतं लोकसप्तकम्॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000356107, "chapter_id": 20356, "verse_number": "२-२८-१०८", "content_sanskrit": "कृतांजलिपुटा भूत्वा पूज्या लोकैस्त्रिभिः सदा ।\nउवाच चैनं राजानमवध्या स्त्री सदा नृप॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000356108, "chapter_id": 20356, "verse_number": "२-२८-१०९", "content_sanskrit": "स्त्रीणां वधे महत्पापं दृष्टमस्ति द्विजोत्तमैः ।\nगवां वधे महत्पापं दृष्टमस्ति द्विजोत्तमैः॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000356109, "chapter_id": 20356, "verse_number": "२-२८-११०", "content_sanskrit": "मया विना महाराज कथं धारयसे प्रजाः ।\nअहं यदास्थिरा राजंस्तदा लोकाश्चराचराः॥ ११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000356110, "chapter_id": 20356, "verse_number": "२-२८-१११", "content_sanskrit": "स्थिरत्वं यांति ते सर्वे स्थिरीभूता यदा ह्यहम् ।\nमां विना तु इमे लोका विनश्येयुश्चराचराः॥ १११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7000356111, "chapter_id": 20356, "verse_number": "२-२८-११२", "content_sanskrit": "ततः प्रजा विनश्येयुर्मम नाशे समागते ।\nकथं धारयिता चासि प्रजा राजन्मया विना॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7000356112, "chapter_id": 20356, "verse_number": "२-२८-११३", "content_sanskrit": "मयि लोकाः स्थिरा राजन्मयेदं धार्यते जगत् ।\nमद्विनाशे विनश्येयुः प्रजाः सर्वा न संशयः॥ ११३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7000356113, "chapter_id": 20356, "verse_number": "२-२८-११४", "content_sanskrit": "न मामर्हसि वै हंतुं श्रेयश्चेत्त्वं चिकीर्षसि ।\nप्रजानां पृथिवीपाल शृणु देव वचो मम॥ ११४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7000356114, "chapter_id": 20356, "verse_number": "२-२८-११५", "content_sanskrit": "उपायैश्च महाभाग सुसिद्धिं यांत्युपक्रमाः ।\nसमालोक्य ह्युपायं त्वं प्रजा येन धरिष्यति॥ ११५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7000356115, "chapter_id": 20356, "verse_number": "२-२८-११६", "content_sanskrit": "मां हत्वा त्वं महाराज धारणे पालने सदा ।\nपोषणे च महाप्राज्ञ मद्विना हि कथं नृप॥ ११६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7000356116, "chapter_id": 20356, "verse_number": "२-२८-११७", "content_sanskrit": "धरिष्यसि प्रजां चेमां कोपं यच्छ त्वमात्मनः ।\nअन्नमयी भविष्यामि धरिष्यामि प्रजामिमाम्॥ ११७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7000356117, "chapter_id": 20356, "verse_number": "२-२८-११८", "content_sanskrit": "अहं नारी अवध्या च प्रायश्चित्ती भविष्यसि ।\nअवध्यां तु स्त्रियं प्राहुस्तिर्यग्योनिगतामपि॥ ११८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7000356118, "chapter_id": 20356, "verse_number": "२-२८-११९", "content_sanskrit": "विचार्यैवं महाराज न धर्मं त्यक्तुमर्हसि ।\nएवं नानाविधैर्वाक्यैरुक्तो धात्र्या नराधिपः॥ ११९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7000356119, "chapter_id": 20356, "verse_number": "२-२८-१२०", "content_sanskrit": "कोपमेनं महाराज त्यज दारुणमेव हि ।\nप्रसन्ने त्वयि राजेंद्र तदा स्वस्था भवाम्यहम्॥ १२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7000356120, "chapter_id": 20356, "verse_number": "२-२८-१२१", "content_sanskrit": "एवमुक्तस्तया राजा पृथुर्वैन्यः प्रजापतिः ।\nतामुवाच महाभागां धरित्रीं द्विजसत्तमाः॥ १२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}]