[{"id": 2126037, "chapter_id": 3699, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2126038, "chapter_id": 3699, "verse_number": "१", "content_sanskrit": "ततो देवाः सगन्धर्वाः समादायार्घ्यमुत्तमम् ।\nशक्रस्य मतमाज्ञाय पार्थमानर्चुरञ्जसा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2126039, "chapter_id": 3699, "verse_number": "२", "content_sanskrit": "पाद्यमाचमनीयं च प्रतिगृह्य नृपात्मजम् ।\nप्रवेशयामासुरथो पुरन्दरनिवेशनम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2126040, "chapter_id": 3699, "verse_number": "३", "content_sanskrit": "एवं सम्पूजितो जिष्णुरुवास भवने पितुः ।\nउपशिक्षन् महास्त्राणि ससंहाराणि पाण्डवः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2126041, "chapter_id": 3699, "verse_number": "४", "content_sanskrit": "शक्रस्य हस्ताद् दयितं वज्रमस्त्रं दुरुत्सहम् ।\nअशनिं च महानादां मेघबर्हणलक्षणाम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2126042, "chapter_id": 3699, "verse_number": "५", "content_sanskrit": "गृहीतास्त्रस्तु कौन्तेयो भ्रातॄन् सस्मार पाण्डवः ।\nपञ्चाब्दमवसत् तत्र पाकशासनशासनात्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2126043, "chapter_id": 3699, "verse_number": "६", "content_sanskrit": "ततः शक्रोऽब्रवीत् पार्थं कृतास्त्रं काल आगते ।\nनृत्तं गीतं च वाद्यं च चित्रसेनादवाप्नुहि\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2126044, "chapter_id": 3699, "verse_number": "७", "content_sanskrit": "वादित्रं दैवविहितं त्रिलोके यन्न विद्यते ।\nतदाज्ञाय च कौन्तेय श्रेयो वै ते भविष्यति \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2126045, "chapter_id": 3699, "verse_number": "८", "content_sanskrit": "सखायं प्रददौ चास्य चित्रसेनं पुरन्दरः ।\nस तेन सह सङ्गम्य रेमे पार्थो धनञ्जयः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2126046, "chapter_id": 3699, "verse_number": "९", "content_sanskrit": "कदाचिदटमानस्तु महर्षिरथ लोमशः ।\nजगाम शक्रभवनं पुरन्दरदिदृक्षया\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2126047, "chapter_id": 3699, "verse_number": "१०", "content_sanskrit": "स समेत्य नमस्कृत्य देवराजं महामुनिः ।\nददर्शार्धासनगतं पाण्डवं वासवस्य ह\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2126048, "chapter_id": 3699, "verse_number": "११", "content_sanskrit": "ततः शक्राभ्यनुज्ञात आसने चास्तृतोत्तरे ।\nनिषसाद मुनिश्रेष्ठः पूज्यमानो महर्षिभिः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2126049, "chapter_id": 3699, "verse_number": "१२", "content_sanskrit": "तस्य दृष्ट्वाऽभवद्बुद्धिः पार्थमिन्द्रासने स्थितम् ।\nकथं नु क्षत्रियः पार्थः शक्रासनमवाप्तवान्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2126050, "chapter_id": 3699, "verse_number": "१३", "content_sanskrit": "किं तस्य सुकृतं कर्म लोका वा के विनिर्जिताः ।\nय एवमुपसम्प्राप्तः स्थानं देवनमस्कृतम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2126051, "chapter_id": 3699, "verse_number": "१४", "content_sanskrit": "तस्य विज्ञाय सङ्कल्पं शक्रो वृत्रनिषूदनः ।\nलोमशं प्रहसन् वाक्यमिदमाह शचीपतिः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2126052, "chapter_id": 3699, "verse_number": "१५", "content_sanskrit": "ब्रह्मर्षे श्रूयतां यत्ते मनसैतद् विवक्षितम् ।\nनायं केवलमर्त्योऽभूत् क्षत्रियत्वमुपागतः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2126053, "chapter_id": 3699, "verse_number": "१६", "content_sanskrit": "महर्षे मम पुत्रोऽयं कुन्त्या जातो महाभुजः ।\nअस्त्रहेतोरिह प्राप्तः कस्माच्चित् कारणान्तरात्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2126054, "chapter_id": 3699, "verse_number": "१७", "content_sanskrit": "अहो नैनं भवान् वेत्ति पुराणमृषिसत्तमम् ।\nशृणु मे वदतो ब्रह्मन् योऽयं यच्चास्य कारणम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2126055, "chapter_id": 3699, "verse_number": "१८", "content_sanskrit": "नरनारायणावेतौ पुराणावृषिसत्तमौ ।\nताविमावभिजानीहि हृषीकेशधनञ्जयौ\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2126056, "chapter_id": 3699, "verse_number": "१९", "content_sanskrit": "स न शक्यः सुरैर्द्रष्टुमृषिभिर्वा महात्मभिः ।\nतदाश्रमपदं पुण्यं बदरीनाम विश्रुतम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2126057, "chapter_id": 3699, "verse_number": "२०", "content_sanskrit": "स निवासोऽभवद् विप्र विष्णोर्जिष्णोस्तथैव च ।\nयतः प्रववृते गङ्गा सिद्धचारणसेविता\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2126058, "chapter_id": 3699, "verse_number": "२१", "content_sanskrit": "तौ मन्नियोगाद् ब्रह्मर्षे क्षितौ जातौ महाद्युती ।\nभूमेर्भारावतरणं महावीर्यौ करिष्यतः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2126059, "chapter_id": 3699, "verse_number": "२२", "content_sanskrit": "उद्धता ह्यसुराः केचिन्निवातकवचा इति ।\nविप्रियेष्वास्थिताऽस्माकं वरदानेन दर्पिताः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2126060, "chapter_id": 3699, "verse_number": "२३", "content_sanskrit": "अर्थयन्ते सुरान् हन्तुं बलदर्पसमन्विताः ।\nदेवान् न गणयन्ते च तथा दत्तवरा हि ते\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2126061, "chapter_id": 3699, "verse_number": "२४", "content_sanskrit": "पाताळवासिनो रौद्राः दनोः पुत्रा महाबलाः ।\nसर्वदेवसहायोऽपि नाहं योधयितुं क्षमः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2126062, "chapter_id": 3699, "verse_number": "२५", "content_sanskrit": "योऽसौ भूमिगतः श्रीमान् विष्णुर्मधुनिषूदनः ।\nकपिलो नाम देवोऽसौ भगवानजितो हरिः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2126063, "chapter_id": 3699, "verse_number": "२६", "content_sanskrit": "येन पूर्वं महात्मानः खनमाना रसातळम् ।\nदर्शनादेव निहताः सगरस्यात्मजा विभो\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2126064, "chapter_id": 3699, "verse_number": "२७", "content_sanskrit": "तेन कार्यं महद्ब्रह्मन्नस्माकं हि द्विजोत्तम ।\nपार्थेन च महायुद्धे समेताभ्यामसंशयम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2126065, "chapter_id": 3699, "verse_number": "२८", "content_sanskrit": "अयं तेषां समस्तानां शक्तः प्रतिनिवारणे ।\nतान् निहत्य रणे शूरः पुनर्यास्यति मानुषान् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2126066, "chapter_id": 3699, "verse_number": "२९", "content_sanskrit": "भवांश्चास्मन्नियोगेन यातु तावन्महीतळम् ।\nकाम्यके द्रक्ष्यसे वीरं निवसन्तं युधिष्ठिरम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2126067, "chapter_id": 3699, "verse_number": "३०", "content_sanskrit": "स वाच्यो मम सन्देशाद् धर्मात्मा सत्यसङ्गरः ।\nनोत्कण्ठा फल्गुने कार्या कृतास्त्रः शीघ्रमेष्यति\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2126068, "chapter_id": 3699, "verse_number": "३१", "content_sanskrit": "केवलं भुजवीर्येण नाकृतास्त्रेण वा रणे ।\nभीष्मद्रोणादयःशक्या युद्धे प्रतिसमासितुम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2126069, "chapter_id": 3699, "verse_number": "३२", "content_sanskrit": "गृहीतास्त्रो महाबाहुर्गुडाकेशः परन्तपः ।\nनृत्तवादित्रगीतानां दिव्यानां पारमेयिवान्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2126070, "chapter_id": 3699, "verse_number": "३३", "content_sanskrit": "भवानपि विविक्तानि तीर्थानि मनुजेश्वर ।\nभ्रातृभिः सहितः सर्वैर्द्रष्टुमर्हत्यरिन्दम\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2126071, "chapter_id": 3699, "verse_number": "३४", "content_sanskrit": "तीर्थेष्वाप्लुत्य पुण्येषु विपाप्मा विगतज्वरः ।\nराज्यं भोक्ष्यसि धर्मेण सुखी विगतकल्मषः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2126072, "chapter_id": 3699, "verse_number": "३५", "content_sanskrit": "भवांश्चैनं द्विजश्रेष्ठ पर्यटन्तं महीतळे ।\nत्रातुमर्हति विप्राग्र्य तपोबलसमन्वितः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2126073, "chapter_id": 3699, "verse_number": "३६", "content_sanskrit": "गिरिदुर्गेषु च सदा देशेषु विषमेषु च ।\nवसन्ति राक्षसा रौद्रास्तेभ्यो रक्षेत् सदा भवान्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2126074, "chapter_id": 3699, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2126075, "chapter_id": 3699, "verse_number": "३७", "content_sanskrit": "तथेत्यथ प्रतिज्ञाय लोमशः सुमहातपाः ।\nकाम्यकं वनमुद्दिश्य समुपायान्महीतळम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2126076, "chapter_id": 3699, "verse_number": "३८", "content_sanskrit": "ददर्श तत्र कौन्तेयं धर्मराजमरिन्दमम् ।\nतापसैर्भ्रातृभिश्चैव सर्वतः परिवारितम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2126077, "chapter_id": 3699, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि एकचत्वारिंशोऽध्यायः ॥४१॥\n॥ इन्द्रलोकाभिगमनपर्वणि चतुर्थोऽध्यायः ॥४॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]