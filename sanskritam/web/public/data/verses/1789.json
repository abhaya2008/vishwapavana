[{"id": 2036323, "chapter_id": 1789, "verse_number": "५-३४-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2036324, "chapter_id": 1789, "verse_number": "५-३४-१", "content_sanskrit": "जाग्रतो दह्यमानस्य यत्कार्यमनुपश्यसि।\nतद्ब्रूहि त्वं हि नस्तात धर्मार्थकुशलः शुचिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2036325, "chapter_id": 1789, "verse_number": "५-३४-२", "content_sanskrit": "तस्माद्यथावद्विदुर प्रशाधि\nप्रज्ञापूर्वं सर्वमजातशत्रोः।\nयन्मन्यसे पथ्यमदीनसत्व\nश्रेयस्करं ब्रूहि तद्वै कुरूणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2036326, "chapter_id": 1789, "verse_number": "५-३४-३", "content_sanskrit": "पापाशङ्की पापमेवानुपश्यन्\nपृच्छामि त्वां व्याकुलेनात्मनाहम् ।\nकजे तन्मे ब्रूहि तत्पं यथाव-\nन्मनीषितं सर्वमजातशत्रोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2036327, "chapter_id": 1789, "verse_number": "५-३४-४x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2036328, "chapter_id": 1789, "verse_number": "५-३४-४", "content_sanskrit": "शुभं वा यदि वा पापं द्वेष्यं वा यदि वा प्रियम्।\nनापृष्टः कस्यचिद्ब्रूयाद्यः स नेच्छेत्पराभवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2036329, "chapter_id": 1789, "verse_number": "५-३४-५", "content_sanskrit": "तस्माद्वक्ष्यामि ते राजन्हितं यत्स्यान्कुरून्प्रति।\nवचः श्रेयस्करं धर्म्यं ब्रुवतस्तन्निबोध मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2036330, "chapter_id": 1789, "verse_number": "५-३४-६", "content_sanskrit": "मिथ्योपेतानि कर्माणि सिद्ध्येतादीनि भारत।\nअनुपायप्रयुक्तानि मा स्म ते....मनः कृथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2036331, "chapter_id": 1789, "verse_number": "५-३४-७", "content_sanskrit": "तथैव योगविहितं यत्तु कर्म न सिध्यति।\nउपाययुक्तं मेधावी न तत्र ग्लपयेन्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2036332, "chapter_id": 1789, "verse_number": "५-३४-८", "content_sanskrit": "अनुबन्धानवेक्षेत सानुबन्धेषु कर्मसु।\nसंप्रधार्य च कुर्वीत सहसा न समाचरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2036333, "chapter_id": 1789, "verse_number": "५-३४-९", "content_sanskrit": "अनुबन्धं च संप्रेक्ष्य विपाकं चैव कर्मणाम्।\nउत्थानमात्मनश्चैव धीरः कुर्वीत वा न वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2036334, "chapter_id": 1789, "verse_number": "५-३४-१०", "content_sanskrit": "यः प्रमाणं न जानाति स्थाने वृद्धौ तथा क्षये।\nकोशे जनपदे दण्डे न स राज्येऽवतिष्ठते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2036335, "chapter_id": 1789, "verse_number": "५-३४-११", "content_sanskrit": "यस्त्वेतानि प्रमाणानि यथोक्तान्यनुपश्यति।\nयुक्तो धर्मार्थयोर्ज्ञाने स राज्यमधिगच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2036336, "chapter_id": 1789, "verse_number": "५-३४-१२", "content_sanskrit": "न राज्यं प्राप्तमित्येव वर्तितव्यमसांप्रतम्।\nश्रियं ह्यविनयो हन्ति जरा रूपमिवोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2036337, "chapter_id": 1789, "verse_number": "५-३४-१३", "content_sanskrit": "भक्ष्योत्तमप्रतिच्छन्नं मत्स्यो बडिशमायसम्।\nअन्नाभिलाषी ग्रसते नानुबन्धमवेक्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2036338, "chapter_id": 1789, "verse_number": "५-३४-१४", "content_sanskrit": "यच्छक्यं ग्रसितुं ग्रस्यं ग्रस्तं परिणमेच्च यत्।\nहितं च परिणामे यत्तदाद्यं भूतिमिच्छता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2036339, "chapter_id": 1789, "verse_number": "५-३४-१५", "content_sanskrit": "वनस्पतेरपक्वानि फलानि प्रचिनोति यः।\nस नाप्नोति रसं तेभ्यो बीजं चास्य विनश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2036340, "chapter_id": 1789, "verse_number": "५-३४-१६", "content_sanskrit": "यस्तु पक्वमुपादत्ते काले परिणतं फलम्।\nफलाद्रसं स लभते बीजाच्चैव फलं पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2036341, "chapter_id": 1789, "verse_number": "५-३४-१७", "content_sanskrit": "यथा मधु समादत्ते रक्षन्पुष्पाणि षट्पदः।\nतद्वदर्थान्मनुष्येभ्य आदद्यादविहिंसया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2036342, "chapter_id": 1789, "verse_number": "५-३४-१८", "content_sanskrit": "पुष्पं पुष्पं विचिन्वीत मूलच्छेदं न कारयेत् ।\nमालाकार इवारामे न यथाङ्गारकारकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2036343, "chapter_id": 1789, "verse_number": "५-३४-१९", "content_sanskrit": "किं नु मे स्यादिदं कृत्वा किं नु मे स्यादकुर्वतः।\nइति कर्माणि सञ्चिन्त्य कुर्याद्वा पुरुषो न वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2036344, "chapter_id": 1789, "verse_number": "५-३४-२०", "content_sanskrit": "अनारभ्या भवन्त्यर्थाः केचिन्नित्यं यथाऽगताः ।\nकृतः पुरुषकारोऽहि भवेद्येषु निरर्थकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2036345, "chapter_id": 1789, "verse_number": "५-३४-२१", "content_sanskrit": "` अनर्थे चैव निरतमर्थे चैव पराङ्भुखम्।\nन तं भर्तारमिच्छन्ति षण्ढं पतिमिव स्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2036346, "chapter_id": 1789, "verse_number": "५-३४-२२", "content_sanskrit": "प्रसादो निष्फलो यस्य क्रोधश्चापि निरर्थकः।\nन तं भर्तारमिच्छन्ति षण्ढं पतिमिव स्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2036347, "chapter_id": 1789, "verse_number": "५-३४-२३", "content_sanskrit": "कांश्चिदर्थान्नरः प्राज्ञो लघुमूलान्महाफलान् ।\nक्षिप्रमारभते कर्तुं न दीर्घयति तादृशान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2036348, "chapter_id": 1789, "verse_number": "५-३४-२४", "content_sanskrit": "ऋजु पश्यति यः सर्वं चक्षुषा नु पिबन्निव ।\nआसीनमपि तूष्णीकमनुरज्यन्ति तं प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2036349, "chapter_id": 1789, "verse_number": "५-३४-२५", "content_sanskrit": "सुपुष्पितः स्यादफलः फलितः स्याद्दुरारुहः ।\nअपक्वः पक्वसङ्काशो न तु शीर्येत कर्हिचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2036350, "chapter_id": 1789, "verse_number": "५-३४-२६", "content_sanskrit": "चक्षुषा मनसा वाचा कर्मणा च चतुर्विधम्।\nप्रसादयति यो लोकं तं लोकोऽनुप्रसीदति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2036351, "chapter_id": 1789, "verse_number": "५-३४-२७", "content_sanskrit": "यस्मात्रस्यन्ति भूतानि मृगव्याधान्मृगा इव।\nसागरान्तामपि महीं लब्ध्वा स परिहीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2036352, "chapter_id": 1789, "verse_number": "५-३४-२८", "content_sanskrit": "पितृपैतामहं राज्यं प्राप्यापि स्वेन कर्मणा।\nवायुरभ्रमिवासाद्य भ्रंशयत्यनये स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2036353, "chapter_id": 1789, "verse_number": "५-३४-२९", "content_sanskrit": "धर्ममाचरतो राज्ञः सद्भिश्चरितमादितः।\nवसुधा वसुसंपूर्णा वर्धते भूतिवर्धनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2036354, "chapter_id": 1789, "verse_number": "५-३४-३०", "content_sanskrit": "अथ संत्यजतो धर्ममधर्मं चानुतिष्ठतः।\nप्रतिसंवेष्टते भूमिरग्नौ चर्माहितं यथा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2036355, "chapter_id": 1789, "verse_number": "५-३४-३१", "content_sanskrit": "य एव यत्नः क्रियते परराष्ट्रविमर्दने।\nस एव यत्नः कर्तव्यः स्वराष्ट्रपरिपालने ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2036356, "chapter_id": 1789, "verse_number": "५-३४-३२", "content_sanskrit": "धर्मेण राज्यं विन्देत धर्मेण परिपालयेत्।\nधर्ममूलां श्रियं प्राप्य न जहाति न हीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2036357, "chapter_id": 1789, "verse_number": "५-३४-३३", "content_sanskrit": "अप्युन्मत्तात्प्रलपतो बालाच्च परिजल्पतः।\nसर्वतः सारमादद्यादश्मभ्य इव काञ्चनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2036358, "chapter_id": 1789, "verse_number": "५-३४-३४", "content_sanskrit": "सुव्याहृतानि महतां सुकृतानि ततस्ततः।\nसञ्चिन्वन्धीर आसीत शिलाहारी शिलं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2036359, "chapter_id": 1789, "verse_number": "५-३४-३५", "content_sanskrit": "गन्धेन गावः पश्यन्ति वेदैः पश्यन्ति ब्राह्मणाः ।\nचारैः पश्यन्ति राजानश्चक्षुर्भ्यामितरे जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2036360, "chapter_id": 1789, "verse_number": "५-३४-३६", "content_sanskrit": "भूयांसं लभते क्लेशं या गौर्भवति दुर्दुहा ।\nअथ या सुदुघा राजन्नैव तां वितुदन्त्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2036361, "chapter_id": 1789, "verse_number": "५-३४-३७", "content_sanskrit": "यदतप्तं प्रणमति न तत्सन्तापमर्हति।\nयच्च स्वयं नतं दारु न तत्संनामयेद्बुधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2036362, "chapter_id": 1789, "verse_number": "५-३४-३८", "content_sanskrit": "एतयोपमया धीरः सन्नमेत बलीयसे।\nइन्द्राय स प्रणमते नमते यो बलीयसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2036363, "chapter_id": 1789, "verse_number": "५-३४-३९", "content_sanskrit": "पर्जन्यनाथाः पशवो राजानो मन्त्रिबान्धवाः।\nपतयो बान्धवाः स्त्रीणां ब्राह्मणा वेदबान्धवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2036364, "chapter_id": 1789, "verse_number": "५-३४-४०", "content_sanskrit": "सत्येन रक्ष्यते धर्मो विद्या योगेन रक्ष्यते ।\nमृजया रक्ष्यते रूपं कुलं वृत्तेन रक्ष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2036365, "chapter_id": 1789, "verse_number": "५-३४-४१", "content_sanskrit": "मानेन रक्ष्यते धान्यमश्वान्रक्षेदनुक्रमात्।\nअभीक्ष्णदर्शनाद्गावः स्त्रियो रक्ष्याः कुचेलतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2036366, "chapter_id": 1789, "verse_number": "५-३४-४२", "content_sanskrit": "न कुलं वृत्तहीनस्य प्रमाणमिति मे मतिः।\nअन्तेष्वपि हि जातानां वृत्तमेव विशिष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2036367, "chapter_id": 1789, "verse_number": "५-३४-४३", "content_sanskrit": "य ईर्षुः परवित्तेषु रूपे वीर्ये कुलान्वये ।\nसुखसौभाग्यसत्कारे तस्य व्याधिरनन्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2036368, "chapter_id": 1789, "verse_number": "५-३४-४४", "content_sanskrit": "अकार्यकरणाद्भीतः कार्याणां च विवर्जनात्।\nअकाले मन्त्रभेदाच्च येन माद्येन्न तत्पिबेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2036369, "chapter_id": 1789, "verse_number": "५-३४-४५", "content_sanskrit": "विद्यामदो धनमदस्तृतीयोऽभिजनो मदः।\nमदा एतेऽवलिप्तानामेत एव सतां दमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2036370, "chapter_id": 1789, "verse_number": "५-३४-४६", "content_sanskrit": "असन्तोऽभ्यर्थिताः सद्भिः क्वचित्कार्ये कदाचन।\nमन्यन्ते सन्तमात्मानमसन्तमपि विश्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2036371, "chapter_id": 1789, "verse_number": "५-३४-४७", "content_sanskrit": "गतिरात्मवतां सन्तः सन्त एव सतां गतिः ।\nअसतां च गतिः सन्तो न त्वसन्तः सतां गतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2036372, "chapter_id": 1789, "verse_number": "५-३४-४८", "content_sanskrit": "जिता सभा वस्त्रवता मिष्टाशा गोमता जिता।\nअध्वा जितो यानवता सर्वं शीलवता जितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2036373, "chapter_id": 1789, "verse_number": "५-३४-४९", "content_sanskrit": "शीलं प्रधानं पुरुषे तद्यस्येह प्रणश्यति।\nन तस्य जीवितेनार्थो न धनेन न बन्धुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2036374, "chapter_id": 1789, "verse_number": "५-३४-५०", "content_sanskrit": "आढ्यानां मांसपरमं मध्यानां गोरसोत्तरम्।\nतैलोत्तरं दरिद्राणां भोजनं भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2036375, "chapter_id": 1789, "verse_number": "५-३४-५१", "content_sanskrit": "संपन्नतरमेवान्नं दरिद्रा भुञ्जते सदा।\nश्रुत्स्वादुतां जनयति सा चाढ्येषु सुदुर्लभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2036376, "chapter_id": 1789, "verse_number": "५-३४-५२", "content_sanskrit": "प्रायेण श्रीमतां लोके भोक्तुं शक्तिर्न विद्यते।\nजीर्यन्त्यपि हि काष्ठानि दरिद्राणां महीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2036377, "chapter_id": 1789, "verse_number": "५-३४-५३", "content_sanskrit": "अवृत्तिर्भयमन्त्यानां मध्यानां मरणाद्भयम् ।\nउत्तमानां तु मर्त्यानामवमानात्परं भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2036378, "chapter_id": 1789, "verse_number": "५-३४-५४", "content_sanskrit": "ऐश्वर्यमदपापिष्ठा मदाः पानमदादयः ।\nऐश्वर्यमदमत्तो हि नो पतित्वाऽवबुध्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2036379, "chapter_id": 1789, "verse_number": "५-३४-५५", "content_sanskrit": "इन्द्रियौरिन्द्रियार्थेषु वर्तमानैरनिग्रहैः ।\nतैरयं ताप्यते लोको नक्षत्राणि ग्रहैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2036380, "chapter_id": 1789, "verse_number": "५-३४-५६", "content_sanskrit": "यो जितः पञ्चवर्गेण सहजेनात्मकर्षिणा ।\nआपदस्तस्य वर्धन्ते शुक्लपक्ष इवोडुराट् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2036381, "chapter_id": 1789, "verse_number": "५-३४-५७", "content_sanskrit": "अविजित्य य आत्मानममात्यान्विजिगीषते ।\nअमित्रान्वा जितामात्यः सोऽवशः परिहीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2036382, "chapter_id": 1789, "verse_number": "५-३४-५८", "content_sanskrit": "आत्मानमेव प्रथमं द्वेष्यरूपेण योजयेत् ।\nततोऽमात्यानमित्रांश्च न मोघं विजिगीषते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2036383, "chapter_id": 1789, "verse_number": "५-३४-५९", "content_sanskrit": "वश्येन्द्रियं जितामात्यं धृतदण्डं विकारिषु ।\nपरीक्ष्यकारिणं धीरमत्यन्तं श्रीर्निषेवते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2036384, "chapter_id": 1789, "verse_number": "५-३४-६०", "content_sanskrit": "रथः शरीरं पुरुषस्य राज-\nन्नात्मा नियन्तेन्द्रियाण्यस्य चाश्वाः।\nतैरप्रमत्तः कुशली सदश्वै-\nर्दान्तैः सुखं याति रथीव धीरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2036385, "chapter_id": 1789, "verse_number": "५-३४-६१", "content_sanskrit": "एतान्यनिगृहीतानि व्यापादयितुमप्यलम्।\nअविधेया इवादान्ताः सरथं सारथिं हयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2036386, "chapter_id": 1789, "verse_number": "५-३४-६२", "content_sanskrit": "अनर्थमर्थतः पश्यन्नर्थं चैवाप्यनर्थतः।\nइन्द्रियैरजितैर्बालः सुदुःखं मन्यते सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2036387, "chapter_id": 1789, "verse_number": "५-३४-६३", "content_sanskrit": "धर्मार्थौ यः परित्यज्य स्यादिन्द्रियवशानुगः ।\nश्रीप्राणधनदारेभ्यः क्षिप्रं स परिहीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2036388, "chapter_id": 1789, "verse_number": "५-३४-६४", "content_sanskrit": "अर्थानामीश्वरो यः स्यादिन्द्रियाणामनीश्वरः।\nइन्द्रियाणामनैश्वर्यादैश्वार्याद्भूश्यते हि सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2036389, "chapter_id": 1789, "verse_number": "५-३४-६५", "content_sanskrit": "आत्मनात्मानमन्विच्छेन्मनोबुद्धीन्द्रियैर्यतैः ।\nआत्मा ह्येवात्मनो बन्धुरात्मैव रिपुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2036390, "chapter_id": 1789, "verse_number": "५-३४-६६", "content_sanskrit": "बन्धुरात्मात्मनस्तस्य येनैवात्मात्मना जितः।\nस एव नियतो बन्धुः स एव नियतो रिपुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2036391, "chapter_id": 1789, "verse_number": "५-३४-६७", "content_sanskrit": "क्षुद्राक्षेणेव जालेन झपावपिहितावुरू।\nकामश्च राजन्क्रोधश्च तौ प्रज्ञानं विलुम्पतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2036392, "chapter_id": 1789, "verse_number": "५-३४-६८", "content_sanskrit": "समवेक्ष्येह धर्मार्थौ संभारान्योऽधिगच्छति।\nस वै संभृतसंभारः सततं सुखमेधते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2036393, "chapter_id": 1789, "verse_number": "५-३४-६९", "content_sanskrit": "यः पञ्चाभ्यन्तराञ्शत्रूनविजित्य मनोमयान्।\nजिगीषति रिपूनन्यान्रिपवोऽभिभवन्ति तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2036394, "chapter_id": 1789, "verse_number": "५-३४-७०", "content_sanskrit": "दृश्यन्ते हि महात्मानो बध्यमानाः स्वकर्मभिः।\nइन्द्रियाणामनीशत्वाद्राजानो राज्यविभ्रमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2036395, "chapter_id": 1789, "verse_number": "५-३४-७१", "content_sanskrit": "असंत्यागात्पापकृतामपापां-\nस्तुल्यो दण्डः स्पृशते मिश्रभावात्।\nशुष्केणार्द्रं दह्यते मिश्रभावा-\nत्तस्मात्पापैः सह सन्धिं न कुर्यात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2036396, "chapter_id": 1789, "verse_number": "५-३४-७२", "content_sanskrit": "निजानुत्पततः शत्रून्पश्च पञ्चप्रयोजनान्।\nयो मोहान्न निगृह्णाति तमापद्ग्रसते नरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2036397, "chapter_id": 1789, "verse_number": "५-३४-७३", "content_sanskrit": "अनसूयार्जवं शौचं सन्तोषः प्रियवादिता।\nदमः सत्यमनायासो न भवन्ति दुरात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2036398, "chapter_id": 1789, "verse_number": "५-३४-७४", "content_sanskrit": "आत्मज्ञानमानायासस्तितिक्षा धर्मनित्यता।\nवाक्चैव गुप्ता दानं च नैतान्यन्त्येषु भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2036399, "chapter_id": 1789, "verse_number": "५-३४-७५", "content_sanskrit": "आक्रोशपरिवादाभ्यां विहिंसन्त्यबुधा बुधान्।\nवक्ता पापमुपादत्ते क्षममाणो विमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2036400, "chapter_id": 1789, "verse_number": "५-३४-७६", "content_sanskrit": "हिंसा बलमसाधूनां राज्ञां दण्डविधिर्बलम् ।\nशुश्रूपा तु वलं स्त्रीणां क्षमा गुणवतां बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2036401, "chapter_id": 1789, "verse_number": "५-३४-७७", "content_sanskrit": "वाक्संयमो हि नृपते सुदुष्करतमो मतः।\nअर्थवच्च विचित्रं च न शक्यं बहु भाषितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2036402, "chapter_id": 1789, "verse_number": "५-३४-७८", "content_sanskrit": "अभ्यावहति कल्याणं विविधं वाक् सुभाषिता ।\nसैव दुर्भाषिता राजन्ननर्थायोपपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2036403, "chapter_id": 1789, "verse_number": "५-३४-७९", "content_sanskrit": "रोहते सायकैर्विद्धं वनं परशुना हतम्।\nवाचा दुरुक्तं बीभत्सं न संरोहति वाक्क्षतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2036404, "chapter_id": 1789, "verse_number": "५-३४-८०", "content_sanskrit": "कर्णिनालीकनाराचान्निर्हरन्ति शरीरतः।\nवाक्छशल्यस्तु न निर्हर्तुं शक्यो हृदिशयो हि सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2036405, "chapter_id": 1789, "verse_number": "५-३४-८१", "content_sanskrit": "वाक्सायका वदनान्निष्पतन्ति\nयैराहतः शोचति रात्र्यहानि।\nपरस्य नामर्मसु ते पतन्ति\nतान्पण्डितो नावसृजेत्परेभ्यः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2036406, "chapter_id": 1789, "verse_number": "५-३४-८२", "content_sanskrit": "यस्मै देवाः प्रयच्छन्ति पुरुषाय पराभवम्।\nबुद्धिं तस्यापकर्षन्ति सोऽवाचीनानि पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2036407, "chapter_id": 1789, "verse_number": "५-३४-८३", "content_sanskrit": "बुद्धौ कलुषभूतायां विनाशे प्रत्युपस्थिते।\nअनयो नयसङ्काशो हृदयान्नापसर्पति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2036408, "chapter_id": 1789, "verse_number": "५-३४-८४", "content_sanskrit": "सेयं बुद्धिः परीता ते पुत्राणां भरतर्षभ ।\nपाण्डवानां विरोधेन न चैनानवबुध्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2036409, "chapter_id": 1789, "verse_number": "५-३४-८५", "content_sanskrit": "राजा लक्षणसंपन्नस्त्रैलोक्यस्यापि यो भवेत्।\nशिष्यस्ते शासिता सोऽस्तु धृतराष्ट्र युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2036410, "chapter_id": 1789, "verse_number": "५-३४-८६", "content_sanskrit": "अतीव सर्वान्पुत्रांस्ते भागधेयपुरस्कृतः।\nतेजसा प्रज्ञया चैव युक्तो धर्मर्थतत्त्ववित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2036411, "chapter_id": 1789, "verse_number": "५-३४-८७", "content_sanskrit": "अनुक्रोशादानृशंस्याद्योऽसौ धर्मभृतां वरः।\nगौरवात्तव राजेन्द्र बहून्क्लेशांस्तितिक्षति ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2036412, "chapter_id": 1789, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि प्रजागरपर्वणि चतुस्त्रिंशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}]