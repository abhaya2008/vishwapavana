[{"id": 2056393, "chapter_id": 2228, "verse_number": "७-१५५-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2056394, "chapter_id": 2228, "verse_number": "७-१५५-१", "content_sanskrit": "यत्तदा प्राविशत्पाण्डूनाचार्यः कुपितो बली।\nउक्ता दुर्योधनं मन्दं मम शास्त्रातिगं सुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2056395, "chapter_id": 2228, "verse_number": "७-१५५-२", "content_sanskrit": "प्रविश्य विचरन्तं च रथे शूरमवस्थितम्।\nकथं द्रोणं महेष्वासं पाण्डवाः पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2056396, "chapter_id": 2228, "verse_number": "७-१५५-३", "content_sanskrit": "केऽरक्षन्दक्षिणं चक्रमाचार्यस्य महाहवे।\nके चोत्तरमरक्षन्त निघ्नतः शास्त्रवान्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2056397, "chapter_id": 2228, "verse_number": "७-१५५-४", "content_sanskrit": "के चास्य पृष्ठतोऽन्वासन्वीरा वीरस्य योधिनः।\nके पुरस्तादवर्तन्त रथिनस्तस्य शत्रवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2056398, "chapter_id": 2228, "verse_number": "७-१५५-५", "content_sanskrit": "मन्ये तानस्पृशच्छीतमतिवेलमनार्तवम्।\nमन्ये ते समवेपन्त गावो वै शिशिरे यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2056399, "chapter_id": 2228, "verse_number": "७-१५५-६", "content_sanskrit": "यत्प्राविशन्महेष्वासः पाञ्चालानपराजितः।\nनृत्यन्स रथमार्गेषु सर्वशस्त्रभृतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2056400, "chapter_id": 2228, "verse_number": "७-१५५-७", "content_sanskrit": "निर्दहन्सर्वसैन्यानि पाञ्चालानां रथर्षभः।\nधूमकेतुरिव क्रुद्धः कथं मृत्युमुपेयिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2056401, "chapter_id": 2228, "verse_number": "७-१५५-८x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2056402, "chapter_id": 2228, "verse_number": "७-१५५-८", "content_sanskrit": "सायाह्ने सैन्धवं हत्वा राज्ञा पार्थः समेत्य च।\nसात्यकिश्च महेष्वासो द्रोणमेवाभ्यधावताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2056403, "chapter_id": 2228, "verse_number": "७-१५५-९", "content_sanskrit": "तथा युधिष्ठिरस्तूर्णं भीमसेनश्च पाण्डवः।\nपृथक्चमूभ्यां संयत्तौ द्रोणमेवाभ्यधावताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2056404, "chapter_id": 2228, "verse_number": "७-१५५-१०", "content_sanskrit": "तथैव नकुलो धीमान्सहदेवश्च दुर्जयः।\nधृष्टद्युम्नः शतानीको विराटश्च सकेकयः।\nमात्स्याः साल्वाः ससेनाश्च द्रोणमेव ययुर्युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2056405, "chapter_id": 2228, "verse_number": "७-१५५-११", "content_sanskrit": "द्रुपदश्च तथा राजा पाञ्चालैरभिरक्षितः।\nधृष्टद्युम्नपिता राजन्द्रोणमेवाभ्यवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2056406, "chapter_id": 2228, "verse_number": "७-१५५-१२", "content_sanskrit": "द्रौपदेया महेष्वासा राक्षसश्च घटोत्कचः।\nससैन्यास्ते न्यवर्तन्त द्रोणमेव महाद्युतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2056407, "chapter_id": 2228, "verse_number": "७-१५५-१३", "content_sanskrit": "प्रभद्रकाश्च पाञ्चालाः षट्सहस्राः प्रहारिणः।\nद्रोणमेवाभ्यवर्तन्त पुरस्कृत्य शिखण्डिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2056408, "chapter_id": 2228, "verse_number": "७-१५५-१४", "content_sanskrit": "तथेतरे नरव्याघ्राः पाण्डवानां महारथाः।\nसहिताः सन्न्यवर्तन्त द्रोणमेव द्विजर्षभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2056409, "chapter_id": 2228, "verse_number": "७-१५५-१५", "content_sanskrit": "तेषु शूरेषु युद्धाय गतेषु भरतर्षभ।\nबभूव रजनी घोरा भीरूणां भयवर्धिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2056410, "chapter_id": 2228, "verse_number": "७-१५५-१६", "content_sanskrit": "योधानामशिवा रौद्रा राजन्नन्तकगामिनी।\nकुञ्जराश्वमनुष्याणां प्राणान्तकरणी तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2056411, "chapter_id": 2228, "verse_number": "७-१५५-१७", "content_sanskrit": "तस्यां रजन्यां घोरायां नदन्त्यः सर्वतः शिवाः।\nन्यवेदयन्भयं घोरं सज्वालकबलैर्मुखैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2056412, "chapter_id": 2228, "verse_number": "७-१५५-१८", "content_sanskrit": "उलूकाश्चाप्यदृश्यन्त शंसन्तो विपुलं भयम्।\nविशेषतः कौरवाणां ध्वजिन्यामतिदारुणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2056413, "chapter_id": 2228, "verse_number": "७-१५५-१९", "content_sanskrit": "ततः सैन्येषु राजेन्द्र शब्दः समभवन्महान्।\nभेरीशब्देन महता मृदङ्गानां स्वनेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2056414, "chapter_id": 2228, "verse_number": "७-१५५-२०", "content_sanskrit": "गजानां बृंहितैश्चापि तुरङ्गाणां च हेषितैः।\nखुरशब्दनिपातैश्च तुमुलः सर्वतोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2056415, "chapter_id": 2228, "verse_number": "७-१५५-२१", "content_sanskrit": "ततः समभवद्युद्धं सन्ध्यायामतिदारुणम्।\nद्रोणस्य च महाराज सृञ्जयानां च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2056416, "chapter_id": 2228, "verse_number": "७-१५५-२२", "content_sanskrit": "तमसा चावृते लोके न प्राज्ञायत किञ्चन।\nसैन्येन रजसा चैव समन्तादुत्थितेन ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2056417, "chapter_id": 2228, "verse_number": "७-१५५-२३", "content_sanskrit": "नरस्याश्वस्य नागस्य समसज्जत शोणितम्।\nनापश्याम रजो भौमं कश्मलेनाभिसंवृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2056418, "chapter_id": 2228, "verse_number": "७-१५५-२४", "content_sanskrit": "रात्रौ वंशवनस्येव दह्यमानस्य पर्वते।\nघोरश्चटचटाशब्दः शस्त्राणां पततामभूत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2056419, "chapter_id": 2228, "verse_number": "७-१५५-२५", "content_sanskrit": "मृदङ्गानकनिर्ह्रादैर्झर्झरैः पटहैस्तथा।\nफेत्कारैर्हेषितैः शब्दैः सर्वमैवाकुलं बभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2056420, "chapter_id": 2228, "verse_number": "७-१५५-२६", "content_sanskrit": "नैव स्वे न परे राजन्प्राज्ञायन्त तमोवृते।\nउन्मत्तमिव तत्सर्वं बभूव रजनीमुखे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2056421, "chapter_id": 2228, "verse_number": "७-१५५-२७", "content_sanskrit": "भौमं रजोऽथ राजेन्द्र शोणितेन प्रणाशितम्।\nशातकौम्भैश्च कवचैर्भूषणैश्च तमोऽनशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2056422, "chapter_id": 2228, "verse_number": "७-१५५-२८", "content_sanskrit": "ततः सा भारती सेना मणिहेमविभूषिता।\nद्यौरिवासीत्सनक्षत्रा रजन्यां भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2056423, "chapter_id": 2228, "verse_number": "७-१५५-२९", "content_sanskrit": "गोमायुबलसङ्घुष्टा शक्तिध्वजसमाकुला।\nवारणाभिरुता घोरा क्ष्वेडितोत्क्रुष्टनादिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2056424, "chapter_id": 2228, "verse_number": "७-१५५-३०", "content_sanskrit": "तत्राभवन्महाशब्दस्तुमुलो रोमहर्षणः।\nसमावृण्वन्दिशः सर्वा महेन्द्राशनिनिःस्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2056425, "chapter_id": 2228, "verse_number": "७-१५५-३१", "content_sanskrit": "सा निशीथे महाराज सेनाऽदृश्यत भारती।\nअङ्गदैः कुण्डलैर्निष्कैः शस्त्रैश्चैवावभासिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2056426, "chapter_id": 2228, "verse_number": "७-१५५-३२", "content_sanskrit": "तत्र नागा रथाश्चैव जाम्बूनदविभूषिताः।\nनिशायां प्रत्यदृश्यन्त मेघा इव सविद्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2056427, "chapter_id": 2228, "verse_number": "७-१५५-३३", "content_sanskrit": "ऋष्टिशक्तिगदाबाणमुसलप्रासपट्टसाः।\nसम्पतन्तो व्यदृश्यन्त भ्राजमाना इवाग्नयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2056428, "chapter_id": 2228, "verse_number": "७-१५५-३४", "content_sanskrit": "दुर्योधनपुरोवातां रथनागवलाहकाम्।\nवादित्रघोषस्तनितां चापविद्युद्व्वजैर्वृताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2056429, "chapter_id": 2228, "verse_number": "७-१५५-३५", "content_sanskrit": "द्रोणपाण्डवपर्जन्यां खङ्गशक्तिगदाशनिम्।\nशरधारास्त्रपवनां शस्त्रपातोष्मसङ्कुलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2056430, "chapter_id": 2228, "verse_number": "७-१५५-३६", "content_sanskrit": "घोरां विस्मापनीमुग्रां जीवितच्छिदमप्लुवाम्।\nतां प्राविशन्नतिभयां नदीं युद्धचिकीर्षवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2056431, "chapter_id": 2228, "verse_number": "७-१५५-३७", "content_sanskrit": "तस्मिन्रात्रिमुखे घोरे महाशब्दनिनादिते।\nभीरूणां त्रासजनने शूराणां हर्षवर्धने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2056432, "chapter_id": 2228, "verse_number": "७-१५५-३८", "content_sanskrit": "रात्रियुद्धे महाघोरे वर्तमाने सुदारुणे।\nद्रोणमभ्यद्रुवन्क्रुद्धाः सहिताः पाण्डुसृञ्जयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2056433, "chapter_id": 2228, "verse_number": "७-१५५-३९", "content_sanskrit": "ये ये प्रमुखतो राजन्नावर्तन्त महारथाः।\nतान्सर्वान्विमुखांश्चक्रे कांश्चिन्निन्ये यमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2056434, "chapter_id": 2228, "verse_number": "७-१५५-४०", "content_sanskrit": "तानि नागसहस्राणि रथानामयुतानि च।\nपदातिहयसङ्घानां प्रयुतान्यर्बुदानि च।\nद्रोणेनैकेन नाराचैर्निर्भिन्नानि निशामुखे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2056435, "chapter_id": 2228, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि घटोत्कचवधपर्वणि चतुर्दशरात्रियुद्धे पञ्चपञ्चाशदधिकशततमोऽध्यायः॥ १५५ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१५५-१ शास्त्रातिगं शास्त्रमाज्ञा॥ ५-१५५-७ धूमकेतुरग्निः ॥ ५-१५५-१४ सन्न्यवर्तन्त सम्मुखं नितरामवर्तन्त॥ ५-१५५-१५५ पञ्चपञ्चाशदधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]