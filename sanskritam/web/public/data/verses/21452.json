[{"id": 7001452000, "chapter_id": 21452, "verse_number": "७-१-२५-१", "content_sanskrit": "वायुरुवाच ।\nततः प्रदक्षिणीकृत्य पतिमम्बा पतिव्रता ।\nनियम्य च वियोगार्तिं जगाम हिमवद्गिरिम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001452001, "chapter_id": 21452, "verse_number": "७-१-२५-२", "content_sanskrit": "तपःकृतवती पूर्वं देशे यस्मिन्सखीजनैः ।\nतमेव देशमवृनोत्तपसे प्रणयात्पुनः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001452002, "chapter_id": 21452, "verse_number": "७-१-२५-३", "content_sanskrit": "ततः स्वपितरं दृष्ट्वा मातरं च तयोर्गृहे ।\nप्रणम्य वृत्तं विज्ञाप्य ताभ्यां चानुमता सती॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001452003, "chapter_id": 21452, "verse_number": "७-१-२५-४", "content_sanskrit": "पुनस्तपोवनं गत्वा भूषणानि विसृज्य च ।\nस्नात्वा तपस्विनो वेषं कृत्वा परमपावनम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001452004, "chapter_id": 21452, "verse_number": "७-१-२५-५", "content_sanskrit": "संकल्प्य च महातीव्रं तपः परमदुश्चरम् ।\nसदा मनसि सन्धाय भर्तुश्चरणपंकजम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001452005, "chapter_id": 21452, "verse_number": "७-१-२५-६", "content_sanskrit": "तमेव क्षणिके लिंगे ध्यात्वा बाह्यविधानतः ।\nत्रिसन्ध्यमभ्यर्चयन्ती वन्यैः पुष्पैः फलादिभिः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001452006, "chapter_id": 21452, "verse_number": "७-१-२५-७", "content_sanskrit": "स एव ब्रह्मणो मूर्तिमास्थाय तपसः फलम् ।\nप्रदास्यति ममेत्येवं नित्यं कृत्वा ऽकरोत्तपः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001452007, "chapter_id": 21452, "verse_number": "७-१-२५-८", "content_sanskrit": "तथा तपश्चरन्तीं तां काले बहुतिथे गते ।\nदृष्टः कश्चिन्महाव्याघ्रो दुष्टभावादुपागमत्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001452008, "chapter_id": 21452, "verse_number": "७-१-२५-९", "content_sanskrit": "तथैवोपगतस्यापि तस्यातीवदुरात्मनः ।\nगात्रं चित्रार्पितमिव स्तब्धं तस्यास्सकाशतः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001452009, "chapter_id": 21452, "verse_number": "७-१-२५-१०", "content_sanskrit": "तं दृष्ट्वापि तथा व्याघ्रं दुष्टभावादुपागतम् ।\nन पृथग्जनवद्देवी स्वभावेन विविच्यते॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001452010, "chapter_id": 21452, "verse_number": "७-१-२५-११", "content_sanskrit": "स तु विष्टब्धसर्वांगो बुभुक्षापरिपीडितः ।\nममामिषं ततो नान्यदिति मत्वा निरन्तरम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001452011, "chapter_id": 21452, "verse_number": "७-१-२५-१२", "content_sanskrit": "निरीक्ष्यमाणः सततं देवीमेव तदा ऽनिशम् ।\nअतिष्ठदग्रतस्तस्या उपासनमिवाचरत्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001452012, "chapter_id": 21452, "verse_number": "७-१-२५-१३", "content_sanskrit": "देव्याश्च हृदये नित्यं ममैवायमुपासकः ।\nत्राता च दुष्टसत्त्वेभ्य इति प्रववृते कृपा॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001452013, "chapter_id": 21452, "verse_number": "७-१-२५-१४", "content_sanskrit": "तस्या एव कृपा योगात्सद्योनष्टमलत्रयः ।\nबभूव सहसा व्याघ्रो देवीं च बुबुधे तदा॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001452014, "chapter_id": 21452, "verse_number": "७-१-२५-१५", "content_sanskrit": "न्यवर्तत बुभुक्षा च तस्यांगस्तम्भनं तथा ।\nदौरात्म्यं जन्मसिद्धं च तृप्तिश्च समजायत॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001452015, "chapter_id": 21452, "verse_number": "७-१-२५-१६", "content_sanskrit": "तदा परमभावेन ज्ञात्वा कार्तार्थ्यमात्मनः ।\nसद्योपासक एवैष सिषेवे परमेश्वरीम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001452016, "chapter_id": 21452, "verse_number": "७-१-२५-१७", "content_sanskrit": "दुष्टानामपि सत्त्वानां तथान्येषान्दुरात्मनाम् ।\nस एव द्रावको भूत्वा विचचार तपोवने॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001452017, "chapter_id": 21452, "verse_number": "७-१-२५-१८", "content_sanskrit": "तपश्च ववृधे देव्यास्तीव्रं तीव्रतरात्मकम् ।\nदेवाश्च दैत्यनिर्बन्धाद्ब्रह्माणं शरणं गताः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001452018, "chapter_id": 21452, "verse_number": "७-१-२५-१९", "content_sanskrit": "चक्रुर्निवेदनं देवाः स्वदुःखस्यारिपीडनात् ।\nयथा च ददतुः शुम्भनिशुम्भौ वरसम्मदात्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001452019, "chapter_id": 21452, "verse_number": "७-१-२५-२०", "content_sanskrit": "सो ऽपि श्रुत्वा विधिर्दुःखं सुराणां कृपयान्वितः ।\nआसीद्दैत्यवधायैव स्मृत्वा हेत्वाश्रयां कथाम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001452020, "chapter_id": 21452, "verse_number": "७-१-२५-२१", "content_sanskrit": "सामरः प्रार्थितो ब्रह्मा ययौ देव्यास्तपोवनम् ।\nसंस्मरन्मनसा देवदुःखमोक्षं स्वयत्नतः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001452021, "chapter_id": 21452, "verse_number": "७-१-२५-२२", "content_sanskrit": "ददर्श च सुरश्रेष्ठः श्रेष्ठे तपसि निष्ठिताम् ।\nप्रतिष्ठामिव विश्वस्य भवानीं परमेश्वरीम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001452022, "chapter_id": 21452, "verse_number": "७-१-२५-२३", "content_sanskrit": "ननाम चास्य जगतो मातरं स्वस्य वै हरेः ।\nरुद्रस्य च पितुर्भार्यामार्यामद्रीश्वरात्मजाम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001452023, "chapter_id": 21452, "verse_number": "७-१-२५-२४", "content_sanskrit": "ब्रह्माणमागतं दृष्ट्वा देवी देवगणैः सह ।\nअर्घ्यं तदर्हं दत्त्वा ऽस्मै स्वागताद्यैरुपाचरत्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001452024, "chapter_id": 21452, "verse_number": "७-१-२५-२५", "content_sanskrit": "तां च प्रत्युपचारोक्तिं पुरस्कृत्याभिनंद्य च ।\nपप्रच्छ तपसो हेतुमजानन्निव पद्मजः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001452025, "chapter_id": 21452, "verse_number": "७-१-२५-२६", "content_sanskrit": "ब्रह्मोवाच ।\nतीव्रेण तपसानेन देव्या किमिह साध्यते ।\nतपःफलानां सर्वेषां त्वदधीना हि सिद्धयः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001452026, "chapter_id": 21452, "verse_number": "७-१-२५-२७", "content_sanskrit": "यश्चैव जगतां भर्ता तमेव परमेश्वरम् ।\nभर्तारमात्मना प्राप्य प्राप्तञ्च तपसः फलम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001452027, "chapter_id": 21452, "verse_number": "७-१-२५-२८", "content_sanskrit": "अथवा सर्वमेवैतत्क्रीडाविलसितं तव ।\nइदन्तु चित्रं देवस्य विरहं सहसे कथम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001452028, "chapter_id": 21452, "verse_number": "७-१-२५-२९", "content_sanskrit": "देव्युवाच ।\nसर्गादौ भवतो देवादुत्पत्तिः श्रूयते यदा ।\nतदा प्रजानां प्रथमस्त्वं मे प्रथमजः सुतः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001452029, "chapter_id": 21452, "verse_number": "७-१-२५-३०", "content_sanskrit": "यदा पुनः प्रजावृद्ध्यै ललाटाद्भवतो भवः ।\nउत्पन्नो ऽभूत्तदा त्वं मे गुरुः श्वशुरभावतः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001452030, "chapter_id": 21452, "verse_number": "७-१-२५-३१", "content_sanskrit": "यदा भवद्गिरीन्द्रस्ते पुत्रो मम पिता स्वयम् ।\nतदा पितामहस्त्वं मे जातो लोकपितामह॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001452031, "chapter_id": 21452, "verse_number": "७-१-२५-३२", "content_sanskrit": "तदीदृशस्य भवतो लोकयात्राविधायिनः ।\nवृत्तवन्तःपुरे भर्ता कथयिष्ये कथं पुनः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001452032, "chapter_id": 21452, "verse_number": "७-१-२५-३३", "content_sanskrit": "किमत्र बहुना देहे यश्चायं मम कालिमा ।\nत्यक्त्वा सत्त्वविधानेन गौरी भवितुमुत्सहे॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001452033, "chapter_id": 21452, "verse_number": "७-१-२५-३४", "content_sanskrit": "ब्रह्मोवाच ।\nएतावता किमर्थेन तीव्रं देवि तपः कृतम् ।\nस्वेच्छैव किमपर्याप्ता क्रीडेयं हि तवेदृशी॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001452034, "chapter_id": 21452, "verse_number": "७-१-२५-३५", "content_sanskrit": "क्रीडा ऽपि च जगन्मातस्तव लोकहिताय वै ।\nअतो ममेष्टमनया फलं किमपि साध्यताम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001452035, "chapter_id": 21452, "verse_number": "७-१-२५-३६", "content_sanskrit": "निशुंभशुंभनामानौ दैत्यौ दत्तवरौ मया ।\nदृप्तौ देवान्प्रबाधेते त्वत्तो लब्धस्तयोर्वधः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001452036, "chapter_id": 21452, "verse_number": "७-१-२५-३७", "content_sanskrit": "अलं विलंबनेनात्र त्वं क्षणेन स्थिरा भव ।\nशक्तिर्विसृज्यमाना ऽद्य तयोर्मृत्युर्भविष्यति॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001452037, "chapter_id": 21452, "verse_number": "७-१-२५-३८", "content_sanskrit": "ब्राह्मणाभ्यर्थिता चैव देवी गिरिवरात्मजा ।\nत्वक्कोशं सहसोत्सृज्य गौरी सा समजायत॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001452038, "chapter_id": 21452, "verse_number": "७-१-२५-३९", "content_sanskrit": "सा त्वक्कोशात्मनोत्सृष्टा कौशिकी नाम नामतः ।\nकाली कालाम्बुदप्रख्या कन्यका समपद्यत॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001452039, "chapter_id": 21452, "verse_number": "७-१-२५-४०", "content_sanskrit": "सा तु मायात्मिका शक्तिर्योगनिद्रा च वैष्णवी ।\nशंखचक्रत्रिशूलादिसायुधाष्टमहाभुजा॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001452040, "chapter_id": 21452, "verse_number": "७-१-२५-४१", "content_sanskrit": "सौम्या घोरा च मिश्रा च त्रिनेत्रा चन्द्रशेखरा ।\nअजातपुंस्पर्शरतिरधृष्या चातिसुन्दरी॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001452041, "chapter_id": 21452, "verse_number": "७-१-२५-४२", "content_sanskrit": "दत्ता च ब्रह्मणे देव्या शक्तिरेषा सनातनी ।\nनिशुंभस्य च शुंभस्य निहंत्री दैत्यसिंहयोः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001452042, "chapter_id": 21452, "verse_number": "७-१-२५-४३", "content_sanskrit": "ब्रह्मणापि प्रहृष्टेन तस्यै परमशक्तये ।\nप्रबलः केसरी दत्तो वाहनत्वे समागतः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001452043, "chapter_id": 21452, "verse_number": "७-१-२५-४४", "content_sanskrit": "विन्ध्ये च वसतिं तस्याः पूजामासवपूर्वकैः ।\nमांसैर्मत्स्यैरपूपैश्च निर्वर्त्यासौ समादिशत्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001452044, "chapter_id": 21452, "verse_number": "७-१-२५-४५", "content_sanskrit": "सा चैव संमता शक्तिर्ब्रह्मणो विश्वकर्मणः ।\nप्रणम्य मातरं गौरीं ब्रह्माणं चानुपूर्वशः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001452045, "chapter_id": 21452, "verse_number": "७-१-२५-४६", "content_sanskrit": "शक्तिभिश्चापि तुल्याभिः स्वात्मजाभिरनेकशः ।\nपरीता प्रययौ विन्ध्यं दैत्येन्द्रौ हन्तुमुद्यता॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001452046, "chapter_id": 21452, "verse_number": "७-१-२५-४७", "content_sanskrit": "निहतौ च तया तत्र समरे दैत्यपुंगवौ ।\nतद्बाणैः कामबाणैश्च च्छिन्नभिन्नांगमानसौ॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001452047, "chapter_id": 21452, "verse_number": "७-१-२५-४८", "content_sanskrit": "तद्युद्धविस्तरश्चात्र न कृतो ऽन्यत्र वर्णनात् ।\nऊहनीयं परस्माच्च प्रस्तुतं वर्णयामि वः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]