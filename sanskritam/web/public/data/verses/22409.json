[{"id": 7002409000, "chapter_id": 22409, "verse_number": "१-७१-१", "content_sanskrit": "ब्रह्मोवाच ।\nनामभिः संस्तुतो देवो यैरर्कः परितुष्यति ।\nतानि ते कीर्तयाम्येष यथावदनुपूर्वशः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002409001, "chapter_id": 22409, "verse_number": "१-७१-२", "content_sanskrit": "नमः सूर्याय नित्याय रवये कार्यभानवे ।\nभास्कराय मतङ्गाय मार्तण्डाय विवस्वते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002409002, "chapter_id": 22409, "verse_number": "१-७१-३", "content_sanskrit": "आदित्यायादिदेवाय नमस्ते रश्मिमालिने ।\nदिवाकराय दीप्ताय अग्नये मिहिराय च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002409003, "chapter_id": 22409, "verse_number": "१-७१-४", "content_sanskrit": "प्रभाकराय मित्राय नमस्तेऽदितिसम्भव ।\nनमो गोपतये नित्यं१ दिशां च पतये नमः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002409004, "chapter_id": 22409, "verse_number": "१-७१-५", "content_sanskrit": "नमो धात्रे विधात्रे च अर्यम्णे वरुणाय च ।\nपूष्णे भगाय मित्राय पर्जन्यायांशवे नमः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002409005, "chapter_id": 22409, "verse_number": "१-७१-६", "content_sanskrit": "नमो हितकृते नित्यं धर्माय तपनाय च ।\nहरये२ हरिताश्वाय विश्वस्य पतये नमः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002409006, "chapter_id": 22409, "verse_number": "१-७१-७", "content_sanskrit": "विष्णवे ब्रह्मणे नित्यं त्र्यम्बकाय तथात्मने ।\nनमस्ते सप्तलोकेश नमस्ते सप्तसप्तये ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002409007, "chapter_id": 22409, "verse_number": "१-७१-८", "content_sanskrit": "एकस्मै हि नमस्तुभ्यमेकचक्ररथाय च ।\nज्योतिषां पतये नित्यं सर्वप्राणभृते नमः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002409008, "chapter_id": 22409, "verse_number": "१-७१-९", "content_sanskrit": "हिताय सर्वभूतानां शिवायार्तिहराय च ।\nनमः पद्मप्रबोधाय नमो वेदादिमूर्तये ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002409009, "chapter_id": 22409, "verse_number": "१-७१-१०", "content_sanskrit": "काधिजाय४ नमस्तुभ्यं नमस्तारासुताय च ।\nभीमजाय नमस्तुभ्यं पावकाय च वै नमः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002409010, "chapter_id": 22409, "verse_number": "१-७१-११", "content_sanskrit": "धिषणाय५ नमोनित्यं नमः कृष्णाय नित्यदा ।\nनमोऽस्त्वदितिपुत्राय नमो लक्ष्याय नित्यशः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002409011, "chapter_id": 22409, "verse_number": "१-७१-१२", "content_sanskrit": "एतान्यादित्यनामानि मया प्रोक्तानि वै पुरा ।\nआराधनाय देवस्य सर्वकामेन सुव्रत ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002409012, "chapter_id": 22409, "verse_number": "१-७१-१३", "content_sanskrit": "सायं प्रातः शुचिर्भूत्वा यः पठेत्सुसमाहितः ।\nस प्राप्नोत्यखिलान्कामान्यथाहं प्राप्तवान्पुरा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002409013, "chapter_id": 22409, "verse_number": "१-७१-१४", "content_sanskrit": "प्रसादात्तस्य देवस्य भास्करस्य महात्मनः ।\nश्रीकामः श्रियमाप्नोति धर्मार्थी धर्ममाप्नुयात् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002409014, "chapter_id": 22409, "verse_number": "१-७१-१५", "content_sanskrit": "आतुरो मुच्यते रोगाद्बद्धो मुच्येत बन्धनात् ।\nराज्यार्थी राज्यमाप्नोति कामार्थी काममाप्नुयात् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002409015, "chapter_id": 22409, "verse_number": "१-७१-१६", "content_sanskrit": "एतज्जप्यं रहस्यं च संध्योपासनमेव च ।\nएतेन जपमात्रेण नरः पापात्प्रमुच्यते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]