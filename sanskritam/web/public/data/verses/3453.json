[{"id": 2113990, "chapter_id": 3453, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2113991, "chapter_id": 3453, "verse_number": "१", "content_sanskrit": "द्रोणस्य तु तदा शिष्यौ गदायुद्धे विशेषतः ।\nदुर्योधनश्च भीमश्च सदा सन्नद्धमानसौ\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2113992, "chapter_id": 3453, "verse_number": "२", "content_sanskrit": "अश्वत्थामा महास्त्रेषु सर्वेष्वभ्यधिकोऽभवत् ।\nयुधिष्ठिरो रथश्रेष्ठः सर्वेषु च धनञ्जयः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2113993, "chapter_id": 3453, "verse_number": "३", "content_sanskrit": "तथाऽति पुरुषानन्यान् यमजावसिचर्मणि ।\nप्रथितः सागरान्तायां रथयूथपयूथपः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2113994, "chapter_id": 3453, "verse_number": "४", "content_sanskrit": "युद्धयोगबलोत्साहैः सर्वास्त्रेषु च निष्ठितः ।\nअस्त्रे गुर्वनुरागे च विशिष्टोऽभवदर्जुनः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2113995, "chapter_id": 3453, "verse_number": "५", "content_sanskrit": "तुल्येष्वस्त्रोपदेशेषु सौष्ठवेषु च वीर्यवान् ।\nएकः सर्वकुमाराणां स बभूवार्जुनोऽधिकः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2113996, "chapter_id": 3453, "verse_number": "६", "content_sanskrit": "प्राणाधिकं भीमसेनं कृतविद्यं धनञ्जयम् ।\nधार्तराष्ट्रा दुरात्मनो नामृष्यन्त परन्तप \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2113997, "chapter_id": 3453, "verse_number": "७", "content_sanskrit": "तांस्तु सर्वान् समानीय सर्वविद्यासु निष्ठितान् ।\nद्रोणः प्रहरणज्ञाने जिज्ञासुः पुरुषर्षभान् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2113998, "chapter_id": 3453, "verse_number": "८", "content_sanskrit": "कृत्रिमं भासमारोप्य वृक्षाग्रे शिल्पिभिः कृतम् ।\nअविज्ञातं कुमाराणां लक्ष्यभूतमुपादिशत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2113999, "chapter_id": 3453, "verse_number": "", "content_sanskrit": "द्रोणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2114000, "chapter_id": 3453, "verse_number": "९", "content_sanskrit": "शीघ्रं भवन्तः सर्वे वै धनूंष्यादाय सत्वराः ।\nभासमेतं समुद्दिश्य तिष्ठन्तु सहितेषवः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2114001, "chapter_id": 3453, "verse_number": "१०", "content_sanskrit": "मद्वाक्यसमकालं च शिरोऽस्य विनिकृत्यताम् ।\nएकैकशो नियोक्ष्यामि तथा कुरुत पुत्रकाः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2114002, "chapter_id": 3453, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2114003, "chapter_id": 3453, "verse_number": "११", "content_sanskrit": "ततो युधिष्ठिरं पूर्वमुवाचाङ्गिरसां वरः ।\nसन्धत्स्व बाणं दुर्धर्ष मद्वाक्यान्ते विमुच्यताम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2114004, "chapter_id": 3453, "verse_number": "१२", "content_sanskrit": "ततो युधिष्ठिरः पूर्वं धनुर्गृह्य महारवम् ।\nतस्थौ भासं समुद्दिश्य गुरुवाक्यप्रचोदितः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2114005, "chapter_id": 3453, "verse_number": "१३", "content_sanskrit": "ततो विततधन्वानं द्रोणस्तं कुरुनन्दनम् ।\nस मुहूर्तादुवाचेदं वचनं भरतर्षभ\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2114006, "chapter_id": 3453, "verse_number": "१४", "content_sanskrit": "पश्यस्येतं द्रुमाग्रस्थं भासं सुरवरात्मज ।\nपश्यामीत्येव चाचार्यं प्रत्युवाच युधिष्ठिरः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2114007, "chapter_id": 3453, "verse_number": "१५", "content_sanskrit": "स मुहूर्तादिव पुनर्द्रोणस्तं प्रत्यभाषत ।\nपार्थ वृक्षमिमं मां च भ्रातॄन् वाऽपि प्रपश्यसि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2114008, "chapter_id": 3453, "verse_number": "१६", "content_sanskrit": "तमुवाच च कौन्तेयः पश्याम्येनं वनस्पतिम् ।\nभवन्तं च तथा भ्रातॄन् भासं चेति पुनःपुनः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2114009, "chapter_id": 3453, "verse_number": "१७", "content_sanskrit": "तमुवाचापसर्पेति द्रोणोऽप्रीतमना इव ।\nनैतच्छक्यं त्वया वेद्धुं लक्ष्यमित्येव कुत्सयन् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2114010, "chapter_id": 3453, "verse_number": "१८", "content_sanskrit": "ततो दुर्योधनादींस्तान् धार्तराष्ट्रान् महाबलान् ।\nतेनैव क्रमयोगेन जिज्ञासुः पर्यपृच्छत\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2114011, "chapter_id": 3453, "verse_number": "१९", "content_sanskrit": "अन्यांश्च शिष्यान् भीमादीन् राज्ञश्चैवान्यदेशजान् ।\nतथैव सर्वे सर्वं तत् पश्याम इति कुत्सिताः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2114012, "chapter_id": 3453, "verse_number": "२०", "content_sanskrit": "ततो धनञ्जयं द्रोणः स्मयमानोऽभ्यभाषत ।\nत्वयेदानीं प्रहर्तव्यं लक्ष्यमेतन्निपात्यताम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2114013, "chapter_id": 3453, "verse_number": "२१", "content_sanskrit": "मद्वाक्यसमकालं ते मोक्तव्यश्च भवेच्छरः ।\nविकृष्य कार्मुकं त्वत्र तिष्ठ तावन्मुहूर्तकम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2114014, "chapter_id": 3453, "verse_number": "२२", "content_sanskrit": "एवमुक्त्वा सव्यसाची मण्डलीकृतकार्मुकः ।\nतस्थौ भासं समुद्दिश्य गुरुवाक्यसमाहितः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2114015, "chapter_id": 3453, "verse_number": "२३", "content_sanskrit": "मुहूर्तादेव तं द्रोणः तथैव समभाषत ।\nपश्यस्येतं स्थितं भासं द्रुमं मामपि चेत्युत \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2114016, "chapter_id": 3453, "verse_number": "२४", "content_sanskrit": "पश्याम्येकं भासमेवाहमिति तं प्रत्यभाषत ।\nनतु वृक्षं भवन्तं वा पश्यामीति च भारत\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2114017, "chapter_id": 3453, "verse_number": "२५", "content_sanskrit": "ततः प्रीतमना द्रोणो मूहूर्तादिव तं पुनः ।\nप्रत्यभाषत दुर्धर्षं पाण्डवानां रथर्षभम् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2114018, "chapter_id": 3453, "verse_number": "२६", "content_sanskrit": "भासं पश्यसि यद्येनं तथा ब्रूहि पुनर्वचः ।\nशिरः पश्यामि भासस्य न गात्रमिति सोऽब्रवीत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2114019, "chapter_id": 3453, "verse_number": "२७", "content_sanskrit": "अर्जुनेनैवमुक्तस्तु द्रोणो हृष्टतनूरुहः ।\nमुञ्चस्वेत्यब्रवीत् पार्थं स मुमोचाविचारयन् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2114020, "chapter_id": 3453, "verse_number": "२८", "content_sanskrit": "ततस्तस्य नगस्थस्य क्षुरेण निशितेन सः ।\nशिर उत्कृत्य तरसा पातयामास पाण्डवः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2114021, "chapter_id": 3453, "verse_number": "२९", "content_sanskrit": "तस्मिन् कर्मणि संसिद्धे परिष्वज्य च पाण्डवम् ।\nमेने च द्रुपदं सङ्खे सानुबन्धं पराजितम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2114022, "chapter_id": 3453, "verse_number": "३०", "content_sanskrit": "कस्यचित्त्वथ कालस्य सशिष्योऽङ्गिरसां वरः ।\nजगाम गङ्गामभितो मज्जितुं भरतर्षभ\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2114023, "chapter_id": 3453, "verse_number": "३१", "content_sanskrit": "अवगाढमथो द्रोणं सलिले सलिलेचरः ।\nग्राहो जग्राह बलवान् जङ्घान्ते कालचोदितः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2114024, "chapter_id": 3453, "verse_number": "३२", "content_sanskrit": "स समर्थोऽपि मोक्षाय शिष्यान् सर्वानचोदयत् ।\nग्राहं हत्वा मोक्षयध्वं मामिति त्वरयन्निव\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2114025, "chapter_id": 3453, "verse_number": "३३", "content_sanskrit": "तद्वाक्यसमकालं तु बीभत्सुर्निशितैः शरैः ।\nअवाग्रैर्दशभिर्बाणैः मग्नमम्भस्यताडयत्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2114026, "chapter_id": 3453, "verse_number": "३४", "content_sanskrit": "इतरे तु विसम्मूढाः तत्र तत्र प्रपेदिरे ।\nतं च दृष्ट्वा क्रियोपेतं द्रोणोऽमन्यत पाण्डवम् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2114027, "chapter_id": 3453, "verse_number": "३५", "content_sanskrit": "विशिष्टं सर्वशिष्येभ्यः प्रीतिमांश्चाभवत् तदा ।\nस पार्थबाणैर्बहुधा खण्डशः परिकल्पितः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2114028, "chapter_id": 3453, "verse_number": "३६", "content_sanskrit": "ग्राहः पञ्चत्वमापेदे जङ्घां त्यक्त्वा महात्मनः ।\nगृहाणेदं महाबाहो विशिष्टमतिदुर्धरम् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2114029, "chapter_id": 3453, "verse_number": "३७", "content_sanskrit": "अस्त्रं ब्रह्मशिरो वीर सप्रयोगनिवर्तनम् ।\nन च ते मानुषेष्वेतत् प्रयोक्तव्यं कथंचन \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2114030, "chapter_id": 3453, "verse_number": "३८", "content_sanskrit": "जगद्धि निर्दहेदेतदल्पतेजसि पातितम् ।\nअसामान्यमिदं तात लोकेष्वस्त्रं निगद्यते \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2114031, "chapter_id": 3453, "verse_number": "३९", "content_sanskrit": "तद् धारयेथाः प्रयतः शृणु चेदं वचो मम ।\nबाधतेऽमानुषः कश्चिद् यदा त्वां वीर कश्चन \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2114032, "chapter_id": 3453, "verse_number": "४०", "content_sanskrit": "तद्वधाय प्रयुञ्जीथास्तदस्त्रमिदमाहवे ।\nतत्तथेति प्रतिश्रुत्य बीभत्सुः प्रकृताञ्जलिः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2114033, "chapter_id": 3453, "verse_number": "४१", "content_sanskrit": "जग्राह परमास्त्रं तद् आह चैनं पुनर्गुरुः ।\nभविता त्वत्समो नान्यः पुमाँल्लोके धनुर्धरः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2114034, "chapter_id": 3453, "verse_number": "१३२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nद्वात्रिंशत्यधिकशततमोऽध्यायः ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2114035, "chapter_id": 3453, "verse_number": "८०", "content_sanskrit": "॥ इति सम्भवपर्वणि अशीतितमोऽध्यायः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2114036, "chapter_id": 3453, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]