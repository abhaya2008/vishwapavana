[{"id": 900000868, "chapter_id": 8191, "verse_number": "2.1", "content_sanskrit": "नित्यानित्यजगद्धात्रे नित्याय ज्ञानमूर्तये । पूर्णानन्दाय हरये सर्वयज्ञभुजे नमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900000869, "chapter_id": 8191, "verse_number": "2.2", "content_sanskrit": "“स्वायम्भुवः स्वदौहित्रं विष्णुं यज्ञाभिधं मनुः ईशावास्यादिभिर्मन्त्रैस्तुष्टावावहितात्मना", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900000870, "chapter_id": 8191, "verse_number": "2.3", "content_sanskrit": "ईशस्य (आ) वासयोग्यं, “ईशावास्यम्”", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900000871, "chapter_id": 8191, "verse_number": "2.4", "content_sanskrit": "'अकुर्वतः कर्म न लिप्यत इति नास्ति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900000872, "chapter_id": 8191, "verse_number": "2.5", "content_sanskrit": "सुष्ठु रमणविरुद्धत्वाद्, असुराणां प्राप्यत्वाच्च “असुर्या :", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900000873, "chapter_id": 8191, "verse_number": "2.6", "content_sanskrit": "“अनेजन्निर्भयत्वात् तदेकं प्राधान्यतस्तथा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900000874, "chapter_id": 8191, "verse_number": "2.7", "content_sanskrit": "“तदेजति”, तत (एव) एजत्यन्यत् । तत् स्वयं नेजति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900000875, "chapter_id": 8191, "verse_number": "2.8", "content_sanskrit": "“सर्वगं परमात्मानं सर्वं च परमात्मनि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900000876, "chapter_id": 8191, "verse_number": "2.9", "content_sanskrit": "“यस्मिन्” परमात्मनि सर्वभूतानि स परमात्मैव तत्र सर्वभूतेष्वभूत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900000877, "chapter_id": 8191, "verse_number": "2.10", "content_sanskrit": "“शुक्रं तच्छोकराहित्यादव्रणं (अब्रणं) नित्यपूर्णतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900000878, "chapter_id": 8191, "verse_number": "2.11", "content_sanskrit": "अन्यथोपासका ये तु तमोऽन्धं यान्त्यसंशयम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900000879, "chapter_id": 8191, "verse_number": "2.12", "content_sanskrit": "अ॒न्यदेवाहुर्विद्ययाऽन्यदाहुरविद्यया", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900000880, "chapter_id": 8191, "verse_number": "2.13", "content_sanskrit": "ये विदुः सह (ते हि ) सज्जनाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900000881, "chapter_id": 8191, "verse_number": "2.14", "content_sanskrit": ".....एव ( एवं) सृष्टिकर्तृत्वं नाङ्गीकुर्वन्ति ये हरेः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900000882, "chapter_id": 8191, "verse_number": "2.15", "content_sanskrit": "अन्यदेवाहुः सम्भवादन्यदाहुरसम्भवात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900000883, "chapter_id": 8191, "verse_number": "2.16", "content_sanskrit": "“यो वेद संहृतिज्ञानाद् देहबन्धाद् विमुच्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900000884, "chapter_id": 8191, "verse_number": "2.17", "content_sanskrit": "पात्रं हिरण्मयं सूर्यमण्डलं समुदाहृतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900000885, "chapter_id": 8191, "verse_number": "2.18", "content_sanskrit": "....प्रधानज्ञानरूपतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900000886, "chapter_id": 8191, "verse_number": "2.19", "content_sanskrit": "....अहं चासावहेयतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900000887, "chapter_id": 8191, "verse_number": "2.20", "content_sanskrit": "यस्मिन् प्राणे ( यस्मिन्नयम् ) स्थितः सोऽप्यमृतः । किमु परः ?", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900000888, "chapter_id": 8191, "verse_number": "2.21", "content_sanskrit": "भक्तानां स्मरणं विष्णोर्नित्यज्ञप्तिस्वरूपतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900000889, "chapter_id": 8191, "verse_number": "2.22", "content_sanskrit": "व॒युनं ज्ञानम् । “त्वद् (यद्) दत्तया वयुनयेदमचष्ट विश्वम्\"", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900000890, "chapter_id": 8191, "verse_number": "2.23", "content_sanskrit": "पूर्णशक्तिचिदानन्दश्रीतेजः स्पष्टमूर्तये । ममात्यधिकमित्राय (ममाभ्यधिकमित्राय) नमो नारायणाय ते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]