[{"id": 2145314, "chapter_id": 4129, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2145315, "chapter_id": 4129, "verse_number": "१", "content_sanskrit": "क्षत्रतेजा ब्रह्मचारी कौमारादपि पाण्डवः ।\nतेन संयुगमेष्यन्ति मन्दा विलपतो मम\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2145316, "chapter_id": 4129, "verse_number": "२", "content_sanskrit": "दुर्योधन निवर्तस्व युद्धाद् भरतसत्तम ।\nन हि युद्धं प्रशंसन्ति सर्वावस्थास्वरिन्दम\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2145317, "chapter_id": 4129, "verse_number": "३", "content_sanskrit": "अलमर्धं पृथिव्यास्ते सहामात्यस्य जीवितुम् ।\nप्रयच्छ पाण्डुपुत्राणां यथोचितमरिन्दम\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2145318, "chapter_id": 4129, "verse_number": "४", "content_sanskrit": "एतद्धि कुरवः सर्वे मन्यन्ते धर्मसंहितम् ।\nयत् त्वं प्रशान्तिमिच्छेथाः पाण्डुपुत्रैर्महात्मभिः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2145319, "chapter_id": 4129, "verse_number": "५", "content_sanskrit": "अङ्गेमां समवेक्षस्व पुत्र स्वामेव वाहिनीम् ।\nजात एव तवाभावस्त्वं तु मोहान्न बुद्ध्यसे\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2145320, "chapter_id": 4129, "verse_number": "६", "content_sanskrit": "न ह्यहं योद्धुमिच्छामि नैतदिच्छन्ति बाह्लिकः ।\nन च भीष्मो न च द्रोणो नाश्वत्थामा न सञ्जयः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2145321, "chapter_id": 4129, "verse_number": "७", "content_sanskrit": "न सोमदत्तो न कृपो न शल्यो युद्धमिच्छति\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2145322, "chapter_id": 4129, "verse_number": "८", "content_sanskrit": "सत्यव्रतः पुरुमित्रो जयो भूरिश्रवास्तथा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2145323, "chapter_id": 4129, "verse_number": "९", "content_sanskrit": "तत् त्वं प्रशान्तिमिच्छेथाः पाण्डुपुत्रैर्महात्मभिः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2145324, "chapter_id": 4129, "verse_number": "१०", "content_sanskrit": "ये तु सम्प्रति तिष्ठेयुः कुरवः पीडिता परैः ।\nते युद्धं नाभिनन्दन्ति तत् तुभ्यं तात रोचताम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2145325, "chapter_id": 4129, "verse_number": "११", "content_sanskrit": "न त्वं करोषि कामेन कर्णः कारयिता तव ।\nदुःशासनश्च पापात्मा शकुनिश्चापि सौबलः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2145326, "chapter_id": 4129, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2145327, "chapter_id": 4129, "verse_number": "१२", "content_sanskrit": "नाहं भवति न द्रोणे नाश्वत्थाम्नि न सञ्जये ।\nन भीष्मे न च काम्भोजे न कृपे न च बाह्लिके\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2145328, "chapter_id": 4129, "verse_number": "१३", "content_sanskrit": "सत्यव्रते पुरुमित्रे भूरिश्रवसि वा पुनः ।\nअन्येषु वा तावकेषु भारं कृत्वा समाह्वये\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2145329, "chapter_id": 4129, "verse_number": "१४", "content_sanskrit": "अहं च तात कर्णश्च रणयज्ञं वितत्य वै ।\nयुधिष्ठिरं पशुं कृत्वा दीक्षितौ भरतर्षभ\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2145330, "chapter_id": 4129, "verse_number": "१५", "content_sanskrit": "रथो वेदिः स्रुवः खड्गो गदा स्रुक् कवचोऽजिनम् ।\nचातुर्होत्रं च धुर्या मे शरा दर्भा हविर्यशः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2145331, "chapter_id": 4129, "verse_number": "१६", "content_sanskrit": "आत्मयज्ञेन नृपते इष्ट्वा वैवस्वतं रणे ।\nविजित्य च समेष्यावो हतामित्रौ श्रिया वृतौ\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2145332, "chapter_id": 4129, "verse_number": "१७", "content_sanskrit": "अहं च तात कर्णश्च भ्राता दुःशासनश्च मे ।\nएते वयं हनिष्यामः पाण्डवान् समरे त्रयः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2145333, "chapter_id": 4129, "verse_number": "१८", "content_sanskrit": "अहं हि पाण्डवान् हत्वा प्रशास्ता पृथिवीमिमाम् ।\nमां हत्वा पाण्डुपुत्रा वा भोक्तारः पृथिवीमिमाम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2145334, "chapter_id": 4129, "verse_number": "१९", "content_sanskrit": "त्यक्तं मे जीवितं राज्यं धनं सर्वं च पार्थिव ।\nन जातु पाण्डवैः सार्धं भुञ्जीयां पृथिवीमिमाम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2145335, "chapter_id": 4129, "verse_number": "२०", "content_sanskrit": "यावद्धि सूच्यास्तीक्ष्णाया विध्येदग्रेण भारत ।\nतावदप्यपरित्याज्यं भूमेर्नः पाण्डवान् प्रति\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2145336, "chapter_id": 4129, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2145337, "chapter_id": 4129, "verse_number": "२१", "content_sanskrit": "सर्वान् वस्तात शोचामि त्यक्तो दुर्योधनो मया ।\nये मन्दमनुयास्यध्वं यान्तं वैवस्वतक्षयम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2145338, "chapter_id": 4129, "verse_number": "२२", "content_sanskrit": "मृगाणामिव यूथेषु व्याघ्राः प्रहरतां वराः ।\nवरान् वरान् हनिष्यन्ति समेता युधि पाण्डवाः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2145339, "chapter_id": 4129, "verse_number": "२३", "content_sanskrit": "प्रतीपमेति मे सेना युयुधानेन भारती ।\nव्यस्ता सीमन्तिनी ग्रस्ता प्रमृष्टा दीर्घबाहुना\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2145340, "chapter_id": 4129, "verse_number": "२४", "content_sanskrit": "सम्पूर्णं पूरयन् भूयो बलं पार्थस्य माधवः ।\nशैनेयः समरे स्थाता बीजवत् प्रवपन् शरान्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2145341, "chapter_id": 4129, "verse_number": "२५", "content_sanskrit": "सेनामुखे प्रबुद्धानां भीमसेनो भविष्यति ।\nतं सर्वे संश्रयिष्यन्ति प्राकारमकुतोभयाः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2145342, "chapter_id": 4129, "verse_number": "२६", "content_sanskrit": "यदा द्रक्ष्यसि भीमेन कुञ्जरान् विनिपातितान् ।\nविशीर्णदन्तान् विक्रुष्टान् भिन्नकुम्भान् सशोणितान्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2145343, "chapter_id": 4129, "verse_number": "२७", "content_sanskrit": "तानभिप्रेक्ष्य सङ्ग्रामे विशीर्णानिव पर्वतान् ।\nभीतो भीमस्य संस्पर्शात् स्मर्तासि वचनस्य मे\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2145344, "chapter_id": 4129, "verse_number": "२८", "content_sanskrit": "निर्दग्धं भीमसेनेन सैन्यं हतरथद्विपम् ।\nगतिमग्नेरिव प्रेक्ष्य स्मर्तासि वचनं मम\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2145345, "chapter_id": 4129, "verse_number": "२९", "content_sanskrit": "महन्नो भयमागामि न चेच्छामीह पाण्डवैः ।\nगदया भीमसेनेन हतान् शममुपैष्यथ\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2145346, "chapter_id": 4129, "verse_number": "३०", "content_sanskrit": "महावनमिव च्छिन्नं यदा द्रक्ष्यसि पातितम् ।\nबलं कुरूणां भीमेन तदा स्मर्तासि मे वचः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2145347, "chapter_id": 4129, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2145348, "chapter_id": 4129, "verse_number": "३१", "content_sanskrit": "एतावदुक्त्वा राजा तु सर्वांस्तान् पृथिवीपतीन् ।\nअनुभाष्य महाराज पुनः पप्रच्छ सञ्जयम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2145349, "chapter_id": 4129, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nउद्योगपर्वणि षष्टितमोऽध्यायः ॥६०॥\nव्यासाभिगमनपर्वणि त्रयोदशोऽध्यायः ॥१३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]