[{"id": 2197437, "chapter_id": 5197, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2197438, "chapter_id": 5197, "verse_number": "१", "content_sanskrit": "श्रुतं वर्णावरे दत्तं हव्यं कव्यं च नारद ।\nसम्प्रयोगे च पुत्राणां कन्यानां च ब्रवीहि मे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2197439, "chapter_id": 5197, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2197440, "chapter_id": 5197, "verse_number": "२", "content_sanskrit": "कन्याप्रदानं पुत्राणां स्त्रीणां संयोगमेव च ।\nआनुपूर्व्यान्मया सम्यगुच्यमानं निबोध मे\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2197441, "chapter_id": 5197, "verse_number": "३", "content_sanskrit": "जातमात्रा तु दातव्या कन्यका सदृशे वरे ।\nकाले दत्तासु कन्यासु पिता धर्मेण युज्यते\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2197442, "chapter_id": 5197, "verse_number": "४", "content_sanskrit": "यस्तु पुष्पवतीं कन्यां बान्धवो न प्रयच्छति ।\nमासिमासि गते बन्धुस्तस्या भ्रौणघ्नमाप्नुते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2197443, "chapter_id": 5197, "verse_number": "५", "content_sanskrit": "यस्तु कन्यां गृहे रुन्ध्याद् ग्राम्यैर्भोगैर्विवर्जिताम् ।\nअवध्यातः स कन्याया बन्धुः प्राप्नोति भ्रूणहाम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2197444, "chapter_id": 5197, "verse_number": "६", "content_sanskrit": "दूषिता पाणिमात्रेण मृते भर्तरि दारिका ।\nसंस्कारं लभते नारी द्वितीये सा पुनः पतौ\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2197445, "chapter_id": 5197, "verse_number": "७", "content_sanskrit": "पुनर्भूर्नाम सा कन्या सपुत्रा हव्यकव्यदा ।\nअदूष्या सा प्रसूतीषु प्रजानां दारकर्मणि\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2197446, "chapter_id": 5197, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2197447, "chapter_id": 5197, "verse_number": "८", "content_sanskrit": "या तु कन्या प्रसूयेत गर्भिणी या तु वा भवेत् ।\nकथं दारक्रियां भूयः सा भवेदृषिसत्तम\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2197448, "chapter_id": 5197, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2197449, "chapter_id": 5197, "verse_number": "९", "content_sanskrit": "तत्वार्थनिश्चितं शब्दं कन्यका नयतेऽग्नये ।\nतस्मात् कुर्वन्ति वै भावं कुमार्यस्ता न कन्यकाः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2197450, "chapter_id": 5197, "verse_number": "१०", "content_sanskrit": "ब्रह्महत्यात्रिभागेन गर्भाधानविशोधिताम् ।\nगृह्णीयात् तां चतुर्भागं विशुद्धां सर्जनात् पुनः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2197451, "chapter_id": 5197, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2197452, "chapter_id": 5197, "verse_number": "११", "content_sanskrit": "कथं कन्यासु ये जाता बन्धूनां दूषिताः सदा ।\nकस्य ते हव्यकव्यानि प्रदास्यन्ति महामुने\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2197453, "chapter_id": 5197, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2197454, "chapter_id": 5197, "verse_number": "१२", "content_sanskrit": "कन्यायास्तु पितुः पुत्राः कानीना हव्यकव्यदाः ।\nअन्तर्वत्न्यास्तु यः पाणिं गृह्णीयात् स सहोढजः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2197455, "chapter_id": 5197, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2197456, "chapter_id": 5197, "verse_number": "१३", "content_sanskrit": "अथ येनाहितो गर्भः कन्यायां तत्र नारद ।\nकथं पुत्रफलं तस्य भवेदेतत् प्रचक्ष्व मे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2197457, "chapter_id": 5197, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2197458, "chapter_id": 5197, "verse_number": "१४", "content_sanskrit": "धर्माचारेषु ते नित्यं दूषकाः कृतशोधनाः ।\nबीजं न नश्यते तेषां मोघचेष्टा भवन्ति ते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2197459, "chapter_id": 5197, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2197460, "chapter_id": 5197, "verse_number": "१५", "content_sanskrit": "अथ काचिद् भवेत्कन्या क्रीता दत्ता हृताऽपि वा ।\nकथं पुत्रकृतं तस्यास्तद् भवेदृषिसत्तम\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2197461, "chapter_id": 5197, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2197462, "chapter_id": 5197, "verse_number": "१६", "content_sanskrit": "क्रीता दत्ता हृता चैव या कन्या पाणिवर्जिता ।\nकौमारी नाम सा भार्या प्रसवेदौरसान् सुतान् ।\nन पत्न्यर्थे शुभा प्रोक्ता तत्कर्मण्यपराजिते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2197463, "chapter_id": 5197, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2197464, "chapter_id": 5197, "verse_number": "१७", "content_sanskrit": "केन मङ्गलकृत्येषु विनियुज्यन्ति कन्यकाः ।\nएतदिच्छामि विज्ञातुं तत्त्वेनेह महामुने\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2197465, "chapter_id": 5197, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2197466, "chapter_id": 5197, "verse_number": "१८", "content_sanskrit": "नित्यं निवसते लक्ष्मीः कन्यकासु प्रतिष्ठिता ।\nशोभना शुभयोग्या च पूज्या मङ्गलकर्मसु\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2197467, "chapter_id": 5197, "verse_number": "१९", "content_sanskrit": "आकरस्थं यथा रत्नं सर्वकामफलोपगम् ।\nतथा कन्या महालक्ष्मीः सर्वलोकस्य मङ्गलम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2197468, "chapter_id": 5197, "verse_number": "२०", "content_sanskrit": "एवं कन्या परा लक्ष्मी रतिस्तोषश्च देहिनाम् ।\nमहाकुलानां चारित्रवृत्तेन निकषोपलम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2197469, "chapter_id": 5197, "verse_number": "२१", "content_sanskrit": "आनयित्वा स्वकाद् वर्णात् कन्यकां यो भजेन्नरः ।\nदातारं हव्यकव्यानां पुत्रकं या प्रसूयति\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2197470, "chapter_id": 5197, "verse_number": "२२", "content_sanskrit": "साध्वी कुलं वर्धयति साध्वी पुष्टिग्रहे परा ।\nसाध्वी लक्ष्मी रतिः साक्षात् प्रतिष्ठा शाश्वतीः समाः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2197471, "chapter_id": 5197, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे नारदमार्कण्डेयसंवादे कन्याप्रशंसा नाम अष्टचत्वारिंशोऽध्यायः ॥४८॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]