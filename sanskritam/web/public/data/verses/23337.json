[{"id": 7003337000, "chapter_id": 23337, "verse_number": "२-३२-१", "content_sanskrit": "सनत्कुमार उवाच  ।\nजपहोमार्चनादानाभिषेकाद्यं च पूर्ववत् ।\nसुवर्णमेदिनीदानं प्रवक्ष्यामि समासतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003337001, "chapter_id": 23337, "verse_number": "२-३२-२", "content_sanskrit": "पूर्वोक्तदेशकाले तु कारयेन्मुनिभिः सह ।\nलक्षणेन यथापूर्वं कुंडे वा मंडलेऽथ वा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003337002, "chapter_id": 23337, "verse_number": "२-३२-३", "content_sanskrit": "मेदिनीं कारयेद्दिव्यां सहस्रेणापि वा पुनः ।\nएकहस्ता प्रकर्तव्या चतुरस्रा सुशोभना ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003337003, "chapter_id": 23337, "verse_number": "२-३२-४", "content_sanskrit": "सप्तद्वीपसमुद्राद्यैः पर्वतैरभिसंवृता ।\nसर्वतीर्थसमोपेता मध्ये मेरुसमन्विता ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003337004, "chapter_id": 23337, "verse_number": "२-३२-५", "content_sanskrit": "अथवा मध्यतो द्वीपं नवखंडं प्रकल्पयेत् ।\nपूर्ववन्निखिलं कृत्वा मंडले वेदिमध्यतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003337005, "chapter_id": 23337, "verse_number": "२-३२-६", "content_sanskrit": "सप्तभागैकभागेन सहस्राद्विधिपूर्वकम् ।\nशिवभक्ते प्रदातव्या दक्षिणा पूर्वचोदिता ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003337006, "chapter_id": 23337, "verse_number": "२-३२-७", "content_sanskrit": "सहस्रकलशाद्यैश्च शंकरं पूजयेच्छिवम् ।\nसुवर्णमेदिनीप्रोक्तं लिंगस्मिन्दानमुत्तमम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}]