[{"id": 7002601000, "chapter_id": 22601, "verse_number": "४-६-१", "content_sanskrit": "सूत उवाच ।\nक्षुद्रारामप्रतिष्ठां च वक्ष्ये च द्विजसत्तम ।\nअमंडले शुभे स्थाने द्विहस्तम यस्थंडिले ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002601001, "chapter_id": 22601, "verse_number": "४-६-२", "content_sanskrit": "स्थापयेत्कलशं तत्र सोमं विष्णुं समर्चयेत् ।\nआचार्यमात्रं वरयेन्निशासूत्रैः प्रवेष्टयेत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002601002, "chapter_id": 22601, "verse_number": "४-६-३", "content_sanskrit": "वृक्षान्माल्यैरलंकृत्य भूषयेद्भूषणादिना ।\nदोहदं च ततो दद्यात्स्थापयेच्छितधारया ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002601003, "chapter_id": 22601, "verse_number": "४-६-४", "content_sanskrit": "भोजयेत्पंचविप्रांश्च पुरतोंऽते विशेषतः ।\nकर्णवेधं ततः कृत्वा उत्सृजेद्वास्यपूर्वकम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002601004, "chapter_id": 22601, "verse_number": "४-६-५", "content_sanskrit": "दद्याद्यूपं मध्यदेशे रोपयेत्कदलीं ततः ।\nरंभां च रोपयेद्दिक्षु स्थालीपाकविधानतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002601005, "chapter_id": 22601, "verse_number": "४-६-६", "content_sanskrit": "अष्टावष्टौ च जुहुयादन्येषां च घृतेन तु ।\nएकैकामाहुतिं दद्यात्स्विष्टकृत्तदनंतरम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002601006, "chapter_id": 22601, "verse_number": "४-६-७", "content_sanskrit": "दक्षिणां च ततो दद्यात्पूर्णां दद्याद्गृहं व्रजेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}]