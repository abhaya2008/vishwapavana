[{"id": 2062229, "chapter_id": 2326, "verse_number": "८-४७-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2062230, "chapter_id": 2326, "verse_number": "८-४७-१", "content_sanskrit": "क्षत्रियास्ते महाराज परस्परवधैषिणः।\nअन्योन्यं समरे जघ्नुः कृतवैरा महौजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2062231, "chapter_id": 2326, "verse_number": "८-४७-२", "content_sanskrit": "रथौघाश्च हयौघाश्च नरौघाश्च समन्ततः।\nगजौघाश्च महाराज संसक्ताश्च परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2062232, "chapter_id": 2326, "verse_number": "८-४७-३", "content_sanskrit": "गदानां परिघाणां च शक्तीनां च परस्परम्।\nप्रासानां भिण्डिपालानां मुसुण्ठीनां च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2062233, "chapter_id": 2326, "verse_number": "८-४७-४", "content_sanskrit": "सम्पातं चानुपश्याम सङ्ग्रामे भृशदारुणे।\nशलभा इव सम्पेतुः शरवृष्ट्यः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2062234, "chapter_id": 2326, "verse_number": "८-४७-५", "content_sanskrit": "नागान्नागाः समासाद्य व्यधमन्त परस्परम्।\nहया हयांश्च समरे रथिनो रथिनस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2062235, "chapter_id": 2326, "verse_number": "८-४७-६", "content_sanskrit": "पत्तयः पत्तिसङ्घांश्च हयसङ्घांश्च पत्तयः।\nपत्तयो रथमातङ्गान्रथा हस्त्यश्वमेव च।\nनागाश्च समरे त्र्यङ्गं ममृदुः शीघ्रगा नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2062236, "chapter_id": 2326, "verse_number": "८-४७-७", "content_sanskrit": "वध्यतां तत्र शूराणां क्रोशतां च परस्परम्।\nघोरमायोधनं जज्ञे पशूनां घातने यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2062237, "chapter_id": 2326, "verse_number": "८-४७-८", "content_sanskrit": "रुधिरेण समास्तीर्णा बभौ भारत मेदिनी।\nशक्रगोपगणाकीर्णा प्रावृषीव वसुन्धरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2062238, "chapter_id": 2326, "verse_number": "८-४७-९", "content_sanskrit": "यथा वा वाससी शुक्ले महारजनरञ्जिते।\nबिभ्रती युवती श्यामा तद्वदासीद्वसुन्धरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2062239, "chapter_id": 2326, "verse_number": "८-४७-१०", "content_sanskrit": "`बद्वचूडामणिधरैः शिरोभिश्चारुकुण्डलैः।\nउज्झितैर्वृषभाक्षाणां भ्राजते स्म वसुन्धरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2062240, "chapter_id": 2326, "verse_number": "८-४७-११", "content_sanskrit": "शशशोणितदिग्धेव शातकुम्भमयीव च।\n`भूर्बभौ भरतश्रेष्ठ शान्तार्चिर्भिरिवानलैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2062241, "chapter_id": 2326, "verse_number": "८-४७-१२", "content_sanskrit": "छिन्नानां चोत्तमाङ्गानां बाहूनां चोरुभिः सह।\nकुण्डलानां पिनद्धानां भूषणानां च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2062242, "chapter_id": 2326, "verse_number": "८-४७-१३", "content_sanskrit": "निष्काणां हेमसूत्राणां शरीराणां च धन्विनाम्।\nचर्मणां सपताकानां सङ्घास्तत्रापतन्भुवि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2062243, "chapter_id": 2326, "verse_number": "८-४७-१४", "content_sanskrit": "`अगम्यकल्पा पृथिवी सर्वतो भृशकर्दमा॥\nगजा गजान्समासाद्य विषाणैरार्दयन्नृप।\nविषाणाग्रहतास्तत्र भ्राजन्ते द्विरदोत्तमाः।\nरुधिरेणावसिक्ताङ्गा गैरिकप्रस्रवा इव।\n`प्रावृट्काले महाराज मेघा इव सविद्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2062244, "chapter_id": 2326, "verse_number": "८-४७-१५", "content_sanskrit": "स्यन्दमाना यथा भान्ति पर्वता धातुमण्डिताः।\n`तथा रेजू रणे नागा रुधिरेण समाप्लुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2062245, "chapter_id": 2326, "verse_number": "८-४७-१६", "content_sanskrit": "तोमरान्सादिभिर्मुक्तान्प्रतिमानस्थितान्बहून्।\nहस्तैरुद्धृत्य तान्नागा बभञ्जुश्चापरे रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2062246, "chapter_id": 2326, "verse_number": "८-४७-१७", "content_sanskrit": "नाराचैश्छिन्नवर्माणो भ्राजन्ते स्म गजोत्तमाः।\nहिमागमे यथा राजन्व्यभ्रा इव महीधराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2062247, "chapter_id": 2326, "verse_number": "८-४७-१८", "content_sanskrit": "शरैः कनकपुङ्खैश्च चिता रेर्जुर्गजोत्तमाः।\nउल्काभिः सम्प्रदीप्ताग्राः पर्वता इव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2062248, "chapter_id": 2326, "verse_number": "८-४७-१९", "content_sanskrit": "केचिदभ्याहता नागैर्नागा नगवरोपमाः।\nन चेलुः समरात्तस्माच्छिन्नपक्षा इवाद्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2062249, "chapter_id": 2326, "verse_number": "८-४७-२०", "content_sanskrit": "अपरे प्राद्रवन्नागाः शरार्ता व्रणपीडिताः।\nप्रतिमानैश्च कुम्भैश्च पेतुरुर्व्यां महाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2062250, "chapter_id": 2326, "verse_number": "८-४७-२१", "content_sanskrit": "निषेदुः सिंहवच्चान्ये नदन्तो भैरवान्रवान्।\nवेमुश्च बहवो राजंश्चुक्रुशुश्चापरे गजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2062251, "chapter_id": 2326, "verse_number": "८-४७-२२", "content_sanskrit": "हयाश्च निहता बाणैर्हेमभाण्डविभूषिताः।\nनिषेदुश्चैव मम्लुश्च बभ्रमुश्च दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2062252, "chapter_id": 2326, "verse_number": "८-४७-२३", "content_sanskrit": "अपरे क्लिश्यमानाश्च व्यवेष्टन्त महीतले।\nभावान्बहुविधांश्चक्रुस्ताडिताः शरतोमरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2062253, "chapter_id": 2326, "verse_number": "८-४७-२४", "content_sanskrit": "नरास्तु निहता भूमौ कूजन्तस्तत्र मारिप।\nदृष्ट्वा च बान्धवानन्ये पितॄनन्ये पितामहान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2062254, "chapter_id": 2326, "verse_number": "८-४७-२५", "content_sanskrit": "धावमानान्परांश्चान्ये दृष्ट्वान्ये तत्र भारत।\nख्यातानि गोत्रनामानि शशंसुरितरेतरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2062255, "chapter_id": 2326, "verse_number": "८-४७-२६", "content_sanskrit": "तेषां छिन्ना महाराज भुजाः कनकभूषणाः।\nउद्वेष्टन्ते विवेष्टन्ते भ्रमन्ति ह्युत्पतन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2062256, "chapter_id": 2326, "verse_number": "८-४७-२७", "content_sanskrit": "निपतन्ति तथैवान्ये स्फुरन्ति च सहस्रशः।\nवेगांश्चान्ये रमे चक्रुः पञ्चास्या इव पन्नगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2062257, "chapter_id": 2326, "verse_number": "८-४७-२८", "content_sanskrit": "ते भुजा भोगिभोगाभाश्चन्दनाक्ता विशाम्पते।\nलोहितार्द्रा भृशं रेजुस्तपनीयध्वजा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2062258, "chapter_id": 2326, "verse_number": "८-४७-२९", "content_sanskrit": "वर्तमाने तथा घोरे सङ्कुले सर्वतो दिशम्।\nअविज्ञाताः स्म युध्यन्ते विनिघ्नन्तः परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2062259, "chapter_id": 2326, "verse_number": "८-४७-३०", "content_sanskrit": "भौमेन रजसाकीर्णे शस्त्रसम्पातसङ्कुले।\nनैव स्वे न परे राजन्व्यज्ञायन्त तमोवृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2062260, "chapter_id": 2326, "verse_number": "८-४७-३१", "content_sanskrit": "तथा तदभवद्युद्धं घोररूपं भयानकम्।\nलोहितोदा महानद्यः प्रसस्रुस्तत्र चासकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2062261, "chapter_id": 2326, "verse_number": "८-४७-३२", "content_sanskrit": "शीर्षपाषाणसञ्छन्नाः केशशैवलशाद्वलाः।\nअस्थिमीनसमाकीर्णा धनुःशरगदोडुपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2062262, "chapter_id": 2326, "verse_number": "८-४७-३३", "content_sanskrit": "मांसशोणितपङ्किन्यो घोररूपाः सुदारुणाः।\nनदीः प्रवर्तयामासुः सोणितौघविवर्धिनीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2062263, "chapter_id": 2326, "verse_number": "८-४७-३४", "content_sanskrit": "भीरुवित्रासकारिण्यः शूराणां हर्षवर्धनाः।\nता नद्यो घोररूपास्तु नयन्त्यो यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2062264, "chapter_id": 2326, "verse_number": "८-४७-३५", "content_sanskrit": "अवगाढान्मज्जयन्त्यः क्षत्रस्याजनयन्भयम्।\nक्रव्यादानां नरव्याघ्र नर्दतां तत्रतत्र ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2062265, "chapter_id": 2326, "verse_number": "८-४७-३६", "content_sanskrit": "घोरमायोधनं जज्ञे प्रेतराजपुरोपमम्।\nउत्थितान्यगणेयानि कबन्धानि समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2062266, "chapter_id": 2326, "verse_number": "८-४७-३७", "content_sanskrit": "नृत्यन्ति वै भूतगणाः सुतृप्ता मांसशोणितैः।\nपीत्वा च शोणितं तत्र वसां भुक्त्वा च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2062267, "chapter_id": 2326, "verse_number": "८-४७-३८", "content_sanskrit": "मेदोमज्जावसामत्तास्तृप्ता मांसस्य चैव ह।\nधावमानाः स्म दृश्यन्ते काकगृघ्रबकास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2062268, "chapter_id": 2326, "verse_number": "८-४७-३९", "content_sanskrit": "शूरास्तु समरे राजन्भयं त्यक्त्वा सुदुस्त्यजम्।\nयोधव्रतसमाख्याताश्चक्रुः कर्माण्यभीतवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2062269, "chapter_id": 2326, "verse_number": "८-४७-४०", "content_sanskrit": "शरशक्तिसमाकीर्णे क्रव्यादगणसङ्कुले।\nव्यचरन्त रणे शूराः ख्यापयन्तः स्वपौरुषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2062270, "chapter_id": 2326, "verse_number": "८-४७-४१", "content_sanskrit": "अन्योन्यं श्रावयन्ति स्म नामगोत्राणि भारत।\nपितृनामानि च रणे गोत्रनामानि वा विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2062271, "chapter_id": 2326, "verse_number": "८-४७-४२", "content_sanskrit": "श्रावयाणाश्च बहवस्तत्र योधा विशाम्पते।\nअन्योन्यमवमृद्रन्तः शक्तितोमरपट्टसैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2062272, "chapter_id": 2326, "verse_number": "८-४७-४३", "content_sanskrit": "वर्तमाने तथा युद्धे घोररूपे सुदारुणे।\nव्यषीदत्कौरवी सेना भिन्ना नौरिव सागरे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2062273, "chapter_id": 2326, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे सप्तचत्वारिंशोऽध्यायः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]