[{"id": 6000299000, "chapter_id": 10299, "verse_number": null, "content_sanskrit": "अथ त्र्यधिकशततमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000299001, "chapter_id": 10299, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_103/BhP_10.103.001.m4a", "display_order": 2}, {"id": 6000299002, "chapter_id": 10299, "verse_number": "१०-१०३-१", "content_sanskrit": "उद्वापनस्नानहेतोर्यमुनातीरमागतम्।\nश्रुत्वा तूर्णं कलिङ्गेशो दन्तवक्रः सहानुजः॥ १०/१०३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_103/BhP_10.103.002.m4a", "display_order": 3, "topics": [{"text": "यमुनायामवभृथस्नानं सपरिवारं द्वारकागमनं च । मध्ये दन्तवक्ररोधो दन्तवक्रविडूरथयोर्वधश्च", "range": "१–२८"}]}, {"id": 6000299003, "chapter_id": 10299, "verse_number": "१०-१०३-२", "content_sanskrit": "महत्या सेनया युक्तो गजानीकसमन्वितः।\nगच्छन्तं द्वारकां कृष्णं पथि रोद्धुं समाययौ॥ १०/१०३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_103/BhP_10.103.003.m4a", "display_order": 4}, {"id": 6000299004, "chapter_id": 10299, "verse_number": "१०-१०३-३", "content_sanskrit": "सोऽभ्येत्य पथि गच्छन्तं वृतं यदुकुमारकैः।\nकान्ताषोडशसाहस्रशिबिकापरिवारितम्॥ १०/१०३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_103/BhP_10.103.004.m4a", "display_order": 5}, {"id": 6000299005, "chapter_id": 10299, "verse_number": "१०-१०३-४", "content_sanskrit": "राजन्यसार्थानुगतं महर्षिगणसेवितम्।\nऋत्विक्पुरोहिताचार्यब्राह्मणैश्च समन्वितम्॥ १०/१०३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_103/BhP_10.103.005.m4a", "display_order": 6}, {"id": 6000299006, "chapter_id": 10299, "verse_number": "१०-१०३-५", "content_sanskrit": "दन्तवक्रोऽरुणन्मूढो मृगेन्द्रं जम्बुको यथा। रुग्मिणः शिशुपालस्य पौण्ड्रकस्य च दुर्मतेः।\nपरलोकगतानां च कुर्वन् पारोक्ष्यसौहृदम्॥ १०/१०३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_103/BhP_10.103.006.m4a", "display_order": 7}, {"id": 6000299007, "chapter_id": 10299, "verse_number": "१०-१०३-६", "content_sanskrit": "पदातिः पथि संरोद्धुं गदापाणिः प्रकम्पयन्।\nपद्भ्यां महीं महाराज महासत्वो व्यदृश्यत॥ १०/१०३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_103/BhP_10.103.007.m4a", "display_order": 8}, {"id": 6000299008, "chapter_id": 10299, "verse_number": "१०-१०३-७", "content_sanskrit": "तं तथाऽऽयान्तमालोक्य गदामादाय सत्वरः।\nअवप्लुत्य रथात् कृष्णः सिन्धुं वेलेव प्रत्यगात्॥ १०/१०३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_103/BhP_10.103.008.m4a", "display_order": 9}, {"id": 6000299009, "chapter_id": 10299, "verse_number": "१०-१०३-८", "content_sanskrit": "गदामुद्यम्य कालिङ्गो मुकुन्दं प्राह दुर्मदः।\nदिष्ट्या कृष्ण भवानद्य मम दृष्टिपथं गतः॥ १०/१०३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_103/BhP_10.103.009.m4a", "display_order": 10}, {"id": 6000299010, "chapter_id": 10299, "verse_number": "१०-१०३-९", "content_sanskrit": "त्वामद्य द्वन्द्वयुद्धेन हनिष्याम्यविलम्बितम्। त्वं मातुलेयो नः कृष्ण मित्रध्रुक् पारदारिकः।\nविश्वासघाती बन्धुघ्नः सततं कलहप्रियः॥ १०/१०३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_103/BhP_10.103.010.m4a", "display_order": 11}, {"id": 6000299011, "chapter_id": 10299, "verse_number": "१०-१०३-१०", "content_sanskrit": "पौण्ड्रकं मातुलेयं मे सङ्खे सूदितवानसि।\nरुग्मी च शिशुपालश्च भ्रातरौ मे त्वया हतौ॥ १०/१०३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_103/BhP_10.103.011.m4a", "display_order": 12}, {"id": 6000299012, "chapter_id": 10299, "verse_number": "१०-१०३-११", "content_sanskrit": "अतस्त्वां गदया मन्द हनिष्ये वज्रकल्पया।\nतेनानृण्यमुपैम्यज्ञ मित्राणां मित्रवत्सलः॥ १०/१०३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_103/BhP_10.103.012.m4a", "display_order": 13}, {"id": 6000299013, "chapter_id": 10299, "verse_number": "१०-१०३-१२", "content_sanskrit": "बन्धुरूपमरिं हन्याद् व्याधिं देहचरं यथा।\nइति लोकप्रवादोऽस्ति तेन दोषोऽपि नास्ति मे॥ १०/१०३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_103/BhP_10.103.013.m4a", "display_order": 14}, {"id": 6000299014, "chapter_id": 10299, "verse_number": "१०-१०३-१३", "content_sanskrit": "एवं रूक्षैश्च वचनैः कृष्णं तोत्रैरिव द्विपम्।\nगदयाऽताडयत् कृष्णं सिंहवद् व्यनदच्च सः॥ १०/१०३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_103/BhP_10.103.014.m4a", "display_order": 15}, {"id": 6000299015, "chapter_id": 10299, "verse_number": "१०-१०३-१४", "content_sanskrit": "गदयाऽभिहतोऽप्याजौ न चचाल यदूत्तमः।\nगदया व्यहनद् गुर्व्या कौमोदक्या स्तनान्तरे॥ १०/१०३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_103/BhP_10.103.015.m4a", "display_order": 16}, {"id": 6000299016, "chapter_id": 10299, "verse_number": "१०-१०३-१५", "content_sanskrit": "गाढनिर्भिन्नहृदय उद्वमन् रुधिरं मुखात्।\nप्रसार्य केशबाह्वङ्घ्रीन् गतासुर्व्यपतद् भुवि॥ १०/१०३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_103/BhP_10.103.016.m4a", "display_order": 17}, {"id": 6000299017, "chapter_id": 10299, "verse_number": "१०-१०३-१६", "content_sanskrit": "ततः सूक्ष्मतरं ज्योतिः कृष्णमाविशदुद्धृतम्।\nपश्यतां सर्वभूतानां यथा चैद्यस्य सङ्गरे॥ १०/१०३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_103/BhP_10.103.017.m4a", "display_order": 18}, {"id": 6000299018, "chapter_id": 10299, "verse_number": "१०-१०३-१७", "content_sanskrit": "भ्रातरं निहतं दृष्ट्वा दन्तवक्रं विडूरथः।\nमूर्च्छितो भ्रातृशोकेनाप्यसिचर्म समाददे॥ १०/१०३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_103/BhP_10.103.018.m4a", "display_order": 19}, {"id": 6000299019, "chapter_id": 10299, "verse_number": "१०-१०३-१८", "content_sanskrit": "सोऽवप्लुत्य रथात् तूर्णं विधुन्वन् खड्गमुत्तमम्।\nअभिदुद्राव गोविन्दं पद्भ्यामुर्वीं प्रकम्पयन्॥ १०/१०३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_103/BhP_10.103.019.m4a", "display_order": 20}, {"id": 6000299020, "chapter_id": 10299, "verse_number": "१०-१०३-१९", "content_sanskrit": "तस्य बाणेन चिच्छेद खड्गं यादवनन्दनः।\nततो जग्राह निशितां शक्तिं घोरां विडूरथः॥ १०/१०३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_103/BhP_10.103.020.m4a", "display_order": 21}, {"id": 6000299021, "chapter_id": 10299, "verse_number": "१०-१०३-२०", "content_sanskrit": "तया प्रहर्तुं गोविन्दमभिनिश्चित्य सङ्गरे।\nक्षणेनाभिससाराज्ञश्चापमुक्तो यथा शरः॥ १०/१०३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_103/BhP_10.103.021.m4a", "display_order": 22}, {"id": 6000299022, "chapter_id": 10299, "verse_number": "१०-१०३-२१", "content_sanskrit": "तस्य चापततः कृष्णश्चक्रेण क्षुरनेमिना।\nशिरो जहार राजेन्द्र सकिरीटं सकुण्डलम्॥ १०/१०३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_103/BhP_10.103.022.m4a", "display_order": 23}, {"id": 6000299023, "chapter_id": 10299, "verse_number": "१०-१०३-२२", "content_sanskrit": "एवं निहत्य समरे दन्तवक्रविडूरथौ।\nकालयामास तत्सैन्यं जगृहे वारणादिकम्॥ १०/१०३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_103/BhP_10.103.023.m4a", "display_order": 24}, {"id": 6000299024, "chapter_id": 10299, "verse_number": "१०-१०३-२३", "content_sanskrit": "भूयः पुष्परथं दिव्यमारुह्य समलङ्कृतम्।\nसहितः सात्वतगणैरीडितः सुरमानुषैः॥ १०/१०३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_103/BhP_10.103.024.m4a", "display_order": 25}, {"id": 6000299025, "chapter_id": 10299, "verse_number": "१०-१०३-२४", "content_sanskrit": "मुनिभिः सिद्धगन्धर्वैर्विद्याधरमहोरगैः।\nअप्सरोभिः पितृगणैर्यक्षकिन्नरचारणैः॥ १०/१०३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_103/BhP_10.103.025.m4a", "display_order": 26}, {"id": 6000299026, "chapter_id": 10299, "verse_number": "१०-१०३-२५", "content_sanskrit": "उपगीयमानविजयः कुसुमैरभिवर्षितः।\nवृतश्च वृष्णिप्रवरैर्विवेशालङ्कृतं पुरम्॥ १०/१०३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_103/BhP_10.103.026.m4a", "display_order": 27}, {"id": 6000299027, "chapter_id": 10299, "verse_number": "१०-१०३-२६", "content_sanskrit": "एवं योगेश्वरः कृष्णो भगवान् देवकीसुतः।\nईयते पशुदृष्टीनां जीयते जयतीति सः॥ १०/१०३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_103/BhP_10.103.027.m4a", "display_order": 28}, {"id": 6000299028, "chapter_id": 10299, "verse_number": "१०-१०३-२७", "content_sanskrit": "तस्य कर्माण्युदाराणि पुण्यश्लोकस्य भारत।\nशक्यन्ते कथितुं नैव वर्षाणामयुतैरपि॥ १०/१०३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_103/BhP_10.103.028.m4a", "display_order": 29}, {"id": 6000299029, "chapter_id": 10299, "verse_number": "१०-१०३-२८", "content_sanskrit": "एवमारभ्य राक्षस्याः पूतनायाः परन्तप।\nभूभारभूतानसुरान् जघान मधुसूदनः॥ १०/१०३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_103/BhP_10.103.029.m4a", "display_order": 30}, {"id": 6000299030, "chapter_id": 10299, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे त्र्यधिकशततमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]