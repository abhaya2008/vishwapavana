[{"id": 2099880, "chapter_id": 3138, "verse_number": "१३-२६८-१", "content_sanskrit": "युधिष्ठिर उवाच।\nये च धर्ममसूयन्ते ये चैनं पर्युपासते।\nब्रवीतु मे भवानेतत्क्व ते गच्छन्ति तादृशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2099881, "chapter_id": 3138, "verse_number": "१३-२६८-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2099882, "chapter_id": 3138, "verse_number": "१३-२६८-२", "content_sanskrit": "रजसा तमसा चैव समवस्तीर्णचेतसः।\nनरकं प्रतिपद्यन्ते धर्मविद्वेषिमो जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2099883, "chapter_id": 3138, "verse_number": "१३-२६८-३", "content_sanskrit": "ये तु धर्मं महाराज सततं पर्युपासते।\nसत्यार्जवपराः सन्तस्ते वै स्वर्गभूजो नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2099884, "chapter_id": 3138, "verse_number": "१३-२६८-४", "content_sanskrit": "धर्म एव रतिस्तेषामाचार्योपासनाद्भवेत्।\nदेवलोकं प्रपद्यन्ते ये धर्मं पर्युपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2099885, "chapter_id": 3138, "verse_number": "१३-२६८-५", "content_sanskrit": "मनुष्या यदि वा देवाः शरीरमुपताप्य वै।\nधर्मिणः सुखमेधन्ते लोभद्वेषविवर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2099886, "chapter_id": 3138, "verse_number": "१३-२६८-६", "content_sanskrit": "प्रथमं ब्रह्म्णः पुत्रं धर्ममाहुर्मनीषिणः।\nधर्मिणः पर्युपासन्ते फलं पक्वमिवाशिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2099887, "chapter_id": 3138, "verse_number": "१३-२६८-७x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2099888, "chapter_id": 3138, "verse_number": "१३-२६८-७", "content_sanskrit": "असाधोः कीदृशं शीलं साधोश्चैव तु कीदृशम्।\nब्रवीतु मे भवानेतत्सन्तोऽसन्तश्च कीदृशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2099889, "chapter_id": 3138, "verse_number": "१३-२६८-८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2099890, "chapter_id": 3138, "verse_number": "१३-२६८-८", "content_sanskrit": "दुराधाराश्च दुर्धर्षा दुर्मुखाश्चाप्यसाधवः।\nसाधवः शीलसम्पन्नाः शिष्टाचारस्य लक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2099891, "chapter_id": 3138, "verse_number": "१३-२६८-९", "content_sanskrit": "राजमार्गे गवां मध्ये जनमध्ये च धर्मिणः।\nनोपसेचन्ति राजेन्द्र सर्गं मूत्रपुरीषयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2099892, "chapter_id": 3138, "verse_number": "१३-२६८-१०", "content_sanskrit": "पञ्चानां यजनं कृत्वा शेषमश्नन्ति साधवः।\nन जल्पन्ति च भुञ्जाना न निद्रान्त्यार्द्रपाणयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2099893, "chapter_id": 3138, "verse_number": "१३-२६८-११", "content_sanskrit": "चित्रभानुमपां देवं गोष्ठं चैव चतुष्पथम्।\nब्राह्मणं धार्मिकं वृद्धं ये कुर्वन्ति प्रदक्षिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2099894, "chapter_id": 3138, "verse_number": "१३-२६८-१२", "content_sanskrit": "वृद्धानां भारतप्रानां स्त्रीणां बालातुरस्य च।\nब्राह्मणानां गवां राज्ञां पन्थानं ददते च ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2099895, "chapter_id": 3138, "verse_number": "१३-२६८-१३", "content_sanskrit": "अतिथीनां च सर्वेषां प्रेष्याणां स्वजनस्य च।\n`सामान्यं भोजनं कुर्यात्स्वयं नाग्र्यशनं व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2099896, "chapter_id": 3138, "verse_number": "१३-२६८-१४", "content_sanskrit": "न सत्यार्जवधर्मस्य तुल्यमन्यच्च विद्यते।\nबहुला नाम गौस्तेन गतिमग्र्यां गता किल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2099897, "chapter_id": 3138, "verse_number": "१३-२६८-१५", "content_sanskrit": "मुनिशापाद्द्विजः कश्चिद्व्याघ्रतां समुपागतः।\nबहुलां भक्षणरुचिरास्वाद्य शपथेन तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2099898, "chapter_id": 3138, "verse_number": "१३-२६८-१६", "content_sanskrit": "विमुच्य पीतवत्सां तां दृष्ट्वा स्मृत्वा पुरातनम्।\nजगाम लोकानमलान्सा स्वराष्ट्रं तथा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2099899, "chapter_id": 3138, "verse_number": "१३-२६८-१७", "content_sanskrit": "तस्मात्सत्यार्जवरतो राजन्राष्ट्रं समानवम्।\nतारयित्वा सुखं स्वर्गं गन्तासि भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2099900, "chapter_id": 3138, "verse_number": "१३-२६८-१८", "content_sanskrit": "तथा शरणकामानां गोप्ता स्यात्स्वागतप्रदः॥\nसायं प्रातर्मनुष्याणामशनं देवनिर्मितम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2099901, "chapter_id": 3138, "verse_number": "१३-२६८-१९", "content_sanskrit": "नान्तरा भोजनं दृष्टमुपवासविधिर्हि सः॥\nहोमकाले यथा वह्निः काले होमं प्रतीक्षते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2099902, "chapter_id": 3138, "verse_number": "१३-२६८-२०", "content_sanskrit": "ऋतुकाले तथाऽऽधानं पितरश्च प्रतीक्षते।\nनान्यदा गच्छते यस्तु ब्रह्मचर्यं च तत्स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2099903, "chapter_id": 3138, "verse_number": "१३-२६८-२१", "content_sanskrit": "अमृतं ब्राह्मणा गाव इत्येतत्त्रयमेकतः।\nतस्मादोब्राह्मणान्नित्यमर्चयेत यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2099904, "chapter_id": 3138, "verse_number": "१३-२६८-२२", "content_sanskrit": "यजुषां संस्कृतं मांसमुपभुञ्जत दुष्यति।\nपृष्ठमांसं वृथामांसं पुत्रमांसं च तत्समम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2099905, "chapter_id": 3138, "verse_number": "१३-२६८-२३", "content_sanskrit": "स्वदेशे परदेशे वाऽप्यतिथिं नोपवासयेत्।\nकर्म वै सफलं कृत्वा गुरुणां प्रतिपादयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2099906, "chapter_id": 3138, "verse_number": "१३-२६८-२४", "content_sanskrit": "गुरुभ्यस्त्वासनं देयमभिवाद्याभिपूज्य च।\nगुरुमभ्यर्च्य वर्धन्ते आयुषा यशसा श्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2099907, "chapter_id": 3138, "verse_number": "१३-२६८-२५", "content_sanskrit": "वृद्धान्नाभिभवेज्जातु न चैतान्प्रेषयेदिति।\nनासीनः स्यात्स्थितेष्वेवमायुरस्य न रिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2099908, "chapter_id": 3138, "verse_number": "१३-२६८-२६", "content_sanskrit": "न नग्रामीक्षते नारीं न नग्रान्पुरुषानपि।\nमैथुनं सततं गुप्तं तपश्चैव समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2099909, "chapter_id": 3138, "verse_number": "१३-२६८-२७", "content_sanskrit": "तीर्थानां गुरवस्तीर्थं शुचीनां हृदयं शुचि।\nदर्शनानां परं ज्ञानं सन्तोषः परमं सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2099910, "chapter_id": 3138, "verse_number": "१३-२६८-२८", "content_sanskrit": "सायं प्रातश्च वृद्धानां शृणुयात्पुष्कला गिरः।\nश्रुतमाप्नोति हि नरः सततं वृद्धसेवया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2099911, "chapter_id": 3138, "verse_number": "१३-२६८-२९", "content_sanskrit": "स्वाध्याये भोजने चैव दक्षिणं पाणिमुद्धरेत्।\nयच्छेद्वाङ्मनसी नित्यमिन्द्रियाणि तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2099912, "chapter_id": 3138, "verse_number": "१३-२६८-३०", "content_sanskrit": "संस्कृतं पायसं नित्यं यावकं कृसरं हविः।\nअष्टकाः पितृदैवत्या ग्रहाणामभिपूजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2099913, "chapter_id": 3138, "verse_number": "१३-२६८-३१", "content_sanskrit": "श्मश्रुकर्मणि मङ्गल्यं क्षुतानामभिनन्दनम्।\nव्याधितानां च सर्वेषामायुषामभिनन्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2099914, "chapter_id": 3138, "verse_number": "१३-२६८-३२", "content_sanskrit": "न जातु त्वमिति ब्रूयादापन्नोपि महृत्तरम्।\nत्वंकारो वा वधो वेति विद्वत्सु न विशिष्यते।\nअवराणां समानानां शिष्याणां च समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2099915, "chapter_id": 3138, "verse_number": "१३-२६८-३३", "content_sanskrit": "पापमाचरते नित्यं हृदयं पापकर्मणाम्।\nज्ञानपूर्वकृतं कर्म च्छादयन्ते ह्यसाधवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2099916, "chapter_id": 3138, "verse_number": "१३-२६८-३४", "content_sanskrit": "ज्ञानपूर्वं विनश्यन्ति गूहमाना महाजने।\nन मां मनुष्याः पश्यन्ति न मां पश्यन्ति देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2099917, "chapter_id": 3138, "verse_number": "१३-२६८-३५", "content_sanskrit": "पापेनाभिहितः पापः पापमेवाभिजायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2099918, "chapter_id": 3138, "verse_number": "१३-२६८-३६", "content_sanskrit": "यथा वार्धुषिको वृद्धिं दिनभेदे प्रतीक्षते।\nधर्मेण पिहितं पापं धर्ममेवाभिवर्धयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2099919, "chapter_id": 3138, "verse_number": "१३-२६८-३७", "content_sanskrit": "यथा लवणमम्भोभिराप्लुतं प्रविलीयते।\nप्रायश्चित्तहतं पापं तथा सद्यः प्रणश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2099920, "chapter_id": 3138, "verse_number": "१३-२६८-३८", "content_sanskrit": "तस्मात्पापं न गूहेत गूहमानं विवर्धते।\nकृत्वा तु सादुष्वाख्यायाधर्मं प्रशमयन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2099921, "chapter_id": 3138, "verse_number": "१३-२६८-३९", "content_sanskrit": "आशया सञ्चितं द्रव्यं स्वकाले नोपभुज्यते।\nअन्ये चैतत्प्रद्यन्ते वियोगे तस्य देहिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2099922, "chapter_id": 3138, "verse_number": "१३-२६८-४०", "content_sanskrit": "`तद्धर्मसाधनं नित्यं सङ्कल्पाद्धनमार्जयेत्।\nमननं सर्वभूतानां धर्ममाहुर्मनीषिणः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2099923, "chapter_id": 3138, "verse_number": "१३-२६८-४१", "content_sanskrit": "तस्मात्सर्वाणि भूतानि धर्ममेव समासते॥\nएक एव चरेद्धर्मं न धर्मध्वजिको भवेत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2099924, "chapter_id": 3138, "verse_number": "१३-२६८-४२", "content_sanskrit": "धर्मवाणिजका ह्येते ये धर्ममुपभुञ्जते॥\nअर्चेद्देवानदम्भेन सेवेताऽमायया गुरून्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2099925, "chapter_id": 3138, "verse_number": "१३-२६८-४३", "content_sanskrit": "धनं निदध्यात्पात्रेषु परत्रार्थं समावृतम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2099926, "chapter_id": 3138, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि अष्टषष्ट्यधिकद्विशततमोऽध्यायः॥ २६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]