[{"id": 2177743, "chapter_id": 4753, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2177744, "chapter_id": 4753, "verse_number": "१", "content_sanskrit": "तदाज्ञाय हृषीकेशो विकृष्टं पापकर्मणा ।\nहृष्यमाण इदं वाक्यं द्रौणिं प्रत्यादिशत् तदा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2177745, "chapter_id": 4753, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2177746, "chapter_id": 4753, "verse_number": "२", "content_sanskrit": "विराटस्य सुतां पूर्वं स्नुषां गाण्डीवधन्वनः ।\nउपप्लाव्यगतां दृष्ट्वा उत्तरां ब्राह्मणोऽब्रवीत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2177747, "chapter_id": 4753, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2177748, "chapter_id": 4753, "verse_number": "३", "content_sanskrit": "परिक्षीणेषु कुरुषु पुत्रस्तव जनिष्यते ।\nएतदस्य परिक्षित्त्वं गर्भस्थस्य भविष्यति\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2177749, "chapter_id": 4753, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2177750, "chapter_id": 4753, "verse_number": "४", "content_sanskrit": "तस्य तद्वचनं साधोः सत्यमेव भविष्यति ।\nपरिक्षिद्भवितैतेषां पुनर्वंशकरः सुतः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2177751, "chapter_id": 4753, "verse_number": "५", "content_sanskrit": "त्वां तु कापुरुषं पापं विदुःसर्वे मनीषिणः ।\nअसकृत् पापकर्माणं बालजीवितघातकम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2177752, "chapter_id": 4753, "verse_number": "६", "content_sanskrit": "तस्मात् त्वमस्य पापस्य कर्मणः फलमाप्नुहि ।\nत्रीणि वर्षसहस्राणि चरिष्यसि महीमिमाम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2177753, "chapter_id": 4753, "verse_number": "७", "content_sanskrit": "अप्राप्नुवन् क्वचित् काञ्चित् संविदं जातु केनचित् ।\nनिर्जनानसहायस्त्वं देशान् प्रति चरिष्यसि\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2177754, "chapter_id": 4753, "verse_number": "८", "content_sanskrit": "भवित्री न हि ते क्षुद्र जनमध्येषु संस्थितिः ।\nपूयशोणितगन्धी च दुर्गकान्तारसंश्रयः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2177755, "chapter_id": 4753, "verse_number": "९", "content_sanskrit": "विचरिष्यसि पापात्मन् चिरमेको वसुन्धराम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2177756, "chapter_id": 4753, "verse_number": "१०", "content_sanskrit": "वयः प्राप्य परिक्षित्तु देवव्रतमवाप्य च ।\nकृपाच्छारद्वताच्छूरः सर्वास्त्राण्युपलप्स्यते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2177757, "chapter_id": 4753, "verse_number": "११", "content_sanskrit": "विदित्वा परमास्त्राणि क्षत्रधर्मव्रते स्थितः ।\nषष्टिवर्षाणि धर्मात्मा वसुधां पालयिष्यति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2177758, "chapter_id": 4753, "verse_number": "१२", "content_sanskrit": "ततश्चोर्ध्वं महाबाहुः कुरुराजो भविष्यति ।\nपरिक्षिन्नाम नृपतिर्मिषतस्ते सुदुर्मते ।\nअहं तं जीवयिष्यामि दग्धं शस्त्राग्नितेजसा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2177759, "chapter_id": 4753, "verse_number": "१३", "content_sanskrit": "पश्य मे तपसो वीर्यं सत्यस्य च नराधम\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2177760, "chapter_id": 4753, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2177761, "chapter_id": 4753, "verse_number": "१४", "content_sanskrit": "यस्मादनादृत्य कृतं त्वयाऽस्मान् कर्म दारुणम् ।\nब्राह्मणस्य सतश्चेदं वृत्तमन्यायवर्तिनः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2177762, "chapter_id": 4753, "verse_number": "१५", "content_sanskrit": "तस्माद्यद् देवकीपुत्र उक्तवानुत्तमं वचः ।\nअसंशयं ते तद्भावि क्षुद्रकर्मन् व्रजेति ह\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2177763, "chapter_id": 4753, "verse_number": "", "content_sanskrit": "अश्वत्थामा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2177764, "chapter_id": 4753, "verse_number": "१६", "content_sanskrit": "सहैव भवता ब्रह्मन् स्थास्यामि मनुजेष्विह ।\nसत्यवागस्तु भगवान् अयं च पुरुषोत्तमः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2177765, "chapter_id": 4753, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2177766, "chapter_id": 4753, "verse_number": "१७", "content_sanskrit": "प्रदायाथ मणिं द्रौणिः पाण्डवानां यशस्विनाम् ।\nजगाम विमनस्तेषां सर्वेषां पश्यतां रणे\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2177767, "chapter_id": 4753, "verse_number": "१८", "content_sanskrit": "पाण्डवाश्चैव गोविन्दं पुरस्कृत्य हतद्विषः ।\nकृष्णद्वैपायनं चैव पर्वतं नारदं तथा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2177768, "chapter_id": 4753, "verse_number": "१९", "content_sanskrit": "द्रोणपुत्रस्य सहजं मणिमादाय सत्वराः ।\nद्रौपदीमभ्यधावन्त प्रायोपेतां यशस्विनीम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2177769, "chapter_id": 4753, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nऐषीकपर्वणि मणिलाभो नाम सप्तमोऽध्यायः॥७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]