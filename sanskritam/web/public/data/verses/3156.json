[{"id": 2100546, "chapter_id": 3156, "verse_number": "१४-१२-१", "content_sanskrit": "वासुदेव उवाच।\nद्विवोधो जायते व्याधिः शारीरो मानसस्तथा।\nपरस्परं तयोर्जन्म निर्द्वन्द्वं नोपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2100547, "chapter_id": 3156, "verse_number": "१४-१२-२", "content_sanskrit": "शरीरे जायते व्याधिः शरीरः स निगद्यते।\nमानसे जायते व्याधिर्मानसस्तु निगद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2100548, "chapter_id": 3156, "verse_number": "१४-१२-३", "content_sanskrit": "शीतोष्णे चैव वायुश्च गुणा राजञ्शरीरजाः।\nतेषां गुणानां साम्यं चेत्तदाहुः स्वस्थलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2100549, "chapter_id": 3156, "verse_number": "१४-१२-४", "content_sanskrit": "उष्णेन बाध्यते शीतं शीतेनोष्णं च बाध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2100550, "chapter_id": 3156, "verse_number": "१४-१२-५", "content_sanskrit": "सत्वं रजस्तमश्चेति त्रय आत्मगुणाः स्मृताः।\nतेषां गुणानां साम्यं चेत्तदाहुः स्वस्थलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2100551, "chapter_id": 3156, "verse_number": "१४-१२-६", "content_sanskrit": "तेषामन्यतमोत्सेके विधानमुपदिश्यते।\nहर्षेण बाध्यते शोको हर्षः शोकेन बाध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2100552, "chapter_id": 3156, "verse_number": "१४-१२-७", "content_sanskrit": "कश्चिद्दुःखे वर्तमानः सुखस्य स्मर्तुमिच्छति।\nकश्चित्सुखे वर्तमानो दुःखस्य स्मर्तुमिच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2100553, "chapter_id": 3156, "verse_number": "१४-१२-८", "content_sanskrit": "स त्वं न दुःखी दुःखस्य न सुखी सुसुखस्य वा।\nस्मर्तुमिच्छसि कौन्तेय दैवं हि बलवत्तरम्।\nअथवा ते स्वभावोऽयं येन पार्थावकृष्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2100554, "chapter_id": 3156, "verse_number": "१४-१२-९", "content_sanskrit": "दृष्ट्वा सभागतां कृष्णामेकवस्त्रां रजस्वलाम्।\nमिषतां पाण्डवेयानां न तस्य स्मर्तुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2100555, "chapter_id": 3156, "verse_number": "१४-१२-१०", "content_sanskrit": "प्रव्राजनं च नगरादजिनैश्च विवासनम्।\nमहारण्यनिवासश्च न तस्य स्मर्तुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2100556, "chapter_id": 3156, "verse_number": "१४-१२-११", "content_sanskrit": "जटासुरात्परिक्लेशश्चित्रसेनेन चाहवः।\nसैन्धवाच्च परिक्लेशो न तस्य स्मर्तुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2100557, "chapter_id": 3156, "verse_number": "१४-१२-१२", "content_sanskrit": "पुनरज्ञातचर्यायां कीचकेन पदा वधः।\nयाज्ञसेन्यास्तथा पार्थ न तस्य स्मर्तुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2100558, "chapter_id": 3156, "verse_number": "१४-१२-१३", "content_sanskrit": "यच्च ते द्रोणभीष्माभ्यां युद्धमासीदरिंदम।\nमनसैकेन योद्धव्यं तत्ते युद्धमुपस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2100559, "chapter_id": 3156, "verse_number": "१४-१२-१४", "content_sanskrit": "तस्मादभ्युपगन्तव्यं युद्धाय भरतर्षभ।\nपरमव्यक्तरूपस्य पारं युक्त्या स्वकर्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2100560, "chapter_id": 3156, "verse_number": "१४-१२-१५", "content_sanskrit": "यत्र नैव शरैः कार्यं न भृत्यैर्न च बन्धुभिः।\nआत्मनैकेन योद्धव्यं तत्ते युद्धमुपस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2100561, "chapter_id": 3156, "verse_number": "१४-१२-१६", "content_sanskrit": "तस्मिन्ननिर्जिते युद्धे कामवस्थां गमिष्यसि।\nएतज्ज्ञात्वा तु कौन्तेय कृतकृत्यो भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2100562, "chapter_id": 3156, "verse_number": "१४-१२-१७", "content_sanskrit": "एथां बुद्धिं विनिश्चित्य भूतानामागतिं गतिम्।\nपितृपैतामहे वृत्ते शाधि राज्यं यथोचितम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2100563, "chapter_id": 3156, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अश्वमेधपर्वणि द्वादशोऽध्यायः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]