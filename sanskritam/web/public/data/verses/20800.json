[{"id": 7000800000, "chapter_id": 20800, "verse_number": "६-१४३-१", "content_sanskrit": "एकधारं ततो गच्छेत्तीर्थं परमपावनम् ।\nएकधारे नरः स्नात्वा एकरात्रमुपोषितः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000800001, "chapter_id": 20800, "verse_number": "६-१४३-२", "content_sanskrit": "अर्चयन्स्वामिदेवेशं कुलानां तारयेच्छतम् ।\nस्वामितीर्थसमं ज्ञेयं यत्र तीर्थेऽवगाहनम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000800002, "chapter_id": 20800, "verse_number": "६-१४३-३", "content_sanskrit": "रुद्रलोके नरो गच्छेत्तीर्थस्यास्य प्रभावतः ।\nयत्र स्नात्वा च पीत्वा च ब्रह्मलोके च गच्छति॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000800003, "chapter_id": 20800, "verse_number": "६-१४३-४", "content_sanskrit": "त्रैलोक्ये पुण्यकर्माणस्तटेऽस्मिन्संवसंति हि॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000800004, "chapter_id": 20800, "verse_number": "६-१४३-५", "content_sanskrit": "न भयं विद्यते तेषां खड्गधारादिकं च यत् ।\nसत्सर्वमाशु नश्येत तीर्थे ह्येकप्रधारके॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000800005, "chapter_id": 20800, "verse_number": "६-१४३-६", "content_sanskrit": "इति एकधारतीर्थवर्णनम् ।\nसप्तधारं ततो गच्छेत्तीर्थानां तीर्थमुत्तमम् ।\nसप्तसारस्वतं नाम यत्कृते मुनिभिः कृतम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000800006, "chapter_id": 20800, "verse_number": "६-१४३-७", "content_sanskrit": "त्रेतायुगे मंकितीर्थं कृतं मंकि महर्षिणा ।\nद्वापरे पांडुपुत्रैस्तु सप्तधारं प्रवर्तितम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000800007, "chapter_id": 20800, "verse_number": "६-१४३-८", "content_sanskrit": "सप्तधारकतां प्राप्तं तीर्थं हरजटा च्युतम् ।\nसप्तरूपाणि गंगाया यामि लोकेषु सप्तसु॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000800008, "chapter_id": 20800, "verse_number": "६-१४३-९", "content_sanskrit": "वहंति तानि पुण्यानि तीर्थेऽस्मिन्सप्तधारके ।\nसप्तधारे कृतं श्राद्धं पितॄणां तृप्तिदायकम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000800009, "chapter_id": 20800, "verse_number": "६-१४३-१०", "content_sanskrit": "शृणु देवि प्रवक्ष्यामि इतिहासं पुरातनम् ।\nयच्छ्रुत्वा देवदेवेशि ब्रह्मलोकं व्रजेद्ध्रुवम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000800010, "chapter_id": 20800, "verse_number": "६-१४३-११", "content_sanskrit": "कौषीतकस्य पुत्रो वै मंकि नामेति विश्रुतः ।\nविष्णुध्यानरतो नित्यं विष्णुलोकप्रपूजकः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000800011, "chapter_id": 20800, "verse_number": "६-१४३-१२", "content_sanskrit": "वेदाध्ययनकर्ता च अग्निहोत्रपरायणः ।\nसुरूपा विश्वरूपेति स्त्रियौ द्वेस्तस्तु तद्गृहे॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000800012, "chapter_id": 20800, "verse_number": "६-१४३-१३", "content_sanskrit": "ताभ्यां पुत्रविहीनाभ्यां दृष्ट्वा देविविशंकितः ।\nकिंकर्तव्यमिति ध्यायन्नति चिंतापरोऽभवत्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000800013, "chapter_id": 20800, "verse_number": "६-१४३-१४", "content_sanskrit": "स्थिरो वंशस्तु पुत्रेण ह्यन्यथा नरकं व्रजेत् ।\nएवं चिंतां प्रकुर्वाणो न सुखं लभते क्वचित्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000800014, "chapter_id": 20800, "verse_number": "६-१४३-१५", "content_sanskrit": "तदा स्वगृहमुत्सृज्य गतो वै गुरुसन्निधौ ।\nनमो वै गुरुवे तुभ्यं देवानामुपकारिणे॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000800015, "chapter_id": 20800, "verse_number": "६-१४३-१६", "content_sanskrit": "त्वं नाथः सर्वलोकानां ब्राह्मणानां च रक्षकः ।\nयज्ञानां त्वं प्रकर्त्ता च द्विजराज नमोस्तु ते॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000800016, "chapter_id": 20800, "verse_number": "६-१४३-१७", "content_sanskrit": "अपुत्रोऽहं तु विप्रर्षे किं कर्त्तव्यमिति प्रभो ।\nवद त्वं तु यथा सर्वं पुत्रो भवति निश्चितम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000800017, "chapter_id": 20800, "verse_number": "६-१४३-१८", "content_sanskrit": "अपुत्रस्य गतिर्नास्ति स्वर्गे नैव च नैव च ।\nयेनकेनाप्युपायेन पुत्रस्य जननं चरेत्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000800018, "chapter_id": 20800, "verse_number": "६-१४३-१९", "content_sanskrit": "इति वाक्यं तु संस्मर्य्य ह्यागतस्तव सन्निधौ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000800019, "chapter_id": 20800, "verse_number": "६-१४३-२०", "content_sanskrit": "गुरुरुवाच ।\nगच्छ त्वं मुनिशार्दूल यत्र साभ्रमती नदी ।\nतत्र गत्वा मुनिश्रेष्ठ पुत्रान्वै प्राप्स्यसे ध्रुवम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000800020, "chapter_id": 20800, "verse_number": "६-१४३-२१", "content_sanskrit": "तद्वाक्यं तु समाकर्ण्य नमस्कृत्वा तु दंडवत् ।\nस गतो विप्रराजस्तु नदीं साभ्रमतीं प्रति॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000800021, "chapter_id": 20800, "verse_number": "६-१४३-२२", "content_sanskrit": "मंकिनामा तु विप्रर्षिस्तत्र गत्वा तपो महत् ।\nअतप्यत तदा देवि यावद्वर्षचतुष्टयम्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000800022, "chapter_id": 20800, "verse_number": "६-१४३-२३", "content_sanskrit": "यत्र तीर्थं कृतं तेन मंकिना ब्रह्मवादिना ।\nत्रेतायुगे तदा देवि तदा तीर्थं महाद्भुतम्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000800023, "chapter_id": 20800, "verse_number": "६-१४३-२४", "content_sanskrit": "जातं तत्र न संदेहः पुत्रदं सार्वकामिकम् ।\nअद्यापि मंकितीर्थाभं न भूतं न भविष्यति॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000800024, "chapter_id": 20800, "verse_number": "६-१४३-२५", "content_sanskrit": "स वै द्विजवरो मंकिः पुत्रान्प्राप्य यथासुखम् ।\nभोगान्नानाविधान्भुक्त्वा स गतो मंदिरं मम॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000800025, "chapter_id": 20800, "verse_number": "६-१४३-२६", "content_sanskrit": "एतदाख्यानकं दिव्यं पवित्रं परमं महत् ।\nपुत्रसौख्यादिकं सर्वं लभते श्रवणादतः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]