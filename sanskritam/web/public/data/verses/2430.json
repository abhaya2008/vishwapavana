[{"id": 2068153, "chapter_id": 2430, "verse_number": "९-१६-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2068154, "chapter_id": 2430, "verse_number": "९-१६-१", "content_sanskrit": "अत्यद्भुतमिदं ब्रह्मञ्श्रुतवानस्मि तत्त्वतः।\nअभिषेकं कुमारस्य विस्तरेण यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2068155, "chapter_id": 2430, "verse_number": "९-१६-२", "content_sanskrit": "यच्छ्रुत्वा पूतमात्मानं विजानामि तपोधन।\nप्रहृष्टानि च रोमाणि प्रसन्नं च मनो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2068156, "chapter_id": 2430, "verse_number": "९-१६-३", "content_sanskrit": "अभिषेकं कुमारस्य दैत्यानां च वधं तथा।\nश्रुत्वा मे परमा प्रीतिर्भूयः कौतूहलं हि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2068157, "chapter_id": 2430, "verse_number": "९-१६-४", "content_sanskrit": "अपाम्पतिः कथं ह्यस्मिन्नभिषिक्तः पुरा सुरैः।\nतन्मे ब्रूहि महाप्रज्ञ कुशलो ह्यसि सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2068158, "chapter_id": 2430, "verse_number": "९-१६-५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2068159, "chapter_id": 2430, "verse_number": "९-१६-५", "content_sanskrit": "शृणु राजन्निदं चित्रं पूर्वकाले यथाऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2068160, "chapter_id": 2430, "verse_number": "९-१६-६", "content_sanskrit": "आदौ कृतयुगे राजन्वर्तमाने यथाविधि।\nवरुणं देवताः सर्वाः समेत्येदमथाब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2068161, "chapter_id": 2430, "verse_number": "९-१६-७", "content_sanskrit": "यथाऽस्मान्सुरराट् शक्रो भयेभ्यः पाति सर्वदा।\nतथा त्वमपि सर्वासां सरितां वै पतिर्भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2068162, "chapter_id": 2430, "verse_number": "९-१६-८", "content_sanskrit": "वासश्च ते सदा देव सागरे मकरालये।\nसमुद्रोऽयं तव वशे भविष्यति नदीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2068163, "chapter_id": 2430, "verse_number": "९-१६-९", "content_sanskrit": "सोमेन सार्धं च तव हानिवृद्वी भविष्यतः।\nएवमस्त्विति तान्देवान्वरुणो वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2068164, "chapter_id": 2430, "verse_number": "९-१६-१०", "content_sanskrit": "समागम्य ततः सर्वे वरुणं सागरालयम्।\nअपाम्पतिं प्रचक्रुर्हि विधिदृष्टेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2068165, "chapter_id": 2430, "verse_number": "९-१६-११", "content_sanskrit": "अभिषिच्य ततो देवा वरुणं यादसाम्पतिम्।\nजग्मुः स्वान्येव स्थानानि पूजयित्वा जलेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2068166, "chapter_id": 2430, "verse_number": "९-१६-१२", "content_sanskrit": "अभिषिक्तस्ततो देवैर्वरुणोऽपि महायशाः।\nसरितः सागरांश्चैव नदांश्चापि सरांसि च।\nपालयामास विधिना यथा देवाञ्शतक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2068167, "chapter_id": 2430, "verse_number": "९-१६-१३", "content_sanskrit": "ततस्त्रत्राप्युपस्पृश्य दत्त्वा च विविधं वसु।\nअग्नितीर्थं महाप्राज्ञो जगामाथ प्रलम्बहा।\nनष्टो न दृश्यते यत्र शमीगर्भे दुताशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2068168, "chapter_id": 2430, "verse_number": "९-१६-१४", "content_sanskrit": "लोकालोकविनाशे च प्रादुर्भूते तदाऽनघ।\nउपतस्थुः सुरा यत्र सर्वलोकपितामहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2068169, "chapter_id": 2430, "verse_number": "९-१६-१५", "content_sanskrit": "अग्निः प्रनष्टो भगवान्कारणं च न विद्महे।\nसर्वभूतक्षयो राजन्सम्पादय विभोऽनलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2068170, "chapter_id": 2430, "verse_number": "९-१६-१६x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2068171, "chapter_id": 2430, "verse_number": "९-१६-१६", "content_sanskrit": "किमर्थं भगवानग्निः प्रनष्टो लोकभावनाः।\nविज्ञातश्च कथं देवैस्तन्ममाचक्ष्व तत्त्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2068172, "chapter_id": 2430, "verse_number": "९-१६-१७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2068173, "chapter_id": 2430, "verse_number": "९-१६-१७", "content_sanskrit": "भृगोः शापाद्भृशं भीतो जातवेदाः प्रतापवान्।\nशमीगर्भमथासाद्य ननाश भगवांस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2068174, "chapter_id": 2430, "verse_number": "९-१६-१८", "content_sanskrit": "प्रनष्टे तु तदा वह्नौ देवाः सर्वे सवासवाः।\nअन्वैषन्त तदा नष्टं ज्वलनं भृशदुःखिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2068175, "chapter_id": 2430, "verse_number": "९-१६-१९", "content_sanskrit": "ततोऽग्नितीर्थमासाद्य शमीगर्भस्थमेव हि।\nददृशुर्ज्वलनं तत्र वसमानं यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2068176, "chapter_id": 2430, "verse_number": "९-१६-२०", "content_sanskrit": "देवाः सर्वे नरव्याघ्र बृहस्पतिपुरोगमाः।\nज्वलनं तं समासाद्य प्रीताऽभूवन्सवासवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2068177, "chapter_id": 2430, "verse_number": "९-१६-२१", "content_sanskrit": "पुनर्यथागतं जग्मुः सर्वभक्षश्च सोऽभवत्।\nभृगोः शापान्महाभाग यदुक्तं ब्रह्मवादिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2068178, "chapter_id": 2430, "verse_number": "९-१६-२२", "content_sanskrit": "तत्राप्याप्लुत्य मतिमान्ब्रह्मशापान्मुमोच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2068179, "chapter_id": 2430, "verse_number": "९-१६-२३", "content_sanskrit": "तत्राप्लुत्य ततो ब्रह्मा सह देवैः प्रभुः पुरा।\nससर्ज चान्नानि तथा देवतानां यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2068180, "chapter_id": 2430, "verse_number": "९-१६-२४", "content_sanskrit": "तत्र स्नात्वा च दत्त्वा च वसूनि विविधानि च।\nकौबेरं प्रययौ तीर्थं यत्र तप्त्वा महत्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2068181, "chapter_id": 2430, "verse_number": "९-१६-२५", "content_sanskrit": "धनाधिपत्यं सम्प्राप्तो राजन्नैलबिलः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2068182, "chapter_id": 2430, "verse_number": "९-१६-२६", "content_sanskrit": "तत्रस्थमेव तं राजन्धनानि निधयस्तथा।\nउपतद्धतुर्नरश्रेष्ठ तत्तीर्थं लाङ्गली बलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2068183, "chapter_id": 2430, "verse_number": "९-१६-२७", "content_sanskrit": "गत्वा स्नात्वा च विधिवद्ब्राह्मणेभ्यो धनं ददौ।\nददृशे तत्र तत्स्थानं कौबेरे काननोत्तमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2068184, "chapter_id": 2430, "verse_number": "९-१६-२८", "content_sanskrit": "पुरा यत्र तपस्तप्तं विपुलं सुमहात्मना।\nयक्षराज्ञा कुबेरेण वरा लब्धाश्च पुष्कलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2068185, "chapter_id": 2430, "verse_number": "९-१६-२९", "content_sanskrit": "धनाधिपत्यं सख्यं च रुद्रेणामिततेजसा।\nसुरत्वं लोकपालत्वं पुत्रं च नलकूबरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2068186, "chapter_id": 2430, "verse_number": "९-१६-३०", "content_sanskrit": "यत्र लेभे महाबाहो धनाधिपतिरञ्जसा।\nअभिषिक्तश्च तत्रैव समागम्य मरुद्गणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2068187, "chapter_id": 2430, "verse_number": "९-१६-३१", "content_sanskrit": "वाहनं चास्य तद्दत्तं हंसयुक्तं मनोजवम्।\nविमानं पुष्पकं दिव्यं नैर्ऋतैश्वर्यमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2068188, "chapter_id": 2430, "verse_number": "९-१६-३२", "content_sanskrit": "तत्राप्लुत्य बलो राजन्दत्त्वा दायांश्च पुष्कलान्।\nजगाम त्वरितो रामस्तीर्थं स्वेतानुलेपनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2068189, "chapter_id": 2430, "verse_number": "९-१६-३३", "content_sanskrit": "निषेवितं सर्वसत्वैर्नाम्ना बदरपाचनम्।\nनानर्तुकवनोपेतं सदा पुष्पफलं शुभम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2068190, "chapter_id": 2430, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि ह्रदप्रवेशपर्वणि अष्टचत्वारिंशोऽध्यायः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]