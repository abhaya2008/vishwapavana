[{"id": 7002656000, "chapter_id": 22656, "verse_number": "६-३४-१", "content_sanskrit": "सूत उवाच ।\nउज्जयिन्यां पुरा विप्र राजन्यः सर्वहिंसकः ।\nबभूव मद्यमांसाशी भीमवर्मेति विश्रुतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002656001, "chapter_id": 22656, "verse_number": "६-३४-२", "content_sanskrit": "मांसलोभेन स खलः सूकरान्ग्रामकुक्कुटान् ।\nहत्वा चाभक्षयत्पापी वेश्यासंगपरायणः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002656002, "chapter_id": 22656, "verse_number": "६-३४-३", "content_sanskrit": "नरमांसं स क्रव्यादस्त्यक्त्वान्यान्भक्षकोऽभवत् ।\nएवं बहुगते काले भीमवर्मा महाधमः ।\nविसूच्यग्निवशं यातो ममार च युवापि सः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002656003, "chapter_id": 22656, "verse_number": "६-३४-४", "content_sanskrit": "कारितश्चंडिकापाठस्तेन दुष्टेन भीरुणा ।\nतस्य पुण्यप्रभावेन नागतो नरकान्प्रति ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002656004, "chapter_id": 22656, "verse_number": "६-३४-५", "content_sanskrit": "पुनः क्षत्रत्वमगमन्मागधे स महीपतिः ।\nमहानन्दीति विख्यातो राजनीतिपरायणः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002656005, "chapter_id": 22656, "verse_number": "६-३४-६", "content_sanskrit": "जातिस्मरो बभूवासौ वेदधर्मपरायणः ।\nकात्यायनस्य शिष्योऽभून्महाशाक्तस्य धीमतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002656006, "chapter_id": 22656, "verse_number": "६-३४-७", "content_sanskrit": "तस्मै नृपाय स मुनिर्दत्त्वा मध्यचरित्रकम् ।\nसबीजं पुनरागत्य विन्ध्ये शक्ति परोऽभवत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002656007, "chapter_id": 22656, "verse_number": "६-३४-८", "content_sanskrit": "नृपोऽपि प्रत्यहं देवीं महालक्ष्मीं सनातनीम् ।\nरोचनाद्यैश्च संपूज्य जपन्मध्यचरित्रकम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002656008, "chapter_id": 22656, "verse_number": "६-३४-९", "content_sanskrit": "पुण्यक्षेत्रत्वमगमन्महामायाप्रसादतः ।\nशूद्रभावं परित्यज्य क्षत्रभावमुपागतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002656009, "chapter_id": 22656, "verse_number": "६-३४-१०", "content_sanskrit": "द्वादशाब्दांतरे प्राप्तस्तद्गुरुः शक्तितत्परः ।\nलक्षचण्डीं नृपादेव कारयामास धर्मतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002656010, "chapter_id": 22656, "verse_number": "६-३४-११", "content_sanskrit": "तदा प्रादुरभूद्देवी जगदंबा सनातनी ।\nनृपाय धर्ममर्थं च कामं मोक्षं हि चाददात् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002656011, "chapter_id": 22656, "verse_number": "६-३४-१२", "content_sanskrit": "महानन्दी महाभागो भुक्त्वा भोगं सुरेप्सितम् ।\nअन्ते जगाम परमं लोकं देवनमस्कृतम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002656012, "chapter_id": 22656, "verse_number": "६-३४-१३", "content_sanskrit": "इति ते कथिता विप्र यत्प्रोक्तं यजुषो गतिः ।\nसा वै मध्यचरित्रेण प्राप्ता शूद्रनृपेण वै ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002656013, "chapter_id": 22656, "verse_number": "६-३४-१४", "content_sanskrit": "इत्येवं वर्णितं विप्र माहात्म्यं मुनिवर्णितम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]