[{"id": 5000091000, "chapter_id": 9091, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे चतुर्दशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000091001, "chapter_id": 9091, "verse_number": "२-१४-१", "content_sanskrit": "पुत्रशोकार्दितं पापा विसंज्ञं पतितं भुवि।\nविचेष्टमानमुत्प्रेक्ष्य ऐक्ष्वाकमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000091002, "chapter_id": 9091, "verse_number": "२-१४-२", "content_sanskrit": "पापं कृत्वेव किमिदं मम संश्रुत्य संश्रवम्।\nशेषे क्षितितले सन्नः स्थित्यां स्थातुं त्वमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000091003, "chapter_id": 9091, "verse_number": "२-१४-३", "content_sanskrit": "आहुः सत्यं हि परमं धर्मं धर्मविदो जनाः।\nसत्यमाश्रित्य च मया त्वं धर्मं प्रतिचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000091004, "chapter_id": 9091, "verse_number": "२-१४-४", "content_sanskrit": "संश्रुत्य शैब्यः श्येनाय स्वां तनुं जगतीपतिः।\nप्रदाय पक्षिणे राजा जगाम गतिमुत्तमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000091005, "chapter_id": 9091, "verse_number": "२-१४-५", "content_sanskrit": "तथा ह्यलर्कस्तेजस्वी ब्राह्मणे वेदपारगे।\nयाचमाने स्वके नेत्रे उद‍्धृत्याविमना ददौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000091006, "chapter_id": 9091, "verse_number": "२-१४-६", "content_sanskrit": "सरितां तु पतिः स्वल्पां मर्यादां सत्यमन्वितः।\nसत्यानुरोधात् समये वेलां स्वां नातिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000091007, "chapter_id": 9091, "verse_number": "२-१४-७", "content_sanskrit": "सत्यमेकपदं ब्रह्म सत्ये धर्मः प्रतिष्ठितः।\nसत्यमेवाक्षया वेदाः सत्येनावाप्यते परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000091008, "chapter_id": 9091, "verse_number": "२-१४-८", "content_sanskrit": "सत्यं समनुवर्तस्व यदि धर्मे धृता मतिः।\nस वरः सफलो मेऽस्तु वरदो ह्यसि सत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000091009, "chapter_id": 9091, "verse_number": "२-१४-९", "content_sanskrit": "धर्मस्यैवाभिकामार्थं मम चैवाभिचोदनात्।\nप्रव्राजय सुतं रामं त्रिः खलु त्वां ब्रवीम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000091010, "chapter_id": 9091, "verse_number": "२-१४-१०", "content_sanskrit": "समयं च ममार्येमं यदि त्वं न करिष्यसि।\nअग्रतस्ते परित्यक्ता परित्यक्ष्यामि जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000091011, "chapter_id": 9091, "verse_number": "२-१४-११", "content_sanskrit": "एवं प्रचोदितो राजा कैकेय्या निर्विशङ्कया।\nनाशकत् पाशमुन्मोक्तुं बलिरिन्द्रकृतं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000091012, "chapter_id": 9091, "verse_number": "२-१४-१२", "content_sanskrit": "उद‍्भ्रान्तहृदयश्चापि विवर्णवदनोऽभवत्।\nस धुर्यो वै परिस्पन्दन् युगचक्रान्तरं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000091013, "chapter_id": 9091, "verse_number": "२-१४-१३", "content_sanskrit": "विकलाभ्यां च नेत्राभ्यामपश्यन्निव भूमिपः।\nकृच्छ्राद् धैर्येण संस्तभ्य कैकेयीमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000091014, "chapter_id": 9091, "verse_number": "२-१४-१४", "content_sanskrit": "यस्ते मन्त्रकृतः पाणिरग्नौ पापे मया धृतः।\nसंत्यजामि स्वजं चैव तव पुत्रं सह त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000091015, "chapter_id": 9091, "verse_number": "२-१४-१५", "content_sanskrit": "प्रयाता रजनी देवि सूर्यस्योदयनं प्रति।\nअभिषेकाय हि जनस्त्वरयिष्यति मां ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000091016, "chapter_id": 9091, "verse_number": "२-१४-१६", "content_sanskrit": "रामाभिषेकसम्भारैस्तदर्थमुपकल्पितैः।\nरामः कारयितव्यो मे मृतस्य सलिलक्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000091017, "chapter_id": 9091, "verse_number": "२-१४-१७", "content_sanskrit": "सपुत्रया त्वया नैव कर्तव्या सलिलक्रिया।\nव्याहन्तास्यशुभाचारे यदि रामाभिषेचनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000091018, "chapter_id": 9091, "verse_number": "२-१४-१८", "content_sanskrit": "न शक्तोऽद्यास्म्यहं द्रष्टुं दृष्ट्वा पूर्वं तथामुखम्।\nहतहर्षं तथानन्दं पुनर्जनमवाङ्मुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000091019, "chapter_id": 9091, "verse_number": "२-१४-१९", "content_sanskrit": "तां तथा ब्रुवतस्तस्य भूमिपस्य महात्मनः।\nप्रभाता शर्वरी पुण्या चन्द्रनक्षत्रमालिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000091020, "chapter_id": 9091, "verse_number": "२-१४-२०", "content_sanskrit": "ततः पापसमाचारा कैकेयी पार्थिवं पुनः।\nउवाच परुषं वाक्यं वाक्यज्ञा रोषमूर्च्छिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000091021, "chapter_id": 9091, "verse_number": "२-१४-२१", "content_sanskrit": "किमिदं भाषसे राजन् वाक्यं गररुजोपमम्।\nआनाययितुमक्लिष्टं पुत्रं राममिहार्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000091022, "chapter_id": 9091, "verse_number": "२-१४-२२", "content_sanskrit": "स्थाप्य राज्ये मम सुतं कृत्वा रामं वनेचरम्।\nनिःसपत्नां च मां कृत्वा कृतकृत्यो भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000091023, "chapter_id": 9091, "verse_number": "२-१४-२३", "content_sanskrit": "स तुन्न इव तीक्ष्णेन प्रतोदेन हयोत्तमः।\nराजा प्रचोदितोऽभीक्ष्णं कैकेय्या वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000091024, "chapter_id": 9091, "verse_number": "२-१४-२४", "content_sanskrit": "धर्मबन्धेन बद्धोऽस्मि नष्टा च मम चेतना।\nज्येष्ठं पुत्रं प्रियं रामं द्रष्टुमिच्छामि धार्मिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000091025, "chapter_id": 9091, "verse_number": "२-१४-२५", "content_sanskrit": "ततः प्रभातां रजनीमुदिते च दिवाकरे।\nपुण्ये नक्षत्रयोगे च मुहूर्ते च समागते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000091026, "chapter_id": 9091, "verse_number": "२-१४-२६", "content_sanskrit": "वसिष्ठो गुणसम्पन्नः शिष्यैः परिवृतस्तथा।\nउपगृह्याशु सम्भारान् प्रविवेश पुरोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000091027, "chapter_id": 9091, "verse_number": "२-१४-२७", "content_sanskrit": "सिक्तसम्मार्जितपथां पताकोत्तमभूषिताम्।\nसंहृष्टमनुजोपेतां समृद्धविपणापणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000091028, "chapter_id": 9091, "verse_number": "२-१४-२८", "content_sanskrit": "महोत्सवसमायुक्तां राघवार्थे समुत्सुकाम्।\nचन्दनागुरुधूपैश्च सर्वतः परिधूमिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000091029, "chapter_id": 9091, "verse_number": "२-१४-२९", "content_sanskrit": "तां पुरीं समतिक्रम्य पुरंदरपुरोपमाम्।\nददर्शान्तःपुरं श्रीमान् नानाध्वजगणायुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000091030, "chapter_id": 9091, "verse_number": "२-१४-३०", "content_sanskrit": "पौरजानपदाकीर्णं ब्राह्मणैरुपशोभितम्।\nयष्टिमद्भिः सुसम्पूर्णं सदश्वैः परमार्चितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000091031, "chapter_id": 9091, "verse_number": "२-१४-३१", "content_sanskrit": "तदन्तःपुरमासाद्य व्यतिचक्राम तं जनम्।\nवसिष्ठः परमप्रीतः परमर्षिभिरावृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000091032, "chapter_id": 9091, "verse_number": "२-१४-३२", "content_sanskrit": "स त्वपश्यद् विनिष्क्रान्तं सुमन्त्रं नाम सारथिम्।\nद्वारे मनुजसिंहस्य सचिवं प्रियदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000091033, "chapter_id": 9091, "verse_number": "२-१४-३३", "content_sanskrit": "तमुवाच महातेजाः सूतपुत्रं विशारदम्।\nवसिष्ठः क्षिप्रमाचक्ष्व नृपतेर्मामिहागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000091034, "chapter_id": 9091, "verse_number": "२-१४-३४", "content_sanskrit": "इमे गङ्गोदकघटाः सागरेभ्यश्च काञ्चनाः।\nऔदुम्बरं भद्रपीठमभिषेकार्थमाहृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000091035, "chapter_id": 9091, "verse_number": "२-१४-३५", "content_sanskrit": "सर्वबीजानि गन्धाश्च रत्नानि विविधानि च।\nक्षौद्रं दधि घृतं लाजा दर्भाः सुमनसः पयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000091036, "chapter_id": 9091, "verse_number": "२-१४-३६", "content_sanskrit": "अष्टौ च कन्या रुचिरा मत्तश्च वरवारणः।\nचतुरश्वो रथः श्रीमान् निस्त्रिंशो धनुरुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000091037, "chapter_id": 9091, "verse_number": "२-१४-३७", "content_sanskrit": "वाहनं नरसंयुक्तं छत्रं च शशिसंनिभम्।\nश्वेते च वालव्यजने भृङ्गारं च हिरण्मयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000091038, "chapter_id": 9091, "verse_number": "२-१४-३८", "content_sanskrit": "हेमदामपिनद्धश्च ककुद्मान् पाण्डुरो वृषः।\nकेसरी च चतुर्दंष्ट्रो हरिश्रेष्ठो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000091039, "chapter_id": 9091, "verse_number": "२-१४-३९", "content_sanskrit": "सिंहासनं व्याघ्रतनुः समिधश्च हुताशनः।\nसर्वे वादित्रसङ्घाश्च वेश्याश्चालंकृताः स्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000091040, "chapter_id": 9091, "verse_number": "२-१४-४०", "content_sanskrit": "आचार्या ब्राह्मणा गावः पुण्याश्च मृगपक्षिणः।\nपौरजानपदश्रेष्ठा नैगमाश्च गणैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000091041, "chapter_id": 9091, "verse_number": "२-१४-४१", "content_sanskrit": "एते चान्ये च बहवः प्रीयमाणाः प्रियंवदाः।\nअभिषेकाय रामस्य सह तिष्ठन्ति पार्थिवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000091042, "chapter_id": 9091, "verse_number": "२-१४-४२", "content_sanskrit": "त्वरयस्व महाराजं यथा समुदितेऽहनि।\nपुष्ये नक्षत्रयोगे च रामो राज्यमवाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000091043, "chapter_id": 9091, "verse_number": "२-१४-४३", "content_sanskrit": "इति तस्य वचः श्रुत्वा सूतपुत्रो महाबलः।\nस्तुवन् नृपतिशार्दूलं प्रविवेश निवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000091044, "chapter_id": 9091, "verse_number": "२-१४-४४", "content_sanskrit": "तं तु पूर्वोदितं वृद्धं द्वारस्था राजसम्मताः।\nन शेकुरभिसंरोद्धुं राज्ञः प्रियचिकीर्षवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000091045, "chapter_id": 9091, "verse_number": "२-१४-४५", "content_sanskrit": "स समीपस्थितो राज्ञस्तामवस्थामजज्ञिवान्।\nवाग्भिः परमतुष्टाभिरभिष्टोतुं प्रचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000091046, "chapter_id": 9091, "verse_number": "२-१४-४६", "content_sanskrit": "ततः सूतो यथापूर्वं पार्थिवस्य निवेशने।\nसुमन्त्रः प्राञ्जलिर्भूत्वा तुष्टाव जगतीपतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000091047, "chapter_id": 9091, "verse_number": "२-१४-४७", "content_sanskrit": "यथा नन्दति तेजस्वी सागरो भास्करोदये।\nप्रीतः प्रीतेन मनसा तथा नन्दय नस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000091048, "chapter_id": 9091, "verse_number": "२-१४-४८", "content_sanskrit": "इन्द्रमस्यां तु वेलायामभितुष्टाव मातलिः।\nसोऽजयद् दानवान् सर्वांस्तथा त्वां बोधयाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000091049, "chapter_id": 9091, "verse_number": "२-१४-४९", "content_sanskrit": "वेदाः सहाङ्गा विद्याश्च यथा ह्यात्मभुवं प्रभुम्।\nब्रह्माणं बोधयन्त्यद्य तथा त्वां बोधयाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000091050, "chapter_id": 9091, "verse_number": "२-१४-५०", "content_sanskrit": "आदित्यः सह चन्द्रेण यथा भूतधरां शुभाम्।\nबोधयत्यद्य पृथिवीं तथा त्वां बोधयाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000091051, "chapter_id": 9091, "verse_number": "२-१४-५१", "content_sanskrit": "उत्तिष्ठ सुमहाराज कृतकौतुकमङ्गलः।\nविराजमानो वपुषा मेरोरिव दिवाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000091052, "chapter_id": 9091, "verse_number": "२-१४-५२", "content_sanskrit": "सोमसूर्यौ च काकुत्स्थ शिववैश्रवणावपि।\nवरुणश्चाग्निरिन्द्रश्च विजयं प्रदिशन्तु ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000091053, "chapter_id": 9091, "verse_number": "२-१४-५३", "content_sanskrit": "गता भगवती रात्रिः कृतं कृत्यमिदं तव।\nबुध्यस्व नृपशार्दूल कुरु कार्यमनन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000091054, "chapter_id": 9091, "verse_number": "२-१४-५४", "content_sanskrit": "उदतिष्ठत रामस्य समग्रमभिषेचनम्।\nपौरजानपदाश्चापि नैगमश्च कृताञ्जलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000091055, "chapter_id": 9091, "verse_number": "२-१४-५५", "content_sanskrit": "स्वयं वसिष्ठो भगवान् ब्राह्मणैः सह तिष्ठति।\nक्षिप्रमाज्ञाप्यतां राजन् राघवस्याभिषेचनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000091056, "chapter_id": 9091, "verse_number": "२-१४-५६", "content_sanskrit": "यथा ह्यपालाः पशवो यथा सेना ह्यनायका।\nयथा चन्द्रं विना रात्रिर्यथा गावो विना वृषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000091057, "chapter_id": 9091, "verse_number": "२-१४-५७", "content_sanskrit": "एवं हि भविता राष्ट्रं यत्र राजा न दृश्यते।\nएवं तस्य वचः श्रुत्वा सान्त्वपूर्वमिवार्थवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000091058, "chapter_id": 9091, "verse_number": "२-१४-५८", "content_sanskrit": "अभ्यकीर्यत शोकेन भूय एव महीपतिः।\nततस्तु राजा तं सूतं सन्नहर्षः सुतं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000091059, "chapter_id": 9091, "verse_number": "२-१४-५९", "content_sanskrit": "शोकरक्तेक्षणः श्रीमानुद्वीक्ष्योवाच धार्मिकः।\nवाक्यैस्तु खलु मर्माणि मम भूयो निकृन्तसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000091060, "chapter_id": 9091, "verse_number": "२-१४-६०", "content_sanskrit": "सुमन्त्रः करुणं श्रुत्वा दृष्ट्वा दीनं च पार्थिवम्।\nप्रगृहीताञ्जलिः किंचित् तस्माद् देशादपाक्रमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000091061, "chapter_id": 9091, "verse_number": "२-१४-६१", "content_sanskrit": "यदा वक्तुं स्वयं दैन्यान्न शशाक महीपतिः।\nतदा सुमन्त्रं मन्त्रज्ञा कैकेयी प्रत्युवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000091062, "chapter_id": 9091, "verse_number": "२-१४-६२", "content_sanskrit": "सुमन्त्र राजा रजनीं रामहर्षसमुत्सुकः।\nप्रजागरपरिश्रान्तो निद्रावशमुपागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000091063, "chapter_id": 9091, "verse_number": "२-१४-६३", "content_sanskrit": "तद् गच्छ त्वरितं सूत राजपुत्रं यशस्विनम्।\nराममानय भद्रं ते नात्र कार्या विचारणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000091064, "chapter_id": 9091, "verse_number": "२-१४-६४", "content_sanskrit": "अश्रुत्वा राजवचनं कथं गच्छामि भामिनि।\nतच्छ्रुत्वा मन्त्रिणो वाक्यं राजा मन्त्रिणमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000091065, "chapter_id": 9091, "verse_number": "२-१४-६५", "content_sanskrit": "सुमन्त्र रामं द्रक्ष्यामि शीघ्रमानय सुन्दरम्।\nस मन्यमानः कल्याणं हृदयेन ननन्द च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000091066, "chapter_id": 9091, "verse_number": "२-१४-६६", "content_sanskrit": "निर्जगाम च स प्रीत्या त्वरितो राजशासनात्।\nसुमन्त्रश्चिन्तयामास त्वरितं चोदितस्तया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000091067, "chapter_id": 9091, "verse_number": "२-१४-६७", "content_sanskrit": "व्यक्तं रामाभिषेकार्थे इहायास्यति धर्मराट्।\nइति सूतो मतिं कृत्वा हर्षेण महता पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000091068, "chapter_id": 9091, "verse_number": "२-१४-६८", "content_sanskrit": "निर्जगाम महातेजा राघवस्य दिदृक्षया।\nसागरह्रदसंकाशात्सुमन्त्रोऽन्तःपुराच्छुभात्।\nनिष्क्रम्य जनसम्बाधं ददर्श द्वारमग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000091069, "chapter_id": 9091, "verse_number": "२-१४-६९", "content_sanskrit": "ततः पुरस्तात् सहसा विनिःसृतो\nमहीपतेर्द्वारगतान् विलोकयन्।\nददर्श पौरान् विविधान् महाधना-\nनुपस्थितान् द्वारमुपेत्य विष्ठितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 5000091070, "chapter_id": 9091, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे चतुर्दशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]