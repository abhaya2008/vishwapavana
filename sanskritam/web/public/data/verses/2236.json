[{"id": 2057002, "chapter_id": 2236, "verse_number": "७-१६३-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2057003, "chapter_id": 2236, "verse_number": "७-१६३-१", "content_sanskrit": "सोमदत्तं तु सम्प्रेक्ष्य विधुन्वानं महद्धनुः।\nसात्यकिः प्राह यन्तारं सोमदत्ताय मां वह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2057004, "chapter_id": 2236, "verse_number": "७-१६३-२", "content_sanskrit": "न ह्यहत्वा रणे शत्रुं सोमदत्तं महाबलम्।\nनिवर्तिष्ये रणात्सूत सत्यमेतद्वचो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2057005, "chapter_id": 2236, "verse_number": "७-१६३-३", "content_sanskrit": "ततः सम्प्रैषयद्यन्ता सैन्धवांस्तान्मनोजवान्।\nतुरङ्गामाञ्छङ्खवर्णान्सर्वशब्दातिगान्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2057006, "chapter_id": 2236, "verse_number": "७-१६३-४", "content_sanskrit": "तेऽवहन्युयुधानं तु मनोमारुतरंहसः।\nयथेन्द्रं हरयो राजन्पुरा दैत्यवधोद्यतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2057007, "chapter_id": 2236, "verse_number": "७-१६३-५", "content_sanskrit": "तमापतन्तं सम्प्रेक्ष्य सात्वतं रभसं रणे।\nसोमदत्तो महाबाहुरसम्भ्रान्तो न्यवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2057008, "chapter_id": 2236, "verse_number": "७-१६३-६", "content_sanskrit": "विमुञ्चञ्छरवर्षाणि पर्जन्य इव वृष्टिमान्।\nछादयामास शैनेयं जलदो भास्करं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2057009, "chapter_id": 2236, "verse_number": "७-१६३-७", "content_sanskrit": "असम्भ्रान्तश्च समरे सात्यकिः कुरुपुङ्गवम्।\nछादयामास बाणौघैः समन्ताद्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2057010, "chapter_id": 2236, "verse_number": "७-१६३-८", "content_sanskrit": "सोमदत्तस्तुतं षष्ट्या विव्याधोरसि माधवम्।\nसात्यकिश्चापि तं राजन्नविध्यत्सायकैः शितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2057011, "chapter_id": 2236, "verse_number": "७-१६३-९", "content_sanskrit": "तावन्योन्यं शरैः कृत्तौ व्यराजेतां नरर्षभौ।\nसुपुष्पौ पुष्पसमये पुष्पिताविव किंशकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2057012, "chapter_id": 2236, "verse_number": "७-१६३-१०", "content_sanskrit": "रुधिरोक्षितसर्वाङ्गौ कुरुवृष्णियशस्करौ।\nपरस्परमवेक्षेतां दहन्ताविव लोचनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2057013, "chapter_id": 2236, "verse_number": "७-१६३-११", "content_sanskrit": "रथमण्डलमार्गेषु चरन्तावरिमर्दनौ।\nघोररूपौ हितावास्तां वृष्टिमन्ताविवाम्बुदौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2057014, "chapter_id": 2236, "verse_number": "७-१६३-१२", "content_sanskrit": "शरसम्भिन्नगात्रौ तु सर्वतः शखलीकृतौ।\nश्वाविधाविव राजेन्द्र दृश्येतां शरविक्षतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2057015, "chapter_id": 2236, "verse_number": "७-१६३-१३", "content_sanskrit": "सुवर्णपुङ्खैरिषुभिराचितौ तौ व्यराजताम्।\nखद्योतैरावृतौ राजन्प्रावृषीव वनस्पती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2057016, "chapter_id": 2236, "verse_number": "७-१६३-१४", "content_sanskrit": "सम्प्रदीपितसर्वाङ्गौ सायकैस्तैर्महारथौ।\nअदृश्येतां रणे क्रुद्धावुल्काभिरिव कुञ्जरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2057017, "chapter_id": 2236, "verse_number": "७-१६३-१५", "content_sanskrit": "ततो युधि महारज सोमदत्तो महारथः।\nअर्धचन्द्रेम चिच्छेद माधवस्य महद्धनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2057018, "chapter_id": 2236, "verse_number": "७-१६३-१६", "content_sanskrit": "अथैनं पञ्चविंशत्या सायकानां समार्पयत्।\nत्वरमाणस्त्वराकाले पुनश्च दशभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2057019, "chapter_id": 2236, "verse_number": "७-१६३-१७", "content_sanskrit": "अथान्यद्धनुरादाय सात्यकिर्वेगवत्तरम्।\nपञ्चभिः सायकैस्तूर्णं सोमदत्तमविध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2057020, "chapter_id": 2236, "verse_number": "७-१६३-१८", "content_sanskrit": "ततोऽपरेण भल्लेन ध्वजं चिच्छेद काञ्चनम्।\nबाह्लीकस्य रणे राजन्सात्यकिः प्रहसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2057021, "chapter_id": 2236, "verse_number": "७-१६३-१९", "content_sanskrit": "सोमदत्तस्त्वसम्भ्रान्तो दृष्ट्वा केतुं निपातितम्।\nशैनेयं पञ्चविंशत्या सायकानां समाचिनोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2057022, "chapter_id": 2236, "verse_number": "७-१६३-२०", "content_sanskrit": "सात्वतोऽपि रणे क्रुद्धः सोमदत्तस्य धन्विनः।\nधनुश्छिच्छेद भल्लेन क्षुरप्रेण शितेन ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2057023, "chapter_id": 2236, "verse_number": "७-१६३-२१", "content_sanskrit": "अथैनं रुक्मपुङ्खानां शतेन नतपर्वणाम्।\nआचिनोद्बहुधा राजन्भग्नदंष्ट्रमिव द्विपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2057024, "chapter_id": 2236, "verse_number": "७-१६३-२२", "content_sanskrit": "अथान्यद्धनुरादाय सोमदत्तो महारथः।\nसात्यकिं छादयामास शरवृष्ट्या महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2057025, "chapter_id": 2236, "verse_number": "७-१६३-२३", "content_sanskrit": "सोमदत्तं तु सङ्क्रुद्धो रणे विव्याध सात्यकिः।\nसात्यकिं शरजालेन सोमदत्तोऽप्यपीडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2057026, "chapter_id": 2236, "verse_number": "७-१६३-२४", "content_sanskrit": "दशभिः सात्वतस्यार्थे भीमोऽहन्बाह्लिकात्मजम्।\nसोमदत्तोप्यसम्भ्रान्तो भीममार्च्छच्छितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2057027, "chapter_id": 2236, "verse_number": "७-१६३-२५", "content_sanskrit": "ततस्तु सात्वतस्यार्थे भीमसेनो नवं दृढम्।\nमुमोच परिघं घोरं सोमदत्तस्य वक्षसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2057028, "chapter_id": 2236, "verse_number": "७-१६३-२६", "content_sanskrit": "तमापतन्तं वेगेन परिघं घोरदर्शनम्।\nद्विधा चिच्छेद समरे प्रहसन्निव कौरवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2057029, "chapter_id": 2236, "verse_number": "७-१६३-२७", "content_sanskrit": "स पपात द्विधा च्छिन्न आयसः परिघो महान्।\nमहीधरस्येव महच्छिखरं वज्रदारितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2057030, "chapter_id": 2236, "verse_number": "७-१६३-२८", "content_sanskrit": "ततस्तु सात्यकी राजन्सोमदत्तस्य संयुगे।\nधनुश्चिच्छेद भल्लेन हस्तावापं च पञ्चभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2057031, "chapter_id": 2236, "verse_number": "७-१६३-२९", "content_sanskrit": "ततश्चतुर्भिश्च शरैस्तूर्णं तांस्तुरगोत्तमान्।\nसमीपं प्रेषयामास प्रेतराजस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2057032, "chapter_id": 2236, "verse_number": "७-१६३-३०", "content_sanskrit": "सारथेश्च शिरः कायाद्भल्लेन नतपर्वणा।\nजहार नरशार्दूलः प्रहसञ्छिनिपुङ्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2057033, "chapter_id": 2236, "verse_number": "७-१६३-३१", "content_sanskrit": "ततः शरं महाघोरं ज्वलन्तमिव पावकम्।\nमुमोच सात्वतो राजन्स्वर्णपुङ्गं शिलाशितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2057034, "chapter_id": 2236, "verse_number": "७-१६३-३२", "content_sanskrit": "स विमुक्तो बलवता शैनेयेन शरोत्तमः।\nघोरस्तस्योरसि विभो निपपाताशु भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2057035, "chapter_id": 2236, "verse_number": "७-१६३-३३", "content_sanskrit": "सोऽतिविद्धो महाराज सात्वतेन महारथः।\nसोमदत्तो महाबाहुर्निपपात ममार च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2057036, "chapter_id": 2236, "verse_number": "७-१६३-३४", "content_sanskrit": "तं दृष्ट्वा निहतं तत्र सोमदत्तं महारथाः।\nमहता शरवर्षेण युयुधानमुपाद्रवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2057037, "chapter_id": 2236, "verse_number": "७-१६३-३५", "content_sanskrit": "छाद्यमानं शरैर्दृष्ट्वा युयुधानं युधिष्ठिरः।\nपाण्डवाश्च महाराज सह सर्वैः प्रभद्रकैः।\nमहत्या सेनया सार्धं द्रोणानीकमुपाद्रवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2057038, "chapter_id": 2236, "verse_number": "७-१६३-३६", "content_sanskrit": "ततो युधिष्ठिरः क्रुद्धस्तावकानां महाबलम्।\nशरैर्विद्रावयामास भारद्वाजस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2057039, "chapter_id": 2236, "verse_number": "७-१६३-३७", "content_sanskrit": "सैन्यानि द्रावयन्तं तु द्रोणो दृष्ट्वा युधिष्ठिरम्।\nअभिदुद्राव वेगेन क्रोधसंरक्तलोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2057040, "chapter_id": 2236, "verse_number": "७-१६३-३८", "content_sanskrit": "ततः सुनिशितैर्बाणैः पार्थं विव्याध सप्तभिः।\nयुधिष्ठिरोऽपि सङ्क्रुद्धः प्रतिविव्याध पञ्चभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2057041, "chapter_id": 2236, "verse_number": "७-१६३-३९", "content_sanskrit": "सोऽतिविद्धो महाबाहुः सृक्विणी परिसंलिहन्।\nयुधिष्ठिरस्य चिच्छेद ध्वजं कार्मुकमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2057042, "chapter_id": 2236, "verse_number": "७-१६३-४०", "content_sanskrit": "स च्छिन्नधन्वा त्वरितस्त्वराकाले नृपोत्तमः।\nअन्यदादत्त वेगेन कार्मुकं समरे दृढम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2057043, "chapter_id": 2236, "verse_number": "७-१६३-४१", "content_sanskrit": "ततः शरसहस्रेण द्रोणं विव्याध पार्थिवः।\nसाश्वसूतध्वजरथं तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2057044, "chapter_id": 2236, "verse_number": "७-१६३-४२", "content_sanskrit": "ततो मुहूर्तं व्यथितः शरपातप्रपीडितः।\nनिषसाद रथोपस्थे द्रोणो भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2057045, "chapter_id": 2236, "verse_number": "७-१६३-४३", "content_sanskrit": "प्रतिलभ्य ततः संज्ञां मुहूर्ताद्द्विजसत्तमः।\nक्रोधेन महताऽऽविष्टो वायव्यास्त्रमवासृजत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2057046, "chapter_id": 2236, "verse_number": "७-१६३-४४", "content_sanskrit": "असम्भ्रान्तस्ततः पार्थो वायव्येनैव वीर्यवान्।\nतदस्त्रमस्त्रेण रणे स्तम्भयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2057047, "chapter_id": 2236, "verse_number": "७-१६३-४५", "content_sanskrit": "चिच्छेद च धनुर्दीर्घं ब्राह्मणस्य च पाण्डवः।\nततोऽन्यद्धनुरादत्त द्रोणः क्षत्रियमर्दनः।\nतदप्यस्य शितैर्भल्लैश्चिच्छेद कुरुपुङ्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2057048, "chapter_id": 2236, "verse_number": "७-१६३-४६", "content_sanskrit": "ततोऽब्रवीद्वासुदेवः कुन्तीपुत्रं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2057049, "chapter_id": 2236, "verse_number": "७-१६३-४७", "content_sanskrit": "युधिष्ठिर महाबाहो यत्त्वां वक्ष्यामि तच्छ्रणु।\nउपारमस्व युद्धे त्वं द्रोणाद्भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2057050, "chapter_id": 2236, "verse_number": "७-१६३-४८", "content_sanskrit": "यतते हि सदा द्रोणो ग्रहणे तव संयुगे।\nनानुरूपमहं मन्ये युद्धमस्य त्वया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2057051, "chapter_id": 2236, "verse_number": "७-१६३-४९", "content_sanskrit": "योऽस्य सृष्टो विनाशाय स एवैनं हनिष्यति।\nपरिवर्ज्य गुरुं याहि यत्र राजा सुयोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2057052, "chapter_id": 2236, "verse_number": "७-१६३-५०", "content_sanskrit": "राजा राज्ञा हि योद्धव्यो नाराज्ञा युद्धमिष्यते।\nतत्र त्वं गच्छ कौन्तेय हस्त्यश्वरथसंवृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2057053, "chapter_id": 2236, "verse_number": "७-१६३-५१", "content_sanskrit": "यावन्मात्रेण च मया सहायेन धनञ्जयः।\nभीमश्च रथशार्दूलो युध्यते कौरवैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2057054, "chapter_id": 2236, "verse_number": "७-१६३-५२", "content_sanskrit": "वासुदेववचः श्रुत्वा धर्मराजो युधिष्ठिरः।\nमुहूर्तं चिन्तयित्वा तु ततो दारुणमाहवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2057055, "chapter_id": 2236, "verse_number": "७-१६३-५३", "content_sanskrit": "प्रायाद्द्रुतममित्रघ्नो यत्र भीमो व्यवस्थितः।\nविनिघ्नंस्तावकान्योधान्व्यादितास्य इवान्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2057056, "chapter_id": 2236, "verse_number": "७-१६३-५४", "content_sanskrit": "रथघोषेण महता नादयन्वसुधातलम्।\nपर्जन्य इव धर्मान्ते नादयन्वै दिशो दश।\nभीमस्य निघ्नतः शत्रून्पार्ष्णिं जाग्रह पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2057057, "chapter_id": 2236, "verse_number": "७-१६३-५५", "content_sanskrit": "द्रोणोऽपि पाण्डुपाञ्चालान्व्यधमद्रजनीमुखे।\n`नादयंस्तलघोषेण तव सैन्यानि मारिष॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2057058, "chapter_id": 2236, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि घटोत्कचवधपर्वणि चतुर्दशरात्रियुद्धे त्रिषष्ट्यधिकशततमोऽध्यायः॥ १६३ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१६३-१८ बाह्लीकस्य सोमदत्तस्य॥ ५-१६३-१६३ त्रिषष्ठ्यधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]