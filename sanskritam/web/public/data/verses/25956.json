[{"id": 7005956000, "chapter_id": 25956, "verse_number": "१-१३९-१", "content_sanskrit": "हरिरुवाच । सूर्यस्य कथितो वंशः सोमवंशं शृणुष्व मे ।\nनारायणसुतो ब्रह्मा ब्रह्मणोऽत्रेः समुद्भवः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005956001, "chapter_id": 25956, "verse_number": "१-१३९-२", "content_sanskrit": "अत्रेः सोमस्तस्य भार्या तारा सुरगुरोः प्रया ।\nसोमात्तरा बुधं जज्ञे बुधपुत्रः पुरूरवाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005956002, "chapter_id": 25956, "verse_number": "१-१३९-३", "content_sanskrit": "बुधपुत्रादथोर्वश्यां षट्पुत्रास्तु श्रुतत्मकः ।\nविश्वावसुः शतायुश्च आयुर्धोमानमावसुः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005956003, "chapter_id": 25956, "verse_number": "१-१३९-४", "content_sanskrit": "अमावसोर्भोमनामा भीमपुत्रश्च काञ्चनः ।\nकाञ्चनस्य सुहोत्रोऽभूज्जह्रुश्चाभूत्सुहोत्रतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005956004, "chapter_id": 25956, "verse_number": "१-१३९-५", "content_sanskrit": "जह्नोः सुमन्तुरभवत्सुमन्तोरपजापकः ।\nबलाकाश्वस्तस्य पुत्रो बलाकाश्वात्कुशः स्मृतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005956005, "chapter_id": 25956, "verse_number": "१-१३९-६", "content_sanskrit": "कुशाश्वः कुशनाभश्चामूर्तरयो वसुः कुशात् ।\nगाधिः कुशाश्वात्संजज्ञे विश्वामित्रस्तदात्मजः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005956006, "chapter_id": 25956, "verse_number": "१-१३९-७", "content_sanskrit": "कन्या सत्यवती दत्ता ऋचीकाय द्विजाय स ।\nऋचीकाज्जमदाग्निश्च रामस्तस्याभवत्सुतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005956007, "chapter_id": 25956, "verse_number": "१-१३९-८", "content_sanskrit": "विश्वामित्राद्देवरातमदुच्छन्दादयः सुताः। ।\nआयुषो नहुषस्तस्मादनेना रजिरम्भकौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005956008, "chapter_id": 25956, "verse_number": "१-१३९-९", "content_sanskrit": "क्षत्त्रवृद्धः क्षत्त्रवृद्धात्सुहोत्रश्चभवन्नृपः ।\nकाश्यकाशौगृत्समदः सुहोत्रादभवंस्त्रयः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005956009, "chapter_id": 25956, "verse_number": "१-१३९-१०", "content_sanskrit": "गृत्समदाच्छौन कोऽभूत्काश्याद्दीर्घतमास्तथा ।\nवैद्यो धन्वन्तरिस्तस्मात्केतुमांश्च तदात्मजः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005956010, "chapter_id": 25956, "verse_number": "१-१३९-११", "content_sanskrit": "भीमरथः केतुमतो दिवोदासस्तदात्मजः ।\nदिवोदासात्प्रतर्दनः शत्रुजित्सोऽत्र विश्रुतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005956011, "chapter_id": 25956, "verse_number": "१-१३९-१२", "content_sanskrit": "ऋतध्वजस्तस्य पुत्रो ह्यलर्कश्च ऋतध्वजत ।\nअलर्कात्सन्नतिर्जज्ञे सुनीतः सन्नतेः सुतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005956012, "chapter_id": 25956, "verse_number": "१-१३९-१३", "content_sanskrit": "सत्यकेतुः सुनीतस्य सत्यकेतोर्विभुः सुतः ।\nविभोस्तु सुविभुः पुत्रः सुविभोः सुकुमारकः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005956013, "chapter_id": 25956, "verse_number": "१-१३९-१४", "content_sanskrit": "सुकुमाराद्धृष्टकेतुर्वोतिहोत्रस्तदात्मजः ।\nवीतिहोत्रस्य भर्गोऽभूद्भर्गभूमिस्तदात्मजः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005956014, "chapter_id": 25956, "verse_number": "१-१३९-१५", "content_sanskrit": "वैष्णवाः स्युर्महात्मान इत्येते काशयो नृपा। ।\nपञ्चपुत्रशतान्यासन्रजेः शक्रेण संहृताः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005956015, "chapter_id": 25956, "verse_number": "१-१३९-१६", "content_sanskrit": "प्रतिक्षत्त्रः क्षत्त्रवृद्धात्संजयश्च दात्मजः ।\nविजयः संजयस्यापि विजयस्य कृतः सुतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005956016, "chapter_id": 25956, "verse_number": "१-१३९-१७", "content_sanskrit": "कृताद्वृषधनश्चाभूत्सहदेवस्तदात्मजः ।\nसहदेवाददीनोऽभूज्जयत्सेनोऽप्यदीनतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005956017, "chapter_id": 25956, "verse_number": "१-१३९-१८", "content_sanskrit": "जयत्सेनात्संकृतिश्च क्षत्त्रधर्मा च सकतेः ।\nयतिर्ययातिः संयातिरयातिर्विकृतिः क्रमात् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005956018, "chapter_id": 25956, "verse_number": "१-१३९-१९", "content_sanskrit": "नहुषस्य सुताः ख्याता ययातेर्नृपतेस्तथा ।\nयदुं च तुर्वसुं चैव देवयानी व्यजायत ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005956019, "chapter_id": 25956, "verse_number": "१-१३९-२०", "content_sanskrit": "द्रुह्युं चानुं च पूरुञ्च शर्मिष्ठा वार्षपारणी ।\nसहस्रजीत्क्रोष्टुमना रघुश्चैव यदोः सुताः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005956020, "chapter_id": 25956, "verse_number": "१-१३९-२१", "content_sanskrit": "सहस्रजितः शतजित्तस्माद्वै हयहैहयौ ।\nअनरण्यो हयात्पुत्रो धर्मो हैहयतोऽभवत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005956021, "chapter_id": 25956, "verse_number": "१-१३९-२२", "content_sanskrit": "धर्मस्य धर्मनेत्रोऽबूत्कुन्तिर्वै धर्मनेत्त ।\nकुन्तेर्बभूत साहञ्जिर्महिष्मांश्च तदात्मजः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005956022, "chapter_id": 25956, "verse_number": "१-१३९-२३", "content_sanskrit": "भद्रश्रेण्यस्तस्य पुत्त्रो भद्रश्रेणयस दुर्दमः ।\nधनको दुर्दमाच्चैव कृतवीर्यश्च जानकिः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005956023, "chapter_id": 25956, "verse_number": "१-१३९-२४", "content_sanskrit": "कृताग्निः कृतकर्मा च कृतौजाः सुमहाबलः ।\nकृतवीर्यादर्जुनोऽभूदर्जुनाच्छूरसेनकः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005956024, "chapter_id": 25956, "verse_number": "१-१३९-२५", "content_sanskrit": "जयध्वजो मधुः शूरो वृषणः पञ्च सव्रता। ।\nजयध्वजात्तालजङ्घो भरतस्तालजङ्गतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005956025, "chapter_id": 25956, "verse_number": "१-१३९-२६", "content_sanskrit": "वृषणस्य मधुः पुत्त्रो मधोर्वृष्ण्यादिवंशकः ।\nक्रोष्टोर्विजज्ञिवान्पुत्त्र आहिस्तस्य महात्मनः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005956026, "chapter_id": 25956, "verse_number": "१-१३९-२७", "content_sanskrit": "आहेरुशङ्कुः संजज्ञेतस्य चित्ररथः सतः ।\nशशबिन्दुश्चित्ररथात्पत्न्यो लक्षञ्च तस्य ह ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005956027, "chapter_id": 25956, "verse_number": "१-१३९-२८", "content_sanskrit": "दशलक्षञ्च पुत्राणां पृथुकीर्त्यादयो रा ।\nपृथुकीर्तिः पृथुजयः पृथुदानः पृथुश्रवाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005956028, "chapter_id": 25956, "verse_number": "१-१३९-२९", "content_sanskrit": "पृथुश्रवसोऽभूत्तम उशनास्तमसोऽभवत् ।\nतत्पुत्रः शितगुर्नाम श्रीरुक्मकवचस्ततः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005956029, "chapter_id": 25956, "verse_number": "१-१३९-३०", "content_sanskrit": "रुक्मश्च पृथुरुक्मश्च ज्यामघः पालितो हरिः ।\nश्रीरुक्मकवचस्यैते विदर्भो ज्यामघात्तथा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005956030, "chapter_id": 25956, "verse_number": "१-१३९-३१", "content_sanskrit": "भार्यायाञ्चैव शैब्यायां विदर्भात्क्रथकौशिकौ ।\nरोमपादो रोमपादाद्बभ्रुर्बभ्रोर्धृतिस्तथा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005956031, "chapter_id": 25956, "verse_number": "१-१३९-३२", "content_sanskrit": "कौशिकस्य ऋचिः पुत्रः ततश्चैद्यो नृपः किल ।\nकुन्तिः किलास्य पुत्रोऽभूत्कुन्तेर्वृष्णिः सुतः स्मृतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005956032, "chapter_id": 25956, "verse_number": "१-१३९-३३", "content_sanskrit": "वृष्णेश्च निवृतिः पुत्रो दशार्हे निवृतेस्तथा ।\nदशार्हस्य सुतो व्योमा जीमूतश्च तदात्मजः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005956033, "chapter_id": 25956, "verse_number": "१-१३९-३४", "content_sanskrit": "जीमूताद्विकृतिर्जज्ञे ततो भीमरथोऽभवत् ।\nततो मधुरथो जज्ञे शकुनिस्तस्य चात्मजः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005956034, "chapter_id": 25956, "verse_number": "१-१३९-३५", "content_sanskrit": "करम्भिः शकुनेः पुत्रस्तस्य वै देववान्स्मृतः ।\nदेवक्षत्त्रो देवनतो देवक्षत्त्रान्मधुः स्मृतः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005956035, "chapter_id": 25956, "verse_number": "१-१३९-३६", "content_sanskrit": "कुरुवंशो मधोः पुत्रो ह्यनुश्च कुरुवंशतः ।\nपुरुहोत्रो ह्यनोः पुत्रो ह्यंशुश्च पुरुहोत्रतः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005956036, "chapter_id": 25956, "verse_number": "१-१३९-३७", "content_sanskrit": "सत्त्वश्रुतः सुतश्चांशोस्ततो वै सात्त्वतनृपः ।\nभजिनो भजमानश्च सात्वतादन्धकः सुतः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005956037, "chapter_id": 25956, "verse_number": "१-१३९-३८", "content_sanskrit": "महाभोजो वृष्णि दिव्यावन्यो देवावृधोऽत् ।\nनिमिवृष्णी भजमानादयुताजित्तथैव च ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005956038, "chapter_id": 25956, "verse_number": "१-१३९-३९", "content_sanskrit": "शतजिच्च सहस्राजिद्बभ्रुर्देवो बृहस्पतिः ।\nमहाभोजात्तु भोजोऽभूत्तद्वृष्णेश्च सुमित्रकः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005956039, "chapter_id": 25956, "verse_number": "१-१३९-४०", "content_sanskrit": "स्वधाजित्संज्ञकस्तस्मादनमित्राशिनी तथा ।\nअनमित्रस्य निघ्नोऽभून्निघ्नाच्छत्राजितोऽभवत् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005956040, "chapter_id": 25956, "verse_number": "१-१३९-४१", "content_sanskrit": "प्रसेनश्चापरः ख्यातो ह्यनमित्राच्छिबिस्तथा ।\nशिबेस्तु सत्यकः पुत्रः सत्यकात्सात्यकिस्तथा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005956041, "chapter_id": 25956, "verse_number": "१-१३९-४२", "content_sanskrit": "सात्यकेः सञ्जयः पुत्रः कुलिश्चैव तदात्मजः ।\nकुलेर्युगन्धरः पुत्रस्ते शैबेयाः प्रकीर्तिताः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005956042, "chapter_id": 25956, "verse_number": "१-१३९-४३", "content_sanskrit": "अनमित्रान्वये वृष्णिः श्वफल्कश्चित्रकः सुतः ।\nश्वफल्काच्चैवगान्दिन्यामक्रूरो वैष्णवोऽभवत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005956043, "chapter_id": 25956, "verse_number": "१-१३९-४४", "content_sanskrit": "उपमद्गुरथाक्रूराद्देवद्योतस्ततः सुतः ।\nदेववानुपदेवश्च ह्यक्रूरस्य सुतौ स्मृतौ ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005956044, "chapter_id": 25956, "verse_number": "१-१३९-४५", "content_sanskrit": "पृथुर्विपृथुश्चित्रस्य त्वन्धकस्य शुचिःसमृतः ।\nकुकुरो भजमानस्य तथा कम्बलबर्हिषः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005956045, "chapter_id": 25956, "verse_number": "१-१३९-४६", "content_sanskrit": "धृष्टस्तु कुकुराज्जज्ञे तस्मात्कापोतरोमकः ।\nतदात्मजो विलोमा च विलोम्नस्तुम्बुरुः सुतः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005956046, "chapter_id": 25956, "verse_number": "१-१३९-४७", "content_sanskrit": "तस्माच्चदुन्दुभिर्जज्ञे पुनर्वसुरतः स्मृतः ।\nतस्याहुकश्चाहुकी च कन्या चैवाहुकस्य तु ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005956047, "chapter_id": 25956, "verse_number": "१-१३९-४८", "content_sanskrit": "देवकश्चोग्रसेनश्च देवकाद्देवकी तभूत् ।\nवृकदेवोपदेवाच सहदेवा सुरक्षिता ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005956048, "chapter_id": 25956, "verse_number": "१-१३९-४९", "content_sanskrit": "श्रीदेवी शान्तिदेवी च वसुदेव उवाहता ।\nदेववानुपदेवश्च सहदेवासुतौ स्मृतौ ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005956049, "chapter_id": 25956, "verse_number": "१-१३९-५०", "content_sanskrit": "उग्रसेनस्य कंसोऽभूत्सुनामा च वटादय। ।\nविदूरथो भजमानाच्छूरश्चाभूद्विदूरथात् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005956050, "chapter_id": 25956, "verse_number": "१-१३९-५१", "content_sanskrit": "विदूरथसुतस्याथ सूरस्यापि शमी सुतः ।\nप्रतिक्षत्त्रश्च शमिनः स्वयम्भोजस्तदात्मजः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005956051, "chapter_id": 25956, "verse_number": "१-१३९-५२", "content_sanskrit": "हृदिकश्च स्वयम्भोजात्कृतवर्मा तदात्ज ।\nदेवः शतधनुश्चैव शूराद्वै देवमीढुषः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005956052, "chapter_id": 25956, "verse_number": "१-१३९-५३", "content_sanskrit": "दश पुत्रा मारिषायां वसुदेवादयोऽभवन् ।\nपृथा च श्रुतदेवी च श्रुतकीर्तिः श्रुतश्रवाः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005956053, "chapter_id": 25956, "verse_number": "१-१३९-५४", "content_sanskrit": "राजाधिदेवो शूराच्च पृथां कुन्तेः सुतामदात् ।\nसा दत्ता कुन्तिना पाण्डोस्तस्यां धर्मानिलेन्द्रकैः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005956054, "chapter_id": 25956, "verse_number": "१-१३९-५५", "content_sanskrit": "युधिष्ठिरो भीमपार्थो नकुलः सहदेवकः ।\nमाद्रयां नासत्यदस्त्राभ्यां कुन्त्यां कर्णः पुराभवत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005956055, "chapter_id": 25956, "verse_number": "१-१३९-५६", "content_sanskrit": "श्रुतदेव्यां दन्तवक्रो जज्ञे वै युद्धदुर्मदः ।\nसन्तर्दनादयः पञ्च श्रुतकीर्त्याञ्च कैकयात् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005956056, "chapter_id": 25956, "verse_number": "१-१३९-५७", "content_sanskrit": "राजाधिदेव्यां जज्ञाते विन्दश्चैवानुविन्दकः ।\nश्रुतश्रवा दमघोषात्प्रजज्ञे शिशुपालकम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005956057, "chapter_id": 25956, "verse_number": "१-१३९-५८", "content_sanskrit": "पौरवी रोहीणा भार्या मदिरानकदुन्दुभेः ।\nदेवकीप्रमुखा भद्रा रोहिण्यां बलभद्रकः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005956058, "chapter_id": 25956, "verse_number": "१-१३९-५९", "content_sanskrit": "सारणाद्याः शठश्चैव रेवत्यां बलभद्रतः ।\nनिशठश्चोल्मुको जातो देवक्यां षट्च जज्ञिरे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7005956059, "chapter_id": 25956, "verse_number": "१-१३९-६०", "content_sanskrit": "कीर्तिमांश्च सुषेणश्च ह्युदार्यो भद्रसेनक। ।\nऋजुदासो भद्रदेवः कंस एवावधीच्च तान् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7005956060, "chapter_id": 25956, "verse_number": "१-१३९-६१", "content_sanskrit": "संकर्षणः सप्तमोऽभूदष्टमः कृष्ण एव ।\nषोडशस्त्रीसहस्राणि भार्याणाञ्चाभवन्हरेः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7005956061, "chapter_id": 25956, "verse_number": "१-१३९-६२", "content_sanskrit": "रुक्मिणी सत्यभामा च लक्ष्मणा चारुहासिनी ।\nश्रेष्ठा जाम्बवती चाष्टौ जज्ञिरे ताः सुतान्बहून् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7005956062, "chapter_id": 25956, "verse_number": "१-१३९-६३", "content_sanskrit": "प्रद्युम्नश्चारुदेष्णश्च प्रधानाः साम्ब एव ।\nप्रद्युम्नादनिरुद्धोऽभूत्ककुद्मिन्यां महाबलः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7005956063, "chapter_id": 25956, "verse_number": "१-१३९-६४", "content_sanskrit": "अनिरुद्धात्सुभद्रायां वज्रो नाम नृपोऽभवत् ।\nप्रतिबाहुर्वज्रसुतश्चारुस्तस्य सुतोऽभवत् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7005956064, "chapter_id": 25956, "verse_number": "१-१३९-६५", "content_sanskrit": "वह्निस्तु तुर्वसोर्वंशे वह्नेर्भर्गोऽभवत्सुत। ।\nभर्गाद्भानुरभूत्पुत्रो भानोः पुत्रः करन्धमः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7005956065, "chapter_id": 25956, "verse_number": "१-१३९-६६", "content_sanskrit": "करन्धमस्य मरुतो द्रुह्योर्वंशं निबोध मे ।\nद्रह्योस्तु तनयः सेतुरारद्धश्च तदात्मजः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7005956066, "chapter_id": 25956, "verse_number": "१-१३९-६७", "content_sanskrit": "आरद्धस्यैव गान्ध रो घर्मो गान्धारतोऽभवत् ।\nघृतस्तु घर्मपुत्रोऽभूद्दुर्गमश्च घृस्य तु ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7005956067, "chapter_id": 25956, "verse_number": "१-१३९-६८", "content_sanskrit": "प्रचेता दुर्गमस्यैव अनोर्वंशं शृणुष्व मे ।\nअनोः सभानरः पुत्रस्तस्मा कालञ्जयोऽभवत् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7005956068, "chapter_id": 25956, "verse_number": "१-१३९-६९", "content_sanskrit": "कालञ्जयात्सृञ्जयोऽभूत्सृञ्जयात्तु पुरुञ्जयः ।\nजनमेजयस्तु तत्पुत्रो महाशालस्तदात्मजः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7005956069, "chapter_id": 25956, "verse_number": "१-१३९-७०", "content_sanskrit": "महामना महाशालदुशीनर इह स्मृतः ।\nअशीनराच्छिबिर्जज्ञे वृषदर्भः शिवेः सुतः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7005956070, "chapter_id": 25956, "verse_number": "१-१३९-७१", "content_sanskrit": "महामनोजात्तितिक्षोः पुत्रोऽभूच्च रुषद्रथः ।\nहेमो रुषद्रथाज्जज्ञे सुतपा हेमतोऽभवत् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7005956071, "chapter_id": 25956, "verse_number": "१-१३९-७२", "content_sanskrit": "बलिः सुतपसो जज्ञे ह्यङ्गवङ्गकलिङ्गकाः ।\nअन्धः पैण्ड्रश्च बालेया ह्यनपानस्तथाङ्गतः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7005956072, "chapter_id": 25956, "verse_number": "१-१३९-७३", "content_sanskrit": "अनपानाद्दिविरथस्ततो धर्मरथोऽभवत् ।\nरोमपादो धर्मरथाच्चतुरङ्गस्तदात्मजः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7005956073, "chapter_id": 25956, "verse_number": "१-१३९-७४", "content_sanskrit": "पृथुलाक्षस्तस्य पुत्रश्चम्पोऽभूत्पृथुलाक्षतः ।\nचम्पपुत्रश्च हर्यङ्गस्तस्य भद्ररथः सुतः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7005956074, "chapter_id": 25956, "verse_number": "१-१३९-७५", "content_sanskrit": "बृहत्कर्मा सुतस्तस्य बृहद्भानुस्ततोऽभवत् ।\nबुहन्मना बृहाद्भानोस्तस्य पुत्रो जयद्रथः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7005956075, "chapter_id": 25956, "verse_number": "१-१३९-७६", "content_sanskrit": "जयज्रथस्य विजयो विजयस्य धृतिः सुतः ।\nधृतेर्धृव्रतः पुत्रः सत्यधर्मा धृतव्रतात् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7005956076, "chapter_id": 25956, "verse_number": "१-१३९-७७", "content_sanskrit": "तस्य पुत्रस्त्वधिरथः कर्णस्तस्य सुतोऽभवत् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7005956077, "chapter_id": 25956, "verse_number": "१-१३९-७८", "content_sanskrit": "वृर्षसेनस्तु कर्णस्य पुरुवंश्याञ्छणुष्व मे ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]