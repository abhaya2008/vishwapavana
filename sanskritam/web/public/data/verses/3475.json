[{"id": 2115058, "chapter_id": 3475, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2115059, "chapter_id": 3475, "verse_number": "१", "content_sanskrit": "तां विदित्वा चिरगतां हिडिम्बो राक्षसेश्वरः ।\nअवतीर्य द्रुमात् तस्मादाजगामाथ पाण्डवान् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2115060, "chapter_id": 3475, "verse_number": "२", "content_sanskrit": "लोहिताक्षो महाबाहुरूर्ध्वकेशो महाबलः ।\nमेघसङ्घातवर्ष्मा च तीक्ष्णदंष्ट्रोज्ज्वलाननः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2115061, "chapter_id": 3475, "verse_number": "३", "content_sanskrit": "तळं तळेन संहत्य बाहू विक्षिप्य चासकृत् ।\nउद्वृत्तनेत्रः सङ्क्रुद्धो दन्तान् दन्तेषु निष्कषन् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2115062, "chapter_id": 3475, "verse_number": "४", "content_sanskrit": "कोऽद्य मे भोक्तुकामस्य विघ्नं चरति दुर्मतिः ।\nन बिभेति हिडिम्बी च प्रेषिता किमनागता \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2115063, "chapter_id": 3475, "verse_number": "५", "content_sanskrit": "तमापतन्तं दृष्ट्वैव तथारूपं भयङ्करम् ।\nहिडिम्ब्युवाच वित्रस्ता भीमसेनमिदं वचः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2115064, "chapter_id": 3475, "verse_number": "६", "content_sanskrit": "आपतत्येव दुष्टात्मा सङ्क्रुद्धः पुरुषादकः ।\nत्वं चापि भ्रातृभिः सार्धं यद् ब्रवीमि तथा कुरु \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2115065, "chapter_id": 3475, "verse_number": "७", "content_sanskrit": "अहं कामगमा चैव रक्षोबलसमन्विता ।\nआरुहेमां मम श्रोणिं नेष्यामि त्वां विहायसा \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2115066, "chapter_id": 3475, "verse_number": "८", "content_sanskrit": "प्रबोधयैनान् सोदर्यान् मातरं च नरर्षभ ।\nसर्वानेव गमिष्यामि गृहीत्वा व्योमसक्तवत् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2115067, "chapter_id": 3475, "verse_number": "", "content_sanskrit": "भीमसेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2115068, "chapter_id": 3475, "verse_number": "९", "content_sanskrit": "मा भैस्त्वं विपुलश्रोणि नैव किञ्चिन्मयि स्थिते ।\nअहमेनं हनिष्यामि पश्यन्त्यास्ते सुमध्यमे \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2115069, "chapter_id": 3475, "verse_number": "१०", "content_sanskrit": "नायं प्रतिबलो भीरु राक्षसापशदो मम ।\nसोढुं युधि परिस्पन्दमशक्ताः सर्वराक्षसाः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2115070, "chapter_id": 3475, "verse_number": "११", "content_sanskrit": "पश्य बाहू सुवृत्तौ मे हस्तिहस्तोपमौ शुभौ ।\nऊरू परिघसङ्काशौ संहतं चाप्युरो मम \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2115071, "chapter_id": 3475, "verse_number": "१२", "content_sanskrit": "विक्रमं मे महेन्द्रस्य यथा द्रक्ष्यसि शोभने ।\nमाऽवमंस्थाः पृथुश्रोणि मत्वा मामिह मानुषम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2115072, "chapter_id": 3475, "verse_number": "", "content_sanskrit": "हिडिम्बी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2115073, "chapter_id": 3475, "verse_number": "१३", "content_sanskrit": "नावमन्ये नरव्याघ्र त्वामहं देवरूपिणम् ।\nदृष्टाप्रदानास्तु मया मानुषेष्विह राक्षसाः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2115074, "chapter_id": 3475, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2115075, "chapter_id": 3475, "verse_number": "१४", "content_sanskrit": "तथा सञ्जल्पतस्तस्य भीमसेनस्य भारत ।\nवाचः श्रुत्वा च ताः क्रुद्धो राक्षसः पुरुषादकः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2115076, "chapter_id": 3475, "verse_number": "१५", "content_sanskrit": "पुंस्कामां शङ्कमानश्च चुकोप स निशाचरः ।\nसङ्क्रुद्धो राक्षसस्तस्या भगिन्याः कुरुसत्तम \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2115077, "chapter_id": 3475, "verse_number": "१६", "content_sanskrit": "स ददर्शाग्रतस्तस्य भगिनीं पुरुषादकः ।\nविष्फार्य विपुले नेत्रे ततस्तामिदमब्रवीत् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2115078, "chapter_id": 3475, "verse_number": "१७", "content_sanskrit": "कस्मान्मे भोक्तुकामस्य विघ्नं चरसि दुर्मते ।\nन बिभेषि हिडिम्बे किं कामाद् वै विप्रमोहिता \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2115079, "chapter_id": 3475, "verse_number": "१८", "content_sanskrit": "धिक् त्वां पुरुषकामां वै मम विप्रियकारिणीम् ।\nकुलस्य राक्षसेन्द्राणां सर्वेषामयशस्करीम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2115080, "chapter_id": 3475, "verse_number": "१९", "content_sanskrit": "यानिमानाश्रिताऽकार्षीर्विप्रियं सुमहन्मम ।\nएष तानाशु सर्वांस्तु हनिष्यामि त्वया सह \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2115081, "chapter_id": 3475, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2115082, "chapter_id": 3475, "verse_number": "२०", "content_sanskrit": "एवमुक्त्वा हिडिम्बीं स हिडिम्बो लोहितेक्षणः ।\nवधायाभिपपातैनान् दन्तान् दन्तेषु निष्कषन् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2115083, "chapter_id": 3475, "verse_number": "२१", "content_sanskrit": "गर्जन्तमेवं विजने भीमसेनोऽभिवीक्ष्य तम् ।\nरक्षन् प्रबोधं भ्रातॄणां मातुश्च परवीरहा \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2115084, "chapter_id": 3475, "verse_number": "२२", "content_sanskrit": "आपतन्तं च सम्प्रेक्ष्य भीमः प्रहरतां वरः ।\nभत्सयामास तेजस्वी तिष्ठ तिष्ठेति चाब्रवीत् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2115085, "chapter_id": 3475, "verse_number": "१५४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nचतुःपञ्चाशदधिकशततमोऽध्यायः ॥१५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2115086, "chapter_id": 3475, "verse_number": "२", "content_sanskrit": "॥ इति हिडिम्बवधपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2115087, "chapter_id": 3475, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]