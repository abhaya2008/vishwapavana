[{"id": 2047181, "chapter_id": 2046, "verse_number": "६-९५-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2047182, "chapter_id": 2046, "verse_number": "६-९५-१", "content_sanskrit": "तस्मिन्महति संक्रन्दे राजा दुर्योधनस्तदा।\n`पराजयं राक्षसेन नामृष्यत परंतपः।\nगाङ्गेयमुपसंगम्य विनयेनाभिवाद्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2047183, "chapter_id": 2046, "verse_number": "६-९५-२", "content_sanskrit": "तस्य सर्वं यथावृत्तमाख्यातुमुपचक्रमे।\nघटोत्कचस्य विजयमात्मनश्च पराजयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2047184, "chapter_id": 2046, "verse_number": "६-९५-३", "content_sanskrit": "कथयामास दुर्धर्षो विनिःश्वस्य पुनःपुनः ।\nअब्रवीच्च तदा राजन्भीष्मं कुरुपितामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2047185, "chapter_id": 2046, "verse_number": "६-९५-४", "content_sanskrit": "भवन्तं समुपाश्रित्य द्रोणं चैव पितामह ।\nपाण्डवैर्विग्रहो घोरः समारब्धो मया प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2047186, "chapter_id": 2046, "verse_number": "६-९५-५", "content_sanskrit": "एकादश समाख्याता अक्षौहिण्यश्च या मम।\nनिदेशे तव तिष्ठन्ति मया सार्धं परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2047187, "chapter_id": 2046, "verse_number": "६-९५-६", "content_sanskrit": "सोऽहं भरतशार्दूल भीमसेनपुरोगमैः ।\nघटोत्कचं समाश्रित्य पाण्डवैर्युधि निर्जितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2047188, "chapter_id": 2046, "verse_number": "६-९५-७", "content_sanskrit": "तन्मे दहति गात्राणि शुष्कवृक्षमिवानलः ।\nतदिच्छामि महाभाग त्वत्प्रसादात्परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2047189, "chapter_id": 2046, "verse_number": "६-९५-८", "content_sanskrit": "राक्षसापशदं हन्तुं स्वयमेव पितामह ।\nत्वां समाश्रित्य दुर्धर्षं तन्मे कर्तुं त्वमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2047190, "chapter_id": 2046, "verse_number": "६-९५-९x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2047191, "chapter_id": 2046, "verse_number": "६-९५-९", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं राज्ञो भरतसत्तम।\nदुर्योधनमिदं वाक्यं भीष्मः शान्तनवोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2047192, "chapter_id": 2046, "verse_number": "६-९५-१०", "content_sanskrit": "शृणु राजन्मम वचो यत्त्वां वक्ष्यामि कौरव।\nयथा त्वया महाराज वर्तितव्यं परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2047193, "chapter_id": 2046, "verse_number": "६-९५-११", "content_sanskrit": "आत्मा रक्ष्यस्त्वया तात सर्वावस्थास्वरिन्दम।\nधर्मराजेन संग्रामस्त्वया कार्यः सदाऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2047194, "chapter_id": 2046, "verse_number": "६-९५-१२", "content_sanskrit": "अर्जुनेन यमाभ्यां वा भीमसेनेन वा पुनः ।\nअन्यैर्वा पृथिवीपालै राजा राजानमृच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2047195, "chapter_id": 2046, "verse_number": "६-९५-१३", "content_sanskrit": "न तु कार्यस्त्वया राजन्हैडिम्बेन दुरात्मा।\nअहं द्रोणः कृपो द्रौणिः कृतवर्मा च सात्वतः।\nशल्यश्च वृषसेनश्च विकर्णश्च महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2047196, "chapter_id": 2046, "verse_number": "६-९५-१४", "content_sanskrit": "शेषाश्च भ्रातरस्त्वन्ये दुःशासनपुरोगमाः।\nत्वदर्थे प्रतियोत्स्यामो राक्षसं तं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2047197, "chapter_id": 2046, "verse_number": "६-९५-१५", "content_sanskrit": "रौद्रे तस्मिन्राक्षसेन्द्रे यदि ते हृच्छयो महान् ।\nअयमागच्छतु रणं तस्य युद्धाय दुर्मतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2047198, "chapter_id": 2046, "verse_number": "६-९५-१६", "content_sanskrit": "भगदत्तो महीपालः पुरन्दरसमो युधि ।\nएतावदुक्त्वा राजानं भगदत्तमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2047199, "chapter_id": 2046, "verse_number": "६-९५-१७", "content_sanskrit": "समक्षं पार्थिवेन्द्रस्य वाक्यं वाक्यविशारदः।\nगच्छ शीघ्रं महाराज हैडिम्बं युद्धदुर्मदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2047200, "chapter_id": 2046, "verse_number": "६-९५-१८", "content_sanskrit": "वारयस्व रणे यत्तो मिषतां सर्वधन्विनाम् ।\nराक्षसं क्रूरकर्माणं यथेन्द्रस्तारकं पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2047201, "chapter_id": 2046, "verse_number": "६-९५-१९", "content_sanskrit": "तव दिव्यानि चास्त्राणि विक्रमश्च परंतप ।\nसमागमश्च बहुभिः पुराऽभूदमरैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2047202, "chapter_id": 2046, "verse_number": "६-९५-२०", "content_sanskrit": "त्वं तस्य नृपशार्दूल प्रतियोद्धा महाहवे ।\nस्वबलेनावृतो गच्छ जहि राक्षसपुङ्गवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2047203, "chapter_id": 2046, "verse_number": "६-९५-२१x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2047204, "chapter_id": 2046, "verse_number": "६-९५-२१", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं भीष्मस्य पृतनापतेः।\nप्रययौ सिंहनादेन परानभिमुखको द्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2047205, "chapter_id": 2046, "verse_number": "६-९५-२२", "content_sanskrit": "तमापतन्तं संप्रेक्ष्य गर्जन्तमिव तोयदम् ।\nअभ्यवर्तन्त संक्रुद्धाः पाण्डवानां महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2047206, "chapter_id": 2046, "verse_number": "६-९५-२३", "content_sanskrit": "भीमसेनोऽभिमन्युश्च राक्षसश्च घटोत्कचः ।\nद्रौपदेयाः सत्यधृतिः क्षत्रदेवश्च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2047207, "chapter_id": 2046, "verse_number": "६-९५-२४", "content_sanskrit": "चेदिपो वसुदानश्च दशार्णाधिपतिस्तथा ।\nसुप्रतीकेन तांश्चापि भगदत्तोऽप्युपाद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2047208, "chapter_id": 2046, "verse_number": "६-९५-२५", "content_sanskrit": "ततः समभवद्युद्धं घोररूपं भयानकम्।\nपाण्डूनां भगदत्तेन यमराष्ट्रविवर्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2047209, "chapter_id": 2046, "verse_number": "६-९५-२६", "content_sanskrit": "प्रयुक्ता रथिभिर्बाणा भीमवेगाः सुतेजनाः ।\nते निपेतुर्महाराज नागेषु च रथेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2047210, "chapter_id": 2046, "verse_number": "६-९५-२७", "content_sanskrit": "प्रभिन्नाश्च महानागा विनीता हस्तिसादिभिः ।\nपरस्परं समासाद्य संनिपेतुरभीतवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2047211, "chapter_id": 2046, "verse_number": "६-९५-२८", "content_sanskrit": "मदान्धा रोषसंरब्धा विषाणाग्रैर्महाहवे ।\nबिभिदुर्दन्तमुसलैः समासाद्य परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2047212, "chapter_id": 2046, "verse_number": "६-९५-२९", "content_sanskrit": "हयाश्च चामरापीडाः प्रासपाणिभिरास्थिताः ।\nचोदिताः सादिभिः क्षिप्रं निजघ्रुरितरेतरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2047213, "chapter_id": 2046, "verse_number": "६-९५-३०", "content_sanskrit": "पादाताश्च पदात्योघैस्ताडिताः शक्तितोमरैः।\nन्यपतन्त तदा भूमौ शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2047214, "chapter_id": 2046, "verse_number": "६-९५-३१", "content_sanskrit": "रथिनश्च रथाकंश्चित्रान्कर्णिनालीकतोमरैः ।\nनिहत्य समरे वीरान्सिंहनादान्विनेदिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2047215, "chapter_id": 2046, "verse_number": "६-९५-३२", "content_sanskrit": "तस्मिंस्तथा वर्तमाने संग्रामे रोमहर्षणे ।\nभगतत्तो महेष्वासो भीमसेनमथाद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2047216, "chapter_id": 2046, "verse_number": "६-९५-३३", "content_sanskrit": "कुञ्जरेण प्रभिन्नेन सप्तधा स्रवता मदम्।\nपर्वतेन यथा तोयं स्रवमाणेन सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2047217, "chapter_id": 2046, "verse_number": "६-९५-३४", "content_sanskrit": "किरञ्छरसहस्राणि सुप्रतीकशिरोगतः ।\nऐरावतस्थो मघवान्वारिधारा इवानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2047218, "chapter_id": 2046, "verse_number": "६-९५-३५", "content_sanskrit": "स भीमं शरधाराभिस्ताजयामास पार्थिवः ।\nपर्वतं वारिधाराभिस्तपान्ते जलदो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2047219, "chapter_id": 2046, "verse_number": "६-९५-३६", "content_sanskrit": "भीमसेनस्तु संक्रुद्धः पादरक्षान्परःशतान्।\nनिजघान महेष्वासः संरब्धः शरवृष्टिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2047220, "chapter_id": 2046, "verse_number": "६-९५-३७", "content_sanskrit": "तान्दृष्ट्वा निहतान्क्रुद्धो भगदत्तः प्रतापवान् ।\nचोदयामास नागेन्द्रं भीमसेनरथं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2047221, "chapter_id": 2046, "verse_number": "६-९५-३८", "content_sanskrit": "स नागः प्रेषितस्तेन बाणो ज्याचोदितो यथा।\nअभ्यधावत वेगेन भीमसेनपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2047222, "chapter_id": 2046, "verse_number": "६-९५-३९", "content_sanskrit": "तमापतन्तं संप्रेक्ष्य पाण्डवानां महारथाः।\nअभ्यवर्तन्त वेगेन भीमसेनपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2047223, "chapter_id": 2046, "verse_number": "६-९५-४०", "content_sanskrit": "केकयाश्चाभिमन्युश्च द्रौपदेयाश्च सर्वशः।\nदशार्णाधिपतिः शूरः क्षत्रदेवश्च मारिष ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2047224, "chapter_id": 2046, "verse_number": "६-९५-४१", "content_sanskrit": "चेदिपो धृष्टकेतुश्च संरब्धाः सर्व एव ते।\nउत्तमास्त्राणि दिव्यानि दर्शयन्तो महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2047225, "chapter_id": 2046, "verse_number": "६-९५-४२", "content_sanskrit": "तमेकं कुञ्जरं क्रुद्धाः समन्तात्पर्यवारयन् ।\nस विद्धो बहुभिर्बाणैर्व्यरोचत महाद्विपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2047226, "chapter_id": 2046, "verse_number": "६-९५-४३", "content_sanskrit": "संजातरुधिरोत्पीडो धातुचित्र इवाद्रिराट्।\nदशार्णाधिपतिश्चाऽपि गजं भूमिधरोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2047227, "chapter_id": 2046, "verse_number": "६-९५-४४", "content_sanskrit": "समास्थितोऽभिदुद्राव भगदत्तस्य वारणम्।\nतमापतन्तं समरे जगं जगपतिः स च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2047228, "chapter_id": 2046, "verse_number": "६-९५-४५", "content_sanskrit": "दधार सुप्रतीकोऽपि वेलेव मकरालयम् ।\nवारितं प्रेक्ष्य नागेन्द्रं दशार्णस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2047229, "chapter_id": 2046, "verse_number": "६-९५-४६", "content_sanskrit": "साधुसाध्विति सैन्यानि त्वदीयान्यभ्यपूजयन् ।\nततः प्राग्ज्योतिषः क्रुद्धस्तोमरान्वै चतुर्दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2047230, "chapter_id": 2046, "verse_number": "६-९५-४७", "content_sanskrit": "प्राहिणोत्तस्य नागस्य प्रमुखे नृपसत्तम।\nतस्य कुम्भपरित्राणां शातकुम्भपरिष्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2047231, "chapter_id": 2046, "verse_number": "६-९५-४८", "content_sanskrit": "विदार्य प्राविशन्क्षिप्रं वल्मीकमिव पन्नगाः।\nस गाढविद्धो व्यथितो नागो भरतसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2047232, "chapter_id": 2046, "verse_number": "६-९५-४९", "content_sanskrit": "उपावृत्तमदः क्षिप्रमभ्यवर्तत वेगिनः ।\nस प्रदुद्राव वेगेन प्रणदन्भैरवं रवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2047233, "chapter_id": 2046, "verse_number": "६-९५-५०", "content_sanskrit": "संमर्दमानः स्वबलं वायुर्वृक्षानिवौजसा ।\nतस्मिन्पराजिते नागे पाण्डवानां महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2047234, "chapter_id": 2046, "verse_number": "६-९५-५१", "content_sanskrit": "सिंहनादं विनद्योच्चैर्युद्धायैवावतस्थिरे ।\nततो भीमं पुरस्कृत्य भगदत्तमुपाद्रवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2047235, "chapter_id": 2046, "verse_number": "६-९५-५२", "content_sanskrit": "किरन्तो विविधान्बाणाञ्शस्त्राणि विविधानि च।\nतेषामापततां राजन्संक्रुद्धानाममर्षिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2047236, "chapter_id": 2046, "verse_number": "६-९५-५३", "content_sanskrit": "श्रुत्वा स निनदंक घोरममर्षाद्गतसाध्वसः ।\nभगदत्तो महेष्वासः स्वनागं प्रत्यचोदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2047237, "chapter_id": 2046, "verse_number": "६-९५-५४", "content_sanskrit": "अङ्कुशाङ्गुष्ठनुदितः स गजप्रवरो युधि।\nतस्मिन्क्षणे समभवत्सांवर्तक इवानलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2047238, "chapter_id": 2046, "verse_number": "६-९५-५५", "content_sanskrit": "रथसङ्घांस्तथा नागान्हयांश्च हयसादिनः ।\nपादातांश्च सुसंक्रुद्धः शतशोऽथ सहस्रशःक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2047239, "chapter_id": 2046, "verse_number": "६-९५-५६", "content_sanskrit": "अमृद्गात्समरे नागः संप्रधावंस्ततस्ततः।\nतेन संलोड्यमानं तु पाण्डवानां बलं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2047240, "chapter_id": 2046, "verse_number": "६-९५-५७", "content_sanskrit": "संचुकोच महाराज चर्मेवाग्नौ समाहितम् ।\nभग्नं तु स्वबलं दृष्ट्वा भगदत्तेन धीमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2047241, "chapter_id": 2046, "verse_number": "६-९५-५८", "content_sanskrit": "घटोत्कचोऽथ संक्रुद्धो भगदत्तमुपाद्रवत्।\nविकटः परुषो राजन्दीप्तास्यो दीप्तलोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2047242, "chapter_id": 2046, "verse_number": "६-९५-५९", "content_sanskrit": "रूपं विभीषणं कृत्वा रोषेण प्रज्वलन्निव ।\nजग्राह विमलं शूलं गिरीणामपि दारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2047243, "chapter_id": 2046, "verse_number": "६-९५-६०", "content_sanskrit": "नागं जिघांसुः सहसा चिक्षेप च महाबलः।\nस विस्फुलिङ्गमालाभिः समन्तात्परिवेष्टितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2047244, "chapter_id": 2046, "verse_number": "६-९५-६१", "content_sanskrit": "तमापतन्तं सहसा दृष्ट्वा प्राग्ज्योतिषो नृपः ।\nचिक्षेप रुचिरं तीक्ष्णमर्धचन्द्रं सुदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2047245, "chapter_id": 2046, "verse_number": "६-९५-६२", "content_sanskrit": "चिच्छेद तन्महच्छूलं तेन बाणेन वेगवान् ।\nउत्पपात द्विधा च्छिन्नं शूलं हेमपरिष्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2047246, "chapter_id": 2046, "verse_number": "६-९५-६३", "content_sanskrit": "महाशनिर्यथा भ्रष्टा शक्रमुक्ता नभोगता ।\nशूलं निपतितं दृष्ट्वा द्विधा कृत्तं च पार्थिवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2047247, "chapter_id": 2046, "verse_number": "६-९५-६४", "content_sanskrit": "रुक्मदण्डां महाशक्तिं जग्राहाग्निशिखोपमान् ।\nचिक्षेप तां राक्षसस्य तिष्ठितिष्ठेति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2047248, "chapter_id": 2046, "verse_number": "६-९५-६५", "content_sanskrit": "तामापतन्तीं संप्रेक्ष्य वियत्स्थामशनीमिव ।\nउत्पत्य राक्षसस्तूर्णं जग्राह च ननाद च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2047249, "chapter_id": 2046, "verse_number": "६-९५-६६", "content_sanskrit": "बभञ्ज चैनां त्वरितो जानुन्यारोप्य भारत।\nपश्यतः पार्थिवेन्द्रस्य तदद्भुतमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2047250, "chapter_id": 2046, "verse_number": "६-९५-६७", "content_sanskrit": "तदवेक्ष्य कृतं कर्म राक्षसेन बलीयसा।\nदिवि देवाः सगन्धर्वा मुनयश्चापि विस्मिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2047251, "chapter_id": 2046, "verse_number": "६-९५-६८", "content_sanskrit": "पाण्डवाश्च महाराज भीमसेनपुरोगमाः ।\nसाधुसाध्विति नादेन पृथिवीमन्वनादयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2047252, "chapter_id": 2046, "verse_number": "६-९५-६९", "content_sanskrit": "तं तु श्रुत्वा महानादं प्रहृष्टानां महात्मनाम् ।\nनामृष्यत महेष्वासो भगदत्तः प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2047253, "chapter_id": 2046, "verse_number": "६-९५-७०", "content_sanskrit": "स विष्फार्य महच्चापमिन्द्राशानिसमप्रभम् ।\nअभिदुद्राव वेगेन पाण्डवानां महारथान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2047254, "chapter_id": 2046, "verse_number": "६-९५-७१", "content_sanskrit": "विसृजन्विमलांस्तीक्ष्णान्नाराचाञ्ज्वलनप्रभान् ।\nभीममेकेन विव्याध राक्षसं नवभिः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2047255, "chapter_id": 2046, "verse_number": "६-९५-७२", "content_sanskrit": "अभिमन्युं त्रिभिश्चैव केकयान्पञ्च पञ्चभिः ।\nपूर्णायतविसृष्टेन शरेणानतपर्वणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2047256, "chapter_id": 2046, "verse_number": "६-९५-७३", "content_sanskrit": "बिभेद दक्षिणं बाहुं क्षत्रेदवस्य चाहवे ।\nपपात सहसा तस्य सशरं धनुरुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2047257, "chapter_id": 2046, "verse_number": "६-९५-७४", "content_sanskrit": "द्रौपदेयांस्ततः पञ्च पञ्चभिः समताडयत् ।\nभीमसेनस्य च क्रोधान्निजघान तुरंगमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2047258, "chapter_id": 2046, "verse_number": "६-९५-७५", "content_sanskrit": "ध्वजं केसरिणं चास्य चिच्छेद विशिखैस्त्रिभिः ।\nनिर्बिभेद त्रिभिश्चान्यैः सारथिं चास्य पत्रिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2047259, "chapter_id": 2046, "verse_number": "६-९५-७६", "content_sanskrit": "स गाढविद्धो व्यथितो रथोपस्थ उपाविशत् ।\nविशोको भरतश्रेष्ठ भगदत्तेन संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2047260, "chapter_id": 2046, "verse_number": "६-९५-७७", "content_sanskrit": "ततो भीमो महाबाहुर्विरथो रथिनां वरः ।\nगदां प्रगृह्य वेगेन प्रचस्कन्द रथोत्तमात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2047261, "chapter_id": 2046, "verse_number": "६-९५-७८", "content_sanskrit": "तमुद्यतगदं दृष्ट्वा सशृङ्गमिव पर्वतम् ।\nतावकानां भयं घोरं समपद्यत भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2047262, "chapter_id": 2046, "verse_number": "६-९५-७९", "content_sanskrit": "एतस्मिन्नेव काले तु पाण्डवः कृष्णसारथिः ।\nआजगाम महाराज निघ्नञ्शत्रून्समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2047263, "chapter_id": 2046, "verse_number": "६-९५-८०", "content_sanskrit": "यत्र तौ पुरुषव्याघ्रौ पितापुत्रौ महाबलौ ।\nप्राग्ज्योतिषेण संयुक्तौ भीमसेनघटोत्कचौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2047264, "chapter_id": 2046, "verse_number": "६-९५-८१", "content_sanskrit": "दृष्ट्वा च पाण्डवो भ्रातॄन्युध्यमानान्महारथान् ।\nत्वरितो भरतश्रेष्ठ तत्रायुध्यत्किरञ्छरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2047265, "chapter_id": 2046, "verse_number": "६-९५-८२", "content_sanskrit": "ततो दुर्योधनो राजा त्वरमाणो महारथः ।\nसेनामचोदयत्क्षिप्रं रथनागाश्वसंकुलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2047266, "chapter_id": 2046, "verse_number": "६-९५-८३", "content_sanskrit": "तामापतन्तीं सहसा कौरवाणां महाचमूम् ।\nअभिदुद्राव वेगेन पाण्डवः श्वेतवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2047267, "chapter_id": 2046, "verse_number": "६-९५-८४", "content_sanskrit": "भगदत्तश्च समरे तेन नागेन भारत।\nविमृद्गन्पाण्डवबलं युधिष्ठिरमुपाद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2047268, "chapter_id": 2046, "verse_number": "६-९५-८५", "content_sanskrit": "तदासीत्सुमहद्युद्धं भगदत्तस्य मारिष।\nपाञ्चालैः पाण्डवेयैश्च केकयैश्चोद्यतायुधैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2047269, "chapter_id": 2046, "verse_number": "६-९५-८६", "content_sanskrit": "भीमसेनोऽपि समरे तावुभौ केशवार्जिनौ ।\nअश्रावयद्यथावृत्तमिरावद्वधतुत्तमम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2047270, "chapter_id": 2046, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि अष्टमदिवसयुद्धे पञ्चनवतितमोऽध्यायः ॥\nMahabharata - Bhishma Parva - Chapter Footnotes\n६-९५-४ भवन्तं समुपाश्रित्य वासुदेवं यथा परैः इति झo पाठः। ड पाठे अयमर्थश्लोको नास्ति॥ ६-९५-१५ अनुशय इति पाठे पश्चात्तापः ॥ ६-९५-७७ प्रचस्कन्द अवततार ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}]