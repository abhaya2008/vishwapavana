[{"id": 2117794, "chapter_id": 3536, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2117795, "chapter_id": 3536, "verse_number": "१", "content_sanskrit": "एवं ते समयं कृत्वा न्यवसंस्तत्र पाण्डवाः ।\nवशे शस्त्रप्रतापेन कुर्वन्तोऽन्यान् महीक्षितः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2117796, "chapter_id": 3536, "verse_number": "२", "content_sanskrit": "तेषां मनुजसिंहानां पञ्चानाममितौजसाम् ।\nबभूव कृष्णा पञ्चानां दयिता वशवर्तिनी \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2117797, "chapter_id": 3536, "verse_number": "३", "content_sanskrit": "ते तया तैश्च सा वीरैः पतिभिः सह पञ्चभिः ।\nबभूव परमप्रीता नागैरिव सरस्वती \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2117798, "chapter_id": 3536, "verse_number": "४", "content_sanskrit": "वर्तमानेषु धर्मेण पाण्डवेषु महात्मसु ।\nनामर्षन् कुरवः सर्वे हीनदोषान् सुखान्वितान् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2117799, "chapter_id": 3536, "verse_number": "५", "content_sanskrit": "अथ दीर्घेण कालेन ब्राह्मणस्य विशाम्पते ।\nकस्यचित् तस्कराः केचिज्जह्रुर्गा नृपसत्तम \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2117800, "chapter_id": 3536, "verse_number": "६", "content_sanskrit": "ह्रियमाणे धने तस्मिन् ब्राह्मणः क्रोधमूर्च्छितः ।\nआगम्य खाण्डवप्रस्थमुदक्रोशत पाण्डवान् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2117801, "chapter_id": 3536, "verse_number": "७", "content_sanskrit": "ह्रियते गोधनं क्षुद्रैर्नृशंसैरकृतात्मभिः ।\nप्रगृह्य वोऽस्मद्विषयादभिधावन्ति पाण्डवाः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2117802, "chapter_id": 3536, "verse_number": "८", "content_sanskrit": "ब्राह्मणस्याप्रमत्तस्य हविर्ध्वाङ्क्षैर्विलुप्यते ।\nशार्दूलस्य गुहां शून्यां नीचः क्रोष्टाऽभिमन्यते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2117803, "chapter_id": 3536, "verse_number": "९", "content_sanskrit": "ब्राह्मणस्वे हृते चोरैर्धर्मार्थौ च विलोपितौ ।\nरोरूयमाणे च मयि क्रियतामस्त्रधारणम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2117804, "chapter_id": 3536, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2117805, "chapter_id": 3536, "verse_number": "१०", "content_sanskrit": "रोरूयमाणस्याभ्याशे भृशं विप्रस्य पाण्डवः ।\nतानि वाक्यानि शुश्राव कुन्तीपुत्रो धनञ्जयः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2117806, "chapter_id": 3536, "verse_number": "११", "content_sanskrit": "श्रुत्वाऽर्जुनो महाबाहुर्मा भैरित्याह तं द्विजम् ।\nआयुधानि च यत्रासन् पाण्डवानां महात्मनाम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2117807, "chapter_id": 3536, "verse_number": "१२", "content_sanskrit": "कृष्णया सह तत्रासीद् धर्मपुत्रो युधिष्ठिरः ।\nस प्रवेशाय चाशक्तो गन्तुमिच्छंश्च पाण्डवः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2117808, "chapter_id": 3536, "verse_number": "१३", "content_sanskrit": "तस्य चार्तस्य तैर्वाक्यैश्चोद्यमानः पुनःपुनः ।\nआक्रन्देन च कौन्तेयश्चिन्तयामास दुःखितः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2117809, "chapter_id": 3536, "verse_number": "१४", "content_sanskrit": "ह्रियमाणे धने तस्मिन् ब्राह्मणस्य तपस्विनः ।\nउपप्रेक्षणजोऽधर्मः सुमहान् स्यान्महीपतेः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2117810, "chapter_id": 3536, "verse_number": "१५", "content_sanskrit": "आस्रप्रमार्जनं तस्य कर्तव्यमिति निश्चयः ।\nयद्यस्य कुरवो द्वारि न करोम्यद्य कर्षणम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2117811, "chapter_id": 3536, "verse_number": "१६", "content_sanskrit": "नास्तिक्यं चापि सर्वेषामस्माकं स्यादधर्मजम् ।\nप्रतितिष्ठेत लोकेऽस्मिन्नधर्मश्चैव नो महान् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2117812, "chapter_id": 3536, "verse_number": "१७", "content_sanskrit": "अनापृच्छयैव राजानं गते मयि न संशयः ।\nअजातशत्रोर्नृपतेर्मम चैवाप्रियं भवेत् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2117813, "chapter_id": 3536, "verse_number": "१८", "content_sanskrit": "अनुप्रवेशे राज्ञो वा वनवासो भवेन्मम ।\nअधर्मो वै महानस्तु वने वा मरणं मम \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2117814, "chapter_id": 3536, "verse_number": "१९", "content_sanskrit": "शरीरस्यापि नाशात् तु धर्म एव विशिष्यते ।\nएवं विनिश्चित्य ततः कुन्तीपुत्रो धनञ्जयः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2117815, "chapter_id": 3536, "verse_number": "२०", "content_sanskrit": "अनुप्रविश्य राजानमभिवाद्य विनिःसृतः ।\nधनुरादाय संहृष्टो ब्राह्मणं प्रत्यभाषत \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2117816, "chapter_id": 3536, "verse_number": "२१", "content_sanskrit": "ब्राह्मणागम्यतां शीघ्रं यावत् परधनैषिणः ।\nन दूराद् भवतः क्षुद्रास्तावद् गच्छावहे सह ।\nयावदावर्तयाम्यद्य चोरहस्ताद् धनं तव \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2117817, "chapter_id": 3536, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2117818, "chapter_id": 3536, "verse_number": "२२", "content_sanskrit": "सोऽनुसृत्य महाबाहुर्धन्वी वर्मी रथी ध्वजी ।\nशरैर्विध्वस्य तांश्चोरानपजित्य च तद्धनम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2117819, "chapter_id": 3536, "verse_number": "२३", "content_sanskrit": "ब्राह्मणस्य उपाकृत्य यशः पीत्वा च पाण्डवः ।\nआजगाम पुरं वीरः सव्यसाची परन्तपः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2117820, "chapter_id": 3536, "verse_number": "२४", "content_sanskrit": "सोऽभिवाद्य गुरून् सर्वांस्तैश्चापि प्रतिनन्दितः ।\nधर्मराजमुवाचेदं व्रतमादिश्यतां मम \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2117821, "chapter_id": 3536, "verse_number": "२५", "content_sanskrit": "समयः समतिक्रान्तो भवत्सन्दर्शनान्मम ।\nवनवासं गमिष्यामि समयो ह्येष नः कृतः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2117822, "chapter_id": 3536, "verse_number": "२६", "content_sanskrit": "इत्युक्तो धर्मराजस्तु सहसा वाक्यमब्रवीत् ।\nकथमित्यब्रवीद् वाचा शोकार्तः सज्जमानया \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2117823, "chapter_id": 3536, "verse_number": "२७", "content_sanskrit": "युधिष्ठिरो गुडाकेशं भ्राता भ्रातरमब्रवीत् ।\nप्रमाणमस्ति यदि ते मत्तः शृणु वचो मम \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2117824, "chapter_id": 3536, "verse_number": "२८", "content_sanskrit": "अनुप्रवेशं यद् वीर कृतवांस्त्वं ममाप्रियम् ।\nसर्वं तदनुजानामि व्यलीकं न च मे हृदि \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2117825, "chapter_id": 3536, "verse_number": "२९", "content_sanskrit": "गुरोरनुप्रवेशेन नोपघातो यवीयसः ।\nयवीयसोऽनुप्रवेशो ज्येष्ठस्य विधिलोपकृत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2117826, "chapter_id": 3536, "verse_number": "३०", "content_sanskrit": "निवर्तस्व महाबाहो कुरुष्व वचनं मम ।\nन हि ते धर्मलोपोऽस्ति न च मे धर्षणा कृता \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2117827, "chapter_id": 3536, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2117828, "chapter_id": 3536, "verse_number": "३१", "content_sanskrit": "न व्याजेन चरेद् धर्ममिति मे भवतः श्रुतम् ।\nन तस्माद् विचलिष्यामि सत्येनायुधमालभे \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2117829, "chapter_id": 3536, "verse_number": "३२", "content_sanskrit": "आज्ञा तु मम दातव्या भवता कीर्तिवर्धन ।\nभवदाज्ञामृते किञ्चिन्न कार्यमिति निश्चितम् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2117830, "chapter_id": 3536, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2117831, "chapter_id": 3536, "verse_number": "३३", "content_sanskrit": "सोऽभ्यनुज्ञाप्य राजानं ब्रह्मचर्यादिदीक्षितः ।\nवने द्वादश मासान् हि वासायोपजगाम ह \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2117832, "chapter_id": 3536, "verse_number": "२१५", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nपञ्चदशशाधिकद्विशततमोऽध्यायः ॥२१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2117833, "chapter_id": 3536, "verse_number": "१", "content_sanskrit": "॥ इति अर्जुनवनवासपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2117834, "chapter_id": 3536, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]