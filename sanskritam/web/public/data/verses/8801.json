[{"id": 40000662, "chapter_id": 8801, "verse_number": "1", "content_sanskrit": "तच्छ्रुत्वा राजसिंहस्य वाक्यमद्भुतविस्तरम्। हृष्टरोमा महातेजा विश्वामित्रोऽभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40000663, "chapter_id": 8801, "verse_number": "2", "content_sanskrit": "सदृशं राजशार्दूल तवैतद्भुवि नान्यथा। महावंशप्रसूतस्य वसिष्ठव्यपदेशिन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40000664, "chapter_id": 8801, "verse_number": "3", "content_sanskrit": "यत्तु मे हृद्गतं वाक्यं तस्य कार्यस्य निश्चयम्। कुरूष्व राजशार्दूल भव सत्यप्रतिश्रव: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40000665, "chapter_id": 8801, "verse_number": "4", "content_sanskrit": "अहंनियममातिष्ठे सिध्यर्थं पुरुषर्षभ। तस्य विघ्नकरौ द्वौ तु राक्षसौ कामरूपिणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40000666, "chapter_id": 8801, "verse_number": "5", "content_sanskrit": "व्रते मे बहुशश्चीर्णे समाप्त्यां राक्षसाविमौ। मारीचश्च सुबाहुश्च वीर्यवन्तौ सुशिक्षितौ ॥ समांसरुधिरौघेण वेदिं तामभ्यवर्षताम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40000667, "chapter_id": 8801, "verse_number": "6", "content_sanskrit": "अवधूते तथाभूते तस्मिन्नियमनिश्चये ॥ कृतश्रमो निरुत्साहस्तस्माद्देशादपाक्रमे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40000668, "chapter_id": 8801, "verse_number": "7", "content_sanskrit": "न च मे क्रोधमुत्स्रष्टुं बुद्धिर्भवति पार्थिव ॥ तथा भूता हि सा चर्या न शापस्तत्र मुच्यते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40000669, "chapter_id": 8801, "verse_number": "8", "content_sanskrit": "स्वपुत्रं राजशार्दूल रामं सत्यपराक्रमम् ॥ काकपक्षधरं शूरं ज्येष्ठं मे दातुमर्हसि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40000670, "chapter_id": 8801, "verse_number": "9", "content_sanskrit": "शक्तो ह्येष मया गुप्तो दिव्येन स्वेन तेजसा ॥ राक्षसा ये विकर्तारस्तेषामपि विनाशने।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40000671, "chapter_id": 8801, "verse_number": "10", "content_sanskrit": "श्रेयश्चास्मै प्रदास्यामि बहुरूपं न संशय: ॥ त्रयाणामपि लोकानां येन ख्यातिं गमिष्यति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40000672, "chapter_id": 8801, "verse_number": "11", "content_sanskrit": "न च तौ राममासाद्य शक्तौ स्थातुं कथञ्चन ॥ न च तौ राघवादन्यो हन्तुमुत्सहते पुमान्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40000673, "chapter_id": 8801, "verse_number": "12", "content_sanskrit": "वीर्योत्सिक्तौ हि तौ पापौ कालपाशवशं गतौ ॥ रामस्य राजशार्दूल न पर्याप्तौ महात्मन:।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40000674, "chapter_id": 8801, "verse_number": "13", "content_sanskrit": "न च पुत्रकृतस्नेहं कर्तुमर्हसि पार्थिव ॥ अहं ते प्रतिजानामि हतौ तौ विद्धि राक्षसौ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40000675, "chapter_id": 8801, "verse_number": "14", "content_sanskrit": "अहं वेद्मि महात्मानं रामं सत्यपराक्रमम् ॥ वसिष्ठोऽपि महातेजा ये चेमे तपसि स्थिता:।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40000676, "chapter_id": 8801, "verse_number": "15", "content_sanskrit": "यदि ते धर्मलाभं च यशश्च परमं भुवि ॥ स्थितमिच्छसि राजेन्द्र रामं मे दातुमर्हसि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40000677, "chapter_id": 8801, "verse_number": "16", "content_sanskrit": "यदिह्यनुज्ञां काकुत्स्थ ददते तव मन्त्रिण: ॥ वसिष्ठप्रमुखा: सर्वे ततो रामं विसर्जय।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40000678, "chapter_id": 8801, "verse_number": "17", "content_sanskrit": "अभिप्रेतमसंसक्तमात्मजं दातुमर्हसि ॥ दशरात्रं हि यज्ञस्य रामं राजीवलोचनम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40000679, "chapter_id": 8801, "verse_number": "18", "content_sanskrit": "नात्येति कालो यज्ञस्य यथाऽयं मम राघव ॥ तथा कुरुष्व भद्रं ते मा च शोके मन: कृथा:।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40000680, "chapter_id": 8801, "verse_number": "19", "content_sanskrit": "इत्येवमुक्त्वा धर्मात्मा धर्मार्थसहितं वच: ॥ विरराम महातेजा विश्वामित्रो महामुनि:।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40000681, "chapter_id": 8801, "verse_number": "20", "content_sanskrit": "स तन्निशम्य राजेन्द्रो विश्वामित्रवचश्शुभम् ॥ शोकमभ्यगमत्तीव्रं व्यषीदत भयान्वित:।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40000682, "chapter_id": 8801, "verse_number": "21", "content_sanskrit": "इति हृदयमनोविदारणं मुनिवचनं तदतीव शुश्रुवान्। नरपतिरभवन्महांस्तदा व्यथितमना: प्रचचाल चासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]