[{"id": 2074638, "chapter_id": 2577, "verse_number": "१२-८२-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2074639, "chapter_id": 2577, "verse_number": "१२-८२-१", "content_sanskrit": "एषा प्रथमतो वृत्तिर्द्वितीयां शृणु भारत।\nयः कश्चिद्वेदयेदर्थं राज्ञा रक्ष्यः स मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2074640, "chapter_id": 2577, "verse_number": "१२-८२-२", "content_sanskrit": "ह्रियमाणममात्येन भृत्यो वा यदि वा भृतः।\nयो राजकोशं नश्यन्तमाचक्षीत युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2074641, "chapter_id": 2577, "verse_number": "१२-८२-३", "content_sanskrit": "श्रोतव्यमस्य च रहो रक्ष्यश्चामात्यतो भवेत्।\nअमात्या ह्यपहर्तारो भूयिष्ठं घ्नन्ति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2074642, "chapter_id": 2577, "verse_number": "१२-८२-४", "content_sanskrit": "राजकोशस्य गोप्तारं राजकोशविलोपकाः।\nसमेत्य सर्वे बाधन्ते स विनश्यत्यरक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2074643, "chapter_id": 2577, "verse_number": "१२-८२-५", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nमुनिः कालकवृक्षीयः कौसल्यं यदुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2074644, "chapter_id": 2577, "verse_number": "१२-८२-६", "content_sanskrit": "कोसलानामाधिपत्यं संप्राप्तं क्षेमदर्शिनम्।\nमुनिः कालकवृक्षीय आजगोमेति नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2074645, "chapter_id": 2577, "verse_number": "१२-८२-७", "content_sanskrit": "स काकं पञ्जरे बद्ध्वा विषयं क्षेमदर्शिनः।\nसर्वं पर्यचरद्युक्तः प्रवृत्त्यर्थी पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2074646, "chapter_id": 2577, "verse_number": "१२-८२-८", "content_sanskrit": "अधीये वायसीं विद्यां शंसन्ति मम वायसाः।\nअनागतमतीतं च यच्च संप्रति वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2074647, "chapter_id": 2577, "verse_number": "१२-८२-९", "content_sanskrit": "इति राष्ट्रे परिपतन्बहुभिः पुरुषैः सह।\nसर्वेषां राजयुक्तानां दुष्कृतं परिदृष्टवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2074648, "chapter_id": 2577, "verse_number": "१२-८२-१०", "content_sanskrit": "स बुद्ध्वा तस्य राष्ट्रस्य व्यवसायं हि सर्वशः।\nराजयुक्तापचारांश्च सर्वान्बुद्ध्वा ततस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2074649, "chapter_id": 2577, "verse_number": "१२-८२-११", "content_sanskrit": "ततः स काकमादाय राजानं द्रष्टुमागमत्।\nसर्वज्ञोऽस्मीति वचनं ब्रुवाणः संशितव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2074650, "chapter_id": 2577, "verse_number": "१२-८२-१२", "content_sanskrit": "स स्म कौसल्यमागम्य राजामात्यमलंकृतम्।\nप्राह काकस्य वचनादमुत्रेदं त्वया कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2074651, "chapter_id": 2577, "verse_number": "१२-८२-१३", "content_sanskrit": "असौ चासौ च जानीते राजकेशस्त्वया हृतः।\nएवमाख्याति काकोऽयं तच्छीघ्रमनुगम्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2074652, "chapter_id": 2577, "verse_number": "१२-८२-१४", "content_sanskrit": "तथाऽन्यानपि स प्राह राजकोशहरांस्तदा।\nन चास्य वचनं किंचिदनृतं श्रूयते क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2074653, "chapter_id": 2577, "verse_number": "१२-८२-१५", "content_sanskrit": "तेन विप्रकृताः सर्वे राजयुक्ताः कुरूद्वह।\nतमतिक्रम्य सुप्तं तु निशि काकमपोथयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2074654, "chapter_id": 2577, "verse_number": "१२-८२-१६", "content_sanskrit": "वायसं तु विनिर्भिन्नं दृष्ट्वा वाणेन पञ्जरे।\nपूर्वाह्णे ब्राह्मणो वाक्यं क्षेमदर्शिनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2074655, "chapter_id": 2577, "verse_number": "१२-८२-१७", "content_sanskrit": "राजंस्त्वामभयं याचे प्रभुं प्राणधनेश्वरम्।\nअनुज्ञातस्त्वया ब्रूयां वचनं भवतो हितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2074656, "chapter_id": 2577, "verse_number": "१२-८२-१८", "content_sanskrit": "मित्रार्थमभिसंतप्तो भक्त्या सर्वात्मनाऽऽगतः।\nह्रियन्ते हि महार्थाश्च पुरुषे विक्रमत्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2074657, "chapter_id": 2577, "verse_number": "१२-८२-१९", "content_sanskrit": "संबुबोधयिषुर्मित्रं सदश्वमिव सारथिः।\nअतिमन्युप्रसक्तो हि प्रसह्य हितकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2074658, "chapter_id": 2577, "verse_number": "१२-८२-२०", "content_sanskrit": "तथाविधस्य सुहृदा क्षन्तव्यं संविजानता।\nऐश्वर्यमिच्छता नित्यं पुरुषेण बुभूषता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2074659, "chapter_id": 2577, "verse_number": "१२-८२-२१", "content_sanskrit": "तं राजा प्रत्युवाचेदं यत्किंचिन्मां भवान्वदेत्।\nकस्मादहं न क्षमेयमाकाङ्क्षन्नात्मनो हितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2074660, "chapter_id": 2577, "verse_number": "१२-८२-२२", "content_sanskrit": "ब्राह्मण प्रतिजाने ते प्रब्रूहि यदिहेच्छसि।\nकरिष्यामि हि ते वाक्यं यन्मां विप्र प्रवक्ष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2074661, "chapter_id": 2577, "verse_number": "१२-८२-२३x", "content_sanskrit": "मुनिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2074662, "chapter_id": 2577, "verse_number": "१२-८२-२३", "content_sanskrit": "विद्वान्नयानपायांश्च भयाख्यातॄन्भयानि च।\nभक्त्या वृत्तिं समाख्यातुं भवतोऽन्तिकमागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2074663, "chapter_id": 2577, "verse_number": "१२-८२-२४", "content_sanskrit": "प्रागेवोक्तं तु दोषोऽयमाचार्यैर्नृपसेवनम्।\nअगतेः कुगतिर्ह्येषा या राज्ञा सहजीविका॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2074664, "chapter_id": 2577, "verse_number": "१२-८२-२५", "content_sanskrit": "आशीविषैश्च तस्याहुः संगमं यस्य राजभिः।\nबहुमित्रांश्च राजानो बह्वभित्रास्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2074665, "chapter_id": 2577, "verse_number": "१२-८२-२६", "content_sanskrit": "तेभ्यः सर्वेभ्य एवाहुर्भयं राजोपजीविनाम्।\nतथाऽस्य राजतो राजन्मुहुर्तादागतं भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2074666, "chapter_id": 2577, "verse_number": "१२-८२-२७", "content_sanskrit": "नैकान्तेनाप्रमादो हि शक्यः कर्तुं महीपतौ।\nन तु प्रमादः कर्तव्यः कथंचिद्भूतिमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2074667, "chapter_id": 2577, "verse_number": "१२-८२-२८", "content_sanskrit": "प्रमादात्स्खलते बुद्धिः स्खलतो नास्ति जीवितम्।\nअग्निं दीप्तमिवासीदेद्राजानप्नुपशिक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2074668, "chapter_id": 2577, "verse_number": "१२-८२-२९", "content_sanskrit": "आशीविषमिव क्रुद्धं प्रभुं प्राणधनेश्वरम्।\nयत्नेनोपचरेन्नित्यं नाहमस्मीति मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2074669, "chapter_id": 2577, "verse_number": "१२-८२-३०", "content_sanskrit": "दुर्व्याहृताच्छङ्कमानो दुःस्थिताद्दुरनुष्ठितात्।\nदुरासदाद्दुर्वृजिनादिङ्गिताद्ध्यायितादपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2074670, "chapter_id": 2577, "verse_number": "१२-८२-३१", "content_sanskrit": "देवतेव हि सर्वार्थान्कुर्याद्राजा प्रसादितः।\nवैश्वानर इव क्रुद्धः समूलमपि निर्दहेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2074671, "chapter_id": 2577, "verse_number": "१२-८२-३२", "content_sanskrit": "इति राजन्यमः प्राह वर्तते च तथैव तत्।\nअथ भूयांसमेवार्थं करिष्यामि पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2074672, "chapter_id": 2577, "verse_number": "१२-८२-३३", "content_sanskrit": "ददात्यत्मद्विधोऽऽमात्यो बुद्धिसाहाय्यमापदि।\nवायसस्त्वेष मे राजन्नन्तकायाभिसंहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2074673, "chapter_id": 2577, "verse_number": "१२-८२-३४", "content_sanskrit": "न च मेऽत्र भवान्गर्ह्यो न च येषां भवान्प्रियः।\nहिताहितांस्तु बुद्ध्येथा मापरोक्षमतिर्भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2074674, "chapter_id": 2577, "verse_number": "१२-८२-३५", "content_sanskrit": "ये त्वादानपरा एव वसन्ति भवतो गृहे।\nअभूतिकामा भूतानां तादृशैर्मेऽभिसंहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2074675, "chapter_id": 2577, "verse_number": "१२-८२-३६", "content_sanskrit": "यो वा भवद्विनाशेन राज्यमिच्छत्यनन्तरम्।\nआन्तरैराभेसंधाय राजन्सिद्ध्यति नान्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2074676, "chapter_id": 2577, "verse_number": "१२-८२-३७", "content_sanskrit": "तेषामहं भयाद्राजन्गमिष्याम्यन्यमाश्रमम्।\nतैर्हि मे संधितो बाणः काके निपतितः प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2074677, "chapter_id": 2577, "verse_number": "१२-८२-३८", "content_sanskrit": "छझना मम काकश्च गमितो यमसादनम्।\nदृष्टं ह्येतन्मया राजंस्तपोदीर्घेन चक्षुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2074678, "chapter_id": 2577, "verse_number": "१२-८२-३९", "content_sanskrit": "बहुनक्रझषग्राहां तिमिंगिलगणैर्युताम्।\nकाकेन वालिशेनेमामतार्षमहमापगाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2074679, "chapter_id": 2577, "verse_number": "१२-८२-४०", "content_sanskrit": "स्थाण्वश्मकण्टकवर्तीं सिंह व्याघ्रसमाकुलाम्।\nदुरासदां दुष्प्रसहां गुहां हैमवतीमिव।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2074680, "chapter_id": 2577, "verse_number": "१२-८२-४१", "content_sanskrit": "अग्निना तामसं दुर्गं नौभिराप्यं च गम्यते।\nराजदुर्गावतरणे नोपायं पण्डिता विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2074681, "chapter_id": 2577, "verse_number": "१२-८२-४२", "content_sanskrit": "गहनं भवतो राज्यमन्धकारं तमोन्वितम्।\nनेह विश्वसितुं शक्यं भवताऽपि कुतो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2074682, "chapter_id": 2577, "verse_number": "१२-८२-४३", "content_sanskrit": "अतो नायं शुभो वासस्तुल्ये सदसती इह।\nवधो ह्येवात्र सुकृते दुष्कृते न च संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2074683, "chapter_id": 2577, "verse_number": "१२-८२-४४", "content_sanskrit": "न्यायतो दुष्कृते घातः सुकृते न कथनम्।\nनेह युक्तं स्थिरं स्थातुं जवेनैवाव्रजेद्वुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2074684, "chapter_id": 2577, "verse_number": "१२-८२-४५", "content_sanskrit": "सीता नाम नदी राजन्प्लवो यस्यां निमज्जति।\nतयोपमामिमां मन्ये वागुरां सर्वधातिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2074685, "chapter_id": 2577, "verse_number": "१२-८२-४६", "content_sanskrit": "मधुप्रपातो हि भवान्भोजनं विषसंयुतम्।\nअसतामिव ते भावो वर्तते न सतामिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2074686, "chapter_id": 2577, "verse_number": "१२-८२-४७", "content_sanskrit": "आशीविषैः परिवृतः कूपस्त्वमसि पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2074687, "chapter_id": 2577, "verse_number": "१२-८२-४८", "content_sanskrit": "दुर्गतीर्था बृहत्कूला कावेरी चोरसंयुता।\nनदी मधुरपानीया यथा राजंस्तथा भवान्।\nश्वगृध्रगोमायुयुतो राजहंससमो ह्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2074688, "chapter_id": 2577, "verse_number": "१२-८२-४९", "content_sanskrit": "यथाऽऽश्रित्य महावृक्षं कक्षः संवर्धते महान्।\nततस्तं संवृणोत्येव तमतीत्य च वर्धते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2074689, "chapter_id": 2577, "verse_number": "१२-८२-५०", "content_sanskrit": "तेनैवोग्रेन्धनेनैनं दावो दहति दारुणः।\nतथोपमा ह्यमात्यास्ते राजंस्तान्परिशोधय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2074690, "chapter_id": 2577, "verse_number": "१२-८२-५१", "content_sanskrit": "त्वया चैव कृता राजन्भवता परिपालिताः।\nभवन्तं पर्यवज्ञाय जिघांसन्ति भवत्प्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2074691, "chapter_id": 2577, "verse_number": "१२-८२-५२", "content_sanskrit": "उषितं शङ्कमानेन प्रमादं परिरक्षता।\nअन्तः सर्प इवागारे वीरपत्न्या इवालये।\nशीलं जिज्ञासमानेन राज्ञः साहसजीविनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2074692, "chapter_id": 2577, "verse_number": "१२-८२-५३", "content_sanskrit": "कच्चिज्जितेन्द्रियो राजा कच्चिदस्यान्तरा जिताः।\nकच्चिदेषां प्रियो राजा कच्चिद्राज्ञः प्रियाः प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2074693, "chapter_id": 2577, "verse_number": "१२-८२-५४", "content_sanskrit": "विजिज्ञासुरिह प्राप्तस्तवाहं राजसत्तम।\nतस्य मे रोचते राजन्क्षुधितस्येव भोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2074694, "chapter_id": 2577, "verse_number": "१२-८२-५५", "content_sanskrit": "अमात्या मे न रोचन्ते वितृष्णस्य यथोदकम्।\nभवतोऽर्थकृदित्येवं मयि ते दोषमादधन्।\nविद्यते कारणं नान्यदिति मे नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2074695, "chapter_id": 2577, "verse_number": "१२-८२-५६", "content_sanskrit": "न हि तेषामहं द्रोग्धा तत्तेषां द्रोहवद्गतम्।\nअरेर्हि दुर्हृदाद्भेयं भग्नपृष्ठादिवोरगात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2074696, "chapter_id": 2577, "verse_number": "१२-८२-५७x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2074697, "chapter_id": 2577, "verse_number": "१२-८२-५७", "content_sanskrit": "भूयसा परिहारेण सत्कारेण च भूयसा।\nपूजितो ब्राह्मणश्रेष्ठ भूयो वस गृहे मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2074698, "chapter_id": 2577, "verse_number": "१२-८२-५८", "content_sanskrit": "ये त्वां ब्राह्मण नेच्छन्ति ते न वत्स्यन्ति मे गृहे।\nभवतैव हि तज्ज्ञेयं यत्तदेषामनन्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2074699, "chapter_id": 2577, "verse_number": "१२-८२-५९", "content_sanskrit": "यथा स्यात्सुधृतो दण्डो यथा च सुकृतं कृतम्।\nतथा समीक्ष्य भगवञ्श्रेयसे विनियुङ्क्ष्व माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2074700, "chapter_id": 2577, "verse_number": "१२-८२-६०x", "content_sanskrit": "मुनिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2074701, "chapter_id": 2577, "verse_number": "१२-८२-६०", "content_sanskrit": "अदर्शयन्निमं दोषमेकैकं दुर्बलं कुरु।\nततः कारणमाज्ञाय पुरुषंपुरुषं जहि।\nएकदोषा हि बहवो मृद्गीयुरपि कण्टकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2074702, "chapter_id": 2577, "verse_number": "१२-८२-६१", "content_sanskrit": "`अर्थे सर्वं जगद्वद्धमर्थेनैव निबध्यते।\nअर्थे दर्पो मनुष्याणां तस्मादर्थं विरोचय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2074703, "chapter_id": 2577, "verse_number": "१२-८२-६२", "content_sanskrit": "एकेनैकस्य दोषेण तद्विरुद्धं प्रचोदय।\nस तस्य दोषानुद्भाव्य तस्यार्थं ग्राहयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2074704, "chapter_id": 2577, "verse_number": "१२-८२-६३", "content_sanskrit": "सामपूर्वं च केषांचिद्भेदेन च परस्परम्।\nवैरं कारय भूपाल पश्चाद्दण्डं प्रचोदय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2074705, "chapter_id": 2577, "verse_number": "१२-८२-६४", "content_sanskrit": "बिल्वेन च यथा बिल्वमाकारं छाद्य बुद्धिमान्।\nअशुद्धं सचिवं राजन्नशुद्धेनैव नाशय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2074706, "chapter_id": 2577, "verse_number": "१२-८२-६५", "content_sanskrit": "मन्त्रभेदभयाद्राजंस्तस्मादेतद्ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2074707, "chapter_id": 2577, "verse_number": "१२-८२-६६", "content_sanskrit": "वयं तु ब्राह्मणा नाम मृदुदण्डाः कृपालवः।\nस्वस्ति चेच्छाम भवतः परेषां च यथाऽऽत्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2074708, "chapter_id": 2577, "verse_number": "१२-८२-६७", "content_sanskrit": "राजन्नात्मानमाचक्षे संबन्धी भवतो ह्यहम्।\nमुनिः कालकवृक्षीय इत्येवमभिसंज्ञितः।\nपितुः सखा च भवतः संमतः सत्यसंगरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2074709, "chapter_id": 2577, "verse_number": "१२-८२-६८", "content_sanskrit": "व्यापन्ने भवतो राज्ये राजन्पितरि संस्थिते।\nसर्वकामान्परित्यज्य तपस्तप्तं तदा मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2074710, "chapter_id": 2577, "verse_number": "१२-८२-६९", "content_sanskrit": "स्नेहात्त्वां तु ब्रवीम्येतन्मा भूयो विभ्रो दिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2074711, "chapter_id": 2577, "verse_number": "१२-८२-७०", "content_sanskrit": "उभे दृष्ट्वा दुःखसुखे राज्यं प्राप्य यदृच्छया।\nराज्येनामात्यसंस्थेन कथं राजन्प्रमाद्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2074712, "chapter_id": 2577, "verse_number": "१२-८२-७१x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2074713, "chapter_id": 2577, "verse_number": "१२-८२-७१", "content_sanskrit": "ततो राजकुले नान्दी संजज्ञे भूयसा पुनः।\nपुरोहितकुले चैव संप्राप्ते ब्राह्मणर्षभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2074714, "chapter_id": 2577, "verse_number": "१२-८२-७२", "content_sanskrit": "एकच्छत्रां महीं कृत्वा कौसल्याय यशस्विने।\nमुनिः कालकवृक्षीय ईजे क्रतुभिरुत्तमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2074715, "chapter_id": 2577, "verse_number": "१२-८२-७३", "content_sanskrit": "हितं तद्वचनं श्रुत्वा कौसल्योऽप्यजयन्महीम्।\nतथा च कृतवान्राजा यथोक्तं तेन भारत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2074716, "chapter_id": 2577, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि द्व्यशीतितमोऽध्यायः॥ ८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}]