[{"id": 6000307000, "chapter_id": 10307, "verse_number": null, "content_sanskrit": "षष्ठाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000307001, "chapter_id": 10307, "verse_number": null, "content_sanskrit": "बादरायणिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.001.m4a", "display_order": 2}, {"id": 6000307002, "chapter_id": 10307, "verse_number": "११-६-१", "content_sanskrit": "अथ ब्रह्मात्मजैर्दैवैः प्रजेशैरावृतोऽभ्यगात्।\nभवश्च भूतभव्येशो ययौ भूतगणैर्वृतः॥ ११/६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.002.m4a", "display_order": 3, "topics": [{"text": "ब्रह्मादिदेवैः श्रीकृष्णस्य स्वलोकगमनाय प्रार्थनम्", "range": "१–३३"}]}, {"id": 6000307003, "chapter_id": 10307, "verse_number": "११-६-२", "content_sanskrit": "इन्द्रो मरुद्भिर्भगवानादित्यो वसवोऽश्विनौ।\nऋभवोऽङ्गिरसो रुद्रा विश्वे साध्याश्च देवताः॥ ११/६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.003.m4a", "display_order": 4}, {"id": 6000307004, "chapter_id": 10307, "verse_number": "११-६-३", "content_sanskrit": "गन्धर्वाप्सरसो नागाः सिद्धचारणगुह्यकाः।\nऋषयः पितरश्चैव सविद्याधरकिन्नराः॥ ११/६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.004.m4a", "display_order": 5}, {"id": 6000307005, "chapter_id": 10307, "verse_number": "११-६-४", "content_sanskrit": "द्वारकामुपसंजग्मुः सर्वे कृष्णदिदृक्षवः। वपुषा येन भगवान् नरलोकमनोरमः।\nयशो वितन्वन् लोकेषु सर्वलोकमलापहम्॥ ११/६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.005.m4a", "display_order": 6}, {"id": 6000307006, "chapter_id": 10307, "verse_number": "११-६-५", "content_sanskrit": "तस्यां विभ्राजमानायां समृद्धायां महर्षिभिः।\nव्यचक्षतावितृप्ताक्षाः कृष्णमद्भुतदर्शनम्॥ ११/६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.006.m4a", "display_order": 7}, {"id": 6000307007, "chapter_id": 10307, "verse_number": "११-६-६", "content_sanskrit": "स्वर्गोद्यानोद्भवैर्माल्यैश्छादयन्तो यदूत्तमम्।\nगीर्भिश्चित्रपदार्थाभिस्तुष्टुवुर्जगदीश्वरम्॥ ११/६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.007.m4a", "display_order": 8}, {"id": 6000307008, "chapter_id": 10307, "verse_number": null, "content_sanskrit": "देवा ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.008.m4a", "display_order": 9}, {"id": 6000307009, "chapter_id": 10307, "verse_number": "११-६-७", "content_sanskrit": "नताः स्म ते नाथ पदारविन्दं बुद्धीन्द्रियप्राणमनोवचोभिः।\nयच्चिन्त्यतेऽन्तर्हृदि भावयुक्तैर्मुमुक्षुभिः कर्ममयोरुपाशात्॥ ११/६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.009.m4a", "display_order": 10}, {"id": 6000307010, "chapter_id": 10307, "verse_number": "११-६-८", "content_sanskrit": "त्वं मायया त्रिगुणयाऽऽत्मनि दुर्विभाव्यं व्यक्तं सृजस्यवसि लुम्पसि तद्गुणस्थः।\nनैतैर्भवानजित कर्मभिरज्यते वै यः स्वे सुखेऽव्यवहितेऽभिरतोऽनवद्यः॥ ११/६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.010.m4a", "display_order": 11}, {"id": 6000307011, "chapter_id": 10307, "verse_number": "११-६-९", "content_sanskrit": "शुद्धिर्नृणां न तु तथेड्य दुराशयानां विद्याश्रुताध्ययनदानतपःक्रियाभिः।\nसत्त्वात्मनामृषभ ते यशसि प्रवृद्धसच्छ्रद्धया श्रवणसंभृतया यथा स्यात्॥ ११/६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.011.m4a", "display_order": 12}, {"id": 6000307012, "chapter_id": 10307, "verse_number": "११-६-१०", "content_sanskrit": "स्यान्नस्तवाङ्घ्रिरशुभाशयधूमकेतुः क्षेमाय यो मुनिभिरार्द्रहृदोह्यमानः।\nयः सात्त्वतैः समविभूतिभिरार्द्रहृद्भिर्व्यूह्यार्चितः सवनशः समविक्रमैश्च॥ ११/६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.012.m4a", "display_order": 13}, {"id": 6000307013, "chapter_id": 10307, "verse_number": "११-६-११", "content_sanskrit": "यश्चिन्त्यते प्रयतपाणिभिरध्वराग्नौ त्रय्या निरुक्तविधिना स्वहविर्गृहीत्वा।\nअध्यात्मयोग उत योगिभिरात्ममायाजिज्ञासुभिः परमभागवतैः परीष्टः॥ ११/६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.013.m4a", "display_order": 14}, {"id": 6000307014, "chapter_id": 10307, "verse_number": "११-६-१२", "content_sanskrit": "पर्युष्टया पतितया वनमालयेयं संस्पर्धिनी भगवती प्रतिपक्षवच्छ्रीः।\nयः सुप्रणीतममुयाऽर्हणमाददानो भूयात् सदाऽङ्घ्रिरशुभाशयधूमकेतुः॥ ११/६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.014.m4a", "display_order": 15}, {"id": 6000307015, "chapter_id": 10307, "verse_number": "११-६-१३", "content_sanskrit": "केतुस्‍त्रिविक्रमसतस्‍त्रिपतत्पताको यस्ते भयाभयकरोऽसुरदेवचम्वोः।\nस्वर्गाय साधुषु खलेष्वितराय भूम्नः पादः पुनातु भगवन् जगतामघं नः॥ ११/६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.015.m4a", "display_order": 16}, {"id": 6000307016, "chapter_id": 10307, "verse_number": "११-६-१४", "content_sanskrit": "नस्योतगाव इव यस्य वशे भवन्ति देवाश्च यस्तनुभृदायुषि रज्यमानाः।\nकालस्य ते प्रकृतिपूरुषयोः परस्य शं नस्तनोतु चरणः पुरुषोत्तमस्य॥ ११/६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.016.m4a", "display_order": 17}, {"id": 6000307017, "chapter_id": 10307, "verse_number": "११-६-१५", "content_sanskrit": "अस्यासि हेतुरुदयस्थितिसंयमानां अव्यक्तजीवमहतामपि कालमात्रः।\nसोऽयं त्रिणाभिरखिलापचये प्रवृत्तः कालो गभीररय उत्तमपूरुषस्त्वम्॥ ११/६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.017.m4a", "display_order": 18}, {"id": 6000307018, "chapter_id": 10307, "verse_number": "११-६-१६", "content_sanskrit": "त्वत्तः प्रधानमधिकृत्य पुमान् स्ववीर्यं धत्ते महान्तमिव गर्भममोघवीर्यः।\nसोऽयं त्वयाऽनुगत आत्मन आण्डकोशं हैमं ससर्ज बहिरावरणैरुपेतम्॥ ११/६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.018.m4a", "display_order": 19}, {"id": 6000307019, "chapter_id": 10307, "verse_number": "११-६-१७", "content_sanskrit": "तत् तस्थुषश्च जगतश्च भवानधीशो यन्माययोत्थगुणविक्रिययोपनीतान्।\nअर्थान् जुषन्नपि हृषीकपते न लिप्तो येऽन्ये स्वतः परिहृतानपि बिभ्यति स्म॥ ११/६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.019.m4a", "display_order": 20}, {"id": 6000307020, "chapter_id": 10307, "verse_number": "११-६-१८", "content_sanskrit": "स्मायावलोकलवदर्शितभावहारिभ्रूमण्डलप्रहितसौरतमन्त्रशौण्डैः।\nपत्न्यस्तु षोडशसहस्रमनङ्गबाणैर्यस्येन्द्रियं विमथितुं कुहकैर्न शेकुः॥ ११/६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.020.m4a", "display_order": 21}, {"id": 6000307021, "chapter_id": 10307, "verse_number": "११-६-१९", "content_sanskrit": "बिभ्रत् तवामृतकथोदवहास्‍त्रिलोक्याः पादावनेजसरितः शमलानि हन्तुम्।\nआनुश्रवं श्रुतिभिरङ्घ्रिजमङ्गसङ्गैस्तीर्थद्वयं शुचिषदस्तदुपस्पृशन्ति॥ ११/६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.021.m4a", "display_order": 22}, {"id": 6000307022, "chapter_id": 10307, "verse_number": null, "content_sanskrit": "बादरायणिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.022.m4a", "display_order": 23}, {"id": 6000307023, "chapter_id": 10307, "verse_number": "११-६-२०", "content_sanskrit": "इत्यभिष्टूय विबुधैः सेशः सत्यधृतिर्हरिम्।\nअभ्यभाषत गोविन्दं प्रणम्याम्बरमाश्रितः॥ ११/६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.023.m4a", "display_order": 24}, {"id": 6000307024, "chapter_id": 10307, "verse_number": null, "content_sanskrit": "ब्रह्मोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.024.m4a", "display_order": 25}, {"id": 6000307025, "chapter_id": 10307, "verse_number": "११-६-२१", "content_sanskrit": "भूमेर्भारावतराय पुरा विज्ञापितः प्रभो।\nत्वमस्माभिरशेषात्मंस्तत् तथैवोपपादितम्॥ ११/६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.025.m4a", "display_order": 26}, {"id": 6000307026, "chapter_id": 10307, "verse_number": "११-६-२२", "content_sanskrit": "धर्मश्च स्थापितः सत्सु सत्यसन्धेषु वै त्वया।\nकीर्तिश्च दिक्षु विक्षिप्ता सर्वलोकमलापहा॥ ११/६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.026.m4a", "display_order": 27}, {"id": 6000307027, "chapter_id": 10307, "verse_number": "११-६-२३", "content_sanskrit": "अवतीर्य यदोर्वंशे बिभ्रद्रूपमनुत्तमम्।\nकर्माण्युदारवृत्तानि हितानि जगतोऽकृथाः॥ ११/६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.027.m4a", "display_order": 28}, {"id": 6000307028, "chapter_id": 10307, "verse_number": "११-६-२४", "content_sanskrit": "यानि ते चरितानीश मनुष्याः साधवः कलौ।\nशृण्वन्तः कीर्तयन्तश्च तरिष्यन्त्यञ्जसा तमः॥ ११/६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.028.m4a", "display_order": 29}, {"id": 6000307029, "chapter_id": 10307, "verse_number": "११-६-२५", "content_sanskrit": "यदुवंशेऽवतीर्णस्य भवतः पुरुषोत्तम।\nशरच्छतं व्यतीयाय पञ्चविंशाधिकं प्रभो॥ ११/६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.029.m4a", "display_order": 30}, {"id": 6000307030, "chapter_id": 10307, "verse_number": "११-६-२६", "content_sanskrit": "नाधुना तेऽखिलाधार देवकार्येऽवशेषितम्।\nकुलं च विप्रशापेन नष्टप्रायमभूदिदम्॥ ११/६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.030.m4a", "display_order": 31}, {"id": 6000307031, "chapter_id": 10307, "verse_number": "११-६-२७", "content_sanskrit": "ततः स्वधाम परमं विशस्व यदि मन्यसे।\nसलोकं लोकपालान् नः पाहि वैकुण्ठकिङ्करान्॥ ११/६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.031.m4a", "display_order": 32}, {"id": 6000307032, "chapter_id": 10307, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.032.m4a", "display_order": 33}, {"id": 6000307033, "chapter_id": 10307, "verse_number": "११-६-२८", "content_sanskrit": "संस्तुतो भगवानित्थं विबुधैः पद्मजादिभिः।\nप्रतिनन्द्याह तान् राजन् मायामनुज ईश्वरः॥ ११/६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.033.m4a", "display_order": 34}, {"id": 6000307034, "chapter_id": 10307, "verse_number": null, "content_sanskrit": "श्री भगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.034.m4a", "display_order": 35}, {"id": 6000307035, "chapter_id": 10307, "verse_number": "११-६-२९", "content_sanskrit": "अवधारितमेतन्मे यदात्थ विबुधेश्वराः।\nकृतं वः कार्यमखिलं भूमेर्भारोऽवतारितः॥ ११/६/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.035.m4a", "display_order": 36}, {"id": 6000307036, "chapter_id": 10307, "verse_number": "११-६-३०", "content_sanskrit": "तदिदं यादवकुलं वीर्यशौर्यश्रियोद्धतम्।\nलोकं जिघृक्षत्यूर्ध्वं मे वेलामिव महार्णवः॥ ११/६/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.036.m4a", "display_order": 37}, {"id": 6000307037, "chapter_id": 10307, "verse_number": "११-६-३१", "content_sanskrit": "यद्यसंहृत्य दृप्तानां यदूनां विपुलं कुलम्।\nगन्तास्म्यनेन लोकोऽयमुल्बणेन विनङ्‌क्ष्यति॥ ११/६/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.037.m4a", "display_order": 38}, {"id": 6000307038, "chapter_id": 10307, "verse_number": "११-६-३२", "content_sanskrit": "इदानीं नाश आरब्धः कुलस्य द्विजशापतः।\nयास्यामि भवनं ब्रह्मन्नेतदन्ते तवानघ॥ ११/६/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.038.m4a", "display_order": 39}, {"id": 6000307039, "chapter_id": 10307, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.039.m4a", "display_order": 40}, {"id": 6000307040, "chapter_id": 10307, "verse_number": "११-६-३३", "content_sanskrit": "इत्युक्तो लोकनाथेन स्वयम्भूः प्रणिपत्य तम्।\nसह देवगणैर्देवः स्वं धाम समपद्यत॥ ११/६/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.040.m4a", "display_order": 41}, {"id": 6000307041, "chapter_id": 10307, "verse_number": "११-६-३४", "content_sanskrit": "अथ तस्यां महोत्पातान् द्वारवत्यां समुत्थितान्।\nविलोक्य भगवानाह यदुवृद्धान् समागतान्॥ ११/६/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.041.m4a", "display_order": 42}, {"id": 6000307042, "chapter_id": 10307, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.042.m4a", "display_order": 43}, {"id": 6000307043, "chapter_id": 10307, "verse_number": "११-६-३५", "content_sanskrit": "एते वै सुमहोत्पाता ह्युत्तिष्ठन्तीह सर्वतः।\nशापश्च नः कुलस्यासीद् ब्राह्मणेभ्यो दुरत्ययः॥ ११/६/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.043.m4a", "display_order": 44, "topics": [{"text": "भगवता यादवानां प्रभासगमनार्थमाज्ञापनम्", "range": "३५–४०"}]}, {"id": 6000307044, "chapter_id": 10307, "verse_number": "११-६-३६", "content_sanskrit": "न वस्तव्यमिहास्माभिर्जिजीविषुभिरार्यकाः।\nप्रभासं सुमहापुण्यं यास्यामोऽद्यैव मा चिरम्॥ ११/६/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.044.m4a", "display_order": 45}, {"id": 6000307045, "chapter_id": 10307, "verse_number": "११-६-३७", "content_sanskrit": "यत्र स्नात्वा दक्षशापात् गृहीतो यक्ष्मणोडुराट्।\nविमुक्तः किल्बिषात्सद्यो भेजे भूयः कलोदयम्॥ ११/६/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.045.m4a", "display_order": 46}, {"id": 6000307046, "chapter_id": 10307, "verse_number": "११-६-३८", "content_sanskrit": "वयं च तस्मिन्नाप्लुत्य तर्पयित्वा पितॄन् सुरान्।\nभोजयित्वोषिजो विप्रान् नानागुणवतान्धसा॥ ११/६/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.046.m4a", "display_order": 47}, {"id": 6000307047, "chapter_id": 10307, "verse_number": "११-६-३९", "content_sanskrit": "तेषु दानानि पात्रेषु श्रद्धयाऽर्प्य महान्ति वै।\nवृजिनानि तरिष्यामो दानैर्नौभिरिवार्णवम्॥ ११/६/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.047.m4a", "display_order": 48}, {"id": 6000307048, "chapter_id": 10307, "verse_number": null, "content_sanskrit": "श्री शुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.048.m4a", "display_order": 49}, {"id": 6000307049, "chapter_id": 10307, "verse_number": "११-६-४०", "content_sanskrit": "एवं भगवताऽदिष्टा यादवाः कुरुनन्दन।\nगन्तुं कृतधियस्तीर्थं स्यन्दनान् समयूयुजन्॥ ११/६/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.049.m4a", "display_order": 50}, {"id": 6000307050, "chapter_id": 10307, "verse_number": "११-६-४१", "content_sanskrit": "तान् निरीक्ष्योद्धवो राजन् श्रुत्वा भगवतोदितम्।\nदृष्ट्वाऽनिष्टानि घोराणि नित्यं कृष्णमनुव्रतः॥ ११/६/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.050.m4a", "display_order": 51, "topics": [{"text": "भगवतो भूलोकत्यागेच्छां ज्ञातवतोद्धवेन स्वस्यापि परलोकनयनप्रार्थना", "range": "४१–५१"}]}, {"id": 6000307051, "chapter_id": 10307, "verse_number": "११-६-४२", "content_sanskrit": "विविक्त उपसंगम्य जगतामीश्वरेश्वरम्।\nप्रणम्य शिरसा पादौ प्राञ्जलिस्तमभाषत॥ ११/६/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.051.m4a", "display_order": 52}, {"id": 6000307052, "chapter_id": 10307, "verse_number": null, "content_sanskrit": "उद्धव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.052.m4a", "display_order": 53}, {"id": 6000307053, "chapter_id": 10307, "verse_number": null, "content_sanskrit": "देवदेवेश योगेश पुण्यश्रवणकीर्तन।\nसंहृत्यैतत्कुलं नूनं लोकं संत्यक्ष्यते भवान्॥ ११/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.053.m4a", "display_order": 54}, {"id": 6000307054, "chapter_id": 10307, "verse_number": "११-६-४३", "content_sanskrit": "विप्रशापं समर्थोऽपि प्रत्यहन्न यदीश्वरः॥ ११/६/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.054.m4a", "display_order": 55}, {"id": 6000307055, "chapter_id": 10307, "verse_number": "११-६-४४", "content_sanskrit": "नाहं तवाङ्घ्रियुगलं क्षणार्धमपि केशव।\nत्यक्तुं समुत्सहे नाथ स्वधाम नय मामपि॥ ११/६/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.055.m4a", "display_order": 56}, {"id": 6000307056, "chapter_id": 10307, "verse_number": "११-६-४५", "content_sanskrit": "तव विक्रीडितं कृष्ण नृणां परममङ्गलम्।\nकर्णपीयूषमासाद्य त्यजत्यन्यस्पृहां जनः॥ ११/६/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.056.m4a", "display_order": 57}, {"id": 6000307057, "chapter_id": 10307, "verse_number": "११-६-४६", "content_sanskrit": "शय्याटनासनस्थानस्नानक्रीडाशनादिषु।\nकथं त्वां प्रियमात्मानं वयं भक्तास्त्यजेमहि॥ ११/६/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.057.m4a", "display_order": 58}, {"id": 6000307058, "chapter_id": 10307, "verse_number": "११-६-४७", "content_sanskrit": "त्वयोपभुक्तस्रग्गन्धवासोऽलङ्कारचर्चिताः।\nउच्छिष्टभोजिनो दासास्तव मायां जयेमहि॥ ११/६/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.058.m4a", "display_order": 59}, {"id": 6000307059, "chapter_id": 10307, "verse_number": "११-६-४८", "content_sanskrit": "वाताशना महर्षयः श्रमणा ऊर्ध्वमन्थिनः।\nब्रह्माख्यं धाम ते यान्ति शान्ताः संन्यासिनोऽमलाः॥ ११/६/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.059.m4a", "display_order": 60}, {"id": 6000307060, "chapter_id": 10307, "verse_number": "११-६-४९", "content_sanskrit": "वयं त्विह महायोगिन् भ्रमन्तः कर्मवर्त्मसु।\nत्वद्वार्तया तरिष्यामस्तावकैर्दुस्तरं तमः॥ ११/६/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.060.m4a", "display_order": 61}, {"id": 6000307061, "chapter_id": 10307, "verse_number": "११-६-५०", "content_sanskrit": "स्मरन्तः कीर्तयन्तस्ते कृतानि गदितानि च।\nगत्युत्स्मितेक्षणोत्केलिं यन्नृलोकविडम्बनम्॥ ११/६/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.061.m4a", "display_order": 62}, {"id": 6000307062, "chapter_id": 10307, "verse_number": null, "content_sanskrit": "श्री शुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.062.m4a", "display_order": 63}, {"id": 6000307063, "chapter_id": 10307, "verse_number": "११-६-५१", "content_sanskrit": "एवं विज्ञापितो राजन् भगवान् देवकीसुतः।\nएकान्तिनं प्रियं भृत्यमुद्धवं समभाषत॥ ११/६/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_006/BhP_11.006.063.m4a", "display_order": 64}, {"id": 6000307064, "chapter_id": 10307, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे षष्ठाध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]