[{"id": 2193832, "chapter_id": 5120, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2193833, "chapter_id": 5120, "verse_number": "१", "content_sanskrit": "यदा भक्तोभगवत आसीद्राजा महावसुः ।\nकिमर्थं स परिभ्रष्टो विवेश विवरं भुवः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2193834, "chapter_id": 5120, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2193835, "chapter_id": 5120, "verse_number": "२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nऋषीणां चैव संवादं त्रिदशानांच भारत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2193836, "chapter_id": 5120, "verse_number": "३", "content_sanskrit": "अजेन यष्टव्यमिति देवाः प्राहुर्द्विजोत्तमान् ।\nस च छागो ह्यजो ज्ञेयो नान्यः पशुरिति स्थितिः॥ ३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2193837, "chapter_id": 5120, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2193838, "chapter_id": 5120, "verse_number": "४", "content_sanskrit": "बीजैर्यज्ञेषुयष्टव्यमिति वै वैदिकी श्रुतिः ।\nअजसञ्ज्ञानि बीजानि छागं न घ्नन्तुमर्हथ\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2193839, "chapter_id": 5120, "verse_number": "५", "content_sanskrit": "नैष धर्मः सतां देवा यत्र वध्येत वै पशुः ।\nइदं कृतयुगं श्रेष्ठंकथं वध्येत वै पशुः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2193840, "chapter_id": 5120, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2193841, "chapter_id": 5120, "verse_number": "६", "content_sanskrit": "तेषां संवदतामेवमृषीणां विबुधैः सह ।\nमार्गागतो नृपश्रेष्ठस्तं देशं प्राप्तवान् वसुः॥\nअन्तरिक्षचरः श्रीमान् समग्रबलवाहनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2193842, "chapter_id": 5120, "verse_number": "७", "content_sanskrit": "तं दृष्ट्वा सहसायान्तं वसुं ते त्वन्तरिक्षगम् ।\nऊचुर्द्विजातयो देवानेष छेत्स्यति संशयम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2193843, "chapter_id": 5120, "verse_number": "८", "content_sanskrit": "यज्वा दानपतिः श्रेष्ठः सर्वभूतहितप्रियः ।\nकथं स्विदन्यथा ब्रूयाद्वाक्यमेष महान्वसुः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2193844, "chapter_id": 5120, "verse_number": "९", "content_sanskrit": "एवं ते संविदं कृत्वा विबुधा ऋषयस्तथा ।\nअपृच्छन् सहसाभ्येत्य वसुं राजानमन्तिकात्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2193845, "chapter_id": 5120, "verse_number": "१०", "content_sanskrit": "भो राजन्केन यष्टव्यमजेनाहो स्विदौषधैः ।\nएतन्नः संशयं छिन्धि प्रमाणं नोभवान् मतः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2193846, "chapter_id": 5120, "verse_number": "११", "content_sanskrit": "स तान्कृताञ्जलिर्भूत्वा परिपप्रच्छ वै वसुः ।\nकस्य वः को मतः पक्षो ब्रूत सत्यं समागताः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2193847, "chapter_id": 5120, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2193848, "chapter_id": 5120, "verse_number": "१२", "content_sanskrit": "धान्यैर्यष्टव्यमित्येष पक्षोऽस्माकं नराधिप ।\nदेवानां तु पशुः पक्षो मतो राजन् वदस्वनः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2193849, "chapter_id": 5120, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2193850, "chapter_id": 5120, "verse_number": "१३", "content_sanskrit": "देवानां तु मतं ज्ञात्वा वसुना पक्षसंश्रयात् ।\nछागेनाजेनयष्टव्यमेवमुक्तं वचस्तदा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2193851, "chapter_id": 5120, "verse_number": "१४", "content_sanskrit": "कुपितास्ते ततः सर्वे मुनयः सूर्यवर्चसः ।\nऊचुर्वसुं विमानस्थं देवपक्षार्थवादिनम्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2193852, "chapter_id": 5120, "verse_number": "१५", "content_sanskrit": "सुरपक्षो गृहीतस्ते यस्मात्तस्माद्दिवः पत ।\nअद्य प्रभृति ते राजन्नाकाशे विहता गतिः॥\nअस्मच्छापाभिघातेन महीं भित्त्वा प्रवेक्ष्यसि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2193853, "chapter_id": 5120, "verse_number": "१६", "content_sanskrit": "ततस्तस्मिन् मुहूर्तेऽथ राजोपरिचरस्तदा ।\nअधो वै सम्बभूवाशु भूमेर्विवरगो नृपः॥\nस्मृतिस्त्वेनं न प्रजहौ तदा नारायणाज्ञया॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2193854, "chapter_id": 5120, "verse_number": "१७", "content_sanskrit": "देवास्तु सहिताः सर्वे वसोः शापविमोक्षणम् ।\nचिन्तयामासुरव्यग्राः सुकृतंहि नृपस्य तत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2193855, "chapter_id": 5120, "verse_number": "१८", "content_sanskrit": "अनेनास्मत्कृते राज्ञा शापः प्राप्तो महात्मना ।\nअस्य प्रतिप्रियं कार्यं सहितैर्नो दिवौकसः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2193856, "chapter_id": 5120, "verse_number": "समाप्तिः", "content_sanskrit": "इति बुद्ध्या व्यवस्याशु गत्वा निश्चयमीश्वराः ।\nऊचुस्तं हृष्टमनसो राजोपरिचरं तदा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2193857, "chapter_id": 5120, "verse_number": "२०", "content_sanskrit": "ब्रह्मण्यदेवं त्वं भक्तःसुरासुरगुरुं हरिम् ।\nकामं स तव तुष्टात्मा कुर्याच्छापविमोक्षणम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2193858, "chapter_id": 5120, "verse_number": "२१", "content_sanskrit": "मानना तु द्विजातीनां कर्तव्या वै महात्मनाम् ।\nअवश्यं तपसा तेषां फलितव्यंनृपोत्तम\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2193859, "chapter_id": 5120, "verse_number": "२२", "content_sanskrit": "यतस्त्वं सहसा भ्रष्ट आकाशान्मेदिनीतलम् ।\nएकं त्वनुग्रहं तुभ्यं दद्मो वै नृपसत्तम\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2193860, "chapter_id": 5120, "verse_number": "२३", "content_sanskrit": "यावत्त्वं शापदोषेण कालमासिष्यसेऽनघ ।\nभूमेर्विवरगो भूत्वा तावन्तं कालमाप्स्यसि॥\nयज्ञेषु सुहुतां विप्रैर्वसोर्धारां महात्मभिः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2193861, "chapter_id": 5120, "verse_number": "२४", "content_sanskrit": "प्राप्स्यसेऽस्मदनुध्यानान्मा च त्वां ग्लानिरास्पृशेत् ।\nन क्षुत्पिपासे राजेन्द्र भूमेश्छिद्रे भविष्यतः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2193862, "chapter_id": 5120, "verse_number": "२५", "content_sanskrit": "वसोर्धारानुपीतत्वात्तेजसाप्यायितेन च ।\nस देवोऽस्मद्वरात् प्रीतो ब्रह्मलोकं हि नेष्यति\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2193863, "chapter_id": 5120, "verse_number": "२६", "content_sanskrit": "एवं दत्त्वा वरं राज्ञेसर्वे तत्र दिवौकसः ।\nगताः स्वभवनं देवा ऋषयश्च तपोधनाः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2193864, "chapter_id": 5120, "verse_number": "२७", "content_sanskrit": "चक्रे च सततं पूजां विष्वक्सेनाय भारत ।\nजप्यं जगौ च सततं नारायणमुखोद्गतम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2193865, "chapter_id": 5120, "verse_number": "२८", "content_sanskrit": "तत्रापि पञ्चभिर्यज्ञैः पञ्चकालानरिन्दम ।\nअयजद्धरिं सुरपतिंभूमेर्विवरगोऽपि सन्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2193866, "chapter_id": 5120, "verse_number": "२९", "content_sanskrit": "ततोऽस्य तुष्टो भगवान् भक्त्या नारायणो हरिः ।\nअनन्यभक्तस्य सतस्तत्परस्य जितात्मनः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2193867, "chapter_id": 5120, "verse_number": "३०", "content_sanskrit": "वरदोभगवान् विष्णुः समीपस्थं द्विजोत्तमम् ।\nगरुत्मन्तं महावेगमाबभाषे स्मयन्निव\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2193868, "chapter_id": 5120, "verse_number": "३१", "content_sanskrit": "द्विजोत्तम महाभागगम्यतां वचनान्मम ।\nसम्राड् राजा वसुर्नाम धर्मात्मा मां समाश्रितः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2193869, "chapter_id": 5120, "verse_number": "३२", "content_sanskrit": "ब्राह्मणानां प्रकोपेन प्रविष्टो वसुधातलम्।\nमानितास्ते तु विप्रेन्द्रास्त्वं तु गच्छ द्विजोत्तम\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2193870, "chapter_id": 5120, "verse_number": "३३", "content_sanskrit": "भूमेर्विवरसङ्गुप्तं गरुडेह ममाज्ञया।\nअधश्चरं नृपश्रेष्ठं खेचरं कुरु माचिरम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2193871, "chapter_id": 5120, "verse_number": "३४", "content_sanskrit": "गरुत्मानथ विक्षिप्य पक्षौ मारुतवेगवान् ।\nविवेश विवरं भूमेर्यत्रास्ते वाग्यतोवसुः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2193872, "chapter_id": 5120, "verse_number": "३५", "content_sanskrit": "तत एनं समुत्क्षिप्य सहसा विनतासुतः ।\nउत्पपात नभस्तूर्णं तत्र चैनममुञ्चत\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2193873, "chapter_id": 5120, "verse_number": "३६", "content_sanskrit": "तस्मिन्मुहूर्ते सञ्जज्ञे राजोपरिचरः पुनः ।\nसशरीरो गतश्चैव ब्रह्मलोकं नृपोत्तमः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2193874, "chapter_id": 5120, "verse_number": "३७", "content_sanskrit": "एवं तेनापि कौन्तेय वाग्दोषाद्देवताज्ञया ।\nप्राप्ता गतिरयज्वार्हा द्विजशापान्महात्मना\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2193875, "chapter_id": 5120, "verse_number": "३८", "content_sanskrit": "केवलं पुरुषस्तेन सेवितो हरिरीश्वरः।\nततः शीघ्रं जहौ शापं ब्रह्मलोकमवाप च\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2193876, "chapter_id": 5120, "verse_number": "३९", "content_sanskrit": "एतत्ते सर्वमाख्यातं ते भूता मानवा यथा ।\nनारदोऽपि यथा श्वेतं द्वीपं स गतवानृषिः॥\nतत्ते सर्वं प्रवक्ष्यामि शृणुष्वैकमना नृप\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2193877, "chapter_id": 5120, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे एकोनसप्तत्युत्तरशततमोऽध्यायः ॥१६९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]