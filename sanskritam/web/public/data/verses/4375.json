[{"id": 2155359, "chapter_id": 4375, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2155360, "chapter_id": 4375, "verse_number": "१", "content_sanskrit": "कथं द्रोणो महेष्वासः पाण्डवश्च धनञ्जयः ।\nसमीयतू रणे शूरौ तन्ममाचक्ष्व सञ्जय\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2155361, "chapter_id": 4375, "verse_number": "२", "content_sanskrit": "प्रियो हि पाण्डवो नित्यं भारद्वाजस्य धीमतः ।\nआचार्यश्च रणे नित्यं प्रियः पार्थस्य सञ्जय\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2155362, "chapter_id": 4375, "verse_number": "३", "content_sanskrit": "तावुभौ रथिनौ सङ्खे दृप्तौ सिंहाविवोत्कटौ ।\nकथं समीयतुर्युद्धे भारद्वाजधनञ्जयौ\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2155363, "chapter_id": 4375, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2155364, "chapter_id": 4375, "verse_number": "४", "content_sanskrit": "न द्रोणः समरे पार्थं जानीते प्रियमात्मनः ।\nक्षत्रधर्मं पुरस्कृत्य पार्थो वा गुरुमाहवे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2155365, "chapter_id": 4375, "verse_number": "५", "content_sanskrit": "न क्षत्रिया रणे राजन् वर्जयन्ति परस्परम् ।\nनिर्मर्यादं हि युध्यन्ते पितृभिर्भ्रातृभिः सह\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2155366, "chapter_id": 4375, "verse_number": "६", "content_sanskrit": "रणे भारत पार्थेन द्रोणो विद्धस्त्रिभिः शरैः ।\nनाचिन्तयत तान् बाणान् पार्थचापच्युतान् युधि\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2155367, "chapter_id": 4375, "verse_number": "७", "content_sanskrit": "शरवृष्ट्या पुनः पार्थश्छादयामास तं रणे ।\nप्रजज्वाल च रोषेण गहनेऽग्निरिवोत्थितः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2155368, "chapter_id": 4375, "verse_number": "८", "content_sanskrit": "ततोऽर्जुनं रणे द्रोणः शरैः सन्नतपर्वभिः ।\nवारयामास राजेन्द्र नचिरादिव भारत\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2155369, "chapter_id": 4375, "verse_number": "९", "content_sanskrit": "ततो दुर्योधनो राजा सुशर्माणमचोदयत् ।\nद्रोणस्य समरे राजन् पार्ष्णिग्रहणकारणात्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2155370, "chapter_id": 4375, "verse_number": "१०", "content_sanskrit": "त्रिगर्तराडपि क्रुद्धो भृशमायम्य कार्मुकम् ।\nछादयामास समरे पार्थं बाणैरयोमुखैः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2155371, "chapter_id": 4375, "verse_number": "११", "content_sanskrit": "ताभ्यां मुक्ताः शरा राजन्नन्तरिक्षे विरेजिरे ।\nहंसा इव महाराज शरत्काले नभस्तळे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2155372, "chapter_id": 4375, "verse_number": "१२", "content_sanskrit": "ते शराः प्राप्य कौन्तेयं समस्ता विविशुः प्रभो ।\nफलभारनतं यद्वत् स्वादुवृक्षं विहङ्गमाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2155373, "chapter_id": 4375, "verse_number": "१३", "content_sanskrit": "अर्जुनस्तु रणे नादं विनद्य रथिनां वरः ।\nत्रिगर्तराजं समरे सपुत्रं विव्यधे शरैः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2155374, "chapter_id": 4375, "verse_number": "१४", "content_sanskrit": "ते वध्यमानाः पार्थेन कालेनेव युगक्षये ।\nपार्थमेवाभ्यवर्तन्त मरणे कृतनिश्चयाः ।\nमुमुचुः शरवृष्टिं च पाण्डवस्य रथं प्रति\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2155375, "chapter_id": 4375, "verse_number": "१५", "content_sanskrit": "शरवृष्टिं ततस्तां तु शरवर्षेण पाण्डवः ।\nप्रतिजग्राह राजेन्द्र तोयवृष्टिमिवाचलः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2155376, "chapter_id": 4375, "verse_number": "१६", "content_sanskrit": "तत्राद्भुतमपश्याम बीभत्सोर्हस्तलाघवम् ।\nविमुक्तां बहुभिः शूरैः शस्त्रवृष्टिं दुरासदम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2155377, "chapter_id": 4375, "verse_number": "१७", "content_sanskrit": "यदेको वारयामास मारुतोऽभ्रगणानिव ।\nकर्मणा तेन पार्थस्य तुतुषुर्देवदानवाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2155378, "chapter_id": 4375, "verse_number": "१८", "content_sanskrit": "अथ क्रुद्धो रणे पार्थस्त्रिगर्तान् प्रति भारत ।\nमुमोचास्त्रं महाराज वायव्यं पृतनामुखे\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2155379, "chapter_id": 4375, "verse_number": "१९", "content_sanskrit": "प्रादुरासीत् ततो वायुः क्षोभयाणो नभस्तळम् ।\nपातयन् वै तरुगणान् विनिघ्नंश्चैव सैनिकान् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2155380, "chapter_id": 4375, "verse_number": "२०", "content_sanskrit": "ततो द्रोणोऽभिवीक्ष्यैव वायव्यास्त्रं सुदारुणम् ।\nशैलमन्यन्महाराज घोरमस्त्रं मुमोच ह\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2155381, "chapter_id": 4375, "verse_number": "२१", "content_sanskrit": "द्रोणेन युधि निर्मुक्ते तस्मिन्नस्त्रे महामृधे ।\nप्रशशाम ततो वायुः प्रसन्नाश्चाभवन् दिशः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2155382, "chapter_id": 4375, "verse_number": "२२", "content_sanskrit": "ततः पाण्डुसुतो वीरस्त्रिगर्तस्य रथव्रजान् ।\nनिरुत्साहान् रणे चक्रे विमुखान् विपराक्रमान् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2155383, "chapter_id": 4375, "verse_number": "२३", "content_sanskrit": "ततो दुर्योधनो राजा कृपश्च रथिनां वरः ।\nअश्वत्थामा ततः शल्यः काम्बोजश्च सुदक्षिणः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2155384, "chapter_id": 4375, "verse_number": "२४", "content_sanskrit": "विन्दानुविन्दावावन्त्यौ बाह्लिकश्च सबाह्लिकः ।\nमहता रथवंशेन पार्थस्यावारयन् दिशः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2155385, "chapter_id": 4375, "verse_number": "२५", "content_sanskrit": "तथैव भगदत्तश्च श्रुतायुश्च महाबलः ।\nगजानीकेन भीमस्य ताववारयतां दिशः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2155386, "chapter_id": 4375, "verse_number": "२६", "content_sanskrit": "भूरिश्रवाः शलश्चैव सौबलश्च विशाम्पते ।\nशरौघैर्विविधैस्तूर्णं माद्रीपुत्राववारयन् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2155387, "chapter_id": 4375, "verse_number": "२७", "content_sanskrit": "भीष्मस्तु सहितः सर्वैर्धार्तराष्ट्रस्य सैनिकैः ।\nयुधिष्ठिरं समासाद्य सर्वतः पर्यवारयत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2155388, "chapter_id": 4375, "verse_number": "२८", "content_sanskrit": "आपतन्तं गजानीकं दृष्ट्वा पार्थो वृकोदरः ।\nलेलिहन् सृक्किणी वीरो मृगराडिव कानने\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2155389, "chapter_id": 4375, "verse_number": "२९", "content_sanskrit": "ततस्तु रथिनां श्रेष्ठो गदां गृह्य महाहवे ।\nअवप्लुत्य रथात्तूर्णं तव सैन्यमभीषयत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2155390, "chapter_id": 4375, "verse_number": "३०", "content_sanskrit": "तमुदीक्ष्य गदाहस्तं ततस्ते गजसादिनः ।\nपरिवव्रू रणे यत्ता भीमसेनं समन्ततः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2155391, "chapter_id": 4375, "verse_number": "३१", "content_sanskrit": "गजमध्यमनुप्राप्तः पाण्डवश्च व्यराजत ।\nमेघजालस्य महतो यथा मध्यगतो रविः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2155392, "chapter_id": 4375, "verse_number": "३२", "content_sanskrit": "व्यधमत् स गजानीकं गदया पाण्डवर्षभः ।\nमहाभ्रजालमतुलं मातरिश्वेव सन्ततम् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2155393, "chapter_id": 4375, "verse_number": "३३", "content_sanskrit": "ते वध्यमाना बलिना भीमसेनेन दन्तिनः ।\nआर्तनादं रणे चक्रुर्गर्जन्तो जलदा इव\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2155394, "chapter_id": 4375, "verse_number": "३४", "content_sanskrit": "बहुधा दारितश्चैव विषाणैस्तत्र दन्तिभिः ।\nफुल्लाशोकनिभः पार्थः शुशुभे रणमूर्धनि\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2155395, "chapter_id": 4375, "verse_number": "३५", "content_sanskrit": "सादिनां शस्त्रवृष्टिं च व्यधमद् गदया ततः ।\nवायुवेगसमायुक्तो व्यचरत् पाण्डवो युधि ।\nविषाणोल्लिखितैर्गात्रैर्विषाणाभिहतो भृशम् \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2155396, "chapter_id": 4375, "verse_number": "३६", "content_sanskrit": "विषाणे दन्तिनं गृह्य निर्विषाणमथाकरोत् ।\nविषाणेन च तेनैव कुम्भेऽभ्याहत्य दन्तिनम् ।\nपातयामास समरे दण्डहस्त इवान्तकः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2155397, "chapter_id": 4375, "verse_number": "३७", "content_sanskrit": "शोणिताक्तां गदां बिभ्रन् मेदोमज्जाकृतच्छविः ।\nकृताङ्गदः शोणितेन रुद्रवत् प्रत्यदृश्यत\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2155398, "chapter_id": 4375, "verse_number": "३८", "content_sanskrit": "एवं ते वध्यमानास्तु हतशेषा महागजाः ।\nप्राद्रवन्त दिशो राजन् विमृद्नन्तः स्वकं बलम् \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2155399, "chapter_id": 4375, "verse_number": "३९", "content_sanskrit": "द्रवद्भिस्तैर्महानागैः समन्ताद् भरतर्षभ ।\nदुर्योधनबलं सर्वं पुनरासीत् पराङ्मुखम् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2155400, "chapter_id": 4375, "verse_number": "९९", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nभीष्मपर्वणि एकोनशततमोऽध्यायः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2155401, "chapter_id": 4375, "verse_number": "", "content_sanskrit": "॥ भीष्मवधपर्वणि एकोनषष्टितमोऽध्यायः ॥५९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]