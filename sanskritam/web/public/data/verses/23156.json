[{"id": 7003156000, "chapter_id": 23156, "verse_number": "४-९२-१", "content_sanskrit": "अथ द्विनवतितमोऽध्यायः ।\nनारायण उवाच ।\nश्रीकृष्णप्रेरितो हृष्टः प्रणम्य च गणेश्वरम् ।\nस्मरन्नारायणं शंभुं दुर्गा लक्ष्मीं सरस्वतीम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003156001, "chapter_id": 23156, "verse_number": "४-९२-२", "content_sanskrit": "गङ्गां च मनसि ध्यात्वा दिमीशं तं महेश्वरम् ।\nप्रजगामोद्धवश्चैव दृष्ट्वा मङ्गलमूचकम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003156002, "chapter_id": 23156, "verse_number": "४-९२-३", "content_sanskrit": "शुश्राव दुंदुभिं घण्टानादं शङ्खध्वनिं तथा ।\nहरिशब्दं च संगीतं शुश्राव मङ्गलध्वनिम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003156003, "chapter_id": 23156, "verse_number": "४-९२-४", "content_sanskrit": "पतिपुत्रवतीं साध्वीं प्रदीपं माल्यदर्पणम् ।\nपरिबूर्णतमं कुम्भं दधिलाजफलानि च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003156004, "chapter_id": 23156, "verse_number": "४-९२-५", "content_sanskrit": "दूर्वाङ्कुरं शुक्लधान्यं रजतं काञ्चनं मधु ।\nब्राह्मणानां समूहं च कृष्णसारं वृषं घृतम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003156005, "chapter_id": 23156, "verse_number": "४-९२-६", "content_sanskrit": "सद्योमांसं गजेन्द्रं च नृपेन्द्रं श्वेतघोटकम् ।\nपताकां नकुलं चाषं शुक्लं पुष्पं च चन्दनम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003156006, "chapter_id": 23156, "verse_number": "४-९२-७", "content_sanskrit": "दृष्ट्वैवं पथि कल्याणं प्राप वृन्दावनं वनम् ।\nददर्श पुरतो वृक्षं भाण्डीरे वटमक्षयम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003156007, "chapter_id": 23156, "verse_number": "४-९२-८", "content_sanskrit": "स्निग्धपर्ण रक्तवर्ण पुण्यदं तीर्थमीप्सितम् ।\nसुवेषान्बालकांश्चैव रत्नभूषणभूषितान् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003156008, "chapter_id": 23156, "verse_number": "४-९२-९", "content_sanskrit": "वदतो बलकृष्णेति रुदतश्च शुचाऽन्वितान् ।\nतानाश्वास्य ययौ दूरं प्रविश्य नगरं मुदा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003156009, "chapter_id": 23156, "verse_number": "४-९२-१०", "content_sanskrit": "ददर्श नन्दशिबिरं रचितं विश्वकर्मणा ।\nमणिरत्नविनिर्माणं मुक्तामाणिक्यहीरकैः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003156010, "chapter_id": 23156, "verse_number": "४-९२-११", "content_sanskrit": "परिच्छन्नं मनोरम्यं सद्रत्नकलशान्वितम् ।\nद्वारं चित्रं विचित्राढ्यं दृष्ट्वा च प्रविवेश सः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003156011, "chapter_id": 23156, "verse_number": "४-९२-१२", "content_sanskrit": "अवरुह्य रथात्तूर्ण तस्थौ तत्प्राङ्गणे मुदा ।\nयशोदा रोहिणी शीघ्रं पप्रच्छ कुशलं परम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003156012, "chapter_id": 23156, "verse_number": "४-९२-१३", "content_sanskrit": "आसनं च जलं गां च मधुपर्कं ददौ मुदा ।\nक्व नन्दः क्व बलः कृष्णः सत्यं तत्कथयोद्धव ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003156013, "chapter_id": 23156, "verse_number": "४-९२-१४", "content_sanskrit": "उद्धवः कथयामास सर्व भद्रं क्रमेण च ।\nसार्धं च बलकृष्णाभ्यां नन्दः सानन्दपूर्वकम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003156014, "chapter_id": 23156, "verse_number": "४-९२-१५", "content_sanskrit": "आयास्यति विलम्बेन कृष्णोपनयनावधि ।\nयुष्माकं कुशलं तत्वं विज्ञाय विधिपूर्वकम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003156015, "chapter_id": 23156, "verse_number": "४-९२-१६", "content_sanskrit": "अहं यास्यामि मथुरां यशोदे शृणु सांप्रतम् ।\nश्रृत्वा मङ्गलवार्ता च यशोदा रोहिणी मुदा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003156016, "chapter_id": 23156, "verse_number": "४-९२-१७", "content_sanskrit": "ब्राह्मणाय ददौ रत्नं सुवर्णं वस्त्रमीप्सितम् ।\nउद्धवं भोजयामास मिष्टान्नं च सुधोपमम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003156017, "chapter_id": 23156, "verse_number": "४-९२-१८", "content_sanskrit": "मणिश्रेष्ठं च रत्नं च ददौ तस्मै च हीरकम् ।\nवाद्यं च वादयामास भद्रं नानाविधं तथा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003156018, "chapter_id": 23156, "verse_number": "४-९२-१९", "content_sanskrit": "ब्रह्मणान्भोजयामास कारयामास मङ्गलम् ।\nवेदाश्च पाठयामास परमानन्दपूर्वकम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003156019, "chapter_id": 23156, "verse_number": "४-९२-२०", "content_sanskrit": "शंकरं पूजयामास विप्रद्वारा परं विभूम् ।\nनानोपहारैर्नैवेद्यैः पुष्पधूपप्रदीपकैः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003156020, "chapter_id": 23156, "verse_number": "४-९२-२१", "content_sanskrit": "चन्दनैर्वस्त्रताम्बूलैर्मधुगव्यघृतादिभिः ।\nभवानीं पूजयामास श्रीवृन्दारण्यदेवताम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003156021, "chapter_id": 23156, "verse_number": "४-९२-२२", "content_sanskrit": "षोडशोपचारैर्द्रव्यैर्बलिभिर्विविधैर्मुने ।\nमहिषाणां शते शुद्धं छागालानां सहस्रकम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003156022, "chapter_id": 23156, "verse_number": "४-९२-२३", "content_sanskrit": "मेषाणामयुतं शुद्धं युक्तमादाय पञ्चकम् ।\nब्राह्मणेभ्यः स्वर्णशतं धेनुनां च शतं तथा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003156023, "chapter_id": 23156, "verse_number": "४-९२-२४", "content_sanskrit": "प्रददौ दक्षिणां तूर्ण कृष्णकल्याणहेतवे ।\nउद्धवं पूजयामास सादरं च पुनः पुनः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003156024, "chapter_id": 23156, "verse_number": "४-९२-२५", "content_sanskrit": "समाश्वास्य यशोदां च रोहिणीं गोपबालकान् ।\nवृद्धान्गोपालिकाः सर्वाः प्रययू रासमण्डलम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003156025, "chapter_id": 23156, "verse_number": "४-९२-२६", "content_sanskrit": "ददर्श रासं रुचिरं चन्द्रमण्डलवर्तुलम् ।\nश्रीरामकदलीस्तम्भशतकैरुपशोभितम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003156026, "chapter_id": 23156, "verse_number": "४-९२-२७", "content_sanskrit": "युक्तैश्च स्निग्धवसनैश्चन्दनानां च पल्लवैः ।\nपट्टसूत्रनिबद्धैश्च श्रीयुक्तमाल्यजालकैः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003156027, "chapter_id": 23156, "verse_number": "४-९२-२८", "content_sanskrit": "दधिलाजफलैः पट्टैः पुष्पैर्दूर्वाङ्कुरैरपि ।\nचन्दनागुरुकस्तूरीकुङ्कुमैः परिसंस्कृतम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003156028, "chapter_id": 23156, "verse_number": "४-९२-२९", "content_sanskrit": "वेष्टितं सक्षितं यत्नाद्गोपिकानां त्रिकोटिभिः ।\nत्रिलक्षैः सुन्दरै रम्यैः संसक्तं रतिमन्दिरैः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003156029, "chapter_id": 23156, "verse_number": "४-९२-३०", "content_sanskrit": "लक्षगोपैः परिवृतं कृष्णागमनशङ्कितैः ।\nयमुनां दक्षिणां कृत्वा प्रययौ मालतीवनम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003156030, "chapter_id": 23156, "verse_number": "४-९२-३१", "content_sanskrit": "चन्दनानां चम्पकानां यूथिकानां तथैव च ।\nकेतकीमाधवीनां च वनं कृत्वा प्रदक्षिणम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003156031, "chapter_id": 23156, "verse_number": "४-९२-३२", "content_sanskrit": "बकुलानां वञ्जुलानामशोकानां च काननम् ।\nमल्लिकानां पलाशानां शिरीषाणां तथैव च ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003156032, "chapter_id": 23156, "verse_number": "४-९२-३३", "content_sanskrit": "धात्रीणां काञ्चनानां च कर्णिकानां वनं तथा ।\nनागेश्वराणां विपिनं लवङ्गानां तथैव च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003156033, "chapter_id": 23156, "verse_number": "४-९२-३४", "content_sanskrit": "वनं च शालतालानां हिन्तालानां वनं तथा ।\nपनसानां रसालानां लाङ्गलीनां मनोहरम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003156034, "chapter_id": 23156, "verse_number": "४-९२-३५", "content_sanskrit": "मन्दारकाननं रम्यं वामं कृत्वा च सत्वरम् ।\nदृष्ट्वा कुन्दवनं रम्यं संप्राप्य मधुकाननम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003156035, "chapter_id": 23156, "verse_number": "४-९२-३६", "content_sanskrit": "पुंस्कोकिलानां शब्देन मधुरेण समन्वितम् ।\nमधुव्रतसमूहानां मधुरध्वनिबूरितम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003156036, "chapter_id": 23156, "verse_number": "४-९२-३७", "content_sanskrit": "वन्यवृक्षैः परिवृतं माध्वीकाधारमीप्सितम् ।\nवातेन वन्यबुष्पाणां वरितः सुरभीकृतम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003156037, "chapter_id": 23156, "verse_number": "४-९२-३८", "content_sanskrit": "तद्दृष्ट्वा राजमार्गेण यशोदोक्तेन सांप्रतम् ।\nययौ शीघ्रं निरुद्विग्निं रहस्यं बदरीवनम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003156038, "chapter_id": 23156, "verse_number": "४-९२-३९", "content_sanskrit": "श्रीफलानां च निम्बार्नां नारिङ्गाणां वनं तथा ।\nपद्मानां करवीराणां तुलसीनां च काननम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003156039, "chapter_id": 23156, "verse_number": "४-९२-४०", "content_sanskrit": "दृष्टवा रक्तिमवर्णं च सुपक्वफलमीप्सितम् ।\nतदेव वामतः कृत्वा विवेश कदलीवनम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003156040, "chapter_id": 23156, "verse_number": "४-९२-४१", "content_sanskrit": "अतीव निर्जने रम्ये ददर्श राधिकाश्रमम् ।\nमणीन्द्राणां च प्राकारं परिखादुर्गवेष्टितम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003156041, "chapter_id": 23156, "verse_number": "४-९२-४२", "content_sanskrit": "अत्यगम्यं रिपूणां च मित्राणां सुगमं सुखम् ।\nगोप्यं संकेतमार्गं च रक्षकैः परिरक्षितम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003156042, "chapter_id": 23156, "verse_number": "४-९२-४३", "content_sanskrit": "नानाचित्रविचित्राढ्यं निर्मितं विश्वकर्मणा ।\nमणीन्द्रमुक्तामाणिक्यहीरहारोज्ज्वलं परम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003156043, "chapter_id": 23156, "verse_number": "४-९२-४४", "content_sanskrit": "रत्नेन्द्रसाररचितं रत्नस्तम्भैः सुशोभितम् ।\nरत्नसोपानसंसक्तमन्दिरेण मनोहरम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003156044, "chapter_id": 23156, "verse_number": "४-९२-४५", "content_sanskrit": "अमूल्यरत्नखचितं कलशैः परिशोभितम् ।\nवाह्निशुद्धांशुकाभिश्च पताकाभिः परिष्कृतम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003156045, "chapter_id": 23156, "verse_number": "४-९२-४६", "content_sanskrit": "सद्रत्नदर्पणोत्कृष्टं चर्चितं श्वेतचामरैः ।\nददर्श सिंहद्वारं च युक्तं रत्नकपाटकैः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003156046, "chapter_id": 23156, "verse_number": "४-९२-४७", "content_sanskrit": "द्वारोपरि विचित्रं च रम्यं वृन्दावनं वनम् ।\nकदम्बकाननं रम्यं तद्वास्त्रहरणादिकम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003156047, "chapter_id": 23156, "verse_number": "४-९२-४८", "content_sanskrit": "विश्वकर्मविरचितं सुरम्यं रासमण्डलम् ।\nनानारत्नकुटीरं च गोपगोपीसमन्वितम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003156048, "chapter_id": 23156, "verse_number": "४-९२-४९", "content_sanskrit": "रक्षितं गोपिकालक्षैर्वेत्रहस्तैर्मनोहरैः ।\nस्वच्छन्दाचरणैः शश्वदमितैर्बलिभिर्मुदा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003156049, "chapter_id": 23156, "verse_number": "४-९२-५०", "content_sanskrit": "तद्द्वारं पुरतो दृष्ट्वा विलङ्क्य च जगाम् सः ।\nद्वितीयं द्वारमुल्लङ्घ्य तस्मादुत्तममीप्सितम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003156050, "chapter_id": 23156, "verse_number": "४-९२-५१", "content_sanskrit": "द्वारं चतुर्थं संप्राप्य सर्वस्माच्च विलक्षणम् ।\nतत्पश्चात्पञ्चमं द्वारं ददर्श चित्रमुत्तमम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003156051, "chapter_id": 23156, "verse_number": "४-९२-५२", "content_sanskrit": "द्वारषट्कं च प्रययौ सर्वत्र रुचिरं परम् ।\nरामरावणयोर्युद्धं भित्तिचित्रं मनोहरम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003156052, "chapter_id": 23156, "verse_number": "४-९२-५३", "content_sanskrit": "दशावतारं विष्णोश्च कृत्रिमं रासमण्डलम् ।\nयमुनाजलकेलिं च रचितां विश्वकर्मणा ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003156053, "chapter_id": 23156, "verse_number": "४-९२-५४", "content_sanskrit": "गोपिकानां सहस्रेणा षष्ठं द्वारं च रक्षितम् ।\nरत्नेन्द्रसारनिर्माणभूषणैर्भूषितेन च ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003156054, "chapter_id": 23156, "verse_number": "४-९२-५५", "content_sanskrit": "सद्रत्नदण़्डहस्तेन हीरकैर्भूषितेन च ।\nमणीन्द्रमुक्तामाणिक्यहीरहारान्वितेन च ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003156055, "chapter_id": 23156, "verse_number": "४-९२-५६", "content_sanskrit": "माधवी तत्प्रधाना सा पप्रच्छ सांप्रतं शिवम् ।\nददौ प्रत्युत्तरं सर्वं क्रमेण च स उद्धवः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003156056, "chapter_id": 23156, "verse_number": "४-९२-५७", "content_sanskrit": "गत्वा विज्ञापयामास राधाप्रियसखीगणम् ।\nसा माधवी महाहृष्टा तत्र संस्थाप्य तं मुदा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003156057, "chapter_id": 23156, "verse_number": "४-९२-५८", "content_sanskrit": "श्रुत्वा मङ्गलवार्तां च राधाप्रियसखीगणैः ।\nकृत्वा शङ्खध्वनिं घण्टामृदङ्गपटहस्वनम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003156058, "chapter_id": 23156, "verse_number": "४-९२-५९", "content_sanskrit": "कृत्वा निर्मञ्छनं शीघ्रमुद्धवं प्रियमागतम् ।\nहृष्टा प्रवेशयामास राधाभ्यन्तरमुत्तमम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003156059, "chapter_id": 23156, "verse_number": "४-९२-६०", "content_sanskrit": "अमूल्यरत्ननिर्माणं गत्वा मन्दिरमुत्तमम् ।\nददर्श पुरतो राधां कुह्वा चन्द्रकलोपमाम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003156060, "chapter_id": 23156, "verse_number": "४-९२-६१", "content_sanskrit": "सुपक्वपद्मनेत्रां च शयानां शोकमूर्च्छिताम् ।\nरुदतीं रक्तवदनां विल्ष्टां च त्यक्तभूषणाम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003156061, "chapter_id": 23156, "verse_number": "४-९२-६२", "content_sanskrit": "निश्चेष्टां च निराहारां सुवर्णवर्णकुण्डलाम् ।\nशुष्किताधरकण्ठां च किंचिन्निः श्वाससंयुताम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003156062, "chapter_id": 23156, "verse_number": "४-९२-६३", "content_sanskrit": "प्रणनाम च तां दृष्ट्वा भक्तिनम्रात्मकंधरः ।\nपुलकाञ्चितसर्वाङ्गो भक्त्या भक्तः स उद्धवः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003156063, "chapter_id": 23156, "verse_number": "४-९२-६४", "content_sanskrit": "उद्धव उवाच ।\nवन्दे राधापदाम्भोजं ब्रह्मादिसुरविन्दतम् ।\nयत्कीर्तिः कीर्तनेनैव पुनाति भुवनत्रयम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003156064, "chapter_id": 23156, "verse_number": "४-९२-६५", "content_sanskrit": "नमो गोकुलवासिन्यै राधिकायै नमो नमः ।\nशतशृङ्गनिवासिन्यै चन्द्रावत्यै नमः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003156065, "chapter_id": 23156, "verse_number": "४-९२-६६", "content_sanskrit": "तुलसीवनवासिन्य वृन्दारण्यै नमः ।\nरासमण्डलवासिन्यै रासेश्वर्यै नमः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003156066, "chapter_id": 23156, "verse_number": "४-९२-६७", "content_sanskrit": "विरजातीरवासिन्यै वृन्दायै च नमः ।\nवृन्दावनविलासिन्यै कृष्णायै च नमः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003156067, "chapter_id": 23156, "verse_number": "४-९२-६८", "content_sanskrit": "नमः कृष्णप्रियायै च शान्तायै च नमः ।\nकृष्णवक्षःस्थितायै च तत्पियायै नमः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003156068, "chapter_id": 23156, "verse_number": "४-९२-६९", "content_sanskrit": "नमो वैकुण्ठवासिन्यै महालक्ष्म्यै नमः ।\nविद्याधिष्ठातृदेव्यै च सरस्वत्यै नमः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003156069, "chapter_id": 23156, "verse_number": "४-९२-७०", "content_sanskrit": "र्वैश्वर्याधिदेव्यै च कमलायै नमः ।\nपद्मनाभप्रियायै च पद्मायै च नमः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003156070, "chapter_id": 23156, "verse_number": "४-९२-७१", "content_sanskrit": "महाविष्णोश्च मात्रे च पराद्यायै नमः ।\nनमः सिन्धुसुतायै च मर्त्यलक्ष्मयै नमः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003156071, "chapter_id": 23156, "verse_number": "४-९२-७२", "content_sanskrit": "नारायणप्रियायै च नारायण्यै नमः ।\nनमोऽस्तु विष्णुमायायै वैष्णव्यै च नमः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003156072, "chapter_id": 23156, "verse_number": "४-९२-७३", "content_sanskrit": "महामायास्वरूपायै संपदायै नमः ।\nनमः कल्याणरूपिण्यै शुभायै च नमः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003156073, "chapter_id": 23156, "verse_number": "४-९२-७४", "content_sanskrit": "मात्रे चतुर्णा वेदानां सावित्र्यै च नमः ।\nनमोऽस्तु बुद्धिरूपायै ज्ञानदायै नमः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003156074, "chapter_id": 23156, "verse_number": "४-९२-७५", "content_sanskrit": "नमो दुर्गविनाशिन्यै दुर्गादेव्यै नमः ।\nतेजःसु सर्वदेवानां पुरा कृतयुगे मुदा ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003156075, "chapter_id": 23156, "verse_number": "४-९२-७६", "content_sanskrit": "अधिष्टानकृतायै च प्रकृत्यै च नमः ।\nनमस्त्रिपुरहारिण्यै त्रिपुरायै नमः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003156076, "chapter_id": 23156, "verse_number": "४-९२-७७", "content_sanskrit": "सुन्दरीषु च रम्यायै निर्गुणायै नमः ।\nममो निद्रास्वरूपायै निर्गुणायै नमः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003156077, "chapter_id": 23156, "verse_number": "४-९२-७८", "content_sanskrit": "नमो दक्षसुतायै च नमः सत्यै नमः ।\nनमः शैलसुतायै च पार्वत्यै च नमः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003156078, "chapter_id": 23156, "verse_number": "४-९२-७९", "content_sanskrit": "नमो नमस्तपस्विन्यै ह्यु मायै च नमः ।\nनिराहारस्वरूपायै ह्यपर्णायै नमः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003156079, "chapter_id": 23156, "verse_number": "४-९२-८०", "content_sanskrit": "गौरीलौकविलासिन्यै नमो गौर्यै नमः ।\nनमः कैलासवासिन्यै माहेश्वर्यैः नमः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003156080, "chapter_id": 23156, "verse_number": "४-९२-८१", "content_sanskrit": "निद्रायै च दयायै च श्रद्धायै च नमः ।\nनमो धृत्यै क्षमार्यै च लज्जायै च नमः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003156081, "chapter_id": 23156, "verse_number": "४-९२-८२", "content_sanskrit": "तृष्णायै क्षुत्स्वरूपायै स्थितिकर्त्र्यै नमः ।\nनमः संहाररूपिण्यै महामार्यै नमः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003156082, "chapter_id": 23156, "verse_number": "४-९२-८३", "content_sanskrit": "भयायैं चाभयायैं च मुक्तिदायै नमः ।\nनमः स्वधायैं स्वाहायै शान्तयै कान्त्यै नमः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003156083, "chapter_id": 23156, "verse_number": "४-९२-८४", "content_sanskrit": "नमस्तुष्ट्यैं च पुष्ट्यै च दयायै च नमः ।\nनमो निद्रास्वरूपायै श्रद्धायै च नमः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003156084, "chapter_id": 23156, "verse_number": "४-९२-८५", "content_sanskrit": "क्षुत्पिपासास्वरूपायै लज्जायैं च नमः ।\nनमो धृत्यैं क्षमायैं च चेतनायैं नमः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003156085, "chapter_id": 23156, "verse_number": "४-९२-८६", "content_sanskrit": "सर्वशक्तिस्वरूपिण्यै सर्वमात्रे नमः ।\nअग्नौ दाहस्वरूपायै भद्रायै च नमः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003156086, "chapter_id": 23156, "verse_number": "४-९२-८७", "content_sanskrit": "शोभायै पूर्णचन्द्रे च शरत्पद्म नमः ।\nनास्ति भेदो यथा देवि दुग्धधावल्ययोःसदा ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003156087, "chapter_id": 23156, "verse_number": "४-९२-८८", "content_sanskrit": "यथैव गन्धभूम्योश्च यथैव जलशैत्ययौः ।\nयथैव शब्दन्भसोर्ज्योतिः सूर्यकयोर्यथा ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003156088, "chapter_id": 23156, "verse_number": "४-९२-८९", "content_sanskrit": "लोके वेदे पुराणे च राधामाधवयोस्तथा ।\nचेतनं कुरु कल्याणि देहि मामुत्तरं सति ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003156089, "chapter_id": 23156, "verse_number": "४-९२-९०", "content_sanskrit": "इत्युक्त्वा चोद्धवस्तत्र प्रणनाम पुनः पुनः ।\nइत्युद्ववकृतं स्तोत्रं यः पठेद्भक्तिपूर्वकम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003156090, "chapter_id": 23156, "verse_number": "४-९२-९१", "content_sanskrit": "इह लोके सुखं भुक्त्वा यात्यन्ते हरिमन्दिरम् ।न भवेद्बन्धुविच्छेदो रोगः शोकः सुदारुणः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003156091, "chapter_id": 23156, "verse_number": "४-९२-९२", "content_sanskrit": "प्रोषिता स्त्री लभेत्कान्तं भार्याभेदी लभेत्प्रियाम् ।\nअपुत्रो लभते पुत्रान्निर्धनो लभते धनम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003156092, "chapter_id": 23156, "verse_number": "४-९२-९३", "content_sanskrit": "निर्भूमिर्लभते भूमिं प्रजाहीनो लभेत्प्रजाम् ।\nरोगाद्विमुच्यते रोगी बद्धी मुच्यते बन्धनात् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003156093, "chapter_id": 23156, "verse_number": "४-९२-९४", "content_sanskrit": "भयान्मुच्येत भीतस्तु मुच्येताऽऽपन्नआपदः ।\nअस्पष्टकीर्तिः सुयशा मूर्खो भवति पण्डितः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}]