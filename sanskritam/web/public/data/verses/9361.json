[{"id": 5000361000, "chapter_id": 9361, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे द्वाविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000361001, "chapter_id": 9361, "verse_number": "५-२२-१", "content_sanskrit": "सीताया वचनं श्रुत्वा परुषं राक्षसेश्वरः।\nप्रत्युवाच ततः सीतां विप्रियं प्रियदर्शनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000361002, "chapter_id": 9361, "verse_number": "५-२२-२", "content_sanskrit": "यथा यथा सान्त्वयिता वश्यः स्त्रीणां तथा तथा।\nयथा यथा प्रियं वक्ता परिभूतस्तथा तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000361003, "chapter_id": 9361, "verse_number": "५-२२-३", "content_sanskrit": "संनियच्छति मे क्रोधं त्वयि कामः समुत्थितः।\nद्रवतो मार्गमासाद्य हयानिव सुसारथिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000361004, "chapter_id": 9361, "verse_number": "५-२२-४", "content_sanskrit": "वामः कामो मनुष्याणां यस्मिन् किल निबध्यते।\nजने तस्मिंस्त्वनुक्रोशः स्नेहश्च किल जायते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000361005, "chapter_id": 9361, "verse_number": "५-२२-५", "content_sanskrit": "एतस्मात् कारणान्न त्वां घातयामि वरानने।\nवधार्हामवमानार्हां मिथ्या प्रव्रजने रताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000361006, "chapter_id": 9361, "verse_number": "५-२२-६", "content_sanskrit": "परुषाणि हि वाक्यानि यानि यानि ब्रवीषि माम्।\nतेषु तेषु वधो युक्तस्तव मैथिलि दारुणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000361007, "chapter_id": 9361, "verse_number": "५-२२-७", "content_sanskrit": "एवमुक्त्वा तु वैदेहीं रावणो राक्षसाधिपः।\nक्रोधसंरम्भसंयुक्तः सीतामुत्तरमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000361008, "chapter_id": 9361, "verse_number": "५-२२-८", "content_sanskrit": "द्वौ मासौ रक्षितव्यौ मे योऽवधिस्ते मया कृतः।\nततः शयनमारोह मम त्वं वरवर्णिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000361009, "chapter_id": 9361, "verse_number": "५-२२-९", "content_sanskrit": "द्वाभ्यामूर्ध्वं तु मासाभ्यां भर्तारं मामनिच्छतीम्।\nमम त्वां प्रातराशार्थे सूदाश्छेत्स्यन्ति खण्डशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000361010, "chapter_id": 9361, "verse_number": "५-२२-१०", "content_sanskrit": "तां भर्त्स्यमानां सम्प्रेक्ष्य राक्षसेन्द्रेण जानकीम्।\nदेवगन्धर्वकन्यास्ता विषेदुर्विकृतेक्षणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000361011, "chapter_id": 9361, "verse_number": "५-२२-११", "content_sanskrit": "ओष्ठप्रकारैरपरा नेत्रैर्वक्त्रैस्तथापराः।\nसीतामाश्वासयामासुस्तर्जितां तेन रक्षसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000361012, "chapter_id": 9361, "verse_number": "५-२२-१२", "content_sanskrit": "ताभिराश्वासिता सीता रावणं राक्षसाधिपम्।\nउवाचात्महितं वाक्यं वृत्तशौटीर्यगर्वितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000361013, "chapter_id": 9361, "verse_number": "५-२२-१३", "content_sanskrit": "नूनं न ते जनः कश्चिदस्मिन्निःश्रेयसि स्थितः।\nनिवारयति यो न त्वां कर्मणोऽस्माद् विगर्हितात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000361014, "chapter_id": 9361, "verse_number": "५-२२-१४", "content_sanskrit": "मां हि धर्मात्मनः पत्नीं शचीमिव शचीपतेः।\nत्वदन्यस्त्रिषु लोकेषु प्रार्थयेन्मनसापि कः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000361015, "chapter_id": 9361, "verse_number": "५-२२-१५", "content_sanskrit": "राक्षसाधम रामस्य भार्याममिततेजसः।\nउक्तवानसि यत् पापं क्व गतस्तस्य मोक्ष्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000361016, "chapter_id": 9361, "verse_number": "५-२२-१६", "content_sanskrit": "यथा दृप्तश्च मातंगः शशश्च सहितौ वने।\nतथा द्विरदवद् रामस्त्वं नीच शशवत् स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000361017, "chapter_id": 9361, "verse_number": "५-२२-१७", "content_sanskrit": "स त्वमिक्ष्वाकुनाथं वै क्षिपन्निह न लज्जसे।\nचक्षुषो विषये तस्य न यावदुपगच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000361018, "chapter_id": 9361, "verse_number": "५-२२-१८", "content_sanskrit": "इमे ते नयने क्रूरे विकृते कृष्णपिंगले।\nक्षितौ न पतिते कस्मान्मामनार्य निरीक्षतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000361019, "chapter_id": 9361, "verse_number": "५-२२-१९", "content_sanskrit": "तस्य धर्मात्मनः पत्नी स्नुषा दशरथस्य च।\nकथं व्याहरतो मां ते न जिह्वा पाप शीर्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000361020, "chapter_id": 9361, "verse_number": "५-२२-२०", "content_sanskrit": "असंदेशात्तु रामस्य तपसश्चानुपालनात्।\nन त्वां कुर्मि दशग्रीव भस्म भस्मार्हतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000361021, "chapter_id": 9361, "verse_number": "५-२२-२१", "content_sanskrit": "नापहर्तुमहं शक्या तस्य रामस्य धीमतः।\nविधिस्तव वधार्थाय विहितो नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000361022, "chapter_id": 9361, "verse_number": "५-२२-२२", "content_sanskrit": "शूरेण धनदभ्रात्रा बलैः समुदितेन च।\nअपोह्य रामं कस्माच्चिद् दारचौर्यं त्वया कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000361023, "chapter_id": 9361, "verse_number": "५-२२-२३", "content_sanskrit": "सीताया वचनं श्रुत्वा रावणो राक्षसाधिपः।\nविवृत्य नयने क्रूरे जानकीमन्ववैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000361024, "chapter_id": 9361, "verse_number": "५-२२-२४", "content_sanskrit": "नीलजीमूतसंकाशो महाभुजशिरोधरः।\nसिंहसत्त्वगतिः श्रीमान् दीप्तजिह्वोग्रलोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000361025, "chapter_id": 9361, "verse_number": "५-२२-२५", "content_sanskrit": "चलाग्रमुकुटप्रांशुश्चित्रमाल्यानुलेपनः।\nरक्तमाल्याम्बरधरस्तप्तांगदविभूषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000361026, "chapter_id": 9361, "verse_number": "५-२२-२६", "content_sanskrit": "श्रोणीसूत्रेण महता मेचकेन सुसंवृतः।\nअमृतोत्पादने नद्धो भुजंगेनेव मन्दरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000361027, "chapter_id": 9361, "verse_number": "५-२२-२७", "content_sanskrit": "ताभ्यां स परिपूर्णाभ्यां भुजाभ्यां राक्षसेश्वरः।\nशुशुभेऽचलसंकाशः शृंगाभ्यामिव मन्दरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000361028, "chapter_id": 9361, "verse_number": "५-२२-२८", "content_sanskrit": "तरुणादित्यवर्णाभ्यां कुण्डलाभ्यां विभूषितः।\nरक्तपल्लवपुष्पाभ्यामशोकाभ्यामिवाचलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000361029, "chapter_id": 9361, "verse_number": "५-२२-२९", "content_sanskrit": "स कल्पवृक्षप्रतिमो वसन्त इव मूर्तिमान्।\nश्मशानचैत्यप्रतिमो भूषितोऽपि भयंकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000361030, "chapter_id": 9361, "verse_number": "५-२२-३०", "content_sanskrit": "अवेक्षमाणो वैदेहीं कोपसंरक्तलोचनः।\nउवाच रावणः सीतां भुजंग इव निःश्वसन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000361031, "chapter_id": 9361, "verse_number": "५-२२-३१", "content_sanskrit": "अनयेनाभिसम्पन्नमर्थहीनमनुव्रते।\nनाशयाम्यहमद्य त्वां सूर्यः संध्यामिवौजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000361032, "chapter_id": 9361, "verse_number": "५-२२-३२", "content_sanskrit": "इत्युक्त्वा मैथिलीं राजा रावणः शत्रुरावणः।\nसंददर्श ततः सर्वा राक्षसीर्घोरदर्शनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000361033, "chapter_id": 9361, "verse_number": "५-२२-३३", "content_sanskrit": "एकाक्षीमेककर्णां च कर्णप्रावरणां तथा।\nगोकर्णीं हस्तिकर्णीं च लम्बकर्णीमकर्णिकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000361034, "chapter_id": 9361, "verse_number": "५-२२-३४", "content_sanskrit": "हस्तिपद्यश्वपद्यौ च गोपदीं पादचूलिकाम्।\nएकाक्षीमेकपादीं च पृथुपादीमपादिकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000361035, "chapter_id": 9361, "verse_number": "५-२२-३५", "content_sanskrit": "अतिमात्रशिरोग्रीवामतिमात्रकुचोदरीम्।\nअतिमात्रास्यनेत्रां च दीर्घजिह्वानखामपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000361036, "chapter_id": 9361, "verse_number": "५-२२-३६", "content_sanskrit": "अनासिकां सिंहमुखीं गोमुखीं सूकरीमुखीम्।\nयथा मद्वशगा सीता क्षिप्रं भवति जानकी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000361037, "chapter_id": 9361, "verse_number": "५-२२-३७", "content_sanskrit": "तथा कुरुत राक्षस्यः सर्वाः क्षिप्रं समेत्य वा।\nप्रतिलोमानुलोमैश्च सामदानादिभेदनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000361038, "chapter_id": 9361, "verse_number": "५-२२-३८", "content_sanskrit": "आवर्जयत वैदेहीं दण्डस्योद्यमनेन च।\nइति प्रतिसमादिश्य राक्षसेन्द्रः पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000361039, "chapter_id": 9361, "verse_number": "५-२२-३९", "content_sanskrit": "काममन्युपरीतात्मा जानकीं प्रति गर्जत।\nउपगम्य ततः क्षिप्रं राक्षसी धान्यमालिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000361040, "chapter_id": 9361, "verse_number": "५-२२-४०", "content_sanskrit": "परिष्वज्य दशग्रीवमिदं वचनमब्रवीत्।\nमया क्रीड महाराज सीतया किं तवानया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000361041, "chapter_id": 9361, "verse_number": "५-२२-४१", "content_sanskrit": "विवर्णया कृपणया मानुष्या राक्षसेश्वर।\nनूनमस्यां महाराज न देवा भोगसत्तमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000361042, "chapter_id": 9361, "verse_number": "५-२२-४२", "content_sanskrit": "विदधत्यमरश्रेष्ठास्तव बाहुबलार्जितान्।\nअकामां कामयानस्य शरीरमुपतप्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000361043, "chapter_id": 9361, "verse_number": "५-२२-४३", "content_sanskrit": "इच्छतीं कामयानस्य प्रीतिर्भवति शोभना।\nएवमुक्तस्तु राक्षस्या समुत्क्षिप्तस्ततो बली।\nप्रहसन् मेघसंकाशो राक्षसः स न्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000361044, "chapter_id": 9361, "verse_number": "५-२२-४४", "content_sanskrit": "प्रस्थितः स दशग्रीवः कम्पयन्निव मेदिनीम्।\nज्वलद्भास्करसंकाशं प्रविवेश निवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000361045, "chapter_id": 9361, "verse_number": "५-२२-४५", "content_sanskrit": "देवगन्धर्वकन्याश्च नागकन्याश्च तास्ततः।\nपरिवार्य दशग्रीवं प्रविशुस्ता गृहोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000361046, "chapter_id": 9361, "verse_number": "५-२२-४६", "content_sanskrit": "स मैथिलीं धर्मपरामवस्थितां\nप्रवेपमानां परिभर्त्स्य रावणः।\nविहाय सीतां मदनेन मोहितः\nस्वमेव वेश्म प्रविवेश रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000361047, "chapter_id": 9361, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे द्वाविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]