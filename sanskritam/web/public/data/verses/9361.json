[{"id": 40021619, "chapter_id": 9361, "verse_number": "1", "content_sanskrit": "स विसृज्य ततो रामः पुष्पकं हेमभूषितम् । प्रविवेश महाबाहुरशोकवनिकां तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40021620, "chapter_id": 9361, "verse_number": "2", "content_sanskrit": "चन्दनागुरुचूतैश्च तुङ्गकालेयकैरपि । देवदारुवनैश्चापि समन्तादुपशोभिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40021621, "chapter_id": 9361, "verse_number": "3", "content_sanskrit": "चम्पकाशोकपुन्नागमधूकपनसासनैः । शोभितां पारिजातैश्च विधूमज्वलनप्रभैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40021622, "chapter_id": 9361, "verse_number": "4", "content_sanskrit": "लोध्रनीपार्जुनैर्नागैः सप्तपर्णातिमुक्तकैः । मन्दारकदलीगुल्मलताजालसमावृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40021623, "chapter_id": 9361, "verse_number": "5", "content_sanskrit": "प्रियङ्गुभिः कदम्बैश्च तथा च वकुलैरपि । जम्बूभिर्दाडिमैश्चैव कोविदारैश्च शोभिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40021624, "chapter_id": 9361, "verse_number": "6", "content_sanskrit": "सर्वदा कुसुमै रम्यैः फलवद्भिर्मनोरमैः । दिव्यगन्धरसोपेतैस्तरुणाङ्कुरपल्लवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40021625, "chapter_id": 9361, "verse_number": "7", "content_sanskrit": "तथैव तरुभिर्दिव्यैः शिल्पिभिः परिकल्पितैः । चारुपल्लवपुष्पाढ्यैर्मत्तभ्रमरसङ्कुलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40021626, "chapter_id": 9361, "verse_number": "8", "content_sanskrit": "कोकिलैर्भृङ्गराजैश्च नानावर्णैश्च पक्षिभिः । शोभितां शतशश्चित्रां चूतवृक्षावतंसकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40021627, "chapter_id": 9361, "verse_number": "9", "content_sanskrit": "शातकुम्भनिभाः केचित्केचिदग्निशिखोपमाः । नीलाञ्जननिभाश्चान्ये भान्ति तत्रत्यपादपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40021628, "chapter_id": 9361, "verse_number": "10", "content_sanskrit": "सुरभीणि च पुष्पाणि माल्यानि विविधानि च । दीर्घिका विविधाकाराः पूर्णाः परमवारिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40021629, "chapter_id": 9361, "verse_number": "11", "content_sanskrit": "माणिक्यकृतसोपानाः स्फाटिकान्तरकुट्टिमाः । फुल्लपद्मोत्पलवनाश्चक्रवाकोपशोभिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40021630, "chapter_id": 9361, "verse_number": "12", "content_sanskrit": "दात्यूहशुकसङ्घुष्टा हंससारसनादिताः । तरुभिः पुष्पवद्भिश्च तीरजैरुपशोभिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40021631, "chapter_id": 9361, "verse_number": "13", "content_sanskrit": "प्राकारैर्विविधाकारैः शोभिताश्च शिलातलैः । तत्रैव च वनोद्देशे वैडूर्यमणिसन्निभैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40021632, "chapter_id": 9361, "verse_number": "14", "content_sanskrit": "शाद्वलैः परमोपेतां पुष्पितद्रुमकाननाम् । तत्र सङ्घर्षजातानां वृक्षाणां पुष्पशालिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40021633, "chapter_id": 9361, "verse_number": "15", "content_sanskrit": "प्रस्तराः पुष्पशबला नभस्तारागणैरिव । नन्दनं हि यथेन्द्रस्य ब्राह्मं चैत्ररथं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40021634, "chapter_id": 9361, "verse_number": "16", "content_sanskrit": "तथाभूतं हि रामस्य काननं सन्निवेशनम् । बह्वासनगृहोपेतां लतागृहसमावृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40021635, "chapter_id": 9361, "verse_number": "17", "content_sanskrit": "अशोकवनिकां स्फीतां प्रविश्य रघुनन्दनः । आसने च शुभाकारे पुष्पप्रकरभूषिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40021636, "chapter_id": 9361, "verse_number": "18", "content_sanskrit": "कुशास्तरणसंस्तीर्णे रामः सन्निषसाद ह । सीतामादायं हस्तेन मधुमैरेयकं शुचि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40021637, "chapter_id": 9361, "verse_number": "19", "content_sanskrit": "पाययामास काकुत्स्थः शचीमिव पुरन्दरः । मांसानि च समृष्टानि फलानि विविधानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40021638, "chapter_id": 9361, "verse_number": "20", "content_sanskrit": "रामस्याभ्यवहारार्थं किङ्करास्तूर्णमाहरन्उ । उपानृत्यंश्च राजानं नृत्यगीतविशारदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40021639, "chapter_id": 9361, "verse_number": "21", "content_sanskrit": "बालाश्च रूपवत्यश्च स्त्रियः पानवशानुगाः । मनोभिरामा रामास्ता रामो रमयतां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40021640, "chapter_id": 9361, "verse_number": "22", "content_sanskrit": "उपानृत्यन्त काकुत्स्थं नृत्यगीतविशारदाः । मनोभिरामा रामास्ता रामो रमयतां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40021641, "chapter_id": 9361, "verse_number": "23", "content_sanskrit": "रमयामास धर्मात्मा नित्यं परमभूषितः । स तया सीतया सार्धमासीनो विरराज ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40021642, "chapter_id": 9361, "verse_number": "24", "content_sanskrit": "अरुन्धत्या सहासीनो वसिष्ठ इव तेजसा । एवं रामो मुदा युक्तः सीतां सुरसुतोपमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40021643, "chapter_id": 9361, "verse_number": "25", "content_sanskrit": "रमयामास वैदेहीमहन्यहनि देववत्त । था तयोर्विहरतोः सीताराघवयोश्चिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40021644, "chapter_id": 9361, "verse_number": "26", "content_sanskrit": "अत्यक्रामच्छुभः कालः शैशिरो भोगदः सदा । प्राप्तयोर्विविधान्भोगानतीतः शिशिरागमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40021645, "chapter_id": 9361, "verse_number": "27", "content_sanskrit": "पूर्वाह्णे धर्मकार्याणि कृत्वा धर्मेण धर्मवित् । शेषं दिवसभागार्धमन्तःपुरगतो ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40021646, "chapter_id": 9361, "verse_number": "28", "content_sanskrit": "सीतापि देवकार्याणि कृत्वा पौर्वाह्णिकानि वै । श्वश्रूणामकरोत्पूजां सर्वासामविशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40021647, "chapter_id": 9361, "verse_number": "29", "content_sanskrit": "अभ्यगच्छत्ततो रामं विचित्राभरणाम्बरा । त्रिविष्टपे सहस्राक्षमुपविष्टं यथा शची ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40021648, "chapter_id": 9361, "verse_number": "30", "content_sanskrit": "दृष्ट्वा तु राघवः पत्नीं कल्याणेन समन्विताम् । प्रहर्षमतुलं लेभे साधु साध्विति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40021649, "chapter_id": 9361, "verse_number": "31", "content_sanskrit": "अब्रवीच्च वरारोहां सीतां सुरसुतोपमाम् । अपत्यलाभो वैदेहि त्वयि मे समुपस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40021650, "chapter_id": 9361, "verse_number": "32", "content_sanskrit": "किमिच्छसि वरारोहे कामः किं क्रियतां तव । स्मितं कृत्वा तु वैदेही रामं वाक्यमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40021651, "chapter_id": 9361, "verse_number": "33", "content_sanskrit": "तपोवनानि पुण्यानि द्रष्टुमिच्छामि राघव । गङ्गातीरोपविष्टानामृषीणामुग्रतेजसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40021652, "chapter_id": 9361, "verse_number": "34", "content_sanskrit": "फलमूलाशिनां देव पादमूलेषु वर्तितुम् । एष मे परमः कामो यन्मूलफलभोजिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40021653, "chapter_id": 9361, "verse_number": "35", "content_sanskrit": "अप्येकरात्रं काकुत्स्थ निवसेयं तपोवने । तथेति च प्रतिज्ञातं रामेणाक्लिष्टकर्मणा । विस्रब्धा भव वैदेहि श्वो गमिष्यस्यसंशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40021654, "chapter_id": 9361, "verse_number": "36", "content_sanskrit": "एवमुक्त्वा तु काकुत्स्थो मैथिलीं जनकात्मजाम् । मध्यकक्षान्तरं रामो निर्जगाम सुहृद्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]