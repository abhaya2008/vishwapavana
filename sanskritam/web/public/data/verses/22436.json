[{"id": 7002436000, "chapter_id": 22436, "verse_number": "१-९८-१", "content_sanskrit": "ब्रह्मोवाच ।\nमासि भाद्रपदे शुक्ला सप्तमी या गणाधिप ।\nअपराजितेति विख्याता महापातकनाशिनी ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002436001, "chapter_id": 22436, "verse_number": "१-९८-२", "content_sanskrit": "चतुर्थ्यामेकभक्तं तु पञ्चम्यां नक्तमादिशेत् ।\nउपवासं तथा षष्ठ्यां सप्तम्यां पारणं स्मृतम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002436002, "chapter_id": 22436, "verse_number": "१-९८-३", "content_sanskrit": "पारणान्यत्र चत्वारि कथितानि मनीषिभिः ।\nपुष्पाणि करवीरस्य तथा रक्तं च चन्दनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002436003, "chapter_id": 22436, "verse_number": "१-९८-४", "content_sanskrit": "धूपक्रिया गुग्गुलेन नैवेद्यं गुडपूपकाः ।\nभाद्रपदादिमासेषु विधिरेष प्रकीर्तितः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002436004, "chapter_id": 22436, "verse_number": "१-९८-५", "content_sanskrit": "श्वेतानि भीमपुष्पाणि तथा श्वेतं च चन्दनम् ।\nधूपमाज्यमिहाख्यातं नैवद्यं पायसं रवेः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002436005, "chapter_id": 22436, "verse_number": "१-९८-६", "content_sanskrit": "मार्गशीर्षादिमासेषु विधिरेष प्रकीर्तितः ।\nततोऽगस्त्यस्य पुष्पाणि कुङ्कुमं च विलेपनम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002436006, "chapter_id": 22436, "verse_number": "१-९८-७", "content_sanskrit": "धूपार्थं सिह्लकं प्रोक्तमथ वा रविवर्णकम् ।\nशाल्योदनं च नैवेद्यं सरसं फाल्गुनादिषु ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002436007, "chapter_id": 22436, "verse_number": "१-९८-८", "content_sanskrit": "रक्तोत्पलानि भूतेश सागुरुं चन्दनं तथा ।\nअनन्तो धूप उद्दिष्टो नैवेद्यं खण्डपूपकाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002436008, "chapter_id": 22436, "verse_number": "१-९८-९", "content_sanskrit": "श्रीखण्डं ग्रन्थिसहितमगुरुः सिह्लकं तथा ।\nमुस्ता तथेन्द्रं भूतेश शर्करा गृह्यते त्र्यहम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002436009, "chapter_id": 22436, "verse_number": "१-९८-१०", "content_sanskrit": "इत्येष धूपोऽनन्तस्तु कथितो देवसत्तम ।\nज्येष्ठादिमासेषु तथा विधिरुक्तो मनीषिभिः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002436010, "chapter_id": 22436, "verse_number": "१-९८-११", "content_sanskrit": "शृणु नामानि देवस्य प्राशनानि च सुव्रत ।\nसुधांशुरर्यमा चैव सविता त्रिपुरान्तकः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002436011, "chapter_id": 22436, "verse_number": "१-९८-१२", "content_sanskrit": "पारणेष्वेव सर्वेषु प्रीयतामिति कीर्तयेत् ।\nगोमूत्रं पञ्चगव्यं तु घृतं चोष्णं पयो दधि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002436012, "chapter_id": 22436, "verse_number": "१-९८-१३", "content_sanskrit": "यस्त्वेतां सप्तमो कुर्यादनेन विधिना नरः ।\nअपराजितो भवेत्सोऽसौ सदा शत्रुभिराहवे ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002436013, "chapter_id": 22436, "verse_number": "१-९८-१४", "content_sanskrit": "जित्वा शत्रुं लभेतापि त्रिवर्गं नात्र संशयः ।\nत्रिवर्गमथ सम्प्राप्य स्वर्भानोः पुरमश्नुते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002436014, "chapter_id": 22436, "verse_number": "१-९८-१५", "content_sanskrit": "ततः पूर्णेषु मासेषु पूजयेच्छक्तितः खगम् ।\nगन्धपुष्पोपहारैस्तु पुराणश्रवणेन च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002436015, "chapter_id": 22436, "verse_number": "१-९८-१६", "content_sanskrit": "अश्वदानेन च विभोर्ब्राह्मणानां च तर्पणैः ।\nवाचकं पूजयित्वा च भास्करस्य प्रियं सदा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002436016, "chapter_id": 22436, "verse_number": "१-९८-१७", "content_sanskrit": "भास्कराय ध्वजान्दद्यान्नानारत्नविभूषितान् ।\nय इत्थं कुरुते वीर सप्तमीं यत्नतः सदा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002436017, "chapter_id": 22436, "verse_number": "१-९८-१८", "content_sanskrit": "स पराजित्य वै शत्रुं याति हंससलोकताम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002436018, "chapter_id": 22436, "verse_number": "१-९८-१९", "content_sanskrit": "शुक्लाश्वोद्भवयानेन आपगेन पताकिना ।\nआपगाधिपसंकाश आपगानुचरो भवेत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]