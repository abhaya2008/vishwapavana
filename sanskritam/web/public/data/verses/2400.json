[{"id": 2066325, "chapter_id": 2400, "verse_number": "९-१८-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2066326, "chapter_id": 2400, "verse_number": "९-१८-१", "content_sanskrit": "पातिते युधि दुर्धर्षे मद्रराजे महारथे।\nतावकास्तव पुत्राश्च प्रायशो विमुखाऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2066327, "chapter_id": 2400, "verse_number": "९-१८-२", "content_sanskrit": "वणिजो नावि भिन्नायां यथागाधे महार्णवे।\nअपारे पारमिच्छन्तो हते शूरे महात्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2066328, "chapter_id": 2400, "verse_number": "९-१८-३", "content_sanskrit": "मद्रराजे महाराज वित्रस्ताः शरविक्षताः।\nअनाथा नाथमिच्छन्तो मृगाः सिंहार्दिता इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2066329, "chapter_id": 2400, "verse_number": "९-१८-४", "content_sanskrit": "वृषा यथा भग्नशृङ्गाः शीर्णदन्ता यथा गजाः।\nमध्याह्ने प्रत्यपायाम निर्जिताऽजातशत्रुणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2066330, "chapter_id": 2400, "verse_number": "९-१८-५", "content_sanskrit": "न संस्थातुमनीकानि न च राजन्पराक्रमे।\nआसीद्बुद्धिर्हते शल्ये तव योधस्य कस्यचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2066331, "chapter_id": 2400, "verse_number": "९-१८-६", "content_sanskrit": "भीष्मे द्रोणे च निहते सूतपुत्रे च पातिते।\nयद्दुःखं तव योधानां भयं चासीद्विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2066332, "chapter_id": 2400, "verse_number": "९-१८-७", "content_sanskrit": "तद्भयं स च नः शोको भूय एवाभ्यवर्तत।\nनिराशाश्च जये राजन्हते शल्ये महारथे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2066333, "chapter_id": 2400, "verse_number": "९-१८-८", "content_sanskrit": "हतप्रवीरा विध्वस्ता निकृत्ताश्च शितैः शरैः।\nमद्रराजे हते राजन्योधास्ते प्राद्रवन्भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2066334, "chapter_id": 2400, "verse_number": "९-१८-९", "content_sanskrit": "अश्वानन्ये गजानन्ये रथानन्ये महारथाः।\nआरुह्य जवसम्पन्ना पादाताः प्राद्रवंस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2066335, "chapter_id": 2400, "verse_number": "९-१८-१०", "content_sanskrit": "द्विसाहस्राश्च महातङ्गा गिरिरूपाः प्रहारिणः।\nxxप्राद्रवन्हते शल्ये अङ्कुशाङ्गुष्ठनोदिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2066336, "chapter_id": 2400, "verse_number": "९-१८-११", "content_sanskrit": "ते रणाद्भरतश्रेष्ठ तावकाः प्राद्रवन्दिशः।\nधावतश्चाप्यपश्याम श्वसमानाञ्शराहतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2066337, "chapter_id": 2400, "verse_number": "९-१८-१२", "content_sanskrit": "तान्प्रभग्नान्हतान्दृष्ट्वा हतोत्साहान्पराजितान्।\nअभ्यवर्तन्त पाञ्चालाः पाण्डवाश्च जयैषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2066338, "chapter_id": 2400, "verse_number": "९-१८-१३", "content_sanskrit": "बाणशब्दरवाश्चापि सिंहनादाश्च पुष्कलाः।\nशङ्खशब्दश्च शूराणां दारुणः समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2066339, "chapter_id": 2400, "verse_number": "९-१८-१४", "content_sanskrit": "दृष्ट्वा तु कौरवं सैन्यं भयत्रस्तं प्रविद्रुतम्।\nअन्योन्यं समभाषन्त पाञ्चालाः पाण्डवैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2066340, "chapter_id": 2400, "verse_number": "९-१८-१५", "content_sanskrit": "अद्य राजा सत्यधृतिर्हतामित्रो युधिष्ठिरः।\nअद्य दुर्योधनो हीनो दीप्तया नृपतिश्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2066341, "chapter_id": 2400, "verse_number": "९-१८-१६", "content_sanskrit": "अद्य श्रुत्वा हतं पुत्रं धृतराष्ट्रो जनेश्वरः।\nनिःसंज्ञः पतितो भूमौ किल्बिषं प्रतिपत्स्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2066342, "chapter_id": 2400, "verse_number": "९-१८-१७", "content_sanskrit": "अद्य जानाति बीभत्सुं समर्थं स्वधन्विनाम्।\nअद्यात्मानं च दुर्मेधा गर्हयिष्यति पापकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2066343, "chapter_id": 2400, "verse_number": "९-१८-१८", "content_sanskrit": "अद्य क्षत्तुर्वचः सत्यं स्मरतां ब्रुवतो हितम्।\nअद्यप्रभृति पार्थं च प्रेष्यभूत इवाचरन्।\nविजानातु नृपो दुःखं यत्प्राप्तं पाण्डुनन्दनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2066344, "chapter_id": 2400, "verse_number": "९-१८-१९", "content_sanskrit": "अद्य कृष्णस्य माहात्म्यं विजानातु महीपतिः।\nअद्यार्जुनधनुर्घोषं घोरं जानातु संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2066345, "chapter_id": 2400, "verse_number": "९-१८-२०", "content_sanskrit": "अत्त्राणां च बलं सर्वं बाह्वोश्च बलमाहवे।\n`पुत्राणां च वधं घोरं भीमेन श्रोष्यते नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2066346, "chapter_id": 2400, "verse_number": "९-१८-२१", "content_sanskrit": "अद्य ज्ञास्यति भीमस्य बलं घोरं महात्मनः।\nहते दुर्योधने युद्धे शक्रेणेव तु शम्बरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2066347, "chapter_id": 2400, "verse_number": "९-१८-२२", "content_sanskrit": "यत्कृतं भीमसेनेन दुःशासनवधे तदा।\nकोऽन्यः कर्ताऽस्ति तल्लोके ऋते भीमान्महाबलात्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2066348, "chapter_id": 2400, "verse_number": "९-१८-२३", "content_sanskrit": "अद्य ज्येष्ठस्य जानीतां पाण्डवस्य पराक्रमम्।\nमद्रराजं हतं श्रुत्वा देवैरपि सुदुःसहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2066349, "chapter_id": 2400, "verse_number": "९-१८-२४", "content_sanskrit": "अद्य ज्ञास्यति सङ्ग्रामे माद्रीपुत्रौ सुदुःसहौ।\nनिहते सौबले वीरे गान्धारेषु च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2066350, "chapter_id": 2400, "verse_number": "९-१८-२५", "content_sanskrit": "xxxx न तेषां स्याद्येषां योद्धा धनञ्जयः।\nxxxxx धृष्टद्युम्नश्च पार्षतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2066351, "chapter_id": 2400, "verse_number": "९-१८-२६", "content_sanskrit": "xxxx पञ्च माद्रीपुत्रौ च पाण्डवौ।\nशिखण्डी च महेष्वासो राजा चैव युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2066352, "chapter_id": 2400, "verse_number": "९-१८-२७", "content_sanskrit": "येषां च जगतो नाथो नाथः कृष्णो जनार्दनः।\nकथं तेषां जयो न स्याद्येषां धर्मो व्यपाश्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2066353, "chapter_id": 2400, "verse_number": "९-१८-२८", "content_sanskrit": "`लाभस्तेषां जयस्तेषां कुतस्तेषां पराभवः।\nयेषां नाथो हृषीकेशः सर्वलोकविभुर्हरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2066354, "chapter_id": 2400, "verse_number": "९-१८-२९", "content_sanskrit": "भीष्मं द्रोणं च कर्णं च मद्रराजानमेव च।\nतथाऽन्यान्नृपतीन्वीराञ्शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2066355, "chapter_id": 2400, "verse_number": "९-१८-३०", "content_sanskrit": "कोऽन्यः शक्तो रणे जेतुमृते पार्थाद्युधिष्ठिरात्।\nयस्य नाथो हृषीकेशः सदा सत्ययशोनिधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2066356, "chapter_id": 2400, "verse_number": "९-१८-३१", "content_sanskrit": "इत्येवं वदमानास्ते हर्षेण महता युताः।\nप्रभग्नांस्तावकान्योधान्संहृष्टाः पृष्ठतोऽन्वयुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2066357, "chapter_id": 2400, "verse_number": "९-१८-३२", "content_sanskrit": "धनञ्जयो रथानीकमभ्यवर्तत वीर्यवान्।\nमाद्रीपुत्रौ च शकुनिं सात्यकिश्च महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2066358, "chapter_id": 2400, "verse_number": "९-१८-३३", "content_sanskrit": "तान्प्रेक्ष्य द्रवतः सर्वान्भीमसेनभयार्दितान्।\nदुर्योधनस्तदा सूतमब्रवीद्विस्मयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2066359, "chapter_id": 2400, "verse_number": "९-१८-३४", "content_sanskrit": "मामतिक्रमते पार्थो धनुष्पाणिमवस्थितम्।\nजघने सर्वसैन्यानां शनैरश्वान्प्रचोदय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2066360, "chapter_id": 2400, "verse_number": "९-१८-३५", "content_sanskrit": "जघने युध्यमानं हि कौन्तेयो मां न संशयः।\nनोत्सहेदभ्यतिक्रान्तुं वेलामिव महोदधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2066361, "chapter_id": 2400, "verse_number": "९-१८-३६", "content_sanskrit": "पश्य सैन्यं महत्सूत पाण्डवैः समभिद्रुतम्।\nसैन्यरेणुं समुद्भूतं पश्य चैनं समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2066362, "chapter_id": 2400, "verse_number": "९-१८-३७", "content_sanskrit": "सिंहनादांश्च समुद्भूतं पश्य चैनं समन्ततः॥\nतस्माद्याहि शनैः सूत जघनं परिपालय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2066363, "chapter_id": 2400, "verse_number": "९-१८-३८", "content_sanskrit": "मयि स्थिते च समरे निरुद्धेषु च पाण्डुषु।\nपुनरावर्तते तूर्णं मामकं बलमोजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2066364, "chapter_id": 2400, "verse_number": "९-१८-३९", "content_sanskrit": "तच्छ्रुत्वा तव पुत्रस्य शूरस्य सदृशं वचः।\nसारथिर्हेमसञ्छन्नाञ्शरैरश्वानचोदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2066365, "chapter_id": 2400, "verse_number": "९-१८-४०", "content_sanskrit": "गजाश्वरथिभिर्हीनास्त्यक्तात्मानः पदातयः।\nएकविंशतिसाहस्राः संयुगायावतस्थिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2066366, "chapter_id": 2400, "verse_number": "९-१८-४१", "content_sanskrit": "नानादेशसमुद्भूता नानारञ्जितवाससः।\nअवस्थितास्तदा योधाः प्रार्थयन्तो महद्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2066367, "chapter_id": 2400, "verse_number": "९-१८-४२", "content_sanskrit": "तेषामापततां तत्र संहृष्टानां परस्परम्।\nसम्मर्दः सुमहाञ्चज्ञे घोररूपो भयानकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2066368, "chapter_id": 2400, "verse_number": "९-१८-४३", "content_sanskrit": "भीमसेनं तदा राजन्धृष्टद्युम्नं च पार्षतम्।\nबलेन चतुरङ्गेण नानादेश्यानवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2066369, "chapter_id": 2400, "verse_number": "९-१८-४४", "content_sanskrit": "भीममेवाभ्यवर्तन्त रणेऽन्ये तु पदातयः।\nप्रक्ष्वेड्यास्फोट्य संहृष्टा वीरलोकं यियासवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2066370, "chapter_id": 2400, "verse_number": "९-१८-४५", "content_sanskrit": "आसाद्य भीमसेनं तु संरब्धा युद्धदुर्मदाः।\nधार्तराष्ट्रा विनेदुर्हि नान्यामकथनयन्कथाम्।\nपरिवार्य रणे भीमं निजघ्नुस्ते समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2066371, "chapter_id": 2400, "verse_number": "९-१८-४६", "content_sanskrit": "स वध्यमानः समरे पदातिगणसंवृतः।\nन चचाल ततः स्थानान्मैनाक इव पर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2066372, "chapter_id": 2400, "verse_number": "९-१८-४७", "content_sanskrit": "ते तु क्रुद्धा महाराज पाण्डवस्य महारथम्।\nनिग्रहीतुं प्रवृत्ता हि योधांश्चान्यानवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2066373, "chapter_id": 2400, "verse_number": "९-१८-४८", "content_sanskrit": "अक्रुध्यत रणे भीमस्तैस्तदा पर्यवस्थितैः।\nसोऽवतीर्य रथात्तूर्णं पदातिः समवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2066374, "chapter_id": 2400, "verse_number": "९-१८-४९", "content_sanskrit": "जातरूपप्रतिच्छन्नां प्रगृह्य महतीं गदाम्।\nअवधीत्तावकान्योधान्दण्डपाणिरिवान्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2066375, "chapter_id": 2400, "verse_number": "९-१८-५०", "content_sanskrit": "रथाश्वविप्रहीणांस्तु तान्भीमो गदया बली।\nएकविंशतिसाहस्रान्पदातीन्समपोथयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2066376, "chapter_id": 2400, "verse_number": "९-१८-५१", "content_sanskrit": "हत्वा तत्पुरुषानीकं भीमः सत्यपराक्रमः।\nधृष्टद्युम्नं पुरस्कृत्य न चिरात्प्रत्यदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2066377, "chapter_id": 2400, "verse_number": "९-१८-५२", "content_sanskrit": "पादाता निहता भूमौ शिश्यिरे रुधिरोक्षितः।\nसम्भग्ना इव वातेन कर्णिकाराः सुपुष्पिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2066378, "chapter_id": 2400, "verse_number": "९-१८-५३", "content_sanskrit": "नानाशस्त्रसमायुक्ता नानाकुण्डलधारिणः।\nनानाजात्या हतास्तत्र नादेशसमागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2066379, "chapter_id": 2400, "verse_number": "९-१८-५४", "content_sanskrit": "पताकाध्वजसञ्छन्नं पदातीनां महद्बलम्।\nनिकृत्तं विबभौ रौद्रं घोररूपं भयावहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2066380, "chapter_id": 2400, "verse_number": "९-१८-५५", "content_sanskrit": "युधिष्ठिरपुरोगाश्च सहसैन्या महारथाः।\nअभ्यधावन्महात्मानं पुत्रं दुर्योधनं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2066381, "chapter_id": 2400, "verse_number": "९-१८-५६", "content_sanskrit": "ते सर्वे तावकान्दृष्ट्वा महेष्वासान्पराङ्मुखान्।\nनाभ्यवर्तन्त ते पुत्रं वेलामिव महोर्मयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2066382, "chapter_id": 2400, "verse_number": "९-१८-५७", "content_sanskrit": "तदद्भुतमपश्याम तव पुत्रस्य पौरुषम्।\nयदेकं सहिताः पार्था न शेकुरतिवर्तितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2066383, "chapter_id": 2400, "verse_number": "९-१८-५८", "content_sanskrit": "नातिदूरापयातं तु कृतबुद्वि पलायने।\nदुर्योधनः स्वकं सैन्यमब्रवीद्भृशविक्षतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2066384, "chapter_id": 2400, "verse_number": "९-१८-५९", "content_sanskrit": "न तं देशं प्रपश्यामि पृथिव्यां पर्वतेषु च।\nयत्र यातान्न वा हन्युः पाण्डवाः किं सृतेन वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2066385, "chapter_id": 2400, "verse_number": "९-१८-६०", "content_sanskrit": "अल्पं च बलमेतेषां कृष्णौ च भृशविक्षतौ।\nयदि सर्वेऽत्र तिष्ठामो ध्रुवं नो विजयो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2066386, "chapter_id": 2400, "verse_number": "९-१८-६१", "content_sanskrit": "विप्रयातांस्तु वो भिन्नान्पाण्डवाः कृतविप्रियाः।\nअनुयाय हनिष्यन्ति श्रेयान्नः समरे वधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2066387, "chapter_id": 2400, "verse_number": "९-१८-६२", "content_sanskrit": "शृण्वन्तु क्षत्रियाः सर्वे यावन्तोऽत्र समागताः।\nयदा शूरं च भीरुं च मारयत्यन्तकः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2066388, "chapter_id": 2400, "verse_number": "९-१८-६३", "content_sanskrit": "को नु मूढो न युध्येत पुरुषः क्षत्रियो ध्रुवम्।\nश्रेयान्नो भीमसेनस्य क्रुद्धस्याभिमुखे स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2066389, "chapter_id": 2400, "verse_number": "९-१८-६४", "content_sanskrit": "सुखः साङ्ग्रामिको मृत्युर्दुःखो व्याधिजरादिभिः।\nमर्त्येनावश्यमर्तव्यं गृहेष्वपि कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2066390, "chapter_id": 2400, "verse_number": "९-१८-६५", "content_sanskrit": "युध्यतः क्षत्रधर्मेण मृत्युरेष सनातनः।\nहत्वेह सुखमाप्नोति हतः प्रेत्य महत्फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2066391, "chapter_id": 2400, "verse_number": "९-१८-६६", "content_sanskrit": "न युद्धधर्माच्छ्रेयान्वै पन्थाः स्वर्गस्य कौरवाः।\nअचिरेणैव ताँल्लोकान्हतो युद्धे समश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2066392, "chapter_id": 2400, "verse_number": "९-१८-६७", "content_sanskrit": "श्रुत्वा तद्वचनं तस्य पूजयित्वा च पार्थिवाः।\nपुनरेवाभ्यवर्तन्त पाण्डवानाततायिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2066393, "chapter_id": 2400, "verse_number": "९-१८-६८", "content_sanskrit": "तानापतत एवाशु व्यूढानीकाः प्रहारिणः।\nप्रत्युद्ययुस्तदा पार्था जयगृद्धाः प्रमन्यवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2066394, "chapter_id": 2400, "verse_number": "९-१८-६९", "content_sanskrit": "धनञ्जयो रथेनाजावभ्यवर्तत वीर्यवान्।\nविश्रुतं त्रिषु लोकेषु व्याक्षिपन्गाण्डिवं धनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2066395, "chapter_id": 2400, "verse_number": "९-१८-७०", "content_sanskrit": "माद्रीपुत्रौ च शकुनिं सात्यकिश्च महाबलः।\nजवेनाभ्यपतन्हृष्टा यत्ता वै तावकं बलम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2066396, "chapter_id": 2400, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि शल्यवधपर्वणि अष्टादशदिवसयुद्धे अष्टादशोऽध्यायः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]