[{"id": 7000879000, "chapter_id": 20879, "verse_number": "६-२२२-१", "content_sanskrit": "नारद उवाच ।\nआकर्णय शिबे राजन्वर्णयामि तवाग्रतः ।\nपुण्यं यशस्यमायुष्यं काश्या माहात्म्यमुत्तमम् ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000879001, "chapter_id": 20879, "verse_number": "६-२२२-२", "content_sanskrit": "इंद्रप्रस्थतटस्थायां काश्यामेकस्तु पादपः ।\nशिंशपाख्योभवेद्राजन् पुरा पुण्ययुगे कृते ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000879002, "chapter_id": 20879, "verse_number": "६-२२२-३", "content_sanskrit": "तत्रैको वायसो ह्यासीत्कृतनीडो वनस्पतौ ।\nतस्याधस्तान्महासर्पं कोटरेव सति स्म ह ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000879003, "chapter_id": 20879, "verse_number": "६-२२२-४", "content_sanskrit": "एकदा तस्य काकस्य भार्यांडद्वयमालये ।\nप्रतिमुच्य गता क्वापि न नीडे स्वे समागता ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000879004, "chapter_id": 20879, "verse_number": "६-२२२-५", "content_sanskrit": "स्वयमेव स काकस्तु पालयन्नंडकद्वयम् ।\nतामेव शिंशपामुच्चैरध्यतिष्ठन्महीपते ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000879005, "chapter_id": 20879, "verse_number": "६-२२२-६", "content_sanskrit": "अथैकदा निशीधे तु महावात्या समागता ।\nअभनक्शिंशपां राजन्मूलादपि दृढादपि ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000879006, "chapter_id": 20879, "verse_number": "६-२२२-७", "content_sanskrit": "वात्यया पात्यमानाया शिंशपायास्तदा तले ।\nचूर्णितौ काकसर्पौ तौ गतप्राणौ बभूवतुः ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000879007, "chapter_id": 20879, "verse_number": "६-२२२-८", "content_sanskrit": "दिव्यांगास्ते त्रयो भूत्वा शिंशपा वायसादयः ।\nविमानत्रयमारूढा जग्मुः श्रीपतिकेतनम् ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000879008, "chapter_id": 20879, "verse_number": "६-२२२-९", "content_sanskrit": "शिबिरुवाच ।\nदेवर्षे केन पुण्येन प्राप्ता तैर्मुक्तिदा पुरी ।\nआसंस्ते के त्रयः पूर्वं सर्वं कथय नारद ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000879009, "chapter_id": 20879, "verse_number": "६-२२२-१०", "content_sanskrit": "नारद उवाच ।\nकुरुजांगलदेशीयो ब्राह्मणः श्रवणाभिधः ।\nतस्य भार्या कुडा नाम भ्राताभूच्च कुरंटकः ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000879010, "chapter_id": 20879, "verse_number": "६-२२२-११", "content_sanskrit": "अस्नातभोक्ता नित्यं स कवलो मिष्टभुग्रहः ।\nश्रवणस्तेन दोषेण बभूव ग्रामवायसः ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000879011, "chapter_id": 20879, "verse_number": "६-२२२-१२", "content_sanskrit": "कुरंटकस्तु तद्भ्राता नास्तिकोऽभवदुल्बणः ।\nश्रुतिस्मृतिपथोच्छेत्ता देवतानां च निंदकः ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000879012, "chapter_id": 20879, "verse_number": "६-२२२-१३", "content_sanskrit": "तेन दोषेण स मृतो ह्यभवत्कालकुंडली ।\nसा कुंडा श्रवणस्य स्त्री बभूवोभयदोषभाक् ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000879013, "chapter_id": 20879, "verse_number": "६-२२२-१४", "content_sanskrit": "अतः सा स्थावरत्वं हि लब्ध्वासीदुभयाश्रया ।\nएतत्ते कथितं भूप तद्वृत्तं पूर्वजन्मनि ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000879014, "chapter_id": 20879, "verse_number": "६-२२२-१५", "content_sanskrit": "अतः परं प्रवक्ष्यामि तेषां पुण्यं यतस्त्रयः ।\nप्रापुस्तेन पुरीं रम्यां काशीं वैश्वेश्वरीं नृप ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000879015, "chapter_id": 20879, "verse_number": "६-२२२-१६", "content_sanskrit": "ग्रामांतरादेकदा तौ प्रत्यायातौ निजालयम् ।\nकस्यचित्पथिकस्याथ कूपमग्नां पयस्विनीम् ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000879016, "chapter_id": 20879, "verse_number": "६-२२२-१७", "content_sanskrit": "अवलोक्य तदुद्धारं चक्रतुस्तेन नोदितौ ।\nताभ्यांगदितमाकर्ण्य कुंडा साध्वित्यभाषत ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000879017, "chapter_id": 20879, "verse_number": "६-२२२-१८", "content_sanskrit": "ते त्रयस्तेनपुण्येन मरणं प्राप्य दुर्लभम् ।\nइंद्रप्रस्थतटस्थायां काश्यां वैकुंठमारुहन् ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000879018, "chapter_id": 20879, "verse_number": "६-२२२-१९", "content_sanskrit": "इयं काशी महेशस्य पुरी यद्यपि भूपते ।\nतथाप्यस्यां मृतं जंतुर्वैकुंठे स्यात्सुखी हरेः ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000879019, "chapter_id": 20879, "verse_number": "६-२२२-२०", "content_sanskrit": "एतत्ते कथितं राजन्काश्या माहात्म्यमुत्तमम् ।\nकिमन्यच्छ्रोतुमिच्छा ते विद्यते तद्वदस्व मे ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000879020, "chapter_id": 20879, "verse_number": "६-२२२-२१", "content_sanskrit": "शिबिरुवाच ।\nमुने त्वया महेशस्य क्षेत्रत्रयमुदीरितम् ।\nकाशी च शिवकांची च गोकर्णं च तथापरम् ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000879021, "chapter_id": 20879, "verse_number": "६-२२२-२२", "content_sanskrit": "एकस्य महिमा प्रोक्तो त्वया काश्या महामुने ।\nगोकर्णशिवकांच्योश्च कथ्यतां यदि विद्यते ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000879022, "chapter_id": 20879, "verse_number": "६-२२२-२३", "content_sanskrit": "नारद उवाच ।\nगोकर्णं केवलं शैवं क्षेत्रं परमपावनम् ।\nतस्मिन्मृतो नरो राजन्शिवः स्यान्नात्र संशयः ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000879023, "chapter_id": 20879, "verse_number": "६-२२२-२४", "content_sanskrit": "स्थले जलेंतरिक्षे च जंतुस्तत्र मृयेत चेत् ।\nतदा कैलासशिखरो शिवः संभूय दीव्यति ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000879024, "chapter_id": 20879, "verse_number": "६-२२२-२५", "content_sanskrit": "अत्र गोकर्णतीर्थे स्यान्मृतस्य न पुनर्भवः ।\nशिवेन स समं राजन्मुक्तिं यास्यति कर्हिचित् ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000879025, "chapter_id": 20879, "verse_number": "६-२२२-२६", "content_sanskrit": "अस्यापि तव माहात्म्यं गोकर्णस्य महामते ।\nवर्णयामि यदाकर्णि मया ब्रह्ममुखात्प्रभो ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000879026, "chapter_id": 20879, "verse_number": "६-२२२-२७", "content_sanskrit": "प्रयागादेकगव्यूतौ गुरुतीर्थसमीपगः ।\nमर्यादापर्वतो योऽयं दृश्यते पुण्यदर्शनः ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000879027, "chapter_id": 20879, "verse_number": "६-२२२-२८", "content_sanskrit": "तत्रैकः कर्कटो नाम भिल्ल आसीत्सुदारुणः ।\nतस्य भार्या जरा नाम सा जघ्ने पतिपंचकम् ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000879028, "chapter_id": 20879, "verse_number": "६-२२२-२९", "content_sanskrit": "सा जरा विषसंयुक्तं षष्ठं कर्कटकं तदा ।\nअकरोन्मोदकं हंतुं तदा तेन स्वसुः श्रुतम् ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000879029, "chapter_id": 20879, "verse_number": "६-२२२-३०", "content_sanskrit": "निजाया मुखतो राजन्भिल्लेन च महात्मना ।\nबालां तां हंतुमारेभे कर्कटो भृशदारुणः ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000879030, "chapter_id": 20879, "verse_number": "६-२२२-३१", "content_sanskrit": "खङ्गपाणिर्यदा याति तद्वधाय स भिल्लपः ।\nयावत्तावत्तु सा यायाज्ज्ञात्वा निजवधोद्यमम् ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000879031, "chapter_id": 20879, "verse_number": "६-२२२-३२", "content_sanskrit": "वनमभ्यद्रवद्भीता निजप्राणपरीप्सया ।\nतामनुद्रवता तेन कर्कटेन महीपते ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000879032, "chapter_id": 20879, "verse_number": "६-२२२-३३", "content_sanskrit": "अत्र गोकर्णतीर्थे तु गृहीता खङ्गपाणिना ।\nशिरश्छित्वा तु खङ्गेन पातयित्वा जले वपुः ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000879033, "chapter_id": 20879, "verse_number": "६-२२२-३४", "content_sanskrit": "तस्य गोकर्णतीर्थस्य निजस्थानमगाच्च सः ।\nसा जरा तत्र गोकर्णे पापापि निधनं गता ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000879034, "chapter_id": 20879, "verse_number": "६-२२२-३५", "content_sanskrit": "कैलासशिखरे राजन्पार्वत्या अभवत्सखी ।\nअहं कथितवानेतत्तव गोकर्णवैभवम् ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000879035, "chapter_id": 20879, "verse_number": "६-२२२-३६", "content_sanskrit": "शिवकांच्याश्च माहात्म्यं पवित्रं वर्णयामि ते ।\nइंद्रप्रस्थतटस्थायां शिवकांच्यामपि प्रभो ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000879036, "chapter_id": 20879, "verse_number": "६-२२२-३७", "content_sanskrit": "गतिः सा परमा पुंसां गोकर्णे या मयोदिता ।\nअत्र श्रीमन्महादेवो विष्णुं सर्वसुरेश्वरम् ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000879037, "chapter_id": 20879, "verse_number": "६-२२२-३८", "content_sanskrit": "आराध्य भक्तराजत्वं लेभे ज्ञानं च तात्विकम् ।\nअतः सर्वे वयं पुत्रा ब्रह्मणस्तं महेश्वरम् ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000879038, "chapter_id": 20879, "verse_number": "६-२२२-३९", "content_sanskrit": "आराधयामः सततं सद्भक्तिज्ञानलिप्सया ।\nअत्र बाणासुरो राजन्नारराध महेश्वरम् ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000879039, "chapter_id": 20879, "verse_number": "६-२२२-४०", "content_sanskrit": "निराहारो वर्षशतं तद्गुणत्वबुभूषया ।\nतस्मै प्रसन्नो भगवान्गणत्वं दत्तवान्निजम् ॥४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000879040, "chapter_id": 20879, "verse_number": "६-२२२-४१", "content_sanskrit": "स्वयं च सर्वदा तस्य पुरपालो बभूवह ।\nइयं पुरी पुरा राजन्नासीद्विष्णोर्महात्मनः ॥४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000879041, "chapter_id": 20879, "verse_number": "६-२२२-४२", "content_sanskrit": "दत्ता शिवाय तुष्टेन तपसा तस्य विष्णुना ।\nअस्यामेकं पुरावृत्तं महदाश्चर्यकारकम् ॥४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000879042, "chapter_id": 20879, "verse_number": "६-२२२-४३", "content_sanskrit": "विप्रस्य शिवभक्तस्य वैकुंठाप्तिर्यथाभवत् ।\nएकस्तु ब्राह्मणो राजन् हेरंबो नाम धार्मिकः ॥४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000879043, "chapter_id": 20879, "verse_number": "६-२२२-४४", "content_sanskrit": "कायेन मनसा वाचा शिवपूजारतः सदा ।\nएकदा स महाभागः शिवतीर्थानि पर्यटन् ॥४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000879044, "chapter_id": 20879, "verse_number": "६-२२२-४५", "content_sanskrit": "शिवभक्तः शिवे राजन्शिवकांच्यामिहागतः ।\nएनां मनोहरां चैव न तत्याज स बुद्धिमान् ॥४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000879045, "chapter_id": 20879, "verse_number": "६-२२२-४६", "content_sanskrit": "पश्चात्तत्रैव तत्याज प्राणानस्या जलांतरे ।\nतत्रैव श्रीमहादेवगणास्तं ब्राह्मणोत्तमम् ॥४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000879046, "chapter_id": 20879, "verse_number": "६-२२२-४७", "content_sanskrit": "नीत्वा कैलासमचलं चेलुस्तदनुशासनात् ।\nअथ मध्ये समायाता गणा वैकुंठतो हरेः ॥४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000879047, "chapter_id": 20879, "verse_number": "६-२२२-४८", "content_sanskrit": "तेभ्यो बलात्समादातुं तं द्विजश्रेष्ठमुद्यताः ।\nआसीत्तेषां महयुद्धं गणानां हरिशर्वयोः ॥४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000879048, "chapter_id": 20879, "verse_number": "६-२२२-४९", "content_sanskrit": "तत्र युद्धेन वैकेषां विजयो न पराजयः ।\nतत्र वैकुंठतो विष्णुरागतो गरुडासनः ॥४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000879049, "chapter_id": 20879, "verse_number": "६-२२२-५०", "content_sanskrit": "कैलासाद्वृषभारूढो महेशश्च त्रिलोकधृक् ।\nतावन्योन्यं मुखं दृष्ट्वा विहस्य जगदीश्वरौ ॥५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000879050, "chapter_id": 20879, "verse_number": "६-२२२-५१", "content_sanskrit": "पश्यतस्म महद्युद्धं नभस्येव गणैः कृतम् ।\nअथ स्वीयान्गणान्विष्णुः शैवांश्च दिवि युद्धतः ॥५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000879051, "chapter_id": 20879, "verse_number": "६-२२२-५२", "content_sanskrit": "निवार्य तं द्विजं तार्क्ष्यमारोप्यागाच्छिवालयम् ।\nशिवेन तद्गणैश्चापि स्वकीयैरपि माधवः ॥५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000879052, "chapter_id": 20879, "verse_number": "६-२२२-५३", "content_sanskrit": "वृतो गछन्पथि श्रीमान्स्तुतस्त्रिदशवंदितः ।\nगत्वा विवेश तं चागं महादेवपुरःसरः ॥५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000879053, "chapter_id": 20879, "verse_number": "६-२२२-५४", "content_sanskrit": "तस्मै द्विजाय वै तस्य दर्शयन्रमणीयताम् ।\nअथ तस्मात्तु कैलासान्महादेवेन वंदितः ॥५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000879054, "chapter_id": 20879, "verse_number": "६-२२२-५५", "content_sanskrit": "माधवः परया भक्त्या वैकुंठमगमत्तदा ।\nद्विजः सोऽपि महाभागस्तीर्थस्यास्य प्रसादतः ॥५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000879055, "chapter_id": 20879, "verse_number": "६-२२२-५६", "content_sanskrit": "गोविंददर्शनं प्राप्य मुमुदे हरसन्निधौ ।\nएतत्ते कथितं राजन्शिवकांच्यास्तु वैभवम् ॥५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000879056, "chapter_id": 20879, "verse_number": "६-२२२-५७", "content_sanskrit": "तीर्थसप्तकनाम्नस्तु शृणुष्व सुसमाहितः ।\nतीर्थमेतन्महाराज चतुर्वर्गफलप्रदम् ॥५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000879057, "chapter_id": 20879, "verse_number": "६-२२२-५८", "content_sanskrit": "दर्शनात्स्पर्शनाद्ध्यानात्स्मरणादपि भूपते ।\nवसिष्ठादिभिरेतस्मिन्महर्षिभिरनुष्ठितम् ॥५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000879058, "chapter_id": 20879, "verse_number": "६-२२२-५९", "content_sanskrit": "महत्तपस्तु सृष्ट्यर्थं तत्रासंस्तु क्षमा नृप ।\nमरीचिरपि धर्मात्मा पुत्रार्थं स्नानमाचरन् ॥५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000879059, "chapter_id": 20879, "verse_number": "६-२२२-६०", "content_sanskrit": "अत्र लेभे महाभागः कश्यपं सुतमुत्तमम् ।\nअत्रिरत्रापि तपसा तोषयद्देवपुंगवान् ॥६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000879060, "chapter_id": 20879, "verse_number": "६-२२२-६१", "content_sanskrit": "सोमं दुर्वाससं दत्तं तेभ्यो लेभे सुतत्रयम् ।\nअंगिरा अपि धर्मात्मा तीर्थस्यास्य प्रसादतः ॥६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000879061, "chapter_id": 20879, "verse_number": "६-२२२-६२", "content_sanskrit": "लेभे सुतांस्तुतद्वंश्या जाता आंगिरसा द्विजाः ।\nपुलहोऽपि सुतं लेभे दंभोलि गुणवत्तरम् ॥६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000879062, "chapter_id": 20879, "verse_number": "६-२२२-६३", "content_sanskrit": "योऽगस्त्योभूत्पुरा राजंस्तीर्थेऽत्रैव निमज्जनात् ।\nपुलस्त्यस्यात्र तीर्थे वै पुत्रो लब्धो तपस्यतः ॥६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000879063, "chapter_id": 20879, "verse_number": "६-२२२-६४", "content_sanskrit": "कुबेरोभून्महाभागो यः सखासीदुमापतेः ।\nक्रतोरपि सुता जाता वालखिल्याः सहस्रशः ॥६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000879064, "chapter_id": 20879, "verse_number": "६-२२२-६५", "content_sanskrit": "तीर्थस्यास्य प्रसादेन ते सर्वे ह्यूर्ध्वरेतसः ।\nरजआदीन्सुतां लेभे वसिष्ठोऽपि महातपाः ॥६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000879065, "chapter_id": 20879, "verse_number": "६-२२२-६६", "content_sanskrit": "सप्तैव राजशार्दूल महिमा तस्य वर्णितः ।\nअन्यान्यपि च तीर्थानि संत्यनेकानि भूपते ॥६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000879066, "chapter_id": 20879, "verse_number": "६-२२२-६७", "content_sanskrit": "कपिलाश्रमकेदारप्रभासादीनि वै प्रभौ ।\nनियुतैरपि वर्षाणां तेषां च महिमा नृप ।\nअनंतेनापि नो वक्तुं शक्यते किमु मादृशैः ॥६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000879067, "chapter_id": 20879, "verse_number": "६-२२२-६८", "content_sanskrit": "सौभरिरुवाच ।\nएवमुक्त्वा मुनिश्रेष्ठो नारदो मुनिपुंगवः ।\nशिवं जगाम नभसो नारायणगुणान्गृणन् ॥६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000879068, "chapter_id": 20879, "verse_number": "६-२२२-६९", "content_sanskrit": "शिबिरौशीनरो राजा शक्रप्रस्थस्य वैभवम् ।\nश्रुत्वा मुनिमुखाद्राजन्कृतार्थं स्वममन्यत ॥६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000879069, "chapter_id": 20879, "verse_number": "६-२२२-७०", "content_sanskrit": "तत्र स्नात्वा हि विधिवदिंद्रप्रस्थे स भूपतिः ।\nविधाय सत्क्रियाः सर्वा जगाम निजपत्तनम् ॥७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000879070, "chapter_id": 20879, "verse_number": "६-२२२-७१", "content_sanskrit": "इंद्रप्रस्थस्य माहात्म्यमेतत्तव मया विभो ।\nयमुनातीरतीर्थस्य वर्णितं जनपावनम् ॥७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000879071, "chapter_id": 20879, "verse_number": "६-२२२-७२", "content_sanskrit": "नास्यादरं करिष्यंति कलौ श्रद्धाविवर्जिताः ।\nइंद्रप्रस्थस्य राजेंद्र सर्वतीर्थशिरोमणेः ॥७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000879072, "chapter_id": 20879, "verse_number": "६-२२२-७३", "content_sanskrit": "अष्टादशपुराणानां श्रवणाद्भारतस्य च ।\nयत्फलं तन्महिम्नस्य शक्रप्रस्थस्य जायते ॥७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000879073, "chapter_id": 20879, "verse_number": "६-२२२-७४", "content_sanskrit": "अरुणोदयवेलायां माघलक्षैकमज्जनात् ।\nयत्फलं तन्महिम्नोस्य श्रवणाच्छ्रद्धया भवेत् ॥७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000879074, "chapter_id": 20879, "verse_number": "६-२२२-७५", "content_sanskrit": "श्रद्धयास्य तु माहात्म्यं यः शृणोति महीपते ।\nतर्पितास्तेन पितरो देवाश्च मुनयस्तथा ॥७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000879075, "chapter_id": 20879, "verse_number": "६-२२२-७६", "content_sanskrit": "कृच्छ्रातिकृच्छ्रपाराक चांद्रायण व्रतादिभिः ।\nयत्फलं तन्महिम्नोऽस्य श्रद्धया श्रवणाद्भवेत् ॥७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000879076, "chapter_id": 20879, "verse_number": "६-२२२-७७", "content_sanskrit": "अश्वमेधादियज्ञानां समस्तानां महीपते ।\nयत्फलं तन्महिम्नोऽस्य श्रद्धया श्रवणाद्भवेत् ॥७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000879077, "chapter_id": 20879, "verse_number": "६-२२२-७८", "content_sanskrit": "सूत उवाच ।\nएवं युधिष्ठिरो राजा श्रुत्वा शौनक सौभरेः ।\nइंद्रप्रस्थस्य माहात्म्यं स ययौ हस्तिनं पुरम् ॥७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000879078, "chapter_id": 20879, "verse_number": "६-२२२-७९", "content_sanskrit": "ततो विनीय सद्भ्रातॄन्दुर्योधनपुरःसरान् ।\nइंद्रप्रस्थमगात्पुण्यं राजसूयचिकीर्षया ॥७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000879079, "chapter_id": 20879, "verse_number": "६-२२२-८०", "content_sanskrit": "द्वारकायाः समागम्य गोविंदं कुलदैवतम् ।\nराजसूयेन यज्ञेन स इयाज महीपतिः ॥८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000879080, "chapter_id": 20879, "verse_number": "६-२२२-८१", "content_sanskrit": "मुक्तिदं तीर्थमेतत्तु शपतोस्याप्यजायत ।\nइति मत्वा हरिस्तत्र शिशुपालं जघान ह ॥८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000879081, "chapter_id": 20879, "verse_number": "६-२२२-८२", "content_sanskrit": "शिशुपालोऽपि तस्यैव तीर्थस्य मरणाद्भुवि ।\nसायुज्यमगमत्कृष्णे निखिलार्थप्रदायके ॥८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000879082, "chapter_id": 20879, "verse_number": "६-२२२-८३", "content_sanskrit": "शिशुपालो हतो यत्र विहितो यत्र चक्रतुः ।\nगदया तत्र भीमेन कृतं कुंडं सुविस्तरम् ॥८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000879083, "chapter_id": 20879, "verse_number": "६-२२२-८४", "content_sanskrit": "भीमकुंडं तु विज्ञातं जातं तद्भुविपावनम् ।\nकालिंद्या दक्षिणे भागे गव्यूत्यर्धं महीतले ॥८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000879084, "chapter_id": 20879, "verse_number": "६-२२२-८५", "content_sanskrit": "इंद्रप्रस्थगताया यत्कालिंद्याः स्नानतः फलम् ।\nतत्फलं तत्र कुंडे तु जायते नात्र संशयः ॥८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000879085, "chapter_id": 20879, "verse_number": "६-२२२-८६", "content_sanskrit": "सूत उवाच ।\nयस्मिन्क्षेत्रे स्थितो जंतुस्तं क्षेत्रमनुवत्सरम् ।\nप्रदक्षिणादिभिर्धर्मैः स्वापराधान्क्षमापयतेत् ॥८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000879086, "chapter_id": 20879, "verse_number": "६-२२२-८७", "content_sanskrit": "प्रतिसंवत्सरं चैव परिक्रामति यो नरः ।\nक्षेत्रापराधदोषैश्च न स लिप्येत्तु पातकैः ॥८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000879087, "chapter_id": 20879, "verse_number": "६-२२२-८८", "content_sanskrit": "प्रदक्षिणमकुर्वाणः क्षेत्रसिद्धिं न विंदति ।\nतस्मात्प्रदक्षिणा तीर्थे दातव्या च फलार्थिभिः ॥८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000879088, "chapter_id": 20879, "verse_number": "६-२२२-८९", "content_sanskrit": "हरेर्नाम निसंजल्पन्प्रकरोति प्रदक्षिणाम् ।\nपदेपदे स लभते कपिलादानजं फलम् ॥८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000879089, "chapter_id": 20879, "verse_number": "६-२२२-९०", "content_sanskrit": "चैत्रकृष्णचतुर्दश्यां शक्रप्रस्थप्रदक्षिणाम् ।\nयः करोति नरो धन्यः सर्वपापैः प्रमुच्यते ॥९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}]