[{"id": 2201700, "chapter_id": 5299, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2201701, "chapter_id": 5299, "verse_number": "१", "content_sanskrit": "गार्हस्थ्यं धर्ममखिलं प्रब्रूहि भरतर्षभ ।\nऋद्धिमाप्नोति किं कृत्वा मनुष्य इह पार्थिव\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2201702, "chapter_id": 5299, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2201703, "chapter_id": 5299, "verse_number": "२", "content_sanskrit": "अत्र ते वर्तयिष्यामि पुरावृत्तं जनाधिप ।\nवासुदेवस्य संवादं पृथिव्याश्चैव भारत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2201704, "chapter_id": 5299, "verse_number": "३", "content_sanskrit": "संस्तूय पृथिवीं देवीं वासुदेवः प्रतापवान् ।\nपप्रच्छ भरतश्रेष्ठ यदेतत्पृच्छसेऽद्य माम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2201705, "chapter_id": 5299, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2201706, "chapter_id": 5299, "verse_number": "४", "content_sanskrit": "गार्हस्थ्यं धर्ममाश्रित्य मया वा मद्विधेन वा ।\nकिमवश्यं धरे कार्यं किं वा कृत्वा सुखी भवेत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2201707, "chapter_id": 5299, "verse_number": "", "content_sanskrit": "पृथिवी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2201708, "chapter_id": 5299, "verse_number": "५", "content_sanskrit": "ऋषयः पितरो देवा मनुष्याश्चैव माधव ।\nइज्याश्चैवार्चनीयाश्च यथा चैवं निबोध मे\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2201709, "chapter_id": 5299, "verse_number": "६", "content_sanskrit": "सदा यज्ञेन देवांश्च आतिथ्येन च मानवान् ।\nछन्दतश्च यथानित्यमर्हान् युञ्जीत नित्यशः ।\nतेन ह्यृषिगणाः प्रीता भवन्ति मधुसूदन\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2201710, "chapter_id": 5299, "verse_number": "७", "content_sanskrit": "नित्यमग्निं परिचरेदभुक्त्वा बलिकर्म च ।\nकुर्यात् तथैव देवा वै प्रीयन्ते मधुसूदन\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2201711, "chapter_id": 5299, "verse_number": "८", "content_sanskrit": "कुर्यादहरहः श्राद्धमन्नाद्येनोदकेन वा ।\nपयोमूलफलैर्वापि पितॄणां प्रीतिमाहरन्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2201712, "chapter_id": 5299, "verse_number": "९", "content_sanskrit": "सिद्धान्नाद् वैश्वदेवं वै कुर्यादग्नौ यथाविधि ।\nअग्नीषोमं वैश्वदेवं धान्वन्तर्यमनन्तरम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2201713, "chapter_id": 5299, "verse_number": "१०", "content_sanskrit": "प्रजानां पतये चैव पृथग् होमो विधीयते ।\nतथैव चानुपूर्व्येण बलिकर्म प्रयोजयेत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2201714, "chapter_id": 5299, "verse_number": "११", "content_sanskrit": "दक्षिणायां यमायेह प्रतीच्यां वरुणाय च ।\nसोमाय चाप्युदीच्यां वै वास्तुमध्ये द्विजातये\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2201715, "chapter_id": 5299, "verse_number": "१२", "content_sanskrit": "धन्वन्तरेः प्रागुदीच्यां प्राच्यां शक्राय माधव ।\nमनोर्वै इति च प्राहुर्बलिं द्वारे गृहस्य वै ।\nमरुद्भ्यो देवताभ्यश्च बलिमन्तर्गृहे हरेत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2201716, "chapter_id": 5299, "verse_number": "१३", "content_sanskrit": "तथैव विश्वेदेवेभ्यो बलिमाकाशतो हरेत् ।\nनिशाचरेभ्यो भूतेभ्यो बलिं नक्तं तथा हरेत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2201717, "chapter_id": 5299, "verse_number": "१४", "content_sanskrit": "एवं कृत्वा बलिं सम्यग् दद्याद् भिक्षां द्विजातये ।\nअलाभे ब्राह्मणस्याग्नावग्रमुत्क्षिप्य निक्षिपेत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2201718, "chapter_id": 5299, "verse_number": "१५", "content_sanskrit": "यदा श्राद्धं पितृभ्यश्च दातुमिच्छेत मानवः ।\nतदा पश्चात् प्रकुर्वीत निवृत्ते श्राद्धकर्मणि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2201719, "chapter_id": 5299, "verse_number": "१६", "content_sanskrit": "पितॄन् सन्तर्पयित्वा तु बलिं कुर्याद् विधानतः ।\nवैश्वदेवं ततः कुर्यात् पश्चाद् ब्राह्मणभोजनम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2201720, "chapter_id": 5299, "verse_number": "१७", "content_sanskrit": "ततोऽन्नेनावशेषेण भोजयेदतिथीनपि ।\nअर्चापूर्वं महाराज ततः प्रीणाति मानुषान्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2201721, "chapter_id": 5299, "verse_number": "१९", "content_sanskrit": "अनित्यं हि स्थितो यस्मात् तस्मादतिथिरुच्यते ।\nआचार्यस्य पितुश्चैव सख्युराप्तस्य चातिथेः ।\nइदमस्ति गृहे मह्यमिति नित्यं निवेदयेत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2201722, "chapter_id": 5299, "verse_number": "२०", "content_sanskrit": "ते यद्वदेयुस्तत्कुर्यादिति धर्मो विधीयते ।\nगृहस्थः पुरुषः कृष्ण शिष्टाशी च सदा भवेत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2201723, "chapter_id": 5299, "verse_number": "२१", "content_sanskrit": "राजर्त्विजं स्नातकं च गुरुं श्वशुरमेव च ।\nअर्चयेन्मधुपर्केण परिसंवत्सरोषितान्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2201724, "chapter_id": 5299, "verse_number": "२२", "content_sanskrit": "श्वभ्यश्च श्वपचेभ्यश्च वयोभ्यश्चावपेद् भुवि ।\nवैश्वदेवं हि नामैतत् सायम्प्रातर्विधीयते\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2201725, "chapter_id": 5299, "verse_number": "२३", "content_sanskrit": "एतांस्तु धर्मान् गार्हस्थ्यान्यः कुर्यादनसूयकः ।\nस इहर्द्धिं परां प्राप्य प्रेत्य नाके महीयते\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2201726, "chapter_id": 5299, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2201727, "chapter_id": 5299, "verse_number": "समाप्तिः", "content_sanskrit": "इति भूमेर्वचः श्रुत्वा वासुदेवः प्रतापवान् ।\nतथा चकार सततं त्वमप्येवं समाचर\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2201728, "chapter_id": 5299, "verse_number": "२५", "content_sanskrit": "एवं गृहस्थधर्मं त्वं चेतयानो नराधिप ।\nइहलोके यशः प्राप्य प्रेत्य स्वर्गमवाप्स्यसि\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2201729, "chapter_id": 5299, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे गार्हस्थ्यधर्मनिरूपणं नाम पञ्चाशदधिकशततमोऽध्यायः ॥१५०॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]