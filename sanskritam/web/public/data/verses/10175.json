[{"id": 6000175000, "chapter_id": 10175, "verse_number": null, "content_sanskrit": "अथ द्वाविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000175001, "chapter_id": 10175, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.001.m4a", "display_order": 2}, {"id": 6000175002, "chapter_id": 10175, "verse_number": "८-२२-१", "content_sanskrit": "भगवन् श्रोतुमिच्छामि हरेरद्भुतकर्मणः।\nअवतारकथामाद्यां मायामत्स्यविडम्बनाम्॥ ८/२२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.002.m4a", "display_order": 3, "topics": [{"text": "वराहादिकान्भगवतः कांश्चनावतरान् श्रुतवता राज्ञा मत्स्यावतारकथां वक्तुं प्रार्थितेन शुकाचार्येण सत्यव्रतकथाकथनपूर्वकं मत्स्यावतारनिरूपणम्", "range": "१–६१"}]}, {"id": 6000175003, "chapter_id": 10175, "verse_number": "८-२२-२", "content_sanskrit": "यदर्थमदधाद् रूपं मात्स्यं लोकजुगुप्सितम्।\nतमःप्रकृति दुर्मर्षं कर्मग्रस्त इवेश्वरः॥ ८/२२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.003.m4a", "display_order": 4}, {"id": 6000175004, "chapter_id": 10175, "verse_number": "८-२२-३", "content_sanskrit": "एतन्नो भगवन् सर्वं यथावद् वक्तुमर्हसि।\nउत्तमश्लोकचरितं सर्वलोकसुखावहम्॥ ८/२२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.004.m4a", "display_order": 5}, {"id": 6000175005, "chapter_id": 10175, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.005.m4a", "display_order": 6}, {"id": 6000175006, "chapter_id": 10175, "verse_number": "८-२२-४", "content_sanskrit": "इत्युक्तो विष्णुरातेन भगवान् बादरायणिः।\nउवाच चरितं विष्णोर्मत्स्यरूपेण यत् कृतम्॥ ८/२२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.006.m4a", "display_order": 7}, {"id": 6000175007, "chapter_id": 10175, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.007.m4a", "display_order": 8}, {"id": 6000175008, "chapter_id": 10175, "verse_number": "८-२२-५", "content_sanskrit": "गोविप्रसुरसाधूनां छन्दसामपि चेश्वरः।\nरक्षामिच्छंस्तनूर्धत्ते धर्मस्यार्थस्य चैव हि॥ ८/२२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.008.m4a", "display_order": 9}, {"id": 6000175009, "chapter_id": 10175, "verse_number": "८-२२-६", "content_sanskrit": "उच्चावचेषु भूतेषु चरन् वायुरिवेश्वरः।\nनोच्चावचत्वं भजते निर्गुणत्वाद् धियो गुणैः॥ ८/२२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.009.m4a", "display_order": 10}, {"id": 6000175010, "chapter_id": 10175, "verse_number": "८-२२-७", "content_sanskrit": "आसीदतीतकल्पान्ते ब्राह्मो नैमित्तिको लयः।\nसमुद्रोपप्लुतास्तत्र लोका भूरादयोऽनघ॥ ८/२२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.010.m4a", "display_order": 11}, {"id": 6000175011, "chapter_id": 10175, "verse_number": "८-२२-८", "content_sanskrit": "कालेनागतनिद्रस्य धातुः शिशयिषोर्बली।\nमुखतो निःसृतान् वेदान् हयग्रीवोऽन्तिकेऽहरत्॥ ८/२२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.011.m4a", "display_order": 12}, {"id": 6000175012, "chapter_id": 10175, "verse_number": "८-२२-९", "content_sanskrit": "ज्ञात्वा तद् दानवेन्द्रस्य हयग्रीवस्य चेष्टितम्।\nदधार शफरीरूपं भगवान् हरिरीश्वरः॥ ८/२२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.012.m4a", "display_order": 13}, {"id": 6000175013, "chapter_id": 10175, "verse_number": "८-२२-१०", "content_sanskrit": "तत्र राजऋषिः कश्चिन्नाम्ना सत्यव्रतो महान्।\nनारायणपरोऽतप्यत् तपस्तत्सलिलाशये॥ ८/२२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.013.m4a", "display_order": 14}, {"id": 6000175014, "chapter_id": 10175, "verse_number": "८-२२-११", "content_sanskrit": "योऽसावस्मिन् महाकल्पे तनयः स विवस्वतः।\nश्राद्धदेव इति ख्यातो मनुत्वे हरिणाऽर्पितः॥ ८/२२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.014.m4a", "display_order": 15}, {"id": 6000175015, "chapter_id": 10175, "verse_number": "८-२२-१२", "content_sanskrit": "एकदा कृतमालायां कुर्वतो जलतर्पणम्।\nतस्याञ्जल्युदके काचित् शफर्येकाऽभ्यपद्यत॥ ८/२२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.015.m4a", "display_order": 16}, {"id": 6000175016, "chapter_id": 10175, "verse_number": "८-२२-१३", "content_sanskrit": "सत्यव्रतोऽञ्जलिगतां सह तोयेन भारत।\nउत्ससर्ज नदीतोये शफरीं द्रविडेश्वरः॥ ८/२२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.016.m4a", "display_order": 17}, {"id": 6000175017, "chapter_id": 10175, "verse_number": "८-२२-१४", "content_sanskrit": "तमाह साऽतिकरुणं महाकारुणिकं नृपम्। यादोभ्यो ज्ञातिघातिभ्यो दीनां मां दीनवत्सल।\nकथं विसृजसे राजन् भीतामस्मिन् सरिज्जले॥ ८/२२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.017.m4a", "display_order": 18}, {"id": 6000175018, "chapter_id": 10175, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.018.m4a", "display_order": 19}, {"id": 6000175019, "chapter_id": 10175, "verse_number": "८-२२-१५", "content_sanskrit": "तमात्मनोऽनुग्रहार्थं प्राप्तं मत्स्यवपुर्धरम्।\nअजानन् रक्षणार्थाय शफर्याः स मनो दधे॥ ८/२२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.019.m4a", "display_order": 20}, {"id": 6000175020, "chapter_id": 10175, "verse_number": "८-२२-१६", "content_sanskrit": "तस्या दीनतरं वाक्यमाश्रुत्य स महीपतिः।\nकलशाप्सु निधायैनां दयालुर्निन्य आश्रमम्॥ ८/२२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.020.m4a", "display_order": 21}, {"id": 6000175021, "chapter_id": 10175, "verse_number": "८-२२-१७", "content_sanskrit": "सा तु तत्रैकरात्रेण वर्धमाना कमण्डलौ।\nअलब्धात्मावकाशं वा इदमाह महीपतिम्॥ ८/२२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.021.m4a", "display_order": 22}, {"id": 6000175022, "chapter_id": 10175, "verse_number": "८-२२-१८", "content_sanskrit": "नाहं कमण्डलावस्मिन् कृच्छ्रं वस्तुमिहोत्सहे।\nकल्पयौकः सुविपुलं यत्राहं निवसे सुखम्॥ ८/२२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.022.m4a", "display_order": 23}, {"id": 6000175023, "chapter_id": 10175, "verse_number": "८-२२-१९", "content_sanskrit": "स एनां तत आदाय न्यधादौदञ्चनोदके।\nतत्र क्षिप्ता मुहूर्तेन हस्तत्रयमवर्धत॥ ८/२२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.023.m4a", "display_order": 24}, {"id": 6000175024, "chapter_id": 10175, "verse_number": null, "content_sanskrit": "मीन उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.024.m4a", "display_order": 25}, {"id": 6000175025, "chapter_id": 10175, "verse_number": "८-२२-२०", "content_sanskrit": "न म एतदलं राजन् सुखं वस्तुमुदञ्चनम्।\nपृथु देहि पदं मह्यं यत् त्वाऽहं शरणं गता॥ ८/२२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.025.m4a", "display_order": 26}, {"id": 6000175026, "chapter_id": 10175, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.026.m4a", "display_order": 27}, {"id": 6000175027, "chapter_id": 10175, "verse_number": "८-२२-२१", "content_sanskrit": "तत आदाय सा राज्ञा क्षिप्ता राजन् सरोवरे।\nतदावृत्याऽत्मना सर्वं महामीनोऽन्ववर्धत॥ ८/२२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.027.m4a", "display_order": 28}, {"id": 6000175028, "chapter_id": 10175, "verse_number": null, "content_sanskrit": "मीन उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.028.m4a", "display_order": 29}, {"id": 6000175029, "chapter_id": 10175, "verse_number": "८-२२-२२", "content_sanskrit": "नैतन्मे स्वस्तये राजन्नुदकं सलिलौकसः।\nनिधेहि रक्षायोगेन ह्रदे मामविदासिनि॥ ८/२२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.029.m4a", "display_order": 30}, {"id": 6000175030, "chapter_id": 10175, "verse_number": "८-२२-२३", "content_sanskrit": "इत्युक्तः सोऽनयन्मत्स्यं तत्र तत्राविदासिनि।\nजलाशयेऽसम्मितं तं समुद्रे प्राक्षिपज्झषम्॥ ८/२२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.030.m4a", "display_order": 31}, {"id": 6000175031, "chapter_id": 10175, "verse_number": "८-२२-२४", "content_sanskrit": "क्षिप्यमाणस्तमाहेदमिह मां मकरादयः।\nअदन्त्यतिबला वीर मां नेहोत्स्रष्टुमर्हसि॥ ८/२२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.031.m4a", "display_order": 32}, {"id": 6000175032, "chapter_id": 10175, "verse_number": "८-२२-२५", "content_sanskrit": "एवं विमोहितस्तेन वदता वल्गुभारतीम्।\nतमाह को भवानस्मान् मत्स्यरूपेण मोहयन्॥ ८/२२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.032.m4a", "display_order": 33}, {"id": 6000175033, "chapter_id": 10175, "verse_number": "८-२२-२६", "content_sanskrit": "नैवंवीर्यो जलचरो दृष्टोऽस्माभिः श्रुतोऽपि वा।\nयो भवान् योजनशतमह्नाय व्यानशे सरः॥ ८/२२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.033.m4a", "display_order": 34}, {"id": 6000175034, "chapter_id": 10175, "verse_number": "८-२२-२७", "content_sanskrit": "नूनं त्वं भगवान् साक्षाद् हरिर्नारायणोऽव्ययः।\nअनुग्रहाय भूतानां धत्से रूपं जलौकसाम्॥ ८/२२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.034.m4a", "display_order": 35}, {"id": 6000175035, "chapter_id": 10175, "verse_number": "८-२२-२८", "content_sanskrit": "नमस्ते पुरुषश्रेष्ठ स्थित्युत्पत्त्यप्ययेश्वर।\nभक्तानां नः प्रपन्नानां मुख्यो ह्यात्मा गतिर्विभो॥ ८/२२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.035.m4a", "display_order": 36}, {"id": 6000175036, "chapter_id": 10175, "verse_number": "८-२२-२९", "content_sanskrit": "सर्वे लीलावतारास्ते भूतानां भूतिहेतवे।\nज्ञातुमिच्छाम्यदो रूपं यदर्थं भवता धृतम्॥ ८/२२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.036.m4a", "display_order": 37}, {"id": 6000175037, "chapter_id": 10175, "verse_number": "८-२२-३०", "content_sanskrit": "न तेऽरविन्दाक्ष पदोपसर्पणं मुधा भवेत् सर्वसुहृत्प्रियात्मनः।\nयथेतरेषां पृथगात्मनां सतामदीदृशो यद् वपुरद्भुतं हि नः॥ ८/२२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.037.m4a", "display_order": 38}, {"id": 6000175038, "chapter_id": 10175, "verse_number": "८-२२-३१", "content_sanskrit": "इति ब्रुवाणं नृपतिं जगत्पतिः सत्यव्रतं मत्स्यवपुर्युगक्षये।\nविहर्तुकामः प्रलयार्णवेऽब्रवीच्चिकीर्षुरेकान्तजनप्रियं प्रियः॥ ८/२२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.038.m4a", "display_order": 39}, {"id": 6000175039, "chapter_id": 10175, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.039.m4a", "display_order": 40}, {"id": 6000175040, "chapter_id": 10175, "verse_number": "८-२२-३२", "content_sanskrit": "सप्तमेऽद्यतनादूर्ध्वमहन्येतदरिन्दम।\nनिमङ्क्ष्यत्यप्ययाम्भोधौ त्रैलोक्यं भूर्भुवादिकम्॥ ८/२२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.040.m4a", "display_order": 41}, {"id": 6000175041, "chapter_id": 10175, "verse_number": "८-२२-३३", "content_sanskrit": "त्रिलोक्यां लीयमानायां संवर्ताम्भसि वै तदा।\nउपस्थास्यति नौः काचिद् विशाला त्वां मयेरिता॥ ८/२२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.041.m4a", "display_order": 42}, {"id": 6000175042, "chapter_id": 10175, "verse_number": "८-२२-३४", "content_sanskrit": "त्वं तावदौषधीः सर्वा बीजान्युच्चावचानि च।\nसप्तर्षिभिः परिवृतः सर्वसत्त्वोपबृंहितः॥ ८/२२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.042.m4a", "display_order": 43}, {"id": 6000175043, "chapter_id": 10175, "verse_number": "८-२२-३५", "content_sanskrit": "आरुह्य बृहतीं नावं विचरिष्यस्यविक्लवः।\nएकार्णवे निरालोके ऋषीणामेव वर्चसा॥ ८/२२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.043.m4a", "display_order": 44}, {"id": 6000175044, "chapter_id": 10175, "verse_number": "८-२२-३६", "content_sanskrit": "दोधूयमानां तां नावं समीरेण बलीयसा।\nउपस्थितस्य मे शृङ्गे निबध्नीहि महाहिना॥ ८/२२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.044.m4a", "display_order": 45}, {"id": 6000175045, "chapter_id": 10175, "verse_number": "८-२२-३७", "content_sanskrit": "अहं त्वामृषिभिः साकं सह नावमुदन्वति।\nविकर्षन् विचरिष्यामि यावद् ब्राह्मी निशा प्रभो॥ ८/२२/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.045.m4a", "display_order": 46}, {"id": 6000175046, "chapter_id": 10175, "verse_number": "८-२२-३८", "content_sanskrit": "मदीयं महिमानं च परं ब्रह्मेति शब्दितम्।\nवेत्स्यस्यनुगृहीतं मे सम्प्रश्नैर्विवृतं हृदि॥ ८/२२/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.046.m4a", "display_order": 47}, {"id": 6000175047, "chapter_id": 10175, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.047.m4a", "display_order": 48}, {"id": 6000175048, "chapter_id": 10175, "verse_number": "८-२२-३९", "content_sanskrit": "इत्थमादिश्य राजानं हरिरन्तरधीयत।\nसोऽन्ववैक्षत तं कालं यं हृषीकेश आदिशत्॥ ८/२२/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.048.m4a", "display_order": 49}, {"id": 6000175049, "chapter_id": 10175, "verse_number": "८-२२-४०", "content_sanskrit": "आस्तीर्य दर्भान् प्राक्‍कूलान् राजर्षिः प्रागुदङ्मुखः।\nनिषसाद हरेः पादौ चिन्तयन् मत्स्यरूपिणः॥ ८/२२/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.049.m4a", "display_order": 50}, {"id": 6000175050, "chapter_id": 10175, "verse_number": "८-२२-४१", "content_sanskrit": "ततः समुद्र उद्वेलः सर्वतः प्लावयन् महीम्।\nवर्धमानो महामेघैर्वर्षद्भिः समदृश्यत॥ ८/२२/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.050.m4a", "display_order": 51}, {"id": 6000175051, "chapter_id": 10175, "verse_number": "८-२२-४२", "content_sanskrit": "ध्यायन् भगवदादेशं ददृशे नावमागताम्।\nतामारुरोह विप्रेन्द्रैरादायौषधिवीरुधः॥ ८/२२/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.051.m4a", "display_order": 52}, {"id": 6000175052, "chapter_id": 10175, "verse_number": "८-२२-४३", "content_sanskrit": "तमूचुर्मुनयः प्रीतं राजन् ध्यायस्व केशवम्।\nस वै नः संकटादस्मादविता शं विधास्यति॥ ८/२२/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.052.m4a", "display_order": 53}, {"id": 6000175053, "chapter_id": 10175, "verse_number": "८-२२-४४", "content_sanskrit": "सोऽनुध्यातस्ततो राज्ञा प्रादुरासीन्महार्णवे।\nएकशृङ्गधरो मत्स्यो हैमो नियुतयोजनः॥ ८/२२/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.053.m4a", "display_order": 54}, {"id": 6000175054, "chapter_id": 10175, "verse_number": "८-२२-४५", "content_sanskrit": "निबध्य नावं तच्छृङ्गे यथोक्तो हरिणा पुरा।\nवरत्रेणाहिना तुष्टस्तुष्टाव मधुसूदनम्॥ ८/२२/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.054.m4a", "display_order": 55}, {"id": 6000175055, "chapter_id": 10175, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.055.m4a", "display_order": 56}, {"id": 6000175056, "chapter_id": 10175, "verse_number": "८-२२-४६", "content_sanskrit": "अनाद्यविद्योपहतात्मसंविदस्तन्मूलसंसारपरिभ्रमातुराः।\nयदृच्छयेहोपसृता यमाप्नुयुर्विमुक्तिदो नः परमो गुरुर्भवान्॥ ८/२२/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.056.m4a", "display_order": 57}, {"id": 6000175057, "chapter_id": 10175, "verse_number": "८-२२-४७", "content_sanskrit": "जनोऽबुधोऽयं निजकर्मबन्धनः सुखेच्छया कर्म समीहतेऽसुखम्।\nयत्सेवया तां विधुनोत्यसन्मतिं ग्रन्थिं विभिन्द्याद् हृदये स नो गुरुः॥ ८/२२/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.057.m4a", "display_order": 58}, {"id": 6000175058, "chapter_id": 10175, "verse_number": "८-२२-४८", "content_sanskrit": "यत्सेवयाऽग्नेरिव रुद्ररोदनं पुमान् विजह्यान्मलमात्मनस्तमः।\nभजेत वर्णं निजमेष सोऽव्ययो भूयात् स ईशः परमो गुरोर्गुरुः॥ ८/२२/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.058.m4a", "display_order": 59}, {"id": 6000175059, "chapter_id": 10175, "verse_number": "८-२२-४९", "content_sanskrit": "न यत्प्रसादायुतभागलेशमन्ये च देवा गुरवो जनाः स्वयम्।\nकर्तुं समेताः प्रभवन्ति पुंसस्तमीश्वरं त्वां शरणं प्रपद्ये॥ ८/२२/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.059.m4a", "display_order": 60}, {"id": 6000175060, "chapter_id": 10175, "verse_number": "८-२२-५०", "content_sanskrit": "सचक्षुरन्धस्य यथाऽग्रणीः कृतस्तथा जनस्याविदुषो बुधो गुरुः।\nत्वमर्थदृक् सर्वदृशां समीक्षणो वृतो गुरुर्नः सुगतिं विवित्सताम्॥ ८/२२/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.060.m4a", "display_order": 61}, {"id": 6000175061, "chapter_id": 10175, "verse_number": "८-२२-५१", "content_sanskrit": "जनो जनस्यादिशतेऽसतीं गतिं यया प्रपद्येत दुरत्ययं तमः।\nत्वमव्ययं ज्ञानममोघमञ्जसा प्रपद्यते येन जनो निजं पदम्॥ ८/२२/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.061.m4a", "display_order": 62}, {"id": 6000175062, "chapter_id": 10175, "verse_number": "८-२२-५२", "content_sanskrit": "त्वं सर्वलोकस्य सुहृत् प्रियेश्वरो ह्यात्मा गुरुर्ज्ञानमभीष्टसिद्धिः।\nतथापि लोको न भवन्तमन्धधीर्जानाति सन्तं हृदि बद्धकामः॥ ८/२२/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.062.m4a", "display_order": 63}, {"id": 6000175063, "chapter_id": 10175, "verse_number": "८-२२-५३", "content_sanskrit": "तं त्वामहं देववरं वरेण्यं प्रपद्य ईशं प्रतिबोधनाय।\nछिन्ध्यर्थदीपैर्भगवन् वचोभिर्ग्रन्थिं हृदय्यां विवृणु स्वमोकः॥ ८/२२/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.063.m4a", "display_order": 64}, {"id": 6000175064, "chapter_id": 10175, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.064.m4a", "display_order": 65}, {"id": 6000175065, "chapter_id": 10175, "verse_number": "८-२२-५४", "content_sanskrit": "इत्युक्तवन्तं नृपतिं भगवानादिपूरुषः।\nमत्स्यरूपी महाम्भोधौ विहरंस्तत्त्वमब्रवीत्॥ ८/२२/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.065.m4a", "display_order": 66}, {"id": 6000175066, "chapter_id": 10175, "verse_number": "८-२२-५५", "content_sanskrit": "पुराणसंहितां दिव्यां साङ्ख्ययोगक्रियावतीम्।\nसत्यव्रतस्य राजर्षेरात्मगुह्यमशेषतः॥ ८/२२/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.066.m4a", "display_order": 67}, {"id": 6000175067, "chapter_id": 10175, "verse_number": "८-२२-५६", "content_sanskrit": "अश्रौषीद् ऋषिभिः साकमात्मतत्त्वमसंशयम्।\nनाव्यासीनो भगवता प्रोक्तं ब्रह्म सनातनम्॥ ८/२२/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.067.m4a", "display_order": 68}, {"id": 6000175068, "chapter_id": 10175, "verse_number": "८-२२-५७", "content_sanskrit": "अतीते प्रलयापाय उत्थिताय च वेधसे।\nहत्वाऽसुरं हयग्रीवं वेदान् प्रत्याहरद्धरिः॥ ८/२२/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.068.m4a", "display_order": 69}, {"id": 6000175069, "chapter_id": 10175, "verse_number": "८-२२-५८", "content_sanskrit": "स तु सत्यव्रतो राजा ज्ञानविज्ञानसंयुतः।\nविष्णोः प्रसादात् कल्पेऽस्मिन्नासीद् वैवस्वतो मनुः॥ ८/२२/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.069.m4a", "display_order": 70}, {"id": 6000175070, "chapter_id": 10175, "verse_number": "८-२२-५९", "content_sanskrit": "सत्यव्रतस्य राजर्षेर्मायामत्स्यस्य शार्ङ्गिणः।\nसंवादं महदाख्यातं श्रुत्वा मुच्येत किल्बिषात्॥ ८/२२/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.070.m4a", "display_order": 71}, {"id": 6000175071, "chapter_id": 10175, "verse_number": "८-२२-६०", "content_sanskrit": "अवतारं हरेर्योऽमुं कीर्तयेदन्वहं नरः।\nसङ्कल्पास्तस्य सिध्यन्ति प्रयाति परमां गतिम्॥ ८/२२/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.071.m4a", "display_order": 72}, {"id": 6000175072, "chapter_id": 10175, "verse_number": "८-२२-६१", "content_sanskrit": "प्रलयपयसि धातुः सुप्तशक्तेर्मुखेभ्यः श्रुतिगणमपनीतं प्रत्युपादत्त हत्वा।\nदितिजमकथयच्च ब्रह्म सत्यव्रताय तमहमखिलहेतुं जिह्ममीनं नतोऽस्मि॥ ८/२२/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_022/BhP_08.022.072.m4a", "display_order": 73}, {"id": 6000175073, "chapter_id": 10175, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् अष्टमस्कन्धे द्वाविंशाध्यायः॥\n॥ इति अष्टमस्कन्धः समाप्तः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]