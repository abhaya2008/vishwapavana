[{"id": 5000328000, "chapter_id": 9328, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे षट्पञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000328001, "chapter_id": 9328, "verse_number": "४-५६-१", "content_sanskrit": "उपविष्टास्तु ते सर्वे यस्मिन् प्रायं गिरिस्थले।\nहरयो गृध्रराजश्च तं देशमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000328002, "chapter_id": 9328, "verse_number": "४-५६-२", "content_sanskrit": "सम्पातिर्नाम नाम्ना तु चिरजीवी विहंगमः।\nभ्राता जटायुषः श्रीमान् विख्यातबलपौरुषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000328003, "chapter_id": 9328, "verse_number": "४-५६-३", "content_sanskrit": "कन्दरादभिनिष्क्रम्य स विन्ध्यस्य महागिरेः।\nउपविष्टान् हरीन् दृष्ट्वा हृष्टात्मा गिरमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000328004, "chapter_id": 9328, "verse_number": "४-५६-४", "content_sanskrit": "विधिः किल नरं लोके विधानेनानुवर्तते।\nयथायं विहितो भक्ष्यश्चिरान्मह्यमुपागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000328005, "chapter_id": 9328, "verse_number": "४-५६-५", "content_sanskrit": "परम्पराणां भक्षिष्ये वानराणां मृतं मृतम्।\nउवाचैतद् वचः पक्षी तान् निरीक्ष्य प्लवंगमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000328006, "chapter_id": 9328, "verse_number": "४-५६-६", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा भक्ष्यलुब्धस्य पक्षिणः।\nअङ्गदः परमायस्तो हनूमन्तमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000328007, "chapter_id": 9328, "verse_number": "४-५६-७", "content_sanskrit": "पश्य सीतापदेशेन साक्षाद् वैवस्वतो यमः।\nइमं देशमनुप्राप्तो वानराणां विपत्तये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000328008, "chapter_id": 9328, "verse_number": "४-५६-८", "content_sanskrit": "रामस्य न कृतं कार्यं न कृतं राजशासनम्।\nहरीणामियमज्ञाता विपत्तिः सहसाऽऽगता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000328009, "chapter_id": 9328, "verse_number": "४-५६-९", "content_sanskrit": "वैदेह्याः प्रियकामेन कृतं कर्म जटायुषा।\nगृध्रराजेन यत् तत्र श्रुतं वस्तदशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000328010, "chapter_id": 9328, "verse_number": "४-५६-१०", "content_sanskrit": "तथा सर्वाणि भूतानि तिर्यग्योनिगतान्यपि।\nप्रियं कुर्वन्ति रामस्य त्यक्त्वा प्राणान् यथा वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000328011, "chapter_id": 9328, "verse_number": "४-५६-११", "content_sanskrit": "अन्योन्यमुपकुर्वन्ति स्नेहकारुण्ययन्त्रिताः।\nततस्तस्योपकारार्थं त्यजतात्मानमात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000328012, "chapter_id": 9328, "verse_number": "४-५६-१२", "content_sanskrit": "प्रियं कृतं हि रामस्य धर्मज्ञेन जटायुषा।\nराघवार्थे परिश्रान्ता वयं संत्यक्तजीविताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000328013, "chapter_id": 9328, "verse_number": "४-५६-१३", "content_sanskrit": "कान्ताराणि प्रपन्नाः स्म न च पश्याम मैथिलीम्।\nस सुखी गृध्रराजस्तु रावणेन हतो रणे।\nमुक्तश्च सुग्रीवभयाद् गतश्च परमां गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000328014, "chapter_id": 9328, "verse_number": "४-५६-१४", "content_sanskrit": "जटायुषो विनाशेन राज्ञो दशरथस्य च।\nहरणेन च वैदेह्याः संशयं हरयो गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000328015, "chapter_id": 9328, "verse_number": "४-५६-१५", "content_sanskrit": "रामलक्ष्मणयोर्वासमरण्ये सह सीतया।\nराघवस्य च बाणेन वालिनश्च तथा वधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000328016, "chapter_id": 9328, "verse_number": "४-५६-१६", "content_sanskrit": "रामकोपादशेषाणां रक्षसां च तथा वधम्।\nकैकेय्या वरदानेन इदं च विकृतं कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000328017, "chapter_id": 9328, "verse_number": "४-५६-१७", "content_sanskrit": "तदसुखमनुकीर्तितं वचो\nभुवि पतितांश्च निरीक्ष्य वानरान्।\nभृशचकितमतिर्महामतिः\nकृपणमुदाहृतवान् स गृध्रराजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000328018, "chapter_id": 9328, "verse_number": "४-५६-१८", "content_sanskrit": "तत् तु श्रुत्वा तथा वाक्यमङ्गदस्य मुखोद‍्गतम्।\nअब्रवीद् वचनं गृध्रस्तीक्ष्णतुण्डो महास्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000328019, "chapter_id": 9328, "verse_number": "४-५६-१९", "content_sanskrit": "कोऽयं गिरा घोषयति प्राणैः प्रियतरस्य मे।\nजटायुषो वधं भ्रातुः कम्पयन्निव मे मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000328020, "chapter_id": 9328, "verse_number": "४-५६-२०", "content_sanskrit": "कथमासीज्जनस्थाने युद्धं राक्षसगृध्रयोः।\nनामधेयमिदं भ्रातुश्चिरस्याद्य मया श्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000328021, "chapter_id": 9328, "verse_number": "४-५६-२१", "content_sanskrit": "इच्छेयं गिरिदुर्गाच्च भवद्भिरवतारितुम्।\nयवीयसो गुणज्ञस्य श्लाघनीयस्य विक्रमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000328022, "chapter_id": 9328, "verse_number": "४-५६-२२", "content_sanskrit": "अतिदीर्घस्य कालस्य परितुष्टोऽस्मि कीर्तनात्।\nतदिच्छेयमहं श्रोतुं विनाशं वानरर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000328023, "chapter_id": 9328, "verse_number": "४-५६-२३", "content_sanskrit": "भ्रातुर्जटायुषस्तस्य जनस्थाननिवासिनः।\nतस्यैव च मम भ्रातुः सखा दशरथः कथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000328024, "chapter_id": 9328, "verse_number": "४-५६-२४", "content_sanskrit": "यस्य रामः प्रियः पुत्रो ज्येष्ठो गुरुजनप्रियः।\nसूर्यांशुदग्धपक्षत्वान्न शक्नोमि विसर्पितुम्।\nइच्छेयं पर्वतादस्मादवतर्तुमरिंदमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000328025, "chapter_id": 9328, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे षट्पञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]