[{"id": 2087803, "chapter_id": 2867, "verse_number": "१२-३७२-०x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2087804, "chapter_id": 2867, "verse_number": "१२-३७२-१", "content_sanskrit": "विवस्वतो गच्छति पर्ययेण\nवोडुं भवांस्तं यथमेकचक्रम्।\nआश्चर्यभूतं यदि तत्र किंचि\nद्दृष्टं त्वयाशंसितुमर्हसि त्वम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2087805, "chapter_id": 2867, "verse_number": "१२-३७२-२x", "content_sanskrit": "नाग उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2087806, "chapter_id": 2867, "verse_number": "१२-३७२-२", "content_sanskrit": "आश्चर्याणामनेकानां प्रतिष्ठा भगवान्रविः।\nयतो भूताः प्रवर्तन्ते सर्वे त्रैलोक्यसंमताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2087807, "chapter_id": 2867, "verse_number": "१२-३७२-३", "content_sanskrit": "यस्य रश्मिसहस्रेषु शाखास्विव विहंगमाः।\nवसन्त्याश्रित्य मुनयः संसिद्धा दैवतैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2087808, "chapter_id": 2867, "verse_number": "१२-३७२-४", "content_sanskrit": "यतो पायुर्विनिःसृत्य सूर्यरश्म्याश्रितो महान्।\nविजृम्भत्यम्बरे तत्र किमाश्चर्यमतः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2087809, "chapter_id": 2867, "verse_number": "१२-३७२-५", "content_sanskrit": "विभज्यं तं तु विप्रर्षे प्रजानां हितकाम्यया।\nतोयं सृजति वर्षासु किमाश्चर्यमतः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2087810, "chapter_id": 2867, "verse_number": "१२-३७२-६", "content_sanskrit": "यस्य मण्डलमध्यस्थो महात्मा परमत्विषा। १२-३७२-६ दीप्तः समीक्षतेऽलोकान्किमाश्चर्यमतः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2087811, "chapter_id": 2867, "verse_number": "१२-३७२-७", "content_sanskrit": "शुक्रो नामासितः पादो यश्च वारिधरोऽम्बरे।\nतोयं सृजति वर्षासु किमाश्चर्यमतः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2087812, "chapter_id": 2867, "verse_number": "१२-३७२-८", "content_sanskrit": "योऽष्टमासांस्तु शुचिना किरणेनोक्षितं पयः।\nप्रत्यादत्ते पुनः काले किमाश्चर्यमतः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2087813, "chapter_id": 2867, "verse_number": "१२-३७२-९", "content_sanskrit": "यस्य तेजोविशेषेषु स्वयमात्मा प्रतिष्ठितः।\nयतो बीजं मही चेयं धार्यते सचराचरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2087814, "chapter_id": 2867, "verse_number": "१२-३७२-१०", "content_sanskrit": "यत्र देवो महाबाहुः शाश्वतः पुरुषोत्तमः।\nअनादिनिधनो विप्र किमाश्चर्यमतः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2087815, "chapter_id": 2867, "verse_number": "१२-३७२-११", "content_sanskrit": "आश्चर्याणामिवाश्चर्यमिदमेकं तु मे शृणु।\nविमले यन्मया दृष्टमम्बरे सूर्यसंश्रयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2087816, "chapter_id": 2867, "verse_number": "१२-३७२-१२", "content_sanskrit": "पुरा मध्याह्नसमये लोकांस्तपति भास्करे।\nप्रत्यादित्यप्रतीकाशः सर्वतः समदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2087817, "chapter_id": 2867, "verse_number": "१२-३७२-१३", "content_sanskrit": "स लोकांस्तेजसा सर्वान्स्वभासा निर्विभासयन्।\nआदित्याधिमुखोऽभ्येति गगनं पाटयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2087818, "chapter_id": 2867, "verse_number": "१२-३७२-१४", "content_sanskrit": "हुताहुतिरिव ज्योतिर्व्याप्य तेजोमरीचिभिः।\nअनिर्देश्येन रूपेण द्वितीय इव भास्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2087819, "chapter_id": 2867, "verse_number": "१२-३७२-१५", "content_sanskrit": "तस्याभिगमनप्राप्तौ हस्तौ दत्तौ विवस्वता।\nतेनापि दक्षिणो हस्तो दत्तः प्रत्यर्चितार्थिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2087820, "chapter_id": 2867, "verse_number": "१२-३७२-१६", "content_sanskrit": "ततो भित्त्वैव गगन प्रविष्टो रश्मिमण्डलम्।\nएकीभूतं च तत्तेजः क्षणेनादित्यतां गतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2087821, "chapter_id": 2867, "verse_number": "१२-३७२-१७", "content_sanskrit": "तत्र नः संशयो जातस्तयोस्तेजः समागमे।\nअनयोः को भवेत्सूर्यो रथस्थो योऽयमागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2087822, "chapter_id": 2867, "verse_number": "१२-३७२-१८", "content_sanskrit": "ते वयं जातसंदेहाः पर्यपृच्छामहे रविम्।\nक एष दिवमाक्रम्य गतः सूर्य इवापरः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2087823, "chapter_id": 2867, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि द्विसप्तत्यधिकत्रिशततमोऽध्यायः॥ ३७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]