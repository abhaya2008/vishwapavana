[{"id": 7001117000, "chapter_id": 21117, "verse_number": "२-२-८-१", "content_sanskrit": "सूत उवाच ।\nइत्याकर्ण्य वचस्तस्य ब्रह्मणो हि प्रजापतेः ।\nप्रसन्नमानसो भूत्वा तं प्रोवाच स नारदः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001117001, "chapter_id": 21117, "verse_number": "२-२-८-२", "content_sanskrit": "नारद उवाच ।\nब्रह्मन् विधे महाभाग विष्णुशिष्य महामते ।\nधन्यस्त्वं शिवभक्तो हि परतत्त्वप्रदर्शकः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001117002, "chapter_id": 21117, "verse_number": "२-२-८-३", "content_sanskrit": "श्राविता सुकथा दिव्या शिवभक्तिविवर्द्धिनी ।\nअरुंधत्यास्तथा तस्याः स्वरूपायाः परे भवे॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001117003, "chapter_id": 21117, "verse_number": "२-२-८-४", "content_sanskrit": "इदानीं ब्रूहि धर्मज्ञ पवित्रं चरितं परम् ।\nशिवस्य परपापघ्नं मंगलप्रदमुत्तमम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001117004, "chapter_id": 21117, "verse_number": "२-२-८-५", "content_sanskrit": "गृहीतदारे कामे च दृष्टे तेषु गतेषु च ।\nसंध्यायां किं तपस्तप्तुं गतायामभवत्ततः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001117005, "chapter_id": 21117, "verse_number": "२-२-८-६", "content_sanskrit": "सूत उवाच ।\nइति श्रुत्वा वचस्तस्य ऋषेर्वै भावितात्मनः ।\nसुप्रसन्नतरो भूत्वा ब्रह्मा वचनमब्रवीत्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001117006, "chapter_id": 21117, "verse_number": "२-२-८-७", "content_sanskrit": "ब्रह्मोवाच ।\nशृणु नारद विप्रेन्द्र तदैव चरितं शुभम् ।\nशिवलीलान्वितं भक्त्या धन्यस्त्वं शिवसेवकः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001117007, "chapter_id": 21117, "verse_number": "२-२-८-८", "content_sanskrit": "अहं विमोहितस्तात यदैवांतर्हितः पुरा ।\nअचिंतयं सदाहं तच्छंभुवाक्यविषार्दितः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001117008, "chapter_id": 21117, "verse_number": "२-२-८-९", "content_sanskrit": "चिंतयित्वा चिरं चित्ते शिवमायाविमोहितः ।\nशिवे चेर्ष्यामकार्षं हि तच्छ्ृवृणुष्व वदामि ते॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001117009, "chapter_id": 21117, "verse_number": "२-२-८-१०", "content_sanskrit": "अथाहमगमं तत्र यत्र दक्षादयः स्थिताः ।\nसरतिं मदनं दृष्ट्वा समदोह हि किञ्चन॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001117010, "chapter_id": 21117, "verse_number": "२-२-८-११", "content_sanskrit": "दक्षमाभाष्य सुप्रीत्या परान्पुत्रांश्च नारद ।\nअवोचं वचनं सोहं शिवमायाविमोहितः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001117011, "chapter_id": 21117, "verse_number": "२-२-८-१२", "content_sanskrit": "ब्रह्मोवाच ।\nहे दक्ष हे मरीच्याद्यास्सुताः शृणुत मद्वचः ।\nश्रुत्वोपायं विधेयं हि मम कष्टापनुत्तये॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001117012, "chapter_id": 21117, "verse_number": "२-२-८-१३", "content_sanskrit": "कांताभिलाषमात्रं मे दृष्ट्वा शम्भुरगर्हयत् ।\nमां च युष्मान्महायोगी धिक्कारं कृतवान्बहु॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001117013, "chapter_id": 21117, "verse_number": "२-२-८-१४", "content_sanskrit": "तेन दुःखाभितप्तोहं लभेहं शर्म न क्वचित् ।\nयथा गृह्णातु कांतां स स यत्नः कार्य एव हि॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001117014, "chapter_id": 21117, "verse_number": "२-२-८-१५", "content_sanskrit": "यथा गृह्णातु कांतां स सुखी स्यां दुःखवर्जितः ।\nदुर्लभस्य तु कामो मे परं मन्ये विचारतः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001117015, "chapter_id": 21117, "verse_number": "२-२-८-१६", "content_sanskrit": "कांताभिलाषमात्रं मे दृष्ट्वा शंभुरगर्हयत् ।\nमुनीनां पुरतः कस्मात्स कांतां संग्रहीष्यति॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001117016, "chapter_id": 21117, "verse_number": "२-२-८-१७", "content_sanskrit": "का वा नारी त्रिलोकेस्मिन् या भवेत्तन्मनाः स्थिता ।\nयोगमार्गमवज्ञाप्य तस्य मोहं करिष्यति॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001117017, "chapter_id": 21117, "verse_number": "२-२-८-१८", "content_sanskrit": "मन्मथोपि समर्थो नो भविष्यत्यस्य मोहने ।\nनितांतयोगी रामाणां नामापि सहते न सः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001117018, "chapter_id": 21117, "verse_number": "२-२-८-१९", "content_sanskrit": "अगृहीतेषुणा चैव हरेण कथमादिना ।\nमध्यमा च भवेत्सृष्टिस्तद्वाचा नान्यवारिता॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001117019, "chapter_id": 21117, "verse_number": "२-२-८-२०", "content_sanskrit": "भुवि केचिद्भविष्यंति मायाबद्धा महासुराः ।\nबद्धा केचिद्धरेर्नूनं केचिच्छंभोरुपायतः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001117020, "chapter_id": 21117, "verse_number": "२-२-८-२१", "content_sanskrit": "संसारविमुखे शंभौ तथैकांतविरागिणि ।\nअस्मादृते न कर्मान्यत् करिष्यति न संशयः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001117021, "chapter_id": 21117, "verse_number": "२-२-८-२२", "content_sanskrit": "इत्युक्त्वा तनयांश्चाहं दक्षादीन् सुनिरीक्ष्य च ।\nसरतिं मदनं तत्र सानंदमगदं ततः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001117022, "chapter_id": 21117, "verse_number": "२-२-८-२३", "content_sanskrit": "ब्रह्मोवाच ।\nमत्पुत्र वर काम त्वं सर्वथा सुखदायकः ।\nमद्वचश्शृणु सुप्रीत्या स्वपत्न्या पितृवत्सल॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001117023, "chapter_id": 21117, "verse_number": "२-२-८-२४", "content_sanskrit": "अनया सहचारिण्या राजसे त्वं मनोभव ।\nएषा च भवता पत्या युक्ता संशोभते भृशम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001117024, "chapter_id": 21117, "verse_number": "२-२-८-२५", "content_sanskrit": "यथा स्त्रिया हृषीकेशो हरिणा सा यथा रमा ।\nक्षणदा विधुना युक्ता तया युक्तो यथा विधुः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001117025, "chapter_id": 21117, "verse_number": "२-२-८-२६", "content_sanskrit": "तथैव युवयोश्शोभा दांपत्यं च पुरस्कृतम् ।\nअतस्त्वं जगतः केतुर्विश्वकेतुर्भविष्यसि॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001117026, "chapter_id": 21117, "verse_number": "२-२-८-२७", "content_sanskrit": "जगद्धिताय वत्स त्वं मोहयस्व पिनाकिनम् ।\nयथाशु सुमनश्शंभुः कुर्य्याद्दारप्रतिग्रहम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001117027, "chapter_id": 21117, "verse_number": "२-२-८-२८", "content_sanskrit": "विजने स्निग्धदेशे तु पर्वतेषु सरस्सु च ।\nयत्रयत्र प्रयातीशस्तत्र तत्रानया सह॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001117028, "chapter_id": 21117, "verse_number": "२-२-८-२९", "content_sanskrit": "मोहय त्वं यतात्मानं वनिताविमुखं हरम् ।\nत्वदृते विद्यते नान्यः कश्चिदस्य विमोहकः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001117029, "chapter_id": 21117, "verse_number": "२-२-८-३०", "content_sanskrit": "भूते हरे सानुरागे भवतोपि मनोभव ।\nशापोपशांतिर्भविता तस्मादात्महितं कुरु॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001117030, "chapter_id": 21117, "verse_number": "२-२-८-३१", "content_sanskrit": "सानुरागो वरारोहां यदीच्छति महेश्वरः ।\nतदा भवोपि योग्यार्यस्त्वां च संतारयिष्यति॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001117031, "chapter_id": 21117, "verse_number": "२-२-८-३२", "content_sanskrit": "तस्माज्जायाद्वितीयस्त्वं यतस्व हरमोहने ।\nविश्वस्य भव केतुस्त्वं मोहयित्वा महेश्वरम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001117032, "chapter_id": 21117, "verse_number": "२-२-८-३३", "content_sanskrit": "ब्रह्मोवाच ।\nइति श्रुत्वा वचो मे हि जनकस्य जगत्प्रभोः ।\nउवाच मन्मथस्तथ्यं तदा मां जगतां पतिम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001117033, "chapter_id": 21117, "verse_number": "२-२-८-३४", "content_sanskrit": "मन्मथ उवाच ।\nकरिष्येहं तव विभो वचनाच्छंभुमोहनम् ।\nकिं तु योषिन्महास्त्रं मे तत्कांतां भगवन् सृज॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001117034, "chapter_id": 21117, "verse_number": "२-२-८-३५", "content_sanskrit": "मया संमोहिते शंभो यया तस्यानुमोहनम् ।\nकर्तव्यमधुना धातस्तत्रोपायं परं कुरु॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001117035, "chapter_id": 21117, "verse_number": "२-२-८-३६", "content_sanskrit": "ब्रह्मोवाच ।\nएवंवादिनि कंदर्पे धाताहं स प्रजापतिः ।\nकया संमोहनीयोसाविति चिंतामयामहम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001117036, "chapter_id": 21117, "verse_number": "२-२-८-३७", "content_sanskrit": "चिंताविष्टस्य मे तस्य निःश्वासो यो विनिस्सृतः ।\nतस्माद्वसंतस्संजातः पुष्पव्रातविभूषितः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001117037, "chapter_id": 21117, "verse_number": "२-२-८-३८", "content_sanskrit": "शोणराजीवसंकाशः फुल्लतामरसेक्षणः ।\nसंध्योदिताखंडशशिप्रतिमास्यस्सुनासिकः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001117038, "chapter_id": 21117, "verse_number": "२-२-८-३९", "content_sanskrit": "शार्ङ्गवच्चरणावर्त्तश्श्यामकुंचितमूर्द्धजः ।\nसंध्यांशुमालिसदृशः कुडलद्वयमंडितः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001117039, "chapter_id": 21117, "verse_number": "२-२-८-४०", "content_sanskrit": "प्रमत्तेभगतिः पीनायतदोरुन्नतांसकः ।\nकंबुग्रीवस्सुविस्तीर्णहृदयः पीनसन्मुखः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001117040, "chapter_id": 21117, "verse_number": "२-२-८-४१", "content_sanskrit": "सर्वांगसुन्दरः श्यामस्सम्पूर्णस्सर्वलक्षणैः ।\nदर्शनीयतमस्सर्वमोहनः कामवर्द्धनः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001117041, "chapter_id": 21117, "verse_number": "२-२-८-४२", "content_sanskrit": "एतादृशे समुत्पन्ने वसंते कुसुमाकरे ।\nववौ वायुस्सुसुरभिः पादपा अपि पुष्पिताः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001117042, "chapter_id": 21117, "verse_number": "२-२-८-४३", "content_sanskrit": "पिका विनेदुश्शतशः पंचमं मधुरस्वनाः ।\nप्रफुल्लपद्मा अभवन्सरस्यः स्वच्छपुष्कराः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001117043, "chapter_id": 21117, "verse_number": "२-२-८-४४", "content_sanskrit": "तमुत्पन्नमहं वीक्ष्य तदा तादृशमुत्तमम् ।\nहिरण्यगर्भो मदनमगदं मधुरं वचः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001117044, "chapter_id": 21117, "verse_number": "२-२-८-४५", "content_sanskrit": "ब्रह्मोवाच॥ एवं स मन्मथनिभस्सदा सहचरोभवत्  ।\nआनुकूल्यं तव कृतः सर्वं देव करिष्यति॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001117045, "chapter_id": 21117, "verse_number": "२-२-८-४६", "content_sanskrit": "यथाग्नेः पवनो मित्रं सर्वत्रोपकरिष्यति ।\nतथायं भवतो मित्रं सदा त्वामनुयास्यति॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001117046, "chapter_id": 21117, "verse_number": "२-२-८-४७", "content_sanskrit": "वसंतेरंतहेतुत्वाद्वसंताख्यो भवत्वयम् ।\nतवानुगमनं कर्म तथा लोकानुरञ्जनम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001117047, "chapter_id": 21117, "verse_number": "२-२-८-४८", "content_sanskrit": "असौ वसंतशृंगारो वासंतो मलयानिलः ।\nभवेत्तु सुहृदो भावस्सदा त्वद्वशवर्त्तिनः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001117048, "chapter_id": 21117, "verse_number": "२-२-८-४९", "content_sanskrit": "विष्वोकाद्यास्तथा हावाश्चतुष्षष्टिकलास्तथा ।\nरत्याः कुर्वंतु सौहृद्यं सुहृदस्ते यथा तव॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001117049, "chapter_id": 21117, "verse_number": "२-२-८-५०", "content_sanskrit": "एभिस्सहचरैः काम वसंत प्रमुखैर्भवान् ।\nमोहयस्व महादेवं रत्या सह महोद्यतः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001117050, "chapter_id": 21117, "verse_number": "२-२-८-५१", "content_sanskrit": "अहं तां कामिनीं तात भावयिष्यामि यत्नतः ।\nमनसा सुविचार्यैव या हरं मोहयिष्यति॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001117051, "chapter_id": 21117, "verse_number": "२-२-८-५२", "content_sanskrit": "ब्रह्मोवाच ।\nएवमुक्तो मया कामः सुरज्येष्ठेन हर्षितः ।\nननाम चरणौ मेऽपि स पत्नी सहितस्तदा॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001117052, "chapter_id": 21117, "verse_number": "२-२-८-५३", "content_sanskrit": "दक्षं प्रणम्य तान् सर्वान्मानसानभिवाद्य च ।\nयत्रात्मा गतवाञ्शंभुस्तत्स्थानं मन्मथो ययौ॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]