[{"id": 7001000000, "chapter_id": 21000, "verse_number": "४-६-१", "content_sanskrit": "मैत्रेय उवाच ।\nसूर्यस्य वंश्या भगवन्कथिता भवता मम ।\nसोमस्याप्यखिलान्वश्याञ्छ्रोतुमिच्छामि पार्थिवान् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001000001, "chapter_id": 21000, "verse_number": "४-६-२", "content_sanskrit": "कीर्त्त्यते स्थिरकीर्त्तीनां येषामद्यापि संततिः ।\nप्रसादसुमुखस्तान्मे ब्रह्मन्नाख्यातुमर्हसि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001000002, "chapter_id": 21000, "verse_number": "४-६-३", "content_sanskrit": "श्रीपराशर उवाच ।\nश्रूयतां मुनिशार्दूल वंशः प्रतिथतेजसः ।\nसोमस्यानुक्रमात्ख्याता यत्रोर्वीपतयोऽभवन् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001000003, "chapter_id": 21000, "verse_number": "४-६-४", "content_sanskrit": "अयं हि वंशोतिबलपराक्रमद्युतिशीलचेष्टवद्भिरतिगुणान्वितैर्नहुषययाति-कार्तवीर्यार्जुनादिभिर्भूपालैरलंकृतः तमहं कथयामि श्रूयताम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001000004, "chapter_id": 21000, "verse_number": "४-६-५", "content_sanskrit": "अखिलजगत्स्रष्टुर्भगवतो नारायणस्य नाभिसरोजसमुद्भवाब्जयोनेर्ब्रह्मणः पुत्रोऽत्रिः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001000005, "chapter_id": 21000, "verse_number": "४-६-६", "content_sanskrit": "अत्रेस्सोमः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001000006, "chapter_id": 21000, "verse_number": "४-६-७", "content_sanskrit": "तं च भगवानब्जयोनिः अश्षोऔ!षधीद्विजनक्षत्राणामाधिपत्येऽभ्यषेचयत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001000007, "chapter_id": 21000, "verse_number": "४-६-८", "content_sanskrit": "स च राजसूयमकरोत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001000008, "chapter_id": 21000, "verse_number": "४-६-९", "content_sanskrit": "तत्प्रभावादत्युत्कृष्टाधिपत्याधिष्ठातृत्वाच्चैनं मद आविवेश ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001000009, "chapter_id": 21000, "verse_number": "४-६-१०", "content_sanskrit": "मदावलेपाच्च सकलदेवगुरोर्बृस्पतेस्तारां नाम पत्नीं जहार ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001000010, "chapter_id": 21000, "verse_number": "४-६-११", "content_sanskrit": "बहुशश्च बृहस्पतिचोदितेन भगवता ब्रह्मणा चोद्यमानसकलैश्च देवर्षिभिर्याचमानोपि न मुमोच ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001000011, "chapter_id": 21000, "verse_number": "४-६-१२", "content_sanskrit": "तस्य चंद्र स्य च बृहस्पतेर्द्वेषादुशना पार्ष्णिग्राहोभूत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001000012, "chapter_id": 21000, "verse_number": "४-६-१३", "content_sanskrit": "अंगिरसश्च सकाशादुपलब्धविद्यो भगवान्रुद्रो बृहस्पतेः सहाय्यमकरोत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001000013, "chapter_id": 21000, "verse_number": "४-६-१४", "content_sanskrit": "यतश्चोशना ततो जंभकुंभाद्याः समस्ता एव दैत्यदानवनिकाया महान्तमुद्यमं चक्रुः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001000014, "chapter_id": 21000, "verse_number": "४-६-१५", "content_sanskrit": "बृहस्पतेरपि सकलदेवसैन्ययुतः सहायः शक्रोऽऽभवत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001000015, "chapter_id": 21000, "verse_number": "४-६-१६", "content_sanskrit": "एवं च तयोरतीवोग्रसंग्रामस्तारानिमित्तस्तारकामयो नामाभूत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001000016, "chapter_id": 21000, "verse_number": "४-६-१७", "content_sanskrit": "ततश्च समस्तशस्त्राण्यसुरेषु रुद्र पुरोगमा देवा देवेषु चाश्षोदानवा मुमुचुः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001000017, "chapter_id": 21000, "verse_number": "४-६-१८", "content_sanskrit": "एवं देवासुराहवसंक्षोभक्षुब्धहृदयमश्षोमेव जगद्ब्रह्माणं शरणं जगाम ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001000018, "chapter_id": 21000, "verse_number": "४-६-१९", "content_sanskrit": "ततश्च भगवानब्जयोनिरप्युशनसं शंकरमसुरान्देवांश्च निवार्य बृहस्पतये तारामदापयत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001000019, "chapter_id": 21000, "verse_number": "४-६-२०", "content_sanskrit": "तां चांतःप्रसवामवलोक्य बृहस्पतिरप्याह ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001000020, "chapter_id": 21000, "verse_number": "४-६-२१", "content_sanskrit": "नैष मम क्षेत्रे भवत्याऽन्यस्य सुतो धार्यस्समुत्सृजैनमलमलमतिधार्ष्ट्येनेति ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001000021, "chapter_id": 21000, "verse_number": "४-६-२२", "content_sanskrit": "सा च तेनैवमुक्तातिपतिव्रता भर्तृवचनानंतरं तमिषीकास्तंबे गर्भमुत्ससर्ज ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001000022, "chapter_id": 21000, "verse_number": "४-६-२३", "content_sanskrit": "स चोत्सृष्टमात्र एवातितेजसा देवानां तेजांस्याचिक्षेप ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001000023, "chapter_id": 21000, "verse_number": "४-६-२४", "content_sanskrit": "बृहस्पतिमिंदुं च तस्य कुमारस्यातिचारुतया साभिलाषौ दृष्ट्वा देवस्समुत्पन्नसंदेहास्तारां पप्रच्छुः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001000024, "chapter_id": 21000, "verse_number": "४-६-२५", "content_sanskrit": "सत्यं कथयास्माकमिति सुभगे सोमस्याथ वा बृहस्पतेरयं पुत्र इति ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001000025, "chapter_id": 21000, "verse_number": "४-६-२६", "content_sanskrit": "एवं तैरुक्ता सा तारा ह्रिया किंचिन्नोवाच ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001000026, "chapter_id": 21000, "verse_number": "४-६-२७", "content_sanskrit": "बहुशोप्यभिहिता यदाऽसौ देवेभ्यो नाचचक्षे ततस्स कुमारस्तां शप्तुमुद्यतः प्राह ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001000027, "chapter_id": 21000, "verse_number": "४-६-२८", "content_sanskrit": "दुष्टेंव कस्मान्मम तातं नाख्यासि ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001000028, "chapter_id": 21000, "verse_number": "४-६-२९", "content_sanskrit": "अद्यैव ते व्यलीकलज्जावत्यास्तथा शास्तिमहं करोमि ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001000029, "chapter_id": 21000, "verse_number": "४-६-३०", "content_sanskrit": "यथा च नैवमद्याप्यतिमंथरवचनाभविष्यसीति ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001000030, "chapter_id": 21000, "verse_number": "४-६-३१", "content_sanskrit": "अथाह भगवान् पितामहः तं कुमारं सन्निवार्य स्वयमपृच्छत्तां ताराम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001000031, "chapter_id": 21000, "verse_number": "४-६-३२", "content_sanskrit": "कथय वत्से कस्यायमात्मजः सोमस्य वा बृहस्पतेर्वा इत्युक्ता लज्जमानाह सोमस्येति ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001000032, "chapter_id": 21000, "verse_number": "४-६-३३", "content_sanskrit": "ततः प्रस्फुरदुच्छ्वासितामलकपोलकांतिर्भगवानुडुपतिः कुमारमालिंग्य साधु साधु वत्स प्राज्ञोसीतिबुध इति तस्य च नाम चक्रे ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001000033, "chapter_id": 21000, "verse_number": "४-६-३४", "content_sanskrit": "तदाख्यातमेवैतत् स च यथेलायामात्मजं पुरूरवसमुत्पादयामास ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001000034, "chapter_id": 21000, "verse_number": "४-६-३५", "content_sanskrit": "पुरूरवास्त्वतिदानशीलोऽतियज्वातितेजस्वी यं सत्यवादिनमतिरूपस्विनं मनस्विनं मित्रावरुणशापान्मानुषे लोके मया वस्तव्यमिति कृतमतिरुर्वशी ददर्श ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001000035, "chapter_id": 21000, "verse_number": "४-६-३६", "content_sanskrit": "दृष्टमात्रे च तस्मिन्नपहाय मानमश्षोमपास्य स्वर्गसुखाभिलाषं तन्मनस्का भूत्वा तमेवोपतस्थे ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001000036, "chapter_id": 21000, "verse_number": "४-६-३७", "content_sanskrit": "सोऽपि च तामतिशयितसकललोकस्त्रीकांतिसौकुमार्यलावण्यग-तिविलासहासादिगुणामवलोक्य तदायत्तचित्तवृत्तिर्बभूव ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001000037, "chapter_id": 21000, "verse_number": "४-६-३८", "content_sanskrit": "उभयमपि तन्मनस्कमनन्यदृष्टि परित्यक्तसमस्तान्यप्रयोजनमभूत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001000038, "chapter_id": 21000, "verse_number": "४-६-३९", "content_sanskrit": "राजा तु प्रागल्भ्यात्तामाह ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001000039, "chapter_id": 21000, "verse_number": "४-६-४०", "content_sanskrit": "सुभ्रु त्वामहमभिकामोऽस्मि प्रसीदाऽनुरागमुद्वहेत्युक्ता लज्जावखंडितमुर्वशी तं प्राह ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001000040, "chapter_id": 21000, "verse_number": "४-६-४१", "content_sanskrit": "भवत्वेवं यदि मे समयपरिपालनं भवान् करोतीत्याख्याते पुनरपि तामाह ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001000041, "chapter_id": 21000, "verse_number": "४-६-४२", "content_sanskrit": "आख्याहि मे समयमिति ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001000042, "chapter_id": 21000, "verse_number": "४-६-४३", "content_sanskrit": "अथ पृष्टा पुनरप्यब्रवीत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001000043, "chapter_id": 21000, "verse_number": "४-६-४४", "content_sanskrit": "शयनसमीपे ममोरणकद्वयं पुत्रभूतं नापनेयम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001000044, "chapter_id": 21000, "verse_number": "४-६-४५", "content_sanskrit": "भवांश्च मया न नग्नो द्र ष्टव्यः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001000045, "chapter_id": 21000, "verse_number": "४-६-४६", "content_sanskrit": "घृतमात्रं च ममाहार इति ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001000046, "chapter_id": 21000, "verse_number": "४-६-४७", "content_sanskrit": "एवमेवेति भूपतिरप्याह ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001000047, "chapter_id": 21000, "verse_number": "४-६-४८", "content_sanskrit": "तया सह स चावनिपतिरलकयां चैत्ररथादिवनेष्वमलपद्मखंडेषु मानसादिसरस्स्वतिरमणीयेषु रममाण एकषष्टिवर्षाण्यनुदिनप्रवर्द्धमानप्रमोदोऽनयत् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001000048, "chapter_id": 21000, "verse_number": "४-६-४९", "content_sanskrit": "उर्वशी च तदुपभोगात्प्रतिदिनप्रवर्द्धमानानुरागा अमरलोकवासेऽपि न स्पृहां चकार ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001000049, "chapter_id": 21000, "verse_number": "४-६-५०", "content_sanskrit": "विना चोर्वश्या सुरलोकोऽप्सरसां सिद्धगंधर्वाणां च नातिरमणीयोऽभवत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001000050, "chapter_id": 21000, "verse_number": "४-६-५१", "content_sanskrit": "ततश्चोर्वशी पुरूरवसोस्समयविद्विश्वावसुर्गंधर्वसमवेतो निशि शयनाभ्याशादेकमुरणकं जहार ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001000051, "chapter_id": 21000, "verse_number": "४-६-५२", "content_sanskrit": "तस्याकाशो! नीयमानस्योर्वशी शब्दमशृणोत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001000052, "chapter_id": 21000, "verse_number": "४-६-५३", "content_sanskrit": "एवमुवाच च ममानाथायाः पुत्रः केनापह्रियते कं शरणमुपयामीति ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001000053, "chapter_id": 21000, "verse_number": "४-६-५४", "content_sanskrit": "तदाकर्ण्य राजा मां नग्नं देवी वीक्ष्यतीति न ययौ ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001000054, "chapter_id": 21000, "verse_number": "४-६-५५", "content_sanskrit": "अथान्यमप्युरणकमादाय गंधर्वा ययुः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001000055, "chapter_id": 21000, "verse_number": "४-६-५६", "content_sanskrit": "तस्याप्यपह्रियमाणस्याकर्ण्य शब्दमाकाशो! पुनरप्यनाथास्म्यहमभर्तृका कापुरुषा श्रयेत्यार्त्तराविणी बभूव ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001000056, "chapter_id": 21000, "verse_number": "४-६-५७", "content_sanskrit": "राजाप्यमर्षवशादंधकारमेतदिति खड्गमादाय दुष्टदुष्ट हतोसीति व्याहरन्नभ्यधावत् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001000057, "chapter_id": 21000, "verse_number": "४-६-५८", "content_sanskrit": "तावच्च गंधर्वैरप्यतीवोज्ज्वला विद्युज्जनिता ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001000058, "chapter_id": 21000, "verse_number": "४-६-५९", "content_sanskrit": "तत्प्रभया चोर्वशी राजानमपगतांबरं दृष्ट्वापवृत्तसमया तत्क्षणादेवापक्रान्ता ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001000059, "chapter_id": 21000, "verse_number": "४-६-६०", "content_sanskrit": "परित्यज्य तावप्युरणकौ गंधर्वास्सुरलोकमुपगताः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001000060, "chapter_id": 21000, "verse_number": "४-६-६१", "content_sanskrit": "राजापि च तौ मेषावादायातिहृष्टमनाः स्वशयनमायातो नोर्वशीं ददर्श ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001000061, "chapter_id": 21000, "verse_number": "४-६-६२", "content_sanskrit": "तां चापश्यन् व्यपगतांबर एवोन्मत्तरूपो बभ्राम ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001000062, "chapter_id": 21000, "verse_number": "४-६-६३", "content_sanskrit": "कुरुक्षेत्रे चांभोजसरस्यन्याभिश्चतसृभिरप्सरोभिस्समवेतामुर्वशीं ददर्श ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001000063, "chapter_id": 21000, "verse_number": "४-६-६४", "content_sanskrit": "ततश्चोन्मत्तरूपो जाये हे तिष्ठ मनसि घोरे तिष्ठ वचसि कपटिके तिष्ठेत्येवमनेकप्रकारं सूक्तमवोचत् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001000064, "chapter_id": 21000, "verse_number": "४-६-६५", "content_sanskrit": "आह चोर्वशी ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001000065, "chapter_id": 21000, "verse_number": "४-६-६६", "content_sanskrit": "महाराजालमनेनाविवेकचेष्टितेन ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001000066, "chapter_id": 21000, "verse_number": "४-६-६७", "content_sanskrit": "अंतर्वत्न्यहमब्दांते भवताऽत्रागंतव्यं कुमारस्ते भबिष्यति एकां च निशामहं त्वया सह वत्स्यामीत्युक्तः प्रहृष्टस्स्वपुरं जगाम ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001000067, "chapter_id": 21000, "verse_number": "४-६-६८", "content_sanskrit": "तासां चाप्सरसामूर्वशी कथयामास ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001000068, "chapter_id": 21000, "verse_number": "४-६-६९", "content_sanskrit": "अयं स पुरुषोत्कृष्टो येनाहमेतावंतं कालमनुरागाकृष्टमानसा सहोषितेति ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001000069, "chapter_id": 21000, "verse_number": "४-६-७०", "content_sanskrit": "एवमुक्तास्ताश्चाप्सरस ऊचुः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001000070, "chapter_id": 21000, "verse_number": "४-६-७१", "content_sanskrit": "साधुसाध्वस्य रूपमप्यनेन सहास्माकमपि सर्वकालमास्या भवेदिति ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001000071, "chapter_id": 21000, "verse_number": "४-६-७२", "content_sanskrit": "अब्दे च पूर्णे स राजा तत्राजगाम ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001000072, "chapter_id": 21000, "verse_number": "४-६-७३", "content_sanskrit": "कुमारं चायुषमस्मै चोर्वशी ददौ ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001000073, "chapter_id": 21000, "verse_number": "४-६-७४", "content_sanskrit": "दत्त्वा चैकां निशां तेन राज्ञा सहोषित्वा पंच पुत्रोत्पत्तये गर्भमवाप ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001000074, "chapter_id": 21000, "verse_number": "४-६-७५", "content_sanskrit": "उवाच चैनं राजानमस्मत्प्रीत्या महाराजाय सर्व एव गंधर्वा वरदास्संवृत्ताः व्रियतां च वर इति ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001000075, "chapter_id": 21000, "verse_number": "४-६-७६", "content_sanskrit": "आह च राजा ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001000076, "chapter_id": 21000, "verse_number": "४-६-७७", "content_sanskrit": "विजितसकलारातिरविहतेंद्रि यसामर्थ्यो बंधुमानमितबलकोशोऽस्मि नान्यदस्माकमुर्वशीसालोक्यात्प्राप्तव्यमस्तितदहमनया सहोर्वश्या कालं नेतुमभिलषामीत्युक्ते गंधर्वा राज्ञेऽग्निस्थालीं ददुः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001000077, "chapter_id": 21000, "verse_number": "४-६-७८", "content_sanskrit": "ऊचुश्चैनमग्निमाम्नायानुसारी भूत्वा त्रिधा कृत्वोर्वशी सलोकतामनोरथमुद्दिश्य सम्यग्यजेथाः ततोऽवश्यमभिलषितमवाप्स्यतीत्युक्तस्तामग्निस्थालीमादाय जगाम ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001000078, "chapter_id": 21000, "verse_number": "४-६-७९", "content_sanskrit": "अंतरटव्यामचिंतयत् अहो मेऽतीव मूढता किमहमकरवम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001000079, "chapter_id": 21000, "verse_number": "४-६-८०", "content_sanskrit": "वह्निस्थाली मयैषानीता नोर्वशीति ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001000080, "chapter_id": 21000, "verse_number": "४-६-८१", "content_sanskrit": "अथैनामटव्यामेवाग्निस्थालीं तत्याज स्वपुरं च जगाम ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001000081, "chapter_id": 21000, "verse_number": "४-६-८२", "content_sanskrit": "व्यतीतेऽर्द्धरात्रे विनिद्रश्चाचिंतयत् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001000082, "chapter_id": 21000, "verse_number": "४-६-८३", "content_sanskrit": "ममोर्वशीसालोक्यप्राप्त्यर्थमग्निस्थाली गंधर्वैर्दत्ता सा च मयाटव्यां परित्यक्ता ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001000083, "chapter_id": 21000, "verse_number": "४-६-८४", "content_sanskrit": "तदहं तत्र तदाहरणाय यास्यामीत्युत्थाय तत्राप्युपगतो नाग्निस्थालीमपश्यत् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001000084, "chapter_id": 21000, "verse_number": "४-६-८५", "content_sanskrit": "शमीगर्भं चाश्वत्थमग्निस्थालीस्थाने दृष्ट्वाऽचिंतयत् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001000085, "chapter_id": 21000, "verse_number": "४-६-८६", "content_sanskrit": "मयात्राग्निस्थाली निक्षिप्ता सा चाश्वत्थश्शमीगर्भोऽभूत् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001000086, "chapter_id": 21000, "verse_number": "४-६-८७", "content_sanskrit": "तदेनमेवाहमग्निरूपमादाय स्वपुरमभिगम्यारणीं कृत्वा तदुत्पन्नाग्नेरुपास्तिं करिष्यामीति ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001000087, "chapter_id": 21000, "verse_number": "४-६-८८", "content_sanskrit": "एवमेव स्वपुरमभिगम्यारणिं चकार ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001000088, "chapter_id": 21000, "verse_number": "४-६-८९", "content_sanskrit": "तत्प्रमाणं चांगुलैः कुर्वन् गायत्रीमपठत् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7001000089, "chapter_id": 21000, "verse_number": "४-६-९०", "content_sanskrit": "पठतश्चाक्षरसंख्यान्येवांगुलान्यरण्यभवत् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7001000090, "chapter_id": 21000, "verse_number": "४-६-९१", "content_sanskrit": "तत्राग्निं निर्मथ्याग्नित्रयमाम्नायानुसारी भूत्वा जुहाव ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7001000091, "chapter_id": 21000, "verse_number": "४-६-९२", "content_sanskrit": "उर्वशीसालोक्यं फलमभिसंधितवान् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7001000092, "chapter_id": 21000, "verse_number": "४-६-९३", "content_sanskrit": "तेनैव चाग्निविधिना बहुविधान् यज्ञानिष्ट्वा गांधर्वलोकानवाप्योर्वश्या सहावियोगमवाप ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7001000093, "chapter_id": 21000, "verse_number": "४-६-९४", "content_sanskrit": "एकोऽग्निरादावभवदेकेन त्वत्र मन्वंतरे त्रेधा प्रवर्तिताः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}]