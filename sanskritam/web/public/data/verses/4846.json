[{"id": 2181531, "chapter_id": 4846, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2181532, "chapter_id": 4846, "verse_number": "१", "content_sanskrit": "वसन्नेको जपन्नेकः सर्पन्नेको युधिष्ठिर ।\nएकस्मिन्नेव आचार्ये शुश्रूषुर्मलपङ्कवान्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2181533, "chapter_id": 4846, "verse_number": "२", "content_sanskrit": "ब्रह्मचारी व्रती नित्यं नित्यं दीक्षापरो वशी ।\nअवधार्य तथा वेदं कृत्यं कुर्वन् वसेत् सदा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2181534, "chapter_id": 4846, "verse_number": "३", "content_sanskrit": "शुश्रूषां सततं कुर्वन् गुरोः सम्प्रणमेत च ।\nषट् कर्मस्वनिवृत्तश्च नप्रवृत्तश्च सर्वशः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2181535, "chapter_id": 4846, "verse_number": "४", "content_sanskrit": "न चरत्यधिकारेण सेवते द्विषतो नच ।\nएषोऽऽश्रमपदस्तात ब्रह्मचारिण इष्यते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2181536, "chapter_id": 4846, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2181537, "chapter_id": 4846, "verse_number": "५", "content_sanskrit": "शिवान् सर्वान् महोदर्कानहिंस्राँल्लोकसम्मतान् ।\nब्रूहि धर्मान् सुखोपायान् मद्विधानां सुखावहान्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2181538, "chapter_id": 4846, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2181539, "chapter_id": 4846, "verse_number": "६", "content_sanskrit": "ब्राह्मणस्येह चत्वार आश्रमा विहिताः प्रभो ।\nवर्णास्ताननुवर्तन्ते त्रयो भरतसत्तम\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2181540, "chapter_id": 4846, "verse_number": "७", "content_sanskrit": "उक्तानि कर्माणि बहूनि राजन्\nस्वर्ग्याणि राजन्यपरायणानि ।\nनेमानि दृष्टान्तविधौ स्मृतानि\nक्षात्रे हि सर्वं विहितं यथावत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2181541, "chapter_id": 4846, "verse_number": "८", "content_sanskrit": "क्षात्राणि वैश्यानि च सेवमानः\nशौद्राणि कर्माणि च ब्राह्मणः सन् ।\nअस्मिँल्लोके निन्दितो मन्दचेताः\nपरे च लोके निरयं प्रयाति\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2181542, "chapter_id": 4846, "verse_number": "९", "content_sanskrit": "या सञ्ज्ञा विहिता लोके दासे शुनि वृके पशौ ।\nविकर्मणि स्थिते विप्रे तां सञ्ज्ञां कुरु पाण्डव\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2181543, "chapter_id": 4846, "verse_number": "१०", "content_sanskrit": "षट्कर्मसम्प्रवृत्तस्य आश्रमेषु चतुर्ष्वपि ।\nसर्वधर्मोपपन्नस्य सम्भूतस्य कृतात्मनः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2181544, "chapter_id": 4846, "verse_number": "११", "content_sanskrit": "ब्राह्मणस्य विशुद्धस्य तपस्यभिरतस्य च ।\nनिराशिषो वदान्यस्य लोका ह्यक्षरसञ्ज्ञिताः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2181545, "chapter_id": 4846, "verse_number": "१२", "content_sanskrit": "यो यस्मिन् कुरुते कर्म यादृशं येन यत्र च ।\nतादृशं तादृशेनैव सगुणं प्रतिपद्यते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2181546, "chapter_id": 4846, "verse_number": "१३", "content_sanskrit": "वृद्ध्या कृषिवणिक्त्वेन जीवसञ्जीवनेन च ।\nवेत्तुमर्हसि राजेन्द्र स्वाध्यायगणितं महत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2181547, "chapter_id": 4846, "verse_number": "१४", "content_sanskrit": "कालसञ्चोदितः काले कालपर्यायनिश्चितः ।\nउत्तमाधममध्यानि कर्माणि कुरुतेऽवशः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2181548, "chapter_id": 4846, "verse_number": "१५", "content_sanskrit": "अन्तवन्ति प्रदानानि पुरा श्रेयस्कराणि च ।\nस्वकर्मनिरतो लोको ह्यक्षरः सर्वतोमुखः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2181549, "chapter_id": 4846, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे त्रिषष्टितमोऽध्यायः ॥ ६३ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]