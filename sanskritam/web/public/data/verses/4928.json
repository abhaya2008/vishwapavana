[{"id": 2185170, "chapter_id": 4928, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2185171, "chapter_id": 4928, "verse_number": "१", "content_sanskrit": "ततो गते शाकुनिके कपोती प्राह दुःखिता ।\nसंस्मृत्य भर्तारमथो रुदती शोकमूर्छिता\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2185172, "chapter_id": 4928, "verse_number": "२", "content_sanskrit": "नाहं ते विप्रियं कान्त कदाचिदपि संस्मरे ।\nसर्वा वै विधवा नारी बहुपुत्रापि खेचर॥\nशोच्या भवति बन्धूनां पतिहीना मनस्विनी\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2185173, "chapter_id": 4928, "verse_number": "३", "content_sanskrit": "लालिताहं त्वया नित्यं बहुमानाच्च सान्त्विता ।\nवचनैर्मधुरैः स्निग्धैरसकृत् सुमनोहरैः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2185174, "chapter_id": 4928, "verse_number": "४", "content_sanskrit": "कन्दरेषु च शैलानां नदीनां निर्झरेषु च ।\nद्रुमाग्रेषु च रम्येषु रमिताहं त्वया प्रिय\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2185175, "chapter_id": 4928, "verse_number": "५", "content_sanskrit": "आकाशगमने चैव सुखिताहं त्वया सुखम् ।\nविहृतास्मि त्वया कान्त तन्मे नाद्यास्ति किञ्चन\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2185176, "chapter_id": 4928, "verse_number": "६", "content_sanskrit": "मितं ददाति हि पिता मितं माता मितं सुतः ।\nअमितस्य तु दातारं भर्तारं का न पूजयेत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2185177, "chapter_id": 4928, "verse_number": "७", "content_sanskrit": "नास्ति भर्तृसमो नाथो न च भर्तृसमं सुखम् ।\nविसृज्य धनसर्वस्वं भर्ता वै शरणं स्त्रियाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2185178, "chapter_id": 4928, "verse_number": "८", "content_sanskrit": "न कार्यमिह मे नाथ जीवितेन त्वया विना ।\nपतिहीनापि का नारी सती जीवितुमुत्सहेत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2185179, "chapter_id": 4928, "verse_number": "९", "content_sanskrit": "एवं विलप्य बहुधा करुणं सा सुदुःखिता ।\nपतिव्रता सम्प्रदीप्तं प्रविवेश हुताशनम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2185180, "chapter_id": 4928, "verse_number": "१०", "content_sanskrit": "ततश्चित्राम्बरधरं भर्तारं सान्वपश्यत ।\nविमानस्थं सुकृतिभिः पूज्यमानं महात्मभिः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2185181, "chapter_id": 4928, "verse_number": "११", "content_sanskrit": "चित्रमाल्याम्बरधरं सर्वाभरणभूषितम् ।\nविमानशतकोटीभिरावृतं पुण्यकीर्तिभिः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2185182, "chapter_id": 4928, "verse_number": "१२", "content_sanskrit": "ततः स्वर्गगतः पक्षी भार्यया सह सङ्गतः ।\nकर्मणा पूजितस्तेन रेमे तत्र स भार्यया\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2185183, "chapter_id": 4928, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि आपद्धर्मे षोडशोऽध्यायः ॥ १६ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]