[{"id": 6000024000, "chapter_id": 10024, "verse_number": null, "content_sanskrit": "अथ चतुर्थाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000024001, "chapter_id": 10024, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_004/BhP_02.004.001.m4a", "display_order": 2}, {"id": 6000024002, "chapter_id": 10024, "verse_number": "२-४-१", "content_sanskrit": "वैयासकेरिति वचस्तत्त्वनिश्चयमात्मनः।\nउपधार्य मतिं कृष्णे औत्तरेयः सतीं व्यधात्॥ २/४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_004/BhP_02.004.002.m4a", "display_order": 3, "topics": [{"text": "शुकोपदेशेन दृढतरं वैराग्यं प्राप्तवता परीक्षिता शुकं प्रति भगवतो जगत्सृष्ट्यादिप्रकारनिरूपणप्रार्थना", "range": "१–१०"}]}, {"id": 6000024003, "chapter_id": 10024, "verse_number": "२-४-२", "content_sanskrit": "आत्मजायासुतागारपशुद्रविणबन्धुषु।\nराज्ये चाविकले नित्यनिरूढां ममतां जहौ॥ २/४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_004/BhP_02.004.003.m4a", "display_order": 4}, {"id": 6000024004, "chapter_id": 10024, "verse_number": "२-४-३", "content_sanskrit": "पप्रच्छ चेममेवार्थं यन्मां पृच्छथ सत्तमाः।\nकृष्णानुभावश्रवणे श्रद्दधानो महायशाः॥ २/४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_004/BhP_02.004.004.m4a", "display_order": 5}, {"id": 6000024005, "chapter_id": 10024, "verse_number": "२-४-४", "content_sanskrit": "संस्थां विज्ञाय संन्यस्य कर्म त्रैवर्गिकं च यत्।\nवासुदेवे भगवति स्वात्मभावं दृढं गतः॥ २/४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_004/BhP_02.004.005.m4a", "display_order": 6}, {"id": 6000024006, "chapter_id": 10024, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_004/BhP_02.004.006.m4a", "display_order": 7}, {"id": 6000024007, "chapter_id": 10024, "verse_number": "२-४-५", "content_sanskrit": "समीचीनं वचो ब्रह्मन्सर्वज्ञस्य तवानघ।\nतमो विशीर्यते मह्यं हरेः कथयतः कथाः॥ २/४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_004/BhP_02.004.007.m4a", "display_order": 8}, {"id": 6000024008, "chapter_id": 10024, "verse_number": "२-४-६", "content_sanskrit": "भूय एव विवित्सामि भगवानात्ममायया। यथेदं सृजते विश्वं दुर्विभाव्यमधीश्वरैः।\nयथा गोपायति विभुः यथा संयच्छते पुनः॥ २/४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_004/BhP_02.004.008.m4a", "display_order": 9}, {"id": 6000024009, "chapter_id": 10024, "verse_number": "२-४-७", "content_sanskrit": "यां यां शक्तिमुपाश्रित्य पुरुशक्तिः परः पुमान्।\nआत्मानं क्रीडयन्क्रीडन्करोति विकरोति च॥ २/४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_004/BhP_02.004.009.m4a", "display_order": 10}, {"id": 6000024010, "chapter_id": 10024, "verse_number": "२-४-८", "content_sanskrit": "नूनं भगवतो ब्रह्मन्हरेरद्भुतकर्मणः।\nदुर्विभाव्यमिवाभाति कविभिश्च विचेष्टितम्॥ २/४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_004/BhP_02.004.010.m4a", "display_order": 11}, {"id": 6000024011, "chapter_id": 10024, "verse_number": "२-४-९", "content_sanskrit": "यथा गुणांस्तु प्रकृतेर्युगपत्क्रमशोऽपि वा।\nबिभर्ति भूरिशस्त्वेकः कुर्वन्कर्माणि जन्मभिः॥ २/४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_004/BhP_02.004.011.m4a", "display_order": 12}, {"id": 6000024012, "chapter_id": 10024, "verse_number": "२-४-१०", "content_sanskrit": "विचिकित्सितमेतन्मे ब्रवीतु भगवान्यथा।\nशब्दब्रह्मणि निष्णातः परस्मिंश्च भवान् खलु॥ २/४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_004/BhP_02.004.012.m4a", "display_order": 13}, {"id": 6000024013, "chapter_id": 10024, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_004/BhP_02.004.013.m4a", "display_order": 14}, {"id": 6000024014, "chapter_id": 10024, "verse_number": "२-४-११", "content_sanskrit": "इत्युपामन्त्रितो राज्ञा गुणानुकथने विभोः।\nहृषीकेशमनुस्मृत्य प्रतिवक्तुं प्रचक्रमे॥ २/४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_004/BhP_02.004.014.m4a", "display_order": 15}, {"id": 6000024015, "chapter_id": 10024, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_004/BhP_02.004.015.m4a", "display_order": 16}, {"id": 6000024016, "chapter_id": 10024, "verse_number": "२-४-१२", "content_sanskrit": "नमः परस्मै पुरुषाय भूयसे सदुद्भवस्थाननिरोधलीलया।\nगृहीतशक्तित्रितयाय देहिनाम् अन्तर्ध्रुवायानुपलभ्यवर्त्मने॥ २/४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_004/BhP_02.004.016.m4a", "display_order": 17, "topics": [{"text": "शुकेन भगवन्नमनपूर्वकं ब्रह्मनारदसंवादकथनमुखेन तन्निरूपणम्", "range": "१२–२५"}]}, {"id": 6000024017, "chapter_id": 10024, "verse_number": "२-४-१३", "content_sanskrit": "भूयो नमः सद्वृजिनच्छिदेऽसतामसम्भवायाखिलसत्त्वमूर्तये।\nपुंसां पुनः पारमहंस्य आश्रमे व्यवस्थितानामनुमृग्यदाशुषे॥ २/४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_004/BhP_02.004.017.m4a", "display_order": 18}, {"id": 6000024018, "chapter_id": 10024, "verse_number": "२-४-१४", "content_sanskrit": "नमो नमस्तेऽस्त्वृषभाय सात्वतां विदूरकाष्ठाय मुहुः कुयोगिनाम्।\nनिरस्तसाम्यातिशयेन राधसा स्वधामनि ब्रह्मणि रंस्यते नमः॥ २/४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_004/BhP_02.004.018.m4a", "display_order": 19}, {"id": 6000024019, "chapter_id": 10024, "verse_number": "२-४-१५", "content_sanskrit": "यत्कीर्तनं यच्छ्रवणं यदीक्षणं यद्वन्दनं यत्स्मरणं यदर्हणम्।\nलोकस्य सद्यो विधुनोति कल्मषं तस्मै सुभद्रश्रवसे नमो नमः॥ २/४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_004/BhP_02.004.019.m4a", "display_order": 20}, {"id": 6000024020, "chapter_id": 10024, "verse_number": "२-४-१६", "content_sanskrit": "विचक्षणा यच्चरणोपसादनात् सङ्गं व्युदस्योभयतोऽन्तरात्मनः।\nविन्दन्ति हि ब्रह्मगतिं गतक्लमाः तस्मै सुभद्रश्रवसे नमो नमः॥ २/४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_004/BhP_02.004.020.m4a", "display_order": 21}, {"id": 6000024021, "chapter_id": 10024, "verse_number": "२-४-१७", "content_sanskrit": "तपस्विनो दानपरा यशस्विनो मनस्विनो मन्त्रविदः सुमङ्गलाः।\nक्षेमं न विन्दन्ति विना यदर्पणं तस्मै सुभद्रश्रवसे नमो नमः॥ २/४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_004/BhP_02.004.021.m4a", "display_order": 22}, {"id": 6000024022, "chapter_id": 10024, "verse_number": "२-४-१८", "content_sanskrit": "किरातहूणान्ध्रपुलिन्दपुल्कसा आभीरकङ्का यवनाश्शकादयः।\nयेऽन्ये च पापा यदपाश्रयाश्रयाच्छुध्यन्ति तस्मै प्रभविष्णवे नमः॥ २/४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_004/BhP_02.004.022.m4a", "display_order": 23}, {"id": 6000024023, "chapter_id": 10024, "verse_number": "२-४-१९", "content_sanskrit": "स एष आत्माऽऽत्मवतामधीश्वरस्‍त्रयीमयो धर्ममयस्तपोमयः।\nगतव्यलीकैरजशङ्करादिभिर्वितर्क्यलिङ्गो भगवान्प्रसीदताम्॥ २/४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_004/BhP_02.004.023.m4a", "display_order": 24}, {"id": 6000024024, "chapter_id": 10024, "verse_number": "२-४-२०", "content_sanskrit": "श्रियःपतिर्यज्ञपतिर्जगत्पतिर्धियांपतिर्लोकपतिर्धरापतिः।\nपतिर्गतिश्चान्धकवृष्णिसात्वतां प्रसीदतां मे भगवान्सतां पतिः॥ २/४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_004/BhP_02.004.024.m4a", "display_order": 25}, {"id": 6000024025, "chapter_id": 10024, "verse_number": "२-४-२१", "content_sanskrit": "यदङ्घ्र्यभिध्यानसमाधिधौतया धियाऽनुपश्यन्ति हि तत्त्वमात्मनः।\nवदन्ति चैतत्कवयो यथारुचं स मे मुकुन्दो भगवान्प्रसीदताम्॥ २/४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_004/BhP_02.004.025.m4a", "display_order": 26}, {"id": 6000024026, "chapter_id": 10024, "verse_number": "२-४-२२", "content_sanskrit": "प्रचोदिता येन पुरा सरस्वती वितन्वताऽजस्य सतीं स्थितिं हृदि।\nस्वलक्षणा प्रादुरभूत्किलाऽस्यतः स मे ऋषीणामृषभः प्रसीदताम्॥ २/४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_004/BhP_02.004.026.m4a", "display_order": 27}, {"id": 6000024027, "chapter_id": 10024, "verse_number": "२-४-२३", "content_sanskrit": "भूतैर्महद्भिर्य इमाः पुरो विभुर्निर्माय शेते यदमूषु पूरुषः।\nभुङ्क्ते गुणान् षोडश षोडशात्मकः सोऽलङ्कृषीष्ट भगवान्वचांसि मे॥ २/४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_004/BhP_02.004.027.m4a", "display_order": 28}, {"id": 6000024028, "chapter_id": 10024, "verse_number": "२-४-२४", "content_sanskrit": "नमस्तस्मै भगवते वासुदेवाय वेधसे।\nपपुर्ज्ञानमयं सौम्या यन्मुखाम्बुरुहासवम्॥ २/४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_004/BhP_02.004.028.m4a", "display_order": 29}, {"id": 6000024029, "chapter_id": 10024, "verse_number": "२-४-२५", "content_sanskrit": "एतदेवात्मभू राजन्नारदायेति पृच्छते।\nवेदगर्भोऽभ्यधात्साक्षाद् यदाह हरिरात्मनः॥ २/४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_004/BhP_02.004.029.m4a", "display_order": 30}, {"id": 6000024030, "chapter_id": 10024, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां द्वितीयस्कन्धे चतुर्थाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]