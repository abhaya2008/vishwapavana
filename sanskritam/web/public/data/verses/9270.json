[{"id": 5000270000, "chapter_id": 9270, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे त्रिसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000270001, "chapter_id": 9270, "verse_number": "३-७३-१", "content_sanskrit": "दर्शयित्वा तु रामाय सीतायाः परिमार्गणे।\nवाक्यमन्वर्थमर्थज्ञः कबन्धः पुनरब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000270002, "chapter_id": 9270, "verse_number": "३-७३-२", "content_sanskrit": "एष राम शिवः पन्था यत्रैते पुष्पिता द्रुमाः।\nप्रतीचीं दिशमाश्रित्य प्रकाशन्ते मनोरमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000270003, "chapter_id": 9270, "verse_number": "३-७३-३", "content_sanskrit": "जम्बूप्रियालपनसा न्यग्रोधप्लक्षतिन्दुकाः।\nअश्वत्थाः कर्णिकाराश्च चूताश्चान्ये च पादपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000270004, "chapter_id": 9270, "verse_number": "३-७३-४", "content_sanskrit": "धन्वना नागवृक्षाश्च तिलका नक्तमालकाः।\nनीलाशोकाः कदम्बाश्च करवीराश्च पुष्पिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000270005, "chapter_id": 9270, "verse_number": "३-७३-५", "content_sanskrit": "अग्निमुख्या अशोकाश्च सुरक्ताः पारिभद्रकाः।\nतानारुह्याथवा भूमौ पातयित्वा च तान् बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000270006, "chapter_id": 9270, "verse_number": "३-७३-६", "content_sanskrit": "फलान्यमृतकल्पानि भक्षयित्वा गमिष्यथः।\nतदतिक्रम्य काकुत्स्थ वनं पुष्पितपादपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000270007, "chapter_id": 9270, "verse_number": "३-७३-७", "content_sanskrit": "नन्दनप्रतिमं चान्यत् कुरवस्तूत्तरा इव।\nसर्वकालफला यत्र पादपा मधुरस्रवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000270008, "chapter_id": 9270, "verse_number": "३-७३-८", "content_sanskrit": "सर्वे च ऋतवस्तत्र वने चैत्ररथे यथा।\nफलभारनतास्तत्र महाविटपधारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000270009, "chapter_id": 9270, "verse_number": "३-७३-९", "content_sanskrit": "शोभन्ते सर्वतस्तत्र मेघपर्वतसंनिभाः।\nतानारुह्याथवा भूमौ पातयित्वाथवा सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000270010, "chapter_id": 9270, "verse_number": "३-७३-१०", "content_sanskrit": "फलान्यमृतकल्पानि लक्ष्मणस्ते प्रदास्यति।\nचङ्क्रमन्तौ वरान् शैलान् शैलाच्छैलं वनाद् वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000270011, "chapter_id": 9270, "verse_number": "३-७३-११", "content_sanskrit": "ततः पुष्करिणीं वीरौ पम्पां नाम गमिष्यथः।\nअशर्करामविभ्रंशां समतीर्थामशैवलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000270012, "chapter_id": 9270, "verse_number": "३-७३-१२", "content_sanskrit": "राम संजातवालूकां कमलोत्पलशोभिताम्।\nतत्र हंसाः प्लवाः क्रौञ्चाः कुरराश्चैव राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000270013, "chapter_id": 9270, "verse_number": "३-७३-१३", "content_sanskrit": "वल्गुस्वरा निकूजन्ति पम्पासलिलगोचराः।\nनोद्विजन्ते नरान् दृष्ट्वा वधस्याकोविदाः शुभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000270014, "chapter_id": 9270, "verse_number": "३-७३-१४", "content_sanskrit": "घृतपिण्डोपमान् स्थूलांस्तान् द्विजान् भक्षयिष्यथः।\nरोहितान् वक्रतुण्डांश्च नलमीनांश्च राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000270015, "chapter_id": 9270, "verse_number": "३-७३-१५", "content_sanskrit": "पम्पायामिषुभिर्मत्स्यांस्तत्र राम वरान् हतान्।\nनिस्त्वक्पक्षानयस्तप्तानकृशानैककण्टकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000270016, "chapter_id": 9270, "verse_number": "३-७३-१६", "content_sanskrit": "तव भक्त्या समायुक्तो लक्ष्मणः सम्प्रदास्यति।\nभृशं तान् खादतो मत्स्यान् पम्पायाः पुष्पसंचये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000270017, "chapter_id": 9270, "verse_number": "३-७३-१७", "content_sanskrit": "पद्मगन्धि शिवं वारि सुखशीतमनामयम्।\nउद‍्धृत्य स तदाक्लिष्टं रूप्यस्फटिकसंनिभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000270018, "chapter_id": 9270, "verse_number": "३-७३-१८", "content_sanskrit": "अथ पुष्करपर्णेन लक्ष्मणः पाययिष्यति।\nस्थूलान् गिरिगुहाशय्यान् वानरान् वनचारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000270019, "chapter_id": 9270, "verse_number": "३-७३-१९", "content_sanskrit": "सायाह्ने विचरन् राम दर्शयिष्यति लक्ष्मणः।\nअपां लोभादुपावृत्तान् वृषभानिव नर्दतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000270020, "chapter_id": 9270, "verse_number": "३-७३-२०", "content_sanskrit": "स्थूलान् पीतांश्च पम्पायां द्रक्ष्यसि त्वं नरोत्तम।\nसायाह्ने विचरन् राम विटपी माल्यधारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000270021, "chapter_id": 9270, "verse_number": "३-७३-२१", "content_sanskrit": "शिवोदकं च पम्पायां दृष्ट्वा शोकं विहास्यसि।\nसुमनोभिश्चितास्तत्र तिलका नक्तमालकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000270022, "chapter_id": 9270, "verse_number": "३-७३-२२", "content_sanskrit": "उत्पलानि च फुल्लानि पङ्कजानि च राघव।\nन तानि कश्चिन्माल्यानि तत्रारोपयिता नरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000270023, "chapter_id": 9270, "verse_number": "३-७३-२३", "content_sanskrit": "न च वै म्लानतां यान्ति न च शीर्यन्ति राघव।\nमतङ्गशिष्यास्तत्रासन्नृषयः सुसमाहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000270024, "chapter_id": 9270, "verse_number": "३-७३-२४", "content_sanskrit": "तेषां भाराभितप्तानां वन्यमाहरतां गुरोः।\nये प्रपेतुर्महीं तूर्णं शरीरात् स्वेदबिन्दवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000270025, "chapter_id": 9270, "verse_number": "३-७३-२५", "content_sanskrit": "तानि माल्यानि जातानि मुनीनां तपसा तदा।\nस्वेदबिन्दुसमुत्थानि न विनश्यन्ति राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000270026, "chapter_id": 9270, "verse_number": "३-७३-२६", "content_sanskrit": "तेषां गतानामद्यापि दृश्यते परिचारिणी।\nश्रमणी शबरी नाम काकुत्स्थ चिरजीविनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000270027, "chapter_id": 9270, "verse_number": "३-७३-२७", "content_sanskrit": "त्वां तु धर्मे स्थिता नित्यं सर्वभूतनमस्कृतम्।\nदृष्ट्वा देवोपमं राम स्वर्गलोकं गमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000270028, "chapter_id": 9270, "verse_number": "३-७३-२८", "content_sanskrit": "ततस्तद्राम पम्पायास्तीरमाश्रित्य पश्चिमम्।\nआश्रमस्थानमतुलं गुह्यं काकुत्स्थ पश्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000270029, "chapter_id": 9270, "verse_number": "३-७३-२९", "content_sanskrit": "न तत्राक्रमितुं नागाः शक्नुवन्ति तदाश्रमे।\nऋषेस्तस्य मतङ्गस्य विधानात् तच्च काननम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000270030, "chapter_id": 9270, "verse_number": "३-७३-३०", "content_sanskrit": "मतङ्गवनमित्येव विश्रुतं रघुनन्दन।\nतस्मिन् नन्दनसंकाशे देवारण्योपमे वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000270031, "chapter_id": 9270, "verse_number": "३-७३-३१", "content_sanskrit": "नानाविहगसंकीर्णे रंस्यसे राम निर्वृतः।\nऋष्यमूकस्तु पम्पायाः पुरस्तात् पुष्पितद्रुमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000270032, "chapter_id": 9270, "verse_number": "३-७३-३२", "content_sanskrit": "सुदुःखारोहणश्चैव शिशुनागाभिरक्षितः।\nउदारो ब्रह्मणा चैव पूर्वकालेऽभिनिर्मितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000270033, "chapter_id": 9270, "verse_number": "३-७३-३३", "content_sanskrit": "शयानः पुरुषो राम तस्य शैलस्य मूर्धनि।\nयत् स्वप्नं लभते वित्तं तत् प्रबुद्धोऽधिगच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000270034, "chapter_id": 9270, "verse_number": "३-७३-३४", "content_sanskrit": "यस्त्वेनं विषमाचारः पापकर्माधिरोहति।\nतत्रैव प्रहरन्त्येनं सुप्तमादाय राक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000270035, "chapter_id": 9270, "verse_number": "३-७३-३५", "content_sanskrit": "तत्रापि शिशुनागानामाक्रन्दः श्रूयते महान्।\nक्रीडतां राम पम्पायां मतङ्गाश्रमवासिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000270036, "chapter_id": 9270, "verse_number": "३-७३-३६", "content_sanskrit": "सक्ता रुधिरधाराभिः संहत्य परमद्विपाः।\nप्रचरन्ति पृथक्कीर्णा मेघवर्णास्तरस्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000270037, "chapter_id": 9270, "verse_number": "३-७३-३७", "content_sanskrit": "ते तत्र पीत्वा पानीयं विमलं चारु शोभनम्।\nअत्यन्तसुखसंस्पर्शं सर्वगन्धसमन्वितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000270038, "chapter_id": 9270, "verse_number": "३-७३-३८", "content_sanskrit": "निर्वृत्ताः संविगाहन्ते वनानि वनगोचराः।\nऋक्षांश्च द्वीपिनश्चैव नीलकोमलकप्रभान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000270039, "chapter_id": 9270, "verse_number": "३-७३-३९", "content_sanskrit": "रुरूनपेतानजयान् दृष्ट्वा शोकं प्रहास्यसि।\nराम तस्य तु शैलस्य महती शोभते गुहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000270040, "chapter_id": 9270, "verse_number": "३-७३-४०", "content_sanskrit": "शिलापिधाना काकुत्स्थ दुःखं चास्याः प्रवेशनम्।\nतस्या गुहायाः प्राग्द्वारे महान् शीतोदको ह्रदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000270041, "chapter_id": 9270, "verse_number": "३-७३-४१", "content_sanskrit": "बहुमूलफलो रम्यो नानानगसमाकुलः।\nतस्यां वसति धर्मात्मा सुग्रीवः सह वानरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000270042, "chapter_id": 9270, "verse_number": "३-७३-४२", "content_sanskrit": "कदाचिच्छिखरे तस्य पर्वतस्यापि तिष्ठति।\nकबन्धस्त्वनुशास्यैवं तावुभौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000270043, "chapter_id": 9270, "verse_number": "३-७३-४३", "content_sanskrit": "स्रग्वी भास्करवर्णाभः खे व्यरोचत वीर्यवान्।\nतं तु खस्थं महाभागं तावुभौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000270044, "chapter_id": 9270, "verse_number": "३-७३-४४", "content_sanskrit": "प्रस्थितौ त्वं व्रजस्वेति वाक्यमूचतुरन्तिके।\nगम्यतां कार्यसिद्ध्यर्थमिति तावब्रवीत् स च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000270045, "chapter_id": 9270, "verse_number": "३-७३-४५", "content_sanskrit": "सुप्रीतौ तावनुज्ञाप्य कबन्धः प्रस्थितस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000270046, "chapter_id": 9270, "verse_number": "३-७३-४६", "content_sanskrit": "स तत् कबन्धः प्रतिपद्य रूपं\nवृतः श्रिया भास्वरसर्वदेहः।\nनिदर्शयन् राममवेक्ष्य खस्थः\nसख्यं कुरुष्वेति तदाभ्युवाच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000270047, "chapter_id": 9270, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे त्रिसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]