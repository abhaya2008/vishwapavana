[{"id": 40017803, "chapter_id": 9270, "verse_number": "1", "content_sanskrit": "श्रुत्वातुभीमनिर्ह्रादंशक्राशनिसमस्वनम् । वीक्षमाणादिशस्सर्वादुद्रुवुर्वानरर्षभा: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40017804, "chapter_id": 9270, "verse_number": "2", "content_sanskrit": "तानुवाचततःसर्वान्हनुमान् मारुतात्मजः । विषण्णवदनान्दीनांस्त्रस्तान्विद्रवतःपृथक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40017805, "chapter_id": 9270, "verse_number": "3", "content_sanskrit": "कस्माद्विषण्णवदनाविद्रवध्वंप्लवङ्गमाः । त्यक्तयुद्धसमुत्साहाश्शूरत्वंक्वनुवोगतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40017806, "chapter_id": 9270, "verse_number": "4", "content_sanskrit": "पृष्ठतोऽनुव्रजध्वंमामग्रतोयन्तमाहवे । शूरैरनिजनोपेतैरयुक्तंहिनिवर्तितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40017807, "chapter_id": 9270, "verse_number": "5", "content_sanskrit": "एवमुक्तास्सुसङ्क्रुद्धावायुपुत्रेणधीमता । शैलशृङ्गान् द्रुमांश्चवजगृहुर्हृष्टमानसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40017808, "chapter_id": 9270, "verse_number": "6", "content_sanskrit": "अभिपेतुश्चगर्जन्तोराक्षसान्वानरर्षभाः । परिवार्यहनूमन्तमन्वयुश्चमहाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40017809, "chapter_id": 9270, "verse_number": "7", "content_sanskrit": "स तैर्वानरमुख्यैश्चहनुमान्सर्वतोवृतः । हुताशनइवार्चिष्मानदहच्छत्रुवाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40017810, "chapter_id": 9270, "verse_number": "8", "content_sanskrit": "स राक्षसानांकदनंचकारसुमहाकपिः । वृतोवानरसैन्येनकालान्तकयोमोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40017811, "chapter_id": 9270, "verse_number": "9", "content_sanskrit": "स तुकोपेनचाविष्टःशोकेन च महाकपिः । हनूमान्रावणिरथेमहतींपातयच्छिलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40017812, "chapter_id": 9270, "verse_number": "10", "content_sanskrit": "तामापतन्तींदृष्टवैवरथस्सारथिनातदा । विधेयाश्वसमायुक्तोविदूरमपवाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40017813, "chapter_id": 9270, "verse_number": "11", "content_sanskrit": "तमिन्द्रजितमप्राप्यरथस्थंसहसारथिम् । विवेशधरणींभित्त्वासाशिलाव्यर्थमुद्यता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40017814, "chapter_id": 9270, "verse_number": "12", "content_sanskrit": "पतितायांशिलायांतुव्यथितारक्षसांचमूः । निपतन्त्या च शिलयाराक्षसामथिताभृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40017815, "chapter_id": 9270, "verse_number": "13", "content_sanskrit": "तमभ्यधावन् शतशोनदन्तःकाननौकसः । तेद्रुमांश्चमहाकायागिरिशृङ्गाणिचोद्यताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40017816, "chapter_id": 9270, "verse_number": "14", "content_sanskrit": "क्षिपनीन्द्रजितंसङ्ख्येवानराभीमविक्रमाः । वृक्षशैलमहावर्षंविसृजन्तःप्लवङ्गमाः ॥ शत्रूणांकदनंचक्रुर्नेदुश्चविविधैस्स्वनैः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40017817, "chapter_id": 9270, "verse_number": "15", "content_sanskrit": "वानरैसैर्महाभीमैर्घोररूपानिशाचराः ॥ वीर्यादभिहतावृक्षैर्व्यचेष्टन्तरणक्षितौ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40017818, "chapter_id": 9270, "verse_number": "16", "content_sanskrit": "स्वसैन्यमभिवीक्ष्याथवानरार्दितमिन्द्रजित् ॥ प्रगृहीतायुधःक्रुद्धःपरानभिमुखोययौ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40017819, "chapter_id": 9270, "verse_number": "17", "content_sanskrit": "सःशरौघानवसृजन्स्वसैन्येनाभिसम्वृतः ॥ जघानकपिशार्दूलान्सुबहून्दृष्टविक्रमः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40017820, "chapter_id": 9270, "verse_number": "18", "content_sanskrit": "शूलैःरशनिभिःखङ्गै: पट्टसै: कूटमुद्गरैः ॥ तेचाप्यनुचरास्तस्यवानरान्जघ्नुराहवे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40017821, "chapter_id": 9270, "verse_number": "19", "content_sanskrit": "स्कन्धविटपैश्शालैश्शिलाभिश्चमहाबलः ॥ हनूमान्कदनंचक्रेरक्षसांभीमकर्मणाम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40017822, "chapter_id": 9270, "verse_number": "20", "content_sanskrit": "सनिवार्यपरानीकमब्रवीत्तान्वनौकसः ॥ हनूमान् सन्निवर्तध्वं न नस्साध्यमिदंबलम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40017823, "chapter_id": 9270, "verse_number": "21", "content_sanskrit": "त्यक्त्वाप्राणान्विवेष्टन्तोरामप्रियचिकीर्षवः ॥ यन्निमित्तंहियुध्यामोहतासाजनकात्मजा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40017824, "chapter_id": 9270, "verse_number": "22", "content_sanskrit": "इममर्थंहिविज्ञाप्यरामंसुग्रीवमेव च ॥ तौयत्प्रतिविधास्येतेतत्करिष्यामहेवयम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40017825, "chapter_id": 9270, "verse_number": "23", "content_sanskrit": "त्युक्त्वावानरश्रेष्ठोवारयन्सर्ववानरान् ॥ शनैश्शनैरसन्त्रस्तस्सबलस्सन्यवर्तत ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40017826, "chapter_id": 9270, "verse_number": "24", "content_sanskrit": "ततःप्रेक्ष्यहनूमन्तंव्रजन्तंयत्रराघवः ॥ स होतुकामोदुष्टात्मागतश्चैत्यंनिकुम्भिलाम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40017827, "chapter_id": 9270, "verse_number": "25", "content_sanskrit": "निकुम्भिलामधिष्ठायपावकंजुहवेन्द्रजित् ॥ यज्ञभूम्यांततोगत्वापावकस्तेनरक्षसा । हूयमानःप्रजज्वालमांसशोणितभुक्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40017828, "chapter_id": 9270, "verse_number": "26", "content_sanskrit": "निकुम्भिलामधिष्ठायपावकंजुहवेन्द्रजित् ॥ यज्ञभूम्यांततोगत्वापावकस्तेनरक्षसा । हूयमानःप्रजज्वालमांसशोणितभुक्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40017829, "chapter_id": 9270, "verse_number": "27", "content_sanskrit": "सोऽर्चिःपिनद्धोददृशेहोमशोणिततर्पितः । सन्ध्यागतइवादित्यःसुतीव्रोऽग्नि: समुत्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]