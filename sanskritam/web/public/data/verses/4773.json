[{"id": 2178448, "chapter_id": 4773, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2178449, "chapter_id": 4773, "verse_number": "१", "content_sanskrit": "हतं दुर्योधनं दृष्ट्वा गान्धारी शोककर्शिता ।\nसहसा न्यपतद् भूमौ छिन्नेव कदळी वने\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2178450, "chapter_id": 4773, "verse_number": "२", "content_sanskrit": "सा तु लब्ध्वा पुनः सञ्ज्ञां विक्रुश्य च पुनः पुनः ।\nदुर्योधनमभिप्रेक्ष्य शयानं रुधिरोक्षितम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2178451, "chapter_id": 4773, "verse_number": "३", "content_sanskrit": "परिष्वज्याथ गान्धारी कृपणं पर्यदेवयत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2178452, "chapter_id": 4773, "verse_number": "४", "content_sanskrit": "हा हा पुत्रेति दुःखार्ता विललापाकुलेन्द्रिया\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2178453, "chapter_id": 4773, "verse_number": "५", "content_sanskrit": "सुगूढजत्रुं विमलं हारनिष्कनिषेवितम् ।\nवारिणा नेत्रजेनोरः सिञ्चन्ती शोककर्शिता\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2178454, "chapter_id": 4773, "verse_number": "६", "content_sanskrit": "समीपस्थं हृषीकेशमिदं वचनमब्रवीत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2178455, "chapter_id": 4773, "verse_number": "", "content_sanskrit": "गान्धारी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2178456, "chapter_id": 4773, "verse_number": "७", "content_sanskrit": "उपस्थितेऽस्मिन् सङ्ग्रामे ज्ञातीनां सङ्क्षये विभो ।\nमामयं प्राह वार्ष्णेय प्राञ्जलिर्नृपसत्तमः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2178457, "chapter_id": 4773, "verse_number": "८", "content_sanskrit": "अस्मिन् ज्ञातिसमुद्धर्षे जयमम्बा ब्रवीतु मे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2178458, "chapter_id": 4773, "verse_number": "९", "content_sanskrit": "इत्युक्ता जानती सर्वमहं स्वं व्यसनागमम् ।\nअब्रुवं पुरुषव्याघ्र यतो धर्मस्ततो जयः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2178459, "chapter_id": 4773, "verse_number": "१०", "content_sanskrit": "यदा तु युध्यमानस्त्वं सम्प्रमुह्यसि पुत्रक ।\nध्रुवं शस्त्रहतान् लोकान् प्राप्तोऽस्यमरवत् प्रभो\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2178460, "chapter_id": 4773, "verse_number": "११", "content_sanskrit": "इत्येवमब्रुवं पूर्वं नैनं शोचाम्यहं प्रभो\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2178461, "chapter_id": 4773, "verse_number": "१२", "content_sanskrit": "धृतराष्ट्रं तु शोचामि कृपणं हतबान्धवम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2178462, "chapter_id": 4773, "verse_number": "१३", "content_sanskrit": "अमर्षणं युधां श्रेष्ठं कृतास्त्रं युद्धदुर्मदम् ।\nशयानं वीरशयने पश्य माधव मे सुतम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2178463, "chapter_id": 4773, "verse_number": "१४", "content_sanskrit": "योऽयं मूर्धावसिक्तानामग्रे याति परन्तपः ।\nसोऽयं पांसुषु शेतेऽद्य पश्य कालस्य पर्ययम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2178464, "chapter_id": 4773, "verse_number": "१५", "content_sanskrit": "एवं दुर्योधनो वीरो गतिं त्वसुलभां गतः ।\nतथा ह्यभिमुखः शेते शयने वीरसेविते\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2178465, "chapter_id": 4773, "verse_number": "१६", "content_sanskrit": "यं पुरा पर्युपासीना रमयन्ति वरस्त्रियः ।\nतं वीरशयने सुप्तं रमयन्त्यशिवाः शिवाः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2178466, "chapter_id": 4773, "verse_number": "१७", "content_sanskrit": "यं पुरा पर्युपासीना रमयन्ति महीक्षितः ।\nमहीतळस्थं निहतं गृध्रास्तं पर्युपासते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2178467, "chapter_id": 4773, "verse_number": "१८", "content_sanskrit": "यं पुरा व्यजनैरग्र्यैरुपजीवन्ति योषितः ।\nतमद्य पक्षव्यजनैरुपजीवन्ति पक्षिणः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2178468, "chapter_id": 4773, "verse_number": "१९", "content_sanskrit": "एष शेते महाबाहुर्बलवान् सत्यविक्रमः ।\nसिंहेनेव द्विपः सङ्खे भीमसेनेन पातितः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2178469, "chapter_id": 4773, "verse_number": "२०", "content_sanskrit": "पश्य दुर्योधनं कृष्ण शयानं रुधिरोक्षितम् ।\nनिहतं भीमसेनेन गदामालिङ्ग्य भारतम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2178470, "chapter_id": 4773, "verse_number": "२१", "content_sanskrit": "अक्षौहिणीर्महाबाहुर्दश चैकं च केशव ।\nआनयद्यः पुरा सङ्खे सोऽनया निधनं गतः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2178471, "chapter_id": 4773, "verse_number": "२२", "content_sanskrit": "एष दुर्योधनः शेते महेष्वासो महारथः ।\nशार्दूल इव सिंहेन भीमेन विनिपातितः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2178472, "chapter_id": 4773, "verse_number": "२३", "content_sanskrit": "विदुरं ह्यवमत्यैष पितरं चैव मन्दभाक् ।\nबालो वृद्धावमानेन मन्दो मृत्युवशं गतः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2178473, "chapter_id": 4773, "verse_number": "२४", "content_sanskrit": "निःसपत्ना मही यस्य त्रयोदश समाः स्थिता ।\nस शेते निहतः सङ्खे पुत्रो मे पृथिवीपतिः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2178474, "chapter_id": 4773, "verse_number": "२५", "content_sanskrit": "अपश्यं कृष्ण पृथिवीं धार्तराष्ट्रवशानुगाम् ।\nपूर्णां हस्तिगवाश्वैश्च वार्ष्णेय न तु तच्चिरम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2178475, "chapter_id": 4773, "verse_number": "२६", "content_sanskrit": "तामेवाद्य महाबाहो पश्याम्यन्यानुशासिताम् ।\nहीनां हस्तिगवाश्वैश्च किं नु जीवामि माधव\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2178476, "chapter_id": 4773, "verse_number": "२७", "content_sanskrit": "इदं कृच्छ्रतरं पश्य पुत्रस्यापि वधान्मम ।\nया इमाः पर्युपासन्ते हतान् शूरान् रणे स्त्रियः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2178477, "chapter_id": 4773, "verse_number": "२८", "content_sanskrit": "प्रकीर्णकेशां सुश्रोणीं दुर्योधनभुजाङ्कगाम् ।\nरुक्म(ग्म)वेदिनिभां पश्य कृष्ण लक्ष्म(क्ष)णमातरम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2178478, "chapter_id": 4773, "verse_number": "२९", "content_sanskrit": "नूनमेषा पुरा बाला जीवमाने महाभुजे ।\nभुजमाश्रित्य रमते सुभुजस्य मनस्विनी\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2178479, "chapter_id": 4773, "verse_number": "३०", "content_sanskrit": "कथं नु शतधा नेदं हृदयं मम दीर्यते ।\nपश्यन्त्या निहतं पुत्रं पौत्रेण सहितं रणे\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2178480, "chapter_id": 4773, "verse_number": "३१", "content_sanskrit": "पुत्रं रुधिरसंसिक्तमुपजिघ्रत्यनिन्दिता ।\nदुर्योधनं तु मृदुना पाणिना परिमार्जति\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2178481, "chapter_id": 4773, "verse_number": "३२", "content_sanskrit": "किं नु शोचति भर्तारमथ पुत्रं मनस्विनी ।\nतथा ह्यवस्थिता भाति पुत्रं चाप्यभिवीक्षते\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2178482, "chapter_id": 4773, "verse_number": "३३", "content_sanskrit": "स्वशिरः पञ्चशाखाभ्यामभिहत्यायतेक्षणा ।\nपतत्युरसि वीरस्य कुरुराजस्य माधव\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2178483, "chapter_id": 4773, "verse_number": "३४", "content_sanskrit": "पुण्डरीकमिवाघ्राति पुण्डरीकान्तरप्रभा ।\nमुखं प्रमृज्य पुत्रस्य भर्तुश्चैव तपस्विनी\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2178484, "chapter_id": 4773, "verse_number": "३५", "content_sanskrit": "यदि वाप्यागमाः सन्ति यदि च श्रुतयस्तथा ।\nध्रुवं लोकमवाप्तोऽयं नृपो बाहुबलार्जितम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2178485, "chapter_id": 4773, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां स्त्रीपर्वणि\nगान्धारीप्रलापो नाम सप्तदशोऽध्यायः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2178486, "chapter_id": 4773, "verse_number": "", "content_sanskrit": "स्त्रीपर्वणि द्वितीयोऽध्यायः ॥२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]