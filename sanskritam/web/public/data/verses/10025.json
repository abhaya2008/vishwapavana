[{"id": 6000025000, "chapter_id": 10025, "verse_number": null, "content_sanskrit": "अथ पञ्चमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000025001, "chapter_id": 10025, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.001.m4a", "display_order": 2}, {"id": 6000025002, "chapter_id": 10025, "verse_number": "२-५-१", "content_sanskrit": "देवदेव नमस्तेऽस्तु भूतभावन पूर्वज।\nतद्विजानीहि यज्ज्ञानम् आत्मतत्त्वनिदर्शनम्॥ २/५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.002.m4a", "display_order": 3, "topics": [{"text": "नारदेन चतुर्मुखं प्रति जगत्सृष्ट्यादिप्रकारकथनप्रार्थना", "range": "१–८"}]}, {"id": 6000025003, "chapter_id": 10025, "verse_number": "२-५-२", "content_sanskrit": "यद्रूपं यदधिष्ठानं यतः सृष्टमिदं विभो।\nयत्संस्थं यत्परं यच्च तत्तत्त्वं वद तत्वतः॥ २/५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.003.m4a", "display_order": 4}, {"id": 6000025004, "chapter_id": 10025, "verse_number": "२-५-३", "content_sanskrit": "सर्वं ह्येतद्भवान् वेद भूतभव्यभवत्प्रभुः।\nकरामलकवद्विश्वं विज्ञानावसितं तव॥ २/५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.004.m4a", "display_order": 5}, {"id": 6000025005, "chapter_id": 10025, "verse_number": "२-५-४", "content_sanskrit": "यद्विज्ञानो यदाधारो यत्परस्त्वं यदात्मकः।\nएकः सृजसि भूतानि भूतैरेवात्ममायया॥ २/५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.005.m4a", "display_order": 6}, {"id": 6000025006, "chapter_id": 10025, "verse_number": "२-५-५", "content_sanskrit": "आत्मन् भावयसे तानि न पराग्भावये स्वयम्।\nआत्मशक्तिमवष्टभ्य सूत्रनाभिरिवाक्लमः॥ २/५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.006.m4a", "display_order": 7}, {"id": 6000025007, "chapter_id": 10025, "verse_number": "२-५-६", "content_sanskrit": "नाहं वेद परं त्वस्मान्नावरं न समं विभो।\nनामरूपगुणैर्भाव्यं सदसत्किञ्चिदन्यतः॥ २/५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.007.m4a", "display_order": 8}, {"id": 6000025008, "chapter_id": 10025, "verse_number": "२-५-७", "content_sanskrit": "स भवानचरद् घोरं यत्तपः सुसमाहितः।\nतेन खेदयसे नस्त्वं परां शङ्कां च यच्छसि॥ २/५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.008.m4a", "display_order": 9}, {"id": 6000025009, "chapter_id": 10025, "verse_number": "२-५-८", "content_sanskrit": "एतन्मे पृच्छतः सर्वं सर्वज्ञ सकलेश्वर।\nविजानीहि यथैवेदमहं बुध्येऽनुशासितः॥ २/५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.009.m4a", "display_order": 10}, {"id": 6000025010, "chapter_id": 10025, "verse_number": null, "content_sanskrit": "ब्रह्मोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.010.m4a", "display_order": 11}, {"id": 6000025011, "chapter_id": 10025, "verse_number": "२-५-९", "content_sanskrit": "सम्यक्‍कारुणिकस्येदं वत्स ते विचिकित्सितम्।\nयदहं चोदितः सौम्य भगवद्वीर्यदर्शने॥ २/५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.011.m4a", "display_order": 12, "topics": [{"text": "ब्रह्मणा नारदं प्रति नारायणप्रणामपूर्वकं तदनुग्रहेणैव स्वस्य स्रष्टृत्वादिशक्तिसद्भावकथनपूर्वकं तत्त्वसृष्टिनिरूपणम्", "range": "९–३२"}]}, {"id": 6000025012, "chapter_id": 10025, "verse_number": "२-५-१०", "content_sanskrit": "नानृतं बत तच्चापि यथा मां प्रब्रवीषि भोः।\nअविज्ञाय परं मत्त एतावत्त्वं यतो हि मे॥ २/५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.012.m4a", "display_order": 13}, {"id": 6000025013, "chapter_id": 10025, "verse_number": "२-५-११", "content_sanskrit": "येन स्वरोचिषा विश्वं रोचितं रोचयाम्यहम्।\nयथाऽर्कोऽग्निर्यथा सोमो यथर्क्षग्रहतारकाः॥ २/५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.013.m4a", "display_order": 14}, {"id": 6000025014, "chapter_id": 10025, "verse_number": "२-५-१२", "content_sanskrit": "नमस्तस्मै भगवते वासुदेवाय धीमहि।\nयन्मायया दुर्जयया मां वदन्ति जगद्गुरुम्॥ २/५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.014.m4a", "display_order": 15}, {"id": 6000025015, "chapter_id": 10025, "verse_number": "२-५-१३", "content_sanskrit": "विलज्जमानया यस्य स्थातुमीक्षापथेऽमुया।\nविमोहिता विकत्थन्ते ममाहमिति दुर्धियः॥ २/५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.015.m4a", "display_order": 16}, {"id": 6000025016, "chapter_id": 10025, "verse_number": "२-५-१४", "content_sanskrit": "द्रव्यं कर्म च कालश्च स्वभावो जीव एव च।\nवासुदेवात्परो ब्रह्मन्न चान्योऽर्थोऽस्ति तात्वतः॥ २/५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.016.m4a", "display_order": 17}, {"id": 6000025017, "chapter_id": 10025, "verse_number": "२-५-१५", "content_sanskrit": "नारायणपरा वेदा देवा नारायणाङ्गजाः।\nनारायणपरा लोका नारायणपरा मखाः॥ २/५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.017.m4a", "display_order": 18}, {"id": 6000025018, "chapter_id": 10025, "verse_number": "२-५-१६", "content_sanskrit": "नारायणपरो योगो नारायणपरं तपः।\nनारायणपरं ज्ञानं नारायणपरा गतिः॥ २/५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.018.m4a", "display_order": 19}, {"id": 6000025019, "chapter_id": 10025, "verse_number": "२-५-१७", "content_sanskrit": "तस्यापि द्रष्टुरीशस्य कूटस्थस्याखिलात्मनः।\nसृज्यं सृजामि सृष्टोऽहमीक्षयैवाभिचोदितः॥ २/५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.019.m4a", "display_order": 20}, {"id": 6000025020, "chapter_id": 10025, "verse_number": "२-५-१८", "content_sanskrit": "सत्त्वं रजस्तम इति निर्गुणस्य गुणास्‍त्रयः।\nस्थितिसर्गनिरोधेषु गृहीता मायया विभोः॥ २/५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.020.m4a", "display_order": 21}, {"id": 6000025021, "chapter_id": 10025, "verse_number": "२-५-१९", "content_sanskrit": "कार्यकारणकर्तृत्वे द्रव्यज्ञानक्रियाश्रयाः।\nबध्नन्ति नित्यदा मुक्तं मायिनं पुरुषं गुणाः॥ २/५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.021.m4a", "display_order": 22}, {"id": 6000025022, "chapter_id": 10025, "verse_number": "२-५-२०", "content_sanskrit": "स एष भगवान् ‍लिङ्गैस्‍त्रिभिरेतैरधोक्षजः।\nस्वलक्षितगतिर्ब्रह्मन्सर्वेषां मम चेश्वरः॥ २/५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.022.m4a", "display_order": 23}, {"id": 6000025023, "chapter_id": 10025, "verse_number": "२-५-२१", "content_sanskrit": "कालं कर्म स्वभावं च मायेशो मायया स्वया।\nआत्मन्यदृच्छया प्राप्तं विबुभूषुरुपाददे॥ २/५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.023.m4a", "display_order": 24}, {"id": 6000025024, "chapter_id": 10025, "verse_number": "२-५-२२", "content_sanskrit": "कालाद्गुणव्यतिकरात्परिणामस्वभावतः।\nकर्मणो जन्म महतः पुरुषाधिष्ठितादभूत्॥ २/५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.024.m4a", "display_order": 25}, {"id": 6000025025, "chapter_id": 10025, "verse_number": "२-५-२३", "content_sanskrit": "महतस्तु विकुर्वाणाद्रजस्सत्त्वोपबृंहितात्।\nतमःप्रधानस्त्वभवद्द्रव्यज्ञानक्रियाऽऽत्मकः॥ २/५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.025.m4a", "display_order": 26}, {"id": 6000025026, "chapter_id": 10025, "verse_number": "२-५-२४", "content_sanskrit": "सोऽहङ्कार इति प्रोक्तो विकुर्वन्समभूत्त्रिधा। वैकारिकस्तैजसश्च तामसश्चेति यद्भिदा।\nद्रव्यशक्तिः क्रियाशक्तिर्ज्ञानशक्तिरिति प्रभोः॥ २/५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.026.m4a", "display_order": 27}, {"id": 6000025027, "chapter_id": 10025, "verse_number": "२-५-२५", "content_sanskrit": "तामसादपि भूतादेर्विकुर्वाणादभून्नभः।\nतस्य मात्रागुणः शब्दो लिङ्गं यद्द्रष्टृदृश्ययोः॥ २/५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.027.m4a", "display_order": 28}, {"id": 6000025028, "chapter_id": 10025, "verse_number": "२-५-२६", "content_sanskrit": "नभसोऽथ विकुर्वाणाद् अभूत्स्पर्शगुणोऽनिलः।\nपरान्वयाच्छब्दवांश्च प्राण ओजः सहो बलम्॥ २/५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.028.m4a", "display_order": 29}, {"id": 6000025029, "chapter_id": 10025, "verse_number": "२-५-२७", "content_sanskrit": "वायोरपि विकुर्वाणात्कालकर्मस्वभावतः।\nउदपद्यत तेजो वै रूपवत्स्पर्शशब्दवत्॥ २/५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.029.m4a", "display_order": 30}, {"id": 6000025030, "chapter_id": 10025, "verse_number": "२-५-२८", "content_sanskrit": "तेजसस्तु विकुर्वाणादासीदम्भो रसात्मकम्।\nरूपवत्स्पर्शवच्चाम्भो घोषवच्च तदन्वयात्॥ २/५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.030.m4a", "display_order": 31}, {"id": 6000025031, "chapter_id": 10025, "verse_number": "२-५-२९", "content_sanskrit": "विशेषस्तु विकुर्वाणाद् अम्भसो गन्धवानभूत्।\nपरान्वयाद्रसस्पर्शरूपशब्दगुणान्वितः॥ २/५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.031.m4a", "display_order": 32}, {"id": 6000025032, "chapter_id": 10025, "verse_number": "२-५-३०", "content_sanskrit": "वैकारिकान्मनो जज्ञे देवा वैकारिका दश।\nदिग्वातार्कप्रचेतोऽश्विवह्नीन्द्रोपेन्द्रमित्रकाः॥ २/५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.032.m4a", "display_order": 33}, {"id": 6000025033, "chapter_id": 10025, "verse_number": "२-५-३१", "content_sanskrit": "तैजसात्तु विकुर्वाणादिन्द्रियाणि दशाभवन्।\nज्ञानशक्तिः क्रियाशक्तिर्बुद्धिः प्राणस्तु तैजसौ॥ २/५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.033.m4a", "display_order": 34}, {"id": 6000025034, "chapter_id": 10025, "verse_number": "२-५-३२", "content_sanskrit": "श्रोत्रत्वग्घ्राणदृग्जिह्वावाग्दोर्मेढ्राङ्घ्रिपायवः। य एतेऽसङ्गता भावा भूतेन्द्रियमनोगुणाः।\nयदायतननिर्माणे न शेकुर्ब्रह्मवित्तम॥ २/५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.034.m4a", "display_order": 35}, {"id": 6000025035, "chapter_id": 10025, "verse_number": "२-५-३३", "content_sanskrit": "तदा संहत्य चान्योन्यं भगवच्छक्तिचोदिताः।\nसदसत्त्वमुपादाय नो भयं ससृजुर्ह्यदः॥ २/५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.035.m4a", "display_order": 36, "topics": [{"text": "अण्डसृष्टिकथनपूर्वकम् अण्डान्तर्भगवदवयवैश्चतुर्दशलोककल्पनकथनम्", "range": "३३–४२"}]}, {"id": 6000025036, "chapter_id": 10025, "verse_number": "२-५-३४", "content_sanskrit": "वर्षपूगसहस्रान्ते तदण्डमुदकेशयम्।\nकालकर्मस्वभावस्थोऽजीवोऽजीवमजीजनत्॥ २/५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.036.m4a", "display_order": 37}, {"id": 6000025037, "chapter_id": 10025, "verse_number": "२-५-३५", "content_sanskrit": "स एष पुरुषस्तस्मादण्डं निर्भिद्य निर्गतः।\nसहस्रोर्वङ्घ्रिबाह्वक्षिः सहस्राननशीर्षवान्॥ २/५/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.037.m4a", "display_order": 38}, {"id": 6000025038, "chapter_id": 10025, "verse_number": "२-५-३६", "content_sanskrit": "यस्येहावयवैर्लोकान् कल्पयन्ति मनीषिणः।\nऊर्वादिभिरधः सप्त सप्तोर्ध्वं जघनादिभिः॥ २/५/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.038.m4a", "display_order": 39}, {"id": 6000025039, "chapter_id": 10025, "verse_number": "२-५-३७", "content_sanskrit": "पुरुषस्य मुखं ब्रह्म क्षत्रमेतस्य बाहवः।\nऊर्वोर्वैश्यो भगवतः पद्भ्यां शूद्रो व्यजायत॥ २/५/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.039.m4a", "display_order": 40}, {"id": 6000025040, "chapter_id": 10025, "verse_number": "२-५-३८", "content_sanskrit": "भूर्लोकः कल्पितः पद्भ्यां भुवर्लोकोऽस्य नाभितः।\nहृदा स्वर्लोक उरसा महर्लोको महात्मनः॥ २/५/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.040.m4a", "display_order": 41}, {"id": 6000025041, "chapter_id": 10025, "verse_number": "२-५-३९", "content_sanskrit": "ग्रीवायां जनलोकश्च तपोलोकोऽस्य नेत्रयोः।\nमूर्धभिः सत्यलोकस्तु ब्रह्मलोकः सनातनः॥ २/५/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.041.m4a", "display_order": 42}, {"id": 6000025042, "chapter_id": 10025, "verse_number": "२-५-४०", "content_sanskrit": "तत्कट्यामतलं क्लृप्तमूरूभ्यां वितलं विभोः।\nजानुभ्यां सुतलं क्लृप्तं जङ्घाभ्यां तु तलातलम्॥ २/५/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.042.m4a", "display_order": 43}, {"id": 6000025043, "chapter_id": 10025, "verse_number": "२-५-४१", "content_sanskrit": "महातलन्तु गुल्फाभ्यां प्रपदाभ्यां रसातलम्।\nपातालं पादतलतः इति लोकमयः पुमान्॥ २/५/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.043.m4a", "display_order": 44}, {"id": 6000025044, "chapter_id": 10025, "verse_number": "२-५-४२", "content_sanskrit": "भूर्लोकः कल्पितः पद्भ्यां भुवर्लोकस्तु नाभितः।\nस्वर्लोकः कल्पितो मूर्ध्नि इति वा लोककल्पना॥ २/५/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_005/BhP_02.005.044.m4a", "display_order": 45}, {"id": 6000025045, "chapter_id": 10025, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां द्वितीयस्कन्धे पञ्चमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]