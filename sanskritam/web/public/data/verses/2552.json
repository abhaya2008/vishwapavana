[{"id": 2073464, "chapter_id": 2552, "verse_number": "१२-५७-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2073465, "chapter_id": 2552, "verse_number": "१२-५७-१", "content_sanskrit": "एतत्ते राजधर्माणां नवनीतं युधिष्ठिर।\nबृहस्पतिर्हि भगवान्नान्यं धर्मं प्रशंसति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2073466, "chapter_id": 2552, "verse_number": "१२-५७-२", "content_sanskrit": "विशालाक्षश्च भगवान्काव्यश्चैव महातपाः।\nसहस्राक्षो महेन्द्रश्च तथा प्राचेतसो मनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2073467, "chapter_id": 2552, "verse_number": "१२-५७-३", "content_sanskrit": "भरद्वाजश्च भगवांस्तथा गौरशिरा मुनिः।\nराजशास्त्रप्रणेतारो ब्राह्मणा ब्रह्मवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2073468, "chapter_id": 2552, "verse_number": "१२-५७-४", "content_sanskrit": "रक्षामेव प्रशंसन्ति धर्मं धर्मभृतां वर।\nराज्ञां राजीवताम्राक्ष साधनं चात्र मे शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2073469, "chapter_id": 2552, "verse_number": "१२-५७-५", "content_sanskrit": "चारश्च प्रणिधिश्चैव काले दानममत्सरः।\nयुक्त्या दानं न चादानमयोगेन युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2073470, "chapter_id": 2552, "verse_number": "१२-५७-६", "content_sanskrit": "सतां संग्रहणं शौर्यं दाक्ष्यं सत्यं प्रजाहितम्।\nअनार्जवैरार्जवैश्च शत्रुपक्षाविवर्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2073471, "chapter_id": 2552, "verse_number": "१२-५७-७", "content_sanskrit": "केतनानां च जीर्णानामवेक्षा चैव सीदताम्।\nद्विविधस्य च दण्डस्य प्रयोगः कालचोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2073472, "chapter_id": 2552, "verse_number": "१२-५७-८", "content_sanskrit": "साधूनामपरित्यागः कुलीनानां च धारणम्।\nनिचयश्च निचेयानां सेवा बुद्धिमतामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2073473, "chapter_id": 2552, "verse_number": "१२-५७-९", "content_sanskrit": "बलानां हर्षणं नित्यं प्रजानामन्ववेक्षणम्।\nकार्येष्वखेदः कोशस्य तथैव च विवर्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2073474, "chapter_id": 2552, "verse_number": "१२-५७-१०", "content_sanskrit": "पुरगुप्तिरविश्वासः पौरसंघातभेदनम्।\nअरिमध्यस्थमित्राणां यथावच्चान्ववेक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2073475, "chapter_id": 2552, "verse_number": "१२-५७-११", "content_sanskrit": "उपजापश्च भृत्यानामात्मनः पुरदर्शनम्।\nअविश्वासः स्वयं चैव परस्याश्वासनं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2073476, "chapter_id": 2552, "verse_number": "१२-५७-१२", "content_sanskrit": "नीतिवर्त्मानुसारेण नित्यमुत्थानमेव च।\nरिपूणामनवज्ञानं नित्यं चानार्यवर्जनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2073477, "chapter_id": 2552, "verse_number": "१२-५७-१३", "content_sanskrit": "उत्थानं हि नरेन्द्राणां बृहस्पतिरभाषत।\nराजधर्मस्य यन्मूलं श्लोकांश्चात्र निबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2073478, "chapter_id": 2552, "verse_number": "१२-५७-१४", "content_sanskrit": "उत्थानेनामृतं लब्धमुत्थानेनासुरा हताः।\nउत्थानेन महेन्द्रेण श्रैष्ठ्यं प्राप्तं दिवीह च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2073479, "chapter_id": 2552, "verse_number": "१२-५७-१५", "content_sanskrit": "उत्थानधीरः पुरुषो वाग्धीरानधितिष्ठति।\nउत्थानवीरान्वाग्वीरा रमयन्त उपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2073480, "chapter_id": 2552, "verse_number": "१२-५७-१६", "content_sanskrit": "उत्थानहीनो राजा हि बुद्धिमानपि नित्यशः।\nप्रधर्षणीयः शत्रूणां भुजङ्ग इव निर्विषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2073481, "chapter_id": 2552, "verse_number": "१२-५७-१७", "content_sanskrit": "न च शत्रुरवज्ञेयो दुर्बलोऽपि बलीयसा।\nअल्पोऽपि हि दहत्यग्निर्विषमल्पं हिनस्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2073482, "chapter_id": 2552, "verse_number": "१२-५७-१८", "content_sanskrit": "एकाङ्गेनापि संभूतः शत्रुर्दुर्गमुपाश्रितः।\nसर्वं तापयते देशमपि राज्ञः समृद्धिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2073483, "chapter_id": 2552, "verse_number": "१२-५७-१९", "content_sanskrit": "राज्ञो रहस्यं यद्वाक्यं जयार्थे लोकसंग्रहः।\nहृदि यच्चास्य जिह्नं स्यात्कारणार्थं च यद्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2073484, "chapter_id": 2552, "verse_number": "१२-५७-२०", "content_sanskrit": "यच्चास्य कार्यं वृजिनं मार्दवेनैव धार्यते।\nरञ्जनार्थं च लोकस्य धर्मिष्ठामाचरेत्क्रियाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2073485, "chapter_id": 2552, "verse_number": "१२-५७-२१", "content_sanskrit": "राज्यं हि सुमहत्तत्र दुर्धार्यमकृतात्मभिः।\nन शक्यं मृदुना वोदुमाघातस्थानमुल्वणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2073486, "chapter_id": 2552, "verse_number": "१२-५७-२२", "content_sanskrit": "राज्यं सर्वामिषं नित्यमार्जवेनैव धार्यते।\nतस्मान्मिश्रेण सततं वर्तितव्यं युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2073487, "chapter_id": 2552, "verse_number": "१२-५७-२३", "content_sanskrit": "यद्यप्यस्य विपक्तिः स्याद्रक्षमाणस्य वै प्रजाः।\nसोप्यस्य विपुलो धर्म एवं वृत्ता हि भूमिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2073488, "chapter_id": 2552, "verse_number": "१२-५७-२४", "content_sanskrit": "एष ते राजधर्माणां लेशः समनुवर्णितः।\nभूयस्ते यत्र संदेहस्तद्ब्रूहि कुरुसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2073489, "chapter_id": 2552, "verse_number": "१२-५७-२५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2073490, "chapter_id": 2552, "verse_number": "१२-५७-२५", "content_sanskrit": "ततो व्यासश्च भगवान्देवस्थानोऽश्म एव च।\nवासुदेवः कृपश्चैव सात्यकिः सञ्जयस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2073491, "chapter_id": 2552, "verse_number": "१२-५७-२६", "content_sanskrit": "साधुसाध्विति संहृष्टा घुष्यमाणैरिवाननैः।\nअस्तुवंश्च नरव्याघ्रं भीष्मं धर्मभृतां वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2073492, "chapter_id": 2552, "verse_number": "१२-५७-२७", "content_sanskrit": "ततो दीनमना भीष्ममुवाच कुरुनन्दनः।\nनेत्राभ्यामश्रुपूर्णाभ्यां पादौ तस्य शनैः स्पृशन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2073493, "chapter_id": 2552, "verse_number": "१२-५७-२८", "content_sanskrit": "श्व इदानीं स्वसंदेहं प्रवक्ष्यामि पितामह।\nउपैति सविता ह्यस्तं रसमापीय पार्थिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2073494, "chapter_id": 2552, "verse_number": "१२-५७-२९", "content_sanskrit": "ततो द्विजातीनभिवाद्य केशवः।\nकृपश्च ते चैव युधिष्ठिरादयः।\nप्रदक्षिणीकृत्य महानदीसुतं\nततो रथानारुरुहुर्मुदान्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2073495, "chapter_id": 2552, "verse_number": "१२-५७-३०", "content_sanskrit": "दृषद्वतीं चाप्यवगाह्य सुव्रताः।\nकृतोदकार्थाः कृतजप्यमङ्गलाः।\nउपास्य संध्यां विधिवत्परंतपा\nस्ततः पुरं ते विविशुर्गजाह्वयम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2073496, "chapter_id": 2552, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि सप्तपञ्चाशोऽध्यायः॥ ५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]