[{"id": 2026310, "chapter_id": 1565, "verse_number": "३-२०३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2026311, "chapter_id": 1565, "verse_number": "३-२०३-१", "content_sanskrit": "श्रुत्वा स राजा राजर्षिरिन्द्रद्युम्नस्य तत्तदा।\nमार्कण्डेयान्महाभागात्स्वर्गस्य प्रतिपादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2026312, "chapter_id": 1565, "verse_number": "३-२०३-२", "content_sanskrit": "युधिष्ठिरो महाराज पुनः पप्रच्छ तं मुनिम्।\nकीदृशीषु ह्यवस्थासु दत्त्वा दानं महामुने।\nइन्द्रलोकं त्वनुभवेत्पुरुषस्तद्ब्रवीहि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2026313, "chapter_id": 1565, "verse_number": "३-२०३-३", "content_sanskrit": "गार्हस्थ्येऽप्यथवा बाल्ये यौवने स्थाविरेऽपि वा।\nयथा फलं समश्नाति तथा त्वं कथयस्व मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2026314, "chapter_id": 1565, "verse_number": "३-२०३-४x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2026315, "chapter_id": 1565, "verse_number": "३-२०३-४", "content_sanskrit": "वृथा जन्मानि चत्वारि वृथा दानानि षोडश।\nवृथा जन्म ह्यपुत्रस् ये च धर्मबहिष्कृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2026316, "chapter_id": 1565, "verse_number": "३-२०३-५", "content_sanskrit": "परपाकं च येऽश्नन्ति आत्मार्थं च पचेत्तु यः।\nपर्यश्नन्ति वृथा यत्र तदसत्यं प्रकीर्त्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2026317, "chapter_id": 1565, "verse_number": "३-२०३-६", "content_sanskrit": "आरूढपतिते दत्तमन्यायोपहृतं च यत्।\nव्यर्थं तु पतिते दानं ब्राह्मणे तस्करे तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2026318, "chapter_id": 1565, "verse_number": "३-२०३-७", "content_sanskrit": "गुरौ चानृतिके पापे कृतघ्ने ग्रामयाजके।\nवेदविक्रयिणे दत्तं तथा वृषलयाजके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2026319, "chapter_id": 1565, "verse_number": "३-२०३-८", "content_sanskrit": "ब्रह्मबन्धुषु यद्दत्तं यद्दत्तं वृषलीपतौ।\nस्त्रीजितेषु च यद्दत्तं व्यालग्राहे तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2026320, "chapter_id": 1565, "verse_number": "३-२०३-९", "content_sanskrit": "परिचारकेषु यद्दत्तं वृथा दानानि षोडश।\nतमोवृतस्तु यो दद्याद्भयात्क्रोधात्तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2026321, "chapter_id": 1565, "verse_number": "३-२०३-१०", "content_sanskrit": "भुङ्क्ते च दानं तत्सर्वं गर्भस्थस्तु नरः सदा।\nददद्दानं द्विजातिभ्यो वृद्धभावेन मानवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2026322, "chapter_id": 1565, "verse_number": "३-२०३-११", "content_sanskrit": "तस्मात्सर्वास्ववस्थासु सर्वदानानि पार्थिव।\nदातव्यानि द्विजातिभ्यः स्वर्गमार्गजिगीषया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2026323, "chapter_id": 1565, "verse_number": "३-२०३-१२x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2026324, "chapter_id": 1565, "verse_number": "३-२०३-१२", "content_sanskrit": "चातुर्वर्ण्यस्य सर्वस्य वर्तमानाः प्रतिग्रहे।\nकेन विप्रा विशेषेण तारयन्ति तरन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2026325, "chapter_id": 1565, "verse_number": "३-२०३-१३x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2026326, "chapter_id": 1565, "verse_number": "३-२०३-१३", "content_sanskrit": "जपैर्मन्त्रैश्च होमैश्च स्वाध्यायाध्यायनेन च।\nनावं वेदमयीं कृत्वातारयन्ति तरन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2026327, "chapter_id": 1565, "verse_number": "३-२०३-१४", "content_sanskrit": "ब्राह्मणांस्तोषयेद्यस्तु तुष्यन्ते तस्य देवताः।\nवचनाच्चापि विप्राणां स्वर्गलोकमवाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2026328, "chapter_id": 1565, "verse_number": "३-२०३-१५", "content_sanskrit": "अनन्तं पुण्यलोकं तु गन्ताऽसौ तु न संशयः।\nश्लेष्मादिभिर्व्याप्ततनुर्म्रियमाणोऽविचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2026329, "chapter_id": 1565, "verse_number": "३-२०३-१६", "content_sanskrit": "ब्राह्णा एव संपूज्याः पुण्यं स्वर्गमभीप्सता।\nश्राद्धकाले तु यत्नेन भोक्तव्या ह्यजुगुप्सिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2026330, "chapter_id": 1565, "verse_number": "३-२०३-१७", "content_sanskrit": "दुर्बलः कुनस्वी कुष्ठी मायावी कुण्डगोलकौ।\nवर्जनीयाः प्रयत्नेन काण्डपृष्ठाश्च देहिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2026331, "chapter_id": 1565, "verse_number": "३-२०३-१८", "content_sanskrit": "जुगुप्सितं हि यच्छ्राद्धं दहत्यग्निरिवेन्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2026332, "chapter_id": 1565, "verse_number": "३-२०३-१९", "content_sanskrit": "ये ये श्राद्धे न पूज्यन्ते मूकान्धबधिरादयः।\nतेऽपिसर्वे नियोक्तव्या मिश्रिता वेदपारगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2026333, "chapter_id": 1565, "verse_number": "३-२०३-२०", "content_sanskrit": "प्रतिग्रहश्च वै देयः शृणु यस् युधिष्ठिर।\nप्रदातारं तथाऽऽत्मानं यस्तारयति शक्तिमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2026334, "chapter_id": 1565, "verse_number": "३-२०३-२१", "content_sanskrit": "तस्मिन्देयं द्विजे दानं सर्वागमविजानता।\nप्रदातारं तथाऽऽत्मानं तारयेद्यः स शक्तिमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2026335, "chapter_id": 1565, "verse_number": "३-२०३-२२", "content_sanskrit": "न तथा हविषो होमैर्न पुष्पैर्नानुलेपनैः।\nअग्नयः पार्थ तुष्यन्ति यथा ह्यतिथिभोजने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2026336, "chapter_id": 1565, "verse_number": "३-२०३-२३", "content_sanskrit": "तस्मात्त्वंसर्वयत्नेन यतस्वातिथिभोजने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2026337, "chapter_id": 1565, "verse_number": "३-२०३-२४", "content_sanskrit": "पादोदकंपादघृतंदीपमन्नं प्रतिश्रयम्।\nप्रयच्छन्ति तु ये राजन्नोपसर्पन्ति ते यमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2026338, "chapter_id": 1565, "verse_number": "३-२०३-२५", "content_sanskrit": "देवमाल्यापनयनं द्विजोच्छिष्टावमार्जनम्।\nआकल्पपरिचर्या च गात्रसंवाहनानि च।\nअत्रैकैकं नृपश्रेष्ठ गोदानाद्व्यतिरिच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2026339, "chapter_id": 1565, "verse_number": "३-२०३-२६", "content_sanskrit": "कपिलायाः प्रदानात्तु मुच्यते नात्र संशयः।\nतस्मादलंकृतां दद्यात्कपिलां तु द्विजातये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2026340, "chapter_id": 1565, "verse_number": "३-२०३-२७", "content_sanskrit": "श्रोत्रियाय दरिद्राय गृहस्थायाग्निहोत्रिणे।\nपुत्रदाराभिभूताय तथा ह्यनुपकारिणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2026341, "chapter_id": 1565, "verse_number": "३-२०३-२८", "content_sanskrit": "एवंविधेषु दातव्या न समृद्धेषु भारत।\nको गुणो भरतश्रेष्ठ समृद्धेष्वभिवर्जितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2026342, "chapter_id": 1565, "verse_number": "३-२०३-२९", "content_sanskrit": "एकस्यैका प्रदातव्या न बहूनां कदाचन।\nसा गौर्विक्रयमापन्ना हन्यात्रिपुरुषं कुलम्।\nन तारयति दातारं ब्राह्मणं नैव नैव तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2026343, "chapter_id": 1565, "verse_number": "३-२०३-३०", "content_sanskrit": "ब्राह्मणस्य विशुद्धस्य सुवर्णं यः प्रयच्छति।\nसुवर्णानां शतं तेन दत्तं भवति शाश्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2026344, "chapter_id": 1565, "verse_number": "३-२०३-३१", "content_sanskrit": "अनड्वाहं तु यो दद्याद्बलवन्तं धुरंधरम्।\nस निस्तरति दुर्गाणि स्वर्गलोकं च गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2026345, "chapter_id": 1565, "verse_number": "३-२०३-३२", "content_sanskrit": "वसुंधरां तु यो दद्याद्द्विजाय विदुषात्मने।\nदातारं ह्यनुगच्छन्ति सर्वे कामाभिवाञ्छिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2026346, "chapter_id": 1565, "verse_number": "३-२०३-३३", "content_sanskrit": "पृच्छन्ति चान्नदातारं वदन्ति पुरुषा भुवि।\nअध्वनि क्षीणगात्राश्च पांसुना चावकुण्ठिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2026347, "chapter_id": 1565, "verse_number": "३-२०३-३४", "content_sanskrit": "तेषामेव श्रमार्तानां यो ह्यन्नं कथयेद्बुधः।\nअन्नदातृसमः सोपि कीर्त्यते नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2026348, "chapter_id": 1565, "verse_number": "३-२०३-३५", "content_sanskrit": "तस्मात्त्वं सर्वदानानि हित्वाऽन्नं संप्रयच्छ ह।\nन हीदृशं पुण्यफलं विचित्रामिह विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2026349, "chapter_id": 1565, "verse_number": "३-२०३-३६", "content_sanskrit": "यथाशक्ति च यो दद्यादन्नं विप्रेषु संस्कृतम्।\nस तेन कर्मणाऽऽप्नोति प्रजापतिसलोकताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2026350, "chapter_id": 1565, "verse_number": "३-२०३-३७", "content_sanskrit": "अन्नमेव विशिष्टं हि तस्मात्परतरं न च।\nअन्नं प्रजापतिश्चोक्तः स च संवत्सरो मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2026351, "chapter_id": 1565, "verse_number": "३-२०३-३८", "content_sanskrit": "संवत्सरस्तु यज्ञोऽसौ सर्वं यज्ञे प्रतिष्ठितम्।\nतस्मात्सर्वाणि भूतानि स्थावराणि चराणि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2026352, "chapter_id": 1565, "verse_number": "३-२०३-३९", "content_sanskrit": "तस्मादन्नं विशिष्टं हि सर्वेभ्यइति विश्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2026353, "chapter_id": 1565, "verse_number": "३-२०३-४०", "content_sanskrit": "येषां तटाकानि महोदकानि\nवाप्यश्चकूपाश्चप्रतिश्रयाश्च।\nअन्नस्य दानं मधुरा च वाणी\nयमस्य ते निर्वचना भवन्ति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2026354, "chapter_id": 1565, "verse_number": "३-२०३-४१", "content_sanskrit": "धान्यं श्रमेणार्जितवित्तसंचितं\nविप्रे सुशीले प्रतियच्छते यः।\nवसुंधरा तस्य भवेत्सुतुष्टा\nधारां वसूनां प्रतिमुञ्चतीव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2026355, "chapter_id": 1565, "verse_number": "३-२०३-४२", "content_sanskrit": "अन्नदाः प्रथमं यान्ति सत्यवाक्यदनन्तरम्।\nअयाचितप्रदाता च समं यान्ति त्रयो जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2026356, "chapter_id": 1565, "verse_number": "३-२०३-४३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2026357, "chapter_id": 1565, "verse_number": "३-२०३-४३", "content_sanskrit": "कौतूहलसमुत्पन्नः पर्यपृच्छद्युधिष्ठिरः।\nमार्कण्डेयं महात्मानं पुनरेव सहानुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2026358, "chapter_id": 1565, "verse_number": "३-२०३-४४", "content_sanskrit": "यमलोकस्य चाध्वानमन्तरं मानुषस्य च।\nकीदृशं किंप्रमाणं वा कथं वा तन्महामुने।\nतरन्ति पुरुषाश्चैव केनोपायेन शंस मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2026359, "chapter_id": 1565, "verse_number": "३-२०३-४५x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2026360, "chapter_id": 1565, "verse_number": "३-२०३-४५", "content_sanskrit": "सर्वगुह्यतनं प्रश्नं पवित्रमृषिसंस्तुतम्।\nकथयिष्यामि ते राजन्धर्मं धर्मभृतांवर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2026361, "chapter_id": 1565, "verse_number": "३-२०३-४६", "content_sanskrit": "षडशीतिसहस्राणि योजनानां नराधिप।\nयमलोकस्य चाध्वानमन्तरं मानुषस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2026362, "chapter_id": 1565, "verse_number": "३-२०३-४७", "content_sanskrit": "आकाशं तदपानीयं घोरं कान्तारदर्शनम्।\nन तत्र वृक्षच्छाया वा पानीनं केतनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2026363, "chapter_id": 1565, "verse_number": "३-२०३-४८", "content_sanskrit": "विश्रमेद्यत्र वै श्रान्तः पुरुषोऽध्वनि कर्शितः।\nनीयते यमदूतैस्तु यमस्वाज्ञाकरैर्बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2026364, "chapter_id": 1565, "verse_number": "३-२०३-४९", "content_sanskrit": "नराः स्त्रियस्तथैवान्ये पृथिव्यां जीवसंज्ञिताः।\nब्रह्मणेभ्यः प्रदानानि नानारूपाणि पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2026365, "chapter_id": 1565, "verse_number": "३-२०३-५०", "content_sanskrit": "हयादीनां प्रकृष्टानि तेऽध्वानं यान्ति वै नराः।\nसन्निवार्यातपं यानति च्छत्रेणैव हि च्छत्रदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2026366, "chapter_id": 1565, "verse_number": "३-२०३-५१", "content_sanskrit": "तृप्ताश्चैवान्नदातारो ह्यतृप्ताश्चाप्यनन्नदाः।\nवस्त्रिणो वस्त्रदा यान्ति अवस्त्रा यान्त्यवस्त्रदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2026367, "chapter_id": 1565, "verse_number": "३-२०३-५२", "content_sanskrit": "हिरण्यदाः सुखं यान्ति पुरुषास्त्वभ्यलंकृताः।\nभूमिदास्तुसुखं यान्ति सर्वैः कामैः सुतर्पिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2026368, "chapter_id": 1565, "verse_number": "३-२०३-५३", "content_sanskrit": "यान्ति चैवापरिक्लिष्टा नरा सस्यप्रदावकाः।\nनराः सुखतरं यान्ति विमानेषु गृहप्रदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2026369, "chapter_id": 1565, "verse_number": "३-२०३-५४", "content_sanskrit": "पानीयदा ह्यतृषिताः प्रहृष्टमनसो नराः।\nपन्थानं द्योतयन्तश्च यान्ति दीपप्रदाः सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2026370, "chapter_id": 1565, "verse_number": "३-२०३-५५", "content_sanskrit": "गोप्रदास्तु सुखं यान्ति निर्मुक्ताः सर्वपातकैः।\nविमानैर्हंससंयुक्तैर्यान्ति मासोपवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2026371, "chapter_id": 1565, "verse_number": "३-२०३-५६", "content_sanskrit": "तथा बर्हिप्रयुक्तैश्च षष्ठरात्रोपवासिनः।\nत्रिरात्रं क्षपते यस्तु एकभक्तेन पाण्डव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2026372, "chapter_id": 1565, "verse_number": "३-२०३-५७", "content_sanskrit": "अन्तरा चैव नाश्नाति तस्य लोका ह्यनामयाः।\nपानीयस्य गुणा दिव्याः प्रेतलोकसुखावहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2026373, "chapter_id": 1565, "verse_number": "३-२०३-५८", "content_sanskrit": "तत्र पुष्पोदका नाम नदी तेषां विधीयते।\nशीतलं सलिलं तत्रपिबन्ति ह्यमृतोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2026374, "chapter_id": 1565, "verse_number": "३-२०३-५९", "content_sanskrit": "ये चदृष्कृतकर्माणः पूयं तेषां विधीयते।\nएवं नदी महाराज सर्वकामप्रदा हि सा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2026375, "chapter_id": 1565, "verse_number": "३-२०३-६०", "content_sanskrit": "तस्मात्त्वमपि राजेन्द्र पूजयैनान्यथाविधि।\nअध्वनिं क्षीणगात्रश्च पथि पांशुसमन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2026376, "chapter_id": 1565, "verse_number": "३-२०३-६१", "content_sanskrit": "पृच्छते ह्यन्नदातारं गृहमायाति चाशया।\nतं पूजयाथ यत्नेन सोऽतिथिर्ब्राह्यणश्च सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2026377, "chapter_id": 1565, "verse_number": "३-२०३-६२", "content_sanskrit": "तं यान्तमनुगच्छन्ति देवाः सर्वे सवासवाः।\nतस्मिन्संपूजिते प्रीता निराशा यान्त्यपूजिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2026378, "chapter_id": 1565, "verse_number": "३-२०३-६३", "content_sanskrit": "तस्मात्त्वमपि राजेन्द्र पूजयैनं यथाविधि।\nएतत्ते शतशः प्रोक्तं किं भूयः श्रोतुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2026379, "chapter_id": 1565, "verse_number": "३-२०३-६४x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2026380, "chapter_id": 1565, "verse_number": "३-२०३-६४", "content_sanskrit": "पुनः पुनरहं श्रोतुं कथां धर्मसमाश्रयाम्।\nपुण्यामिच्छामि धर्मज्ञ कथ्यमानां त्वया विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2026381, "chapter_id": 1565, "verse_number": "३-२०३-६५x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2026382, "chapter_id": 1565, "verse_number": "३-२०३-६५", "content_sanskrit": "धर्मान्तरं प्रति कथां कथ्यमानां मया नृप।\nसर्वपापहरां नित्यं शृणुष्वावहितो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2026383, "chapter_id": 1565, "verse_number": "३-२०३-६६", "content_sanskrit": "कपिलायां तु दत्तायां यत्फलंज्येष्ठपुष्करे।\nतत्फलंभरतश्रेष्ठ विप्राणां पादधावने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2026384, "chapter_id": 1565, "verse_number": "३-२०३-६७", "content_sanskrit": "द्विजपादोदकक्लिन्ना यावत्तिष्ठति मेदिनी।\nतावत्पुष्करपर्णेन पिबन्ति पितरो जलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2026385, "chapter_id": 1565, "verse_number": "३-२०३-६८", "content_sanskrit": "स्वागतेनाग्नयस्तृप्ता आसनेन शतक्रतुः।\nपितरः पादशौचेन अन्नाद्येन प्रजापतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2026386, "chapter_id": 1565, "verse_number": "३-२०३-६९", "content_sanskrit": "यावद्वत्सस्य पादौ द्वौ शिरश्चैव प्रदृश्यते।\nतस्मिन्काले प्रदातव्या प्रयतेनान्तरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2026387, "chapter_id": 1565, "verse_number": "३-२०३-७०", "content_sanskrit": "अन्तरिक्षगतो वत्सो यावद्योन्यां प्रदृश्यते।\nतावद्गौः पृथिवी ज्ञेया यावद्गर्भं न मुञ्चति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2026388, "chapter_id": 1565, "verse_number": "३-२०३-७१", "content_sanskrit": "यावन्ति तस्यां रोमाणि वत्सस्य च युधिष्ठिर।\nतावद्युगसहस्राणि स्वर्लोके महीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2026389, "chapter_id": 1565, "verse_number": "३-२०३-७२", "content_sanskrit": "सुवर्णनासां यः कृत्वा सखुरां कृष्णधेनुकाम्।\nतिलैः प्रच्छादितां दद्यात्सर्वरत्नैरलंकृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2026390, "chapter_id": 1565, "verse_number": "३-२०३-७३", "content_sanskrit": "प्रतिग्रहं गृहीत्वा यः पुनर्ददति साधवे।\nफलानां फलमश्नाति तदा दत्त्वा च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2026391, "chapter_id": 1565, "verse_number": "३-२०३-७४", "content_sanskrit": "ससमुद्रगुहा तेन सशैलवनकानना।\nचतुरन्ता भवेद्दत्ता पृथिवी नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2026392, "chapter_id": 1565, "verse_number": "३-२०३-७५", "content_sanskrit": "अन्तर्जानुशयो यस्तु भुञ्जते सक्तभाजनः।\nयो द्विजः शब्दरहितं संयन्तुस्तारणाय वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2026393, "chapter_id": 1565, "verse_number": "३-२०३-७६", "content_sanskrit": "ये पानीयानि ददति तथाऽन्ये ये द्विजातयः।\nजपन्ति संहितां सम्यक्ते नित्यं तारणक्षमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2026394, "chapter_id": 1565, "verse_number": "३-२०३-७७", "content_sanskrit": "हव्यंकव्यं च यत्किंचित्सर्वं तच्छ्रोत्रियोऽर्हति।\nदत्तं हि श्रोत्रिये साधौज्यलितेऽग्नौ यथा हुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2026395, "chapter_id": 1565, "verse_number": "३-२०३-७८", "content_sanskrit": "मन्युप्रहरणा विप्रा न विप्राः शस्त्रयोधिनः।\nनिहन्युर्मन्युना विप्रा वज्रपाणिरिवासुरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2026396, "chapter_id": 1565, "verse_number": "३-२०३-७९", "content_sanskrit": "धर्माश्रितेयं तु कथा कथिता हि तवानघ।\nयां श्रुत्वा मुनयः प्रीता नैमिषारण्यवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2026397, "chapter_id": 1565, "verse_number": "३-२०३-८०", "content_sanskrit": "वीतशोकभयक्रोधा विपाप्मानस्तथैव च।\nश्रुत्वेमां तु कथां राजन्भवन्तीह तु मानवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2026398, "chapter_id": 1565, "verse_number": "३-२०३-८१x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2026399, "chapter_id": 1565, "verse_number": "३-२०३-८१", "content_sanskrit": "किं तच्छौचं भवेद्येन विप्रः शुद्धः सदा भवेत्।\nतदिच्छामि महाप्राज्ञ श्रोतुं धर्मभृतांवर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2026400, "chapter_id": 1565, "verse_number": "३-२०३-८२x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2026401, "chapter_id": 1565, "verse_number": "३-२०३-८२", "content_sanskrit": "वाक्शौचं क्रमशौचं च यच्च शौचं जलात्मकम्।\nत्रिभिः शौचैरुपेतो यः स स्वर्गी नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2026402, "chapter_id": 1565, "verse_number": "३-२०३-८३", "content_sanskrit": "सायं प्रातश्च संध्यां यो ब्राह्मणोऽभ्युपसेवते।\nप्रजपन्पावनीं देवीं गायत्रीं वेदमातरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2026403, "chapter_id": 1565, "verse_number": "३-२०३-८४", "content_sanskrit": "स तया पावितो देव्या ब्राह्मणो नष्टकिल्बिषः।\nन सीदेत्प्रतिगृह्णानो महीमपि ससागराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2026404, "chapter_id": 1565, "verse_number": "३-२०३-८५", "content_sanskrit": "ये चास् दारुणा केचिद्ग्रहाः सूर्यादयो दिवि।\nते चास्य सौम्या जायन्ते शिवाः शिवतराः सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2026405, "chapter_id": 1565, "verse_number": "३-२०३-८६", "content_sanskrit": "सर्वेनानुगतं चैनं दारुणाः पिशिताशनाः।\nघोररूपा महाकाया धर्षयन्ति द्विजोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2026406, "chapter_id": 1565, "verse_number": "३-२०३-८७", "content_sanskrit": "नाध्यापनाद्याजनाद्वा अन्यायाद्वा प्रतिग्रहात्।\nदोषो भवति विप्राणां ज्वलिताग्निससा द्विजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2026407, "chapter_id": 1565, "verse_number": "३-२०३-८८", "content_sanskrit": "दुर्वेदा वा सुवेदा वा प्राकृताः संस्कृतास्तथा।\nब्राह्मणा नावमन्तव्या भस्मच्छन्ना इवाग्नयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2026408, "chapter_id": 1565, "verse_number": "३-२०३-८९", "content_sanskrit": "यथा श्मशाने दीप्तौजाः पावको नैव दुष्यति।\nएवं विद्वानविद्वान्वा ब्राह्मणो दैवतं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2026409, "chapter_id": 1565, "verse_number": "३-२०३-९०", "content_sanskrit": "प्राकरैश्च पुरद्वारैः प्रासादैश्च पृथग्विधैः।\nनगराणि न शोभन्ते हीनानि ब्राह्मणोत्तमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2026410, "chapter_id": 1565, "verse_number": "३-२०३-९१", "content_sanskrit": "वेदाढ्ञा वृत्संपन्ना ज्ञानवन्तस्तपस्विनः।\nयत्रतिष्न्ति वै विप्रास्तन्नाम नगरं नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2026411, "chapter_id": 1565, "verse_number": "३-२०३-९२", "content_sanskrit": "व्रजे वाऽप्यथवाऽरण्ये यत्रसन्ति बहुश्रुताः।\nतत्तन्नगरमित्याहुः पार्थ तीर्थं च तद्भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2026412, "chapter_id": 1565, "verse_number": "३-२०३-९३", "content_sanskrit": "रक्षितारं च राजानं ब्राह्मणं च तपस्विनम्।\nअभिगम्याभिपूज्याथ सद्यः पापात्प्रमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2026413, "chapter_id": 1565, "verse_number": "३-२०३-९४", "content_sanskrit": "पुण्यतीर्थाभिषेकं च पवित्राणां च कीर्तनम्।\nसद्भिः संभाषणं चैव प्रशस्तं कीर्त्यते बुधैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2026414, "chapter_id": 1565, "verse_number": "३-२०३-९५", "content_sanskrit": "साधुसङ्गमपूतेन वाक्सुभाषितवारिणा।\nपवित्रीकृतमात्मानं सन्तो मन्न्ति नित्यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2026415, "chapter_id": 1565, "verse_number": "३-२०३-९६", "content_sanskrit": "त्रिदण्डधारणं मौनं जटाभारोऽथ मुण्डनम्।\nवल्कलाजिनसंवेष्टं व्रतचर्याऽभिषेचनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2026416, "chapter_id": 1565, "verse_number": "३-२०३-९७", "content_sanskrit": "अग्निहोत्रं वने वासः शरीरपरिशोषणम्।\nसर्वाण्येतानि मिथ्या स्युर्यदि भावो न निर्मलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2026417, "chapter_id": 1565, "verse_number": "३-२०३-९८", "content_sanskrit": "विशुद्धिं चक्षुरादीनां षण्णामिन्द्रियगामिनाम्।\nविकारि तेषां राजेन्द्र सुदुष्करतरं मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2026418, "chapter_id": 1565, "verse_number": "३-२०३-९९", "content_sanskrit": "ये पापानि न कुर्वन्ति मनोवाक्कर्मबुद्धिभिः।\nते तपन्ति महात्मानो न शरीरस्य शोषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2026419, "chapter_id": 1565, "verse_number": "३-२०३-१००", "content_sanskrit": "न ज्ञातिभ्यो दया यस्य शुक्लदेहोऽविकल्मषः।\nहिंसा सा तपसस्तस्य नानाशित्वं तपः स्मृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2026420, "chapter_id": 1565, "verse_number": "३-२०३-१०१", "content_sanskrit": "तिष्ठन्गृहे चैव मुनिर्नित्यं शुचिरलंकृतः।\nयावज्जीवं दयावांश् सर्वपापैः प्रमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2026421, "chapter_id": 1565, "verse_number": "३-२०३-१०२", "content_sanskrit": "न हि पापानि कर्माणि शुद्ध्यन्त्यनशनादिभिः।\nसीदत्यनशनादेव मांसशोणितलेपनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2026422, "chapter_id": 1565, "verse_number": "३-२०३-१०३", "content_sanskrit": "अज्ञातं कर्म कृत्वा च क्लेशो नान्यत्प्रहीयते।\nनाग्निर्दहति कर्माणि भावशून्यस्य देहिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2026423, "chapter_id": 1565, "verse_number": "३-२०३-१०४", "content_sanskrit": "पुण्यादेव प्रव्रजन्ति शुध्यन्त्यनशनानि च।\nन मूलफलभक्षित्वान्न मौनान्नानिलाशनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2026424, "chapter_id": 1565, "verse_number": "३-२०३-१०५", "content_sanskrit": "शिरसो मुण्डनाद्वाऽपि न स्थानकुटिकासनात्।\nन जटाधारणाद्वाऽपिन तु स्थानकुटिकासनात्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2026425, "chapter_id": 1565, "verse_number": "३-२०३-१०६", "content_sanskrit": "नित्यं ह्यनशनाद्वाऽपि नाग्निशुश्रूषणादपि।\nन चोदकप्रवेशेन न च क्ष्माशयनादपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2026426, "chapter_id": 1565, "verse_number": "३-२०३-१०७", "content_sanskrit": "ज्ञानेन कर्मणा वापि जरामरणमेव च।\nव्याधयश्च प्रहीयन्ते प्राप्यते चोत्तमं पदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2026427, "chapter_id": 1565, "verse_number": "३-२०३-१०८", "content_sanskrit": "बीजानि ह्यग्निदग्धानि न रोहन्ति पुनर्यथा।\nज्ञानदग्धैस्तधा क्लेशैर्नात्मा संडुज्यते पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2026428, "chapter_id": 1565, "verse_number": "३-२०३-१०९", "content_sanskrit": "आत्मना विप्रहीणानि काष्ठकुण्ठोपमानि च।\nविनश्यन्ति न संदेहः फेनानीव महार्णवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2026429, "chapter_id": 1565, "verse_number": "३-२०३-११०", "content_sanskrit": "आत्मानं विन्दते येन सर्वभूतगुहाशयम्।\nश्लोकेन यदि वाऽर्धेन क्षीणं तस्य प्रयोजनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2026430, "chapter_id": 1565, "verse_number": "३-२०३-१११", "content_sanskrit": "द्व्यक्षरादभिसंधाय केचिच्छ्लोकपदाङ्कितैः।\nशतैरन्यैः सहस्रैश्च प्रत्ययो मोक्षलक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2026431, "chapter_id": 1565, "verse_number": "३-२०३-११२", "content_sanskrit": "नायं लोकोस्ति न परो न सुखं संशयात्मनः।\nऊटुर्ज्ञानविदो वृद्धाः प्रत्ययो मोक्षलक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2026432, "chapter_id": 1565, "verse_number": "३-२०३-११३", "content_sanskrit": "विदितार्थस्तु वेदानां परिवेद प्रयोजनम्।\nउद्विजेत्स तु देवेभ्यो दावाग्नेरिव मानवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2026433, "chapter_id": 1565, "verse_number": "३-२०३-११४", "content_sanskrit": "शुष्कं तर्कं परित्यज्यआश्रयस्व श्रुतिं स्मृतिम्।\nएकाराभिसंबद्धं तत्त्वं हेतुभिरिच्छसि।\nबुद्धिर्न तस्य सिद्ध्येत साधनस्य विपर्ययात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2026434, "chapter_id": 1565, "verse_number": "३-२०३-११५", "content_sanskrit": "वेद्यं पूर्वं वेदितव्यं प्रयत्ना-\nत्तद्धीर्वेदस्तस्य वेदः शरीरम्।\nवेदस्तत्त्वं तत्समासोपलब्धिः\nक्लीबस्त्वात्मा न स वेद्यं न वेदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2026435, "chapter_id": 1565, "verse_number": "३-२०३-११६", "content_sanskrit": "वेदोक्तमायुर्देवानामाशिषश्चैव कर्मणाम्।\nफलत्यनुयुगं लोके प्रभावश्च शरीरिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2026436, "chapter_id": 1565, "verse_number": "३-२०३-११७", "content_sanskrit": "इन्द्रियाणां प्रसादेन तदेतत्परिवर्जयेत्।\nतस्मादनशनं दिव्यं निरुद्धेन्द्रियगोचरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2026437, "chapter_id": 1565, "verse_number": "३-२०३-११८", "content_sanskrit": "तपसा स्वर्गगमनं भोगो दानेन जायते।\nज्ञानेन मोक्षो विज्ञेयस्तीर्थस्नानादघक्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2026438, "chapter_id": 1565, "verse_number": "३-२०३-११९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2026439, "chapter_id": 1565, "verse_number": "३-२०३-११९", "content_sanskrit": "एवमुक्तस्तु राजेन्द्र प्रत्युवाच महायशाः।\nभगवञ्श्रोतुमिच्छामि प्रदानविधिमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2026440, "chapter_id": 1565, "verse_number": "३-२०३-१२०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2026441, "chapter_id": 1565, "verse_number": "३-२०३-१२०", "content_sanskrit": "यत्तत्पृच्छसि राजेन्द्रदानधर्मं युधिष्ठिर।\nइष्टं चेदं सदा मह्यं राजन्गौरवतस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2026442, "chapter_id": 1565, "verse_number": "३-२०३-१२१", "content_sanskrit": "शृणु दानरहस्यानि श्रुतिस्मृत्युदितानि च।\nछायायां करिणः श्राद्धं तत्कर्म परिवीजितम्।\nदशकल्पायुतानीह न क्षीयेत युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2026443, "chapter_id": 1565, "verse_number": "३-२०३-१२२", "content_sanskrit": "जीवनाय समाक्लिन्नं वसु दत्त्वा महीपते।\nविप्रं तु वासयेद्यस्तु सर्वयज्ञैः स इष्टवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2026444, "chapter_id": 1565, "verse_number": "३-२०३-१२३", "content_sanskrit": "प्रतिस्रोतश्चित्रवाहाः पर्जन्योऽन्नानुसंचरन्।\nमहाधुरि यथा नावा महापापैः प्रमुच्यते।\nविषुवे विप्रदत्तानि दधिमध्वक्षयाणि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2026445, "chapter_id": 1565, "verse_number": "३-२०३-१२४", "content_sanskrit": "पर्वसु द्विगुणं दानमृतौ दशगुणं भवेत्। ३-२०३-b१२४ `अब्दे दशगुणं प्रोक्तमनन्तं विषुवे भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2026446, "chapter_id": 1565, "verse_number": "३-२०३-१२५", "content_sanskrit": "अयने विषुवे चैवषडशीतिमुखेषु च।\nचन्द्रसूर्योपरागे च दत्तमक्षयमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2026447, "chapter_id": 1565, "verse_number": "३-२०३-१२६", "content_sanskrit": "ऋतुषु दशगुणं वदन्ति दत्तं\nशतगुणमृत्वयनादिषु ध्रुवम्।\nभवति सहस्रगुणं दिनस्य राहो-\nर्विषुवति चाक्षयमश्नुते फलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2026448, "chapter_id": 1565, "verse_number": "३-२०३-१२७", "content_sanskrit": "नाभूमिदो भूमिमश्नाति राज-\nन्नायानदो यानमारुह्य याति।\nयान्यान्कामान्ब्राह्मणेभ्यो ददाति\nतांस्तान्कामाञ्जायमानः स भुङ्क्ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2026449, "chapter_id": 1565, "verse_number": "३-२०३-१२८", "content_sanskrit": "अग्नेरपत्यं प्रथमं सुवर्णं\nभूर्वैष्णवी सूर्यसुताश्च गावः।\nलोकाश्त्रयस्तेन भवन्ति दत्ता\nयः काञ्चनं गाश्च महीं च दद्यात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 2026450, "chapter_id": 1565, "verse_number": "३-२०३-१२९", "content_sanskrit": "परंहि दानान्न बभूव शाश्वतं\nभव्यं त्रिलोके भवते कुतः पुनः।\nतस्मात्प्रधानं परमं हि दानं\nवदन्ति लोकेषु विशिष्टबुद्धयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 2026451, "chapter_id": 1565, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि त्र्यधिकद्विशततमोऽध्यायः ॥ २०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}]