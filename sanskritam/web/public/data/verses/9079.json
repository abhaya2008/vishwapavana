[{"id": 5000079000, "chapter_id": 9079, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे द्वितीयः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000079001, "chapter_id": 9079, "verse_number": "२-२-१", "content_sanskrit": "ततः परिषदं सर्वामामन्त्र्य वसुधाधिपः।\nहितमुद्धर्षणं चैवमुवाच प्रथितं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000079002, "chapter_id": 9079, "verse_number": "२-२-२", "content_sanskrit": "दुन्दुभिस्वरकल्पेन गम्भीरेणानुनादिना।\nस्वरेण महता राजा जीमूत इव नादयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000079003, "chapter_id": 9079, "verse_number": "२-२-३", "content_sanskrit": "राजलक्षणयुक्तेन कान्तेनानुपमेन च।\nउवाच रसयुक्तेन स्वरेण नृपतिर्नृपान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000079004, "chapter_id": 9079, "verse_number": "२-२-४", "content_sanskrit": "विदितं भवतामेतद् यथा मे राज्यमुत्तमम्।\nपूर्वकैर्मम राजेन्द्रैः सुतवत् परिपालितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000079005, "chapter_id": 9079, "verse_number": "२-२-५", "content_sanskrit": "सोऽहमिक्ष्वाकुभिः सर्वैर्नरेन्द्रैः प्रतिपालितम्।\nश्रेयसा योक्तुमिच्छामि सुखार्हमखिलं जगत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000079006, "chapter_id": 9079, "verse_number": "२-२-६", "content_sanskrit": "मयाप्याचरितं पूर्वैः पन्थानमनुगच्छता।\nप्रजा नित्यमनिद्रेण यथाशक्त्यभिरक्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000079007, "chapter_id": 9079, "verse_number": "२-२-७", "content_sanskrit": "इदं शरीरं कृत्स्नस्य लोकस्य चरता हितम्।\nपाण्डुरस्यातपत्रस्य च्छायायां जरितं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000079008, "chapter_id": 9079, "verse_number": "२-२-८", "content_sanskrit": "प्राप्य वर्षसहस्राणि बहून्यायूंषि जीवतः।\nजीर्णस्यास्य शरीरस्य विश्रान्तिमभिरोचये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000079009, "chapter_id": 9079, "verse_number": "२-२-९", "content_sanskrit": "राजप्रभावजुष्टां च दुर्वहामजितेन्द्रियैः।\nपरिश्रान्तोऽस्मि लोकस्य गुर्वीं धर्मधुरं वहन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000079010, "chapter_id": 9079, "verse_number": "२-२-१०", "content_sanskrit": "सोऽहं विश्राममिच्छामि पुत्रं कृत्वा प्रजाहिते।\nसंनिकृष्टानिमान् सर्वाननुमान्य द्विजर्षभान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000079011, "chapter_id": 9079, "verse_number": "२-२-११", "content_sanskrit": "अनुजातो हि मां सर्वैर्गुणैः श्रेष्ठो ममात्मजः।\nपुरन्दरसमो वीर्ये रामः परपुरंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000079012, "chapter_id": 9079, "verse_number": "२-२-१२", "content_sanskrit": "तं चन्द्रमिव पुष्येण युक्तं धर्मभृतां वरम्।\nयौवराज्ये नियोक्तास्मि प्रातः पुरुषपुङ्गवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000079013, "chapter_id": 9079, "verse_number": "२-२-१३", "content_sanskrit": "अनुरूपः स वो नाथो लक्ष्मीवाँल्लक्ष्मणाग्रजः।\nत्रैलोक्यमपि नाथेन येन स्यान्नाथवत्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000079014, "chapter_id": 9079, "verse_number": "२-२-१४", "content_sanskrit": "अनेन श्रेयसा सद्यः संयोक्ष्येऽहमिमां महीम्।\nगतक्लेशो भविष्यामि सुते तस्मिन् निवेश्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000079015, "chapter_id": 9079, "verse_number": "२-२-१५", "content_sanskrit": "यदिदं मेऽनुरूपार्थं मया साधु सुमन्त्रितम्।\nभवन्तो मेऽनुमन्यन्तां कथं वा करवाण्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000079016, "chapter_id": 9079, "verse_number": "२-२-१६", "content_sanskrit": "यद्यप्येषा मम प्रीतिर्हितमन्यद् विचिन्त्यताम्।\nअन्या मध्यस्थचिन्ता तु विमर्दाभ्यधिकोदया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000079017, "chapter_id": 9079, "verse_number": "२-२-१७", "content_sanskrit": "इति ब्रुवन्तं मुदिताः प्रत्यनन्दन् नृपा नृपम्।\nवृष्टिमन्तं महामेघं नर्दन्त इव बर्हिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000079018, "chapter_id": 9079, "verse_number": "२-२-१८", "content_sanskrit": "स्निग्धोऽनुनादः संजज्ञे ततो हर्षसमीरितः।\nजनौघोद‍्घुष्टसंनादो मेदिनीं कम्पयन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000079019, "chapter_id": 9079, "verse_number": "२-२-१९", "content_sanskrit": "तस्य धर्मार्थविदुषो भावमाज्ञाय सर्वशः।\nब्राह्मणा बलमुख्याश्च पौरजानपदैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000079020, "chapter_id": 9079, "verse_number": "२-२-२०", "content_sanskrit": "समेत्य ते मन्त्रयितुं समतागतबुद्धयः।\nऊचुश्च मनसा ज्ञात्वा वृद्धं दशरथं नृपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000079021, "chapter_id": 9079, "verse_number": "२-२-२१", "content_sanskrit": "अनेकवर्षसाहस्रो वृद्धस्त्वमसि पार्थिव।\nस रामं युवराजानमभिषिञ्चस्व पार्थिवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000079022, "chapter_id": 9079, "verse_number": "२-२-२२", "content_sanskrit": "इच्छामो हि महाबाहुं रघुवीरं महाबलम्।\nगजेन महता यान्तं रामं छत्रावृताननम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000079023, "chapter_id": 9079, "verse_number": "२-२-२३", "content_sanskrit": "इति तद्वचनं श्रुत्वा राजा तेषां मनःप्रियम्।\nअजानन्निव जिज्ञासुरिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000079024, "chapter_id": 9079, "verse_number": "२-२-२४", "content_sanskrit": "श्रुत्वैतद् वचनं यन्मे राघवं पतिमिच्छथ।\nराजानः संशयोऽयं मे तदिदं ब्रूत तत्त्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000079025, "chapter_id": 9079, "verse_number": "२-२-२५", "content_sanskrit": "कथं नु मयि धर्मेण पृथिवीमनुशासति।\nभवन्तो द्रष्टुमिच्छन्ति युवराजं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000079026, "chapter_id": 9079, "verse_number": "२-२-२६", "content_sanskrit": "ते तमूचुर्महात्मानः पौरजानपदैः सह।\nबहवो नृप कल्याणगुणाः सन्ति सुतस्य ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000079027, "chapter_id": 9079, "verse_number": "२-२-२७", "content_sanskrit": "गुणान् गुणवतो देव देवकल्पस्य धीमतः।\nप्रियानानन्दनान् कृत्स्नान् प्रवक्ष्यामोऽद्य तान्शृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000079028, "chapter_id": 9079, "verse_number": "२-२-२८", "content_sanskrit": "दिव्यैर्गुणैः शक्रसमो रामः सत्यपराक्रमः।\nइक्ष्वाकुभ्योऽपि सर्वेभ्यो ह्यतिरिक्तो विशाम्पते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000079029, "chapter_id": 9079, "verse_number": "२-२-२९", "content_sanskrit": "रामः सत्पुरुषो लोके सत्यः सत्यपरायणः।\nसाक्षाद् रामाद् विनिर्वृत्तो धर्मश्चापि श्रिया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000079030, "chapter_id": 9079, "verse_number": "२-२-३०", "content_sanskrit": "प्रजासुखत्वे चन्द्रस्य वसुधायाः क्षमागुणैः।\nबुद‍्ध्या बृहस्पतेस्तुल्यो वीर्ये साक्षाच्छचीपतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000079031, "chapter_id": 9079, "verse_number": "२-२-३१", "content_sanskrit": "धर्मज्ञः सत्यसंधश्च शीलवाननसूयकः।\nक्षान्तः सान्त्वयिता श्लक्ष्णः कृतज्ञो विजितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000079032, "chapter_id": 9079, "verse_number": "२-२-३२", "content_sanskrit": "मृदुश्च स्थिरचित्तश्च सदा भव्योऽनसूयकः।\nप्रियवादी च भूतानां सत्यवादी च राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000079033, "chapter_id": 9079, "verse_number": "२-२-३३", "content_sanskrit": "बहुश्रुतानां वृद्धानां ब्राह्मणानामुपासिता।\nतेनास्येहातुला कीर्तिर्यशस्तेजश्च वर्धते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000079034, "chapter_id": 9079, "verse_number": "२-२-३४", "content_sanskrit": "देवासुरमनुष्याणां सर्वास्त्रेषु विशारदः।\nसम्यग् विद्याव्रतस्नातो यथावत् साङ्गवेदवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000079035, "chapter_id": 9079, "verse_number": "२-२-३५", "content_sanskrit": "गान्धर्वे च भुवि श्रेष्ठो बभूव भरताग्रजः।\nकल्याणाभिजनः साधुरदीनात्मा महामतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000079036, "chapter_id": 9079, "verse_number": "२-२-३६", "content_sanskrit": "द्विजैरभिविनीतश्च श्रेष्ठैर्धर्मार्थनैपुणैः।\nयदा व्रजति संग्रामं ग्रामार्थे नगरस्य वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000079037, "chapter_id": 9079, "verse_number": "२-२-३७", "content_sanskrit": "गत्वा सौमित्रिसहितो नाविजित्य निवर्तते।\nसंग्रामात् पुनरागत्य कुञ्जरेण रथेन वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000079038, "chapter_id": 9079, "verse_number": "२-२-३८", "content_sanskrit": "पौरान् स्वजनवन्नित्यं कुशलं परिपृच्छति।\nपुत्रेष्वग्निषु दारेषु प्रेष्यशिष्यगणेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000079039, "chapter_id": 9079, "verse_number": "२-२-३९", "content_sanskrit": "निखिलेनानुपूर्व्या च पिता पुत्रानिवौरसान्।\nशुश्रूषन्ते च वः शिष्याः कच्चिद् वर्मसु दंशिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000079040, "chapter_id": 9079, "verse_number": "२-२-४०", "content_sanskrit": "इति वः पुरुषव्याघ्रः सदा रामोऽभिभाषते।\nव्यसनेषु मनुष्याणां भृशं भवति दुःखितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000079041, "chapter_id": 9079, "verse_number": "२-२-४१", "content_sanskrit": "उत्सवेषु च सर्वेषु पितेव परितुष्यति।\nसत्यवादी महेष्वासो वृद्धसेवी जितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000079042, "chapter_id": 9079, "verse_number": "२-२-४२", "content_sanskrit": "स्मितपूर्वाभिभाषी च धर्मं सर्वात्मनाश्रितः।\nसम्यग्योक्ता श्रेयसां च न विगृह्यकथारुचिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000079043, "chapter_id": 9079, "verse_number": "२-२-४३", "content_sanskrit": "उत्तरोत्तरयुक्तौ च वक्ता वाचस्पतिर्यथा।\nसुभ्रूरायतताम्राक्षः साक्षाद् विष्णुरिव स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000079044, "chapter_id": 9079, "verse_number": "२-२-४४", "content_sanskrit": "रामो लोकाभिरामोऽयं शौर्यवीर्यपराक्रमैः।\nप्रजापालनसंयुक्तो न रागोपहतेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000079045, "chapter_id": 9079, "verse_number": "२-२-४५", "content_sanskrit": "शक्तस्त्रैलोक्यमप्येष भोक्तुं किं नु महीमिमाम्।\nनास्य क्रोधः प्रसादश्च निरर्थोऽस्ति कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000079046, "chapter_id": 9079, "verse_number": "२-२-४६", "content_sanskrit": "हन्त्येष नियमाद् वध्यानवध्येषु न कुप्यति।\nयुनक्त्यर्थैः प्रहृष्टश्च तमसौ यत्र तुष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000079047, "chapter_id": 9079, "verse_number": "२-२-४७", "content_sanskrit": "दान्तैः सर्वप्रजाकान्तैः प्रीतिसंजननैर्नृणाम्।\nगुणैर्विरोचते रामो दीप्तः सूर्य इवांशुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000079048, "chapter_id": 9079, "verse_number": "२-२-४८", "content_sanskrit": "तमेवंगुणसम्पन्नं रामं सत्यपराक्रमम्।\nलोकपालोपमं नाथमकामयत मेदिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000079049, "chapter_id": 9079, "verse_number": "२-२-४९", "content_sanskrit": "वत्सः श्रेयसि जातस्ते दिष्ट्यासौ तव राघवः।\nदिष्ट्या पुत्रगुणैर्युक्तो मारीच इव कश्यपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000079050, "chapter_id": 9079, "verse_number": "२-२-५०", "content_sanskrit": "बलमारोग्यमायुश्च रामस्य विदितात्मनः।\nदेवासुरमनुष्येषु सगन्धर्वोरगेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000079051, "chapter_id": 9079, "verse_number": "२-२-५१", "content_sanskrit": "आशंसते जनः सर्वो राष्ट्रे पुरवरे तथा।\nआभ्यन्तरश्च बाह्यश्च पौरजानपदो जनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000079052, "chapter_id": 9079, "verse_number": "२-२-५२", "content_sanskrit": "स्त्रियो वृद्धास्तरुण्यश्च सायं प्रातः समाहिताः।\nसर्वा देवान्नमस्यन्ति रामस्यार्थे मनस्विनः।\nतेषां तद् याचितं देव त्वत्प्रसादात्समृद्ध्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000079053, "chapter_id": 9079, "verse_number": "२-२-५३", "content_sanskrit": "राममिन्दीवरश्यामं सर्वशत्रुनिबर्हणम्।\nपश्यामो यौवराज्यस्थं तव राजोत्तमात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000079054, "chapter_id": 9079, "verse_number": "२-२-५४", "content_sanskrit": "तं देवदेवोपममात्मजं ते\nसर्वस्य लोकस्य हिते निविष्टम्।\nहिताय नः क्षिप्रमुदारजुष्टं\nमुदाभिषेक्तुं वरद त्वमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000079055, "chapter_id": 9079, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे द्वितीयः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]