[{"id": 2198600, "chapter_id": 5224, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2198601, "chapter_id": 5224, "verse_number": "१", "content_sanskrit": "कन्यायाः प्राप्तशुल्कायाः पतिश्चेन्नास्ति कश्चन ।\nतत्र का प्रतिपत्तिः स्यात् तन्मे ब्रूहि पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2198602, "chapter_id": 5224, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2198603, "chapter_id": 5224, "verse_number": "३", "content_sanskrit": "या पुत्रकस्याप्यरिक्थस्य प्रतिपत्सा तदा भवेत् ।\nअथ चेत् साहरेच्छुल्कं क्रीता शुल्कप्रदस्य सा ।\nतस्यार्थेऽपत्यमीहेत येन न्यायेन शक्नुयात्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2198604, "chapter_id": 5224, "verse_number": "४", "content_sanskrit": "न तस्या मन्त्रवत् कार्यं कश्चित् कुर्वीत किञ्चन\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2198605, "chapter_id": 5224, "verse_number": "५", "content_sanskrit": "स्वयं वृतेति सावित्री पित्रा वै प्रत्यपद्यत ।\nतत् तस्यान्ये प्रशंसन्ति धर्मज्ञा नेतरे जनाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2198606, "chapter_id": 5224, "verse_number": "६", "content_sanskrit": "एतत्तु नापरे चक्रुर्न परे जातु साधवः ।\nसाधूनां पुनराचारो गरीयो धर्मलक्षणम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2198607, "chapter_id": 5224, "verse_number": "७", "content_sanskrit": "अस्मिन्नेव प्रकरणे सुक्रतुर्वाक्यमब्रवीत् ।\nनप्ता विदेहराजस्य जनकस्य महात्मनः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2198608, "chapter_id": 5224, "verse_number": "८", "content_sanskrit": "असदाचरिते मार्गे कथं स्यादनुकीर्तनम् ।\nअनुप्रश्नः संशयो वा सतामेतदुपालभेत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2198609, "chapter_id": 5224, "verse_number": "९", "content_sanskrit": "असदेव हि धर्मस्य प्रमादो धर्म आसुरः ।\nनानुशुश्रुम जात्वेतामिमां पूर्वेषु जन्मसु\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2198610, "chapter_id": 5224, "verse_number": "१०", "content_sanskrit": "भार्यापत्योर्हि सम्बन्धः स्त्रीपुंसोस्तुल्य एव सः ।\nरतिः साधारणो धर्म इति चाह स पार्थिवः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2198611, "chapter_id": 5224, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2198612, "chapter_id": 5224, "verse_number": "११", "content_sanskrit": "अथ केन प्रमाणेन पुंसामादीयते धनम् ।\nपुत्रवद्धि पितुस्तस्य कन्या भवितुमर्हति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2198613, "chapter_id": 5224, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2198614, "chapter_id": 5224, "verse_number": "१२", "content_sanskrit": "यथैवात्मा तथा पुत्रः पुत्रेण दुहिता समा ।\nतस्यामात्मनि तिष्ठन्त्यां कथमन्यो धनं हरेत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2198615, "chapter_id": 5224, "verse_number": "१३", "content_sanskrit": "मातुश्च यौतकं यत् स्यात् कुमारीभाग एव सः ।\nदौहित्र एव वा रिक्थमपुत्रस्य पितुर्हरेत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2198616, "chapter_id": 5224, "verse_number": "१४", "content_sanskrit": "ददाति हि स पिण्डं वै पितुर्मातामहस्य च ।\nपुत्रदौहित्रयोर्नेह विशेषो धर्मतः स्मृतः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2198617, "chapter_id": 5224, "verse_number": "१५", "content_sanskrit": "अन्यत्र जातया सा हि प्रजया पुत्र ईहते ।\nदुहिताऽन्यत्र जातेन पुत्रेणापि विशिष्यते\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2198618, "chapter_id": 5224, "verse_number": "१६", "content_sanskrit": "दौहित्रकेण धर्मेण नात्र पश्यामि कारणम् ।\nविक्रीतासु च ये पुत्रा भवन्ति पितुरेव ते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2198619, "chapter_id": 5224, "verse_number": "१७", "content_sanskrit": "असूयवस्त्वधर्मिष्ठाः परस्वादायिनः शठाः ।\nआसुरादधिसम्भूता धर्माद् विषमवृत्तयः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2198620, "chapter_id": 5224, "verse_number": "१८", "content_sanskrit": "अत्र गाथा यमोद्गीताः कीर्तयन्ति पुराविदः ।\nधर्मज्ञा धर्मशास्त्रेषु निबद्धा धर्मसेतुषु\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2198621, "chapter_id": 5224, "verse_number": "१९", "content_sanskrit": "यो मनुष्यः स्वकं पुत्रं विक्रीय धनमिच्छति ।\nकन्यां वा जीवितार्थाय यः शुल्केन प्रयच्छति\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2198622, "chapter_id": 5224, "verse_number": "२०", "content_sanskrit": "सप्तावरे महाघोरे निरये कालसाह्वये ।\nस्वेदं मूत्रं पुरीषं च तस्मिन् प्रेत उपाश्नुते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2198623, "chapter_id": 5224, "verse_number": "२१", "content_sanskrit": "आर्षे गोमिथुनं शुल्कं केचिदाहुर्मृषैव तत् ।\nअल्पं वा बहु वा राजन् विक्रयस्तावदेव सः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2198624, "chapter_id": 5224, "verse_number": "२२", "content_sanskrit": "यद्यप्याचरितः कैश्चिन्नैष धर्मः कथञ्चन ।\nअन्येषामपि दृश्यन्ते लोभतः सम्प्रवृत्तयः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2198625, "chapter_id": 5224, "verse_number": "२३", "content_sanskrit": "वश्यां कुमारीं विहितां ये च तामुपभुञ्जते ।\nएते पापस्य कर्तारस्तमस्यन्धेऽथ शेरते\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2198626, "chapter_id": 5224, "verse_number": "२४", "content_sanskrit": "अन्योऽप्यथ न विक्रेयो मनुष्यः किं पुनः प्रजाः ।\nअधर्ममूलैर्हि धनैर्न तैरर्थोऽस्ति कश्चन\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2198627, "chapter_id": 5224, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nअनुशासनपर्वणि दानधर्मे कन्यादानधर्मकथनं नाम पञ्चसप्ततितमोऽध्यायः ॥७५॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]