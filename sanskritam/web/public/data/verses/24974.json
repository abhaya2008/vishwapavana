[{"id": 7004974000, "chapter_id": 24974, "verse_number": "७-१-१५७-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि सत्यभामेश्वरं शुभम् ।\nरत्नेश्वराद्दक्षिणे तु धनुषांतरमास्थितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004974001, "chapter_id": 24974, "verse_number": "७-१-१५७-२", "content_sanskrit": "सर्वपापप्रशमनं स्थापितं सत्यभामया ।\nकृष्णस्य कान्तया देवि रूपौदार्यसमेतया ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004974002, "chapter_id": 24974, "verse_number": "७-१-१५७-३", "content_sanskrit": "स्नात्वा तद्वैष्णवं स्थानं नृणां पातकनाशनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004974003, "chapter_id": 24974, "verse_number": "७-१-१५७-४", "content_sanskrit": "माघे मासि तृतीयायां नारी वा पुरुषोऽपि वा ।\nयस्तं पूजयते भक्त्या स मुक्तः पातकैर्भवेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004974004, "chapter_id": 24974, "verse_number": "७-१-१५७-५", "content_sanskrit": "दौर्भाग्यदुःखशोकेभ्यस्तथा विघ्नैश्च दुःखितः ।\nमुच्यते नात्र संदेहः सत्यभामान्वितो भवेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004974005, "chapter_id": 24974, "verse_number": "७-१-१५७-६", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये सत्यभामेश्वरमाहात्म्यवर्णनंनाम सप्तपञ्चाशदुत्तरशततमोऽध्यायः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]