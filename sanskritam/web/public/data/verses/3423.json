[{"id": 2112380, "chapter_id": 3423, "verse_number": "", "content_sanskrit": "अम्बा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2112381, "chapter_id": 3423, "verse_number": "१", "content_sanskrit": "अन्यपूर्वेति मां पापो नाभिनन्दति बालिशः ।\nसाऽहं धर्माच्च कामाच्च विहीना शोकधारिणी \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2112382, "chapter_id": 3423, "verse_number": "३", "content_sanskrit": "अपतिः क्षत्रियान् सर्वानाक्रन्दामि समन्ततः ।\nइयं वः क्षत्रिया माला या भीष्मं निहनिष्यति ।\nअहं च भार्या तस्य स्यां यो वीरं घातयिष्यति \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2112383, "chapter_id": 3423, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2112384, "chapter_id": 3423, "verse_number": "४", "content_sanskrit": "तस्यां चङ्क्रम्यमाणायां समाः पञ्च गताः पराः ।\nनाभवच्छरणं कश्चित् क्षत्रियो भीष्मजाद् भयात्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2112385, "chapter_id": 3423, "verse_number": "५", "content_sanskrit": "अगच्छत् सोमकं सा तु पाञ्चालेषु यशस्विनम् ।\nसत्यसन्धं महेष्वासं सत्यधर्मपरायणम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2112386, "chapter_id": 3423, "verse_number": "६", "content_sanskrit": "सा सभाद्वारमागम्य पाञ्चालैरभिरक्षितम् ।\nपाञ्चालराजमाक्रन्दत् प्रगृह्म सुभुजा भुजौ \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2112387, "chapter_id": 3423, "verse_number": "", "content_sanskrit": "अम्बा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2112388, "chapter_id": 3423, "verse_number": "७", "content_sanskrit": "भीष्मेण हन्यमानां मां मज्जतीमिव च ह्रदे ।\nयज्ञसेनाभिधावेह पाणिमालम्ब्य चेश्वर \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2112389, "chapter_id": 3423, "verse_number": "८", "content_sanskrit": "तेन मे सर्वधर्माश्च रतिभोगाश्च केवलाः ।\nउभौ च लोकौ कीर्तिश्च समूलौ सफलौ हृतौ\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2112390, "chapter_id": 3423, "verse_number": "९", "content_sanskrit": "क्रोशन्त्येवं न विन्दामि राजन्यं शरणं क्वचित् ।\nकिं नु निःक्षत्रियो लोको यत्र नाथोऽवसीदति \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2112391, "chapter_id": 3423, "verse_number": "१०", "content_sanskrit": "समागम्य तु राजानो मयोक्ता राजसत्तमाः ।\nइक्ष्वाकूणां च ये वृद्धाः पाञ्चालानां च ये वराः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2112392, "chapter_id": 3423, "verse_number": "११", "content_sanskrit": "त्वत्प्रसादाद् विवाहेऽस्मिन् माऽधर्मो मा पराजयः ।\nप्रसीद यज्ञसेनेह गतिर्मे भव सोमक \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2112393, "chapter_id": 3423, "verse_number": "", "content_sanskrit": "सोमकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2112394, "chapter_id": 3423, "verse_number": "१२", "content_sanskrit": "जानामि त्वा बोधयामि राजपुत्रि विशेषतः ।\nयथाशक्ति यथोत्साहं बलं सन्धारयाम्यहम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2112395, "chapter_id": 3423, "verse_number": "१३", "content_sanskrit": "अन्यस्मात् पार्थिवात् ते यद् भयं स्यात् पार्थिवात्मजे ।\nतस्पानयने हेतुं संविधातुमहं प्रभुः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2112396, "chapter_id": 3423, "verse_number": "१४", "content_sanskrit": "न हि शान्तनवस्याहं महास्त्रस्य प्रहारिणः ।\nईश्वरः क्षत्रियाणां हि बलं धर्मोऽनुवर्तते \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2112397, "chapter_id": 3423, "verse_number": "१५", "content_sanskrit": "साधु व्रज हि कल्याणि न मामभिषजेद् बलम् ।\nनहि भीष्मादहं धर्मं शक्तो दातुं कथञ्चन\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2112398, "chapter_id": 3423, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2112399, "chapter_id": 3423, "verse_number": "१६", "content_sanskrit": "इत्युक्ता स्रजमासज्य द्वारि राज्ञो ह्यपाद्रवत् ।\nव्युदस्तां सर्वलोकेन तपसा संशितव्रताम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2112400, "chapter_id": 3423, "verse_number": "१७", "content_sanskrit": "तामन्वगच्छद् द्रुपदः साल्वं जल्पन् पुनःपुनः ।\nस्रजं गृहाण कल्याणि न मे वैरं प्रसञ्जयेः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2112401, "chapter_id": 3423, "verse_number": "१८", "content_sanskrit": "एवमेव त्वया कार्यमिति स्म प्रतिभाषसे ।\nन तु तस्यान्यथाभावो दैवमेतदमानुषम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2112402, "chapter_id": 3423, "verse_number": "", "content_sanskrit": "अम्बा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2112403, "chapter_id": 3423, "verse_number": "१९", "content_sanskrit": "यश्चैनां स्रजमादाय स्वयं कण्ठे प्रमोक्ष्यते ।\nस भीष्मं समरे हन्ता मम धर्मप्रणाशनम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2112404, "chapter_id": 3423, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2112405, "chapter_id": 3423, "verse_number": "२०", "content_sanskrit": "तां स्रजं द्रुपदो राजा कञ्चित् कालं ररक्ष सः ।\nतदा विस्रम्भमास्थाय तूष्णीमेतामुपैक्षत \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2112406, "chapter_id": 3423, "verse_number": "२१", "content_sanskrit": "तां शिखण्डी न्यबध्नात् तु मालां पितुरजानती ।\nतां पिता त्वत्यजच्छीघ्रं त्रस्तो भीष्मस्य किल्बिषात्\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2112407, "chapter_id": 3423, "verse_number": "२२", "content_sanskrit": "ऋचीकं ब्राह्मणं भीता सा ह्मगच्छत् तपस्विनम् ।\nगङ्गाद्वारे तपस्यन्तं तुष्टिहेतोस्तपस्विनी\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2112408, "chapter_id": 3423, "verse_number": "२३", "content_sanskrit": "उपचाराभितुष्टस्तामब्रवीद् ऋषिसत्तमः ।\nगङ्गाद्वारे विभजनं भविता नचिरादिव \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2112409, "chapter_id": 3423, "verse_number": "२४", "content_sanskrit": "तत्र गन्धर्वराजं तु तं पुरुप्रियदर्शनम् ।\nआराधयितुमीहस्व सम्यक् परिचरेर्विभुम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2112410, "chapter_id": 3423, "verse_number": "२५", "content_sanskrit": "अहमप्यत्र साचिव्यं कर्तास्मि तव शोभने ।\nसा तदाचर भद्रं ते स ते श्रेयो विधास्यति \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2112411, "chapter_id": 3423, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2112412, "chapter_id": 3423, "verse_number": "२६", "content_sanskrit": "ततो विभजनं तत्र गन्घर्वाणामवाप सा ।\nतत्र द्वाववशिष्येतां गन्धर्वाणां मितौजसौ \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2112413, "chapter_id": 3423, "verse_number": "२७", "content_sanskrit": "तयोरेकः समीक्ष्यैनां स्त्रीबुभूषुरुवाच ह ।\nइदं गुह्णीष्व पुँल्लिङ्गं वृणे स्त्रीलिङ्गमेव ते \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2112414, "chapter_id": 3423, "verse_number": "२८", "content_sanskrit": "नियमं चक्रतुस्तत्र स्त्रीत्वे पुंस्त्वे च तावुभौ ।\nततः पुमान् समभवच्छिखण्डी परवीरहा \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2112415, "chapter_id": 3423, "verse_number": "२९", "content_sanskrit": "स्त्री तु भूत्वाऽपचक्राम स गन्धर्वो मुदा युतः ।\nलब्ध्वा तु महतीं प्रीतिं याज्ञसेनिर्महायशाः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2112416, "chapter_id": 3423, "verse_number": "३०", "content_sanskrit": "ततो बुद्बुदकं गत्वा पुनरस्त्राणि सोऽकरोत् ।\nतत्र चास्त्राणि दिव्यानि कृत्वा स सुमहामतिः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2112417, "chapter_id": 3423, "verse_number": "३१", "content_sanskrit": "स्वदेशमभिसम्पेदे पाञ्चालं कुरुनन्दन ।\nसोऽभिवाद्य पितुः पादौ महेष्वासः कृताञ्जलिः ।\nउवाच भवता भीष्मान्न भेतव्यं कथञ्चन \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2112418, "chapter_id": 3423, "verse_number": "१०२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nद्व्योत्तरशततमोऽध्यायः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2112419, "chapter_id": 3423, "verse_number": "५०", "content_sanskrit": "॥ इति सम्भवपर्वणि पञ्चाशोऽध्यायः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2112420, "chapter_id": 3423, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]