[{"id": 6000339000, "chapter_id": 10339, "verse_number": null, "content_sanskrit": "अथ सप्तमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000339001, "chapter_id": 10339, "verse_number": null, "content_sanskrit": "शौनक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.001.m4a", "display_order": 2}, {"id": 6000339002, "chapter_id": 10339, "verse_number": "१२-७-१", "content_sanskrit": "सूत जीव चिरं साधो वद नो वदतां वर।\nतमस्यपारे भ्रमतां नृणां त्वं पारदर्शनः॥ १२/७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.002.m4a", "display_order": 3, "topics": [{"text": "मार्कण्डेयस्य तपश्चर्या", "range": "१–३९"}]}, {"id": 6000339003, "chapter_id": 10339, "verse_number": "१२-७-२", "content_sanskrit": "आहुश्चिरायुषमृषिं मृकण्डुतनयं जनाः।\nयः कल्पान्तेऽप्युर्वरितो येन ग्रस्तमिदं जगत्॥ १२/७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.003.m4a", "display_order": 4}, {"id": 6000339004, "chapter_id": 10339, "verse_number": "१२-७-३", "content_sanskrit": "स वा अस्मत्कुलोत्पन्नः कल्पेऽस्मिन् भार्गवर्षभः।\nनैवाधुनापि भूतानां सम्प्लवः कोऽपि जायते॥ १२/७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.004.m4a", "display_order": 5}, {"id": 6000339005, "chapter_id": 10339, "verse_number": "१२-७-४", "content_sanskrit": "एक एवार्णवे भ्राम्यन् ददर्श पुरुषं किल।\nवटपत्रपुटे तोकं शयानं त्वेकमद्भुतम्॥ १२/७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.005.m4a", "display_order": 6}, {"id": 6000339006, "chapter_id": 10339, "verse_number": "१२-७-५", "content_sanskrit": "एष नः संशयो भूयान् जातः कौतूहलं यतः।\nतन्नश्छिन्धि महायोगिन् पुराणेष्वपि सम्मतः॥ १२/७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.006.m4a", "display_order": 7}, {"id": 6000339007, "chapter_id": 10339, "verse_number": null, "content_sanskrit": "सूत उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.007.m4a", "display_order": 8}, {"id": 6000339008, "chapter_id": 10339, "verse_number": "१२-७-६", "content_sanskrit": "प्रश्नस्त्वया महर्षेऽयं कृतो लोकभ्रमापहः।\nनारायणकथा यत्र गीता कलिमलापहा॥ १२/७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.008.m4a", "display_order": 9}, {"id": 6000339009, "chapter_id": 10339, "verse_number": "१२-७-७", "content_sanskrit": "प्राप्तद्विजातिसंस्कारो मार्कण्डेयः पितुः क्रमात्।\nछन्दांस्यधीत्य धर्मेण तपःस्वाध्यायसंयुतः॥ १२/७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.009.m4a", "display_order": 10}, {"id": 6000339010, "chapter_id": 10339, "verse_number": "१२-७-८", "content_sanskrit": "बृहद्व्रतधरः शान्तो जटिलो वल्कलाम्बरः।\nबिभ्रत् कमण्डलुं दण्डमुपवीतं समेखलम्॥ १२/७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.010.m4a", "display_order": 11}, {"id": 6000339011, "chapter_id": 10339, "verse_number": "१२-७-९", "content_sanskrit": "कृष्णाजिनं साक्षसूत्रं कुशांश्च नियमैर्युतः।\nअग्न्यर्कगुरुविप्रांश्च स्वर्चयन् सन्ध्ययोर्हरिम्॥ १२/७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.011.m4a", "display_order": 12}, {"id": 6000339012, "chapter_id": 10339, "verse_number": "१२-७-१०", "content_sanskrit": "सायंप्रातः स गुरवे भैक्ष्यमाहृत्य वाग्यतः।\nबुभुजे गुर्वनुज्ञातः सकृन्नो चेदुपोषितः॥ १२/७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.012.m4a", "display_order": 13}, {"id": 6000339013, "chapter_id": 10339, "verse_number": "१२-७-११", "content_sanskrit": "एवं तपःस्वाध्यायपरो वर्षाणामयुतायुतम्।\nआराधयद्धृषीकेशं जिग्ये मृत्युं सुदुर्जयम्॥ १२/७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.013.m4a", "display_order": 14}, {"id": 6000339014, "chapter_id": 10339, "verse_number": "१२-७-१२", "content_sanskrit": "ब्रह्मा भृगुर्भवो दक्षो ब्रह्मपुत्राश्च येऽपरे।\nनृदेवपितृभूतानि तेनासन्नतिविस्मिताः॥ १२/७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.014.m4a", "display_order": 15}, {"id": 6000339015, "chapter_id": 10339, "verse_number": "१२-७-१३", "content_sanskrit": "इत्थं बृहद्व्रतधरस्तपःस्वाध्यायसंयमैः।\nदध्यावधोक्षजं योगाद् ध्वस्तक्लेशोऽन्तरात्मना॥ १२/७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.015.m4a", "display_order": 16}, {"id": 6000339016, "chapter_id": 10339, "verse_number": "१२-७-१४", "content_sanskrit": "तस्यैवं युञ्जतश्चित्तं महायोगेन योगिनः।\nव्यतीयाय महान् कालो मन्वन्तरषडात्मकः॥ १२/७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.016.m4a", "display_order": 17}, {"id": 6000339017, "chapter_id": 10339, "verse_number": "१२-७-१५", "content_sanskrit": "एतत् पुरन्दरो ज्ञात्वा सप्तमेऽस्मिन् किलान्तरे।\nतपोविशङ्कितो ब्रह्मन्नारेभे तद्विघातनम्॥ १२/७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.017.m4a", "display_order": 18}, {"id": 6000339018, "chapter_id": 10339, "verse_number": "१२-७-१६", "content_sanskrit": "गन्धर्वाप्सरसः कामं वसन्तं मलयानिलम्।\nमुनये प्रेषयामास रजःस्तोभमदौ तथा॥ १२/७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.018.m4a", "display_order": 19}, {"id": 6000339019, "chapter_id": 10339, "verse_number": "१२-७-१७", "content_sanskrit": "ते वै तदाश्रमं जग्मुर्हिमाद्रेः पार्श्व उत्तरे।\nपुष्पभद्रा नदी यत्र चित्राख्या च शिला विभो॥ १२/७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.019.m4a", "display_order": 20}, {"id": 6000339020, "chapter_id": 10339, "verse_number": "१२-७-१८", "content_sanskrit": "तत्राश्रमपदं पुण्यं पुण्यद्रुमलतान्वितम्।\nपुण्यद्विजकुलाकीर्णं पुण्यामलजलाशयम्॥ १२/७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.020.m4a", "display_order": 21}, {"id": 6000339021, "chapter_id": 10339, "verse_number": "१२-७-१९", "content_sanskrit": "मत्तभ्रमरसङ्गीतं मत्तकोकिलकूजितम्।\nमत्तबर्हिनटाटोपं मत्तद्विजकुलाकुलम्॥ १२/७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.021.m4a", "display_order": 22}, {"id": 6000339022, "chapter_id": 10339, "verse_number": "१२-७-२०", "content_sanskrit": "वायुः प्रविष्ट आदाय हिमनिर्झरसीकरान्।\nसुमनोभिः परिष्वक्तो ववावुत्तम्भयन् स्मरम्॥ १२/७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.022.m4a", "display_order": 23}, {"id": 6000339023, "chapter_id": 10339, "verse_number": "१२-७-२१", "content_sanskrit": "उद्यच्चन्द्रनिशावक्त्रः प्रवालस्तबकालिभिः।\nगायन्द्रुमलताजालैस्तत्रासीत् कुसुमाकरः॥ १२/७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.023.m4a", "display_order": 24}, {"id": 6000339024, "chapter_id": 10339, "verse_number": "१२-७-२२", "content_sanskrit": "अन्वीयमानो गन्धर्वैर्गीतवादित्रयूथपैः।\nअदृश्यतात्तचापेषुः स्वःस्त्रीयूथपतिः स्मरः॥ १२/७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.024.m4a", "display_order": 25}, {"id": 6000339025, "chapter_id": 10339, "verse_number": "१२-७-२३", "content_sanskrit": "हुत्वाऽग्निं समुपासीनं ददृशुः शक्रकिङ्कराः।\nमीलिताक्षं दुराधर्षं मूर्तिमन्तमिवानलम्॥ १२/७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.025.m4a", "display_order": 26}, {"id": 6000339026, "chapter_id": 10339, "verse_number": "१२-७-२४", "content_sanskrit": "ननृतुस्तस्य पुरतः स्त्रियोऽथो गायका जगुः।\nमृदङ्गवीणापणवैर्वाद्यं चक्रुर्मनोरमम्॥ १२/७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.026.m4a", "display_order": 27}, {"id": 6000339027, "chapter_id": 10339, "verse_number": "१२-७-२५", "content_sanskrit": "सन्दधेऽस्त्रं स्वधनुषि कामः पञ्चमुखं तदा।\nमधुर्मदो रजःस्तोभ इन्द्रभृत्या व्यकम्पयन्॥ १२/७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.027.m4a", "display_order": 28}, {"id": 6000339028, "chapter_id": 10339, "verse_number": "१२-७-२६", "content_sanskrit": "क्रीडन्त्याः पुञ्जकस्थल्याः कन्दुकैः स्तनगौरवात्।\nभृशमुद्विग्नमध्यायाः केशविभ्रंशितस्रजः॥ १२/७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.028.m4a", "display_order": 29}, {"id": 6000339029, "chapter_id": 10339, "verse_number": "१२-७-२७", "content_sanskrit": "इतस्ततो भ्रमद्दृष्टेश्चलन्त्या अनुकन्दुकम्।\nवायुर्जहार तद्वासः सूक्ष्मं त्रुटितमेखलम्॥ १२/७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.029.m4a", "display_order": 30}, {"id": 6000339030, "chapter_id": 10339, "verse_number": "१२-७-२८", "content_sanskrit": "विससर्ज ततो बाणं मत्वा तं स्वजितं स्मरः।\nसर्वं तत्राभवन्मोघमनीशस्य यथोद्यमः॥ १२/७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.030.m4a", "display_order": 31}, {"id": 6000339031, "chapter_id": 10339, "verse_number": "१२-७-२९", "content_sanskrit": "त इत्थमपकुर्वन्तो मुनेस्तत्तेजसा मुने।\nदह्यमाना निववृतुः प्रबोध्याहिमिवार्भकाः॥ १२/७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.031.m4a", "display_order": 32}, {"id": 6000339032, "chapter_id": 10339, "verse_number": "१२-७-३०", "content_sanskrit": "इतीन्द्रानुचरैर्ब्रह्मन् धर्षितोऽपि महामुनिः।\nयन्नागादहमोभावं न तच्चित्रं महत्स्वपि॥ १२/७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.032.m4a", "display_order": 33}, {"id": 6000339033, "chapter_id": 10339, "verse_number": "१२-७-३१", "content_sanskrit": "दृष्ट्वा निस्तेजसं कामं सगणं भगवान् स्वराट्।\nश्रुत्वाऽनुभावं ब्रह्मर्षेर्विस्मयं समगात् परम्॥ १२/७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.033.m4a", "display_order": 34}, {"id": 6000339034, "chapter_id": 10339, "verse_number": "१२-७-३२", "content_sanskrit": "तस्यैवं युञ्जतश्चित्तं तपःस्वाध्यायसंयमैः।\nअनुग्रहायाविरासीन्नरनारायणो हरिः॥ १२/७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.034.m4a", "display_order": 35}, {"id": 6000339035, "chapter_id": 10339, "verse_number": "१२-७-३३", "content_sanskrit": "तौ शुक्लकृष्णौ नवकञ्जलोचनौ चतुर्भुजौ रौरववल्कलाम्बरौ।\nपवित्रपाणी उपवीतकं त्रिवृत् कमण्डलुं दण्डमृजुं च वैणवम्॥ १२/७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.035.m4a", "display_order": 36}, {"id": 6000339036, "chapter_id": 10339, "verse_number": "१२-७-३४", "content_sanskrit": "पद्माक्षमालामुत जन्तुमार्जनं वेदं च साक्षात्तपएकरूपिणौ।\nतपत्तडिद्वर्णपिशङ्गरोचिषा प्रांशू दधानौ विबुधर्षभार्चितौ॥ १२/७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.036.m4a", "display_order": 37}, {"id": 6000339037, "chapter_id": 10339, "verse_number": "१२-७-३५", "content_sanskrit": "ते वै भगवतो रूपे नरनारायणौ ऋषी।\nवीक्ष्योत्थायादरेणोच्चैर्ननामाङ्गेन दण्डवत्॥ १२/७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.037.m4a", "display_order": 38}, {"id": 6000339038, "chapter_id": 10339, "verse_number": "१२-७-३६", "content_sanskrit": "एतत्सन्दर्शनानन्दनियतात्मेन्द्रियाशयः।\nहृष्टरोमाऽश्रुपूर्णाक्षो न सेहे तावुदीक्षितुम्॥ १२/७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.038.m4a", "display_order": 39}, {"id": 6000339039, "chapter_id": 10339, "verse_number": "१२-७-३७", "content_sanskrit": "उत्थाय प्राञ्जलिः प्रह्व औत्सुक्यादाश्लिषन्निव।\nनमो नम इतीशानौ बभाषे गद्गदाक्षरम्॥ १२/७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.039.m4a", "display_order": 40}, {"id": 6000339040, "chapter_id": 10339, "verse_number": "१२-७-३८", "content_sanskrit": "तयोरासनमादाय पादयोरवनिज्य च।\nअर्हणेनानुलेपेन धूपमाल्यैरपूजयत्॥ १२/७/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.040.m4a", "display_order": 41}, {"id": 6000339041, "chapter_id": 10339, "verse_number": "१२-७-३९", "content_sanskrit": "सुखमासनमासीनौ प्रसादाभिमुखौ मुनिः।\nपुनरानम्य पादाभ्यां गरिष्ठाविदमब्रवीत्॥ १२/७/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.041.m4a", "display_order": 42}, {"id": 6000339042, "chapter_id": 10339, "verse_number": null, "content_sanskrit": "मार्कण्डेय उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.042.m4a", "display_order": 43}, {"id": 6000339043, "chapter_id": 10339, "verse_number": "१२-७-४०", "content_sanskrit": "किं वर्णये तव विभो यदुदीरितासुः संस्पन्दते तमनु वाङ्मनइन्द्रियाणि।\nस्पन्दन्ति वै तनुभृतामजशर्वयोश्च स्वस्याप्यथापि भजतामनुभावबद्धः॥ १२/७/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.043.m4a", "display_order": 44, "topics": [{"text": "तत्कृता नरनारायणस्तुतिः", "range": "४०–४९"}]}, {"id": 6000339044, "chapter_id": 10339, "verse_number": "१२-७-४१", "content_sanskrit": "मूर्ती इमे भगवतो भगवंस्त्रिलोक्याः क्षेमाय तापविरमाय च मृत्युजित्यै।\nनाना बिभर्ष्यनुपमान्यतनूर्यथेदं सृष्ट्वा पुनर्ग्रससि सर्वमिवोर्णनाभिः॥ १२/७/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.044.m4a", "display_order": 45}, {"id": 6000339045, "chapter_id": 10339, "verse_number": "१२-७-४२", "content_sanskrit": "तस्यावितुः स्थिरचरेशितुरङ्घ्रिमूलं यत्स्थं न कर्मगुणकालरजः स्पृशन्ति।\nयद् वै स्तुवन्ति निनमन्ति यजन्त्यभीक्ष्णं ध्यायन्ति वेदहृदया मुनयस्तदाप्त्यै॥ १२/७/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.045.m4a", "display_order": 46}, {"id": 6000339046, "chapter_id": 10339, "verse_number": "१२-७-४३", "content_sanskrit": "नान्यत् तवाङ्घ्य्रुपनयादपवर्गमूर्ते क्षेमं जनस्य परितोऽभय ईश विद्मः।\nब्रह्मा बिभेत्यलमतो द्विपरार्धधिष्ण्यः कालस्य ते किमुत तत्कृतभौतिकानाम्॥ १२/७/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.046.m4a", "display_order": 47}, {"id": 6000339047, "chapter_id": 10339, "verse_number": "१२-७-४४", "content_sanskrit": "तद् वै भजाम्यृतधियस्तव पादमूलं हित्वैतदात्मभिदमात्मगुरोः परस्य।\nदेहाद्यपार्थमसदित्यनभिज्ञमात्रं विन्देय चेत् तर्हि सर्वमनीषितार्थम्॥ १२/७/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.047.m4a", "display_order": 48}, {"id": 6000339048, "chapter_id": 10339, "verse_number": "१२-७-४५", "content_sanskrit": "सत्त्वं रजस्तम इतीश तवाऽत्मबन्धो मायामया स्थितिलयोदयहेतवोऽस्य।\nलीलाधृता यदपि सत्त्वमयः प्रशान्त्यै नान्ये नृणां व्यसनमोहभियश्च याभ्याम्॥ १२/७/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.048.m4a", "display_order": 49}, {"id": 6000339049, "chapter_id": 10339, "verse_number": "१२-७-४६", "content_sanskrit": "तस्मात् तवेह भगवन्नथ तावकानां शुक्लां तनुं स्वदयितां कुशला भजन्ति।\nयत् सात्वताः पुरुषरूपमुशन्ति सत्त्वं लोको यतोऽभयमुताऽत्मसुखं च नान्यत्॥ १२/७/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.049.m4a", "display_order": 50}, {"id": 6000339050, "chapter_id": 10339, "verse_number": "१२-७-४७", "content_sanskrit": "तस्मै नमो भगवते पुरुषाय भूम्ने विश्वाय विश्वगुरवे परदेवतायै।\nनारायणाय ऋषये च नरोत्तमाय हंसाय संयतगिरे निगमेश्वराय॥ १२/७/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.050.m4a", "display_order": 51}, {"id": 6000339051, "chapter_id": 10339, "verse_number": "१२-७-४८", "content_sanskrit": "यं वै न वेद वितताक्षपथैर्भ्रमद्धीः सन्तं स्वखेष्वसुषु हृद्यपि दृक्पथेषु।\nत्वन्माययाऽऽवृतमतिः स उ एव साक्षादाद्यस्तवाखिलगुरोरुपपद्य वेदम्॥ १२/७/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.051.m4a", "display_order": 52}, {"id": 6000339052, "chapter_id": 10339, "verse_number": "१२-७-४९", "content_sanskrit": "यद्दर्शनं निगम आत्मरहःप्रकाशं मुह्यन्ति यत्र कवयोऽजपरा यतन्तः।\nतं सर्ववादविषयप्रतिरूपशीलं वन्दामहे पुरुषमात्मनि गूढबोधम्॥ १२/७/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_007/BhP_12.007.052.m4a", "display_order": 53}, {"id": 6000339053, "chapter_id": 10339, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां द्वादशस्कन्धे सप्तमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]