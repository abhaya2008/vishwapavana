[{"id": 7005607000, "chapter_id": 25607, "verse_number": "८०-१", "content_sanskrit": "शुभसप्तमीव्रतकथनम् ।\nश्रीभगवानुवाच ।\nअथान्यामपि वक्ष्यामि शोभनां शुभसप्तमीम् ।\nयामुपोष्य नरो रोगशोकदुःखैः प्रमुच्यते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005607001, "chapter_id": 25607, "verse_number": "८०-२", "content_sanskrit": "पुण्ये चाश्वयुजेमासिकृतस्नानजपः शुचिः ।\nवाचयित्वा ततो विप्रानारभेच्छुभसप्तमीम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005607002, "chapter_id": 25607, "verse_number": "८०-३", "content_sanskrit": "कपिलां पूजयेद्‌भक्त्या गन्धमाल्यानुलेपनैः ।\nनमामि सूर्य्यसम्भूतामशेषभुवनालयाम् ।\nत्वामहं शुभकल्याणशरीरां सर्वसिद्धये ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005607003, "chapter_id": 25607, "verse_number": "८०-४", "content_sanskrit": "अथ कृत्वा तिलप्रस्थं ताम्रपात्रेण संयुतम् ।\nकाञ्चनं वृषभं तद्वद्गन्धमाल्यगुडान्वितैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005607004, "chapter_id": 25607, "verse_number": "८०-५", "content_sanskrit": "फलैर्नानाविधैर्भक्ष्यै र्घृतपायससंयुतैः ।\nदद्याद्विकालवेलायामर्यमा प्रीयतामिति ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005607005, "chapter_id": 25607, "verse_number": "८०-६", "content_sanskrit": "पञ्चगव्यञ्च सम्प्राश्य स्वपेद्‌भूमौ विमत्सरः ।\nततः प्रभाते सञ्जाते भक्त्या सम्पूजयेद्‌द्विजान् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005607006, "chapter_id": 25607, "verse_number": "८०-७", "content_sanskrit": "अनेन विधिना दद्यान्मासि मासि यदा नरः ।\nवाससी वृषभं हैमं तद्वद्गां काञ्चनोद्भवाम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005607007, "chapter_id": 25607, "verse_number": "८०-८", "content_sanskrit": "सम्वत्सरान्ते शयनमिक्षुदण्डगुडान्वितम् ।\nसोपधानकविश्रामं भाजनासनसंयुतम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005607008, "chapter_id": 25607, "verse_number": "८०-९", "content_sanskrit": "ताम्रपात्रे तिलप्रस्थं सौवर्णं वृषभं तथा ।\nदद्याद्वेदविदे सर्वं विश्वात्मा प्रीयतामिति ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005607009, "chapter_id": 25607, "verse_number": "८०-१०", "content_sanskrit": "अनेन विधिना विद्वान् कुर्य्याद्यः शुभसप्तमीम् ।\nतस्य श्रीर्विपुला कीर्तिर्भवेज्जन्मनि जन्मनि ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005607010, "chapter_id": 25607, "verse_number": "८०-११", "content_sanskrit": "अप्सरोगणगन्धर्वैः पूज्यमानः सुरालये ।\nवसेद् गणाधिपो भूत्वा यावदाभूतसम्प्लवम् ।\nकल्पादाववतीर्णस्तु सप्तद्वीपाधिपो भवेत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005607011, "chapter_id": 25607, "verse_number": "८०-१२", "content_sanskrit": "ब्रह्महत्या सहस्रस्य भ्रूणहत्या शतस्य च ।\nनाशायालमियं पुण्या पठ्यते शुभसप्तमी ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005607012, "chapter_id": 25607, "verse_number": "८०-१३", "content_sanskrit": "इमां पठेद्यः श्रृणुयान्मुहूर्तं पश्येत्प्रसङ्गादपि दीयमानम् ।\nसोऽप्यत्र सर्वाघविमुक्तदेहः प्राप्नोति विद्याधरनायकत्वम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005607013, "chapter_id": 25607, "verse_number": "८०-१४", "content_sanskrit": "यावत्समाः सप्त नरः करोति यः सप्तमीं सप्तविधानयुक्ताम् ।\nस सप्तलोकाधिपतिः क्रमेण भूत्वा पदं याति परं मुरारे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]