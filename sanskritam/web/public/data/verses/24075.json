[{"id": 7004075000, "chapter_id": 24075, "verse_number": "४-२४-१", "content_sanskrit": "गणावूचतुः ।\nशिवशर्मन्नुदर्कं ते कथयावो निशामय ।\nत्वमत्र वैष्णवे लोके भुक्त्वा भोगान्सुपुष्कलान् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004075001, "chapter_id": 24075, "verse_number": "४-२४-२", "content_sanskrit": "ब्रह्मणो वत्सरं पूर्णं रममाणोऽप्सरोगणैः ।\nसुतीर्थमरणोपात्त पुण्यशेषेण वै पुनः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004075002, "chapter_id": 24075, "verse_number": "४-२४-३", "content_sanskrit": "भविष्यसि महीपालो नगरे नंदिवर्धने ।\nराज्यं प्राप्यासपत्नं च समृद्धबलवाहनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004075003, "chapter_id": 24075, "verse_number": "४-२४-४", "content_sanskrit": "कृष्टिभिर्हृष्टपुष्टैश्च रम्यहाटकभूषणैः ।\nसंजुष्टमिष्टापूर्तानां धर्माणां नित्यकर्तृभिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004075004, "chapter_id": 24075, "verse_number": "४-२४-५", "content_sanskrit": "सदासंपन्नसस्यं च सूर्वरक्षेत्रसंकुलम् ।\nसुदेशं सुप्रजं सुस्थं सुतृणं बहुगोधनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004075005, "chapter_id": 24075, "verse_number": "४-२४-६", "content_sanskrit": "देवतायतनानां च राजिभिः परिराजितम् ।\nसुयूपा यत्र वै ग्रामाः सुवित्तर्द्धि विराजिताः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004075006, "chapter_id": 24075, "verse_number": "४-२४-७", "content_sanskrit": "सुपुष्प कृत्रिमोद्यानाः ससदाफलपादपाः ।\nसपद्मिनीककासारा यत्र राजंति भूमयः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004075007, "chapter_id": 24075, "verse_number": "४-२४-८", "content_sanskrit": "सदंभा निम्नगाराजिर्न यत्र जनता क्वचित् ।\nकुलान्येव कुलीनानि न चान्यायधनानि च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004075008, "chapter_id": 24075, "verse_number": "४-२४-९", "content_sanskrit": "विभ्रमो यत्र नारीषु नविद्वत्सु च कर्हिचित् ।\nनद्यः कुटिलगामिन्यो न यत्र विषये प्रजाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004075009, "chapter_id": 24075, "verse_number": "४-२४-१०", "content_sanskrit": "तमोयुक्ताः क्षपा यत्र बहुलेषु न मानवाः ।\nरजोयुजः स्त्रियो यत्र न धर्मबहुला नराः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004075010, "chapter_id": 24075, "verse_number": "४-२४-११", "content_sanskrit": "धनैरनंधो यत्रास्ति मनो नैव च भोजनम् ।\nअनयः स्यंदनं यत्र न च वै राजपूरुषः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004075011, "chapter_id": 24075, "verse_number": "४-२४-१२", "content_sanskrit": "दंडः परशुकुद्दाल वालव्य जनराजिषु ।\nआतपत्रेषु नान्यत्र क्वचित्क्रोधापराधजः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004075012, "chapter_id": 24075, "verse_number": "४-२४-१३", "content_sanskrit": "अन्यत्राक्षिकवृंदेभ्यः क्वचिन्न परिदेवनम् ।\nआक्षिका एव दृश्यंते यत्र पाशकपाणयः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004075013, "chapter_id": 24075, "verse_number": "४-२४-१४", "content_sanskrit": "जाड्यवार्ता जलेष्वेव स्त्रीमध्या एव दुर्बलाः ।\nकठोरहृदया यत्र सीमंतिन्यो न मानवाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004075014, "chapter_id": 24075, "verse_number": "४-२४-१५", "content_sanskrit": "औषधेष्वेव यत्रास्ति कुष्ठयोगो न मानवे ।\nवेधोप्यंतःसुरत्नेषु शूलं मूर्तिकरेषु वै ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004075015, "chapter_id": 24075, "verse_number": "४-२४-१६", "content_sanskrit": "कंपःसात्त्विकभावोत्थो न भयात्क्वापि कस्यचित् ।\nसंज्वरः कामजो यत्र दारिद्र्यं कलुषस्य च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004075016, "chapter_id": 24075, "verse_number": "४-२४-१७", "content_sanskrit": "दुर्लभत्वं सदा कस्य सुकृतेन च वस्तुनः ।\nइभा एव प्रमत्ता वै युद्धं वीच्योर्जलाशये ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004075017, "chapter_id": 24075, "verse_number": "४-२४-१८", "content_sanskrit": "दानहानिर्गजेष्वेव द्रुमेष्वेव हि कंटकाः ।\nजनेष्वेव विहारा हि न कस्यचिदुरःस्थली ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004075018, "chapter_id": 24075, "verse_number": "४-२४-१९", "content_sanskrit": "बाणेषु गुणविश्लेषो बंधोक्तिः पुस्तके दृढा ।\nस्नेहत्यागः सदैवास्ति यत्र पाशुपते जने ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004075019, "chapter_id": 24075, "verse_number": "४-२४-२०", "content_sanskrit": "दंडवार्ता सदा यत्र कृतसंन्यासकर्मणाम् ।\nमार्गणाश्चापकेष्वेव भिक्षुका ब्रह्मचारिणः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004075020, "chapter_id": 24075, "verse_number": "४-२४-२१", "content_sanskrit": "यत्र क्षपणका एव दृश्यंते मलधारिणः ।\nप्रायो मधुव्रता एव यत्र चंचलवृत्तयः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004075021, "chapter_id": 24075, "verse_number": "४-२४-२२", "content_sanskrit": "इत्यादि गुणवद्देशे त्वयिराज्यं प्रशासति ।\nधर्मेण राजधर्मज्ञ शौंडीर्यगुणशालिनि ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004075022, "chapter_id": 24075, "verse_number": "४-२४-२३", "content_sanskrit": "सौभाग्यभाजि रूपाढ्ये शौर्यौदार्यगुणान्विते ।\nसीमंतिनीनां रम्याणां लावण्यवर्जित सुश्रियाम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004075023, "chapter_id": 24075, "verse_number": "४-२४-२४", "content_sanskrit": "राज्ञीनामयुतंभावि कुमाराणां शतत्रयम् ।\nवृद्धकाल इति ख्यात उग्रः परपुरंजयः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004075024, "chapter_id": 24075, "verse_number": "४-२४-२५", "content_sanskrit": "विजितानेकसमरः श्रीसंतर्पितमार्गणः ।\nअनेकगुणसंपूर्णः पूर्णचंद्रनिभद्युतिः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004075025, "chapter_id": 24075, "verse_number": "४-२४-२६", "content_sanskrit": "संततावभृथक्लिन्न मूर्धजः क्षितिषर्षभः ।\nप्रजापालनसंपन्नः कोशप्रीणितभूसुरः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004075026, "chapter_id": 24075, "verse_number": "४-२४-२७", "content_sanskrit": "पदारविंदं गौविंदं हृदि ध्यायन्नतंद्रितः ।\nवासुदेवकथालापपरिक्षिप्त दिनक्षपः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004075027, "chapter_id": 24075, "verse_number": "४-२४-२८", "content_sanskrit": "कदाचिदुपविष्टःसन्मध्ये राजसभं द्विज ।\nदूरात्कार्पटिकैर्दृष्टो वाराणस्याः समागतैः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004075028, "chapter_id": 24075, "verse_number": "४-२४-२९", "content_sanskrit": "तत्कर्मभाविसदृशैस्तदात्वमभिनंदितः ।\nतैः सर्वै राजशार्दूलस्याशीर्वादैरनेकशः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004075029, "chapter_id": 24075, "verse_number": "४-२४-३०", "content_sanskrit": "श्रीमद्विश्वेश्वरो देवो विश्वेषां जगतां गुरुः ।\nकाशीनाथस्तुते कुर्यात्कुमतेरपवर्जनम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004075030, "chapter_id": 24075, "verse_number": "४-२४-३१", "content_sanskrit": "नैःश्रेयसीं च संपत्तिं यो देयात्स्मरणादपि ।\nकाशीनाथः स ते दिश्याज्ज्ञानं मलविवर्जितम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004075031, "chapter_id": 24075, "verse_number": "४-२४-३२", "content_sanskrit": "येन पुण्येन ते प्राप्तं राज्यं प्राज्यमकंटकम् ।\nतत्पुण्यशेषतोभूयाद्विश्वनाथे मतिस्तव ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004075032, "chapter_id": 24075, "verse_number": "४-२४-३३", "content_sanskrit": "यस्य प्रसादात्सुलभमायुः पुत्रांबरागनाः ।\nसमृद्धयः स्वर्गमोक्षौ स विश्वेशः प्रसीदतु ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004075033, "chapter_id": 24075, "verse_number": "४-२४-३४", "content_sanskrit": "नामश्रवणमात्रेण यस्य विश्वेशितुर्विभोः ।\nमहापातकविच्छेदः स विश्वेशोऽस्तु ते हृदि ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004075034, "chapter_id": 24075, "verse_number": "४-२४-३५", "content_sanskrit": "त्वं वृद्धकालो भूपालः श्रुत्वेत्याशीः परंपराम् ।\nस्मरिष्यसीदं वृत्तांतं पुलकांकवपुस्तदा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004075035, "chapter_id": 24075, "verse_number": "४-२४-३६", "content_sanskrit": "आकारगोपनं कृत्वा तेभ्यो दत्त्वा धनं बहु ।\nसुमुहूर्तमनुप्राप्य सुते राज्यं विधाय च ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004075036, "chapter_id": 24075, "verse_number": "४-२४-३७", "content_sanskrit": "अनंगलेखया राज्ञ्या ततः काशीं गमिष्यसि ।\nदत्त्वा दानानि भूरीणि प्रीणयित्वाऽर्थिनो जनान् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004075037, "chapter_id": 24075, "verse_number": "४-२४-३८", "content_sanskrit": "स्वनाम्ना तत्र संस्थाप्य लिंगं निर्वाणकारणम् ।\nप्रासादं तत्र कृत्वोच्चैस्तदग्रे कूपमुत्तमम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004075038, "chapter_id": 24075, "verse_number": "४-२४-३९", "content_sanskrit": "विधाय विधिवत्तत्र कलशारोपणादिकम् ।\nमणिमाणिक्य चांपेय दुकूलेभाश्वगोधनम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004075039, "chapter_id": 24075, "verse_number": "४-२४-४०", "content_sanskrit": "महाध्वजपताकाश्च च्छत्रचामरदर्पणम् ।\nदेवोपकरणं भूरि विश्राण्य श्रमवर्जितः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004075040, "chapter_id": 24075, "verse_number": "४-२४-४१", "content_sanskrit": "व्रतोपवासनियमैः परिक्षीणकलेवरः ।\nमध्याह्ने निर्जने तत्र द्रक्ष्यस्येकं तपोधनम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004075041, "chapter_id": 24075, "verse_number": "४-२४-४२", "content_sanskrit": "अतीवजीर्णवपुषं परिपिंगजटान्वितम् ।\nमूर्तिमंतंमिव प्रांशुं धर्मं जनमनोहरम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004075042, "chapter_id": 24075, "verse_number": "४-२४-४३", "content_sanskrit": "भारं शरीरयष्टेश्च दृढयष्ट्यां समर्प्य च ।\nगर्भागाराद्विनिष्क्रम्याभ्यायांतंरंगमंडपे ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004075043, "chapter_id": 24075, "verse_number": "४-२४-४४", "content_sanskrit": "उपविश्य समीपे ते प्रक्ष्यत्येवमनुक्रमात् ।\nकोसि त्वं किमिहासि त्वं द्वितीय इव कस्त्वयम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004075044, "chapter_id": 24075, "verse_number": "४-२४-४५", "content_sanskrit": "प्रासादः कारितः केन जानास्येष ततो वद ।\nअस्य लिंगस्य किं नाम प्रायो जाने न वार्धकात् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004075045, "chapter_id": 24075, "verse_number": "४-२४-४६", "content_sanskrit": "पृष्टस्त्वमिति ते नाथ तदा वृद्ध तपस्विना ।\nकथयिष्यस्यहं राजा वृद्धकाल इति श्रुतः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004075046, "chapter_id": 24075, "verse_number": "४-२४-४७", "content_sanskrit": "दाक्षिणात्य इह प्राप्तस्त्वेतया सह कांतया ।\nध्यायामि लिंगमेतच्च प्रार्थयामि न किंचन ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004075047, "chapter_id": 24075, "verse_number": "४-२४-४८", "content_sanskrit": "प्रासादस्यास्य जटिल स्वयंकारयिता शिवः ।\nविशेषतोऽस्यलिंगस्य नाम नो वेद्मि निश्चितम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004075048, "chapter_id": 24075, "verse_number": "४-२४-४९", "content_sanskrit": "इति श्रुत्वा नरपतेर्वाक्यंप्राह जटाधरः ।\nसत्यमुक्तं त्वयैकं हि लिंगनाम न वेत्सि यत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004075049, "chapter_id": 24075, "verse_number": "४-२४-५०", "content_sanskrit": "पश्येयं त्वामहं नित्यमुपविष्टं सुनिश्चलम् ।\nश्रुतो भविष्यति तव प्रासादो येन कारितः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004075050, "chapter_id": 24075, "verse_number": "४-२४-५१", "content_sanskrit": "ममाग्रे तत्समाचक्ष्व यदि जानासि तत्त्वतः ।\nआकर्ण्येति वचस्तस्य पुनः प्राह भवानिति ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004075051, "chapter_id": 24075, "verse_number": "४-२४-५२", "content_sanskrit": "कर्ता कारयिता शंभुः किमतथ्यं ब्रवीम्यहम् ।\nअथवा चिंतया किं मे तपस्विन्ननया विभो ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004075052, "chapter_id": 24075, "verse_number": "४-२४-५३", "content_sanskrit": "इति त्वयि स्थिते जोषं स पुनर्वृद्धतापसः ।\nपिपासुरस्मि पानीयमानीयाशु प्रयच्छ मे ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004075053, "chapter_id": 24075, "verse_number": "४-२४-५४", "content_sanskrit": "इति तेन च नुन्नस्त्वं वार्यानीय च कूपतः ।\nपाययिष्यसि तं वृद्धं तापसं तत्क्षणाच्च सः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004075054, "chapter_id": 24075, "verse_number": "४-२४-५५", "content_sanskrit": "तदंबुपानतो भूयात्सुपार्वण शशिप्रभः ।\nतरुणो रूपसंपन्नः कोशोन्मुक्तोरगो यथा ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004075055, "chapter_id": 24075, "verse_number": "४-२४-५६", "content_sanskrit": "जाताश्चर्येण भवता पुनरेवाभ्यभाषि सः ।\nकः प्रभावो हि भगवन्नेष येन भवान्पुनः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004075056, "chapter_id": 24075, "verse_number": "४-२४-५७", "content_sanskrit": "परित्यज्यात्र जरसं न वो भ्राजसि सांप्रतम् ।\nअस्ति चेदवकाशस्ते ततो ब्रूहि तपोधन ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004075057, "chapter_id": 24075, "verse_number": "४-२४-५८", "content_sanskrit": "तपोधन उवाच ।\nवृद्धकालक्षितिपते जाने त्वां सुमहामते ।\nइमामपि च जानेऽहं तव पत्नीं पतिव्रताम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004075058, "chapter_id": 24075, "verse_number": "४-२४-५९", "content_sanskrit": "जन्मनोऽस्मादियं राजन्नासीद्विप्रस्य कन्यका ।\nतुर्वसोर्वेदवपुषः शुभाचारा शुभानना ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004075059, "chapter_id": 24075, "verse_number": "४-२४-६०", "content_sanskrit": "तेन दत्ता विवाहार्थं नैध्रुवाय महात्मने ।\nस च कालवशं प्राप्तो नैध्रुवोऽप्राप्तयौवनः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004075060, "chapter_id": 24075, "verse_number": "४-२४-६१", "content_sanskrit": "वैधव्यं पालयंत्येषा मृताऽवंत्यां शुभव्रता ।\nतेन पुण्येन संजाता पांड्यस्य नृपतेः सुता ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004075061, "chapter_id": 24075, "verse_number": "४-२४-६२", "content_sanskrit": "परिणीता त्वया राजन्पतिव्रतरता सदा ।\nत्वया सहेह संप्राप्ता मुक्तिं प्राप्स्यत्यनुत्तमाम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004075062, "chapter_id": 24075, "verse_number": "४-२४-६३", "content_sanskrit": "अयोध्यायामथावंत्यां मथुरायामथापि वा ।\nद्वारवत्यां च कांच्यां वा मायापुर्यामथो नृप ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004075063, "chapter_id": 24075, "verse_number": "४-२४-६४", "content_sanskrit": "अपि पातकिनो ये च कालेन निधनं गताः ।\nते हि स्वर्गादिहागत्य काश्यां मोक्षमवाप्नुयुः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004075064, "chapter_id": 24075, "verse_number": "४-२४-६५", "content_sanskrit": "अवैमि त्वामपि नृपद्विजोऽभूः पूर्वजन्मनि ।\nमाथुरः शिवशर्माख्यो मायापुर्यां भवान्मृतः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004075065, "chapter_id": 24075, "verse_number": "४-२४-६६", "content_sanskrit": "तत्पुण्यात्प्राप्य वैकुंठं भुक्त्वा भोगान्मनोरमान् ।\nतत्पुण्यशेषात्क्षितिपो जातस्त्वं नंदिवर्धने ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004075066, "chapter_id": 24075, "verse_number": "४-२४-६७", "content_sanskrit": "वृद्धकालावनीपाल तेनैव सुकृतेन च ।\nमोक्षक्षेत्रमिदं प्राप्तो मुक्तिं प्राप्स्यस्यनुत्तमाम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004075067, "chapter_id": 24075, "verse_number": "४-२४-६८", "content_sanskrit": "अन्यच्च शृणु राजेंद्र त्वया यत्समुदीरितम् ।\nकर्ता कारयिता शंभुः प्रासादस्येति तत्स्फुटम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004075068, "chapter_id": 24075, "verse_number": "४-२४-६९", "content_sanskrit": "सुकृतं नैव सततमाख्यातव्यं कदाचन ।\nकृतं मयेति कथनात्पुण्यं क्षयति तत्क्षणात् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004075069, "chapter_id": 24075, "verse_number": "४-२४-७०", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन गोपनीयं निधानवत् ।\nसुकृतं कीर्तनाद्व्यर्थं भवेद्भस्महुतं तथा ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004075070, "chapter_id": 24075, "verse_number": "४-२४-७१", "content_sanskrit": "निश्चितं विश्वनाथेन प्रेरितेन त्वयाऽनघ ।\nकृतं हि कृतकृत्येन प्रासादादिह वेद्म्यहम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004075071, "chapter_id": 24075, "verse_number": "४-२४-७२", "content_sanskrit": "वृद्धकालेश्वरं नाम लिंगमेतन्महीपते ।\nजानीह्यनादिसंसिद्धं निमित्तं किंतु वै भवान् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004075072, "chapter_id": 24075, "verse_number": "४-२४-७३", "content_sanskrit": "दर्शनात्स्पर्शनात्तस्य पूजनाच्छ्रवणान्नतेः ।\nवृद्धकालेशलिंगस्य सर्वं प्राप्नोति वांछितम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004075073, "chapter_id": 24075, "verse_number": "४-२४-७४", "content_sanskrit": "कूपः कालोदको नाम जराव्याधिविघातकृत् ।\nयदीय जलपानेन मातुःस्तन्यमपानवान् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004075074, "chapter_id": 24075, "verse_number": "४-२४-७५", "content_sanskrit": "कृतकूपोदकस्नानः कृतैतल्लिंगपूजनः ।\nवर्षेण सिद्धिमाप्नोति मनोभिलषितां नरः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004075075, "chapter_id": 24075, "verse_number": "४-२४-७६", "content_sanskrit": "न कुष्ठं न च विस्फोटा नरंघा न विचर्चिका ।\nपीतात्स्पृष्टात्प्रतिष्ठंति कफः कालतमोदकात् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004075076, "chapter_id": 24075, "verse_number": "४-२४-७७", "content_sanskrit": "नाग्निमांद्यं नैव शूलं न मेहो न प्रवाहिका ।\nन मूत्रकृच्छ्रं ना पामा पानायस्यास्य सेवनात् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004075077, "chapter_id": 24075, "verse_number": "४-२४-७८", "content_sanskrit": "भूतज्वराश्च ये केचिद्ये केचिद्विषमज्वराः ।\nते क्षिप्रमुपशाम्यंति ह्येतत्कूपोदसेवनात् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004075078, "chapter_id": 24075, "verse_number": "४-२४-७९", "content_sanskrit": "तवाग्रतो मम जरा पलितं च यथाविधि ।\nएतत्कूपोदपानेन क्षणान्नष्टं नवोऽभवम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004075079, "chapter_id": 24075, "verse_number": "४-२४-८०", "content_sanskrit": "वृद्धकालेश्वरे लिंगे सेवितेन दरिद्रता ।\nनोपसर्गा न वा रोगा न पापं नाघजं फलम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004075080, "chapter_id": 24075, "verse_number": "४-२४-८१", "content_sanskrit": "उत्तरे कृत्तिवासस्य वाराणस्यां प्रयत्नतः ।\nवृद्धकालेश्वरं लिंगं द्रष्टव्यं सिद्धिकामुकैः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004075081, "chapter_id": 24075, "verse_number": "४-२४-८२", "content_sanskrit": "इत्युक्त्वा तं महीपालं हस्ते धृत्वा तपोधनः ।\nसानंगलेखा राज्ञीकं तस्मिंल्लिंगे लयं ययौ ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004075082, "chapter_id": 24075, "verse_number": "४-२४-८३", "content_sanskrit": "महाकाल महाकाल महाकालेति कीर्तनात् ।\nशतधा मुच्यते पापैर्नात्र कार्या विचारणा ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004075083, "chapter_id": 24075, "verse_number": "४-२४-८४", "content_sanskrit": "इत्थं भवित्री ते मुक्तिः कैटभारातिदर्शनात् ।\nभोगान्भुक्त्वा बहुविधान्वैकुंठ नगरे शुभे ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004075084, "chapter_id": 24075, "verse_number": "४-२४-८५", "content_sanskrit": "इति संहृष्टतनूरुहः स विप्रो भगवत्तद्गणवक्त्रतो निशम्य ।\nस्वमुदर्कमथार्ककोटिरम्यं हरिलोकं परिलोकयांचकार ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004075085, "chapter_id": 24075, "verse_number": "४-२४-८६", "content_sanskrit": "मैत्रावरुणिरुवाच ।\nलोपामुद्रे स विप्रेंद्रो भोगान्भुक्त्वा मनोरमान् ।\nमायापुर्यां कृतप्राणत्याग पुण्यबलेन च ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004075086, "chapter_id": 24075, "verse_number": "४-२४-८७", "content_sanskrit": "वैकुंठलोकादागत्य पत्तने नंदिवर्धने ।\nभौमानि भुक्त्वा सौख्यानि पुत्रानुत्पाद्य सुंदरान् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004075087, "chapter_id": 24075, "verse_number": "४-२४-८८", "content_sanskrit": "तेषु राज्यं विनिक्षिप्य प्राप्य वाराणसीं पुरीम् ।\nविश्वेश्वरं समाराध्य निर्वाणपदमीयिवान् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004075088, "chapter_id": 24075, "verse_number": "४-२४-८९", "content_sanskrit": "एतत्पुण्यतमाख्यानं विप्रस्य शिवशर्मणः ।\nश्रुत्वा पापविनिर्मुक्तो ज्ञानं परममृच्छति ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}]