[{"id": 2034281, "chapter_id": 1739, "verse_number": "४-६२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2034282, "chapter_id": 1739, "verse_number": "४-६२-१", "content_sanskrit": "एवं विद्राव्य तत्सैन्यं पार्थो भीष्ममुपाद्रवत्।\nत्रस्तेषु सर्वसैन्येषु कौरव्यस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2034283, "chapter_id": 1739, "verse_number": "४-६२-२", "content_sanskrit": "बाणान्धनुषि संधाय चतुरः पाकशासनिः।\nभीष्मं च प्राहिणोद्भीतस्तं द्वाभ्यामभ्यवादयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2034284, "chapter_id": 1739, "verse_number": "४-६२-३", "content_sanskrit": "तस्य कर्णान्तिकं गत्वा द्वावब्रूतां च कौशलम् ।\nसोऽप्याशीरवदद्भीष्मः कौन्तेयो जयतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2034285, "chapter_id": 1739, "verse_number": "४-६२-४", "content_sanskrit": "नरसिंहमुपायान्तं जिगीषन्तं परान्रणे।\nवृषसेनोऽभ्ययात्तूर्णं योद्धुकामो धनंजयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2034286, "chapter_id": 1739, "verse_number": "४-६२-५", "content_sanskrit": "वैकर्तनात्मजो वीरः संग्रामे लोकविश्रुतः।\nशौर्यवीर्यादिभिः कर्णाद्बिम्बाद्विम्ब इवोद्धृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2034287, "chapter_id": 1739, "verse_number": "४-६२-६", "content_sanskrit": "आत्मना युध्यतस्तस्य वृषसेनस्य पाण्डवः ।\nमुहूर्तं तस्य तद्दृष्ट्वा हस्तलाघवपौरुषे।\nतुतोष च ततः पार्थो वृषसेनपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2034288, "chapter_id": 1739, "verse_number": "४-६२-७", "content_sanskrit": "तस्य पार्थस्तदा क्षिप्रं क्षुरधारेण कार्मुकम् ।\nन्यकृन्यद्गृध्रपत्रेण जाम्बूनदपरिष्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2034289, "chapter_id": 1739, "verse_number": "४-६२-८", "content_sanskrit": "अथैनं पञ्चभिर्भूयः प्रत्यविध्यत्स्तनान्तरे।\nस पार्थबाणाभिहतो रथात्प्रस्कन्द्य दुद्रुवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2034290, "chapter_id": 1739, "verse_number": "४-६२-९", "content_sanskrit": "दुःशासनो विकर्णश्च शकुनिश्च विविंशतिः।\nआयान्तं भीमधन्वानं पर्यकीर्यन्त पाण्डवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2034291, "chapter_id": 1739, "verse_number": "४-६२-१०", "content_sanskrit": "तेषां पार्थो रणे क्रुद्धः शरैः सन्नतपर्वभिः ।\nयुगं ध्वजं शरासं च चिच्छेद तरसा रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2034292, "chapter_id": 1739, "verse_number": "४-६२-११", "content_sanskrit": "ते निकृत्तध्वजाः सर्वे छिन्नकार्मुकवेष्टनाः ।\nरणमध्यादपययुः पार्थबाणाभिपीडिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2034293, "chapter_id": 1739, "verse_number": "४-६२-१२", "content_sanskrit": "ततः प्रहस्य बीभत्सुर्वैराटिमिदमब्रवीत् ।\nएतं मे प्रापयेदानीं तालं सौवर्णमुच्छ्रितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2034294, "chapter_id": 1739, "verse_number": "४-६२-१३", "content_sanskrit": "मेघमध्ये यथा विद्युदुज्ज्वलन्ती पुनः पुनः ।\nअसौ शान्तनवो भीष्मस्तत्र याहि परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2034295, "chapter_id": 1739, "verse_number": "४-६२-१४", "content_sanskrit": "अस्राणि तस्य दिव्यानि दर्शयिष्यामि संयुगे।\nघोररूपाणि चित्राणि लघूनि च गुरूणि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2034296, "chapter_id": 1739, "verse_number": "४-६२-१५", "content_sanskrit": "अस्माकं पोषको नित्यमाबाल्यान्मत्स्यभूमिप।\nश्रेयस्कामी सदाऽस्माकं योगक्षेमकरः सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2034297, "chapter_id": 1739, "verse_number": "४-६२-१६", "content_sanskrit": "तस्याङ्के विर्धितो बाल्ये तद्योत्स्येऽनेन सांप्रतम्।\nअस्माकं धार्तराष्ट्राणां शमकामो दिवानिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2034298, "chapter_id": 1739, "verse_number": "४-६२-१७", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2034299, "chapter_id": 1739, "verse_number": "४-६२-१७", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा वैराटिः पार्थसारथिः।\nवाहयच्चोदितस्तेन रथं भीष्मरथं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2034300, "chapter_id": 1739, "verse_number": "४-६२-१८", "content_sanskrit": "तं रथं चोदितं दृष्ट्वा फल्गुनस्य रथोत्तमम् ।\nवायुनेव महामेघं सहसाऽभिसमीरितम्।\nतं प्रत्ययाच्च गाङ्गेयो रथेनादित्यवर्चसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2034301, "chapter_id": 1739, "verse_number": "४-६२-१९", "content_sanskrit": "आयान्तमर्जुनं दृष्ट्वा भीष्मः परपुंजयः।\nप्रत्युञ्जगाम युद्धार्थी महर्षभमिवर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2034302, "chapter_id": 1739, "verse_number": "४-६२-२०", "content_sanskrit": "तथा हि गुप्त एतेषां दुराधर्षः पितामहः ।\nहन्यमानेषु योघेषु धनंजयमुपाद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2034303, "chapter_id": 1739, "verse_number": "४-६२-२१", "content_sanskrit": "प्रगृह्य कार्मुकश्रेष्ठं जातरूपपरिष्कृतम् ।\nशरानादाय तीक्ष्णाग्रान्मर्मदेहप्रमाथिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2034304, "chapter_id": 1739, "verse_number": "४-६२-२२", "content_sanskrit": "पाण्डुरेणातपत्रेण ध्रियमाणेन मूर्धनि ।\nशुशुभे स नरव्याघ्रो गिरिः सूर्योत्तरे यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2034305, "chapter_id": 1739, "verse_number": "४-६२-२३", "content_sanskrit": "प्राध्माप्य शङ्खं गाङ्गेयो धार्तराष्ट्रान्प्रहर्षयन् ।\nप्रदक्षिणमुपावृत्य बीभत्सुं प्रत्यवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2034306, "chapter_id": 1739, "verse_number": "४-६२-२४", "content_sanskrit": "तमवेक्ष्य समायान्तं कौन्तेयः परवीरहा ।\nप्रत्यगृह्णादमेयात्मा प्रियातिथिमिवागतम् ।\nदेवदत्तं महाशङ्खं प्रदध्मौ युधि वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2034307, "chapter_id": 1739, "verse_number": "४-६२-२५", "content_sanskrit": "तौ शङ्खनादावत्यर्थं भीष्मपाण्डवयोस्तदा ।\nनादयामासतुर्द्यां च खं च भूमिं च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2034308, "chapter_id": 1739, "verse_number": "४-६२-२६", "content_sanskrit": "अन्तरिक्षे च जल्पन्ति सर्वे देवाः सवासवाः ।\nयदर्जुनः कुरून्सर्वान्प्राकृन्तच्छस्रतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2034309, "chapter_id": 1739, "verse_number": "४-६२-२७", "content_sanskrit": "कुरुश्रेष्ठाविमौ वीरौ रणे भीष्मधनंजयौ ।\nसर्वास्त्रकुशलौ वीरावप्रमत्तौ रणे सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2034310, "chapter_id": 1739, "verse_number": "४-६२-२८", "content_sanskrit": "उभौ देवमनुष्येषु विश्रुतौ स्वपराक्रमैः ।\nउभौ परमसंरब्धावुभौ दीप्तधनुर्धरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2034311, "chapter_id": 1739, "verse_number": "४-६२-२९", "content_sanskrit": "समागतौ नरव्याघ्रौ व्याघ्राविव तरस्विनौ ।\nउभौ सदृशकर्माणौ सूर्यस्याग्नेश्च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2034312, "chapter_id": 1739, "verse_number": "४-६२-३०", "content_sanskrit": "वासुदेवस्य सदृशौ कार्तवीर्यसमावुभौ ।\nउभौ विश्रुतकर्माणावुभौ शूरौ महाबलौ ।\nसर्वास्त्रविदुषां श्रेष्ठौ सर्वशस्त्रभृतां वरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2034313, "chapter_id": 1739, "verse_number": "४-६२-३१", "content_sanskrit": "अग्नेरिन्द्रस्य सोमस्य यमस्य वरुणस्य च ॥\nअनयोः सदृशं वीर्यं मित्रस्य वरुणस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2034314, "chapter_id": 1739, "verse_number": "४-६२-३२", "content_sanskrit": "को वा कुन्तीसुतं युद्धे द्वैरथेनोपयास्यति।\nऋते शान्तनवादन्यः क्षत्रियो भुवि विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2034315, "chapter_id": 1739, "verse_number": "४-६२-३३", "content_sanskrit": "इति संपूजयामासुर्भीष्मं दृष्ट्वाऽर्जुनं गतम् ।\nतं रणे संप्रहृष्यन्तं दृष्ट्वा देवाः सवासवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2034316, "chapter_id": 1739, "verse_number": "४-६२-३४", "content_sanskrit": "अथ बहुविधतूर्यशङ्खयोषैर्विविधरवैः सह सिंहनादमिश्रैः ।\nकुरुवृषभमपूजयत्कुरूणां बलममराधिपसैन्यसप्रभं तत् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2034317, "chapter_id": 1739, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि द्विषष्टितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]