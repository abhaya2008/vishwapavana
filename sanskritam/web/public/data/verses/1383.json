[{"id": 2018404, "chapter_id": 1383, "verse_number": "३-२१-०x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2018405, "chapter_id": 1383, "verse_number": "३-२१-१", "content_sanskrit": "एवं स पुरुषव्याघ्रः साल्वो राज्ञं महारिपुः।\nयुध्यमानो मया सङ्ख्ये वियदभ्यगमत्पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2018406, "chapter_id": 1383, "verse_number": "३-२१-२", "content_sanskrit": "ततः शतघ्नीश्च महागदाश्च\nदीप्ताश्च शूलान्मुसलानसींश्च।\nचिक्षेप रोषान्मयि मन्दबुद्धिः\nसाल्वो महाराज जयाभिकाङ्क्षी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2018407, "chapter_id": 1383, "verse_number": "३-२१-३", "content_sanskrit": "तानाशुगैरापततोऽहमाशु\nनिवार्य तूर्णं खगमान्ख एव।\nद्विधा त्रिता चाच्छिनमाशु मुक्तै-\nस्ततोऽन्तरिक्षे निनदो बभूव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2018408, "chapter_id": 1383, "verse_number": "३-२१-४", "content_sanskrit": "ततः शतसहस्रेण शराणां नतपर्वणाम्।\nदारुकं वाजिनश्चैव रथं च समवाकिरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2018409, "chapter_id": 1383, "verse_number": "३-२१-५", "content_sanskrit": "ततो मामब्रवीद्वीर दारुको विह्वलन्निव।\nस्थातव्यमिति तिष्ठामि साल्वबाणप्रपीडितः।\nअवस्थातुं न शक्नोमि अङ्गं मे व्यवसीदति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2018410, "chapter_id": 1383, "verse_number": "३-२१-६", "content_sanskrit": "इति तस्य निशम्याहं सारथेः करुणं वचः।\nअवेक्षमाणो यन्तारमपश्यं शरपीडितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2018411, "chapter_id": 1383, "verse_number": "३-२१-७", "content_sanskrit": "न तस्योरसि नो मूर्ध्नि न काये न भुजद्वये।\nअन्तरं पाण्डवश्रेष्ठ पश्याम्यनिचितं शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2018412, "chapter_id": 1383, "verse_number": "३-२१-८", "content_sanskrit": "स तु बाणवरोत्पीडाद्विस्रवत्यसृगुल्बणम्।\nअभिवृष्टो यथा मेघैर्गिरिर्गैरिकधातुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2018413, "chapter_id": 1383, "verse_number": "३-२१-९", "content_sanskrit": "अभीशुहस्तं तं दृष्ट्वा सीदन्तं सारथिं रणे।\nअस्तम्भयं महाबाहो साल्वबाणप्रपीडितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2018414, "chapter_id": 1383, "verse_number": "३-२१-१०", "content_sanskrit": "अथ मां पुरुषः कश्चिद्द्वारकानिलयोऽब्रवीत्।\nत्वरितो रथमारोप्य सौहृदादिव भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2018415, "chapter_id": 1383, "verse_number": "३-२१-११", "content_sanskrit": "आहुकस्य वचो वीर तस्यैव परिचारकः।\nविषण्णः सन्नकण्ठेन तन्निबोध युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2018416, "chapter_id": 1383, "verse_number": "३-२१-१२", "content_sanskrit": "द्वारकाधिपतिर्वीर आह त्वामाहुको वचः।\nकेशवैहि विजानीष्व यत्त्वां पितृसखोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2018417, "chapter_id": 1383, "verse_number": "३-२१-१३", "content_sanskrit": "उपयात्वा तु साल्वेन द्वारकां वृष्णिनन्दन।\nविषक्ते त्वयि दुर्धर्ष इतः शूरसुतो बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2018418, "chapter_id": 1383, "verse_number": "३-२१-१४", "content_sanskrit": "तदलं साधुयुद्धेन निवर्तस्व जनार्दन।\nद्वारकामेव रक्षस्व कार्यमेतन्महत्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2018419, "chapter_id": 1383, "verse_number": "३-२१-१५", "content_sanskrit": "इत्यहं तस्य वचनं श्रुत्वा परमदुर्मनाः।\nनिश्चयं नाधिगच्छामि कर्तव्यस्येतरस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2018420, "chapter_id": 1383, "verse_number": "३-२१-१६", "content_sanskrit": "सात्यकिं बलदेवं च प्रद्युम्नं च महांरथम्।\nजगर्हे मनसा वीर तच्छ्रुत्वा महदप्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2018421, "chapter_id": 1383, "verse_number": "३-२१-१७", "content_sanskrit": "अहं हि द्वारकायाश्च पितुश्च कुरुनन्दन।\nतेषु रक्षां समाधाय प्रयातः सौभयातने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2018422, "chapter_id": 1383, "verse_number": "३-२१-१८", "content_sanskrit": "बलदेवो महाबाहुः कच्चिज्जीवति शत्रुहा।\nसात्यकी रौक्मिणेयश्च चारुदेष्णश्च वीर्यवान्।\nसाम्बप्रभृतयश्चैवेत्यहमासं सुदुर्मनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2018423, "chapter_id": 1383, "verse_number": "३-२१-१९", "content_sanskrit": "एतेषु हि नरव्याघ्र जीवत्सु न कथंचन।\nशक्यः शूरसुतो हन्तुमपि वज्रभृता स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2018424, "chapter_id": 1383, "verse_number": "३-२१-२०", "content_sanskrit": "हतः शूरसुतो व्यक्तं व्यक्तं चैते परासवः।\nबलदेवमुखाः सर्व इति मे निश्चिता मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2018425, "chapter_id": 1383, "verse_number": "३-२१-२१", "content_sanskrit": "सोहं सर्वविनाशं तं चिन्तयानो मुहुर्मुहुः।\nअविह्वलो महाराज पुनः साल्वमयोधयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2018426, "chapter_id": 1383, "verse_number": "३-२१-२२", "content_sanskrit": "तदोऽपश्यं महाराज प्रपतन्तमहं तदा।\nसौभाच्छूरसुतं वीर ततो मां मोह आविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2018427, "chapter_id": 1383, "verse_number": "३-२१-२३", "content_sanskrit": "तस्य रूपं प्रपततः पितुर्मम नराधिप।\nययातेः क्षीणपुण्यस्य स्वर्गादिव भहीतलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2018428, "chapter_id": 1383, "verse_number": "३-२१-२४", "content_sanskrit": "विशीर्णमलिनोष्णीपप्रकीर्णाम्बरमूर्धजः।\nप्रपतन्दृश्यते ह स्म क्षीणपुण्य इव ग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2018429, "chapter_id": 1383, "verse_number": "३-२१-२५", "content_sanskrit": "ततः शार्ङ्गं धनुःश्रेष्ठं करात्प्रपतितं मम।\nमोहापन्नश्च कौन्तेय रथोपस्थ उपाविशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2018430, "chapter_id": 1383, "verse_number": "३-२१-२६", "content_sanskrit": "ततो हाहाकृतं सर्वं सैन्यं मे गतचेतनम्।\nमां दृष्ट्वा रथनीडस्थं गतासुमिव भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2018431, "chapter_id": 1383, "verse_number": "३-२१-२७", "content_sanskrit": "प्रसार्य बाहू पततः प्रसार्य चरणावपि।\nरूपं पितुर्मे विबभौ शकुने- पततो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2018432, "chapter_id": 1383, "verse_number": "३-२१-२८", "content_sanskrit": "तं पतन्तं महाबाहो शूलपट्टसपाणयः।\nअभिघ्नन्तो भृशं वीर मम चोतोह्यकम्पयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2018433, "chapter_id": 1383, "verse_number": "३-२१-२९", "content_sanskrit": "ततो मुहूर्तात्प्रतिलभ्य संज्ञा-\nमहं तदा वीर महाविमर्दे।\nन तत्रसौमं न रिपुं च साल्वं\nपश्यामि वृद्धं पितरं न चापि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2018434, "chapter_id": 1383, "verse_number": "३-२१-३०", "content_sanskrit": "ततो ममासीन्मनसि मायेयमिति निश्चितम्।\nप्रबुद्धोस्मि ततो भूयः शतशो वाऽकिरं शरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2018435, "chapter_id": 1383, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि अर्जुनाभिगमनपर्वणि एकविंशोऽध्यायः ॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]