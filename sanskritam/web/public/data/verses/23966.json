[{"id": 7003966000, "chapter_id": 23966, "verse_number": "३-१-२९-१", "content_sanskrit": "श्रीसूत उवाच ।\nस्नात्वा साध्यामृते तीर्थे नृपशापविमोक्षणे ।\nसर्वतीर्थं ततो गच्छेन्मनुजो नियमान्वितः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003966001, "chapter_id": 23966, "verse_number": "३-१-२९-२", "content_sanskrit": "सर्वतीर्थं महापुण्यं महापातकनाशनम् ।\nमहापातकयुक्तो वा युक्तो वा सर्वपातकैः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003966002, "chapter_id": 23966, "verse_number": "३-१-२९-३", "content_sanskrit": "शुद्ध्येत तत्क्षणादेव सवर्तीर्थनिमज्जनात् ।\nतावत्सर्वाणि पापानि देहे तिष्ठंति सुव्रताः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003966003, "chapter_id": 23966, "verse_number": "३-१-२९-४", "content_sanskrit": "न यावत्सर्वतीर्थेस्मिन्निमज्जेत्पापपूरुषः ।\nस्नानार्थं सर्वतीर्थेऽस्मिन्दृष्ट्वा यांतं द्विजा नरम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003966004, "chapter_id": 23966, "verse_number": "३-१-२९-५", "content_sanskrit": "वेपंते सर्वपापानि नाशोऽस्माकं भवेदिति ।\nगर्भवासादिदुःखानि तावद्याति नरो भुवि॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003966005, "chapter_id": 23966, "verse_number": "३-१-२९-६", "content_sanskrit": "न स्नायात्सर्वतीर्थेऽस्मिन्यावद्ब्राह्मणपुंगवाः ।\nअनुष्ठितैर्महायागैस्तथा तीर्थनिषेवणैः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003966006, "chapter_id": 23966, "verse_number": "३-१-२९-७", "content_sanskrit": "गायत्र्यादिमहामंत्रजपैर्नियमपूर्वकम् ।\nचतुर्णामपि वेदानामावृत्त्या शतसंख्यया॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003966007, "chapter_id": 23966, "verse_number": "३-१-२९-८", "content_sanskrit": "शिवविष्ण्वादिदेवानां पूजया भक्ति पूर्वकम् ।\nएकादश्यादितिथिषु तथैवानशनेन च ।\nयत्फलं लभते मर्त्यस्तल्लभेदत्र मज्जनात्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003966008, "chapter_id": 23966, "verse_number": "३-१-२९-९", "content_sanskrit": "ऋषय ऊचुः ।\nसर्वतीर्थमिति ख्यातिः सूतास्य कथमागता ।\nब्रूह्यस्माकमिदं पुण्यं विस्तराच्छृण्वतां मुने॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003966009, "chapter_id": 23966, "verse_number": "३-१-२९-१०", "content_sanskrit": "श्रीसूत उवाच ।\nपुरा सुचरितोनाम मुनिर्नियमसंयुतः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003966010, "chapter_id": 23966, "verse_number": "३-१-२९-११", "content_sanskrit": "भृगुवंशसमुद्भूतो जात्यंधो जरयातुरः ।\nअशक्तस्तीर्थयात्रायां नेत्राभावेन स द्विजाः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003966011, "chapter_id": 23966, "verse_number": "३-१-२९-१२", "content_sanskrit": "सर्वेषामेव तीर्थानां स्नातुकामो महामु निः ।\nदक्षिणांबुनिधौ पुण्यं गंधमादनपर्वतम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003966012, "chapter_id": 23966, "verse_number": "३-१-२९-१३", "content_sanskrit": "गत्वा शंकरमुद्दिश्य तपस्तेपे सुदुष्करम् ।\nत्रिकालमर्चयञ्छंभुमुपवासी जितेंद्रियः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003966013, "chapter_id": 23966, "verse_number": "३-१-२९-१४", "content_sanskrit": "तथा त्रिषवणस्नानात्तथैवातिथिपूजकः ।\nशिशिरे जलमध्यस्थो ग्रीष्मे पंचाग्निमध्यगः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003966014, "chapter_id": 23966, "verse_number": "३-१-२९-१५", "content_sanskrit": "वर्षास्वासारसहन अब्भक्षो वायुभोजनः ।\nउद्धूलनं त्रिपुंड्रं च भस्मना धारयन्सदा॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003966015, "chapter_id": 23966, "verse_number": "३-१-२९-१६", "content_sanskrit": "जाबालोपनिषद्रीत्या तथा रुद्राक्षधारकः ।\nएवमुग्रं तपश्चक्रे दशसंवत्सरं द्विजः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003966016, "chapter_id": 23966, "verse_number": "३-१-२९-१७", "content_sanskrit": "तपसा तस्य संतुष्टः शंकरश्चंद्रशेखरः ।\nप्रादुरासीन्मुनेस्तस्य द्विजाः सुचरितस्य वै॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003966017, "chapter_id": 23966, "verse_number": "३-१-२९-१८", "content_sanskrit": "समारुह्य महोक्षाणं भूतवृंदनिषेवितः ।\nगिरिजार्ध वपुः शूली सूर्यकोटिसमप्रभः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003966018, "chapter_id": 23966, "verse_number": "३-१-२९-१९", "content_sanskrit": "स्वभासा भासयन्सर्वा दिशो वितिमिरास्तदा ।\nभस्मपांडुरसर्वांगो जटामंडलमंडितः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003966019, "chapter_id": 23966, "verse_number": "३-१-२९-२०", "content_sanskrit": "अनंता दिमहानागविभूषणविभूषितः ।\nप्रादुर्भूतस्ततः शंभुः प्रादात्तस्य विलोचने॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003966020, "chapter_id": 23966, "verse_number": "३-१-२९-२१", "content_sanskrit": "आत्मावलोकनार्थाय शंकरो गिरिजापतिः ।\nततः सुचरितो विप्राः शंभुना दत्तदृग्द्वयः ।\nआलोक्य परमेशानं प्रतुष्टाव प्रसन्नधीः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003966021, "chapter_id": 23966, "verse_number": "३-१-२९-२२", "content_sanskrit": "सुचरित उवाच ।\nजय देव महेशान जय शंकर धूर्जटे॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003966022, "chapter_id": 23966, "verse_number": "३-१-२९-२३", "content_sanskrit": "जय ब्रह्मादिपूज्य त्वं त्रिपुरघ्न यमांतक ।\nजयोमेश महादेव कामांतक जयामल॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003966023, "chapter_id": 23966, "verse_number": "३-१-२९-२४", "content_sanskrit": "जय संसारवैद्य त्वं भूतपाल शिवाव्य य ।\nत्रियंबक नमस्तुभ्यं भक्तरक्षणदीक्षित॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003966024, "chapter_id": 23966, "verse_number": "३-१-२९-२५", "content_sanskrit": "व्योमकेश नमस्तुभ्यं जय कारुण्यविग्रह ।\nनीलकण्ठ नमस्तुभ्यं जय संसारमोचक॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003966025, "chapter_id": 23966, "verse_number": "३-१-२९-२६", "content_sanskrit": "महेश्वर नमस्तुभ्यं परमानंदविग्रह ।\nगंगाधर नमस्तुभ्यं विश्वेश्वर मृडाव्यय॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003966026, "chapter_id": 23966, "verse_number": "३-१-२९-२७", "content_sanskrit": "नमस्तुभ्यं भगवते वासुदेवाय शंभवे ।\nशर्वायोग्राय गर्भाय कैलासपतये नमः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003966027, "chapter_id": 23966, "verse_number": "३-१-२९-२८", "content_sanskrit": "रक्ष मां करुणासिंधो कृपादष्ट्यवलोकनात् ।\nमम वृत्तमनालोच्य त्राहि मां कृपया हर॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003966028, "chapter_id": 23966, "verse_number": "३-१-२९-२९", "content_sanskrit": "श्रीसूत उवाच ।\nइति स्तुतो महादेवस्तमेनमिदमभ्यधात् ।\nमुनिं सुचरितं विप्रा दयोदन्वानुमापतिः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003966029, "chapter_id": 23966, "verse_number": "३-१-२९-३०", "content_sanskrit": "महादेव उवाच ।\nमुने सुचरिताद्य त्वं वरं वरय कांक्षितम् ।\nवरं दातुं तवायातः पुण्येस्मिन्नाश्रमे शुभे ।\nइतीरितो मुनिः प्राह महादेवं दयानिधिम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003966030, "chapter_id": 23966, "verse_number": "३-१-२९-३१", "content_sanskrit": "सुचरित उवाच ।\nभगवंस्त्वं प्रसन्नो मे यदि स्याश्चंद्रशेखर॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003966031, "chapter_id": 23966, "verse_number": "३-१-२९-३२", "content_sanskrit": "तर्हि त्वां प्रवृणोम्यद्धा वरं मदभिकांक्षितम् ।\nजरापलितदेहोहं कुत्रचिद्गंतुमक्षमः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003966032, "chapter_id": 23966, "verse_number": "३-१-२९-३३", "content_sanskrit": "सर्वतीर्थेषु च स्नातुमाकांक्षा मम विद्यते ।\nतस्मात्सर्वेषु तीर्थेषु स्नानेन मनुजो हि यत् ।\nफलं प्राप्नोति मे ब्रूहि तत्फला वाप्तिसाधनम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003966033, "chapter_id": 23966, "verse_number": "३-१-२९-३४", "content_sanskrit": "महादेव उवाच ।\nअहमावाहयिष्यामि तीर्थान्यत्रैव कृत्स्नशः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003966034, "chapter_id": 23966, "verse_number": "३-१-२९-३५", "content_sanskrit": "रामस्य सेतुना पूते नगेऽस्मिन्गंधमादने ।\nइत्युक्त्वा स महादेवः पर्वते गन्धमादने॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003966035, "chapter_id": 23966, "verse_number": "३-१-२९-३६", "content_sanskrit": "तीर्थान्यावाहयामास मुनिप्रीत्यर्थमुत्तमः ।\nततस्सुचरितं प्राह शंकरः करुणानिधिः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003966036, "chapter_id": 23966, "verse_number": "३-१-२९-३७", "content_sanskrit": "मुने सुचरितेदं तु महापातकनाशनम् ।\nसांनिध्यात्सर्वतीर्थानां सर्वतीर्थाभिधं स्मृतम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003966037, "chapter_id": 23966, "verse_number": "३-१-२९-३८", "content_sanskrit": "मयात्र सर्वतीर्थानां मनसाकर्षणादिदम् ।\nमानसं तीर्थमित्याख्यां लप्स्यते भुक्तिमुक्तिदम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003966038, "chapter_id": 23966, "verse_number": "३-१-२९-३९", "content_sanskrit": "अतः सुचरितात्र त्वं स्नाहि सद्यो विमुक्तये ।\nमहापातकसंघानां दावानलसमद्युतौ॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003966039, "chapter_id": 23966, "verse_number": "३-१-२९-४०", "content_sanskrit": "काममोहभयक्रोधलोभरोगादिनाशने ।\nविना वेदांतविज्ञानं सद्योनिर्वाणकारणे॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003966040, "chapter_id": 23966, "verse_number": "३-१-२९-४१", "content_sanskrit": "जन्ममृत्य्वादिनक्रौघसंसारार्णवतारणे ।\nकुम्भीपाकादिसकलनरकाग्निविनाशने॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003966041, "chapter_id": 23966, "verse_number": "३-१-२९-४२", "content_sanskrit": "इतीरितः सुचरितः शम्भुना मदनारिणा ।\nसस्नौ विप्राः सर्वतीर्थे महादेवस्य संनिधौ॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003966042, "chapter_id": 23966, "verse_number": "३-१-२९-४३", "content_sanskrit": "स्नात्वोत्थितः सुचरितो ददृशेऽखिलमानवैः ।\nजरापलितनिर्मुक्तस्तरुणोऽतीव सुन्दरः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003966043, "chapter_id": 23966, "verse_number": "३-१-२९-४४", "content_sanskrit": "दृष्ट्वा स्वदेहसौंदर्यं ततः सुचरितो मुनिः ।\nश्लाघयामास तत्तीर्थं बहुधाऽन्ये च तापसाः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003966044, "chapter_id": 23966, "verse_number": "३-१-२९-४५", "content_sanskrit": "महादेवः सुचरितं बभाषे तदनंतरम् ।\nअस्य तीर्थस्य तीरे त्वं वसन्सुचरित द्विज॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003966045, "chapter_id": 23966, "verse_number": "३-१-२९-४६", "content_sanskrit": "स्नानं कुरुष्व सततं स्मरन्मां मुक्तिदायकम् ।\nदेशांतरीयतीर्थेषु मा व्रज ब्राह्मणोत्तम॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003966046, "chapter_id": 23966, "verse_number": "३-१-२९-४७", "content_sanskrit": "अस्य तीर्थस्य माहात्म्यान्मामंते प्राप्स्यसि ध्रुवम् ।\nअन्येऽपि येऽत्र स्नास्यंति तेऽपि मां प्राप्नुयुर्द्विज॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003966047, "chapter_id": 23966, "verse_number": "३-१-२९-४८", "content_sanskrit": "इत्युक्त्वा भगवानीशस्तत्रैवांतरधीयत ।\nतस्मिन्नंतर्हिते रुद्रे ततः सुचरितो मुनिः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003966048, "chapter_id": 23966, "verse_number": "३-१-२९-४९", "content_sanskrit": "अनेककालं निवसन्सर्वतीर्थस्य तीरतः ।\nस्नानं समाचरंस्तीर्थे मानसे नियमान्वितः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003966049, "chapter_id": 23966, "verse_number": "३-१-२९-५०", "content_sanskrit": "देहांते शंकरं प्राप सर्वबन्धविमोचितः ।\nसायुज्यं चापि संप्राप सर्वतीर्थस्य वैभवात्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003966050, "chapter_id": 23966, "verse_number": "३-१-२९-५१", "content_sanskrit": "एवं वः कथितं विप्राः सर्वतीर्थस्य वैभवम् ।\nएतत्पठन्वा शृण्वन्वा मुच्यते सर्व पातकैः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]