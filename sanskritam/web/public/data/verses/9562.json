[{"id": 5000562000, "chapter_id": 9562, "verse_number": "७-२७-१", "content_sanskrit": "कैलासं लङ्घयित्वाथ दशग्रीवः स रावणः ।\nआससाद महातेजा इन्द्रलोकं निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000562001, "chapter_id": 9562, "verse_number": "७-२७-२", "content_sanskrit": "तस्य राक्षससैन्यस्य समन्तादुपयास्यतः ।\nदेवलोकं ययौ शब्दो मथ्यमानार्णवोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000562002, "chapter_id": 9562, "verse_number": "७-२७-३", "content_sanskrit": "श्रुत्वा तु रावणं प्राप्तमिन्द्रश्चलित आसनात् ।\nअब्रवीत्तत्र तान् देवान् सर्वानेव समागतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000562003, "chapter_id": 9562, "verse_number": "७-२७-४", "content_sanskrit": "आदित्यान्सवसून्रुद्रान्विश्वान्साध्यान्मरुद्गणान् ।\nसज्जीभवत युद्धार्थं रावणस्य दुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000562004, "chapter_id": 9562, "verse_number": "७-२७-५", "content_sanskrit": "एवमुक्तास्तु शक्रेण देवाः शक्रसमा युधि ।\nसन्नह्य सुमहासत्त्वा युद्धश्रद्धासमन्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000562005, "chapter_id": 9562, "verse_number": "७-२७-६", "content_sanskrit": "स तु दीनः परित्रस्तो महेन्द्रो रावणं प्रति ।\nविष्णोः समीपमागत्य वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000562006, "chapter_id": 9562, "verse_number": "७-२७-७", "content_sanskrit": "विष्णो कथं करिष्यामि महावीर्यपराक्रमः ।\nअसौ हि बलवद्रक्षो युद्धार्थमभिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000562007, "chapter_id": 9562, "verse_number": "७-२७-८", "content_sanskrit": "वरप्रदानाद्बलवान्न खल्वन्येन हेतुना ।\nतत्तु सत्यवचः कार्यं यदुक्तं पद्मयोनिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000562008, "chapter_id": 9562, "verse_number": "७-२७-९", "content_sanskrit": "तद्यथा नमुचिर्वृत्रो बलिर्नरकशम्बरौ ।\nत्वद्बलं समवष्टभ्य मया दग्धास्तथा कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000562009, "chapter_id": 9562, "verse_number": "७-२७-१०", "content_sanskrit": "नह्यन्यो देवदेवेश त्वामृते मधुसूदन ।\nगतिः परायणं नास्ति त्रैलोक्ये सचराचरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000562010, "chapter_id": 9562, "verse_number": "७-२७-११", "content_sanskrit": "त्वं हि नारायणः श्रीमान्पद्मनाभः सनातनः ।\nत्वयेमे स्थापिता लोकाः शक्रश्चाहं सुरेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000562011, "chapter_id": 9562, "verse_number": "७-२७-१२", "content_sanskrit": "त्वया सृष्टमिदं सर्वं त्रैलोक्यं सचराचरम् ।\nत्वामेव भगवन्सर्वे प्रविशन्ति युगक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000562012, "chapter_id": 9562, "verse_number": "७-२७-१३", "content_sanskrit": "तदाचक्ष्व यथा तत्त्वं देवदेव मम स्वयम् ।\nअपि चक्रसहायस्त्वं योत्स्यसे रावणं प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000562013, "chapter_id": 9562, "verse_number": "७-२७-१४", "content_sanskrit": "एवमुक्तः स शक्रेण देवो नारायणः प्रभुः ।\nअब्रवीन्न परित्रासः कर्तव्यः श्रूयतां च मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000562014, "chapter_id": 9562, "verse_number": "७-२७-१५", "content_sanskrit": "न तावदेष दुष्टात्मा शक्यो जेतुं सुरासुरैः ।\nहन्तुं चापि समासाद्य वरदानेन दुर्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000562015, "chapter_id": 9562, "verse_number": "७-२७-१६", "content_sanskrit": "सर्वथा तु महत्कर्म करिष्यति बलोत्कटः ।\nराक्षसः पुत्रसहितो दृष्टमेतन्निसर्गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000562016, "chapter_id": 9562, "verse_number": "७-२७-१७", "content_sanskrit": "यत्तु मां त्वमभाषिष्ठ युद्ध्यस्वेति सुरेश्वर ।\nनाहं तं प्रतियोत्स्यामि रावणं राक्षसं युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000562017, "chapter_id": 9562, "verse_number": "७-२७-१८", "content_sanskrit": "नाहत्वा समरे शत्रुं विष्णुः प्रतिनिवर्तते ।\nदुर्लभश्चैव कामो ऽद्य वरगुप्ताद्धि रावणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000562018, "chapter_id": 9562, "verse_number": "७-२७-१९", "content_sanskrit": "प्रतिजाने च देवेन्द्र त्वत्समीपे शतक्रतो ।\nभविता ऽस्मि यथा ऽस्याहं रक्षसो मृत्युकारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000562019, "chapter_id": 9562, "verse_number": "७-२७-२०", "content_sanskrit": "अहमेव निहन्ता ऽस्मि रावणं सपुरःसरम् ।\nदेवता नन्दयिष्यामि ज्ञात्वा कालमुपागतम् ।\nएतत्ते कथितं तत्त्वं देवराज शचीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000562020, "chapter_id": 9562, "verse_number": "७-२७-२१", "content_sanskrit": "युद्ध्यस्व विगतत्रासः सर्वैः सार्धं महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000562021, "chapter_id": 9562, "verse_number": "७-२७-२२", "content_sanskrit": "यामि ज्ञात्वा कालमुपागतम् ।\nततो रुद्राः सहादित्या वसवो मरुतो ऽश्वनौ ।\nसन्नद्धा निर्ययुस्तूर्णं राक्षसानभितः पुरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000562022, "chapter_id": 9562, "verse_number": "७-२७-२३", "content_sanskrit": "एतस्मिन्नन्तरे नादः शुश्रुवे रजनीक्षये ।\nतस्य रावणसैन्यस्य प्रयुद्धस्य समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000562023, "chapter_id": 9562, "verse_number": "७-२७-२४", "content_sanskrit": "ते प्रयुद्धा महावीर्या ह्यन्योन्यमभिवीक्ष्य वै ।\nसङ्ग्राममेवाभिमुखा ह्यभवर्तन्त हृष्टवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000562024, "chapter_id": 9562, "verse_number": "७-२७-२५", "content_sanskrit": "ततो दैवतसैन्यनां सङ्क्षोभः समजायत ।\nतदक्षयं महासैन्यं दृष्ट्वा समरमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000562025, "chapter_id": 9562, "verse_number": "७-२७-२६", "content_sanskrit": "ततो युद्धं समभवेद्देवदानवरक्षसाम् ।\nघोरं तुमुलनिर्ह्रादं नानाप्रहरणोद्यतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000562026, "chapter_id": 9562, "verse_number": "७-२७-२७", "content_sanskrit": "एतस्मिन्नन्तरे शूरा राक्षसा घोरदर्शनाः ।\nयुद्धार्थं समवर्तन्त सचिवा रावणस्य ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000562027, "chapter_id": 9562, "verse_number": "७-२७-२८", "content_sanskrit": "मारीचश्च प्रहस्तश्च महापार्श्वमहोदरौ ।\nअकम्पनो निकुम्भश्च शुकः सारण एव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000562028, "chapter_id": 9562, "verse_number": "७-२७-२९", "content_sanskrit": "संह्लादो धूमकेतुश्च महादंष्ट्रो घटोदरः ।\nजम्बुमाली महाह्रादो विरूपाक्षश्च राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000562029, "chapter_id": 9562, "verse_number": "७-२७-३०", "content_sanskrit": "सुप्तघ्नो यज्ञकोपश्च दुर्मुखो दूषणः खरः ।\nत्रिशिराः करवीराक्षः सूर्यशत्रुश्च राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000562030, "chapter_id": 9562, "verse_number": "७-२७-३१", "content_sanskrit": "महाकायो ऽतिकायश्च देवान्तकनरान्तकौ ।\nएतैः सर्वैः परिवृतो महावीर्यो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000562031, "chapter_id": 9562, "verse_number": "७-२७-३२", "content_sanskrit": "रावणस्यार्यकः सैन्यं सुमाली प्रविवेश ह ।\nस दैवतगणान्सर्वान्नानाप्रहरणैः शितैः ।\nव्यध्वंसयत्सुसङ्क्रुद्धो वायुर्जलधरानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000562032, "chapter_id": 9562, "verse_number": "७-२७-३३", "content_sanskrit": "तद्दैवतबलं राम हन्यमानं निशाचरैः ।\nप्रणुन्नं सर्वतो दिग्भ्यः सिंहनुन्ना मृगा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000562033, "chapter_id": 9562, "verse_number": "७-२७-३४", "content_sanskrit": "एतस्मिन्नन्तरे शूरो वसूनामष्टमो वसुः ।\nसावित्र इति विख्यातः प्रविवेश रणाजिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000562034, "chapter_id": 9562, "verse_number": "७-२७-३५", "content_sanskrit": "तथा ऽ ऽदित्यौ महावीर्यौ त्वष्टा पूषा च दंशितौ ।\nनिंर्भयौ सह सैन्येन तदा प्राविशतां रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000562035, "chapter_id": 9562, "verse_number": "७-२७-३६", "content_sanskrit": "ततो युद्धं समभवत्सुराणां सह राक्षसैः ।\nक्रुद्धानां रक्षसां कीर्तिं समरेष्वनिवर्तिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000562036, "chapter_id": 9562, "verse_number": "७-२७-३७", "content_sanskrit": "ततस्ते राक्षसाः सर्वे विबुधान्समरे स्थितान् ।\nनानाप्रहरणैर्घोरैर्जघ्नुः शतसहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000562037, "chapter_id": 9562, "verse_number": "७-२७-३८", "content_sanskrit": "देवाश्च राक्षसान्घोरान्महाबलपराक्रमान् ।\nसमरे विमलैः शस्त्रैरुपनिन्युर्यमक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000562038, "chapter_id": 9562, "verse_number": "७-२७-३९", "content_sanskrit": "एतस्मिन्नन्तरे राम सुमाली नाम राक्षसः ।\nनानाप्रहरणैः क्रुद्धस्तत्सैन्यं सो ऽभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000562039, "chapter_id": 9562, "verse_number": "७-२७-४०", "content_sanskrit": "स दैवतबलं सर्वं नानाप्रहणैः शितैः ।\nव्यध्वंसयत सङ्क्रुद्धो वायुर्जलधरं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000562040, "chapter_id": 9562, "verse_number": "७-२७-४१", "content_sanskrit": "ते महाबाणवर्षैश्च शूलप्रासैः सुदारुणैः ।\nहन्यमानाः सुराः सर्वे न व्यतिष्ठन्त संहताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000562041, "chapter_id": 9562, "verse_number": "७-२७-४२", "content_sanskrit": "ततो विद्राव्यमाणेषु दैवतेषु सुमालिना ।\nवसूनामष्टमः क्रुद्धः सावित्रो वै व्यवस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000562042, "chapter_id": 9562, "verse_number": "७-२७-४३", "content_sanskrit": "संवृतः स्वैरथानीकैः प्रहरन्तं निशाचरम् ।\nविक्रमेण महातेजा वारयामास संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000562043, "chapter_id": 9562, "verse_number": "७-२७-४४", "content_sanskrit": "ततस्तयोर्महायुद्धमभवद्रोमहर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000562044, "chapter_id": 9562, "verse_number": "७-२७-४५", "content_sanskrit": "सुमालिनो वसोश्चैव समरेष्वनिवर्तिनोः ।\nततस्तस्य महाबाणैर्वसुना सुमहात्मना ।\nनिहतः पन्नगरथः क्षणेन विनिपातितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000562045, "chapter_id": 9562, "verse_number": "७-२७-४६", "content_sanskrit": "हत्वा तु संयुगे तस्य रथं बाणशतैश्चितम् ।\nगदां तस्य वधार्थाय वसुर्जग्राह पाणिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000562046, "chapter_id": 9562, "verse_number": "७-२७-४७", "content_sanskrit": "ततः प्रगृह्य दीप्ताग्रां कालदण्डोपमां गदाम् ।\nतां मूर्ध्नि पातयामास सावित्रो वै सुमालिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000562047, "chapter_id": 9562, "verse_number": "७-२७-४८", "content_sanskrit": "सा तस्योपरि चोल्काभा पतन्तीव बभौ गदा ।\nइन्द्रप्रमुक्ता गर्जन्ती गिराविव महाशनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000562048, "chapter_id": 9562, "verse_number": "७-२७-४९", "content_sanskrit": "तस्य नैवास्थि न शिरो न मांसं ददृशे तदा ।\nगदया भस्मतां नीतं निहतस्य रणाजिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000562049, "chapter_id": 9562, "verse_number": "७-२७-५०", "content_sanskrit": "तं दृष्ट्वा निहतं सङ्ख्ये राक्षसास्ते समन्ततः ।\nव्यद्रवन्सहिताः सर्वे क्रोशमानाः परस्परम् ।\nविद्राव्यमाणा वसुना राक्षसा नावतस्थिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000562050, "chapter_id": 9562, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे सप्तविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]