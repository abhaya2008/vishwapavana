[{"id": 2183642, "chapter_id": 4897, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2183643, "chapter_id": 4897, "verse_number": "१", "content_sanskrit": "किं पार्थिवेन कर्तव्यं किञ्च कृत्वा सुखी भवेत् ।\nतन्ममाचक्ष्व तत्त्वेन सर्वं धर्मभृतांवर\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2183644, "chapter_id": 4897, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2183645, "chapter_id": 4897, "verse_number": "२", "content_sanskrit": "हन्त तेऽहं प्रवक्ष्यामि शृणु कार्यैकनिश्चयम् ।\nयथा राज्ञेह कर्तव्यं यच्च कृत्वा सुखी भवेत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2183646, "chapter_id": 4897, "verse_number": "३", "content_sanskrit": "नत्वेवं वर्तितव्यं स्म यथेदमनुशुश्रुमः ।\nउष्ट्रस्य सुमहद् वृत्तं तन्निबोध युधिष्ठिर\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2183647, "chapter_id": 4897, "verse_number": "४", "content_sanskrit": "जातिस्मरो महानुष्ट्रः प्राजापत्ययुगोद्भवः ।\nतपः सुमहदातिष्ठदरण्ये संशितव्रतः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2183648, "chapter_id": 4897, "verse_number": "५", "content_sanskrit": "तपसस्तस्य चान्ते वै प्रीतिमानभवत् प्रभुः ।\nवरेण च्छन्दयामास ततश्चैनं पितामहः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2183649, "chapter_id": 4897, "verse_number": "", "content_sanskrit": "उष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2183650, "chapter_id": 4897, "verse_number": "६", "content_sanskrit": "भगवंस्त्वत्प्रसादान्मे दीर्घा ग्रीवा भवेदियम् ।\nयोजनानां शतं साग्रं या गच्छेच्चरितुं विभो\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2183651, "chapter_id": 4897, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2183652, "chapter_id": 4897, "verse_number": "७", "content_sanskrit": "एवमस्त्विति चोक्तः स वरदेन महात्मना ।\nप्रतिलभ्य वरं श्रेष्ठं ययावुष्ट्रः स्वकं वनम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2183653, "chapter_id": 4897, "verse_number": "८", "content_sanskrit": "स चकार तदाऽऽलस्यं वरदानात् स दुर्मतिः ।\nन चैच्छच्चरितुं गन्तुं दुरात्मा कालमोहितः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2183654, "chapter_id": 4897, "verse_number": "९", "content_sanskrit": "स कदाचित् प्रसार्यैवं तां ग्रीवां शतयोजनाम् ।\nचचार श्रान्तहृदयो वातश्चागात्ततो महान्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2183655, "chapter_id": 4897, "verse_number": "१०", "content_sanskrit": "स गुहायां शिरोग्रीवं निधाय पशुरात्मनः ।\nआस्ताथ वर्षमभ्यागात् सुमहत् प्लावयज्जगत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2183656, "chapter_id": 4897, "verse_number": "११", "content_sanskrit": "अथ शीतपरीताङ्गो जम्बुकः क्षुच्छ्रमान्वितः ।\nसदारस्तां गुहामाशु प्रविवेश जलार्दितः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2183657, "chapter_id": 4897, "verse_number": "१२", "content_sanskrit": "स दृष्ट्वा मांसजीवी तु सुभृशं क्षुच्छ्रमान्वितः ।\nअभक्षयत् ततो ग्रीवामुष्ट्रस्य भरतर्षभ\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2183658, "chapter_id": 4897, "verse_number": "१३", "content_sanskrit": "यदा त्वबुद्ध्यतात्मानं भक्ष्यमाणं स वै पशुः ।\nतदा सङ्कोचने यत्नमकरोद् भृशदुःखितः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2183659, "chapter_id": 4897, "verse_number": "१४", "content_sanskrit": "यावदूर्ध्वमधश्चैव ग्रीवां सङ्क्षिपते पशुः ।\nतावत् तेन सदारेण जम्बुकेन स भक्षितः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2183660, "chapter_id": 4897, "verse_number": "१५", "content_sanskrit": "स हत्वा भक्षयित्वा च उष्ट्रं तं जम्बुकस्तदा ।\nविगते वातवर्षे च निश्चक्राम गुहामुखात्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2183661, "chapter_id": 4897, "verse_number": "१६", "content_sanskrit": "एवं दुर्बुद्धिना प्राप्तमुष्ट्रेण निधनं तदा ।\nआलस्यकरणात् पश्य महद्दोषमुपागतम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2183662, "chapter_id": 4897, "verse_number": "१७", "content_sanskrit": "त्वमप्येतं विधिं त्यक्त्वा योगेन नियतेन्द्रियः ।\nवर्तस्व बुद्धिमूलं हि विजयं मनुरब्रवीत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2183663, "chapter_id": 4897, "verse_number": "१८", "content_sanskrit": "बुद्धिश्रेष्ठानि कर्माणि बाहुमध्यानि भारत ।\nतानि जङ्घाजघन्यानि भारप्रत्यवराणि च\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2183664, "chapter_id": 4897, "verse_number": "१९", "content_sanskrit": "राज्यं तिष्ठति दक्षस्य सङ्गृहीतेन्द्रियस्य च ।\nगुप्तमन्त्रश्रुतवतः सुसहायस्य चानघ\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2183665, "chapter_id": 4897, "verse_number": "२०", "content_sanskrit": "परीक्ष्यकारिणोऽर्थाश्च तिष्ठन्तीह युधिष्ठिर ।\nसहाययुक्तेन मही कृत्स्ना शक्या प्रशासितुम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2183666, "chapter_id": 4897, "verse_number": "२१", "content_sanskrit": "इदं हि सद्भिः कथितं विधिज्ञैः\nपुरा महेन्द्रप्रतिमप्रभाव ।\nमयापि चोक्तं तव शास्त्रदृष्ट्या\nत्वमत्र युक्तः प्रचरस्व राजन्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2183667, "chapter_id": 4897, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे चतुर्दशाधिकशततमोध्यायः ॥ ११४ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]