[{"id": 2171720, "chapter_id": 4663, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2171721, "chapter_id": 4663, "verse_number": "१", "content_sanskrit": "वृषसेनं हतं दृष्ट्वा शोकामर्षसमन्वितः ।\nमुक्त्वा शोकोद्भवं वारि नेत्राभ्यां सहसा वृषः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2171722, "chapter_id": 4663, "verse_number": "२", "content_sanskrit": "रथेन कर्णस्तेजस्वी जगामाभिमुखो रिपून् ।\nयुद्धायामर्षताम्राक्षः समाहूय धनञ्जयम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2171723, "chapter_id": 4663, "verse_number": "३", "content_sanskrit": "तौ रथौ सूर्यसङ्काशौ वैयाघ्रपरिवारणौ ।\nसमेतौ ददृशुस्तत्र द्वाविवार्कौ समागतौ\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2171724, "chapter_id": 4663, "verse_number": "४", "content_sanskrit": "श्वेताश्वौ पुरुषादित्यावास्थितावरिमर्दनौ ।\nशुशुभाते महात्मानौ चन्द्रादित्यौ यथा दिवि\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2171725, "chapter_id": 4663, "verse_number": "५", "content_sanskrit": "तौ दृष्ट्वा विस्मयं जग्मुः सर्वभूतानि मारिष ।\nत्रैलोक्यविजये यत्ताविन्द्रवैरोचनाविव\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2171726, "chapter_id": 4663, "verse_number": "६", "content_sanskrit": "रथज्यातळनिर्ह्रादैर्बाणशङ्खरवैरपि ।\nतौ रथावभिधावन्तौ समालोक्य महीक्षिताम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2171727, "chapter_id": 4663, "verse_number": "७", "content_sanskrit": "ध्वजौ च दृष्ट्वा संसक्तौ विस्मयः समपद्यत ।\nहस्तिकक्ष्यां च कर्णस्य वानरं च किरीटिनः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2171728, "chapter_id": 4663, "verse_number": "८", "content_sanskrit": "तौ रथौ सम्प्रसक्तौ च दृष्ट्वा भारत पार्थिवाः ।\nसिंहनादरवांश्चक्रुः साधुवादांश्च पुष्कलान्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2171729, "chapter_id": 4663, "verse_number": "९", "content_sanskrit": "श्रुत्वा तु द्वैरथं ताभ्यां तत्र योधाः समन्ततः ।\nचक्रुर्बाहुबलं चैव तथा चेलवलं महत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2171730, "chapter_id": 4663, "verse_number": "१०", "content_sanskrit": "आजग्मुः कुरवस्तत्र वादित्रानुगतास्तदा ।\nकर्णं प्रहर्षयन्तश्च शङ्खान् दध्मुश्च पुष्कलान्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2171731, "chapter_id": 4663, "verse_number": "११", "content_sanskrit": "तथैव पाण्डवाः सर्वे हर्षयन्तो धनञ्जयम् ।\nतूर्यशङ्खनिनादेन दिशः सर्वा व्यनादयन्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2171732, "chapter_id": 4663, "verse_number": "१२", "content_sanskrit": "क्ष्वेडितास्फोटितोत्क्रुष्टैस्तुमुलं सर्वतोऽभवत् ।\nबाहुघोषाश्च वीराणां कर्णार्जुनसमागमे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2171733, "chapter_id": 4663, "verse_number": "१३", "content_sanskrit": "तौ दृष्ट्वा पुरुषव्याघ्रौ रथस्थौ रथिनां वरौ ।\nप्रगृहीतमहाचापौ शरशक्तिगदायुधौ ।\nवर्मिणौ बद्धनिस्त्रिंशौ श्वेताश्वौ शङ्खशोभिनौ\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2171734, "chapter_id": 4663, "verse_number": "१४", "content_sanskrit": "कृष्णशल्यरथोपेतौ तुल्यरूपौ महारथौ ।\nसिंहस्कन्धौ सिंहभुजौ रक्ताक्षौ हेममालिनौ\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2171735, "chapter_id": 4663, "verse_number": "१५", "content_sanskrit": "चापविद्युल्लतोपेतौ शस्त्रसम्पत्तिशोभिनौ ।\nचामरव्यजनोपेतौ श्वेतच्छत्राभिशोभिनौ\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2171736, "chapter_id": 4663, "verse_number": "१६", "content_sanskrit": "तूणीरवरसम्पन्नौ द्वावपि स्म सुदर्शनौ\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2171737, "chapter_id": 4663, "verse_number": "१७", "content_sanskrit": "रक्तचन्दनदिग्धाङ्गौ समदौ वृषभाविव ।\nसिंहस्कन्धप्रतीकाशौ व्यूढोरस्कौ महाबलौ ।\nअन्योन्यस्पर्धिनौ राजन्नन्योन्यस्य वधैषिणौ\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2171738, "chapter_id": 4663, "verse_number": "१८", "content_sanskrit": "अन्योन्यमभिधावन्तौ गोष्ठेष्विव महर्षभौ ।\nप्रभिन्नाविव मातङ्गौ संरब्धाविव चाचलौ\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2171739, "chapter_id": 4663, "verse_number": "१९", "content_sanskrit": "आशीविषसमप्रख्यौ यमकालान्तकोपमौ\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2171740, "chapter_id": 4663, "verse_number": "२०", "content_sanskrit": "इन्द्रवृत्राविव क्रुद्धौ सूर्याचन्द्रमसप्रभौ ।\nमहाग्रहाविव क्रूरौ युगान्ते समुपस्थितौ \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2171741, "chapter_id": 4663, "verse_number": "२१", "content_sanskrit": "देवगर्भौ देवसमौ देवतुल्यौ च रूपतः ।\nयदृच्छया समेयातां सूर्याचन्द्रमसाविव\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2171742, "chapter_id": 4663, "verse_number": "२२", "content_sanskrit": "बलिनौ समरे दृप्तौ नानाशस्त्रधरौ युधि\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2171743, "chapter_id": 4663, "verse_number": "२३", "content_sanskrit": "उभौ वरायुधधरावुभौ रणकृतश्रमौ ।\nउभौ च बाहुशब्देन नादयन्तौ नभस्तलम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2171744, "chapter_id": 4663, "verse_number": "२४", "content_sanskrit": "उभौ विश्रुतकर्माणौ पौरुषेण बलेन च ।\nउभौ च सदृशौ युद्धे शम्बरामरराजयोः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2171745, "chapter_id": 4663, "verse_number": "२५", "content_sanskrit": "कार्तवीर्यसमौ वीर्ये तथा दाशरथेः समौ ।\nविष्णुवीर्यसमौ वीर्ये तथा भवसमौ युधि\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2171746, "chapter_id": 4663, "verse_number": "२६", "content_sanskrit": "उभौ श्वेतहयौ राजन्नश्वप्रवरवाहिनौ ।\nसारथी प्रवरौ चैव तयोरास्तां महाबलौ\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2171747, "chapter_id": 4663, "verse_number": "२७", "content_sanskrit": "तौ तु दृष्ट्वा महाराज राजमानौ महारथौ ।\nसिद्धचारणसङ्घानां विस्मयः समपद्यत\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2171748, "chapter_id": 4663, "verse_number": "२८", "content_sanskrit": "धार्तराष्ट्रास्ततः कर्णं सबला भरतर्षभ ।\nपरिवव्रुर्महात्मानं क्षिप्रमाहवशोभिनम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2171749, "chapter_id": 4663, "verse_number": "२९", "content_sanskrit": "तथैव पाण्डवा हृष्टा धृष्टद्युम्नपुरोगमाः ।\nपरिवव्रुर्महात्मानं पार्थमप्रतिमं युधि\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2171750, "chapter_id": 4663, "verse_number": "३०", "content_sanskrit": "तावकानां रणे कर्णो ग्लह आसीद् विशाम्पते ।\nतथैव पाण्डवेयानां ग्लहः पार्थोऽभवद् युधि\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2171751, "chapter_id": 4663, "verse_number": "३१", "content_sanskrit": "त एव सभ्यास्तत्रासन् प्रेक्षकाश्चाभवन् स्म ते ।\nतत्रैषां ग्लहमानानां धृतौ जयपराजयौ\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2171752, "chapter_id": 4663, "verse_number": "३२", "content_sanskrit": "ताभ्यां द्यूतं समायत्तं विजयायेतराय वा ।\nअस्माकं पाण्डवानां च स्थितानां रणमूर्धनि\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2171753, "chapter_id": 4663, "verse_number": "३३", "content_sanskrit": "तौ तु स्थितौ महाराज समरे युद्धशालिनौ ।\nअन्योन्यं प्रतिसंरब्धावन्योन्यस्य जयैषिणौ\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2171754, "chapter_id": 4663, "verse_number": "३४", "content_sanskrit": "तावुभौ प्रजिहीर्षेतामिन्द्रवृत्राविवाभितः ।\nभीमरूपधरावास्तां महाधूमाविव ग्रहौ\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2171755, "chapter_id": 4663, "verse_number": "३५", "content_sanskrit": "ततोऽन्तरिक्षे साक्षेपा विवादा भरतर्षभ ।\nमिथो भेदाश्च भूतानामासन्कर्णार्जुनान्तरे ।\nव्याश्रयन्त दिशो भिन्नाः सर्वलोकाश्च मारिष\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2171756, "chapter_id": 4663, "verse_number": "३६", "content_sanskrit": "देवदानवगन्धर्वाः पिशाचोरगराक्षसाः ।\nप्रतिपक्षग्रहं चक्रुः कर्णार्जुनसमागमे\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2171757, "chapter_id": 4663, "verse_number": "३७", "content_sanskrit": "द्यौरासीत् कर्णतो व्यग्रा सनक्षत्रा विशाम्पते ।\nभूमिर्विशाला पार्थस्य मातेव जयकाङ्क्षिणी\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2171758, "chapter_id": 4663, "verse_number": "३८", "content_sanskrit": "सरितः सागराश्चैव गिरयश्च नरोत्तम ।\nवृक्षाश्चौषधयस्तत्र व्याश्रयन्त किरीटिनम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2171759, "chapter_id": 4663, "verse_number": "३९", "content_sanskrit": "असुरा यातुधानाश्च गुह्यकाश्च परन्तप ।\nकर्णतः समपद्यन्त खेचराणि वयांसि च\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2171760, "chapter_id": 4663, "verse_number": "४०", "content_sanskrit": "रत्नानि निधयः सर्वे वेदाश्चाख्यानपञ्चमाः ।\nसोपवेदोपनिषदः सरहस्याः ससङ्ग्रहाः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2171761, "chapter_id": 4663, "verse_number": "४१", "content_sanskrit": "वासुकिश्चित्रसेनश्च तक्षकश्चोपतक्षकः ।\nसर्पाश्चैव तथा सर्वे काद्रवेयाश्च सान्वयाः ।\nविषवन्तो महारोषा नागाश्चार्जुनतोऽभवन्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2171762, "chapter_id": 4663, "verse_number": "४२", "content_sanskrit": "ऐरावताः सौरभेया वैशालेयाश्च भोगिनः ।\nएतेऽभवन्नर्जुनतः क्षुद्रसर्पास्तु कर्णतः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2171763, "chapter_id": 4663, "verse_number": "४३", "content_sanskrit": "ईहामृगा व्याल(ड)मृगा मङ्गल्याश्च मृगद्विजाः ।\nपार्थस्य विजयं राजन् सर्व एवाभिसंश्रिताः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2171764, "chapter_id": 4663, "verse_number": "४४", "content_sanskrit": "वसवो मरुतः साध्या रुद्रा विश्वेऽश्विनौ तथा ।\nअग्निरिन्द्रश्च सोमश्च पवनश्च दिशो दश ।\nधनञ्जयमुपाजग्मुरादित्याः कर्णतोऽभवन्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2171765, "chapter_id": 4663, "verse_number": "४५", "content_sanskrit": "विशः शूद्राश्च सूताश्च वर्णसङ्करजाश्च ये ।\nसर्वसत्त्वेषु ते राजन् राधेयमभजंस्तदा\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2171766, "chapter_id": 4663, "verse_number": "४६", "content_sanskrit": "देवास्तु पितृभिः सार्धं सगणार्जुनतोऽभवन् ।\nब्रह्म क्षत्रं च यज्ञाश्च दक्षिणाश्चार्जुनं श्रिताः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2171767, "chapter_id": 4663, "verse_number": "४७", "content_sanskrit": "देवब्रह्मनृपर्षीणां गणाः पाण्डवतोऽभवन् ।\nतुम्बुरुप्रमुखा राजन् गन्धर्वाश्च यतोऽर्जुनः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2171768, "chapter_id": 4663, "verse_number": "४८", "content_sanskrit": "प्रेताश्चैव पिशाशाश्च क्रव्यादाश्च मृगाण्डजाः ।\nराक्षसाः सह यादोभिः श्वसृगालाश्च कर्णतः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2171769, "chapter_id": 4663, "verse_number": "४९", "content_sanskrit": "यमो वैश्रवणश्चैव वरुणश्च यतोऽर्जुनः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2171770, "chapter_id": 4663, "verse_number": "५०", "content_sanskrit": "देवर्षिब्रह्मर्षिगणाः सर्वे च खचराश्च ये ।\nप्रावेयाः सह मौनेया गन्धर्वाप्सरसां गणाः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2171771, "chapter_id": 4663, "verse_number": "५१", "content_sanskrit": "उह्यमानास्तथा मेघैर्वायुना च मनीषिणः ।\nदिदृक्षवः समाजग्मुः कर्णार्जुनसमागमम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2171772, "chapter_id": 4663, "verse_number": "५२", "content_sanskrit": "देवदानवगन्धर्वा नागा यक्षाः पतत्रिणः ।\nमहर्षयो वेदविदः पितरश्च स्वधाभुजः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2171773, "chapter_id": 4663, "verse_number": "५३", "content_sanskrit": "तपो विद्यास्तथौषध्यो नानारूपबलान्विताः ।\nअन्तरिक्षे महाराज विनदन्तोऽवतस्थिरे\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2171774, "chapter_id": 4663, "verse_number": "५४", "content_sanskrit": "ब्रह्मा ब्रह्मर्षिभिः सार्धं प्रजापतिभिरेव च ।\nभवेनावस्थितो यानं दिव्यं तं देशमभ्ययात्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2171775, "chapter_id": 4663, "verse_number": "५५", "content_sanskrit": "द्वैपक्षमासीद् देवानामसुराणां तथैव च ।\nसमेतौ तौ महात्मानौ दृष्ट्वा कर्णधनञ्जयौ\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2171776, "chapter_id": 4663, "verse_number": "५६", "content_sanskrit": "यतः पार्थस्ततो देवा यतः कर्णस्ततोऽसुराः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2171777, "chapter_id": 4663, "verse_number": "५७", "content_sanskrit": "प्रजापतिरथोक्त्वैनं स्वयम्भुं समचोदयत् ।\nसमोऽस्तु देव विजय एतयोर्नरसिंहयोः \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2171778, "chapter_id": 4663, "verse_number": "५८", "content_sanskrit": "कर्णार्जुनविवादेन मा नश्येदखिलं जगत् ।\nतदुपश्रुत्य मघवा प्रणिपत्य पितामहम् \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2171779, "chapter_id": 4663, "verse_number": "५९", "content_sanskrit": "व्यज्ञापयत देवेशमिदं मतिमतां वरः ।\nपूर्वं भगवता प्रोक्तं कृष्णयोर्विजयो ध्रुवः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2171780, "chapter_id": 4663, "verse_number": "६०", "content_sanskrit": "तत् तथास्तु नमस्तेऽस्तु प्रसीद भगवन् मम\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2171781, "chapter_id": 4663, "verse_number": "६१", "content_sanskrit": "ब्रह्मेशानावथो वाक्यमूचतुस्त्रिदशेश्वरम् ।\nविजयो ध्रुव एवास्तु विजयस्य महात्मनः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2171782, "chapter_id": 4663, "verse_number": "६२", "content_sanskrit": "मनस्वी बलवान् शूरः कृतास्त्रश्च तपोधनः ।\nबिभर्ति च महातेजा धनुर्वेदमशेषतः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2171783, "chapter_id": 4663, "verse_number": "६३", "content_sanskrit": "पार्थः सर्वगुणोपेतो देवकार्यमिदं यतः ।\nक्लिश्यन्ते पाण्डवा नित्यं वनवासादिभिर्भृशम्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2171784, "chapter_id": 4663, "verse_number": "६४", "content_sanskrit": "सम्पन्नस्तपसा चैव पर्याप्तः पुरुषर्षभः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2171785, "chapter_id": 4663, "verse_number": "६५", "content_sanskrit": "अतिक्रामेच्च माहात्म्याद् दिष्टमप्यस्य पर्ययात् ।\nअतिक्रान्ते च लोकानामभावो नियतो भवेत्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2171786, "chapter_id": 4663, "verse_number": "६६", "content_sanskrit": "न विद्यते व्यवस्थानं कृष्णयोः क्रुद्धयोः क्वचित् ।\nस्रष्टारौ ह्यसतश्चोभौ सतश्च पुरुषर्षभौ\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2171787, "chapter_id": 4663, "verse_number": "६७", "content_sanskrit": "नरनारायणावेतौ पुराणावृषिसत्तमौ ।\nअनियत्तौ नियन्तारावभी(ती)तौ स्म परन्तपौ\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2171788, "chapter_id": 4663, "verse_number": "६८", "content_sanskrit": "कर्णो लोकानयं मुख्यान् प्राप्नोतु पुरुषर्षभः ।\nवीरो वैकर्तनः शूरो विजयस्त्वस्तु कृष्णयोः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2171789, "chapter_id": 4663, "verse_number": "६९", "content_sanskrit": "वसूनां च सलोकत्वं मरुतां वा समाप्नुयात् ।\nसहितो द्रोणभीष्माभ्यां नाकलोके महीयताम्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2171790, "chapter_id": 4663, "verse_number": "७०", "content_sanskrit": "तथोक्ते देवदेवाभ्यां सहस्राक्षोऽब्रवीद् वचः ।\nआमन्त्र्य सर्वभूतानि ब्रह्मेशानानुशासनात्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2171791, "chapter_id": 4663, "verse_number": "७१", "content_sanskrit": "श्रुतं भवद्भिर्यत्प्रोक्तं भगवद्भ्यां जगद्धितम् ।\nतत्तथा नान्यथा तद्धि तिष्ठध्वं गतमन्यवः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2171792, "chapter_id": 4663, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रुत्वेन्द्रवचनं सर्वभूतानि मारिष ।\nविस्मितान्यभवन् राजन् पूजयाञ्चक्रिरे च तत्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2171793, "chapter_id": 4663, "verse_number": "७३", "content_sanskrit": "व्यसृजंश्च सुगन्धीनि नानारूपाणि खात्तथा ।\nपुष्पवर्षाणि विबुधा देवतूर्याण्यवादयन्\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2171794, "chapter_id": 4663, "verse_number": "७४", "content_sanskrit": "दिदृक्षवश्चाप्रतिमं द्वैरथं नरसिंहयोः ।\nदेवदानवगन्धर्वाः सर्व एवावतस्थिरे\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2171795, "chapter_id": 4663, "verse_number": "७५", "content_sanskrit": "रथौ च तौ श्वेतहयौ युक्तकेतू महास्वनौ ।\nयौ तौ कर्णार्जुनौ राजन् प्रहृष्टावभ्यतिष्ठताम्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2171796, "chapter_id": 4663, "verse_number": "७६", "content_sanskrit": "समागता लोकवीराः शङ्खान् दध्मुः पृथक्पृथक् ।\nवासुदेवार्जुनौ वीरौ कर्णशल्यौ च भारत\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2171797, "chapter_id": 4663, "verse_number": "७७", "content_sanskrit": "तद्भीरुसन्त्रासकरं युद्धं समभवत् तदा ।\nअन्योन्यस्पर्धिनोः वीर्ये शक्रशम्बरयोरिव\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2171798, "chapter_id": 4663, "verse_number": "७८", "content_sanskrit": "तयोर्ध्वजौ वीतभयौ शुशुभाते रथस्थितौ ।\nराहुकेतू यथाकाशे क्रुद्धौ युद्धे परस्परम्\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2171799, "chapter_id": 4663, "verse_number": "७९", "content_sanskrit": "कर्णस्याशीविषनिभा रत्नसारवती दृढा ।\nपुरन्दरधनुःप्रख्या हस्तकाक्या व्यराजत\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2171800, "chapter_id": 4663, "verse_number": "८०", "content_sanskrit": "कपिश्रेष्ठस्तु पार्थस्य व्यादितास्यो भयङ्करः ।\nभीषयन्नेव दंष्ट्राभिर्दुर्निरीक्ष्यो रविर्यथा\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2171801, "chapter_id": 4663, "verse_number": "८१", "content_sanskrit": "युद्धाभिलाषुको भूत्वा ध्वजो गाण्डीवधन्वनः ।\nकर्णध्वजमुपातिष्ठत् स्वस्थानाद् वेगवान् कपिः\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2171802, "chapter_id": 4663, "verse_number": "८२", "content_sanskrit": "उत्पत्य तु महावेगः काकमभ्याहनत् कपिः ।\nनखैश्च दशनैश्चैव गरुडः पन्नगं यथा\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2171803, "chapter_id": 4663, "verse_number": "८३", "content_sanskrit": "सा किङ्किणीकाभरणा कालपाशोपमाऽऽयसी ।\nअभ्यद्रवत्सुसङ्क्रुद्धा हस्तकाक्याऽथ तं कपिम्\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2171804, "chapter_id": 4663, "verse_number": "८४", "content_sanskrit": "तयोर्घोरतमे युद्धे द्वैरथे द्यूत आहृते ।\nप्रकुर्वाते ध्वजौ युद्धं प्रत्यहेषन् हयान् हयाः\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2171805, "chapter_id": 4663, "verse_number": "८५", "content_sanskrit": "अविध्यत् पुण्डरीकाक्षः शल्यं नयनसायकैः ।\nस चापि पुण्डरीकाक्षं तथैवाभिसमैक्षत\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2171806, "chapter_id": 4663, "verse_number": "८६", "content_sanskrit": "तत्राजयद् वासुदेवः शल्यं नयनसायकैः ।\nकर्णं चाप्यजयद् दृष्ट्या कुन्तीपुत्रो धनञ्जयः\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2171807, "chapter_id": 4663, "verse_number": "८७", "content_sanskrit": "अथाब्रवीत् सूतपुत्रः शल्यमाभाष्य सस्मितम् ।\nयद्यर्जुनो रणे हन्यादद्य मामिह कर्हिचित् ।\nकिमुत्तरं तदा ते स्यात्सखे सत्यं ब्रवीहि मे\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2171808, "chapter_id": 4663, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2171809, "chapter_id": 4663, "verse_number": "८८", "content_sanskrit": "यदि कर्ण रणे हन्यादद्य त्वां श्वेतवाहनः ।\nउभावेकरथेनाहं हन्यां माधवपाण्डवौ\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2171810, "chapter_id": 4663, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2171811, "chapter_id": 4663, "verse_number": "८९", "content_sanskrit": "एवमेव तु गोविन्दमर्जुनः प्रत्यभाषत ।\nतं प्रहस्याब्रवीत् कृष्णः पार्थं परमिदं वचः\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2171812, "chapter_id": 4663, "verse_number": "९०", "content_sanskrit": "पतेद् दिवाकरः स्थानात् शीर्येतानेकधा क्षितिः ।\nशैत्यमग्निरियान्न त्वा कर्णो हन्याद् धनञ्जयम्\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2171813, "chapter_id": 4663, "verse_number": "९१", "content_sanskrit": "यदि त्वेवं कथञ्चित् स्याल्लोकपर्यसनं भवेत् ।\nहन्यां कर्णं तथा शल्यं बाहुभ्यामेव संयुगे\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2171814, "chapter_id": 4663, "verse_number": "समाप्तिः", "content_sanskrit": "इति कृष्णवचः श्रुत्वा प्रहसन् कपिकेतनः ।\nअर्जुनः प्रत्युवाचेदं कृष्णमक्लिष्टकारिणम् ।\nममाप्येतावपर्याप्तौ कर्णशल्यौ जनार्दन\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2171815, "chapter_id": 4663, "verse_number": "९३", "content_sanskrit": "सपताकध्वजं कर्णं सशल्यरथवाजिनम् ।\nसच्छत्रकवचं चैव सशक्तिशरकार्मुकम्\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2171816, "chapter_id": 4663, "verse_number": "९४", "content_sanskrit": "द्रष्टास्यद्य शरैः कर्णं रणे कृत्तमनेकधा ।\nअद्यैनं सरथं साश्वं सशक्तिकवचायुधम् ।\nसञ्चूर्णितमिवामर्दे पादपं पश्य दन्तिना \t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2171817, "chapter_id": 4663, "verse_number": "९५", "content_sanskrit": "अद्य राधेयभार्याणां वैधव्यं समुपस्थितम्\nध्रुवं स्वप्नेष्वनिष्टानि ताभिर्दृष्टानि माधव \t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2171818, "chapter_id": 4663, "verse_number": "९६", "content_sanskrit": "ध्रुवमद्यैव द्रष्टासि विधवाः कर्णयोषितः\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2171819, "chapter_id": 4663, "verse_number": "९७", "content_sanskrit": "न हि मे शाम्यते वैरं कृष्णां यत्प्राहसत् पुरा\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2171820, "chapter_id": 4663, "verse_number": "९८", "content_sanskrit": "अद्य द्रष्टासि गोविन्द कर्णमुन्मथितं मया ।\nवारणेनेव मत्तेन पुष्पितं जगतीरुहम्\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2171821, "chapter_id": 4663, "verse_number": "९९", "content_sanskrit": "अद्य ता मधुरा वाचः श्रोतासि मधुसूदन ।\nदिष्ट्या जयसि वार्ष्णेय इति कर्णे निपातिते\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2171822, "chapter_id": 4663, "verse_number": "१००", "content_sanskrit": "अद्याभिमन्युजननीमनृणः सान्त्वयिष्यसि ।\nकुन्तीं पितृष्वसारं च सम्प्रहृष्टो जनार्दन\t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2171823, "chapter_id": 4663, "verse_number": "१०१", "content_sanskrit": "अद्य बाष्पमुखीं कृष्णां सान्त्वयिष्यसि माधव ।\nवाग्भिश्चामृतकल्पाभिर्धर्मराजं युधिष्ठिरम्\t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2171824, "chapter_id": 4663, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nकर्णार्जुनयुद्धे त्र्यशीतितमोऽध्यायः ॥८३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}]