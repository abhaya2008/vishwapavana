[{"id": 2160741, "chapter_id": 4480, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2160742, "chapter_id": 4480, "verse_number": "१", "content_sanskrit": "तथा तस्मिन् प्रवृत्ते तु सङ्ग्रामे रोमहर्षणे ।\nकौरवेयांस्त्रिधा भूतान् पाण्डवाः समुपाद्रवन्\nजलसन्धं महाबाहुं भीमसेनोऽभ्यवर्तत\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2160743, "chapter_id": 4480, "verse_number": "२", "content_sanskrit": "युधिष्ठिरः सहानीकः कृतवर्माणमाहवे ।\nकिरन् स शरवर्षाणि रोचमान इवांशुमान्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2160744, "chapter_id": 4480, "verse_number": "३", "content_sanskrit": "धृष्टद्युम्नो महाराज द्रोणमभ्यद्रवद् रणे \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2160745, "chapter_id": 4480, "verse_number": "४", "content_sanskrit": "ततः प्रववृते युद्धं त्वरतां सर्वधन्विनाम् ।\nकुरूणां पाण्डवानां च क्रुद्धानामितरेतरम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2160746, "chapter_id": 4480, "verse_number": "५", "content_sanskrit": "सङ्क्षये तु तथाभूते वर्तमाने महाभये ।\nद्वन्द्वभूतेषु सैन्येषु युद्ध्यमानेष्वभीतवत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2160747, "chapter_id": 4480, "verse_number": "६", "content_sanskrit": "द्रोणः पाञ्चालपुत्रेण बली बलवता सह ।\nव्यपासृजत् पृषत्कौघान् तदद्भुतमिवाभवत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2160748, "chapter_id": 4480, "verse_number": "७", "content_sanskrit": "पुण्डरीकवनानीव विध्वस्तानि समन्ततः ।\nचक्राते द्रोणपाञ्चाल्यौ नृणां शीर्षाण्यनेकशः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2160749, "chapter_id": 4480, "verse_number": "८", "content_sanskrit": "विकीर्णानि च वीराणामनीकेषु समन्ततः ।\nवस्त्राभरणशस्त्राणि ध्वजवर्मायुधानि च\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2160750, "chapter_id": 4480, "verse_number": "९", "content_sanskrit": "सुवर्णचित्राभरणाः संसिक्ता रुधिरेण च ।\nकोविदारा इवाभान्ति पुष्पितास्तत्र भारत\nतावकाः समरे योधाः पाण्डवेयाश्च विक्षताः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2160751, "chapter_id": 4480, "verse_number": "१०", "content_sanskrit": "कुञ्जरांश्च नरानन्ये पातयन्ति स्म पत्रिभिः ।\nताळमात्राणि चापानि विकर्षन्तो महारथाः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2160752, "chapter_id": 4480, "verse_number": "११", "content_sanskrit": "असिचर्माणि चापानि शिरांसि कवचानि च ।\nविप्रकीर्यन्त शूराणां सम्प्रहारे महात्मनाम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2160753, "chapter_id": 4480, "verse_number": "१२", "content_sanskrit": "उत्थितान्यगणेयानि कबन्धानि समन्ततः ।\nअदृश्यन्त महाराज तस्मिन् परमसङ्कुले\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2160754, "chapter_id": 4480, "verse_number": "१३", "content_sanskrit": "गृध्राः कङ्का बलाः श्येना वायसा जम्बुकास्तथा ।\nबहवः पिशिताशाश्च तत्रादृश्यन्त मारिष\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2160755, "chapter_id": 4480, "verse_number": "१४", "content_sanskrit": "भक्षयन्तश्च मांसानि पिबन्तश्चापि शोणितम् ।\nविलुम्पमानाः केशांश्च मज्जाश्च बहुधा नृप\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2160756, "chapter_id": 4480, "verse_number": "१५", "content_sanskrit": "आकर्षन्तः शरीराणि शरीरावयवांस्तथा ।\nनराश्वगजसङ्घानां शिरांसि च ततस्ततः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2160757, "chapter_id": 4480, "verse_number": "१६", "content_sanskrit": "कृतास्त्रा रणदीक्षाभिः दीक्षिताः शरमालिनः ।\nरणे जयं प्रार्थयाना भृशं युयुधिरे तदा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2160758, "chapter_id": 4480, "verse_number": "१७", "content_sanskrit": "असिमार्गान् बहुविधान् विचेरुश्चापरे रणे \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2160759, "chapter_id": 4480, "verse_number": "१८", "content_sanskrit": "ऋष्टिभिः शक्तिभिः प्रासैः शूलतोमरपट्टसैः ।\nगदाभिः परिघैश्चान्यैः व्यायतैश्च भुजैरपि\nअन्योन्यं न्यहनन् सङ्खे युद्धरङ्गगता नराः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2160760, "chapter_id": 4480, "verse_number": "१९", "content_sanskrit": "रथिनो रथिभिः सार्धमश्वारोहाश्च सादिभिः ।\nमातङ्गा वरमातङ्गैः पदाताश्च पदातिभिः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2160761, "chapter_id": 4480, "verse_number": "२०", "content_sanskrit": "क्षीबा इवान्ये चोन्मत्ता रङ्गेष्वेव च वारणाः ।\nउच्चुक्रुशुरथान्योन्यं जघ्नुरन्योन्यमाहवे\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2160762, "chapter_id": 4480, "verse_number": "२१", "content_sanskrit": "वर्तमाने महायुद्धे निर्मर्यादे विशांपते ।\nधृष्टद्युम्नो हयानश्वैर्द्रोणस्यामिश्रयत् स्वकैः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2160763, "chapter_id": 4480, "verse_number": "२२", "content_sanskrit": "ते हयाः साध्वशोभन्त मिश्रिता वातरंहसः ।\nपारावतसवर्णाश्च रक्तशोणाश्च मारिष\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2160764, "chapter_id": 4480, "verse_number": "२३", "content_sanskrit": "हयाः शुशुभिरे राजन् मेघा इव सविद्युतः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2160765, "chapter_id": 4480, "verse_number": "२४", "content_sanskrit": "धृष्टद्युम्नस्तु सम्प्रेक्ष्य द्रोणमभ्याशमागतम् ।\nअसिचर्माददे वीरो धनुरुत्सृज्य भारत\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2160766, "chapter_id": 4480, "verse_number": "२५", "content_sanskrit": "चिकीर्षुर्दुष्करं कर्म पार्षतः परवीरहा ।\nईषायाः समतिक्रम्य द्रोणस्य रथमाविशत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2160767, "chapter_id": 4480, "verse_number": "२६", "content_sanskrit": "अतिष्ठद् युगमध्येषु युगसन्नहनेषु च ।\nजघनांसेषु चाश्वानां तत् सैन्यं समपूजयत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2160768, "chapter_id": 4480, "verse_number": "२७", "content_sanskrit": "खड्गेन चरतस्तस्य शोणाश्वानधितिष्ठतः ।\nन ददर्शान्तरं द्रोणः तदद्भुतमिवाभवत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2160769, "chapter_id": 4480, "verse_number": "२८", "content_sanskrit": "यथा श्येनस्य चरतो द्रुतमामिषगृद्धिनः ।\nतथैवासीदभिसरस्तस्य द्रोणं जिघांसतः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2160770, "chapter_id": 4480, "verse_number": "२९", "content_sanskrit": "ततः शरशतेनास्य शतचन्द्रमपातयत् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2160771, "chapter_id": 4480, "verse_number": "३०", "content_sanskrit": "द्रोणो द्रुपदपुत्रस्य खड्गं च दशभिः शरैः ।\nहयांश्चैव चतुःषष्ट्या शराणां जघ्निवान् बली\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2160772, "chapter_id": 4480, "verse_number": "३१", "content_sanskrit": "अथास्मै त्वरितो बाणमपरं जीवितान्तकम् ।\nधृष्टद्युम्नाय चिक्षेप शचीपतिरिवाशनिम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2160773, "chapter_id": 4480, "verse_number": "३२", "content_sanskrit": "तं चतुर्दशभिर्बाणैर्बाणांश्चिच्छेद सात्यकिः ।\nग्रस्तमाचार्यमुख्येन धृष्टद्युम्नममोचयत्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2160774, "chapter_id": 4480, "verse_number": "३३", "content_sanskrit": "सिंहेनेव मृगं ग्रस्तं नरसिंहेन संयुगे ।\nद्रोणाद् वै मोचयामास पाञ्चाल्यं शिनिपुङ्गवः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2160775, "chapter_id": 4480, "verse_number": "३४", "content_sanskrit": "सात्यकिं प्रेक्ष्य गोप्तारं पाञ्चालस्य महाहवे ।\nशराणां त्वरितो द्रोणः षड्विंशत्या समर्पयत्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2160776, "chapter_id": 4480, "verse_number": "३५", "content_sanskrit": "ततो द्रोणं शिनेर्नप्ता ग्रसन्तमिव सृञ्जयान् ।\nप्रत्यविद्ध्यच्छितैर्बाणैः षड्विंशत्या स्तनान्तरे\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2160777, "chapter_id": 4480, "verse_number": "३६", "content_sanskrit": "ततः सर्वे रथात् तूर्णं पाञ्चाला जयगृद्धिनः ।\nसात्वताभिसृते द्रोणे धृष्टद्युम्नमचोदयन्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2160778, "chapter_id": 4480, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि पञ्चाशीतितमोऽध्यायः ॥ ८५ ॥\nजयद्रथपर्वणि नवमोऽध्यायः ॥ ९ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]