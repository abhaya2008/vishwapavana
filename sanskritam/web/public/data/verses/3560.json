[{"id": 2119133, "chapter_id": 3560, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2119134, "chapter_id": 3560, "verse_number": "१", "content_sanskrit": "उषित्वा खाण्डवप्रस्थे सुखवासं जनार्दनः ।\nपार्थैः प्रीतिसमायुक्तैः पूजनार्होऽभिपूजितः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2119135, "chapter_id": 3560, "verse_number": "२", "content_sanskrit": "गमनाय मतिं चक्रे पितुर्दर्शनलालसः ।\nधर्मराजमथामन्त्र्य पृथां च पृथुलोचनः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2119136, "chapter_id": 3560, "verse_number": "३", "content_sanskrit": "ववन्दे चरणौ मूर्ध्ना जगद्वन्द्यः पितृष्वसुः ।\nस तया मूर्ध्न्युपाघ्राय परिष्वक्तश्च केशवः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2119137, "chapter_id": 3560, "verse_number": "४", "content_sanskrit": "ददर्शानन्तरं कृष्णो भगिनीं स्वां महायशाः ।\nतामुपेत्य हृषीकेशः प्रीत्या बाष्पसमन्वितः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2119138, "chapter_id": 3560, "verse_number": "५", "content_sanskrit": "अर्थ्यं तथ्यं हितं वाक्यं लघु युक्तमनुत्तमम् ।\nउवाच भगवान् भद्रां सुभद्रां भद्रभाषिणीम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2119139, "chapter_id": 3560, "verse_number": "६", "content_sanskrit": "तया स गजगामिन्या श्रावितो वचनानि च ।\nसम्पूजितश्चाप्यसकृच्छिरसा चाभिवदिन्तः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2119140, "chapter_id": 3560, "verse_number": "७", "content_sanskrit": "तामनुज्ञाप्य वार्ष्णेयः प्रतिनन्द्य च भामिनीम् ।\nददर्शानन्तरं कृष्णां धौम्यं चापि जनार्दनः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2119141, "chapter_id": 3560, "verse_number": "८", "content_sanskrit": "ववन्दे च यथान्यायं धौम्यं पुरुषसत्तमः ।\nद्रौपदीं सान्त्वयित्वा च सुभद्रां परिरभ्य च ।\nभ्रातॄनभ्यगमद् धीमान् पार्थेन सहितो वशी\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2119142, "chapter_id": 3560, "verse_number": "९", "content_sanskrit": "भ्रातृभिः पञ्चभिः कृष्णो वृतः शक्र इवामरैः ।\nयात्राकालस्य योग्यानि कर्माणि गरुडध्वजः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2119143, "chapter_id": 3560, "verse_number": "१०", "content_sanskrit": "कर्तुकामः शुचिर्भूत्वा स्नात्वा च समलङ्कृतः ।\nअर्चयामास देवांश्च द्विजांश्च यदुपुङ्गवः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2119144, "chapter_id": 3560, "verse_number": "११", "content_sanskrit": "माल्यैरपि नमस्कारैर्गन्धैरुच्चावचैस्तथा ।\nस कृत्वा सर्वकार्याणि प्रतस्थे पुष्करेक्षणः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2119145, "chapter_id": 3560, "verse_number": "१२", "content_sanskrit": "स्वस्ति वाच्यार्हतो विप्रान् दधिपुष्पफलाक्षतैः ।\nवसु प्रदाय च ततः प्रदक्षिणमवर्तत\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2119146, "chapter_id": 3560, "verse_number": "१३", "content_sanskrit": "ततः स कृतमङ्गल्यो ब्राह्मणैर्वेदपारगैः ।\nकाञ्चनं रथमास्थाय तार्क्ष्यकेतनमाशुगम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2119147, "chapter_id": 3560, "verse_number": "१४", "content_sanskrit": "गदाचक्रासिशार्ङ्गाद्यैरायुधैश्च समन्वितम् ।\nतिथावथ च नक्षत्रे मुहूर्ते च गुणान्विते ।\nप्रययौ पुण्डरीकाक्षः शैब्यसुग्रीववाहनः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2119148, "chapter_id": 3560, "verse_number": "१५", "content_sanskrit": "अन्वारुरोह तं चापि प्रेम्णा राजा युधिष्ठिरः ।\nअपास्य चास्य यन्तारं दारुकं सूतमुत्तमम् ।\nअभीषून् प्रतिजग्राह स्वयं कुरुपतिस्तदा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2119149, "chapter_id": 3560, "verse_number": "१६", "content_sanskrit": "उपारुह्यार्जुनश्चापि चामरव्यजनं सितम् ।\nरुग्मदण्डं बृहन्मूर्ध्नि दुधावाभिप्रदक्षिणम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2119150, "chapter_id": 3560, "verse_number": "१७", "content_sanskrit": "तथैव भीमसेनोऽपि रथमारुह्य वीर्यवान् ।\nछत्रं शतशलाकं च दिव्यमाल्योपशोभितम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2119151, "chapter_id": 3560, "verse_number": "१८", "content_sanskrit": "वैडूर्यमणिदण्डं च चामीकरविभूषितम् ।\nदधार तरसा भीमः छत्रं तच्छार्ङ्गधन्वने\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2119152, "chapter_id": 3560, "verse_number": "१९", "content_sanskrit": "उपारुह्य रथं शीघ्रं चामरव्यजने सिते ।\nनकुलः सहदेवश्च धूयमानौ जनार्दनम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2119153, "chapter_id": 3560, "verse_number": "२०", "content_sanskrit": "स तथा भ्रातृभिः सार्धं केशवः परवीरहा ।\nअनुगम्यमानः शुशुभे शिष्यैरिव गुरुः प्रियैः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2119154, "chapter_id": 3560, "verse_number": "२१", "content_sanskrit": "अभिमन्युं च सौभद्रं वृद्धैः परिवृतस्ततः ।\nरथमारोप्य निर्यातो धौम्यो ब्राह्मणपुङ्गवः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2119155, "chapter_id": 3560, "verse_number": "२२", "content_sanskrit": "इन्द्रप्रस्थमतिक्रम्य क्रोशमात्रं महाद्युतिः ।\nपार्थमामन्त्र्य गोविन्दः परिष्वज्य सहानुजम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2119156, "chapter_id": 3560, "verse_number": "२३", "content_sanskrit": "युधिष्ठिरं पूजयित्वा भीमसेनं यमौ तथा ।\nपरिष्वक्तो भृशं ताभ्यां यमाभ्यामभिवादितः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2119157, "chapter_id": 3560, "verse_number": "२४", "content_sanskrit": "ततस्तैः संविदं कृत्वा यथावन्मधुसूदनः ।\nयोजनार्धमथो गत्वा कृष्णः परपुरञ्जयः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2119158, "chapter_id": 3560, "verse_number": "२५", "content_sanskrit": "युधिष्ठिरं समामन्त्र्य निवर्तस्वेति चाब्रवीत् ।\nततोऽभिवाद्य गोविन्दः पादौ जग्राह धर्मवित्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2119159, "chapter_id": 3560, "verse_number": "२६", "content_sanskrit": "निवर्तयित्वा च तदा पाण्डवान् स पदानुगान् ।\nस्वां पुरीं प्रययौ हृष्टः पुरन्दर इवापरः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2119160, "chapter_id": 3560, "verse_number": "२७", "content_sanskrit": "लोचनैरनुजग्मुस्ते तमादृष्टिपथात् पुनः ।\nमनोभिरनुजग्मुस्ते कृष्णं प्रीतिसमन्विताः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2119161, "chapter_id": 3560, "verse_number": "२८", "content_sanskrit": "अतृप्तमनसामेव तेषां केशवदर्शने ।\nक्षिप्रमन्तर्दधे शौरिः चक्षुषां प्रियदर्शनः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2119162, "chapter_id": 3560, "verse_number": "२९", "content_sanskrit": "अकामा इव पार्थाश्च गोविन्दगतमानसाः ।\nनिवृत्य प्रययुः सर्वे स्वं पुरं भरतर्षभाः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2119163, "chapter_id": 3560, "verse_number": "३०", "content_sanskrit": "निवृत्तो धर्मराजस्तु सह भ्रातृभिरच्युतः ।\nसुहृज्जनवृतो राजा प्रविवेश पुरोत्तमम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2119164, "chapter_id": 3560, "verse_number": "३१", "content_sanskrit": "विसृज्य सर्वान् सुहृदो भ्रातॄन् पुत्रांश्च धर्मराट् ।\nमुमोद पुरुषव्याघ्रो द्रौपद्या सह भारत\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2119165, "chapter_id": 3560, "verse_number": "३२", "content_sanskrit": "स्यन्दनेनाथ कृष्णोऽपि समये द्वारकामगात् ।\nकेशवोऽपि मुदा युक्तः प्रविवेश पुरोत्तमम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2119166, "chapter_id": 3560, "verse_number": "३३", "content_sanskrit": "दारुकेण च सूतेन सहितो देवकीसुतः ।\nपूज्यमानो यदुश्रेष्ठैरुग्रसेनोद्धवादिभिः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2119167, "chapter_id": 3560, "verse_number": "३४", "content_sanskrit": "आहुकं पितरं वृद्धं मातरं च यशस्विनीम् ।\nअभिवाद्य बलं चैव स्थितः कमललोचनः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2119168, "chapter_id": 3560, "verse_number": "३५", "content_sanskrit": "प्रद्युम्नसाम्बौ निशठं चारुदेष्णं गदं तथा ।\nअनिरुद्धं च भानुं च परिष्वज्य जनार्दनः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2119169, "chapter_id": 3560, "verse_number": "३६", "content_sanskrit": "वृद्धैस्तैश्चाभ्यनुज्ञातो रुग्मिण्या भवनं ययौ ।\nस तत्र भवने दिव्ये प्रमुमोद सुखी सुखम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2119170, "chapter_id": 3560, "verse_number": "२", "content_sanskrit": "॥ इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2119171, "chapter_id": 3560, "verse_number": "२", "content_sanskrit": "॥ मन्त्रपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2119172, "chapter_id": 3560, "verse_number": "", "content_sanskrit": "—— ०  ——", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]