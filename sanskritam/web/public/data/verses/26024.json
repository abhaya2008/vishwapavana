[{"id": 7006024000, "chapter_id": 26024, "verse_number": "१-२०८-१", "content_sanskrit": "सूत उवाच ।\nआर्यालक्ष्म त्वष्ट गणाः सदा जो विषमे न हि ।\nषष्ठे जो न्लौ वापि भवेत्पदं षष्ठे द्वितीयलात् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006024001, "chapter_id": 26024, "verse_number": "१-२०८-२", "content_sanskrit": "आदितः सप्तमे ह्रस्वा द्वितीयार्धे शरे ततः ।\nत्रिगणाङ्घ्रिश्च पथ्या स्याद्विपुला वह्निलङ्घनात् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006024002, "chapter_id": 26024, "verse_number": "१-२०८-३", "content_sanskrit": "ग्मध्ये द्वितुर्यौ जौ चपला मुखपूर्वादिचापला। ।\nद्वितीयार्धे सजघना आर्याजातेश्च लक्षणम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006024003, "chapter_id": 26024, "verse_number": "१-२०८-४", "content_sanskrit": "आर्या प्रथमार्धलक्ष्म गीतिः स्याच्चेद्दलद्ये ।\nउपगीतिर्द्वितीयार्धादुद्गीतिर्व्यत्ययाद्भवेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006024004, "chapter_id": 26024, "verse_number": "१-२०८-५", "content_sanskrit": "आर्यागीतिश्चान्तगुरुर्गोतिजातेश्च लक्षणम् ।\nषट्कला विषमे चेत्स्युः समेऽष्टौ न निरन्राः ।\nसमा पराश्रिता न स्याद्वैतालीये रलौ गुरुः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006024005, "chapter_id": 26024, "verse_number": "१-२०८-६", "content_sanskrit": "अन्तेर्यौ पूर्ववदिदमौपच्छन्दसिकं मतम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006024006, "chapter_id": 26024, "verse_number": "१-२०८-७", "content_sanskrit": "भाद्गौ स्यादापातलिका ज्ञेयाथो दक्षिणान्तिका। ।\nपराश्रितो द्वितीयो लः पादेषु निखिलेष्वपि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006024007, "chapter_id": 26024, "verse_number": "१-२०८-८", "content_sanskrit": "उदीच्यवृत्तिरसमे प्राच्यवृत्तिस्तु युग्मके ।\nसपञ्चमश्चतुर्थांशे युगपत्तौ प्रवृत्तकम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006024008, "chapter_id": 26024, "verse_number": "१-२०८-९", "content_sanskrit": "उदीच्याद्यङ्घ्रिसंयोगाद्युग्मपादैकपादिका ।\nचारुहासिन्ययुग्माङ्घ्रौ वैतालीयस्य संग्रहः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006024009, "chapter_id": 26024, "verse_number": "१-२०८-१०", "content_sanskrit": "वक्त्रं नाद्यान्नसौ स्यातां चतुर्थाद्यगणोवेत् ।\nपथ्यावक्त्रं जेन समे विपरीतादिरन्यथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006024010, "chapter_id": 26024, "verse_number": "१-२०८-११", "content_sanskrit": "उसमे नश्च चपला विपुला लघुसप्तमा ।\nनिखिले वा सैतवस्य म्रौ न्तौ चाब्धेस्तत्पूर्वकौ ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006024011, "chapter_id": 26024, "verse_number": "१-२०८-१२", "content_sanskrit": "षोडशलोऽचलधृतिर्मात्रासमकमुच्यते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006024012, "chapter_id": 26024, "verse_number": "१-२०८-१३", "content_sanskrit": "नवमलस्तथा गोऽन्त्यः जो न्लौवाथाम्बुधेर्यथ। ।\nविश्लोकः स्यात्तच्चतुष्कद्विगुणाद्वानवासिका ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006024013, "chapter_id": 26024, "verse_number": "१-२०८-१४", "content_sanskrit": "बाणाष्टनवकेषु स्याल्लश्चित्रा षोडशातमका ।\nसममात्रासमादिष्टं पदाकुलकमीरितम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006024014, "chapter_id": 26024, "verse_number": "१-२०८-१५", "content_sanskrit": "वृत्तमात्रा विना वर्णैर्ला वर्णा गुरुभिर्विना ।\nगुरुवो लैर्दले नित्यं प्रमाणमिति निश्चितम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006024015, "chapter_id": 26024, "verse_number": "१-२०८-१६", "content_sanskrit": "अष्टाविंशातिला गन्ता प्रथमार्धे द्वितीयके ।\nत्रिंशदस्यां शिखा गन्ता खञ्जातद्व्यत्ययाद्भवेत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006024016, "chapter_id": 26024, "verse_number": "१-२०८-१७", "content_sanskrit": "षोडशानङ्गक्रीडा गा द्वात्रिंशच्चरमे च ला। ।\nसप्तविंशातिला गन्ता दलयो रुचिरा द्वयोः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006024017, "chapter_id": 26024, "verse_number": "१-२०८-१८", "content_sanskrit": "मात्रावृत्तानि चोक्तानि वर्णवृत्तानि वच्मि वै ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]