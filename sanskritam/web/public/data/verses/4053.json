[{"id": 2141582, "chapter_id": 4053, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2141583, "chapter_id": 4053, "verse_number": "१", "content_sanskrit": "एवं विद्राव्य तत्सैन्यं पार्थो भीष्ममुपाद्रवत् ।\nत्रस्तेषु सर्वसैन्येषु कौरव्यस्य महात्मनः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2141584, "chapter_id": 4053, "verse_number": "२", "content_sanskrit": "नरसिंहमुपायान्तं जिगीषन्तं परान् रणे ।\nवृषसेनोऽभ्ययात् तूर्णं योद्धुकामो धनञ्जयम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2141585, "chapter_id": 4053, "verse_number": "३", "content_sanskrit": "तस्य पार्थस्तदा क्षिप्रं क्षुरधारेण कार्मुकम् ।\nन्यकृन्तद् गृध्रपत्रेण जाम्बूनदपरिष्कृतम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2141586, "chapter_id": 4053, "verse_number": "४", "content_sanskrit": "अथैनं पञ्चभिर्भूयः प्रत्यविध्यत् स्तनान्तरे ।\nस पार्थबाणाभिहतो रथात् प्रस्कन्द्य चाद्रवत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2141587, "chapter_id": 4053, "verse_number": "५", "content_sanskrit": "दुःशासनो विकर्णश्च शकुनिश्च विविंशतिः ।\nआयान्तं भीमधन्वानं पर्यकीर्यन्त पाण्डवम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2141588, "chapter_id": 4053, "verse_number": "६", "content_sanskrit": "तेषां पार्थो रणे क्रुद्धः शरैः सन्नतपर्वभिः ।\nयुगं ध्वजमथेषां च चिच्छेद तरसा रणे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2141589, "chapter_id": 4053, "verse_number": "७", "content_sanskrit": "ते निकृत्तध्वजाः सर्वे छिन्नकार्मुकवेष्टनाः ।\nरणमध्यादपययुः पार्थबाणाभिपीडिताः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2141590, "chapter_id": 4053, "verse_number": "८", "content_sanskrit": "ततः प्रहस्य बीभत्सुर्वैराटिमिदमब्रवीत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2141591, "chapter_id": 4053, "verse_number": "९", "content_sanskrit": "एतं मे प्रापयेदानीं ताळं सौवर्णमुच्छ्रितम् ।\nमेघमध्ये यथा विद्युच्चरतीव पुनः पुनः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2141592, "chapter_id": 4053, "verse_number": "१०", "content_sanskrit": "असौ शान्तनवो भीष्मस्तत्र याहि परन्तप\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2141593, "chapter_id": 4053, "verse_number": "११", "content_sanskrit": "अस्त्राणि तस्य दिव्यानि दर्शयिष्यामि संयुगे ।\nघोररूपाणि चित्राणि लघूनि च गुरूणि च\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2141594, "chapter_id": 4053, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2141595, "chapter_id": 4053, "verse_number": "१२", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा वैराटिः पार्थसारथिः ।\nवाहयच्चोदितस्तेन रथं भीष्मरथं प्रति\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2141596, "chapter_id": 4053, "verse_number": "१३", "content_sanskrit": "तं तथा चोदितं दृष्ट्वा फल्गुनस्य रथोत्तमम् ।\nवायुनेव महामेघं सहसाऽभिसमीरितम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2141597, "chapter_id": 4053, "verse_number": "१४", "content_sanskrit": "तं प्रत्यगाच्च गाङ्गेयो रथेनादित्यवर्चसा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2141598, "chapter_id": 4053, "verse_number": "१५", "content_sanskrit": "आयान्तमर्जुनं दृष्ट्वा भीष्मः परपुरञ्जयः ।\nप्रत्युज्जगाम युद्धार्थी महर्षभ इवर्षभम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2141599, "chapter_id": 4053, "verse_number": "१६", "content_sanskrit": "तथाभिगुप्तये स्वेषां दुराधर्षः पितामहः ।\nहन्यमानेषु योधेषु धनञ्जयमुपाद्रवत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2141600, "chapter_id": 4053, "verse_number": "१७", "content_sanskrit": "प्रगृह्य कार्मुकश्रेष्ठं जातरूपपरिष्कृतम् ।\nशरानादाय तीक्ष्णाग्रान् मर्मदेहप्रमाथिनः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2141601, "chapter_id": 4053, "verse_number": "१८", "content_sanskrit": "पाण्डरेणातपत्रेण ध्रियमाणेन मूर्धनि ।\nशुशुभे स नरव्याघ्रो गिरिः सूर्योत्तरो यथा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2141602, "chapter_id": 4053, "verse_number": "१९", "content_sanskrit": "प्राध्माय शङ्खं गाङ्गेयो धार्तराष्ट्रं प्रहर्षयन् ।\nप्रदक्षिणमुपावृत्य बीभत्सुं समवारयत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2141603, "chapter_id": 4053, "verse_number": "२०", "content_sanskrit": "समवेक्ष्य तमायान्तं कौन्तेयः परवीरहा ।\nदेवदत्तं महाशङ्खं प्रदध्मौ युधि वीर्यवान्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2141604, "chapter_id": 4053, "verse_number": "२१", "content_sanskrit": "तौ शङ्खनादावत्यर्थं भीष्मपाण्डवयोस्तदा ।\nनादयामासतुस्तत्र खं च भूमिं च सर्वशः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2141605, "chapter_id": 4053, "verse_number": "२२", "content_sanskrit": "स हि दृष्ट्वा तथाऽऽयान्तं कौन्तेयं परवीरहा\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2141606, "chapter_id": 4053, "verse_number": "२३", "content_sanskrit": "प्रत्यगृह्णादमेयात्मा प्रियातिथिमिवागतम् ।\nअन्तरिक्षे प्रजल्पन्ति सर्वे देवाः सवासवाः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2141607, "chapter_id": 4053, "verse_number": "२४", "content_sanskrit": "यदर्जुनः कुरून् सर्वान् प्राकृन्तच्छस्त्रतेजसा ।\nकुरुश्रेष्ठाविमौ वीरौ रणे भीष्मधनञ्जयौ\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2141608, "chapter_id": 4053, "verse_number": "२४", "content_sanskrit": "सर्वास्त्रकुशलौ लोके एतावतिरथावुभौ ।\nउभौ देवमनुष्येषु विश्रुतौ स्वपराक्रमैः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2141609, "chapter_id": 4053, "verse_number": "२६", "content_sanskrit": "उभौ परमसंरब्धावुभौ दीप्तधनुर्धरौ\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2141610, "chapter_id": 4053, "verse_number": "२७", "content_sanskrit": "समागतौ नरव्याघ्रौ व्याघ्राविव तरस्विनौ ।\nउभौ सदृशकर्माणौ सूर्यस्याग्नेश्च भारतौ\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2141611, "chapter_id": 4053, "verse_number": "२८", "content_sanskrit": "वासुदेवस्य सदृशौ कार्तवीर्यसमावुभौ ।\nउभौ विश्रुतकर्माणावुभौ शूरौ महाबलौ\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2141612, "chapter_id": 4053, "verse_number": "२९", "content_sanskrit": "सर्वास्त्रविदुषां श्रेष्ठौ सर्वशस्त्रभृतां वरौ\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2141613, "chapter_id": 4053, "verse_number": "३०", "content_sanskrit": "अग्नेरिन्द्रस्य सोमस्य यमस्य धनदस्य च ।\nअनयोः सदृशं वीर्यं मित्रस्य वरुणस्य च\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2141614, "chapter_id": 4053, "verse_number": "३१", "content_sanskrit": "को वा कुन्तीसुतं युद्धे द्वैरथेनोपयास्यति ।\nऋते शान्तनवादन्यः क्षत्रियो भुवि विद्यते\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2141615, "chapter_id": 4053, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2141616, "chapter_id": 4053, "verse_number": "समाप्तिः", "content_sanskrit": "इति सम्पूजयामासुर्भीष्मं दृष्ट्वाऽर्जुनं गतम् ।\nरणे सम्प्रहरिष्यन्तं दृष्ट्वा देवाः सवासवाः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2141617, "chapter_id": 4053, "verse_number": "३३", "content_sanskrit": "अथ बहुविधशङ्खतूर्यघोषैः\nविविधरवैः सह सिंहनादमिश्रैः ।\nकुरुवृषभमपूजयत् कुरूणां\nबलममराधिपसैन्यसप्रभं तत्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2141618, "chapter_id": 4053, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि एकषष्टितमोऽध्यायः ॥६१॥ गोग्रहणपर्वणि चतुस्त्रिंशोऽध्यायः ॥३४॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]