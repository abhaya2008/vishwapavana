[{"id": 50006192, "chapter_id": 11329, "verse_number": "1", "content_sanskrit": "॥ पूर्वपक्षयुक्तयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50006193, "chapter_id": 11329, "verse_number": "2", "content_sanskrit": "व्यामिश्रता कार्यकरत्वमर्थकॢप्तिः सुदार्ढ्यं परतन्त्रता च। समानधर्मः कृतशेषता च लोकोपमा पूर्वमतानुसाराः॥ १२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50006194, "chapter_id": 11329, "verse_number": "3", "content_sanskrit": "॥ सिद्धान्तयुक्तयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50006195, "chapter_id": 11329, "verse_number": "4", "content_sanskrit": "विशेषसाम्यश्रुतिराढ्यता च समानलोपो महिमा विशेषः। कृतार्थता शश्वदनुप्रवृत्तिः सिद्धान्तनिर्णीतिविशिष्टहेतवः॥ १२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]