[{"id": 5000341000, "chapter_id": 9341, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे द्वितीयः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000341001, "chapter_id": 9341, "verse_number": "५-२-१", "content_sanskrit": "स सागरमनाधृष्यमतिक्रम्य महाबलः।\nत्रिकूटस्य तटे लंकां स्थितः स्वस्थो ददर्श ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000341002, "chapter_id": 9341, "verse_number": "५-२-२", "content_sanskrit": "ततः पादपमुक्तेन पुष्पवर्षेण वीर्यवान्।\nअभिवृष्टस्ततस्तत्र बभौ पुष्पमयो हरिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000341003, "chapter_id": 9341, "verse_number": "५-२-३", "content_sanskrit": "योजनानां शतं श्रीमांस्तीर्त्वाप्युत्तमविक्रमः।\nअनिःश्वसन् कपिस्तत्र न ग्लानिमधिगच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000341004, "chapter_id": 9341, "verse_number": "५-२-४", "content_sanskrit": "शतान्यहं योजनानां क्रमेयं सुबहून्यपि।\nकिं पुनः सागरस्यान्तं संख्यातं शतयोजनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000341005, "chapter_id": 9341, "verse_number": "५-२-५", "content_sanskrit": "स तु वीर्यवतां श्रेष्ठः प्लवतामपि चोत्तमः।\nजगाम वेगवाँल्लंकां लङ्घयित्वा महोदधिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000341006, "chapter_id": 9341, "verse_number": "५-२-६", "content_sanskrit": "शाद्वलानि च नीलानि गन्धवन्ति वनानि च।\nमधुमन्ति च मध्येन जगाम नगवन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000341007, "chapter_id": 9341, "verse_number": "५-२-७", "content_sanskrit": "शैलांश्च तरुसंछन्नान् वनराजीश्च पुष्पिताः।\nअभिचक्राम तेजस्वी हनूमान् प्लवगर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000341008, "chapter_id": 9341, "verse_number": "५-२-८", "content_sanskrit": "स तस्मिन्नचले तिष्ठन् वनान्युपवनानि च।\nस नगाग्रे स्थितां लंकां ददर्श पवनात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000341009, "chapter_id": 9341, "verse_number": "५-२-९", "content_sanskrit": "सरलान् कर्णिकारांश्च खर्जूरांश्च सुपुष्पितान्।\nप्रियालान् मुचुलिन्दांश्च कुटजान् केतकानपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000341010, "chapter_id": 9341, "verse_number": "५-२-१०", "content_sanskrit": "प्रियङ्गून् गन्धपूर्णांश्च नीपान् सप्तच्छदांस्तथा।\nअसनान् कोविदारांश्च करवीरांश्च पुष्पितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000341011, "chapter_id": 9341, "verse_number": "५-२-११", "content_sanskrit": "पुष्पभारनिबद्धांश्च तथा मुकुलितानपि।\nपादपान् विहगाकीर्णान् पवनाधूतमस्तकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000341012, "chapter_id": 9341, "verse_number": "५-२-१२", "content_sanskrit": "हंसकारण्डवाकीर्णा वापीः पद्मोत्पलावृताः।\nआक्रीडान् विविधान् रम्यान् विविधांश्च जलाशयान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000341013, "chapter_id": 9341, "verse_number": "५-२-१३", "content_sanskrit": "संततान् विविधैर्वृक्षैः सर्वर्तुफलपुष्पितैः।\nउद्यानानि च रम्याणि ददर्श कपिकुञ्जरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000341014, "chapter_id": 9341, "verse_number": "५-२-१४", "content_sanskrit": "समासाद्य च लक्ष्मीवाँल्लंकां रावणपालिताम्।\nपरिखाभिः सपद्माभिः सोत्पलाभिरलंकृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000341015, "chapter_id": 9341, "verse_number": "५-२-१५", "content_sanskrit": "सीतापहरणात् तेन रावणेन सुरक्षिताम्।\nसमन्ताद् विचरद्भिश्च राक्षसैरुग्रधन्वभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000341016, "chapter_id": 9341, "verse_number": "५-२-१६", "content_sanskrit": "काञ्चनेनावृतां रम्यां प्राकारेण महापुरीम्।\nगृहैश्च गिरिसंकाशैः शारदाम्बुदसंनिभैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000341017, "chapter_id": 9341, "verse_number": "५-२-१७", "content_sanskrit": "पाण्डुराभिः प्रतोलीभिरुच्चाभिरभिसंवृताम्।\nअट्टालकशताकीर्णां पताकाध्वजशोभिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000341018, "chapter_id": 9341, "verse_number": "५-२-१८", "content_sanskrit": "तोरणैः काञ्चनैर्दिव्यैर्लतापङ्‍क्तिविराजितैः।\nददर्श हनुमाँल्लंकां देवो देवपुरीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000341019, "chapter_id": 9341, "verse_number": "५-२-१९", "content_sanskrit": "गिरिमूर्ध्नि स्थितां लंकां पाण्डुरैर्भवनैः शुभैः।\nददर्श स कपिः श्रीमान् पुरीमाकाशगामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000341020, "chapter_id": 9341, "verse_number": "५-२-२०", "content_sanskrit": "पालितां राक्षसेन्द्रेण निर्मितां विश्वकर्मणा।\nप्लवमानामिवाकाशे ददर्श हनुमान् कपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000341021, "chapter_id": 9341, "verse_number": "५-२-२१", "content_sanskrit": "वप्रप्राकारजघनां विपुलाम्बुवनाम्बराम्।\nशतघ्नीशूलकेशान्तामट्टालकावतंसकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000341022, "chapter_id": 9341, "verse_number": "५-२-२२", "content_sanskrit": "मनसेव कृतां लंकां निर्मितां विश्वकर्मणा।\nद्वारमुत्तरमासाद्य चिन्तयामास वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000341023, "chapter_id": 9341, "verse_number": "५-२-२३", "content_sanskrit": "कैलासनिलयप्रख्यमालिखन्तमिवाम्बरम्।\nध्रियमाणमिवाकाशमुच्छ्रितैर्भवनोत्तमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000341024, "chapter_id": 9341, "verse_number": "५-२-२४", "content_sanskrit": "सम्पूर्णा राक्षसैर्घोरैर्नागैर्भोगवतीमिव।\nअचिन्त्यां सुकृतां स्पष्टां कुबेराध्युषितां पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000341025, "chapter_id": 9341, "verse_number": "५-२-२५", "content_sanskrit": "दंष्ट्राभिर्बहुभिः शूरैः शूलपट्टिशपाणिभिः।\nरक्षितां राक्षसैर्घोरैर्गुहामाशीविषैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000341026, "chapter_id": 9341, "verse_number": "५-२-२६", "content_sanskrit": "तस्याश्च महतीं गुप्तिं सागरं च निरीक्ष्य सः।\nरावणं च रिपुं घोरं चिन्तयामास वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000341027, "chapter_id": 9341, "verse_number": "५-२-२७", "content_sanskrit": "आगत्यापीह हरयो भविष्यन्ति निरर्थकाः।\nनहि युद्धेन वै लंका शक्या जेतुं सुरैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000341028, "chapter_id": 9341, "verse_number": "५-२-२८", "content_sanskrit": "इमां त्वविषमां लंकां दुर्गां रावणपालिताम्।\nप्राप्यापि सुमहाबाहुः किं करिष्यति राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000341029, "chapter_id": 9341, "verse_number": "५-२-२९", "content_sanskrit": "अवकाशो न साम्नस्तु राक्षसेष्वभिगम्यते।\nन दानस्य न भेदस्य नैव युद्धस्य दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000341030, "chapter_id": 9341, "verse_number": "५-२-३०", "content_sanskrit": "चतुर्णामेव हि गतिर्वानराणां तरस्विनाम्।\nवालिपुत्रस्य नीलस्य मम राज्ञश्च धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000341031, "chapter_id": 9341, "verse_number": "५-२-३१", "content_sanskrit": "यावज्जानामि वैदेहीं यदि जीवति वा न वा।\nतत्रैव चिन्तयिष्यामि दृष्ट्वा तां जनकात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000341032, "chapter_id": 9341, "verse_number": "५-२-३२", "content_sanskrit": "ततः स चिन्तयामास मुहूर्तं कपिकुञ्जरः।\nगिरेः शृङ्गे स्थितस्तस्मिन् रामस्याभ्युदयं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000341033, "chapter_id": 9341, "verse_number": "५-२-३३", "content_sanskrit": "अनेन रूपेण मया न शक्या रक्षसां पुरी।\nप्रवेष्टुं राक्षसैर्गुप्ता क्रूरैर्बलसमन्वितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000341034, "chapter_id": 9341, "verse_number": "५-२-३४", "content_sanskrit": "महौजसो महावीर्या बलवन्तश्च राक्षसाः।\nवञ्चनीया मया सर्वे जानकीं परिमार्गता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000341035, "chapter_id": 9341, "verse_number": "५-२-३५", "content_sanskrit": "लक्ष्यालक्ष्येण रूपेण रात्रौ लंकापुरी मया।\nप्राप्तकालं प्रवेष्टुं मे कृत्यं साधयितुं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000341036, "chapter_id": 9341, "verse_number": "५-२-३६", "content_sanskrit": "तां पुरीं तादृशीं दृष्ट्वा दुराधर्षां सुरासुरैः।\nहनूमांश्चिन्तयामास विनिःश्वस्य मुहुर्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000341037, "chapter_id": 9341, "verse_number": "५-२-३७", "content_sanskrit": "केनोपायेन पश्येयं मैथिलीं जनकात्मजाम्।\nअदृष्टो राक्षसेन्द्रेण रावणेन दुरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000341038, "chapter_id": 9341, "verse_number": "५-२-३८", "content_sanskrit": "न विनश्येत् कथं कार्यं रामस्य विदितात्मनः।\nएकामेकस्तु पश्येयं रहिते जनकात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000341039, "chapter_id": 9341, "verse_number": "५-२-३९", "content_sanskrit": "भूताश्चार्था विनश्यन्ति देशकालविरोधिताः।\nविक्लवं दूतमासाद्य तमः सूर्योदये यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000341040, "chapter_id": 9341, "verse_number": "५-२-४०", "content_sanskrit": "अर्थानर्थान्तरे बुद्धिर्निश्चितापि न शोभते।\nघातयन्तीह कार्याणि दूताः पण्डितमानिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000341041, "chapter_id": 9341, "verse_number": "५-२-४१", "content_sanskrit": "न विनश्येत् कथं कार्यं वैक्लव्यं न कथं भवेत्।\nलङ्घनं च समुद्रस्य कथं नु न भवेद् वृथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000341042, "chapter_id": 9341, "verse_number": "५-२-४२", "content_sanskrit": "मयि दृष्टे तु रक्षोभी रामस्य विदितात्मनः।\nभवेद् व्यर्थमिदं कार्यं रावणानर्थमिच्छतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000341043, "chapter_id": 9341, "verse_number": "५-२-४३", "content_sanskrit": "नहि शक्यं क्वचित् स्थातुमविज्ञातेन राक्षसैः।\nअपि राक्षसरूपेण किमुतान्येन केनचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000341044, "chapter_id": 9341, "verse_number": "५-२-४४", "content_sanskrit": "वायुरप्यत्र नाज्ञातश्चरेदिति मतिर्मम।\nनह्यत्राविदितं किंचिद् रक्षसां भीमकर्मणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000341045, "chapter_id": 9341, "verse_number": "५-२-४५", "content_sanskrit": "इहाहं यदि तिष्ठामि स्वेन रूपेण संवृतः।\nविनाशमुपयास्यामि भर्तुरर्थश्च हास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000341046, "chapter_id": 9341, "verse_number": "५-२-४६", "content_sanskrit": "तदहं स्वेन रूपेण रजन्यां ह्रस्वतां गतः।\nलंकामभिपतिष्यामि राघवस्यार्थसिद्धये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000341047, "chapter_id": 9341, "verse_number": "५-२-४७", "content_sanskrit": "रावणस्य पुरीं रात्रौ प्रविश्य सुदुरासदाम्।\nप्रविश्य भवनं सर्वं द्रक्ष्यामि जनकात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000341048, "chapter_id": 9341, "verse_number": "५-२-४८", "content_sanskrit": "इति निश्चित्य हनुमान् सूर्यस्यास्तमयं कपिः।\nआचकाङ्क्षे तदा वीरो वैदेह्या दर्शनोत्सुकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000341049, "chapter_id": 9341, "verse_number": "५-२-४९", "content_sanskrit": "सूर्ये चास्तं गते रात्रौ देहं संक्षिप्य मारुतिः।\nवृषदंशकमात्रोऽथ बभूवाद्भुतदर्शनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000341050, "chapter_id": 9341, "verse_number": "५-२-५०", "content_sanskrit": "प्रदोषकाले हनुमांस्तूर्णमुत्पत्य वीर्यवान्।\nप्रविवेश पुरीं रम्यां प्रविभक्तमहापथाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000341051, "chapter_id": 9341, "verse_number": "५-२-५१", "content_sanskrit": "प्रासादमालाविततां स्तम्भैः काञ्चनसंनिभैः।\nशातकुम्भनिभैर्जालैर्गन्धर्वनगरोपमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000341052, "chapter_id": 9341, "verse_number": "५-२-५२", "content_sanskrit": "सप्तभौमाष्टभौमैश्च स ददर्श महापुरीम्।\nतलैः स्फटिकसंकीर्णैः कार्तस्वरविभूषितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000341053, "chapter_id": 9341, "verse_number": "५-२-५३", "content_sanskrit": "वैदूर्यमणिचित्रैश्च मुक्ताजालविभूषितैः।\nतैस्तैः शुशुभिरे तानि भवनान्यत्र रक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000341054, "chapter_id": 9341, "verse_number": "५-२-५४", "content_sanskrit": "काञ्चनानि विचित्राणि तोरणानि च रक्षसाम्।\nलंकामुद्योतयामासुः सर्वतः समलंकृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000341055, "chapter_id": 9341, "verse_number": "५-२-५५", "content_sanskrit": "अचिन्त्यामद्भुताकारां दृष्ट्वा लंकां महाकपिः।\nआसीद् विषण्णो हृष्टश्च वैदेह्या दर्शनोत्सुकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000341056, "chapter_id": 9341, "verse_number": "५-२-५६", "content_sanskrit": "स पाण्डुराविद्धविमानमालिनीं\nमहार्हजाम्बूनदजालतोरणाम्।\nयशस्विनीं रावणबाहुपालितां\nक्षपाचरैर्भीमबलैः सुपालिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000341057, "chapter_id": 9341, "verse_number": "५-२-५७", "content_sanskrit": "चन्द्रोऽपि साचिव्यमिवास्य कुर्वं-\nस्तारागणैर्मध्यगतो विराजन्।\nज्योत्स्नावितानेन वितत्य लोका-\nनुत्तिष्ठतेऽनेकसहस्ररश्मिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000341058, "chapter_id": 9341, "verse_number": "५-२-५८", "content_sanskrit": "शङ्खप्रभं क्षीरमृणालवर्ण-\nमुद‍्गच्छमानं व्यवभासमानम्।\nददर्श चन्द्रं स कपिप्रवीरः\nपोप्लूयमानं सरसीव हंसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000341059, "chapter_id": 9341, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे द्वितीयः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]