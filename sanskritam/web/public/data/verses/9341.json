[{"id": 40020712, "chapter_id": 9341, "verse_number": "1", "content_sanskrit": "स तस्य तु महानादं श्रुत्वा वैवस्वतः प्रभुः । शत्रुं विजयिनं मेने स्वबलस्य च सङ्क्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40020713, "chapter_id": 9341, "verse_number": "2", "content_sanskrit": "स हि योधान्हतान्मत्वा क्रोधसंरक्तलोचनः । अब्रवीत्त्वरितं सूतं रथो ऽयमुपनीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40020714, "chapter_id": 9341, "verse_number": "3", "content_sanskrit": "तस्य सूतस्तदा दिव्यमुपस्थाप्य महारथम् । स्थितः स च महातेजा ह्यध्यारोहत तं रथम् । प्राशमुद्गरहस्तश्च मृत्युस्तस्याग्रतः स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40020715, "chapter_id": 9341, "verse_number": "4", "content_sanskrit": "येन सङ्क्षिप्यते सर्वं त्रैलोक्यमिदमव्ययम् । कालदण्डस्तु पार्श्वस्थो मूर्तिमानस्य चाभवत् । यमप्रहरणं दिव्यं तेजसा ज्वलदग्निमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40020716, "chapter_id": 9341, "verse_number": "5", "content_sanskrit": "तस्य पार्श्वेषु निच्छिद्राः कालपाशाः प्रतिष्ठिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40020717, "chapter_id": 9341, "verse_number": "6", "content_sanskrit": "पावकस्पर्शसङ्काशः स्थितो मूर्तश्च मुद्गरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40020718, "chapter_id": 9341, "verse_number": "7", "content_sanskrit": "ततो लोकत्रयं क्षुब्धमकम्पन्त दिवौकसः । कालं दृष्ट्वा तथा क्रुद्धं सर्वलोकभयावहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40020719, "chapter_id": 9341, "verse_number": "8", "content_sanskrit": "ततः प्रचोदयन्सूतस्तानश्वान्रुचिरप्रभान् । प्रययौ भीमसन्नादो यत्र रक्षःपतिः स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40020720, "chapter_id": 9341, "verse_number": "9", "content_sanskrit": "मुहूर्तेन यमं ते तु हया हरिहयोपमाः । प्रापयन्मनसस्तुल्या यत्र तत्प्रस्तुतं रणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40020721, "chapter_id": 9341, "verse_number": "10", "content_sanskrit": "दृष्ट्वा तथैव विकृतं रथं मृत्युसमन्वितम् । सचिवा राक्षसेन्द्रस्य सहसा विप्रदुद्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40020722, "chapter_id": 9341, "verse_number": "11", "content_sanskrit": "लघुसत्त्वतया ते हि नष्टसञ्ज्ञा भयार्दिताः । नेह योद्धुं समर्थाः स्म इत्युक्त्वा प्रययुर्दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40020723, "chapter_id": 9341, "verse_number": "12", "content_sanskrit": "स तु तं तादृशं दृष्ट्वा रथं लोकभयावहम् । नाक्षुभ्यत दशग्रीवो न चापि भयमाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40020724, "chapter_id": 9341, "verse_number": "13", "content_sanskrit": "स तु रावणमासाद्य व्यसृजच्छक्तितोमरान् । यमो मर्माणि सङ्क्रुद्धो रावणस्योपकृन्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40020725, "chapter_id": 9341, "verse_number": "14", "content_sanskrit": "रावणस्तु ततः स्वस्थः शरवर्षं मुमोच ह । तस्मिन्वैवस्वतरथे तोयवर्षमिवाम्बुदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40020726, "chapter_id": 9341, "verse_number": "15", "content_sanskrit": "ततो महाशक्तिशरैः पात्यमानैर्महोरसि (पात्यमानो) । नाशक्नोत्प्रतिकर्तुं स राक्षसः शल्यपीडितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40020727, "chapter_id": 9341, "verse_number": "16", "content_sanskrit": "एवं नानाप्रहरणैर्यमेनामित्रकर्षिणा । सप्तरात्रं कृतः सङ्ख्ये विसञ्ज्ञो विमुखो रिपुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40020728, "chapter_id": 9341, "verse_number": "17", "content_sanskrit": "तदासीत्तुमुलं युद्धं यमराक्षसयोर्द्वयोः । जयमाकाङ्क्षतोर्वीर समरेष्वनिवर्तिनोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40020729, "chapter_id": 9341, "verse_number": "18", "content_sanskrit": "ततो देवाः सगन्धर्वाः सिद्धाश्च परमर्षयः । प्रजापतिं पुरस्कृत्य समेतास्तद्रणाजिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40020730, "chapter_id": 9341, "verse_number": "19", "content_sanskrit": "संवर्त इव लोकानां क्रुध्यतोरभवत्तदा । राक्षसानां च मुख्यस्य प्रेतानामीश्वरस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40020731, "chapter_id": 9341, "verse_number": "20", "content_sanskrit": "राक्षसेन्द्रो ऽपि विस्फार्य चापमिन्द्राशनिप्रभम् । निरन्तरमिवाकाशं कुर्वन्बाणांस्ततो ऽसृजत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40020732, "chapter_id": 9341, "verse_number": "21", "content_sanskrit": "मृत्युं चतुर्भिर्विशिखैः सूतं सप्तभिरार्दयत् । यमं शतसहस्रेण शीघ्रं मर्मस्वताडयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40020733, "chapter_id": 9341, "verse_number": "22", "content_sanskrit": "ततः क्रुद्धस्य वदनाद्यमस्य समजायत । ज्वालामाली सनिःश्वासः सधूमः कोपपावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40020734, "chapter_id": 9341, "verse_number": "23", "content_sanskrit": "तदाश्चर्यमथो दृष्ट्वा देवदानवसन्निधौ । प्रहर्षितौ सुसंरब्धौ मृत्युकालौ बभूवतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40020735, "chapter_id": 9341, "verse_number": "24", "content_sanskrit": "ततो मृत्युः क्रुद्धतरो वैवस्वतमभाषत । मुञ्च मां समरे यावद्धन्मीमं पापराक्षसम् । नैषा रक्षो भवेदद्य मर्यादा हि निसर्गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40020736, "chapter_id": 9341, "verse_number": "25", "content_sanskrit": "हिरण्यकशिपुः श्रीमान्नमुचिः शम्बरस्तथा । विसन्धिर्धूमकेतुश्च बलिर्वैरोचनो ऽपि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40020737, "chapter_id": 9341, "verse_number": "26", "content_sanskrit": "दम्भुर्दैत्यमहाराजो वृत्रो बाणस्तथैव च । राजर्षयः शास्त्रविदो गन्धर्वाः समहोरगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40020738, "chapter_id": 9341, "verse_number": "27", "content_sanskrit": "ऋषयः पन्नगा दैत्या यक्षाश्चाप्यप्सरोगणाः । युगान्तपरिवर्ते च पृथिवी समहार्णवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40020739, "chapter_id": 9341, "verse_number": "28", "content_sanskrit": "क्षयं नीता महाराज सपर्वतसरिद्द्रुमा । एते चान्ये च बहवो बलवन्तो दुरासदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40020740, "chapter_id": 9341, "verse_number": "29", "content_sanskrit": "विनिपन्ना मया दृष्टाः किमुतायं निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40020741, "chapter_id": 9341, "verse_number": "30", "content_sanskrit": "मुञ्चं मां साधु धर्मज्ञ यावदेनं निहन्म्यहम् । नहि कश्चिन्मया दृष्टो बलवानपि जीवति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40020742, "chapter_id": 9341, "verse_number": "31", "content_sanskrit": "बलं मम न खल्वेतन्मर्यादैषा निसर्गतः । स दृष्टो न मया कालं मुहुर्तमापि जीवति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40020743, "chapter_id": 9341, "verse_number": "32", "content_sanskrit": "तस्यैवं वचनं श्रुत्वा धर्मराजः प्रतापवान् । अब्रवीत्तत्र तं मुत्युं त्वं तिष्ठैनं निहन्म्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40020744, "chapter_id": 9341, "verse_number": "33", "content_sanskrit": "ततः संरक्तनयनः क्रुद्धो वैवस्वतः प्रभुः । कालदण्डममोघं तु तोलयामास पाणिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40020745, "chapter_id": 9341, "verse_number": "34", "content_sanskrit": "यस्य पार्श्वेषु निखिला कालपाशाः प्रतिष्ठिताः । पावकाशनिसङ्काशो मुद्गरो मूर्तिमान्स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40020746, "chapter_id": 9341, "verse_number": "35", "content_sanskrit": "दर्शनादेव यः प्राणान्प्राणिनामपकर्षति । किं पुनः स्पृश्यमानस्य पात्यमानस्य वा पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40020747, "chapter_id": 9341, "verse_number": "36", "content_sanskrit": "स ज्वालापरिवारस्तु निर्दहन्निव राक्षसम् । तेन स्पृष्टो बलवता महाप्रहरणो ऽस्फुरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40020748, "chapter_id": 9341, "verse_number": "37", "content_sanskrit": "ततो विदुद्रुवुः सर्वे तस्मात्रस्ता रणाजिरे । सुराश्च क्षुभिताः सर्वे दृष्ट्वा दण्डोद्यतं यमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40020749, "chapter_id": 9341, "verse_number": "38", "content_sanskrit": "तस्मिन्प्रहर्तुकामे तु यमे दण्डेन रावणम् । यमं पितामहः साक्षाद्दर्शयित्वेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40020750, "chapter_id": 9341, "verse_number": "39", "content_sanskrit": "वैवस्वत महाबाहो न खल्वमितविक्रम । न हन्तव्यस्त्वया तेन दण्डेनैव निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40020751, "chapter_id": 9341, "verse_number": "40", "content_sanskrit": "वरः खलु मयैतस्मै दत्तस्त्रिदशपुङ्गव । स त्वया नानृतः कार्यो यन्मया व्याहृतं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40020752, "chapter_id": 9341, "verse_number": "41", "content_sanskrit": "यो हि मामनृतं कुर्याद्देवो वा मानुषो ऽपि वा । त्रैलोक्यमनृतं तेन कृतं स्यान्नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40020753, "chapter_id": 9341, "verse_number": "42", "content_sanskrit": "क्रुद्धेन विप्रमुक्तो ऽयं निर्विशेषं प्रियाप्रिये । प्रजाः संहरते रौद्रो लोकत्रयभयावहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40020754, "chapter_id": 9341, "verse_number": "43", "content_sanskrit": "अमोघो ह्येष सर्वेषां प्राणिनाममितप्रभः । कालदण्डो मया सृष्टः पूर्वं मृत्युपुरस्कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40020755, "chapter_id": 9341, "verse_number": "44", "content_sanskrit": "तन्न खल्वेष ते सौम्य पात्यो रावणमूर्धनि । नह्यस्मिन्पतिते कश्चिन्मुहूर्तमपि जीवति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40020756, "chapter_id": 9341, "verse_number": "45", "content_sanskrit": "यदि ह्यन्मिन्निपतिते न म्रियेतैष राक्षसः । म्रियते वा दशग्रीवस्तदाप्युभयतो ऽनृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40020757, "chapter_id": 9341, "verse_number": "46", "content_sanskrit": "तन्निवर्तय लङ्केशं द्दण्डमेतं समुद्यतम् । सत्यं च मां कुरुष्वाद्य लोकांस्त्वं यद्यवेक्षसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40020758, "chapter_id": 9341, "verse_number": "47", "content_sanskrit": "एवमुक्तस्तु धर्मात्मा प्रत्युवाच यमस्तदा । एष व्यावर्तितो दण्डः प्रभविष्णुर्हि नो भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 40020759, "chapter_id": 9341, "verse_number": "48", "content_sanskrit": "किं न्विदानीं मया शक्यं कर्तुं रणगतेन हि । न मया यद्ययं शक्यो हन्तुं वरपुरस्कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 40020760, "chapter_id": 9341, "verse_number": "49", "content_sanskrit": "एष तस्मात्प्रणश्यामि दर्शनादस्य रक्षसः । इत्युक्त्वा सरथः साश्वस्तत्रैवान्तरधीयत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 40020761, "chapter_id": 9341, "verse_number": "50", "content_sanskrit": "दशग्रीवस्तु तं जित्वा नाम विश्राव्य चात्मनः । आरुह्य पुष्पकं भूयो निष्क्रान्तो यमसादनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 40020762, "chapter_id": 9341, "verse_number": "51", "content_sanskrit": "स तु वैवस्वतो देवैः सह ब्रह्मपुरोगमैः । जगाम त्रिदिवं हृष्टो नारदश्च महामुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]