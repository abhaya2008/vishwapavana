[{"id": 2157143, "chapter_id": 4407, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2157144, "chapter_id": 4407, "verse_number": "१", "content_sanskrit": "ततस्ते सैनिकाः श्रुत्वा तं युधिष्ठिरनिग्रहम् ।\nसिंहनादरवांश्चक्रुर्बाणशङ्खरवैः सह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2157145, "chapter_id": 4407, "verse_number": "२", "content_sanskrit": "ततः सर्वं यथावृत्तं धर्मराजेन भारत ।\nआप्तैश्चारैः परिज्ञातं भारद्वाजचिकीर्षितम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2157146, "chapter_id": 4407, "verse_number": "३", "content_sanskrit": "ततः सर्वान् समानाय्य भ्रातॄन् सैन्यांश्च भारत ।\nअब्रवीद् धर्मराजो वै धनञ्जयमिदं वचः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2157147, "chapter_id": 4407, "verse_number": "४", "content_sanskrit": "श्रुतं ते पुरुषव्याघ्र द्रोणस्य च चिकीर्षितम् ।\nयथा तन्न भवेत् सत्यं तथा नीतिर्विधीयताम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2157148, "chapter_id": 4407, "verse_number": "५", "content_sanskrit": "सान्तरं तु प्रतिज्ञातं द्रोणेनामित्रकर्शिना ।\nतच्चान्तरममोघेषौ त्वयि तेन समाहितम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2157149, "chapter_id": 4407, "verse_number": "६", "content_sanskrit": "तत् त्वमद्य महाबाहो युद्ध्यस्व मदनन्तरम् ।\nयथा दुर्योधनः कामं नेमं द्रोणादवाप्नुयात्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2157150, "chapter_id": 4407, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2157151, "chapter_id": 4407, "verse_number": "७", "content_sanskrit": "यथा न मे वधः कार्य आचार्यस्य कथञ्चन ।\nतथा तव परित्यागो न मे राजंश्चिकीर्षितः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2157152, "chapter_id": 4407, "verse_number": "८", "content_sanskrit": "अद्यैव पाण्डव प्राणानुत्सृजेयमहं युधि ।\nप्रतियाताऽहमाचार्यं त्वां न जह्यां कथञ्चन\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2157153, "chapter_id": 4407, "verse_number": "९", "content_sanskrit": "त्वां निगृह्याहवे राजन् धार्तराष्ट्रो यमिच्छति ।\nन स तं जीवलोकेऽस्मिन् कामं प्राप्ता कथञ्चन\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2157154, "chapter_id": 4407, "verse_number": "१०", "content_sanskrit": "प्रपतेद् द्यौः सनक्षत्रा पृथिवी शकलीभवेत् ।\nन त्वां द्रोणो निगृह्णीयात् जीवमाने मयि ध्रुवम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2157155, "chapter_id": 4407, "verse_number": "११", "content_sanskrit": "यदि तस्य रणे साह्यं कुरुते वज्रभृत् स्वयम् ।\nविष्णुर्वा सहितो देवैर्न त्वां प्राप्ता ह्यसौ रणे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2157156, "chapter_id": 4407, "verse_number": "१२", "content_sanskrit": "मयि जीवति राजेन्द्र न भयं कर्तुमर्हसि ।\nद्रोणादस्त्रभृतां श्रेष्ठात् सर्वशस्त्रभृतामपि\nअन्यच्च ब्रूयां राजेन्द्र प्रतिज्ञा मम नित्यदा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2157157, "chapter_id": 4407, "verse_number": "१३", "content_sanskrit": "न स्मराम्यनृतं प्रोक्तं न स्मरामि पराजयम् ।\nन स्मरामि प्रतिश्रुत्य किञ्चिदप्यनृतं कृतम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2157158, "chapter_id": 4407, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2157159, "chapter_id": 4407, "verse_number": "१४", "content_sanskrit": "ततः शङ्खाश्च भेर्यश्च मृदङ्गाश्च सहस्रशः ।\nप्रावाद्यन्त महाराज पाण्डवानां निवेशने\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2157160, "chapter_id": 4407, "verse_number": "१५", "content_sanskrit": "सिंहनादश्च सञ्जातः पाण्डवानां महात्मनाम् ।\nधनुर्ज्यातळशब्दश्च गगनस्पृक् सुभैरवः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2157161, "chapter_id": 4407, "verse_number": "१६", "content_sanskrit": "तं श्रुत्वा शङ्खनिर्घोषं पाण्डवस्य महौजसः ।\nत्वदीयेष्वपि सैन्येषु वादित्राण्यभिजघ्निरे\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2157162, "chapter_id": 4407, "verse_number": "१७", "content_sanskrit": "ततो व्यूढान्यनीकानि तव तेषां च भारत ।\nशनैरुपेयुरन्योन्यं योत्स्यमानानि संयुगे\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2157163, "chapter_id": 4407, "verse_number": "१८", "content_sanskrit": "ततः प्रववृते युद्धं तुमुलं लोमहर्षणम् ।\nपाण्डवानां कुरूणां च द्रोणपाञ्चालयोरपि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2157164, "chapter_id": 4407, "verse_number": "१९", "content_sanskrit": "यतमानाः प्रयत्नेन द्रोणानीकविशातने ।\nन शेकुः सृञ्जया राजंस्तद्धि द्रोणेन पालितम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2157165, "chapter_id": 4407, "verse_number": "२०", "content_sanskrit": "तथैव तव पुत्रस्य रथोदाराः प्रहारिणः ।\nन शेकुः पाण्डवीं सेनां पाल्यमानां किरीटिना\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2157166, "chapter_id": 4407, "verse_number": "२१", "content_sanskrit": "ते सेने स्तिमिते आस्तां सम्प्रसक्ते परस्परम् ।\nसमासक्ते यथा नक्तं वनराजी सुपुष्पिते\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2157167, "chapter_id": 4407, "verse_number": "२२", "content_sanskrit": "ततो रुग्मरथो राजन्नर्केणेव विराजता ।\nवरूथिनीं विनिष्पत्य व्यचरत् पृतनान्तरे\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2157168, "chapter_id": 4407, "verse_number": "२३", "content_sanskrit": "तमुद्यन्तं रथेनैकमाशुकारिणमाहवे ।\nअनेकमिव सन्त्रासान्मेनिरे पाण्डुसृञ्जयाः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2157169, "chapter_id": 4407, "verse_number": "२४", "content_sanskrit": "तेन मुक्ताः शरा घोरा विचेरुः सर्वतोदिशम् ।\nत्रासयन्तो महाराज पाण्डवेयस्य वाहिनीम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2157170, "chapter_id": 4407, "verse_number": "२५", "content_sanskrit": "मध्यन्दिनमनुप्राप्तो गभस्तिशतसंवृतः ।\nयथाऽदृश्यत घर्मांशुस्तथा द्रोणोऽप्यदृश्यत\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2157171, "chapter_id": 4407, "verse_number": "२६", "content_sanskrit": "न चैनं पाण्डवेयानां कश्चिच्छक्नोति भारत ।\nवीक्षितुं समरे क्रुद्धं महेन्द्रमिव दानवाः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2157172, "chapter_id": 4407, "verse_number": "२७", "content_sanskrit": "मोहयित्वा ततः सेनां भारद्वाजः प्रतापवान् ।\nधृष्टद्युम्नबलं तूर्णं व्यधमन्निशितैः शरैः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2157173, "chapter_id": 4407, "verse_number": "२८", "content_sanskrit": "स दिशः सर्वतो गत्वा संवृत्य खमजिह्मगैः ।\nपार्षतो यत्र तत्रैनामभिनत् पाण्डुवाहिनीम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2157174, "chapter_id": 4407, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि द्वादशोऽध्यायः ॥ १२ ॥\nद्रोणाभिषेकपर्वणि द्वादशोऽध्यायः ॥ १२ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]