[{"id": 900003898, "chapter_id": 8310, "verse_number": "6.1", "content_sanskrit": "निवृत्तिमार्गः कथित आदौ भगवता यथा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900003899, "chapter_id": 8310, "verse_number": "6.2", "content_sanskrit": "एतत्ते भगवद्दूता यमदूताभिभाषितम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900003900, "chapter_id": 8310, "verse_number": "6.3", "content_sanskrit": "निशम्य देवः स्वभटोपवर्णितं", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900003901, "chapter_id": 8310, "verse_number": "6.4", "content_sanskrit": "देवासुरनृणां सर्गो नागानां मृगपक्षिणाम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900003902, "chapter_id": 8310, "verse_number": "6.5", "content_sanskrit": "तस्यां स पाञ्चजन्यां वै विष्णुमायोपबृंहितः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900003903, "chapter_id": 8310, "verse_number": "6.6", "content_sanskrit": "ततः प्राचेतसोऽसिक्न्यामनुनीतः स्वयम्भुवा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900003904, "chapter_id": 8310, "verse_number": "6.7", "content_sanskrit": "यस्य हेतोः परित्यक्ता आचार्येणात्मनः सुराः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900003905, "chapter_id": 8310, "verse_number": "6.8", "content_sanskrit": "यया गुप्तः सहस्राक्षः सवाहान् रिपुसैनिकान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900003906, "chapter_id": 8310, "verse_number": "6.9", "content_sanskrit": "तस्यासन् विश्वरूपस्य शिरांसि त्रीणि भारत", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900003907, "chapter_id": 8310, "verse_number": "6.10", "content_sanskrit": "इन्द्रमेवं समादिश्य भगवान् विश्वभावनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900003908, "chapter_id": 8310, "verse_number": "6.11", "content_sanskrit": "त एवं शंसतो धर्मं वचः पत्युरचेतसः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900003909, "chapter_id": 8310, "verse_number": "6.12", "content_sanskrit": "एवं जिहासुर्नृप देहमाजौ मृत्युं परं विजयं मन्यमानः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900003910, "chapter_id": 8310, "verse_number": "6.13", "content_sanskrit": "वृत्रे हते त्रयो लोका विना शक्रेण भूरिद", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900003911, "chapter_id": 8310, "verse_number": "6.14", "content_sanskrit": "रजस्तमस्स्वभावस्य ब्रह्मन् वृत्रस्य पाप्मनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900003912, "chapter_id": 8310, "verse_number": "6.15", "content_sanskrit": "ऊचतुर्मृतकोपान्ते पतितं मृतकोपमम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900003913, "chapter_id": 8310, "verse_number": "6.16", "content_sanskrit": "अथ देवऋषी राजन् सम्परेतं नृपात्मजम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900003914, "chapter_id": 8310, "verse_number": "6.17", "content_sanskrit": "यतश्चान्तर्हितोऽनन्तस्तस्यै कृत्वा दिशे नमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900003915, "chapter_id": 8310, "verse_number": "6.18", "content_sanskrit": "पृश्निस्तु पत्नी सवितुः सावित्रीं व्याहृतीं त्रयीम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900003916, "chapter_id": 8310, "verse_number": "6.19", "content_sanskrit": "व्रतं पुंसवनं ब्रह्मन् भवता यदुदीरितम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]