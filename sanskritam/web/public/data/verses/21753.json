[{"id": 7001753000, "chapter_id": 21753, "verse_number": "२-१४-१", "content_sanskrit": "वसिष्ठ उवाच ।\nसंप्रस्थितावुभौ राजन्गिरिशीर्षाद्धरातलम् ।\nपश्यमानौ बहून्भावान्गिरिजातान्मनोहरमनोहरान् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001753001, "chapter_id": 21753, "verse_number": "२-१४-२", "content_sanskrit": "केचिद्विद्रुमसंकाशाः केचिद्रजतसन्निभाः ।\nकेचिन्नीलसमप्रख्याः केचित्कांचनसत्विषः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001753002, "chapter_id": 21753, "verse_number": "२-१४-३", "content_sanskrit": "केचित्स्फाटिकवर्णाभा हरितालनिभाः परे ।\nअन्योन्यश्लेषतां प्राप्तौ सकलैः स्थावरैरिव ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001753003, "chapter_id": 21753, "verse_number": "२-१४-४", "content_sanskrit": "सप्राप्य वसुधां भूपो ह्यपश्यद्वाजिनां वरम् ।\nखन्यमानं खुरेणोर्वी कुलिशाभेन वेगिना ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001753004, "chapter_id": 21753, "verse_number": "२-१४-५", "content_sanskrit": "तस्य दारयतः पृथ्वीं सुतीक्ष्णेन खुरेण हि ।\nगृहगोधाभवत्तस्मिन् भूभागांतर्गता किल ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001753005, "chapter_id": 21753, "verse_number": "२-१४-६", "content_sanskrit": "निर्गच्छमाना नृपते खुरेण विदलीकृता ।\nविदीर्यमाणां नृपतिरपश्यत्स दयापरः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001753006, "chapter_id": 21753, "verse_number": "२-१४-७", "content_sanskrit": "अभ्यधावत वेगेन हा हतेति प्रियां वदन् ।\nततः स वृक्षपत्रेण कोमलेन महीपतिः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001753007, "chapter_id": 21753, "verse_number": "२-१४-८", "content_sanskrit": "उत्सार्य तां खुरादाशु प्राक्षिपत्तृणशाद्वले ।\nततस्तु मोहिनीं प्राह प्रेक्ष्य मूर्च्छागतां हि ताम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001753008, "chapter_id": 21753, "verse_number": "२-१४-९", "content_sanskrit": "शीघ्रमाहर चार्वंगिजलं जलजलोचने ।\nयेन मूर्च्छागतां सिंचे गृहगोधां विमर्द्दिताम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001753009, "chapter_id": 21753, "verse_number": "२-१४-१०", "content_sanskrit": "सा भर्तुर्वचनाच्छीघ्रमानयच्छीतलं जलम् ।\nतेनाभ्यषिं चन्नृपतिर्गृहगोधां विमूर्च्छिताम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001753010, "chapter_id": 21753, "verse_number": "२-१४-११", "content_sanskrit": "अवाप चेतनां राजन् शीतलाज्जलसेचनात् ।\nअभिघातेषु सर्वेषु शस्तं वारिप्रसेचनम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001753011, "chapter_id": 21753, "verse_number": "२-१४-१२", "content_sanskrit": "अथवा क्लिन्नवस्त्रेण सहसा बंधनं हितम् ।\nसंप्राप्तचेतना भूप गोधा वचनमब्रवीत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001753012, "chapter_id": 21753, "verse_number": "२-१४-१३", "content_sanskrit": "राजानमग्रतो वीक्ष्य वेदनार्ता शनैः शनैः ।\nरुक्मांगद महाबाहो निबोध मम चेष्टितम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001753013, "chapter_id": 21753, "verse_number": "२-१४-१४", "content_sanskrit": "शाकले नगरे रम्ये भार्याहं ह्यग्रजन्मनः ।\nरूपयौवनसंपन्ना तस्य नातिप्रिया विभो ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001753014, "chapter_id": 21753, "verse_number": "२-१४-१५", "content_sanskrit": "सदा विद्वेषसंयुक्तो मयि निष्ठुरजल्पकः ।\nनान्यस्य कस्यचिद्द्वेष्टा स तु मे नृपते पतिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001753015, "chapter_id": 21753, "verse_number": "२-१४-१६", "content_sanskrit": "ततोऽह क्रोधसंयुक्ता वशीकरणलंभनात् अपृच्छं प्रमदा राजन्यास्त्यक्ताः पतिभिः किल ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001753016, "chapter_id": 21753, "verse_number": "२-१४-१७", "content_sanskrit": "ताभिरुक्ता ह्यहं भूप वश्यो भर्ता भविष्यति ।\nअस्माकं प्रत्ययो जातो भर्तृत्यागावमाननात् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001753017, "chapter_id": 21753, "verse_number": "२-१४-१८", "content_sanskrit": "प्रव्रज्याभेषजैर्वश्या जाता हि पतयस्तु नः ।\nत्वं पृच्छ तां वरारोहे दास्यते भेषजं शुभम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001753018, "chapter_id": 21753, "verse_number": "२-१४-१९", "content_sanskrit": "न विकल्पस्त्वया कार्यो भविता दासवत्पतिः ।\nततोऽहं त्वरितं गत्वा तासां वाक्येन भूपते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001753019, "chapter_id": 21753, "verse_number": "२-१४-२०", "content_sanskrit": "प्रासादः कथितस्तस्याः पृच्छंत्या मम मानवैः ।\nशतस्तंभसमायुक्तः कांतिमत्सुधया युतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001753020, "chapter_id": 21753, "verse_number": "२-१४-२१", "content_sanskrit": "प्रविश्य तं सुतेजस्कामपश्यं ब्रह्यचारिणीम् ।\nप्रावृतां दीर्घवस्त्रेण सन्ध्यारागसवर्णिनीम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001753021, "chapter_id": 21753, "verse_number": "२-१४-२२", "content_sanskrit": "दीर्घाभिः सा जटाभिस्तु संवृता दीप्तिसयुता ।\nपरिचारकैस्तु संयुक्ता वीज्यमाना शनैः शनैः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001753022, "chapter_id": 21753, "verse_number": "२-१४-२३", "content_sanskrit": "अक्षसूत्रकरा सा तु जपन्ती भगमालिनी ।\nसर्ववश्यकरं मन्त्रं क्षोभकं प्रत्ययावहम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001753023, "chapter_id": 21753, "verse_number": "२-१४-२४", "content_sanskrit": "ततोऽहं प्रणता भूत्वा पद्भ्यां न्यस्यांगलीयकम् ।\nमृदुकांचनसंभूतं अतिरिक्तप्रभान्वितम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001753024, "chapter_id": 21753, "verse_number": "२-१४-२५", "content_sanskrit": "ततो हृष्टाऽभवद्दृष्ट्वा पदस्थं चांगुलीयकम् ।\nअपृष्टया तया ज्ञातं मम भर्त्तुर्विमाननम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001753025, "chapter_id": 21753, "verse_number": "२-१४-२६", "content_sanskrit": "तयोक्ताहं ततो भूप तापस्या प्रणता स्थिता ।\nचूर्णो रक्षान्वितो ह्येष सर्वभूतवशानुगः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001753026, "chapter_id": 21753, "verse_number": "२-१४-२७", "content_sanskrit": "त्वया भर्तरि संयोज्यो रक्ष्यं ग्रीवाशयांकुरम् ।\nभविष्यति पतिर्वश्यो नान्यां यास्यति सुन्दरीम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001753027, "chapter_id": 21753, "verse_number": "२-१४-२८", "content_sanskrit": "चूर्णरक्षां गृहीत्वाहं प्राप्ताभर्तृगृहं पुनः ।\nप्रदोषे पयसा युक्तश्चूर्णो भर्तरि योजितः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001753028, "chapter_id": 21753, "verse_number": "२-१४-२९", "content_sanskrit": "ग्रीवायां हि कृता रक्षा न विचारो मया कृतः ।\nयदा स पीतचूर्णस्तु भर्ता नृपवरोत्तमा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001753029, "chapter_id": 21753, "verse_number": "२-१४-३०", "content_sanskrit": "तदहः क्षयरोगोऽभूत्पतिः क्षीणो दिने दिने ।\nगुह्ये तु क्रिमयो जाताः क्षतदुष्टव्रणोद्भवाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001753030, "chapter_id": 21753, "verse_number": "२-१४-३१", "content_sanskrit": "दिनैः कतिपयैर्जातैर्दीपवद्रविदर्शनात् ।\nहततेजास्तथा भर्त्ता मामुवाचाकुलेन्द्रियः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001753031, "chapter_id": 21753, "verse_number": "२-१४-३२", "content_sanskrit": "क्रंदमानो दिवा रात्रौ दासोऽस्मि तव शोभने ।\nत्राहि मां शरणं प्राप्तं न गच्छेयं परिस्त्रियम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001753032, "chapter_id": 21753, "verse_number": "२-१४-३३", "content_sanskrit": "तत्तस्य रुदितं श्रुत्वा भयभीता महीपते ।\nतस्यां निवेदितं सर्वं कथं भर्ता भवेत्सुखी ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001753033, "chapter_id": 21753, "verse_number": "२-१४-३४", "content_sanskrit": "तयापि भेषजं दत्तं द्वितीयं दाहशांतये ।\nदत्ते तु भेषजे तस्मिन्सुस्थोऽभूत्तत्क्षणात्पतिः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001753034, "chapter_id": 21753, "verse_number": "२-१४-३५", "content_sanskrit": "पूर्वचूर्णोद्भवो दाहः शांतस्तेनौषधेन ह ।\nततः प्रभृति मे भर्ता वश्योऽभूद्वचने स्थितः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001753035, "chapter_id": 21753, "verse_number": "२-१४-३६", "content_sanskrit": "कालेन पञ्चतां प्राप्ता गता नरकयातनाम् ।\nताम्रभ्राष्ट्रे ह्यहं दग्धा युगानि दश पञ्च च ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001753036, "chapter_id": 21753, "verse_number": "२-१४-३७", "content_sanskrit": "सूक्ष्माणि तिलमात्राणि कृत्वा खण्डान्यनेकशः ।\nकिंचित्पातकशेषेण धरायामवतारिता ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001753037, "chapter_id": 21753, "verse_number": "२-१४-३८", "content_sanskrit": "गृहगोधामयं रूपं कृतं भास्करजेन मे ।\nसाहमत्र स्थिता भूप वर्षाणामयुतं पुरा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001753038, "chapter_id": 21753, "verse_number": "२-१४-३९", "content_sanskrit": "यान्यापि युवतिर्भूप भर्तुर्वश्यं समाचरेत् ।\nवृथाधर्मा दुराचारा दह्यते ताम्रभ्राष्ट्रके ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001753039, "chapter_id": 21753, "verse_number": "२-१४-४०", "content_sanskrit": "भर्ता नाथो गतिर्भर्ता दैवतं गुरुरेव च ।\nतस्य वश्यं चरेद्या तु सा कथं सुखमाप्नुयात् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001753040, "chapter_id": 21753, "verse_number": "२-१४-४१", "content_sanskrit": "तिर्यग्योनिशतं याति क्रिमिकुष्ठसमन्विता ।\nतस्माद्भूपाल कर्तव्यं स्त्रीभिर्भर्तृवचः सदा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001753041, "chapter_id": 21753, "verse_number": "२-१४-४२", "content_sanskrit": "साहं यास्ये पुनर्योनिं कुत्सितां पातकान्विताम् ।\nयदि नोद्धरसे राजन्नद्य मां शरणागताम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001753042, "chapter_id": 21753, "verse_number": "२-१४-४३", "content_sanskrit": "सुकृतस्य प्रदानेन विजयाजनितेन हि ।\nया त्वया संगमे पुण्ये कृता श्रवणद्वादशी ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001753043, "chapter_id": 21753, "verse_number": "२-१४-४४", "content_sanskrit": "सरय्वाश्चैव गंगायाः पापनाशविधायके ।\nप्रेतनिर्यातनी पुण्या मानसेप्सितदायिनी ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001753044, "chapter_id": 21753, "verse_number": "२-१४-४५", "content_sanskrit": "यस्यां गृहेऽपि भूपाल संस्मृतो मनुजैर्हरिः ।\nसर्वतीर्थफलावाप्तिं कुरुते नात्र संशयः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001753045, "chapter_id": 21753, "verse_number": "२-१४-४६", "content_sanskrit": "दत्तं जप्तं हुतं यच्च कृतं देवार्चनादिकम् ।\nसर्वं तदक्षयं भूप यत्कृतं विजयादिने ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001753046, "chapter_id": 21753, "verse_number": "२-१४-४७", "content_sanskrit": "एवंविधं फलं यस्यास्तद्देहि सुकृतं मम ।\nद्वादश्यामुपवासेन त्रयोदश्यां तु पारणे ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001753047, "chapter_id": 21753, "verse_number": "२-१४-४८", "content_sanskrit": "द्वादशाब्दोपवासस्य फलं प्राप्तोत्युपोषणे ।\nदयां कृत्वा महीपाल धर्ममूर्तिर्भवान् क्षितौ ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001753048, "chapter_id": 21753, "verse_number": "२-१४-४९", "content_sanskrit": "वैवस्वतपथध्वंसी परित्राहि सुदुःखिताम् ।\nगृहगोधावचः श्रुत्वा मोहिनी वाक्यमब्रवीत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001753049, "chapter_id": 21753, "verse_number": "२-१४-५०", "content_sanskrit": "स्वकृतं तु जनोऽश्नाति सुखदुःखात्मकं विभो ।\nतस्मात्किमनया कार्यं पापया भर्तुदुष्टया ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001753050, "chapter_id": 21753, "verse_number": "२-१४-५१", "content_sanskrit": "यया भर्ता वशं नीतो रक्षाचूर्णादिभिर्नृप ।\nसाधुभ्यो यत्कृतं राजन्यशःस्वर्गकरं भवेत् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001753051, "chapter_id": 21753, "verse_number": "२-१४-५२", "content_sanskrit": "उभयोर्भ्रं शतामेति पापेभ्यो यत्कृतं भवेत् ।\nशर्करामिश्रितं क्षीरं काद्रवेये नियोजितम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001753052, "chapter_id": 21753, "verse_number": "२-१४-५३", "content_sanskrit": "विषवृद्धिं करोत्येव तद्वत्पापकृतं भवेत् ।\nपरित्यजेमां त्वं पापां गच्छावो नगराय वै ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001753053, "chapter_id": 21753, "verse_number": "२-१४-५४", "content_sanskrit": "जन्मव्यापारसक्तानामात्मसौख्यं विनश्यति ।\nरुक्मांगद उवाच ।\nब्रह्मात्मजे कथं वाक्यमीदृशं व्याहृतदं त्वया ।\nन साधूनामिदं वृत्तं भवतीति वरानने ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001753054, "chapter_id": 21753, "verse_number": "२-१४-५५", "content_sanskrit": "आत्मसौख्यकराः पापा भवंति परतापिनः ।\nविप्रपन्ना वरारोहे परोपकरणाय वै ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001753055, "chapter_id": 21753, "verse_number": "२-१४-५६", "content_sanskrit": "शशी सूर्योऽथ पर्जन्यो मेदिनी हुतभुग्जलम् ।\nचंदनं पादपाः संतः परोपकरणाय वै ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001753056, "chapter_id": 21753, "verse_number": "२-१४-५७", "content_sanskrit": "श्रूयते किल राजासीद्धरिश्चंद्रो वरानने ।\nचांडालमंदिरावासी भार्यातनयविक्रयी ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001753057, "chapter_id": 21753, "verse_number": "२-१४-५८", "content_sanskrit": "असत्यवचनाद्भीतो दुःखाद्दुःखतरं गतः ।\nतस्य सत्येन संतुष्टादेवाः शक्रपुरोगमाः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001753058, "chapter_id": 21753, "verse_number": "२-१४-५९", "content_sanskrit": "वरेण छंदयांचक्रुर्हरिश्चंद्रं महीपतिम् ।\nतेन सत्यवता चोक्ता देवा ब्रह्मपुरोगमाः ।\nयदि तुष्टा हि विबुधा वरं मे दातुमर्हथ ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001753059, "chapter_id": 21753, "verse_number": "२-१४-६०", "content_sanskrit": "एषा हि नगरी सर्वा सद्रुमा ससरीसृपा ।\nसबालवृद्धतरुणा सनारी सचतुष्पदा ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001753060, "chapter_id": 21753, "verse_number": "२-१४-६१", "content_sanskrit": "प्रयातु कृतपापापिस्वर्गतिं नगरी मम ।\nअयोध्यापातकं गृह्य गंताहं नरकं ध्रुवम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001753061, "chapter_id": 21753, "verse_number": "२-१४-६२", "content_sanskrit": "एकाकी नहि गच्छामि परित्यज्य जनं क्षितौ ।\nस्वर्गं विबुधशार्दूलाः सत्यमेतन्मयेरितम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001753062, "chapter_id": 21753, "verse_number": "२-१४-६३", "content_sanskrit": "तस्य तां स्थिरतां ज्ञात्वा सह तेनैव सा पुरी ।\nजगाम स्वर्गलोकं च इंद्रादीनामनुज्ञया ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001753063, "chapter_id": 21753, "verse_number": "२-१४-६४", "content_sanskrit": "सोऽपि स्वर्गे स्थितो राजा स्वपुरेण समन्वितः ।\nकामगेन विमानेन पूज्यमानोऽमरैरपि ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001753064, "chapter_id": 21753, "verse_number": "२-१४-६५", "content_sanskrit": "अस्थिदानं कृतं देवि कृपया हि दधीचिना ।\nदेवानामुपकारार्थं श्रुत्वा दैत्यैः पराजितान् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001753065, "chapter_id": 21753, "verse_number": "२-१४-६६", "content_sanskrit": "कपोतार्थं स्वमांसानि शिबिना भूभुजा पुरा ।\nप्रदत्तानि वरारोहे श्येनाय क्षुधिताय वै ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001753066, "chapter_id": 21753, "verse_number": "२-१४-६७", "content_sanskrit": "जीमूतवाहनो राजा पुरासीत्क्षितिमंडले ।\nतेनापि जीवितं दत्तं पन्नगाय वरानने ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001753067, "chapter_id": 21753, "verse_number": "२-१४-६८", "content_sanskrit": "तस्माद्दयालुना देवि भवितव्यं महीभुजा ।\nशुचावमेध्येऽपि शुभे समं वर्षति वारिदः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001753068, "chapter_id": 21753, "verse_number": "२-१४-६९", "content_sanskrit": "चांडालपतितौ चंद्रो ह्लादयेच्च निजैः करैः ।\nतस्मादिमां वरारोहे गृह गोधां सुदुःखिताम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001753069, "chapter_id": 21753, "verse_number": "२-१४-७०", "content_sanskrit": "उद्धरिष्ये निजैः पुण्यैर्दौहित्रैर्नाहुषो यथा ।\nविमोहिनीं तिरस्कृत्य गृहगोधामुवाच ह ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001753070, "chapter_id": 21753, "verse_number": "२-१४-७१", "content_sanskrit": "दत्तं दत्तं मया पुण्यं विजयासंभवं तव ।\nगच्छ विष्णुगताँल्लोकान्विधूताशेषकल्मषा ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001753071, "chapter_id": 21753, "verse_number": "२-१४-७२", "content_sanskrit": "तद्वाक्यात्सहसा भूप दिव्याभरणभूषिता ।\nविमुच्य देहं तज्जीर्णं गृहगोधासमुद्भवम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001753072, "chapter_id": 21753, "verse_number": "२-१४-७३", "content_sanskrit": "जगामामंत्र्य तं भूपं द्योतयंती दिशो दश ।\nसीमंतमिव कुर्वाणा वैष्णवं पदमुद्भुतम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001753073, "chapter_id": 21753, "verse_number": "२-१४-७४", "content_sanskrit": "यद्योगिगम्यं हुतभुक्प्रकाशं वरं वरेण्यं परमात्मभूतम् ।\nतम्मादियं चैव शिखिप्रदीपा जगत्प्रकाशाय नृपप्रसूता ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]