[{"id": 2063698, "chapter_id": 2356, "verse_number": "८-७७-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2063699, "chapter_id": 2356, "verse_number": "८-७७-१", "content_sanskrit": "ततः पुनरमेयात्मा केशवोऽर्जुनमब्रवीत्।\nकृतसङ्कल्पमायान्तं वधे कर्णस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2063700, "chapter_id": 2356, "verse_number": "८-७७-२", "content_sanskrit": "अद्य सप्तदशाहानि वर्तमानस्य नित्यशः।\nविनाशस्यातिघोरस्य नरवारणवाजिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2063701, "chapter_id": 2356, "verse_number": "८-७७-३", "content_sanskrit": "भूत्वा हि विपुला सेना तावकानां परैः सह।\nअन्योन्यं समरं प्राप्य किञ्चिच्छेषा विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2063702, "chapter_id": 2356, "verse_number": "८-७७-४", "content_sanskrit": "भूत्वा वै कौरवाः पार्थ प्रभूतगजवाजिनः।\nत्वां वै शत्रुं समासाद्य विनष्टा रणमूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2063703, "chapter_id": 2356, "verse_number": "८-७७-५", "content_sanskrit": "एते ते पृथिवीपालाः सृञ्जयाश्च समागताः।\nत्वां समासाद्य दुर्धर्षं पाण्डवाश्च व्यवस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2063704, "chapter_id": 2356, "verse_number": "८-७७-६", "content_sanskrit": "पाञ्चालैः पाण्डवैर्मात्स्यैः कारूशैश्चेदिभिः सह।\n`मगधैः पारिजातैश्च दाक्षिणात्यैः सकेरलैः।\nत्वया गुप्तैरमित्रघ्नैः कृतः शत्रुगणक्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2063705, "chapter_id": 2356, "verse_number": "८-७७-७", "content_sanskrit": "को हि शक्तो रणे जेतुं कौरवांस्तात संयुगे।\nअन्यत्र पाण्डवाद्युद्धे श्वेताश्वाद्वानरध्वजात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2063706, "chapter_id": 2356, "verse_number": "८-७७-८", "content_sanskrit": "शक्तस्त्वं हि रणे जेतुं ससुरासुरमानुषान्।\nत्रींल्लोकान्समरे युक्तान्किं पुनः कौरवं बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2063707, "chapter_id": 2356, "verse_number": "८-७७-९", "content_sanskrit": "भगदत्तं च राजानं कोऽन्यः शक्तस्त्वया विना।\nजेतुं पुरुषशार्दूल योऽपि स्याद्वासवोपमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2063708, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "तथेमां विपुलां सेनां गुप्तां पार्थ त्वयाऽनघ।\nन शेकुः पार्थिवाः सर्वे चक्षुर्भिरपि वीक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2063709, "chapter_id": 2356, "verse_number": "८-७७-११", "content_sanskrit": "तथैव सततं पार्थ रक्षिताभ्यां त्वया रणे।\nधृष्टद्युम्नशिखण़्डिभ्यां द्रोणभीष्मौ निपातितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2063710, "chapter_id": 2356, "verse_number": "८-७७-१२", "content_sanskrit": "को हि शक्तो रणे पार्थ भारतानां महारथौ।\nभीष्मद्रोणौ युधा जेतुं शक्रतुल्यपराक्रमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2063711, "chapter_id": 2356, "verse_number": "८-७७-१३", "content_sanskrit": "को हि शान्तनवं भीष्मं द्रोणं वैकर्तनं कृपम्।\nद्रौणिं च सौमदत्तिं च कृतवर्माणमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2063712, "chapter_id": 2356, "verse_number": "८-७७-१४", "content_sanskrit": "सैन्धवं मद्रराजं च राजानं च सुयोधनम्।\nवीरान्कृतास्त्रान्समरे सर्वानेवानिवर्तिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2063713, "chapter_id": 2356, "verse_number": "८-७७-१५", "content_sanskrit": "अक्षौहिणीपतीनुग्रान्संहतान्युद्धदुर्मदान्।\nत्वामृते पुरुषव्याघ्र जेतुं शक्तः पुमानिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2063714, "chapter_id": 2356, "verse_number": "८-७७-१६", "content_sanskrit": "श्रेण्यश्च बहुलाः क्षीणाः प्रदीर्णाश्वरथद्विपाः।\nनानाजनपदाश्चोग्राः क्षत्रियाणाममर्षिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2063715, "chapter_id": 2356, "verse_number": "८-७७-१७", "content_sanskrit": "गणाश्च दासमीयानां वसातीनां च भारत।\nप्राच्यानां वाटधानानां भोजानां चाभिमानिनाम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2063716, "chapter_id": 2356, "verse_number": "८-७७-१८", "content_sanskrit": "उदीर्णाश्वगजा सेना सर्वक्षत्रस्य भारत।\nत्वां समासाद्य निधनं गता भीमं च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2063717, "chapter_id": 2356, "verse_number": "८-७७-१९", "content_sanskrit": "उग्राश्च भीमकर्माणस्तुषारा यवनाः खशाः।\nदार्वाभिसारा दरदाः शका माठरतङ्कणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2063718, "chapter_id": 2356, "verse_number": "८-७७-२०", "content_sanskrit": "आन्ध्रकाश्च पुलिन्दाश्च किराताश्चोग्रविक्रमाः।\nम्लेच्छाश्च पर्वतीयाश्च सागरानूपवासिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2063719, "chapter_id": 2356, "verse_number": "८-७७-२१", "content_sanskrit": "संरम्भिणो युद्धशौण्डा बलिनो दण्डपाणयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2063720, "chapter_id": 2356, "verse_number": "८-७७-२१", "content_sanskrit": "एते सुयोधनस्यार्थे संरब्धाः कुरुभिः सह।\nन शक्या युधि निर्जेतुं त्वदन्येन परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2063721, "chapter_id": 2356, "verse_number": "८-७७-२२", "content_sanskrit": "एते सुयोधनस्यार्थे संरब्धाः कुरुभिः सह।\nन शक्या युधि निर्जेतुं त्वदन्येन परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2063722, "chapter_id": 2356, "verse_number": "८-७७-२३", "content_sanskrit": "धार्तराष्ट्रमुदग्रं हि व्यूढं दृष्ट्वा महद्बलम्।\nयदि त्वं न भवेस्त्राता प्रतीयात्को नु मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2063723, "chapter_id": 2356, "verse_number": "८-७७-२४", "content_sanskrit": "तत्सागरमिवोद्वूतं रजसा संवृतं बलम्।\nविदार्य पाण्डवैः क्रुद्धैस्त्वया गुप्तैर्हतं विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2063724, "chapter_id": 2356, "verse_number": "८-७७-२५", "content_sanskrit": "मागधानामधिपतिर्जयत्सेनो महाबलः।\nअद्य सप्तैव चाहानि हतः सङ्ख्येऽभिमन्युना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2063725, "chapter_id": 2356, "verse_number": "८-७७-२६", "content_sanskrit": "ततो दशसहस्राणि गजानां भीमकर्मणाम्।\nजघान गदया भीमस्तस्य राज्ञः परिच्छदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2063726, "chapter_id": 2356, "verse_number": "८-७७-२७", "content_sanskrit": "तथान्येऽभिहता नागा रथाश्च शतशो बलात्।\nतदेवं समरे पार्थ वर्तमाने महाभये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2063727, "chapter_id": 2356, "verse_number": "८-७७-२८", "content_sanskrit": "भीमसेनं समासाद्य त्वां च पाण्डव कौरवाः।\nसवाजिरथमातङ्गा मृत्युलोकमितो गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2063728, "chapter_id": 2356, "verse_number": "८-७७-२९", "content_sanskrit": "तथा सेनामुखे तत्र निहते पार्थ पाण्डवैः।\nभीष्मः प्रासृजदुग्राणि शरतालानि मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2063729, "chapter_id": 2356, "verse_number": "८-७७-३०", "content_sanskrit": "सचेदिकाशिपाञ्चालान्करूशान्मात्स्यकेकयान्।\nशरैः प्रच्छाद्य निधनमनयत्परमास्त्रवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2063730, "chapter_id": 2356, "verse_number": "८-७७-३१", "content_sanskrit": "तस्य चापच्युतैर्बाणैः परदेहविदारणैः।\nपूर्णमाकाशमभवद्रुक्मपुह्खैरजिह्मगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2063731, "chapter_id": 2356, "verse_number": "८-७७-३२", "content_sanskrit": "हन्याद्रथसहस्राणि एकैकेनैव मुष्टिना।\nलक्षं नरद्विपान्हत्वा समेतान्समहाबलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2063732, "chapter_id": 2356, "verse_number": "८-७७-३३", "content_sanskrit": "गत्या दशम्या ते गत्वा जघ्नुर्वाजिरथद्विपान्।\nहित्वा नवगतीर्दुष्टाः स बाणानाहवेऽत्यजत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2063733, "chapter_id": 2356, "verse_number": "८-७७-३४", "content_sanskrit": "दिनानि दश भीष्मेण निघ्नता तावकं बलम्।\nशून्याः कृता रथोपस्था हताश्च गजवाजिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2063734, "chapter_id": 2356, "verse_number": "८-७७-३५", "content_sanskrit": "`दशमेऽहनि सम्प्राप्ते कृत्वा घोरं पराक्रमम्।\nदर्शयित्वाऽऽत्मनो रूपं रुद्रोपेन्द्रसमं युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2063735, "chapter_id": 2356, "verse_number": "८-७७-३६", "content_sanskrit": "पाण्डवानामनीकानि प्रविगाह्य विशाम्पते।\nविनिघ्नन्पृथिवीपालांश्चेदिपाञ्चालकेकयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2063736, "chapter_id": 2356, "verse_number": "८-७७-३७", "content_sanskrit": "अहनत्पाण्डवीं सेनां रथाश्वगजसङ्कुलाम्।\nमज्जन्तमप्लुवे मन्दमुज्जिहीर्षुः सुयोधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2063737, "chapter_id": 2356, "verse_number": "८-७७-३८", "content_sanskrit": "तथा चरन्तं समरे तपन्तमिव भास्करम्।\nपदातिकोटिसाहस्राः प्रवरायुधपाणयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2063738, "chapter_id": 2356, "verse_number": "८-७७-३९", "content_sanskrit": "न शेकुः सृञ्जया द्रष्टुं तथैवान्ये महीक्षितः।\nविचरन्तं तथा तं तु सङ्ग्रमे जितकाशिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2063739, "chapter_id": 2356, "verse_number": "८-७७-४०", "content_sanskrit": "सर्वोद्यमेन महता पाण्डवान्समभिद्रवत्।\nस तु विद्राव्य समरे पाण्डवान्सृञ्जयानपि।\nएक एव रणे भीष्म एकवीरत्वमागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2063740, "chapter_id": 2356, "verse_number": "८-७७-४१", "content_sanskrit": "तं शिखण्डी समासाद्य त्वया गुप्तो महाव्रतम्।\nजघान पुरुषव्याघ्रं शरैः सन्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2063741, "chapter_id": 2356, "verse_number": "८-७७-४२", "content_sanskrit": "स एष पतितः शेते शरतल्पे पितामहः।\nत्वां प्राप्य पुरुषव्याघ्रं वृत्रः प्राप्येव वासवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2063742, "chapter_id": 2356, "verse_number": "८-७७-४३", "content_sanskrit": "द्रोणः पञ्चदिनान्युग्रो विधम्य रिपुवाहिनीम्।\nकृत्वा व्यूहमभेद्यं च पातयित्वा महारथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2063743, "chapter_id": 2356, "verse_number": "८-७७-४४", "content_sanskrit": "जयद्रथस्य समरे कृत्वा रक्षां महारथः।\nअन्तकप्रतिमश्चोग्रो रात्रियुद्धेऽदहत्प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2063744, "chapter_id": 2356, "verse_number": "८-७७-४५", "content_sanskrit": "दग्ध्वा योधाञ्छरैर्वीरो भारद्वाजः प्रतापवान्।\nधृष्टद्युम्नं समासाद्य स गतः परमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2063745, "chapter_id": 2356, "verse_number": "८-७७-४६", "content_sanskrit": "यदि वाऽद्य भवान्युद्धे सूतपुत्रमुखान्रथान्।\nनावारयिष्यः सङ्ग्रामे न स्म द्रोणो व्यनङ्क्ष्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2063746, "chapter_id": 2356, "verse_number": "८-७७-४७", "content_sanskrit": "भवता तु बलं सर्वं धार्तराष्ट्रस्य वारितम्।\nततो द्रोणो हतो युद्धे पार्षतेन धनञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2063747, "chapter_id": 2356, "verse_number": "८-७७-४८", "content_sanskrit": "कश्च शक्तो रणे कर्तुं त्वदन्यः पुरुषब्रुवः।\nयादृशं ते कृतं पार्थ जयद्रथवधं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2063748, "chapter_id": 2356, "verse_number": "८-७७-४९", "content_sanskrit": "निवार्य सेनां महतीं हत्वा शूरांश्च पार्थिवान्।\nनिहतः सैन्धवो राजा त्वयाऽस्त्रबलतेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2063749, "chapter_id": 2356, "verse_number": "८-७७-५०", "content_sanskrit": "आश्चर्यं सिन्धुराजस्य वधं जानन्ति पार्थिवाः।\nअनाश्चार्यं हि तत्त्वत्तस्त्वं हि पार्थ महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2063750, "chapter_id": 2356, "verse_number": "८-७७-५१", "content_sanskrit": "त्वां हि प्राप्य रणे क्षत्रमेकाहादिति भारत।\nनश्यमानमहं युक्तं मन्येयमिति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2063751, "chapter_id": 2356, "verse_number": "८-७७-५२", "content_sanskrit": "सेयं पार्थ चमूर्घोरा धार्तराष्ट्रस्य संयुगे।\nहतसर्वस्वभूयिष्ठा भीष्मद्रोणौ हतौ यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2063752, "chapter_id": 2356, "verse_number": "८-७७-५३", "content_sanskrit": "शीर्णप्रवरयोधाढ्या हतवाजिरथद्विपा।\nहीना सूर्येन्दुनक्षत्रैर्द्यौरिवाभाति भारती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2063753, "chapter_id": 2356, "verse_number": "८-७७-५४", "content_sanskrit": "विध्वस्ता हि रणे पार्थ सेनेयं भीमविक्रम।\nआसुरीव महासेना देवराजपराक्रमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2063754, "chapter_id": 2356, "verse_number": "८-७७-५५", "content_sanskrit": "तेषां हतावशिष्टास्तु सन्ति पञ्च महारथाः।\nद्रौणिश्च कृतवर्मा च कर्णो मद्राधिपः कृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2063755, "chapter_id": 2356, "verse_number": "८-७७-५६", "content_sanskrit": "तांस्त्वमद्य नरव्याघ्र हत्वा पञ्च महारथान्।\nहतामित्रः प्रयच्छोर्वी राज्ञे सद्वीपपत्तनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2063756, "chapter_id": 2356, "verse_number": "८-७७-५७", "content_sanskrit": "साकाशजलपातालां सपर्वतमहावनाम्।\nप्रयच्छामितवीर्याय पार्थायाद्य वसुन्धराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2063757, "chapter_id": 2356, "verse_number": "८-७७-५८", "content_sanskrit": "एतां पुरा विष्णुरिव हत्वा दैतेयदानवान्।\nप्रयच्छ मेदिनीं राज्ञे शक्रायैव हरिर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2063758, "chapter_id": 2356, "verse_number": "८-७७-५९", "content_sanskrit": "अद्य मोदन्तु पाञ्चाला निहतेष्वरिषु त्वया।\nविष्णुना निहतेष्वेव दानवेयेषु देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2063759, "chapter_id": 2356, "verse_number": "८-७७-६०", "content_sanskrit": "यदि वा द्विपदां श्रेष्ठं द्रोणं मानयतो गुरुम्।\nअश्वत्थाम्नि कृपा तेऽस्ति कृपे वाचार्यगौरवात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2063760, "chapter_id": 2356, "verse_number": "८-७७-६१", "content_sanskrit": "अत्यन्तापचितान्बन्धून्मानयन्मातृबान्धवान्।\nकृतवर्माणमासाद्य न नेष्यासि यमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2063761, "chapter_id": 2356, "verse_number": "८-७७-६२", "content_sanskrit": "भ्रातरं मातुरासाद्य शल्यं मद्रजनाधिपम्।\nयदि त्वमरविन्दाक्ष दयावान्न जिघाससि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2063762, "chapter_id": 2356, "verse_number": "८-७७-६३", "content_sanskrit": "एतत्ते सुकृतं कर्म नात्र किञ्चन विद्यते।\nवयमप्यनुजानीमो नात्र दोषोऽस्ति कश्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2063763, "chapter_id": 2356, "verse_number": "८-७७-६४", "content_sanskrit": "इमं पापमतिं क्षुद्रमत्यन्तं पाण्डवान्प्रति।\nकर्णमद्य नरश्रेष्ठ जहि पार्थ शितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2063764, "chapter_id": 2356, "verse_number": "८-७७-६५", "content_sanskrit": "दहने यत्सपुत्राया निशि मातुस्तवानघ।\nद्यूतार्थे यच्च युष्मासु प्रावर्तत सुयोधनः।\nतस्य सर्वस्य दुष्टात्मा कर्णो वै मूलमित्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2063765, "chapter_id": 2356, "verse_number": "८-७७-६६", "content_sanskrit": "प्रोत्साहयति दुष्टात्मा धार्तराष्ट्रं सुदुर्मतिम्।\nसमितौ गदते कर्णस्तमद्य जहि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2063766, "chapter_id": 2356, "verse_number": "८-७७-६७", "content_sanskrit": "यश्च युष्मासु पापं वै धार्तराष्ट्रः प्रयुक्तवान्।\nतस्य सर्वस्य दुर्बुद्धिः कर्णो मूलमिहार्जुन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2063767, "chapter_id": 2356, "verse_number": "८-७७-६८", "content_sanskrit": "कर्णं हि मन्यते त्राणं नित्यमेव सुयोधनः।\nततो मामपि संरब्धो निग्रहीतुं पराक्रमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2063768, "chapter_id": 2356, "verse_number": "८-७७-६९", "content_sanskrit": "स्थिता बुद्धिर्नरेन्द्राणां धार्तराष्ट्रस्य चोभयोः।\nकर्णः पार्थान्रणे सर्वान्नाशयिष्यति सायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2063769, "chapter_id": 2356, "verse_number": "८-७७-७०", "content_sanskrit": "कर्णमाश्रित्य कौन्तेय धार्तराष्ट्रस्य विग्रहः।\nरुचितो भवता सार्धं जानतोऽपि बलं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2063770, "chapter_id": 2356, "verse_number": "८-७७-७१", "content_sanskrit": "कर्णो जल्पति वै नित्यमहं पार्थान्समागतान्।\nवासुदेवं च दाशार्हं विजेष्यामि महारणे।\nसमितौ वल्गते कर्णस्तमद्य जहि फल्गुन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2063771, "chapter_id": 2356, "verse_number": "८-७७-७२", "content_sanskrit": "यच्च युष्मासु पापं वै धार्तराष्ट्रः प्रतापवान्।\nसभायां कृतवान्नित्यं कर्णमाश्रित्य वै पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2063772, "chapter_id": 2356, "verse_number": "८-७७-७३", "content_sanskrit": "यच्च तं धार्तराष्ट्राणां षड्भिः शूरैर्महारथैः।\nपश्यतां संवृतं शूरं सौभद्रमपराजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2063773, "chapter_id": 2356, "verse_number": "८-७७-७४", "content_sanskrit": "द्रोणद्रौणिकृपान्वीरान्कम्पयानं महेषुभिः।\nविधमन्तमनीकानि प्रमथन्तं महारथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2063774, "chapter_id": 2356, "verse_number": "८-७७-७५", "content_sanskrit": "मनुष्यवाजिमातङ्गान्प्रेषयन्तं यमक्षयम्।\nशरैः सौभद्रमायान्तं दहन्तमरिवाहिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2063775, "chapter_id": 2356, "verse_number": "८-७७-७६", "content_sanskrit": "निर्मनुष्याश्च मातङ्गा विरथाश्च महारथाः।\nप्रद्रवन्ति स्म समरे दिशो भीताऽभिमन्यवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2063776, "chapter_id": 2356, "verse_number": "८-७७-७७", "content_sanskrit": "विगतासूंश्च तुरगान्पत्तीन्व्यायुधजीवितान्।\nकुर्वन्तमृषभस्कन्धं कुरुवृष्णियशस्करम्।\nतन्मे दहति गात्राणि सखे सत्येन ते शपे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2063777, "chapter_id": 2356, "verse_number": "८-७७-७८", "content_sanskrit": "यत्तदासीत्सुदुष्टात्मा कर्णो विनिहतः प्रभुः।\nन शक्तो ह्यभिमन्योस्तु कर्णः स्थातुं रणाग्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2063778, "chapter_id": 2356, "verse_number": "८-७७-७९", "content_sanskrit": "सौभद्रशरनिर्भिन्नो विसंज्ञः शोणितोक्षितः।\nनिश्वसन्क्रोधसन्दीप्तो विमुखः सायकार्दितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2063779, "chapter_id": 2356, "verse_number": "८-७७-८०", "content_sanskrit": "तस्थौ स विह्वलः सङ्ख्ये प्रहारजनितच्छविः।\nअपयानकृतोत्साहो निरुत्साहश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2063780, "chapter_id": 2356, "verse_number": "८-७७-८१", "content_sanskrit": "दुर्योधनं रणे दृष्ट्वा लज्जमानो मुहुर्मुहुः।\nनापयासीत्तततः पार्थ सोऽभिमन्योर्महारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2063781, "chapter_id": 2356, "verse_number": "८-७७-८२", "content_sanskrit": "दृष्ट्वा द्रोणं वधोपायमभिमन्योश्च पृष्टवान्।\nश्रुत्वा द्रोणवचः क्रूरं ततश्चिच्छेद कार्मुकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2063782, "chapter_id": 2356, "verse_number": "८-७७-८३", "content_sanskrit": "ततश्छिन्नायुधं तेन दृष्ट्वा पञ्च महारथाः।\nस चैव निकृतिप्राज्ञः प्राहिणोच्छरवृष्टिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2063783, "chapter_id": 2356, "verse_number": "८-७७-८४", "content_sanskrit": "प्रहसन्स तु दुष्टात्मा कर्णो राजा च कौरवः।\nयच्च कर्णोऽब्रवीत्कृष्णां सभायां परुषं वचः।\nप्रमुखे पाण्डवेयानां कुरूणां चैव पश्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2063784, "chapter_id": 2356, "verse_number": "८-७७-८५", "content_sanskrit": "विनष्टाः पाण्डवाः कृष्णे शाश्वतं नरकं गताः।\nपतिमन्यं पृथुश्रोणि वृणीष्व मृदुभाषिणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2063785, "chapter_id": 2356, "verse_number": "८-७७-८६", "content_sanskrit": "एषा त्वं धृतराष्ट्रस्य दासीभूता निवेशनम्।\nप्रविशारालपक्ष्माक्षि न सन्ति पतयस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2063786, "chapter_id": 2356, "verse_number": "८-७७-८७", "content_sanskrit": "न पाण्डवाः प्रभवन्ति तव कृष्णे कथञ्चन।\nदासभार्या च पाञ्चालि स्वयं दासी च शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2063787, "chapter_id": 2356, "verse_number": "८-७७-८८", "content_sanskrit": "अद्य दुर्योधनो राजा पृथिव्यां नृपतिः स्मृतः।\nसर्वे चास्य महिपाला योगक्षेममुपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2063788, "chapter_id": 2356, "verse_number": "८-७७-८९", "content_sanskrit": "पश्येदानीं यदा भद्रे निविष्टाः पाण्डवाः समम्।\nअन्योन्यं समुदीक्षन्ते धार्तराष्ट्रस्य तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2063789, "chapter_id": 2356, "verse_number": "८-७७-९०", "content_sanskrit": "व्यक्तं षण्डतिला ह्येते नरके च निमज्जिताः।\nप्रेष्यवच्चापि राजानमुपस्थास्यन्ति कौरवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2063790, "chapter_id": 2356, "verse_number": "८-७७-९१", "content_sanskrit": "उक्तवान्स च पातात्मा तथा परमदुर्मतिः।\nपापः पापवचः कर्णः पश्यतस्ते धनञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2063791, "chapter_id": 2356, "verse_number": "८-७७-९२", "content_sanskrit": "अस्य पापस्य तद्वाक्यं सुवर्णविकृताः शराः।\nशमयन्ति शिलाधौता नाशयन्तोऽस्य जीवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2063792, "chapter_id": 2356, "verse_number": "८-७७-९३", "content_sanskrit": "अद्य कर्णं रणे ग्रस्तं पश्यन्तु कुरवस्त्वया।\nस्वर्गावतरणे यत्नं स्वर्गद्वारगतं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2063793, "chapter_id": 2356, "verse_number": "८-७७-९४", "content_sanskrit": "अद्य ते समरे वीर्यं पश्यन्तु कुरुयोधिनः।\nसूतपुत्रे हते पार्थ जानन्तु त्वां महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2063794, "chapter_id": 2356, "verse_number": "८-७७-९५", "content_sanskrit": "अद्य काकवला गृध्रा वायसा जम्बुकास्तथा।\nविप्रकर्षन्तु गात्राणि सूतपुत्रस्य मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2063795, "chapter_id": 2356, "verse_number": "८-७७-९६", "content_sanskrit": "अद्याधिरथिराक्षिप्तो निहतश्च त्वया रणे।\nकुरूणां शोकमाधत्तां पाण्वानां मुदं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2063796, "chapter_id": 2356, "verse_number": "८-७७-९७", "content_sanskrit": "अद्य त्वां प्रतिमर्दन्तु पाञ्चालाः पाण्डवैः सह।\nयथा वृत्रवधे वृत्ते देवाः सर्वे शतक्रतुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2063797, "chapter_id": 2356, "verse_number": "८-७७-९८", "content_sanskrit": "अद्य कर्णं रणे हत्वा प्राप्य चैवोत्तमं यशः।\nविशोको विज्वरः पार्थ भव बन्धुपुरस्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2063798, "chapter_id": 2356, "verse_number": "८-७७-९९", "content_sanskrit": "नरसिंहवपुः कृत्वा यथा शस्तो महासुरः।\nहिरण्यकशिपुर्दैत्यो विष्णुना प्रभविष्णुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2063799, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "तथा त्वमपि राधेयं घोरां कृत्वा महातनुम्।\nजहि युद्धे महाबाहो त्रायस्व च भयात्स्वकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2063800, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "कर्णं हाहाकृतं दीनं विषण्णं त्वच्छरार्दितम्।\nप्रपतन्तं महीं कर्णं पश्यन्तु वसुधाधिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2063801, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "तं च स्वशोणिते मग्नं शयानं पतितं भुवि।\nअपविद्धायुकधं कर्णमद्य पश्यन्तु बान्धवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2063802, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "तच्चैवाद्य महत्कर्म गाण्डीवप्रेषितैः शरैः।\nरथोपस्थे विशीर्येत ताराराज इवाम्बरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2063803, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "आशु चाद्य शरास्तस्य सम्पतन्तो महाजवैः।\nत्वच्छरैः सन्निकृत्ताग्रा विशीर्यन्ते महीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2063804, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "त्वया चाद्य हते तस्य विक्रमे भरतर्षभ।\nविमुखाः सर्वराजानो भवन्तु गतजीविताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2063805, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "तथा चाधिरथौ याते प्रयान्तु कुरवो दिशः।\nमन्वानास्तं रथश्रेष्ठं सर्वलोकेषु धन्विनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2063806, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "स वै चाद्य भयात्त्यक्त्वा धार्तराष्ट्रो महाचमूम्।\nदुर्योधनो भयोद्विग्नो द्रवतु स्वं निवेशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2063807, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "तथा चाद्य हतं श्रुत्वा धृतराष्ट्रो जनेश्वरः।\nक्षणेन निपतेद्भूमौ विसंज्ञो वै महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2063808, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "अद्य जानन्तु ते पार्थ विक्रमं सर्वयोधिनः।\nयदुवाच सभामध्ये परुषं भारत त्वयि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2063809, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "यानि चान्यानि दुष्टात्मा पापानि कृतवांस्त्वयि।\nतान्यद्य भरतश्रेष्ठ नाशयन्तु शरास्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2063810, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "शान्तिं कुरु परिक्लेशा कृष्णायाः शत्रुपातन।\nहत्वा शत्रुं रणे श्लाघ्यं गर्जन्तमतिपौरुषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2063811, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "अद्य चाधिरथिर्वेद्धस्तव बाणैः समन्ततः।\nमन्यतां त्वां नरव्याघ्र प्रवरं सर्वधन्विनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2063812, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "गाण्डीवप्रसृतान्वाणानद्य गात्रस्पृशः शरान्।\nयातु कर्णो रणे पार्थ श्वाविच्छललतो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2063813, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "तं कथं कर्णमासाद्य विद्रवेयुर्महारथाः।\nयस्त्वेकः सर्वपाञ्चालानहन्यहनि नाशयन्।\nकालवच्चरते वीर पाञ्चालानां रथव्रजे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2063814, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "तमप्यासाद्य समरे मित्रार्थे मित्रवत्सल।\nतथा ज्वलन्तमस्त्रैश्च शूरं सर्वधनुष्मताम्।\nनिर्दहन्तं समारूढं दुर्धर्षं द्रोणमञ्जसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2063815, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "ते नित्यमुदिता जेतुं युधि शत्रुमरिन्दमाः।\nन चेदाधिरथेर्भीताः पाञ्चालाः स्युः पराङ्मुखाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2063816, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "तेषामापततां शूरः पाञ्चालानां तरस्विनाम्।\nआदत्तासूञ्शरैः कर्णः पतङ्गानामिवानलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2063817, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "एते द्रवन्ति पाञ्चाला द्राव्यन्ते योधिभिर्ध्रुवम्।\nकर्णेन भरतश्रेष्ठ पश्यपश्य तथाकृतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2063818, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "तान्समारोहतः शूरान्मित्रार्थे त्यक्तजीवितान्।\nनिस्तारय महाबाहो कर्णास्त्रात्पावकोपमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2063819, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "अस्त्रं हिरामात्कर्णेन भार्गवादृषिसत्तमात्।\nयदवाप्तं तदा घोरं तस्य रूपमुदीर्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2063820, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "तापनं सर्वसैन्यस्य घोररूपं भयानकम्।\nयमाश्रित्य महासेना ज्वलते स्वेन तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2063821, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "एते चरन्ति सङ्ग्रामे कर्णचापच्युताः शराः।\nप्रभया इह शत्रूणां घातयन्तो जनान्प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2063822, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "एते भ्रमन्ति पाञ्चाला उत्क्रयन्ति च मारिष।\nकर्णास्त्रं समरे प्राप्य दुर्निवार्यं महात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2063823, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "एष भीमो दृढक्रोधो वृतः पार्थ समन्ततः।\nसृञ्जयैर्योऽजयत्कर्णं पीड्यते निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2063824, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "पाञ्चालान्सृञ्जयांश्चैव पाण्डवांश्चैव भारत।\nउपेक्षितो दहेत्कर्णो रोगो देहमिवान्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2063825, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "नान्यं त्वत्तो हि पश्यामि योधं यौधिष्ठिरे बले।\nयः समासाद्य राधेयं स्वस्तिमानाव्रजेद्गृहान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2063826, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "तमद्य निशितैर्बाणैर्निहत्य भरतर्षभ।\nयथा प्रतिज्ञां त्व पार्थ तीर्त्वा कीर्तिमवाप्स्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2063827, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "त्वं हि शक्तो रणे कर्णं विजेतुं सह पार्थिवैः।\nनान्यो युधि युधां श्रेष्ठ सत्यमेतद्ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2063828, "chapter_id": 2356, "verse_number": "८-७७-१०", "content_sanskrit": "एतत्कृत्वा महत्कार्म हत्वा कर्णं महारथम्।\nकृतार्थः सफलः पार्थ सुखी भव नरोत्तम॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2063829, "chapter_id": 2356, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे सप्तसप्ततितमोऽध्यायः॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}]