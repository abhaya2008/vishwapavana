[{"id": 2172361, "chapter_id": 4674, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2172362, "chapter_id": 4674, "verse_number": "१", "content_sanskrit": "एवं निपातिते कर्णे समरे सव्यसाचिना ।\nअल्पावशिष्टाः कुरवः किमकुर्वत वै द्विज\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2172363, "chapter_id": 4674, "verse_number": "२", "content_sanskrit": "उदीर्यमाणं च बलं दृष्ट्वा राजा सुयोधनः ।\nपाण्डवैः प्राप्तकालं किं प्रापद्यत कौरवः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2172364, "chapter_id": 4674, "verse_number": "३", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं तदाचक्ष्व द्विजोत्तम ।\nन हि तृप्यामि पूर्वेषां शृण्वानश्चरितं महत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2172365, "chapter_id": 4674, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2172366, "chapter_id": 4674, "verse_number": "४", "content_sanskrit": "ततः कर्णे हते राजन् धार्तराष्ट्रः सुयोधनः ।\nभृशं शोकार्णवे मग्नो निराशः सर्वतोऽभवत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2172367, "chapter_id": 4674, "verse_number": "५", "content_sanskrit": "हा कर्ण हा कर्ण इति शोचमानो मुहुर्मुहुः ।\nकृच्छ्रात् स्वशिबिरं प्रायाद्धतशिष्टैर्नृपैः सह\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2172368, "chapter_id": 4674, "verse_number": "६", "content_sanskrit": "स समाश्वास्यमानोऽपि हेतुभिः शास्त्रनिश्चितैः ।\nदुःखार्तो नालभच्छर्म सूतपुत्रवधं स्मरन्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2172369, "chapter_id": 4674, "verse_number": "७", "content_sanskrit": "स दैवं बलवन्मत्वा प्रभाते विमले सति ।\nसङ्ग्रामे निश्चयं कृत्वा पुनर्युद्धाय निर्ययौ\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2172370, "chapter_id": 4674, "verse_number": "८", "content_sanskrit": "शल्यं सेनापतिं कृत्वा विधिवद् राजपुङ्गवम् ।\nरणाय निर्ययौ राजा हतरोषैर्नृपैः सह\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2172371, "chapter_id": 4674, "verse_number": "९", "content_sanskrit": "ततः सुतुमुलं युद्धं कुरुपाण्डवसेनयोः ।\nबभूव भरतश्रेष्ठ यथा दैवासुरे पुरा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2172372, "chapter_id": 4674, "verse_number": "१०", "content_sanskrit": "ततः शल्यो महाराज सैन्येन महता सह ।\nससैन्योऽथ मध्याह्ने धर्मराजेन पातितः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2172373, "chapter_id": 4674, "verse_number": "११", "content_sanskrit": "ततो दुर्योधनो राजा हतबन्धू रणाजिरात् ।\nअपसृत्य ह्रदं घोरं विवेश रिपुजाद्भयात्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2172374, "chapter_id": 4674, "verse_number": "१२", "content_sanskrit": "अथापराह्णे तस्याह्नः परिवार्य महारथैः ।\nह्रदादाहूय युद्धाय भीमसेनेन पातितः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2172375, "chapter_id": 4674, "verse_number": "१३", "content_sanskrit": "तस्मिंस्तु निहते वीरे हतशिष्टास्त्रयो रथाः ।\nकृतवर्मा कृपो द्रौणिः जघ्नुः पाण्डवसैनिकान्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2172376, "chapter_id": 4674, "verse_number": "१४", "content_sanskrit": "ततोऽपराह्णसमये शिबिरादेत्य सञ्जयः ।\nप्रविवेश पुरीं दीनो दुःखशोकसमन्वितः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2172377, "chapter_id": 4674, "verse_number": "१५", "content_sanskrit": "प्रविश्य तु पुरं तूर्णं भुजावुद्यम्य दुःखितः ।\nवेपमानस्तदा राज्ञः प्रविवेश निवेशनम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2172378, "chapter_id": 4674, "verse_number": "", "content_sanskrit": "(धावतश्चाप्यपश्यत् स तत्रत्यान् पुरुषर्षभान् ।\nनष्टचित्तानिवोन्मत्तान् शोकेन भृशदुःखितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2172379, "chapter_id": 4674, "verse_number": "", "content_sanskrit": "दृष्ट्वैव च नरान् शीघ्रं व्याजहारातिदुःखितान् ।)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2172380, "chapter_id": 4674, "verse_number": "१६", "content_sanskrit": "रुरोद च नरव्याघ्र हा राजन्निति दुःखितः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2172381, "chapter_id": 4674, "verse_number": "१७", "content_sanskrit": "अहो बत विपन्नोऽस्मि निधनेन महात्मनः ।\nअसौ सुबलवान् कालो गतिश्च विषमा तथा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2172382, "chapter_id": 4674, "verse_number": "१८", "content_sanskrit": "शक्रतुल्यबलाः सर्वे यत्राहन्यन्त पार्थिवाः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2172383, "chapter_id": 4674, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2172384, "chapter_id": 4674, "verse_number": "१९", "content_sanskrit": "दृष्ट्वैव हि पुरे राजन् जनः सर्वो हि सञ्जयम् ।\nशोकेन महता युक्तः सर्वतो राजसत्तम\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2172385, "chapter_id": 4674, "verse_number": "२०", "content_sanskrit": "प्ररुरोद भयोद्विग्नो हा राजन्निति सस्वनम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2172386, "chapter_id": 4674, "verse_number": "२१", "content_sanskrit": "आकुमारं नरव्याघ्र तत् पुरं वै समन्ततः ।\nआर्तनादं महच्चक्रे श्रुत्वा विनिहतं नृपम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2172387, "chapter_id": 4674, "verse_number": "२२", "content_sanskrit": "पपात च ततो भूमौ स चैव पुरुषर्षभः ।\nश्रुत्वा स तानिवोन्मत्तान् शोकेन भृशपीडितान्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2172388, "chapter_id": 4674, "verse_number": "२३", "content_sanskrit": "तथा स विह्वलः सूतः प्रविश्य नृपतिक्षयम् ।\nददर्श नृपतिश्रेष्ठं प्रज्ञाचक्षुषमीश्वरम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2172389, "chapter_id": 4674, "verse_number": "२४", "content_sanskrit": "दृष्ट्वा चासीनमनघं समन्तात् परिवारितम् ।\nस्नुषाभिर्भरतश्रेष्ठ गान्धार्या विदुरेण च\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2172390, "chapter_id": 4674, "verse_number": "२५", "content_sanskrit": "तथाऽन्यैश्च सुहृद्भिश्च ज्ञातिभिश्च हितैषिभिः ।\nतमेव चार्थं ध्यायन्तं कर्णस्य निधनं प्रति\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2172391, "chapter_id": 4674, "verse_number": "२६", "content_sanskrit": "रुदन्नेवाब्रवीद् वाक्यं राजानं जनमेजय ।\nनातिहृष्टमनाः सूतो बाष्पसन्दिग्धया गिरा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2172392, "chapter_id": 4674, "verse_number": "२७", "content_sanskrit": "सञ्जयोऽहं नरव्याघ्र नमस्ते भरतर्षभ\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2172393, "chapter_id": 4674, "verse_number": "२८", "content_sanskrit": "मद्राधिपो हतः शल्यः सौबलः शकुनिस्तथा ।\nऊलूकः पुरुषव्याघ्र कैतव्यो दृढविक्रमः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2172394, "chapter_id": 4674, "verse_number": "२९", "content_sanskrit": "संशप्तका हताः सर्वे काम्भोजाश्च शकैः सह ।\nमत्स्यांश्चैव महाराज शूरसेनाश्च पातिताः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2172395, "chapter_id": 4674, "verse_number": "३०", "content_sanskrit": "प्राच्या हता महाराज दाक्षिणात्याश्च सर्वशः ।\nउदीच्याश्च हताः सर्वे प्रतीच्याश्च परन्तप\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2172396, "chapter_id": 4674, "verse_number": "३१", "content_sanskrit": "राजानो राजपुत्राश्च सर्वे विनिहता नृप ।\nकर्णपुत्रो हतः शूरः सत्य(वृष)सेनो महाबलः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2172397, "chapter_id": 4674, "verse_number": "३२", "content_sanskrit": "दुर्योधनो हतो राजन् यथोक्तं पाण्डवेन हि ।\nभग्नसक्थिर्महाराज शेते पांसुषु रूषितः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2172398, "chapter_id": 4674, "verse_number": "३३", "content_sanskrit": "धृष्टद्युम्नो हतो राजन् शिखण्डी चापराजितः ।\nउत्तमौजा युधामन्युः तथा सर्वे प्रभद्रकाः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2172399, "chapter_id": 4674, "verse_number": "३४", "content_sanskrit": "पाञ्चालाश्च महाराज चेदयश्च निषूदिताः ।\nतव पुत्राः हताः सर्वे द्रौपदेयाश्च भारत\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2172400, "chapter_id": 4674, "verse_number": "३५", "content_sanskrit": "कर्णपुत्रो हतः शूरो वृषसेनो महाबलः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2172401, "chapter_id": 4674, "verse_number": "३६", "content_sanskrit": "नरा विनिहताः सर्वे गजाश्च विनिषूदिताः ।\nरथिनश्च नरव्याघ्र तथाऽश्वा निहता युधि\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2172402, "chapter_id": 4674, "verse_number": "३७", "content_sanskrit": "निःशेषं शिबिरं राजन् तावकानां कृतं प्रभो ।\nपाण्डवानां च शूराणां समासाद्य परस्परम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2172403, "chapter_id": 4674, "verse_number": "३८", "content_sanskrit": "स्त्रीशेषमभवत् प्रायः जगत् कालेन मोहितम् ।\nसप्त वै पाण्डवाः शिष्टा धार्तराष्ट्रास्त्रयो जनाः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2172404, "chapter_id": 4674, "verse_number": "३९", "content_sanskrit": "ते चैव भ्रातरः पञ्च वासुदेवोऽथ सात्यकिः ।\nकृपश्च कृतवर्मा च द्रौणिश्च जयतां वरः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2172405, "chapter_id": 4674, "verse_number": "४०", "content_sanskrit": "एते शेषा महाराज रथिनो राजसत्तम ।\nअक्षोहिणीनामष्टानां दशानां च नरेश्वर\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2172406, "chapter_id": 4674, "verse_number": "४१", "content_sanskrit": "एते शेषा महाराज सर्वेऽन्ये निधनं गताः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2172407, "chapter_id": 4674, "verse_number": "४२", "content_sanskrit": "कालेन निहतं सर्वं जगद्वै भरतर्षभ ।\nदुर्योधनं वै पुरतः कृत्वा सर्वे हता नराः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2172408, "chapter_id": 4674, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2172409, "chapter_id": 4674, "verse_number": "४३", "content_sanskrit": "एतच्छ्रुत्वा वचः क्रूरं धृतराष्ट्रो जनेश्वरः ।\nनिपपात महाराज गतसत्त्वो महीतळे\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2172410, "chapter_id": 4674, "verse_number": "४४", "content_sanskrit": "तस्मिन् निपतिते वीरे विदुरोऽपि महायशाः ।\nनिपपात महाराज पुत्रव्यसनकर्शितः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2172411, "chapter_id": 4674, "verse_number": "४५", "content_sanskrit": "गान्धारी च महाभागा सर्वाश्च कुरुयोषितः ।\nपतिताः सहसा भूमौ श्रुत्वा घोरतरं वचः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2172412, "chapter_id": 4674, "verse_number": "४६", "content_sanskrit": "निःसञ्ज्ञं पतितं भूमौ तदासीद् राजमण्डलम् ।\nविलापमूर्च्छोपहतं चित्रं न्यस्तं पटे यथा\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2172413, "chapter_id": 4674, "verse_number": "४७", "content_sanskrit": "कृच्छ्रेण तु ततस्तत्र धृतराष्ट्रो महीपतिः ।\nशनैरलभत प्राणान् पुत्रव्यसनकर्शितः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2172414, "chapter_id": 4674, "verse_number": "४८", "content_sanskrit": "लब्ध्वा तु नृपतिः प्राणान् वेपमानः पुनः पुनः ।\nनिरीक्ष्य च दिशः सर्वाः क्षत्तारं वाक्यमब्रवीत्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2172415, "chapter_id": 4674, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2172416, "chapter_id": 4674, "verse_number": "४९", "content_sanskrit": "विद्वन् क्षत्तर्महाप्राज्ञ त्वं गतिर्भरतर्षभ ।\nममानाथस्य सुभृशं पुत्रहीनस्य सर्वशः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2172417, "chapter_id": 4674, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2172418, "chapter_id": 4674, "verse_number": "५०", "content_sanskrit": "एवमुक्त्वा ततो भूयः निःसञ्ज्ञः पतितो भुवि\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2172419, "chapter_id": 4674, "verse_number": "५१", "content_sanskrit": "तं तथा पतितं दृष्ट्वा बान्धवास्तत्र केचन ।\nते शीतैः सिचिषुस्तोयैः विविजुर्व्यजनैरपि\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2172420, "chapter_id": 4674, "verse_number": "५२", "content_sanskrit": "तूष्णीमासीन्महीपालः पुत्रव्यसनकर्शितः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2172421, "chapter_id": 4674, "verse_number": "५३", "content_sanskrit": "स तु दीर्घेण कालेन प्रत्याश्वस्तो महीपतिः ।\nनिःश्वसन् पन्नग इव कुम्भक्षिप्तोऽभवन्नृप\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2172422, "chapter_id": 4674, "verse_number": "५४", "content_sanskrit": "सञ्जयोऽरुदत् तत्र दृष्ट्वा राजानमातुरम् ।\nतथा सर्वाः स्त्रियश्चैव गान्धारीं च यशस्विनी\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2172423, "chapter_id": 4674, "verse_number": "५५", "content_sanskrit": "ततो दीर्घेण कालेन विदुरं वाक्यमब्रवीत् ।\nधृतराष्ट्रो नरव्याघ्रो मुह्यमानः पुनः पुनः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2172424, "chapter_id": 4674, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2172425, "chapter_id": 4674, "verse_number": "५६", "content_sanskrit": "गच्छन्तु योषितः सर्वाः गान्धारी च यशस्विनी ।\nतथेमे सुहृदः सर्वे मुह्यते मे मनो भृशम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2172426, "chapter_id": 4674, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2172427, "chapter_id": 4674, "verse_number": "५७", "content_sanskrit": "एवमुक्तस्ततः क्षत्ता ताः स्त्रियो भरतर्षभ ।\nविसर्जयामास तदा मुह्यमानो नराधिप\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2172428, "chapter_id": 4674, "verse_number": "५८", "content_sanskrit": "निर्जग्मुश्च ततः सर्वाः ताः स्त्रियो जनमेजय ।\nसुहृदश्च तथा सर्वे दृष्ट्वा राजानमातुरम्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2172429, "chapter_id": 4674, "verse_number": "५९", "content_sanskrit": "ततो नरपतिस्तत्र सञ्ज्ञां लब्ध्वा परन्तप ।\nगतिर्मे को भवेदद्य इति चिन्तासमाकुलः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2172430, "chapter_id": 4674, "verse_number": "६०", "content_sanskrit": "अवैक्षत् सञ्जयं तत्र रुदमानो महीपतिः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2172431, "chapter_id": 4674, "verse_number": "६१", "content_sanskrit": "प्राञ्जलिं सञ्जयं दृष्ट्वा रुदमानं मुहुर्मुहुः ।\nबहुशश्चिन्तयित्वा तु सञ्जयं वाक्यमब्रवीत्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2172432, "chapter_id": 4674, "verse_number": "६२", "content_sanskrit": "राजानं शोचमानस्तु तं शोचन्तं मुहुर्मुहुः ।\nसमाश्वासयत क्षत्ता वचसा मधुरेण च\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2172433, "chapter_id": 4674, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां शल्यपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2172434, "chapter_id": 4674, "verse_number": "", "content_sanskrit": "शल्यवधपर्वणि प्रथमोऽध्यायः ॥१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]