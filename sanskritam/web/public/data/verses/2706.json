[{"id": 2080235, "chapter_id": 2706, "verse_number": "१२-२११-०x", "content_sanskrit": "* युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2080236, "chapter_id": 2706, "verse_number": "१२-२११-१", "content_sanskrit": "देवानुरमनुष्येषु ऋषिमुख्येषु वा पुनः।\nविष्णोस्तत्वं यथाख्यातं को विद्वाननुवेत्ति तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2080237, "chapter_id": 2706, "verse_number": "१२-२११-२", "content_sanskrit": "एतन्मे सर्वमाचक्ष्व न मे तृप्तिर्हि तत्वतः।\nवर्तते भरतश्रेष्ठ सर्वज्ञोऽसीति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2080238, "chapter_id": 2706, "verse_number": "१२-२११-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2080239, "chapter_id": 2706, "verse_number": "१२-२११-३", "content_sanskrit": "कारितोऽहं त्वया राजन्यदॄत्तं च पुरा मम।\nगरुडेन पुरा मह्यं संवादोऽभूभृतोत्तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2080240, "chapter_id": 2706, "verse_number": "१२-२११-४", "content_sanskrit": "पुराहं तप आस्थाय वासुदेवपरायणः।\nध्यायन्स्तुवन्नमस्यंश्च यजमानस्तमेवच।\nगङ्गद्वीपे समासीनो दशवर्षाणि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2080241, "chapter_id": 2706, "verse_number": "१२-२११-५", "content_sanskrit": "माता च मम ता देवी जननी लोकपावनी।\nसमासीना समीपे मे रक्षणार्थं ममाच्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2080242, "chapter_id": 2706, "verse_number": "१२-२११-६", "content_sanskrit": "तस्मिन्कालेऽद्भुतः श्रीमान्सर्ववेदमयः प्रभुः।\nसुपर्णः पततांश्रेष्ठो मेरुमन्दरसन्निभः।\nआजगाम विशुद्धात्मा गङ्गां द्रष्टुं महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2080243, "chapter_id": 2706, "verse_number": "१२-२११-७", "content_sanskrit": "तमागतं महात्मानं प्रत्युद्गम्याहमर्थितः।\nप्रणिपत्य यथान्यायं कृताज्जलिरवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2080244, "chapter_id": 2706, "verse_number": "१२-२११-८", "content_sanskrit": "सोऽपि देवो महाभागामभिनन्द्य च जाह्नवीम्।\nतथा च पूजितः श्रीमानुणेपाविशदासने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2080245, "chapter_id": 2706, "verse_number": "१२-२११-९", "content_sanskrit": "ततः कथान्तरे तं वै वचनं चेदमव्रवम्।\nवेदवेद महावीर्य वैनतेग महाबल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2080246, "chapter_id": 2706, "verse_number": "१२-२११-१०", "content_sanskrit": "नारायणं हृषीकेशं सहमानोऽनिशं हरिम्।\nजानासि तं यथा वक्तुं यादृग्भूतो जनार्दनः।\nममापि तस्य सद्भातं वक्तुमर्हसि सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2080247, "chapter_id": 2706, "verse_number": "१२-२११-११x", "content_sanskrit": "गरुड उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2080248, "chapter_id": 2706, "verse_number": "१२-२११-११", "content_sanskrit": "शृणु भीष्म यथान्यायं पुरा त्वमिह सत्तमाः।\nअनेके पुनयः सिद्धा मानसोत्तरवासिनः॥\nपगच्छुर्मा महाप्राज्ञा वासुदेवपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2080249, "chapter_id": 2706, "verse_number": "१२-२११-१२", "content_sanskrit": "पक्षीन्द्र वासुदेवस्य तत्वं वेत्सि परं पदम्।\nस्वसा सयो न तस्यास्ति सन्निकृष्टप्रियोपि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2080250, "chapter_id": 2706, "verse_number": "१२-२११-१३", "content_sanskrit": "तेषामहं वचः श्रुत्वा प्रणिपत्य महाहरिम्।\nअब्रवं च यथावृत्तं मम नारायणस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2080251, "chapter_id": 2706, "verse_number": "१२-२११-१४", "content_sanskrit": "शृणुध्वं मुनिशार्दूला हृत्वा सोममहं पुरा।\nआकाशे पतमानस्तु वाक्यं तत्र शृणोमि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2080252, "chapter_id": 2706, "verse_number": "१२-२११-१५", "content_sanskrit": "साधुसाधु महाबाहो प्रीतोस्मि तव दर्शनात्।\nवृणीष्व वचनं मत्तः पक्षीन्द्र गरुडाधुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2080253, "chapter_id": 2706, "verse_number": "१२-२११-१६", "content_sanskrit": "त्वामहं भक्तितत्वज्ञो ब्रवै वचनमुत्तमम्।\nइत्याह स्म ध्रुवं तत्र मामाह भगवान्पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2080254, "chapter_id": 2706, "verse_number": "१२-२११-१७", "content_sanskrit": "ऋषिरस्मि महावीर्य न मां जानाति वा मयि।\nअसूयति च मां मूढ तच्छ्रुत्वा गर्वमास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2080255, "chapter_id": 2706, "verse_number": "१२-२११-१८", "content_sanskrit": "अहं देवनिकायानां मध्ये वचनमब्रवम्।\nऋषे पूर्वं वरं मत्तस्त्वं वृणीष्व ततो ह्यहम्।\nवृणे त्वत्तो वरं पश्चादित्येवं मुनिसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2080256, "chapter_id": 2706, "verse_number": "१२-२११-१९", "content_sanskrit": "तस्मात्त्वां भगवान्देवः श्रीमाञ्श्रीवत्सलक्षणः।\nअद्य पश्यति पक्षीन्द्र वाहनं भव मे सदा।\nवृणेऽहं वरमेतद्धि त्वत्तोऽद्य पतगेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2080257, "chapter_id": 2706, "verse_number": "१२-२११-२०", "content_sanskrit": "तथेति तं वीक्ष्य मातामनहंकारमास्थितम्।\nजेतुकामो ह्यहं विष्णुं मायया मायिनं हरिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2080258, "chapter_id": 2706, "verse_number": "१२-२११-२१", "content_sanskrit": "त्वत्तो ह्यहं वृणे त्वद्य वरं ऋषिवरोत्तम।\nतवोपरिष्टात्स्थास्यामि वरमेतत्प्रयच्छ मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2080259, "chapter_id": 2706, "verse_number": "१२-२११-२२", "content_sanskrit": "तथेति च हसन्प्राह हरिर्नारायणः प्रभुः।\nध्वजं च मे भव सदा त्वमेव विहगेश्वर।\nउपरिष्टात्स्थितिस्तेऽस्तु मम पक्षीन्द्र सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2080260, "chapter_id": 2706, "verse_number": "१२-२११-२३", "content_sanskrit": "इत्युक्त्वा भगवान्देवः शङ्खचक्रगदाधरः।\nसहस्रचरणः श्रीमान्सहस्रादित्यसन्निभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2080261, "chapter_id": 2706, "verse_number": "१२-२११-२४", "content_sanskrit": "सहस्रशीर्षा पुरुषः सहस्रनयनो महान्।\nसहस्रमकुटोऽचिन्त्यः सहस्रवदनो विभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2080262, "chapter_id": 2706, "verse_number": "१२-२११-२५", "content_sanskrit": "विद्युन्मालानिभैर्दिव्यैर्नानाभरणराजिभिः।\nक्वचित्संदृश्यमानस्तु चतुर्बाहुः क्वचिद्वरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2080263, "chapter_id": 2706, "verse_number": "१२-२११-२६", "content_sanskrit": "क्वचिज्ज्योतिर्मयोचिन्त्यः क्वचित्स्कन्धे समाहितः।\nएवं मम जयन्देवस्तत्रैवान्तरधीयत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2080264, "chapter_id": 2706, "verse_number": "१२-२११-२७", "content_sanskrit": "ततोऽहं विस्मयापन्नः कृत्वा कार्यमनुत्तमम्।\nअस्याविमुच्य जननीं मया सह मुनीश्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2080265, "chapter_id": 2706, "verse_number": "१२-२११-२८", "content_sanskrit": "अचिन्त्योऽयमहं भूयः कोऽसौ मामब्रवीत्पुरा।\nकीदृग्विधः स भगवानिति मत्वा तमास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2080266, "chapter_id": 2706, "verse_number": "१२-२११-२९", "content_sanskrit": "अनन्तरं देवदेवं स्कन्धे मम समाश्रितम्।\nअद्राक्षं पुण्डरीकाक्षं वहमानोऽहमद्भुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2080267, "chapter_id": 2706, "verse_number": "१२-२११-३०", "content_sanskrit": "अवशस्तस्य भावेन यत्र यत्र स चेच्छति।\nविस्मयापन्नहृदयो ह्यहं किमिति चिन्तयन्।\nअन्तर्जलमहं सर्वं वहमानोऽगमं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2080268, "chapter_id": 2706, "verse_number": "१२-२११-३१", "content_sanskrit": "सेन्द्रैर्देवैर्महाभागैर्ब्रह्माद्यैः कल्पजीविभिः।\nस्तूयमानो ह्यहमपि तैस्तैरभ्यर्चितः पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2080269, "chapter_id": 2706, "verse_number": "१२-२११-३२", "content_sanskrit": "क्षीरोदस्योत्तरे कूले दिव्ये मणिमये शुभे।\nवैकर्णनाम सदनं हरेस्तस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2080270, "chapter_id": 2706, "verse_number": "१२-२११-३३", "content_sanskrit": "दिव्यं तेजोमयं श्रीमदचिन्त्यममरैरपि।\nतेजोनिलमयैः स्तम्भैर्नानासंस्थानसंस्थितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2080271, "chapter_id": 2706, "verse_number": "१२-२११-३४", "content_sanskrit": "विभूषितं हिरण्येन भास्वरेण समन्ततः।\nदिव्यं ज्योतिः समायुक्तं गीतवादित्रशोभितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2080272, "chapter_id": 2706, "verse_number": "१२-२११-३५", "content_sanskrit": "शृणोमि शब्दं तत्राहं न पश्यामि शरीरिणम्।\nन च स्थलं न चान्यच्च पादयोस्तं समन्ततः।\nवेपमानो ह्यहं तत्र विष्ठितोऽहं कृताञ्जलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2080273, "chapter_id": 2706, "verse_number": "१२-२११-३६", "content_sanskrit": "ततो ब्रह्मादयो देवा लोकपालास्तथैव च।\nसनन्दनाद्या मुनयस्तथाऽन्ये परजीविनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2080274, "chapter_id": 2706, "verse_number": "१२-२११-३७", "content_sanskrit": "प्राप्तास्तत्र सभाद्वारि देवगन्धर्वसत्तमाः।\nब्रह्माणं परतः कृत्वा कृताञ्जलिपुटास्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2080275, "chapter_id": 2706, "verse_number": "१२-२११-३८", "content_sanskrit": "ततस्तदन्तरे तस्मिन्क्षीरोदार्णवशीकरैः।\nबोध्यमानो महाविष्णुराविर्भूत इवाबभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2080276, "chapter_id": 2706, "verse_number": "१२-२११-३९", "content_sanskrit": "फणासहस्रमालाढ्यं शेषमव्यक्तसंस्थितम्।\nपश्याम्यहं मुदाऽऽकाशे यस्योपरि जनार्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2080277, "chapter_id": 2706, "verse_number": "१२-२११-४०", "content_sanskrit": "दीर्घवृत्तैः समैः पीनैः केयूरवलयोज्ज्वलैः।\nचर्तुभिर्बाहुभिर्युक्तं------------॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2080278, "chapter_id": 2706, "verse_number": "१२-२११-४१", "content_sanskrit": "पिताम्बरेण संवीतं कौस्तुभेन विराजितम्।\nवक्षस्थलेन संयुक्तं पद्मयाऽधिष्ठितेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2080279, "chapter_id": 2706, "verse_number": "१२-२११-४२", "content_sanskrit": "ईषदुन्मीलिताक्षं तं सर्वकारणकारणम्।\nक्षीरोदस्योपरि बभौ नीलाभ्रं परमं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2080280, "chapter_id": 2706, "verse_number": "१२-२११-४३", "content_sanskrit": "न कश्चिद्वदते कश्चिन्न व्याहरति कश्चन।\nब्रह्मादिस्तम्बपर्यन्तं माशब्दमिति रोषितम्।\nभ्रुकुटीकुटिलाक्षास्ते नानाभूतगणाः स्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2080281, "chapter_id": 2706, "verse_number": "१२-२११-४४", "content_sanskrit": "कृत्वा च प्रस्थितं तत्र जगतां हितकाम्यया।\nगच्छध्वमिति मामुक्त्वा गरुडेत्याह मां ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2080282, "chapter_id": 2706, "verse_number": "१२-२११-४५", "content_sanskrit": "ततोऽहं प्रणिपत्याग्रे कृताञ्जलिरवस्थितः।\nआगच्छेति च मामुक्त्वा पूर्वोत्तरपथं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2080283, "chapter_id": 2706, "verse_number": "१२-२११-४६", "content_sanskrit": "अतीव मृदुभावेन गच्छन्निव स दृश्यते।\nअयुतं नियुतं चाहं प्रयुतं चार्बुदं तथा।\nपतमानोऽहमनिशं योजनानि ततस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2080284, "chapter_id": 2706, "verse_number": "१२-२११-४७", "content_sanskrit": "ननु तत्वमहं भक्तो विष्ठितोस्मि प्रशास्तु नः।\nआगच्छ गरुडेत्येवं पुनराह स माधवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2080285, "chapter_id": 2706, "verse_number": "१२-२११-४८", "content_sanskrit": "ततो भूयो ह्यहं पातं पतमानो विहायसम्।\nआजगाम ततो घोरं शतकोटिसमावृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2080286, "chapter_id": 2706, "verse_number": "१२-२११-४९", "content_sanskrit": "तामसानीव भूतानि पर्वताभानि तत्र ह।\nसमानानीव पद्मानि ततोऽहं भीत आस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2080287, "chapter_id": 2706, "verse_number": "१२-२११-५०", "content_sanskrit": "ततो मां किंकरो घोरः शतयोजनमायतम्।\nनिगृह्य पाणिना तस्माच्चिक्षेप च स लोष्टवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2080288, "chapter_id": 2706, "verse_number": "१२-२११-५१", "content_sanskrit": "तत्तमोऽहमतिक्रम्य ह्यापं चैव विहायसम्।\nहुङ्कारघोपं तत्राहमशनीपातसन्निभान्।\nकर्णमूले ह्यशृण्वन्तस्ततो भूतैः समास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2080289, "chapter_id": 2706, "verse_number": "१२-२११-५२", "content_sanskrit": "ततोऽहं देवदेवेश त्राहि मां पुष्करेक्षण।\nइत्यब्रवमहं तत्र ततो विष्णुरुवाच माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2080290, "chapter_id": 2706, "verse_number": "१२-२११-५३", "content_sanskrit": "सुषिरस्य मुखे कश्चिन्मां चिक्षेप भयङ्करः।\nअतीतोऽहं क्षणादग्निमपश्यं वायुमण्डलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2080291, "chapter_id": 2706, "verse_number": "१२-२११-५४", "content_sanskrit": "आकाशमिव संप्रेक्ष्य क्षेप्तुकाममुपागतः।\nतत्राहं दुःखितो भूतः क्रोशमानो ह्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2080292, "chapter_id": 2706, "verse_number": "१२-२११-५५", "content_sanskrit": "क्षणान्तरेण घोरेण क्रुद्धो हि परमात्मना।\nस्वपक्षराजिना दृष्ट्वा मां चिक्षेप भयङ्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2080293, "chapter_id": 2706, "verse_number": "१२-२११-५६", "content_sanskrit": "-----गरुडकुलं सहस्रादित्यसन्निभम्।\nमां दृष्ट्वाऽप्यथ संस्थेऽथ ह्यल्पकालोऽतिदुर्बलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2080294, "chapter_id": 2706, "verse_number": "१२-२११-५७", "content_sanskrit": "अहो विहङ्गमः प्राप्त इति विस्मयमानसाः।\nमां दृष्ट्वोचुरहं तत्र पश्यामि गरुडध्वजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2080295, "chapter_id": 2706, "verse_number": "१२-२११-५८", "content_sanskrit": "सहस्रयोजनायामं सहस्रादित्यवर्चसम्।\nसहस्रगरुडारूढं गरुडास्ते महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2080296, "chapter_id": 2706, "verse_number": "१२-२११-५९", "content_sanskrit": "अत्याश्चर्यमिमं देव वपुषाऽस्मत्कुलोद्भवः।\nस्वल्पप्राणः स्वल्पकायः कोसौ पक्षी इहागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2080297, "chapter_id": 2706, "verse_number": "१२-२११-६०", "content_sanskrit": "तच्छ्रुत्वाऽहं नष्टगर्वो भीतो लज्जासमन्वितः।\nस्वयं बुद्ध्श्च संविग्नस्ततो ह्यशृणवं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2080298, "chapter_id": 2706, "verse_number": "१२-२११-६१", "content_sanskrit": "आगच्छ गरुडेत्येव ततोऽहं यानमास्थितः।\nपरार्ध्यं च ततो गत्वा योजनानां शतं पुनः।\nतत्रापश्यमहं यो वै ब्रह्माणं परमेष्ठिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2080299, "chapter_id": 2706, "verse_number": "१२-२११-६२", "content_sanskrit": "तत्रापि चापरं तत्र शतकोटिपितामहान्।\nपुनरेहीत्युवाचोच्चैर्भगवान्मधुसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2080300, "chapter_id": 2706, "verse_number": "१२-२११-६३", "content_sanskrit": "महाकुलं ततोऽपश्यं प्रमाणानि तमव्ययम्।\nकपित्थफलसंकाशमन्धकारैः समाश्रितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2080301, "chapter_id": 2706, "verse_number": "१२-२११-६४", "content_sanskrit": "तत्र स्थितो हरिः श्रीमानण्डमेकं बिभेद ह।\nमहद्भूतं हि मां गृह्य दत्त्वा वै प्राक्षिपत्पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2080302, "chapter_id": 2706, "verse_number": "१२-२११-६५", "content_sanskrit": "तन्सध्ये सागरान्सप्त ब्रह्माणं च तथा सुरान्।\nपश्याम्यहं यथायोगं मातरं स्वकुलं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2080303, "chapter_id": 2706, "verse_number": "१२-२११-६६", "content_sanskrit": "एवं मयाऽनुभूतं हि तत्वान्वेषणकाङ्क्षिणा।\nशिबिकासदृशं मां वै पश्यध्वं मुनिसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2080304, "chapter_id": 2706, "verse_number": "१२-२११-६७", "content_sanskrit": "इत्येवमब्रवं विप्रान्भीष्म यन्मे पुराऽभवत्।\nतत्ते सर्वं यथान्यायमुक्तवानस्मि सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2080305, "chapter_id": 2706, "verse_number": "१२-२११-६८", "content_sanskrit": "योगिनस्तं प्रपश्यन्ति ज्ञानं दृष्ट्वा परं हरिम्।\nनान्यथा शक्यरूपोसौ ज्ञानगम्यः परः पुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2080306, "chapter_id": 2706, "verse_number": "१२-२११-६९", "content_sanskrit": "अनन्यया च भक्त्या च प्राप्तुं शक्यो महाहरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2080307, "chapter_id": 2706, "verse_number": "१२-२११-७०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2080308, "chapter_id": 2706, "verse_number": "१२-२११-७०", "content_sanskrit": "इत्येवमुक्त्वा भगवान्सुपर्णः पक्षिराट् प्रभुः।\nआमन्त्र्य जननीं मे वै तत्रैवान्तरधीयत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2080309, "chapter_id": 2706, "verse_number": "१२-२११-७१", "content_sanskrit": "तस्माद्राजेन्द्र सर्वात्मा वासुदेवः प्रधानकृत्।\nज्ञानेन भक्त्या सुलभो नान्यथेति मतिर्मम॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2080310, "chapter_id": 2706, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि एकादशाधिकद्विशततमोऽध्यायः॥ २११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]