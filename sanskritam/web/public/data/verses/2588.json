[{"id": 2075110, "chapter_id": 2588, "verse_number": "१२-९३-०x", "content_sanskrit": "वामदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2075111, "chapter_id": 2588, "verse_number": "१२-९३-१", "content_sanskrit": "यत्राधर्मं प्रणयते दुर्बले बलवत्तरः।\nतां वृत्तिमुपजीवन्ति ये भवन्ति तदन्वयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2075112, "chapter_id": 2588, "verse_number": "१२-९३-२", "content_sanskrit": "राजानमनुवर्तन्ते तं पापाभिप्रवर्तकम्।\nअविनीतमनुष्यं तत्क्षिप्रं राष्ट्रं विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2075113, "chapter_id": 2588, "verse_number": "१२-९३-३", "content_sanskrit": "यद्वॄत्तमुपजीवन्ति प्रकृतिस्थस्य मानवाः।\nतदेव विषमस्थस्य स्वजनोऽपि न मृष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2075114, "chapter_id": 2588, "verse_number": "१२-९३-४", "content_sanskrit": "साहसप्रवृत्ते र्यत्र किंचिदुल्वणमाचरेत्।\nअशास्त्रलक्षणो राजा क्षिप्रमेव विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2075115, "chapter_id": 2588, "verse_number": "१२-९३-५", "content_sanskrit": "सद्वॄत्ताचरितां वृत्तिं क्षत्रियो नानुवर्तते।\nजितानामजितानां च क्षत्रधर्मादपैति सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2075116, "chapter_id": 2588, "verse_number": "१२-९३-६", "content_sanskrit": "द्विषन्तं कृतकल्याणं गृहीत्वा नृपतिं रणे।\nयो न नयते द्वेषात्क्षत्रधर्मादपैति सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2075117, "chapter_id": 2588, "verse_number": "१२-९३-७", "content_sanskrit": "शक्तः आत्सुसुखो राजा कुर्यात्तारणमापदि।\nप्रियो अति भूतानां न च विभ्रश्यते श्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2075118, "chapter_id": 2588, "verse_number": "१२-९३-८", "content_sanskrit": "अप्रियं यस्य कुर्वीत भूयस्तस्य प्रियं चरेत्।\nअचिरेण प्रियः स स्याद्योऽप्रिये प्रियमाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2075119, "chapter_id": 2588, "verse_number": "१२-९३-९", "content_sanskrit": "मृषावादं परिहरेत्कुर्यात्प्रियमयाचितः।\nन कामान्न च संरम्भान्न द्वेषाद्धर्ममुत्सृजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2075120, "chapter_id": 2588, "verse_number": "१२-९३-१०", "content_sanskrit": "`अमाययैव वर्तेत न च सत्यं त्यजेद्बुधः।\nदमं धर्मं च शीलं च क्षत्रधर्मं प्रजाहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2075121, "chapter_id": 2588, "verse_number": "१२-९३-११", "content_sanskrit": "नापत्रपेत प्रश्नेषु नाभिभाविगिरं सृजेत्।\nन त्वरेत न चासूयेत्तथा संगृह्यते परः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2075122, "chapter_id": 2588, "verse_number": "१२-९३-१२", "content_sanskrit": "प्रिये नातिभृशं हृष्येदप्रिये न च संज्वरेत्।\nन तप्येदर्थकृच्छ्रेषु प्रजाहितमनुस्मरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2075123, "chapter_id": 2588, "verse_number": "१२-९३-१३", "content_sanskrit": "यः प्रियं कुरुते नित्यं गुणतो वसुधाधिपः।\nतस्य कर्माणि सिद्ध्यन्ति न च संत्यज्यते श्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2075124, "chapter_id": 2588, "verse_number": "१२-९३-१४", "content_sanskrit": "निवृत्तं प्रतिकूलेभ्यो वर्तमानमनुप्रिये।\nभक्तं भजेत नृपतिस्तद्वै वृत्तं सतामिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2075125, "chapter_id": 2588, "verse_number": "१२-९३-१५", "content_sanskrit": "अप्रकीर्णेन्द्रियग्राममत्यन्तानुगतं शुचिम्।\nशक्तं चैवानुरक्तं च युञ्ज्यान्महति कर्मणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2075126, "chapter_id": 2588, "verse_number": "१२-९३-१६", "content_sanskrit": "`श्रेयसो लक्षणं चैतद्विक्रमो यत्र दृश्यते।\nकीर्तिप्रधानो यश्च स्यात्समये यश्च तिष्ठति।\nसमर्थान्पूजयेद्यश्च न च स्पर्धेत यश्चतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2075127, "chapter_id": 2588, "verse_number": "१२-९३-१७", "content_sanskrit": "एवमेतैर्गुणैर्युक्तो योऽनुरज्यति भूमिपम्।\nभर्तुरर्थेष्वप्रमत्तं नियुञ्ज्यादर्थकर्मणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2075128, "chapter_id": 2588, "verse_number": "१२-९३-१८", "content_sanskrit": "मूढमैन्द्रियकं लुब्धमनार्यचरितं शठम्।\nअनतीतोपधं हिंस्रं दुर्बुद्धिमबहुश्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2075129, "chapter_id": 2588, "verse_number": "१२-९३-१९", "content_sanskrit": "त्यक्तोपात्तं मद्यरतं द्यूतस्त्रीमृगयापरम्।\nकार्ये महति युञ्जानो हीयते नृपतिः श्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2075130, "chapter_id": 2588, "verse_number": "१२-९३-२०", "content_sanskrit": "रक्षितात्मा च यो राजा रक्ष्यान्यश्चानुरक्षति।\nप्रजाश्च तस्य वर्धन्ते सुखं च महदश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2075131, "chapter_id": 2588, "verse_number": "१२-९३-२१", "content_sanskrit": "ये केचिद्भूमिपतयः सर्वांस्तानन्ववेक्षयेत्।\nसुहृद्भिरनभिख्यातैस्तेन राजा न रिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2075132, "chapter_id": 2588, "verse_number": "१२-९३-२२", "content_sanskrit": "अपकृत्य बलस्थस्व दूरस्थोऽस्मीति नाश्वसेत्।\nश्येनाभिपतनैरेते निपतन्ति प्रमाद्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2075133, "chapter_id": 2588, "verse_number": "१२-९३-२३", "content_sanskrit": "दृढमूलस्त्वदुष्टात्मा विदित्वा बलमात्मनः।\nअबलानभियुञ्जीत न तु ये बलवत्तराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2075134, "chapter_id": 2588, "verse_number": "१२-९३-२४", "content_sanskrit": "विक्रमेण महीं लब्ध्वा प्रजा धर्मेण पालयेत्।\nआहवे निधनं कुर्याद्राजा धर्मपरायणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2075135, "chapter_id": 2588, "verse_number": "१२-९३-२५", "content_sanskrit": "मरणान्तमिदं सर्वं नेह किंचिदनामयम्।\nतस्माद्धर्मे स्थितो राजा प्रजा धर्मेम पालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2075136, "chapter_id": 2588, "verse_number": "१२-९३-२६", "content_sanskrit": "रक्षाधिकरणं युद्धं तथा धर्मानुशासनम्।\nमन्त्रचिन्ता सुखं काले पञ्चभिर्वर्धते मही॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2075137, "chapter_id": 2588, "verse_number": "१२-९३-२७", "content_sanskrit": "एतानि यस्य गुप्तानि स राजा राजसत्तम।\nसततं वर्तमानोऽत्र राजा भुङ्क्ते महीमिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2075138, "chapter_id": 2588, "verse_number": "१२-९३-२८", "content_sanskrit": "नैतान्येकेन शक्यानि सातत्येनानुवीक्षितुम्।\nएतेष्वाप्तान्प्रतिष्ठाप्य राजा भुङ्क्ते चिरं महीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2075139, "chapter_id": 2588, "verse_number": "१२-९३-२९", "content_sanskrit": "दातारं संविभक्तारं मार्दवोपगतं शुचिम्।\nअसंत्यक्तमनुष्यं च तं जनाः कुर्वते नृपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2075140, "chapter_id": 2588, "verse_number": "१२-९३-३०", "content_sanskrit": "यस्तु नैःश्रेयसं श्रुत्वा ज्ञानं तत्प्रतिपद्यते।\nआत्मनो मतमुत्सृज्य तं लोकोऽनुविधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2075141, "chapter_id": 2588, "verse_number": "१२-९३-३१", "content_sanskrit": "योऽर्थकामस्य वचनं प्रातिकूल्यान्न मृष्यते।\nशृणोति प्रतिकूलानि सर्वदा विमना इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2075142, "chapter_id": 2588, "verse_number": "१२-९३-३२", "content_sanskrit": "अग्राम्यचरितां वृत्तिं यो न सेवेत नित्यदा।\nजितानामजितानां च क्षत्रधर्मादपैति सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2075143, "chapter_id": 2588, "verse_number": "१२-९३-३३", "content_sanskrit": "[निगृहीतादमात्याच्च स्त्रीभ्यश्चैव विशेषतः।\nपर्वताद्विषमाद्दुर्गाद्धस्तिनोऽश्वात्सरीसृपात्।\nएतेभ्यो नित्ययुक्तः सन्रक्षेदात्मानमेव तु॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2075144, "chapter_id": 2588, "verse_number": "१२-९३-३४", "content_sanskrit": "मुख्यानमात्यान्यो हित्वा निहीनान्कुरुते प्रियान्।\nस वै व्यसनमासाद्य साधुमार्गं न विन्दति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2075145, "chapter_id": 2588, "verse_number": "१२-९३-३५", "content_sanskrit": "यः कल्याणगुणाञ्ज्ञातीन्प्रद्वेषान्नो बुभूषति।\nअदृढात्मा दृढक्रोधः नास्यार्थो वसतेऽन्तिके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2075146, "chapter_id": 2588, "verse_number": "१२-९३-३६", "content_sanskrit": "अथ यो गुणसंपन्नान्हृदयस्य प्रियानपि।\nप्रियेण कुरुते वश्यांश्चिरं यशसि तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2075147, "chapter_id": 2588, "verse_number": "१२-९३-३७", "content_sanskrit": "नाकाले प्रणयेदर्थान्नाप्रिये जातु संज्वरेत्।\nप्रिये नातिभृशं तुष्येद्युञ्जीतारोग्यकर्मणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2075148, "chapter_id": 2588, "verse_number": "१२-९३-३८", "content_sanskrit": "के वाऽनुरक्ता राजानः के भयात्समुपाश्रिताः।\nमध्यस्थदोषाः के चैषामिति नित्यं विचिन्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2075149, "chapter_id": 2588, "verse_number": "१२-९३-३९", "content_sanskrit": "न जातु बलवान्भूत्वा दुर्बले विश्वसेत्क्वचित्।\nभारुण्डसदृशा ह्येते निपतन्ति प्रमाद्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2075150, "chapter_id": 2588, "verse_number": "१२-९३-४०", "content_sanskrit": "अपि सर्वगुणैर्युक्तं भर्तारं प्रियवादिन।\nअभिद्रुह्यति पापात्मा न तस्माद्विश्वसेज्जनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2075151, "chapter_id": 2588, "verse_number": "१२-९३-४१", "content_sanskrit": "एतद्राजोपनिषदं ययातिः स्माह नाहुषः।\nमनुष्यविषये युक्तो हन्ति शत्रून्सवासवान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2075152, "chapter_id": 2588, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि त्रिनवतितमोऽध्यायः॥ ९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]