[{"id": 2093225, "chapter_id": 2988, "verse_number": "१३-११८-१", "content_sanskrit": "`युधिष्ठिर उवाच।\nसुरभेः काः प्रजाः पूर्वं मार्ताण्डादभवन्पुरा।\nएतन्मे शंस तत्वेनि गोषु मे प्रीयते मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2093226, "chapter_id": 2988, "verse_number": "१३-११८-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2093227, "chapter_id": 2988, "verse_number": "१३-११८-२", "content_sanskrit": "शृणु नामानि दिव्यानि गोमातॄणां विशेषतः।\nयाभिर्व्याप्तास्त्रयो लोकाः कल्याणीभिर्जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2093228, "chapter_id": 2988, "verse_number": "१३-११८-३", "content_sanskrit": "सुरभ्यः प्रथमोद्भूता याश्च स्युः प्रथमाः प्रजाः।\nमयोच्यमानाः शृणु ताः प्राप्स्यसे विपुलं यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2093229, "chapter_id": 2988, "verse_number": "१३-११८-४", "content_sanskrit": "तप्त्वा तपो घोरतपाः सुरभिर्दिप्ततेजसः।\nसुषावैकादश सुतान्रुद्रा ये च्छन्दसि स्तुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2093230, "chapter_id": 2988, "verse_number": "१३-११८-५", "content_sanskrit": "अजैकपादहिर्बुध्न्यस्त्र्यम्बकश्च महायशाः।\nवृषाकपिश्च शम्भुश्च कपाली रैवतस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2093231, "chapter_id": 2988, "verse_number": "१३-११८-६", "content_sanskrit": "हरश्च बहुरूपश्च उग्र उग्रोऽथ वीर्यवान्।\nतस्य चैवात्मजः श्रीमान्विश्वरूपो महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2093232, "chapter_id": 2988, "verse_number": "१३-११८-७", "content_sanskrit": "एकादशैते कथिता रुद्रास्ते नाम नामतः।\nमहात्मानो महायोगास्तेजोयुक्ता महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2093233, "chapter_id": 2988, "verse_number": "१३-११८-८", "content_sanskrit": "एते वरिष्ठजन्मानो देवानां ब्रह्मवादिनाम्।\nविप्राणां प्रकृतिर्लोके एत एव हि विश्रुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2093234, "chapter_id": 2988, "verse_number": "१३-११८-९", "content_sanskrit": "एत एकादश प्रोक्ता रुद्रास्त्रिभुवनेश्वराः।\nशतं त्वेतत्समाख्यातं शतरुद्रं महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2093235, "chapter_id": 2988, "verse_number": "१३-११८-१०", "content_sanskrit": "सुषुवे प्रथमां कन्यां सुरभिः पृथिवीं तदा।\nविश्वकामदुघा धेनुर्या धारयति देहिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2093236, "chapter_id": 2988, "verse_number": "१३-११८-११", "content_sanskrit": "सुतं गोब्राह्मणं राजन्नेकमित्यभिधीयते।\nगोब्राह्मणस्य जननी सुरभिः परिकीर्त्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2093237, "chapter_id": 2988, "verse_number": "१३-११८-१२", "content_sanskrit": "सृष्ट्वा तु प्रथमं रुद्रान्वरदान्रुद्रसम्भवान्।\nपश्चात्प्रभुं ग्रहपतिं सुषुवे लोकसम्मतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2093238, "chapter_id": 2988, "verse_number": "१३-११८-१३", "content_sanskrit": "सोमराजानममृतं यज्ञसर्वस्वमुत्तमम्।\nओषधीनां रसानां च देवानां जीवितस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2093239, "chapter_id": 2988, "verse_number": "१३-११८-१४", "content_sanskrit": "ततः श्रियं च मेधां च कीर्तिं देवीं सरस्वतीम्।\nचतस्रः सुषुवे कन्या योगेषु नियताः स्तिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2093240, "chapter_id": 2988, "verse_number": "१३-११८-१५", "content_sanskrit": "एताः सृष्ट्वा प्रजा एषा सुरभिः कामरूपिणी।\nसुषुवे परमं भूयो दिव्या गोमातरः शुभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2093241, "chapter_id": 2988, "verse_number": "१३-११८-१६", "content_sanskrit": "पुण्यां मायां मधुश्च्योतां शिवां शीघ्रां सरिद्वराम्।\nहिरण्यवर्णां सुभगां गव्यां पृश्नीं कुथावतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2093242, "chapter_id": 2988, "verse_number": "१३-११८-१७", "content_sanskrit": "अङ्गावतीं घृतवतीं दधिक्षीरपयोवतीम्।\nअमोघां सुरमां सत्यां रेवतीं मारुतीं रसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2093243, "chapter_id": 2988, "verse_number": "१३-११८-१८", "content_sanskrit": "अजां च सिकतां चैव शुद्धधूमामधारिणीम्।\nजीवां प्राणवतीं धन्यां शुद्धां धेनुं धनावहाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2093244, "chapter_id": 2988, "verse_number": "१३-११८-१९", "content_sanskrit": "इन्द्रामृद्धिं च शान्ति च शान्तपापां सरिद्वराम्।\nचत्वारिंशतिमेकां च धन्यास्ता दिवि पूजिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2093245, "chapter_id": 2988, "verse_number": "१३-११८-२०", "content_sanskrit": "भूयो जज्ञे सुरभ्याश्च श्रीमांश्चन्द्रांशुसप्रभः।\nवृपो दक्ष इति ख्यातः कण्ढे मणितलप्रभः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2093246, "chapter_id": 2988, "verse_number": "१३-११८-२१", "content_sanskrit": "स्रग्वी ककुद्मान्द्युतिमान्मृणालसदृशप्रभः।\nसुरभ्यनुमते दत्तो ध्वजो माहेशअवरस्तु सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2093247, "chapter_id": 2988, "verse_number": "१३-११८-२२", "content_sanskrit": "सुरभ्यः कामरूपिण्यो गावः पुण्यार्थमुत्कटाः।\nआदित्येभ्यो वसुभ्यश्च विश्वेभ्यश्च ददौ वरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2093248, "chapter_id": 2988, "verse_number": "१३-११८-२३", "content_sanskrit": "सुरभिस्तु तपस्तप्त्वा सुषुवे गास्ततः पुनः।\nया दत्ता लोकपालानामिन्द्रादीनां युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2093249, "chapter_id": 2988, "verse_number": "१३-११८-२४", "content_sanskrit": "सुष्टुनां कपिलां चैव रोहिणीं च यशस्विनीम्।\nसर्वकामदुघां चैव मरुतां कामरूपिणीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2093250, "chapter_id": 2988, "verse_number": "१३-११८-२५", "content_sanskrit": "गावो मृष्टदुघा ह्येतास्ताश्चतस्रोऽत्र संस्तुताः।\nयासां भूत्वा पुरा वत्साः पिबन्त्यमृतमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2093251, "chapter_id": 2988, "verse_number": "१३-११८-२६", "content_sanskrit": "सुष्टुतां देवराजाय वासवाय महात्मने।\nकपिलां धर्मराजाय वरुणाय च रोहिणीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2093252, "chapter_id": 2988, "verse_number": "१३-११८-२७", "content_sanskrit": "सर्वकामदुघां धेनुं राज्ञे वैश्रवणाय च।\nइत्येता लोकमहिता विश्रुताः सुरभेः प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2093253, "chapter_id": 2988, "verse_number": "१३-११८-२८", "content_sanskrit": "एतासां प्रजया पूर्णा पृथिवी मुनिपुङ्गवः।\nगोभ्यः प्रभवते सर्वं यत्किंचिदिह शोभनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2093254, "chapter_id": 2988, "verse_number": "१३-११८-२९", "content_sanskrit": "सुरभ्यपत्यमित्येतन्नामतस्तेऽनुपूर्वशः।\nकीर्तितं ब्रूहि राजेन्द्र किं भूयः कथयामि ते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2093255, "chapter_id": 2988, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि अष्टादशाधिकशततमोऽध्यायः॥ ११८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]