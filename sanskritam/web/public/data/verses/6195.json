[
  {
    "id": 16795001,
    "chapter_id": 6195,
    "verse_number": "2.1",
    "content_sanskrit": "तदेतत्सत्यं यथा सुदीप्तात्पावकाद्विस्फुलिङ्गाः सहस्रशः प्रभवन्ते सरूपाः ।\nतथाक्षराद्विविधाः सोम्य भावाः प्रजायन्ते तत्र चैवापियन्ति ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "base_unit_id": "MD_C02_S01_V01"
  },
  {
    "id": 16795002,
    "chapter_id": 6195,
    "verse_number": "2.2",
    "content_sanskrit": "दिव्यो ह्यमूर्तः पुरुषः सबाह्याभ्यन्तरो ह्यजः ।\nअप्राणो ह्यमनाः शुभ्रो ह्यक्षरात्परतः परः ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "base_unit_id": "MD_C02_S01_V02"
  },
  {
    "id": 16795003,
    "chapter_id": 6195,
    "verse_number": "2.3",
    "content_sanskrit": "एतस्माज्जायते प्राणो मनः सर्वेन्द्रियाणि च ।\nखं वायुर्ज्योतिरापः पृथिवी विश्वस्य धारिणी ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "base_unit_id": "MD_C02_S01_V03"
  },
  {
    "id": 16795004,
    "chapter_id": 6195,
    "verse_number": "2.4",
    "content_sanskrit": "अग्निर्मूर्धा चक्षुषी चन्द्रसूर्यौ दिशः श्रोत्रे वाग्विवृताश्च वेदाः ।\nवायुः प्राणो हृदयं विश्वमस्य पद्भ्यां पृथिवी ह्येष सर्वभूतान्तरात्मा ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "base_unit_id": "MD_C02_S01_V04"
  },
  {
    "id": 16795005,
    "chapter_id": 6195,
    "verse_number": "2.5",
    "content_sanskrit": "तस्मादग्निः समिधो यस्य सूर्यः सोमात्पर्जन्य ओषधयः पृथिव्याम् ।\nपुमान्रेतः सिञ्चति योषितायां बह्वीः प्रजाः पुरुषात्सम्प्रसूताः ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "base_unit_id": "MD_C02_S01_V05"
  },
  {
    "id": 16795006,
    "chapter_id": 6195,
    "verse_number": "2.6",
    "content_sanskrit": "तस्मादृचः साम यजूंषि दीक्षा यज्ञाश्च सर्वे क्रतवो दक्षिणाश्च ।\nसंवत्सरश्च यजमानश्च लोकाः सोमो यत्र पवते यत्र सूर्यः ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "base_unit_id": "MD_C02_S01_V06"
  },
  {
    "id": 16795007,
    "chapter_id": 6195,
    "verse_number": "2.7",
    "content_sanskrit": "तस्माच्च देवा बहुधा सम्प्रसूताः साध्या मनुष्याः पशवो वयांसि ।\nप्राणापानौ व्रीहियवौ तपश्च श्रद्धा सत्यं ब्रह्मचर्यं विधिश्च ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "base_unit_id": "MD_C02_S01_V07"
  },
  {
    "id": 16795008,
    "chapter_id": 6195,
    "verse_number": "2.8",
    "content_sanskrit": "सप्त प्राणाः प्रभवन्ति तस्मात्सप्तार्चिषः समिधः सप्त होमाः ।\nसप्तेमे लोका येषु चरन्ति प्राणा गुहाशया निहिताः सप्त सप्त ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "base_unit_id": "MD_C02_S01_V08"
  },
  {
    "id": 16795009,
    "chapter_id": 6195,
    "verse_number": "2.9",
    "content_sanskrit": "अतः समुद्रा गिरयश्च सर्वेऽस्मात्स्यन्दन्ते सिन्धवः सर्वरूपाः ।\nअतश्च सर्वा ओषधयो रसश्च येनैष भूतैस्तिष्ठते ह्यन्तरात्मा ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "base_unit_id": "MD_C02_S01_V09"
  },
  {
    "id": 16795010,
    "chapter_id": 6195,
    "verse_number": "2.10",
    "content_sanskrit": "पुरुष एवेदं विश्वं कर्म तपो ब्रह्म परामृतम् ।\nएतद्यो वेद निहितं गुहायां सोऽविद्याग्रन्थिं विकिरतीह सोम्य ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "base_unit_id": "MD_C02_S01_V10"
  },
  {
    "id": 16795011,
    "chapter_id": 6195,
    "verse_number": "2.11",
    "content_sanskrit": "आविः संनिहितं गुहाचरं नाम महत्पदमत्रैतत्समर्पितम् ।\nएजत्प्राणन्निमिषच्च यदेतज्जानथ सदसद्वरेण्यं परं विज्ञानाद्यद्वरिष्ठं प्रजानाम् ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "base_unit_id": "MD_C02_S02_V01"
  },
  {
    "id": 16795012,
    "chapter_id": 6195,
    "verse_number": "2.12",
    "content_sanskrit": "यदर्चिमद्यदणुभ्योऽणु च यस्मिंल्लोका निहिता लोकिनश्च ।\nतदेतदक्षरं ब्रह्म स प्राणस्तदु वाङ्मनः ।\nतदेतत्सत्यं तदमृतं तद्वेद्धव्यं सोम्य विद्धि ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "base_unit_id": "MD_C02_S02_V02"
  },
  {
    "id": 16795013,
    "chapter_id": 6195,
    "verse_number": "2.13",
    "content_sanskrit": "धनुर्गृहीत्वौपनिषदं महास्त्रं शरं ह्युपासानिशितं सन्दधीत ।\nआयम्य तद्भावगतेन चेतसा लक्ष्यं तदेवाक्षरं सोम्य विद्धि ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "base_unit_id": "MD_C02_S02_V03"
  },
  {
    "id": 16795014,
    "chapter_id": 6195,
    "verse_number": "2.14",
    "content_sanskrit": "प्रणवो धनुः शरो ह्यात्मा ब्रह्म तल्लक्ष्यमुच्यते ।\nअप्रमत्तेन वेद्धव्यं शरवत्तन्मयो भवेत् ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "base_unit_id": "MD_C02_S02_V04"
  },
  {
    "id": 16795015,
    "chapter_id": 6195,
    "verse_number": "2.15",
    "content_sanskrit": "यस्मिन्द्यौः पृथिवी चान्तरिक्षमोतं मनः सह प्राणैश्च सर्वैः ।\nतमेवैकं जानथ आत्मानमन्या वाचो विमुञ्चथामृतस्यैष सेतुः ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "base_unit_id": "MD_C02_S02_V05"
  },
  {
    "id": 16795016,
    "chapter_id": 6195,
    "verse_number": "2.16",
    "content_sanskrit": "अरा इव रथनाभौ संहता यत्र नाड्यः स एषोऽन्तश्चरते बहुधा जायमानः ।\nओमित्येवं ध्यायथ आत्मानं स्वस्ति वः पाराय तमसः परस्तात् ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "base_unit_id": "MD_C02_S02_V06"
  },
  {
    "id": 16795017,
    "chapter_id": 6195,
    "verse_number": "2.17",
    "content_sanskrit": "यः सर्वज्ञः सर्वविद्यस्यैष महिमा भुवि ।\nदिव्ये ब्रह्मपुरे ह्येष व्योमन्यात्मा प्रतिष्ठितः ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "base_unit_id": "MD_C02_S02_V07"
  },
  {
    "id": 16795018,
    "chapter_id": 6195,
    "verse_number": "2.18",
    "content_sanskrit": "मनोमयः प्राणशरीरनेता प्रतिष्ठितोऽन्ने हृदयं सन्निधाय ।\nतद्विज्ञानेन परिपश्यन्ति धीरा आनन्दरूपममृतं यद्विभाति ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "base_unit_id": "MD_C02_S02_V08"
  },
  {
    "id": 16795019,
    "chapter_id": 6195,
    "verse_number": "2.19",
    "content_sanskrit": "भिद्यते हृदयग्रन्थिश्छिद्यन्ते सर्वसंशयाः ।\nक्षीयन्ते चास्य कर्माणि तस्मिन्दृष्टे परावरे ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "base_unit_id": "MD_C02_S02_V09"
  },
  {
    "id": 16795020,
    "chapter_id": 6195,
    "verse_number": "2.20",
    "content_sanskrit": "हिरण्मये परे कोशे विरजं ब्रह्म निष्कलम् ।\nतच्छुभ्रं ज्योतिषां ज्योतिस्तद्यदात्मविदो विदुः ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "base_unit_id": "MD_C02_S02_V10"
  },
  {
    "id": 16795021,
    "chapter_id": 6195,
    "verse_number": "2.21",
    "content_sanskrit": "न तत्र सूर्यो भाति न चन्द्रतारकं नेमा विद्युतो भान्ति कुतोऽयमग्निः ।\nतमेव भान्तमनुभाति सर्वं तस्य भासा सर्वमिदं विभाति ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "base_unit_id": "MD_C02_S02_V11"
  },
  {
    "id": 16795022,
    "chapter_id": 6195,
    "verse_number": "2.22",
    "content_sanskrit": "ब्रह्मैवेदममृतं पुरस्ताद्ब्रह्म पश्चाद्ब्रह्म दक्षिणतश्चोत्तरेण ।\nअधश्चोर्ध्वं च प्रसृतं ब्रह्मैवेदं विश्वमिदं वरिष्ठम् ॥ १२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "base_unit_id": "MD_C02_S02_V12"
  }
]