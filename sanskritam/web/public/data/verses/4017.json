[{"id": 2139630, "chapter_id": 4017, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2139631, "chapter_id": 4017, "verse_number": "१", "content_sanskrit": "तथा भद्रे करिष्यामि यथा त्वं भीरु भाषसे ।\nअद्यैनं सूदयिष्यामि कीचकं सहबान्धवम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2139632, "chapter_id": 4017, "verse_number": "२", "content_sanskrit": "अस्याः प्रदोषे शर्वर्याः कुरुष्वानेन संविदम् ।\nदुःखं शोकं च निर्धूय याज्ञसेनि शुचिस्मिते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2139633, "chapter_id": 4017, "verse_number": "३", "content_sanskrit": "यदेतन्नर्तनागारं मत्स्यराजेन कारितम् ।\nदिवाऽत्र कन्या नृत्यन्ति रात्रौ यान्ति स्वकं गृहम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2139634, "chapter_id": 4017, "verse_number": "४", "content_sanskrit": "तत्रास्ति शयनं दिव्यं दृढाङ्गं सुप्रतिष्ठितम् ।\nतत्रैनं दर्शयिष्यामि पूर्वप्रेतान् पितामहान्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2139635, "chapter_id": 4017, "verse_number": "५", "content_sanskrit": "सङ्केतं सूतपुत्रस्य कारयस्व शुभानने ।\nयथा परे न पश्येयुः कुर्वन्तीं तेन संविदम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2139636, "chapter_id": 4017, "verse_number": "६", "content_sanskrit": "तथा कुरुष्व कल्याणि यथा सन्निहितो भवेत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2139637, "chapter_id": 4017, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2139638, "chapter_id": 4017, "verse_number": "७", "content_sanskrit": "तत्र तौ कथयित्वा तु बाष्पमुत्सृज्य दुःखितौ\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2139639, "chapter_id": 4017, "verse_number": "८", "content_sanskrit": "भीमेन च प्रतिज्ञाते कीचकस्य वधे तदा ।\nद्रौपदी च सुदेष्णाया प्रविवेश पुनर्गृहम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2139640, "chapter_id": 4017, "verse_number": "९", "content_sanskrit": "रात्रिशेषं तदव्यग्रा धारयामास वै हृदि\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2139641, "chapter_id": 4017, "verse_number": "१०", "content_sanskrit": "तस्यां रात्र्यां व्यतीतायां प्रातरुत्थाय कीचकः ।\nगत्वा राजकुलायैव द्रौपदीमिदमब्रवीत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2139642, "chapter_id": 4017, "verse_number": "११", "content_sanskrit": "यत् सोऽहं पश्यतो राज्ञो पातयित्वा पदाऽहनम् ।\nन कञ्चिल्लभसे नाथमभिपन्ना बलीयसा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2139643, "chapter_id": 4017, "verse_number": "१२", "content_sanskrit": "प्रवादेनेह मत्स्यानामयं राजेति चोच्यते ।\nअहमेव हि राजा वै मत्स्यानां वाहिनीपतिः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2139644, "chapter_id": 4017, "verse_number": "१३", "content_sanskrit": "सा सुखं प्रतिपद्यस्व दासो भीरु भवामि ते ।\nन ह्यहं त्वामृते भीरु चिरं जीवितुमुत्सहे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2139645, "chapter_id": 4017, "verse_number": "१४", "content_sanskrit": "अह्नाय तव सुश्रोणि शतनिष्कं ददामि ते ।\nदासीशतं च ते दद्यां दासानामपि चापरम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2139646, "chapter_id": 4017, "verse_number": "१५", "content_sanskrit": "तथाश्वांश्च त्वरायुक्तानस्तु नौ भीरु सङ्गमः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2139647, "chapter_id": 4017, "verse_number": "", "content_sanskrit": "सैरन्ध्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2139648, "chapter_id": 4017, "verse_number": "१६", "content_sanskrit": "एतन्मे वचनं सत्यं प्रतिपद्यस्व कीचक ।\nन ते सखा वा भ्राता वा जानीयात् सङ्गमं मया\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2139649, "chapter_id": 4017, "verse_number": "१७", "content_sanskrit": "अनुबोधादनर्थः स्याद् अयशश्च महद् भवेत् ।\nअनुबोधाद्धि भीताऽस्मि गन्धर्वाणां यशस्विनाम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2139650, "chapter_id": 4017, "verse_number": "१८", "content_sanskrit": "एतन्मे प्रतिजानीहि ततोऽहं वशगा तव\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2139651, "chapter_id": 4017, "verse_number": "", "content_sanskrit": "कीचकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2139652, "chapter_id": 4017, "verse_number": "१९", "content_sanskrit": "एवमेतत् करिष्यामि यथा सुश्रोणि भाषसे\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2139653, "chapter_id": 4017, "verse_number": "२०", "content_sanskrit": "एकोऽहमागमिष्यामि शून्यमावसथं तव ।\nसमागमार्थं रम्भोरु त्वया मदनमोहितः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2139654, "chapter_id": 4017, "verse_number": "२१", "content_sanskrit": "यथा त्वां नावबुध्येयुर्गन्धर्वाः सूर्यवर्चसः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2139655, "chapter_id": 4017, "verse_number": "", "content_sanskrit": "सैरन्ध्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2139656, "chapter_id": 4017, "verse_number": "२२", "content_sanskrit": "यदिदं नर्तनागारं मत्स्यराजेन कारितम् ।\nदिवा तु कन्या नृत्यन्ति रात्रौ यान्ति स्वकं गृहम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2139657, "chapter_id": 4017, "verse_number": "२३", "content_sanskrit": "निशायां तत्र गच्छेथा गन्धर्वास्तन्न जानते ।\nतत्र दोषः परिहृतो भविष्यति न संशयः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2139658, "chapter_id": 4017, "verse_number": "२४", "content_sanskrit": "एकस्त्वं नर्तनागारं रात्रौ सङ्केतमाव्रज ।\nतत्राहं वशगा तुभ्यं भविता नात्र संशयः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2139659, "chapter_id": 4017, "verse_number": "", "content_sanskrit": "कीचकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2139660, "chapter_id": 4017, "verse_number": "२५", "content_sanskrit": "तथा भद्रे करिष्यामि यथा त्वं भीरु मन्यसे\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2139661, "chapter_id": 4017, "verse_number": "२६", "content_sanskrit": "एकः सन् नर्तनागारमागमिष्यामि भामिनि ।\nसमागमार्थं सुश्रोणि शपे च सुकृतेन मे\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2139662, "chapter_id": 4017, "verse_number": "२७", "content_sanskrit": "यथा त्वां नावबुध्यन्ते गन्धर्वा वरवर्णिनि ।\nसत्यं मे प्रतिजानीहि गन्धर्वेभ्यो न ते भयम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2139663, "chapter_id": 4017, "verse_number": "२८", "content_sanskrit": "अलङ्करिष्याम्यद्याहं त्वत्समागमनाय वै\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2139664, "chapter_id": 4017, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2139665, "chapter_id": 4017, "verse_number": "२९", "content_sanskrit": "तमर्थमभिजल्पन्त्या द्रौपद्याः कीचकस्य वै ।\nक्षणमात्रं तदभवन्मासेनेव समं नृप\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2139666, "chapter_id": 4017, "verse_number": "३०", "content_sanskrit": "कीचकोऽथ गृहं गत्वा भृशं हर्षपरिप्लुतः ।\nसैरन्ध्रीरूपिणं मूढो मृत्युं तां नावबुद्धवान्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2139667, "chapter_id": 4017, "verse_number": "३१", "content_sanskrit": "गन्धाभरणमाल्येषु व्यासक्तः स विशेषतः ।\nअलङ्कारं चकाराशु सत्वरः कालचोदितः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2139668, "chapter_id": 4017, "verse_number": "३२", "content_sanskrit": "तस्य तत् कुर्वतः कर्म कालो दीर्घ इवाभवत् ।\nअनुचिन्तयतश्चापि तामेवायतलोचनाम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2139669, "chapter_id": 4017, "verse_number": "३३", "content_sanskrit": "आसीदभ्यधिका साऽपि श्रीः श्रियं प्रमुमुक्षतः ।\nनिर्वाणकाले दीपस्य वर्तीमिव दिधक्षतः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2139670, "chapter_id": 4017, "verse_number": "३४", "content_sanskrit": "श्रुतसम्प्रत्ययस्तत्र कीचकोऽपि समागमे ।\nनाजानात् पतनं स्वस्य चिन्तयन् स शुभाननाम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2139671, "chapter_id": 4017, "verse_number": "३५", "content_sanskrit": "ततस्तु द्रौपदी गत्वा भीमसेनं महानसे ।\nउपातिष्ठत कल्याणी कौरव्यं पतिमन्तिकात्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2139672, "chapter_id": 4017, "verse_number": "३६", "content_sanskrit": "तमुवाच सुकेशान्ता कीचकस्य कृतो मया ।\nसङ्केतो नर्तनागारे यथा चोक्तं नरर्षभ\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2139673, "chapter_id": 4017, "verse_number": "३७", "content_sanskrit": "कालेन नियतं बद्धः कामेन च बलात्कृतः ।\nशून्यं स नर्तनागारमागमिष्यति सूतजः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2139674, "chapter_id": 4017, "verse_number": "३८", "content_sanskrit": "एको निशि महाबाहो कीचकं तं निषूदय\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2139675, "chapter_id": 4017, "verse_number": "३९", "content_sanskrit": "तं सूतपुत्रं कौन्तेय कीचकं मददर्पितम् ।\nगत्वा तं नर्तनागारे विभिन्नं कुरु पाण्डव\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2139676, "chapter_id": 4017, "verse_number": "४०", "content_sanskrit": "गर्वितः सूतपुत्रोऽसौ गन्धर्वानवमन्यते ।\nस त्वं प्रहरतां श्रेष्ठ नालं नाग इवारुज\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2139677, "chapter_id": 4017, "verse_number": "४१", "content_sanskrit": "आस्रं दुःखाभिभूताया अपमार्जस्व पाण्डव\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2139678, "chapter_id": 4017, "verse_number": "४२", "content_sanskrit": "बाहुवीर्यानुरूपं च दर्शयाद्य पराक्रमम् ।\nआत्मनश्चैव भद्रं ते कुरु मानं कुलस्य च\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2139679, "chapter_id": 4017, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2139680, "chapter_id": 4017, "verse_number": "४३", "content_sanskrit": "स्वागतं ते सुकेशान्ते यन्मां वेदयसि प्रियम् ।\nन ह्यन्यं कञ्चिदिच्छामि सहायं वरवर्णिनि\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2139681, "chapter_id": 4017, "verse_number": "४४", "content_sanskrit": "सा मे प्रीतिस्त्वयाऽऽख्याता कीचकस्य समागमे ।\nहत्वा हिडिम्बं या प्रीतिः सा ममासीच्छुचिस्मिते\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2139682, "chapter_id": 4017, "verse_number": "४५", "content_sanskrit": "सत्यं भ्रातॄन् सपुत्रांश्च पुरस्कृत्य शपामि ते ।\nअहं भद्रे हनिष्यामि वृत्रं देवेश्वरो यथा\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2139683, "chapter_id": 4017, "verse_number": "४६", "content_sanskrit": "कीचकं निहनिष्यामि वृत्रं देवपतिर्यथा\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2139684, "chapter_id": 4017, "verse_number": "४७", "content_sanskrit": "प्रसँह्य सूदयिष्यामि केशवः केशिनं यथा ।\nरहस्यं वा प्रकाशं वा सूदयिष्यामि कीचकम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2139685, "chapter_id": 4017, "verse_number": "४८", "content_sanskrit": "यस्त्वां कामाभिभूतात्मा दुर्लभामभिमन्यते\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2139686, "chapter_id": 4017, "verse_number": "४९", "content_sanskrit": "अथ चेदनुबुध्यन्ति सूतपुत्रं मया हतम् ।\nनिर्मनुष्यं करिष्यामि मत्स्यानामिममालयम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2139687, "chapter_id": 4017, "verse_number": "५०", "content_sanskrit": "मया हतांश्चेन्मात्स्यांस्तु धार्तराष्ट्रोऽनुबुध्यते\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2139688, "chapter_id": 4017, "verse_number": "५१", "content_sanskrit": "दुर्योधनं ततो हत्वा सानुबन्धं सबान्धवम् ।\nकुरूणामखिलं राज्यं प्रतिपत्स्यामि भामिनि\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2139689, "chapter_id": 4017, "verse_number": "५२", "content_sanskrit": "नाहं चोपासितुं शक्तः कुन्तीपुत्रं युधिष्ठिरम् ।\nकामं सत्यमुपासीत कुन्तीपुत्रो युधिष्ठिरः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2139690, "chapter_id": 4017, "verse_number": "५३", "content_sanskrit": "काममन्ये ह्युपासन्तु विनीतं धर्मचारिणम् ।\nत्वां तु दुःखमिदं प्राप्तां नाहं शक्नोम्युपेक्षितुम्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2139691, "chapter_id": 4017, "verse_number": "५४", "content_sanskrit": "निर्वृता भव पाञ्चालि कीचकस्य वधात् पुनः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2139692, "chapter_id": 4017, "verse_number": "", "content_sanskrit": "द्रौपदी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2139693, "chapter_id": 4017, "verse_number": "५५", "content_sanskrit": "कीचकस्य वधं भीम यदि जानन्ति नागराः ।\nत्वया कृतं महाबाहो नाहं जीवितुमुत्सहे\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2139694, "chapter_id": 4017, "verse_number": "५६", "content_sanskrit": "कथं वधमुपानीयां राजाऽयं मत्कृते प्रभो ।\nनिगृह्णंस्तं तथा भीम कीचकं विनिपातय\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2139695, "chapter_id": 4017, "verse_number": "५७", "content_sanskrit": "यथा न कश्चिज्जानीते सूतपुत्रं त्वया हतम् ।\nतथा कुरुष्व कौरव्य बलवन्नरिमर्दन\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2139696, "chapter_id": 4017, "verse_number": "५८", "content_sanskrit": "अदृश्यमानस्त्वं तस्य भिन्धि प्राणानरिन्दम\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2139697, "chapter_id": 4017, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2139698, "chapter_id": 4017, "verse_number": "५९", "content_sanskrit": "तथा भद्रे करिष्यामि यथा त्वं भीरु भाषसे ।\nअदृश्यमानस्तस्याहं तमिस्रायां सकुण्डलम्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2139699, "chapter_id": 4017, "verse_number": "६०", "content_sanskrit": "नागो बिल्वमिवाक्रम्य पोथयिष्यामि तच्छिरः ।\nअलभ्यामिच्छतस्तस्य कीचकस्य दुरात्मनः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2139700, "chapter_id": 4017, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2139701, "chapter_id": 4017, "verse_number": "६१", "content_sanskrit": "एवमुक्त्वा महाबाहुस्तत्र पाण्डवनन्दनः ।\nअर्धरात्रे तदोत्थाय सत्ववान् भीमविक्रमः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2139702, "chapter_id": 4017, "verse_number": "६२", "content_sanskrit": "अवदातेन मृदुना पटेनाच्छादितस्तथा ।\nद्रौपदीं पृष्ठतः कृत्वा यत्रासीन्नर्तनालयः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2139703, "chapter_id": 4017, "verse_number": "६३", "content_sanskrit": "स भीमः प्रथमं गत्वा तमिस्रायामुपाविशत् ।\nमृगं सिंह इवादृश्यः प्रत्यवेक्षत कीचकम्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2139704, "chapter_id": 4017, "verse_number": "६४", "content_sanskrit": "कीचकस्तु शिरःस्नातो निशायां समलङ्कृतः ।\nसङ्केतमगमत् तूर्णं शून्यागारमपावृतम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2139705, "chapter_id": 4017, "verse_number": "६५", "content_sanskrit": "तमेव नर्तनागारं पाञ्चाली यमभाषत ।\nतां मन्यमानः सङ्केते सैरन्ध्रीं काममोहितः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2139706, "chapter_id": 4017, "verse_number": "६६", "content_sanskrit": "प्रविश्य नर्तनागारं ततस्तं पुरुषाधमः ।\nपूर्वागतं भीमसेनं दृप्तमप्रतिमौजसम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2139707, "chapter_id": 4017, "verse_number": "६७", "content_sanskrit": "शयानं शयने तं स मृत्युं मूढः परामृशत्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2139708, "chapter_id": 4017, "verse_number": "६८", "content_sanskrit": "जाज्वल्यमानं कोपेन कृष्णाया धर्षणेन च ।\nउपसङ्गम्य चैवेनं कीचकः काममोहितः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2139709, "chapter_id": 4017, "verse_number": "६९", "content_sanskrit": "हर्षोन्मथितचित्तात्मा स्मयमानोऽभ्यभाषत\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2139710, "chapter_id": 4017, "verse_number": "७०", "content_sanskrit": "एकान्ते भीममासाद्य कीचकः कालचोदितः ।\nभीमं समुपसङ्गम्य चाभ्यभाषत दुर्मतिः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2139711, "chapter_id": 4017, "verse_number": "७१", "content_sanskrit": "प्रहितं ते मया भद्रे वहु वित्तं शुचिस्मिते ।\nत्वयि तिष्ठतु तत् सर्वं यथाऽसि स्वयमागता\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2139712, "chapter_id": 4017, "verse_number": "७२", "content_sanskrit": "यत् कृतं धनरत्नाद्यं दासीशतपरिच्छदम् ।\nरूपलावण्यसंयुक्तं रूपवद्भिरलङ्कृतम्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2139713, "chapter_id": 4017, "verse_number": "७३", "content_sanskrit": "गृहं सान्तःपुरं सुभ्रु क्रीडारतिविराजितम् ।\nतत् सर्वं त्वां समुद्दिश्य सहसाऽहमुपागतः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2139714, "chapter_id": 4017, "verse_number": "७४", "content_sanskrit": "नाकस्मान्मां प्रशंसन्ति सदा गृहगताः स्त्रियः ।\nबलवान् दर्शनीयश्च नान्योस्ति सदृशः पुमान्\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2139715, "chapter_id": 4017, "verse_number": "७५", "content_sanskrit": "अहं रूपेण सम्पन्नः स्नातो भूषणभूषितः ।\nनित्यमेव प्रियः स्त्रीणां सौभाग्यात् प्रियदर्शनः\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2139716, "chapter_id": 4017, "verse_number": "७६", "content_sanskrit": "रूपस्यास्य मया प्राप्तं फलं कमललोचने\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2139717, "chapter_id": 4017, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2139718, "chapter_id": 4017, "verse_number": "७७", "content_sanskrit": "दिष्ट्या त्वं दर्शनीयोऽसि दिष्ट्याऽऽत्मानं प्रशंससि\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2139719, "chapter_id": 4017, "verse_number": "७८", "content_sanskrit": "त्वयाऽपीदृग्गुणा नारी शीलरूपसमन्विता ।\nअदृष्टपूर्वा पश्येमां यतो जानासि सूतज\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2139720, "chapter_id": 4017, "verse_number": "७९", "content_sanskrit": "द्रक्ष्यसे त्वं मुहूर्तेन यथेयं स्त्री गुणान्विता ।\nउपरंस्यसि नारीषु शीघ्रं त्वं द्रष्टुमर्हसि\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2139721, "chapter_id": 4017, "verse_number": "८०", "content_sanskrit": "एवमङ्गस्य संस्पर्शो न ते दृष्टः कदाचन\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2139722, "chapter_id": 4017, "verse_number": "८१", "content_sanskrit": "अद्य त्वां भगिनी पाप कृष्यमाणं मया भुवि ।\nद्रक्ष्यत्यद्रिप्रतीकाशं सिंहेनेव महागजम्\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2139723, "chapter_id": 4017, "verse_number": "८२", "content_sanskrit": "निराबाधा त्वयि हते सैरन्ध्री विचरिष्यति ।\nसुखमेव चरिष्यन्ति सैरन्ध्य्राः पतयः सदा\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2139724, "chapter_id": 4017, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2139725, "chapter_id": 4017, "verse_number": "८३", "content_sanskrit": "इत्युक्त्वा तं महाबाहुर्भीमो भीमपराक्रमः ।\nसमुत्पत्य च कौन्तेयः प्रहस्य च नराधमम्\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2139726, "chapter_id": 4017, "verse_number": "८४", "content_sanskrit": "भीमो जग्राह केशेषु माल्यवत्सु सुगन्धिषु\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2139727, "chapter_id": 4017, "verse_number": "८५", "content_sanskrit": "गृहीत्वा कीचकं भीमो विरराज महाबलः ।\nमहावने ग्रासकामः सिंहः क्षुद्रमृगं यथा\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2139728, "chapter_id": 4017, "verse_number": "८६", "content_sanskrit": "स केशेषु परामृष्टो बलेन बलिनां वरः ।\nआक्षिप्य केशान् वेगेन बाह्वोर्जग्राह पाण्डवम्\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2139729, "chapter_id": 4017, "verse_number": "८७", "content_sanskrit": "बाहुयुद्धं तयोरासीत् क्रुद्धयोर्नरसिंहयोः ।\nवसन्ते वाशिताहेतोर्बलिनोरिव नागयोः\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2139730, "chapter_id": 4017, "verse_number": "८८", "content_sanskrit": "कीचकानां तु मुख्यस्य नराणामुत्तमस्य च\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2139731, "chapter_id": 4017, "verse_number": "८९", "content_sanskrit": "अन्योन्यमभिसंरब्धौ परस्परजयैषिणौ ।\nवालिसुग्रीवयोर्भ्रात्रोः पुरेव कपिसिंहयोः\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2139732, "chapter_id": 4017, "verse_number": "९०", "content_sanskrit": "ततः समुत्पत्य भुजौ पञ्चशीर्षाविवोरगौ ।\nनखदंष्ट्राभिरन्योन्यं घ्नतः क्रोधविषोद्धतौ\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2139733, "chapter_id": 4017, "verse_number": "९१", "content_sanskrit": "वेगेनाभिहतो भीमः कीचकेन बलीयसा ।\nस्थिरप्रतिष्ठः स रणे पदान्न चलितः पदम्\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2139734, "chapter_id": 4017, "verse_number": "९२", "content_sanskrit": "तावन्योन्यं समाश्लिष्य प्रकर्षन्तौ परस्परम् ।\nउभावपि प्रकाशेते प्रवृद्धौ वृषभाविव\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2139735, "chapter_id": 4017, "verse_number": "९३", "content_sanskrit": "तयोरासीत् सुतुमुलः सम्प्रहारः सुदारुणः ।\nनखदन्तायुधवतोः व्याघ्रयोरिव दृप्तयोः\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2139736, "chapter_id": 4017, "verse_number": "९४", "content_sanskrit": "अभिपत्याथ बाहुभ्यां प्रत्यगृह्णादमर्षितः ।\nमातङ्ग इव मातङ्गं प्रभिन्नकरटामुखम्\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2139737, "chapter_id": 4017, "verse_number": "९५", "content_sanskrit": "स चाप्येनं तदा भीमः प्रतिजग्राह वीर्यवान् ।\nतमाक्षिपत् कीचकोऽथ बलेन बलिनां वरः\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2139738, "chapter_id": 4017, "verse_number": "९६", "content_sanskrit": "तयोर्भुजविनिष्पेषादुभयोर्बलिनोस्तदा ।\nशब्दः समभवद् घोरो वेणुस्फोटसमो युधि\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2139739, "chapter_id": 4017, "verse_number": "९७", "content_sanskrit": "अथैनमाक्षिप्य बलाद् गृहमध्ये वृकोदरः ।\nधूनयामास वेगेन वायुश्चण्ड इव द्रुमम्\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2139740, "chapter_id": 4017, "verse_number": "९८", "content_sanskrit": "भीमेन च परामृष्टो दुर्बलो बलिना रणे ।\nव्य(प्रा)स्पन्दत यथाप्राणं विचकर्ष च पाण्डवम्\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2139741, "chapter_id": 4017, "verse_number": "९९", "content_sanskrit": "ईषदागलितं चातिक्रोधाच्चलपदं स्थितम् ।\nकीचको बलवान् भीमं जानुभ्यां पातयद् भुवि\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2139742, "chapter_id": 4017, "verse_number": "१००", "content_sanskrit": "पातितो भीमसेनस्तु कीचकेन बलीयसा ।\nउत्पपाताथ वेगेन दण्डाहत इवोरगः\t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2139743, "chapter_id": 4017, "verse_number": "१०१", "content_sanskrit": "स्पर्धया च बलोन्मत्तौ तावुभौ भीमकीचकौ ।\nनिःशब्दं पर्यकर्षेतामन्योन्यस्य विनिर्जये\t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2139744, "chapter_id": 4017, "verse_number": "१०२", "content_sanskrit": "ततस्तद् भवनश्रेष्ठं प्राकम्पत तदा भृशम् ।\nतौ क्रोधवशमापन्नावन्योन्यमभिजघ्नतुः\t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2139745, "chapter_id": 4017, "verse_number": "१०३", "content_sanskrit": "तळाभ्यां भीमसेनेन वक्षस्यभिहतो भृशम् ।\nकीचको रोषताम्राक्षो न चचाल पदात् पदम्\t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2139746, "chapter_id": 4017, "verse_number": "१०४", "content_sanskrit": "मुहूर्तमशकत् सोढुं वेगं तस्य महात्मनः ।\nकीचको भीमसेनस्य पश्चात् पश्चात् तु हीयते\t॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2139747, "chapter_id": 4017, "verse_number": "१०५", "content_sanskrit": "तं हीयमानं विज्ञाय भीमसेनो महाबली ।\nवक्षस्यानीय वेगेन प्रममाथ विचेतसम्\t॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2139748, "chapter_id": 4017, "verse_number": "१०६", "content_sanskrit": "क्रोधाविष्टो विनिःश्वस्य पुनश्चैनं वृकोदरः ।\nजग्राह जयतां श्रेष्ठः केशेष्वेव भृशं तदा\t॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2139749, "chapter_id": 4017, "verse_number": "१०७", "content_sanskrit": "गृहीत्वा कीचकं भीमो विरराज महाबलः ।\nआमिषार्थे गृहीत्वेव शार्दूलो मृगयूथपम्\t॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2139750, "chapter_id": 4017, "verse_number": "१०८", "content_sanskrit": "पुनश्चातिबलस्तत्र कीचको बलदर्पितः ।\nव्यायच्छन्नेव दुर्धर्षः पाण्डवेन यशस्विना\t॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2139751, "chapter_id": 4017, "verse_number": "१०९", "content_sanskrit": "मुष्टिना भीमसेनेन शिरस्यभिहतो भृशम्\t॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2139752, "chapter_id": 4017, "verse_number": "११०", "content_sanskrit": "तत एनं परिश्रान्तमुपलभ्य वृकोदरः ।\nयोक्त्रयामास बाहुभ्यां पशुं रशनया यथा\t॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2139753, "chapter_id": 4017, "verse_number": "१११", "content_sanskrit": "नदन्तं च महानादं भिन्नभेरीसमस्वनम् ।\nभ्रामयामास सुचिरं विष्फुरन्तमचेतसम्\t॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2139754, "chapter_id": 4017, "verse_number": "११२", "content_sanskrit": "प्रगृह्य तरसा दोर्भ्यां कण्ठं तस्य वृकोदरः ।\nअपीडयत कृष्णायास्तदा कोपोपशान्तये\t॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2139755, "chapter_id": 4017, "verse_number": "११३", "content_sanskrit": "अथ तं भग्नसर्वाङ्गं व्याविद्धनयनाम्बरम् ।\nआक्रम्य च कटीदेशे जानुना कीचकाधमम्\t॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2139756, "chapter_id": 4017, "verse_number": "११४", "content_sanskrit": "अपीडयत बाहुभ्यां पशुमारममारयत् ।\nतं विषीदन्तमाज्ञाय कीचकं पाण्डुनन्दनः\t॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2139757, "chapter_id": 4017, "verse_number": "११५", "content_sanskrit": "भूतळे भ्रामयामास वाक्यं चेदमुवाच ह\t॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2139758, "chapter_id": 4017, "verse_number": "११६", "content_sanskrit": "अद्याहमनृणो भूत्वा भ्रातुर्भार्यापहारिणम् ।\nशान्तिं लब्धास्मि परमां हत्वा सैरन्ध्रिकण्टकम्\t॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2139759, "chapter_id": 4017, "verse_number": "", "content_sanskrit": "इत्येवमुक्त्वा पुरुषप्रवीरः तं कीचकं क्रोधसरागनेत्रः ।\nआस्रस्तवस्त्राभरणं स्फुरन्तमुद्भ्रान्तचित्तं व्यसुमुत्ससर्ज\t॥११७", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2139760, "chapter_id": 4017, "verse_number": "११८", "content_sanskrit": "तस्य पादौ च पाणी च शिरोग्रीवं सकुण्डलम् ।\nकाये निवेशयामास मृदित्वाऽङ्गानि सर्वशः\t॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2139761, "chapter_id": 4017, "verse_number": "११९", "content_sanskrit": "स तं मथितसर्वाङ्गं मांसपिण्डमिवाकरोत्\t॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2139762, "chapter_id": 4017, "verse_number": "१२०", "content_sanskrit": "तत्राग्निं स्वयमुज्ज्वाल्य दर्शयामास कीचकम् ।\nकृष्णां प्रोवाच भीमस्तु पश्येमं सुभ्रु कामुकम्\t॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2139763, "chapter_id": 4017, "verse_number": "१२१", "content_sanskrit": "उवाच च महातेजा द्रौपदीं पाण्डुनन्दनः\t॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2139764, "chapter_id": 4017, "verse_number": "१२२", "content_sanskrit": "पश्यैनमेहि पाञ्चालि कीचकोऽयं यथाकृतः\t॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2139765, "chapter_id": 4017, "verse_number": "१२३", "content_sanskrit": "प्रार्थयन्ते सुकेशान्ते ये त्वां शीलगुणान्विताम् ।\nएवं स्वप्स्यन्ति ते भीरु शेतेऽयं कीचको यथा\t॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2139766, "chapter_id": 4017, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2139767, "chapter_id": 4017, "verse_number": "१२४", "content_sanskrit": "तथा स कीचकं हत्वा गत्वा रोषस्य निष्कृतिम् ।\nआमन्त्र्य द्रौपदीं पश्चात् क्षिप्रमायान् महानसम्\t॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2139768, "chapter_id": 4017, "verse_number": "१२५", "content_sanskrit": "स्नात्वाऽनुलेपनं कृत्वा प्रपूर्य च मनोरथम् ।\nसुखोपविष्टः शयने भीमो भीमपराक्रमः\t॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2139769, "chapter_id": 4017, "verse_number": "१२६", "content_sanskrit": "ततः कृष्णा यदा मेने गतं भीमं महानसे ।\nकीचकं घातयित्वा च द्रौपदी योषितां वरा\t॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 2139770, "chapter_id": 4017, "verse_number": "१२७", "content_sanskrit": "प्रहृष्टा गतसन्त्रासा सभापालानुवाच ह\t॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 2139771, "chapter_id": 4017, "verse_number": "१२८", "content_sanskrit": "कीचकोऽयं हतः शेते गन्धर्वैः पतिभिर्मम ।\nपरस्त्रीकामसन्तप्तं तदागच्छत पश्यत\t॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 2139772, "chapter_id": 4017, "verse_number": "१२९", "content_sanskrit": "तच्छ्रुत्वा भाषितं तस्या नर्तनागाररक्षिणः ।\nसहसैव तदा जग्मुरुल्कामादाय सर्वशः\t॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 2139773, "chapter_id": 4017, "verse_number": "१३०", "content_sanskrit": "तस्य तं निनदं श्रुत्वा कीचकस्य सहोदराः ।\nततो गत्वाऽथ तद्वेश्म कीचकं विनिपातितम्\t॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 2139774, "chapter_id": 4017, "verse_number": "१३१", "content_sanskrit": "गतासुं ददृशुर्भूमौ रुधिरेण समुक्षितम्\t॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 2139775, "chapter_id": 4017, "verse_number": "१३२", "content_sanskrit": "पाणिपादशिरोहीनं दृष्ट्वा ते विस्मयं गताः\t॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 2139776, "chapter_id": 4017, "verse_number": "१३३", "content_sanskrit": "क्वास्य ग्रीवा क्व चरणौ क्व पाणी क शिरः क्व दृक् ।\nइति तं सुपरीक्षन्ते गन्धर्वेण हतं तदा\t॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 2139777, "chapter_id": 4017, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि पञ्चविंशोऽध्यायः ॥२५॥ कीचकवधपर्वणि दशमोऽध्यायः ॥१०॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}]