[{"id": 900005826, "chapter_id": 8462, "verse_number": "43.1", "content_sanskrit": "ॐ तदधीनत्वादर्थवत् ॐ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900005827, "chapter_id": 8462, "verse_number": "43.2", "content_sanskrit": "शब्दा ब्रह्माणि वर्तन्ते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900005828, "chapter_id": 8462, "verse_number": "43.3", "content_sanskrit": "राज्ञि यद्वत्पराजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900005829, "chapter_id": 8462, "verse_number": "43.4", "content_sanskrit": "स्वातन्त्र्यं तद्गतत्वं च शब्दवृत्तेर्हि कारणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900005830, "chapter_id": 8462, "verse_number": "43.5", "content_sanskrit": "स्वातन्त्र्यं तत्र मुख्यं स्यात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900005831, "chapter_id": 8462, "verse_number": "43.6", "content_sanskrit": "कुतो राज्ञि जयोऽन्यथा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900005832, "chapter_id": 8462, "verse_number": "43.7", "content_sanskrit": "न हि भृत्यस्य विजयिशब्दस्तावत्प्रयुज्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900005833, "chapter_id": 8462, "verse_number": "43.8", "content_sanskrit": "भृत्यबन्धादिकं राज्ञि राज्ञो बन्धादियोग्यतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900005834, "chapter_id": 8462, "verse_number": "43.9", "content_sanskrit": "अमङ्गलत्वाच्छब्दानां राज्ञो योगादमङ्गले", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900005835, "chapter_id": 8462, "verse_number": "43.10", "content_sanskrit": "गुणास्तु तादृश यत्र प्रयुज्यन्तेऽखिला अपि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900005836, "chapter_id": 8462, "verse_number": "43.11", "content_sanskrit": "अतो दोषातिदूरत्वात्संशयस्याप्यसम्भवात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900005837, "chapter_id": 8462, "verse_number": "43.12", "content_sanskrit": "वासुदेवश्रुतिश्चाह नैव विष्णावमङ्गलम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]