[{"id": 900000591, "chapter_id": 8173, "verse_number": "4.1", "content_sanskrit": "समन्वयाविरोधाभ्यां सिद्धे वस्तुनि साधने", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900000592, "chapter_id": 8173, "verse_number": "4.2", "content_sanskrit": "देवानां च मनुष्याणामेतावत्सममेव हि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900000593, "chapter_id": 8173, "verse_number": "4.3", "content_sanskrit": "उत्क्रान्तमार्गश्च विमुक्तगम्यं पादोदितं सुक्रमविक्रमौ च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900000594, "chapter_id": 8173, "verse_number": "4.4", "content_sanskrit": "अतिक्रमोक्तिः कृतिरर्थलाभः परागतिः पारगतिस्तदोकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]