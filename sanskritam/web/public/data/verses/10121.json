[{"id": 6000121000, "chapter_id": 10121, "verse_number": null, "content_sanskrit": "अथ द्वितीयाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000121001, "chapter_id": 10121, "verse_number": null, "content_sanskrit": "बादरायणिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.001.m4a", "display_order": 2}, {"id": 6000121002, "chapter_id": 10121, "verse_number": "६-२-१", "content_sanskrit": "एतत्ते भगवद्दूता यमदूताभिभाषितम्।\nउपधार्याथ तान् राजन् प्रत्याहुर्नयकोविदाः॥ ६/२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.002.m4a", "display_order": 3, "topics": [{"text": "विष्णुदूतैर्यमदूतान्प्रति अजामिलेन मरणकाले नारायणनाम्नो यदृच्छयोच्चरितत्वेऽपि तस्य सकलदुरितनिर्मुक्तत्वकथनपूर्वकं तस्य याम्यपाशान्निर्मोचनम्", "range": "१–२६"}]}, {"id": 6000121003, "chapter_id": 10121, "verse_number": null, "content_sanskrit": "विष्णुदूता ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.003.m4a", "display_order": 4}, {"id": 6000121004, "chapter_id": 10121, "verse_number": "६-२-२", "content_sanskrit": "अहो कष्टं धर्मदृशामधर्मः स्पृशते सताम्।\nयत्रादण्ड्येष्वपापेषु दण्डो यैर्ध्रियते वृथा॥ ६/२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.004.m4a", "display_order": 5}, {"id": 6000121005, "chapter_id": 10121, "verse_number": "६-२-३", "content_sanskrit": "प्रजानां पितरो ये च शास्तारः साधवः समाः।\nयदि स्यात्तेषु वैषम्यं कं यान्ति शरणं प्रजाः॥ ६/२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.005.m4a", "display_order": 6}, {"id": 6000121006, "chapter_id": 10121, "verse_number": "६-२-४", "content_sanskrit": "यद्यदाचरति श्रेयानितरस्तत्तदीहते।\nस यत्प्रमाणं कुरुते लोकस्तदनुवर्तते॥ ६/२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.006.m4a", "display_order": 7}, {"id": 6000121007, "chapter_id": 10121, "verse_number": "६-२-५", "content_sanskrit": "यस्याङ्के शिर आधाय लोकः स्वपिति निर्वृतः।\nस्वयं धर्ममधर्मं वा न हि वेद यथा पशुः॥ ६/२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.007.m4a", "display_order": 8}, {"id": 6000121008, "chapter_id": 10121, "verse_number": "६-२-६", "content_sanskrit": "स कथं ह्यर्पितात्मानं कृतमैत्रमचेतनम्।\nविस्रम्भणीयो भूतानां सघृणो द्रोग्धुमर्हति॥ ६/२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.008.m4a", "display_order": 9}, {"id": 6000121009, "chapter_id": 10121, "verse_number": "६-२-७", "content_sanskrit": "अयं हि कृतनिर्वेशो जन्मकोट्यहंसामपि।\nयद्व्याजहार विवशो नाम स्वस्त्ययनं हरेः॥ ६/२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.009.m4a", "display_order": 10}, {"id": 6000121010, "chapter_id": 10121, "verse_number": "६-२-८", "content_sanskrit": "एतेनैव ह्यघो नोऽस्य कृतं स्यादघनिष्कृतम्।\nयदा नारायण इति जगाद चतुरक्षरम्॥ ६/२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.010.m4a", "display_order": 11}, {"id": 6000121011, "chapter_id": 10121, "verse_number": "६-२-९", "content_sanskrit": "स्तेनः सुरापो मित्रध्रुग् ब्रह्महा गुरुतल्पगः।\nस्‍त्रीराजपितृगोहन्ता ये च पातकिनोऽपरे॥ ६/२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.011.m4a", "display_order": 12}, {"id": 6000121012, "chapter_id": 10121, "verse_number": "६-२-१०", "content_sanskrit": "सर्वेषामप्यघवतामिदमेव सुनिष्कृतम्।\nनामव्याहरणं विष्णोर्यतस्तद्विषया मतिः॥ ६/२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.012.m4a", "display_order": 13}, {"id": 6000121013, "chapter_id": 10121, "verse_number": "६-२-११", "content_sanskrit": "न निष्कृतैरुदितैर्ब्रह्मवादिभिस्तथा विशुध्यत्यघवान् व्रतादिभिः।\nयथा हरेर्नामपदैरुदाहृतैस्तदुत्तमश्लोकगुणोपलम्भकम्॥ ६/२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.013.m4a", "display_order": 14}, {"id": 6000121014, "chapter_id": 10121, "verse_number": "६-२-१२", "content_sanskrit": "नैकान्तिकं तद्धि कृतेऽपि निष्कृते मनः पुनर्धावति चेदसत्पथे।\nतत्कर्मनिर्हारमभीप्सतां हरेर्गुणानुवादः खलु सत्त्वभावनः॥ ६/२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.014.m4a", "display_order": 15}, {"id": 6000121015, "chapter_id": 10121, "verse_number": "६-२-१३", "content_sanskrit": "अथैनं माऽपनयत कृताशेषाघनिष्कृतम्।\nयदसौ भगवन्नाम म्रियमाणः समग्रहीत्॥ ६/२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.015.m4a", "display_order": 16}, {"id": 6000121016, "chapter_id": 10121, "verse_number": "६-२-१४", "content_sanskrit": "साङ्केत्यं पारिहास्यं वा स्तोभं हेलनमेव वा।\nवैकुण्ठनामग्रहणम् अशेषाघहरं विदुः॥ ६/२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.016.m4a", "display_order": 17}, {"id": 6000121017, "chapter_id": 10121, "verse_number": "६-२-१५", "content_sanskrit": "पतितः स्खलितो भग्नः सन्दष्टस्तप्त आहतः।\nहरिरित्यवशेनाह पुमान्नार्हति यातनाम्॥ ६/२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.017.m4a", "display_order": 18}, {"id": 6000121018, "chapter_id": 10121, "verse_number": "६-२-१६", "content_sanskrit": "गुरूणां च लघूनां च गुरूणि च लघूनि च।\nप्रायश्चित्तानि पापानां ज्ञात्वोक्तानि महर्षिभिः॥ ६/२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.018.m4a", "display_order": 19}, {"id": 6000121019, "chapter_id": 10121, "verse_number": "६-२-१७", "content_sanskrit": "तैस्तान्यघानि पूयन्ते तपोदानव्रतादिभिः।\nनाधर्मबीजं हृदयं तदपीशाङ्घ्रिसेवया॥ ६/२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.019.m4a", "display_order": 20}, {"id": 6000121020, "chapter_id": 10121, "verse_number": "६-२-१८", "content_sanskrit": "धर्मो योऽयमुपन्यस्तः परमस्तु सनातनः।\nक्रियतेऽहरहः शुद्धिरात्मनो वाससो यथा॥ ६/२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.020.m4a", "display_order": 21}, {"id": 6000121021, "chapter_id": 10121, "verse_number": "६-२-१९", "content_sanskrit": "नैकान्तशुद्धिः स्यात् कर्तुः क्रिययाऽकर्तृता यतः।\nअकर्तुरात्मनस्तस्माद्भजेतानीहया हरिम्॥ ६/२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.021.m4a", "display_order": 22}, {"id": 6000121022, "chapter_id": 10121, "verse_number": "६-२-२०", "content_sanskrit": "अज्ञानादथवा ज्ञानादुत्तमश्लोकनाम यत्।\nसङ्कीर्तितमघं पुंसो दहत्येधो यथाऽनलः॥ ६/२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.022.m4a", "display_order": 23}, {"id": 6000121023, "chapter_id": 10121, "verse_number": "६-२-२१", "content_sanskrit": "यथाऽगदं वीर्ययुतं सूपयुक्तं यदृच्छया।\nअजानतोऽप्यात्मगुणं कुर्यान्मन्त्रोऽप्युदाहृतः॥ ६/२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.023.m4a", "display_order": 24}, {"id": 6000121024, "chapter_id": 10121, "verse_number": "६-२-२२", "content_sanskrit": "पतिं वः पृच्छत भटा धर्मेऽस्मिन् यदि संशयः।\nस वेद परमं गुह्यं धर्मस्य भगवान् यमः॥ ६/२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.024.m4a", "display_order": 25}, {"id": 6000121025, "chapter_id": 10121, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.025.m4a", "display_order": 26}, {"id": 6000121026, "chapter_id": 10121, "verse_number": "६-२-२३", "content_sanskrit": "एवं ते सुविनिर्णीय धर्मं भागवतं नृप।\nतं याम्यपाशान्निर्मुच्य विप्रं मृत्योरमूमुचन्॥ ६/२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.026.m4a", "display_order": 27}, {"id": 6000121027, "chapter_id": 10121, "verse_number": "६-२-२४", "content_sanskrit": "इति प्रत्युदिता याम्या दूता याता यमान्तिकम्।\nयमराज्ञे यथा सर्वमाचचख्युररिन्दम॥ ६/२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.027.m4a", "display_order": 28}, {"id": 6000121028, "chapter_id": 10121, "verse_number": "६-२-२५", "content_sanskrit": "द्विजः पाशाद्विनिर्मुक्तो गतभीः प्रकृतिं गतः।\nववन्दे शिरसा विष्णोः किङ्करान्दर्शनोत्सवः॥ ६/२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.028.m4a", "display_order": 29}, {"id": 6000121029, "chapter_id": 10121, "verse_number": "६-२-२६", "content_sanskrit": "तं विवक्षुमभिप्रेत्य महापुरुषकिङ्कराः।\nसहसा पश्यतस्तस्य तन्त्रान्तर्दधिरेऽनघ॥ ६/२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.029.m4a", "display_order": 30}, {"id": 6000121030, "chapter_id": 10121, "verse_number": "६-२-२७", "content_sanskrit": "अथाजामिल आकर्ण्य दूतानां यमकृष्णयोः।\nधर्मं भागवतं शुद्धं त्रैविद्यं च गुणाश्रयम्॥ ६/२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.030.m4a", "display_order": 31, "topics": [{"text": "ततो जातानुतापेनाजामिलेन गङ्गाद्वारे तपस्तप्त्वा योगेन तनुत्यागः", "range": "२७–४४"}]}, {"id": 6000121031, "chapter_id": 10121, "verse_number": "६-२-२८", "content_sanskrit": "भक्तिमान् भगवत्याशु माहात्म्यश्रवणाद्धरेः।\nअनुतापो महानासीत् स्मरतोऽशुभमात्मनः॥ ६/२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.031.m4a", "display_order": 32}, {"id": 6000121032, "chapter_id": 10121, "verse_number": "६-२-२९", "content_sanskrit": "अहो मे परमं कष्टमभूदविजितात्मनः।\nयेन विप्लावितं ब्रह्म वृषल्यां जायताऽऽत्मना॥ ६/२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.032.m4a", "display_order": 33}, {"id": 6000121033, "chapter_id": 10121, "verse_number": "६-२-३०", "content_sanskrit": "धिङ्मां विगर्हितं सद्भिर्दुष्कृतं कुलकज्जलम्।\nहित्वा बालां सतीं योऽहं सुरापामसतीमगाम्॥ ६/२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.033.m4a", "display_order": 34}, {"id": 6000121034, "chapter_id": 10121, "verse_number": "६-२-३१", "content_sanskrit": "वृद्धावनाथौ पितरौ नान्यबन्धू तपस्विनौ।\nअहो मयाऽधुना त्यक्तावकृतज्ञेन नीचवत्॥ ६/२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.034.m4a", "display_order": 35}, {"id": 6000121035, "chapter_id": 10121, "verse_number": "६-२-३२", "content_sanskrit": "सोऽहं व्यक्तं पतिष्यामि नरके भृशदारुणे।\nधर्मघ्नाः कामिनो यत्र विन्दन्ति यमयातनाः॥ ६/२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.035.m4a", "display_order": 36}, {"id": 6000121036, "chapter_id": 10121, "verse_number": "६-२-३३", "content_sanskrit": "किमिदं स्वप्नमाहोस्वित् साक्षाद् दृष्टमिहाद्भुतम्।\nक्‍व याता अद्य ते ये मां व्यकर्षन् पाशपाणयः॥ ६/२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.036.m4a", "display_order": 37}, {"id": 6000121037, "chapter_id": 10121, "verse_number": "६-२-३४", "content_sanskrit": "अथ ते क्‍व गताः सिद्धाश्चत्वारश्चारुदर्शनाः।\nव्यमोचयन् नीयमानं बद्‌ध्वा पाशैरधोभुवः॥ ६/२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.037.m4a", "display_order": 38}, {"id": 6000121038, "chapter_id": 10121, "verse_number": "६-२-३५", "content_sanskrit": "अथापि मे दुर्भगस्य विबुधोत्तमदर्शने।\nभवितव्यं मङ्गलेन येनात्मा मे प्रसीदति॥ ६/२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.038.m4a", "display_order": 39}, {"id": 6000121039, "chapter_id": 10121, "verse_number": "६-२-३६", "content_sanskrit": "अन्यथा म्रियमाणस्य नाशुचेर्वृषलीपतेः।\nवैकुण्ठनामग्रहणं जिह्वा वक्तुमिहार्हति॥ ६/२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.039.m4a", "display_order": 40}, {"id": 6000121040, "chapter_id": 10121, "verse_number": "६-२-३७", "content_sanskrit": "क्‍व चाहं कितवः पापो ब्रह्मोज्झो निरपत्रपः।\nक्‍व च नारायणेत्येतद्भगवन्नाम मङ्गलम्॥ ६/२/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.040.m4a", "display_order": 41}, {"id": 6000121041, "chapter_id": 10121, "verse_number": "६-२-३८", "content_sanskrit": "सोऽहं तथा यतिष्यामि यतचित्तेन्द्रियानिलः।\nयथा न भूय आत्मानमन्धे तमसि मज्जये॥ ६/२/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.041.m4a", "display_order": 42}, {"id": 6000121042, "chapter_id": 10121, "verse_number": "६-२-३९", "content_sanskrit": "विमुच्य तमिमं बन्धमविद्याकामकर्मजम्।\nसर्वभूतसुहृद्दान्तो मैत्रः करुण आत्मवान्॥ ६/२/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.042.m4a", "display_order": 43}, {"id": 6000121043, "chapter_id": 10121, "verse_number": "६-२-४०", "content_sanskrit": "मोचये ग्रस्तमात्मानं योषिन्मय्याऽऽत्ममायया।\nविक्रीडितो यथैवाहं क्रीडामृग इवाधमः॥ ६/२/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.043.m4a", "display_order": 44}, {"id": 6000121044, "chapter_id": 10121, "verse_number": "६-२-४१", "content_sanskrit": "ममाहमिति देहादौ हित्वा मिथ्यार्थधीर्मतिम्।\nधास्ये मनो भगवति शुद्धं तत्कीर्तनादिभिः॥ ६/२/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.044.m4a", "display_order": 45}, {"id": 6000121045, "chapter_id": 10121, "verse_number": "६-२-४२", "content_sanskrit": "इति जातसुनिर्वेदः क्षणसङ्गेन साधुषु।\nगङ्गाद्वारमुपेयाय मुक्तसर्वानुबन्धनः॥ ६/२/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.045.m4a", "display_order": 46}, {"id": 6000121046, "chapter_id": 10121, "verse_number": "६-२-४३", "content_sanskrit": "स तस्मिन् देवसदन आसीनो योगमास्थितः।\nप्रत्याहृतेन्द्रियग्रामो युयोज मन आत्मनि॥ ६/२/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.046.m4a", "display_order": 47}, {"id": 6000121047, "chapter_id": 10121, "verse_number": "६-२-४४", "content_sanskrit": "ततो गुणेभ्य आत्मानं वियुज्यात्मसमाधिना।\nयुयुजे भगवद्धाम्नि ब्रह्मण्यनुभवात्मनि॥ ६/२/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.047.m4a", "display_order": 48}, {"id": 6000121048, "chapter_id": 10121, "verse_number": "६-२-४५", "content_sanskrit": "यर्ह्युपारतधीस्तस्मिन्नद्राक्षीत् पुरुषान् पुरः।\nउपलभ्योपलब्धान् प्राग् ववन्दे शिरसा द्विजः॥ ६/२/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.048.m4a", "display_order": 49, "topics": [{"text": "पुनर्विष्णुदूतैर्विमानमारोप्य तस्य विष्णुलोकप्रापणम्", "range": "४५–५२"}]}, {"id": 6000121049, "chapter_id": 10121, "verse_number": "६-२-४६", "content_sanskrit": "हित्वा कलेवरं तीर्थे गङ्गायां दर्शनादनु।\nसद्यः स्वरूपं जगृहे भगवत्पार्श्ववर्तिनाम्॥ ६/२/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.049.m4a", "display_order": 50}, {"id": 6000121050, "chapter_id": 10121, "verse_number": "६-२-४७", "content_sanskrit": "साकं विहायसा विप्रो महापुरुषकिङ्करैः।\nहैमं विमानमारुह्य ययौ यत्र श्रियः पतिः॥ ६/२/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.050.m4a", "display_order": 51}, {"id": 6000121051, "chapter_id": 10121, "verse_number": "६-२-४८", "content_sanskrit": "एवं स विप्लावितसर्वधर्मो दास्याः पतिः पतितो गर्ह्यकर्मा।\nनिपात्यमानो निरये हतव्रतः सद्यो विमुक्तो भगवन्नाम गृह्णन्॥ ६/२/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.051.m4a", "display_order": 52}, {"id": 6000121052, "chapter_id": 10121, "verse_number": "६-२-४९", "content_sanskrit": "नातः परं कर्मनिबन्धकृन्तनं मुमुक्षतां तीर्थपदानुकीर्तनात्।\nन यत् पुनः कर्मसु सज्जते मनो रजस्तमोभ्यां कलिलं न चान्यथा॥ ६/२/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.052.m4a", "display_order": 53}, {"id": 6000121053, "chapter_id": 10121, "verse_number": "६-२-५०", "content_sanskrit": "य एवं परमं गुह्यमितिहासमघापहम्।\nशृणुयाच्छ्रद्धया युक्तो यश्च भक्त्याऽनुकीर्तयेत्॥ ६/२/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.053.m4a", "display_order": 54}, {"id": 6000121054, "chapter_id": 10121, "verse_number": "६-२-५१", "content_sanskrit": "न वै स नरकं गच्छेन्नेक्षितो यमकिङ्करैः।\nयद्यप्यमङ्गलो मर्त्यो विष्णुलोके महीयते॥ ६/२/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.054.m4a", "display_order": 55}, {"id": 6000121055, "chapter_id": 10121, "verse_number": "६-२-५२", "content_sanskrit": "म्रियमाणो हरेर्नाम गृणन् पुत्रोपचारितम्।\nअजामिलोऽप्यगान्मुक्तिं किमुत श्रद्धया गृणन्॥ ६/२/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_002/BhP_06.002.055.m4a", "display_order": 56}, {"id": 6000121056, "chapter_id": 10121, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां षष्ठस्कन्धे द्वितीयाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]