[{"id": 2040065, "chapter_id": 1886, "verse_number": "५-१३१-०x", "content_sanskrit": "वैशम्पायन उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2040066, "chapter_id": 1886, "verse_number": "५-१३१-१", "content_sanskrit": "विदुरेणैवमुक्तस्तु केशवः शत्रुपूगहा ।\nदुर्योधनं धार्तराष्ट्रमभ्यभाषत वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2040067, "chapter_id": 1886, "verse_number": "५-१३१-२", "content_sanskrit": "एकोऽहमिति यन्मोहान्मन्यसे मां सुयोधन।\nपरिभूय सुदुर्बुद्धे ग्रहीतुं मां चिकीर्षसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2040068, "chapter_id": 1886, "verse_number": "५-१३१-३", "content_sanskrit": "इहैव पाण्डवाः सर्वे तथैवान्धकवृष्णयः ।\nइहादित्याश्च रुद्राश्च वसवश्च महर्षिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2040069, "chapter_id": 1886, "verse_number": "५-१३१-४", "content_sanskrit": "एवमुक्त्वा जाहासोच्चैः केशवः परवीरहा ।\nतस्य संस्मयतः शौरेर्विद्युद्रूपा महात्मनः ।\n`युगपच्च विनिष्पेतुः साक्षात्सर्वास्तु देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2040070, "chapter_id": 1886, "verse_number": "५-१३१-५", "content_sanskrit": "अङ्गुष्ठमात्रास्त्रिदशा बभूवुः पावकार्चिषः ।\nतस्य ब्रह्मा ललाटस्थो रुद्रो वक्षसि चाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2040071, "chapter_id": 1886, "verse_number": "५-१३१-६", "content_sanskrit": "लोकपाला भुजेष्वासन्नग्निरास्यादजायत।\nआदित्याश्चैव साध्याश्च वसवोऽथाश्विनावपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2040072, "chapter_id": 1886, "verse_number": "५-१३१-७", "content_sanskrit": "मरुतश्च सहेन्द्रेण विश्वेदेवास्तथैव च।\nबभूवुश्चैव यक्षाश्च गन्धर्वोरगराक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2040073, "chapter_id": 1886, "verse_number": "५-१३१-८", "content_sanskrit": "प्रादुरास्तां तथा दोर्भ्यां सङ्कर्षणधनञ्जयौ।\nदक्षिणेऽथार्जुनो धन्वी हली रामश्च सव्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2040074, "chapter_id": 1886, "verse_number": "५-१३१-९", "content_sanskrit": "भीमो युधिष्ठिरश्चैव माद्रीपुत्रौ च पृष्ठतः।\nअन्धका वृष्णयश्चैव प्रद्युम्नपरमुखास्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2040075, "chapter_id": 1886, "verse_number": "५-१३१-१०", "content_sanskrit": "अग्रे बभूवुः कृष्णस्य समुद्यतमहायुधाः ।\nशङ्खचक्रगदाशक्तिशार्ङ्गलाङ्गलनन्दकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2040076, "chapter_id": 1886, "verse_number": "५-१३१-११", "content_sanskrit": "अदृश्यन्तोद्यतान्येव सर्वप्रहरणानि च।\nनानाबाहुषु कृष्णस्य दीप्यमानानि सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2040077, "chapter_id": 1886, "verse_number": "५-१३१-१२", "content_sanskrit": "नेत्राभ्यां नासिकाभ्यां च श्रोत्राभ्यां च समन्ततः ।\nप्रादुरासन्महारौद्राः सधूमाः पावकार्चिषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2040078, "chapter_id": 1886, "verse_number": "५-१३१-१३", "content_sanskrit": "रोमकूपेषु च तथा सूर्यस्येव मरीचयः ।\n`सहस्रचरणः श्रीमाञ्शतबाहुः सहस्रदृक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2040079, "chapter_id": 1886, "verse_number": "५-१३१-१४", "content_sanskrit": "तस्य वै नागलोकश्च गुल्फाधो ददृशे तदा।\nचन्द्रसूर्यौ तथा नेत्रे ग्रहः वै सर्वतः स्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2040080, "chapter_id": 1886, "verse_number": "५-१३१-१५", "content_sanskrit": "ऊर्ध्वलोकाश्च सर्वेऽपि कुक्षौ तस्य व्यवस्थिताः ।\nसरितः सागराश्चैव स्वेदस्तस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2040081, "chapter_id": 1886, "verse_number": "५-१३१-१६", "content_sanskrit": "अस्थीनि पर्वताः सर्वे वृक्षा रोमाणि तस्य हि।\nनिमेषणं रात्र्यहनी जिह्वायां शारदा तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2040082, "chapter_id": 1886, "verse_number": "५-१३१-१७", "content_sanskrit": "तं दृष्ट्वा घोरमात्मानं केशवस्य महात्मनः ।\nन्यमीलयन्त नेत्राणि राजानस्त्रस्तचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2040083, "chapter_id": 1886, "verse_number": "५-१३१-१८", "content_sanskrit": "ऋत द्रोणं च भीष्मं च विदुरं च महामतिम् ।\nसंजयं धृतराष्ट्रं च ऋषींश्चैव तपोधनान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2040084, "chapter_id": 1886, "verse_number": "५-१३१-१९", "content_sanskrit": "प्रादात्तेषां स भगवान्दिव्यं चक्षुर्जनार्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2040085, "chapter_id": 1886, "verse_number": "५-१३१-२०", "content_sanskrit": "`धृतराष्ट्राय प्रददौ भगवान्दिव्यचक्षुषी ।\nददर्श परमं रूपं धृतराष्ट्रोऽम्बिकासुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2040086, "chapter_id": 1886, "verse_number": "५-१३१-२१", "content_sanskrit": "ततो देवाः सगन्धर्वाः किन्नराश्च महोरगाः ।\nऋषयश्च महाभागा लोकपालैः समन्विताः ।\nप्रणम्य शिरसा देवं तुष्टुवुः प्राञ्जलिस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2040087, "chapter_id": 1886, "verse_number": "५-१३१-२२", "content_sanskrit": "क्रोधं प्रभो संहर संहर स्वं\nरूपं च यद्दर्शितमात्मसंस्थम् ।\nयावत्त्विमे देवगणैः समेता\nलोकाः समस्ता भुवि नाशमीयुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2040088, "chapter_id": 1886, "verse_number": "५-१३१-२३", "content_sanskrit": "त्वं च कर्ता विकर्ता च त्वमेव परिरक्षसे।\nत्वया व्याप्तमिदं सर्वं जगत्स्थावरजङ्गमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2040089, "chapter_id": 1886, "verse_number": "५-१३१-२४", "content_sanskrit": "कियन्मात्रा महीपालाः किंवीर्याः किंपराक्रमाः ।\nतेषामर्थे महाबाहो दिव्यं रूपं प्रदर्शिवान्।\nएवमुच्चारिता वाचः सह देवार्विभुं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2040090, "chapter_id": 1886, "verse_number": "५-१३१-२५", "content_sanskrit": "तद्दृष्ट्वा महदाश्चर्यं माधवस्य सभातले।\nदेवदुन्दुभयो नेदुः पुष्पवर्षं पपात च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2040091, "chapter_id": 1886, "verse_number": "५-१३१-२६x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2040092, "chapter_id": 1886, "verse_number": "५-१३१-२६", "content_sanskrit": "त्वमेव पुण्डरीकाक्ष सर्वस्य जगतो हितः।\nतस्मान्मे यादवश्रेष्ठ प्रसादं कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2040093, "chapter_id": 1886, "verse_number": "५-१३१-२७", "content_sanskrit": "भगवन्मम नेत्राभ्यामन्तर्धानं वृणे पुनः ।\nभवन्तं दृष्टवानस्मि नान्यं द्रष्टुमिहोत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2040094, "chapter_id": 1886, "verse_number": "५-१३१-२८", "content_sanskrit": "ततोऽब्रवीन्महाबाहुर्धृतराष्ट्रं जनार्दनः ।\nअदृश्यमाने नेत्रे द्वे भवेतां कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2040095, "chapter_id": 1886, "verse_number": "५-१३१-२९", "content_sanskrit": "तत्राद्भुतं महाराज धृतराष्ट्रश्च चक्षुषी ।\nलब्धवान्वासुदेवाच्च विश्वरूपदिदृक्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2040096, "chapter_id": 1886, "verse_number": "५-१३१-३०", "content_sanskrit": "लब्धचक्षुषमासीनं धृतराष्ट्रं नराधिपाः ।\nविस्मिता ऋषिभिः सार्धं तुष्टुवुर्मधुसूदनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2040097, "chapter_id": 1886, "verse_number": "५-१३१-३१", "content_sanskrit": "चचाल च मही कृत्स्ना सागरश्चापि चुक्षुभे ।\nविस्मयं परमं जग्मुः पार्थिवा भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2040098, "chapter_id": 1886, "verse_number": "५-१३१-३२", "content_sanskrit": "ततः स पुरुषव्याघ्रः सञ्जहार वपुः स्वकम् ।\nतां दिव्यामद्भुतां चित्रामृद्धिमत्तामरिन्दमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2040099, "chapter_id": 1886, "verse_number": "५-१३१-३३", "content_sanskrit": "ततः सात्यकिमादाय पाणौ विदुरमेव च ।\nऋषिभिस्तैरनुज्ञातो निर्ययौ मधुसूदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2040100, "chapter_id": 1886, "verse_number": "५-१३१-३४", "content_sanskrit": "ऋषयोऽन्तर्हिता जग्मुस्ततस्ते नारदादयः ।\nतस्मिन्कोलाहले वृत्ते तदद्भुतमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2040101, "chapter_id": 1886, "verse_number": "५-१३१-३५", "content_sanskrit": "तं प्रस्थितमभिप्रेक्ष्य कौरवाः सह राजभिः ।\nअनुजग्मुर्नरव्याघ्रं देवा इव शतक्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2040102, "chapter_id": 1886, "verse_number": "५-१३१-३६", "content_sanskrit": "अचिन्तयन्नमेयात्मा सर्वं तद्राजमण्डलम् ।\nनिश्चक्राम ततः शौरिः सधूम इव पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2040103, "chapter_id": 1886, "verse_number": "५-१३१-३७", "content_sanskrit": "ततो रथेन शुभ्रेण महता किङ्किणीकिना ।\nहेमजालविचित्रेण लघुना मेघनादिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2040104, "chapter_id": 1886, "verse_number": "५-१३१-३८", "content_sanskrit": "सूपस्करेण शुभ्रेण वैयाघ्रेण वरूथिना ।\nशैब्यसुग्रीवयुक्तेन प्रत्यदृश्यत दारुकः ॥ ५-१३१-३९aतथैव रथमास्थाय कृतवर्मा महारथः ।\nवृष्णीनां संमतो वीरो हार्दिक्यः समदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2040105, "chapter_id": 1886, "verse_number": "५-१३१-४०", "content_sanskrit": "उपस्थितरथं शौरिं प्रयास्यन्तमरिन्दमम् ।\nधृतराष्ट्रो महाराजः पुनरेवाभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2040106, "chapter_id": 1886, "verse_number": "५-१३१-४१", "content_sanskrit": "यावद्बलं मे पुत्रेषु पश्यतस्ते जनार्दन ।\nप्रत्यक्षं ते न ते किंचित्परोक्षं शत्रुकर्शन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2040107, "chapter_id": 1886, "verse_number": "५-१३१-४२", "content_sanskrit": "कुरूणां शममिच्छन्तं यतमानं च केशव ।\nविदित्वैतामवस्थां मे नातिशङ्कितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2040108, "chapter_id": 1886, "verse_number": "५-१३१-४३", "content_sanskrit": "न मे पापोऽस्त्यभिप्रायः पाण्डवान्प्रति केशव ।\nज्ञातमेव हितं वाक्यं यन्मयोक्तः सुयोधनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2040109, "chapter_id": 1886, "verse_number": "५-१३१-४४", "content_sanskrit": "जानन्ति कुरवः सर्वे राजानश्चैव पार्थिवाः ।\nशमे प्रयतमानं मां सर्वयत्नेन माधव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2040110, "chapter_id": 1886, "verse_number": "५-१३१-४५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2040111, "chapter_id": 1886, "verse_number": "५-१३१-४५", "content_sanskrit": "ततोऽब्रवीन्महाबाहुर्धृतराष्ट्रं जनार्दनः।\nद्रोणं पितामहं भीष्मं क्षत्तारं बाह्लिकं कृपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2040112, "chapter_id": 1886, "verse_number": "५-१३१-४६", "content_sanskrit": "प्रत्यक्षमेतद्भवतां यद्वृत्तं कुरुसंसदि।\nयथा चाशिष्टवन्मन्दो रोषादद्य समुत्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2040113, "chapter_id": 1886, "verse_number": "५-१३१-४७", "content_sanskrit": "वदत्यनीशमात्मानं धृतराष्ट्रो महीपतिः ।\nआपृच्छे भवतः सर्वान्गमिष्यामि युधिष्ठिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2040114, "chapter_id": 1886, "verse_number": "५-१३१-४८", "content_sanskrit": "आमन्त्र्य प्रस्थितं शौरिं रथस्थं पुरुषर्षभ ।\nअनुजग्मुर्महेष्वासाः प्रवीरा भरतर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2040115, "chapter_id": 1886, "verse_number": "५-१३१-४९", "content_sanskrit": "भीष्मो द्रोणः कृपः क्षत्ता धृतराष्ट्रोऽथ बाह्लिकः।\nअश्वत्थामा विकर्णश्च युयुत्सुश्च महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2040116, "chapter_id": 1886, "verse_number": "५-१३१-५०", "content_sanskrit": "ततो रथेन शुभ्रेण महता किङ्किणीकिना ।\nकुरूणां पश्यतां द्रष्टुं स्वसारं स पितुर्ययौ ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2040117, "chapter_id": 1886, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानर्वणि एकत्रिंशदधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]