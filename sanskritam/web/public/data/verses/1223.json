[{"id": 2010932, "chapter_id": 1223, "verse_number": "१-२२४-०x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2010933, "chapter_id": 1223, "verse_number": "१-२२४-१", "content_sanskrit": "राजन्निःसंशयं श्रेयो वाच्यस्त्वमसि बान्धवैः।\nन त्वशुश्रूषमाणे वै वाक्यं संप्रति तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2010934, "chapter_id": 1223, "verse_number": "१-२२४-२", "content_sanskrit": "प्रियं हितं च तद्वाक्यमुक्तवान्कुरुसत्तमः।\nभीष्मः शान्तनवो राजन्प्रतिगृह्णासि तन्न च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2010935, "chapter_id": 1223, "verse_number": "१-२२४-३", "content_sanskrit": "तथा द्रोणेन बहुधा भाषितं हितमुत्तमम्।\nतच्च राधासुतः कर्णो मन्यते न हितं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2010936, "chapter_id": 1223, "verse_number": "१-२२४-४", "content_sanskrit": "चिन्तयंश्च न पश्यामि राजंस्तव सुहृत्तमम्।\nआभ्यां पुरुषसिंहाभ्यां यो वा स्यात्प्रज्ञयाधिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2010937, "chapter_id": 1223, "verse_number": "१-२२४-५", "content_sanskrit": "इमौ हि वृद्धौ वयसा प्रज्ञया च श्रुतेन च।\nसमौ च त्वयि राजेन्त्र तथा पाण्डुसुतेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2010938, "chapter_id": 1223, "verse_number": "१-२२४-६", "content_sanskrit": "धर्मे चानवरौ राजन्सत्यतायां च भारत।\nरामाद्दाशरथेश्चैव गयाच्चैव न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2010939, "chapter_id": 1223, "verse_number": "१-२२४-७", "content_sanskrit": "न चोक्तवन्तावश्रेयः पुरस्तादपि किंचन।\nन चाप्यपकृतं किंचिदनयोर्लक्ष्यते त्वयि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2010940, "chapter_id": 1223, "verse_number": "१-२२४-८", "content_sanskrit": "तावुभौ पुरुषव्याघ्रावनागसि नृपे त्वयि।\nन मन्त्रयेतां त्वच्छ्रेयः कथं सत्यपराक्रमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2010941, "chapter_id": 1223, "verse_number": "१-२२४-९", "content_sanskrit": "प्रज्ञावन्तौ नरश्रेष्ठावस्मिँल्लोके नराधिप।\nत्वन्निमित्तमतो नेमौ किंचिज्जिह्मं वदिष्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2010942, "chapter_id": 1223, "verse_number": "१-२२४-१०", "content_sanskrit": "इति मे नैष्ठिकी बुद्धिर्वर्तते कुरुनन्दन।\nन चार्थहेतोर्धर्मज्ञौ वक्ष्यतः पक्षसंश्रितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2010943, "chapter_id": 1223, "verse_number": "१-२२४-११", "content_sanskrit": "एतद्धि परमं श्रेयो मन्येऽहं तव भारत।\nदुर्योधनप्रभृतयः पुत्रा राजन्यथा तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2010944, "chapter_id": 1223, "verse_number": "१-२२४-१२", "content_sanskrit": "तथैव पाण्डवेयास्ते पुत्रा राजन्न संशयः।\nतेषु चेदहितं किंचिन्मन्त्रयेयुरतद्विदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2010945, "chapter_id": 1223, "verse_number": "१-२२४-१३", "content_sanskrit": "मन्त्रिणस्ते न च श्रेयः प्रपश्यन्ति विशेषतः।\nअथ ते हृदये राजन्विशेषः स्वेषु वर्तते।\nअन्तरस्थं विवृण्वानाः श्रेयः कुर्युर्न ते ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2010946, "chapter_id": 1223, "verse_number": "१-२२४-१४", "content_sanskrit": "एतदर्थमिमौ राजन्महात्मानौ महाद्युती।\nनोचतुर्विवृतं किंचिन्न ह्येष तव निश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2010947, "chapter_id": 1223, "verse_number": "१-२२४-१५", "content_sanskrit": "यच्चाप्यशक्यतां तेषामाहतुः पुरुषर्षभौ।\nतत्तथा पुरुषव्याघ्र तव तद्भद्रमस्तु ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2010948, "chapter_id": 1223, "verse_number": "१-२२४-१६", "content_sanskrit": "कथं हि पाण्डवः श्रीमान्सव्यसाची धनञ्जयः।\nशक्यो विजेतुं संग्रामे राजन्मघवतापि हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2010949, "chapter_id": 1223, "verse_number": "१-२२४-१७", "content_sanskrit": "भीमसेनो महाबाहुर्नागायुतबलो महान्।\nराक्षसानां भयकरो बाहुशाली महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2010950, "chapter_id": 1223, "verse_number": "१-२२४-१८", "content_sanskrit": "हिडिम्बो निहतो येन बाहुयुद्धेन भारत।\nयो रावणसमो युद्धे तथा च बकराक्षसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2010951, "chapter_id": 1223, "verse_number": "१-२२४-१९", "content_sanskrit": "स युध्यमानो राजेन्द्र भीमो भीमपराक्रमः।\nकथं स्म युधि शक्येत विजेतुममरैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2010952, "chapter_id": 1223, "verse_number": "१-२२४-२०", "content_sanskrit": "तथैव कृतिनौ युद्धे यमौ यमसुताविव।\nकथं विजेतुं शक्यौ तौ रणे जीवितुमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2010953, "chapter_id": 1223, "verse_number": "१-२२४-२१", "content_sanskrit": "यस्मिन्धृतिरनुक्रोशः क्षमा सत्यं पराक्रमः।\nनित्यानि पाण्डवे ज्येष्ठे स जीयेत रणे कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2010954, "chapter_id": 1223, "verse_number": "१-२२४-२२", "content_sanskrit": "येषां पक्षधरो रामो येषां मन्त्री जनार्दनः।\nकिं नु तैरजितं सङ्ख्ये येषां पक्षे च सात्यकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2010955, "chapter_id": 1223, "verse_number": "१-२२४-२३", "content_sanskrit": "द्रुपदः श्वशुरो येषां येषां स्यालाश्च पार्षताः।\nधृष्टद्युम्नमुखा वीरा भ्रातरो द्रुपदात्मजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2010956, "chapter_id": 1223, "verse_number": "१-२२४-२४", "content_sanskrit": "चैद्यश्च येषां भ्राता च शिशुपालो महारथः।\nसोऽशक्यतां च विज्ञाय तेषामग्रे च भारत।\nदायाद्यतां च धर्मेण सम्यक्तेषु समाचर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2010957, "chapter_id": 1223, "verse_number": "१-२२४-२५", "content_sanskrit": "इदं निर्दिष्टमयशः पुरोचनकृतं महत्।\nतेषामनुग्रहेणाद्य राजन्प्रक्षालयात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2010958, "chapter_id": 1223, "verse_number": "१-२२४-२६", "content_sanskrit": "तेषामनुग्रहश्चायं सर्वेषां चैव नः कुले।\nजीवितं च परं श्रेयः क्षत्रस्य च विवर्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2010959, "chapter_id": 1223, "verse_number": "१-२२४-२७", "content_sanskrit": "द्रुपदोऽपि महान्राजा कृतवैरश्च नः पुरा।\nतस्य संग्रहणं राजन्स्वपक्षस्य विवर्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2010960, "chapter_id": 1223, "verse_number": "१-२२४-२८", "content_sanskrit": "बलवन्तश्च दाशार्हा बहवश्च विशांपते।\nयतः कृष्णस्ततः सर्वे यतः कृष्णस्ततो जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2010961, "chapter_id": 1223, "verse_number": "१-२२४-२९", "content_sanskrit": "यच्च साम्नैव शक्येत कार्यं साधयितुं नृप।\nको दैवशप्तस्तत्कार्यं विग्रहेण समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2010962, "chapter_id": 1223, "verse_number": "१-२२४-३०", "content_sanskrit": "श्रुत्वा च जीवतः पार्थान्पौरजानपदा जनाः।\nबलवद्दर्शने हृष्टास्तेषां राजन्प्रियं कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2010963, "chapter_id": 1223, "verse_number": "१-२२४-३१", "content_sanskrit": "दुर्योधनश्च कर्णश्च शकुनिश्चापि सौबलः।\nअधर्मयुक्ता दुष्प्रज्ञा बाला मैषां वचः कृथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2010964, "chapter_id": 1223, "verse_number": "१-२२४-३२", "content_sanskrit": "उक्तमेतत्पुरा राजन्मया गुणवतस्तव।\nदुर्योधनापराधेन प्रजेयं वै विनङ्क्ष्यति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2010965, "chapter_id": 1223, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि विदुरागमनराज्यलाभपर्वणि चतुर्विंशत्यधिकद्विशततमोऽध्यायः॥ २२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]