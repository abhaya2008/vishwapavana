[{"id": 2147383, "chapter_id": 4187, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2147384, "chapter_id": 4187, "verse_number": "१", "content_sanskrit": "गालवं वैनतेयोऽथ प्रहसन्निदमब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2147385, "chapter_id": 4187, "verse_number": "२", "content_sanskrit": "दिष्ट्या कृतार्थं पश्यामि भवन्तमिह वै द्विज\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2147386, "chapter_id": 4187, "verse_number": "३", "content_sanskrit": "गालवस्तु वचःश्रुत्वा वैनतेयेन भाषितम् ।\nचतुर्भागावशिष्टं तमाचख्यौ कार्यमस्य हि\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2147387, "chapter_id": 4187, "verse_number": "४", "content_sanskrit": "सुपर्णस्त्वब्रवीदेनं गालवं पततां वरः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2147388, "chapter_id": 4187, "verse_number": "५", "content_sanskrit": "प्रयत्नस्ते न कर्तव्यो नैष सम्पत्स्यते तव\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2147389, "chapter_id": 4187, "verse_number": "६", "content_sanskrit": "पुरा हि कन्याकुब्जे वै गाधेः सत्यवतीं सुताम् ।\nभार्यार्थे वरयन् कन्याम् ऋचीकस्तेन भाषितः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2147390, "chapter_id": 4187, "verse_number": "७", "content_sanskrit": "एकतः श्यामकर्णानां हयानां चन्द्रवर्चसाम् ।\nभगवन् दीयतां मह्यं सहस्रमिति गालव\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2147391, "chapter_id": 4187, "verse_number": "८", "content_sanskrit": "ऋचीकस्तु तथेत्युक्त्वा वरुणस्यालयं गतः ।\nअश्वतीर्थे हयाँल्लब्ध्वा दत्तवान् पार्थिवाय वै\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2147392, "chapter_id": 4187, "verse_number": "९", "content_sanskrit": "इष्ट्वा ते पुण्डरीकेण दत्ता राज्ञा द्विजातिषु ।\nतेभ्यो मे द्वे शते क्रीत्वा प्राप्तास्तैः पार्थिवैस्तदा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2147393, "chapter_id": 4187, "verse_number": "१०", "content_sanskrit": "अपराण्यपि चत्वारि शतानि द्विजसत्तम ।\nनीयमानानि सन्तारे हृतान्यासन्नितस्ततः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2147394, "chapter_id": 4187, "verse_number": "११", "content_sanskrit": "एवं न शक्यमप्राप्यं प्राप्तुं गालव कर्हिचित्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2147395, "chapter_id": 4187, "verse_number": "१२", "content_sanskrit": "इमामश्वशताभ्यां वै द्वाभ्यां तस्मै निवेदय ।\nविश्वामित्राय धर्मात्मन् षड्भिरश्वशतैः सह\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2147396, "chapter_id": 4187, "verse_number": "१३", "content_sanskrit": "ततोऽसि गतसम्मोहः कृतकृत्यो द्विजोत्तम\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2147397, "chapter_id": 4187, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2147398, "chapter_id": 4187, "verse_number": "१४", "content_sanskrit": "गालवस्तं तथेत्युक्त्वा सुपर्णसहितस्ततः ।\nआदायाश्वांश्च कन्यां च विश्वामित्रमुपागमत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2147399, "chapter_id": 4187, "verse_number": "१५", "content_sanskrit": "अश्वानां काङ्क्षितार्थानां षडिमानि शतानि वै ।\nशतद्वयेन कन्येयं भवता प्रतिगृह्यताम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2147400, "chapter_id": 4187, "verse_number": "१६", "content_sanskrit": "अस्यां राजर्षिभिः पुत्रा जाता वै धार्मिकास्त्रयः ।\nचतुर्थं जनयत्वेकं भवानपि नरोत्तमम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2147401, "chapter_id": 4187, "verse_number": "१७", "content_sanskrit": "पूर्णान्येवं शतान्यष्टौ तुरगाणां भवन्तु ते ।\nभवतो ह्यनृणो भूत्वा तपः कुर्यां यथासुखम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2147402, "chapter_id": 4187, "verse_number": "१८", "content_sanskrit": "विश्वामित्रस्तु तं दृष्ट्वा गालवं सह पक्षिणा ।\nकन्यां च तां वरारोहामिदमित्यब्रवीद् वचः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2147403, "chapter_id": 4187, "verse_number": "१९", "content_sanskrit": "किमियं पूर्वमेवेह न दत्ता मम गालव ।\nपुत्रा ममैव चत्वारो भवेरन् कुलभावनाः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2147404, "chapter_id": 4187, "verse_number": "२०", "content_sanskrit": "प्रतिगृह्णामि ते कन्यामेकपुत्रफलाय वै ।\nअश्वाश्चाश्रममासाद्य तिष्ठन्तु मम सर्वशः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2147405, "chapter_id": 4187, "verse_number": "२१", "content_sanskrit": "स तया रममाणोऽथ विश्वामित्रो महाद्युतिः ।\nआत्मजं जनयामास माधवीपुत्रमष्टकम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2147406, "chapter_id": 4187, "verse_number": "२२", "content_sanskrit": "जातमात्रं सुतं तं च विश्वामित्रो महामुनिः ।\nसंयोज्यार्थैस्तथा धर्मैरश्वैस्तैः समयोजयत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2147407, "chapter_id": 4187, "verse_number": "२३", "content_sanskrit": "अथाष्टकः पुरं प्रायात् तदा सोमपुरप्रभम् ।\nनिर्यात्य कन्यां शिष्याय कौशिकोऽपि वनं ययौ\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2147408, "chapter_id": 4187, "verse_number": "२४", "content_sanskrit": "गालवोऽपि सुपर्णेन सह निर्यात्य दक्षिणाम् ।\nमनसाऽभिप्रणीतेन कन्यामिदमुवाच ह\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2147409, "chapter_id": 4187, "verse_number": "२५", "content_sanskrit": "जातो दानपतिः पुत्रः त्वया शूरस्तथाऽपरः ।\nसत्यधर्मरतश्चान्यो यज्वा चापि तथाऽपरः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2147410, "chapter_id": 4187, "verse_number": "२६", "content_sanskrit": "तदागच्छ वरारोहे तारितस्ते पिता सुतैः ।\nचत्वारश्चैव राजानः तथाऽहं च सुमध्यमे\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2147411, "chapter_id": 4187, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2147412, "chapter_id": 4187, "verse_number": "२७", "content_sanskrit": "नारदस्य तु तद्वाक्यं श्रुत्वा सर्वे सभासदः ।\nपूजयामासुरत्यर्थं सर्वज्ञं नारदं तदा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2147413, "chapter_id": 4187, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2147414, "chapter_id": 4187, "verse_number": "२८", "content_sanskrit": "गालवस्त्वभ्यनुज्ञाय सुपर्णं पन्नगाशनम् ।\nपितुर्निर्यात्य तां कन्यां प्रययौ वनमेव ह\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2147415, "chapter_id": 4187, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि अष्टादशोत्तरशततमोऽध्यायः ॥११८॥\nभगवद्यानपर्वणि एकोनपञ्चाशोऽध्यायः ॥४९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]