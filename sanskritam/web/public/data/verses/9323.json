[{"id": 5000323000, "chapter_id": 9323, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे एकपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000323001, "chapter_id": 9323, "verse_number": "४-५१-१", "content_sanskrit": "इत्युक्त्वा हनुमांस्तत्र चीरकृष्णाजिनाम्बराम्।\nअब्रवीत् तां महाभागां तापसीं धर्मचारिणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000323002, "chapter_id": 9323, "verse_number": "४-५१-२", "content_sanskrit": "इदं प्रविष्टाः सहसा बिलं तिमिरसंवृतम्।\nक्षुत्पिपासापरिश्रान्ताः परिखिन्नाश्च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000323003, "chapter_id": 9323, "verse_number": "४-५१-३", "content_sanskrit": "महद् धरण्या विवरं प्रविष्टाः स्म पिपासिताः।\nइमांस्त्वेवंविधान् भावान् विविधानद्भुतोपमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000323004, "chapter_id": 9323, "verse_number": "४-५१-४", "content_sanskrit": "दृष्ट्वा वयं प्रव्यथिताः सम्भ्रान्ता नष्टचेतसः।\nकस्यैते काञ्चना वृक्षास्तरुणादित्यसंनिभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000323005, "chapter_id": 9323, "verse_number": "४-५१-५", "content_sanskrit": "शुचीन्यभ्यवहाराणि मूलानि च फलानि च।\nकाञ्चनानि विमानानि राजतानि गृहाणि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000323006, "chapter_id": 9323, "verse_number": "४-५१-६", "content_sanskrit": "तपनीयगवाक्षाणि मणिजालावृतानि च।\nपुष्पिताः फलवन्तश्च पुण्याः सुरभिगन्धयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000323007, "chapter_id": 9323, "verse_number": "४-५१-७", "content_sanskrit": "इमे जाम्बूनदमयाः पादपाः कस्य तेजसा।\nकाञ्चनानि च पद्मानि जातानि विमले जले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000323008, "chapter_id": 9323, "verse_number": "४-५१-८", "content_sanskrit": "कथं मत्स्याश्च सौवर्णा दृश्यन्ते सह कच्छपैः।\nआत्मनस्त्वनुभावाद् वा कस्य चैतत्तपोबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000323009, "chapter_id": 9323, "verse_number": "४-५१-९", "content_sanskrit": "अजानतां नः सर्वेषां सर्वमाख्यातुमर्हसि।\nएवमुक्ता हनुमता तापसी धर्मचारिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000323010, "chapter_id": 9323, "verse_number": "४-५१-१०", "content_sanskrit": "प्रत्युवाच हनूमन्तं सर्वभूतहिते रता।\nमयो नाम महातेजा मायावी वानरर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000323011, "chapter_id": 9323, "verse_number": "४-५१-११", "content_sanskrit": "तेनेदं निर्मितं सर्वं मायया काञ्चनं वनम्।\nपुरा दानवमुख्यानां विश्वकर्मा बभूव ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000323012, "chapter_id": 9323, "verse_number": "४-५१-१२", "content_sanskrit": "येनेदं काञ्चनं दिव्यं निर्मितं भवनोत्तमम्।\nस तु वर्षसहस्राणि तपस्तप्त्वा महद्वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000323013, "chapter_id": 9323, "verse_number": "४-५१-१३", "content_sanskrit": "पितामहाद् वरं लेभे सर्वमौशनसं धनम्।\nविधाय सर्वं बलवान् सर्वकामेश्वरस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000323014, "chapter_id": 9323, "verse_number": "४-५१-१४", "content_sanskrit": "उवास सुखितः कालं कंचिदस्मिन् महावने।\nतमप्सरसि हेमायां सक्तं दानवपुङ्गवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000323015, "chapter_id": 9323, "verse_number": "४-५१-१५", "content_sanskrit": "विक्रम्यैवाशनिं गृह्य जघानेशः पुरंदरः।\nइदं च ब्रह्मणा दत्तं हेमायै वनमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000323016, "chapter_id": 9323, "verse_number": "४-५१-१६", "content_sanskrit": "शाश्वतः कामभोगश्च गृहं चेदं हिरण्मयम्।\nदुहिता मेरुसावर्णेरहं तस्याः स्वयंप्रभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000323017, "chapter_id": 9323, "verse_number": "४-५१-१७", "content_sanskrit": "इदं रक्षामि भवनं हेमाया वानरोत्तम।\nमम प्रियसखी हेमा नृत्तगीतविशारदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000323018, "chapter_id": 9323, "verse_number": "४-५१-१८", "content_sanskrit": "तयादत्तवरा चास्मि रक्षामि भवनं महत्।\nकिं कार्यं कस्य वा हेतोः कान्ताराणि प्रपद्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000323019, "chapter_id": 9323, "verse_number": "४-५१-१९", "content_sanskrit": "कथं चेदं वनं दुर्गं युष्माभिरुपलक्षितम्।\nशुचीन्यभ्यवहाराणि मूलानि च फलानि च।\nभुक्त्वा पीत्वा च पानीयं सर्वं मे वक्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000323020, "chapter_id": 9323, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे एकपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]