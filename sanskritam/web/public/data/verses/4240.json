[{"id": 2149634, "chapter_id": 4240, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2149635, "chapter_id": 4240, "verse_number": "१", "content_sanskrit": "किमर्थं भरतश्रेष्ठ नैव हन्याः शिखण्डिनम् ।\nउद्यतेषुमथो दृष्ट्वा समरेष्वाततायिनम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2149636, "chapter_id": 4240, "verse_number": "२", "content_sanskrit": "पूर्वमुक्त्वा महाबाहो पाण्डवान् सह सोमकैः ।\nहनिष्यामीति गाङ्गेय तन्मे ब्रूहि पितामह\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2149637, "chapter_id": 4240, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2149638, "chapter_id": 4240, "verse_number": "३", "content_sanskrit": "शृणु दुर्योधन कथां सहैभिर्वसुधाधिपैः ।\nयदर्थं युधि सम्प्रेक्ष्य नाहं हन्यां शिखण्डिनम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2149639, "chapter_id": 4240, "verse_number": "४", "content_sanskrit": "महाराजो मम पिता शन्तनुर्भरतर्षभः ।\nदिष्टान्तमाप धर्मात्मा समये भरतर्षभ\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2149640, "chapter_id": 4240, "verse_number": "५", "content_sanskrit": "ततोऽहं भरतश्रेष्ठ प्रतिज्ञां परिपालयन् ।\nचित्राङ्गदं भ्रातरं वै महाराज्येऽभ्यषेचयम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2149641, "chapter_id": 4240, "verse_number": "६", "content_sanskrit": "तस्मिंश्च निधनं प्राप्ते सत्यवत्या मते स्थितः ।\nविचित्रवीर्यं राजानमभ्यषिञ्चं यथाविधि\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2149642, "chapter_id": 4240, "verse_number": "७", "content_sanskrit": "मयाऽभिषिक्तो राजेन्द्र यवीयानपि धर्मतः ।\nविचित्रवीर्यो धर्मात्मा मामेव समुदैक्षत\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2149643, "chapter_id": 4240, "verse_number": "८", "content_sanskrit": "तस्य दारक्रियां तात चिकीर्षुरहमुद्यतः ।\nअनुरूपादिव कुलाद् इत्येव च मनो दधे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2149644, "chapter_id": 4240, "verse_number": "९", "content_sanskrit": "अथाश्रौषं महाबाहो तिस्रः कन्याः स्वयंवरे ।\nरूपेणाप्रतिमाः सर्वाः काशिराजसुतास्तदा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2149645, "chapter_id": 4240, "verse_number": "१०", "content_sanskrit": "अम्बां चैवाम्बिकां चैव तथैवाम्बालिकामपि\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2149646, "chapter_id": 4240, "verse_number": "११", "content_sanskrit": "राजानश्च समाहूताः पृथिव्यां भरतर्षभ\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2149647, "chapter_id": 4240, "verse_number": "१२", "content_sanskrit": "अम्बा ज्येष्ठाऽभवत् तासामम्बिका त्वथ मध्यमा ।\nअम्बालिका च राजेन्द्र राजकन्या यवीयसी\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2149648, "chapter_id": 4240, "verse_number": "१३", "content_sanskrit": "सोऽहमेकरथेनैव गतः काशीपतेः पुरीम् ।\nअपश्यं ता महाबाहो तिस्रः कन्याः स्वलङ्कृताः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2149649, "chapter_id": 4240, "verse_number": "१४", "content_sanskrit": "राज्ञश्चैव समावृत्तान् पार्थिवान् पृथिवीपते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2149650, "chapter_id": 4240, "verse_number": "१५", "content_sanskrit": "ततोऽहं तान् नृपान् सर्वानाहूय समरे स्थितान् ।\nरथमारोपयाञ्चक्रे कन्यास्ता भरतर्षभ\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2149651, "chapter_id": 4240, "verse_number": "१६", "content_sanskrit": "वीर्यशुल्काश्च ता ज्ञात्वा समारोप्य रथं तदा ।\nअवोचं पार्थिवान् सर्वानहं तत्र समागतान्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2149652, "chapter_id": 4240, "verse_number": "१७", "content_sanskrit": "भीष्मः शान्तनवः कन्या हरतीति पुनः पुनः ।\nते यतध्वं परं शक्त्या सर्वे मोक्षाय पार्थिवाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2149653, "chapter_id": 4240, "verse_number": "१८", "content_sanskrit": "प्रसँह्य हि हराम्येष मिषतां वो नरर्षभाः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2149654, "chapter_id": 4240, "verse_number": "१९", "content_sanskrit": "योगो योग इति क्रुद्धाः सारथींश्चाप्यचोदयन्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2149655, "chapter_id": 4240, "verse_number": "२०", "content_sanskrit": "ते रथैर्मेघसङ्काशैर्गजैश्च गजयोधिनः ।\nउष्ट्रैश्चाश्वैर्महेष्वासाः समुत्पेतुरुदायुधाः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2149656, "chapter_id": 4240, "verse_number": "२१", "content_sanskrit": "ततस्ते पृथिवीपाला सर्व एव विशाम्पते ।\nरथव्रातेन महता सर्वतः पर्यवारयन्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2149657, "chapter_id": 4240, "verse_number": "२२", "content_sanskrit": "तानहं शरवर्षेण महता प्रत्यवारयम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2149658, "chapter_id": 4240, "verse_number": "२३", "content_sanskrit": "सर्वान् नृपांश्चाप्यजयं देवराडिव दानवान् ।\nतेषामापततां चित्रान् ध्वजान् हेमपरिष्कृतान्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2149659, "chapter_id": 4240, "verse_number": "२४", "content_sanskrit": "अपातयं शरैर्दीप्तैः प्रहसन् भरतर्षभ ।\nएकैकेन हि बाणेन भूमौ पातितवानहम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2149660, "chapter_id": 4240, "verse_number": "२५", "content_sanskrit": "हयांस्तेषां गजांश्चैव सारथींश्चाप्यहं रणे ।\nअपातयं शरैश्चैव प्रहसन् पुरुषर्षभ\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2149661, "chapter_id": 4240, "verse_number": "२६", "content_sanskrit": "ते निवृत्ताश्च भग्नाश्च दृष्ट्वा तल्लाघवं च मे\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2149662, "chapter_id": 4240, "verse_number": "२७", "content_sanskrit": "प्रणिपेतुश्च सर्वे वै प्रशशंसुश्च पार्थिवाः ।\nतत आदाय ताः कन्या नृपतींश्च विसृज्य तान्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2149663, "chapter_id": 4240, "verse_number": "२८", "content_sanskrit": "ततोऽहं हस्तिनपुरमागां जित्वा महीक्षितः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2149664, "chapter_id": 4240, "verse_number": "२९", "content_sanskrit": "ततोऽहं ताश्च कन्या वै भ्रातुरर्थाय भारत ।\nतच्च कर्म महाबाहो सत्यवत्यै न्यवेदयम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2149665, "chapter_id": 4240, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकसप्तत्युत्तरशततमोऽध्यायः ॥१७१॥\nअम्बोपाख्यानपर्वणि प्रथमोऽध्यायः ॥१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]