[{"id": 7002171000, "chapter_id": 22171, "verse_number": "२१६-१", "content_sanskrit": "अग्निरुवाच ।\nएवं सन्ध्याविधिं कृत्वा गायत्रीञ्च जपेत्स्मरेत् ।\nगायञ्च्छिष्यान् यतस्त्रायेत्भार्यां प्राणांस्तथैव च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002171001, "chapter_id": 22171, "verse_number": "२१६-२", "content_sanskrit": "ततः स्मृतेयं गायत्री सावित्रीय ततो यतः ।\nप्रकाशनात्सा सवितुर्वाग्रूपत्वात्सरस्वती ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002171002, "chapter_id": 22171, "verse_number": "२१६-३", "content_sanskrit": "तज्ज्योतिः परमं ब्रह्म भर्गस्तेजो यतः स्मृतं ।\nभा दीप्ताविति रूपं हि भ्रस्जः पाकेऽथ तत्स्मृतं ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002171003, "chapter_id": 22171, "verse_number": "२१६-४", "content_sanskrit": "ओषध्यादिकं पचति भ्राजृ दीप्तौ तथा भवेत् ।\nभर्गः स्याद्भ्राजत इति बहुलं छन्द ईरितं ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002171004, "chapter_id": 22171, "verse_number": "२१६-५", "content_sanskrit": "वरेण्यं सर्वतेजोभ्यः श्रेष्ठं वै परमं पदं ।\nस्वर्गापवर्गकामैर्वा वरणीयं सदैव हि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002171005, "chapter_id": 22171, "verse_number": "२१६-६", "content_sanskrit": "वृणोतेर्वरणार्थत्वाज्जाग्रत्स्वप्नादिवर्जितं ।\nनित्यशुद्धबुद्धमेकं सत्यन्तद्धीमहीश्वरं ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002171006, "chapter_id": 22171, "verse_number": "२१६-७", "content_sanskrit": "अहं ब्रह्म परं ज्योतिर्ध्ययेमहि विमुक्तये ।\nतज्ज्योतिर्भगवान् विष्णुर्जगज्जन्मादिकारणं ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002171007, "chapter_id": 22171, "verse_number": "२१६-८", "content_sanskrit": "शिवं केचित्पठन्ति स्म शक्तिरूपं पठन्ति च ।\nकेचित्सूर्यङ्केचिदग्निं वेदगा अग्निहोत्रिणः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002171008, "chapter_id": 22171, "verse_number": "२१६-९", "content_sanskrit": "अग्न्यादिरूपो विष्णुर्हि वेदादौ ब्रह्म गीयते ।\nतत्पदं परमं विष्णोर्देवस्य सवितुः स्मृतं ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002171009, "chapter_id": 22171, "verse_number": "२१६-१०", "content_sanskrit": "महदाज्यं सूयते हि स्वयं ज्योतिर्हरिः प्रभुः ।\nपर्जन्यो वायुरादित्यः शीतोष्णाद्यैश्च पाचयेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002171010, "chapter_id": 22171, "verse_number": "२१६-११", "content_sanskrit": "अग्नौ प्रास्ताहुतिः सम्यगादित्यमुपतिष्ठते ।\nआदित्याज्जायते वृष्टिर्वृष्टेरन्नन्ततः प्रजाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002171011, "chapter_id": 22171, "verse_number": "२१६-१२", "content_sanskrit": "दधातेर्वा धीमहीति मनसा धारयेमहि ।\nनोऽस्माकं यश्च भर्गश्च सर्वेषां प्राणिनां धियः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002171012, "chapter_id": 22171, "verse_number": "२१६-१३", "content_sanskrit": "चोदयात्प्रेरयेद्बुद्धीर्भोक्तॄणां सर्वकर्मसु ।\nदृष्टादृष्टविपाकेषु विष्णुसूर्याग्निरूपवान् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002171013, "chapter_id": 22171, "verse_number": "२१६-१४", "content_sanskrit": "ईश्वरप्रेरितो गच्छेत्स्वर्गं वाश्वभ्रमेव वा ।\nईशावास्यमिदं सर्वं महदादिजगद्धरिः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002171014, "chapter_id": 22171, "verse_number": "२१६-१५", "content_sanskrit": "स्वर्गाद्यैः क्रीडते देवो योऽहं स पुरुषः प्रभुः ।\nआदित्यान्तर्गतं यच्च भर्गाख्यं वै मुमुक्षुभिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002171015, "chapter_id": 22171, "verse_number": "२१६-१६", "content_sanskrit": "जन्ममृत्युविनाशाय दुःखस्य त्रिविधस्य च ।\nध्यानेन पुरुषोऽयञ्च द्रष्टव्यः सूर्यमण्डले ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002171016, "chapter_id": 22171, "verse_number": "२१६-१७", "content_sanskrit": "तत्त्वं सदसि चिद्ब्रह्म विष्णोर्यत्परमं पदं ।\nदेवस्य सवितुर्भर्गो वरेण्यं हि तुरीयकं ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002171017, "chapter_id": 22171, "verse_number": "२१६-१८", "content_sanskrit": "देहादिजाग्रदाब्रह्म अहं ब्रह्मेति धीमहि ।\nयोऽसावादित्यपुरुषः सोऽसावहमनन्त ॐ ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002171018, "chapter_id": 22171, "verse_number": "२१६-१९", "content_sanskrit": "ज्ञानानि शुभकर्मादीन् प्रवर्तयति यः सदा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]