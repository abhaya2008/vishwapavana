[{"id": 2194877, "chapter_id": 5143, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2194878, "chapter_id": 5143, "verse_number": "१", "content_sanskrit": "अथ काले बहुतिथे पूर्णे प्राप्तो भुजङ्गमः ।\nदत्ताभ्यनुज्ञः स्वं वेश्म कृतकर्मा विवस्वतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2194879, "chapter_id": 5143, "verse_number": "२", "content_sanskrit": "तं भार्या समभिक्रामत् पादशौचादिभिर्गुणैः ।\nउपपन्नां च तां साध्वीं पन्नगः पर्यपृच्छत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2194880, "chapter_id": 5143, "verse_number": "३", "content_sanskrit": "अपि त्वमसि कल्याणि देवतातिथिपूजने ।\nपूर्वमुक्तेन विधिना युक्ता युक्तेन मत्समम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2194881, "chapter_id": 5143, "verse_number": "४", "content_sanskrit": "न खल्वस्यकृतार्थेन स्त्रीबुद्ध्या मार्दवीकृता ।\nमद्वियोगेन सुश्रोणि वियुक्ता धर्मसेतुना\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2194882, "chapter_id": 5143, "verse_number": "", "content_sanskrit": "नागभार्या", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2194883, "chapter_id": 5143, "verse_number": "५", "content_sanskrit": "शिष्याणां गुरुशुश्रूषा विप्राणां वेदपारणम् ।\nभृत्यानां स्वामिवचनं राज्ञां लोकानुपालनम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2194884, "chapter_id": 5143, "verse_number": "६", "content_sanskrit": "सर्वभूतपरित्राणं क्षत्रधर्म इहोच्यते ।\nवैश्यानां यज्ञसंवृत्तिरातिथेयसमन्विता\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2194885, "chapter_id": 5143, "verse_number": "७", "content_sanskrit": "विप्रक्षत्रियवैश्यानां शुश्रूषा शूद्रकर्म तत् ।\nगृहस्थधर्मो नागेन्द्र सर्वभूतहितैषिता\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2194886, "chapter_id": 5143, "verse_number": "८", "content_sanskrit": "नियताहारता नित्यं व्रतचर्या यथाक्रमम् ।\nधर्मो हि धर्मसम्बन्धादिन्द्रियाणां विशेषणम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2194887, "chapter_id": 5143, "verse_number": "९", "content_sanskrit": "अहं कस्य कुतो वाहं कः को मे ह भवेदिति ।\nप्रयोजनमतिर्नित्यमेवं मोक्षाश्रमी भवेत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2194888, "chapter_id": 5143, "verse_number": "१०", "content_sanskrit": "पतिव्रतात्वं भार्यायाः परमो धर्म उच्यते ।\nतवोपदेशान्नागेन्द्र तच्च तत्त्वेन वेद्मि वै\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2194889, "chapter_id": 5143, "verse_number": "११", "content_sanskrit": "साहं धर्मं विजानन्ती धर्मनित्ये त्वयि स्थिते ।\nसत्पथं कथमुत्सृज्य यास्यामि विषमे पथि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2194890, "chapter_id": 5143, "verse_number": "१२", "content_sanskrit": "देवतानां महाभाग धर्मचर्या न हीयते ।\nअतिथीनां च सत्कारे नित्ययुक्तास्म्यतन्द्रिता\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2194891, "chapter_id": 5143, "verse_number": "१३", "content_sanskrit": "सप्ताष्टदिवसास्त्वद्य विप्रस्येहागतस्य वै ।\nस च कार्यं न मे ख्याति दर्शनं तव काङ्क्षति\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2194892, "chapter_id": 5143, "verse_number": "१४", "content_sanskrit": "गोमत्यास्त्वेष पुलिने त्वद्दर्शनसमुत्सुकः ।\nआसीनोऽऽवर्तयन् ब्रह्म ब्राह्मणः संशितव्रतः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2194893, "chapter_id": 5143, "verse_number": "१५", "content_sanskrit": "अहं त्वनेन नागेन्द्र सामपूर्वं समाहिता ।\nप्रस्थाप्यो मत्सकाशं स सम्प्राप्तो भुजगोत्तमः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2194894, "chapter_id": 5143, "verse_number": "१६", "content_sanskrit": "एतच्छ्रुत्वा महाप्राज्ञ तत्र गन्तुं त्वमर्हसि ।\nदातुमर्हसि वा तस्य दर्शनं दर्शनश्रवः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2194895, "chapter_id": 5143, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे द्विनवत्युत्तरशततमोऽध्यायः ॥१९२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]