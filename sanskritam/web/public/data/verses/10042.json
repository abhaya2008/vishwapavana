[{"id": 6000042000, "chapter_id": 10042, "verse_number": null, "content_sanskrit": "अथ द्वादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "मैत्रेयेण विदुरं प्रति क्षणलवप्रभृतिपरार्धावधिमन्वन्तरावान्तरप्रलयमहाप्रलयादिसकलकालनिरूपणम्", "range": null}]}, {"id": 6000042001, "chapter_id": 10042, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.001.m4a", "display_order": 2}, {"id": 6000042002, "chapter_id": 10042, "verse_number": "३-१२-१", "content_sanskrit": "चरमस्तु विशेषाणामनेकांशायुतस्तु यः।\nपरमाणुः स विज्ञेयो नृणामैक्यभ्रमो यतः॥ ३/१२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.002.m4a", "display_order": 3}, {"id": 6000042003, "chapter_id": 10042, "verse_number": "३-१२-२", "content_sanskrit": "सत एव पदार्थस्य स्वरूपावस्थितस्य यत्।\nकैवल्यं परममहानविशेषो निरन्तरः॥ ३/१२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.003.m4a", "display_order": 4}, {"id": 6000042004, "chapter_id": 10042, "verse_number": "३-१२-३", "content_sanskrit": "एवं कालोऽप्यनुमितः सौक्ष्म्ये स्थौल्ये च सत्तम।\nसंस्थानभुक्त्या भगवानव्यक्तोऽव्यक्तभुग् विभुः॥ ३/१२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.004.m4a", "display_order": 5}, {"id": 6000042005, "chapter_id": 10042, "verse_number": "३-१२-४", "content_sanskrit": "स कालः परमाणुर्वै यो भुङ्क्ते परमाणुताम्।\nसतोऽविशेषभुग् यस्तु स कालः परमो महान्॥ ३/१२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.005.m4a", "display_order": 6}, {"id": 6000042006, "chapter_id": 10042, "verse_number": "३-१२-५", "content_sanskrit": "अणुर्द्वौ परमाणू स्यात् त्रसरेणुस्‍त्रयः स्मृतः।\nजालार्करश्म्यवगतः खमेवानुपतन्नगात्॥ ३/१२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.006.m4a", "display_order": 7}, {"id": 6000042007, "chapter_id": 10042, "verse_number": "३-१२-६", "content_sanskrit": "त्रसरेणुत्रिकं भुङ्क्ते यः कालः सा त्रुटिः स्मृता।\nतत्त्रिभागस्तु वेधः स्यात् तैस्‍त्रिभिस्तु लवः स्मृतः॥ ३/१२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.007.m4a", "display_order": 8}, {"id": 6000042008, "chapter_id": 10042, "verse_number": "३-१२-७", "content_sanskrit": "निमेषस्‍त्रिलवो ज्ञेय आम्नातास्ते त्रयः क्षणः।\nक्षणान् पञ्च विदुः काष्ठां लघु ता दश पञ्च च॥ ३/१२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.008.m4a", "display_order": 9}, {"id": 6000042009, "chapter_id": 10042, "verse_number": "३-१२-८", "content_sanskrit": "लघूनि वै समाम्नाता दश पञ्च च नाडिका।\nते द्वे मुहूर्तं प्रहरः षड् यामः सप्त वा नृणाम्॥ ३/१२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.009.m4a", "display_order": 10}, {"id": 6000042010, "chapter_id": 10042, "verse_number": "३-१२-९", "content_sanskrit": "द्वादशार्धपलोन्मानं चतुर्भिश्चतुरङ्गुलैः।\nस्वर्णमाषैः कृतच्छिद्रं यावत् प्रस्थजलं पिबेत्॥ ३/१२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.010.m4a", "display_order": 11}, {"id": 6000042011, "chapter_id": 10042, "verse_number": "३-१२-१०", "content_sanskrit": "यामाश्चत्वारश्चत्वारो मर्त्यानामहनी उभे।\nपक्षः पञ्चदशाहानि शुक्लः कृष्णश्च मानद॥ ३/१२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.011.m4a", "display_order": 12}, {"id": 6000042012, "chapter_id": 10042, "verse_number": "३-१२-११", "content_sanskrit": "तयोः समुच्चये मासः पितॄणां तदहर्निशम्।\nद्वौ तावृतुः षडयनं दक्षिणं चोत्तरं दिवि॥ ३/१२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.012.m4a", "display_order": 13}, {"id": 6000042013, "chapter_id": 10042, "verse_number": "३-१२-१२", "content_sanskrit": "अयने अहनी प्राहुर्वत्सरो द्वादश स्मृतः।\nसंवत्सरशतं नॄणां परमायुर्निरूपितम्॥ ३/१२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.013.m4a", "display_order": 14}, {"id": 6000042014, "chapter_id": 10042, "verse_number": "३-१२-१३", "content_sanskrit": "ग्रहर्क्षताराचक्रस्थः परमाण्वादिना जगत्।\nसंवत्सरावसानेन पर्येत्यनिमिषो विभुः॥ ३/१२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.014.m4a", "display_order": 15}, {"id": 6000042015, "chapter_id": 10042, "verse_number": "३-१२-१४", "content_sanskrit": "संवत्सरः परिवत्सर इडावत्सर एव च।\nअनुवत्सरो वत्सरश्च विदुरेवं प्रभाष्यते॥ ३/१२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.015.m4a", "display_order": 16}, {"id": 6000042016, "chapter_id": 10042, "verse_number": "३-१२-१५", "content_sanskrit": "यः सृज्यशक्तिमुरुधोच्छ्वसयन् स्वशक्त्या पुंसोऽभ्रमाय दिवि धावति भूतभेदः।\nकालाख्यया गुणमयीं क्रतुभिर्वितन्वन् तस्मै बलिं हरत वत्सरपञ्चकाय॥ ३/१२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.016.m4a", "display_order": 17}, {"id": 6000042017, "chapter_id": 10042, "verse_number": null, "content_sanskrit": "विदुर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.017.m4a", "display_order": 18}, {"id": 6000042018, "chapter_id": 10042, "verse_number": "३-१२-१६", "content_sanskrit": "पितृदेवमनुष्याणामायुः परमिदं स्मृतम्।\nपरेषां गतिमाचक्ष्व ये स्युः कल्पाद् बहिर्विदः॥ ३/१२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.018.m4a", "display_order": 19}, {"id": 6000042019, "chapter_id": 10042, "verse_number": "३-१२-१७", "content_sanskrit": "भगवान् वेद कालस्य गतिं भगवतो ननु।\nविश्वं विचक्षते धीरा योगराद्धेन चक्षुषा॥ ३/१२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.019.m4a", "display_order": 20}, {"id": 6000042020, "chapter_id": 10042, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.020.m4a", "display_order": 21}, {"id": 6000042021, "chapter_id": 10042, "verse_number": "३-१२-१८", "content_sanskrit": "कृतं त्रेता द्वापरं च कलिश्चेति चतुर्युगम्।\nदिव्यैर्द्वादशसाहस्रैः सावधानं निरूपितम्॥ ३/१२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.021.m4a", "display_order": 22}, {"id": 6000042022, "chapter_id": 10042, "verse_number": "३-१२-१९", "content_sanskrit": "चत्वारि त्रीणि द्वे चैकं कृतादिषु यथाक्रमम्।\nसंख्यातानि सहस्राणि द्विगुणानि शतानि च॥ ३/१२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.022.m4a", "display_order": 23}, {"id": 6000042023, "chapter_id": 10042, "verse_number": "३-१२-२०", "content_sanskrit": "सन्ध्यांशयोरन्तरेण यः कालः शतसंख्ययोः।\nतमेवाहुर्युगं तज्ज्ञा यत्र धर्मो विधीयते॥ ३/१२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.023.m4a", "display_order": 24}, {"id": 6000042024, "chapter_id": 10042, "verse_number": "३-१२-२१", "content_sanskrit": "धर्मश्चतुष्पान्मनुजान् कृते समनुवर्तते।\nस एवान्येष्वधर्मेण व्येति पादेन वर्धता॥ ३/१२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.024.m4a", "display_order": 25}, {"id": 6000042025, "chapter_id": 10042, "verse_number": "३-१२-२२", "content_sanskrit": "त्रैलोक्याद् युगसाहस्रं बहिराब्रह्मणो दिनम्।\nतावत्येव निशा तात यन्निमीलति विश्वसृक्॥ ३/१२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.025.m4a", "display_order": 26}, {"id": 6000042026, "chapter_id": 10042, "verse_number": "३-१२-२३", "content_sanskrit": "निशावसान आरब्धो लोककल्पोऽनुवर्तते।\nयावद् दिनं भगवतो मनून् भुञ्जंश्चतुर्दश॥ ३/१२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.026.m4a", "display_order": 27}, {"id": 6000042027, "chapter_id": 10042, "verse_number": "३-१२-२४", "content_sanskrit": "स्वं स्वं कालं मनुर्भुङ्क्ते साधिकां ह्येकसप्ततिम्। मन्वन्तरेषु मनवस्तद्वंश्या ऋषयः सुराः।\nभवन्ति चैते युगपत् सुरेशाश्चानु ये च तान्॥ ३/१२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.027.m4a", "display_order": 28}, {"id": 6000042028, "chapter_id": 10042, "verse_number": "३-१२-२५", "content_sanskrit": "एष दैनन्दिनः सर्गो ब्राह्मस्‍त्रैलोक्यवर्तनः।\nतिर्यङ्‌नृपितृदेवानां सम्भवो यत्र कर्मभिः॥ ३/१२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.028.m4a", "display_order": 29}, {"id": 6000042029, "chapter_id": 10042, "verse_number": "३-१२-२६", "content_sanskrit": "मन्वन्तरेषु भगवान् बिभ्रत् सत्त्वं स्वमूर्तिभिः।\nमन्वादिभिरिदं विश्वमवत्युदितपौरुषः॥ ३/१२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.029.m4a", "display_order": 30}, {"id": 6000042030, "chapter_id": 10042, "verse_number": "३-१२-२७", "content_sanskrit": "तमोमात्रामुपादाय प्रतिसंरुद्धविक्रमः।\nकालेनानुगतः शेष आस्ते तूष्णीं दिनात्यये॥ ३/१२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.030.m4a", "display_order": 31}, {"id": 6000042031, "chapter_id": 10042, "verse_number": "३-१२-२८", "content_sanskrit": "तमेवानुविलीयन्ते लोका भूरादयस्‍त्रयः।\nनिशायामनुवृत्तायां निर्मुक्तशशिभास्करे॥ ३/१२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.031.m4a", "display_order": 32}, {"id": 6000042032, "chapter_id": 10042, "verse_number": "३-१२-२९", "content_sanskrit": "त्रिलोक्यां दह्यमानायां शक्त्या सङ्कर्षणाग्निना।\nयान्त्यूष्मणा महर्लोकाज्जनमृभ्वादयोऽर्दिताः॥ ३/१२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.032.m4a", "display_order": 33}, {"id": 6000042033, "chapter_id": 10042, "verse_number": "३-१२-३०", "content_sanskrit": "तावत् त्रिभुवनं सद्यः कल्पान्ते विषसिन्धवः।\nप्लावयन्त्युत्कटाटोपचण्डवातेरितोर्मयः॥ ३/१२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.033.m4a", "display_order": 34}, {"id": 6000042034, "chapter_id": 10042, "verse_number": "३-१२-३१", "content_sanskrit": "अन्तः स तस्मिन् सलिल आस्तेऽनन्तासनो हरिः।\nयोगनिद्रामीलिताक्षः स्तूयमानो जनालयैः॥ ३/१२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.034.m4a", "display_order": 35}, {"id": 6000042035, "chapter_id": 10042, "verse_number": "३-१२-३२", "content_sanskrit": "एवंविधैरहोरात्रैः कालगत्योपलक्षितैः।\nअपेक्षितमिवास्यापि परमायुर्वयःशतम्॥ ३/१२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.035.m4a", "display_order": 36}, {"id": 6000042036, "chapter_id": 10042, "verse_number": "३-१२-३३", "content_sanskrit": "यदर्धमायुषस्तस्य परार्धमभिधीयते।\nपूर्वः परार्धोऽपक्रान्तो ह्यपरार्धोऽद्य वर्तते॥ ३/१२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.036.m4a", "display_order": 37}, {"id": 6000042037, "chapter_id": 10042, "verse_number": "३-१२-३४", "content_sanskrit": "पूर्वस्यादौ परार्धस्य ब्राह्मो नाम महानभूत्।\nकल्पो यत्राभवद् ब्रह्मा शब्दब्रह्मेति यं विदुः॥ ३/१२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.037.m4a", "display_order": 38}, {"id": 6000042038, "chapter_id": 10042, "verse_number": "३-१२-३५", "content_sanskrit": "तस्यैव चान्ते कल्पोऽभूद् यं पाद्ममभिचक्षते।\nयद्धरेर्नाभिसरस आसील्लोकसरोरुहम्॥ ३/१२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.038.m4a", "display_order": 39}, {"id": 6000042039, "chapter_id": 10042, "verse_number": "३-१२-३६", "content_sanskrit": "अयं तु कथितः कल्पो द्वितीयस्याद्य भारत।\nवाराह इति विख्यातो यत्रासीत् सूकरो हरिः॥ ३/१२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.039.m4a", "display_order": 40}, {"id": 6000042040, "chapter_id": 10042, "verse_number": "३-१२-३७", "content_sanskrit": "कालोऽयं द्विपरार्धाख्यो निमेष उपचर्यते।\nअव्याकृतस्यानन्तस्य ह्यनादेर्जगदात्मनः॥ ३/१२/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.040.m4a", "display_order": 41}, {"id": 6000042041, "chapter_id": 10042, "verse_number": "३-१२-३८", "content_sanskrit": "कालोऽयं परमाण्वादिर्द्विपरार्धान्त ईरितः।\nनैवेष्टे यः प्रभुर्भूम्न ईश्वरो धाममानिनाम्॥ ३/१२/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.041.m4a", "display_order": 42}, {"id": 6000042042, "chapter_id": 10042, "verse_number": "३-१२-३९", "content_sanskrit": "विकारैः षोडशैर्युक्तो विशेषादिभिरावृतः।\nआण्डकोशो बहिरयं पञ्चाशत्कोटिविस्तृतः॥ ३/१२/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.042.m4a", "display_order": 43}, {"id": 6000042043, "chapter_id": 10042, "verse_number": "३-१२-४०", "content_sanskrit": "दशोत्तराधिकैर्यत्र प्रविष्टः परमाणुवत्।\nलक्ष्यन्तेऽन्तर्गताश्चान्ये कोटिशो ह्यण्डराशयः॥ ३/१२/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.043.m4a", "display_order": 44}, {"id": 6000042044, "chapter_id": 10042, "verse_number": "३-१२-४१", "content_sanskrit": "यमाहुरक्षरं ब्रह्म सर्वकारणकारणम्।\nविष्णोर्धाम परं साक्षात् पुरुषस्य महात्मनः॥ ३/१२/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_012/BhP_03.012.044.m4a", "display_order": 45}, {"id": 6000042045, "chapter_id": 10042, "verse_number": null, "content_sanskrit": "इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे द्वादशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]