[{"id": 7001034000, "chapter_id": 21034, "verse_number": "५-१६-१", "content_sanskrit": "श्रीपराशर उवाच ।\nकेशी चापि बलोदग्रः कंसदूतः प्रचोदितः ।\nकृष्णस्य निधनाकांक्षी वृंदावनमुपागमत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001034001, "chapter_id": 21034, "verse_number": "५-१६-२", "content_sanskrit": "स खुरक्षतभूपृष्ठस्सटाक्षेपधुतांबुदः ।\nद्रुतविक्रांतचंद्रार्कमार्गो गोपानुपाद्रवत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001034002, "chapter_id": 21034, "verse_number": "५-१६-३", "content_sanskrit": "तस्य हेषितशब्देन गोपाला दैत्यवाजिनः ।\nगोप्यश्च भयसंविग्ना गोविंदं शरणं ययुः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001034003, "chapter_id": 21034, "verse_number": "५-१६-४", "content_sanskrit": "त्राहित्राहीति गोविंदः श्रुत्वा तेषां ततो वचः ।\nसतोयजलदध्वानगंभीरमिदमुक्तवान् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001034004, "chapter_id": 21034, "verse_number": "५-१६-५", "content_sanskrit": "अलं त्रासेन गोपालाः केशिनः किं भयातुरैः ।\nभवद्भिर्गोपजातीयैर्वीरवीर्यं विलोप्यते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001034005, "chapter_id": 21034, "verse_number": "५-१६-६", "content_sanskrit": "किमनेनाल्पसारेण हेषिताटोपकारिणा ।\nदैतेयबलवाह्येन वल्गता दुष्टवाजिना ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001034006, "chapter_id": 21034, "verse_number": "५-१६-७", "content_sanskrit": "एह्येहि दुष्ट कृष्णोऽहं पूष्णस्त्विव पिनाकधृत् ।\nपातयिष्यामि दशनान्वदनादखिलांस्तव ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001034007, "chapter_id": 21034, "verse_number": "५-१६-८", "content_sanskrit": "इत्युक्त्वाऽस्फोट्य गोविंदः केशिनस्संमुखं ययौ ।\nविवृतास्यश्च सोप्येनं दैतेयाश्व उपाद्रवत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001034008, "chapter_id": 21034, "verse_number": "५-१६-९", "content_sanskrit": "बाहुमाभोगिनं कृत्वा मुखे तस्य जनार्दनः ।\nप्रवेशयामास तदा केशिनो दुष्टवाजिनः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001034009, "chapter_id": 21034, "verse_number": "५-१६-१०", "content_sanskrit": "केशिनो वदनं तेन विशता कृष्णबाहुना ।\nशातिता दशनाः पेतुः सिताब्भ्रावयवा इव ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001034010, "chapter_id": 21034, "verse_number": "५-१६-११", "content_sanskrit": "कृष्णस्य ववृधे बाहुः केशिदेहगतो द्विज ।\nविनाशाय यथा व्याधिरासंभूतेरुपेक्षितः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001034011, "chapter_id": 21034, "verse_number": "५-१६-१२", "content_sanskrit": "विपाटितोष्ठो बहुलं सफेनं रुधिरं वमन् ।\nसोक्षिणी विवृते चक्रे विशिष्टे मुक्तबंधने ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001034012, "chapter_id": 21034, "verse_number": "५-१६-१३", "content_sanskrit": "जघान धरणीं पादैश्शकृन्मूत्रं समुत्सृजन् ।\nस्वेदार्द्र गात्रश्शांतश्च निर्यत्नस्सोऽभवत्तदा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001034013, "chapter_id": 21034, "verse_number": "५-१६-१४", "content_sanskrit": "व्यादितास्यमहारंध्रस्सोऽसुरः कृष्णबाहुना ।\nनिपातितो द्विधा भूमौ वैद्युतेन यथा द्रुमः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001034014, "chapter_id": 21034, "verse_number": "५-१६-१५", "content_sanskrit": "द्विपादे पृष्ठपुच्छार्द्धे श्रवणैकाक्षिनासिके ।\nकेशिनस्ते द्विधा भूते शकले द्वे विरेजतुः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001034015, "chapter_id": 21034, "verse_number": "५-१६-१६", "content_sanskrit": "हत्वा तु केशिनं कृष्णो गोपलैर्मुदितैर्वृतः ।\nअनायस्ततनुस्स्वस्थो हसंस्तत्रैव तस्थिवान् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001034016, "chapter_id": 21034, "verse_number": "५-१६-१७", "content_sanskrit": "ततो गोप्यश्च गोपाश्च हते केशिनि विस्मिताः ।\nतुष्टुवुः पुंडरीकाक्षमनुरागमनोरमम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001034017, "chapter_id": 21034, "verse_number": "५-१६-१८", "content_sanskrit": "अथाहांतर्हितो विप्र नारदो जलदे स्थितः ।\nकेशिनं निहतं दृष्ट्वा हर्षनिर्भरमानसः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001034018, "chapter_id": 21034, "verse_number": "५-१६-१९", "content_sanskrit": "साधुसाधु जगन्नाथ लीलयैव यदच्युत ।\nनिहतोऽयं त्वया केशी क्लेशदस्त्रिदिवौकसाम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001034019, "chapter_id": 21034, "verse_number": "५-१६-२०", "content_sanskrit": "युद्धोत्सुकोहमत्यर्थं नरवाजिमहाहवम् ।\nअभूतपूर्वमन्यत्र द्रष्टुं स्वर्गादिहागतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001034020, "chapter_id": 21034, "verse_number": "५-१६-२१", "content_sanskrit": "कर्माण्यऽत्रावतारे ते कृतानि मधुसूदन ।\nयानि तैर्विस्मितं चेतस्तोषमेतेन मे गतम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001034021, "chapter_id": 21034, "verse_number": "५-१६-२२", "content_sanskrit": "तुरंगस्यास्य शक्रोपि कृष्ण देवाश्च बिभ्यति ।\nधुतकेसरजालस्य ह्रेषतोऽभ्रावलोकिनः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001034022, "chapter_id": 21034, "verse_number": "५-१६-२३", "content_sanskrit": "यस्मात्त्वयैष दुष्टात्मा हतः केशी जनार्दन ।\nतस्मात्केशवनाम्ना त्वं लोके ख्यातो भविष्यसि ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001034023, "chapter_id": 21034, "verse_number": "५-१६-२४", "content_sanskrit": "स्वस्त्यस्तु ते गमिष्यामि कंसयुद्धेऽधुना पुनः ।\nपरश्वोऽहं समेष्यामि त्वया केशिनिषूदन ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001034024, "chapter_id": 21034, "verse_number": "५-१६-२५", "content_sanskrit": "उग्रसेनसुते कंसे सानुगे विनिपातिते ।\nभारावतारकर्त्ता त्वं पृथिव्या पृथिवीधर ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001034025, "chapter_id": 21034, "verse_number": "५-१६-२६", "content_sanskrit": "तत्रानेकप्रकाराणि युद्धानि पृथिवीक्षिताम् ।\nद्रष्टव्यानि मया युष्मत्प्रणीतानि जनार्दन ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001034026, "chapter_id": 21034, "verse_number": "५-१६-२७", "content_sanskrit": "सोऽहं यास्यामि गोविंद देवकार्यं महत्कृतम् ।\nत्वयैव विदितं सर्वं स्वस्ति तेऽस्तु व्रजाम्यहम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001034027, "chapter_id": 21034, "verse_number": "५-१६-२८", "content_sanskrit": "नारदे गते कृष्णस्सह गोपैस्सभाजितः ।\nविवेश गोकुलं गोपीनेत्रपानैकभाजनम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]