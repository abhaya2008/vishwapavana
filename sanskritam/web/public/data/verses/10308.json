[{"id": 6000308000, "chapter_id": 10308, "verse_number": null, "content_sanskrit": "सप्तमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000308001, "chapter_id": 10308, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.001.m4a", "display_order": 2}, {"id": 6000308002, "chapter_id": 10308, "verse_number": "११-७-१", "content_sanskrit": "यदात्थ मां महाभाग तच्चिकीर्षितमेव मे।\nब्रह्मा भवो लोकपालाः सर्वे मामभिकाङ्क्षिणः॥ ११/७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.002.m4a", "display_order": 3, "topics": [{"text": "भगवता उद्धवं प्रति ज्ञानोपदेशार्थमवधूतेतिहासकथनारम्भः", "range": "१–३०"}]}, {"id": 6000308003, "chapter_id": 10308, "verse_number": "११-७-२", "content_sanskrit": "मया निष्पादितं ह्यत्र देवकार्यमशेषतः।\nयदर्थमवतीर्णोऽहमंशेन ब्रह्मणाऽर्थितः॥ ११/७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.003.m4a", "display_order": 4}, {"id": 6000308004, "chapter_id": 10308, "verse_number": "११-७-३", "content_sanskrit": "कुलं वै शापनिर्दग्धं नयत्यन्योन्यविग्रहात्।\nसमुद्रः सप्तमे ह्येनां पुरीं च प्लावयिष्यति॥ ११/७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.004.m4a", "display_order": 5}, {"id": 6000308005, "chapter_id": 10308, "verse_number": "११-७-४", "content_sanskrit": "यर्ह्येवायं मया त्यक्तो लोकोऽयं नष्टमङ्गलः।\nभविष्यत्यचिरात् साधो कलिनाऽपि निराकृतः॥ ११/७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.005.m4a", "display_order": 6}, {"id": 6000308006, "chapter_id": 10308, "verse_number": "११-७-५", "content_sanskrit": "न वस्तव्यं त्वयैवेह मया त्यक्ते महीतले।\nजनोऽधर्मरुचिर्भद्र भविष्यति कलौ युगे॥ ११/७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.006.m4a", "display_order": 7}, {"id": 6000308007, "chapter_id": 10308, "verse_number": "११-७-६", "content_sanskrit": "त्वं तु सर्वं परित्यज्य स्नेहं स्वजनबन्धनम्।\nमय्यावेश्य मनः सम्यक् समदृग् विचरस्व गाम्॥ ११/७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.007.m4a", "display_order": 8}, {"id": 6000308008, "chapter_id": 10308, "verse_number": "११-७-७", "content_sanskrit": "यदिदं मनसा वाचा चक्षुर्भ्यां श्रवणादिभिः।\nनश्वरं गृह्यमाणं च विद्धि मायां मनोमयीम्॥ ११/७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.008.m4a", "display_order": 9}, {"id": 6000308009, "chapter_id": 10308, "verse_number": "११-७-८", "content_sanskrit": "पुंसोऽयुक्तस्य नानार्थे भ्रमः स गुणदोषकृत्।\nकर्माकर्मविकर्मेति गुणदोषधियो भिदा॥ ११/७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.009.m4a", "display_order": 10}, {"id": 6000308010, "chapter_id": 10308, "verse_number": "११-७-९", "content_sanskrit": "तस्माद् युक्तेन्द्रियग्रामो युक्तचित्त इदं जगत्।\nआत्मनीक्षस्व विततमात्मानं मय्यधीश्वरे॥ ११/७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.010.m4a", "display_order": 11}, {"id": 6000308011, "chapter_id": 10308, "verse_number": "११-७-१०", "content_sanskrit": "ज्ञानविज्ञानसंयुक्त आत्मभूतः शरीरिणाम्।\nआत्मानुभवतुष्टात्मा नान्तरायैर्विहन्यते॥ ११/७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.011.m4a", "display_order": 12}, {"id": 6000308012, "chapter_id": 10308, "verse_number": "११-७-११", "content_sanskrit": "दोषबुद्ध्योभयातीतो निषेधान्न निवर्तते।\nगुणबुद्ध्या च विहितं न करोति यथाऽर्भकः॥ ११/७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.012.m4a", "display_order": 13}, {"id": 6000308013, "chapter_id": 10308, "verse_number": "११-७-१२", "content_sanskrit": "सर्वभूतसुहृच्छान्तो ज्ञानविज्ञाननिश्चलः।\nपश्यन् मदात्मकं विश्वं न विपद्येत वै पुनः॥ ११/७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.013.m4a", "display_order": 14}, {"id": 6000308014, "chapter_id": 10308, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.014.m4a", "display_order": 15}, {"id": 6000308015, "chapter_id": 10308, "verse_number": "११-७-१३", "content_sanskrit": "इत्यादिष्टो भगवता महाभागवतो नृप।\nउद्धवः प्रणिपत्याह तत्वजिज्ञासुरच्युतम्॥ ११/७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.015.m4a", "display_order": 16}, {"id": 6000308016, "chapter_id": 10308, "verse_number": null, "content_sanskrit": "उद्धव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.016.m4a", "display_order": 17}, {"id": 6000308017, "chapter_id": 10308, "verse_number": "११-७-१४", "content_sanskrit": "योगेश योगविन्यास योगात्मन् योगसम्भव।\nनिःश्रेयसाय मे प्रोक्तस्त्यागः संन्यासलक्षणः॥ ११/७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.017.m4a", "display_order": 18}, {"id": 6000308018, "chapter_id": 10308, "verse_number": "११-७-१५", "content_sanskrit": "त्यागोऽयं दुष्करो भूमन् कामानां विषयात्मभिः।\nसुतरां त्वयि सर्वात्मन्नभक्तैरिति मे मतिः॥ ११/७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.018.m4a", "display_order": 19}, {"id": 6000308019, "chapter_id": 10308, "verse_number": "११-७-१६", "content_sanskrit": "सोऽहं ममाहमिति मूढमतिर्विगाढस्त्वन्मायया विरचितात्मनि सानुबन्धे।\nतत्त्वञ्जसा निगदितं भवता यथाऽहं संसाधयामि भगवन्ननुशाधि भृत्यम्॥ ११/७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.019.m4a", "display_order": 20}, {"id": 6000308020, "chapter_id": 10308, "verse_number": "११-७-१७", "content_sanskrit": "सत्यस्य ते स्वदृश आत्मन आत्मनोऽन्यं वक्तारमीश विबुधेष्वपि नानुचक्षे।\nसर्वे विमोहितधियस्तव माययेमे ब्रह्मादयस्तनुभृतो बहिरर्थभावाः॥ ११/७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.020.m4a", "display_order": 21}, {"id": 6000308021, "chapter_id": 10308, "verse_number": "११-७-१८", "content_sanskrit": "तस्माद् भवन्तमनवद्यमनन्तपारं सर्वज्ञमीश्वरमखण्डविकुण्ठधिष्ण्यम्।\nनिर्वेदधीरहरहर्वृजिनाभितप्तो नारायणं नरसखं शरणं प्रपद्ये॥ ११/७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.021.m4a", "display_order": 22}, {"id": 6000308022, "chapter_id": 10308, "verse_number": null, "content_sanskrit": "श्री भगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.022.m4a", "display_order": 23}, {"id": 6000308023, "chapter_id": 10308, "verse_number": "११-७-१९", "content_sanskrit": "प्रायेण मनुजा लोके लोकतत्वविचक्षणाः।\nसमुद्धरन्ति ह्यात्मानमात्मनैवाशुभाशयात्॥ ११/७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.023.m4a", "display_order": 24}, {"id": 6000308024, "chapter_id": 10308, "verse_number": "११-७-२०", "content_sanskrit": "आत्मनो गुरुरात्मैव पुरुषस्य विशेषतः।\nयत् प्रत्यक्षानुमानाभ्यां श्रेयोऽसावनुविन्दते॥ ११/७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.024.m4a", "display_order": 25}, {"id": 6000308025, "chapter_id": 10308, "verse_number": "११-७-२१", "content_sanskrit": "पुरुषत्वे च मां धीराः सांख्ययोगविशारदाः।\nआविस्तारं प्रपश्यन्ति सर्वशक्त्युपबृंहितम्॥ ११/७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.025.m4a", "display_order": 26}, {"id": 6000308026, "chapter_id": 10308, "verse_number": "११-७-२२", "content_sanskrit": "एकद्वित्रिचतुष्पादो बहुपादस्तथाऽपदः।\nबह्व्यः सन्ति पुरः सृष्टास्तासां मे पौरुषी प्रिया॥ ११/७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.026.m4a", "display_order": 27}, {"id": 6000308027, "chapter_id": 10308, "verse_number": "११-७-२३", "content_sanskrit": "अत्र मां मार्गयन्त्यद्धा युक्ता हेतुभिरीश्वरम्।\nगृह्यमाणैरात्मलिङ्गैः स्वबाह्यमनुमानतः॥ ११/७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.027.m4a", "display_order": 28}, {"id": 6000308028, "chapter_id": 10308, "verse_number": "११-७-२४", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nअवधूतस्य संवादं यदोरमिततेजसः॥ ११/७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.028.m4a", "display_order": 29}, {"id": 6000308029, "chapter_id": 10308, "verse_number": "११-७-२५", "content_sanskrit": "अवधूतं द्विजं कञ्चिच्चरन्तमकुतोभयम्।\nकविं निरीक्ष्य निपुणं यदुः पप्रच्छ धर्मवित्॥ ११/७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.029.m4a", "display_order": 30}, {"id": 6000308030, "chapter_id": 10308, "verse_number": null, "content_sanskrit": "यदुरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.030.m4a", "display_order": 31}, {"id": 6000308031, "chapter_id": 10308, "verse_number": "११-७-२६", "content_sanskrit": "कुतो बुद्धिरियं ब्रह्मन्नकर्तुस्ते विशारदा।\nयामासाद्य भवान् लोकान् विद्वांश्चरति बालवत्॥ ११/७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.031.m4a", "display_order": 32}, {"id": 6000308032, "chapter_id": 10308, "verse_number": "११-७-२७", "content_sanskrit": "प्रायो धर्मार्थकामेषु विवित्सायां च मानवाः।\nहेतुनैव समीहन्ते आयुषो यशसः श्रियः॥ ११/७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.032.m4a", "display_order": 33}, {"id": 6000308033, "chapter_id": 10308, "verse_number": "११-७-२८", "content_sanskrit": "त्वं तु कल्पः कविर्दक्षः सुभगोऽमृतभाषणः।\nन कर्तुमीहसे किञ्चिज्जडोन्मत्तपिशाचवत्॥ ११/७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.033.m4a", "display_order": 34}, {"id": 6000308034, "chapter_id": 10308, "verse_number": "११-७-२९", "content_sanskrit": "जनेषु दह्यमानेषु कामलोभदवाग्निना।\nन तप्यसेऽग्निना मुक्तो गङ्गाम्भःस्थ इव द्विपः॥ ११/७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.034.m4a", "display_order": 35}, {"id": 6000308035, "chapter_id": 10308, "verse_number": "११-७-३०", "content_sanskrit": "त्वं हि नः पृच्छतां ब्रह्मन्नात्मन्यानन्दकारणम्।\nब्रूहि स्पर्शविहीनस्य भवतः केवलात्मनः॥ ११/७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.035.m4a", "display_order": 36}, {"id": 6000308036, "chapter_id": 10308, "verse_number": null, "content_sanskrit": "श्री भगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.036.m4a", "display_order": 37}, {"id": 6000308037, "chapter_id": 10308, "verse_number": "११-७-३१", "content_sanskrit": "यदुनैवं महाभागो ब्रह्मण्येन सुमेधसा।\nपृष्टः सभाजितः प्राह प्रश्रयावनतं द्विजः॥ ११/७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.037.m4a", "display_order": 38, "topics": [{"text": "अवधूतेन यदुं प्रति स्वस्य चतुर्विंशतिगुरूणां मध्ये अष्टभ्यः शिक्षितबुद्धिकथनम्", "range": "३१–७४"}]}, {"id": 6000308038, "chapter_id": 10308, "verse_number": null, "content_sanskrit": "ब्राह्मण उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.038.m4a", "display_order": 39}, {"id": 6000308039, "chapter_id": 10308, "verse_number": "११-७-३२", "content_sanskrit": "सन्ति मे गुरवो राजन् बहवो बुद्ध्युपाश्रिताः।\nयतो बद्धिमुपादाय मुक्तोऽटामीह तान् शृणु॥ ११/७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.039.m4a", "display_order": 40}, {"id": 6000308040, "chapter_id": 10308, "verse_number": "११-७-३३", "content_sanskrit": "पृथिवी वायुराकाश आपोऽग्निश्चन्द्रमा रविः।\nकपोतोऽजगरः सिन्धुः पतङ्गो मधुकृद् गजः॥ ११/७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.040.m4a", "display_order": 41}, {"id": 6000308041, "chapter_id": 10308, "verse_number": "११-७-३४", "content_sanskrit": "मधुहा हरिणो मीनः पिङ्गला कुररोऽर्भकः।\nकुमारी शरकृत् सर्प ऊर्णनाभिः सुपेशकृत्॥ ११/७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.041.m4a", "display_order": 42}, {"id": 6000308042, "chapter_id": 10308, "verse_number": "११-७-३५", "content_sanskrit": "एते मे गुरवो राजन् चतुर्विंशतिराश्रिताः।\nशिक्षावृत्तिभिरेतेषामन्वशिक्षमहं ततः॥ ११/७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.042.m4a", "display_order": 43}, {"id": 6000308043, "chapter_id": 10308, "verse_number": "११-७-३६", "content_sanskrit": "यतो यदनुशिक्षामि यथा वा नाहुषात्मज।\nतत् तथा पुरुषव्याघ्र निबोध कथयामि ते॥ ११/७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.043.m4a", "display_order": 44}, {"id": 6000308044, "chapter_id": 10308, "verse_number": "११-७-३७", "content_sanskrit": "भूतैराक्रम्यमाणोऽपि धीरो दैववशानुगैः।\nतद्विदांन चलेन्मार्गादनुशिक्षन् क्षितेर्व्रतम्॥ ११/७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.044.m4a", "display_order": 45}, {"id": 6000308045, "chapter_id": 10308, "verse_number": "११-७-३८", "content_sanskrit": "शश्वत् परार्थसर्वेहां परार्थैकान्तसम्भवम्।\nसाधुः शिक्षेत भूमेश्च अन्वशिक्षं व्रतान्तरम्॥ ११/७/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.045.m4a", "display_order": 46}, {"id": 6000308046, "chapter_id": 10308, "verse_number": "११-७-३९", "content_sanskrit": "प्राणवृत्त्यैव सन्तुष्यन् मुनिर्नैवेन्द्रियप्रियैः।\nज्ञानं यथा न नश्येत नावकीर्येत वाङ्मनः॥ ११/७/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.046.m4a", "display_order": 47}, {"id": 6000308047, "chapter_id": 10308, "verse_number": "११-७-४०", "content_sanskrit": "विषयेष्वाविशन् योगी नानाधर्मेषु सर्वतः।\nगुणदोषान्वयेनात्मा न विषज्जेत वायुवत्॥ ११/७/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.047.m4a", "display_order": 48}, {"id": 6000308048, "chapter_id": 10308, "verse_number": "११-७-४१", "content_sanskrit": "पार्थिवेष्विह देहेषु प्रविष्टस्तद्गुणाश्रयः।\nगुणैर्न युज्यते योगी गन्धैर्वायुरिवात्मदृक्॥ ११/७/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.048.m4a", "display_order": 49}, {"id": 6000308049, "chapter_id": 10308, "verse_number": "११-७-४२", "content_sanskrit": "अन्तर्बहिश्च स्थिरजङ्गमेषु ब्रह्मात्मभावेन समन्वयेन।\nव्याप्त्याऽव्यवच्छेदमसङ्गमात्मनो मुनिर्नभोवद् विततस्य भावयेत्॥ ११/७/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.049.m4a", "display_order": 50}, {"id": 6000308050, "chapter_id": 10308, "verse_number": "११-७-४३", "content_sanskrit": "तेजोऽम्ब्वन्नमयैर्भावैर्मेघाद्यैर्वायुनेरितैः।\nन स्पृश्यते नभस्तद्वत् कालसृष्टैर्गुणैः पुमान्॥ ११/७/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.050.m4a", "display_order": 51}, {"id": 6000308051, "chapter_id": 10308, "verse_number": "११-७-४४", "content_sanskrit": "स्वच्छः प्रकृतितः स्निग्धो माधुर्यस्तीर्थवन्नृणाम्।\nमुनिः पुनात्यघान्मित्रमीक्षणस्पर्शकीर्तनैः॥ ११/७/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.051.m4a", "display_order": 52}, {"id": 6000308052, "chapter_id": 10308, "verse_number": "११-७-४५", "content_sanskrit": "तेजस्वी तपसा दीप्तो दुर्धर्षो दूरभाजनः।\nसर्वभक्षोऽपि युक्तात्मा नादत्ते पापमग्निवत्॥ ११/७/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.052.m4a", "display_order": 53}, {"id": 6000308053, "chapter_id": 10308, "verse_number": "११-७-४६", "content_sanskrit": "क्‍वचिच्छन्नः क्‍वचित् स्पष्ट उपास्यः श्रेय इच्छताम्।\nभुङ्क्ते सर्वत्र दातॄणां दहन् प्रागुत्तराशुभम्॥ ११/७/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.053.m4a", "display_order": 54}, {"id": 6000308054, "chapter_id": 10308, "verse_number": "११-७-४७", "content_sanskrit": "स्वमायया सृष्टमिदं सदसल्लक्षणं विभुः।\nप्रविष्ट ईयते तत्तत्स्वरूपोऽग्निरिवैधसि॥ ११/७/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.054.m4a", "display_order": 55}, {"id": 6000308055, "chapter_id": 10308, "verse_number": "११-७-४८", "content_sanskrit": "विसर्गाद्याः श्मशानान्ता भावा देहस्य नात्मनः।\nकलानामिव चन्द्रस्य कालेनाव्यक्तवर्त्मना॥ ११/७/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.055.m4a", "display_order": 56}, {"id": 6000308056, "chapter_id": 10308, "verse_number": "११-७-४९", "content_sanskrit": "कालनद्योघवेगेन भूतानां प्रभवाप्ययौ।\nनित्यावपि न दृश्येते आत्मनोऽग्नेर्यथाऽर्चिषाम्॥ ११/७/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.056.m4a", "display_order": 57}, {"id": 6000308057, "chapter_id": 10308, "verse_number": "११-७-५०", "content_sanskrit": "गुणैर्गुणानुपादत्ते यथाकालं विमुञ्चति।\nन तेषु सज्जते योगी गोभिर्गा इव गोपतिः॥ ११/७/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.057.m4a", "display_order": 58}, {"id": 6000308058, "chapter_id": 10308, "verse_number": "११-७-५१", "content_sanskrit": "बुद्धिसंस्थेन भेदेन व्यक्तस्थ इव तद्गतः।\nलक्ष्यते स्थूलमतिभिरात्मा चाम्बुस्थितार्कवत्॥ ११/७/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.058.m4a", "display_order": 59}, {"id": 6000308059, "chapter_id": 10308, "verse_number": "११-७-५२", "content_sanskrit": "नातिस्नेहः प्रसङ्गो वा कर्तव्यः क्‍वापि केनचित्।\nकुर्वन् विन्देत सन्तापं कपोत इव दीनधीः॥ ११/७/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.059.m4a", "display_order": 60}, {"id": 6000308060, "chapter_id": 10308, "verse_number": "११-७-५३", "content_sanskrit": "कपोतः कश्चनारण्ये कृतनीडो वनस्पतौ।\nकपोत्या भार्यया सार्धमुवास कतिचित् समाः॥ ११/७/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.060.m4a", "display_order": 61}, {"id": 6000308061, "chapter_id": 10308, "verse_number": "११-७-५४", "content_sanskrit": "कपोतौ स्नेहगुणितहृदयौ गृहधर्मिणौ।\nदृष्टिं दृष्ट्याऽङ्गमङ्गेन बुद्धिं बुद्ध्या बबन्धतुः॥ ११/७/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.061.m4a", "display_order": 62}, {"id": 6000308062, "chapter_id": 10308, "verse_number": "११-७-५५", "content_sanskrit": "शय्यासनाटनस्थानवार्ताक्रीडाशनादिषु।\nमिथुनीभूय विस्रब्धौ चेरतुर्वनराजिषु॥ ११/७/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.062.m4a", "display_order": 63}, {"id": 6000308063, "chapter_id": 10308, "verse_number": "११-७-५६", "content_sanskrit": "यद्यद् वाञ्छति सा राजन् तदर्थमनुकम्पितः।\nतं तं समानयत् कामं कृच्छ्रेणाप्यजितेन्द्रियः॥ ११/७/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.063.m4a", "display_order": 64}, {"id": 6000308064, "chapter_id": 10308, "verse_number": "११-७-५७", "content_sanskrit": "कपोती प्रथमं गर्भं गृह्णती काल आगते।\nअण्डानि सुषुवे नीडे स्वपत्युः सन्निधौ सती॥ ११/७/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.064.m4a", "display_order": 65}, {"id": 6000308065, "chapter_id": 10308, "verse_number": "११-७-५८", "content_sanskrit": "तेषु काले व्यजायन्त रचितावयवा हरेः।\nशक्तिभिर्दुर्विभाव्याभिः कोमलाङ्गतनूरुहाः॥ ११/७/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.065.m4a", "display_order": 66}, {"id": 6000308066, "chapter_id": 10308, "verse_number": "११-७-५९", "content_sanskrit": "प्रजाः पुपुषतुः प्रीतौ दम्पती पुत्रवत्सलौ।\nशृण्वन्तौ कूजितं तासां रुवन्तौ कलभाषितैः॥ ११/७/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.066.m4a", "display_order": 67}, {"id": 6000308067, "chapter_id": 10308, "verse_number": "११-७-६०", "content_sanskrit": "तासां पतत्रैः सुस्पर्शैः कूजितैर्मुखचेष्टितैः।\nप्रत्युद्गमैरदीनानां पितरौ मुदमापतुः॥ ११/७/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.067.m4a", "display_order": 68}, {"id": 6000308068, "chapter_id": 10308, "verse_number": "११-७-६१", "content_sanskrit": "स्नेहबद्धानुहृदयावन्योन्यं विष्णुमायया।\nविमोहितौ दीनधियौ शिशून् पुपुषतुः प्रजाः॥ ११/७/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.068.m4a", "display_order": 69}, {"id": 6000308069, "chapter_id": 10308, "verse_number": "११-७-६२", "content_sanskrit": "एकदा जग्मतुस्तासामशनार्थं कुटुम्बिनौ।\nपरितः कानने तस्मिन्नर्थिनौ चेरतुश्चिरम्॥ ११/७/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.069.m4a", "display_order": 70}, {"id": 6000308070, "chapter_id": 10308, "verse_number": "११-७-६३", "content_sanskrit": "दृष्ट्वा तान् लुब्धकः कश्चिद् यदृच्छातो वनेचरः।\nजगृहे जालमातत्य चरतः स्वालयान्तिके॥ ११/७/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.070.m4a", "display_order": 71}, {"id": 6000308071, "chapter_id": 10308, "verse_number": "११-७-६४", "content_sanskrit": "कपोतश्च कपोती च प्रजापोषे सदोत्सुकौ।\nगतौ पोषणमादाय स्वनीडमुपजग्मतुः॥ ११/७/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.071.m4a", "display_order": 72}, {"id": 6000308072, "chapter_id": 10308, "verse_number": "११-७-६५", "content_sanskrit": "कपोती स्वात्मजान् वीक्ष्य बालकान् जालसंवृतान्।\nतानभ्यधावत् क्रोशन्ती क्रोशतो भृशदुःखिता॥ ११/७/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.072.m4a", "display_order": 73}, {"id": 6000308073, "chapter_id": 10308, "verse_number": "११-७-६६", "content_sanskrit": "साऽसकृत्स्नेहगुणिता दीनचित्ताऽजमायया।\nस्वयं चाबध्यत शिचा बद्धान् पश्यन्त्यपस्मृतिः॥ ११/७/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.073.m4a", "display_order": 74}, {"id": 6000308074, "chapter_id": 10308, "verse_number": "११-७-६७", "content_sanskrit": "कपोतश्चात्मजान् बद्धानात्मनोऽप्यधिकप्रियान्।\nभार्यां चात्मसमां दीनां विललापातिदुःखितः॥ ११/७/६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.074.m4a", "display_order": 75}, {"id": 6000308075, "chapter_id": 10308, "verse_number": "११-७-६८", "content_sanskrit": "अहो मे पश्यतापायमल्पपुण्यस्य दुर्मतेः।\nअतृप्तस्याकृतार्थस्य गृहास्‍त्रैवर्गिका हताः॥ ११/७/६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.075.m4a", "display_order": 76}, {"id": 6000308076, "chapter_id": 10308, "verse_number": "११-७-६९", "content_sanskrit": "अनुरूपाऽनुकूला च यस्य मे पतिदेवता।\nशून्ये गृहे मां संत्यज्य पुत्रैः स्वर्याति साधुभिः॥ ११/७/६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.076.m4a", "display_order": 77}, {"id": 6000308077, "chapter_id": 10308, "verse_number": "११-७-७०", "content_sanskrit": "सोऽहं शून्यगृहे दीनो मृतदारो मृतप्रजः।\nजिजीविषे किमर्थं वा विधुरो दुःखजीवनः॥ ११/७/७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.077.m4a", "display_order": 78}, {"id": 6000308078, "chapter_id": 10308, "verse_number": "११-७-७१", "content_sanskrit": "तांस्तथाऽऽवृतान् शिग्भिर्मृत्युग्रस्तान् विचेष्टतः।\nस्वयं च कृपणः शिक्षु पश्यन्नप्यबुधोऽपतत्॥ ११/७/७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.078.m4a", "display_order": 79}, {"id": 6000308079, "chapter_id": 10308, "verse_number": "११-७-७२", "content_sanskrit": "तं लब्ध्वा लुब्धकः क्रूरः कपोतं गृहमेधिनम्।\nकपोतकान् कपोतीं च सिद्धार्थः प्रययौ गृहम्॥ ११/७/७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.079.m4a", "display_order": 80}, {"id": 6000308080, "chapter_id": 10308, "verse_number": "११-७-७३", "content_sanskrit": "एवं कुटुम्ब्यशान्तात्मा द्वन्द्वारामः पतत्रिवत्।\nपुष्णन् कुटुम्बं कृपणः सानुबन्धोऽवसीदति॥ ११/७/७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.080.m4a", "display_order": 81}, {"id": 6000308081, "chapter_id": 10308, "verse_number": "११-७-७४", "content_sanskrit": "यः प्राप्य मानुषं लोकं मुक्तिद्वारमनावृतम्।\nगृहेषु खगवत् सक्तस्तमारूढच्युतं विदुः॥ ११/७/७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_007/BhP_11.007.081.m4a", "display_order": 82}, {"id": 6000308082, "chapter_id": 10308, "verse_number": null, "content_sanskrit": "॥ ॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे सप्तमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}]