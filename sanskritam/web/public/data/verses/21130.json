[{"id": 7001130000, "chapter_id": 21130, "verse_number": "२-२-२१-१", "content_sanskrit": "॥ नारद उवाच  ।\nसमीचीनं वचस्तात सर्वज्ञस्य तवाऽनघ ।\nमहाद्भुतं श्रुतं नो वै चरितं शिवयोश्शुभम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001130001, "chapter_id": 21130, "verse_number": "२-२-२१-२", "content_sanskrit": "विवाहश्च श्रुतस्सम्यक् सर्वमोहापहारकः ।\nपरमज्ञानसंपन्नो मंगलालय उत्तमः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001130002, "chapter_id": 21130, "verse_number": "२-२-२१-३", "content_sanskrit": "भूय एव विवित्सा मे चरितं शिवयोश्शुभम् ।\nतद्वर्णय महाप्राज्ञ कृपां कृत्वाऽतुलामरम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001130003, "chapter_id": 21130, "verse_number": "२-२-२१-४", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nसम्यक्कारुणिकस्यैव मुने ते विचिकित्सितम् ।\nयदहं नोदितस्सौम्य शिवलीलानुवर्णने॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001130004, "chapter_id": 21130, "verse_number": "२-२-२१-५", "content_sanskrit": "विवाह्य दक्षजां देवीं सतीं त्रैलोक्यमातरम् ।\nगत्वा स्वधाम सुप्रीत्या यदकार्षीन्निबोध मे॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001130005, "chapter_id": 21130, "verse_number": "२-२-२१-६", "content_sanskrit": "ततो हरस्स स्वगणस्स्वस्थानं प्राप्य मोदनम ।\nदेवर्षे तत्र वृषभादवातरदतिप्रियात्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001130006, "chapter_id": 21130, "verse_number": "२-२-२१-७", "content_sanskrit": "यथायोग्यं निजस्थानं प्रविश्य स सतीसखः ।\nमुमुदेऽतीव देवर्षे भवाचारकरश्शिवः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001130007, "chapter_id": 21130, "verse_number": "२-२-२१-८", "content_sanskrit": "ततो विरूपाक्ष इमां प्राप्य दाक्षायणीं गणान् ।\nस्वीयानिर्यापयामास नद्यादीन् गिरिकंदरात्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001130008, "chapter_id": 21130, "verse_number": "२-२-२१-९", "content_sanskrit": "उवाच चैतास्तान् सर्वान्नंद्यादीनतिसूनृतम् ।\nलौकिकीं रीतिमाश्रित्य करुणासागरः प्रभुः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001130009, "chapter_id": 21130, "verse_number": "२-२-२१-१०", "content_sanskrit": "महेश उवाच ।\nयदाहं च स्मराम्यत्र स्मरणादरमानसाः ।\nसमागमिष्यथ तदा मत्पार्श्वं मे गणा द्रुतम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001130010, "chapter_id": 21130, "verse_number": "२-२-२१-११", "content_sanskrit": "इत्युक्ते वामदेवेन नद्याद्यास्स्वगणाश्च ते ।\nमहावेगा महावीरा नानास्थानेषु संययुः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001130011, "chapter_id": 21130, "verse_number": "२-२-२१-१२", "content_sanskrit": "ईश्वरोपि तया सार्द्धं तेषु यातेषु विभ्रमी ।\nदाक्षायण्या समं रेमे रहस्ये मुदितो भृशम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001130012, "chapter_id": 21130, "verse_number": "२-२-२१-१३", "content_sanskrit": "कदाचिद्वन्य पुष्पाणि समाहृत्य मनोहराम् ।\nमालां विधाय सत्यास्तु हारस्थाने स योजयत्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001130013, "chapter_id": 21130, "verse_number": "२-२-२१-१४", "content_sanskrit": "कदाचिद्दर्पणे चैव वीक्षतीमात्मनस्सतीम् ।\nअनुगम्य हरो वक्त्रम् स्वीयमप्यवलोकयत॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001130014, "chapter_id": 21130, "verse_number": "२-२-२१-१५", "content_sanskrit": "कदाचित्कुंडलं तस्या उल्लास्योल्लास्य संगतः ।\nबध्नाति मोचयत्येव सा स्वयं मार्जयत्यपि॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001130015, "chapter_id": 21130, "verse_number": "२-२-२१-१६", "content_sanskrit": "सरागौ चरणावस्याः पावकेनोज्ज्वलेन च ।\nनिसर्गरक्तौ कुरुते पूर्णरागौ वृषध्वजः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001130016, "chapter_id": 21130, "verse_number": "२-२-२१-१७", "content_sanskrit": "उच्चैरपि यदाख्येयमन्येषां पुरतो बहु ।\nतत कर्णे कथयत्त्यस्याहरो द्रष्टुं तदाननम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001130017, "chapter_id": 21130, "verse_number": "२-२-२१-१८", "content_sanskrit": "न दूरमपि गन्तासौ समागत्य प्रयत्नतः ।\nअनुबध्नाति नामाक्षी पृष्ठदेशेन्यमानसाम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001130018, "chapter_id": 21130, "verse_number": "२-२-२१-१९", "content_sanskrit": "अंतर्हितस्तु तत्रैव मायया वृषभध्वजः ।\nतामालिलिंग भीत्या स्वं चकिता व्याकुलाऽभवत्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001130019, "chapter_id": 21130, "verse_number": "२-२-२१-२०", "content_sanskrit": "सौवर्णपद्मकलिकातुल्ये तस्या कुचद्वये ।\nचकार भ्रमराकारं मृगनाभिविशेषकम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001130020, "chapter_id": 21130, "verse_number": "२-२-२१-२१", "content_sanskrit": "हारमस्याः कुचयुगाद्वियोज्य सहसा हरः ।\nन्ययोजयच्च तत्रैव स्वकरस्पर्शनं मुहुः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001130021, "chapter_id": 21130, "verse_number": "२-२-२१-२२", "content_sanskrit": "अंगदान्वलयानूर्मान्विश्लेष्य च पुनः पुनः ।\nतत्स्थानात्पुनरेवासौ तत्स्थाने प्रत्ययोजयत्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001130022, "chapter_id": 21130, "verse_number": "२-२-२१-२३", "content_sanskrit": "कालिकेति समायाति सवर्णा ते सखी त्विमाम् ।\nयास्यत्वस्यास्तथेक्षंत्याः प्रोत्तुंगौ साहसं कुचौ॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001130023, "chapter_id": 21130, "verse_number": "२-२-२१-२४", "content_sanskrit": "कदाचिन्मदनोन्मादचेतनः प्रमथाधिपः ।\nचकार नर्म शर्माणि तथाकृत्प्रियया मुदा॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001130024, "chapter_id": 21130, "verse_number": "२-२-२१-२५", "content_sanskrit": "आहृत्य पद्मपुष्पाणि रम्यपुष्पाणि शंकरः ।\nसर्वांगेषु करोति स्म पुष्पाभरणमादरात्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001130025, "chapter_id": 21130, "verse_number": "२-२-२१-२६", "content_sanskrit": "गिरिकुंजेषु रम्येषु सत्या सह महेश्वरः ।\nविजहार समस्तेषु प्रियया भक्तवत्सलः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001130026, "chapter_id": 21130, "verse_number": "२-२-२१-२७", "content_sanskrit": "तया विना स्म नो याति नास्थितो न स्म चेष्टते ।\nतया विना क्षममपि शर्म लेभे न शंकरः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001130027, "chapter_id": 21130, "verse_number": "२-२-२१-२८", "content_sanskrit": "विहृत्य सुचिरं कालं कैलासगिरिकुंजरे ।\nअगमद्धिमवत्प्रस्थं सस्मार स्वेच्छया स्मरन्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001130028, "chapter_id": 21130, "verse_number": "२-२-२१-२९", "content_sanskrit": "तस्मिन्प्रविष्टे कामे तु वसंतश्शंकरांतिके ।\nवितस्तार निजं भावं हार्दं विज्ञाय यत्प्रभो॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001130029, "chapter_id": 21130, "verse_number": "२-२-२१-३०", "content_sanskrit": "सर्वे च पुष्पिता वृक्षा लताश्चान्याश्च पुष्पिताः ।\nअंभांसि फुल्लपद्मानि पद्मास्सभ्रमरास्तथा॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001130030, "chapter_id": 21130, "verse_number": "२-२-२१-३१", "content_sanskrit": "प्रविष्टे तत्र सदृतौ ववौ स मलयो मरुत् ।\nसुगंधिगंधपुष्पेण मोदकश्च सुगंधियुक्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001130031, "chapter_id": 21130, "verse_number": "२-२-२१-३२", "content_sanskrit": "संध्यार्द्रचन्द्रसंकाशाः पलाशाश्च विरेजिरे ।\nकामास्त्रवत्सुमनसः प्रमोदात्पादपाधरः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001130032, "chapter_id": 21130, "verse_number": "२-२-२१-३३", "content_sanskrit": "बभुः पंकजपुष्पाणि सरस्सु संकलाञ्जनान् ।\nसंमोहयितुमुद्युक्ता सुमुखी वायुदेवता॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001130033, "chapter_id": 21130, "verse_number": "२-२-२१-३४", "content_sanskrit": "नागकेशरवृक्षाश्च स्वर्णवर्णैः प्रसूनकैः ।\nबभुर्मदनकेत्वाभा मनोज्ञाश्शंकरांतिके॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001130034, "chapter_id": 21130, "verse_number": "२-२-२१-३५", "content_sanskrit": "लवंगवल्लीसुरभिगंधेनोद्वास्य मारुतम् ।\nमोहयामास चेतांसि भृशं कामिजने पुरा॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001130035, "chapter_id": 21130, "verse_number": "२-२-२१-३६", "content_sanskrit": "चारु पावकचर्चित्सु सुस्वराश्चूतशालिनः ।\nबभुर्मदनबाणौघपर्यंकमदनावृताः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001130036, "chapter_id": 21130, "verse_number": "२-२-२१-३७", "content_sanskrit": "अंभांसि मलहीनानि रेजुः फुल्लकुशाशयाः ।\nमुनीनामिव चेतांसि प्रव्यक्तज्योतिरुद्गमम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001130037, "chapter_id": 21130, "verse_number": "२-२-२१-३८", "content_sanskrit": "तुषारास्सूर्यरश्मीनां संगमादगमन् बहिः ।\nप्रमत्वानीक्ष्यतेक्षाश्च सलिलीहृदयास्तदा॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001130038, "chapter_id": 21130, "verse_number": "२-२-२१-३९", "content_sanskrit": "प्रसन्नास्सह चन्द्रेण ननिषारास्तदाऽभवन् ।\nविभावर्यः प्रियेणैवं कामिन्यस्तु मनोहराः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001130039, "chapter_id": 21130, "verse_number": "२-२-२१-४०", "content_sanskrit": "तस्मिन्काले महादेवस्सह सत्या धरोत्तमे ।\nरेमे स सुचिरं छन्दं निकुंजेषु नदीषु च॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001130040, "chapter_id": 21130, "verse_number": "२-२-२१-४१", "content_sanskrit": "तथा तेन समं रेजे तदा दाक्षायिणि मुने ।\nयथा हरः क्षणमपि शांतिमाप तया विना॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001130041, "chapter_id": 21130, "verse_number": "२-२-२१-४२", "content_sanskrit": "संभोगविषये देवी सती तस्य मनः प्रिया ।\nविशतीव हरस्यांगे पाययन्निव तद्रसम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001130042, "chapter_id": 21130, "verse_number": "२-२-२१-४३", "content_sanskrit": "तस्या कुसुममालाभिर्भूषयन्सकलां तनुम् ।\nस्वहस्तरचिताभिस्तु नवशर्माकरोच्च सः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001130043, "chapter_id": 21130, "verse_number": "२-२-२१-४४", "content_sanskrit": "आलापैर्वीक्षितैर्हास्यैस्तथा संभाषणैर्हरः ।\nतस्यादिदेश गिरिजां सपतीवात्मसंविदम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001130044, "chapter_id": 21130, "verse_number": "२-२-२१-४५", "content_sanskrit": "तद्वक्त्रचंद्र पीयूषपानस्थिरतनुर्हरः ।\nनानावैशेषिकीं तन्वीमवस्थां स कदाचन॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001130045, "chapter_id": 21130, "verse_number": "२-२-२१-४६", "content_sanskrit": "तद्वक्त्राम्बुजवासेन तत्सौन्दर्य्यैश्च नर्मभिः ।\nगुणैरिव महादंती बद्धो नान्यविचेष्टितः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001130046, "chapter_id": 21130, "verse_number": "२-२-२१-४७", "content_sanskrit": "इति हिमगिरिकुंजप्रस्थभागे दरीषु प्रतिदिनमभिरेमे दक्षपुत्र्या महेशः ।\nक्रतुभुजपरिमाणैः क्रीडतस्तस्य जाता दश दश च सुरर्षे वत्सराः पंच चान्ये॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]