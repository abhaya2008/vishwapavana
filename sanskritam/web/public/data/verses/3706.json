[{"id": 2126345, "chapter_id": 3706, "verse_number": "", "content_sanskrit": "नळदमयन्तीसंवादः देवैः संवादो दौत्यकरणं च ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2126346, "chapter_id": 3706, "verse_number": "", "content_sanskrit": "बृहदश्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2126347, "chapter_id": 3706, "verse_number": "१", "content_sanskrit": "सा नमस्कृत्य देवेभ्यः प्रहसन्तीदमब्रवीत् ।\nप्रणयं भावयन्त्यस्मिन् राजन् किं करवाणि ते\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2126348, "chapter_id": 3706, "verse_number": "२", "content_sanskrit": "अहं चैव हि यच्चान्यन्ममास्ति वसु किञ्चन ।\nसर्वं तत् तव विस्रब्धं कुरु प्रणयमीश्वर \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2126349, "chapter_id": 3706, "verse_number": "३", "content_sanskrit": "हंसानां वचनं यत्तत् तन्मां दहति पार्थिव ।\nत्वत्कृते हि मया वीर राजानः सन्निपातिताः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2126350, "chapter_id": 3706, "verse_number": "४", "content_sanskrit": "यदि चेद् भजमानां मां प्रत्याख्यास्यसि मानद ।\nविषमग्निं जलं रज्जुमास्थास्ये तव कारणात् ।\nएवमुक्तस्तु वैदर्भ्या नळस्तां प्रत्युवाच ह\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2126351, "chapter_id": 3706, "verse_number": "५", "content_sanskrit": "तिष्ठत्सु लोकपालेषु कथं मानुषमिच्छसि ।\nयेषामहं लोकपानामीश्वराणां महात्मनाम् ।\nन पादरजसा तुल्यो मनस्ते तेषु वर्तताम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2126352, "chapter_id": 3706, "verse_number": "६", "content_sanskrit": "विप्रियं ह्याचरन् मर्त्यो देवानां मृत्युमृच्छति ।\nत्राहि मामनवद्याङ्गि वरयस्व सुरोत्तमान्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2126353, "chapter_id": 3706, "verse_number": "७", "content_sanskrit": "ततो बाष्पाकुलां वाचं दमयन्ती शुचिस्मिता ।\nप्रव्याहरन्ती शनकैर्नळं राजानमब्रवीत् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2126354, "chapter_id": 3706, "verse_number": "८", "content_sanskrit": "अस्त्युपायो मया दृष्टो निरपायो नरेश्वर ।\nयेन दोषो न भविता तव राजन् कथञ्चन \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2126355, "chapter_id": 3706, "verse_number": "९", "content_sanskrit": "त्वं चैव हि नरश्रेष्ठ देवाश्चेन्द्रपुरोगमाः ।\nआयान्तु सहिताः सर्वे मम यत्र स्वयंवरः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2126356, "chapter_id": 3706, "verse_number": "१०", "content_sanskrit": "ततोऽहं लोकपालानां सन्निधौ त्वां नरेश्वर ।\nवरयिष्ये नरश्रेष्ठ नैष दोषो भविष्यति\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2126357, "chapter_id": 3706, "verse_number": "", "content_sanskrit": "बृहदश्व", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2126358, "chapter_id": 3706, "verse_number": "११", "content_sanskrit": "एवमुक्तस्तु वैदर्भ्या नळो राजा विशांपते ।\nआजगाम पुनस्तत्र यत्र देवाः सवासवाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2126359, "chapter_id": 3706, "verse_number": "१२", "content_sanskrit": "तमपश्यन्नथायान्तं लोकपाला महेश्वराः ।\nदृष्ट्वा चैनं ततोऽपृच्छन् वृत्तान्तं सर्वमेव तत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2126360, "chapter_id": 3706, "verse_number": "१३", "content_sanskrit": "कच्चिद् दृष्टा त्वया राजन् दमयन्ती शुचिस्मिता ।\nकिमब्रवीच्च नः सर्वान् वद भूमिपतेऽनघ\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2126361, "chapter_id": 3706, "verse_number": "", "content_sanskrit": "नळः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2126362, "chapter_id": 3706, "verse_number": "१४", "content_sanskrit": "भवद्भिरहमादिष्टो दमयन्त्या निवेशनम् ।\nप्रविष्टः सुमहाकक्ष्यं दण्डिभिः स्थविरैर्वृतम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2126363, "chapter_id": 3706, "verse_number": "१५", "content_sanskrit": "प्रविशन्तं च मां तत्र न कश्चिद् दृष्टवान्नरः ।\nऋते तां पार्थिवसुतां भवतामेव तेजसा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2126364, "chapter_id": 3706, "verse_number": "१६", "content_sanskrit": "सख्यश्चास्या मया दृष्टाः ताभिश्चाप्युपलक्षितः ।\nविस्मिताश्चाभवन् दृष्ट्वा सर्वा मां विबुधेश्वराः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2126365, "chapter_id": 3706, "verse_number": "१७", "content_sanskrit": "वर्ण्यमानेषु च मया भवत्सु रुचिरानना ।\nमामेव गतसङ्कल्पा वृणीते सुरसत्तमाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2126366, "chapter_id": 3706, "verse_number": "१८", "content_sanskrit": "अब्रवीच्चैव मां बाला आयान्तु सुरसत्तमाः ।\nत्वया सह नरश्रेष्ठ मम यत्र स्वयंवरः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2126367, "chapter_id": 3706, "verse_number": "१९", "content_sanskrit": "तेषामहं सन्निधौ त्वां वरयिष्ये नरोत्तमम् ।\nएवं तव महाबाहो दोषो न भवितेति ह \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2126368, "chapter_id": 3706, "verse_number": "२०", "content_sanskrit": "एतावदेव विबुधा यथावृत्तमुदाहृतम् ।\nमयाऽशेषं प्रमाणं तु भवन्तः सुरसत्तमाः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2126369, "chapter_id": 3706, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि अष्टचत्वारिंशोऽध्यायः ॥४८॥ ॥ तीर्थयात्रापर्वणि चतुर्थोऽध्यायः ॥४॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]