[{"id": 2178624, "chapter_id": 4779, "verse_number": "", "content_sanskrit": "गान्धारी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2178625, "chapter_id": 4779, "verse_number": "१", "content_sanskrit": "एष शल्यो हतः शेते साक्षान्नकुलमातुलः ।\nधर्मज्ञेन सता तात धर्मराजेन संयुगे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2178626, "chapter_id": 4779, "verse_number": "२", "content_sanskrit": "यस्त्वया स्पर्धते नित्यं सर्वत्र मधुसूदन ।\nस एष निहतः शेते मद्रराजो महाबलः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2178627, "chapter_id": 4779, "verse_number": "३", "content_sanskrit": "जयद्रथे यदि ब्रूयुरपराधं कथञ्चन ।\nमद्रपुत्रे कथं ब्रूयुरपराधं विवक्षवः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2178628, "chapter_id": 4779, "verse_number": "४", "content_sanskrit": "तेन सङ्गृह्णता तात रथमाधिरथेर्युधि ।\nजयार्थं पाण्डुपुत्राणां तथा तेजोवधः कृतः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2178629, "chapter_id": 4779, "verse_number": "५", "content_sanskrit": "अहो धिक् पश्य शल्यस्य पूर्णचन्द्रसुदर्शनम् ।\nमुखं पद्मपलाशाक्षं काकैरादष्टमव्रणम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2178630, "chapter_id": 4779, "verse_number": "६", "content_sanskrit": "एषा चामीकराभस्य तप्तकाञ्चनसप्रभा ।\nआस्याद् विनिःसृता जिह्वा भक्ष्यते कृष्णपक्षिभिः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2178631, "chapter_id": 4779, "verse_number": "७", "content_sanskrit": "युधिष्ठिरेण निहतं शल्यं समितिशोभनम् ।\nरुदन्त्यः पर्युपासन्ते मद्रराजकुलाङ्गनाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2178632, "chapter_id": 4779, "verse_number": "८", "content_sanskrit": "एताः सुसूक्ष्मवसना मद्रराजं नरर्षभम् ।\nक्रोशन्त्यभिसमासाद्य क्षत्रियाः क्षत्रियर्षभम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2178633, "chapter_id": 4779, "verse_number": "९", "content_sanskrit": "शल्यं निपतितं नार्यः परिवार्याभितः स्थिताः ।\nवाशितागृष्टयः पङ्के परिमग्नमिवार्षभम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2178634, "chapter_id": 4779, "verse_number": "१०", "content_sanskrit": "शल्यं शरणदं शूरं पश्यैनं रथसत्तमम् ।\nशयानं वीरशयने शरैर्विशकलीकृतम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2178635, "chapter_id": 4779, "verse_number": "११", "content_sanskrit": "एष शैलालयो राजा भगदत्तः प्रतापवान् ।\nगजाङ्कुशधरः श्रीमान् शेते युधि निपातितः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2178636, "chapter_id": 4779, "verse_number": "१२", "content_sanskrit": "यस्य रुग्ममयी माला शिरस्येषा विराजते ।\nश्वापदैर्भक्ष्यमाणस्य शोभयत्येव मूर्धजान्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2178637, "chapter_id": 4779, "verse_number": "१३", "content_sanskrit": "एतेन किल पार्थस्य युद्धमासीत् सुदारुणम् ।\nरोमहर्षणमत्युग्रं शक्रस्य बलिना यथा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2178638, "chapter_id": 4779, "verse_number": "१४", "content_sanskrit": "योधयित्वा महाबाहुरेष पार्थं धनञ्जयम् ।\nसंशयं गमयित्वा च कुन्तीपुत्रेण पातितः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2178639, "chapter_id": 4779, "verse_number": "१५", "content_sanskrit": "यस्य नास्ति समो लोके शौर्ये वीर्ये च कश्चन ।\nस एष निहतः शेते भीष्मो भीमकृदाहवे\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2178640, "chapter_id": 4779, "verse_number": "१६", "content_sanskrit": "पश्य शान्तनवं कृष्ण शयानं सूर्यवर्चसम् ।\nयुगान्त इव कालेन पातितं सूर्यमम्बरात्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2178641, "chapter_id": 4779, "verse_number": "१७", "content_sanskrit": "एष जित्वा रणे शत्रून् शस्त्रपातेन वीर्यवान् ।\nनरसूर्योऽस्तमभ्येति सूर्योऽस्तमिव केशव\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2178642, "chapter_id": 4779, "verse_number": "१८", "content_sanskrit": "शरतल्पगतं वीरं धर्मे देवर्षिणा समम् ।\nशयानं वीरशयने पश्य शूरनिषेविते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2178643, "chapter_id": 4779, "verse_number": "१९", "content_sanskrit": "कर्णिनालीकनाराचैरास्तीर्य शयनोत्तमम् ।\nआविश्य शेते भगवान् स्कन्दः शरवणं यथा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2178644, "chapter_id": 4779, "verse_number": "२०", "content_sanskrit": "अतूलपूर्णं गाङ्गेयः त्रिभिर्बाणैः समन्वितम् ।\nउपधायोपधानार्थं दत्तं गाण्डीवधन्वना\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2178645, "chapter_id": 4779, "verse_number": "२१", "content_sanskrit": "पालयानः पितुःशास्त्रमूर्ध्वरेता महायशाः ।\nएष शान्तनवः शेते माधवाप्रतिमो रथः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2178646, "chapter_id": 4779, "verse_number": "२२", "content_sanskrit": "धर्मात्मा तात सर्वज्ञः पारम्पर्येऽथ निर्णये ।\nअमर्त्य इव मर्त्यः सन्नेष प्राणानधारयत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2178647, "chapter_id": 4779, "verse_number": "२३", "content_sanskrit": "नास्ति युद्धे समः कश्चिन्न विद्यासु पराक्रमे ।\nयत्र शान्तनवो भीष्मः शेतेऽद्य निहतः परैः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2178648, "chapter_id": 4779, "verse_number": "२४", "content_sanskrit": "स्वयमेतेन शूरेण पृच्छ्यमानेन पाण्डवैः ।\nधर्मज्ञेनाहवे मृत्युः आख्यातः सत्यवादिना\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2178649, "chapter_id": 4779, "verse_number": "२५", "content_sanskrit": "प्रनष्टः कुरुवंशः स पुनर्येन समुद्धृतः ।\nस गतः कुरुभिः सार्धं महाबुद्धिः पराजयम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2178650, "chapter_id": 4779, "verse_number": "२६", "content_sanskrit": "धर्मेण कुरवः कं नु परिप्रक्ष्यन्ति माधव ।\nहते देवव्रते भीष्मे देवकल्पे नरर्षभे\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2178651, "chapter_id": 4779, "verse_number": "२७", "content_sanskrit": "अर्जुनस्य विनेतारमाचार्यं सात्यकेस्तथा ।\nतं पश्य पतितं द्रोणं कुरूणां गुरुसत्तमम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2178652, "chapter_id": 4779, "verse_number": "२८", "content_sanskrit": "अस्त्रं चतुर्विधं वेद यथैव त्रिदशेश्वरः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2178653, "chapter_id": 4779, "verse_number": "२९", "content_sanskrit": "विधिपादो मन्त्रपादः पूजापादस्तथैव च ।\nरहस्यपाद इत्येतत् प्रोक्तं पादचतुष्टयम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2178654, "chapter_id": 4779, "verse_number": "३०", "content_sanskrit": "पैशाचमासुरं गान्धर्वं मानुषं च चतुर्विधम् ।\nभार्गवो वा महावीर्यस्तथा द्रोणोऽपि माधव\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2178655, "chapter_id": 4779, "verse_number": "३१", "content_sanskrit": "यस्य प्रसादाद् बीभत्सुः पाण्डवः कर्म दुष्करम् ।\nचकार स हतः शेते नैनमस्त्राण्यपालयन्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2178656, "chapter_id": 4779, "verse_number": "३२", "content_sanskrit": "यं पुरोधाय कुरव आह्वयन्ति स्म पाण्डवान् ।\nसोऽयमस्त्रभृतां श्रेष्ठो द्रोणः शस्त्रैः पृथक् कृतः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2178657, "chapter_id": 4779, "verse_number": "३३", "content_sanskrit": "यस्य निर्दहतः सेनां गतिरग्नेरिवाभवत् ।\nस भूमौ निहतः शेते शान्तार्चिरिव पावकः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2178658, "chapter_id": 4779, "verse_number": "३४", "content_sanskrit": "धनुर्मुष्टिरशीर्णश्च हस्तावापश्च माधव ।\nद्रोणस्य निहतस्यापि ददृशे जीवतो यथा\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2178659, "chapter_id": 4779, "verse_number": "३५", "content_sanskrit": "वेदाश्च यस्माच्चत्वारः सर्वास्त्राणि च केशव ।\nअनपेतानि वै शूराद् यथैवाऽऽदौ प्रजापतेः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2178660, "chapter_id": 4779, "verse_number": "३६", "content_sanskrit": "वन्दनार्हाविमौ तस्य वन्दिभिर्वन्दितौ शुभौ ।\nगोमायवो विकर्षन्ति पादौ क्षत्रशतार्चितौ\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2178661, "chapter_id": 4779, "verse_number": "३७", "content_sanskrit": "द्रोणं द्रुपदपुत्रेण निहतं मधुसूदन ।\nकृपी कृपणमन्वास्ते दुःखोपहतचेतना\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2178662, "chapter_id": 4779, "verse_number": "३८", "content_sanskrit": "तां पश्य रुदतीमार्तां मुक्तकेशीमधोमुखीम् ।\nहतं पतिमुपास्यन्तीं द्रोणं शस्त्रभृतां वरम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2178663, "chapter_id": 4779, "verse_number": "३९", "content_sanskrit": "बाणैर्भिन्नतनुत्राणं धृष्टद्युम्नेन केशव ।\nउपासते मृधे द्रोणं जटिला ब्रह्मचारिणी\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2178664, "chapter_id": 4779, "verse_number": "४०", "content_sanskrit": "प्रेतकृत्ये च यतते कृपी कृपणमातुरा ।\nहतस्य समरे भर्तुः सुकुमारी यशस्विनी\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2178665, "chapter_id": 4779, "verse_number": "४१", "content_sanskrit": "अग्नीनाहृत्य विधिवत् चितां प्रज्वाल्य सर्वशः ।\nद्रोणमादाय गायन्ति त्रीणि सामानि गायकाः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2178666, "chapter_id": 4779, "verse_number": "४२", "content_sanskrit": "किरन्ति च चितामेते जटिला ब्रह्मचारिणः ।\nधनुर्भिः शक्तिभिश्चैव रथनीडैश्च माधव\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2178667, "chapter_id": 4779, "verse_number": "४३", "content_sanskrit": "शस्त्रैश्च विविधैरन्यैर्धक्ष्यन्तो भूरितेजसम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2178668, "chapter_id": 4779, "verse_number": "४४", "content_sanskrit": "त एते द्रोणमाधाय गायन्ति च रुदन्ति च ।\nसामभिस्त्रिभिरन्तस्थैरनुशंसन्ति चापरे\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2178669, "chapter_id": 4779, "verse_number": "४५", "content_sanskrit": "अग्नावग्निमिवाधाय द्रोणं हुत्वा हुताशने ।\nगच्छन्त्यभिमुखा गङ्गां द्रोणशिष्या द्विजातयः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2178670, "chapter_id": 4779, "verse_number": "४६", "content_sanskrit": "अपसव्यां चितां कृत्वा पुरस्कृत्य कृपीं तथा\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2178671, "chapter_id": 4779, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां स्त्रीपर्वणि\nशल्यभीष्मद्रोणदर्शनं नाम त्रयोविंशोऽध्यायः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2178672, "chapter_id": 4779, "verse_number": "", "content_sanskrit": "स्त्रीपर्वणि अष्टमोऽध्यायः ॥८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]