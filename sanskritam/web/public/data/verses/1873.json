[{"id": 2039572, "chapter_id": 1873, "verse_number": "५-११८-०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039573, "chapter_id": 1873, "verse_number": "५-११८-१", "content_sanskrit": "तथैव तां श्रियं त्यक्त्वा कन्या भूत्वा यशस्विनी ।\nमाधवी गालवं विप्रमभ्ययात्सत्यसङ्गरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039574, "chapter_id": 1873, "verse_number": "५-११८-२", "content_sanskrit": "गालवो विमृशन्नेव स्वकार्यगतमानसः ।\nजगाम भोजनगरं द्रष्टुमौशीनरं नृपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039575, "chapter_id": 1873, "verse_number": "५-११८-३", "content_sanskrit": "तमुवाचाथ गत्वा स नृपतिं सत्यविक्रमम्।\nइय कन्या सुतौ द्वौ ते जनयिष्यति पार्थिवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039576, "chapter_id": 1873, "verse_number": "५-११८-४", "content_sanskrit": "अस्यां भवानवाप्तार्थो भविता प्रेत्य चेह च।\nसोमार्कप्रतिसङ्काशौ जनयित्वा सुतौ नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039577, "chapter_id": 1873, "verse_number": "५-११८-५", "content_sanskrit": "शुल्कं तु सर्वधर्मज्ञ हयानां चन्द्रवर्चसाम्।\nएकतःश्यामकर्णानां देयं मह्यं चतुःशतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039578, "chapter_id": 1873, "verse_number": "५-११८-६", "content_sanskrit": "गुर्वर्थोऽयं समारम्भो न हयैः कृत्यमस्ति मे।\nयदि शक्यं महाराज क्रियतामविचारितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039579, "chapter_id": 1873, "verse_number": "५-११८-७", "content_sanskrit": "अनपत्योऽसि राजर्षे पुत्रौ जनय पार्थिव ।\nपितॄन्पुत्रप्लवेन त्वमात्मानं चैव तारय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039580, "chapter_id": 1873, "verse_number": "५-११८-८", "content_sanskrit": "न पुत्रफलभोक्ता हि राजर्षे पात्यते दिवः।\nन याति नरकं घोरं यत्र गच्छन्त्यनात्मजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039581, "chapter_id": 1873, "verse_number": "५-११८-९", "content_sanskrit": "एतच्चान्यच्च विविधं श्रुत्वा गालवभाषितम् ।\nउशीनरः प्रतिवचो ददौ तस्य नराधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039582, "chapter_id": 1873, "verse_number": "५-११८-१०", "content_sanskrit": "श्रुतवानस्मि ते वाक्यं यथा वदसि गालव ।\nविधिस्तु बलवान्ब्रह्मन्प्रवणं हि मनो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039583, "chapter_id": 1873, "verse_number": "५-११८-११", "content_sanskrit": "शते द्वे तु ममाश्वानामीदृशानां द्विजोत्तम।\nइतरेषां सहस्राणि सुबहूनि चरन्ति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039584, "chapter_id": 1873, "verse_number": "५-११८-१२", "content_sanskrit": "अहमप्येकमेवास्यां जनयिष्यामि गालव ।\nपुत्रवद्भिर्गतं मार्गं गमिष्यामि परैरहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039585, "chapter_id": 1873, "verse_number": "५-११८-१३", "content_sanskrit": "मूल्येनापि समं कुर्यां तवाहं द्विजसत्तम।\nपौरजानपदार्थं तु ममार्थो नात्मभोगतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039586, "chapter_id": 1873, "verse_number": "५-११८-१४", "content_sanskrit": "कामतो हि धनं राजा पारक्यं यः प्रयच्छति।\nन स धर्मेण धर्मात्मन्युज्यते यशसा न च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039587, "chapter_id": 1873, "verse_number": "५-११८-१५", "content_sanskrit": "सोऽहं प्रतिग्रहीष्यामि ददात्वेतां भवान्मम ।\nकुमारीं देवगर्भाभामेकपुत्रभवाय मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039588, "chapter_id": 1873, "verse_number": "५-११८-१६", "content_sanskrit": "तथा तु बहुधा कन्यामुक्तवन्तं नराधिपम् ।\nउशीनरं द्विजश्रेष्ठो गालवः प्रत्यपूजयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039589, "chapter_id": 1873, "verse_number": "५-११८-१७", "content_sanskrit": "उशीनरं प्रतिग्राह्य गालवः प्रययौ वनम् ।\nरेमे स तां समासाद्य कृतपुण्य इव श्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039590, "chapter_id": 1873, "verse_number": "५-११८-१८", "content_sanskrit": "कन्दरेषु च शैलानां नदीनां निर्झरेषु च।\nउद्यानेषु विचित्रेषु वनेषूपवनेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039591, "chapter_id": 1873, "verse_number": "५-११८-१९", "content_sanskrit": "हर्म्येषु रमणीयेषु प्रासादशिखरेषु च।\nवातायनविमानेषु तथा गर्भगृहेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2039592, "chapter_id": 1873, "verse_number": "५-११८-२०", "content_sanskrit": "ततोऽस्य समये यज्ञे पुत्रो बालरविप्रभः ।\nशिबिर्नाम्नाभिविख्यातो यः स पार्थिवसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2039593, "chapter_id": 1873, "verse_number": "५-११८-२१", "content_sanskrit": "उपस्थाय स तं विप्रो गालवः प्रतिगृह्य च।\nकन्यां प्रयातस्तां राजन्दृष्टवान्विनतात्मजम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2039594, "chapter_id": 1873, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि अष्टादशाधिकशततमोऽध्यायाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]