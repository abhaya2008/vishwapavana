[{"id": 7005421000, "chapter_id": 25421, "verse_number": "८७-१", "content_sanskrit": "पुलस्त्य  उवाच ।\nनमस्तेऽस्तु जगन्नाथ देवदेवं नमोऽस्तु ते ।\nवासुदेव नमस्तेऽस्तु बहुरूप नमोऽस्तु ते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005421001, "chapter_id": 25421, "verse_number": "८७-२", "content_sanskrit": "एकश्रृङ्ग नमस्तुभ्यं नमस्तुभ्यं वृषाकपे ।\nश्रीनिवास नमस्तेऽस्तु नमस्ते भूतभावन ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005421002, "chapter_id": 25421, "verse_number": "८७-३", "content_sanskrit": "विष्वक्सेन नमस्तुभ्यं नारायण नमोऽस्तु ते ।\nध्रुवध्वज नमस्तेऽस्तु सत्यध्वज नमोऽस्तु ते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005421003, "chapter_id": 25421, "verse_number": "८७-४", "content_sanskrit": "यज्ञध्वज नमस्तुभ्यं धर्मध्वज नमोऽस्तु ते ।\nतालध्वज नमस्तेऽस्तु नमस्ते गरुङध्वज ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005421004, "chapter_id": 25421, "verse_number": "८७-५", "content_sanskrit": "वरेण्य विष्णो वैकुण्ठ नमस्ते पुरुषोत्तम ।\nनमो जयन्त विजय जयानन्त पराजित ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005421005, "chapter_id": 25421, "verse_number": "८७-६", "content_sanskrit": "कृतावर्त महावर्त महादेव नमोऽस्तु ते ।\nअनाद्याद्यन्त मध्यान्त नमस्ते पद्मजप्रिय ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005421006, "chapter_id": 25421, "verse_number": "८७-७", "content_sanskrit": "पुरंजय नमस्तुभ्यं शत्रुंजय नमोऽस्तु ते ।\nशुभंजय नमस्तेऽस्तु नमस्तेऽस्तु धनंजय ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005421007, "chapter_id": 25421, "verse_number": "८७-८", "content_sanskrit": "सृष्टिगर्भ नमस्तुभ्यं शुचिश्रवः पृथुश्रवः ।\nनमो हिरण्यगर्भाय पद्मगर्भाय ते नमः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005421008, "chapter_id": 25421, "verse_number": "८७-९", "content_sanskrit": "नमः कमलनेत्राय कालनेत्राय ते नमः ।\nकालनाभ नमस्तुभ्यं महानाभ नमो नमः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005421009, "chapter_id": 25421, "verse_number": "८७-१०", "content_sanskrit": "वृष्टिमूल महामूल मूलावास नमोऽस्तु ते ।\nधर्मावास जलावास श्रीनिवास नमोऽस्तु ते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005421010, "chapter_id": 25421, "verse_number": "८७-११", "content_sanskrit": "धर्माध्यक्ष प्रजाध्यक्ष लोकाध्यक्ष नमो नमः ।\nसेनाध्यक्ष नमस्तुभ्यं कालाध्यक्ष नमो नमः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005421011, "chapter_id": 25421, "verse_number": "८७-१२", "content_sanskrit": "गदाधर श्रुतिधर चक्रधारिन् श्रियो धर ।\nवनमालाधर हरे नमस्ते धरणीधर ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005421012, "chapter_id": 25421, "verse_number": "८७-१३", "content_sanskrit": "आर्चिषेण महासेन नमस्तेऽस्तु पुरुष्टुत ।\nबहुकल्प महाकल्प नमस्ते कल्पनामुख ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005421013, "chapter_id": 25421, "verse_number": "८७-१४", "content_sanskrit": "सर्वात्मन् सर्वग विभो विरिञ्चे श्वेत केशव ।\nनील रक्त महानील अनिरुद्ध नमोऽस्तु ते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005421014, "chapter_id": 25421, "verse_number": "८७-१५", "content_sanskrit": "द्वादशात्मक कालात्मन् सामात्मन् परमात्मक ।\nव्योमकात्मक सुब्रह्मन् भूतात्मक नमोऽस्तु ते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005421015, "chapter_id": 25421, "verse_number": "८७-१६", "content_sanskrit": "हरिकेश महाकेश गुडाकेश नमोऽस्तु ते ।\nमुञ्जकेश हृषीकेश सर्वनाथ नमोऽस्तु ते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005421016, "chapter_id": 25421, "verse_number": "८७-१७", "content_sanskrit": "सूक्ष्म स्थूल महास्थूल महासूक्ष्म शुभंकर ।\nश्वेतपीताम्बरधर नीलवास नमोऽस्तु ते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005421017, "chapter_id": 25421, "verse_number": "८७-१८", "content_sanskrit": "कुशेशय नमस्तेऽस्तु सीरध्वज जनार्धन ।\nगोविन्द प्रीतिकर्ता च हंस पीताम्बरप्रिय ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005421018, "chapter_id": 25421, "verse_number": "८७-१९", "content_sanskrit": "अधोक्षज नमस्तुभ्यं सीरध्वज जनार्दन ।\nवामनाय नमस्तेऽस्तु नमस्ते मधुसूदन ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005421019, "chapter_id": 25421, "verse_number": "८७-२०", "content_sanskrit": "सहस्रशीर्षाय नमो ब्रह्मशीर्षाय ते नमः ।\nनमः सहस्रनेत्राय सोमसूर्यानलेक्षण ।\n॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005421020, "chapter_id": 25421, "verse_number": "८७-२१", "content_sanskrit": "नमश्चाथर्वशिरसे महाशीर्षाय ते नमः ।\nनमस्ते धर्मनेत्राय महानेत्राय ते नमः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005421021, "chapter_id": 25421, "verse_number": "८७-२२", "content_sanskrit": "नमः सहस्रपादाय सहस्रभुजमन्यवे ।\nनमो यज्ञवराहाय महारूपाय ते नमः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005421022, "chapter_id": 25421, "verse_number": "८७-२३", "content_sanskrit": "नमस्ते विश्वदेवाय विश्वात्मन् विश्वसंभव ।\nविश्वरूप नमस्तेऽस्तु त्वत्तो विश्वमभूदिदम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005421023, "chapter_id": 25421, "verse_number": "८७-२४", "content_sanskrit": "न्यग्रोधस्त्वं महाशाखस्त्वं मूलकुसुमार्चितः ।\nस्कन्धपत्राङ्कुरलता पल्लवाय नमोऽस्तु ते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005421024, "chapter_id": 25421, "verse_number": "८७-२५", "content_sanskrit": "मूलं ते ब्राह्मणा ब्रह्मन् स्कन्धस्ते क्षत्रियोर्दिशः ।\nनाभ्या ह्यभूदन्तरिक्षं शशाङ्को मनसस्तव ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005421025, "chapter_id": 25421, "verse_number": "८७-२६", "content_sanskrit": "ब्राह्मणाः साग्नयो वक्त्राः देर्दण्डाः सायुधा नृपाः ।\nपार्श्वाद् विशश्चोरुयुगाज्जाताः शूद्राश्च पादतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005421026, "chapter_id": 25421, "verse_number": "८७-२७", "content_sanskrit": "नेत्राद् भानुरभूत् तुभ्यं पद्भ्यां भूः श्रोत्रयोर्दिशः ।\nनाभ्या ह्यभूदन्तरिक्षं शशाङ्को मनसस्तव ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005421027, "chapter_id": 25421, "verse_number": "८७-२८", "content_sanskrit": "प्राणाद् वायुः समभवत् कामाद् ब्रह्मा पितामहः ।\nक्रोधात् त्रिनयनो रुद्रः शीर्ष्णोः द्यौः समवर्तत ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005421028, "chapter_id": 25421, "verse_number": "८७-२९", "content_sanskrit": "इन्द्राग्नी वदनात् तुभ्यं पशवो मलसंभवाः ।\nओषध्यो रोमसंभूता विराजस्त्वं नमोऽस्तु ते ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005421029, "chapter_id": 25421, "verse_number": "८७-३०", "content_sanskrit": "पुष्पहास नमस्तेऽस्तु महाहास नमोऽस्तु ते ।\nॐकारस्त्वं वषट्कारो वौषट् त्वं च स्वधा सुधा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005421030, "chapter_id": 25421, "verse_number": "८७-३१", "content_sanskrit": "स्वाहाकार नमस्तुभ्यं हन्तकार नमोऽस्तु ते ।\nसर्वाकार निराकार वेदाकार नमोऽस्तु ते ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005421031, "chapter_id": 25421, "verse_number": "८७-३२", "content_sanskrit": "त्वं हि वेदमयो देवः सर्वदेवमयस्तथा ।\nसर्वतीर्थमयश्चैव सर्वयज्ञमयस्तथा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005421032, "chapter_id": 25421, "verse_number": "८७-३३", "content_sanskrit": "नमस्ते यज्ञपुरुष यज्ञभागभुजे नमः ।\nनमः सहस्रधाराय शतधाराय ते नमः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005421033, "chapter_id": 25421, "verse_number": "८७-३४", "content_sanskrit": "भूर्भुवःस्वःस्वरूपाय गोदायामृतदायिने ।\nसुवर्णब्रह्मदात्रे च सर्वदात्रे च ते नमः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005421034, "chapter_id": 25421, "verse_number": "८७-३५", "content_sanskrit": "ब्रह्मेशाय नमस्तुभ्यं ब्रह्मादे ब्रह्मरूपधृक् ।\nपरब्रह्म नमस्तेऽस्तु शब्दब्रह्म नमोऽस्तु ते ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005421035, "chapter_id": 25421, "verse_number": "८७-३६", "content_sanskrit": "विद्यास्त्वं वेद्यरूपस्त्वं वेदनीयस्त्वमेव च ।\nबुद्धिस्त्वमपि बोध्यश्च बोधस्त्वं च नमोऽस्तु ते ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005421036, "chapter_id": 25421, "verse_number": "८७-३७", "content_sanskrit": "होता होमश्च हव्यं च हूयमानश्चहव्यवाट् ।\nपाता पोता च पूतश्च पावनीयश्च ॐ नमः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005421037, "chapter_id": 25421, "verse_number": "८७-३८", "content_sanskrit": "हन्ता च हन्यमानश्च ह्रियमाणस्त्वमेव च ।\nहर्त्ता नेता च नीतिश्च पूज्योऽग्र्यो विश्वधार्यसि ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005421038, "chapter_id": 25421, "verse_number": "८७-३९", "content_sanskrit": "स्रुक्‌स्रुवौ परधामासि कपालोलूखलोऽरणिः ।\nयज्ञपात्रारणेयस्त्वमेकधा बहुधा त्रिधा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005421039, "chapter_id": 25421, "verse_number": "८७-४०", "content_sanskrit": "यज्ञस्त्वं यजमानस्त्वमीड्यस्त्वमसि याजकः ।\nज्ञाता ज्ञेयस्तथा ज्ञानं ध्येयो ध्याताऽसि चेश्वर ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005421040, "chapter_id": 25421, "verse_number": "८७-४१", "content_sanskrit": "ध्यानयोगश्च योगी च गतिर्मोक्षो धृतिः सुखम् ।\nयोगाङ्गानि त्वमीशानः सर्वगस्त्वं नमोऽस्तु ते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005421041, "chapter_id": 25421, "verse_number": "८७-४२", "content_sanskrit": "ब्रह्म होता तथोद्गाता साम यूपोऽत दक्षिणा ।\nदीक्षा त्वं त्वं पुरोडाशस्त्वं पशुः पशुवाह्यसि ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005421042, "chapter_id": 25421, "verse_number": "८७-४३", "content_sanskrit": "गुह्यो धाता च परमः शिवो नारायणस्तथा ।\nमहाजनो निरयनः सहस्रार्केन्दुरूपवान् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005421043, "chapter_id": 25421, "verse_number": "८७-४४", "content_sanskrit": "द्वादशारोऽथ षण्णाभिस्त्रिव्यूहो द्वियुगस्तथा ।\nकालचक्रो भवानीशो नमस्ते पुरुषोत्तमः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005421044, "chapter_id": 25421, "verse_number": "८७-४५", "content_sanskrit": "पराक्रमो विक्रमस्त्वं हयग्रीवो हरीश्वरः ।\nनरेश्वरोऽथ ब्रह्मेशः सूर्येशस्त्वं नमोऽस्तु ते ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005421045, "chapter_id": 25421, "verse_number": "८७-४६", "content_sanskrit": "अश्ववक्त्रो महामेधाः शंभुः शक्रः प्रभञ्जनः ।\nमित्रावरुणमूर्तिस्त्वममूर्तिरनघः परः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005421046, "chapter_id": 25421, "verse_number": "८७-४७", "content_sanskrit": "प्राग्‌वंशकायो भूतादिर्महाभूतोऽच्युतो द्विजः ।\nत्वमूर्ध्वकर्त्ता ऊर्ध्वश्च ऊर्ध्वरेता नमोऽस्तु ते ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005421047, "chapter_id": 25421, "verse_number": "८७-४८", "content_sanskrit": "महापातकहा त्वं च उपपातकहा तथा ।\nअनीशः सर्वपापेभ्यस्त्वामहं शरणं गतः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005421048, "chapter_id": 25421, "verse_number": "८७-४९", "content_sanskrit": "इत्येतत् परमं स्तोत्रं सर्वपापप्रमोचनम् ।\nमहेश्वरेण कथितं वाराणस्यां पुरा मुने ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005421049, "chapter_id": 25421, "verse_number": "८७-५०", "content_sanskrit": "केशवस्याग्रतो गत्वा स्नात्वा तीर्थे सितोदके ।\nउपशान्तस्तथा जातो रुद्रः पापवशात् ततः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005421050, "chapter_id": 25421, "verse_number": "८७-५१", "content_sanskrit": "एतत् पवित्रं त्रिपुरध्नभाषितं पठन् नरो विष्णुपरो महर्षे ।\nविमुक्तपापो ह्युपशान्तमूर्तिः संपूज्यते देववरैः प्रसिद्धैः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]