[{"id": 2088542, "chapter_id": 2888, "verse_number": "१३-१८-१", "content_sanskrit": "`द्वैपायन उवाच।\nसर्वे वेदाः सर्ववेद्याः सशास्त्राः\nसर्वे यज्ञाः सर्व इत्यश्च कृष्णः।\nविदुः कृष्णं ब्राह्मणास्तत्वतो ये\nतेषां राजन्सर्वयज्ञः समाप्तः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2088543, "chapter_id": 2888, "verse_number": "१३-१८-२", "content_sanskrit": "ज्ञेयो योगी ब्राह्मणैर्वेदतत्वै-\nरारण्यकैः सैष कृष्णः प्रभुत्वात्।\nसर्वान्यज्ञान्ब्राह्मणान्ब्रह्म चैव\nव्याप्यातिष्ठद्देवदेवस्त्रिलोके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2088544, "chapter_id": 2888, "verse_number": "१३-१८-३", "content_sanskrit": "स एष देवः शक्रमीशं यजानं\nप्रीत्या प्राह क्रतुयष्टारमग्र्यम्\nन मा शक्रो वेदवेदार्थतत्वा-\nद्भक्तो भक्त्या शुद्धभावप्रधानः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2088545, "chapter_id": 2888, "verse_number": "१३-१८-४", "content_sanskrit": "मा जानन्ते ब्रह्मशीर्षं वरिष्ठं\nविश्वे विश्वं ब्रह्मयोनिं ह्ययोनिम्।\nसर्वत्राहं शाश्वतः शाश्वतेशः\nकृत्स्नो वेदोऽग्निर्निर्गुणोऽनन्ततेजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2088546, "chapter_id": 2888, "verse_number": "१३-१८-५", "content_sanskrit": "सर्वे देवा वासुदेवं यजन्ते\nततो बुद्ध्या मार्गमाणास्तनूनाम्।\nसर्वान्कामान्प्राप्नुवन्ते विशालां-\nस्त्रैलोक्येऽस्मिन्कृष्णनामाभिधानात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2088547, "chapter_id": 2888, "verse_number": "१३-१८-६", "content_sanskrit": "कृष्णो यज्ञैरिज्यते यायजूकैः\nकृष्णो वीर्यैरिज्यते विक्रमद्भिः।\nकृष्णो वाक्यैरिज्यते सम्मृशानैः\nकृष्णो मुक्तैरिज्यते वीतमोहैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2088548, "chapter_id": 2888, "verse_number": "१३-१८-७", "content_sanskrit": "विद्यावन्तः सोमपा ये विपापा\nइष्ट्वा यज्ञेर्गोचरं प्रार्थयन्ते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2088549, "chapter_id": 2888, "verse_number": "१३-१८-७x", "content_sanskrit": "भवगानुवाच।\nसर्वं क्रान्तं देवलोकं विशाल-\nमन्ते गत्वा मुक्तिलोकं भजन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2088550, "chapter_id": 2888, "verse_number": "१३-१८-८", "content_sanskrit": "एवं सर्वे त्वाश्रमाः सुव्रता ये\nमां जानन्तो यान्ति लोकानदीनान्।\nये ध्यानदीक्षामुद्वहन्तो विपापा\nज्योतिर्भूत्वा देवलोकं भजन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2088551, "chapter_id": 2888, "verse_number": "१३-१८-९", "content_sanskrit": "पूज्यन्ते मां पूजयन्तः प्रहृष्टा\nमां जानन्तः श्रद्धया वासुदेवम्।\nभक्त्या तुष्टोऽहं तस्य सत्त्वं प्रयच्छे\nसत्वस्पृष्टो वीतमोहोऽयमेति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2088552, "chapter_id": 2888, "verse_number": "१३-१८-१०x", "content_sanskrit": "द्वैपायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2088553, "chapter_id": 2888, "verse_number": "१३-१८-१०", "content_sanskrit": "ज्योतींषि शुक्तानि च यानि लोके\nत्रयो लोका लोकपालास्त्रयश्च।\nत्रयोऽग्नयश्चाहुतयश्च पञ्च\nसर्वे देवा देवकीपुत्र एव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2088554, "chapter_id": 2888, "verse_number": "१३-१८-११x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2088555, "chapter_id": 2888, "verse_number": "१३-१८-११", "content_sanskrit": "व्यासस्यैतद्वचः श्रुत्वा मद्रराजः सहर्षिभिः।\nव्यासं कृष्णं च विधिवत्प्रीतात्मा प्रत्यपूजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2088556, "chapter_id": 2888, "verse_number": "१३-१८-१२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2088557, "chapter_id": 2888, "verse_number": "१३-१८-१२", "content_sanskrit": "कविः प्रयातस्तु महर्षिपुत्रो\nद्वैपायनस्तद्वचनं निशम्य।\nजगाम पृथ्वीं शिरसा महात्मा\nनमश्च कृष्णाय चकार भीष्मः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2088558, "chapter_id": 2888, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणी दानधर्मपर्वणि अष्टादशोऽध्यायः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]