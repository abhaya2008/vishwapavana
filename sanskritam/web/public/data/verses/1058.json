[{"id": 2002639, "chapter_id": 1058, "verse_number": "१-५९-०x", "content_sanskrit": "शौनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2002640, "chapter_id": 1058, "verse_number": "१-५९-१", "content_sanskrit": "भृगुवंशात्प्रभृत्येव त्वया मे कीर्तितं महत्।\nआख्यानमखिलं तात सौते प्रीतोऽस्मितेन ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2002641, "chapter_id": 1058, "verse_number": "१-५९-२", "content_sanskrit": "प्रक्ष्यामि चैव भूयस्त्वां यथावत्सूतनन्दन।\nयाः कथा व्याससंपन्नास्ताश्च भूयो विचक्ष्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2002642, "chapter_id": 1058, "verse_number": "१-५९-३", "content_sanskrit": "तस्मिन्परमदुष्पारे सर्पसत्रे महात्मनाम्।\nकर्मान्तरेषु यज्ञस्य सदस्यानां तथाऽध्वरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2002643, "chapter_id": 1058, "verse_number": "१-५९-४", "content_sanskrit": "या बभूवुः कथाश्चित्रा येष्वर्थेषु यथातथम्।\nत्वत्त इच्छामहे श्रोतुं सौते त्वं वै प्रचक्ष्व नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2002644, "chapter_id": 1058, "verse_number": "१-५९-५x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2002645, "chapter_id": 1058, "verse_number": "१-५९-५", "content_sanskrit": "कर्मान्तरेष्वकथयन्द्विजा वेदाश्रयाः कथाः।\nव्यासस्त्वकथयच्चित्रमाख्यानं भारतं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2002646, "chapter_id": 1058, "verse_number": "१-५९-६x", "content_sanskrit": "शौनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2002647, "chapter_id": 1058, "verse_number": "१-५९-६", "content_sanskrit": "महाभारतमाख्यानं पाण्डवानां यशस्करम्।\nजनमेजयेन पृष्टः सन्कृष्णद्वैपायनस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2002648, "chapter_id": 1058, "verse_number": "१-५९-७", "content_sanskrit": "श्रावयामास विधिवत्तदा कर्मान्तरे तु सः।\nतामहं विधिवत्पुण्यां श्रोतुमिच्छामि वै कथाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2002649, "chapter_id": 1058, "verse_number": "१-५९-८", "content_sanskrit": "मनःसागरसंभूतां महर्षेर्भावितात्मनः।\nकथयस्व सतां श्रेष्ठ सर्वरत्नमयीमिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2002650, "chapter_id": 1058, "verse_number": "१-५९-९x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2002651, "chapter_id": 1058, "verse_number": "१-५९-९", "content_sanskrit": "हन्त ते कथयिष्यामि महदाख्यानमुत्तमम्।\nकृष्णद्वैपायनमतं महाभारतमादितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2002652, "chapter_id": 1058, "verse_number": "१-५९-१०", "content_sanskrit": "शृणु सर्वमशेषेण कथ्यमानं मया द्विज।\nशंसितुं तन्महान्हर्षो ममापीह प्रवर्तते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2002653, "chapter_id": 1058, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि अंशावतरणपर्वणि एकोनषष्टितमोऽध्यायः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]