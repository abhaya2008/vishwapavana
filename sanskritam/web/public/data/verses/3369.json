[{"id": 2109175, "chapter_id": 3369, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2109176, "chapter_id": 3369, "verse_number": "१", "content_sanskrit": "तत आहूय पुत्रं स्वं जरत्कारुर्भुजङ्गमा ।\nवासुकेर्नागराजस्य वचनादिदमब्रवीत् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2109177, "chapter_id": 3369, "verse_number": "२", "content_sanskrit": "अहं तव पितुः पुत्र भ्रात्रा दत्ता निमित्ततः ।\nकालः स एष सम्प्राप्तः तत् कुरुष्व यथातथम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2109178, "chapter_id": 3369, "verse_number": "", "content_sanskrit": "अस्तीकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2109179, "chapter_id": 3369, "verse_number": "३", "content_sanskrit": "किन्निमित्तं मम पितुः दत्ता त्वं मातुलेन मे ।\nतन्ममाचक्ष्व तत्त्वेन श्रुत्वा कर्ताऽस्मि तत् तथा\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2109180, "chapter_id": 3369, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2109181, "chapter_id": 3369, "verse_number": "४", "content_sanskrit": "तत आचष्ट सा तस्मै बान्धवानां हितैषिणी ।\nभगिनी नागराजस्य जरत्कारुरविक्लवा\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2109182, "chapter_id": 3369, "verse_number": "५", "content_sanskrit": "भुजङ्गानामशेषाणां माता कद्रूरिति स्मृता ।\nतया शप्ता क्रुधितया पुत्रा यस्मान्निबोध तत् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2109183, "chapter_id": 3369, "verse_number": "६", "content_sanskrit": "उच्चैश्रवसोऽश्वराज्ञो यन्मिथ्या कुरुते ह मा ।\nविनतानिमित्तं पणिते दासभावाय पुत्रकाः\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2109184, "chapter_id": 3369, "verse_number": "७", "content_sanskrit": "जनमेजयस्य वो यज्ञे धक्ष्यत्यनिलसारथिः ।\nतत्र पञ्चत्वमापन्नाः प्रेतलोकं गमिष्यथ \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2109185, "chapter_id": 3369, "verse_number": "८", "content_sanskrit": "तां च शप्तवतीमेव साक्षाल्लोकपितामहः ।\nएवमस्त्विति तद्वाक्यं प्रोवाचानुमुमोद च \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2109186, "chapter_id": 3369, "verse_number": "९", "content_sanskrit": "वासुकिश्चापि तच्छ्रुत्वा पितामहवचस्तदा ।\nअमृते मथिते तात देवान् शरणमेयिवान् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2109187, "chapter_id": 3369, "verse_number": "१०", "content_sanskrit": "सिद्धार्थाश्च सुराः सर्वे प्राप्यामृतमनुत्तमम् ।\nभ्रातरं मे पुरस्कृत्य प्रजापतिमुपागमन् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2109188, "chapter_id": 3369, "verse_number": "११", "content_sanskrit": "ते तं प्रसादयामासुः देवाः सर्वे पितामहम् ।\nराज्ञा वासुकिना सार्धं स शापो न भवेदिति\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2109189, "chapter_id": 3369, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2109190, "chapter_id": 3369, "verse_number": "१२", "content_sanskrit": "वासुकिर्नागराजोऽयं दुःखितो ज्ञातिकारणात् ।\nअभिशापः स्वमात्राऽस्य भगवन् न भवेत् तथा\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2109191, "chapter_id": 3369, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2109192, "chapter_id": 3369, "verse_number": "१३", "content_sanskrit": "जरत्कारुर्जरत्कारुं यो भार्यां समवाप्स्यति ।\nतत्र जातो द्विजः शापाद् भुजगान् मोक्षयिष्यति\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2109193, "chapter_id": 3369, "verse_number": "", "content_sanskrit": "जरत्कारुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2109194, "chapter_id": 3369, "verse_number": "१४", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं वासुकिः पन्नगेश्वरः ।\nप्रादान्माममरप्रख्य तव पित्रे महात्मने \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2109195, "chapter_id": 3369, "verse_number": "१५", "content_sanskrit": "प्रागेवानागते काले तत्र त्वं मय्यजायथाः ।\nअयं स कालः सम्प्राप्तो भवान्नस्त्रातुमर्हति \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2109196, "chapter_id": 3369, "verse_number": "१६", "content_sanskrit": "भ्रातरं चैव मे तस्मात् त्रातुमर्हसि पावकात् ।\nअमोघं नः कृतं न स्यात् यदहं तव धीमते ।\nपित्रे दत्ता विमोक्षार्थं कथं वा पुत्र मन्यसे \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2109197, "chapter_id": 3369, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2109198, "chapter_id": 3369, "verse_number": "१७", "content_sanskrit": "एवमुक्तस्तथेत्युक्त्वा सोऽस्तीको मातरं तदा ।\nअब्रवीद् दुःखसन्तप्तं वासुकिं जीवयन्निव \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2109199, "chapter_id": 3369, "verse_number": "१८", "content_sanskrit": "अहं त्वां मोक्षयिष्यामि वासुके पन्नगोत्तम ।\nतस्माच्छापान्महासत्त्वात् सत्यमेतद् ब्रवीमि ते\t ॥ १८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2109200, "chapter_id": 3369, "verse_number": "१९", "content_sanskrit": "स्वस्थो भव महाभाग  न हि ते विद्यते भयम् ।\nप्रयतिष्ये तथा सौम्य यथा श्रेयो भविष्यति \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2109201, "chapter_id": 3369, "verse_number": "२०", "content_sanskrit": "न मे वागनृतं प्राह स्वैरेष्वपि कुतोऽन्यथा ।\nतं वै नृपवरं गत्वा दीक्षितं जनमेजयम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2109202, "chapter_id": 3369, "verse_number": "२१", "content_sanskrit": "वाग्भिर्मङ्गलयुक्ताभिः तोषयिष्यामि मातुल ।\nयथा स यज्ञो नृपतेः निवर्तिष्यति सत्तम \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2109203, "chapter_id": 3369, "verse_number": "२२", "content_sanskrit": "सम्भावय सुनागेन्द्र मयि सर्वं महाद्युते ।\nन ते मयि मनो जातु मिथ्या भवितुमर्हति\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2109204, "chapter_id": 3369, "verse_number": "", "content_sanskrit": "वासुकिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2109205, "chapter_id": 3369, "verse_number": "२३", "content_sanskrit": "आस्तीक परिपूर्णोऽस्मि हृदयं मे विदीर्यते ।\nदिशश्च न प्रजानामि ब्रह्मदण्डेन पीडितः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2109206, "chapter_id": 3369, "verse_number": "", "content_sanskrit": "आस्तीकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2109207, "chapter_id": 3369, "verse_number": "२४", "content_sanskrit": "न सन्तापस्त्वया कार्यः कथञ्चित् पन्नगोत्तम ।\nप्रदीप्ताग्नेः समुत्पन्नं नाशयिष्यामि ते भयम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2109208, "chapter_id": 3369, "verse_number": "२५", "content_sanskrit": "ब्रह्मदण्डं महाघोरं कालाग्निसमतेजसम् ।\nनाशयिष्यामि माऽन्यस्त्वं भयं कार्षीः कथञ्चन\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2109209, "chapter_id": 3369, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2109210, "chapter_id": 3369, "verse_number": "२६", "content_sanskrit": "ततः स वासुकेर्घोरमपनीय मनोऽज्वरम् ।\nआधाय चात्मनोऽङ्गेषु जगाम त्वरितो भृशम् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2109211, "chapter_id": 3369, "verse_number": "२७", "content_sanskrit": "जनमेजयस्य तं यज्ञं सर्वैः समुदितं गुणैः ।\nमोक्षाय भुजगेन्द्राणामास्तीको द्विजसत्तमः\t ॥ २७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2109212, "chapter_id": 3369, "verse_number": "२८", "content_sanskrit": "स गत्वाऽपश्यदास्तीको यज्ञायतनमुत्तमम् ।\nवृतं सदस्यैर्बहुभिः सूर्यवह्निसमप्रभैः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2109213, "chapter_id": 3369, "verse_number": "२९", "content_sanskrit": "स तत्र वारितो द्वास्स्थैरतिष्ठद् द्विजसत्तमः ।\nअभितुष्टाव यज्ञं तं प्रवेशार्थं द्विजोत्तमः\t ॥ २९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2109214, "chapter_id": 3369, "verse_number": "३०", "content_sanskrit": "स प्राप्य यज्ञायतनं वरिष्ठो द्विजसत्तमः ।\nतुष्टाव राजानममुं सदस्यानग्निमेव च \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2109215, "chapter_id": 3369, "verse_number": "३६", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nअष्टचत्वारिंशोऽध्यायः ॥४८॥ ॥ आस्तीकपर्वणि षट्त्रिंशोऽध्यायः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]