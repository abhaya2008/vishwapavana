[{"id": 7006349000, "chapter_id": 26349, "verse_number": "२-५-१", "content_sanskrit": "वैशम्पायन उवाच\nप्रागेव वसुदेवस्तु व्रजे शुश्राव रोहिणीम् ।\nप्रज्ञातां पुत्रमेवाग्रे चन्द्रात् कान्ततराननम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006349001, "chapter_id": 26349, "verse_number": "२-५-२", "content_sanskrit": "स नन्दगोपं त्वरितः प्रोवाच शुभया गिरा ।\nगच्छानया सहैव त्वं व्रजमेव यशोदया ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006349002, "chapter_id": 26349, "verse_number": "२-५-३", "content_sanskrit": "तत्र तौ दारकौ गत्वा जातकर्मादिभिर्गुणैः ।\nयोजयित्वा व्रजे तात संवर्धय यथासुखम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006349003, "chapter_id": 26349, "verse_number": "२-५-४", "content_sanskrit": "रौहिणेयं च पुत्रं मे परिरक्ष शिशुं व्रजे ।\nअहं वाच्यो भविष्यामि पितृपक्षेषु पुत्रिणाम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006349004, "chapter_id": 26349, "verse_number": "२-५-५", "content_sanskrit": "योऽहमेकस्य पुत्रस्य न पश्यामि शिशोर्मुखम् ।\nह्रियते हि बलात्प्रज्ञा प्राज्ञस्यापि सतो मम ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006349005, "chapter_id": 26349, "verse_number": "२-५-६", "content_sanskrit": "अस्माद्धि मे भयं कंसान्निर्घृणाद् वै शिशोर्वधे ।\nतद्यथा रौहिणेयं त्वं नन्दगोप ममात्मजम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006349006, "chapter_id": 26349, "verse_number": "२-५-७", "content_sanskrit": "गोपायसि यथा तात तत्त्वान्वेषी तथा कुरु ।\nविघ्ना हि बहवो लोके बालानुत्त्रासयन्ति हि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006349007, "chapter_id": 26349, "verse_number": "२-५-८", "content_sanskrit": "स च पुत्रो मम ज्यायान् कनीयांश्च तथाप्ययम् ।\nउभावपि समं नाम्ना निरीक्षस्व यथासुखम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006349008, "chapter_id": 26349, "verse_number": "२-५-९", "content_sanskrit": "वर्धमानामुभावेतौ समानवयसौ यथा ।\nशोभेतां गोव्रजे तस्मिन् नन्दगोप तथा कुरु ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006349009, "chapter_id": 26349, "verse_number": "२-५-१०", "content_sanskrit": "बाल्ये केलिकिलः सर्वो बाल्ये मुह्यति मानवः ।\nबाल्ये चण्डतमः सर्वस्तत्र यत्नपरो भव ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006349010, "chapter_id": 26349, "verse_number": "२-५-११", "content_sanskrit": "न च वृन्दावने कार्यो गवां घोषः कथंचन ।\nभेतव्यं तत्र वसतः केशिनः पापदर्शिनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006349011, "chapter_id": 26349, "verse_number": "२-५-१२", "content_sanskrit": "सरीसृपेभ्यः कीटेभ्यः शकुनिभ्यस्तथैव च ।\nगोष्ठेषु गोभ्यो वत्सेभ्यो रक्ष्यौ ते द्वाविमौ शिशू ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006349012, "chapter_id": 26349, "verse_number": "२-५-१३", "content_sanskrit": "नन्दगोप गता रात्रिः शीघ्रयानो व्रजाशुगः ।\nइमे त्वां व्याहरन्तीव पक्षिणः सव्यदक्षिणाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006349013, "chapter_id": 26349, "verse_number": "२-५-१४", "content_sanskrit": "रहस्यं वसुदेवेन सोऽनुज्ञातो महात्मना ।\nयानं यशोदया सार्धमारुरोह मुदान्वितः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006349014, "chapter_id": 26349, "verse_number": "२-५-१५", "content_sanskrit": "कुमारस्कन्धवाह्यायां शिबिकायां समाहितः ।\nसंवेशयामास शिशुं शयनीयं महामतिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006349015, "chapter_id": 26349, "verse_number": "२-५-१६", "content_sanskrit": "जगाम च विविक्तेन शीतलानिलसर्पिणा ।\nबहूदकेन मार्गेण यमुनातीरगामिना ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006349016, "chapter_id": 26349, "verse_number": "२-५-१७", "content_sanskrit": "स ददर्श शुभे देशे गोवर्धनसमीपगे ।\nयमुनातीरसम्बद्धं शीतमारुतसेवितम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006349017, "chapter_id": 26349, "verse_number": "२-५-१८", "content_sanskrit": "विरुतश्वापदै रम्यं लतावल्लीमहाद्रुमम्।\nगोभिस्तृणविलग्नाभिः स्यन्दन्तीभिरलंकृतम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006349018, "chapter_id": 26349, "verse_number": "२-५-१९", "content_sanskrit": "समप्रचारं च गवां समतीर्थजलाशयम् ।\nवृषाणां स्कन्धघातैश्च विषाणोद्घृष्टपादपम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006349019, "chapter_id": 26349, "verse_number": "२-५-२०", "content_sanskrit": "भासामिषादानुसृतैः श्येनैश्चामिषगृध्नुभिः ।\nसृगालमृगसिंहैश्च वसामेदाशिभिर्वृतम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006349020, "chapter_id": 26349, "verse_number": "२-५-२१", "content_sanskrit": "शार्दूलशब्दाभिरुतं नानापक्षिसमाकुलम् ।\nस्वादुवृक्षफलं रम्यं पर्याप्ततृणवीरुधम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006349021, "chapter_id": 26349, "verse_number": "२-५-२२", "content_sanskrit": "गोव्रजं गोरुतं रम्यं गोपनारीभिरावृतम् ।\nहम्भारवैश्च वत्सानां सर्वतः कृतनिःस्वनम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006349022, "chapter_id": 26349, "verse_number": "२-५-२३", "content_sanskrit": "शकटावर्तविपुलं कण्टकीवाटसंकुलम् ।\nपर्यन्तेष्वावृतं वन्यैर्बृहद्भिः पतितैर्द्रुमैः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006349023, "chapter_id": 26349, "verse_number": "२-५-२४", "content_sanskrit": "वत्सानां रोपितैः कीलैर्दामभिश्च विभूषितम् ।\nकरीषाकीर्णवसुधं कटच्छन्नकुटीमठम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006349024, "chapter_id": 26349, "verse_number": "२-५-२५", "content_sanskrit": "क्षेम्यप्रचारबहुलं हृष्टपुष्टजनावृतम् ।\nदामनीपाशबहुलं गर्गरोद्गारनिःस्वुनम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006349025, "chapter_id": 26349, "verse_number": "२-५-२६", "content_sanskrit": "तक्रनिःस्रावबहुलं दधिमण्डार्द्रमृत्तिकम् ।\nमन्थानवलयोद्गारैर्गोपीनां जनितस्वनम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006349026, "chapter_id": 26349, "verse_number": "२-५-२७", "content_sanskrit": "काकपक्षधरैर्बालैर्गोपालक्रीडनाकुलम् ।\nसार्गलद्वारगोवाटं मध्ये गोस्थानसंकुलम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006349027, "chapter_id": 26349, "verse_number": "२-५-२८", "content_sanskrit": "सर्पिषा पच्यमानेन सुरभीकृतमारुतम् ।\nनीलपीताम्बराभिश्च तरुणीभिरलंकृतम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006349028, "chapter_id": 26349, "verse_number": "२-५-२९", "content_sanskrit": "वन्यपुष्पावतंसाभिर्गोपकन्याभिरावृतम् ।\nशिरोभिर्धृतकुम्भाभिर्बद्धैरग्रस्तनाम्बरैः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006349029, "chapter_id": 26349, "verse_number": "२-५-३०", "content_sanskrit": "यमुनातीरमार्गेण जलहारीभिरावृतम् ।\nस तत्र प्रविशन् हृष्टो गोव्रजं गोपनादितम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006349030, "chapter_id": 26349, "verse_number": "२-५-३१", "content_sanskrit": "प्रत्युद्गतो गोपवृद्धैः स्त्रीभिर्वृद्धाभिरेव च ।\nनिवेशं रोचयामास परिवर्ते सुखाश्रये ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006349031, "chapter_id": 26349, "verse_number": "२-५-३२", "content_sanskrit": "सा यत्र रोहिणी देवी वसुदेवसुखावहा ।\nतत्र तं बालसूर्याभं कृष्णं गूढं न्यवेशयत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]