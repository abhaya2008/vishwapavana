[{"id": 2026210, "chapter_id": 1561, "verse_number": "३-१९९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2026211, "chapter_id": 1561, "verse_number": "३-१९९-१", "content_sanskrit": "भूय एव महाभाग्यं कथ्यतामित्यब्रवीत्पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2026212, "chapter_id": 1561, "verse_number": "३-१९९-२", "content_sanskrit": "अथाचष्ट मार्कण्डेयो महाराज वृषदर्भसेदुकनामानौ राजानौ नतिमार्गरतावस्त्रोपास्त्रकृतिनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2026213, "chapter_id": 1561, "verse_number": "३-१९९-३", "content_sanskrit": "सेदुको वृषदर्भस् बालस्यैव उपांशुव्रतमभ्यजानात् कुप्यमदेयं ब्राह्मणस्य ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2026214, "chapter_id": 1561, "verse_number": "३-१९९-४", "content_sanskrit": "अथ तं सेदुकं ब्राह्मणः कश्चिद्वेदाध्ययनसंपन्न आशिषं दत्त्वा गुर्वर्थी भिक्षितवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2026215, "chapter_id": 1561, "verse_number": "३-१९९-५", "content_sanskrit": "अश्वसहस्रं मे भवान्ददात्विति ॥ तं सेदुको ब्राह्मणमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2026216, "chapter_id": 1561, "verse_number": "३-१९९-६", "content_sanskrit": "नास्ति संभवो गुर्वर्थं दातुमिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2026217, "chapter_id": 1561, "verse_number": "३-१९९-७", "content_sanskrit": "स त्वं गच्छ वृषदर्भसकाशम् ॥ राजा परमधर्मज्ञो ब्राह्मण तं भिक्षस्व ॥ स ते दास्यति तस्यैतदुपांशुव्रतमिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2026218, "chapter_id": 1561, "verse_number": "३-१९९-८", "content_sanskrit": "अथ ब्राह्मणो वृषदर्भसकाशं गत्वा अश्वसहस्रमयाचत ॥ स राजा तं कशेनाताडयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2026219, "chapter_id": 1561, "verse_number": "३-१९९-९", "content_sanskrit": "तं ब्राह्मणोऽब्रवीत् ॥ किं हिंस्यनागसं मामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2026220, "chapter_id": 1561, "verse_number": "३-१९९-१०", "content_sanskrit": "एवमुक्त्या तं शपन्तं राजाऽऽह ॥ विप्र किं यो न ददाति तुभ्यमुताहोस्विद्ब्राह्मण्यमेतत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2026221, "chapter_id": 1561, "verse_number": "३-१९९-११x", "content_sanskrit": "कब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2026222, "chapter_id": 1561, "verse_number": "३-१९९-११", "content_sanskrit": "राजाधिराज तव समीपं सेदुकेन प्रेषितो भिक्षितुमागतः तेनानुशिष्टेन मया त्वं भिक्षितोसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2026223, "chapter_id": 1561, "verse_number": "३-१९९-१२", "content_sanskrit": "पूर्वाह्णे ते दास्यामि यो मेऽद्य बलिरागमिष्यति ॥ यो हन्यते कशया कथं मोघं क्षेपणं तस्य स्यात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2026224, "chapter_id": 1561, "verse_number": "", "content_sanskrit": "इत्युक्त्वा ब्राह्मणाय दैवसिकामुत्पत्तिं प्रदात् ॥ अधिकस्याश्वसहस्रस्य मूल्यमेवादादिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]