[{"id": 2116443, "chapter_id": 3506, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2116444, "chapter_id": 3506, "verse_number": "१", "content_sanskrit": "एवं मत्वा प्रयातास्ते पाण्डवा जनमेजय ।\nब्रह्मरूपधराः सर्वे जटिला ब्रह्मचारिणः \t॥ १॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2116445, "chapter_id": 3506, "verse_number": "२", "content_sanskrit": "राजन् दक्षिणपाञ्चालान् द्रुपदेनाभिरक्षितान्\nततस्ते तं महात्मानं शुद्धात्मानमकल्मषम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2116446, "chapter_id": 3506, "verse_number": "३", "content_sanskrit": "ददृशुः पाण्डवा राजन् पथि द्वैपायनं तदा ।\nतस्मै यथावत् सत्कारं कृत्वा तेन च सान्त्विताः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2116447, "chapter_id": 3506, "verse_number": "४", "content_sanskrit": "कथयित्वाऽभ्यनुज्ञाताः प्रययुर्द्रुपदक्षयम् ।\nपश्यन्तो रमणीयानि वनानि च सरांसि च \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2116448, "chapter_id": 3506, "verse_number": "५", "content_sanskrit": "तत्र तत्र वसन्तश्च शनैर्जम्मुर्महारथाः ।\nस्वाध्यायवन्तो मधुराः पाण्डवाः प्रियवादिनः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2116449, "chapter_id": 3506, "verse_number": "६", "content_sanskrit": "आनुपूर्व्येण सम्प्राप्ताः पाञ्चालान् कुरुनन्दनाः ।\nते तु दृष्ट्वा पुरं तस्य स्कन्धावारं च पाण्डवाः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2116450, "chapter_id": 3506, "verse_number": "७", "content_sanskrit": "कुम्भकारस्य शालायां निवासं चक्रिरे तदा ।\nतत्र भिक्षां समाजह्रुर्ब्राह्मीं वृतिं समाश्रिताः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2116451, "chapter_id": 3506, "verse_number": "८", "content_sanskrit": "तांश्च प्राप्तांस्तथा वीरान् जज्ञिरे न नराः क्कचित् ।\nयज्ञसेनस्य कामस्तु पाण्डवाय किरीटिने \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2116452, "chapter_id": 3506, "verse_number": "९", "content_sanskrit": "कृष्णां ददानीति सदा न चैतद् विवृणोति सः ।\nजामातृबलसंयोगं मेने हि बलवत्तरम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2116453, "chapter_id": 3506, "verse_number": "१०", "content_sanskrit": "अन्वेषमाणः पाञ्चालः कौन्तेयान् जनमेजय ।\nदृढं धनुरनायम्यं कारयामास भारत \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2116454, "chapter_id": 3506, "verse_number": "११", "content_sanskrit": "यन्त्रं वैहायसं चापि कारयामास कृत्रिमम् ।\nतेन यन्त्रेण सहितं कारयामास काञ्चनम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2116455, "chapter_id": 3506, "verse_number": "१२", "content_sanskrit": "इदं सज्यं धनुः कृत्वा छिद्रेणानेन सायकैः ।\nअतीत्य लक्ष्यं यो वेद्धा स लब्धा च सुतामिति \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2116456, "chapter_id": 3506, "verse_number": "१३", "content_sanskrit": "इत्येवं द्रुपदो राजा सर्वतः समघोषयत् ।\nतच्छ्रुत्वा पाण्डवाः सर्वे समीयुस्तत्र भारत \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2116457, "chapter_id": 3506, "verse_number": "१४", "content_sanskrit": "ऋषयश्च महात्मानः स्वयंवरदिदृक्षया ।\nदुर्योदनपुरोगाश्च सकर्णकुरवो नृपाः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2116458, "chapter_id": 3506, "verse_number": "१५", "content_sanskrit": "ब्राह्मणाश्च महाभागा देशेभ्यः समुपागताः ।\nअभ्यर्चिता राजगणा द्रुपदेन महात्मना \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2116459, "chapter_id": 3506, "verse_number": "१६", "content_sanskrit": "ततः पुरवरश्रेष्ठे सागरोद्धतनिस्वने ।\nशिंशुमारगिरिं प्राप्य न्यविशन्त महारथाः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2116460, "chapter_id": 3506, "verse_number": "१७", "content_sanskrit": "प्रागुत्तरे च नगराद् भूमिभागे समे शुभे ।\nसमाजवाटः शुशुभे भवनैः सर्वतो वृतः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2116461, "chapter_id": 3506, "verse_number": "१८", "content_sanskrit": "प्रासादपरिघोपेतो द्वारतोरणमण्डितः ।\nवितानेन विचित्रेण सर्वतः समलङ्कृतः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2116462, "chapter_id": 3506, "verse_number": "१९", "content_sanskrit": "तूर्यौघशतसङ्कीर्णः परार्घागुरुधूपितः ।\nचन्दनोदकसिक्तश्च माल्यदामैश्च शोभितः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2116463, "chapter_id": 3506, "verse_number": "२०", "content_sanskrit": "कैलासशिखरप्रख्यैर्नभस्स्थलविलेखिभिः ।\nसर्वतः संवृतैर्नद्धः प्रासादैः सुकृतोच्छ्रितैः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2116464, "chapter_id": 3506, "verse_number": "२१", "content_sanskrit": "सुवर्णजालसंवीतैर्मणिकुट्टिमभूषितैः ।\nसुखारोहणसोपानैर्महासनपरिच्छदैः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2116465, "chapter_id": 3506, "verse_number": "२२", "content_sanskrit": "अग्राम्यसमवच्छन्नैरगुरूत्तमधूपितैः ।\nहंसवर्णैश्च बहुभिरायोजनसुगन्धिभिः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2116466, "chapter_id": 3506, "verse_number": "२३", "content_sanskrit": "ससम्बाधपथद्वारैः शयनासनशोभितैः ।\nबहुधातुपिनद्धाङ्गैर्हिमवच्छिखरैरिव \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2116467, "chapter_id": 3506, "verse_number": "२४", "content_sanskrit": "तत्र नानाप्रकारेषु विमानेषु स्वलङ्कृताः ।\nस्पर्धमानास्तदाऽन्योन्यं निषेदुः सर्वपार्थिवाः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2116468, "chapter_id": 3506, "verse_number": "२५", "content_sanskrit": "तत्रोपविष्टा ददृशुर्महासत्वान् पृथग्जनाः ।\nराजसिंहान् महाभागान् मृष्टस्रगनुलेपनान् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2116469, "chapter_id": 3506, "verse_number": "२६", "content_sanskrit": "महाप्रसादान् ब्रह्मण्यान् स्वराष्ट्रपरिरक्षिणः ।\nप्रियान् सर्वस्य लोकस्य सुकृतैः कर्मभिः शुभैः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2116470, "chapter_id": 3506, "verse_number": "२७", "content_sanskrit": "ततोऽधिमञ्चेषु तदा पौरजानपदा जनाः ।\nउपोपविविशुः सर्वे याज्ञसेनीदिदृक्षवः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2116471, "chapter_id": 3506, "verse_number": "२८", "content_sanskrit": "ब्राह्मणैश्चैव सहिताः पाण्डवाः समुपाविशन् ।\nवृद्धिं पञ्चालदेशस्य पश्यन्तस्तामनुत्तमाम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2116472, "chapter_id": 3506, "verse_number": "२९", "content_sanskrit": "ततः समाजो ववृते स राजन् दिवसान् बहून् ।\nरत्नप्रदानबहुलः शोभितो नटनर्तकैः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2116473, "chapter_id": 3506, "verse_number": "३०", "content_sanskrit": "वर्तमाने समाजे तु रमणीयेऽह्नि षोडशे ।\nआप्लुता शुद्धवसना सर्वाभरणभूषिता \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2116474, "chapter_id": 3506, "verse_number": "३१", "content_sanskrit": "वीरकांस्यमुपादाय काञ्चनं समलङ्कृतम् ।\nअवतीर्णा ततो रङ्गे द्रौपदी द्रुपदात्मजा \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2116475, "chapter_id": 3506, "verse_number": "३२", "content_sanskrit": "पुरोहितः सोमकानां मन्त्रविद् ब्राह्मणः शुचिः ।\nपरिस्तीर्य जुहावाग्निमाज्येन विधिना तदा \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2116476, "chapter_id": 3506, "verse_number": "३३", "content_sanskrit": "सन्तर्पयित्वा ज्वलनं ब्राह्मणान् स्वस्ति वाच्य च ।\nवारयामास सर्वाणि वादित्राणि समन्ततः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2116477, "chapter_id": 3506, "verse_number": "३४", "content_sanskrit": "निश्शब्दे तु कृते तस्मिन् धृष्टद्युम्नो विशाम्पते ।\nरङ्गमध्यं गतस्तत्र मेघगम्भीरया गिरा ।\nवाक्यमुच्चैर्जगादेदं श्लक्ष्णमर्थवदुत्तमम् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2116478, "chapter_id": 3506, "verse_number": "", "content_sanskrit": "धृष्टद्युम्नः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2116479, "chapter_id": 3506, "verse_number": "३५", "content_sanskrit": "इदं धनुर्लक्ष्यमिमे च बाणाः\nशृण्वन्तु मे क्षत्रियाः सर्व एव ।\nयन्त्रच्छिद्रेणाभ्यतिक्रम्य लक्षं\nसमर्पयध्वं खगमैर्दशार्धैः \t॥ ३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2116480, "chapter_id": 3506, "verse_number": "३६", "content_sanskrit": "एतत् कृत्वा कर्म सुदुष्कृदत्र यः\nकुलेन रूपेण बलेन युक्तः ।\nतस्यास्य भार्या भगिनी ममेयं\nकृष्णा भवित्री न मृषा ब्रवीमि \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2116481, "chapter_id": 3506, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2116482, "chapter_id": 3506, "verse_number": "३७", "content_sanskrit": "तानेवमुक्त्वा द्रुपदस्य पुत्रः\nपश्चादिदं द्रौपदीमित्युवाच ।\nनाम्ना च गोत्रेण च कर्मणा च\nसङ्कीर्तयंस्तान् नृपतीन् समेतान् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2116483, "chapter_id": 3506, "verse_number": "२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nपञ्चाशीत्यधिकशततमोऽध्यायः ॥१८५॥ इति स्वयंवरपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2116484, "chapter_id": 3506, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]